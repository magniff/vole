# 0.26.5, statics P5b: the statics code generation's tasks touch, into
# the Ctx P4 and P5a pass down; a task is lent it let by run_pooled (the
# view). `--prune crate` on the 253 left: those a task's code may write
# stay statics (# dropped, with the view that reaches the write).
param pcx
type Ctx<Comp>
init ctx_new()
owner main
view crate::middle::threads::run_pooled *(POOL_PCX as *Ctx<Comp>)
use crate::base::ctx::Ctx
use crate::base::comp::Comp
