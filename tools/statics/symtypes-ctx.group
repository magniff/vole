# 0.27.0, left270: base's symbols and front::types' types, the last two
# statics the alloc exemption named, into the Ctx code generation's tasks
# are lent let (the view): the tasks look a symbol or a type up, the
# writing intern and make_type run on the main thread.
param pcx
type Ctx<Comp>
init ctx_new()
owner main
view crate::middle::threads::run_pooled *(POOL_PCX as *Ctx<Comp>)
use crate::base::ctx::Ctx
use crate::base::comp::Comp
static crate::base::SYMS syms
static crate::base::SYM_TABLE sym_table
static crate::base::SYM_TABLE_SIZE sym_table_size
static crate::base::SYM_TABLES sym_tables
static crate::base::SYM_TABLES_CAP sym_tables_cap
static crate::front::types::TYPES types
static crate::front::types::TLISTS tlists
static crate::front::types::TSCRATCH tscratch
static crate::front::types::TYPE_HASH type_hash
static crate::front::types::TYPE_HASH_SIZE type_hash_size
static crate::front::types::TYPE_HASH_USED type_hash_used
