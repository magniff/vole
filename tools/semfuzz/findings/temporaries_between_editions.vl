// FINDING (0.29, found porting tools/semfuzz, checking its model against
// rustc; not generated: no scrutinee of the fuzzer's `if let` lends a
// temporary): a drop order that is rustc's in neither edition.
//   - A tail expression's temporaries are dropped before the block's
//     locals: rustc's rule from its 2024 edition (2021: after them).
//   - An `if let` scrutinee's temporaries are dropped after the else
//     block: rustc's rule before 2024 (2024: before the else block).
// Each is "at the end of its statement" (`volec guide`), but a program
// that has both prints one thing under volec and another under rustc,
// whatever the edition; tools/rustc-twin's default is 2021, semfuzz
// --rustc's 2024. `volec guide rust` lists neither.
//
// volec (0.28.0, this tree)   rustc 2024   rustc 2021
//   else                        d1           else
//   d1                          else         d1
//   d3                          d3           d2
//   d2                          d2           d3
//   tail 5                      tail 5       tail 5
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn big(t: &T) -> Option<i64> {
    if t.v > 5 { Some(t.v) } else { None }
}

fn tail() -> i64 {
    let local = mk(2);
    obs(&mk(3)) + local.v
}

fn main() -> i32 {
    if let Some(n) = big(&mk(1)) {
        println("some {n}");
    } else {
        println("else");
    }
    println("tail {}", tail());
    0
}
