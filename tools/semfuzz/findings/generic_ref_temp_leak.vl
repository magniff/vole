// FINDING (0.29, tools/semfuzz, plain run seed 81 before the generator
// left it out; KNOWN generic_ref_temp): a leak. The temporary a generic
// function returns, its type inferred from a reference argument
// (`dup<X: Clone>(x: &X) -> X` called as `dup(&t)` or `dup::<T>(&t)`),
// is never dropped when it is lent (`obs(&dup(&t))`) or a field of it is
// read (`dup(&t).v`), at -O0 and -O2. Bound to a `let`, moved, or as an
// expression statement (`dup(&t);`) it is dropped; so is the temporary of
// the same function written without the type parameter (`dupt`), and of a
// generic function whose argument is by value (`gid(mk(6))`).
//
// volec prints (0.28.0 and this tree):   rustc prints, and the guide says
//   a 4                                  ("a temporary is dropped at the
//   b 4                                  end of its statement"):
//   d3                                     a 4
//   c 4                                    d2
//   end                                    b 4
//   d1                                     d3
//   live 2                                 c 4
//                                          d4
//                                          end
//                                          d1
//                                          live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn dup<X: Clone>(x: &X) -> X {
    x.clone()
}

fn dupt(x: &T) -> T {
    x.clone()
}

fn run() {
    let t = mk(4);
    println("a {}", obs(&dup(&t)));
    println("b {}", obs(&dupt(&t)));
    println("c {}", dup(&t).v);
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
