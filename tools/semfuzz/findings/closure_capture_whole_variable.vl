// FINDING (0.29, found porting tools/semfuzz; not generated: the fuzzer's
// move closures read their capture through `obs(&x)`, which captures x
// whole under either rule): rejected, where rustc accepts. A closure
// captures the whole variable where rustc (from its 2021 edition, the
// disjoint captures of RFC 2229) captures the place the body uses: a
// `move` closure that reads `t.v` takes a copy of the field and leaves t,
// and a closure that reads `s.t.v` borrows `s.t`, so `s.u` can be borrowed
// mutably while it lives. `volec guide closures` says "Rust's rules".
//
// volec check (0.28.0 and this tree):
//   error[borrowck.use_moved] 't.v' is used here after it moved
//   error[borrowck.conflict] cannot borrow 's.u' as mutable because it is
//     also borrowed as immutable
// rustc (1.98, editions 2021 and 2024) builds it, and it prints:
//   a 2 1
//   b 3 4
struct T {
    v: i64,
}

struct S {
    t: T,
    u: T,
}

fn bump(t: &mut T, k: i64) {
    t.v += k;
}

fn main() -> i32 {
    let t = T { v: 1 };
    let f = move || t.v + 1;
    println("a {} {}", f(), t.v);
    let mut s = S { t: T { v: 2 }, u: T { v: 3 } };
    let g = || s.t.v + 1;
    bump(&mut s.u, 1);
    println("b {} {}", g(), s.u.v);
    0
}
