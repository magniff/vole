#!/bin/sh
# (0.27.2) A merge that git makes without a conflict runs this, not
# pre-commit: the same checks, so that stdsrc.vl and stdsrc_rust.vl are
# made from the merged compiler/std and compiler/std2 when only one side
# changed the embedded file (the merge driver, merge-stdsrc, runs only
# when both did) and the other side changed std. git reads the index
# again after this hook: what it stages is in the merge commit.
exec sh "$(dirname "$0")/pre-commit" "$@"
