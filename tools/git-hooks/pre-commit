#!/bin/sh
# The commit-time checks (AGENTS.md, "Before you commit"), for every
# commit: an agent's under any harness, or a person's. Fast: only what the
# commit stages. Installed for the repository and all its worktrees with
#
#   git config core.hooksPath tools/git-hooks   (tools/git-hooks/setup.sh)
#
# VOLE_PRECOMMIT=0 (or `git commit --no-verify`) skips it.
#
#   unsafe   no new unsafe without // UNSAFE: and // SAFETY: (tools/unsafe-diff-check.py:
#            the sites as `volec query unsafe` finds them, 0.25.3; its cases:
#            tools/git-hooks/test-pre-commit.py)
#   fmt      staged .vl files outside tests/ and evals/ (records of agents' work, kept as written) are in the standard style
#   std      (0.25.3) a commit that stages compiler/std (a merge's too) gets the
#            stdsrc.vl that compiler/std/embed.sh makes of the staged std: made
#            and staged here when it differs (refused instead in a commit of
#            named paths, `git commit FILE`, whose index is a temporary one)
#   layout   staged tests/examples cases name SOURCE files that exist
#
# Set up once per clone, with the merge driver of stdsrc.vl:
#   tools/git-hooks/setup.sh
[ "${VOLE_PRECOMMIT:-1}" = 0 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f tools/unsafe-diff-check.py ] || exit 0
LC_ALL=C
export LC_ALL
VOLEC=
for c in target/tools/volec target/volec; do
    [ -x "$c" ] && { VOLEC=$PWD/$c; break; }
done
[ -n "$VOLEC" ] || VOLEC=$(command -v volec || true)
FAIL=0
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

python3 -I tools/unsafe-diff-check.py --cached || FAIL=1

if [ -n "$VOLEC" ]; then
    for f in $(printf '%s\n' "$STAGED" | grep '\.vl$' | grep -v -e '^tests/' -e '^evals/' | grep -v 'front/stdsrc\.vl$'); do
        [ -f "$f" ] || continue
        # (0.25.3: or by the branch's own build, target/volec, when the
        # file uses what the last tested build cannot read, a text block)
        if ! "$VOLEC" fmt --check "$f" > /dev/null 2>&1 \
            && ! { [ -x target/volec ] && target/volec fmt --check "$f" > /dev/null 2>&1; }; then
            echo "pre-commit: $f is not formatted (try: volec fmt $f)"
            FAIL=1
        fi
    done
fi

# (0.25.3) std: stdsrc.vl made from the staged compiler/std, in a copy
if [ -f compiler/std/embed.sh ] && printf '%s\n' "$STAGED" | grep -q -e '^compiler/std/' -e '^compiler/src/front/stdsrc\.vl$'; then
    SRC=compiler/src/front/stdsrc.vl
    T=$(mktemp -d "${TMPDIR:-/tmp}/vole-precommit.XXXXXX")
    git ls-files -z -- compiler/std | git checkout-index -z --stdin --prefix="$T/"
    mkdir -p "$T/compiler/src/front"
    if ! sh "$T/compiler/std/embed.sh" >"$T/embed.out" 2>&1; then
        echo "pre-commit: compiler/std/embed.sh failed on the staged std: $(head -1 "$T/embed.out")"
        FAIL=1
    elif ! git show ":$SRC" 2>/dev/null | cmp -s - "$T/$SRC"; then
        case "${GIT_INDEX_FILE:-index}" in
            index|*/index|*/index.lock)
                cp "$T/$SRC" "$SRC" && git add "$SRC" \
                    && echo "pre-commit: $SRC made from the staged compiler/std (compiler/std/embed.sh) and staged" \
                    || FAIL=1 ;;
            *)
                echo "pre-commit: $SRC is not what compiler/std/embed.sh makes of the staged std (try: compiler/std/embed.sh && git add $SRC, then commit again)"
                FAIL=1 ;;
        esac
    fi
    rm -rf "$T"
fi

for t in $(printf '%s\n' "$STAGED" | grep '^tests/examples/.*\.test$'); do
    awk '/^\/\/ (SOURCE|CSOURCE):/ { print $3 }' "$t" | while read -r s; do
        s=$(printf '%s' "$s" | sed "s|@ROOT@|$PWD|")
        [ -e "$s" ] || { echo "pre-commit: $t names $s, which does not exist"; exit 1; }
    done || FAIL=1
done

if [ "$FAIL" != 0 ]; then
    echo "pre-commit: refused (fix the lines above; VOLE_PRECOMMIT=0 or --no-verify skips the checks)"
    exit 1
fi
exit 0
