#!/bin/sh
# The commit-time checks (AGENTS.md, "Before you commit"), for every
# commit: an agent's under any harness, or a person's. Fast: only what the
# commit stages. Installed for the repository and all its worktrees with
#
#   git config core.hooksPath tools/git-hooks
#
# VOLE_PRECOMMIT=0 (or `git commit --no-verify`) skips it.
#
#   unsafe   no new unsafe without // UNSAFE: and // SAFETY: (tools/unsafe-diff-check.py)
#   fmt      staged .vl files outside tests/ are in the standard style
#   std      a commit that stages compiler/std stages a stdsrc.vl that matches it
#   layout   staged tests/examples cases name SOURCE files that exist
[ "${VOLE_PRECOMMIT:-1}" = 0 ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0
[ -f tools/unsafe-diff-check.py ] || exit 0
LC_ALL=C
export LC_ALL
VOLEC=
for c in target/tools/volec target/volec; do
    [ -x "$c" ] && { VOLEC=$PWD/$c; break; }
done
[ -n "$VOLEC" ] || VOLEC=$(command -v volec || true)
FAIL=0
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

python3 -I tools/unsafe-diff-check.py --cached || FAIL=1

if [ -n "$VOLEC" ]; then
    for f in $(printf '%s\n' "$STAGED" | grep '\.vl$' | grep -v '^tests/' | grep -v 'front/stdsrc\.vl$'); do
        [ -f "$f" ] || continue
        if ! "$VOLEC" fmt --check "$f" > /dev/null 2>&1; then
            echo "pre-commit: $f is not formatted (try: volec fmt $f)"
            FAIL=1
        fi
    done
fi

if printf '%s\n' "$STAGED" | grep -q '^compiler/std/' && \
   ! printf '%s\n' "$STAGED" | grep -q '^compiler/src/front/stdsrc\.vl$'; then
    echo "pre-commit: compiler/std changed but compiler/src/front/stdsrc.vl is not staged (run compiler/std/embed.sh, then git add it)"
    FAIL=1
fi

for t in $(printf '%s\n' "$STAGED" | grep '^tests/examples/.*\.test$'); do
    awk '/^\/\/ (SOURCE|CSOURCE):/ { print $3 }' "$t" | while read -r s; do
        s=$(printf '%s' "$s" | sed "s|@ROOT@|$PWD|")
        [ -e "$s" ] || { echo "pre-commit: $t names $s, which does not exist"; exit 1; }
    done || FAIL=1
done

if [ "$FAIL" != 0 ]; then
    echo "pre-commit: refused (fix the lines above; VOLE_PRECOMMIT=0 or --no-verify skips the checks)"
    exit 1
fi
exit 0
