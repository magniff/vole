#!/bin/sh
# (0.25.3) git's merge driver for compiler/src/front/stdsrc.vl, the std
# that compiler/std/embed.sh embeds: the file is never merged as text (two
# branches that change std conflicted on it every time), but made again
# from the merged compiler/std. Set up once per clone, with core.hooksPath
# (tools/git-hooks/setup.sh):
#
#   git config merge.stdsrc.driver 'sh tools/git-hooks/merge-stdsrc %O %A %B %P'
#
# and selected by .gitattributes (`compiler/src/front/stdsrc.vl merge=stdsrc`).
#
# usage (by git): merge-stdsrc BASE OURS THEIRS PATH
#
# git runs it during the merge, before the work tree holds the result, so
# it merges the two commits' trees itself (git merge-tree: HEAD and the
# commit being merged, named by git's GITHEAD_<sha> variable), takes
# compiler/std from that, runs its embed.sh and writes the result to OURS.
# When that cannot be done (compiler/std itself conflicts, or a rebase or
# cherry-pick, which name no GITHEAD_), it reports a conflict and says what
# to run: the work tree then holds the merged std. Exit 0: merged; 1: a
# conflict, OURS kept.
set -u
OURS=$2
P=${4:-compiler/src/front/stdsrc_rust.vl}
# (std's files; embed.sh is compiler/std's)
STD=compiler/std2
EMBED_ARGS=
# (inside the merge-tree below: its stdsrc.vl is not used)
[ "${VOLE_STDSRC_MERGING:-0}" = 1 ] && exit 0

conflict() {
    echo "merge-stdsrc: $P not merged ($1): resolve $STD, then run compiler/std/embed.sh and git add $P" >&2
    exit 1
}

heads=$(env | sed -n 's/^GITHEAD_\([0-9a-f]\{40,64\}\)=.*/\1/p')
[ -n "$heads" ] || conflict "no merged commit named: a rebase or cherry-pick"
[ "$(printf '%s\n' "$heads" | wc -l | tr -d ' ')" = 1 ] || conflict "an octopus merge"
theirs=$heads
ours=$(git rev-parse -q --verify HEAD) || conflict "no HEAD"

out=$(VOLE_STDSRC_MERGING=1 git merge-tree --write-tree --name-only --no-messages "$ours" "$theirs" 2>/dev/null)
rc=$?
tree=$(printf '%s\n' "$out" | head -1)
[ $rc -le 1 ] && [ -n "$tree" ] || conflict "git merge-tree failed"
# (std's files: compiler/std2 in the merged tree, or beside embed.sh)
git ls-tree -d --name-only "$tree" compiler/ | grep -qx "$STD" || STD=compiler/std
if printf '%s\n' "$out" | sed 1d | grep -q -e "^compiler/std/" -e "^compiler/std2/"; then
    conflict "$STD conflicts: $(printf '%s\n' "$out" | sed 1d | grep -e "^compiler/std/" -e "^compiler/std2/" | head -3 | tr '\n' ' ')"
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/vole-merge-stdsrc.XXXXXX") || conflict "no temporary directory"
trap 'rm -rf "$work"' EXIT
dirs=compiler/std
[ "$STD" = compiler/std ] || dirs="compiler/std $STD"
# shellcheck disable=SC2086
git archive "$tree" $dirs | tar -xf - -C "$work" || conflict "git archive failed"
mkdir -p "$work/compiler/src/front"
[ -f "$work/compiler/std/embed.sh" ] || conflict "the merged tree has no compiler/std/embed.sh"
# (0.27.5, Z5.2: ours, whose std2_units embed.sh keeps when no compiler
# here makes the index; this tree's compiler, by absolute path)
cp "$OURS" "$work/$P" 2>/dev/null || true
# shellcheck disable=SC2086
VOLE_EMBED_VOLEC="${VOLE_EMBED_VOLEC:-$PWD/target/volec}" sh "$work/compiler/std/embed.sh" $EMBED_ARGS >"$work/embed.out" 2>&1 || conflict "embed.sh: $(head -1 "$work/embed.out")"
grep '^embed.sh: no compiler' "$work/embed.out" | sed 's/^/merge-stdsrc: /' >&2
cp "$work/$P" "$OURS" || conflict "cannot write the result"
echo "merge-stdsrc: $P made from the merged $STD (compiler/std/embed.sh $EMBED_ARGS)" >&2
exit 0
