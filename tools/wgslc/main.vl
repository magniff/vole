// wgslc: the WGSL shader compiler of docs/design/gpu.md §2.10 (0.22's
// G4-G7), as a command-line program while std has no submodules.
//
//   wgslc check FILE...          the first error of each file, one line each
//   wgslc ir FILE                the IR, as text
//   wgslc msl FILE [-o OUT]      Metal Shading Language 3.0
//   wgslc spv FILE -o OUT        SPIR-V 1.3 (binary)
//   wgslc run FILE JOB           run a compute job on the CPU interpreter
//   wgslc metal-job FILE JOB     the job for tests/wgsl/metalrun (MSL + slots)
//   wgslc bench [-n N] [--target msl|spv|ir] [--no-checks] FILE...
//
// What a wgsl.* diagnostic means: `volec explain CODE` (0.26.0).
//
// The compiler is std::gpu::wgsl (compiler/std/gpu/wgsl/); this is
// its command line, and the runner of the tests' jobs.
use std::{env, fs};
use std::alloc::arena_scope;
use std::gpu::wgsl::{api, bounds, entry, interp, ir};
use std::time::Instant;
use std::gpu::wgsl::job; use std::gpu::wgsl::msl; use std::gpu::wgsl::uniformity;
use std::gpu::wgsl::api::fill_error;
use std::gpu::wgsl::front::new_front;
use std::gpu::wgsl::interp::new_interp;
use std::gpu::wgsl::job::{
    find_any_entry, find_entry, find_global, parse_job, print_buffers, print_words, texels,
};

use api::{
    Options, ShaderError, TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, new_error, options,
};

fn usage() -> i32 {
    eprintln("usage: wgslc check|ir|msl|spv FILE [-o OUT] | run FILE JOB | metal-job FILE JOB | bench [-n N] [--target msl|spv|ir] [--no-checks] FILE...");
    2
}

// The decimal integer an argument is, or `or`.
fn int_arg(t: &[u8], or: i64) -> i64 {
    match str::from_utf8(t) {
        Ok(s) => s.parse::<i64>().unwrap_or(or),
        Err(_) => or,
    }
}

// The runs of non-whitespace of s, as views of it.
fn words_of<'a>(s: &'a [u8], gpa: Gpa) -> Vec<&'a [u8], Gpa> {
    let mut words: Vec<&'a [u8], Gpa> = Vec::new_in(gpa);
    let mut i: usize = 0;
    while i < s.len() {
        if s[i] == b' ' || s[i] == b'\t' || s[i] == b'\r' || s[i] == b'\n' {
            i += 1;
            continue;
        }
        let st = i;
        while i < s.len() && !(s[i] == b' ' || s[i] == b'\t' || s[i] == b'\r' || s[i] == b'\n') {
            i += 1;
        }
        words.push(&s[st..i]);
    }
    words
}

// The whole file, or None when it cannot be read.
pub fn read_file(path: &[u8], gpa: Gpa) -> Option<Vec<u8, Gpa>> {
    let p = match str::from_utf8(path) {
        Ok(p) => p,
        Err(_) => return None,
    };
    match fs::read_in(p, gpa) {
        Ok(b) => Some(b),
        Err(_) => None,
    }
}

pub fn write_file(path: &[u8], data: &[u8]) -> bool {
    let p = match str::from_utf8(path) {
        Ok(p) => p,
        Err(_) => return false,
    };
    fs::write(p, data).is_ok()
}

// file:line:col: error CODE: message, then help: when there is one
pub fn print_error(file: &[u8], err: &ShaderError<Gpa>) {
    eprintln("{file}:{}:{}: error {}: {}", err.line, err.col, str::from_utf8(err.code).unwrap(),
        str::from_utf8(err.msg.as_slice()).unwrap(), file = str::from_utf8(file).unwrap());
    if err.help.len() > 0 {
        eprintln("help: {}", str::from_utf8(err.help.as_slice()).unwrap());
    }
    eprintln("try: volec explain {}", str::from_utf8(err.code).unwrap());
}

const REFLECT_TOO: bool = false;

const KINDS: [&[u8]; 7] = [b"uniform", b"storage", b"read-only-storage", b"texture",
    b"storage-texture", b"sampler", b"comparison-sampler"];

pub fn print_reflection(refl: &api::Reflection<Gpa>, out: &mut String<Gpa>) {
    for i in 0..refl.entries.len() {
        let e = &refl.entries[i];
        std::fmt::write(&mut *out, "entry {} {} msl {}",
            str::from_utf8(entry::stage_name(e.stage)).unwrap(),
            str::from_utf8(e.name.as_slice()).unwrap(),
            str::from_utf8(e.target_name.as_slice()).unwrap()).unwrap();
        if e.stage == ir::STAGE_COMPUTE {
            std::fmt::write(&mut *out, " workgroup {} {} {}", e.workgroup[0], e.workgroup[1],
                e.workgroup[2]).unwrap();
        }
        if e.sizes_slot >= 0 {
            std::fmt::write(&mut *out, " sizes-slot {}", e.sizes_slot).unwrap();
        }
        out.push(char::from_u32('\n' as u32).unwrap());
    }
    for i in 0..refl.bindings.len() {
        let b = refl.bindings[i];
        std::fmt::write(&mut *out, "binding {} {} {} min-size {} slots {} {} {}\n", b.group,
            b.binding, str::from_utf8(KINDS[b.kind as i64 as usize]).unwrap(), b.min_size,
            b.slots[0], b.slots[1], b.slots[2]).unwrap();
    }
    for i in 0..refl.inputs.len() {
        let v = refl.inputs[i];
        std::fmt::write(&mut *out, "input {} {} x{}\n", v.location,
            str::from_utf8(ir::scalar_name(v.scalar)).unwrap(), v.components).unwrap();
    }
    for i in 0..refl.sizes.len() {
        let b = refl.bindings[refl.sizes[i] as usize];
        std::fmt::write(&mut *out, "sizes {i} = binding {} {}\n", b.group, b.binding).unwrap();
    }
}

fn translate_file(path: &[u8], opts: Options, out: &mut Vec<u8, Gpa>, gpa: Gpa) -> bool {
    let src = match read_file(path, gpa) {
        Some(b) => b,
        None => {
            eprintln("error wgslc.read: cannot read '{path}'",
                path = str::from_utf8(path).unwrap());
            return false;
        }
    };
    let mut err = new_error(gpa);
    let mut refl = api::new_reflection(gpa);
    let ok = api::translate(src.as_slice(), opts, out, &mut refl, &mut err, gpa);
    if ok && opts.target == TARGET_MSL && REFLECT_TOO {
        let mut text = String::new_in(gpa);
        print_reflection(&refl, &mut text);
        out.extend_from_slice(text.as_bytes());
    }
    if !ok {
        print_error(path, &err);
    }
    ok
}

fn main(gpa: Gpa) -> i32 {
    let mut argv: Vec<&'static [u8], Gpa> = Vec::new_in(gpa);
    for a in env::args_os() {
        argv.push(a);
    }
    let argc = argv.len() as i64;
    if argc < 3 {
        if argc == 2 && argv[(1) as usize] == b"--help" {
            usage();
            return 0;
        }
        return usage();
    }
    let cmd = argv[(1) as usize];
    if cmd == b"check" {
        let mut status: i64 = 0;
        for i in 2..argc {
            let mut out: Vec<u8, Gpa> = Vec::new_in(gpa);
            if !translate_file(argv[(i) as usize], options(TARGET_CHECK), &mut out, gpa) {
                status = 1;
            }
        }
        return status as i32;
    }
    if cmd == b"reflect" {
        // the MSL's reflection, as text (the MSL itself is not printed)
        let mut out = Vec::<u8, Gpa>::new_in(gpa);
        let mut refl = api::new_reflection(gpa);
        let src = match read_file(argv[(2) as usize], gpa) {
            Some(b) => b,
            None => {
                eprintln("error wgslc.read: cannot read '{}'",
                    str::from_utf8(argv[(2) as usize]).unwrap());
                return 2;
            }
        };
        let mut err = new_error(gpa);
        if !api::translate(src.as_slice(), options(TARGET_MSL), &mut out, &mut refl, &mut err,
            gpa) {
            print_error(argv[(2) as usize], &err);
            return 1;
        }
        let mut text = String::new_in(gpa);
        print_reflection(&refl, &mut text);
        print("{}", str::from_utf8(text.as_bytes()).unwrap());
        return 0;
    }
    if cmd == b"ir" || cmd == b"msl" || cmd == b"spv" {
        let target = if cmd == b"ir" { TARGET_IR } else if cmd == b"msl" { TARGET_MSL }
            else { TARGET_SPIRV };
        let mut file: &[u8] = b"";
        let mut outp: &[u8] = b"";
        let mut opts = options(target);
        let mut i: i64 = 2;
        while i < argc {
            let a = argv[(i) as usize];
            if a == b"-o" && i + 1 < argc {
                outp = argv[(i + 1) as usize];
                i += 2;
                continue;
            }
            if a == b"--no-checks" {
                opts.no_checks = true;
            } else if a == b"--no-prove" {
                opts.prove = false;
            } else {
                file = a;
            }
            i += 1;
        }
        let mut out: Vec<u8, Gpa> = Vec::new_in(gpa);
        if !translate_file(file, opts, &mut out, gpa) {
            return 1;
        }
        if outp.len() == 0 {
            if target == TARGET_SPIRV {
                eprintln("error wgslc.output: SPIR-V is binary: give '-o FILE'");
                return 2;
            }
            print("{}", str::from_utf8(out.as_slice()).unwrap());
            return 0;
        }
        if !write_file(outp, out.as_slice()) {
            eprintln("error wgslc.write: cannot write '{outp}'",
                outp = str::from_utf8(outp).unwrap());
            return 1;
        }
        return 0;
    }
    if cmd == b"run" || cmd == b"metal-job" {
        if argc < 4 {
            return usage();
        }
        return command(cmd == b"run", argv[(2) as usize], argv[(3) as usize], gpa);
    }
    if cmd == b"bench" {
        return bench(argv.as_slice(), gpa);
    }
    if cmd == b"compare" && argc >= 4 {
        let mut ulp: i64 = 0;
        if argc >= 6 && argv[(4) as usize] == b"--ulp" {
            ulp = int_arg(argv[(5) as usize], 0);
        }
        return compare(argv[(2) as usize], argv[(3) as usize], ulp, gpa);
    }
    usage()
}

// Two outputs of `run` (or metalrun): the same words, or (ulp > 0) words
// that as f32 are within ulp units in the last place. Prints the first
// differences.
fn compare(a: &[u8], b: &[u8], ulp: i64, gpa: Gpa) -> i32 {
    let ta = match read_file(a, gpa) {
        Some(t) => t,
        None => {
            eprintln("error wgslc.read: cannot read '{a}'", a = str::from_utf8(a).unwrap());
            return 2;
        }
    };
    let tb = match read_file(b, gpa) {
        Some(t) => t,
        None => {
            eprintln("error wgslc.read: cannot read '{b}'", b = str::from_utf8(b).unwrap());
            return 2;
        }
    };
    let wa = words_of(ta.as_slice(), gpa);
    let wb = words_of(tb.as_slice(), gpa);
    if wa.len() != wb.len() {
        eprintln("outputs differ in length: {} and {} words", wa.len(), wb.len());
        return 1;
    }
    let mut bad: i64 = 0;
    let mut buffer: &[u8] = b"";
    let mut index: i64 = 0;
    let mut i: i64 = 0;
    while i < wa.len() as i64 {
        if wa[i as usize] == b"buffer" {
            buffer = wa[(i + 2) as usize];
            index = 0;
            i += 3;
            continue;
        }
        if wa[i as usize] != wb[i as usize] {
            let x = parse_hex(wa[i as usize]);
            let y = parse_hex(wb[i as usize]);
            if ulp == 0 || x < 0 || y < 0 || ulp_distance(x, y) > ulp {
                if bad < 10 {
                    eprintln("binding {buffer} word {index}: {} and {}",
                        str::from_utf8(wa[i as usize]).unwrap(),
                        str::from_utf8(wb[i as usize]).unwrap(),
                        buffer = str::from_utf8(buffer).unwrap());
                }
                bad += 1;
            }
        }
        index += 1;
        i += 1;
    }
    if bad > 0 {
        eprintln("{bad} words differ");
        return 1;
    }
    0
}

fn parse_hex(s: &[u8]) -> i64 {
    let mut v: i64 = 0;
    for i in 0..s.len() {
        let c = s[i];
        let d = if c >= b'0' && c <= b'9' { c - b'0' }
            else if c >= b'a' && c <= b'f' { c - b'a' + 10 } else { return -1; };
        v = v * 16 + d as i64;
    }
    v
}

// The distance of two f32 bit patterns in units in the last place (NaNs
// equal each other only).
fn ulp_distance(x: i64, y: i64) -> i64 {
    let xn = (x & 0x7f800000) == 0x7f800000 && (x & 0x7fffff) != 0;
    let yn = (y & 0x7f800000) == 0x7f800000 && (y & 0x7fffff) != 0;
    if xn || yn {
        return if xn && yn { 0 } else { 1 << 40 };
    }
    // as a line of integers: negative floats below positive ones
    let ox = if x >= 0x80000000 { 0x80000000 - x } else { x };
    let oy = if y >= 0x80000000 { 0x80000000 - y } else { y };
    if ox > oy { ox - oy } else { oy - ox }
}

// Translates each file N times; prints the median time per file.
fn bench(argv: &[&'static [u8]], gpa: Gpa) -> i32 {
    let argc = argv.len() as i64;
    let mut n: i64 = 200;
    let mut opts = options(TARGET_MSL);
    let mut files: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    let mut i: i64 = 2;
    while i < argc {
        let a = argv[(i) as usize];
        if a == b"-n" && i + 1 < argc {
            n = int_arg(argv[(i + 1) as usize], 200);
            i += 2;
            continue;
        }
        if a == b"--target" && i + 1 < argc {
            let t = argv[(i + 1) as usize];
            opts.target = if t == b"spv" { TARGET_SPIRV } else if t == b"ir" { TARGET_CHECK }
                else { TARGET_MSL };
            i += 2;
            continue;
        }
        if a == b"--no-checks" {
            opts.no_checks = true;
        } else {
            files.push(a);
        }
        i += 1;
    }
    let mut total: i64 = 0;
    for k in 0..files.len() {
        let src = match read_file(files[k], gpa) {
            Some(b) => b,
            None => {
                eprintln("error wgslc.read: cannot read '{}'", str::from_utf8(files[k]).unwrap());
                return 1;
            }
        };
        let mut times: Vec<i64, Gpa> = Vec::new_in(gpa);
        let mut out = Vec::<u8, Gpa>::new_in(gpa);
        let mut err = new_error(gpa);
        let mut bytes: i64 = 0;
        for _ in 0..n {
            out.clear();
            let t0 = Instant::now();
            let mut refl = api::new_reflection(gpa);
            if !api::translate(src.as_slice(), opts, &mut out, &mut refl, &mut err, gpa) {
                print_error(files[k], &err);
                return 1;
            }
            times.push(t0.elapsed().as_nanos() as i64);
            bytes = out.len() as i64;
        }
        times.sort_unstable();
        let med = times[times.len() / 2];
        total += med;
        println(
            "{}\t{} bytes in\t{bytes} bytes out\tmedian {}.{} us",
            str::from_utf8(files[k]).unwrap(), src.len(), med / 1000, (med % 1000) / 100);
    }
    println("total (sum of medians)\t{}.{} us", total / 1000, (total % 1000) / 100);
    0
}

// Runs a job: on the interpreter, or (metal-job) as the input of
// tests/wgsl/metalrun.
pub fn command(interp: bool, file: &[u8], job_path: &[u8], gpa: Gpa) -> i32 {
    let src = match read_file(file, gpa) {
        Some(b) => b,
        None => {
            eprintln("error wgslc.read: cannot read '{file}'",
                file = str::from_utf8(file).unwrap());
            return 2;
        }
    };
    let compile_only = !interp && job_path == b"-";
    let jtext = if compile_only { Some(Vec::<u8, Gpa>::new_in(gpa)) }
        else { read_file(job_path, gpa) };
    let jtext = match jtext {
        Some(b) => b,
        None => {
            eprintln("error wgslc.read: cannot read '{job_path}'",
                job_path = str::from_utf8(job_path).unwrap());
            return 2;
        }
    };
    let mut out = String::new_in(gpa);
    let mut err = new_error(gpa);
    let status = arena_scope(&gpa, |a| -> i64 {
        let mut fr = new_front(src.as_slice(), a);
        fr.module();
        if !fr.failed {
            uniformity::check(&fr);
        }
        if fr.failed {
            fill_error(&fr, &mut err);
            return 1;
        }
        bounds::insert_checks(&mut fr.m, a, true);
        if compile_only {
            msl::metal_compile_job(&fr.m, a, &mut out);
            return 0;
        }
        let mut jerr = String::new_in(a);
        let job = match parse_job(jtext.as_slice(), a, &mut jerr) {
            Some(j) => j,
            None => {
                std::fmt::write(&mut out, "error wgslc.job: {}\n",
                    str::from_utf8(jerr.as_bytes()).unwrap()).unwrap();
                return 3;
            }
        };
        let ei = if job.call_n >= 0 { find_any_entry(&fr.m, job.entry) }
            else { find_entry(&fr.m, job.entry) };
        if ei < 0 {
            out.push_str("error wgslc.job: no such compute entry point\n");
            return 3;
        }
        for i in 0..job.buffers.len() {
            let b = &job.buffers[i];
            if find_global(&fr.m, b.group, b.binding) < 0 {
                std::fmt::write(&mut out,
                    "error wgslc.job: nothing is bound at @group({}) @binding({})\n", b.group,
                    b.binding).unwrap();
                return 3;
            }
        }
        if interp {
            let mut it = new_interp(&fr.m, a);
            for i in 0..job.buffers.len() {
                let b = &job.buffers[i];
                let g = find_global(&fr.m, b.group, b.binding);
                it.set_buffer(g, b.words.as_slice());
            }
            for i in 0..job.textures.len() {
                let t = &job.textures[i];
                let g = find_global(&fr.m, t.group, t.binding);
                if g < 0 {
                    std::fmt::write(&mut out,
                        "error wgslc.job: no texture at @group({}) @binding({})\n", t.group,
                        t.binding).unwrap();
                    return 3;
                }
                let tx = texels(t, a);
                it.set_texture(g, t.w, t.h, tx.as_slice());
            }
            if job.call_n >= 0 {
                let fh = fr.m.entries[ei as usize].func;
                let in_stride = ir::record_offsets(&fr.m, fh, a)[
                    fr.m.functions[fh as usize].params.len()];
                let rt = fr.m.functions[fh as usize].result;
                let out_stride: i64 = if rt >= 0 { ir::stride_of(&fr.m, rt) } else { 4 };
                let mut res: Vec<u32, _> = Vec::new_in(a);
                if !it.call(&fr.m, ei, job.input.as_slice(), in_stride, job.call_n, &mut res,
                    out_stride) {
                    std::fmt::write(&mut out, "error wgslc.interp: {}\n",
                        str::from_utf8(it.err.as_slice()).unwrap()).unwrap();
                    return 4;
                }
                let mut idx: Vec<i64, _> = Vec::new_in(a);
                for i in 0..job.buffers.len() {
                    let b = &job.buffers[i];
                    idx.push(find_global(&fr.m, b.group, b.binding));
                }
                print_buffers(&job, &it.bufs, &idx, &mut out);
                print_words(-1i64, &job.input, &mut out);
                print_words(-2i64, &res, &mut out);
                return 0;
            }
            if !it.dispatch(&fr.m, ei, job.groups) {
                std::fmt::write(&mut out, "error wgslc.interp: {}\n",
                    str::from_utf8(it.err.as_slice()).unwrap()).unwrap();
                return 4;
            }
            let mut idx: Vec<i64, _> = Vec::new_in(a);
            for i in 0..job.buffers.len() {
                let b = &job.buffers[i];
                idx.push(find_global(&fr.m, b.group, b.binding));
            }
            print_buffers(&job, &it.bufs, &idx, &mut out);
            return 0;
        }
        msl::metal_job(&fr.m, a, ei, &job, &mut out);
        0
    });
    if status == 1 {
        print_error(file, &err);
        return 1;
    }
    if status != 0 {
        eprint("{}", str::from_utf8(out.as_bytes()).unwrap());
        return status as i32;
    }
    print("{}", str::from_utf8(out.as_bytes()).unwrap());
    0
}
