#!/bin/sh
# Records where a vole tool (volec query/edit/refactor/check/fix, or
# the harness) fell short, for the tools to improve (see AGENTS.md):
#
#   tools/agent-feedback TOOL "what you needed, what the tool did or lacked"
#   tools/agent-feedback --list [N]        the last N records (default 20)
#   tools/agent-feedback --find WORDS...   (0.25.2) has anyone seen this?
#                                          the records holding most of the
#                                          words (any case), best first
#
# Appends one JSON line to agent-tools.jsonl in the shared git directory
# (.git of the main checkout, for every worktree); tools/agent-tool-usage.py
# --hook-log summarizes it. Git is not run (0.12: a harness guard may refuse
# it inside a worktree): the directory is found by walking up from the
# current directory to a `.git`, and from a worktree's `.git` file to its
# common directory.
set -eu
case "${1:-}" in
    --list|--find) ;;
    *) [ $# -ge 2 ] || { echo "usage: tools/agent-feedback TOOL MESSAGE | --list [N] | --find WORDS..." >&2; exit 2; } ;;
esac
exec python3 -I - "$PWD" "$@" <<'PY'
import json, os, sys, time


def checkout_of(cwd):
    d = os.path.abspath(cwd)
    while True:
        g = os.path.join(d, ".git")
        if os.path.isdir(g):
            return d, g
        if os.path.isfile(g):
            with open(g) as fh:
                text = fh.read().strip()
            if not text.startswith("gitdir:"):
                return d, None
            gd = text[len("gitdir:"):].strip()
            if not os.path.isabs(gd):
                gd = os.path.normpath(os.path.join(d, gd))
            try:
                with open(os.path.join(gd, "commondir")) as fh:
                    common = fh.read().strip()
            except OSError:
                return d, gd
            return d, common if os.path.isabs(common) else os.path.normpath(os.path.join(gd, common))
        parent = os.path.dirname(d)
        if parent == d:
            return None, None
        d = parent


cwd = sys.argv[1]
root, gd = checkout_of(cwd)
if not gd:
    sys.exit("agent-feedback: no git checkout above " + cwd)


def records():
    try:
        fh = open(os.path.join(gd, "agent-tools.jsonl"), errors="replace")
    except OSError:
        return []
    out = []
    with fh:
        for line in fh:
            if '"feedback"' not in line:
                continue
            try:
                r = json.loads(line)
            except ValueError:
                continue
            if r.get("kind") == "feedback":
                out.append(r)
    return out


def show(r):
    where = os.path.basename((r.get("worktree") or "").rstrip("/"))
    print("%s %s (%s): %s" % ((r.get("time") or "")[:16], r.get("tool", ""), where, r.get("message", "")))


if sys.argv[2] == "--list":
    n = int(sys.argv[3]) if len(sys.argv) > 3 and sys.argv[3].isdigit() else 20
    for r in records()[-n:][::-1]:
        show(r)
    sys.exit(0)
if sys.argv[2] == "--find":
    words = [w.lower() for w in sys.argv[3:] if w]
    if not words:
        sys.exit("usage: tools/agent-feedback --find WORDS...")
    scored = []
    for i, r in enumerate(records()):
        text = (r.get("tool", "") + " " + r.get("message", "")).lower()
        k = sum(1 for w in words if w in text)
        if k and k >= (len(words) + 1) // 2:
            scored.append((-k, -i, r))
    scored.sort(key=lambda x: (x[0], x[1]))
    for _, _, r in scored[:20]:
        show(r)
    if not scored:
        print("none: no record holds most of the words (tools/agent-feedback --list for the last ones)")
    elif len(scored) > 20:
        print("(%d more; give more words)" % (len(scored) - 20))
    sys.exit(0)
tool, msg = sys.argv[2:4]
with open(os.path.join(gd, "agent-tools.jsonl"), "a") as fh:
    fh.write(json.dumps({"kind": "feedback", "tool": tool, "message": msg[:600], "worktree": root[-120:],
                         "time": time.strftime("%Y-%m-%dT%H:%M:%S")}) + "\n")
print("recorded")
PY
