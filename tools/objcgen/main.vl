// objcgen: Objective-C bindings for vole, generated from a table and
// checked against the runtime (design docs/design/gpu.md, §2.9).
//
//   objcgen TABLE.objc            the bindings (a vole module) on stdout
//   objcgen --check TABLE.objc    every method of the table against the
//                                 runtime's type encoding; exit 1 on a
//                                 mismatch, one `error` line each
//   objcgen --c-check TABLE.objc  an Objective-C file on stdout that checks
//                                 the table's constants and struct layouts
//                                 against the SDK's headers at compile
//                                 time (clang -fsyntax-only)
//
// The format is compiler/std/objc/tables/README.md's. Build: volec
// tools/objcgen/main.vl -o objcgen (libobjc is linked by the extern
// block's #[link]; frameworks are opened with dlopen by the `framework`
// lines).

use std::alloc::Allocator;
use std::fmt::Display;

import "stdio.h" as c;
import "dlfcn.h" as c;

#[derive(Clone, Copy)] #[repr(C)]
struct MethodDesc {
    name: *mut u8,
    types: *mut u8,
}

// UNSAFE: the Objective-C runtime's C functions and strlen; C calls cannot be checked.
// SAFETY: the prototypes are objc/runtime.h's and string.h's (id, SEL, Class, Method as *mut u8).
#[link(lib = "objc")]
extern "C" {
    fn sel_registerName(name: *mut u8) -> *mut u8;
    fn objc_getClass(name: *mut u8) -> *mut u8;
    fn objc_getProtocol(name: *mut u8) -> *mut u8;
    fn protocol_getMethodDescription(p: *mut u8, s: *mut u8, required: bool, instance: bool) -> MethodDesc;
    fn class_getInstanceMethod(cls: *mut u8, s: *mut u8) -> *mut u8;
    fn class_getClassMethod(cls: *mut u8, s: *mut u8) -> *mut u8;
    fn method_getTypeEncoding(m: *mut u8) -> *mut u8;
    fn object_getClass(o: *mut u8) -> *mut u8;
    fn objc_release(o: *mut u8);
    #[link_name = "objc_msgSend"]
    fn msg_p(o: *mut u8, s: *mut u8) -> *mut u8;
    fn strlen(s: *mut u8) -> u64;
}

// ---- the table ----

const K_VOID: i64 = 0;
const K_SCALAR: i64 = 1; // code: Q q I i S s C c B f d
const K_PTR: i64 = 2; // *T: raw memory, the wrapper is unsafe
const K_OBJ: i64 = 3; // an object: Ref<T>, Id<T> with own
const K_SEL: i64 = 4;
const K_CLASS: i64 = 5;
const K_STRUCT: i64 = 6;

#[derive(Clone, Copy)]
struct Ty<'a> {
    kind: i64,
    code: u8,
    name: &'a [u8], // the vole type: u64, MTLSize, MTLBuffer, *u8
    nullable: bool,
    own: bool,
}

#[derive(Clone, Copy)]
struct Param<'a> {
    name: &'a [u8],
    ty: Ty<'a>,
}

#[derive(Clone)]
struct Method<'a, A: Allocator> {
    line: i64,
    class_method: bool,
    selector: &'a [u8],
    params: Vec<Param<'a>, A>,
    ret: Ty<'a>,
    alias: &'a [u8],
}

#[derive(Clone)]
struct Decl<'a, A: Allocator> {
    line: i64,
    is_protocol: bool,
    name: &'a [u8],
    parents: Vec<&'a [u8], A>,
    methods: Vec<Method<'a, A>, A>,
}

#[derive(Clone)]
struct StructDef<'a, A: Allocator> {
    line: i64,
    name: &'a [u8],
    fields: Vec<Param<'a>, A>,
}

#[derive(Clone, Copy)]
struct ConstDef<'a> {
    line: i64,
    name: &'a [u8],
    ty: &'a [u8],
    value: &'a [u8],
}

struct Table<'a, A: Allocator> {
    file: &'a [u8],
    objc: &'a [u8],
    frameworks: Vec<&'a [u8], A>,
    headers: Vec<&'a [u8], A>,
    uses: Vec<&'a [u8], A>, // `use` lines, verbatim
    imported: Vec<&'a [u8], A>, // the object types they bring
    structs: Vec<StructDef<'a, A>, A>,
    consts: Vec<ConstDef<'a>, A>,
    decls: Vec<Decl<'a, A>, A>,
    errors: i64,
}

fn is_ident_byte(b: u8) -> bool {
    (b >= b'a' && b <= b'z') || (b >= b'A' && b <= b'Z') || (b >= b'0' && b <= b'9') || b == b'_'
}

fn is_upper(b: u8) -> bool {
    b >= b'A' && b <= b'Z'
}

fn is_lower(b: u8) -> bool {
    b >= b'a' && b <= b'z'
}

fn is_digit(b: u8) -> bool {
    b >= b'0' && b <= b'9'
}

fn starts_with(s: &[u8], p: &[u8]) -> bool {
    s.len() >= p.len() && s[0..p.len()] == p
}

fn find_byte(s: &[u8], b: u8) -> i64 {
    for i in 0..s.len() {
        if s[i] == b { return i as i64; }
    }
    -1
}

fn is_space(b: u8) -> bool {
    b == b' ' || b == b'\t' || b == b'\r' || b == b'\n'
}

fn trim(s: &[u8]) -> &[u8] {
    let mut a: usize = 0;
    let mut b = s.len();
    while a < b && is_space(s[a]) { a += 1; }
    while b > a && is_space(s[b - 1]) { b -= 1; }
    &s[a..b]
}

// The parts of s between commas.
fn split_commas<'a>(s: &'a [u8], gpa: Gpa) -> Vec<&'a [u8], Gpa> {
    let mut out: Vec<&'a [u8], Gpa> = Vec::new_in(gpa);
    let mut start: usize = 0;
    for i in 0..s.len() + 1 {
        if i == s.len() || s[i] == b',' {
            out.push(&s[start..i]);
            start = i + 1;
        }
    }
    out
}

// The table's errors so far.
static mut ERRORS: i64 = 0;

impl<'a> Table<'a, Gpa> {
    fn error<T: Display>(&self, line: i64, msg: T) {
        eprintln("{}:{line}: error objcgen.table: {msg}", str::from_utf8(self.file).unwrap());
        set_errors(get_errors() + (1));
    }

    fn is_object(&mut self, name: &[u8]) -> bool {
        if name == b"id" { return true; }
        for d in self.decls.iter() {
            if d.name == name { return true; }
        }
        for n in self.imported.iter().copied() {
            if n == name { return true; }
        }
        false
    }

    fn find_struct(&self, name: &[u8]) -> Option<StructDef<'a, Gpa>> {
        for s in self.structs.iter() {
            if s.name == name { return Some(s.clone()); }
        }
        None
    }

    fn find_decl(&self, name: &[u8]) -> Option<Decl<'a, Gpa>> {
        for d in self.decls.iter() {
            if d.name == name { return Some(d.clone()); }
        }
        None
    }

    // A type as written: u64, *u8, sel, class, NAME, NAME?, own NAME?.
    fn parse_type(&mut self, line: i64, text: &'a [u8]) -> Ty<'a> {
        let mut t = trim(text);
        let mut own = false;
        if starts_with(t, b"own ") {
            own = true;
            t = trim(&t[4..]);
        }
        let mut nullable = false;
        if t.len() > 0 && t[t.len() - 1] == b'?' {
            nullable = true;
            t = trim(&t[0..t.len() - 1]);
        }
        let mut ty = Ty { kind: K_VOID, code: b'v', name: t, nullable: nullable, own: own };
        if t == b"void" || t == b"" {
            ty.kind = K_VOID;
        } else if t == b"u64" { ty.kind = K_SCALAR; ty.code = b'Q'; }
        else if t == b"i64" { ty.kind = K_SCALAR; ty.code = b'q'; }
        else if t == b"u32" { ty.kind = K_SCALAR; ty.code = b'I'; }
        else if t == b"i32" { ty.kind = K_SCALAR; ty.code = b'i'; }
        else if t == b"u16" { ty.kind = K_SCALAR; ty.code = b'S'; }
        else if t == b"i16" { ty.kind = K_SCALAR; ty.code = b's'; }
        else if t == b"u8" { ty.kind = K_SCALAR; ty.code = b'C'; }
        else if t == b"i8" { ty.kind = K_SCALAR; ty.code = b'c'; }
        else if t == b"bool" { ty.kind = K_SCALAR; ty.code = b'B'; }
        else if t == b"f32" { ty.kind = K_SCALAR; ty.code = b'f'; }
        else if t == b"f64" { ty.kind = K_SCALAR; ty.code = b'd'; }
        else if t == b"sel" { ty.kind = K_SEL; ty.code = b':'; ty.name = b"*u8"; }
        else if t == b"class" { ty.kind = K_CLASS; ty.code = b'#'; ty.name = b"*u8"; }
        else if t[0] == b'*' { ty.kind = K_PTR; ty.code = b'^'; }
        else if self.is_object(t) {
            ty.kind = K_OBJ;
            ty.code = b'@';
            if t == b"id" { ty.name = b"Object"; }
        } else {
            match self.find_struct(t) {
                Some(_) => { ty.kind = K_STRUCT; ty.code = b'{'; }
                None => self.error(line, { let t = str::from_utf8(t).unwrap(); format_args("unknown type '{t}' (a scalar, *T, sel, class, a struct, class or protocol of the table, or a `use`d one)") }),
            }
        }
        if (own || nullable) && ty.kind != K_OBJ {
            self.error(line,
                { let t = str::from_utf8(t).unwrap();
                    format_args("'own' and '?' are for object types, not '{t}'") });
        }
        ty
    }

    // `(a: T, b: U)` into params.
    fn parse_params(&mut self, line: i64, text: &'a [u8], out: &mut Vec<Param<'a>, Gpa>) {
        let t = trim(text);
        if t.len() < 2 || t[0] != b'(' || t[t.len() - 1] != b')' {
            self.error(line,
                { let t = str::from_utf8(t).unwrap();
                    format_args("expected '(name: type, ...)', got '{t}'") });
            return;
        }
        self.parse_list(line, &t[1..t.len() - 1], out);
    }

    // `a: T, b: U` into params.
    fn parse_list(&mut self, line: i64, text: &'a [u8], out: &mut Vec<Param<'a>, Gpa>) {
        let inner = trim(text);
        if inner.len() == 0 { return; }
        let mut start: i64 = 0;
        for i in 0..inner.len() + 1 {
            if i == inner.len() || inner[i] == b',' {
                let part = trim(&inner[start as usize..i]);
                let colon = find_byte(part, b':');
                if colon < 0 {
                    self.error(line,
                        { let part = str::from_utf8(part).unwrap();
                            format_args("expected 'name: type', got '{part}'") });
                } else {
                    let name = trim(&part[0..colon as usize]);
                    let ty = self.parse_type(line, &part[(colon + 1) as usize..]);
                    out.push(Param { name: name, ty: ty });
                }
                start = i as i64 + 1;
            }
        }
    }
}

// A line's first word and the rest.
fn split_word(s: &[u8]) -> (&[u8], &[u8]) {
    let t = trim(s);
    let mut i: i64 = 0;
    while i < t.len() as i64 && t[i as usize] != b' ' && t[i as usize] != b'\t' { i += 1; }
    (&t[0..i as usize], trim(&t[i as usize..]))
}

fn parse_table<'a>(text: &'a [u8], file: &'a [u8], gpa: Gpa) -> Table<'a, Gpa> {
    let mut tb = Table {
        file: file,
        objc: b"crate::objc",
        frameworks: Vec::new_in(gpa),
        headers: Vec::new_in(gpa),
        uses: Vec::new_in(gpa),
        imported: Vec::new_in(gpa),
        structs: Vec::new_in(gpa),
        consts: Vec::new_in(gpa),
        decls: Vec::new_in(gpa),
        errors: 0,
    };
    // Two passes: declarations first, so that types may be used before
    // the line that declares them.
    for pass in 0..2 {
        let mut line_no: i64 = 0;
        let mut start: i64 = 0;
        let mut cur: i64 = -1;
        for i in 0..text.len() + 1 {
            if i < text.len() && text[i] != b'\n' { continue; }
            line_no += 1;
            let raw = &text[start as usize..i];
            start = i as i64 + 1;
            let hash = find_byte(raw, b'#');
            let body = if hash >= 0 { &raw[0..hash as usize] } else { raw };
            if trim(body).len() == 0 { continue; }
            let indented = body[0] == b' ' || body[0] == b'\t';
            let (word, rest) = split_word(body);
            if indented {
                if pass == 0 { continue; }
                if cur < 0 {
                    tb.error(line_no, "a method outside a class or protocol");
                    continue;
                }
                let m = parse_method(&mut tb, line_no, trim(body), gpa);
                tb.decls[cur as usize].methods.push(m);
                continue;
            }
            if word == b"class" || word == b"protocol" {
                if pass == 0 {
                    let colon = find_byte(rest, b':');
                    let name = if colon >= 0 { trim(&rest[0..colon as usize]) } else { rest };
                    let mut parents: Vec<&[u8], Gpa> = Vec::new_in(gpa);
                    if colon >= 0 {
                        for p in split_commas(&rest[(colon + 1) as usize..], gpa) {
                            parents.push(trim(p));
                        }
                    }
                    tb.decls.push(Decl {
                        line: line_no, is_protocol: word == b"protocol", name: name,
                        parents: parents, methods: Vec::new_in(gpa),
                    });
                } else {
                    cur += 1;
                }
            } else if pass == 1 {
                cur = -1;
                if word == b"objc" {
                    tb.objc = rest;
                } else if word == b"framework" {
                    tb.frameworks.push(rest);
                } else if word == b"header" {
                    tb.headers.push(rest);
                } else if word == b"use" {
                    tb.uses.push(trim(body));
                } else if word == b"struct" || word == b"const" {
                    // parsed in pass 0
                } else {
                    tb.error(line_no, { let word = str::from_utf8(word).unwrap(); format_args("unknown line '{word}' (objc, framework, header, use, struct, const, class, protocol, or an indented method)") });
                }
            } else if word == b"use" {
                // the names in braces, or the last segment
                let open = find_byte(rest, b'{');
                if open >= 0 {
                    let close = find_byte(rest, b'}');
                    let inner = if close > open { &rest[(open + 1) as usize..close as usize] }
                        else { &rest[(open + 1) as usize..] };
                    for n in split_commas(inner, gpa) {
                        tb.imported.push(trim(n));
                    }
                } else {
                    let mut k = rest.len();
                    while k > 0 && rest[k - 1] != b':' { k -= 1; }
                    let mut last = trim(&rest[k..]);
                    if last.len() > 0
                        && last[last.len() - 1] == b';' { last = &last[0..last.len() - 1]; }
                    tb.imported.push(last);
                }
            } else if word == b"struct" {
                let open = find_byte(rest, b'{');
                let close = find_byte(rest, b'}');
                if open < 0 || close < open {
                    tb.error(line_no, "expected 'struct NAME { field: type, ... }' on one line");
                    continue;
                }
                tb.structs.push(StructDef {
                    line: line_no, name: trim(&rest[0..open as usize]), fields: Vec::new_in(gpa),
                });
            } else if word == b"const" {
                // const NAME: TYPE = VALUE
                let colon = find_byte(rest, b':');
                let eq = find_byte(rest, b'=');
                if colon < 0 || eq < colon {
                    tb.error(line_no, "expected 'const NAME: type = value'");
                    continue;
                }
                tb.consts.push(ConstDef {
                    line: line_no, name: trim(&rest[0..colon as usize]),
                    ty: trim(&rest[(colon + 1) as usize..eq as usize]),
                    value: trim(&rest[(eq + 1) as usize..]),
                });
            }
        }
        if pass == 0 {
            // the struct fields, now that every type name is known
            for k in 0..tb.structs.len() {
                let sline = tb.structs[k].line;
                let raw = line_text(text, sline);
                let open = find_byte(raw, b'{');
                let close = find_byte(raw, b'}');
                let mut fields: Vec<Param<'_>, Gpa> = Vec::new_in(gpa);
                tb.parse_list(sline, &raw[(open + 1) as usize..close as usize], &mut fields);
                tb.structs[k].fields = fields;
            }
        }
    }
    tb
}

fn line_text(text: &[u8], line: i64) -> &[u8] {
    let mut n: i64 = 1;
    let mut start: i64 = 0;
    for i in 0..text.len() + 1 {
        if i == text.len() || text[i] == b'\n' {
            if n == line { return &text[start as usize..i]; }
            n += 1;
            start = i as i64 + 1;
        }
    }
    b""
}

// [+|-]SELECTOR (params) [-> TYPE] [as NAME]
fn parse_method<'a>(tb: &mut Table<'a, Gpa>, line: i64, text: &'a [u8], gpa: Gpa) -> Method<'a,
    Gpa> {
    let mut t = text;
    let mut class_method = false;
    if t[0] == b'+' || t[0] == b'-' {
        class_method = t[0] == b'+';
        t = trim(&t[1..]);
    }
    let mut i: i64 = 0;
    while i < t.len() as i64 && t[i as usize] != b' ' && t[i as usize] != b'\t'
        && t[i as usize] != b'(' { i += 1; }
    let selector = &t[0..i as usize];
    let mut rest = trim(&t[i as usize..]);
    let mut alias: &[u8] = b"";
    // ` as NAME` at the end
    let mut k = rest.len();
    while k >= 4 {
        if &rest[k - 4..k] == b" as " {
            alias = trim(&rest[k..]);
            rest = trim(&rest[0..k - 4]);
            break;
        }
        k -= 1;
    }
    let mut ret_text: &[u8] = b"void";
    let mut arrow: i64 = -1;
    for j in 0..rest.len() - 1 {
        if rest[j] == b'-' && rest[j + 1] == b'>' { arrow = j as i64; }
    }
    let params_text = if arrow >= 0 { &rest[0..arrow as usize] } else { rest };
    if arrow >= 0 { ret_text = &rest[(arrow + 2) as usize..]; }
    let mut params: Vec<Param<'_>, Gpa> = Vec::new_in(gpa);
    tb.parse_params(line, params_text, &mut params);
    let colons = selector.iter().copied().filter(|x| ({ let b = *x; b == b':' })).count();
    if colons != params.len() {
        tb.error(line,
            { let selector = str::from_utf8(selector).unwrap();
                format_args("'{selector}' takes {colons} arguments, the line has {}",
                    params.len()) });
    }
    let ret = tb.parse_type(line, ret_text);
    Method {
        line: line, class_method: class_method, selector: selector, params: params, ret: ret,
        alias: alias,
    }
}

// ---- names ----

// The ancestors of d (d first), transitively.
fn ancestors<'a>(tb: &Table<'a, Gpa>, d: &'a [u8], out: &mut Vec<&'a [u8], Gpa>) {
    for x in out.iter().copied() {
        if x == d { return; }
    }
    out.push(d);
    match tb.find_decl(d) {
        Some(dd) => {
            for p in dd.parents.iter().copied() { ancestors(tb, p, out); }
        }
        None => {}
    }
}

// Two methods one type has under the same name: an error (the second
// needs `as NAME`).
fn check_names<'a>(tb: &mut Table<'a, Gpa>, gpa: Gpa) {
    for d in tb.decls.iter() {
        let mut anc: Vec<&[u8], Gpa> = Vec::new_in(gpa);
        ancestors(tb, d.name, &mut anc);
        let mut seen: Vec<Vec<u8, Gpa>, Gpa> = Vec::new_in(gpa);
        for a in anc {
            match tb.find_decl(a) {
                Some(ad) => {
                    for m in ad.methods.iter() {
                        if m.class_method || is_init(m.selector) { continue; }
                        let n = method_name(&m, gpa);
                        for s in seen.iter() {
                            if s.as_slice() == n.as_slice() {
                                tb.error(m.line,
                                    format_args("{} has two methods named '{}' (this is {}): give one `as NAME`", str::from_utf8(d.name).unwrap(), str::from_utf8(n.as_slice()).unwrap(), str::from_utf8(m.selector).unwrap()));
                            }
                        }
                        seen.push(n);
                    }
                }
                None => {
                    if a != d.name {
                        tb.error(d.line,
                            format_args("unknown parent '{}' of {}", str::from_utf8(a).unwrap(),
                                str::from_utf8(d.name).unwrap()));
                    }
                }
            }
        }
    }
}

const KEYWORDS: [&[u8]; 36] = [b"dyn", b"move", b"ref", b"self", b"where", b"while", b"as",
    b"break", b"const", b"continue", b"defer", b"else", b"enum", b"extern", b"false", b"fn", b"for",
    b"if", b"impl", b"import", b"in", b"let", b"loop", b"match", b"mod", b"mut", b"pub", b"return",
    b"static", b"struct", b"trait", b"true", b"type", b"union", b"unsafe", b"use"];

fn push_ident(out: &mut Vec<u8, Gpa>, s: &[u8]) {
    out.extend_from_slice(s);
    for k in KEYWORDS {
        if k == s { out.push(b'_'); }
    }
}

// newBufferWithLength:options: -> new_buffer_with_length_options
fn snake(sel: &[u8], gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    let mut prev: u8 = 0;
    for i in 0..sel.len() {
        let ch = sel[i];
        if ch == b':' {
            prev = b'_';
            continue;
        }
        let next: u8 = if i + 1 < sel.len() { sel[i + 1] } else { 0 };
        if out.len() > 0 && prev == b'_' {
            out.push(b'_');
        }
        else if is_upper(ch) && out.len() > 0
            && (is_lower(prev) || is_digit(prev) || (is_upper(prev) && is_lower(next))) {
            out.push(b'_');
        }
        out.push(if is_upper(ch) { ch + 32 } else { ch });
        prev = ch;
    }
    out
}

fn method_name(m: &Method<'_, Gpa>, gpa: Gpa) -> Vec<u8, Gpa> {
    if m.alias.len() > 0 {
        let mut b = Vec::<u8, Gpa>::new_in(gpa);
        b.extend_from_slice(m.alias);
        return b;
    }
    let s = snake(m.selector, gpa);
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    push_ident(&mut b, s.as_slice());
    b
}

fn is_init(sel: &[u8]) -> bool {
    starts_with(sel, b"init") && (sel.len() == 4 || is_upper(sel[4]) || sel[4] == b':')
}

// The ABI shape's code for a type: one token of the shape's name.
fn shape_code(tb: &Table<'_, Gpa>, t: Ty<'_>, out: &mut Vec<u8, Gpa>) {
    if t.kind == K_VOID { out.push(b'v'); }
    else if t.kind == K_SCALAR {
        match t.code {
            b'Q' => out.extend_from_slice(b"u64"), b'q' => out.extend_from_slice(b"i64"),
            b'I' => out.extend_from_slice(b"u32"),
            b'i' => out.extend_from_slice(b"i32"), b'S' => out.extend_from_slice(b"u16"),
            b's' => out.extend_from_slice(b"i16"),
            b'C' => out.extend_from_slice(b"u8"), b'c' => out.extend_from_slice(b"i8"),
            b'B' => out.extend_from_slice(b"bool"),
            b'f' => out.extend_from_slice(b"f32"), _ => out.extend_from_slice(b"f64"),
        }
    }
    else if t.kind == K_STRUCT { out.extend_from_slice(t.name); }
    else { out.push(b'p'); }
}

// The type in the extern declaration.
fn abi_type(t: Ty<'_>, out: &mut Vec<u8, Gpa>) {
    if t.kind == K_SCALAR || t.kind == K_STRUCT { out.extend_from_slice(t.name); }
    else { out.extend_from_slice(b"*mut u8"); }
}

// A table's pointer type (`*u8`, `**u8`) as the rust edition writes it:
// every `*` a `*mut `.
fn ptr_type(name: &[u8], out: &mut Vec<u8, Gpa>) {
    for i in 0..name.len() {
        if name[i] == b'*' { out.extend_from_slice(b"*mut "); } else { out.push(name[i]); }
    }
}

// The type in the wrapper's signature.
// lt: the lifetime of a Ref there (`'_` a parameter's, `'a` the receiver's
// for an instance method's +0 result, `'static` a class method's).
fn api_type(tb: &Table<'_, Gpa>, t: Ty<'_>, is_result: bool, lt: &[u8], out: &mut Vec<u8, Gpa>) {
    if t.kind == K_OBJ {
        if t.nullable { out.extend_from_slice(b"Option<"); }
        if t.own && is_result {
            out.extend_from_slice(b"Id<");
        } else {
            out.extend_from_slice(b"Ref<");
            out.extend_from_slice(lt);
            out.extend_from_slice(b", ");
        }
        out.extend_from_slice(t.name);
        out.push(b'>');
        if t.nullable { out.push(b'>'); }
    } else if t.kind == K_PTR {
        ptr_type(t.name, out);
    } else {
        abi_type(t, out);
    }
}

fn shape_name(tb: &Table<'_, Gpa>, m: &Method<'_, Gpa>, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(b"msg_");
    shape_code(tb, m.ret, &mut b);
    for p in m.params.iter().copied() {
        b.push(b'_');
        shape_code(tb, p.ty, &mut b);
    }
    b
}

// ---- generation ----

struct Gen<'a, A: Allocator> {
    out: Vec<u8, A>,
    shapes: Vec<Vec<u8, A>, A>,
    shape_lines: Vec<u8, A>,
    sels: Vec<&'a [u8], A>,
    classes: Vec<&'a [u8], A>,
}

fn sel_index<'a>(g: &mut Gen<'a, Gpa>, sel: &'a [u8]) -> i64 {
    for i in 0..g.sels.len() {
        if g.sels[i] == sel { return i as i64; }
    }
    g.sels.push(sel);
    g.sels.len() as i64 - 1
}

fn class_index<'a>(g: &mut Gen<'a, Gpa>, name: &'a [u8]) -> i64 {
    for i in 0..g.classes.len() {
        if g.classes[i] == name { return i as i64; }
    }
    g.classes.push(name);
    g.classes.len() as i64 - 1
}

fn need_shape(tb: &Table<'_, Gpa>, g: &mut Gen<'_, Gpa>, m: &Method<'_, Gpa>, gpa: Gpa) -> Vec<u8,
    Gpa> {
    let name = shape_name(tb, m, gpa);
    for s in g.shapes.iter() {
        if s.as_slice() == name.as_slice() { return name; }
    }
    push_shape(&mut g.shape_lines, name.as_slice(), m);
    g.shapes.push(name.clone());
    name
}

fn push_shape(l: &mut Vec<u8, Gpa>, name: &[u8], m: &Method<'_, Gpa>) {
    l.extend_from_slice(b"    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn ");
    l.extend_from_slice(name);
    l.extend_from_slice(b"(o: *mut u8, s: *mut u8");
    for i in 0..m.params.len() {
        let p = m.params[i];
        l.extend_from_slice(format_in(", a{i}: ", *l.allocator()).as_bytes());
        abi_type(p.ty, l);
    }
    l.push(b')');
    if m.ret.kind != K_VOID {
        l.extend_from_slice(b" -> ");
        abi_type(m.ret, l);
    }
    l.extend_from_slice(b";\n");
}

fn is_unsafe(m: &Method<'_, Gpa>) -> bool {
    m.params.iter().copied().any(|p| p.ty.kind == K_PTR)
}

// The signature after `fn `: name(self, a: A) -> R
fn push_signature(tb: &Table<'_, Gpa>, out: &mut Vec<u8, Gpa>, m: &Method<'_, Gpa>, recv: &[u8],
    recv_kind: i64, gpa: Gpa) {
    let name = method_name(m, gpa);
    out.extend_from_slice(name.as_slice());
    out.push(b'(');
    let mut first = true;
    if recv_kind == 3 {
        out.extend_from_slice(b"self");
        first = false;
    } else if recv_kind == 1 {
        out.extend_from_slice(b"self");
        first = false;
    } else if recv_kind == 2 {
        out.extend_from_slice(b"this: Id<");
        out.extend_from_slice(recv);
        out.push(b'>');
        first = false;
    }
    for p in m.params.iter().copied() {
        if !first { out.extend_from_slice(b", "); }
        first = false;
        push_ident(out, p.name);
        out.extend_from_slice(b": ");
        api_type(tb, p.ty, false, b"'_", out);
    }
    out.push(b')');
    if m.ret.kind != K_VOID {
        out.extend_from_slice(b" -> ");
        api_type(tb, m.ret, true, if recv_kind == 1 || recv_kind == 3 { b"'a" } else { b"'static" },
            out);
    }
}

// A comment of words, wrapped at 96 columns, each line `indent// `.
fn push_comment(out: &mut Vec<u8, Gpa>, indent: &[u8], text: &[u8]) {
    let mut col: i64 = 0;
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        let mut j = i;
        while j < text.len() as i64 && text[j as usize] != b' ' { j += 1; }
        let word = &text[i as usize..j as usize];
        if col > 0 && col + 1 + word.len() as i64 > 96 {
            out.push(b'\n');
            col = 0;
        }
        if col == 0 {
            out.extend_from_slice(indent);
            out.extend_from_slice(b"//");
            col = indent.len() as i64 + 2;
        }
        out.push(b' ');
        out.extend_from_slice(word);
        col += 1 + word.len() as i64;
        i = j + 1;
    }
    if col > 0 { out.push(b'\n'); }
}

// A zero of a type, for the result of a message to nil.
fn push_zero(tb: &Table<'_, Gpa>, t: Ty<'_>, out: &mut Vec<u8, Gpa>) {
    if t.kind == K_STRUCT {
        match tb.find_struct(t.name) {
            Some(s) => {
                out.extend_from_slice(s.name);
                out.extend_from_slice(b" { ");
                for i in 0..s.fields.len() {
                    let f = s.fields[i];
                    if i > 0 { out.extend_from_slice(b", "); }
                    push_ident(out, f.name);
                    out.extend_from_slice(b": ");
                    push_zero(tb, f.ty, out);
                }
                out.extend_from_slice(b" }");
            }
            None => out.push(b'0'),
        }
    } else if t.kind == K_SCALAR {
        if t.code == b'f' || t.code == b'd' { out.extend_from_slice(b"0.0"); }
        else if t.code == b'B' { out.extend_from_slice(b"false"); }
        else { out.push(b'0'); }
    } else {
        out.extend_from_slice(b"0 as *mut u8");
    }
}

// The pointer parameters of m, `a`, `b and c`.
fn ptr_params(m: &Method<'_, Gpa>, out: &mut Vec<u8, Gpa>) {
    let mut n: i64 = 0;
    for p in m.params.iter().copied() {
        if p.ty.kind == K_PTR { n += 1; }
    }
    let mut k: i64 = 0;
    for p in m.params.iter().copied() {
        if p.ty.kind != K_PTR { continue; }
        if k > 0 { out.extend_from_slice(if k == n - 1 { b" and " } else { b", " }); }
        out.push(b'`');
        push_ident(out, p.name);
        out.push(b'`');
        k += 1;
    }
}

// The comments above an `unsafe fn` wrapper (a method with a pointer
// parameter): why it cannot be safe, and the caller's obligation.
fn push_unsafe_fn_doc(out: &mut Vec<u8, Gpa>, indent: &[u8], m: &Method<'_, Gpa>, gpa: Gpa) {
    let mut t = Vec::<u8, Gpa>::new_in(gpa);
    let sign = if m.class_method { "+" } else { "-" };
    t.extend_from_slice(format_in("UNSAFE: {sign}{} takes the raw pointer ",
        str::from_utf8(m.selector).unwrap(), *t.allocator()).as_bytes());
    ptr_params(m, &mut t);
    t.extend_from_slice(b", whose extent and lifetime no type states.");
    push_comment(out, indent, t.as_slice());
    t.clear();
    t.extend_from_slice(b"SAFETY: the caller's:");
    let mut first = true;
    for p in m.params.iter().copied() {
        if p.ty.kind != K_PTR { continue; }
        t.extend_from_slice(if first { b" " } else { b"; " });
        first = false;
        if p.name == b"error" {
            t.extend_from_slice(
                b"`error` is null or the address of a writable *mut u8 slot, where");
            t.extend_from_slice(
                format_in(" {sign}{} stores an autoreleased NSError or nil (NSError **)",
                    str::from_utf8(m.selector).unwrap(), *t.allocator()).as_bytes());
        } else {
            t.push(b'`');
            push_ident(&mut t, p.name);
            t.extend_from_slice(
                format_in("` points to memory valid for what {sign}{} reads or writes",
                    str::from_utf8(m.selector).unwrap(), *t.allocator()).as_bytes());
            t.extend_from_slice(b" through it, for as long as the object uses it");
        }
    }
    t.push(b'.');
    push_comment(out, indent, t.as_slice());
    drop(t);
}

// The comments above a wrapper's message send: why it is unsafe (a C call
// the compiler cannot check) and why it is sound (the prototype checked
// against the runtime, the receiver, the arguments, the result's owner).
// recv_kind: 1 an instance method of `ty` (declared by `decl`), 0 a class
// method, 2 the init family.
fn push_send_doc(tb: &Table<'_, Gpa>, out: &mut Vec<u8, Gpa>, m: &Method<'_, Gpa>, shape: &[u8],
    recv: &[u8], recv_kind: i64, ty: &[u8], decl: &[u8], gpa: Gpa) {
    let sign = if m.class_method { "+" } else { "-" };
    let mut t = String::new_in(gpa);
    std::fmt::write(&mut t, "UNSAFE: {sign}{} is sent by objc_msgSend, a C call whose types the",
        str::from_utf8(m.selector).unwrap()).unwrap();
    t.push_str(" compiler cannot see.");
    push_comment(out, b"        ", t.as_bytes());
    t.clear();
    { let shape = str::from_utf8(shape).unwrap();
        std::fmt::write(&mut t,
            "SAFETY: {shape} is its C prototype, checked against the runtime's type encoding").unwrap() };
    t.push_str(" (objcgen --check)");
    if recv_kind == 1 {
        { let ty = str::from_utf8(ty).unwrap();
            std::fmt::write(&mut t, "; self.ptr is nil or a live {ty} (Ref's invariant)").unwrap() };
        if ty
            != decl {
            { let decl = str::from_utf8(decl).unwrap();
                std::fmt::write(&mut t, ", which has {decl}'s methods").unwrap() };
        }
        if m.ret.kind != K_STRUCT { t.push_str(", and a message to nil returns zero"); }
    } else if recv_kind == 0 {
        { let recv = str::from_utf8(recv).unwrap();
            { let decl = str::from_utf8(decl).unwrap();
                std::fmt::write(&mut t,
                    "; {recv} is the class {decl}, or nil before its framework is opened, and a").unwrap() } };
        t.push_str(" message to nil returns zero");
    } else {
        { let decl = str::from_utf8(decl).unwrap();
            { let recv = str::from_utf8(recv).unwrap();
                std::fmt::write(&mut t,
                    "; `this` is a +1 {decl} (or nil) that {recv} hands to the init family, which").unwrap() } };
        t.push_str(" consumes it");
    }
    let mut objs = false;
    for p in m.params.iter().copied() {
        if p.ty.kind == K_OBJ { objs = true; }
    }
    if objs {
        t.push_str("; the object arguments are live objects (or nil) of their declared types,");
        t.push_str(" borrowed for the call");
    }
    let r = m.ret;
    if r.kind == K_OBJ {
        if r.own {
            t.push_str("; the result is +1, and the Id returned owns and releases it");
        } else if recv_kind == 1 {
            t.push_str("; the +0 result is a Ref of self's lifetime, so it cannot outlive the");
            t.push_str(" receiver that holds it");
        } else {
            t.push_str("; the +0 result is kept by the process (a class) or the current");
            t.push_str(" autorelease pool (from_global's rule)");
        }
    } else if r.kind == K_STRUCT {
        t.push_str("; a nil receiver is answered with zeroes first, as a message to nil does not");
        t.push_str(" write a struct result returned in memory");
    } else if r.kind == K_PTR {
        t.push_str("; the pointer result is returned raw: reading through it is the caller's");
        t.push_str(" unsafe");
    }
    t.push(char::from_u32('.' as u32).unwrap());
    push_comment(out, b"        ", t.as_bytes());
    drop(t);
}

fn push_body<'a>(tb: &Table<'a, Gpa>, g: &mut Gen<'a, Gpa>, out: &mut Vec<u8, Gpa>,
    m: &Method<'a, Gpa>, receiver: &[u8], recv_kind: i64, ty: &[u8], decl: &[u8], gpa: Gpa) {
    let shape = need_shape(tb, g, m, gpa);
    let si = sel_index(g, m.selector);
    let mut call = Vec::<u8, Gpa>::new_in(gpa);
    call.extend_from_slice(shape.as_slice());
    call.push(b'(');
    call.extend_from_slice(receiver);
    call.extend_from_slice(format_in(", sel_{si}()", *call.allocator()).as_bytes());
    for p in m.params.iter().copied() {
        call.extend_from_slice(b", ");
        if p.ty.kind == K_OBJ {
            if p.ty.nullable {
                call.extend_from_slice(b"opt_ptr(");
                push_ident(&mut call, p.name);
                call.push(b')');
            } else {
                push_ident(&mut call, p.name);
                call.extend_from_slice(b".ptr");
            }
        } else {
            push_ident(&mut call, p.name);
        }
    }
    call.push(b')');
    let c = call.as_slice();
    let in_unsafe = is_unsafe(m);
    out.extend_from_slice(b" {\n");
    if m.ret.kind == K_STRUCT {
        // a message to nil leaves a struct result in memory unwritten
        out.extend_from_slice({
            let receiver = str::from_utf8(receiver).unwrap();
            format_in("        if {receiver}.is_null() {{\n            return ", *out.allocator())
        }.as_bytes());
        push_zero(tb, m.ret, out);
        out.extend_from_slice(b";\n        }\n");
    }
    if !in_unsafe {
        push_send_doc(tb, out, m, shape.as_slice(), receiver, recv_kind, ty, decl, gpa);
    }
    out.extend_from_slice(b"        ");
    if !in_unsafe { out.extend_from_slice(b"unsafe { "); }
    let r = m.ret;
    if r.kind == K_OBJ {
        if r.own {
            if r.nullable {
                out.extend_from_slice({
                    let c = str::from_utf8(c).unwrap();
                    format_in("Id::<{}>::from_owned({c})", str::from_utf8(r.name).unwrap(),
                        *out.allocator())
                }.as_bytes());
            }
            else {
                out.extend_from_slice({
                    let c = str::from_utf8(c).unwrap();
                    format_in("Id::<{}>::from_owned_or_nil({c})", str::from_utf8(r.name).unwrap(),
                        *out.allocator())
                }.as_bytes());
            }
        } else {
            // a +0 result lives as long as its receiver (or the pool)
            if receiver == b"self.ptr" {
                if r.nullable {
                    out.extend_from_slice({
                        let c = str::from_utf8(c).unwrap();
                        format_in("Ref::<{}>::from_raw_opt({c}, self)",
                            str::from_utf8(r.name).unwrap(), *out.allocator())
                    }.as_bytes());
                }
                else { out.extend_from_slice(
                    { let c = str::from_utf8(c).unwrap();
                        format_in("Ref::<{}>::from_raw({c}, self)", str::from_utf8(r.name).unwrap(),
                            *out.allocator()) }.as_bytes()); }
            } else {
                if r.nullable {
                    out.extend_from_slice({
                        let c = str::from_utf8(c).unwrap();
                        format_in("Ref::<{}>::from_global_opt({c})",
                            str::from_utf8(r.name).unwrap(), *out.allocator())
                    }.as_bytes());
                }
                else {
                    out.extend_from_slice({
                        let c = str::from_utf8(c).unwrap();
                        format_in("Ref::<{}>::from_global({c})", str::from_utf8(r.name).unwrap(),
                            *out.allocator())
                    }.as_bytes());
                }
            }
        }
    } else {
        out.extend_from_slice(c);
    }
    if r.kind == K_VOID { out.push(b';'); }
    if !in_unsafe { out.extend_from_slice(b" }"); }
    out.extend_from_slice(b"\n    }\n");
    drop(call);
}

// The declarations whose instances have d's methods: d and every
// declaration deriving from it, transitively.
fn heirs<'a>(tb: &Table<'a, Gpa>, d: &'a [u8], out: &mut Vec<&'a [u8], Gpa>) {
    for x in out.iter().copied() {
        if x == d { return; }
    }
    out.push(d);
    for e in tb.decls.iter() {
        for p in e.parents.iter().copied() {
            if p == d { heirs(tb, e.name, out); }
        }
    }
}

fn generate(tb: &Table<'_, Gpa>, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut g = Gen {
        out: Vec::<u8, Gpa>::new_in(gpa), shapes: Vec::new_in(gpa),
        shape_lines: Vec::<u8, Gpa>::new_in(gpa),
        sels: Vec::new_in(gpa), classes: Vec::new_in(gpa),
    };
    let mut body = Vec::<u8, Gpa>::new_in(gpa);
    gen_items(tb, &mut g, &mut body, gpa);
    finish(tb, &mut g, body.as_slice());
    drop(body);
    g.out
}

fn gen_items<'a>(tb: &Table<'a, Gpa>, g: &mut Gen<'a, Gpa>, b: &mut Vec<u8, Gpa>, gpa: Gpa) {
    for s in tb.structs.iter() {
        b.extend_from_slice(b"#[repr(C)]\n#[derive(Clone, Copy)]\npub struct ");
        b.extend_from_slice(s.name);
        b.extend_from_slice(b" {\n");
        for f in s.fields.iter().copied() {
            b.extend_from_slice(b"    pub ");
            push_ident(b, f.name);
            b.extend_from_slice(b": ");
            abi_type(f.ty, b);
            b.extend_from_slice(b",\n");
        }
        b.extend_from_slice(b"}\n\n");
    }
    for k in tb.consts.iter().copied() {
        b.extend_from_slice(format_in("pub const {}: {} = {};\n", str::from_utf8(k.name).unwrap(),
            str::from_utf8(k.ty).unwrap(), str::from_utf8(k.value).unwrap(),
            *b.allocator()).as_bytes());
    }
    if tb.consts.len() > 0 { b.push(b'\n'); }
    for di in 0..tb.decls.len() {
        let d = &tb.decls[di];
        let kind = if d.is_protocol { "protocol" } else { "class" };
        b.extend_from_slice(format_in("/// The Objective-C {kind} {}.\npub struct {} {{}}\n\n",
            str::from_utf8(d.name).unwrap(), str::from_utf8(d.name).unwrap(),
            *b.allocator()).as_bytes());
        // instance methods: a trait, implemented for Ref<D> and its heirs
        let mut inst: i64 = 0;
        for m in d.methods.iter() {
            if !m.class_method && !is_init(m.selector) { inst += 1; }
        }
        if inst > 0 {
            b.extend_from_slice(
                format_in("pub trait {}Methods<'a> {{\n", str::from_utf8(d.name).unwrap(),
                    *b.allocator()).as_bytes());
            for m in d.methods.iter() {
                if m.class_method || is_init(m.selector) { continue; }
                b.extend_from_slice(format_in("    // {}\n", str::from_utf8(m.selector).unwrap(),
                    *b.allocator()).as_bytes());
                if is_unsafe(&m) { push_unsafe_fn_doc(b, b"    ", &m, gpa); }
                b.extend_from_slice(b"    ");
                if is_unsafe(&m) { b.extend_from_slice(b"unsafe "); }
                b.extend_from_slice(b"fn ");
                push_signature(tb, b, &m, b"Self", 3, gpa);
                // the trait's receiver is `self: Self`
                b.extend_from_slice(b";\n");
            }
            b.extend_from_slice(b"}\n\n");
            let mut hs: Vec<&[u8], Gpa> = Vec::new_in(gpa);
            heirs(tb, d.name, &mut hs);
            for h in hs.iter().copied() {
                b.extend_from_slice(format_in("impl<'a> {}Methods<'a> for Ref<'a, {}> {{\n",
                    str::from_utf8(d.name).unwrap(), str::from_utf8(h).unwrap(),
                    *b.allocator()).as_bytes());
                for m in d.methods.iter() {
                    if m.class_method || is_init(m.selector) { continue; }
                    if is_unsafe(&m) { push_unsafe_fn_doc(b, b"    ", &m, gpa); }
                    b.extend_from_slice(b"    ");
                    if is_unsafe(&m) { b.extend_from_slice(b"unsafe "); }
                    b.extend_from_slice(b"fn ");
                    push_signature(tb, b, &m, h, 1, gpa);
                    push_body(tb, g, b, &m, b"self.ptr", 1, h, d.name, gpa);
                }
                b.extend_from_slice(b"}\n\n");
            }
            drop(hs);
        }
        // class methods and the init family: associated functions
        let mut assoc: i64 = 0;
        for m in d.methods.iter() {
            if m.class_method || is_init(m.selector) { assoc += 1; }
        }
        if assoc > 0 {
            b.extend_from_slice(format_in("impl {} {{\n", str::from_utf8(d.name).unwrap(),
                *b.allocator()).as_bytes());
            for m in d.methods.iter() {
                if m.class_method {
                    let ci = class_index(g, d.name);
                    b.extend_from_slice(
                        format_in("    // +{}\n", str::from_utf8(m.selector).unwrap(),
                            *b.allocator()).as_bytes());
                    if is_unsafe(&m) { push_unsafe_fn_doc(b, b"    ", &m, gpa); }
                    b.extend_from_slice(b"    pub ");
                    if is_unsafe(&m) { b.extend_from_slice(b"unsafe "); }
                    b.extend_from_slice(b"fn ");
                    push_signature(tb, b, &m, d.name, 0, gpa);
                    let recv = format_in("class_{ci}()", gpa);
                    push_body(tb, g, b, &m, recv.as_bytes(), 0, d.name, d.name, gpa);
                } else if is_init(m.selector) {
                    b.extend_from_slice(
                        format_in("    // -{}: consumes `this` (the init family), returns +1\n",
                            str::from_utf8(m.selector).unwrap(), *b.allocator()).as_bytes());
                    if is_unsafe(&m) { push_unsafe_fn_doc(b, b"    ", &m, gpa); }
                    b.extend_from_slice(b"    pub ");
                    if is_unsafe(&m) { b.extend_from_slice(b"unsafe "); }
                    b.extend_from_slice(b"fn ");
                    push_signature(tb, b, &m, d.name, 2, gpa);
                    push_body(tb, g, b, &m, b"this.into_raw()", 2, d.name, d.name, gpa);
                }
            }
            b.extend_from_slice(b"}\n\n");
        }
    }
}

fn finish(tb: &Table<'_, Gpa>, g: &mut Gen<'_, Gpa>, body: &[u8]) {
    g.out.extend_from_slice(
        format_in("// EDITION: rust\n// Generated by tools/objcgen from {}: do not edit.\n",
            str::from_utf8(tb.file).unwrap(), *g.out.allocator()).as_bytes());
    g.out.extend_from_slice(b"// Every prototype below is checked against the Objective-C runtime's\n// type encoding by `objcgen --check`, and every constant and struct\n// against the SDK's headers by `objcgen --c-check` (tests/gpu/run.sh).\n\n");
    g.out.extend_from_slice(
        format_in("use {}::{{Id, Object, Ref, cached_class, cached_selector, opt_ptr}};\n",
            str::from_utf8(tb.objc).unwrap(), *g.out.allocator()).as_bytes());
    g.out.extend_from_slice(if starts_with(tb.objc, b"crate::") {
        b"use crate::sync::atomic::Atomic;\n"
    } else {
        b"use std::sync::atomic::Atomic;\n"
    });
    for u in tb.uses.iter().copied() {
        g.out.extend_from_slice(u);
        if u[u.len() - 1] != b';' { g.out.push(b';'); }
        g.out.push(b'\n');
    }
    // (two lines: a binding module's head is in std's core, which every
    // program reads)
    g.out.extend_from_slice(
        b"\n// UNSAFE: objc_msgSend, declared per ABI shape. SAFETY: each shape checked\n");
    g.out.extend_from_slice(
        b"// against the runtime (objcgen --check), the structs against the SDK (--c-check).\n");
    g.out.extend_from_slice(b"extern \"C\" {\n");
    g.out.extend_from_slice(g.shape_lines.as_slice());
    g.out.extend_from_slice(b"}\n\n");
    g.out.extend_from_slice(b"// The selectors and classes, looked up on first use.\n");
    for i in 0..g.sels.len() {
        let s = g.sels[i];
        g.out.extend_from_slice({ let s = str::from_utf8(s).unwrap(); format_in("static SEL_{i}: Atomic<usize> = Atomic::new(0);\n\n#[effects(io, panic, diverge)]\nfn sel_{i}() -> *mut u8 {{\n    cached_selector(&SEL_{i}, \"{s}\")\n}}\n\n", *g.out.allocator()) }.as_bytes());
    }
    for i in 0..g.classes.len() {
        let s = g.classes[i];
        g.out.extend_from_slice({ let s = str::from_utf8(s).unwrap(); format_in("static CLASS_{i}: Atomic<usize> = Atomic::new(0);\n\n#[effects(io, panic, diverge)]\nfn class_{i}() -> *mut u8 {{\n    cached_class(&CLASS_{i}, \"{s}\")\n}}\n\n", *g.out.allocator()) }.as_bytes());
    }
    g.out.extend_from_slice(body);
}

// ---- the runtime check ----

// The canonical form of one type of an encoding at s[*i]: qualifiers and
// offsets dropped, pointers as '^', structs as {fields}.
fn put(out: &mut Vec<u8, Gpa>, emit: bool, ch: u8) {
    if emit { out.push(ch); }
}

fn canon_one(s: &[u8], i: &mut i64, out: &mut Vec<u8, Gpa>, emit: bool) {
    while *i < s.len() as i64 && find_byte(b"rnNoORVA", s[*i as usize]) >= 0 { *i += 1; }
    if *i >= s.len() as i64 { return; }
    let ch = s[*i as usize];
    *i += 1;
    if ch == b'{' {
        while *i < s.len() as i64 && s[*i as usize] != b'=' && s[*i as usize] != b'}' { *i += 1; }
        if *i < s.len() as i64 && s[*i as usize] == b'=' { *i += 1; }
        put(out, emit, b'{');
        while *i < s.len() as i64 && s[*i as usize] != b'}' { canon_one(s, i, out, emit); }
        *i += 1;
        put(out, emit, b'}');
    } else if ch == b'^' || ch == b'*' {
        put(out, emit, b'^');
        if ch == b'^' {
            canon_one(s, i, out, false);
        }
    } else if ch == b'@' {
        put(out, emit, b'@');
        if *i < s.len() as i64 && s[*i as usize] == b'?' {
            put(out, emit, b'?');
            *i += 1;
        } else if *i < s.len() as i64 && s[*i as usize] == b'"' {
            *i += 1;
            while *i < s.len() as i64 && s[*i as usize] != b'"' { *i += 1; }
            *i += 1;
        }
    } else if ch == b'[' {
        put(out, emit, b'[');
        while *i < s.len() as i64 && is_digit(s[*i as usize]) { *i += 1; }
        canon_one(s, i, out, emit);
        *i += 1;
        put(out, emit, b']');
    } else {
        put(out, emit, ch);
    }
    while *i < s.len() as i64 && is_digit(s[*i as usize]) { *i += 1; }
}

fn canon(s: &[u8], gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    let mut i: i64 = 0;
    while i < s.len() as i64 { canon_one(s, &mut i, &mut out, true); }
    out
}

fn expect_one(tb: &Table<'_, Gpa>, t: Ty<'_>, out: &mut Vec<u8, Gpa>) {
    if t.kind == K_STRUCT {
        out.push(b'{');
        match tb.find_struct(t.name) {
            Some(sd) => {
                for f in sd.fields.iter().copied() { expect_one(tb, f.ty, out); }
            }
            None => {}
        }
        out.push(b'}');
    } else {
        out.push(t.code);
    }
}

fn expected(tb: &Table<'_, Gpa>, m: &Method<'_, Gpa>, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    expect_one(tb, m.ret, &mut out);
    out.extend_from_slice(b"@:");
    for p in m.params.iter().copied() { expect_one(tb, p.ty, &mut out); }
    out
}

fn cstr(s: &[u8], gpa: Gpa) -> Vec<u8, Gpa> {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(s);
    b.push(0u8);
    b
}

// UNSAFE: reads p up to its NUL and makes a 'static slice of it: no type says either holds.
// SAFETY: the caller's: p is nil or a NUL-terminated string that outlives the slice (the
// runtime's type encodings and argv's strings live as long as the process).
unsafe fn from_c(p: *mut u8) -> &'static [u8] {
    if p == 0 as *mut u8 { return b""; }
    std::slice::from_raw_parts(p.add((0) as usize), (strlen(p) as i64 - (0)) as usize)
}

// The runtime's encoding of a declaration's method, or "".
fn runtime_encoding(d: &Decl<'_, Gpa>, m: &Method<'_, Gpa>, gpa: Gpa) -> &'static [u8] {
    let name = cstr(d.name, gpa);
    let selname = cstr(m.selector, gpa);
    // UNSAFE: calls to the Objective-C runtime, which take and return raw pointers.
    // SAFETY: name and selname are NUL-terminated (cstr) and live across the calls; a class,
    // protocol, selector or method the runtime returns is nil (checked) or lives as long as
    // the process; the objects made to probe a class are released once.
    unsafe {
        let sel = sel_registerName(selname.as_slice().ptr);
        if d.is_protocol {
            let p = objc_getProtocol(name.as_slice().ptr);
            if p == 0 as *mut u8 { return b""; }
            let inst = !m.class_method;
            let mut md = protocol_getMethodDescription(p, sel, true, inst);
            if md.types == 0 as *mut u8 { md = protocol_getMethodDescription(p, sel, false, inst); }
            return from_c(md.types);
        }
        let cls = objc_getClass(name.as_slice().ptr);
        if cls == 0 as *mut u8 { return b""; }
        if m.class_method {
            return from_c(method_getTypeEncoding(class_getClassMethod(cls, sel)));
        }
        let mut meth = class_getInstanceMethod(cls, sel);
        if meth == 0 as *mut u8 {
            // property accessors live in the private subclass that alloc
            // (or alloc then init) returns: MTLTextureDescriptorInternal
            let a = msg_p(cls, sel_registerName(c"alloc"));
            if a != 0 as *mut u8 {
                meth = class_getInstanceMethod(object_getClass(a), sel);
                if meth == 0 as *mut u8 {
                    let o = msg_p(a, sel_registerName(c"init"));
                    if o != 0 as *mut u8 {
                        meth = class_getInstanceMethod(object_getClass(o), sel);
                        objc_release(o);
                    }
                } else {
                    // an allocated, uninitialized object: init it to free it
                    let o = msg_p(a, sel_registerName(c"init"));
                    if o != 0 as *mut u8 { objc_release(o); }
                }
            }
        }
        if meth == 0 as *mut u8 { return b""; }
        from_c(method_getTypeEncoding(meth))
    }
}

fn check<'a>(tb: &mut Table<'a, Gpa>, gpa: Gpa) -> i64 {
    for f in tb.frameworks.iter().copied() {
        let path = {
            let f = str::from_utf8(f).unwrap();
            format_in("/System/Library/Frameworks/{f}.framework/{f}", gpa)
        };
        let p = cstr(path.as_bytes(), gpa);
        // UNSAFE: dlopen is a C call taking a C string.
        // SAFETY: p is the path, NUL-terminated by cstr, alive across the call.
        let h = unsafe { c::dlopen(p.as_slice().ptr, c::RTLD_NOW) };
        if h == 0 as *mut u8 {
            eprintln("{}: error objcgen.framework: cannot open {}",
                str::from_utf8(tb.file).unwrap(), str::from_utf8(path.as_bytes()).unwrap());
            return 1;
        }
    }
    let mut bad: i64 = 0;
    let mut n: i64 = 0;
    for d in tb.decls.iter() {
        for m in d.methods.iter() {
            n += 1;
            let mut enc = runtime_encoding(&d, &m, gpa);
            if enc.len() == 0 && !d.is_protocol {
                // an abstract class's accessors live in its heirs'
                // private subclasses: check them on a table heir
                let mut hs: Vec<&[u8], Gpa> = Vec::new_in(gpa);
                heirs(tb, d.name, &mut hs);
                for h in hs.iter().copied() {
                    if enc.len() > 0 { break; }
                    match tb.find_decl(h) {
                        Some(hd) => { enc = runtime_encoding(&hd, &m, gpa); }
                        None => {}
                    }
                }
                drop(hs);
            }
            let want = expected(tb, &m, gpa);
            let sign = if m.class_method { "+" } else { "-" };
            if enc.len() == 0 {
                eprintln(
                    "{}:{}: error objcgen.missing: {} {sign}{} is not in the runtime",
                    str::from_utf8(tb.file).unwrap(), m.line, str::from_utf8(d.name).unwrap(),
                    str::from_utf8(m.selector).unwrap());
                bad += 1;
                continue;
            }
            let got = canon(enc, gpa);
            if got.as_slice() != want.as_slice() {
                eprintln(
                    "{}:{}: error objcgen.encoding: {} {sign}{} is {enc} in the runtime ({}), the table says {}", str::from_utf8(tb.file).unwrap(), m.line, str::from_utf8(d.name).unwrap(), str::from_utf8(m.selector).unwrap(), str::from_utf8(got.as_slice()).unwrap(), str::from_utf8(want.as_slice()).unwrap(), enc = str::from_utf8(enc).unwrap());
                eprintln("  help: Q u64, q i64, I u32, i i32, B bool, f f32, d f64, @ an object, ^ a pointer, {{..}} a struct; the first type is the result, then @: (self, _cmd)");
                bad += 1;
            }
        }
    }
    if bad > 0 { return 1; }
    println("objcgen: {}: {n} methods match the runtime", str::from_utf8(tb.file).unwrap());
    0
}

// ---- the header check ----

fn c_type(t: &[u8]) -> &[u8] {
    if t == b"u64" { b"unsigned long long" } else if t == b"i64" { b"long long" }
    else if t == b"u32" { b"unsigned int" } else if t == b"i32" { b"int" }
    else if t == b"f64" { b"double" } else if t == b"f32" { b"float" } else { t }
}

fn c_check(tb: &Table<'_, Gpa>, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut o = Vec::<u8, Gpa>::new_in(gpa);
    o.extend_from_slice(
        format_in("// Generated by objcgen --c-check from {}: compile with clang -fsyntax-only.\n",
            str::from_utf8(tb.file).unwrap(), *o.allocator()).as_bytes());
    for h in tb.headers.iter().copied() { o.extend_from_slice(
        format_in("#import <{}>\n", str::from_utf8(h).unwrap(), *o.allocator()).as_bytes()); }
    o.extend_from_slice(b"#include <stddef.h>\n\n");
    for k in tb.consts.iter().copied() {
        o.extend_from_slice(format_in("_Static_assert({} == {}, \"{}:{}: {} is not {}\");\n",
            str::from_utf8(k.name).unwrap(), str::from_utf8(k.value).unwrap(),
            str::from_utf8(tb.file).unwrap(), k.line, str::from_utf8(k.name).unwrap(),
            str::from_utf8(k.value).unwrap(), *o.allocator()).as_bytes());
    }
    for s in tb.structs.iter() {
        let mut size: i64 = 0;
        o.extend_from_slice(
            format_in("_Static_assert(sizeof({}) == ", str::from_utf8(s.name).unwrap(),
                *o.allocator()).as_bytes());
        let mut sizes = String::new_in(gpa);
        for f in s.fields.iter().copied() {
            std::fmt::write(&mut sizes, "sizeof({}) + ", str::from_utf8(c_type(f.ty.name)).unwrap()).unwrap();
            size += 1;
        }
        o.extend_from_slice(sizes.as_bytes());
        o.extend_from_slice(format_in("0, \"{}:{}: the size of {}\");\n",
            str::from_utf8(tb.file).unwrap(), s.line, str::from_utf8(s.name).unwrap(),
            *o.allocator()).as_bytes());
        for f in s.fields.iter().copied() {
            o.extend_from_slice(format_in("_Static_assert(__builtin_types_compatible_p(__typeof__((({} *)0)->{}), {}) || sizeof((({} *)0)->{}) == sizeof({}), \"{}:{}: {}.{}\");\n", str::from_utf8(s.name).unwrap(), str::from_utf8(f.name).unwrap(), str::from_utf8(c_type(f.ty.name)).unwrap(), str::from_utf8(s.name).unwrap(), str::from_utf8(f.name).unwrap(), str::from_utf8(c_type(f.ty.name)).unwrap(), str::from_utf8(tb.file).unwrap(), s.line, str::from_utf8(s.name).unwrap(), str::from_utf8(f.name).unwrap(), *o.allocator()).as_bytes());
        }
        drop(sizes);
    }
    o
}

fn read_file(name: &[u8], gpa: Gpa) -> Option<Vec<u8, Gpa>> {
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    let path_c = cstr(name, gpa);
    let path = path_c.as_slice().ptr;
    // UNSAFE: C's fopen, fread and fclose, on raw pointers.
    // SAFETY: path is NUL-terminated (cstr) and outlives the calls; f is checked for null and
    // closed once; fread writes at most 4096 bytes into chunk, a local array of 4096.
    unsafe {
        let f = c::fopen(path, c"rb");
        if f == 0 as *mut c::FILE { return None; }
        let mut chunk: [u8; 4096] = [0; 4096];
        loop {
            let n = c::fread(chunk.as_mut_ptr() as *mut u8, 1u64, 4096u64, f) as i64;
            if n <= 0 { break; }
            out.extend_from_slice(&chunk[0..n as usize]);
        }
        c::fclose(f);
    }
    Some(out)
}

fn main(argc: i32, argv: *mut *mut u8, gpa: Gpa) -> i32 {
    let mut mode: &[u8] = b"gen";
    let mut path: &[u8] = b"";
    for k in 1..argc as i64 {
        // UNSAFE: argv is C's array of C strings, read by index.
        // SAFETY: argv holds argc NUL-terminated strings that live as long as main; k < argc.
        let s = unsafe { from_c((*argv.add(k as usize))) };
        if s == b"--check" { mode = b"check"; }
        else if s == b"--c-check" { mode = b"c-check"; }
        else { path = s; }
    }
    if path.len() == 0 {
        eprintln("usage: objcgen [--check | --c-check] TABLE.objc");
        return 2;
    }
    let text = match read_file(path, gpa) {
        Some(t) => t,
        None => {
            eprintln("error objcgen.read: cannot read {path}",
                path = str::from_utf8(path).unwrap());
            return 2;
        }
    };
    let mut tb = parse_table(text.as_slice(), path, gpa);
    check_names(&mut tb, gpa);
    if get_errors() > 0 { return 1; }
    if mode == b"check" {
        return check(&mut tb, gpa) as i32;
    }
    if mode == b"c-check" {
        print("{}", str::from_utf8(c_check(&tb, gpa).as_slice()).unwrap());
        return 0;
    }
    print("{}", str::from_utf8(generate(&tb, gpa).as_slice()).unwrap());
    0
}

// (0.28.0) ERRORS's accessors: every use of it is one of them.
fn get_errors() -> i64 {
    // UNSAFE: a static mut read.
    // SAFETY: objcgen has one thread; no reference to ERRORS is kept.
    unsafe { ERRORS }
}

fn set_errors(v: i64) {
    // UNSAFE: a static mut written.
    // SAFETY: objcgen has one thread; no reference to ERRORS is kept.
    unsafe {
        ERRORS = v;
    }
}
// EDITION: rust
