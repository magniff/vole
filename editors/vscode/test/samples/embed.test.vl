// SYNTAX TEST "source.vole" "embedded WGSL blocks"
embed wgsl SIM {
// <----- keyword.other.embed.vole
//    ^^^^ entity.name.tag.language.vole
//         ^^^ entity.name.constant.vole
//             ^ punctuation.section.embedded.begin.vole
    // a } in a comment does not end the block
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ meta.embedded.block.wgsl comment.line.double-slash.wgsl
    @compute @workgroup_size(64)
//  ^ meta.embedded.block.wgsl punctuation.definition.attribute.wgsl
//   ^^^^^^^ entity.other.attribute-name.wgsl
//                           ^^ constant.numeric.integer.wgsl
    fn step(@builtin(global_invocation_id) id: vec3<u32>) {
//  ^^ keyword.other.fn.wgsl
//     ^^^^ entity.name.function.wgsl
//                                             ^^^^ entity.name.type.wgsl
        let x = 1u + 2u; /* nested /* } */ still */
//      ^^^ storage.type.wgsl
//              ^^ constant.numeric.integer.wgsl
//                   ^^ constant.numeric.integer.wgsl
//                                     ^^^^^ comment.block.wgsl
        let y = 2.0f;
//              ^^^^ constant.numeric.float.wgsl
    }
//  ^ meta.embedded.block.wgsl punctuation.brackets.curly.wgsl
}
// <- punctuation.section.embedded.end.vole
// <- - meta.embedded.block.wgsl

embed wgsl FILL from "shaders/fill.wgsl";
// <----- keyword.other.embed.vole
//         ^^^^ entity.name.constant.vole
//              ^^^^ keyword.other.embed.vole
//                   ^^^^^^^^^^^^^^^^^^^ string.quoted.double.vole

embed wgsl STEP with COMMON, shaders::GRID {
// <----- keyword.other.embed.vole
//         ^^^^ entity.name.constant.vole
//              ^^^^ keyword.other.embed.vole
//                   ^^^^^^^^^^^^^^^^^^^^^ meta.embed.parts.vole
//                                         ^ punctuation.section.embedded.begin.vole
    @compute @workgroup_size(64)
//  ^ meta.embedded.block.wgsl punctuation.definition.attribute.wgsl
    fn main() {}
}
// <- punctuation.section.embedded.end.vole

embed wgsl LIGHT with COMMON from "shaders/light.wgsl";
// <----- keyword.other.embed.vole
//               ^^^^ keyword.other.embed.vole
//                    ^^^^^^ meta.embed.parts.vole
//                           ^^^^ keyword.other.embed.vole

fn main() {}
// <-- keyword.other.fn.vole
