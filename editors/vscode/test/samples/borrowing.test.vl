// SYNTAX TEST "source.vole" "vole borrowing"
// EDITION: rust
// References, `mut`, lifetimes, raw pointers and `where` (the rust edition's surface).
struct Counter { n: i64 }

impl Counter {
    fn get(&self) -> i64 { self.n }
//         ^ keyword.operator.borrow.vole
//          ^^^^ variable.language.self.vole
    fn bump(&mut self) { self.n += 1; }
//          ^ keyword.operator.borrow.vole
//           ^^^ storage.modifier.mut.vole
//               ^^^^ variable.language.self.vole
    fn finish(self) -> Report { Report { n: self.n } }
//     ^^^^^^ entity.name.function.vole
}

struct Parser<'a> { text: &'a str, at: usize }
//            ^^ storage.modifier.lifetime.vole
//                         ^^ storage.modifier.lifetime.vole
//                            ^^^ storage.type.primitive.vole

impl<'a> Parser<'a> {
//   ^^ storage.modifier.lifetime.vole
//              ^^ storage.modifier.lifetime.vole
    fn rest(&self) -> &'a str { &self.text[self.at..] }
//                     ^^ storage.modifier.lifetime.vole
}

fn longest<'a, 'b: 'a>(x: &'a str, y: &'b str) -> &'a str { if x.len() > y.len() { x } else { y } }
//         ^^ storage.modifier.lifetime.vole
//             ^^ storage.modifier.lifetime.vole
// ^^^^^^^ entity.name.function.vole
static NAME: &'static str = "vole";
//            ^^^^^^^ storage.modifier.lifetime.vole
fn any(x: &'_ i64) -> i64 { *x }
//         ^^ storage.modifier.lifetime.vole

fn total(v: &Vec<i64, Gpa>) -> i64 { v.iter().sum() }
//           ^^^ support.type.std.vole
//               ^^^ storage.type.primitive.vole
fn fill(v: &mut Vec<i64, Gpa>, n: i64) { v.push(n); }
//          ^^^ storage.modifier.mut.vole
fn keep(store: &mut Vec<Buf, Gpa>, b: Buf) { store.push(b); }
//                      ^^^ entity.name.type.vole
fn show<T>(x: &T) where T: Display { println("{x}"); }
//                ^^^^^ keyword.other.where.vole
fn raw(p: *mut u8, q: *const u8) -> bool { p as u64 == q as u64 }
//         ^^^ storage.modifier.mut.vole
//                     ^^^^^ storage.modifier.mut.vole
fn each(f: &dyn Fn(i64) -> i64) -> i64 { f(1) }
//          ^^^ storage.modifier.vole

fn main(gpa: Gpa) {
    let mut c = Counter { n: 0 };
//  ^^^ storage.type.binding.vole
//      ^^^ storage.modifier.mut.vole
    c.bump();
    let r = &mut c;
//          ^ keyword.operator.borrow.vole
//           ^^^ storage.modifier.mut.vole
    r.n += 1;
    let ch = 'a';
//           ^^^ string.quoted.single.char.vole
    let add = move |x: i64| x + c.n;
//            ^^^^ storage.modifier.vole
    'outer: loop {
//   ^^^^^ entity.name.label.vole
//          ^^^^ keyword.control.vole
        for i in 0..3 {
            if i == 1 { continue 'outer; }
//                                ^^^^^ entity.name.label.vole
            if let Some(ref k) = lookup(i) { break 'outer; }
//                      ^^^ storage.modifier.vole
//                                                  ^^^^^ entity.name.label.vole
//                                           ^^^^^ keyword.control.vole
        }
    }
    let var = 1;
//      ^^^ variable.other.vole
    let inout = var + 1;
//      ^^^^^ variable.other.vole
    println("{} {}", total(&v), add(inout));
//                         ^ keyword.operator.borrow.vole
}
