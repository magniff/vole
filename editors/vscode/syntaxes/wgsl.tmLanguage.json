{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "WGSL",
  "scopeName": "source.wgsl",
  "fileTypes": ["wgsl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#calls" },
    { "include": "#braces" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.wgsl",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.wgsl" } }
        },
        { "include": "#block-comment" }
      ]
    },
    "block-comment": {
      "name": "comment.block.wgsl",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.wgsl" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.end.wgsl" } },
      "patterns": [{ "include": "#block-comment" }]
    },
    "attributes": {
      "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.attribute.wgsl" },
        "2": { "name": "entity.other.attribute-name.wgsl" }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.wgsl",
          "match": "\\b0[xX][0-9a-fA-F]+[iuhf]?\\b"
        },
        {
          "name": "constant.numeric.float.wgsl",
          "match": "(?:\\b[0-9]+\\.[0-9]*|\\B\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[fh]?\\b|\\b[0-9]+[eE][+-]?[0-9]+[fh]?\\b|\\b[0-9]+[fh]\\b"
        },
        {
          "name": "constant.numeric.integer.wgsl",
          "match": "\\b[0-9]+[iu]?\\b"
        }
      ]
    },
    "functions": {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.fn.wgsl" },
        "2": { "name": "entity.name.function.wgsl" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wgsl",
          "match": "\\b(if|else|for|while|loop|break|continue|continuing|return|switch|case|default|discard)\\b"
        },
        {
          "name": "storage.type.wgsl",
          "match": "\\b(var|let|const|override|struct|alias|fn)\\b"
        },
        {
          "name": "constant.language.boolean.wgsl",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "storage.modifier.wgsl",
          "match": "\\b(function|private|workgroup|uniform|storage|read|write|read_write)\\b"
        }
      ]
    },
    "types": {
      "name": "entity.name.type.wgsl",
      "match": "\\b(bool|i32|u32|f32|f16|vec[234][iuhf]?|mat[234]x[234][hf]?|array|atomic|ptr|sampler|sampler_comparison|texture_[a-z0-9_]+)\\b"
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.wgsl" } }
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.brackets.curly.wgsl" } },
      "endCaptures": { "0": { "name": "punctuation.brackets.curly.wgsl" } },
      "patterns": [{ "include": "$self" }]
    },
    "operators": {
      "name": "keyword.operator.wgsl",
      "match": "->|&&|\\|\\||<<|>>|[-+*/%&|^!~<>=]=?"
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.wgsl", "match": ";" },
        { "name": "punctuation.separator.comma.wgsl", "match": "," },
        { "name": "punctuation.separator.colon.wgsl", "match": ":" }
      ]
    }
  }
}
