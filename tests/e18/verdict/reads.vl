// VERDICT: both walk reads refused
// The reads (RT-32): with the walk's `*` rule planted out, the IR's
// read of i's address through rr (BK_READ_THROUGH) is what refuses it;
// with the reads left unnoted too, the claim is accepted, and k panics.
// zap writes 0 through the reference it is given.
fn zap(r: &u64) {
    // UNSAFE: the fixture: a write through a shared reference, cast
    // SAFETY: r is a live local's address, written while nothing reads it
    unsafe {
        *(r as *const u64 as *mut u64) = 0;
    }
}

#[no_panic]
fn k(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        zap(*rr);
        x / d
    } else {
        0
    }
}

fn main() {
    println("{}", k(7, 1));
}
