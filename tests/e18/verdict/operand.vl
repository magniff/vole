// VERDICT: ir - operand refused
// The operand rule: the reference given whole to a call, which zeroes d.
// zap writes 0 through the reference it is given.
fn zap(r: &u64) {
    // UNSAFE: the fixture: a write through a shared reference, cast
    // SAFETY: r is a live local's address, written while nothing reads it
    unsafe {
        *(r as *const u64 as *mut u64) = 0;
    }
}

#[no_panic]
fn k(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        zap(&d);
        x / d
    } else {
        0
    }
}

fn main() {
    println("{}", k(7, 1));
}
