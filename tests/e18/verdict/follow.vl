// VERDICT: both walk follow refused
// The copies (the second review's): rr2 is a copy of rr, and zap(*rr2)
// zeroes d. With the walk's `*` rule planted out, the IR's following of
// the copy refuses it; with no copy followed too (VOLE_E18_PLANT=
// walk,follow), the claim is accepted, and k panics.
// zap writes 0 through the reference it is given.
fn zap(r: &u64) {
    // UNSAFE: the fixture: a write through a shared reference, cast
    // SAFETY: r is a live local's address, written while nothing reads it
    unsafe {
        *(r as *const u64 as *mut u64) = 0;
    }
}

#[no_panic]
fn k(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        let rr2 = rr;
        zap(*rr2);
        x / d
    } else {
        0
    }
}

fn main() {
    println("{}", k(7, 1));
}
