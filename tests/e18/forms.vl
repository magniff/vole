// E1.8's settling, one form a function (tests/e18_loans.sh --self-test):
// each loop's counter i, each guarded divisor d, is a proof's local, and
// VOLE_E18_CHECK=all lists how each borrow of it, and each read through
// one that may give an address, was settled: tests/e18/forms.expect.
// Each planted fault (VOLE_E18_PLANT: place, operand, reference, reads,
// walk, use) must change the list. Two proofs are lost, as they must be
// or as the walk's rules leave them: `reference` (its address is taken
// raw) and `alias_hole` (the formatting call's Formatter may keep a
// reference, carries_out). Not a tests/run case: a fixture.

fn peek(r: &i64) -> i64 {
    *r
}

// the place rule: a call's result put in the borrow's reference
static Z: u64 = 1;

fn stat() -> &'static u64 {
    &Z
}

#[no_panic]
fn place(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let mut r = &d;
        let a = *r;
        r = stat();
        x / d + a + *r
    } else {
        0
    }
}

// the operand rule: the reference given whole to a call
#[effects(panic)]
fn operand(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < n {
        let r = &i;
        t = t + peek(r);
        i += 1;
    }
    t
}

// the reference rule: a raw borrow, only read through
#[no_panic]
fn reference(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let p = &raw const d;
        // UNSAFE: the fixture: a read through a raw borrow
        // SAFETY: p is d's address, live here
        let a = unsafe { *p };
        x / d + a
    } else {
        0
    }
}

// the reads (RT-32): `*rr` of an alias's alias is i's address
#[effects(panic)]
fn reads(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < n {
        let r = &i;
        let rr = &r;
        t = t + peek(*rr);
        i += 1;
    }
    t
}

// a format argument: only read through
#[effects(io, static, panic)]
fn hole(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        print("{i}");
        i += 1;
    }
    i
}

// an alias in a format argument: the hole's read is the alias's use
#[effects(io, static, panic)]
fn alias_hole(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let r = &i;
        print("{r}");
        i += 1;
    }
    i
}

// (0.30.1, the second review's) forms whose borrow or read the walk does
// not see, which the IR reports (`internal: ...`), and whose proofs are
// lost for it: a read through an alias's alias stored (`*pq = *rr`, `q =
// *rr`), in a block or an `if`, or cast to a raw pointer (a `match`'s
// the walk follows). Their claims are refused by the IR's side; the walk
// is not complete on them (docs/design/contracts-effects.md, E1.8).
fn copy_of(r: &u64) -> u64 {
    *r
}

#[effects(panic)]
fn stored(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        let mut q: &u64 = &Z;
        let pq = &mut q;
        *pq = *rr;
        x / d + copy_of(q)
    } else {
        0
    }
}

#[effects(panic)]
fn in_block(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        x / d + copy_of(*{ rr })
    } else {
        0
    }
}

#[effects(panic)]
fn in_if(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        x / d + copy_of(*(if x > 0 { rr } else { rr }))
    } else {
        0
    }
}

#[effects(panic)]
fn in_match(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        let q = match x {
            0 => *rr,
            _ => *rr,
        };
        x / d + copy_of(q)
    } else {
        0
    }
}

#[effects(panic, unsafe)]
fn as_raw(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        let q = *rr as *const u64;
        // UNSAFE: the fixture: a read through the cast
        // SAFETY: q is d's address, live here
        x / d + unsafe { *q }
    } else {
        0
    }
}

fn main() {
    println("{} {} {} {} {} {}", place(4, 2), operand(2), reference(4, 2), reads(2), hole(2),
        alias_hole(2));
    println("{} {} {} {} {}", stored(4, 2), in_block(4, 2), in_if(4, 2), in_match(4, 2),
        as_raw(4, 2));
}
