// E1.8's settling, one form a function (tests/e18_loans.sh --self-test):
// each loop's counter i, each guarded divisor d, is a proof's local, and
// VOLE_E18_CHECK=all lists how each borrow of it, and each read through
// one that may give an address, was settled: tests/e18/forms.expect.
// Each planted fault (VOLE_E18_PLANT: place, operand, reference, reads,
// walk, use) must change the list. Two proofs are lost, as they must be
// or as the walk's rules leave them: `reference` (its address is taken
// raw) and `alias_hole` (the formatting call's Formatter may keep a
// reference, carries_out). Not a tests/run case: a fixture.

fn peek(r: &i64) -> i64 {
    *r
}

// the place rule: a call's result put in the borrow's reference
static Z: u64 = 1;

fn stat() -> &'static u64 {
    &Z
}

#[no_panic]
fn place(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let mut r = &d;
        let a = *r;
        r = stat();
        x / d + a + *r
    } else {
        0
    }
}

// the operand rule: the reference given whole to a call
#[effects(panic)]
fn operand(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < n {
        let r = &i;
        t = t + peek(r);
        i += 1;
    }
    t
}

// the reference rule: a raw borrow, only read through
#[no_panic]
fn reference(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let p = &raw const d;
        // UNSAFE: the fixture: a read through a raw borrow
        // SAFETY: p is d's address, live here
        let a = unsafe { *p };
        x / d + a
    } else {
        0
    }
}

// the reads (RT-32): `*rr` of an alias's alias is i's address
#[effects(panic)]
fn reads(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < n {
        let r = &i;
        let rr = &r;
        t = t + peek(*rr);
        i += 1;
    }
    t
}

// a format argument: only read through
#[effects(io, static, panic)]
fn hole(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        print("{i}");
        i += 1;
    }
    i
}

// an alias in a format argument: the hole's read is the alias's use
#[effects(io, static, panic)]
fn alias_hole(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let r = &i;
        print("{r}");
        i += 1;
    }
    i
}

fn main() {
    println("{} {} {} {} {} {}", place(4, 2), operand(2), reference(4, 2), reads(2), hole(2),
        alias_hole(2));
}
