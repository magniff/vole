// EDITION: rust
// flip28 F: the items of `args.iter().copied()` are the `&'a str`s the
// vector holds, not borrows of the vector. rustc accepts it and prints x;
// vole: borrowck.return_local (a reference to 'args' escapes).
fn first<'a, I: Iterator<Item = &'a str>>(mut it: I) -> &'a str {
    it.next().unwrap()
}

fn f<'a>(w: &'a str, gpa: Gpa) -> &'a str {
    let mut args: Vec<&str, Gpa> = Vec::new_in(gpa);
    args.push(w);
    first(args.iter().copied())
}

fn main(gpa: Gpa) {
    println("{}", f("x", gpa));
}
