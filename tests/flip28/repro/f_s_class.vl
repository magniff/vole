// EDITION: rust
// flip28 F (S class, front274): a `&mut C` passed where a `*mut C` is
// wanted holds a borrow through the call. rustc accepts it (the coercion
// is a raw reborrow) and prints 3; vole: borrowck.conflict at `&mut cx.cap`.
struct C {
    f: *mut i64,
    cap: i64,
}

fn grow(cx: *mut C, arr: *mut i64, cap: &mut i64, n: i64) -> *mut i64 {
    *cap = n;
    let _ = cx;
    arr
}

fn go(cx: &mut C) {
    cx.f = grow(cx, cx.f, &mut cx.cap, 3);
}

fn main() {
    let mut c = C { f: 0 as *mut i64, cap: 0 };
    go(&mut c);
    println("{}", c.cap);
}
