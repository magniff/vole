// EDITION: rust
// flip28 F: `&mut *P` of a `static mut P: *mut T` derefs the pointer the
// static holds; it is not a reference to the static. rustc 2024 accepts
// it and prints 2; vole: borrowck.static_mut_ref.
static mut P: *mut i32 = 0 as *mut i32;

fn bump(x: &mut i32) {
    *x += 1;
}

fn main() {
    let mut v = 1;
    // UNSAFE: the test is about a static mut pointer.
    // SAFETY: P points at v, live for the block.
    unsafe {
        P = &raw mut v;
        bump(&mut *P);
    }
    println("{}", v);
}
