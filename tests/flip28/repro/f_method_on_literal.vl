// EDITION: rust
// flip28 F: a method on an unsuffixed literal's shift is E0689 in rustc
// ("can't call method `wrapping_sub` on ambiguous numeric type
// `{integer}`"); vole accepts it, takes i32 and prints 255 (1 << 40 as
// 1 << 8). The translator (T) should write `1i64 << s` here.
fn main() {
    let s: i64 = 40;
    let r: i64 = (1 << s).wrapping_sub(1);
    println("{}", r);
}
