// EDITION: rust
// flip28 F (a silent wrong value): a shift of an unsuffixed literal bound
// by a `let` with no type is typed i32 at the `let`, not by its later use.
// rustc infers i64 for all three and prints
//   1099511627775 1099511627780 1099511627776
// vole prints 255 260 256 (1 << 40 taken as i32's 1 << 8).
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let s: i64 = 40;
    let m = (1 << s) - 1;
    let y: i64 = m;
    let f = (1 << s) | (1 << 2);
    let g: i64 = f;
    let h = 1 << s;
    println("{} {} {}", y, g, id(h));
}
