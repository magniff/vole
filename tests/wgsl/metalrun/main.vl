// metalrun: runs `wgslc metal-job` jobs on Metal, headless (compute only),
// and prints the buffers as `wgslc run` does, so the interpreter's output
// and the GPU's compare as text. Jobs come on stdin, one after another,
// each ended by `end`; each output is ended by `end` too (one process
// serves a whole fuzzing batch).
//
// Built by tests/wgsl/run.sh: `volec -c`, then `cc ... -framework Metal
// -framework Foundation -lobjc` (volec has no -framework before C4).
// Every call into Objective-C is a C boundary: the `unsafe` blocks below
// are those calls and the pointer reads of Metal's buffer contents.

use std::io; use std::alloc::Allocator; import "stdio.h" as c;
import "stdlib.h" as c;
import "string.h" as c;

#[derive(Clone, Copy)] #[repr(C)]
struct MTLSize { w: u64, h: u64, d: u64 }

#[derive(Clone, Copy)] #[repr(C)]
struct MTLRegion { x: u64, y: u64, z: u64, w: u64, h: u64, d: u64 }

extern "C" {
    fn MTLCreateSystemDefaultDevice() -> *mut u8;
    fn sel_registerName(name: *const u8) -> *mut u8;
    fn objc_getClass(name: *const u8) -> *mut u8;
    fn objc_autoreleasePoolPush() -> *mut u8;
    fn objc_autoreleasePoolPop(pool: *mut u8);
    #[link_name = "objc_msgSend"]
    fn msg(o: *mut u8, s: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_u64(o: *mut u8, s: *mut u8) -> u64;
    #[link_name = "objc_msgSend"]
    fn msg_p(o: *mut u8, s: *mut u8, a: *const u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_set_u64(o: *mut u8, s: *mut u8, a: u64);
    #[link_name = "objc_msgSend"]
    fn msg_set_bool(o: *mut u8, s: *mut u8, a: bool);
    #[link_name = "objc_msgSend"]
    fn msg_ppp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8, c: *mut *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_buf(o: *mut u8, s: *mut u8, p: *mut u8, len: u64, opts: u64) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_set_buffer(o: *mut u8, s: *mut u8, buf: *mut u8, off: u64, index: u64);
    #[link_name = "objc_msgSend"]
    fn msg_set_bytes(o: *mut u8, s: *mut u8, p: *mut u8, len: u64, index: u64);
    #[link_name = "objc_msgSend"]
    fn msg_dispatch(o: *mut u8, s: *mut u8, grid: MTLSize, tg: MTLSize);
    #[link_name = "objc_msgSend"]
    fn msg_tex_desc(o: *mut u8, s: *mut u8, format: u64, w: u64, h: u64, mipmapped: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_replace(o: *mut u8, s: *mut u8, region: MTLRegion, level: u64, bytes: *mut u8, bpr: u64);
    #[link_name = "objc_msgSend"]
    fn msg_set_texture(o: *mut u8, s: *mut u8, t: *mut u8, index: u64);
}

fn sel(name: *const u8) -> *mut u8 { unsafe { sel_registerName(name) } }

// An NSString's or NSError's text, for messages.
fn describe(o: *mut u8) -> &'static [u8] {
    if o == 0 as *mut u8 {
        return b"(nil)";
    }
    unsafe {
        let d = msg(o, sel(c"localizedDescription"));
        let s = msg(d, sel(c"UTF8String"));
        std::slice::from_raw_parts(s.add((0) as usize), (c::strlen(s) as i64 - (0)) as usize)
    }
}

struct Buffer<A: Allocator> { group: i64, binding: i64, slot: i64, bytes: i64, words: Vec<u32, A> }

struct Texture<A: Allocator> {
    slot: i64, format: u64, bpp: i64, w: i64, h: i64, words: Vec<u32, A>,
}

fn parse_u32(t: &str) -> u32 {
    let t = t.as_bytes();
    let mut v: u64 = 0;
    for i in 0..t.len() {
        v = v * 10 + (t[i] - b'0') as u64;
    }
    v as u32
}

// Runs one job (its text after the MSL); false on a Metal error.
fn run(dev: *mut u8, queue: *mut u8, msl: &[u8], rest: &[u8], out: &mut Vec<u8, Gpa>, gpa: Gpa) -> bool {
    let mut entry: &[u8] = b"";
    let mut tg: [u64; 3] = [1, 1, 1];
    let mut groups: [u64; 3] = [1, 1, 1];
    let mut bufs: Vec<Buffer<Gpa>, Gpa> = Vec::new_in(gpa);
    let mut sizes: Vec<u32, Gpa> = Vec::new_in(gpa);
    let mut sizes_slot: i64 = -1;
    let mut functions: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    let mut textures: Vec<Texture<Gpa>, Gpa> = Vec::new_in(gpa);
    let text = std::str::from_utf8(rest).unwrap_or("");
    for line in text.lines() {
        let w: Vec<&str, Gpa> = line.split_whitespace().collect_in(gpa);
        if w.len() == 0 {
            continue;
        }
        if w[0] == "entry" {
            entry = w[1].as_bytes();
        } else if w[0] == "tg" || w[0] == "dispatch" {
            for k in 0..3 {
                let v = parse_u32(w[(k + 1) as usize]) as u64;
                if w[0] == "tg" {
                    tg[k as usize] = v;
                } else {
                    groups[k as usize] = v;
                }
            }
        } else if w[0] == "buffer" {
            let mut b = Buffer {
                group: w[1].parse::<i64>().unwrap(), binding: w[2].parse::<i64>().unwrap(),
                slot: w[3].parse::<i64>().unwrap(), bytes: w[4].parse::<i64>().unwrap(),
                words: Vec::new_in(gpa),
            };
            for k in 5..w.len() {
                b.words.push(parse_u32(w[k]));
            }
            // missing words are zero
            while (b.words.len() * 4) as i64 < b.bytes {
                b.words.push(0u32);
            }
            bufs.push(b);
        } else if w[0] == "texture" {
            let fm = w[2];
            let (format, bpp) = if fm == "rgba8unorm" { (70, 4) }
                else if fm == "r8unorm" { (10, 1) } else if fm == "rgba32float" { (125, 16) }
                else { (123, 16) };
            let mut t = Texture {
                slot: w[1].parse::<i64>().unwrap(), format: format as u64, bpp: bpp,
                w: w[3].parse::<i64>().unwrap(), h: w[4].parse::<i64>().unwrap(),
                words: Vec::new_in(gpa),
            };
            for k in 5..w.len() {
                t.words.push(parse_u32(w[k]));
            }
            textures.push(t);
        } else if w[0] == "functions" {
            for k in 1..w.len() {
                functions.push(w[k].as_bytes());
            }
        } else if w[0] == "sizes" {
            sizes_slot = w[1].parse::<i64>().unwrap();
            for k in 3..w.len() {
                sizes.push(parse_u32(w[k]));
            }
        }
    }
    let mut src = Vec::<u8, Gpa>::new_in(gpa);
    src.extend_from_slice(msl);
    src.push(0u8);
    let mut name = Vec::<u8, Gpa>::new_in(gpa);
    name.extend_from_slice(entry);
    name.push(0u8);
    unsafe {
        let nsstring = objc_getClass(c"NSString");
        let s = msg_p(nsstring, sel(c"stringWithUTF8String:"), src.as_ptr());
        let opts = msg(objc_getClass(c"MTLCompileOptions"), sel(c"new"));
        // MTLLanguageVersion3_0, and IEEE math (the interpreter's)
        msg_set_u64(opts, sel(c"setLanguageVersion:"), 196608);
        msg_set_bool(opts, sel(c"setFastMathEnabled:"), false);
        let mut err = 0 as *mut u8;
        let lib = msg_ppp(dev, sel(c"newLibraryWithSource:options:error:"), s, opts, &mut err);
        if lib == 0 as *mut u8 {
            out.extend_from_slice(format_in("error metal.compile: {}\n",
                str::from_utf8(describe(err)).unwrap(), *out.allocator()).as_bytes());
            return false;
        }
        if functions.len() > 0 {
            // compile only: every entry point is there
            for i in 0..functions.len() {
                let mut fnm = Vec::<u8, Gpa>::new_in(gpa);
                fnm.extend_from_slice(functions[i]);
                fnm.push(0u8);
                let ns = msg_p(nsstring, sel(c"stringWithUTF8String:"), fnm.as_ptr());
                let fun = msg_p(lib, sel(c"newFunctionWithName:"), ns);
                if fun == 0 as *mut u8 {
                    out.extend_from_slice(format_in("error metal.entry: no function '{}'\n",
                        std::str::from_utf8(functions[i]).unwrap_or("?"),
                        *out.allocator()).as_bytes());
                    return false;
                }
                msg(fun, sel(c"release"));
            }
            msg(lib, sel(c"release"));
            msg(opts, sel(c"release"));
            return true;
        }
        let fname = msg_p(nsstring, sel(c"stringWithUTF8String:"), name.as_ptr());
        let func = msg_p(lib, sel(c"newFunctionWithName:"), fname);
        if func == 0 as *mut u8 {
            out.extend_from_slice({
                let entry = str::from_utf8(entry).unwrap();
                format_in("error metal.entry: no function '{entry}'\n", *out.allocator())
            }.as_bytes());
            return false;
        }
        let mut err2 = 0 as *mut u8;
        let pso = msg_pp(dev, sel(c"newComputePipelineStateWithFunction:error:"), func, &mut err2);
        if pso == 0 as *mut u8 {
            out.extend_from_slice(format_in("error metal.pipeline: {}\n",
                str::from_utf8(describe(err2)).unwrap(), *out.allocator()).as_bytes());
            return false;
        }
        let cb = msg(queue, sel(c"commandBuffer"));
        let enc = msg(cb, sel(c"computeCommandEncoder"));
        msg_p(enc, sel(c"setComputePipelineState:"), pso);
        let mut mtl: Vec<*mut u8, Gpa> = Vec::new_in(gpa);
        for i in 0..bufs.len() {
            let b = &bufs[i];
            let mb = msg_buf(dev, sel(c"newBufferWithBytes:length:options:"),
                b.words.as_ptr() as *mut u8, b.bytes as u64, 0);
            msg_set_buffer(enc, sel(c"setBuffer:offset:atIndex:"), mb, 0, b.slot as u64);
            mtl.push(mb);
        }
        for i in 0..textures.len() {
            let t = &textures[i];
            let desc = msg_tex_desc(objc_getClass(c"MTLTextureDescriptor"),
                sel(c"texture2DDescriptorWithPixelFormat:width:height:mipmapped:"), t.format,
                t.w as u64, t.h as u64, false);
            let tex = msg_p(dev, sel(c"newTextureWithDescriptor:"), desc);
            if tex == 0 as *mut u8 {
                out.extend_from_slice(b"error metal.texture: cannot make a texture\n");
                return false;
            }
            let region = MTLRegion { x: 0, y: 0, z: 0, w: t.w as u64, h: t.h as u64, d: 1 };
            msg_replace(tex, sel(c"replaceRegion:mipmapLevel:withBytes:bytesPerRow:"), region, 0,
                t.words.as_ptr() as *mut u8, (t.w * t.bpp) as u64);
            msg_set_texture(enc, sel(c"setTexture:atIndex:"), tex, t.slot as u64);
        }
        if sizes_slot >= 0 {
            let n = if sizes.len() > 0 { sizes.len() } else { 1 };
            if sizes.len() == 0 {
                sizes.push(0u32);
            }
            msg_set_bytes(enc, sel(c"setBytes:length:atIndex:"), sizes.as_ptr() as *mut u8,
                (n * 4) as u64, sizes_slot as u64);
        }
        msg_dispatch(enc, sel(c"dispatchThreadgroups:threadsPerThreadgroup:"),
            MTLSize { w: groups[0], h: groups[1], d: groups[2] },
            MTLSize { w: tg[0], h: tg[1], d: tg[2] });
        msg(enc, sel(c"endEncoding"));
        msg(cb, sel(c"commit"));
        msg(cb, sel(c"waitUntilCompleted"));
        let e = msg(cb, sel(c"error"));
        if e != 0 as *mut u8 {
            out.extend_from_slice(
                format_in("error metal.run: {}\n", str::from_utf8(describe(e)).unwrap(),
                    *out.allocator()).as_bytes());
            return false;
        }
        for i in 0..bufs.len() {
            let b = &bufs[i];
            out.extend_from_slice(
                format_in("buffer {} {}\n", b.group, b.binding, *out.allocator()).as_bytes());
            let p = msg(mtl[i], sel(c"contents")) as *mut u32;
            let n = b.bytes / 4;
            for k in 0..n {
                out.extend_from_slice(
                    format_in("{:08x}", (*p.add(k as usize)), *out.allocator()).as_bytes());
                out.push(if k % 8 == 7 || k == n - 1 { b'\n' } else { b' ' });
            }
            msg(mtl[i], sel(c"release"));
        }
        msg(pso, sel(c"release"));
        msg(func, sel(c"release"));
        msg(lib, sel(c"release"));
        msg(opts, sel(c"release"));
    }
    true
}

fn main(gpa: Gpa) -> i32 {
    let input = { let mut v = Vec::new_in(gpa); io::stdin().read_to_end(&mut v).map(|_| v) }.unwrap();
    let text = input.as_slice();
    let dev = unsafe { MTLCreateSystemDefaultDevice() };
    if dev == 0 as *mut u8 {
        eprintln("error metal.device: no Metal device");
        return 2;
    }
    let queue = unsafe { msg(dev, sel(c"newCommandQueue")) };
    let mut out = Vec::<u8, Gpa>::new_in(gpa);
    let mut status: i64 = 0;
    let mut i: i64 = 0;
    while i < text.len() as i64 {
        // "msl N\n", then N bytes of MSL, then lines up to "end"
        if text.len() as i64 - i < 4 || &text[i as usize..(i + 4) as usize] != b"msl " {
            i += 1;
            continue;
        }
        let mut j = i + 4;
        let mut n: i64 = 0;
        while j < text.len() as i64 && text[j as usize] != b'\n' {
            n = n * 10 + (text[j as usize] - b'0') as i64;
            j += 1;
        }
        j += 1;
        let msl = &text[j as usize..(j + n) as usize];
        j += n;
        let mut k = j;
        while k + 4 <= text.len() as i64
            && !(&text[k as usize..(k + 4) as usize] == b"end\n"
                && (k == 0 || text[(k - 1) as usize] == b'\n')) {
            k += 1;
        }
        let rest = &text[j as usize..k as usize];
        let pool = unsafe { objc_autoreleasePoolPush() };
        // dev and queue are Objective-C objects, opaque handles
        if !unsafe { run(dev, queue, msl, rest, &mut out, gpa) } {
            status = 1;
        }
        unsafe { objc_autoreleasePoolPop(pool) };
        out.extend_from_slice(b"end\n");
        print("{}", str::from_utf8(out.as_slice()).unwrap());
        out.clear();
        i = k + 4;
    }
    status as i32
}
