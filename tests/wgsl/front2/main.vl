// (0.27.6) std's std::gpu::wgsl front over WGSL files (tests/wgsl/
// front2.sh): for each file given, `NAME: ok`, or its error as wgslc
// prints it, `NAME:L:C: error CODE: MSG` and `help: HELP`.
use std::{env, fs};
use std::alloc::{Arena, Gpa};
use std::gpu::wgsl::uniformity;
use std::gpu::wgsl::front::new_front;

// The 1-based line and column of byte pos in text.
fn line_col(text: &[u8], pos: i64) -> (i64, i64) {
    let mut line: i64 = 1;
    let mut col: i64 = 1;
    let mut i: i64 = 0;
    while i < pos && (i as usize) < text.len() {
        if text[i as usize] == b'\n' {
            line += 1;
            col = 1;
        } else {
            col += 1;
        }
        i += 1;
    }
    (line, col)
}

fn check(name: &str, text: &[u8], gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    arena.scope(|s| {
        let mut fr = new_front(text, s);
        fr.module();
        if !fr.failed {
            uniformity::check(&fr);
        }
        if fr.failed {
            let (l, c) = line_col(text, fr.err_pos);
            println("{}:{}:{}: error {}: {}", name, l, c, str::from_utf8(fr.err_code).unwrap(),
                str::from_utf8(&fr.emsg).unwrap());
            if fr.ehelp.len() > 0 {
                println("help: {}", str::from_utf8(&fr.ehelp).unwrap());
            }
        } else {
            println("{}: ok", name);
        }
    });
}

fn main(gpa: Gpa) {
    let mut first = true;
    for a in env::args() {
        if first {
            first = false;
            continue;
        }
        let text = fs::read_in(a, gpa).unwrap();
        let name = match a.rfind('/') {
            Some(k) => &a[k + 1..],
            None => a,
        };
        check(name, &text, gpa);
    }
}
