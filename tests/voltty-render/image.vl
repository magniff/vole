// PPM (P6) and PGM (P5) files for the reference images, and a clock.

extern "C" {
    fn fopen(path: *mut u8, mode: *mut u8) -> *mut u8;
    fn fclose(f: *mut u8) -> i32;
    fn fwrite(p: *mut u8, size: u64, n: u64, f: *mut u8) -> u64;
    fn fread(p: *mut u8, size: u64, n: u64, f: *mut u8) -> u64;
    fn clock_gettime_nsec_np(clock: i32) -> u64;
}

// Nanoseconds of a monotonic clock (CLOCK_UPTIME_RAW).
pub fn now_ns() -> i64 {
    // SAFETY: a libc clock read, no pointers.
    unsafe { clock_gettime_nsec_np(8) as i64 }
}

// A NUL-terminated copy of `path` in `buf`.
fn cpath(path: &[u8], buf: &mut Vec<u8, Gpa>) {
    buf.clear();
    buf.extend_from_slice(path);
    buf.push(0u8);
}

// Writes w × h pixels of `chans` bytes (3: from RGBA8 `px`, dropping
// alpha, as P6; 1: grey as P5).
pub fn write(path: &[u8], px: &[u8], w: i64, h: i64, chans: i64, gpa: Gpa) -> bool {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    if chans == 1 {
        b.extend_from_slice(b"P5\n");
    } else {
        b.extend_from_slice(b"P6\n");
    }
    b.extend_from_slice(format_in("{}", w, *b.allocator()).as_bytes());
    b.extend_from_slice(b" ");
    b.extend_from_slice(format_in("{}", h, *b.allocator()).as_bytes());
    b.extend_from_slice(b"\n255\n");
    if chans == 1 {
        for i in 0..w * h {
            b.push(px[i as usize]);
        }
    } else {
        for i in 0..w * h {
            b.push(px[(i * 4) as usize]);
            b.push(px[(i * 4 + 1) as usize]);
            b.push(px[(i * 4 + 2) as usize]);
        }
    }
    let mut p = Vec::<u8, Gpa>::new_in(gpa);
    cpath(path, &mut p);
    let s = b.as_slice();
    // SAFETY: fopen/fwrite/fclose with a NUL-terminated path and a live
    // slice of s.len bytes.
    unsafe {
        let f = fopen(p.as_slice().as_ptr(), c"wb");
        if f == 0 as *mut u8 {
            return false;
        }
        let n = fwrite(s.as_ptr(), 1, s.len() as u64, f);
        fclose(f);
        n == s.len() as u64
    }
}

// Reads a P5 or P6 file into `out` (RGBA8 for P6, grey for P5); the size
// and channel count, or None.
pub fn read(path: &[u8], out: &mut Vec<u8, Gpa>, gpa: Gpa) -> Option<(i64, i64, i64)> {
    let mut p = Vec::<u8, Gpa>::new_in(gpa);
    cpath(path, &mut p);
    let mut data: Vec<u8, Gpa> = Vec::new_in(gpa);
    let mut chunk: [u8; 65536] = [0; 65536];
    // SAFETY: fread into a local array of the size it is told.
    unsafe {
        let f = fopen(p.as_slice().as_ptr(), c"rb");
        if f == 0 as *mut u8 {
            return None;
        }
        loop {
            let n = fread(chunk.as_mut_ptr() as *mut u8, 1, 65536, f) as i64;
            for i in 0..n {
                data.push(chunk[i as usize]);
            }
            if n < 65536 {
                break;
            }
        }
        fclose(f);
    }
    let d = data.as_slice();
    if d.len() < 3 || d[0] != b'P' {
        return None;
    }
    let chans: i64 = if d[1] == b'5' { 1 } else { 3 };
    // Three numbers after the magic, then one whitespace byte.
    let mut nums: [i64; 3] = [0i64, 0, 0];
    let mut i: i64 = 2;
    for k in 0..3 {
        while i < d.len() as i64 && (d[i as usize] == b' ' || d[i as usize] == b'\n') {
            i += 1;
        }
        while i < d.len() as i64 && d[i as usize] >= b'0' && d[i as usize] <= b'9' {
            nums[k as usize] = nums[k as usize] * 10 + (d[i as usize] - b'0') as i64;
            i += 1;
        }
    }
    i += 1;
    let w = nums[0];
    let h = nums[1];
    if d.len() as i64 < i + w * h * chans {
        return None;
    }
    out.clear();
    for j in 0..w * h {
        if chans == 1 {
            out.push(d[(i + j) as usize]);
        } else {
            out.push(d[(i + j * 3) as usize]);
            out.push(d[(i + j * 3 + 1) as usize]);
            out.push(d[(i + j * 3 + 2) as usize]);
            out.push(255u8);
        }
    }
    Some((w, h, chans))
}
