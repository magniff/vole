// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter RangeInclusive::impl Iterator.
// EXPECT: [1, 2, 3] [] [255]

fn main(gpa: Gpa) {
    let a: Vec<i64, Gpa> = (1i64..=3).collect_in(gpa);
    let b: Vec<i64, Gpa> = (3i64..=1).collect_in(gpa);
    let c: Vec<u8, Gpa> = (255u8..=255).collect_in(gpa);
    println("{:?} {:?} {:?}", a, b, c);
}
