// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::io Stderr::impl Write.
// EXPECT: 4 true
use std::io::{BufRead, ErrorKind, Read, Write, self};

fn main() {
    let mut e = io::stderr();
    let n = e.write("err\n".as_bytes()).unwrap();
    println("{} {}", n, e.flush().is_ok());
}
