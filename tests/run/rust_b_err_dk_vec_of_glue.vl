// regions must be live at its drop.
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)
// ERROR: :23:20: error[borrowck.dropped_borrowed]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<HD, Gpa> = Vec::new_in(gpa);
    let x: i64 = 1;
    v.push(HD { r: &x });
    println("{}", v.len());
    0
}
