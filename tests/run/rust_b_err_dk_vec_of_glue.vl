// RULE: D9.1
// (0.27.1) The container table: `Vec<HD<'a>>` drops its elements, so their
// regions must be live at its drop.
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 23, column 20
// ERROR-COUNT: 1
// Checked since 0.27.2 (std2 drops the Vec, D9.1).

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<HD, Gpa> = Vec::new_in(gpa);
    let x: i64 = 1;
    v.push(HD { r: &x });
    println("{}", v.len());
    0
}
