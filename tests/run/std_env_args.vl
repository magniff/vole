// The std item(s): std::env args; std::env Args (Iterator, DoubleEndedIterator, ExactSizeIterator).
// ARGS: hello wörld
// EXPECT: 3 hello wörld
// EXPECT: wörld 2
// EXPECT: true
// RUSTC: none (the twin runs without the case's ARGS)
// (macOS's argv is crt's; Linux's, /proc/self/cmdline, is not run here.)
use std::env;

fn main() {
    let mut a = env::args();
    let n = a.len();
    let _name = a.next();
    println("{} {} {}", n, a.next().unwrap(), a.next().unwrap());
    let mut b = env::args().skip(1);
    let last = env::args().next_back().unwrap();
    b.next();
    println("{} {}", last, env::args().skip(1).count());
    println("{}", !env::args().next().unwrap().is_empty());
}
