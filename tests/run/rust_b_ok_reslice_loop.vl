// EDITION: rust
// RULE: D1.4, Z9.5, D2.3
// Reslicing in a loop: each `v = &v[1..]` kills the previous iteration's
// loan (rustc accepts; 0.27.1 reported borrowck.assign_borrowed).
// EXPECT: 10 4
fn sum(s: &[i64]) -> i64 {
    let mut v: &[i64] = s;
    let mut t = 0;
    while v.len() > 0 {
        t += v[0];
        v = &v[1..];
    }
    t
}

fn main() {
    let a = [1, 2, 3, 4];
    let mut v: &[i64] = &a[..];
    let mut n = 0;
    while v.len() > 0 {
        n += 1;
        v = &v[1..];
    }
    println("{} {}", sum(&a[..]), n);
}
