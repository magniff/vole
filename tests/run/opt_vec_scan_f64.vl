// EXPECT: call_f64: 0/0 13/5598526612305387746 88/15635183651668731826 128/18311613226017797298 200/15500342592071410136 326/14331368728986710500 4784/4212868667624598726
// EXPECT: zip_f64: 0/0 13/2799263306152693873 88/7817591825834365913 128/18379178649863674457 200/7750171296035705068 326/7165684364493355250 4784/2106434333812299363
