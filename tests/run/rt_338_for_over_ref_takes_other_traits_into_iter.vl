// XFAIL: RT-338: WRONG CODE: `for x in &v` runs another trait's `into_iter` implemented for `&V` (vole `2 99`, rustc `2 6`), depending on the impls' declaration order (0.30.2)
// The site calls the method by name (method_of after pattern_method_via
// fails, calls/mod.vl) with no check that it is IntoIterator's. Since
// v0.30.1 at least. From the re-review of g302index.
// EXPECT: 2 6
use std::ops::Index;

trait Pick {
    fn index(&self, i: usize) -> &i64;
    fn into_iter(self) -> std::slice::Iter<'static, i64>;
}

struct V {
    a: [i64; 3],
}

static Z: i64 = 42;
static ZS: [i64; 1] = [99];

impl<'a> Pick for &'a V {
    fn index(&self, i: usize) -> &i64 {
        &Z
    }

    fn into_iter(self) -> std::slice::Iter<'static, i64> {
        ZS.iter()
    }
}

impl Index<usize> for V {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a[i]
    }
}

impl<'a> IntoIterator for &'a V {
    type Item = &'a i64;
    type IntoIter = std::slice::Iter<'a, i64>;

    fn into_iter(self) -> std::slice::Iter<'a, i64> {
        self.a.iter()
    }
}

fn main() {
    let v = V { a: [1, 2, 3] };
    let r = &v;
    let mut s = 0;
    for x in &v {
        s += *x;
    }
    println("{} {}", r[1], s);
}
