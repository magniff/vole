// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): split_at_mut's `requires mid <= self.len()`, violated last.
// EXPECT: 2 1
// EXIT: 101
// STDERR: requires failed: 'mid <= self.len()'

fn main() {
    let mut a = [1, 2, 3];
    let s: &mut [i64] = &mut a;
    let (l, r) = s.split_at_mut(2);
    println("{} {}", l.len(), r.len());
    let (x, y) = s.split_at_mut(5);
}
