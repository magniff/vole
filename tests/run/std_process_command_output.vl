// The std item(s): std::process Command; std::process Command::new_in; std::process Command::arg; std::process Command::args; std::process Command::output; std::process Command::status; std::process Command::env_remove; std::process Output; std::process ExitStatus; std::process ExitStatus::success; std::process ExitStatus::code; std::process ExitStatus::impl Display; std::process ExitStatus::impl Debug.
// EXPECT: "out\n" "err\n" Some(3) false
// EXPECT: exit status: 3 ExitStatus(unix_wait_status(768))
// EXPECT: true exit status: 0
// EXPECT: "a b c\n"
// EXPECT: "none\n\n" ""
// EXPECT: NotFound
use std::process::Command;

fn main(gpa: Gpa) {
    let o = Command::new_in("sh", gpa).arg("-c").arg("echo out; echo err >&2; exit 3").output()
        .unwrap();
    let out = String::from_utf8(o.stdout).unwrap();
    let err = String::from_utf8(o.stderr).unwrap();
    println("{:?} {:?} {:?} {}", out, err, o.status.code(), o.status.success());
    println("{} {:?}", o.status, o.status);
    let st = Command::new_in("true", gpa).status().unwrap();
    println("{} {}", st.success(), st);
    let o = Command::new_in("echo", gpa).args(["a", "b", "c"]).output().unwrap();
    println("{:?}", String::from_utf8(o.stdout).unwrap());
    let o = Command::new_in("sh", gpa).arg("-c").arg("echo ${HOME-none}; read x; echo $x")
        .env_remove("HOME").output().unwrap();
    println("{:?} {:?}", String::from_utf8(o.stdout).unwrap(),
        String::from_utf8(o.stderr).unwrap());
    let e = Command::new_in("no-such-program-here", gpa).status().unwrap_err();
    println("{:?}", e.kind());
}
