// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145) An opaque type whose hidden type is
// another's (relay's is outer's, outer's closure holds inner's), each
// defined after main, held in tuples and Options there: decided through
// the chain (decided_type, glue_of), each D dropped once. The output is
// rustc's.
// EXPECT: t 11
// EXPECT: o true
// EXPECT: w 14
// EXPECT: end
// EXPECT: drop 3
// EXPECT: drop 4
// EXPECT: drop 2
// EXPECT: drop 1
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn val(d: &D) -> i64 {
    d.k
}

fn main() {
    let t = (outer(1), 0i64);
    println("t {}", (t.0)());
    let o = Some(relay(2));
    println("o {}", o.is_some());
    let w = (Some(outer(3)), wrap(relay(4)));
    println("w {}", (w.1.0)());
    println("end");
}

fn wrap<T>(t: T) -> (T, i64) {
    (t, 5)
}

fn relay(k: i64) -> impl Fn() -> i64 {
    outer(k)
}

fn outer(k: i64) -> impl Fn() -> i64 {
    let i = inner(k);
    move || i() + 10
}

fn inner(k: i64) -> impl Fn() -> i64 {
    let d = D { k: k };
    move || val(&d)
}
