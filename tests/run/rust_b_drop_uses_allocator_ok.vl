// RULE: D9.1
// (0.30.1, RT-M2-14) What the allocator's use at a container's drop
// still lets through, as rustc does: the arena read (shared) while the
// Vec lives; reset after the Vec is dropped (by `drop(a)`, or at its
// block's end); an element that borrows a local which dies before the
// Vec (the element's region is not used by the drop, `#[may_dangle] T`).
// EXPECT: 4 0
// EXPECT: 3
// EXPECT: 2
use std::alloc::Arena;

fn main(gpa: Gpa) {
    let mut ar = Arena::new_in(gpa);
    let mut a: Vec<Box<i64, Gpa>, &Arena<Gpa>> = Vec::new_in(&ar);
    for i in 0..4 {
        a.push(Box::new_in(i, gpa));
    }
    let b: Vec<i64, &Arena<Gpa>> = Vec::new_in(&ar);
    println("{} {}", a.len(), b.len());
    drop(a);
    drop(b);
    ar.reset();
    {
        let mut c: Vec<i64, &Arena<Gpa>> = Vec::new_in(&ar);
        c.push(1);
        c.push(2);
        c.push(3);
        println("{}", c.len());
    }
    ar.reset();
    let mut d: Vec<&i64, &Arena<Gpa>> = Vec::new_in(&ar);
    {
        let x = 7;
        d.push(&x);
        d.push(&x);
        println("{}", d.len());
    }
}
