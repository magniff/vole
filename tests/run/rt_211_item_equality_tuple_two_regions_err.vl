// RT-211's second review: the other half of
// rt_211_item_equality_tuple_two_regions_ok: a result of X keeps v (Zip's
// first iterator's) borrowed, a result of Y w's; each drop while its
// result is used is refused (rustc E0505 at both).
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 37
// ERROR: line 40
// ERROR-COUNT: 2
// FLAGS: --check-alloc
fn firsts<I: Iterator<Item = (X, Y)>, X, Y>(mut it: I) -> Option<X> {
    match it.next() {
        Some(p) => Some(p.0),
        None => None,
    }
}

fn seconds<I: Iterator<Item = (X, Y)>, X, Y>(mut it: I) -> Option<Y> {
    match it.next() {
        Some(p) => Some(p.1),
        None => None,
    }
}

fn mk(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(n);
    v
}

fn main(gpa: Gpa) {
    let v = mk(1000, gpa);
    let w = mk(5, gpa);
    let v2 = mk(7, gpa);
    let w2 = mk(8, gpa);
    let r = firsts(v.iter().zip(w.iter()));
    drop(w);
    drop(v);
    let s = seconds(v2.iter().zip(w2.iter()));
    drop(v2);
    drop(w2);
    println("{:?} {:?}", r, s);
}
