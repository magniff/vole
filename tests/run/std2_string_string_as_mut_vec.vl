// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string String::as_mut_vec.
// EXPECT: hix

fn main(gpa: Gpa) {
    let mut s = String::from_in("hi", gpa);
    // UNSAFE: the test of as_mut_vec.
    // SAFETY: an ASCII byte keeps the String UTF-8.
    unsafe {
        s.as_mut_vec().push(120);
    }
    println("{}", s);
}
