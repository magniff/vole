// A temporary `&f(x)` makes (0.18.1) is a local the own pass checks: it
// dies at the end of its block (a block's value that views it escapes),
// it cannot be moved out through the reference, and a view it holds of
// another value is checked as any view. (0.20: `inout r = &mk(gpa)`, the
// block's value a view of it; a `var` takes, so it is the move out.)
// ERROR: the block's value views
// ERROR: cannot move 'r' (Vec<i64, Gpa>) out of a reference
// ERROR: 'v.push(1)' may change 'v' while 's'
fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v
}

fn total(v: &Vec<i64, Gpa>) -> i64 { v.len() as i64 }

fn main(gpa: Gpa) {
    let n = {
        let r = &mut mk(gpa);
        r.as_slice()
    };
    let r = &mut mk(gpa);
    let mut w = r;
    let mut v = mk(gpa);
    let s = v.as_slice();
    v.push(1);
    println("{} {} {}", n.len(), w.len(), s.len());
}
