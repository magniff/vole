struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn eat(r: R) -> i64 { r.id }

fn main() {
    let f: fn(sink & R) -> i64 = eat;
    let r = R { id: 1 };
    println("{}", f(r));
    println("{}", f(R { id: 2 }));
    println("end");
}
