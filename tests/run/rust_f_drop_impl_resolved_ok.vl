// (0.30.1, review 6) A Drop impl's predicates are compared with its
// type's declaration as resolved traits and types, with the declaration's
// `where` and the outlives its fields imply (rustc accepts each): `where
// 'b: 'a, T: 'a` repeated inline, `T: 'a` that `&'a T` implies, a bound
// with an alias for the declaration's type or by another path to the same trait, and an
// alias of a struct with no lifetime is a drop of those values only.
// Before, the bounds were compared as text: each was refused.
// (G's drop has the warning generic.unchecked: the opaque model does not
// cover a bound naming another parameter, and the drop's instance, made
// after the templates are counted, is not seen; it is checked whole.)
// WARNING: generic.unchecked
// EXPECT: d04
// EXPECT: d14 x
// EXPECT: d05
// EXPECT: d10
// EXPECT: dg
// EXPECT: ps 3
mod m {
    pub trait Tr {}
}

use m::Tr;
impl Tr for i64 {}

struct Wa<'a, 'b, T> where 'b: 'a, T: 'a { r: &'a &'b T }

impl<'a, 'b: 'a, T: 'a> Drop for Wa<'a, 'b, T> {
    fn drop(&mut self) { println("d04"); }
}

struct Wb<'a, 'b> where 'b: 'a { r: &'a &'b str }

impl<'a, 'b: 'a> Drop for Wb<'a, 'b> {
    fn drop(&mut self) { println("d14 {}", *self.r); }
}

struct Wi<'a, T> { r: &'a T }

impl<'a, T: 'a> Drop for Wi<'a, T> {
    fn drop(&mut self) { println("d05"); }
}

type I64 = i64;
struct Wt<T: Iterator<Item = i64>> { t: T }

impl<T: Iterator<Item = I64>> Drop for Wt<T> {
    fn drop(&mut self) { println("d07"); }
}

struct Wm<T: m::Tr> { t: T }

impl<T: Tr> Drop for Wm<T> {
    fn drop(&mut self) { println("d10"); }
}

// (a bound naming another parameter, the impl's written in another order
// of names: the same parameter of the declaration's)
trait Tg<X> {}
impl Tg<i64> for u8 {}

struct G<T: Tg<U>, U> {
    t: T,
    u: U,
}

impl<A: Tg<B>, B> Drop for G<A, B> {
    fn drop(&mut self) { println("dg"); }
}

struct P<T> { t: T }
type PS = P<String<Gpa>>;

impl Drop for PS {
    fn drop(&mut self) { println("ps {}", self.t.len()); }
}

fn main(gpa: Gpa) {
    let s: &i64 = &1;
    {
        let w = Wa { r: &s };
    }
    let x: &str = "x";
    {
        let w = Wb { r: &x };
    }
    let y = 2i64;
    {
        let w = Wi { r: &y };
    }
    {
        let w = Wm { t: 3i64 };
    }
    {
        let g = G { t: 1u8, u: 2i64 };
    }
    {
        let p = P { t: String::from_in("abc", gpa) };
        let q = P { t: 5i64 };
    }
}
