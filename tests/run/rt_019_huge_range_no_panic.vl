// RT-19 (fixed in 0.30.1): a range bound of 2^63 or more makes `a[i]` in bounds for the effects, so #[no_panic] accepts an index that panics
// With `0..4` the same function is refused (error[effect] ... 'a[i]' is a
// checked index). With `0..18446744073709551615` (-1 as an i64) and
// `0..9223372036854775808` (i64::MIN) front::effects::infer::in_bounds
// takes the negative bound as at most the array's length: both
// #[no_panic] declarations hold, and huge2(&a, 5) panics.
// ERROR: error[effect]
// ERROR: line 13,
// ERROR: error[effect]
// ERROR: line 25,
// ERROR-COUNT: 2
#[no_panic]
fn huge(a: &[i64; 3], stop: usize) -> i64 {
    let mut sum = 0i64;
    for i in 0..18446744073709551615usize {
        if i == stop {
            break;
        }
        sum += a[i];
    }
    sum
}

#[no_panic]
fn huge2(a: &[i64; 3], stop: usize) -> i64 {
    let mut sum = 0i64;
    for i in 0..9223372036854775808usize {
        if i == stop {
            break;
        }
        sum += a[i];
    }
    sum
}

fn main() {
    let a: [i64; 3] = [10, 20, 30];
    println("{}", huge(&a, 3));
    println("{}", huge2(&a, 5));
}
