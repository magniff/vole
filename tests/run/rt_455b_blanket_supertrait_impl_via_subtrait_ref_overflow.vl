// XFAIL: RT-455b: (RT-455's mechanism, a type holding a reference) `impl<'a> Sub for W<'a>` with `trait Sub: Super` and `impl<T: Sub> Super for T`: `need(W { r: &x })` is refused with trait.overflow ("'W: Sub' is not proved"); rustc prints 42 (0.30.2)
// From the re-review of g302bor2 (its form m08_blanket_super_via_sub_ref).
// Since v0.30.1 at least: v0.30.1 crashes on it (bus error, exit 138),
// the release build refuses it.
// EXPECT: 42
trait Super {
    fn up(&self) -> i64;
}

trait Sub: Super {
    fn down(&self) -> i64;
}

impl<T: Sub> Super for T {
    fn up(&self) -> i64 {
        self.down() + 1
    }
}

struct W<'a> {
    r: &'a i64,
}

impl<'a> Sub for W<'a> {
    fn down(&self) -> i64 {
        *self.r
    }
}

fn need<T: Sub>(t: T) -> i64 {
    t.up()
}

fn main() {
    let x = 41i64;
    println("{}", need(W { r: &x }));
}
