// a u8 that wrapped below the length while the i64 sum is not.
// EXIT: 101
// STDERR: index out of bounds: index 260, length 8
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], x: u8) -> i64 {
    let y = x + 10; if y < 8 { s[(x as i64 + 10) as usize] } else { 0 }
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s, (250 + unsafe { Z }) as u8));
    0
}
