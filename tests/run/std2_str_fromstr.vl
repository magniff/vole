// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str FromStr.
// EXPECT: 42 -7 true
use std::str::FromStr;

fn main() {
    let a = i64::from_str("42").unwrap();
    let b = <i32 as FromStr>::from_str("-7").unwrap();
    let c = bool::from_str("true").unwrap();
    println("{} {} {}", a, b, c);
}
