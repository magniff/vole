// Runs on std since 0.27.2's switch.
// The std item(s): std::ptr copy_nonoverlapping.
// EXPECT: [7, 8, 3]
use std::ptr;

fn main() {
    let src = [7i64, 8];
    let mut dst = [1i64, 2, 3];
    unsafe { ptr::copy_nonoverlapping(&src[0] as *const i64, &mut dst[0] as *mut i64, 2) };
    println("{:?}", dst);
}
