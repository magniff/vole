// EDITION: rust
// The std2 item(s): std::fs File; std::fs File::create; std::fs File::open; std::fs File::create_new; std::fs File::options; std::fs File::metadata; std::fs File::set_len; std::fs File::sync_all; std::fs File::impl Read; std::fs File::impl Write; std::fs File::impl Seek; std::fs File::impl Drop; std::fs OpenOptions; std::fs OpenOptions::new; std::fs OpenOptions::read; std::fs OpenOptions::write; std::fs OpenOptions::append; std::fs OpenOptions::open; std::io SeekFrom; std::io Seek.
// EXPECT: 10
// EXPECT: 0123
// EXPECT: 1 [49, 50] 3 3
// EXPECT: AlreadyExists
// EXPECT: A123xy
// EXPECT: InvalidInput InvalidInput
// EXPECT: NotFound true
use std::fs::{File, OpenOptions};
use std::io::{Read, Seek, SeekFrom, Write};

fn main(gpa: Gpa) {
    let mut f = File::create("f.txt").unwrap();
    f.write_all(b"0123456789").unwrap();
    f.sync_all().unwrap();
    println("{}", f.metadata().unwrap().len());
    f.set_len(4).unwrap();
    drop(f);
    let mut f = File::open("f.txt").unwrap();
    let mut s = String::new_in(gpa);
    f.read_to_string(&mut s).unwrap();
    println("{}", s);
    let at = f.seek(SeekFrom::Start(1)).unwrap();
    let mut b = [0u8; 2];
    f.read_exact(&mut b).unwrap();
    let pos = f.stream_position().unwrap();
    println("{} {:?} {} {}", at, b, pos, f.seek(SeekFrom::End(-1)).unwrap());
    f.rewind().unwrap();
    println("{:?}", File::create_new("f.txt").unwrap_err().kind());
    let mut g = OpenOptions::new().append(true).open("f.txt").unwrap();
    g.write_all(b"xy").unwrap();
    let mut h = File::options().read(true).write(true).open("f.txt").unwrap();
    h.write_all(b"A").unwrap();
    drop(g);
    drop(h);
    let mut s = String::new_in(gpa);
    File::open("f.txt").unwrap().read_to_string(&mut s).unwrap();
    println("{}", s);
    let none = OpenOptions::new().open("f.txt").unwrap_err();
    let create_ro = OpenOptions::new().read(true).create(true).open("g.txt").unwrap_err();
    println("{:?} {:?}", none.kind(), create_ro.kind());
    let e = File::open("none.txt").unwrap_err();
    println("{:?} {}", e.kind(), e.raw_os_error() == Some(2));
    std::fs::remove_file("f.txt").unwrap();
}
