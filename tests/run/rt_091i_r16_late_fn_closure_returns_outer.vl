// (0.30.2, the re-review of g302holes: r91/r16_late_fn_closure_returns_outer)
// EXPECT: 3 12
// A closure in an earlier fn is held by the result of a closure in a later fn (id order reversed).
fn base(k: i64) -> impl Fn(i64) -> i64 {
    move |x| x + k
}

fn main() {
    let v = [1i64, 2, 3];
    let mk = |m: i64| (base(m), v.iter().map(move |x| x * m));
    let (f, it) = mk(2);
    println("{} {}", f(1), it.sum::<i64>());
}
