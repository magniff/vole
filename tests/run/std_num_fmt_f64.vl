// std::num::fmt_f64 (0.25.4) against `{v:.N}` (format_in), byte for
// byte, for N from 0 to FIXED_DECIMALS_MAX (20), over generated values:
// random bits (every exponent, so most fall back to `{v:e}`), random
// values of a UI's range, exact ties (k/2^j: a tie rounds to the even
// digit), short decimals (k/10^j: 1.005, 2.675, below and above their
// tie), integers near 2^53 and 2^64, the subnormals and the specials.
// Where `{v:.N}` is longer than 32 bytes, fmt_f64 writes `{v:e}`.
// EXPECT: fmt_f64: 7111 values x 21 decimals = 149331 cases, 0 differ
// EXPECT: ties to even: 0.5 -> 0, 1.5 -> 2, 2.5 -> 2, -0.125 -> -0.12, 0.375 -> 0.38
// EXPECT: -0.00 NaN inf -inf 1.5e40 0.00000000000000000000 12.35
use std::num::{FIXED_DECIMALS_MAX, f64_from_bits, f64_to_bits, fmt_f64};

struct Rng { s: u64 }

fn next(r: inout Rng) -> u64 {
    var x = r.s;
    x ^= x << 13;
    x ^= x >> 7;
    x ^= x << 17;
    r.s = x;
    x
}

// A uniform f64 in [0, 1).
fn unit(r: inout Rng) -> f64 {
    (next(&r) >> 11) as f64 / 9007199254740992.0
}

// `{v:.n}`, as format_in writes it.
fn expected(v: f64, n: i64, gpa: Gpa) -> Buf {
    match n {
        0 => format_in("{v:.0}", gpa),
        1 => format_in("{v:.1}", gpa),
        2 => format_in("{v:.2}", gpa),
        3 => format_in("{v:.3}", gpa),
        4 => format_in("{v:.4}", gpa),
        5 => format_in("{v:.5}", gpa),
        6 => format_in("{v:.6}", gpa),
        7 => format_in("{v:.7}", gpa),
        8 => format_in("{v:.8}", gpa),
        9 => format_in("{v:.9}", gpa),
        10 => format_in("{v:.10}", gpa),
        11 => format_in("{v:.11}", gpa),
        12 => format_in("{v:.12}", gpa),
        13 => format_in("{v:.13}", gpa),
        14 => format_in("{v:.14}", gpa),
        15 => format_in("{v:.15}", gpa),
        16 => format_in("{v:.16}", gpa),
        17 => format_in("{v:.17}", gpa),
        18 => format_in("{v:.18}", gpa),
        19 => format_in("{v:.19}", gpa),
        _ => format_in("{v:.20}", gpa),
    }
}

// v at every precision: how many texts differ (each printed, the first 10).
fn check(v: f64, bad: inout i64, gpa: Gpa) {
    var out: [u8; 32] = [0; 32];
    for n in 0..FIXED_DECIMALS_MAX + 1 {
        var want = expected(v, n, gpa);
        if want.len() > 32 {
            want = format_in("{v:e}", gpa);
        }
        let at = fmt_f64(v, n, &out);
        if out[at..32] != want.as_slice() {
            if bad < 10 {
                println("FAIL {v:e} .{n}: {} want {}", out[at..32], want.as_slice());
            }
            bad += 1;
        }
    }
}

fn text(v: f64, n: i64) -> [u8; 32] {
    var out: [u8; 32] = [' '; 32];
    let _ = fmt_f64(v, n, &out);
    out
}

fn main(gpa: Gpa) -> i32 {
    var r = Rng { s: 0x9e3779b97f4a7c15 };
    var bad = 0;
    var count = 0;
    // random bits: every exponent, the NaNs and infinities too
    for _ in 0..1500 {
        check(f64_from_bits(next(&r)), &bad, gpa);
        count += 1;
    }
    // a UI's range: 1e-6 to 1e9, either sign
    for _ in 0..1500 {
        let mag = unit(&r) * 15.0 - 6.0;
        let s = if (next(&r) & 1) != 0 { -1.0 } else { 1.0 };
        check(s * 10.0.powf(mag), &bad, gpa);
        count += 1;
    }
    // exact ties: k / 2^j, j up to 10
    for _ in 0..1000 {
        let k = (next(&r) % 200001) as f64 - 100000.0;
        let j = (next(&r) % 11) as i32;
        check(k / 2.0.powi(j), &bad, gpa);
        count += 1;
    }
    // short decimals: k / 10^j and their neighbours
    for _ in 0..1000 {
        let k = (next(&r) % 1000001) as f64;
        let j = (next(&r) % 7) as i32;
        let x = k / 10.0.powi(j);
        check(x, &bad, gpa);
        check(f64_from_bits(f64_to_bits(x) + 1), &bad, gpa);
        if x > 0.0 {
            check(f64_from_bits(f64_to_bits(x) - 1), &bad, gpa);
        } else {
            check(-x, &bad, gpa);
        }
        count += 3;
    }
    // integers near 2^53 and 2^64, and 1e15 + 1/2
    for i in 0..30 {
        let d = i as f64 - 15.0;
        check(9007199254740992.0 + d, &bad, gpa);
        check(18446744073709551616.0 + d * 4096.0, &bad, gpa);
        check(-(1e15 + 0.5 + d), &bad, gpa);
        count += 3;
    }
    // the subnormals, the extremes and the specials
    let fixed = [
        0.0, -0.0, 5e-324, -5e-324, 2.2250738585072014e-308, 1.7976931348623157e308,
        0.5, 1.5, 2.5, 0.125, 0.375, 1e-20, 5e-21, 4.9e-21, 1e10, 9999999999.5, 1e30, 1e31,
        0.0 / 0.0, 1.0 / 0.0, -1.0 / 0.0,
    ];
    for k in 0..fixed.len {
        check(fixed[k], &bad, gpa);
        count += 1;
    }
    println(
        "fmt_f64: {count} values x {} decimals = {} cases, {bad} differ", FIXED_DECIMALS_MAX + 1,
        count * (FIXED_DECIMALS_MAX + 1));
    let t0 = text(0.5, 0);
    let t1 = text(1.5, 0);
    let t2 = text(2.5, 0);
    let t3 = text(-0.125, 2);
    let t4 = text(0.375, 2);
    println(
        "ties to even: 0.5 -> {}, 1.5 -> {}, 2.5 -> {}, -0.125 -> {}, 0.375 -> {}", trim(t0[..]),
        trim(t1[..]), trim(t2[..]), trim(t3[..]), trim(t4[..]));
    let a = text(-0.0, 2);
    let b = text(0.0 / 0.0, 3);
    let c = text(1.0 / 0.0, 3);
    let d = text(-1.0 / 0.0, 3);
    let e = text(1.5e40, 2);
    let f = text(1e-30, 99);
    let g = text(12.345, 2);
    println(
        "{} {} {} {} {} {} {}", trim(a[..]), trim(b[..]), trim(c[..]), trim(d[..]), trim(e[..]),
        trim(f[..]), trim(g[..]));
    if bad != 0 { 1 } else { 0 }
}
