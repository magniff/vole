// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: back 10
// STDERR: unsafe address out of bounds: an offset of 18446744073709551615 elements of 1 bytes overflows
// 0.30.1: add and sub are told apart at every element size, 1 included:
// add(usize::MAX) is a count Rust's add refuses (it does not fit an
// isize), though the address it wraps to, one byte back, is in the block
// and sub(1) to the same address is fine.
fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::with_capacity_in(4, gpa);
    for i in 0..4u8 {
        v.push(i + 10);
    }
    let p = &v[1] as *const u8;
    // UNSAFE: one element back, in the block.
    // SAFETY: index 0 is pushed.
    println("back {}", unsafe { *p.sub(1) });
    // UNSAFE: deliberately out of the rules of add.
    // SAFETY: none: the
    // program exists to be stopped.
    let q = unsafe { p.add(usize::MAX) };
    // UNSAFE: the read the address check stops first.
    // SAFETY: none.
    println("read {}", unsafe { *q });
}
