// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map Entry::or_insert_with.
// EXPECT: 7 1
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let mut calls = 0;
    m.entry(1).or_insert_with(|| { calls += 1; 7 });
    m.entry(1).or_insert_with(|| { calls += 1; 8 });
    println("{} {}", m[&1], calls);
}
