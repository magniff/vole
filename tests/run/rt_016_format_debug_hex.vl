// XFAIL: RT-16: `{:x?}` and `{:X?}` print the numbers in decimal (open)
// guide formatting: the type `?` is Debug, "`x?`, `X?` with hex numbers".
// vole accepts the spec and prints decimal: [255] [171] [[10, 255]]
// [(171, 205)] [Some(31)] [-1]. The EXPECT lines are rustc's.
// EXPECT: [ff] [AB] [0xff] [ff]
// EXPECT: [[a, ff]] [(AB, CD)]
// EXPECT: [Some(1f)] [0xFF]
fn main() {
    let n = 255;
    println("[{:x?}] [{:X?}] [{:#x?}] [{n:x?}]", 255, 171, 255);
    println("[{:x?}] [{:X?}]", [10, 255], (171, 205));
    println("[{:x?}] [{:#X?}]", Some(31), -1i8);
}
