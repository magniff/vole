// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::and.
// EXPECT: Some("b") None None
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b: Option<i64> = None;
    let c: Option<&str> = None;
    println("{:?} {:?} {:?}", a.and(Some("b")), b.and(Some("b")), a.and(c));
}
