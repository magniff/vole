// XFAIL: RT-365: a generic body that calls its bound's method, `fn ks<T: K2>(x: T) -> T { x.me() }`, is refused with borrowck.param_outlives "'T::me' requires 'T: 'static'" when K2's only impl is a blanket `impl<T: 'static> K2 for T` (or `where T: Copy + 'static`): the bound T: K2 is the body's evidence, not the impl (0.30.2)
// rustc builds it and prints `5 3` (twin .rs.txt); a call with a borrowed
// T (`ks(&v[0])` then `drop(v)`) is refused at the call (E0597), which a
// fix must keep (scratch fa/a05.vl). vole: two borrowck.param_outlives
// errors, at lines 33 and 37. v0.28.0 to v0.30.0 build `ks` and refuse
// `ks3` (borrowck.outlives "the lifetime of 'x' must outlive 'static");
// v0.30.1 and the release build refuse both.
// EXPECT: 5 3
trait K2 {
    fn me(self) -> Self;
}

impl<T: 'static> K2 for T {
    fn me(self) -> Self {
        self
    }
}

trait K3 {
    fn me3(&self) -> i64;
}

impl<T> K3 for T
    where
        T: Copy + 'static,
{
    fn me3(&self) -> i64 {
        3
    }
}

fn ks<T: K2>(x: T) -> T {
    x.me()
}

fn ks3<T: K3>(x: &T) -> i64 {
    x.me3()
}

fn main() {
    let a = ks(5i64);
    let b = ks3(&7i64);
    println("{} {}", a, b);
}
