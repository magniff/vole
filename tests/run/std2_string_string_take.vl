// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::take.
// EXPECT: "" abc
// RUSTC: none (vole's addition: String::take (Rust's mem::take))
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    let t = s.take();
    println("{:?} {}", s, t);
}
