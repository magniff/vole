// 0.30: an assignment through a MutexGuard or an RwLockWriteGuard drops
// the value that was there (0.29 leaked it: `*g = v` is `*g.deref_mut() =
// v`, a place under a call's result): after the right side, before the
// write, once. `*g`, a field, an index, a guard that is the statement's
// temporary, get_mut, and a Vec replaced by a longer one (the block that
// --check-alloc reported as not freed).
// FLAGS: --check-alloc
// EXPECT: mutex
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: d1
// EXPECT: --
// EXPECT: mk3
// EXPECT: d2
// EXPECT: --
// EXPECT: d3
// EXPECT: rwlock
// EXPECT: mk4
// EXPECT: mk5
// EXPECT: d4
// EXPECT: --
// EXPECT: mk6
// EXPECT: d5
// EXPECT: 6
// EXPECT: d6
// EXPECT: field
// EXPECT: mk7
// EXPECT: mk8
// EXPECT: d7
// EXPECT: --
// EXPECT: mk9
// EXPECT: d8
// EXPECT: --
// EXPECT: d9
// EXPECT: index
// EXPECT: mk10
// EXPECT: mk11
// EXPECT: d10
// EXPECT: --
// EXPECT: d11
// EXPECT: get_mut
// EXPECT: mk12
// EXPECT: mk13
// EXPECT: d12
// EXPECT: --
// EXPECT: d13
// EXPECT: heap
// EXPECT: 200 300
// EXPECT: end
use std::sync::{Mutex, RwLock};

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

fn sevens(n: usize, gpa: Gpa) -> Vec<u32, Gpa> {
    let mut v = Vec::new_in(gpa);
    for _ in 0..n { v.push(7u32); }
    v
}

struct H { f: T, n: i64 }

fn main(gpa: Gpa) -> i32 {
    println("mutex");
    {
        let l = Mutex::new(mk(1));
        {
            let mut g = l.lock().unwrap();
            *g = mk(2);
            println("--");
        }
        *l.lock().unwrap() = mk(3);
        println("--");
    }
    println("rwlock");
    {
        let l = RwLock::new(mk(4));
        {
            let mut g = l.write().unwrap();
            *g = mk(5);
            println("--");
        }
        *l.write().unwrap() = mk(6);
        println("{}", l.read().unwrap().id);
    }
    println("field");
    {
        let l = Mutex::new(H { f: mk(7), n: 0 });
        let mut g = l.lock().unwrap();
        (*g).f = mk(8);
        println("--");
        g.f = mk(9);
        g.n = 1;
        println("--");
    }
    println("index");
    {
        let mut v: Vec<T, Gpa> = Vec::new_in(gpa);
        v.push(mk(10));
        let l = RwLock::new(v);
        let mut g = l.write().unwrap();
        g[0] = mk(11);
        println("--");
    }
    println("get_mut");
    {
        let mut l = Mutex::new(mk(12));
        *l.get_mut().unwrap() = mk(13);
        println("--");
    }
    println("heap");
    {
        let l = Mutex::new(sevens(100, gpa));
        {
            let mut w = l.lock().unwrap();
            *w = sevens(200, gpa);
        }
        let r = RwLock::new(sevens(100, gpa));
        {
            let mut w = r.write().unwrap();
            *w = sevens(300, gpa);
        }
        println("{} {}", l.lock().unwrap().len(), r.read().unwrap().len());
    }
    println("end");
    0
}
