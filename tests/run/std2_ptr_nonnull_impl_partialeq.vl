use std::ptr::NonNull;

fn main() {
    let mut x = 1i64;
    let mut y = 1i64;
    let p = NonNull::new(&mut x as *mut i64).unwrap();
    let q = NonNull::new(&mut x as *mut i64).unwrap();
    let r = NonNull::new(&mut y as *mut i64).unwrap();
    println("{} {}", p == q, p == r);
}
