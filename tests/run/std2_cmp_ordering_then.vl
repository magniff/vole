// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::cmp Ordering::then.
// EXPECT: Less Greater Less
use std::cmp::Ordering;

fn main() {
    println("{:?} {:?} {:?}", Ordering::Equal.then(Ordering::Less),
        Ordering::Greater.then(Ordering::Less), Ordering::Less.then(Ordering::Greater));
}
