// The std item(s): std::num Wrapping.
// The operators, their assignments, the formats, Sum and Product: as
// Rust prints them (tools/std-twin.sh).
// EXPECT: 4 250 196 -128
// EXPECT: 127 -128 127 1
// EXPECT: 0 254 16 3
// EXPECT: 7 fe 11111110 376
// EXPECT: true true false 5
// EXPECT: 6 250 2 14
// EXPECT: 3 5 -7 0
// EXPECT: 10 24 4294967295 9223372036854775807
use std::num::Wrapping;

fn main() {
    let a = Wrapping(250u8);
    let b = Wrapping(10u8);
    let m = Wrapping(-128i8);
    println("{} {} {} {}", a + b, a - Wrapping(0u8), a * b, m / Wrapping(-1i8));
    println("{} {} {} {}", m - Wrapping(1i8), -m, -(m + Wrapping(1i8)),
        m % Wrapping(-1i8) + Wrapping(1i8));
    println("{} {} {} {}", a & Wrapping(5u8), a | Wrapping(4u8), b ^ Wrapping(26u8),
        !Wrapping(252u8));
    println("{:?} {:x} {:b} {:o}", Wrapping(7), Wrapping(254u8), Wrapping(254u8), Wrapping(254u8));
    println("{} {} {} {}", a > b, a == Wrapping(250u8), m > Wrapping(0i8), a.0 / 50);
    let mut c = Wrapping(250u8);
    c += Wrapping(12u8);
    let mut d = c;
    d -= 12u8;
    let mut e = Wrapping(64u8);
    e <<= 3usize;
    e |= Wrapping(2u8);
    let mut g = Wrapping(7u8);
    g *= Wrapping(2u8);
    println("{} {} {} {}", c, d, e, g);
    println("{} {} {} {}", Wrapping(7u8) >> 1usize, Wrapping(5u16) << 16usize,
        Wrapping(-100i8) >> 4usize, Wrapping(1u32) << 31usize << 1usize);
    let v = [Wrapping(1u32), Wrapping(2u32), Wrapping(3u32), Wrapping(4u32)];
    let s: Wrapping<u32> = v.iter().copied().sum();
    let p: Wrapping<u32> = v.iter().copied().product();
    println("{} {} {} {}", s, p, Wrapping(0u32) - Wrapping(1u32),
        Wrapping(i64::MIN) - Wrapping(1i64));
}
