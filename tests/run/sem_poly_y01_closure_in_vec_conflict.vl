// a closure borrowing n kept in a Vec<F>; n changed while the Vec is used after: own.conflict
// ERROR: [own.conflict]: 'n = 5' writes 'n' while 'vs'
fn one<T>(x: sink T, gpa: Gpa) -> Vec<T, Gpa> {
    var r: Vec<T, Gpa> = Vec::new_in(gpa); r.push(x); r
}

fn main(gpa: Gpa) {
    var n = 1;
    let vs = one(|| n, gpa);
    n = 5;
    println("{}", (vs[0])());
}
