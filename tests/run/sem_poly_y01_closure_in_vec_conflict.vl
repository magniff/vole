// a closure borrowing n kept in a Vec<F>; n changed while the Vec is used after: own.conflict
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 11, column 5
fn one<T>(x: T, gpa: Gpa) -> Vec<T, Gpa> {
    let mut r: Vec<T, Gpa> = Vec::new_in(gpa); r.push(x); r
}

fn main(gpa: Gpa) {
    let mut n: i64 = 1;
    let vs = one(|| n, gpa);
    n = 5;
    println("{}", (vs[0])());
}
