// EDITION: rust
// sem-own: std::take on an Option leaves None; the taken one dropped once.
// EXPECT: took 4
// EXPECT: drop 4
// EXPECT: none true
// EXPECT: end
use std::mem; use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let mut o: Option<D<Gpa>> = Some(mk(4, gpa));
    {
        let t = mem::replace(&mut o, (None));
        if let Some(d) = t { println("took {}", d.id); }
    }
    println("none {}", o.is_none());
    println("end");
}
