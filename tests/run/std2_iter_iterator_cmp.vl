// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::cmp.
// EXPECT: Less Equal Greater

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([1i64, 3], gpa);
    let c = Vec::from_in([1i64], gpa);
    println("{:?} {:?} {:?}", a.iter().cmp(b.iter()), a.iter().cmp(a.iter()),
        a.iter().cmp(c.iter()));
}
