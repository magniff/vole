// RULE: D19.2
// (0.30) A closure that calls a captured FnMut closure takes `&mut c`:
// c must be declared `mut`, rustc E0596. A capture of a `&mut` reference
// the closure writes through stays rustc's unique borrow, which needs no
// `let mut` (rust_b_ok_capture_unique_ref).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'c' as mutable, as it is not declared as mutable
// ERROR: line 14, column 17
// ERROR-COUNT: 1
fn main() {
    let mut n: i64 = 0;
    let c = || {
        n += 1;
    };
    let mut d = || {
        c();
    };
    d();
    println("{n}");
}
