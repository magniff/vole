// XFAIL: RT-500: a level difference, not unsound: -O2 inlines eight `#[inline]` callees, each with a local of 2^60 bytes in a branch not taken, into one `#[inline(never)]` fn and then refuses the merged frame (frame.too_big, "reaches 2^63 - 2^32 bytes ... with the slots of its inlined callees"), while -O0 builds it; the inliner should decline the callee that pushes the frame past the limit; rustc -O builds it; fixed, -O2 does what -O0 does (0.30.2)
// From the g302frame review. Since v0.30.1 at least: v0.30.1 builds it
// at both levels with no probes, the frame of 2^63 bytes wrapping
// (RT-466's mechanism), prints 28 and exits 0; cd82de14a (before
// g302frame) built it at -O2 the same; g302frame (9ef910cad) refuses
// it at -O2. What -O0 does is what -O2 should do: `all` keeps its own
// small frame, the first callee's frame of 2^60 bytes is probed as it
// is entered and faults on the guard page (stack_probe_frame_past_limit's
// design), after "before". rustc -O builds it and prints 28 (LLVM drops
// the arrays); rustc without -O was killed while building (SIGKILL,
// the machine under load).
// FLAGS: -O2
// EXPECT: before
// EXIT: 139
#[inline]
fn c0(n: usize) -> u8 {
    if n > 100 {
        let a = [0; 1usize << 60];
        a[n]
    } else {
        0
    }
}

#[inline]
fn c1(n: usize) -> u8 {
    if n > 100 {
        let a = [1; 1usize << 60];
        a[n]
    } else {
        1
    }
}

#[inline]
fn c2(n: usize) -> u8 {
    if n > 100 {
        let a = [2; 1usize << 60];
        a[n]
    } else {
        2
    }
}

#[inline]
fn c3(n: usize) -> u8 {
    if n > 100 {
        let a = [3; 1usize << 60];
        a[n]
    } else {
        3
    }
}

#[inline]
fn c4(n: usize) -> u8 {
    if n > 100 {
        let a = [4; 1usize << 60];
        a[n]
    } else {
        4
    }
}

#[inline]
fn c5(n: usize) -> u8 {
    if n > 100 {
        let a = [5; 1usize << 60];
        a[n]
    } else {
        5
    }
}

#[inline]
fn c6(n: usize) -> u8 {
    if n > 100 {
        let a = [6; 1usize << 60];
        a[n]
    } else {
        6
    }
}

#[inline]
fn c7(n: usize) -> u8 {
    if n > 100 {
        let a = [7; 1usize << 60];
        a[n]
    } else {
        7
    }
}

#[inline(never)]
fn all(n: usize) -> u8 {
    c0(n) + c1(n) + c2(n) + c3(n) + c4(n) + c5(n) + c6(n) + c7(n)
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", all(n));
}
