// EDITION: rust
// RULE: F26.1
// `!a` is logical on a bool, bitwise on an integer (of the expected type
// or the operand's). (`Not::not` on a type that implements Not needs
// std2's Not, with the switch.)
// EXPECT: -1
// EXPECT: 250
// EXPECT: 1
fn main() -> i64 {
    let n: i64 = !0;
    std::print_int(n);
    println("");
    let b: u8 = 5;
    let m = !b;
    std::print_int(m as i64);
    println("");
    let t = !false;
    std::print_int(t as i64);
    println("");
    0
}
