// RULE: F26.1
// `!a` is logical on a bool, bitwise on an integer (of the expected type
// or the operand's). (`Not::not` on a type that implements Not needs
// std2's Not, with the switch.)
// EXPECT: -1
// EXPECT: 250
// EXPECT: 1
fn main() {
    let n: i64 = !0;
    println("{}", n);
    let b: u8 = 5;
    let m = !b;
    println("{}", m as i64);
    let t = !false;
    println("{}", t as i64);
}
