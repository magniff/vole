// (0.30.2, obligations M1) An impl's parameter bound with a trait argument,
// `impl<T: Sup<i64>> Tr for V<T>`: the nested obligation `X: Sup<i64>` is
// met by Sup<i64>'s impl, not Sup<i32>'s, which needs `'c: 'static`. rustc
// accepts it.
// EXPECT: 1
trait Sup<P> { fn up(&self) -> i64; }
trait Tr { fn f(&self) -> i64; }
struct V<T> { t: T }
struct X<'c> { r: &'c str }
impl<'c: 'static> Sup<i32> for X<'c> { fn up(&self) -> i64 { 32 } }
impl<'c> Sup<i64> for X<'c> { fn up(&self) -> i64 { 64 } }
impl<T: Sup<i64>> Tr for V<T> { fn f(&self) -> i64 { 1 } }
fn go<T: Tr>(t: &T) -> i64 { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let v = V { t: X { r: st.as_str() } };
    println("{}", go(&v));
}
