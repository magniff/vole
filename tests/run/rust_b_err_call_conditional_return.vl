// EDITION: rust
// RULE: D6.2
// (0.27.1) NLL's problem case 3: a borrow returned on one path keeps the
// parameter borrowed on the other too (L4, as rustc's NLL).
// ERROR: :25:5: error[borrowck.assign_borrowed]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn x_mut(&mut self) -> &mut i64 {
        &mut self.x
    }
}

fn get_or<'a>(s: &'a mut S) -> &'a mut i64 {
    let r = s.x_mut();
    if *r > 0 {
        return r;
    }
    s.x = 5;
    &mut s.y
}

fn main() {
    let mut s = S { x: 0, y: 2 };
    let r = get_or(&mut s);
    *r += 1;
    println("{}", s.y);
}
