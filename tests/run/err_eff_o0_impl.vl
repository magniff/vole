use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; extern "C" {
    fn putchar(c: i32) -> i32;
}

#[derive(Clone, Copy)] struct Bump { used: i64 }

// UNSAFE: a test's allocator (0.26.3: Allocator is an unsafe trait).
// SAFETY: it hands out no memory: try_alloc and try_resize are null.
unsafe impl Allocator for Bump {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
            0 as *mut u8
        }).ok_or(AllocError)
    }

    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr(); let old_size = __old.size() as i64;
        let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
            0 as *mut u8
        }).ok_or(AllocError)
    } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> { unsafe { self.grow(p, old, new) } }

    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr(); let size = __layout.size() as i64;
        let align = __layout.align() as i64;
        putchar(33);
    }
}

fn main() {}
