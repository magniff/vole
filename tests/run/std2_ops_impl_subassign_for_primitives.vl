// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops impl SubAssign for primitives.
// EXPECT: 7 7
use std::ops::SubAssign;

fn update<T: SubAssign>(a: &mut T, b: T) {
    a.sub_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
