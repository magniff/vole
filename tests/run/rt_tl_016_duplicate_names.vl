// XFAIL: RT-TL-16: duplicate closure parameters and duplicate trait method declarations are accepted (open)
// Rust refuses both (E0415, E0428); vole refuses every other duplicate
// (fn parameters, fields, variants, methods of an impl, consts, modules,
// pattern bindings). Today this program checks and prints "2 5": the
// later `b` silently shadows the earlier, and T's two `m`s are one.
// The directives follow today's siblings: an impl's duplicate method is
// "duplicate method 'm' for type 'S'", a fn's duplicate parameter
// "duplicate parameter 'a'"; errors come in source order (the trait first).
// ERROR: duplicate method 'm'
// ERROR: duplicate parameter 'b'
trait T {
    fn m(&self) -> i64;
    fn m(&self) -> u8;
}

struct S;

impl T for S {
    fn m(&self) -> i64 {
        2
    }
}

fn main() -> i32 {
    let z = |b: i64, b: &str| b.len();
    println("{} {}", S.m(), z(7, "hello"));
    0
}
