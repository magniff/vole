// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice ChunksMut.
// EXPECT: [2, 1, 4, 3]
use std::slice::ChunksMut;

fn swap_pairs(c: ChunksMut<'_, i64>) {
    for p in c {
        p.swap(0, 1);
    }
}

fn main() {
    let mut a = [1i64, 2, 3, 4];
    swap_pairs(a.chunks_mut(2));
    println("{:?}", a);
}
