// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::as_ptr.
// EXPECT: 2
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3];
    let p = s.as_ptr();
    // UNSAFE: a read through the slice's pointer.
    // SAFETY: element 1 is in the slice, which outlives p's use.
    let x = unsafe { *p.add(1) };
    println("{}", x);
}
