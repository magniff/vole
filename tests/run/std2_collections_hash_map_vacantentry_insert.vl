// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map VacantEntry::insert.
// EXPECT: 8 Some(8)
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Entry;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let mut got = 0;
    if let Entry::Vacant(e) = m.entry(5) {
        got = *e.insert(8);
    }
    println("{} {:?}", got, m.get(&5));
}
