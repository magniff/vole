// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char CharTryFromError::impl Display.
// EXPECT: converted integer out of range for `char`
use std::char::CharTryFromError;

fn main() {
    let e: Result<char, CharTryFromError> = char::try_from(0x110000u32);
    match e {
        Ok(_) => println("ok"),
        Err(x) => println("{}", x),
    }
}
