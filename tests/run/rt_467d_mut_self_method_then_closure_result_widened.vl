// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// Read directly (`let b: i64 = a;`) the program is refused by
// type.widen_i32; the closure's result escapes it, as in RT-C301-10
// (rt_c301_010_widen_w07, the same closure without the method call). A
// fix of RT-C301-10 alone makes this a refusal, not rustc's value.
// EXPECT: 4000000002
trait Bump { fn bump(&mut self); }
impl Bump for i32 { fn bump(&mut self) { *self += 1; } }
impl Bump for i64 { fn bump(&mut self) { *self += 1; } }

fn main() {
    let mut a = 2000000000;
    a.bump();
    let f = || a + a;
    let b: i64 = f();
    println("{}", b);
}
