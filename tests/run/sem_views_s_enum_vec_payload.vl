use std::alloc::Allocator; enum E<'a, A: Allocator> { A(Vec<&'a str, A>), B }
fn f<'a>(e: &E<'a, Gpa>) -> &'a str { match e { E::A(x) => x[0], E::B => "" } }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa); v.push(w); let e = E::A(v);
    let r = f(&e);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
