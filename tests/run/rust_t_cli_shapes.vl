// EDITION: rust
// (0.27.5) fix --edition rust's translation of tests/refactor/edition0275d (MVS
// std's cli.vl shapes): rustc builds it too, and it prints what the MVS
// program does.
// EXPECT: 6 <--help> <out> false
// EXPECT: <out><out>
use std::fmt::Debug; use std::fmt::Formatter as Fmt; use std::fmt::Display;
#[derive(PartialEq, Eq, Debug, Clone, Copy)]
enum Kind {
    Flag,
    Value,
}

#[derive(Clone, Copy)] struct Opt<'a> {
    name: &'a str,
    kind: Kind,
}

fn put_name(f: &mut Fmt<'_>, name: &str, flag: bool) -> std::fmt::Result {
    if name.len() == 0 {
        return Ok(());
    }
    if flag {
        f.write_str("--")?;
    }
    f.write_str(name)?;
    Ok(()) }

impl Display for Opt<'_> {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        if self.name.len() == 0 {
            return Ok(());
        }
        f.write_char(b'<' as char)?;
        put_name(f, self.name, self.kind == Kind::Flag)?;
        f.write_char(b'>' as char)?;
        Ok(()) }
}

fn add(out: &mut String<Gpa>, o: Opt<'_>) {
    std::fmt::write(&mut *out, o).unwrap();
    std::fmt::write(&mut *out, o).unwrap();
}

fn main(gpa: Gpa) {
    let s: &str = "a|bb|ccc";
    let mut n: i64 = 0;
    for part in s.split('|') {
        n += part.len() as i64;
    }
    let o = Opt { name: "help", kind: Kind::Flag };
    let v = Opt { name: "out", kind: Kind::Value };
    println("{} {o} {v} {}", n, o.kind == v.kind);
    let mut out = String::new_in(gpa);
    add(&mut out, v);
    println("{}", out);
}
