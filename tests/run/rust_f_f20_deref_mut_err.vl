// RULE: F20.2, F6.2
// `v.reverse()` on a Vec is `v.deref_mut().reverse()`: a mutable borrow of
// v while `f`, a reference into it, is still used (rustc E0502).
// ERROR: error[borrowck.conflict]: cannot borrow 'v' as mutable because it is also borrowed as immutable
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    let f = v.first();
    v.reverse();
    println("{:?}", f);
}
