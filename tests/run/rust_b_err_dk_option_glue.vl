// RULE: D9.1
// (0.27.1) An `Option` of an `impl Drop` holder: an enum without `impl Drop`
// takes its payloads' dropck regions.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 23, column 22
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut o = Some(HD { r: &z });
    let x: i64 = 1;
    o = Some(HD { r: &x });
    match o {
        Some(h) => println("{}", *h.r),
        None => {}
    }
}
