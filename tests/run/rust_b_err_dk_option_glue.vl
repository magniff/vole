// (0.27.1) An `Option` of an `impl Drop` holder: an enum without `impl Drop`
// takes its payloads' dropck regions.
// ERROR: :23:22: error[borrowck.dropped_borrowed]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut o = Some(HD { r: &z });
    let x: i64 = 1;
    o = Some(HD { r: &x });
    match o {
        Some(h) => println("{}", *h.r),
        None => {}
    }
}
