// sem-own: #[derive(Clone)] on a struct of owned fields: a deep copy, each dropped once.
// EXPECT: 1 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
#[derive(Clone)]
struct P<A: Allocator> { d: Vec<i64, A>, n: i64 }
impl Clone for D<Gpa> { fn clone(&self) -> D<Gpa> { D { id: self.id, v: self.v.clone() } } }
#[derive(Clone)]
struct Q<A: Allocator> { d: D<A> }

fn main(gpa: Gpa) {
    let p = P { d: Vec::new_in(gpa), n: 1 };
    let mut q = p.clone();
    q.d.push(1);
    q.d.push(2);
    println("{} {}", p.d.len() + 1, q.d.len());
    let x = Q { d: mk(1, gpa) };
    let y = x.clone();
    println("end");
}
