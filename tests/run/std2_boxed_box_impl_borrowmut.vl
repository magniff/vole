// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::boxed Box::impl BorrowMut.
// EXPECT: 4
use std::borrow::BorrowMut;
use std::boxed::Box;

fn main(gpa: Gpa) {
    let mut b = Box::new_in(3i64, gpa);
    let r: &mut i64 = b.borrow_mut();
    *r += 1;
    println("{}", b);
}
