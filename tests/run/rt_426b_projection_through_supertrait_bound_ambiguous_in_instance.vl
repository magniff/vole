// XFAIL: RT-426b: (R302I-9's mechanism, a type parameter) `T::Out` under `T: Sub` with `trait Sub: Tr` (Tr declaring Out), instantiated with a W that also implements another trait Tr2 with an Out, is "'W::Out' is ambiguous: traits 'Tr2' and 'Tr' both define it", in f's result and in `size_of::<T::Out>()` in the instance sz<W>; rustc takes Tr's Out, the only one T's bounds name (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). vole reports 2 errors, at
// line 44 (f's result, in the instance) and line 49 (in sz<W>). Under
// `T: Tr` the same program is right (scratch o1/x2.vl): the supertrait's
// projection is resolved in the instance by its name over every trait of
// W. v0.28.0 to v0.30.1 the same.
// EXPECT: 300 8
trait Tr2 {
    type Out;
}

trait Tr {
    type Out;
    fn get(&self) -> Self::Out;
}

trait Sub: Tr {
    fn h(&self) -> i64;
}

#[derive(Clone, Copy, Debug)]
struct W {
    a: i64,
}

impl Tr2 for W {
    type Out = u8;
}

impl Tr for W {
    type Out = i64;

    fn get(&self) -> i64 {
        self.a
    }
}

impl Sub for W {
    fn h(&self) -> i64 {
        1
    }
}

fn f<T: Sub>(t: &T) -> T::Out {
    t.get()
}

fn sz<T: Sub>(t: &T) -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    let w = W { a: 300 };
    println("{:?} {}", f(&w), sz(&w));
}
