// XFAIL: RT-12: a format's `.*` precision is read and dropped; `w$` and `1$` widths are accepted and ignored (open)
// guide formatting: "precision also `*`: the next argument". The argument
// is taken (the next hole gets the one after it) but not applied: vole
// prints [3.14159] for `{:.*}` with 2, where rustc (and vole 0.27.8)
// print [3.14].
// EXPECT: [3.14]
// EXPECT: [     3.1]
// EXPECT: [3.142] [9]
fn main() {
    let f = 3.14159f64;
    println("[{:.*}]", 2, f);
    println("[{:>8.*}]", 1, f);
    println("[{:.*}] [{}]", 3, f, 9);
}
