// XFAIL: gap 8: compile borrowck.elision: the result of 'squares' borrows, but from which parameter is not said: it has no...
// 0.16: arena scopes. `arena_scope(gpa, f)` gives f a new arena and frees
// it when f returns; `a.scope(f)` gives f a scope of arena a, rewound when
// f returns, a lent meanwhile; scopes nest. What f computes from its
// arena leaves the scope; what holds the arena cannot (#[scoped]).
// EXPECT: 4950 used inside: true
// EXPECT: before 800, inside 800 + 8000, after 800
// EXPECT: nested: 4 + 30, outer back to 0, a back to 800
// EXPECT: large in a scope: given back true
// EXPECT: copied out: [0, 1, 4, 9]
use std::alloc::ArenaScope as ScopedArena; use std::alloc::Arena; use std::collections::HashMap;

fn squares(s: &ScopedArena<'_, Gpa>, n: i64) -> Vec<i64, &ScopedArena<'_, Gpa>> {
    let mut v: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::new_in(s);
    for i in 0..n {
        v.push(i * i);
    }
    v
}

fn main(gpa: Gpa) {
    let r = Arena::new_in(gpa).scope(|s| (|s: &ScopedArena<'_, Gpa>| {
        let mut v: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::new_in(s);
        for i in 0..100 {
            v.push(i);
        }
        let mut t: i64 = 0;
        for x in v.iter().copied() {
            t += x;
        }
        (t, s.used() as i64 > 0)
    })(s));
    println("{} used inside: {}", r.0, r.1);
    let mut a = Arena::new_in(gpa);
    let mut keep: Vec<i64, Arena<Gpa>> = Vec::with_capacity_in(100usize, a);
    let before = a.used() as i64;
    let inside = a.scope(|s| (|s: &ScopedArena<'_, Gpa>| {
        let mut m: HashMap<i64, i64, &ScopedArena<'_, Gpa>> = HashMap::new_in(s);
        let mut v: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::with_capacity_in(1000usize, s);
        for i in 0..1000 {
            v.push(i);
        }
        m.insert(1, 2);
        s.used() as i64
    })(s));
    println("before {before}, inside {before} + {}, after {}", inside - m_bytes(), a.used() as i64);
    let n = a.scope(|s| (|s: &ScopedArena<'_, Gpa>| {
        let mut v: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::with_capacity_in(3usize, s);
        v.push(1);
        let inner = s.scope(|s| (|t: &ScopedArena<'_, Gpa>| {
            let w = squares(t, 3);
            w.len() * 10
        })(s));
        let back = s.used() as i64 == 32;
        (v.capacity(), inner, back)
    })(s));
    println(
        "nested: {} + {}, outer back to {}, a back to {}", n.0, n.1, if n.2 { 0 } else { 1 },
        a.used() as i64);
    let held = a.allocated_bytes() as i64;
    let given = a.scope(|s| (|s: &ScopedArena<'_, Gpa>| {
        let mut big: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::with_capacity_in(10000usize, s);
        big.push(1);
        big.len()
    })(s));
    println("large in a scope: given back {}", a.allocated_bytes() as i64 == held && given == 1);
    let copied = a.scope(|s| (|s: &ScopedArena<'_, Gpa>| squares(s, 4).clone_in(gpa))(s));
    println("copied out: {copied:?}");
    keep.push(1);
    unsafe {
        drop(a);
    }
}

// The bytes of the map's table (0.20: one allocation, 4 buckets of (key,
// value) and their 4 + 8 control bytes).
fn m_bytes() -> i64 {
    4 * 16 + 4 + 8
}
