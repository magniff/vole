// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::convert TryFrom.
// EXPECT: ok 4 err 3
use std::convert::{Infallible, TryFrom};

struct Even {
    v: i64,
}

impl TryFrom<i64> for Even {
    type Error = i64;

    fn try_from(v: i64) -> Result<Even, i64> {
        if v % 2 == 0 { Ok(Even { v: v }) } else { Err(v) }
    }
}

fn show(r: Result<Even, i64>) {
    match r {
        Ok(e) => print("ok {} ", e.v),
        Err(x) => print("err {}", x),
    }
}

fn main() {
    show(Even::try_from(4));
    show(Even::try_from(3));
    println("");
}
