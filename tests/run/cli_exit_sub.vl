// std::cli (0.25.2): parse_or_exit with a required subcommand not given
// prints the error, a try: line naming the subcommands and the usage
// line on stderr, and exits with 2.
// EXIT: 2
// STDERR: error: missing command for 'shop'
// STDERR: try: shop <buy|sell>
// STDERR: usage: shop [options] <command>
use std::env;
use std::cli::{Arg, Command};

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("shop", gpa).subcommand_required()
        .arg(Arg::flag("verbose").short('v').global())
        .subcommand(Command::new_in("buy", gpa))
        .subcommand(Command::new_in("sell", gpa))
        .subcommand(Command::new_in("steal", gpa).hide());
    let m = cmd.parse_or_exit(env::args());
    println("{}", m.subcommand_name().unwrap());
    0
}
