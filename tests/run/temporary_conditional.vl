// XFAIL: gap 10: output: line 1: expected '3 0 -1 0', got '3 0 0 0' [rustc prints the MVS output: the rust edition is wrong]
// `&f(x)` where it is evaluated or not (0.18.1, the eval's task 15): the
// other side of `||`/`&&`, a match arm's value, a closure's body, gets its
// temporaries in a block of its own; `&pool[a..b]` where `&[u8]` is
// expected is a reference to a temporary slice. Nothing leaks.
// FLAGS: --check-alloc
// EXPECT: 3 0 -1 0
use std::alloc::Allocator;
#[derive(Copy)] enum Val<'a> { Str(&'a str), Int(i64), Null } impl Clone for Val<'_> { fn clone(
    &self) -> Self { *self } }
struct T<A: Allocator> { v: Vec<i64, A> }
impl T<Gpa> { fn val(&self, i: i64) -> Val<'_> { Val::Int(self.v[i as usize]) } }

fn cmp_vals(a: Val<'_>, b: Val<'_>) -> i64 {
    match (a, b) {
        (Val::Int(x), Val::Int(y)) => x - y,
        _ => 0,
    }
}

fn count(t: &T<Gpa>, ord: &Vec<i64, Gpa>) -> i64 {
    let n = ord.len();
    let mut groups: i64 = 0;
    for i in 0..n + 1 {
        if i == 0 || i == n || cmp_vals(t.val(ord[i - 1]), t.val(ord[i])) != 0 { groups += 1; }
    }
    groups
}

fn pick(t: &T<Gpa>, k: i64) -> i64 {
    match k {
        0 => cmp_vals(t.val(0), t.val(1)),
        _ => 7,
    }
}

fn sl(pool: &str) -> i64 { (&pool[0..2]).cmp(&&pool[1..3]) as i64 }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(1); v.push(2);
    let t = T { v: v };
    let mut ord: Vec<i64, Gpa> = Vec::new_in(gpa);
    ord.push(0); ord.push(1); ord.push(2);
    let mut keys: Vec<i64, Gpa> = Vec::new_in(gpa);
    keys.push(2); keys.push(0); keys.push(1);
    keys.sort_unstable_by(
        |a, b| ({ let a = *a; let b = *b; cmp_vals(t.val(a), t.val(b)) }).cmp(&0));
    println("{} {} {} {}", count(&t, &ord), pick(&t, 0), sl("abcd"), keys[0]);
}
