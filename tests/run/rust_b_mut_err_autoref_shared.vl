// RULE: D2.7
// (0.27.2) A `&mut self` method called on `s: &S`.
struct S {
    n: i64,
}

impl S {
    fn bump(&mut self) {
        self.n += 1;
    }
}

fn h(s: &S) {
    s.bump();
}

fn main() {
    let a = S { n: 1 };
    h(&a);
}
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 14, column 5
// ERROR-COUNT: 1
