// RT-211 review 3: FilterMap's `type Item = B` with `F: FnMut(I::Item) ->
// Option<B>`: B read at its place inside the closure's result, here a
// borrow of the capture w (rustc E0505 at the drop). v0.30.1 built it: a
// use after free.
// ERROR: line 19
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut w: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(String::from_in("hello heap string long", gpa));
    let r = first(v.iter().filter_map(|_x| Some(&w[0])), &k);
    drop(w);
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{:?} {}", r, other.len());
}
