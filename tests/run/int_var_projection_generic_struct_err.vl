// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). Out =
// Wr<i64> used as Wr<i32>: rustc E0271.
// ERROR: (rustc E0271)
// ERROR: line 37, column 22
// ERROR-COUNT: 1
struct Wr<T>(T);

trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = Wr<u16>;

    fn o(self) -> Wr<u16> {
        Wr(self as u16)
    }
}

impl Tr for i32 {
    type Out = Wr<i64>;

    fn o(self) -> Wr<i64> {
        Wr(self as i64 * 3000000000)
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let v: Wr<i32> = f(2);
    println("{}", v.0);
}
