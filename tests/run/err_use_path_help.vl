    let h: BinaryHeap<i64, Gpa> = BinaryHeap::new_in(gpa);
    let a = Arena::new_in(gpa);
    let m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let b: BTreeMap<i64, i64, Gpa> = BTreeMap::new_in(gpa);
}
