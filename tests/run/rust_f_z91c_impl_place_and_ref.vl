// RULE: Z9.1c
// (0.27.4) An impl for the unsized place (`[i64]`, `str`) and one for a
// reference to it (`&[i64]`, `&str`) are two impls with two keys: a
// method call on a view finds the place's through the autoderef step,
// and a bound on `T = &str` the reference's.
// EXPECT: place 3
// EXPECT: ref 3
// EXPECT: place 2
// EXPECT: ref 2
// EXPECT: ref 2
trait Tell {
    fn tell(&self) -> usize;
}

impl Tell for [i64] {
    fn tell(&self) -> usize {
        println("place {}", self.len());
        self.len()
    }
}

impl Tell for &[i64] {
    fn tell(&self) -> usize {
        println("ref {}", self.len());
        self.len()
    }
}

impl Tell for str {
    fn tell(&self) -> usize {
        println("place {}", self.len());
        self.len()
    }
}

impl Tell for &str {
    fn tell(&self) -> usize {
        println("ref {}", self.len());
        self.len()
    }
}

fn by_bound<T: Tell>(t: T) -> usize {
    t.tell()
}

fn main() {
    let a = [1i64, 2, 3];
    let s: &[i64] = &a;
    s.tell();
    by_bound(s);
    let t = "ab";
    t.tell();
    (&t).tell();
    by_bound(t);
}
