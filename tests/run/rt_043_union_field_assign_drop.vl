// From the final check of f301init (2026-11-15). `u.x = 5; u.p.d = D { v: 3 };`
// needs no `unsafe` and drops the `d` read from u.x's bytes; with an owning
// field it would free a garbage pointer. rustc refuses the union: a union's
// field must be Copy or ManuallyDrop<T> (E0740), so no field has drop glue.
// ERROR: ManuallyDrop
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct P {
    d: D,
    k: i64,
}

union U {
    p: P,
    x: i64,
}

fn main() {
    let mut u = U { p: P { d: D { v: 1 }, k: 0 } };
    u.x = 5;
    u.p.d = D { v: 3 };
    println("end");
}
