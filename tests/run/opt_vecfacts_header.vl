// EXPECT: sum 4950 4951
// EXPECT: inc 1 100
// EXPECT: mark 0 102 98
// EXPECT: walk 4950
// (0.25.4) A Vec's header out of its loops (middle::vecfacts): the ptr of
// a let parameter's Vec is read once, before the loop, so the loop is
// vectorized (fact 1, and the vectorizer's hoisting of invariant loads);
// the stores of an inout or a static Vec's elements do not reach its
// header (fact 2), so `for i in 0..v.len() { v[i] = .. }` keeps no
// bounds check, and a static Vec's ptr and len are read before the loop
// that indexes it.
// CHECK: fn sum_let:
// CHECK: v2i64 = load
// CHECK: vsum
// CHECK: fn inc_inout:
// CHECK-NOT: rt.panic
// CHECK: v2i64 = load
// CHECK-NOT: rt.panic
// CHECK: fn mark:
// CHECK-NOT: rt.panic
// CHECK: fn walk:
// CHECK: gaddr NODES
// CHECK: load
// CHECK: load
// CHECK: phi
// CHECK-NOT: gaddr NODES
// CHECK: rt.panic
struct Heap {}

// UNSAFE: C's allocator, which Heap hands out.
// SAFETY: called with sizes checked non-negative, on blocks Heap allocated.
extern "C" {
    fn malloc(n: u64) -> *u8;
    fn realloc(p: *u8, n: u64) -> *u8;
    fn free(p: *u8);
}

impl Allocator for Heap {
    fn try_alloc(self: *Heap, size: i64, align: i64) -> *u8 {
        if size < 0 {
            return 0 as *u8;
        }
        // UNSAFE: C's allocator.
        // SAFETY: size is checked non-negative.
        unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block.
    unsafe fn try_resize(self: *Heap, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        realloc(p, if new_size <= 0 { 1 } else { new_size } as u64)
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block, once.
    unsafe fn free(self: *Heap, p: *u8, size: i64, align: i64) {
        free(p);
    }
}

struct Node { start: i64, end: i64, kind: i64, next: i64 }

static var NODES: Vec<Node, Heap> = Vec::new_in(Heap {});

#[inline(never)]
fn sum_let(v: Vec<i64>, k: i64) -> i64 {
    var s = k;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

#[inline(never)]
fn inc_inout(v: inout Vec<i64>) {
    for i in 0..v.len() {
        v[i] = v[i] + 1;
    }
}

#[inline(never)]
fn mark() {
    for i in 0..NODES.len() {
        NODES[i].end = NODES[i].start + NODES[i].kind;
    }
}

#[inline(never)]
fn walk(steps: i64) -> i64 {
    var k = 0;
    var s = 0;
    for _ in 0..steps {
        k = NODES[k].next;
        s += k;
    }
    s
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
    }
    println("sum {} {}", sum_let(v, 0), sum_let(v, 1));
    inc_inout(&v);
    println("inc {} {}", v[0], v[99]);
    for i in 0..100 {
        NODES.push(Node { start: i, end: 0, kind: i & 1, next: (i + 1) % 100 });
    }
    mark();
    println("mark {} {} {}", NODES[0].end, NODES[99].end + NODES[1].end, NODES[98].end);
    println("walk {}", walk(100));
}
