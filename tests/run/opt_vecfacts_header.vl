// EXPECT: sum 4950 4951
// EXPECT: inc 1 100
// EXPECT: mark 0 102 98
// EXPECT: walk 4950
// (0.25.4) A Vec's header out of its loops (middle::vecfacts): the ptr of
// a let parameter's Vec is read once, before the loop, so the loop is
// vectorized (fact 1, and the vectorizer's hoisting of invariant loads);
// the stores of an inout or a static Vec's elements do not reach its
// header (fact 2), so `for i in 0..v.len() { v[i] = .. }` keeps no
// bounds check, and a static Vec's ptr and len are read before the loop
// that indexes it. (0.26.3: a static holds no allocator, alloc.static:
// mark takes the node table inout, as inc_inout its Vec, and walk takes
// it let, its ptr and len read once before the loop; a static Vec is
// now only compiler/src's exempt tables.)
// CHECK: fn sum_let:
// CHECK: v2i64 = load
// CHECK: vsum
// CHECK: fn inc_inout:
// CHECK-NOT: rt.panic
// CHECK: v2i64 = load
// CHECK-NOT: rt.panic
// CHECK: fn mark:
// CHECK-NOT: rt.panic
// CHECK: fn walk:
// CHECK: param 0
// CHECK: load
// CHECK: load
// CHECK: jump
// CHECK-NOT: = load v1
// CHECK: rt.panic
use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; #[derive(Clone, Copy)] struct Heap {}

// UNSAFE: C's allocator, which Heap hands out.
// SAFETY: called with sizes checked non-negative, on blocks Heap allocated.
extern "C" {
    fn malloc(n: u64) -> *mut u8;
    fn realloc(p: *mut u8, n: u64) -> *mut u8;
    fn free(p: *mut u8);
}

// UNSAFE: a test's allocator built over C's (0.26.3: Allocator is an unsafe trait).
// SAFETY: its memory comes from C's malloc, realloc and free, aligned to 16.
unsafe impl Allocator for Heap {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
            if size < 0 {
                return NonNull::new(0 as *mut u8).ok_or(AllocError);
            }
            // UNSAFE: C's allocator.
            // SAFETY: size is checked non-negative.
            unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
        }).ok_or(AllocError)
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block.
    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr(); let old_size = __old.size() as i64;
        let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
            realloc(p, if new_size <= 0 { 1 } else { new_size } as u64)
        }).ok_or(AllocError)
    } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> { unsafe { self.grow(p, old, new) } }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block, once.
    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr(); let size = __layout.size() as i64;
        let align = __layout.align() as i64;
        free(p);
    }
}

#[derive(Clone, Copy)] struct Node { start: i64, end: i64, kind: i64, next: i64 }

#[inline(never)]
fn sum_let(v: &Vec<i64, Gpa>, k: i64) -> i64 {
    let mut s = k;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

#[inline(never)]
fn inc_inout(v: &mut Vec<i64, Gpa>) {
    for i in 0..v.len() {
        v[i] = v[i] + 1;
    }
}

#[inline(never)]
fn mark(nodes: &mut Vec<Node, Heap>) {
    for i in 0..nodes.len() {
        nodes[i].end = nodes[i].start + nodes[i].kind;
    }
}

#[inline(never)]
fn walk(nodes: &Vec<Node, Heap>, steps: i64) -> i64 {
    let mut k: i64 = 0;
    let mut s: i64 = 0;
    for _ in 0..steps {
        k = nodes[k as usize].next;
        s += k;
    }
    s
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
    }
    println("sum {} {}", sum_let(&v, 0), sum_let(&v, 1));
    inc_inout(&mut v);
    println("inc {} {}", v[0], v[99]);
    let mut nodes: Vec<Node, Heap> = Vec::new_in(Heap {});
    for i in 0..100 {
        nodes.push(Node { start: i, end: 0, kind: i & 1, next: (i + 1) % 100 });
    }
    mark(&mut nodes);
    println("mark {} {} {}", nodes[0].end, nodes[99].end + nodes[1].end, nodes[98].end);
    println("walk {}", walk(&nodes, 100));
}
