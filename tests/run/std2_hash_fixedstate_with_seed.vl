// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FixedState::with_seed.
// EXPECT: true false
// EXPECT: 3121228776637052990
// RUSTC: none (FixedState is foldhash's (the foldhash crate's FixedState, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{BuildHasher, FixedState, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let z = FixedState::with_seed(0).hash_one(5u64);
    let one = FixedState::with_seed(1).hash_one(5u64);
    println("{} {}", z == FixedState::new().hash_one(5u64), one == z);
    println("{}", FixedState::with_seed(42).hash_one(5u64));
}
