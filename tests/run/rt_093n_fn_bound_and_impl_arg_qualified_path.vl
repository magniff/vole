// A qualified path in an `Fn` bound's parameter and result, and in `impl G<<S as A>::Out>` (v0.30.1: "expected type, got '<<'"; rustc 12 5)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: 12 5
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn ap<F: Fn(<<S as A>::Out as B>::E) -> <<S as A>::Out as B>::E>(f: F) -> i64 {
    f(4)
}

fn ga(x: &impl G<<S as A>::Out>) -> i64 {
    x.g()
}

fn main() {
    println("{} {}", ap(|x| x * 3), ga(&S));
}
