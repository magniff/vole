// RULE: F5.5
// (0.30.1) An impl method may be more general than its trait's
// declaration, never less (rustc's compare_impl_method): each of these
// impls is accepted, as rustc accepts it. A result of a longer lifetime
// than the trait's ('static for 'a, a covariant struct's X<'static> for
// X<'a>), a parameter that takes more (an elided lifetime where the trait
// names 'static), the impl's own lifetimes where the trait's are, the
// header's lifetime where the trait's signature implies it outlives the
// trait's ('x of `&'a W<'x>`), std's Iterator, From, Clone and PartialEq
// (Rhs left to its default Self), a generic impl, a default method kept.
// EXPECT: a b c
// EXPECT: hello
// EXPECT: w x 2
// EXPECT: (1, 2, 3)
// EXPECT: true false
// EXPECT: 7 8
trait Get {
    fn get<'a>(&self, x: &'a str) -> &'a str;
    fn put(&mut self, x: &'static str);
    fn mine<'a>(&'a self) -> &'a str;

    fn twice(&self) -> usize {
        self.mine().len() * 2
    }
}

struct W<'x> {
    s: &'x str,
}

impl<'x> Get for W<'x> {
    // ('static outlives 'a: more general)
    fn get<'a>(&self, _x: &'a str) -> &'static str {
        "a"
    }

    // (an elided lifetime takes the trait's 'static)
    fn put(&mut self, x: &str) {
        let _ = x.len();
    }

    // ('x outlives 'a: `&'a W<'x>` says so)
    fn mine<'b>(&'b self) -> &'x str {
        self.s
    }
}

#[derive(Clone, Copy)]
struct X<'a> {
    s: &'a str,
}

trait Make<'a> {
    fn make(&self) -> X<'a>;
}

impl<'a> Make<'a> for X<'a> {
    // (X is covariant: X<'static> is an X<'a>)
    fn make(&self) -> X<'static> {
        X { s: "x" }
    }
}

struct Words<'a> {
    v: &'a [&'a str],
    i: usize,
}

impl<'a> Iterator for Words<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.i < self.v.len() {
            self.i += 1;
            Some(self.v[self.i - 1])
        } else {
            None
        }
    }
}

struct Name<'a> {
    s: &'a str,
}

impl<'a> From<&'a str> for Name<'a> {
    fn from(s: &'a str) -> Name<'a> {
        Name { s: s }
    }
}

struct Lower<'a> {
    s: &'a str,
}

impl PartialEq for Lower<'_> {
    fn eq(&self, other: &Self) -> bool {
        self.s.len() == other.s.len()
    }
}

struct Holder<T> {
    v: (T, T, T),
}

impl<T: Clone> Clone for Holder<T> {
    fn clone(&self) -> Holder<T> {
        Holder { v: self.v.clone() }
    }
}

trait Pair<T> {
    fn first(&self) -> &T;
    fn second(&self) -> T;
}

impl<T: Copy> Pair<T> for (T, T) {
    fn first(&self) -> &T {
        &self.0
    }

    fn second(&self) -> T {
        self.1
    }
}

fn main(gpa: Gpa) {
    let text = String::from_in("bc", gpa);
    let mut w = W { s: text.as_str() };
    w.put("p");
    let c = &text.as_str()[1..];
    println("{} {} {}", w.get("z"), &w.mine()[..1], c);
    let words = ["he", "llo"];
    let mut all = String::new_in(gpa);
    for s in (Words { v: &words, i: 0 }) {
        all.push_str(s);
    }
    println("{all}");
    let n: Name<'_> = Name::from("w");
    println("{} {} {}", n.s, X { s: "q" }.make().s, w.twice() / 2);
    let h = Holder { v: (1, 2, 3) };
    println("{:?}", h.clone().v);
    println("{} {}", Lower { s: "ab" } == Lower { s: "AB" }, Lower { s: "a" } == Lower { s: "AB" });
    let p = (7, 8);
    println("{} {}", p.first(), p.second());
}
