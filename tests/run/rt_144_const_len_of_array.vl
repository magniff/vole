// XFAIL: RT-144: `const N: usize = NAMES.len();` of a const array or a byte string is not a compile-time constant (0.30.2)
// From the review of c302const; v0.30.1 too. rustc accepts both.
// EXPECT: 3 5 3
const NAMES: [&str; 3] = ["a", "b", "c"];
const N: usize = NAMES.len();
const B: usize = b"hello".len();

fn main() {
    let a = [0u8; N];
    println("{} {} {}", N, B, a.len());
}
