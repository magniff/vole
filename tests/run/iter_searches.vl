// EDITION: rust
// The Iterator trait's searches (0.15): any, all, position, find. Each
// stops at the first item that decides (the counter `seen` shows how many
// items were reached), works on a filter chain and a user iterator, and
// on nothing (any: false, all: true, position/find: None).
// EXPECT: any 1 3 | 0 6
// EXPECT: all 1 6 | 0 2
// EXPECT: position 2 3 | none 6
// EXPECT: find 9 3 | none 6
// EXPECT: chain 1 18 | user 1 4 0
// EXPECT: empty 0 1 1 1
fn show(label: &str, x: i64) {
    print("{}", label);
    print("{}", x);
}

#[derive(Clone, Copy)] struct Countdown { n: i64 }

impl Iterator for Countdown {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n == 0 {
            return Option::None;
        }
        self.n -= 1;
        Option::Some(self.n)
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    v.push(2);

    let mut seen: i64 = 0;
    show("any ", v.iter().copied().any(|x| {
        seen += 1;
        x > 8
    }) as i64);
    show(" ", seen);
    seen = 0;
    show(" | ", v.iter().copied().any(|x| {
        seen += 1;
        x > 100
    }) as i64);
    show(" ", seen);
    println("");

    seen = 0;
    show("all ", v.iter().copied().all(|x| {
        seen += 1;
        x > 0
    }) as i64);
    show(" ", seen);
    seen = 0;
    show(" | ", v.iter().copied().all(|x| {
        seen += 1;
        x > 2
    }) as i64);
    show(" ", seen);
    println("");

    seen = 0;
    show("position ", (v.iter().copied().position(|x| {
        seen += 1;
        x == 9
    }).unwrap()) as i64);
    show(" ", seen);
    seen = 0;
    print(" | ");
    if v.iter().copied().position(|x| {
        seen += 1;
        x == 4
    }).is_none() {
        print("none");
    }
    show(" ", seen);
    println("");

    seen = 0;
    show("find ", v.iter().copied().find(|x| ({ let x = *x; {
        seen += 1;
        x > 6
    } })).unwrap());
    show(" ", seen);
    seen = 0;
    print(" | ");
    if v.iter().copied().find(|x| ({ let x = *x; {
        seen += 1;
        x < 0
    } })).is_none() {
        print("none");
    }
    show(" ", seen);
    println("");

    show("chain ",
        v.iter().copied().filter(|x| ({ let x = *x; x % 2 == 1 })).any(|x| x == 7) as i64);
    show(" ", v.iter().copied().map(|x| x * 2).find(|x| ({ let x = *x; x > 12 })).unwrap());
    show(" | user ", Countdown { n: 5 }.any(|x| x == 3) as i64);
    show(" ", Countdown { n: 5 }.find(|x| ({ let x = *x; x % 2 == 0 })).unwrap());
    show(" ", (Countdown { n: 5 }.position(|x| x == 4).unwrap()) as i64);
    println("");

    show("empty ", (0i64..0i64).any(|x| true) as i64);
    show(" ", (0i64..0i64).all(|x| false) as i64);
    show(" ", (0i64..0i64).position(|x| true).is_none() as i64);
    show(" ", (0i64..0i64).find(|x| ({ let x = *x; true })).is_none() as i64);
    println("");
    0
}
