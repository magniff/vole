// ERROR: the trait 'Tr<i32>' is not implemented for 'W'
// (RT-270) `where Z: Tr` of `trait Tr<U = i32>` is `Z: Tr<i32>`, not Tr with any arguments (rustc E0277; v0.30.1 accepted it).
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

fn c<Z>(z: &Z) -> i64
    where
        Z: Tr,
{
    1
}

fn main() {
    println("{}", c(&W { r: 0 }));
}
