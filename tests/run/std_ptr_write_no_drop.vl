// 0.30: ptr::write and `<*mut T>::write` write without dropping what
// was there, now that `*p = v` drops it: a Vec's spare capacity filled
// through `p.add(i)` (memory that holds no value yet: a drop would run on
// garbage), then counted by set_len and dropped once by the Vec; a value
// written over by ptr::write keeps its old value undropped (moved out
// first by ptr::read, so nothing leaks); a String in spare capacity (the
// Vec frees it, FLAGS); and ptr::copy, mem::swap and mem::replace, which
// write the same way.
// FLAGS: --check-alloc
// EXPECT: spare
// EXPECT: mk0
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: len 3
// EXPECT: mk7
// EXPECT: d1
// EXPECT: --
// EXPECT: d0
// EXPECT: d7
// EXPECT: d2
// EXPECT: over
// EXPECT: mk3
// EXPECT: mk4
// EXPECT: read 3
// EXPECT: d3
// EXPECT: --
// EXPECT: d4
// EXPECT: method
// EXPECT: mk5
// EXPECT: --
// EXPECT: d5
// EXPECT: strings
// EXPECT: a bb ccc
// EXPECT: copy
// EXPECT: mk8
// EXPECT: mk9
// EXPECT: 9 8
// EXPECT: --
// EXPECT: d9
// EXPECT: d8
// EXPECT: mem
// EXPECT: mk10
// EXPECT: mk11
// EXPECT: mk12
// EXPECT: 12 10 11
// EXPECT: d11
// EXPECT: d10
// EXPECT: d12
// EXPECT: end
use std::ptr;

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

fn main(gpa: Gpa) -> i32 {
    println("spare");
    {
        let mut v: Vec<T, Gpa> = Vec::with_capacity_in(3, gpa);
        let p = v.as_mut_ptr();
        // UNSAFE: writes the spare capacity, then counts it.
        // SAFETY: capacity >= 3, the three written (without a drop: they
        // hold no value) before set_len.
        unsafe {
            for i in 0..3 {
                ptr::write(p.add(i), mk(i as i64));
            }
            v.set_len(3);
        }
        println("len {}", v.len());
        // UNSAFE: a write through a raw pointer, which drops the old value.
        // SAFETY: v has 3 elements; p.add(1) is the second, initialized,
        // and v's buffer has not moved since as_mut_ptr.
        unsafe { *p.add(1) = mk(7); }
        println("--");
    }
    println("over");
    {
        let mut x = mk(3);
        let p = &mut x as *mut T;
        // UNSAFE: the old value moved out, then written over without a drop.
        // SAFETY: p is x's address, x initialized; old takes its value, so
        // the write over it drops nothing and nothing is dropped twice.
        let old = unsafe {
            let old = ptr::read(p as *const T);
            ptr::write(p, mk(4));
            old
        };
        println("read {}", old.id);
        drop(old);
        println("--");
    }
    println("method");
    {
        let mut v: Vec<T, Gpa> = Vec::with_capacity_in(1, gpa);
        let p = v.as_mut_ptr();
        // UNSAFE: writes the spare capacity, then counts it.
        // SAFETY: capacity >= 1, written before set_len.
        unsafe {
            p.write(mk(5));
            v.set_len(1);
        }
        println("--");
    }
    println("strings");
    {
        let mut v: Vec<String<Gpa>, Gpa> = Vec::with_capacity_in(3, gpa);
        let p = v.as_mut_ptr();
        // UNSAFE: writes the spare capacity, then counts it.
        // SAFETY: capacity >= 3, the three written before set_len.
        unsafe {
            ptr::write(p, String::from_in("a", gpa));
            ptr::write(p.add(1), String::from_in("bb", gpa));
            ptr::write(p.add(2), String::from_in("ccc", gpa));
            v.set_len(3);
        }
        println("{} {} {}", v[0], v[1], v[2]);
    }
    println("copy");
    {
        let mut v: Vec<T, Gpa> = Vec::with_capacity_in(2, gpa);
        let p = v.as_mut_ptr();
        // UNSAFE: writes the spare capacity, moves the first element's bits
        // to the second slot, writes the first again, then counts them.
        // SAFETY: capacity >= 2; slot 0's value is moved to slot 1 by the
        // copy (slot 1 held none), so writing slot 0 without a drop drops
        // nothing twice; both are written before set_len.
        unsafe {
            ptr::write(p, mk(8));
            ptr::copy(p as *const T, p.add(1), 1);
            ptr::write(p, mk(9));
            v.set_len(2);
        }
        println("{} {}", v[0].id, v[1].id);
        println("--");
    }
    println("mem");
    {
        let mut a = mk(10);
        let mut b = mk(11);
        std::mem::swap(&mut a, &mut b);
        let c = std::mem::replace(&mut a, mk(12));
        println("{} {} {}", a.id, b.id, c.id);
    }
    println("end");
    0
}
