// RT-275, fixed in 0.30.2 (obligations M2).
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// A template whose opaque instance cannot be made
// (front::opaque::build_opaque_instances, opaque_instance answering -1)
// is left out of checking with no error and no warning: its body is
// checked nowhere.
// Here the impl's header is wrong: A: Tr<i32> does not give G's
// `T: Tr<i64>`. rustc refuses the header (E0277: the trait bound `A:
// Tr<i64>` is not satisfied); vole prints `ok: 0 errors`.
// ERROR: error[
// ERROR: line 19, column 18
// ERROR-COUNT: 1
trait Tr<U> {}

struct G<T: Tr<i64>> {
    t: T,
}

impl<A: Tr<i32>> G<A> {
    fn good(&self) -> i64 {
        1
    }
}

fn main() {
    println("{}", 1);
}
