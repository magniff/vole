// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'go', which writes through a raw pointer what it did not make
// the slicing &mut (*sp)[..] handed to a safe setter
fn set0(s: &mut [i64]) { s[0] = 9; }
fn go(sp: *mut [i64]) -> bool { set0(unsafe { &mut (*sp)[..] }); true }

fn f(sp: *mut [i64]) -> i64
    requires go(sp)
{ 1 }

fn main() {
    let mut a = [1i64, 2]; let sp = &mut a[..] as *mut [i64]; println("{}", f(sp));
    println("{}", a[0]);
}
