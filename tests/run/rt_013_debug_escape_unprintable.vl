// XFAIL: RT-13: Debug of a char or str leaves private-use, unassigned, noncharacter and soft-hyphen code points unescaped (open)
// Rust's `{:?}` escapes every char that core::unicode's is_printable calls
// not printable: U+E000 and U+F8FF (private use), U+FFFE and U+10FFFF
// (noncharacters), U+0378 and U+D7FF (unassigned), U+00AD (soft hyphen,
// a format character). vole writes them raw (it escapes U+0300, U+FEFF,
// U+2028, U+00A0, U+0085, U+E0001 and U+3000 as Rust does). The EXPECT
// lines are rustc 1.98's output.
// EXPECT: '\u{e000}'
// EXPECT: '\u{fffe}'
// EXPECT: '\u{378}'
// EXPECT: '\u{ad}'
// EXPECT: '\u{10ffff}'
// EXPECT: '\u{d7ff}'
// EXPECT: '\u{f8ff}'
// EXPECT: '\u{300}'
// EXPECT: "a\u{e000}b\u{ad}c\u{378}"
fn main() {
    let cs = ['\u{e000}', '\u{fffe}', '\u{378}', '\u{ad}', '\u{10ffff}', '\u{d7ff}', '\u{f8ff}',
        '\u{300}'];
    for c in cs {
        println("{:?}", c);
    }
    println("{:?}", "a\u{e000}b\u{ad}c\u{378}");
}
