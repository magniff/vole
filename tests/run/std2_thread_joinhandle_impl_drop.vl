// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread JoinHandle::impl Drop.
// EXPECT: detached
// EXPECT: 2
use std::thread;
use std::mem::swap;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || 1i64, gpa);
    drop(h);
    println("detached");
    let g = thread::spawn_in(move || 2i64, gpa);
    println("{}", g.join().unwrap());
}
