// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::thread JoinHandle::impl Drop.
// NO-EXTRA-FLAGS: the detached thread may still hold its blocks when main exits, so --check-alloc's leak list depends on timing
// EXPECT: detached
// EXPECT: 2
use std::thread;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || 1i64, gpa);
    drop(h);
    println("detached");
    let g = thread::spawn_in(move || 2i64, gpa);
    println("{}", g.join().unwrap());
}
