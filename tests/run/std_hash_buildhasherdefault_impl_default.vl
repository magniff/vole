// Runs on std since 0.27.2's switch.
// The std item(s): std::hash BuildHasherDefault::impl Default.
// EXPECT: 14695981039346656037
use std::hash::{BuildHasher, BuildHasherDefault, Hash, Hasher};

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

impl Default for Fnv {
    fn default() -> Fnv {
        Fnv { h: 0xcbf29ce484222325 }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

fn main() {
    let b: BuildHasherDefault<Fnv> = BuildHasherDefault::default();
    println("{}", b.build_hasher().finish());
}
