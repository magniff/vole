// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters Flatten.
// EXPECT: [1, 2, 3]

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([3i64], gpa);
    let vs = Vec::from_in([a, b], gpa);
    let v: Vec<i64, Gpa> = vs.into_iter().flatten().collect_in(gpa);
    println("{:?}", v);
}
