// (0.27.0) Hand-translated from tests/run/sem_own_iter_owned_take.vl to Rust's spelling.
// sem-own: take(1) over owned items: only one is made (lazy), dropped once.
// EXPECT: n 1
// EXPECT: drop 0
use std::alloc::Allocator;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let w: Vec<D<Gpa>, Gpa> = (0..3).map(|i| mk(i, gpa)).take(1).collect_in(gpa);
    println("n {}", w.len());
}
// Runs on std since 0.27.2's switch.
