// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc FixedBuf::impl Allocator.
// EXPECT: true true false
use std::alloc::{Allocator, FixedBuf, Layout};

fn main() {
    let mut mem = [0u8; 16];
    let fb = FixedBuf::new(&mut mem);
    let a = fb.allocate(Layout::array::<u8>(10).unwrap()).is_ok();
    let b = fb.allocate(Layout::array::<u8>(10).unwrap()).is_err();
    println("{} {} {}", a, b, false);
}
