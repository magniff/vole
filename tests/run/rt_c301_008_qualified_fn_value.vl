// XFAIL: RT-C301-8: `<S as B>::m` as a fn value is A's m: a miscompile, the wrong function runs (0.30.2)
// From the review: method values <S as B>::m
// rustc prints 2 1 2 1.
// EXPECT: 2 1 2 1
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn apply(f: fn(&S) -> i64, s: &S) -> i64 { f(s) }

fn main() {
    let s = S; let f = <S as B>::m; let g: fn(&S) -> i64 = <S as A>::m;
    println("{} {} {} {}", f(&s), g(&s), apply(<S as B>::m, &s), apply(<S as A>::m, &s));
}
