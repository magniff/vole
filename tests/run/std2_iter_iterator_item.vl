// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter Iterator::Item.
// EXPECT: 3

fn first<I: Iterator<Item = i64>>(mut it: I) -> Option<I::Item> {
    it.next()
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([3i64, 4], gpa);
    println("{}", first(v.iter().copied()).unwrap());
}
