// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Utf8Error::impl Display.
// EXPECT: invalid utf-8 sequence of 1 bytes from index 1
// EXPECT: incomplete utf-8 byte sequence from index 2
use std::str::CharIndices;

fn main() {
    let a = std::str::from_utf8(&[0x61, 0xFF]).unwrap_err();
    let b = std::str::from_utf8(&[0x61, 0x62, 0xE2, 0x82]).unwrap_err();
    println("{}", a);
    println("{}", b);
}
