use std::sync::atomic::{Atomic, AtomicValue};

struct P { x: i64, y: i64 }

impl AtomicValue for P {
    fn sealed_value(self) -> std::sync::atomic::Sealed { unreachable() }
}

fn main() -> i32 {
    let a = Atomic::new(P { x: 1, y: 2 });
    0
}
