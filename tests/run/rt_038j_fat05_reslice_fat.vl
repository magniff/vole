// &mut (*sp)[0..1] of a fat raw pointer
fn go(sp: *mut [i64]) -> bool { let s = unsafe { &mut (*sp)[0..1] }; s[0] = 9; true }

fn f(sp: *mut [i64]) -> i64
    requires go(sp)
{ 1 }

