// (0.29.0) hash.default: std's HashMap and HashSet have no default
// hasher type, as they have no default allocator: the hasher is written,
// last (`HashMap<K, V, Gpa, FixedState>`). The fix writes `FixedState`
// with its `use`, and in an item generic over one hasher that parameter;
// with two hasher parameters the help names both and there is no fix. A
// program's own type with a `S: BuildHasher` parameter is the same; with
// the allocator left out too, alloc.default comes first. The transcript
// tests/refactor/hash0290.t has the fix's output.
// ERROR: error[hash.default]: 'HashMap' names no hasher: its 'S' is written, last
// ERROR: help: the hasher is part of the type: `FixedState` (`use std::hash::FixedState;`, the one `HashMap::new_in` makes), or a generic `S: BuildHasher`
// ERROR: fix --suggested
// ERROR: error[alloc.default]: 'HashSet' names no allocator: its 'A' is written, last
// ERROR: error[hash.default]: 'HashSet' names no hasher: its 'S' is written, last
// ERROR: its fix comes after the allocator's
// ERROR: help: this item is generic over the hasher 'S': write it (`, S`, the fix), or `FixedState`
// ERROR: help: this item is generic over the hashers 'S' and 'T': write the one this 'HashSet' hashes with as its last type argument (`, S`); no fix chooses between them
// ERROR: error[hash.default]: 'Cache' names no hasher: its 'S' is written, last
// ERROR-COUNT: 7
use std::alloc::Allocator;
use std::collections::{HashMap, HashSet};
use std::hash::{BuildHasher, FixedState};

fn keys(m: &HashMap<i64, i64, Gpa>) -> usize {
    m.len()
}

fn bare(s: &HashSet<i64>) -> usize {
    s.len()
}

fn same<S: BuildHasher>(a: &HashSet<i64, Gpa, S>, b: &HashSet<i64, Gpa>) -> usize {
    a.len() + b.len()
}

fn pick<S: BuildHasher, T: BuildHasher>(a: &HashSet<i64, Gpa, S>, b: &HashSet<i64, Gpa, T>,
    c: &HashSet<i64, Gpa>) -> usize {
    a.len() + b.len() + c.len()
}

struct Cache<K, A: Allocator, S: BuildHasher> {
    slots: Vec<K, A>,
    hasher: S,
}

fn slots(c: &Cache<i64, Gpa>) -> usize {
    c.slots.len()
}

fn main(gpa: Gpa) {
    let m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    let t = HashSet::<i64, Gpa>::new_in(gpa);
    let c: Cache<i64, Gpa, FixedState> = Cache {
        slots: Vec::new_in(gpa), hasher: FixedState::new(),
    };
    println("{} {} {}", keys(&m), same(&s, &t), pick(&s, &t, &t));
    println("{} {}", bare(&s), slots(&c));
}
