pub mod Flags {
    pub const A: u32 = 1;
    pub const B: u32 = 2;
}

const LIMIT: u32 = 100;
const STEP: u32 = 7;

pub fn take(x: u32) -> u32 requires x != 0 { x }

pub fn below(x: u32) -> u32 requires x < LIMIT else "over the limit" { x + 1 }

pub fn grows(x: u32) -> u32
    requires x != 0 else "x is {x}"
    ensures result > x else "did not grow"
{
    x + 1
}

pub fn stepped(x: u32, step: u32 = STEP) -> u32 requires step != 0 { x + step - 3 }

pub fn generic<T>(x: u32, t: T) -> u32 requires x == Flags::B { x + 3 }

pub struct Counter { pub n: u32 }

impl Counter {
    pub fn add(self, x: u32) -> u32 requires x != 0 ensures result >= x { self.n + x }

    pub fn make(x: u32) -> Counter requires x < LIMIT { Counter { n: x } }
}
