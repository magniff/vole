// (0.25.2) A call of a function with a contract, from another module than
// the function's: the arguments (a path to a constant, a constant brought
// in by `use`, a default naming the callee's private constant) are
// resolved in the caller's module, the clauses in the callee's; requires,
// ensures, `else` messages, methods, generic functions, a `use` alias of
// the callee, and a module two levels deep.
// FLAGS: -O0
// EXPECT: 1 2 3 4 5 6 7 8
// EXPECT: 9 10 11 12
mod a;
mod b;
mod deep;

fn main() -> i32 {
    b::run();
    deep::inner::run();
    // (from the root module too)
    if a::take(a::Flags::A) != 1 {
        return 1;
    }
    0
}
