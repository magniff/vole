use crate::a::{Counter, Flags};

pub fn run() {
    let v9 = crate::a::take(Flags::A) + 8;
    let v10 = super::super::a::grows(crate::a::Flags::B) + 7;
    let v11 = Counter::add(Counter::make(Flags::A), Flags::B) + 8;
    let v12 = crate::a::generic::<i64>(Flags::B, 0) + 7;
    println("{v9} {v10} {v11} {v12}");
}
