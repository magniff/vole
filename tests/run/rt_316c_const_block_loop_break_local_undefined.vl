// XFAIL: RT-316: (RT-316's family, a loop with a break) `const C: i64 = { let mut s = 0; loop { s += 1; if s == 4 { break; } } s };` is refused, three times "undefined variable 's'"; rustc accepts it and prints the EXPECT line (0.30.2)
// From the re-review of g302copy-148 (form pre/q3). Since v0.30.1 at
// least; the release build the same. Siblings: rt_316 (`loop { break 6; }`),
// rt_316b (a while loop).
// EXPECT: 4
const C: i64 = {
    let mut s = 0;
    loop {
        s += 1;
        if s == 4 {
            break;
        }
    }
    s
};

fn main() {
    println("{}", C);
}
