// FLAGS: -C target-cpu=generic
// REQUIRES: metal
// EXPECT: true true true
// (0.28.0) std::arch::detect asks the running CPU: built for a generic
// Armv8.0, the answers for crc, aes and sha2 come from std's run-time word
// (std.vl: arch_init_macos, which main calls first), and every Apple
// silicon CPU has the three (REQUIRES: metal is aarch64-macos). A word
// nobody fills answers false, which arch_detect_run's output cannot show.
// The alias keeps the runner's second run (VOLE_ARCH_DISABLE=all, for
// sources that call the function by its name) away: there the answers are
// false by design.
use std::arch::detect as on_this_cpu;

fn main() {
    println("{} {} {}", on_this_cpu("crc"), on_this_cpu("aes"), on_this_cpu("sha2"));
}
