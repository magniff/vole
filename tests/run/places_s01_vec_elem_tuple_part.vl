// places IR, S1 (docs/design/places-ir.md 7.2): a part of a Vec element moves out: own.move_out, the IR's backstop behind it
// sem-own: `eat(w[0].1)` moves a part out of an element: own.move_out.
// ERROR: error[borrowck.move_out]
// ERROR: line 17, column 9
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut w: Vec<(i64, D<Gpa>), Gpa> = Vec::new_in(gpa);
    w.push((1, mk(1, gpa)));
    eat(w[0].1);
}
