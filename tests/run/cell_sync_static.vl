// (0.26.1) sync.static: an immutable static of a cell is not Sync; a
// `static var`, a thread-local and an atomic are fine.
// ERROR: [sync.static]: the static 'HITS' is not Sync: Cell<i64> holds a cell (std::cell), which is not Sync at '.value' (UnsafeCell<i64>)
// ERROR: try: volec explain sync.static
// ERROR-COUNT: 1
use std::cell::Cell;
use std::sync::atomic::AtomicU64; use std::sync::atomic::Ordering;

static HITS: Cell<i64> = Cell::new(0i64);
static OK: AtomicU64 = AtomicU64::new(0u64);
static mut MINE: Cell<i64> = Cell::new(0i64);
#[thread_local]
static mut LOCAL: Cell<i64> = Cell::new(0i64);

fn main() {
    unsafe { (*(&raw const MINE)).set(1) };
    unsafe { (*(&raw const LOCAL)).set(2) };
    OK.store(3u64, Ordering::SeqCst);
    println("{} {} {} {}", unsafe { (*(&raw const MINE)).get() },
        unsafe { (*(&raw const LOCAL)).get() }, OK.load(Ordering::SeqCst), HITS.get());
}
