// (0.26.1) sync.static: an immutable static of a cell is not Sync; a
// `static var`, a thread-local and an atomic are fine.
// ERROR: [sync.static]: the static 'HITS' is not Sync: Cell<i64> holds a cell (std::cell), which is not Sync at '.value' (UnsafeCell<i64>)
// ERROR: try: volec explain sync.static
// ERROR-COUNT: 1
use std::cell::Cell;
use std::sync::atomic::{AtomicU64, Ordering};

static HITS: Cell<i64> = Cell::new(0);
static OK: AtomicU64 = AtomicU64::new(0);
static var MINE: Cell<i64> = Cell::new(0);
#[thread_local]
static var LOCAL: Cell<i64> = Cell::new(0);

fn main() {
    MINE.set(1);
    LOCAL.set(2);
    OK.store(3, Ordering::SeqCst);
    println("{} {} {} {}", MINE.get(), LOCAL.get(), OK.load(Ordering::SeqCst), HITS.get());
}
