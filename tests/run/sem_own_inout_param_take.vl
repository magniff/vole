// sem-own: std::take/replace of an inout parameter: the taken value dropped once.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: now 0
// EXPECT: drop 0
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn f(d: inout D<Gpa>, gpa: Gpa) {
    let t = std::replace(&d, D { id: 0, v: Vec::new_in(gpa) }); println("got {}", t.id);
}

fn main(gpa: Gpa) {
    var a = mk(1, gpa);
    f(&a, gpa);
    println("now {}", a.id);
}
