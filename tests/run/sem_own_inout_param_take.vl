// XFAIL: gap 3: compile type error: expected 'inout D<Gpa>', got 'D<Gpa>'
// sem-own: std::take/replace of an inout parameter: the taken value dropped once.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: now 0
// EXPECT: drop 0
use std::mem; use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn f(d: &mut D<Gpa>, gpa: Gpa) {
    let t = mem::replace(&mut (d), (D { id: 0, v: Vec::new_in(gpa) })); println("got {}", t.id);
}

fn main(gpa: Gpa) {
    let mut a = mk(1, gpa);
    f(&mut a, gpa);
    println("now {}", a.id);
}
