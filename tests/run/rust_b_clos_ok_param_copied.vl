// EDITION: rust
// RULE: D20.3
// (0.27.2) A closure's parameter of a bound region is read, not kept: a
// copy of its referent goes into the capture.
// EXPECT: 9
struct H {
    v: i64,
}

fn main() {
    let mut h = H { v: 0 };
    let mut f = |p: &i64| {
        h.v = *p;
    };
    let b = 9;
    f(&b);
    println("{}", h.v);
}
