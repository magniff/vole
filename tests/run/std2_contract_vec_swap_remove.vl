// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): Vec::swap_remove's `requires i < self.len()`, violated last.
// EXPECT: 1
// EXIT: 101
// STDERR: requires failed: 'i < self.len()'
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::from_in([1, 2, 3], gpa);
    println("{}", v.swap_remove(0));
    v.swap_remove(5);
}
