// (re-review of M2, C2, form c05) `Self::Out` in the text of `trait Sub:
// TrA + TrB`, both declaring Out: rustc's E0221 (d7f4aba3e took TrA's, the
// first supertrait found; v0.30.1 called it ambiguous by the type's impls).
// ERROR: is ambiguous: more than one supertrait of 'Sub' declares it
// ERROR-COUNT: 1
trait TrA {
    type Out;
}

trait TrB {
    type Out;
}

trait Sub: TrA + TrB {
    fn sz(&self) -> usize {
        std::mem::size_of::<Self::Out>()
    }
}

struct W;

impl TrA for W {
    type Out = i64;
}

impl TrB for W {
    type Out = u8;
}

impl Sub for W {}

fn main() {
    println("{}", W.sz());
}
