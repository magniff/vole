// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a20 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 3
// EXPECT: 1
trait Has { type Out: TA; fn get(&self) -> Self::Out; }
trait TA { fn m(&self) -> i64; }
struct S { k: i64 }
impl S { fn m(&self) -> i64 { 3 } }
impl TA for S { fn m(&self) -> i64 { 1 } }
struct H;
impl Has for H { type Out = S; fn get(&self) -> S { S { k: 0 } } }
fn g<X: Has>(x: &X) -> i64 { x.get().m() }
fn main() { println("{}", g(&H)); }
