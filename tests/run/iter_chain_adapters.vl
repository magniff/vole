// EDITION: rust
// XFAIL: gap 4: compile type error: expected 'usize', got 'i64'
// The Iterator trait's adapters and consumers on std's sources (0.14):
// map, filter, enumerate, zip, take, sum, count, min, max, fold,
// collect, and `for` over a chain (the `next` path).
// EXPECT: map 81 filter 5 range 220
// EXPECT: enumerate 66 zip 93
// EXPECT: max 9 min 1 empty 1
// EXPECT: take 5 1 9 | 18 6
// EXPECT: collect 6 90 | 0 1 2 3 4
// EXPECT: chain 0:5 2:9 4:7
// EXPECT: u8 32640 6
fn show(label: &str, x: i64) {
    print("{}", label);
    print("{}", x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    v.push(2);

    show("map ", v.iter().copied().map(|x| x * 3).sum::<i64>());
    show(" filter ", v.iter().copied().filter(|x| ({ let x = *x; x % 2 == 1 })).count() as i64);
    show(" range ",
        ((1i64..=10i64)).filter(|x| ({ let x = *x; x % 2 == 0 })).map(|x| x * x).sum::<i64>());
    println("");

    show("enumerate ", v.iter().copied().enumerate().map(|(i, x)| i * x).sum::<i64>());
    show(" zip ",
        v.iter().copied().zip((0i64..6i64).map(|k| k + 1)).fold(0i64, |acc, (x, y)| acc + x * y));
    println("");

    show("max ", v.iter().copied().max().unwrap());
    show(" min ", v.iter().copied().min().unwrap());
    show(" empty ", (0i64..0i64).max().is_none() as i64);
    println("");

    print("take");
    for x in v.iter().copied().take(3usize) {
        show(" ", x);
    }
    show(" | ", v.iter().copied().take(4usize).sum::<i64>());
    show(" ", v.iter().copied().take(100usize).count() as i64);
    println("");

    let mut w = v.iter().copied().map(|x| x * 10).collect_in::<Vec<i64, Gpa>, _>(gpa);
    show("collect ", w.len() as i64);
    show(" ", w[2usize]);
    print(" |");
    let mut r = ((0i64..5i64)).collect_in::<Vec<i64, Gpa>, _>(gpa);
    for x in r {
        show(" ", x);
    }
    println("");

    print("chain");
    for (i, x) in v.iter().copied().enumerate().filter(|x| ({ let p = *x; p.1 > 4 })) {
        show(" ", i);
        show(":", x);
    }
    println("");

    show("u8 ", (0..=255u8).map(|x| x as i64).sum::<i64>());
    show(" ", (250..=255u8).count() as i64);
    println("");
    0
}
