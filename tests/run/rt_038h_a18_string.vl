// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a18_string)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A String parameter: the callee writes its bytes.
fn poke(s: &String<Gpa>) -> bool {
    let p = s.as_ptr() as *mut u8;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 90u8; }
    true
}

fn f(s: &String<Gpa>) -> i64
    requires poke(s)
{
    1
}

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    println("{}", f(&s));
    println("{}", s);
}
