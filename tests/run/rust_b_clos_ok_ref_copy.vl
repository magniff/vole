// EDITION: rust
// RULE: D19.2
// (0.27.2) An immutable `Copy` variable the body only reads is captured by
// `&`: once the closure is dead it may be assigned.
// EXPECT: 3 3
fn main() {
    let mut k = 1;
    let f = || k + 2;
    let a = f();
    k = 2;
    println("{} {}", a, k + 1);
}
