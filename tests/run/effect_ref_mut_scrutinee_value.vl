// (0.30.1, RT-20) A `ref mut` binding writes the place it binds into: a
// counted `while`'s variable matched so is written, and the loop is
// `diverge` (err_effect_counted_while_ref_mut). A value the pattern binds
// into (a call's result, a tuple, a literal) is a temporary: the counter
// in it is only read, and the loop still ends. A 0.30.1 draft refused
// these; rustc accepts them and prints what this does. (`let (ref mut
// a, _) = (i, 0);` is refused by borrowck, a temporary dropped while
// borrowed, which rustc accepts: a separate bug.)
// EXPECT: 6 6
// EXPECT: 3

fn wrap(x: i64) -> Option<i64> {
    Some(x)
}

#[effects()]
fn r1(n: i64) -> i64 {
    let mut i = 0;
    let mut s = 0;
    while i < n {
        if let Some(ref mut x) = wrap(i) {
            *x += 1;
            s += *x;
        }
        i += 1;
    }
    s
}

#[effects()]
fn r3(n: i64) -> i64 {
    let mut i = 0;
    let mut s = 0;
    while i < n {
        match (i, 1) {
            (ref mut a, b) => {
                *a += b;
                s += *a;
            }
        }
        i += 1;
    }
    s
}

#[effects()]
fn l21(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        if let (ref mut a, 0) = (i, 0) {
            *a = 0;
        }
        i += 1;
    }
    i
}

fn main() {
    println("{} {}", r1(3), r3(3));
    println("{}", l21(3));
}
