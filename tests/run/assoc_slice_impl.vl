// EDITION: rust
// XFAIL: gap 17: compile format.args: a format string is a literal: this argument has no hole to go to
// EXPECT: 20 b
// EXPECT: 3 2
// EXPECT: 6
// 0.14: impls for slices: `impl<T> [T] { ... }` (methods of every slice
// type) and `impl<T> Tr for [T]`.

impl<T> &[T] {
    fn second(self: &[T]) -> T {
        self[1]
    }

    fn count_if_len(self: &[T], n: i64) -> i64 {
        if self.len() as i64 == n { 1 } else { 0 }
    }
}

trait Size {
    fn size(&self) -> i64;

    fn twice(&self) -> i64 {
        2 * self.size()
    }
}

impl<T> Size for &[T] {
    fn size(self: &[T]) -> i64 {
        self.len() as i64
    }
}

fn size_of_it<S: Size>(s: S) -> i64 {
    s.size()
}

fn main() -> i32 {
    let a: [i64; 3] = [10i64, 20, 30];
    let s = &a[0..3];
    let t = "abc";
    print("{}", s.second());
    print(" ");
    let b = [t.as_bytes().second()];
    print("{}", &"{}", str::from_utf8(b[0..1]).unwrap());
    println("");
    print("{}", s.size());
    print(" ");
    print("{}", size_of_it(&t[0..2]));
    println("");
    print("{}", (s.twice() + s.count_if_len(3) - 1));
    println("");
    0
}
