// (0.30.2, RT-466's family) x86-64 reaches a frame's slots with 32-bit
// displacements: its limit is 2 GiB less a page, where AArch64's is 2^61
// bytes. Two locals of 1.5 GiB: each fits, their sum does not, refused
// at the second for x86-64 (and built for AArch64, where it fits).
// FLAGS: --target x86_64-macos
// ERROR: frame.too_big
// ERROR: line 12, column 13
#[inline(never)]
fn two(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 3usize << 29];
        let b = [1u8; 3usize << 29];
        return a[n] + b[n];
    }
    0
}

fn main() {
    let n = std::env::args().count();
    println("{}", two(n));
}
