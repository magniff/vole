// XFAIL: RT-475d: (RT-475's mechanism, an impl for the reference) with `impl L for &[i64] { fn len(&self) -> i64 { 9 } }`, `s.len()` of an `s: &[i64]` runs L's: vole prints `9 9`; rustc takes the slice's inherent len at the first step (its `&self` is `&[i64]`, L's needs `&&[i64]`) and prints `3 9` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p07d_slice_ref_impl_len.
// EXPECT: 3 9
trait L {
    fn len(&self) -> i64;
}

impl<'a> L for &'a [i64] {
    fn len(&self) -> i64 {
        9
    }
}

fn main() -> i32 {
    let a = [1i64, 2, 3];
    let s: &[i64] = &a;
    let n1 = s.len();
    let n2 = (&s).len();
    println("{} {}", n1, n2);
    0
}
