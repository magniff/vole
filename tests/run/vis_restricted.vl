// 0.26.2: `pub(crate)`, `pub(super)`, `pub(self)` and `pub(in path)` on
// items, fields, a `use` re-export and a module: each visible up to the
// module it names (`self`: private), as Rust's.
// EXPECT: 46
mod outer {
    pub mod a {
        pub(crate) fn crate_fn() -> i64 { 1 }
        pub(super) fn super_fn() -> i64 { 2 }
        pub(self) fn self_fn() -> i64 { 3 }
        pub(in crate::outer) fn in_fn() -> i64 { 4 }
        pub struct S { pub(crate) c: i64, pub(super) s: i64, pub(in crate::outer) i: i64 }
        pub fn make() -> S { S { c: 1, s: 2, i: 3 } }
        pub fn local() -> i64 { self_fn() }
        pub(crate) use super::b::helper;
    }

    pub mod b {
        pub fn helper() -> i64 { 10 }

        pub fn peek() -> i64 {
            super::a::super_fn() + super::a::in_fn() + super::a::make().s + super::a::make().i
        }
    }

    pub(crate) mod c {
        pub fn cfn() -> i64 { 20 }
    }
}

fn main() -> i32 {
    let t = outer::a::crate_fn() + outer::b::peek() + outer::a::make().c + outer::a::local()
        + outer::a::helper() + outer::c::cfn();
    println(t);
    0
}
