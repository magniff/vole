// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::option Option::xor.
// EXPECT: None Some(1) Some(2) None
use std::option::Option;

fn main() {
    let none: Option<i64> = None;
    println("{:?} {:?} {:?} {:?}", Some(1).xor(Some(2)), Some(1).xor(none), none.xor(Some(2)),
        none.xor(none));
}
