// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Div::div.
// EXPECT: V { x: 2 } 2
use std::ops::Div;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Div for V {
    type Output = V;

    fn div(self, rhs: V) -> V {
        V { x: self.x / rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.div(b), Div::div(12i64, 5));
}
