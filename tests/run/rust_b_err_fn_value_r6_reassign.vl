// RULE: R6
// (0.30.2) A body whose bound's input is the call's own region (`F:
// Fn(&i64) -> K`) is checked by its bound only where it calls the
// parameter its caller gave, unchanged: one the body assigns (`f = a`), or
// borrows so that it may be written (a closure that assigns it, a `ref
// mut` pattern), may hold any `fn` value of type F (here `fs[0]`, a `fn
// (&i64) -> &'static i64` holding idr2), and its call is read as R6 reads
// the erased type: each `f(&l[0])` returning a borrow of the local l is
// refused in the body (reported at the body's result). Without that restriction each built, and
// --check-alloc stopped with a use after free.
// FLAGS: --check-alloc
// ERROR: error[borrowck.return_local]
// ERROR: line 27
// ERROR: line 37
// ERROR: line 46
// ERROR-COUNT: 3
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn klb<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    let mut set = || {
        f = fs[0];
    };
    set();
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn klc<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    match f {
        ref mut g => *g = fs[0],
    }
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn kld<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    let (a, _b) = (fs[0], 0);
    f = a;
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn main(gpa: Gpa) {
    let p: fn(&i64) -> &'static i64 = idr2;
    let rb = klb::<&'static i64, fn(&i64) -> &'static i64>(st, &[p], gpa);
    let rc = klc::<&'static i64, fn(&i64) -> &'static i64>(st, &[p], gpa);
    let rd = kld::<&'static i64, fn(&i64) -> &'static i64>(st, &[p], gpa);
    println("{} {} {}", rb, rc, rd);
}
