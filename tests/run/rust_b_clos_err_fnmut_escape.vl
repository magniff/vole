// RULE: D19.10
// (0.27.2) An `FnMut` closure returning a reference into its `&mut`
// capture: the loan is supported by the env's 'e, which is the call's
// ("captured variable cannot escape `FnMut` closure body").
// ERROR: error[borrowck.outlives]
fn main() {
    let mut v = 1;
    let mut f = || &mut v;
    *f() += 1;
    println("{}", v);
}
