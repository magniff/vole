// (0.30.2, RT-83) -O0 on x86-64: an argument aligned above 16 passed on the
// stack moves the pushed temporaries down to an aligned area
// (x64_realign_pushed). That decrement goes through x64_frame_reserve as
// every other one does: probed when it can reach a page (here 4096 bytes
// of area + 4080 of alignment), not safe only because alignment is capped
// at 4096 elsewhere. Before, `movq %r11, %rsp` moved rsp unprobed. The
// value arrives aligned and whole (6).
// EXPECT: 6
// CHECK-OPT: 0
// CROSS: x86_64-linux
// ASM(x86_64-linux): vole.pass:
// ASM(x86_64-linux): call memcpy
// ASM(x86_64-linux): call memcpy
// ASM(x86_64-linux): cmovbq %r10, %r11
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): addq $4096, %rsp
// ASM(x86_64-linux): cmovbq %r10, %r11
// ASM(x86_64-linux): call vole.take
#[repr(C, align(4096))]
#[derive(Clone, Copy)]
struct Page {
    v: [i64; 4],
}

#[inline(never)]
fn take(n: i64, p: Page) -> i64 {
    n + p.v[0] + p.v[3] + (&p as *const Page as usize % 4096) as i64
}

#[inline(never)]
fn pass(p: &Page, n: i64) -> i64 {
    take(n, *p)
}

fn main() {
    let p = Page { v: [1, 2, 3, 4] };
    println("{}", pass(&p, std::env::args().count() as i64));
}
