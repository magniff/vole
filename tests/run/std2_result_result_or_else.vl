// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::result Result::or_else.
// EXPECT: Ok(3) Ok(3) Err(3)
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let c: Result<i64, &str> = Err("bad");
    println("{:?} {:?} {:?}", a.or_else(|e| Ok::<i64, usize>(e.len() as i64)),
        b.or_else(|e| Ok::<i64, usize>(e.len() as i64)), c.or_else(|e| Err::<i64, usize>(e.len())));
}
