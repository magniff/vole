// Runs on std since 0.27.2's switch.
// The std item(s): std::slice [T]::get_mut.
// EXPECT: [1, 20, 3] true
use std::slice::SliceIndex;

fn main() {
    let mut a = [1, 2, 3];
    if let Some(x) = a.get_mut(1) {
        *x = 20;
    }
    let none = a.get_mut(9).is_none();
    println("{:?} {}", a, none);
}
