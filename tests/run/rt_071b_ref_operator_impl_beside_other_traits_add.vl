// XFAIL: RT-71b: (RT-71's mechanism, with another trait's `add` for `&S` beside) `&a + &b` with `impl Add<&S> for &S` and `impl Join for &S` (a `fn add(self, o: &S) -> S` returning k 999) is refused, "arithmetic operator requires numeric type, got '&S'"; rustc runs Add's add and prints 7 (0.30.2)
// From the paused g302index work (its rc4/i2). Since v0.30.1 at least
// (the same error). A fix of RT-71 must take Add's impl, not the other
// trait's method by its name (RT-149's family): this case prints 999
// then.
// EXPECT: 7
use std::ops::Add;

trait Join {
    fn add(self, o: &S) -> S;
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl<'a> Join for &'a S {
    fn add(self, o: &S) -> S {
        S { k: 999 }
    }
}

impl<'a> Add<&'a S> for &'a S {
    type Output = S;

    fn add(self, o: &S) -> S {
        S { k: self.k + o.k }
    }
}

fn main() {
    let a = S { k: 3 };
    let b = S { k: 4 };
    println("{}", (&a + &b).k);
}
