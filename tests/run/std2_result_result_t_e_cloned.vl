// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result<&T, E>::cloned.
// EXPECT: Ok("ab")
use std::result::Result;

fn main(gpa: Gpa) {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let s = "ab".to_string_in(gpa);
    let c: Result<&String<Gpa>, i64> = Ok(&s);
    let d: Result<String<Gpa>, i64> = c.cloned();
    println("{:?}", d);
}
