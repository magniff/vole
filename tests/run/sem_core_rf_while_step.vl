// a while loop stepping by 3 to the length: 0, 3, 6 only.
// EXPECT: 9
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64]) -> i64 {
    let mut t: i64 = 0; let mut i: i64 = 0;
    while i <= s.len() as i64 { t += s[i as usize]; i += 3; } t
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s));
    0
}
