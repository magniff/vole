// RULE: D7.4
// (0.27.6) std2's `write(w, ..)` with a writer place that is no reference
// is Rust's `write!(w, ..)`: `w.write_fmt(..)`, its autoref'd receiver
// two-phase, so the arguments read what holds `w` before the write
// (`write(self.emsg, "{}", self.name())`). Before, the autoref was an
// ordinary `&mut`, and the read was borrowck.conflict.
// EXPECT: 'ab' 2 4
use std::alloc::{Allocator, Gpa};
use std::io::Write;

struct F<'a, A: Allocator> {
    src: &'a [u8],
    emsg: Vec<u8, A>,
}

impl<'a, A: Allocator> F<'a, A> {
    fn text(&self) -> &'a [u8] {
        self.src
    }

    fn len(&self) -> usize {
        self.src.len()
    }

    fn go(&mut self) {
        write(self.emsg, "'{}'", str::from_utf8(self.text()).unwrap()).unwrap();
        writeln(self.emsg, " {} {}", self.len(), self.emsg.len()).unwrap();
    }
}

fn main(gpa: Gpa) {
    let mut f = F { src: b"ab", emsg: Vec::new_in(gpa) };
    f.go();
    print("{}", str::from_utf8(&f.emsg).unwrap());
}
