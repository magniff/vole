// EDITION: rust
// RULE: Z9.1b
// (0.27.3) A type parameter without `?Sized` bound to a view is a
// reference, `&[u8]` or `&str`: `&mut R` is a reference to it (Z9.1b (c)),
// so `*r = ..` and a `&mut self` method through it change the caller's.
// EXPECT: [2, 3] 1
// EXPECT: b
trait Step {
    fn step(&mut self) -> u8;
}

impl Step for &[u8] {
    fn step(&mut self) -> u8 {
        let x = self[0];
        *self = &self[1..];
        x
    }
}

fn first<R: Step>(r: &mut R) -> u8 {
    r.step()
}

fn put<T>(slot: &mut T, v: T) {
    *slot = v;
}

fn main() {
    let d: &[u8] = &[1, 2, 3];
    let mut r = d;
    let x = first(&mut r);
    println("{:?} {}", r, x);
    let mut s = "a";
    put(&mut s, "b");
    println("{}", s);
}
