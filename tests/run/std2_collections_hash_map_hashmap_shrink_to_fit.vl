// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::shrink_to_fit.
// EXPECT: true true Some(1)
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::with_capacity_in(100, gpa);
    m.insert(1, 1);
    m.shrink_to_fit();
    println("{} {} {:?}", m.capacity() < 100, m.capacity() >= 1, m.get(&1));
}
