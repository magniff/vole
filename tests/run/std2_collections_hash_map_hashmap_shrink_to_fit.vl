// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::shrink_to_fit.
// EXPECT: true true Some(1)
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::with_capacity_in(100, gpa);
    m.insert(1, 1);
    m.shrink_to_fit();
    println("{} {} {:?}", m.capacity() < 100, m.capacity() >= 1, m.get(&1));
}
