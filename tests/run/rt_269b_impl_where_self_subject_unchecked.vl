// RT-269, fixed in 0.30.2 (obligations M2).
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// RT-269 with the subject written `Self`.
// There is no impl of Conv at all, so `W: Tr<i64>` does not hold. rustc
// refuses the call (E0277: the trait bound `W: Tr<i64>` is not
// satisfied); vole builds it and prints 1: a `where` predicate whose
// subject is a concrete type (not one of the impl's parameters) is never
// required where the impl is chosen. The body cannot use it (a call of
// Conv's method through it is refused), so this is an over-acceptance,
// with no unsound use found.
// ERROR: is not implemented
// ERROR: line 38, column 19
// ERROR-COUNT: 1
trait Conv<X> {}

trait Tr<U> {
    fn f(&self) -> i64;
}

struct W {
    r: i64,
}

impl<U> Tr<U> for W
    where
        Self: Conv<U>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn need<T: Tr<i64>>(t: &T) -> i64 {
    t.f()
}

fn main() {
    println("{}", need(&W { r: 0 }));
}
