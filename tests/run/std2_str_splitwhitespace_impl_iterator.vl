// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str SplitWhitespace::impl Iterator.
// EXPECT: ["a", "b", "c"] 0
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = " a \t b\u{3000}c\n".split_whitespace().collect_in(gpa);
    let mut n = 0;
    for _ in "   ".split_whitespace() {
        n += 1;
    }
    println("{:?} {}", v, n);
}
