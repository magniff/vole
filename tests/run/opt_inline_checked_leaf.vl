fn at(s: &[i64], i: i64) -> i64 {
    s[i as usize]
}

#[inline(never)]
fn pick(s: &[i64], i: i64, j: i64) -> i64 {
    at(s, i) * 10 + at(s, j) + (spend1(1) & 1)
}

fn main() -> i32 {
    let n: i64 = 2;
    let mut spent = spend1(n);
    spent = spent.wrapping_add(spend2(n));
    spent = spent.wrapping_add(spend3(n));
    spent = spent.wrapping_add(spend4(n));
    spent = spent.wrapping_add(spend5(n));
    spent = spent.wrapping_add(spend6(n));
    spent = spent.wrapping_add(spend7(n));
    spent = spent.wrapping_add(spend8(n));
    let s: [i64; 4] = [1, 2, 3, 4];
    unsafe { printf(c"%ld %ld\n", pick(&s[..], 1, 3), spent & 1); }
    0
}
