// (0.29) A function whose only call is a failed check's report, in a
// panic block, is still a leaf for the inliner, and the block is not part
// of its size: `at` is six instructions (the compare and branch of the
// check, the address, the load, the return) and is inlined whatever the
// program's budget, as a small leaf is. The eight `spend` functions use
// the budget up first (each inlines `work` four times: the program grows
// by more than half of itself and 2000), and `pick`, above them in the
// call graph, is optimized after them. With the report counted, `at` was
// neither small nor a leaf, and its calls stayed.
// EXPECT: 25 0
// CHECK: fn pick:
// CHECK-NOT: call at
// CHECK: call spend1
// CHECK: fn main:
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

// About a hundred instructions, no call: inlined at a call in two loops
// (the threshold there is 120), four times in each of the eight below.
fn work(a: i64, b: i64) -> i64 {
    let mut t = a.wrapping_mul(31).wrapping_add(b);
    t = (t ^ (t >> 3)).wrapping_mul(33).wrapping_add(a ^ 1);
    t = (t ^ (t >> 4)).wrapping_mul(35).wrapping_add(a ^ 2);
    t = (t ^ (t >> 5)).wrapping_mul(37).wrapping_add(a ^ 3);
    t = (t ^ (t >> 6)).wrapping_mul(39).wrapping_add(a ^ 4);
    t = (t ^ (t >> 7)).wrapping_mul(41).wrapping_add(a ^ 5);
    t = (t ^ (t >> 3)).wrapping_mul(43).wrapping_add(a ^ 6);
    t = (t ^ (t >> 4)).wrapping_mul(45).wrapping_add(a ^ 7);
    t = (t ^ (t >> 5)).wrapping_mul(47).wrapping_add(a ^ 8);
    t = (t ^ (t >> 6)).wrapping_mul(49).wrapping_add(a ^ 9);
    t = (t ^ (t >> 7)).wrapping_mul(51).wrapping_add(a ^ 10);
    t = (t ^ (t >> 3)).wrapping_mul(53).wrapping_add(a ^ 11);
    t = (t ^ (t >> 4)).wrapping_mul(55).wrapping_add(a ^ 12);
    t = (t ^ (t >> 5)).wrapping_mul(57).wrapping_add(a ^ 13);
    t = (t ^ (t >> 6)).wrapping_mul(59).wrapping_add(a ^ 14);
    t = (t ^ (t >> 7)).wrapping_mul(61).wrapping_add(a ^ 15);
    t = (t ^ (t >> 3)).wrapping_mul(63).wrapping_add(a ^ 16);
    t = (t ^ (t >> 4)).wrapping_mul(65).wrapping_add(a ^ 17);
    t = (t ^ (t >> 5)).wrapping_mul(67).wrapping_add(a ^ 18);
    t
}

#[inline(never)]
fn spend1(n: i64) -> i64 {
    let mut s: i64 = 1;
    for i in 0..n {
        for j in 0..n {
            s = s.wrapping_add(work(i, j + 1));
            s ^= work(j, i + 1);
            s = s.wrapping_add(work(i + 1, j));
            s ^= work(j + 1, i);
        }
    }
    s
}

