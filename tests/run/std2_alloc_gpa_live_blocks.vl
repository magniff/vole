// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Gpa::live_blocks.
// EXPECT: true
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let before = gpa.live_blocks();
    let v = Vec::from_in([1, 2, 3], gpa);
    let during = gpa.live_blocks();
    drop(v);
    println("{}", during >= before);
}
