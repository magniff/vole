// EDITION: rust
// XFAIL: gap 2: compile type error: undefined variable 'trim'
// 0.18.1: std's priority queues, BinaryHeap (largest first) and MinHeap
// (smallest first), in the prelude: push, pop, peek, from_vec,
// into_sorted_vec, clear, owned elements (dropped once: --check-alloc),
// tuples and text as elements.
// FLAGS: --check-alloc
// EXPECT: len 7 peek 9
// EXPECT: 9 8 8 5 3 2 1
// EXPECT: (0,2) (2,7) (4,0) (4,1)
// EXPECT: 1 1 2 3 4 5 6 9
// EXPECT: min 1 8 1
// EXPECT: 1 1 2 3 4 5 6 9
// EXPECT: true true true
// EXPECT: 2 2 4
// EXPECT: 1 true
// EXPECT: apple fig pear
// EXPECT: 9 7 5 3
// EXPECT: ok 2000
// (0.26.4) Its PRNG and checksums are written wrapping_*.
use std::alloc::Allocator; struct Job<A: Allocator> { pri: i64, data: Vec<i64, A> }

impl PartialEq for Job<Gpa> {
    fn eq(&self, o: &Job<Gpa>) -> bool { self.pri == o.pri }
} impl Eq for Job<Gpa> {}

impl Ord for Job<Gpa> {
    fn cmp(&self, o: &Job<Gpa>) -> std::cmp::Ordering { ({ self.pri - o.pri }).cmp(&0) }
} impl PartialOrd for Job<Gpa> {
    fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(self.cmp(o)) }
}

fn show(v: &Vec<i64, Gpa>) {
    let mut b = String::new_in(*v.allocator());
    for x in v.iter().copied() {
        std::fmt::write(&mut b, "{x} ").unwrap();
    }
    println("{}", str::from_utf8(trim(b.as_bytes())).unwrap());
}

fn main(gpa: Gpa) -> i32 {
    let mut h: BinaryHeap<i64, Gpa> = BinaryHeap::new_in(gpa);
    for x in [5i64, 1, 8, 3, 9, 2, 8] {
        h.push(x);
    }
    println("len {} peek {}", h.len(), h.peek().unwrap());
    let mut out: Vec<i64, Gpa> = Vec::new_in(gpa);
    while let Some(x) = h.pop() {
        out.push(x);
    }
    show(&out);

    let mut m: MinHeap<(i64, i64), Gpa> = MinHeap::with_capacity_in(4usize, gpa);
    m.push((4, 1));
    m.push((0, 2));
    m.push((4, 0));
    m.push((2, 7));
    let mut b = String::new_in(gpa);
    while let Some((d, u)) = m.pop() {
        std::fmt::write(&mut b, "({d},{u}) ").unwrap();
    }
    println("{}", str::from_utf8(trim(b.as_bytes())).unwrap());

    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in [3i64, 1, 4, 1, 5, 9, 2, 6] {
        v.push(x);
    }
    let w = v.clone();
    let sorted = BinaryHeap::from_vec(v).into_sorted_vec();
    show(&sorted);
    let mh = MinHeap::from_vec(w);
    println("min {} {} {}", mh.peek().unwrap(), mh.as_slice().len(), mh.as_slice()[0]);
    let sorted2 = mh.into_sorted_vec();
    show(&sorted2);

    let mut e: MinHeap<i64, Gpa> = MinHeap::new_in(gpa);
    println("{} {} {}", e.is_empty(), e.pop().is_none(), e.peek().is_none());

    // owned elements: each dropped once
    let mut t: BinaryHeap<Job<Gpa>, Gpa> = BinaryHeap::new_in(gpa);
    for k in 0..5 {
        let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
        x.push(k);
        t.push(Job { pri: k % 3, data: x });
    }
    if let Some(j) = t.peek() {
        print("{} ", j.pri);
    }
    let top = t.pop().unwrap();
    println("{} {}", top.data[0], t.len());
    let mut t2 = t;
    t2.clear();
    t2.push(Job { pri: 1, data: Vec::new_in(gpa) });
    println("{} {}", t2.len(), t2.capacity() >= 1);

    let mut words: MinHeap<&[u8], Gpa> = MinHeap::new_in(gpa);
    words.push("pear");
    words.push("apple");
    words.push("fig");
    let mut wb = Vec::<u8, Gpa>::new_in(gpa);
    while let Some(s) = words.pop() {
        wb.extend_from_slice(s);
        wb.push(b' ');
    }
    println("{}", str::from_utf8(trim(wb.as_slice())).unwrap());

    let mut odd: BinaryHeap<i64, Gpa> = BinaryHeap::new_in(gpa);
    for x in [3i64, 9, 5, 7] {
        odd.push(x);
    }
    let raw = odd.into_vec();
    show(&raw);

    // many: against a sort
    let mut state = 7u64;
    let mut big: MinHeap<i64, Gpa> = MinHeap::new_in(gpa);
    let mut all: Vec<i64, Gpa> = Vec::new_in(gpa);
    for _ in 0..2000 {
        state = state.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        let x = (state >> 40) as i64 % 500;
        big.push(x);
        all.push(x);
    }
    all.sort_unstable();
    let mut same = true;
    for i in 0..all.len() {
        if big.pop().unwrap() != all[i] {
            same = false;
        }
    }
    println("{} {}", if same { "ok" } else { "bad" }, all.len());
    0
}
