// RULE: Z9.1c
// (0.27.5) `.as_ref()` bound to a `&[u8]` through a `&&str`: by the
// method's probe, a parameter `c: &&str`, and a generic receiver with
// `C = &&str` (the impl for `&T` twice, T = &str, then T = str).
// EXPECT: 4 4 4 6
fn direct(c: &&str) -> usize {
    let b: &[u8] = c.as_ref();
    b.len()
}

fn bytes<C: AsRef<[u8]>>(c: C) -> usize {
    let b: &[u8] = c.as_ref();
    b.len()
}

fn main() {
    let s: &str = "abcd";
    let r: &&str = &s;
    let t: &str = "abcdef";
    println("{} {} {} {}", direct(r), bytes(r), bytes(&s), bytes(&&t));
}
