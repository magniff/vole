// EDITION: rust
// RULE: D2.5
// (0.27.1) Overwriting the `&mut` reference `m` while `&mut *m` is live: a
// Shallow write through Extends-deref does not conflict.

fn main() {
    let mut x: i64 = 1;
    let mut y: i64 = 10;
    let mut m = &mut x;
    let p = &mut *m;
    m = &mut y;
    *p += 1;
    *m += 1;
    println("{} {}", x, y);
}
// EXPECT: 2 11
