// The std2 item(s): std::env current_dir_in; std::env set_current_dir.
// EXPECT: true
// EXPECT: true
// EXPECT: NotFound
use std::env;

fn main(gpa: Gpa) {
    let d = env::current_dir_in(gpa).unwrap();
    println("{}", d.starts_with("/"));
    env::set_current_dir("/tmp").unwrap();
    println("{}", env::current_dir_in(gpa).unwrap().ends_with("tmp"));
    let e = env::set_current_dir("/no/such/dir").unwrap_err();
    println("{:?}", e.kind());
}
