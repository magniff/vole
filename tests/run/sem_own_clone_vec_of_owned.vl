// EDITION: rust
// sem-own: Vec<D>::clone clones each element: both dropped once.
// EXPECT: 2 2
// EXPECT: end
// EXPECT: drop 11
// EXPECT: drop 12
// EXPECT: drop 1
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
impl Clone for D<Gpa> { fn clone(&self) -> D<Gpa> { D { id: self.id + 10, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    v.push(mk(2, gpa));
    let w = v.clone();
    println("{} {}", v.len(), w.len());
    println("end");
}
