// RULE: F8.3, F8.4
// `<W<_> as Conv<_, u8>>::c(true)` with W generic: the self type's hole from the expected type, the trait's from the call, u8 as written (rustc 2 1)
// From the second round of the qualified paths: the arguments a path writes beside a `_` choose the impl; fails on v0.30.1 ("ambiguous").
// EXPECT: 2 1
trait Conv<A, B> {
    fn c(x: A) -> Self;
}

struct W<U> {
    u: i64,
    p: Option<U>,
}

impl<U> Conv<bool, i64> for W<U> {
    fn c(x: bool) -> W<U> {
        W { u: 1, p: None }
    }
}

impl<U> Conv<bool, u8> for W<U> {
    fn c(x: bool) -> W<U> {
        W { u: 2, p: None }
    }
}

fn main() {
    let a: W<u8> = <W<_> as Conv<_, u8>>::c(true);
    let b: W<u8> = <W<u8> as Conv<_, i64>>::c(true);
    println("{} {}", a.u, b.u);
}
