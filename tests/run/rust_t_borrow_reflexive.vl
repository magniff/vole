// EDITION: rust
// RULE: Z9.1c, F13.4
// (0.28.0, gap 59) `K: Borrow<K>` with K = `&str`: the reflexive `impl<T>
// Borrow<T> for T` by the bound, for `k.borrow()` and `<K as
// Borrow<Q>>::borrow(k)` of a `k: &K` (it took str's, and gave a `&str`
// where a `&&str` goes); with Q = str, `impl Borrow<T> for &T`.
use std::borrow::Borrow;

fn same<K: Borrow<K> + PartialEq>(k: &K, o: &K) -> bool {
    let b: &K = k.borrow();
    b == o
}

fn same2<K: Borrow<Q>, Q: PartialEq + ?Sized>(k: &K, o: &Q) -> bool {
    let b: &Q = <K as Borrow<Q>>::borrow(k);
    b == o
}

fn same3<K: Borrow<Q>, Q: PartialEq + ?Sized>(k: K, o: &Q) -> bool { k.borrow() == o }

fn main() {
    let a = "x";
    let n = 4i64;
    println("{} {}", same(&a, &a), same(&n, &5));
    println("{} {}", same2::<&str, &str>(&a, &a), same2::<&str, str>(&a, "y"));
    println("{} {}", same3::<&str, &str>(a, &a), same3::<&str, str>(a, a));
}
// EXPECT: true false
// EXPECT: true false
// EXPECT: true true
