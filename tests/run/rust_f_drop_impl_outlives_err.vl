// (0.30.1, review 7) A Drop impl may assume no outlives of its type's:
// nothing proves them where a value is built (RT-37). Round 7 trusted the
// declaration's `where 'b: 'c` (h09), its inline `'b: 'c` (h10, a hole
// on every build), and what its fields implied, read from their text: an
// alias that drops its lifetime, `&'c K<'b>` with `type K<'x> = u8` or
// `= Z` (h01, h13), and `&'c &'b u8` (h14). Each `drop` pushed a dropped
// String's str into a longer-lived Vec: a use after free (rustc E0367 for
// h01 and h13, E0597 at the literal for h09, h10, h14). Each is refused.
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR-COUNT: 5
use std::alloc::Allocator;

type K<'x> = u8;

struct Sa<'o, 'b, 'c, A: Allocator> { k: &'c K<'b>, out: &'o mut Vec<&'c str, A>, s: &'b str }

impl<'o, 'b: 'c, 'c, A: Allocator> Drop for Sa<'o, 'b, 'c, A> {
    fn drop(&mut self) { self.out.push(self.s); }
}

struct Z { z: u8 }
type Kz<'x> = Z;

struct Sz<'o, 'b, 'c, A: Allocator> { k: &'c Kz<'b>, out: &'o mut Vec<&'c str, A>, s: &'b str }

impl<'o, 'b: 'c, 'c, A: Allocator> Drop for Sz<'o, 'b, 'c, A> {
    fn drop(&mut self) { self.out.push(self.s); }
}

struct Sw<'o, 'b, 'c, A: Allocator> where 'b: 'c {
    k: &'c u8, out: &'o mut Vec<&'c str, A>, s: &'b str,
}

impl<'o, 'b: 'c, 'c, A: Allocator> Drop for Sw<'o, 'b, 'c, A> {
    fn drop(&mut self) { self.out.push(self.s); }
}

struct Si<'o, 'b: 'c, 'c, A: Allocator> { k: &'c u8, out: &'o mut Vec<&'c str, A>, s: &'b str }

impl<'o, 'b: 'c, 'c, A: Allocator> Drop for Si<'o, 'b, 'c, A> {
    fn drop(&mut self) { self.out.push(self.s); }
}

struct Sn<'o, 'b, 'c, A: Allocator> { k: &'c &'b u8, out: &'o mut Vec<&'c str, A>, s: &'b str }

impl<'o, 'b: 'c, 'c, A: Allocator> Drop for Sn<'o, 'b, 'c, A> {
    fn drop(&mut self) { self.out.push(self.s); }
}

fn main(gpa: Gpa) {
    let n: u8 = 1;
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    {
        let st = String::from_in("hello heap string long", gpa);
        let x = Sw { k: &n, out: &mut v, s: st.as_str() };
    }
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{}", v.len());
    println("{}", w);
}
