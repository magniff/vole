// (0.26.1) `for e in arr` over an array of atomics: through 0.26.0 the
// loop bound a copy of the array (`let __for_seq = arr`) and the write was
// lost; an atomic holds an UnsafeCell, so the loop iterates a view now.
// EXPECT: 9
use std::sync::atomic::{AtomicI64, Ordering};

fn main() {
    let arr = [AtomicI64::new(1), AtomicI64::new(1)];
    for e in arr {
        e.store(9, Ordering::SeqCst);
    }
    println("{}", arr[0].load(Ordering::SeqCst));
}
