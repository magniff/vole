// (0.26.1) `for e in arr` over an array of atomics: the loop binds a copy
// of the array (`let __for_seq = arr`), so a write through an element is
// lost today.
// XFAIL: WRONG `for` over an array copies it: the store reaches the copy
// EXPECT: 9
use std::sync::atomic::{AtomicI64, Ordering};

fn main() {
    let arr = [AtomicI64::new(1), AtomicI64::new(1)];
    for e in arr {
        e.store(9, Ordering::SeqCst);
    }
    println(f"{arr[0].load(Ordering::SeqCst)}");
}
