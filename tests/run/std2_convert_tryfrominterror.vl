// EDITION: rust
// The std2 item(s): std::convert TryFromIntError.
// EXPECT: true false
// RUSTC: none (std2's TryFromIntError is in convert, Rust's in num)
use std::convert::{Infallible, TryFromIntError};

fn main() {
    let a: Result<u8, TryFromIntError> = u8::try_from(300i64);
    let b: Result<u8, TryFromIntError> = u8::try_from(200i64);
    println("{} {}", a.is_err(), b.is_err());
}
