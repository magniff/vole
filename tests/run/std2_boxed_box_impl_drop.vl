// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::impl Drop.
// EXPECT: in
// EXPECT: drop 1
// EXPECT: out
use std::boxed::Box;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main(gpa: Gpa) {
    {
        let b = Box::new_in(D { n: 1 }, gpa);
        println("in");
    }
    println("out");
}
