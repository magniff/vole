// FLAGS: --check-unsafe
// EXPECT: ok 100000000
// 0.30.1: a valid program. Thread A reallocates a block of C's own,
// moving it each time; threads B and C malloc and free (recorded, then
// held) as fast as they can. libmalloc logs a realloc after it has freed
// the old memory, so B may have that memory recorded and held by then.
// No log is evidence for a report, only for forgetting a block. (Earlier
// on 0.30.1's branch a log reported `a freed block freed again, by C`, in
// about 7 runs of 8: a race, so this case catches that bug most times,
// not every time.)
use std::thread;

extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn reallocf(p: *mut u8, n: usize) -> *mut u8;
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
}

fn a_side() -> u64 {
    let mut s = 0u64;
    // UNSAFE: C. SAFETY: C's own block, used within its size.
    unsafe {
        let mut p = strdup(c"01234567890123456789012345678901234567890123456" as *const u8);
        for k in 0..2000000u64 {
            p = reallocf(p, if k % 2 == 0 { 5000 } else { 40 });
            s += *p as u64;
        }
        free(p);
    }
    s
}

fn b_side() -> u64 {
    let mut s = 0u64;
    for _ in 0..2000000u64 {
        // UNSAFE: C. SAFETY: within the block, freed once.
        unsafe {
            let p = malloc(32);
            *p = 1;
            s += *p as u64;
            free(p);
        }
    }
    s
}

fn main(gpa: Gpa) {
    let a = thread::spawn_in(move || a_side(), gpa);
    let b = thread::spawn_in(move || b_side(), gpa);
    let c = thread::spawn_in(move || b_side(), gpa);
    let s = a.join().unwrap() + b.join().unwrap() + c.join().unwrap();
    println("ok {s}");
}
