// RULE: F8.4
// `<W as Conv<bool>>::c(1u8)`, W generic and written bare beside `<W<_> as Conv<bool>>`: rustc E0107 (missing generics for struct `W`). The branch before the fix chose the impl by the trait and printed `2 1 2`; v0.30.1 did not parse it.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// ERROR: 'W' is generic: write its type arguments ('W<...>')
trait Conv<T> {
    fn c(x: u8) -> Self;
}

struct W<U> {
    u: i64,
    p: Option<U>,
}

impl<U> Conv<i64> for W<U> {
    fn c(x: u8) -> W<U> {
        W { u: 1, p: None }
    }
}

impl<U> Conv<bool> for W<U> {
    fn c(x: u8) -> W<U> {
        W { u: 2, p: None }
    }
}

fn main() {
    let a: W<u8> = <W as Conv<bool>>::c(1u8);
    let b: W<u8> = <W as Conv<i64>>::c(1u8);
    let c: W<u8> = <W<_> as Conv<bool>>::c(1u8);
    println("{} {} {}", a.u, b.u, c.u);
}
