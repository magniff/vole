// XFAIL: RT-187: a closure whose captures are Clone is not Clone (`e.clone()`), and cloning std's Map or Filter of a closure fails inside std (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_018_closure_not_clone.rs.txt): a
// closure is Clone and Copy when its captures are. vole: copies work (`let d = c;`,
// `dup(e)` with F: Copy), but `e.clone()` is `no method 'clone' on type
// 'closure(i64) -> i64 at ..'`, and `it.clone()` of a Filter/Map over a closure
// is refused inside std: `<std>:17611:5: error[type error] no method 'clone' on
// type 'closure(&i64) -> bool ..' | note: in instantiation of 'Filter<..>::clone'`
// (std's Clone for Map<I, F>/Filter<I, P> has no F: Clone bound, so the error is
// in std's body at the instance). A `-> impl Iterator<Item = i64> + Clone` over a
// filter is refused the same way. Since v0.28.0.
// EXPECT: 2 2
// EXPECT: 6 6
// EXPECT: 9 9
// EXPECT: 12
// EXPECT: 3 6
// EXPECT: 4 6
fn dup<F: Copy>(f: F) -> (F, F) {
    (f, f)
}

fn main() {
    let k = 3i64;
    let c = |x: i64| x + 1;
    let d = c;
    println("{} {}", c(1), d(1));
    let e = move |x: i64| x * k;
    let f = e;
    println("{} {}", e(2), f(2));
    let (g, h) = dup(e);
    println("{} {}", g(3), h(3));
    let i = e.clone();
    println("{}", i(4));
    let it = (0..6i64).filter(|x| x % 2 == 0);
    let jt = it.clone();
    println("{} {}", it.count(), jt.sum::<i64>());
    let m = (0..4i64).map(move |x| x + k);
    let n = m.clone();
    println("{} {}", m.count(), n.max().unwrap());
}
