// EDITION: rust
// RULE: D3.6a, D3.6
// (0.27.7) A view coerces to a fat raw pointer as rustc's: `&[T]` and
// `&mut [T]` to `*const [T]`, `&mut [T]` to `*mut [T]`, `&str` to
// `*const str`, `&a` and `&mut a` of an array as its slice. A fat raw
// pointer has no loan, so `m` is written while `d` points into it. A
// `&mut` given to a `*const` is a read (`&raw const`): a shared borrow
// live across it is no conflict. 0.27.6 refused every coercion here.
// Prints 4 3 4 3 3 2 4 4, then 5 7 3 4, then 1 1 1 1.
// FLAGS: --verify-places
// EXPECT: 4 3 4 3 3 2 4 4
// EXPECT: 5 7 3 4
// EXPECT: 1 1 1 1
fn len_of(p: *const [u8]) -> usize {
    p.len()
}

fn mlen(p: *mut [u8]) -> usize {
    p.len()
}

fn view(s: &[u8]) -> *const [u8] {
    s
}

fn thin_read(x: &mut i64) -> i64 {
    let r = &*x;
    let p: *const i64 = x;
    let _ = p;
    let q = x as *const i64;
    let _ = q;
    *r
}

fn fat_read(s: &mut [u8]) -> u8 {
    let r = &s[0];
    let p: *const [u8] = s;
    let q: *const [u8] = &s[..];
    let _ = (p, q);
    *r
}

fn main() {
    let mut m = [1u8, 2, 3, 4];
    let a: *const [u8] = &m;
    let tu: &str = "abc";
    let t: *const str = tu;
    let s: &mut [u8] = &mut m;
    let b: *mut [u8] = s;
    let c: *const [u8] = &mut m[..3];
    m[0] = 5;
    let d: *mut [u8] = &mut m[1..];
    m[1] = 6;
    // UNSAFE: the test's fat raw pointer
    // SAFETY: d points to m[1..], live; no reference to m is held here
    unsafe {
        (*d)[0] += 1;
    }
    println("{} {} {} {} {} {} {} {}", a.len(), (t as *const [u8]).len(), b.len(), c.len(), d.len(),
        len_of(&m[..2]), mlen(&mut m), view(&m).len());
    println("{} {} {} {}", m[0], m[1], m[2], m[3]);
    let mut v = 1i64;
    let mut w = [1u8, 2];
    println("{} {} {} {}", thin_read(&mut v), fat_read(&mut w), v, w[0]);
}
