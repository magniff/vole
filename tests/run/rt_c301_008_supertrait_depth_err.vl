// RULE: F2.2
// A limit is an error, never a 'none': `X::K` through supertraits nested
// deeper than 8 (rustc follows them further and accepts this).
// RUSTC-DIFFERS: rustc accepts it (it follows supertraits further); vole follows 8, and deeper is an error
// ERROR: error[trait.depth]: the supertraits of trait 'T2' nest deeper than 8
trait T0 { const K: i64; }
trait T1: T0 {}
trait T2: T1 {}
trait T3: T2 {}
trait T4: T3 {}
trait T5: T4 {}
trait T6: T5 {}
trait T7: T6 {}
trait T8: T7 {}
trait T9: T8 {}
trait T10: T9 {}
fn f<X: T10>() -> i64 { X::K }
fn main() { println("{}", 0); }
