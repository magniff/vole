// EDITION: rust
// XFAIL: gap 14: output: line 4: expected '(3, -4) Point { x: 3, y: -4 } [ (3, -4)] [(3, -4) ] [ Point { x: 3, y: -4 }]', go...
// f-strings (0.15): holes evaluated where the f-string is written, left to
// right, once; an f-string is a value (stored, passed to any T: Display,
// printed twice); Display and Debug impls written with f.write; std's
// Debug of Option, Result, Vec, HashMap, Buf; format, push_fmt, eprintln.
// EXPECT: <a><b><c>
// EXPECT: 1 2:3 1 2:3
// EXPECT: k=1 now k=2
// EXPECT: (3, -4) Point { x: 3, y: -4 } [   (3, -4)] [(3, -4)   ] [   Point { x: 3, y: -4 }]
// EXPECT:          dot (3, -4)|
// EXPECT:  line (3, -4)-(0, 0)|
// EXPECT: (3, -4) Point { x: 3, y: -4 }
// EXPECT: Some(5) None Ok(1) Err("bad")
// EXPECT: ["x", "y\n"] [Some(1), None] {7: "seven"} buf "buf"
// EXPECT: [Point { x: 3, y: -4 }, Point { x: 1, y: 1 }] and (1, 1)    9
// EXPECT: g(10) = 12
// STDERR: to stderr: (3, -4)
// STDERR: no newline
// STDERR: 123
use std::fmt::Display; use std::fmt::Debug; use std::fmt::Formatter as Fmt;
use std::collections::HashMap;

static mut CALLS: i64 = 0;

fn next(tag: &str) -> i64 {
    unsafe { CALLS += 1; }
    print("<{tag}>");
    unsafe { CALLS }
}

#[derive(Clone, Copy)] struct Point { x: i64, y: i64 }

impl Display for Point {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        write(f, "({}, {})", self.x, self.y)?;
        Ok(()) }
}

impl Debug for Point {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        f.write_str("Point { x: ")?;
        write(f, "{:?}", self.x)?;
        f.write_str(", y: ")?;
        write(f, "{:?}", self.y)?;
        f.write_str(" }")?;
        Ok(()) }
}

#[derive(Clone, Copy)] enum Shape { Dot(Point), Line(Point, Point) }

impl Display for Shape {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        match self {
            Shape::Dot(p) => write(f, "dot {p}")?,
            Shape::Line(a, b) => write(f, "line {a}-{b}")?,
        }; Ok(())
    }
}

// (0.16: debug_list into a Buf, through a Display)
#[derive(Clone, Copy)] struct Points<'a> { s: &'a [Point] }

impl Display for Points<'_> {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        f.debug_list().entries(self.s.iter()).finish();
        Ok(()) }
}

impl Point {
    fn show(self, gpa: Gpa) -> String<Gpa> {
        format_in("{self} {self:?}", gpa)
    }
}

fn twice<T: Display>(x: T) {
    print("{}", x);
    print(" ");
    println("{}", x);
}

fn main(gpa: Gpa) {
    // left to right, once, where it is written
    let s = format_args("{} {}:{:?}", next("a"), next("b"), next("c"));
    println("");
    unsafe { CALLS = 100; }
    twice(s);
    let mut k: i64 = 1;
    let saved = format_args("k={k}");
    k = 2;
    println("{saved} now k={k}");
    // impls, nested specs (the hole's text is padded as a whole)
    let p = Point { x: 3, y: -4 };
    println("{p} {p:?} [{p:>10}] [{p:<10}] [{p:>24?}]");
    let shapes = [Shape::Dot(p), Shape::Line(p, Point { x: 0, y: 0 })];
    for sh in shapes {
        println("{sh:>20}|");
    }
    let mut b = p.show(gpa);
    println("{}", b.as_str());
    b.clear();
    // std's Debug
    let some: Option<i64> = Some(5i64);
    let none: Option<i64> = None;
    let ok: Result<i64, &str> = Ok(1i64);
    let err: Result<i64, &str> = Err("bad");
    println("{some:?} {none:?} {ok:?} {err:?}");
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push("x");
    v.push("y\n");
    let mut nested: Vec<Option<i64>, Gpa> = Vec::new_in(gpa);
    nested.push(Some(1i64));
    nested.push(None);
    let mut m: HashMap<i64, &str, Gpa> = HashMap::new_in(gpa);
    m.insert(7, "seven");
    let mut text = String::new_in(gpa);
    text.push_str("buf");
    println("{v:?} {nested:?} {m:?} {text} {text:?}");
    let arr = [p, Point { x: 1, y: 1 }];
    let mut out = String::new_in(gpa);
    std::fmt::write(&mut out, (Points { s: &arr[..] })).unwrap();
    std::fmt::write(&mut out, " and {} {:>4}", arr[1], (1 + 2) * 3).unwrap();
    println("{}", out.as_str());
    // a closure's f-string; a hole holding a closure call
    let add = |a: i64| a + k;
    let g = |x: i64| format_in("g({x}) = {}", add(x), gpa);
    let mut r = g(10);
    println("{}", r.as_str());
    r.clear();
    // stderr
    eprintln("to stderr: {p}");
    eprint("no newline");
    eprintln("");
    std::fmt::eprint("{}{}", 1, 2);
    std::fmt::eprintln("{}", 3);
}
