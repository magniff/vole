// XFAIL: RT-245b: (RT-245's mechanism, a reference item) `fn f<'b, U: 'b>(self) -> Option<&'b U> where Self: Iterator<Item = &'b U> + Sized` as a default method of `trait Ext: Iterator`, with `impl<I: Iterator> Ext for I {}`, is refused, "unknown type 'U'" in the where clause; rustc prints `Some(4)` (0.30.2)
// From the integrator's note on the g302bor2 review. Since v0.30.1 at least.
// EXPECT: Some(4)
trait Ext: Iterator {
    fn f<'b, U: 'b>(self) -> Option<&'b U>
        where
            Self: Iterator<Item = &'b U> + Sized,
    {
        let mut s = self;
        s.next()
    }
}

impl<I: Iterator> Ext for I {}

fn main() {
    let a = [4i64, 5];
    let r = a.iter().f();
    println("{:?}", r);
}
