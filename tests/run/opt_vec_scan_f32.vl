// EXPECT: carried_f32: 0/0 0/0 0/0 40/9615648444870611128 40/9615648444870611128 328/18279332715514809792 476/17147476714054079508 4784/11633427002488644728
// EXPECT: slp_f32: 0/0 0/0 0/0 133/5954592626960601604 133/5954592626960601604 385/1783864431408071985 562/1962057897893662831 4784/2106434333812299363
fn h_f32(a: &[f32], n: usize) -> u64 {
    let mut h: u64 = 0;
    let mut i: usize = 0;
    while i < n {
        h = h.wrapping_mul(1000003).wrapping_add(a[i] as i64 as u64);
        i += 1;
    }
    h
}

#[inline(never)]
fn add_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn sub_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc - b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn mul_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 1.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc * b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn min_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 50.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.min(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn max_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.max(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

fn dbl_f32(x: f32) -> f32 {
    x + x
}

#[inline(never)]
fn before_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        a[i] = acc;
        acc = acc + b[i];
        i += 1;
    }
    acc
}

#[inline(never)]
fn old_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        let old = acc;
        acc = acc + b[i];
        a[i] = old;
        i += 1;
    }
    acc
}

#[inline(never)]
fn other_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        c[i] = acc;
        a[i] = b[i];
        i += 1;
    }
    acc
}

#[inline(never)]
fn derived_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = acc * 3.0;
        i += 1;
    }
    acc
}

#[inline(never)]
fn excl_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = acc - b[i];
        i += 1;
    }
    acc
}

#[inline(never)]
fn cmp_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = if acc > b[i] { 1.0 } else { 0.0 };
        i += 1;
    }
    acc
}

#[inline(never)]
fn cmpsum_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut cnt: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        cnt = cnt + if acc > (40 as f32) { 1.0 } else { 0.0 };
        a[i] = b[i];
        i += 1;
    }
    cnt
}

#[inline(never)]
fn second_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut s1: f32 = 0.0;
    let mut s2: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        s1 = s1 + b[i];
        s2 = s2 + s1;
        a[i] = b[i];
        i += 1;
    }
    s2
}

#[inline(never)]
fn second_nostore_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut s1: f32 = 0.0;
    let mut s2: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        s1 = s1 + b[i];
        s2 = s2 + s1;
        i += 1;
    }
    s2
}

#[inline(never)]
fn second_old_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut s1: f32 = 0.0;
    let mut s2: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        s2 = s2 + s1;
        s1 = s1 + b[i];
        i += 1;
    }
    s2
}

#[inline(never)]
fn two_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut x: f32 = 0.0;
    let mut y: f32 = 1.0;
    let mut i: usize = 0;
    while i < n {
        x = x + b[i];
        y = y - b[i];
        a[i] = x;
        c[i] = y;
        i += 1;
    }
    x
}

#[inline(never)]
fn iv2_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + 1.0;
        a[i] = acc + b[i];
        i += 1;
    }
    acc
}

#[inline(never)]
fn twice_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = acc;
        acc = acc + b[i];
        c[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn call_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = dbl_f32(acc);
        i += 1;
    }
    acc
}

#[inline(never)]
fn zip_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut k: usize = 0;
    for (x, y) in a.iter_mut().zip(b.iter()) {
        if k == n { break; }
        acc = acc + *y;
        *x = acc;
        k += 1;
    }
    acc
}

#[inline(never)]
fn forrange_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    for i in 0..n {
        acc = acc + b[i];
        a[i] = acc;
    }
    acc
}

#[inline(never)]
fn rows_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut j: usize = 0;
    while j < n / 9 {
        acc = 0.0;
        let mut k: usize = 0;
        while k < 9 {
            acc = acc + b[j * 9 + k];
            a[j * 9 + k] = acc;
            k += 1;
        }
        j += 1;
    }
    acc
}

#[inline(never)]
fn rows_n_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut j: usize = 0;
    let w = n / 3;
    while j < 3 {
        acc = 0.0;
        let mut k: usize = 0;
        while k < w {
            acc = acc + b[j * w + k];
            a[j * w + k] = acc;
            k += 1;
        }
        j += 1;
    }
    acc
}

#[inline(never)]
fn cols_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut j: usize = 0;
    while j < n / 4 {
        acc = 0.0;
        let mut k: usize = 0;
        while k < 4 {
            acc = acc + b[k * 25 + j];
            a[k * 25 + j] = acc;
            k += 1;
        }
        c[j] = acc;
        j += 1;
    }
    acc
}

#[inline(never)]
fn carried_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut j: usize = 0;
    while j < n / 4 {
        let mut k: usize = 0;
        while k < 4 {
            acc = acc + b[k * 25 + j];
            k += 1;
        }
        c[j] = acc;
        j += 1;
    }
    acc
}

#[inline(never)]
fn slp_f32(a: &mut [f32], b: &[f32], c: &mut [f32], n: usize) -> f32 {
    let mut acc: f32 = 0.0;
    let mut i: usize = 0;
    while i + 4 <= n {
        acc = acc + b[i + 0];
        a[i + 0] = acc;
        acc = acc + b[i + 1];
        a[i + 1] = acc;
        acc = acc + b[i + 2];
        a[i + 2] = acc;
        acc = acc + b[i + 3];
        a[i + 3] = acc;
        i += 4;
    }
    acc
}

fn main() {
    let mut b_d: [f32; 128] = [0.0; 128];
    for i in 0..128 { b_d[i] = ((i * 7919 + 13) % 97) as f32; }
    let mut b_one2: [f32; 128] = [0.0; 128];
    for i in 0..128 { b_one2[i] = (if i % 17 == 0 { 2 } else { 1 }) as f32; }
    print("add_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = add_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("sub_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = sub_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("mul_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = mul_f32(&mut a, &b_one2, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("min_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = min_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("max_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = max_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("before_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = before_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("old_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = old_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("other_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = other_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("derived_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = derived_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("excl_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = excl_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("cmp_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = cmp_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("cmpsum_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
        let mut a: [f32; 128] = [0.0; 128];
        let mut c: [f32; 128] = [0.0; 128];
        let r = cmpsum_f32(&mut a, &b_d, &mut c, n);
        print(" {}/{}", r as i64, h_f32(&a, 128).wrapping_mul(31).wrapping_add(h_f32(&c, 128)));
    }
    println("");
    print("second_f32:");
    for n in [0usize, 1, 3, 4, 5, 9, 15, 100] {
