// EDITION: rust
// (0.27.0) References in the rust edition: `&T` and `&mut T` parameters,
// `&self` methods of a trait, `&impl Trait`, match ergonomics through a
// reference, `ref` bindings, a write through `&mut`, a field through a
// reference, an element borrowed from a Vec.

#[derive(Clone, Copy)]
struct P {
    x: i64,
    y: i64,
}

enum Shape {
    Circle(i64),
    Rect(P),
}

trait Area {
    fn area(&self) -> i64;
}

impl Area for Shape {
    fn area(&self) -> i64 {
        match self {
            Shape::Circle(r) => 3 * *r * *r,
            Shape::Rect(p) => p.x * p.y,
        }
    }
}

fn show(a: &impl Area) -> i64 {
    a.area()
}

fn sum_all<T: Area>(v: &Vec<T, Gpa>) -> i64 {
    let mut s = 0;
    for x in v.iter() {
        s += x.area();
    }
    s
}

fn opt(o: &Option<P>) -> i64 {
    match o {
        Some(p) => p.x,
        None => 0,
    }
}

fn bump_all(v: &mut Vec<P, Gpa>) {
    for i in 0..v.len() {
        v[i].x += 1;
    }
}

fn incr(r: &mut i64) {
    *r += 1;
}

// a reborrow: `r` lent twice, each loan ending at its call
fn twice(r: &mut i64) {
    incr(r);
    incr(r);
}

fn first_x(p: &P) -> &i64 {
    &p.x
}

fn main(gpa: Gpa) -> i32 {
    let mut shapes: Vec<Shape, Gpa> = Vec::new_in(gpa);
    shapes.push(Shape::Circle(2));
    shapes.push(Shape::Rect(P { x: 2, y: 3 }));
    let mut ps: Vec<P, Gpa> = Vec::new_in(gpa);
    ps.push(P { x: 1, y: 1 });
    bump_all(&mut ps);
    let o = Some(P { x: 9, y: 0 });
    let first = &ps[0];
    let mut q = P { x: 0, y: 0 };
    let r = &mut q;
    r.x = 5;
    (*r).y = 6;
    if let Some(ref p) = o {
        println("ref {}", p.x);
    }
    let mut n = 1;
    twice(&mut n);
    println("{} {} {} {} {} {} {} {}", show(&shapes[0]), sum_all(&shapes), opt(&o), first.x,
        q.x, q.y, n, *first_x(&q));
    0
}
// EXPECT: ref 9
// EXPECT: 12 18 9 2 5 6 3 5
