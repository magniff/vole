// RULE: F18.5
// (0.30.2) An integer variable captured by a closure stays one: `a`, an
// untyped literal, is typed i64 by `take(f())`, so the closure's `a * 2`
// is computed in i64, as rustc infers it. 0.30.1 closed `a` at i32 when
// the closure was checked: `a * 2` overflowed i32 and was widened.
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let f = || a * 2;
    println("{}", take(f()));
}
