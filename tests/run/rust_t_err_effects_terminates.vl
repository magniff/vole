// EDITION: rust
// RUSTC: none an attribute of vole's std
// RULE: E2.2
// (0.28.0) `#[terminates]` is std's own: an unchecked promise that a
// function ends. A program cannot make it: its loop is counted, or the
// function is `diverge`.
// ERROR: unknown attribute 'terminates' (#[terminates] is std's own
// ERROR-COUNT: 1
#[terminates]
fn halve(n: u64) -> u64 {
    let mut k = n;
    let mut steps: u64 = 0;
    while k != 0 {
        k = k / 2;
        steps += 1;
    }
    steps
}

fn main() {
    println("{}", halve(8));
}
