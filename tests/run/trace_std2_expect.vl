// EDITION: rust
// (0.28.0) --trace: a failed expect in a program prints its line (the
// caller's place, gap 79), then the calls that led to it: std2's panic
// ends in the trace runtime's dump, as a failed check does.
// FLAGS: --trace
// EXIT: 101
// STDERR: trace_std2_expect.vl:13:5: a port: ParseIntError { kind: InvalidDigit }
// STDERR: trace, innermost call first:
// STDERR: trace_std2_expect.vl:13  port_of
// STDERR: trace_std2_expect.vl:17  show
// STDERR: trace_std2_expect.vl:21  main
fn port_of(value: &str) -> i64 {
    value.parse::<i64>().expect("a port")
}

fn show(value: &str) {
    println("{}", port_of(value));
}

fn main() {
    show("80a");
}
