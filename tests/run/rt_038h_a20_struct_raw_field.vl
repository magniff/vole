// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a20_struct_raw_field)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A struct holding a raw pointer, read by the clause: a callee writes through it.
struct H { p: *mut i64 }

fn poke(h: &H) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *h.p = 9; }
    true
}

fn f(h: &H) -> i64
    requires poke(h)
{
    1
}

fn main() {
    let mut x = 1i64;
    let h = H { p: &raw mut x };
    println("{}", f(&h));
    println("{}", x);
}
