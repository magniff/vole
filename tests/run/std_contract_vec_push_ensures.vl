// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): Vec::push's `ensures self.len() == old(self.len()) + 1 and self.len() <= self.capacity()`, exercised.
// EXPECT: 10 true
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 {
        v.push(i);
    }
    println("{} {}", v.len(), v.len() <= v.capacity());
}
