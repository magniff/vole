// XFAIL: RT-446k: UNSOUND: (RT-446's mechanism, a projection) (a variant) `enum E<X: Tr> { A(X::O) }` with `type O = &'static u64` for Y: `E::A(&*b)` returned from mk, b a Box local, is accepted, and main reads it after the free; rustc E0597 (`*b` does not live long enough) (0.30.2)
// From the review of g302static (its form g11_assoc_tuple_struct, its variant). Since v0.30.1 at
// least, and on the release build with g302static merged (the same use
// after free under --check-alloc). RT-446's root through a projection: the
// field's type is `X::O`, which normalizes to `&'static u64` for X = Y,
// and the region walk does not see the 'static in it.
// FLAGS: --check-alloc
// ERROR: line 25
trait Tr {
    type O;
}

struct Y;

impl Tr for Y {
    type O = &'static u64;
}

enum E<X: Tr> {
    A(X::O),
}

fn mk(gpa: Gpa) -> E<Y> {
    let b = Box::new_in(10u64, gpa);
    E::A(&*b)
}

fn main(gpa: Gpa) {
    match mk(gpa) {
        E::A(r) => println("{}", r),
    }
}
