// RULE: D2.5
// (0.30.1) `while let Some(x) = v.pop()`: the scrutinee is a temporary holding
// no borrow, so the body may push, as rustc.
// EXPECT: []
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    while let Some(x) = v.pop() {
        if x > 0 {
            v.push(x - 1);
        }
    }
    println("{:?}", v);
}
