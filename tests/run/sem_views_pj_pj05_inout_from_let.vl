fn top(v: &Vec<i64, Gpa>) -> &mut i64 { &mut v[0] }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let t = top(&v);
    *t += 1;
    println("{}", v[0]);
    0
}
