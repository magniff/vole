// RULE: R6
// (0.30.2) A fn item given to a bound whose input is the call's own
// region (`F: FnOnce(&K) -> V` of Entry::or_insert_with_key, `F:
// FnOnce(&ArenaScope<'_, P>) -> R` of arena_scope, a program's `F: Fn(T)
// -> U`), whose result keeps no borrow of it: builds, as rustc builds it.
// The body of the callee is checked by the bound (the strict records),
// not by the erased type: v0.30.1 refused std's or_insert_with_key body
// (a reference to its local 'e' escaping) and ap's. RT-378 is the must-
// fail form (`kk` returns its key).
// FLAGS: --check-alloc
// EXPECT: 7 6 7 7
use std::alloc::ArenaScope;
use std::collections::HashMap;

static SEVEN: i64 = 7;

fn ks(_k: &i64) -> &'static i64 {
    &SEVEN
}

fn kv(k: &i64) -> i64 {
    *k + 1
}

fn mk<'a, 'b, 'g>(s: &'a ArenaScope<'b, &'g Gpa>) -> i64 {
    let mut v = Vec::new_in(s);
    v.push(7i64);
    v[0]
}

fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    f(t)
}

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, &i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let r: &i64 = *m.entry(5).or_insert_with_key(ks);
    let mut n: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let q: i64 = *n.entry(5).or_insert_with_key(kv);
    let w = std::alloc::arena_scope(&gpa, mk);
    let z = 3i64;
    let y = ap(&z, ks);
    println("{} {} {} {}", r, q, w, y);
}
