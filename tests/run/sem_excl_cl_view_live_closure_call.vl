// a view of v alive across a call of a closure that reallocates v
// ERROR: error[borrowck.conflict]
// ERROR: line 6, column 17
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let s = v.as_slice();
    let mut g = || { for i in 0..1000 { v.push(i); } }; g(); println("{}", s[0]);
}
