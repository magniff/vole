// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.4, D19.8, D20.3
// (0.27.2.1) A closure leaves its function by `-> impl Fn(i32) -> i32`: its
// parameter's type is the bound's, and the `move` capture goes with it.
// EXPECT: 7 12
fn adder(k: i32) -> impl Fn(i32) -> i32 {
    move |x| x + k
}

fn main() {
    let f = adder(2);
    let g = adder(7);
    println("{} {}", f(5), g(5));
}
