// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops AddAssign::add_assign.
// EXPECT: V { x: 17 } 17
use std::ops::AddAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl AddAssign for V {
    fn add_assign(&mut self, rhs: V) {
        self.x += rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.add_assign(V { x: 5 });
    let mut n = 12i64;
    n.add_assign(5);
    println("{:?} {}", a, n);
}
