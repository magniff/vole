// (0.30.2, RT-46) A raw slice parameter over a static, the static written
// directly (no call between the loads: the alias analysis's "a parameter
// and a static are apart"), in a loop the vectorizer may run (a forward
// copy into the same static: the overlap must be kept), and in a loop whose
// load LICM may hoist above a call that writes it. Each is a raw pointer,
// so none of these facts hold. rustc (debug and -O): 2050, the copy's
// row of 7s, 2 + (1 + 2 + ... + 9) = 47. v0.30.1 -O1 and -O2: 2002, and
// the vector loop with no overlap test: `7 7 0 0 ...` (the last passes).
// EXPECT: 2050
// EXPECT: 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7 7
// EXPECT: 47
static mut G: [i64; 4] = [1, 2, 3, 4];
static mut ROW: [i64; 20] = [0; 20];

#[inline(never)]
fn reread(p: *const [i64]) -> i64 {
    // UNSAFE: a raw slice over G given by the caller, and G itself
    // SAFETY: G lives for the program; one thread; no reference to G is live
    unsafe {
        let a = (*p)[1];
        G[1] = 50;
        let b = (*p)[1];
        a * 1000 + b
    }
}

#[inline(never)]
fn shift(p: *const [i64]) {
    // UNSAFE: a raw slice over ROW given by the caller, and ROW through a raw pointer
    // SAFETY: ROW lives for the program; one thread; i + 1 < n = 20
    unsafe {
        let d = &raw mut ROW as *mut i64;
        let n = p.len();
        for i in 0..n - 1 {
            *d.add(i + 1) = (*p)[i];
        }
    }
}

#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn sum(p: *const [i64], q: *mut i64) -> i64 {
    let mut s: i64 = 0;
    for i in 0..10 {
        // UNSAFE: raw pointers given by the caller
        // SAFETY: both point into main's array, live across the call
        unsafe {
            s += (*p)[1];
        }
        poke(q, i + 1);
    }
    s
}

fn main() -> i32 {
    // UNSAFE: raw slices over the statics
    // SAFETY: one thread; no reference to either static outlives its statement
    let (g, row) = unsafe {
        (std::slice::from_raw_parts(&raw const G as *const i64, 4) as *const [i64],
            std::slice::from_raw_parts(&raw const ROW as *const i64, 20) as *const [i64])
    };
    println("{}", reread(g));
    // UNSAFE: ROW is written here only
    // SAFETY: one thread
    unsafe {
        ROW[0] = 7;
    }
    shift(row);
    for i in 0..20 {
        // UNSAFE: ROW is read
        // SAFETY: one thread
        let x = unsafe { ROW[i] };
        if i < 19 { print("{} ", x); } else { println("{}", x); }
    }
    let mut a = [1i64, 2, 3, 4];
    let base = a.as_mut_ptr();
    // UNSAFE: the raw slice and the element pointer are both made from base
    // SAFETY: a has 4 elements and outlives both pointers
    let (p, q) = unsafe {
        (std::slice::from_raw_parts(base, 4) as *const [i64], base.add(1))
    };
    println("{}", sum(p, q));
    0
}
