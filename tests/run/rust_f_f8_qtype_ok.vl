// RULE: F8.1, F11.3
// `<X as Tr>::A` in a type is the A of X's impl of Tr, in a signature
// (per instance) and in a `let`'s annotation.
// EXPECT: 9
trait Src {
    type Item;
    fn first(&self) -> Self::Item;
}

struct W {
    n: i64,
}

impl Src for W {
    type Item = i64;

    fn first(&self) -> i64 {
        self.n
    }
}

fn take<S: Src>(s: &S) -> <S as Src>::Item {
    s.first()
}

fn main() {
    let x: <W as Src>::Item = 5;
    println("{}", take(&W { n: 4 }) + x);
}
