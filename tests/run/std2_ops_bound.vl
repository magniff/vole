use std::ops::Bound;

fn main() {
    let a: Bound<i64> = Bound::Included(1);
    let b: Bound<i64> = Bound::Excluded(2);
    let c: Bound<i64> = Bound::Unbounded;
    println("{:?} {:?} {:?}", a, b, c);
}
