// RULE: D9.1
// (0.27.2) std's containers free what they allocate: a Vec of Strings
// pushed, popped and dropped gives back every block, counted by an
// allocator of the program's own over Gpa (live 0 at the end).
// RUSTC: none std spells the allocator (`fn main(gpa: Gpa)`, `_in`)
use std::alloc::{AllocError, Allocator, Layout};
use std::ptr::NonNull;

struct Count<A: Allocator> {
    gpa: A,
    live: *mut i64,
}

impl<A: Allocator + Copy> Clone for Count<A> {
    fn clone(&self) -> Count<A> {
        *self
    }
}

impl<A: Allocator + Copy> Copy for Count<A> {}

// UNSAFE: an Allocator impl, Gpa's blocks passed through.
// SAFETY: every block is Gpa's, given back to Gpa with its layout.
unsafe impl<A: Allocator> Allocator for Count<A> {
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        // UNSAFE: the counter behind a raw pointer.
        // SAFETY: live points at main's local, which outlives every block.
        unsafe { *self.live += 1; }
        self.gpa.allocate(layout)
    }

    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {
        // UNSAFE: as allocate's.
        // SAFETY: as allocate's.
        unsafe { *self.live -= 1; }
        // UNSAFE: Gpa's block back to Gpa.
        // SAFETY: p came from self.gpa.allocate with this layout.
        unsafe { self.gpa.deallocate(p, layout) }
    }
}

fn main(gpa: Gpa) {
    let mut live: i64 = 0;
    let a = Count { gpa: gpa, live: &mut live as *mut i64 };
    {
        let mut v: Vec<String<Count<Gpa>>, Count<Gpa>> = Vec::new_in(a);
        for i in 0..5 {
            let mut s: String<Count<Gpa>> = String::new_in(a);
            s.push_str("item");
            if i % 2 == 0 {
                s.push_str("!");
            }
            v.push(s);
        }
        let last = v.pop();
        // SAFETY: a read of the counter, no block in flight.
        let n = unsafe { *a.live };
        println("{} {} {}", v.len(), last.is_some(), n > 0);
    }
    println("live {}", live);
}
// EXPECT: 4 true true
// EXPECT: live 0
