// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc FixedBuf::reset.
// EXPECT: 4 0
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main() {
    let mut mem = [0u8; 32];
    let mut fb = FixedBuf::new(&mut mem);
    let _ = fb.allocate(Layout::array::<u8>(4).unwrap());
    let a = fb.used();
    fb.reset();
    println("{} {}", a, fb.used());
}
