// sem-own: `if let Some(d) = self.o` in an inout self method moves out of a reference: own.move_out.
// ERROR: own.move_out
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
struct P<A: Allocator> { o: Option<D<A>> }
impl P<Gpa> { fn f(inout self) { if let Some(d) = self.o { eat(d); } } }

fn main(gpa: Gpa) {
    var p = P { o: Some(mk(1, gpa)) };
    p.f();
}
