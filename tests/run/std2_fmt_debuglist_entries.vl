// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt DebugList::entries.
// EXPECT: [0, 1, 2]
// EXPECT: [
// EXPECT:     0,
// EXPECT:     1,
// EXPECT:     2,
// EXPECT: ]
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_list().entries(0..3).finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
