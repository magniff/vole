// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::io BufRead::fill_buf.
// EXPECT: [1, 2, 3] []
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    print("{:?} ", b.fill_buf().unwrap());
    let n = b.fill_buf().unwrap().len();
    b.consume(n);
    println("{:?}", b.fill_buf().unwrap());
}
