// RULE: F5.5
// (0.30.1) The trait's result is Self, `Y<'a>`; the impl returns a
// `Y<'static>`. Y is invariant in its lifetime (a `&'a mut &'a str`), so a
// Y<'static> is not a Y<'a>: rustc E0308. (A covariant struct's is,
// rust_f_f55_impl_lifetimes_ok.)
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 1
struct Y<'a> {
    r: &'a mut &'a str,
}

trait Again {
    fn again(&self) -> Self;
}

impl<'a> Again for Y<'a> {
    fn again(&self) -> Y<'static> {
        panic("not made")
    }
}

fn main() {
    let mut s = "x";
    let y = Y { r: &mut s };
    println("{}", y.r.len());
}
