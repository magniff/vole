// 0.26.0: a block's field that is no entry point of it (gpu.entry): the
// message lists the entry points and their stages, the nearest is the fix.
// ERROR: error[gpu.entry]: the block 'SIM' has no entry point 'stpe'; its entry points: init (compute), step (compute)
// ERROR: help: did you mean 'step'?
embed wgsl SIM {
    @group(0) @binding(0) var<storage, read_write> cells: array<u32>;

    @compute @workgroup_size(64)
    fn init(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] = 0u;
    }

    @compute @workgroup_size(64)
    fn step(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] += 1u;
    }
}

fn main() -> i32 {
    println(SIM.stpe);
    0
}
