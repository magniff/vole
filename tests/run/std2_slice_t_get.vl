// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::slice [T]::get.
// EXPECT: Some(2) None Some([2, 3]) None
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3];
    println("{:?} {:?} {:?} {:?}", s.get(1), s.get(3), s.get(1..3), s.get(2..5));
}
