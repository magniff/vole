// XFAIL: RT-426d: WRONG CODE: (RT-426's family, the impls in the other order) `T::Out` under `T: Sub` with `trait Sub: Tr<u8>` and the impl of Tr<u16> declared first takes Tr<u16>'s Out: vole prints 1, rustc 8 (0.30.2)
// From the re-review of g302oblig M2 (its form c07c_bound_super_u8_swapped). Since v0.30.1 at
// least (v0.30.1 and the release build print 1).
// EXPECT: 8
trait Tr<A> {
    type Out;
}

struct W;

impl Tr<u16> for W {
    type Out = u8;
}

impl Tr<u8> for W {
    type Out = i64;
}

trait Sub: Tr<u8> {}

impl Sub for W {}

fn sz<T: Sub>() -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    println("{}", sz::<W>());
}
