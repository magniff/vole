// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc Gpa::impl Allocator.
// EXPECT: true 64
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let l = Layout::from_size_align(64, 64).unwrap();
    let p = gpa.allocate(l).unwrap();
    let aligned = p.as_ptr() as usize % 64 == 0;
    // UNSAFE: the block goes back.
    // SAFETY: p came from gpa with layout l.
    unsafe { gpa.deallocate(p, l) };
    println("{} {}", aligned, l.size());
}
