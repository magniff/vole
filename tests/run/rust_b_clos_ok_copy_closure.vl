// EDITION: rust
// RULE: D19.7
// (0.27.2) A closure with only `ref` and `Copy` `val` captures is `Copy`:
// a copy of it leaves it usable.
// EXPECT: 3 4
fn main() {
    let k = 2;
    let f = move || k + 1;
    let g = f;
    println("{} {}", f(), g() + 1);
}
