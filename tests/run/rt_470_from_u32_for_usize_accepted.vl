// ERROR: line 12
// ERROR: line 13
fn main() {
    let a: u32 = 7;
    let r = usize::from(a);
    let s: usize = a.into();
    let b: i32 = 7;
    let t = isize::from(b);
    let u: isize = b.into();
    println("{} {} {} {}", r, s, t, u);
}
