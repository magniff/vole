// A checked cast to an enum under a never-true condition in a loop.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;
#[derive(Clone, Copy, PartialEq, Eq)] #[repr(u8)]
enum E { A = 1, B = 2 }

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    let x = 7 + unsafe { Z };
    while k < 5 + unsafe { Z } { if k > 100 { t += (x as E) as i64; } k += 1; }
    println("{}", t);
    0
}
