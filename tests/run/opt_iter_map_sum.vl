// XFAIL: gap 17: compile type error: no method 'call' on type '*F'
// 0.14: `v.iter().map(|x| x * 3).sum()`, hand-desugared into the shapes
// the front end makes of it (docs/design/closures-iterators.md, section
// 3): the closure a struct with a `call` taking it by pointer, the adapter
// a generic struct, `sum` a fold whose closure captures the map's closure
// by reference; the source's fold a counted loop. Once inlined, it is the
// hand-written loop: no call, no frame slot, the same loop (0.15: unrolled
// by 4 with four accumulators, not vectorized: NEON has no 64-bit
// multiplication, done lane by lane it costs more than scalar code).
// EXPECT: 14850
// EXPECT: 14850
// CHECK: fn kernel:
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: mul
// CHECK: +24
// CHECK-NOT: call
// CHECK-NOT: slot
// CHECK: fn hand:
// CHECK: +24
trait Call { fn call(self: *mut Self, x: i64) -> i64; }
trait Call2 { fn call(self: *mut Self, a: i64, b: i64) -> i64; }

#[derive(Clone, Copy)] struct SliceIter<'a> { s: &'a [i64], pos: i64 }

impl<'a> SliceIter<'a> {
    #[inline]
    fn fold<G: Call2>(self, init: i64, g: G) -> i64 {
        let mut acc = init;
        for k in self.pos..self.s.len() as i64 {
            acc = g.call(acc, self.s[k as usize]);
        }
        acc
    }
}

#[derive(Clone, Copy)] struct Map<I, F> { it: I, f: F }

// |acc, x| g(acc, f(x)): f captured by reference, g by value
#[derive(Clone, Copy)] struct MapFold<F, G> { f: *mut F, g: G }

impl<F: Call, G: Call2> Call2 for MapFold<F, G> {
    fn call(self: *mut MapFold<F, G>, acc: i64, x: i64) -> i64 {
        unsafe { self.g.call(acc, self.f.call(x)) }
    }
}

impl<I, F: Call> Map<I, F> {
    #[inline]
    fn fold<G: Call2>(self, init: i64, g: G) -> i64 {
        let mut f = self.f;
        self.it.fold(init, MapFold { f: &mut f, g: g })
    }
    #[inline]
    fn sum(self) -> i64 {
        self.fold(0i64, SumFold {})
    }
}

#[derive(Clone, Copy)] struct SumFold {}

impl Call2 for SumFold {
    fn call(self: *mut SumFold, a: i64, b: i64) -> i64 { a + b }
}

// |x| x * 3
#[derive(Clone, Copy)] struct Closure0 {}

impl Call for Closure0 {
    fn call(self: *mut Closure0, x: i64) -> i64 { x * 3 }
}

#[inline]
fn iter(v: &Vec<i64, Gpa>) -> SliceIter<'_> {
    SliceIter { s: v.as_slice(), pos: 0 }
}

#[inline]
fn map<I, F>(it: I, f: F) -> Map<I, F> {
    Map { it: it, f: f }
}

#[inline(never)]
fn kernel(v: &Vec<i64, Gpa>) -> i64 {
    map(iter(v), Closure0 {}).sum()
}

#[inline(never)]
fn hand(v: &Vec<i64, Gpa>) -> i64 {
    let s = v.as_slice();
    let mut t: i64 = 0;
    for k in 0..s.len() {
        t += s[k] * 3;
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
    }
    print("{}", kernel(&v));
    println("");
    print("{}", hand(&v));
    println("");
    0
}
