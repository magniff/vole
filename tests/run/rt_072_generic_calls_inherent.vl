// XFAIL: RT-72: in a generic body, a method call on T (a trait bound's method) runs the concrete type's inherent method of that name after instantiation (0.30.2)
// In `fn ga<T: TA>(x: &T) { x.m() }` the only `m` of T is TA's: rustc
// calls TA::m for every T. vole, with T = S that also has an inherent
// `m`, calls S's inherent one: in a generic fn, a generic impl's method
// (Wrap<T>::go), and a trait's default method body (TA::d's `self.m()`).
// rustc prints the EXPECT lines; vole prints `304 3 7 3 7`.
// EXPECT: 110 2 11 2 7
// EXPECT: 1 2 3
trait TA {
    fn m(&self) -> i64;

    fn d(&self) -> i64 {
        self.m() * 10
    }
}

trait TB {
    fn m(&self) -> i64;
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl S {
    fn m(&self) -> i64 {
        3
    }

    fn d(&self) -> i64 {
        4
    }
}

impl TA for S {
    fn m(&self) -> i64 {
        1
    }
}

impl TB for S {
    fn m(&self) -> i64 {
        2
    }
}

fn ga<T: TA>(x: &T) -> i64 {
    x.m() * 100 + x.d()
}

fn gb<T: TB>(x: T) -> i64 {
    x.m()
}

fn gab<T: TA + Copy>(x: T) -> i64 {
    x.m() + x.d()
}

struct Wrap<T> {
    t: T,
}

impl<T: TB> Wrap<T> {
    fn go(&self) -> i64 {
        self.t.m()
    }
}

fn body() {
    let s = S { k: 0 };
    println("{} {} {} {} {}", ga(&s), gb(s), gab(s), Wrap { t: s }.go(), s.m() + s.d());
    println("{} {} {}", TA::m(&s), <S as TB>::m(&s), S::m(&s));
}

fn main() -> i32 {
    body();
    0
}
