// XFAIL: gap 2: errors at other places or codes: MVS sync.borrow_escapes@6:5; rust alloc.no_in@6:5
// a sink closure capturing a let parameter (a borrow of the caller's Vec) moved into a detached thread
// ERROR: [sync.borrow_escapes]: 'thread::spawn' moves 'v'
use std::thread::JoinHandle; use std::thread;

fn start(v: &Vec<i64, Gpa>) -> JoinHandle<i64, Gpa> {
    thread::spawn(move || {
        let mut t: i64 = 0; for _ in 0..200 { t += v[0]; thread::yield_now(); } t
    })
}

fn main(gpa: Gpa) {
    let mut h = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        start(&v)
    };
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i + 50); }
    println("{}", h.join().unwrap());
}
