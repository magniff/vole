// XFAIL: RT-19: a range bound of 2^63 or more makes `a[i]` in bounds for the effects, so -O2 deletes a call that panics (open)
// FLAGS: -O2
// front::effects::infer::walk_for records `for j in 0..N` (N a literal)
// as LOOP_LENGTH with N read as an i64: 18446744073709551615 is -1, and
// in_bounds takes `-1 <= 3` (the array's length) as proof that `a[j]`
// cannot be out of bounds. The index keeps its run-time check, but `at`
// has no `panic` effect, so ipo::front_attrs gives it nopanic and
// willreturn and -O2 deletes the call whose result is unused: the program
// prints `after at` and exits 0. -O0 is right: index 5 is out of bounds.
// STDERR: index out of bounds: index 5, length 3
// EXIT: 101
#[inline(never)]
fn at(i: usize) -> i64 {
    let a: [i64; 3] = [10, 20, 30];
    for j in 0..18446744073709551615usize {
        if j == i {
            return a[j];
        }
    }
    0
}

fn main() {
    // no arguments: n is 1
    let n = std::env::args().count();
    let _x = at(n + 4);
    println("after at");
}
