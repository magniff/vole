// An unsuffixed literal takes its type from the code around it (0.14): an
// if's other branch (through `else if` chains), a match's other arms, an
// array's other elements; `let x: u8 = if ...` and arguments gave it
// before. With only literals, i64 (f64) as before.
// EXPECT: 98 0 1 97 98 7 -1 5
// EXPECT: 0 99 99 255 98 9 2 25
// EXPECT: 9 -1
fn show(c: bool, line: &[u8], i: i64) {
    let a = if c { line[i as usize] } else { 0 };
    let b = if c { 0 } else { line[i as usize] };
    let d = if c { 1 } else if i > 2 { 2 } else { line[i as usize] };
    let e = match i { 0 => 0, 1 => line[0], _ => 255 };
    let f = [0, 1, line[1]];
    let g: u8 = if c { 7 } else { 9 };
    let k = if c { -1 } else { i as i32 };
    let x: f32 = 2.5;
    let m = if c { 0.5 } else { x };
    print("{}", (a as i64));
    print(" ");
    print("{}", (b as i64));
    print(" ");
    print("{}", (d as i64));
    print(" ");
    print("{}", (e as i64));
    print(" ");
    print("{}", (f[2] as i64));
    print(" ");
    print("{}", (g as i64));
    print(" ");
    print("{}", (k as i64));
    print(" ");
    print("{}", ((m * 10.0) as i64));
    println("");
}

fn main() -> i32 {
    show(true, b"abc", 1);
    show(false, b"abc", 2);
    // (only literals: i64)
    let n: i64 = if true { 1 } else { 2 };
    let all = [1i64, 2, 3];
    print("{}", (n << 3 | all[0]));
    print(" ");
    print("{}", (if all[2] > 2 { -1 } else { 0 }));
    println("");
    0
}
