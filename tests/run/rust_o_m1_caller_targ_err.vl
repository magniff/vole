// (0.30.2, obligations M1) rust_o_m1_caller_targ_ok with U = i32: Tr<i32>'s
// impl, whose `'a: 'static` is required at the call (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<U, T: Tr<U>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa); go::<i32, W>(&W { r: st.as_str() })
    };
    println("{}", s);
}
