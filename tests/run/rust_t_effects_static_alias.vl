// EDITION: rust
// RULE: E1.2
// (0.27.2.1) `static` names the effect of a static mut (`global` is its
// alias through 0.27.x); a declaration without it is refused, in words
// that say static.
// ERROR: 'none' is #[effects()], but it touches a static mut or a C static (static): 'bump()' at
static mut N: i64 = 0;

#[effects(static, unsafe)]
fn bump() {
    // UNSAFE: a static mut written.
    // SAFETY: one thread.
    unsafe {
        N += 1;
    }
}

#[effects(global)]
fn old_name() {
    bump();
}

#[effects()]
fn none() {
    bump();
}

fn main() {
    old_name();
    none();
}
