// XFAIL: RT-251: deref coercion (`let r: &T = &b`, `f(&b)`) calls the type's inherent `deref`, not Deref::deref (0.30.2)
// front/check/rust.vl deref_coerce builds `b.deref()` as a method call by
// name with no trait mark, so an inherent `fn deref` of the same name wins:
// vole prints `100 200`, rustc `1 2`. The explicit `*b` and a method call
// through Deref are right since the g302index branch; the coercion is not.
// From the review of g302index (forms t04, t05); v0.30.1 the same.
// EXPECT: 1 2
use std::ops::Deref;

struct B {
    a: i64,
    z: i64,
}

impl B {
    fn deref(&self) -> &i64 {
        &self.z
    }
}

impl Deref for B {
    type Target = i64;

    fn deref(&self) -> &i64 {
        &self.a
    }
}

struct In {
    v: i64,
}

struct C {
    a: In,
    z: In,
}

impl C {
    fn deref(&self) -> &In {
        &self.z
    }
}

impl Deref for C {
    type Target = In;

    fn deref(&self) -> &In {
        &self.a
    }
}

fn take(i: &In) -> i64 {
    i.v
}

fn main() {
    let b = B { a: 1, z: 100 };
    let r: &i64 = &b;
    let c = C { a: In { v: 2 }, z: In { v: 200 } };
    println("{} {}", *r, take(&c));
}
