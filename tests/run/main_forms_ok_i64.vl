// (0.30.2, RT-47's family) main may return an i64 (vole's form, its low
// half the exit status) with argc and argv, whose pointers may be
// `*mut` or `*const` at either level, and the allocator last.
// ARGS: xyz
// EXPECT: 2 x
// EXIT: 5
fn main(argc: i32, argv: *mut *const u8, gpa: Gpa) -> i64 {
    let v: Vec<i32, Gpa> = Vec::new_in(gpa);
    // UNSAFE: argv is C's, a raw pointer the start code passes
    // SAFETY: argv holds argc C strings (ARGS gives one, argv[1] = "xyz")
    let first = unsafe { *(*argv.add(1)) };
    println("{} {}", argc + v.len() as i32, first as char);
    5
}
