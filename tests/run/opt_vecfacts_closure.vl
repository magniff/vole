// EXPECT: inlined 8840
// EXPECT: passed 3960
// EXPECT: reader 245 27
// FLAGS: --check-alloc
// (0.25.4) A closure inside the loop that changes the Vec the loop
// indexes: the closure reaches the Vec through its captures (its
// environment holds the Vec's address), so its pushes and stores are
// stores through a pointer loaded from memory, which middle::vecfacts'
// facts say nothing about: the header is read again after each call.
// Inlined (a closure called where it is made), and given to a function
// that is not inlined; a closure that only reads, beside element stores.
#[inline(never)]
fn apply<F: FnMut(i64)>(f: F, x: i64) {
    f(x);
}

#[inline(never)]
fn inlined(gpa: Gpa) -> i64 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    var s = 0;
    for i in 0..40 {
        var grow = |x: i64| v.push(x);
        grow(i);
        grow(i + 100);
        s += v.len() + v[v.len() - 1] + v[v.len() / 2];
    }
    s
}

#[inline(never)]
fn passed(gpa: Gpa) -> i64 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(5);
    var s = 0;
    var i = 0;
    while i < v.len() && i < 60 {
        apply(|x: i64| v.push(x), v[i] + 1);
        s += v.len() + v[i];
        i += 1;
    }
    s
}

#[inline(never)]
fn reader(v: inout Vec<i64>) -> i64 {
    var s = 0;
    for i in 0..v.len() {
        v[i] = v[i] * 3;
        let peek = |k: i64| k + 1;
        s += peek(v[i]) + v.len();
    }
    s
}

fn main(gpa: Gpa) {
    println(f"inlined {inlined(gpa)}");
    println(f"passed {passed(gpa)}");
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        w.push(i);
    }
    println(f"reader {reader(&w)} {w[9]}");
}
