// EDITION: rust
// RULE: D3.6
// (0.27.1) One `&mut` result dead before the next call.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn x_mut(&mut self) -> &mut i64 {
        &mut self.x
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = s.x_mut();
    *r += 1;
    let q = s.x_mut();
    *q += 1;
    println("{}", s.x);
}
// EXPECT: 3
