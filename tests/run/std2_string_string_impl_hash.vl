// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl Hash.
// EXPECT: true
use std::hash::{BuildHasher, FixedState};

fn main(gpa: Gpa) {
    let a = String::from_in("abc", gpa);
    let h = FixedState::new();
    println("{}", h.hash_one(&a) == h.hash_one("abc"));
}
