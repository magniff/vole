// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::impl Eq.
// EXPECT: true

fn same<T: Eq + ?Sized>(a: &T, b: &T) -> bool {
    a == b
}

fn main() {
    let a: &[i64] = &[1, 2];
    println("{}", same(a, &[1, 2][..]));
}
