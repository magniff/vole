// RULE: F5.5
// (0.30.1) A generic impl's methods are checked against the trait's
// declaration, with its parameters as parameters: a receiver of another
// form (`self` for `&self`), a parameter of another type (U for the
// trait's T), and one parameter too many. rustc E0053, E0053, E0050.
// ERROR: does not have the signature trait 'Tr' declares
// ERROR: does not have the signature trait 'Tr' declares
// ERROR: does not have the signature trait 'Tr' declares
// ERROR-COUNT: 3
trait Tr<T> {
    fn by_ref(&self) -> i64;
    fn put(&mut self, t: T);
    fn one(&self, a: i64) -> i64;
}

struct B<T, U> {
    t: Option<T>,
    u: Option<U>,
}

impl<T, U> Tr<T> for B<T, U> {
    fn by_ref(self) -> i64 {
        1
    }

    fn put(&mut self, u: U) {
        self.u = Some(u);
    }

    fn one(&self, a: i64, b: i64) -> i64 {
        a + b
    }
}

fn main() {
    let b: B<i64, u8> = B { t: None, u: None };
    println("{}", b.t.is_none());
}
