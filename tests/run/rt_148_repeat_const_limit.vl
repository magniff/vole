// RULE: F35.2 (0.30.2, RT-148) A repeat of a constant whose type is not
// Copy makes each element from the constant, at most 4096 of them: a
// longer one is an error, never a copy (rustc builds it: its constant is
// a compile-time value it copies; vole makes a constant at each use,
// F34.2). A Copy constant repeats any length.
// ERROR: at most 4096
// ERROR: line 17, column 17
// ERROR-COUNT: 1
struct D {
    k: i64,
}

const C: Option<D> = None;
const Z: i64 = 0;

fn main() {
    let a = [C; 5000];
    let b = [Z; 100000];
    println("{} {}", a.len(), b.len());
}
