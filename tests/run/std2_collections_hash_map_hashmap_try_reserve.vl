// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::try_reserve.
// EXPECT: true true
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let r = m.try_reserve(16);
    println("{} {}", r.is_ok(), m.capacity() >= 16);
}
