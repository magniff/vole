// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of an element of an owned Vec<String> stored, then the Vec grows
// ERROR: error[borrowck.conflict]
// ERROR: line 9, column 5
fn main(gpa: Gpa) -> i32 {
    let mut owners: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    owners.push(String::from_in("hello", gpa));
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(owners[0].as_str());
    owners.clear();
    println("{}", v[0usize]);
    0
}
