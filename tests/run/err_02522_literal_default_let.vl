// 0.25.2.2 (eval 0.25.2.1: windtunnel): `let value = if c { 1 } else { 0 };`
// passed to a u32 parameter: the error at the use names the let, the
// literal default and the annotation (0.25.2's note; this pins the shape;
// 0.25.3: the note is at the let, the line to change).
// ERROR: expected 'u32', got 'i64'
// ERROR: line 19, column 9: 'value' is 'i64' from its literals (
// ERROR: --old 'let value =' --new 'let value: u32 ='
// ERROR-COUNT: 1
struct Input { left: bool, brush: i64 }

fn stroke(mask: inout Vec<u32>, r: f64, value: u32) {
    mask.push(value);
}

fn main(gpa: Gpa) {
    var mask: Vec<u32> = Vec::new_in(gpa);
    let inp = Input { left: true, brush: 6 };
    if inp.left {
        let value = if inp.left { 1 } else { 0 };
        stroke(&mask, inp.brush as f64, value);
    }
}
