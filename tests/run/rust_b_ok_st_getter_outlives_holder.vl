// EDITION: rust
// RULE: D3.6
// (0.27.1) A getter returning `&'a i64` from `&self`: the result outlives
// the holder.

struct H<'a> {
    r: &'a i64,
}

impl<'a> H<'a> {
    fn get(&self) -> &'a i64 {
        self.r
    }
}

fn main() {
    let x: i64 = 8;
    let z: i64 = 0;
    let mut r = &z;
    {
        let h = H { r: &x };
        r = h.get();
    }
    println("{}", *r);
}
// EXPECT: 8
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
