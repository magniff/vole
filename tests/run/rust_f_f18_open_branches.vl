// RULE: F18.5
// (0.27.4) An `if` with an `else`, a `match` and a block whose values are
// literal trees make the `let` open, as a literal does: the literals take
// the type of the first use that gives one (a range's other end, an
// annotation), or the fallback, i32, at a use that closes it.
// EXPECT: 10 4160749568 2 -3 7 [1, 2]
fn main() {
    let c = true;
    let np: i64 = 5;
    let e0 = if c { 1 } else { 0 };
    let mut s: i64 = 0;
    for i in e0..np {
        s += i;
    }
    let b = if c { 0xf8000000 } else { 0 };
    let x: i64 = b;
    let m = match np {
        5 => 2,
        _ => 3,
    };
    let y: u8 = m;
    let n = if np < 0 { 1 } else if np > 9 { 2 } else { -3 };
    let w = {
        let k = 2;
        k + 5
    };
    let z = { 7 };
    let q: u64 = z;
    let a = if c { [1, 2] } else { [3, 4] };
    let v: [i16; 2] = a;
    println("{} {} {} {} {} {:?}", s, x, y, n, q, v);
    let _ = w;
}
