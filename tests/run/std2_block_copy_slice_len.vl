// (0.29) copy_from_slice still refuses slices of different lengths, before
// anything is copied.
// The std2 item(s): std::slice [T]::copy_from_slice.
// EXIT: 101
// EXPECT: before

fn main() {
    let mut a = [0u8; 8];
    let b = [1u8; 6];
    println("before");
    a.copy_from_slice(&b);
    println("after {:?}", a);
}
