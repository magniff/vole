// `return ..` and `return ..<S as A>::C`: a range is a value `return` takes (exprs::starts_expr, the one list of the kinds an expression starts with; v0.30.1: "empty return in function returning 'RangeFull'"; rustc `.. ..3`)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: .. ..3
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn rf() -> std::ops::RangeFull {
    return ..;
}

fn rt() -> std::ops::RangeTo<i64> {
    return ..<S as A>::C;
}

fn main() {
    println("{:?} {:?}", rf(), rt());
}
