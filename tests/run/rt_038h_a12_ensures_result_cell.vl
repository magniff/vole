// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a12_ensures_result_cell)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'get' calls 'S::bump', which writes through a shared reference (a cell)
// An ensures calls a callee that sets a Cell held by &self.
use std::cell::Cell;
struct S { c: Cell<i64> }

impl S {
    fn bump(&self) -> bool { self.c.set(self.c.get() + 100); true }

    fn get(&self) -> i64
        ensures self.bump()
    {
        self.c.get()
    }
}

fn main() {
    let s = S { c: Cell::new(1) };
    println("{}", s.get());
    println("{}", s.c.get());
}
