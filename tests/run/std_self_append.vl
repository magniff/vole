// EDITION: rust
// XFAIL: gap 17: compile type error: no method 'push_cstr' on type 'Vec<u8, Gpa>'
// FLAGS: --check-unsafe -O1
// EXPECT: buf 3072 ok
// EXPECT: vec 1536 ok
// EXPECT: cstr 13 abcdef abcdef
// 0.14: appending a view of a Buf or Vec to itself: growing must not
// free the memory the view reads (std copies into the new block before
// freeing the old one). --check-unsafe stops a read of freed memory;
// push_cstr of its own bytes appended them forever.
// (0.17 rejects `b.push_str(b.as_slice())`, own.conflict: err_own_self_append;
// --values=off keeps 0.16's semantics, where std's copy still matters.)
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'

fn main(gpa: Gpa) -> i32 {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(b"abc");
    for _ in 0..10 {
        { let at_arg1 = b.as_slice(); b.extend_from_slice(at_arg1) };
    }
    let s = b.as_slice();
    let mut ok = true;
    for i in 0..s.len() {
        ok = ok && s[i] == "abc"[i % 3];
    }
    print("buf ");
    print("{}", (b.len() as i64));
    println("{}", if ok { " ok" } else { " WRONG" });

    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    for _ in 0..9 {
        { let at_arg1 = v.as_slice(); v.extend_from_slice(at_arg1) };
    }
    let t = v.as_slice();
    ok = true;
    for i in 0..t.len() {
        ok = ok && t[i] == (i % 3 + 1) as i64;
    }
    print("vec ");
    print("{}", (v.len() as i64));
    println("{}", if ok { " ok" } else { " WRONG" });

    let mut d = Vec::<u8, _>::new_in(gpa);
    d.extend_from_slice(b"abcdef");
    d.push(0u8);
    unsafe {
        { let at_arg1 = d.as_slice().ptr; d.push_cstr(at_arg1) };
    }
    print("cstr ");
    print("{}", (d.len() as i64));
    print(" ");
    print("{}", str::from_utf8(d.as_slice()[0..6]).unwrap());
    print(" ");
    println("{}", str::from_utf8(d.as_slice()[7..13]).unwrap());
    // (--values=off: nothing drops)
    drop(d);
    drop(v);
    drop(b);
    0
}
