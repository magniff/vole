// FLAGS: --check-unsafe -O1
// EXPECT: buf 3072 ok
// EXPECT: vec 1536 ok
// EXPECT: str 12 abcdefabcdef
// 0.14: appending a Vec's own elements to itself: growing must not free
// the memory the copy reads (std copies into the new block before freeing
// the old one). --check-unsafe stops a read of freed memory.
// (0.28: `v.extend_from_slice(v.as_slice())` is borrowck.conflict,
// err_own_self_append; the self-append is `extend_from_within`, and it is
// the one that must read the elements after the block moved.)

fn main(gpa: Gpa) -> i32 {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(b"abc");
    for _ in 0..10 {
        b.extend_from_within(0..b.len());
    }
    let s = b.as_slice();
    let mut ok = true;
    for i in 0..s.len() {
        ok = ok && s[i] == b"abc"[i % 3];
    }
    println("buf {}{}", b.len(), if ok { " ok" } else { " WRONG" });

    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    for _ in 0..9 {
        v.extend_from_within(0..v.len());
    }
    let t = v.as_slice();
    ok = true;
    for i in 0..t.len() {
        ok = ok && t[i] == (i % 3 + 1) as i64;
    }
    println("vec {}{}", v.len(), if ok { " ok" } else { " WRONG" });

    let mut d = String::new_in(gpa);
    d.push_str("abcdef");
    d.extend_from_within(0..6);
    println("str {} {}", d.len(), d.as_str());
    0
}
