// RT-237's family (RT-211 through a program's fn): a fn returning std's
// partition_in or unzip_in result keeps the items' borrow at its call in
// every shape, `(B, B)`, a nested tuple with its bounds in a `where`, a
// struct of B, `Option<B>`, `impl Debug`, `(FX, FY)` of Map's items (rustc
// 2024: E0505 at the drop). v0.30.1 kept only the `impl Debug` one.
// RUSTC-EDITION: 2024
// ERROR: line 62
// ERROR-COUNT: 6
use std::alloc::Allocator;
use std::fmt::Debug;

struct Two<B> {
    a: B,
    b: B,
}

fn part<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> (B, B) {
    it.partition_in(|_x| true, a)
}

fn part_where<I, B, A>(it: I, a: A) -> ((B, B), i64)
    where
        I: Iterator,
        B: DefaultIn<A> + Extend<I::Item>,
        A: Allocator + Clone,
{
    (it.partition_in(|_x| true, a), 0)
}

fn part_struct<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> Two<B> {
    let (x, y) = it.partition_in(|_x| true, a);
    Two { a: x, b: y }
}

fn part_opt<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> Option<B> {
    let (x, _y) = it.partition_in(|_x| true, a);
    Some(x)
}

fn part_impl<'a, I: Iterator<Item = &'a i64>, A: Allocator + Clone>(it: I, a: A) -> impl Debug {
    let (x, _y): (Vec<&'a i64, A>, Vec<&'a i64, A>) = it.partition_in(|_x| true, a);
    x
}

fn split<I: Iterator<Item = (X, Y)>, X, Y, FX: DefaultIn<A> + Extend<X>,
    FY: DefaultIn<A> + Extend<Y>, A: Allocator + Clone>(it: I, a: A) -> (FX, FY) {
    it.unzip_in(a)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let (p, _q): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = part(v.iter(), gpa);
    let w: ((Vec<&i64, Gpa>, Vec<&i64, Gpa>), i64) = part_where(v.iter(), gpa);
    let t: Two<Vec<&i64, Gpa>> = part_struct(v.iter(), gpa);
    let o: Option<Vec<&i64, Gpa>> = part_opt(v.iter(), gpa);
    let m = part_impl(v.iter(), gpa);
    let (s, _u): (Vec<&i64, Gpa>, Vec<i64, Gpa>) = split(v.iter().map(|e| (e, *e)), gpa);
    drop(v);
    println("{:?} {:?} {:?} {:?} {:?} {:?} {:?}", p, w.0.0, t.a, t.b, o, m, s);
}
