// EDITION: rust
// RULE: D3.6
// XFAIL: bc271 M1 ties every argument to a call's one region (the stopgap until ir271 M1's callee regions)
// (0.27.1) A result tied to the first argument only: the second may die
// first.

fn first<'a, 'b>(x: &'a i64, y: &'b i64) -> &'a i64 {
    if *y > 0 {
        return x;
    }
    x
}

fn main() {
    let a: i64 = 1;
    let mut r = &a;
    {
        let b: i64 = 2;
        r = first(&a, &b);
    }
    println("{}", *r);
}
// EXPECT: 1
