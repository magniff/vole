// EDITION: rust
// RUSTC: none an effect declaration's error: the twin compares the borrow checker's verdicts
// RULE: E2.2
// (0.28.0) std's `#[terminates]` is a promise about std's own loops: what
// a print does for its argument is still the argument's. A Display impl
// with a loop the checker cannot count is `diverge`, and so is the
// function that prints it; a loop of the function's own is too.
// ERROR: 'show' is #[effects(io, static, panic)], but it may not terminate (diverge): 'println("{}", c)'
// ERROR: 'count' is #[effects(io, static, panic)], but it may not terminate (diverge): 'while k != 0 { ..'
// ERROR-COUNT: 2
use std::fmt::{Display, Formatter, Result};

struct Collatz {
    n: u64,
}

impl Display for Collatz {
    fn fmt(&self, f: &mut Formatter<'_>) -> Result {
        let mut n = self.n;
        let mut steps: u64 = 0;
        while n != 1 {
            n = if n % 2 == 0 { n / 2 } else { 3 * n + 1 };
            steps += 1;
        }
        write(f, "{}", steps)
    }
}

#[effects(io, static, panic)]
fn show(c: &Collatz) {
    println("{}", c);
}

#[effects(io, static, panic)]
fn count(n: u64) {
    let mut k = n;
    while k != 0 {
        k = k / 2;
        println("{}", k);
    }
}

fn main() {
    show(&Collatz { n: 27 });
    count(8);
}
