// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Arena::allocated_bytes.
// EXPECT: true true
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    arena.alloc(1i64);
    let one = arena.allocated_bytes();
    arena.alloc_slice_fill_with(10000, |i| i as u8);
    println("{} {}", one >= 8, arena.allocated_bytes() >= one + 10000);
}
