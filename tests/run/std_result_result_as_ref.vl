// Runs on std since 0.27.2's switch.
// The std item(s): std::result Result::as_ref.
// EXPECT: Ok(3) Err("bad")
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let r: Result<&i64, &&str> = a.as_ref();
    println("{:?} {:?}", r, b.as_ref());
}
