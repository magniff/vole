// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Bytes::impl Iterator.
// EXPECT: 97 98 99 None
use std::str::CharIndices;

fn main() {
    let mut b = "abc".bytes();
    let x = b.next().unwrap();
    let y = b.next().unwrap();
    let z = b.next().unwrap();
    println("{} {} {} {:?}", x, y, z, b.next());
}
