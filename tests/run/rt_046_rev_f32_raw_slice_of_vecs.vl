// FLAGS: -O2
// EXPECT: 2 3
// EXPECT: 2050
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn push_through(w: *mut Vec<i64, Gpa>) {
    // UNSAFE: given by the caller
    // SAFETY: main's Vec, no reference to it live
    unsafe {
        (&mut *w).push(9);
    }
}

#[inline(never)]
fn lens(p: *const [Vec<i64, Gpa>], w: *mut Vec<i64, Gpa>) -> (usize, usize) {
    // UNSAFE: given by the caller
    // SAFETY: main's Vecs, no reference to them live
    unsafe {
        let a = (&(*p)[0]).len();
        push_through(w);
        let b = (&(*p)[0]).len();
        (a, b)
    }
}

#[inline(never)]
fn elem(p: *const [Vec<i64, Gpa>], q: *mut i64) -> i64 {
    // UNSAFE: given by the caller
    // SAFETY: main's Vecs
    unsafe {
        let a = (&(*p)[0])[1];
        poke(q, 50);
        let b = (&(*p)[0])[1];
        a * 1000 + b
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v0: Vec<i64, Gpa> = Vec::new_in(gpa);
    v0.push(1);
    v0.push(2);
    let mut vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    vs.push(v0);
    let base = vs.as_mut_ptr();
    // UNSAFE: from base
    // SAFETY: vs has 1 element and is not touched while p is used
    let p = unsafe { std::slice::from_raw_parts_mut(base, 1) as *mut [Vec<i64, Gpa>] as *const [
        Vec<i64, Gpa>] };
    let (x, y) = lens(p, base);
    println("{} {}", x, y);
    // UNSAFE: from base
    // SAFETY: vs[0] has 3 elements
    let q = unsafe { (&mut *base).as_mut_ptr().add(1) };
    println("{}", elem(p, q));
    0
}
