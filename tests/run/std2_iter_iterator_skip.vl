// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::skip.
// EXPECT: [3, 4] 0
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().skip(2).collect_in(gpa);
    println("{:?} {}", a, v.iter().skip(9).count());
}
