// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option<Result<T, E>>::transpose.
// EXPECT: Ok(Some(1)) Err("bad") Ok(None)
use std::option::Option;

fn main() {
    let a: Option<Result<i64, &str>> = Some(Ok(1));
    let b: Option<Result<i64, &str>> = Some(Err("bad"));
    let c: Option<Result<i64, &str>> = None;
    println("{:?} {:?} {:?}", a.transpose(), b.transpose(), c.transpose());
}
