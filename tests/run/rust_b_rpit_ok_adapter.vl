// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.2, D21.3
// (0.27.2.1) The hidden type is an adapter chain over the parameter's
// borrow, `Filter<Iter<'_, i32>, closure>`; a `for` loop takes the result by
// the blanket `IntoIterator` its bound entails.
// EXPECT: 6
fn evens(v: &Vec<i32, Gpa>) -> impl Iterator<Item = &i32> {
    v.iter().filter(|x| **x % 2 == 0)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i32, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(4);
    let mut n = 0;
    for x in evens(&v) {
        n += *x;
    }
    v.push(6);
    println("{}", n);
}
