// XFAIL: RT-201: an ensures reading a by-value parameter that is not Copy and not Drop gives borrowck.use_moved "moved at" the fn header; a Drop type gets the clearer contract.old (0.30.2)
// From the re-review of g302holes.
// ERROR: contract.old
// An ensures reads the non-Copy by-value parameter the body only reads (no shadow).
struct N {
    v: i64,
}

fn f(s: N) -> i64
    ensures s.v == 4
{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
