// RT-34: `ensures` with a `for` over owned values, in `f$body` (the
// body the compiler moves out of f): a range mapped to owned values, a
// Range moved in, nested loops (each row moved out, then each element),
// a part kept in the result and the rest dropped. Each value is dropped
// once, as without the clause; rustc prints the EXPECT lines.
// FLAGS: --check-alloc
// EXPECT: took 10
// EXPECT: drop 10
// EXPECT: took 11
// EXPECT: drop 11
// EXPECT: 2
// EXPECT: 6
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: took 2
// EXPECT: drop 2
// EXPECT: took 3
// EXPECT: drop 3
// EXPECT: 6
// EXPECT: drop 99
// EXPECT: drop 6
// EXPECT: first 5
// EXPECT: drop 5
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

// a range of owned values: each made, moved out, dropped once
fn made(n: i64) -> i64
    ensures result == n
{
    let mut c = 0;
    for d in (0..n).map(|i| D { v: 10 + i }) {
        take(d);
        c += 1;
    }
    c
}

// a Range moved into the for
fn ranged(r: std::ops::Range<i64>) -> i64
    ensures result >= 0
{
    let mut s = 0;
    for i in r {
        s += i;
    }
    s
}

// nested: the outer moves each row out, the inner each element
fn nested(m: Vec<Vec<D, Gpa>, Gpa>) -> i64
    ensures result >= 0
{
    let mut s = 0;
    for row in m {
        for d in row {
            s += d.v;
            take(d);
        }
    }
    s
}

// a part kept: the first one moved into the result, the rest dropped
fn first(v: Vec<D, Gpa>) -> D
    ensures result.v > 0
{
    let mut out = D { v: 99 };
    let mut seen = false;
    for d in v {
        if !seen {
            out = d;
            seen = true;
        }
    }
    out
}

fn main(gpa: Gpa) {
    println("{}", made(2));
    println("{}", ranged(0..4));
    let mut m: Vec<Vec<D, Gpa>, Gpa> = Vec::new_in(gpa);
    m.push(Vec::from_in([D { v: 1 }, D { v: 2 }], gpa));
    m.push(Vec::from_in([D { v: 3 }], gpa));
    println("{}", nested(m));
    let f = first(Vec::from_in([D { v: 5 }, D { v: 6 }], gpa));
    println("first {}", f.v);
}
