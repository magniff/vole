// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map Iter::impl Iterator.
// EXPECT: Some((1, 2)) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let mut it = m.iter();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
