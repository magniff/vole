// Runs on std since 0.27.2's switch.
// The std item(s): std::iter FusedIterator.
// EXPECT: None None
use std::iter::FusedIterator;

fn twice<I: FusedIterator<Item = i64>>(mut it: I) -> (Option<i64>, Option<i64>) {
    let a = it.next();
    (a, it.next())
}

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let (a, b) = twice(v.iter().copied().fuse());
    println("{:?} {:?}", a, b);
}
