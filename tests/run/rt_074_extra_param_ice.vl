// XFAIL: RT-74: an inherent `fn drop(&self, extra: i64)` beside Drop: internal error: arguments of a vole call (0.30.2)
// EXPECT: inherent drop 2 5
// EXPECT: 5
// EXPECT: end
// EXPECT: Drop 2
struct D {
    k: i64,
}

impl D {
    fn drop(&self, extra: i64) -> i64 {
        println("inherent drop {} {}", self.k, extra);
        extra
    }
}

impl Drop for D {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn main() -> i32 {
    let e = D { k: 2 };
    println("{}", e.drop(5));
    println("end");
    0
}
