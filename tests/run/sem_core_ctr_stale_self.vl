// EDITION: rust
// A requires about self.items.len() goes stale after the body pops.
// EXIT: 101
// STDERR: index out of bounds: index 1, length 1
use std::alloc::Allocator; static mut Z: i64 = 0;

struct Stack<A: Allocator> { items: Vec<i64, A> }

impl Stack<Gpa> {
    #[inline(never)]
    fn second_pop(&mut self, i: i64) -> i64
        requires 0 <= i && i < self.items.len() as i64
    {
        self.items.pop();
        self.items[i as usize]
    }
}

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut s = Stack { items: Vec::new_in(gpa) };
    s.items.push(1); s.items.push(2);
    println("{}", s.second_pop(1 + unsafe { Z }));
    0
}
