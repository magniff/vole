// bool -> int, pointer <-> integer round trips and pointer -> pointer.
// EXPECT: 1 0 1 1
// EXPECT: 102030405060708
// EXPECT: 8 1
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn main() -> i64 {
    let t = true;
    let f = false;
    unsafe { printf(c"%d %d %ld %lu\n", t as u8, f as i32, t as i64, t as u64); }
    let mut x: i64 = 0x0102030405060708;
    let p = &mut x as *mut i64;
    let n = p as u64;
    let q = unsafe { n as *mut i64 };
    unsafe { printf(c"%lx\n", *q); }
    let bp = p as *mut u8;
    unsafe { printf(c"%d %d\n", *bp, *((n + 7) as *mut u8)); }
    0
}
