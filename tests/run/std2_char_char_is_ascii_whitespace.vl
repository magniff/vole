// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char char::is_ascii_whitespace.
// EXPECT: true true true false false

fn main() {
    println("{} {} {} {} {}", ' '.is_ascii_whitespace(), '\t'.is_ascii_whitespace(),
        '\x0C'.is_ascii_whitespace(), '\x0B'.is_ascii_whitespace(), '\u{A0}'.is_ascii_whitespace());
}
