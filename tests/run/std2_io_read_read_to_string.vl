// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Read::read_to_string.
// EXPECT: 5 >hello InvalidData
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut r = "hello".as_bytes();
    let mut s = String::from_in(">", gpa);
    let n = r.read_to_string(&mut s).unwrap();
    let bad: &[u8] = &[255];
    let mut r2 = bad;
    let mut t: String<Gpa> = String::new_in(gpa);
    let e = r2.read_to_string(&mut t).unwrap_err();
    println("{} {} {:?}", n, s, e.kind());
}
