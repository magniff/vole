// FLAGS: --trace
// REQUIRES: macos
// EXPECT: 3998000
// EXPECT: in use under 32 MB: true
// 0.30.1: under --trace each thread std::thread spawns gets a stack of
// 64 KB for the handler of a stack overflow's signal; it is freed when the
// thread ends (a pthread key's destructor), so 2000 threads one after
// another hold one at a time, not 2000 (125 MB). (macOS: C's allocator's
// bytes in use, malloc_zone_statistics' size_in_use, the second word.)
use std::thread;

extern "C" {
    fn malloc_zone_statistics(zone: *const u8, stats: *mut u64);
}

fn main(gpa: Gpa) {
    let mut s = 0u64;
    for i in 0..2000u64 {
        let h = thread::spawn_in(move || i * 2, gpa);
        s += h.join().unwrap();
    }
    println("{s}");
    let mut st = [0u64; 4];
    // UNSAFE: C's allocator statistics.
    // SAFETY: st has the 32 bytes of a
    // malloc_statistics_t; a null zone is every zone.
    unsafe { malloc_zone_statistics(0 as *const u8, &mut st[0] as *mut u64) };
    println("in use under 32 MB: {}", st[1] < 32 << 20);
}
