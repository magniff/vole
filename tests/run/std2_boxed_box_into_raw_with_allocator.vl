// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::into_raw_with_allocator.
// EXPECT: 12
// RUSTC: none (Box::into_raw_with_allocator is unstable in Rust (allocator_api))
use std::boxed::Box;

fn main(gpa: Gpa) {
    let (p, a) = Box::into_raw_with_allocator(Box::new_in(11i64, gpa));
    let b = unsafe {
        *p += 1;
        Box::from_raw_in(p, a)
    };
    println("{}", b);
}
