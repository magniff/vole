// RT-34: an `ensures`'s `f$body` lowered under MVS's operand rules: a
// `for` over a local array dropped it again after moving its elements
// out (k06), over a `Vec<D>` parameter read freed memory (k08). With
// them the forms that were right (a `requires`, a plain move, a dropped
// parameter, `while let`), which stay so. rustc prints the EXPECT lines.
// FLAGS: --check-alloc
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: took 2
// EXPECT: drop 2
// EXPECT: 1
// EXPECT: took 3
// EXPECT: drop 3
// EXPECT: 1
// EXPECT: took 4
// EXPECT: drop 4
// EXPECT: 1
// EXPECT: drop 5
// EXPECT: 1
// EXPECT: 4
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

fn local(n: i64) -> i64
    ensures result > 0
{
    let a = [D { v: 1 }];
    for d in a {
        take(d);
    }
    n
}

fn param_vec(v: Vec<D, Gpa>, n: i64) -> i64
    ensures result > 0
{
    for d in v {
        take(d);
    }
    n
}

fn required(a: [D; 1], n: i64) -> i64
    requires n > 0
{
    for d in a {
        take(d);
    }
    n
}

fn moved(a: D, n: i64) -> i64
    ensures result > 0
{
    take(a);
    n
}

fn dropped(a: D, n: i64) -> i64
    ensures result > 0
{
    n
}

fn while_let(v: Vec<Vec<i64, Gpa>, Gpa>) -> i64
    ensures result >= 0
{
    let mut s = 0;
    let mut it = v.into_iter();
    while let Some(x) = it.next() {
        s += x.len() as i64;
    }
    s
}

fn main(gpa: Gpa) {
    println("{}", local(1));
    println("{}", param_vec(Vec::from_in([D { v: 2 }], gpa), 1));
    println("{}", required([D { v: 3 }], 1));
    println("{}", moved(D { v: 4 }, 1));
    println("{}", dropped(D { v: 5 }, 1));
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(Vec::from_in([1i64, 2, 3], gpa));
    v.push(Vec::from_in([4i64], gpa));
    println("{}", while_let(v));
}
