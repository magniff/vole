// (0.25.2.2) A struct literal's let field given a value that may return,
// `Desc { s: d.make(gpa)?, n: 1 }` (s: let Sh): the `?`'s value was lent
// from its match's binding, dropped before the struct was used, in a
// `let`, a call's argument, with or without a requires clause on the
// callee. It is a temporary of the statement now (of the block, for a
// `let` that keeps the view). Its sweep: own_arg_temp_sweep_view{,_req}
// (tools/sinksweep/argsweep.py).
// FLAGS: --check-alloc
// EXPECT: let ok 16
// EXPECT: arg ok 16
// EXPECT: arg? ok 16
// EXPECT: requires ok 16
// EXPECT: match ok 16
// EXPECT: fails err -5

struct Sh {
    names: Vec<i64>,
}

struct Desc {
    s: let Sh,
    n: i64,
}

struct D {
    on: bool,
}

impl D {
    fn make(self, gpa: Gpa, k: i64) -> Result<Sh, i64> {
        if k < 0 {
            return Err(k);
        }
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(k);
        v.push(7);
        Ok(Sh { names: v })
    }

    fn use_r(self, d: Desc, w: i64) -> Result<i64, i64>
        requires self.on
        else "off"
        {
        Ok(d.s.names[1] + d.n + w)
    }

    fn use_d(self, d: Desc, w: i64) -> Result<i64, i64> {
        Ok(d.s.names[1] + d.n + w)
    }
}

fn in_let(d: D, gpa: Gpa) -> Result<i64, i64> {
    let x = Desc { s: d.make(gpa, 3)?, n: 1 };
    d.use_d(x, 8)
}

fn arg(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.use_d(Desc { s: d.make(gpa, 3)?, n: 1 }, 8);
    p
}

fn arg_q(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.use_d(Desc { s: d.make(gpa, 3)?, n: 1 }, 8)?;
    Ok(p)
}

fn requires(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.use_r(Desc { s: d.make(gpa, 3)?, n: 1 }, 8)?;
    Ok(p)
}

fn matched(d: D, gpa: Gpa) -> Result<i64, i64> {
    d.use_r(Desc { s: match d.make(gpa, 3) { Ok(s) => s, Err(e) => return Err(e) }, n: 1 }, 8)
}

fn fails(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.use_r(Desc { s: d.make(gpa, -5)?, n: 1 }, 8)?;
    Ok(p)
}

fn show(n: str, r: Result<i64, i64>) {
    match r {
        Ok(v) => println(f"{n} ok {v}"),
        Err(e) => println(f"{n} err {e}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let d = D { on: true };
    show("let", in_let(d, gpa));
    show("arg", arg(d, gpa));
    show("arg?", arg_q(d, gpa));
    show("requires", requires(d, gpa));
    show("match", matched(d, gpa));
    show("fails", fails(d, gpa));
    0
}
