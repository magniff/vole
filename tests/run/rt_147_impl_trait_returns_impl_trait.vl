// rustc builds it and prints the EXPECT lines; vole refuses both uses in
// main (the opaque type of outer is taken as the opaque type of inner,
// not resolved through it to the closure or the Map). Each inner alone
// works. Since v0.28.0 at least.
// EXPECT: 10
// EXPECT: 6
fn inner(k: i64) -> impl Fn() -> i64 {
    move || k * 2
}

fn outer(k: i64) -> impl Fn() -> i64 {
    inner(k)
}

fn it_inner() -> impl Iterator<Item = i64> {
    (0i64..3).map(|x| x + 1)
}

fn it_outer() -> impl Iterator<Item = i64> {
    it_inner()
}

fn main() {
    let o = outer(5);
    println("{}", o());
    let s: i64 = it_outer().sum();
    println("{}", s);
}
