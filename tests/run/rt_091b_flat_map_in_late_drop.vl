// RT-91's flat_map shape inside a generic Drop impl's late instance (both mechanisms at once).
// EXPECT: ok
// EXPECT: drop 4
struct W<T> {
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let w = [10i64, 20];
        let v = [1i64, 2];
        let t: i64 = w.iter().flat_map(|_y| v.iter().filter(|x| **x > 1)).sum();
        println("drop {t}");
    }
}

fn main() {
    let w = W { t: 1u8 };
    let _ = &w.t;
    println("ok");
}
