// XFAIL: RT-495e: (RT-495's root, a direct call) `let g = st; let r = g(&*b); drop(b);` with `fn st(_x: &i64) -> &'static i64` is refused (borrowck.move_borrowed): a call through the fn value reads the output's 'static by elision from the input; `st(&*b)` itself is accepted; rustc prints 7 (0.30.2)
// From the third re-review of the borrow-check work (g302bor2). Refused on v0.30.1 too.

// EXPECT: 7
static SEVEN: i64 = 7;

fn st(_x: &i64) -> &'static i64 {
    &SEVEN
}

fn main(gpa: Gpa) {
    let b = Box::new_in(1000i64, gpa);
    let g = st;
    let r = g(&*b);
    drop(b);
    println("{}", r);
}
