// EDITION: rust
// RULE: F3.2
// An inherent constant of a generic impl: `W::<i64>::N` and `Self::N`
// read it with the impl's parameters bound by its self type, so its type
// may name them.
// EXPECT: 7 1
struct W<T> {
    t: T,
}

impl<T> W<T> {
    const N: i64 = 3;
    const NONE: Option<T> = Option::None;

    fn n(&self) -> i64 {
        Self::N + 1
    }
}

fn main() {
    let w = W { t: 1u8 };
    print("{}", W::<i64>::N + w.n());
    print(" ");
    let a: Option<i64> = W::<i64>::NONE;
    let b: Option<u8> = W::<u8>::NONE;
    println("{}", if a.is_none() && b.is_none() { 1 } else { 0 });
}
