// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// rustc builds it and prints 64. vole (v0.30.1 and after) dies with a bus
// error (exit 138) after some seconds, in `check` and in a build: a bound
// of T whose argument is T's own projection. The `where` form
// (`where T: H2 + Tr<T::Out>`) and a body that uses neither crash too.
// EXPECT: 64
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H2 {
    type Out;
}

struct W {
    r: i64,
}

impl H2 for W {
    type Out = i64;
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

fn mid<T: H2 + Tr<T::Out>>(t: &T) -> i64 {
    t.g()
}

fn main() {
    println("{}", mid(&W { r: 0 }));
}
