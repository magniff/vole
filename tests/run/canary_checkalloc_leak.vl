// FLAGS: --check-alloc
// EXPECT: done
// STDERR: check-alloc: 1 block of Gpa not freed (8 bytes):
// STDERR: block #1 (8 bytes), allocated at
// STDERR: canary_checkalloc_leak.vl:11:28
// 0.30.1, a canary of --check-alloc's leak report: a Box forgotten is a
// block of Gpa not freed at exit, named with where it was allocated (the
// net's other case, checkalloc_leaks, is an XFAIL: it never ran). A leak
// is reported, not an error: the exit code stays the program's.
fn main(gpa: Gpa) {
    let b: Box<i64, Gpa> = Box::new_in(5, gpa);
    std::mem::forget(b);
    println("done");
}
