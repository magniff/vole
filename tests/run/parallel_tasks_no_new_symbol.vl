// (0.26.3) A C call emitted at -O2: emission (a task of middle::parallel,
// on any thread) compares a CallC with rt.panic and rt.note, made before
// the tasks run. Made by the first task instead, rt.note raced the other
// threads on the symbol table (about 1 compile in 30 of examples/cli died
// in intern, index out of bounds); a task that makes a symbol now dies,
// every time, on one thread or many.
// FLAGS: -O2 --overflow-checks=on
// EXPECT: 5 12
extern "C" {
    fn printf(format: *u8, ...) -> i32;
    fn strlen(s: *u8) -> u64;
}

fn twice(n: i64) -> i64 {
    n * 2 + 2
}

fn main() -> i64 {
    let n = unsafe { strlen(c"hello") } as i64;
    unsafe {
        printf(c"%ld %ld\n", n, twice(n));
    }
    0
}
