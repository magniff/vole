// (0.26.3, decision 6) Integer division and remainder by zero panic at
// every level and on every target, with Rust's message at the operator's
// expression (here at -O2, where the overflow checks are off: a division
// is checked whatever they say). Before 0.26.3 x / 0 was 0 and x % 0 x.
// FLAGS: -O2 --overflow-checks=off
// EXIT: 101
// EXPECT: 0 7 1 -1
// STDERR: arith_div_by_zero.vl:20:19: attempt to calculate the remainder with a divisor of zero

#[inline(never)]
fn zero() -> i64 {
    0
}

fn main() {
    let z = zero();
    let a: i64 = 7;
    let b: u32 = 4294967289;
    println("{} {} {} {}", z / 7, a % (z + 8), (b / 2147483647) as i64, (z - 7) / 7);
    println("{}", b % z as u32);
}
