// RULE: E1.7 (0.30.1) An integer `/` or `%` is `panic` (its lowering
// checks the divisor at every level) unless the divisor is proven: a
// constant that is not 0 nor, signed, -1 (a literal, a negated one, a
// `const`, an integer cast of one, i64::MIN), or an immutable local that
// the conditions around the division prove not 0 and, signed, not -1 or
// not -1 while the dividend is MIN (the branches of an `if`, and what
// follows an `if` whose branch returns). Every function here is
// #[no_panic] and holds; std's checked_div and checked_rem are among
// them, so #[no_panic] code divides through them. The refused forms are
// err_effect_div_unproven.vl.
// EXPECT: 5 3 -7 2 0
// EXPECT: 3 0 None Some(3) None None
// EXPECT: 3 0 3 0 3 0
// EXPECT: -3 0 7 1 0 1
// EXPECT: 3 0 3 0 2 0
const SEVEN: i64 = 7;
const WIDE: u32 = 1000000000;

#[no_panic]
fn consts(x: i64, w: u64) -> i64 {
    // a literal, a `const`, a negated literal, a cast constant, MIN
    x / 2 + x % SEVEN + x / -1000 + (w / WIDE as u64) as i64 + x / i64::MIN
}

#[no_panic]
fn signed_checked(x: i64, d: i64) -> i64 {
    if d == 0 || x == i64::MIN && d == -1 { 0 } else { x / d }
}

#[no_panic]
fn signed_checked_flipped(x: i32, d: i32) -> i32 {
    if 0 == d || -1 == d && i32::MIN == x { 0 } else { x % d }
}

#[no_panic]
fn std_checked(x: i64, d: i64) -> Option<i64> {
    x.checked_div(d)
}

#[no_panic]
fn std_checked_u(x: u8, d: u8) -> Option<u8> {
    x.checked_rem(d)
}

#[no_panic]
fn unsigned_ne(x: u64, d: u64) -> u64 {
    if d != 0 { x / d } else { 0 }
}

#[no_panic]
fn unsigned_else(x: u64, d: u64) -> u64 {
    if d == 0 { 0 } else { x % d }
}

#[no_panic]
fn early_return(x: u32, d: u32) -> u32 {
    if d == 0 {
        return 0;
    }
    x / d
}

#[no_panic]
fn early_return_signed(x: i64, d: i64) -> i64 {
    if d == 0 || d == -1 {
        return 0;
    }
    x / d
}

#[no_panic]
fn signed_positive(x: i64, d: i64) -> i64 {
    if d > 0 { x / d } else { 0 }
}

#[no_panic]
fn signed_negative(x: i64, d: i64) -> i64 {
    if d < -1 { x / d } else { 0 }
}

#[no_panic]
fn unsigned_below(x: u64, d: u64, lo: u64) -> u64 {
    // lo < d: d is at least 1
    if lo < d { x % d } else { 0 }
}

#[no_panic]
fn signed_at_least(x: i64, d: i64) -> i64 {
    if !(d < 1) { x / d } else { 0 }
}

#[no_panic]
fn in_loop(v: &[u64], d: u64) -> u64 {
    let mut t: u64 = 0;
    for i in 0..v.len() {
        if d == 0 {
            break;
        }
        t = t.wrapping_add(v[i] / d);
    }
    t
}

#[no_panic]
fn nested(x: i64, d: i64) -> i64 {
    if d != 0 {
        if d != -1 { x / d } else { 0 }
    } else {
        0
    }
}

fn main() {
    println("{} {} {} {} {}", consts(7, 2000000000) / 1, signed_checked(7, 2),
        signed_checked(-7, 1), signed_checked_flipped(5, 3), signed_checked(i64::MIN, -1));
    println("{} {} {:?} {:?} {:?} {:?}", unsigned_ne(7, 2), unsigned_ne(7, 0), std_checked(7, 0),
        std_checked(7, 2), std_checked(i64::MIN, -1), std_checked_u(7, 0));
    println("{} {} {} {} {} {}", early_return(7, 2), early_return(7, 0), early_return_signed(7, 2),
        early_return_signed(7, -1), signed_positive(7, 2), signed_positive(7, 0));
    println("{} {} {} {} {} {}", signed_negative(7, -2), signed_negative(7, -1),
        unsigned_below(7, 9, 3), unsigned_below(7, 2, 0), unsigned_below(7, 0, 0),
        unsigned_else(7, 2));
    println("{} {} {} {} {} {}", signed_at_least(7, 2), signed_at_least(7, 0),
        in_loop(&[6, 3], 3), in_loop(&[6, 3], 0), nested(4, 2), nested(4, 0));
}
