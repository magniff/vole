// EDITION: rust
// A guarded store to an array element.
// FLAGS: -O2
// EXPECT: 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    let mut a = [1i64, 2, 3];
    let i = -1099511627776 + unsafe { Z };
    while k < 5 + unsafe { Z } { if k > 100 { a[i as usize] = 9; } k += 1; }
    t = a[0];
    println("{}", t);
    0
}
