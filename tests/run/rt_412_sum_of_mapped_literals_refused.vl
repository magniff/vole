// XFAIL: RT-412: `(0..3).map(|i| i * 2000000000).sum()` into an i64 is refused, "the trait 'Sum<i64>' is not implemented for 'i64'"; rustc prints 6000000000. The iter().sum() and Vec map forms are rt_412b/c (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 6000000000
fn main() {
    let v: i64 = (0..3).map(|i| i * 2000000000).sum();
    println("{}", v);
}
