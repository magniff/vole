// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::string String::impl PartialEq<str>; std::string String::impl PartialEq<&str>.
// EXPECT: true false true

fn main(gpa: Gpa) {
    let a = String::from_in("abc", gpa);
    let t: &str = "abc";
    println("{} {} {}", a == *t, a == "x", a == t);
}
