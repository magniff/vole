// EDITION: rust
// RULE: F15.1, F18.5
// (0.27.4) A primitive the program does not name, the u32 that
// `count_ones` returns, still has its impls: an open literal closed by
// one (`acc += k`, AddAssign<u32>) and its Display. A lazy build that
// lacks them fails its check and is made again whole, never another
// reading of the program.
// EXPECT: 4 5
fn main() {
    let mut acc = 0;
    let k = 15i64.count_ones();
    acc += k;
    acc += 1;
    println("{} {}", k, acc);
}
