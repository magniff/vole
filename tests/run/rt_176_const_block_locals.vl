// XFAIL: RT-176: a block with `let` locals as a static's or const's value gives "undefined variable" (the const context has no locals) (0.30.2)
// From the c302const branch's report.
// EXPECT: 2 3
static S: u8 = {
    let v = [1u8, 2];
    v[1]
};
const C: u8 = {
    let v: u8 = 2;
    v + 1
};

fn main() {
    println("{} {}", S, C);
}
