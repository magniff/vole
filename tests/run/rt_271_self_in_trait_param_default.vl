// XFAIL: RT-271: `Self` in a trait parameter's default, `trait Sub<U = <Self as H>::Out>`, is unknown type 'Self' (0.30.2)
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// rustc builds it and prints 1. vole: "unknown type 'Self'" at the default.
// Related to RT-97 (`impl PartialEq<Self>`: Self unknown where the default
// `ne` is checked), which is an impl's argument, not a trait's own default.
// EXPECT: 1
trait H {
    type Out;
}

trait Tr<U> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl H for W {
    type Out = i64;
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        1
    }
}

trait Sub<U = <Self as H>::Out>: H + Tr<U> {}
impl Sub for W {}

fn c2<Z: Sub>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", c2(&W { r: 0 }));
}
