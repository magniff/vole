// EDITION: rust
// RUSTC: none an effect declaration's error: the twin compares the borrow checker's verdicts
// RULE: E3.4a
// (0.28.0, gap 102) std's Hash::hash is `#[pure]`: an impl that prints,
// reads a static or calls a method of its own type parameter that prints
// is refused, whatever the Hasher; and a `#[pure]` function that hashes
// into a Hasher that prints is refused where it is, not in the impl.
// ERROR: 'Chatty::hash' implements 'Hash::hash', which is #[pure], but it does io
// ERROR: 'Seeded::hash' implements 'Hash::hash', which is #[pure], but it touches a static mut or a C static (static)
// ERROR: 'Wrap::hash' implements 'Hash::hash', which is #[pure], but it does io
// ERROR: 'digest' is #[pure], but it does io
// ERROR-COUNT: 4
use std::hash::{DefaultHasher, Hash, Hasher};

struct Chatty {
    x: i64,
}

impl Hash for Chatty {
    fn hash<H: Hasher>(&self, state: &mut H) {
        println("hashing");
        self.x.hash(state);
    }
}

static mut SEED: u64 = 1;

struct Seeded {
    x: u64,
}

impl Hash for Seeded {
    fn hash<H: Hasher>(&self, state: &mut H) {
        // UNSAFE: the case reads a static mut.
        // SAFETY: one thread, and nothing writes SEED.
        let seed = unsafe { SEED };
        (self.x + seed).hash(state);
    }
}

trait Shout {
    fn shout(&self);
}

impl Shout for i64 {
    fn shout(&self) {
        println("{}", *self);
    }
}

struct Wrap<T> {
    inner: T,
}

impl<T: Shout + Hash> Hash for Wrap<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.inner.shout();
        self.inner.hash(state);
    }
}

// A Hasher that prints what it is fed: the Hasher's own effect.
struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

#[pure]
fn digest(x: i64) -> u64 {
    let mut h = Show { n: 0 };
    x.hash(&mut h);
    h.finish()
}

fn main() {
    let mut h = DefaultHasher::new();
    Chatty { x: 1 }.hash(&mut h);
    Seeded { x: 2 }.hash(&mut h);
    Wrap { inner: 3i64 }.hash(&mut h);
    println("{} {}", h.finish(), digest(4));
}
