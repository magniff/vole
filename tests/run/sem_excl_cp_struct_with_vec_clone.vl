// EXPECT: 1 5 2 7
use std::alloc::Allocator; #[derive(Clone)]
struct S<A: Allocator> { v: Vec<i64, A>, n: i64 }

fn main(gpa: Gpa) {
    let mut a = S { v: Vec::new_in(gpa), n: 5 }; a.v.push(1);
    let mut b = a.clone(); b.v.push(2); b.n = 7;
    println("{} {} {} {}", a.v.len(), a.n, b.v.len(), b.n);
}
