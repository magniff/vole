// EDITION: rust
// XFAIL: gap 2: compile type error: no 'split_in' in module 'std'
#[derive(Clone, Copy)] // 0.16: allocation is explicit. main takes the program's Gpa and passes
// it down; the `_in` forms take the allocator: collect_in, format_in,
// split_in, clone_in, sort_stable_in, with_capacity_in, filled_in.
// EXPECT: [0, 1, 4, 9, 16] [3, 2, 1, 0]
// EXPECT: 1 4 [0, 1, 4, 9, 16] true [7, 7, 7]
struct Counter { n: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        Some(self.n)
    }
}

fn squares(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    (0i64..n).map(|x| x * x).collect_in(gpa)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    let s = squares(5, gpa);
    let c = (Counter { n: 4 }).collect_in::<Vec<i64, Gpa>, _>(gpa);
    let b = format_in("{s:?} {c:?}", gpa);
    println("{}", str::from_utf8(b.as_bytes()).unwrap());
    let parts = std::split_in("a,b,,c", b',', gpa);
    let mut w = s.clone_in(gpa);
    w.as_mut_slice().sort_in(gpa);
    let sevens: Vec<i64, Gpa> = Vec::from_elem_in(7i64, 3usize, gpa);
    println("{} {} {w:?} {} {sevens:?}", v.len(), parts.len(), v == v.clone());
}
