// XFAIL: RT-183: in a trait's default method copied into `impl<U> Sz for W<U>`, the method's own type parameter U is read as the impl's U in a projection `U::Out`: wrong types and sizes (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_014_default_method_param_captured_by_impl_param.rs.txt).
// vole prints `5 1 2`, `8 1`, `256` at -O0 and -O2: in W<u8>'s copy of
// `fn width<U: Tr>(self, u: U) -> (Self, usize) { (self, size_of::<U::Out>()) }`
// called with U = bool, `U::Out` is u8's Out (i64, 8 bytes), not bool's (u8,
// 1 byte), and the other way round for W<bool>; `pair`'s result type
// `Pair<Self, U::Out>` gives q.b the type i64, so `q.b.wrapping_add(255)` is
// 256 where rustc's u8 gives 0 (`let zb: u8 = z.b;` is refused: expected
// 'u8', got 'i64'). Renaming the method's parameter (V) makes it right. std's
// `Iterator::zip<U: IntoIterator>(..) -> Zip<Self, U::IntoIter>` copied into
// `FlatMap<I, U, F>` is the same: `(0..3).flat_map(|x| 0..x).zip((0..15).rev())`
// fails inside std (`<std>:16813:24: expected 'Range<i64>', got
// 'Rev<Range<i64>>'`). Since v0.28.0 (v0.28.0 to v0.30.1, g302probe).
// EXPECT: 5 1 2
// EXPECT: 1 8
// EXPECT: 0
use std::mem::size_of;

trait Tr {
    type Out;

    fn out(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = i64;

    fn out(self) -> i64 {
        self as i64 * 10
    }
}

impl Tr for bool {
    type Out = u8;

    fn out(self) -> u8 {
        if self { 1 } else { 0 }
    }
}

struct Pair<A, B> {
    a: A,
    b: B,
}

trait Sz: Sized {
    fn pair<U: Tr>(self, u: U) -> Pair<Self, U::Out> {
        Pair { a: self, b: u.out() }
    }

    fn width<U: Tr>(self, u: U) -> (Self, usize) {
        (self, size_of::<U::Out>())
    }
}

struct W<U> {
    u: U,
}

impl<U> Sz for W<U> {}

fn main() {
    let w = W { u: 5u8 };
    let p = w.pair(true);
    println("{} {} {}", p.a.u, p.b, size_of::<Pair<W<u8>, u8>>());
    let x = W { u: 5u8 }.width(true);
    let y = W { u: true }.width(5u8);
    println("{} {}", x.1, y.1);
    let q = W { u: 5u8 }.pair(true);
    let m = q.b.wrapping_add(255);
    println("{}", m);
}
