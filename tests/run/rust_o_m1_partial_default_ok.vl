// EXPECT: 1
// A bound with fewer arguments than its trait has parameters, the rest defaulted:
// `T: Tr<i32>` of `trait Tr<A, B = A>` is Tr<i32, i32> (v0.30.1 read past the written ones and stopped).
trait Tr<A, B = A> { fn g(&self) -> i64; }
struct W { r: i64 }
impl Tr<i32, i32> for W { fn g(&self) -> i64 { 1 } }
fn need<Z: Tr<i32, i32>>(z: &Z) -> i64 { z.g() }
fn mid<T: Tr<i32>>(t: &T) -> i64 { need(t) }
fn main() { println("{}", mid(&W { r: 0 })); }
