// sem-own: `w[0].v.take()` is fine; a sink-self method on `w[0].v`: own.move_out.
// ERROR: own.move_out
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
impl D<Gpa> { fn fin(sink self) {} }
struct P<A: Allocator> { d: D<A> }

fn main(gpa: Gpa) {
    var w: Vec<P<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(P { d: mk(1, gpa) });
    w[0].d.fin();
}
