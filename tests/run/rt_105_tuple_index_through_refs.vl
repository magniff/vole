// XFAIL: RT-105: a tuple index does not auto-deref through two references or a Box: `v.iter().filter(|p| p.0 > 0)` is refused (0.30.2)
// rustc auto-derefs `e.0` as it does `e.x`: through any number of
// references and through Box (Deref). vole refuses `r.1` on `&&(i64,
// i64)` (`cannot use tuple index on type '&&(i64, i64)'`), `mm.0` on `&mut
// &mut (i64, i64)`, and `b.0` on a Box<(i64, i64)> (`cannot access field
// '0' on type '(i64, i64)'`), while the same through a named field (`q.x`
// on `&&&P`) works. The common form is a filter closure over iter() of
// pairs, whose argument is `&&(A, B)`. Since 0.28.0.
// EXPECT: 11 3 4 2 6 5
struct P {
    x: i64,
}

fn main(gpa: Gpa) {
    let mut t = (1i64, 2i64);
    {
        let m = &mut t;
        let mm = &mut &mut *m;
        mm.0 += 10;
    }
    let b = Box::new_in((3i64, 4i64), gpa);
    let rb = &b;
    let r = &&t;
    let v = [(5i64, 6i64), (-1, 7)];
    let s: i64 = v.iter().filter(|p| p.0 > 0).map(|p| p.1).sum();
    let p = P { x: 5 };
    let q = && &p;
    println("{} {} {} {} {} {}", t.0, b.0, rb.1, r.1, s, q.x);
}
