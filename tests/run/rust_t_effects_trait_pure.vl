// (0.28.0) PartialEq::eq and Ord::cmp are #[pure], and
// Allocator::deallocate is #[effects(alloc, static, panic, diverge,
// unsafe)], as MVS's Eq::eq, Ord::cmp and Allocator::free: an impl is
// checked against them.
// ERROR: 'V::eq' implements 'PartialEq::eq', which is #[pure], but it touches a static mut or a C static (static)
// ERROR: 'W::cmp' implements 'Ord::cmp', which is #[pure], but it does io
// ERROR: 'Loud::deallocate' implements 'Allocator::deallocate', which is #[effects(alloc, static, panic, diverge, unsafe)], but it does io
// ERROR-COUNT: 3
use std::alloc::{AllocError, Allocator, Layout};
use std::cmp::Ordering;
use std::ptr::NonNull;

static mut CALLS: i64 = 0;

struct V {
    n: i64,
}

impl PartialEq for V {
    fn eq(&self, o: &V) -> bool {
        // UNSAFE: a test's static counter.
        // SAFETY: one thread.
        unsafe {
            CALLS += 1;
        }
        self.n == o.n
    }
}

#[derive(PartialEq, Eq, PartialOrd)]
struct W {
    n: i64,
}

impl Ord for W {
    fn cmp(&self, o: &W) -> Ordering {
        println("cmp");
        self.n.cmp(&o.n)
    }
}

#[derive(Clone, Copy)]
struct Loud {}

// UNSAFE: a test's allocator.
// SAFETY: it hands out no memory: allocate fails.
unsafe impl Allocator for Loud {
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        Err(AllocError)
    }

    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {
        println("free");
    }
}

fn main() -> i32 {
    println("{}", V { n: 1 } == V { n: 2 });
    println("{}", W { n: 1 } < W { n: 2 });
    0
}
