// EDITION: rust
// XFAIL: gap 20: xfail case fails differently after translation
// MVS's XFAIL: DIAG &(if c { a } else { b }) is "cannot take address of non-lvalue expression", not conv.place
// an if expression choosing between places is not a place
// ERROR: conv.place
fn bump(n: &mut i64) { *n += 1; }

fn main() {
    let mut a: i64 = 1; let mut b: i64 = 1; let c = true; bump(&(if c { a } else { b }));
    println("{a}");
}
