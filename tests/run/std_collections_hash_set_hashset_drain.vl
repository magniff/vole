// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::collections::hash_set HashSet::drain.
// EXPECT: [1, 2] 0
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(2);
    s.insert(1);
    let mut v: Vec<i64, Gpa> = s.drain().collect_in(gpa);
    v.sort();
    println("{:?} {}", v, s.len());
}
