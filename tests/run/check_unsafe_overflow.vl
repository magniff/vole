// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: 45
// STDERR: unsafe access out of bounds (just past the end): 8 bytes at offset 80 of a block of 80 bytes
// STDERR: check_unsafe_overflow.vl: line 26, column 22
// 0.10: --check-unsafe finds an access past the end of a heap block.
extern "C" {
    fn printf(f: *const u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn fflush(f: *mut u8) -> i32;
}

fn main() -> i32 {
    let p = unsafe { malloc(80) as *mut i64 };
    for i in 0..10 {
        unsafe { (*p.add(i as usize)) = i; }
    }
    let mut s: i64 = 0;
    for i in 0..10 {
        unsafe { s += (*p.add(i as usize)); }
    }
    unsafe {
        printf(c"%ld\n", s);
        fflush(0 as *mut u8);
    }
    let x = unsafe { (*p.add(10)) };
    x as i32
}
