// RULE: F34.4 (0.30.2) The parts of a loop outside its body: a `while`'s
// condition, a `for`'s iterator, are not in the loop's reach (body.vl
// check_while, check_for), so a `break` or `continue` there leaves the
// constant's value; and a label of the using function is out of the
// value's reach. rustc refuses each (E0590, E0268, E0426).
// ERROR: line 15
// ERROR: line 20
// ERROR: line 24
// ERROR-COUNT: 3
struct D {
    k: i64,
}

const W: i64 = {
    while { break; true } {} // error here
    1
};

const F: i64 = {
    for _x in { continue; [1] } {} // error here
    2
};

const L: D = { 'o: loop { break; } loop { break 'p; } D { k: 1 } }; // error here

fn main() {
    'p: loop {
        let a = W;
        let b = F;
        let c = L;
        println("{} {} {}", a, b, c.k);
        break;
    }
}
