struct Group { id: i64 }

impl Drop for Group {
    fn drop(&mut self) {}
}

struct D { h: i64 }

impl Drop for D {
    fn drop(&mut self) {}
}

impl Default for D {
    fn default() -> D {
        D { h: 0 }
    }
}

struct Sim { g0: Group, g1: Group, d: D }

fn dispatch(g: &Group) {}

fn keep(d: &D) {}

impl Sim {
    fn step(&mut self, k: i64) {
        let g = if k == 0 { self.g0 } else { self.g1 };
        dispatch(&g);
    }

    fn pick(&mut self, k: i64) -> Group {
        match k {
            0 => self.g0,
            _ => Group { id: 1 },
        }
    }

    fn first(&mut self) -> Group {
        self.g0
    }

    fn data(&mut self, k: i64) {
        let d = if k == 0 { self.d } else { D { h: 1 } };
        keep(&d);
    }
}

