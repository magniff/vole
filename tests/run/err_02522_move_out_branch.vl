use std::Default;

struct Group { id: i64 }

impl Drop for Group {
    fn drop(inout self) {}
}

struct D { h: i64 }

impl Drop for D {
    fn drop(inout self) {}
}

impl Default for D {
    fn default() -> D {
        D { h: 0 }
    }
}

struct Sim { g0: Group, g1: Group, d: D }

fn dispatch(g: Group) {}

fn keep(d: D) {}

impl Sim {
    fn step(inout self, k: i64) {
        let g = if k == 0 { self.g0 } else { self.g1 };
        dispatch(g);
    }

    fn pick(inout self, k: i64) -> Group {
        match k {
            0 => self.g0,
            _ => Group { id: 1 },
        }
    }

    fn first(inout self) -> Group {
        self.g0
    }

    fn data(inout self, k: i64) {
        let d = if k == 0 { self.d } else { D { h: 1 } };
        keep(d);
    }
}

fn main() {}
