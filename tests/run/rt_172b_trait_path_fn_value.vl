// XFAIL: RT-172: a trait path used as a fn value, `let f: fn() -> S = Mk2::mk;`, is refused ("'Mk2' is a trait, not a type") (0.30.2)
// From the g302qual review (form f43b_trait_path_no_const).
// EXPECT: 1 2 5 2
trait Mk { fn mk() -> Self; }
trait Mk2 { fn mk() -> Self; }
#[derive(Debug)]
struct S { v: i64 }
impl Mk for S { fn mk() -> S { S { v: 1 } } }
impl Mk2 for S { fn mk() -> S { S { v: 2 } } }

fn main() {
    let a: S = Mk::mk(); let b: S = Mk2::mk(); let f: fn() -> S = Mk2::mk;
    println("{} {} {} {}", a.v, b.v, 5, f().v);
}
