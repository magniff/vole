// RULE: Z9.1c
// (0.27.6) Through a bounded parameter `a: A`, `a.clone()`,
// `Clone::clone(&a)` and `A::clone(&a)` are the bound's clone of the type
// A stands for: with A = &Gpa each is a `&Gpa` (0.27.5 took Gpa's clone
// through the reference, "expected &Gpa, got Gpa").
// EXPECT: 3 3
use std::alloc::Allocator;

fn two<A: Allocator + Clone>(a: A) -> usize {
    let b: A = a.clone();
    let c: A = Clone::clone(&a);
    let d: A = A::clone(&a);
    let mut v = Vec::<i64, A>::new_in(b);
    let mut w = Vec::<i64, A>::new_in(c);
    let mut x = Vec::<i64, A>::new_in(d);
    v.push(1);
    w.push(2);
    x.push(3);
    v.len() + w.len() + x.len()
}

fn main(gpa: Gpa) {
    println("{} {}", two(&gpa), two(gpa));
}
