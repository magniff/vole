// (0.30.1, RT-24) What each literal's escapes may give, as Rust's: a
// byte string's and a byte's `\x` any byte; a C string's too; a str's and
// a char's `\x` ASCII, and `\u{...}` any scalar as UTF-8.
// EXPECT: [255, 128, 65] 255 255
// EXPECT: 7f 3 true 233 127
extern "C" {
    fn strlen(s: *const u8) -> usize;
}

fn main() {
    let b = b"\xFF\x80\x41";
    let c = b'\xFF';
    let p = c"\xFF";
    // UNSAFE: C's strlen of a C string literal.
    // SAFETY: the literal is NUL-terminated and lives for the program.
    let n = unsafe { strlen(p) };
    println("{:?} {} {}", b, c, if n == 1 { 255 } else { 0 });
    let s = "\x7F\u{e9}";
    let ch = '\u{e9}';
    let a = '\x7F';
    println("{:x} {} {} {} {}", s.as_bytes()[0], s.len(), std::str::from_utf8(s.as_bytes()).is_ok(),
        ch as u32, a as u32);
}
