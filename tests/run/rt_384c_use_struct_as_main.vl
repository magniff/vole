// XFAIL: RT-384: `use m::S as main;` (a struct) beside `fn main` is refused; rustc accepts (0.30.2)
// From the re-review of the std and raw-pointer work. Since v0.30.1 at least.
// EXPECT: 31
mod m { pub struct S { pub x: i32 } }
use m::S as main;
fn get(s: &main) -> i32 { s.x }
fn main() { let s = m::S { x: 31 }; println("{}", get(&s)); }
