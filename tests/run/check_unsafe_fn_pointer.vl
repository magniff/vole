// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: copied 16
// STDERR: unsafe access out of bounds: 17 bytes at offset 0 of a block of 16 bytes
// STDERR: --> memcpy, its destination
// 0.30.1: under --check-unsafe a C function's address is its wrapper's,
// as its calls are: memcpy through a fn pointer checks its bytes first, 16
// into a block of 16 passes, 17 is stopped. (Earlier on 0.30.1's branch
// the pointer was C's own memcpy, unchecked.)
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;
}

fn main() {
    let src = [7u8; 32];
    // UNSAFE: a copy in the block, then deliberately one byte past it.
    // SAFETY: none for the second: the program exists to be stopped.
    unsafe {
        let p = malloc(16);
        let m: unsafe extern "C" fn(*mut u8, *const u8, usize) -> *mut u8 = memcpy;
        m(p, &src[0] as *const u8, 16);
        println("copied {}", *p.add(15) + 9);
        m(p, &src[0] as *const u8, 17);
        println("copied 17");
    }
}
