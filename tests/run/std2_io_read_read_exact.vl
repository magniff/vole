// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io Read::read_exact.
// EXPECT: [1, 2] UnexpectedEof
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut buf = [0u8; 2];
    r.read_exact(&mut buf).unwrap();
    let e = r.read_exact(&mut buf).unwrap_err();
    println("{:?} {:?}", buf, e.kind());
}
