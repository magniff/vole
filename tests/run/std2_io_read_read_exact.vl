// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::io Read::read_exact.
// EXPECT: [1, 2] UnexpectedEof
use std::io::{BufRead, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut buf = [0u8; 2];
    r.read_exact(&mut buf).unwrap();
    let e = r.read_exact(&mut buf).unwrap_err();
    println("{:?} {:?}", buf, e.kind());
}
