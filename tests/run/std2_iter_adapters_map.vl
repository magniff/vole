// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Map.
// EXPECT: [2, 4]
use std::iter::{FusedIterator, Map};

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let v: Vec<i64, Gpa> = s.iter().map(|x| x * 2).collect_in(gpa);
    println("{:?}", v);
}
