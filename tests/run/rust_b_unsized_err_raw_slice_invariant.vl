// EDITION: rust
// RULE: Z9.1, D5.2
// (0.27.2) A `*mut [&'a i64]` has no region of its own and is invariant in
// its element's: returning a `*mut [&'static i64]` as one of `'a` needs
// `'a: 'static`. Making it by a slicing cast takes no loan (R1).
fn shrink<'a>(p: *mut [&'static i64], q: *mut [&'a i64]) -> *mut [&'a i64] {
    let _ = q;
    p
}

// (0.28.0) A static's borrow, not `&7`: an array's elements have regions
// (D3.3), and a promoted literal's temporary is the body's, not 'static
// (no rvalue static promotion, D6.2.2).
static SEVEN: i64 = 7;

fn main() {
    let x: i64 = 1;
    let mut a: [&'static i64; 1] = [&SEVEN];
    let p: *mut [&'static i64] = &mut a[..] as *mut [&'static i64];
    let mut b: [&i64; 1] = [&x];
    let q: *mut [&i64] = &mut b[..] as *mut [&i64];
    let _r = shrink(p, q);
}
