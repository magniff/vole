use std::thread;
use std::sync::Mutex;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

static HITS: AtomicI64 = AtomicI64::new(0i64);

fn main() {
    let m = Mutex::new(0i64);
    thread::scope(|s| ({ let s = s; {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..1000 {
                    m.with(|n| *n += 1);
                    HITS.fetch_add(1, Ordering::Relaxed);
                }
                0
            });
        }
        m.with(|n| *n += 1);
        0
    } }));
    println("{} {}", m.with(|n| *n), HITS.load(Ordering::SeqCst));
}
