// EXPECT: -1 0 1
// EXPECT: neg low mid max high
// EXPECT: k=7, plain [  7]
// 0.17: a range pattern's bounds may be constants' paths (`i8::MIN..=-1`,
// `0..=m::TOP`, `i64::MAX` alone); `b.push_fmt("{k}")` formats.

const LIMIT: i64 = 100;

mod m {
    pub const TOP: i64 = 50;
}

fn sign(x: i8) -> i64 {
    match x {
        i8::MIN..=-1 => -1,
        0 => 0,
        1..=i8::MAX => 1,
    }
}

fn bucket(x: i64) -> &'static str {
    match x {
        i64::MIN..=-1 => "neg",
        0..=m::TOP => "low",
        51..=LIMIT => "mid",
        i64::MAX => "max",
        _ => "high",
    }
}

fn more(b: &mut String<Gpa>, k: i64) {
    std::fmt::write(&mut *b, " [{k:>3}]").unwrap();
}

fn main(gpa: Gpa) {
    println("{} {} {}", sign(-5), sign(0), sign(7));
    println("{} {} {} {} {}", bucket(-3), bucket(10), bucket(70), bucket(i64::MAX), bucket(200));
    let mut b: String<Gpa> = String::new_in(gpa);
    let k: i64 = 7;
    std::fmt::write(&mut b, "k={k}, ").unwrap();
    b.push_str("plain");
    more(&mut b, k);
    println("{}", b.as_str());
}
