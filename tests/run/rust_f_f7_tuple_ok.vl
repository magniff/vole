// EDITION: rust
// RULE: F7.1, F7.2
// A tuple struct's fields are 0, 1, ..: read and written as `p.0`, also
// through a reference; `Pair(a, b)` makes one, its type arguments
// inferred as a generic function's or taken from the expected type.
// EXPECT: 26
struct Pair(i64, pub i64);

struct Wrap<T>(T);

fn sum(p: &Pair) -> i64 {
    p.0 + p.1
}

fn main() -> i64 {
    let mut p = Pair(3, 4);
    p.0 = 10;
    let w = Wrap(5);
    let ws: Wrap<i64> = Wrap(7);
    std::print_int(sum(&p) + w.0 + ws.0);
    println("");
    0
}
