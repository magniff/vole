// RULE: D22.2
// (0.28.0) A closure written in a generic function and given to an
// adapter: what the opaque instance's check instantiates with the
// closure's type (`Range::map`, `Option::map`) is the opaque instance's,
// not lowered; at -O0 it was emitted and called the closure's body,
// which is not ("undefined symbol 'vole.apply.GQ.._.0'").
// EXPECT: 6 9 5
fn apply<F: Fn(i64) -> i64>(f: F) -> i64 {
    (0..3i64).map(|x| f(x)).sum()
}

fn twice<T: Copy + Into<i64>>(t: T) -> i64 {
    (0..3i64).map(|x| x + t.into()).sum()
}

fn nested<F: Fn(i64) -> i64>(f: F) -> i64 {
    let g = |a: i64| (0..2i64).map(|x| f(x) + a).sum::<i64>();
    g(1)
}

fn main() -> i32 {
    println("{} {} {}", apply(|x| x * 2), twice(2i32), nested(|x| x * 3));
    0
}
