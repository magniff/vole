// EDITION: rust
// RULE: D8.3
// (0.27.1) M6: a `Copy` struct is copied, not moved.

#[derive(Clone, Copy)]
struct C {
    v: i64,
}

fn main() {
    let c = C { v: 1 };
    let a = c;
    let b = c;
    println("{} {} {}", a.v, b.v, c.v);
}
// EXPECT: 1 1 1
