// EDITION: rust
// RULE: D4.2
// (0.27.2) Two references in the inputs and a type parameter: E2 does
// not apply (the type parameter's slots do not count), so the result's
// elided lifetime is E4's error (rustc E0106).
// ERROR: error[borrowck.elision]
fn pick<T>(a: &i64, b: &i64, x: T) -> &i64 {
    let _ = x;
    let _ = b;
    a
}

fn main() {
    let k = 1;
    let _r = pick(&k, &k, 3);
}
