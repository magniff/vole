// RULE: F32.2
// Deref coercion through Deref at an argument: `&Box<i64, Gpa>` where
// `&i64` is expected, and in a generic call `&Box<List<A>, A>` where
// `&List<A>` is, which binds A.
// EXPECT: 5
// EXPECT: 6
use std::alloc::Allocator;
use std::boxed::Box;

enum List<A: Allocator> {
    Cons(i64, Box<List<A>, A>),
    Nil,
}

fn sum<A: Allocator>(l: &List<A>) -> i64 {
    match l {
        List::Cons(x, rest) => *x + sum(rest),
        List::Nil => 0,
    }
}

fn f(x: &i64) -> i64 {
    *x
}

fn main(gpa: Gpa) {
    let b = Box::new_in(5i64, gpa);
    println("{}", f(&b));
    let l = List::Cons(1,
        Box::new_in(List::Cons(2, Box::new_in(List::Cons(3, Box::new_in(List::Nil, gpa)), gpa)),
            gpa));
    println("{}", sum(&l));
}
