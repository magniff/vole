// RULE: M3
// (0.30.1) rust_b_err_mv_static_names's tries applied: the static borrowed
// where it is read (`&SE`, `&ST`), or each alternative's binder `ref`.
// EXPECT: 3
// EXPECT: 3
// EXPECT: 2
// EXPECT: 1 4 5
struct D {
    v: i64,
}

struct W {
    d: D,
}

enum E {
    A(D),
    B(D),
}

static SD: D = D { v: 1 };
static SW: W = W { d: D { v: 2 } };
static SE: E = E::A(D { v: 3 });
static ST: (D, i64) = (D { v: 4 }, 5);

fn main() {
    let t = &SD;
    match &SE {
        E::A(d) | E::B(d) => println("{}", d.v),
    }
    match SE {
        E::A(ref d) | E::B(ref d) => println("{}", d.v),
    }
    let (a, n) = &ST;
    match &SW {
        W { d } => println("{}", d.v),
    }
    println("{} {} {}", t.v, a.v, n);
}
