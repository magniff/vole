// EDITION: rust
// RULE: F13.3
// Two impls of one generic trait whose function takes its own parameter
// `I: IntoIterator<Item = X>`: the argument's Item picks the impl, as
// Vec's Extend<T> and Extend<&T>.
// EXPECT: 6
// EXPECT: 60
trait Add<X> {
    fn add_all<I: IntoIterator<Item = X>>(&mut self, it: I);
}

struct S {
    n: i64,
}

impl Add<i64> for S {
    fn add_all<I: IntoIterator<Item = i64>>(&mut self, it: I) {
        for x in it {
            self.n += x;
        }
    }
}

impl<'a> Add<&'a i64> for S {
    fn add_all<I: IntoIterator<Item = &'a i64>>(&mut self, it: I) {
        for x in it {
            self.n += *x * 10;
        }
    }
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3], gpa);
    let mut s = S { n: 0 };
    s.add_all(v.iter().copied());
    println("{}", s.n);
    let mut t = S { n: 0 };
    t.add_all(v.iter());
    println("{}", t.n);
}
