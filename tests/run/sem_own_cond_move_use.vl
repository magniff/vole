// sem-own: using a value after it was moved on one branch is own.moved.
// ERROR: own.moved
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) {}

fn run(c: bool, gpa: Gpa) {
    let d = mk(1, gpa);
    if c { eat(d); }
    println("{}", d.id);
}

fn main(gpa: Gpa) { run(true, gpa); }
