// EDITION: rust
// FLAGS: -C target-cpu=generic
// ARGS: hello w
// EXPECT: argc 3, argv[1] hello, crc 3
// (0.19.0) main's first call fills std::arch::detect's word; with a Gpa
// parameter first, lowering puts an instruction before main's parameters,
// and the call went there (-O2 on aarch64-linux: getauxval inlined
// before argc and argv were taken, a crash reading argv[1]). It goes after
// the last parameter.
use std::arch::detect;

fn main(gpa: Gpa, argc: i64, argv: *mut *mut u8) -> i32 {
    let first = if argc
        > 1 {
        unsafe { std::slice::from_raw_parts((*argv.add(1)).add((0) as usize), (5 - (0)) as usize) }
    } else { b"" };
    let crc: i64 = if detect("crc") { 3 } else { 3 };
    println("argc {argc}, argv[1] {first}, crc {crc}", first = str::from_utf8(first).unwrap());
    let _ = gpa;
    0
}
