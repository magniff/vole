// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Cycle::impl Iterator.
// EXPECT: Some(1) Some(2) Some(1) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut it = s.iter().cycle();
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?} {:?}", a, b, it.next(), e.iter().cycle().next());
}
