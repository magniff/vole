// EDITION: rust
// a generic with a let T calling an inout-self method
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 7, column 26
trait B { fn bump(&mut self); }
impl B for i64 { fn bump(&mut self) { *self += 1; } }
fn use_it<T: B>(x: &T) { x.bump(); }

fn main() {
    let n: i64 = 1;
    use_it(&n);
    println("{n}");
}
