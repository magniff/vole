// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter IntoIterator.
// EXPECT: 6
use std::alloc::Allocator;

struct Bag<A: Allocator> {
    v: Vec<i64, A>,
}

impl<A: Allocator> IntoIterator for Bag<A> {
    type Item = i64;
    type IntoIter = std::vec::IntoIter<i64, A>;

    fn into_iter(self) -> std::vec::IntoIter<i64, A> {
        self.v.into_iter()
    }
}

fn main(gpa: Gpa) {
    let mut s = 0;
    for x in (Bag { v: Vec::from_in([1i64, 2, 3], gpa) }) {
        s += x;
    }
    println("{}", s);
}
