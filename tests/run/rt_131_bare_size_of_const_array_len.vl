// XFAIL: RT-131: a const whose value is a bare size_of::<T>() call is refused as an array length ("made at each use"); size_of::<T>() + 0 is accepted (0.30.2)
// rustc accepts both. Found by the review of g302std; v0.30.1 too.
// EXPECT: 8 18
use std::mem::size_of;

struct C {
    a: u32,
    b: u8,
}

const M: usize = size_of::<C>();

struct B {
    r: [u16; M],
    s: u8,
}

fn main() {
    println("{} {}", M, size_of::<B>());
}
