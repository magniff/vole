// RULE: AT6
// (0.27.2) A thread borrows a Cell: the closure is Send only if `Cell<i64>:
// Sync`, which it is not (AT1; rustc E0277).
use std::thread;
use std::cell::Cell;

fn main() {
    let c = Cell::new(1);
    thread::scope(|s| {
        s.spawn(|| {
            println("{}", c.get());
        });
    });
}
// ERROR: error[sync.not_send]
// ERROR: line 10, column 9
// ERROR-COUNT: 1
