// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a39_old_rawptr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// old(..) calls a callee writing through a *mut parameter.
fn poke(p: *mut i64) -> i64 {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    1
}

fn f(p: *mut i64) -> i64
    ensures old(poke(p)) == 1
{
    2
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x));
    println("{}", x);
}
