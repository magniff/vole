// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt LowerHex::fmt.
// EXPECT: ff
use std::fmt::{Formatter, LowerHex};

struct W {
    v: u32,
}

impl LowerHex for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = LowerHex::fmt(&W { v: 255u32 }, &mut f);
    println("{}", s);
}
