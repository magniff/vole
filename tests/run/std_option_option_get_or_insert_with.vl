// Runs on std since 0.27.2's switch.
// The std item(s): std::option Option::get_or_insert_with.
// EXPECT: Some(4) Some(1) 1
use std::option::Option;

fn main() {
    let mut calls = 0;
    let mut a: Option<i64> = None;
    a.get_or_insert_with(|| { calls += 1; 4 });
    let mut b: Option<i64> = Some(1);
    b.get_or_insert_with(|| { calls += 1; 4 });
    println("{:?} {:?} {}", a, b, calls);
}
