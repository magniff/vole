// RULE: D8.6
// (0.27.2.1) A move out of an array's element by a variable index, into a
// call (rustc E0508: cannot move out of a non-copy array).
// ERROR: error[borrowck.move_out]: cannot move out of 'a[_]', an element of an array whose type is not Copy
// ERROR-COUNT: 1
struct N {
    v: i64,
}

fn take(n: N) -> i64 {
    n.v
}

fn main() {
    let a = [N { v: 1 }, N { v: 2 }];
    let i = 1;
    println("{}", take(a[i]));
}
