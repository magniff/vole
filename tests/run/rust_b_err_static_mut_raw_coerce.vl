// RULE: D6.2.5
// (0.27.4) `&mut M` of a `static mut` where a `*mut i64` goes is a
// reference to it too (rustc: creating a mutable reference to mutable
// static); `&raw mut M` takes the address.
// ERROR: error[borrowck.static_mut_ref]
// ERROR: line 12, column 32
// ERROR-COUNT: 1

static mut M: i64 = 1;

fn main() {
    let p: *mut i64 = unsafe { &mut M };
    unsafe {
        *p += 1;
    }
}
