// Nested generic types, a heap vector, generic methods calling each
// other, methods with type parameters of their own, recursion.
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn realloc(p: *mut u8, size: u64) -> *mut u8;
    fn free(p: *mut u8);
}

#[derive(Clone, Copy)] struct Vec<T> { data: *mut T, len: i64, cap: i64 }

impl<T> Vec<T> {
    fn new() -> Vec<T> {
        Vec { data: 0 as *mut T, len: 0, cap: 0 }
    }

    fn push(&mut self, x: T) {
        if self.len == self.cap {
            self.grow();
        }
        unsafe { (*self.data.add(self.len as usize)) = x; }
        self.len += 1;
    }

    fn grow(&mut self) {
        let cap: i64 = if self.cap == 0 { 4 } else { self.cap * 2 };
        unsafe { self.data = realloc(self.data as *mut u8, (cap * size_of(T)) as u64) as *mut T; }
        self.cap = cap;
    }

    fn get(self, i: i64) -> T {
        unsafe { (*self.data.add(i as usize)) }
    }

    fn as_slice(self) -> &'static [T] {
        unsafe {
            std::slice::from_raw_parts(self.data.add((0) as usize), (self.len - (0)) as usize)
        }
    }

    fn map<U>(&mut self, f: fn(&T) -> U) -> Vec<U> {
        let mut out: Vec<U> = Vec::new();
        for i in 0..self.len {
            out.push(f(self.get(i)));
        }
        out
    }

    fn fold<A>(self, init: A, f: fn(&A, &T) -> A) -> A {
        let mut acc = init;
        for &x in self.as_slice() {
            acc = f(acc, x);
        }
        acc
    }

    fn free(&mut self) {
        unsafe { free(self.data as *mut u8); }
        self.len = 0;
        self.cap = 0;
    }
}

#[derive(Clone, Copy)] struct Pair<A, B> { a: A, b: B }

#[derive(Clone, Copy)] enum Maybe<T> { Nothing, Just(T) }

fn square(x: i64) -> i64 {
    x * x
}

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn half(x: i64) -> f64 {
    x as f64 / 2.0
}

fn count_just<T>(xs: Vec<Maybe<T>>) -> i64 {
    let mut n: i64 = 0;
    for i in 0..xs.len {
        match xs.get(i) {
            Maybe::Just(_) => n += 1,
            Maybe::Nothing => {}
        }
    }
    n
}

fn factorial<T>(n: T, one: T) -> T {
    if n == one { one } else { n * factorial(n - one, one) }
}

fn show(m: Maybe<Pair<i64, u8>>) {
    match m {
        Maybe::Just(p) => unsafe { printf(c"maybe %ld\n", p.a + p.b as i64) },
        Maybe::Nothing => unsafe { printf(c"nothing\n") },
    };
}

fn main() -> i32 {
    let mut v: Vec<i64> = Vec::new();
    for i in 0..5 {
        v.push(i);
    }
    let sq = v.map(square);
    for &x in sq.as_slice() {
        if x > 0 {
            unsafe { printf(c" "); }
        }
        unsafe { printf(c"%ld", x); }
    }
    unsafe {
        printf(c"\n");
        printf(c"len %ld cap %ld\n", sq.len, sq.cap);
    }
    let mut ms = Vec::<Maybe<i32>>::new();
    ms.push(Maybe::Just(1));
    ms.push(Maybe::Nothing);
    ms.push(Maybe::Just(3));
    ms.push(Maybe::Just(4));
    unsafe { printf(c"%ld\n", count_just(ms)); }
    let mut ps: Vec<Pair<i64, i64>> = Vec::new();
    ps.push(Pair { a: 1i64, b: 2i64 });
    ps.push(Pair { a: 3i64, b: 4i64 });
    unsafe { printf(c"pairs %ld:", ps.len); }
    for &p in ps.as_slice() {
        unsafe { printf(c" (%ld, %ld)", p.a, p.b); }
    }
    unsafe {
        printf(c"\n");
        printf(c"%ld\n", v.fold(0i64, add));
        printf(c"%ld\n", factorial(5i64, 1i64));
    }
    show(Maybe::Just(Pair { a: 4i64, b: 3u8 }));
    show(Maybe::Nothing);
    let mut nested: Vec<Vec<i64>> = Vec::new();
    nested.push(v);
    nested.push(sq);
    let inner = nested.get(1);
    unsafe { printf(c"%ld %ld\n", nested.len * 3, inner.len + 2); }
    let halves = v.map(half);
    unsafe { printf(c"%.1f\n", halves.get(3) - halves.get(0)); }
    v.free();
    0
}
