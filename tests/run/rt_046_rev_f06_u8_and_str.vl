// FLAGS: -O2
// EXPECT: 98122
// EXPECT: 2050
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn pokeb(q: *mut u8, v: u8) {
    // UNSAFE: given by the caller
    // SAFETY: points into main's buffer
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn rereadb(p: *mut [u8], q: *mut u8) -> u64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's buffer
    unsafe {
        let a = (*p)[1] as u64;
        pokeb(q, 122);
        let b = (*p)[1] as u64;
        a * 1000 + b
    }
}

#[inline(never)]
fn rereadi32(p: *const [i32], q: *mut i32) -> i32 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's buffer
    unsafe {
        let a = (*p)[1];
        pokei(q, 50);
        let b = (*p)[1];
        a * 1000 + b
    }
}

#[inline(never)]
fn pokei(q: *mut i32, v: i32) {
    // UNSAFE: given by the caller
    // SAFETY: points into main's buffer
    unsafe {
        *q = v;
    }
}

fn main() -> i32 {
    let mut a = [97u8, 98, 99];
    let base = a.as_mut_ptr();
    // UNSAFE: both from base
    // SAFETY: a outlives them
    let (p, q) = unsafe { (std::slice::from_raw_parts_mut(base, 3) as *mut [u8], base.add(1)) };
    println("{}", rereadb(p, q));
    let mut c = [1i32, 2, 3];
    let cb = c.as_mut_ptr();
    // UNSAFE: both from cb
    // SAFETY: c outlives them
    let (cp, cq) = unsafe {
        (std::slice::from_raw_parts_mut(cb, 3) as *mut [i32] as *const [i32], cb.add(1))
    };
    println("{}", rereadi32(cp, cq));
    0
}
