// (0.25) A closure capturing a struct with an inout field, or one that
// changes a capture, is move-only: `let g = f` moves it.
struct C<'a> { n: &'a mut i64 }

fn main() {
    let mut x: i64 = 1;
    let mut c = C { n: &mut x };
    let f = || { *c.n += 1; };
    let g = f;
    g();
    f();
    println("{x}");
}
// ERROR: borrowck.borrow_immutable
