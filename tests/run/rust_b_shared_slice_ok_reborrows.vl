// RULE: D2.7
// (0.30.1, RT-33) What the referent rule accepts, as rustc does: `&mut *v`
// and `&mut v[..]` of a `v: &mut [i64]` (its binding need not be `mut`),
// a slicing of a slicing of it (`v[..2][..1]`, the inner one a temporary
// the front types as a shared view), `&mut w[..]` of a `let mut w: Vec`,
// `w[..].swap(0, 1)` (through as_mut_slice), a `&mut` through a Box owned
// by a `mut` binding, an array's slicing of a `let mut a`, and a closure
// writing through a captured `&mut [T]`.
// EXPECT: 30 10 20
// EXPECT: 2 5
// EXPECT: 9 8
// EXPECT: 1 3
// EXPECT: 3 4
fn k(v: &mut [i64]) {
    let m = &mut *v;
    m[0] = 10;
    let m2: &mut [i64] = &mut *v;
    m2[1] = 20;
    let n = &mut v[..];
    n[2] = 30;
    v[..2][..1].swap(0, 0);
    v[1..].swap(0, 1);
    v.swap(0, 1);
}

fn main(gpa: Gpa) {
    let mut a = [1i64, 2, 3];
    k(&mut a);
    println("{} {} {}", a[0], a[1], a[2]);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(1);
    w.push(2);
    let m = &mut w[..];
    m[0] = 5;
    w[..].swap(0, 1);
    println("{} {}", w[0], w[1]);
    let mut b = Box::new_in([7i64, 8], gpa);
    let mb = &mut b[..];
    mb[0] = 9;
    println("{} {}", b[0], b[1]);
    let mut c = [3i64, 1];
    c[..].swap(0, 1);
    c[..1].swap(0, 0);
    println("{} {}", c[0], c[1]);
    let s: &mut [i64] = &mut c;
    let mut f = || {
        s[0] = 4;
        s.swap(0, 1);
    };
    f();
    println("{} {}", c[0], c[1]);
}
