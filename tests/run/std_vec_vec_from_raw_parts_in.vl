// Runs on std since 0.27.2's switch.
// The std item(s): std::vec Vec::from_raw_parts_in.
// EXPECT: [1, 2, 3]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2, 3], gpa);
    let (len, cap) = (v.len(), v.capacity());
    let p = v.leak().as_mut_ptr();
    // UNSAFE: the parts of a Vec, rebuilt.
    // SAFETY: p, len and cap come from a Vec on gpa, leaked, so owned once.
    let w = unsafe { Vec::from_raw_parts_in(p, len, cap, gpa) };
    println("{:?}", w);
}
