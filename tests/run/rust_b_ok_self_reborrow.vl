// EDITION: rust
// RULE: D2.4a
// (0.27.1) `x = &mut *x`: the new loan survives the kill of the old ones
// (gen after kill).

fn main() {
    let mut a: i64 = 1;
    let mut x = &mut a;
    x = &mut *x;
    *x += 1;
    println("{}", a);
}
// EXPECT: 2
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
