// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) print 1 / 9 (a is a copy)
// EXPECT: 1
// EXPECT: 9
static mut G: [i64; 4] = [1i64, 2, 3, 4];
fn f(a: [i64; 4]) -> i64 { unsafe { G[0] = 9; } a[0] }

fn main() -> i32 {
    println("{}", f(unsafe { G }));
    println("{}", unsafe { G[0] });
    0
}
