// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters Zip.
// EXPECT: [(1, 3), (2, 4)]
use std::iter::Zip;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([3i64, 4, 5], gpa);
    let it: Zip<std::slice::Iter<'_, i64>, std::slice::Iter<'_, i64>> = a.iter().zip(b.iter());
    let v: Vec<(i64, i64), Gpa> = it.map(|(x, y)| (*x, *y)).collect_in(gpa);
    println("{:?}", v);
}
