// EDITION: rust
// An array index of -1.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    println("{}", a[(-1 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
