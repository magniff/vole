// places IR (0.26.1, fuzz-sem seed 89): a value whose type has a Drop impl
// is dropped whole, under its flag, never opened into its fields. A field
// written on one path and the whole moved on another made the drop open:
// the fields dropped, `G::drop` never called. Each shape on each path: the
// field assigned, the whole moved, neither; a Drop struct inside a plain
// one (its own fields still apart); a field changed in a loop that moves
// the whole at its end; an enum with a Drop impl.
// FLAGS: --check-alloc
// EXPECT: one 0
// EXPECT: dg1 1
// EXPECT: d1
// EXPECT: one 6
// EXPECT: eat 1
// EXPECT: dg1 1
// EXPECT: d1
// EXPECT: one 8
// EXPECT: d1
// EXPECT: dg1 2
// EXPECT: d2
// EXPECT: nest 0
// EXPECT: dg2 4
// EXPECT: d4
// EXPECT: d3
// EXPECT: nest 6
// EXPECT: eat 2
// EXPECT: dg2 4
// EXPECT: d4
// EXPECT: d3
// EXPECT: nest 8
// EXPECT: d3
// EXPECT: d4
// EXPECT: dg2 5
// EXPECT: d5
// EXPECT: loop
// EXPECT: d6
// EXPECT: d7
// EXPECT: eat 3
// EXPECT: dg3 8
// EXPECT: d8
// EXPECT: enum 0
// EXPECT: de 9
// EXPECT: d9
// EXPECT: enum 6
// EXPECT: took
// EXPECT: de 10
// EXPECT: d10
// EXPECT: end
struct T { id: i64 }

impl Drop for T {
    fn drop(inout self) { println(f"d{self.id}"); }
}

struct G { t: T, k: i64 }

impl Drop for G {
    fn drop(inout self) { println(f"dg{self.k} {self.t.id}"); }
}

// A plain struct holding a G: its own fields are dropped apart.
struct H { g: G, x: T }

enum E { A(T), B }

impl Drop for E {
    fn drop(inout self) {
        match self {
            E::A(t) => println(f"de {t.id}"),
            E::B => println("de b"),
        }
    }
}

fn geat(g: sink G) {
    println(f"eat {g.k}");
}

fn teat(t: sink T) -> i64 { t.id }

fn etake(e: sink E) {
    println("took");
}

// The seed's shape: the field assigned on one path, the whole moved on
// another, neither on the third.
fn one(c: i64) {
    println(f"one {c}");
    var k = G { t: T { id: 1 }, k: 1 };
    if c > 5 {
        if c > 7 {
            k.t = T { id: 2 };
        } else {
            geat(k);
        }
    }
}

fn nest(c: i64) {
    println(f"nest {c}");
    var h = H { g: G { t: T { id: 4 }, k: 2 }, x: T { id: 3 } };
    if c > 5 {
        if c > 7 {
            let n = teat(h.x);
            h.g.t = T { id: 5 };
        } else {
            geat(h.g);
        }
    }
}

fn lp() {
    println("loop");
    var k = G { t: T { id: 6 }, k: 3 };
    var i = 7;
    while i < 9 {
        k.t = T { id: i };
        i += 1;
    }
    geat(k);
}

fn en(c: i64) {
    println(f"enum {c}");
    var e = E::A(T { id: 9 + c / 6 });
    if c > 5 {
        etake(e);
    }
}

fn main() -> i32 {
    one(0);
    one(6);
    one(8);
    nest(0);
    nest(6);
    nest(8);
    lp();
    en(0);
    en(6);
    println("end");
    0
}
