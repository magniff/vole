// (0.30.1, review 3) An impl's bounds no stronger than its trait's: FnMut
// where the trait has FnOnce (rustc E0276), a bound met only by a blanket
// impl that is itself bounded (`impl<T: Copy> Show for T`, E0277).
// ERROR: trait.impl_generics
// ERROR: trait.impl_generics
// ERROR-COUNT: 2
struct S;

trait T5 {
    fn f<F: FnOnce() -> i64>(&self, g: F) -> i64;
}

impl T5 for S {
    fn f<F: FnMut() -> i64>(&self, mut g: F) -> i64 {
        g()
    }
}

trait Show {
    fn show(&self) -> i64;
}

impl<T: Copy> Show for T {
    fn show(&self) -> i64 {
        7
    }
}

trait T6 {
    fn f<B>(&self, b: B) -> i64;
}

impl T6 for S {
    fn f<B: Show>(&self, b: B) -> i64 {
        b.show()
    }
}

fn main() {}
