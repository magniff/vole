// RULE: D8.5
// (0.27.2.1) The same in a generic body: T is not Copy, so `(t, t)` moves
// t twice (rustc E0382).
// ERROR: error[borrowck.use_moved]
// ERROR-COUNT: 1
struct D {
    n: i64,
}

fn dup<T>(t: T) -> (T, T) {
    (t, t)
}

fn main() {
    let p = dup(D { n: 1 });
    println("{}", p.0.n);
}
