// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). Out =
// &'static str used as a &str: the same type, by its lifetime too.
// EXPECT: 5
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = u64;

    fn o(self) -> u64 {
        8
    }
}

impl Tr for i32 {
    type Out = &'static str;

    fn o(self) -> &'static str {
        "hello"
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let s: &str = f(2);
    println("{}", s.len());
}
