// RULE: R6
// (0.30.2) A value given for a bound whose input is the call's own
// region (`F: FnMut(&mut St, Self::Item) -> Option<B>` of Iterator::scan,
// `F: FnMut(&T) -> K` of sort_by_key), whose result may borrow that
// input: refused where it is given (borrowck.fn_value_bound; rustc E0308,
// one type is more general than the other). A fn item whose signature
// keeps them apart is accepted (rust_b_fn_value_r6_ok.vl: `sc`, `sks`);
// so is a local that surely holds one (rust_b_fn_value_r6_held_ok.vl).
// A `fn` value's result borrows from every argument, so `via`'s parameter
// `g` is refused though its caller gives `sc` (rustc refuses g's type
// first, E0106). Before, each was accepted; `bad` returned borrows of
// scan's state, which ends with the adapter.
// ERROR: error[borrowck.fn_value_bound]
// ERROR: line 32, column 25
// ERROR: line 38, column 50
// ERROR: line 42, column 19
// ERROR-COUNT: 3
fn bad<'a>(s: &'a mut i64, _x: &i64) -> Option<&'a i64> {
    Some(s)
}

fn sc<'a>(s: &mut i64, x: &'a i64) -> Option<&'a i64> {
    *s += 1;
    Some(x)
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn via(w: &Vec<i64, Gpa>, g: fn(&mut i64, &i64) -> Option<&i64>) -> usize {
    w.iter().scan(0i64, g).count()
}

fn main(gpa: Gpa) {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let r1: Vec<&i64, Gpa> = w.iter().scan(0i64, bad).collect_in(gpa);
    let r2 = via(&w, sc);
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(3);
    u.sort_by_key(idr2);
    println("{} {} {}", r1.len(), r2, u.len());
}
