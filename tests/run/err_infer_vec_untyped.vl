// 0.29: a `let v = Vec::new_in(a)` that nothing gives an element type
// is an error at the call that made it (type.infer), whatever is done
// with the list afterwards: never used, only passed on, only measured
// and cleared, or assigned to another such list. (The checker once died
// on such a list with "IntVec::get: index out of range" and no
// position.) A list whose element type a later push, the function's
// result or a comparison of an element with a literal fixes is typed by
// it: the last said "equality requires ..., got '_'" at the comparison.
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'Vec::new_in'
// ERROR: line 29, column 13
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'Vec::new_in'
// ERROR: line 34, column 17
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'Vec::new_in'
// ERROR: line 40, column 17
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'Vec::new_in'
// ERROR: line 70, column 17
// ERROR-COUNT: 4
use std::alloc::Allocator;

fn count<T, A: Allocator>(v: &Vec<T, A>) -> usize {
    v.len()
}

fn emptied<T, A: Allocator>(v: &mut Vec<T, A>) {
    v.clear();
}

fn never_used(gpa: Gpa) -> i64 {
    let v = Vec::new_in(gpa);
    0
}

fn only_passed_on(gpa: Gpa) -> usize {
    let mut v = Vec::new_in(gpa);
    emptied(&mut v);
    count(&v)
}

fn only_measured(gpa: Gpa) -> usize {
    let mut v = Vec::new_in(gpa);
    v.clear();
    v.truncate(0);
    let s = v.as_slice();
    s.len() + v.len()
}

fn elements_equated(gpa: Gpa) -> i64 {
    let mut v = Vec::new_in(gpa);
    let mut i = 0;
    while i < v.len() as i64 {
        if v[i as usize] == 3 {
            return 1;
        }
        i += 1;
    }
    0
}

fn elements_ordered(gpa: Gpa) -> i64 {
    let v = Vec::new_in(gpa);
    for x in v.iter() {
        if *x > 0 {
            return 1;
        }
    }
    0
}

fn two_lists(gpa: Gpa) -> usize {
    let mut w = Vec::new_in(gpa);
    let v = Vec::new_in(gpa);
    w = v;
    w.len()
}

fn typed_by_push(gpa: Gpa) -> i64 {
    let mut v = Vec::new_in(gpa);
    v.push(4i64);
    v[0]
}

fn typed_by_result(gpa: Gpa) -> i64 {
    let v = Vec::new_in(gpa);
    if v.len() > 0 {
        return *v.get(0).unwrap();
    }
    0
}

fn main(gpa: Gpa) -> i32 {
    let n = never_used(gpa) + elements_equated(gpa) + elements_ordered(gpa) + typed_by_push(gpa)
        + typed_by_result(gpa);
    println("{} {}", n, only_passed_on(gpa) + only_measured(gpa) + two_lists(gpa));
    0
}
