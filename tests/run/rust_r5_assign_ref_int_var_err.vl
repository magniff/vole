// RULE: R5
// (0.30.2) An assignment's value, or a struct field's, is checked as a
// `let`'s with its written type: a reference where its value goes is
// type.ref-value (rustc E0308), never read through.
// ERROR: is a reference where its value goes
fn main() {
    let a = 7;
    let r = &a;
    let mut s: i64 = 0;
    s = r;
    println("{}", s);
}
