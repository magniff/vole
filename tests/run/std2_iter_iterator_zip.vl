// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::zip.
// EXPECT: [(1, 'a'), (2, 'b')]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let s = Vec::from_in(['a', 'b'], gpa);
    let a: Vec<(i64, char), Gpa> = v.iter().copied().zip(s.iter().copied()).collect_in(gpa);
    println("{:?}", a);
}
