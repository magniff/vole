// RULE: F16.5
// `{:-}` sets Formatter's sign_minus, `{:+}` sign_plus; `{:E}` is UpperExp.
// EXPECT: true false false true false false 1.5E0
use std::fmt::{Display, Formatter};

struct Spec;

impl Display for Spec {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        let m = f.sign_minus();
        let p = f.sign_plus();
        write(f, "{} {}", m, p)
    }
}

fn main() {
    println("{:-} {:+} {} {:E}", Spec, Spec, Spec, 1.5f64);
}
