// RT-393, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig-m2 (form f269ai). Since v0.30.1 at least;
// the release build the same. rustc E0277 at the impl's where clause and
// at the call (the rustc twin of this file). A generic impl's where clause
// is checked when the impl is chosen; one without type parameters is
// taken as holding. Sub-forms: rt_393b (an associated-type bound,
// `X: Tr<Out = i64>`), rt_393c (a blanket impl over it runs, prints 9),
// rt_393d (two impls that need each other, E0275).
// ERROR: line 27
// ERROR: line 38
trait Conv {
    fn c(&self) -> i64;
}

trait Tr {
    fn f(&self) -> i64;
}

struct W {
    r: i64,
}

struct Bx<T> {
    t: T,
}

impl Tr for W where Bx<i64>: Conv {
    fn f(&self) -> i64 {
        1
    }
}

fn need<X: Tr>(x: &X) -> i64 {
    5
}

fn main() {
    println("{}", need(&W { r: 0 }));
}
