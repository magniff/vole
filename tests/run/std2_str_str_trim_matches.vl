// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::trim_matches.
// EXPECT: "foo1bar" "bar" "foo1bar"
// RUSTC: none (std2 trims both ends by a &str pattern; Rust needs a DoubleEndedSearcher)
use std::str::CharIndices;

fn main() {
    println("{:?} {:?} {:?}", "11foo1bar11".trim_matches('1'),
        "123bar321".trim_matches(char::is_numeric), "xxfoo1barxx".trim_matches("xx"));
}
