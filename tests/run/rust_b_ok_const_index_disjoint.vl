// EDITION: rust
// RULE: D1.5
// (0.27.1) `&mut a[0]` and `&mut a[1]`: constant indices are Disjoint here;
// rustc reads `a[0]` as an index by a temporary and rejects it.
// RUSTC: rejects R7 constant indices are disjoint; rustc indexes `a[0]` through a temporary

fn main() {
    let mut a = [1i64, 2, 3];
    let p = &mut a[0];
    let q = &mut a[1];
    *p += 10;
    *q += 20;
    println("{} {}", a[0], a[1]);
}
// EXPECT: 11 22
