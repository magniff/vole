// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a35_method_self_int)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'get' calls 'A::poke', which writes through a raw pointer what it did not make
// An ensures on a method of a usize-holding struct calls a raw-writing method of self.
struct A { addr: usize }

impl A {
    fn poke(&self) -> bool {
        // UNSAFE: test
        // SAFETY: test
        unsafe { *(self.addr as *mut i64) = 9; }
        true
    }

    fn get(&self) -> i64
        ensures self.poke()
    {
        1
    }
}

fn main() {
    let mut x = 1i64;
    let a = A { addr: &raw mut x as usize };
    println("{}", a.get());
    println("{}", x);
}
