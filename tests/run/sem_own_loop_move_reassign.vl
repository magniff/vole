// sem-own: moved and assigned again in each iteration: every value dropped
// once.
// EXPECT: eat 0
// EXPECT: drop 0
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    var d = mk(0, gpa);
    for i in 0..3 { eat(d); d = mk(i + 1, gpa); }
    println("end");
}
