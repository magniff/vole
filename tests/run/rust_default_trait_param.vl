// EDITION: rust
// (0.27.0) A trait's defaulted type parameter, `trait Same<Rhs = Self>`:
// an impl that leaves it out takes the default, `Self` the impl's type.
// EXPECT: true false
pub trait Same<Rhs = Self> {
    fn same(&self, o: &Rhs) -> bool;
}

struct P {
    x: i64,
}

impl Same for P {
    fn same(&self, o: &P) -> bool {
        self.x == o.x
    }
}

fn main() -> i32 {
    let a = P { x: 1 };
    let b = P { x: 2 };
    println("{} {}", a.same(&a), a.same(&b));
    0
}
