// RULE: F8.4
// `<E as Mk>::C`, E a generic enum written bare: rustc E0107 (missing generics for enum `E`).
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// ERROR: 'E' is generic: write its type arguments ('E<...>')
trait Mk {
    fn mk() -> Self;
    const C: i64;
    type Out;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }

    const C: i64 = 7;
    type Out = i64;
}

enum E<T> {
    A(T),
    B,
}

impl<T> Mk for E<T> {
    fn mk() -> E<T> {
        E::B
    }

    const C: i64 = 4;
    type Out = i64;
}

fn main() {
    println("{}", <E as Mk>::C);
}
