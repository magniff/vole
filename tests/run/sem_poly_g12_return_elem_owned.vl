fn first<T>(v: &Vec<T, Gpa>) -> T { v[0] }

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(4);
    println("{}", first(&a));
    let mut b: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    b.push(a.clone());
    let x = first(&b);
    println("{}", x.len());
}
