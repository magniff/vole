// XFAIL: gap 8: compile borrowck.mut_twice: cannot borrow '*self' as mutable more than once at a time (mutably borrowed at...
// 0.17 (value semantics, from tests/values-proto of the prototype): a
// parser that returns views of its tokens' text from a `&mut self` method,
// then changes itself (the evals' pattern, §2.9 situation 6) checks clean
// under --values=error: `name` is views(*self).
// EXPECT: ab 2
use std::alloc::Allocator; #[derive(Clone, Copy)] struct Tok<'a> { text: &'a str, k: i64 }
struct Parser<'a, A: Allocator> { toks: Vec<Tok<'a>, A>, pos: i64 }

impl<'a> Parser<'a, Gpa> {
    fn name(&mut self) -> Result<&str, &str> {
        let t = self.toks[self.pos as usize];
        self.pos += 1;
        Ok(t.text)
    }

    fn accept(&mut self, k: i64) -> bool {
        if self.toks[self.pos as usize].k == k { self.pos += 1; true } else { false }
    }

    fn item(&mut self) -> Result<&str, &str> {
        let col = match self.name() {
            Ok(n) => n,
            Err(e) => return Err(e),
        };
        if !self.accept(3) {
            return Err("x");
        }
        Ok(col)
    }
}

fn main(gpa: Gpa) {
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "ab", k: 1 });
    p.toks.push(Tok { text: ",", k: 3 });
    match p.item() {
        Ok(c) => println("{c} {}", p.pos),
        Err(e) => println("{}", e),
    }
}
