// Runs on std since 0.27.2's switch.
// The std item(s): std::boxed Box::impl PartialEq.
// EXPECT: true false
use std::boxed::Box;

fn main(gpa: Gpa) {
    let a = Box::new_in(1i64, gpa);
    let b = Box::new_in(1i64, gpa);
    let c = Box::new_in(2i64, gpa);
    println("{} {}", a == b, a == c);
}
