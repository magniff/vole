// EDITION: rust
// The std2 item(s): std::panic assert with a message that has holes (the
// compiler's call of __assert_fmt): nothing is printed while the condition
// holds; when it fails, the message after the call's FILE:LINE:COL.
// RUSTC: none (assert is a function here, and the place is vole's form)
// EXIT: 101
// EXPECT: ok
// STDERR: std2_panic_assert_fmt.vl:13:5: bad 3 of 4
fn main() {
    let x = 3;
    assert(x == 3, "never {}", x);
    println("ok");
    assert(x == 4, "bad {} of {}", x, x + 1);
}
