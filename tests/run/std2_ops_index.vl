// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::ops Index.
// EXPECT: 2 3
use std::ops::{Index, IndexMut};

struct Grid {
    cells: [i64; 4],
}

impl Index<(usize, usize)> for Grid {
    type Output = i64;

    fn index(&self, at: (usize, usize)) -> &i64 {
        &self.cells[at.0 * 2 + at.1]
    }
}

impl IndexMut<(usize, usize)> for Grid {
    fn index_mut(&mut self, at: (usize, usize)) -> &mut i64 {
        &mut self.cells[at.0 * 2 + at.1]
    }
}

fn main() {
    let g = Grid { cells: [1, 2, 3, 4] };
    println("{} {}", g[(0, 1)], g[(1, 0)]);
}
