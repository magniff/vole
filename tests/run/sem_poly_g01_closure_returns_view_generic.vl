// EDITION: rust
// XFAIL: gap 18: rustc says E0596 (borrowck.borrow_immutable); the rust edition: borrowck.outlives
// a generic 'with' over a local: the closure returns a view of its inout argument through R
// ERROR: borrowck.borrow_immutable
fn with<T, R, F: FnMut(&mut T) -> R>(x: &mut T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    let s = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        with(&mut v, |d: &mut Vec<i64, Gpa>| d.as_slice())
    };
    for i in 0..100 { w.push(i); }
    println("{}", s[5]);
}
