// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set HashSet::intersection.
// EXPECT: [2]
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [2i64, 3].into_iter().collect_in(gpa);
    let v: Vec<i64, Gpa> = a.intersection(&b).copied().collect_in(gpa);
    println("{:?}", v);
}
