// RULE: D19.1
// (0.30.2, RT-91) A closure making an inner closure in a local, and a
// `flat_map` whose inner iterator is mapped then filtered: the outer closure's X_C was made
// before the inner one's, so its type's slots were counted without them
// (0.30.1: a compiler panic, places/regions.vl code_universal). A
// closure's X_C is made after those of the closures its type holds
// (closures/kinds.vl sig_slots_ordered).
// EXPECT: 66 37
fn main() {
    let w = [1i64, 2];
    let v = [10i64, 20];
    let total: i64 = w.iter().map(|y| {
        let inner = v.iter().map(move |x| x + y);
        inner.sum::<i64>()
    }).sum();
    let n: i64 = w.iter().flat_map(|y| v.iter().map(move |x| x - y).filter(|z| *z > 9)).sum();
    println("{total} {n}");
}
