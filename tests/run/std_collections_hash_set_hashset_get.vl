// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::collections::hash_set HashSet::get.
// EXPECT: Some("a") None
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<String<Gpa>, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert("a".to_string_in(gpa));
    println("{:?} {:?}", s.get("a"), s.get("b"));
}
