#[derive(Clone, Copy)] // (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a view of a loop iteration's temporary, kept past it
// ERROR: borrowck.dropped_borrowed
struct E { name: [u8; 4], len: i64 }
fn nm(e: &E) -> &[u8] { &e.name[..e.len as usize] }
fn mk(c: u8) -> E { E { name: [c, c, c, c], len: 4 } }

fn main(gpa: Gpa) -> i32 {
    let mut keep: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(nm(&mk(b'a' + i as u8)));
    }
    println("{} {} {}", str::from_utf8(keep[0usize]).unwrap(),
        str::from_utf8(keep[1usize]).unwrap(), str::from_utf8(keep[2usize]).unwrap());
    0
}
