// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops impl BitAndAssign for primitives.
// EXPECT: 4 4
use std::ops::BitAndAssign;

fn update<T: BitAndAssign>(a: &mut T, b: T) {
    a.bitand_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
