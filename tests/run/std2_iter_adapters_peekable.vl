// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters Peekable.
// EXPECT: Some(1) Some(1)
use std::iter::Peekable;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it: Peekable<std::iter::Copied<std::slice::Iter<'_, i64>>> = s
        .iter()
        .copied()
        .peekable();
    let p = it.peek().copied();
    println("{:?} {:?}", p, it.next());
}
