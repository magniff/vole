// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::vec Vec::impl Hash.
// EXPECT: true
use std::hash::{BuildHasher, FixedState};

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let s: &[i64] = &[1, 2];
    let st = FixedState::new();
    println("{}", st.hash_one(&v) == st.hash_one(s));
}
