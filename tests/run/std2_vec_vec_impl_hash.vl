// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl Hash.
// EXPECT: true
use std::hash::{BuildHasher, FixedState};

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2], gpa);
    let s: &[i64] = &[1, 2];
    let st = FixedState::new();
    println("{}", st.hash_one(&v) == st.hash_one(s));
}
