// RULE: F18.5
// (0.30.2) `u64::from(a)` of an integer variable a later use makes
// i8: From<i8> for u64 does not hold, rustc's E0277.
// ERROR: the trait 'From<i8>' is not implemented for 'u64' (rustc E0277)
fn main() {
    let a = -1;
    let r = u64::from(a);
    let c: i8 = a;
    println("{} {}", r, c);
}
