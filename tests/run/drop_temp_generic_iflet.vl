// (0.29) A generic call's result as the scrutinee of an `if let` and a
// `while let` without an `else`: bound by value, through a reference, a
// field of it, nothing bound. Each value is dropped once, at the end of the
// `if let`. (With an `else` the two Rust editions differ in where the
// scrutinee's temporaries drop: tools/semfuzz/findings/
// temporaries_between_editions.vl, not this case's.)
// EXPECT: a 4
// EXPECT: d2
// EXPECT: b 4
// EXPECT: d3
// EXPECT: c 4
// EXPECT: d4
// EXPECT: d
// EXPECT: d5
// EXPECT: e
// EXPECT: d6
// EXPECT: f 4
// EXPECT: d7
// EXPECT: g
// EXPECT: d8
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn dup<X: Clone>(x: &X) -> X {
    x.clone()
}

fn dup_opt<X: Clone>(x: &X) -> Option<X> {
    Some(x.clone())
}

fn dup_res<X: Clone>(x: &X) -> Result<X, i64> {
    Ok(x.clone())
}

fn run() {
    let t = mk(4);
    if let Some(x) = dup_opt(&t) {
        println("a {}", x.v);
    }
    if let Some(x) = &dup_opt(&t) {
        println("b {}", x.v);
    }
    if let Ok(x) = dup_res(&t) {
        println("c {}", x.v);
    }
    if let 4 = dup(&t).v {
        println("d");
    }
    if let Some(_) = dup_opt(&t) {
        println("e");
    }
    while let Some(x) = dup_opt(&t) {
        println("f {}", x.v);
        break;
    }
    if let 4 = obs(&dup(&t)) {
        println("g");
    }
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
