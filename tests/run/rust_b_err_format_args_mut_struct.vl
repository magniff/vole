// RULE: D2.9
// (0.30.1) A format_args value borrows every hole that is a place of a
// type that is not Copy, glue or not: `m`, a struct holding a `&mut i64`,
// is borrowed while the value lives, so a write through `m.r` before the
// value is printed is rustc's E0506. Before, only a type owning memory
// was borrowed: the value's copy of m aliased the `&mut` written through.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 26, column 5
// ERROR-COUNT: 1
use std::fmt;

struct M<'a> {
    r: &'a mut i64,
}

impl<'a> fmt::Display for M<'a> {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        write(f, "{}", *self.r)
    }
}

fn main() {
    let mut x = 1;
    let m = M { r: &mut x };
    let a = format_args("{}", m);
    *m.r = 7;
    println("{}", a);
}
