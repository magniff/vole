// RULE: F8.4, F9.1
// RT-C301-8: two traits and an inherent impl give S a function and a
// constant of one name each; `<S as A>::x` is A's and `S::x` the inherent
// one, as a value, a constant and a call. 0.30.1 took the inherent ones
// for the values and constants. rustc prints these lines.
// EXPECT: 1 2 0
// EXPECT: 1 2 0
// EXPECT: 1 2 0
// EXPECT: 1 2 0 0
// EXPECT: 1 2 0
// two traits plus an inherent item of the same name
trait A { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
trait B { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
struct S;
impl S { const K: i64 = 0; fn m(&self) -> i64 { 0 } fn mk() -> i64 { 0 } }
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } fn mk() -> i64 { 1 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } fn mk() -> i64 { 2 } }

fn main() {
    let s = S;
    let fa = <S as A>::m; let fb = <S as B>::m; let fs = S::m;
    let ga = <S as A>::mk; let gb = <S as B>::mk; let gs = S::mk;
    println("{} {} {}", <S as A>::K, <S as B>::K, S::K);
    println("{} {} {}", fa(&s), fb(&s), fs(&s));
    println("{} {} {}", ga(), gb(), gs());
    println("{} {} {} {}", <S as A>::m(&s), <S as B>::m(&s), S::m(&s), s.m());
    println("{} {} {}", <S as A>::mk(), <S as B>::mk(), S::mk());
}
