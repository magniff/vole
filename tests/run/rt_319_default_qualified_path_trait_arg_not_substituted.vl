// XFAIL: RT-319: a generic trait's default `<S as Conv<T>>::c()` keeps the trait's T unsubstituted in the qualified path's trait: refused as ambiguous between Conv<u8> and Conv<u16> (0.30.2)
// From g302tparam; v0.30.1 too. The qualified path's trait node is not
// substituted with the impl's argument when the default is copied
// (traits::subst_trait_args substitutes types, not the expression's
// qualified trait). rustc prints 16 8.
// EXPECT: 16 8
trait Conv<X> {
    fn c() -> i64;
}

struct S;

impl Conv<u8> for S {
    fn c() -> i64 {
        8
    }
}

impl Conv<u16> for S {
    fn c() -> i64 {
        16
    }
}

trait G<T> {
    fn g(&self) -> i64
        where
            S: Conv<T>,
    {
        <S as Conv<T>>::c()
    }
}

struct W;

impl G<u16> for W {}

struct V;

impl G<u8> for V {}

fn main() {
    println("{} {}", W.g(), V.g());
}
