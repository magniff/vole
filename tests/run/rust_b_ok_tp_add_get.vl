// EDITION: rust
// RULE: D7.2
// (0.27.1) `s.add(s.get())`: the reservation of `&mut s` allows the shared
// autoref of the argument.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn get(&self) -> i64 {
        self.x
    }

    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add(s.get());
    println("{}", s.x);
}
// EXPECT: 2
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
