// RULE: F15.3, FL13
// FLAGS: --check-alloc
// (0.27.3) A `for` over an array by value (`[T; N]: IntoIterator`) left
// by an early `break`: the element in hand is dropped at the break, then
// the iterator drops the ones not reached; a String array's are freed
// (--check-alloc).
// EXPECT: x
// EXPECT: saw 1
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: sum 6
struct D(i64);

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.0);
    }
}

fn main(gpa: Gpa) {
    let words = ["x".to_string_in(gpa), "yy".to_string_in(gpa), "zzz".to_string_in(gpa)];
    for w in words {
        if w.len() == 2 {
            break;
        }
        println("{w}");
    }
    for d in [D(1), D(2), D(3)] {
        if d.0 == 2 {
            break;
        }
        println("saw {}", d.0);
    }
    let mut sum = 0;
    for x in [1i64, 2, 3] {
        sum += x;
    }
    println("sum {sum}");
}
