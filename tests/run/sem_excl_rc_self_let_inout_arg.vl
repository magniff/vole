// EDITION: rust
// let receiver (owned) and the same value inout
// ERROR: error[borrowck.conflict]
use std::alloc::Allocator;

struct A<L: Allocator> { v: Vec<i64, L> }
impl A<Gpa> { fn f(&self, o: &mut A<Gpa>) -> i64 { o.v.push(1); self.v.len() as i64 } }
fn main(gpa: Gpa) { let mut a = A { v: Vec::new_in(gpa) }; println("{}", a.f(&mut a)); }
