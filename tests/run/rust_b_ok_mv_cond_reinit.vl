// EDITION: rust
// RULE: D8.2
// (0.27.1) A move on one path followed by a reassignment on it: initialized
// after the join.

struct N {
    v: i64,
}

fn eat(n: N) -> i64 {
    n.v
}

fn main() {
    let mut n = N { v: 1 };
    let c = n.v > 0;
    if c {
        let k = eat(n);
        n = N { v: k + 1 };
    }
    println("{}", n.v);
}
// EXPECT: 2
