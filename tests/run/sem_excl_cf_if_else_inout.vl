// EDITION: rust
// an inout local made in one branch of the place's two parts
// EXPECT: 11 2
#[derive(Clone, Copy)] struct S { a: i64, b: i64 }

fn main() {
    let mut s = S { a: 1, b: 2 }; let c = true;
    if c { let r = &mut s.a; *r += 10; } else { let r = &mut s.b; *r += 10; } println("{} {}", s.a, s.b);
}
