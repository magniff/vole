// EDITION: rust
// XFAIL: gap 4: compile type error: cannot apply unary operator '-' to type 'usize'
// sem-own: position over owned items drops each item it looked at.
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: pos 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let p = (0i64..3i64).map(|i| mk(i, gpa)).position(|d| d.id == 1);
    println("pos {}", p.unwrap_or(-1));
}
