// std::cli (0.25): Matches::indices_of, where each value (or flag) was
// given among the arguments: the order of different options' values,
// which `values` does not keep.
// EXPECT: lib m at 2
// EXPECT: input x.o at 3
// EXPECT: lib z at 5
// EXPECT: input y.c at 6
// EXPECT: verbose at [1, 7]
// EXPECT: out at [9] default at []
// EXPECT: sub flag at [2]
use std::cli::{Arg, Command};

fn show(v: [i64]) -> i64 {
    print("[");
    for k in 0..v.len() {
        if k > 0 {
            print(", ");
        }
        print("{}", v[k]);
    }
    print("]");
    0
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("cc", gpa)
        .arg(Arg::flag("verbose").short('v'))
        .arg(Arg::option("lib").short('l'))
        .arg(Arg::option("out").short('o'))
        .arg(Arg::option("mode").default("fast"))
        .arg(Arg::positional("input").multiple());
    let m = cmd.parse("cc -v -lm x.o -l z y.c -v -o a.out".split(' ')).unwrap();
    let libs = m.values("lib");
    let li = m.indices_of("lib");
    let ins = m.values("input");
    let ii = m.indices_of("input");
    // libraries and inputs, merged in the order they were given
    var a = 0;
    var b = 0;
    while a < libs.len() as i64 || b < ins.len() as i64 {
        if b >= ins.len() as i64 || a < libs.len() as i64 && li[a] < ii[b] {
            println("lib {} at {}", libs[a], li[a]);
            a += 1;
        } else {
            println("input {} at {}", ins[b], ii[b]);
            b += 1;
        }
    }
    print("verbose at ");
    show(m.indices_of("verbose"));
    print("\nout at ");
    show(m.indices_of("out"));
    print(" default at ");
    show(m.indices_of("mode"));
    println("");
    let top = Command::new_in("git", gpa)
        .subcommand(Command::new_in("push", gpa).arg(Arg::flag("force").short('f')));
    let p = top.parse("git push -f".split(' ')).unwrap();
    match p.subcommand() {
        Some((_, sub)) => {
            print("sub flag at ");
            show(sub.indices_of("force"));
            println("");
        }
        None => println("none"),
    }
    0
}
