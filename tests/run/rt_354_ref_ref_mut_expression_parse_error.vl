// XFAIL: RT-354: `&&mut s` does not parse ("expected expression, got 'mut'"); `& &mut s` does; rustc accepts (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 1 2 3
// EXPECT: 10 20 30
// EXPECT: 2 20
// EXPECT: 1 1
trait T1 {
    fn h(&self) -> i64;
    fn f(self) -> i64;
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl T1 for S {
    fn h(&self) -> i64 {
        1
    }

    fn f(self) -> i64 {
        10
    }
}

impl<'a> T1 for &'a S {
    fn h(&self) -> i64 {
        2
    }

    fn f(self) -> i64 {
        20
    }
}

impl<'a> T1 for &'a mut S {
    fn h(&self) -> i64 {
        3
    }

    fn f(self) -> i64 {
        30
    }
}

fn main() {
    let mut s = S { k: 1 };
    println("{} {} {}", T1::h(&s), T1::h(&&s), T1::h(&&mut s));
    println("{} {} {}", T1::f(s), T1::f(&s), T1::f(&mut s));
    println("{} {}", <&S as T1>::h(&&s), <&S as T1>::f(&s));
    println("{} {}", s.h(), (&s).h());
}
