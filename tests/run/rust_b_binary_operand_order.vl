// EDITION: rust
// RULE: D2.4a
// (0.27.5) A rust body reads a primitive binary operator's left side
// before its right side is evaluated, as Rust: a view of the context read
// on the left is dead before a `&mut` call on the right, and the left
// side is the old value when the right side changes it.
// EXPECT: true 1 3 12 false 204
use std::alloc::Allocator;

struct Node {
    a: i64,
}

struct Ctx<A: Allocator> {
    nodes: Vec<Node, A>,
    syms: i64,
}

fn intern(s: &str, pcx: &mut Ctx<Gpa>) -> i64 {
    pcx.syms += 1;
    pcx.nodes[0].a += 100;
    s.len() as i64
}

fn bump(x: &mut i64) -> i64 {
    *x += 10;
    1
}

fn main(gpa: Gpa) {
    let mut c = Ctx { nodes: Vec::new_in(gpa), syms: 0 };
    c.nodes.push(Node { a: 4 });
    let pcx = &mut c;
    let same = pcx.nodes[0].a == intern("Self", pcx);
    let d = pcx.nodes[0].a - 100 - intern("abc", pcx);
    let mut x = 2;
    let y = x + bump(&mut x);
    let z = x;
    let lt = pcx.syms < { pcx.syms += 5; 2 };
    println("{} {} {} {} {} {}", same, d, y, z, lt, pcx.nodes[0].a);
}
