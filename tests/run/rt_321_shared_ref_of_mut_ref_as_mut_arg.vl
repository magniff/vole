// XFAIL: RT-321: `k(&y)` with `y: &mut S` and `k(x: &mut S)`: a shared borrow of a `&mut` passed where `&mut S` goes is accepted, and k mutates s through it (unsound) (0.30.2)
// Since v0.30.1 at least (and the release branch). A plain call, the
// argument the expression `&y` written at the call; `bump(r)` with a
// variable `r: &&mut S` and `let c: &mut S = b` are refused correctly
// (borrowck.borrow_immutable). rustc: error[E0308] mismatched types,
// "types differ in mutability" at `&y`. vole prints 2.
// ERROR: line 18
struct S {
    k: i64,
}

fn k(x: &mut S) -> i64 {
    x.k += 1;
    x.k
}

fn z(y: &mut S) -> i64 {
    k(&y)
}

fn main() {
    let mut s = S { k: 1 };
    println("{}", z(&mut s));
}
