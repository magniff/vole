// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: 0 1 2 3
// STDERR: use after free: block #1 (32 bytes), allocated at
// STDERR: checkalloc_slice_push.vl:14:9, freed at
// STDERR: checkalloc_slice_push.vl:22:5
// 0.16: --check-alloc: every resize moves the block, so a slice taken
// before a push that grows the Vec reads freed pages, and faults.
// (0.28: a slice of the Vec kept across the push is borrowck.conflict; this
// one is made from the raw pointer, which the borrow checker does not follow.)
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..4 {
        v.push(i);
    }
    // UNSAFE: a slice of the Vec's block not tied to the Vec, kept across
    // a push that moves the block.
    // SAFETY: sound for the first print (four initialized elements, the
    // Vec not changed meanwhile); none after the push, on purpose.
    let s = unsafe { std::slice::from_raw_parts(v.as_ptr(), 4usize) };
    println("{} {} {} {}", s[0], s[1], s[2], s[3]);
    v.push(4);
    println("{}", s[0]);
}
