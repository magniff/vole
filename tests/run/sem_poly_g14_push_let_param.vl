// XFAIL: gap 17: errors at other places or codes: MVS own.move_out@3:54; rust type.ref-value@3:54; type error@3:54
// pushing a let T into a Vec<T>: copy for i64; for an owned T a move out of a borrow
// ERROR: [own.move_out]: cannot move 'x'
fn store<T>(dst: &mut Vec<T, Gpa>, x: &T) { dst.push(x); }

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    store(&mut a, &3i64);
    let mut b: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    store(&mut b, &a);
    println("{} {}", a.len(), b.len());
}
