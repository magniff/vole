// RULE: C3.4
// RUSTC: none contract clauses are not Rust
// (0.30.2, RT-198) The values of a clause's `old(..)` are checked as the
// clause is (contracts::olds_of): here, io.
// From the re-review of g302holes.
// ERROR: the 'ensures' of 'f' calls 'say', which does io
// old(..) does io.
fn say() -> i64 {
    println("io");
    1
}

fn f(n: i64) -> i64
    ensures old(say()) == 1
{
    n
}

fn main() {
    println("{}", f(2));
}
