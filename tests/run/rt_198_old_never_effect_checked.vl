// XFAIL: RT-198: an `old(..)` expression is never effect-checked: `ensures old(say()) == 1` with say printing is accepted (a clause must not do io) (0.30.2)
// From the re-review of g302holes.
// ERROR: line 11
// old(..) does io.
fn say() -> i64 {
    println("io");
    1
}

fn f(n: i64) -> i64
    ensures old(say()) == 1
{
    n
}

fn main() {
    println("{}", f(2));
}
