// Runs on std since 0.27.2's switch.
// The std item(s): std::thread JoinError::impl Debug.
// EXPECT: Ok(5)
// RUSTC: none (std's JoinError: Rust's thread::Result holds a Box<dyn Any + Send>)
use std::thread::{JoinError, self};

fn main() {
    let r: Result<i64, JoinError> = thread::scope(|s| s.spawn(|| 5i64).join());
    println("{:?}", r);
}
