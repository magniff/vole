// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::product.
// EXPECT: 24 1

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let p: i64 = v.iter().product();
    let q: i64 = e.iter().product();
    println("{} {}", p, q);
}
