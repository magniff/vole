// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::allocator.
// EXPECT: 1
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let a: &Gpa = m.allocator();
    let mut n: HashMap<i64, i64, &Gpa, FixedState> = HashMap::new_in(a);
    n.insert(2, 2);
    println("{}", n.len());
}
