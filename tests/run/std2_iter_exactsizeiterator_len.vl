// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter ExactSizeIterator::len.
// EXPECT: 4 3

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = v.iter();
    let a = it.len();
    it.next();
    println("{} {}", a, it.len());
}
