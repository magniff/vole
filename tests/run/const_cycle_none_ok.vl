// (0.30.2, RT-138) Constants that refer to each other with no cycle: a
// chain, a diamond (B met twice in C), a constant used twice, a free
// constant named by associated ones, a trait default on an
// impl's constant, and one declaration at many instances (Peano: N::V of
// S<N> names V of N, a smaller type). rustc builds it and prints these.
// EXPECT: 3 2 5 5 5
// EXPECT: 7 8 9
// EXPECT: 11 12
// EXPECT: 6
const F: i64 = 7;
struct S;

impl S {
    const A: i64 = Self::B + 1;
    const B: i64 = 2;
    const C: i64 = Self::A + Self::B;
    const G: i64 = F;
}

trait T {
    const D: i64 = Self::E + 1;
    const E: i64;
}

impl T for S {
    const E: i64 = F;
}

struct U;

impl T for U {
    const D: i64 = 11;
    const E: i64 = Self::D + 1;
}

trait Nat {
    const V: usize;
}

struct Z;

struct Succ<N> {
    n: N,
}

impl Nat for Z {
    const V: usize = 0;
}

impl<N: Nat> Nat for Succ<N> {
    const V: usize = N::V + 1;
}

fn v<X: Nat>() -> usize {
    X::V
}

fn main() {
    println("{} {} {} {} {}", S::A, S::B, S::C, S::C, S::C);
    println("{} {} {}", S::G, S::D, F + 2);
    println("{} {}", U::D, U::E);
    println("{}", v::<Succ<Succ<Succ<Succ<Succ<Succ<Z>>>>>>>());
}
