// places IR (0.26.1): drop shims are functions (each kept as a body, its
// symbol `$drop.G` and its type mangled), and the `Drop::drop` instance a
// shim calls is one places/shim.vl makes at check time when the own
// pass's glue made none: G<i64>'s `drop` is reached only through W's
// shim. (Until the own pass's drop placeholders go, in 0.26.1's step 7,
// its glue makes the instance first: this case keeps it so then.)
// FLAGS: --keep-places --emit-shims --verify-places
// EXPECT: 2
// EXPECT: drop G 1
// PLACES: fn main
// PLACES: drop(_1) [kept]
// PLACES: fn drop_in_place::<W>
// PLACES: let _1: inout W    // param
// PLACES: drop((*_1).0) [kept]
// PLACES-NOT: drop((*_1).1)
// PLACES: fn drop_in_place::<G<i64>>
// PLACES: _2 = call G<i64>::drop(move _3)
struct G<T> { x: T }

impl<T> Drop for G<T> {
    fn drop(inout self) {
        println(f"drop G {self.x}");
    }
}

struct W { g: G<i64>, n: i64 }

fn main() {
    let w = W { g: G { x: 1 }, n: 2 };
    println(f"{w.n}");
}
