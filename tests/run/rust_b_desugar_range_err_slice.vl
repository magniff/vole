// RULE: D2.4a
// (0.30.1) `&s[a..{ s.clear(); 0 }]`: the index's range is built while s is
// borrowed by the indexing, so the clear is E0502 (vole's conflict), as
// rustc.
// ERROR: error[borrowck.conflict]
// ERROR: line 11, column 9
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut s = format_in("abcdef", gpa);
    let t = &s[0usize.. {
        s.clear();
        0usize
    }];
    println("{t}");
}
