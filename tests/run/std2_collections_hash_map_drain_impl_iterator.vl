// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map Drain::impl Iterator.
// EXPECT: Some((1, 2)) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let mut d = m.drain();
    let a = d.next();
    println("{:?} {:?}", a, d.next());
}
