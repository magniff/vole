// (0.26.3, decision 6) `a % b` of u32s panics at every level, with the
// overflow checks on or off, with Rust's message at the expression.
// FLAGS: -O2
// EXIT: 101
// EXPECT: before
// STDERR: ovf_rem_zero_o2.vl:17:13: attempt to calculate the remainder with a divisor of zero

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: u32 = idu(7) as u32;
    let b: u32 = idu(0) as u32;
    println("before");
    let r = a % b;
    println("after {}", r);
}
