// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::io Write::by_ref.
// EXPECT: [1, 2]
use std::io::{BufRead, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.by_ref().write_all(&[1]).unwrap();
    v.write_all(&[2]).unwrap();
    println("{:?}", v);
}
