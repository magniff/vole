// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Write::by_ref.
// EXPECT: [1, 2]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.by_ref().write_all(&[1]).unwrap();
    v.write_all(&[2]).unwrap();
    println("{:?}", v);
}
