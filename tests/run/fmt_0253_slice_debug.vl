// XFAIL: gap 9: output: line 4: expected '| [7, 8]|', got '|[ 7, 8]|' [rustc differs from MVS too: the translation's meaning]
// 0.25.3 (eval 0.25.2.2): `{s:?}` of a slice whose elements have Debug
// writes it as a Vec of them does (`[1, 2, 3]`; `[u8]` keeps its own,
// quoted), in println, format_in and with a width.
// EXPECT: [1, 2, 3] ["a", "b"] [] [4, 5] [2, 3]
// EXPECT: <[1, 2, 3]>
// EXPECT: [1.5, 2.0] "hi"
// EXPECT: |    [7, 8]|
fn main(gpa: Gpa) {
    let s: &[i64] = &[1i64, 2, 3];
    let w: &[&str] = &["a", "b"];
    let e = &s[0..0];
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    v.push(5);
    println("{s:?} {w:?} {e:?} {:?} {:?}", v.as_slice(), &s[1..]);
    let t = format_in("<{s:?}>", gpa);
    println("{}", t.as_str());
    let f: &[f64] = &[1.5, 2.0];
    let b: &str = "hi";
    println("{f:?} {b:?}");
    let p: &[i32] = &[7, 8];
    println("|{p:>10?}|");
}
