// 0.25.3 (eval 0.25.2.2): `{s:?}` of a slice whose elements have Debug
// writes it as a Vec of them does (`[1, 2, 3]`; `[u8]` keeps its own,
// quoted), in println, format_in and with a width.
// EXPECT: [1, 2, 3] ["a", "b"] [] [4, 5] [2, 3]
// EXPECT: <[1, 2, 3]>
// EXPECT: [1.5, 2.0] "hi"
// EXPECT: |    [7, 8]|
fn main(gpa: Gpa) {
    let s: [i64] = [1, 2, 3];
    let w: [[u8]] = ["a", "b"];
    let e = s[0..0];
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(4);
    v.push(5);
    println(f"{s:?} {w:?} {e:?} {v.as_slice():?} {s[1..]:?}");
    let t = format_in(f"<{s:?}>", gpa);
    println(t.as_slice());
    let f: [f64] = [1.5, 2.0];
    let b: [u8] = "hi";
    println(f"{f:?} {b:?}");
    let p: [i32] = [7, 8];
    println(f"|{p:>10?}|");
}
