// RULE: F18.6 (g)
// (0.27.6) A `_` for a bounded parameter, `Vec::<u8, _>::new_in(gpa)`'s
// allocator, is a variable the argument solves, as rustc infers it: in a
// `let`, under an annotation, as an argument and as a struct literal's
// field. Its bound (`A: Allocator`) is checked once it is solved. Before,
// the bound was checked on the variable itself ("the trait 'Allocator' is
// not implemented for '_'"), and a field's value, synthesized first to
// infer the struct's parameter, did not solve it: neither the `_` nor
// `Vec::new_in(g)`'s element type, in `Seen { locs: Vec::new_in(g), .. }`
// ("expected 'Vec<i64, &Gpa>', got 'Vec<_, &Gpa>'").
// EXPECT: 1 2 3 0
// EXPECT: 1 0
use std::alloc::{Allocator, Gpa};

struct Fr<A: Allocator> {
    emsg: Vec<u8, A>,
}

struct Seen<A: Allocator> {
    locs: Vec<i64, A>,
    builtins: Vec<i64, A>,
    position: bool,
}

fn take(v: Vec<u8, Gpa>) -> usize {
    v.len()
}

fn main(gpa: Gpa) {
    let mut v = Vec::<u8, _>::new_in(gpa);
    v.push(1);
    let mut w: Vec<u8, _> = Vec::new_in(gpa);
    w.push(1);
    w.push(2);
    let mut x: Vec<u8, Gpa> = Vec::<u8, _>::new_in(gpa);
    x.push(1);
    x.push(2);
    x.push(3);
    let f = Fr { emsg: Vec::<u8, _>::new_in(gpa) };
    println("{} {} {} {}", v.len(), w.len(), take(x), f.emsg.len());
    let g = &gpa;
    let mut s = Seen { locs: Vec::new_in(g), builtins: Vec::new_in(g), position: false };
    s.locs.push(4);
    println("{} {}", s.locs.len(), if s.position { 1 } else { s.builtins.len() });
}
