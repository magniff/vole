// EDITION: rust
// (0.25) A temporary Vec, Buf or String as the receiver of a std method
// (`v.clone().len()`, `String::from_in(..).as_str()`, `s.clone().trim()`)
// is dropped at the end of its statement (it leaked: a generic result was
// taken for a copy of what the call reads).
// FLAGS: --check-alloc
// EXPECT: 1 1 3 1 2
// EXPECT: drops 1
#[derive(Clone)]
struct D { n: i64 }
static mut DROPS: i64 = 0;
impl Drop for D { fn drop(&mut self) { unsafe { DROPS += 1; } } }

fn main(gpa: Gpa) {
    let s = String::from_in(" x ", gpa);
    let a = String::from_in("x", gpa).as_str().len();
    let b = s.clone().trim().len();
    let c = s.clone().len();
    let mut v: Vec<D, Gpa> = Vec::new_in(gpa);
    v.push(D { n: 1 });
    let d = v.clone().len();
    let mut w: String<Gpa> = String::new_in(gpa);
    w.push_str("ab");
    let e = w.clone().as_bytes().len();
    println("{a} {b} {c} {d} {e}");
    let drops_now = unsafe { DROPS }; println("drops {drops_now}");
}
