// EDITION: rust
// RULE: D3.6
// (0.27.1) A `&mut` parameter passed on twice: each call reborrows `&mut
// *r`.

fn inc(r: &mut i64) {
    *r += 1;
}

fn twice(r: &mut i64) {
    inc(r);
    inc(r);
}

fn main() {
    let mut x: i64 = 1;
    twice(&mut x);
    println("{}", x);
}
// EXPECT: 3
