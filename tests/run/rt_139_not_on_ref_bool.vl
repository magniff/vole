// XFAIL: RT-139: `!r` with `r: &bool` is refused ("cannot apply unary operator '!'"); rustc uses `impl Not for &bool` (0.30.2)
// From the review of c302const; v0.30.1 too. The unary form of RT-71.
// EXPECT: false 2
fn main() {
    let t = true;
    let r = &t;
    let a = [true, false, false];
    let mut n = 0;
    for x in a.iter() {
        if !x {
            n += 1;
        }
    }
    println("{} {}", !r, n);
}
