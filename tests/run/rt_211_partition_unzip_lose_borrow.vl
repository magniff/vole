// rustc refuses it (twin: r302d_033_partition_unzip_results_drop_borrows.rs.txt):
// E0505 at drop(v) (line 22), E0502 at x.push (line 32) and x[0] = 55
// (line 34). vole builds it with no error; at -O0 it prints
// `[1001, 1003] [1000, 1002] 4` (a and b read w's values from v's freed block)
// and `[-2373282909695115039] [-2373282909695115039]` (x's old block); --check-alloc:
// `use after free: block #1 (32 bytes), allocated at ..:4:9, freed at ..:7:5`.
// collect_in (`-> B`), fold, extend, reduce, last, max_by_key, nth, peekable,
// scan, enumerate, find_map and min_by results keep the borrow (om/z1-z18):
// partition_in's `-> (B, B)` and unzip_in's `-> (FromX, FromY)`, a tuple of type
// parameters that only bounds tie to Self::Item, lose it. Since v0.28.0.
// (0.30.2) The lines above count the XFAIL line this case had: without
// it, and with these five, drop(v) is line 26 and x.push line 36;
// rustc's third, x[0] = 55, is the same loan of x as the push, and vole
// reports a loan's first conflict only (as for collect_in's result on
// v0.30.1), so two errors.
// ERROR: line 26
// ERROR: line 36
// ERROR-COUNT: 2
// FLAGS: --check-alloc
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..4i64 {
        v.push(i + 1);
    }
    let (a, b): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = v.iter().partition_in(|x| **x % 2 == 0, gpa);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..4i64 {
        w.push(1000 + i);
    }
    println("{:?} {:?} {}", a, b, w.len());
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    let (c, d): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = x.iter().map(|e| (e, e)).unzip_in(gpa);
    for _ in 0..100 {
        x.push(9);
    }
    x[0] = 55;
    println("{:?} {:?}", c, d);
}
