// FLAGS: --check-unsafe
// REQUIRES: macos
// EXIT: 101
// STDERR: unsafe access out of bounds (just past the end): 1 bytes at offset 48 of a block of 48 bytes
// STDERR: note: the program replaced malloc_logger after --check-unsafe set it
// 0.30.1: a valid program that replaces malloc_logger after its first
// malloc takes away the hook through which the check sees C's own frees:
// reallocf's free of the block is then not seen, and strdup's copy in the
// same memory is reported as the old block's. The report says so (not
// that an unchecked write went over the red zone, as it did earlier on
// 0.30.1's branch): a known false report, docs/releases.md.
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn reallocf(p: *mut u8, n: usize) -> *mut u8;
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
    static mut malloc_logger: extern "C" fn(u32, u64, u64, u64, u64, u32);
}

extern "C" fn quiet(_k: u32, _a: u64, _b: u64, _c: u64, _r: u64, _f: u32) {}

fn main() {
    // UNSAFE: C's allocator and its logger.
    // SAFETY: the reads are inside strdup's copy of 61 bytes.
    unsafe {
        let p = malloc(48);
        malloc_logger = quiet;
        let q = reallocf(p, 4096);
        let s = strdup(
            c"0123456789012345678901234567890123456789012345678901234567890" as *const u8);
        let mut sum = 0u64;
        for i in 0..61 {
            sum += *s.add(i) as u64;
        }
        println("sum {sum}");
        free(s);
        free(q);
    }
}
