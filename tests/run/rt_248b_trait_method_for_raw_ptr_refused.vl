// XFAIL: RT-248b: (RT-248's mechanism, a program's trait) `p.g(5)` with `p: *const W` and impls of G<i64> for `*const W` (1) and W (2) is refused, "expected '&W', got '*const W'": the probe takes the pointee's impl; rustc calls the raw pointer's and prints `1 2 3` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p04_raw_ptr_vs_pointee.
// EXPECT: 1 2 3
trait G<X> {
    fn g(&self, x: X) -> i64;
}

struct W {
    k: i64,
}

impl G<i64> for *const W {
    fn g(&self, x: i64) -> i64 {
        1 + x * 0
    }
}

impl G<i64> for W {
    fn g(&self, x: i64) -> i64 {
        2 + x * 0
    }
}

fn main() -> i32 {
    let w = W { k: 3 };
    let p: *const W = &raw const w;
    println("{} {} {}", unsafe { p.g(5) }, w.g(5), w.k);
    0
}
