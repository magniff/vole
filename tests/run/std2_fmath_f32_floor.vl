// EDITION: rust
// The std2 item(s): std::fmath f32::floor; f32::ceil; f32::round; f32::trunc; f32::fract; f32::abs; f32::sqrt; f32::powi; f32::to_bits; f32::from_bits; f32::sin; f32::min; f32::max; f32::is_nan; f32::total_cmp.
// EXPECT: 2 3 3 2 -0.5 2.5
// EXPECT: 1.5811388 15.625 0.598472 1.4142135
// EXPECT: 40200000 3.1415927 1 2.5
// EXPECT: true Less
fn main() {
    let y = 2.5f32;
    println("{} {} {} {} {} {}", y.floor(), y.ceil(), y.round(), y.trunc(), (-y).fract(),
        (-y).abs());
    println("{} {} {:.6} {}", y.sqrt(), y.powi(3), y.sin(), 2.0f32.sqrt());
    println("{:x} {} {} {}", y.to_bits(), f32::from_bits(0x40490fdb), y.min(1.0),
        y.max(0.0f32 / 0.0));
    println("{} {:?}", (0.0f32 / 0.0).is_nan(), (-0.0f32).total_cmp(&0.0f32));
}
