// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: copied 16
// STDERR: unsafe access after free: 8 bytes at offset 0 of a block of 16 bytes
// STDERR: --> memmove, its source
// 0.30.1: std's ptr::copy (memmove) and copy_nonoverlapping (memcpy) of 4
// elements or more check both ends first: a copy within a live block
// passes; 8 bytes out of a freed one are stopped.
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn free(p: *mut u8);
}

fn main() {
    let mut dst = [0u8; 32];
    // UNSAFE: a copy in the block, then deliberately one out of it once freed.
    // SAFETY: none for the second: the program exists to be stopped.
    unsafe {
        let p = malloc(16);
        for i in 0..16 {
            *p.add(i) = 16;
        }
        std::ptr::copy_nonoverlapping(p as *const u8, &mut dst[0] as *mut u8, 16);
        println("copied {}", dst[15]);
        free(p);
        std::ptr::copy(p as *const u8, &mut dst[0] as *mut u8, 8);
        println("copied out of a freed block {}", dst[0]);
    }
}
