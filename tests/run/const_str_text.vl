// 0.25.4: `const X: str = "..."` is text, a constant: its uses are the
// literal, as a `[u8]` constant's are. (0.25.3 refused it: allowed, it was
// read as an integer constant, `ir_const(0)`, a null slice, and crashed.)
// A `str` constant goes where a `str` and a `[u8]` go, has str's methods,
// and is a hole in an f-string; a text block is one too.
// EXPECT: vole 4 3 2 true
// EXPECT: vole
// EXPECT: mod
// EXPECT: v-o-l-e
// EXPECT: [u8] 4
// EXPECT: text: vole, 6 bytes
const NAME: str = "vole";
const BLOCK: str = """
    a
    b
    """;
const SEP: str = "-";

mod names {
    pub const OTHER: str = "mod";
}

fn width(s: str) -> i64 {
    s.len() as i64
}

fn bytes(b: [u8]) -> i64 {
    b.len as i64
}

fn main(gpa: Gpa) {
    let n = NAME;
    let vo = NAME.starts_with("vo");
    println("{n} {} {} {} {vo}", width(NAME), BLOCK.len(), BLOCK.lines().count());
    println(NAME);
    println(names::OTHER);
    var out = String::new_in(gpa);
    var first = true;
    for c in NAME.chars() {
        if !first {
            out.push_str(SEP);
        }
        out.push(c);
        first = false;
    }
    println(out.as_str());
    println("[u8] {}", bytes(NAME));
    let msg = format_in("text: {NAME}, {} bytes", NAME.len() + SEP.len() + 1, gpa);
    println(msg.as_slice());
}
