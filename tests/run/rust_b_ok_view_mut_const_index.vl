// EDITION: rust
// RULE: D1.5
// (0.27.1) `&mut s[0]` and `&mut s[1]` of a `&mut [i64]`: constant indices
// are disjoint (R7); rustc indexes through a temporary and rejects it.
// RUSTC: rejects R7 constant indices are disjoint; rustc indexes `s[0]` through a temporary

fn touch(s: &mut [i64]) {
    let p = &mut s[0];
    let q = &mut s[1];
    *p += 10;
    *q += 20;
}

fn main() {
    let mut a = [1i64, 2];
    touch(&mut a[..]);
    println("{} {}", a[0], a[1]);
}
// EXPECT: 11 22
