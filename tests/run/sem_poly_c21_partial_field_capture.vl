#[derive(Clone, Copy)] struct P { x: i64, y: i64 }

fn main() {
    let mut p = P { x: 1, y: 2 };
    let c = || { p.x += 1; };
    p.y = 30;
    c();
    println("{} {}", p.x, p.y);
}
