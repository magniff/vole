// From review 5 of f301mslice (2026-11-15). rustc builds it and it prints
// ok; a non-generic Drop and a generic inherent method are fine.
// EXPECT: ok
use std::thread;
struct W<T> { n: i64, t: T }

impl<T> Drop for W<T> {
    fn drop(&mut self) { thread::scope(|s| { s.spawn(|| 1i64); }); }
}

fn main() { let w = W { n: 0i64, t: 1u8 }; let _ = w.n; println("ok"); }
