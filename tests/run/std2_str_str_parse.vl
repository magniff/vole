// The std2 item(s): std::str str::parse.
// EXPECT: 4 -12 3.5 true Err(ParseIntError { kind: InvalidDigit })
use std::str::CharIndices;

fn main() {
    let a: u32 = "4".parse().unwrap();
    let b = "-12".parse::<i64>().unwrap();
    let c: f64 = "3.5".parse().unwrap();
    let d: bool = "true".parse().unwrap();
    println("{} {} {} {} {:?}", a, b, c, d, "4x".parse::<u32>());
}
