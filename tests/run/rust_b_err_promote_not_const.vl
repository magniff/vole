// EDITION: rust
// RULE: D2.8
// (0.27.5) Not promotable: an array of a local's value, and one of a
// call's (`&[one()]`, as rustc's `&[String::new()]`). Assigned (no `let`
// to extend it), the temporary is its branch's, and the reference kept
// past the branch outlives it (rustc E0716); the literals' are promoted.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 25, column 20
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 31, column 20
// ERROR-COUNT: 2
fn one() -> i64 {
    1
}

fn lit(c: bool) -> usize {
    let list: &[i64];
    list = if c { &[1, 2] } else { &[3] };
    list.len()
}

fn local(c: bool) -> usize {
    let x = 5i64;
    let list: &[i64];
    list = if c { &[x, 1] } else { &[2] };
    list.len()
}

fn called(c: bool) -> usize {
    let list: &[i64];
    list = if c { &[one()] } else { &[2] };
    list.len()
}

fn main() {
    println("{} {} {}", lit(true), local(true), called(true));
}
