// RULE: D19.1, D19.10
// (0.30.2, RT-44) Closures nested in closures in a generic Drop impl's
// instance, each with a reference in its signature (X_C slots) and
// capturing the outer one's: each is made after run_places' kinds, its
// body built before the one that makes it, innermost first.
// EXPECT: ok
// EXPECT: drop 26
fn ap<F: Fn(&i64) -> i64>(f: F) -> i64 {
    let x = 4i64;
    f(&x)
}

struct W<T> {
    n: i64,
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let n = self.n;
        let outer = |a: &i64| -> i64 { ap(|b| *b + *a + n) };
        println("drop {}", ap(outer) + 8);
    }
}

fn main() {
    let w = W { n: 10, t: 1u8 };
    let _ = &w.t;
    println("ok");
}
