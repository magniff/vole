// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145) Functions that call each other, each
// holding the other's opaque value (`Some(b(..))`, `(a(n), 1)`) while that
// one's hidden type is not known (being checked): decided once both are
// known, so each D is dropped once, as rustc. Deciding by checking the
// other function there would meet a cycle rustc has not (opaque.cycle).
// The output is rustc's. (x09 of the review)
// EXPECT: b got 10
// EXPECT: drop 10
// EXPECT: a got true
// EXPECT: drop 20
// EXPECT: main 11
// EXPECT: drop 11
struct D {
    k: i64,
}

fn val(d: &D) -> i64 {
    d.k
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn a(n: i64) -> impl Fn() -> i64 {
    if n > 0 {
        let o = Some(b(n - 1));
        println("a got {}", o.is_some());
    }
    let d = D { k: 10 + n };
    move || val(&d)
}

fn b(n: i64) -> impl Fn() -> i64 {
    let t = (a(n), 1i64);
    println("b got {}", (t.0)());
    let d = D { k: 20 + n };
    move || val(&d)
}

fn main() {
    let f = a(1);
    println("main {}", f());
}
