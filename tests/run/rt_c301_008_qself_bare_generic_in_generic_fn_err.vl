// RULE: F8.4
// `let a: W<Q> = <W as Conv<bool>>::c(1u8)` in a generic function: rustc E0107. v0.30.1 refused it for another reason ("'W<u8>::c' is ambiguous"), the branch before the fix printed `2`.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// ERROR: 'W' is generic: write its type arguments ('W<...>')
trait Conv<T> {
    fn c(x: u8) -> Self;
}

struct W<U> {
    u: i64,
    p: Option<U>,
}

impl<U> Conv<i64> for W<U> {
    fn c(x: u8) -> W<U> {
        W { u: 1, p: None }
    }
}

impl<U> Conv<bool> for W<U> {
    fn c(x: u8) -> W<U> {
        W { u: 2, p: None }
    }
}

fn g<Q>() -> i64 {
    let a: W<Q> = <W as Conv<bool>>::c(1u8);
    a.u
}

fn main() {
    println("{}", g::<u8>());
}
