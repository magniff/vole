// Review 5's m04: the trait argument is itself a reference the caller
// chooses, `Tr<&'b str>`, beside `Tr<i32>` needing `'a: 'static`. rustc
// accepts it.
// EXPECT: 1
trait Tr<U> { fn f(&self, u: U) -> i64; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self, u: i32) -> i64 { 32 } }
impl<'a, 'b> Tr<&'b str> for W<'a> { fn f(&self, u: &'b str) -> i64 { 1 } }
fn go<'b, T: Tr<&'b str>>(t: &T, s: &'b str) -> i64 { t.f(s) }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() };
    println("{}", go(&x, st.as_str()));
}
