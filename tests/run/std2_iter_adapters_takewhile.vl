// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters TakeWhile.
// EXPECT: [1]
use std::iter::TakeWhile;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 3, 1], gpa);
    let v: Vec<i64, Gpa> = s.iter().copied().take_while(|x| *x < 2).collect_in(gpa);
    println("{:?}", v);
}
