// EDITION: rust
// a copy of a view struct views the same elements (a view, not an owner)
// EXPECT: 1 1 2
#[derive(Clone, Copy)] struct W<'a> { s: &'a [i64], pos: i64 }

fn main() {
    let a = [1i64, 2, 3]; let w = W { s: &a[..], pos: 0 }; let mut w2 = w; w2.pos = 1;
    println("{} {} {}", w.s[w.pos as usize], w2.s[0], w2.s[w2.pos as usize]);
}
