// XFAIL: RT-336: assigning to a field of a constant's temporary, `Q[0].k = 9`, and `&mut Q` are refused ("invalid assignment target"); rustc accepts (with a warning): each use of Q is a fresh temporary (0.30.2)
// Since v0.30.1 at least. From the review of the opaque-type work.
// EXPECT: 3
// EXPECT: 7 1
// EXPECT: 8 4
struct N {
    k: i64,
}

const Q: [N; 2] = [N { k: 3 }, N { k: 4 }];
const K: [i64; 3] = [1, 2, 3];

fn main() {
    Q[0].k = 9;
    println("{}", Q[0].k);
    let mut k = K;
    k[0] = 7;
    println("{} {}", k[0], K[0]);
    let r = &mut Q;
    r[1].k = 8;
    println("{} {}", r[1].k, Q[1].k);
}
