// Runs on std since 0.27.2's switch.
// The std item(s): std::slice Iter::impl DoubleEndedIterator.
// EXPECT: Some(3) Some(1) Some(2) None

fn main() {
    let s: &[i64] = &[1, 2, 3];
    let mut it = s.iter();
    println("{:?} {:?} {:?} {:?}", it.next_back(), it.next(), it.next_back(), it.next());
}
