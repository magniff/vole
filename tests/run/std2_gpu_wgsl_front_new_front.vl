// The std2 item(s): std::gpu::wgsl::front new_front, Front::module, Front;
// std::gpu::wgsl::uniformity check.
// (0.27.6) The WGSL front on an arena's scope, as the compiler checks an
// `embed wgsl` block: a module that checks, and the first error of one
// that does not (its code, byte position, message and help).
// RUSTC: none (std::gpu is vole's)
// EXPECT: ok
// EXPECT: wgsl.type 23 expected i32, got bool
// EXPECT: convert it: i32(...)
// EXPECT: wgsl.recursion 3 'f' calls itself, directly or through other functions
// EXPECT: WGSL has no recursion: write it as a loop
use std::alloc::{Arena, Gpa};
use std::gpu::wgsl::uniformity;
use std::gpu::wgsl::front::new_front;

fn check(text: &[u8], gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    arena.scope(|s| {
        let mut fr = new_front(text, s);
        fr.module();
        if !fr.failed {
            uniformity::check(&fr);
        }
        if !fr.failed {
            println("ok");
        } else {
            println("{} {} {}", str::from_utf8(fr.err_code).unwrap(), fr.err_pos,
                str::from_utf8(&fr.emsg).unwrap());
            if fr.ehelp.len() > 0 {
                println("{}", str::from_utf8(&fr.ehelp).unwrap());
            }
        }
    });
}

fn main(gpa: Gpa) {
    check(b"@compute @workgroup_size(1) fn main() { var x: i32 = 1; x = x + 1; }", gpa);
    check(b"fn f() -> i32 { return true; }", gpa);
    check(b"fn f(x: i32) -> i32 { return f(x - 1); }", gpa);
}
