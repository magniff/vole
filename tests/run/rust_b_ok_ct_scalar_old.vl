// EDITION: rust
// RULE: D17.2
// (0.27.1) `requires` and `ensures` with `old(x)` of a scalar: a copy, no
// loan.
// RUSTC: none contract clauses are not Rust

fn half(x: i64) -> i64
    requires x >= 0
    ensures result <= old(x)
{
    x / 2
}

fn main() {
    println("{}", half(8));
}
// EXPECT: 4
// (passes on std2: was XFAIL, std2 has no contract_check, which a contract's lowering calls (std2))
