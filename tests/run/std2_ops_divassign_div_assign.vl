// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops DivAssign::div_assign.
// EXPECT: V { x: 2 } 2
use std::ops::DivAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl DivAssign for V {
    fn div_assign(&mut self, rhs: V) {
        self.x /= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.div_assign(V { x: 5 });
    let mut n = 12i64;
    n.div_assign(5);
    println("{:?} {}", a, n);
}
