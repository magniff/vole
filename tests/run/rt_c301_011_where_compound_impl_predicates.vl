// XFAIL: RT-C301-11: a where predicate on a compound type met by an impl with lifetime bounds (`where V<T>: Sup`, `where X<'a>: Sup`, the impl `'a: 'static`) is not assumed in the body: the call through it is refused, borrowck.outlives (0.30.2)
// From review 4's fix (d14, d17): the impl's predicates are required where `T: Sup` is met (an instance's bounds), not yet where a where predicate on another type is; before 0.30.1's review 4 the call was taken and the predicates never required (a use after free), now it is refused.
// rustc accepts it: the predicate holds in the body and is proven at the call ("lit" is 'static).
// EXPECT: lit lit
trait Sup {
    fn up(&self) -> &'static str;
}

struct X<'a> {
    r: &'a str,
}

struct V<T> {
    t: T,
}

impl<'a: 'static> Sup for X<'a> {
    fn up(&self) -> &'static str {
        self.r
    }
}

impl<T: Sup> Sup for V<T> {
    fn up(&self) -> &'static str {
        self.t.up()
    }
}

fn go<T>(v: &V<T>) -> &'static str where V<T>: Sup {
    v.up()
}

fn go2<'a>(x: &X<'a>) -> &'static str where X<'a>: Sup {
    x.up()
}

fn main() {
    let x = X { r: "lit" };
    let s = go(&V { t: x });
    let x2 = X { r: "lit" };
    println("{} {}", s, go2(&x2));
}
