// XFAIL: RT-225b: (must-fail side of R302E-2) the results of a program's collector fns `-> B`, `-> (B,)`, `-> (B, B)`, `-> Option<B>` keep the borrow of the iterator they were made from: drop(v) while they live is E0505 at the drop, not borrowck.outlives in the collector's body (0.30.2)
// rustc E0505 at each drop (lines 56, 60, 64, 68). Today the release build
// refuses the collectors' bodies instead (borrowck.outlives at lines 16, 24,
// 33 and 41; R302E-2), and v0.30.0 built this program with no error: a use after
// free from safe code. A fix of R302E-2 must keep these four refused, at the
// drops.
// ERROR: line 56
// ERROR: line 60
// ERROR: line 64
// ERROR: line 68
// ERROR-COUNT: 4
use std::alloc::Allocator;

fn bare<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> B {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    b
}

fn one<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> (B,) {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    (b,)
}

fn two<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> (B, B) {
    let mut y = B::default_in(a.clone());
    let n = B::default_in(a);
    for x in it {
        y.extend(Some(x));
    }
    (y, n)
}

fn opt<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> Option<B> {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    Some(b)
}

fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v
}

fn main(gpa: Gpa) {
    let v = mk(gpa);
    let r0: Vec<&i64, Gpa> = bare(v.iter(), gpa);
    drop(v);
    println("{:?}", r0);
    let w = mk(gpa);
    let r1: (Vec<&i64, Gpa>,) = one(w.iter(), gpa);
    drop(w);
    println("{:?}", r1.0);
    let x = mk(gpa);
    let r2: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = two(x.iter(), gpa);
    drop(x);
    println("{:?}", r2.0);
    let y = mk(gpa);
    let r3: Option<Vec<&i64, Gpa>> = opt(y.iter(), gpa);
    drop(y);
    println("{:?}", r3);
}
