struct N {
    v: i64,
}

struct P2 {
    a: N,
    b: N,
}

fn main() {
    let mut p = P2 { a: N { v: 1 }, b: N { v: 2 } };
    let q = p;
    p.a = N { v: 3 };
    println("{}", q.a.v);
}
