// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::max.
// EXPECT: Some(4) Some("b") None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let s = Vec::from_in(["a", "b"], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{:?} {:?} {:?}", v.iter().max(), s.iter().max(), e.iter().max());
}
