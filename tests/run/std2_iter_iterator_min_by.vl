// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::min_by.
// EXPECT: Some(1)
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, -5, 3], gpa);
    println("{:?}", v.iter().min_by(|a, b| a.abs().cmp(&b.abs())));
}
