// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops RangeFrom.
// EXPECT: 3.. 3 3 4 5
use std::ops::RangeFrom;

fn main() {
    let r: RangeFrom<i64> = 3..;
    print("{:?} {}", r, r.start);
    for i in r.take(3) {
        print(" {}", i);
    }
    println("");
}
