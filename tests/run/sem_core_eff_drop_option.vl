// EDITION: rust
// Dropping an Option of a type whose Drop prints.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(&mut self) { println("dropped"); } }

#[no_io]
fn quiet(o: Option<Noisy>) -> bool { o.is_some() }

fn main() -> i32 {
    println("{}", quiet(Some(Noisy { n: 1 })));
    0
}
