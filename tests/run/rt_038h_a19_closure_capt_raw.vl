// ERROR: the 'requires' of 'f' calls 'closure() -> bool
// A closure parameter that captured a raw pointer, called in the clause.
fn f<F: Fn() -> bool>(g: &F) -> i64
    requires g()
{
    1
}

fn main() {
    let mut x = 1i64;
    let p = &raw mut x;
    let g = || {
        // UNSAFE: test
        // SAFETY: test
        unsafe { *p = 9; }
        true
    };
    println("{}", f(&g));
    println("{}", x);
}
