// (0.30.2, the re-review of g302holes: r91/r08_impl_block)
// EXPECT: 36
// EXPECT: 4
// Closures returning closures inside an impl block method and a trait default method.
struct S { v: [i64; 3] }

impl S {
    fn total(&self, m: i64) -> i64 {
        let w = [1i64, 2];
        w.iter().flat_map(|a| self.v.iter().map(move |b| a * b * m)).sum()
    }
}

trait T {
    fn base(&self) -> i64;

    fn mk(&self) -> i64 {
        let b = self.base();
        let f = |x: i64| move |y: i64| x + y + b;
        f(1)(2)
    }
}

impl T for S {
    fn base(&self) -> i64 { self.v[0] }
}

fn main() {
    let s = S { v: [1, 2, 3] };
    println("{}", s.total(2));
    println("{}", s.mk());
}
