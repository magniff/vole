// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_value_independence_array.vl to Rust's spelling.
// sem-own: `var b = a` of an array of plain values is a copy; an array of owned values moves.
// EXPECT: 1 9
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn main(gpa: Gpa) {
    let mut a = [1, 2, 3];
    let mut b = a;
    b[0] = 9;
    println("{} {}", a[0], b[0]);
}
