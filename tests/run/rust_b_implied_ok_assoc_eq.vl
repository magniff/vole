// RULE: D4.6
// (0.27.2.1) A bound's equality, `I: Src<Item = T>`: the source's item is
// stored where a T is required, as `Extend::extend` does.
// EXPECT: hi
trait Src {
    type Item;
    fn take(&mut self) -> Option<Self::Item>;
}

struct One<'a> {
    s: Option<&'a str>,
}

impl<'a> Src for One<'a> {
    type Item = &'a str;

    fn take(&mut self) -> Option<&'a str> {
        let r = self.s;
        self.s = Option::None;
        r
    }
}

struct Keep<T> {
    last: Option<T>,
}

impl<T> Keep<T> {
    fn fill<I: Src<Item = T>>(&mut self, i: I) {
        let mut i = i;
        self.last = i.take();
    }
}

fn main() {
    let mut k: Keep<&str> = Keep { last: Option::None };
    k.fill(One { s: Option::Some("hi") });
    println("{}", k.last.unwrap());
}
