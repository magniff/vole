// XFAIL: RT-264: a `&mut i64` reached through a `*const &mut i64` is not behind an immutable pointer: `**p = 9`, `let q: *mut i64 = *p;` and `*p as *mut i64` are accepted and write through it (rustc E0594, E0596) (0.30.2)
// From the review of g302bor (a/t02, t03, f35). The `*const` comes from a
// `&&mut i64` by a coercion, so the `&mut` is behind a shared reference too;
// the E0596/E0594 check stops at a `&` and does not treat a `*const` deref
// as immutable (a thin `*p = 9` with `p: *const i64` is refused). The
// derefs need `unsafe`, as rustc's do; rustc refuses them there. On v0.30.1
// too.
// rustc: E0594 (cannot assign to `**p`, which is behind a `*const` pointer),
// E0596 (cannot borrow `**p` as mutable, as it is behind a `*const` pointer).
// ERROR: line 20
// ERROR: line 28
// ERROR: line 36
// ERROR-COUNT: 3
// ERROR: error[borrowck.assign_immutable]
fn assign(rr: &&mut i64) {
    let p: *const &mut i64 = rr;
    // UNSAFE: the case: a write through a `*const` pointer's `&mut`
    // SAFETY: none; the write must be refused
    unsafe {
        **p = 9;
    }
}

fn coerce(rr: &&mut i64) -> *mut i64 {
    let p: *const &mut i64 = rr;
    // UNSAFE: the case: a `&mut` behind a `*const` read as `*mut`
    // SAFETY: none; the coercion must be refused
    let q: *mut i64 = unsafe { *p };
    q
}

fn cast(rr: &&mut i64) -> *mut i64 {
    let p: *const &mut i64 = rr;
    // UNSAFE: the case: a `&mut` behind a `*const` cast to `*mut`
    // SAFETY: none; the cast must be refused
    unsafe { *p as *mut i64 }
}

fn main() {
    let mut x = 1i64;
    let m = &mut x;
    assign(&m);
    let q = coerce(&m);
    let r = cast(&m);
    println("{} {}", q == r, *m);
}
