// RULE: D3.2
// (0.28.0) A static's references are 'static: a value stored in one must
// outlive 'static, and `s.as_str()` of a local String does not (rustc
// E0597). 0.27.8 gave the static's slots variables of their own, and
// accepted it.
// ERROR: error[borrowck.dropped_borrowed]
static mut K: &str = "";

fn main(gpa: Gpa) {
    let s = String::from_in("hello", gpa);
    // UNSAFE: the test's static
    // SAFETY: one thread
    unsafe {
        K = s.as_str();
    }
}
