// RULE: C3.4
// (0.30.2, RT-38f) What the views let a clause do through a hidden `&mut`:
// read it, before the body and after it, in `old(..)` and in `result`,
// the same with and without --debug-contracts (rt_038f_g is this case
// with them on).
// RUSTC: none contract clauses are not Rust
// EXPECT: 2
// EXPECT: 2
// EXPECT: 3
// EXPECT: 3
type R<'a> = &'a mut i64;

trait Bump {
    fn bump(self) -> i64;
}

impl Bump for &mut i64 {
    fn bump(self) -> i64
        requires * self > 0
        ensures * self == result
        debug ensures * self > 1
    {
        *self += 1;
        *self
    }
}

fn f(p: R<'_>) -> i64
    requires * p > 0
    ensures * p == old(*p) + 1
    debug requires * p < 100
    debug ensures result == *p
{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
    println("{}", (&mut x).bump());
    println("{}", x);
}
