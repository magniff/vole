// Runs on std since its arrays' by-value IntoIterator (0.27.3).
// The std item(s): std::collections::hash_set HashSet::impl FromIteratorIn.
// EXPECT: 2 true
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let s: HashSet<i64, Gpa, FixedState> = [1i64, 2, 1].into_iter().collect_in(gpa);
    println("{} {}", s.len(), s.contains(&2));
}
