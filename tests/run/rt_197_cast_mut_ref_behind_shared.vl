// From the re-review of g302holes.
// rustc: E0596
// ERROR: line 8
// A &mut behind a & cast to *mut: rustc E0596 (cannot borrow as mutable behind a & reference).
struct H<'a> { r: &'a mut i64 }

fn g(h: &H) -> *mut i64 {
    h.r as *mut i64
}

fn main() {
    let mut x = 1i64;
    let h = H { r: &mut x };
    let p = g(&h);
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    println("{}", *h.r);
}
