// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Add::add.
// EXPECT: V { x: 17 } 17
use std::ops::Add;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Add for V {
    type Output = V;

    fn add(self, rhs: V) -> V {
        V { x: self.x + rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.add(b), Add::add(12i64, 5));
}
