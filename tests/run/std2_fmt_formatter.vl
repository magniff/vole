// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter.
// EXPECT: [ab   ] [   ab] [ ab  ] [a]
use std::fmt::{Display, Formatter};

struct S;

impl Display for S {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.pad("ab")
    }
}

fn main() {
    println("[{:5}] [{:>5}] [{:^5}] [{:.1}]", S, S, S, S);
}
