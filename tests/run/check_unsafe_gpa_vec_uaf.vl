// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe access after free: 8 bytes at offset 8 of a block of 32 bytes
// STDERR: check_unsafe_gpa_vec_uaf.vl: line 18, column 22
// 0.30.1: --check-unsafe alone sees Gpa's memory (every Vec, String and
// Box): std's Gpa calls `#[link_name = "malloc"] fn gpa_c_malloc`, which
// the check took for another function than C's malloc (it knew C's by
// their vole names): from 0.28.0 to 0.30.0 this read freed memory and
// exited 0 (caught only with --check-alloc too).
fn main(gpa: Gpa) {
    let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    v.push(8);
    let p: *const u64 = v.as_ptr();
    drop(v);
    // UNSAFE: a deliberate use after free, to test --check-unsafe.
    // SAFETY: none: this program exists to be stopped.
    let x = unsafe { *p.add(1) };
    println("read {x}");
}
