// RULE: D8.5
// (0.27.2.1) `c += d` is `AddAssign::add_assign(&mut c, d)`: d moves into
// it and is dropped there, once; c stays usable.
// EXPECT: drop 2
// EXPECT: 3
// EXPECT: drop 3
use std::ops::AddAssign;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl AddAssign for D {
    fn add_assign(&mut self, o: D) {
        self.n += o.n;
    }
}

fn main() {
    let mut c = D { n: 1 };
    let d = D { n: 2 };
    c += d;
    println("{}", c.n);
}
