// The 0.4 language additions: enum constants and checked casts, ordering
// and variant ranges, `use`, size_of/align_of, C string constants and
// statics, i64 slice lengths, for loops over slices and arrays, raw
// identifiers, packed(N).
// EXPECT: const Green 5
// EXPECT: cast Red Blue 2
// EXPECT: order true false true
// EXPECT: range warm warm cold cold
// EXPECT: use 3 big small 12
// EXPECT: sizes 8 4 16 8 24 1 12 2
// EXPECT: strings hello world
// EXPECT: slices 4 10 3
// EXPECT: each 15 9 12 2
// EXPECT: raw 7 8
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy, PartialEq, Eq)] #[repr(u8)]
enum Color { Red, Green = 5, Blue }

#[derive(Clone, Copy, PartialEq, Eq)] enum Temp { Freezing, Cold, Mild, Warm, Hot }

#[derive(Clone, Copy)] enum Size { Small, Big(i64) }

use Size::{Big, Small};
use Temp::{Hot, Warm};

const FAVORITE: Color = Color::Green;
const LABEL: *mut u8 = c"hello";
static GREETING: *mut u8 = c"world";

#[derive(Clone, Copy)] #[repr(C, packed(2))]
struct P2 { a: u8, b: i64, c: u16 }

#[derive(Clone, Copy)] struct Pair { a: i64, b: i32 }

const PAIR_SIZE: i64 = size_of(Pair);

fn name(c: Color) -> *mut u8 {
    match c {
        Color::Red => c"Red",
        Color::Green => c"Green",
        Color::Blue => c"Blue",
    }
}

fn feel(t: Temp) -> *mut u8 {
    match t {
        Temp::Freezing..=Temp::Cold => c"cold",
        Temp::Mild => c"mild",
        Warm | Hot => c"warm",
    }
}

fn describe(s: Size) -> *mut u8 {
    match s {
        Big(n) if n > 10 => c"big",
        Big(_) => c"medium",
        Small => c"small",
    }
}

fn weight(s: Size) -> i64 {
    match s {
        Small => 1,
        Big(n) => n,
    }
}

fn main() -> i32 {
    unsafe { printf(c"const %s %d\n", name(FAVORITE), FAVORITE as i32); }
    let zero: i64 = 0;
    let six: u8 = 6;
    let picked: i64 = 6 - 4;
    unsafe {
        printf(c"cast %s %s %d\n", name(zero as Color), name(six as Color), picked);
        printf(c"order %s %s %s\n", if Color::Red < Color::Blue { c"true" } else { c"false" },
            if Temp::Hot <= Temp::Mild { c"true" } else { c"false" },
            if Temp::Cold >= Temp::Freezing { c"true" } else { c"false" });
        printf(c"range %s %s %s %s\n", feel(Temp::Hot), feel(Warm), feel(Temp::Cold),
            feel(Temp::Freezing));
    }
    let sizes = [Big(3i64), Small, Big(11i64)];
    unsafe {
        printf(c"use %ld %s %s %ld\n", weight(sizes[0]), describe(sizes[2]), describe(sizes[1]),
            weight(Big(11i64)) + weight(Small));
    }

    let buf: [u8; size_of(Pair)] = [0; size_of(Pair)];
    unsafe {
        printf(c"sizes %ld %ld %ld %ld %ld %ld %ld %ld\n", size_of(i64), align_of(i32),
            size_of([i32; 4]), size_of(*mut u8), size_of((i64, u8, i64)), align_of(P2) / 2,
            size_of(P2), align_of(P2));
    }
    let _ = buf;
    let _ = PAIR_SIZE;

    unsafe { printf(c"strings %s %s\n", LABEL, GREETING); }

    let data = [1i64, 2, 3, 4];
    let s = &data[..];
    let mut total: i64 = 0;
    for i in 0..s.len() {
        total += s[i];
    }
    let last: i64 = s.len() as i64 - 1;
    unsafe { printf(c"slices %ld %ld %ld\n", s.len(), total, last); }

    let mut sum: i64 = 0;
    for &x in s {
        sum += x;
    }
    let mut odd: i64 = 0;
    for x in [1i64, 3, 5, 7] {
        if x == 7 {
            break;
        }
        if x == 3 {
            continue;
        }
        odd += x;
    }
    let mut nested: i64 = 0;
    outer: for a in [1i64, 2, 3] {
        for &b in s {
            if b == 3 {
                continue :outer;
            }
            nested += a;
        }
    }
    let empty: &[i64] = &s[0..0];
    let mut none: i64 = 2;
    for &x in empty {
        none += x;
    }
    unsafe { printf(c"each %ld %ld %ld %ld\n", sum + 5, odd + 3, nested - 6 + 6, none); }

    let r#type: i64 = 7;
    let r#match = r#type + 1;
    unsafe { printf(c"raw %ld %ld\n", r#type, r#match); }
    0
}
