// (0.27.0) The rust edition's syntax: `&self`, `&mut self`, `self`, `&T`
// and `&mut T` parameters, `&mut x` arguments, `let mut`, `*r`, lifetimes
// in generics, types, bounds and `where`, labels with a quote, `*const T`;
// `'c'` is a char.

struct P {
    x: i64,
    y: i64,
}

struct View<'a> {
    p: &'a P,
}

impl P {
    fn bump(&mut self) {
        self.x += 1;
    }

    fn get(&self) -> i64 {
        self.x + self.y
    }

    fn into_x(self) -> i64 {
        self.x
    }
}

fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut s = 0;
    for x in v.iter() {
        s += x;
    }
    s
}

fn grow(v: &mut Vec<i64, Gpa>, x: i64) {
    v.push(x);
}

fn incr(r: &mut i64) {
    *r += 1;
}

fn pick<'a, T: Copy + 'a>(a: &'a T, b: &'a T, first: bool) -> T where 'a: 'a {
    if first { *a } else { *b }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    grow(&mut v, 2);
    let mut p = P { x: 1, y: 2 };
    p.bump();
    let mut n = 3;
    incr(&mut n);
    let r = &p;
    let f = &r.x;
    let mut k = 0;
    'outer: loop {
        k += 1;
        if k > 3 {
            break 'outer;
        }
    }
    let c = 'c';
    let raw: *const i64 = &n;
    let w = View { p: &p };
    println("{} {} {} {} {} {} {}", p.get(), total(&v), n, *f, k, c, pick(&n, &k, true));
    let q = P { x: 7, y: w.p.y };
    println("{} {}", q.into_x(), unsafe { *raw });
    0
}
// EXPECT: 4 7 4 2 4 c 4
// EXPECT: 7 4
