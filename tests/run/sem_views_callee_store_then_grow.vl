// XFAIL: gap 18: rustc disagrees with the rust edition's error: both reject, but rustc's lifetime is borrowck.outlives, the...
// (0.25 semantics audit, views) A function that stores a view of its
// inout parameter s into its inout parameter out (`stores(s)`), then grows
// s: the stored view outlives the call, so the growth is own.conflict in
// the callee. It is accepted, and the caller reads freed text.
// ERROR: error[own.conflict]
fn f(out: &mut Vec<&str, Gpa>, s: &mut String<Gpa>) {
    out.push(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
}

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello", gpa);
    let mut out: Vec<&str, Gpa> = Vec::new_in(gpa);
    f(&mut out, &mut s);
    println("{}", str::from_utf8(out[0usize]).unwrap());
    0
}
