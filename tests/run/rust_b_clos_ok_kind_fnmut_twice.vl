// EDITION: rust
// RULE: D19.3, D19.5
// (0.27.2) A closure that writes a capture is `FnMut`; each call reborrows
// it `&mut`.
// EXPECT: 2
fn main() {
    let mut n = 0;
    let mut bump = || n += 1;
    bump();
    bump();
    println("{}", n);
}
