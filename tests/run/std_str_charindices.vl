// Runs on std since 0.27.2's switch.
// The std item(s): std::str CharIndices.
// EXPECT: (0, 'h') (1, 'é') (3, '!')
use std::str::CharIndices;

fn main() {
    let mut it: CharIndices<'_> = "hé!".char_indices();
    let a = it.next().unwrap();
    let b = it.next().unwrap();
    let c = it.next().unwrap();
    println("{:?} {:?} {:?}", a, b, c);
}
