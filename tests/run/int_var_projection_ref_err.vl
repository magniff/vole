// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). `let s: &str
// = f(2)` with i32's Out = u64: rustc E0271. 0.30.2's build read the u64 as
// a fat pointer (SIGSEGV).
// ERROR: (rustc E0271)
// ERROR: line 36, column 19
// ERROR-COUNT: 1
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = &'static str;

    fn o(self) -> &'static str {
        "hello"
    }
}

impl Tr for i32 {
    type Out = u64;

    fn o(self) -> u64 {
        8
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let s: &str = f(2);
    println("{}", s.len());
}
