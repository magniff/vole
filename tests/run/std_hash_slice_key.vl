// The std item(s): std::hash [T]::impl Hash.
// (0.27.6) A map keyed by byte slices: `[T]`'s hash calls its element's
// hash_slice, `Hash::hash_slice(self, state)` as in Rust, Self from the
// argument (F8.2); the front read it with `Self = [u8]` before, so
// `HashMap<&[u8], V>` did not check.
// EXPECT: Some(1) None 2
use std::alloc::Gpa;
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<&[u8], i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(b"ab", 1);
    m.insert(b"cd", 2);
    let k: &[u8] = b"ab";
    let other: &[u8] = b"zz";
    println("{:?} {:?} {}", m.get(k), m.get(other), m.len());
}
