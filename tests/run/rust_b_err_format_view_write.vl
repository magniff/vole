// RULE: D3.6
// (0.30.1) A mutable view given to a format hole is read through its
// shared reborrow, `slice (*_k)[..]` (shared_coercion), live to the end
// of the format: a write to the view's element inside a later hole is
// rustc's E0506. Before, the hole's binding copied the view (an I7 copy
// with no loan) and the write was accepted.
// ERROR: error[borrowck.assign_borrowed]: cannot assign to 's[_]' because it is borrowed
// ERROR-COUNT: 1
fn f(s: &mut [u8]) {
    println("{:?} {}", s, {
        s[0] = 9;
        0
    });
}

fn show(s: &mut str) {
    println("{} {}", s, s.len());
}

fn main(gpa: Gpa) {
    let mut w = [1u8, 2];
    f(&mut w);
    let t = String::from_in("abc", gpa);
    show(t.leak());
}
