// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc TypedArena::impl Drop.
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: end
use std::alloc::TypedArena;

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main(gpa: Gpa) {
    {
        let ta = TypedArena::new_in(gpa);
        ta.alloc(Noisy { id: 1 });
        ta.alloc(Noisy { id: 2 });
    }
    println("end");
}
