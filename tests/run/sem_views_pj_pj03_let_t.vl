// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 1 (a let projection of a non-copyable element)
// EXPECT: 1
use std::alloc::Allocator; struct Big<A: Allocator> { a: Vec<i64, A> }
fn first(v: &Vec<Big<Gpa>, Gpa>) -> &Big<Gpa> { v[0] }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Big<Gpa>, Gpa> = Vec::new_in(gpa);
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    v.push(Big { a: a });
    let b = first(&v);
    println("{}", b.a.len());
    0
}
