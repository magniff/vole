// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 1 (a let projection of a non-copyable element)
// XFAIL: OVERSTRICT -> let T / -> inout T projections (D21) are rejected: 'references as results come in 0.17.1'
// EXPECT: 1
struct Big<A: Allocator> { a: Vec<i64, A> }
fn first(v: Vec<Big<Gpa>, Gpa>) -> let Big<Gpa> { v[0] }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<Big<Gpa>, Gpa> = Vec::new_in(gpa);
    var a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    v.push(Big { a: a });
    let b = first(v);
    println(b.a.len());
    0
}
