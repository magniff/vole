// RULE: F33.1
// `&F` of a closure that writes a capture is no FnOnce: calling it needs
// `&mut`.
// ERROR: does not satisfy the bound
fn apply<F: FnOnce(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn main() {
    let mut n = 0;
    let mut count = |x: i64| {
        n += 1;
        x + n
    };
    println("{}", apply(&count, 2));
}
