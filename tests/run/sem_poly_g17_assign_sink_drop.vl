// EDITION: rust
// assigning through an inout T: the old value dropped once, the new one once at the end
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: now 2
// EXPECT: 5
// EXPECT: drop 2
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn put<T>(dst: &mut T, src: T) { *dst = src; }

fn main() {
    let mut a = R { id: 1 };
    put(&mut a, R { id: 2 });
    println("now {}", a.id);
    let mut n: i64 = 1;
    put(&mut n, 5i64);
    println("{n}");
}
