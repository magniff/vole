// XFAIL: RT-124: an associated constant as an array length is not a compile-time constant (RT-124's form) (0.30.2)
// From the g302qual review (form f03_array_len).
// EXPECT: 5 3 5 3
trait A { const N: usize; }
trait B { const N: usize; }
struct S;
impl A for S { const N: usize = 3; }
impl B for S { const N: usize = 5; }
const C: usize = <S as B>::N;
static G: usize = <S as A>::N;

fn main() {
    let a = [7u8; <S as B>::N];
    let b: [u8; <S as A>::N] = [1u8; <S as A>::N];
    println("{} {} {} {}", a.len(), b.len(), C, G);
}
