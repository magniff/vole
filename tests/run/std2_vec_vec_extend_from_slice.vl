// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::extend_from_slice.
// EXPECT: [1, 2, 3, 4]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1], gpa);
    v.extend_from_slice(&[2, 3, 4]);
    println("{:?}", v);
}
