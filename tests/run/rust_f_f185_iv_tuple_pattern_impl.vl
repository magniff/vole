// RULE: F18.5
// (0.30.2) A pattern impl's header `(T, T)` matches a tuple of two
// integer literals, each its own variable: rustc's probe unifies them, T
// the one type they take (i32 here, the fallback), as 0.30.1 did.
// EXPECT: 7
trait Pair<T> {
    fn first(&self) -> &T;
}

impl<T: Copy> Pair<T> for (T, T) {
    fn first(&self) -> &T {
        &self.0
    }
}

fn main() {
    let p = (7, 8);
    println("{}", p.first());
}
