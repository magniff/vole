// EDITION: rust
// RULE: D8.5
// (0.27.2.1) `for x in v` moves v into `into_iter`: each element is
// dropped once, by the loop or by the iterator, and v is not dropped again.
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([D { n: 1 }, D { n: 2 }, D { n: 3 }], gpa);
    for x in v {
        if x.n == 1 {
            println("{}", x.n);
        }
    }
}
