// (0.28.0, gap 86) A parameter `_` of a type with a destructor is bound
// and dropped as a named one is: it crashed (exit 139) at -O1 and -O2,
// where the lowering skipped a parameter with no local, and at -O0 two
// of them read each other's slots. `_` in a `let`, a closure's
// parameter, a match arm and a tuple pattern drop as rustc's do.
// EXPECT: in eat
// EXPECT: drop 1
// EXPECT: after eat
// EXPECT: in eat2
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: after eat2
// EXPECT: after let _
// EXPECT: drop 5
// EXPECT: after let _ temp
// EXPECT: pair got 7
// EXPECT: drop 7
// EXPECT: drop 6
// EXPECT: after pair
// EXPECT: drop 8
// EXPECT: after closure
// EXPECT: arm 10
// EXPECT: drop 10
// EXPECT: after match
// EXPECT: some
// EXPECT: after match2
// EXPECT: drop 12
// EXPECT: drop 13
// EXPECT: after tuple
// EXPECT: in mixed 15 17
// EXPECT: drop 17
// EXPECT: drop 16
// EXPECT: drop 14
// EXPECT: after mixed
// EXPECT: eat_vec 1
// EXPECT: drop 19
// EXPECT: generic 20
// EXPECT: drop 22
// EXPECT: drop 21
// EXPECT: with 21
// EXPECT: end
// EXPECT: drop 11
// EXPECT: drop 9
// EXPECT: drop 4
struct D {
    n: i32,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

struct Big {
    a: i64,
    b: i64,
    c: i64,
    d: D,
}

enum E {
    A(D, D),
    B,
}

fn eat(_: D) -> i32 {
    println("in eat");
    1
}

fn eat2(_: D, _: D) -> i32 {
    println("in eat2");
    1
}

fn mixed(_: D, x: i32, _: Big, y: D, _: i32) -> i32 {
    println("in mixed {} {}", x, y.n);
    x
}

fn eat_vec(_: Vec<u8, Gpa>) -> i32 {
    1
}

fn generic<T>(_: T, n: i32) -> i32 {
    n
}

fn pair(p: (D, D)) {
    let (_, x) = p;
    println("pair got {}", x.n);
}

impl D {
    fn with(self, _: D) -> i32 {
        self.n
    }
}

fn main(gpa: Gpa) {
    eat(D { n: 1 });
    println("after eat");
    eat2(D { n: 2 }, D { n: 3 });
    println("after eat2");
    let v = D { n: 4 };
    let _ = v;
    println("after let _");
    let _ = D { n: 5 };
    println("after let _ temp");
    pair((D { n: 6 }, D { n: 7 }));
    println("after pair");
    let f = |_: D| 3;
    f(D { n: 8 });
    println("after closure");
    let e = E::A(D { n: 9 }, D { n: 10 });
    match e {
        E::A(_, y) => println("arm {}", y.n),
        E::B => {}
    }
    println("after match");
    let o = Some(D { n: 11 });
    match o {
        Some(_) => println("some"),
        None => {}
    }
    println("after match2");
    let (_, _) = (D { n: 12 }, D { n: 13 });
    println("after tuple");
    mixed(D { n: 14 }, 15, Big { a: 1, b: 2, c: 3, d: D { n: 16 } }, D { n: 17 }, 18);
    println("after mixed");
    let mut bytes: Vec<u8, Gpa> = Vec::new_in(gpa);
    bytes.push(0xff);
    println("eat_vec {}", eat_vec(bytes));
    println("generic {}", generic(D { n: 19 }, 20));
    println("with {}", D { n: 21 }.with(D { n: 22 }));
    println("end");
}
