// EDITION: rust
// sinking a part moved out of an index is own.move_out
// ERROR: error[borrowck.move_out]
// ERROR: line 8, column 88
fn f(a: Vec<i64, Gpa>, b: &mut Vec<Vec<i64, Gpa>, Gpa>) { b.push(a); }

fn main(gpa: Gpa) {
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa); v.push(Vec::new_in(gpa)); f(v[0], &mut v);
    println("{}", v.len());
}
