// XFAIL: RT-334: an `impl FnOnce` whose hidden closure writes its capture, called as a field `(h.f)()` with h not mut, is refused (E0596); rustc accepts: an FnOnce call consumes, it needs no mut (0.30.2)
// The plain-local form `g()` builds. Since v0.30.1 at least. From the
// review of the opaque-type work.
// EXPECT: 1
// EXPECT: 1
fn mk() -> impl FnOnce() -> i64 {
    let mut n = 0;
    move || {
        n += 1;
        n
    }
}

struct H<F> {
    f: F,
}

fn main() {
    let g = mk();
    println("{}", g());
    let h = H { f: mk() };
    println("{}", (h.f)());
}
