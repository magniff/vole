// RULE: D21.6 (0.30.2, RT-334) An `impl FnOnce` whose hidden closure writes
// its capture, called as a field `(h.f)()` with h not mut: accepted, as
// rustc (an FnOnce call consumes its callee and needs no mut; 0.30.2's
// first try refused it, E0596).
// The plain-local form `g()` builds. Since v0.30.1 at least. From the
// review of the opaque-type work.
// EXPECT: 1
// EXPECT: 1
fn mk() -> impl FnOnce() -> i64 {
    let mut n = 0;
    move || {
        n += 1;
        n
    }
}

struct H<F> {
    f: F,
}

fn main() {
    let g = mk();
    println("{}", g());
    let h = H { f: mk() };
    println("{}", (h.f)());
}
