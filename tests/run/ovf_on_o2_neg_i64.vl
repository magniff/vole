// EDITION: rust
// (0.26.3, decision 6) `-a` of i64s panics at -O2 with --overflow-checks=on,
// with Rust's message at the expression.
// FLAGS: -O2 --overflow-checks=on
// EXIT: 101
// EXPECT: before
// STDERR: ovf_on_o2_neg_i64.vl:17:13: attempt to negate with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i64 = id(-9223372036854775808) as i64;
    println("before");
    let r = -a;
    println("after {}", r);
}
