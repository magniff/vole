// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c02_match_arm)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// match arm binding named as the moved by-value parameter.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures match result { s => s > 0 }

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
