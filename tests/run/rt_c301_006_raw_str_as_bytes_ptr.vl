// XFAIL: RT-C301-6: `*const str as *const u8` is refused (0.30.2)
// A raw pointer to a str cast to one to its first byte: rustc accepts
// (a fat raw pointer casts to a thin one) and prints true. vole (0.30.0
// too) reports "cannot cast '*str' to '*const u8'".
// EXPECT: true
fn main() {
    let s = "abc";
    let p = s as *const str as *const u8;
    println("{}", !p.is_null());
}
