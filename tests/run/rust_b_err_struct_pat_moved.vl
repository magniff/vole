// EDITION: rust
// RULE: F27.2
// (0.27.2) A field a struct pattern moved out is gone: reading it after
// is a use of a moved value (rustc E0382).
// ERROR: error[borrowck.use_moved]
// ERROR-COUNT: 1
struct Tok {
    v: i64,
}

struct Two {
    a: Tok,
    n: i64,
}

fn main() {
    let s = Two { a: Tok { v: 1 }, n: 3 };
    let Two { a, n } = s;
    println("{} {} {}", a.v, n, s.a.v);
}
