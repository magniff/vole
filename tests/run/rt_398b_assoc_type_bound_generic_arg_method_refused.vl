// XFAIL: RT-398b: (RT-398's mechanism, the bound's argument built from the trait's) `q.a()` on `q: &Q::X` in `fn k<Q: A<u8>>`, with `trait A<T> { type X: A<Option<T>>; .. }` and the blanket `impl<T> A<T> for S { type X = S; }`, is refused in the instance, "no impl of 'S::a' takes arguments ()"; rustc prints 7 (0.30.2)
// From the second re-review of g302qual (its form c13c_assoc_bound_method_inst). Since v0.30.1 at
// least (v0.30.1 and the release build give the same error).
// EXPECT: 7
trait A<T> {
    type X: A<Option<T>>;
    fn a(&self) -> i64;
}

struct S {}

impl<T> A<T> for S {
    type X = S;

    fn a(&self) -> i64 {
        7
    }
}

fn k<Q: A<u8>>(q: &Q::X) -> i64 {
    q.a()
}

fn main() {
    println("{}", k::<S>(&S {}));
}
