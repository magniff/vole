// EDITION: rust
// an owned let captured by access, moved while the closure is still to be called
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 12, column 17
fn eat(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }

fn main(gpa: Gpa) {
    let mut v0: Vec<i64, Gpa> = Vec::new_in(gpa);
    v0.push(1);
    let v = v0;
    let c = || v.len();
    let k = eat(v);
    println("{k} {}", c());
}
