// EDITION: rust
// i + 1 < len with i == -1: s[i] is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 8
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], i: i64) -> i64 { let j = i + 1; if j < s.len() as i64 { s[i as usize] } else { 0 } }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s, -1 + unsafe { Z }));
    0
}
