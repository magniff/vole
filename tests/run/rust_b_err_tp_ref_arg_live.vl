struct S {
    x: i64,
    y: i64,
}

impl S {
    fn first(&self) -> &i64 {
        &self.x
    }

    fn add_ref(&mut self, k: &i64) {
        self.x += *k;
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add_ref(s.first());
    println("{}", s.x);
}
