// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash BuildHasher::Hasher.
// EXPECT: 8
use std::hash::{BuildHasher, Hash, Hasher};

struct Count {
    n: u64,
}

impl Hasher for Count {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        self.n += bytes.len() as u64;
    }
}

struct CountState {}

impl BuildHasher for CountState {
    type Hasher = Count;

    fn build_hasher(&self) -> Count {
        Count { n: 0 }
    }
}

// B::Hasher: the hasher type a BuildHasher makes
fn fresh<B: BuildHasher>(b: &B) -> B::Hasher {
    b.build_hasher()
}

fn main() {
    let mut h = fresh(&CountState {});
    h.write_u64(1);
    println("{}", h.finish());
}
