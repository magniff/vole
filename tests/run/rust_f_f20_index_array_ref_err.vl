// EDITION: rust
// RULE: F20.1
// (0.27.4) An element of an array behind a shared reference is not
// written: `h[0] = 1` of an `h: &[u32; 8]` is borrowck.assign_immutable
// (rustc E0594).
// ERROR: error[borrowck.assign_immutable]:
fn set(h: &[u32; 8]) {
    h[0] = 1;
}

fn main() {
    let h = [0u32; 8];
    set(&h);
}
