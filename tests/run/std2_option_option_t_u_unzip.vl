// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option<(T, U)>::unzip.
// EXPECT: (Some(1), Some("a")) (None, None)
use std::option::Option;

fn main() {
    let a: Option<(i64, &str)> = Some((1, "a"));
    let b: Option<(i64, &str)> = None;
    println("{:?} {:?}", a.unzip(), b.unzip());
}
