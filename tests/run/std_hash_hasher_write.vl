// Runs on std since 0.27.2's switch.
// The std item(s): std::hash Hasher::write.
// EXPECT: write [97, 98]
// EXPECT: 2
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

fn main() {
    let mut h = Show { n: 0 };
    h.write("ab".as_bytes());
    println("{}", h.finish());
}
