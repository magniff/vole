// EDITION: rust
// A Vec index of -1 is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 2
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    println("{}", v[(-1 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
