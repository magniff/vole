// RT-C301-11's callers: `where V<T>: Sup` and `where X<'a>: Sup` are met by an impl that needs `'a: 'static`, so a heap string borrowed into X is refused at the call (rustc: E0597 at both calls, E0505 at the drop; vole reports the drop once per loan).
// On 0.30.1 the bodies of go and go2 were refused instead (borrowck.outlives) and the callers never checked.
trait Sup {
    fn up(&self) -> &'static str;
}

struct X<'a> {
    r: &'a str,
}

struct V<T> {
    t: T,
}

impl<'a: 'static> Sup for X<'a> {
    fn up(&self) -> &'static str {
        self.r
    }
}

impl<T: Sup> Sup for V<T> {
    fn up(&self) -> &'static str {
        self.t.up()
    }
}

fn go<T>(v: &V<T>) -> &'static str where V<T>: Sup {
    v.up()
}

fn go2<'a>(x: &X<'a>) -> &'static str where X<'a>: Sup {
    x.up()
}

fn main(gpa: Gpa) {
    let mut st: String<Gpa> = String::new_in(gpa);
    st.push_str("heap");
    let x = X { r: st.as_str() };
    let s = go(&V { t: x });
    let x2 = X { r: st.as_str() };
    let s2 = go2(&x2);
    drop(st);
    println("{} {}", s, s2);
}
