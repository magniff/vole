// Runs on std since 0.27.2's switch.
// The std item(s): std::fmt Formatter::new.
// EXPECT: hi 3
use std::fmt::Formatter;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = f.write_str("hi");
    let w = f.width();
    let _ = w;
    println("{} {}", s, s.len() + 1);
}
