// XFAIL: RT-149: indexing, a compound assignment and drop glue call another trait's method of their name (a user trait's index, add_assign, drop), not Index's, AddAssign's or Drop's: a Drop impl never runs, std's Vec is not freed (0.30.2)
// FLAGS: --check-alloc
// rustc prints the EXPECT lines (twin: r302d_002b_sugar_takes_other_traits_method.rs.txt).
// vole prints '1', '[999, 2, 3]', 'closer 4', '1', 'closer vec' and at exit
// check-alloc reports Vec's block not freed: v[2] runs Pick::index, v += 5
// Pick::add_assign, D's drop glue the user trait Closer's drop (Drop::drop
// never runs) and Vec<i64, Gpa>'s drop glue Closer's drop for Vec (the
// buffer leaks). R302D-2's mechanism (a call built by name, the method rule
// choosing among every trait in scope); RT-74 is drop glue's inherent form.
// A Neg or Deref beside a same-named user trait method is refused instead
// (method.ambiguous, with the try: 'Pick::neg(&)'). Since v0.28.0.
// EXPECT: 3
// EXPECT: [1, 7, 3]
// EXPECT: Drop 4
// EXPECT: 1
use std::ops::{AddAssign, Index};

struct D {
    k: i64,
}

trait Closer {
    fn drop(&mut self);
}

impl Closer for D {
    fn drop(&mut self) {
        println("closer {}", self.k);
    }
}

impl Drop for D {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

impl Closer for Vec<i64, Gpa> {
    fn drop(&mut self) {
        println("closer vec");
    }
}

struct V {
    a: [i64; 3],
}

trait Pick {
    fn index(&self, i: usize) -> &i64;
    fn add_assign(&mut self, o: i64);
}

impl Pick for V {
    fn index(&self, i: usize) -> &i64 {
        &self.a[0]
    }

    fn add_assign(&mut self, o: i64) {
        self.a[0] = 999;
    }
}

impl Index<usize> for V {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a[i]
    }
}

impl AddAssign<i64> for V {
    fn add_assign(&mut self, o: i64) {
        self.a[1] += o;
    }
}

fn main(gpa: Gpa) {
    let mut v = V { a: [1, 2, 3] };
    println("{}", v[2]);
    v += 5;
    println("{:?}", v.a);
    {
        let d = D { k: 4 };
    }
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(1);
    println("{}", w.len());
}
