// 0.26.3: `#[deprecated]` on a function, a type, a field, a method and a
// trait, and through a `use`: each use is warning item.deprecated, with
// the note; the program builds and runs as before.
// WARNING: warning[item.deprecated]: use of deprecated trait 'Shape'
// WARNING: warning[item.deprecated]: use of deprecated function 'twice': use double
// WARNING: help: marked #[deprecated] at
// WARNING: warning[item.deprecated]: use of deprecated struct 'Old'
// WARNING: warning[item.deprecated]: use of deprecated field 'Pair.a': use b
// WARNING: warning[item.deprecated]: use of deprecated type alias 'Num'
// WARNING: warning[item.deprecated]: use of deprecated method 'Pair::sum'
// EXPECT: 4 3 7 1 6
mod lib {
    #[deprecated(note = "use double")]
    pub fn twice(x: i64) -> i64 {
        x * 2
    }

    #[derive(Clone, Copy)] #[deprecated]
    pub struct Old {
        pub v: i64,
    }

    #[derive(Clone, Copy)] pub struct Pair {
        #[deprecated(since = "0.26.3", note = "use b")]
        pub a: i64,
        pub b: i64,
    }

    impl Pair {
        #[deprecated]
        pub fn sum(self) -> i64 {
            self.a + self.b
        }
    }

    #[deprecated]
    pub trait Shape {
        fn area(&self) -> i64;
    }

    #[deprecated]
    pub type Num = i64;

    // A recursive deprecated function's own call is no use.
    #[deprecated]
    pub fn count(n: i64) -> i64 {
        if n == 0 { 0 } else { 1 + count(n - 1) }
    }
}

use lib::{Shape, twice};

#[derive(Clone, Copy)] struct Sq {
    s: i64,
}

impl Shape for Sq {
    fn area(&self) -> i64 {
        self.s * self.s
    }
}

fn main() {
    let o = lib::Old { v: 3 };
    let p = lib::Pair { a: 1, b: 6 };
    let n: lib::Num = p.sum();
    println("{} {} {} {} {}", twice(2), o.v, n, p.a, Sq { s: 2 }.area() + 2);
}
