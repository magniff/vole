// EDITION: rust
// Taking addresses, reading and writing through pointers, pointer to pointer,
// and passing pointers to functions.
// EXPECT: 43 1 4 4.5
// (0.26.4) The overflow checks off: it tests a u8 that wraps through a pointer (250 + 10).
// FLAGS: --overflow-checks=off
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn swap(a: &mut i64, b: &mut i64) {
    let t = *a;
    *a = *b;
    *b = t;
}

fn set_via(pp: *mut *mut i64, v: i64) {
    unsafe { **pp = v; }
}

fn main() -> i64 {
    let mut x: i64 = 1;
    let mut y: i64 = 2;
    swap(&mut x, &mut y);
    let mut p = &mut x as *mut i64;
    let pp = &mut p as *mut *mut i64;
    unsafe {
        set_via(pp, 42);
        **pp = **pp + 1;
    }
    let mut b: u8 = 250;
    let pb = &mut b;
    unsafe { *pb = *pb + 10; }
    let mut f: f32 = 1.5;
    let pf = &mut f;
    unsafe {
        *pf = *pf * 3.0;
        printf(c"%ld %ld %d %.1f\n", x, y, b, f);
    }
    0
}
