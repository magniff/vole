// RULE: F2.2
// `X::K` through supertraits 8 deep, the limit's edge. rustc prints 9.
// EXPECT: 9
trait T0 { const K: i64; }
trait T1: T0 {}
trait T2: T1 {}
trait T3: T2 {}
trait T4: T3 {}
trait T5: T4 {}
trait T6: T5 {}
trait T7: T6 {}
trait T8: T7 {}
struct S;
impl T0 for S { const K: i64 = 9; }
impl T1 for S {} impl T2 for S {} impl T3 for S {} impl T4 for S {}
impl T5 for S {} impl T6 for S {} impl T7 for S {} impl T8 for S {}
fn f<X: T8>() -> i64 { X::K }
fn main() { println("{}", f::<S>()); }
