// 0.26.2: gpu.usage at check time (diagnostic 3): a buffer of constant
// usage bound where a flag its usage lacks is needed, and written without
// COPY_DST; the try: the usage with the flag.
// ERROR: error[gpu.usage]: buffer 'params' (usage UNIFORM, created
// ERROR: err_gpu_usage.vl: line 27, column 24
// ERROR: --old 'BufferUsage::UNIFORM' --new 'BufferUsage::COPY_DST | BufferUsage::UNIFORM'
// ERROR: error[gpu.usage]: buffer 'cells' (usage COPY_DST, created
// ERROR: err_gpu_usage.vl: line 28, column 80
// ERROR: --old 'BufferUsage::COPY_DST' --new 'BufferUsage::STORAGE | BufferUsage::COPY_DST'
use std::gpu;
use std::gpu::BufferUsage;

embed wgsl K {
    @group(0) @binding(0) var<uniform> params: vec4<f32>;
    @group(0) @binding(1) var<storage, read_write> cells: array<u32>;

    @compute @workgroup_size(64)
    fn evolve(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] = cells[id.x] + u32(params.x);
    }
}

fn setup(dev: gpu::Device, queue: inout gpu::Queue) -> Result<gpu::BindGroup, gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    let params = dev.buffer(16, BufferUsage::UNIFORM);
    let cells = dev.buffer(256, BufferUsage::COPY_DST);
    queue.write_buffer(params, 0, "0123456789abcdef");
    Ok(dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, params), gpu::bind(1, cells)][..]))
}

fn main() -> i32 {
    0
}
