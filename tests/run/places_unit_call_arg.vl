// places IR (0.26.1): a call whose argument is a unit call's result, as
// `drop(handle.join())` in std's scope_join for a thread returning `()`.
// -O1 and -O2 lowered the argument's expression again from the AST
// (its value was not bound): the call ran twice, or the lowering crashed
// reading a local the AST lowering had not set up (thread::scope with a
// spawned `|| println(..)`).
// EXPECT: unit 3
// EXPECT: unit 4
// EXPECT: hi
// EXPECT: done
use std::thread;

fn unit(x: i64) {
    println("unit {x}");
}

fn take<R>(r: R) {}

fn main() {
    let a = 3;
    take(unit(a));
    drop(unit(a + 1));
    thread::scope(|s| {
        s.spawn(|| println("hi"));
    });
    println("done");
}
