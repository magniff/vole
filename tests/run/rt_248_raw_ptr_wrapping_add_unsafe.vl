// XFAIL: RT-248: `p.wrapping_add(1)` on a `*const i64` is not the pointer's method: the call derefs the raw pointer and takes i64's wrapping_add ("calling a method through a raw pointer is unsafe", then `*q` of an i64) (0.30.2)
// rustc accepts it outside unsafe: a raw pointer's wrapping_add computes an address and reads nothing (a method call never auto-derefs a raw pointer); only the read `*q` is unsafe.
// EXPECT: 20
fn main() {
    let a: [i64; 3] = [10, 20, 30];
    let p: *const i64 = &a[0] as *const i64;
    let q = p.wrapping_add(1);
    // UNSAFE: reading through a raw pointer
    // SAFETY: q points at a[1], inside the live array a, aligned and initialized
    let x = unsafe { *q };
    println("{}", x);
}
