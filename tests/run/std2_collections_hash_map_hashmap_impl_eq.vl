// The std2 item(s): std::collections::hash_map HashMap::impl Eq.
// EXPECT: true
use std::collections::HashMap;

fn same<T: Eq>(a: &T, b: &T) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    let mut a: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    a.insert(1, 1);
    let b = a.clone();
    println("{}", same(&a, &b));
}
