// 0.25.5: a static no code names is not written. std's statics come with
// their section of std (std::io's stdin buffer with println's section),
// its functions only with what the program calls; now the statics go
// with the functions: one named only in a function nothing calls, one
// nothing names, and std's stdin statics are left out, while one named in
// main, one read through a function and a C-visible (`extern "C"
// static`) one stay. The program reads and writes each that stays.
// EXPECT: 3 9 41 42
// ASM(aarch64-macos): _vole.static.USED:
// ASM-NOT(aarch64-macos): _vole.static.UNNAMED:
// ASM-NOT(aarch64-macos): _vole.static.ONLY_DEAD:
// ASM-NOT(aarch64-macos): STDIN_BUF
// ASM(aarch64-macos): _vole.static.READ_BY_FN:
// ASM-NOT(aarch64-macos): _vole.static.UNNAMED:
// ASM-NOT(aarch64-macos): _vole.static.ONLY_DEAD:
// ASM-NOT(aarch64-macos): STDIN_BUF
// ASM(aarch64-linux): vole.static.USED:
// ASM-NOT(aarch64-linux): vole.static.UNNAMED:
// ASM-NOT(aarch64-linux): vole.static.ONLY_DEAD:
// ASM(aarch64-linux): vole.static.READ_BY_FN:
// CROSS: aarch64-linux

static var USED: i64 = 3;
static var UNNAMED: [u8; 4] = [1, 2, 3, 4];
static var ONLY_DEAD: i64 = 5;
static READ_BY_FN: i64 = 9;
extern "C" static var vole_unnamed_exported: i64 = 41;

fn never_called() -> i64 {
    ONLY_DEAD += 1;
    ONLY_DEAD
}

#[inline(never)]
fn read() -> i64 {
    READ_BY_FN
}

fn main() {
    let exported = unsafe { vole_unnamed_exported };
    unsafe {
        vole_unnamed_exported += 1;
    }
    println("{USED} {} {exported} {}", read(), unsafe { vole_unnamed_exported });
}
