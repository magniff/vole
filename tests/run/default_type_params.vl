// EDITION: rust
// XFAIL: gap 17: compile type error: the trait 'G' is not implemented for 'A'
// 0.16: default type parameters of structs and enums. A type leaves out
// the trailing arguments that have defaults (`V<i64>` is `V<i64, Z>`, `B`
// is `B<Z>`), an expression infers them and falls back to the default
// (`V::new(5)`), and names and symbols leave out the arguments equal to
// their defaults (`V<i64>` in messages).
// EXPECT: 5 3 9 0 4 16
// EXPECT: V<i64> V<i64, One> B
trait Al { fn id(&self) -> i64; }
#[derive(Clone, Copy)] struct Z {}
#[derive(Clone, Copy)] struct One { k: i64 }
impl Al for Z { fn id(&self) -> i64 { 0 } }
impl Al for One { fn id(&self) -> i64 { self.k } }
trait G { fn g() -> Self; }
impl G for Z { fn g() -> Z { Z {} } }
fn make<A: G>() -> A { A::g() }

#[derive(Clone, Copy)] struct V<T, A: Al = Z> { x: T, a: A }

impl<T, A: Al> V<T, A> {
    fn new(x: T) -> V<T, A> { V { x: x, a: make::<A>() } }
    fn new_in(x: T, a: A) -> V<T, A> { V { x: x, a: a } }
    fn id(self) -> i64 { self.a.id() }
}

#[derive(Clone, Copy)] struct B<A: Al = Z> { v: V<u8, A> }
#[derive(Clone, Copy)] enum E<T, U = i64> { L(T), R(U) }

fn take(v: V<i64>) -> i64 { v.x }

trait Named { fn name(&self) -> &str; }
impl Named for V<i64> { fn name(&self) -> &'static str { "V<i64>" } }
impl Named for V<i64, One> { fn name(&self) -> &'static str { "V<i64, One>" } }
impl Named for B { fn name(&self) -> &'static str { "B" } }

fn main() {
    let v: V<i64> = V::new(5i64);
    let w = V::new_in(7i64, One { k: 3 });
    let u = V::<i64>::new(9i64);
    let b = B { v: V::new(1u8) };
    let c: B = b;
    let e: E<u8> = E::R(4i64);
    let x = match e {
        E::L(_) => 0,
        E::R(k) => k,
    };
    println("{} {} {} {} {x} {}", take(v), w.id(), take(u), c.v.id(), size_of(V<i64, One>));
    println("{} {} {}", v.name(), w.name(), c.name());
}
