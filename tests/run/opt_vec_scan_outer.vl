// EXPECT: colscan_f64_37 6425243161272166159 9323501049451347015
// EXPECT: colsum2_f64_37 6425243161272166159 387381911399483021
// EXPECT: colscan_f64_50 4798674021195392200 9959216857527260600
// EXPECT: colsum2_f64_50 4798674021195392200 17356940933929518328
fn hash_i8(a: &[i8]) -> u64 {
    let mut h: u64 = 0;
    for i in 0..a.len() {
        h = h.wrapping_mul(1000003).wrapping_add(a[i] as u64);
    }
    h
}

#[inline(never)]
fn colscan_i8_0(m: &[i8], a: &mut [i8], out: &mut [i8]) {
    let cols: i64 = 0;
    for j in 0..cols {
        let mut s: i8 = 0;
        for k in 0..12 {
            s = s.wrapping_add(m[(k * cols + j) as usize]);
            a[(k * cols + j) as usize] = s;
        }
        out[j as usize] = s;
    }
}

#[inline(never)]
fn colsum2_i8_0(m: &[i8], a: &mut [i8], out: &mut [i8]) {
    let cols: i64 = 0;
    for j in 0..cols {
        let mut s: i8 = 0;
        let mut t: i8 = 0;
        for k in 0..12 {
            s = s.wrapping_add(m[(k * cols + j) as usize]);
            t = t.wrapping_add(s);
            a[(k * cols + j) as usize] = s;
        }
        out[j as usize] = t;
    }
}

