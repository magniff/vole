// RULE: D19.2
// (0.27.2) A closure's unique capture of a `&mut` binding not declared `mut`
// needs no `let mut` (rustc's unique borrow, LocalMutationIsAllowed::Yes);
// the binding is usable again after the closure's last call.
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let s = &mut v;
    let mut c = || s.push(1);
    c();
    c();
    s.push(2);
    println("{}", s.len());
}
// EXPECT: 3
