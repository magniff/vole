// EDITION: rust
// RULE: D19.4
// (0.27.2) Inside the closure body the env is `&mut Env`: a shared borrow
// of a captured place while a `&mut` of it is live conflicts (rustc
// E0502).
// ERROR: error[borrowck.conflict]
fn main() {
    let mut v = [1, 2];
    let i = 1;
    let mut f = || {
        let r = &mut v[i];
        let s = &v[i];
        *r += *s;
    };
    f();
    println("{}", v[0]);
}
