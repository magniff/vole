// EDITION: rust
#[derive(Clone, Copy)] // (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: result of an indirect call views e, then e changes
// ERROR: error[borrowck.assign_borrowed]
struct E { name: [u8; 4], len: i64 }
fn nm(e: &E) -> &[u8] { &e.name[..e.len as usize] }

fn main() -> i32 {
    let mut e = E { name: [b'a', b'b', b'c', b'd'], len: 4 };
    let g: fn(&E) -> &[u8] = nm;
    let r = g(&e);
    e.name[0] = b'J';
    println("{}", str::from_utf8(r).unwrap());
    0
}
