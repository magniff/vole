// XFAIL: gap 20: xfail case fails differently: type.infer: cannot infer S of Map::sum (another failure)
// an adapter chain over owned items: map consumes each R; sum of ids; each R dropped once
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 0
// EXPECT: sum 3
// EXPECT: drop 1
// EXPECT: drop 0
// EXPECT: count 2
// MVS's XFAIL: OVERSTRICT map(|r: R| ..) over owned items: 'expected R, got let R', try: *R
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
#[derive(Clone, Copy)] struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(&mut self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn main() {
    let t = Gen { n: 3 }.map(|r: R| r.id).sum();
    println("sum {t}");
    let c = Gen { n: 2 }.count();
    println("count {c}");
}
