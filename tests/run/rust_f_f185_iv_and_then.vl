// RULE: F18.5
// (0.30.2) `Some(3000000000).and_then(half)`, `half: fn(i64)`: the
// Option's integer variable is unified with half's parameter (FL6: 0.30.1
// typed the literal i32 at the receiver, and the bound was not met).
// EXPECT: Some(1500000000)
fn half(x: i64) -> Option<i64> {
    Some(x / 2)
}

fn main() {
    println("{:?}", Some(3000000000).and_then(half));
}
