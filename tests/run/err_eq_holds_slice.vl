// ERROR: binary operation `==` cannot be applied to type `S`: `S` has no `PartialEq` (rustc E0369)
// (0.28.0: `==` is PartialEq's: a struct with no impl of it has none,
// whatever it holds; MVS compared the fields.)
#[repr(C)]
union U { a: i64, b: f64 }

#[derive(Clone, Copy)] struct S<'a> { name: &'a str, us: &'a [U] }

fn main() -> i64 {
    let v = [U { a: 1 }, U { a: 2 }];
    let a = S { name: "a", us: &v[0..2] };
    if a == a { 1 } else { 0 }
}
