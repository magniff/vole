// RULE: F18.5
// (0.30.2) `i32::from(a)` of an integer variable a later use makes
// i64: From<i64> for i32 does not hold, rustc's E0277, checked at the
// function's end with the type a took (never a cast that drops bits).
// ERROR: the trait 'From<i64>' is not implemented for 'i32' (rustc E0277)
fn main() {
    let a = 5000000000;
    let r = i32::from(a);
    let c: i64 = a;
    println("{} {}", r, c);
}
