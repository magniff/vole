// std::str::from_utf8's blocks of sixteen bytes (0.30) against a plain
// byte loop, the whole Utf8Error: every sequence of the edge list (the
// first and last of each length, overlong forms, surrogates, values past
// U+10FFFF, bytes no sequence has, stray continuation bytes, and each
// valid one cut short) at every place of texts of every length around
// the blocks' boundaries (0 to 40, 62 to 70, 129 to 135 bytes), in ASCII
// and in text of two-, three- and four-byte sequences; the same edges
// before a long run of ASCII that follows other text; then random text
// with damage at any place, at every offset.
// EXPECT: edge cases 1182924, ASCII after 37440, random 20000 (valid 12388): 0 differ

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

// v's valid prefix and the error's length (-1: none, v is UTF-8; 0: v
// ends inside a sequence), by the table of well-formed byte sequences
// (Unicode's table 3-7), a byte at a time.
fn plain(v: &[u8]) -> (usize, i64) {
    let n = v.len();
    let mut i = 0usize;
    while i < n {
        let b = v[i];
        let mut len = 1usize;
        let mut lo = 0x80u8;
        let mut hi = 0xBFu8;
        if b < 0x80 {
            len = 1;
        } else if b < 0xC2 {
            return (i, 1);
        } else if b < 0xE0 {
            len = 2;
        } else if b < 0xF0 {
            len = 3;
            if b == 0xE0 {
                lo = 0xA0;
            }
            if b == 0xED {
                hi = 0x9F;
            }
        } else if b < 0xF5 {
            len = 4;
            if b == 0xF0 {
                lo = 0x90;
            }
            if b == 0xF4 {
                hi = 0x8F;
            }
        } else {
            return (i, 1);
        }
        for k in 1..len {
            if i + k == n {
                return (i, 0);
            }
            let c = v[i + k];
            if k == 1 && (c < lo || c > hi) {
                return (i, 1);
            }
            if k > 1 && (c < 0x80 || c > 0xBF) {
                return (i, k as i64);
            }
        }
        i += len;
    }
    (n, -1)
}

fn std_result(v: &[u8]) -> (usize, i64) {
    match std::str::from_utf8(v) {
        Ok(s) => (s.len(), -1),
        Err(e) => (e.valid_up_to(), match e.error_len() {
            Some(k) => k as i64,
            None => 0,
        }),
    }
}

// The sequences put into the texts: each is LEN, then its bytes.
const EDGES: [u8; 175] = [
    1, 0x00, 1, 0x7F, 2, 0xC2, 0x80, 2, 0xDF, 0xBF, 3, 0xE0, 0xA0, 0x80, 3, 0xE0, 0xBF, 0xBF,
    3, 0xE1, 0x80, 0x80, 3, 0xEC, 0xBF, 0xBF, 3, 0xED, 0x80, 0x80, 3, 0xED, 0x9F, 0xBF,
    3, 0xEE, 0x80, 0x80, 3, 0xEF, 0xBF, 0xBF, 4, 0xF0, 0x90, 0x80, 0x80, 4, 0xF0, 0xBF, 0xBF, 0xBF,
    4, 0xF1, 0x80, 0x80, 0x80, 4, 0xF3, 0xBF, 0xBF, 0xBF, 4, 0xF4, 0x80, 0x80, 0x80,
    4, 0xF4, 0x8F, 0xBF, 0xBF,
    // not UTF-8: stray continuation bytes, overlong forms, surrogates,
    // past U+10FFFF, bytes no sequence has, a second byte that is none
    1, 0x80, 1, 0xBF, 2, 0x80, 0x80, 2, 0xC0, 0x80, 2, 0xC1, 0xBF, 3, 0xE0, 0x80, 0x80,
    3, 0xE0, 0x9F, 0xBF, 3, 0xED, 0xA0, 0x80, 3, 0xED, 0xBF, 0xBF, 4, 0xF0, 0x80, 0x80, 0x80,
    4, 0xF0, 0x8F, 0xBF, 0xBF, 4, 0xF4, 0x90, 0x80, 0x80, 4, 0xF4, 0xBF, 0xBF, 0xBF,
    4, 0xF5, 0x80, 0x80, 0x80, 4, 0xF7, 0xBF, 0xBF, 0xBF, 1, 0xF8, 1, 0xFE, 1, 0xFF,
    2, 0xC2, 0x41, 2, 0xDF, 0xC0, 3, 0xE1, 0x80, 0x41, 3, 0xE1, 0x41, 0x80, 3, 0xEF, 0xBF, 0xC2,
    4, 0xF1, 0x80, 0x80, 0x41, 4, 0xF1, 0x80, 0x41, 0x80, 4, 0xF1, 0x41, 0x80, 0x80,
    4, 0xF3, 0xBF, 0xBF, 0xE1,
];

// The text of `len` bytes of kind `kind` (0: ASCII; 1, 2, 3: sequences of
// two, three, four bytes, after `kind` bytes of ASCII so that they fall
// at every place of a block; ASCII where a whole one does not fit).
fn base(b: &mut Vec<u8, Gpa>, len: usize, kind: usize, shift: usize) {
    b.clear();
    let unit: [u8; 4] = if kind == 1 {
        [0xC3, 0xA9, 0, 0]
    } else if kind == 2 {
        [0xE4, 0xB8, 0x96, 0]
    } else {
        [0xF0, 0x9F, 0x98, 0x80]
    };
    let w = kind + 1;
    while b.len() < len {
        if kind == 0 || b.len() < shift || b.len() + w > len {
            b.push(b'a' + (b.len() % 26) as u8);
        } else {
            for k in 0..w {
                b.push(unit[k]);
            }
        }
    }
}

// Text of n pieces: ASCII runs, scalar values of every length, and now
// and then a damaged byte.
fn random(s: &mut u64, b: &mut Vec<u8, Gpa>, n: u64) {
    for _ in 0..n {
        let x = next(s);
        let k = x % 64;
        if k < 30 {
            for j in 0..1 + (x >> 8) % 20 {
                b.push((0x20 + (x >> (13 + j * 2)) % 95) as u8);
            }
        } else if k < 62 {
            let c = (x >> 8) % 4;
            let cp = if c == 0 {
                0x80 + (x >> 16) % 0x780
            } else if c == 1 {
                0x800 + (x >> 16) % 0xd000
            } else if c == 2 {
                0xe000 + (x >> 16) % 0x2000
            } else {
                0x10000 + (x >> 16) % 0x100000
            };
            let mut e = [0u8; 4];
            let t = char::from_u32(cp as u32).unwrap().encode_utf8(&mut e);
            b.extend_from_slice(t.as_bytes());
        } else {
            b.push((x >> 8) as u8);
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    let mut differ = 0;
    let mut cases = 0;
    for len in 0..136usize {
        if (len > 40 && len < 62) || (len > 70 && len < 129) {
            continue;
        }
        for kind in 0..4usize {
            let mut e = 0usize;
            while e < EDGES.len() {
                let w = EDGES[e] as usize;
                // (the sequence whole, and cut to each shorter length, at
                // every place it fits; the shift moves the text's own
                // sequences with it)
                for cut in 1..w + 1 {
                    let mut at = 0usize;
                    while at + cut <= len {
                        base(&mut b, len, kind, at % (kind + 1));
                        for k in 0..cut {
                            b[at + k] = EDGES[e + 1 + k];
                        }
                        cases += 1;
                        if std_result(b.as_slice()) != plain(b.as_slice()) {
                            differ += 1;
                            if differ < 5 {
                                println("differ: len {len} kind {kind} edge {e} cut {cut} at {at}");
                            }
                        }
                        at += 1;
                    }
                }
                e += 1 + w;
            }
        }
    }
    // ASCII after other text: a two-byte sequence early (the blocks start
    // there), then each edge at every place of the next block's boundary,
    // then 64 bytes of ASCII or more: the blocks' ASCII step after a block
    // that was not, which must see a sequence left open before it.
    let mut after = 0;
    for len in [170usize, 200] {
        for q in [0usize, 16, 32] {
            let mut e = 0usize;
            while e < EDGES.len() {
                let w = EDGES[e] as usize;
                for cut in 1..w + 1 {
                    for at in 56..104usize {
                        base(&mut b, len, 0, 0);
                        b[q] = 0xC3;
                        b[q + 1] = 0xA9;
                        for k in 0..cut {
                            b[at + k] = EDGES[e + 1 + k];
                        }
                        after += 1;
                        if std_result(b.as_slice()) != plain(b.as_slice()) {
                            differ += 1;
                            if differ < 5 {
                                println("differ: len {len} q {q} edge {e} cut {cut} at {at}");
                            }
                        }
                    }
                }
                e += 1 + w;
            }
        }
    }
    let mut s: u64 = 0x2545f4914f6cdd1d;
    let mut valid = 0;
    let rounds = 20000;
    for _ in 0..rounds {
        b.clear();
        let n = 1 + next(&mut s) % 40;
        random(&mut s, &mut b, n);
        let all = b.as_slice();
        let off = (next(&mut s) % 16) as usize;
        let v = if off < all.len() { &all[off..] } else { all };
        let want = plain(v);
        if want.1 < 0 {
            valid += 1;
        }
        if std_result(v) != want {
            differ += 1;
            if differ < 5 {
                println("differ: random text of {} bytes", v.len());
            }
        }
    }
    println(
        "edge cases {cases}, ASCII after {after}, random {rounds} (valid {valid}): {differ} differ");
    0
}
