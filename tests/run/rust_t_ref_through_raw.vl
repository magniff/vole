// EDITION: rust
// RULE: F30.1
// (0.28.0) `&mut (*p).f` and `&(*p).f` of a raw pointer p are references,
// as `&*p` is (they typed as raw pointers: `v[0]` and a `&mut i64`
// parameter refused them).
struct M {
    v: [i64; 2],
    n: i64,
}

fn takes(r: &mut i64) { *r += 1; }

fn f(m: *mut M) -> i64 {
    // UNSAFE: the case is about a reference made through a raw pointer
    // SAFETY: m points to main's live M, and nothing else uses it meanwhile
    let k = unsafe { &(*m).n };
    let before = *k;
    // UNSAFE: as above
    // SAFETY: as above; k is not used again
    let v = unsafe { &mut (*m).v };
    v[0] = 5;
    let first = v[0];
    // UNSAFE: as above
    // SAFETY: as above; v is not used again
    let n: &mut i64 = unsafe { &mut (*m).n };
    takes(n);
    first + *n + before
}

fn main() {
    let mut m = M { v: [1, 2], n: 3 };
    println("{}", f(&mut m as *mut M));
}
// EXPECT: 12
