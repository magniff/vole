// rustc prints the EXPECT lines (twin .rs.txt). The release build: the
// four errors at the two calls of g (three) and the call of o ("expected
// 'Option<(u8, u8)>', got 'Option<(u8, i32)>'"). An array `[i64; 2]` and a
// struct literal `P<T> { t, n: i64 }` in the same position are typed from
// the parameter, and so is the tuple when the fn is not generic or the
// call has a turbofish (`g2::<u8>((1u8, 3000000000))`).
// EXPECT: 1
// EXPECT: 3000000000
// EXPECT: 3
// EXPECT: 7
// EXPECT: 200
fn g<T>(p: (T, i64)) -> i64 {
    p.1
}

fn h<T>(p: [i64; 2], _t: T) -> i64 {
    p[0] + p[1]
}

struct P<T> {
    t: T,
    n: i64,
}

fn k<T>(p: P<T>) -> i64 {
    let _ = &p.t;
    p.n
}

fn o<T>(p: Option<(T, u8)>) -> u8 {
    p.unwrap().1
}

fn main() {
    println("{}", g((5u8, 1)));
    println("{}", g(("x", 3000000000)));
    println("{}", h([1, 2], 0u8));
    println("{}", k(P { t: 1u8, n: 7 }));
    println("{}", o(Some((1u8, 200))));
}
