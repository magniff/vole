// RULE: D7.4
// (0.30.1) `old(*p)` of a plain Copy struct nested 30 deep is the copy it
// is: whether a type holds a raw pointer is read through every field (a
// struct walked once). Before, past depth 16 the walk answered "holds a
// raw pointer", and the ensures was a false contract.old.
// RUSTC: none contract clauses are not Rust
// EXPECT: 1
#[derive(Clone, Copy)] struct P0 { x: i64 }
#[derive(Clone, Copy)] struct P1 { x: P0 }
#[derive(Clone, Copy)] struct P2 { x: P1 }
#[derive(Clone, Copy)] struct P3 { x: P2 }
#[derive(Clone, Copy)] struct P4 { x: P3 }
#[derive(Clone, Copy)] struct P5 { x: P4 }
#[derive(Clone, Copy)] struct P6 { x: P5 }
#[derive(Clone, Copy)] struct P7 { x: P6 }
#[derive(Clone, Copy)] struct P8 { x: P7 }
#[derive(Clone, Copy)] struct P9 { x: P8 }
#[derive(Clone, Copy)] struct P10 { x: P9 }
#[derive(Clone, Copy)] struct P11 { x: P10 }
#[derive(Clone, Copy)] struct P12 { x: P11 }
#[derive(Clone, Copy)] struct P13 { x: P12 }
#[derive(Clone, Copy)] struct P14 { x: P13 }
#[derive(Clone, Copy)] struct P15 { x: P14 }
#[derive(Clone, Copy)] struct P16 { x: P15 }
#[derive(Clone, Copy)] struct P17 { x: P16 }
#[derive(Clone, Copy)] struct P18 { x: P17 }
#[derive(Clone, Copy)] struct P19 { x: P18 }
#[derive(Clone, Copy)] struct P20 { x: P19 }
#[derive(Clone, Copy)] struct P21 { x: P20 }
#[derive(Clone, Copy)] struct P22 { x: P21 }
#[derive(Clone, Copy)] struct P23 { x: P22 }
#[derive(Clone, Copy)] struct P24 { x: P23 }
#[derive(Clone, Copy)] struct P25 { x: P24 }
#[derive(Clone, Copy)] struct P26 { x: P25 }
#[derive(Clone, Copy)] struct P27 { x: P26 }
#[derive(Clone, Copy)] struct P28 { x: P27 }
#[derive(Clone, Copy)] struct P29 { x: P28 }
#[derive(Clone, Copy)] struct P30 { x: P29 }

fn bump(p: &mut P30) ensures old(*p).x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x.x
    == 1
    {}

fn main() {
    let mut p = P30 {
        x: P29 {
            x: P28 {
                x: P27 {
                    x: P26 {
                        x: P25 {
                            x: P24 {
                                x: P23 {
                                    x: P22 {
                                        x: P21 {
                                            x: P20 {
                                                x: P19 {
                                                    x: P18 {
                                                        x: P17 {
                                                            x: P16 {
                                                                x: P15 {
                                                                    x: P14 {
                                                                        x: P13 {
                                                                            x: P12 {
                                                                                x: P11 {
                                                                                    x: P10 {
                                                                                        x: P9 {
                                                                                            x: P8 {
                                                                                                x: P7 { x: P6 { x: P5 { x: P4 { x: P3 { x: P2 { x: P1 { x: P0 { x: 1 } } } } } } } }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }; bump(&mut p); println("{}", 1);
}
