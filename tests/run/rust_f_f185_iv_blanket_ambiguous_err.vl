// RULE: F18.5
// (0.30.2, F9.2) A method of two traits for integer types, one by
// `impl A for i64`, the other by a blanket `impl<T> B for T`: the probe
// of `{integer}` finds both, rustc's E0034 (0.30.1 called B's).
// ERROR: multiple applicable items: 'm' is a method of more than one trait for '{integer}' (rustc E0034)
trait A { fn m(&self) -> i64; }
impl A for i64 { fn m(&self) -> i64 { 64 } }
trait B { fn m(&self) -> i64; }
impl<T> B for T { fn m(&self) -> i64 { 1 } }

fn main() {
    let a = 5;
    println("{}", a.m());
}
