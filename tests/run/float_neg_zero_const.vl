// 0.25.5: a constant's -0.0 keeps its sign. The constant evaluator
// negated a float as 0.0 - x, which is +0.0 for x = 0.0, so every
// constant initializer -0.0 (a static, a const, f32, an array's
// repeated element, a struct's fields) was +0.0 and 1.0 / it inf; a
// local's -0.0 (negated at run time) was right. The sign bit also keeps
// such a static out of bss (its bytes are not zero; there it would read
// as +0.0).
// EXPECT: -inf -inf -inf -inf -inf -inf -inf -inf -inf
struct P {
    x: f64,
    y: f32,
}

static var SV: f64 = -0.0;
static SL: f64 = -0.0;
const C: f64 = -0.0;
const CF: f32 = -0.0;
static var SF: f32 = -0.0;
static var SA: [f64; 3] = [-0.0; 3];
static var SP: P = P { x: -0.0, y: -0.0 };

fn main() {
    let c = C;
    let cf = CF as f64;
    let l = -0.0;
    println(
        f"{1.0 / SV} {1.0 / SL} {1.0 / c} {1.0 / cf} {1.0 / (SF as f64)} {1.0 / SA[2]} {1.0 / SP.x} {1.0 / (SP.y as f64)} {1.0 / l}",
    );
}
