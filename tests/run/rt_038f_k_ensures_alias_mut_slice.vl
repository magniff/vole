// RULE: C3.4
// (0.30.2, RT-38f) An alias of a `&mut [i64]`: no view after the body
// (only `&mut [T]` written so got `let p: &[T] = p;`), and `p[0] = 9`
// wrote the caller's array (0.30.1 printed 2 9).
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to 'p[_]'
// ERROR-COUNT: 1
type V<'a> = &'a mut [i64];

fn f(p: V<'_>) -> i64
    ensures {
    p[0] = 9;
    true
}

{
    p[0] += 1;
    p[0]
}

fn main() {
    let mut a = [1i64, 2];
    println("{}", f(&mut a));
    println("{}", a[0]);
}
