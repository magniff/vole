// XFAIL: RT-42: indexing a `&mut str` is not checked for char boundaries: `&mut m[..1]` of "éa" is an invalid str in safe code (open)
// The char-boundary check of a str's range index (RULE Z9.1b,
// front/check/synth_mode.vl synth_index) matches only `str_type`, a
// `&str`'s pointee; a `&mut str` is indexed with no check, so `&mut
// m[..1]` of "éa" (bytes C3 A9 61) is the str [C3]: its chars give
// 65533 and from_utf8 refuses its bytes. vole prints `false` and exits
// 0. rustc panics: "byte index 1 is not a char boundary; it is inside
// 'é' (bytes 0..2) of `éa`" (exit 101), as vole does for a `&str`'s
// `&s[..1]`. Related: `&m[0..1]` of a `&mut str` gets the type `&&mut
// str` (`no method 'as_bytes' on type '&&mut str'`), where rustc's is
// `&str`.
// STDERR: not a char boundary
// EXIT: 101
fn cut(m: &mut str) -> &mut str {
    &mut m[..1]
}

fn main(gpa: Gpa) {
    let mut x = String::from_in("éa", gpa);
    let c = cut(x.as_mut_str());
    let s: &str = c;
    println("{}", std::str::from_utf8(s.as_bytes()).is_ok());
}
