// EDITION: rust
// RULE: Z9.3
// Fat raw pointers keep both words: `&[u8] as *const [u8]`, `*mut [u8]
// as *mut str`, and `&*p` / `&mut *p` give the slice or the str back,
// its length kept.
// EXPECT: 3 3
// EXPECT: hi!
// XFAIL: std2's bodies meet the borrow checker's gaps (PhantomData, FlatMap: borrowck.unused_param)
fn as_str(b: &[u8]) -> &str {
    // UNSAFE: a str of bytes the caller passes.
    // SAFETY: the bytes are ASCII (the callers below).
    unsafe { &*(b as *const [u8] as *const str) }
}

fn main() {
    let bytes = [104u8, 105, 33];
    let p = &bytes[..] as *const [u8];
    // UNSAFE: p points to bytes, alive here.
    // SAFETY: p was made from a live slice two lines up.
    let back: &[u8] = unsafe { &*p };
    println("{} {}", back.len(), as_str(&bytes[..]).len());
    let mut buf = [104u8, 105, 63];
    let s: &mut str = unsafe {
        // UNSAFE: the bytes as a str, to write through.
        // SAFETY: ASCII bytes are UTF-8.
        &mut *(&mut buf[..] as *mut [u8] as *mut str)
    };
    println("{}", as_str(&buf[..]));
}
