// swapping two Drop values: each dropped once, at the end, in reverse declaration order
// EXPECT: swapped
// EXPECT: drop 1
// EXPECT: drop 2
use std::mem; struct D { id: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.id); } }

fn main() {
    let mut a = D { id: 1 }; let mut b = D { id: 2 }; mem::swap(&mut a, &mut b); println("swapped");
}
