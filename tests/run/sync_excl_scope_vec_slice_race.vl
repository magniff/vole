// two scoped threads write one Vec through inout slices (`&v`, coerced): a data race
// ERROR: sync
use std::thread;
fn bump(s: &mut [i64]) { for i in 0..1000000 { s[0] += 1; } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(0);
    thread::scope(|s| ({ let sc = s; {
        let x = sc.spawn(|| { bump(&mut v); 0 }); let y = sc.spawn(|| { bump(&mut v); 0 });
        x.join().unwrap() + y.join().unwrap()
    } })); println("{}", v[0]);
}
