// EDITION: rust
// RULE: Z9.1a
// A reference impl `impl<A: Same<B>, B> Same<&B> for &A` and a slice's
// own impl: `a.same(b)` with `a, b: &[i64]` (`[i64]` under Z9.1) takes the
// slice's own impl, which the reference impl forwards to in rustc.
// EXPECT: true false
trait Same<R: ?Sized> {
    fn same(&self, other: &R) -> bool;
}

impl<T, U> Same<[U]> for [T] {
    fn same(&self, other: &[U]) -> bool {
        self.len() == other.len()
    }
}

impl<A: Same<B>, B> Same<&B> for &A {
    fn same(&self, other: &&B) -> bool {
        Same::same(*self, *other)
    }
}

fn main() {
    let a: &[i64] = &[1, 2];
    let b: &[i64] = &[3, 4];
    let c: &[i64] = &[5];
    println("{} {}", a.same(b), a.same(c));
}
