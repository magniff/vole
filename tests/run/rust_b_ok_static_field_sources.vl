// RULE: D3.6 (0.30.2, RT-383) What a `&'static` field takes, as rustc: a
// static's borrow (in a struct, a union, a variant, a tuple struct, a
// slice of a static array), `Box::leak`, a string or byte string literal,
// a `&'static` parameter passed through (a constructor fn, a nested
// literal, a closure's 'static parameter), another value's 'static field,
// a const's string literals and static borrows; and a struct with a lifetime of its own holding a
// local's borrow beside its 'static field. rustc prints the EXPECT lines.
// EXPECT: 5 3 5 5 2 5
// EXPECT: 7 hello ab x b
// EXPECT: 9 9 9 9 9 4
// EXPECT: 12 1 2
struct V {
    a: &'static u64,
}

struct T(&'static u64);

enum E {
    A(&'static u64),
    B { s: &'static str },
}

union U {
    a: &'static u64,
    b: usize,
}

struct Vs {
    s: &'static str,
    l: &'static [u8],
    n: &'static [u64],
}

struct O {
    v: V,
    n: u64,
}

struct L<'x> {
    x: &'x u64,
    a: &'static u64,
}

static X: u64 = 5;
static K: u64 = 9;
static S: [u64; 3] = [1, 2, 3];

const C: Vs = Vs { s: "hello", l: b"ab", n: &S };
const CK: V = V { a: &X };

fn from_static() -> V {
    V { a: &X }
}

fn leaked(gpa: Gpa) -> V {
    let b = Box::new_in(7u64, gpa);
    V { a: Box::leak(b) }
}

fn wrap(a: &'static u64) -> O {
    O { v: V { a }, n: 1 }
}

fn pick(e: E) -> &'static str {
    match e {
        E::A(_) => "a",
        E::B { s } => s,
    }
}

fn sum_local() -> u64 {
    let e = 4u64;
    let l = L { x: &e, a: &K };
    let w = V { a: l.a };
    *l.x + *l.a - *w.a
}

fn main(gpa: Gpa) {
    let u = U { a: &X };
    // UNSAFE: a union's field is read only in an unsafe block
    // SAFETY: u was written through a, a reference to a static
    let r = unsafe { u.a };
    let vs = Vs { s: "x", l: b"", n: &S[1..] };
    let E::A(q) = E::A(&X) else { return; };
    println("{} {} {} {} {} {}", from_static().a, vs.n[1], r, q, C.n[1], CK.a);
    println("{} {} {} {} {}", leaked(gpa).a, C.s, str::from_utf8(C.l).unwrap(), vs.s,
        pick(E::B { s: "b" }));
    let o = wrap(&K);
    let o2 = O { v: V { a: o.v.a }, n: 2 };
    let f = || V { a: &K };
    let g = |p: &'static u64| T(p);
    println("{} {} {} {} {} {}", o.v.a, o2.v.a, f().a, g(&K).0, T(&K).0, sum_local());
    println("{} {} {}", *o.v.a + 3, o.n, o2.n);
}
