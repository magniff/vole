// The std item(s): std::result Result::and_then.
// EXPECT: Ok(6) Err("neg") Err("bad")
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let c: Result<i64, &str> = Ok(-1);
    let f = |x: i64| if x > 0 { Ok(x * 2) } else { Err("neg") };
    println("{:?} {:?} {:?}", a.and_then(f), c.and_then(f), b.and_then(f));
}
