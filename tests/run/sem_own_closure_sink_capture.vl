// sem-own: a sink closure captures by move: the capture is dropped with the
// closure (at the closure local's scope end), once, and not with the local.
// EXPECT: in 1
// EXPECT: in 1
// EXPECT: inner end
// EXPECT: drop 1
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    {
        let d = mk(1, gpa);
        let f = sink || d.id;
        println("in {}", f());
        println("in {}", f());
        println("inner end");
    }
    println("end");
}
