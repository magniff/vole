// EDITION: rust
// RULE: Z9.3
// A Vec of `&str` and of `&[T]` holds the views: inside Vec's body a
// `*const T` with T a view points to the view (thin), it is no fat raw
// pointer; only a pointee written `[T]` or `str` makes one.
// EXPECT: 2 cde 3 9
fn main(gpa: Gpa) {
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push("ab");
    v.push("cde");
    let a = [7i64, 8, 9];
    let mut w: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    w.push(&a[..]);
    let s = w[0];
    println("{} {} {} {}", v.len(), v[1], s.len(), s[2]);
}
