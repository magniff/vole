// EDITION: rust
// RULE: D2.7
// (0.28.0) A `&mut` reached through a `&` is not unique: writing through
// it, or borrowing it `&mut` again, is rustc's E0594 and E0596. Both
// were accepted: `&self` with a `v: &mut i64` field gave out `&mut i64`s.
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*self.v', which is behind a `&` reference
// ERROR: line 19, column 9
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*self.v' as mutable, which is behind a `&` reference
// ERROR: line 23, column 9
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*self.v' as mutable, which is behind a `&` reference
// ERROR: line 27, column 9
// ERROR-COUNT: 3
struct G<'a> {
    v: &'a mut i64,
}

impl<'a> G<'a> {
    fn write(&self) {
        *self.v += 1;
    }

    fn lend(&self) -> &mut i64 {
        &mut *self.v
    }

    fn give(&self) -> &mut i64 {
        self.v
    }
}

fn main() {
    let mut n = 1i64;
    let g = G { v: &mut n };
    g.write();
    *g.lend() += 1;
    *g.give() += 1;
    println("{}", n);
}
