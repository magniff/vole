// EDITION: rust
// RULE: D6.2.5
// (0.27.1) `&G` of an immutable static is `'static` and never killed.

static G: i64 = 7;

fn main() {
    let r: &'static i64 = &G;
    let s = &G;
    println("{} {}", *r, *s);
}
// EXPECT: 7 7
