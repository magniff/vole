// EDITION: rust
// RULE: F18.1, F14.1, F11.3
// An unsuffixed literal for a parameter bounded by a trait only usize
// implements is a usize (`s.get(1)`); `I::Output` is SliceIndex's though
// usize has Add's Output too.
// EXPECT: Some(20) None 7
trait Pick<X: ?Sized> {
    type Output;
    fn pick(&self, x: &X) -> i64;
}

impl<T> Pick<[T]> for usize {
    type Output = T;
    fn pick(&self, x: &[T]) -> i64 { (x.len() + *self) as i64 }
}

fn take<I: Pick<[i64]>>(s: &[i64], i: I) -> i64 { i.pick(s) }

fn main() {
    let s: &[i64] = &[10, 20, 30];
    println("{:?} {:?} {}", s.get(1), s.get(5), take(s, 4));
}
