// XFAIL: RT-389: (RT-389's mechanism, a projection of a projection) `fn coll<C: IntoIterator>(c: C, gpa: Gpa) -> Vec<<C::IntoIter as Iterator>::Item, Gpa>` is refused as borrowck.elision ("the result of 'coll' borrows, but from which parameter is not said"); rustc accepts it and prints the EXPECT line (0.30.2)
// From the review of g302bor2 (form B/b08). Since v0.30.1 at least; the
// release build the same. Sibling: rt_389 (`<C as IntoIterator>::Item`).
// EXPECT: [1000]
fn coll<C: IntoIterator>(c: C, gpa: Gpa) -> Vec<<C::IntoIter as Iterator>::Item, Gpa> {
    let mut out = Vec::new_in(gpa);
    for x in c {
        out.push(x);
    }
    out
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = coll(&v, gpa);
    println("{:?}", r);
}
