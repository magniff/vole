// (0.28.0) `&&`, `||` and `!` in a condition (if, while, a match guard)
// branch on each operand in turn, left to right, the right one only when
// the left does not decide; a `let`'s value is the same.
// EXPECT: a true
// EXPECT: b false
// EXPECT: else 1
// EXPECT: a false
// EXPECT: a false
// EXPECT: b true
// EXPECT: c false
// EXPECT: else 3
// EXPECT: a true
// EXPECT: b true
// EXPECT: c true
// EXPECT: then 4
// EXPECT: w1 true
// EXPECT: w2 true
// EXPECT: w1 true
// EXPECT: w2 false
// EXPECT: w3 true
// EXPECT: w1 true
// EXPECT: w2 true
// EXPECT: w1 false
// EXPECT: i 3
// EXPECT: x1 false
// EXPECT: x2 false
// EXPECT: x1 false
// EXPECT: x2 false
// EXPECT: x1 true
// EXPECT: j 2
// EXPECT: v1 true
// EXPECT: v2 false
// EXPECT: b false
// EXPECT: g1 true
// EXPECT: g2 true
// EXPECT: g1 false
// EXPECT: g3 true
// EXPECT: g1 false
// EXPECT: g3 false
// EXPECT: g4 true
// EXPECT: 1 3 3
// EXPECT: g1 true
// EXPECT: g2 false
// EXPECT: g3 false
// EXPECT: g4 false
// EXPECT: g1 true
// EXPECT: g2 true
// EXPECT: 2 1
fn t(name: &str, v: bool) -> bool {
    println("{} {}", name, v);
    v
}

fn pick(x: i64) -> i64 {
    match x {
        n if t("g1", n > 0) && t("g2", n < 10) => 1,
        n if !(t("g3", n < 0) || t("g4", n == 0)) => 2,
        _ => 3,
    }
}

fn main() {
    if t("a", true) && t("b", false) {
        println("then 1");
    } else {
        println("else 1");
    }
    if t("a", false) && t("b", true) {
        println("then 2");
    }
    if t("a", false) || t("b", true) && t("c", false) {
        println("then 3");
    } else {
        println("else 3");
    }
    if !(t("a", true) && t("b", true)) || t("c", true) {
        println("then 4");
    }
    let mut i = 0;
    while t("w1", i < 3) && (t("w2", i != 1) || t("w3", true)) {
        i += 1;
    }
    println("i {}", i);
    let mut j = 0;
    while !(t("x1", j >= 2) || t("x2", false)) {
        j += 1;
    }
    println("j {}", j);
    let b = t("v1", true) && t("v2", false);
    println("b {}", b);
    println("{} {} {}", pick(5), pick(-1), pick(0));
    println("{} {}", pick(20), pick(7));
}
