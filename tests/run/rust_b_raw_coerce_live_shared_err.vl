// RULE: D3.6
// (0.27.6) The raw reborrow of a `&mut` given where a `*mut` goes is a
// write of what it points to: a shared borrow of a part of it, used after
// the call, is still a conflict (rustc E0502).
// ERROR: error[borrowck.conflict]: cannot borrow '*cx' as mutable because it is also borrowed as immutable
// ERROR: line 20, column 19
struct C {
    cap: i64,
    n: i64,
}

fn touch(cx: *mut C) -> i64 {
    // UNSAFE: the test's raw pointer, as gate 3's block_array takes it
    // SAFETY: cx points to the live C main made; nothing else writes it here
    unsafe { (*cx).n }
}

fn go(cx: &mut C) -> i64 {
    let r = &cx.cap;
    let k = touch(cx);
    k + *r
}

fn main() {
    let mut c = C { cap: 1, n: 2 };
    println("{}", go(&mut c));
}
