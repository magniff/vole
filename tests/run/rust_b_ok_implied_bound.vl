// EDITION: rust
// RULE: D4.5
// (0.27.1) `&'a &'b i64` implies `'b: 'a`, so `*x` is returned as `&'a`.

fn f<'a, 'b>(x: &'a &'b i64) -> &'a i64 {
    *x
}

fn main() {
    let a: i64 = 3;
    let ra = &a;
    println("{}", *f(&ra));
}
// EXPECT: 3
