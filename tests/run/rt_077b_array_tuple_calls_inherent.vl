// XFAIL: RT-77: an array's and a tuple's clone, == and < call the element type's inherent clone, eq and partial_cmp, not its Clone, PartialEq and PartialOrd impls (0.30.2)
// Rust's `[S; N]` and `(S, i64)` implement Clone, PartialEq and PartialOrd
// through S's impls of those traits; S's inherent methods of the same names
// are never called. vole's helpers for arrays and tuples
// (front/derive/intrinsic.vl tuple_helper) build `.clone()`, `.eq()` and
// `.partial_cmp()` calls by name, where the inherent method wins: vole prints
// 501 502 / 503 / true true false / false for rustc's lines below.
// EXPECT: 1 2
// EXPECT: 3
// EXPECT: false false true
// EXPECT: true
use std::cmp::Ordering;

#[derive(Copy)]
struct S {
    k: i64,
}

impl S {
    fn clone(&self) -> S {
        S { k: self.k + 500 }
    }

    fn eq(&self, other: &S) -> bool {
        true
    }

    fn partial_cmp(&self, other: &S) -> Option<Ordering> {
        Some(Ordering::Greater)
    }
}

impl Clone for S {
    fn clone(&self) -> S {
        S { k: self.k }
    }
}

impl PartialEq for S {
    fn eq(&self, other: &S) -> bool {
        self.k == other.k
    }
}

impl PartialOrd for S {
    fn partial_cmp(&self, other: &S) -> Option<Ordering> {
        self.k.partial_cmp(&other.k)
    }
}

fn main() {
    let a = [S { k: 1 }, S { k: 2 }];
    let b = a.clone();
    println("{} {}", b[0].k, b[1].k);
    let t = (S { k: 3 }, 4);
    let u = t.clone();
    println("{}", u.0.k);
    let x = S { k: 1 };
    let y = S { k: 2 };
    println("{} {} {}", [x, x] == [x, y], (x, 1) == (y, 1), (x, 1) < (y, 1));
    println("{}", [x, x] < [y, y]);
}
