// sem-own: a `sink self` method returning one field: the other fields dropped in the method.
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
struct P<A: Allocator> { a: D<A>, b: D<A> }
impl P<Gpa> { fn first(self) -> D<Gpa> { self.a } }

fn main(gpa: Gpa) {
    let p = P { a: mk(1, gpa), b: mk(2, gpa) };
    let x = p.first();
    println("got {}", x.id);
}
