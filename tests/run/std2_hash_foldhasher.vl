// The std2 item(s): std::hash FoldHasher.
// EXPECT: 3070294289714545650
// RUSTC: none (FoldHasher is foldhash's (the foldhash crate's, 0.2, gives this value); Rust's std has no foldhash)
use std::hash::{BuildHasher, FixedState, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let mut h = FixedState::new().build_hasher();
    h.write_u8(1);
    h.write_u16(2);
    h.write_u32(3);
    h.write_u64(4);
    h.write_u8(5);
    h.write_u64(6);
    h.write("hello world, again".as_bytes());
    h.write_u32(7);
    println("{}", h.finish());
}
