// EXPECT: 64
// An impl's parameter P shadowing `struct P`, its method's bound naming it, called (the review's f34; v0.30.1 and M1: a false 'not implemented').
struct P;
trait Tr<U> { fn f(&self) -> i64; }
trait Q { fn q(&self) -> i64; }
struct W<'a> { r: &'a i64 }
struct Wrap<T, U> { t: T, u: U }
impl<'a: 'static> Tr<P> for W<'a> { fn f(&self) -> i64 { 1 } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> i64 { 64 } }
fn call<P1, Z: Tr<P1>>(z: &Z, _p: &P1) -> i64 { z.f() }
impl<P, T: Tr<P>> Q for Wrap<T, P> { fn q(&self) -> i64 { call(&self.t, &self.u) } }
fn go<X: Q>(x: &X) -> i64 { x.q() }
fn main() { let v: i64 = 5; let x = Wrap { t: W { r: &v }, u: 0i64 }; println("{}", go(&x)); }
