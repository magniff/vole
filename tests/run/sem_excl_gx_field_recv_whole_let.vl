// receiver a field inout, the whole struct let (owned)
// ERROR: own.conflict
struct I { n: i64 }
impl I { fn look(inout self, o: O<Gpa>) -> i64 { let b = o.i.n; self.n = 7; b * 100 + o.i.n } }
struct O<A: Allocator> { i: I, v: Vec<i64, A> }
fn main(gpa: Gpa) { var o = O { i: I { n: 1 }, v: Vec::new_in(gpa) }; println("{}", o.i.look(o)); }
