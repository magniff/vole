// EDITION: rust
// RULE: D2.3
// (0.27.1) A loan whose holder's scope ends: the place is written after the
// block.

fn main() {
    let mut x: i64 = 1;
    {
        let r = &mut x;
        *r += 1;
    }
    x += 1;
    println("{}", x);
}
// EXPECT: 3
