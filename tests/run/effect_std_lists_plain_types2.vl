// (0.30.1, E3.3c) As effect_std_lists_plain_types: more of std's generic
// functions at i64 and at a struct with derived traits (hash maps and
// sets keyed by it, heaps, Vec and slice methods, iterator adapters).
// EXPECT: 117
use std::collections::{BTreeMap, BTreeSet, BinaryHeap, HashMap, HashSet, MinHeap};
use std::hash::FixedState;

#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]
struct P {
    a: i64,
}

fn maps_p(gpa: Gpa) -> i64 {
    let mut m: HashMap<P, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(P { a: 1 }, 2);
    *m.entry(P { a: 2 }).or_insert(0) += 1;
    *m.entry(P { a: 3 }).or_default() += 1;
    let mut t: i64 = 0;
    if let Some(v) = m.get(&P { a: 1 }) { t += *v; }
    t += if m.contains_key(&P { a: 2 }) { 1 } else { 0 };
    m.reserve(4);
    let c = m.clone();
    t += c.len() as i64;
    m.remove(&P { a: 1 });
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(1);
    s.insert(2);
    t += if s.contains(&1) { 1 } else { 0 };
    s.remove(&1);
    let s2 = s.clone();
    t += s2.len() as i64;
    let mut b: BTreeSet<P, Gpa> = BTreeSet::new_in(gpa);
    let mut o: BTreeSet<P, Gpa> = BTreeSet::new_in(gpa);
    b.insert(P { a: 1 });
    o.insert(P { a: 1 });
    t += if b.is_subset(&o) { 1 } else { 0 };
    t += if b.is_superset(&o) { 1 } else { 0 };
    t += if b.is_disjoint(&o) { 1 } else { 0 };
    let bc = b.clone();
    t += bc.len() as i64;
    let mut bm: BTreeMap<P, i64, Gpa> = BTreeMap::new_in(gpa);
    bm.insert(P { a: 5 }, 1);
    let bmc = bm.clone();
    for (k, v) in bmc.iter() { t += k.a + *v; }
    bm.entry(P { a: 6 }).and_modify(|v| *v += 1).or_insert_with(|| 3);
    t
}

fn heaps(gpa: Gpa) -> i64 {
    let mut h: BinaryHeap<P, Gpa> = BinaryHeap::new_in(gpa);
    h.push(P { a: 3 });
    h.push(P { a: 1 });
    let mut t: i64 = 0;
    if let Some(x) = h.pop() { t += x.a; }
    let mut m: MinHeap<i64, Gpa> = MinHeap::new_in(gpa);
    m.push(3);
    m.push(1);
    if let Some(x) = m.peek() { t += *x; }
    if let Some(x) = m.pop() { t += x; }
    let v = m.into_sorted_vec();
    t += v.len() as i64;
    let mut mp: MinHeap<P, Gpa> = MinHeap::new_in(gpa);
    mp.push(P { a: 2 });
    if let Some(x) = mp.pop() { t += x.a; }
    t
}

fn vec_p(gpa: Gpa) -> i64 {
    let mut v: Vec<P, Gpa> = Vec::new_in(gpa);
    v.push(P { a: 3 });
    v.push(P { a: 1 });
    v.insert(0, P { a: 9 });
    v.remove(1);
    v.retain(|x| x.a > 0);
    v.sort_by(|a, b| a.cmp(b));
    v.sort_by_key(|x| x.a);
    v.sort_unstable();
    v.sort_unstable_by(|a, b| b.cmp(a));
    v.reverse();
    v.resize(4, P { a: 0 });
    v.dedup();
    let mut t: i64 = 0;
    if let Some(x) = v.iter().max() { t += x.a; }
    if let Some(i) = v.iter().position(|x| x.a == 1) { t += i as i64; }
    if let Some(x) = v.iter().find(|x| x.a > 1) { t += x.a; }
    t += if v.iter().any(|x| x.a == 3) { 1 } else { 0 };
    t += if v.iter().all(|x| x.a >= 0) { 1 } else { 0 };
    t += v.iter().fold(0, |acc, x| acc + x.a);
    for (i, x) in v.iter().enumerate() { t += i as i64 + x.a; }
    for (x, y) in v.iter().zip(v.iter()) { t += x.a + y.a; }
    for x in v.iter().chain(v.iter()) { t += x.a; }
    t += v.iter().skip(1).step_by(1).count() as i64;
    let c = v.clone();
    t += c.len() as i64;
    let s = v.as_mut_slice();
    s.swap(0, 1);
    s.rotate_left(1);
    s.rotate_right(1);
    s.fill(P { a: 1 });
    t += s.len() as i64;
    if let Ok(i) = v.binary_search(&P { a: 1 }) { t += i as i64; }
    let mut w: Vec<i64, Gpa> = Vec::from_elem_in(0, 3, gpa);
    w.extend(v.iter().map(|x| x.a));
    w.dedup_by_key(|x| *x);
    w.drain(0..1);
    w.split_off(1);
    t += w.len() as i64;
    t
}

fn main(gpa: Gpa) {
    println("{}", maps_p(gpa) + heaps(gpa) + vec_p(gpa));
}
