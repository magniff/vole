// (0.26.3, decision 6) `-a` of i16s panics at -O0, where the overflow checks
// are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_neg_i16.vl:16:13: attempt to negate with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i16 = id(-32768) as i16;
    println("before");
    let r = -a;
    println("after {}", r);
}
