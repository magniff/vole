// (0.25.2) A let parameter passed by reference (its type holds an array)
// to a method of a generic type: the parametric floor of `Cmd<CA>::arg`
// does not make its result view the argument, so `cmd = cmd.arg(a)` in a
// loop is no own.escape ('a' went out of scope), as with std::cli's Arg.
struct Arg { name: str, short: u8, alts: [str; 4] }

struct Cmd<CA: Allocator = Gpa> { args: Vec<Arg, CA>, alloc: CA }

impl<CA: Allocator> Cmd<CA> {
    fn new_in(a: CA) -> Cmd<CA> {
        Cmd { args: Vec::new_in(a), alloc: a }
    }

    fn arg(sink self, a: Arg) -> Cmd<CA> {
        self.args.push(a);
        self
    }
}

fn build(gpa: Gpa) -> Cmd {
    var cmd = Cmd::new_in(gpa);
    for i in 0..3 {
        let a = Arg { name: "x", short: i as u8, alts: [""; 4] };
        cmd = cmd.arg(a);
    }
    cmd
}

fn main(gpa: Gpa) -> i32 {
    let cmd = build(gpa);
    println("{} {} {}", cmd.args.len(), cmd.args[2].name, cmd.args[2].short);
    0
}
// EXPECT: 3 x 2
