// Runs on std since 0.27.2's switch.
// The std item(s): std::clone Clone::clone_from.
// EXPECT: 7 7
use std::clone::Clone;
use std::marker::Copy;

struct P {
    x: i64,
}

impl Clone for P {
    fn clone(&self) -> P {
        P { x: self.x }
    }
}

fn main() {
    let a = P { x: 7 };
    let mut b = P { x: 0 };
    b.clone_from(&a);
    println("{} {}", a.x, b.x);
}
