// XFAIL: RT-113: a char constant as a range pattern's end (`'\u{80}'..=char::MAX`, `LO..='z'`) is refused: distinct.mix, 'char' where 'u32' goes (0.30.2)
// A range pattern's char literal ends are taken as u32 values, and a path
// to a char constant at either end keeps its type char, so the two "do
// not mix". rustc accepts both. The try: `(char::MAX) as u32` is not a
// pattern (fix --suggested refuses it, a parser error). An integer
// constant end (`10..=u8::MAX`) works. Since 0.28.0 (0.27.0 has no
// non-ASCII char).
// EXPECT: 2 2 1 2 2
const LO: char = 'a';

fn class2(c: char) -> i64 {
    match c {
        '\0'..='\u{7F}' => 1,
        '\u{80}'..=char::MAX => 2,
    }
}

fn class3(c: char) -> i64 {
    match c {
        LO..='z' => 1,
        _ => 2,
    }
}

fn class4(n: u8) -> i64 {
    match n {
        0..=9 => 1,
        10..=u8::MAX => 2,
    }
}

fn main() {
    println("{} {} {} {} {}", class2('é'), class2('\u{10FFFF}'), class3('q'), class3('A'),
        class4(200));
}
