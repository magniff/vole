// XFAIL: RT-C301-15: impls of one trait for one type told apart only by their trait arguments: where the region checker meets the bound it requires the predicates of every impl that may be the one, so a short borrow is refused, borrowck.dropped_borrowed (0.30.2: selection by the full trait reference, docs/design/obligations.md M1)
// Review 5's m03: `Tr<i32>`'s impl needs `T: 'static`, `Tr<i64>`'s nothing;
// the bound is Tr<i64>, so a V of a short borrow meets it. rustc accepts it.
// EXPECT: 64
trait Tr<U> { fn f(&self) -> i64; }
struct V<T> { t: T }
impl<T: 'static> Tr<i32> for V<T> { fn f(&self) -> i64 { 32 } }
impl<T> Tr<i64> for V<T> { fn f(&self) -> i64 { 64 } }
fn go<T: Tr<i64>>(t: &T) -> i64 { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = V { t: st.as_str() }; println("{}", go(&x));
}
