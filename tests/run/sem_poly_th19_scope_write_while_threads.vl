// EDITION: rust
// the scope's closure writes a value a scoped thread reads
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 11, column 9
use std::thread;

fn main() {
    let mut n: i64 = 1;
    thread::scope(|s| ({ let s = s; {
        s.spawn(|| n * 2);
        n = 5;
        0
    } }));
    println("{n}");
}
