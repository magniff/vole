// EDITION: rust
// (0.26.4) std's integer methods (wrapping_*, checked_*, overflowing_*,
// saturating_*) in a program that names nothing else of std: it reads std
// for them, as for `n.abs()` (it had no such method).
// EXPECT: 15 -1 255 1
// UNSAFE: printf is C's (the program names no std on purpose).
// SAFETY: the format matches the four i64 arguments.
extern "C" {
    fn printf(f: *mut u8, ...) -> i32;
}

fn main() {
    let a: i64 = 5;
    let m: i64 = 9223372036854775807;
    let b: u8 = 250;
    let (_, o) = m.overflowing_add(1);
    // UNSAFE: a C call.
    // SAFETY: as above.
    unsafe {
        printf(c"%ld %ld %ld %ld\n", a.wrapping_mul(3), m.checked_add(1).unwrap_or(-1),
            b.saturating_add(10u8) as i64, o as i64);
    }
}
