// XFAIL: RT-415: `Add2::add2(a, b)` with a an integer variable and b: i64 (`fn add2(self, o: Self)`, impls for i32 and i64) is refused, "expected 'i32', got 'i64'"; rustc unifies Self with i64 and prints 4000000000 (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 4000000000
trait Add2 { fn add2(self, o: Self) -> Self; }
impl Add2 for i64 { fn add2(self, o: i64) -> i64 { self + o } }
impl Add2 for i32 { fn add2(self, o: i32) -> i32 { self + o } }

fn main() {
    let a = 2000000000;
    let b: i64 = 2000000000;
    let c = Add2::add2(a, b);
    println("{}", c);
}
