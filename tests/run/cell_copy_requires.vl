// EDITION: rust
// XFAIL: gap 17: compile edition.lenient: 'arr[1]' is a value where a reference goes
// (0.26.1) A function with a `requires` whose argument is not a simple
// read (`arr[1]`): the check binds it (`let ?a0 = arr[1]`) before the two
// calls. The write through the atomic reaches the caller's element.
// EXPECT: 7
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

#[inline(never)]
fn bump(a: &AtomicI64, x: i64)
    requires x > 0
{
    a.store(x, Ordering::SeqCst);
}

fn main() {
    let arr = [AtomicI64::new(1i64), AtomicI64::new(1i64)];
    bump(arr[1], 7);
    println("{}", arr[1].load(Ordering::SeqCst));
}
