// p[0..1] on a raw *T means a different thing when T is a Vec
// EXPECT: 1
fn one<T>(x: &mut T) -> i64 {
    let p = x as *mut T;
    let s = unsafe { std::slice::from_raw_parts_mut(p.add((0) as usize), (1 - (0)) as usize) };
    s.len() as i64
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v.push(2); v.push(3);
    println("{}", one(&mut v));
}
