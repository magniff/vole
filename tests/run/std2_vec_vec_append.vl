// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::append.
// EXPECT: [1, 2, 3, 4] []
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut a = Vec::from_in([1, 2], gpa);
    let mut b = Vec::from_in([3, 4], gpa);
    a.append(&mut b);
    println("{:?} {:?}", a, b);
}
