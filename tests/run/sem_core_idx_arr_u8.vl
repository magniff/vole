// EDITION: rust
// A u8 index that wrapped (250 + 10 == 4) is index 4.
// EXIT: 101
// STDERR: index out of bounds: index 4, length 3
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let i: u8 = 250 + unsafe { Z } as u8;
    println("{}", a[(i + 10) as usize]);
    println("not reached");
    0
}
