// From the review of the obligation engine's M1 (pre-existing: v0.30.1 too).
// EXPECT: 64
struct P;
trait Tr<U> { fn f(&self) -> i64; }
struct W { r: i64 }
impl Tr<i64> for W { fn f(&self) -> i64 { 64 } }
fn call<P1, Z: Tr<P1>>(z: &Z, _p: &P1) -> i64 { z.f() }
fn mid<P, T: Tr<P>>(t: &T, p: &P) -> i64 { call(t, p) }
fn main() { let x = W { r: 1 }; println("{}", mid(&x, &0i64)); }
