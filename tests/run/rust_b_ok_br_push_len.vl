// EDITION: rust
// RULE: D7.2
// (0.27.1) `v.push(v.len() as i64)`: two-phase on a std receiver.
// RUSTC: none std2's Vec takes an allocator (the twin's subset has none until 0.27.3)

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(v.len() as i64);
    println("{}", v[1]);
    0
}
// EXPECT: 1
