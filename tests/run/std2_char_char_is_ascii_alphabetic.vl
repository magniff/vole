// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char char::is_ascii_alphabetic.
// EXPECT: true true false false

fn main() {
    println("{} {} {} {}", 'a'.is_ascii_alphabetic(), 'Z'.is_ascii_alphabetic(),
        'é'.is_ascii_alphabetic(), '1'.is_ascii_alphabetic());
}
