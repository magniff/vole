// RT-38 (F6): a clause that reads a `&mut` parameter while `result`
// borrows from it is a real conflict (rustc E0502 on the wrapper written
// by hand: `let r = body(v); assert!(*r >= 0 && v.len() > 0); r`),
// reported where the clause reads v, not at the function's first column.
// ERROR: error[borrowck.conflict]: cannot borrow '*v' as immutable because it is also borrowed as mutable
// ERROR: line 9, column 30
// ERROR-COUNT: 1
fn g<'a>(v: &'a mut Vec<i64, Gpa>) -> &'a mut i64
    ensures * result >= 0 && v.len() > 0
{
    &mut v[0]
}

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([5i64, 6], gpa);
    println("{}", *g(&mut v));
}
