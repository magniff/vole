// RULE: E1.6
// (0.28.0) A panic is `panic diverge`, not io: its message goes out
// through its own buffer, as MVS's panic_str. A #[no_io] function that
// panics, indexes, unwraps or asserts is accepted; a #[no_panic] one
// that panics is not. A message with holes is written in place, and is
// the panic's too: Vec::push's capacity overflow is no io.
// ERROR: 'calm' is #[no_panic], but it may panic
// ERROR-COUNT: 1
#[no_io]
fn pick(v: &[i64], i: usize) -> i64 {
    assert(i < v.len(), "out of range");
    let x: Option<i64> = Some(v[i]);
    if x.unwrap() < 0 {
        panic("negative");
    }
    x.unwrap()
}

#[no_io]
fn holes(x: i64) -> i64 {
    if x < 0 {
        panic("negative: {}", x);
    }
    x
}

#[effects(alloc(Gpa), panic, diverge)]
fn grow(v: &mut Vec<i64, Gpa>) {
    v.push(1);
}

#[no_panic]
fn calm(x: i64) -> i64 {
    if x < 0 {
        panic("negative");
    }
    x
}

fn main(gpa: Gpa) -> i32 {
    let v = [1i64, 2, 3];
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&mut w);
    println("{}", pick(&v, 1) + calm(2) + holes(w[0]));
    0
}
