// EDITION: rust
// RULE: E1.6
// (0.28.0) A panic is `panic diverge`, not io: its message goes out
// through its own buffer, as MVS's panic_str. A #[no_io] function that
// panics, indexes, unwraps or asserts is accepted; a #[no_panic] one
// that panics is not.
// ERROR: 'calm' is #[no_panic], but it may panic
// ERROR-COUNT: 1
#[no_io]
fn pick(v: &[i64], i: usize) -> i64 {
    assert(i < v.len(), "out of range");
    let x: Option<i64> = Some(v[i]);
    if x.unwrap() < 0 {
        panic("negative");
    }
    x.unwrap()
}

#[no_panic]
fn calm(x: i64) -> i64 {
    if x < 0 {
        panic("negative");
    }
    x
}

fn main() -> i32 {
    let v = [1i64, 2, 3];
    println("{}", pick(&v, 1) + calm(2));
    0
}
