// RUSTC: none an effect declaration's error: the twin compares the borrow checker's verdicts
// RULE: E2.1
// (0.28.0) A `for` over an iterator that does not end by itself (`0..`)
// is a loop: `diverge` (and its `next` may overflow: `panic`). Indexing by a value that is no counted loop's
// variable may panic.
// ERROR: 'endless' is #[effects(panic)], but it may not terminate (diverge)
// ERROR: 'pick' is #[effects()], but it may panic
// ERROR-COUNT: 2
#[effects(panic)]
fn endless(limit: i64) -> i64 {
    let mut t: i64 = 0;
    for i in 0i64.. {
        if i > limit {
            break;
        }
        t += 1;
    }
    t
}

#[effects()]
fn pick(xs: &[i64], i: usize) -> i64 {
    xs[i]
}

fn main() {
    let v = [1i64, 2];
    println("{} {}", endless(3), pick(&v, 1));
}
