// RULE: D8.6
// (0.28.0) borrowck.move_out names the place as the program wrote it:
// the element of a Vec reached through its Index, a call's result (it
// printed the IR's temporaries, `_8[_10].1`).
// ERROR: error[borrowck.move_out]: cannot move out of 'w[0].1', which is reached through a reference or an index
// ERROR: line 21, column 13
// ERROR: error[borrowck.move_out]: cannot move out of 'first(&w).1', which is reached through a reference or an index
// ERROR: line 22, column 9
// ERROR-COUNT: 2
struct D {
    id: i64,
}

fn eat(d: D) { println("eat {}", d.id); }

fn first(w: &Vec<(i64, D), Gpa>) -> &(i64, D) { &w[0] }

fn main(gpa: Gpa) {
    let mut w: Vec<(i64, D), Gpa> = Vec::new_in(gpa);
    w.push((1, D { id: 1 }));
    let t = w[0].1;
    eat(first(&w).1);
    eat(t);
}
