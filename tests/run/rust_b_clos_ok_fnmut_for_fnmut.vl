// EDITION: rust
// RULE: D19.5, D19.6
// (0.27.2) An `FnMut` closure passed to an `FnMut` bound and called twice
// there.
// EXPECT: 2
fn twice<F: FnMut()>(mut f: F) {
    f();
    f();
}

fn main() {
    let mut n = 0;
    twice(|| n += 1);
    println("{}", n);
}
