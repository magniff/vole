// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::unwrap_err.
// EXPECT: bad
// EXIT: 101
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    println("{}", b.unwrap_err());
    println("{}", a.unwrap_err());
}
