// Runs on std since 0.27.2's switch.
// The std item(s): std::option Option<&mut T>::cloned.
// EXPECT: Some("ab")
use std::option::Option;

fn main(gpa: Gpa) {
    let mut s = "ab".to_string_in(gpa);
    let a: Option<&mut String<Gpa>> = Some(&mut s);
    let c: Option<String<Gpa>> = a.cloned();
    println("{:?}", c);
}
