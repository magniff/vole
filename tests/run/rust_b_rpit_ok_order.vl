// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.3
// (0.27.2.1) A caller checked before the function: the function's body is
// checked first, for the hidden type its call needs.
// EXPECT: 9
fn main() {
    let sq = square();
    println("{}", sq(3));
}

fn square() -> impl Fn(i32) -> i32 {
    |x| x * x
}
