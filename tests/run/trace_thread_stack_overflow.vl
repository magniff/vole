// 0.30.1: --trace on a spawned thread's stack overflow prints `stopped by
// signal N` and the frames, as on the main thread (RT-14's case): each
// thread gets its own alternate signal stack (std::thread's first frame
// calls the trace runtime's thread_begin), and SIGBUS, which a thread's
// guard page raises on macOS, is handled with SIGSEGV. Before, the thread
// died silently by SIGBUS (exit 138; the review of 0.30.1). (macOS's: on
// Linux a thread's overflow is a SIGSEGV, and the exit 139.)
// FLAGS: --trace
// REQUIRES: macos
// STDERR: stopped by signal
// STDERR: trace_thread_stack_overflow.vl:
// EXIT: 138
use std::thread;

#[inline(never)]
fn down(n: i64, gpa: Gpa) -> i64 {
    let a = [n; 64];
    if n == 0 {
        return a[3];
    }
    down(n - 1, gpa) + a[(n % 64) as usize]
}

fn main(gpa: Gpa) {
    let n = 100000000 + std::env::args().count() as i64;
    let h = thread::spawn_in(move || down(n, gpa), gpa);
    println("{}", h.join().unwrap());
}
