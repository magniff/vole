// EDITION: rust
// RULE: D4.5
// (0.27.1) With `'b: 'a` declared, `y` is returned as `&'a`.

fn pick<'a, 'b: 'a>(x: &'a i64, y: &'b i64) -> &'a i64 {
    if *x > *y {
        x
    } else {
        y
    }
}

fn main() {
    let a: i64 = 1;
    let b: i64 = 2;
    println("{}", *pick(&a, &b));
}
// EXPECT: 2
