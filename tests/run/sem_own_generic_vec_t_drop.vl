// EDITION: rust
// sem-own: a Vec<T> built in a generic fn, returned: elements dropped once by the caller.
// EXPECT: n 2
// EXPECT: drop 1
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn two<T>(a: T, b: T, gpa: Gpa) -> Vec<T, Gpa> {
    let mut v: Vec<T, Gpa> = Vec::new_in(gpa); v.push(a); v.push(b); v
}

fn main(gpa: Gpa) {
    let v = two(mk(1, gpa), mk(2, gpa), gpa);
    println("n {}", v.len());
}
