// Runs on std since 0.27.2's switch.
// The std item(s): std::char char::is_ascii_punctuation.
// EXPECT: true true true true false false

fn main() {
    println("{} {} {} {} {} {}", '!'.is_ascii_punctuation(), '@'.is_ascii_punctuation(),
        '`'.is_ascii_punctuation(), '~'.is_ascii_punctuation(), 'a'.is_ascii_punctuation(),
        ' '.is_ascii_punctuation());
}
