// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Pattern::next_match_back.
// EXPECT: Some((4, 5)) Some((1, 2)) None Some((2, 4))
// RUSTC: none (Rust's Pattern is unstable)
use std::str::Pattern;

fn main() {
    let mut c = ',';
    let mut s = "ab";
    println("{:?} {:?} {:?} {:?}", c.next_match_back("a,b,,", 5), c.next_match_back("a,b", 3),
        c.next_match_back("abc", 3), s.next_match_back("ababx", 5));
}
