// XFAIL: gap 17: compile format.args: a format string is a literal: this argument has no hole to go to
// A str slice past its end.
// EXIT: 101
// STDERR: slice range out of bounds: 1..5, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let s = "abc";
    println("{}", s[1..(5 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
