// EDITION: rust
// XFAIL: gap 17: compile closure.kind: this closure moves 'd' out of its environment, so it is `FnOnce`, not `FnMut` as its...
// sem-own: a sink closure inside a sink closure: the capture moves twice, dropped once.
// EXPECT: drop 5
// EXPECT: 5
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn call<F: FnMut() -> i64>(f: F) -> i64 { f() }

fn main(gpa: Gpa) {
    let d = mk(5, gpa);
    let outer = move || { let inner = move || d.id; call(inner) };
    println("{}", call(outer));
    println("end");
}
