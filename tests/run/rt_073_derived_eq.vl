// XFAIL: RT-73: a derived PartialEq compares a field with the field type's inherent eq, not its PartialEq (0.30.2)
// rustc prints the EXPECT line; vole prints true for false.
// EXPECT: Out<2> Out { i: In { k: 1 }, n: 2 } false 1
use std::fmt;

#[derive(Debug, Clone, PartialEq)]
struct In {
    k: i64,
}

impl In {
    fn eq(&self, o: &In) -> bool {
        true
    }

    fn clone(&self) -> In {
        In { k: 555 }
    }
}

#[derive(Debug, Clone, PartialEq)]
struct Out {
    i: In,
    n: i64,
}

impl fmt::Display for Out {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        write(f, "Out<{}>", self.n)
    }
}

fn body() {
    let a = Out { i: In { k: 1 }, n: 2 };
    let b = Out { i: In { k: 9 }, n: 2 };
    let c = a.clone();
    println("{} {:?} {} {}", a, a, a == b, c.i.k);
}

fn main() -> i32 {
    body();
    0
}
