// a bound I: Iterator<Item = i64> given an iterator of R: rejected naming the bound
// ERROR: [type error]: 'Gen::Item' is 'R', but the bound 'I: Iterator<Item = i64>'
#[derive(Clone, Copy)] struct R { id: i64 }
#[derive(Clone, Copy)] struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;
    fn next(&mut self) -> Option<R> { None }
}

fn total<I: Iterator<Item = i64>>(it: I) -> i64 { it.sum() }
fn main() { println("{}", total(Gen { n: 3 })); }
