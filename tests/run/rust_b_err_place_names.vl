// RULE: D2.7
// (0.27.2) borrowck's messages name a place as rustc does: `s.n` through
// a reference, `*s` for a receiver's autoref, `v[_]` for an index, and a
// closure's capture as the captured variable (`b.n`, `a.v`).
struct T {
    k: i64,
}

struct S {
    n: i64,
    v: T,
}

impl S {
    fn bump(&mut self) {
        self.n += 1;
    }
}

fn take<F: Fn()>(f: F) {
    f();
}

fn f(s: &S, v: &[i64], i: usize) {
    s.n = 2;
    s.bump();
    v[i] = 1;
}

fn g() {
    let a = S { n: 1, v: T { k: 2 } };
    take(|| {
        let x = a.v;
    });
    let mut b = S { n: 1, v: T { k: 2 } };
    let mut c = || {
        let r = &mut b.n;
        let q = &b.n;
        *r = 1;
    };
    c();
}

fn main() {}
// ERROR: error[borrowck.assign_immutable]: cannot assign to 's.n', which is behind a `&` reference
// ERROR: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: cannot assign to 'v[_]', which is behind a `&` reference
// ERROR: cannot move out of 'a.v', a captured variable in an `Fn` closure
// ERROR: cannot borrow 'b.n' as immutable because it is also borrowed as mutable
// ERROR-COUNT: 5
