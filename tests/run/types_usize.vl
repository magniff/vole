// usize and isize (0.26.2): types of their own, 64 bits, printed as
// themselves. u8 to u32 widen to usize, i8 to i32 and u8 to u32 to isize;
// u64 and usize, i64 and isize, convert by `as` or TryFrom (std, in the
// prelude: TryFromIntError when the value does not fit).
// EXPECT: 5 7 12 -3 7 2 18446744073709551615 -9223372036854775808 9223372036854775807
// EXPECT: 5 5 -3 18446744073709551613 255 3 true 60
// EXPECT: 5 27 7 42 3 c
// EXPECT: true 5 7 true true 200
// EXPECT: out of range integral type conversion attempted
fn take_u64(x: u64) -> u64 {
    x
}

fn sum(v: [usize]) -> usize {
    var t: usize = 0;
    for x in v {
        t += x;
    }
    t
}

fn main(gpa: Gpa) {
    let a: usize = 5;
    let b: u32 = 7;
    let c: usize = b;
    let d: isize = -3;
    let e: isize = b;
    let s = [1u8, 2, 3];
    let i: usize = 1;
    println("{a} {c} {} {d} {e} {} {} {} {}", a + c, s[i], usize::MAX, isize::MIN, isize::MAX);
    let h: u64 = 255;
    var v: Vec<usize> = Vec::new_in(gpa);
    for k in 0..3usize {
        v.push(k * 20);
    }
    println(
        "{} {} {} {} {} {} {} {}", take_u64(a as u64), a as i64, d as i64, d as usize, h as usize,
        7usize / 2, a < c, sum(v.as_slice()));
    let p: usize = "42".parse::<usize>().unwrap();
    println("{} {} {} {p} {} {:x}", d.abs() + 2, 3usize.pow(3), a.max(7), (3.9 as usize), 12usize);
    let r = usize::try_from(-3i64);
    let big: usize = 300;
    println(
        "{} {} {} {} {} {}", r.is_err(), usize::try_from(5u64).unwrap(),
        isize::try_from(7usize).unwrap(), u8::try_from(big).is_err(),
        i64::try_from(usize::MAX).is_err(), u8::try_from(200usize).unwrap());
    match u8::try_from(256usize) {
        Ok(x) => println("{x}"),
        Err(err) => println("{err}"),
    }
}
