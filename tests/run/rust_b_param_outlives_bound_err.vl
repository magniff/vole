// RULE: D4.5, F10.2
// (0.30.1) `T: 'static` is required wherever it is declared: a trait
// method's own type parameter called through a bound (`x.f(t)`,
// `X::f(x, t)`), a trait method's `where Self: 'static`, an `impl Tr +
// 'static` result, and in a function with a `where` clause (its generic
// check is not turned off by one). rustc E0310 at each.
// ERROR: error[borrowck.param_outlives]: the parameter type 'T' may not live long enough: 'X::f' requires 'T: 'static'
// ERROR: line 24, column 32
// ERROR: line 25, column 33
// ERROR: error[borrowck.param_outlives]: the parameter type 'T' may not live long enough: 'g' requires 'Self: 'static'
// ERROR: line 26, column 23
// ERROR: error[borrowck.param_outlives]: the parameter type 'T' may not live long enough: 'mk' requires
// ERROR: line 27, column 26
// ERROR: error[borrowck.param_outlives]: the parameter type 'U' may not live long enough: 'need' requires 'T: 'static'
// ERROR: line 28, column 58
// ERROR-COUNT: 5
trait Tr {
    fn f<T: 'static>(&self, x: T);
    fn g(self) where Self: 'static;
}

fn need<T: 'static>(t: T) {}

fn go<X: Tr, T>(x: &X, t: T) { x.f(t) }
fn go2<X: Tr, T>(x: &X, t: T) { X::f(x, t) }
fn go3<T: Tr>(t: T) { t.g() }
fn mk<T: Clone>(t: T) -> impl Clone + 'static { t }
fn go4<I: Iterator, U>(i: I, u: U) where I::Item: Copy { need(u) }

fn main() {}
