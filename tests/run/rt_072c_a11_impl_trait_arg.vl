// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a11 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 3 3
// EXPECT: 1 1
trait TA { fn m(&self) -> i64; }
struct S { k: i64 }
impl S { fn m(&self) -> i64 { 3 } }
impl TA for S { fn m(&self) -> i64 { 1 } }
fn g(x: &impl TA) -> i64 { x.m() }
fn mk() -> impl TA { S { k: 0 } }
fn main() { let s = S { k: 0 }; println("{} {}", g(&s), mk().m()); }
