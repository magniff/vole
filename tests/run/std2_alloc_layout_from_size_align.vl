// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Layout::from_size_align.
// EXPECT: true true true 10
use std::alloc::Layout;

fn main() {
    let bad_align = Layout::from_size_align(10, 3).is_err();
    let zero = Layout::from_size_align(10, 0).is_err();
    let huge = Layout::from_size_align(usize::MAX, 8).is_err();
    let ok = Layout::from_size_align(10, 2).unwrap();
    println("{} {} {} {}", bad_align, zero, huge, ok.size());
}
