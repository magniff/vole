// sem-own: `impl From<D> for W` takes its argument let (std's
// `trait From<T> { fn from(x: T) -> Self; }`), so an owned value cannot be
// stored: `W::from(mk(1))` is "this value has no place", and with a named
// argument storing x is own.move_out. Converting an owned value with From
// is impossible: an impl writing `fn from(x: sink D)` is refused as not
// the trait's signature.
// XFAIL: OVERSTRICT From<T>::from takes x let: no From impl can keep an owned argument
// EXPECT: 1
// EXPECT: drop 1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

struct W<A: Allocator> { d: D<A> }
impl From<D<Gpa>> for W<Gpa> { fn from(x: D<Gpa>) -> W<Gpa> { W { d: x } } }

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    let w = W::from(d);
    println("{}", w.d.id);
}
