// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Read.
// EXPECT: 3 [1, 2, 3]
use std::io::{ErrorKind, Read};

fn fill<R: Read>(r: &mut R, buf: &mut [u8]) -> usize {
    r.read(buf).unwrap()
}

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut buf = [0u8; 5];
    let n = fill(&mut r, &mut buf);
    println("{} {:?}", n, &buf[..n]);
}
