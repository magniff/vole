// RULE: F13.1
// Two impls of one generic trait for one type, `Conv<i64>` and
// `Conv<bool>` for S: the impl key is the whole header, and the argument's
// type chooses.
// EXPECT: 12
// EXPECT: 1
trait Conv<X> {
    fn conv(&self, x: X) -> i64;
}

struct S {
    n: i64,
}

impl Conv<i64> for S {
    fn conv(&self, x: i64) -> i64 {
        self.n + x
    }
}

impl Conv<bool> for S {
    fn conv(&self, x: bool) -> i64 {
        if x { 1 } else { 0 }
    }
}

fn main() {
    let s = S { n: 7 };
    println("{}", s.conv(5));
    println("{}", s.conv(true));
}
