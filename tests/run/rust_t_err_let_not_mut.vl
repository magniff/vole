// RUSTC: none a type error here (rustc's E0596 is its borrow checker's): the twin compares the borrow checker's verdicts
// RULE: D8.1
// (0.28.0) A `let` binding changed through a method or a `&mut` is
// rustc's E0596 in its words, with `let mut`: not MVS's own.readonly and
// `var`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'n' as mutable, as it is not declared as mutable (rustc E0596)
// ERROR: line 18, column 10
// ERROR: help: declare it `let mut`
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'w' as mutable, as it is not declared as mutable (rustc E0596)
// ERROR: line 20, column 5
// ERROR-COUNT: 2
fn bump(n: &mut i64) {
    *n += 1;
}

fn main(gpa: Gpa) {
    let n = 1i64;
    bump(&mut n);
    let w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(1);
    println("{} {}", n, w.len());
}
