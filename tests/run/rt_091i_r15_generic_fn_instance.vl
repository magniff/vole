// (0.30.2, the re-review of g302holes: r91/r15_generic_fn_instance)
// ERROR: 'into' needs the type it converts to: 'i64' into what?
// Closures returning closures inside a generic fn, instantiated twice.
fn run<T: Copy + Into<i64>>(a: &[T]) -> i64 {
    a.iter().flat_map(|y| a.iter().map(move |x| (*x).into() * (*y).into())).sum()
}

fn main() {
    let a = [1i64, 2];
    let b = [3i32, 4];
    println("{}", run(&a));
    println("{}", run(&b));
}
