use std::alloc::Allocator; enum O<A: Allocator> { Str(Vec<u8, A>), Int(i64) }

fn f4(o: &O<Gpa>) -> &[u8] { match o { O::Str(s) => s.as_slice(), O::Int(_) => b"" } }

fn mk(gpa: Gpa) -> Vec<u8, Gpa> { let mut v: Vec<u8, Gpa> = Vec::new_in(gpa); v.push(1u8); v }
fn g1(gpa: Gpa) -> &'static [u8] { let mut v = mk(gpa); let r = &mut v; r.as_slice() }

fn g2(gpa: Gpa) -> i64 {
    let mut w: &[u8] = b"";
    {
        let mut x = mk(gpa);
        let r = &mut x;
        w = r.as_slice();
    }
    w.len() as i64
}

fn g3(r: &mut Vec<u8, Gpa>) -> i64 {
    let v = r.as_slice();
    r.push(1u8);
    v.len() as i64
}

fn g4(gpa: Gpa) -> i64 {
    let mut x = mk(gpa);
    let mut w: &[u8] = b"";
