// XFAIL: RT-194: a constant whose value calls a const fn is never evaluated at compile time: an overflow or a division by zero in the call (rustc E0080) is accepted, panics at run time at -O0, and wraps silently at -O2 (`f(8)` of u8 prints 0) (0.30.2)
// rustc refuses A, B and Z (E0080: `attempt to compute 128_u8 * 2_u8, which
// would overflow`, `u8::MAX + 1_u8`, `attempt to divide 10_i64 by zero`; twin:
// r302d_024_const_fn_call_never_evaluated.rs.txt). vole: `volec check` says
// `ok: 0 errors`; -O0 builds and panics when main reads A (`attempt to multiply
// with overflow` at line 18); -O2 prints `0 0`. Z is never used and never
// reported. F34.2 makes such a constant "made at each use", so its errors
// move to run time; RT-TL-17 is the -O2 form of a literal constant expression
// (`255 + 1`), RT-119 a non-const fn in a constant. Since v0.28.0.
// ERROR: line 32
// ERROR: line 33
// ERROR: line 34
// ERROR-COUNT: 3
const fn f(n: u8) -> u8 {
    let mut x = 1u8;
    let mut i = 0;
    while i < n {
        x = x * 2;
        i += 1;
    }
    x
}

const fn g() -> u8 {
    255 + 1
}

const fn d(n: i64) -> i64 {
    10 / n
}

const A: u8 = f(8);
const B: u8 = g();
const Z: i64 = d(0);

fn main() {
    println("{} {}", A, B);
}
