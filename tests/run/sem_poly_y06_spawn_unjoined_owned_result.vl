// EDITION: rust
// XFAIL: gap 17: compile effect: 'std::mem::drop' is #[effects(T)], but it allocates from C (malloc): 'x: T' at <std>: line...
// a detached thread's owned result: dropped once (or the process ends); no double free
// FLAGS: --check-alloc
// EXPECT: 1
use std::thread;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || { let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v },
        gpa);
    let v = h.join().unwrap();
    println("{}", v.len());
}
