// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145) A type that holds an opaque type is decided
// (its kind, its drop glue) from the hidden type, never kept while that is
// not known: here mk and it are checked after main, which holds their
// values in an Option, a tuple, a struct field, a Vec, an array and an
// iterator. 0.30.2's first try kept the Option's and the tuple's answer
// (no drop: missing `drop 1`, `drop 2`). The output is rustc's. (x10 of
// the review of the opaque-type work)
// EXPECT: o true
// EXPECT: t 2
// EXPECT: h 3
// EXPECT: v 1
// EXPECT: a 1
// EXPECT: drop 6
// EXPECT: s 12
// EXPECT: end
// EXPECT: drop 5
// EXPECT: drop 4
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
fn main(gpa: Gpa) {
    let o = Some(mk(1));
    println("o {}", o.is_some());
    let t = (mk(2), 0i64);
    println("t {}", (t.0)());
    let h = Holder { f: mk(3) };
    println("h {}", (h.f)());
    let mut v: Vec<_, Gpa> = Vec::new_in(gpa);
    v.push(mk(4));
    println("v {}", v.len());
    let a = [mk(5)];
    println("a {}", a.len());
    let s: i64 = it(6).sum();
    println("s {}", s);
    println("end");
}

struct Holder<F> {
    f: F,
}

struct D {
    k: i64,
}

fn val(d: &D) -> i64 {
    d.k
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn mk(k: i64) -> impl Fn() -> i64 {
    let d = D { k: k };
    move || val(&d)
}

struct It {
    d: D,
    n: i64,
}

impl Iterator for It {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n > 0 {
            self.n -= 1;
            Some(self.d.k)
        } else {
            None
        }
    }
}

fn it(k: i64) -> impl Iterator<Item = i64> {
    It { d: D { k: k }, n: 2 }
}
