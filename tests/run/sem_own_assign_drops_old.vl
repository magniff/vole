// EDITION: rust
// sem-own: assigning a new owned value to a var drops the old one first (after evaluating the right side).
// EXPECT: make 2
// EXPECT: drop 1
// EXPECT: now 2
// EXPECT: end
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn mkp(id: i64, gpa: Gpa) -> D<Gpa> { println("make {id}"); mk(id, gpa) }

fn main(gpa: Gpa) {
    let mut a = mk(1, gpa);
    a = mkp(2, gpa);
    println("now {}", a.id);
    println("end");
}
