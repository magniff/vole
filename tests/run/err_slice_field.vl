// RULE: F30.4
// (0.29) A slice has no fields, as in Rust (E0609, E0615): its length
// is `s.len()` and its pointer `s.as_ptr()` (`s.as_mut_ptr()` of a
// `&mut [T]`). `s.len` and `s.ptr`, vole's until 0.28, are errors with
// the fix that writes the method (`volec fix --suggested`); a `&str`'s
// too, and any other name.
// ERROR: error[type error]: a slice has no field 'len'
// ERROR: line 19, column 5
// ERROR: help: call its method: '.len()'
// ERROR: fix --suggested
// ERROR: a slice has no field 'ptr'
// ERROR: line 23, column 5
// ERROR: help: call its method: '.as_ptr()' ('.as_mut_ptr()' for a '*mut T')
// ERROR: a slice has no field 'len'
// ERROR: line 29, column 13
// ERROR: a slice has no field 'cap'
// ERROR-COUNT: 4
fn count(s: &[i64]) -> usize {
    s.len
}

fn first(s: &[u8]) -> *const u8 {
    s.ptr
}

fn main() {
    let a = [1i64, 2, 3];
    let t = "abc";
    let n = t.as_bytes().len + count(&a[..]);
    let p = first(t.as_bytes());
    let c = a[..].cap;
    println("{} {}", n, p.is_null());
}
