// XFAIL: RT-317: a borrow of a constant struct literal is not promoted to a static as rustc does: `idp(&P { x: 13 })` returned, `px({ &P { x: 8 } })` and `{ let q = &P { x: 14 }; r = q; }` are refused (0.30.2)
// rustc promotes `&P { .. }` of a constant struct literal (no Drop, no
// interior mutability) to a 'static and prints the EXPECT line. Since
// v0.28.0 (v0.30.1 the same). Found by g302temps (pre-existing, not its
// to fix).
// EXPECT: 13 8 14
struct P {
    x: i64,
}

fn idp(p: &P) -> &P {
    p
}

fn px(p: &P) -> i64 {
    p.x
}

fn main() {
    let a: &P = idp(&P { x: 13 });
    let b = px({ &P { x: 8 } });
    let r: &P;
    {
        let q = &P { x: 14 };
        r = q;
    }
    println("{} {} {}", a.x, b, r.x);
}
