// EDITION: rust
// RULE: F15.1, F18.5
// (0.27.4) A lazy build makes the builtin impls of the primitives the
// program names: an open literal closed by a bound, `larger(5, 7)` with
// `T: PartialOrd + Copy`, is still i32 (its impls always made), and
// `-1` stays negative.
// EXPECT: 7 -1
fn larger<T: PartialOrd + Copy>(a: T, b: T) -> T {
    if a > b { a } else { b }
}

fn main() {
    println("{} {}", larger(5, 7), larger(-1, -2));
}
