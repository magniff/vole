// XFAIL: RT-228: abs_diff and midpoint are missing at every integer width (0.30.2)
// rustc 1.98 prints the EXPECT lines (twin: r302e_005_int_abs_diff_midpoint.rs.txt); guide rust does not list them as missing.
// EXPECT: i8 107 107 46 46
// EXPECT: i16 107 107 46 46
// EXPECT: i32 107 107 46 46
// EXPECT: i64 107 107 46 46
// EXPECT: isize 107 107 46 46
// EXPECT: u8 93 93 53 53
// EXPECT: u16 93 93 53 53
// EXPECT: u32 93 93 53 53
// EXPECT: u64 93 93 53 53
// EXPECT: usize 93 93 53 53
fn main() {
    let a: i8 = -7;
    let b: i8 = 100;
    println("i8 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: i16 = -7;
    let b: i16 = 100;
    println("i16 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: i32 = -7;
    let b: i32 = 100;
    println("i32 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: i64 = -7;
    let b: i64 = 100;
    println("i64 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: isize = -7;
    let b: isize = 100;
    println("isize {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b),
        b.midpoint(a));
    let a: u8 = 7;
    let b: u8 = 100;
    println("u8 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: u16 = 7;
    let b: u16 = 100;
    println("u16 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: u32 = 7;
    let b: u32 = 100;
    println("u32 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: u64 = 7;
    let b: u64 = 100;
    println("u64 {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b), b.midpoint(a));
    let a: usize = 7;
    let b: usize = 100;
    println("usize {:?} {:?} {:?} {:?}", a.abs_diff(b), b.abs_diff(a), a.midpoint(b),
        b.midpoint(a));
}
