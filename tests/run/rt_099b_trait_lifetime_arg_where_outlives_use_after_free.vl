// XFAIL: RT-99b: UNSOUND: (RT-99's family, a trait's type argument) `impl<'a, 'b> Pk<&'b i64> for P<'a> where 'a: 'b`, chosen through `fn need<R, T: Pk<R>>(t: T) -> R` with R = `&'static i64`, takes P's borrow of a local as 'static: `keep = need(P { x: &v[0] })` with v dropped at the block's end, then `*keep` read, is a use after free; rustc E0597 (`v` does not live long enough) (0.30.2)
// From the re-review of g302bor2 (its form r05_trait_typearg_outlives). Since v0.30.1 at least
// (the same use after free under --check-alloc on v0.30.1 and on the release build, 38fe466c5).
// The outlives written in the impl's header is rt_099c.
// FLAGS: --check-alloc
// ERROR: line 35
trait Pk<R> {
    fn pick(self) -> R;
}

struct P<'a> {
    x: &'a i64,
}

impl<'a, 'b> Pk<&'b i64> for P<'a>
    where
        'a: 'b,
{
    fn pick(self) -> &'b i64 {
        self.x
    }
}

fn need<R, T: Pk<R>>(t: T) -> R {
    t.pick()
}

static FIVE: i64 = 5;

fn main(gpa: Gpa) {
    let mut keep: &'static i64 = &FIVE;
    {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1000);
        keep = need(P { x: &v[0] });
    }
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{} {:?}", *keep, x);
}
