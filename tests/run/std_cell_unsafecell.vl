// Runs on std since 0.27.2's switch.
// The std item(s): std::cell UnsafeCell.
// EXPECT: 2
use std::cell::UnsafeCell;

struct Counter {
    n: UnsafeCell<i64>,
}

impl Counter {
    fn bump(&self) {
        unsafe { *self.n.get() += 1 };
    }
}

fn main() {
    let c = Counter { n: UnsafeCell::new(0) };
    c.bump();
    c.bump();
    println("{}", c.n.into_inner());
}
