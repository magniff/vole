// RULE: F15.3, FL13
// FLAGS: --check-alloc
// (0.27.3) An array's by-value iterator, `[T; N]::into_iter` (std::array's
// IntoIter<T, [T; N]>, FL13), partly consumed and then dropped: the
// elements it gave out are the caller's, the ones it did not are dropped
// with it, each once (no leak, no double drop under --check-alloc).
// EXPECT: Some("a") 2
// EXPECT: dropped the rest
// EXPECT: took 3
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: dropped the iterator
// EXPECT: drop 3
// EXPECT: end
struct D(i64);

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.0);
    }
}

fn main(gpa: Gpa) {
    let words = ["a".to_string_in(gpa), "bb".to_string_in(gpa), "ccc".to_string_in(gpa)];
    let mut it = words.into_iter();
    let first = it.next();
    println("{:?} {}", first, it.len());
    drop(it);
    println("dropped the rest");
    let mut ds = [D(1), D(2), D(3)].into_iter();
    let last = ds.next_back();
    if let Some(d) = &last {
        println("took {}", d.0);
    }
    drop(ds);
    println("dropped the iterator");
    drop(last);
    println("end");
}
