// XFAIL: RT-332: an opaque value's hidden type leaks through an operator: `fn d() -> impl Debug { 5i64 }` then `d() + 1` is accepted (0.30.2)
// rustc E0369 (no Add for impl Debug). Since v0.30.1 at least. From the
// review of the opaque-type work.
// ERROR: line 13
use std::fmt::Debug;

fn d() -> impl Debug {
    5i64
}

fn main() {
    let x = d();
    println("{:?}", x + 1);
}
