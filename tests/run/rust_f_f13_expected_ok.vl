// RULE: F13.2, F13.4
// Two impls of one generic trait whose function takes no arguments: the
// let's type picks one (F13.2), and in a generic body the parameter's
// bound picks one (F13.4).
// EXPECT: 7
// EXPECT: 1
// EXPECT: 7
trait Get<X> {
    fn get(&self) -> X;
}

struct S {
    n: i64,
}

impl Get<i64> for S {
    fn get(&self) -> i64 {
        self.n
    }
}

impl Get<bool> for S {
    fn get(&self) -> bool {
        self.n > 0
    }
}

fn via<G: Get<i64>>(g: G) -> i64 {
    g.get()
}

fn main() {
    let s = S { n: 7 };
    let a: i64 = s.get();
    let b: bool = s.get();
    println("{}", a);
    println("{}", if b { 1 } else { 0 });
    println("{}", via(s));
}
