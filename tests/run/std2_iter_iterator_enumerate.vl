// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::enumerate.
// EXPECT: [(0, 'a'), (1, 'b')]

fn main(gpa: Gpa) {
    let s = Vec::from_in(['a', 'b'], gpa);
    let a: Vec<(usize, char), Gpa> = s.iter().copied().enumerate().collect_in(gpa);
    println("{:?}", a);
}
