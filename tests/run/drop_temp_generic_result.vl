// (0.29, semfuzz's generic_ref_temp) The temporary a generic function
// returns, its type a type parameter (`dup<X: Clone>(x: &X) -> X`), is
// dropped at the end of its statement when it is lent (`obs(&dup(&t))`) or
// a field is read out of it (`dup(&t).v`), as the one of the same function
// without the parameter (`dupt`). It leaked (live 2): the builder took a
// generic result whose callee consumes no argument for a copy of what the
// arguments keep, and gave its temporary no drop. Also a tuple, an Option
// and a Result of the parameter.
// EXPECT: a 4
// EXPECT: d2
// EXPECT: b 4
// EXPECT: d3
// EXPECT: c 4
// EXPECT: d4
// EXPECT: d 4
// EXPECT: d5
// EXPECT: e 4
// EXPECT: d6
// EXPECT: f 4
// EXPECT: d7
// EXPECT: d8
// EXPECT: g 4
// EXPECT: d9
// EXPECT: d10
// EXPECT: h true
// EXPECT: d11
// EXPECT: i 4
// EXPECT: d12
// EXPECT: j true
// EXPECT: d13
// EXPECT: d15
// EXPECT: k 4
// EXPECT: end
// EXPECT: d14
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn dup<X: Clone>(x: &X) -> X {
    x.clone()
}

fn dup_opt<X: Clone>(x: &X) -> Option<X> {
    Some(x.clone())
}

fn dup_res<X: Clone>(x: &X) -> Result<X, i64> {
    Ok(x.clone())
}

fn dup_pair<X: Clone>(x: &X) -> (X, X) {
    (x.clone(), x.clone())
}

fn dupt(x: &T) -> T {
    x.clone()
}

fn run() {
    let t = mk(4);
    println("a {}", obs(&dup(&t)));
    println("b {}", obs(&dupt(&t)));
    println("c {}", dup(&t).v);
    println("d {}", dup::<T>(&t).v);
    println("e {}", obs(&dup::<T>(&t)));
    println("f {}", dup_pair(&t).1.v);
    println("g {}", obs(&dup_pair(&t).0));
    println("h {}", dup_opt(&t).is_some());
    println("i {}", obs(dup_opt(&t).as_ref().unwrap()));
    println("j {}", dup_res(&t).is_ok());
    let (p, _) = dup_pair(&t);
    println("k {}", p.v);
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
