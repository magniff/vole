// EDITION: rust
// The std2 item(s): std::mem replace.
// EXPECT: 1 5 [1] []
use std::mem;
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut a = 1i64;
    let old = mem::replace(&mut a, 5);
    let mut v = Vec::new_in(gpa);
    v.push(1i64);
    let w = mem::replace(&mut v, Vec::new_in(gpa));
    println("{} {} {:?} {:?}", old, a, w, v);
}
