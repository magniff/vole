// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ptr copy.
// EXPECT: [1, 1, 2, 3, 5]
use std::ptr::{NonNull, self};

fn main() {
    let mut a = [1i64, 2, 3, 4, 5];
    let p = NonNull::new(&mut a[0] as *mut i64).unwrap();
    unsafe { ptr::copy(p.as_ptr() as *const i64, p.add(1).as_ptr(), 3) };
    println("{:?}", a);
}
