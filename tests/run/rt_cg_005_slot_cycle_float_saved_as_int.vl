// RT-CG-5 (fixed in 0.30.1): the other direction of a parallel move's cycle through an integer and an f64 spill slot: the f64 was saved in the integer cycle register x17 and stored back as `str d-15`, which the assembler took as `str s0`
// FLAGS: -O2
// EXPECT: 5 411.0390625 25 26.57110984091129
// The same loop as rt_cg_005_slot_cycle_int_saved_as_float, with other
// fillers: here the cycle's first move is the integer's, so its break
// saved the f64 slot through x17 (the integer cycle register) and the
// move reading it was spelled as a float store from register 17 - 32.
// rustc prints the EXPECT line; the release branch printed `5 7 ...` at
// -O2.
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[inline(never)]
fn g(a: i64) -> i64 { K.fetch_add(1, Ordering::Relaxed); a ^ 5 }

fn main() {
    let lim = g(0) + 1;
    let a0 = g(0);
    let a1 = g(1);
    let a2 = g(2);
    let a3 = g(3);
    let a4 = g(4);
    let a5 = g(5);
    let a6 = g(6);
    let a7 = g(7);
    let a8 = g(8);
    let a9 = g(9);
    let a10 = g(10);
    let a11 = g(11);
    let a12 = g(12);
    let a13 = g(13);
    let a14 = g(14);
    let a15 = g(15);
    let a16 = g(16);
    let a17 = g(17);
    let a18 = g(18);
    let a19 = g(19);
    let a20 = g(20);
    let a21 = g(21);
    let a22 = g(22);
    let a23 = g(23);
    let a24 = g(25);
    let b0 = g(8) as f64 * 0.5;
    let b1 = g(9) as f64 * 0.5;
    let b2 = g(10) as f64 * 0.5;
    let b3 = g(11) as f64 * 0.5;
    let b4 = g(12) as f64 * 0.5;
    let b5 = g(13) as f64 * 0.5;
    let b6 = g(14) as f64 * 0.5;
    let b7 = g(15) as f64 * 0.5;
    let b8 = g(16) as f64 * 0.5;
    let b9 = g(17) as f64 * 0.5;
    let b10 = g(18) as f64 * 0.5;
    let b11 = g(19) as f64 * 0.5;
    let b12 = g(20) as f64 * 0.5;
    let b13 = g(21) as f64 * 0.5;
    let b14 = g(22) as f64 * 0.5;
    let b15 = g(23) as f64 * 0.5;
    let b16 = g(24) as f64 * 0.5;
    let b17 = g(26) as f64 * 0.5;
    let b18 = g(27) as f64 * 0.5;
    let b19 = g(28) as f64 * 0.5;
    let b20 = g(29) as f64 * 0.5;
    let b21 = g(30) as f64 * 0.5;
    let b22 = g(31) as f64 * 0.5;
    let b23 = g(32) as f64 * 0.5;
    let b24 = g(33) as f64 * 0.5;
    let b25 = g(34) as f64 * 0.5;
    let b26 = g(35) as f64 * 0.5;
    let b27 = g(36) as f64 * 0.5;
    let mut x: f64 = 0.5;
    let mut n: i64 = 1;
    let mut t: i64 = 0;
    let mut s: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        s = s ^ (a5 + t);
        s = s ^ (a6 + t);
        s = s ^ (a7 + t);
        s = s ^ (a8 + t);
        s = s ^ (a9 + t);
        s = s ^ (a10 + t);
        let c = g(t);
        s = s ^ (a0 + t);
        s = s ^ (a1 + t);
        s = s ^ (a2 + t);
        s = s ^ (a11 + t);
        s = s ^ (a12 + t);
        s = s ^ (a13 + t);
        s = s ^ (a14 + t);
        s = s ^ (a15 + t);
        s = s ^ (a16 + t);
        s = s ^ (a17 + t);
        s = s ^ (a18 + t);
        s = s ^ (a19 + t);
        s = s ^ (a20 + t);
        s = s ^ (a21 + t);
        s = s ^ (a22 + t);
        s = s ^ (a23 + t);
        s = s ^ (a24 + t);
        sf = sf * 0.5 + b18;
        sf = sf * 0.5 + b19;
        sf = sf * 0.5 + b20;
        sf = sf * 0.5 + b23;
        sf = sf * 0.5 + b24;
        sf = sf * 0.5 + b25;
        sf = sf * 0.5 + b26;
        sf = sf * 0.5 + b27;
        let v = x * 1.5 + (c as f64);
        let n2 = (c * 3) ^ t;
        let u = n + c;
        let x2 = v + (u as f64);
        let e = g(t + 1);
        s = s ^ (a3 + t);
        s = s ^ (a4 + t);
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b1;
        sf = sf * 0.5 + b2;
        sf = sf * 0.5 + b3;
        sf = sf * 0.5 + b4;
        sf = sf * 0.5 + b5;
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b7;
        sf = sf * 0.5 + b8;
        sf = sf * 0.5 + b9;
        sf = sf * 0.5 + b10;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b12;
        sf = sf * 0.5 + b13;
        sf = sf * 0.5 + b14;
        sf = sf * 0.5 + b15;
        sf = sf * 0.5 + b16;
        sf = sf * 0.5 + b17;
        sf = sf * 0.5 + b21;
        sf = sf * 0.5 + b22;
        n = n2;
        x = x2;
        t += 1;
    }
    println("{n} {x} {s} {sf}");
}
