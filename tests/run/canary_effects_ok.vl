// 0.30.1: the must-pass side of the canary_effects_* cases: the same paths
// (a call chain three deep, a closure, a generic instance, a trait method
// direct and through a bound, a C function declared #[effects()]) with no
// effect planted pass #[no_panic], #[no_alloc], #[no_io] and #[pure] at
// once.
// EXPECT: 7
extern "C" {
    #[effects()]
    fn abs(x: i32) -> i32;
}

fn leaf() -> i64 {
    1
}

fn mid() -> i64 {
    leaf()
}

fn top() -> i64 {
    mid()
}

#[pure]
#[no_panic]
#[no_alloc]
#[no_io]
fn chain3() -> i64 {
    top()
}

#[pure]
#[no_panic]
#[no_alloc]
#[no_io]
fn through_closure() -> i64 {
    let f = || leaf();
    f()
}

fn generic<T: Copy>(x: T) -> T {
    let _ = leaf();
    x
}

#[pure]
#[no_panic]
#[no_alloc]
#[no_io]
fn through_generic() -> i64 {
    generic(1i64)
}

trait Act {
    fn act(&self) -> i64;
}

struct A {}

impl Act for A {
    fn act(&self) -> i64 {
        leaf()
    }
}

#[pure]
#[no_panic]
#[no_alloc]
#[no_io]
fn through_trait() -> i64 {
    let a = A {};
    a.act()
}

#[pure]
#[no_panic]
#[no_alloc]
#[no_io]
fn through_bound<T: Act>(t: &T) -> i64 {
    t.act()
}

#[pure]
#[no_panic]
#[no_alloc]
#[no_io]
fn through_c_declared() -> i64 {
    // UNSAFE: C's abs. SAFETY: any value but i32::MIN, which this is not.
    (unsafe { abs(-1) }) as i64
}

fn main() {
    let n = chain3().wrapping_add(through_closure()).wrapping_add(through_generic())
        .wrapping_add(through_trait()).wrapping_add(through_bound(&A {}))
        .wrapping_add(through_c_declared()).wrapping_add(1);
    println("{n}");
}
