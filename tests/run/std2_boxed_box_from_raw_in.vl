// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::boxed Box::from_raw_in.
// EXPECT: dropped 2
// EXPECT: end
use std::boxed::Box;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("dropped {}", self.n);
    }
}

fn main(gpa: Gpa) {
    let p: *mut D = Box::into_raw(Box::new_in(D { n: 1 }, gpa));
    unsafe { (*p).n = 2 };
    let b = unsafe { Box::from_raw_in(p, gpa) };
    drop(b);
    println("end");
}
