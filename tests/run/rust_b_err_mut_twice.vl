// EDITION: rust
// RULE: D2.5
// (0.27.1) Two `&mut x` live at once: (WB, M).
// ERROR: error[borrowck.mut_twice]
// ERROR: line 12, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let a = &mut x;
    let b = &mut x;
    *a += 1;
    *b += 1;
    println("{}", x);
}
