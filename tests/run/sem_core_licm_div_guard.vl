// EDITION: rust
// A guarded division by an invariant: defined anyway (x / 0 == 0).
// FLAGS: -O2
// EXPECT: 5
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    let d = unsafe { Z };
    while k < 5 + unsafe { Z } { if d != 0 { t += 100 / d; } else { t += 1; } k += 1; }
    println("{}", t);
    0
}
