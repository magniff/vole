// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a23_static_ptr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which touches a static
// A callee writes through a raw pointer it keeps in a static.
static mut P: usize = 0;

fn poke() -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *(P as *mut i64) = 9; }
    true
}

fn f(n: i64) -> i64
    requires poke()
{
    n
}

fn main() {
    let mut x = 1i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { P = &raw mut x as usize; }
    println("{}", f(1));
    println("{}", x);
}
