// RULE: D7.4
// (0.30.1) `Vec::insert` has a `requires`: its call binds the arguments
// that run code before the `$pre` check, and now binds the autoref'd
// receiver first, two-phase, as rustc reserves `&mut v` before the
// arguments: the block's `v.clear()` is E0499 (vole's mut_twice) as in
// `v.push({ v.clear(); 9 })`. Before, the receiver was borrowed after the
// arguments had run and the program was accepted.
// ERROR: error[borrowck.mut_twice]
// ERROR: line 15, column 9
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.insert(0, {
        v.clear();
        9
    });
    println("{:?}", v);
}
