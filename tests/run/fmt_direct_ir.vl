// EDITION: rust
// XFAIL: gap 25: its CHECK lines name MVS std's IR (std.fmt.__print_begin): to write again for std2's
// (0.17) An f-string passed straight to println, push_fmt or format_in
// makes no function: no closure, no std::Interp instance or Display of
// one, no instance of println, push_fmt or format_in; the writes are in
// the caller (fmt_direct: what they print). At -O0, where nothing is
// inlined away.
// CHECK-OPT: 0
// EXPECT: v=42 s="hi"
// EXPECT: [v=42]
// EXPECT: 42/hi
// CHECK-NOT: Interp
// CHECK-NOT: closure
// CHECK-NOT: fn main.
// CHECK-NOT: call std.fmt.println
// CHECK-NOT: call std.Buf.push_fmt
// CHECK-NOT: call std.fmt.format_in
// CHECK: fn main:
// CHECK: call std.fmt.__print_begin
// CHECK: call std.fmt.__print_end
// CHECK: call std.fmt.__buf_fmt.
// CHECK: call std.fmt.__buf_fmt_end.
// CHECK: call std.fmt.__fmt_tmp
// CHECK: call std.fmt.__fmt_str_end.
// CHECK-NOT: Interp
// CHECK-NOT: fn main.
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'

fn main(gpa: Gpa) {
    let v: i64 = 42;
    let s: &[u8] = b"hi";
    println("v={v} s={s:?}");
    let mut b: Vec<u8, Gpa> = Vec::<u8, _>::new_in(gpa);
    std::fmt::write(&mut b, "[v={v}]").unwrap();
    println("{}", str::from_utf8(b.as_slice()).unwrap());
    let mut t = { let s = str::from_utf8(s).unwrap(); format_in("{v}/{s}", gpa) };
    println("{}", str::from_utf8(t.as_bytes()).unwrap());
    drop(b);
    t.clear();
}
