// XFAIL: RT-C301-11: a false error for a function whose result is `&'static T` (0.30.2)
// From the review: implied static only from a parameter, not the result: fn f<T>() -> &'static T must not give T: 'static
// rustc accepts it.
fn need<T: 'static>(t: T) -> i64 { 1 }
fn f<T: Copy>(x: T, r: fn() -> &'static T) -> i64 { need(x) }
fn main() {}
