// EDITION: rust
// (0.26.3, decision 6) `a + b` of i32s panics at -O2 with --overflow-
// checks=on, with Rust's message at the expression.
// FLAGS: -O2 --overflow-checks=on
// EXIT: 101
// EXPECT: before
// STDERR: ovf_on_o2_add_i32.vl:18:13: attempt to add with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i32 = id(2147483647) as i32;
    let b: i32 = id(1) as i32;
    println("before");
    let r = a + b;
    println("after {}", r);
}
