// EDITION: rust
// RULE: F0.6
// (0.27.5) Text and its bytes: `b".."` and `as_bytes()` where a `&[u8]`
// goes, a literal where a `&str` goes (a const, a field), and a format
// literal written by print; std::arch's feature names are literals.
// EXPECT: Hello 3 2 1 xy
const NAME: &str = "xy";

struct E {
    msg: &'static str,
}

fn len_of(b: &[u8]) -> usize {
    b.len()
}

fn main(gpa: Gpa) {
    let s = String::from_in("hey", gpa);
    let e = E { msg: "a" };
    let t: &str = "ab";
    let _ = std::arch::has("neon");
    println("{} {} {} {} {}", std::str::from_utf8(b"Hello").unwrap(), len_of(s.as_bytes()),
        len_of(t.as_bytes()), e.msg.len(), NAME);
}
