// EDITION: rust
// i < len does not make i - 1 in bounds (i == 0).
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 8
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], i: i64) -> i64 { if i < s.len() as i64 { s[(i - 1) as usize] } else { 0 } }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s, 0 + unsafe { Z }));
    0
}
