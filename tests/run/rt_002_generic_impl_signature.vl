// XFAIL: RT-2: a generic impl's methods are never checked against the trait's signatures (open)
// `impl<T> Mk for X<T>` gives `mk` an extra parameter and `nm` an i32 result
// where the trait declares (&self, i64) -> i64 and () -> i64. rustc rejects
// both (E0050: wrong number of parameters; E0053: incompatible type). vole
// checks the signatures of non-generic impls only
// (front::traits::check_impl_signatures skips `fns[f].generic > 0`), so
// both are accepted, and an instance is checked against the impl's own
// signature: in `go`, nm's i32 is widened to the trait's i64 (prints -1).
// ERROR: error[
// ERROR: line 24,
// ERROR: error[
// ERROR: line 28,
// ERROR-COUNT: 2
trait Mk {
    fn mk(&self, a: i64) -> i64;
    fn nm(&self) -> i64;
}

struct X<T> {
    t: T,
}

impl<T> Mk for X<T> {
    fn mk(&self, a: i64, b: i64) -> i64 {
        a + b
    }

    fn nm(&self) -> i32 {
        -1
    }
}

fn go<M: Mk>(m: &M) -> i64 {
    m.nm()
}

fn main() {
    println("{}", go(&X { t: 1u8 }));
}
