// RULE: F8.3, F10.1
// RT-C301-8: `T::K`, `T::m(t)`, `T::mk()` with T bounded in a `where`
// clause (a function's, an impl's) are that bound's items in the instance.
// 0.30.1 printed `122 112`. rustc prints 222 111.
// EXPECT: 222 111
trait A { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
trait B { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 10 } fn mk() -> i64 { 100 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 20 } fn mk() -> i64 { 200 } }
fn w<T>(t: &T) -> i64 where T: B { T::K + T::m(t) + T::mk() }
struct H<T> { t: T }
impl<T> H<T> where T: A { fn go(&self) -> i64 { T::K + T::m(&self.t) + T::mk() } }
fn main() { let s = S; println("{} {}", w(&s), H { t: S }.go()); }
