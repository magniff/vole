// (0.30.2, RT-46) The raw forms around a raw slice parameter, each read
// before and after a call that writes the memory through another raw
// pointer: a raw pointer to an array, to a struct holding a slice (the
// call points the slice elsewhere), a raw
// slice in a struct field and in a tuple (a parameter by value, and one
// behind a `&`), a raw slice returned by a function, a pointer to a raw
// slice. None promises anything of the memory, so each second read is a
// new load. rustc (debug and -O) prints 2050 for each; so does v0.30.1
// (these forms never had the fact: a guard for the one function that
// classes a parameter, middle/gvn.vl param_class_of).
// EXPECT: 2050 2050 2050 2050 2050 2050 2050 2050
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn reset(q: *mut i64) {
    poke(q, 2);
}

struct View<'a> {
    s: &'a [i64],
}

#[derive(Clone, Copy)]
struct Raw {
    p: *const [i64],
}

#[inline(never)]
fn array(p: *const [i64; 4], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array, live across the call
    unsafe {
        let a = (*p)[1];
        poke(q, 50);
        a * 1000 + (*p)[1]
    }
}

#[inline(never)]
fn retarget<'a>(q: *mut View<'a>, to: &'a [i64]) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points to main's View, live across the call
    unsafe {
        (*q).s = to;
    }
}

#[inline(never)]
fn view<'a>(p: *const View<'a>, q: *mut View<'a>, to: &'a [i64]) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point to main's View, live across the call
    unsafe {
        let a = (*p).s[1];
        retarget(q, to);
        a * 1000 + (*p).s[1]
    }
}

#[inline(never)]
fn field(r: Raw, q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array, live across the call
    unsafe {
        let a = (*r.p)[1];
        poke(q, 50);
        a * 1000 + (*r.p)[1]
    }
}

#[inline(never)]
fn field_ref(r: &Raw, q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array, live across the call
    unsafe {
        let a = (*r.p)[1];
        poke(q, 50);
        a * 1000 + (*r.p)[1]
    }
}

#[inline(never)]
fn tuple(t: (*const [i64], i64), q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array, live across the call
    unsafe {
        let a = (*t.0)[1];
        poke(q, 50);
        a * 1000 + (*t.0)[1] + t.1
    }
}

#[inline(never)]
fn make(base: *mut i64) -> *const [i64] {
    // UNSAFE: a raw slice over main's array
    // SAFETY: base points to 4 elements, live while the slice is used
    unsafe { std::slice::from_raw_parts(base, 4) as *const [i64] }
}

#[inline(never)]
fn returned(base: *mut i64, q: *mut i64) -> i64 {
    let p = make(base);
    // UNSAFE: raw pointers into main's array
    // SAFETY: the array lives across the call
    unsafe {
        let a = (*p)[1];
        poke(q, 50);
        a * 1000 + (*p)[1]
    }
}

#[inline(never)]
fn pointer_to(pp: *const *const [i64], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: pp points to main's raw slice, q into the array; both live
    unsafe {
        let a = (**pp)[1];
        poke(q, 50);
        a * 1000 + (**pp)[1]
    }
}

fn main() -> i32 {
    let mut a = [1i64, 2, 3, 4];
    let base = a.as_mut_ptr();
    // UNSAFE: the raw pointers are all made from base
    // SAFETY: a has 4 elements and outlives every pointer; no reference to a
    // is used while they are
    let (p, q) = unsafe {
        (std::slice::from_raw_parts(base, 4) as *const [i64], base.add(1))
    };
    let x = array(base as *const [i64; 4], q);
    reset(q);
    let first = [1i64, 2];
    let other = [0i64, 50];
    let mut v = View { s: &first };
    let vp = &mut v as *mut View;
    let y = view(vp as *const View, vp, &other);
    let r = Raw { p };
    let z = field(r, q);
    reset(q);
    let zr = field_ref(&r, q);
    reset(q);
    let t = tuple((p, 0), q);
    reset(q);
    let u = returned(base, q);
    reset(q);
    let w = pointer_to(&p, q);
    reset(q);
    let w2 = pointer_to(&p as *const *const [i64], q);
    println("{} {} {} {} {} {} {} {}", x, y, z, zr, t, u, w, w2);
    0
}
