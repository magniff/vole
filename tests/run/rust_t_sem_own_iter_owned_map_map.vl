// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_iter_owned_map_map.vl to Rust's spelling.
// sem-own: owned items mapped again to a number: the D is dropped inside the second map's closure (0.25.3).
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: s 1
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let s: i64 = (0..2).map(|i| mk(i, gpa)).map(|d| d.id).sum();
    println("s {s}");
}
