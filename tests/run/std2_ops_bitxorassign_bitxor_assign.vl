// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops BitXorAssign::bitxor_assign.
// EXPECT: V { x: 9 } 9
use std::ops::BitXorAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitXorAssign for V {
    fn bitxor_assign(&mut self, rhs: V) {
        self.x ^= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.bitxor_assign(V { x: 5 });
    let mut n = 12i64;
    n.bitxor_assign(5);
    println("{:?} {}", a, n);
}
