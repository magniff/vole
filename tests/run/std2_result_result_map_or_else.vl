// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::map_or_else.
// EXPECT: 4 3
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    println("{} {}", a.map_or_else(|e| e.len() as i64, |x| x + 1),
        b.map_or_else(|e| e.len() as i64, |x| x + 1));
}
