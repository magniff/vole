// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::trim'
// std's display width (0.20, compiler/std/unicode/width.vl): every
// fully-qualified emoji sequence of Unicode's emoji-test.txt is one
// grapheme cluster 2 columns wide; unicode-width's documented cases per
// code point; clusters by the per-grapheme rule; whole texts both ways.
// ARGS: @ROOT@/tests/std/unicode/emoji-test.txt
import "stdio.h" as c;

use std::trim;
use std::str::encode_utf8;
use std::unicode::UNICODE_VERSION; use std::unicode::char_width; use std::unicode::char_width_cjk;
use std::unicode::cluster_width; use std::unicode::count_graphemes; use std::unicode::str_width;
use std::unicode::str_width_chars;

fn read_all(path: *mut u8, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut text = Vec::<u8, Gpa>::new_in(gpa);
    let f = unsafe { c::fopen(path, c"rb") };
    if f == 0 as *mut c::FILE {
        return text;
    }
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::fread(&mut chunk[0], 1u64, 65536u64, f) } as i64;
        if n <= 0 {
            break;
        }
        text.extend_from_slice(&chunk[0..n as usize]);
    }
    unsafe { c::fclose(f); }
    text
}

fn hex(s: &[u8]) -> u32 {
    let mut v: u32 = 0;
    for i in 0..s.len() {
        let b = s[i];
        let d = if b >= b'0' && b <= b'9' { (b - b'0') as u32 } else { (b - b'A') as u32 + 10 };
        v = v * 16 + d;
    }
    v
}

fn cw(s: &[u8]) -> i64 {
    cluster_width(s, false)
}

fn main(argc: i32, argv: *mut *mut u8, gpa: Gpa) -> i32 {
    let (major, minor, update) = UNICODE_VERSION;
    println("Unicode {major}.{minor}.{update}");
    // unicode-width's per code point cases
    let cps: [u32; 16] = [0x61, 0x0, 0x7f, 0x9f, 0xa0, 0xad, 0x300, 0x1100, 0x1160, 0x115f,
        0x17d8, 0x1f1e6, 0x2460, 0x3b1, 0x4e16, 0xff48];
    for k in 0..16 {
        print(
            "{}{:x}:{}/{}", if k > 0 { " " } else { "" }, cps[k as usize],
            char_width(cps[k as usize]), char_width_cjk(cps[k as usize]));
    }
    println("");
    // clusters
    println(
        "{} {} {} {} {} {} {} {} {} {} {} {} {} {} {}", cw("👨‍👩‍👧".as_bytes()),
        cw("❤️".as_bytes()), cw("❤".as_bytes()), cw("#️⃣".as_bytes()), cw(b"#"),
        cw("🇫🇷".as_bytes()), cw("🇫".as_bytes()), cw("⌚".as_bytes()),
        cw("⌚︎".as_bytes()), cw("👍🏽".as_bytes()), cw("☝🏽".as_bytes()),
        cw("é".as_bytes()), cw("각".as_bytes()), cw("\u{301}".as_bytes()),
        cw("🈚︎".as_bytes()));
    println(
        "{} {} {} {}", str_width("héllo, 世界! 👨‍👩‍👧 🇫🇷"),
        str_width_chars("héllo, 世界! 👨‍👩‍👧 🇫🇷"),
        str_width("①②", cjk: true), str_width_chars("a\tb\n"));

    // emoji-test.txt: `CPS ; fully-qualified # ...`
    if argc < 2 {
        return 2;
    }
    let text = unsafe { read_all((*argv.add(1)), gpa) };
    let t = text.as_slice();
    let mut utf8 = Vec::<u8, Gpa>::new_in(gpa);
    let mut full: i64 = 0;
    let mut other: i64 = 0;
    let mut other_one: i64 = 0;
    let mut bad: i64 = 0;
    let mut from: i64 = 0;
    for i in 0..t.len() + 1 {
        if i < t.len() && t[i] != b'\n' {
            continue;
        }
        let line = &t[from as usize..i];
        from = i as i64 + 1;
        if line.len() == 0 || line[0] == b'#' {
            continue;
        }
        let mut semi: i64 = 0;
        while semi < line.len() as i64 && line[semi as usize] != b';' {
            semi += 1;
        }
        let mut hash = semi;
        while hash < line.len() as i64 && line[hash as usize] != b'#' {
            hash += 1;
        }
        let status = trim(&line[(semi + 1) as usize..hash as usize]);
        utf8.clear();
        let field = trim(&line[0..semi as usize]);
        let mut k: i64 = 0;
        let mut e = [0u8; 4];
        while k < field.len() as i64 {
            let mut end = k;
            while end < field.len() as i64 && field[end as usize] != b' ' {
                end += 1;
            }
            let n = encode_utf8(hex(&field[k as usize..end as usize]), &mut e);
            utf8.extend_from_slice(&e[0..n as usize]);
            k = end + 1;
        }
        let s = utf8.as_slice();
        if status == b"fully-qualified" {
            full += 1;
            if count_graphemes(s) != 1 || cluster_width(s, false) != 2 || str_width(s, false) != 2 {
                bad += 1;
                if bad <= 10 {
                    println(
                        "not one 2-wide cluster: {field} ({} clusters, width {})",
                        count_graphemes(s), cluster_width(s, false),
                        field = str::from_utf8(field).unwrap());
                }
            }
        } else {
            other += 1;
            if count_graphemes(s) == 1 {
                other_one += 1;
            }
        }
    }
    println(
        "fully-qualified: {full}, {bad} not one 2-wide cluster; others: {other}, {other_one} one cluster");
    0
}

// EXPECT: Unicode 18.0.0
// EXPECT: 61:1/1 0:-1/-1 7f:-1/-1 9f:-1/-1 a0:1/1 ad:0/0 300:0/0 1100:2/2 1160:0/0 115f:2/2 17d8:3/3 1f1e6:1/1 2460:1/2 3b1:1/1 4e16:2/2 ff48:2/2
// EXPECT: 2 2 1 2 1 2 1 2 1 2 2 1 2 0 2
// EXPECT: 18 22 4 2
// EXPECT: fully-qualified: 3963, 0 not one 2-wide cluster; others: 1281, 1281 one cluster
