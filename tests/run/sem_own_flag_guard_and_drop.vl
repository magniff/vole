// EDITION: rust
// sem-own: a guard and the other drops share one exit list: reverse order
// of declaration (0.26.2: a guard, where this was a `defer`).
// EXPECT: body
// EXPECT: drop 2
// EXPECT: guard
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

struct Guard { n: i64 }
impl Drop for Guard { fn drop(&mut self) { println("guard"); } }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let _g = Guard { n: 0 };
    let b = mk(2, gpa);
    println("body");
}
