// (0.30.1, review 2) An impl's bounds follow from the trait's, by
// implication, not by spelling (rustc accepts each): a lifetime renamed in
// an Fn bound, FnOnce where the trait has FnMut, `FnMut(&'static str)`
// where the trait has `FnMut(&str)` (any lifetime), a bound every type
// meets by a blanket impl.
// EXPECT: 2
// EXPECT: hi
// EXPECT: 4
// EXPECT: x
// EXPECT: 1
trait Tr1 {
    fn f1<'a, F: Fn(&'a str) -> usize>(&self, x: &'a str, g: F) -> usize;
}

trait Tr2<'a> {
    fn each<F: FnMut(&'a str)>(&self, f: F);
}

trait Tr3 {
    fn f3<F: FnMut() -> i64>(&self, g: F) -> i64;
}

trait Tr4 {
    fn each4<F: FnMut(&str)>(&self, f: F);
}

trait Any2 {
    fn z(&self) -> i64 {
        0
    }
}

impl<T> Any2 for T {}

trait Tr5 {
    fn f5<T>(&self, t: T) -> i64;
}

struct S;

struct W<'x> {
    s: &'x str,
}

impl Tr1 for S {
    fn f1<'b, G: Fn(&'b str) -> usize>(&self, x: &'b str, g: G) -> usize {
        g(x)
    }
}

impl<'b> Tr2<'b> for W<'b> {
    fn each<F: FnMut(&'b str)>(&self, mut f: F) {
        f(self.s)
    }
}

impl Tr3 for S {
    fn f3<F: FnOnce() -> i64>(&self, g: F) -> i64 {
        g()
    }
}

impl Tr4 for S {
    fn each4<F: FnMut(&'static str)>(&self, mut f: F) {
        f("x")
    }
}

impl Tr5 for S {
    fn f5<T: Any2>(&self, t: T) -> i64 {
        t.z() + 1
    }
}

fn main() {
    println("{}", S.f1("hi", |s| s.len()));
    let w = W { s: "hi" };
    w.each(|t| println("{}", t));
    println("{}", S.f3(|| 4i64));
    S.each4(|t| println("{}", t));
    println("{}", S.f5(3i64));
}
