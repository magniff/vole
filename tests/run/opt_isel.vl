// Instruction selection (50_isel.vl): indexed loads and stores, fused
// multiply-add, shifted operands, bit-field extraction, test-and-branch,
// selects, and x86-64's three-operand lea. The functions are called
// through function values, so that each is compiled on its own, with
// operands it does not know, and checked in the assembly, in order.
// EXPECT: 30 30
// EXPECT: 1035 -965
// EXPECT: 61 7 3
// EXPECT: 25 2
// EXPECT: 17 -3 1
// EXPECT: 42 43
// ASM(aarch64-macos): str x2, [x0, x1, lsl #3]
// ASM(aarch64-macos): ldr x0, [x0, x1, lsl #3]
// ASM(aarch64-macos): madd x0, x0, x1, x2
// ASM(aarch64-macos): msub x0, x0, x1, x2
// ASM(aarch64-macos): add x0, x0, x1, lsl #4
// ASM(aarch64-macos): ubfx x0, x0, #4, #3
// ASM(aarch64-macos): ubfx x0, x0, #1, #2
// ASM(aarch64-macos): tbz x0, #3
// ASM(aarch64-macos): csel x0, x0, x1, gt
// ASM(aarch64-macos): csel x0, x0, x1, lt
// ASM(aarch64-macos): csinc x0, x1, x2, ne
// ASM(x86_64-macos): movq %rdx, (%rdi,%rsi,8)
// ASM(x86_64-macos): movq (%rdi,%rsi,8), %rax
// ASM(x86_64-macos): leaq (%rdi,%rsi), %rax
// ASM(x86_64-macos): testq $8, %rdi
// ASM(x86_64-macos): cmovg
// ASM(x86_64-macos): cmovl
// ASM(x86_64-linux): movq %rdx, (%rdi,%rsi,8)
// ASM(x86_64-linux): movq (%rdi,%rsi,8), %rax
// ASM(x86_64-linux): leaq (%rdi,%rsi), %rax
// ASM(x86_64-linux): testq $8, %rdi
// ASM(x86_64-linux): cmovg
// ASM(x86_64-linux): cmovl
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
}

// Indexed stores and loads: p[i] with an 8-byte element.
fn set(p: *mut i64, i: i64, value: i64) {
    unsafe { (*p.add(i as usize)) = value; }
}

fn get(p: *mut i64, i: i64) -> i64 {
    unsafe { (*p.add(i as usize)) }
}

// c + a * b and c - a * b.
fn fused(a: i64, b: i64, c: i64) -> i64 {
    c + a * b
}

fn fused_sub(a: i64, b: i64, c: i64) -> i64 {
    c - a * b
}

// x + (y << 4) (also x + y on x86-64: a lea), and the fields
// (x >> 4) & 7 and (x >> 1) & 3.
fn shifted(x: i64, y: i64) -> i64 {
    x + (y << 4)
}

fn sum(x: i64, y: i64) -> i64 {
    x + y
}

fn field(x: u64) -> u64 {
    (x >> 4) & 7
}

fn field2(x: u64) -> u64 {
    (x >> 1) & 3
}

// A branch on one bit.
fn bit(x: i64) -> i64 {
    if (x & 8) != 0 {
        return 25;
    }
    x + 1
}

// Selects: the larger, the smaller, and c ? a : b + 1.
fn larger(a: i64, b: i64) -> i64 {
    if a > b { a } else { b }
}

fn smaller(a: i64, b: i64) -> i64 {
    if a < b { a } else { b }
}

fn pick(c: bool, a: i64, b: i64) -> i64 {
    if c { a } else { b + 1 }
}

fn main() -> i32 {
    let p = unsafe { malloc(800) as *mut i64 };
    let store = unsafe { set };
    let load = unsafe { get };
    unsafe {
        store(p, 7i64, 30i64);
        printf(c"%ld %ld\n", load(p, 7i64), (*p.add(7)));
    }
    let f = fused;
    let g = fused_sub;
    unsafe { printf(c"%ld %ld\n", f(10i64, 100i64, 35i64), g(10i64, 100i64, 35i64)); }
    let sh = shifted;
    let s = sum;
    let x = field;
    let y = field2;
    unsafe {
        printf(c"%ld %lu %lu\n", sh(13i64, 3i64), x(0x7f), y(0x7f) + (s(1i64, 2i64) - 3) as u64);
    }
    let b = bit;
    unsafe { printf(c"%ld %ld\n", b(8i64), b(1i64)); }
    let l = larger;
    let m = smaller;
    let k = pick;
    unsafe {
        printf(c"%ld %ld %ld\n", l(17i64, -3i64), m(17i64, -3i64), k(false, 5i64, 0i64));
        printf(c"%ld %ld\n", k(true, 42i64, 7i64), k(false, 42i64, 42i64));
    }
    0
}
