// XFAIL: RT-467b: (RT-467, an array element) `arr[0].bump()` on `let mut arr = [1500000000, 1];`, then `let b: i64 = arr[0];`, runs i32's `bump(&mut self)`: -O0 panics on the overflow, -O2 prints -1294967296; rustc prints 3000000000 (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 3000000000
trait Bump { fn bump(&mut self); }
impl Bump for i32 { fn bump(&mut self) { *self = *self * 2; } }
impl Bump for i64 { fn bump(&mut self) { *self = *self * 2; } }

fn main() {
    let mut arr = [1500000000, 1];
    arr[0].bump();
    let b: i64 = arr[0];
    println("{}", b);
}
