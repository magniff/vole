// (0.29) What is not Copy takes the element-by-element path of
// Vec::extend_from_slice, resize, [T]::fill and clone_from_slice: each
// element is cloned once and dropped once (the counts below; and
// --check-alloc, which every std case runs under, finds a String freed
// twice or never).
// The std item(s): std::vec Vec::extend_from_slice, Vec::resize.
// EXPECT: extend clones 3 drops 0
// EXPECT: resize clones 7 drops 0
// EXPECT: shrink clones 7 drops 7
// EXPECT: fill clones 8 drops 9
// EXPECT: clone_from clones 10 drops 11
// EXPECT: end clones 10 drops 16
// EXPECT: strings ["a", "bb", "a", "bb", "ccc", "ccc", "ccc"]
// EXPECT: filled ["z", "z", "z", "z", "z", "z", "z"]
// EXPECT: copied ["q", "r", "z", "z", "z", "z", "z"]
use std::cell::Cell;
use std::string::String;
use std::vec::Vec;

struct Counted<'a> {
    clones: &'a Cell<i64>,
    drops: &'a Cell<i64>,
}

impl<'a> Clone for Counted<'a> {
    fn clone(&self) -> Counted<'a> {
        self.clones.set(self.clones.get() + 1);
        Counted { clones: self.clones, drops: self.drops }
    }
}

impl<'a> Drop for Counted<'a> {
    fn drop(&mut self) {
        self.drops.set(self.drops.get() + 1);
    }
}

fn main(gpa: Gpa) {
    let clones = Cell::new(0i64);
    let drops = Cell::new(0i64);
    {
        let src = [
            Counted { clones: &clones, drops: &drops },
            Counted { clones: &clones, drops: &drops },
            Counted { clones: &clones, drops: &drops },
        ];
        let mut v: Vec<Counted, Gpa> = Vec::new_in(gpa);
        v.extend_from_slice(&src);
        println("extend clones {} drops {}", clones.get(), drops.get());
        v.resize(8, Counted { clones: &clones, drops: &drops });
        println("resize clones {} drops {}", clones.get(), drops.get());
        v.resize(2, Counted { clones: &clones, drops: &drops });
        println("shrink clones {} drops {}", clones.get(), drops.get());
        v.fill(Counted { clones: &clones, drops: &drops });
        println("fill clones {} drops {}", clones.get(), drops.get());
        v.clone_from_slice(&src[1..]);
        println("clone_from clones {} drops {}", clones.get(), drops.get());
    }
    println("end clones {} drops {}", clones.get(), drops.get());

    let two = [String::from_in("a", gpa), String::from_in("bb", gpa)];
    let mut s: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    s.extend_from_slice(&two);
    s.extend_from_within(..);
    s.resize(7, String::from_in("ccc", gpa));
    println("strings {:?}", s);
    s.fill(String::from_in("z", gpa));
    println("filled {:?}", s);
    let qr = [String::from_in("q", gpa), String::from_in("r", gpa)];
    s[..2].clone_from_slice(&qr);
    println("copied {:?}", s);
}
