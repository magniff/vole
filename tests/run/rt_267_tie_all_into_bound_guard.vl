// XFAIL: RT-267: UNSOUND: a result tied to its argument only by a blanket impl's bound (`T: Into<B>`, `where I::Item: Into<B>`, std's `impl<T, U: From<T>> Into<U> for T`) keeps no borrow: `drop(v)` while it lives is accepted, a use after free from safe code (closed by g302bor's tie_all; 0.30.2)
// A guard of the region checker's fallback (places/regions.vl tie_all, 0.30.2,
// g302bor): a bound whose impl the checker does not choose ties every region
// of its subject and arguments. `T: Into<B>` is met by std's blanket `impl<T,
// U: From<T>> Into<U> for T`, and `where I::Item: Into<B>` by the same: the
// result B keeps the borrow of its argument, so each drop is refused (rustc
// E0505). With tie_all made to tie nothing both build, a use after free
// (--check-alloc); no other case caught that plant (review of g302bor).
// ERROR: line 49
// ERROR: line 52
// ERROR-COUNT: 2
// ERROR: error[borrowck.move_borrowed]
// FLAGS: --check-alloc
struct Wr<'a> {
    r: &'a i64,
}

impl<'a> From<&'a i64> for Wr<'a> {
    fn from(r: &'a i64) -> Wr<'a> {
        Wr { r: r }
    }
}

fn conv<T: Into<B>, B>(t: T) -> B {
    t.into()
}

fn first<I: Iterator, B>(it: I) -> Option<B>
    where
        I::Item: Into<B>,
{
    let mut it = it;
    match it.next() {
        Some(x) => Some(x.into()),
        None => None,
    }
}

fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v
}

fn main(gpa: Gpa) {
    let v = mk(gpa);
    let k: Wr = conv(&v[0]);
    drop(v);
    let w = mk(gpa);
    let o: Option<Wr> = first(w.iter());
    drop(w);
    println("{} {}", *k.r, *o.unwrap().r);
}
