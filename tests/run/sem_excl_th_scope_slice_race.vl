// two scoped threads write one array through inout slices: a data race
// ERROR: error[borrowck.mut_twice]
// ERROR: line 10, column 72
use std::thread;
fn bump(s: &mut [i64]) { for i in 0..1000000 { s[0] += 1; } }

fn main() {
    let mut a = [0i64, 0];
    thread::scope(|s| ({ let sc = s; {
        let x = sc.spawn(|| { bump(&mut a[..]); 0 }); let y = sc.spawn(|| { bump(&mut a[..]); 0 });
        x.join().unwrap() + y.join().unwrap()
    } })); println("{}", a[0]);
}
