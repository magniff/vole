// (0.29.0) `var`, `inout`, `sink` and `defer` were keywords of the edition
// 0.28.0 removed; they are ordinary names everywhere a name goes: a
// binding, a parameter, a function, a field, a method, a module's item
// behind a path, a label of a struct literal.

struct Pipe {
    sink: i64,
    var: i64,
}

impl Pipe {
    fn defer(&self, inout: i64) -> i64 {
        self.sink + self.var + inout
    }
}

mod words {
    pub fn var(sink: i64) -> i64 {
        sink * 2
    }

    pub const inout: i64 = 5;
}

fn sink(var: &mut i64, defer: i64) {
    *var += defer;
}

fn main() -> i32 {
    let var = 1;
    let mut inout = 2;
    let defer = 4;
    sink(&mut inout, defer);
    let p = Pipe { sink: var, var: inout };
    println("{} {} {}", p.defer(defer), words::var(p.sink), words::inout);
    0
}
// EXPECT: 11 2 5
