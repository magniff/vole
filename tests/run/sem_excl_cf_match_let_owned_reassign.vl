// EDITION: rust
// matching an owned local by value moves its payload out (5.3): reassigning the scrutinee is fine
// EXPECT: 1
use std::alloc::Allocator; enum E<A: Allocator> { A(Vec<i64, A>), B }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let mut e = E::A(v);
    match e { E::A(w) => { e = E::B; println("{}", w.len()); } E::B => {} }
}
