// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc TypedArena::len.
// EXPECT: 3
use std::alloc::TypedArena;

fn main(gpa: Gpa) {
    let ta = TypedArena::new_in(gpa);
    ta.alloc(1i64);
    ta.alloc_extend([2i64, 3]);
    println("{}", ta.len());
}
