// XFAIL: RT-212: (fuller form of R302D-34) with `Tag` implemented for W (1) and &W (2) and T = &W, a generic impl's method runs W's impl through a local copy, a closure, a match binding, a call's result, an index, `Tag::tag(&self.v)` and even `<T as Tag>::tag(&self.v)`; a free fn the same for a tuple field (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_034e_generic_instance_receivers_and_qualified_paths.rs.txt).
// vole prints `[1, 1, 1, 1, 2, 1, 1, 1] 0` (only `(&self.v).tag()` is right) and
// `[2, 2, 2] [1, 1, 1, 2] [2, 2]`: in `free_tuple`, `let x = p.0; x.tag()`,
// `Tag::tag(&p.0)` and `<T as Tag>::tag(&p.0)` give 1, `<T as Tag>::tag(&x)` 2.
// A qualified path naming T is resolved by the argument's instance type. Since
// v0.28.0 (the release build; g302probe the same).
// EXPECT: [2, 2, 2, 2, 2, 2, 2, 2] 0
// EXPECT: [2, 2, 2] [2, 2, 2, 2] [2, 2]
struct W {
    k: i64,
}

trait Tag {
    fn tag(&self) -> i64;
}

impl Tag for W {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a W {
    fn tag(&self) -> i64 {
        2
    }
}

struct Rep<T> {
    v: T,
    vs: [T; 1],
}

impl<T: Tag + Copy> Rep<T> {
    fn get(&self) -> T {
        self.v
    }

    fn all(&self) -> [i64; 8] {
        let local = self.v;
        let c = || self.v.tag();
        let opt = Some(self.v);
        let o = match opt {
            Some(x) => x.tag(),
            None => 0,
        };
        [
            local.tag(),
            c(),
            o,
            self.get().tag(),
            (&self.v).tag(),
            self.vs[0].tag(),
            Tag::tag(&self.v),
            <T as Tag>::tag(&self.v),
        ]
    }
}

fn free_param<T: Tag>(t: T) -> [i64; 3] {
    [t.tag(), Tag::tag(&t), <T as Tag>::tag(&t)]
}

fn free_tuple<T: Tag + Copy>(p: (T, i64)) -> [i64; 4] {
    let x = p.0;
    [x.tag(), Tag::tag(&p.0), <T as Tag>::tag(&p.0), <T as Tag>::tag(&x)]
}

fn free_ref<T: Tag>(t: &T) -> [i64; 2] {
    [T::tag(t), <T as Tag>::tag(t)]
}

fn main() {
    let w = W { k: 0 };
    let r = Rep { v: &w, vs: [&w] };
    println("{:?} {}", r.all(), w.k);
    println("{:?} {:?} {:?}", free_param(&w), free_tuple((&w, 0i64)), free_ref(&&w));
}
