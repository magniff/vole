// EDITION: rust
// RULE: F19.6
// (0.27.4) A rust-edition `static mut` is reached only in `unsafe`, so a
// spawned closure may reach it, directly or through what it calls, as in
// rustc: no sync.global. A `static`'s read needs nothing.
// EXPECT: 6 2 12
use std::thread;

static N: i64 = 5;
static mut M: i64 = 1;
static mut HITS: i64 = 0;

fn bump(by: i64) {
    let p = &raw mut HITS;
    // UNSAFE: a write to a static mut, the case's subject
    // SAFETY: one thread at a time writes HITS: each is joined before the next starts
    unsafe {
        *p += by;
    }
}

fn main(gpa: Gpa) {
    let a = thread::spawn_in(|| N + 1, gpa).join().unwrap();
    // UNSAFE: a read of a static mut, the case's subject
    // SAFETY: no thread writes M
    let b = thread::spawn_in(|| unsafe { M } + 1, gpa).join().unwrap();
    thread::spawn_in(|| bump(5), gpa).join().unwrap();
    thread::spawn_in(|| bump(7), gpa).join().unwrap();
    // UNSAFE: a read of a static mut, the case's subject
    // SAFETY: the threads that wrote HITS are joined
    let c = unsafe { HITS };
    println("{} {} {}", a, b, c);
}
