// XFAIL: RT-185: a method's type parameter named like its impl's (`impl<T> W<T> { fn m<T>(..) }`) is accepted, and the method's T is ignored: `w.m::<i64>(7u8)` builds and measures u8 (0.30.2)
// rustc: `error[E0403]: the name `T` is already used for a generic parameter
// in this item's generic parameters` at line 18 (twin:
// r302d_015_method_param_shadows_impl_param.rs.txt). vole builds it and prints 1:
// every T in m is the impl's (u8), the turbofish `::<i64>` is dropped without a
// word; `w.m(5i64)` is refused with `cannot infer type parameter 'T' of 'W::m'`
// and `expected 'u8', got 'i64'`. R302D-14 is the default-method copy's form of
// the same name capture. Since v0.28.0.
// ERROR: line 18
// ERROR-COUNT: 1
use std::mem::size_of;

struct W<T> {
    t: T,
}

impl<T> W<T> {
    fn m<T>(&self, t: T) -> usize {
        size_of::<T>()
    }
}

fn main() {
    let w = W { t: 1u8 };
    println("{}", w.m::<i64>(7u8));
}
