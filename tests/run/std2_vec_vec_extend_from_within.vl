// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::extend_from_within.
// EXPECT: [1, 2, 3, 2, 3]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3], gpa);
    v.extend_from_within(1..);
    println("{:?}", v);
}
