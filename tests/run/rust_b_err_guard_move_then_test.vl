// EDITION: rust
// RULE: M1
// (0.27.1) A guard moves the scrutinee and fails: the next arm's test reads
// the moved value (vole tests arm by arm; rustc decides every discriminant
// before any guard, L8).
// RUSTC: accepts L8 rustc tests every discriminant before the guards
// ERROR: error[borrowck.use_moved]
// ERROR: line 23, column 9
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct N {
    v: i64,
}

fn main() {
    let o: Option<N> = Some(N { v: 1 });
    match o {
        Some(_) if {
            drop(o);
            false
        } => println("a"),
        None => println("none"),
        Some(_) => println("some"),
    }
}
