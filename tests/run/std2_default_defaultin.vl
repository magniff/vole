// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::default DefaultIn.
// EXPECT: [] 0
use std::default::{Default, DefaultIn};
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = DefaultIn::default_in(gpa);
    let n: i64 = DefaultIn::default_in(gpa);
    println("{:?} {}", v, n);
}
