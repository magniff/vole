// places IR, family 793e4b8c: arguments that may return, temporaries per statement
// (0.25.2.1) An owned argument whose expression may return, given to a
// let parameter of a call whose own result is `?`'d: `dev.count(
// dev.make(7)?, 8)?` (the report: `dev.compute_pipeline(dev.shader_wgsl(
// SRC)?, "integrate")?` found no entry point) lent the argument by the
// address of the inner `?`'s value, dropped before the call; a plain
// temporary there, `dev.count(dev.mk(7), 8)?`, leaked. A match whose arm
// returns, `match dev.make(7) { Ok(s) => s, Err(e) => return Err(e) }`,
// lent its arm's binding, dropped with the arm, with or without the outer
// `?`. The sweep: own_arg_temp_sweep_{let,sink,inout} (tools/sinksweep/argsweep.py).
// FLAGS: --check-alloc
// EXPECT: ok 22
// EXPECT: free ok 2
// EXPECT: plain ok 3
// EXPECT: match ok 2
// EXPECT: match, no ? ok 2
// EXPECT: if let ok 2
// EXPECT: in an if ok 2
// EXPECT: err -1
// PLACES: fn Dev::make
// PLACES: drop(_9) [removed]
// PLACES: drop(_4) [removed]
// PLACES: fn Dev::mk
// PLACES: drop(_3) [removed]
// PLACES: fn run
// PLACES: drop(_5) [removed]
// PLACES: drop(_7) [removed]
// PLACES: drop(_5) [removed]
// PLACES: drop(_4) [kept]
// PLACES: drop(_4) [kept]
// PLACES: drop(_16) [removed]
// PLACES: drop(_18) [removed]
// PLACES: drop(_16) [removed]
// PLACES: drop(_15) [kept]
// PLACES: drop(_15) [kept]
// PLACES: fn free
// PLACES: drop(_5) [removed]
// PLACES: drop(_7) [removed]
// PLACES: drop(_5) [removed]
// PLACES: drop(_4) [kept]
// PLACES: drop(_4) [kept]
// PLACES: fn plain
// PLACES: drop(_4) [kept]
// PLACES: drop(_4) [kept]
// PLACES: fn matched
// PLACES: drop(_7) [removed]
// PLACES: drop(_8) [removed]
// PLACES: drop(_5) [removed]
// PLACES: drop(_8) [kept]
// PLACES: drop(_5) [removed]
// PLACES: drop(_8) [kept]
// PLACES: drop(_5) [removed]
// PLACES: fn matched_no_q
// PLACES: drop(_7) [kept]
// PLACES: drop(_4) [removed]
// PLACES: drop(_6) [removed]
// PLACES: drop(_7) [removed]
// PLACES: drop(_4) [removed]
// PLACES: fn if_let
// PLACES: drop(_8) [removed]
// PLACES: drop(_5) [kept]
// PLACES: drop(_7) [removed]
// PLACES: drop(_8) [kept]
// PLACES: drop(_5) [removed]
// PLACES: drop(_8) [kept]
// PLACES: drop(_5) [removed]
// PLACES: fn in_if
// PLACES: drop(_8) [removed]
// PLACES: drop(_8) [kept]
// PLACES: drop(_5) [removed]
// PLACES: drop(_7) [removed]
// PLACES: drop(_5) [removed]
// PLACES: drop(_8) [removed]
// PLACES: fn leaves
// PLACES: drop(_5) [removed]
// PLACES: drop(_8) [removed]
// PLACES: drop(_5) [removed]
// PLACES: drop(_4) [kept]
// PLACES: drop(_4) [kept]

use std::Gpa;

struct Sh {
    names: Vec<i64>,
}

struct Dev {
    gpa: Gpa,
}

impl Dev {
    fn make(self, n: i64) -> Result<Sh, i64> {
        if n < 0 {
            return Err(n);
        }
        var v: Vec<i64> = Vec::new_in(self.gpa);
        v.push(n);
        v.push(n + 1);
        Ok(Sh { names: v })
    }

    fn mk(self, n: i64) -> Sh {
        var v: Vec<i64> = Vec::new_in(self.gpa);
        v.push(n);
        v.push(n + 1);
        v.push(n + 2);
        Sh { names: v }
    }

    fn count(self, s: Sh, want: i64) -> Result<i64, i64> {
        for x in s.names.iter() {
            if x == want {
                return Ok(s.names.len() as i64);
            }
        }
        Err(-1)
    }
}

fn count_free(s: Sh, want: i64) -> Result<i64, i64> {
    for x in s.names.iter() {
        if x == want {
            return Ok(s.names.len() as i64);
        }
    }
    Err(-1)
}

fn run(dev: Dev) -> Result<i64, i64> {
    let a = dev.count(dev.make(7)?, 8)?;
    let s = dev.make(7)?;
    let b = dev.count(s, 8)?;
    Ok(a * 10 + b)
}

fn free(dev: Dev) -> Result<i64, i64> {
    Ok(count_free(dev.make(7)?, 8)?)
}

fn plain(dev: Dev) -> Result<i64, i64> {
    let a = dev.count(dev.mk(7), 8)?;
    Ok(a)
}

fn matched(dev: Dev) -> Result<i64, i64> {
    let a = dev.count(match dev.make(7) { Ok(s) => s, Err(e) => return Err(e) }, 8)?;
    Ok(a)
}

fn matched_no_q(dev: Dev) -> Result<i64, i64> {
    let r = count_free(match dev.make(7) { Ok(s) => s, Err(e) => return Err(e) }, 8);
    r
}

fn if_let(dev: Dev) -> Result<i64, i64> {
    let a = dev.count(if let Ok(s) = dev.make(7) { s } else { return Err(-3) }, 8)?;
    Ok(a)
}

fn in_if(dev: Dev, k: i64) -> Result<i64, i64> {
    dev.count(if k > 0 { dev.make(7)? } else { return Err(-3) }, 8)
}

fn leaves(dev: Dev) -> Result<i64, i64> {
    let a = dev.count(dev.make(-1)?, 8)?;
    Ok(a)
}

fn show(n: str, r: Result<i64, i64>) {
    match r {
        Ok(v) => println("{n}ok {v}"),
        Err(e) => println("{n}err {e}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let dev = Dev { gpa: gpa };
    show("", run(dev));
    show("free ", free(dev));
    show("plain ", plain(dev));
    show("match ", matched(dev));
    show("match, no ? ", matched_no_q(dev));
    show("if let ", if_let(dev));
    show("in an if ", in_if(dev, 1));
    show("", leaves(dev));
    0
}
