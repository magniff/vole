// sem-own (iterator stopgap): m.keys() of owned keys collected.
// ERROR: own.
use std::HashMap;
struct K<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for K<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }
impl Eq for K<Gpa> { fn eq(self, other: K<Gpa>) -> bool { self.id == other.id } }
impl Hash for K<Gpa> { fn hash(self) -> u64 { self.id as u64 } }

fn mk(id: i64, gpa: Gpa) -> K<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); K { id: id, v: v }
}

impl Ord for K<Gpa> { fn cmp(self, other: K<Gpa>) -> i64 { self.id - other.id } }

fn main(gpa: Gpa) {
    var m: HashMap<K<Gpa>, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(mk(1, gpa), 1);
    let c: Vec<K<Gpa>, Gpa> = m.keys().collect_in(gpa);
}
