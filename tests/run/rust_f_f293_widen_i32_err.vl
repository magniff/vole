// RULE: F29.3
// (0.30.1) An i32 computed from integer literals nothing gives a type is
// not widened: rustc types those literals i64 from the use, so the
// arithmetic would differ past i32's range. A sum bound by a `let`, a
// counter a closure changes, an i32 method on untyped literals, a
// product of such a sum, a parse whose type a literal gave, a `let mut`
// whose start is a literal.
// RUSTC-DIFFERS: rustc infers i64 for each of these and accepts them; vole refuses the widening
// ERROR: error[type.widen_i32]: this 'i32' is not widened to 'i64' implicitly
// ERROR: line 30, column 10
// ERROR: line 31, column 10
// ERROR: line 32, column 10
// ERROR: line 33, column 10
// ERROR: line 34, column 10
// ERROR-COUNT: 5
fn take(x: i64) -> i64 {
    x
}

fn count<F: FnMut()>(mut f: F) {
    f();
    f();
}

fn main() {
    let a = [2000000000, 2];
    let s = a[0] + a[0];
    let mut n = 0;
    count(|| n += 1);
    take(s);
    take(n);
    take((7).min(3));
    take(s * 2);
    take("3000000000".parse().unwrap_or(0));
}
