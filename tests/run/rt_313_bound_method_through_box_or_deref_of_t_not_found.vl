// XFAIL: RT-313: in a generic body, a method of T's bound called through a smart pointer to T, `b.tag()` with `b: Box<T, Gpa>`, `&Box<T, Gpa>`, `Arc<T, Gpa>` or a program's `Wrap<T>: Deref<Target = T>`, is "no method 'tag' on type 'Box<T, Gpa>'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt): autoderef reaches T, whose
// bound has the method. vole finds it for a concrete `Box<W, Gpa>` and
// `Wrap<W>` (lines 54, 60), and `(*b).tag()` builds; only a deref step
// that ends at a type parameter misses the bound. v0.28.0 to v0.30.1 the
// same.
// EXPECT: 4 4 4 1 2 3 3
use std::ops::Deref;
use std::sync::Arc;

trait Tag {
    fn tag(&self) -> i64;
}

struct W {
    k: i64,
}

impl Tag for W {
    fn tag(&self) -> i64 {
        self.k
    }
}

struct Wrap<T> {
    t: T,
}

impl<T> Deref for Wrap<T> {
    type Target = T;

    fn deref(&self) -> &T {
        &self.t
    }
}

fn boxa<T: Tag>(b: Box<T, Gpa>) -> i64 {
    b.tag()
}

fn boxr<T: Tag>(b: &Box<T, Gpa>) -> i64 {
    b.tag()
}

fn arca<T: Tag>(b: Arc<T, Gpa>) -> i64 {
    b.tag()
}

fn wra<T: Tag>(b: Wrap<T>) -> i64 {
    b.tag()
}

fn main(gpa: Gpa) {
    let b = Box::new_in(W { k: 4 }, gpa);
    let c = b.tag();
    let d = boxr(&b);
    let e = boxa(b);
    let f = arca(Arc::new_in(W { k: 1 }, gpa));
    let g = wra(Wrap { t: W { k: 2 } });
    let h = Wrap { t: W { k: 3 } };
    let i = h.tag();
    println("{} {} {} {} {} {} {}", c, d, e, f, g, i, (*h).tag());
}
