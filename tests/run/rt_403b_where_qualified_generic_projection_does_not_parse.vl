// XFAIL: RT-403: (RT-403's mechanism, a generic impl) `impl<T> Tr for S<T> where <Bx<T> as H>::Item: Copy` does not parse ("parser error: expected '{', got '<'"); rustc accepts it and prints the EXPECT line (0.30.2)
// From the review of g302oblig-m2 (form f269as, here with an impl of H
// for Bx<T> and no second trait). Since v0.30.1 at least; the release
// build the same. Sibling: rt_403 (`<Self as H>::Out`).
// EXPECT: 1
trait H {
    type Item;
}

trait Tr {
    fn f(&self) -> i64;
}

struct S<T> {
    t: T,
}

struct Bx<T> {
    t: T,
}

impl<T> H for Bx<T> {
    type Item = T;
}

impl<T> Tr for S<T> where <Bx<T> as H>::Item: Copy {
    fn f(&self) -> i64 {
        1
    }
}

fn main() {
    let s = S { t: 5i64 };
    println("{}", s.f());
}
