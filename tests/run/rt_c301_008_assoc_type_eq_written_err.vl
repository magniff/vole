// RULE: F8.1, F11.3
// `T::Out` written under `T: A<Out = i64> + B<Out = bool>`: rustc E0221. A guard: the reading of `Self::Out` by its trait leaves a written one ambiguous.
// From the gate suite of 0.30.2 (rt_c301_008_qualified_assoc_type_eq after the g302bor2 merge): `Self::Out` in trait B's declaration is `<Self as B>::Out` however the signature is read; places::regions::instance_type read a virtual function's signature without its trait (resolve::signature_enter) and called it ambiguous between A's and B's `Out`.
// ERROR: ambiguous associated type 'Out' in the bounds of 'T'
trait A {
    type Out;
}

trait B {
    type Out;
}

struct S;

impl A for S {
    type Out = i64;
}

impl B for S {
    type Out = bool;
}

fn f<T: A<Out = i64> + B<Out = bool>>(x: T::Out) -> i64 {
    1
}

fn main() {
    println("{}", f::<S>(3));
}
