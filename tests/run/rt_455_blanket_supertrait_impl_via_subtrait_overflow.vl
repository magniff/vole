// XFAIL: RT-455: a blanket impl of a supertrait through its subtrait, `trait Sub: Super` and `impl<T: Sub> Super for T`, with `impl Sub for i64`: `need(41i64)` under `T: Sub` calling `t.up()` is refused with trait.overflow ("'i64: Sub' is not proved: the impls that would prove it need it again, deeper than 32 steps"); rustc accepts the cycle and prints 42 (0.30.2)
// From the re-review of g302bor2 (its form m07_blanket_super_via_sub).
// Since v0.30.1 at least: v0.30.1 crashes on it (bus error, exit 138),
// the release build (38fe466c5) refuses it as above. The form with a
// lifetime-generic type is rt_455b.
// EXPECT: 42
trait Super {
    fn up(&self) -> i64;
}

trait Sub: Super {
    fn down(&self) -> i64;
}

impl<T: Sub> Super for T {
    fn up(&self) -> i64 {
        self.down() + 1
    }
}

impl Sub for i64 {
    fn down(&self) -> i64 {
        *self
    }
}

fn need<T: Sub>(t: T) -> i64 {
    t.up()
}

fn main() {
    println("{}", need(41i64));
}
