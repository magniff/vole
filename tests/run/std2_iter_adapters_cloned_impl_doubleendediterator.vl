// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Cloned::impl DoubleEndedIterator.
// EXPECT: Some("y")

fn main(gpa: Gpa) {
    let x = "x".to_string_in(gpa);
    let y = "y".to_string_in(gpa);
    let s = Vec::from_in([x, y], gpa);
    println("{:?}", s.iter().cloned().next_back());
}
