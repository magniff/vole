// Qualified paths in a closure's body, parameter and result type, a match arm, a statement, an array length and an index (rustc `40 4 3 3`)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): a guard: the first round's build passes.
// EXPECT: 40 4 3 3
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn main() {
    let f = || <<S as A>::Out as B>::make();
    let g = |x: <<S as A>::Out as B>::E| -> <<S as A>::Out as B>::E { x + <S as A>::C };
    let m = match 1 {
        1 => <S as A>::C,
        _ => <<S as A>::Out as B>::D,
    };
    <<S as A>::Out as B>::make();
    let a = [<S as A>::C; 2];
    let i = a[<<S as A>::Out as B>::D as usize - 1];
    println("{} {} {} {}", f(), g(1), m, i);
}
