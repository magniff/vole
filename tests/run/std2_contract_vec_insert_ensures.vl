// EDITION: rust
// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): Vec::insert's `ensures self.len() == old(self.len()) + 1`, exercised.
// EXPECT: [2, 1]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.insert(0, 1);
    v.insert(0, 2);
    println("{:?}", v);
}
