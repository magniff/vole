// 0.26.2: the check-time GPU lints (gpu.entry, gpu.layout, gpu.usage,
// gpu.unwritten) say nothing when the function does not show the fact:
// a buffer from a parameter, a reassigned buffer, a buffer passed to a
// function, entries not an array literal, a usage not constant, a
// shader from a parameter. Compiled with --deny-warnings: any of them
// fails the case.
// REQUIRES: metal
// EXPECT: built
use std::gpu;
use std::gpu::BufferUsage;

embed wgsl K {
    @group(0) @binding(0) var<uniform> params: vec4<f32>;
    @group(0) @binding(1) var<storage, read_write> cells: array<u32>;

    @compute @workgroup_size(64)
    fn evolve(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] = cells[id.x] + u32(params.x);
    }
}

// a buffer from a parameter: written by the caller, maybe
fn from_param(dev: gpu::Device, params: gpu::Buffer) -> Result<gpu::BindGroup, gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    let cells = dev.buffer(256, BufferUsage::STORAGE);
    Ok(dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, params), gpu::bind(1, cells)][..]))
}

// a reassigned buffer: the lint follows one value
fn reassigned(dev: gpu::Device) -> Result<gpu::BindGroup, gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    var params = dev.buffer(16, BufferUsage::UNIFORM);
    params = dev.buffer(16, BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let cells = dev.buffer(256, BufferUsage::STORAGE);
    Ok(dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, params), gpu::bind(1, cells)][..]))
}

fn fill(queue: inout gpu::Queue, b: gpu::Buffer) {
    queue.write_buffer(b, 0, "0123456789abcdef");
}

// a buffer passed to a function: that function may write it
fn passed(dev: gpu::Device, queue: inout gpu::Queue) -> Result<gpu::BindGroup, gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    let params = dev.buffer(16, BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    fill(&queue, params);
    let cells = dev.buffer(256, BufferUsage::STORAGE);
    Ok(dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, params), gpu::bind(1, cells)][..]))
}

// entries not an array literal at the call: not checked here
fn entries_var(dev: gpu::Device, queue: inout gpu::Queue) -> Result<gpu::BindGroup, gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    let params = dev.buffer(16, BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    queue.write_buffer(params, 0, "0123456789abcdef");
    let cells = dev.buffer(256, BufferUsage::STORAGE);
    let entries = [gpu::bind(0, cells), gpu::bind(1, params)];
    Ok(dev.bind_group(pipe.bind_layout(0), entries[..]))
}

// a usage not constant: its flags are not known here
fn usage_param(dev: gpu::Device, queue: inout gpu::Queue, usage: u32) -> Result<gpu::BindGroup,
    gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    let params = dev.buffer(16, usage);
    queue.write_buffer(params, 0, "0123456789abcdef");
    let cells = dev.buffer(256, usage);
    Ok(dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, params), gpu::bind(1, cells)][..]))
}

// a shader from a parameter: its entry points are not known here
fn shader_param(dev: gpu::Device, shader: gpu::Shader) -> Result<gpu::ComputePipeline, gpu::Error> {
    dev.compute_pipeline(shader, "evolv")
}

fn main() -> i32 {
    println("built");
    0
}
