// RULE: D8.2
// (0.28.0) rustc's temporary lifetime extension: a `let` whose
// initializer is `&temp`, or a tuple, array or braced struct of one,
// keeps the temporary to the end of the block. A temporary used only
// within its statement is fine without it.
// EXPECT: hello 5 hello 2
use std::alloc::Allocator;

struct P<'a, A: Allocator> {
    s: &'a String<A>,
}

fn main(gpa: Gpa) {
    let a = &String::from_in("hello", gpa);
    let (b, n) = (&String::from_in("hello", gpa), 5);
    let p = P { s: &String::from_in("hello", gpa) };
    let k = String::from_in("hi", gpa).as_str().len();
    println("{} {} {} {}", a, n, p.s, k);
    let _ = b;
}
