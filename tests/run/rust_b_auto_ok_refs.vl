// EDITION: rust
// RULE: AT1
// (0.27.2) `&T` is Send and Sync when `T` is Sync; `&mut T` is Send when
// `T` is Send, Sync when `T` is Sync; a slice view by its elements.
// EXPECT: 1 2 6
fn send<T: Send>(t: T) -> T {
    t
}

fn sync<T: Sync>(t: T) -> T {
    t
}

fn main() {
    let a = 1;
    let mut b = 2;
    let v = [1, 2, 3];
    let r = send(&a);
    let m = sync(send(&mut b));
    let s = send(&v[..]);
    let mut sum = 0;
    for x in s {
        sum += *x;
    }
    println("{} {} {}", *r, *m, sum);
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
