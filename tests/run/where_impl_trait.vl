// 0.26.2: `where` is sugar for inline bounds (on a fn, an impl, a struct,
// an enum and a trait, mixed with inline ones; a method's `where` may bound
// the impl's parameters), and argument-position `impl Trait` a hidden type
// parameter (`impl Fn`, `inout impl FnMut`; a turbofish names only the
// written parameters).
// EXPECT: 1 two
// EXPECT: 3+4.5
// EXPECT: 42
// EXPECT: 6
// EXPECT: 1 b
// EXPECT: 9: 1
// EXPECT: u
// EXPECT: 7
// EXPECT: 1
// EXPECT: 5
// EXPECT: 3
use std::Display;

trait Named<T> where T: Copy {
    fn name(self) -> T;
}

trait Twice {
    fn twice<U>(self, u: U) -> i64 where U: Copy;
}

struct Pair<A, B> where A: Display, B: Display { a: A, b: B }

enum Either<L, R> where L: Display { Left(L), Right(R) }

impl<A, B> Pair<A, B> where A: Display, B: Display {
    fn show(self) {
        println("{} {}", self.a, self.b);
    }

    fn tag<C>(self, c: C) where C: Display, A: Copy {
        println("{c}: {}", self.a);
    }
}

struct N { v: i64 }

impl Named<i64> for N {
    fn name(self) -> i64 { self.v }
}

impl Twice for N {
    fn twice<U>(self, u: U) -> i64 where U: Copy {
        self.name() * 2 - 7
    }
}

fn show_all<T>(x: T, y: impl Display) where T: Display + Copy {
    println("{x} {y}");
}

fn both(a: impl Display, b: impl Display) {
    println("{a}+{b}");
}

fn apply(f: impl Fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn count_up(f: inout impl FnMut(i64), n: i64) {
    for i in 0..n {
        f(i);
    }
}

fn pick<T: Display>(t: T, u: impl Display) -> T {
    println("{u}");
    t
}

fn main() -> i32 {
    show_all(1, "two");
    both(3, 4.5);
    println(apply(|x| x * 2, 21));
    var total = 0;
    var add = |i: i64| { total += i; };
    count_up(&add, 4);
    println(total);
    let p = Pair { a: 1, b: "b" };
    p.show();
    p.tag(9);
    let t = pick::<i64>(7, "u");
    println(t);
    let e: Either<i64, i64> = Either::Left(1);
    match e { Either::Left(l) => println(l), Either::Right(r) => println(r) }
    println(N { v: 5 }.name());
    println(N { v: 5 }.twice(1));
    0
}
