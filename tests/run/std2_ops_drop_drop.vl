// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops Drop::drop.
// EXPECT: drop 2
// EXPECT: after
use std::ops::Drop;

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main() {
    let n = Noisy { id: 2 };
    drop(n);
    println("after");
}
