// Fixed in 0.30.2: RT-298b: (RT-298's mechanism, written by the program) `cm(&mut p)` with `p: fn(i64) -> i64` and `fn cm<F: FnMut(i64) -> i64>(mut f: F)`, and `cm(&mut q)` with `q = &mut p`, are refused: "the type '&mut fn(i64) -> i64' does not satisfy the bound 'F: FnMut(i64) -> i64'"; `&mut F` is FnMut where F is, and rustc prints 6 twice (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// EXPECT: 6
// EXPECT: 6
fn dbl(x: i64) -> i64 {
    x * 2
}

fn cm<F: FnMut(i64) -> i64>(mut f: F) -> i64 {
    f(3)
}

fn main() {
    let mut p: fn(i64) -> i64 = dbl;
    println("{}", cm(&mut p));
    let mut q = &mut p;
    println("{}", cm(&mut q));
}
