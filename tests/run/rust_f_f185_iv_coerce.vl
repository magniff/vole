// RULE: F18.5
// (0.30.2) A coercion's target types the integer variables under the
// value's reference, as rustc's coercions unify the pointee: `&a` of an
// array of literals where `&[u8]` goes, `&n` where `*const i64` goes, and
// `s.get(1)` (`I::Output` of the usize the one `SliceIndex` impl selects).
// (A cast is no such place: `&m as *const u16` is rustc's E0606.)
// EXPECT: 250 4294967296 Some(20)
fn main() {
    let a = [1, 2, 250];
    let s: &[u8] = &a;
    let n = 4294967296;
    let q: *const i64 = &n;
    let t: &[i64] = &[10, 20, 30];
    println("{} {} {:?}", s[2], unsafe { *q }, t.get(1));
}
