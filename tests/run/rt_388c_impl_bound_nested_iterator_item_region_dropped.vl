// From the review of g302bor2 (form A/a04d). Since v0.30.1 at least; the
// release build the same. rustc E0597 (`v` does not live long enough) at
// the borrow (the rustc twin of this file). vole builds it and prints 5;
// the program reads no freed memory (g returns &FIVE), but the borrow the
// bound requires to be 'static is not. Siblings: rt_388, rt_388b (use
// after free).
// ERROR: line 46
trait Tr {
    fn g(self) -> &'static i64;
}

struct H<'a, I> {
    it: I,
    w: &'a i64,
}

impl<'a, I: Iterator<Item = &'a i64>> Tr for H<'a, I> {
    fn g(self) -> &'static i64 {
        &FIVE
    }
}

struct Stat {
    n: i64,
}

static FIVE: i64 = 5;

impl Iterator for Stat {
    type Item = &'static i64;

    fn next(&mut self) -> Option<&'static i64> {
        None
    }
}

fn need<Z: Tr>(z: Z) -> &'static i64 {
    z.g()
}

fn main(gpa: Gpa) {
    let mut keep: &'static i64 = &FIVE;
    {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        keep = need(H { it: Stat { n: 0 }, w: &v[0] });
    }
    println("{}", *keep);
}
