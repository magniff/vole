// FLAGS: -O2
// `let a = 2000000000;` then `(|| a + a)()` passed to `take(x: i64)`:
// rustc types `a` i64 from the use and prints 4000000000. vole computes
// `a + a` in i32 inside the closure and widens the result: -294967296 at
// -O2 (a panic at -O0). type.widen_i32 does not see it: the widening is
// made inside the closure's body.
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let s = (|| a + a)();
    println("{}", take(s));
}
