// EDITION: rust
// RULE: F20.7
// (0.28.0) `g[i]` of a type that has Deref and no Index is `(*g)[i]`, as
// rustc's autoderef of an index's base: a MutexGuard<Vec<..>>, an Arc, a
// Box of an array, a struct with its own Deref (to a Vec, to a slice), and
// each through a reference. It was "cannot index type".
// EXPECT: 7 2 6
// EXPECT: 14 5 9
// EXPECT: 5
// EXPECT: 3
// EXPECT: 8 2
use std::alloc::Allocator;
use std::ops::{Deref, DerefMut};
use std::sync::{Arc, Mutex};

struct Wrap<A: Allocator> {
    v: Vec<i64, A>,
}

impl<A: Allocator> Deref for Wrap<A> {
    type Target = Vec<i64, A>;

    fn deref(&self) -> &Vec<i64, A> {
        &self.v
    }
}

impl<A: Allocator> DerefMut for Wrap<A> {
    fn deref_mut(&mut self) -> &mut Vec<i64, A> {
        &mut self.v
    }
}

struct Three {
    a: [u8; 3],
}

impl Deref for Three {
    type Target = [u8];

    fn deref(&self) -> &[u8] {
        &self.a[..]
    }
}

fn first(g: &Wrap<Gpa>) -> i64 {
    g[0]
}

fn bump(g: &mut Wrap<Gpa>) {
    g[0] += 10;
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    v.push(5);
    v.push(6);
    let m = Mutex::new(v.clone());
    {
        let mut g = m.lock().unwrap();
        g[0] = 7;
        g[1] += 1;
        let tail = &g[1..];
        println("{} {} {}", g[0], tail.len(), tail[0]);
    }
    let mut w = Wrap { v: v.clone() };
    w[2] = 9;
    bump(&mut w);
    println("{} {} {}", first(&w), w[1], w[2]);
    let r = Arc::new_in(v, gpa);
    println("{}", r[1]);
    let b = Box::new_in([1i64, 2, 3], gpa);
    println("{}", b[2]);
    let t = Three { a: [7, 8, 9] };
    println("{} {}", t[1], t[1..].len());
    0
}
