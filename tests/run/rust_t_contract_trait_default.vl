// RULE: C7.6
// (0.27.3) A trait method's default body with clauses is an impl for C7.1-C7.3
// (C7.4): an impl that does not define it gets the default with its
// clauses, so a call of it checks its requires, at the call, directly and
// through a bound, and its ensures in its wrapper. An impl that defines it
// gets the declaration's clauses as before.
// EXPECT: 4
// EXPECT: 5
// EXPECT: 5
// EXPECT: 9
// EXIT: 101
// STDERR: ensures failed: 'result < 100' of 'S::pick'
trait Pick {
    fn n(&self) -> i64;

    fn pick(&self, i: i64) -> i64
        requires i >= 0
        ensures result < 100
    {
        i + self.n()
    }
}

struct S {
    n: i64,
}

impl Pick for S {
    fn n(&self) -> i64 {
        self.n
    }
}

struct T;

impl Pick for T {
    fn n(&self) -> i64 {
        0
    }

    fn pick(&self, j: i64) -> i64 {
        j
    }
}

struct W<X> {
    x: X,
    k: i64,
}

impl<X> Pick for W<X> {
    fn n(&self) -> i64 {
        self.k
    }
}

fn use_it<P: Pick>(p: &P, i: i64) -> i64 {
    p.pick(i)
}

fn main() {
    let s = S { n: 3 };
    let t = T;
    let w = W { x: 'w', k: 7 };
    println("{}", use_it(&s, 1));
    println("{}", s.pick(2));
    println("{}", use_it(&t, 5));
    println("{}", use_it(&w, 2));
    println("{}", s.pick(200));
}
