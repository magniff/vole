// EDITION: rust
// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_map HashMap::impl Extend<(K, V)>; std::collections::hash_map HashMap::impl Extend<(&K, &V)>.
// EXPECT: 3
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.extend([(1i64, 1i64), (2, 2), (3, 3)]);
    println("{}", m.len());
}
