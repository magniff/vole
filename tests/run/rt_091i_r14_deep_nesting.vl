// (0.30.2, the re-review of g302holes: r91/r14_deep_nesting)
// EXPECT: 6
// EXPECT: 23
// A closure whose result nests an inner closure 18 Options deep.
fn main() {
    let w = [1i64, 2];
    let mk = |y: i64| Some(
        Some(
            Some(
                Some(
                    Some(
                        Some(
                            Some(
                                Some(
                                    Some(
                                        Some(
                                            Some(
                                                Some(
                                                    Some(
                                                        Some(
                                                            Some(
                                                                Some(
                                                                    Some(
                                                                        Some(
                                                                            move |x: i64| x + y))))))))))))))))));
    let g = mk(5)
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap()
        .unwrap();
    println("{}", g(1));
    let s: i64 = w
        .iter()
        .map(
            |y| Some(
                Some(
                    Some(
                        Some(
                            Some(
                                Some(
                                    Some(
                                        Some(
                                            Some(
                                                Some(
                                                    Some(
                                                        Some(
                                                            Some(
                                                                Some(
                                                                    Some(
                                                                        Some(
                                                                            Some(
                                                                                Some(
                                                                                    move |x: i64| x + *y)))))))))))))))))))
        .map(|o| (o
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap())(10))
        .sum();
    println("{s}");
}
