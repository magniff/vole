// sem-own: passing an owned element to a sink parameter moves it out of
// the Vec: own.move_out.
// ERROR: own.move_out
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
fn eat(d: sink D<Gpa>) {}

fn main(gpa: Gpa) {
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(D { id: 1, v: Vec::new_in(gpa) });
    eat(w[0]);
}
