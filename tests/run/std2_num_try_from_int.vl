// The std2 item(s): the integers' TryFrom and TryInto (every pair of i8 ..
// usize); std::num::TryFromIntError and its Display.
// EXPECT: Err(TryFromIntError(PosOverflow)) Err(TryFromIntError(NegOverflow)) Ok(255) Ok(0)
// EXPECT: Ok(-128) Err(TryFromIntError(PosOverflow)) Ok(127) Err(TryFromIntError(NegOverflow))
// EXPECT: Ok(7) true true true
// EXPECT: Ok(4294967295) Err(TryFromIntError(PosOverflow)) Ok(65535) Err(TryFromIntError(PosOverflow))
// EXPECT: out of range integral type conversion attempted
// EXPECT: 300 is too big
use std::num::TryFromIntError;

fn narrow(x: i64) -> Result<u8, TryFromIntError> {
    let r: Result<u8, TryFromIntError> = x.try_into();
    let b = r?;
    Ok(b)
}

fn main() {
    println("{:?} {:?} {:?} {:?}", u8::try_from(300i64), u8::try_from(-1i8), u8::try_from(255u64),
        u8::try_from(0isize));
    println("{:?} {:?} {:?} {:?}", i8::try_from(-128i32), i8::try_from(128u8),
        i8::try_from(127u64), i8::try_from(-129i16));
    println("{:?} {} {} {}", narrow(7), usize::try_from(-3i32).is_err(),
        u64::try_from(i64::MIN).is_err(), i64::try_from(u64::MAX).is_err());
    println("{:?} {:?} {:?} {:?}", u32::try_from(4294967295i64), u32::try_from(4294967296u64),
        u16::try_from(65535usize), i16::try_from(32768u16));
    println("{}", u8::try_from(300i64).unwrap_err());
    match narrow(300) {
        Ok(b) => println("{}", b),
        Err(_) => println("300 is too big"),
    }
}
