// RULE: Z9.6
// (0.27.2) A write through the original `&mut [T]` while its reborrow
// `&mut *s` is live.
fn main() {
    let mut a = [1, 2, 3];
    let s = &mut a[..];
    let t = &mut *s;
    s[0] = 1;
    t[0] = 2;
}
// ERROR: error[borrowck.use_borrowed]
// XFAIL: `&mut *s` of a `&mut [T]` is edition.std_copy until the unsized types (front272 Z9.1)
