// XFAIL: RT-406: a generic fn that is never instantiated, `fn g<X: T>() { let a = X::C; println("g {}", a.k); }` with `trait T { const C: D; }` and D a struct, is refused with places.not_built ("the compiler cannot build this function's places IR ... a compiler bug"); rustc builds it and prints the EXPECT line (0.30.2)
// From the re-review of g302copy-148 (form pre/q10). Since v0.30.1 at
// least; the release build the same. The body is borrow-checked before any
// instance, and the place of `X::C` (an associated constant of a struct
// type, through a type parameter) is not built (inferred from the error).
// Sibling: rt_406b (`[X::C, X::C]`, `a[0].k`).
// EXPECT: ok
struct D {
    k: i64,
}

trait T {
    const C: D;
}

fn g<X: T>() {
    let a = X::C;
    println("g {}", a.k);
}

fn main() {
    println("ok");
}
