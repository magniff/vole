// XFAIL: RT-448b: UNSOUND: (RT-448's mechanism, a fn value) `v.first().map(ki::<&i64>)` with `fn ki<T: Into<&'static i64>>(x: T) -> &'static i64`, then `drop(v)` and a read of the result, is accepted: a use after free; rustc E0597 (`v` does not live long enough) (0.30.2)
// From the review of g302fnval (its form s33_into_static). Since v0.30.1
// at least (the same use after free). RT-421 is a fn value whose bound
// needs 'static through a program trait's type argument; here std's
// Into/From blanket impls.
// FLAGS: --check-alloc
// ERROR: line 15
fn ki<T: Into<&'static i64>>(x: T) -> &'static i64 {
    x.into()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let a = v.first().map(ki::<&i64>);
    drop(v);
    println("{:?}", a);
}
