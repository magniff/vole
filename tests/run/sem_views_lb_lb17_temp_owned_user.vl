// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a view of a loop iteration's temporary receiver (owning a Buf) kept past it
// ERROR: borrowck.dropped_borrowed
use std::alloc::Allocator; struct H<A: Allocator> { b: Vec<u8, A> }
impl H<Gpa> { fn view(&self) -> &[u8] { self.b.as_slice() } }

fn mk(gpa: Gpa, c: u8) -> H<Gpa> {
    let mut b = Vec::<u8, Gpa>::new_in(gpa); b.push(c); b.push(c); H { b: b }
}

fn main(gpa: Gpa) -> i32 {
    let mut keep: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(mk(gpa, b'a' + i as u8).view());
    }
    println("{} {}", str::from_utf8(keep[0usize]).unwrap(), str::from_utf8(keep[2usize]).unwrap());
    0
}
