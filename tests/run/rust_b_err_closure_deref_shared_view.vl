// RULE: D2.7, D19.2
// (0.30.1, RT-33 round 2, F4) `&mut *b` of a captured `b: &[u8]` in a
// closure: rustc's E0596. Before, the closure's body could not be built
// (the copy `*b` made of the capture's use was not rewritten), so it was
// never borrow-checked: check said ok and the literal's bytes were
// written.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*b' as mutable, which is behind a `&` reference
// ERROR: line 14, column 17
// ERROR-COUNT: 1
fn main() {
    let s: &str = "hello";
    let b: &[u8] = s.as_bytes();
    let mut f = || {
        let m = &mut *b;
        m[0] = 0xc3;
    };
    f();
    println("{}", s);
}
