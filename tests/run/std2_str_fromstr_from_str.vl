// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str FromStr::from_str.
// EXPECT: Point { x: 3, y: 4 } true
use std::str::FromStr;

#[derive(Debug)]
struct Point {
    x: i64,
    y: i64,
}

impl FromStr for Point {
    type Err = ();

    fn from_str(s: &str) -> Result<Point, ()> {
        let (a, b) = s.split_once(',').ok_or(())?;
        Ok(Point { x: a.parse().map_err(|_| ())?, y: b.parse().map_err(|_| ())? })
    }
}

fn main() {
    let p: Point = "3,4".parse().unwrap();
    println("{:?} {}", p, Point::from_str("3").is_err());
}
