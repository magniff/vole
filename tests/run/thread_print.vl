use std::thread::JoinHandle; use std::thread;

fn main(gpa: Gpa) {
    let mut hs: Vec<JoinHandle<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    for k in 0..4 {
        hs.push(thread::spawn_in(move || {
            for _ in 0..25 { println("whole {} line abcdefghijklmnopqrstuvwxyz", 7); }
            k
        }, gpa));
    }
    while hs.len() > 0 { hs.pop().unwrap().join().unwrap(); }
    println("done");
}
