// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FoldSeeds::from_u64.
// EXPECT: 6439210812120103500 false
// RUSTC: none (FoldSeeds is foldhash's SharedSeed (the foldhash crate's, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{FixedState, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let mut a = FoldHasher::with_seeds(1, FoldSeeds::from_u64(77));
    a.write_u64(9);
    let mut b = FoldHasher::with_seeds(1, FoldSeeds::from_u64(78));
    b.write_u64(9);
    println("{} {}", a.finish(), a.finish() == b.finish());
}
