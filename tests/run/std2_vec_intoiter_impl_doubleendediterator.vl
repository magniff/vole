// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec IntoIter::impl DoubleEndedIterator.
// EXPECT: Some(3) Some(1) Some(2) None
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut it = Vec::from_in([1, 2, 3], gpa).into_iter();
    println("{:?} {:?} {:?} {:?}", it.next_back(), it.next(), it.next_back(), it.next());
}
