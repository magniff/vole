// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::sources repeat_n.
// EXPECT: ["a", "a"] 0

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = std::iter::repeat_n("a", 2).collect_in(gpa);
    println("{:?} {}", v, std::iter::repeat_n(1i64, 0).count());
}
