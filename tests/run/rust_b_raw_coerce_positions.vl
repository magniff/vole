// RULE: D3.6
// (0.27.7) A `&mut T` place given where a raw pointer goes outside a call
// is reborrowed raw, `&raw mut (*x)`, as an argument is: a function's tail
// and `return`, a `let`'s value, an assigned value, a struct literal's
// field, a write through a pointer. x stays usable after each, as after
// rustc's reborrow. 0.27.6 copied the `&mut` there, which
// `--verify-places` refused (I7). Prints 8 14 14.
// FLAGS: --verify-places
// EXPECT: 8 14 14
struct S {
    p: *mut i64,
}

fn tail(x: &mut i64) -> *mut i64 {
    x
}

fn ret(x: &mut i64, early: bool) -> *mut i64 {
    if early {
        return x;
    }
    *x += 0;
    x
}

fn bump_all(x: &mut i64) -> i64 {
    let a: *mut i64 = x;
    *x += 1;
    let mut b: *mut i64 = a;
    b = x;
    let s = S { p: x };
    let mut c: *mut i64 = b;
    let pc: *mut *mut i64 = &mut c;
    // UNSAFE: the test's raw pointers
    // SAFETY: a, b, s.p and c all point to *x, live; pc points to c; no reference to *x is used across these writes
    unsafe {
        *pc = x;
        *a += 1;
        *b += 1;
        *s.p += 1;
        *c += 1;
    }
    *x += 1;
    *x
}

fn main() {
    let mut v = 1i64;
    let p = tail(&mut v);
    let q = ret(&mut v, true);
    let r = ret(&mut v, false);
    // UNSAFE: the test's raw pointers
    // SAFETY: p, q and r point to v, live; no reference to v is held here
    unsafe {
        *p += 1;
        *q += 1;
        *r += 5;
    }
    let w = v;
    let n = bump_all(&mut v);
    println("{} {} {}", w, v, n);
}
