// XFAIL: RT-411e: (RT-411c with `&Self`) `fn mx<T>(&self, o: &Self, t: T) -> Self` impl'd for i32 and i64, `let c = a.mx(&a, 0u8); let d: i64 = c;` with `let a = 100000;`, runs i32's impl: vole prints 1410065408, rustc 10000000000 (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 10000000000
trait Mx { fn mx<T>(&self, o: &Self, t: T) -> Self; }
impl Mx for i32 { fn mx<T>(&self, o: &i32, t: T) -> i32 { self.wrapping_mul(*o) } }
impl Mx for i64 { fn mx<T>(&self, o: &i64, t: T) -> i64 { *self * *o } }

fn main() {
    let a = 100000;
    let c = a.mx(&a, 0u8);
    let d: i64 = c;
    println("{}", d);
}
