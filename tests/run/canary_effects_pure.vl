// 0.30.1, a canary of the effect checker: #[pure] refuses a function that
// has the effect (planted in leaf) through a call chain three deep, a
// closure, a generic instance, a trait method (direct and through a
// bound), and a C function declared with #[effects(..)] that has it and
// one declared without (unknown C: every effect). canary_effects_ok is the
// same program with nothing planted, which must pass.
// ERROR: [effect]: 'chain3' is #[pure]
// ERROR: [effect]: 'through_closure' is #[pure]
// ERROR: [effect]: 'through_generic' is #[pure]
// ERROR: [effect]: 'through_trait' is #[pure]
// ERROR: [effect]: 'through_dyn_generic' is #[pure]
// ERROR: [effect]: 'through_c_declared' is #[pure]
// ERROR: [effect]: 'through_c_undeclared' is #[pure]
// ERROR-COUNT: 7
extern "C" {
    #[effects(io, alloc(extern), panic, diverge)]
    fn c_declared(x: i64) -> i64;
    fn c_undeclared(x: i64) -> i64;
}

fn leaf() {
    println("io");
}

fn mid() {
    leaf();
}

fn top() {
    mid();
}

#[pure]
fn chain3() {
    top();
}

#[pure]
fn through_closure() {
    let f = || leaf();
    f();
}

fn generic<T: Copy>(x: T) -> T {
    leaf();
    x
}

#[pure]
fn through_generic() {
    let _ = generic(3i64);
}

trait Act {
    fn act(&self);
}

struct A {}

impl Act for A {
    fn act(&self) {
        leaf();
    }
}

#[pure]
fn through_trait() {
    let a = A {};
    a.act();
}

#[pure]
fn through_dyn_generic<T: Act>(t: &T) {
    t.act();
}

#[pure]
fn through_c_declared() {
    // UNSAFE: test. SAFETY: test.
    let _ = unsafe { c_declared(1) };
}

#[pure]
fn through_c_undeclared() {
    // UNSAFE: test. SAFETY: test.
    let _ = unsafe { c_undeclared(1) };
}

fn main() {
    chain3();
    through_closure();
    through_generic();
    through_trait();
    through_dyn_generic(&A {});
    through_c_declared();
    through_c_undeclared();
}
