// EDITION: rust
// Frames larger than the AArch64 immediate offsets: locals far from sp,
// together with spills, struct copies and stack arguments.
// EXPECT: 12 34 56 78 100000 4950
// EXPECT: -20 1 9
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy)] struct Big { a: [i64; 2000], tail: i64 }

fn nine(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> i64 {
    a + b + c + d + e + f + g + h + i
}

fn fill(b: Big) -> i64 {
    b.a[0] + b.a[1999] + b.tail
}

fn main() -> i32 {
    let mut buffer: [u8; 100000] = [0; 100000];
    let mut words: [i64; 5000] = [0i64; 5000];
    buffer[0] = 12;
    buffer[99999] = 34;
    words[0] = 56;
    words[4999] = 78;
    let mut sum: i64 = 0;
    for i in 0..100 {
        words[i as usize] = i;
        sum += words[i as usize];
    }
    unsafe {
        printf(c"%d %d %ld %ld %d %ld\n", buffer[0] as i32, buffer[99999] as i32, 56, words[4999],
            100000, sum);
    }
    let mut big = Big { a: [0i64; 2000], tail: 7 };
    big.a[1999] = 2;
    let copy = big;
    big.tail = 100;
    unsafe {
        printf(c"%ld %ld %ld\n", nine(1, 2, 3, 4, 5, 6, 7, 8, 0) + words[0] - 56,
            fill(copy) - 8, fill(big) - 93);
    }
    0
}
