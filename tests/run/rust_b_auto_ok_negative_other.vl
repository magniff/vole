// EDITION: rust
// RULE: AT2
// (0.27.2) A vouch of one auto trait leaves the other structural:
// `impl !Send for Token {}` and `Token` is still Sync.
// RUSTC: none negative impls are unstable in rustc (`negative_impls`)
// EXPECT: 1
struct Token {
    id: i64,
}

impl !Send for Token {}

fn sync<T: Sync>(t: T) -> T {
    t
}

fn main() {
    let t = sync(Token { id: 1 });
    println("{}", t.id);
}
