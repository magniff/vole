// EDITION: rust
// (0.28.0) `volec test` on std2: a #[property] that fails is shrunk to
// its smallest failing input, which the test program prints (std::test).
// FLAGS: --test-build
// ARGS: --vole-test small
// EXIT: 1
// EXPECT: vole-test: property case {int} of 100, shrunk in {int} steps, seed {..}
// EXPECT: vole-test: input x = 100
// STDERR: too big
#[property]
fn small(x: u8) {
    if x >= 100 {
        panic("too big");
    }
}

fn main() {}
