// 0.25.2: an owned assignment whose right side lends a temporary to a let
// parameter after nothing but places, `t = t.add(size(leaf_of(gpa)))`,
// read garbage: the desugaring of the assignment (front/own/drops.vl
// assign_drops) checked its block again, and check/temps.vl hoisted the
// checker's own `&leaf_of(gpa)` out of the checked right side into an
// Ident nothing resolved. tools/sinksweep/gen.py sweeps the family.
// FLAGS: --check-alloc
// EXPECT: 1 1
struct Leaf {
    opts: Vec<i64>,
}

struct Tree {
    sizes: Vec<i64>,
}

impl Tree {
    fn add(sink self, n: i64) -> Tree {
        self.sizes.push(n);
        self
    }
}

fn leaf_of(gpa: Gpa) -> Leaf {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(7);
    Leaf { opts: v }
}

fn size(leaf: Leaf) -> i64 {
    leaf.opts.len()
}

fn main(gpa: Gpa) -> i32 {
    var t = Tree { sizes: Vec::new_in(gpa) };
    t = t.add(size(leaf_of(gpa)));
    let n = size(leaf_of(gpa));
    t = t.add(n);
    println(f"{t.sizes[0]} {t.sizes[1]}");
    0
}
