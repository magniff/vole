// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a02_cell_callee)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a shared reference (a cell)
// A callee sets a Cell the clause reads through &.
use std::cell::Cell;

fn poke(c: &Cell<i64>) -> bool {
    c.set(9);
    true
}

fn f(c: &Cell<i64>) -> i64
    requires poke(c)
{
    1
}

fn main() {
    let c = Cell::new(1i64);
    println("{}", f(&c));
    println("{}", c.get());
}
