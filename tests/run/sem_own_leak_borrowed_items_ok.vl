// sem-own: for_each over w.iter() (borrowed items): nothing is dropped in the closure, each element once by the Vec: correct today, and must stay so when the known leak is fixed.
// EXPECT: 1
// EXPECT: 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(mk(1, gpa));
    w.push(mk(2, gpa));
    w.iter().for_each(|d| println("{}", d.id));
    println("end");
}
