// (0.25.2) EXPECT-PPM that must fail: the same gradient against a
// region of it the reference is not (4,4 instead of 4,2): XFAIL, so the
// suite reports XPASS if a differing image ever passes.
// XFAIL: a golden image that differs must fail
// EXPECT: wrote out.ppm
// EXPECT-PPM: out.ppm tests/golden/runner_ppm.ppm region 4,4,8,4 tolerance 1

use std::fs;

fn main(gpa: Gpa) -> i32 {
    var out = Buf::new_in(gpa);
    out.push_str("P6\n16 8\n255\n");
    for y in 0..8 {
        for x in 0..16 {
            out.push((x * 16) as u8);
            out.push((y * 32) as u8);
            out.push(((x + y) * 8) as u8);
        }
    }
    if fs::write("out.ppm", out.as_slice()).is_err() {
        eprintln("cannot write out.ppm");
        return 1;
    }
    println("wrote out.ppm");
    0
}
