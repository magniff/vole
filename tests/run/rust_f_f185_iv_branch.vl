// RULE: F18.5
// (0.30.2) An `if` whose branches are a local bound to a literal and a
// literal is one integer variable with them: `take(b + b)` types all of
// them i64, as rustc infers it (FL6: 0.30.1 closed the local at i32 in
// the branch, and `b + b` overflowed i32).
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let v = [1, 2, 3];
    let b0 = 2000000000;
    let b = if v.len() > 2 { b0 } else { 0 };
    println("{}", take(b + b));
}
