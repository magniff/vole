// Review 5's m13: `Conv<i32>` only for `W<'static>`, `Conv<i64>` for every
// `W<'a>`; the bound is Conv<i64>. rustc accepts it.
// EXPECT: 5
trait Conv<U> { fn c(&self) -> U; }
struct W<'a> { r: &'a str }
impl Conv<i32> for W<'static> { fn c(&self) -> i32 { 1 } }
impl<'a> Conv<i64> for W<'a> { fn c(&self) -> i64 { self.r.len() as i64 } }
fn go<T: Conv<i64>>(t: &T) -> i64 { t.c() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() }; println("{}", go(&x));
}
