// EDITION: rust
// RULE: F18.5, F18.3
// An unannotated `let` of literals is open: its integer positions take the
// type of the first use that gives one, in rustc's order; with none they
// are i32. An array passed as `&[u8]`, an accumulator added an i64, a
// counter compared and incremented then returned as usize, a borrow of an
// open local (`let r = &b;`), a range of an open array, a tuple assigned,
// `let q: *const T = &x;`, a literal behind `&` where `&T` goes, a closure's
// result before a literal argument (`map_or(0, |x| x + 1)`).
// EXPECT: 253 5000000000 3 7 6 [1, 2] 9 4 true 3 2147483647
// EXPECT: Some(2) true 5 2
use std::collections::HashMap;

struct M {
    v: i64,
}

struct H<'a> {
    p: &'a i64,
}

fn sum(xs: &[u8]) -> u32 {
    let mut s = 0;
    for x in xs {
        s += *x as u32;
    }
    s
}

fn count(n: usize) -> usize {
    let mut k = 0;
    let mut i = 0;
    while i < n {
        k += 1;
        i += 1;
    }
    k
}

fn first(s: &[i64]) -> i64 {
    s[0] + s[1]
}

fn main(gpa: Gpa) {
    let a = [1, 2, 250];
    let m = M { v: 5000000000 };
    let mut t = 0;
    t += m.v;
    print("{} {} {} ", sum(&a), t, count(3));
    let b = 7;
    let r = &b;
    let h = H { p: r };
    let c = [2, 4];
    let s: &[i64] = &c[..];
    print("{} {} ", *h.p, first(s));
    let mut kv = (0, 0);
    let mut src: Vec<(u8, u8), Gpa> = Vec::new_in(gpa);
    src.push((1, 2));
    kv = src[0];
    print("[{}, {}] ", kv.0, kv.1);
    let n = 9;
    let q: *const i64 = &n;
    let big = 2147483647;
    let w: Option<i64> = Some(3);
    print("{} {} {} ", unsafe { *q }, w.map_or(0, |x| x + 1), true);
    println("{} {}", 3, big);
    let mut map: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    map.insert(1, 2);
    let f: f32 = 1.5;
    let v = [5, 2];
    let y: i64 = v[0];
    println("{:?} {} {} {}", map.get(&1), f.total_cmp(&0.0).is_gt(), y, v[1]);
}
