// RULE: F18.5
// (0.30.2) An integer variable bound by a trait one integer type alone
// implements is that type, as rustc's selection confirms its one impl:
// `f(5)` is `f::<i64>`, `a.hi()` i64's method.
// EXPECT: 6 7
trait MyTr {
    fn hi(&self) -> i64;
}

impl MyTr for i64 {
    fn hi(&self) -> i64 {
        *self + 1
    }
}

fn f<T: MyTr>(x: T) -> i64 {
    x.hi()
}

fn main() {
    let a = 6;
    println("{} {}", f(5), a.hi());
}
