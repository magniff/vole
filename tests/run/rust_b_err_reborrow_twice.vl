// RULE: D2.5
// (0.27.1) Two `&mut *m` live at once.
// ERROR: error[borrowck.mut_twice]
// ERROR: line 12, column 14
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let m = &mut x;
    let q = &mut *m;
    let q2 = &mut *m;
    *q += 1;
    *q2 += 1;
    println("{}", x);
}
