// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::impl Ord.
// EXPECT: Greater 9
use std::boxed::Box;
use std::cmp::Ord;

fn main(gpa: Gpa) {
    let a = Box::new_in(9i64, gpa);
    let b = Box::new_in(2i64, gpa);
    let m = a.clone().max(b.clone());
    println("{:?} {}", a.cmp(&b), m);
}
