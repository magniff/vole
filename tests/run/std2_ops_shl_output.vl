// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Shl::Output.
// EXPECT: V { x: 48 }
use std::ops::Shl;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Shl for V {
    type Output = V;

    fn shl(self, rhs: V) -> V {
        V { x: self.x << rhs.x }
    }
}

fn apply<T: Shl<Output = T>>(a: T, b: T) -> T {
    a << b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 2 };
    let c: <V as Shl>::Output = apply(a, b);
    println("{:?}", c);
}
