// RULE: F34.4 (0.30.2, RT-302) A constant's value is checked for an exit
// where it is written, used or not (check_const_bodies): a free
// constant, an inherent one (of a generic type too), an impl's, a
// trait's default that every impl overrides, one only another unused
// constant names. rustc refuses each (E0572, E0268); a5eefbcae checked
// a value only where it was used, and accepted these. (b01, b02, b03,
// b07, b20, a26 of the second re-review of g302copy-148)
// ERROR: line 23
// ERROR: line 25
// ERROR: line 32
// ERROR: line 40
// ERROR: line 44
// ERROR: line 50
// ERROR-COUNT: 6
struct D {
    k: i64,
}

fn yes() -> bool {
    true
}

const C: D = { if yes() { return; } D { k: 1 } }; // error here

const E: D = { if yes() { return; } D { k: 2 } }; // error here

const F: (D, i64) = (E, 1);

struct S {}

impl S {
    const C: D = { if yes() { break; } D { k: 3 } }; // error here
}

struct W<X> {
    x: X,
}

impl<X> W<X> {
    const C: D = { if yes() { return; } D { k: 4 } }; // error here
}

trait T {
    const C: D = { if yes() { return; } D { k: 5 } }; // error here
    const K: i64;
}

impl T for S {
    const C: D = D { k: 6 };
    const K: i64 = { return; 1 }; // error here
}

fn main() {
    println("ok");
}
