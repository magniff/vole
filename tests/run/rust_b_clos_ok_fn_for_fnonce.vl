// EDITION: rust
// RULE: D19.6
// (0.27.2) An `Fn` closure meets an `FnOnce` bound; it reads its capture
// by `&`.
// EXPECT: 5 3
fn call<F: FnOnce() -> i64>(f: F) -> i64 {
    f()
}

fn main() {
    let k = 3;
    println("{} {}", call(|| k + 2), k);
}
