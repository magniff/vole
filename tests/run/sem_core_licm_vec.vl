// A guarded Vec index in a while loop.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k < 5 + unsafe { Z } { if k > 100 { t += v[i as usize]; } k += 1; }
    println("{}", t);
    0
}
