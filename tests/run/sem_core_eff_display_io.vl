// EDITION: rust
// XFAIL: gap 16: the rust edition accepts the translation: rc 0; MVS effect
// An f-string calls a Display impl that prints.
// ERROR: 'show' is #[effects(alloc(Gpa))], but it does io
use std::fmt::Display; use std::fmt::Formatter as Fmt;
#[derive(Clone, Copy)] struct Loud { n: i64 }

impl Display for Loud {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        println("io"); write(f, "{}", self.n)?; Ok(())
    }
}

#[effects(alloc(Gpa))]
fn show(x: Loud, gpa: Gpa) -> i64 { format_in("{x}", gpa).len() as i64 }

fn main(gpa: Gpa) -> i32 {
    println("{}", show(Loud { n: 5 }, gpa));
    0
}
