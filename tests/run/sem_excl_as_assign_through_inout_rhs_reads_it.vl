// the right side reads the place through the same access
// EXPECT: 2 1
fn rot(v: &mut Vec<i64, Gpa>, gpa: Gpa) {
    let mut n: Vec<i64, Gpa> = Vec::new_in(gpa); n.push(v[1]); n.push(v[0]); *v = n;
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v.push(2); rot(&mut v, gpa);
    println("{} {}", v[0], v[1]);
}
