// EDITION: rust
// RULE: D20.3
// (0.27.2) No elision inside a closure's own signature: `|p: &i64| p`
// returns its bound region where the result's region is the closure's
// (rustc: "lifetime may not live long enough"; 0.27.1 accepted it).
// ERROR: error[borrowck.outlives]
fn main() {
    let f = |p: &i64| p;
    let v = 3;
    println("{}", *f(&v));
}
