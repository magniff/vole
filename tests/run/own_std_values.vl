// XFAIL: gap 7: compile parser error: expected expression, got 'mut'
// 0.17 (T4, std on values): v[i] and v[a..b] as places (written through
// as_mut_slice), as_mut_slice, sort(&mut [T]) and v.sort(), sort_by with
// `&T` closures and named functions (`*T` parameters still fit), the
// stable sort of owned-looking elements, swap on Vec, slices and places,
// take on containers (the allocator kept), std::take with Default,
// Vec::filled_in cloning, Buf::from_in, iter_ref, Scanner tokens kept
// while it reads on, a consuming free.
// EXPECT: 1 2 9 | 9 2 1 | 7 8
// EXPECT: 0 5 | 5 0
// EXPECT: a1 b1 c2 d2 | 3 1
// EXPECT: 3 0 | 4 0 | 0 3 | 3 3
// EXPECT: hi! | 6
// EXPECT: one two three
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
use std::mem; #[derive(Clone, Copy)] struct Item<'a> { name: &'a [u8], k: i64 }

fn by_k(a: Item<'_>, b: Item<'_>) -> i64 { a.k - b.k }
fn by_k_ref(a: Item<'_>, b: Item<'_>) -> i64 { a.k - b.k }

fn bump(s: &mut [i64]) {
    s[0] += 1;
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(9);
    v.push(1);
    v.push(2);
    v.as_mut_slice().sort_unstable();
    print("{} {} {} | ", v[0], v[1], v[2]);
    v.sort_unstable_by(|a, b| ({ let a = *a; let b = *b; b - a }).cmp(&0));
    print("{} {} {} | ", v[0], v[1], v[2]);
    let mut a = [8i64, 7];
    a[..].sort_unstable();
    v[0] = a[0];
    v[1..3][0] = a[1];
    println("{} {}", v[0], v[1]);
    let mut x: i64 = 5;
    let mut y: i64 = 0;
    mem::swap(&mut x, &mut y);
    print("{x} {y} | ");
    v.swap(0usize, 1usize);
    a[..].swap(0usize, 1usize);
    // (`std::swap(&mut a[0], &mut a[1])` is own.conflict: two loans of a)
    a.swap(0usize, 1usize);
    mem::swap(&mut x, &mut y);
    println("{x} {y}");
    let mut items: Vec<Item<'_>, Gpa> = Vec::new_in(gpa);
    items.push(Item { name: b"c", k: 2 });
    items.push(Item { name: b"a", k: 1 });
    items.push(Item { name: b"d", k: 2 });
    items.push(Item { name: b"b", k: 1 });
    items.as_mut_slice().sort_by_in(|a, b| ({ let p = a; let q = b; p.k - q.k }).cmp(&0), gpa);
    items.sort_unstable_by(|a, b| by_k(*a, *b).cmp(&0));
    mut items[..].sort_by_in(|a, b| by_k_ref(a, b).cmp(&0), gpa);
    for it in items.iter() {
        print("{}{} ", str::from_utf8(it.name).unwrap(), it.k);
    }
    let mut t: i64 = 0;
    let mut c: i64 = 0;
    for it in items.as_slice().iter() {
        t += it.k;
        c += 1;
    }
    println("| {} {}", c - 1, t - 5);
    let mut w = v.take();
    print("{} {} | ", w.len(), v.len());
    w.push(4);
    v.push(3);
    bump(&mut w[..]);
    let n: i64 = mem::take(&mut w[3]);
    print("{} {} | ", n + 0, w[3]);
    let mut o: Option<i64> = Some(3i64);
    let got = mem::take(&mut o);
    print("{} {} | ", if o.is_none() { 0 } else { 1 }, got.unwrap());
    let rows: Vec<Vec<i64, Gpa>, Gpa> = Vec::from_elem_in(v.clone(), 2usize, gpa);
    println("{} {}", rows[1].len() + 2, rows[1][0]);
    let mut b = b"hi".to_vec_in(gpa);
    b.push(b'!');
    print("{} | ", str::from_utf8(b.as_slice()).unwrap());
    b.as_mut_slice()[0] = b'H';
    let mut bt = b.take();
    println("{}", bt.len() + b.len() * 10 + 3);
    let text = "one two three";
    let mut sc = Scanner::new(text);
    let first = sc.next_token().unwrap();
    let second = sc.next_token().unwrap();
    let third = sc.next_token().unwrap();
    println("{first} {second} {third}", first = str::from_utf8(first).unwrap(),
        second = str::from_utf8(second).unwrap(), third = str::from_utf8(third).unwrap());
    drop(bt);
    drop(w);
}
