// EDITION: rust
// The caller's fact from an inlined requires goes stale after the callee clears the Vec.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 0
static mut Z: i64 = 0;

fn touch(v: &mut Vec<i64, Gpa>, i: i64)
    requires 0 <= i && i < v.len() as i64
{
    v.clear();
}

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2); v.push(3);
    let i = 2 + unsafe { Z };
    touch(&mut v, i);
    println("{}", v[i as usize]);
    0
}
