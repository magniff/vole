// EDITION: rust
// 0.26.2: the file form with parts, `with` before `from`: the file's
// text comes after its parts', and the part's entry point is a field of
// the file's block. A part from another module is named by its path.
// EXPECT: step 1
mod common;

embed wgsl STEP with common::CELLS from b"shaders/step.wgsl";

fn main() -> i32 {
    let mut n: i64 = 0;
    let mut i: i64 = 0;
    let s = STEP.src.as_bytes();
    while i + 5 <= s.len() as i64 {
        if &s[i as usize..(i + 5) as usize] == b"cells" && i + 6 < s.len() as i64
            && s[(i + 5) as usize] == b':' {
            n += 1;
        }
        i += 1;
    }
    println("{} {n}", STEP.step);
    0
}
