// 0.26.2: the file form with parts, `with` before `from`: the file's
// text comes after its parts', and the part's entry point is a field of
// the file's block. A part from another module is named by its path.
// EXPECT: step 1
mod common;

embed wgsl STEP with common::CELLS from "shaders/step.wgsl";

fn main() -> i32 {
    var n = 0;
    var i = 0;
    let s = STEP.src;
    while i + 5 <= s.len {
        if s[i..i + 5] == "cells" && i + 6 < s.len && s[i + 5] == ':' {
            n += 1;
        }
        i += 1;
    }
    println(f"{STEP.step} {n}");
    0
}
