// 0.26.2 (places: contract conditions in the IR): an assert's conjuncts
// are evaluated exactly once on every path, as `&&` evaluates them, and
// the failing one is named: the pop's here, not `v.len() == 4`, which a
// second evaluation after the pop would find false. The first assert's
// pop runs once (4 elements are left).
// EXIT: 101
// EXPECT: 4
// STDERR: assertion failed: 'v.pop().unwrap() == 9'
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);
    assert(v.len() == 5 && v.pop().unwrap() == 5);
    println(f"{v.len()}");
    assert(v.len() == 4 && v.pop().unwrap() == 9);
}
