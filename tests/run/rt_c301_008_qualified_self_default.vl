// RULE: F8.4, F12.1
// RT-C301-8: `Self::K` and `Self::mk()` in trait A's default functions
// (in a closure, as a value, in a generic default too) are A's, though
// S's impl of B has the same names. 0.30.1 printed 23 for show. rustc
// prints 13 103 3001.
// EXPECT: 13 103 3001
trait A {
    const K: i64;
    fn mk() -> i64;
    fn show(&self) -> i64 { Self::K * 10 + Self::mk() }
    fn later(&self) -> i64 { let c = || Self::K * 100; let f = Self::mk; c() + f() }
    fn gen<U: Copy>(&self, u: U) -> i64 { let _v = u; Self::K + Self::mk() * 1000 }
}

trait B { const K: i64; fn mk() -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn mk() -> i64 { 3 } }
impl B for S { const K: i64 = 2; fn mk() -> i64 { 4 } }
fn main() { let s = S; println("{} {} {}", s.show(), s.later(), s.gen(5u8)); }
