// RULE: F8.4, D22.1
// RT-C301-8: `<T as A>::K` in a generic body is A's constant in the
// instance, B's `<T as B>::K` B's; calls too. 0.30.1 printed 22 for go3
// and refused the value in one. rustc prints 21 43 21 214321 1.
// EXPECT: 21 43 21 214321 1
trait A { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
trait B { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } fn mk() -> i64 { 3 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } fn mk() -> i64 { 4 } }

fn go<T: A + B>(t: &T) -> i64 {
    <T as B>::m(t) * 10 + <T as A>::m(t)
}

fn go2<T: A + B>() -> i64 {
    <T as B>::mk() * 10 + <T as A>::mk()
}

fn go3<T: A + B>() -> i64 {
    <T as B>::K * 10 + <T as A>::K
}

fn go4<T: B + A>(t: &T) -> i64 {
    <T as B>::m(t) * 10 + <T as A>::m(t) + <T as B>::mk() * 1000 + <T as A>::mk() * 100 + <T as B>::K * 100000 + <T as A>::K * 10000
}

fn one<T: A>(t: &T) -> i64 { let f = T::m; f(t) }
fn main() { println("{} {} {} {} {}", go(&S), go2::<S>(), go3::<S>(), go4(&S), one(&S)); }
