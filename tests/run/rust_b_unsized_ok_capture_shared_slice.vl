// RULE: Z9.6
// (0.27.2) A closure capturing a `&[T]` by `&`: a loan with two slots
// (R12's stopgap gone), the closure called twice and the slice used after.
fn main() {
    let a = [1, 2, 3];
    let s: &[i64] = &a[..];
    let c = || s.len();
    println("{} {} {}", c(), c(), s[0]);
}
// EXPECT: 3 3 1
