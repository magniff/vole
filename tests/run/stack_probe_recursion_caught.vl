// (0.30.2, RT-83) Frames under a page each (64 i64, 512 bytes; at -O0
// under 4 KiB too), recursing without end on a 128 KiB thread: no frame
// is probed, and none needs it, as each one writes its frame link at its
// top and moves sp by less than the guard page: the guard page is hit
// first. Passes on v0.30.1 too: the recursion was already caught.
// REQUIRES: macos
// EXIT: 138
use std::thread;

// Frames under a page each (512 bytes): the recursion must die on the
// guard page.
#[inline(never)]
fn down(n: i64) -> i64 {
    let a = [n; 64];
    if n == 0 {
        return a[3];
    }
    down(n - 1) + a[(n % 64) as usize]
}

fn main(gpa: Gpa) {
    let n = 100000000 + std::env::args().count() as i64;
    let h = thread::Builder::new().stack_size(131072).spawn_in(move || down(n), gpa).unwrap();
    println("{}", h.join().unwrap());
}
