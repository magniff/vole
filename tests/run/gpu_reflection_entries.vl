// EDITION: rust
// (0.28.0, gap 110) Reflection::compute/vertex/fragment keep their names
// in an `EntryPoint<'a>`: the parameters are `&'a str` (they were `&str`,
// and a check of any program that called them showed std's own
// borrowck.outlives errors).
use std::gpu::Reflection;

fn main(gpa: Gpa) {
    let mut refl = Reflection::new_in(gpa);
    refl.vertex("vs", "vs_main");
    refl.fragment("fs", "fs_main");
    refl.compute("step", "step_main", 8, 8, 1);
    for e in refl.entries.iter() {
        println("{} {} {}", e.name, e.native, e.workgroup[0]);
    }
}
// EXPECT: vs vs_main 0
// EXPECT: fs fs_main 0
// EXPECT: step step_main 8
