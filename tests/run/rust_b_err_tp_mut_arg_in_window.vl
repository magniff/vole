// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn take(s: &mut S) -> i64 {
    s.x
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add(take(&mut s));
    println("{}", s.x);
}
