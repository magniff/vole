// (0.27.1) `s.add(take(&mut s))`: an explicit `&mut s` in the window of the
// reservation (rustc E0499).
// ERROR: :26:16: error[borrowck.mut_twice]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn take(s: &mut S) -> i64 {
    s.x
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add(take(&mut s));
    println("{}", s.x);
}
