// an inout parameter passed inout and let of an owned type in one call
// ERROR: own.conflict
fn f(a: inout Vec<i64, Gpa>, b: Vec<i64, Gpa>) { a.push(b.len() as i64); }
fn g(x: inout Vec<i64, Gpa>) { f(&x, x); }
fn main(gpa: Gpa) { var v: Vec<i64, Gpa> = Vec::new_in(gpa); g(&v); println("{}", v.len()); }
