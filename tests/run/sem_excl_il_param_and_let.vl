// an inout parameter passed inout and let of an owned type in one call
// ERROR: error[borrowck.conflict]
// ERROR: line 6, column 31
fn f(a: &mut Vec<i64, Gpa>, b: &Vec<i64, Gpa>) { a.push(b.len() as i64); }
fn g(x: &mut Vec<i64, Gpa>) { f(x, x); }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); g(&mut v); println("{}", v.len());
}
