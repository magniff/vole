// c"..." literals are NUL-terminated *u8 C strings.
// EXPECT: hello, world
// EXPECT: 12 0 119
// EXPECT: 9|3
// EXPECT: []
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
    fn puts(s: *const u8) -> i32;
    fn strlen(s: *const u8) -> u64;
    fn strcmp(a: *const u8, b: *const u8) -> i32;
}

fn main() -> i64 {
    let greeting: *const u8 = c"hello, world";
    unsafe {
        puts(greeting);
        printf(c"%lu %d %d\n", strlen(greeting), strcmp(c"abc", c"abc"), (*greeting.add(7)) as i32);
    }
    let tab = c"a\tb";
    unsafe {
        printf(c"%d|%lu\n", (*tab.add(1)) as i32, strlen(tab));
        printf(c"[%s]\n", c"");
    }
    0
}
