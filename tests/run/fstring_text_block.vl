// 0.25.4: `f"""` is a text block with holes: the same lines and dedent
// as `"""` (the closing line's indentation removed from every line, the
// line breaks after the opening and before the closing line left out),
// and an f-string's holes, specs and `{{ }}`. A quote is text in it; a
// `\` at a line's end joins the next line. (0.25.3: "newline in string
// literal".)
// EXPECT: [fn main() {
// EXPECT:     let n = 3;
// EXPECT: }]
// EXPECT: [name: "vole"
// EXPECT:   width:    7 {braces}
// EXPECT:
// EXPECT: joined: 2 and 21]
// EXPECT: []
// EXPECT: [3]
fn main() {
    let n = 3;
    let name = "vole";
    let code = f"""
        fn main() {{
            let n = {n};
        }}
        """;
    println(f"[{code}]");
    let w = 7;
    let text = f"""
            name: "{name}"
              width: {w:>4} {{braces}}

            joined: {n - 1} \
            and {n * 7}
            """;
    println(f"[{text}]");
    let empty = f"""
        """;
    println(f"[{empty}]");
    let one = f"""
    {n}
    """;
    println(f"[{one}]");
}
