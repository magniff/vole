// EDITION: rust
// 0.25.4 (`f"""`; 0.26.3: f-strings removed, a format literal): a text
// block at a format position (format_args, println) has holes: the same
// lines and dedent as `"""` (the closing line's indentation removed from
// every line, the line breaks after the opening and before the closing
// line left out), and a format string's holes, specs and `{{ }}`. A quote is text in it; a
// `\` at a line's end joins the next line. (0.25.3: "newline in string
// literal".)
// EXPECT: [fn main() {
// EXPECT:     let n = 3;
// EXPECT: }]
// EXPECT: [name: "vole"
// EXPECT:   width:    7 {braces}
// EXPECT:
// EXPECT: joined: 2 and 21]
// EXPECT: []
// EXPECT: [3]
fn main() {
    let n: i64 = 3;
    let name = "vole";
    let code = format_args("""
        fn main() {{
            let n = {n};
        }}
        """);
    println("[{code}]");
    let w: i64 = 7;
    let text = format_args("""
            name: "{name}"
              width: {w:>4} {{braces}}

            joined: {} \
            and {}
            """, n - 1, n * 7);
    println("[{text}]");
    let empty = format_args("""
        """);
    println("[{empty}]");
    let one = format_args("""
    {n}
    """);
    println("[{one}]");
}
