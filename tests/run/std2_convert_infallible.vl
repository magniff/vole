// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::convert Infallible.
// EXPECT: 3
use std::convert::Infallible;

fn always(x: i64) -> Result<i64, Infallible> {
    Ok(x)
}

fn main() {
    match always(3) {
        Ok(v) => println("{}", v),
        Err(_) => println("never"),
    }
}
