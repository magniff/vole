// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'wr', which writes through a raw pointer what it did not make
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

// a slice made from the param pointer
fn wr(p: *mut i64) -> bool {
    let s = unsafe { std::slice::from_raw_parts_mut(p, 1) }; s[0] = 9; true
}

fn f(p: *mut i64) -> i64
    requires wr(p)
{ 1 }

fn main() { let mut x = 1i64; println("{}", f(&raw mut x)); println("{}", x); }
