// RULE: M1
// (0.30.1) A value a statement discards moves into the statement's
// temporary and drops at the statement's end, as rustc's: `d;`, `{ e };`,
// an if's tail, `let _ = { g };` drop before the next statement, not at
// the end of the block; a value with a Box field (drop glue, no Drop
// impl) is freed there, once (--check-alloc). Before, `d;` was a mention
// only and d dropped at the block's end.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: after d
// EXPECT: drop 2
// EXPECT: after e
// EXPECT: drop 3
// EXPECT: after f
// EXPECT: after q
// EXPECT: drop 7
// EXPECT: after g
// EXPECT: 8
// EXPECT: end
// EXPECT: drop 9
use std::alloc::Allocator;

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct Q<A: Allocator> {
    b: Box<i64, A>,
}

fn main(gpa: Gpa) {
    let d = D { v: 1 };
    d;
    println("after d");
    let e = D { v: 2 };
    { e };
    println("after e");
    let f = D { v: 3 };
    let c = std::env::args().count() < 100;
    if c { f } else { D { v: 4 } };
    println("after f");
    let q = Q { b: Box::new_in(5, gpa) };
    q;
    let r = Q { b: Box::new_in(6, gpa) };
    { r };
    println("after q");
    let g = D { v: 7 };
    let _ = { g };
    println("after g");
    let s = Q { b: Box::new_in(8, gpa) };
    let t = D { v: 9 };
    let _ = s;
    let _ = t;
    println("{}", *s.b);
    println("end");
}
