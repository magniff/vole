// EDITION: rust
// XFAIL: gap 4: compile type error: the trait 'Borrow<i32>' is not implemented for 'i64'
// (0.20) HashSet on the Swiss table: insert, contains, remove, iteration
// against a model; a map of owned values dropped (--check-alloc).
// FLAGS: --check-alloc
// EXPECT: 3 true false 2
// EXPECT: 500 500 124750
// EXPECT: 2 1
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<&str, Gpa> = HashSet::new_in(gpa);
    s.insert("pear");
    s.insert("fig");
    let again = s.insert("pear");
    s.insert("kiwi");
    let had = s.contains(&"fig");
    s.remove(&"fig");
    println("{} {had} {again} {}", s.len() + 1, s.len());
    let mut t: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    let mut model: Vec<bool, Gpa> = Vec::from_elem_in(false, 1000usize, gpa);
    for i in 0..1000 {
        t.insert(i);
        model[i as usize] = true;
    }
    for i in 0..1000 {
        if i % 2 == 1 {
            t.remove(&i);
            model[i as usize] = false;
        }
    }
    let mut n: i64 = 0;
    let mut sum: i64 = 0;
    for x in t.iter().copied() {
        if !model[x as usize] {
            println("FAIL");
        }
        n += 1;
        sum += x / 2;
    }
    println("{} {n} {sum}", t.len());
    let mut u: HashSet<(i64, &str), Gpa> = HashSet::new_in(gpa);
    u.insert((1, "a"));
    u.insert((2, "b"));
    u.insert((1, "a"));
    u.remove(&(2, "b"));
    println("{} {}", u.len() + 1, u.len());
    // (a map of owned values, dropped with it: --check-alloc reports a leak)
    let mut m: std::collections::HashMap<i64, Vec<i64, Gpa>,
        Gpa> = std::collections::HashMap::new_in(gpa);
    for k in 0..100 {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(k);
        m.insert(k % 7, v);
    }
    m.remove(&3);
}
