// RULE: F34.3 (0.30.2, RT-214) A shared borrow of an array constant whose
// type has no drop glue and no interior mutability is of its static, as
// rustc promotes it: `&Q` and `&Q[0]` returned as `'static` (0.30.2's
// first try made the constant at the use and refused both as a local's,
// borrowck.return_local; v0.30.1 accepted them). (a07 of the review of
// the opaque-type work)
// EXPECT: 4 3
struct N {
    k: i64,
}

const Q: [N; 2] = [N { k: 3 }, N { k: 4 }];

fn r() -> &'static [N; 2] {
    &Q
}

fn first() -> &'static N {
    &Q[0]
}

fn main() {
    println("{} {}", r()[1].k, first().k);
}
