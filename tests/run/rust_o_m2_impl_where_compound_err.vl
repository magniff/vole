// ERROR: the trait 'Tr<i64>' is not implemented for 'W'
// (RT-269) an impl's `where Option<U>: Conv<i64>` is required where it is chosen (rustc E0277; v0.30.1 accepted it).
trait Conv<X> {}

trait Tr<U> {
    fn f(&self) -> i64;
}

struct W {
    r: i64,
}

impl<U> Tr<U> for W
    where
        Option<U>: Conv<i64>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn need<T: Tr<i64>>(t: &T) -> i64 {
    t.f()
}

fn main() {
    println("{}", need(&W { r: 0 }));
}
