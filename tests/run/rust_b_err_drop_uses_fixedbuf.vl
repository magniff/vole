// RULE: D9.1
// (0.30.1, RT-M2-14) A Vec's drop gives its memory back to its
// allocator: `&fb`, which borrows `buf`, is used there, so a write to
// `buf` while the Vec lives is refused (rustc E0506: cannot assign to
// `buf[_]` because it is borrowed, the borrow later used when `v` is
// dropped). Before, it passed and the drop freed the Boxes it read from
// the overwritten buffer.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 22, column 9
// ERROR-COUNT: 1
use std::alloc::FixedBuf;

fn main(gpa: Gpa) {
    let mut buf: [u8; 256] = [0; 256];
    let fb = FixedBuf::new(&mut buf);
    let mut v: Vec<Box<i64, Gpa>, &FixedBuf> = Vec::new_in(&fb);
    for i in 0..4 {
        v.push(Box::new_in(i, gpa));
    }
    println("{}", v.len());
    for i in 0..256 {
        buf[i] = 0x41;
    }
    println("filled");
}
