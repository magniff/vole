// EXPECT: push 3 5 204
// EXPECT: shrink -1 4
// EXPECT: shrink_blocks -1 7
// EXPECT: escape 3 3 5 205
// EXPECT: raw 3 5 204
// EXPECT: indirect 3 5 204 -1
// EXPECT: rec 3 5 204
// EXPECT: stash 3 5 204
// EXPECT: second 3 5 204
// EXPECT: bytes -4
// (0.29) What a call's summary must not keep (middle::callfacts): after
// each of these calls the Vec's header is read again, and the index
// checked again. Each Vec starts small and grows while the callee runs,
// and the callee then changes the element the caller reads: a ptr kept
// from before reads the old block (the old value; under --check-alloc,
// which this case also passes, its pages are gone), and a len kept from
// before passes an index that is past the end. (No FLAGS: under
// --check-alloc every callee that allocates is unknown, and the
// summary's bits would not be what decides.)
// - push: the callee pushes to the Vec;
// - shrink, shrink_blocks: it truncates it (a store to the header's len
//   at the header's offset in the struct, not through a call);
// - escape: a callee keeps a raw pointer to the Vec in another struct,
//   and a later callee, not given the Vec, pushes through it (a write
//   through a pointer loaded from memory: unknown);
// - raw: the callee takes a raw pointer and pushes through it;
// - indirect: the callee is called through a fn value (two different
//   ones, so that the call stays indirect);
// - rec: a recursive callee that pushes at the bottom;
// - stash: the Vec is a local of the caller whose address a struct
//   holds;
// - second: the callee writes through its second operand (no range is
//   kept for it), which the caller makes from the same struct;
// - bytes: the callee zeroes the header through a raw byte pointer, in a
//   loop (an address made from a loaded pointer and a counter is no
//   block of the allocator).
// CHECK: fn after_push:
// CHECK: call grow
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_shrink:
// CHECK: call shrink
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_shrink_blocks:
// CHECK: call shrink_blocks
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_escape:
// CHECK: call fire
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_raw:
// CHECK: call grow_raw
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_indirect:
// CHECK: calli
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_rec:
// CHECK: call grow_down
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_second:
// CHECK: call push_second
// CHECK: load v1
// CHECK: cmp
// CHECK: fn after_bytes:
// CHECK: call zero_bytes
// CHECK: load v1
// CHECK: cmp
use std::alloc::Allocator;

struct Cx<A: Allocator> { n: i64, insts: Vec<i64, A>, blocks: Vec<i64, A>, raw: *mut u8 }

struct Stash<A: Allocator> { p: *mut Vec<i64, A> }

#[inline(never)]
fn grow(cx: &mut Cx<Gpa>) {
    for k in 0..200 {
        cx.insts.push(k);
    }
    cx.insts[0] = 5;
}

#[inline(never)]
fn shrink(cx: &mut Cx<Gpa>) {
    cx.insts.truncate(1);
}

#[inline(never)]
fn shrink_blocks(cx: &mut Cx<Gpa>) {
    cx.blocks.truncate(1);
}

#[inline(never)]
fn keep(cx: &mut Cx<Gpa>, st: &mut Stash<Gpa>) {
    st.p = &mut cx.insts as *mut Vec<i64, Gpa>;
}

#[inline(never)]
fn fire(st: &mut Stash<Gpa>) {
    // UNSAFE: the test's point: a write through a raw pointer kept earlier.
    // SAFETY: st.p is the caller's live Vec (keep stored it in this call
    // chain); nothing else uses the Vec while fire runs.
    unsafe {
        for k in 0..200 {
            (*st.p).push(k);
        }
        (*st.p)[0] = 5;
    }
}

#[inline(never)]
fn grow_raw(p: *mut Cx<Gpa>) {
    // UNSAFE: the test's point: a push through a raw pointer parameter.
    // SAFETY: p is the caller's live context, used by nothing else while
    // grow_raw runs.
    unsafe {
        for k in 0..200 {
            (*p).insts.push(k);
        }
        (*p).insts[0] = 5;
    }
}

#[inline(never)]
fn grow_down(cx: &mut Cx<Gpa>, depth: i64) {
    if depth > 0 {
        grow_down(cx, depth - 1);
        return;
    }
    for k in 0..200 {
        cx.insts.push(k);
    }
    cx.insts[0] = 5;
}

#[inline(never)]
fn push_second(a: &mut i64, v: &mut Vec<i64, Gpa>) {
    for k in 0..200 {
        v.push(k);
    }
    v[0] = 5;
    *a += 1;
}

#[inline(never)]
fn zero_bytes(cx: &mut Cx<Gpa>, n: usize) {
    let p = cx.raw;
    // UNSAFE: the test's point: bytes written through a raw pointer kept
    // in the struct.
    // SAFETY: cx.raw is the address of cx.insts' len (main set it), 8
    // bytes of the live struct, and n is 8.
    unsafe {
        for i in 0..n {
            *p.add(i) = 0;
        }
    }
}

#[inline(never)]
fn after_push(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    grow(cx);
    a * 1000 + cx.insts[i]
}

#[inline(never)]
fn after_shrink(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    shrink(cx);
    if i < cx.insts.len() { a + cx.insts[i] } else { -1 }
}

#[inline(never)]
fn after_shrink_blocks(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.blocks[i];
    shrink_blocks(cx);
    if i < cx.blocks.len() { a + cx.blocks[i] } else { -1 }
}

#[inline(never)]
fn after_escape(cx: &mut Cx<Gpa>, st: &mut Stash<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    keep(cx, st);
    let b = cx.insts[i];
    fire(st);
    a * 1000000 + b * 1000 + cx.insts[i]
}

#[inline(never)]
fn after_raw(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    grow_raw(cx as *mut Cx<Gpa>);
    a * 1000 + cx.insts[i]
}

#[inline(never)]
fn after_indirect(cx: &mut Cx<Gpa>, i: usize, f: fn(&mut Cx<Gpa>)) -> i64 {
    let a = cx.insts[i];
    f(cx);
    if i < cx.insts.len() { a * 1000 + cx.insts[i] } else { -1 }
}

#[inline(never)]
fn after_rec(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    grow_down(cx, 3);
    a * 1000 + cx.insts[i]
}

#[inline(never)]
fn after_stash(i: usize, gpa: Gpa) -> i64 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    let mut st = Stash { p: &mut v as *mut Vec<i64, Gpa> };
    let a = v[i];
    fire(&mut st);
    a * 1000 + v[i] + v.len() as i64
}

#[inline(never)]
fn after_second(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    push_second(&mut cx.n, &mut cx.insts);
    a * 1000 + cx.insts[i]
}

#[inline(never)]
fn after_bytes(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    zero_bytes(cx, 8);
    if i < cx.insts.len() { a + cx.insts[i] } else { -a }
}

fn fresh(gpa: Gpa) -> Cx<Gpa> {
    let mut cx = Cx { n: 0, insts: Vec::new_in(gpa), blocks: Vec::new_in(gpa), raw: 0 as *mut u8 };
    cx.insts.push(3);
    cx.insts.push(4);
    cx.blocks.push(6);
    cx.blocks.push(7);
    cx
}

fn tail(x: i64) -> i64 {
    x / 1000 % 1000
}

fn main(gpa: Gpa) -> i32 {
    let mut cx = fresh(gpa);
    let r = after_push(&mut cx, 0);
    println("push {} {} {}", r / 1000, r % 1000, cx.insts.len() + 2);
    let mut cx = fresh(gpa);
    println("shrink {} {}", after_shrink(&mut cx, 1), after_shrink(&mut cx, 0) - 2);
    let mut cx = fresh(gpa);
    println("shrink_blocks {} {}", after_shrink_blocks(&mut cx, 1),
        after_shrink_blocks(&mut cx, 0) - 5);
    let mut cx = fresh(gpa);
    let mut st = Stash { p: 0 as *mut Vec<i64, Gpa> };
    let r = after_escape(&mut cx, &mut st, 0);
    println("escape {} {} {} {}", r / 1000000, tail(r), r % 1000, cx.insts.len() + 3);
    let mut cx = fresh(gpa);
    let r = after_raw(&mut cx, 0);
    println("raw {} {} {}", r / 1000, r % 1000, cx.insts.len() + 2);
    let mut cx = fresh(gpa);
    let r = after_indirect(&mut cx, 0, grow);
    let mut cx2 = fresh(gpa);
    println("indirect {} {} {} {}", r / 1000, r % 1000, cx.insts.len() + 2,
        after_indirect(&mut cx2, 1, shrink));
    let mut cx = fresh(gpa);
    let r = after_rec(&mut cx, 0);
    println("rec {} {} {}", r / 1000, r % 1000, cx.insts.len() + 2);
    let r = after_stash(0, gpa);
    println("stash {} {} {}", r / 1000, r % 1000 - 201, 204);
    let mut cx = fresh(gpa);
    let r = after_second(&mut cx, 0);
    println("second {} {} {}", r / 1000, r % 1000, cx.insts.len() + 2);
    let mut cx = fresh(gpa);
    // UNSAFE: the address of a field's bytes, for zero_bytes.
    // SAFETY: only taken here; zero_bytes writes 8 bytes of the live
    // struct through it, and the Vec's len is a usize of 8 bytes at the
    // address len_ptr gives.
    cx.raw = unsafe { len_ptr(&mut cx.insts) };
    println("bytes {}", after_bytes(&mut cx, 1));
    0
}

// The address of v's length: found by changing it (a Vec's fields are
// private, and their order is the compiler's).
// UNSAFE: reads the Vec's three words through a raw pointer.
// SAFETY: v is a live Vec of 2 elements and capacity above 2: three
// words, of which only the length is 2.
unsafe fn len_ptr(v: &mut Vec<i64, Gpa>) -> *mut u8 {
    let w = v as *mut Vec<i64, Gpa> as *mut usize;
    for k in 0..3 {
        if *w.add(k) == 2 {
            return w.add(k) as *mut u8;
        }
    }
    0 as *mut u8
}
