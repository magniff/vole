// sem-own: a Map adapter holding a sink closure that owns a D: `it.count()`
// (let self) consumes a copy; the closure's capture must be dropped once.
// XFAIL: OVERSTRICT+DIAG `(0..2).map(sink |i| ..)`: "expected 'let closure..', got 'closure..'", this value has no place
// EXPECT: n 2
// EXPECT: drop 5
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let d = mk(5, gpa);
    let it = (0..2).map(sink |i| i + d.id);
    let n = it.count();
    println("n {n}");
}
