// (re-review 2 of M2, form p01) The entails memo (coherence::entails)
// answers each (impl, node, trait) goal once per ask: `T: PA` holds, and
// `T: PC`, asked next of the same node, is not answered by PA's row. Under
// a memo that always hits, the impl is accepted (rustc: E0277, `T: PC`).
// ERROR: 'Tr' requires 'W<T>: Sup', which is not implemented
// ERROR-COUNT: 1
trait Sup {}

trait Tr: Sup {}

trait PA {}

trait PC {}

struct W<T> {
    t: T,
}

impl<T: PA + PC> Sup for W<T> {}

impl<T: PA> Tr for W<T> {}

fn main() {
    println("done");
}
