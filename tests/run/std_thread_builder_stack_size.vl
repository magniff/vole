// The std item(s): std::thread Builder::stack_size (0.30.1): a thread
// with a 1 GiB stack runs a recursion a million calls deep, more than
// the 8 MiB stack of spawn_in's thread holds (each call keeps 16 words).
// EXPECT: 7500000
use std::thread;

fn deep(n: u64) -> u64 {
    let a = [n % 16; 16];
    if n == 0 {
        return 0;
    }
    deep(n - 1) + a[(n % 16) as usize]
}

fn main(gpa: Gpa) {
    let h = thread::Builder::new()
        .stack_size(1 << 30)
        .spawn_in(move || deep(1000000), gpa)
        .unwrap();
    println("{}", h.join().unwrap());
}
