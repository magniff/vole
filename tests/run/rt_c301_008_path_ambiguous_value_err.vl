// RULE: F8.3, F9.3
// `S::m` as a value, two traits giving S an `m`, none inherent: the path
// does not say which (rustc E0034). 0.30.1 took A's.
// ERROR: error[method.ambiguous]: multiple applicable items: 'm' is an item of more than one trait for 'S'
// S::m as a value with two traits supplying m: rustc E0034
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn main() { let s = S; let f = S::m; println("{}", f(&s)); }
