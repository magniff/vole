// RULE: Z9.6
// (0.27.2) A fat raw pointer is Copy: `&mut *p` twice copies p, and the
// two references are not one move (R1).
fn main() {
    let mut b = [1u8, 2, 3];
    let p = &mut b[..] as *mut [u8];
    // SAFETY: p is b, live; the two references are used one after the other.
    let x: &mut [u8] = unsafe { &mut *p };
    let y: &mut [u8] = unsafe { &mut *p };
    x[0] = 7;
    y[1] = 8;
    println("{} {}", b[0], b[1]);
}
// EXPECT: 7 8
