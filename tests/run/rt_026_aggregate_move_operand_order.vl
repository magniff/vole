// XFAIL: RT-26: a tuple's, struct literal's or variant's operand that moves a place is read after the later operands (open)
// Rust evaluates operands left to right: in `(s, { s = new; 0 })` the
// tuple takes the old s, and the assignment then gives s a new value.
// vole moves s out after the block has run, so the tuple, the struct and
// the variant hold the NEW strings (and the old ones are dropped by the
// assignments). A function call's arguments are in order (`pair` below).
// rustc-twin's output is the EXPECT.
// EXPECT: tuple old 1
// EXPECT: struct old 2 0
// EXPECT: variant old 3
// EXPECT: call old 4 new
use std::alloc::Allocator;

struct P<A: Allocator> {
    a: String<A>,
    b: i64,
}

enum E<A: Allocator> {
    Two(String<A>, i64),
}

fn pair<A: Allocator>(a: String<A>, b: i64) -> String<A> {
    let _ = b;
    a
}

fn main(gpa: Gpa) {
    let mut s = format_in("old {}", 1, gpa);
    let t = (s, {
        s = format_in("new {}", 1, gpa);
        0
    });
    println("tuple {}", t.0);
    let mut w = format_in("old {}", 2, gpa);
    let p = P { a: w, b: {
        w = format_in("new {}", 2, gpa);
        0
    } };
    println("struct {} {}", p.a, p.b);
    let mut u = format_in("old {}", 3, gpa);
    let e = E::Two(u, {
        u = format_in("new {}", 3, gpa);
        0
    });
    match e {
        E::Two(x, _) => println("variant {x}"),
    }
    let mut c = format_in("old {}", 4, gpa);
    let r = pair(c, {
        c = format_in("new", gpa);
        0
    });
    println("call {} {}", r, c);
}
