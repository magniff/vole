// EDITION: rust
// sem-own: while let on a var Option moved and assigned each iteration: each value once.
// EXPECT: it 1
// EXPECT: drop 1
// EXPECT: it 2
// EXPECT: drop 2
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut o: Option<D<Gpa>> = Some(mk(1, gpa));
    let mut n: i64 = 1;
    while let Some(d) = o {
        println("it {}", d.id);
        n += 1;
        o = if n < 3 { Some(mk(n, gpa)) } else { None };
    }
    println("end");
}
