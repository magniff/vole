// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Scan::impl Iterator.
// EXPECT: Some(1) None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().scan(0, |a, x| {
        *a += x;
        if *a < 3 { Some(*a) } else { None }
    });
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
