// Runs on std since its gap closed (0.27.3).
// The std item(s): std::iter::adapters Cloned::impl DoubleEndedIterator.
// EXPECT: Some("y")

fn main(gpa: Gpa) {
    let x = "x".to_string_in(gpa);
    let y = "y".to_string_in(gpa);
    let s = Vec::from_in([x, y], gpa);
    println("{:?}", s.iter().cloned().next_back());
}
