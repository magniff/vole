// RULE: F8.3, F8.4
// RT-C301-8 review (R3, form f71c_super_generic_qualified): the supertrait's arguments, qualified.
// rustc prints the EXPECT lines.
// EXPECT: 704
trait Conv<X> { const K: i64; fn mk() -> i64; }
trait Sub: Conv<i64> {}
struct S;
impl Conv<i32> for S { const K: i64 = 32; fn mk() -> i64 { 320 } }
impl Conv<i64> for S { const K: i64 = 64; fn mk() -> i64 { 640 } }
impl Sub for S {}
fn g<T: Sub>() -> i64 { <T as Conv<i64>>::K + <T as Conv<i64>>::mk() }
fn main() { println("{}", g::<S>()); }
