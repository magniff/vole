// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops Neg::Output.
// EXPECT: V { x: -12 }
use std::ops::Neg;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Neg for V {
    type Output = V;

    fn neg(self) -> V {
        V { x: -self.x }
    }
}

fn apply<T: Neg<Output = T>>(a: T) -> T {
    -a
}

fn main() {
    let c: <V as Neg>::Output = apply(V { x: 12 });
    println("{:?}", c);
}
