// RULE: F26.1, F26.2
// Comparisons through derived PartialEq and PartialOrd (structs, enums,
// Option), a bound written in `where`, `==`/`!=` through `&T` with `T:
// PartialEq`, and the builtin ones (str, char, tuples), as rustc.
// EXPECT: false true true true true
// EXPECT: true true true false
// EXPECT: true true false true
// EXPECT: true true false
#[derive(Debug, Clone, Copy, PartialEq, PartialOrd)]
struct P { a: i32, b: i32 }
#[derive(PartialEq, Eq, PartialOrd, Ord, Clone, Copy)]
enum E { X, Y }

fn le<T>(a: T, b: T) -> bool where T: PartialOrd {
    a <= b
}

fn eqr<T: PartialEq>(a: &T, b: &T) -> bool {
    a == b && !(a != b)
}

fn main(gpa: Gpa) {
    let p = P { a: 1, b: 2 };
    let q = P { a: 1, b: 3 };
    let mut s = String::new_in(gpa);
    s.push_str("ab");
    let o1: Option<i32> = Some(3);
    let o2: Option<i32> = None;
    println("{} {} {} {} {}", p == q, p != q, p < q, q >= p, le(p, q));
    println("{} {} {} {}", E::X < E::Y, E::X == E::X, eqr(&p, &p), eqr(&1u8, &2u8));
    println("{} {} {} {}", "ab" < "b", s.len() == 2, o1 == o2, o1 > o2);
    println("{} {} {}", 'a' < 'b', (1, 2) == (1, 2), &p == &q);
}
