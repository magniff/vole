// RT-38 (round 2, must pass): a clause's view of a by-value parameter is
// a borrowed copy; when the parameter's type is a `&mut` (a generic T's
// instance) the view is its shared reborrow, never a second `&mut`
// copied (--verify-places' I7); a `&mut [T]`'s is a shared slice. The
// EXPECT lines are rustc's output for the bodies alone.
// FLAGS: --verify-places --check-alloc
// EXPECT: 2
// EXPECT: 2
// EXPECT: 2
// EXPECT: 4
fn same<T>(_x: &T) -> i64 {
    1
}

fn f<T>(x: T) -> i64
    ensures old(same(&x)) == 1
{
    let _y = x;
    2
}

fn h<T>(x: T) -> i64
    ensures old({
        let _r = &x;
        1
    }) == 1
    {
    let _y = x;
    2
}

fn g(s: &mut [i64]) -> i64
    ensures old(s.len()) == s.len()
{
    s[0] = 4;
    s[0]
}

fn main() {
    let mut a = 1i64;
    println("{}", f(&mut a));
    println("{}", f(5i64));
    println("{}", h(&mut a));
    let mut v = [1i64, 2];
    println("{}", g(&mut v));
}
