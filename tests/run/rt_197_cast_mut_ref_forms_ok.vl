// RT-197, what must still build: a `&mut` cast to `*const` behind a `&`, to
// `*mut`, `&mut` or a raw view through a `&mut`, `as &T` behind a `&`, and
// a local `&mut` usable after its cast (no loan on the raw pointer); the
// output is rustc's.
// EXPECT: 5
// EXPECT: 6
// EXPECT: 2 [10, 2, 30]
// EXPECT: 3
struct H<'a> {
    r: &'a mut i64,
    s: &'a mut [i64],
}

fn ok1(h: &H) -> *const i64 {
    h.r as *const i64
}

fn ok2(h: &H) -> *const [i64] {
    h.s as *const [i64]
}

fn ok3(h: &mut H) -> *mut i64 {
    h.r as *mut i64
}

fn ok4(h: &mut H) -> *mut [i64] {
    h.s as *mut [i64]
}

fn ok5<'a>(h: &'a mut H) -> &'a mut i64 {
    h.r as &mut i64
}

fn ok6<'a>(h: &'a H) -> &'a i64 {
    h.r as &i64
}

fn ok7(h: &mut H) -> *mut [i64] {
    let p: *mut [i64] = h.s;
    p
}

fn main() {
    let mut x = 1i64;
    let mut arr = [1i64, 2, 3];
    let mut h = H { r: &mut x, s: &mut arr };
    let p3 = ok3(&mut h);
    // UNSAFE: the test writes through the raw pointer a cast made
    // SAFETY: p3 points at x, alive, and nothing else uses it here
    unsafe {
        *p3 = 5;
    }
    let p1 = ok1(&h);
    // UNSAFE: the test reads through the raw pointer
    // SAFETY: p1 points at x, alive, no write since
    let v1 = unsafe { *p1 };
    println("{}", v1);
    *ok5(&mut h) += 1;
    println("{}", *ok6(&h));
    let q = ok4(&mut h);
    // UNSAFE: the test writes through the fat raw pointer
    // SAFETY: q is arr's whole view, alive, index 0 in bounds
    unsafe {
        (*q)[0] = 10;
    }
    let q7 = ok7(&mut h);
    // UNSAFE: the test writes through the fat raw pointer
    // SAFETY: q7 is arr's whole view, alive, index 2 in bounds
    unsafe {
        (*q7)[2] = 30;
    }
    let p2 = ok2(&h);
    // UNSAFE: the test reads through the fat raw pointer
    // SAFETY: p2 is arr's whole view, alive, index 1 in bounds
    let v2 = unsafe { (*p2)[1] };
    println("{} {:?}", v2, h.s);
    let mut y = 1i64;
    let r: &mut i64 = &mut y;
    let p = r as *mut i64;
    *r += 1;
    // UNSAFE: the test writes through a raw pointer made of r
    // SAFETY: p points at y, alive; r is not used after
    unsafe {
        *p += 1;
    }
    println("{}", y);
}
