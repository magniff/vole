// (0.30.2, RT-466's family) A generic function's instance, four locals
// `[T; 2^60]` with T = u8 (T = u64: past rustc's 2^61 bound on a type).
// FLAGS: --target aarch64-macos
// ERROR: frame.too_big
// ERROR: line 12, column 13
#[inline(never)]
fn fill<T: Copy>(x: T, n: usize) -> T {
    if n > 5 {
        let a = [x; 1usize << 60];
        let b = [x; 1usize << 60];
        let c = [x; 1usize << 60];
        let d = [x; 1usize << 60];
        let _ = (b[n], c[n], d[n]);
        return a[n];
    }
    x
}

fn main() {
    let n = std::env::args().count();
    println("{}", fill(7u8, n));
}
