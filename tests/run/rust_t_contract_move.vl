// EDITION: rust
// RULE: C3.2
// (0.27.1) A clause reads in place: a `requires` that moves a by-value
// parameter, and an `ensures` that moves `result`, are contract.move
// (at the argument); reading them, or a part, is fine.
// ERROR: error[contract.move]: a clause moves 'n'
// ERROR: line 20, column 18
// ERROR: error[contract.move]: a clause moves 'result'
// ERROR: line 26, column 17
// ERROR-COUNT: 2
struct N {
    v: i64,
}

fn eat(n: N) -> bool {
    n.v > 0
}

fn f(n: N) -> i64
    requires eat(n)
{
    n.v
}

fn g(n: N) -> N
    ensures eat(result)
{
    n
}

fn ok(n: N) -> N
    requires n.v > 0
    ensures result.v > 0
{
    n
}

fn main() {
    println("{} {} {}", f(N { v: 1 }), g(N { v: 2 }).v, ok(N { v: 3 }).v);
}
// (passes on std2: was XFAIL, std2 has no contract_check, which a contract's lowering calls (std2))
