// 0.25.2.1 (eval 0.25.2: windtunnel, qwen35): an f-string where a [u8] goes,
// and an f-string's method: format it, `format_in(f"...", gpa)`.
// ERROR: an f-string is a 'std::Interp' (a value that prints), not '[u8]'
// ERROR: help: format it: 'format_in(f"...", gpa)' makes the text
// ERROR: try: format_in(f"n={n}", gpa).as_slice()
// ERROR: no method 'as_slice' on type 'Interp<
// ERROR: help: an f-string is a value that prints, with no methods: format it, 'format_in(f"...", gpa)'
fn take(s: [u8]) -> i64 {
    s.len
}

fn main(gpa: Gpa) {
    let n = 3;
    take(f"n={n}");
    take(f"n={n}".as_slice());
}
