// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::slice::heap_sift_down_less'
// EXPECT: unstable ok
// EXPECT: stable ok
// EXPECT: noalloc ok
// EXPECT: big ok
// EXPECT: select ok
// EXPECT: search ok
// EXPECT: algo ok
// EXPECT: heap ok
// 0.20: std::slice's sorts and algorithms against simple models, on
// seeded random input (before 0.18's property tests): every length up to
// 300 and some long ones, in seven shapes (random, few distinct values,
// sorted, reversed, sawtooth runs, all equal, sorted with noise). The
// unstable sort must give insertion sort's order of keys; the stable one
// its order of (key, position) too; selection, binary search, dedup,
// retain, rotations and the heap sifts are checked against loops.

use std::slice::heap_sift_down_less; use std::slice::heap_sift_down_to_bottom_less;
use std::slice::heap_sift_up_less; use std::slice::sort_stable_less;
use std::slice::sort_stable_noalloc;

#[derive(Clone, Copy)] struct Rng { s: u64 }

fn next(r: &mut Rng) -> u64 {
    let mut x = r.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    r.s = x;
    x
}

// n keys of a shape.
fn make(r: &mut Rng, n: i64, shape: i64, out: &mut Vec<i64, Gpa>) {
    out.clear();
    for i in 0..n {
        let x = (next(r) >> 1) as i64;
        let k = if shape == 0 {
            x % 1000000
        } else if shape == 1 {
            x % 5
        } else if shape == 2 {
            i
        } else if shape == 3 {
            n - i
        } else if shape == 4 {
            i % 37
        } else if shape == 5 {
            7
        } else if x % 10 == 0 {
            x % 1000
        } else {
            i * 2
        };
        out.push(k);
    }
}

// The model: insertion sort by (key, position), stable.
fn model_sort(v: &mut Vec<(i64, i64), Gpa>) {
    let s = v.as_mut_slice();
    for i in 1..s.len() {
        let x = s[i];
        let mut j = i;
        for _ in 0..i {
            if s[j - 1].0 <= x.0 {
                break;
            }
            s[j] = s[j - 1];
            j -= 1;
        }
        s[j] = x;
    }
}

fn pairs(keys: &Vec<i64, Gpa>, out: &mut Vec<(i64, i64), Gpa>) {
    out.clear();
    let k = keys.as_slice();
    for i in 0..k.len() {
        out.push((k[i], i as i64));
    }
}

#[derive(Clone, Copy)]
struct Big { key: i64, pos: i64, pad: [i64; 62] }

fn main(gpa: Gpa) -> i32 {
    let mut r = Rng { s: 0x9E3779B97F4A7C15 };
    let mut keys: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut a: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    let mut m: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    let mut lens: Vec<i64, Gpa> = Vec::new_in(gpa);
    for n in 0..301 {
        lens.push(n);
    }
    lens.push(1000);
    lens.push(4097);
    lens.push(12000);
    let mut ok_u = true;
    let mut ok_s = true;
    let mut ok_n = true;
    for li in 0..lens.len() {
        let n = lens[li];
        for shape in 0..7 {
            if n > 4097 && shape != 0 && shape != 1 {
                continue;
            }
            make(&mut r, n, shape, &mut keys);
            pairs(&keys, &mut m);
            model_sort(&mut m);
            // unstable: the keys in order
            pairs(&keys, &mut a);
            if shape % 2 == 0 {
                a.as_mut_slice().sort_unstable_by(|a, b| (|x: (i64, i64), y: (i64, i64)| {
                    if x.0 < y.0 { -1 } else if x.0 > y.0 { 1 } else { 0 }
                })(a, b).cmp(&0));
            } else {
                a.as_mut_slice().sort_unstable_by_key(|x: (i64, i64)| x.0);
            }
            for i in 0..n {
                if a[i as usize].0 != m[i as usize].0 {
                    ok_u = false;
                }
            }
            // the plain one on the keys alone
            let mut k2: Vec<i64, Gpa> = Vec::new_in(gpa);
            for i in 0..n {
                k2.push(keys[i as usize]);
            }
            k2.as_mut_slice().sort_unstable();
            for i in 0..n {
                if k2[i as usize] != m[i as usize].0 {
                    ok_u = false;
                }
            }
            drop(k2);
            // stable, with an allocator: keys and positions in order
            pairs(&keys, &mut a);
            a
                .as_mut_slice()
                .sort_by_in(|a, b| (|x: (i64, i64), y: (i64, i64)| x.0 - y.0)(a, b).cmp(&0), gpa);
            for i in 0..n {
                if a[i as usize] != m[i as usize] {
                    ok_s = false;
                }
            }
            // stable, without (a 4 KB scratch: in-place merges past it)
            pairs(&keys, &mut a);
            sort_stable_less(a.as_mut_slice(), |x: (i64, i64), y: (i64, i64)| x.0 < y.0);
            for i in 0..n {
                if a[i as usize] != m[i as usize] {
                    ok_n = false;
                }
            }
        }
    }
    let mut k3: Vec<i64, Gpa> = Vec::new_in(gpa);
    make(&mut r, 5000, 0, &mut k3);
    sort_stable_noalloc(k3.as_mut_slice());
    k3.as_mut_slice().sort_in(gpa);
    for i in 1..k3.len() {
        if k3[i - 1] > k3[i] {
            ok_n = false;
        }
    }
    println("{}", if ok_u { "unstable ok" } else { "unstable WRONG" });
    println("{}", if ok_s { "stable ok" } else { "stable WRONG" });
    println("{}", if ok_n { "noalloc ok" } else { "noalloc WRONG" });

    // Elements of 512 bytes: 8 fit in the 4 KB scratch, no small sort.
    let mut ok_b = true;
    for n in [0i64, 1, 2, 7, 9, 33, 100, 333] {
        let mut b: Vec<Big, Gpa> = Vec::new_in(gpa);
        for i in 0..n {
            b.push(Big { key: (next(&mut r) % 7) as i64, pos: i, pad: [i; 62] });
        }
        sort_stable_less(b.as_mut_slice(), |x: Big, y: Big| x.key < y.key);
        for i in 0..n {
            if i > 0
                && (b[(i - 1) as usize].key > b[i as usize].key
                    || b[(i - 1) as usize].key == b[i as usize].key
                    && b[(i - 1) as usize].pos > b[i as usize].pos) {
                ok_b = false;
            }
            if b[i as usize].pad[61] != b[i as usize].pos {
                ok_b = false;
            }
        }
        b.as_mut_slice().sort_unstable_by(|a, b| (|x: Big, y: Big| y.pos - x.pos)(a, b).cmp(&0));
        for i in 0..n {
            if b[i as usize].pos != n - 1 - i || b[i as usize].pad[0] != b[i as usize].pos {
                ok_b = false;
            }
        }
        drop(b);
    }
    println("{}", if ok_b { "big ok" } else { "big WRONG" });

    // select_nth_unstable: the k-th, none greater before, none less after.
    let mut ok_sel = true;
    for n in [1i64, 2, 3, 16, 17, 100, 1000, 10007] {
        for shape in 0..7 {
            make(&mut r, n, shape, &mut keys);
            pairs(&keys, &mut m);
            model_sort(&mut m);
            for t in 0..4 {
                let k: i64 = if t == 0 { 0 } else if t == 1 { n - 1 }
                    else { (next(&mut r) % n as u64) as i64 };
                let mut s: Vec<i64, Gpa> = Vec::new_in(gpa);
                for i in 0..n {
                    s.push(keys[i as usize]);
                }
                if t == 3 {
                    s
                        .as_mut_slice()
                        .select_nth_unstable_by(k, |a, b| (|x: i64, y: i64| y - x)(a, b).cmp(&0));
                    if s[k as usize] != m[(n - 1 - k) as usize].0 {
                        ok_sel = false;
                    }
                } else {
                    s.as_mut_slice().select_nth_unstable(k);
                    if s[k as usize] != m[k as usize].0 {
                        ok_sel = false;
                    }
                    for i in 0..n {
                        if i < k && s[i as usize] > s[k as usize]
                            || i > k && s[i as usize] < s[k as usize] {
                            ok_sel = false;
                        }
                    }
                }
                drop(s);
            }
        }
    }
    println("{}", if ok_sel { "select ok" } else { "select WRONG" });

    // binary_search and partition_point against a scan.
    let mut ok_bs = true;
    for n in [0i64, 1, 2, 3, 10, 100, 1001] {
        make(&mut r, n, 1, &mut keys);
        keys.as_mut_slice().sort_unstable();
        let s = keys.as_slice();
        for q in -1..7 {
            let mut lt: i64 = 0;
            let mut eq: i64 = 0;
            for i in 0..n {
                if s[i as usize] < q {
                    lt += 1;
                } else if s[i as usize] == q {
                    eq += 1;
                }
            }
            match s.binary_search(&q) {
                Ok(i) => {
                    if eq == 0 || s[i as usize] != q {
                        ok_bs = false;
                    }
                }
                Err(i) => {
                    if eq != 0 || i != lt {
                        ok_bs = false;
                    }
                }
            }
            if s.partition_point(|x: i64| x < q) != lt {
                ok_bs = false;
            }
            match s.binary_search_by_key(&((q * 2)), |x: i64| x * 2) {
                Ok(i) => {
                    if s[i as usize] != q {
                        ok_bs = false;
                    }
                }
                Err(i) => {
                    if i != lt {
                        ok_bs = false;
                    }
                }
            }
        }
    }
    println("{}", if ok_bs { "search ok" } else { "search WRONG" });

    // dedup, retain, rotations, reverse, fill.
    let mut ok_a = true;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in [1i64, 1, 2, 3, 3, 3, 1, 4, 4] {
        v.push(x);
    }
    let d = v.as_mut_slice().dedup();
    if d != 5 || v[0] != 1 || v[1] != 2 || v[2] != 3 || v[3] != 1 || v[4] != 4 {
        ok_a = false;
    }
    v.clear();
    for x in [10i64, 11, 20, 21, 22, 30] {
        v.push(x);
    }
    if v.as_mut_slice().dedup_by_key(|x: i64| x / 10) != 3 || v[2] != 30 {
        ok_a = false;
    }
    v.clear();
    for i in 0..10 {
        v.push(i);
    }
    let kept = v.as_mut_slice().retain(|x: i64| x % 3 != 0);
    if kept != 6 || v[0] != 1 || v[1] != 2 || v[2] != 4 || v[5] != 8 {
        ok_a = false;
    }
    v.clear();
    for i in 0..7 {
        v.push(i);
    }
    v.as_mut_slice().rotate_left(3usize);
    if v[0] != 3 || v[3] != 6 || v[4] != 0 {
        ok_a = false;
    }
    v.as_mut_slice().rotate_right(3usize);
    v.as_mut_slice().reverse();
    if v[0] != 6 || v[6] != 0 {
        ok_a = false;
    }
    v.as_mut_slice().rotate_left(0usize);
    v.as_mut_slice().rotate_left(7usize);
    v.as_mut_slice().fill(9i64);
    if v[0] != 9 || v[6] != 9 {
        ok_a = false;
    }
    println("{}", if ok_a { "algo ok" } else { "algo WRONG" });

    // A max-heap built by sift_up and drained by sift_down_to_bottom
    // gives the keys largest first; sift_down after a decrease keeps it.
    let mut ok_h = true;
    for n in [1i64, 2, 5, 64, 1000] {
        make(&mut r, n, 0, &mut keys);
        let mut h: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..n {
            h.push(keys[i as usize]);
            let last = h.len() - 1;
            heap_sift_up_less(h.as_mut_slice(), 0i64, last as i64, |x: i64, y: i64| x < y);
        }
        if n > 1 {
            h[0] = -1;
            heap_sift_down_less(h.as_mut_slice(), 0i64, n, |x: i64, y: i64| x < y);
            h[0] = h[0];
        }
        let mut prev: i64 = 1 << 62;
        let mut end = n;
        for _ in 0..n {
            let s = h.as_mut_slice();
            let top = s[0];
            if top > prev {
                ok_h = false;
            }
            prev = top;
            end -= 1;
            s[0] = s[end as usize];
            if end > 0 {
                heap_sift_down_to_bottom_less(s, 0i64, end, |x: i64, y: i64| x < y);
            }
        }
        drop(h);
    }
    println("{}", if ok_h { "heap ok" } else { "heap WRONG" });
    0
}
