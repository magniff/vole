// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::as_deref.
// EXPECT: Some("hi") None
use std::option::Option;

fn main(gpa: Gpa) {
    let a: Option<String<Gpa>> = Some("hi".to_string_in(gpa));
    let b: Option<String<Gpa>> = None;
    let r: Option<&str> = a.as_deref();
    println("{:?} {:?}", r, b.as_deref());
}
