// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::thread spawn_in.
// EXPECT: 55
use std::thread;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || {
        let mut t = 0i64;
        let mut i = 1i64;
        while i <= 10 {
            t += i;
            i += 1;
        }
        t
    }, gpa);
    println("{}", h.join().unwrap());
}
