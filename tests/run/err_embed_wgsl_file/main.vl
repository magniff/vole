// 0.26.2: the file form's file is a file of the program, so its WGSL
// error is reported at the file's own line and column (0.26.0 reported
// it at the `from` string, the file's position in the message).
// ERROR: error[wgsl.name]: unknown name 'colour'
// ERROR: err_embed_wgsl_file/shaders/bad.wgsl: line 3, column 12
embed wgsl F from "shaders/bad.wgsl";

fn main() -> i32 {
    println(F.fs);
    0
}
