// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a30_unsafecell)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a shared reference (a cell)
// A callee writes through UnsafeCell::get of a field the clause reads through &.
use std::cell::UnsafeCell;
struct H { c: UnsafeCell<i64> }

fn poke(h: &H) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *h.c.get() = 9; }
    true
}

fn f(h: &H) -> i64
    requires poke(h)
{
    1
}

fn main() {
    let h = H { c: UnsafeCell::new(1) };
    println("{}", f(&h));
    // UNSAFE: test
    // SAFETY: test
    println("{}", unsafe { *h.c.get() });
}
