// EDITION: rust
// a closure that captures a Vec and passes it as an inout slice (`&v` where `inout [i64]` is wanted)
// EXPECT: 5
fn bump(s: &mut [i64]) { s[0] += 5; }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(0); let mut f = || bump(&mut v); f();
    println("{}", v[0]);
}
