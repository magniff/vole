// EDITION: rust
// XFAIL: gap 2: compile type error: no associated function 'to_fd' in 'Formatter'
// std's output buffer (0.15): a Fmt to a file descriptor fills a static
// 4 KB buffer that print writes out at its end; padding a hole that does
// not fit in what is left, text longer than the buffer, another file
// descriptor, and a print inside a Display impl keep every byte in order.
// The bytes written to a pipe are read back and compared with format's.
// EXPECT: cut 0: same, 4134 bytes
// EXPECT: cut 3: same, 4131 bytes
// EXPECT: cut 6: same, 4128 bytes
// EXPECT: cut 4090: same, 41 bytes
// EXPECT: huge: same, 12276 bytes
// EXPECT: to stdout, to the pipe and back
// EXPECT: a (nested)<7> b
// EXPECT: [4134, 4131, 4128, 41]
use std::fmt::Display; use std::fmt::Formatter as Fmt;

extern "C" {
    fn pipe(fds: *mut i32) -> i32;
    fn read(fd: i32, data: *mut u8, count: u64) -> i64;
    fn close(fd: i32) -> i32;
}

#[derive(Clone, Copy)] struct Noisy { n: i64 }

impl Display for Noisy {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        print("(nested)");
        write(f, "<{}>", self.n)?;
        Ok(()) }
}

// What fd's other end has, up to n bytes.
fn drain(fd: i32, n: i64, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut b: Vec<u8, Gpa> = Vec::new_in(gpa);
    let mut chunk: [u8; 512] = [0; 512];
    while b.len() as i64 < n {
        let k = unsafe { read(fd, &mut chunk[0], 512) };
        if k <= 0 {
            break;
        }
        b.extend_from_slice(&chunk[0..k as usize]);
    }
    b
}

fn check<T: Display>(what: T, got: Vec<u8, Gpa>, want: &String<Gpa>) {
    if got.as_slice() == want.as_bytes() {
        println("{what}: same, {} bytes", got.len());
    } else {
        println("{what}: differs: {} bytes, expected {}", got.len(), want.len());
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut fds: [i32; 2] = [0, 0];
    if unsafe { pipe(&mut fds[0]) } != 0 {
        return 1;
    }
    let mut big: Vec<u8, Gpa> = Vec::new_in(gpa);
    for i in 0..4090 {
        big.push(b'a' + (i % 26) as u8);
    }
    let text = big.as_slice();
    let mut sizes: Vec<i64, Gpa> = Vec::new_in(gpa);
    // holes that start 6, 3 and 0 bytes before the end of the buffer
    for cut in [0i64, 3, 6, 4090] {
        let head = &text[0..(text.len() as i64 - cut) as usize];
        let n: i64 = -42;
        let mut f = Fmt::to_fd(fds[1]);
        { let head = str::from_utf8(head).unwrap();
            write(f, "{head}{n:>8}|{n:08}|{:<5}|{head:.3}|{n:x}", "ab")? };

        let want = {
            let head = str::from_utf8(head).unwrap();
            format_in("{head}{n:>8}|{n:08}|{:<5}|{head:.3}|{n:x}", "ab", gpa)
        };
        let got = drain(fds[0], want.len() as i64, gpa);
        check(format_args("cut {cut}"), got, &want);
        sizes.push(want.len() as i64);
    }
    // longer than the buffer: written directly, after what is buffered
    let mut huge: Vec<u8, Gpa> = Vec::new_in(gpa);
    for i in 0..3 {
        huge.extend_from_slice(text);
    }
    let huge = huge.as_slice();
    let mut f = Fmt::to_fd(fds[1]);
    { let huge = str::from_utf8(huge).unwrap(); write(f, "[{}]{huge}[{}]", 1, 2)? };

    let want = { let huge = str::from_utf8(huge).unwrap(); format_in("[{}]{huge}[{}]", 1, 2, gpa) };
    check("huge", drain(fds[0], want.len() as i64, gpa), &want);
    // stdout and another descriptor in turn
    let mut g = Fmt::to_fd(fds[1]);
    g.write_str("to the pipe ")?;
    print("to stdout, ");
    g.write_str("and back")?;

    println("{}", str::from_utf8(drain(fds[0], 20, gpa).as_slice()).unwrap());
    // a print inside a Display impl: written in order
    let w = Noisy { n: 7 };
    println("a {w} b");
    println("{sizes:?}");
    unsafe {
        close(fds[0]);
        close(fds[1]);
    }
    0
}
