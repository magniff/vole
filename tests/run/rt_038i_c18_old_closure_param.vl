// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c18_old_closure_param)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// a closure param named as the moved param, inside old.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures old({ let a = [1i64]; a.iter().all(|s: &i64| *s > 0) })
{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
