// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl Ord.
// EXPECT: Less Equal
use std::vec::Vec;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1, 2], gpa);
    let b = Vec::from_in([2], gpa);
    println("{:?} {:?}", a.cmp(&b), a.cmp(&a));
}
