// RUSTC-EDITION: 2024
// RULE: D21.3
// (0.27.2.1) The opaque type is Copy only when a bound says so: its hidden
// `i32` does not make it one, and a second use is a use after move (rustc
// E0382).
// ERROR: error[borrowck.use_moved]
trait Show {
    fn show(&self) -> i32;
}

impl Show for i32 {
    fn show(&self) -> i32 { *self }
}

fn seven() -> impl Show {
    let n: i32 = 7;
    n
}

fn take<T: Show>(t: T) -> i32 {
    t.show()
}

fn main() {
    let a = seven();
    let b = take(a);
    let c = take(a);
    println("{} {}", b, c);
}
