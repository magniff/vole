// sem-own: sorting a Vec of owned values moves them without dropping.
// EXPECT: 1 2 3
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    var v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(mk(3, gpa)); v.push(mk(1, gpa)); v.push(mk(2, gpa));
    v.sort_by(|a, b| a.id - b.id);
    println("{} {} {}", v[0].id, v[1].id, v[2].id);
    println("end");
}
