// a closure stored into an Option declared outside the block of what it borrows
// ERROR: error[type error]
// ERROR: line 11, column 24
fn put<F>(o: &mut Option<F>, f: F) { *o = Some(f); }
fn none_of<F>(f: &F) -> Option<F> { None }

fn main() {
    let mut keep = none_of(|| 0);
    for i in 0..2 {
        let mut n = i + 40;
        put(&mut keep, || n);
    }
    println("{}", (keep.unwrap())());
}
