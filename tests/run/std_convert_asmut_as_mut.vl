// Runs on std since 0.27.2's switch.
// The std item(s): std::convert AsMut::as_mut.
// EXPECT: 3
use std::convert::{AsMut, Infallible};

struct W {
    v: i64,
}

impl AsMut<i64> for W {
    fn as_mut(&mut self) -> &mut i64 {
        &mut self.v
    }
}

fn main() {
    let mut w = W { v: 2 };
    *w.as_mut() += 1;
    println("{}", w.v);
}
