// Runs on std since 0.27.2's switch.
// The std item(s): std::option Option::as_deref_mut.
// EXPECT: Some("HI")
use std::option::Option;

fn main(gpa: Gpa) {
    let mut a: Option<String<Gpa>> = Some("hi".to_string_in(gpa));
    if let Some(s) = a.as_deref_mut() {
        s.make_ascii_uppercase();
    }
    println("{:?}", a.as_deref());
}
