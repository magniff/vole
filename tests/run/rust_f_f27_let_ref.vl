// EDITION: rust
// RULE: F27.2
// (0.27.6) `let ref x = e;` borrows a place, as `let x = &e;` does, and
// `let ref mut x = e;` as `let x = &mut e;`: `a` is not moved, and
// `vs[0]` and `n` change through the binding (0.27.5 moved `a` and
// changed a copy).
// EXPECT: 7 7 11 6 7 3 9
struct P {
    x: i64,
}

impl P {
    fn get(&self) -> i64 {
        self.x
    }
}

fn three() -> P {
    P { x: 3 }
}

fn main(gpa: Gpa) {
    let a = P { x: 7 };
    let ref z = a;
    let mut vs: Vec<i64, Gpa> = Vec::new_in(gpa);
    vs.push(1);
    vs.push(2);
    let ref mut w = vs[0];
    *w += 10;
    let mut n = 5i64;
    let ref mut m = n;
    *m += 1;
    let ref t = three();
    let ref u: i64 = 9;
    println("{} {} {} {} {} {} {}", z.x, a.x, vs[0], n, z.get(), t.get(), *u);
}
