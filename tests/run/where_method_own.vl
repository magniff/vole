// 0.27.0: a method's `where` on the impl's parameter bounds that method
// only: `get` of a Cell<Name> is not bounded by `reset`'s `T: Zero` (before,
// the bound went on the impl's parameter, shared by every method).
// EXPECT: 0 3
trait Zero {
    fn zero() -> Self;
}

impl Zero for i64 {
    fn zero() -> i64 {
        0
    }
}

struct Name {
    n: i64,
}

struct Cell<T> {
    v: T,
}

impl<T> Cell<T> {
    fn reset(self: inout Cell<T>) where T: Zero {
        self.v = T::zero();
    }

    fn get(self: Cell<T>) -> T {
        self.v
    }
}

fn main() -> i32 {
    var a = Cell { v: 5 };
    a.reset();
    let b = Cell { v: Name { n: 3 } };
    println("{} {}", a.get(), b.get().n);
    0
}
