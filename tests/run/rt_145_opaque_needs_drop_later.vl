// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145) `needs_drop` of a tuple holding an opaque
// type whose function is checked after the use (late) is its hidden
// type's: true (0.30.2's first try: false, kept from before late was
// checked). The output is rustc's. (l19 of the review)
// EXPECT: true true false true
// EXPECT: 3 2
fn nd<T>(_t: &T) -> bool {
    std::mem::needs_drop::<T>()
}

fn early(gpa: Gpa) -> impl Fn() -> usize {
    let s = String::from_in("abc", gpa);
    move || s.len()
}

fn plain(k: i64) -> impl Fn() -> i64 {
    move || k
}

fn main(gpa: Gpa) {
    let a = early(gpa);
    let b = late(gpa);
    let c = plain(1);
    let t = (late(gpa), 1i64);
    println("{} {} {} {}", nd(&a), nd(&b), nd(&c), nd(&t));
    println("{} {}", a(), b());
}

fn late(gpa: Gpa) -> impl Fn() -> usize {
    let s = String::from_in("de", gpa);
    move || s.len()
}
