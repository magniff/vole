// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Drain.
// EXPECT: 1 0
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Drain;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let d: Drain<'_, i64, i64, Gpa> = m.drain();
    let n = d.count();
    println("{} {}", n, m.len());
}
