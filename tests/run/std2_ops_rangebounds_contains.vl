// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops RangeBounds::contains.
// EXPECT: true false true
use std::ops::RangeBounds;

fn has<R: RangeBounds<i64>>(r: &R, x: i64) -> bool {
    r.contains(&x)
}

fn main() {
    println("{} {} {}", has(&(1..4), 3), has(&(1..4), 4), has(&(..=4), 4));
}
