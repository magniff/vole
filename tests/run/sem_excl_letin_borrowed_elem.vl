// let x = v[i] on an owned element borrows (D13): it is read-only
// ERROR: error[type error]
// ERROR: line 9, column 10
fn grow(v: &mut Vec<i64, Gpa>) { v.push(1); }

fn main(gpa: Gpa) {
    let mut vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa); vs.push(Vec::new_in(gpa));
    let x = &vs[0];
    grow(x);
    println("{}", vs[0].len());
}
