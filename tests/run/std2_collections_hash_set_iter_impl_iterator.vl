// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set Iter::impl Iterator.
// EXPECT: Some(1) None
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    let mut it = s.iter();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
