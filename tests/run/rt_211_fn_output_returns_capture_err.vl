// RT-211 review 3 (u01): the attack on fn_output_slot: a closure whose
// result borrows its capture, `.map(|_x| &w[0])`, makes Map's B the
// capture's region (the closure's requirement on its X_C position), so the
// result of `first` keeps w borrowed and `drop(w)` is refused (rustc
// E0505). v0.30.1 built it: a use after free.
// ERROR: line 20
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(5000);
    let r = first(v.iter().map(|_x| &w[0]), &k);
    drop(w);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?}", r, x);
}
