// (0.30.1) On a spawned thread (an 8 MiB stack), a frame of 16 MiB (its
// local in a branch not taken) faults on the thread's guard page as it is
// entered, as on the main thread's (the frame is probed page by page, top
// to bottom), and writes nothing past it: before, sp moved below the
// thread's stack, into whatever was mapped there, and the function wrote
// its frame there. The program runs itself as a child, which dies by the fault
// (SIGBUS on macOS, SIGSEGV on Linux) having printed only "before".
// EXPECT: child: before
// EXPECT: stopped by a memory fault
use std::thread;
use std::process::Command;

#[inline(never)]
fn big(k: usize) -> u8 {
    if k > 5 {
        let mut a = [0u8; 16777216];
        a[k] = 1;
        return a[k];
    }
    println("inside");
    0
}

fn main(gpa: Gpa) {
    let k = std::env::args().count();
    if k > 1 {
        println("before");
        let h = thread::spawn_in(move || big(k), gpa);
        println("after {}", h.join().unwrap());
        return;
    }
    let me = std::env::args().next().unwrap();
    let out = Command::new_in(me, gpa).arg("child").output().unwrap();
    print("child: {}", str::from_utf8(out.stdout.as_slice()).unwrap());
    let sig = out.status.signal();
    if sig == Option::Some(10) || sig == Option::Some(11) {
        println("stopped by a memory fault");
    } else {
        println("not stopped by a fault: {}", out.status);
    }
}
