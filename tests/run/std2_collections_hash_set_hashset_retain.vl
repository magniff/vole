// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_set HashSet::retain.
// EXPECT: [2, 4]
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    for i in 1..5i64 {
        s.insert(i);
    }
    s.retain(|x: &i64| *x % 2 == 0);
    let mut v: Vec<i64, Gpa> = s.iter().copied().collect_in(gpa);
    v.sort();
    println("{:?}", v);
}
