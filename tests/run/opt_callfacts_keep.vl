// EXPECT: scalar 8 8
// EXPECT: element 11 17
// EXPECT: other 8 8 3
// EXPECT: local 14 14
// EXPECT: nested 8 8
// EXPECT: rec 13 14
// EXPECT: slot 5 9
// EXPECT: reads 8 8
// (0.29) A Vec's header across a call (middle::callfacts): the callee's
// summary says which Vec headers it may write, and a caller that read a
// Vec's ptr and len before the call does not read them again, nor check
// the same index again, when the summary does not reach them. Each
// function below indexes cx.insts before and after a call: after it
// there is no compare (the first check's is the only one).
// - scalar: the callee writes another field of the struct;
// - element: it writes an element (the buffer is not the header);
// - other: it pushes to another Vec of the same struct (the summary's
//   range of offsets);
// - local: it fills and drops a Vec of its own (the allocator's blocks);
// - nested: a callee that calls such callees;
// - rec: a recursive callee that writes elements (the component's
//   fixpoint);
// - slot: the Vec is a local of the caller, lent to a callee that
//   writes an element;
// - reads: a callee that only reads through `&mut`.
// (Not under --check-alloc: the checking allocator's own tables are
// written through raw pointers, and a callee that allocates is unknown.)
// CHECK: fn after_scalar:
// CHECK: call bump
// CHECK-NOT: cmp
// CHECK: ret
// CHECK: fn after_element:
// CHECK: call poke
// CHECK-NOT: cmp
// CHECK: ret
// CHECK: fn after_other:
// CHECK: call push_block
// CHECK-NOT: cmp
// CHECK: ret
// CHECK: fn after_local:
// CHECK: call scratch
// CHECK-NOT: cmp
// CHECK: ret
// CHECK: fn after_nested:
// CHECK: call both
// CHECK-NOT: cmp
// CHECK: ret
// CHECK: fn after_rec:
// CHECK: call fill_down
// CHECK-NOT: cmp
// CHECK: ret
// CHECK: fn after_slot:
// CHECK: call poke_vec
// CHECK-NOT: cmp
// CHECK: i64 = add
// CHECK: fn after_reads:
// CHECK: call total
// CHECK-NOT: cmp
// CHECK: ret
use std::alloc::Allocator;

struct Cx<A: Allocator> { insts: Vec<i64, A>, blocks: Vec<i64, A>, n: i64 }

#[inline(never)]
fn bump(cx: &mut Cx<Gpa>) {
    cx.n += 1;
}

#[inline(never)]
fn poke(cx: &mut Cx<Gpa>, i: usize, x: i64) {
    cx.insts[i] = x;
}

#[inline(never)]
fn push_block(cx: &mut Cx<Gpa>, x: i64) {
    cx.blocks.push(x);
}

#[inline(never)]
fn scratch(cx: &mut Cx<Gpa>, gpa: Gpa) -> i64 {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..40 {
        w.push(i + cx.n);
    }
    let mut s = 0;
    for i in 0..w.len() {
        s += w[i];
    }
    cx.n = s;
    s
}

#[inline(never)]
fn both(cx: &mut Cx<Gpa>, x: i64) {
    bump(cx);
    push_block(cx, x);
    poke(cx, 0, x);
}

#[inline(never)]
fn fill_down(cx: &mut Cx<Gpa>, i: usize, x: i64) {
    cx.insts[i] = x;
    if i > 0 {
        fill_down(cx, i - 1, x + 1);
    }
}

#[inline(never)]
fn poke_vec(v: &mut Vec<i64, Gpa>, i: usize, x: i64) {
    v[i] = x;
}

#[inline(never)]
fn total(cx: &mut Cx<Gpa>) -> i64 {
    let mut s = 0;
    for i in 0..cx.insts.len() {
        s += cx.insts[i];
    }
    s
}

#[inline(never)]
fn after_scalar(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    bump(cx);
    a + cx.insts[i]
}

#[inline(never)]
fn after_element(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    poke(cx, i, a + 3);
    a + cx.insts[i]
}

#[inline(never)]
fn after_other(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    push_block(cx, a);
    a + cx.insts[i]
}

#[inline(never)]
fn after_local(cx: &mut Cx<Gpa>, i: usize, gpa: Gpa) -> i64 {
    let a = cx.insts[i];
    scratch(cx, gpa);
    a + cx.insts[i]
}

#[inline(never)]
fn after_nested(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    both(cx, 4);
    a + cx.insts[i]
}

#[inline(never)]
fn after_rec(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    fill_down(cx, i, 9);
    a + cx.insts[i]
}

#[inline(never)]
fn after_slot(i: usize, gpa: Gpa) -> i64 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for k in 0..6 {
        v.push(k);
    }
    let a = v[i];
    poke_vec(&mut v, i, a + 1);
    a + v[i]
}

#[inline(never)]
fn after_reads(cx: &mut Cx<Gpa>, i: usize) -> i64 {
    let a = cx.insts[i];
    let t = total(cx);
    a + cx.insts[i] + t - t
}

fn fresh(gpa: Gpa) -> Cx<Gpa> {
    let mut cx = Cx { insts: Vec::new_in(gpa), blocks: Vec::new_in(gpa), n: 0 };
    for k in 0..6 {
        cx.insts.push(k + 3);
    }
    cx
}

fn main(gpa: Gpa) -> i32 {
    let mut cx = fresh(gpa);
    println("scalar {} {}", after_scalar(&mut cx, 1), after_scalar(&mut cx, 1));
    println("element {} {}", after_element(&mut cx, 1), after_element(&mut cx, 1));
    let mut cx = fresh(gpa);
    println("other {} {} {}", after_other(&mut cx, 1), after_other(&mut cx, 1),
        cx.blocks.len() + 1);
    println("local {} {}", after_local(&mut cx, 4, gpa), after_local(&mut cx, 4, gpa));
    let mut cx = fresh(gpa);
    println("nested {} {}", after_nested(&mut cx, 1), after_nested(&mut cx, 1));
    println("rec {} {}", after_rec(&mut cx, 1), after_rec(&mut cx, 2));
    println("slot {} {}", after_slot(2, gpa), after_slot(4, gpa));
    let mut cx = fresh(gpa);
    println("reads {} {}", after_reads(&mut cx, 1), after_reads(&mut cx, 1));
    0
}
