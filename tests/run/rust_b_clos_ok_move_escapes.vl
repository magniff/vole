// EDITION: rust
// RULE: D19.8
// (0.27.2) A `move` closure of owned values leaves the block of what it
// captured: 0.14's escape check is off in the rust edition, and nothing
// borrows the block's locals.
// EXPECT: 6
fn main() {
    let f;
    {
        let v = 5;
        f = move || v + 1;
    }
    println("{}", f());
}
