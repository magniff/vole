// RULE: M2, M8
// (0.30.1) Deferred lets in loops that rustc accepts: declared in the body
// and assigned on each branch, assigned whole then a field each iteration,
// assigned in the loop before a break and a field after it, moved and
// assigned anew each iteration.
// EXPECT: 5 9 7 8
struct P {
    a: i64,
    b: i64,
}

fn a() -> i64 {
    let mut n = 0;
    let mut i = 0;
    while i < 3 {
        let p: P;
        if i % 2 == 0 {
            p = P { a: i, b: 1 };
        } else {
            p = P { a: 0, b: i };
        }
        n += p.a + p.b;
        i += 1;
    }
    n
}

fn b() -> i64 {
    let mut n = 0;
    for i in 0..3 {
        let mut t: (i64, i64);
        t = (i, i);
        t.1 += 1;
        n += t.0 + t.1;
    }
    n
}

fn c(v: &mut Vec<i64, Gpa>) -> i64 {
    let mut q: P;
    loop {
        q = P { a: v.len() as i64, b: 2 };
        if q.a > 0 {
            break;
        }
        v.push(1);
    }
    q.a = 5;
    q.a + q.b
}

fn d() -> i64 {
    let mut i = 0;
    let mut p: P;
    p = P { a: 0, b: 0 };
    while i < 4 {
        let q = p;
        p = P { a: q.a + 1, b: q.b };
        p.b += 1;
        i += 1;
    }
    p.a + p.b
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{} {} {} {}", a(), b(), c(&mut v), d());
}
