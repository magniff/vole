// EDITION: rust
// XFAIL: gap 17: compile type error: conflicting impls of trait 'Clone' for 'T' (one impl per trait and type)
// (0.25, the semantics fuzzer) At -O2 the clone of an empty Vec field
// reads as non-empty in a later loop: `w25.len() > 0` holds and `o12`
// lines are printed; -O0 and -O1 print none. Found by
// tools/semfuzz/semfuzz.py (seed 1508), shrunk and reduced by hand.
// FLAGS: -O2
// EXPECT: o9 0
// EXPECT: o11 7

use std::alloc::Allocator; #[derive(Clone, Copy)] struct T { id: i64, v: i64 }

impl Clone for T {
    fn clone(&self) -> T { T { id: 0, v: self.v } }
}

#[derive(Clone)]
struct S<A: Allocator> { t: T, w: Vec<T, A> }

fn vsig(w: &Vec<T, Gpa>) -> i64 {
    let mut h: i64 = 7;
    for x in w { h = h * 31 + x.id * 100; }
    h
}

fn run(gpa: Gpa) {
    let mut s20 = S { t: T { id: 1, v: 2 }, w: Vec::new_in(gpa) };
    let mut w25 = s20.w.clone();
    for i32 in 0..1 {
        println("o9 {i32}");
    }
    println("o11 {}", vsig(&w25));
    for i37 in 0..2 {
        if w25.len() > 0 {
            println("o12 {i37}");
        }
    }
}

fn main(gpa: Gpa) -> i32 { run(gpa); 0 }
