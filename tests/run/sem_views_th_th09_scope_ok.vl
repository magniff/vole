// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 3 hello
// EXPECT: 3 hello
use std::thread;

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello", gpa);
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(s.as_str());
    v.push(s.as_str());
    v.push(s.as_str());
    let n = thread::scope(|s| ({ let sc = s; {
        let a = sc.spawn(|| v.len());
        a.join().unwrap()
    } }));
    println("{n} {}", v[0usize]);
    0
}
