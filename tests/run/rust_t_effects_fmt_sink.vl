// RULE: E4.3a
// (0.28.0) A Formatter's sink is its maker's effect: a format_in is no
// io in a program that prints, a println allocates nothing in a program
// that formats into a String, a Display impl does what its own body
// does, whatever it is written into, and a write into a program's sink
// does what that sink's write_str does.
use std::fmt::{Display, Formatter, Result, Write};

struct P {
    x: i64,
    y: i64,
}

impl Display for P {
    #[effects(panic, diverge)]
    fn fmt(&self, f: &mut Formatter) -> Result {
        f.write_str("(")?;
        write(f, "{}, {}", self.x, self.y)?;
        f.write_str(")")
    }
}

// A sink of the program's: it counts the bytes written.
struct Count {
    n: usize,
}

impl Write for Count {
    #[effects()]
    fn write_str(&mut self, s: &str) -> Result {
        self.n += s.len();
        Ok(())
    }
}

#[no_io]
fn label(x: i64, gpa: Gpa) -> String<Gpa> {
    format_in("n={}", x, gpa)
}

#[no_io]
fn shown(p: &P, gpa: Gpa) -> String<Gpa> {
    format_in("{}", p, gpa)
}

#[no_alloc]
fn show(x: i64) {
    println("{}", x);
}

#[no_alloc]
fn text() {
    println("text");
}

#[no_alloc]
#[no_io]
fn width(p: &P) -> usize {
    let mut c = Count { n: 0 };
    let _ = write(&mut c, "{}", p);
    c.n
}

fn main(gpa: Gpa) {
    let s = label(3, gpa);
    println("{}", s);
    show(4);
    text();
    let p = P { x: 1, y: 2 };
    println("{} {} {}", p, shown(&p, gpa), width(&p));
}
// EXPECT: n=3
// EXPECT: 4
// EXPECT: text
// EXPECT: (1, 2) (1, 2) 6
