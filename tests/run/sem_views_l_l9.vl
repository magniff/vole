#[derive(Clone, Copy)] struct E { name: [u8; 8], len: i64 }
fn keep(out: &mut Vec<&[u8], Gpa>, e: E) { out.push(&e.name[..e.len as usize]); }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main(gpa: Gpa) -> i32 {
    let e = E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 };
    let mut out: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    keep(&mut out, e);
    let k = clobber();
    println("{}", str::from_utf8(out[0usize]).unwrap());
    println("{}", k);
    0
}
