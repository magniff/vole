// EDITION: rust
// sink closures holding R: never called, called once, copied (moved), each R dropped once
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: 2
// EXPECT: 3 3
// EXPECT: end
// EXPECT: drop 3
// EXPECT: drop 1
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn call<F: FnMut() -> i64>(f: F) -> i64 { f() }

fn main() {
    let a = R { id: 1 };
    let b = R { id: 2 };
    let c = R { id: 3 };
    let ka = move || a.id;
    let kb = move || b.id;
    let kb2 = kb;
    println("{}", call(kb2));
    let kc = move || c.id;
    println("{} {}", kc(), kc());
    println("end");
}
