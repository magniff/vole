// RULE: D21.6 (0.30.2, RT-213) Through a reference an `impl FnOnce` value
// cannot be called (its call moves it, rustc E0507), nor an `impl FnMut`
// through a shared one (its call changes it, E0596): std's `Fn*` impls
// for references, as the bound test reads them (RT-166). A captureless
// hidden closure (`|| 5`) and a capturing one alike: 0.30.2's first try
// called the hidden closure through the reference. (k03, k26 of the
// review of the opaque-type work)
// ERROR: line 28
// ERROR: line 31
// ERROR: line 34
// ERROR-COUNT: 3
fn once() -> impl FnOnce() -> i64 {
    || 5
}

fn once_cap(k: i64) -> impl FnOnce() -> i64 {
    move || k
}

fn counter() -> impl FnMut() -> i64 {
    let k = 5;
    move || k
}

fn main() {
    let g = once();
    let r = &g;
    println("{}", r()); // error here
    let g2 = once_cap(1);
    let r2 = &g2;
    println("{}", r2()); // error here
    let mut c = counter();
    let rc = &c;
    println("{}", rc()); // error here
    let rm = &mut c;
    println("{}", rm());
}
