// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Entry.
// EXPECT: occupied vacant
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Entry;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let a = match m.entry(1) {
        Entry::Occupied(_) => "occupied",
        Entry::Vacant(_) => "vacant",
    };
    let b = match m.entry(2) {
        Entry::Occupied(_) => "occupied",
        Entry::Vacant(_) => "vacant",
    };
    println("{} {}", a, b);
}
