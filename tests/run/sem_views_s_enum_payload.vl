enum E<'a> { A(&'a str), B } impl Clone for E<'_> { fn clone(&self) -> Self { *self } }
fn f(e: E<'_>) -> &str { match e { E::A(x) => x, E::B => "" } }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let e = E::A(w);
    let r = f(e);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
