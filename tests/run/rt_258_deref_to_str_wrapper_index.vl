// XFAIL: RT-258: a program's type with Deref<Target = str> (and DerefMut) is not indexed by a range: "cannot deref non-pointer type '&mut str'" (0.30.2)
// rustc autoderefs `w[3..]` and `&mut w[3..]` to the str and prints the
// EXPECT lines. vole's index autoderef (front/check/index.vl IX_DEREF)
// makes `*w` of the wrapper, whose deref gives the view itself, and then
// derefs that view. RT-186 is the coercion `&t` as `&str`; this is the
// index. From the review of g302index (forms u09, u10); v0.30.1 the same.
// EXPECT: llo
// EXPECT: hé LLO
use std::ops::{Deref, DerefMut};

struct W<'a> {
    s: &'a mut str,
}

impl<'a> Deref for W<'a> {
    type Target = str;

    fn deref(&self) -> &str {
        self.s
    }
}

impl<'a> DerefMut for W<'a> {
    fn deref_mut(&mut self) -> &mut str {
        self.s
    }
}

fn main(gpa: Gpa) {
    let mut x = String::from_in("héllo", gpa);
    let mut w = W { s: x.as_mut_str() };
    println("{}", &w[3..]);
    let m: &mut str = &mut w[3..];
    m.make_ascii_uppercase();
    println("{} {}", &w[..3], &w[3..]);
}
