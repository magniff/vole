// XFAIL: RT-49: a field read of a temporary whose type has a Drop is an unsafe effect ("reads through a raw pointer") (0.30.2)
// A safe read of a field of a temporary (a call's result, a struct
// literal) whose type implements Drop has no unsafe operation; rustc
// builds the same program (without the attribute). Without the Drop
// impl the same functions pass.
// EXPECT: 2 4 6
struct T {
    k: i64,
}

impl Drop for T {
    fn drop(&mut self) {}
}

fn mk(k: i64) -> T {
    T { k }
}

#[effects()]
fn from_call(k: i64) -> i64 {
    mk(k).k + 1
}

#[effects()]
fn from_literal(k: i64) -> i64 {
    T { k }.k + 1
}

#[effects()]
fn from_let(k: i64) -> i64 {
    let t = mk(k);
    t.k + 1
}

fn main() -> i32 {
    println("{} {} {}", from_call(1), from_literal(3), from_let(5));
    0
}
