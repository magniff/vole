// XFAIL(x86_64-macos): RT-CG-2: -O0 forwards a stack store of an earlier function into a later function's load (open)
// FLAGS: -O0
// EXPECT: 0
// EXPECT: after 3
// The bug is x86-64 only in this program: run it as
// `tests/run.sh -t x86_64-macos -O 0 -n rt_cg_002_gen0_stale_store_forward`
// (on aarch64-macos it passes). It depends on byte positions in the
// per-function code buffer, so a change to std's iterator code may hide it.
fn main(gpa: Gpa) {
    let x = (0i64..3i64).take(4).skip(3).count();
    println("{}", x);
    let v61: Vec<u8, Gpa> = Vec::new_in(gpa);
    let m = v61.iter().map(|q| *q).chain(1u8..4u8).count();
    println("after {}", m);
}
