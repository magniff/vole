// (0.17, T7) std on owned element types: std::swap exchanges bit for bit
// (it dropped and double-freed through its assignments), and
// the iterators' fold hands a closure the elements they read, as a for
// loop does (it was own.move_out inside std).
use std::mem; use std::alloc::Allocator; #[derive(Clone)]
struct N<A: Allocator> { v: Vec<i64, A> }

fn main(gpa: Gpa) -> i32 {
    let mut a = N { v: Vec::new_in(gpa) };
    let mut b = N { v: Vec::new_in(gpa) };
    b.v.push(1);
    mem::swap(&mut a, &mut b);
    let mut xs: Vec<N<Gpa>, Gpa> = Vec::new_in(gpa);
    xs.push(a.clone());
    let total = xs.iter().map(|n| n.v.len()).fold(0i64, |s, k| s + k as i64);
    let mut ys: Vec<N<Gpa>, Gpa> = Vec::new_in(gpa);
    for x in xs.iter() {
        ys.push(x.clone());
    }
    println("{total} {} {}", ys.len(), b.v.len());
    0
}
// FLAGS: --check-alloc
// EXPECT: 1 1 0
