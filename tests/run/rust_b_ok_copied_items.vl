// RULE: D4.6
// (0.27.7) The items of `args.iter().copied()` (and `.cloned()`) are the
// `&'a str`s the vector holds, not borrows of the vector: Copied's `type
// Item = T;` is read through its bound `I: Iterator<Item = &'a T>`, at T
// Iter's T (D4.6 (h)). 0.27.6 tied them to the borrow of `args`,
// borrowck.return_local, which rustc accepts (the flip rehearsal's F4).
// EXPECT: x y
// EXPECT: 2
fn first<'a, I: Iterator<Item = &'a str>>(mut it: I) -> &'a str {
    it.next().unwrap()
}

fn last<'a, I: Iterator<Item = &'a str>>(it: I) -> &'a str {
    let mut out = "";
    for s in it {
        out = s;
    }
    out
}

fn f<'a>(w: &'a str, v: &'a str, gpa: Gpa) -> (&'a str, &'a str) {
    let mut args: Vec<&str, Gpa> = Vec::new_in(gpa);
    args.push(w);
    args.push(v);
    (first(args.iter().copied()), last(args.iter().cloned()))
}

fn count<'a, I: Iterator<Item = &'a str>>(it: I) -> i64 {
    let mut n = 0;
    for _s in it {
        n += 1;
    }
    n
}

fn main(gpa: Gpa) {
    let (a, b) = f("x", "y", gpa);
    println("{} {}", a, b);
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(a);
    v.push(b);
    println("{}", count(v.iter().copied()));
}
