// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::convert From::from.
// EXPECT: 3 Some(4)
use std::convert::{From, Infallible};

struct M {
    v: i64,
}

impl From<i64> for M {
    fn from(v: i64) -> M {
        M { v: v }
    }
}

fn main() {
    let m: M = From::from(3i64);
    let o: Option<i64> = Option::from(4i64);
    println("{} {:?}", m.v, o);
}
