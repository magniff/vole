// EDITION: rust
// RULE: D22.1, D22.2
// (0.27.2.1) One template calls another with its Ω: the callee's instance
// for Ω is made and checked too.
// EXPECT: 0
trait Show {
    fn show(&self) -> i32;
}

fn outer<T: Show>(t: &T) -> i32 {
    inner(t) + 1
}

fn inner<U: Show>(u: &U) -> i32 {
    u.show()
}

fn main() {
    println("0");
}
