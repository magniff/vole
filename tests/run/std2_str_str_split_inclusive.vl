// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::split_inclusive.
// EXPECT: ["Mary had a little lamb\n", "little lamb\n"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "Mary had a little lamb\nlittle lamb\n"
        .split_inclusive('\n')
        .collect_in(gpa);
    println("{:?}", v);
}
