// EDITION: rust
// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): Option::unwrap's `requires self.is_some()`, violated last.
// EXPECT: 1
// EXIT: 101
// STDERR: called `Option::unwrap()` on a `None` value

fn main() {
    let a: Option<i64> = Option::Some(1);
    let b: Option<i64> = Option::None;
    println("{}", a.unwrap());
    let x = b.unwrap();
}
