// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::char char::to_lowercase.
// EXPECT: a é ж ω 2 i̇
use std::char::from_u32;

fn down(c: char) -> usize {
    let mut n: usize = 0;
    let mut it = c.to_lowercase();
    while let Some(l) = it.next() {
        print("{}", l);
        n += 1;
    }
    n
}

fn main() {
    let cs = ['A', 'É', 'Ж', 'Ω'];
    let mut i: usize = 0;
    while i < cs.len() {
        down(cs[i]);
        print(" ");
        i += 1;
    }
    let mut it = 'İ'.to_lowercase();
    let mut n: usize = 0;
    while let Some(_) = it.next() {
        n += 1;
    }
    print("{} ", n);
    down('İ');
    println("");
}
