// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::expect_err.
// EXPECT: bad
// EXIT: 101
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    println("{}", b.expect_err("b is an error"));
    println("{}", a.expect_err("a is an error"));
}
