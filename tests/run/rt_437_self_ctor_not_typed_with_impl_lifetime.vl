struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

struct Q<'a>(&'a D);

impl<'a> Q<'a> {
    fn make() {
        let d = D { n: 1 };
        let q = Self(&d);
        println("{}", q.0.n);
    }
}

fn main() {
    Q::make();
