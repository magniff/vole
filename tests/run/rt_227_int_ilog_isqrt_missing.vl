// XFAIL: RT-227: the integer logarithms and square roots are missing at every integer width: ilog, ilog2, ilog10, isqrt and their checked_ forms (0.30.2)
// rustc 1.98 prints the EXPECT lines (twin: r302e_004_int_ilog_isqrt.rs.txt); guide rust does not list them as missing.
// EXPECT: i8 4 6 2 10 Some(4) Some(6) Some(2) Some(10)
// EXPECT: i16 4 6 2 10 Some(4) Some(6) Some(2) Some(10)
// EXPECT: i32 4 6 2 10 Some(4) Some(6) Some(2) Some(10)
// EXPECT: i64 4 6 2 10 Some(4) Some(6) Some(2) Some(10)
// EXPECT: isize 4 6 2 10 Some(4) Some(6) Some(2) Some(10)
// EXPECT: u8 4 6 2 10 Some(4) Some(6) Some(2)
// EXPECT: u16 4 6 2 10 Some(4) Some(6) Some(2)
// EXPECT: u32 4 6 2 10 Some(4) Some(6) Some(2)
// EXPECT: u64 4 6 2 10 Some(4) Some(6) Some(2)
// EXPECT: usize 4 6 2 10 Some(4) Some(6) Some(2)
fn main() {
    let a: i8 = 100;
    let b: i8 = 3;
    println("i8 {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(),
        a.isqrt(), a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10(), a.checked_isqrt());
    let a: i16 = 100;
    let b: i16 = 3;
    println("i16 {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(),
        a.isqrt(), a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10(), a.checked_isqrt());
    let a: i32 = 100;
    let b: i32 = 3;
    println("i32 {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(),
        a.isqrt(), a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10(), a.checked_isqrt());
    let a: i64 = 100;
    let b: i64 = 3;
    println("i64 {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(),
        a.isqrt(), a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10(), a.checked_isqrt());
    let a: isize = 100;
    let b: isize = 3;
    println("isize {:?} {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(),
        a.isqrt(), a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10(), a.checked_isqrt());
    let a: u8 = 100;
    let b: u8 = 3;
    println("u8 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(), a.isqrt(),
        a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10());
    let a: u16 = 100;
    let b: u16 = 3;
    println("u16 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(), a.isqrt(),
        a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10());
    let a: u32 = 100;
    let b: u32 = 3;
    println("u32 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(), a.isqrt(),
        a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10());
    let a: u64 = 100;
    let b: u64 = 3;
    println("u64 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(), a.isqrt(),
        a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10());
    let a: usize = 100;
    let b: usize = 3;
    println("usize {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.ilog(b), a.ilog2(), a.ilog10(), a.isqrt(),
        a.checked_ilog(b), a.checked_ilog2(), a.checked_ilog10());
}
