// EDITION: rust
// The std2 item(s): std::slice Split::impl Iterator.
// EXPECT: 3 [] [] [1]

fn main() {
    let s: &[i64] = &[0, 1, 0];
    let mut n = 0;
    let mut longest: &[i64] = &[];
    for part in s.split(|x| *x == 0) {
        n += 1;
        if part.len() > longest.len() {
            longest = part;
        }
    }
    let first = s.split(|x| *x == 0).next().unwrap();
    println("{} {:?} {:?} {:?}", n, first, s.split(|x| *x == 0).last().unwrap(), longest);
}
