// RT-309 (closed in 0.30.2): UNSOUND: (RT-297's root, the other Option and Result methods) a fn item whose result borrows its argument, given to Result::and_then, Result::map_or_else, Option::map_or, Option::map_or_else, Result::unwrap_or_else, Result::map_err, Result::or_else, and_then(gid::<&i64>), map(gref::<i64>), map(wrap), map(idr).flatten(), inspect(..).map(idr2), keeps no borrow: a use after free (0.30.2)
// rustc E0505 at each drop (twin .rs.txt). Each form alone
// (scratch r302g/fn/p/f01-f30) checks clean and --check-alloc stops with
// `use after free: block #1 (32 bytes)`. RT-297 has Option::map and
// and_then with a fn item, RT-297b a program's FnOnce and Result::map,
// RT-297c method values. Here the same gap through every other std method
// that takes a function, and through generic fn items (`gid::<&i64>`: an
// explicit type argument, not a late-bound lifetime). The closure forms
// and the direct calls (`gid::<&i64>(&v[0])`, `let f = gref::<i64>;
// f(&v[0])`) keep the borrow (scratch fn/c).
// FLAGS: --check-alloc
// ERROR: line 68
// ERROR: line 72
// ERROR: line 75
// ERROR: line 78
// ERROR: line 82
// ERROR: line 86
// ERROR: line 90
// ERROR: line 93
// ERROR: line 96
// ERROR: line 99
// ERROR: line 102
// ERROR: line 105
// ERROR-COUNT: 12
struct Wr<'a> {
    r: &'a i64,
}

fn idr<'a>(x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn okr<'a>(x: &'a i64) -> Result<&'a i64, i64> {
    Ok(x)
}

fn errr2<'a>(x: &'a i64) -> Result<i64, &'a i64> {
    Err(x)
}

fn gid<T>(x: T) -> Option<T> {
    Some(x)
}

fn gref<T>(x: &T) -> &T {
    x
}

fn wrap<'a>(x: &'a i64) -> Wr<'a> {
    Wr { r: x }
}

fn mkv(k: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(k);
    v
}

fn main(gpa: Gpa) {
    let z = 7i64;
    let v1 = mkv(1, gpa);
    let r1: Result<&i64, i64> = Ok(&v1[0]);
    let a1 = r1.and_then(okr);
    drop(v1);
    let v2 = mkv(2, gpa);
    let r2: Result<&i64, i64> = Ok(&v2[0]);
    let a2 = r2.map_or_else(|_e| &z, idr2);
    drop(v2);
    let v3 = mkv(3, gpa);
    let a3 = v3.first().map_or(&z, idr2);
    drop(v3);
    let v4 = mkv(4, gpa);
    let a4 = v4.first().map_or_else(|| &z, idr2);
    drop(v4);
    let v5 = mkv(5, gpa);
    let r5: Result<&i64, &i64> = Err(&v5[0]);
    let a5 = r5.unwrap_or_else(idr2);
    drop(v5);
    let v6 = mkv(6, gpa);
    let r6: Result<i64, &i64> = Err(&v6[0]);
    let a6 = r6.map_err(idr2);
    drop(v6);
    let v7 = mkv(7, gpa);
    let r7: Result<i64, &i64> = Err(&v7[0]);
    let a7 = r7.or_else(errr2);
    drop(v7);
    let v8 = mkv(8, gpa);
    let a8 = v8.first().and_then(gid::<&i64>);
    drop(v8);
    let v9 = mkv(9, gpa);
    let a9 = v9.first().map(gref::<i64>);
    drop(v9);
    let v10 = mkv(10, gpa);
    let a10 = v10.first().map(wrap).map(|w| w.r);
    drop(v10);
    let v11 = mkv(11, gpa);
    let a11 = v11.first().map(idr).flatten();
    drop(v11);
    let v12 = mkv(12, gpa);
    let a12 = v12.first().inspect(|_x| {}).map(idr2);
    drop(v12);
    println("{:?} {:?} {:?} {:?} {:?} {:?}", a1, a2, a3, a4, a5, a6);
    println("{:?} {:?} {:?} {:?} {:?} {:?}", a7, a8, a9, a10, a11, a12);
}
