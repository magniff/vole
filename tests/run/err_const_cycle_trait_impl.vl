// (0.30.2, RT-138) A trait impl's constants defined by each other: rustc E0391.
// ERROR: const.cycle
trait T {
    const A: i64;
    const B: i64;
}

struct S;

impl T for S {
    const A: i64 = Self::B + 1;
    const B: i64 = Self::A;
}

fn get<X: T>() -> i64 {
    X::A
}

fn main() {
    println("{}", get::<S>());
}
