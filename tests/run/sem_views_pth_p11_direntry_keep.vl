use std::fs;

fn main(gpa: Gpa) -> i32 {
    let mut keep: Vec<&str, Gpa> = Vec::new_in(gpa);
    for e in fs::read_dir(".").ok().unwrap() {
        let e = e.ok().unwrap();
        keep.push(e.file_name());
    }
    println("{}", keep.len() > 0);
    0
}
