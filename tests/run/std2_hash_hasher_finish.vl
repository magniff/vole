// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash Hasher::finish.
// EXPECT: 3 3
// EXPECT: 6
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        self.n += bytes.len() as u64;
    }
}

fn main() {
    let mut h = Show { n: 0 };
    h.write("abc".as_bytes());
    println("{} {}", h.finish(), h.finish());
    h.write_u16(1);
    h.write_i8(1);
    println("{}", h.finish());
}
