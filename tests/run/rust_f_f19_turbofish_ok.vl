// EDITION: rust
// RULE: F19.1
// A turbofish binds a generic function's parameters in order; `_`
// leaves one to inference.
// EXPECT: 2 3
// EXPECT: 7
fn pick<A, B>(a: A, b: B) -> B {
    b
}

fn id<T>(x: T) -> T {
    x
}

fn main() {
    let x = id::<i64>(2);
    let y = pick::<bool, _>(true, 3u8);
    println("{} {}", x, y);
    let z = pick::<_, i64>(1u16, 7);
    println("{}", z);
}
