// XFAIL: RT-343: `IndexMut<Range<usize>>` with `Output = [i64]` beside `Index<usize>` fails the impl signature check (0.30.2)
// rustc prints the EXPECT line. Since v0.30.1 at least. From the
// re-review of g302index.
// EXPECT: 2 2 [7, 2, 3, 9]
use std::ops::{Index, IndexMut, Range};

struct V {
    a: [i64; 4],
}

impl Index<usize> for V {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a[i]
    }
}

impl Index<Range<usize>> for V {
    type Output = [i64];

    fn index(&self, r: Range<usize>) -> &[i64] {
        &self.a[r.start + 1..r.end]
    }
}

impl IndexMut<usize> for V {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.a[3 - i]
    }
}

impl IndexMut<Range<usize>> for V {
    fn index_mut(&mut self, r: Range<usize>) -> &mut [i64] {
        &mut self.a[r.start..r.end]
    }
}

fn main() {
    let mut v = V { a: [1, 2, 3, 4] };
    v[0] = 9;
    v[0usize..2][0] = 7;
    println("{} {} {:?}", v[1], v[0usize..3].len(), v.a);
}
