// RULE: F19.8
// (0.30.2, RT-43) The union fields rustc allows (allowed_union_field): a
// Copy type, a reference (`&mut T` too, though not Copy), std's
// ManuallyDrop<T> of any T, a raw pointer, a fn, PhantomData<T>, and
// tuples and arrays of them; a generic `T` with `T: Copy`. A
// ManuallyDrop field written anew drops nothing: its value is dropped
// by `ManuallyDrop::drop` only.
// EXPECT: true
// EXPECT: 7
// EXPECT: 9
// EXPECT: drop 5
// EXPECT: end
use std::marker::PhantomData;
use std::mem::ManuallyDrop;

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
}

union U<'a> {
    a: i64,
    c: C,
    r: &'a i64,
    m: &'a mut i64,
    md: ManuallyDrop<D>,
    t: (i64, &'a mut i64),
    arr: [C; 2],
    p: *mut u8,
    f: fn(i64) -> i64,
    s: &'a str,
    ms: &'a mut [u8],
    mds: [ManuallyDrop<D>; 2],
    tm: (ManuallyDrop<D>, i64),
    ph: PhantomData<D>,
}

union Md<T: Copy> {
    value: T,
    x: i64,
}

union Mm<T> {
    value: ManuallyDrop<T>,
    x: i64,
}

impl<T: Copy> Md<T> {
    fn new(v: T) -> Md<T> {
        Md { value: v }
    }
}

impl<T> Mm<T> {
    fn new(v: T) -> Mm<T> {
        Mm { value: ManuallyDrop::new(v) }
    }
}

fn main() {
    let mut x = 3i64;
    let u = U { m: &mut x };
    // UNSAFE: reads the reference's address as an integer
    // SAFETY: the field m was written, and an address is 8 bytes
    let r = unsafe { u.a };
    println("{}", r != 0);
    let md: Md<i64> = Md::new(7);
    // UNSAFE: reads the field new wrote
    // SAFETY: value is an i64, written by new
    println("{}", unsafe { md.x });
    let mm: Mm<i64> = Mm::new(9);
    // UNSAFE: reads the field new wrote
    // SAFETY: value is an i64, written by new
    println("{}", unsafe { mm.x });
    let mut w = U { md: ManuallyDrop::new(D { v: 4 }) };
    w.a = 7;
    w.md = ManuallyDrop::new(D { v: 5 });
    // UNSAFE: drops the value the field holds
    // SAFETY: md was written just before, and is not used after
    unsafe {
        ManuallyDrop::drop(&mut w.md);
    }
    println("end");
}
