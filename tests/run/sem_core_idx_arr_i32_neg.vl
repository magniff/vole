// EDITION: rust
// A negative i32 index is sign-extended, not taken as a large unsigned one that wraps into range.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let i: i32 = -1 + unsafe { Z } as i32;
    println("{}", a[i as usize]);
    println("not reached");
    0
}
