// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter FromIteratorIn.
// EXPECT: [2, 3]
// RUSTC: none (std2's FromIteratorIn takes the allocator (Rust's FromIterator))
use std::iter::FusedIterator;

fn build<C: FromIteratorIn<i64, Gpa>>(gpa: Gpa) -> C {
    C::from_iter_in([2i64, 3], gpa)
}

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = build(gpa);
    println("{:?}", v);
}
