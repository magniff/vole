// EDITION: rust
// RULE: F5.1
// An inherent impl on an instance gives its methods to that instance
// only: `Holder<i64>` has no `get`.
// ERROR: no method 'get' on type 'Holder<i32>'
struct Holder<V> {
    v: V,
}

impl<'a, T: Copy> Holder<&'a T> {
    fn get(&self) -> T {
        *self.v
    }
}

fn main() -> i64 {
    let h = Holder { v: 5 };
    h.get()
}
