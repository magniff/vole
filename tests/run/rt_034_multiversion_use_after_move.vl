// RT-34: a #[multiversion] function with an `ensures`: its body is in
// `f$body` and its versions, functions the compiler makes; lowered under
// MVS's operand rules they hid a use after a move from the borrow
// checker (rustc: E0382). Each is checked as itself: one error, where the
// body is.
// ERROR: error[borrowck.use_moved]: 'v' is used here after it moved
// ERROR: line 21, column 14
// ERROR-COUNT: 1
fn take(v: Vec<i64, Gpa>) -> usize {
    v.len()
}

#[multiversion("crc")]
fn twice(v: Vec<i64, Gpa>) -> usize
    ensures result > 0
{
    let mut n: usize = 0;
    for _x in v {
        n += 1;
    }
    n + take(v)
}

fn main(gpa: Gpa) {
    println("{}", twice(Vec::from_in([1i64, 2], gpa)));
}
