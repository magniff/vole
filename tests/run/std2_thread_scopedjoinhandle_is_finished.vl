// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread ScopedJoinHandle::is_finished.
// EXPECT: true 7
use std::thread;
use std::mem::swap;

fn main() {
    thread::scope(|s| {
        let h = s.spawn(|| 7i64);
        while !h.is_finished() {
            thread::yield_now();
        }
        println("{} {}", h.is_finished(), h.join().unwrap());
    });
}
