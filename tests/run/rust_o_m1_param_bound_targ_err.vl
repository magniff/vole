// (0.30.2, obligations M1) rust_o_m1_param_bound_targ_ok with `T: Sup<i32>`:
// three levels down, `X<'c>: Sup<i32>` needs `'c: 'static`, required where
// go is called with a short X (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Sup<P> { fn up(&self) -> &'static str; }
trait Tr { fn f(&self) -> &'static str; }
struct V<T> { t: T }
struct X<'c> { r: &'c str }
impl<'c: 'static> Sup<i32> for X<'c> { fn up(&self) -> &'static str { self.r } }
impl<'c> Sup<i64> for X<'c> { fn up(&self) -> &'static str { "64" } }
impl<T: Sup<i32>> Tr for V<T> { fn f(&self) -> &'static str { "v" } }
fn go<T: Tr>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa); go(&V { t: X { r: st.as_str() } })
    };
    println("{}", s);
}
