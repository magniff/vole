// (0.30.1, review 2) A method call's result typed by its signature,
// `Cell<i64>::get`, is typed: not an i32 computed from untyped literals,
// so no widen_i32 where it reaches an i64 (rustc accepts both).
// EXPECT: 1
// EXPECT: 1
use std::cell::Cell;

fn run<F: FnOnce() -> i64>(f: F) -> i64 {
    f()
}

fn take(x: i64) -> i64 {
    x
}

fn main() {
    let c = Cell::new(1);
    println("{}", run(|| c.get()));
    println("{}", take(c.get()));
}
