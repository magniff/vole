// A fn value in a struct field.
// ERROR: 'quiet' is #[no_io], but it does io
fn noisy(x: i64) -> i64 { println("io"); x }

#[derive(Clone, Copy)] struct H { f: fn(i64) -> i64 }

#[no_io]
fn quiet(h: H, x: i64) -> i64 { (h.f)(x) }

