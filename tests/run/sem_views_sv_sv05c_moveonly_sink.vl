// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.moved: p used after it was given to a sink parameter
// ERROR: error[own.moved]
struct P<A: Allocator> { q: inout Vec<i64, A> }
fn eat(p: sink P<Gpa>) { p.q.push(7); }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    var p = P { q: &v };
    eat(p);
    p.q.push(1);
    println(v.len());
    0
}
