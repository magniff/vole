// XFAIL: RT-374: a pattern matched against a `&&T` (a match on `e: &&E`, `if let Some(x) = o` of `o: &&Option<i64>`, `let (a, b) = p` of `p: &&(i64, i64)`, a filter closure's `|e| match e { .. }` over `iter()`) is refused: the default binding mode takes off one reference only (0.30.2)
// rustc prints `4 7 5 3` and `1` (twin .rs.txt): match ergonomics peels every
// reference. vole: "expected '&&E', got 'E' | help: a pattern matches what
// one reference points to ('match e' on 'e: &E')" (the help names the
// wrong type), "expected '&&Option<i64>', got a pattern of 'Option'", "a
// tuple pattern with 2 elements cannot bind a value of type '&&(i64,
// i64)'"; v0.28.0 to v0.30.1 the same. The `.iter().filter(|e| match e
// {..})` form is the common one (scratch pt/m02.vl). RT-105 is a tuple
// index through two references.
// EXPECT: 4 7 5 3
// EXPECT: 1
#[derive(Debug, Clone, Copy)]
enum E {
    A(i64),
    C,
}

fn m(e: &&E) -> i64 {
    match e {
        E::A(n) => *n,
        E::C => 7,
    }
}

fn l(o: &&Option<i64>) -> i64 {
    if let Some(x) = o { *x } else { 0 }
}

fn t(p: &&(i64, i64)) -> i64 {
    let (a, b) = p;
    a + b
}

fn main() {
    let e = E::A(4);
    let o = Some(5i64);
    let p = (1i64, 2i64);
    println("{} {} {} {}", m(&&e), m(&&E::C), l(&&o), t(&&p));
    let v = [E::A(1), E::C];
    let n = v.iter().filter(|e| match e {
        E::A(_) => true,
        _ => false,
    }).count();
    println("{}", n);
}
