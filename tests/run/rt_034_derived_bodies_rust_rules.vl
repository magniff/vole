// RT-34: a derive's impl is a function the compiler makes (FN_DERIVED);
// since 0.30.1 it is lowered under Rust's operand rules and borrow-checked
// as itself, as every function with a body. Its clones, comparisons and
// Debug output stay the same, and each owned part is freed once
// (--check-alloc); rustc prints the EXPECT lines. The derived bodies
// only borrow, so no output or allocation differs from 0.30.0 (round 2:
// a sweep of Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug and
// Default on enums and generic structs with owned parts printed the same
// at -O0 and -O2 under --check-alloc); what differed is the IR the
// borrow checker reads: 0.30.0 passed Debug's `&mut Formatter` on as a
// bitwise copy, `debug_struct(copy _2, ..)`, a second `&mut` it did not
// see (I7), where Rust's rules make a two-phase reborrow of `*f`; the
// lines below hold that (they fail on 0.30.0 and before RT-34's fix).
// FLAGS: --check-alloc
// PLACES: fn Q::fmt
// PLACES: mut2 (*_2)
// PLACES: call Formatter::debug_struct(move _
// EXPECT: A([1, 2]) B { s: "x", n: 3 } C
// EXPECT: true true true
// EXPECT: false
// EXPECT: P { e: A([1, 2]), t: ([7], 8) }
// EXPECT: true
// EXPECT: Q { s: 1 }
use std::alloc::Allocator;

#[derive(Debug)]
struct Q {
    s: i64,
}

#[derive(Clone, PartialEq, Debug)]
enum E<A: Allocator> {
    A(Vec<i64, A>),
    B { s: String<A>, n: i64 },
    C,
}

#[derive(Clone, PartialEq, Debug)]
struct P<A: Allocator> {
    e: E<A>,
    t: (Vec<i64, A>, i64),
}

fn main(gpa: Gpa) {
    let a = E::A(Vec::from_in([1i64, 2], gpa));
    let b = E::B { s: String::from_in("x", gpa), n: 3 };
    let c: E<Gpa> = E::C;
    let (a2, b2, c2) = (a.clone(), b.clone(), c.clone());
    println("{:?} {:?} {:?}", a2, b2, c2);
    println("{} {} {}", a == a2, b == b2, c == c2);
    println("{}", a == b);
    let p = P { e: a, t: (Vec::from_in([7i64], gpa), 8i64) };
    let q = p.clone();
    println("{:?}", q);
    println("{}", p == q);
    println("{:?}", Q { s: 1 });
}
