// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::sources successors; std::iter::sources Successors.
// EXPECT: [1, 10, 100]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = std::iter::successors(Some(1i64),
        |x| if *x < 100 { Some(x * 10) } else { None }).collect_in(gpa);
    println("{:?}", v);
}
