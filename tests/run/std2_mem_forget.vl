// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::mem forget.
// EXPECT: after
use std::mem::{forget, swap};

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main() {
    let d = D { n: 1 };
    forget(d);
    println("after");
}
