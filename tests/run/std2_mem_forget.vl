// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::mem forget.
// EXPECT: after
use std::mem::forget;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main() {
    let d = D { n: 1 };
    forget(d);
    println("after");
}
