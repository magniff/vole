// RULE: E1.8 (0.30.1) What a local's proofs survive: a reference bound
// to its borrow (`let r = &i;`) and a closure that captures it are
// aliases of it, their own uses its borrows; a read through one (`*r`,
// `c()` of a closure whose body makes no pointer of a reference) is no
// escape, and neither is a borrow given to a callee with no `addr` that
// cannot carry it out (`i.cmp(&n)`, `peek(&i)`). Most functions here have
// `addr` in their sets (Vec::push, print's formatting); before, a borrow
// that was no call's argument was lost in such a function, and these
// loops were `diverge` (0.30.0 had no such rule).
// EXPECT: 0 1 2 2
// EXPECT: 9 3 3 3 3 9

fn peek(r: &i64) -> i64 {
    *r
}

#[effects(alloc(Gpa), panic)]
fn bound_ref(n: i64, gpa: Gpa) -> usize {
    let mut i: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while i < n {
        let r = &i;
        v.push(*r);
        i += 1;
    }
    v.len()
}

#[effects(io, static, panic)]
fn printed_ref(n: i64) {
    let mut i: i64 = 0;
    while i < n {
        let r = &i;
        print("{} ", *r);
        i += 1;
    }
}

#[effects(alloc(Gpa), panic)]
fn closure_read(n: i64, gpa: Gpa) -> i64 {
    let mut i: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while i < n {
        let c = || i + 1;
        v.push(c());
        i += 1;
    }
    let mut s: i64 = 0;
    for x in v.iter() {
        s += *x;
    }
    s
}

#[effects(alloc(Gpa), panic)]
fn compared(n: i64, gpa: Gpa) -> usize {
    let mut i: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while i < n {
        v.push(i);
        if i.cmp(&n) == std::cmp::Ordering::Less {}
        i += 1;
    }
    v.len()
}

#[effects(alloc(Gpa), panic)]
fn peeked(n: i64, gpa: Gpa) -> usize {
    let mut i: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while i < n {
        v.push(peek(&i));
        let r = &i;
        v.push(peek(r));
        i += 1;
    }
    v.len() / 2
}

#[effects(alloc(Gpa), panic)]
fn got(n: usize, gpa: Gpa) -> usize {
    let mut i: usize = 0;
    let mut v: Vec<usize, Gpa> = Vec::new_in(gpa);
    while i < n {
        v.push(i);
        if let Some(x) = v.get(i) {
            let _ = x;
        }
        i += 1;
    }
    v.len()
}

#[effects()]
fn divided(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        if d.cmp(&x) == std::cmp::Ordering::Less {}
        let r = &d;
        x / d + peek_u(r)
    } else {
        0
    }
}

fn peek_u(r: &u64) -> u64 {
    *r
}

fn main(gpa: Gpa) {
    printed_ref(3);
    println("{}", bound_ref(3, gpa) - 3 + 2);
    println("{} {} {} {} {} {}", closure_read(3, gpa) + 3, compared(3, gpa), peeked(3, gpa),
        got(3, gpa), bound_ref(3, gpa), divided(14, 2));
}
