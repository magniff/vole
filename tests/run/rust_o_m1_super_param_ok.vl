// (0.30.2, obligations M1) `trait Sub<P>: Sup<P>` used as `Sub<i64>`: the
// supertrait's arguments are read with the bound's, Sup<i64>, whose impl
// needs nothing; Sup<i32>'s `'c: 'static` is not required. rustc accepts it.
// EXPECT: 1
trait Sup<P> { fn up(&self) -> i64; }
trait Sub<P>: Sup<P> { fn n(&self) -> i64; }
struct X<'c> { r: &'c str }
impl<'c: 'static> Sup<i32> for X<'c> { fn up(&self) -> i64 { 32 } }
impl<'c> Sup<i64> for X<'c> { fn up(&self) -> i64 { 64 } }
impl<'c> Sub<i64> for X<'c> { fn n(&self) -> i64 { 1 } }
fn go<T: Sub<i64>>(t: &T) -> i64 { t.n() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = X { r: st.as_str() }; println("{}", go(&x));
}
