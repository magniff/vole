// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Arena::alloc_slice_copy.
// EXPECT: [1, 2, 30]
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let s: &mut [i64] = arena.alloc_slice_copy(&[1, 2, 3]);
    s[2] = 30;
    println("{:?}", s);
}
