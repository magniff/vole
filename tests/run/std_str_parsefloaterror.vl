// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::str ParseFloatError.
// EXPECT: true true
// RUSTC: none (std has no std::num: the parse errors are std::str's)
use std::str::ParseFloatError;

fn main() {
    let e: ParseFloatError = "1.2.3".parse::<f64>().unwrap_err();
    let f: ParseFloatError = "".parse::<f64>().unwrap_err();
    println("{} {}", e == e.clone(), e != f);
}
