// EXIT: 101
// EXPECT: 2
// STDERR: canary_bounds_vec.vl:17:16: index out of bounds: index 2, length 2
// 0.30.1, a canary of the bounds check on a Vec index, at every level,
// in a loop that runs one step too far (an off-by-one the loop passes
// must not hide).
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(1);
    let mut sum: i64 = 0;
    let n = v.len() + std::env::args().count() - 1;
    for i in 0..=n {
        if i == n {
            println("{sum}");
        }
        sum += v[i];
    }
    println("{sum}");
}
