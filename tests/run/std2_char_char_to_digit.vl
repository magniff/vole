// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::char char::to_digit.
// EXPECT: Some(7) Some(15) Some(15) None None
use std::char::from_u32;

fn main() {
    println("{:?} {:?} {:?} {:?} {:?}", '7'.to_digit(10), 'f'.to_digit(16), 'F'.to_digit(16),
        'g'.to_digit(16), '9'.to_digit(8));
}
