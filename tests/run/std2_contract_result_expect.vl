// EDITION: rust
// (0.28.0, gap 79) Result::expect on an Err: the caller's place, the
// message, then the error (no `requires failed`).
// EXPECT: 1
// EXIT: 101
// STDERR: std2_contract_result_expect.vl:12:13: b: 2

fn main() {
    let a: Result<i64, i64> = Result::Ok(1);
    let b: Result<i64, i64> = Result::Err(2);
    println("{}", a.expect("a"));
    let x = b.expect("b");
}
