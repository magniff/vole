// RULE: F19.8
// (0.30.2, RT-43) rustc's E0740 asks Copy, not "no drop": a struct
// without Copy is refused though it needs no drop; and so is an
// Option of a Drop type, and a union inside a struct inside a union
// (the struct is not Copy). Each union is reported once.
// ERROR: field 's' of union 'A' has type 'S' (rustc E0740)
// ERROR: field 'o' of union 'B' has type 'Option<D>' (rustc E0740)
// ERROR: field 'd' of union 'In' has type 'D' (rustc E0740)
// ERROR: field 'h' of union 'C' has type 'H' (rustc E0740)
// ERROR-COUNT: 4
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct S {
    a: i64,
}

union A {
    s: S,
    x: i64,
}

union B {
    o: Option<D>,
    x: [i64; 2],
}

union In {
    d: D,
    x: i64,
}

struct H {
    i: In,
    k: i64,
}

union C {
    h: H,
    y: i64,
}

fn main() {
    let a = A { x: 1 };
    let b = B { x: [1, 2] };
    let c = C { y: 1 };
    println("end");
}
