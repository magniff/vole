// a closure argument that reads the receiver of a mutating method
// ERROR: error[borrowck.conflict]
// ERROR: line 8, column 9
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(2); v.push(1);
    v.sort_unstable_by(
        |a, b| ({ let a = *a; let b = *b; a - b + v.len() as i64 - v.len() as i64 }).cmp(&0));
    println("{}", v[0]);
}
