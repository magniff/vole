// FLAGS: --check-unsafe
// EXPECT: 10000 576 ok
// 0.30.1: --check-unsafe holds the blocks it counts freed back from C's
// allocator, the last 4096 of them and at most 64 MB: past either, the
// oldest is given back and forgotten. Ten thousand Boxes dropped, each
// followed by a C strdup read and freed; a Vec of 96 MB dropped (more
// than the bytes held: given back at once) and one of 80 MB made; a Vec
// grown by doubling, which moves its block each time (realloc: a new
// block, the old one held). None of it is reported.
extern "C" {
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
}

fn main(gpa: Gpa) {
    let mut n = 0;
    // (each Box in a Vec first: it is a block of Gpa's, not put on the stack)
    let mut keep: Vec<Box<u64, Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 0..10000 {
        keep.push(Box::new_in(i as u64, gpa));
        drop(keep.pop());
        // UNSAFE: C's strdup and free.
        // SAFETY: the copy is read within its 2 bytes and freed once.
        unsafe {
            let p = strdup(c"x" as *const u8);
            if *p == 120 {
                n += 1;
            }
            free(p);
        }
    }
    let big: Vec<u8, Gpa> = Vec::from_elem_in(1u8, 96 << 20, gpa);
    drop(big);
    let other: Vec<u8, Gpa> = Vec::from_elem_in(2u8, 80 << 20, gpa);
    let mut grown: Vec<u64, Gpa> = Vec::new_in(gpa);
    for k in 0..512u64 {
        grown.push(k);
    }
    let mut sum: u64 = 0;
    for &k in grown.iter() {
        sum += k;
    }
    println("{n} {} {}", sum / 227, if other[(80 << 20) - 1] == 2 { "ok" } else { "bad" });
}
