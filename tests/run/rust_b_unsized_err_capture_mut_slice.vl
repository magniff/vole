// RULE: Z9.6
// (0.27.2) A closure capturing a `&mut [T]` uniquely, then a shared borrow
// of an element through it before the call: rustc's E0501 at the borrow and
// E0503 at the bounds check's length read.
fn main() {
    let mut a = [1, 2, 3];
    let s = &mut a[..];
    let mut c = || s[0] = 1;
    let n = &s[1];
    c();
    println("{}", n);
}
// ERROR: error[borrowck.conflict]
// ERROR: line 9, column 13
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 9, column 14
// ERROR-COUNT: 2
