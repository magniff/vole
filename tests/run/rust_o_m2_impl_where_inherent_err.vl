// ERROR: the bound 'i64: Conv<U>' of 'f' is not met
// (RT-269) an inherent impl's `where i64: Conv<U>` is required at a call of its function (rustc E0599; v0.30.1 accepted it).
trait Conv<X> {}

struct G<U> {
    u: U,
}

impl<U> G<U>
    where
        i64: Conv<U>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn main() {
    let g = G { u: 5 };
    println("{}", g.f());
}
