// XFAIL: gap 17: compile type error: expected '[u8]', got 'String<Gpa>'
// (0.25.1) A generic `[T]` parameter, let, inout or sink, infers T from
// what lends it a slice: a slice, `&xs` of an inout slice parameter (in
// a generic function too), a subslice `&xs[a..b]`, a Vec, a Buf, a fixed
// array, a String (let and sink: its bytes); T nested inside the
// element type (`[Vec<T>]`, `[(K, V)]`) too.
// EXPECT: 3 3 3
// EXPECT: [1, 2, 3, 4]
// EXPECT: 9 1
// EXPECT: [2, 0, 1, 4]
// EXPECT: 4 4 9
// EXPECT: 2 2 2
// EXPECT: [9, 8] 3
// EXPECT: 2 2 [10, 10]
// EXPECT: 3 7 9
// EXPECT: 4 0
fn count<T>(xs: &[T]) -> i64 { xs.len() as i64 }
fn taken<T>(xs: &[T]) -> i64 { xs.len() as i64 }
fn first<T: Copy>(xs: &mut [T]) -> T { xs[0] }
fn bump_all(xs: &mut [i64]) { for i in 0..xs.len() { xs[i] += 1; } }

fn sort<T: Ord>(xs: &mut [T]) {
    if xs.len() <= 1 { return; }
    let p = split(&mut xs);
    sort(&mut xs[0..p as usize]);
    sort(&mut xs[(p + 1) as usize..xs.len()]);
}

fn split<T: Ord>(xs: &mut [T]) -> i64 {
    let last = xs.len() - 1;
    let mut store: i64 = 0;
    for i in 0..last {
        if xs[i] < xs[last] {
            xs.swap(i as usize, store as usize);
            store += 1;
        }
    }
    xs.swap(store as usize, last as usize);
    store
}

// an inout parameter lent on, its result bound by let (no expected type)
fn largest<T: Ord + Copy>(xs: &mut [T]) -> T {
    sort(&mut xs);
    let top = first(&mut xs[xs.len() - 1..xs.len()]);
    top
}

fn swap_ends<T>(xs: &mut [T]) { let n = xs.len(); xs.swap(0usize, n as usize - 1); }

fn total_lens<T>(xss: &[Vec<T, Gpa>]) -> i64 {
    let mut n: i64 = 0;
    for v in xss { n += v.len() as i64; }
    n
}

fn grow_first<T: Copy>(xss: &mut [Vec<T, Gpa>]) { let x = xss[0][0]; xss[0].push(x); }
fn second_keys<K: Copy, V>(ps: &[(K, V)]) -> K { ps[1].0 }

fn main(gpa: Gpa) {
    let mut arr = [3i64, 1, 4];
    println("{} {} {}", count(&arr), taken(&arr), count(&arr[0..3]));
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in [3i64, 1, 4, 2] { v.push(x); }
    sort(&mut v);
    println("{v:?}");
    let mut big: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in [5i64, 9, 1] { big.push(x); }
    println("{} {}", largest(&mut big), first(&mut big));
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in [4i64, 2, 0, 1] { w.push(x); }
    sort(&mut w[1..4]);
    swap_ends(&mut w);
    println("{w:?}");
    let mut a2 = [4i64, 9, 4];
    sort(&mut arr);
    println("{} {} {}", count(&v), count(&v[0..4]), largest(&mut a2));
    let mut s = String::new_in(gpa);
    s.push_str("hi");
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.push(7u8);
    b.push(8u8);
    println("{} {} {}", count(s), taken(s), count(&b));
    swap_ends(&mut b);
    let mut c = [8i64, 9];
    swap_ends(&mut c);
    println("[{}, {}] {}", c[0], c[1], arr[2] - 1);
    let mut vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    let mut one: Vec<i64, Gpa> = Vec::new_in(gpa);
    one.push(10);
    vs.push(one);
    vs.push(w);
    grow_first(&mut vs);
    println("{} {} {:?}", vs[0].len(), vs[1].len() - 2, vs[0]);
    let ps = [(1, "a"), (3, "b")];
    println("{} {} {}", second_keys(&ps), first(&mut b[1..2]), first(&mut a2[2..3]));
    let u: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{} {}", taken(&v), count(&u));
}
