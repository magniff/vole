// RULE: Z9.2
// `&a` of an array or a Vec where `&[T]` is expected is the slice of its
// elements; `&[]` and `&[4, 5]` take the expected element type.
// EXPECT: 6 10 9 0 0
fn total(s: &[i64]) -> i64 {
    let mut t = 0;
    for x in s.iter() {
        t += *x;
    }
    t
}

fn main(gpa: Gpa) {
    let a = [1i64, 2, 3];
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(10);
    let e: &[i64] = &[];
    println("{} {} {} {} {}", total(&a), total(&v), total(&[4, 5]), total(&[]), e.len());
}
