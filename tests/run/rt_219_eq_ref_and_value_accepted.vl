// XFAIL: RT-219: `==` with a reference on the left and a value on the right is accepted (`&a == b` for W, `&x == 5i64`, `&s == s` for a String, `&o == o` for an Option); rustc refuses each (E0277, can't compare `&T` with `T`) (0.30.2)
// rustc: four E0277 (twin: r302d_038_eq_between_ref_and_value_accepted.rs.txt).
// vole builds it and prints `true true true true` (it compares the values). The
// mirrored form `a == &b` is refused (`no impl of 'W::eq' takes arguments (&&W)`).
// No meaning changes, but a program vole accepts is not Rust. Since v0.28.0.
// ERROR: line 19
// ERROR: line 21
// ERROR: line 23
// ERROR: line 25
// ERROR-COUNT: 4
#[derive(Clone, Copy, Debug, PartialEq)]
struct W {
    k: i64,
}

fn main(gpa: Gpa) {
    let a = W { k: 1 };
    let b = W { k: 1 };
    let f = &a == b;
    let x = 5i64;
    let h = &x == 5i64;
    let s = String::from_in("q", gpa);
    let i = &s == s;
    let o = Some(1i64);
    let j = &o == o;
    println("{} {} {} {}", f, h, i, j);
}
