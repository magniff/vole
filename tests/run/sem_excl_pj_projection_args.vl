#[derive(Clone, Copy)] struct S { a: i64, b: i64 }
fn pick(s: &mut S) -> &mut i64 { &mut s.a }
fn f(x: &mut i64, s: &mut S) { *x += 1; s.a += 10; }
fn main() { let mut s = S { a: 1, b: 2 }; f(pick(&mut s), &mut s); println("{}", s.a); }
