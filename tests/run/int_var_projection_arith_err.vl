// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). `f(2) + 1`:
// the literal 1 is i32 too, an i32 added to Out = i64: refused (rustc
// E0277 at the `+`; vole E0271 at the call). 0.30.2's build panicked at
// -O0 and printed 1705032705 at -O2.
// ERROR: (rustc E0271)
// ERROR-COUNT: 1
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = u16;

    fn o(self) -> u16 {
        self as u16 * 300
    }
}

impl Tr for i32 {
    type Out = i64;

    fn o(self) -> i64 {
        self as i64 * 3000000000
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let r = f(2) + 1;
    println("{}", r);
}
