// From the review: impl-block where-pred on projection, all 'static callers: rustc ok
// rustc accepts and prints 1.
// EXPECT: 1
fn need<T: 'static>(t: T) -> i64 { 1 }
struct W<I> { i: I }
impl<I: Iterator> W<I> where I::Item: 'static { fn g(&mut self) -> i64 { need(self.i.next()) } }
fn main() { let mut w = W { i: 0..2i64 }; println("{}", w.g()); }
