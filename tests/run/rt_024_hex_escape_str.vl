// RT-24 (fixed in 0.30.1), a form of it: a `\xC3` escape in a str literal
// made a &str that is not UTF-8, from safe code (`"\xC3x".as_bytes()`
// was [195, 120]). Rust: `out of range hex escape`; a str's `\x` is ASCII.
// Every literal's escapes are decoded by front::lexer::strings::lex_escape,
// which refuses it.
// ERROR: out of range hex escape
// ERROR-COUNT: 1
fn main() {
    let s = "\xC3x";
    println("{:?}", s.as_bytes());
}
