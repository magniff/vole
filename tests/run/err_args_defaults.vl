// RULE: F33.1
// (0.28.0) No parameter has a default value: `b: i64 = 2` is an error at
// its `=`, with the fix that removes it, for a function and a method; the
// call that left the argument out is then missing it. Named arguments
// stay: `f(1, b: 3)`.
// RUSTC: none a parse error (rustc: expected one of `)` or `,`, found `=`): the twin compares the borrow checker
// ERROR: error[syntax.default-arg]: a parameter has no default value; pass it at each call
// ERROR: line 17, column 21
// ERROR: help: remove the `= value` and give the argument where the function is called
// ERROR: error[syntax.default-arg]: a parameter has no default value; pass it at each call
// ERROR: line 22, column 30
// ERROR-COUNT: 2
struct P {
    x: i64,
}

fn f(a: i64, b: i64 = 2) -> i64 {
    a + b
}

impl P {
    fn scaled(&self, by: i64 = 5) -> i64 {
        self.x * by
    }
}

fn main() {
    let p = P { x: 2 };
    println("{} {}", f(1, b: 3), p.scaled(by: 2));
}
