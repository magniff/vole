// a generic choosing one of two views: the result views both arguments
// ERROR: error[borrowck.conflict]
// ERROR: line 12, column 5
fn pick<T>(a: T, b: T, first: bool) -> T { if first { a } else { b } }

fn main(gpa: Gpa) {
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(1);
    let mut y: Vec<i64, Gpa> = Vec::new_in(gpa);
    y.push(2);
    let s = pick(x.as_slice(), y.as_slice(), false);
    y.push(3);
    println("{}", s[0]);
}
