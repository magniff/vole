// XFAIL: RT-162: `(&w).f()` through a Deref wrapper picks a trait's `f(&mut self)` for S over another trait's by-value `f(self)` for &S, and is refused as a mutable borrow behind `&` (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_008b_shared_wrapper_takes_mut_method.rs.txt):
// the probe of `&W` reaches S, where the `&S` autoref step (T0 for &S, by
// value) comes before the `&mut S` one (T1 for S, `&mut self`). vole:
// `error[borrowck.borrow_immutable] cannot borrow 'w' as mutable, which is
// behind a `&` reference` at line 62 (also the g302probe build); `w.f()`,
// `(&mut w).f()`, `rw.f()` and a Box are right (101). Found by gen/gmr.py
// seed 69 against the g302probe build. A regression: since v0.30.1; v0.28.0,
// v0.29.0 and v0.30.0 build it and print the EXPECT lines.
// EXPECT: 101
// EXPECT: 101
// EXPECT: 2
// EXPECT: 101
// EXPECT: 5
use std::ops::{Deref, DerefMut};

struct S {
    k: i64,
}

struct W {
    s: S,
}

impl Deref for W {
    type Target = S;

    fn deref(&self) -> &S {
        &self.s
    }
}

impl DerefMut for W {
    fn deref_mut(&mut self) -> &mut S {
        &mut self.s
    }
}

trait T0 {
    fn f(self) -> i64;
}

trait T1 {
    fn f(&mut self) -> i64;
}

impl<'a> T0 for &'a S {
    fn f(self) -> i64 {
        101
    }
}

impl T1 for S {
    fn f(&mut self) -> i64 {
        self.k = 99;
        103
    }
}

fn main(gpa: Gpa) {
    let mut w = W { s: S { k: 2 } };
    println("{}", (&mut w).f());
    println("{}", (&w).f());
    println("{}", w.k);
    let mut b: Box<S, Gpa> = Box::new_in(S { k: 5 }, gpa);
    println("{}", b.f());
    println("{}", b.k);
}
