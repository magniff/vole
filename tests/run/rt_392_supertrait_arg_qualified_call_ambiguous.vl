// XFAIL: RT-392: `<T as Tr<i64>>::get(t)` in `fn go<T: Sub>(t: &T)`, where `trait Sub: Tr<i64>` and W has impls of Tr<i32> and Tr<i64>, is refused as "'W::get' is ambiguous for arguments ()"; rustc accepts it and prints the EXPECT line (0.30.2)
// From the review of g302bor2 (form B/b25). Since v0.30.1 at least; the
// release build the same. The path names the trait with its argument,
// and the supertrait bound names it too: only Tr<i64> applies. Siblings:
// rt_392b (the method call `t.get()` under the supertrait bound), rt_392c
// (a default method called by `<W as Tr<i64>>::twice(&w)`).
// EXPECT: hello heap string long 22
trait Tr<U> {
    type Out;
    fn get(&self) -> Self::Out;
}

trait Sub: Tr<i64> {}

struct W<'a> {
    r: &'a str,
}

impl<'a> Tr<i32> for W<'a> {
    type Out = &'static str;

    fn get(&self) -> &'static str {
        "s"
    }
}

impl<'a> Tr<i64> for W<'a> {
    type Out = &'a str;

    fn get(&self) -> &'a str {
        self.r
    }
}

impl<'a> Sub for W<'a> {}

fn go<T: Sub>(t: &T) -> T::Out {
    <T as Tr<i64>>::get(t)
}

fn main(gpa: Gpa) {
    let st = String::from_in("hello heap string long", gpa);
    let s = {
        go(&W { r: st.as_str() })
    };
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", s, other.len());
}
