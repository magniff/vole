// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::thread JoinError.
// EXPECT: 5
// RUSTC: none (std2's join never fails (a panic exits): JoinError is std2's, Rust's thread::Result holds a Box<dyn Any>)
use std::thread::{JoinError, self};

fn main() {
    let r: Result<i64, JoinError> = thread::scope(|s| s.spawn(|| 5i64).join());
    match r {
        Ok(v) => println("{}", v),
        Err(e) => println("{:?}", e),
    }
}
