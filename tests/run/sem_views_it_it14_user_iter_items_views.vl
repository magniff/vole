// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a user iterator yielding views of its slice's text
// ERROR: error[borrowck.conflict]
#[derive(Clone, Copy)]
struct Words<'a> { s: &'a [&'a str], i: i64 }

impl<'a> Iterator for Words<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.i < self.s.len() as i64 { self.i += 1; Some(self.s[(self.i - 1) as usize]) }
        else { None }
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello", gpa);
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(s.as_str());
    let mut it = Words { s: v.as_slice(), i: 0 };
    let r = it.next().unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
