// RULE: D2.7
// (0.30.1, RT-33 round 3, F2) `d[..2].reverse()` of a D with Deref only:
// the view `d.deref()` gives is shared, rustc's E0596 ("data in
// dereference of `D`"); a release before RT-33 wrote a literal (SIGBUS).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in dereference of `D` as mutable
// ERROR: line 24, column 5
// ERROR-COUNT: 1
use std::ops::Deref;

struct D {
    s: &'static [u8],
}

impl Deref for D {
    type Target = [u8];

    fn deref(&self) -> &[u8] {
        self.s
    }
}

fn main() {
    let d = D { s: b"abc" };
    d[..2].reverse();
}
