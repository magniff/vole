// RULE: D3.6a
// (0.27.7) What rustc accepts of the raw coercions: `&mut T` to a `*mut
// T` parameter and to a `let`'s `*mut T` and `*const T`, `&T` to a `*const
// T` parameter. Prints 2 3 3 3.
// EXPECT: 2 3 3 3
fn bump(p: *mut i64) {
    // UNSAFE: the test's raw pointer, a C-style out parameter
    // SAFETY: p points to main's live x; nothing else uses it here
    unsafe { *p += 1; }
}

fn read(p: *const i64) -> i64 {
    // UNSAFE: the test's raw pointer
    // SAFETY: p points to main's live x, only read here
    unsafe { *p }
}

fn main() {
    let mut x = 1i64;
    bump(&mut x);
    let a = read(&x);
    let w: *mut i64 = &mut x;
    // UNSAFE: the test's raw pointer
    // SAFETY: w points to x, live and not borrowed now
    unsafe { *w += 1; }
    let q: *const i64 = &mut x;
    // UNSAFE: the test's raw pointer
    // SAFETY: q points to x, live, only read here
    let b = unsafe { *q };
    println("{} {} {} {}", a, x, b, read(&x));
}
