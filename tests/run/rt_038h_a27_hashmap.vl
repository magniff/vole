// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a27_hashmap)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A HashMap parameter: a callee writes a value through a pointer made from get().
use std::collections::HashMap;

fn poke(m: &HashMap<i64, i64, Gpa, FixedState>) -> bool {
    match m.get(&1) {
        Some(r) => {
            let p = r as *const i64 as *mut i64;
            // UNSAFE: test
            // SAFETY: test
            unsafe { *p = 9; }
        }
        None => {}
    }
    true
}

fn f(m: &HashMap<i64, i64, Gpa, FixedState>) -> i64
    requires poke(m)
{
    1
}

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    println("{}", f(&m));
    println("{}", m.get(&1).unwrap());
}
