// (0.30.1) A generic struct and enum whose instance does not fit, though
// its type argument does: refused where the instance is written.
// ERROR: err_type_too_big_generic.vl: line 17, column 12
// ERROR-COUNT: 1
struct P<T> {
    a: T,
    b: T,
}

enum E<T> {
    Both(T, T),
    Neither,
}

fn main() {
    let e: E<[u8; 1usize << 59]> = E::Neither;
    let p: P<[u8; 1usize << 60]> = P { a: [0; 1usize << 60], b: [0; 1usize << 60] };
    match e {
        E::Neither => println("{}", p.a[0]),
        _ => {}
    }
}
