enum T<'a> { S(&'a [i64]), N } impl Clone for T<'_> { fn clone(&self) -> Self { *self } }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let t = T::S(v.as_slice());
