// EDITION: rust
// an inout-self trait method on a let binding: own.readonly
// ERROR: borrowck.borrow_immutable
trait B { fn bump(&mut self); }
#[derive(Clone, Copy)] struct P { x: i64 }
impl B for P { fn bump(&mut self) { self.x += 1; } }

fn main() {
    let p = P { x: 1 };
    p.bump();
    println("{}", p.x);
}
