// XFAIL: RT-162: a by-value method of a trait implemented for `&S` or `&mut S` is not found through a Deref step: `w.f()` with `w: W`, W: DerefMut<Target = S>, and on a Box<S> (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_008_deref_then_impl_for_ref.rs.txt):
// rustc's probe derefs W to S, then autorefs &S / &mut S, where T1's g and
// T0's f are found. vole: `no method 'f' on type 'W'` (and '&mut W', 'Box<S, Gpa>'),
// `no method 'g' on type 'W'` ('&W', Box) at every call through W or the
// Box; the calls on `s: S` itself work. Since v0.28.0; the g302probe build
// (chain_probe) the same. Found by the method-resolution generator (seed 33).
// EXPECT: 102
// EXPECT: 202
// EXPECT: 1202
// EXPECT: 1202
// EXPECT: 105
// EXPECT: 1105
// EXPECT: 107
// EXPECT: 1107
use std::ops::{Deref, DerefMut};

struct S {
    k: i64,
}

struct W {
    s: S,
}

impl Deref for W {
    type Target = S;

    fn deref(&self) -> &S {
        &self.s
    }
}

impl DerefMut for W {
    fn deref_mut(&mut self) -> &mut S {
        &mut self.s
    }
}

trait T0 {
    fn f(self) -> i64;
}

impl<'a> T0 for &'a mut S {
    fn f(self) -> i64 {
        self.k += 100;
        self.k
    }
}

trait T1 {
    fn g(self) -> i64;
}

impl<'a> T1 for &'a S {
    fn g(self) -> i64 {
        self.k + 1000
    }
}

fn main(gpa: Gpa) {
    let mut w = W { s: S { k: 2 } };
    println("{}", w.f());
    println("{}", (&mut w).f());
    println("{}", w.g());
    println("{}", (&w).g());
    let mut b: Box<S, Gpa> = Box::new_in(S { k: 5 }, gpa);
    println("{}", b.f());
    println("{}", b.g());
    let mut s = S { k: 7 };
    println("{}", s.f());
    println("{}", s.g());
}
