// RT-38 (F6): `fn g<'a>(v: &'a mut Vec) -> &'a mut i64 ensures *result
// >= 0` was always borrowck.conflict at 1:1: the wrapper made `let v =
// &*v;`, a shared view of every `&mut` parameter, after the body's call,
// while `result`, which borrows from v, lives on to the return. A clause
// on `*result` must be accepted, as the conflict's own help says: the
// wrapper now views only what the clauses read. rustc accepts the same
// wrapper written by hand; the EXPECT lines are its output.
// FLAGS: --check-alloc
// EXPECT: 5
// EXPECT: 6
fn g<'a>(v: &'a mut Vec<i64, Gpa>) -> &'a mut i64
    ensures * result >= 0
{
    &mut v[0]
}

fn h<'a>(v: &'a mut Vec<i64, Gpa>, k: &i64) -> &'a mut i64
    ensures * result >= *k && old(v.len()) > 0
{
    &mut v[1]
}

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([5i64, 6], gpa);
    println("{}", *g(&mut v));
    println("{}", *h(&mut v, &0));
}
