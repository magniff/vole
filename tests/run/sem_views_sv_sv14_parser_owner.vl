#[derive(Clone, Copy)] // (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: parser tokens view src; src grown while a name is used
// ERROR: error[own.conflict]
use std::alloc::Allocator; struct Tok<'a> { text: &'a str, kind: i64 }
struct Parser<'a, A: Allocator> { toks: Vec<Tok<'a>, A>, pos: i64 }

impl<'a> Parser<'a, Gpa> {
    fn name(&mut self) -> &str {
        let t = self.toks[self.pos as usize];
        self.pos += 1;
        t.text
    }
}

fn main(gpa: Gpa) {
    let mut src = String::new_in(gpa);
    src.push_str("let x");
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: &src.as_str()[0..3], kind: 0 });
    let a = p.name();
    src.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", a);
}
