// 0.25.3: a text block without its closing line; a raw block with #s
// closes only at """ and as many #s (lex.text-block-unterminated).
// ERROR: error[lex.text-block-unterminated]: unterminated text block: no line starts with '"""#' to close it
// ERROR: help: a line holding only optional blanks and the closing delimiter ends a text block
fn main() -> i32 {
    let s = r#"""
        text
        """;
    println(s);
    0
}
