// XFAIL: RT-200: `flat_map(|y| it(*y))` with it returning `impl Iterator<Item = i64>` fails: "IntoIterator is not implemented for impl Iterator" (0.30.2)
// From the re-review of g302holes.
// EXPECT: 9
// EXPECT: 6
// A closure whose result is an impl Fn of a fn item defined later, itself holding an iterator closure.
fn main() {
    let w = [1i64, 2];
    let s: i64 = w.iter().map(|y| mk(*y)).map(|g| g(3)).sum();
    println("{s}");
    let t: i64 = w.iter().flat_map(|y| it(*y)).sum();
    println("{t}");
}

fn mk(n: i64) -> impl Fn(i64) -> i64 {
    move |x| x * n
}

fn it(n: i64) -> impl Iterator<Item = i64> {
    (0..n).map(move |x| x + n)
}
