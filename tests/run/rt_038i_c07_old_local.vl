// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c07_old_local)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// a local inside old(..) named as the moved parameter.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures old({ let s = 1i64; s }) == 1
{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
