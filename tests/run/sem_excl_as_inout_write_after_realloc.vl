// EDITION: rust
// an inout element param while the callee also gets the Vec through a capture? (no: just order)
// EXPECT: 101
fn grow(v: &mut Vec<i64, Gpa>) { for i in 0..100 { v.push(i); } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); grow(&mut v); v[0] += 100;
    println("{}", v[0]);
}
