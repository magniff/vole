// a sink closure capturing an inout parameter moves it out: the caller's Vec would be freed twice
// ERROR: error[type error]
// ERROR: line 7, column 25
fn eat(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }

fn f(v: &mut Vec<i64, Gpa>) -> i64 {
    let c = move || eat(v);
    c()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{} {}", f(&mut v), v.len());
}
