// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::boxed Box::impl AsMut.
// EXPECT: 11
use std::boxed::Box;

fn bump<T: AsMut<i64>>(x: &mut T) {
    *x.as_mut() += 1;
}

fn main(gpa: Gpa) {
    let mut b = Box::new_in(10i64, gpa);
    bump(&mut b);
    println("{}", b);
}
