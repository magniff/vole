// (0.26.4) A C header's `#if` arithmetic wraps on 64-bit words, as the C
// preprocessor's does, in a compiler built with the overflow checks too:
// MIN / -1 is MIN (it panicked at every level), 0u - 1 is the largest
// unsigned word and 2^32 * 2^32 is 0.
// EXPECT: 1 3 5
import "../c/cpp_wrap.h" as c;

fn main() {
    std::print_int(c::DIV_MIN);
    print(" ");
    std::print_int(c::SUB_WRAP);
    print(" ");
    std::print_int(c::MUL_WRAP);
    println("");
}
