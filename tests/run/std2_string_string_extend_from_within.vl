// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::extend_from_within.
// EXPECT: abcab
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    s.extend_from_within(..2usize);
    println("{}", s);
}
