// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::sort_by.
// EXPECT: [(1, 20), (1, 40), (2, 10), (2, 30)]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([(2, 10), (1, 20), (2, 30), (1, 40)], gpa);
    v.sort_by(|x, y| x.0.cmp(&y.0));
    println("{:?}", v);
}
