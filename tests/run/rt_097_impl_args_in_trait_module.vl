// XFAIL: RT-97: an impl's trait arguments (PartialEq<W>) are resolved in the trait's module when its default `ne` is checked: unknown type 'W' (0.30.2)
// From the review of the obligation engine's M1 (pre-existing: v0.30.1 too).
// EXPECT: true
struct W { r: i64 }
impl PartialEq<W> for W { fn eq(&self, o: &W) -> bool { self.r == o.r } }
