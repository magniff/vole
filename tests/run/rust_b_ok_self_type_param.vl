// RULE: D4.4
// (0.27.2) In `impl<I: Tr> Into2 for I`, `Self` is the type parameter I:
// `fn into2(self) -> I { self }` returns its substitution's slots, so an
// instance with a reference in I is not borrowck.outlives (std's
// blanket `impl<I: Iterator> IntoIterator for I`).
trait Tr {
    fn get(&self) -> i64;
}

struct R<'a> {
    v: &'a i64,
}

impl<'a> Tr for R<'a> {
    fn get(&self) -> i64 {
        *self.v
    }
}

trait Into2 {
    type Out;
    fn into2(self) -> Self::Out;
}

impl<I: Tr> Into2 for I {
    type Out = I;

    fn into2(self) -> I {
        self
    }
}

fn main() {
    let k = 9;
    let r = R { v: &k };
    println("{}", r.into2().get());
}
// EXPECT: 9
