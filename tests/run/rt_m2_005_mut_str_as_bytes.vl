// A str is UTF-8, and the bytes of a `&mut str` are writable only by
// unsafe code (Rust's `as_bytes_mut` is unsafe). vole refuses the other
// direction (`&[u8] as &str`: 'as str' does not check that bytes are
// UTF-8), but takes `&mut str as &mut [u8]` for free (a distinct type
// casts to its underlying type), and the String below then holds
// [255, 98, 99].
// ERROR: line 12, column 13
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    let m: &mut str = s.as_mut_str();
    let b = m as &mut [u8];
    b[0] = 0xFF;
    println("{:?} {}", s.as_bytes(), s.chars().count());
}
