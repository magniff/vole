use std::cmp; use std::cmp::max; use std::cmp::min;

fn main(gpa: Gpa) -> i32 {
    println(
        "{} {} {} {} {} {} {} {}", cmp::min(3i64, 4i64), cmp::max(3i64, 4i64), cmp::min(1i64, 7i64),
        5.abs(), 5.abs(), 12i64.clamp(0i64, 10i64), 2i64.clamp(0i64, 10i64),
        4i64.clamp(0i64, 10i64));
    let a = String::from_in("x", gpa);
    let b = String::from_in("y", gpa);
    let m = cmp::max(a, b);
    println("{} {} {m}", cmp::min(2.5, 1.5), cmp::max("a", "b", "b"));
    for i in (((1i64..=3i64))).rev() { print("{}", i); }
    for i in (((1i64..3i64))).rev() { print("{}", i); }
    for i in (((5i64..=5i64))).rev() { print("{}", i); }
    for i in (((6i64..=5i64))).rev() { print("{}", i); }
    println("");
    let s: i64 = (((1i64..=4i64))).rev().map(|x| x * 10).sum::<i64>();
    println("{}", s);
    0
}
