// exclusive or the parameter `&mut [T]`.
use std::arch::aarch64::uint32x4_t; use std::arch::aarch64::uint8x16_t;
use std::arch::aarch64::vdup_n_u8; use std::arch::aarch64::vdupq_n_u32;
use std::arch::aarch64::vdupq_n_u8; use std::arch::aarch64::vst1_u8;
use std::arch::aarch64::vst1q_u32; use std::arch::aarch64::vst2q_u8;
use std::arch::x86_64::__m128i; use std::arch::x86_64::__m256i;
use std::arch::x86_64::_mm256_storeu_si256; use std::arch::x86_64::_mm_storeu_si128;

fn neon(state: &[u32], x: uint32x4_t) {
    vst1q_u32(state, 0, x);
}

fn x86(s: &[u8], v: __m128i) {
    _mm_storeu_si128(s, 0, v);
}

fn main(gpa: Gpa) {
    let mut out: [u8; 16] = [0; 16];
    vst1_u8(&mut out[..], 8, vdup_n_u8(1u8));
    let mut v: Vec<u8, Gpa> = Vec::from_elem_in(0u8, 32usize, gpa);
    let a: uint8x16_t = vdupq_n_u8(2u8);
    vst2q_u8(v.as_slice(), 0, (a, a));
    let mut b: [u8; 32] = [0; 32];
    let w = __m256i::from_bits(v32u8::splat(3));
    if std::arch::has("avx") {
        _mm256_storeu_si256(&mut b[0..32], 0, w);
    }
    let mut st: [u32; 4] = [0; 4];
    neon(&st[..], vdupq_n_u32(1u32));
    if std::arch::has("sse2") {
        x86(&b[..], __m128i::from_bits(a));
    }
}
