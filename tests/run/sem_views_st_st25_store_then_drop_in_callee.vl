// EDITION: rust
// XFAIL: gap 18: rustc disagrees with the rust edition's error: both reject, but rustc's lifetime is borrowck.outlives, the...
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: out stores a view of s (inout), the callee replaces s
// ERROR: error[own.conflict]
fn f(out: &mut Vec<&str, Gpa>, s: &mut String<Gpa>, gpa: Gpa) {
    out.push(s.as_str());
    *s = String::from_in("bye", gpa);
}

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello", gpa);
    let mut out: Vec<&str, Gpa> = Vec::new_in(gpa);
    f(&mut out, &mut s, gpa);
    println("{}", str::from_utf8(out[0usize]).unwrap());
    0
}
