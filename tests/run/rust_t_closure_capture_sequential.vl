// EDITION: rust
// (0.27.0) Hand-translated from tests/run/closure_capture_sequential.vl to Rust's spelling.
// (0.25) The closure model's fine cases: calls in a row, reads after the
// last call, two closures used one after the other, a closure that only
// reads n while n is read too, and a value passed as a parameter instead
// of captured.
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut add = |x: i64| v.push(x);
    add(1);
    add(2);
    println("{}", v.len());
    let mut n = 0;
    let mut f = || {
        n += 10;
    };
    f();
    let mut g = || {
        n += 100;
    };
    g();
    println("{n}");
    let peek = || n * 2;
    println("{n} {}", peek());
    let bump = |m: &mut i64| {
        *m += 1;
    };
    bump(&mut n);
    bump(&mut n);
    println("{n}");
}
// EXPECT: 2
// EXPECT: 110
// EXPECT: 110 220
// EXPECT: 112
// (0.27.2) written against MVS std until it migrates to std2:
