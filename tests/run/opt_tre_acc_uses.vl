// RT-61's family (0.30.2), tail recursion with an accumulator: the
// recursive call's result combined with a value that also reads it (its
// partial result seen twice) is no accumulator; the plain forms are. The
// output is rustc's.
// EXPECT: 0 1 1 3 2
// EXPECT: 1 2 1 1 6
// EXPECT: 2 4 4 3 48
// EXPECT: 3 7 11 7 2448
// EXPECT: 7 29 247 0 6165123579161240192
// EXPECT: 30 466 2147483616 43 172760779009818624
// EXPECT: 1000 500501 18446744073709550614 1943 0
#[inline(never)]
fn plain(n: u64) -> u64 {
    if n == 0 {
        return 1;
    }
    plain(n - 1).wrapping_add(n)
}

#[inline(never)]
fn twice(n: u64) -> u64 {
    if n == 0 {
        return 1;
    }
    let r = twice(n - 1);
    r.wrapping_add(n ^ r)
}

#[inline(never)]
fn xored(n: u64) -> u64 {
    if n == 0 {
        return 3;
    }
    let r = xored(n - 1);
    r ^ (r >> 1).wrapping_add(n)
}

#[inline(never)]
fn mul_self(n: u64) -> u64 {
    if n == 0 {
        return 2;
    }
    let r = mul_self(n - 1);
    r.wrapping_mul(r.wrapping_add(n))
}

fn main() {
    for n in [0u64, 1, 2, 3, 7, 30, 1000] {
        println("{} {} {} {} {}", n, plain(n), twice(n), xored(n), mul_self(n));
    }
}
