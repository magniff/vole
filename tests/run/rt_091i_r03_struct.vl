// (0.30.2, the re-review of g302holes: r91/r03_struct)
// EXPECT: 36 2
// A closure returning a generic struct that holds a closure.
struct W<F> { f: F, n: i64 }

fn main() {
    let v = [1i64, 2, 3];
    let mk = |m: i64| W { f: move |x: i64| v.iter().map(move |y| y * x * m).sum::<i64>(), n: m };
    let w = mk(2);
    println("{} {}", (w.f)(3), w.n);
}
