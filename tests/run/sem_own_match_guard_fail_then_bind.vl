// sem-own: a guard that fails on the first arm, the next arm binds: dropped once.
// EXPECT: other 2
// EXPECT: drop 2
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
enum E<A: Allocator> { A(D<A>), N }

fn main(gpa: Gpa) {
    let e = E::A(mk(2, gpa));
    match e { E::A(d) if d.id == 1 => eat(d), E::A(d) => println("other {}", d.id), E::N => {} }
    println("end");
}
