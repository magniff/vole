// Runs on std since 0.27.2's switch.
// The std item(s): std::str ParseIntError::kind.
// EXPECT: InvalidDigit
// RUSTC: none (std has no std::num: the parse errors are std::str's)
use std::str::{IntErrorKind, ParseIntError};

fn main() {
    let e: ParseIntError = "+-1".parse::<i64>().unwrap_err();
    let k: &IntErrorKind = e.kind();
    println("{:?}", k);
}
