// RULE: (for the fixer)
// (0.27.4, gate 3's hidden borrowck wall: 143 of compiler/src's translated
// errors) An index assignment whose right side reads the same Vec,
// `pcx.nodes[p].b = pcx.nodes[q].a`: the right side's Index::index
// temporary ends at its copy out, before IndexMut, so rustc accepts it;
// vole keeps it live to the assignment (a conflict).
// EXPECT: 7
use std::alloc::Allocator;

#[derive(Clone, Copy)]
struct Node {
    a: i64,
    b: i64,
}

struct Ctx<A: Allocator> {
    nodes: Vec<Node, A>,
}

fn copy_a(p: usize, q: usize, pcx: &mut Ctx<Gpa>) {
    pcx.nodes[p].b = pcx.nodes[q].a;
}

fn main(gpa: Gpa) {
    let mut c = Ctx { nodes: Vec::new_in(gpa) };
    c.nodes.push(Node { a: 5, b: 0 });
    c.nodes.push(Node { a: 7, b: 0 });
    copy_a(0, 1, &mut c);
    println("{}", c.nodes[0].b);
}
