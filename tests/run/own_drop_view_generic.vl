// (0.25) a type with a Drop of its own holds no view, whatever the position
// of the view (a field, an Option, a nested struct) or where it comes from (a
// type argument: `impl<T> Drop for G<T>` with T a view, also inside a Vec).
// Nothing orders a drop before the drop of what the view points into, so
// this is the rule (Rust's dropck, without may_dangle for user impls);
// std's containers, whose drops read no element, still hold views.
// ERROR: [own.drop_view]: 'Q' holds views and cannot implement Drop
// ERROR: [own.drop_view]: 'R' holds views and cannot implement Drop
// ERROR: [own.drop_view]: 'G<[i64]>' holds views (a type argument is one) and cannot implement Drop
// ERROR: [own.drop_view]: 'H<[u8], Gpa>' holds views (a type argument is one) and cannot implement Drop
use std::alloc::Allocator; #[derive(Clone, Copy)] struct P<'a> { s: &'a str }
struct Q<'a> { p: P<'a>, n: i64 }
impl Drop for Q<'_> { fn drop(&mut self) { println("Q"); } }
struct R<'a> { o: Option<&'a [i64]> }
impl Drop for R<'_> { fn drop(&mut self) { println("R"); } }
struct G<T> { x: T }
impl<T> Drop for G<T> { fn drop(&mut self) { println("G"); } }
struct H<T, A: Allocator> { xs: Vec<T, A> }
impl<T, A: Allocator> Drop for H<T, A> { fn drop(&mut self) { println("H"); } }

fn main(gpa: Gpa) {
    let a = [1i64, 2];
    let q = Q { p: P { s: "x" }, n: 1 };
    let r = R { o: Some(&a[..]) };
    let mut g = G { x: &a[..] };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    g = G { x: v.as_slice() };
    let xs: Vec<&str, Gpa> = Vec::new_in(gpa);
    let mut h = H { xs: xs };
    h.xs.push("z");
}
