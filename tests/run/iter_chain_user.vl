// XFAIL: gap 17: compile edition.lenient: 'a' is a value where a reference goes
// A user type implementing Iterator gets the trait's adapters and
// consumers (0.14); closures that change captured variables; HashMap
// chains; sort_by with a closure on a Vec and on a slice.
// EXPECT: counter 55 5 15
// EXPECT: for_each 10 3
// EXPECT: map 50 3 20
// EXPECT: sorted 9 7 5 3 2 1 | 1 2 3 5 7 9 | 90 70 50
use std::collections::HashMap;
use std::hash::FixedState;

#[derive(Clone, Copy)] struct Counter { n: i64, limit: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n < self.limit {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn show(label: &str, x: i64) {
    print("{}", label);
    print("{}", x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    v.push(2);

    show("counter ", Counter { n: 0, limit: 5 }.map(|x| x * x).sum::<i64>());
    show(" ", (Counter { n: 0, limit: 5 }).zip(v.iter().copied()).count() as i64);
    show(" ", Counter { n: 0, limit: 5 }.fold(0i64, |a, x| a + x));
    println("");

    let mut total: i64 = 0;
    let mut calls: i64 = 0;
    (0i64..5i64).for_each(|x| total += x);
    v.iter().copied().take(3usize).for_each(|x| calls += 1);
    show("for_each ", total);
    show(" ", calls);
    println("");

    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    show("map ", m.iter().map(|(k, v)| (*k, *v)).map(|(k, x)| k * x).sum::<i64>());
    show(" ", m.keys().copied().sum::<i64>());
    show(" ", m.values().copied().max().unwrap());
    println("");

    print("sorted");
    v.sort_unstable_by(|a, b| ({ let a = *a; let b = *b; b.cmp(a) }).cmp(&0));
    for x in v {
        show(" ", x);
    }
    print(" |");
    v.as_slice().sort_unstable_by(|a, b| ({ let a = *a; let b = *b; a - b }).cmp(&0));
    for x in v {
        show(" ", x);
    }
    print(" |");
    let mut w = v.iter().copied().map(|x| x * 10).collect_in::<Vec<i64, Gpa>, _>(gpa);
    w.sort_unstable_by(|a, b| ({ let a = *a; let b = *b; b.cmp(a) }).cmp(&0));
    for x in w.iter().copied().take(3usize) {
        show(" ", x);
    }
    println("");
    0
}
