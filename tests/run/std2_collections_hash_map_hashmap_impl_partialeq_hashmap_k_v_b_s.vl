use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut a: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let mut b: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    a.insert(1, 1);
    a.insert(2, 2);
    b.insert(2, 2);
    b.insert(1, 1);
    let same = a == b;
    b.insert(3, 3);
    println("{} {}", same, a == b);
}
