// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::impl PartialEq<HashMap<K, V, B, S>>.
// EXPECT: true false
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut a: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let mut b: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    a.insert(1, 1);
    a.insert(2, 2);
    b.insert(2, 2);
    b.insert(1, 1);
    let same = a == b;
    b.insert(3, 3);
    println("{} {}", same, a == b);
}
