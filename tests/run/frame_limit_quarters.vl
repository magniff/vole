// (0.30.2, RT-466's family) Four locals of 2^60 bytes (AArch64's limit:
// the case is built for it): each fits, as rustc's 2^61 bound on an
// object, and the first three's frame is built and faults as it is
// entered (stack_probe_frame_past_limit's two); with the fourth the
// frame reaches 2^62 bytes. The frame grows through one checked function
// (base::target::frame_grow) at both levels: the fourth local is refused
// where it is declared, never a frame that wraps or passes the end.
// FLAGS: --target aarch64-macos
// ERROR: frame.too_big
// ERROR: line 17, column 13
#[inline(never)]
fn quarters(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 1usize << 60];
        let b = [1u8; 1usize << 60];
        let c = [2u8; 1usize << 60];
        let d = [3u8; 1usize << 60];
        return a[n] + b[n] + c[n] + d[n];
    }
    0
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", quarters(n));
}
