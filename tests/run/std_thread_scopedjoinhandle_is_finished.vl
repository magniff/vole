// Runs on std since 0.27.2's switch.
// The std item(s): std::thread ScopedJoinHandle::is_finished.
// EXPECT: true 7
use std::thread;

fn main() {
    thread::scope(|s| {
        let h = s.spawn(|| 7i64);
        while !h.is_finished() {
            thread::yield_now();
        }
        println("{} {}", h.is_finished(), h.join().unwrap());
    });
}
