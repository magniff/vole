// RULE: D7.1
// (0.30.1) `write(emsg, ..)` reserves `&mut emsg` two-phase (`__r =
// &mut2 emsg`, D7.4) and passes it on as a reborrow, `&mut2 (*__r)`: that
// mention activates it, so a shared borrow of emsg live across the write
// is rustc's E0502 (vole's conflict) at the write. Before, only a whole
// move or copy of `__r` activated it, the reservation stayed shared to
// its end, and the program read the element the write had freed.
// ERROR: error[borrowck.conflict]
// ERROR: line 17, column 5
// ERROR-COUNT: 1
use std::io::Write;

fn main(gpa: Gpa) {
    let mut emsg: Vec<u8, Gpa> = Vec::new_in(gpa);
    emsg.push(7);
    let r = &emsg[0];
    write(emsg, "abcdefghijklmnopqrstuvwxyz0123456789").unwrap();
    println("{}", *r);
}
