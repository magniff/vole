// EDITION: rust
// RULE: D2.8
// (0.27.5) A shared borrow of a promotable rvalue (literals, arrays,
// tuples and repeats of them) has the body's storage, as rustc's
// promotion: a branch's `&[..]` used after the branch, as a slice or as an
// array reference, sliced, a tuple's and a repeat's, a loop's; and
// assigned, where no `let` extends it (rustc: promoted only).
// EXPECT: 5 1 2 3 7 -1 4 6 2
fn names(sub: bool) -> usize {
    let list: &[&str] = if sub {
        &["saturating_sub", "checked_sub", "abs_diff", "sub", "wrapping_sub"]
    }
        else { &["add"] };
    list.len()
}

fn pick(c: bool) -> i64 {
    let a: &[i64; 2] = if c { &[1, 2] } else { &[3, 4] };
    a[0]
}

fn tail(c: bool) -> usize {
    let s: &[i64] = if c { &[1, 2, 3][1..] } else { &[0][..] };
    s.len()
}

fn assigned(c: bool) -> usize {
    let list: &[&str];
    list = if c { &["a", "b"] } else { &["c"] };
    list.len()
}

fn main() {
    let t: &(i64, bool) = if names(true) > 1 { &(7, true) } else { &(8, false) };
    let n: &i64 = if t.1 { &-1 } else { &2 };
    let z: &[u8] = if *n < 0 { &[0u8; 4] } else { &[1u8] };
    let mut total: usize = 0;
    for i in 0..3 {
        let w: &[i64] = if i == 1 { &[1, 2, 3] } else { &[1] };
        total += w.len();
    }
    let c = 3i64;
    println("{} {} {} {} {} {} {} {} {}", names(true), names(false), tail(true), pick(false), t.0,
        *n, z.len(), total + 1 - c as usize + 3, assigned(true));
}
