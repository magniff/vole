// sem-own: (0.25.3) a user generic fn with an FnMut(sink D) bound given a
// closure that only reads its parameter: dropped at the closure's end, once.
// EXPECT: drop 5
// EXPECT: id 5
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn run<F: FnMut(sink D) -> i64>(f: sink F, d: sink D) -> i64 { f(d) }

fn main(gpa: Gpa) {
    println(f"id {run(|d| d.id, mk(5, gpa))}");
    println("end");
}
