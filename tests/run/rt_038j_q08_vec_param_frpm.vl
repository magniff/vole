// RULE: C3.4
// (0.30.2, the re-review 2 of g302holes: holes/q08_vec_param_frpm)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'go', which writes through a raw pointer what it did not make
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

// a &Vec param s buffer made a mutable slice
fn go(v: &Vec<i64, Gpa>) -> bool { let s = unsafe { std::slice::from_raw_parts_mut(
    v.as_ptr() as *mut i64, 1) }; s[0] = 9; true }

fn f(v: &Vec<i64, Gpa>) -> i64
    requires go(v)
{ 1 }

fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa); v.push(1i64); println("{}", f(&v)); println("{}", v[0]);
}
