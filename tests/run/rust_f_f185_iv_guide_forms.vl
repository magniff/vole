// RULE: F18.5
// (0.30.2) Forms the guide's programs found: a precision argument of an
// integer literal, `{:.*}` (usize, as rustc); a closure's `n % 7` on a
// reference to a range's item; a value of literals held in a `Vec` that a
// `'static` closure moves (an integer type is 'static). 0.30.1 typed
// them i32 and passed; this branch's first build refused each.
// EXPECT: [1.25] 15
// EXPECT: 7
use std::thread;
use std::sync::{Arc, Mutex};

fn main(gpa: Gpa) {
    let p = 2;
    println("[{:.*}] {}", p, 1.25, (0..100).filter(|n| n % 7 == 0).count());
    let shared = Arc::new_in(Mutex::new(Vec::new_in(gpa)), gpa);
    let theirs = shared.clone();
    let h = thread::spawn_in(move || theirs.lock().unwrap().push(7), gpa);
    h.join().unwrap();
    let g = shared.lock().unwrap();
    println("{}", (*g)[0]);
}
