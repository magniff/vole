// EDITION: rust
// The std2 item(s): std::time Duration::try_from_secs_f64; std::time Duration::try_from_secs_f32; std::time Duration::from_secs_f64; std::time Duration::from_secs_f32; std::time TryFromFloatSecsError; std::time TryFromFloatSecsError::impl Display.
// EXPECT: Ok(1.5s) Ok(250ms) 2.000000001s 500ms
// EXPECT: cannot convert float seconds to Duration: value is negative
// EXPECT: cannot convert float seconds to Duration: value is either too big or NaN
use std::time::Duration;

fn main() {
    println("{:?} {:?} {:?} {:?}", Duration::try_from_secs_f64(1.5),
        Duration::try_from_secs_f32(0.25), Duration::from_secs_f64(2.000000001),
        Duration::from_secs_f32(0.5));
    println("{}", Duration::try_from_secs_f64(-1.0).unwrap_err());
    println("{}", Duration::try_from_secs_f64(f64::NAN).unwrap_err());
}
