// RULE: C3.4
// (0.30.2, the re-review of g302holes: ov/o01_common)
// RUSTC: none contract clauses are not Rust
// EXPECT: 1 1 2 1 1 1 1
// Common read-only clauses over Vec, slice, String and Option parameters.
fn a(v: &Vec<i64, Gpa>) -> i64
    requires v.iter().all(|x| *x > 0)
{ v[0] }

fn b(s: &[i64]) -> i64
    requires s.iter().sum::<i64>() > 0 && s.contains(&1)
{ s[0] }

fn c(s: &String<Gpa>) -> usize
    requires s.chars().all(|ch| ch != 'z')
    ensures result == s.len()
{ s.len() }

fn d(v: &Vec<i64, Gpa>, o: Option<i64>) -> i64
    requires o.is_some()
{ v[0] }

fn e(s: &[i64]) -> i64
    requires s.windows(2).all(|w| w[0] <= w[1])
{ s[0] }

fn g(v: &Vec<i64, Gpa>) -> i64
    requires { let mut it = v.iter(); it.next().is_some() }

{ v[0] }

fn h(s: &[i64], o: Option<i64>) -> i64
    requires { let mut n = o; n.take().is_some() }

{ s[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let s = String::from_in("ab", gpa);
    println("{} {} {} {} {} {} {}", a(&v), b(&v[..]), c(&s), d(&v, Some(1)), e(&v[..]), g(&v),
        h(&v[..], Some(2)));
}
