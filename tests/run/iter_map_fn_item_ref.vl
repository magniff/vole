// `v.iter().map(dbl)` with `fn dbl(x: &i64) -> i64`: rustc accepts it (a
// fn item is FnMut, and `&mut F` is FnOnce). Before 0.30.2 vole reported
// a type error at std's Map::next (RT-298: a `&mut F` of a fn type now
// meets an Fn bound as its pointee does).
// EXPECT: 12

fn dbl(x: &i64) -> i64 {
    x.wrapping_mul(2)
}

fn total(v: &[i64]) -> i64 {
    v.iter().map(dbl).fold(0, |a, b| a.wrapping_add(b))
}

fn main() {
    let a = [1i64, 2, 3];
    println("{}", total(&a[..]));
}
