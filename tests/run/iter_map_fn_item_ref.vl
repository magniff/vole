// XFAIL: a fn item given to Iterator::map is refused inside std: '&mut fn(&i64) -> i64' does not satisfy 'F: FnOnce(&i64) -> i64' of Option::map (0.30.0 too; 0.30.2)
// `v.iter().map(dbl)` with `fn dbl(x: &i64) -> i64`: rustc accepts it (a
// fn item is FnMut, and `&mut F` is FnOnce); vole reports a type error at
// std's Map::next, not at the program.
// EXPECT: 12

fn dbl(x: &i64) -> i64 {
    x.wrapping_mul(2)
}

fn total(v: &[i64]) -> i64 {
    v.iter().map(dbl).fold(0, |a, b| a.wrapping_add(b))
}

fn main() {
    let a = [1i64, 2, 3];
    println("{}", total(&a[..]));
}
