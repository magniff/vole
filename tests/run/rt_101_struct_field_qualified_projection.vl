// XFAIL: RT-101: a qualified projection <K as Tr>::Out as a struct field's type is refused (trait.unmet 'K' has no impl of 'Tr' that defines 'Out') (0.30.2)
// rustc builds it. From the review of g302holes (pre-existing).
// EXPECT: 3
trait Tr {
    type Out;
}

struct K;

impl Tr for K {
    type Out = i64;
}

struct S {
    a: <K as Tr>::Out,
}

fn main() {
    let s = S { a: 3 };
    println("{}", s.a);
}
