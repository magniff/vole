// RULE: F8.3, F9.3
// `Self::K` in S's impl of A, S's impl of B having a K too: Self is S
// there, and the path does not say which (rustc E0034). 0.30.1 took B's.
// ERROR: error[method.ambiguous]: multiple applicable items: 'K' is an item of more than one trait for 'S'
trait A { const K: i64; fn show(&self) -> i64; }
trait B { const K: i64; }
struct S;
impl A for S { const K: i64 = 1; fn show(&self) -> i64 { Self::K } }
impl B for S { const K: i64 = 2; }
fn main() { let s = S; println("{}", s.show()); }
