// Runs on std since 0.27.2's switch.
// The std item(s): std::result Result::expect.
// EXPECT: 3
// EXIT: 101
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    println("{}", a.expect("a is ok"));
    println("{}", b.expect("b is ok"));
}
