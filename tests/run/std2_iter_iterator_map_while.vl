// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::iter Iterator::map_while.
// EXPECT: [2, 4]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, -1, 4], gpa);
    let a: Vec<i64, Gpa> = v
        .iter()
        .map_while(|x| if *x > 0 { Some(x * 2) } else { None })
        .collect_in(gpa);
    println("{:?}", a);
}
