// EDITION: rust
// The std2 item(s): std::env vars_in; std::env Vars; Vars::impl Iterator.
// EXPECT: STD2_VARS_TEST=a=b
// EXPECT: 1 true 0
use std::env;

fn main(gpa: Gpa) {
    // UNSAFE: changes the environment. SAFETY: one thread, no view kept.
    unsafe { env::set_var("STD2_VARS_TEST", "a=b") };
    let mut seen = 0;
    let mut n = 0;
    for (k, v) in env::vars_in(gpa) {
        n += 1;
        if k == "STD2_VARS_TEST" {
            println("{}={}", k, v);
            seen += 1;
        }
    }
    // UNSAFE: as above. SAFETY: as above.
    unsafe { env::remove_var("STD2_VARS_TEST") };
    let mut again = 0;
    for (k, _) in env::vars_in(gpa) {
        if k == "STD2_VARS_TEST" {
            again += 1;
        }
    }
    println("{} {} {}", seen, n > 1, again);
}
