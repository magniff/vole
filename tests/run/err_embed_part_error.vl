// ERROR-COUNT: 1
embed wgsl SHADE {
    fn shade() -> vec4<f32> {
        return colour;
    }
}

embed wgsl K_A with SHADE {
    @fragment
    fn fs() -> @location(0) vec4<f32> {
        return shade();
    }
}

embed wgsl K_B with SHADE {
    @fragment
    fn fs() -> @location(0) vec4<f32> {
        return shade() * 0.5;
    }
}

fn main() -> i32 {
    println("{} {}", str::from_utf8(K_A.fs).unwrap(), str::from_utf8(K_B.fs).unwrap());
    0
}
