// 0.26.2: an error in a part is reported at the part's own line, once,
// though two modules include it.
// ERROR: error[wgsl.name]: unknown name 'colour'
// ERROR: err_embed_part_error.vl: line 8, column 16
// ERROR-COUNT: 1
embed wgsl SHADE {
    fn shade() -> vec4<f32> {
        return colour;
    }
}

embed wgsl K_A with SHADE {
    @fragment
    fn fs() -> @location(0) vec4<f32> {
        return shade();
    }
}

embed wgsl K_B with SHADE {
    @fragment
    fn fs() -> @location(0) vec4<f32> {
        return shade() * 0.5;
    }
}

fn main() -> i32 {
    println("{} {}", K_A.fs, K_B.fs);
    0
}
