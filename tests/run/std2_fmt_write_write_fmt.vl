// EDITION: rust
// Runs on std2 since its gap closed (0.27.4).
// The std2 item(s): std::fmt Write::write_fmt.
// EXPECT: x=42 y
use std::fmt::Write;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let _ = s.write_fmt(format_args("x={}", 42));
    let _ = write(&mut s, " {}", "y");
    println("{}", s);
}
