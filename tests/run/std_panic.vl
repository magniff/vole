// XFAIL: gap 2: compile type error: no 'print_cstr' in module 'std'
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
// EXPECT: before
// A Vec's get is checked like a slice's index (exit 101).

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i32, Gpa> = Vec::new_in(gpa);
    v.push(1i32);
    v.push(2i32);
    v.push(3i32);
    unsafe { std::print_cstr(c"before\n"); }
    v[3usize]
}
