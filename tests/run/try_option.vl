// `e?` on an Option (0.15): the value, or `return None` from the function;
// in a loop, nested, through a pointer receiver, and as a function's tail.
// EXPECT: 2
// EXPECT: none
// EXPECT: 6
// EXPECT: none
// EXPECT: 3
// EXPECT: 10
use std::alloc::Allocator; fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn quarter(x: i64) -> Option<i64> {
    let h = half(x)?;
    half(h)
}

fn sum_halves(xs: &[i64]) -> Option<i64> {
    let mut total: i64 = 0;
    for &x in xs {
        total += half(x)?;
    }
    Some(total)
}

struct Stack<A: Allocator> { v: Vec<i64, A> }

impl Stack<Gpa> {
    fn top_two(&mut self) -> Option<i64> {
        let a = self.v.pop()?;
        let b = self.v.pop()?;
        Some(a + b)
    }
}

fn eighth(x: i64) -> Option<i64> {
    Some(half(half(x)?)?)
}

fn show(o: Option<i64>) {
    match o {
        Some(v) => {
            print("{}", v);
            println("");
        }
        None => println("none"),
    }
}

fn main(gpa: Gpa) {
    show(quarter(8));
    show(quarter(6));
    show(sum_halves(&[2i64, 4, 6][..]));
    show(sum_halves(&[2i64, 3][..]));
    let mut s = Stack { v: Vec::new_in(gpa) };
    s.v.push(1);
    s.v.push(2);
    show(s.top_two());
    show(eighth(40));
    drop(s.v);
}
