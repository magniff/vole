// (0.30.2, RT-83) -O0's outgoing argument area is reserved by the call
// (gen0's gen_call_sequence), not by the prologue: on x86-64 a 240 KB
// array passed by value goes there, and sp moved down by all of it at once
// before the copy. Now it is probed as a frame is (x64_sp_sub): its
// pages are written top down before the copy starts at its bottom (the
// second probe in pass, after the frame's own). On AArch64 the copy is in
// the caller's frame (passed by reference), probed with it. Run on the
// main thread, which has room: the program is unchanged (6).
// EXPECT: 6
// CHECK-OPT: 0
// CROSS: x86_64-linux aarch64-linux
// ASM(x86_64-linux): vole.pass:
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): call memcpy
// ASM(x86_64-linux): call memcpy
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): call vole.take
// ASM(aarch64-linux): vole.pass:
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): bl vole.take
// ASM(aarch64-macos): vole.pass:
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): bl _vole.take

#[inline(never)]
fn take(a: [i64; 30000]) -> i64 {
    a[0] + a[29999]
}

#[inline(never)]
fn pass(b: &Box<[i64; 30000], Gpa>) -> i64 {
    take(**b)
}

fn main(gpa: Gpa) {
    let b: Box<[i64; 30000], Gpa> = Box::new_in([3i64; 30000], gpa);
    println("{}", pass(&b));
}
