// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145, RT-79, RT-147) A value returned as `impl
// Trait` is dropped as its hidden type is, where rustc drops it: a closure
// that owns a D, dropped by `drop(f)`, at its scope's end, in a Vec, in an
// Option, in a struct field, after a generic function returned it, and
// inside a function that takes it; a nested opaque return (outer's is
// inner's, whose is mk's); an iterator struct that holds a D; an opaque
// type of another module; an array of them. The output is rustc's, its
// drop order too (the twin uses std's Vec). v0.30.1 refused the D (RT-79,
// distinct.kind) and dropped none of a capture that owns memory (RT-145).
// EXPECT: a 1
// EXPECT: drop 1
// EXPECT: after a
// EXPECT: b 2
// EXPECT: drop 2
// EXPECT: after b
// EXPECT: v 4
// EXPECT: drop 3
// EXPECT: drop 4
// EXPECT: after v
// EXPECT: o 5
// EXPECT: h 6
// EXPECT: k 7
// EXPECT: drop 8
// EXPECT: c 8
// EXPECT: drop 9
// EXPECT: s 19
// EXPECT: e 11
// EXPECT: w 23
// EXPECT: end
// EXPECT: drop 11
// EXPECT: drop 12
// EXPECT: drop E11
// EXPECT: drop 7
// EXPECT: drop 6
// EXPECT: drop 5
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn val(d: &D) -> i64 {
    d.k
}

fn mk(k: i64) -> impl Fn() -> i64 {
    let d = D { k: k };
    move || val(&d)
}

fn inner(k: i64) -> impl Fn() -> i64 {
    mk(k)
}

fn outer(k: i64) -> impl Fn() -> i64 {
    inner(k)
}

struct It {
    d: D,
    n: i64,
}

impl Iterator for It {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n > 0 {
            self.n -= 1;
            Some(self.d.k + self.n)
        } else {
            None
        }
    }
}

fn iter(k: i64) -> impl Iterator<Item = i64> {
    It { d: D { k: k }, n: 2 }
}

mod m {
    pub struct E {
        pub k: i64,
    }

    impl Drop for E {
        fn drop(&mut self) {
            println("drop E{}", self.k);
        }
    }

    fn bump(e: &mut E) -> i64 {
        e.k += 1;
        e.k
    }

    pub fn mk(k: i64) -> impl FnMut() -> i64 {
        let mut e = E { k: k };
        move || bump(&mut e)
    }
}

struct Holder<F> {
    f: F,
}

fn keep<F: Fn() -> i64>(f: F) -> F {
    f
}

fn consume<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn main(gpa: Gpa) {
    let a = mk(1);
    println("a {}", a());
    drop(a);
    println("after a");
    {
        let b = outer(2);
        println("b {}", b());
    }
    println("after b");
    let mut v: Vec<_, Gpa> = Vec::new_in(gpa);
    v.push(mk(3));
    v.push(mk(4));
    println("v {}", (v[1])());
    drop(v);
    println("after v");
    let o = Some(mk(5));
    if let Some(f) = &o {
        println("o {}", f());
    }
    let h = Holder { f: mk(6) };
    println("h {}", (h.f)());
    let k = keep(mk(7));
    println("k {}", k());
    println("c {}", consume(mk(8)));
    let mut s = 0i64;
    for x in iter(9) {
        s += x;
    }
    println("s {}", s);
    let mut e = m::mk(10);
    println("e {}", e());
    let w = [mk(11), mk(12)];
    println("w {}", (w[0])() + (w[1])());
    println("end");
}
