// ERROR: the trait 'Q' is not implemented for 'Y<W>'
// (RT-270) an impl's `T: Tr` (Tr's default argument i32) is not met by W, which has only Tr<i64>: the impl is not chosen (rustc E0277; v0.30.1 accepted it).
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

trait Q {
    fn q(&self) -> i64;
}

struct Y<T> {
    t: T,
}

impl<T: Tr> Q for Y<T> {
    fn q(&self) -> i64 {
        2
    }
}

fn need<T: Q>(t: &T) -> i64 {
    t.q()
}

fn main() {
    println("{}", need(&Y { t: W { r: 0 } }));
}
