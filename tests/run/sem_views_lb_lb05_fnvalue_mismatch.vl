// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd abcd (a fn value of a by-reference let instance, called indirectly)
// EXPECT: abcd
// EXPECT: a
#[derive(Clone, Copy)] struct E { name: [u8; 4], len: i64 }
fn nm(e: &E) -> &[u8] { &e.name[..e.len as usize] }
fn ln(e: &E) -> &[u8] { &e.name[0..1] }
fn pick(k: i64) -> fn(&E) -> &[u8] { if k > 0 { nm } else { ln } }

fn main() -> i32 {
    let e = E { name: [b'a', b'b', b'c', b'd'], len: 4 };
    let g = pick(1);
    let r = g(&e);
    println("{}", str::from_utf8(r).unwrap());
    let h = pick(0);
    println("{}", str::from_utf8(h(&e)).unwrap());
    0
}
