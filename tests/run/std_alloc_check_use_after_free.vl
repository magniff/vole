// FLAGS: --check-alloc
// RULE: Z5.1
// The std item(s): std::alloc Gpa (the checking allocator, --check-alloc).
// EXIT: 101
// STDERR: use after free: block #1 (8 bytes), allocated at std_alloc_check_use_after_free.vl:12:13, freed at std_alloc_check_use_after_free.vl:17:9
// A write to a block after it is given back faults on its pages, and the
// fault names the block.
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let l = Layout::from_size_align(8, 8).unwrap();
    let p = gpa.allocate(l).unwrap();
    // UNSAFE: a write after the block is given back, on purpose.
    // SAFETY: none: the case is the use after free the checker reports.
    unsafe {
        *p.as_ptr() = 1;
        gpa.deallocate(p, l);
        *p.as_ptr() = 2;
    }
}
