// RULE: C3.4
// (0.30.2, review of RT-38g) A clause copying a raw pointer parameter's
// value into a struct of its own and calling a `&mut self` method that
// writes through it: the callee's raw write reaches the caller's memory
// through a pointer the clause read, so it is refused (the parameter's
// type holds a raw pointer, contracts::raw_inputs).
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'H::poke', which writes through a raw pointer
// ERROR-COUNT: 1
struct H {
    p: *mut i64,
}

impl H {
    fn poke(&mut self) -> bool {
        // UNSAFE: test
        // SAFETY: test
        unsafe {
            *self.p = 9;
        }
        true
    }
}

fn f(h: &H) -> i64
    requires {
    let mut mine = H { p: h.p };
    mine.poke()
}

{
    1
}

fn main() {
    let mut x = 1i64;
    let h = H { p: &raw mut x };
    println("{}", f(&h));
    println("{}", x);
}
