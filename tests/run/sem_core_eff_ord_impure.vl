// EDITION: rust
// Ord's cmp is #[pure], which binds every impl: one that prints is rejected.
// ERROR: 'V::cmp' implements 'Ord::cmp', which is #[pure], but it does io
#[derive(Clone, Copy)] struct V { n: i64 }

impl Ord for V {
    fn cmp(&self, o: &V) -> std::cmp::Ordering { ({ println("io"); self.n - o.n }).cmp(&0) }
} impl PartialOrd for V { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } } impl PartialEq for V {
    fn eq(&self, o: &Self) -> bool { self.cmp(o) == std::cmp::Ordering::Equal }
} impl Eq for V {}

fn main() -> i32 {
    println("{}", V { n: 1 } < V { n: 2 });
    0
}
