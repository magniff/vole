// EDITION: rust
// The std2 item(s): std::collections::hash_map HashMap::impl Clone.
// EXPECT: Some(1) Some(5)
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let c = m.clone();
    m.insert(1, 5);
    println("{:?} {:?}", c.get(&1), m.get(&1));
}
