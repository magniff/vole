// rustc E0596 at both (twin .rs.txt). Refused right today: `let p: *mut
// i64 = h.r;` then `P { p }` (struct-literal shorthand of a raw pointer),
// and `return h.r;` in a fn. `h.r as *mut i64` behind a `?` is RT-197's
// form; `h.r as *const i64 as *mut i64` rustc accepts (a cast, no borrow).
// ERROR: line 13
// ERROR: line 18
// ERROR-COUNT: 2
struct H<'a> {
    r: &'a mut i64,
}

fn rep(h: &H) -> [*mut i64; 2] {
    [h.r; 2]
}

fn clos(h: &H) -> *mut i64 {
    let mut f = || -> *mut i64 {
        return h.r;
    };
    f()
}

fn main() {
    let mut a = 1i64;
    let h = H { r: &mut a };
    let _ = (rep(&h), clos(&h));
    println("end");
}
