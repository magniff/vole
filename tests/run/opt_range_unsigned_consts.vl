// (0.30) An unsigned order against a constant is decided by the facts
// of the same kind about the same value, whatever its sign (middle/range,
// unsigned_bound): `len >= 2` makes `len > 1` true, `2 < len` makes
// `1 < len` true, `n < 10` makes `n <= 20` true. The intervals are signed
// and a slice's length is of unknown sign to them, so a length tested
// against one constant removed only the check that was the same test:
// `if b.len() >= 3 { b[1] + b[2] }` kept both checks. Here: the second
// test of each pair is folded (no call of `other` is left), the guarded
// elements have no check; a test the facts do not decide is still asked,
// and a signed order says nothing of the unsigned one (-1 is at most 5,
// and as a usize it is not).
// EXPECT: other 2
// EXPECT: other 2
// EXPECT: 1 1 1 1 1
// EXPECT: 2 3
// EXPECT: 98 197 0
// CHECK: fn ge_gt:
// CHECK-NOT: call other
// CHECK: fn lt_lt:
// CHECK-NOT: call other
// CHECK: fn below_le:
// CHECK-NOT: call other
// CHECK: fn eq_lt:
// CHECK-NOT: call other
// CHECK: fn not_ge_lt:
// CHECK-NOT: call other
// CHECK: fn ge_not_gt:
// CHECK: call other
// CHECK: fn signed_le:
// CHECK: call other
// CHECK: fn second:
// CHECK-NOT: rt.panic
// CHECK: fn second_third:
// CHECK-NOT: rt.panic
// CHECK: fn main:
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

#[inline(never)]
fn other(k: i64) -> i64 {
    unsafe { printf(c"other %ld\n", k); }
    k
}

#[inline(never)]
fn ge_gt(n: usize) -> i64 {
    if n >= 2 {
        if n > 1 { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn lt_lt(n: usize) -> i64 {
    if 2 < n {
        if 1 < n { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn below_le(n: usize) -> i64 {
    if n < 10 {
        if n <= 20 { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn eq_lt(n: usize) -> i64 {
    if n == 5 {
        if n < 9 { 1 } else { other(2) }
    } else {
        0
    }
}

// The fact of the branch not taken: not below 4 is at least 4.
#[inline(never)]
fn not_ge_lt(n: usize) -> i64 {
    if n < 4 {
        0
    } else if n >= 3 {
        1
    } else {
        other(2)
    }
}

// Not decided: at least 2 may be 2.
#[inline(never)]
fn ge_not_gt(n: usize) -> i64 {
    if n >= 2 {
        if n > 2 { 1 } else { other(2) }
    } else {
        0
    }
}

// A signed order is no unsigned one.
#[inline(never)]
fn signed_le(x: i64) -> i64 {
    if x <= 5 {
        if x as usize <= 5 { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn second(b: &[u8]) -> u8 {
    if b.len() >= 2 { b[1] } else { 0 }
}

#[inline(never)]
fn second_third(b: &[u8]) -> u8 {
    if b.len() >= 3 { b[1] + b[2] } else { 0 }
}

fn main() -> i32 {
    let s = b"abc";
    let pairs = (ge_gt(3) + ge_gt(1), lt_lt(3) + lt_lt(2), below_le(7) + below_le(30),
        eq_lt(5) + eq_lt(6), not_ge_lt(9) + not_ge_lt(1));
    let open = ge_not_gt(2) + ge_not_gt(1);
    let signed = signed_le(-1) + signed_le(4) + signed_le(9);
    unsafe {
        printf(c"%ld %ld %ld %ld %ld\n", pairs.0, pairs.1, pairs.2, pairs.3, pairs.4);
        printf(c"%ld %ld\n", open, signed);
        printf(c"%d %d %d\n", second(s) as i32, second_third(s) as i32, second(&s[..1]) as i32);
    }
    0
}
