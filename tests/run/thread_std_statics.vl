// EXPECT: whole 1 line abcdefghijklmnopqrstuvwxyz
// EXPECT: printed 4 x 10
// EXPECT: file 800 lines whole: true
// EXPECT: stdin 300 lines, sum 45150
// EXPECT: allocated 4 x 200
// EXPECT: done

use std::{fs, process, thread};
use std::fmt::Fmt;
use std::sync::atomic::{AtomicI64, Ordering};

static PRINTED: AtomicI64 = AtomicI64::new(0);

fn main(gpa: Gpa) -> i32 {
    let path = format_in(f"/tmp/vole_thread_std_statics_{process::id()}.txt", gpa);
    let file = fs::File::create(path.as_slice()).unwrap();
    let fd = file.as_raw_fd();
    var hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 0..4 {
        hs.push(thread::spawn(sink || {
            var kept = 0;
            for i in 0..200 {
                var f = Fmt::to_fd(fd);
                f.str("thread ");
                f.int(k);
                f.str(" line ");
                f.int(i);
                f.str(" abcdefghijklmnopqrstuvwxyz\n");
                f.flush();
                if i % 20 == 0 {
                    println(f"whole {k + 1 - k} line abcdefghijklmnopqrstuvwxyz");
                    PRINTED.fetch_add(1, Ordering::Relaxed);
                }
                var v: Vec<i64> = Vec::new_in(gpa);
                v.push(i);
                v.push(k);
                kept += v.len() / 2;
            }
            kept
        }));
    }
    var lines = 0;
    var sum = 0;
    var line = Buf::new_in(gpa);
    while read_line(&line).unwrap() {
        lines += 1;
        sum += parse_int(line.as_slice()).unwrap_or(-1000000);
        if lines % 100 == 0 {
            println(f"whole {lines / lines} line abcdefghijklmnopqrstuvwxyz");
        }
    }
    var kept = 0;
    while hs.len() > 0 { kept += hs.pop().unwrap().join(); }
    drop(file);
    let text = fs::read_in(path.as_slice(), gpa).unwrap();
    var whole = true;
    var count = 0;
    for l in split_in(text.as_slice(), '\n', gpa).iter() {
        if l.len == 0 { continue; }
        count += 1;
        if !(l.len > 30 && l[0..7] == "thread " && l[l.len - 27..] == " abcdefghijklmnopqrstuvwxyz") {
            whole = false;
        }
    }
    let _ = fs::remove_file(path.as_slice());
    println(f"printed 4 x {PRINTED.load(Ordering::SeqCst) / 4}");
    println(f"file {count} lines whole: {whole}");
    println(f"stdin {lines} lines, sum {sum}");
    println(f"allocated 4 x {kept / 4}");
    println("done");
    0
}
