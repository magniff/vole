// 0.26.2: gpu.unwritten at check time (diagnostic 4, a warning): a buffer
// bound at a uniform binding that nothing in the function writes (no
// write_buffer, map_write or copy into it), and that is never passed to
// another function or stored.
// REQUIRES: metal
// LINK: std::gpu and std::window name the frameworks they link
// WARNING: but no write_buffer, map_write or copy into it is in this function
// EXPECT: built
use std::gpu;
use std::gpu::BufferUsage;

embed wgsl K {
    @group(0) @binding(0) var<uniform> params: vec4<f32>;
    @group(0) @binding(1) var<storage, read_write> cells: array<u32>;

    @compute @workgroup_size(64)
    fn evolve(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] = cells[id.x] + u32(params.x);
    }
}

fn setup(dev: gpu::Device) -> Result<gpu::BindGroup, gpu::Error> {
    let pipe = dev.compute_pipeline(dev.shader_wgsl(K.src)?, K.evolve)?;
    let params = dev.buffer(16, BufferUsage::UNIFORM | BufferUsage::COPY_DST);
    let cells = dev.buffer(256, BufferUsage::STORAGE | BufferUsage::COPY_DST);
    Ok(dev.bind_group(pipe.bind_layout(0), [gpu::bind(0, params), gpu::bind(1, cells)][..]))
}

fn main() -> i32 {
    println("built");
    0
}
