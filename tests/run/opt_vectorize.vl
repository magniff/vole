// ASM(aarch64-macos): _vole.prod_i32:
// ASM(aarch64-macos): mul v
// ASM(aarch64-macos): _vole.axpy:
// ASM(aarch64-macos): ldr q
// ASM(aarch64-macos): fmul v
// ASM(aarch64-macos): fadd v
// ASM(aarch64-macos): str q
// ASM(x86_64-macos): _vole.axpy:
// ASM(x86_64-macos): movups
// ASM(x86_64-macos): mulpd
// ASM(x86_64-macos): addpd
// ASM(x86_64-linux): vole.axpy:
// ASM(x86_64-linux): mulpd
// ASM(x86_64-linux): addpd
// CHECK: fn sum_i32:
// CHECK: v4i32 = load
// CHECK: vbin.add
// CHECK: vsum
// CHECK: fn sum_u8:
// CHECK: v16i8 = load
// CHECK: fn xor_i64:
// CHECK: vbin.xor
// CHECK: fn prod_i32:
// CHECK: fn axpy:
// CHECK: v2f64 = load
// CHECK: vbin.mul
// CHECK: vbin.add
// CHECK: store
// CHECK: fn scale_f32:
// CHECK: vneg
// CHECK: vbin.div
// CHECK: fn fill:
// CHECK: vsplat
// CHECK: fn stencil:
// CHECK: v2f64 = load
// CHECK: fn copy_shift:
// CHECK: v4i32 = load
// 0.10: loops the vectorizer takes (and some it must not), compared at
// every level.
// (0.26.4) The overflow checks off: its vectorized kernels' integer lanes wrap.
// FLAGS: --overflow-checks=off
extern "C" {
    fn printf(f: *mut u8, ...) -> i32;
}

#[inline(never)]
fn sum_i32(s: &[i32]) -> i32 {
    let mut t: i32 = 0;
    for i in 0..s.len() as i64 {
        t += s[i as usize];
    }
    t
}

#[inline(never)]
fn sum_u8(s: &[u8]) -> u8 {
    let mut t: u8 = 0;
    for i in 0..s.len() as i64 {
        t += s[i as usize];
    }
    t
}

#[inline(never)]
fn xor_i64(s: &[i64]) -> i64 {
    let mut t: i64 = 77;
    for i in 0..s.len() as i64 {
        t ^= s[i as usize];
    }
    t
}

#[inline(never)]
fn and_or(s: &[u16]) -> u64 {
    let mut a: u16 = 65535;
    let mut o: u16 = 0;
    for i in 0..s.len() as i64 {
        a &= s[i as usize];
        o |= s[i as usize];
    }
    (a as u64) << 16 | o as u64
}

#[inline(never)]
fn prod_i32(s: &[i32]) -> i32 {
    let mut p: i32 = 1;
    for i in 0..s.len() as i64 {
        p *= s[i as usize];
    }
    p
}

#[inline(never)]
fn sub_i16(s: &[i16]) -> i16 {
    let mut t: i16 = 1000;
    for i in 0..s.len() as i64 {
        t -= s[i as usize];
    }
    t
}

#[inline(never)]
fn axpy(a: f64, x: &[f64], y: &mut [f64]) {
    for i in 0..x.len() as i64 {
        y[i as usize] = y[i as usize] + a * x[i as usize];
    }
}

#[inline(never)]
fn scale_f32(x: &[f32], k: f32, out: &mut [f32]) {
    for i in 0..out.len() as i64 {
        out[i as usize] = -(x[i as usize] * k) / (x[i as usize] + 1.0);
    }
}

#[inline(never)]
fn fill(s: &mut [i8], v: i8) {
    for i in 0..s.len() as i64 {
        s[i as usize] = v;
    }
}

#[inline(never)]
fn stencil(src: &[f64], dst: &mut [f64], n: i64) {
    for j in 1..n - 1 {
        dst[j as usize] = 0.25 * (
            src[(j - 1) as usize] + src[(j + 1) as usize] + 2.0 * src[j as usize]);
    }
}

#[inline(never)]
fn copy_shift(a: &[i32], b: &mut [i32]) {
    for i in 0..a.len() as i64 {
        b[i as usize] = a[i as usize] + 1;
    }
}

// The twins: the same loops on raw pointers, for operands that overlap.
// UNSAFE (each): the operands overlap, which two slices may not.
// SAFETY (each): the callers pass pointers into one live array and a
// count that keeps every access inside it.
#[inline(never)]
unsafe fn axpy_raw(a: f64, x: *const f64, y: *mut f64, n: usize) {
    for i in 0..n {
        *y.add(i) = *y.add(i) + a * *x.add(i);
    }
}

#[inline(never)]
unsafe fn scale_f32_raw(x: *const f32, k: f32, out: *mut f32, n: usize) {
    for i in 0..n {
        *out.add(i) = -(*x.add(i) * k) / (*x.add(i) + 1.0);
    }
}

#[inline(never)]
unsafe fn stencil_raw(src: *const f64, dst: *mut f64, n: usize) {
    for j in 1..n - 1 {
        *dst.add(j) = 0.25 * (*src.add(j - 1) + *src.add(j + 1) + 2.0 * *src.add(j));
    }
}

#[inline(never)]
unsafe fn copy_shift_raw(a: *const i32, b: *mut i32, n: usize) {
    for i in 0..n {
        *b.add(i) = *a.add(i) + 1;
    }
}

fn main() -> i32 {
    let mut ints: [i32; 37] = [0; 37];
    for i in 0..37 {
        ints[i as usize] = (i * 7919 % 1000 - 500) as i32;
    }
    for n in 0..37 {
        unsafe { printf(c"%d,", sum_i32(&ints[0..n as usize])); }
    }
    unsafe { printf(c"\n%d\n", prod_i32(&ints[3..20])); }
    let mut bytes: [u8; 100] = [0; 100];
    for i in 0..100 {
        bytes[i as usize] = (i * 37 + 11) as u8;
    }
    for start in 0..5 {
        unsafe { printf(c"%d,", sum_u8(&bytes[start as usize..(100 - start) as usize]) as i32); }
    }
    let mut longs: [i64; 9] = [0i64; 9];
    for i in 0..9 {
        longs[i as usize] = i * 1234567 - 99;
    }
    let mut halves: [u16; 21] = [0; 21];
    let mut shorts: [i16; 21] = [0; 21];
    for i in 0..21 {
        halves[i as usize] = (65535 - i * 3) as u16;
        shorts[i as usize] = (i * 1111) as i16;
    }
    unsafe {
        printf(c"\n%ld %lx %d\n", xor_i64(&longs[0..9]), and_or(&halves[0..21]),
            sub_i16(&shorts[0..21]) as i32);
    }
    // (Two lengths: with one, a constant, the loop would be unrolled whole.)
    unsafe { printf(c"%ld\n", xor_i64(&longs[2..7])); }
    let mut x: [f64; 13] = [0.0; 13];
    let mut y: [f64; 13] = [0.0; 13];
    for i in 0..13 {
        x[i as usize] = i as f64 * 0.5;
        y[i as usize] = 1.0 / (i as f64 + 1.0);
    }
    axpy(3.0, &x[0..13], &mut y[0..13]);
    // Overlapping: y shifted by one against itself.
    let yp = y.as_mut_ptr();
    // UNSAFE: the two operands are one array, shifted by one.
    // SAFETY: twelve elements from yp and from yp + 1 are inside y's 13.
    unsafe {
        axpy_raw(0.5, yp as *const f64, yp.add(1), 12);
        axpy_raw(2.0, yp.add(1) as *const f64, yp, 12);
    }
    for i in 0..13 {
        unsafe { printf(c"%.17g,", y[i as usize]); }
    }
    let mut f: [f32; 11] = [0.0; 11];
    let mut g: [f32; 11] = [0.0; 11];
    for i in 0..11 {
        f[i as usize] = i as f32 - 4.5;
    }
    scale_f32(&f[0..11], 1.25, &mut g[0..11]);
    let fp = f.as_mut_ptr();
    // UNSAFE: the two operands are one array, shifted by one.
    // SAFETY: ten elements from fp and from fp + 1 are inside f's 11.
    unsafe {
        scale_f32_raw(fp as *const f32, 0.75, fp.add(1), 10);
    }
    unsafe { printf(c"\n"); }
    for i in 0..11 {
        unsafe { printf(c"%.9g/%.9g,", g[i as usize] as f64, f[i as usize] as f64); }
    }
    let mut cs: [i8; 40] = [0; 40];
    fill(&mut cs[3..38], -7);
    let mut t: i64 = 0;
    for i in 0..40 {
        t = t * 3 + cs[i as usize] as i64;
    }
    unsafe { printf(c"\n%ld\n", t); }
    let mut grid: [f64; 30] = [0.0; 30];
    let mut out: [f64; 30] = [0.0; 30];
    for i in 0..30 {
        grid[i as usize] = (i * i % 7) as f64;
    }
    stencil(&grid[0..30], &mut out[0..30], 30);
    let op = out.as_mut_ptr();
    let gp = grid.as_mut_ptr();
    // UNSAFE: an array against itself, whole and shifted by one.
    // SAFETY: 30 elements from op are out's; 29 from gp and from gp + 1
    // are inside grid's 30.
    unsafe {
        stencil_raw(op as *const f64, op, 30);
        stencil_raw(gp as *const f64, gp.add(1), 29);
    }
    for i in 0..30 {
        unsafe { printf(c"%g/%g,", out[i as usize], grid[i as usize]); }
    }
    let mut a: [i32; 20] = [0; 20];
    for i in 0..20 {
        a[i as usize] = i as i32;
    }
    let ap = a.as_mut_ptr();
    // UNSAFE: the two operands are one array, shifted by one.
    // SAFETY: 19 elements from ap and from ap + 1 are inside a's 20.
    unsafe {
        copy_shift_raw(ap as *const i32, ap.add(1), 19);
    }
    unsafe { printf(c"\n%d %d %d\n", a[0], a[10], a[19]); }
    // A check that fails part way: the stores before it happen.
    let mut short: [i32; 6] = [0; 6];
    copy_shift(&a[0..10], &mut short[0..6]);
    0
}
