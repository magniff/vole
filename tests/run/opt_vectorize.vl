// EDITION: rust
// (0.28: a `&mut [T]` parameter is apart from the others, so the calls
// whose operands overlap on purpose go to the kernels' raw-pointer twins,
// `NAME_raw`: there the vectorizer must check the overlap at run time.)
// EXPECT: 0,-500,-81,257,514,690,785,799,732,584,355,45,-346,-818,-371,-5,280,484,607,649,610,490,289,7,-356,-800,-325,69,382,614,765,835,824,732,559,305,-30,
// EXPECT: 1801420800
// EXPECT: 186,85,240,139,38,
// EXPECT: -8321080 ffc0ffff 29834
// EXPECT: 7946474
// EXPECT: 6,11.666666666666668,18.666666666666668,26.483333333333334,34.774999999999999,43.339880952380952,52.062797619047615,60.878621031746029,69.750421626984121,78.657028995310242,87.586090255230886,96.530224614794918,33.17101769216027,
// EXPECT: -1.60714281/-4.5,-1.75/-0.964285731,-2.08333325/20.2500095,-3.75/-0.714705944,1.25/1.87886655,-0.416666657/-0.489480764,-0.75/0.719092488,-0.892857134/-0.313723326,-0.972222209/0.342853695,-1.02272725/-0.191487938,-1.05769229/0.177629948,
// EXPECT: -1575993670618490739
// EXPECT: 0/0,1.4375/1,2.35938/1.5,2.46484/1.5,2.55371/1.625,2.38843/2.1875,1.47211/1.75,0.993027/1.42188,1.68576/1.39844,2.42144/2.05469,2.48036/1.87695,2.55759/1.95215,2.3894/2.44531,1.47235/1.96069,0.993087/1.59167,1.68577/1.53601,2.42144/2.16592,2.48036/1.96696,2.55759/2.02496,2.3894/2.50422,1.47235/2.00835,0.993087/1.63023,1.68577/1.5672,2.42144/2.19116,2.48036/1.98738,2.55759/2.04148,2.3894/2.51759,1.47235/2.01916,0.618087/1.63898,0/1,
// EXPECT: 0 10 19
// EXIT: 101
