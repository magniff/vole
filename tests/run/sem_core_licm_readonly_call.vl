// A readonly call in a loop whose argument changes in the loop.
// FLAGS: -O2
// EXPECT: 15
static mut Z: i64 = 0;
#[inline(never)]
fn first(v: &Vec<i64, Gpa>) -> i64 { v[0] }

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    while k < 5 + unsafe { Z } { t += first(&v); v[0] += 1; k += 1; }
    println("{}", t);
    0
}
