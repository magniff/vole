// XFAIL: std2's arena under --check-alloc: a block given back inside a live chunk keeps its pages, so the stale read prints 1
// FLAGS: --check-alloc
// EXIT: 101
// STDERR: use after free: block #2 (32 bytes) of an arena, allocated at
// STDERR: checkalloc_arena_grow.vl:16:5, freed at
// STDERR: checkalloc_arena_grow.vl:19:9
// 0.16: --check-alloc: a pointer into an arena Vec kept while it grows
// (every move gives the old pages back).
// (0.28: a slice kept across the pushes is borrowck.conflict; this is a raw
// pointer. The old std's arena put each block on pages of its own under
// --check-alloc; std2's does not yet.)
use std::alloc::Arena;

fn main(gpa: Gpa) -> i32 {
    let a = Arena::new_in(gpa);
    let mut v: Vec<i64, &Arena<Gpa>> = Vec::new_in(&a);
    v.push(1);
    let p = v.as_ptr();
    for i in 0..100 {
        v.push(i);
    }
    // UNSAFE: a pointer to the Vec's first block, read after the Vec grew.
    // SAFETY: none, on purpose: --check-alloc is to stop the read.
    println("stale {}", unsafe { *p });
    0
}
