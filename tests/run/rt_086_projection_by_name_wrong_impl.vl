// ERROR: borrow
// Unsound. W has `impl Tr<i32>` (Out = &'static str) and `impl Tr<i64>`
// (Out = &'a str). go's bound is Tr<i64>, so go(&W { r: st.as_str() })
// returns &'a str, which must not outlive st. vole reads Out from
// Tr<i32>'s impl, takes the result as 'static and accepts the program:
// `s` reads freed memory. rustc: E0597 (`st` does not live long enough).
// The cause: places::regions::proj_walk chooses the impl by name, with no
// trait and no arguments.
trait Tr<U> {
    type Out;
    fn get(&self) -> Self::Out;
}

struct W<'a> {
    r: &'a str,
}

impl<'a> Tr<i32> for W<'a> {
    type Out = &'static str;

    fn get(&self) -> &'static str {
        "s"
    }
}

impl<'a> Tr<i64> for W<'a> {
    type Out = &'a str;

    fn get(&self) -> &'a str {
        self.r
    }
}

fn go<T: Tr<i64>>(t: &T) -> T::Out {
    t.get()
}

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa);
        go(&W { r: st.as_str() })
    };
    println("{}", s);
}
