// The std2 item(s): std::sync::mpsc channel_in, Sender (send, clone, drop), Receiver (recv,
// try_recv, iter, try_iter, into_iter), SendError, RecvError, TryRecvError and their Display,
// on one thread (between threads: sync_mpsc_threads).
// RUSTC: none (channel_in takes the allocator)
// EXPECT: Ok(7) Err(Empty)
// EXPECT: 3 Err(Disconnected) Err(RecvError)
// EXPECT: [1, 2, 3] []
// EXPECT: 6
// EXPECT: Err(9) sending on a closed channel
// EXPECT: receiving on a closed channel / receiving on an empty channel
use std::sync::mpsc;
use std::sync::mpsc::{RecvError, TryRecvError};

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in(gpa);
    tx.send(7i64).unwrap();
    println("{:?} {:?}", rx.recv(), rx.try_recv());

    let tx2 = tx.clone();
    tx.send(1).unwrap();
    tx2.send(2).unwrap();
    drop(tx);
    drop(tx2);
    let mut sum = 0;
    for x in rx.iter() {
        sum += x;
    }
    println("{} {:?} {:?}", sum, rx.try_recv(), rx.recv());

    let (tx, rx) = mpsc::channel_in(gpa);
    for i in 1..4i64 {
        tx.send(i).unwrap();
    }
    let now: Vec<i64, Gpa> = rx.try_iter().collect_in(gpa);
    let then: Vec<i64, Gpa> = rx.try_iter().collect_in(gpa);
    println("{:?} {:?}", now, then);

    for i in 1..4i64 {
        tx.send(i).unwrap();
    }
    drop(tx);
    let mut total = 0;
    for x in rx {
        total += x;
    }
    println("{}", total);

    let (tx, rx) = mpsc::channel_in(gpa);
    drop(rx);
    let e = tx.send(9i64).unwrap_err();
    println("Err({}) {}", e.0, e);
    println("{} / {}", RecvError, TryRecvError::Empty);
}
