// RULE: D2.7
// (0.30.1, RT-33 round 4, F2) An inherent method named `index` or `deref`
// is no Index or Deref impl: a `&mut` of the shared view it gives is
// rustc's "data in a `&` reference" (E0596). diag.vl overloaded_call asks
// the trait of the method's impl; before, its name decided, and the
// message said "data in an index of `W`".
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 28, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 29, column 13
// ERROR-COUNT: 2
struct W {
    s: &'static [u8],
}

impl W {
    fn index(&self, n: usize) -> &[u8] {
        &self.s[..n]
    }

    fn deref(&self) -> &[u8] {
        self.s
    }
}

fn main() {
    let w = W { s: b"abc" };
    w.index(2).reverse();
    let m = &mut *w.deref();
    m[0] = 1;
}
