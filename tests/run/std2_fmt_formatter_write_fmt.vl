// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter::write_fmt.
// EXPECT: v=7
use std::fmt::{Display, Formatter};

struct S {
    v: i64,
}

impl Display for S {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.write_fmt(format_args("v={}", self.v))
    }
}

fn main() {
    println("{}", S { v: 7 });
}
