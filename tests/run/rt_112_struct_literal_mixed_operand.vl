// XFAIL: RT-112: a struct literal on the left of an operator whose impl takes another right-hand type is refused: `V { .. } * 3.0` with `impl Mul<f64> for V` (0.30.2)
// rustc selects the impl from both operand types. vole types a struct
// literal on the left against the right operand's type: `V { x: 1.0, y:
// 2.0 } * 3.0` is `expected 'V', got 'f64'` (at the 3.0), `W { v: 97 } +
// 32i64` with `impl Add<i64> for W` is `expected 'i64', got 'W'` (at the
// literal), and `V { .. } == 4i64` with `impl PartialEq<i64> for V` the
// same. The left operand as a variable, a call, `(a)`, `{ a }` or an if
// works; only the struct literal fails. Since 0.28.0.
// EXPECT: V { x: 3.0, y: 6.0 } true W { v: 517 } W { v: 7 }
use std::ops::{Add, Mul};

#[derive(Clone, Copy, Debug)]
struct V {
    x: f64,
    y: f64,
}

impl Mul<f64> for V {
    type Output = V;

    fn mul(self, k: f64) -> V {
        V { x: self.x * k, y: self.y * k }
    }
}

impl PartialEq<i64> for V {
    fn eq(&self, o: &i64) -> bool {
        self.x as i64 == *o
    }
}

#[derive(Clone, Copy, Debug)]
struct W {
    v: i64,
}

impl Add<i64> for W {
    type Output = W;

    fn add(self, o: i64) -> W {
        W { v: self.v * 5 + o }
    }
}

fn main() {
    let v = V { x: 1.0, y: 2.0 } * 3.0;
    let e = V { x: 4.0, y: 0.0 } == 4i64;
    let d = W { v: 97 } + 32i64;
    let a = W { v: 1 };
    let b = a + 2i64;
    println("{:?} {} {:?} {:?}", v, e, d, b);
}
