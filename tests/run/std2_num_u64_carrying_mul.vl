// EDITION: rust
// The std2 item(s): std::num u64::carrying_mul.
// The full 128-bit product of two u64 plus a carry, as Rust's (1.91).
// EXPECT: 4 3
// EXPECT: 1 18446744073709551614
// EXPECT: 0 18446744073709551615
// EXPECT: 42 0
fn main() {
    let m = 18446744073709551615u64;
    let (lo, hi) = m.carrying_mul(3, 7);
    println("{} {}", lo, hi);
    let (lo, hi) = m.carrying_mul(m, 0);
    println("{} {}", lo, hi);
    let (lo, hi) = m.carrying_mul(m, m);
    println("{} {}", lo, hi);
    let (lo, hi) = 6u64.carrying_mul(7, 0);
    println("{} {}", lo, hi);
}
