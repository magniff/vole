// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FoldHasher::with_seeds.
// EXPECT: 387676522642835182
// EXPECT: 11372875485421594496
// RUSTC: none (FoldHasher is foldhash's (the foldhash crate's, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let mut h = FoldHasher::with_seeds(1, FoldSeeds::fixed());
    h.write_u64(9);
    println("{}", h.finish());
    let mut g = FoldHasher::with_seeds(0x082efa98ec4e6c89, FoldSeeds::fixed());
    g.write_u64(5);
    println("{}", g.finish());
}
