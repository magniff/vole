// XFAIL: RT-358: `Sup::val(x)` under `X: Sub` with `trait Sub: Sup<bool>` is reported ambiguous between Sup<i64> and Sup<bool>; the supertrait's arguments decide it (rustc prints 2) (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 2
trait Sup<T> {
    fn val(&self) -> i64;
}

trait Sub: Sup<bool> {}

struct S;

impl Sup<i64> for S {
    fn val(&self) -> i64 {
        1
    }
}

impl Sup<bool> for S {
    fn val(&self) -> i64 {
        2
    }
}

impl Sub for S {}

fn k<X: Sub>(x: &X) -> i64 {
    Sup::val(x)
}

fn main() {
    println("{}", k(&S));
}
