// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::io BufWriter::get_ref.
// EXPECT: 0 1
use std::io::{BufRead, BufWriter, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let mut w = BufWriter::new(Vec::<u8, Gpa>::new_in(gpa));
    w.write_all(&[1]).unwrap();
    println("{} {}", w.get_ref().len(), w.buffer().len());
}
