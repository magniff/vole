// RULE: F29.3
// (0.30.1) An i32 computed from untyped literals is not widened in any
// form: a form the check does not know is taken as computed, no yes. A
// match's arm, a loop's `break` value, an Option's unwrap, a tuple's
// field and an array's element of a computed value (rustc types the
// literals i64 from the use and prints 4000000000; widening after the i32
// arithmetic would panic, or print -294967296 at -O2).
// ERROR: error[type.widen_i32]: this 'i32' is not widened to 'i64' implicitly
// ERROR: line 24, column 36
// ERROR: line 24, column 46
// ERROR: line 24, column 56
// ERROR: line 24, column 74
// ERROR: line 24, column 85
// ERROR-COUNT: 5
fn take(x: i64) -> i64 { x }

fn main() {
    let a = 2000000000;
    let s1 = match 1 { _ => a + a };
    let s2 = loop { break a + a; };
    let o = Some(a + a);
    let t = (a + a, 1);
    let s3 = [a + a][0];
    println("{} {} {} {} {}", take(s1), take(s2), take(o.unwrap()), take(t.0), take(s3));
}
