// RULE: D4.6 (h)
// (0.30) The same through a user's trait and adaptor: a default method's
// closure bound names `Self::Item`, and Cp's Item is `T` of `impl<'a, T,
// I: It<Item = &'a T>>`; `|a, p| p` makes out borrow x (rustc E0506).
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 59, column 5
// ERROR-COUNT: 1
trait It {
    type Item;
    fn get(&mut self) -> Option<Self::Item>;

    fn fold2<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B
        where
            Self: Sized,
    {
        let mut it = self;
        let mut f = f;
        let mut acc = init;
        while let Option::Some(x) = it.get() {
            acc = f(acc, x);
        }
        acc
    }
}

struct One<T> {
    v: Option<T>,
}

impl<T> It for One<T> {
    type Item = T;

    fn get(&mut self) -> Option<T> {
        self.v.take()
    }
}

struct Cp<I> {
    i: I,
}

impl<'a, T: Copy + 'a, I: It<Item = &'a T>> It for Cp<I> {
    type Item = T;

    fn get(&mut self) -> Option<T> {
        match self.i.get() {
            Option::Some(p) => Option::Some(*p),
            Option::None => Option::None,
        }
    }
}

fn main() {
    let mut x = 1i64;
    let px = &x;
    let r = One { v: Option::Some(&px) };
    let z = 0i64;
    let out = Cp { i: r }.fold2(&z, |a, p| p);
    x = 2;
    println("{}", *out);
}
