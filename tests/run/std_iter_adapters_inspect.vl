// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Inspect.
// EXPECT: 1
// EXPECT: 2
// EXPECT: 3
use std::iter::Inspect;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let n: i64 = s.iter().copied().inspect(|x| println("{}", x)).sum();
    println("{}", n);
}
