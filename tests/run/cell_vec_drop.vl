// (0.26.1) A Cell of a Vec drops its Vec once, at the end, and once more
// for each value `set` and `replace` take out.
// FLAGS: --check-alloc
// EXPECT: 3 1
use std::cell::Cell;

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.push(1u8);
    v.push(2u8);
    v.push(3u8);
    let c = Cell::new(v);
    let mut w: Vec<u8, Gpa> = Vec::new_in(gpa);
    w.push(9u8);
    let old = c.replace(w);
    let mut x: Vec<u8, Gpa> = Vec::new_in(gpa);
    x.push(7u8);
    c.set(x);
    let inner = c.into_inner();
    println("{} {}", old.len(), inner.len());
}
