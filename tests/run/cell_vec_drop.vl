// (0.26.1) A Cell of a Vec drops its Vec once, at the end, and once more
// for each value `set` and `replace` take out.
// FLAGS: --check-alloc
// EXPECT: 3 1
use std::cell::Cell;

fn main(gpa: Gpa) {
    var v: Vec<u8> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let c = Cell::new(v);
    var w: Vec<u8> = Vec::new_in(gpa);
    w.push(9);
    let old = c.replace(w);
    var x: Vec<u8> = Vec::new_in(gpa);
    x.push(7);
    c.set(x);
    let inner = c.into_inner();
    println(f"{old.len()} {inner.len()}");
}
