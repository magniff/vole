// EDITION: rust
// (0.27.0) A trait's `&Self` and `&mut Self` in an impl for a view, str or
// a slice, are the view, as `&str` and `&[T]` are written: the impl's
// `other: &str` has the trait's signature (before, "expected 'fn(let str,
// let str) -> bool'").
// EXPECT: true false
// EXPECT: true 3
trait Plain {
    fn plain(&self, other: &Self) -> bool;
}

impl Plain for str {
    fn plain(&self, other: &str) -> bool {
        self.len() == other.len()
    }
}

trait Fill {
    fn same_len(&self, other: &Self) -> bool;
    fn fill(&mut self, v: i64);
}

impl Fill for [i64] {
    fn same_len(&self, other: &[i64]) -> bool {
        self.len() == other.len()
    }

    fn fill(&mut self, v: i64) {
        for x in self {
            *x = v;
        }
    }
}

fn main() -> i32 {
    println("{} {}", "ab".plain("cd"), "ab".plain("c"));
    let mut a = [1, 2];
    let b = [5, 6];
    a[..].fill(3);
    println("{} {}", a[..].same_len(&b[..]), a[1]);
    0
}
// XFAIL: `for x in s` with `s: &mut [i64]` iterates with Iter, so x is `&i64` and `*x = ..` is borrowck.assign_immutable (front272: IterMut, F22)
