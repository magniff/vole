// XFAIL: gap 17: compile type error: cannot index into a value of type '*Vec<i64, Gpa>'
// 0.17: `p[i]` on any pointer to a Vec, a Buf or a slice indexes the one
// it points to, checked: through a raw pointer (a local holding one, a
// field, a static, a `mut` parameter) as through a borrow. Raw, it is
// unsafe code; its meaning is the same. Other pointers (*i64) still index
// memory from p.
// EXPECT: 1 2 4
// EXPECT: 10 2
// EXPECT: 20 30
// EXPECT: 110 5
// EXPECT: lo o 2
// EXPECT: 1 2
// EXPECT: 7 8
// EXPECT: 9 9
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
use std::alloc::Allocator; static mut WORDS: *mut &'static [u8] = 0 as *mut &'static [u8];

#[derive(Clone, Copy)] struct H<A: Allocator> { vp: *mut Vec<i64, A> }

// the same body through a borrow and through a `mut` parameter
fn get_b(v: &Vec<i64, Gpa>, i: i64) -> i64 { v[i as usize] }

fn get_m(v: *mut Vec<i64, Gpa>, i: i64) -> i64 { unsafe { v[i as usize] } }

fn bump_m(mut v: *mut Vec<i64, Gpa>) {
    unsafe {
        v[0] += 100;
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    a.push(2);
    a.push(4);
    // a local holding a pointer: the Vec's elements, not the Vec after it
    let p = &mut a as *mut Vec<i64, Gpa>;
    println("{} {} {}", unsafe { p[0] }, unsafe { p[1] }, unsafe { p[2] });
    unsafe {
        p[0] = 10;
        println("{} {}", a[0], p[1..3].len());
    }
    let h = H { vp: &mut a };
    unsafe {
        h.vp[1] = 20;
        let e = &mut h.vp[2];
        *e = 30;
    }
    println("{} {}", a[1], a[2]);
    bump_m(&mut a);
    println("{} {}", get_b(&a, 0), get_b(&a, 0) - get_m(&mut a, 0) + 5);
    // a static pointer to a slice indexes the slice
    let word = "lo";
    unsafe {
        WORDS = &mut word as *mut &'static [u8];
        println("{} {} {}", &WORDS[0..2], &WORDS[1..2], WORDS[0..2].len());
    }
    // a Buf
    let mut b = String::new_in(gpa);
    b.push_str("12");
    let bp = &raw mut b as *mut Vec<u8, Gpa>;
    println("{} {}", unsafe { bp[0] - b'0' }, unsafe { bp[1] - b'0' });
    // pointer arithmetic on other pointers, unchanged
    let xs = [7i64, 8, 9];
    let q = &mut xs[0] as *mut i64;
    println("{} {}", unsafe { (*q.add(0)) }, unsafe { (*q.add(1)) });
    let r = &mut xs[2] as *mut i64;
    println("{} {}", unsafe { (*r.add(0)) }, unsafe { (*q.add(2)) });
    0
}
