// EDITION: rust
// the closure changes a field the receiver (another field) does not include
// EXPECT: 3
use std::alloc::Allocator; struct S<A: Allocator> { v: Vec<i64, A>, n: i64 }

fn main(gpa: Gpa) {
    let mut s = S { v: Vec::new_in(gpa), n: 0 }; s.v.push(1); s.v.push(2);
    s.v.sort_unstable_by(|a, b| ({ let a = *a; let b = *b; { a - b } }).cmp(&0)); for x in s.v { s.n += x; } println("{}", s.n);
}
