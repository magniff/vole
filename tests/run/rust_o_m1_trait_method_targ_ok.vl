// (0.30.2, obligations M1) rust_o_m1_trait_method_targ_err with `T:
// Tr<i64>`: its impl needs nothing. rustc accepts it.
// EXPECT: 64
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
trait Caller { fn call<T: Tr<i64>>(&self, t: &T) -> &'static str { t.f() } }
struct C;
impl Caller for C {}

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let s = C.call(&W { r: st.as_str() });
    println("{}", s);
}
