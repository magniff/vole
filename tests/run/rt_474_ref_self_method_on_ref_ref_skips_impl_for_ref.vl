// XFAIL: RT-474: WRONG CODE: `(&t).g(5)` with `t: &W`, `impl G<i64> for W` (2) and `impl G<i64> for &W` (3), `g(&self, ..)`, runs W's impl: vole prints `2 2 0`; rustc takes the impl for &W at the first probe step (the receiver `&&W` is its `&self`) and prints `2 3 0` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// The views str and [i64] do the same: rt_474b, rt_474c. RT-362d is the
// path call `G::g(&r, 0)`.
// EXPECT: 2 3 0
trait G<X> {
    fn g(&self, x: X) -> i64;
}

struct W {
    k: i64,
}

impl G<i64> for W {
    fn g(&self, x: i64) -> i64 {
        2 + x * 0
    }
}

impl<'a> G<i64> for &'a W {
    fn g(&self, x: i64) -> i64 {
        3 + x * 0
    }
}

fn main() -> i32 {
    let w = W { k: 0 };
    let t: &W = &w;
    println("{} {} {}", t.g(5), (&t).g(5), w.k);
    0
}
