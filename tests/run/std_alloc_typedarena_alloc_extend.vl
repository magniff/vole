// XFAIL: std is not the edition's std until 0.27.2's switch (front272 M3)
// The std item(s): std::alloc TypedArena::alloc_extend.
// EXPECT: ["x", "y"] 2
use std::alloc::TypedArena;

fn main(gpa: Gpa) {
    let ta = TypedArena::new_in(gpa);
    let s = ta.alloc_extend(["x", "y"].iter().map(|t| t.to_string_in(gpa)));
    println("{:?} {}", s, ta.len());
}
