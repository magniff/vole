// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters MapWhile.
// EXPECT: [10]
use std::iter::MapWhile;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, -1, 2], gpa);
    let v: Vec<i64, Gpa> = s
        .iter()
        .map_while(|x| if *x > 0 { Some(x * 10) } else { None })
        .collect_in(gpa);
    println("{:?}", v);
}
