// places IR (0.26.1, R10): `let (s, k) = mk::<R>()` of a generic call
// whose result holds a type parameter is owned: the own pass drops the
// bindings of a destructuring `let` (let_drops looks at borrowed_call
// only), so the IR's matched temporary is not a borrowed copy, as R8's
// call temporaries are (`second(&vs[0]).len()`): s is dropped once.
// --places-diff compares a borrowed copy too: had the IR borrowed it,
// `'s' own kept, places no drop`.
// FLAGS: --check-alloc
// EXPECT: end 1 5
// EXPECT: drop S 5
// PLACES: fn main
// PLACES: _1 = call mk<R>()
// PLACES: _2 = move _1.0
// PLACES: drop(_2) [kept]
struct R { id: i64 }

impl Drop for R {
    fn drop(inout self) {
        println(f"drop {self.id}");
    }
}

struct S<T> { id: i64, p: *T }

impl<T> Drop for S<T> {
    fn drop(inout self) {
        println(f"drop S {self.id}");
    }
}

fn mk<T>() -> (S<T>, i64) {
    (S { id: 5, p: 0 as *T }, 1)
}

fn main() {
    let (s, k) = mk::<R>();
    println(f"end {k} {s.id}");
}
