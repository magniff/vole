// (0.26.2) A contract message's hole may be a usize (a length or an
// index, since 0.26.2's std): it is passed as the i64 it holds, as an i32
// widens; a str or a float is still contract.message.
// EXIT: 101
// EXPECT: 20
// STDERR: no item 5 in a list of 3

struct List { items: [i64; 3], len: usize }

impl List {
    fn get(self, i: usize) -> i64
        requires i < self.len else f"no item {i} in a list of {self.len}"
    {
        self.items[i]
    }
}

fn main() -> i32 {
    let l = List { items: [10, 20, 30], len: 3 };
    println(f"{l.get(1)}");
    let k: usize = 5;
    println(f"{l.get(k)}");
    0
}
