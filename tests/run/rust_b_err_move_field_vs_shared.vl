// RULE: D2.5
// (0.27.1) A move of `p.a` while `&p.a` is live.
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 20, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct N {
    v: i64,
}

struct P2 {
    a: N,
    b: N,
}

fn main() {
    let p = P2 { a: N { v: 1 }, b: N { v: 2 } };
    let r = &p.a;
    let t = p.a;
    println("{} {}", r.v, t.v);
}
