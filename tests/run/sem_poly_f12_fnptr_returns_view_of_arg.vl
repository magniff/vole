// EDITION: rust
// a fn pointer whose result views its let argument: the Vec grown while the result is used
// ERROR: error[borrowck.conflict]
fn sl(d: &Vec<i64, Gpa>) -> &[i64] { d.as_slice() }

fn main(gpa: Gpa) {
    let f: fn(&Vec<i64, Gpa>) -> &[i64] = sl;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = f(&v);
    for i in 0..1000 { v.push(i); }
    println("{}", s[0]);
}
