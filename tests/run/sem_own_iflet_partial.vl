// EDITION: rust
// sem-own: `if let E::B(x, _) = e` moves x; the other field stays in e.
// EXPECT: x 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

enum E<A: Allocator> { B(D<A>, D<A>), N }

fn main(gpa: Gpa) {
    let e = E::B(mk(2, gpa), mk(3, gpa));
    if let E::B(x, _) = e { println("x {}", x.id); }
    println("end");
}
