// XFAIL: RT-323: a type alias to a qualified projection, `type O = <S as A>::Out;`, is refused (trait.unmet "'S' has no impl of 'A' that defines 'Out'"), so `<O as C>::K` and `<O as B>::m` fail (0.30.2)
// Since v0.30.1 at least (the g302qual review's form f07c). RT-101's
// family (a qualified projection in a struct field's type), here an
// alias's. rustc builds it and prints the EXPECT line.
// EXPECT: 2 3 30 20
trait A { type Out; }
trait B { const K: i64; fn m(&self) -> i64; }
trait C { const K: i64; fn m(&self) -> i64; }
struct S; struct T;
impl A for S { type Out = T; }
impl B for T { const K: i64 = 2; fn m(&self) -> i64 { 20 } }
impl C for T { const K: i64 = 3; fn m(&self) -> i64 { 30 } }
type O = <S as A>::Out;

fn main() {
    let t = T; let f = <O as C>::m;
    println("{} {} {} {}", <O as B>::K, <O as C>::K, f(&t), <O as B>::m(&t));
}
