// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Cloned::impl Iterator.
// EXPECT: Some("x") None

fn main(gpa: Gpa) {
    let x = "x".to_string_in(gpa);
    let s = Vec::from_in([x], gpa);
    let mut it = s.iter().cloned();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
