use std::boxed::Box;

fn get<T: AsRef<i64>>(x: &T) -> i64 {
    *x.as_ref()
}

fn main(gpa: Gpa) {
    let b = Box::new_in(5i64, gpa);
    println("{}", get(&b));
}
