// XFAIL: gap 20: xfail case fails differently: parser error: expected '(', got '<' (another failure)
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd (a closure given a by-reference let param's view)
// MVS's XFAIL: OVERSTRICT a closure does not satisfy Fn(E) -> [u8] when E is a borrowed let parameter: 'Fn(let E)'
// EXPECT: abcd 7
#[derive(Clone, Copy)] struct E { name: [u8; 4], len: i64 }
fn nm(e: &E) -> &[u8] { &e.name[..e.len as usize] }
fn apply<'a> < F: Fn(&E) -> &[u8] > (f: &'a F, e: &'a E) -> &[u8] { f(e) }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: [b'a', b'b', b'c', b'd'], len: 4 };
    let r = apply(|x| nm(&x), e);
    let k = clobber();
    println("{r} {k}");
    0
}
