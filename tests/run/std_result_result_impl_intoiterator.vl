// Runs on std since 0.27.2's switch.
// The std item(s): std::result Result::impl IntoIterator.
// EXPECT: 3
// EXPECT: 0
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    for x in a {
        println("{}", x);
    }
    let mut n = 0;
    for _ in b {
        n += 1;
    }
    println("{}", n);
}
