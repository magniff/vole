// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Shr::Output.
// EXPECT: V { x: 3 }
use std::ops::Shr;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Shr for V {
    type Output = V;

    fn shr(self, rhs: V) -> V {
        V { x: self.x >> rhs.x }
    }
}

fn apply<T: Shr<Output = T>>(a: T, b: T) -> T {
    a >> b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 2 };
    let c: <V as Shr>::Output = apply(a, b);
    println("{:?}", c);
}
