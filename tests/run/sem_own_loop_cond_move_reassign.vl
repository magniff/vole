// sem-own: moved on some iterations and assigned again then; the old value is
// dropped by the assignment when not moved.
// EXPECT: eat 0
// EXPECT: drop 0
// EXPECT: drop 10
// EXPECT: eat 11
// EXPECT: drop 11
// EXPECT: end
// EXPECT: drop 12
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut d = mk(0, gpa);
    for i in 0..3 {
        if i != 1 { eat(d); }
        d = mk(10 + i, gpa);
    }
    println("end");
}
