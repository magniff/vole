// EDITION: rust
// The std2 item(s): std::fs write; std::fs read_in; std::fs read_to_string_in; std::fs metadata; std::fs Metadata::len; std::fs Metadata::is_file; std::fs Metadata::is_dir; std::fs Metadata::modified; std::fs exists; std::fs copy; std::fs rename; std::fs remove_file.
// EXPECT: [0, 1, 255] "hello\n"
// EXPECT: 6 true false true
// EXPECT: true false
// EXPECT: 6 false true
// EXPECT: NotFound InvalidData
use std::fs;
use std::time::UNIX_EPOCH;

fn main(gpa: Gpa) {
    fs::write("a.txt", "hello\n").unwrap();
    fs::write("b.bin", b"\x00\x01\xff").unwrap();
    let v = fs::read_in("b.bin", gpa).unwrap();
    let s = fs::read_to_string_in("a.txt", gpa).unwrap();
    println("{:?} {:?}", v, s);
    let m = fs::metadata("a.txt").unwrap();
    let t = m.modified().unwrap().duration_since(UNIX_EPOCH).unwrap();
    println("{} {} {} {}", m.len(), m.is_file(), m.is_dir(), t.as_secs() > 1700000000);
    println("{} {}", fs::exists("a.txt").unwrap(), fs::exists("none.txt").unwrap());
    let n = fs::copy("a.txt", "c.txt").unwrap();
    fs::rename("c.txt", "d.txt").unwrap();
    let same = fs::read_to_string_in("d.txt", gpa).unwrap() == "hello\n";
    println("{} {} {}", n, fs::exists("c.txt").unwrap(), same);
    fs::remove_file("d.txt").unwrap();
    let e = fs::metadata("d.txt").unwrap_err();
    let bad = fs::read_to_string_in("b.bin", gpa).unwrap_err();
    println("{:?} {:?}", e.kind(), bad.kind());
    fs::remove_file("a.txt").unwrap();
    fs::remove_file("b.bin").unwrap();
}
