// EDITION: rust
// RULE: D3.3
// (0.27.1) An enum with a lifetime: a variant holding `&'a i64`.

enum E<'a> {
    A(&'a i64),
    B,
}

fn main() {
    let x: i64 = 6;
    let e = E::A(&x);
    match e {
        E::A(r) => println("{}", *r),
        E::B => println("b"),
    }
}
// EXPECT: 6
