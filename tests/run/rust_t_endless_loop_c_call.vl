// (0.28.0) An endless loop whose body is a C call, after a print: -O2's
// aggressive dead code elimination took the branch into the loop for
// dead (a block that reaches no exit has no control dependence) and made
// it a jump to the print's panic arm: the program trapped after "start".
// The loop runs until the alarm's handler ends the process.
// EXPECT: start
// EXPECT: done
// EXIT: 0

// UNSAFE: C's signal, ualarm, usleep, write and _exit.
// SAFETY: signal.h's and unistd.h's prototypes; the calls below pass a
// handler of C's type, plain numbers and a literal with its length.
extern "C" {
    fn signal(sig: i32, handler: extern "C" fn(i32)) -> usize;
    fn ualarm(us: u32, interval: u32) -> u32;
    fn usleep(us: u32) -> i32;
    fn write(fd: i32, data: *const u8, count: usize) -> isize;
    fn _exit(code: i32) -> !;
}

extern "C" fn on_alarm(sig: i32) {
    // UNSAFE: C calls.
    // SAFETY: write and _exit are async-signal-safe; the text is a
    // literal of 5 bytes.
    unsafe {
        write(1, "done\n".as_ptr(), 5);
        _exit(0);
    }
}

fn main() -> i32 {
    println("start");
    // UNSAFE: C calls.
    // SAFETY: SIGALRM is 14 on macOS and Linux; on_alarm has C's type.
    unsafe {
        signal(14, on_alarm);
        ualarm(50000, 0);
    }
    loop {
        // UNSAFE: a C call.
        // SAFETY: a number.
        unsafe {
            usleep(1000);
        }
    }
}
