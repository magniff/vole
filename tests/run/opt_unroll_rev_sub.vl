// The unroller and the vectorizer must not split `acc = b[i] - acc`: its sign
// alternates, so it is no reduction (the Sub-left rule of reduction_set).
// Without that rule no other case fails (the re-review of g302scan).
// FLAGS: -O2
// EXPECT: 91 4294967216 128 4294967253 64 4294967290 101 4294967226 138 4294967162 175 4294967199 111 4294967236 148 4294967172 185 4294967209 121 4294967246 57 4294967283 94 4294967219 131 4294967256 67 4294967293 3 34 40 4294967266 77 7 13 44 50 4294967276
#[inline(never)]
fn f(b: &[u32]) -> u32 {
    let mut acc: u32 = 91;
    for i in 0..b.len() {
        acc = b[i].wrapping_sub(acc);
    }
    acc
}

fn main() {
    let mut b: [u32; 37] = [0; 37];
    for i in 0..37 {
        b[i] = ((i * 37 + 11) % 101) as u32;
    }
    for n in 0..38 {
        print("{} ", f(&b[0..n]));
    }
    println("");
}
