// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::as_mut_ptr.
// EXPECT: [1, 7]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2], gpa);
    let p = v.as_mut_ptr();
    // UNSAFE: a write through the Vec's pointer.
    // SAFETY: element 1 is initialized; nothing else borrows v.
    unsafe {
        *p.add(1) = 7;
    }
    println("{:?}", v);
}
