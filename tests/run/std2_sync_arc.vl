// The std2 item(s): std::sync Arc (new_in, clone, Deref, strong_count, ptr_eq, get_mut,
// try_unwrap, into_inner, Debug, Display, PartialEq, Ord), on one thread (shared between
// threads: sync_arc_threads).
// RUSTC: none (Arc::new_in takes the allocator; Rust's allocator_api is unstable)
// FLAGS: --check-alloc
// EXPECT: 5 1
// EXPECT: 2 true true
// EXPECT: None Some(6) 6
// EXPECT: Err(7) Ok(7)
// EXPECT: Some("text") None
// EXPECT: true true 3 Arc(3)
use std::sync::Arc;

fn main(gpa: Gpa) {
    let a: Arc<i64, Gpa> = Arc::new_in(5, gpa);
    println("{} {}", *a, Arc::strong_count(&a));
    let b = a.clone();
    println("{} {} {}", Arc::strong_count(&a), Arc::ptr_eq(&a, &b), *a == *b);
    drop(b);

    let mut m: Arc<i64, Gpa> = Arc::new_in(5, gpa);
    let m2 = m.clone();
    let shared = Arc::get_mut(&mut m).is_none();
    drop(m2);
    if let Some(x) = Arc::get_mut(&mut m) {
        *x += 1;
    }
    let alone = Arc::get_mut(&mut m).map(|x| *x);
    println("{} {:?} {}", if shared { "None" } else { "Some" }, alone, m);

    let u: Arc<i64, Gpa> = Arc::new_in(7, gpa);
    let u2 = u.clone();
    let first = match Arc::try_unwrap(u) {
        Ok(x) => Ok(x),
        Err(back) => Err(*back),
    };
    println("{:?} {:?}", first, Arc::try_unwrap(u2).map_err(|_| 0));

    let s: Arc<String<Gpa>, Gpa> = Arc::new_in(String::from_in("text", gpa), gpa);
    let s2 = s.clone();
    let none = Arc::into_inner(s2).is_none();
    println("{:?} {}", Arc::into_inner(s), if none { "None" } else { "Some" });

    let x: Arc<i64, Gpa> = Arc::new_in(3, gpa);
    let y: Arc<i64, Gpa> = Arc::new_in(3, gpa);
    println("{} {} {} Arc({:?})", x == y, x <= y, *x, x);
}
