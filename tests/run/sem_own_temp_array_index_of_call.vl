// sem-own: an element moved out of an array call result by constant index: refused or the rest dropped.
// EXPECT: drop 1
// EXPECT: got 2
// EXPECT: drop 2
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
fn ma(gpa: Gpa) -> [D<Gpa>; 2] { [mk(1, gpa), mk(2, gpa)] }

fn main(gpa: Gpa) {
    let b = ma(gpa)[1];
    println("got {}", b.id);
}
