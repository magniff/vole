// RT-211, what must still build: results that hold no borrow of the items
// (owned items, a String gathered from &str items through Extend<&str>, a
// user impl that copies the referent), and borrowing results used before
// the owner goes; the output is rustc's.
// EXPECT: [2] [1]
// EXPECT: [2] [1] [1, 2] [2, 3] [1, 2] ab c
trait Put<T> {
    fn put1(&mut self, t: T);
}

impl<T> Put<T> for Vec<T, Gpa> {
    fn put1(&mut self, t: T) {
        self.push(t);
    }
}

impl<'a, T: Copy> Put<&'a T> for Vec<T, Gpa> {
    fn put1(&mut self, t: &'a T) {
        self.push(*t);
    }
}

fn one<I: Iterator, B: Put<I::Item>>(it: I, mut b: B) -> B {
    for x in it {
        b.put1(x);
    }
    b
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let (a, b): (Vec<i64, Gpa>, Vec<i64, Gpa>) = v.iter().copied().partition_in(|x| *x > 1, gpa);
    let (c, d): (Vec<i64, Gpa>, Vec<i64, Gpa>) = v.iter().map(|e| (*e, *e + 1)).unzip_in(gpa);
    let owned: Vec<i64, Gpa> = one(v.iter(), Vec::new_in(gpa));
    let (e, f): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = v.iter().partition_in(|x| **x > 1, gpa);
    println("{:?} {:?}", e, f);
    let mut words: Vec<&str, Gpa> = Vec::new_in(gpa);
    words.push("ab");
    words.push("c");
    let (long, short): (String<Gpa>, String<Gpa>) = words
        .iter()
        .copied()
        .partition_in(|w| w.len() > 1, gpa);
    drop(words);
    drop(v);
    println("{:?} {:?} {:?} {:?} {:?} {} {}", a, b, c, d, owned, long, short);
}
