// EDITION: rust
// RULE: D19.5
// (0.27.2) A closure or a fn pointer called through `&F` or `&mut F`, as
// rustc's blanket impls: `compare(a, b)` with `compare: &mut F` calls
// `*compare`, its env reborrowed.
fn count_by<F: FnMut(i64) -> bool>(v: &[i64], pred: &mut F) -> i64 {
    let mut n = 0;
    for x in v {
        if pred(*x) {
            n += 1;
        }
    }
    n
}

fn apply<F: Fn(i64) -> i64>(f: &F, x: i64) -> i64 {
    f(x) + f(x)
}

fn first<P: FnMut(char) -> bool>(s: &str, mut p: P) -> bool {
    let q = &mut p;
    match s.chars().next() {
        Some(c) => q(c),
        None => false,
    }
}

fn main() {
    let mut seen = 0;
    let mut big = |x: i64| {
        seen += 1;
        x > 2
    };
    let n = count_by(&[1, 3, 5], &mut big);
    println("{} {}", n, seen);
    let k = 10;
    println("{}", apply(&|x: i64| x + k, 1));
    println("{} {}", first("a b", char::is_alphabetic), first(" b", char::is_alphabetic));
}
// EXPECT: 2 3
// EXPECT: 22
// EXPECT: true false
