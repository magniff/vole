// EDITION: rust
// (0.28.0) std::sys::SYS_O_DIRECTORY is the target's: Linux has two
// values, 0o200000 on x86_64 and 0o40000 on aarch64 (macOS: 0x100000).
// It was aarch64's on both. The value is a constant in the unoptimized
// assembly of each Linux target (the program writes neither number:
// it compares the value's bits above the twelfth); where the case runs,
// it is the target's (tests/run/sys_layout.vl compares it with the C
// header's).
// CROSS: aarch64-linux x86_64-linux
// CHECK-OPT: 0
// EXPECT: ok
// ASM(x86_64-linux): $65536
// ASM(aarch64-linux): #16384
use std::sys::SYS_O_DIRECTORY;

fn main() {
    let want = if std::TARGET_OS == 0 {
        256
    } else if std::arch::has("sse2") {
        16
    } else {
        4
    };
    if SYS_O_DIRECTORY >> 12 == want {
        println("ok");
    } else {
        println("SYS_O_DIRECTORY is {}, not {want} << 12", SYS_O_DIRECTORY);
    }
}
