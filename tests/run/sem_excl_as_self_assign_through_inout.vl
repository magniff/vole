// XFAIL: OVERSTRICT v = v through an inout is own.move_out (a local's v = v is accepted), and the help calls v "borrowed read-only (let)"
// x = x through an access: a self-move must not free then read
// EXPECT: 3
fn same(v: inout Vec<i64, Gpa>) { v = v; }

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v.push(2); v.push(3); same(&v);
    println("{}", v.len());
}
