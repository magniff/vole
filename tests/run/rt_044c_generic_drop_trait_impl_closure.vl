// RULE: D19.1, D19.10
// (0.30.2, RT-44) A closure in an impl method of a generic trait that
// only a generic Drop impl's instance calls (late, as rt_044b's).
// EXPECT: ok
// EXPECT: drop 2
use std::thread;

trait Tr<X> {
    fn m(&self, x: X) -> i64;
}

struct W<T> {
    t: T,
}

impl<T, X> Tr<X> for W<T> {
    fn m(&self, x: X) -> i64 {
        let _ = x;
        thread::scope(|s| {
            s.spawn(|| 1i64);
        });
        2
    }
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("drop {}", self.m(1u8));
    }
}

fn main() {
    let w = W { t: 1u8 };
    let _ = &w.t;
    println("ok");
}
