fn mid(v: &Vec<i64, Gpa>) -> &mut [i64] { &mut v[0..1] }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let m = mid(&v);
    m[0] = 5;
    println("{}", v[0]);
    0
}
