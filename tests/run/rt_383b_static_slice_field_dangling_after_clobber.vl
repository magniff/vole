// XFAIL: RT-383: UNSOUND: a field `&'static [u64]` takes `&e[..]` of a local array; after another call overwrites the stack the struct reads `55 55` (rustc E0597) (0.30.2)
// From the re-review of the std and raw-pointer work. Since v0.30.1 at least.
// ERROR: line 7
struct V { a: &'static [u64] }

fn mk() -> V {
    let e = [7u64, 8, 9];
    V { a: &e[..] }
}

fn clobber() -> u64 {
    let z = [55u64; 64];
    z[3] + z[60]
}

fn main() {
    let v = mk();
    let c = clobber();
    println("{} {} {}", v.a[0], v.a[2], c);
}
