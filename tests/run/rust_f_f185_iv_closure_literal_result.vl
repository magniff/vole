// RULE: F18.5
// (0.30.2) A closure whose body is an untyped literal, `|| 3000000000`,
// returns an integer variable: the bound `FnMut() -> i64` it is passed to
// types it i64, as rustc infers it. 0.30.1 typed the literal i32 when the
// closure was checked (FL6): it did not fit, and the bound was not met.
// EXPECT: 6000000000
fn twice<F: FnMut() -> i64>(mut f: F) -> i64 {
    f() + f()
}

fn main() {
    let c = || 3000000000;
    println("{}", twice(c));
}
