// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe access out of bounds: 17 bytes at offset 0 of a block of 16 bytes
// STDERR: --> memcpy, its destination
// 0.30.1: std's ptr::copy_nonoverlapping of 4 elements or more is C's
// memcpy, whose bytes are checked first under --check-unsafe: 17 bytes
// into a Vec of capacity 16, no C in the program.
fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::with_capacity_in(16, gpa);
    let src = [7u8; 17];
    let p = v.as_mut_ptr();
    // UNSAFE: deliberately one byte past the capacity.
    // SAFETY: none: the program exists to be stopped.
    unsafe {
        std::ptr::copy_nonoverlapping(&src[0] as *const u8, p, 17);
        println("read {}", *p.add(16));
    }
    v.push(1);
}
