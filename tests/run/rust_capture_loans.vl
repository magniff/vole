// EDITION: rust
// RULE: D10.2
// (0.27.1) A rust-edition closure's by-reference captures are loans
// (places/build.vl capture_loan), moved into the closure, whose type holds
// the loan's slot (regions::capture_slots): `&'c k` for a variable it
// reads, an immutable one too (Rust's rule), `&'c mut c` for one it
// writes; a `move` closure copies or moves (`copy _1`). A call of a
// closure value reborrows it, `&'e mut2` for one that writes a capture
// (FnMut), `&'e` else (D10.3).
// PLACES: fn main
// PLACES: _4 = &'r18 _1
// PLACES: (move _4)
// PLACES: _6 = &'r19 mut _2
// PLACES: (move _6)
// PLACES: _7 = &'r20 mut2 _5
// PLACES: _9 = &'r21 _3
// PLACES-NOT: &raw
// PLACES: _11 = &'r24 mut2 _5
// PLACES: (copy _1)
// EXPECT: 13 11
fn main() {
    let k = 10;
    let mut c = 0;
    let add = |x: i64| x + k;
    let mut bump = |x: i64| {
        c += x;
    };
    bump(add(1));
    bump(2);
    let own = move || k + 1;
    println("{} {}", c, own());
}
