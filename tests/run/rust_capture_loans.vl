// EDITION: rust
// RULE: D10.2
// (0.27.1) A rust-edition closure's by-reference captures are loans
// (places/build.vl capture_loan): `&'c mut c` for a variable it writes,
// moved into the closure, whose type holds the loan's slot
// (regions::capture_slots); a call of a closure value reborrows it,
// `&'e mut2` for one that writes a capture (FnMut), `&'e` else (D10.3).
// PLACES: fn main
// PLACES: let mut _4: closure(i64) -> ()
// PLACES: region 'r2: local _4.0
// PLACES: _5 = &'r15 mut _2
// PLACES: (move _5)
// PLACES: _6 = &'r16 mut2 _4
// PLACES: _8 = &'r17 _3
// PLACES: call closure(i64) -> i64
// PLACES-NOT: &raw
// PLACES: _10 = &'r19 mut2 _4
// EXPECT: 13 11
fn main() {
    let k = 10;
    let mut c = 0;
    let add = |x: i64| x + k;
    let mut bump = |x: i64| {
        c += x;
    };
    bump(add(1));
    bump(2);
    let own = move || k + 1;
    println("{} {}", c, own());
}
