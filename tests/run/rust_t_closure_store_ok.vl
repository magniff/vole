// EDITION: rust
// (0.27.0) Hand-translated from tests/run/closure_store_ok.vl to Rust's spelling.
// ok: a closure stores views of what outlives it into a capture
// EXPECT: 3 3
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    let mut out: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    let s = v.as_slice();
    let mut f = |x: i64| out.push(s);
    f(1);
    (0..2).for_each(|i| out.push(s));
    println("{} {}", out.len(), out[0][0]);
}
// XFAIL: a range expression `a..b` finds no std2 ops::Range (front272 Z3.1)
