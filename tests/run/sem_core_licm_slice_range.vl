// EDITION: rust
// A guarded subslice in a loop.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k < 5 + unsafe { Z } { if k > 100 { t += a[i as usize..(i + 1) as usize].len() as i64; } k += 1; }
    println("{}", t);
    0
}
