// (0.25) Moving a move-only view (a struct with an inout field, in a
// tuple, an Option, a generic struct, to a sink parameter) is fine; only
// a use after the move is an error.
struct C<'a> { n: &'a mut i64 }
struct W<T> { x: T }
fn eat(mut c: C<'_>) { *c.n += 10; }

fn main() {
    let mut x: i64 = 1;
    let c = C { n: &mut x };
    let d = c;
    *d.n += 1;
    let t = (d, 0);
    let u = t;
    *u.0.n += 1;
    let w = W { x: u.0 };
    let v = w;
    *v.x.n += 1;
    let o: Option<C<'_>> = Some(v.x);
    let p = o;
    if let Some(e) = p { eat(e); }
    println("{x}");
}
// EXPECT: 14
