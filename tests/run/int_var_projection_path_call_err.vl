// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). `Tr::o(2)`:
// rustc E0271 at the call.
// ERROR: (rustc E0271)
// ERROR: line 35, column 18
// ERROR-COUNT: 1
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = u16;

    fn o(self) -> u16 {
        self as u16 * 300
    }
}

impl Tr for i32 {
    type Out = i64;

    fn o(self) -> i64 {
        self as i64 * 3000000000
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let s: i32 = Tr::o(2);
    println("{}", s);
}
