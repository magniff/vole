// RULE: Z4.1, F8.2
// On std2 `*s` of a `&str` or `&[T]` reads the view (no edition.std_copy),
// a trait path call through a reference keeps its trait (`Debug::fmt(&r,
// f)` is Debug's impl for &T, not Display's), and Vec::from_in moves an
// array of owned elements.
// EXPECT: true 3
// EXPECT: "a" ["b", "c"]
use std::alloc::Allocator;
use std::fmt::{Debug, Formatter};

struct W<A: Allocator> {
    s: String<A>,
}

impl<A: Allocator> Debug for W<A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        let r = &self.s;
        Debug::fmt(&r, f)
    }
}

fn main(gpa: Gpa) {
    let k: &str = "key";
    let xs: &[i64] = &[1, 2, 3];
    println("{} {}", *k == *"key", (*xs).len());
    let w = W { s: String::from_in("a", gpa) };
    let v = Vec::from_in(["b".to_string_in(gpa), "c".to_string_in(gpa)], gpa);
    println("{:?} {:?}", w, v);
}
