// 0.25.3 (eval 0.25.2.2): `{s}` of a slice says why it has no Display and
// what writes it ('{s:?}', which works since 0.25.3); `{s:?}` of a slice
// whose elements have no Debug names the element type.
// ERROR: '[i64]' does not implement Display, which '{x}' needs
// ERROR: help: a slice has no Display (no one way to separate its elements): '{x:?}' writes it as a list, '[1, 2, 3]', or format its parts
// ERROR: '[P]' does not implement Debug, which '{x:?}' needs
// ERROR: help: a slice is written as a list of its elements' Debug, which 'P' does not have: give it one ('#[derive(Debug)]' before a struct or an enum)
// ERROR-COUNT: 2
struct P { x: i64 }

fn main(gpa: Gpa) {
    let s: [i64] = [1, 2, 3];
    println(f"{s}");
    let ps: [P] = [P { x: 1 }];
    println(f"{ps:?}");
}
