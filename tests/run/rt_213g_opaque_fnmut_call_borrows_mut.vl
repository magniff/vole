// RULE: D21.6 (0.30.2, RT-213) A call of an `impl FnMut` value borrows it
// exclusively (its env a `&mut`), whatever its hidden closure is (`move ||
// k` reads only): while a shared borrow of it is live, the call is
// refused, rustc E0502; through a local and a field. A call made after
// the borrow's last use is accepted.
// ERROR: line 21
// ERROR: line 29
// ERROR-COUNT: 2
fn counter() -> impl FnMut() -> i64 {
    let k = 5;
    move || k
}

struct H<F> {
    f: F,
}

fn local() -> i64 {
    let mut g = counter();
    let r = &g;
    let a = g(); // error here
    let q = r;
    a
}

fn field() -> i64 {
    let mut h = H { f: counter() };
    let r = &h.f;
    let a = (h.f)(); // error here
    let q = r;
    a
}

fn after() -> i64 {
    let mut g = counter();
    let r = &g;
    let q = r;
    g()
}

fn main() {
    println("{} {} {}", local(), field(), after());
}
