// RULE: D21.6 (0.30.2, RT-213) A call of an `impl FnMut` value borrows it
// exclusively (its env a `&mut`), whatever its hidden closure is (`move ||
// k` reads only): while a shared borrow of it is live, the call is
// refused, rustc E0502; through a local and a field. A call made after
// the borrow's last use is accepted.
// ERROR: line 26
// ERROR: line 34
// ERROR: line 46
// ERROR: line 54
// ERROR-COUNT: 4
fn counter() -> impl FnMut() -> i64 {
    let k = 5;
    move || k
}

// (a closure made before the result: its own kind Fn, called as the
// FnMut the result's bound says)
fn counter_fn() -> impl FnMut() -> i64 {
    let k: i64 = 5;
    let f = move || k;
    f
}

fn param<F: FnMut() -> i64>(mut f: F) -> i64 {
    let r = &f;
    let a = f(); // error here
    let q = r;
    a
}

fn hidden_fn() -> i64 {
    let mut g = counter_fn();
    let r = &g;
    let a = g(); // error here
    let q = r;
    a
}

struct H<F> {
    f: F,
}

fn local() -> i64 {
    let mut g = counter();
    let r = &g;
    let a = g(); // error here
    let q = r;
    a
}

fn field() -> i64 {
    let mut h = H { f: counter() };
    let r = &h.f;
    let a = (h.f)(); // error here
    let q = r;
    a
}

fn after() -> i64 {
    let mut g = counter();
    let r = &g;
    let q = r;
    g()
}

fn main() {
    let k: i64 = 3;
    println("{} {} {}", local(), field(), after());
    println("{} {}", param(move || k), hidden_fn());
}
