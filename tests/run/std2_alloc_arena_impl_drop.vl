// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Arena::impl Drop.
// EXPECT: true
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    {
        let arena = Arena::new_in(gpa);
        arena.alloc_slice_fill_with(100, |i| i as u8);
    }
    println("{}", gpa.check_leaks());
}
