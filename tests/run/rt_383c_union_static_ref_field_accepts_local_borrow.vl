// XFAIL: RT-383: UNSOUND: a union field `&'static [u8]` takes `&e[..]` of a local (rustc E0597) (0.30.2)
// From the re-review of the std and raw-pointer work. Since v0.30.1 at least.
// ERROR: line 7
union V { a: &'static [u8], b: usize }

fn mk() -> V {
    let e = [1u8, 2, 3];
    V { a: &e[..] }
}

fn main() {
    let v = mk();
    let s = unsafe { v.a };
    println("{}", s.len());
}
