// RULE: F6.2
// A method none of the probe's steps has (`S`, `&S`, `&mut S`) is an
// error: here only `&&S` has it (rustc E0599).
// ERROR: no method 'tag' on type 'S'
trait Tag {
    fn tag(self) -> i64;
}

struct S {
    a: i64,
}

impl<'a, 'b> Tag for &'a &'b S {
    fn tag(self) -> i64 {
        self.a
    }
}

fn main() -> i64 {
    let s = S { a: 5 };
    s.tag()
}
