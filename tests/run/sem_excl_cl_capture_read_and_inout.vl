// EDITION: rust
// a closure that only reads n (plain: by copy? 0.14: a var is captured inout)
// ERROR: error[borrowck.conflict]
// ERROR: line 6, column 55
fn apply<F: Fn() -> i64>(x: &mut i64, f: F) -> i64 { *x += 1; f() }
fn main() { let mut n: i64 = 1; let r = apply(&mut n, || n * 100); println("{r} {n}"); }
