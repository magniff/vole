// receiver an element, argument the whole Vec inout
// ERROR: error[borrowck.mut_twice]
// ERROR: line 13, column 78
#[derive(Clone, Copy)] struct S { n: i64 }

impl S {
    fn grow(&mut self, v: &mut Vec<S, Gpa>) {
        for i in 0..100 { v.push(S { n: i }); } self.n = 7;
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<S, Gpa> = Vec::new_in(gpa); v.push(S { n: 1 }); v[0].grow(&mut v);
    println("{}", v[0].n);
}
