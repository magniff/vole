// receiver an element, argument the whole Vec inout
// ERROR: own.conflict
struct S { n: i64 }

impl S {
    fn grow(inout self, v: inout Vec<S, Gpa>) {
        for i in 0..100 { v.push(S { n: i }); } self.n = 7;
    }
}

fn main(gpa: Gpa) {
    var v: Vec<S, Gpa> = Vec::new_in(gpa); v.push(S { n: 1 }); v[0].grow(&v); println("{}", v[0].n);
}
