// XFAIL: RT-495d: (RT-495, a struct) `fn hs(_x: &i64) -> H<'static>` as MyMap's F, then `drop(v)` before the result's use, is refused (borrowck.move_borrowed); rustc prints 7 (0.30.2)
// From the third re-review of the borrow-check work (g302bor2).
// EXPECT: 7
static SEVEN: i64 = 7;

fn st(_x: &i64) -> &'static i64 {
    &SEVEN
}

struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

#[derive(Debug)]
struct H<'a> {
    r: &'a i64,
}

fn hs(_x: &i64) -> H<'static> {
    H { r: &SEVEN }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = MyMap { i: v.iter(), f: hs }.next();
    drop(v);
    println("{}", r.unwrap().r);
}
