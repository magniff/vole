// XFAIL: RT-476: a method of the Deref target through a `T: Deref<Target = W>` bound, `x.tag()` in `fn f<T: Deref<Target = W>>(x: T)` with `impl Tag for W`, is refused ("no function 'tag' in the bounds of 'T'" in the instance for Box<W, Gpa>); rustc derefs T to W and prints `1 0` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// The review's g01 also calls f(&w): '&W: Deref' is not implemented,
// RT-75. RT-313 is the other side (T's method through a Box<T>).
// EXPECT: 1 0
use std::ops::Deref;

trait Tag {
    fn tag(&self) -> i64;
}

struct W {
    k: i64,
}

impl Tag for W {
    fn tag(&self) -> i64 {
        1
    }
}

fn f<T: Deref<Target = W>>(x: T) -> i64 {
    x.tag()
}

fn main(gpa: Gpa) -> i32 {
    let b: Box<W, Gpa> = Box::new_in(W { k: 1 }, gpa);
    println("{} {}", f(b), 0);
    0
}
