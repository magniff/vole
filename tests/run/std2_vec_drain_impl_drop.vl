// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Drain::impl Drop.
// EXPECT: [1, 5] 2
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3, 4, 5], gpa);
    let first = v.drain(1..4).next();
    println("{:?} {}", v, first.unwrap());
}
