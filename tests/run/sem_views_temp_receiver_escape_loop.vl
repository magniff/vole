#[derive(Clone, Copy)] // (0.25 semantics audit, views) A view of a loop iteration's temporary
// receiver, pushed into a Vec that outlives the iteration: every element
// viewed the same reused stack slot (it printed "cccc cccc cccc" for "aaaa
// bbbb cccc"). A struct literal receiver does the same. With a function's
// temporary argument instead (`nm(mk(c))`) it is own.escape, as it should.
// ERROR: error[own.escape]
struct E { name: [u8; 4], len: i64 }
impl E { fn nm(self) -> &'static [u8] { &self.name[..self.len as usize] } }
fn mk(c: u8) -> E { E { name: [c, c, c, c], len: 4 } }

fn main(gpa: Gpa) -> i32 {
    let mut keep: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    for i in 0..3 {
        keep.push(mk(b'a' + i as u8).nm());
    }
    println("{} {} {}", str::from_utf8(keep[0usize]).unwrap(),
        str::from_utf8(keep[1usize]).unwrap(), str::from_utf8(keep[2usize]).unwrap());
    0
}
