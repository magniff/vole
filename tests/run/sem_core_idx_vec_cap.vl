// EDITION: rust
// An index below the capacity but at or past the length.
// EXIT: 101
// STDERR: index out of bounds: index 5, length 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(16usize, gpa);
    v.push(1);
    println("{}", v[(5 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
