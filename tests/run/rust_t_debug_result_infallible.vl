// EDITION: rust
// RULE: F11.3
// (0.28.0) `{:?}` of a `Result<T, Infallible>`: Result's Debug has an
// `Err(e)` arm no value of this instance reaches; it is reached in
// another instance, and was refused here ("unreachable match arm").
// EXPECT: Ok(3)
use std::convert::Infallible;

fn main() {
    let r: Result<i64, Infallible> = Ok(3);
    println("{:?}", r);
}
