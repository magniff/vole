// EDITION: rust
// RULE: D4.6
// (0.27.2.1) A substitution is well-formed: in `Tk<&'m mut One<'x>>`'s
// `go`, the type argument's own `'x: 'm` holds, which the call through
// `impl Src for &mut J` requires, as `it.by_ref().take(2)` does.
// EXPECT: hi
trait Src {
    type Item;
    fn take(&mut self) -> Option<Self::Item>;
}

struct One<'a> {
    s: Option<&'a str>,
}

impl<'a> Src for One<'a> {
    type Item = &'a str;

    fn take(&mut self) -> Option<&'a str> {
        let r = self.s;
        self.s = Option::None;
        r
    }
}

impl<'b, J: Src> Src for &'b mut J {
    type Item = J::Item;

    fn take(&mut self) -> Option<J::Item> {
        (**self).take()
    }
}

struct Tk<I> {
    it: I,
}

impl<I: Src> Tk<I> {
    fn go(&mut self) -> Option<I::Item> {
        self.it.take()
    }
}

fn main() {
    let mut o = One { s: Option::Some("hi") };
    let mut t = Tk { it: &mut o };
    println("{}", t.go().unwrap());
}
