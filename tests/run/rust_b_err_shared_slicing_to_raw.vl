// RULE: D2.7, R1
// (0.30.1, RT-33 round 2, F5) A `&mut` slicing of a shared view made a raw
// one: `let p: *mut [i64] = &mut s[..]`, `&mut *s` likewise, `&mut s[..] as
// *mut [i64]`, `w(&mut s[..])` of a `*mut [i64]` parameter: the `&mut` is
// asked wherever it goes, rustc's E0596 at each. Before, a coercion to a
// raw view skipped the question.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 25, column 30
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 26, column 25
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 27, column 18
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 28, column 12
// ERROR-COUNT: 4
fn w(p: *mut [i64]) {
    // UNSAFE: the write the borrow would allow
    // SAFETY: never run: the program is refused
    unsafe {
        (*p)[0] = 1;
    }
}

fn k(s: &[i64]) {
    let p: *mut [i64] = &mut s[..];
    let q: *mut [i64] = &mut *s;
    let r = &mut s[..] as *mut [i64];
    w(&mut s[..]);
    w(p);
    w(q);
    w(r);
}

fn main() {
    let a = [1i64, 2];
    k(&a[..]);
    println("{}", a[0]);
}
