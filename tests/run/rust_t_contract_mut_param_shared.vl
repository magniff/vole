// EDITION: rust
// RULE: C3.1
// (0.27.1) A clause sees a `&mut i64` parameter as `&i64` (`shared(..)`):
// a write through it in a `requires` is refused by the type system.
// Today the write runs (the clause is typed with the parameter as it is).
// ERROR: error[own.readonly]: writes through 'v'
// ERROR-COUNT: 1
// XFAIL: ir271: C3's `shared(..)` typing of a clause (signature_copy)
fn g(v: &mut i64)
    requires {
    *v = 0;
    true
}

{
    *v += 1;
}

fn main() {
    let mut a: i64 = 1;
    g(&mut a);
    println("{}", a);
}
