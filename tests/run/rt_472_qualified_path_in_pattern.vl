// XFAIL: RT-472: a qualified path as a match pattern, `<S as Mk>::C =>` (a trait's associated constant), does not parse: "expected a pattern, got '<'"; rustc prints `seven` (0.30.2)
// From the third round of the g302qual review. Since v0.30.1 at least.
// `<W<u8> as Mk>::C =>` of a generic W is refused the same way. The
// unqualified `S::C =>` parses and is then RT-124's "not a compile-time
// constant" (rt_124e): a fix of the parser alone may meet that next.
// EXPECT: seven
trait Mk {
    const C: i64;
}

struct S;

impl Mk for S {
    const C: i64 = 7;
}

fn main() {
    let v: i64 = 7;
    match v {
        <S as Mk>::C => println("seven"),
        _ => println("other"),
    }
}
