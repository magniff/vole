// XFAIL: RT-B301-12: a stored mutable view as a method's receiver through a Box or a Vec element is refused (open, 0.30.2; a regression of 0.30.1)
// `b.s.reverse()` and `v[0].s.reverse()` (with `let mut`): rustc reaches
// the view through DerefMut and IndexMut and accepts them (prints 1 1);
// vole reborrows the receiver through the shared Deref and Index and
// refuses it (borrowck.borrow_immutable). 0.30.0 accepted them by copying
// the view out (a copy of a `&mut` with no loan, I7); given to a call
// instead, the field is reached mutably (rust_b_box_field_arg_ok).
// EXPECT: 1 1
struct W<'a> {
    s: &'a mut [i64],
}

fn main(gpa: Gpa) {
    let mut arr = [3i64, 1];
    let mut b = Box::new_in(W { s: &mut arr }, gpa);
    b.s.reverse();
    let mut a2 = [3i64, 1];
    let mut v: Vec<W<'_>, Gpa> = Vec::new_in(gpa);
    v.push(W { s: &mut a2 });
    v[0].s.reverse();
    println("{} {}", b.s[0], v[0].s[0]);
}
