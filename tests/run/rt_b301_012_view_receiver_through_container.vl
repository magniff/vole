// RULE: F20.6, D2.7
// (RT-B301-12, fixed in 0.30.1 with RT-33) A stored mutable view as a
// method's receiver through a Box or a Vec element.
// `b.s.reverse()` and `v[0].s.reverse()` (with `let mut`): rustc reaches
// the view through DerefMut and IndexMut and accepts them (prints 1 1);
// vole reborrows the receiver through them too (place_to_mut of a view
// receiver). Before, through the shared Deref and Index, it was refused
// (borrowck.borrow_immutable); 0.30.0 accepted them by copying the view
// out (a copy of a `&mut` with no loan, I7); given to a call instead, the
// field is reached mutably (rust_b_box_field_arg_ok).
// EXPECT: 1 1
struct W<'a> {
    s: &'a mut [i64],
}

fn main(gpa: Gpa) {
    let mut arr = [3i64, 1];
    let mut b = Box::new_in(W { s: &mut arr }, gpa);
    b.s.reverse();
    let mut a2 = [3i64, 1];
    let mut v: Vec<W<'_>, Gpa> = Vec::new_in(gpa);
    v.push(W { s: &mut a2 });
    v[0].s.reverse();
    println("{} {}", b.s[0], v[0].s[0]);
}
