// XFAIL: RT-247: `*s` of a `&mut [i64]` is refused, "cannot deref non-pointer type '&mut [i64]'" (0.30.2)
// rustc accepts it: `*s` is the place `[i64]`, indexed, measured or reborrowed (`&mut *s`).
// EXPECT: 9 2 9
fn first(s: &mut [i64]) -> i64 {
    (*s)[0] = 9;
    let r: &mut [i64] = &mut *s;
    r[0] + (*s).len() as i64 - 2
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let x = first(v.as_mut_slice());
    println("{} {} {}", x, v.len(), v[0]);
}
