// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str Utf8Error.
// EXPECT: Utf8Error { valid_up_to: 2, error_len: Some(1) } true
use std::str::Utf8Error;

fn main() {
    let e: Utf8Error = std::str::from_utf8(&[97, 98, 0xFF]).unwrap_err();
    let f = e;
    println("{:?} {}", e, e == f);
}
