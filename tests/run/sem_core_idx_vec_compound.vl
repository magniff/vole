// v[i] += 1 out of bounds is checked.
// EXIT: 101
// STDERR: index out of bounds: index 3, length 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v[(3 + unsafe { Z }) as usize] += 1;
    println("not reached");
    0
}
