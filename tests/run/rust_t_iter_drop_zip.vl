// EDITION: rust
// (0.27.0) Hand-translated from tests/run/iter_drop_zip.vl to Rust's spelling.
// 0.25: zip: when one side ends, the item the other gave is dropped, and
// the rest of an owning side drops with the Zip.
// FLAGS: --check-alloc
// EXPECT: pairs 2
// EXPECT: zip: made 5 dropped 5
// EXPECT: pairs 2
// EXPECT: pop: made 11 dropped 11
static mut MADE: i64 = 0;
static mut DROPS: i64 = 0;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        DROPS += 1;
    }
}

impl Eq for D<Gpa> {
    fn eq(&self, o: &Self) -> bool {
        self.id == o.id
    }
}

impl Ord for D<Gpa> {
    fn cmp(&self, o: &Self) -> i64 {
        self.id - o.id
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    MADE += 1;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen<A: Allocator> {
    n: i64,
    k: i64,
    gpa: A,
}

impl Iterator for Gen<Gpa> {
    type Item = D<Gpa>;

    fn next(&mut self) -> Option<D<Gpa>> {
        if self.k >= self.n {
            return None;
        }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen<Gpa> {
    Gen { n: n, k: 0, gpa: gpa }
}

// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop<A: Allocator> {
    v: Vec<D<A>, A>,
}

impl Iterator for Pop<Gpa> {
    type Item = D<Gpa>;

    fn next(&mut self) -> Option<D<Gpa>> {
        self.v.pop()
    }
}

fn pop(n: i64, gpa: Gpa) -> Pop<Gpa> {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 1..=n {
        v.push(mk(i, gpa));
    }
    Pop { v: v }
}

fn report(what: &str) {
    println("{what}: made {MADE} dropped {DROPS}");
}

fn main(gpa: Gpa) {
    let mut n = 0;
    for (a, b) in gen(3, gpa).zip(gen(2, gpa)) {
        n += a.id * 0 + b.id * 0 + 1;
    }
    println("pairs {n}");
    report("zip");
    let k = pop(4, gpa).zip(gen(2, gpa)).count();
    println("pairs {k}");
    report("pop");
}
