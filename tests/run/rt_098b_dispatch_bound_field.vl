// XFAIL: RT-98: `h.t.f()` on a field of type T: Tr<i64> is refused as ambiguous (0.30.2)
// From the review of the obligation engine's M1 (pre-existing: v0.30.1 too).
// EXPECT: 64
trait Tr<U> { fn f(&self) -> i64; }
struct W { r: i64 }
impl Tr<i32> for W { fn f(&self) -> i64 { 32 } }
impl Tr<i64> for W { fn f(&self) -> i64 { 64 } }
struct H<T> { t: T }
fn go<T: Tr<i64>>(h: &H<T>) -> i64 { h.t.f() }
fn main() { let x = W { r: 1 }; println("{}", go(&H { t: W { r: 1 } })); }
