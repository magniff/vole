// Runs on std since 0.27.2's switch.
// The std item(s): std::ops BitAndAssign::bitand_assign.
// EXPECT: V { x: 4 } 4
use std::ops::BitAndAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitAndAssign for V {
    fn bitand_assign(&mut self, rhs: V) {
        self.x &= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.bitand_assign(V { x: 5 });
    let mut n = 12i64;
    n.bitand_assign(5);
    println("{:?} {}", a, n);
}
