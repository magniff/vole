// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md)
// a reference into a HashMap's String value, then the entry is removed (rustc E0502)
// ERROR: error[borrowck.conflict]
use std::collections::HashMap;

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, String<Gpa>, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, String::from_in("hello", gpa));
    let w = m.get(&1).unwrap().as_str();
    m.remove(&1);
    println("{}", w);
    0
}
