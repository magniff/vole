// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Copied::impl Iterator.
// EXPECT: Some(1) (1, Some(1))

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().copied();
    let a = it.next();
    println("{:?} {:?}", a, it.size_hint());
}
