// RULE: C3.4
// (0.30.2, the re-review 2 of g302holes: holes/fat04_mutstr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'go', which writes through a raw pointer what it did not make
// &mut *p of a *mut str param, then made upper case in place
fn go(sp: *mut str) -> bool { let s = unsafe { &mut *sp }; s.make_ascii_uppercase(); true }

fn f(sp: *mut str) -> i64
    requires go(sp)
{ 1 }

fn main(gpa: Gpa) {
    let mut st = "ab".to_string_in(gpa); let sp = st.as_mut_str() as *mut str; println("{}", f(sp));
    println("{}", st);
}
