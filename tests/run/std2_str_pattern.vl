// The std2 item(s): std::str Pattern.
// EXPECT: 2 Some(0) None
// RUSTC: none (Rust's Pattern is unstable)
use std::str::Pattern;

fn count<P: Pattern>(s: &str, p: P) -> usize {
    let mut p = p;
    let mut n = 0;
    let mut at = 0;
    while let Some((_, b)) = p.next_match(s, at) {
        n += 1;
        at = b;
    }
    n
}

fn main() {
    let set: &[char] = &['x', 'y'];
    println("{} {:?} {:?}", count("a,b,c", ','), "xa".find(set), "abc".find(set));
}
