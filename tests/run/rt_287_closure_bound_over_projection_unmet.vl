// XFAIL: RT-287: a closure parameter bounded over a projection, `F: Fn(I::Item) -> U` (or FnOnce, FnMut), does not meet a bound with the same projection: `it.next().map(f)` is "the type 'F' does not satisfy the bound 'F: FnOnce(I::Item) -> U' of 'Option::map'", `it.map(f).count()` "no method 'count' on type 'Map<I, F>'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). With a plain parameter
// (`F: Fn(T) -> U` and `o.map(f)`) or a concrete item (`I: Iterator<Item =
// i64>, F: Fn(i64) -> U`) the same bodies build.
// EXPECT: Some(3)
// EXPECT: Some(4)
// EXPECT: 3
// EXPECT: Some(2) Some(5)
fn m2<I: Iterator, U, F: FnOnce(I::Item) -> U>(mut it: I, f: F) -> Option<U> {
    it.next().map(f)
}

fn m3<I: Iterator, U, F: Fn(I::Item) -> U>(mut it: I, f: F) -> Option<U> {
    it.next().map(f)
}

fn m5<I: Iterator, U, F: FnMut(I::Item) -> U>(it: I, f: F) -> i64 {
    it.map(f).count() as i64
}

fn m1<T, U, F: Fn(T) -> U>(o: Option<T>, f: F) -> Option<U> {
    o.map(f)
}

fn m4<I: Iterator<Item = i64>, U, F: Fn(i64) -> U>(mut it: I, f: F) -> Option<U> {
    it.next().map(f)
}

fn main() {
    let v = [1i64, 2, 3];
    println("{:?}", m2(v.iter(), |x| *x + 2));
    println("{:?}", m3(v.iter(), |x| *x + 3));
    println("{}", m5(v.iter(), |x| *x));
    println("{:?} {:?}", m1(Some(1i64), |x| x + 1), m4(v.iter().copied(), |x| x + 4));
}
