// EDITION: rust
// RULE: D4.6
// (0.27.2.1) The impl header's elided lifetime is the impl's: a `&'z str`
// of the method's own lifetime is not a `Self` (rustc: lifetime may not
// live long enough).
trait Swap {
    fn swap<'z>(self, other: &'z str) -> Self;
}

impl Swap for &str {
    fn swap<'z>(self, other: &'z str) -> Self {
        other
    }
}

fn main() {
    println("{}", "a".swap("b"));
}
// ERROR: error[borrowck.outlives]
