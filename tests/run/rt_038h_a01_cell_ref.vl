// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a01_cell_ref)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'Cell<i64>::set', which writes through a shared reference (a cell)
// A clause calls Cell::set on a &Cell parameter: a write the caller sees.
use std::cell::Cell;

fn f(c: &Cell<i64>) -> i64
    requires { c.set(9); true }

{
    1
}

fn main() {
    let c = Cell::new(1i64);
    println("{}", f(&c));
    println("{}", c.get());
}
