// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl RemAssign for primitives.
// EXPECT: 2 2
use std::ops::RemAssign;

fn update<T: RemAssign>(a: &mut T, b: T) {
    a.rem_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
