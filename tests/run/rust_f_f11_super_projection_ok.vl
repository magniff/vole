// EDITION: rust
// RULE: F11.5
// An impl parameter fixed by a bound naming a supertrait's associated
// type: `I: Back<Item = &T>` with Item Iterator's (Back: Iterator) binds T.
// EXPECT: Some(3)
trait Back: Iterator {
    fn last_one(&mut self) -> Option<Self::Item>;
}

impl<'a> Back for std::slice::Iter<'a, i64> {
    fn last_one(&mut self) -> Option<&'a i64> {
        self.next_back()
    }
}

struct Cp<I> {
    it: I,
}

impl<'a, T: Copy + 'a, I: Back<Item = &'a T>> Cp<I> {
    fn take_last(&mut self) -> Option<T> {
        self.it.last_one().copied()
    }
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3], gpa);
    let mut c = Cp { it: v.iter() };
    println("{:?}", c.take_last());
}
