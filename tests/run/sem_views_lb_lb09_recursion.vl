// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: cd (recursion through a view of a let param)
// EXPECT: cd 7
#[derive(Clone, Copy)] struct E { name: [u8; 4], len: i64 }
fn tail(e: &E, k: i64) -> &[u8] { if k == 0 { &e.name[2..] } else { tail(e, k - 1) } }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: [b'a', b'b', b'c', b'd'], len: 4 };
    let r = tail(&e, 3);
    let k = clobber();
    println("{r} {k}", r = str::from_utf8(r).unwrap());
    0
}
