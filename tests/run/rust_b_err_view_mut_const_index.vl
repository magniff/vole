// RULE: D1.5
// (0.27.1; 0.30: an error) `&mut s[0]` and `&mut s[1]` of a `&mut [i64]`:
// two indexes may alias, constants too, rustc's E0499 (R7, where they
// were disjoint, closed in 0.30).
// ERROR: error[borrowck.mut_twice]
// ERROR: line 10, column 13
// ERROR-COUNT: 1
fn touch(s: &mut [i64]) {
    let p = &mut s[0];
    let q = &mut s[1];
    *p += 10;
    *q += 20;
}

fn main() {
    let mut a = [1i64, 2];
    touch(&mut a[..]);
    println("{} {}", a[0], a[1]);
}
