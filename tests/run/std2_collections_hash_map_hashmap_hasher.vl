// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::collections::hash_map HashMap::hasher.
// EXPECT: true
use std::collections::{HashMap, hash_map};
use std::hash::{BuildHasher, FixedState};

fn main(gpa: Gpa) {
    let mut m = HashMap::with_hasher_in(FixedState::new(), gpa);
    m.insert(1i64, 1i64);
    let h = m.hasher();
    println("{}", h.hash_one(5i64) == h.hash_one(5i64));
}
