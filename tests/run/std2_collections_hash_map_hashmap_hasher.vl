// The std2 item(s): std::collections::hash_map HashMap::hasher.
// EXPECT: true
use std::collections::HashMap;
use std::hash::BuildHasher;

fn main(gpa: Gpa) {
    let mut m = HashMap::with_hasher_in(FixedState::new(), gpa);
    m.insert(1i64, 1i64);
    let h = m.hasher();
    println("{}", h.hash_one(5i64) == h.hash_one(5i64));
}
