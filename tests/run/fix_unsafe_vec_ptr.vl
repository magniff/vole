// EXPECT: 1 2 7
// 0.17: `p[i]` through a raw pointer to a Vec means the same in `unsafe`
// code, so `fix --only unsafe` wraps it (before, it was pointer arithmetic
// there, and the fix left such places alone).
use std::alloc::Allocator; #[derive(Clone, Copy)] struct H<A: Allocator> { vp: *mut Vec<i64, A> }

fn top(st: *mut Vec<i64, Gpa>) -> i64 {
    st[0]
}

fn main(gpa: Gpa) -> i32 {
    let mut d: Vec<i64, Gpa> = Vec::new_in(gpa);
    d.push(1);
    d.push(2);
    let p: *mut Vec<i64, Gpa> = &mut d;
    let v = p[1];
    let h = H { vp: &mut d };
    h.vp[0] = 7;
    println("{} {v} {}", top(&mut d) - 6, d[0]);
    0
}
