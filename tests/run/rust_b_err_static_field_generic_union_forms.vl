// RULE: D3.6 (0.30.2, RT-383) The `&'static` field of a generic struct's
// literal in a generic body (a free fn and an `impl<T>`'s `Self { .. }`),
// of a generic enum's variant, and of a union, the field written not
// first and beside a lifetime parameter: each takes only a 'static borrow.
// rustc: E0597 at each borrow. Before 0.30.2 the generic and the union
// forms of a type with no lifetime were accepted (a union with one was
// refused, as now).
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 41, column 15
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 47, column 22
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 53, column 13
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 58, column 12
// ERROR: error[borrowck.return_local]
// ERROR: line 64, column 13
// ERROR-COUNT: 5
struct W<T> {
    t: T,
    a: &'static u64,
}

enum E<T> {
    A(T, &'static u64),
    B,
}

union U {
    b: usize,
    a: &'static u64,
}

union UL<'x> {
    a: &'x u64,
    b: &'static u64,
}

fn mk<T>(t: T) -> W<T> {
    let e = 1u64;
    W { t, a: &e }
}

impl<T> W<T> {
    fn new(t: T) -> Self {
        let e = 2u64;
        Self { t, a: &e }
    }
}

fn variant() -> E<i64> {
    let e = 3u64;
    E::A(1, &e)
}

fn union_second() -> U {
    let e = 4u64;
    U { a: &e }
}

fn union_lifetime<'x>(x: &'x u64) -> UL < 'x > {
    let _ = x;
    let e = 5u64;
    UL { b: &e }
}

fn main() {
    let k = 6u64;
    let u = union_second();
    let ul = union_lifetime(&k);
    // UNSAFE: a union's field is read only in an unsafe block
    // SAFETY: each union was written through the field read here
    let (r, s) = unsafe { (u.a, ul.b) };
    match variant() {
        E::A(t, q) => println("{} {}", t, q),
        E::B => println("b"),
    }
    println("{} {} {} {}", mk(1i64).a, W::new(2i64).a, r, s);
}
