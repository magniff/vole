// EDITION: rust
// XFAIL: gap 7: an embed block in the rust edition: its text is made a [u8] (MVS's str), which std2's str literal is not
// 0.26.0: embedded blocks, both forms (docs/grammar.md, "Embedded
// blocks"): `embed wgsl NAME { WGSL }`, its text WGSL's to the `}` that
// matches outside comments (a `}` in a comment, `1u`, `@` attributes), and
// `embed wgsl NAME from "path";`, the file relative to this file. Each
// is an immutable static of a struct the compiler makes: `src`, the text,
// and a field per entry point holding its name.
// EXPECT: main 312
// EXPECT: fill 175
embed wgsl STEP {
    // a } in a comment, /* nested /* } */ */
    @group(0) @binding(0) var<storage, read_write> data: array<u32>;

    @compute @workgroup_size(64)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        if id.x < arrayLength(&data) {
            data[id.x] = data[id.x] * 2u + 1u;
        }
    }
}

pub embed wgsl FILL from b"shaders/fill.wgsl";

fn main() -> i32 {
    println("{} {}", str::from_utf8(STEP.main).unwrap(), STEP.src.len());
    println("{} {}", str::from_utf8(FILL.fill).unwrap(), FILL.src.len());
    0
}
