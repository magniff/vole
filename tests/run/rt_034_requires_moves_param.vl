// RT-34: a `requires` is checked in `f$pre`, a function the compiler
// makes, whose by-value parameters are the call's arguments read in
// place (never dropped there). A move out of one, or out of a binding
// that borrows one, was lowered as a silent copy of a borrowed copy, so
// no check saw it and both the clause's new owner and the function
// dropped the value (a double free, --check-alloc). Lowered under Rust's
// rules, a move out of a borrowed copy is a move: contract.move. (0.30.1,
// round 2: a by-value binding out of one, `Some(w)` or `(a, _)` of a
// parameter, is a move too, as out of `*r` with `r: &T`, rustc E0507:
// reported at the pattern, once.)
// ERROR: error[contract.move]: a clause moves 'v'
// ERROR: line 28, column 13
// ERROR: error[contract.move]: a clause moves 'v'
// ERROR: line 39, column 14
// ERROR: error[contract.move]: a clause moves 't'
// ERROR: line 51, column 13
// ERROR: error[contract.move]: a clause moves 't'
// ERROR: line 61, column 13
// ERROR: error[contract.move]: a clause moves 'v'
// ERROR: line 70, column 14
// ERROR: error[contract.move]: a clause moves 'o'
// ERROR: line 77, column 10
// ERROR: error[contract.move]: a clause moves 't'
// ERROR: line 90, column 6
// ERROR-COUNT: 7
fn by_let(v: Vec<i64, Gpa>) -> usize
    requires {
    let w = v;
    w.len() > 0
}

{
    v.len()
}

fn by_for(v: Vec<i64, Gpa>) -> usize
    requires {
    let mut n = 0;
    for x in v {
        n += x;
    }
    n > 0
}

{
    v.len()
}

fn by_field(t: (Vec<i64, Gpa>, i64)) -> usize
    requires {
    let a = t.0;
    a.len() > 0
}

{
    t.0.len()
}

fn by_closure(t: (Vec<i64, Gpa>, i64)) -> usize
    requires {
    let c = move || t.0.len();
    c() > 0
}

{
    t.0.len()
}

fn by_tuple(v: Vec<i64, Gpa>) -> usize
    requires(v, 1).1 > 0
{
    v.len()
}

fn by_binding(o: Option<Vec<i64, Gpa>>) -> usize
    requires match o {
    Some(w) => {
        let z = w;
        z.len() > 0
    }
    None => true,
}

{
    0
}

fn by_pattern(t: (Vec<i64, Gpa>, i64)) -> usize
    requires match t {
    (a, _) => {
        let z = a;
        z.len() > 0
    }
}

{
    0
}

fn main(gpa: Gpa) {
    println("{}", by_let(Vec::from_in([1i64], gpa)));
    println("{}", by_for(Vec::from_in([1i64], gpa)));
    println("{}", by_field((Vec::from_in([1i64], gpa), 1)));
    println("{}", by_closure((Vec::from_in([1i64], gpa), 1)));
    println("{}", by_tuple(Vec::from_in([1i64], gpa)));
    println("{}", by_binding(Some(Vec::from_in([1i64], gpa))));
    println("{}", by_pattern((Vec::from_in([1i64], gpa), 1)));
}
