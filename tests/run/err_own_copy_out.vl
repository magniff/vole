fn a6(v: &Vec<Vec<u8, Gpa>, Gpa>) -> Vec<u8, Gpa> { v[0usize].clone() }
fn a7(v: &Vec<Vec<u8, Gpa>, Gpa>) -> S<Gpa> { S { f: v[0usize].clone() } }
