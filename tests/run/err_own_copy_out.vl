// (0.17, T7) Bitwise copies of an owned value out of a reference, an index
// or a collection's accessor, moved anywhere (a let, a return, a field, a
// push, an assignment, Some(..), a tuple): own.move_out, each. Any one
// that slipped through would free its buffer twice (--check-alloc: main
// calls them all). own_copy_out shows the fixes the try: lines give.
// (0.20: the references are let parameters, and `let x = r` borrows.)
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
struct S<A: Allocator> { f: Buf<A> }
fn a1(r: Buf<Gpa>) -> Buf<Gpa> { let x = r; x }
fn a2(r: Buf<Gpa>) -> Buf<Gpa> { r }
fn a3(r: S<Gpa>) -> Buf<Gpa> { r.f }
fn a4(r: S<Gpa>, out: inout Vec<Buf<Gpa>, Gpa>) { out.push(r.f); }
fn a5(v: Vec<Buf<Gpa>, Gpa>) -> Buf<Gpa> { v[0] }
fn a6(v: Vec<Buf<Gpa>, Gpa>) -> Buf<Gpa> { v.get(0) }
fn a7(v: Vec<Buf<Gpa>, Gpa>) -> S<Gpa> { S { f: v.get(0) } }
fn a8(v: Vec<Buf<Gpa>, Gpa>, s: inout S<Gpa>) { s.f = v.get(0); }
fn a9(v: Vec<Buf<Gpa>, Gpa>, g: Gpa) -> Buf<Gpa> { var x = Buf::new_in(g); x = v.get(0); x }
fn a10(r: inout S<Gpa>) -> Buf<Gpa> { r.f }
fn a11(v: Vec<Buf<Gpa>, Gpa>) -> Option<Buf<Gpa>> { Some(v.get(0)) }
fn a12(r: Buf<Gpa>) -> (Buf<Gpa>, i64) { (r, 1) }
fn a13(v: Vec<Buf<Gpa>, Gpa>) -> Buf<Gpa> { let x = v.get(0); x }

fn a14(v: Vec<Buf<Gpa>, Gpa>, g: Gpa) -> Buf<Gpa> {
    match v.last() { Some(b) => b, None => Buf::new_in(g) }
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<Buf<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(Buf::from_in("x", gpa));
    var s = S { f: Buf::from_in("y", gpa) };
    var out: Vec<Buf<Gpa>, Gpa> = Vec::new_in(gpa);
    let n = (a1(s.f).len() + a2(s.f).len() + a3(s).len() + a5(v).len() + a6(v).len()
        + a7(v).f.len() + a9(v, gpa).len() + a10(&s).len() + a13(v).len()
        + a14(v, gpa).len()) as i64 + a12(s.f).1;
    a4(s, &out);
    a8(v, &s);
    let o = a11(v);
    std::print_int(n + out.len() as i64 + o.is_some() as i64);
    0
}
// FLAGS: --check-alloc
// ERROR: cannot move 'x' (Buf<Gpa>) out of a reference
// ERROR: cannot move 'r' (Buf<Gpa>) out of a reference
// ERROR: cannot move 'r.f' (Buf<Gpa>) out of a reference
// ERROR: cannot move 'r.f' (Buf<Gpa>) out of a reference
// ERROR: cannot move 'v[0]' (Buf<Gpa>) out of an index
// ERROR: cannot move 'v.get(0)' (Buf<Gpa>): it is a copy of an element the collection keeps
// ERROR: cannot move 'v.get(0)' (Buf<Gpa>): it is a copy of an element the collection keeps
// ERROR: cannot move 'v.get(0)' (Buf<Gpa>): it is a copy of an element the collection keeps
// ERROR: cannot move 'v.get(0)' (Buf<Gpa>): it is a copy of an element the collection keeps
// ERROR: cannot move 'r.f' (Buf<Gpa>) out of a reference
// ERROR: cannot move 'v.get(0)' (Buf<Gpa>): it is a copy of an element the collection keeps
// ERROR: cannot move 'r' (Buf<Gpa>) out of a reference
// ERROR: cannot move 'x' (Buf<Gpa>) out of 'x'
// ERROR: cannot move 'b' (Buf<Gpa>) out of 'b'
// ERROR-COUNT: 14
