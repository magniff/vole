fn a9(v: &Vec<Vec<u8, Gpa>, Gpa>, g: Gpa) -> Vec<u8, Gpa> {
    let mut x = Vec::<u8, _>::new_in(g); x = v[0usize].clone(); x
}

fn a10(r: &mut S<Gpa>) -> Vec<u8, Gpa> { r.f }
fn a11(v: &Vec<Vec<u8, Gpa>, Gpa>) -> Option<Vec<u8, Gpa>> > { Some(v[0usize].clone()) }
fn a12(r: &Vec<u8, Gpa>) -> (Vec<u8, Gpa>, i64) { (r, 1) }
fn a13(v: &Vec<Vec<u8, Gpa>, Gpa>) -> Vec<u8, Gpa> { let x = v[0usize].clone(); x }

fn a14(v: &Vec<Vec<u8, Gpa>, Gpa>, g: Gpa) -> Vec<u8, Gpa> {
    match v.last().cloned() { Some(b) => b, None => Vec::<u8, _>::new_in(g) }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Vec<u8, Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(b"x".to_vec_in(gpa));
    let mut s = S { f: b"y".to_vec_in(gpa) };
    let mut out: Vec<Vec<u8, Gpa>, Gpa> = Vec::new_in(gpa);
    let n = (a1(&s.f).len() + a2(&s.f).len() + a3(&s).len() + a5(&v).len() + a6(&v).len()
        + a7(&v).f.len() + a9(&v, gpa).len() + a10(&mut s).len() + a13(&v).len()
        + a14(&v, gpa).len()) as i64 + a12(&s.f).1;
    a4(&s, &mut out);
    a8(&v, &mut s);
    let o = a11(&v);
    print("{}", (n + out.len() as i64 + o.is_some() as i64));
    0
}
