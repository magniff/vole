// XFAIL: RT-295: slices lack strip_prefix, strip_suffix, split_at_checked, is_sorted_by, is_sorted_by_key and sort_by_cached_key (as vole's `sort_by_cached_key_in`, which allocates): "no method 'strip_prefix' on type '&[i64]'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). Present: starts_with,
// ends_with, split_at, is_sorted, sort_by_key_in. R302F-10 is the
// Iterator side of is_sorted_by.
// EXPECT: Some([1, 2]) None Some([3, 1])
// EXPECT: true Some(([3], [1, 2]))
// EXPECT: false false
// EXPECT: [3, 2, 1]
fn main(gpa: Gpa) {
    let mut a = [3i64, 1, 2];
    let s = &a[..];
    println("{:?} {:?} {:?}", s.strip_prefix(&[3i64]), s.strip_prefix(&[1i64]),
        s.strip_suffix(&[2i64]));
    println("{:?} {:?}", s.split_at_checked(4).is_none(), s.split_at_checked(1));
    println("{:?} {:?}", s.is_sorted_by(|x, y| x <= y), s.is_sorted_by_key(|x| *x == 3));
    a.sort_by_cached_key_in(|x| -*x, gpa);
    println("{:?}", a);
}
