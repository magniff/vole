// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::convert From.
// EXPECT: 5 m
use std::convert::{From, Infallible};

struct M {
    v: i64,
}

impl From<i64> for M {
    fn from(v: i64) -> M {
        M { v: v }
    }
}

fn main() {
    let m = M::from(5);
    println("{} m", m.v);
}
