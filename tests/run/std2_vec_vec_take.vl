// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::take.
// EXPECT: [1, 2] []
// RUSTC: none (vole's addition: Vec::take (Rust's mem::take))
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2], gpa);
    let w = v.take();
    println("{:?} {:?}", w, v);
}
