// EDITION: rust
// sem-own: a sink closure temporary given to a let parameter: its capture dropped once, after the call.
// XFAIL: OVERSTRICT+DIAG a sink closure literal given to a let F parameter: "expected 'let closure..', got 'closure..'", this value has no place
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn run<F: Fn() -> i64>(f: &F) -> i64 { f() }

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    println("{}", run(move || d.id));
    println("end");
}
