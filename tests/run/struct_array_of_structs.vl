// EDITION: rust
// Arrays of structs: indexed field reads and writes.
// EXPECT: 110 220 -1 440 40
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy)] struct P { x: i64, y: i32 }

fn main() -> i64 {
    let mut ps: [P; 4] = [P { x: 1, y: 10 }, P { x: 2, y: 20 }, P { x: 3, y: 30 },
        P { x: 4, y: 40 }];
    let mut i: i64 = 0;
    while i != 4 {
        ps[i as usize].x = ps[i as usize].x * 100 + ps[i as usize].y as i64;
        i += 1;
    }
    ps[2] = P { x: 0 - 1, y: 0 - 1 };
    unsafe { printf(c"%ld %ld %ld %ld %d\n", ps[0].x, ps[1].x, ps[2].x, ps[3].x, ps[3].y); }
    0
}
