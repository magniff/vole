// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::clear.
// EXPECT: 0 None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    m.clear();
    println("{} {:?}", m.len(), m.get(&1));
}
