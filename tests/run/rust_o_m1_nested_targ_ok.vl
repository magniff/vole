// (0.30.2, obligations M1) Two impls of one trait told apart only by a
// nested type argument, `Tr<Option<i32>>` needing `'a: 'static` beside
// `Tr<Option<i64>>`: the bound `T: Tr<Option<i64>>` is met by the second,
// which needs nothing. rustc accepts it.
// EXPECT: 64
trait Tr<U> { fn f(&self) -> i64; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<Option<i32>> for W<'a> { fn f(&self) -> i64 { 32 } }
impl<'a> Tr<Option<i64>> for W<'a> { fn f(&self) -> i64 { 64 } }
fn go<T: Tr<Option<i64>>>(t: &T) -> i64 { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() }; println("{}", go(&x));
}
