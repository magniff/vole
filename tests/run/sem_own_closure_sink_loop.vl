// EDITION: rust
// sem-own: a sink closure built in a loop over a value from outside moves it
// on every iteration: own.moved.
// ERROR: borrowck.borrow_immutable
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn call<F: FnMut() -> i64>(f: F) -> i64 { f() }

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    for i in 0..2 { call(move || d.id); }
}
