// a[0..=len] is out of bounds.
// EXIT: 101
// STDERR: slice range out of bounds: 0..4, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let s = &a[0..=(3 + unsafe { Z }) as usize];
    println("{}", s.len());
    println("not reached");
    0
}
