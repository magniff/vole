// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set Drain.
// EXPECT: 1 0
use std::collections::{HashSet, hash_set};
use std::collections::hash_set::Drain;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    let d: Drain<'_, i64, Gpa> = s.drain();
    let n = d.count();
    println("{} {}", n, s.len());
}
