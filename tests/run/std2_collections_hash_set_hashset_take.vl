// The std2 item(s): std::collections::hash_set HashSet::take.
// EXPECT: Some(5) None
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(5);
    let a = s.take(&5);
    println("{:?} {:?}", a, s.take(&5));
}
