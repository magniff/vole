// a view sent through a channel, its Vec dropped before the receive
// ERROR: [sync.view_item]
use std::sync::mpsc;

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<&[i64]>(gpa);
    {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        tx.send(v.as_slice()).ok().unwrap();
    }
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println("{}", rx.recv().ok().unwrap()[3]);
}
