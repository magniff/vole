// XFAIL: f301init: `let _ = d;` of an owned place is made `let _ = &d;` by front/drops.vl after_stmt, a borrow the move check reads (rustc's PlaceMention reads nothing: it accepts); 0.30.x
// RULE: M1
// (0.30.1, open) `let _ = d;` after d moved, and in a loop, is accepted by
// rustc and prints what EXPECT says.
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

fn main() {
    let d = D { v: 1 };
    take(d);
    let _ = d;
    let e = D { v: 2 };
    for _i in 0..2 {
        let _ = e;
    }
    println("end");
}
