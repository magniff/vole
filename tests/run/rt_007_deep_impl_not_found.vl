// XFAIL: RT-7: a type nested 34 deep is reported as not implementing a trait it implements (open)
// W<T>: Tr for T: Tr, and i64: Tr, so W<...34 deep...<i64>> implements
// Tr (rustc accepts it: its recursion limit is 128). vole says "the trait
// 'Tr' is not implemented for 'W<W<...'": front::traits::impl_applies
// returns -1 (does not apply) once pcx.assoc_depth reaches MAX_ASSOC_DEPTH
// (32), and the caller reports the limit as a missing impl. 33 deep checks.
// The right answer is the program's output, or an error that names the
// limit (rustc's E0275 "overflow evaluating the requirement").
// EXPECT: 35
trait Tr {
    fn go(&self) -> i64;
}

struct W<T> {
    t: T,
}

impl<T: Tr> Tr for W<T> {
    fn go(&self) -> i64 {
        self.t.go() + 1
    }
}

impl Tr for i64 {
    fn go(&self) -> i64 {
        *self
    }
}

fn main() {
    let x: W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<W<i64>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> = W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: 1i64 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } };
    println("{}", x.go());
}
