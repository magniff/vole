// RULE: D3.6
// FLAGS: --check-alloc
// (0.30.1) A mutable view given to a call is reborrowed, so the same
// view given twice is two mutable borrows at once, rustc's E0499: `f(s,
// s)` of a `&mut [T]` and of a `&mut str`. Before, the view was copied
// into each argument: f wrote through one and read a freed Vec through
// the other (--check-alloc: a use after free; 999 printed where 7 is
// right), and `two(s, s)` printed 2 at -O0 and 1 at -O2.
// ERROR: error[borrowck.mut_twice]
// ERROR: line 40, column 13
// ERROR: error[borrowck.mut_twice]
// ERROR: line 43, column 13
// ERROR: error[borrowck.mut_twice]
// ERROR: line 46, column 13
// ERROR-COUNT: 3
fn f(a: &mut [Vec<i64, Gpa>], b: &mut [Vec<i64, Gpa>], gpa: Gpa) -> i64 {
    let r: &i64 = &a[0][0];
    b[0] = Vec::new_in(gpa);
    let x = *r;
    x
}

fn two(a: &mut [i64], b: &mut [i64]) -> i64 {
    a[0] = 1;
    b[0] = 2;
    a[0]
}

fn two_str(a: &mut str, b: &mut str) -> u8 {
    a.make_ascii_uppercase();
    b.make_ascii_lowercase();
    a.as_bytes()[0]
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let mut arr = [v];
    let s: &mut [Vec<i64, Gpa>] = &mut arr;
    let x = f(s, s, gpa);
    let mut nums = [0i64, 0];
    let n: &mut [i64] = &mut nums;
    let y = two(n, n);
    let mut st = String::from_in("aB", gpa);
    let t: &mut str = st.as_mut_str();
    let z = two_str(t, t);
    println("{} {} {}", x, y, z);
}
