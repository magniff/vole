// XFAIL: RT-426c: WRONG CODE: (RT-426's family, a supertrait with arguments) `T::Out` under `T: Sub` with `trait Sub: Tr<u16>` and W's impls of Tr<u8> (Out = i64) and Tr<u16> (Out = u8), in `size_of::<T::Out>()`, takes Tr<u8>'s, the first impl by name: vole prints 8, rustc 1 (0.30.2)
// From the re-review of g302oblig M2 (its form c07_bound_super_args). Since v0.30.1 at
// least (v0.30.1 and the release build print 8).
// EXPECT: 1
trait Tr<A> {
    type Out;
}

struct W;

impl Tr<u8> for W {
    type Out = i64;
}

impl Tr<u16> for W {
    type Out = u8;
}

trait Sub: Tr<u16> {}

impl Sub for W {}

fn sz<T: Sub>() -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    println("{}", sz::<W>());
}
