// EDITION: rust
// (0.26.3, decision 6) `a - b` of i8s panics at -O0, where the overflow
// checks are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_sub_i8.vl:18:13: attempt to subtract with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i8 = id(-128) as i8;
    let b: i8 = id(1) as i8;
    println("before");
    let r = a - b;
    println("after {}", r);
}
