// RULE: F4.2
// A blanket impl over `T: Base` and an impl for `A`, which is `Base`,
// both apply to `A`: no specialization, so the pair overlaps.
// ERROR: error[trait.overlap]: conflicting impls of trait 'Show'
trait Base {}

trait Show {
    fn show(&self) -> i64;
}

struct A {
    n: i64,
}

impl Base for A {}

impl<T: Base> Show for T {
    fn show(&self) -> i64 {
        1
    }
}

impl Show for A {
    fn show(&self) -> i64 {
        self.n
    }
}

fn main() -> i64 {
    let a = A { n: 2 };
    a.show()
}
