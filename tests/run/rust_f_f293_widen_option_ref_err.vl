// (0.30.1, review 4) An i32 computed from untyped literals, kept in an
// Option and read back through `*o.as_ref().unwrap()` where an i64 is
// taken: refused (type.widen_i32), not widened after the i32 arithmetic
// (rustc types the literals i64 and prints 4000000000; before, vole
// computed 2000000000 + 2000000000 in i32). Once RT-C301-10's root fix
// types such literals from their use, this is accepted.
// (0.30.2) Accepted: each literal is typed from its use, as rustc types
// it (F18.5), and the sum is computed in i64, rustc's output.
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let o = Some(a + a);
    println("{}", take(*o.as_ref().unwrap()));
}
