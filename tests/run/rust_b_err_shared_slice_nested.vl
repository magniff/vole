// RULE: D2.7
// (0.30.1, RT-33) A `&mut [T]` behind a `&`, `s: &&mut [i64]`: its
// referent is behind the shared reference, `&mut s[..]` and `s.swap(0, 1)`
// are rustc's E0596.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '**s' as mutable, which is behind a `&` reference
// ERROR: line 11, column 18
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '**s' as mutable, which is behind a `&` reference
// ERROR: line 13, column 5
// ERROR-COUNT: 2
fn k(s: &&mut [i64]) {
    let m = &mut s[..];
    m[0] = 1;
    s.swap(0, 1);
}

fn main() {
    let mut a = [2i64, 1];
    let v: &mut [i64] = &mut a;
    k(&v);
}
