// XFAIL: RT-294: slices lack split_first_mut, split_last_mut, chunks_exact_mut, split_mut, rchunks, rchunks_exact, chunk_by, split_inclusive, splitn, rsplit and rsplitn: "no method 'rchunks' on type '&[i64]'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). Present: split_first,
// split_last, chunks, chunks_mut, chunks_exact, windows, split. The message
// names '&[i64]' for a `&mut [i64]` receiver.
// EXPECT: 30 10
// EXPECT: 2 2
// EXPECT: [[3, 1], [2, 2], [5, 4]]
// EXPECT: [[2, 5, 4], [3, 1, 2]]
// EXPECT: [[2, 2, 5, 4]]
// EXPECT: [[3], [1], [2, 2], [5], [4]]
// EXPECT: [[3, 1, 2], [2], [5, 4]]
// EXPECT: [[3, 1], [2, 5, 4]]
// EXPECT: [[5, 4], [], [3, 1]]
// EXPECT: [[5, 4], [3, 1, 2]]
fn show<'a, I: Iterator<Item = &'a [i64]>>(it: I) {
    let mut first = true;
    print("[");
    for c in it {
        if !first {
            print(", ");
        }
        first = false;
        print("{:?}", c);
    }
    println("]");
}

fn main() {
    let mut a = [3i64, 1, 2, 2, 5, 4];
    {
        let s = &mut a[..];
        if let Some((f, _)) = s.split_first_mut() {
            *f *= 10;
        }
        if let Some((l, _)) = s.split_last_mut() {
            *l = 10;
        }
        println("{} {}", s[0], s[5]);
        s[0] = 3;
        s[5] = 4;
        for c in s.chunks_exact_mut(4) {
            c[0] += 0;
        }
        let mut n = 0i64;
        for p in s.split_mut(|x| *x == 2) {
            if p.len() > 0 {
                n += 1;
            }
        }
        println("{} {}", n, s.len() / 3);
    }
    let s = &a[..];
    show(s.chunks(2));
    show(s.rchunks(3));
    show(s.rchunks_exact(4));
    show(s.chunk_by(|x, y| x == y));
    show(s.split_inclusive(|x| *x == 2));
    show(s.splitn(2, |x| *x == 2));
    show(s.rsplit(|x| *x == 2));
    show(s.rsplitn(2, |x| *x == 2));
}
