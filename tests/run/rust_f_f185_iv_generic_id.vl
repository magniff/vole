// RULE: F18.5
// (0.30.2) A generic call's argument of an integer variable binds the
// parameter to it; the result is the variable a later use types.
// EXPECT: 4000000000
fn id<T>(x: T) -> T {
    x
}

fn take(x: i64) -> i64 {
    x
}

fn main() {
    let g = id(2000000000);
    println("{}", take(g + g));
}
