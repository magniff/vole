// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::option Option::as_mut.
// EXPECT: Some(10) None
use std::option::Option;

fn main() {
    let mut a: Option<i64> = Some(3);
    if let Some(x) = a.as_mut() {
        *x = 10;
    }
    let mut b: Option<i64> = None;
    println("{:?} {:?}", a, b.as_mut());
}
