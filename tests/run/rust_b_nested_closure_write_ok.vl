// RULE: D19.2
// (0.30.1, RT-33 round 4, F1) An inner closure that writes through the
// outer one's captured `&mut` makes the outer one FnMut: kinds are
// inferred innermost first, as rustc's upvar analysis (front/closures/
// kinds.vl infer_kinds), so the inner env's unique borrow is the outer
// body's `&mut`. Before, the outer one was inferred first, `Fn`, and its
// body refused ("a captured variable in a `Fn` closure"; 0.30.0 and rustc
// accept).
// EXPECT: 1 2 3 5 1
fn main() {
    let mut x = 0i64;
    let r = &mut x;
    let mut c = || {
        let mut g = || *r += 1;
        g();
    };
    c();
    let mut c2 = || {
        let g = || *r += 1;
        let mut h = g;
        h();
    };
    c2();
    let mut c3 = || {
        let mut g = || {
            let mut h = || *r += 1;
            h();
        };
        g();
    };
    c3();
    let mut a = [1i64, 2];
    let v = &mut a[..];
    let mut c4 = || {
        let mut g = || v[0] = 5;
        g();
    };
    c4();
    let mut c5 = || {
        let mut g = || v.reverse();
        g();
    };
    c5();
    println("{} {} {} {} {}", x - 2, x - 1, x, a[1], a[0] - 1);
}
