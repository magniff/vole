// XFAIL: RT-220: (fuller form of R302D-39) a block's tail and an if's arms do not extend a borrowed temporary: `let e = { &mk(4) };`, `let f = if c { &mk(5) } else { &mk(6) };` are refused; a match's arms are extended (0.30.2)
// rustc prints the EXPECT line (twin: r302d_039b_block_tail_and_if_arms_do_not_extend.rs.txt):
// a block's tail and an if/else's blocks are extending (rustc 1.79 on). vole:
// borrowck.dropped_borrowed at lines 22 and 23 (both arms); `&mk(1)`, `&mk(2).x`,
// `&mk(3).y[1]`, the match arms, `&[mk(9).x, 10]` and `&(mk(11), 12).1` are extended.
// Since v0.28.0 (v0.29.0, v0.30.0, v0.30.1 the same).
// EXPECT: 1 2 4 4 5 7 [9, 10] 12
struct P {
    x: i64,
    y: [i64; 2],
}

fn mk(k: i64) -> P {
    P { x: k, y: [k, k + 1] }
}

fn main() {
    let c = true;
    let a = &mk(1);
    let b = &mk(2).x;
    let d = &mk(3).y[1];
    let e = { &mk(4) };
    let f = if c { &mk(5) } else { &mk(6) };
    let g = match c {
        true => &mk(7),
        false => &mk(8),
    };
    let h: &[i64] = &[mk(9).x, 10];
    let i = &(mk(11), 12).1;
    println("{} {} {} {} {} {} {:?} {}", a.x, b, d, e.x, f.x, g.x, h, i);
}
