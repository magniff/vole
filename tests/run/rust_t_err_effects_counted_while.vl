// RUSTC: none an effect declaration's error: the twin compares the borrow checker's verdicts
// RULE: E2.1
// (0.28.0, gap 85) A loop is counted only when what is written proves
// its end: an iterator set again in the body of its `while let`, a
// second write of a counted `while`'s variable, a `continue` before the
// step, a closure or a `&mut` that reaches the variable, a bound that
// can change, a step under a branch and a `chain` are loops: `diverge`.
// ERROR: 'd1' is #[effects()], but it may not terminate
// ERROR: 'd2' is #[effects()], but it may not terminate
// ERROR: 'd3' is #[effects()], but it may not terminate
// ERROR: 'd4' is #[effects()], but it may not terminate
// ERROR: 'd5' is #[effects()], but it may not terminate
// ERROR: 'd6' is #[effects()], but it may not terminate
// ERROR: 'd7' is #[effects()], but it may not terminate
// ERROR: 'd8' is #[effects()], but it may not terminate
// ERROR: 'd9' is #[effects()], but it may not terminate
// ERROR-COUNT: 9
#[effects()]
fn d1(v: &[i64]) -> i64 {
    let mut it = v.iter();
    let mut t = 0;
    while let Some(x) = it.next() {
        t += *x;
        it = v.iter();
    }
    t
}

#[effects()]
fn d2(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        i += 1;
        i -= 1;
    }
    i
}

#[effects()]
fn d3(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        if i == 3 {
            continue;
        }
        i += 1;
    }
    i
}

#[effects()]
fn d4(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let mut f = || {
            i -= 1;
        };
        f();
        i += 1;
    }
    i
}

#[effects()]
fn d5(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let p = &mut i;
        *p = 0;
        i += 1;
    }
    i
}

#[effects()]
fn d6(n: i64) -> i64 {
    let mut i = 0;
    let mut m = n;
    while i < m {
        m += 1;
        i += 1;
    }
    i
}

#[effects()]
fn d7(v: &[i64]) -> i64 {
    let mut t = 0;
    for x in v.iter().chain(v.iter()) {
        t += *x;
    }
    t
}

#[effects()]
fn d8(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        if n > 3 {
            i += 1;
        }
    }
    i
}

#[effects()]
fn d9(v: &[i64]) -> i64 {
    let mut it = v.iter();
    let mut t = 0;
    while let Some(x) = it.next() {
        t += *x;
        let again = &mut it;
        *again = v.iter();
    }
    t
}

fn main() {
    let a = [1i64, 2];
    println("{}",
        d1(&a[..0]) + d2(0) + d3(0) + d4(0) + d5(0) + d6(0) + d7(&a) + d8(0) + d9(&a[..0]));
}
