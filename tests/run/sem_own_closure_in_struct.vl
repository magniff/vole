// sem-own: a sink closure kept in a generic struct field: its capture dropped once, with the struct.
// EXPECT: 1
// EXPECT: end
// EXPECT: drop 1
// EXPECT: after
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
struct H<F> { f: F }

fn main(gpa: Gpa) {
    {
        let d = mk(1, gpa);
        let h = H { f: sink || d.id };
        println("{}", (h.f)());
        println("end");
    }
    println("after");
}
