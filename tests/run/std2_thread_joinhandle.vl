// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread JoinHandle.
// EXPECT: 3 4
use std::mem::swap;
use std::thread::{JoinHandle, self};

fn main(gpa: Gpa) {
    let a: JoinHandle<i64, Gpa> = thread::spawn_in(move || 3i64, gpa);
    let b: JoinHandle<i64, Gpa> = thread::spawn_in(move || 4i64, gpa);
    println("{} {}", a.join().unwrap(), b.join().unwrap());
}
