// XFAIL: RT-232: moving out of a Box (`let x = *b;`) is refused with borrowck.move_out; rustc builds it (0.30.2)
// EXPECT: 1
// EXPECT: drop 1
struct D { k: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.k); } }

fn main(gpa: Gpa) -> i32 {
    let b: Box<D, Gpa> = Box::new_in(D { k: 1 }, gpa);
    let x = *b;
    println("{}", x.k);
    0
}
