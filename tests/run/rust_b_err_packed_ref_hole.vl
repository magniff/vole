// RULE: D2.10, D2.9
// (0.30.1) A format argument borrows its place (D2.9), so printing a
// packed struct's unaligned field is a reference to it, rustc's E0793
// (vole's packed_ref) at the argument; so is an autoref'd method call on
// it (`cmp(&self, ..)`), not a by-value one. Copy the field out first.
// ERROR: error[borrowck.packed_ref]
// ERROR: line 19, column 19
// ERROR: error[borrowck.packed_ref]
// ERROR: line 21, column 13
// ERROR-COUNT: 2
#[repr(C, packed)]
struct P {
    a: u8,
    x: i64,
}

fn main() {
    let p = P { a: 1, x: 2 };
    println("{}", p.x);
    let c = p.x.count_ones();
    let n = p.x.cmp(&3);
    println("{c} {:?}", n);
}
