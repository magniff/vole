// (0.27.8) The derives of a unit-only Copy enum read its discriminant, as
// rustc's do: `==`, `!=`, `<` and cmp order by the written discriminants
// (`D = -3` first), Hash hashes it as an isize, Clone is `*self`. A
// unit-only enum without Copy orders and hashes by them too; an enum of
// one variant hashes nothing; an enum with fields compares the variants
// first, then the fields of the same variant.
// EXPECT: A =e--g <-nl- <-nl- >-n-g  413 A
// EXPECT: B >-n-g =e--g <-nl- >-n-g  652 B
// EXPECT: C >-n-g >-n-g =e--g >-n-g  800 C
// EXPECT: D <-nl- <-nl- <-nl- =e--g  337 D
// EXPECT: A =e >- >-  626
// EXPECT: B <- =e <-  257
// EXPECT: C <- >- =e  982
// EXPECT: true 140 A
// EXPECT: A =e <- <- <- <- <-  413 A
// EXPECT: B(1) >- =e <- <- <- <-  657 B(1)
// EXPECT: B(2) >- >- =e <- <- <-  824 B(2)
// EXPECT: C { x: 1, y: 2 } >- >- >- =e <- <-  127 C { x: 1, y: 2 }
// EXPECT: C { x: 1, y: 3 } >- >- >- >- =e <-  618 C { x: 1, y: 3 }
// EXPECT: D >- >- >- >- >- =e  626 D
// EXPECT: P { x: 1, y: 2 } true false
use std::cmp::Ordering;
use std::hash::{DefaultHasher, Hash, Hasher};

#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
enum K {
    A,
    B = 5,
    C,
    D = -3,
}

#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
enum N {
    A = 3,
    B = 1,
    C,
}

#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
enum One {
    A,
}

#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
enum M {
    A,
    B(i64),
    C { x: i64, y: i64 },
    D,
}

#[derive(Clone, Copy, PartialEq, Debug)]
struct P {
    x: i64,
    y: i64,
}

fn h<T: Hash>(t: &T) -> u64 {
    let mut s = DefaultHasher::new();
    t.hash(&mut s);
    s.finish() % 1000
}

fn ord(o: Ordering) -> &'static str {
    match o {
        Ordering::Less => "<",
        Ordering::Equal => "=",
        Ordering::Greater => ">",
    }
}

fn main(gpa: Gpa) {
    let ks = [K::A, K::B, K::C, K::D];
    for a in ks.iter() {
        let mut line = String::new_in(gpa);
        for b in ks.iter() {
            line.push_str(ord(a.cmp(b)));
            line.push_str(if a == b { "e" } else { "-" });
            line.push_str(if a != b { "n" } else { "-" });
            line.push_str(if a < b { "l" } else { "-" });
            line.push_str(if a >= b { "g " } else { "- " });
        }
        println("{:?} {} {} {:?}", a, line, h(a), a.clone());
    }
    let ns = [N::A, N::B, N::C];
    for a in ns.iter() {
        let mut line = String::new_in(gpa);
        for b in ns.iter() {
            line.push_str(ord(a.cmp(b)));
            line.push_str(if a == b { "e " } else { "- " });
        }
        println("{:?} {} {}", a, line, h(a));
    }
    println("{} {} {:?}", One::A == One::A, h(&One::A), One::A.clone());
    let ms = [M::A, M::B(1), M::B(2), M::C { x: 1, y: 2 }, M::C { x: 1, y: 3 }, M::D];
    for a in ms.iter() {
        let mut line = String::new_in(gpa);
        for b in ms.iter() {
            line.push_str(ord(a.cmp(b)));
            line.push_str(if a == b { "e " } else { "- " });
        }
        println("{:?} {} {} {:?}", a, line, h(a), a.clone());
    }
    let p = P { x: 1, y: 2 };
    let q = p.clone();
    println("{:?} {} {}", q, p == q, p != q);
}
