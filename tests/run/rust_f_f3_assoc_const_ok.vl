// EDITION: rust
// RULE: F3.2
// Associated constants: declared in a trait with or without a default,
// defined in an impl, read as `S::N` and `Self::N`.
// EXPECT: 4
// EXPECT: 10
// EXPECT: 3
trait Shape {
    const SIDES: i64;
    const SCALE: i64 = 10;

    fn sides_scaled(&self) -> i64 {
        Self::SIDES * Self::SCALE
    }
}

struct Square {
    n: i64,
}

impl Shape for Square {
    const SIDES: i64 = 4;
}

struct Tri {
    n: i64,
}

impl Shape for Tri {
    const SIDES: i64 = 3;
    const SCALE: i64 = 1;
}

fn main() -> i64 {
    let s = Square { n: 1 };
    std::print_int(Square::SIDES);
    println("");
    std::print_int(Square::SCALE);
    println("");
    let t = Tri { n: 1 };
    std::print_int(t.sides_scaled());
    println("");
    0
}
