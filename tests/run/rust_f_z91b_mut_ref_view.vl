// RULE: Z9.1b
// (0.27.3) `&mut &[u8]` and `&mut self` of an impl for `&[u8]` or `&str`
// are references to the view, its place: `*self = b` moves the caller's
// view (Z9.1b (a), (b)).
// EXPECT: 2 [3] [1, 2]
// EXPECT: [5, 6]
// EXPECT: lo
trait Take {
    fn take(&mut self, buf: &mut [u8]) -> usize;
}

impl Take for &[u8] {
    fn take(&mut self, buf: &mut [u8]) -> usize {
        let n = if buf.len() < self.len() { buf.len() } else { self.len() };
        let (a, b) = self.split_at(n);
        buf[..n].copy_from_slice(a);
        *self = b;
        n
    }
}

trait Skip {
    fn skip(&mut self, n: usize);
}

impl Skip for &str {
    fn skip(&mut self, n: usize) {
        *self = &self[n..];
    }
}

fn advance(s: &mut &[u8], n: usize) {
    *s = &s[n..];
}

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut b = [0u8; 2];
    let n = r.take(&mut b);
    println("{} {:?} {:?}", n, r, b);
    let w: &[u8] = &[4, 5, 6];
    let mut v = w;
    advance(&mut v, 1);
    println("{:?}", v);
    let mut s = "hello";
    s.skip(3);
    println("{}", s);
}
