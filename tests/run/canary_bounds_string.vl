// EXIT: 101
// EXPECT: bc
// STDERR: out of bounds
// 0.30.1, a canary of the bounds checks on a String: its bytes indexed past
// the end panic at every level.
#[inline(never)]
fn byte(s: &str, i: usize) -> u8 {
    s.as_bytes()[i]
}

fn main(gpa: Gpa) {
    let mut s = String::new_in(gpa);
    s.push_str("abc");
    println("{}", &s[1usize..3usize]);
    println("{}", byte(&s, 3 + std::env::args().count()));
}
