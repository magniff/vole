// EDITION: rust
// RULE: E2.2
// (0.28.0) std's printing ends: `#[terminates]` on the loops of the
// standard streams' write and of the text and number formatting (std's
// promise, which the checker does not prove) leaves a print `io panic`,
// with the `static` of the errno a failed write reads. A function that
// lists no `diverge` prints numbers, text, floats and Debug forms; a
// Display impl without a loop of its own keeps it so; and formatting into
// a String is `alloc(Gpa) panic`.
// CROSS: aarch64-linux x86_64-linux
use std::fmt::{Display, Formatter, Result};

#[derive(Debug, Clone, Copy)]
struct P {
    x: i64,
    y: f64,
}

impl Display for P {
    #[effects(panic)]
    fn fmt(&self, f: &mut Formatter<'_>) -> Result {
        write(f, "({}, {})", self.x, self.y)
    }
}

#[effects(io, static, panic)]
fn numbers(x: i64, y: u8, z: f64) {
    println("{x} {x:>6} {x:+} {y:#x} {y:08b} {y:o} {z} {z:.3} {z:e}");
}

#[effects(io, static, panic)]
fn text(s: &str, c: char, b: bool) {
    println("{s} {s:>5} {s:.2} {s:?} {c} {c:?} {b}");
    print("{s}|");
    if s.is_empty() {
        warn(s);
    }
}

#[effects(io, static, panic)]
fn warn(s: &str) {
    eprint("{s:?}");
    eprintln(" is empty");
}

#[effects(io, static, panic)]
fn values(p: &P, v: &[i64], o: Option<i32>, t: (i32, &str)) {
    println("{p} {p:?} {v:?} {o:?} {t:?}");
    println("{p:#?}");
}

#[effects(alloc(Gpa), panic)]
fn label(x: i64, z: f64, gpa: Gpa) -> String<Gpa> {
    format_in("{x}/{z:?}", gpa)
}

#[effects(alloc(Gpa), io, static, panic)]
fn main(gpa: Gpa) {
    numbers(-42, 200, 1.5);
    text("héllo", 'q', true);
    values(&P { x: 1, y: 0.25 }, &[1, 2], Some(3), (4, "a\tb"));
    let s = label(7, 1e21, gpa);
    println("{s}");
}
// EXPECT: -42    -42 -42 0xc8 11001000 310 1.5 1.500 1.5e0
// EXPECT: héllo héllo hé "héllo" q 'q' true
// EXPECT: héllo|(1, 0.25) P { x: 1, y: 0.25 } [1, 2] Some(3) (4, "a\tb")
// EXPECT: P {
// EXPECT:     x: 1,
// EXPECT:     y: 0.25,
// EXPECT: }
// EXPECT: 7/1e21
