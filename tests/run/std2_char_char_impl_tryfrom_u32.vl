// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char char::impl TryFrom<u32>.
// EXPECT: Ok('A') Ok('é') true
use std::char::CharTryFromError;

fn main() {
    let a: Result<char, CharTryFromError> = char::try_from(65u32);
    let b: Result<char, CharTryFromError> = char::try_from(0xE9u32);
    let c: Result<char, CharTryFromError> = char::try_from(0xDFFFu32);
    println("{:?} {:?} {}", a, b, c.is_err());
}
