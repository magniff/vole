// `return <<S as A>::Out as B>::D` and `break 'outer <S as A>::C` (v0.30.1: "expected expression, got '::'"; rustc 2 3)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: 2 3
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn r(b: bool) -> i64 {
    if b {
        return <<S as A>::Out as B>::D;
    }
    let x = 'outer: loop {
        loop {
            break 'outer <S as A>::C;
        }
    };
    x
}

fn main() {
    println("{} {}", r(true), r(false));
}
