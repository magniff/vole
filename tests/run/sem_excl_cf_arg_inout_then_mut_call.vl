// EDITION: rust
// an argument that changes the value already lent inout to an earlier argument
// ERROR: error[borrowck.mut_twice]
// ERROR: line 9, column 81
fn grow(v: &mut Vec<i64, Gpa>) -> i64 { for i in 0..100 { v.push(i); } 0 }
fn put(a: &mut i64, b: i64) { *a = b; }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(3); put(&mut v[0], grow(&mut v)); println("{}", v[0]);
}
