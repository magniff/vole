use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    thread::scope(|s| ({ let s = s; { let a = s.spawn(|| v.len()); v.push(2); a.join().unwrap() } })); println("{}", v.len());
}
