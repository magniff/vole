// RULE: F18.5
// (0.30.2) An array of a local bound to a literal and literals: its
// element type is the variable a later use types, i64 here (FL6: 0.30.1
// closed the local at i32 as an element).
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let e0 = 2000000000;
    let arr = [e0, 1, 2];
    println("{}", take(arr[0] * 2));
}
