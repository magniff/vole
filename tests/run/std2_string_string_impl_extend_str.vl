// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl Extend<&str>.
// EXPECT: abcd

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let parts = ["ab", "cd"];
    s.extend(parts.iter().copied());
    println("{}", s);
}
