// Drop order with a Drop parameter: no clause, a clause that does not read it, one that does.
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) { println("drop {}", self.v); }
}

fn a(d: D, e: D) -> i64 {
    println("body a");
    d.v + e.v
}

fn b(d: D, e: D) -> i64
    ensures { let d = 1i64; d > 0 }

{
    println("body b");
    d.v + e.v
}

fn c(d: D, e: D) -> i64
    ensures old(d.v + e.v) == result
{
    println("body c");
    d.v + e.v
}

fn m(d: D, e: D) -> i64
    requires { let e = 1i64; e > 0 }

{
    println("body m");
    let x = d;
    x.v + e.v
}

fn main() {
    println("{}", a(D { v: 1 }, D { v: 2 }));
    println("{}", b(D { v: 3 }, D { v: 4 }));
    println("{}", c(D { v: 5 }, D { v: 6 }));
    println("{}", m(D { v: 7 }, D { v: 8 }));
}
