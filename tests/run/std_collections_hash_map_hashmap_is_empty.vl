// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map HashMap::is_empty.
// EXPECT: true false
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let a = m.is_empty();
    m.insert(1, 1);
    println("{} {}", a, m.is_empty());
}
