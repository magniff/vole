// EDITION: rust
// RULE: D1.4
// (0.27.1) `&v[i]` on a std `Vec`, dead before `v.push`.
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let i: usize = 0;
    let r = &v[i];
    println("{}", *r);
    v.push(2);
    println("{}", v.len());
    0
}
// EXPECT: 1
// EXPECT: 2
