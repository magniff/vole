// (0.30.2, RT-466's family) gen0's over-aligned slots (an alignment past
// 16: the frame grows by the slot and its slack) go through the same
// checked growth: four locals of 2^60 bytes of a 4096-aligned type.
// FLAGS: --target aarch64-macos
// ERROR: frame.too_big
// ERROR: line 19, column 13
#[repr(C, align(4096))]
#[derive(Clone, Copy)]
struct Page {
    b: u8,
}

#[inline(never)]
fn pages(n: usize) -> u8 {
    if n > 5 {
        let a = [Page { b: 1 }; 1usize << 48];
        let b = [Page { b: 2 }; 1usize << 48];
        let c = [Page { b: 3 }; 1usize << 48];
        let d = [Page { b: 4 }; 1usize << 48];
        return a[n].b + b[n].b + c[n].b + d[n].b;
    }
    0
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", pages(n));
}
