// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::io Write::write.
// EXPECT: 3 [97, 98, 99]
use std::io::{BufRead, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    let n = v.write("abc".as_bytes()).unwrap();
    println("{} {:?}", n, v);
}
