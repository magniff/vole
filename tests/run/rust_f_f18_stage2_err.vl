// EDITION: rust
// RULE: F18.6, F18.2
// A `_` no check fixes by the function's end is type.infer at the `_`
// (rustc E0282); a variable a projection depends on, never fixed, is its
// call's.
// ERROR: error[type.infer]: cannot infer the type written `_` here
// ERROR: line 11, column 16
// ERROR: error[type.infer]: cannot infer type parameter 'F' of 'str::parse'
// ERROR-COUNT: 2
fn hole(gpa: Gpa) {
    let v: Vec<_, Gpa> = Vec::new_in(gpa);
    println("{}", v.len());
}

fn parsed() {
    let x = "4".parse().unwrap();
}

fn main(gpa: Gpa) {
    hole(gpa);
    parsed();
}
