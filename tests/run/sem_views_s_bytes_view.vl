// XFAIL: gap 17: compile distinct.mix: 'w.as_bytes()' is '[u8]' where 'str' goes
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(v).len()`; s grows while it is used
// EXPECT: 11
fn f(l: &Vec<&str, Gpa>) -> &str { l[0] }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa); v.push(w.as_bytes());
    let r = f(&v).len();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
