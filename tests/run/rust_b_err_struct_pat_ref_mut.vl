// RULE: F27.2
// (0.27.2) A `ref mut` binding of a field in a struct pattern excludes
// writes to that field while it lives (rustc E0506).
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 19, column 5
// ERROR-COUNT: 1
struct Tok {
    v: i64,
}

struct Two {
    a: Tok,
    n: i64,
}

fn main() {
    let mut t = Two { a: Tok { v: 1 }, n: 3 };
    let Two { ref mut n, .. } = t;
    t.n = 5;
    *n += 1;
    println("{}", t.a.v);
}
