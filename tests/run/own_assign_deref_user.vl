// 0.30: an assignment through a type's own DerefMut (`*w = v` is
// `*w.deref_mut() = v`) and through its IndexMut (`a[i] = v` is
// `*a.index_mut(i) = v`) drops the value that was there: after the right
// side, before the write, once (0.29 leaked it). `*w`, `**w` of a wrapper
// in a wrapper and in a Box, a field through the wrapper, an index
// through DerefMut and then IndexMut, a function generic over DerefMut.
// FLAGS: --check-alloc
// EXPECT: whole
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: d1
// EXPECT: --
// EXPECT: d2
// EXPECT: nested
// EXPECT: mk3
// EXPECT: mk4
// EXPECT: d3
// EXPECT: --
// EXPECT: mk5
// EXPECT: mk6
// EXPECT: d5
// EXPECT: --
// EXPECT: mk7
// EXPECT: mk8
// EXPECT: d7
// EXPECT: --
// EXPECT: d8
// EXPECT: d6
// EXPECT: d4
// EXPECT: field
// EXPECT: mk9
// EXPECT: mk10
// EXPECT: d9
// EXPECT: --
// EXPECT: mk11
// EXPECT: d10
// EXPECT: --
// EXPECT: d11
// EXPECT: index
// EXPECT: mk12
// EXPECT: mk13
// EXPECT: mk14
// EXPECT: d13
// EXPECT: --
// EXPECT: mk15
// EXPECT: mk16
// EXPECT: mk17
// EXPECT: d15
// EXPECT: --
// EXPECT: d17
// EXPECT: d16
// EXPECT: d12
// EXPECT: d14
// EXPECT: generic
// EXPECT: mk18
// EXPECT: mk19
// EXPECT: d18
// EXPECT: mk20
// EXPECT: mk21
// EXPECT: d20
// EXPECT: --
// EXPECT: d21
// EXPECT: d19
// EXPECT: end
use std::ops::{Deref, DerefMut, Index, IndexMut};

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

struct W<X> { t: X }

impl<X> Deref for W<X> {
    type Target = X;
    fn deref(&self) -> &X { &self.t }
}

impl<X> DerefMut for W<X> {
    fn deref_mut(&mut self) -> &mut X { &mut self.t }
}

struct H { f: T, n: i64 }

struct A { a: [T; 2] }

impl Index<usize> for A {
    type Output = T;
    fn index(&self, i: usize) -> &T { &self.a[i] }
}

impl IndexMut<usize> for A {
    fn index_mut(&mut self, i: usize) -> &mut T { &mut self.a[i] }
}

fn set<D: DerefMut<Target = T>>(d: &mut D, v: T) { **d = v; }

fn main(gpa: Gpa) -> i32 {
    println("whole");
    {
        let mut w = W { t: mk(1) };
        *w = mk(2);
        println("--");
    }
    println("nested");
    {
        let mut w = W { t: W { t: mk(3) } };
        **w = mk(4);
        println("--");
        let mut b = Box::new_in(W { t: mk(5) }, gpa);
        **b = mk(6);
        println("--");
        let mut x = W { t: Box::new_in(mk(7), gpa) };
        **x = mk(8);
        println("--");
    }
    println("field");
    {
        let mut w = W { t: H { f: mk(9), n: 0 } };
        (*w).f = mk(10);
        println("--");
        w.f = mk(11);
        w.n = 1;
        println("--");
    }
    println("index");
    {
        let mut a = A { a: [mk(12), mk(13)] };
        a[1] = mk(14);
        println("--");
        let mut w = W { t: A { a: [mk(15), mk(16)] } };
        w[0] = mk(17);
        println("--");
    }
    println("generic");
    {
        let mut w = W { t: mk(18) };
        set(&mut w, mk(19));
        let mut b = Box::new_in(mk(20), gpa);
        set(&mut b, mk(21));
        println("--");
    }
    println("end");
    0
}
