// ERROR: the bound 'Self: Conv<i64>' of 'f' is not met
// (RT-269) an impl's `where Self: Conv<i64>` at a method call on the concrete type (rustc E0599; v0.30.1 accepted it).
trait Conv<X> {}

trait Tr {
    fn f(&self) -> i64;
}

struct W<U> {
    r: U,
}

impl<U> Tr for W<U>
    where
        Self: Conv<i64>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn main() {
    let w = W { r: 0 };
    println("{}", w.f());
}
