// RULE: F30.5
// (0.29) `*const T` and `*mut T` are two types, with Rust's rules: a
// `*mut T` coerces to a `*const T` (a `let`, an argument, a generic
// one, a field, a result, the right side of `==`), `as` casts either
// way, a `&T` coerces to `*const T` and a `&mut T` to both. The methods
// keep the pointer's kind (`add`), `cast_mut` and `cast_const` change
// it, and a `*mut T` is written through.
// EXPECT: 14 7 9
// EXPECT: true true false
// EXPECT: 11 22 3
fn read(p: *const i64) -> i64 {
    // UNSAFE: reads through the caller's pointer.
    // SAFETY: every caller below gives a pointer to a live i64.
    unsafe { *p }
}

fn put(p: *mut i64, v: i64) {
    // UNSAFE: writes through the caller's pointer.
    // SAFETY: every caller below gives a pointer to a live i64 of its own.
    unsafe {
        *p = v;
    }
}

fn same<T>(p: *const T) -> *const T {
    p
}

fn weaken(p: *mut i64) -> *const i64 {
    p
}

struct Pair {
    r: *const i64,
    w: *mut i64,
}

fn main() {
    let mut x: i64 = 5;
    let m: *mut i64 = &mut x;
    let c: *const i64 = m;
    put(m, 7);
    let sum = read(m) + read(c);
    let g: *const i64 = same(m);
    let back = c as *mut i64;
    let seven = read(g);
    put(back, 9);
    println("{} {} {}", sum, seven, read(weaken(m)));
    let p = Pair { r: m, w: m };
    println("{} {} {}", c == m, p.r == p.w, m.is_null() || c.is_null());
    // UNSAFE: pointer arithmetic and reads and writes through m and c.
    // SAFETY: both point to x; `add(0)` stays on it; nothing else
    // reads x while it is written.
    unsafe {
        let w: *mut i64 = m.add(0);
        let r: *const i64 = c.add(0);
        w.write(11);
        let a = r.read();
        c.cast_mut().write(22);
        let b = m.cast_const().read();
        *p.w = 3;
        println("{} {} {}", a, b, *p.r);
    }
}
