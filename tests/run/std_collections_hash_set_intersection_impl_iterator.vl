// Runs on std since its arrays' by-value IntoIterator (0.27.3).
// The std item(s): std::collections::hash_set Intersection::impl Iterator.
// EXPECT: Some(2) None
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa, FixedState> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa, FixedState> = [2i64].into_iter().collect_in(gpa);
    let mut i = a.intersection(&b);
    let x = i.next();
    println("{:?} {:?}", x, i.next());
}
