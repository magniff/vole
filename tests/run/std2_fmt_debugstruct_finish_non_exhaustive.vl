// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt DebugStruct::finish_non_exhaustive.
// EXPECT: B { a: 1, .. }
// EXPECT: B {
// EXPECT:     a: 1,
// EXPECT:     ..
// EXPECT: }
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("B").field("a", &self.a).finish_non_exhaustive()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
