// RULE: D9.1
// (0.27.2) std's containers drop what they hold: a Vec of a user type
// drops its elements in order at its scope's end, after the locals
// declared after it; a String frees.
struct D {
    id: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main(gpa: Gpa) {
    {
        let mut v: Vec<D, Gpa> = Vec::new_in(gpa);
        v.push(D { id: 1 });
        v.push(D { id: 2 });
        v.push(D { id: 3 });
        let _d = D { id: 4 };
        let mut s: String<Gpa> = String::new_in(gpa);
        s.push_str("abc");
        println("{} {}", s.len(), v.len());
    }
    println("end");
}
// EXPECT: 3 3
// EXPECT: drop 4
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: end
