// XFAIL: RT-30: a string literal pattern is refused: "expected a pattern, got 'string literal'" (open)
// `match cmd { "add" => .., "sub" => .., _ => .. }` on a `&str` is Rust
// (rustc prints the EXPECT lines); vole's parser refuses the arm, and
// the guide's list of what differs from Rust does not say so.
// EXPECT: 3 -1 0
fn apply(cmd: &str, a: i64, b: i64) -> i64 {
    match cmd {
        "add" => a + b,
        "sub" => a - b,
        _ => 0,
    }
}

fn main() {
    println("{} {} {}", apply("add", 1, 2), apply("sub", 1, 2), apply("mul", 1, 2));
}
