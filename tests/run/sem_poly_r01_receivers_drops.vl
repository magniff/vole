// EDITION: rust
// trait methods with each receiver: let reads, inout changes, sink consumes (dropped inside once)
// FLAGS: --check-alloc
// EXPECT: 2
// EXPECT: drop 2
// EXPECT: 20
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

trait T3 {
    fn get(&self) -> i64;
    fn bump(&mut self);
    fn eat(self) -> i64;
}

impl T3 for R {
    fn get(&self) -> i64 { self.id }
    fn bump(&mut self) { self.id += 1; }
    fn eat(self) -> i64 { self.id * 10 }
}

fn main() {
    let mut r = R { id: 1 };
    r.bump();
    println("{}", r.get());
    println("{}", r.eat());
    println("end");
}
