// From the review of g302bor2 (form B/b19). Since v0.30.1 at least; the
// release build the same. rustc E0505 at the drop (the rustc twin of this file): C is
// `&Vec<String>`, so the Item is `&String`, a borrow of v. vole builds it,
// and --check-alloc reports a use after free of v's buffer, freed at the
// drop. The region in the projection belongs to C, not to the elided
// lifetime of the result. Sub-forms: rt_387b (`<I as Iterator>::Item`),
// rt_387c (`<T as Tr<i64>>::Out`, a trait with an argument, E0597),
// rt_387d (`I::Item` of a Zip), rt_387e (`I::Item` of an Enumerate).
// RT-389 is the same reading with no reference parameter: it is refused
// there as borrowck.elision, where rustc accepts.
// FLAGS: --check-alloc
// ERROR: line 23
fn first<C: IntoIterator>(c: C, k: &i64) -> Option<<C as IntoIterator>::Item> {
    let _ = k;
    c.into_iter().next()
}

fn main(gpa: Gpa) {
    let k = 5i64;
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello heap string long", gpa));
    let p = first(&v, &k);
    drop(v);
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{:?} {}", p, other.len());
}
