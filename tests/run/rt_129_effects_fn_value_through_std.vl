// XFAIL: RT-129: a fn item or fn pointer passed as F to a std function declared #[effects(F)] brings none of its effects: #[no_io] and #[pure] functions print (0.30.2)
// Each t_ below is #[no_io] (t4 #[pure]) and prints through `noisy`
// when run (`io 3`); vole accepts all four (`ok: 0 errors`). The same call
// with a closure, `Some(x).map(|y| noisy(y))`, is refused (`'t' is
// #[no_io], but it does io`), as is a user generic `#[effects(F)] fn
// ap<F: Fn(i64) -> i64>` given `noisy` or a fn pointer. Option::map,
// Option::map_or, Option::unwrap_or_else and Result::unwrap_or_else are
// all `#[effects(F)]`: F's effects are substituted from its type, and a
// fn item's or a fn pointer's type contributes nothing; a closure whose
// body calls a fn pointer parameter (t4) is the same. Since 0.28.0 at
// least.
// ERROR: error[effect]: 't1' is #[no_io], but it does io
// ERROR: error[effect]: 't2' is #[no_io], but it does io
// ERROR: error[effect]: 't3' is #[no_io], but it does io
// ERROR: error[effect]: 't4' is #[pure], but it does io
// ERROR-COUNT: 4
fn noisy(x: i64) -> i64 {
    println("io {}", x);
    x
}

#[no_io]
fn t1(x: i64) -> i64 {
    Some(x).map(noisy).unwrap_or(0)
}

#[no_io]
fn t2(x: i64) -> i64 {
    let f: fn(i64) -> i64 = noisy;
    Some(x).map_or(0, f)
}

#[no_io]
fn t3(x: i64) -> i64 {
    let r: Result<i64, i64> = Err(x);
    r.unwrap_or_else(noisy)
}

#[pure]
fn t4(x: i64) -> i64 {
    let o: Option<fn(i64) -> i64> = Some(noisy);
    o.map(|f| f(x)).unwrap_or(0)
}

fn main() {
    println("{} {} {} {}", t1(3), t2(3), t3(3), t4(3));
}
