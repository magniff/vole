// (0.27.1) An elided result region with no input to take it from (E4,
// docs/design/borrowck.md D4.2): error borrowck.elision at the signature
// (rustc E0106); E2 (one input region) and E3 (`&self`) are no error.
// RULE: D4.2
// XFAIL: L2 (no rvalue static promotion until 0.27.3): `fn make() -> &'static i64 { &5 }` returns a temporary, borrowck.return_local
// ERROR: error[borrowck.elision]: the result of 'longer' borrows, but from which parameter is not said
// ERROR: error[borrowck.elision]: the result of 'make2' borrows
// ERROR-COUNT: 2

struct S {
    n: i64,
}

impl S {
    fn get(&self, other: &i64) -> &i64 {
        if *other > 0 { &self.n } else { &self.n }
    }
}

fn longer(x: &i64, y: &i64) -> &i64 {
    if *x > *y { x } else { y }
}

fn make() -> &'static i64 {
    &5
}

fn make2() -> &i64 {
    &5
}

fn one(x: &i64, y: i64) -> &i64 {
    x
}

fn main() -> i32 {
    let s = S { n: 1 };
    println("{} {} {} {}", *longer(&1, &2), *make(), *one(&3, 4), *s.get(&1));
    let _ = make2();
    0
}
