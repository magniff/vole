// main.missing). The error should name main's generic parameter, as
// main.signature names a wrong parameter.
// ERROR: generic parameters
// ERROR: rt_502_main_type_parameter.vl: line 8,
// ERROR-COUNT: 1
fn main<T>() {
    println("hi");
}
