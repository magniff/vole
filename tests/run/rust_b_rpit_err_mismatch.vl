// RUSTC-EDITION: 2024
// RULE: D21.2
// (0.27.2.1) Every `return` and the tail are one hidden type (rustc E0308).
// ERROR: error[opaque.mismatch]
// ERROR: line 32, column 5
trait Shape {
    fn area(&self) -> i32;
}

struct Sq {
    s: i32,
}

struct Rect {
    w: i32,
    h: i32,
}

impl Shape for Sq {
    fn area(&self) -> i32 { self.s * self.s }
}

impl Shape for Rect {
    fn area(&self) -> i32 { self.w * self.h }
}

fn make(square: bool) -> impl Shape {
    if square {
        return Sq { s: 2 };
    }
    Rect { w: 2, h: 3 }
}

fn main() {
    println("{}", make(true).area());
}
