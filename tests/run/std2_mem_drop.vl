// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::mem drop.
// EXPECT: drop 1
// EXPECT: after
use std::mem::drop;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main() {
    let d = D { n: 1 };
    drop(d);
    println("after");
}
