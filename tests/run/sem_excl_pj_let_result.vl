// EDITION: rust
// a let projection keeps a shared loan: writing the source while it is used is a conflict
// ERROR: error[borrowck.conflict]
use std::alloc::Allocator;

struct S<A: Allocator> { a: Vec<i64, A> }
fn first(s: &S<Gpa>) -> &Vec<i64, Gpa> { &s.a }

fn main(gpa: Gpa) {
    let mut s = S { a: Vec::new_in(gpa) }; let r = first(&s); s.a.push(1); println("{}", r.len());
}
