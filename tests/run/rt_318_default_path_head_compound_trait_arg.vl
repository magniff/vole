// XFAIL: RT-318: a generic trait's default calling `T::make()` with T an impl argument that is not a bare name (`impl G<Option<u8>> for W`) is refused: unknown type 'T' (0.30.2)
// From g302tparam; v0.30.1 too. A path head naming a trait parameter is
// substituted only when the argument is a bare name (traits::
// subst_trait_args, F12.1). rustc prints 7.
// EXPECT: 7
trait Make {
    fn make() -> Self;
    fn n(&self) -> usize;
}

impl Make for Option<u8> {
    fn make() -> Option<u8> {
        Some(7u8)
    }

    fn n(&self) -> usize {
        match self {
            Some(v) => *v as usize,
            None => 0,
        }
    }
}

trait G<T: Make> {
    fn g(&self) -> usize {
        T::make().n()
    }
}

struct W;

impl G<Option<u8>> for W {}

fn main() {
    println("{}", W.g());
}
