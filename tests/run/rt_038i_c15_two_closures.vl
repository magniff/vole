// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c15_two_closures)
// RUSTC: none contract clauses are not Rust
// ERROR: 's' is used here after it moved
// a closure parameter shadows, a capture of the real parameter in a second closure (not moved): builds.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures {
    let a = [1i64, 2];
    let g = |s: i64| s > 0;
    let h = || s.v;
    g(a[0]) && h() == 4
}

{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
