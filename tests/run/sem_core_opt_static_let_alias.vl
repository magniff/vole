// EDITION: rust
// A let parameter is a value independent of the static it was read from:
// the callee changing the static does not change it.
// EXPECT: 1001
// EXPECT: 99
#[derive(Clone, Copy)] struct Big { a: i64, b: i64, c: i64, d: i64 }

static mut G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn f(s: Big) -> i64 {
    let before = s.a;
    unsafe { G.a = 99; }
    before * 1000 + s.a
}

fn main() -> i32 {
    println("{}", f(unsafe { G }));
    println("{}", unsafe { G.a });
    0
}
