// Runs on std since 0.27.2's switch.
// The std item(s): std::iter Iterator::any.
// EXPECT: true false false

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{} {} {}", v.iter().any(|x| *x > 3), v.iter().any(|x| *x > 4),
        e.iter().any(|x| *x > 1));
}
