// EDITION: rust
// RULE: F14.1
// An impl of a template with a parameter its self type does not fix,
// `impl<T: Eqq<U>, U> Eqq<W<U>> for W<T>` (std2's `impl<T: PartialEq<U>,
// U> PartialEq<[U]> for [T]`): U is bound from the call's argument, and
// T's bound naming U is checked once both are known (was a compiler
// crash: the impl was bound by position, past W's one argument).
// EXPECT: false true
trait Eqq<R> {
    fn eqq(&self, r: &R) -> bool;
}

impl Eqq<i64> for i64 {
    fn eqq(&self, r: &i64) -> bool {
        *self == *r
    }
}

struct W<T> {
    t: T,
}

impl<T: Eqq<U>, U> Eqq<W<U>> for W<T> {
    fn eqq(&self, r: &W<U>) -> bool {
        self.t.eqq(&r.t)
    }
}

fn main() {
    let a = W { t: 1i64 };
    let b = W { t: 2i64 };
    println("{} {}", a.eqq(&b), a.eqq(&a));
}
// ENV: VOLE_STD2=0
