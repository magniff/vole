// EDITION: rust
// RULE: D19.5
// (0.27.2) An `Fn` closure called as the `FnOnce` its parameter is bound by:
// the call moves it into a temporary the env borrows, dropped after the
// call (rustc's `call_once` of an `Fn` closure), so its capture is dropped
// before `called`.
// EXPECT: drop 7
// EXPECT: called
// EXPECT: 14
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn once<F: FnOnce() -> i64>(f: F) -> i64 {
    let r = f();
    println("called");
    r
}

fn main() {
    let d = D { v: 7 };
    let c = move || d.v * 2;
    let k = once(c);
    println("{}", k);
}
