// Hash is #[pure]: an impl reading a static var is rejected.
// ERROR: 'K::hash' implements 'Hash::hash', which is #[pure], but it touches a static mut or a C static (static)
use std::hash::{Hash, Hasher}; use std::collections::HashMap; static mut SEED: u64 = 1;
#[derive(Clone, Copy)] struct K { n: i64 }

impl Hash for K {
    fn hash<H: Hasher>(&self, state: &mut H) { ((unsafe { SEED }) + self.n as u64).hash(state) }
}

impl PartialEq for K { fn eq(&self, o: &K) -> bool { self.n == o.n } } impl Eq for K {}

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<K, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(K { n: 1 }, 2);
    println("{}", m.len());
    0
}
