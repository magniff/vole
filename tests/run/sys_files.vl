// FLAGS: --check-alloc
// EXPECT: wrote 12 size 12 file true dir false
// EXPECT: pread world pos 12 end 12
// EXPECT: pwrite hello WORLD truncated 5 fsync ok
// EXPECT: renamed true old gone NotFound
// EXPECT: lstat dir true
// EXPECT: entries . .. a.txt b.txt sub
// EXPECT: kinds file file dir
// EXPECT: cwd ends in dir true back true
// EXPECT: mkdir again AlreadyExists rmdir full DirectoryNotEmpty
// EXPECT: nul InvalidInput long InvalidInput
// EXPECT: removed true
// EXPECT: dup2 ok isatty false
// 0.20 (A7): std's OS layer on files and directories: open, read, write,
// pread, pwrite, lseek, ftruncate, fsync, fstat, stat, lstat, rename,
// unlink, mkdir, rmdir, opendir/readdir_into/closedir, getcwd, chdir, and
// the errors as errno kinds, in a fresh directory under /tmp.
use std::sys::FileStat; use std::sys::SYS_DT_DIR; use std::sys::SYS_DT_REG;
use std::sys::SYS_DT_UNKNOWN; use std::sys::SYS_O_CREAT; use std::sys::SYS_O_RDONLY;
use std::sys::SYS_O_RDWR; use std::sys::SYS_O_TRUNC; use std::sys::SYS_O_WRONLY;
use std::sys::SYS_SEEK_CUR; use std::sys::SYS_SEEK_END; use std::sys::SysErrorKind;
use std::sys::sys_chdir; use std::sys::sys_close; use std::sys::sys_closedir; use std::sys::sys_dup;
use std::sys::sys_dup2; use std::sys::sys_errno_kind; use std::sys::sys_fstat;
use std::sys::sys_fsync; use std::sys::sys_ftruncate; use std::sys::sys_getcwd_into;
use std::sys::sys_getpid; use std::sys::sys_isatty; use std::sys::sys_lseek;
use std::sys::sys_lstat; use std::sys::sys_mkdir; use std::sys::sys_open; use std::sys::sys_opendir;
use std::sys::sys_pread; use std::sys::sys_pwrite; use std::sys::sys_readdir_into;
use std::sys::sys_rename; use std::sys::sys_rmdir; use std::sys::sys_stat; use std::sys::sys_unlink;
use std::sys::sys_write;

fn kind(r: Result<(), i32>) -> SysErrorKind {
    match r {
        Ok(()) => SysErrorKind::Other,
        Err(e) => sys_errno_kind(e),
    }
}

fn kind_name(k: SysErrorKind) -> &'static [u8] {
    match k {
        SysErrorKind::NotFound => b"NotFound",
        SysErrorKind::AlreadyExists => b"AlreadyExists",
        SysErrorKind::DirectoryNotEmpty => b"DirectoryNotEmpty",
        SysErrorKind::InvalidInput => b"InvalidInput",
        _ => b"other",
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut dir = String::new_in(gpa);
    dir.push_str("/tmp/vole_sys_files_");
    std::fmt::write(&mut dir, (sys_getpid() as i64)).unwrap();
    let d = dir.as_bytes();
    sys_mkdir(d, 0x1edi32).unwrap();
    let mut pa = Vec::<u8, Gpa>::new_in(gpa);
    pa.extend_from_slice(d);
    pa.extend_from_slice(b"/a.txt");
    let a = pa.as_slice();

    let fd = sys_open(a, SYS_O_RDWR | SYS_O_CREAT | SYS_O_TRUNC, 0x1a4i32).unwrap();
    let n = sys_write(fd, "hello world\n").unwrap();
    let st = sys_fstat(fd).unwrap();
    println("wrote {n} size {} file {} dir {}", st.size, st.is_file(), st.is_dir());

    let mut buf = [0u8; 32];
    let k = sys_pread(fd, &mut buf[0..5], 6).unwrap();
    let pos = sys_lseek(fd, 0, SYS_SEEK_CUR).unwrap();
    let end = sys_lseek(fd, 0, SYS_SEEK_END).unwrap();
    println("pread {} pos {pos} end {end}", &str::from_utf8(buf[0..k as usize]).unwrap());

    sys_pwrite(fd, "WORLD", 6).unwrap();
    let k2 = sys_pread(fd, &mut buf[..], 0).unwrap();
    print("pwrite {}", &str::from_utf8(buf[0..(k2 - 1) as usize]).unwrap());
    sys_ftruncate(fd, 5).unwrap();
    let st2 = sys_fstat(fd).unwrap();
    sys_fsync(fd).unwrap();
    println(" truncated {} fsync ok", st2.size);
    sys_close(fd).unwrap();

    let mut pb = Vec::<u8, Gpa>::new_in(gpa);
    pb.extend_from_slice(d);
    pb.extend_from_slice(b"/b.txt");
    let b = pb.as_slice();
    sys_rename(a, b).unwrap();
    let st3 = sys_stat(b).unwrap();
    println("renamed {} old gone {}", st3.size == 5,
        str::from_utf8(kind_name(kind(sys_stat(a).map_unit()))).unwrap());
    let fd2 = sys_open(a, SYS_O_WRONLY | SYS_O_CREAT, 0x1a4i32).unwrap();
    sys_close(fd2).unwrap();

    let mut ps = Vec::<u8, Gpa>::new_in(gpa);
    ps.extend_from_slice(d);
    ps.extend_from_slice(b"/sub");
    let sub = ps.as_slice();
    sys_mkdir(sub, 0x1edi32).unwrap();
    println("lstat dir {}", sys_lstat(sub).unwrap().is_dir());

    // the entries, sorted by name
    let mut names: Vec<Vec<u8, Gpa>, Gpa> = Vec::new_in(gpa);
    let mut dh = sys_opendir(d).unwrap();
    let mut name = [0u8; 256];
    let mut kinds = Vec::<u8, Gpa>::new_in(gpa);
    for _ in 0..100 {
        match sys_readdir_into(&mut dh, &mut name).unwrap() {
            None => break,
            Some(e) => {
                let mut nb = Vec::<u8, Gpa>::new_in(gpa);
                nb.extend_from_slice(&name[0..e.name_len as usize]);
                if e.kind != SYS_DT_UNKNOWN && name[0] != b'.' {
                    let ks = if e.kind == SYS_DT_DIR { "dir" }
                        else if e.kind == SYS_DT_REG { "file" } else { "?" };
                    nb.push(b' ');
                    nb.extend_from_slice(ks.as_bytes());
                }
                names.push(nb);
            }
        }
    }
    sys_closedir(&mut dh).unwrap();
    names.sort_unstable_by(|a, b| a.as_slice().cmp(b.as_slice()));
    print("entries");
    for i in 0..names.len() {
        let s = names[i].as_slice();
        let mut j: i64 = 0;
        for c in 0..s.len() {
            if s[c] == b' ' { break; }
            j += 1;
        }
        print(" {}", &str::from_utf8(s[0..j as usize]).unwrap());
        if j < s.len() as i64 {
            kinds.push(b' ');
            kinds.extend_from_slice(&s[(j + 1) as usize..s.len()]);
        }
    }
    println("");
    println("kinds{}", str::from_utf8(kinds.as_slice()).unwrap());
    for i in 0..names.len() { { names[i].clear(); names[i].shrink_to_fit(); }; }
    drop(names);

    let mut cwd = [0u8; 4096];
    let old_len = sys_getcwd_into(&mut cwd[..]).unwrap();
    let mut old = Vec::<u8, Gpa>::new_in(gpa);
    old.extend_from_slice(&cwd[0..old_len as usize]);
    sys_chdir(sub).unwrap();
    let nl = sys_getcwd_into(&mut cwd[..]).unwrap();
    let here = &cwd[0..nl as usize];
    let ends = nl >= 4 && here[(nl - 4) as usize..nl as usize] == b"/sub";
    sys_chdir(old.as_slice()).unwrap();
    let back = sys_getcwd_into(&mut cwd[..]).unwrap();
    println("cwd ends in dir {ends} back {}", &cwd[0..back as usize] == old.as_slice());

    println(
        "mkdir again {} rmdir full {}",
        str::from_utf8(kind_name(kind(sys_mkdir(sub, 0x1edi32)))).unwrap(),
        str::from_utf8(kind_name(kind(sys_rmdir(d)))).unwrap());
    let long = [b'a'; 5000];
    println(
        "nul {} long {}", str::from_utf8(kind_name(kind(sys_unlink("/tmp/x\x00y")))).unwrap(),
        str::from_utf8(kind_name(kind(sys_unlink(&long[..])))).unwrap());

    sys_unlink(a).unwrap();
    sys_unlink(b).unwrap();
    sys_rmdir(sub).unwrap();
    sys_rmdir(d).unwrap();
    println("removed {}", kind(sys_stat(d).map_unit()) == SysErrorKind::NotFound);

    let fd3 = sys_open("/dev/null", SYS_O_RDONLY, 0i32).unwrap();
    let fd4 = sys_dup(fd3).unwrap();
    let r = sys_dup2(fd3, fd4).unwrap();
    println("dup2 {} isatty {}", if r == fd4 { "ok" } else { "bad" }, sys_isatty(fd3));
    sys_close(fd3).unwrap();
    sys_close(fd4).unwrap();
    0
}

trait MapUnit { fn map_unit(&self) -> Result<(), i32>; }

impl MapUnit for Result<FileStat, i32> {
    fn map_unit(&self) -> Result<(), i32> {
        match self {
            Ok(_) => Ok(()),
            Err(e) => Err(e),
        }
    }
}
