// Fixed in 0.30.2: RT-494: a method of Tr0 through a 9-deep supertrait chain with a type argument (`trait Tr9<X>: Tr8<X>` .. `trait Tr1<X>: Tr0<X>`): `need::<u8, X>(x)` in `fn k<X: Tr9<u8>>(x: &X)`, where need calls `u.top()` under `U: Tr0<Z>`, is refused in the instance, "no method 'top' on type parameter 'X'" (generic.unbounded_use); 8 levels are accepted; rustc builds it and prints x (0.30.2)
// From the review of g302elab. Since v0.30.1 at least.
// From the review's form pre/chain9_method_refused. RT-360 is a 34-deep
// chain without type arguments; RT-436g an impl's supertrait walk.
// EXPECT: x
trait Tr0<X> {
    fn top(&self) -> i64;
}

trait Tr1<X>: Tr0<X> {}

trait Tr2<X>: Tr1<X> {}

trait Tr3<X>: Tr2<X> {}

trait Tr4<X>: Tr3<X> {}

trait Tr5<X>: Tr4<X> {}

trait Tr6<X>: Tr5<X> {}

trait Tr7<X>: Tr6<X> {}

trait Tr8<X>: Tr7<X> {}

trait Tr9<X>: Tr8<X> {}

fn need<Z, U: Tr0<Z>>(u: &U) -> i64 {
    u.top()
}

fn k<X: Tr9<u8>>(x: &X) -> i64 {
    need::<u8, X>(x)
}

fn main() {
    println("x");
}
