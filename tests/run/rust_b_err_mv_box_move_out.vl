// RULE: D3.8
// (0.27.1) R8: moving out of `*b` for a `Box` is a move out of a deref (no
// `DerefMove` in 0.27.1); rustc allows it for `Box`.
// RUSTC: accepts R8 rustc moves out of a Box
// ERROR: error[borrowck.move_out]
// ERROR: line 16, column 13
// ERROR-COUNT: 1
// XFAIL: bc271 M3; and the rust edition has no `Box` until std2 (0.27.2)

struct N {
    v: i64,
}

fn main() {
    let b = Box::new(N { v: 1 });
    let n = *b;
    println("{}", n.v);
}
