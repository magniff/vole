// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Arena::scope; std::alloc arena_scope.
// EXPECT: 3 true
// EXPECT: 8 16 8
use std::alloc::{Arena, arena_scope};

fn main(gpa: Gpa) {
    let n = arena_scope(&gpa, |sc| {
        let v = Vec::from_in([1, 2, 3], sc);
        v.len()
    });
    println("{} {}", n, gpa.check_leaks());
    let arena = Arena::new_in(gpa);
    arena.alloc(1i64);
    let inner = arena.scope(|sc| {
        sc.alloc(2i64);
        sc.alloc(3i64);
        sc.used()
    });
    println("{} {} {}", 8, inner, arena.used());
}
