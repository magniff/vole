// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string String::impl PartialEq<String<B>>.
// EXPECT: true false

fn main(gpa: Gpa) {
    let a = String::from_in("abc", gpa);
    let b = String::from_in("abc", gpa);
    let c = String::from_in("abd", gpa);
    println("{} {}", a == b, a == c);
}
