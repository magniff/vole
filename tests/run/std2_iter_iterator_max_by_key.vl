// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::max_by_key.
// EXPECT: Some(-5) Some(3)

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, -5, 3], gpa);
    let w = Vec::from_in([3i64, -3], gpa);
    println("{:?} {:?}", v.iter().max_by_key(|x| x.abs()),
        w.iter().max_by_key(|x| x.abs()).map(|x| x.abs()));
}
