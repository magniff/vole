// (0.30.1) A struct of two structs that fit, 2^60 bytes each, is 2^61:
// refused at its declaration, the inner one accepted.
// ERROR: values of the type 'Outer' are too big
// ERROR-COUNT: 1
struct Half {
    x: [u8; 1usize << 59],
    y: [u8; 1usize << 59],
}

struct Outer {
    a: Half,
    b: Half,
}

fn main() {
    println("{} {}", std::mem::size_of::<Half>(), std::mem::size_of::<Outer>());
}
