// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str SplitWhitespace::impl DoubleEndedIterator.
// EXPECT: Some("c") Some("a") Some("b") None
use std::str::CharIndices;

fn main() {
    let mut it = " a  b c ".split_whitespace();
    let x = it.next_back();
    let y = it.next();
    let z = it.next_back();
    println("{:?} {:?} {:?} {:?}", x, y, z, it.next());
}
