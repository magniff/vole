fn h_u32(a: &[u32], n: usize) -> u64 {
    let mut h: u64 = 0;
    let mut i: usize = 0;
    while i < n {
        h = h.wrapping_mul(1000003).wrapping_add(a[i] as u64);
        i += 1;
    }
    h
}

#[inline(never)]
fn wadd_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn wsub_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_sub(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn wmul_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 1;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_mul(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn xor_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc ^ b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn or_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc | b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn and_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = !0;
    let mut i: usize = 0;
    while i < n {
        acc = acc & b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn min_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 50;
    let mut i: usize = 0;
    while i < n {
        acc = acc.min(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn max_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.max(b[i]);
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn minsel_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 50;
    let mut i: usize = 0;
    while i < n {
        acc = if b[i] < acc { b[i] } else { acc };
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn maxsel_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = if acc < b[i] { b[i] } else { acc };
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn add_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc + b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn sub_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 100;
    let mut i: usize = 0;
    while i < n {
        acc = acc - b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn mul_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 1;
    let mut i: usize = 0;
    while i < n {
        acc = acc * b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn cadd_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.checked_add(b[i]).unwrap();
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn csub_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 100;
    let mut i: usize = 0;
    while i < n {
        acc = acc.checked_sub(b[i]).unwrap();
        a[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn cmul_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 1;
    let mut i: usize = 0;
    while i < n {
        acc = acc.checked_mul(b[i]).unwrap();
        a[i] = acc;
        i += 1;
    }
    acc
}

fn dbl_u32(x: u32) -> u32 {
    x.wrapping_add(x)
}

#[inline(never)]
fn before_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        a[i] = acc;
        acc = acc.wrapping_add(b[i]);
        i += 1;
    }
    acc
}

#[inline(never)]
fn old_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        let old = acc;
        acc = acc.wrapping_add(b[i]);
        a[i] = old;
        i += 1;
    }
    acc
}

#[inline(never)]
fn other_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        c[i] = acc;
        a[i] = b[i];
        i += 1;
    }
    acc
}

#[inline(never)]
fn derived_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc.wrapping_mul(3);
        i += 1;
    }
    acc
}

#[inline(never)]
fn excl_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc.wrapping_sub(b[i]);
        i += 1;
    }
    acc
}

#[inline(never)]
fn cmp_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        a[i] = if acc > b[i] { 1 } else { 0 };
        i += 1;
    }
    acc
}

#[inline(never)]
fn cmpsum_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut cnt: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        cnt = cnt.wrapping_add(if acc > (40 as u32) { 1 } else { 0 });
        a[i] = b[i];
        i += 1;
    }
    cnt
}

#[inline(never)]
fn second_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut s1: u32 = 0;
    let mut s2: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        s1 = s1.wrapping_add(b[i]);
        s2 = s2.wrapping_add(s1);
        a[i] = b[i];
        i += 1;
    }
    s2
}

#[inline(never)]
fn second_nostore_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut s1: u32 = 0;
    let mut s2: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        s1 = s1.wrapping_add(b[i]);
        s2 = s2.wrapping_add(s1);
        i += 1;
    }
    s2
}

#[inline(never)]
fn second_old_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut s1: u32 = 0;
    let mut s2: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        s2 = s2.wrapping_add(s1);
        s1 = s1.wrapping_add(b[i]);
        i += 1;
    }
    s2
}

#[inline(never)]
fn two_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut x: u32 = 0;
    let mut y: u32 = 1;
    let mut i: usize = 0;
    while i < n {
        x = x.wrapping_add(b[i]);
        y = y.wrapping_sub(b[i]);
        a[i] = x;
        c[i] = y;
        i += 1;
    }
    x
}

#[inline(never)]
fn iv2_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(1);
        a[i] = acc.wrapping_add(b[i]);
        i += 1;
    }
    acc
}

#[inline(never)]
fn twice_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc;
        acc = acc.wrapping_add(b[i]);
        c[i] = acc;
        i += 1;
    }
    acc
}

#[inline(never)]
fn call_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc.wrapping_add(b[i]);
        a[i] = dbl_u32(acc);
        i += 1;
    }
    acc
}

#[inline(never)]
fn zip_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut k: usize = 0;
    for (x, y) in a.iter_mut().zip(b.iter()) {
        if k == n { break; }
        acc = acc.wrapping_add(*y);
        *x = acc;
        k += 1;
    }
    acc
}

#[inline(never)]
fn forrange_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    for i in 0..n {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc;
    }
    acc
}

#[inline(never)]
fn rows_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut j: usize = 0;
    while j < n / 9 {
        acc = 0;
        let mut k: usize = 0;
        while k < 9 {
            acc = acc.wrapping_add(b[j * 9 + k]);
            a[j * 9 + k] = acc;
            k += 1;
        }
        j += 1;
    }
    acc
}

#[inline(never)]
fn rows_n_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut j: usize = 0;
    let w = n / 3;
    while j < 3 {
        acc = 0;
        let mut k: usize = 0;
        while k < w {
            acc = acc.wrapping_add(b[j * w + k]);
            a[j * w + k] = acc;
            k += 1;
        }
        j += 1;
    }
    acc
}

#[inline(never)]
fn cols_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut j: usize = 0;
    while j < n / 4 {
        acc = 0;
        let mut k: usize = 0;
        while k < 4 {
            acc = acc.wrapping_add(b[k * 25 + j]);
            a[k * 25 + j] = acc;
            k += 1;
        }
        c[j] = acc;
        j += 1;
    }
    acc
}

#[inline(never)]
fn carried_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut j: usize = 0;
    while j < n / 4 {
        let mut k: usize = 0;
        while k < 4 {
            acc = acc.wrapping_add(b[k * 25 + j]);
            k += 1;
        }
        c[j] = acc;
        j += 1;
    }
    acc
}

#[inline(never)]
fn slp_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i + 4 <= n {
        acc = acc.wrapping_add(b[i + 0]);
        a[i + 0] = acc;
        acc = acc.wrapping_add(b[i + 1]);
        a[i + 1] = acc;
        acc = acc.wrapping_add(b[i + 2]);
        a[i + 2] = acc;
        acc = acc.wrapping_add(b[i + 3]);
        a[i + 3] = acc;
        i += 4;
    }
    acc
}

#[inline(never)]
fn ovflag_u32(a: &mut [u32], b: &[u32], c: &mut [u32], n: usize) -> u32 {
    let mut acc: u32 = 0;
    let mut i: usize = 0;
    while i < n {
        let (v, o) = acc.overflowing_add(b[i]);
        acc = v;
        a[i] = if o { 1 } else { 0 };
        i += 1;
    }
    acc
}

