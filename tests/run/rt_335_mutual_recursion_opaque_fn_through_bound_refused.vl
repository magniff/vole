// XFAIL: RT-335: mutually recursive fns that use each other's `impl Fn` values through a bound (`call(b(n - 1))`, `&a(0)`) are refused as opaque.cycle; rustc accepts (0.30.2)
// Since v0.30.1 at least. x16's Iterator form is rt_335b. From the
// review of the opaque-type work.
// EXPECT: b ref 100
// EXPECT: a sees 200
// EXPECT: b sees 101
// EXPECT: b ref 100
// EXPECT: a sees 202
// EXPECT: 103
fn call<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn a(n: i64) -> impl Fn() -> i64 {
    if n > 0 {
        println("a sees {}", call(b(n - 1)));
    }
    move || n + 100
}

fn b(n: i64) -> impl Fn() -> i64 {
    if n > 0 {
        println("b sees {}", call(a(n - 1)));
    }
    let r = &a(0);
    println("b ref {}", r());
    move || n + 200
}

fn main() {
    println("{}", a(3)());
}
