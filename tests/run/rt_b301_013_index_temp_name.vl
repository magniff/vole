// XFAIL: RT-B301-13: a message names the place of an Index call's result without its index (open, 0.30.2)
// `fill(g[0].s)` through a type that is only Index is refused, rightly
// (rustc E0596: cannot borrow data in an index of `G`), but vole names the
// place 'g.s'; it is 'g[_].s'.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'g[_].s' as mutable
// ERROR-COUNT: 1
use std::ops::Index;

struct W<'a> {
    s: &'a mut [i64],
}

struct G<'b, 'a> {
    r: &'b W<'a>,
}

impl<'b, 'a> Index<usize> for G<'b, 'a> {
    type Output = W<'a>;

    fn index(&self, i: usize) -> &W<'a> {
        let _ = i;
        self.r
    }
}

fn fill(t: &mut [i64]) {
    t[0] = 9;
}

fn main() {
    let mut arr = [1i64, 2];
    let w = W { s: &mut arr };
    let g = G { r: &w };
    fill(g[0].s);
}
