// ERROR: trait.overflow
// (review of M2, R3) a projection 128 deep is an overflow (rustc E0275), not "defined in terms of itself".
trait Tr { type Out; fn d(&self) -> i64; }
struct W<T> { t: T }
impl Tr for i64 { type Out = i64; fn d(&self) -> i64 { 0 } }
impl<T: Tr> Tr for W<T> { type Out = T::Out; fn d(&self) -> i64 { 1 + self.t.d() } }
fn go<T: Tr<Out = i64>>(t: &T) -> i64 { t.d() }

fn main() {
    let w = W {
        t: W {
            t: W {
                t: W {
                    t: W {
                        t: W {
                            t: W {
                                t: W {
                                    t: W {
                                        t: W {
                                            t: W {
                                                t: W {
                                                    t: W {
                                                        t: W {
                                                            t: W {
                                                                t: W {
                                                                    t: W {
                                                                        t: W {
                                                                            t: W {
                                                                                t: W {
                                                                                    t: W {
                                                                                        t: W {
                                                                                            t: W {
                                                                                                t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: 0i64 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }; println("{}", go(&w));
}
