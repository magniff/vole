// (0.30.1) A tuple made by an expression, of two arrays that fit (2^60
// bytes each) but not together: refused at the expression.
// ERROR: values of the type '([u8; 1152921504606846976], [u8; 1152921504606846976])' are too big
fn main() {
    let n = std::env::args().count();
    if n > 5 {
        let a = [0u8; 1usize << 60];
        let b = [1u8; 1usize << 60];
        let t = (a, b);
        println("{}", t.0[n]);
    }
}
