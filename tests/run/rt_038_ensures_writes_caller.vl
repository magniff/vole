// RT-38 (F2): an `ensures` runs in f's wrapper, `{ let ?old0 = e; let
// result = f$body(..); checks; result }`, and `old(e)` ran there on the
// parameters themselves: `old(o.take().is_some())` with `mut o` emptied
// o before the body ran, `old({ v[0] = 9; 1 })` wrote the caller's array
// through `v: &mut`, and a check could write through a `&mut` that
// `result` holds. So a contract changed what the program does, and
// `--debug-contracts` on and off printed different output. The rule: a
// clause writes, lends `&mut` or moves nothing it did not make; `old(e)`
// and the checks read the parameters and `result` through views (`let
// v = &*v;` of a `&mut`, else a borrowed copy, read as through `&T`).
// (0.30.2, the re-review of g302holes: `result.take()` is a `&mut` write
// the borrow rules refuse; the Vec it takes out of `result` is dropped,
// a free through result's pointer, which no clause may do: effects/
// provenance.vl, contract.effect.)
// FLAGS: --check-alloc
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'o' as mutable, a borrowed copy
// ERROR: line 38, column 17
// ERROR: error[borrowck.assign_immutable]: cannot assign to 'v[0]', which is behind a `&` reference
// ERROR: line 48, column 9
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'o' as mutable, a borrowed copy
// ERROR: line 56, column 17
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'self.o' as mutable, a borrowed copy
// ERROR: line 67, column 21
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*s.r', a borrowed copy
// ERROR: line 79, column 9
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*result', which is behind a `&` reference
// ERROR: line 88, column 5
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*result.0', a borrowed copy
// ERROR: line 98, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'result' as mutable, a borrowed copy
// ERROR: line 107, column 13
// ERROR: error[contract.effect]: the 'ensures' of 'result_take' calls 'Vec<i64, A>::drop', which writes through a raw pointer what it did not make
// ERROR: line 107, column 13
// ERROR-COUNT: 9
use std::alloc::Allocator;

fn old_take(mut o: Option<Vec<i64, Gpa>>) -> i64
    ensures old(o.take().is_some())
{
    match o {
        Some(v) => v[0],
        None => -1,
    }
}

fn old_write(v: &mut [i64; 2]) -> i64
    ensures old({
        v[0] = 9;
        1
    }) == 1
    {
    v[0]
}

fn old_closure(mut o: Option<i64>) -> i64
    ensures old((|| o.take().is_some())())
{
    o.unwrap()
}

struct S {
    o: Option<i64>,
}

impl S {
    fn old_self(mut self) -> i64
        ensures old(self.o.take().is_some())
    {
        self.o.unwrap()
    }
}

struct R<'a> {
    r: &'a mut i64,
}

fn old_through(s: R<'_>) -> i64
    ensures old({
        *s.r = 7;
        1
    }) == 1
    {
    *s.r
}

fn result_ref<'a>(v: &'a mut [i64; 2]) -> &'a mut i64
    ensures {
    *result = 7;
    true
}

{
    &mut v[0]
}

fn result_tuple<'a>(x: &'a mut i64) -> (&'a mut i64, i64)
    ensures {
    *result.0 = 7;
    true
}

{
    (x, 1)
}

fn result_take<A: Allocator>(gpa: A) -> Option<Vec<i64, A>>
    ensures result.take().is_some()
{
    Some(Vec::from_in([1i64], gpa))
}

fn main(gpa: Gpa) {
    println("{}", old_take(Some(Vec::from_in([5i64], gpa))));
    let mut a = [1i64, 2];
    println("{}", old_write(&mut a));
    println("{}", old_closure(Some(3)));
    println("{}", S { o: Some(4) }.old_self());
    let mut b = 1i64;
    println("{}", old_through(R { r: &mut b }));
    println("{}", *result_ref(&mut a));
    println("{}", *result_tuple(&mut b).0);
    println("{}", result_take(gpa).unwrap()[0]);
}
