// Runs on std since 0.27.2's switch.
// The std item(s): std::ops impl ShlAssign for primitives.
// EXPECT: 48 48
use std::ops::ShlAssign;

fn update<T: ShlAssign>(a: &mut T, b: T) {
    a.shl_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 2);
    update(&mut y, 2);
    println("{} {}", x, y);
}
