// XFAIL: gap 5: compile type error: no method 'clone' on type '(u8, u8)'
// Global variables: `static` and `static mut` with constant initializers
// (scalars, arrays, structs, tuples, pointers).
// EXPECT: 115 17 -3 0.25 ok 7 42 8
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

#[derive(Clone, Copy)] struct Config { level: i32, ratio: f64, name: (u8, u8) }

const N: u64 = 4;
static mut COUNTER: i64 = 0;
static PRIMES: [i64; N] = [2i64, 3, 5, 7];
static CONFIG: Config = Config { ratio: 0.25, level: -3, name: (b'o', b'k') };
static mut TABLE: [u8; 2 * N] = [7; 2 * N];
static mut TARGET: *mut i64 = 0 as *mut i64;

fn bump(by: i64) -> i64 {
    unsafe { COUNTER += by; }
    unsafe { COUNTER }
}

fn main() -> i64 {
    bump(5);
    bump(10);
    let mut sum: i64 = 0;
    for i in 0..N { sum += PRIMES[i as usize]; }
    unsafe { TABLE[3] = 42; }
    let p = unsafe { &mut TABLE[0] } as *mut u8;
    unsafe { (*p.add(7)) += 1; }
    unsafe { TARGET = &raw mut COUNTER; }
    unsafe {
        *TARGET += 100;
        printf(
            c"%ld %ld %d %.2f %c%c %d %d %d\n",
            COUNTER, sum, CONFIG.level, CONFIG.ratio, CONFIG.name.0 as i32, CONFIG.name.1 as i32,
            TABLE[0] as i32, TABLE[3] as i32, TABLE[7] as i32,
        );
    }
    0
}
