// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string String::impl Ord.
// EXPECT: Less ["a", "b", "c"]

fn main(gpa: Gpa) {
    let a = String::from_in("a", gpa);
    let b = String::from_in("b", gpa);
    let c = String::from_in("c", gpa);
    let o = a.cmp(&b);
    let mut v = Vec::from_in([c, a, b], gpa);
    v.sort();
    println("{:?} {:?}", o, v);
}
