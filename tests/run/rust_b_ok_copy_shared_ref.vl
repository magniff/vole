// EDITION: rust
// RULE: D2.5
// (0.27.1) Copying and borrowing a shared reference while its referent is
// borrowed: Extends through `&` is no conflict.

fn main() {
    let x: i64 = 3;
    let r = &x;
    let r2 = r;
    let rr = &r;
    println("{}", *r + *r2 + **rr);
}
// EXPECT: 9
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
