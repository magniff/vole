// (0.30.2, obligations M1) Review 5's m10: the chosen impl is a blanket one,
// `Tr<i32> for T: Sup`, beside a direct `Tr<i64>` for W; Sup's impl for W
// needs `'a: 'static`, required at the call (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Sup { fn up(&self) -> &'static str; }
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Sup for W<'a> { fn up(&self) -> &'static str { self.r } }
impl<T: Sup> Tr<i32> for T { fn f(&self) -> &'static str { self.up() } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<T: Tr<i32>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = { let st = String::from_in("hello heap string long", gpa); go(&W { r: st.as_str() }) };
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{}", s); println("{}", w);
}
