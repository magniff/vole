// EDITION: rust
// (0.27.1) The optimizer's reference-parameter facts (gvn's
// params_disjoint and param_frozen, vecfacts' frozen header) are off for
// a rust-edition body (borrowck.md D17.7): the own pass is quiet there
// and the borrow checker reports nothing yet, so `f(&mut x, &mut x)` and
// `g(&v, &mut v)` reach the optimizer, and the facts miscompiled them
// (v0.27.0 at -O2: `f: 1`, `g: 0`). The same output at every level; once
// M2 lands, the same program as rust_b_err_alias_params expects
// mut_twice and conflict.
// RULE: D17.7
// RUSTC: none uses Gpa (outside the subset); rustc rejects it (E0499, E0502), as rust_b_err_alias_params expects after M2
// EXPECT: f: 2
// EXPECT: g: 1
#[inline(never)]
fn f(a: &mut i64, b: &mut i64) -> i64 {
    *a = 1;
    *b = 2;
    *a
}

#[inline(never)]
fn g(v: &Vec<i64, Gpa>, w: &mut Vec<i64, Gpa>) -> usize {
    let n0 = v.len();
    w.push(1);
    let n1 = v.len();
    n1 - n0
}

fn main(gpa: Gpa) -> i64 {
    let mut x = 0;
    let r = f(&mut x, &mut x);
    println("f: {r}");
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let d = g(&v, &mut v);
    println("g: {d}");
    0
}
