// EDITION: rust
// FLAGS: --check-alloc
// RULE: Z5.1
// The std2 item(s): std::alloc Gpa (the checking allocator, --check-alloc).
// EXIT: 101
// STDERR: double free: block #1 (8 bytes), allocated at std2_alloc_check_double_free.vl:13:13, freed at std2_alloc_check_double_free.vl:17:9, freed again at std2_alloc_check_double_free.vl:18:9
// A block given back twice stops the program, naming where it was
// allocated and freed.
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let l = Layout::from_size_align(8, 8).unwrap();
    let p = gpa.allocate(l).unwrap();
    // UNSAFE: the block given back twice, on purpose.
    // SAFETY: none: the case is the double free the checker reports.
    unsafe {
        gpa.deallocate(p, l);
        gpa.deallocate(p, l);
    }
}
