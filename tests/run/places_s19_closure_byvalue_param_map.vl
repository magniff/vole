// places IR, S19: a closure's sink parameter dropped at its exit
// sem-own: (0.25.3) Option::map's closure takes its item sink and drops it
// at the closure's end.
// EXPECT: drop 2
// EXPECT: id 2
// EXPECT: end
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn main
// PLACES: drop(_3) [removed]
// PLACES: drop(_2) [removed]
// PLACES: fn closure(D) -> i64
// PLACES: drop(_1) [kept]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let o: Option<D> = Some(mk(2, gpa));
    let n = o.map(|d| d.id);
    println("id {}", n.unwrap_or(0));
    println("end");
}
