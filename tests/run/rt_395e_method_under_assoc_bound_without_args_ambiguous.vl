// XFAIL: RT-395: (RT-395's mechanism, an associated type's bound) `t.get().g()` in `fn c<T: H>(t: &T)` with `trait H { type Out: Tr; .. }` and `trait Tr<U = i32>`, W having impls of Tr<i32> and Tr<i64>, is refused, "'W::g' is ambiguous for arguments ()": the bound's default is not applied; rustc prints 32 (0.30.2)
// From the review of g302oblig-m2 (form f270s). Since v0.30.1 at least;
// the release build the same. `type Out: Tr` is `Out: Tr<i32>`.
// Siblings: rt_395, rt_395b, rt_395c, rt_395d.
// EXPECT: 32
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

trait H {
    type Out: Tr;
    fn get(&self) -> &Self::Out;
}

struct W {
    r: i64,
}

struct B {
    w: W,
}

impl Tr<i32> for W {
    fn g(&self) -> i64 {
        32
    }
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

impl H for B {
    type Out = W;

    fn get(&self) -> &W {
        &self.w
    }
}

fn c<T: H>(t: &T) -> i64 {
    t.get().g()
}

fn main() {
    println("{}", c(&B { w: W { r: 0 } }));
}
