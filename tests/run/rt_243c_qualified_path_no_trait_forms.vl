// RULE: F8.4
// RT-243b: a qualified path without a trait, `<T>::k()` in a generic
// function, `<i64>::pow`, `<S>::m`, `<Vec<i64, Gpa>>::new_in`: the path
// `T::k` itself (or of the type, for one that is not a name), beside
// `<S as Tr>::k()`. 0.30.1: "expected expression, got '<'". rustc prints
// the EXPECT line (with Vec::new for new_in).
// EXPECT: 8 8 5 5 7 0
trait Tr {
    type A;
    fn k() -> i64;
}

struct S {
    k: i64,
}

impl S {
    fn m(&self, a: i64, b: i64) -> i64 {
        self.k + a + b
    }
}

impl Tr for S {
    type A = i64;

    fn k() -> i64 {
        5
    }
}

fn g<T: Tr>() -> i64 {
    <T>::k()
}

fn h(x: <S as Tr>::A) -> <S as Tr>::A {
    x
}

fn main(gpa: Gpa) {
    let s = S { k: 1 };
    let b = <i64>::pow(2, 3);
    let c = <S>::m(&s, 3, 4);
    let v = <Vec<i64, Gpa>>::new_in(gpa);
    println("{} {} {} {} {} {}", b, c, g::<S>(), <S as Tr>::k(), h(7), v.len());
}
