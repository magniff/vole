// EDITION: rust
// XFAIL: gap 8: compile borrowck.use_moved: 'a' is used here after it moved (moved at sem_poly_r19_op_traits_owned.vl: line...
// an operator on an owned type takes both operands let: a + a is fine, neither consumed
// FLAGS: --check-alloc
// EXPECT: 1 2 3
use std::alloc::Allocator; use std::ops::Add; struct Big<A: Allocator> { v: Vec<i64, A> }

impl Add for Big<Gpa> { type Output = Big<Gpa>;
    fn add(self, o: Big<Gpa>) -> Big<Gpa> {
        let mut r = self.v.clone();
        for x in o.v { r.push(x); }
        Big { v: r }
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let a = Big { v: v };
    let b = a + a;
    let c = b + a;
    println("{} {} {}", a.v.len(), b.v.len(), c.v.len());
}
