// (0.27.5) the 0.27 translator's version of an MVS program with an
// IndexMut index that reads its Vec (computed first, `{ let at_ix = I; .. }`)
// and inout slice parameters given an array or a part of one (`&mut`):
// rustc builds it too, and it prints what the MVS program does.
// EXPECT: 7 7 9 2 3 3
// The translator (0.27.5): an assignment to a Vec's element whose
// index reads the Vec (or its owner) computes the index first, `{ let
// at_ix = I; v[at_ix] = x }`: Rust's IndexMut borrows the Vec before the
// index is read (rustc E0502). An inout slice parameter given an array or
// a part of one is `&mut`.
use std::alloc::Allocator; #[derive(Clone, Copy)] struct F {
    module: i64,
}

struct P<A: Allocator> {
    files: Vec<F, A>,
    nodes: Vec<i64, A>,
    c: i64,
}

fn last(p: &P<Gpa>) -> i64 {
    p.nodes.len() as i64 - 1
}

fn first(v: &mut [i64]) -> i64 {
    v[0] += 1;
    v[0]
}

fn main(gpa: Gpa) {
    let mut p = P { files: Vec::new_in(gpa), nodes: Vec::new_in(gpa), c: 7 };
    p.files.push(F { module: 0 });
    p.files.push(F { module: 0 });
    p.nodes.push(1);
    p.nodes.push(2);
    { let at_ix = p.files.len() - 1; p.files[at_ix].module = p.c };
    { let at_ix = last(&p) as usize; p.nodes[at_ix] += 5 };
    let mut kept = Vec::<i64, Gpa>::new_in(gpa);
    kept.push(1);
    kept.push(2);
    { let at_ix = kept.len() - 2; kept[at_ix] = 9 };
    let mut a = [1i64, 2, 3];
    let x = first(&mut a);
    let z = first(&mut a[1..3]);
    println("{} {} {} {} {} {}", p.files[1].module, p.nodes[1], kept[0], x, z, a[1]);
}
