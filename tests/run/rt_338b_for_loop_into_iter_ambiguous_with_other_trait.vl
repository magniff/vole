// XFAIL: RT-338b: (RT-338's mechanism, by value) `for x in v` over a type with `impl IntoIterator for V` and another trait's `fn into_iter(self)` for V is refused as method.ambiguous ("'into_iter' is a method of more than one trait for 'V'"); a for loop calls IntoIterator::into_iter, rustc prints 123 (0.30.2)
// From red team round 9's leads (r302i COVERAGE.md). Since v0.30.1 at
// least (the same error). RT-338 is `for x in &v` running the other
// trait's into_iter (wrong code); RT-381 the same for `next`.
// EXPECT: 123
struct V {
    a: [i64; 3],
}

struct It {
    v: V,
    i: usize,
}

impl Iterator for It {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.i < 3 {
            self.i += 1;
            Some(self.v.a[self.i - 1])
        } else {
            None
        }
    }
}

impl IntoIterator for V {
    type Item = i64;
    type IntoIter = It;

    fn into_iter(self) -> It {
        It { v: self, i: 0 }
    }
}

trait Other {
    fn into_iter(self) -> It;
}

impl Other for V {
    fn into_iter(self) -> It {
        It { v: V { a: [7, 8, 9] }, i: 0 }
    }
}

fn main() {
    let v = V { a: [1, 2, 3] };
    let mut s = 0;
    for x in v {
        s = s * 10 + x;
    }
    println("{}", s);
}
