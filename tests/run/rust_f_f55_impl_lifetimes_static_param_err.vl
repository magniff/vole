// RULE: F5.5
// (0.30.1) The trait's parameter is a borrow of any lifetime; the impl
// asks for 'static, which the trait does not promise. rustc E0308.
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 1
trait Take {
    fn take(&self, x: &str) -> usize;
}

struct T;

impl Take for T {
    fn take(&self, x: &'static str) -> usize {
        x.len()
    }
}

fn main() {
    println("{}", T.take("a"));
}
