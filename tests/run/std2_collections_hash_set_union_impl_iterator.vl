// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_set Union::impl Iterator.
// EXPECT: Some(1) None
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa, FixedState> = [1i64].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa, FixedState> = [1i64].into_iter().collect_in(gpa);
    let mut u = a.union(&b);
    let x = u.next();
    println("{:?} {:?}", x, u.next());
}
