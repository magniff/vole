// The std2 item(s): std::collections::hash_set Union::impl Iterator.
// EXPECT: Some(1) None
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [1i64].into_iter().collect_in(gpa);
    let mut u = a.union(&b);
    let x = u.next();
    println("{:?} {:?}", x, u.next());
}
