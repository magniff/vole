// sem-own: a generic struct with `impl<T> Drop`: its drop runs once, then T's glue.
// EXPECT: box
// EXPECT: drop 1
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
struct Bx<T> { x: T }
impl<T> Drop for Bx<T> { fn drop(inout self) { println("box"); } }

fn main(gpa: Gpa) {
    {
        let b = Bx { x: mk(1, gpa) };
    }
    println("end");
}
