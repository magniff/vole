// an iterator of a Drop type holding a Vec: --check-alloc on the loop's items
// FLAGS: --check-alloc
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: got 0
// EXPECT: drop 0
// EXPECT: end
use std::alloc::Allocator; struct R<A: Allocator> { v: Vec<i64, A> }
impl Drop for R<Gpa> { fn drop(&mut self) { println("drop {}", self.v[0]); } }
#[derive(Clone, Copy)] struct Gen<A: Allocator> { n: i64, gpa: A }

impl Iterator for Gen<Gpa> {
    type Item = R<Gpa>;

    fn next(&mut self) -> Option<R<Gpa>> {
        if self.n == 0 { return None; }
        self.n -= 1;
        let mut v: Vec<i64, Gpa> = Vec::new_in(self.gpa);
        v.push(self.n);
        Some(R { v: v })
    }
}

fn main(gpa: Gpa) {
    for r in (Gen { n: 2, gpa: gpa }) { println("got {}", r.v[0]); }
    println("end");
}
