// EDITION: rust
// ok: a closure stores views of what outlives it into a capture
// EXPECT: 3 3
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    let mut out: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    let s = v.as_slice();
    let f = |x: i64| out.push(s);
    f(1);
    (0i64..2i64).for_each(|i| out.push(s));
    println("{} {}", out.len(), out[0][0]);
}
