// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops impl ShrAssign for primitives.
// EXPECT: 3 3
use std::ops::ShrAssign;

fn update<T: ShrAssign>(a: &mut T, b: T) {
    a.shr_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 2);
    update(&mut y, 2);
    println("{} {}", x, y);
}
