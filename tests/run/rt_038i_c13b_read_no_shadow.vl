// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c13b_read_no_shadow)
// RUSTC: none contract clauses are not Rust
// ERROR: 's' is used here after it moved
// An ensures reads the non-Copy by-value parameter the body only reads (no shadow).
struct N {
    v: i64,
}

fn f(s: N) -> i64
    ensures s.v == 4
{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
