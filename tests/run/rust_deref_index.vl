// EDITION: rust
// (0.27.0) std's Deref, DerefMut, Index and IndexMut in the rust edition:
// a method, a field, `*w` through Deref (DerefMut where written or where
// the method takes `&mut self`); `g[i]` through Index (IndexMut where
// written).

use std::ops::{Deref, DerefMut, Index, IndexMut};

struct Inner {
    a: i64,
}

impl Inner {
    fn twice(&self) -> i64 {
        self.a * 2
    }

    fn inc(&mut self) {
        self.a += 1;
    }
}

struct W {
    v: Inner,
}

impl Deref for W {
    type Target = Inner;
    fn deref(&self) -> &Inner {
        &self.v
    }
}

impl DerefMut for W {
    fn deref_mut(&mut self) -> &mut Inner {
        &mut self.v
    }
}

struct Grid {
    cells: [i64; 4],
}

impl Index<usize> for Grid {
    type Output = i64;
    fn index(&self, i: usize) -> &i64 {
        &self.cells[i]
    }
}

impl IndexMut<usize> for Grid {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.cells[i]
    }
}

fn main() -> i32 {
    let mut w = W { v: Inner { a: 3 } };
    w.inc();
    w.a += 10;
    let x = (*w).a;
    let mut g = Grid { cells: [1, 2, 3, 4] };
    g[1] = 20;
    g[2] += 5;
    println("{} {} {} {} {}", w.twice(), w.a, x, g[1], g[2]);
    0
}
// EXPECT: 28 14 14 20 8
