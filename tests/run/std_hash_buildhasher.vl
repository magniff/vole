// Runs on std since 0.27.2's switch.
// The std item(s): std::hash BuildHasher.
// EXPECT: true true
use std::hash::{BuildHasher, Hash, Hasher};

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

impl Default for Fnv {
    fn default() -> Fnv {
        Fnv { h: 0xcbf29ce484222325 }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

struct Point {
    x: i64,
    y: i64,
}

impl Hash for Point {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.x.hash(state);
        self.y.hash(state);
    }
}

struct FnvState {}

impl BuildHasher for FnvState {
    type Hasher = Fnv;

    fn build_hasher(&self) -> Fnv {
        fnv()
    }
}

fn main() {
    let s = FnvState {};
    let p = Point { x: 1, y: 2 };
    let mut h = s.build_hasher();
    p.hash(&mut h);
    println("{} {}", s.hash_one(&p) == h.finish(), s.hash_one(&p) == s.hash_one(&p));
}
