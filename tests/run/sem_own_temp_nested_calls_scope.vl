// sem-own: owned temporaries given to let parameters are dropped at the end
// of their statement (value-semantics.md §2.2), not at the end of the block.
// (0.25: at the end of the `let`, before the next statement)
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: 3
// EXPECT: in
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn add(a: D<Gpa>, b: D<Gpa>) -> i64 { a.id + b.id }

fn main(gpa: Gpa) {
    {
        let n = add(mk(1, gpa), mk(2, gpa));
        println("{n}");
        println("in");
    }
    println("end");
}
