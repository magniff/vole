// Runs on std since 0.27.2's switch.
// The std item(s): std::str str::lines.
// EXPECT: 3 0 1
use std::str::CharIndices;

fn main() {
    let mut n = 0;
    for _ in "x\ny\r\nz".lines() {
        n += 1;
    }
    let mut e = 0;
    for _ in "".lines() {
        e += 1;
    }
    let mut one = 0;
    for _ in "\n".lines() {
        one += 1;
    }
    println("{} {} {}", n, e, one);
}
