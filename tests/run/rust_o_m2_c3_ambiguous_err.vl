// ERROR: is ambiguous
// (review of M2, C3) two bounds declaring Out: rustc E0221.
trait Tr<U> { fn g(&self) -> i64; }
trait H2 { type Out; }
struct W { r: i64 }
impl H2 for W { type Out = i64; }
impl Tr<i64> for W { fn g(&self) -> i64 { 64 } }
trait H3 { type Out; }
impl H3 for W { type Out = i64; }
fn mid<T: H2 + H3 + Tr<T::Out>>(t: &T) -> i64 { t.g() }
fn main() { println("{}", mid(&W { r: 0 })); }
