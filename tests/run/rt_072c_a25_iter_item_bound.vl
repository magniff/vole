// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a25 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 600
// EXPECT: 3
trait TA { fn m(&self) -> i64; }
#[derive(Clone, Copy)]
struct S { k: i64 }
impl S { fn m(&self) -> i64 { 300 } }
impl TA for S { fn m(&self) -> i64 { self.k } }
fn g<I: Iterator>(it: I) -> i64 where I::Item: TA { let mut s = 0; for x in it { s += x.m(); } s }
fn main() { let a = [S { k: 1 }, S { k: 2 }]; println("{}", g(a.into_iter())); }
