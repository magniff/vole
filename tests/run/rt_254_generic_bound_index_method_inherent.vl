// XFAIL: RT-254: in a generic body, `t.index(i)` and `t.index_mut(i)` under `T: Index`/`IndexMut` call the instance's inherent index and index_mut, not the bound's (0.30.2)
// rustc resolves a method call on a type parameter to the bound's method
// in the generic body; vole resolves it by name in the instance, where W's
// inherent `index`/`index_mut` (element 0) win: `202 [101, 2, 3]` for
// rustc's `4 [1, 2, 103]`. RT-72's root (a generic instance resolving a
// bound's method by name), at Index and IndexMut. `t[i]` there is right.
// From the review of g302index (form i22); v0.30.1 the same.
// EXPECT: 4 [1, 2, 103]
use std::ops::{Index, IndexMut};

struct W {
    s: [i64; 3],
}

impl W {
    fn index(&self, i: usize) -> &i64 {
        &self.s[0]
    }

    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.s[0]
    }
}

impl Index<usize> for W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.s[i]
    }
}

impl IndexMut<usize> for W {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.s[i]
    }
}

fn get<T: Index<usize, Output = i64>>(t: &T, i: usize) -> i64 {
    t[i] + *t.index(i)
}

fn put<T: IndexMut<usize, Output = i64>>(t: &mut T, i: usize) {
    *t.index_mut(i) += 100;
}

fn main() {
    let mut w = W { s: [1, 2, 3] };
    put(&mut w, 2);
    println("{} {:?}", get(&w, 1), w.s);
}
