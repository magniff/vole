// EDITION: rust
// RULE: F18.4
// (0.27.6) In the rust edition `&e` is shared as written: where `&mut`
// goes it is refused, a type error as rustc's E0308 (the references
// differ in mutability), with the exclusive borrow as its fix. 0.27.5
// made it exclusive, MVS's inout marker, and accepted all three.
// ERROR: error[type error]: expected 'inout i64', got 'let i64'
// ERROR: line 25, column 10
// ERROR: error[type error]: expected 'inout [i64]', got '[i64]'
// ERROR: line 26, column 20
// ERROR: error[type error]: expected 'inout [i64]', got '[i64]'
// ERROR: line 27, column 20
// ERROR-COUNT: 3
fn first(v: &mut [i64]) -> i64 {
    v[0]
}

fn bump(x: &mut i64) {
    *x += 1;
}

fn main() {
    let mut a = [1i64, 2];
    let mut n = 3i64;
    bump(&n);
    let b = first(&[1i64, 2, 3][..]);
    let c = first(&a[..]);
    println("{} {} {}", n, b, c);
}
