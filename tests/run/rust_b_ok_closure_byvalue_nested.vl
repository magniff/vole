// RULE: D2.7
// (0.30.1) Nested closures: a capture by value of a capture by value is
// mutable as the first binding is; `let mut x` taken by value twice, by
// reference twice, and a captured `&mut` written through, all as rustc.
// EXPECT: 2 11 6
fn a() -> i64 {
    let mut x = 1i64;
    let mut f = move || {
        let mut g = move || {
            let r = &mut x;
            *r += 1;
            x
        };
        g()
    };
    f()
}

fn b() -> i64 {
    let mut x = 1i64;
    let mut f = || {
        let mut g = || {
            let r = &mut x;
            *r += 10;
        };
        g();
    };
    f();
    x
}

fn c() -> i64 {
    let mut v = 5i64;
    let r = &mut v;
    let mut f = move || {
        let mut g = move || {
            *r += 1;
        };
        g();
    };
    f();
    v
}

fn main() {
    println("{} {} {}", a(), b(), c());
}
