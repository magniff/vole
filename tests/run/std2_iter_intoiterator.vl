// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter IntoIterator.
// EXPECT: 6

struct Bag {
    v: Vec<i64, Gpa>,
}

impl IntoIterator for Bag {
    type Item = i64;
    type IntoIter = std::vec::IntoIter<i64, Gpa>;

    fn into_iter(self) -> std::vec::IntoIter<i64, Gpa> {
        self.v.into_iter()
    }
}

fn main(gpa: Gpa) {
    let mut s = 0;
    for x in (Bag { v: Vec::from_in([1i64, 2, 3], gpa) }) {
        s += x;
    }
    println("{}", s);
}
