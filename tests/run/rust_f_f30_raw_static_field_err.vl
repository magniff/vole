// EDITION: rust
// RULE: F30.2, F19.6
// `&raw const V.n` uses the `static mut` V: unsafe (rustc E0133); only the
// bare `&raw mut V` is safe.
// ERROR: error[unsafe]: use of a mutable static is unsafe
struct V2 {
    n: i64,
}

static mut V: V2 = V2 { n: 1 };

fn main() {
    let q: *const i64 = &raw const V.n;
    let _ = q;
}
