// XFAIL: RT-C301-19: a `'static` alias in a signature is a false borrowck.outlives, reported twice (open)
// From the final check of c301sig (2026-11-15). `type Sr = &'static i64;`
// makes both of f's references 'static: rustc builds it and prints 5.
// EXPECT: 5
type Sr = &'static i64;

fn f(x: Sr, out: &mut Option<Sr>) {
    out.replace(x);
}

fn main() {
    let mut out: Option<Sr> = None;
    f(&5, &mut out);
    println("{}", *out.unwrap());
}
