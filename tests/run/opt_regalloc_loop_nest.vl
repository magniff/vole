// A loop with a call on one of its paths, inside a loop that reads ten
// values the inner one does not (0.30): the inner loop's values keep
// callee-saved registers, and the outer loop's wait on the stack while
// the inner one runs (a load each a round of the outer loop). From the
// test that enters the inner loop to its load of a byte, the blocks of
// its path without the call, nothing is moved or brought back from the
// stack: before, its back edge loaded two of the outer loop's values
// every round and moved the index.
// EXPECT: 3932199116051534609
// ASM(aarch64-macos): _vole.rows:
// ASM(aarch64-macos): cbnz
// ASM-NOT(aarch64-macos): mov x
// ASM-NOT(aarch64-macos): ldr x
// ASM-NOT(aarch64-macos): ldp x
// ASM(aarch64-macos): ldrb
// ASM(aarch64-macos): bl _vole.slow

#[inline(never)]
fn slow(x: u64) -> u64 {
    x.wrapping_mul(0x9E3779B97F4A7C15) >> 7
}

#[inline(never)]
fn rows(b: &[u8], n: usize, k: u64) -> u64 {
    let a1 = slow(k);
    let a2 = slow(k + 2);
    let a3 = slow(k + 3);
    let a4 = slow(k + 4);
    let a5 = slow(k + 5);
    let a6 = slow(k + 6);
    let a7 = slow(k + 7);
    let a8 = slow(k + 8);
    let a9 = slow(k + 9);
    let a10 = slow(k + 10);
    let mut total = 0u64;
    for r in 0..n {
        let mut acc = 0u64;
        for i in 0..b.len() {
            let x = b[i];
            if x < 0x80 {
                acc += x as u64;
            } else {
                acc += slow(x as u64);
            }
        }
        total += (acc ^ a1) + (a2 ^ a3) + (a4 ^ a5) + (a6 ^ a7) + (a8 ^ a9) + (a10 ^ r as u64);
    }
    total
}

fn main() -> i32 {
    let s = "the quick brown fox, \u{e9}t\u{e9} \u{4e16}\u{754c}";
    let n = std::env::args().count();
    println("{}", rows(s.as_bytes(), n + 2, 7));
    0
}
