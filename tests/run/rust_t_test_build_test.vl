// EDITION: rust
// (0.28.0) `volec test` on std2: a rust-edition program's #[test] fns are
// built into the test program (--test-build: std::test's harness, in the
// rust edition) and run by name; one takes the allocator, one returns Ok.
// FLAGS: --test-build
// ARGS: --vole-test sums
// EXPECT: 6
fn sum(v: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for x in v.iter() {
        t += *x;
    }
    t
}

#[test]
fn sums(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    println("{}", sum(v.as_slice()));
    assert(sum(v.as_slice()) == 6);
}

#[test]
fn parses() -> Result<(), std::str::ParseIntError> {
    let n = "12".parse::<i64>()?;
    assert(n == 12);
    Ok(())
}

fn main() {
    println("not run");
}
