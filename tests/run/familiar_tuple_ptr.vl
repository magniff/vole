// EDITION: rust
// 0.17: `p.0` through a pointer to a tuple is `(*p).0`, as `p.x` is for
// a struct: read and assign, in a closure's parameters too.
// EXPECT: 3 40
// EXPECT: b1 a2
fn sum(p: (i64, i64)) -> i64 { p.0 + p.1 }

fn set(p: &mut (i64, i64), x: i64) { p.1 = x; }

fn main(gpa: Gpa) -> i32 {
    let mut t = (1, 2);
    let s = sum(t);
    set(&mut t, 40);
    println("{s} {}", t.1);
    let mut v: Vec<(&str, i64), Gpa> = Vec::new_in(gpa);
    v.push(("a", 2));
    v.push(("b", 1));
    v.as_mut_slice().sort_unstable_by(|a, b| ({ let a = a; let b = b; a.1 - b.1 }).cmp(&0));
    println("{}{} {}{}", v[0].0, v[0].1, v[1].0, v[1].1);
    0
}
