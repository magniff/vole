// RULE: F19.7
// (0.30.2, RT-43) `u.p.d = D { v: 3 }` with `p: ManuallyDrop<P>` goes
// through ManuallyDrop's DerefMut: `&mut u.p` is borrowed, a read of the
// union's field, unsafe (rustc E0133; rustc also refuses the implicit
// DerefMut on a ManuallyDrop union field). It was accepted in safe code
// and dropped the `d` read from u.x's bytes ("drop 5"), RT-43's form
// once its field was ManuallyDrop.
// ERROR: error[unsafe]: reading a field of a union is unsafe
// ERROR: line 36, column 5
// ERROR-COUNT: 1
use std::mem::ManuallyDrop;

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct P {
    d: D,
    k: i64,
}

union U {
    p: ManuallyDrop<P>,
    x: i64,
}

fn main() {
    let mut u = U { p: ManuallyDrop::new(P { d: D { v: 1 }, k: 0 }) };
    u.x = 5;
    u.p.d = D { v: 3 };
    println("end");
}
