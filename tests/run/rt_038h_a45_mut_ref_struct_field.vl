// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a45_mut_ref_struct_field)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A struct by value holding a &mut: the clause casts the field to *mut for a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

struct H<'a> { r: &'a mut i64 }

fn f(h: H) -> i64
    requires poke(h.r as *mut i64)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(H { r: &mut x }));
    println("{}", x);
}
