// sem-own: (0.25.3) Option::map's closure takes its item sink and drops it
// at the closure's end.
// EXPECT: drop 2
// EXPECT: id 2
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let o: Option<D<Gpa>> = Some(mk(2, gpa));
    let n = o.map(|d| d.id);
    println("id {}", n.unwrap_or(0));
    println("end");
}
