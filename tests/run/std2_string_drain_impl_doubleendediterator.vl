// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string Drain::impl DoubleEndedIterator.
// EXPECT: Some('c') Some('b')

fn main(gpa: Gpa) {
    let mut s = String::from_in("abcd", gpa);
    let mut d = s.drain(1usize..3);
    let x = d.next_back();
    println("{:?} {:?}", x, d.next_back());
}
