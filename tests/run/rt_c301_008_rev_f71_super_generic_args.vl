// RULE: F8.3, F8.4
// RT-C301-8 review (R3, form f71_super_generic_args): `T: Sub` with `trait Sub: Conv<i64>`: Conv<i64>'s items, not ambiguous between S's two Conv impls.
// rustc prints the EXPECT lines.
// EXPECT: 704
trait Conv<X> { const K: i64; fn mk() -> i64; }
trait Sub: Conv<i64> {}
struct S;
impl Conv<i32> for S { const K: i64 = 32; fn mk() -> i64 { 320 } }
impl Conv<i64> for S { const K: i64 = 64; fn mk() -> i64 { 640 } }
impl Sub for S {}
fn g<T: Sub>() -> i64 { T::K + T::mk() }
fn main() { println("{}", g::<S>()); }
