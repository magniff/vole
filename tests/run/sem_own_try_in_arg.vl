// sem-own: `?` as a call argument: the earlier argument (an owned temporary) is dropped on the early return.
// EXPECT: drop 1
// EXPECT: r -1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
fn g(gpa: Gpa) -> Result<i64, i64> { Err(-1) }
fn two(a: sink D<Gpa>, n: i64) -> i64 { a.id + n }
fn f(gpa: Gpa) -> Result<i64, i64> { Ok(two(mk(1, gpa), g(gpa)?)) }

fn main(gpa: Gpa) {
    println("r {}", match f(gpa) { Ok(x) => x, Err(e) => e });
}
