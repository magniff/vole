// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::is_err_and.
// EXPECT: false true false
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    println("{} {} {}", a.is_err_and(|e| e == "bad"), b.is_err_and(|e| e == "bad"),
        b.is_err_and(|e| e == "ok"));
}
