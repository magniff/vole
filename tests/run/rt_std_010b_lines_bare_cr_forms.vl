// XFAIL: RT-STD-10: (R302C-23, more forms) str::lines strips a bare "\r" that ends the last line ("gh\r" gives "gh"); Rust's and its own doc keep it (0.30.2)
// str::lines's doc: "Its lines, without their "\n" or "\r\n"". Rust
// (since 1.77; rustc here) splits at "\n" and "\r\n" only, so a last line
// without "\n" keeps its "\r". vole's Lines::next calls strip_cr on the
// last line too: "gh\r" is "gh", "\r" alone is "", "x\r\r" is "x\r". A
// line ended by "\r\n" is right. io's BufRead::lines strips "\r" only
// before "\n" and is right.
// EXPECT: ["ab", "ef", "gh\r"]
// EXPECT: ["\r"] ["x\r\r"] ["a\r", "b"] ["", ""]
fn main(gpa: Gpa) {
    let a: Vec<&str, Gpa> = "ab\r\nef\ngh\r".lines().collect_in(gpa);
    println("{:?}", a);
    let b: Vec<&str, Gpa> = "\r".lines().collect_in(gpa);
    let c: Vec<&str, Gpa> = "x\r\r".lines().collect_in(gpa);
    let d: Vec<&str, Gpa> = "a\r\r\nb".lines().collect_in(gpa);
    let e: Vec<&str, Gpa> = "\r\n\n".lines().collect_in(gpa);
    println("{:?} {:?} {:?} {:?}", b, c, d, e);
}
