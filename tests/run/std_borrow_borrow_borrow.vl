// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::borrow Borrow::borrow.
// EXPECT: 9
use std::borrow::Borrow;

struct W {
    v: i64,
}

impl Borrow<i64> for W {
    fn borrow(&self) -> &i64 {
        &self.v
    }
}

fn main() {
    let w = W { v: 9 };
    let r: &i64 = w.borrow();
    println("{}", r);
}
