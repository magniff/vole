// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::default Default.
// EXPECT: 0 false 0
use std::default::Default;

struct Conf {
    n: i64,
    on: bool,
    w: usize,
}

impl Default for Conf {
    fn default() -> Conf {
        Conf { n: Default::default(), on: Default::default(), w: Default::default() }
    }
}

fn main() {
    let c = Conf::default();
    println("{} {} {}", c.n, c.on, c.w);
}
