// ERROR: must implement 'Tr<Self>'
// (RT-271) `type Out: Tr<Self>` read with Self the impl's type, B: W has only Tr<W> (rustc E0277; v0.30.1: unknown type 'Self').
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H: Sized {
    type Out: Tr<Self>;
    fn get(&self) -> &Self::Out;
}

struct W {
    r: i64,
}

struct B {
    w: W,
}

impl Tr<W> for W {
    fn g(&self) -> i64 {
        9
    }
}

impl H for B {
    type Out = W;

    fn get(&self) -> &W {
        &self.w
    }
}

fn needg<V, Z: Tr<V>>(z: &Z) -> i64 {
    z.g()
}

fn mid<T: H>(t: &T) -> i64 {
    needg::<T, T::Out>(t.get())
}

fn main() {
    println("{}", mid(&B { w: W { r: 0 } }));
}
