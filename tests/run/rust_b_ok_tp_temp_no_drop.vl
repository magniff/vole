// EDITION: rust
// RULE: D7.2, D7.3
// (0.27.3) `b.put(&make(b.tag()).v)` with a temporary that has no
// Drop impl: the shared loan of `b.tag()` is used by nothing after the
// argument is made, so it is dead where the reservation activates (rustc
// accepts it). With a Drop impl it is rust_b_err_tp_temp_drop_holds.
// EXPECT: 3
struct Tag {
    k: i64,
}

struct B {
    tag: Tag,
    n: i64,
}

struct Held<'a> {
    t: &'a Tag,
    v: i64,
}

impl B {
    fn tag(&self) -> &Tag {
        &self.tag
    }

    fn put(&mut self, x: &i64) {
        self.n += *x;
    }
}

fn make(t: &Tag) -> Held<'_> {
    Held { t: t, v: t.k }
}

fn main() {
    let mut b = B { tag: Tag { k: 3 }, n: 0 };
    b.put(&make(b.tag()).v);
    println("{}", b.n);
}
