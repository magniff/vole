// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl Eq.
// EXPECT: true
use std::vec::Vec;

fn same<T: Eq>(a: &T, b: &T) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    println("{}", same(&Vec::from_in([1], gpa), &Vec::from_in([1], gpa)));
}
