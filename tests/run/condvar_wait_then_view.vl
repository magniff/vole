use std::sync::Condvar; use std::sync::Mutex;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let c = Condvar::new();
    let s = c.wait_then(m, |d| d.len() > 0, |d| d.as_slice());
    println("{}", s[0]);
}
