// EDITION: rust
// RULE: D2.6
// (0.27.1) A guard writing `x.1` while only `x` is faked: a write to a
// sub-place of a fake loan's place does not conflict (shallow).

fn main() {
    let mut x = (1i64, 2i64);
    match x {
        (a, _) if {
            x.1 = 5;
            true
        } => println("a {}", a),
        _ => println("b"),
    }
    println("{}", x.1);
}
// EXPECT: a 1
// EXPECT: 5
