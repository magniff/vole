// RULE: F16.3
// The std item(s): std::fmt write (an error stops the writes: the first failed write is the value).
// EXPECT: true 1
use std::fmt::Write;

struct Once {
    n: i64,
}

impl Write for Once {
    fn write_str(&mut self, _s: &str) -> std::fmt::Result {
        self.n += 1;
        if self.n == 1 { Err(std::fmt::Error) } else { Ok(()) }
    }
}

fn main() {
    let mut o = Once { n: 0 };
    let r = write(&mut o, "a{}b", 5);
    println("{} {}", r.is_err(), o.n);
}
