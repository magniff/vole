// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str Split::impl Iterator.
// EXPECT: ["", "a", "", "b", ""] ["", "a", "b", ""]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = ",a,,b,".split(',').collect_in(gpa);
    let w: Vec<&str, Gpa> = "ab".split("").collect_in(gpa);
    println("{:?} {:?}", v, w);
}
