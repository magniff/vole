// EDITION: rust
// s[i..] with i == len + 1.
// EXIT: 101
// STDERR: slice range out of bounds: 4..3, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let s = &a[..];
    println("{}", s[(4 + unsafe { Z }) as usize..].len());
    println("not reached");
    0
}
