// Runs on std since its arrays' by-value IntoIterator (0.27.3).
// The std item(s): std::collections::hash_set HashSet::symmetric_difference.
// EXPECT: [1, 3]
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa, FixedState> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa, FixedState> = [2i64, 3].into_iter().collect_in(gpa);
    let mut v: Vec<i64, Gpa> = a.symmetric_difference(&b).copied().collect_in(gpa);
    v.sort();
    println("{:?}", v);
}
