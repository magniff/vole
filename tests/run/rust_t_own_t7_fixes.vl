// (0.27.0) Hand-translated from tests/run/own_t7_fixes.vl to Rust's spelling.
// (0.17, T7) Correct code the migration found rejected, now accepted:
// - a view a method makes of a `&mut` parameter is a reborrow of it: the
//   parameter stays usable after a call writes through the view;
// - HashMap::get_mut and entry().or_insert give `&mut V`, and
//   `Option<&mut V>` keeps its methods;
// - std's Debug of a Vec borrows its elements (a Vec<String> prints);
// - reading a field through a `&mut` parameter leaves a view of another
//   field alive, and a view bound by `if let` out of a method of a `&mut`
//   parameter reborrows it (err_own_conflict keeps the real conflicts).
// (0.27.2) On std: MVS's Arena handle (copies sharing one arena) is not
// Rust's, and is left out.
use std::alloc::Allocator;
use std::collections::HashMap;

struct Acc {
    bal: i64,
}

struct S<A: Allocator> {
    mark: Vec<i64, A>,
    stamp: i64,
}

fn stamp(s: &mut S<Gpa>) {
    let mark = s.mark.as_mut_slice();
    mark[0] = s.stamp;
}

fn move_one(m: &mut HashMap<&str, Acc, Gpa, FixedState>) {
    if let Some(a) = m.get_mut(&"a") {
        a.bal -= 1;
    }
    if let Some(b) = m.get_mut(&"b") {
        b.bal += 1;
    }
}

fn twice(v: &mut Vec<i64, Gpa>) {
    v.as_mut_slice().sort_unstable();
    v.as_mut_slice().sort_unstable();
    let s = v.as_mut_slice();
    s[0] += 100;
    v.push(9);
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    twice(&mut v);
    println("{} {} {}", v[0], v[1], v.len());

    let mut m: HashMap<&str, Acc, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert("a", Acc { bal: 1 });
    if let Some(a) = m.get_mut(&"a") {
        a.bal += 10;
    }
    if m.get_mut(&"b").is_none() {
        println("no b");
    }
    m.get_mut(&"a").unwrap().bal += 100;
    m.entry("a").or_insert(Acc { bal: 0 }).bal += 1000;
    let bal = m.get(&"a").unwrap().bal;
    println("{bal}");
    m.insert("b", Acc { bal: 0 });
    move_one(&mut m);
    let ab = m.get(&"a").unwrap().bal * 10 + m.get(&"b").unwrap().bal;
    let mut st = S { mark: Vec::new_in(gpa), stamp: 7 };
    st.mark.push(0);
    stamp(&mut st);
    println("{ab} {}", st.mark[0]);

    let mut bufs: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    bufs.push(String::from_in("hi", gpa));
    println("{bufs:?}");
}
// EXPECT: 101 3 3
// EXPECT: no b
// EXPECT: 1111
// EXPECT: 11101 7
// EXPECT: ["hi"]
// Runs on std since its gap closed (0.27.2.1).
