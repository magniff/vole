// RULE: F8.4
// RT-C301-8: the traits renamed by `use`, and named by their path:
// the trait is what the name resolves to. 0.30.1 printed `1 1 2 2`.
// rustc prints 2 1 1 2.
// EXPECT: 2 1 1 2
// a trait renamed by use
mod t {
    pub trait A { const K: i64; fn m(&self) -> i64; }
    pub trait B { const K: i64; fn m(&self) -> i64; }
}

use t::A as AA;
use t::B as BB;
struct S;
impl AA for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } }
impl BB for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } }

fn main() {
    let s = S; let f = <S as BB>::m; let g = <S as t::A>::m;
    println("{} {} {} {}", f(&s), g(&s), <S as AA>::K, <S as t::B>::K);
}
