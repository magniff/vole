// EDITION: rust
// `&f(x)` after a call in its statement stays an error (the order could
// change); its try: names the value with a name the statement does not
// use: `t` is the table here (0.18.1: it was `let t = t.val(..)`). 0.20:
// the address is a raw pointer's (`b: *i64`); a let argument takes any
// value.
// ERROR: error[type error]
// ERROR: line 21, column 18
use std::alloc::Allocator; struct T<A: Allocator> { v: Vec<i64, A> }

impl T<Gpa> {
    fn val(&self, i: i64) -> i64 { self.v[i as usize] }
}

fn f(t: &T<Gpa>) -> i64 { t.v.len() as i64 }

fn total(a: i64, b: *mut i64) -> i64 { a + unsafe { *b } }

fn main(gpa: Gpa) {
    let t = T { v: Vec::new_in(gpa) };
    total(f(&t), &t.val(1));
}
