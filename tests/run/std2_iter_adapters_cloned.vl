// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters Cloned.
// EXPECT: ["x"]
use std::iter::Cloned;

fn main(gpa: Gpa) {
    let x = "x".to_string_in(gpa);
    let s = Vec::from_in([x], gpa);
    let it: Cloned<std::slice::Iter<'_, String<Gpa>>> = s.iter().cloned();
    let v: Vec<String<Gpa>, Gpa> = it.collect_in(gpa);
    println("{:?}", v);
}
