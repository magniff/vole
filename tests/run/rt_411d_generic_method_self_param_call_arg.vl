// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 4000000000
trait Ad { fn ad<T>(self, o: Self, t: T) -> Self; }
impl Ad for i32 { fn ad<T>(self, o: i32, t: T) -> i32 { self.wrapping_add(o) } }
impl Ad for i64 { fn ad<T>(self, o: i64, t: T) -> i64 { self + o } }
fn take(x: i64) -> i64 { x }

fn main() {
    let a = 2000000000;
    println("{}", take(a.ad(a, 1u8)));
}
