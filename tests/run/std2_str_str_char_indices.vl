// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str str::char_indices.
// EXPECT: [(0, 'a'), (1, 'é'), (3, 'b')]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<(usize, char), Gpa> = "aéb".char_indices().collect_in(gpa);
    println("{:?}", v);
}
