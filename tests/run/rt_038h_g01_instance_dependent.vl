// RUSTC: none contract clauses are not Rust
// EXPECT: 1
// EXPECT: 1
// The same generic clause, instantiated with i64 and with a Vec reference.
fn f<T>(t: &T, o: Option<i64>) -> i64
    requires o.iter().all(|x| *x > 0)
{
    1
}

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{}", f(&3i64, Some(1)));
    println("{}", f(&v, Some(1)));
}
