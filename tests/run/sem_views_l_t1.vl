// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: n views a temporary dropped at the end of the statement
// (0.28.0) The rust edition drops the temporary at the end of its
// statement, as rustc does (E0716 at the same lines): its view is an error.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 11, column 13
use std::alloc::Allocator; struct H<A: Allocator> { b: String<A> }
impl H<Gpa> { fn view(&self) -> &str { self.b.as_str() } }
fn mk(gpa: Gpa) -> H<Gpa> { let mut b = String::new_in(gpa); b.push_str("hello"); H { b: b } }

fn main(gpa: Gpa) -> i32 {
    let n = mk(gpa).view();
    println("{}", n);
    0
}
