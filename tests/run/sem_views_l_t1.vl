// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: n views a temporary dropped at the end of the statement
// EXPECT: hello
struct H<A: Allocator> { b: Buf<A> }
impl H<Gpa> { fn view(self) -> [u8] { self.b.as_slice() } }
fn mk(gpa: Gpa) -> H<Gpa> { var b = Buf::new_in(gpa); b.push_str("hello"); H { b: b } }

fn main(gpa: Gpa) -> i32 {
    let n = mk(gpa).view();
    println(n);
    0
}
