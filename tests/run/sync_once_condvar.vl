// XFAIL: gap 2: compile type error: unresolved import 'std::sync::Condvar'
// (0.21) std::sync::Once runs its function once whatever the threads
// calling it; Condvar: a consumer waits until producers have filled a
// Mutex's queue, under the lock.
// EXPECT: once 1 true
// EXPECT: consumed 4000 7998000

use std::thread;
use std::sync::Condvar; use std::sync::Mutex; use std::sync::Once;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

static INIT: Once = Once::new();
static RUNS: AtomicI64 = AtomicI64::new(0i64);
static TICKET: AtomicI64 = AtomicI64::new(0i64);

fn main(gpa: Gpa) {
    thread::scope(|s| ({ let s = s; {
        for _ in 0..4 {
            s.spawn(|| {
                INIT.call_once(|| { RUNS.fetch_add(1, Ordering::Relaxed); });
                0
            });
        }
        0
    } }));
    println("once {} {}", RUNS.load(Ordering::SeqCst), INIT.is_completed());

    let q: Mutex<Vec<i64, Gpa>> = Mutex::new(Vec::new_in(gpa));
    let cv = Condvar::new();
    let total = thread::scope(|s| ({ let s = s; {
        for _ in 0..4 {
            // (0.20: a scoped thread borrows q and cv; its number from a
            // ticket, as a sink closure would move them)
            s.spawn(|| {
                let k = TICKET.fetch_add(1, Ordering::Relaxed);
                for i in 0..1000 {
                    q.with(|v| v.push(k * 1000 + i));
                    cv.notify_one();
                }
                0
            });
        }
        let c = s.spawn(|| {
            let mut got: i64 = 0;
            let mut sum: i64 = 0;
            while got < 4000 {
                let (n, t) = cv.wait_then(q, |v| v.len() > 0, |v| {
                    let mut t: i64 = 0;
                    let n = v.len();
                    while v.len() > 0 { t += v.pop().unwrap(); }
                    (n, t)
                });
                got += n as i64;
                sum += t;
            }
            (got, sum)
        });
        c.join().unwrap()
    } }));
    println("consumed {} {}", total.0, total.1);
}
