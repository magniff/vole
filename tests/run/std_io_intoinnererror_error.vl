// Runs on std since 0.27.2's switch.
// The std item(s): std::io IntoInnerError::error.
// EXPECT: WriteZero
use std::io::{BufWriter, ErrorKind, Write, self};

struct Full;

impl Write for Full {
    fn write(&mut self, _buf: &[u8]) -> io::Result<usize> {
        Ok(0)
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

fn main() {
    let mut b = BufWriter::new(Full);
    b.write_all(&[1]).unwrap();
    let e = b.into_inner().err().unwrap();
    let err: &io::Error = e.error();
    println("{:?}", err.kind());
}
