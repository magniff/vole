// XFAIL: gap 25: the IR, asm or places CHECK lines no longer match the translation (std's names, the surface): to update by...
// FLAGS: -C target-feature=+aarch64.crc
// EXPECT: 6673307777
// CHECK: fn main
// CHECK: = const 6673307777
// CHECK-NOT: = intr.
// CHECK-NOT: = vsplat
// CHECK: fn std.
// (0.19 T6) Constant vectors fold through std::arch's intrinsics, as the
// instructions compute (-O0 runs them: the same output): saturating and
// absolute differences, compares and the bitwise select they feed,
// permutes, bit counts and reversals, shifts, halving, reductions, lanes,
// and CRC-32/CRC-32C; the whole function is one constant.
use std::arch::aarch64::__crc32cd; use std::arch::aarch64::__crc32w;
use std::arch::aarch64::vabdq_u8; use std::arch::aarch64::vaddq_u8;
use std::arch::aarch64::vaddvq_u8; use std::arch::aarch64::vbslq_u8;
use std::arch::aarch64::vceqq_u8; use std::arch::aarch64::vclzq_u8;
use std::arch::aarch64::vcntq_u8; use std::arch::aarch64::vdupq_n_s16;
use std::arch::aarch64::vdupq_n_u8; use std::arch::aarch64::vgetq_lane_u8;
use std::arch::aarch64::vhaddq_s16; use std::arch::aarch64::vmaxvq_u8;
use std::arch::aarch64::vminvq_s16; use std::arch::aarch64::vqaddq_u8;
use std::arch::aarch64::vqsubq_s16; use std::arch::aarch64::vrbitq_u8;
use std::arch::aarch64::vshrq_n_s16; use std::arch::aarch64::vshrq_n_u8;
use std::arch::aarch64::vzip1q_u8;

// Constant vectors fold through std::arch's intrinsics: nothing of this
// is computed at run time.
fn folded() -> u64 {
    let a = vdupq_n_u8(200u8);
    let b = vdupq_n_u8(100u8);
    let s = vqaddq_u8(a, b);
    let d = vabdq_u8(b, a);
    let m = vceqq_u8(s, vdupq_n_u8(255u8));
    let pick = vbslq_u8(m, d, a);
    let z = vzip1q_u8(pick, pick);
    let bits = vaddq_u8(vcntq_u8(vrbitq_u8(vdupq_n_u8(6u8))), vclzq_u8(vshrq_n_u8(b, 3)));
    let h = vhaddq_s16(vdupq_n_s16(-7), vqsubq_s16(vdupq_n_s16(-32768), vdupq_n_s16(5i16)));
    let r = vmaxvq_u8(z) as u64 * 1000000 + vgetq_lane_u8(bits, 3) as u64 * 10000
        + (vminvq_s16(vshrq_n_s16(h, 2)) as i64 + 10000) as u64 + vaddvq_u8(b) as u64;
    r + __crc32cd(0xffffffffu32, 0x1234567890u64) as u64 + __crc32w(7u32, 99u32) as u64
}

fn main() {
    // (another architecture compiles it, never runs it; crc is in the
    // build, see FLAGS)
    if !(std::arch::has("neon") && std::arch::has("crc")) {
        println("6673307777");
        return;
    }
    println("{}", folded());
}
