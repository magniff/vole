// RULE: F4.1
// A blanket impl beside an impl for a reference: `impl<T: Show> Describe
// for T` applies to every Show type, `impl<'a, T: Show> Show for &'a T`
// to a reference to one, and the two do not overlap.
// EXPECT: 7
// EXPECT: 7
trait Show {
    fn show(&self) -> i64;
}

trait Describe {
    fn describe(&self) -> i64;
}

struct S {
    n: i64,
}

impl Show for S {
    fn show(&self) -> i64 {
        self.n
    }
}

impl<'a, T: Show> Show for &'a T {
    fn show(&self) -> i64 {
        (**self).show()
    }
}

impl<T: Show> Describe for T {
    fn describe(&self) -> i64 {
        self.show()
    }
}

fn main() {
    let s = S { n: 7 };
    println("{}", s.describe());
    let r = &s;
    println("{}", r.show());
}
