// The std item(s): std::sync::atomic Atomic; Atomic::new; Atomic::load; Atomic::store; Atomic::swap; Atomic::compare_exchange; Atomic::compare_exchange_weak; Atomic::fetch_add; Atomic::fetch_sub; Atomic::fetch_max; Atomic::fetch_min; Atomic::fetch_and; Atomic::fetch_nand; Atomic::fetch_or; Atomic::fetch_xor; Atomic::into_inner; Atomic::get_mut; Atomic::impl Debug; Atomic::impl Default; Ordering.
// EXPECT: 5 8
// EXPECT: Ok(8) Err(1)
// EXPECT: Ok(1)
// EXPECT: 4 9 20 -3
// EXPECT: -1 -2
// EXPECT: false true true false
// EXPECT: 250 4 255
// EXPECT: 8 0 AcqRel
use std::sync::atomic::{AtomicBool, AtomicI32, AtomicI64, AtomicU8, AtomicUsize, Ordering};

fn main() {
    let a = AtomicI64::new(5);
    println("{} {}", a.fetch_add(3, Ordering::SeqCst), a.load(Ordering::Relaxed));
    println("{:?} {:?}", a.compare_exchange(8, 1, Ordering::AcqRel, Ordering::Acquire),
        a.compare_exchange(8, 2, Ordering::SeqCst, Ordering::Relaxed));
    println("{:?}", a.compare_exchange_weak(1, 4, Ordering::Release, Ordering::Relaxed));
    println("{} {} {} {:?}", a.swap(9, Ordering::Relaxed), a.fetch_max(20, Ordering::SeqCst),
        a.fetch_min(-3, Ordering::AcqRel), a);
    a.store(-1, Ordering::Release);
    println("{} {}", a.fetch_sub(1, Ordering::Acquire), a.into_inner());
    let b = AtomicBool::new(false);
    println("{} {} {} {}", b.fetch_or(true, Ordering::SeqCst), b.fetch_and(true, Ordering::SeqCst),
        b.fetch_xor(true, Ordering::SeqCst), b.load(Ordering::SeqCst));
    let u = AtomicU8::new(250);
    println("{} {} {}", u.fetch_add(10, Ordering::SeqCst), u.fetch_nand(0xf0, Ordering::SeqCst),
        u.load(Ordering::SeqCst));
    let mut m = AtomicI32::new(7);
    *m.get_mut() += 1;
    let d: AtomicUsize = Default::default();
    println("{:?} {:?} {:?}", m, d, Ordering::AcqRel);
}
