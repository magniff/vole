// From the g302qual review (form f08_generic_method).
// EXPECT: 2 1 2
trait A { fn g<U: Copy>(&self, u: U) -> i64; }
trait B { fn g<U: Copy>(&self, u: U) -> i64; }
struct S;
impl A for S { fn g<U: Copy>(&self, _u: U) -> i64 { 1 } }
impl B for S { fn g<U: Copy>(&self, _u: U) -> i64 { 2 } }

fn main() {
    let s = S; let f = <S as B>::g::<u8>; let h = <S as A>::g::<i64>;
    println("{} {} {}", f(&s, 1u8), h(&s, 3), <S as B>::g::<u16>(&s, 4u16));
}
