// XFAIL: RT-72: a trait's default method calling its own trait's `drop` is refused with E0040 at the instance (0.30.2)
// rustc prints the EXPECT lines. Since v0.30.1 at least. From the
// re-review of g302index.
// EXPECT: closer 1
// EXPECT: end
// EXPECT: Drop 1
trait Closer {
    fn drop(&mut self);

    fn close(&mut self) {
        self.drop();
    }
}

struct W<T> {
    t: T,
    k: i64,
}

impl<T> Closer for W<T> {
    fn drop(&mut self) {
        println("closer {}", self.k);
    }
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn main() {
    let mut a = W { t: 1i64, k: 1 };
    a.close();
    println("end");
}
