// RULE: F8.3, F8.4
// RT-C301-8 review (C1, form f65b_infer_arg_value): `<S as Conv<_>>::K` and a call through `Conv<_>` with one impl.
// rustc prints the EXPECT lines.
// EXPECT: 8 8
trait Conv<X> { const K: i64; fn c(&self, x: X) -> i64; }
struct S;
impl Conv<u8> for S { const K: i64 = 8; fn c(&self, _x: u8) -> i64 { 8 } }
fn main() { let s = S; println("{} {}", <S as Conv<_>>::K, <S as Conv<_>>::c(&s, 1u8)); }
