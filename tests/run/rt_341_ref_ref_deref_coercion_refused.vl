// XFAIL: RT-341: `&&B` coerced to `&i64` through a reference and then Deref is refused (0.30.2)
// rustc prints the EXPECT line. Since v0.30.1 at least. From the
// re-review of g302index.
// EXPECT: 1 1
use std::ops::Deref;

trait MyDeref {
    fn deref(&self) -> &i64;
}

struct B {
    a: i64,
}

impl Deref for B {
    type Target = i64;

    fn deref(&self) -> &i64 {
        &self.a
    }
}

static Z: i64 = 77;

impl MyDeref for &B {
    fn deref(&self) -> &i64 {
        &Z
    }
}

fn take(x: &i64) -> i64 {
    *x
}

fn main() {
    let b = B { a: 1 };
    let r = &b;
    let rr = &r;
    println("{} {}", take(rr), **r);
}
