// RULE: D2.10
// (0.30.1) What the packed check lets through, as rustc does: a field
// of a `packed(4)` struct whose alignment is 4 (`&p.x` of an i32 is
// aligned), a built-in comparison of a packed scalar (`p.x == 2` reads
// the field, no reference), and copies of a packed array, sliced and
// iterated as a local.
// EXPECT: 5
// EXPECT: true
// EXPECT: 7 2
#[repr(C, packed(4))]
struct P4 { a: u8, x: i32 }

#[repr(C, packed)]
struct P { a: u8, x: i64, arr: [i64; 2] }

fn main() {
    let p4 = P4 { a: 1, x: 5 };
    let rx = &p4.x;
    println("{}", *rx);
    let p = P { a: 1, x: 2, arr: [3, 4] };
    println("{}", p.x == 2);
    let arr = p.arr;
    let s: i64 = arr.iter().sum();
    println("{} {}", s, arr[..].len());
}
