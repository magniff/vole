// RULE: D17.1
// (0.27.1) A `requires` on a by-value non-`Copy` parameter: the `$pre` call
// reads a bit copy, then the call moves the argument.
// RUSTC: none contract clauses are not Rust

struct N {
    v: i64,
}

fn eat(n: N) -> i64
    requires n.v > 0
{
    n.v
}

fn main() {
    let n = N { v: 3 };
    println("{}", eat(n));
}
// EXPECT: 3
// (passes on std: was XFAIL, std has no contract_check, which a contract's lowering calls (std))
