// Insertion sort of an array of structs by a float key, stable for ties.
// EXPECT: 2B 6F 4D 1A 3C 5E
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy)] struct Item { key: f64, id: i32, tag: u8 }

fn main() -> i64 {
    let mut items: [Item; 6] = [
        Item { key: 3.5, id: 1, tag: 65 },
        Item { key: -1.0, id: 2, tag: 66 },
        Item { key: 3.5, id: 3, tag: 67 },
        Item { key: 0.0, id: 4, tag: 68 },
        Item { key: 10.25, id: 5, tag: 69 },
        Item { key: -1.0, id: 6, tag: 70 },
    ];
    let mut i: i64 = 1;
    while i != 6 {
        let cur = items[i as usize];
        let mut j = i - 1;
        while j >= 0 {
            if items[j as usize].key <= cur.key { break; }
            items[(j + 1) as usize] = items[j as usize];
            j -= 1;
        }
        items[(j + 1) as usize] = cur;
        i += 1;
    }
    i = 0;
    while i != 6 {
        unsafe { printf(c"%d%c ", items[i as usize].id, items[i as usize].tag); }
        i += 1;
    }
    unsafe { printf(c"\n"); }
    0
}
