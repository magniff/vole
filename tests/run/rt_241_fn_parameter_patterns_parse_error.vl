// XFAIL: RT-241: a function's parameter cannot be a pattern other than a name, `mut name` or `_`: `fn f((a, b): (i64, i64))`, `fn g(S { x, y }: S)`, `fn h(T2(a, b): T2)`, `fn k(&x: &i64)` and a method's `(a, b): (i64, i64)` are parser errors; closures take these patterns, and the guide lists neither as missing (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt).
// EXPECT: 3 7 11 5 13
struct S {
    x: i64,
    y: i64,
}

struct T2(i64, i64);

fn f((a, b): (i64, i64)) -> i64 {
    a + b
}

fn g(S { x, y }: S) -> i64 {
    x + y
}

fn h(T2(a, b): T2) -> i64 {
    a + b
}

fn k(&x: &i64) -> i64 {
    x
}

impl S {
    fn m(&self, (a, b): (i64, i64)) -> i64 {
        self.x + a + b
    }
}

fn main() {
    let s = S { x: 3, y: 4 };
    println("{} {} {} {} {}", f((1, 2)), g(s), h(T2(5, 6)), k(&5), S { x: 1, y: 0 }.m((5, 7)));
}
