// XFAIL: gap 17: compile type error: cannot deref non-pointer type 'i64'
// Views through references (0.18.1, the eval's task 15): a view taken
// through a reference local or a pattern's reference binding (`s` of
// `match o { O::Str(s) => s.as_slice() }`) views what it points to, not
// the reference: it may be returned, stored or kept after the binding's
// scope. A place where `&T` is expected is borrowed (`unknown(it)` for
// `it` of `iter()`), `&&T` reads through to `&T` (receivers too), and
// `cmp_of(x, y)` of slices infers T.
// EXPECT: 1
// EXPECT: 1
// EXPECT: 25 -1 3
use std::alloc::Allocator; use std::ops::Not; enum Opnd<A: Allocator> { Col(Vec<u8, A>), Int(i64) }
enum Cond<A: Allocator> { Cmp(Opnd<A>, i64, Opnd<A>), Not(i64) }
#[derive(Copy)] enum P<'a> { Cmp(&'a [u8], i64, &'a [u8]), Not(i64) } impl Clone for P<'_> {
    fn clone(&self) -> Self { *self }
}
struct Q<A: Allocator> { conds: Vec<Cond<A>, A> }

fn res(o: &Opnd<Gpa>) -> Result<&[u8], i64> {
    match o { Opnd::Col(n) => Ok(n.as_slice()), Opnd::Int(_) => Err(1i64) }
}

fn plan(q: &Q<Gpa>, gpa: Gpa) -> Result<Vec<P<'_>, Gpa>, i64> {
    let mut out: Vec<P<'_>, Gpa> = Vec::new_in(gpa);
    for i in 0..q.conds.len() {
        let pc = match q.conds[i] {
            Cond::Not(a) => P::Not(*a),
            Cond::Cmp(l, c, r) => {
                let pl = res(l)?;
                let pr = res(r)?;
                P::Cmp(pl, *c, pr)
            }
        };
        out.push(pc);
    }
    Ok(out)
}

fn names(cs: &Vec<Cond<Gpa>, Gpa>, i: i64, out: &mut Vec<&[u8], Gpa>) {
    match cs[i as usize] {
        Cond::Cmp(Opnd::Col(n), _, _) => out.push(n.as_slice()),
        _ => {}
    }
}

struct S<A: Allocator> { v: Vec<u8, A> }
enum O<A: Allocator> { Str(Vec<u8, A>), Int(i64) }
fn f1(o: &S<Gpa>) -> &[u8] { let s = o.v; s.as_slice() }
fn f2(o: &O<Gpa>) -> &[u8] { match o { O::Str(s) => s.as_slice(), O::Int(_) => b"" } }
#[derive(Clone, Copy)] struct Item<'a> { name: &'a [u8], qty: i64 }
#[derive(Copy)] enum Val<'a> { Str(&'a [u8]), Int(i64) } impl Clone for Val<'_> {
    fn clone(&self) -> Self { *self }
}
struct Table<A: Allocator> { rows: Vec<i64, A> }
impl Table<Gpa> { fn cell(&self, i: i64) -> i64 { self.rows[i as usize] } }
fn unknown(it: Item<'_>) -> i64 { it.qty }

fn cmpv(a: Val<'_>, b: Val<'_>) -> i64 {
    match (a, b) {
        (Val::Str(x), Val::Str(y)) => x.cmp(&y) as i64,
        (Val::Int(x), Val::Int(y)) => x - y,
        _ => 0,
    }
}

fn total(t: &Table<Gpa>) -> i64 { t.cell(0) }

fn run(t: &Table<Gpa>, items: &Vec<Item<'_>, Gpa>) -> i64 {
    let mut s: i64 = 0;
    for it in items.iter().copied() { s += unknown(it); }
    let tr = t;
    s += tr.cell(0);
    s += total(tr);
    s + items.len() as i64
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.push(b'a');
    let mut cs: Vec<Cond<Gpa>, Gpa> = Vec::new_in(gpa);
    cs.push(Cond::Cmp(Opnd::Col(v), 3i64, Opnd::Int(1i64)));
    let q = Q { conds: cs };
    match plan(&q, gpa) { Ok(p) => println("{}", p.len()), Err(e) => println("{}", e) }
    let mut o: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    names(&q.conds, 0, &mut o);
    println("{}", o.len());
    let mut items: Vec<Item<'_>, Gpa> = Vec::new_in(gpa);
    items.push(Item { name: b"a", qty: 2 });
    let mut r: Vec<i64, Gpa> = Vec::new_in(gpa);
    r.push(11);
    let t = Table { rows: r };
    let a = Val::Str("a");
    let b = Val::Str("b");
    let s = S { v: Vec::new_in(gpa) };
    let e = O::Str(Vec::new_in(gpa));
    let n = cmpv(Val::Int(5i64), Val::Int(2i64)) + f1(&s).len() as i64 + f2(&e).len() as i64;
    println("{} {} {n}", run(&t, &items), cmpv(a, b));
}
