// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters FlatMap::impl Iterator.
// EXPECT: Some(1) Some(2) Some(2) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 0, 2], gpa);
    let mut it = s.iter().flat_map(|x| std::iter::repeat_n(*x, *x as usize));
    let a = it.next();
    let b = it.next();
    let c = it.next();
    println("{:?} {:?} {:?} {:?}", a, b, c, it.next().map(|x| x + 1).filter(|x| *x > 9));
}
