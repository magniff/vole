// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 1 (view's last use before the push on every path)
// EXPECT: 1
fn g(v: &mut Vec<i64, Gpa>) -> i64 {
    let sl = v.as_slice();
    if sl[0] == 1 { return sl[0]; }
    v.push(2);
    0
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", g(&mut v));
    0
}
