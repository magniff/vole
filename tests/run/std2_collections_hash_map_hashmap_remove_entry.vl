// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::remove_entry.
// EXPECT: Some((7, 1)) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(7, 1);
    let a = m.remove_entry(&7);
    println("{:?} {:?}", a, m.remove_entry(&7));
}
