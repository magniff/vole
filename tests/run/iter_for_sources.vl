// XFAIL: gap 17: compile type error: expected 'Iter<i64>', got 'Copied<Iter<i64>>'
// `for` over std's iterator sources (0.14): a Vec by value and through a
// pointer, `v.iter()`, a HashMap's entries, keys and values, ranges as
// values (`a..b`, `a..=b`, partly used up by `next`), a user Iterator,
// a type with `iter`, and a generic function iterating whatever it
// is given.
// EXPECT: vec 3 4 5 | 30 40 50 | 4 5 6
// EXPECT: map 3030 3 30
// EXPECT: counter 1 2 3 4
// EXPECT: bag 3 4 5
// EXPECT: ranges 45 10 0 1 2 3 4 | 2 3 | 7 8 9 | 9
// EXPECT: u8 32640 256 1515
// EXPECT: generic 6 12 12 12 3
use std::hash::FixedState;
use std::slice; use std::alloc::Allocator; use std::collections::HashMap;

#[derive(Clone, Copy)] struct Counter { n: i64, limit: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n < self.limit {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

struct Bag<A: Allocator> { items: Vec<i64, A> }

impl Bag<Gpa> {
    fn iter(&self) -> slice::Iter<'_, i64> {
        self.items.iter().copied()
    }
}

fn total<I>(it: I) -> i64 {
    let mut s: i64 = 0;
    for x in it {
        s += x;
    }
    s
}

fn show(x: i64) {
    print(" ");
    print("{}", x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(4);
    v.push(5);
    print("vec");
    for x in v {
        show(x);
    }
    print(" |");
    for x in v {
        show(x * 10);
    }
    print(" |");
    for x in v.iter().copied() {
        show(x + 1);
    }
    println("");

    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    let mut s: i64 = 0;
    for (k, x) in m {
        s += k * 1000 + x;
    }
    let mut ks: i64 = 0;
    for k in m.keys().copied() {
        ks += k;
    }
    let mut vs: i64 = 0;
    for x in m.values().copied() {
        vs += x;
    }
    print("map");
    show(s);
    show(ks);
    show(vs);
    println("");

    print("counter");
    let c = Counter { n: 0, limit: 4 };
    for x in c {
        show(x);
    }
    println("");

    print("bag");
    let b = Bag { items: v.clone() };
    for x in b {
        show(x);
    }
    println("");

    print("ranges");
    let mut t: i64 = 0;
    for x in (0..10) {
        t += x;
    }
    show(t);
    let r = 0i64..5i64;
    show(total(r) as i64);
    for x in r {
        show(x);
    }
    print(" |");
    let mut it = 1i64..4i64;
    it.next();
    for x in it {
        show(x);
    }
    print(" |");
    let mut inc = 6i64..=9i64;
    inc.next();
    for x in inc {
        show(x);
    }
    print(" |");
    let mut last = 8i64..=9i64;
    last.next();
    last.next();
    last.next();
    for x in last {
        show(100 + x);
    }
    show(last.start);
    println("");

    print("u8");
    let mut n: i64 = 0;
    for x in 0..=255u8 {
        n += x as i64;
    }
    show(n);
    let mut count: i64 = 0;
    for _ in 0u8..=255 {
        count += 1;
    }
    show(count);
    let mut tail: i64 = 0;
    let top = 250..=255u8;
    for x in top {
        tail += x as i64;
    }
    show(tail);
    println("");

    print("generic");
    show(total(1i64..4i64));
    show(total(v.iter().copied()));
    show(total(v.clone()));
    show(total(v.as_slice()));
    show(total(Counter { n: 0, limit: 2 }));
    println("");
    0
}
