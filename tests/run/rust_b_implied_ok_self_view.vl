// RULE: D4.6
// (0.27.2.1) `&self` on an impl for `[T]`: `self: &'s [T]` implies `T: 's`,
// so borrowing an element and the rest for 's is well-formed.
// EXPECT: 1 1
trait Split<T> {
    fn first_rest(&self) -> Option<(&T, &[T])>;
}

impl<T> Split<T> for [T] {
    fn first_rest(&self) -> Option<(&T, &[T])> {
        if self.len() == 0 { Option::None } else { Option::Some((&self[0], &self[1..])) }
    }
}

fn main() {
    let a: i64 = 1;
    let b = [&a, &a];
    let s: &[&i64] = &b;
    let (x, rest) = s.first_rest().unwrap();
    println("{} {}", **x, rest.len());
}
