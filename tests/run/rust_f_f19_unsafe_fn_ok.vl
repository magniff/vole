// EDITION: rust
// RULE: F19.3
// `unsafe fn(..) -> R` is a fn pointer type: a field and a parameter may
// have it, an `unsafe fn` is a value of it without `unsafe`, a safe fn
// coerces to it, and a call through it is in an `unsafe` block.
// EXPECT: 14 9
unsafe fn twice(x: i64) -> i64 {
    x * 2
}

fn add2(x: i64) -> i64 {
    x + 2
}

struct Table {
    op: unsafe fn(i64) -> i64,
}

fn apply(f: unsafe fn(i64) -> i64, x: i64) -> i64 {
    // SAFETY: twice and add2 have no precondition.
    unsafe { f(x) }
}

fn main() {
    let t = Table { op: twice };
    let safe: fn(i64) -> i64 = add2;
    let u: unsafe fn(i64) -> i64 = safe;
    print("{}", apply(t.op, 7));
    print(" ");
    println("{}", apply(u, 7));
}
