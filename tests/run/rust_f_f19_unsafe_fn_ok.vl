// EDITION: rust
// RULE: F19.3
// `unsafe fn(..) -> R` is a fn pointer type: a field and a parameter may
// have it, and it is called in an `unsafe` block.
// EXPECT: 14
unsafe fn twice(x: i64) -> i64 {
    x * 2
}

struct Table {
    op: unsafe fn(i64) -> i64,
}

fn apply(f: unsafe fn(i64) -> i64, x: i64) -> i64 {
    // SAFETY: twice has no precondition.
    unsafe { f(x) }
}

fn main() -> i64 {
    // (0.27.2: a fn pointer type does not carry `unsafe` yet, so taking
    // an unsafe fn as a value is the unsafe operation)
    // SAFETY: twice has no precondition.
    let t = unsafe { Table { op: twice } };
    std::print_int(apply(t.op, 7));
    println("");
    0
}
