// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops SubAssign.
// EXPECT: V { x: 7 }
use std::ops::SubAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl SubAssign for V {
    fn sub_assign(&mut self, rhs: V) {
        self.x -= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a -= V { x: 5 };
    println("{:?}", a);
}
