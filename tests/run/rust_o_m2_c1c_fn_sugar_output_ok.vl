// EXPECT: 2 8
// FLAGS: --check-alloc
// (re-review of M2, C1, form i01) `F::Output` of a closure and of a fn
// type under an Fn-sugar bound (refused as E0220 at d7f4aba3e).
fn app<F: Fn(i64) -> i64>(f: F, x: i64) -> F::Output { f(x) }
fn dbl(x: i64) -> i64 { x * 2 }
fn main() { println("{} {}", app(|x| x + 1, 1i64), app(dbl, 4i64)); }
