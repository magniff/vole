// EDITION: rust
// XFAIL: gap 3: compile type error: expected 'inout i64', got 'inout i32'
// inout on every kind of place, each changed once
// EXPECT: 2 2 2 2 2 2 2 2 2 2 2
use std::alloc::Allocator; #[derive(Clone, Copy)] struct I { a: i64 }
struct S<A: Allocator> { n: i64, i: I, arr: [i64; 2], v: Vec<i64, A>, ps: Vec<I, A> }
#[derive(Clone, Copy)] enum E { A(i64), B }
static mut G: i64 = 1;
fn bump(n: &mut i64) { *n += 1; }

fn main(gpa: Gpa) {
    let mut x: i64 = 1;
    let mut s = S {
        n: 1, i: I { a: 1 }, arr: [1i64, 1], v: Vec::new_in(gpa), ps: Vec::new_in(gpa),
    };
    s.v.push(1); s.ps.push(I { a: 1 });
    let mut t = (1, 1);
    let mut m = [[1i64, 1], [1i64, 1]];
    let mut e = E::A(1i64);
    bump(&mut x); bump(&mut s.n); bump(&mut s.i.a); bump(&mut s.arr[1]); bump(&mut s.v[0]);
    bump(&mut s.ps[0].a);
    bump(&mut t.1); bump(&mut m[1][0]);
    match &mut e { E::A(k) => bump(k), E::B => {} }
    bump(unsafe { &mut (*(&raw mut G)) });
    let mut en: i64 = 0; match e { E::A(k) => { en = k; } E::B => {} }
    let mut o: Option<i64> = Some(1i64);
    if let Some(k) = &mut o { bump(k); }
    let g_now = unsafe { G }; println(
        "{x} {} {} {} {} {} {} {} {en} {g_now} {}", s.n, s.i.a, s.arr[1], s.v[0], s.ps[0].a, t.1,
        m[1][0], o.unwrap());
}
