// Runs on std since its gap closed (0.27.3).
// The std item(s): std::result Result::as_mut.
// EXPECT: Ok(30)
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let mut c = a;
    if let Ok(x) = c.as_mut() {
        *x *= 10;
    }
    println("{:?}", c);
}
