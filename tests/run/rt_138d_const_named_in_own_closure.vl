// XFAIL: RT-138d: a constant named in a closure of its own value is refused as a cycle (const.cycle; "defined in terms of itself" before); rustc builds it (0.30.3)
// The closure's body needs the constant's type only, not its value:
// rustc builds this and prints the EXPECT line. vole makes a constant at
// each use from a copy of its value, the closure's use too, so the copy
// meets the constant again. Free form refused since 0.30.1 at least; the
// associated form crashed or hung before 0.30.2's mark.
// EXPECT: 6 6
struct S;

impl S {
    const C: fn(i64) -> i64 = |n| {
        if n == 0 {
            return 0;
        }
        let f = Self::C;
        f(n - 1) + 2
    };
}

const D: fn(i64) -> i64 = |n| if n == 0 { 0 } else { D(n - 1) + 3 };

fn main() {
    let c = S::C;
    println("{} {}", c(3), D(2));
}
