// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::size_hint.
// EXPECT: (4, Some(4)) (0, Some(4))

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let it = v.iter();
    println("{:?} {:?}", it.size_hint(), v.iter().filter(|x| **x > 2).size_hint());
}
