// RULE: D2.7
// (0.30.1, RT-33) `&mut b[..]` through a `b: &Box<[i64; 2], Gpa>`: the
// array is behind the shared reference, rustc's E0596 (vole has no
// `Box<[T]>`: a Box of an array stands for it).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*b' as mutable, which is behind a `&` reference
// ERROR: line 9, column 18
// ERROR-COUNT: 1
fn k(b: &Box<[i64; 2], Gpa>) {
    let m = &mut b[..];
    m[0] = 1;
}

fn main(gpa: Gpa) {
    let b = Box::new_in([1i64, 2], gpa);
    k(&b);
    println("{}", b[0]);
}
