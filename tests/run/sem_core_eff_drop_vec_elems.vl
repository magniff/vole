// EDITION: rust
// XFAIL: gap 16: the rust edition accepts the translation: rc 0; MVS effect
// Dropping a Vec drops its elements: a Drop that prints makes it io.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(&mut self) { println("dropped"); } }

#[no_io]
fn quiet(v: Vec<Noisy, Gpa>) -> i64 { v.len() as i64 }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Noisy, Gpa> = Vec::new_in(gpa);
    v.push(Noisy { n: 1 });
    println("{}", quiet(v));
    0
}
