// RULE: D2.4
// (0.27.1) A loan of the previous iteration live at the loop head: `x += 1`
// while `r = &x` is used after the loop.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 15, column 9
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let z: i64 = 0;
    let mut r = &z;
    let mut i = 0;
    while i < 2 {
        x += 1;
        println("{}", *r);
        r = &x;
        i += 1;
    }
}
