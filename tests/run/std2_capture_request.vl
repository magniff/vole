// EDITION: rust
// The std2 item(s): std::capture capture_next_frame, capture_pending, capture_cancel,
// take_capture, MAX_PATH: a frame-capture request made, read and served, from two threads.
// RUSTC: none (std::capture is vole's: Rust's std has no windows)
// EXPECT: false false
// EXPECT: true true
// EXPECT: true shots/a.ppm false
// EXPECT: true false
// EXPECT: false 0
// EXPECT: true 1024
// EXPECT: true é.ppm
use std::thread;
use std::capture::{MAX_PATH, capture_cancel, capture_next_frame, capture_pending, take_capture};

fn main(gpa: Gpa) {
    let mut out = String::new_in(gpa);
    println("{} {}", capture_pending(), take_capture(&mut out));
    println("{} {}", capture_next_frame("shots/a.ppm"), capture_pending());
    println("{} {} {}", take_capture(&mut out), out, capture_pending());
    capture_next_frame("b.ppm");
    capture_cancel();
    let long = String::from_in("x", gpa).repeat_in(MAX_PATH + 1, gpa);
    println("{} {}", !capture_next_frame(&long), capture_pending());
    out.clear();
    println("{} {}", take_capture(&mut out), out.len());
    let exact = String::from_in("y", gpa).repeat_in(MAX_PATH, gpa);
    println("{} {}", capture_next_frame(&exact), exact.len());
    thread::scope(|s| {
        s.spawn(|| {
            capture_next_frame("é.ppm");
        });
    });
    out.clear();
    println("{} {}", take_capture(&mut out), out);
}
