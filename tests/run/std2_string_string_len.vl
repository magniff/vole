// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::len.
// EXPECT: 3 4
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let a = String::from_in("abc", gpa);
    let b = String::from_in("\u{e9}\u{e9}", gpa);
    println("{} {}", a.len(), b.len());
}
