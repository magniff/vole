// EDITION: rust
// (0.26.3, decision 6) `a >> b` of u8s panics at -O0, where the overflow
// checks are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_shr_u8.vl:18:13: attempt to shift right with overflow

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: u8 = idu(255) as u8;
    let b: u8 = idu(8) as u8;
    println("before");
    let r = a >> b;
    println("after {}", r);
}
