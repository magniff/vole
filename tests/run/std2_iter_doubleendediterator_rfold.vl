// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter DoubleEndedIterator::rfold.
// EXPECT: 4321
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let t = v.iter().rfold(0i64, |a, x| a * 10 + x);
    println("{}", t);
}
