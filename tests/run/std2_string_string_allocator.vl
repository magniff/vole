// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::allocator.
// EXPECT: abc x
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let a: &Gpa = s.allocator();
    let t = String::from_in("x", a);
    println("{} {}", s, t);
}
