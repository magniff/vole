// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a16_nested_vec)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A struct holding a Vec in a nested Option: the callee writes its buffer.
use std::alloc::Allocator;
struct S<A: Allocator> { v: Option<Option<Vec<i64, A>>> }

fn poke(s: &S<Gpa>) -> bool {
    if let Some(Some(v)) = &s.v {
        let p = v.as_ptr() as *mut i64;
        // UNSAFE: test
        // SAFETY: test
        unsafe { *p = 9; }
    }
    true
}

fn f(s: &S<Gpa>) -> i64
    requires poke(s)
{
    1
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = S { v: Some(Some(v)) };
    println("{}", f(&s));
    if let Some(Some(v)) = &s.v { println("{}", v[0]); }
}
