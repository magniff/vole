// EDITION: rust
// RULE: AT1
// (0.27.2) `Cell<T>` is Send when `T` is (never Sync), so a `Cell` moves
// and a `&mut Cell` is Send too.
// EXPECT: 5 6
use std::cell::Cell;

fn send<T: Send>(t: T) -> T {
    t
}

fn main() {
    let c = send(Cell::new(5));
    let mut d = Cell::new(6);
    let m = send(&mut d);
    println("{} {}", c.get(), m.get());
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
