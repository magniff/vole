// XFAIL: RT-77: `<`, `!=` and the other comparisons call the type's inherent lt, ne or partial_cmp, not PartialOrd's and PartialEq's (0.30.2)
// Rust's `x < y` is `PartialOrd::lt(&x, &y)` and `x != y` is
// `PartialEq::ne(&x, &y)`: S's inherent lt, ne and partial_cmp are never
// called. vole calls them: with an inherent `lt` (L) `x < y` is false, with
// an inherent `ne` (N) `x != x` is true, and with an inherent partial_cmp (P)
// every comparison of S and of a struct deriving PartialOrd over S turns.
// RT-73's forms are mul, neg, not, add_assign, index, eq; these are the
// comparison operators' own names.
// EXPECT: true true false false false
// EXPECT: true true false false
use std::cmp::Ordering;

#[derive(Clone, Copy, PartialEq, Eq)]
struct L {
    k: i64,
}

impl L {
    fn lt(&self, other: &L) -> bool {
        self.k > other.k
    }

    fn ne(&self, other: &L) -> bool {
        true
    }
}

impl PartialOrd for L {
    fn partial_cmp(&self, other: &L) -> Option<Ordering> {
        Some(self.k.cmp(&other.k))
    }
}

#[derive(Clone, Copy, PartialEq)]
struct P {
    k: i64,
}

impl P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(other.k.cmp(&self.k))
    }
}

impl PartialOrd for P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(self.k.cmp(&other.k))
    }
}

fn main() {
    let x = L { k: 1 };
    let y = L { k: 2 };
    println("{} {} {} {} {}", x < y, x <= y, x > y, x >= y, x != x);
    let p = P { k: 1 };
    let q = P { k: 2 };
    println("{} {} {} {}", p < q, p <= q, p > q, p >= q);
}
