// EDITION: rust
// (0.27.1) borrowck.unchecked was this closure body's: it reached what it
// captures through a raw environment (docs/design/borrowck.md D10.4).
// (0.27.2) Its env is `&mut Env` (an FnMut closure, D19.4), so its body is
// checked like any other and the warning is retired.
// RULE: D19.4
// EXPECT: 7 10
fn first(v: &[i64]) -> &i64 {
    &v[0]
}

fn main() -> i32 {
    let a = [7, 8];
    let mut n = 0;
    let mut bump = || n += 10;
    bump();
    println("{} {}", *first(&a[..]), n);
    0
}
