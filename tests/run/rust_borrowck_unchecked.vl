// EDITION: rust
// (0.27.1) borrowck.unchecked: a closure body reaches what it captures
// through the raw environment, so its borrows are checked against each
// other and its own locals only (docs/design/borrowck.md D10.4; 0.27.2
// types the environment); the enclosing body keeps the captures borrowed.
// Once a closure body; a plain function gets none (its borrows are
// checked). The runner passes `--allow=borrowck.unchecked` to every
// other rust-edition case.
// RULE: D10.4
// WARNING: warning[borrowck.unchecked]: the borrows inside this closure are checked against each other only
// EXPECT: 7 10
fn first(v: &[i64]) -> &i64 {
    &v[0]
}

fn main() -> i32 {
    let a = [7, 8];
    let mut n = 0;
    let mut bump = || n += 10;
    bump();
    println("{} {}", *first(&a[..]), n);
    0
}
