// RUSTC-EDITION: 2024
// RULE: D21.2
// (0.27.2.1) The hidden closure holds `x` only: its lifetime is 'a, the
// one member every loan in it outlives (rustc accepts).
// EXPECT: 1
fn one<'a, 'b>(x: &'a i32, y: &'b i32) -> impl Fn() -> i32 {
    move || *x
}

fn main() {
    let a: i32 = 1;
    let b: i32 = 2;
    let f = one(&a, &b);
    println("{}", f());
}
