// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops RangeBounds.
// EXPECT: 3 2
use std::ops::{Bound, RangeBounds};

fn width<R: RangeBounds<i64>>(r: R) -> i64 {
    let s = match r.start_bound() {
        Bound::Included(x) => *x,
        Bound::Excluded(x) => *x + 1,
        Bound::Unbounded => 0,
    };
    let e = match r.end_bound() {
        Bound::Included(x) => *x + 1,
        Bound::Excluded(x) => *x,
        Bound::Unbounded => 100,
    };
    e - s
}

fn main() {
    println("{} {}", width(1..4), width(..=1));
}
