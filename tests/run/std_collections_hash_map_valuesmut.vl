// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map ValuesMut.
// EXPECT: 1
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::ValuesMut;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let v: ValuesMut<'_, i64, i64> = m.values_mut();
    println("{}", v.count());
}
