// (0.30.2, RT-466's family) A temporary is a slot of the frame too: four
// arrays of 2^60 bytes made for borrows, the fourth refused.
// FLAGS: --target aarch64-macos
// ERROR: frame.too_big
// ERROR: line 15, column 52
#[inline(never)]
fn first(a: &[u8; 1usize << 60]) -> u8 {
    a[0]
}

#[inline(never)]
fn call(n: usize) -> u8 {
    if n > 5 {
        return first(&[7u8; 1usize << 60]) + first(&[8u8; 1usize << 60])
            + first(&[9u8; 1usize << 60]) + first(&[1u8; 1usize << 60]);
    }
    0
}

fn main() {
    let n = std::env::args().count();
    println("{}", call(n));
}
