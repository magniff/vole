// EDITION: rust
// RULE: D7.3
// (0.27.3) `b.put(&make(b.tag()).v)`: the argument is a temporary
// (a field of it) holding the shared loan of `b.tag()`, dropped at the statement's end,
// after the call, and its type has a Drop impl, so the loan is live where
// the reservation activates (rustc's E0502, "the immutable borrow might be
// used here, when that temporary is dropped"). The translator's
// `b.extend_from_slice(format_in(.., b.allocator()).as_bytes())` is this
// shape: its String<&A> is the temporary.
// ERROR: error[borrowck.conflict]
// ERROR: line 47, column 5
// ERROR-COUNT: 1
struct Tag {
    k: i64,
}

struct B {
    tag: Tag,
    n: i64,
}

struct Held<'a> {
    t: &'a Tag,
    v: i64,
}

impl<'a> Drop for Held<'a> {
    fn drop(&mut self) {}
}

impl B {
    fn tag(&self) -> &Tag {
        &self.tag
    }

    fn put(&mut self, x: &i64) {
        self.n += *x;
    }
}

fn make(t: &Tag) -> Held<'_> {
    Held { t: t, v: t.k }
}

fn main() {
    let mut b = B { tag: Tag { k: 3 }, n: 0 };
    b.put(&make(b.tag()).v);
    println("{}", b.n);
}
