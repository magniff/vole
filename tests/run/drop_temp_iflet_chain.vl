// (0.29.0) An `else if let` chain: each scrutinee's temporaries are dropped
// before the next `else` is tried (rustc's rule from its 2024 edition),
// so none of them outlives its own `if let`; an `else if` condition's are
// dropped after the condition, as before. The output is rustc 2024's
// (tools/rustc-twin.sh).
// RUSTC-EDITION: 2024
// EXPECT: chain -9
// EXPECT: d1
// EXPECT: d2
// EXPECT: d3
// EXPECT: d4
// EXPECT: none 0
// EXPECT: d5
// EXPECT: after
// EXPECT: chain -2
// EXPECT: d1
// EXPECT: d2
// EXPECT: d3
// EXPECT: fourth 4
// EXPECT: d4
// EXPECT: after
// EXPECT: chain 0
// EXPECT: d1
// EXPECT: d2
// EXPECT: d3
// EXPECT: third
// EXPECT: after
// EXPECT: chain 3
// EXPECT: d1
// EXPECT: second 7
// EXPECT: d2
// EXPECT: after
// EXPECT: chain 9
// EXPECT: first 9
// EXPECT: d1
// EXPECT: after
struct T {
    id: i64,
    v: i64,
}

fn mk(id: i64, v: i64) -> T {
    T { id: id, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn big(t: &T) -> Option<i64> {
    if t.v > 5 { Some(t.v) } else { None }
}

fn own(t: T) -> Result<T, T> {
    if t.v > 5 { Ok(t) } else { Err(t) }
}

fn chain(v: i64) {
    println("chain {v}");
    if let Some(n) = big(&mk(1, v)) {
        println("first {n}");
    } else if let Some(n) = big(&mk(2, v + 4)) {
        println("second {n}");
    } else if big(&mk(3, v + 6)).is_some() {
        println("third");
    } else if let Ok(t) = own(mk(4, v + 8)) {
        println("fourth {}", t.id);
    } else {
        let l = mk(5, 0);
        println("none {}", l.v);
    }
    println("after");
}

fn main() -> i32 {
    chain(-9);
    chain(-2);
    chain(0);
    chain(3);
    chain(9);
    0
}
