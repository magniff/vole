// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::filter.
// EXPECT: Some(4) None None
use std::option::Option;

fn main() {
    let none: Option<i64> = None;
    println("{:?} {:?} {:?}", Some(4).filter(|x| *x % 2 == 0), Some(3).filter(|x| *x % 2 == 0),
        none.filter(|x| *x % 2 == 0));
}
