// XFAIL: RT-208: a method of a trait not in scope is taken by the method probe (wrong code): form z03 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 1 0
// EXPECT: 101 1
mod a {
    pub trait T1 { fn m(self) -> i64; }
    impl<'x> T1 for &'x super::S { fn m(self) -> i64 { 1 } }
}

pub struct S { k: i64 }
impl S { fn m(&mut self) -> i64 { self.k += 1; self.k + 100 } }
fn main() { let mut s = S { k: 0 }; let r = s.m(); println("{} {}", r, s.k); }
