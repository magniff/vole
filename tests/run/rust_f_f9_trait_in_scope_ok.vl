// RULE: F9.2
// Of several traits' `fmt` for u32 (Display, Debug, Binary, LowerHex..),
// only Binary is in scope: `self.v.fmt(f)` is Binary's (as rustc).
// EXPECT: 101
use std::fmt::{Binary, Formatter};

struct W {
    v: u32,
}

impl Binary for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main() {
    println("{:b}", W { v: 5u32 });
}
