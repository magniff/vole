// A `where` predicate whose left side is a generic type with a qualified path argument, `Option<<T as A>::Out>: Default`, and one that is a qualified path (v0.30.1: "expected '{', got 'Option'"; rustc 3)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: 3
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn k<T: A>() -> i64
    where
        Option<<T as A>::Out>: Default,
        <T as A>::Out: B,
{
    let v: Option<<T as A>::Out> = Default::default();
    v.is_none() as i64 + <<T as A>::Out as B>::D
}

fn main() {
    println("{}", k::<S>());
}
