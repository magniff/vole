// (0.28.0) `volec test` on std: a #[property] over generated integers
// and a Vec holds for its hundred cases (std::test's Gen and Arbitrary);
// the test program lists what it has.
// FLAGS: --test-build
// ARGS: --vole-list
// EXPECT: vole-test: test adds rust_t_test_build_property.vl:10
// EXPECT: vole-test: property commutes rust_t_test_build_property.vl:15
// EXPECT: vole-test: property reverses rust_t_test_build_property.vl:20
#[test]
fn adds() {
    assert(1 + 1 == 2);
}

#[property]
fn commutes(a: i64, b: i64) {
    assert(a.wrapping_add(b) == b.wrapping_add(a));
}

#[property]
fn reverses(v: Vec<i64, Gpa>) {
    let mut w = v;
    w.as_mut_slice().reverse();
    w.as_mut_slice().reverse();
    assert(w.len() < 1000000);
}

fn main() {}
