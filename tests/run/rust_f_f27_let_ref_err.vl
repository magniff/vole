// RULE: F27.2
// (0.27.6) `let ref z = a;` borrows `a`: moving `a` while `z` is live is
// rustc's E0505.
// ERROR: error[borrowck.move_borrowed]: cannot move out of 'a' because it is borrowed
struct P {
    x: i64,
}

fn take(p: P) -> i64 {
    p.x
}

fn main() {
    let a = P { x: 7 };
    let ref z = a;
    let k = take(a);
    println("{} {}", k, z.x);
}
