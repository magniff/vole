// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str str::split_terminator.
// EXPECT: ["a", "b", "c"] 0
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "a;b;c;".split_terminator(';').collect_in(gpa);
    let mut n = 0;
    for _ in "".split_terminator(';') {
        n += 1;
    }
    println("{:?} {}", v, n);
}
