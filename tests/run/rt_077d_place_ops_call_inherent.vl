// XFAIL: RT-77: an assignment through `v[i]` and through `*b` calls the type's inherent index_mut and deref_mut, not its IndexMut and DerefMut impls (0.30.2)
// Rust's `v[i] = x` is `*IndexMut::index_mut(&mut v, i) = x`, and `b[i] = x`
// through a Deref type is `DerefMut::deref_mut`; an inherent method of the
// same name is never called. vole calls the inherent ones: `v[2] = 5` writes
// v.a[0] (the inherent index_mut) and `b[1] = 9` writes b.z (the inherent
// deref_mut): `5 0 0` and `[0, 0, 0] [0, 9, 8]` for rustc's lines below.
// (RT-41 is the read, `v[i]` through an inherent index.)
// EXPECT: 0 0 5
// EXPECT: [0, 9, 8] [0, 0, 0]
use std::ops::{Deref, DerefMut, Index, IndexMut};

struct V {
    a: [i64; 3],
}

impl V {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.a[0]
    }
}

impl Index<usize> for V {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a[i]
    }
}

impl IndexMut<usize> for V {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.a[i]
    }
}

struct B {
    a: [i64; 3],
    z: [i64; 3],
}

impl B {
    fn deref_mut(&mut self) -> &mut [i64; 3] {
        &mut self.z
    }
}

impl Deref for B {
    type Target = [i64; 3];

    fn deref(&self) -> &[i64; 3] {
        &self.a
    }
}

impl DerefMut for B {
    fn deref_mut(&mut self) -> &mut [i64; 3] {
        &mut self.a
    }
}

fn main() {
    let mut v = V { a: [0, 0, 0] };
    v[2] = 5;
    println("{} {} {}", v.a[0], v.a[1], v.a[2]);
    let mut b = B { a: [0, 0, 0], z: [0, 0, 0] };
    b[1] = 9;
    (*b)[2] = 8;
    println("{:?} {:?}", b.a, b.z);
}
