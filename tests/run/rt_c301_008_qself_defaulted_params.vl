// RULE: F8.4
// `<D as Mk>::C`, D's one parameter with a default: D<u8>, as `let x: D` is (rustc 11). v0.30.1 and the branch before the fix refused it ("'D' is generic: write its type arguments (D::<...>::C)").
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// EXPECT: 11
trait Mk {
    fn mk() -> Self;
    const C: i64;
    type Out;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }

    const C: i64 = 7;
    type Out = i64;
}

struct D<T = u8> {
    p: Option<T>,
}

impl<T> Mk for D<T> {
    fn mk() -> D<T> {
        D { p: None }
    }

    const C: i64 = 11;
    type Out = i64;
}

fn main() {
    println("{}", <D as Mk>::C);
}
