// XFAIL: RT-C301-2: a function that needs a 'static parameter is refused as a value even where its calls give one (0.30.2)
// `let f = keep;` then `f("a")`: rustc accepts (f has keep's fn item type,
// its signature `&'static str`) and prints 1. vole refuses
// (borrowck.fn_value_static): a `fn` value's lifetimes are erased, so a
// call through it is not checked against `'static`; the precise answer
// is a fn item type, or the call through an unannotated local of one
// read as a call of the item.
// EXPECT: 1
fn keep(x: &'static str) -> usize {
    x.len()
}

fn main() {
    let f = keep;
    println("{}", f("a"));
}
