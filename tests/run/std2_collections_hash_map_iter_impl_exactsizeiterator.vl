// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Iter::impl ExactSizeIterator.
// EXPECT: 3
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    m.insert(2, 2);
    m.insert(3, 3);
    println("{}", m.iter().len());
}
