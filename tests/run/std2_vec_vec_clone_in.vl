// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::clone_in.
// EXPECT: [1, 2]
use std::alloc::Arena;

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let v = Vec::from_in([1, 2], gpa);
    let w = v.clone_in(&arena);
    println("{:?}", w);
}
