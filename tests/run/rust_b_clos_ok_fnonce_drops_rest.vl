// EDITION: rust
// RULE: D19.4, D19.9
// (0.27.2) An `FnOnce` closure's env is a value: what it moves out is the
// callee's, what it leaves is dropped at its exit, each once.
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: end
struct R {
    id: i64,
}

impl Drop for R {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main() {
    let a = R { id: 1 };
    let b = R { id: 2 };
    let f = move || {
        drop(a);
        b.id
    };
    let _ = f();
    println("end");
}
// XFAIL: a user Drop never runs on std2: no drop elaboration (clos272)
