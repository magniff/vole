// EDITION: rust
// The std2 item(s): std::main_error: a `main` that returns a Result prints
// `Error: {e:?}` on stderr and exits with 1 on an Err (Rust's), 0 on Ok.
// EXIT: 1
// EXPECT: start
// STDERR: Error: ParseIntError { kind: InvalidDigit }
use std::num::ParseIntError;

fn main() -> Result<(), ParseIntError> {
    println("start");
    let n = "12".parse::<i64>()?;
    let m = "1x".parse::<i64>()?;
    println("{}", n + m);
    Ok(())
}
