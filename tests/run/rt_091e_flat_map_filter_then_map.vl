// RULE: D19.1
// (0.30.2, RT-91) `flat_map` whose result is a `filter` then a `map`, two
// closures deep: the outer closure's X_C was made
// before the inner one's, so its type's slots were counted without them
// (0.30.1: a compiler panic, places/regions.vl code_universal). A
// closure's X_C is made after those of the closures its type holds
// (closures/kinds.vl sig_slots_ordered).
// EXPECT: 3
fn main() {
    let v = [1i64, 2, 3];
    let w = [1i64, 2];
    let n = w.iter().flat_map(|y| v.iter().filter(move |x| **x > *y).map(|x| x * 2)).count();
    println("{n}");
}
