// RULE: E4.4a
// (0.27.2.1) A Vec on an arena frees nothing at its drop (the arena's
// FREES is false, through the impl for &A): a function that drops one is
// #[no_alloc].
// EXPECT: 1 2
use std::alloc::Arena;
use std::vec::Vec;

#[no_alloc]
fn drop_on_arena(v: Vec<i64, &Arena<Gpa>>) -> usize {
    v.len()
}

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let mut v: Vec<i64, &Arena<Gpa>> = Vec::new_in(&arena);
    v.push(1);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2);
    w.push(3);
    println("{} {}", drop_on_arena(v), w.len());
}
