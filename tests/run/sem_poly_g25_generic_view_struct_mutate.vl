// EDITION: rust
// a generic struct holding a view, the viewed Vec grown while it lives
// ERROR: error[borrowck.conflict]
// ERROR: line 12, column 23
#[derive(Clone, Copy)] struct Box1<T> { x: T }
fn mk<T>(x: T) -> Box1<T> { Box1 { x: x } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let b = mk(v.as_slice());
    for i in 0..100 { v.push(i); }
    println("{}", b.x[0]);
}
