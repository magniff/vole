// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Enumerate.
// EXPECT: [(0, 5), (1, 6)]
use std::iter::{Enumerate, FusedIterator};

fn main(gpa: Gpa) {
    let s = Vec::from_in([5i64, 6], gpa);
    let it: Enumerate<std::slice::Iter<'_, i64>> = s.iter().enumerate();
    let v: Vec<(usize, i64), Gpa> = it.map(|(i, x)| (i, *x)).collect_in(gpa);
    println("{:?}", v);
}
