// a reversed range starting at the length.
// EXIT: 101
// STDERR: index out of bounds: index 8, length 8
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64]) -> i64 { let mut t: i64 = 0; for i in (((0..s.len() + 1))).rev() { t += s[i]; } t }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s));
    0
}
