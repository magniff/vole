// EDITION: rust
// (0.27.8) A unit-only Copy enum's derived `==`, `!=` and `<` are one
// compare of its tag, no match. Until 0.27.8 the derives matched the pair, a
// compare and branch per variant inlined at every `==` of a token or a
// node kind, and made the rust-edition compiler about five times slower
// to run. `!=` and `<` are derived inline, not the traits' defaults
// through `eq` and partial_cmp.
// EXPECT: true true true
// CHECK: fn is_c:
// CHECK-NOT: switch
// CHECK-NOT: call
// CHECK: cmp.eq
// CHECK: fn not_d:
// CHECK-NOT: switch
// CHECK-NOT: call
// CHECK: cmp.ne
// CHECK: fn below:
// CHECK-NOT: switch
// CHECK-NOT: call
// CHECK: cmp.lt
// CHECK: fn main:
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Debug)]
enum Tok {
    A,
    B,
    C,
    D,
    E,
    F,
}

#[inline(never)]
fn is_c(k: &Tok) -> bool {
    *k == Tok::C
}

#[inline(never)]
fn not_d(k: Tok, j: Tok) -> bool {
    k != j
}

#[inline(never)]
fn below(k: Tok) -> bool {
    k < Tok::E
}

fn main() {
    let t = Tok::C;
    println("{} {} {}", is_c(&t), not_d(t, Tok::D), below(t));
}
