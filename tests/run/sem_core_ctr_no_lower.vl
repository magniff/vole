// requires i < len without i >= 0: a negative i is still out of bounds.
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 3
static mut Z: i64 = 0;

#[inline(never)]
fn at(s: &[i64], i: i64) -> i64
    requires i < s.len() as i64
{
    s[i as usize]
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    println("{}", at(&a[..], 2 + unsafe { Z }));
    println("{}", at(&a[..], -1 + unsafe { Z }));
    0
}
