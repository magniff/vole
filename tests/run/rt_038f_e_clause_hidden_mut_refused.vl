// RULE: C3.4
// (0.30.2, RT-38f) The other ways a parameter's type hides a `&mut`, each
// refused in a clause: a struct's field (a requires reads its parameter
// in place, a borrowed copy), a tuple's, a `&mut` struct's field after
// the body, an alias in `old(..)`, and `result` of an alias type.
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*s.r'
// ERROR: cannot assign to '*t.0'
// ERROR: cannot assign to '*s.r'
// ERROR: cannot assign to '*p'
// ERROR: cannot assign to '*result'
// ERROR-COUNT: 5
type R<'a> = &'a mut i64;

struct S<'a> {
    r: &'a mut i64,
}

fn by_struct(s: S<'_>) -> i64
    requires {
    *s.r = 9;
    true
}

{
    *s.r
}

fn by_tuple(t: (&mut i64, i64)) -> i64
    requires {
    *t.0 = 9;
    true
}

{
    *t.0
}

fn by_ref(s: &mut S<'_>) -> i64
    ensures {
    *s.r = 9;
    true
}

{
    *s.r
}

fn in_old(p: R<'_>) -> i64
    ensures old({
        *p = 9;
        1
    }) == 1
    {
    *p
}

fn out<'a>(p: R<'a>) -> R<'a>
    ensures {
    *result = 9;
    true
}

{
    p
}

fn main() {
    let mut x = 1i64;
    println("{}", by_struct(S { r: &mut x }));
    println("{}", by_tuple((&mut x, 0)));
    let mut s = S { r: &mut x };
    println("{}", by_ref(&mut s));
    println("{}", in_old(&mut x));
    println("{}", *out(&mut x));
}
