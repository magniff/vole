// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc AnyAlloc::impl Allocator.
// EXPECT: 8
use std::alloc::{Allocator, AnyAlloc, Layout};

fn main(gpa: Gpa) {
    let a = AnyAlloc::new(&gpa);
    let l = Layout::new::<u64>();
    let p = a.allocate(l).unwrap();
    // UNSAFE: the block goes back.
    // SAFETY: p came from a with layout l.
    unsafe { a.deallocate(p, l) };
    println("{}", l.size());
}
