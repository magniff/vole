// FLAGS: --check-alloc
// The std item(s): std::time Duration::ZERO, MAX, SECOND, MILLISECOND,
// MICROSECOND, NANOSECOND (Rust's constants of a struct type).
// EXPECT: true true
// EXPECT: 18446744073709551615 999999999
// EXPECT: 1000 1000 1000
// EXPECT: true
use std::time::Duration;

fn main() -> i32 {
    println("{} {}", Duration::ZERO == Duration::from_secs(0), Duration::ZERO.is_zero());
    println("{} {}", Duration::MAX.as_secs(), Duration::MAX.subsec_nanos());
    println("{} {} {}", Duration::SECOND.as_millis(), Duration::MILLISECOND.as_micros(),
        Duration::MICROSECOND.as_nanos());
    println("{}", Duration::NANOSECOND < Duration::MAX);
    0
}
