// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::capacity.
// EXPECT: true true
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    for i in 0..100i64 {
        m.insert(i, i);
    }
    println("{} {}", m.capacity() >= 100, m.len() == 100);
}
