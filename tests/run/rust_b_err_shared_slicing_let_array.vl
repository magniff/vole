// RULE: D2.7
// (0.30.1, RT-33 round 2, F2, F9) A written `&` slicing used as `&mut`:
// `(if true { &a[..] } else { &a[1..] }).reverse()` of a `let a` (no
// `mut`), `(&b[..]).swap(0, 1)` of a `let b` and of a `let mut m`: each
// rustc's E0596, cannot borrow data in a `&` reference as mutable.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 15, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 17, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 19, column 5
// ERROR-COUNT: 3
fn main() {
    let a = [1i64, 2, 3];
    (if true { &a[..] } else { &a[1..] }).reverse();
    let b = [1i64, 2];
    (&b[..]).swap(0, 1);
    let mut m = [1i64, 2];
    (&m[..]).swap(0, 1);
    m[0] = 3;
    println("{} {} {}", a[0], b[0], m[0]);
}
