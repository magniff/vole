// RULE: F12.3, F5.1
// (0.27.3) A trait's default in a pattern impl (an impl whose header is
// not its type's parameters in order, `impl<T> Iterator for W<T,
// Option<T>>`): `count` and `last`, by method call and by path, found by
// the header as `next` is. Before, only the impl's own methods were.
// EXPECT: Some(2)
// EXPECT: 3
// EXPECT: Some(0)
struct W<A, B> {
    a: A,
    b: B,
    n: i64,
}

impl<T> Iterator for W<T, Option<T>> {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        Some(self.n)
    }
}

fn main() {
    let mut w = W { a: 1i64, b: Some(2i64), n: 3 };
    println("{:?}", w.next());
    println("{}", Iterator::count(W { a: 1i64, b: Some(2i64), n: 3 }));
    println("{:?}", w.last());
}
