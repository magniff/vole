// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ptr NonNull::new.
// EXPECT: true false
use std::ptr::{NonNull, self};

fn main() {
    let mut x = 1i64;
    let a = NonNull::new(&mut x as *mut i64);
    let b = NonNull::new(ptr::null_mut::<i64>());
    println("{} {}", a.is_some(), b.is_some());
}
