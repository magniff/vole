// XFAIL: RT-316: `const LP: i64 = loop { break 6; };` is refused, "expression is not a compile-time constant" (0.30.2)
// rustc accepts it (a loop with a break value is a constant expression) and
// prints the EXPECT line. Since v0.28.0 (v0.30.1 and the release build the
// same). From red team round 7's notes; RT-302 refuses a break that leaves
// the constant's value, this one stays inside it.
// EXPECT: 6
const LP: i64 = loop {
    break 6;
};

fn main() {
    println("{}", LP);
}
