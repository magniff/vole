// EDITION: rust
// RULE: F18.1
// A generic function's parameter that only its result fixes is bound from
// the expected type: a `let`'s annotation, an argument's parameter type,
// a struct literal's field, an assignment's target, the function's
// return type.
// EXPECT: 4 3 2 1 0
trait Zero {
    fn zero() -> Self;
}

impl Zero for i64 {
    fn zero() -> i64 {
        0
    }
}

impl Zero for u8 {
    fn zero() -> u8 {
        1
    }
}

impl Zero for u16 {
    fn zero() -> u16 {
        2
    }
}

impl Zero for u32 {
    fn zero() -> u32 {
        3
    }
}

impl Zero for i32 {
    fn zero() -> i32 {
        4
    }
}

fn make<T: Zero>() -> T {
    T::zero()
}

fn take(x: u8) -> u8 {
    x
}

struct P {
    a: u32,
}

fn ret() -> i64 {
    make()
}

fn main() {
    let a: i32 = make();
    let p = P { a: make() };
    let mut c: u16 = 9;
    c = make();
    println("{} {} {} {} {}", a, p.a, c, take(make()), ret());
}
