// RULE: F29.1
// `e as *mut _` and `e as *const _` take the pointee from the operand: a
// `&mut i64`, a `&i64`, a raw pointer.
// EXPECT: 6 6 6
fn bump(p: *mut i64) {
    unsafe {
        *p += 1;
    }
}

fn get(p: *const i64) -> i64 {
    unsafe { *p }
}

fn main() {
    let mut x = 5i64;
    let p = &mut x as *mut _;
    bump(p);
    let r = p as *const _;
    let q = &x as *const _;
    println("{} {} {}", get(r), get(q), x);
}
