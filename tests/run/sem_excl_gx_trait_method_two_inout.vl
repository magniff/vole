trait Merge { fn merge(&mut self, o: &mut Self); }
#[derive(Clone, Copy)] struct S { n: i64 }
impl Merge for S { fn merge(&mut self, o: &mut S) { self.n += o.n; o.n = 0; } }
fn go<T: Merge>(a: &mut T) { a.merge(a); }
fn main() { let mut s = S { n: 1 }; go(&mut s); println("{}", s.n); }
