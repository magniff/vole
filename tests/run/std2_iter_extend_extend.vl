// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Extend::extend.
// EXPECT: [1, 2, 3] ab

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1i64], gpa);
    let w = Vec::from_in([2i64, 3], gpa);
    v.extend(w.iter().copied());
    let mut s = String::new_in(gpa);
    s.extend("ab".chars());
    println("{:?} {}", v, s);
}
