// (0.30.1, review 3) An impl's `Fn*` bound that names the trait's
// parameter is read with the impl's argument for it (rustc accepts each):
// `F: Fn(A) -> A` as `F: Fn(i64) -> i64`, `Fn(&A) -> bool`, and a generic
// impl's `Fn(T) -> T` for its `Tr<T>`.
// EXPECT: 3
// EXPECT: true
// EXPECT: 3
trait Tr<A> {
    fn f<F: Fn(A) -> A>(&self, a: A, g: F) -> A;
}

trait Tq<A> {
    fn q<F: Fn(&A) -> bool>(&self, a: A, g: F) -> bool;
}

struct S;

impl Tr<i64> for S {
    fn f<F: Fn(i64) -> i64>(&self, a: i64, g: F) -> i64 {
        g(a)
    }
}

impl Tq<i64> for S {
    fn q<F: Fn(&i64) -> bool>(&self, a: i64, g: F) -> bool {
        g(&a)
    }
}

struct W<T> {
    t: T,
}

impl<T> Tr<T> for W<T> {
    fn f<F: Fn(T) -> T>(&self, a: T, g: F) -> T {
        g(a)
    }
}

fn main() {
    println("{}", S.f(2, |x: i64| x + 1));
    println("{}", S.q(2, |x: &i64| *x > 1));
    let w = W { t: 1i64 };
    println("{}", w.f(2, |x: i64| x + 1));
}
