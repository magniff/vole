// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::cell Cell::set.
// EXPECT: 2 dropped 1
use std::cell::Cell;
use std::mem::swap;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        print(" dropped {}", self.n);
    }
}

fn main() {
    let c = Cell::new(D { n: 1 });
    print("2");
    c.set(D { n: 2 });
    println("");
    std::mem::forget(c);
}
