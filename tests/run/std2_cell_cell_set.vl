// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::cell Cell::set.
// EXPECT: 2 dropped 1
use std::cell::Cell;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        print(" dropped {}", self.n);
    }
}

fn main() {
    let c = Cell::new(D { n: 1 });
    print("2");
    c.set(D { n: 2 });
    println("");
    std::mem::forget(c);
}
