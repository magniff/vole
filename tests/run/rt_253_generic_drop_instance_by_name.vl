// XFAIL: RT-253: a generic type's inherent `fn drop`, once instantiated (`W::drop(&mut a)`), runs at the scope's end instead of Drop::drop (0.30.2)
// places/shim.vl scan_drop_instances records any instance whose template
// is named `drop` as the type's Drop instance, by its name: the inherent
// W<i64>::drop that the call made is taken for Drop's. vole prints
// `inherent 1`, `end`, `inherent 1`; rustc ends with `Drop 1`. RT-74's
// family (drop glue choosing a method by name), at the instance table.
// From the review of g302index (form t30); v0.30.1 the same.
// EXPECT: inherent 1
// EXPECT: end
// EXPECT: Drop 1
struct W<T> {
    t: T,
    k: i64,
}

impl<T> W<T> {
    fn drop(&mut self) {
        println("inherent {}", self.k);
    }
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn main() {
    let mut a = W { t: 1i64, k: 1 };
    W::drop(&mut a);
    println("end");
}
