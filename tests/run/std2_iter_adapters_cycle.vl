// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Cycle.
// EXPECT: [1, 1, 1]
use std::iter::{Cycle, FusedIterator};

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64], gpa);
    let it: Cycle<std::slice::Iter<'_, i64>> = s.iter().cycle();
    let v: Vec<i64, Gpa> = it.take(3).copied().collect_in(gpa);
    println("{:?}", v);
}
