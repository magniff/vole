// RT-CG-6 (fixed in 0.30.1): a 16-byte vector in spill slots k and k + 1 was read after a move had written slot k + 1, which held a scalar's next value: the order of an edge's moves compared slot numbers, not the bytes a value takes
// FLAGS: -O1
// EXPECT: 5.25 6.3535156 1.125 7 4.3515625 42.625
// The swap of v4 and v9 (f64) and the v4f32 v5 cross the loop's back
// edge in spill slots; on aarch64 -O1 the edge's moves were
// `ldr d30, [sp]; str d30, [sp, #24]; ldr q17, [sp, #16]`: the store to
// slot 3 came before the 16-byte load of slots 2 and 3. The release
// branch and 0.30.0 printed `... 6.80217 ...` for v5 at -O1 on
// aarch64-macos. The EXPECT line is rustc's, with the vector as [f32; 4];
// at -O0 and -O2 this case is an output guard (no such cycle there).
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[inline(never)]
fn g(a: i64) -> i64 { K.fetch_add(1, Ordering::Relaxed); a ^ 5 }

fn main() {
    let lim = (g(7) & 15) + 3;
    let b1 = (g(41) as f64) * 0.5;
    let mut v4: f64 = (g(6) as f64) * 0.375;
    let mut v5: v4f32 = v4f32::splat((g(5) as f32) * 0.5);
    let mut v9: f64 = (g(11) as f64) * 0.375;
    let mut v11: v1f64 = v1f64::splat((g(11) as f64) * 0.5);
    let mut v12: v1f64 = v1f64::splat((g(12) as f64) * 0.5);
    let mut t: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        let c = g(t);
        v5 = v5 * v4f32::splat(0.5) + v5 * v4f32::splat(0.25) + v4f32::splat((c as f32) * 0.125);
        { let tmp_r = v4; v4 = v9; v9 = tmp_r; }
        v12 = v12 * v1f64::splat(0.5) + v11 * v1f64::splat(0.25) + v1f64::splat((c as f64) * 0.125);
        sf = sf * 0.5 + b1;
        t += 1;
    }
    println("{} {} {} {} {} {}", v4, v5.sum(), v9, v11.sum(), v12.sum(), sf);
}
