// (0.30.2, the re-review of g302holes: r91/r11_option_flat)
// EXPECT: 30
// EXPECT: 3
// filter_map and flat_map with Option closures holding closures.
fn main() {
    let v = [1i64, 2, 3];
    let s: i64 = v
        .iter()
        .filter_map(|y| if *y > 1 { Some(v.iter().map(move |x| x * y).sum::<i64>()) } else { None })
        .sum();
    println("{s}");
    let t: i64 = v
        .iter()
        .flat_map(|y| Some(v.iter().filter(move |x| **x > *y).count() as i64))
        .sum();
    println("{t}");
}
