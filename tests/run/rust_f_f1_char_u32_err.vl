// RULE: F1.2
// A character literal is a `char`, not an integer: where a `u32` goes it
// is a mismatch (rustc E0308); `'a' as u32` is the conversion.
// ERROR: error[distinct.mix]: ''a'' is 'char' where 'u32' goes
fn main() -> i64 {
    let x: u32 = 'a';
    let y = 'b' as u32;
    (x + y) as i64
}
