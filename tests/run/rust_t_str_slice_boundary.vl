// EDITION: rust
// RULE: Z9.1b
// (0.28.0) Slicing a `&str` is checked to fall between characters, as
// Rust's: `&"héllo"[0..2]` panics; it was a str that is not UTF-8.
// EXIT: 101
// EXPECT: h llo hé 2
// STDERR: byte index 2 is not a char boundary
fn main() {
    let s = "héllo";
    let t: &str = &s[1..3];
    println("{} {} {} {}", &s[0..1], &s[3..], &s[..3], t.len());
    println("{}", &s[0..2]);
}
