// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a28_old_raw)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// old(..) calls a callee that writes through a raw pointer made from an address.
fn poke(addr: usize) -> i64 {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *(addr as *mut i64) = 9; }
    1
}

fn f(addr: usize) -> i64
    ensures old(poke(addr)) == 1
{
    2
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x as usize));
    println("{}", x);
}
