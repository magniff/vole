// A requires fact about an inout Vec's length goes stale when the body shrinks it.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 0
static mut Z: i64 = 0;

#[inline(never)]
fn at(v: &mut Vec<i64, Gpa>, i: i64) -> i64
    requires 0 <= i && i < v.len() as i64
{
    v.clear();
    v[i as usize]
}

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for k in 0..4 { v.push(k * 11); }
    println("{}", at(&mut v, 2 + unsafe { Z }));
    0
}
