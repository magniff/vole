// XFAIL: gap 8: compile borrowck.static_mut_ref: a reference to the `static mut` 'TABLE': only its raw address may be taken
// FLAGS: --check-unsafe
// EXPECT: 4950 99 128
// EXPECT: 120
// 0.10: well-behaved unsafe code runs unchanged under --check-unsafe:
// heap blocks grown, read through interior pointers and slices, freed and
// allocated again; the stack and statics are not checked.
extern "C" {
    fn printf(f: *const u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn realloc(p: *mut u8, size: u64) -> *mut u8;
    fn free(p: *mut u8);
}

static mut TABLE: [i64; 4] = [1i64, 2, 3, 4];

fn main(gpa: Gpa) -> i32 {
    let mut cap: i64 = 1;
    let mut p = unsafe { malloc(8) as *mut i64 };
    for i in 0..100 {
        if i == cap {
            cap *= 2;
            p = unsafe { realloc(p as *mut u8, (cap * 8) as u64) as *mut i64 };
        }
        unsafe { (*p.add(i as usize)) = i; }
    }
    let mid = unsafe { p.add(50) as *mut i64 };
    let s = unsafe { std::slice::from_raw_parts(p.add((0) as usize), (100 - (0)) as usize) };
    let mut t: i64 = 0;
    for &x in s {
        t += x;
    }
    unsafe { printf(c"%ld %ld %ld\n", t, (*mid.add(49)), cap); }
    unsafe { free(p as *mut u8); }
    let q = unsafe { malloc(8 * 5) as *mut i64 };
    let mut v = std::vec::Vec::<i64, Gpa>::new_in(gpa);
    for i in 1..6 {
        unsafe { (*q.add((i - 1) as usize)) = i; }
        v.push(i);
    }
    let mut prod: i64 = 1;
    for i in 0..5 {
        unsafe { prod *= (*q.add(i as usize)); }
    }
    let local: i64 = 7;
    let lp = &mut local as *mut i64;
    let tp = unsafe { &mut TABLE[0] } as *mut i64;
    unsafe { printf(c"%ld\n", prod + *lp * 0 + (*tp.add(3)) * 0); }
    0
}
