// XFAIL: gap 2: compile type error: unresolved import 'std::num::I64_MAX'
// 0.20: std is a tree of modules; every item is at its module's path and,
// as before, at std::NAME (a re-export), and the prelude finds it.
// EXPECT: 1 1 [1, 2, 3] 6 3 4 true
// EXPECT: P(4)
// EXPECT: via std::fmt
use std::hash::FixedState;
use std::fmt::Formatter as Fmt; use std::collections::HashMap;
use std::collections::HashMap as Map2;
use std::fmt::Display;
use std::num::I64_MAX; use std::num::count_ones;

#[derive(Clone, Copy)] struct P { x: i64 }

impl Display for P {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result { write(f, "P({})", self.x)?; Ok(()) }
}

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 10);
    let mut n: Map2<i64, i64, Gpa> = std::collections::HashMap::new_in(gpa);
    n.insert(2, 20);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.push(2);
    v.as_mut_slice().sort_unstable();
    v.as_mut_slice().sort_unstable();
    let total = v.iter().copied().fold(0i64, |a, x| a + x);
    println(
        "{} {} {v:?} {total} {} {} {}", m.len(), n.len(), count_ones(7u64), std::count_ones(15u64),
        I64_MAX > 0);
    println("{}", P { x: 4 });
    std::fmt::println("via std::fmt");
    0
}
