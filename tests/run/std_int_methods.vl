// EDITION: rust
// XFAIL: gap 4: compile type.infer: cannot call method 'pow' on an integer literal whose type nothing gives: the method is...
// 0.25.2.2 (eval 0.25.2.1: agents found only the float methods): the
// integer types have Float's abs, signum, min, max, clamp and pow as
// methods (std::num's trait Int), with no `use`; integers wrap with the
// overflow checks off (0.26.3; on, i8::MIN.abs() panics, as Rust's).
// EXPECT: 5 -5 3 0 -1 -125 1024
// EXPECT: 7 1 49 255 0
// EXPECT: -128 -1 127 100
// EXPECT: 0 10 10
// EXPECT: 3 2.5 1
// EXPECT: 5 0 10
// (0.26.4) The overflow checks off: it tests std's integer methods at the edges beside the operators, which wrap.
// FLAGS: --overflow-checks=off
use std::cmp; fn main() {
    let a: i64 = -5;
    println(
        "{} {} {} {} {} {} {}", a.abs(), a.min(3), a.max(3), a.clamp(0, 10), a.signum(),
        a.pow(3u32), (2).pow(10u32));
    let b: u32 = 7;
    let c: u8 = 200;
    println("{} {} {} {} {}", b.abs(), b.signum(), b.pow(2u32), c.max(255u8), (0u64).signum());
    let m: i8 = -128;
    let n: i32 = 1000;
    println("{} {} {} {}", m.abs(), (-3i16).signum(), m.max(127i8), n.clamp(-100, 100i32));
    // clamp: hi wins when lo > hi, as Float's (no panic)
    println("{} {} {}", (-4).clamp(0, 10), (42).clamp(0, 10), (5).clamp(20, 10));
    // the iterators' max and the floats' are still theirs
    let v = [3i64, 1, 2];
    println("{} {} {}", v.iter().copied().max().unwrap(), (2.5).max(1.0),
        v.iter().copied().min().unwrap());
    // std's free functions stay
    println("{} {} {}", a.abs(), a.clamp(0i64, 10i64), cmp::max(a, 10i64));
}
