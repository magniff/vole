// 0.25.2.2 (eval 0.25.2.1: agents found only the float methods): the
// integer types have Float's abs, signum, min, max, clamp and pow as
// methods (std::num's trait Int), with no `use`; integers wrap.
// EXPECT: 5 -5 3 0 -1 -125 1024
// EXPECT: 7 1 49 255 0
// EXPECT: -128 -1 127 100
// EXPECT: 0 10 10
// EXPECT: 3 2.5 1
// EXPECT: 5 0 10
fn main() {
    let a: i64 = -5;
    println(
        f"{a.abs()} {a.min(3)} {a.max(3)} {a.clamp(0, 10)} {a.signum()} {a.pow(3)} {(2).pow(10)}");
    let b: u32 = 7;
    let c: u8 = 200;
    println(f"{b.abs()} {b.signum()} {b.pow(2)} {c.max(255)} {(0u64).signum()}");
    let m: i8 = -128;
    let n: i32 = 1000;
    println(f"{m.abs()} {(-3i16).signum()} {m.max(127)} {n.clamp(-100, 100)}");
    // clamp: hi wins when lo > hi, as Float's (no panic)
    println(f"{(-4).clamp(0, 10)} {(42).clamp(0, 10)} {(5).clamp(20, 10)}");
    // the iterators' max and the floats' are still theirs
    let v = [3, 1, 2];
    println(f"{v.iter().max().unwrap()} {(2.5).max(1.0)} {v.iter().min().unwrap()}");
    // std's free functions stay
    println(f"{std::abs(a)} {std::clamp(a, 0, 10)} {std::max(a, 10)}");
}
