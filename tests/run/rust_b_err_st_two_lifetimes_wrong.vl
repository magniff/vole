struct P<'a, 'b> {
    a: &'a i64,
    b: &'b i64,
}

fn getb<'a, 'b>(p: P<'a, 'b>) -> &'a i64 {
    p.b
}

fn main() {
    let a: i64 = 1;
    let b: i64 = 2;
    println("{}", *getb(P { a: &a, b: &b }));
}
