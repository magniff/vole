// XFAIL: RT-207: higher-ranked bounds (`F: for<'a> Fn(&'a str) -> &'a str`, `for<'a> &'a T: Debug`) and associated type bounds (`I: Iterator<Item: Display>`) are parser errors, and `guide rust` does not list them (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_032_hrtb_and_assoc_type_bounds_parse.rs.txt).
// vole: `expected '>', got ':'` (line 13), `expected type, got 'for'` (lines 24, 29);
// a `for<'a>` before a where-clause type (ob/o1.vl) is `expected '{', got 'for'`.
// The same bounds without `for<'a>` (elided) build. Since v0.28.0.
// EXPECT: 1
// EXPECT: 2
// EXPECT: 2
// EXPECT: 5
// EXPECT: 9
use std::fmt::Display;

fn g<I: Iterator<Item: Display>>(it: I) -> usize {
    let mut n = 0;
    for x in it {
        println("{}", x);
        n += 1;
    }
    n
}

fn call_all<F>(f: F) -> usize
    where
        F: for < 'a > Fn(&'a str) -> &'a str,
{
    f("abc").len() + f("de").len()
}

fn apply<F: for < 'a> FnMut(&'a mut i64) > (mut f: F) -> i64 {
    let mut x = 1;
    f(&mut x);
    f(&mut x);
    x
}

fn main() {
    println("{}", g([1i64, 2].into_iter()));
    println("{}", call_all(|s| s));
    println("{}", apply(|r| *r *= 3));
}
