// XFAIL: RT-482: a generic `fn kl<K, F: Fn(&i64) -> K>(f: F, ..) -> K` returning `f(&l[0])` of a local Vec l, called with `p` from `let (_q, p) = (idr2, st);` where `fn st(_x: &i64) -> &'static i64`, is refused in kl's body: borrowck.return_local, "a reference to 'l', a local of this function, escapes it"; K is `&'static i64`, and rustc prints 5 (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// The release build refuses the direct `kl(st, gpa)` the same way; the
// g302fnval branch accepts that and still refuses this form, `*&p`
// (rt_482b) and an FnMut forwarded through `mut f: F` (rt_482c).
// EXPECT: 5
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn kl<K, F: Fn(&i64) -> K>(f: F, gpa: Gpa) -> K {
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn main(gpa: Gpa) {
    let (_q, p) = (idr2, st);
    let r = kl(p, gpa);
    println("{}", r);
}
