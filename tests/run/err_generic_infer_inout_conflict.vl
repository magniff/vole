// (0.25.1) Two `inout [T]` lent by Vecs of two element types: T is the
// first one's, and the second does not fit.
// ERROR: expected '&mut [i64]', got '&mut Vec<u8, Gpa>'
fn both<T>(x: &mut [T], y: &mut [T]) -> i64 { x.len() as i64 + y.len() as i64 }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut w: Vec<u8, Gpa> = Vec::new_in(gpa);
    both(&mut v, &mut w);
}
