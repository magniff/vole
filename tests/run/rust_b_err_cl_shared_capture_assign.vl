// RULE: D10.2
// (0.27.1) A closure reading `x` captures it by `&`: assigning `x` while it
// is live.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 12, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let f = || x + 1;
    x = 5;
    println("{} {}", f(), x);
}
