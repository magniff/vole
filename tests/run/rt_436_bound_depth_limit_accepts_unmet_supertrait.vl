// RT-436, fixed in 0.30.2 (obligations M2: coherence::entails past the limit is an overflow, never a yes).
// From the paused g302qual work (PAUSED.md, findings not mine, 3), seen
// there by reading: coherence::entails returns true when depth >
// MAX_BOUND_DEPTH (8), in the recursion through an impl's bounds
// (entails_term at depth + 1). Since v0.30.1 at least (the same: 7
// refused, 8 and more accepted). The per-instance checks do not catch it
// either: with `W { t: 1i64 }.f()` in main the program runs and prints 7
// (rustc E0277 there too, `i64: P8`). The associated-type bound form,
// the other caller of entails, is rt_436b.
// ERROR: line 57
trait Sup {}

trait Tr: Sup {
    fn f(&self) -> i64;
}

trait P0 {}

trait P1 {}

trait P2 {}

trait P3 {}

trait P4 {}

trait P5 {}

trait P6 {}

trait P7 {}

trait P8 {}

impl<X: P1> P0 for X {}

impl<X: P2> P1 for X {}

impl<X: P3> P2 for X {}

impl<X: P4> P3 for X {}

impl<X: P5> P4 for X {}

impl<X: P6> P5 for X {}

impl<X: P7> P6 for X {}

impl<X: P8> P7 for X {}

struct W<T> {
    t: T,
}

impl<T: P0> Sup for W<T> {}

impl<T> Tr for W<T> {
    fn f(&self) -> i64 {
        7
    }
}

fn main() {}
