// RULE: D2.7
// (0.27.2) Writes through `r: &mut S`, r itself not `mut` (rustc's unique borrow).
struct S {
    n: i64,
}

impl S {
    fn bump(&mut self) {
        self.n += 1;
    }
}

fn main() {
    let mut a = S { n: 1 };
    let r = &mut a;
    r.n = 2;
    r.bump();
    println("{}", a.n);
}
// EXPECT: 3
