// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl BitAnd for primitives.
// EXPECT: 4 4
use std::ops::BitAnd;

fn apply<T: BitAnd<Output = T>>(a: T, b: T) -> T {
    a.bitand(b)
}

fn main() {
    println("{} {}", apply(12i64, 5), apply(12u8, 5));
}
