// RT-24 (fixed in 0.30.1), a form of it: `'\xFF'` was a char (U+00FF from
// a byte escape). Rust: `out of range hex escape`; a char's `\x` is ASCII
// (lex_char decodes through lex_escape, ESC_CHAR).
// ERROR: out of range hex escape
// ERROR-COUNT: 1
fn main() {
    let c = '\xFF';
    println("{}", c as u32);
}
