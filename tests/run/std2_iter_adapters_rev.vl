// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters Rev.
// EXPECT: [2, 1]
use std::iter::Rev;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let it: Rev<std::slice::Iter<'_, i64>> = s.iter().rev();
    let v: Vec<i64, Gpa> = it.copied().collect_in(gpa);
    println("{:?}", v);
}
