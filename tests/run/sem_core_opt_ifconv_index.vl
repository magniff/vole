// if-conversion must not make an index (or its load) unconditional.
// EXPECT: 5 -1 -1 7
// EXPECT: 0 0
// EXPECT: 3
static mut Z: i64 = 0;

#[inline(never)]
fn get(v: &Vec<i64, Gpa>, i: i64) -> i64 {
    if i < v.len() as i64 && i >= 0 { v[i as usize] } else { -1 }
}

#[inline(never)]
fn get2(v: &Vec<i64, Gpa>, i: i64, c: bool) -> i64 {
    let x: i64 = if c { v[i as usize] } else { 7 };
    x
}

#[inline(never)]
fn get_raw(p: *mut i64, c: bool) -> i64 {
    if c { unsafe { *p } } else { 0 }
}

#[inline(never)]
fn get_null(p: *mut i64) -> i64 {
    if p.is_null() { 0 } else { unsafe { *p } }
}

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    let far = 1099511627776 + unsafe { Z };
    println("{} {} {} {}", get(&v, 0), get(&v, far), get(&v, -far), get2(&v, far, false));
    println("{} {}", get_raw(0 as *mut i64, unsafe { Z } == 1), get_null(0 as *mut i64));
    let i = 10 + unsafe { Z };
    let x: i64 = if unsafe { Z } == 1 { v[i as usize] } else { 3 };
    println("{}", x);
    0
}
