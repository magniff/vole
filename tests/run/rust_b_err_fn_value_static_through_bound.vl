// RULE: D4.7, R6
// (0.30.2) A fn item whose parameter must be 'static only through what
// its bound brings, `T: Into<&'static i64>` met through std's blanket
// `impl<T, U: From<T>> Into<U> for T`, is refused where it is used as a
// value, at the value (fn_values::static_param reads the signature's
// bounds through the impl select chose and its nested obligations). Before
// (with the blanket's obligation unmet), `ap(&w[0], ki::<&i64>)` returned
// w's element as 'static after drop(w), and or_insert_with_key built
// the same (the map's key as a 'static value): a use after free. rustc: E0597 at
// the borrow, E0505 at the drop.
// FLAGS: --check-alloc
// ERROR: error[borrowck.fn_value_static]
// ERROR: line 29, column 23
// ERROR: line 32, column 50
// ERROR-COUNT: 2
use std::collections::HashMap;

fn ki<T: Into<&'static i64>>(x: T) -> &'static i64 {
    x.into()
}

fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    f(t)
}

fn main(gpa: Gpa) {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let b = ap(&w[0], ki::<&i64>);
    drop(w);
    let mut m: HashMap<i64, &'static i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let r: &i64 = *m.entry(5).or_insert_with_key(ki::<&i64>);
    println("{} {}", b, r);
}
