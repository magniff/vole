// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.3, AT4
// (0.27.2.1) Auto traits leak: the opaque type is Send iff its hidden type
// is, and a raw pointer's struct is not (rustc E0277).
// ERROR: error[sync.not_send]
trait Tr {
    fn get(&self) -> i32;
}

struct P {
    p: *const i32,
}

impl Tr for P {
    fn get(&self) -> i32 { 0 }
}

fn make() -> impl Tr {
    P { p: 0 as *const i32 }
}

fn need<T: Send>(t: T) {}

fn main() {
    need(make());
}
