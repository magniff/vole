// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'closure(i64) -> bool
// A closure in the clause captures a raw pointer parameter and calls a raw-writing callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(p: *mut i64) -> i64
    requires {
    let g = |n: i64| n > 0 && poke(p);
    g(1)
}

{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x));
    println("{}", x);
}
