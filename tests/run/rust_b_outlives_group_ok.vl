// RULE: D4.6
// (0.30.1) A recursive group of declarations (S0 names S16, each S_i two
// of S_(i-1)) is solved as one unit, each member walked once a round:
// its requirements are `T: 'a` for all, so `conv` returns the `&'c i64`
// its T holds as a `&'a i64`, as rustc accepts. Before, each member was
// walked again at every use (2^depth: 20 s at depth 24;
// tests/outlives_depth.sh times depth 24).
// EXPECT: 1
struct S0<'a, T> {
    r: &'a T,
    z: Option<&'a S16 < 'a, T >>,
}

    struct S1<'a, T> {
        x: S0 < 'a, T >,
        y: S0 < 'a, T >,
}

    struct S2<'a, T> {
        x: S1 < 'a, T >,
        y: S1 < 'a, T >,
}

    struct S3<'a, T> {
        x: S2 < 'a, T >,
        y: S2 < 'a, T >,
}

    struct S4<'a, T> {
        x: S3 < 'a, T >,
        y: S3 < 'a, T >,
}

    struct S5<'a, T> {
        x: S4 < 'a, T >,
        y: S4 < 'a, T >,
}

    struct S6<'a, T> {
        x: S5 < 'a, T >,
        y: S5 < 'a, T >,
}

    struct S7<'a, T> {
        x: S6 < 'a, T >,
        y: S6 < 'a, T >,
}

    struct S8<'a, T> {
        x: S7 < 'a, T >,
        y: S7 < 'a, T >,
}

    struct S9<'a, T> {
        x: S8 < 'a, T >,
        y: S8 < 'a, T >,
}

    struct S10<'a, T> {
        x: S9 < 'a, T >,
        y: S9 < 'a, T >,
}

    struct S11<'a, T> {
        x: S10 < 'a, T >,
        y: S10 < 'a, T >,
}

    struct S12<'a, T> {
        x: S11 < 'a, T >,
        y: S11 < 'a, T >,
}

    struct S13<'a, T> {
        x: S12 < 'a, T >,
        y: S12 < 'a, T >,
}

    struct S14<'a, T> {
        x: S13 < 'a, T >,
        y: S13 < 'a, T >,
}

    struct S15<'a, T> {
        x: S14 < 'a, T >,
        y: S14 < 'a, T >,
}

    struct S16<'a, T> {
        x: S15 < 'a, T >,
        y: S15 < 'a, T >,
}

    fn conv<'a, 'c>(s: &S16 < 'a, &'c i64 >, r: &'c i64) -> &'a i64 {
        let _ = s;
        r
}

    fn main() {
        println("{}", 1);
}
