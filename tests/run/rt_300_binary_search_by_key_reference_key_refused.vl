// XFAIL: RT-300: `v.binary_search_by_key(&&3, |x| x)`, a key that is the element's reference, is refused: borrowck.outlives "the lifetime of the closure's parameter 'x' is only the call's"; rustc builds it (std's `F: FnMut(&'a T) -> B` with `&'a self`) (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). sort_by_key, dedup_by_key
// and select_nth_unstable_by_key refuse the same closure right (rustc
// refuses them too: their F takes `&T` of any lifetime).
// EXPECT: Ok(1) Err(3)
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(3);
    v.push(5);
    let a = v.binary_search_by_key(&&3i64, |x| x);
    let b = v.binary_search_by_key(&&6i64, |x| x);
    println("{:?} {:?}", a, b);
}
