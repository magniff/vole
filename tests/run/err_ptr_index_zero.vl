#[derive(Clone, Copy)] struct S { x: i64 }

fn parse_num(t: &[u8], out: &mut i64) -> i64 {
    let mut acc: i64 = 0;
    for &c in t {
        acc = acc * 10 + (c - 48) as i64;
    }
    out[0] = acc;
    out[0] += 1;
    out[0] * 2
}

fn field(p: S) -> i64 { p[0].x }

fn raw(mut p: *mut i64) { (*p.add(0)) = 3; }

fn second(out: &mut i64) { out[1] = 2; }

fn main() -> i32 {
    let mut x: i64 = 0;
    parse_num(b"12", &mut x);
    0
}
