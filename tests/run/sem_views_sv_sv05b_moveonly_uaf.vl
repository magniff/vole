// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: p used after it moved into p2 (two inout accesses to v)
// ERROR: error[own.moved]
struct P<A: Allocator> { q: inout Vec<i64, A> }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    var p = P { q: &v };
    var p2 = p;
    let sl = p2.q.as_slice();
    for i in 0..100 { p.q.push(i); }
    println(sl[0]);
    0
}
