// RULE: F14.1
// An impl's type parameter that neither the self type, the trait's
// arguments nor a bound of such a parameter fixes is an error (rustc
// E0207); one fixed through an associated type's constraint is not.
// ERROR: error[trait.unconstrained]: the type parameter 'T' is not constrained by the impl's trait, self type or bounds
// ERROR-COUNT: 1
trait Tr {
    fn f(&self) -> i64;
}

trait Get {
    type Item;
    fn get(&self) -> Self::Item;
}

struct S {
    a: i64,
}

struct W<G> {
    g: G,
}

impl<T> Tr for S {
    fn f(&self) -> i64 {
        1
    }
}

impl<T, G: Get<Item = T>> Tr for W<G> {
    fn f(&self) -> i64 {
        2
    }
}

fn main() -> i64 {
    0
}
