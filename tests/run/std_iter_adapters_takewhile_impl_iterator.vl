// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters TakeWhile::impl Iterator.
// EXPECT: Some(1) None None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 3, 1], gpa);
    let mut it = s.iter().copied().take_while(|x| *x < 2);
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.next());
}
