// RT-211 review 3, re-review: an F that is an fn item's type, `MyMapZ { i:
// v.iter(), f: id, z: &zz[0] }` with `fn id(x: &i64) -> &i64`: Map's B is
// read through F's type by elision, as a call through an fn value is (an fn
// type carries no regions): the bound's only input region, I::Item's, v's
// (places/regions.vl fn_value_output_slot). The step-1 fix read only
// closures, so B took every region of the adapter, zz's too, and
// `drop(zz)` was refused; rustc, the release and v0.30.1 build it.
// EXPECT: Some(1000)
fn id(x: &i64) -> &i64 {
    x
}

struct MyMapZ<'z, I, F> {
    i: I,
    f: F,
    z: &'z i64,
}

impl<'z, B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMapZ<'z, I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        let _ = *self.z;
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut zz: Vec<i64, Gpa> = Vec::new_in(gpa);
    zz.push(3);
    let r = first(MyMapZ { i: v.iter(), f: id, z: &zz[0] }, &k);
    drop(zz);
    println("{:?}", r);
}
