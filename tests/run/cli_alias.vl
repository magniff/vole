// std::cli (0.25.2): Arg::alias (more long names, '|' for several in one
// call), Command::alias (another name of a subcommand: Matches give its
// own), Arg::hide and Command::hide (accepted, not in the help, not
// suggested); the did-you-mean measures the aliases too, and suggests the
// argument's or command's own name.
// EXPECT: $ tool --colour red
// EXPECT: color=red old=false
// EXPECT: $ tool --hue=blue --old
// EXPECT: color=blue old=true
// EXPECT: $ tool --colur red
// EXPECT: error: unknown option '--colur'
// EXPECT: try: --color
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool --tnt red
// EXPECT: error: unknown option '--tnt'
// EXPECT: try: --color
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool rm --dry
// EXPECT: color=- remove dry=true
// EXPECT: $ tool remove -n
// EXPECT: color=- remove dry=true
// EXPECT: $ tool stat
// EXPECT: color=- stat
// EXPECT: $ tool rn
// EXPECT: error: unknown command 'rn'
// EXPECT: try: remove
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownCommand 2]
// EXPECT: $ tool remov
// EXPECT: error: unknown command 'remov'
// EXPECT: try: remove
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownCommand 2]
// EXPECT: $ tool sttus
// EXPECT: error: unknown command 'sttus'
// EXPECT: try: status
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownCommand 2]
// EXPECT: $ tool --od
// EXPECT: error: unknown option '--od'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool --help
// EXPECT: tool
// EXPECT:
// EXPECT: usage: tool [options] [command]
// EXPECT:
// EXPECT: options:
// EXPECT:       --color <COLOR>  when to color
// EXPECT:   -h, --help           print this help
// EXPECT:
// EXPECT: commands:
// EXPECT:   remove               take one away
// EXPECT:   status               show the state
// EXPECT: [Help 0]
use std::cli::{Arg, Command};

fn show(cmd: Command, line: str, gpa: Gpa) {
    println(f"$ {line}");
    match cmd.parse(line.split(' ')) {
        Ok(m) => {
            let color = match m.get("color") { Some(c) => c, None => "-" };
            match m.subcommand() {
                Some((name, sub)) => if name == "remove" {
                    println(f"color={color} {name} dry={sub.flag("dry-run")}");
                } else {
                    println(f"color={color} {name}");
                },
                None => println(f"color={color} old={m.flag("old")}"),
            }
        }
        Err(e) => {
            print(cmd.render_in(e, gpa).as_slice());
            println(f"[{e.kind:?} {e.exit_code()}]");
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("tool", gpa)
        .arg(Arg::option("color").alias("colour").alias("tint|hue").help("when to color"))
        .arg(Arg::flag("old").hide().help("not shown"))
        .subcommand(Command::new_in("remove", gpa).about("take one away").alias("rm")
            .arg(Arg::flag("dry-run").short('n').alias("dry")))
        .subcommand(Command::new_in("status", gpa).about("show the state"))
        .subcommand(Command::new_in("stat", gpa).about("the old status").hide());
    show(cmd, "tool --colour red", gpa);
    show(cmd, "tool --hue=blue --old", gpa);
    show(cmd, "tool --colur red", gpa);
    show(cmd, "tool --tnt red", gpa);
    show(cmd, "tool rm --dry", gpa);
    show(cmd, "tool remove -n", gpa);
    show(cmd, "tool stat", gpa);
    show(cmd, "tool rn", gpa);
    show(cmd, "tool remov", gpa);
    show(cmd, "tool sttus", gpa);
    show(cmd, "tool --od", gpa);
    show(cmd, "tool --help", gpa);
    0
}
