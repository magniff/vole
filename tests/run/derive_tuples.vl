// XFAIL: gap 4: compile type error: the trait 'Borrow<(i32, str)>' is not implemented for '(i64, str)'
// EXPECT: (1, 9) (2, 1) (2, 5) (3, 0)
// EXPECT: lt true true false
// EXPECT: map 12 7 len 2
// EXPECT: cmp -1 1 0 -1
// EXPECT: clone 5 2.5 1 3
// EXPECT: deep 1 2
// EXPECT: words a 2 a 3 b 1
// 0.15: tuples of Ord, Hash or Clone types (2 to 6 elements) are Ord
// (lexicographic: `<` and std::sort), Hash (HashMap keys) and Clone
// (element-wise) without an impl; floats, pointers and fieldless enums
// have `cmp`, and every type that copies (numbers, pointers, slices,
// fieldless enums, tuples and arrays of them) has `clone`.
use std::collections::HashMap;
use std::hash::FixedState;

#[derive(Clone, Copy, PartialEq, Eq)] enum Dir { North, South }

fn main(gpa: Gpa) {
    let mut v: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    v.push((2, 5));
    v.push((3, 0));
    v.push((1, 9));
    v.push((2, 1));
    v.sort_unstable();
    for i in 0..v.len() {
        let t = v[i];
        if i > 0 {
            print(" ");
        }
        print("(");
        print("{}", t.0);
        print(", ");
        print("{}", t.1);
        print(")");
    }
    println("");

    let a = (1, "b", 2u8);
    let b = (1, "c", 0u8);
    let c = (1, 2, 3, 4, 5, 6);
    let d = (1, 2, 3, 4, 5, 7);
    print("lt ");
    print("{}", if a < b { "true " } else { "false " });
    print("{}", if c < d { "true " } else { "false " });
    println("{}", if d <= c { "true" } else { "false" });

    let mut m: HashMap<(i64, &str), i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert((1, "x"), 5);
    m.insert((1, "y"), 7);
    m.insert((1, "x"), 12);
    print("map ");
    print("{}", m.get(&(1, "x")).copied().unwrap());
    print(" ");
    print("{}", m.get(&(1, "y")).copied().unwrap());
    print(" len ");
    print("{}", (m.len() as i64));
    println("");

    let x = 1.5;
    let y = 2.5;
    let n = Dir::North;
    let s = Dir::South;
    print("cmp ");
    print("{}", x.cmp(y));
    print(" ");
    print("{}", s.cmp(n));
    print(" ");
    // (cmp and cmp_of take `*T`, an exclusive loan: no borrow of x or y
    // may live across x.cmp(&y), nor &p twice in one call)
    let p = x;
    let p2 = x;
    print("{}", p.cmp(&p2) as i64);
    print(" ");
    print("{}", a.cmp(b));
    println("");

    let k: i64 = 5;
    let z = (2.5, b'a');
    let arr = [1i64, 2, 3];
    let arr2 = arr.clone();
    let z2 = z.clone();
    print("clone ");
    print("{}", k.clone());
    let q = y;
    unsafe {
        let r = q.clone();
        if r == 2.5 && z2.0 == 2.5 {
            print(" 2.5 ");
        }
    }
    print("{}", arr2[0]);
    print(" ");
    print("{}", arr2[2]);
    println("");

    let mut xs: Vec<i64, Gpa> = Vec::new_in(gpa);
    xs.push(1);
    let pair = (xs, 0);
    let mut pair2 = pair.clone();
    pair2.0.push(2);
    print("deep ");
    print("{}", (pair.0.len() as i64));
    print(" ");
    print("{}", (pair2.0.len() as i64));
    println("");

    // (a [u8] element compares its bytes)
    let mut w: Vec<(&str, i64), Gpa> = Vec::new_in(gpa);
    w.push(("b", 1));
    w.push(("a", 2));
    w.push(("a", 3));
    w.sort_unstable();
    print("words");
    for e in w {
        print(" ");
        print("{}", e.0);
        print(" ");
        print("{}", e.1);
    }
    println("");
}
