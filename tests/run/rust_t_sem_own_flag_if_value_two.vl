// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_flag_if_value_two.vl to Rust's spelling.
// sem-own: an if expression choosing between two owned locals: the other dropped at its scope end.
// EXPECT: got 1
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
use std::alloc::Allocator;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    {
        let c = true;
        let d = if c { a } else { b };
        println("got {}", d.id);
        println("end");
    }
}
