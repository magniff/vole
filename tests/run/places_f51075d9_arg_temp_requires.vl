// places IR, family 51075d9c: a requires call's arguments, a transparent block
// (0.25.2.2) An argument of a call of a function with a requires clause:
// the call is a block that binds the arguments first (contracts::desugar
// requires_call, `{ let ?a0 = arg; f$pre(..); f(?a0, ..) }`), checked by
// hand, whose lets the own pass never visited. `dev.compute_pipeline(
// dev.shader_wgsl(SRC)?, "evolve")?` (compute_pipeline requires
// self.caps.compute) passed a shader dropped before the call ("no compute
// entry point"); a plain temporary there leaked, and a match with a
// returning arm read its dropped binding. Its sweep:
// own_arg_temp_sweep_*_req (tools/sinksweep/argsweep.py).
// FLAGS: --check-alloc
// EXPECT: q? ok 13
// EXPECT: q ok 13
// EXPECT: plain? ok 13
// EXPECT: plain ok 13
// EXPECT: tail ok 13
// EXPECT: match ok 13
// EXPECT: sink, then ? fails err -2
// PLACES: fn D::make
// PLACES: drop(_7) [removed]
// PLACES: drop(_3) [removed]
// PLACES: fn D::mk
// PLACES: drop(_3) [removed]
// PLACES: fn D::take
// PLACES: drop(_2) [kept]
// PLACES: fn a
// PLACES: drop(_7) [removed]
// PLACES: drop(_6) [kept]
// PLACES: drop(_9) [removed]
// PLACES: drop(_7) [removed]
// PLACES: fn b
// PLACES: drop(_6) [removed]
// PLACES: drop(_5) [kept]
// PLACES: drop(_8) [removed]
// PLACES: drop(_6) [removed]
// PLACES: fn c
// PLACES: drop(_6) [kept]
// PLACES: fn e
// PLACES: drop(_5) [kept]
// PLACES: fn tail
// PLACES: drop(_5) [removed]
// PLACES: drop(_4) [kept]
// PLACES: drop(_7) [removed]
// PLACES: drop(_5) [removed]
// PLACES: fn matched
// PLACES: drop(_5) [removed]
// PLACES: drop(_8) [kept]
// PLACES: drop(_7) [removed]
// PLACES: drop(_5) [removed]
// PLACES: fn sink_then_q
// PLACES: drop(_6) [removed]
// PLACES: drop(_5) [removed]
// PLACES: drop(_5) [kept]

struct Sh {
    names: Vec<i64>,
}

struct D {
    k: i64,
    on: bool,
}

impl D {
    fn make(self, gpa: Gpa) -> Result<Sh, i64> {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(self.k);
        v.push(7);
        Ok(Sh { names: v })
    }

    fn mk(self, gpa: Gpa) -> Sh {
        var v: Vec<i64> = Vec::new_in(gpa);
        v.push(self.k);
        v.push(7);
        Sh { names: v }
    }

    fn num(self, n: i64) -> Result<i64, i64> {
        if n < 0 {
            return Err(n);
        }
        Ok(n)
    }

    fn pipe(self, s: Sh, entry: [u8]) -> Result<i64, i64>
        requires self.on
        else "gpu.off"
        {
        if s.names.len() != 2 {
            return Err(-1);
        }
        Ok(s.names[1] + entry.len)
    }

    fn take(self, s: sink Sh, n: i64) -> Result<i64, i64>
        requires self.on
        else "gpu.off"
        {
        Ok(s.names[1] + n)
    }
}

fn a(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.make(gpa)?, "evolve")?;
    Ok(p)
}

fn b(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.make(gpa)?, "evolve");
    p
}

fn c(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.mk(gpa), "evolve")?;
    Ok(p)
}

fn e(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.mk(gpa), "evolve");
    p
}

fn tail(d: D, gpa: Gpa) -> Result<i64, i64> {
    d.pipe(d.make(gpa)?, "evolve")
}

fn matched(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(match d.make(gpa) { Ok(s) => s, Err(e) => return Err(e) }, "evolve");
    p
}

fn sink_then_q(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.take(d.mk(gpa), d.num(-2)?)?;
    Ok(p)
}

fn show(n: str, r: Result<i64, i64>) {
    match r {
        Ok(v) => println(f"{n} ok {v}"),
        Err(e) => println(f"{n} err {e}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let d = D { k: 3, on: true };
    show("q?", a(d, gpa));
    show("q", b(d, gpa));
    show("plain?", c(d, gpa));
    show("plain", e(d, gpa));
    show("tail", tail(d, gpa));
    show("match", matched(d, gpa));
    show("sink, then ? fails", sink_then_q(d, gpa));
    0
}
