use std::alloc::Allocator; use std::hash::Hash; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
use std::collections::HashMap;
impl PartialEq for D<Gpa> { fn eq(&self, other: &D<Gpa>) -> bool { self.id == other.id } } impl Eq for D<Gpa> {}
impl Hash for D<Gpa> { fn hash(&self) -> u64 { self.id as u64 } }

fn main(gpa: Gpa) {
    let mut m: HashMap<D<Gpa>, D<Gpa>, Gpa> = HashMap::new_in(gpa);
    m.insert(mk(1, gpa), mk(5, gpa));
    m.insert(mk(1, gpa), mk(6, gpa));
    println("end");
}
