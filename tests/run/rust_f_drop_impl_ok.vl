// (0.30.1, review 5) Drop impls as general as their types: the
// declaration's own trait bounds repeated (`T: Clone`), an elided
// lifetime. (Fewer of them, `impl<T> Drop for F<T>` of `struct F<T: Clone>`,
// is rustc's E0277 at the header, the type not well formed:
// rust_o_m2_unmade_header_drop_err, 0.30.2.) (Its outlives repeated, `'b: 'a`, `T: 'static`, are
// refused since review 7: RT-C301-16.)
// EXPECT: drop c

struct C<T: Clone> {
    t: T,
}

impl<T: Clone> Drop for C<T> {
    fn drop(&mut self) {
        println("drop c");
    }
}

struct E<'a> {
    r: &'a str,
}

impl Drop for E<'_> {
    fn drop(&mut self) {}
}

fn main() {
    let s: &str = "x";
    let c = C { t: 1i64 };
    let e = E { r: s };
}
