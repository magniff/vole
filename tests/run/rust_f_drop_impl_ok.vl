// (0.30.1, review 5) Drop impls as general as their types: the
// declaration's own trait bounds repeated (`T: Clone`), fewer of them, an
// elided lifetime. (Its outlives repeated, `'b: 'a`, `T: 'static`, are
// refused since review 7: RT-C301-16.)
// EXPECT: drop f
// EXPECT: drop c

struct C<T: Clone> {
    t: T,
}

impl<T: Clone> Drop for C<T> {
    fn drop(&mut self) {
        println("drop c");
    }
}

struct E<'a> {
    r: &'a str,
}

impl Drop for E<'_> {
    fn drop(&mut self) {}
}

struct F<T: Clone> {
    t: T,
}

impl<T> Drop for F<T> {
    fn drop(&mut self) {
        println("drop f");
    }
}

fn main() {
    let s: &str = "x";
    let c = C { t: 1i64 };
    let e = E { r: s };
    let f = F { t: 3i64 };
}
