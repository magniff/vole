// (0.30.1, review 5) Drop impls as general as their types: the
// declaration's own bounds repeated (`T: Clone`, `'b: 'a`, `T: 'static`),
// fewer of them, an elided lifetime.
// EXPECT: drop f
// EXPECT: drop k
// EXPECT: drop c
// EXPECT: drop w 1
struct W<'a, 'b: 'a> {
    r: &'a &'b str,
}

impl<'a, 'b: 'a> Drop for W<'a, 'b> {
    fn drop(&mut self) {
        println("drop w {}", self.r.len());
    }
}

struct C<T: Clone> {
    t: T,
}

impl<T: Clone> Drop for C<T> {
    fn drop(&mut self) {
        println("drop c");
    }
}

struct K<T: 'static + Copy> {
    t: T,
}

impl<T: 'static + Copy> Drop for K<T> {
    fn drop(&mut self) {
        println("drop k");
    }
}

struct E<'a> {
    r: &'a str,
}

impl Drop for E<'_> {
    fn drop(&mut self) {}
}

struct F<T: Clone> {
    t: T,
}

impl<T> Drop for F<T> {
    fn drop(&mut self) {
        println("drop f");
    }
}

fn main() {
    let s: &str = "x";
    let w = W { r: &s };
    let c = C { t: 1i64 };
    let k = K { t: 2i64 };
    let e = E { r: s };
    let f = F { t: 3i64 };
}
