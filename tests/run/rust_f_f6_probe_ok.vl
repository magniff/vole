// EDITION: rust
// RULE: F6.2
// rustc's probe: at each autoderef step the receiver by value, then
// `&`, then `&mut`, and at each the methods whose receiver type is that
// type, inherent first. Each line is rustc's answer (checked with rustc):
// `r.tag()` is S's own `&self` method, `rr.tag()` the `&S` impl's,
// `s.c()` the `&S` impl's by-value `c` before S's `&mut self` one, `m.e()`
// the `&mut S` impl's before S's `&self` one.
// EXPECT: 1 1 3
// EXPECT: 10 10
// EXPECT: 21
// EXPECT: 31 31
// EXPECT: 21
// EXPECT: 41
struct S { n: i64 }
// A: inherent &self on S vs trait &self on &S
trait Tag { fn tag(&self) -> i64; }
impl S { fn tag(&self) -> i64 { 1 } }
impl<'a> Tag for &'a S { fn tag(&self) -> i64 { 3 } }
// B: trait &self on S vs trait self on &S (different traits)
trait B1 { fn b(&self) -> i64; }
trait B2 { fn b(self) -> i64; }
impl B1 for S { fn b(&self) -> i64 { 10 } }
// C: inherent &mut self on S vs trait self on &S
trait C2 { fn c(self) -> i64; }
impl S { fn c(&mut self) -> i64 { 20 } }
impl<'a> C2 for &'a S { fn c(self) -> i64 { 21 } }
// D: trait self on S (Copy-less) vs trait &self on &S
trait D1 { fn d(self) -> i64; }
trait D2 { fn d(&self) -> i64; }
impl D1 for S { fn d(self) -> i64 { 30 } }
impl<'a> D2 for &'a S { fn d(&self) -> i64 { 31 } }
// E: &mut S receiver: inherent &self on S vs trait self on &mut S
trait E2 { fn e(self) -> i64; }
impl S { fn e(&self) -> i64 { 40 } }
impl<'a> E2 for &'a mut S { fn e(self) -> i64 { 41 } }

fn main() -> i64 {
    let mut s = S { n: 0 };
    {
        let r = &s;
        let rr = &r;
        std::print_int(s.tag()); print(" "); std::print_int(r.tag()); print(" ");
        std::print_int(rr.tag()); println("");
        std::print_int(s.b()); print(" "); std::print_int(r.b()); println("");
        std::print_int(r.c()); println("");
        std::print_int(r.d()); print(" "); std::print_int(rr.d()); println("");
    }
    std::print_int(s.c()); println("");
    let m = &mut s;
    std::print_int(m.e()); println("");
    0
}
