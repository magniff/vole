// XFAIL: RT-132: an enum with no variants has size 1; rustc says 0 (0.30.2)
// Found by the review of g302std; v0.30.1 too.
// EXPECT: 0 1 0
use std::mem::{align_of, size_of};
enum V {}

struct H {
    v: [V; 0],
}

fn main() {
    println("{} {} {}", size_of::<V>(), align_of::<V>(), size_of::<H>());
}
