// EDITION: rust
// RULE: D19.10
// (0.27.2) A closure with a requirement passed to a generic function: the
// instance with `F` the closure's type assumes the requirement of `F`'s
// regions, and the call there includes it.
// EXPECT: 2
struct H<'a> {
    p: &'a i64,
}

fn run<F: FnMut()>(mut f: F) {
    f();
}

fn main() {
    let a = 1;
    let b = 2;
    let mut h = H { p: &a };
    let r = &b;
    run(|| {
        h.p = r;
    });
    println("{}", *h.p);
}
