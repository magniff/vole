// RULE: D2.4a
// (0.30.1) `(s, { drop(s); 0 })`: the tuple's first part moves s, so the
// block's move of it is a use of the moved s (rustc E0382, vole's
// use_moved), at the second move.
// ERROR: error[borrowck.use_moved]
// ERROR: line 12, column 14
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let s = format_in("old", gpa);
    let t = (s, {
        let _ = 1;
        drop(s);
        0
    });
    println("{}", t.0);
}
