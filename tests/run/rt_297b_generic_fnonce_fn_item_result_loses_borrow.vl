// RT-297b (closed in 0.30.2): (more forms of R302F-14) a fn item for a program's `F: FnOnce(T) -> U` (`apo(v.first(), idr2)`) and for Result::map (`o.map(idr2)`, o: Result<&i64, i64>) gives a result that keeps no borrow: a use after free from safe code (0.30.2)
// rustc E0505 at both drops (twin .rs.txt); the release build checks it
// clean and --check-alloc stops with a use after free. The same apo with a
// closure keeps the borrow.
// FLAGS: --check-alloc
// ERROR: line 24
// ERROR: line 29
// ERROR-COUNT: 2
fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn apo<T, U, F: FnOnce(T) -> U>(o: Option<T>, f: F) -> Option<U> {
    match o {
        Some(t) => Some(f(t)),
        None => None,
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let a = apo(v.first(), idr2);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let o: Result<&i64, i64> = Ok(&w[0]);
    let b = o.map(idr2);
    drop(w);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?} {:?}", a, b, x);
}
