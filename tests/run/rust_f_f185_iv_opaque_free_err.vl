// RULE: F18.5
// RUSTC-DIFFERS: rustc keeps the opaque value's integer variable open and falls back to i32 (prints 4); vole needs its type where the value is used
// (0.30.2) An `impl Trait` result of an instance made with an integer
// variable still free where the value is used: its hidden type is not
// known yet (the variable may be typed by a later use), so it is refused,
// never guessed (an instance of the variable's type alone would be
// another program's).
// ERROR: error[type error]: type annotations needed
// ERROR: line 27, column 19
// ERROR-COUNT: 1
trait Show {
    fn show(&self) -> u32;
}

impl Show for i32 {
    fn show(&self) -> u32 { *self as u32 }
}

impl Show for i64 {
    fn show(&self) -> u32 { *self as u32 + 100 }
}

fn id<T: Show>(t: T) -> impl Show { t }

fn main() {
    let c = id(4);
    println("{}", c.show());
}
