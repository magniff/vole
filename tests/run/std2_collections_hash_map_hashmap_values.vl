// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::values.
// EXPECT: 60
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    m.insert(3, 30);
    let total: i64 = m.values().sum();
    println("{}", total);
}
