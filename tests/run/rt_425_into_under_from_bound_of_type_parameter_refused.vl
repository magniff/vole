// XFAIL: RT-425: `x.into()` to a type parameter T under `T: From<i64>` (in the bound or a where clause, as the fn's result or a `let t: T`) is refused: "cannot convert 'i64' into 'T': no impl of 'From<i64>' for 'T'", whose help is to write `impl From<i64> for T`; `Into::into(x)` is "'into' needs the type it converts to", whose help is the refused `let y: T = x.into();`; rustc accepts all (std's `impl<T, U: From<T>> Into<U> for T`) (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). vole reports 3 errors, at
// lines 21, 28 (the bodies) and 33 (Into::into, in the instance
// ginto_path<F> called at line 43). `T::from(x)` under the same bound is right. v0.28.0 to
// v0.30.1 the same. The decision is in front/convert/mod.vl
// (no_impl_error, dispatch): the conversion looks for an impl of From for
// the target and does not take the parameter's bound as one.
// EXPECT: F { k: 10 } F { k: 20 } F { k: 30 } F { k: 40 } 5
#[derive(Debug)]
struct F {
    k: i64,
}

impl From<i64> for F {
    fn from(x: i64) -> F {
        F { k: x * 10 }
    }
}

fn ginto<T: From<i64>>(x: i64) -> T {
    x.into()
}

fn ginto_let<T>(x: i64) -> T
    where
        T: From<i64>,
{
    let t: T = x.into();
    t
}

fn ginto_path<T: From<i64>>(x: i64) -> T {
    Into::into(x)
}

fn gfrom<T: From<i64>>(x: i64) -> T {
    T::from(x)
}

fn main() {
    let a: F = ginto(1);
    let b: F = ginto_let(2);
    let c: F = ginto_path(3);
    let d: F = gfrom(4);
    let e: i64 = ginto(5i64);
    println("{:?} {:?} {:?} {:?} {}", a, b, c, d, e);
}
