// EDITION: rust
// (0.25) A closure lent to a call next to `&n`, where it reads or writes
// n: the callee may call it while it holds n inout.
fn run<F: FnMut() -> i64>(f: &mut F, x: &mut i64) -> i64 { let a = f(); *x = 5; a * 100 + f() }

fn main() {
    let mut n: i64 = 1;
    let mut g = || -> i64 { n };
    println("{}", run(&mut g, &mut n));
}
