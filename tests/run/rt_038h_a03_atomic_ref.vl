// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a03_atomic_ref)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a shared reference (a cell)
// A callee stores to an atomic the clause reads through &.
use std::sync::atomic::{AtomicI64, Ordering};

fn poke(a: &AtomicI64) -> bool {
    a.store(9, Ordering::SeqCst);
    true
}

fn f(a: &AtomicI64) -> i64
    requires poke(a)
{
    1
}

fn main() {
    let a = AtomicI64::new(1);
    println("{}", f(&a));
    println("{}", a.load(Ordering::SeqCst));
}
