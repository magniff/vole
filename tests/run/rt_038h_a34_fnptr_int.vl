// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a34_fnptr_int)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'w', a fn value that may call a function which writes through a raw pointer what it did not make
// A fn pointer called in the clause writes through an address.
fn poke(addr: usize) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *(addr as *mut i64) = 9; }
    true
}

fn f(addr: usize, w: fn(usize) -> bool) -> i64
    requires w(addr)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x as usize, poke));
    println("{}", x);
}
