// RULE: D19.2
// (0.30) The accepted side of rust_b_err_capture_call_fnmut: a closure
// writing through a captured `&mut i64` or `&mut [i64]` that is not
// declared `mut` (rustc's unique borrow), and a captured FnMut closure
// declared `mut`.
// EXPECT: 3 7
fn main() {
    let mut n: i64 = 0;
    let r = &mut n;
    let mut d = || {
        *r += 1;
    };
    d();
    let mut a = [5i64, 6];
    let s = &mut a[..];
    let mut e = || {
        s[0] += 2;
    };
    e();
    let mut c = || {
        n += 1;
    };
    let mut f = || {
        c();
        c();
    };
    f();
    println("{n} {}", a[0]);
}
