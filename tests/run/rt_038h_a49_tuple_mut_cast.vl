// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a49_tuple_mut_cast)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A tuple parameter holding a &mut: the clause casts it to *mut for a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(t: (&mut i64, i64)) -> i64
    requires poke(t.0 as *mut i64)
{
    t.1
}

fn main() {
    let mut x = 1i64;
    println("{}", f((&mut x, 1)));
    println("{}", x);
}
