// RULE: F5.3
// Two inherent impls of one type may not both define a method of one
// name (rustc E0592), also on a generic type.
// ERROR: error[impl.duplicate]: duplicate method 'f' for type 'S'
// ERROR: error[impl.duplicate]: duplicate method 'g' for type 'W'
struct S {
    a: i64,
}

impl S {
    fn f(&self) -> i64 {
        1
    }
}

impl S {
    fn f(&self) -> i64 {
        2
    }
}

struct W<T> {
    v: T,
}

impl<T> W<T> {
    fn g(&self) -> i64 {
        1
    }
}

impl<T> W<T> {
    fn g(&self) -> i64 {
        2
    }
}

fn main() -> i64 {
    let s = S { a: 1 };
    s.f()
}
