// RULE: F35.1 (0.30.2, RT-215) A repeat of a value that is not Copy is
// refused in a constant's or a static's value too (rustc E0277 for each):
// an array constant and a static, by the checker, which checks their
// values (rt_215_const_tuple_repeat_refused.vl: one inside a constant of
// another type). A repeat of 0 or 1 and a repeat of a Copy value are
// kept. v0.30.1 accepted both.
// ERROR: line 14
// ERROR: line 15
// ERROR-COUNT: 2
struct D {
    k: i64,
}

const C: [Option<D>; 2] = [None; 2];
static S: [Option<D>; 3] = [None; 3];
const OK1: [Option<D>; 1] = [None; 1];
const OK0: [Option<D>; 0] = [None; 0];
static N: [Option<u8>; 4] = [None; 4];

fn main() {
    println("{} {} {} {}", C.len(), S.len() + OK1.len(), OK0.len(), N.len());
}
