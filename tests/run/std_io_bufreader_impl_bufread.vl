// Runs on std since its gap closed (0.27.3).
// The std item(s): std::io BufReader::impl BufRead.
// EXPECT: [1, 2, 3] [2, 3]
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    print("{:?} ", b.fill_buf().unwrap());
    b.consume(1);
    println("{:?}", b.fill_buf().unwrap());
}
