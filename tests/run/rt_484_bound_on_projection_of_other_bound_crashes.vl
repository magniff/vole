// XFAIL: RT-484: `fn kh<T: Has>(x: T) -> &'static i64 where T::Out: Into<&'static i64>, T: Into<T::Out>` with `impl<'a> Has for &'a i64 { type Out = &'a i64; }`, called as `Some(&K).map(kh::<&'static i64>)`, crashes the compiler (bus error, exit 138) in check and build; rustc prints `Some(1000)` (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// RT-433 is a bound on T's projection through that same bound's trait (a
// cycle, rustc E0391); here the projection is through another bound and
// rustc accepts. The review's form (sp13: a Vec's first, then drop(v))
// crashes the same way; rustc E0597 there.
// EXPECT: Some(1000)
trait Has {
    type Out;
}

impl<'a> Has for &'a i64 {
    type Out = &'a i64;
}

fn kh<T: Has>(x: T) -> &'static i64
    where
        T::Out: Into<&'static i64>,
        T: Into<T::Out>,
{
    let o: T::Out = x.into();
    o.into()
}

static K: i64 = 1000;

fn main() {
    let a = Some(&K).map(kh::<&'static i64>);
    println("{:?}", a);
}
