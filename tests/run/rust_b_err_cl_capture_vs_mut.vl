// RULE: D10.2
// (0.27.1) A closure capturing `x` by `&` while `&mut x` is live.
// ERROR: error[borrowck.conflict]
// ERROR: line 11, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let r = &mut x;
    let f = || x + 1;
    *r += 1;
    println("{}", f());
}
