fn first(s: &[i64]) -> Option<&[i64]> { if s.len() > 0 { Some(&s[0..1]) } else { None } }

fn g(v: &mut Vec<i64, Gpa>) -> Option<i64> {
    let sl = first(v.as_slice())?;
    v.push(2);
    Some(sl[0])
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", g(&mut v).unwrap());
    0
}
