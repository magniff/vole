// RULE: F8.4, F12.1
// RT-C301-8: A's items defaults, B's written in the impl: `<S as A>::K`
// is A's default though S's impl of B defines K. 0.30.1 printed
// `2 2 2 2` and `2`. rustc prints these lines.
// EXPECT: 10 2 10 2
// EXPECT: 10
// one trait's item a default, the other's overridden
trait A { const K: i64 = 10; fn m(&self) -> i64 { 10 } }
trait B { const K: i64; fn m(&self) -> i64; }
struct S;
impl A for S {}
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } }

fn main() {
    let s = S;
    let fa = <S as A>::m; let fb = <S as B>::m;
    println("{} {} {} {}", <S as A>::K, <S as B>::K, fa(&s), fb(&s));
    let fa2 = <S as A>::m;
    println("{}", fa2(&s));
}
