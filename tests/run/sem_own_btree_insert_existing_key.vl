// EDITION: rust
// XFAIL: gap 2: compile type error: unknown type 'BTreeMap'
// sem-own: BTreeMap insert of an existing owned key: one key dropped, the old value dropped (result discarded).
// EXPECT: drop 1
// EXPECT: drop 5
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 6
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
impl PartialEq for D<Gpa> { fn eq(&self, other: &D<Gpa>) -> bool { self.id == other.id } } impl Eq for D<Gpa> {}

impl Ord for D<Gpa> {
    fn cmp(&self, other: &D<Gpa>) -> std::cmp::Ordering { ({ self.id - other.id }).cmp(&0) }
} impl PartialOrd for D<Gpa> { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } }

fn main(gpa: Gpa) {
    let mut m: std::BTreeMap<D<Gpa>, D<Gpa>, Gpa> = std::BTreeMap::new_in(gpa);
    m.insert(mk(1, gpa), mk(5, gpa));
    m.insert(mk(1, gpa), mk(6, gpa));
    println("end");
}
