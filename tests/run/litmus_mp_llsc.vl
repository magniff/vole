// EDITION: rust
// XFAIL: gap 2: compile alloc.no_in: 'std::thread::spawn' allocates from nothing: pass the allocator, last, to 'std::thread...
// (0.21) With exclusive-pair loops (--atomics=llsc): litmus MP (message passing), release/acquire: the writer stores
// FLAGS: --atomics=llsc
// DATA = r, then FLAG = r with Release; the reader loads FLAG with Acquire,
// then DATA. Seeing FLAG = f, DATA is never below f (C++20 forbids it;
// AArch64's ldar/stlr keep it). 200000 rounds, the reader racing.
// EXPECT: mp ok

use std::thread;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

static DATA: AtomicI64 = AtomicI64::new(0i64);
static FLAG: AtomicI64 = AtomicI64::new(0i64);

const N: i64 = 200000;

fn main() {
    let w = thread::spawn(move || {
        for r in 1..N + 1 {
            DATA.store(r, Ordering::Relaxed);
            FLAG.store(r, Ordering::Release);
        }
        0
    });
    let rd = thread::spawn(move || {
        let mut bad: i64 = 0;
        loop {
            let f = FLAG.load(Ordering::Acquire);
            let d = DATA.load(Ordering::Relaxed);
            if d < f { bad += 1; }
            if f == N { break; }
        }
        bad
    });
    w.join().unwrap();
    let bad = rd.join().unwrap();
    println("{}", if bad == 0 { "mp ok" } else { "mp FORBIDDEN outcome seen" });
}
