// RULE: D2.7
// (0.30.1, RT-33 round 3, F6) `&mut w[0usize..3]` of a W with Index only:
// the view `w.index(r)` gives is shared, and its `&mut` is refused at the
// borrow, in rustc's words (E0596, "data in an index of `W`"). Before
// round 3 the call's view was typed `&mut [u8]` and the error came at
// `m.reverse()`; before RT-33 the literal was written (SIGBUS).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in an index of `W` as mutable
// ERROR: line 26, column 29
// ERROR-COUNT: 1
use std::ops::{Index, Range};

struct W {
    s: &'static [u8],
}

impl Index<Range<usize>> for W {
    type Output = [u8];

    fn index(&self, r: Range<usize>) -> &[u8] {
        &self.s[r]
    }
}

fn main() {
    let w = W { s: b"abc" };
    let m: &mut [u8] = &mut w[0usize..3];
    m.reverse();
}
