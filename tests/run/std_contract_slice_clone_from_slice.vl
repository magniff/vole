// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): clone_from_slice's `requires self.len() == src.len()`, violated last.
// EXPECT: 2
// EXIT: 101
// STDERR: requires failed: 'self.len() == src.len()'

fn main() {
    let mut a = [0, 0];
    let b = [1, 2];
    let c = [1];
    a.clone_from_slice(&b);
    println("{}", a[1]);
    a.clone_from_slice(&c);
}
