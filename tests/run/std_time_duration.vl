// The std item(s): std::time Duration; std::time Duration::new; std::time Duration::from_secs; std::time Duration::from_millis; std::time Duration::from_micros; std::time Duration::from_nanos; std::time Duration::is_zero; std::time Duration::as_secs; std::time Duration::subsec_millis; std::time Duration::subsec_micros; std::time Duration::subsec_nanos; std::time Duration::as_millis; std::time Duration::as_micros; std::time Duration::as_nanos; std::time Duration::as_secs_f64; std::time Duration::as_secs_f32; std::time Duration::impl Debug.
// EXPECT: 1.5s 100ms 7µs 9ns 2.000001ms 0ns
// EXPECT: 1.23s [2.5s  ] [ 70ms]
// EXPECT: 1 500 500000 500000000 1500 1500000 1500000000
// EXPECT: 1.5 1.5 false true
// EXPECT: 3.000000001s
use std::time::Duration;

fn main() {
    let d = Duration::new(1, 500000000);
    println("{:?} {:?} {:?} {:?} {:?} {:?}", d, Duration::from_millis(100),
        Duration::from_micros(7), Duration::from_nanos(9), Duration::from_nanos(2000001),
        Duration::from_secs(0));
    println("{:.2?} [{:6?}] [{:>5?}]", Duration::from_millis(1234), Duration::from_millis(2500),
        Duration::from_millis(70));
    println("{} {} {} {} {} {} {}", d.as_secs(), d.subsec_millis(), d.subsec_micros(),
        d.subsec_nanos(), d.as_millis(), d.as_micros(), d.as_nanos());
    println("{} {} {} {}", d.as_secs_f64(), d.as_secs_f32(), d.is_zero(),
        Duration::from_secs(0).is_zero());
    println("{:?}", Duration::new(2, 1000000001));
}
