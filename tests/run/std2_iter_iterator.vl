// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter Iterator.
// EXPECT: 10

struct Up {
    n: i64,
}

impl Iterator for Up {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n < 4 {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn main() {
    let s: i64 = Up { n: 0 }.sum();
    println("{}", s);
}
