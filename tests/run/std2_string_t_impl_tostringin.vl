// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string T::impl ToStringIn.
// EXPECT: P(1, 2)
use std::fmt::{Display, Formatter};

struct P {
    x: i64,
    y: i64,
}

impl Display for P {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "P({}, {})", self.x, self.y)
    }
}

fn main(gpa: Gpa) {
    let s = P { x: 1, y: 2 }.to_string_in(gpa);
    println("{}", s);
}
