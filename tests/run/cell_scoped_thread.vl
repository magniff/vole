// (0.26.1) A cell is not Sync: a scoped thread may not share one.
// ERROR: [sync.not_sync]: a thread of 'thread::scope' shares 'c' (Cell<i64> holds a cell (std::cell), which is not Sync at '.value' (UnsafeCell<i64>)) with another thread
use std::thread;
use std::cell::Cell;

fn main() {
    let c = Cell::new(1);
    thread::scope(|s| {
        s.spawn(|| c.get());
    });
}
