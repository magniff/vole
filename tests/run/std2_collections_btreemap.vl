// EDITION: rust
// The std2 item(s): std::collections::BTreeMap: new_in, insert, get, get_mut,
// get_key_value, contains_key, remove, remove_entry, len, is_empty, clear,
// first_key_value, last_key_value, pop_first, pop_last, iter, keys, values,
// range, entry (or_insert, or_insert_with, or_default, and_modify, key; the
// Occupied and Vacant entries), clone_in, Clone, PartialEq, Debug, Index,
// Extend, collect_in, `for (k, v) in &m`, `for (k, v) in m`; str lookups of
// String keys.
// RUSTC: none (the map takes its allocator; the entry types carry BTree)
// FLAGS: --check-alloc
// EXPECT: 5 false Some("two") None
// EXPECT: {1: "one", 2: "two", 3: "three", 5: "five", 8: "eight"}
// EXPECT: Some((1, "one")) Some((8, "eight"))
// EXPECT: [1, 2, 3, 5, 8] ["eight", "five", "three", "two", "one"]
// EXPECT: [2, 3] [2, 3, 5] [5, 8] [1, 2] [3, 5] []
// EXPECT: Some("TWO") Some("two!") Some((3, "three")) 3
// EXPECT: Some((1, "one")) Some((8, "eight")) {2: "two!", 5: "five"}
// EXPECT: {"a": 3, "b": 1, "c": 11} 3 true
// EXPECT: vacant d occupied 3 4 Some(4) 3
// EXPECT: true false true 11
// EXPECT: [("a", 3), ("b", 1), ("c", 11)] [("c", 11), ("b", 1), ("a", 3)]
// EXPECT: {1: 1, 2: 4, 3: 9} 0 true
// EXPECT: Some(7) Some(("k2", 7)) true false 1
use std::alloc::Gpa;
use std::collections::BTreeMap;
use std::collections::btree_map::BTreeEntry;

fn main(gpa: Gpa) {
    let mut m: BTreeMap<i64, &str, Gpa> = BTreeMap::new_in(gpa);
    m.insert(5, "five");
    m.insert(2, "TWO");
    m.insert(8, "eight");
    m.insert(1, "one");
    m.insert(3, "three");
    let old = m.insert(2, "two");
    println("{} {} {:?} {:?}", m.len(), m.is_empty(), m.get(&2), m.get(&4));
    println("{:?}", m);
    println("{:?} {:?}", m.first_key_value(), m.last_key_value());
    let ks: Vec<i64, Gpa> = m.keys().map(|k| *k).collect_in(gpa);
    let vs: Vec<&str, Gpa> = m.values().rev().map(|v| *v).collect_in(gpa);
    println("{:?} {:?}", ks, vs);
    let a: Vec<i64, Gpa> = m.range(2..5).map(|(k, _)| *k).collect_in(gpa);
    let b: Vec<i64, Gpa> = m.range(2..=5).map(|(k, _)| *k).collect_in(gpa);
    let c: Vec<i64, Gpa> = m.range(4..).map(|(k, _)| *k).collect_in(gpa);
    let d: Vec<i64, Gpa> = m.range(..3).map(|(k, _)| *k).collect_in(gpa);
    let e: Vec<i64, Gpa> = m.range(3..=7).map(|(k, _)| *k).collect_in(gpa);
    let f: Vec<i64, Gpa> = m.range(6..8).map(|(k, _)| *k).collect_in(gpa);
    println("{:?} {:?} {:?} {:?} {:?} {:?}", a, b, c, d, e, f);
    match m.get_mut(&2) {
        Some(v) => *v = "two!",
        None => {}
    }
    println("{:?} {:?} {:?} {}", old, m.remove(&2).map(|v| v), m.remove_entry(&3), m.len());
    m.insert(2, "two!");
    println("{:?} {:?} {:?}", m.pop_first(), m.pop_last(), m);

    let mut n: BTreeMap<&str, i64, Gpa> = BTreeMap::new_in(gpa);
    *n.entry("a").or_insert(0) += 1;
    *n.entry("a").or_insert(0) += 2;
    *n.entry("b").or_insert_with(|| 1) += 0;
    *n.entry("c").or_default() += 10;
    n.entry("c").and_modify(|v| *v += 1).or_insert(0);
    n.entry("z").and_modify(|v| *v += 1);
    println("{:?} {} {}", n, n.len(), n.contains_key("b"));
    match n.entry("d") {
        BTreeEntry::Vacant(e) => print("vacant {} ", e.key()),
        BTreeEntry::Occupied(_) => print("occupied "),
    }
    match n.entry("a") {
        BTreeEntry::Occupied(mut e) => {
            let was = e.insert(4);
            print("occupied {was} {} ", e.get());
        }
        BTreeEntry::Vacant(_) => print("vacant "),
    }
    println("{:?} {}", n.get("a"), n.len());
    n.insert("a", 3);
    let copy = n.clone_in(gpa);
    let mut other = n.clone();
    other.insert("q", 0);
    println("{} {} {} {}", copy == n, other == n, other.len() == 4, n["c"]);
    let mut pairs: Vec<(&str, i64), Gpa> = Vec::new_in(gpa);
    for (k, v) in &n {
        pairs.push((*k, *v));
    }
    let mut back: Vec<(&str, i64), Gpa> = Vec::new_in(gpa);
    for (k, v) in n.into_iter().rev() {
        back.push((k, v));
    }
    println("{:?} {:?}", pairs, back);

    let mut sq: BTreeMap<i64, i64, Gpa> = (1i64..4)
        .map(|i| (4 - i, (4 - i) * (4 - i)))
        .collect_in(gpa);
    print("{:?} ", sq);
    sq.extend((10i64..40).map(|i| (i, i)));
    sq.clear();
    println("{} {}", sq.len(), sq.iter().next().is_none());

    let mut s: BTreeMap<String<Gpa>, i64, Gpa> = BTreeMap::new_in(gpa);
    for i in 0..5 {
        let mut k = String::new_in(gpa);
        write(&mut k, "k{i}");
        s.insert(k, i + 5);
    }
    println("{:?} {:?} {} {} {}", s.get("k2"), s.get_key_value("k2").map(|(k, v)| (k.as_str(), *v)),
        s.contains_key("k4"), s.contains_key("k5"), s.range(String::from_in("k3x", gpa)..).count());
}
