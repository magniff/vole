// RT-38 (F9): the bindings a clause may make of what it reads: `ref`
// ones, a match or `let` through `&`, Copy parts by value; in a
// `requires` and an `ensures` alike (rustc accepts each on `r: &T`). The
// EXPECT lines are rustc's output for the bodies alone.
// FLAGS: --check-alloc
// EXPECT: 3
// EXPECT: 5
// EXPECT: 5
// EXPECT: 6
// EXPECT: 5
// EXPECT: 5
fn pre_let(t: (Vec<i64, Gpa>, Vec<i64, Gpa>)) -> i64
    requires {
    let (a, _b) = &t;
    a.len() > 0
}

requires {
    let (ref a, ref b) = t;
    a.len() + b.len() == 2
}
{
    t.0[0] + t.1[0]
}

fn pre_match(o: Option<Vec<i64, Gpa>>) -> i64
    requires match &o {
    Some(w) => w.len() > 0,
    None => true,
}

requires match o {
    Some(ref w) => w[0] > 0,
    None => true,
}
{
    o.unwrap()[0]
}

fn pre_iflet(o: Option<Vec<i64, Gpa>>) -> i64
    requires if let Some(w) = &o { w.len() > 0 } else { true }

{
    o.unwrap()[0]
}

fn pre_copy(t: (Vec<i64, Gpa>, i64)) -> i64
    requires {
    let n = t.1;
    let (_, m) = t;
    n + m > 0
}

{
    t.1
}

fn post_let(gpa: Gpa) -> (Vec<i64, Gpa>, i64)
    ensures {
    let (a, n) = &result;
    a.len() as i64 + *n > 0
}

{
    (Vec::from_in([5i64], gpa), 1)
}

fn post_match(gpa: Gpa) -> Option<Vec<i64, Gpa>>
    ensures match &result {
    Some(w) => w.len() > 0,
    None => true,
}

{
    Some(Vec::from_in([5i64], gpa))
}

fn main(gpa: Gpa) {
    println("{}", pre_let((Vec::from_in([1i64], gpa), Vec::from_in([2i64], gpa))));
    println("{}", pre_match(Some(Vec::from_in([5i64], gpa))));
    println("{}", pre_iflet(Some(Vec::from_in([5i64], gpa))));
    println("{}", pre_copy((Vec::from_in([1i64], gpa), 3)) * 2);
    println("{}", post_let(gpa).0[0]);
    println("{}", post_match(gpa).unwrap()[0]);
}
