// The std2 item(s): std::hash SipHashState::with_keys.
// EXPECT: true false
// RUSTC: none (SipHashState is std2's; its values are Rust's DefaultHasher's (SipHash-1-3, keys 0 and 0))
use std::hash::{BuildHasher, Hash, Hasher, SipHashState, SipHasher13};

fn main() {
    let z = SipHashState::with_keys(0, 0).hash_one(5u64);
    let k = SipHashState::with_keys(1, 2).hash_one(5u64);
    println("{} {}", z == SipHashState::new().hash_one(5u64), k == z);
}
