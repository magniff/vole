// RULE: D2.4a
// (0.30.1) An assignment evaluates its value first, then the place's index:
// `a[i] = bump(&mut i)` writes a[1], as rustc.
// EXPECT: [0, 7, 0] 1
fn bump(i: &mut usize) -> i64 {
    *i += 1;
    7
}

fn main() {
    let mut i: usize = 0;
    let mut a = [0i64, 0, 0];
    a[i] = bump(&mut i);
    println("{:?} {i}", a);
}
