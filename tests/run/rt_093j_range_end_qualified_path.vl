// A range whose end is a qualified path, `0..<S as A>::C`, `1..=<<S as A>::Out as B>::D`, `..<S as A>::C` (v0.30.1: "comparison operators cannot be chained")
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: 33 ..3
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn main() {
    let mut n = 0;
    for i in 0..<S as A>::C {
        n += i;
    }
    for i in 1..=<<S as A>::Out as B>::D {
        n += i * 10;
    }
    let r = ..<S as A>::C;
    println("{} {:?}", n, r);
}
