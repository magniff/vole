// XFAIL: RT-362e: WRONG CODE: (RT-362's family, AddAssign) `AddAssign::add_assign(&mut m, 7)` with `m: &mut V`, where V and &mut V each have their own `AddAssign<i64>` impl, runs V's: vole prints `a 7 b 0`, rustc `a 0 b 7` (0.30.2)
// From the re-review 2 of g302index (its form i08l_ufcs_generic_trait_ref, its AddAssign half). Since v0.30.1 at least
// (v0.30.1 and the release build print `a 7 b 0`).
// RT-362 is the index operator on a T parameter; rt_362b..e path calls.
// EXPECT: a 0 b 7
use std::ops::AddAssign;

struct V {
    a: i64,
    b: i64,
}

impl AddAssign<i64> for V {
    fn add_assign(&mut self, r: i64) {
        self.a += r;
    }
}

impl<'x> AddAssign<i64> for &'x mut V {
    fn add_assign(&mut self, r: i64) {
        self.b += r;
    }
}

fn main() {
    let mut u = V { a: 0, b: 0 };
    let mut m = &mut u;
    AddAssign::add_assign(&mut m, 7);
    println("a {} b {}", u.a, u.b);
}
