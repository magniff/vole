// FLAGS: -O2
// reread's `p: *const [i64]` and `q: *mut i64` point into the same array
// (both made from one base pointer). poke(q, 50) writes a[1]; the second
// (*p)[1] must read 50. rustc (debug and -O) prints 2050; vole -O0
// prints 2050, -O1 and -O2 print 2002 (the first load reused; with
// --no-noalias 2050). The same with `p: *mut [i64]`.
// EXPECT: 2050
// EXPECT: 1050
// EXPECT: [50, 50, 3, 4]
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn reread(p: *const [i64], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array, which lives across the call
    unsafe {
        let a = (*p)[1];
        poke(q, 50);
        let b = (*p)[1];
        a * 1000 + b
    }
}

#[inline(never)]
fn reread_mut(p: *mut [i64], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array, which lives across the call
    unsafe {
        let a = (*p)[0];
        poke(q, 50);
        let b = (*p)[0];
        a * 1000 + b
    }
}

fn main() -> i32 {
    let mut a = [1i64, 2, 3, 4];
    let base = a.as_mut_ptr();
    // UNSAFE: the raw slice and the element pointer are both made from base
    // SAFETY: a has 4 elements and outlives both pointers; no reference to a
    // is used while they are
    let (p, q) = unsafe {
        (std::slice::from_raw_parts_mut(base, 4) as *mut [i64], base.add(1))
    };
    println("{}", reread(p as *const [i64], q));
    println("{}", reread_mut(p, base));
    println("{:?}", a);
    0
}
