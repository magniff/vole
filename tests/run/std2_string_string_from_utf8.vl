// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::from_utf8.
// EXPECT: Ok("hi")
// EXPECT: 1
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let ok = String::from_utf8(Vec::from_in([104u8, 105], gpa));
    println("{:?}", ok);
    let bad = String::from_utf8(Vec::from_in([104u8, 255], gpa));
    match bad {
        Ok(_) => println("ok"),
        Err(e) => println("{}", e.utf8_error().valid_up_to()),
    }
}
