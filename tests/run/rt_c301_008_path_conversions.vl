// RULE: F8.3, F8.4
// A guard of the qualified-path change (0.30.2): conversions through a
// generic trait's paths, intrinsic ones (`i64::from(5i32)`, no impl in
// the program) chosen by the argument, the program's own by the argument
// or by the trait's written arguments. A first version of the change
// refused `i64::from`. rustc prints this line.
// EXPECT: 5 7 3 1004 1009 1002 true hi
struct W { v: i64 }
impl From<i32> for W { fn from(x: i32) -> W { W { v: x as i64 } } }
impl From<u8> for W { fn from(x: u8) -> W { W { v: x as i64 + 1000 } } }

fn main() {
    let a = i64::from(5i32);
    let b: i64 = i64::from(7u8);
    let c = W::from(3i32);
    let d = W::from(4u8);
    let e: W = From::from(9u8);
    let f = <W as From<u8>>::from(2u8);
    let g = u8::try_from(300i64).is_err();
    let s = "hi";
    println("{} {} {} {} {} {} {} {}", a, b, c.v, d.v, e.v, f.v, g, s);
}
