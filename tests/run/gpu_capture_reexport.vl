// (0.28.0, gap 109) std::gpu re-exports std::capture's three functions:
// `gpu::capture_next_frame` as the guide's window topic names it.
use std::gpu;

fn main() {
    println("{}", gpu::capture_pending());
    gpu::capture_next_frame("f.ppm");
    println("{}", gpu::capture_pending());
    gpu::capture_cancel();
    println("{}", gpu::capture_pending());
}
