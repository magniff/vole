// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops SubAssign::sub_assign.
// EXPECT: V { x: 7 } 7
use std::ops::SubAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl SubAssign for V {
    fn sub_assign(&mut self, rhs: V) {
        self.x -= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.sub_assign(V { x: 5 });
    let mut n = 12i64;
    n.sub_assign(5);
    println("{:?} {}", a, n);
}
