// RUSTC: none a type error (E0308): the twin compares the borrow checker's verdicts
// RULE: R5
// (0.28.0) No place is lent unasked: an array where `&[T]` goes, and a
// value given to a fn pointer's `&T` parameter, are rustc's E0308; with
// `&` they are the coercion and the borrow.
// ERROR: error[type.ref-value]: 'a' is a value where a reference goes
// ERROR: line 27, column 23
// ERROR: error[type.ref-value]: 'v' is a value where a reference goes
// ERROR: line 28, column 27
// ERROR-COUNT: 2
struct Ops {
    get: fn(&Vec<i64, Gpa>) -> usize,
}

fn sum(xs: &[i64]) -> i64 {
    xs.len() as i64
}

fn count(v: &Vec<i64, Gpa>) -> usize {
    v.len()
}

fn main(gpa: Gpa) {
    let a: [i64; 3] = [1, 2, 3];
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let o = Ops { get: count };
    println("{}", sum(a));
    println("{}", (o.get)(v));
    println("{} {}", sum(&a), (o.get)(&v));
}
