// RULE: D4.6
// (0.27.2.1) An elided lifetime in an impl's header is the impl's own
// lifetime: both `Self`s of `longer` are one `&'_ str`, so returning
// either is returning `Self`.
// EXPECT: abc
trait Longer {
    fn longer(self, other: Self) -> Self;
}

impl Longer for &str {
    fn longer(self, other: Self) -> Self {
        if self.len() >= other.len() { self } else { other }
    }
}

fn main() {
    println("{}", "ab".longer("abc"));
}
