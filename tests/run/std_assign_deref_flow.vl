// 0.30: an assignment through a Box, a guard or a type's DerefMut drops
// the old value wherever it stands: in a loop (each turn drops the turn
// before's), as a match arm's and an if's value, in a closure, with a
// right side that reads the place, in a generic function, and with a
// right side that returns early (`?`: nothing dropped, nothing written).
// A compound assignment (`*b += k`, AddAssign) drops nothing.
// FLAGS: --check-alloc
// EXPECT: loop
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: d1
// EXPECT: mk3
// EXPECT: d2
// EXPECT: mk4
// EXPECT: d3
// EXPECT: mk5
// EXPECT: mk6
// EXPECT: d5
// EXPECT: mk7
// EXPECT: d6
// EXPECT: --
// EXPECT: d7
// EXPECT: d4
// EXPECT: arm
// EXPECT: mk8
// EXPECT: mk10
// EXPECT: d8
// EXPECT: mk11
// EXPECT: d10
// EXPECT: --
// EXPECT: d11
// EXPECT: closure
// EXPECT: mk13
// EXPECT: mk14
// EXPECT: d13
// EXPECT: mk15
// EXPECT: d14
// EXPECT: --
// EXPECT: d15
// EXPECT: compound
// EXPECT: mk16
// EXPECT: mk17
// EXPECT: --
// EXPECT: d117
// EXPECT: d116
// EXPECT: reads itself
// EXPECT: mk18
// EXPECT: mk19
// EXPECT: d18
// EXPECT: --
// EXPECT: d19
// EXPECT: generic
// EXPECT: mk20
// EXPECT: mk21
// EXPECT: d20
// EXPECT: 200
// EXPECT: d21
// EXPECT: early exit
// EXPECT: mk22
// EXPECT: None
// EXPECT: mk41
// EXPECT: d22
// EXPECT: Some(41)
// EXPECT: --
// EXPECT: d41
// EXPECT: end
use std::ops::{AddAssign, Deref, DerefMut};
use std::sync::Mutex;

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

impl AddAssign<i64> for T {
    fn add_assign(&mut self, n: i64) { self.id += n; }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

fn sevens(n: usize, gpa: Gpa) -> Vec<u32, Gpa> {
    let mut v = Vec::new_in(gpa);
    for _ in 0..n { v.push(7u32); }
    v
}

struct W<X> { t: X }

impl<X> Deref for W<X> {
    type Target = X;
    fn deref(&self) -> &X { &self.t }
}

impl<X> DerefMut for W<X> {
    fn deref_mut(&mut self) -> &mut X { &mut self.t }
}

fn set_box<X>(b: &mut Box<X, Gpa>, v: X) { **b = v; }
fn may(fail: bool) -> Option<i64> { if fail { None } else { Some(1) } }

fn step(b: &mut Box<T, Gpa>, fail: bool) -> Option<i64> {
    **b = mk(may(fail)? + 40);
    Some(b.id)
}

fn main(gpa: Gpa) -> i32 {
    println("loop");
    {
        let mut b = Box::new_in(mk(1), gpa);
        for i in 2..5 { *b = mk(i); }
        let l = Mutex::new(mk(5));
        let mut i = 6;
        while i < 8 {
            *l.lock().unwrap() = mk(i);
            i += 1;
        }
        println("--");
    }
    println("arm");
    {
        let mut w = W { t: mk(8) };
        let k = 2;
        match k {
            1 => *w = mk(9),
            2 => *w = mk(10),
            _ => {}
        }
        if k == 2 { *w = mk(11) } else { *w = mk(12) }
        println("--");
    }
    println("closure");
    {
        let mut b = Box::new_in(mk(13), gpa);
        let mut f = |n: i64| { *b = mk(n); };
        f(14);
        f(15);
        println("--");
    }
    println("compound");
    {
        let mut b = Box::new_in(mk(16), gpa);
        *b += 100;
        let l = Mutex::new(mk(17));
        {
            let mut g = l.lock().unwrap();
            *g += 100;
        }
        println("--");
    }
    println("reads itself");
    {
        let mut b = Box::new_in(mk(18), gpa);
        *b = mk(b.id + 1);
        println("--");
    }
    println("generic");
    {
        let mut b = Box::new_in(mk(20), gpa);
        set_box(&mut b, mk(21));
        let mut v = Box::new_in(sevens(100, gpa), gpa);
        set_box(&mut v, sevens(200, gpa));
        println("{}", v.len());
    }
    println("early exit");
    {
        let mut b = Box::new_in(mk(22), gpa);
        println("{:?}", step(&mut b, true));
        println("{:?}", step(&mut b, false));
        println("--");
    }
    println("end");
    0
}
