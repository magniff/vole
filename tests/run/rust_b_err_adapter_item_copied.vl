// RULE: D4.6 (h)
// (0.30) A closure's requirement on `Self::Item` of an adapter whose Item
// is an impl parameter only a bound names (Copied's `type Item = T` of
// `impl<'a, T, I: Iterator<Item = &'a T>>`): fold's `|acc, p| p` makes the
// result borrow x, so the assignment conflicts (rustc E0506). It was
// accepted: the closure's requirement found no universal for T.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 16, column 5
// ERROR-COUNT: 1
fn main() {
    let mut x = 1i64;
    let px = &x;
    let a = [px];
    let z = 0i64;
    let out = a.iter().copied().fold(&z, |acc, p| p);
    x = 2;
    println("{}", *out);
}
