// EDITION: rust
// assigning through an inout drops the old value exactly once
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.id); } }
fn put(d: &mut D, id: i64) { *d = D { id: id }; }
fn main() { let mut a = D { id: 1 }; put(&mut a, 2); println("after"); }
