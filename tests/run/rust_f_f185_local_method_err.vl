// RULE: F18.5
// (0.27.7) An integer type's own method called on an open local, bound to a
// literal tree and not typed yet, is error type.infer, rustc's E0689, as on
// the literal itself: `m.count_ones()` was i32's (8 for 1 << 40 - 1).
// ERROR: error[type.infer]: cannot call method 'count_ones' on a local bound to an integer literal, whose type nothing gives
fn f(bits: i64) -> i64 {
    let max = (1 << bits as u64) - 1;
    let n = max.count_ones();
    println("{}", n);
    max
}

fn main() {
    println("{}", f(40));
}
