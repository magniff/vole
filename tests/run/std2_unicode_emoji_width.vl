// EDITION: rust
// The std2 item(s): std::unicode's display width against Unicode's
// emoji-test.txt (tests/std/unicode/): every fully-qualified emoji sequence
// is one grapheme cluster, 2 columns wide, by cluster_width and str_width.
// RUSTC: none (vole's own: Rust's std has no width)
// ARGS: @ROOT@/tests/std/unicode/emoji-test.txt
// EXPECT: 3963 sequences, 0 not one cluster, 0 not 2 wide
use std::unicode::{cluster_width, count_graphemes, str_width};

fn encode(cp: u32, out: &mut Vec<u8, Gpa>) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xc0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3f)) as u8);
    } else if cp < 0x10000 {
        out.push((0xe0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        out.push((0x80 | (cp & 0x3f)) as u8);
    } else {
        out.push((0xf0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3f)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        out.push((0x80 | (cp & 0x3f)) as u8);
    }
}

fn main(gpa: Gpa) {
    let path = std::env::args().nth(1).unwrap();
    let text = std::fs::read_to_string_in(path, gpa).unwrap();
    let mut count = 0;
    let mut split = 0;
    let mut narrow = 0;
    let mut utf8: Vec<u8, Gpa> = Vec::new_in(gpa);
    for line in text.lines() {
        if line.starts_with("#") || !line.contains("; fully-qualified") {
            continue;
        }
        let at = line.find(';').unwrap();
        utf8.clear();
        for word in line[..at].split_whitespace() {
            encode(u32::from_str_radix(word, 16).unwrap(), &mut utf8);
        }
        count += 1;
        let s = utf8.as_slice();
        if count_graphemes(s) != 1 {
            split += 1;
        }
        if cluster_width(s, false) != 2 || str_width(s, false) != 2 {
            narrow += 1;
        }
    }
    println("{count} sequences, {split} not one cluster, {narrow} not 2 wide");
}
