// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 64 5
trait Ad { fn ad<T>(&self, o: Self, t: T) -> i64; }
impl Ad for i32 { fn ad<T>(&self, o: i32, t: T) -> i64 { 32 } }
impl Ad for i64 { fn ad<T>(&self, o: i64, t: T) -> i64 { 64 } }
fn take(x: i64) -> i64 { x }

fn main() {
    let a = 5;
    let k = a.ad(1, 0u8);
    println("{} {}", k, take(a));
}
