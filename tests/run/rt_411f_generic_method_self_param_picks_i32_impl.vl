// XFAIL: RT-411f: (RT-411c, the impl's choice alone) `fn ad<T>(&self, o: Self, t: T) -> i64` impl'd for i32 (returns 32) and i64 (returns 64), `a.ad(1, 0u8)` on `let a = 5;` later passed to `take(x: i64)`: vole runs i32's impl and prints `32 5`, rustc `64 5`; no value overflows, only the impl is wrong (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 64 5
trait Ad { fn ad<T>(&self, o: Self, t: T) -> i64; }
impl Ad for i32 { fn ad<T>(&self, o: i32, t: T) -> i64 { 32 } }
impl Ad for i64 { fn ad<T>(&self, o: i64, t: T) -> i64 { 64 } }
fn take(x: i64) -> i64 { x }

fn main() {
    let a = 5;
    let k = a.ad(1, 0u8);
    println("{} {}", k, take(a));
}
