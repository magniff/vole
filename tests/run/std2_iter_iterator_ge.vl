// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::ge.
// EXPECT: true true false
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([1i64, 3], gpa);
    println("{} {} {}", b.iter().ge(a.iter()), a.iter().ge(a.iter()), a.iter().ge(b.iter()));
}
