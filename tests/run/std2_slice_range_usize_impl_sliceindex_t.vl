// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::slice Range<usize>::impl SliceIndex<[T]>.
// EXPECT: [2, 3] None
// EXIT: 101
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3, 4];
    println("{:?} {:?}", &s[1..3], s.get(3..9));
    let j = 5;
    println("{:?}", &s[1..j]);
}
