use std::alloc::Allocator; struct B<'a, A: Allocator> { names: Vec<&'a str, A> }
fn f<'a>(b: &B<'a, Gpa>) -> &'a str { b.names[0] }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut n: Vec<&str, Gpa> = Vec::new_in(gpa); n.push(w); let b = B { names: n };
    let r = f(&b);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
