// EDITION: rust
// RULE: Z9.1
// (0.27.2) A fat raw pointer has no region of its own: `pick` has one
// reference parameter, so its result's elided lifetime is E2's; a
// struct field of type `*const [T]` adds no slot.
fn pick(p: *const [i64], r: &i64) -> &i64 {
    let _ = p;
    r
}
struct Raw<'a> {
    p: *const [i64],
    r: &'a i64,
}
fn get<'a>(s: Raw<'a>) -> &'a i64 {
    s.r
}
fn main() {
    let a: [i64; 3] = [1, 2, 3];
    let p: *const [i64] = &a[..] as *const [i64];
    let x = 5;
    let r = pick(p, &x);
    let s = Raw { p: p, r: &x };
    println("{} {}", *r, *get(s));
}
// EXPECT: 5 5
