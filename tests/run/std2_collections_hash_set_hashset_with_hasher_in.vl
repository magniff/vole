// EDITION: rust
// The std2 item(s): std::collections::hash_set HashSet::with_hasher_in.
// EXPECT: true
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut s = HashSet::with_hasher_in(FixedState::new(), gpa);
    s.insert(1i64);
    println("{}", s.contains(&1));
}
