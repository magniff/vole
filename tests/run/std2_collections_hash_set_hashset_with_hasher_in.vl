use std::collections::{HashSet, hash_set};
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut s = HashSet::with_hasher_in(FixedState::new(), gpa);
    s.insert(1i64);
    println("{}", s.contains(&1));
}
