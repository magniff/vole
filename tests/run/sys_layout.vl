// FLAGS: --check-alloc
// CSOURCE: tests/c/sys_layout.c
// EXPECT: checked 106 mismatches 0
// 0.20 (A7): the layouts and constants std's OS layer writes by hand
// (compiler/std/sys/unix.vl, and the target's sys/macos.vl or
// sys/linux.vl) against the system's headers (tests/c/sys_layout.c,
// compiled by cc): struct stat, dirent, timespec, winsize, pollfd, the
// room for termios and posix_spawn_file_actions_t, and every flag, errno,
// clock, signal, ioctl and file-type value. A mismatch prints its name.
use std::sys::DirentLinux; use std::sys::DirentMacos; use std::sys::SYS_CLOCK_MONOTONIC;
use std::sys::SYS_CLOCK_REALTIME; use std::sys::SYS_DT_BLK; use std::sys::SYS_DT_CHR;
use std::sys::SYS_DT_DIR; use std::sys::SYS_DT_FIFO; use std::sys::SYS_DT_LNK;
use std::sys::SYS_DT_REG; use std::sys::SYS_DT_SOCK; use std::sys::SYS_DT_UNKNOWN;
use std::sys::SYS_EACCES; use std::sys::SYS_EAGAIN; use std::sys::SYS_EBADF;
use std::sys::SYS_ECHILD; use std::sys::SYS_EEXIST; use std::sys::SYS_EINTR;
use std::sys::SYS_EINVAL; use std::sys::SYS_EIO; use std::sys::SYS_EISDIR; use std::sys::SYS_ELOOP;
use std::sys::SYS_ENAMETOOLONG; use std::sys::SYS_ENOENT; use std::sys::SYS_ENOMEM;
use std::sys::SYS_ENOSPC; use std::sys::SYS_ENOSYS; use std::sys::SYS_ENOTDIR;
use std::sys::SYS_ENOTEMPTY; use std::sys::SYS_ENOTSUP; use std::sys::SYS_EPERM;
use std::sys::SYS_EPIPE; use std::sys::SYS_EROFS; use std::sys::SYS_ESRCH;
use std::sys::SYS_ETIMEDOUT; use std::sys::SYS_EXDEV; use std::sys::SYS_O_APPEND;
use std::sys::SYS_O_CLOEXEC; use std::sys::SYS_O_CREAT; use std::sys::SYS_O_DIRECTORY;
use std::sys::SYS_O_EXCL; use std::sys::SYS_O_NOCTTY; use std::sys::SYS_O_NONBLOCK;
use std::sys::SYS_O_RDONLY; use std::sys::SYS_O_RDWR; use std::sys::SYS_O_TRUNC;
use std::sys::SYS_O_WRONLY; use std::sys::SYS_PATH_MAX; use std::sys::SYS_POLLERR;
use std::sys::SYS_POLLHUP; use std::sys::SYS_POLLIN; use std::sys::SYS_POLLNVAL;
use std::sys::SYS_POLLOUT; use std::sys::SYS_POLLPRI; use std::sys::SYS_SEEK_CUR;
use std::sys::SYS_SEEK_END; use std::sys::SYS_SEEK_SET; use std::sys::SYS_SIGCHLD;
use std::sys::SYS_SIGHUP; use std::sys::SYS_SIGINT; use std::sys::SYS_SIGKILL;
use std::sys::SYS_SIGTERM; use std::sys::SYS_S_IFDIR; use std::sys::SYS_S_IFLNK;
use std::sys::SYS_S_IFMT; use std::sys::SYS_S_IFREG; use std::sys::SYS_TIOCGWINSZ;
use std::sys::SYS_TIOCSCTTY; use std::sys::SYS_TIOCSWINSZ; use std::sys::StatLinux;
use std::sys::StatMacos; use std::sys::SysPollFd; use std::sys::SysSpawnActions;
use std::sys::SysTermios; use std::sys::SysTimespec; use std::sys::SysWinsize;
use std::sys::TARGET_OS;

extern "C" {
    fn sys_layout_c(key: *mut u8) -> i64;
}

#[derive(Clone, Copy)] struct Check {
    count: i64,
    bad: i64,
}

impl Check {
    fn eq(&mut self, key: *mut u8, ours: i64) {
        self.count += 1;
        let theirs = unsafe { sys_layout_c(key) };
        if theirs != ours {
            self.bad += 1;
            let name = unsafe { std::sys::sys_cstr_view(key) };
            println("mismatch {name}: ours {ours}, the headers' {theirs}",
                name = str::from_utf8(name).unwrap());
        }
    }

    // ours is room for C's type: at least its size.
    fn room(&mut self, key: *mut u8, ours: i64) {
        self.count += 1;
        let theirs = unsafe { sys_layout_c(key) };
        if theirs > ours {
            self.bad += 1;
            let name = unsafe { std::sys::sys_cstr_view(key) };
            println("too small {name}: ours {ours}, the headers' {theirs}",
                name = str::from_utf8(name).unwrap());
        }
    }
}

// The byte offset of a field: its address in a zeroed buffer.
fn off(base: *mut u8, field: *mut u8) -> i64 {
    field as i64 - base as i64
}

fn main() -> i32 {
    let mut c = Check { count: 0, bad: 0 };
    let buf = [0u64; 160];
    let b = buf.as_ptr() as *mut u8;
    unsafe {
        if TARGET_OS == 1 {
            let s = b as *mut StatLinux;
            c.eq(c"sizeof stat", size_of(StatLinux));
            c.eq(c"stat.st_dev", off(b, &raw const s.st_dev as *mut u8));
            c.eq(c"stat.st_ino", off(b, &raw const s.st_ino as *mut u8));
            c.eq(c"stat.st_mode", off(b, &raw const s.st_mode as *mut u8));
            c.eq(c"stat.st_nlink", off(b, &raw const s.st_nlink as *mut u8));
            c.eq(c"stat.st_uid", off(b, &raw const s.st_uid as *mut u8));
            c.eq(c"stat.st_gid", off(b, &raw const s.st_gid as *mut u8));
            c.eq(c"stat.st_rdev", off(b, &raw const s.st_rdev as *mut u8));
            c.eq(c"stat.st_size", off(b, &raw const s.st_size as *mut u8));
            c.eq(c"stat.st_blocks", off(b, &raw const s.st_blocks as *mut u8));
            c.eq(c"stat.st_blksize", off(b, &raw const s.st_blksize as *mut u8));
            c.eq(c"stat.st_atime", off(b, &raw const s.st_atime as *mut u8));
            c.eq(c"stat.st_mtime", off(b, &raw const s.st_mtime as *mut u8));
            c.eq(c"stat.st_ctime", off(b, &raw const s.st_ctime as *mut u8));
            c.eq(c"sizeof stat.st_mode", size_of(u32));
            c.eq(c"sizeof stat.st_nlink", size_of(u32));
            c.eq(c"sizeof stat.st_dev", size_of(u64));
            c.eq(c"sizeof stat.st_blksize", size_of(i32));
            let d = b as *mut DirentLinux;
            c.eq(c"dirent.d_ino", off(b, &raw const d.d_ino as *mut u8));
            c.eq(c"dirent.d_type", off(b, &d.d_type as *mut u8));
            c.eq(c"dirent.d_name", off(b, d.d_name.as_ptr() as *mut u8));
            c.eq(c"sizeof dirent.d_name", 256);
        } else {
            let s = b as *mut StatMacos;
            c.eq(c"sizeof stat", size_of(StatMacos));
            c.eq(c"stat.st_dev", off(b, &raw const s.st_dev as *mut u8));
            c.eq(c"stat.st_ino", off(b, &raw const s.st_ino as *mut u8));
            c.eq(c"stat.st_mode", off(b, &raw const s.st_mode as *mut u8));
            c.eq(c"stat.st_nlink", off(b, &raw const s.st_nlink as *mut u8));
            c.eq(c"stat.st_uid", off(b, &raw const s.st_uid as *mut u8));
            c.eq(c"stat.st_gid", off(b, &raw const s.st_gid as *mut u8));
            c.eq(c"stat.st_rdev", off(b, &raw const s.st_rdev as *mut u8));
            c.eq(c"stat.st_size", off(b, &raw const s.st_size as *mut u8));
            c.eq(c"stat.st_blocks", off(b, &raw const s.st_blocks as *mut u8));
            c.eq(c"stat.st_blksize", off(b, &raw const s.st_blksize as *mut u8));
            c.eq(c"stat.st_atime", off(b, &raw const s.st_atime as *mut u8));
            c.eq(c"stat.st_mtime", off(b, &raw const s.st_mtime as *mut u8));
            c.eq(c"stat.st_ctime", off(b, &raw const s.st_ctime as *mut u8));
            c.eq(c"sizeof stat.st_mode", size_of(u16));
            c.eq(c"sizeof stat.st_nlink", size_of(u16));
            c.eq(c"sizeof stat.st_dev", size_of(i32));
            c.eq(c"sizeof stat.st_blksize", size_of(i32));
            let d = b as *mut DirentMacos;
            c.eq(c"dirent.d_ino", off(b, &raw const d.d_ino as *mut u8));
            c.eq(c"dirent.d_type", off(b, &d.d_type as *mut u8));
            c.eq(c"dirent.d_name", off(b, d.d_name.as_ptr() as *mut u8));
            c.eq(c"sizeof dirent.d_name", 1024);
        }
        let t = b as *mut SysTimespec;
        c.eq(c"sizeof timespec", size_of(SysTimespec));
        c.eq(c"timespec.tv_nsec", off(b, &raw const t.tv_nsec as *mut u8));
        let w = b as *mut SysWinsize;
        c.eq(c"sizeof winsize", size_of(SysWinsize));
        c.eq(c"winsize.ws_col", off(b, &raw const w.ws_col as *mut u8));
        c.eq(c"winsize.ws_ypixel", off(b, &raw const w.ws_ypixel as *mut u8));
        let p = b as *mut SysPollFd;
        c.eq(c"sizeof pollfd", size_of(SysPollFd));
        c.eq(c"pollfd.events", off(b, &raw const p.events as *mut u8));
        c.eq(c"pollfd.revents", off(b, &raw const p.revents as *mut u8));
        c.room(c"sizeof termios", size_of(SysTermios));
        c.room(c"sizeof posix_spawn_file_actions_t", size_of(SysSpawnActions) - 8);
        c.eq(c"O_RDONLY", SYS_O_RDONLY as i64);
        c.eq(c"O_WRONLY", SYS_O_WRONLY as i64);
        c.eq(c"O_RDWR", SYS_O_RDWR as i64);
        c.eq(c"O_CREAT", SYS_O_CREAT as i64);
        c.eq(c"O_TRUNC", SYS_O_TRUNC as i64);
        c.eq(c"O_APPEND", SYS_O_APPEND as i64);
        c.eq(c"O_EXCL", SYS_O_EXCL as i64);
        c.eq(c"O_NONBLOCK", SYS_O_NONBLOCK as i64);
        c.eq(c"O_CLOEXEC", SYS_O_CLOEXEC as i64);
        c.eq(c"O_NOCTTY", SYS_O_NOCTTY as i64);
        c.eq(c"O_DIRECTORY", SYS_O_DIRECTORY as i64);
        c.eq(c"F_GETFD", 1);
        c.eq(c"F_SETFD", 2);
        c.eq(c"F_GETFL", 3);
        c.eq(c"F_SETFL", 4);
        c.eq(c"FD_CLOEXEC", 1);
        c.eq(c"SEEK_SET", SYS_SEEK_SET as i64);
        c.eq(c"SEEK_CUR", SYS_SEEK_CUR as i64);
        c.eq(c"SEEK_END", SYS_SEEK_END as i64);
        c.eq(c"EPERM", SYS_EPERM as i64);
        c.eq(c"ENOENT", SYS_ENOENT as i64);
        c.eq(c"ESRCH", SYS_ESRCH as i64);
        c.eq(c"EINTR", SYS_EINTR as i64);
        c.eq(c"EIO", SYS_EIO as i64);
        c.eq(c"EBADF", SYS_EBADF as i64);
        c.eq(c"ECHILD", SYS_ECHILD as i64);
        c.eq(c"ENOMEM", SYS_ENOMEM as i64);
        c.eq(c"EACCES", SYS_EACCES as i64);
        c.eq(c"EEXIST", SYS_EEXIST as i64);
        c.eq(c"EXDEV", SYS_EXDEV as i64);
        c.eq(c"ENOTDIR", SYS_ENOTDIR as i64);
        c.eq(c"EISDIR", SYS_EISDIR as i64);
        c.eq(c"EINVAL", SYS_EINVAL as i64);
        c.eq(c"ENOSPC", SYS_ENOSPC as i64);
        c.eq(c"EROFS", SYS_EROFS as i64);
        c.eq(c"EPIPE", SYS_EPIPE as i64);
        c.eq(c"EAGAIN", SYS_EAGAIN as i64);
        c.eq(c"ENOTEMPTY", SYS_ENOTEMPTY as i64);
        c.eq(c"ETIMEDOUT", SYS_ETIMEDOUT as i64);
        c.eq(c"ENOSYS", SYS_ENOSYS as i64);
        c.eq(c"ENOTSUP", SYS_ENOTSUP as i64);
        c.eq(c"ENAMETOOLONG", SYS_ENAMETOOLONG as i64);
        c.eq(c"ELOOP", SYS_ELOOP as i64);
        c.eq(c"CLOCK_REALTIME", SYS_CLOCK_REALTIME as i64);
        c.eq(c"CLOCK_MONOTONIC", SYS_CLOCK_MONOTONIC as i64);
        c.eq(c"PATH_MAX", SYS_PATH_MAX);
        c.eq(c"SIGHUP", SYS_SIGHUP as i64);
        c.eq(c"SIGINT", SYS_SIGINT as i64);
        c.eq(c"SIGKILL", SYS_SIGKILL as i64);
        c.eq(c"SIGTERM", SYS_SIGTERM as i64);
        c.eq(c"SIGCHLD", SYS_SIGCHLD as i64);
        c.eq(c"WNOHANG", 1);
        c.eq(c"TIOCSWINSZ", SYS_TIOCSWINSZ as i64);
        c.eq(c"TIOCGWINSZ", SYS_TIOCGWINSZ as i64);
        c.eq(c"TIOCSCTTY", SYS_TIOCSCTTY as i64);
        c.eq(c"TCSANOW", 0);
        c.eq(c"POLLIN", SYS_POLLIN as i64);
        c.eq(c"POLLPRI", SYS_POLLPRI as i64);
        c.eq(c"POLLOUT", SYS_POLLOUT as i64);
        c.eq(c"POLLERR", SYS_POLLERR as i64);
        c.eq(c"POLLHUP", SYS_POLLHUP as i64);
        c.eq(c"POLLNVAL", SYS_POLLNVAL as i64);
        c.eq(c"DT_UNKNOWN", SYS_DT_UNKNOWN as i64);
        c.eq(c"DT_FIFO", SYS_DT_FIFO as i64);
        c.eq(c"DT_CHR", SYS_DT_CHR as i64);
        c.eq(c"DT_DIR", SYS_DT_DIR as i64);
        c.eq(c"DT_BLK", SYS_DT_BLK as i64);
        c.eq(c"DT_REG", SYS_DT_REG as i64);
        c.eq(c"DT_LNK", SYS_DT_LNK as i64);
        c.eq(c"DT_SOCK", SYS_DT_SOCK as i64);
        c.eq(c"S_IFMT", SYS_S_IFMT as i64);
        c.eq(c"S_IFDIR", SYS_S_IFDIR as i64);
        c.eq(c"S_IFREG", SYS_S_IFREG as i64);
        c.eq(c"S_IFLNK", SYS_S_IFLNK as i64);
    }
    println("checked {} mismatches {}", c.count, c.bad);
    0
}
