// a slice of v passed let while a closure argument reallocates v
// ERROR: error[borrowck.conflict]
fn f<F: FnMut()>(s: &[i64], mut w: F) -> i64 { w(); s[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    let r = f(v.as_slice(), || { for i in 0..1000 { v.push(i); } }); println("{r}");
}
