// RULE: R6
// (0.30.2) A callee's strict records are checked at its calls only for a
// parameter its body reads them of, one typed by a type parameter
// (regions::bound_param). A `fn(..)` parameter, written at the top
// (`pick`), behind a reference (`pickr`) or in a slice (`picks`), is
// called in the body as R6 reads its erased type, so any `fn` value may be
// given there: one forwarded from the caller's own `fn(..)` parameter
// (`outer`), a `fn` local, an array's element. A `mut` parameter typed by
// a type parameter, only called, is given on as its caller gave it (`fwm`).
// v0.30.2's rule refused each call of pick, pickr and picks given a value
// that is no item (borrowck.fn_value_bound; from the review of g302fnval:
// h29, h33), and fwm's call of kl; rustc builds them, and v0.30.1 the
// calls of pick, pickr and picks (it refused kl's body, RT-304).
// FLAGS: --check-alloc
// EXPECT: 5 5 5 5 5 5 5 5 5
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn pick<'a>(d: &'a i64, k: fn(&i64) -> &'a i64) -> &'a i64 {
    let l = 3i64;
    let _ = k(&l);
    k(d)
}

fn pickr<'a>(d: &'a i64, k: &fn(&i64) -> &'a i64) -> &'a i64 {
    let l = 3i64;
    let _ = k(&l);
    k(d)
}

fn picks<'a>(d: &'a i64, ks: &[fn(&i64) -> &'a i64]) -> &'a i64 {
    let l = 3i64;
    let _ = ks[0](&l);
    ks[1](d)
}

fn outer<'a>(d: &'a i64, k: fn(&i64) -> &'a i64) -> &'a i64 {
    pick(d, k)
}

fn kl<K, F: Fn(&i64) -> K>(f: F) -> K {
    let l = 4242i64;
    f(&l)
}

fn fwm<K, F: Fn(&i64) -> K + Copy>(mut f: F) -> K {
    let _ = f(&3);
    kl(f)
}

fn main() {
    let x = 4i64;
    let k: fn(&i64) -> &'static i64 = st;
    let mut v: [fn(&i64) -> &'static i64; 2] = [st, st];
    v[1] = st;
    let a = outer(&x, st);
    let b = outer(&x, k);
    let c = pick(&x, k);
    let d = pick(&x, v[1]);
    let e = pickr(&x, &k);
    let f = picks(&x, &[st, k]);
    let g = picks(&x, &v);
    let h = fwm(st);
    let i = fwm(k);
    println("{} {} {} {} {} {} {} {} {}", a, b, c, d, e, f, g, h, i);
}
