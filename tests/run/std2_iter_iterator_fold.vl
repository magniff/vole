// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::fold.
// EXPECT: 10 1234

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let s = v.iter().fold(0, |a, x| a + x);
    let t = v.iter().fold(0i64, |a, x| a * 10 + x);
    println("{} {}", s, t);
}
