// XFAIL: RT-419: (RT-149's by-name lookup, functions without self) `Default::default()` and `Mk::mk()` with the type from the context, `T::mk()` (T: Mk) and `T::default()` (T: Default) in a generic body, #[derive(Default)], Option::unwrap_or_default and mem::take run another trait's `default`/`mk` of the same name; a generic `a + b` (T: Add) runs another trait's `add` (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). vole prints `path -1 2
// generic 2 -1 derive -1 unwrap_or_default -1 take 3 -1` and `gadd 1000`
// at -O0 and -O2; v0.28.0 to v0.30.1 the same. The trait is named in the
// path (`Default::default()`) or is the parameter's only bound, yet the function
// that runs is OtherDef's (Mk2's): the lookup goes by the name `default`
// (`mk`) over every impl of F, the first impl declared winning (with std's
// Default impl declared before OtherDef's, `Default::default()` is right).
// `<F as Mk>::mk()` is right since v0.30.1 (v0.28.0-v0.30.0 ran Mk2's too).
// RT-77 is derive(Default) taking an inherent `default`; RT-382 is
// PartialEq's `eq` in generic bodies; RT-149 the operators on the program's
// own values.
// EXPECT: path 42 1 generic 1 42 derive 42 unwrap_or_default 42 take 3 42
// EXPECT: gadd 9
use std::ops::Add;

trait OtherDef {
    fn default() -> Self;
}

trait Mk2 {
    fn mk() -> Self;
}

trait Mk {
    fn mk() -> Self;
}

trait OtherAdd {
    fn add(self, o: Self) -> Self;
}

#[derive(Clone, Copy)]
struct F {
    k: i64,
}

impl OtherDef for F {
    fn default() -> F {
        F { k: -1 }
    }
}

impl Default for F {
    fn default() -> F {
        F { k: 42 }
    }
}

impl Mk2 for F {
    fn mk() -> F {
        F { k: 2 }
    }
}

impl Mk for F {
    fn mk() -> F {
        F { k: 1 }
    }
}

impl OtherAdd for F {
    fn add(self, o: F) -> F {
        F { k: 1000 }
    }
}

impl Add for F {
    type Output = F;

    fn add(self, o: F) -> F {
        F { k: self.k + o.k }
    }
}

#[derive(Default)]
struct W {
    f: F,
}

fn gmk<T: Mk>() -> T {
    T::mk()
}

fn gdef<T: Default>() -> T {
    T::default()
}

fn gadd<T: Add<Output = T>>(a: T, b: T) -> T {
    a + b
}

fn main() {
    let a: F = Default::default();
    let c: F = Mk::mk();
    let e: F = gmk();
    let g: F = gdef();
    let w: W = Default::default();
    let o: Option<F> = None;
    let mut t = F { k: 3 };
    let taken = std::mem::take(&mut t);
    println("path {} {} generic {} {} derive {} unwrap_or_default {} take {} {}", a.k, c.k, e.k,
        g.k, w.f.k, o.unwrap_or_default().k, taken.k, t.k);
    println("gadd {}", gadd(F { k: 4 }, F { k: 5 }).k);
}
