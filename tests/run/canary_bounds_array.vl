// EXIT: 101
// EXPECT: 4
// STDERR: canary_bounds_array.vl:10:19: index out of bounds: index 4, length 4
// 0.30.1, a canary of the bounds check on an array index, at every level:
// the index comes from the program's arguments (none: 4), not a constant.
fn main() {
    let a: [i64; 4] = [1, 2, 3, 4];
    let i = 3 + std::env::args().count();
    println("{}", a[i - 1]);
    println("{}", a[i]);
}
