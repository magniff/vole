// EDITION: rust
// nested closure stores a local of the inner closure into a capture of the outer
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 9, column 82
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut saved: Vec<&str, Gpa> = Vec::new_in(gpa);
    let mut f = |x: i64| {
        let mut g = |y: i64| { let s = String::from_in("inner", gpa); saved.push(s.as_str()); y };
        g(x)
    };
    f(1);
    println("{saved:?}");
}
