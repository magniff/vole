// EDITION: rust
// var b = G; changing b leaves G as it was (a copy).
// FLAGS: -O2
// EXPECT: 1 77
#[derive(Clone, Copy)] struct Big { a: i64, b: i64, c: i64, d: i64 }

static mut G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

fn main() -> i32 {
    let mut b = unsafe { G };
    b.a = 77;
    println("{} {}", unsafe { G.a }, b.a);
    0
}
