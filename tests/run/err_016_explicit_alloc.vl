// 0.16: allocation is explicit: std's constructors of 0.15 that took an
// allocator from nowhere are errors, with the `_in` form to write. (0.26.3:
// std has none of them; a call of one is alloc.no_in, naming the `_in`
// form, and std's ambient Gpa is gone.)
// ERROR: error[alloc.no_in]: 'Vec::new' allocates from nothing: pass the allocator, last, to 'Vec::new_in'
// ERROR: error[alloc.no_in]: 'collect' allocates from nothing: pass the allocator, last, to 'collect_in'
// ERROR: error[alloc.no_in]: 'format' allocates from nothing: pass the allocator, last, to 'format_in'
// ERROR: error[alloc.no_in]: 'HashMap::new' allocates from nothing: pass the allocator, last, to 'HashMap::new_in'
// ERROR: error[alloc.no_in]: 'Buf::new' allocates from nothing: pass the allocator, last, to 'Buf::new_in'
// ERROR: error[alloc.no_in]: 'Vec::with_capacity' allocates from nothing: pass the allocator, last, to 'Vec::with_capacity_in'
// ERROR: no associated function 'ambient' in 'Gpa'
// ERROR-COUNT: 7
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
fn main() {
    let v: Vec<i64, Gpa> = Vec::new();
    let w: Vec<i64, Gpa> = (0..3).collect();
    let b = format(1);
    let m: std::HashMap<i64, i64, Gpa> = std::HashMap::new();
    let x = std::Buf::new();
    let y: Vec<i64, Gpa> = Vec::with_capacity(3);
    let g = Gpa::ambient();
}
