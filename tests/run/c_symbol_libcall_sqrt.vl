// EXPECT: 4 42
// ASM(aarch64-macos): _vole.c_root:
// ASM-NOT(aarch64-macos):  _sqrt
// ASM(aarch64-macos): fsqrt
// ASM(aarch64-macos): _vole.not_root:
// ASM-NOT(aarch64-macos): fsqrt
// ASM(aarch64-macos): _csi_sqrt
// CSOURCE: tests/c/c_symbol_identity.c
// 0.30.1: back::isel makes a call of C's sqrt the square root instruction
// by the symbol the extern links to: `#[link_name = "sqrt"] fn root` is C's
// sqrt, an fsqrt at -O2 (0.30.0 left every extern with a #[link_name] a
// call), and `#[link_name = "csi_sqrt"] fn sqrt` is the program's, a call
// (its 42 is not a square root).
extern "C" {
    #[link_name = "sqrt"]
    fn root(x: f64) -> f64;
    #[link_name = "csi_sqrt"]
    fn sqrt(x: f64) -> f64;
}

#[inline(never)]
fn c_root(x: f64) -> f64 {
    // UNSAFE: C's sqrt. SAFETY: any number.
    unsafe { root(x) }
}

#[inline(never)]
fn not_root(x: f64) -> f64 {
    // UNSAFE: the program's C function. SAFETY: any number.
    unsafe { sqrt(x) }
}

fn main() {
    println("{} {}", c_root(16.0), not_root(16.0));
}
