// EDITION: rust
// a default inout-self method calling a sink-self method: a move out of an inout access
// ERROR: error[borrowck.move_out]
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

trait C {
    fn eat(self) -> i64;
    fn poke(&mut self) -> i64 where Self: Sized { self.eat() }
}

impl C for R { fn eat(self) -> i64 { self.id } }

fn main() {
    let mut r = R { id: 1 };
    println("{}", r.poke());
    println("end");
}
