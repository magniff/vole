// EDITION: rust
// XFAIL: gap 8: compile borrowck.move_out: cannot move out of 'r', a captured variable in an `FnMut` closure
// a sink closure moving its capture out, called twice: stops the program (exit 101)
// R dropped exactly once
// FLAGS: --check-alloc
// EXPECT: drop 7
// EXIT: 101
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn eat(r: R) -> i64 { r.id }
fn call2<F: FnMut() -> i64>(f: F) -> i64 { f() + f() }

fn main() {
    let r = R { id: 7 };
    println("{}", call2(move || eat(r)));
}
