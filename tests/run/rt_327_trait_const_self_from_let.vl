// XFAIL: RT-327: a trait's constant with Self from the expected type, `let c: S = Mk::Z;`, is refused ("'Mk' is a trait, not a type") (0.30.2)
// Since v0.30.1 at least, the release branch and g302qual too. rustc
// builds it and prints the EXPECT line. (The review's form f43, its
// constant part.)
// EXPECT: 5
trait Mk { const Z: Self; }
struct S { v: i64 }
impl Mk for S { const Z: S = S { v: 5 }; }
fn main() { let c: S = Mk::Z; println("{}", c.v); }
