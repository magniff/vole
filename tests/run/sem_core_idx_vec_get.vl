// Vec::get out of range fails its requires at the caller.
// EXIT: 101
// STDERR: index out of bounds: index 1, length 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", v[1 + unsafe { Z } as usize]);
    println("not reached");
    0
}
