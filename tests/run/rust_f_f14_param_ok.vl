// RULE: F14.1
// An impl parameter that only the trait's arguments fix, `impl<T: Show>
// Pick<T> for usize`: bound from the call's argument.
// EXPECT: 8
trait Show {
    fn show(&self) -> i64;
}

trait Pick<T> {
    fn pick(self, s: &T) -> i64;
}

struct S {
    n: i64,
}

impl Show for S {
    fn show(&self) -> i64 {
        self.n
    }
}

impl<T: Show> Pick<T> for usize {
    fn pick(self, s: &T) -> i64 {
        s.show() + self as i64
    }
}

fn main() {
    let s = S { n: 7 };
    let i: usize = 1;
    println("{}", i.pick(&s));
}
