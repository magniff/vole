// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.3
// (0.27.2.1) The opaque type meets a generic function's bound by its own
// bound, and the instance's body calls the hidden type's methods.
// EXPECT: 6
struct Counter {
    n: i32,
}

impl Iterator for Counter {
    type Item = i32;

    fn next(&mut self) -> Option<i32> {
        if self.n < 3 {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn count() -> impl Iterator<Item = i32> {
    Counter { n: 0 }
}

fn total<I: Iterator<Item = i32>>(mut it: I) -> i32 {
    let mut s: i32 = 0;
    while let Some(x) = it.next() {
        s += x;
    }
    s
}

fn main() {
    println("{}", total(count()));
}
