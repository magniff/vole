// RULE: F16.2
// A hole's spec on std: width, fill and alignment, zero padding, the sign,
// a str's precision, `#x` and the pretty `{:#?}`; and char's Display and
// Debug.
// EXPECT: [   42] [7   |] [  ab   ] [*****3] [00009] [+5] [ab]
// EXPECT: P {
// EXPECT:     x: 1,
// EXPECT:     y: 2,
// EXPECT: }
// EXPECT: 0xff [   z]
// EXPECT: [é] [  q] 'a' '\n' '\''
#[derive(Debug)]
struct P {
    x: i64,
    y: i64,
}

fn main() {
    let p = P { x: 1, y: 2 };
    println("[{:>5}] [{:<4}|] [{:^7}] [{:*>6}] [{:05}] [{:+}] [{:.2}]", 42, 7, "ab", 3, 9, 5,
        "abcd");
    println("{:#?}", p);
    println("{:#x} [{:>4}]", 255, "z");
    println("[{}] [{:>3}] {:?} {:?} {:?}", 'é', 'q', 'a', '\n', '\'');
}
