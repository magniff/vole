// (0.30.1, review 5) The impls that may meet `T: Tr<i32>` for a type are
// all of its impls of Tr, of every kind: the pattern impl `impl<'a, T>
// Tr<i32> for &'a T where 'a: 'static` beside the direct `impl<'a>
// Tr<i64> for &'a str` (trait arguments are not told apart where the
// lifetimes are checked, so each one's predicates are required). Before,
// the direct impl was taken as the one and the pattern impl's `where`,
// assumed in its body, was required nowhere (review 5's m12).
// ERROR: borrowck.return_local
// ERROR-COUNT: 1
trait Get {
    fn g(&self) -> &str;
}

impl Get for str {
    fn g(&self) -> &str {
        self
    }
}

trait Tr<U> {
    fn f(&self) -> &'static str;
}

impl<'a, T: Get + ?Sized> Tr<i32> for &'a T where 'a: 'static {
    fn f(&self) -> &'static str {
        let r: &'static T = *self;
        r.g()
    }
}

impl<'a> Tr<i64> for &'a str {
    fn f(&self) -> &'static str {
        "64"
    }
}

fn go<T: Tr<i32>>(t: &T) -> &'static str {
    t.f()
}

fn leak(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let r: &str = st.as_str();
    go(&r)
}

fn main(gpa: Gpa) {
    println("{}", leak(gpa));
}
