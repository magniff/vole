// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::char char::encode_utf8.
// EXPECT: é 2
// EXPECT: [195, 169]
// EXPECT: 😀 4
use std::char::from_u32;

fn main() {
    let mut buf = [0u8; 4];
    let s = 'é'.encode_utf8(&mut buf);
    println("{} {}", s, s.len());
    println("{:?}", &buf[..2]);
    let mut b4 = [0u8; 4];
    let t = '😀'.encode_utf8(&mut b4);
    println("{} {}", t, t.len());
}
