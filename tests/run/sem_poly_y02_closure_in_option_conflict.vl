// a closure borrowing an owned var kept in Some; the Vec grown while the closure is used after
// ERROR: error[borrowck.conflict]
// ERROR: line 9, column 24
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    let o = Some(|| s[0]);
    for i in 0..1000 { v.push(i); }
    println("{}", (o.unwrap())());
}
