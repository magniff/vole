// The bytes of a Buf indexed past its length (inside the capacity).
// EXIT: 101
// STDERR: index out of bounds: index 5, length 5
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut b = String::new_in(gpa);
    b.push_str("hello");
    let s = b.as_bytes();
    println("{}", s[(5 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
