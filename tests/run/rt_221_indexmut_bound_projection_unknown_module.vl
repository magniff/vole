// XFAIL: RT-221: `c[0] += 1` with `C: IndexMut<usize, Output = i64>` fails in std: unknown module 'I' (0.30.2)
// EXPECT: 5
use std::ops::IndexMut;

fn bump<C: IndexMut<usize, Output = i64>>(c: &mut C) {
    c[0] += 1;
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    bump(&mut v);
    println("{}", v[0]);
}
