// the right side changes the Vec whose element is assigned: rhs first (documented order)
// EXPECT: 5 2
fn grow(v: &mut Vec<i64, Gpa>) -> i64 { for i in 0..100 { v.push(i); } 5 }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v[0] = grow(&mut v);
    println("{} {}", v[0], v.len() - 99);
}
