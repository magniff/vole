// XFAIL: RT-220: `let s = &format_in(..)[1usize..];` and `[..]`, a range index of a String temporary, are refused (borrowck.dropped_borrowed); rustc accepts (0.30.2)
// Since v0.30.1 at least. From the review of the temporary-scope work.
// EXPECT: bc1
// EXPECT: abc1
fn main(gpa: Gpa) {
    let s = &format_in("abc{}", 1, gpa)[1usize..];
    println("{}", s);
    let t = &format_in("abc{}", 1, gpa)[..];
    println("{}", t);
}
