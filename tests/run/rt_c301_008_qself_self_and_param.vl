// RULE: F8.4
// `<Self as Mk>::k()` in a trait's default body, `<T>::k()` and `<T as Mk>::twice()` of a bounded parameter: not refused (rustc `42 63`). A guard: v0.30.1 did not parse them.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// EXPECT: 42 63
trait Mk {
    fn mk() -> Self;

    fn twice() -> i64 {
        <Self as Mk>::k() * 2
    }

    fn k() -> i64;
}

struct W<U> {
    p: Option<U>,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None }
    }

    fn k() -> i64 {
        21
    }
}

fn h<T: Mk>() -> i64 {
    <T>::k() + <T as Mk>::twice()
}

fn main() {
    println("{} {}", <W<u8> as Mk>::twice(), h::<W<i64>>());
}
