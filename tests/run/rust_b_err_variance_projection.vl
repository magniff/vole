// EDITION: rust
// RULE: D5.3
// (0.27.2) A parameter used through a projection is invariant there, as
// in rustc: `Held<&'b i64>` is not a `Held<&'a i64>` for a shorter 'a.
// ERROR: error[borrowck.outlives]
trait Source {
    type Out;
}

impl<'a> Source for &'a i64 {
    type Out = i64;
}

struct Held<U: Source> {
    front: Option<U::Out>,
}

fn shrink<'a, 'b: 'a>(h: Held<&'b i64>) -> Held<&'a i64> {
    h
}

fn main() {
    let k = 1;
    let h: Held<&i64> = Held { front: None };
    let _ = &k;
    let _s = shrink(h);
}
