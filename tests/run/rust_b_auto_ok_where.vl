// EDITION: rust
// RULE: AT3
// (0.27.2) `T: Send` in a `where` clause, `Send + Sync` together, and a
// bound met through a generic caller's own bound.
// EXPECT: 4 5
fn send<T: Send>(t: T) -> T {
    t
}

fn both<T>(t: T) -> T
    where
        T: Send + Sync,
{
    send(t)
}

fn main() {
    let a = both(4);
    let b = both((5, true));
    println("{} {}", a, b.0);
}
