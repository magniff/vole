// (0.30.2, obligations M1) An impl whose parameter only the trait argument
// binds, `impl<U: Bound> Tr<U> for W`: selection checks U's bound for the
// whole reference, so `W: Tr<B>` with B no Bound does not hold, refused at
// go's bound (rustc E0277; before, at the method's instance).
// ERROR: the trait 'Tr<B>' is not implemented for 'W'
trait Bound {}
trait Tr<U> { fn f(&self) -> i64; }
struct W;
struct A;
struct B;
impl Bound for A {}
impl<U: Bound> Tr<U> for W { fn f(&self) -> i64 { 1 } }
fn go<T: Tr<B>>(t: &T) -> i64 { t.f() }
fn main() { println("{}", go(&W)); }
