use std::alloc::Allocator; struct H<T, A: Allocator> { x: Vec<T, A> }
impl<T, A: Allocator> H<T, A> { fn first(&self) -> T { self.x[0usize] } }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa); v.push(s.as_str()); let h = H { x: v };
    let r = h.first();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
