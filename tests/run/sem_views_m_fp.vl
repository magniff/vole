// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) (see the program)
// ERROR: error[own.conflict]
struct H<T, A: Allocator> { x: Vec<T, A> }
impl<T, A: Allocator> H<T, A> { fn first(self) -> T { self.x.get(0) } }

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello world", gpa);
    var v: Vec<str, Gpa> = Vec::new_in(gpa); v.push(s.as_str()); let h = H { x: v };
    let r = h.first();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println(r);
    0
}
