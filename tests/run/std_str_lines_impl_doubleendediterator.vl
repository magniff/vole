// Runs on std since 0.27.2's switch.
// The std item(s): std::str Lines::impl DoubleEndedIterator.
// EXPECT: Some("c") Some("a") Some("") Some("b") None
use std::str::CharIndices;

fn main() {
    let mut l = "a\nb\n\nc\n".lines();
    let w = l.next_back();
    let x = l.next();
    let y = l.next_back();
    let z = l.next_back();
    println("{:?} {:?} {:?} {:?} {:?}", w, x, y, z, l.next());
}
