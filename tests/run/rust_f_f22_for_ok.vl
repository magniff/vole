// EDITION: rust
// RULE: F22.1
// On std2 a `for` loop is IntoIterator::into_iter and Iterator::next:
// an iterator (through `impl<I: Iterator> IntoIterator for I`), an
// adapter's, a pattern over its items; a range literal too.
// EXPECT: 132
fn main() {
    let a = [1i32, 2, 3];
    let mut s: i32 = 0;
    for x in a.iter() {
        s += *x;
    }
    for (i, x) in a.iter().enumerate() {
        s += (i as i32) * *x;
    }
    for x in a.iter().rev() {
        s = s * 2 + *x;
    }
    for i in 0i32..3 {
        s += i;
    }
    println("{}", s);
}
