// EDITION: rust
// The std2 item(s): std::alloc ArenaScope::impl Allocator.
// EXPECT: [1, 2]
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    arena.scope(|sc| {
        let mut v = Vec::new_in(sc);
        v.push(1);
        v.push(2);
        println("{:?}", v);
    });
}
