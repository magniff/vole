// RULE: F18.5
// (0.30.2) Literals typed u8, u16, u32, u64, usize and i8 by a later use,
// through a closure, an Option, an index and a generic call.
// EXPECT: 250 65000 4000000000 10000000000000000000 2 -100
fn take_u8(x: u8) -> u8 {
    x
}

fn take_u16(x: u16) -> u16 {
    x
}

fn take_u32(x: u32) -> u32 {
    x
}

fn take_u64(x: u64) -> u64 {
    x
}

fn take_usize(x: usize) -> usize {
    x
}

fn take_i8(x: i8) -> i8 {
    x
}

fn main() {
    let k = 200;
    let a = take_u8(Some(k).map(|y| y + 50).unwrap());
    let m = 60000;
    let b = take_u16((|| m + 5000)());
    let n = 2000000000;
    let c = take_u32(n * 2);
    let big = 10000000000000000000;
    let d = take_u64(big);
    let v = [1, 2, 3];
    let i = 1;
    let e = take_usize(v[i]);
    let s = -100;
    let f = take_i8(s);
    println("{a} {b} {c} {d} {e} {f}");
}
