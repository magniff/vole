// (0.30.2, the re-review of g302holes: r91/r07_generic_wrapper)
// EXPECT: 18
// EXPECT: 2
// A generic fn wrapping a closure that returns an iterator holding a closure.
fn apply<F: Fn(i64) -> R, R>(f: F, x: i64) -> R { f(x) }
struct Wrap<T> { t: T }
fn wrap<T>(t: T) -> Wrap<T> { Wrap { t: t } }

fn main() {
    let v = [1i64, 2, 3];
    let s: i64 = apply(|m| v.iter().map(move |x| x * m), 3).sum();
    println("{s}");
    let w = wrap(|m: i64| v.iter().filter(move |x| **x > m));
    let c = (w.t)(1).count();
    println("{c}");
}
