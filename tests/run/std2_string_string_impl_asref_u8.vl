// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl AsRef<[u8]>.
// EXPECT: [97, 98]
use std::string::ToStringIn;

fn bytes<S: AsRef<[u8]>>(s: &S) -> &[u8] {
    s.as_ref()
}

fn main(gpa: Gpa) {
    let s = String::from_in("ab", gpa);
    println("{:?}", bytes(&s));
}
