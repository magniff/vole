// v4f32::load past the end.
// EXIT: 101
// STDERR: slice range out of bounds: 1..5, length 4
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let xs: [f32; 4] = [1.0, 2.0, 3.0, 4.0];
    let v = v4f32::load(&xs[..], 1 + unsafe { Z });
    println("{}", v.sum() as i64);
    println("not reached");
    0
}
