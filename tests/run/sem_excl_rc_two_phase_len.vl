// EDITION: rust
// two-phase: v.push(v.len()) is fine
// EXPECT: 0 1 2
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); { let at_arg1 = v.len() as i64; v.push(at_arg1) };
    { let at_arg1 = v.len() as i64; v.push(at_arg1) };
    { let at_arg1 = v.len() as i64; v.push(at_arg1) };
    println("{} {} {}", v[0], v[1], v[2]);
}
