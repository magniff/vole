// EDITION: rust
// Arrays of arrays: matrix transpose in place.
// EXPECT: 1 4 7 | 2 5 8 | 3
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn main() -> i64 {
    let mut m: [[i64; 3]; 3] = [[1i64, 2, 3], [4i64, 5, 6], [7i64, 8, 9]];
    let mut i: i64 = 0;
    while i != 3 {
        let mut j = i + 1;
        while j != 3 {
            let t = m[i as usize][j as usize];
            m[i as usize][j as usize] = m[j as usize][i as usize];
            m[j as usize][i as usize] = t;
            j += 1;
        }
        i += 1;
    }
    let row = m[1];
    unsafe {
        printf(c"%ld %ld %ld | %ld %ld %ld | %ld\n", m[0][0], m[0][1], m[0][2], row[0], row[1],
            row[2], m[2][0]);
    }
    0
}
