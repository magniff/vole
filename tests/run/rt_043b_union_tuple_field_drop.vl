// RULE: F19.8
// (0.30.2, RT-43) A tuple field of a union with a part that needs drop:
// `u.t.1 = D { v: 3 }` dropped the old `D` read from the array's bytes
// ("drop 5"). A tuple is allowed when each of its parts is (rustc's
// allowed_union_field), so the field is refused, as rustc's E0740.
// ERROR: error[union.field]: a union's field must be Copy, a reference or a `ManuallyDrop<T>`: field 't' of union 'U' has type '(i64, D)' (rustc E0740)
// ERROR: line 20, column 5
// ERROR-COUNT: 1
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

union U {
    t: (i64, D),
    x: [i64; 2],
}

fn main() {
    let mut u = U { t: (0, D { v: 1 }) };
    u.x = [5, 5];
    u.t.1 = D { v: 3 };
    println("end");
}
