// XFAIL: RT-412: `v.iter().map(|x| x * 2).sum::<i64>()` over a Vec of literals is refused; rustc prints 6 (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 6
fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let s = v.iter().map(|x| x * 2).sum::<i64>();
    println("{}", s);
}
