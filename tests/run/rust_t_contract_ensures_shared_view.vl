// EDITION: rust
// RULE: C3
// (0.27.1) An ensures sees a `&mut [i64]` parameter as `&[i64]` (the
// wrapper's `let s: &[i64] = s;`): reading it is fine, writing an
// element is refused by the types.
// ERROR: error[borrowck.assign_immutable]: cannot assign to 's
// ERROR-COUNT: 1
fn fill(s: &mut [i64], v: i64) -> i64
    ensures s[0] == v
{
    s[0] = v;
    s[0]
}

fn bad(s: &mut [i64]) -> i64
    ensures {
    s[0] = 0;
    true
}

{
    s[0]
}

fn main() {
    let mut a = [1, 2];
    println("{} {}", fill(&mut a, 5), bad(&mut a));
}
// XFAIL: std2 has no contract_check, which a contract's lowering calls (std2)
