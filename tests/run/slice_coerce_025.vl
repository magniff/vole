fn count<T: Copy>(xs: &[T]) -> i64 { xs.len() as i64 }
fn first<T: Copy>(xs: &[T]) -> T { xs[0] }
fn bump<T: Copy>(xs: &mut [T], v: &T) { xs[0] = v; }

fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(7); v.push(41); v
}

fn sum(xs: &[i64]) -> i64 { let mut t: i64 = 0; for &x in xs { t += x; } t }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let a = [1i64, 2, 3];
    let mut b = String::new_in(gpa);
    b.push_str("xy");
    println("{}", count(&v));
    println("{}", count(&a));
    println("{}", first(b));
    bump(&mut v, &9i64);
    println("{}", v[0]);
    let mut arr = [5i64, 6];
    bump(&mut arr, &8i64);
    println("{}", arr[0]);
    println("{}", sum(&[4i64, 5]));
    println("{}", sum(&mk(gpa)));
    println("{}", count(&mk(gpa)));
    println("{}", first(&[3i64, 4]));
    let k = sum(&mk(gpa)) + sum(&[1i64; 3]);
    println("{}", k);
    0
}
