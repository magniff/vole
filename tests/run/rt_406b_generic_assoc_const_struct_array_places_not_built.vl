// XFAIL: RT-406: (RT-406's mechanism, an array) `fn g<X: T>() { let a = [X::C, X::C]; println("g {}", a[0].k); }`, never instantiated, is refused with places.not_built ("a compiler bug"); rustc builds it and prints the EXPECT line (0.30.2)
// From the re-review of g302copy-148 (the array form of pre/q10). Since
// v0.30.1 at least; the release build the same. Sibling: rt_406.
// EXPECT: ok
struct D {
    k: i64,
}

trait T {
    const C: D;
}

fn g<X: T>() {
    let a = [X::C, X::C];
    println("g {}", a[0].k);
}

fn main() {
    println("ok");
}
