// (0.26.1) `for e in arr` over an array place that is not Freeze iterates
// a view of it (`arr[0..N]`), not a copy: each item is the element's
// place, so a write through it reaches the array. A Freeze array is still
// copied (the loop may not change it anyway).
// EXPECT: 9 9
// EXPECT: 7
// EXPECT: 3
use std::cell::Cell;

struct Slot { c: Cell<i64>, n: i64 }

fn main() {
    let arr = [Cell::new(1), Cell::new(1)];
    for e in arr {
        e.set(9);
    }
    println(f"{arr[0].get()} {arr[1].get()}");
    let slots = [Slot { c: Cell::new(0), n: 1 }, Slot { c: Cell::new(0), n: 2 }];
    for s in slots {
        s.c.set(s.c.get() + 5 + s.n);
    }
    println(f"{slots[1].c.get()}");
    var sum = 0;
    for x in [1, 2] {
        sum += x;
    }
    println(f"{sum}");
}
