// EDITION: rust
// XFAIL: gap 22: compile type error: expected 'let Sh<Gpa>', got 'Sh<Gpa>'
// (0.25.2.2) An argument of a call of a function with a requires clause:
// the call is a block that binds the arguments first (contracts::desugar
// requires_call, `{ let ?a0 = arg; f$pre(..); f(?a0, ..) }`), checked by
// hand, whose lets the own pass never visited. `dev.compute_pipeline(
// dev.shader_wgsl(SRC)?, "evolve")?` (compute_pipeline requires
// self.caps.compute) passed a shader dropped before the call ("no compute
// entry point"); a plain temporary there leaked, and a match with a
// returning arm read its dropped binding. Its sweep:
// own_arg_temp_sweep_*_req (tools/sinksweep/argsweep.py).
// FLAGS: --check-alloc
// EXPECT: q? ok 13
// EXPECT: q ok 13
// EXPECT: plain? ok 13
// EXPECT: plain ok 13
// EXPECT: tail ok 13
// EXPECT: match ok 13
// EXPECT: sink, then ? fails err -2

use std::alloc::Allocator; struct Sh<A: Allocator> {
    names: Vec<i64, A>,
}

#[derive(Clone, Copy)] struct D {
    k: i64,
    on: bool,
}

impl D {
    fn make(self, gpa: Gpa) -> Result<Sh<Gpa>, i64> {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(self.k);
        v.push(7);
        Ok(Sh { names: v })
    }

    fn mk(self, gpa: Gpa) -> Sh<Gpa> {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(self.k);
        v.push(7);
        Sh { names: v }
    }

    fn num(self, n: i64) -> Result<i64, i64> {
        if n < 0 {
            return Err(n);
        }
        Ok(n)
    }

    fn pipe(self, s: &Sh<Gpa>, entry: &str) -> Result<i64, i64>
        requires self.on
        else "gpu.off"
        {
        if s.names.len() != 2 {
            return Err(-1i64);
        }
        Ok(s.names[1] + entry.len() as i64)
    }

    fn take(self, s: Sh<Gpa>, n: i64) -> Result<i64, i64>
        requires self.on
        else "gpu.off"
        {
        Ok(s.names[1] + n)
    }
}

fn a(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.make(gpa)?, "evolve")?;
    Ok(p)
}

fn b(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.make(gpa)?, "evolve");
    p
}

fn c(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.mk(gpa), "evolve")?;
    Ok(p)
}

fn e(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(d.mk(gpa), "evolve");
    p
}

fn tail(d: D, gpa: Gpa) -> Result<i64, i64> {
    d.pipe(d.make(gpa)?, "evolve")
}

fn matched(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.pipe(match d.make(gpa) { Ok(s) => s, Err(e) => return Err(e) }, "evolve");
    p
}

fn sink_then_q(d: D, gpa: Gpa) -> Result<i64, i64> {
    let p = d.take(d.mk(gpa), d.num(-2)?)?;
    Ok(p)
}

fn show(n: &str, r: Result<i64, i64>) {
    match r {
        Ok(v) => println("{n} ok {v}"),
        Err(e) => println("{n} err {e}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let d = D { k: 3, on: true };
    show("q?", a(d, gpa));
    show("q", b(d, gpa));
    show("plain?", c(d, gpa));
    show("plain", e(d, gpa));
    show("tail", tail(d, gpa));
    show("match", matched(d, gpa));
    show("sink, then ? fails", sink_then_q(d, gpa));
    0
}
