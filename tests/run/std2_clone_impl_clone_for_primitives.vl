// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::clone impl Clone for primitives.
// EXPECT: 5 2.5 true 200
use std::clone::Clone;
use std::marker::Copy;

fn main() {
    let a = 5i64;
    let b = 2.5f64;
    let c = true;
    let d = 200u8;
    println("{} {} {} {}", a.clone(), b.clone(), c.clone(), d.clone());
}
