// EDITION: rust
// RUSTC-EDITION: 2024
// RUSTC: none the same verdict, which rustc names E0597 (`x` does not live long enough) for an opaque result
// RULE: D21.2
// (0.27.2.1) A local's loan in the hidden type: no member of the captured
// lifetimes can be chosen (rustc E0515).
// ERROR: error[borrowck.return_local]
trait Tr {
    fn get(&self) -> i32;
}

impl<'a> Tr for &'a i32 {
    fn get(&self) -> i32 { **self }
}

fn local() -> impl Tr {
    let x: i32 = 5;
    &x
}

fn main() {
    println("{}", local().get());
}
