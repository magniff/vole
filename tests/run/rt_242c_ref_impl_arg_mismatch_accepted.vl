// XFAIL: RT-242c: (must-fail side of R302E-19b) `x.tk(5i64)` with x: &W, `impl Tk<u8> for &W` and `impl Tk<i64> for W` is accepted and runs W's impl; rustc E0308 (the probe stops at &W, whose Tk takes a u8) (0.30.2)
// rustc: error[E0308] mismatched types at line 55 (twin .rs.txt). The release
// build builds it and prints `23 23 13` and `105`.
// ERROR: line 55
use std::ops::Add;

#[derive(Clone, Copy)]
struct W {
    k: i64,
}

impl Add<W> for W {
    type Output = i64;

    fn add(self, o: W) -> i64 {
        10 + self.k + o.k
    }
}

impl<'b> Add<&'b W> for W {
    type Output = i64;

    fn add(self, o: &'b W) -> i64 {
        20 + self.k + o.k
    }
}

impl<'a, 'b> Add<&'b W> for &'a W {
    type Output = i64;

    fn add(self, o: &'b W) -> i64 {
        30 + self.k + o.k
    }
}

trait Tk<R> {
    fn tk(self, o: R) -> i64;
}

impl Tk<i64> for W {
    fn tk(self, o: i64) -> i64 {
        100 + o
    }
}

impl<'a> Tk<u8> for &'a W {
    fn tk(self, o: u8) -> i64 {
        200 + o as i64
    }
}

fn main() {
    let a = W { k: 1 };
    let b = W { k: 2 };
    let x = &a;
    let y = &b;
    println("{} {} {}", x.add(y), a.add(y), a.add(b));
    println("{}", x.tk(5i64));
}
