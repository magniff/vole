// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_set HashSet::is_subset.
// EXPECT: true false
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    println("{} {}", a.is_subset(&b), b.is_subset(&a));
}
