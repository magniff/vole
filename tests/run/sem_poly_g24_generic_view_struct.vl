// EDITION: rust
// a generic struct holding a view (T = [i64]) outliving the Vec
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 12, column 12
#[derive(Clone, Copy)] struct Box1<T> { x: T }
fn mk<T>(x: T) -> Box1<T> { Box1 { x: x } }

fn main(gpa: Gpa) {
    let b = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        mk(v.as_slice())
    };
    println("{}", b.x[0]);
}
