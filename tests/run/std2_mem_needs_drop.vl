// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::mem needs_drop.
// EXPECT: false true true
use std::mem::needs_drop;
use std::vec::Vec;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {}
}

fn main() {
    println("{} {} {}", needs_drop::<i64>(), needs_drop::<D>(), needs_drop::<Vec<i64, Gpa>>());
}
