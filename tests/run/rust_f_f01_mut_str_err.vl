// RULE: F0.1
// A `&mut self` method of str on a `&str` is a write through a shared
// reference: refused (rustc E0596, "cannot borrow `*s` as mutable, as it
// is behind a `&` reference").
// ERROR: error[borrowck.borrow_immutable]: cannot borrow the receiver as mutable, as it is behind a `&` reference (rustc E0596): method 'make_ascii_uppercase' takes `&mut self`, and the receiver is a shared '&str'
fn shout(s: &str) {
    s.make_ascii_uppercase();
}

fn main(gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str("ab");
    shout(&b);
}
