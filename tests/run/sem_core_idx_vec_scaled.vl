// EDITION: rust
// An index whose byte offset wraps to a valid one (2^61 * 8 == 0) is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 2305843009213693952, length 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    println("{}", v[(2305843009213693952 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
