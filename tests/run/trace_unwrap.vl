// (0.17) --trace: std's failures (unwrap) show the caller's line; std's
// own frames are not kept. Recursion deeper than 20 frames shows the
// innermost 20, a count, the outermost 4.
// FLAGS: --trace
// EXIT: 101
// STDERR: called `Option::unwrap()` on a `None` value
// STDERR: trace_unwrap.vl:17  find
// STDERR: trace_unwrap.vl:20  find
// STDERR:   ... 7 more
// STDERR: trace_unwrap.vl:24  main
fn first_even(v: &[i64]) -> Option<i64> {
    for i in 0..v.len() { if v[i] % 2 == 0 { return Some(v[i]); } }
    None
}

fn find(v: &[i64], depth: i64) -> i64 {
    if depth == 0 { return first_even(v).unwrap(); }
    // (the recursion)
    let r =
        find(v, depth - 1);
    r
}

fn main() -> i32 { print("{}", find(&[1i64, 3, 5][..], 29)); 0 }
