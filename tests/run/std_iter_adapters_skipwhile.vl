// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter::adapters SkipWhile.
// EXPECT: [3, 1]
use std::iter::SkipWhile;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 3, 1], gpa);
    let v: Vec<i64, Gpa> = s.iter().copied().skip_while(|x| *x < 2).collect_in(gpa);
    println("{:?}", v);
}
