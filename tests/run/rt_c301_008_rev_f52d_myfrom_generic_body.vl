// RULE: F8.3, F8.4
// RT-C301-8 review (R2, form f52d_myfrom_generic_body): `T::from(5u8)` under one bound, `MyFrom<u8>` or `From<u8>`: that bound's trait.
// rustc prints the EXPECT lines.
// EXPECT: 1005 5
trait MyFrom<T> { fn from(x: T) -> Self; }
impl MyFrom<u8> for i64 { fn from(x: u8) -> i64 { 1000 + x as i64 } }
fn g<T: MyFrom<u8>>() -> T { T::from(5u8) }
fn h<T: From<u8>>() -> T { T::from(5u8) }
fn main() { let a: i64 = g(); let b: i64 = h(); println("{} {}", a, b); }
