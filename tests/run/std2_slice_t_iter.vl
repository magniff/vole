// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::iter.
// EXPECT: 1 2 3 sum 6
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3];
    let mut sum = 0;
    for x in s.iter() {
        print("{} ", x);
        sum += *x;
    }
    println("sum {}", sum);
}
