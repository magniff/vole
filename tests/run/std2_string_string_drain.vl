// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::drain.
// EXPECT: bc ad
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let mut s = String::from_in("abcd", gpa);
    let mut taken: String<Gpa> = String::new_in(gpa);
    for c in s.drain(1usize..3) {
        taken.push(c);
    }
    println("{} {}", taken, s);
}
