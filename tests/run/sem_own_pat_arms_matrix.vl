// EDITION: rust
// (0.25) Every arm shape (all bound, one, the other, none, a wildcard arm,
// the whole value, if-let chains) on every variant: a by-value match on an
// owned local drops every T once (a line is printed for any left alive).
// EXPECT: done 285
static mut LIVE: i64 = 0;
static mut NEXT: i64 = 0;
static mut SUM: i64 = 0;
struct T { id: i64 }
fn mk() -> T { unsafe { NEXT += 1; } unsafe { LIVE += 1; } T { id: unsafe { NEXT } } }
impl Drop for T { fn drop(&mut self) { unsafe { LIVE -= 1; } } }
enum E { A(T), B(T, T), C { x: T, y: T }, N }
fn use1(n: i64) { unsafe { SUM += n; } }

fn m_A_all() {
    let e = E::A(mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0),
    }
}

fn m_A_first() {
    let e = E::A(mk());
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0),
    }
}

fn m_A_second() {
    let e = E::A(mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0),
    }
}

fn m_A_none() {
    let e = E::A(mk());
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_A_wild() {
    let e = E::A(mk());
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_A_wildA() {
    let e = E::A(mk());
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_A_whole() {
    let e = E::A(mk());
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_A_iflet() {
    let e = E::A(mk());
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn m_B_all() {
    let e = E::B(mk(), mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0),
    }
}

fn m_B_first() {
    let e = E::B(mk(), mk());
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0),
    }
}

fn m_B_second() {
    let e = E::B(mk(), mk());
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0),
    }
}

fn m_B_none() {
    let e = E::B(mk(), mk());
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_B_wild() {
    let e = E::B(mk(), mk());
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_B_wildA() {
    let e = E::B(mk(), mk());
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_B_whole() {
    let e = E::B(mk(), mk());
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_B_iflet() {
    let e = E::B(mk(), mk());
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn m_C_all() {
    let e = E::C { x: mk(), y: mk() };
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0),
    }
}

fn m_C_first() {
    let e = E::C { x: mk(), y: mk() };
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
        E::N => use1(0),
    }
}

fn m_C_second() {
    let e = E::C { x: mk(), y: mk() };
    match e {
        E::A(a) => use1(a.id),
        E::B(_, b) => use1(b.id),
        E::C { y, .. } => use1(y.id),
        _ => use1(0),
    }
}

fn m_C_none() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::A(_) => use1(0), E::B(_, _) => use1(0), E::C { .. } => use1(0), E::N => use1(0) }
}

fn m_C_wild() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_C_wildA() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_C_whole() {
    let e = E::C { x: mk(), y: mk() };
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_C_iflet() {
    let e = E::C { x: mk(), y: mk() };
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn m_N_all() {
    let e = E::N;
    match e {
        E::A(a) => use1(a.id),
        E::B(a, b) => use1(a.id + b.id),
        E::C { x, y } => use1(x.id + y.id),
        E::N => use1(0),
    }
}

fn m_N_first() {
    let e = E::N;
    match e {
        E::A(_) => use1(0),
        E::B(a, _) => use1(a.id),
        E::C { x, .. } => use1(x.id),
