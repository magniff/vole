    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_A_wildA live {live_now}"); unsafe { LIVE = 0; }
    }
    m_A_whole();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_A_whole live {live_now}"); unsafe { LIVE = 0; }
    }
    m_A_iflet();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_A_iflet live {live_now}"); unsafe { LIVE = 0; }
    }
    m_B_all();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_B_all live {live_now}"); unsafe { LIVE = 0; }
