    m_B_first();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_B_first live {live_now}"); unsafe { LIVE = 0; }
    }
    m_B_second();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_B_second live {live_now}"); unsafe { LIVE = 0; }
    }
    m_B_none();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_B_none live {live_now}"); unsafe { LIVE = 0; }
    }
    m_B_wild();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_B_wild live {live_now}"); unsafe { LIVE = 0; }
