fn m_N_wild() {
    let e = E::N;
    match e { E::B(a, _) => use1(a.id), _ => use1(0) }
}

fn m_N_wildA() {
    let e = E::N;
    match e { E::A(a) => use1(a.id), _ => use1(0) }
}

fn m_N_whole() {
    let e = E::N;
    match e { E::B(a, b) => use1(a.id + b.id), w => { let z = w; use1(0) } }
}

fn m_N_iflet() {
    let e = E::N;
    if let E::B(a, _) = e { use1(a.id); } else if let E::C { y, .. } = e { use1(y.id); }
}

fn main() -> i32 {
    m_A_all();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_A_all live {live_now}"); unsafe { LIVE = 0; }
    }
    m_A_first();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_A_first live {live_now}"); unsafe { LIVE = 0; }
    }
    m_A_second();
    if unsafe { LIVE }
    != 0 {
        let live_now = unsafe { LIVE }; println("m_A_second live {live_now}"); unsafe { LIVE = 0; }
    }
