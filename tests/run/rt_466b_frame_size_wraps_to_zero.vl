// XFAIL: RT-466b: UNSOUND: (RT-466's mechanism, the sum wraps to 0) two locals of 2^63 bytes each, the frame's size 2^64 wrapping to 0: -O2 builds it with no reserve, prints "inside" and exits 0 with slots above sp; -O0 is an internal assembler error ("immediate out of range: sub x0, x29, #-9223372036854775199"), so the levels differ; rustc refuses the type (0.30.2)
// From g302probes (its form wrap2). Since v0.30.1 at least (v0.30.1 and
// the release build the same). g302std's 6986b630d fixes it (not on
// this branch yet). rustc refuses the type: "values of the type `[u8;
// 9223372036854775808]` are too big for the target architecture".
// ERROR: line 11
// two locals of 2^63 bytes each: the frame's sum is 2^64, 0 when wrapped
#[inline(never)]
fn two(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 1usize << 63];
        let b = [1u8; 1usize << 63];
        return a[n] + b[n];
    }
    println("inside");
    0
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", two(n));
}
