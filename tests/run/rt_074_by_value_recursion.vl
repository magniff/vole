// XFAIL: RT-74: an inherent `fn drop(self)` beside Drop: the glue calls it, it drops self again: recursion to a stack overflow (0.30.2)
// EXPECT: end 2
// EXPECT: Drop 2
struct D {
    k: i64,
}

impl D {
    fn drop(self) {
        println("inherent drop {}", self.k);
    }
}

impl Drop for D {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn main() -> i32 {
    let e = D { k: 2 };
    println("end {}", e.k);
    0
}
