// XFAIL: RT-158: the expression `&&mut x` (a shared reference to a fresh `&mut x`) is a parser error: `&&` then `mut` (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_006_ref_ref_mut_expr_parse.rs.txt).
// vole: `error[parser error] expected expression, got 'mut'` at each `&&mut`
// (lines 15, 17, 19); `& &mut s` with a space builds. The type `&&mut i64`
// parses. Since v0.28.0 (v0.28.0 to v0.30.1 and the g302probe build the same).
// EXPECT: 5
// EXPECT: 6
// EXPECT: 2
fn f(x: &&mut i64) -> i64 {
    **x + 1
}

fn main() {
    let mut s = 5i64;
    let r = &&mut s;
    println("{}", **r);
    println("{}", f(&&mut s));
    let mut v = [1i64, 2];
    let q: &&mut [i64; 2] = &&mut v;
    println("{}", q[1]);
}
