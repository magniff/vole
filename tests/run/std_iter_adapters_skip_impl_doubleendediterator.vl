// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter::adapters Skip::impl DoubleEndedIterator.
// EXPECT: [4, 3] None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3, 4], gpa);
    let v: Vec<i64, Gpa> = s.iter().skip(2).rev().copied().collect_in(gpa);
    println("{:?} {:?}", v, s.iter().skip(4).next_back());
}
