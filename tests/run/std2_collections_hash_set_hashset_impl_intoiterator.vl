// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_set HashSet::impl IntoIterator; std::collections::hash_set &HashSet::impl IntoIterator.
// EXPECT: 3
// EXPECT: [1, 2]
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    s.insert(2);
    let mut sum = 0i64;
    for x in &s {
        sum += *x;
    }
    println("{}", sum);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in s {
        v.push(x);
    }
    v.sort();
    println("{:?}", v);
}
