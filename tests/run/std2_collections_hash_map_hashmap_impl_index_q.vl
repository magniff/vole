// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::impl Index<&Q>.
// EXPECT: 2
// EXIT: 101
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 2);
    println("{}", m[&1]);
    println("{}", m[&9]);
}
