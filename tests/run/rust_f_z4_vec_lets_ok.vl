// RULE: F18.2
// The rest of std's constructors that made a Vec (or a map) in a `let`
// with no type for its element, annotated: clone and clone_in,
// from_elem_in, to_vec_in, repeat_in, split_off.
// EXPECT: 4 7 3 6 2 3
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    v.push(5);
    v.push(6);
    let w = v.clone();
    let e: Vec<i64, Gpa> = Vec::from_elem_in(7, 3, gpa);
    let c = e.clone_in(gpa);
    let t = v.as_slice().to_vec_in(gpa);
    let r = v.as_slice().repeat_in(2, gpa);
    let mut s = w.clone();
    let tail = s.split_off(1);
    println("{} {} {} {} {} {}", w[0], c[2], t.len(), r.len(), tail.len(), s.len() + 2);
}
