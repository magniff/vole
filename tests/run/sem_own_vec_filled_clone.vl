// sem-own: Vec::filled_in(n, x) clones x n times (or n-1 plus x): each dropped once.
// EXPECT: n 3
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: drop 1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
impl Clone for D<Gpa> { fn clone(self) -> D<Gpa> { D { id: self.id, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let v: Vec<D<Gpa>, Gpa> = Vec::filled_in(3, mk(1, gpa), gpa);
    println("n {}", v.len());
    println("end");
}
