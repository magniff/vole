// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt DebugList::entry.
// EXPECT: [1, true]
// EXPECT: [
// EXPECT:     1,
// EXPECT:     true,
// EXPECT: ]
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_list().entry(&self.a).entry(&self.b).finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
