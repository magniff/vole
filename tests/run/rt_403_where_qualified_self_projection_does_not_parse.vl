// XFAIL: RT-403: a `where` clause whose subject is a qualified projection, `impl Tr for S where <Self as H>::Out: Conv`, does not parse ("parser error: expected '{', got '<'"); rustc accepts it and prints the EXPECT line (0.30.2; the where clause parses since M2, RT-403b: what is left is the body's `<<Self as H>::Out as Conv>::c()`, lexed as a shift, RT-93's form)
// From the review of g302oblig-m2 (form f269x, here with the bound met).
// Since v0.30.1 at least; the release build the same. Sub-form: rt_403b
// (`where <Bx<T> as H>::Item: Copy` in a generic impl). The forms of the
// review, with the bound not met, are rustc E0277; this one is a program
// rustc builds.
// EXPECT: 4
trait Conv {
    fn c() -> i64;
}

trait H {
    type Out;
}

trait Tr {
    fn f(&self) -> i64;
}

struct S {
    r: i64,
}

impl H for S {
    type Out = i32;
}

impl Conv for i32 {
    fn c() -> i64 {
        4
    }
}

impl Tr for S where <Self as H>::Out: Conv {
    fn f(&self) -> i64 {
        <<Self as H>::Out as Conv>::c()
    }
}

fn need<X: Tr>(x: &X) -> i64 {
    x.f()
}

fn main() {
    println("{}", need(&S { r: 0 }));
}
