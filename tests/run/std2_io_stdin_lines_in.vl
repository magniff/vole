use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let v: Vec<String<Gpa>, Gpa> = io::stdin().lines_in(gpa).map(|l| l.unwrap()).collect_in(gpa);
    println("{:?}", v);
}
