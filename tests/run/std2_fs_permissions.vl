// EDITION: rust
// The std2 item(s): std::fs Metadata::permissions; std::fs Permissions; std::fs Permissions::mode; std::fs Permissions::readonly; std::fs OpenOptions::mode; std::fs OpenOptions::create; std::fs OpenOptions::truncate; std::fs OpenOptions::create_new; std::fs File::as_raw_fd.
// EXPECT: true 100600 false
// EXPECT: 100600 100444 true
// EXPECT: InvalidInput InvalidFilename
// EXPECT: AlreadyExists 0
// RUSTC: none (Permissions::mode, OpenOptions::mode and as_raw_fd are Rust's unix extension traits, std::os, which std2 has not)
use std::fs;
use std::fs::OpenOptions;

fn main(gpa: Gpa) {
    let f = OpenOptions::new().write(true).create(true).mode(0x180).open("p.txt").unwrap();
    let m = fs::metadata("p.txt").unwrap();
    println("{} {:o} {}", f.as_raw_fd() > 2, m.permissions().mode(), m.permissions().readonly());
    fs::copy("p.txt", "q.txt").unwrap();
    let _ = OpenOptions::new().write(true).create(true).mode(0x124).open("r.txt").unwrap();
    let r = fs::metadata("r.txt").unwrap().permissions();
    println("{:o} {:o} {}", fs::metadata("q.txt").unwrap().permissions().mode(), r.mode(),
        r.readonly());
    let long = "x".repeat_in(5000, gpa);
    let nul = fs::metadata("a\0b").unwrap_err();
    println("{:?} {:?}", nul.kind(), fs::metadata(&long).unwrap_err().kind());
    fs::write("p.txt", "abc").unwrap();
    let e = OpenOptions::new().write(true).create_new(true).open("p.txt").unwrap_err();
    let _ = OpenOptions::new().write(true).truncate(true).open("p.txt").unwrap();
    println("{:?} {}", e.kind(), fs::metadata("p.txt").unwrap().len());
}
