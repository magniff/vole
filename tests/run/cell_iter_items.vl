// (0.26.1) own.interior_copy: a closure given a borrowing iterator's items
// gets copies, other cells; a `for` over the iterator gets the elements.
// ERROR: [own.interior_copy]: the items of 'SliceIter<Cell<i64>>' are copies, other cells: a write through one is lost
use std::cell::Cell;

fn main(gpa: Gpa) {
    var v: Vec<Cell<i64>> = Vec::new_in(gpa);
    v.push(Cell::new(1));
    for c in v.iter() {
        c.set(2);
    }
    v.iter().for_each(|c| c.set(5));
}
