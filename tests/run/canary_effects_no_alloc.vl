// 0.30.1, a canary of the effect checker: #[no_alloc] refuses a function that
// has the effect (planted in leaf) through a call chain three deep, a
// closure, a generic instance, a trait method (direct and through a
// bound), and a C function declared with #[effects(..)] that has it and
// one declared without (unknown C: every effect). canary_effects_ok is the
// same program with nothing planted, which must pass.
// ERROR: [effect]: 'chain3' is #[no_alloc]
// ERROR: [effect]: 'through_closure' is #[no_alloc]
// ERROR: [effect]: 'through_generic' is #[no_alloc]
// ERROR: [effect]: 'through_trait' is #[no_alloc]
// ERROR: [effect]: 'through_dyn_generic' is #[no_alloc]
// ERROR: [effect]: 'through_c_declared' is #[no_alloc]
// ERROR: [effect]: 'through_c_undeclared' is #[no_alloc]
// ERROR-COUNT: 7
extern "C" {
    #[effects(io, alloc(extern), panic, diverge)]
    fn c_declared(x: i64) -> i64;
    fn c_undeclared(x: i64) -> i64;
}

fn leaf(gpa: Gpa) {
    let b: Box<i64, Gpa> = Box::new_in(1, gpa); let _ = b;
}

fn mid(gpa: Gpa) {
    leaf(gpa);
}

fn top(gpa: Gpa) {
    mid(gpa);
}

#[no_alloc]
fn chain3(gpa: Gpa) {
    top(gpa);
}

#[no_alloc]
fn through_closure(gpa: Gpa) {
    let f = || leaf(gpa);
    f();
}

fn generic<T: Copy>(x: T, gpa: Gpa) -> T {
    leaf(gpa);
    x
}

#[no_alloc]
fn through_generic(gpa: Gpa) {
    let _ = generic(3i64, gpa);
}

trait Act {
    fn act(&self, gpa: Gpa);
}

struct A {}

impl Act for A {
    fn act(&self, gpa: Gpa) {
        leaf(gpa);
    }
}

#[no_alloc]
fn through_trait(gpa: Gpa) {
    let a = A {};
    a.act(gpa);
}

#[no_alloc]
fn through_dyn_generic<T: Act>(t: &T, gpa: Gpa) {
    t.act(gpa);
}

#[no_alloc]
fn through_c_declared() {
    // UNSAFE: test. SAFETY: test.
    let _ = unsafe { c_declared(1) };
}

#[no_alloc]
fn through_c_undeclared() {
    // UNSAFE: test. SAFETY: test.
    let _ = unsafe { c_undeclared(1) };
}

fn main(gpa: Gpa) {
    chain3(gpa);
    through_closure(gpa);
    through_generic(gpa);
    through_trait(gpa);
    through_dyn_generic(&A {}, gpa);
    through_c_declared();
    through_c_undeclared();
}
