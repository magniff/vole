// EDITION: rust
// sem-own: returning one of two owned locals: the other dropped in the callee.
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: got 2
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn f(c: bool, gpa: Gpa) -> D<Gpa> { let a = mk(1, gpa); let b = mk(2, gpa); if c { a } else { b } }

fn main(gpa: Gpa) {
    { let d = f(true, gpa); println("got {}", d.id); }
    { let d = f(false, gpa); println("got {}", d.id); }
}
