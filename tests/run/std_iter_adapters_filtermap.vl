// XFAIL: std is not the edition's std until 0.27.2's switch (front272 M3)
// The std item(s): std::iter::adapters FilterMap.
// EXPECT: [1, 3]
use std::iter::FilterMap;

fn main(gpa: Gpa) {
    let s = Vec::from_in(["1", "x", "3"], gpa);
    let v: Vec<i64, Gpa> = s.iter().filter_map(|t| t.parse().ok()).collect_in(gpa);
    println("{:?}", v);
}
