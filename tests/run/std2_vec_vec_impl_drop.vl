use std::vec::Vec;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main(gpa: Gpa) {
    {
        let v = Vec::from_in([D { n: 1 }, D { n: 2 }], gpa);
        println("made");
        let _ = v.len();
    }
    println("end");
}
