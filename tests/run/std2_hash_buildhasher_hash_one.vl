// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::hash BuildHasher::hash_one.
// EXPECT: true true
use std::hash::{BuildHasher, Hash, Hasher};

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

impl Default for Fnv {
    fn default() -> Fnv {
        Fnv { h: 0xcbf29ce484222325 }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

struct FnvState {}

impl BuildHasher for FnvState {
    type Hasher = Fnv;

    fn build_hasher(&self) -> Fnv {
        fnv()
    }
}

fn main() {
    let s = FnvState {};
    let mut h = s.build_hasher();
    5i64.hash(&mut h);
    let w: &str = "hi";
    let mut g = s.build_hasher();
    w.hash(&mut g);
    println("{} {}", s.hash_one(5i64) == h.finish(), s.hash_one(w) == g.finish());
}
