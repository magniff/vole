// EXPECT: 7
// (RT-269) an inherent impl's `where i32: Conv<U>`, met at the call.
trait Conv<X> {
    fn cv(&self) -> i64;
}

impl Conv<i64> for i32 {
    fn cv(&self) -> i64 {
        7
    }
}

struct G<U> {
    u: U,
}

impl<U> G<U>
    where
        i32: Conv<U>,
{
    fn f(&self) -> i64 {
        5i32.cv()
    }
}

fn main() {
    let g = G { u: 5i64 };
    println("{}", g.f());
}
