// RULE: F26.2, D22.3
// `<` on a value of a type parameter needs `T: PartialOrd` in its bounds
// (rustc E0369), even where every instance has it.
// ERROR: error[generic.unbounded_use]: binary operation '<' cannot be applied to type 'T'
fn largest<T: Copy>(a: T, b: T) -> T {
    if a < b { b } else { a }
}

fn main() {
    println("{}", largest(3, 7));
}
