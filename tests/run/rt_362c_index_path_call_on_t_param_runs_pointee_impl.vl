// From the re-review 2 of g302index (its form i08h_generic_ufcs_index_T_refW). Since v0.30.1 at least
// (v0.30.1 and the release build print `1 1 1`).
// RT-362 is the index operator on a T parameter; rt_362b..e path calls.
// EXPECT: 2 2 2
use std::ops::{Index, IndexMut};

struct W {
    k: i64,
}

static ONE: i64 = 1;
static TWO: i64 = 2;

impl Index<usize> for W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &ONE
    }
}

impl<'a> Index<usize> for &'a W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &TWO
    }
}

fn idx<T: Index<usize, Output = i64>>(x: T) -> i64 {
    *Index::index(&x, 0)
}

fn idx2<T: Index<usize, Output = i64>>(x: T) -> i64 {
    *T::index(&x, 0)
}

fn idx3<T: Index<usize, Output = i64>>(x: T) -> i64 {
    *<T as Index<usize>>::index(&x, 0)
}

fn main() {
    let w = W { k: 5 };
    println("{} {} {}", idx(&w), idx2(&w), idx3(&w));
}
