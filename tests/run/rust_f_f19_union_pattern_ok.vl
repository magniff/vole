// RULE: F19.7
// (0.30.1, RT-M2-7) The patterns that may match a union: one that reads
// a field (a binding, a literal, `ref`) inside `unsafe`, as rustc
// accepts them (E0133 outside), and `_` for a field, which reads
// nothing, in safe code (rustc accepts that too). (vole wants the `..`
// of a union's pattern that rustc refuses: E0784, a union's pattern
// names one field.)
// EXPECT: 3
// EXPECT: three
// EXPECT: 3
// EXPECT: wild
// EXPECT: 1
// EXPECT: 3
union U {
    a: usize,
    b: u32,
}

fn make() -> U {
    U { a: 3 }
}

fn main() {
    // UNSAFE: a union's field, read by a pattern
    // SAFETY: `a` is the field make writes, a usize
    let n = unsafe {
        let U { a, .. } = make();
        a
    };
    println("{}", n);
    // UNSAFE: a union's field, matched by a literal
    // SAFETY: `a` is the field make writes
    unsafe {
        match make() {
            U { a: 3, .. } => println("three"),
            U { a: _, .. } => println("other"),
        }
    }
    let u = make();
    // UNSAFE: a union's field, borrowed by a `ref` pattern
    // SAFETY: `a` is the field make writes, and u outlives the borrow
    let m = unsafe {
        let U { ref a, .. } = u;
        *a
    };
    println("{}", m);
    let U { a: _, .. } = make();
    match make() {
        U { b: _, .. } => println("wild"),
    }
    let f = |U { a: _, .. }: U| -> i64 { 1 };
    println("{}", f(make()));
    let g = |w: U| -> usize {
        // UNSAFE: a union's field read by a pattern in a closure
        // SAFETY: `a` is the field make writes
        unsafe {
            let U { a, .. } = w;
            a
        }
    };
    println("{}", g(make()));
}
