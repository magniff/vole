// XFAIL: gap 17: compile unsafe: indexing a pointer is unsafe pointer arithmetic; the value 'p' points to is `*p`
// copy of an Option<inout V> value
// EXPECT: 1 9
use std::collections::HashMap; fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa); m.insert(1, 1); let mut c: i64 = 0;
    if let Some(p) = m.get_mut(&1) { c = p[0]; c = 9; } println("{} {c}",
        m.get(&1).copied().unwrap());
}
