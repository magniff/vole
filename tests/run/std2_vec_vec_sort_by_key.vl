// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::sort_by_key.
// EXPECT: [-1, 2, -3, 4]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([4, -3, 2, -1], gpa);
    v.sort_by_key(|x| if *x < 0 { -*x } else { *x });
    println("{:?}", v);
}
