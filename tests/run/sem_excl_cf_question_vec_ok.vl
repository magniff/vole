// EDITION: rust
// ? argument evaluated before the inout use; the read ends before the call (two-phase receiver only)
// EXPECT: 2
fn parse(v: &Vec<i64, Gpa>) -> Result<i64, i64> {
    if v.len() > 0 { Ok(v.len() as i64) } else { Err(0i64) }
}

fn go(v: &mut Vec<i64, Gpa>) -> Result<i64, i64> { { let at_arg1 = parse(v)?; v.push(at_arg1) }; Ok(v.len() as i64) }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    match go(&mut v) { Ok(n) => println("{n}"), Err(e) => println("e{e}") }
}
