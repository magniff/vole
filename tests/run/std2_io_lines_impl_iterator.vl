// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Lines::impl Iterator.
// EXPECT: Some("x") Some("y") true
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut lines = BufReader::new("x\ny\n".as_bytes()).lines_in(gpa);
    let a = lines.next().unwrap().unwrap();
    let b = lines.next().unwrap().unwrap();
    println("{:?} {:?} {}", Some(a), Some(b), lines.next().is_none());
}
