// FLAGS: -O2
// EXPECT: 2050
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

fn reread(p: *const [i64], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array
    unsafe {
        let a = (*p)[1];
        poke(q, 50);
        let b = (*p)[1];
        a * 1000 + b
    }
}

#[inline(never)]
fn outer(p: *const [i64], q: *mut i64) -> i64 {
    reread(p, q)
}

fn main() -> i32 {
    let mut a = [1i64, 2, 3, 4];
    let base = a.as_mut_ptr();
    // UNSAFE: both from base
    // SAFETY: a outlives them
    let (p, q) = unsafe {
        (std::slice::from_raw_parts_mut(base, 4) as *mut [i64] as *const [i64], base.add(1))
    };
    println("{}", outer(p, q));
    0
}
