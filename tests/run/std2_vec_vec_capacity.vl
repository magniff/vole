// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::capacity.
// EXPECT: true true
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::with_capacity_in(4, gpa);
    let c = v.capacity();
    v.push(1);
    println("{} {}", c >= 4, v.capacity() == c);
}
