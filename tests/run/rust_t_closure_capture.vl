// (0.27.0) Hand-translated from tests/run/closure_capture.vl to Rust's spelling.
// 0.14: capture modes. A `let mut` is captured by reference (changes
// are seen both ways), an immutable binding by value (by reference when
// the closure takes its address, as a method's `self: *T` does), and
// everything by value with `move`.
// EXPECT: 111 111
// EXPECT: 5 6
// EXPECT: 2
// EXPECT: 3
// EXPECT: 1 2 0
fn twice<F: FnMut()>(mut f: F) {
    f();
    f();
}

fn main(gpa: Gpa) -> i64 {
    let mut c = 1;
    c += 100;
    // (0.17: c cannot be written while bump, which borrows it, is used)
    let mut bump = || {
        c += 10;
        c
    };
    let r = bump();
    print("{}", r);
    print(" ");
    println("{}", c);
    // a snapshot
    let mut n = 5;
    let snap = move || n;
    n = 6;
    print("{}", snap());
    print(" ");
    println("{}", n);
    // a handle changed through `self: *Vec`: the variable's
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    twice(|| v.push(1));
    println("{}", v.len() as i64);
    // through two levels
    let mut hits = 0;
    let mut outer = || {
        let mut inner = || hits += 1;
        inner();
        inner();
        inner();
    };
    outer();
    println("{}", hits);
    // a `move` closure changes its own copy
    let mut m = 0;
    let mut count = move || {
        m += 1;
        m
    };
    print("{}", count());
    print(" ");
    print("{}", count());
    print(" ");
    println("{}", m);
    0
}
