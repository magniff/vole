// Block expressions with their own scopes; shadowing ends at the block.
// EXPECT: 1001 111 4
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

fn main() -> i64 {
    let x: i64 = 1;
    let y = {
        let x: i64 = 10;
        let z = { let x: i64 = 100; x + 1 };
        x + z
    };
    let x = x + 1000;
    let mut i: i64 = 0;
    loop {
        let x = i * 2;
        i += 1;
        if x >= 6 { break; }
    }
    unsafe { printf(c"%ld %ld %ld\n", x, y, i); }
    0
}
