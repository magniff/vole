// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 1 (a is a copy: the result holds no view)
// EXPECT: 1
// EXPECT: 9
fn f(a: [i64; 4], b: &mut [i64; 4]) -> i64 { b[0] = 9; a[0] }

fn main() -> i32 {
    let mut arr = [1i64, 2, 3, 4];
    println("{}", f(arr, &mut arr));
    println("{}", arr[0]);
    0
}
