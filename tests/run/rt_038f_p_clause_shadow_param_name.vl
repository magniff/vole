// RULE: C3.4
// (0.30.2, review of RT-38f) A `let s` in an ensures shadowing the parameter `s`: the view of a
// by-value parameter the body took was made from the name, and read it
// after the body (borrowck.use_moved). A view is made only when a name of
// the clause resolves to it (byref.vl VIEW_USED).
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
struct N {
    v: i64,
}

fn f(s: N) -> i64
    ensures {
    let s = 3i64;
    s > 0
}

{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
