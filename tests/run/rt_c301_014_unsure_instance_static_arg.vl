// XFAIL: RT-C301-14: the instances of a template whose generic check is unsure are borrow-checked whole, and an instance does not know which lifetimes of its type arguments the caller wrote 'static: a false error for `&'static str` (0.30.2)
// rustc accepts and prints each line.
// EXPECT: thread lit
// EXPECT: thread 5
// EXPECT: thread x
use std::thread;
use std::fmt::Display;
use std::thread::JoinHandle;
trait Tr<A> { fn f<B>(&self, a: A, b: B); }
struct S;
impl Tr<i64> for S { fn f<B>(&self, a: i64, b: B) {} }

fn run<X: Tr<i64>, U: Send + Display>(x: &X, u: U, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    x.f(1i64, 0i64);
    thread::spawn_in(move || { println("thread {}", u); 0i64 }, gpa)
}

fn go<T, U: Send + Display>(t: T, u: U, gpa: Gpa) -> JoinHandle<i64, Gpa> where Option<T>: Clone {
    thread::spawn_in(move || { println("thread {}", u); 0i64 }, gpa)
}

fn main(gpa: Gpa) {
    run(&S, "lit", gpa).join(); go(1i64, 5i64, gpa).join(); go(1i64, "x", gpa).join();
}
