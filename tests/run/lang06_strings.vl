// EDITION: rust
// XFAIL: gap 17: compile format.args: a format string is a literal: this argument has no hole to go to
// 0.6: a string literal is a [u8] slice of its bytes (no terminator); the
// std functions taking [u8] accept it directly.
// EXPECT: hello, world
// EXPECT: 12 104 100
// EXPECT: llo
// EXPECT: 5 vowels
// EXPECT: abc-42
// EXPECT: 5 0

fn vowels(s: &[u8]) -> i64 {
    let mut n: i64 = 0;
    for &c in s {
        if c == b'a' || c == b'e' || c == b'i' || c == b'o' || c == b'u' { n += 1; }
    }
    n
}

fn show(a: i64, b: i64) {
    print("{}", a);
    std::fmt::print(" ");
    print("{}", b);
}

fn main(gpa: Gpa) -> i32 {
    std::fmt::println("hello, world");
    let s = "hello, world";
    print("{}", (s.len() as i64));
    std::fmt::print(" ");
    show(s[0] as i64, s[11] as i64);
    std::fmt::println("");
    std::fmt::println("{}", &"{}", s[2..5]);
    print("{}", vowels(b"education"));
    std::fmt::println(" vowels");
    let mut b = String::new_in(gpa);
    b.push_str("abc");
    b.push_str("-");
    std::fmt::write(&mut b, 42i64).unwrap();
    std::fmt::println("{}", str::from_utf8(b.as_bytes()).unwrap());
    drop(b);
    let empty = "";
    show("\t\n\\\"x".len() as i64, empty.len() as i64);
    std::fmt::println("");
    0
}
