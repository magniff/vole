// EDITION: rust
// sem-own: `loop { break v }` moves an owned value out of the loop.
// EXPECT: drop 0
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: got 3
// EXPECT: drop 3
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut i: i64 = 0;
    let d = loop {
        let x = mk(i, gpa);
        if i == 3 { break x; }
        i += 1;
        if i == 2 { let y = mk(2, gpa); }
    };
    println("got {}", d.id);
}
