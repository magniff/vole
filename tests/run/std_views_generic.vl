// XFAIL: gap 2: compile type error: no 'btree_map' in module 'std::collections'
// (0.25) std's generic collections and APIs instantiated with view types
// (`str`, `[i64]`) as elements, keys and values: each compiles with std's
// own pins and summaries, and runs clean under the leak checker.
// FLAGS: --check-alloc
// EXPECT: vec 3 a c true
// EXPECT: hash 4 true one
// EXPECT: set 2 true
// EXPECT: btree 1 a b 3 3
// EXPECT: range 1 a 2 b
// EXPECT: bset a c 2 a
// EXPECT: heap c 2
// EXPECT: opt a az x
// EXPECT: iter 3 b 2 a,b,c
// EXPECT: slices 3 8
use std::collections::HashMap; use std::collections::btree_map::BTreeMap;
use std::collections::HashSet;
use std::collections::btree_map::BTreeSet;

fn main(gpa: Gpa) {
    let words: &str = "a b c";
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    for w in words.split(' ') { v.push(w); }
    println("vec {} {} {} {}", v.len(), str::from_utf8(v[0usize]).unwrap(),
        v.last().copied().unwrap(), v.as_slice().contains(&"c"));

    let mut m: HashMap<&str, &str, Gpa> = HashMap::new_in(gpa);
    m.insert("1", "one");
    m.insert("2", "two");
    let mut n: i64 = 0;
    for (k, x) in m.iter().map(|(k, v)| (*k, *v)) { n += k.len() as i64 + x.len() as i64 - 3; }
    println("hash {} {} {}", m.len() as i64 + n, m.contains_key(&"2"),
        m.get(&"1").copied().unwrap());
    for k in m.keys().copied() { n += k.len() as i64; }
    for x in m.values().copied() { n += x.len() as i64; }

    let mut hs: HashSet<&str, Gpa> = HashSet::new_in(gpa);
    hs.insert("x");
    hs.insert("y");
    let mut c: i64 = 0;
    for x in hs.iter().copied() { c += x.len() as i64; }
    println("set {c} {}", hs.contains(&"y"));

    let mut bm: BTreeMap<i64, &str, Gpa> = BTreeMap::new_in(gpa);
    bm.insert(2, "b");
    bm.insert(1, "a");
    bm.insert(3, "c");
    let (k0, v0) = bm.first_key_value().unwrap();
    let (k1, _) = bm.last_key_value().unwrap();
    println("btree {k0} {v0} {} {k1} {}", bm.get(2).unwrap(), bm.len());
    let mut r = String::new_in(gpa);
    for (k, x) in bm.range(0, 3) { std::fmt::write(&mut r, " {k} {x}").unwrap(); }
    println("range{}", str::from_utf8(r.as_bytes()).unwrap());
    for (k, x) in bm.iter() { n += k + x.len() as i64; }

    let mut bs: BTreeSet<&str, Gpa> = BTreeSet::new_in(gpa);
    bs.insert("c");
    bs.insert("a");
    bs.insert("b");
    let lo = bs.first().unwrap();
    bs.remove("b");
    let mut cnt: i64 = 0;
    for x in bs.iter() { cnt += x.len() as i64; }
    for x in bs.range("a", "b") { cnt += x.len() as i64; }
    println("bset {lo} {} {} {}", bs.last().unwrap(), cnt - 1, bs.pop_first().unwrap());

    let mut h: BinaryHeap<&str, Gpa> = BinaryHeap::new_in(gpa);
    h.push("a");
    h.push("c");
    println("heap {} {}", h.peek().unwrap(), h.len());

    let o: Option<&str> = Some("a");
    let e: Result<&str, &str> = Err("err");
    println("opt {} {}z {}", o.unwrap_or("q"), o.map(|s| s.trim()).unwrap(), e.unwrap_or("x"));

    let mut it: Vec<&str, Gpa> = v
        .iter()
        .copied()
        .filter(|x| ({ let s = *x; s.len() == 1 }))
        .collect_in(gpa);
    let joined = String::new_in(gpa);
    let mut j = joined;
    for (i, s) in it.iter().copied().enumerate() {
        if i > 0 { j.push_str(","); }
        j.push_str(s);
    }
    let mx = v.iter().copied().map(|s| s).fold("", |acc, s| if s == "b" { s } else { acc });
    println("iter {} {mx} {} {}", it.len(),
        v.iter().copied().filter(|x| ({ let s = *x; s != "a" })).count(),
        str::from_utf8(j.as_bytes()).unwrap());

    let a = [1i64, 2, 3];
    let b = [4i64, 5];
    let mut vs: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    vs.push(&a[..]);
    vs.push(&b[..]);
    let mut hv: HashMap<i64, &[i64], Gpa> = HashMap::new_in(gpa);
    hv.insert(1, &a[..]);
    let mut bv: BTreeMap<i64, &[i64], Gpa> = BTreeMap::new_in(gpa);
    bv.insert(1, &b[..]);
    println("slices {} {}", vs[0usize].len(),
        hv.get(&1).copied().unwrap()[2] + bv.get(1).unwrap()[1] + n * 0);

    drop(it); drop(vs); drop(hv); bv.free(); bs.free(); bm.free(); drop(hs); drop(m);
    drop(v); j.clear(); r.clear();
}
