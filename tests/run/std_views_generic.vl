// (0.25) std's generic collections and APIs instantiated with view types
// (`str`, `[i64]`) as elements, keys and values: each compiles with std's
// own pins and summaries, and runs clean under the leak checker.
// FLAGS: --check-alloc
// EXPECT: vec 3 a c true
// EXPECT: hash 4 true one
// EXPECT: set 2 true
// EXPECT: btree 1 a b 3 3
// EXPECT: range 1 a 2 b
// EXPECT: bset a c 2 a
// EXPECT: heap c 2
// EXPECT: opt a az x
// EXPECT: iter 3 b 2 a,b,c
// EXPECT: slices 3 8
use std::collections::btree_map::{BTreeMap, BTreeSet};
use std::collections::hash_set::HashSet;

fn main(gpa: Gpa) {
    let words: str = "a b c";
    var v: Vec<str> = Vec::new_in(gpa);
    for w in words.split(' ') { v.push(w); }
    println("vec {} {} {} {}", v.len(), v.get(0), v.last().unwrap(), v.as_slice().contains("c"));

    var m: HashMap<str, str> = HashMap::new_in(gpa);
    m.insert("1", "one");
    m.insert("2", "two");
    var n = 0;
    for (k, x) in m.iter() { n += k.len() as i64 + x.len() as i64 - 3; }
    println("hash {} {} {}", m.len() as i64 + n, m.contains_key("2"), m.get("1").unwrap());
    for k in m.keys() { n += k.len() as i64; }
    for x in m.values() { n += x.len() as i64; }

    var hs: HashSet<str> = HashSet::new_in(gpa);
    hs.insert("x");
    hs.insert("y");
    var c = 0;
    for x in hs.iter() { c += x.len() as i64; }
    println("set {c} {}", hs.contains("y"));

    var bm: BTreeMap<i64, str> = BTreeMap::new_in(gpa);
    bm.insert(2, "b");
    bm.insert(1, "a");
    bm.insert(3, "c");
    let (k0, v0) = bm.first_key_value().unwrap();
    let (k1, _) = bm.last_key_value().unwrap();
    println("btree {k0} {v0} {} {k1} {}", bm.get(2).unwrap(), bm.len());
    var r = Buf::new_in(gpa);
    for (k, x) in bm.range(0, 3) { r.push_fmt(" {k} {x}"); }
    println("range{}", r.as_slice());
    for (k, x) in bm.iter() { n += k + x.len() as i64; }

    var bs: BTreeSet<str> = BTreeSet::new_in(gpa);
    bs.insert("c");
    bs.insert("a");
    bs.insert("b");
    let lo = bs.first().unwrap();
    bs.remove("b");
    var cnt = 0;
    for x in bs.iter() { cnt += x.len() as i64; }
    for x in bs.range("a", "b") { cnt += x.len() as i64; }
    println("bset {lo} {} {} {}", bs.last().unwrap(), cnt - 1, bs.pop_first().unwrap());

    var h: BinaryHeap<str> = BinaryHeap::new_in(gpa);
    h.push("a");
    h.push("c");
    println("heap {} {}", h.peek().unwrap(), h.len());

    let o: Option<str> = Some("a");
    let e: Result<str, str> = Err("err");
    println("opt {} {}z {}", o.unwrap_or("q"), o.map(|s| s.trim()).unwrap(), e.unwrap_or("x"));

    var it: Vec<str> = v.iter().filter(|s| s.len() == 1).collect_in(gpa);
    let joined = Buf::new_in(gpa);
    var j = joined;
    for (i, s) in it.iter().enumerate() {
        if i > 0 { j.push_str(","); }
        j.push_str(s);
    }
    let mx = v.iter().map(|s| s).fold("", |acc, s| if s == "b" { s } else { acc });
    println("iter {} {mx} {} {}", it.len(), v.iter().filter(|s| s != "a").count(), j.as_slice());

    let a = [1, 2, 3];
    let b = [4, 5];
    var vs: Vec<[i64]> = Vec::new_in(gpa);
    vs.push(a[..]);
    vs.push(b[..]);
    var hv: HashMap<i64, [i64]> = HashMap::new_in(gpa);
    hv.insert(1, a[..]);
    var bv: BTreeMap<i64, [i64]> = BTreeMap::new_in(gpa);
    bv.insert(1, b[..]);
    println("slices {} {}", vs.get(0).len(), hv.get(1).unwrap()[2] + bv.get(1).unwrap()[1] + n * 0);

    it.free(); vs.free(); hv.free(); bv.free(); bs.free(); bm.free(); hs.free(); m.free();
    v.free(); j.free(); r.free();
}
