// EDITION: rust
// A small state machine that tokenizes an arithmetic expression from stdin
// and evaluates it with a two-stack (shunting-yard) algorithm.
// STDIN: 12 + 3 * (40 - 2) / 6 - 7 * (1 + 1)
// EXPECT: 19 tokens = 17
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn read(fd: i32, buf: *mut u8, n: u64) -> i64;
}

#[derive(Clone, Copy)] struct Stacks { nums: [i64; 64], nn: i64, ops: [u8; 64], no: i64 }

fn prec(op: u8) -> i64 {
    if op == b'+' || op == b'-' { 1 } else if op == b'*' || op == b'/' { 2 } else { 0 }
}

fn apply(s: &mut Stacks) {
    let b = s.nums[(s.nn - 1) as usize];
    let a = s.nums[(s.nn - 2) as usize];
    let op = s.ops[(s.no - 1) as usize];
    s.no -= 1;
    s.nn -= 1;
    let r = if op == b'+' { a + b } else if op == b'-' { a - b } else if op == b'*' { a * b }
        else { a / b };
    s.nums[(s.nn - 1) as usize] = r;
}

fn main() -> i64 {
    let buf: [u8; 256] = [0; 256];
    let n = unsafe { read(0, buf.as_ptr() as *mut u8, 255) };
    let mut s = Stacks { nums: [0i64; 64], nn: 0, ops: [0; 64], no: 0 };
    let mut tokens: i64 = 0;
    let mut i: i64 = 0;
    let mut in_num = false;
    let mut cur: i64 = 0;
    loop {
        let c: u8 = if i < n { buf[i as usize] } else { b' ' };
        let digit = c >= b'0' && c <= b'9';
        if digit {
            cur = cur * 10 + (c - b'0') as i64;
            in_num = true;
        } else {
            if in_num {
                s.nums[s.nn as usize] = cur;
                s.nn += 1;
                tokens += 1;
                cur = 0;
                in_num = false;
            }
            if c == b'(' {
                s.ops[s.no as usize] = c;
                s.no += 1;
                tokens += 1;
            } else if c == b')' {
                while s.ops[(s.no - 1) as usize] != b'(' {
                    apply(&mut s);
                }
                s.no -= 1;
                tokens += 1;
            } else if prec(c) > 0 {
                while s.no != 0 {
                    if prec(s.ops[(s.no - 1) as usize]) < prec(c) { break; }
                    apply(&mut s);
                }
                s.ops[s.no as usize] = c;
                s.no += 1;
                tokens += 1;
            }
        }
        i += 1;
        if i > n { break; }
    }
    while s.no != 0 {
        apply(&mut s);
    }
    unsafe { printf(c"%ld tokens = %ld\n", tokens, s.nums[0]); }
    0
}
