// RULE: C3.4
// (0.30.2, the re-review 2 of g302holes: holes/fat10_mutstr_in_clause)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' writes through a raw pointer what it did not make
// &mut *sp of a *mut str param in the clause, a std method writes
fn f(sp: *mut str) -> i64
    requires { let s = unsafe { &mut *sp }; s.make_ascii_uppercase(); true }

{ 1 }

fn main(gpa: Gpa) {
    let mut st = "ab".to_string_in(gpa); let sp = st.as_mut_str() as *mut str; println("{}", f(sp));
    println("{}", st);
}
