// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::unwrap_or_default.
// EXPECT: 7 0 false
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(7);
    let b: Option<i64> = None;
    let c: Option<bool> = None;
    println("{} {} {}", a.unwrap_or_default(), b.unwrap_or_default(), c.unwrap_or_default());
}
