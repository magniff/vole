// sem-own: max over owned items needs Ord; min/max by count instead: any() drops the items it looked at.
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: any true
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let a = (0..3).map(|i| mk(i, gpa)).any(|d| d.id == 1);
    println("any {a}");
}
