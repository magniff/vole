// XFAIL: RT-72: a generic instance resolves a bound's method by name: `a.eq(b)` with T: PartialEq takes K's inherent eq (wrong code) (0.30.2)
// EXPECT: false
struct K {
    v: i64,
}

impl K {
    fn eq(&self, o: &K) -> bool {
        true
    }
}

impl PartialEq for K {
    fn eq(&self, o: &K) -> bool {
        self.v == o.v
    }
}

fn same<T: PartialEq>(a: &T, b: &T) -> bool {
    a.eq(b)
}

fn main() {
    println("{}", same(&K { v: 1 }, &K { v: 2 }));
}
