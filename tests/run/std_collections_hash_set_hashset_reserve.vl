// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_set HashSet::reserve.
// EXPECT: true
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.reserve(30);
    println("{}", s.capacity() >= 30);
}
