// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ptr NonNull::cast.
// EXPECT: 1 0
use std::ptr::NonNull;

fn main() {
    let mut x = 1u32;
    let p = NonNull::new(&mut x as *mut u32).unwrap();
    let q: NonNull<u8> = p.cast::<u8>();
    let b0 = unsafe { *q.as_ptr() };
    let b1 = unsafe { *q.add(1).as_ptr() };
    println("{} {}", b0, b1);
}
