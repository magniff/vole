use std::sync::atomic::{Atomic, Ordering};

struct P { x: i64, y: i64 }

fn main() -> i32 {
    let a = Atomic::new(P { x: 1, y: 2 });
    println(a.load(Ordering::SeqCst).x);
    0
}
