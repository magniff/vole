// (0.25.5) A #[thread_local] in a program with no `use std::thread`
// builds: std's thread-local accessor (std::thread::__tls_addr) declares
// its own malloc and free (0.25.4: "undefined variable 'thread_c_malloc'
// | note: in instantiation of 'std::thread::tls_first'", the Threads
// section, which declared them, unread).
// EXPECT: 5 12

#[thread_local]
static var T: i64 = 0;

fn bump(n: i64) -> i64 {
    T += n;
    T
}

fn main() {
    let a = bump(5);
    let b = bump(7);
    println("{a} {b}");
}
