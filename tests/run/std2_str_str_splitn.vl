// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::splitn.
// EXPECT: ["Mary", "had", "a little lambda"] ["abc"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "Mary had a little lambda".splitn(3, ' ').collect_in(gpa);
    let w: Vec<&str, Gpa> = "abc".splitn(1, 'b').collect_in(gpa);
    println("{:?} {:?}", v, w);
}
