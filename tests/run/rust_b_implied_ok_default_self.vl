// RULE: D4.6
// (0.27.2.1) `Self` in a trait's default method is a type parameter: an
// instance for a reference type (`&str`) returns either argument as Self.
// EXPECT: xy
trait Pick: Sized {
    fn first(&self) -> bool;

    fn pick(self, other: Self) -> Self {
        if self.first() { self } else { other }
    }
}

impl Pick for &str {
    fn first(&self) -> bool {
        self.len() > 1
    }
}

fn main() {
    println("{}", "xy".pick("z"));
}
