// An expected type flows into arithmetic (0.15), as it does for
// literals: `let t: i64 = n * m` with n and m of type i32 multiplies in
// i64 (each operand widened first), so it does not overflow before the
// widening; without the expected type the product is an i32.
// EXPECT: 10000000000 1410065408
// (0.26.4) The overflow checks off: it tests widened operands against narrow ones that wrap.
// FLAGS: --overflow-checks=off

fn main() {
    let n: i32 = 100000;
    let m: i32 = 100000;
    let t: i64 = n * m;
    print("{}", t);
    print(" ");
    let p = n * m;
    print("{}", (p as i64));
    println("");
}
