// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice ChunksMut::impl Iterator.
// EXPECT: [0, 0, 0] None

fn main() {
    let mut a = [1, 2, 3];
    let mut c = a.chunks_mut(3);
    c.next().unwrap().fill(0);
    let rest = c.next().is_none();
    println("{:?} {}", a, if rest { "None" } else { "Some" });
}
