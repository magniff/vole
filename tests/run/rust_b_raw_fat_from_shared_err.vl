// RUSTC: none a type error (E0308): the twin compares the borrow checker's verdicts
// RULE: D3.6a
// (0.27.7) A shared view where `*mut [T]` is written is rustc's E0308,
// the types differing in mutability, as a `&T` where `*mut T` is: a
// `&[T]`, a shared slicing, a shared reference to an array. rustc gives
// E0308 at the same lines; at `&m[..]` it points to the `&`, column 24,
// where the slicing's node starts at `m`.
// ERROR: error[type error]: expected '*[u8]'
// ERROR: line 16, column 24
// ERROR: line 17, column 25
// ERROR: line 18, column 24
// ERROR-COUNT: 3
fn main() {
    let m = [1u8, 2, 3, 4];
    let s: &[u8] = &m;
    let a: *mut [u8] = s;
    let b: *mut [u8] = &m[..];
    let c: *mut [u8] = &m;
    println("{} {} {}", a.len(), b.len(), c.len());
}
