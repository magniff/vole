// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FoldSeeds::fixed.
// EXPECT: 387676522642835182
// RUSTC: none (FoldSeeds is foldhash's SharedSeed (the foldhash crate's, 0.2, gives this value); Rust's std has no foldhash)
use std::hash::{FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let mut h = FoldHasher::with_seeds(1, FoldSeeds::fixed());
    h.write_u64(9);
    println("{}", h.finish());
}
