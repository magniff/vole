// FLAGS: -O2
// The `*const str` form of rt_046_raw_slice_param_frozen: -O0 prints
// 98122 (b, then z), -O1 and -O2 print 98098.
// EXPECT: 98122
#[inline(never)]
fn poke(q: *mut u8, v: u8) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's buffer, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn reread(p: *const str, q: *mut u8) -> usize {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's buffer, which lives across the call
    unsafe {
        let a = (*p).as_bytes()[1] as usize;
        poke(q, b'z');
        let b = (*p).as_bytes()[1] as usize;
        a * 1000 + b
    }
}

fn main() -> i32 {
    let mut buf = [b'a', b'b', b'c'];
    let base = buf.as_mut_ptr();
    // UNSAFE: a str over the buffer and a pointer to its second byte, both from base
    // SAFETY: the buffer is ASCII and outlives both; no reference to it is used meanwhile
    let (p, q) = unsafe {
        (std::str::from_utf8_unchecked(std::slice::from_raw_parts(base, 3)) as *const str,
            base.add(1))
    };
    println("{}", reread(p, q));
    0
}
