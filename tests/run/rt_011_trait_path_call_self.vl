// With impls of Tr for S and for &S, `Tr::f(&r)` (r: &S) has Self = &S in
// Rust: f's parameter is &Self, the argument &&S. vole calls S's f, as if
// the argument were dereferenced first; `Tr::f(&&s)` the same, and
// `Tr::g(&S)` (g takes self) calls S's g, moving the S out of the
// reference: with a non-Copy D, `Tr::g(&d)` is refused with
// "borrowck.use_moved: 'd.n' is used here after it moved" at a later use
// of d, and `Tr::g(&v[0])` with "cannot move out of 'v[0]'", where rustc
// calls <&D as Tr>::g. A method call (`(&r).f()`) and a generic call pick
// the right impl for a struct; for a primitive P with impls for P and &P,
// 0.30.0 took &P's for `x.m()` of `x: &P` (fixed with this case's:
// rust_f_f84_qualified_path).
// EXPECT: 1 S::f
// EXPECT: 2 &S::f
// EXPECT: 3 &S::f
// EXPECT: 4 &S::g
// EXPECT: 5 &S::g
// EXPECT: 6 &S::f
trait Tr {
    fn f(&self) -> &'static str;
    fn g(self) -> &'static str;
}

#[derive(Clone, Copy)]
struct S;

impl Tr for S {
    fn f(&self) -> &'static str {
        "S::f"
    }

    fn g(self) -> &'static str {
        "S::g"
    }
}

impl<'a> Tr for &'a S {
    fn f(&self) -> &'static str {
        "&S::f"
    }

    fn g(self) -> &'static str {
        "&S::g"
    }
}

fn main() {
    let s = S;
    let r = &s;
    println("1 {}", Tr::f(&s));
    println("2 {}", Tr::f(&r));
    println("3 {}", Tr::f(&&s));
    println("4 {}", Tr::g(&s));
    println("5 {}", Tr::g(r));
    println("6 {}", (&r).f());
}
