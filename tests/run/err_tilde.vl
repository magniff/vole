// RULE: F26.1
// (0.29) `~x` is not an operator: an integer's complement is `!x`, as a
// bool's not. Each `~` is an error at its character, with the fix that
// writes `!` (`volec fix --suggested`); the expression is read as `!x`,
// so its operand is checked too (the last error). A `~` in a character,
// a byte or a string literal, or in a comment (~), is text.
// RUSTC: none a parse error (rustc: `~` cannot be used as a unary operator): the twin compares the borrow checker
// ERROR: error[syntax.tilde]: `~` is not an operator; an integer's complement is `!x`
// ERROR: line 22, column 18
// ERROR: help: write `!x`: bitwise not on an integer, logical not on a bool (as in Rust)
// ERROR: error[syntax.tilde]: `~` is not an operator; an integer's complement is `!x`
// ERROR: line 23, column 13
// ERROR: error[syntax.tilde]: `~` is not an operator; an integer's complement is `!x`
// ERROR: line 23, column 18
// ERROR: error[syntax.tilde]: `~` is not an operator; an integer's complement is `!x`
// ERROR: line 23, column 19
// ERROR: line 29, column 13
// ERROR: line 30, column 13
// ERROR: cannot apply unary operator '!'
// ERROR-COUNT: 7
fn clear(flags: u64, bit: u64) -> u64 {
    let m: u64 = ~(1u64 << bit);
    flags & ~m | ~~flags
}

fn main() {
    let c = b'~';
    let s = "~x";
    let a = ~5u8;
    let f = ~1.5;
    println("{} {} {} {} {}", clear(7, 1), c, s, a, f);
}
