// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). A cast
// gives the integer no type (`x as u8`): x is i32, whose Out, i64, is not
// the u16 the use gave: rustc E0271.
// ERROR: (rustc E0271)
// ERROR: line 37, column 13
// ERROR-COUNT: 1
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = u16;

    fn o(self) -> u16 {
        self as u16 * 300
    }
}

impl Tr for i32 {
    type Out = i64;

    fn o(self) -> i64 {
        self as i64 * 3000000000
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let x = 2;
    let r = f(x);
    let s: u16 = r;
    let y = x as u8;
    println("{} {}", s, y);
}
