// (0.25) Owned temporaries given to an operator whose impl takes them let
// (`mk(1) + mk(2)`, `==`, `<`, unary `-`) are dropped at the end of the
// statement, once (they were never dropped); its result is the binding's.
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: c 3
// EXPECT: drop 5
// EXPECT: drop 4
// EXPECT: eq false
// EXPECT: drop 7
// EXPECT: drop 6
// EXPECT: lt true
// EXPECT: drop 8
// EXPECT: neg -8
// EXPECT: drop -8
// EXPECT: drop 3
use std::alloc::Allocator; use std::ops::Add; use std::ops::Neg;
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

impl Add for D<Gpa> { type Output = D<Gpa>;
    fn add(self, other: D<Gpa>) -> D<Gpa> { D { id: self.id + other.id, v: self.v.clone() } }
}

impl PartialEq for D<Gpa> { fn eq(&self, other: &D<Gpa>) -> bool { self.id == other.id } } impl Eq for D<Gpa> {}

impl Ord for D<Gpa> {
    fn cmp(&self, other: &D<Gpa>) -> std::cmp::Ordering { ({ self.id - other.id }).cmp(&0) }
} impl PartialOrd for D<Gpa> { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } }

impl Neg for D<Gpa> {
    type Output = D<Gpa>; fn neg(self) -> D<Gpa> { D { id: 0 - self.id, v: self.v.clone() } }
}

fn main(gpa: Gpa) {
    let c = mk(1, gpa) + mk(2, gpa);
    println("c {}", c.id);
    let e = mk(4, gpa) == mk(5, gpa);
    println("eq {e}");
    let l = mk(6, gpa) < mk(7, gpa);
    println("lt {l}");
    let m = -mk(8, gpa);
    println("neg {}", m.id);
}
