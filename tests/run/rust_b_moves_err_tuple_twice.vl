// EDITION: rust
// RULE: D8.5
// (0.27.2.1) A tuple of the same non-Copy place twice: the second operand
// reads t after the first moved it (rustc E0382).
// ERROR: error[borrowck.use_moved]
// ERROR-COUNT: 1
struct D {
    n: i64,
}

fn main() {
    let t = D { n: 1 };
    let p = (t, t);
    println("{}", p.0.n);
}
