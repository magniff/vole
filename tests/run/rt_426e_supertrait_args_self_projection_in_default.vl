// XFAIL: RT-426e: WRONG CODE: (RT-426's family, a default method) `size_of::<Self::Out>()` in a default method of `trait Sub: Tr<u16>` takes Tr<u8>'s Out (i64) for W: vole prints 8, rustc 1 (0.30.2)
// From the re-review of g302oblig M2 (its form c06_trait_text_super_args). Since v0.30.1 at
// least (v0.30.1 and the release build print 8).
// EXPECT: 1
trait Tr<A> {
    type Out;
}

struct W;

impl Tr<u8> for W {
    type Out = i64;
}

impl Tr<u16> for W {
    type Out = u8;
}

trait Sub: Tr<u16> {
    fn sz(&self) -> usize {
        std::mem::size_of::<Self::Out>()
    }
}

impl Sub for W {}

fn main() {
    println("{}", W.sz());
}
