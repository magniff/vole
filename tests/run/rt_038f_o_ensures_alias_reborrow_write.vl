// RULE: C3.4
// (0.30.2, RT-38f) An alias parameter of an inherent method, lent
// `&mut *p` in the ensures and written through the reborrow (0.30.1
// printed 2 9).
// RUSTC: none contract clauses are not Rust
// ERROR: cannot borrow '*p' as mutable
// ERROR-COUNT: 1
type R<'a> = &'a mut i64;
struct H;

impl H {
    fn f(&self, p: R<'_>) -> i64
        ensures {
        let q = &mut *p;
        *q = 9;
        true
    }

    {
        *p += 1;
        *p
    }
}

fn main() {
    let mut x = 1i64;
    println("{}", H.f(&mut x));
    println("{}", x);
}
