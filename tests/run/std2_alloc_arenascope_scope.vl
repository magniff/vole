// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc ArenaScope::scope.
// EXPECT: 8 16
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let (outer, inner) = arena.scope(|sc| {
        sc.alloc(1i64);
        let inner = sc.scope(|sc2| {
            sc2.alloc(2i64);
            sc2.alloc(3i64);
            sc2.used()
        });
        (sc.used(), inner)
    });
    println("{} {}", outer, inner);
}
