// RULE: F34.4 (0.30.2) mk, checked inside a constant's value for its hidden
// type, is checked as a function of its own: its `return P2 { .. }` is
// mk's result, so its tail of another type is refused (rustc E0308,
// vole opaque.mismatch). A check that kept the constant's state around mk
// read the `return` as the constant's and said nothing of it.
// ERROR: line 55
// ERROR-COUNT: 1
fn yes() -> bool {
    true
}

trait Tr {
    fn v(&self) -> i64;
}

struct P {
    x: i64,
}

impl Tr for P {
    fn v(&self) -> i64 {
        self.x
    }
}

struct P2 {
    y: i64,
}

impl Tr for P2 {
    fn v(&self) -> i64 {
        self.y
    }
}

struct D {
    k: i64,
}

const C: D = D { k: mk().v() };

fn main() {
    let z: i64 = 1;
    let w: i64 = 2;
    let a = [C; 2];
    println("in {} {} {}", a[0].k, a[1].k, z + w);
}

fn mk() -> impl Tr {
    let p = P { x: 3 };
    let q = P { x: 4 };
    if yes() {
        return P2 { y: 5 };
    }
    q // error here
}
