// (0.30.2, the re-review of g302holes: r91/r04_array)
// EXPECT: 14 16
// A closure returning an array of closures (one Copy closure, twice), one holding a closure.
fn main() {
    let k = 5i64;
    let mk = |m: i64| {
        let c = move |x: i64| x + m + k;
        let d = move |x: i64| c(x) * 2;
        [d, d]
    };
    let a = mk(1);
    println("{} {}", a[0](1), a[1](2));
}
