// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c16_nested_clause)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// a nested clause: the clause calls a fn whose own clause shadows its param.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn inner(s: N) -> i64
    ensures { let s = 2i64; s > 0 }

{
    take(s)
}

fn f(s: N) -> i64
    ensures { let s = N { v: result }; inner(s) > 0 }

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
