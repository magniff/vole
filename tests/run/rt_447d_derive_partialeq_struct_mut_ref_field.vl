// XFAIL: RT-447d: (RT-447's mechanism, a struct's `&mut` field) #[derive(PartialEq)] on `struct S<'a> { m: &'a mut i64 }` is refused inside the derive: "no impl of 'i64::eq' takes arguments (&&mut i64)"; rustc prints true. A `&'a i64` field works (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form r02d_derive_eq_struct_mut_ref.
// EXPECT: true
#[derive(PartialEq)]
struct S<'a> {
    m: &'a mut i64,
}

fn main() {
    let mut x = 5i64;
    let mut y = 5i64;
    let a = S { m: &mut x };
    let b = S { m: &mut y };
    println("{}", a == b);
}
