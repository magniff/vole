// A bound whose argument is a qualified path, `U: G<<T as A>::Out>`, inline and in a `where` (v0.30.1: "expected '>', got '<<'"; rustc 8 10)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: 8 10
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn h<T: A, U: G<<T as A>::Out>>(u: &U) -> i64 {
    u.g() + T::C
}

fn hw<T, U>(u: &U) -> i64
    where
        T: A,
        U: G<<T as A>::Out>,
{
    u.g() * 2
}

fn main() {
    println("{} {}", h::<S, S>(&S), hw::<S, S>(&S));
}
