// EDITION: rust
// RULE: F18.6
// F18.6's stage 2: a `_` written in a type is a variable (a `let`'s
// `FromFn<_>`, `Vec<_, Gpa>`, a tuple's part); a projection of a variable
// is solved with it (`"4".parse().unwrap()` with `F` from the `let`, its
// `Err` then); a closure whose bound mentions a variable infers its own
// parameter; `e?` checked against a type checks its value first; a variant
// pattern of the `?`'s match names the solution's variant.
// EXPECT: 4 Point { x: 3, y: 4 } 3 3 [5] Ok(42) true
use std::str::FromStr;

#[derive(Debug)]
struct Point {
    x: i64,
    y: i64,
}

impl FromStr for Point {
    type Err = ();

    fn from_str(s: &str) -> Result<Point, ()> {
        let (a, b) = s.split_once(',').ok_or(())?;
        Ok(Point { x: a.parse().map_err(|_| ())?, y: b.parse().map_err(|_| ())? })
    }
}

fn twice(s: &str) -> Result<u8, ()> {
    let n: u8 = s.parse().map_err(|_| ())?;
    Ok(n * 2)
}

fn main(gpa: Gpa) {
    let a: u32 = "4".parse().unwrap();
    let p: Point = "3,4".parse().unwrap();
    let t: (i64, _) = (1, 2u8);
    let mut n = 0i64;
    let f: std::iter::FromFn<_> = std::iter::from_fn(|| {
        n += 1;
        if n <= 3 { Some(n) } else { None }
    });
    let mut v: Vec<_, Gpa> = Vec::new_in(gpa);
    v.push(5i64);
    println("{} {:?} {} {} {:?} {:?} {}", a, p, t.0 + t.1 as i64, f.count(), v, twice("21"),
        twice("x").is_err());
}
