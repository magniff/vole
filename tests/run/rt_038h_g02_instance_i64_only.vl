// RUSTC: none contract clauses are not Rust
// EXPECT: 1
// The same generic clause, instantiated with i64 only.
fn f<T>(t: &T, o: Option<i64>) -> i64
    requires o.iter().all(|x| *x > 0)
{
    1
}

fn main() {
    println("{}", f(&3i64, Some(1)));
}
