// RULE: D4.7
// (0.30.1) A function that needs a 'static parameter is no value: a call
// through a `fn` value or an `Fn` bound may pass a reference to a local
// (rustc E0308, one type is more general than the other). Written
// `'static`, a named lifetime bounded by it, a `'static` in the impl's
// header (Self), a `T: 'static` given a reference.
// ERROR: error[borrowck.fn_value_static]: 'keep' cannot be used as a value: its parameter 'x' needs a 'static lifetime
// ERROR: line 43, column 30
// ERROR: line 44, column 10
// ERROR: error[borrowck.fn_value_static]: 'bounded' cannot be used as a value: its parameter 'x'
// ERROR: line 45, column 30
// ERROR: error[borrowck.fn_value_static]: 'name' cannot be used as a value: its parameter 'self'
// ERROR: line 46, column 27
// ERROR: error[borrowck.fn_value_static]: 'hold' cannot be used as a value: its parameter 't'
// ERROR: line 47, column 30
// ERROR: error[borrowck.fn_value_static]: 'wrap' cannot be used as a value: its parameter 'w'
// ERROR: line 48, column 27
// ERROR-COUNT: 6
struct W<'a> {
    r: &'a i64,
}

impl W<'static> {
    fn name(self) -> i64 { *self.r }
}

fn keep(x: &'static i64) -> i64 { *x }

fn bounded<'a: 'static>(x: &'a i64) -> i64 { *x }

fn hold<T: 'static>(t: T) -> i64 { 1 }

fn wrap(w: W<'static>) -> i64 { *w.r }

fn call<F: Fn(&i64) -> i64>(f: F) -> i64 {
    let x = 3;
    f(&x)
}

fn main() {
    let x: i64 = 2;
    let r = &x;
    let a: fn(&i64) -> i64 = keep;
    call(keep);
    let b: fn(&i64) -> i64 = bounded;
    let c: fn(W) -> i64 = W::name;
    let d: fn(&i64) -> i64 = hold::<&i64>;
    let e: fn(W) -> i64 = wrap;
    println("{} {} {} {} {}", a(r), b(r), c(W { r: r }), d(r), e(W { r: r }));
}
