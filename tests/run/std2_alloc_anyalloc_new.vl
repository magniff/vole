// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc AnyAlloc::new.
// EXPECT: [1, 2, 3]
use std::alloc::{AnyAlloc, Arena};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let a = AnyAlloc::new(&arena);
    let v = Vec::from_in([1, 2, 3], a);
    println("{:?}", v);
}
