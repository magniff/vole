// RT-211, the result's shape does not matter: Option of a tuple, an array,
// nested tuples, a struct of two parameters each keep the items' borrow
// (rustc E0505 at the drop). v0.30.1 built it.
// ERROR: line 64
// ERROR-COUNT: 4
trait Put<T> {
    fn put1(&mut self, t: T);
}

impl<T> Put<T> for Vec<T, Gpa> {
    fn put1(&mut self, t: T) {
        self.push(t);
    }
}

impl<'a, T: Copy> Put<&'a T> for Vec<T, Gpa> {
    fn put1(&mut self, t: &'a T) {
        self.push(*t);
    }
}

struct Pair<P, Q> {
    p: P,
    q: Q,
}

fn opt<I: Iterator, B: Put<I::Item>>(it: I, mut b: B, c: B) -> Option<(B, B)> {
    for x in it {
        b.put1(x);
    }
    Some((b, c))
}

fn arr<I: Iterator, B: Put<I::Item>>(it: I, mut b: B, c: B) -> [B; 2] {
    for x in it {
        b.put1(x);
    }
    [b, c]
}

fn nest<I: Iterator, B: Put<I::Item>>(it: I, mut b: B, c: B, d: B) -> ((B, B), B) {
    for x in it {
        b.put1(x);
    }
    ((c, b), d)
}

fn pair<I: Iterator, B: Put<I::Item>, C>(it: I, mut b: B, c: C) -> Pair<C, B> {
    for x in it {
        b.put1(x);
    }
    Pair { p: c, q: b }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let o: Option<(Vec<&i64, Gpa>, Vec<&i64, Gpa>)> = opt(v.iter(), Vec::new_in(gpa),
        Vec::new_in(gpa));
    let a: [Vec<&i64, Gpa>; 2] = arr(v.iter(), Vec::new_in(gpa), Vec::new_in(gpa));
    let n: ((Vec<&i64, Gpa>, Vec<&i64, Gpa>), Vec<&i64, Gpa>) =
        nest(v.iter(), Vec::new_in(gpa), Vec::new_in(gpa), Vec::new_in(gpa));
    let p: Pair<i64, Vec<&i64, Gpa>> = pair(v.iter(), Vec::new_in(gpa), 5);
    drop(v);
    println("{:?} {:?} {:?} {:?}", o, a[0], n.0.1, p.q);
}
