// RULE: F30.4
// (0.29) The length and the pointer of a slice are its methods, as in
// Rust: `len()`, `as_ptr()`, `as_mut_ptr()`; a `for` over a slice and
// `==` of two, which read the length themselves, need no field.
// EXPECT: 3 6 true
// EXPECT: 2 9 true
// EXPECT: 3
fn sum(s: &[i64]) -> i64 {
    let mut t = 0;
    for x in s {
        t += *x;
    }
    t
}

fn main() {
    let mut a = [1i64, 2, 3];
    let s: &[i64] = &a[..];
    println("{} {} {}", s.len(), sum(s), s == &a[0..3]);
    let p = s.as_ptr();
    // UNSAFE: reads through the slice's pointer.
    // SAFETY: p is s's, which has three elements; 1 is in it.
    let second = unsafe { *p.add(1) };
    let m: &mut [i64] = &mut a[1..];
    let q = m.as_mut_ptr();
    // UNSAFE: writes through the slice's pointer.
    // SAFETY: q is m's, which has two elements; 0 is in it, and m is
    // the only reference to them.
    unsafe {
        *q = 9;
    }
    println("{} {} {}", second, m[0], m.len() == 2);
    println("{}", "abc".as_bytes().len());
}
