// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D6.2.5, F30.2
// (0.27.4) A place under a deref of a raw borrow is a place through the raw
// pointer, no reference to the `static mut`: a method's autoref of
// `(*&raw mut S)`, `&mut *&raw mut S`, a field through it, written and
// read in `unsafe`; a local's the same.
// EXPECT: 2 4 6 7 9 1
struct V2 {
    n: i64,
}

impl V2 {
    fn push(&mut self, x: i64) {
        self.n += x;
    }

    fn get(&self) -> i64 {
        self.n
    }
}

static mut V: V2 = V2 { n: 0 };

fn main() {
    unsafe {
        (*(&raw mut V)).push(2);
    }
    let a = unsafe { (*(&raw const V)).get() };
    unsafe {
        (*&raw mut V).push(2);
    }
    let b = unsafe { (*&raw const V).get() };
    unsafe {
        let r = &mut *&raw mut V;
        r.push(2);
    }
    let c = unsafe { (*&raw const V).n };
    unsafe {
        (*&raw mut V).n += 1;
    }
    let d = unsafe { (*&raw const V).get() };
    let mut x = V2 { n: 4 };
    unsafe {
        (*&raw mut x).push(5);
    }
    let w = V2 { n: 1 };
    let e = unsafe { (*&raw const w).get() };
    println("{} {} {} {} {} {}", a, b, c, d, x.get(), e);
}
