// EDITION: rust
// RULE: F8.2
// (0.27.6) `Tr::f(args)` of a trait function without a receiver takes
// Self from the argument its written type holds Self in: in `impl<T: Feed>
// Feed for [T]`, `Feed::feed_slice(self, h)` with `data: &[Self]` and
// `self: &[T]` is `<T as Feed>::feed_slice`, as rustc infers it (0.27.5
// read it as a method call on `[T]`: "an associated function, not a
// method"; std2's Hash for [T] wrote `T::hash_slice`).
// EXPECT: 2 30 2 7 75
trait Sink {
    fn push(&mut self, v: i64);
}

struct Acc {
    t: i64,
}

impl Sink for Acc {
    fn push(&mut self, v: i64) {
        self.t += v;
    }
}

trait Feed {
    fn feed<H: Sink>(&self, h: &mut H);

    fn feed_slice<H: Sink>(data: &[Self], h: &mut H)
        where
            Self: Sized,
    {
        for x in data {
            x.feed(h);
        }
    }
}

impl Feed for u8 {
    fn feed<H: Sink>(&self, h: &mut H) {
        h.push(*self as i64);
    }
}

impl Feed for i64 {
    fn feed<H: Sink>(&self, h: &mut H) {
        h.push(*self * 10);
    }
}

impl<T: Feed> Feed for [T] {
    fn feed<H: Sink>(&self, h: &mut H) {
        h.push(self.len() as i64);
        Feed::feed_slice(self, h)
    }
}

fn main() {
    let a = [1i64, 2];
    let b = [3u8, 4];
    let mut x = Acc { t: 0 };
    a[..].feed(&mut x);
    let mut y = Acc { t: 0 };
    let c: &[u8] = &b[..];
    c.feed(&mut y);
    let mut z = Acc { t: 0 };
    Feed::feed_slice(&b[..], &mut z);
    let mut w = Acc { t: 5 };
    let d = [3i64, 4];
    Feed::feed_slice(&d[..], &mut w);
    println("{} {} {} {} {}", a.len(), x.t - 2, c.len(), z.t, w.t);
}
