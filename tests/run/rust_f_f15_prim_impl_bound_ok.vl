// RULE: F15.1, FL6
// (0.27.4) An open literal closed by a trait bound (`f(5)`, T: Hash)
// is i32 whatever primitives the program names, and a value of a type
// it does not name (the u32 of `count_ones`) still finds its Hash and
// Display: a lazy build that lacks them fails its check and is made
// again whole, so the bound never selects another impl.
// EXPECT: 5 4
// EXPECT: 4 4
use std::fmt::Display;
use std::hash::Hash;

fn f<T: Hash + Display>(x: T) {
    println("{} {}", x, std::mem::size_of::<T>());
}

fn main() {
    f(5);
    f(15i64.count_ones());
}
