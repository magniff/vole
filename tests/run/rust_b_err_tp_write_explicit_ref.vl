// EDITION: rust
// RULE: D7.4
// (0.27.6) A writer the program borrows itself, `write(&mut self.emsg,
// ..)` (Rust's `write!(&mut self.emsg, ..)`), is an ordinary `&mut`, not
// two-phase: an argument reading `*self` conflicts, rustc's E0502. So
// does any explicit `&mut v` argument, `take(&mut v, v.len())`.
// ERROR: error[borrowck.conflict]
// ERROR: line 24, column 37
// ERROR: line 36, column 18
// ERROR-COUNT: 2
use std::alloc::{Allocator, Gpa};
use std::io::Write;

struct F<A: Allocator> {
    emsg: Vec<u8, A>,
}

impl<A: Allocator> F<A> {
    fn len(&self) -> usize {
        self.emsg.len()
    }

    fn go(&mut self) {
        write(&mut self.emsg, "{}", self.len()).unwrap();
    }
}

fn take(v: &mut Vec<i64, Gpa>, n: usize) {
    v.push(n as i64);
}

fn main(gpa: Gpa) {
    let mut f = F { emsg: Vec::new_in(gpa) };
    f.go();
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    take(&mut v, v.len());
}
