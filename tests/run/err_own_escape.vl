// 0.17 (value semantics, T2): own.escape, one per rule.
// ERROR: 'greet' returns a view of 'b', which is dropped when 'greet' returns
// ERROR: 'count' returns a reference ('let i64')
// ERROR: 'keep' stores a view of 'b' into what 'out' points to
// ERROR: the block's value views 'local'
// ERROR: the block's value views 'arr'
#[derive(Clone, Copy)] struct Names<'a> { list: [&'a [u8]; 2], n: i64 }

fn greet(gpa: Gpa, name: &[u8]) -> &[u8] {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(name);
    b.as_slice()
}

fn copy_of(a: &[i64; 3]) -> &[i64] {
    &a[..]
}

fn count(v: &Names<'_>) -> &i64 {
    v.n
}

fn keep(out: &mut Names<'_>, gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str("x");
    out.list[0] = b.as_bytes();
}

fn main(gpa: Gpa) {
    // (0.24: copy_of borrows its array, a view of which it returns)
    let three = [1i64, 2, 3];
    let s = {
        let local = [1i64, 2, 3];
        &local[..]
    };
    let t: &[i64] = {
        let arr = [4i64, 5];
        &arr[..]
    };
    println("{} {} {} {}", str::from_utf8(greet(gpa, b"a")).unwrap(), copy_of(&three)[0], s[0],
        t[0]);
    let mut n = Names { list: [b"a", b"b"], n: 2 };
    keep(&mut n, gpa);
    println("{}", count(&n));
}
