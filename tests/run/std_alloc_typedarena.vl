// The std item(s): std::alloc TypedArena.
// EXPECT: 2 ab
use std::alloc::TypedArena;

fn main(gpa: Gpa) {
    let ta = TypedArena::new_in(gpa);
    let a = ta.alloc(String::from_in("a", gpa));
    a.push('b');
    let b = ta.alloc(String::from_in("c", gpa));
    let _ = b;
    println("{} {}", ta.len(), a);
}
