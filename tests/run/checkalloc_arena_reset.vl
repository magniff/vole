// EDITION: rust
// XFAIL: std2's arena under --check-alloc: reset keeps the chunk's pages, so the read after it prints 3
// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: before 3
// STDERR: use after release: block #4 (128 bytes) of an arena, allocated at
// STDERR: checkalloc_arena_reset.vl:21:13, released at
// STDERR: checkalloc_arena_reset.vl:30:9 (the arena's reset or scope end)
// 0.16: --check-alloc with an arena: each block on pages of its own (the
// bump keeps the count); reset takes them away, so a pointer kept across
// it stops the program.
// (0.28: a slice kept across the reset is a borrow error; this is a raw
// pointer. The old std's arena put each block on pages of its own under
// --check-alloc; std2's does not yet.)
use std::alloc::Arena;

fn main(gpa: Gpa) -> i32 {
    let mut a = Arena::new_in(gpa);
    let p = {
        let mut v: Vec<i64, &Arena<Gpa>> = Vec::new_in(&a);
        for i in 0..10 {
            v.push(i);
        }
        v.as_ptr()
    };
    // UNSAFE: a pointer into the arena, read before and after its reset.
    // SAFETY: sound before the reset (the block holds ten elements); none
    // after it, on purpose: --check-alloc is to stop the read.
    unsafe {
        println("before {}", *p.add(3));
        a.reset();
        println("after {}", *p.add(3));
    }
    0
}
