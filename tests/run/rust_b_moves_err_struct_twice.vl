// EDITION: rust
// RULE: D8.5
// (0.27.2.1) A struct literal with the same non-Copy place in two fields
// (rustc E0382).
// ERROR: error[borrowck.use_moved]
// ERROR-COUNT: 1
struct D {
    n: i64,
}

struct P {
    a: D,
    b: D,
}

fn main() {
    let t = D { n: 1 };
    let p = P { a: t, b: t };
    println("{}", p.a.n + p.b.n);
}
