// EDITION: rust
// (0.27.1) The region slots of a type (docs/design/borrowck.md D3.3), the
// signature's universals (D4.1, D4.2: one per named lifetime, 'static,
// each elided input, a type parameter's substitution), the implied and
// declared bounds (D4.5), n call regions per call (D3.2) and the variance
// of each user type (D5.3).
// RULE: D3.3
// RULE: D4.2
// RULE: D5.3
// PLACES: variance Pair: 'a +, 'b +
// PLACES: variance Cur: 'a +, T +
// PLACES: variance Fnp: 'a -
// PLACES: fn Pair::second
// PLACES: region 'r2: universal 'a (_1.1)
// PLACES: region 'r3: universal 'b (_1.2, return.0)
// PLACES: region 'r4: universal '_1 (_1.0)
// PLACES: bound 'r3: 'r4
// PLACES: fn pick
// PLACES: region 'r1: universal 'static (_3.0)
// PLACES: region 'r2: universal 'a (_1.0, return.0)
// PLACES: region 'r3: universal 'b (_2.0)
// PLACES: bound 'r3: 'r2
// PLACES: fn rr
// PLACES: region 'r2: universal 'a (_1.1, return.0)
// PLACES: region 'r3: universal '_1 (_1.0)
// PLACES: fn main
// PLACES: : local _3.1
// PLACES-NOT: : local _3.2
// PLACES: fn same<let i64>
// PLACES: region 'r2: universal 'T.0 (_1.0, _2.0, return.0)

struct Pair<'a, 'b> {
    x: &'a i64,
    y: &'b i64,
}

struct Cur<'a, T> {
    m: &'a mut i64,
    v: T,
}

struct Fnp<'a> {
    f: fn(&'a i64) -> i64,
}

impl<'a, 'b> Pair<'a, 'b> {
    fn second(&self) -> &'b i64 {
        self.y
    }
}

fn pick<'a, 'b: 'a>(x: &'a i64, y: &'b i64, s: &'static str) -> &'a i64 {
    if *x > *y && s.len() > 0 { x } else { y }
}

fn same<T>(x: T, y: T) -> T {
    let _ = y;
    x
}

fn rr<'a>(x: &&'a i64) -> &'a i64 {
    *x
}

fn one(x: &i64) -> i64 {
    *x
}

fn main() -> i32 {
    let a = 1;
    let b = 2;
    let p = Pair { x: &a, y: &b };
    let mut n = 0;
    let c = Cur { m: &mut n, v: 3 };
    *c.m += c.v;
    let f = Fnp { f: one };
    let r = &a;
    println("{} {} {} {} {}", *pick(&a, &b, "s"), *p.second(), *same(&a, &b), *rr(&r),
        n + (f.f)(&a));
    0
}
// EXPECT: 2 2 1 1 4
