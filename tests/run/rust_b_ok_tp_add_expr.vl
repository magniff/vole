// EDITION: rust
// RULE: D7.2
// (0.27.1) Reads and a shared call in the window.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn get(&self) -> i64 {
        self.x
    }

    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add(s.x + s.get() + s.y);
    println("{}", s.x);
}
// EXPECT: 5
// (0.27.2) written against MVS std until it migrates to std2:
