// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). A blanket
// impl's Out = (T, T) used as (i64, i32): refused (rustc E0308).
// ERROR: (rustc E0271)
// ERROR-COUNT: 1
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl<T: Copy> Tr for T {
    type Out = (T, T);

    fn o(self) -> (T, T) {
        (self, self)
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let v: (i64, i32) = f(2);
    println("{}", v.0);
}
