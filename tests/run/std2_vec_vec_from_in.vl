// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::from_in.
// EXPECT: [1, 2, 3] []
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2, 3], gpa);
    let e: Vec<i64, Gpa> = Vec::from_in([], gpa);
    println("{:?} {:?}", v, e);
}
