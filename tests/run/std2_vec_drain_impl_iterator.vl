// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::vec Drain::impl Iterator.
// EXPECT: Some(2) Some(3) None
// EXPECT: [1, 4]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3, 4], gpa);
    {
        let mut d = v.drain(1..3);
        println("{:?} {:?} {:?}", d.next(), d.next(), d.next());
    }
    println("{:?}", v);
}
