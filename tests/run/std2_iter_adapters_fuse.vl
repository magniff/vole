// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters Fuse.
// EXPECT: None None
use std::iter::Fuse;

fn main(gpa: Gpa) {
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut it: Fuse<std::slice::Iter<'_, i64>> = e.iter().fuse();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
