struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut t = (HD { r: &z }, 2i64);
    let x: i64 = 1;
    t = (HD { r: &x }, 3);
    println("{}", t.1);
}
