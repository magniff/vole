// a generic cloning a Vec<T> of Vec: the copy independent
// FLAGS: --check-alloc
// EXPECT: 1 2
fn dup<T: Clone>(x: &T) -> T { x.clone() }

fn main(gpa: Gpa) {
    let mut inner: Vec<i64, Gpa> = Vec::new_in(gpa);
    inner.push(1);
    let mut a: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    a.push(inner);
    let mut b = dup(&a);
    b[0].push(2);
    println("{} {}", a[0].len(), b[0].len());
}
