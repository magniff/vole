// EDITION: rust
// A run-time lane number past the lanes.
// EXIT: 101
// STDERR: index out of bounds: index 4, length 4
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let v = v4f32::splat(1.0);
    println("{}", v.lane(4 + unsafe { Z }) as i64);
    println("not reached");
    0
}
