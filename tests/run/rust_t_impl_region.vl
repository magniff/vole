// (0.27.7) the 0.27 translator's version of tests/refactor/edition0276f
// (formatted): an impl of a struct with views names its region; rustc
// builds it too, and it prints what the MVS program does.
// EXPECT: 3 query true name args 1
// The translator (0.27.6): a struct that holds views (`Line.words`,
// `Leaf.word`) is translated `Line<'a>`; its impl names that lifetime,
// `impl<'a> Line<'a>`, and a method that returns a view of a field, or
// takes a view it stores, says `'a` (not `'_`, nor `'static`).
use std::alloc::Allocator;

#[derive(Clone, Copy)]
struct Opt<'a> {
    name: &'a str,
    takes: bool,
}

#[derive(Clone, Copy)]
struct Line<'a> {
    words: &'a [&'a str],
}

impl<'a> Line<'a> {
    fn len(self) -> i64 {
        self.words.len() as i64
    }

    fn word(self, k: i64) -> &'a str {
        if k >= 0 && k < self.words.len() as i64 { self.words[k as usize] } else { "" }
    }
}

#[derive(Clone)]
struct Leaf<'a, A: Allocator> {
    opts: Vec<Opt<'a>, A>,
    word: &'a str,
    last: &'a str,
}

impl<'a, A: Allocator> Leaf<'a, A> {
    fn new(opts: Vec<Opt<'a>, A>, word: &'a str) -> Leaf<'a, A> {
        Leaf { opts: opts, word: word, last: "" }
    }

    fn with_last(mut self, last: &'a str) -> Leaf<'a, A> {
        self.last = last;
        self
    }
}

fn first_word(l: Line<'_>) -> &str {
    l.word(1)
}

fn main(gpa: Gpa) {
    let ws: [&str; 3] = ["prog", "query", "--all"];
    let l = Line { words: &ws[0..3] };
    let w = first_word(l);
    let mut opts: Vec<Opt<'_>, Gpa> = Vec::new_in(gpa);
    opts.push(Opt { name: "all", takes: false });
    let leaf = Leaf::new(opts, "name").with_last("args");
    println("{} {} {} {} {} {}", l.len(), w, l.word(5) == "", leaf.word, leaf.last,
        leaf.opts.len());
}
