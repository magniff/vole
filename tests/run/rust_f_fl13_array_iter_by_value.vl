// EDITION: rust
// RULE: F6.2, FL13
// FLAGS: --check-alloc
// (0.27.3) `a.into_iter()` on an array, a place or a temporary, is the
// array's by-value IntoIterator (rustc's 2021 probe: `[T; N]` by value
// before the `&[T; N]` impl and the slice's): it yields the Strings
// themselves, moved out, not references to them.
// EXPECT: ["a!", "b!"]
// EXPECT: cd 2
// EXPECT: 1 2 3
fn main(gpa: Gpa) {
    let s1 = "a".to_string_in(gpa);
    let s2 = "b".to_string_in(gpa);
    let mut v: Vec<String<Gpa>, Gpa> = [s1, s2].into_iter().collect_in(gpa);
    for s in v.iter_mut() {
        s.push_str("!");
    }
    println("{:?}", v);
    let a = ["c".to_string_in(gpa), "d".to_string_in(gpa)];
    let mut joined = String::new_in(gpa);
    let mut n = 0;
    for s in a.into_iter() {
        let owned: String<Gpa> = s;
        joined.push_str(&owned);
        n += 1;
    }
    println("{joined} {n}");
    let nums = [1i64, 2, 3];
    let mut it = nums.into_iter();
    let x: i64 = it.next().unwrap();
    let y: i64 = it.next().unwrap();
    println("{x} {y} {}", it.next().unwrap());
}
