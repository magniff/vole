// EDITION: rust
// (0.27.0) Hand-translated from tests/run/own_ref_compare.vl to Rust's spelling.
// (0.17, T7) `==`, `!=`, `<`, `<=`, `>`, `>=` on two references compare
// what they point to (T's Eq and Ord, derived or numeric or an enum's
// order), as Rust's do; raw `*T` pointers compare as addresses, and a
// reference cast to one (`a as *P`) too.
#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct P {
    x: i64,
    y: i64,
}

#[derive(PartialEq, PartialOrd)]
enum Color {
    Red,
    Green,
}

fn lt(a: &P, b: &P) -> bool {
    a < b
}

fn eq(a: &P, b: &P) -> bool {
    a == b
}

fn ne_int(a: i64, b: &mut i64) -> bool {
    a != *b
}

fn same(a: *const P, b: *const P) -> bool {
    a == b
}

fn same_ref(a: *const P, b: *const P) -> bool {
    a as *const P == b as *const P
}

fn col(a: Color, b: Color) -> bool {
    a < b
}

fn main() -> i32 {
    let p = P { x: 1, y: 2 };
    let q = P { x: 1, y: 2 };
    let r = P { x: 0, y: 9 };
    let mut k = 3;
    let three = 3;
    let red = Color::Red;
    let green = Color::Green;
    println(
        "{} {} {} {} {} {} {} {}",
        eq(&p, &q),
        lt(&r, &p),
        lt(&p, &r),
        ne_int(three, &mut k),
        same(&p, &q),
        same_ref(&p, &p),
        same_ref(&p, &q),
        col(red, green),
    );
    0
}
// EXPECT: true true false false false true false true
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
