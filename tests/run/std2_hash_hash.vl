// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::hash Hash.
// EXPECT: write [1, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [2, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: 16
use std::hash::{BuildHasher, BuildHasherDefault, Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

struct Point {
    x: i64,
    y: i64,
}

impl Hash for Point {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.x.hash(state);
        self.y.hash(state);
    }
}

fn main() {
    let mut h = Show { n: 0 };
    let p = Point { x: 1, y: 2 };
    p.hash(&mut h);
    println("{}", h.finish());
}
