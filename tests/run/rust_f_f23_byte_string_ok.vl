// EDITION: rust
// RULE: F23.2
// `b"..."` is a byte string: its bytes, with the escapes of a string
// (0.27.3: it did not parse). vole types it `&[u8]` (rustc `&[u8; N]`,
// which coerces to it).
// EXPECT: 3 104 10 [120, 121]
fn total(b: &[u8]) -> usize {
    b.len()
}

fn main() {
    let b: &[u8] = b"hi\n";
    let c = b"xy";
    println("{} {} {} [{}, {}]", total(b), b[0], b[2], c[0], c[1]);
}
