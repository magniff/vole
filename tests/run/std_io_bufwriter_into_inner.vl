// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::io BufWriter::into_inner.
// EXPECT: [5] BrokenPipe
use std::io::{BufWriter, ErrorKind, Write, self};

struct Broken;

impl Write for Broken {
    fn write(&mut self, _buf: &[u8]) -> io::Result<usize> {
        Err(io::Error::from(ErrorKind::BrokenPipe))
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

fn main(gpa: Gpa) {
    let mut w = BufWriter::new(Vec::<u8, Gpa>::new_in(gpa));
    w.write_all(&[5]).unwrap();
    let v = w.into_inner().unwrap();
    let mut b = BufWriter::new(Broken);
    b.write_all(&[1]).unwrap();
    let e = b.into_inner().err().unwrap();
    println("{:?} {:?}", v, e.error().kind());
}
