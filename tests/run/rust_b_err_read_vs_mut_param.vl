// RULE: D2.5
// (0.27.1) Through a `&mut S` parameter: a copy of `s.x` while `&mut s.x` is
// live.
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 16, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

fn bump(s: &mut S) {
    let m = &mut s.x;
    let t = s.x;
    *m += t;
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    bump(&mut s);
    println("{}", s.x);
}
