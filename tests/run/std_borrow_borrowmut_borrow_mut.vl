// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::borrow BorrowMut::borrow_mut.
// EXPECT: 6
use std::borrow::{Borrow, BorrowMut};

struct W {
    v: i64,
}

impl Borrow<i64> for W {
    fn borrow(&self) -> &i64 {
        &self.v
    }
}

impl BorrowMut<i64> for W {
    fn borrow_mut(&mut self) -> &mut i64 {
        &mut self.v
    }
}

fn main() {
    let mut w = W { v: 5 };
    let r: &mut i64 = w.borrow_mut();
    *r += 1;
    println("{}", w.v);
}
