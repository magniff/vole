// XFAIL: RT-420: WRONG CODE: an index through two references to a Vec, `rr[1]` of `rr: &&Vec<Vec<i64>>` and `mm[1]` of `mm: &mut &mut Vec<..>`, is a raw pointer's arithmetic over the reference (rustc: `(**rr)[1]`): in an unsafe block it reads and writes past the reference's stack slot, a segfault at -O0 and -O2 (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt, with unused_unsafe
// allowed). vole prints a stack word as the length (`len 1699206794981648787`, `len 2` under the runner) and dies with SIGSEGV
// (exit 139) at -O0 and -O2, under --check-alloc and --check-unsafe too
// (neither reports it); v0.28.0 to v0.30.1 the same (v0.28.0, v0.29.0
// segfault before the first line). The cause (synth_mode.vl synth_index):
// a reference base indexes through one reference to a Vec, slice or str
// (`indexes_through`), through every reference to an array (F20.1), and
// otherwise falls to the TyKind::Ptr branch, which is a raw pointer's
// index although `is_ref` holds: `rr[1]` is `*(rr + 1)`, typed &Vec.
// Without the unsafe blocks the program is refused ("indexing a raw
// pointer is unsafe"), and its try: `volec fix --only unsafe` writes the
// unsafe blocks, which gives this program: rt R302I-3b is that side.
// EXPECT: len 3
// EXPECT: rows 2 0
fn row(gpa: Gpa, n: i64) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn main(gpa: Gpa) {
    let mut rows: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    rows.push(row(gpa, 1));
    rows.push(row(gpa, 3));
    let r = &rows;
    let rr = &r;
    // valid Rust: `rr[1]` is `(**rr)[1]`, the second row
    let n = unsafe { rr[1].len() };
    println("len {}", n);
    let mut m = &mut rows;
    let mm = &mut m;
    unsafe {
        mm[1].clear();
    }
    println("rows {} {}", rows.len(), rows[1].len());
}
