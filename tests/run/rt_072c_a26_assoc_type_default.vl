// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a26 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 310
// EXPECT: 11
trait TA { fn m(&self) -> i64; }
struct S { k: i64 }
impl S { fn m(&self) -> i64 { 300 } }
impl TA for S { fn m(&self) -> i64 { 1 } }

trait Holder {
    type In: TA; fn inner(&self) -> &Self::In; fn d(&self) -> i64 { self.inner().m() + 10 }
}

struct H { s: S }
impl Holder for H { type In = S; fn inner(&self) -> &S { &self.s } }
fn main() { let h = H { s: S { k: 0 } }; println("{}", h.d()); }
