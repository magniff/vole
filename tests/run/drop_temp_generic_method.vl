// (0.29) The temporary a generic method returns, lent or read: a trait
// method's `Self` called through a bound (`twin_of`) and on the value, a
// generic type's method returning its parameter (`w.get()`) or itself
// (`w.again()`): each dropped at the end of its statement (they leaked,
// as drop_temp_generic_result's).
// EXPECT: a 4
// EXPECT: d2
// EXPECT: b 4
// EXPECT: d3
// EXPECT: c 4
// EXPECT: d4
// EXPECT: d 4
// EXPECT: d5
// EXPECT: e 5
// EXPECT: d7
// EXPECT: f 5
// EXPECT: d8
// EXPECT: g 5
// EXPECT: d9
// EXPECT: h 5
// EXPECT: d10
// EXPECT: i 5
// EXPECT: d12
// EXPECT: d11
// EXPECT: end
// EXPECT: d6
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

trait Twin {
    fn twin(&self) -> Self;
}

impl Twin for T {
    fn twin(&self) -> T {
        self.clone()
    }
}

fn twin_of<X: Twin>(x: &X) -> X {
    x.twin()
}

struct W<X> {
    x: X,
}

impl<X: Clone> W<X> {
    fn get(&self) -> X {
        self.x.clone()
    }

    fn again(&self) -> W<X> {
        W { x: self.x.clone() }
    }
}

fn run() {
    let t = mk(4);
    println("a {}", obs(&twin_of(&t)));
    println("b {}", twin_of(&t).v);
    println("c {}", obs(&t.twin()));
    println("d {}", t.twin().v);
    let w = W { x: mk(5) };
    println("e {}", obs(&w.get()));
    println("f {}", w.get().v);
    println("g {}", w.again().x.v);
    println("h {}", obs(&w.again().x));
    println("i {}", obs(&w.again().get()));
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
