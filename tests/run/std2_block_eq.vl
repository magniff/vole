// (0.29) `==` on slices of integers and bool compares the bytes as one
// block: the answers of the element-by-element compare, for no elements,
// different lengths, a difference in the first and in the last element,
// slices at odd addresses, every integer width, negative numbers; floats
// and types with their own PartialEq keep comparing by `==` (NaN is not
// itself, 0.0 is -0.0); starts_with, ends_with, str, Vec and arrays go
// through the slices'.
// The std2 item(s): std::slice [T]::impl PartialEq<[U]>, [T]::starts_with, [T]::ends_with.
// EXPECT: empty true
// EXPECT: lengths false false
// EXPECT: same true first false last false
// EXPECT: odd true false
// EXPECT: long true false false
// EXPECT: i8 true false i16 true false i32 true false i64 true false
// EXPECT: u16 true false u32 true false u64 true false usize true false isize true false
// EXPECT: bool true false
// EXPECT: nan false zero true floats true
// EXPECT: always true never false
// EXPECT: starts true false true ends true false true
// EXPECT: str true false false true
// EXPECT: vec true false array true false
// EXPECT: across true false
// EXPECT: ne false true
use std::string::String;
use std::vec::Vec;

struct Always {
    n: i64,
}

impl PartialEq for Always {
    fn eq(&self, other: &Always) -> bool {
        true
    }
}

struct Never {
    n: u8,
}

impl PartialEq for Never {
    fn eq(&self, other: &Never) -> bool {
        false
    }
}

fn same<T: PartialEq>(a: &[T], b: &[T]) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    let e: [u8; 0] = [];
    println("empty {}", same(&e, &e));
    println("lengths {} {}", same(&[1u8, 2, 3], &[1u8, 2]), same(&e, &[0u8]));
    let a = [1u8, 2, 3, 4, 5, 6, 7, 8, 9];
    println("same {} first {} last {}", same(&a, &[1, 2, 3, 4, 5, 6, 7, 8, 9]),
        same(&a, &[0, 2, 3, 4, 5, 6, 7, 8, 9]), same(&a, &[1, 2, 3, 4, 5, 6, 7, 8, 0]));
    let b = [0u8, 1, 2, 3, 4, 5, 6, 7, 8, 9, 0];
    println("odd {} {}", same(&b[1..10], &a), same(&b[2..11], &a));

    let mut x: Vec<u8, Gpa> = Vec::new_in(gpa);
    let mut y: Vec<u8, Gpa> = Vec::new_in(gpa);
    for i in 0..200000 {
        x.push((i % 251) as u8);
        y.push((i % 251) as u8);
    }
    let all = same(&x, &y);
    y[199999] ^= 1;
    let last = same(&x, &y);
    y[199999] ^= 1;
    y[0] ^= 0x80;
    println("long {} {} {}", all, last, same(&x, &y));

    println("i8 {} {} i16 {} {} i32 {} {} i64 {} {}", same(&[-1i8, 0, 127], &[-1i8, 0, 127]),
        same(&[-1i8, 0, 127], &[-1i8, 0, -128]), same(&[-300i16, 5], &[-300i16, 5]),
        same(&[-300i16, 5], &[-300i16, 261]), same(&[1i32, -1, 65536], &[1i32, -1, 65536]),
        same(&[1i32, -1, 65536], &[1i32, -1, 0]), same(&[i64::MIN, 7], &[i64::MIN, 7]),
        same(&[i64::MIN, 7], &[i64::MAX, 7]));
    println("u16 {} {} u32 {} {} u64 {} {} usize {} {} isize {} {}", same(&[65535u16], &[65535u16]),
        same(&[65535u16], &[255u16]), same(&[1u32, 2], &[1u32, 2]),
        same(&[1u32, 2], &[1u32, 16777218]), same(&[u64::MAX, 0], &[u64::MAX, 0]),
        same(&[u64::MAX, 0], &[u64::MAX, 1]), same(&[3usize, 4], &[3usize, 4]),
        same(&[3usize, 4], &[4usize, 3]), same(&[-3isize, 4], &[-3isize, 4]),
        same(&[-3isize, 4], &[3isize, 4]));
    println("bool {} {}", same(&[true, false, true], &[true, false, true]),
        same(&[true, false, true], &[true, true, true]));

    let nan = [f64::NAN, 1.0];
    let zero = [0.0f64, -0.0];
    println("nan {} zero {} floats {}", same(&nan, &nan), same(&zero, &[-0.0, 0.0]),
        same(&[1.5f32, 2.5], &[1.5f32, 2.5]));
    println("always {} never {}", same(&[Always { n: 1 }, Always { n: 2 }], &[Always { n: 3 },
        Always { n: 4 }]), same(&[Never { n: 1 }], &[Never { n: 1 }]));

    let name = b"compiler/std/slice.vl";
    println("starts {} {} {} ends {} {} {}", name.starts_with(b"compiler/"),
        name.starts_with(b"compiler/src"), name.starts_with(b""), name.ends_with(b".vl"),
        name.ends_with(b".rs"), name.ends_with(name));

    let s = String::from_in("vole", gpa);
    println("str {} {} {} {}", "vole" == "vole", "vole" == "mole", "vole" == "voles",
        s.as_str() == "vole");

    let v = Vec::from_in([1, 2, 3], gpa);
    let w = Vec::from_in([1, 2, 4], gpa);
    println("vec {} {} array {} {}", v == v.clone(), v == w, [1u64, 2] == [1u64, 2],
        [1u64, 2] == [2u64, 1]);
    println("across {} {}", v == [1, 2, 3], v[..] == w[..]);
    println("ne {} {}", a[..] != a[..], a[1..] != a[..8]);
}
