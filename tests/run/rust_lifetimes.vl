// EDITION: rust
// (0.27.0) Lifetimes in the rust edition: a struct holding `&'a [u8]`,
// `impl<'a>`, a method returning `&'a [u8]` from `&mut self`, a function
// returning `Option<&'a T>`, `for p in v` over a slice, `&mut` elements,
// `if let` through `&mut`. Regions are kept, not checked yet (0.27.1).

#[derive(Debug, Clone, PartialEq)]
struct P<A: Allocator> {
    id: i64,
    name: String<A>,
}

struct Parser<'a> {
    src: &'a [u8],
    pos: usize,
}

impl<'a> Parser<'a> {
    fn new(src: &'a [u8]) -> Parser<'a> {
        Parser { src: src, pos: 0 }
    }

    fn peek(&self) -> Option<u8> {
        if self.pos < self.src.len() { Some(self.src[self.pos]) } else { None }
    }

    fn word(&mut self) -> &'a [u8] {
        let start = self.pos;
        while self.pos < self.src.len() && self.src[self.pos] != b' ' {
            self.pos += 1;
        }
        let w = &self.src[start..self.pos];
        if self.pos < self.src.len() {
            self.pos += 1;
        }
        w
    }
}

fn find<'a>(v: &'a [P<Gpa>], id: i64) -> Option<&'a P<Gpa>> {
    for p in v {
        if p.id == id {
            return Some(p);
        }
    }
    None
}

fn bump(v: &mut Vec<i64, Gpa>) {
    for x in v {
        *x += 1;
    }
}

fn rename(p: &mut P<Gpa>, gpa: Gpa) {
    p.name = String::from_in("renamed", gpa);
}

fn main(gpa: Gpa) -> i32 {
    let mut ps: Vec<P<Gpa>, Gpa> = Vec::new_in(gpa);
    ps.push(P { id: 1, name: String::from_in("a", gpa) });
    ps.push(P { id: 2, name: String::from_in("b", gpa) });
    match find(ps.as_slice(), 2) {
        Some(p) => println("found {} {}", p.id, p.name.as_str()),
        None => println("none"),
    }
    rename(&mut ps[0], gpa);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    bump(&mut v);
    let mut parser = Parser::new("ab cd ef");
    let w1 = parser.word();
    let w2 = parser.word();
    let mut n = 0;
    while let Some(c) = parser.peek() {
        if c == b' ' {
            break;
        }
        n += 1;
        parser.pos += 1;
    }
    let k = 10;
    let add = |x: i64| x + k;
    let mut o = Some(5);
    if let Some(x) = &mut o {
        *x += 1;
    }
    println("{} {:?} {} {} {} {} {:?}", ps[0].name.as_str(), v, w1.len(), w2[0], n, add(1), o);
    0
}
// EXPECT: found 2 b
// EXPECT: renamed [2, 3] 2 99 2 11 Some(6)
