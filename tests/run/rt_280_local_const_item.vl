// XFAIL: RT-280: a const item inside a function body is a parser error: "items cannot be nested in blocks" (0.30.2)
// rustc allows items in a block: a local `const` is a constant scoped to
// the block, named by the body and by a closure in it (`[L; 2]` makes
// each element from it). vole refuses `const L: D = ..;` in a body with a
// parser error. From g302copy's review form c28; v0.30.1 the same.
// EXPECT: len 2 2 7
// EXPECT: drop 7
// EXPECT: drop 7
// EXPECT: drop 7
// EXPECT: drop 7
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn main() {
    const L: D = D { k: 7 };
    let a = [L; 2];
    let f = || [L; 2];
    let b = f();
    println("len {} {} {}", a.len(), b.len(), b[1].k);
}
