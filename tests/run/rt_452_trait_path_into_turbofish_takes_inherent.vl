// XFAIL: RT-452: WRONG CODE: `Into::<B>::into(a)` with an inherent `fn into(self) -> B` on A runs the inherent one: v0.30.1 and the release build print `2 500` (a build of g302probe2 refused it instead: `'into' needs the type it converts to`); rustc calls <A as Into<B>>::into, From's (0.30.2)
// From g302probe2. rustc prints the EXPECT line (twin). RT-72 and RT-74 are
// other inherent methods taken for a trait's of the same name.
// EXPECT: 2 3
struct A {
    k: i64,
}

struct B {
    k: i64,
}

impl From<A> for B {
    fn from(a: A) -> B {
        B { k: a.k + 1 }
    }
}

impl A {
    fn into(self) -> B {
        B { k: 500 }
    }
}

fn main() {
    let b: B = B::from(A { k: 1 });
    let c = Into::<B>::into(A { k: 2 });
    println("{} {}", b.k, c.k);
}
