// RULE: C3.4
// (0.30.2, RT-38f) `result` of a function whose result type is an alias
// of a `&mut i64`: its view was chosen by the written type, so none, and
// the ensures wrote through it what the caller then reads.
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*result'
// ERROR-COUNT: 1
type R<'a> = &'a mut i64;

fn out<'a>(p: R<'a>) -> R<'a>
    ensures {
    *result = 9;
    true
}

{
    p
}

fn main() {
    let mut x = 1i64;
    let r = out(&mut x);
    println("{}", *r);
}
