// XFAIL: gap 7: compile parser error: expected expression, got 'mut'
// The sources' `exact_len` and `at` (0.14), and `sort_by` with named
// functions as the function argument (a function with pointer parameters
// as a value is unsafe). Their `fold`: iter_chain_fold_named.
// EXPECT: len 10 0 3 2 4 2
// EXPECT: at 5 7 30 11
// EXPECT: sorted 9 7 5 3 1 | 1 3 5 7 9 | 2 3 3 4 5 5
use std::collections::HashMap;

fn desc(a: i64, b: i64) -> i64 {
    b - a
}

fn asc(a: i64, b: i64) -> i64 {
    a - b
}

fn show(x: i64) {
    print(" ");
    print("{}", x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(10, 3);
    m.insert(20, 15);

    print("len");
    show(((0i64..10i64)).size_hint().0);
    show(((5i64..2i64)).size_hint().0);
    show(((3i64..=5i64)).size_hint().0);
    let mut r = 3i64..=4i64;
    r.next();
    r.next();
    show(r.size_hint().0 + 2);
    show(v.iter().copied().size_hint().0 - 1);
    show(m.iter().map(|(k, v)| (*k, *v)).size_hint().0);
    println("");

    print("at");
    let mut s = v.iter().copied();
    show(s.nth(0 as usize).unwrap());
    let mut ten = 0i64..10i64;
    show(ten.nth(7 as usize).unwrap());
    let mut big = 25i64..=30i64;
    show(big.nth(5 as usize).unwrap());
    let mut keys = m.keys().copied();
    let k0 = keys.nth(0 as usize).unwrap();
    let k1 = keys.nth(1 as usize).unwrap();
    show((k0 + k1) / 3 + 1);
    println("");

    print("sorted");
    unsafe { v.sort_unstable_by(|a, b| desc(*a, *b).cmp(&0)); }
    for x in v {
        show(x);
    }
    print(" |");
    unsafe { v.as_mut_slice().sort_unstable_by(|a, b| asc(a, b).cmp(&0)); }
    for x in v {
        show(x);
    }
    print(" |");
    let mut w = [3i64, 1, 4, 1, 5, 9, 2, 6, 5, 3];
    unsafe { mut w[..].sort_unstable_by(|a, b| asc(a, b).cmp(&0)); }
    for x in &w[2..8] {
        show(x);
    }
    println("");
    0
}
