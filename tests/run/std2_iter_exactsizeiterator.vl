// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter ExactSizeIterator.
// EXPECT: 4

fn n<I: ExactSizeIterator>(it: &I) -> usize {
    it.len()
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    println("{}", n(&v.iter()));
}
