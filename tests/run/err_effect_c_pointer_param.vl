// RULE: E1.8 (0.30.1) A C function given a pointer or a reference (a
// parameter that holds one, or C's `...`) may write through it, whatever
// builtin.vl's table says of it: it has the hidden `addr`, and a local
// whose borrow it is given keeps no proof. Before, memset was the table's
// C_NONE, and `memset(&d, 0, 8); x / d` passed #[no_panic], the loop
// form ended at -O2 only.
// ERROR: 'k' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'l' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR-COUNT: 2

extern "C" {
    fn memset(p: &u64, c: i32, n: usize);
}

#[no_panic]
#[effects(unsafe)]
fn k(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        // UNSAFE: the attack: C writes through a shared reference
        // SAFETY: d is live, 8 bytes
        unsafe {
            memset(&d, 0, 8);
        }
        x / d
    } else {
        0
    }
}

#[effects(unsafe)]
fn l(n: u64) -> u64 {
    let mut i: u64 = 0;
    while i < n {
        // UNSAFE: the attack: C writes through a shared reference
        // SAFETY: i is live, 8 bytes
        unsafe {
            memset(&i, 0, 8);
        }
        i += 1;
    }
    i
}

fn main() {
    println("{}", k(7, 1));
    println("{}", l(3));
}
