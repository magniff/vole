// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters MapWhile::impl Iterator.
// EXPECT: Some(10) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, -1, 2], gpa);
    let mut it = s.iter().map_while(|x| if *x > 0 { Some(x * 10) } else { None });
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
