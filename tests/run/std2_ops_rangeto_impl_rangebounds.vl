// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops RangeTo::impl RangeBounds.
// EXPECT: Unbounded Excluded(4) true false
use std::ops::{RangeBounds, RangeTo};

fn main() {
    let r: RangeTo<i64> = ..4;
    println("{:?} {:?} {} {}", r.start_bound(), r.end_bound(), r.contains(&-9), r.contains(&4));
}
