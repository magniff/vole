struct Pair(i64, i64);

fn make() -> impl Fn(i64) -> i64 {
    |x| x
}

trait Sized2 {
    const N: i64 = 2;
}

fn call<F: FnOnce() -> i64>(f: F) -> i64 {
    f()
}

fn write(p: *const i64) {
    unsafe {
        *p = 1;
    }
}

#[array_builtin(N)]
fn first(a: [i64; N]) -> i64 {
    a[0]
}

