// (0.27.0) What the rust edition reads and leaves to a later 0.27 release:
// one soft error each, syntax.later, with the feature and the release.
// ERROR: (impl_trait_nested) is not in the language yet: it comes in 0.29
// ERROR: cannot assign to '*p', which is behind a `*const` pointer
// (0.27.2: `#[array_builtin(N)]` is the rust edition's, tests/run/rust_f_f15_array_*.vl)
// (0.27.2: `Send` and `Sync` are the rust edition's, tests/run/rust_b_auto_*.vl)
// (0.27.1: `let x;` is the rust edition's now, tests/run/rust_deferred_init.vl)
struct Pair(i64, i64);

// (0.27.2.1: `-> impl Tr` at the top is the rust edition's, tests/run/rust_b_rpit_*.vl)
fn make() -> Option<impl Fn(i64) -> i64> {
    None
}

trait Sized2 {
    const N: i64 = 2;
}

fn call<F: FnOnce() -> i64>(f: F) -> i64 {
    f()
}

fn write(p: *const i64) {
    unsafe {
        *p = 1;
    }
}

trait Show {
    fn show(&self) -> i64;
}

struct Two<A, B> {
    a: A,
    b: B,
}

impl<T> Show for T {
    fn show(&self) -> i64 {
        1
    }
}

impl<T> Show for Two<T, i64> {
    fn show(&self) -> i64 {
        self.b
    }
}

fn flat<I: Iterator>(i: I) -> Option<<I::Item as IntoIterator>::IntoIter> {
    None
}

trait Holder {
    type Item;
}

struct Hold<I> {
    i: I,
}

impl<I: Iterator> Holder for Hold<I> {
    type Item = <I::Item as IntoIterator>::Item;
}

fn main() -> i32 {
    let x;
    let c = 'é';
    0
}
