// x >> 61 of a negative x is negative.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 8
static mut Z: i64 = 0;

#[inline(never)]
fn f(a: [i64; 8], x: i64) -> i64 { a[(x >> 61) as usize] }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(a, -1 + unsafe { Z }));
    0
}
