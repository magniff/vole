// XFAIL: RT-359b: (RT-359's mechanism, the hole decided by the argument) in a generic body, `<T as Conv<_, u8>>::c(true)` and `<T as Conv<_, u8>>::c(5i32)` under `T: Conv<bool, i64> + Conv<bool, u8> + Conv<i32, u8>` are refused ("'S::c' is ambiguous for arguments (bool)", then "expected 'bool', got 'i32'"); the `_` is the argument's type, rustc prints 231 (0.30.2)
// From the paused g302qual work (PAUSED.md, findings not mine, 1: form
// f4/w18_hole_args_decide_generic). Since v0.30.1 at least (v0.30.1 the
// same two errors). RT-359 is the hole decided by the expected type.
// EXPECT: 231
trait Conv<A, B> {
    fn c(x: A) -> i64;
}

struct S;

impl Conv<bool, i64> for S {
    fn c(x: bool) -> i64 {
        1
    }
}

impl Conv<bool, u8> for S {
    fn c(x: bool) -> i64 {
        2
    }
}

impl Conv<i32, u8> for S {
    fn c(x: i32) -> i64 {
        3
    }
}

fn k<T: Conv<bool, i64> + Conv<bool, u8> + Conv<i32, u8>>() -> i64 {
    <T as Conv<_, u8>>::c(true) * 100 + <T as Conv<_, u8>>::c(5i32) * 10 + <T as Conv<_,
        i64>>::c(false)
}

fn main() {
    println("{}", k::<S>());
}
