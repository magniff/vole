// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::cmp Ordering::then_with.
// EXPECT: Less Greater 1
use std::cmp::Ordering;

fn main() {
    let mut calls = 0;
    let a = Ordering::Equal.then_with(|| {
        calls += 1;
        Ordering::Less
    });
    let b = Ordering::Greater.then_with(|| {
        calls += 1;
        Ordering::Less
    });
    println("{:?} {:?} {}", a, b, calls);
}
