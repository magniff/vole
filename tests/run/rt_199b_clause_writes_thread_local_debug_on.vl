// writing a thread-local static is refused (impure_bit's tls).
// FLAGS: --debug-contracts
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'bump', which touches a thread-local static
// A clause's callee writes a thread-local static directly.
#[thread_local]
static mut T: i64 = 0;

fn bump() -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { T += 1; }
    true
}

fn f(n: i64) -> i64
    debug requires bump()
{
    n
}

fn main() {
    println("{}", f(1));
    // UNSAFE: test
    // SAFETY: test
    println("{}", unsafe { T });
