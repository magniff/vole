// XFAIL: RT-TL-20: an impl whose header is a generic type alias, impl<X> T for P<X>, implements nothing and says nothing (open)
// type P<X> = W<X>; impl<X> T for P<X> { .. }: the impl is accepted, but
// W<u8> has no method 'm' ("no method 'm' on type 'W<u8>'" at the call).
// Written impl<X> T for W<X> it works; a non-generic alias, type R =
// W<u8>; impl R { .. }, works. Two such impls through different generic
// aliases are reported as overlapping (trait.overlap) though their types
// differ, and one through type Q<X> = (X, i64) does not overlap a concrete
// impl T for (u8, i64).
// EXPECT: 1 5 6
trait T {
    fn m(&self) -> i64;
}

struct W<X> {
    x: X,
}

type P<X> = W<X>;

impl<X> T for P<X> {
    fn m(&self) -> i64 {
        1
    }
}

impl W<u8> {
    fn own(&self) -> i64 {
        5
    }
}

type R = W<u8>;

impl R {
    fn other(&self) -> i64 {
        6
    }
}

fn main() -> i32 {
    let w = W { x: 1u8 };
    println("{} {} {}", w.m(), w.own(), w.other());
    0
}
