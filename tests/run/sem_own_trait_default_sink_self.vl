// sem-own: a trait default method with `sink self` calling a let-self method: dropped once at its end.
// EXPECT: drop 1
// EXPECT: 2
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
trait T2 { fn id2(self) -> i64; fn consume(sink self) -> i64 { 2 * self.id2() } }
impl T2 for D<Gpa> { fn id2(self) -> i64 { self.id } }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    println("{}", a.consume());
    println("end");
}
