// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str ParseFloatError.
// EXPECT: true true
use std::str::ParseFloatError;

fn main() {
    let e: ParseFloatError = "1.2.3".parse::<f64>().unwrap_err();
    let f: ParseFloatError = "".parse::<f64>().unwrap_err();
    println("{} {}", e == e.clone(), e != f);
}
