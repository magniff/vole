// RULE: F34.4 (0.30.2, RT-302) The other ways out of a constant's value,
// each refused where it is written (rustc E0268, E0572): `continue` and a
// labeled `break` from a constant used inside a loop of the using
// function, and a `return` in a constant reached through an associated
// constant. What stays inside the value is accepted: a loop of its own
// with its `break`, a closure of its own with its `return`.
// ERROR: line 31
// ERROR: line 33
// ERROR: line 38
// ERROR-COUNT: 3
struct D {
    k: i64,
}

fn f() -> bool {
    true
}

const OK: D = {
    let mut n = 0;
    loop {
        n += 1;
        if n == 3 {
            break;
        }
    }
    let g = |x: i64| -> i64 { return x * 2; };
    D { k: g(n) }
};

const K: D = { if f() { continue; } D { k: 1 } };

const L: D = { if f() { break 'outer; } D { k: 2 } };

struct S;

impl S {
    const R: D = { if f() { return; } D { k: 3 } };
}

fn main() {
    println("{}", OK.k);
    'outer: for _ in 0..2 {
        let k = K;
        let l = L;
        println("{} {}", k.k, l.k);
    }
    let r = S::R;
    println("{}", r.k);
}
