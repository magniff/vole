// RULE: C3.4
// (0.30.2, review of RT-38g) A clause writing its own local array through a `&mut [T]` and
// `iter_mut`. A write through a pointer made of
// a `&mut` the clause holds is a `&mut` write, not a raw one: only a write
// through what the clause did not make is refused (effects/provenance.vl).
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
fn f(n: i64) -> i64
    requires {
    let mut a = [n, 1];
    let s: &mut [i64] = &mut a;
    s[0] = 7;
    for x in s.iter_mut() {
        *x += 1;
    }
    a[0] == 8
}

{
    n
}

fn main() {
    println("{}", f(3));
}
