// RULE: C3.4
// (0.30.2, review of RT-38g) A clause writing its own local array through a `&mut [T]` and
// `iter_mut`. A callee's raw write is refused only
// when a raw pointer may reach it from what the clause reads (a
// parameter's or the result's type holds one, contracts::raw_inputs).
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
fn f(n: i64) -> i64
    requires {
    let mut a = [n, 1];
    let s: &mut [i64] = &mut a;
    s[0] = 7;
    for x in s.iter_mut() {
        *x += 1;
    }
    a[0] == 8
}
{
    n
}
fn main() {
    println("{}", f(3));
}
