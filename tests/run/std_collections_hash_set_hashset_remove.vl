// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_set HashSet::remove.
// EXPECT: true false 0
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(5);
    let a = s.remove(&5);
    let b = s.remove(&5);
    println("{} {} {}", a, b, s.len());
}
