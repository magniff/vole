// `start<T: FnOnce() -> usize + Send>` (no 'static) passes t to
// thread::spawn_in, whose F is 'static. rustc rejects start (E0310: the
// parameter type T may not live long enough). vole accepts the template,
// and the instance start<closure> does not see that the closure holds a
// borrow of s: the thread runs on after s is dropped at the block's end and
// reads its freed bytes (--check-alloc: "use after free: block #1 (20
// bytes), allocated at main.vl:25:17, freed at main.vl:34:5"). The same
// hole without threads: `fn pass<T>(t: T) -> T { need(t) }` for
// `need<T: 'static>`, and `fn mk<T>(t: T) -> Keep<T>` for `struct Keep<T:
// 'static>`, are accepted.
// ERROR: error[borrowck.param_outlives]
// ERROR: line 18, column 5
// ERROR-COUNT: 1
use std::thread;
use std::thread::JoinHandle;

fn start<T: FnOnce() -> usize + Send>(t: T, gpa: Gpa) -> JoinHandle<usize, Gpa> {
    thread::spawn_in(t, gpa)
}

fn main(gpa: Gpa) {
    let h;
    {
        let s = String::from_in("a string on the heap", gpa);
        let r = s.as_str();
        h = start(move || {
            let mut n = 0;
            for _ in 0..2000000 {
                n += r.len();
            }
            n + r.as_bytes()[0] as usize
        }, gpa);
    }
    println("{}", h.join().unwrap());
}
