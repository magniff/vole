// EDITION: rust
// RULE: E4.4a
// (0.27.2.1) A Vec on Gpa frees at its drop (Gpa's FREES is the trait's
// default, true): a function that drops one allocates from Gpa.
// ERROR: 'drop_on_gpa' is #[no_alloc], but it allocates from Gpa
use std::vec::Vec;

#[no_alloc]
fn drop_on_gpa(v: Vec<i64, Gpa>) -> usize {
    v.len()
}

fn main(gpa: Gpa) {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2);
    println("{}", drop_on_gpa(w));
}
