// FLAGS: --check-alloc
// EXIT: 101
// STDERR: use after free: block #1 (32 bytes), allocated at
// STDERR: checkalloc_places_drop_site.vl:15:5, freed at
// STDERR: checkalloc_places_drop_site.vl:20:5
// (0.26.1) --check-alloc's freed-at site of a drop the places IR runs
// through its type's drop shim: the drop's own position (here the inner
// block's `}`, where `w` is dropped). Before, the shim stored a site of its
// own (the file's 1:1) at -O1 and -O2, and at -O0 the drop stored none (the
// last call's, the push's, was reported). The AST walk, VOLE_LOWER=ast,
// reports the `let`'s binding instead (19:13). Book chapter 8's `drop(v)`
// case is the call's position under both.
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(7);
    let p = v.as_slice().ptr;
    {
        let w = v;
    }
    let x = unsafe { p[0] };
    println(x);
}
