// (0.30.2, the re-review of g302holes: r91/r02_tuple)
// EXPECT: 8 18
// A closure returning a tuple of closures, one holding an iterator with a closure.
fn main() {
    let v = [1i64, 2, 3];
    let mk = |m: i64| (move |x: i64| x * m, v.iter().map(move |x| x + m));
    let (f, it) = mk(4);
    let s: i64 = it.sum();
    println("{} {}", f(2), s);
}
