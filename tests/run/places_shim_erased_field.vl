// 0.26.2 (R11): a drop's shim is found by its type with its distinct
// types erased. Option<(str, Holder)>::unwrap drops `(self as Some).0`
// under a flag; the shim was asked for `(str, Holder)` while the IR was
// built, and the code generators, which read the field's type after
// erase_program_types, looked for `([u8], Holder)`: none was found, and
// the body went back to the AST lowering. --verify-places checks the
// lookup (shim.vl shim_found); --check-alloc that the Holder is freed.
// FLAGS: --verify-places --check-alloc
// EXPECT: a 3
// EXPECT: b 2
struct Holder {
    v: Vec<i64>,
}

fn pair(gpa: Gpa, name: str, n: i64) -> Option<(str, Holder)> {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    Some((name, Holder { v: v }))
}

fn main(gpa: Gpa) {
    let (s, h) = pair(gpa, "a", 3).unwrap();
    println(f"{s} {h.v.len()}");
    let p = pair(gpa, "b", 2).unwrap();
    println(f"{p.0} {p.1.v.len()}");
}
