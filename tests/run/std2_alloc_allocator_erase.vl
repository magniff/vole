// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Allocator::erase.
// EXPECT: [3]
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let a = gpa.erase();
    let mut v: Vec<i64, std::alloc::AnyAlloc<'_>> = Vec::new_in(a);
    v.push(3);
    println("{:?}", v);
}
