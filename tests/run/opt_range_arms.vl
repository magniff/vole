// 0.30: the ranges decide a comparison of a value an `if` left (a phi of
// a block no back edge enters, or a select) by its values one by one,
// and a test of a difference for zero as an inequality; x - 1 is below
// an unsigned x that is not zero. The safe `swap(i, j)` of a slice whose
// indices were checked keeps no check (split_at_mut at the larger index,
// then `a[lo]` and `b[0]`), nor does `s[s.len() - 1]` of a slice that is
// not empty; an index that is the larger of two of which one was checked
// keeps its check. (The cases are decided by the facts that compare the
// same two values, not by ranges: larger_checked, whose two checks come
// after the `if`, is only run.)
// EXPECT: 9 8 7 6 4 5 3 2 1 0
// EXPECT: 0 -1 7 7 -1 6
// CHECK: fn swap_checked:
// CHECK-NOT: panic
// CHECK: fn last:
// CHECK-NOT: panic
// CHECK: fn larger_checked:
// CHECK: fn one_checked:
// CHECK: rt.panic
// CHECK: fn main:
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

#[inline(never)]
fn swap_checked(s: &mut [i64], i: usize, j: usize) {
    if i < s.len() && j < s.len() {
        s.swap(i, j);
    }
}

#[inline(never)]
fn last(s: &[i64]) -> i64 {
    if s.len() != 0 { s[s.len() - 1] } else { -1 }
}

#[inline(never)]
fn larger_checked(s: &[i64], i: usize, j: usize) -> i64 {
    let hi = if i < j { j } else { i };
    if i < s.len() && j < s.len() { s[hi] } else { -1 }
}

#[inline(never)]
fn one_checked(s: &[i64], i: usize, j: usize) -> i64 {
    let hi = if i < j { j } else { i };
    if i < s.len() { s[hi] } else { -1 }
}

fn main() -> i32 {
    let mut a = [0i64, 1, 2, 3, 4, 5, 6, 7, 8, 9];
    swap_checked(&mut a, 0, 9);
    swap_checked(&mut a, 8, 1);
    swap_checked(&mut a, 3, 7);
    swap_checked(&mut a, 7, 3);
    swap_checked(&mut a, 2, 2);
    swap_checked(&mut a, 6, 3);
    swap_checked(&mut a, 3, 10);
    swap_checked(&mut a, 11, 4);
    swap_checked(&mut a, 2, 7);
    unsafe {
        printf(c"%ld %ld %ld %ld %ld %ld %ld %ld %ld %ld\n", a[0], a[1], a[2], a[3], a[4], a[5],
            a[6], a[7], a[8], a[9]);
        printf(c"%ld %ld %ld %ld %ld %ld\n", last(&a), last(&a[..0]), larger_checked(&a, 2, 7) + 5,
            one_checked(&a, 2, 1), larger_checked(&a, 3, 10), one_checked(&a[..5], 1, 3));
    }
    0
}
