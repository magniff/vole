// least. From the review of the type-parameter work.
// ERROR: line 10
use std::mem::size_of;
trait Tr { type Out; }
trait Sub: Tr {}
impl Tr for u8 { type Out = i64; }
impl Sub for u8 {}
fn g<T: Sub>(t: T) -> usize { size_of::< <T as Sub>::Out>() }

fn main() {
    println("{}", g(1u8));
