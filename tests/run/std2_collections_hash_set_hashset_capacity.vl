// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set HashSet::capacity.
// EXPECT: true
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    for i in 0..50i64 {
        s.insert(i);
    }
    println("{}", s.capacity() >= 50);
}
