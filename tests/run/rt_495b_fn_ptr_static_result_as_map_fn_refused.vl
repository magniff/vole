// XFAIL: RT-495b: (RT-495, a fn pointer) `let f: fn(&i64) -> &'static i64 = st;` as MyMap's F, then `drop(v)` before the result's use, is refused (borrowck.move_borrowed): the pointer type's 'static output is read by elision; rustc prints `Some(7)` (0.30.2)
// From the third re-review of the borrow-check work (g302bor2).
// EXPECT: Some(7)
static SEVEN: i64 = 7;

fn st(_x: &i64) -> &'static i64 {
    &SEVEN
}

struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let f: fn(&i64) -> &'static i64 = st;
    let r = MyMap { i: v.iter(), f: f }.next();
    drop(v);
    println("{:?}", r);
}
