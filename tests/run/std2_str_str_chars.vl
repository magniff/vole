// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::chars.
// EXPECT: 3 olé
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "éxo";
    let mut n = 0;
    for _ in s.chars() {
        n += 1;
    }
    let mut r = String::new_in(gpa);
    for c in "élo".chars().rev() {
        r.push(c);
    }
    println("{} {}", n, r);
}
