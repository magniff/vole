// EDITION: rust
// RULE: D3.6a
// (0.27.7) What rustc accepts where a raw pointer is written outside a
// call or a `let`: `&mut T` to a `*mut T` field, result and assigned
// place, `&T` to the same positions written `*const T`. Prints 1 7 1.
// FLAGS: --verify-places
// EXPECT: 1 7 1
struct M {
    p: *mut i64,
}

struct C {
    p: *const i64,
}

fn tail(x: &mut i64) -> *mut i64 {
    x
}

fn ret(x: &mut i64) -> *mut i64 {
    return x;
}

fn view(x: &i64) -> *const i64 {
    x
}

fn main() {
    let mut a = 1i64;
    let mut b = 2i64;
    let c = 1i64;
    let mut m = M { p: &mut a };
    m.p = &mut b;
    let mut p: *mut i64 = tail(&mut a);
    p = ret(&mut b);
    let pp: *mut *mut i64 = &mut p;
    // UNSAFE: the test's raw pointers
    // SAFETY: pp points to p and p to b, both live; no reference to either is held here
    unsafe {
        *pp = &mut b;
        *m.p += 3;
        **pp += 2;
    }
    let mut k = C { p: &c };
    k.p = view(&c);
    // UNSAFE: the test's raw pointers
    // SAFETY: k.p points to c, live, only read here
    let r = unsafe { *k.p };
    println("{} {} {}", a, b, r);
}
