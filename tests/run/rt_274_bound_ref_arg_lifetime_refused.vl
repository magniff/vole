// XFAIL: RT-274: `fn mid<'a, T: Tr<&'a str>>(t: &T) -> &'a str { call3(t) }` with `call3<'c, Z: Tr<&'c str>>` is refused (borrowck.outlives); rustc builds it (0.30.2)
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// rustc builds it and prints hi. vole: "the lifetime of 'z' must outlive
// 'c" in call3, whose body returns `z.g()`, a `&'c str` by Tr<&'c str>'s
// signature: the trait argument's region is not the one the method's
// result has.
// EXPECT: hi
trait Tr<U> {
    fn g(&self) -> U;
}

struct W<'a> {
    r: &'a str,
}

impl<'a> Tr<&'a str> for W<'a> {
    fn g(&self) -> &'a str {
        self.r
    }
}

fn call3<'c, Z: Tr<&'c str>>(z: &Z) -> &'c str {
    z.g()
}

fn mid<'a, T: Tr<&'a str>>(t: &T) -> &'a str {
    call3(t)
}

fn main() {
    let s = "hi";
    println("{}", mid(&W { r: s }));
}
