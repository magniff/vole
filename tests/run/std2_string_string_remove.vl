// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::remove.
// EXPECT: b ac
// EXIT: 101

fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    let c = s.remove(1);
    println("{} {}", c, s);
    s.remove(2);
}
