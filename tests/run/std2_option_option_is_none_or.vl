// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::is_none_or.
// EXPECT: true false true
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b: Option<i64> = None;
    println("{} {} {}", a.is_none_or(|x| x > 1), a.is_none_or(|x| x > 5), b.is_none_or(|x| x > 5));
}
