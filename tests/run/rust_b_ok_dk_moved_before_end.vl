// EDITION: rust
// RULE: D9.2
// (0.27.1) A holder moved into `drop` before the scope's end: its drop is
// removed there.
// Checked since bc271 M3.

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut h = HD { r: &z };
    let x: i64 = 1;
    h = HD { r: &x };
    drop(h);
    println("{}", x);
}
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: 1
// XFAIL: a user Drop never runs on std2: no drop elaboration (clos272)
