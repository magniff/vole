// XFAIL: gap 2: errors at other places or codes: MVS own.conflict@48:5; own.conflict@55:5; own.conflict@62:5; own.conflict@...
// 0.25.3 (the round 3 eval's ocean): a mapped buffer's view lives until
// unmap, and unmap takes the buffer `inout`, so unmapping while a view
// of it is still used is own.conflict: the buffer cannot be written
// again (a copy into it) under the view. Through gpu::f32s too: its
// #[views(b)] is a cast (bytes viewed as f32s), which the type filter
// used to drop, so the f32s view viewed nothing. And through functions
// of the program's own with no #[views]: inference keeps the cast's loan
// (`floats` is views(buf)), through a local, a call of a function that
// passes a slice on, a wrapper of the wrapper, and a struct holding it.
// ERROR: 'r.unmap(dev)' may change 'r' while 'v'
// ERROR: 'r.unmap(dev)' may change 'r' while 'f'
// ERROR: 'r.unmap(dev)' may change 'r' while 'w'
// ERROR: 'r.unmap(dev)' may change 'r' while 'n'
// ERROR: 'r.unmap(dev)' may change 'r' while 'h'
// ERROR-COUNT: 5
use std::gpu;
use std::gpu::BufferUsage;

fn floats(buf: &mut gpu::Buffer, dev: &gpu::Device<Gpa>) -> &[f32] {
    gpu::f32s(buf.map_read(dev))
}

fn tail(s: &[f32]) -> &[f32] {
    &s[1..]
}

fn floats_tail(buf: &mut gpu::Buffer, dev: &gpu::Device<Gpa>) -> &[f32] {
    let b = buf.map_read(dev);
    let all = gpu::f32s(b);
    tail(all)
}

fn nested(buf: &mut gpu::Buffer, dev: &gpu::Device<Gpa>) -> &[f32] {
    floats_tail(buf, dev)
}

#[derive(Clone, Copy)] struct Held<'a> {
    xs: &'a [f32],
}

fn held(buf: &mut gpu::Buffer, dev: &gpu::Device<Gpa>) -> Held<'_> {
    Held { xs: gpu::f32s(buf.map_read(dev)) }
}

fn bytes(dev: &gpu::Device<Gpa>) {
    let mut r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let v = r.map_read(dev);
    r.unmap(dev);
    println("{}", v[0]);
}

fn numbers(dev: &gpu::Device<Gpa>) {
    let mut r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let f = gpu::f32s(r.map_read(dev));
    r.unmap(dev);
    println("{}", f[0]);
}

fn wrapped(dev: &gpu::Device<Gpa>) {
    let mut r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let w = floats(&mut r, dev);
    r.unmap(dev);
    println("{}", w[0]);
}

fn wrapped_twice(dev: &gpu::Device<Gpa>) {
    let mut r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let n = nested(&mut r, dev);
    r.unmap(dev);
    println("{}", n[0]);
}

fn in_a_struct(dev: &gpu::Device<Gpa>) {
    let mut r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let h = held(&mut r, dev);
    r.unmap(dev);
    println("{}", h.xs[0]);
}

fn main(gpa: Gpa) -> Result<(), gpu::Error<Gpa>> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, mut _queue) = inst.adapter(Power::High)?.device(Limits::default())?;
    bytes(&dev);
    numbers(&dev);
    wrapped(&dev);
    wrapped_twice(&dev);
    in_a_struct(&dev);
    Ok(())
}
