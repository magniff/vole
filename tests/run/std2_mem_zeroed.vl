// EDITION: rust
// The std2 item(s): std::mem zeroed.
// EXPECT: 0 0 false [0, 0, 0]
// EXPECT: 7
#[repr(C)]
struct Termios {
    flags: u64,
    cc: [u8; 3],
    speed: i32,
}

fn main() {
    // UNSAFE: mem::zeroed makes a value from zero bytes.
    // SAFETY: Termios is integers and bytes: all zeros is one of its values.
    let mut t: Termios = unsafe { std::mem::zeroed() };
    // UNSAFE: as above.
    // SAFETY: false is the zero byte.
    let b: bool = unsafe { std::mem::zeroed() };
    println("{} {} {} {:?}", t.flags, t.speed, b, t.cc);
    t.speed = 7;
    println("{}", t.speed);
}
