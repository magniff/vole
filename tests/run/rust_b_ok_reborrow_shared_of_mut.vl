// EDITION: rust
// RULE: D3.6
// (0.27.1) A shared reborrow of a `&mut`, dead before the next write through
// it.

fn main() {
    let mut x: i64 = 1;
    let m = &mut x;
    let q = &*m;
    println("{}", *q);
    *m += 1;
    println("{}", x);
}
// EXPECT: 1
// EXPECT: 2
