// sem-own: BinaryHeap push/pop of owned values: each dropped once.
// EXPECT: pop 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
impl Eq for D<Gpa> { fn eq(self, other: D<Gpa>) -> bool { self.id == other.id } }
impl Ord for D<Gpa> { fn cmp(self, other: D<Gpa>) -> i64 { self.id - other.id } }

fn main(gpa: Gpa) {
    var h: std::BinaryHeap<D<Gpa>, Gpa> = std::BinaryHeap::new_in(gpa);
    h.push(mk(1, gpa));
    h.push(mk(2, gpa));
    { let p = h.pop(); if let Some(d) = p { println("pop {}", d.id); } }
    println("end");
}
