// rustc accepts both functions (a closure that owns a D, an iterator that
// holds one) and prints the EXPECT lines. vole refuses each with
// `1:1: error[distinct.kind] a distinct type is over a plain type: 'It' owns
// memory`, a message about a construct the program does not have, at a
// position that is not the function's; its help proposes `struct impl
// Iterator<Item = i64> { v: It }`. A closure that captures a Vec passes the
// same check, so it is not "owns memory" that is tested. Not in guide rust.
// EXPECT: drop D3
// EXPECT: got 30
// EXPECT: 11
// EXPECT: 10
// EXPECT: drop D10
// EXPECT: end
// EXPECT: drop D3
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop D{}", self.k);
    }
}

struct It {
    d: D,
    n: i64,
}

impl Iterator for It {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n > 0 {
            self.n -= 1;
            Some(self.n + self.d.k)
        } else {
            None
        }
    }
}

fn val(d: &D) -> i64 {
    d.k
}

fn make_fn() -> impl Fn() -> i64 {
    let d = D { k: 3 };
    move || val(&d) * 10
}

fn make_iter() -> impl Iterator<Item = i64> {
    It { d: D { k: 10 }, n: 2 }
}

fn main() {
    let f = make_fn();
    drop(make_fn());
    println("got {}", f());
    for x in make_iter() {
        println("{x}");
    }
    println("end");
}
