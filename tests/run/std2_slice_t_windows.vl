// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::windows.
// EXPECT: [1, 2] [2, 3] None
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3];
    let mut w = s.windows(2);
    println("{:?} {:?} {:?}", w.next().unwrap(), w.next().unwrap(), w.next());
}
