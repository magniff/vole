// rustc prints the EXPECT line (twin .rs.txt). vole reports 2 errors: at
// line 44 (Get's `&Self::Output`) and at <std>:622:49 (IndexMut's).
// v0.28.0 to v0.30.1 the same (v0.28.0 at <std>:609). Index with Mul
// without IndexMut is right. In a trait's own signature `Self::Output` is
// the supertrait's associated type (the only Output in scope there), so
// the projection is resolved by its name over every trait the type
// implements instead of through the trait's supertraits.
// EXPECT: 20 40 M { a: [2, 40, 6, 8] } 9
use std::ops::{Add, Index, IndexMut, Mul};

#[derive(Clone, Copy, Debug)]
struct M {
    a: [i64; 4],
}

impl Index<usize> for M {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a[i]
    }
}

impl IndexMut<usize> for M {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.a[i]
    }
}

impl Mul<i64> for M {
    type Output = M;

    fn mul(self, r: i64) -> M {
        let mut m = self;
        for i in 0..4 {
            m.a[i] *= r;
        }
        m
    }
}

trait Get: Index<usize> {
    fn get0(&self) -> &Self::Output;
}

struct P {
    v: i64,
}

impl Index<usize> for P {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.v
    }
}

impl Add<i64> for P {
    type Output = bool;

    fn add(self, r: i64) -> bool {
        true
    }
}

impl Get for P {
    fn get0(&self) -> &i64 {
        &self[0]
    }
}

fn main() {
    let mut m = M { a: [1, 2, 3, 4] };
    m[1] = 20;
    let n = m * 2i64;
    let p = P { v: 9 };
    println("{} {} {:?} {}", m[1], n[1], n, p.get0());
}
