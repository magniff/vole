// sem-own: a trait method `fn put(inout self, x: sink Self::Item)` through a generic: the item dropped once.
// EXPECT: n 1
// EXPECT: drop 7
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
trait Sinkish { type Item; fn put(inout self, x: sink Self::Item); fn n(self) -> i64; }
struct Bag<A: Allocator> { v: Vec<D<A>, A> }

impl Sinkish for Bag<Gpa> {
    type Item = D<Gpa>;
    fn put(inout self, x: sink D<Gpa>) { self.v.push(x); } fn n(self) -> i64 { self.v.len() as i64 }
}

fn fill<S: Sinkish>(s: inout S, x: sink S::Item) { s.put(x); }

fn main(gpa: Gpa) {
    var b = Bag { v: Vec::new_in(gpa) };
    fill(&b, mk(7, gpa));
    println("n {}", b.n());
}
