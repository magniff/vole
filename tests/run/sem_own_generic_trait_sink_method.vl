// sem-own: a trait method `fn put(inout self, x: sink Self::Item)` through a generic: the item dropped once.
// EXPECT: n 1
// EXPECT: drop 7
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
trait Sinkish { type Item; fn put(&mut self, x: Self::Item); fn n(&self) -> i64; }
struct Bag<A: Allocator> { v: Vec<D<A>, A> }

impl Sinkish for Bag<Gpa> {
    type Item = D<Gpa>;
    fn put(&mut self, x: D<Gpa>) { self.v.push(x); } fn n(&self) -> i64 { self.v.len() as i64 }
}

fn fill<S: Sinkish>(s: &mut S, x: S::Item) { s.put(x); }

fn main(gpa: Gpa) {
    let mut b = Bag { v: Vec::new_in(gpa) };
    fill(&mut b, mk(7, gpa));
    println("n {}", b.n());
}
