// XFAIL: RT-164: a static of a user type with `unsafe impl Sync` is refused (sync.static ignores the impl; the thread checks honour it) (0.30.2)
// rustc builds it and prints 42 (twin: r302d_010_static_user_sync_impl_refused.rs.txt).
// vole: `error[sync.static] the static 'S' is not Sync: Once holds a cell
// (std::cell), which is not Sync at '.v' (UnsafeCell<i64>)`, though the
// program vouches with `unsafe impl Sync for Once`; std's Mutex in a static
// passes, and the same impl lets `thread::scope` share `&Once`
// (front/threads.vl check_static_cells: holds(t, M_SYNC) does not see a
// program's impl). Since v0.28.0.
// EXPECT: 42
use std::cell::UnsafeCell;
use std::sync::atomic::{AtomicBool, Ordering};

struct Once {
    done: AtomicBool,
    v: UnsafeCell<i64>,
}

// UNSAFE: v is written once, by the thread that sets done first
// SAFETY: done's swap gives one writer; readers read after it with Acquire
unsafe impl Sync for Once {}

static S: Once = Once { done: AtomicBool::new(false), v: UnsafeCell::new(0) };

fn main() {
    if !S.done.swap(true, Ordering::AcqRel) {
        // UNSAFE: the one write of v
        // SAFETY: only the thread that swapped done from false writes it
        unsafe {
            *S.v.get() = 42;
        }
    }
    // UNSAFE: a read of v after it was written
    // SAFETY: done is true and its writer finished before this read on this thread
    let x = unsafe { *S.v.get() };
    println("{x}");
}
