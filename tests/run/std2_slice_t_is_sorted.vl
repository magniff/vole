// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice [T]::is_sorted.
// EXPECT: true false true

fn main() {
    let a: &[i64] = &[1, 2, 2, 5];
    let b: &[i64] = &[2, 1];
    let e: &[i64] = &[];
    println("{} {} {}", a.is_sorted(), b.is_sorted(), e.is_sorted());
}
