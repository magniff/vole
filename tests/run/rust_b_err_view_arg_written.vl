// XFAIL: a `&mut [T]` place given to a call is copied, not reborrowed: a later argument that writes through it is accepted (0.30.1, seen by the review of the hidden bindings)
// RULE: D3.6
// rustc reborrows a `&mut [T]` argument (`&mut *s`, two-phase), so a later
// argument that writes through s is E0506; vole copies the view into the
// call (lower_arg), and the copy's region is not a loan on s: both views
// write the same memory. With a `requires` it is refused (0.30.1: its
// binding is the reborrow `&mut s[..]`); the plain call is the XFAIL.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 25, column 20
// ERROR: error[borrowck.assign_borrowed]
// ERROR-COUNT: 2
fn g(s: &mut [i64], k: usize) -> i64
    requires k < 100
{
    s[0] + k as i64
}

fn h(s: &mut [i64], k: usize) -> i64 {
    s[0] + k as i64
}

fn main() {
    let mut a = [1i64, 2];
    let s: &mut [i64] = &mut a;
    let r = g(s, { s[0] = 5; 0 });
    let q = h(s, { s[0] = 6; 0 });
    println("{} {}", r, q);
}
