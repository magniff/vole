// RULE: D3.6
// rustc reborrows a `&mut [T]` argument (`&mut *s`, two-phase), so a later
// argument that writes through s is E0506. (0.30.1) So does vole, with and
// without a `requires` (lower_arg's implicit reslice, the contract's
// binding). Before, the view was copied into the call and both views
// wrote the same memory.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 24, column 20
// ERROR: error[borrowck.assign_borrowed]
// ERROR-COUNT: 2
fn g(s: &mut [i64], k: usize) -> i64
    requires k < 100
{
    s[0] + k as i64
}

fn h(s: &mut [i64], k: usize) -> i64 {
    s[0] + k as i64
}

fn main() {
    let mut a = [1i64, 2];
    let s: &mut [i64] = &mut a;
    let r = g(s, { s[0] = 5; 0 });
    let q = h(s, { s[0] = 6; 0 });
    println("{} {}", r, q);
}
