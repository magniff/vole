// RULE: D3.6
// (0.27.1) A reborrow of a field through `&'a mut S` returned for `'a`.

struct S {
    x: i64,
    y: i64,
}

fn f<'a>(s: &'a mut S) -> &'a mut i64 {
    &mut s.x
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = f(&mut s);
    *r += 5;
    println("{}", s.x);
}
// EXPECT: 6
