// XFAIL: RT-82: `Err(e)?;` and `None?;` as statements are refused with type.infer (0.30.2)
// rustc accepts both (the Ok/Some type of an expression whose value is
// never used is not needed) and prints the EXPECT lines. vole: `error[type.infer]
// cannot infer type parameter 'T' of 'Result'` with `try: Result::<T>::Err(...)`,
// which names the placeholder T (and one of Result's two parameters), and the
// same for `None?`. The same `Err(..)?` in an if's branch whose other branch is
// an i64 (h) is accepted.
// EXPECT: Ok(4) Err(E { k: -1 })
// EXPECT: Some(3) None
// EXPECT: Ok(2) Err(E { k: -3 })
#[derive(Debug)]
struct E {
    k: i64,
}

fn f(n: i64) -> Result<i64, E> {
    if n < 0 {
        Err(E { k: n })?;
    }
    Ok(n * 2)
}

fn g(n: i64) -> Option<i64> {
    if n < 0 {
        None?;
    }
    Some(n + 1)
}

fn h(n: i64) -> Result<i64, E> {
    let v: i64 = if n < 0 { Err(E { k: n })? } else { n };
    Ok(v)
}

fn main() {
    println("{:?} {:?}", f(2), f(-1));
    println("{:?} {:?}", g(2), g(-1));
    println("{:?} {:?}", h(2), h(-3));
}
