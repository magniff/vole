// EXPECT: 1 2
use std::alloc::Allocator; #[derive(Clone)]
enum E<A: Allocator> { A(Vec<i64, A>), B }
fn len(e: &E<Gpa>) -> i64 { match e { E::A(v) => v.len() as i64, E::B => 0 } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    let a = E::A(v); let mut b = a.clone();
    match &mut b { E::A(w) => { w.push(2); } E::B => {} }
    println("{} {}", len(&a), len(&b));
}
