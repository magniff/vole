// From the g302qual review (form f15_generic_struct_impls).
// EXPECT: 1 2 20 10 1
trait A { const K: i64; fn m(&self) -> i64; }
trait B { const K: i64; fn m(&self) -> i64; }
struct W<T> { t: T }
impl<T> A for W<T> { const K: i64 = 1; fn m(&self) -> i64 { 10 } }
impl B for W<i64> { const K: i64 = 2; fn m(&self) -> i64 { 20 } }

fn main() {
    let w = W { t: 0i64 }; let f = <W<i64> as B>::m; let g = <W<i64> as A>::m;
    println("{} {} {} {} {}", <W<i64> as A>::K, <W<i64> as B>::K, f(&w), g(&w),
        <W<u8> as A>::K);
}
