// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice [T]::as_mut_ptr.
// EXPECT: [1, 5, 3]

fn main() {
    let mut a = [1, 2, 3];
    let p = a.as_mut_ptr();
    // UNSAFE: a write through the slice's pointer.
    // SAFETY: element 1 is in the array, borrowed by nothing else.
    unsafe {
        *p.add(1) = 5;
    }
    println("{:?}", a);
}
