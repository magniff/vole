// The std2 item(s): std::path Path, Path::new, Path::parent, Path::file_name, Path::file_stem,
// Path::extension, Path::is_absolute, Path::components, Path::iter, Path::ancestors,
// Path::starts_with, Path::ends_with, Path::strip_prefix, Path::display, Path::join_in,
// Path::with_extension_in, Path::with_file_name_in, Path::to_path_buf_in, Path::exists,
// Path::is_dir, Path::is_file, Path::impl PartialEq, Component, Components, Iter, Ancestors,
// PathBuf, PathBuf::from_in, PathBuf::push, PathBuf::pop, PathBuf::set_extension,
// PathBuf::set_file_name. Rust's results on the same paths (the twin agrees).
// EXPECT: "": parent None name None stem None ext None abs false
// EXPECT:   comps back None
// EXPECT:   iter anc 1
// EXPECT: "/": parent None name None stem None ext None abs true
// EXPECT:   comps RootDir back Some(RootDir)
// EXPECT:   iter "/" anc 1
// EXPECT: "a": parent Some("") name Some("a") stem Some("a") ext None abs false
// EXPECT:   comps Normal("a") back Some(Normal("a"))
// EXPECT:   iter "a" anc 2
// EXPECT: "/a": parent Some("/") name Some("a") stem Some("a") ext None abs true
// EXPECT:   comps RootDir Normal("a") back Some(Normal("a"))
// EXPECT:   iter "/" "a" anc 2
// EXPECT: "a/b.txt": parent Some("a") name Some("b.txt") stem Some("b") ext Some("txt") abs false
// EXPECT:   comps Normal("a") Normal("b.txt") back Some(Normal("b.txt"))
// EXPECT:   iter "a" "b.txt" anc 3
// EXPECT: "/usr/local/": parent Some("/usr") name Some("local") stem Some("local") ext None abs true
// EXPECT:   comps RootDir Normal("usr") Normal("local") back Some(Normal("local"))
// EXPECT:   iter "/" "usr" "local" anc 3
// EXPECT: "a//b/./c/": parent Some("a//b") name Some("c") stem Some("c") ext None abs false
// EXPECT:   comps Normal("a") Normal("b") Normal("c") back Some(Normal("c"))
// EXPECT:   iter "a" "b" "c" anc 4
// EXPECT: "./a": parent Some(".") name Some("a") stem Some("a") ext None abs false
// EXPECT:   comps CurDir Normal("a") back Some(Normal("a"))
// EXPECT:   iter "." "a" anc 3
// EXPECT: ".": parent Some("") name None stem None ext None abs false
// EXPECT:   comps CurDir back Some(CurDir)
// EXPECT:   iter "." anc 2
// EXPECT: "..": parent Some("") name None stem None ext None abs false
// EXPECT:   comps ParentDir back Some(ParentDir)
// EXPECT:   iter ".." anc 2
// EXPECT: "a/..": parent Some("a") name None stem None ext None abs false
// EXPECT:   comps Normal("a") ParentDir back Some(ParentDir)
// EXPECT:   iter "a" ".." anc 3
// EXPECT: "../b": parent Some("..") name Some("b") stem Some("b") ext None abs false
// EXPECT:   comps ParentDir Normal("b") back Some(Normal("b"))
// EXPECT:   iter ".." "b" anc 3
// EXPECT: ".bashrc": parent Some("") name Some(".bashrc") stem Some(".bashrc") ext None abs false
// EXPECT:   comps Normal(".bashrc") back Some(Normal(".bashrc"))
// EXPECT:   iter ".bashrc" anc 2
// EXPECT: "a.tar.gz": parent Some("") name Some("a.tar.gz") stem Some("a.tar") ext Some("gz") abs false
// EXPECT:   comps Normal("a.tar.gz") back Some(Normal("a.tar.gz"))
// EXPECT:   iter "a.tar.gz" anc 2
// EXPECT: "a.": parent Some("") name Some("a.") stem Some("a") ext Some("") abs false
// EXPECT:   comps Normal("a.") back Some(Normal("a."))
// EXPECT:   iter "a." anc 2
// EXPECT: "/a/./": parent Some("/") name Some("a") stem Some("a") ext None abs true
// EXPECT:   comps RootDir Normal("a") back Some(Normal("a"))
// EXPECT:   iter "/" "a" anc 2
// EXPECT: "a/b/.": parent Some("a") name Some("b") stem Some("b") ext None abs false
// EXPECT:   comps Normal("a") Normal("b") back Some(Normal("b"))
// EXPECT:   iter "a" "b" anc 3
// EXPECT: "//x": parent Some("/") name Some("x") stem Some("x") ext None abs true
// EXPECT:   comps RootDir Normal("x") back Some(Normal("x"))
// EXPECT:   iter "/" "x" anc 2
// EXPECT: "x/.hidden.d": parent Some("x") name Some(".hidden.d") stem Some(".hidden") ext Some("d") abs false
// EXPECT:   comps Normal("x") Normal(".hidden.d") back Some(Normal(".hidden.d"))
// EXPECT:   iter "x" ".hidden.d" anc 3
// EXPECT: true false true true
// EXPECT: true true false
// EXPECT: Ok("local/bin") Ok("") true
// EXPECT: true false
// EXPECT: /usr/local/bin
// EXPECT: "/usr/local/lib/x.so"
// EXPECT: /etc
// EXPECT: "/" true
// EXPECT: "/" false
// EXPECT: true "dir/file.md"
// EXPECT: true "dir/file"
// EXPECT: true "dir/file.tar.gz"
// EXPECT: "dir/other.rs" Some("other.rs") Some("rs")
// EXPECT: false "/"
// EXPECT: false
// EXPECT: "a/b/c" "/c" "x/y.rs"
// EXPECT: "x/z" "q"
// EXPECT: true false
// EXPECT: true false
use std::path::{Path, PathBuf};

fn show(s: &str) {
    let p = Path::new(s);
    println("{:?}: parent {:?} name {:?} stem {:?} ext {:?} abs {}", p, p.parent(), p.file_name(),
        p.file_stem(), p.extension(), p.is_absolute());
    print("  comps");
    for c in p.components() {
        print(" {:?}", c);
    }
    println(" back {:?}", p.components().next_back());
    print("  iter");
    for x in p.iter() {
        print(" {:?}", x);
    }
    println(" anc {}", p.ancestors().count());
}

fn main(gpa: Gpa) {
    for s in ["", "/", "a", "/a", "a/b.txt", "/usr/local/", "a//b/./c/", "./a", ".", "..", "a/..",
        "../b", ".bashrc", "a.tar.gz", "a.", "/a/./", "a/b/.", "//x", "x/.hidden.d"] {
        show(s);
    }
    let p = Path::new("/usr/local/bin");
    println("{} {} {} {}", p.starts_with("/usr"), p.starts_with("/us"),
        p.starts_with("/usr/local/"), p.starts_with(""));
    println("{} {} {}", p.ends_with("bin"), p.ends_with("local/bin"), p.ends_with("in"));
    println("{:?} {:?} {}", p.strip_prefix("/usr"), p.strip_prefix("/usr/local/bin"),
        p.strip_prefix("/opt").is_err());
    println("{} {}", Path::new("a//b/") == Path::new("a/b"), Path::new("a/b") == Path::new("a/c"));
    println("{}", p.display());
    let mut b = PathBuf::from_in("/usr", gpa);
    b.push("local");
    b.push("lib/");
    b.push("x.so");
    println("{:?}", b);
    b.push("/etc");
    println("{}", b.display());
    let r = b.pop();
    println("{:?} {}", b, r);
    let r = b.pop();
    println("{:?} {}", b, r);
    let mut c = PathBuf::from_in("dir/file.txt", gpa);
    let r = c.set_extension("md");
    println("{} {:?}", r, c);
    let r = c.set_extension("");
    println("{} {:?}", r, c);
    let r = c.set_extension("tar.gz");
    println("{} {:?}", r, c);
    c.set_file_name("other.rs");
    println("{:?} {:?} {:?}", c, c.file_name(), c.extension());
    let mut d = PathBuf::from_in("/", gpa);
    let r = d.set_extension("x");
    println("{} {:?}", r, d);
    println("{}", d.pop());
    let e = Path::new("a/b").join_in("c", gpa);
    let f = Path::new("a/b").join_in("/c", gpa);
    println("{:?} {:?} {:?}", e, f, Path::new("x/y.txt").with_extension_in("rs", gpa));
    println("{:?} {:?}", Path::new("x/y.txt").with_file_name_in("z", gpa),
        Path::new("q").to_path_buf_in(gpa));
    println("{} {}", Path::new("/").exists(), Path::new("/no/such/path").exists());
    println("{} {}", Path::new("/").is_dir(), Path::new("/").is_file());
}
