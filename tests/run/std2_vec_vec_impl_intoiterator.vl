use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2, 3], gpa);
    let mut t = 0;
    for x in &v {
        t += *x;
    }
    println("{}", t);
    for x in v {
        println("{}", x);
    }
}
