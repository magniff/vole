// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Not::Output.
// EXPECT: V { x: -13 }
use std::ops::Not;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Not for V {
    type Output = V;

    fn not(self) -> V {
        V { x: !self.x }
    }
}

fn apply<T: Not<Output = T>>(a: T) -> T {
    !a
}

fn main() {
    let c: <V as Not>::Output = apply(V { x: 12 });
    println("{:?}", c);
}
