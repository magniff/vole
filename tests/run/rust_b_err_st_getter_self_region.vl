// RULE: D4.2
// (0.27.1) A getter with an elided output (self's region, E3): the result
// borrows the holder, which dies first.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 26, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct H<'a> {
    r: &'a i64,
}

impl<'a> H<'a> {
    fn get(&self) -> &i64 {
        self.r
    }
}

fn main() {
    let x: i64 = 8;
    let z: i64 = 0;
    let mut r = &z;
    {
        let h = H { r: &x };
        r = h.get();
    }
    println("{}", *r);
}
