// EDITION: rust
// RULE: D4.2
// (0.27.1) A getter with an elided output (self's region, E3): the result
// borrows the holder, which dies first.
// ERROR: :25:13: error[borrowck.dropped_borrowed]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct H<'a> {
    r: &'a i64,
}

impl<'a> H<'a> {
    fn get(&self) -> &i64 {
        self.r
    }
}

fn main() {
    let x: i64 = 8;
    let z: i64 = 0;
    let mut r = &z;
    {
        let h = H { r: &x };
        r = h.get();
    }
    println("{}", *r);
}
