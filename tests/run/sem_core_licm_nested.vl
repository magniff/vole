// EDITION: rust
// A guarded index in an inner loop.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    for j in 0..3 + unsafe { Z } {
        let mut k: i64 = 0;
        while k < 5 + unsafe { Z } { if k > 100 + j { t += a[i as usize]; } k += 1; }
    }
    println("{}", t);
    0
}
