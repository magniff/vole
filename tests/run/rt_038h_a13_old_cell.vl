// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a13_old_cell)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'f' calls 'poke', which writes through a shared reference (a cell)
// old(..) calls a callee that sets a Cell.
use std::cell::Cell;

fn poke(c: &Cell<i64>) -> i64 {
    c.set(9);
    1
}

fn f(c: &Cell<i64>) -> i64
    ensures old(poke(c)) == 1
{
    c.get()
}

fn main() {
    let c = Cell::new(1i64);
    println("{}", f(&c));
    println("{}", c.get());
}
