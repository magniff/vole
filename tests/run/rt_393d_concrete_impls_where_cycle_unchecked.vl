// RT-393, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig-m2 (form fcyc_where2_body). Since v0.30.1
// at least; the release build the same. rustc E0275 (overflow evaluating
// the requirement `S: A`, and `S: B`) at the impls (the rustc twin of this
// file). Siblings: rt_393, rt_393b, rt_393c.
// ERROR: line 20
// ERROR: line 26
trait A {
    fn a(&self) -> i64;
}

trait B {
    fn b(&self) -> i64;
}

struct S {
    r: i64,
}

impl A for S where S: B {
    fn a(&self) -> i64 {
        self.b()
    }
}

impl B for S where S: A {
    fn b(&self) -> i64 {
        2
    }
}

fn need<X: A>(x: &X) -> i64 {
    x.a()
}

fn main() {
    println("{}", need(&S { r: 0 }));
}
