// RULE: D8.5
// (0.27.2.1) `a + b` moves a: a use of it after is a use of a moved value
// (rustc E0382).
// ERROR: error[borrowck.use_moved]
use std::ops::Add;

struct D {
    n: i64,
}

impl Add for D {
    type Output = D;

    fn add(self, o: D) -> D {
        D { n: self.n + o.n }
    }
}

fn main() {
    let a = D { n: 1 };
    let b = D { n: 2 };
    let c = a + b;
    println("{} {}", c.n, a.n);
}
