// EDITION: rust
// RULE: F2.3
// Generic impls whose supertraits hold with their parameters as
// declared: through the supertrait's impl and its bound (`W<T>: Base`
// for `T: Show`), and through a parameter's own bound (`T: Base`).
// EXPECT: 2
// EXPECT: 3
trait Show {
    fn show(&self) -> i64;
}

trait Base {}

trait Derived: Base {
    fn twice(&self) -> i64;
}

trait Other: Base {
    fn thrice(&self) -> i64;
}

struct W<T> {
    x: T,
}

struct S {
    n: i64,
}

impl Show for S {
    fn show(&self) -> i64 {
        self.n
    }
}

impl Base for S {}

impl<T: Show> Base for W<T> {}

impl<T: Show> Derived for W<T> {
    fn twice(&self) -> i64 {
        self.x.show() * 2
    }
}

impl<T: Base> Other for T {
    fn thrice(&self) -> i64 {
        3
    }
}

fn main() -> i64 {
    let w = W { x: S { n: 1 } };
    std::print_int(w.twice());
    println("");
    let s = S { n: 0 };
    std::print_int(s.thrice());
    println("");
    0
}
