// EDITION: rust
// EXPECT: 30 2
// EXPECT: 5
// EXPECT: 9
// 0.14: an associated type of a generic impl (`type Item = T;` for
// `Each<T>`), resolved per instance; `Self::Item` in an impl's own
// signature; a projection through another projection, `Pairs<I>`'s Item
// being `(I::Item, I::Item)`.


#[derive(Clone, Copy)] struct Each<'a, T> { s: &'a [T], pos: i64 }

impl<'a, T> Iterator for Each<'a, T> {
    type Item = T;

    fn next(&mut self) -> Option<Self::Item> {
        if self.pos == self.s.len() as i64 {
            return None;
        }
        self.pos += 1;
        Some(self.s[(self.pos - 1) as usize])
    }
}

#[derive(Clone, Copy)] struct Pairs<I> { it: I }

impl<I: Iterator> Iterator for Pairs<I> {
    type Item = (I::Item, I::Item);

    fn next(&mut self) -> Option<(I::Item, I::Item)> {
        let a = self.it.next();
        let b = self.it.next();
        match (a, b) {
            (Some(x), Some(y)) => Some((x, y)),
            _ => None,
        }
    }
}

fn first<I: Iterator>(it: I) -> Option<I::Item> {
    let mut it = it;
    it.next()
}

fn main() -> i32 {
    let a: [i64; 3] = [10i64, 20, 30];
    let b: [u8; 2] = [7, 9];
    print("{}", Each { s: &a[0..3], pos: 2 }.next().unwrap());
    print(" ");
    print("{}", (Each { s: &b[0..2], pos: 0 }.count() as i64));
    println("");
    let p = first(Pairs { it: Each { s: &a[0..3], pos: 0 } }).unwrap();
    print("{}", (p.1 / p.0 + 3));
    println("");
    let q = first(Pairs { it: Each { s: &b[0..2], pos: 0 } }).unwrap();
    print("{}", (q.1 as i64));
    println("");
    0
}
