// RULE: T3
// (0.27.3) A requires call whose receiver is an implicit `&mut` of a
// place of a view, `buf[..n].copy_from_slice(a)`, binds it as the
// exclusive view: before, `?a0` was a shared copy the call lent mutably
// (borrowck.borrow_immutable). The clause is still checked.
// EXPECT: [1, 2, 0]
// EXPECT: [9, 2, 0]
// EXIT: 101
// STDERR: requires failed: 'self.len() == src.len()'
fn put(buf: &mut [u8], src: &[u8]) {
    let n = src.len();
    buf[..n].copy_from_slice(src);
}

fn main() {
    let mut b = [0u8; 3];
    put(&mut b, &[1, 2]);
    println("{:?}", b);
    let mut v: [u8; 3] = b;
    v[0..1].copy_from_slice(&[9]);
    println("{:?}", v);
    let x = [7u8; 2];
    b[..1].copy_from_slice(&x);
}
