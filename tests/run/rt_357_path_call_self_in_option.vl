// XFAIL: RT-357: a path call to a method whose receiver holds Self inside `Option<Self>` is refused; rustc accepts. Tuple: rt_357b, `self: Box<Self>`: rt_357c (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 1 2
trait M {
    fn m(x: Option<Self>) -> i64
        where
            Self: Sized;
}

struct S;

struct Q;

impl M for S {
    fn m(x: Option<S>) -> i64 {
        1
    }
}

impl M for Q {
    fn m(x: Option<Q>) -> i64 {
        2
    }
}

fn main() {
    println("{} {}", M::m(Some(S)), M::m(Some(Q)));
}
