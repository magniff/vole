// XFAIL: RT-TL-9: an unknown type in a Fn bound's return type is never reported (open)
// `impl Fn(i64) -> Undef`, `where F: Fn(i64) -> NoSuchType`, `-> impl Fn()
// -> Undef4` and `struct S<F: Fn() -> Undef5>` name types that do not
// exist; a Fn bound's signature is resolved only quietly
// (front::closures::fn_bounds::resolve_quietly, front::opaque's), its
// error forgotten, and the bound then constrains nothing: without k this
// program checks, builds and prints "2 20 1 7". An unknown parameter type
// there, `impl Fn(Missing) -> i64`, is reported only as "cannot infer
// the type of closure parameter 'x'".
// ERROR: unknown type 'Undef'
// ERROR: unknown type 'NoSuchType'
// ERROR: unknown type 'Missing'
// ERROR: unknown type 'Undef4'
// ERROR: unknown type 'Undef5'
fn f(g: impl Fn(i64) -> Undef) -> i64 {
    g(1)
}

fn h<F>(g: F) -> i64 where F: Fn(i64) -> NoSuchType {
    g(2)
}

fn k(g: impl Fn(Missing) -> i64) -> i64 {
    1
}

fn d() -> impl Fn() -> Undef4 {
    || 1
}

struct S<F: Fn() -> Undef5> {
    f: F,
}

fn main() -> i32 {
    let s = S { f: || 7 };
    println("{} {} {} {} {}", f(|x| x + 1), h(|x| x * 10), k(|x| 3), d()(), (s.f)());
    0
}
