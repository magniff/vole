// 0.17: `&mut x` is `&x`: one pointer type, `*T`.
// EXPECT: 3 [1, 2]
fn bump(x: &mut i64) { *x += 1; }

fn add(v: &mut Vec<i64, Gpa>, x: i64) { v.push(x); }

fn main(gpa: Gpa) -> i32 {
    let mut n: i64 = 1;
    bump(&mut n);
    bump(&mut n);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    add(&mut v, 1);
    add(&mut v, 2);
    println("{n} {v:?}");
    0
}
