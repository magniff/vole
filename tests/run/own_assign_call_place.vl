// 0.30: an assignment to a place under a reference that a call returns
// drops the value that was there, as Rust's: `*f(&mut x) = v`, a method's,
// a field of it, `*v.last_mut().unwrap() = x`, `get_mut`, an iterator's
// items, a slice a call gives, a HashMap's `get_mut` and `entry`, an
// Option's `as_mut` (0.29 leaked each: only places of names, fields, `*`
// and indexes dropped). The right side first, then the place, then the
// drop, then the write.
// FLAGS: --check-alloc
// EXPECT: fn
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: d1
// EXPECT: --
// EXPECT: mk3
// EXPECT: d2
// EXPECT: --
// EXPECT: mk4
// EXPECT: d3
// EXPECT: --
// EXPECT: mk5
// EXPECT: d4
// EXPECT: --
// EXPECT: d5
// EXPECT: vec
// EXPECT: mk6
// EXPECT: mk7
// EXPECT: d6
// EXPECT: --
// EXPECT: mk8
// EXPECT: d7
// EXPECT: --
// EXPECT: mk9
// EXPECT: d8
// EXPECT: --
// EXPECT: mk10
// EXPECT: d9
// EXPECT: --
// EXPECT: mk11
// EXPECT: d10
// EXPECT: --
// EXPECT: mk12
// EXPECT: d11
// EXPECT: --
// EXPECT: d12
// EXPECT: map
// EXPECT: mk13
// EXPECT: mk14
// EXPECT: d13
// EXPECT: --
// EXPECT: mk16
// EXPECT: mk15
// EXPECT: d15
// EXPECT: d14
// EXPECT: --
// EXPECT: mk18
// EXPECT: mk17
// EXPECT: d17
// EXPECT: --
// EXPECT: d18
// EXPECT: --
// EXPECT: d16
// EXPECT: option
// EXPECT: mk19
// EXPECT: mk20
// EXPECT: d19
// EXPECT: --
// EXPECT: mk21
// EXPECT: d20
// EXPECT: --
// EXPECT: d21
// EXPECT: end
use std::collections::HashMap;

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

struct H { f: T, n: i64 }

fn pick(h: &mut H) -> &mut T { &mut h.f }
fn same(h: &mut H) -> &mut H { h }

impl H {
    fn fm(&mut self) -> &mut T { &mut self.f }
}

fn main(gpa: Gpa) -> i32 {
    println("fn");
    {
        let mut h = H { f: mk(1), n: 0 };
        *pick(&mut h) = mk(2);
        println("--");
        *h.fm() = mk(3);
        println("--");
        same(&mut h).f = mk(4);
        same(&mut h).n = 1;
        println("--");
        *same(&mut h) = H { f: mk(5), n: 2 };
        println("--");
    }
    println("vec");
    {
        let mut v: Vec<T, Gpa> = Vec::new_in(gpa);
        v.push(mk(6));
        v[0] = mk(7);
        println("--");
        *v.last_mut().unwrap() = mk(8);
        println("--");
        *v.get_mut(0).unwrap() = mk(9);
        println("--");
        for x in v.iter_mut() {
            *x = mk(10);
            println("--");
        }
        v.as_mut_slice()[0] = mk(11);
        println("--");
        *v.first_mut().unwrap() = mk(12);
        println("--");
    }
    println("map");
    {
        let mut m: HashMap<i64, T, Gpa, FixedState> = HashMap::new_in(gpa);
        m.insert(1, mk(13));
        *m.get_mut(&1).unwrap() = mk(14);
        println("--");
        *m.entry(1).or_insert(mk(15)) = mk(16);
        println("--");
        *m.entry(2).or_insert(mk(17)) = mk(18);
        println("--");
        m.remove(&2);
        println("--");
    }
    println("option");
    {
        let mut o = Some(mk(19));
        *o.as_mut().unwrap() = mk(20);
        println("--");
        if let Some(x) = o.as_mut() {
            *x = mk(21);
            println("--");
        }
    }
    println("end");
    0
}
