// RULE: C3
// (0.27.1) `requires` in the rust edition: a clause reads its parameters
// through `shared(..)` (a `&mut i64` is read as `&i64`), is checked at
// the call after the arguments, and a failure names the caller's line.
// EXPECT: 3
// EXPECT: 4
// EXIT: 101
// STDERR: requires failed: '* v >= 0' of 'bump'
struct S {
    x: i64,
}

fn get(s: &S, k: i64) -> i64
    requires s.x > 0 && k >= 0
{
    s.x + k
}

fn bump(v: &mut i64, by: i64)
    requires * v >= 0
{
    *v += by;
}

fn main() {
    let s = S { x: 2 };
    let mut a: i64 = 1;
    println("{}", get(&s, 1));
    bump(&mut a, 3);
    println("{}", a);
    bump(&mut a, -10);
    bump(&mut a, 1);
}
// (passes on std: was XFAIL, std has no contract_check, which a contract's lowering calls (std))
