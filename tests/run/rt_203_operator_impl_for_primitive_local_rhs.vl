// XFAIL: RT-203: `impl PartialEq<S> for i64` and `impl Add<S> for i64` (a std operator trait for a primitive, with the program's type as the right operand: allowed by the orphan rule) are not used: `5i64 == S { .. }` and `1i64 + S { .. }` are refused, and the PartialEq impl gives an error placed in std (0.30.2)
// rustc prints the EXPECT line (twin: r302d_028_operator_impl_for_primitive_with_local_rhs.rs.txt).
// vole: `expected 'i64', got 'S'` (line 35) and `<std>:1053:26: error[type
// error] unknown type 'S'`; with only the Add impl, `1i64 + S { k: 2 }` is
// `expected 'i64', got 'S'`. `impl From<S> for i64` works (`.into()` gives 40).
// An operator with a primitive left operand is the built-in one whatever impls
// exist (R302D-27: `a + b` ignores `impl Add<u8> for i64`). Since v0.28.0.
// EXPECT: true 40 201
struct S {
    k: i64,
}

impl PartialEq<S> for i64 {
    fn eq(&self, o: &S) -> bool {
        *self == o.k
    }
}

impl From<S> for i64 {
    fn from(s: S) -> i64 {
        s.k * 10
    }
}

impl std::ops::Add<S> for i64 {
    type Output = i64;

    fn add(self, o: S) -> i64 {
        self + o.k * 100
    }
}

fn main() {
    let x: i64 = S { k: 4 }.into();
    println("{} {} {}", 5i64 == S { k: 5 }, x, 1i64 + S { k: 2 });
}
