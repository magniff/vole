// `println("{} {:?}", s, drop(s))`: Rust's format_args! borrows s for the
// whole call, so the move is E0505 and the clear in `grow` is E0502.
// Until 0.30.1 vole took the argument `s` (a place, not `&s` or
// `s.as_str()`, which were borrows) as a copy of the String's words with
// no borrow, so both were accepted: at -O0 --check-alloc the print read
// the freed block, at -O2 it printed freed memory. Now each hole borrows
// its place to the end of the call (places/build.vl hidden_borrow, D2.9),
// rustc's E0505 and E0502.
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 15,
// ERROR: error[borrowck.conflict]
// ERROR: line 22,
fn moved(gpa: Gpa) {
    let s = format_in("abcdefghijklmnopqrstuvwxyz {}", 5, gpa);
    println("{} {:?}", s, drop(s));
}

fn grow(gpa: Gpa) {
    let mut w: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(format_in("hello world, a long string {}", 1, gpa));
    println("{:?} {}", w, {
        w.clear();
        w.shrink_to_fit();
        0
    });
}

fn main(gpa: Gpa) {
    moved(gpa);
    grow(gpa);
}
