// XFAIL: RT-25: a format argument that names a place is not a borrow: a later argument may free or move it, a use after free in safe code (open)
// `println("{} {:?}", s, drop(s))`: Rust's format_args! borrows s for the
// whole call, so the move is E0505 and the clear in `grow` is E0502.
// vole takes the argument `s` (a place, not `&s` or `s.as_str()`, which
// are borrows and refused) as a copy of the String's words with no
// borrow, so both are accepted: at -O0 --check-alloc the print reads the
// freed block ("use after free: block #2 ... freed at ...:16:27"), at -O2
// it prints freed memory. `{s}` inline, format_in and eprintln do the
// same.
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 16,
// ERROR: error[borrowck.conflict]
// ERROR: line 23,
fn moved(gpa: Gpa) {
    let s = format_in("abcdefghijklmnopqrstuvwxyz {}", 5, gpa);
    println("{} {:?}", s, drop(s));
}

fn grow(gpa: Gpa) {
    let mut w: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(format_in("hello world, a long string {}", 1, gpa));
    println("{:?} {}", w, {
        w.clear();
        w.shrink_to_fit();
        0
    });
}

fn main(gpa: Gpa) {
    moved(gpa);
    grow(gpa);
}
