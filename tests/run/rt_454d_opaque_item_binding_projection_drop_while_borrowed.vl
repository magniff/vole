// XFAIL: RT-454d: (RT-454c with the borrow it must keep) `first(mk(&v), &k)` with `fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item>` and mk returning `impl Iterator<Item = &'a i64>`, then `drop(v)` while the result lives: rustc E0505 at the drop; vole refuses the program earlier with RT-454c's errors (0.30.2)
// From the re-review of g302bor2 (its form t08_opaque_binding_uaf).
// Since v0.30.1 at least. A fix that accepts it must refuse the drop.
// FLAGS: --check-alloc
// ERROR: line 21
fn mk<'a>(v: &'a Vec<i64, Gpa>) -> impl Iterator<Item = &'a i64> {
    v.iter()
}

fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = first(mk(&v), &k);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(7);
    println("{:?} {:?}", r, w);
}
