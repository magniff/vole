// The std2 item(s): std::collections::BTreeMap under 60000 random inserts and
// removes of 4000 keys (three levels of nodes, every split, borrow and merge),
// checked against a table: get, len, iter in order from both ends, range,
// pop_first and pop_last; String keys are dropped with the map.
// RUSTC: none (the map takes its allocator)
// FLAGS: --check-alloc
// EXPECT: 60000 ops ok, 2039 left
// EXPECT: drained 2039
// EXPECT: strings 500 k0 k99
use std::alloc::Gpa;
use std::collections::BTreeMap;

fn xorshift(x: &mut u64) -> u64 {
    let mut v = *x;
    v ^= v << 13;
    v ^= v >> 7;
    v ^= v << 17;
    *x = v;
    v
}

fn check(m: &BTreeMap<u32, u64, Gpa>, there: &[u64]) -> bool {
    let mut count = 0;
    let mut k = 0;
    while k < there.len() {
        let got = m.get(&(k as u32));
        if there[k] == 0 {
            if got.is_some() {
                return false;
            }
        } else {
            count += 1;
            match got {
                Some(v) => if *v != there[k] {
                    return false;
                },
                None => return false,
            }
        }
        k += 1;
    }
    if m.len() != count {
        return false;
    }
    // in order from the front, and the same entries from the back
    let mut seen = 0;
    let mut last: i64 = -1;
    for (k, v) in m.iter() {
        if (*k as i64) <= last || there[*k as usize] != *v {
            return false;
        }
        last = *k as i64;
        seen += 1;
    }
    let mut back = 0;
    let mut first: i64 = 1 << 40;
    for (k, _) in m.iter().rev() {
        if (*k as i64) >= first {
            return false;
        }
        first = *k as i64;
        back += 1;
    }
    // a range against the table
    let mut want = 0;
    k = 1000;
    while k < 1500 {
        if there[k] != 0 {
            want += 1;
        }
        k += 1;
    }
    let mut both = m.range(1000..1500);
    let mut met = 0;
    loop {
        if both.next().is_none() {
            break;
        }
        met += 1;
        if both.next_back().is_none() {
            break;
        }
        met += 1;
    }
    seen == count && back == count && m.range(1000..1500).count() == want && met == want
        && m.range(1000..=1499).count() == want
        && m.range(..1500).count() + m.range(1500..).count() == count
}

fn main(gpa: Gpa) {
    let keys = 4000;
    let mut m: BTreeMap<u32, u64, Gpa> = BTreeMap::new_in(gpa);
    let mut there: Vec<u64, Gpa> = Vec::new_in(gpa);
    for _ in 0..keys {
        there.push(0);
    }
    let mut x = 0x9e3779b97f4a7c15u64;
    let mut ok = true;
    let ops = 60000;
    for i in 0..ops {
        let r = xorshift(&mut x);
        let k = ((r >> 8) % (keys as u64)) as usize;
        // more inserts first, then more removes, then even
        let insert = if i < 20000 { r % 4 != 0 } else if i < 40000 { r % 4 == 0 }
            else { r % 2 == 0 };
        if insert {
            let v = (i + 1) as u64;
            let old = m.insert(k as u32, v);
            if old.unwrap_or(0) != there[k] {
                ok = false;
            }
            there[k] = v;
        } else {
            let old = m.remove(&(k as u32));
            if old.unwrap_or(0) != there[k] {
                ok = false;
            }
            there[k] = 0;
        }
        if i % 5000 == 4999 && !check(&m, there.as_slice()) {
            ok = false;
        }
    }
    println("{ops} ops {}, {} left", if ok { "ok" } else { "WRONG" }, m.len());
    let mut drained = 0;
    let mut low: i64 = -1;
    let mut high: i64 = keys as i64;
    loop {
        match m.pop_first() {
            Some((k, _)) => {
                if (k as i64) <= low {
                    ok = false;
                }
                low = k as i64;
                drained += 1;
            }
            None => break,
        }
        match m.pop_last() {
            Some((k, _)) => {
                if (k as i64) >= high {
                    ok = false;
                }
                high = k as i64;
                drained += 1;
            }
            None => break,
        }
    }
    println("{} {drained}", if ok && m.is_empty() { "drained" } else { "WRONG" });
    let mut s: BTreeMap<String<Gpa>, String<Gpa>, Gpa> = BTreeMap::new_in(gpa);
    for i in 0..500 {
        let mut k = String::new_in(gpa);
        write(&mut k, "k{}", (i * 37) % 500);
        let mut v = String::new_in(gpa);
        write(&mut v, "v{i}");
        s.insert(k, v);
    }
    for i in 100..300 {
        let mut k = String::new_in(gpa);
        write(&mut k, "k{i}");
        s.remove(k.as_str());
    }
    for i in 100..300 {
        let mut k = String::new_in(gpa);
        write(&mut k, "k{i}");
        s.insert(k, String::new_in(gpa));
    }
    println("strings {} {} {}", s.len(), s.first_key_value().unwrap().0,
        s.last_key_value().unwrap().0);
}
