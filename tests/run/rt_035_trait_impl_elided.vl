// RT-35 (0.30.1, review 7) The same in a trait impl with a type
// parameter, `impl<U> Tr for V<&str, U>`, and with `'_` written: the
// elided header lifetime is the impl's own and its flows are checked in
// every instance (rustc E0521, a lifetime error).
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR-COUNT: 3
trait Tr {
    fn keep(&self, out: &mut Option<&'static str>);
}

trait Ts {
    fn s(&self) -> &'static str;
}

struct V<T, U> { t: T, u: U }

impl<U> Tr for V<&str, U> {
    fn keep(&self, out: &mut Option<&'static str>) { out.replace(self.t); }
}

struct W<T, U> { t: T, u: U }

impl<U> Ts for W<&'_ str, U> {
    fn s(&self) -> &'static str { self.t }
}

fn main() {}
