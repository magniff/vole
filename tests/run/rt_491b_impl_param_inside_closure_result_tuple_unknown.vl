// XFAIL: RT-491b: (RT-491, the parameter inside a tuple) `impl<B, I: Iterator, F: FnMut(I::Item) -> (i64, B)> Iterator for Pairs<I, F> { type Item = B; .. }` is "unknown type 'B'" at `type Item = B`; rustc prints 9 (0.30.2)
// From the third re-review of the borrow-check work (g302bor2), written as programs rustc accepts. Since v0.30.1 at least.
// EXPECT: 9
struct Pairs<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> (i64, B)> Iterator for Pairs<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => {
                let (k, b) = (self.f)(x);
                let _ = k;
                Some(b)
            }
            None => None,
        }
    }
}

fn main() {
    let a = [1i64, 2, 3];
    let p = Pairs { i: a.iter(), f: |x: &i64| (0i64, *x + 1) };
    let s: i64 = p.sum();
    println("{}", s);
}
