// XFAIL: gap 3: compile type error: no method 'cloned' on type 'Option<let T>'
// (0.25, the semantics fuzzer) `let t = v.last()?;` in a function that
// borrows `v`: last() gives a borrowed copy of the element (0.17 T7), but
// the `?` lowering drops it as if it were owned, so the element is
// dropped there and again with the Vec (a double drop; with an element
// that owns memory, a use after free under --check-alloc). `.unwrap()`
// and `match` on the same Option are fine.
// EXPECT: q 1
// EXPECT: u 1
// EXPECT: m 1
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0

static mut LIVE: i64 = 0;
struct T { id: i64 }
fn mk(id: i64) -> T { unsafe { LIVE += 1; } T { id: id } }

impl Drop for T {
    fn drop(&mut self) { unsafe { LIVE -= 1; } println("d{}", self.id); }
}

fn last_q(v: &Vec<T, Gpa>) -> Option<i64> {
    let t = v.last().cloned()?;
    Some(t.id)
}

fn last_u(v: &Vec<T, Gpa>) -> i64 {
    let t = v.last().cloned().unwrap();
    t.id
}

fn last_m(v: &Vec<T, Gpa>) -> i64 {
    match v.last().cloned() { Some(t) => t.id, None => 0 }
}

fn run(gpa: Gpa) {
    let mut v: Vec<T, Gpa> = Vec::new_in(gpa);
    v.push(mk(1));
    println("q {}", last_q(&v).unwrap_or(0));
    println("u {}", last_u(&v));
    println("m {}", last_m(&v));
    println("end");
}

fn main(gpa: Gpa) -> i32 {
    run(gpa);
    let live_now = unsafe { LIVE }; println("live {live_now}");
    0
}
