// EDITION: rust
// RULE: F5.4, F7.2, F7.3
// `Self` in an impl is the header's self type: `Self(..)` makes a tuple
// struct, `Self` is a unit struct's value, `Self { .. }` a struct
// literal, and the patterns `Self(..)`, `Self { .. }`, `Self` match
// them; also in a generic impl, and a unit struct's name as a pattern.
// EXPECT: 7
// EXPECT: 12
// EXPECT: 1
// EXPECT: 5
struct Pair(i64, i64);

struct Unit;

struct W<T> {
    v: T,
    n: i64,
}

impl Pair {
    fn new(a: i64, b: i64) -> Self {
        Self(a, b)
    }

    fn swap(self) -> Self {
        let Self(a, b) = self;
        Self(b, a)
    }

    fn sum(&self) -> i64 {
        match *self {
            Self(a, b) => a + b,
        }
    }
}

impl Unit {
    fn make() -> Self {
        Self
    }

    fn one(self) -> i64 {
        match self {
            Self => 1,
        }
    }
}

impl<T> W<T> {
    fn new(v: T) -> Self {
        Self { v, n: 5 }
    }

    fn n(self) -> i64 {
        let Self { n, .. } = self;
        n
    }
}

fn main() -> i64 {
    let p = Pair::new(3, 4).swap();
    std::print_int(p.sum());
    println("");
    let Pair(a, b) = p;
    std::print_int(a * b);
    println("");
    let u = Unit::make();
    let Unit = u;
    std::print_int(Unit.one());
    println("");
    std::print_int(W::new(1u8).n());
    println("");
    0
}
