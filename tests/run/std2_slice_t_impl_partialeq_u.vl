// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice [T]::impl PartialEq<[U]>.
// EXPECT: true false false

fn main() {
    let a: &[i64] = &[1, 2];
    let b: &[i64] = &[1, 2];
    let c: &[i64] = &[1, 3];
    let d: &[i64] = &[1];
    println("{} {} {}", a == b, a == c, a == d);
}
