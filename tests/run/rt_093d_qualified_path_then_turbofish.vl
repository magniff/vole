// RT-93 (fixed in 0.30.2: types::opens_args, types::starts_type and exprs::starts_expr decide where type arguments, a type and an expression start, `<` and `<<` among them): a qualified path followed by a turbofish (`<S as A>::f::<..>()`) does not parse ("expected ';', got '::'"); rustc prints the EXPECT line (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 11 11
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: u32;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: u32 = 2;

    fn make() -> i64 {
        40
    }
}

fn id<T>(t: T) -> T {
    t
}

fn sz<T>() -> i64 {
    7
}

trait G {
    fn g<T>() -> i64;
}

impl G for S {
    fn g<T>() -> i64 {
        11
    }
}

fn main() {
    let a = <S as G>::g::<<S as A>::Out>();
    let b = <S as G>::g::<i64>();
    println("{} {}", a, b);
}
