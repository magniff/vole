// RULE: F8.3, F8.4
// RT-C301-8 review (R2, form f50_myfrom_intrinsic): `<i64 as MyFrom<i32>>::from(5i32)` with only `impl MyFrom<u8>`: unmet (rustc E0277), not std's From.
// rustc: error[E0277]: the trait bound `i64: MyFrom<i32>` is not satisfied
// ERROR: error[trait.unmet]: 'i64' has no impl of 'MyFrom' that gives 'from'
trait MyFrom<T> { fn from(x: T) -> Self; }
impl MyFrom<u8> for i64 { fn from(x: u8) -> i64 { 1000 + x as i64 } }
fn main() { let a = <i64 as MyFrom<i32>>::from(5i32); println("{}", a); }
