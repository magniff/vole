// RULE: D8
// (0.27.1) Deferred initialization: `let x: T;` and `let x;` (typed by
// the first assignment), assigned once on each path without `mut`; an
// owned value so assigned is dropped once (the borrow checker checks no
// read comes before the assignment).
// FLAGS: --check-alloc
// EXPECT: 1 2 1
// EXPECT: 2 3 1
fn pick(c: bool) -> i64 {
    let x: i64;
    if c {
        x = 1;
    } else {
        x = 2;
    }
    x
}

fn pick2(c: bool) -> i64 {
    let x;
    if c {
        x = 1;
    } else {
        x = 2;
    }
    x + 1
}

fn count(c: bool, gpa: Gpa) -> usize {
    let s: Vec<i64, Gpa>;
    if c {
        s = Vec::new_in(gpa);
    } else {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        s = v;
    }
    s.len()
}

fn main(gpa: Gpa) {
    println("{} {} {}", pick(true), pick(false), count(false, gpa));
    let s;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    s = v;
    println("{} {} {}", pick2(true), pick2(false), s.len());
}
