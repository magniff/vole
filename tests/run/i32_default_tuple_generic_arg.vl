// XFAIL: I32-DEFAULT: an integer literal in a tuple argument against `(T, i64)` is typed i32 before T is solved: "expected '(bool, i64)', got '(bool, i32)'" (0.30.2's root fix)
// rustc types the literal i64 from the parameter's type and prints the
// EXPECT lines (found by the RT-34 fix's second review).
// FLAGS: --check-alloc
// EXPECT: 1
// EXPECT: 1
fn h<T>(t: (T, i64)) -> i64 {
    t.1
}

fn main(gpa: Gpa) {
    println("{}", h((Vec::from_in([5i64], gpa), 1)));
    println("{}", h((true, 1)));
}
