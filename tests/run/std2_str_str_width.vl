// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str str::width.
// EXPECT: 5 4 2 1 0
// RUSTC: none (vole's addition: display width)
use std::str::CharIndices;

fn main() {
    println("{} {} {} {} {}", "hello".width(), "日本".width(), "😀".width(), "e\u{301}".width(),
        "".width());
}
