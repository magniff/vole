// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map OccupiedEntry::get_mut.
// EXPECT: 10
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Entry;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 9);
    if let Entry::Occupied(mut e) = m.entry(1) {
        *e.get_mut() += 1;
    }
    println("{}", m[&1]);
}
