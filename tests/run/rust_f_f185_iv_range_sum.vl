// RULE: F18.5
// (0.30.2) A range of literals as a receiver, `(a..b).sum()` into an
// `i64`: the range's integer variable is i64 (FL6: 0.30.1 typed it i32,
// and `Sum<i32>` is not i64's).
// EXPECT: 6000000001 6
fn main() {
    let s: i64 = (3000000000..3000000002).sum();
    let t: i64 = (1..4).sum();
    println("{s} {t}");
}
