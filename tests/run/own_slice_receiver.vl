// EDITION: rust
// (0.25) an array's slicing as the receiver of an inout method is an
// exclusive slicing (`a.sort()`, `a[1..].sort()`), as `&a[..]` is: a view
// of the array used after it is own.conflict
// ERROR: error[borrowck.conflict]
// ERROR: line 14, column 5
// ERROR-COUNT: 1
fn main() {
    let mut a = [3i64, 1, 2];
    a.sort_unstable();
    a[1..].sort_unstable();
    println("{} {} {}", a[0], a[1], a[2]);
    let t = &a[0..2];
    a.sort_unstable();
    println("{}", t[0]);
}
