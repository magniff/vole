// RULE: E3.4a
// (0.28.0, gap 102) std's Hash::hash is `#[pure]`: a value is hashed in a
// `#[pure]` function (what hash writes goes through its `&mut` Hasher, a
// parameter), with std's hashers, a derived impl, a written one, a
// generic one, and a Hasher of the program's that only changes itself. A
// Hasher that prints what it is fed is the Hasher's effect: the impls
// stay pure, and the function that hashes into it is io.
// CROSS: aarch64-linux x86_64-linux
use std::hash::{BuildHasher, DefaultHasher, FixedState, Hash, Hasher};

#[derive(Hash, PartialEq, Eq, Clone, Copy)]
struct P {
    x: i64,
    y: u8,
}

struct Name<'a> {
    text: &'a str,
}

impl<'a> Hash for Name<'a> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.text.len().hash(state);
        for b in self.text.as_bytes() {
            b.to_ascii_lowercase().hash(state);
        }
    }
}

// A Hasher of the program's: the bytes' sum.
struct Sum {
    n: u64,
}

impl Hasher for Sum {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.n = self.n.wrapping_add(*b as u64);
        }
    }
}

// A Hasher that prints what it is fed.
struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

struct Pair<T> {
    a: T,
    b: T,
}

impl<T: Hash> Hash for Pair<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.a.hash(state);
        self.b.hash(state);
    }
}

#[effects(io, static, panic)]
fn shown(p: &P, q: &Pair<u8>) -> u64 {
    let mut h = Show { n: 0 };
    p.hash(&mut h);
    q.hash(&mut h);
    P::hash_slice(&[*p], &mut h);
    h.finish()
}

#[pure]
fn of_int(x: i64) -> u64 {
    let mut h = DefaultHasher::new();
    x.hash(&mut h);
    h.finish()
}

#[pure]
fn of_parts(p: &P, s: &str, v: &[i64]) -> u64 {
    let mut h = FixedState::new().build_hasher();
    p.hash(&mut h);
    s.hash(&mut h);
    v.hash(&mut h);
    (1u8, 'c', true).hash(&mut h);
    h.finish()
}

#[pure]
fn of_name(n: &Name<'_>) -> u64 {
    let mut h = Sum { n: 0 };
    n.hash(&mut h);
    h.finish()
}

#[pure]
fn one(p: &P) -> u64 {
    FixedState::new().hash_one(p)
}

fn main() {
    let p = P { x: 1, y: 2 };
    println("{}", of_int(1) == of_int(1) && of_int(1) != of_int(2));
    println("{}", of_parts(&p, "s", &[1, 2]) == of_parts(&p, "s", &[1, 2]));
    println("{}", of_parts(&p, "s", &[1, 2]) != of_parts(&p, "t", &[1, 2]));
    println("{} {}", of_name(&Name { text: "Ab" }), of_name(&Name { text: "aB" }));
    println("{}", one(&p) == one(&P { x: 1, y: 2 }));
    println("{}", shown(&p, &Pair { a: 7u8, b: 8u8 }));
}
// EXPECT: true
// EXPECT: true
// EXPECT: true
// EXPECT: 197 197
// EXPECT: true
// EXPECT: write [1, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [2]
// EXPECT: write [7]
// EXPECT: write [8]
// EXPECT: write [1, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [2]
// EXPECT: 20
