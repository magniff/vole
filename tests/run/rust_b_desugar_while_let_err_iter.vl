// RULE: D2.5
// (0.30.1) `while let Some(x) = it.next()` with it borrowing v: the push in the
// body is E0502 (vole's conflict), as rustc.
// ERROR: error[borrowck.conflict]
// ERROR: line 12, column 9
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut it = v.iter();
    while let Some(x) = it.next() {
        v.push(*x);
    }
}
