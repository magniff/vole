// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello (through a fn value)
// EXPECT: hello
// EXPECT: 7
#[derive(Clone, Copy)] struct E { name: [u8; 8], len: i64 }
fn nm(e: &E) -> &[u8] { &e.name[..e.len as usize] }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 };
    let g: fn(&E) -> &[u8] = nm;
    let n = g(&e);
    let k = clobber();
    println("{}", str::from_utf8(n).unwrap());
    println("{}", k);
    0
}
