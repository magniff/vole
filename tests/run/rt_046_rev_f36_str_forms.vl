// FLAGS: -O2
// EXPECT: 98122
// EXPECT: 98122
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn pokeb(q: *mut u8, v: u8) {
    // UNSAFE: given by the caller
    // SAFETY: points into main's buffer
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn r_str(s: *const str, q: *mut u8) -> u64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's buffer; 'z' keeps it UTF-8
    unsafe {
        let a = (*s).as_bytes()[1] as u64;
        pokeb(q, 122);
        let b = (*s).as_bytes()[1] as u64;
        a * 1000 + b
    }
}

#[inline(never)]
fn r_str_mut(s: *mut str, q: *mut u8) -> u64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's buffer; 'z' keeps it UTF-8
    unsafe {
        let a = (*s).as_bytes()[2] as u64;
        pokeb(q, 122);
        let b = (*s).as_bytes()[2] as u64;
        a * 1000 + b
    }
}

fn main() -> i32 {
    let mut a = [97u8, 98, 98];
    let base = a.as_mut_ptr();
    // UNSAFE: both from base
    // SAFETY: a outlives them; ASCII is UTF-8
    let (p, q) = unsafe {
        (std::slice::from_raw_parts_mut(base, 3) as *mut [u8] as *mut str, base.add(1))
    };
    println("{}", r_str(p as *const str, q));
    // UNSAFE: from base
    // SAFETY: a outlives it
    let q2 = unsafe { base.add(2) };
    println("{}", r_str_mut(p, q2));
    0
}
