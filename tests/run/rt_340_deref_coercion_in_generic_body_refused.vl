// XFAIL: RT-340: a deref coercion inside a generic body with `T: Deref<Target = i64>` is refused: "expected '&i64', got '&T'" (0.30.2)
// rustc prints the EXPECT line. Since v0.30.1 at least. From the
// re-review of g302index.
// EXPECT: 4
use std::ops::Deref;

fn take(x: &i64) -> i64 {
    *x
}

fn g<T: Deref<Target = i64>>(t: &T) -> i64 {
    take(t)
}

struct B {
    a: i64,
}

impl Deref for B {
    type Target = i64;

    fn deref(&self) -> &i64 {
        &self.a
    }
}

fn main() {
    let b = B { a: 4 };
    println("{}", g(&b));
}
