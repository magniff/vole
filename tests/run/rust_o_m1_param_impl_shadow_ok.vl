// EXPECT: 3
// An impl's parameter P beside a `struct P`: a method's bound `T: Tr<P>` names the parameter
// (v0.30.1 read the struct and refused the call; rustc prints 3).
struct P;
trait Tr<U> { fn g(&self) -> i64; }
struct W { r: i64 }
impl Tr<i64> for W { fn g(&self) -> i64 { 3 } }
struct S<P> { p: P }
fn need<Z: Tr<Q>, Q>(z: &Z, q: &Q) -> i64 { z.g() }
impl<P> S<P> { fn m<T: Tr<P>>(&self, t: &T) -> i64 { need(t, &self.p) } }
fn main() { println("{}", S { p: 0i64 }.m(&W { r: 0 })); }
