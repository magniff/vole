use std::sync::Mutex;

fn main(gpa: Gpa) {
    let d: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    let m = Mutex::new(d);
    {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..10 { v.push(i + 100); }
        let s = v.as_slice();
        m.with(|d| d.push(s));
    }
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 { w.push(i); }
    println("{}", m.with(|d| d[0][3]));
}
