// RT-CG-6 (fixed in 0.30.1): part of a v4f64 in its spill slots was overwritten by an f64 move of the same edge before the vector was read (x86_64: `movups %xmm2, 144(%rsp)` then `movsd %xmm2, 152(%rsp)`)
// FLAGS: -O2
// EXPECT: 2.625 9.67578125 3 3.375 55.01106270647206
// x86-64 (`tests/run.sh -t x86_64-macos -n ...`): the release branch
// printed `2.625 9.4384765625 ...` at -O1 and -O2, 0.30.0 at -O2; on
// aarch64 the release branch was wrong at -O1 as well. The EXPECT line is
// rustc's, with the vector as [f64; 4]; -O0 is an output guard.
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[inline(never)]
fn g(a: i64) -> i64 { K.fetch_add(1, Ordering::Relaxed); a ^ 5 }

fn main() {
    let lim = (g(7) & 15) + 3;
    let b0 = (g(40) as f64) * 0.5;
    let b1 = (g(41) as f64) * 0.5;
    let b2 = (g(42) as f64) * 0.5;
    let b3 = (g(43) as f64) * 0.5;
    let b4 = (g(44) as f64) * 0.5;
    let b5 = (g(45) as f64) * 0.5;
    let b6 = (g(46) as f64) * 0.5;
    let b8 = (g(48) as f64) * 0.5;
    let b9 = (g(49) as f64) * 0.5;
    let b10 = (g(50) as f64) * 0.5;
    let b11 = (g(51) as f64) * 0.5;
    let b12 = (g(52) as f64) * 0.5;
    let b13 = (g(53) as f64) * 0.5;
    let b14 = (g(54) as f64) * 0.5;
    let b15 = (g(55) as f64) * 0.5;
    let b16 = (g(56) as f64) * 0.5;
    let b17 = (g(57) as f64) * 0.5;
    let mut v0: f64 = (g(2) as f64) * 0.375;
    let mut v2: v4f64 = v4f64::splat((g(2) as f64) * 0.5);
    let mut v10: f64 = (g(12) as f64) * 0.375;
    let mut v11: f64 = (g(13) as f64) * 0.375;
    let mut t: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        sf = sf * 0.5 + b2;
        sf = sf * 0.5 + b5;
        sf = sf * 0.5 + b8;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b16;
        let c = g(t);
        v2 = v2 * v4f64::splat(0.5) + v2 * v4f64::splat(0.25) + v4f64::splat((c as f64) * 0.125);
        if (c & 3) == 0 {
            { let tmp_r = v11; v11 = v10; v10 = tmp_r; }
        }
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b1;
        sf = sf * 0.5 + b3;
        sf = sf * 0.5 + b4;
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b9;
        sf = sf * 0.5 + b10;
        sf = sf * 0.5 + b12;
        sf = sf * 0.5 + b13;
        sf = sf * 0.5 + b14;
        sf = sf * 0.5 + b15;
        sf = sf * 0.5 + b17;
        t += 1;
    }
    println("{} {} {} {} {}", v0, v2.sum(), v10, v11, sf);
}
