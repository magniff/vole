// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::replace.
// EXPECT: Some(1) Some(2) None Some(3)
use std::option::Option;

fn main() {
    let mut a: Option<i64> = Some(1);
    let old = a.replace(2);
    let mut b: Option<i64> = None;
    let old2 = b.replace(3);
    println("{:?} {:?} {:?} {:?}", old, a, old2, b);
}
