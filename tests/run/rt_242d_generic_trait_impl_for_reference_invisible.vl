// XFAIL: RT-242d: a trait with a type parameter implemented only for a reference type is not found: with `impl<'a> T<i64> for &'a S` and `impl<'a, 'b> T<&'b S> for &'a S`, `r.f(5i64)`, `T::f(r, 5i64)`, `s.f(5i64)` (autoref), `(&s).f(r)`, `rr.f(&t)` and `r.h(5i64)` (a `&self` method) are all "no method 'f' on type '&S'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). Found by gen/gtp.py (seeds
// 1 and 3). The same traits without a type parameter (`trait U { fn g(self) }`
// for &S) are found; R302E-19b's `x.tk(5u8)` is this rule where S has another
// impl of the trait.
// EXPECT: 16 16 16
// EXPECT: 12 13
// EXPECT: 26
struct S {
    k: i64,
}

trait T<R> {
    fn f(self, o: R) -> i64;
}

trait V<R> {
    fn h(&self, o: R) -> i64;
}

impl<'a> T<i64> for &'a S {
    fn f(self, o: i64) -> i64 {
        10 + self.k + o
    }
}

impl<'a, 'b> T<&'b S> for &'a S {
    fn f(self, o: &'b S) -> i64 {
        10 + self.k + o.k
    }
}

impl<'a> V<i64> for &'a S {
    fn h(&self, o: i64) -> i64 {
        20 + self.k + o
    }
}

fn main() {
    let s = S { k: 1 };
    let t = S { k: 2 };
    let r = &s;
    let rr = &r;
    println("{} {} {}", r.f(5i64), T::f(r, 5i64), s.f(5i64));
    println("{} {}", (&s).f(r), rr.f(&t));
    println("{}", r.h(5i64));
}
