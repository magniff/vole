// EDITION: rust
// RULE: F18.5
// (0.27.4) An `if`'s literals take the type of the use that solves the
// open local, and one that does not fit it is an error (rustc: literal out
// of range).
// ERROR: error[type error]: integer literal 300 does not fit in type 'u8'
// ERROR-COUNT: 1
fn main() {
    let c = true;
    let b = if c { 300 } else { 0 };
    let y: u8 = b;
    println("{}", y);
}
