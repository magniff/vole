// type annotation, build::lower_let). Since v0.30.1 at least.
// ERROR: line 14
struct D {
    n: i64,
}

struct Q<'a>(&'a D);

impl<'a> Q<'a> {
    fn make() {
        let d = D { n: 1 };
        let q = Q::<'a>(&d);
        println("{}", q.0.n);
