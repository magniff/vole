// (0.25.3) A closure's by-value parameter read by a nested closure (dropped
// with the outer body), moved into a nested sink closure (dropped with it),
// rebound to a var, or a var parameter changed: each dropped once.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: a 2
// EXPECT: drop 2
// EXPECT: b 4
// EXPECT: drop 13
// EXPECT: c 13
// EXPECT: drop 104
// EXPECT: m 104
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let a = |d: sink D| {
        let g = || d.id;
        g() + 1
    };
    println("a {}", a(mk(1, gpa)));
    let b = |d: sink D| {
        let g = sink || d.id;
        g() + 2
    };
    println("b {}", b(mk(2, gpa)));
    let c = |d: sink D| {
        var e = d;
        e.id += 10;
        e.id
    };
    println("c {}", c(mk(3, gpa)));
    let m = |var d: sink D| {
        d.id += 100;
        d.id
    };
    println("m {}", m(mk(4, gpa)));
    println("end");
}
