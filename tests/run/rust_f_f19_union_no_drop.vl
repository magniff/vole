// EDITION: rust
// RULE: F19.7
// RUSTC: none FL12 (rustc rejects a union field that is not Copy or ManuallyDrop, E0740)
// (0.27.3) A rust-edition union drops none of its fields, as Rust's: a
// value written into one is dropped only when a field is read out of it
// (a move of the field, which moves the union). Before, its fields were
// dropped, whichever held a value.
// EXPECT: 1
// EXPECT: took 2
// EXPECT: end
// EXPECT: drop 2
struct D(i64);

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.0);
    }
}

union Md<T> {
    value: T,
}

impl<T> Md<T> {
    fn new(v: T) -> Md<T> {
        Md { value: v }
    }

    fn get(&self) -> &T {
        // UNSAFE: a union's field
        // SAFETY: value is the only field, written by new
        unsafe { &self.value }
    }

    fn take(self) -> T {
        // UNSAFE: a union's field read out
        // SAFETY: value is the only field, written by new
        unsafe { self.value }
    }
}

fn main() {
    let a = Md::new(D(1));
    let b = Md::new(D(2));
    println("{}", a.get().0);
    let d = b.take();
    println("took {}", d.0);
    println("end");
}
