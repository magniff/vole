// 0.25.4 (feedback: pathtrace's UI): an if whose branch is a local made
// of literals (`[f64; 4]` beside a `[f32; 4]`) names the `let` and its
// annotation, as a mismatch does (err_02522_literal_default_let), and the
// use of the same local after it is not reported again.
// ERROR: if/else branches have different types: '[f32; 4]' vs '[f64; 4]'
// ERROR: line 12, column 5: 'base' is '[f64; 4]' from its literals (
// ERROR: --old 'let base =' --new 'let base: [f32; 4] ='
// ERROR-COUNT: 1
const ACCENT: [f32; 4] = [0.3, 0.6, 0.9, 1.0];

fn pick(down: bool) -> [f32; 4] {
    let base = [0.20, 0.52, 0.70, 1.0];
    let bg = if down { ACCENT } else { base };
    let again: [f32; 4] = base;
    if again[0] > 0.0 { bg } else { again }
}

fn main() -> i32 {
    if pick(true)[0] > 0.0 { 0 } else { 1 }
}
