// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter Iterator::eq.
// EXPECT: true false false

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([1i64, 2, 3], gpa);
    let c = Vec::from_in([1i64, 3], gpa);
    println("{} {} {}", a.iter().eq(a.iter()), a.iter().eq(b.iter()), a.iter().eq(c.iter()));
}
