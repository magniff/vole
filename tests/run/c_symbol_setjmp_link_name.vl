// 0.30.1: C's _setjmp under another vole name (`#[link_name = "_setjmp"] fn
// save_point`) returns twice too: back::regalloc knows a function that
// returns twice by its symbol, which is the link name. (0.30.0 took it
// by the name vole calls it; this case passes on 0.30.0 as well, a pin:
// the assembly differs, -O2 keeping more of the frame across the call, but
// no program found shows it in its output.)
// As opt_setjmp: values live across it must survive the longjmps (from
// recursive calls that reuse every register), whatever registers and
// spill slots the code after it used in between. Only what C guarantees
// is printed: globals, and locals not modified between setjmp and longjmp.
// EXPECT: 6032 1400 41
// EXPECT: 10052 2520 65
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
    #[link_name = "_setjmp"]
    fn save_point(env: *mut u64) -> i32;
    #[link_name = "_longjmp"]
    fn jump_back(env: *mut u64, value: i32) -> !;
}

static mut ENV: [u64; 64] = [0; 64];
static mut COUNT: i64 = 0;

fn deep(n: i64, a: i64, b: i64, c: i64) -> i64 {
    if n == 0 {
        unsafe { COUNT += 1; }
        unsafe { jump_back((*(&raw mut ENV)).as_mut_ptr() as *mut u64, (1 + COUNT) as i32); }
    }
    let x = deep(n - 1, b, c, a * 3 + 1);
    x + a * b - c
}

fn run(limit: i64) -> i64 {
    unsafe { COUNT = 0; }
    let a = limit * 3;
    let b = limit + 7;
    let x0 = limit * 10; let x1 = limit * 11; let x2 = limit * 12; let x3 = limit * 13;
    let x4 = limit * 14; let x5 = limit * 15; let x6 = limit * 16; let x7 = limit * 17;
    let x8 = limit * 18; let x9 = limit * 19; let y0 = limit * 20; let y1 = limit * 21;
    let y2 = limit * 22; let y3 = limit * 23; let y4 = limit * 24; let y5 = limit * 25;
    let r = unsafe { save_point((*(&raw mut ENV)).as_mut_ptr() as *mut u64) };
    if unsafe { COUNT } < limit {
        let junk = deep(unsafe { COUNT } + 2, x0, x1, x2);
        unsafe { printf(c"unreachable %ld\n", junk); }
    }
    let sum = x0 + x1 + x2 + x3 + x4 + x5 + x6 + x7 + x8 + x9
        + y0 + y1 + y2 + y3 + y4 + y5;
    unsafe { printf(c"%ld %ld %ld\n", r as i64 * 1000 + a + b + COUNT, sum, r as i64 * 6 + 5); }
    r as i64
}

fn main() -> i32 {
    run(5);
    run(9);
    0
}
