// (0.27.7) the 0.27 translator's version of tests/refactor/edition0277t6
// (formatted): an integer method on literals, `(1 << n).wrapping_sub(1)`,
// gets the leftmost literal suffixed with MVS's i64 (T6); rustc builds it
// too, and it prints what the MVS program does.
// EXPECT: 1099511627775 9223372036854775807 25 -7
fn run(ones: i64) -> i64 {
    (1i64 << ones).wrapping_sub(1)
}

fn main() {
    let a = run(40);
    let b = (1i64 << (a & 63) as u64).wrapping_sub(1);
    let c = (2i64 + 3).pow(2u32);
    let d = (0i64 - 1).wrapping_mul(7);
    println("{} {} {} {}", a, b, c, d);
}
