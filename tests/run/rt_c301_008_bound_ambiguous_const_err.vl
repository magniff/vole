// RULE: F8.3, F9.3
// `T::K` with `T: A + B`, both declaring K: rustc E0034. 0.30.1 took A's.
// ERROR: error[method.ambiguous]: multiple applicable items: 'K' is an item of more than one trait for 'T'
trait A { const K: i64; }
trait B { const K: i64; }
struct S;
impl A for S { const K: i64 = 1; }
impl B for S { const K: i64 = 2; }
fn f<T: A + B>() -> i64 { T::K }
fn main() { println("{}", f::<S>()); }
