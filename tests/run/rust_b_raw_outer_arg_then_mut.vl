// EDITION: rust
// RULE: D3.6
// (0.27.6) The other way round: the outer call's `*mut` argument makes no
// loan, so an inner call that reborrows the same `cx` as `&mut` is no
// conflict (rustc accepts and prints 5; 0.27.5 called it a conflict).
// EXPECT: 5
struct C {
    x: i64,
}

fn outer(cx: *mut C, v: i64) -> i64 {
    // UNSAFE: the test's raw pointer, as middle/ir's ir_val takes it
    // SAFETY: cx points to the live C main made; nothing else uses it here
    unsafe { (*cx).x + v }
}

fn inner(cx: &mut C, v: i64) -> i64 {
    cx.x + v
}

fn go(cx: &mut C, v: i64) -> i64 {
    outer(cx, inner(cx, v))
}

fn main() {
    let mut c = C { x: 1 };
    println("{}", go(&mut c, 3));
}
