// RULE: F18.5
// (0.30.2) Integer variables through places: a struct's i64 field, a Vec
// whose element a later `let b: u8` types, a `while` counter compared with
// a usize, and `s += e` of an `e: &i64`.
// EXPECT: 4000000000 7 3 6000000000
struct S {
    x: i64,
}

fn main(gpa: Gpa) {
    let h = 2000000000;
    let st = S { x: h + h };
    let mut w = Vec::new_in(gpa);
    w.push(7);
    let wb: u8 = w[0];
    let v = [3000000000i64, 3000000000, 0];
    let mut i = 0;
    while i < v.len() {
        i += 1;
    }
    let mut s = 0;
    for e in v.iter() {
        s += e;
    }
    println("{} {wb} {i} {s}", st.x);
}
