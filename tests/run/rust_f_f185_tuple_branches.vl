// RULE: F18.5
// (0.27.6) Where no type is expected, a tuple element the earlier branches
// of a `match` or an `if` give by literals alone takes a later branch's
// type there: `(gap, 0)` then `(0, gap)` is `(usize, usize)` (0.27.5 typed
// the first `(usize, i32)` and refused the rest).
// EXPECT: 500 203 5 3 3 5 6 7
fn split(k: i64, gap: usize) -> usize {
    let (before, after) = match k {
        0 => (gap, 0),
        1 => (gap / 2, gap - gap / 2),
        _ => (0, gap),
    };
    before * 100 + after
}

fn late(k: i64, gap: usize) -> usize {
    let p = match k {
        0 => (1, 0),
        1 => (2, 0),
        _ => (0, gap),
    };
    p.0 as usize + p.1
}

fn main() {
    let gap: usize = 5;
    let p = if gap > 2 { (gap, 0) } else { (0, gap) };
    let q = if gap > 9 { (0, 1) } else { (gap, 2u8) };
    let r = match gap { 5 => (0, 0), _ => (1, 1) };
    let s: i32 = r.0 + r.1 + 6;
    println("{} {} {} {} {} {} {} {}", split(0, 5), split(1, 5), split(2, 5),
        late(0, 5) + late(1, 5), p.0 + p.1 - 2, q.0 + q.1 as usize - 2, s, late(2, 7));
}
