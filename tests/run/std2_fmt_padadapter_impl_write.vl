// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::fmt PadAdapter::impl Write.
// EXPECT: Outer {
// EXPECT:     inner: In {
// EXPECT:         v: [
// EXPECT:             1,
// EXPECT:             2,
// EXPECT:         ],
// EXPECT:     },
// EXPECT: }
use std::fmt::{Debug, Formatter};

struct In {
    v: [i64; 2],
}

impl Debug for In {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("In").field("v", &self.v).finish()
    }
}

struct Outer {
    inner: In,
}

impl Debug for Outer {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Outer").field("inner", &self.inner).finish()
    }
}

fn main() {
    println("{:#?}", Outer { inner: In { v: [1, 2] } });
}
