// `a` borrows the arena (`Vec<_, &Arena<Gpa>>`) and is dropped at the
// end of main, where its drop drops its Boxes and gives its block back
// to the arena: a use of `&ar`. Before 0.30.1 the borrow checker took
// `a`'s last use for the println, so `ar.reset()` (a `&mut ar`) passed;
// the arena's memory was then handed to `c`, which filled it, and `a`'s
// drop freed the Boxes it read from there (SIGSEGV, exit 139). rustc: E0502,
// cannot borrow `ar` as mutable because it is also borrowed as immutable
// (the borrow later used here, when `a` is dropped).
// ERROR: error[borrowck.conflict]
// ERROR: line 21, column 5
// ERROR-COUNT: 1
use std::alloc::Arena;

fn main(gpa: Gpa) {
    let mut ar = Arena::new_in(gpa);
    let mut a: Vec<Box<i64, Gpa>, &Arena<Gpa>> = Vec::new_in(&ar);
    for i in 0..4 {
        a.push(Box::new_in(i, gpa));
    }
    println("{}", a.len());
    ar.reset();
    let mut c: Vec<u64, &Arena<Gpa>> = Vec::new_in(&ar);
    for _ in 0..64 {
        c.push(0x4141414141414141);
    }
    println("reset {}", c.len());
}
