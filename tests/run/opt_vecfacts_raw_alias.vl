// EXPECT: static 86570
// EXPECT: copy 344
// EXPECT: nested 900
// EXPECT: held 4 4
// (0.25.4) A Vec reached through a raw pointer too, in unsafe code: what
// is written through the pointer is what the Vec's own name reads next
// (middle::vecfacts is about a let parameter's Vec, which nothing may
// change during the call, and about a Vec's own buffer, which cannot
// hold its header; neither covers these). A local Vec pushed to through
// a static's raw pointer, inlined and in a function of its own; its
// header copied into plain memory, its buffer written through that copy's
// pointer; an element of a Vec<Vec<i64>> pushed to through a raw pointer
// while its length is read through the outer Vec; a local Vec truncated
// through a pointer to it held in another Vec's buffer (an access made
// from a buffer's pointer, but not that Vec's own header).
// FLAGS: --check-alloc
static var P: *Vec<i64> = 0 as *Vec<i64>;

#[inline(never)]
fn bump(x: i64) {
    // UNSAFE: the Vec main lends through P.
    // SAFETY: P points to main's live Vec, which nothing else accesses
    // during the call.
    unsafe { (*P).push(x); }
}

#[inline(never)]
fn through_static(gpa: Gpa) -> i64 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    // UNSAFE: a raw pointer to v kept in a static.
    // SAFETY: v outlives every use of P below.
    unsafe { P = &v as *Vec<i64>; }
    var s = 0;
    for i in 0..20 {
        // UNSAFE: v's push, through P.
        // SAFETY: P points to v, live.
        unsafe { (*P).push(i); }
        s += v.len() as i64 * 100 + v[v.len() - 1];
        bump(i * 2);
        s += v.len() as i64 * 100 + v[v.len() - 1];
    }
    s
}

#[inline(never)]
fn through_copy(gpa: Gpa) -> i64 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..8 {
        v.push(i);
    }
    // UNSAFE: the header's bytes read as plain words.
    // SAFETY: a Vec's header is 24 bytes, its first word the buffer.
    let words = unsafe { *(&v as *[u64; 3]) };
    // UNSAFE: the word back to the pointer it was.
    // SAFETY: it is v's buffer, live while v does not grow.
    let q = unsafe { words[0] as *i64 };
    var s = 0;
    for i in 0..v.len() {
        // UNSAFE: v's element i, through a copy of its pointer.
        // SAFETY: i < len; the buffer does not move in the loop.
        unsafe { q[i] = q[i] * 10; }
        s += v[i] + v.len() as i64;
    }
    s
}

#[inline(never)]
fn nested(gpa: Gpa) -> i64 {
    var vv: Vec<Vec<i64>> = Vec::new_in(gpa);
    for _ in 0..3 {
        vv.push(Vec::new_in(gpa));
    }
    // UNSAFE: a raw pointer to vv's element 1.
    // SAFETY: vv does not grow below, so its buffer stays.
    let p = unsafe { &vv[1] as *Vec<i64> };
    var s = 0;
    for i in 0..30 {
        // UNSAFE: vv[1]'s push, through p.
        // SAFETY: p points to vv[1], live.
        unsafe { (*p).push(i); }
        s += vv[1].len() as i64 + vv[1][vv[1].len() - 1] + vv[0].len() as i64;
    }
    s
}

#[inline(never)]
fn held(gpa: Gpa) -> i64 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..10 {
        v.push(1);
    }
    var ptrs: Vec<*Vec<i64>> = Vec::new_in(gpa);
    ptrs.push(&v as *Vec<i64>);
    var i = 0;
    var s = 0;
    while i < v.len() as i64 {
        if i == 2 {
            // UNSAFE: v's truncate through the pointer ptrs holds (no
            // call: only its length is written).
            // SAFETY: ptrs[0] points to v, live.
            unsafe { (*ptrs[0]).truncate(4); }
        }
        s += v[i];
        i += 1;
    }
    s * 1000 + i
}

fn main(gpa: Gpa) {
    println("static {}", through_static(gpa));
    println("copy {}", through_copy(gpa));
    println("nested {}", nested(gpa));
    let h = held(gpa);
    println("held {} {}", h / 1000, h % 1000);
}
