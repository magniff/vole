// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::boxed Box::impl Hash.
// EXPECT: 7 true
use std::boxed::Box;
use std::hash::{Hash, Hasher};

struct Sum {
    n: u64,
}

impl Hasher for Sum {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.n += *b as u64;
        }
    }
}

fn main(gpa: Gpa) {
    let mut h1 = Sum { n: 0 };
    let mut h2 = Sum { n: 0 };
    Box::new_in(7i64, gpa).hash(&mut h1);
    7i64.hash(&mut h2);
    println("{} {}", h1.finish(), h1.finish() == h2.finish());
}
