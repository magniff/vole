// RULE: D2.7
// (0.30.1, RT-33) `s.sort_unstable()` of an `s: &[i64]`: rustc's E0596.
// (A guard: 0.30.0 and release-0.30.1 refused it already.)
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 8, column 5
// ERROR-COUNT: 1
fn k(s: &[i64]) {
    s.sort_unstable();
}

fn main() {
    let a = [2i64, 1];
    k(&a[..]);
    println("{} {}", a[0], a[1]);
}
