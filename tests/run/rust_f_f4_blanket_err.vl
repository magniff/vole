// RULE: F4.1
// A blanket impl applies only where its bound holds: `U: Show` does not,
// so `U` has no `describe`.
// ERROR: no method 'describe' on type 'U'
trait Show {
    fn show(&self) -> i64;
}

trait Describe {
    fn describe(&self) -> i64;
}

impl<T: Show> Describe for T {
    fn describe(&self) -> i64 {
        self.show()
    }
}

struct U {
    n: i64,
}

fn main() -> i64 {
    let u = U { n: 1 };
    u.describe()
}
