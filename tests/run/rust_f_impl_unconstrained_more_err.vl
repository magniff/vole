// (0.30.1, review 4) What does not constrain an impl's parameter (rustc
// E0207): a lifetime only its associated type uses (`impl<'a> B2 for H {
// type X = &'a str; }`: H::X would be `&'a str` for every 'a, 'static
// too), a type parameter only in a projection of the header (`W<<T as
// B2>::X>`, `W<T::Y>`: many T give the one type), and one only in a
// bound's trait argument (`U: Tr<T>`: U may implement Tr<i32> and
// Tr<i64>). Before, each was taken as constrained, and review 4's a35 let
// a borrowed str reach a thread through `<T as B2>::X` as 'static.
// ERROR: trait.unconstrained
// ERROR: trait.unconstrained
// ERROR: trait.unconstrained
// ERROR: trait.unconstrained
// ERROR-COUNT: 4
trait B2 {
    type X;
}

trait B3 {
    type Y;
}

trait Tr<T> {}

trait St {
    fn n(&self) -> i64;
}

struct H;

struct W<Y> {
    y: Y,
}

struct V<U> {
    u: U,
}

impl<'a> B2 for H {
    type X = &'a str;
}

impl<T: B2> St for W<<T as B2>::X> {
    fn n(&self) -> i64 {
        1
    }
}

impl<T: B3> B3 for V<T::Y> {
    type Y = i64;
}

impl<T, U: Tr<T>> St for V<U> {
    fn n(&self) -> i64 {
        2
    }
}

fn main() {}
