// RT-CG-5 (fixed in 0.30.1): a parallel move's cycle through two spill slots, one read as an integer and the other as an f64, saved the integer in the float cycle register and stored it back as `str x63`, which is xzr: the next iteration read n as 0
// FLAGS: -O1
// An output guard: at this level the program makes no such cycle (its
// -O2 case does), so it passes on the release branch too.
// EXPECT: 5 411.0390625 7 23.566882649685752
// The back edge of the loop moves x2 (f64) into x's slot and n2 (i64)
// into n's, and the allocator gave x2 n's slot and n2 x's (a spill slot is
// shared by values of either class): a cycle. Its break saved the slot's
// value by the type of the move writing it (f64), and the move reading it
// stored an integer from d31. rustc prints the EXPECT line; the release
// branch printed `5 7 ...` at -O2 (u = 0 + c in every iteration).
// The fillers a* and b* keep both register classes full across the calls,
// so that the four values live in slots at the edge.
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[inline(never)]
fn g(a: i64) -> i64 { K.fetch_add(1, Ordering::Relaxed); a ^ 5 }

fn main() {
    let lim = g(0) + 1;
    let a0 = g(0);
    let a1 = g(2);
    let a2 = g(3);
    let a3 = g(4);
    let a4 = g(5);
    let a5 = g(6);
    let a6 = g(8);
    let a7 = g(9);
    let a8 = g(10);
    let a9 = g(11);
    let a10 = g(12);
    let a11 = g(17);
    let a12 = g(18);
    let a13 = g(20);
    let a14 = g(21);
    let a15 = g(22);
    let a16 = g(23);
    let a17 = g(24);
    let a18 = g(27);
    let a19 = g(29);
    let a20 = g(30);
    let a21 = g(31);
    let a22 = g(32);
    let a23 = g(33);
    let a24 = g(35);
    let b0 = g(1) as f64 * 0.5;
    let b1 = g(2) as f64 * 0.5;
    let b2 = g(3) as f64 * 0.5;
    let b3 = g(4) as f64 * 0.5;
    let b4 = g(5) as f64 * 0.5;
    let b5 = g(6) as f64 * 0.5;
    let b6 = g(8) as f64 * 0.5;
    let b7 = g(9) as f64 * 0.5;
    let b8 = g(11) as f64 * 0.5;
    let b9 = g(12) as f64 * 0.5;
    let b10 = g(13) as f64 * 0.5;
    let b11 = g(16) as f64 * 0.5;
    let b12 = g(17) as f64 * 0.5;
    let b13 = g(18) as f64 * 0.5;
    let b14 = g(19) as f64 * 0.5;
    let b15 = g(20) as f64 * 0.5;
    let b16 = g(21) as f64 * 0.5;
    let b17 = g(22) as f64 * 0.5;
    let b18 = g(23) as f64 * 0.5;
    let b19 = g(24) as f64 * 0.5;
    let b20 = g(30) as f64 * 0.5;
    let b21 = g(31) as f64 * 0.5;
    let b22 = g(32) as f64 * 0.5;
    let b23 = g(33) as f64 * 0.5;
    let b24 = g(34) as f64 * 0.5;
    let b25 = g(35) as f64 * 0.5;
    let b26 = g(36) as f64 * 0.5;
    let b27 = g(37) as f64 * 0.5;
    let b28 = g(38) as f64 * 0.5;
    let mut n: i64 = 1;
    let mut x: f64 = 0.5;
    let mut t: i64 = 0;
    let mut s: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        s = s ^ (a0 + t);
        s = s ^ (a5 + t);
        s = s ^ (a6 + t);
        s = s ^ (a7 + t);
        s = s ^ (a8 + t);
        s = s ^ (a9 + t);
        s = s ^ (a10 + t);
        s = s ^ (a11 + t);
        s = s ^ (a12 + t);
        s = s ^ (a13 + t);
        s = s ^ (a14 + t);
        s = s ^ (a15 + t);
        s = s ^ (a16 + t);
        s = s ^ (a17 + t);
        sf = sf * 0.5 + b20;
        sf = sf * 0.5 + b21;
        sf = sf * 0.5 + b22;
        sf = sf * 0.5 + b23;
        sf = sf * 0.5 + b24;
        sf = sf * 0.5 + b25;
        sf = sf * 0.5 + b26;
        sf = sf * 0.5 + b27;
        let c = g(t);
        let v = x * 1.5 + (c as f64);
        let n2 = (c * 3) ^ t;
        let u = n + c;
        let x2 = v + (u as f64);
        let e = g(t + 1);
        s = s ^ (a1 + t);
        s = s ^ (a2 + t);
        s = s ^ (a3 + t);
        s = s ^ (a4 + t);
        s = s ^ (a18 + t);
        s = s ^ (a19 + t);
        s = s ^ (a20 + t);
        s = s ^ (a21 + t);
        s = s ^ (a22 + t);
        s = s ^ (a23 + t);
        s = s ^ (a24 + t);
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b1;
        sf = sf * 0.5 + b2;
        sf = sf * 0.5 + b3;
        sf = sf * 0.5 + b4;
        sf = sf * 0.5 + b5;
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b7;
        sf = sf * 0.5 + b8;
        sf = sf * 0.5 + b9;
        sf = sf * 0.5 + b10;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b12;
        sf = sf * 0.5 + b13;
        sf = sf * 0.5 + b14;
        sf = sf * 0.5 + b15;
        sf = sf * 0.5 + b16;
        sf = sf * 0.5 + b17;
        sf = sf * 0.5 + b18;
        sf = sf * 0.5 + b19;
        n = n2;
        x = x2;
        t += 1;
    }
    println("{n} {x} {s} {sf}");
}
