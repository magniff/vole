// 0.30: an assignment through a Box drops the value that was there, as
// `*r = v` through a `&mut` does (0.29 leaked it: `*b` is
// `*b.deref_mut()`, a place under a call's result, and only places of
// names, fields, `*` and indexes dropped): after the right side, before
// the write, once. `*b`, `**b` of a Box in a Box, a field with and
// without the `*`, an index of a Box's Vec and of its array.
// FLAGS: --check-alloc
// EXPECT: whole
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: d1
// EXPECT: --
// EXPECT: d2
// EXPECT: nested
// EXPECT: mk3
// EXPECT: mk4
// EXPECT: d3
// EXPECT: --
// EXPECT: mk5
// EXPECT: d4
// EXPECT: --
// EXPECT: d5
// EXPECT: field
// EXPECT: mk6
// EXPECT: mk7
// EXPECT: d6
// EXPECT: --
// EXPECT: mk8
// EXPECT: d7
// EXPECT: --
// EXPECT: mk9
// EXPECT: d8
// EXPECT: --
// EXPECT: d9
// EXPECT: index
// EXPECT: mk10
// EXPECT: mk11
// EXPECT: d10
// EXPECT: --
// EXPECT: mk12
// EXPECT: d11
// EXPECT: --
// EXPECT: mk13
// EXPECT: mk14
// EXPECT: mk15
// EXPECT: d14
// EXPECT: --
// EXPECT: d13
// EXPECT: d15
// EXPECT: d12
// EXPECT: heap
// EXPECT: 200
// EXPECT: end

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

fn sevens(n: usize, gpa: Gpa) -> Vec<u32, Gpa> {
    let mut v = Vec::new_in(gpa);
    for _ in 0..n { v.push(7u32); }
    v
}

struct H { f: T, n: i64 }

fn main(gpa: Gpa) -> i32 {
    println("whole");
    {
        let mut b = Box::new_in(mk(1), gpa);
        *b = mk(2);
        println("--");
    }
    println("nested");
    {
        let mut b = Box::new_in(Box::new_in(mk(3), gpa), gpa);
        **b = mk(4);
        println("--");
        *b = Box::new_in(mk(5), gpa);
        println("--");
    }
    println("field");
    {
        let mut b = Box::new_in(H { f: mk(6), n: 0 }, gpa);
        (*b).f = mk(7);
        println("--");
        b.f = mk(8);
        b.n = 1;
        println("--");
        *b = H { f: mk(9), n: 2 };
        println("--");
    }
    println("index");
    {
        let mut v: Vec<T, Gpa> = Vec::new_in(gpa);
        v.push(mk(10));
        let mut b = Box::new_in(v, gpa);
        b[0] = mk(11);
        println("--");
        (*b)[0] = mk(12);
        println("--");
        let mut a = Box::new_in([mk(13), mk(14)], gpa);
        a[1] = mk(15);
        println("--");
    }
    println("heap");
    {
        let mut b = Box::new_in(sevens(100, gpa), gpa);
        *b = sevens(200, gpa);
        println("{}", b.len());
    }
    println("end");
    0
}
