// a sink closure owns its copy of n; a copy of the closure is independent (MVS)
// FLAGS: --check-alloc
// EXPECT: 2 3 2 1
fn main() {
    let mut n: i64 = 1;
    let mut c = move || { n += 1; n };
    let mut d = c;
    let x = c();
    let y = c();
    let z = d();
    println("{x} {y} {z} {n}");
}
