// EDITION: rust
// XFAIL: gap 2: compile type error: undefined variable 'forget'
// 0.17: the prelude's Drop, drop, forget, needs_drop and Copy, and
// std::take and std::replace; drop(n) runs n's drop, forget(n) does not;
// needs_drop folds; #[views] and #[stores] declare summaries.
// EXPECT: drop 1
// EXPECT: true 3
// EXPECT: 5 7 4 0 h a
use std::mem; struct Noisy { id: i64 }

impl Drop for Noisy {
    fn drop(&mut self) { println("drop {}", self.id); }
}

#[derive(Clone, Copy)] struct Z { n: i64 }
impl std::default::Default for Z { fn default() -> Z { Z { n: 0 } } }
fn same<T: Copy>(x: T) -> T { x }
#[derive(Clone, Copy)] struct Scan<'a> { text: &'a str, pos: i64 }

impl<'a> Scan<'a> {
    #[views(*self)]
    fn word(&mut self) -> &str {
        let a = self.pos; self.pos += 1; &self.text[a as usize..(a + 1) as usize]
    }
}

#[views(s)]
#[stores()]
fn first(s: &str) -> &str { &s[0..1] }

fn main() {
    let n = Noisy { id: 1 };
    drop(n);
    forget(Noisy { id: 2 });
    println("{} {}", needs_drop::<Noisy>(), same(3i64));
    let mut x: i64 = 5;
    let old = mem::replace(&mut x, 7i64);
    let mut z = Z { n: 4 };
    let t = mem::take(&mut z);
    let abc = "abc";
    let mut sc = Scan { text: "hello", pos: 0 };
    println("{old} {x} {} {} {} {}", t.n, z.n, sc.word(), first(abc));
}
