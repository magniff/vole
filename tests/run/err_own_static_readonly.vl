    unsafe {
        COUNT += 1;
        TABLE[0] = x;
    }
    unsafe { COUNT }
}

fn zero(s: &[i64]) { s[0] = 0; }
fn set(p: &Vec<i64, Gpa>, q: Vec<i64, Gpa>) { *p = q; }

