// (0.28.0) `--edition rust` on the command line is accepted and ignored:
// there is one edition. The option is deprecated and goes in 0.29, and
// this case with it. (0.27.0's case of the option, when it chose Rust's
// meanings.)

fn incr(r: &mut i64) {
    *r += 1;
}

fn main() -> i32 {
    let mut n = 41;
    incr(&mut n);
    println("{n}");
    0
}
// FLAGS: --edition rust
// EXPECT: 42
