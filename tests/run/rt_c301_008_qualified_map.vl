// RULE: F8.4
// RT-C301-8: `<S as A>::m` passed straight to a `map`: Option's, and a
// generic function's `F: Fn(&S) -> i64`. (Iterator's `map` of a fn item
// is refused for another reason: iter_map_fn_item_ref's XFAIL.) 0.30.1
// printed `Some(3) Some(3)` and `3 3`. rustc prints these lines.
// EXPECT: Some(3) Some(300)
// EXPECT: 3 300
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S { v: i64 }
impl A for S { fn m(&self) -> i64 { self.v } }
impl B for S { fn m(&self) -> i64 { self.v * 100 } }
fn map<F: Fn(&S) -> i64>(s: &S, f: F) -> i64 { f(s) }

fn main() {
    let s = S { v: 3 };
    println("{:?} {:?}", Some(&s).map(<S as A>::m), Some(&s).map(<S as B>::m));
    println("{} {}", map(&s, <S as A>::m), map(&s, <S as B>::m));
}
