// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice [T]::split.
// EXPECT: [1] [2, 3] []

fn main() {
    let s: &[i64] = &[1, 0, 2, 3, 0];
    let mut it = s.split(|x| *x == 0);
    println("{:?} {:?} {:?}", it.next().unwrap(), it.next().unwrap(), it.next().unwrap());
}
