// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string FromUtf8Error::as_bytes.
// EXPECT: [255]
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let r = String::from_utf8(Vec::from_in([255u8], gpa));
    if let Err(e) = r {
        println("{:?}", e.as_bytes());
    }
}
