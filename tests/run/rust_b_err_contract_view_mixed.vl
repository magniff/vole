// RULE: D7.4
// FLAGS: --check-alloc
// (0.30.1) A contract call binds a view argument by its parameter's type:
// a `&[T]` parameter's is a shared reborrow, so one view given for a
// `&mut [T]` and a `&[T]` parameter is a mutable borrow while a shared one
// is live, rustc's E0502: `f(s, s)` with a `requires`, and std's
// `copy_from_slice` and `clone_from_slice` given their receiver. Before,
// the shared parameter's binding copied the view with no loan: f read a
// freed Vec (--check-alloc: a use after free), and copy_from_slice called
// copy_nonoverlapping on one range.
// ERROR: error[borrowck.conflict]
// ERROR: line 31, column 19
// ERROR: error[borrowck.conflict]
// ERROR: line 33, column 5
// ERROR: error[borrowck.conflict]
// ERROR: line 37, column 5
// ERROR-COUNT: 3
fn f(a: &mut [Vec<i64, Gpa>], b: &[Vec<i64, Gpa>], gpa: Gpa) -> i64
    requires a.len() == b.len()
{
    let r: &i64 = &b[0][0];
    a[0] = Vec::new_in(gpa);
    *r
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let mut arr = [v];
    let s: &mut [Vec<i64, Gpa>] = &mut arr;
    println("{}", f(s, s, gpa));
    let t: &mut [i64] = &mut [1i64, 2];
    t.copy_from_slice(t);
    println("{}", t[0]);
    let mut w = [3i64, 4];
    let u: &mut [i64] = &mut w;
    u.clone_from_slice(u);
    println("{}", u[0]);
}
