// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet::replace.
// EXPECT: None Some(5) 1
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    let a = s.replace(5);
    let b = s.replace(5);
    println("{:?} {:?} {}", a, b, s.len());
}
