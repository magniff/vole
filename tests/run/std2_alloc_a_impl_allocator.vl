// The std2 item(s): std::alloc &A::impl Allocator.
// EXPECT: [1] 4
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let r: &Arena<Gpa> = &arena;
    let mut v: Vec<i32, &Arena<Gpa>> = Vec::with_capacity_in(1, r);
    v.push(1);
    println("{:?} {}", v, arena.used());
}
