// RULE: D22.1a
// (0.27.2.1) A call of an `F: Fn(i32) -> i32` value is a call of the
// bound's signature.
// EXPECT: 3
fn apply<F: Fn(i32) -> i32>(f: F, x: i32) -> i32 {
    f(x)
}

fn unused<F: Fn(i32) -> i32>(f: F) -> i32 {
    f(1) + f(2)
}

fn main() {
    println("{}", apply(|x| x + 1, 2));
}
