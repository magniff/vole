// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Read::read.
// EXPECT: 2 [1, 2] 1 0
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut buf = [0u8; 2];
    let a = r.read(&mut buf).unwrap();
    let b = r.read(&mut buf).unwrap();
    let c = r.read(&mut buf).unwrap();
    println("{} {:?} {} {}", a, [1u8, 2], b, c);
}
