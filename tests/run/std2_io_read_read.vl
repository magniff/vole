// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io Read::read.
// EXPECT: 2 [1, 2] 1 0
use std::io::{BufRead, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut buf = [0u8; 2];
    let a = r.read(&mut buf).unwrap();
    let b = r.read(&mut buf).unwrap();
    let c = r.read(&mut buf).unwrap();
    println("{} {:?} {} {}", a, [1u8, 2], b, c);
}
