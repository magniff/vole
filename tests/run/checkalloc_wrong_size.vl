// EDITION: rust
// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: 9
// STDERR: wrong-size free: block #1 (48 bytes), allocated at
// STDERR: checkalloc_wrong_size.vl:11:13, freed as 40 bytes at
// STDERR: checkalloc_wrong_size.vl:18:9
// 0.16: --check-alloc: a free through the Allocator interface gives the
// size it was allocated with.
use std::alloc::Layout; use std::ptr::NonNull; fn main(gpa: Gpa) {
    let p = gpa
        .allocate(Layout::from_size_align(48 as usize, 8 as usize).unwrap())
        .unwrap()
        .as_ptr();
    unsafe {
        (*p.add(0)) = 9;
        println("{}", (*p.add(0)));
        gpa.deallocate(NonNull::new(p).unwrap(),
            Layout::from_size_align(40 as usize, 8 as usize).unwrap());
    }
}
