// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Arena::with_capacity_in.
// EXPECT: 0 true
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::with_capacity_in(1000, gpa);
    println("{} {}", arena.used(), arena.allocated_bytes() >= 1000);
}
