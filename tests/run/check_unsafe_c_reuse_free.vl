// FLAGS: --check-unsafe
// EXPECT: done
// 0.30.1: a Vec of Gpa freed, then C's strdup, whose copy C's free frees:
// not `a block freed twice` (the copy is C's block, never the check's;
// the Vec's memory is held back from C while the check counts it freed).
extern "C" {
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::with_capacity_in(8, gpa);
    v.push(1);
    drop(v);
    // UNSAFE: C's strdup and free.
    // SAFETY: strdup's result freed once by free.
    unsafe {
        let p = strdup(c"abcdefg" as *const u8);
        free(p);
    }
    println("done");
}
