use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m = HashMap::with_hasher_in(FixedState::new(), gpa);
    m.insert(1i64, 2i64);
    println("{:?}", m.get(&1));
}
