// RT-CG-6 (fixed in 0.30.1): two cycles of one edge's moves that need the same cycle register at once: the second save goes to cells after the spill slots (reserve_save_cells counts them before the frame) (tests/fuzz/run.sh -M -V, seed 208, x86-64 -O2)
// FLAGS: -O0
// EXPECT: 52
// EXPECT: 28
// EXPECT: 16
// EXPECT: 9.201171875
// EXPECT: 8
// EXPECT: 80
// EXPECT: 20
// EXPECT: 2
// EXPECT: 40
// EXPECT: 112
// EXPECT: 3.375
// EXPECT: 3
// EXPECT: 40 64.35264629688325
// At -O2 the release branch printed other values, on AArch64 and on x86-64
// (`tests/run.sh -t x86_64-macos -n rt_cg_006_second_cycle_save_o2`), and a build that ordered
// the moves by cells but had no place for a second save stopped with "parallel move cycle
// register in use". The EXPECT lines are -O0's, which allocates no
// registers; the -O0 case guards them.
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[inline(never)]
fn g(a: i64) -> i64 {
    K.fetch_add(1, Ordering::Relaxed);
    a ^ 5
}

fn main() {
    let lim = (g(7) & 15) + 3;
    let a0 = g(20);
    let a1 = g(21);
    let a2 = g(22);
    let a3 = g(23);
    let a4 = g(24);
    let a5 = g(25);
    let a6 = g(26);
    let a7 = g(27);
    let a8 = g(28);
    let a9 = g(29);
    let a10 = g(30);
    let a11 = g(31);
    let a12 = g(32);
    let a13 = g(33);
    let a14 = g(34);
    let a15 = g(35);
    let a16 = g(36);
    let a17 = g(37);
    let a18 = g(38);
    let b0 = (g(40) as f64) * 0.5;
    let b1 = (g(41) as f64) * 0.5;
    let b2 = (g(42) as f64) * 0.5;
    let b3 = (g(43) as f64) * 0.5;
    let b4 = (g(44) as f64) * 0.5;
    let b5 = (g(45) as f64) * 0.5;
    let b6 = (g(46) as f64) * 0.5;
    let b7 = (g(47) as f64) * 0.5;
    let b8 = (g(48) as f64) * 0.5;
    let b9 = (g(49) as f64) * 0.5;
    let b10 = (g(50) as f64) * 0.5;
    let b11 = (g(51) as f64) * 0.5;
    let b12 = (g(52) as f64) * 0.5;
    let b13 = (g(53) as f64) * 0.5;
    let b14 = (g(54) as f64) * 0.5;
    let b15 = (g(55) as f64) * 0.5;
    let b16 = (g(56) as f64) * 0.5;
    let b17 = (g(57) as f64) * 0.5;
    let b18 = (g(58) as f64) * 0.5;
    let b19 = (g(59) as f64) * 0.5;
    let b20 = (g(60) as f64) * 0.5;
    let b21 = (g(61) as f64) * 0.5;
    let b22 = (g(62) as f64) * 0.5;
    let b23 = (g(63) as f64) * 0.5;
    let b24 = (g(64) as f64) * 0.5;
    let b25 = (g(65) as f64) * 0.5;
    let b26 = (g(66) as f64) * 0.5;
    let b27 = (g(67) as f64) * 0.5;
    let b28 = (g(68) as f64) * 0.5;
    let mut v0: v4i32 = v4i32::splat((g(0) & 15) as i32);
    let mut v1: v4i32 = v4i32::splat((g(1) & 15) as i32);
    let mut v2: v8u8 = v8u8::splat((g(2) & 15) as u8);
    let mut v3: v4f64 = v4f64::splat((g(3) as f64) * 0.5);
    let mut v4: v4i32 = v4i32::splat((g(4) & 15) as i32);
    let mut v5: v8u8 = v8u8::splat((g(5) & 15) as u8);
    let mut v6: i64 = g(17);
    let mut v7: v2f64 = v2f64::splat((g(7) as f64) * 0.5);
    let mut v8: v8u8 = v8u8::splat((g(8) & 15) as u8);
    let mut v9: v8u8 = v8u8::splat((g(9) & 15) as u8);
    let mut v10: f64 = (g(12) as f64) * 0.375;
    let mut v11: f64 = (g(13) as f64) * 0.375;
    let mut t: i64 = 0;
    let mut s: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        s = s ^ (a0 + t);
        s = s ^ (a1 + t);
        s = s ^ (a2 + t);
        s = s ^ (a3 + t);
        s = s ^ (a4 + t);
        s = s ^ (a5 + t);
        s = s ^ (a6 + t);
        s = s ^ (a7 + t);
        s = s ^ (a9 + t);
        s = s ^ (a10 + t);
        s = s ^ (a12 + t);
        s = s ^ (a13 + t);
        s = s ^ (a14 + t);
        s = s ^ (a15 + t);
        s = s ^ (a16 + t);
        s = s ^ (a17 + t);
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b1;
        sf = sf * 0.5 + b2;
        sf = sf * 0.5 + b3;
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b8;
        sf = sf * 0.5 + b9;
        sf = sf * 0.5 + b10;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b12;
        sf = sf * 0.5 + b14;
        sf = sf * 0.5 + b15;
        sf = sf * 0.5 + b16;
        sf = sf * 0.5 + b17;
        sf = sf * 0.5 + b18;
        sf = sf * 0.5 + b21;
        sf = sf * 0.5 + b23;
        sf = sf * 0.5 + b25;
        sf = sf * 0.5 + b26;
        sf = sf * 0.5 + b27;
        sf = sf * 0.5 + b28;
        let c = g(t);
        v2 = ((v2 ^ v8u8::splat((c & 7) as u8)) + (v2 & v8u8::splat(3))) & v8u8::splat(15);
        s = s + g(t);
        v1 = ((v1 ^ v4i32::splat((c & 7) as i32)) + (v4 & v4i32::splat(3))) & v4i32::splat(15);
        { let tmp_r = v0; v0 = v1; v1 = v4; v4 = tmp_r; }
        s = s + g(t);
        { let tmp_r = v0; v0 = v1; v1 = tmp_r; }
        { let tmp_r = v1; v1 = v4; v4 = v0; v0 = tmp_r; }
        v2 = ((v2 ^ v8u8::splat((c & 7) as u8)) + (v5 & v8u8::splat(3))) & v8u8::splat(15);
        v2 = ((v2 ^ v8u8::splat((c & 7) as u8)) + (v9 & v8u8::splat(3))) & v8u8::splat(15);
        if (c & 3) == 0 {
            s = s + g(t);
            { let tmp_r = v0; v0 = v1; v1 = v4; v4 = tmp_r; }
            { let tmp_r = v2; v2 = v9; v9 = v5; v5 = v8; v8 = tmp_r; }
        } else {
            { let tmp_r = v10; v10 = v11; v11 = tmp_r; }
            v0 = ((v0 ^ v4i32::splat((c & 7) as i32)) + (v0 & v4i32::splat(3))) & v4i32::splat(15);
            s = s + g(t);
            { let tmp_r = v5; v5 = v2; v2 = v9; v9 = tmp_r; }
        }
        s = s ^ (a0 + t);
        s = s ^ (a1 + t);
        s = s ^ (a4 + t);
        s = s ^ (a6 + t);
        s = s ^ (a8 + t);
        s = s ^ (a9 + t);
        s = s ^ (a12 + t);
        s = s ^ (a14 + t);
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b7;
        sf = sf * 0.5 + b9;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b12;
        sf = sf * 0.5 + b13;
        sf = sf * 0.5 + b14;
        sf = sf * 0.5 + b16;
        sf = sf * 0.5 + b18;
        sf = sf * 0.5 + b19;
        sf = sf * 0.5 + b20;
        sf = sf * 0.5 + b21;
        sf = sf * 0.5 + b23;
        sf = sf * 0.5 + b26;
        let e = g(t + 1);
        { let tmp_r = v1; v1 = v4; v4 = tmp_r; }
        v2 = ((v2 ^ v8u8::splat((c & 7) as u8)) + (v2 & v8u8::splat(3))) & v8u8::splat(15);
        { let tmp_r = v8; v8 = v2; v2 = v9; v9 = tmp_r; }
        s = s + g(t);
        v3 = v3 * v4f64::splat(0.5) + v3 * v4f64::splat(0.25) + v4f64::splat((c as f64) * 0.125);
        s = s + e;
        t += 1;
    }
    println("{}", v0.sum());
    println("{}", v1.sum());
    println("{}", v2.sum());
    println("{}", v3.sum());
    println("{}", v4.sum());
    println("{}", v5.sum());
    println("{}", v6);
    println("{}", v7.sum());
    println("{}", v8.sum());
    println("{}", v9.sum());
    println("{}", v10);
    println("{}", v11);
    println("{} {}", s, sf);
}
