use std::alloc::Allocator; trait C {
    fn grow(&mut self);
    fn twice(&self) { self.grow(); self.grow(); }
}

struct S<A: Allocator> { v: Vec<i64, A> }
impl C for S<Gpa> { fn grow(&mut self) { for i in 0..1000 { self.v.push(i); } } }

fn main(gpa: Gpa) {
    let mut s = S { v: Vec::new_in(gpa) };
    s.v.push(7);
    let h = s.v.as_slice();
    s.twice();
    println("{} {}", h[0], s.v.len());
}
