// EDITION: rust
// RULE: D3.6
// (0.27.2) A `&mut T` or `&mut [T]` printed: the f-string's hidden binding
// reborrows it shared, as rustc's format_args takes `&r`; it is neither
// copied (I7) nor moved, and the reference is used again after.
fn show(r: &mut i64, s: &mut [i64]) {
    println("{} {}", r, *r);
    *r += 1;
    println("{:?}", s);
    s[0] = *r;
    println("{} {:?}", r, s);
}

fn main() {
    let mut x = 5i64;
    let mut a = [1i64, 2];
    show(&mut x, &mut a);
    println("{}", x);
}
// EXPECT: 5 5
// EXPECT: [1, 2]
// EXPECT: 6 [6, 2]
// EXPECT: 6
