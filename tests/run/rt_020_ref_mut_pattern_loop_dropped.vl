// RT-20 (fixed in 0.30.1): a `ref mut` binding of a counted while's variable is not a write: the loop is counted as ending, and -O2 deletes the call that never returns
// FLAGS: -O2
// `match i { ref mut r => *r = 0 }` writes i, so `while i < n { ..; i
// += 1 }` never ends for n >= 2. front::effects::infer::counted_step
// takes the loop as counted (local_used sees no write: a `ref mut`
// pattern is not an Assign or an `&mut`), so `spin` has no `diverge`
// and ipo::front_attrs gives it willreturn: -O2 deletes the call whose
// result is unused and prints `returned`. The watchdog thread shows the
// hang: -O0 prints `watchdog` and exits 3.
// EXPECT: watchdog
// EXIT: 3
use std::time::Duration;

#[inline(never)]
fn spin(n: i64) -> i64 {
    let mut i = 0i64;
    while i < n {
        match i {
            ref mut r => *r = 0,
        }
        i += 1;
    }
    i
}

fn main(gpa: Gpa) {
    let _w = std::thread::spawn_in(
        || {
            std::thread::sleep(Duration::from_millis(1500));
            println("watchdog");
            std::process::exit(3);
        },
        gpa);
    // no arguments: n is 2
    let n = std::env::args().count() as i64 + 1;
    let _x = spin(n);
    println("returned");
}
