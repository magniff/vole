// places IR, S9: for over an owned Vec temporary: __for_seq dropped after the loop
// sem-own: `for x in mkv(gpa)`: the Vec the call returns is a temporary,
// dropped after the loop with its items (a plain Vec<i64> leaks its buffer
// the same way: --check-alloc reports it).
// EXPECT: it 1
// EXPECT: drop 1
// EXPECT: end
// PLACES: fn mkv
// PLACES: drop(_4) [removed]
// PLACES: drop(_2) [removed]
// PLACES: fn main
// PLACES: drop(_2) [kept]
struct W { id: i64 }
impl Drop for W { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mkv(gpa: Gpa) -> Vec<W> { var v: Vec<W> = Vec::new_in(gpa); v.push(W { id: 1 }); v }

fn main(gpa: Gpa) {
    for x in mkv(gpa) { println(f"it {x.id}"); }
    println("end");
}
