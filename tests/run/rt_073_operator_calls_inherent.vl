// XFAIL: RT-73: an operator (* - ! += [] ==) calls the type's inherent method named like the operator trait's (mul, neg, not, add_assign, index, eq) instead of the trait impl's (0.30.2)
// Rust's `a * b` is `Mul::mul(a, b)`, whatever inherent methods S has.
// vole desugars it to a method call `a.mul(b)`, where S's inherent mul
// wins: 1003 888 777 669 3 true for 12 -3 -4 8 10 false. Only `<`
// (partial_cmp) is right. rustc prints the EXPECT line.
// EXPECT: 12 -3 -4 8 10 false false
use std::cmp::Ordering;
use std::ops::{AddAssign, Index, Mul, Neg, Not};

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl S {
    fn mul(self, o: S) -> S {
        S { k: 999 + o.k }
    }

    fn neg(self) -> S {
        S { k: 888 }
    }

    fn not(self) -> S {
        S { k: 777 }
    }

    fn add_assign(&mut self, o: S) {
        self.k = 666 + o.k;
    }

    fn index(&self, i: usize) -> &i64 {
        &self.k
    }

    fn eq(&self, o: &S) -> bool {
        true
    }

    fn partial_cmp(&self, o: &S) -> Option<Ordering> {
        Some(Ordering::Less)
    }
}

impl Mul for S {
    type Output = S;

    fn mul(self, o: S) -> S {
        S { k: self.k * o.k }
    }
}

impl Neg for S {
    type Output = S;

    fn neg(self) -> S {
        S { k: -self.k }
    }
}

impl Not for S {
    type Output = S;

    fn not(self) -> S {
        S { k: !self.k }
    }
}

impl AddAssign for S {
    fn add_assign(&mut self, o: S) {
        self.k += o.k;
    }
}

static TEN: i64 = 10;

impl Index<usize> for S {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &TEN
    }
}

impl PartialEq for S {
    fn eq(&self, o: &S) -> bool {
        self.k == o.k
    }
}

impl PartialOrd for S {
    fn partial_cmp(&self, o: &S) -> Option<Ordering> {
        self.k.partial_cmp(&o.k)
    }
}

fn body() {
    let a = S { k: 3 };
    let b = S { k: 4 };
    let mut c = S { k: 5 };
    c += a;
    println("{} {} {} {} {} {} {}", (a * b).k, (-a).k, (!a).k, c.k, a[0], a == b, a > b);
}

fn main() -> i32 {
    body();
    0
}
