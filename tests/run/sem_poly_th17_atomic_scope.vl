// EDITION: rust
// atomics shared by let between scoped threads
// FLAGS: --check-alloc
// EXPECT: 4000
use std::thread;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

fn main() {
    let a = AtomicI64::new(0i64);
    thread::scope(|s| ({ let s = s; {
        for _ in 0..4 { s.spawn(|| { for _ in 0..1000 { a.fetch_add(1, Ordering::Relaxed); } 0 }); }
        0
    } }));
    println("{}", a.load(Ordering::SeqCst));
}
