use std::alloc::Allocator; trait H {
    fn data(&self) -> &[i64];
    fn head(&self) -> &[i64] { &self.data()[0..1] }
}

struct S<A: Allocator> { v: Vec<i64, A> }
impl H for S<Gpa> { fn data(&self) -> &[i64] { self.v.as_slice() } }

