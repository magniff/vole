// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set Drain::impl Iterator.
// EXPECT: Some(1) None
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(1);
    let mut d = s.drain();
    let a = d.next();
    println("{:?} {:?}", a, d.next());
}
