// RULE: R6
// (0.30.2) A parameter typed by a type parameter is given on to a callee
// as the value its caller gave only when nothing in the body writes it;
// every write counts, whatever its flags say: a parameter that is not
// `mut` may still be borrowed mutably (`ref mut` in a `match`, a `let`, an
// `if let`, a `while let`; `&mut` and a reborrow of it; a closure writing
// through such a borrow; `&raw mut` and `ptr::write`), and a `mut` one
// also by a `&mut self` method's autoref, `mem::replace`, `mem::swap` and
// a closure's capture by unique borrow.
// Each `fw*` writes `fs[0]` (a `fn(&i64) -> &'static i64` holding idr2)
// into f and gives f to kl, whose bound's input is the call's own region:
// read as R6 reads the erased type, it is refused there. The first rule
// read a parameter that is not `mut` as unchanged: each of the first
// eight built, and --check-alloc stopped with a use after free (from the
// review of g302fnval: h25, h25b, h25c, h25e). rustc refuses main's `let
// p: fn(&i64) -> &'static i64 = idr2;` (E0308), and the first eight's
// `&mut` of a parameter that is not `mut` (E0596; vole's own refusal of
// it is open).
// RUSTC: none main gives idr2 as a `fn(&i64) -> &'static i64`: rustc refuses that type first (E0308), its fn types keep their lifetimes, vole's are erased (R6); the program exists only where that type is erased
// FLAGS: --check-alloc
// ERROR: error[borrowck.fn_value_bound]
// ERROR: line 66, column 8
// ERROR: line 72, column 8
// ERROR: line 79, column 8
// ERROR: line 87, column 8
// ERROR: line 93, column 8
// ERROR: line 100, column 8
// ERROR: line 109, column 8
// ERROR: line 119, column 8
// ERROR: line 124, column 8
// ERROR: line 129, column 8
// ERROR: line 135, column 8
// ERROR: line 141, column 8
// ERROR: line 149, column 8
// ERROR-COUNT: 13
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn kl<K, F: Fn(&i64) -> K>(f: F, gpa: Gpa) -> K {
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

trait SetTo {
    fn set_to(&mut self, o: Self);
}

impl<T: Copy> SetTo for T {
    fn set_to(&mut self, o: T) {
        *self = o;
    }
}

fn fw_match<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    match f {
        ref mut g => *g = fs[0],
    }
    kl(f, gpa)
}

fn fw_let<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    let ref mut g = f;
    *g = fs[0];
    kl(f, gpa)
}

fn fw_iflet<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    if let ref mut g = f {
        *g = fs[0];
    }
    kl(f, gpa)
}

fn fw_whilelet<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    while let ref mut g = f {
        *g = fs[0];
        break;
    }
    kl(f, gpa)
}

fn fw_amp<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    let r = &mut f;
    *r = fs[0];
    kl(f, gpa)
}

fn fw_reborrow<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    let r = &mut f;
    let r2 = &mut *r;
    *r2 = fs[0];
    kl(f, gpa)
}

fn fw_closure<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    let r = &mut f;
    let mut set = || {
        *r = fs[0];
    };
    set();
    kl(f, gpa)
}

fn fw_raw<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    let pp = &raw mut f;
    // UNSAFE: the test writes through a raw pointer to the parameter
    // SAFETY: pp is f's address; f is live and initialized, and F is Copy
    unsafe {
        std::ptr::write(pp, fs[0]);
    }
    kl(f, gpa)
}

fn fw_autoref<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    f.set_to(fs[0]);
    kl(f, gpa)
}

fn fw_replace<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    let _ = std::mem::replace(&mut f, fs[0]);
    kl(f, gpa)
}

fn fw_swap<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    let mut g = fs[0];
    std::mem::swap(&mut f, &mut g);
    kl(f, gpa)
}

fn fw_mut_amp<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    let r = &mut f;
    *r = fs[0];
    kl(f, gpa)
}

fn fw_capture<K, F: Fn(&i64) -> K + Copy>(mut f: F, fs: &[F], gpa: Gpa) -> K {
    let mut set = || {
        f = fs[0];
    };
    set();
    kl(f, gpa)
}

fn main(gpa: Gpa) {
    let p: fn(&i64) -> &'static i64 = idr2;
    let fs = [p];
    let a = fw_match::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let b = fw_let::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let c = fw_iflet::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let d = fw_whilelet::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let e = fw_amp::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let g = fw_reborrow::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let h = fw_closure::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let i = fw_raw::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let j = fw_autoref::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let k = fw_replace::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let m = fw_swap::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let n = fw_mut_amp::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    let o = fw_capture::<&'static i64, fn(&i64) -> &'static i64>(st, &fs, gpa);
    println("{} {} {} {} {} {} {} {} {} {} {} {} {}", a, b, c, d, e, g, h, i, j, k, m, n, o);
}
