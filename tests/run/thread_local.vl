// EDITION: rust
// (0.21) #[thread_local] statics: each thread starts from the initial
// value and changes only its own copy (an integer, an array, a struct, a
// zeroed one, one reached through its address); the main thread's copy is
// untouched by the others'.
// EXPECT: main 10 [1, 2, 3] 7 0
// EXPECT: threads 6
// EXPECT: main after 11 [1, 2, 3] 7 0

use std::thread::JoinHandle; use std::thread;

#[derive(Clone, Copy)] struct P { x: i64, y: i64 }

#[thread_local]
static mut COUNT: i64 = 10;
#[thread_local]
static mut ARR: [i64; 3] = [1i64, 2, 3];
#[thread_local]
static mut PT: P = P { x: 7, y: 0 };
#[thread_local]
static mut ZERO: i64 = 0;

fn bump(p: *mut i64, by: i64) {
    unsafe { *p += by; }
}

fn work(k: i64) -> i64 {
    let mut ok: i64 = 0;
    if unsafe { COUNT } == 10 && unsafe { ARR[1] } == 2 && unsafe { PT.x } == 7
        && unsafe { ZERO } == 0 { ok += 1; }
    for _ in 0..1000 {
        unsafe { COUNT += k; }
        unsafe { ARR[0] += 1; }
        unsafe { PT.y += 2; }
        bump(unsafe { &mut (*(&raw mut ZERO)) } as *mut i64, 3);
        thread::yield_now();
    }
    if unsafe { COUNT } == 10 + 1000 * k && unsafe { ARR[0] } == 1001 && unsafe { PT.y } == 2000
        && unsafe { ZERO } == 3000 { ok += 1; }
    ok
}

fn main(gpa: Gpa) {
    let count_now = unsafe { COUNT }; let zero_now = unsafe { ZERO };
    println("main {count_now} [{}, {}, {}] {} {zero_now}", unsafe { ARR[0] }, unsafe { ARR[1] },
        unsafe { ARR[2] }, unsafe { PT.x });
    let mut hs: Vec<JoinHandle<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    for k in 1..4 {
        hs.push(thread::spawn_in(move || work(k), gpa));
    }
    let mut total: i64 = 0;
    while hs.len() > 0 { total += hs.pop().unwrap().join().unwrap(); }
    println("threads {total}");
    unsafe { COUNT += 1; }
    let count_now = unsafe { COUNT }; let zero_now = unsafe { ZERO };
    println("main after {count_now} [{}, {}, {}] {} {zero_now}", unsafe { ARR[0] },
        unsafe { ARR[1] }, unsafe { ARR[2] }, unsafe { PT.x });
}
