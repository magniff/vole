// EDITION: rust
// (0.27.0) Hand-translated from tests/run/iter_drop_min_max.vl to Rust's spelling.
// 0.25: min and max drop the items they pass over and return the one they
// keep.
// FLAGS: --check-alloc
// EXPECT: max 4
// EXPECT: max: made 4 dropped 4
// EXPECT: min 1
// EXPECT: min: made 8 dropped 8
use std::alloc::Allocator;
use std::cmp::Ordering;

static mut MADE: i64 = 0;
static mut DROPS: i64 = 0;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        // UNSAFE: the counters are `static mut`, as the MVS original's `static var`s
        // SAFETY: one thread, and no reference to them is taken
        unsafe {
            DROPS += 1;
        }
    }
}

impl<A: Allocator> PartialEq for D<A> {
    fn eq(&self, o: &Self) -> bool {
        self.id == o.id
    }
}

impl<A: Allocator> Eq for D<A> {}

impl<A: Allocator> PartialOrd for D<A> {
    fn partial_cmp(&self, o: &Self) -> Option<Ordering> {
        Some(self.cmp(o))
    }
}

impl<A: Allocator> Ord for D<A> {
    fn cmp(&self, o: &Self) -> Ordering {
        self.id.cmp(&o.id)
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    // UNSAFE: the counters are `static mut`, as the MVS original's `static var`s
    // SAFETY: one thread, and no reference to them is taken
    unsafe {
        MADE += 1;
    }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen<A: Allocator> {
    n: i64,
    k: i64,
    gpa: A,
}

impl Iterator for Gen<Gpa> {
    type Item = D<Gpa>;

    fn next(&mut self) -> Option<D<Gpa>> {
        if self.k >= self.n {
            return None;
        }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen<Gpa> {
    Gen { n: n, k: 0, gpa: gpa }
}

// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop<A: Allocator> {
    v: Vec<D<A>, A>,
}

impl Iterator for Pop<Gpa> {
    type Item = D<Gpa>;

    fn next(&mut self) -> Option<D<Gpa>> {
        self.v.pop()
    }
}

fn pop(n: i64, gpa: Gpa) -> Pop<Gpa> {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 1..=n {
        v.push(mk(i, gpa));
    }
    Pop { v: v }
}

fn report(what: &str) {
    // UNSAFE: the counters are `static mut`, as the MVS original's `static var`s
    // SAFETY: one thread, and no reference to them is taken
    let (made, drops) = unsafe { (MADE, DROPS) };
    println("{what}: made {made} dropped {drops}");
}

fn main(gpa: Gpa) {
    match gen(4, gpa).max() {
        Some(d) => println("max {}", d.id),
        None => {}
    }
    report("max");
    match pop(4, gpa).min() {
        Some(d) => println("min {}", d.id),
        None => {}
    }
    report("min");
}
