// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io Sink::impl Write.
// EXPECT: true 5
use std::io::{BufRead, ErrorKind, Read, Write, self};

fn main() {
    let mut s = io::sink();
    let ok = s.write_all(&[0; 5]).is_ok();
    let n = io::copy(&mut "hello".as_bytes(), &mut s).unwrap();
    println("{} {}", ok, n);
}
