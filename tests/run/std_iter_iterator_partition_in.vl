// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::partition_in.
// EXPECT: [2, 4] [1, 3]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let (e, o): (Vec<i64, Gpa>, Vec<i64, Gpa>) = v
        .iter()
        .copied()
        .partition_in(|x| x % 2 == 0, gpa);
    println("{:?} {:?}", e, o);
}
