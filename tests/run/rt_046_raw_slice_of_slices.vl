// (0.30.2, RT-46) A raw pointer to a slice of raw slices and to a slice of
// arrays is a raw pointer: it promises nothing of what it points to, so a
// load through it is not kept across a call that writes the memory through
// another raw pointer. outer: the call replaces the first raw slice of the
// outer one (a fat pointer) by another, and the second read sees the new
// one's element (rustc: 2090). arrays: the call writes an element of the
// first array (rustc: 2070). v0.30.1 at -O1 and -O2: 2002 and 2002 (the
// first load kept: param_class_of classed a raw slice as a frozen `&[T]`).
// EXPECT: 2090
// EXPECT: 2070
// EXPECT: 90 70
#[inline(never)]
fn swap_in(q: *mut *mut [i64], to: *mut [i64]) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points to the first element of main's outer array, live across the call
    unsafe {
        *q = to;
    }
}

#[inline(never)]
fn outer(p: *const [*mut [i64]], q: *mut *mut [i64], to: *mut [i64]) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: p's elements point into main's arrays, q to p's first element; all live
    unsafe {
        let a = (*(*p)[0])[1];
        swap_in(q, to);
        let b = (*(*p)[0])[1];
        a * 1000 + b
    }
}

#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array of arrays, live across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn arrays(p: *const [[i64; 2]], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array of arrays, live across the call
    unsafe {
        let a = (*p)[0][1];
        poke(q, 70);
        let b = (*p)[0][1];
        a * 1000 + b
    }
}

fn main() -> i32 {
    let mut first = [1i64, 2, 3];
    let mut second = [80i64, 90, 100];
    let fp = first.as_mut_ptr();
    let sp = second.as_mut_ptr();
    // UNSAFE: raw slices over main's arrays, made from their base pointers
    // SAFETY: each array has 3 elements and outlives the pointers; no reference to them is
    // used while the pointers are
    let (f, s) = unsafe {
        (std::slice::from_raw_parts_mut(fp, 3) as *mut [i64],
            std::slice::from_raw_parts_mut(sp, 3) as *mut [i64])
    };
    let mut slots = [f, f];
    let base = slots.as_mut_ptr();
    // UNSAFE: a raw slice over slots, and its first element's pointer, both from base
    // SAFETY: slots has 2 elements and outlives both pointers
    let outer_p = unsafe { std::slice::from_raw_parts(base, 2) as *const [*mut [i64]] };
    println("{}", outer(outer_p, base, s));
    let mut grid = [[1i64, 2], [3, 4]];
    let g = grid.as_mut_ptr();
    // UNSAFE: a raw slice over grid and a pointer to its element [0][1], both from g
    // SAFETY: grid has 2 rows of 2 and outlives both pointers
    let (gp, gq) = unsafe {
        (std::slice::from_raw_parts(g, 2) as *const [[i64; 2]], (g as *mut i64).add(1))
    };
    println("{}", arrays(gp, gq));
    println("{} {}", second[1], grid[0][1]);
    0
}
