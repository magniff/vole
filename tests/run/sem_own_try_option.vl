// EDITION: rust
// sem-own: `?` on an Option of an owned value inside a loop: the locals of the loop body and the function dropped.
// EXPECT: drop 0
// EXPECT: drop 10
// EXPECT: drop 1
// EXPECT: drop 11
// EXPECT: drop 12
// EXPECT: drop 100
// EXPECT: r -1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn g(i: i64, gpa: Gpa) -> Option<D<Gpa>> { if i < 2 { Some(mk(i, gpa)) } else { None } }

fn f(gpa: Gpa) -> Option<i64> {
    let a = mk(100, gpa);
    for i in 0..5 {
        let b = mk(10 + i, gpa);
        let d = g(i, gpa)?;
    }
    Some(0i64)
}

fn main(gpa: Gpa) {
    println("r {}", f(gpa).unwrap_or(-1));
}
