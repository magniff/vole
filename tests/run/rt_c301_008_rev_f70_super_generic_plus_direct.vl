// RULE: F8.3, F8.4
// RT-C301-8 review (R3, form f70_super_generic_plus_direct): `T: Sub + Conv<i64>` with `trait Sub: Conv<i64>`: one trait with one set of arguments.
// rustc prints the EXPECT lines.
// EXPECT: 704
trait Conv<X> { const K: i64; fn mk() -> i64; }
trait Sub: Conv<i64> {}
struct S;
impl Conv<i32> for S { const K: i64 = 32; fn mk() -> i64 { 320 } }
impl Conv<i64> for S { const K: i64 = 64; fn mk() -> i64 { 640 } }
impl Sub for S {}
fn g<T: Sub + Conv<i64>>() -> i64 { T::K + T::mk() }
fn main() { println("{}", g::<S>()); }
