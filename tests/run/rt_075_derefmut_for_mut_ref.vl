// XFAIL: RT-75: references do not implement Deref/DerefMut: a generic `T: DerefMut<Target = i64>` called with `&mut x` (and `T: Deref` with `&y`) is refused ("the trait 'DerefMut' is not implemented for '&mut i64'") (0.30.2)
// std implements Deref and DerefMut for &mut T (and Deref for &T); rustc
// builds this and prints the EXPECT lines.
// EXPECT: 2
// EXPECT: 2
// EXPECT: 5
use std::ops::{Deref, DerefMut};

fn bump<T: DerefMut<Target = i64>>(mut p: T) -> i64 {
    *p += 1;
    *p
}

fn read<T: Deref<Target = i64>>(p: T) -> i64 {
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", bump(&mut x));
    println("{}", x);
    let y = 5i64;
    println("{}", read(&y));
}
