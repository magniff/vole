// RULE: F18.5
// (0.30.2) Eighteen forms a later use types: a struct field, a Vec, a
// destructuring let, a labelled break, a closure, a generic call, a shift,
// an array, an Option, an if, a match, a compound assignment, a loop
// counter against a usize, a generic struct, a return, a HashMap, a u8,
// a negation; each as rustc types it, at -O0, -O1 and -O2.
// EXPECT: 3000000000
// EXPECT: 1
// EXPECT: 4000000000
// EXPECT: 4000000000
// EXPECT: 4000000000
// EXPECT: 3000000000
// EXPECT: 1099511627776
// EXPECT: 3000000000
// EXPECT: 4000000000
// EXPECT: 4000000000
// EXPECT: 4000000000
// EXPECT: 3000000001
// EXPECT: 3
// EXPECT: 4000000000
// EXPECT: 3000000000
// EXPECT: Some(3000000000)
// EXPECT: 200
// EXPECT: -4000000000
use std::collections::HashMap;

struct S {
    x: i64,
}

struct W<T> {
    v: T,
}

fn take(x: i64) -> i64 {
    x
}

fn take_u8(x: u8) -> u8 {
    x
}

fn id<T>(t: T) -> T {
    t
}

fn ret() -> i64 {
    let a = 3000000000;
    a
}

fn main(gpa: Gpa) {
    let a = 3000000000;
    let s = S { x: a };
    println("{}", s.x);
    let mut v = Vec::new_in(gpa);
    v.push(1);
    let b: u8 = v[0];
    println("{b}");
    let (c, d) = (2000000000, 2);
    println("{}", take(c * d));
    let x = 'l: loop {
        break 'l 2000000000;
    };
    println("{}", take(x + x));
    let e = 2000000000;
    let f = || e + e;
    println("{}", take(f()));
    println("{}", take(id(3000000000)));
    let sh = 1 << 40;
    println("{}", take(sh));
    let arr = [1, 2, 3];
    println("{}", take(arr[0] * 3000000000));
    let o = Some(2000000000);
    println("{}", take(o.map(|y| y * 2).unwrap_or(0)));
    let cnd = arr.len() > 2;
    let br = if cnd { 2000000000 } else { 1 };
    println("{}", take(br + br));
    let mt = match arr.len() {
        3 => 2000000000,
        _ => 0,
    };
    println("{}", take(mt * 2));
    let mut tot = 0;
    for z in &[3000000000i64, 1] {
        tot += z;
    }
    println("{}", take(tot));
    let n: usize = 3;
    let mut i = 0;
    while i < n {
        i += 1;
    }
    println("{}", i);
    let w = W { v: 2000000000 };
    println("{}", take(w.v * 2));
    println("{}", ret());
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 3000000000);
    println("{:?}", m.get(&1));
    let k = 200;
    println("{}", take_u8(k));
    let neg = -2000000000;
    println("{}", take(neg * 2));
}
