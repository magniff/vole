// EDITION: rust
// RULE: C3.1
// (0.27.1) An ensures sees a `&mut i64` parameter as `&i64` (the
// wrapper's `let v = &*v;` after the body): a write through it is
// refused by the types.
// ERROR: error[borrowck.assign_immutable]: cannot assign to 'v
// ERROR-COUNT: 1
fn bad(v: &mut i64) -> i64
    ensures {
    *v = 0;
    true
}

{
    *v
}

fn main() {
    let mut a: i64 = 1;
    println("{}", bad(&mut a));
}
// Runs on std2 since its gap closed (0.27.2).
