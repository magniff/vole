// EDITION: rust
// sem-own: temporaries in nested calls: inner results given to let params, dropped at the statement end.
// EXPECT: 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn add(a: &D<Gpa>, b: &D<Gpa>) -> i64 { a.id + b.id }

fn main(gpa: Gpa) {
    println("{}", add(&mk(1, gpa), &mk(2, gpa)));
    println("end");
}
