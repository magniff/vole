// EDITION: rust
// RULE: D9.1
// (0.27.1) An `impl Drop` value holding no reference: no regions to keep
// live.

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn main() {
    let x: i64 = 1;
    let d = D { v: x };
    let y: i64 = 2;
    println("{} {}", d.v, y);
}
// EXPECT: 1 2
// EXPECT: drop 1
