// 0.26.3: in the literal of a struct generic over its allocator, written
// without type arguments, a field's call keeps its arguments' expected
// types: `f3(gpa, Vec::new_in(gpa))`'s `Vec::new_in` is typed by f3's
// parameter (the inference used to type the call's last argument alone,
// as if it were an `_in` call's allocator: "cannot infer type parameter
// 'T' of 'Vec::new_in'"). The field's own type still says what a bare
// `_in` call is, and a generic call's allocator argument binds the struct's.
// EXPECT: 0 0
// EXPECT: 1 3
// EXPECT: 0 2
struct T {
    v: i64,
}

struct S<A: Allocator> {
    t: T,
    w: Vec<T, A>,
    n: i64,
}

fn f3(gpa: Gpa, a: sink Vec<T, Gpa>) -> Vec<T, Gpa> {
    a
}

fn make<A: Allocator, U>(a: A) -> Vec<U, A> {
    Vec::new_in(a)
}

fn main(gpa: Gpa) -> i32 {
    let x = f3(gpa, Vec::new_in(gpa));
    let s = S { t: T { v: 1 }, w: f3(gpa, Vec::new_in(gpa)), n: 2 };
    println("{} {}", s.w.len(), x.len());
    var u = S { t: T { v: 1 }, w: Vec::new_in(gpa), n: 2 };
    u.w.push(T { v: 3 });
    println("{} {}", u.w.len(), u.w[0].v);
    let r = S { t: T { v: 1 }, w: make(gpa), n: 2 };
    println("{} {}", r.w.len(), r.n);
    0
}
