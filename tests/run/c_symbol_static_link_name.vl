// 0.30.1: a C static's #[link_name] is its symbol, as a function's
// (front::check::collect; gen0::target::emit_symbol_ref no longer renames
// symbols by their text): `COUNT` is C's csi_counter, read and written. A
// pin: 0.30.0's renaming when it printed the symbol gave the same.
// CSOURCE: tests/c/c_symbol_identity.c
// EXPECT: 5 6 6
extern "C" {
    #[link_name = "csi_counter"]
    static mut COUNT: i64;
    fn csi_counter_now() -> i64;
}

fn main() {
    // UNSAFE: C's static, read and written on this one thread.
    // SAFETY: nothing else runs while main does.
    unsafe {
        let before = COUNT;
        COUNT = before + 1;
        // A format argument is borrowed: read the static by value first
        // (rustc's static_mut_refs refuses `println!("{}", COUNT)` too).
        let after = COUNT;
        println("{} {} {}", before, after, csi_counter_now());
    }
}
