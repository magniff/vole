// (0.26.3) Every allocator written: `Vec<T, Gpa>`, `Buf<Gpa>`,
// `HashMap<K, V, Gpa>`, and a function generic over `A: Allocator` that
// grows what it is given from that container's own allocator.
// EXPECT: 10 3 2
// EXPECT: [0, 1, 2, 3, 4, 5]
use std::HashMap;

fn fill<A: Allocator>(v: inout Vec<i64, A>, n: i64) {
    for i in 0..n {
        v.push(i);
    }
}

fn total(v: [i64]) -> i64 {
    v.iter().sum()
}

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    fill(&v, 5);
    var b: Buf<Gpa> = Buf::new_in(gpa);
    b.push_str("abc");
    var m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 2);
    m.insert(3, 4);
    println("{} {} {}", total(v.as_slice()), b.len(), m.len());
    fill(&v, 6);
    println("{:?}", v[5..11]);
}
