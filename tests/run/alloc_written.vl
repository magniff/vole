// (0.26.3) Every allocator written: `Vec<T, Gpa>`, `Buf<Gpa>`,
// `HashMap<K, V, Gpa>`, and a function generic over `A: Allocator` that
// grows what it is given from that container's own allocator.
// EXPECT: 10 3 2
// EXPECT: [0, 1, 2, 3, 4, 5]
use std::hash::FixedState;
use std::alloc::Allocator; use std::collections::HashMap;

fn fill<A: Allocator>(v: &mut Vec<i64, A>, n: i64) {
    for i in 0..n {
        v.push(i);
    }
}

fn total(v: &[i64]) -> i64 {
    v.iter().copied().sum::<i64>()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    fill(&mut v, 5i64);
    let mut b: String<Gpa> = String::new_in(gpa);
    b.push_str("abc");
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    m.insert(3, 4);
    println("{} {} {}", total(v.as_slice()), b.len(), m.len());
    fill(&mut v, 6i64);
    println("{:?}", &v[5..11]);
}
