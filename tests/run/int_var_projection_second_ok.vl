// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). `f(f(2))`
// used as u8, i64's Out.
// EXPECT: 0
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = u16;

    fn o(self) -> u16 {
        self as u16 * 300
    }
}

impl Tr for i32 {
    type Out = i64;

    fn o(self) -> i64 {
        self as i64 * 3000000000
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

impl Tr for i64 {
    type Out = u8;

    fn o(self) -> u8 {
        (self % 200) as u8
    }
}

fn main() {
    let s: u8 = f(f(2));
    println("{}", s);
}
