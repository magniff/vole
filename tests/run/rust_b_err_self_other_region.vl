// RULE: D4.2
// (0.27.1) E3 gives the output self's region; returning the other parameter
// needs it to outlive self's.
// ERROR: error[borrowck.outlives]
// ERROR: line 16, column 9
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn other<'b>(&self, o: &'b i64) -> &i64 {
        o
    }
}

fn main() {
    let s = S { x: 7, y: 2 };
    let k: i64 = 1;
    println("{}", *s.other(&k));
}
