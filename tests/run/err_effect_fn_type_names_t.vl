// XFAIL: E3.3c: a fn type that names T passes #[effects(T)] at the declaration; callers are refused at the instance (0.30.2)
// A listed T stands for its own methods' effects. A fn value whose type
// names T (`via(x, boom_t::<T>, n)`, a `G<T> { f: fn(&T, usize) }`) is
// taken as T's own, so boom_t's panic passes `#[effects(T)]` on user_t and
// user_g, though it is no method of T: only their callers are refused,
// at the instance (`caller`). user_w's `fn(usize) -> usize` is refused
// at the declaration already.
// ERROR: 'user_t' is #[effects(T)], but it may panic:
// ERROR: 'user_g' is #[effects(T)], but it may panic:
// ERROR: 'user_w' is #[effects(T)], but it may panic:
fn boom_t<T>(x: &T, n: usize) -> usize {
    let _ = x;
    10 / n
}

fn via<T>(x: &T, f: fn(&T, usize) -> usize, n: usize) -> usize {
    f(x, n)
}

#[effects(T)]
fn user_t<T>(x: &T, n: usize) -> usize {
    via(x, boom_t::<T>, n)
}

struct W<T> {
    x: T,
    f: fn(usize) -> usize,
}

fn boom(n: usize) -> usize {
    10 / n
}

fn run<T>(w: &W<T>, n: usize) -> usize {
    (w.f)(n)
}

#[effects(T)]
fn user_w<T>(x: T, n: usize) -> usize {
    let w = W { x: x, f: boom };
    run(&w, n)
}

struct G<T> {
    x: T,
    f: fn(&T, usize) -> usize,
}

fn run_g<T>(w: &G<T>, n: usize) -> usize {
    (w.f)(&w.x, n)
}

#[effects(T)]
fn user_g<T>(x: T, n: usize) -> usize {
    let w = G { x: x, f: boom_t::<T> };
    run_g(&w, n)
}

#[effects()]
fn caller(n: usize) -> usize {
    user_t(&1u8, n) + user_g(1u8, n)
}

fn main() {
    println("{} {}", user_w(1u8, 1), caller(1));
}
