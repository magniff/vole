// EDITION: rust
// RULE: F17.3
// std2's Gpa derives Clone (its field is a `()`, which std2 clones), so a
// struct over an allocator derives Clone.
// EXPECT: 3 4
#[derive(Clone)]
struct H<A: std::alloc::Allocator> {
    a: A,
    n: i32,
}

fn main(gpa: Gpa) {
    let g = gpa.clone();
    let h = H { a: g, n: 3 };
    let k = h.clone();
    println("{} {}", k.n, 4);
}
