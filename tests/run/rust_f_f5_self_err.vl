// RULE: F5.4
// `Self(..)` makes only a tuple struct, and a `Self` pattern has the
// self type: against another type it is a mismatch.
// ERROR: expected 'i64', got 'P'
struct P {
    x: i64,
}

impl P {
    fn get(&self, k: i64) -> i64 {
        match k {
            Self { x } => x,
        }
    }
}

fn main() -> i64 {
    let p = P { x: 1 };
    p.get(2)
}
