// (0.25.2, feedbacks/galaga.md #4) An unused import is an error with
// --deny-warnings (every case is built with it); a `pub use` is not
// reported (other modules may use what it brings).
// ERROR: unused import 'x'
// ERROR-COUNT: 1
mod b;
mod c;
use b::{x, y};

fn main() -> i32 {
    (y() + c::z()) as i32 - 5
}
