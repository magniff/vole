// XFAIL: gap 17: compile type error: 'dbl' does not have the signature trait 'N' declares: expected 'fn(B) -> i64'
// a default method used through a generic bound and directly; overriding in one impl
// FLAGS: --check-alloc
// EXPECT: 6 -1 10
trait N {
    fn v(&self) -> i64;
    fn dbl(self) -> i64 { self.v() * 2 }
}

#[derive(Clone, Copy)] struct A { x: i64 }
#[derive(Clone, Copy)] struct B { x: i64 }
impl N for A { fn v(&self) -> i64 { self.x } }
impl N for B { fn v(&self) -> i64 { self.x } fn dbl(&self) -> i64 { -1 } }
fn g<T: N>(t: &T) -> i64 { t.dbl() }
fn main() { println("{} {} {}", g(&A { x: 3 }), g(&B { x: 3 }), A { x: 5 }.dbl()); }
