// EDITION: rust
// RULE: F18.4
// (0.27.6) A sliced array literal under `&mut` where `&mut [U]` goes: the
// slice is checked as `[U]` and the reference stays `&mut` (0.27.5 checked
// the slice against `&mut [U]` and refused `&mut [1, 2, 3][..]`); under
// `&mut` where `&[U]` goes, the reference coerces to `&[U]`.
// EXPECT: 5000000002 3
fn bump(v: &mut [i64]) -> i64 {
    v[0] += 2;
    v[0]
}

fn count(v: &[i64]) -> i64 {
    v.len() as i64
}

fn main() {
    let a = bump(&mut [5000000000, 2, 3][..]);
    let b = count(&mut [1, 2, 3, 4][1..]);
    println("{} {}", a, b);
}
