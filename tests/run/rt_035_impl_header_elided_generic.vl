// RT-35 (0.30.1) An elided lifetime of an inherent impl's header with a
// type parameter, `impl<'b, U> V<'b, &str, U>`, is the impl's own
// lifetime (D4.6 (b): a U_SUBST of `Self`), not a region of a type
// argument's substitution. D4.4 (g) leaves a flow of a substitution's
// region to the template's opaque instance, and read this one as such in
// every instance, the opaque one too: so no instance checked it, and `f`
// stored a short str as `'static` (rustc E0521). Each method below is
// refused (twice: to `'static` and to `'b`; the last once), as without
// the type parameter.
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR-COUNT: 9
use std::alloc::Allocator;

// (d65: the elided argument before the parameter)
struct V<'b, T, U> { t: T, out: &'b mut Option<&'static str>, u: U }

impl<'b, U> V<'b, &str, U> {
    fn f(&mut self) { self.out.replace(self.t); }
}

// (d66: after it)
struct Vb<'b, U, T> { u: U, t: T, out: &'b mut Option<&'static str> }

impl<'b, U> Vb<'b, U, &str> {
    fn f(&mut self) { self.out.replace(self.t); }
}

// (d14: an allocator parameter, a Vec's push)
struct Vc<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }

impl<'b, A: Allocator> Vc<'b, &str, A> {
    fn f(&mut self) { self.out.push(self.t); }
}

// (d63: written `'_`)
struct Vd<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }

impl<'b, A: Allocator> Vd<'b, &'_ str, A> {
    fn f(&mut self) { self.out.push(self.t); }
}

// (the method generic too, and a `let` that names 'static)
struct Ve<T, U> { t: T, u: U }

impl<U> Ve<&str, U> {
    fn f<X>(&self, x: X) -> &'static str { self.t }
}

fn main(gpa: Gpa) {
    let mut keep: Option<&'static str> = None;
    {
        let st = String::from_in("hello heap string long", gpa);
        let mut x = V { t: st.as_str(), out: &mut keep, u: 0i64 };
        x.f();
    }
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{}", keep.unwrap());
    println("{}", w);
}
