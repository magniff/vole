// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Allocator::deallocate.
// EXPECT: ok
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let l = Layout::new::<u32>();
    let p = gpa.allocate(l).unwrap();
    // UNSAFE: the block goes back.
    // SAFETY: p came from gpa with layout l.
    unsafe { gpa.deallocate(p, l) };
    println("ok");
}
