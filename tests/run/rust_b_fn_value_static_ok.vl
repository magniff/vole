// RULE: D4.7
// (0.30.1) Functions that take references of any lifetime are values: a
// `fn` pointer, an argument for an `Fn` bound, a result that is 'static
// (a call through the value ties it to the arguments), a `'static` inside
// a `fn` parameter (what the item gives, not what it needs), a named
// lifetime with no 'static bound, a `T: 'static` given a value with no
// reference; and a 'static function called by its name.
// EXPECT: 3 3 7 4 1 5 3
static SEVEN: i64 = 7;

fn get(x: &i64) -> i64 { *x }

fn pick<'a>(x: &'a i64) -> &'a i64 { x }

fn seven(x: &i64) -> &'static i64 { &SEVEN }

fn give(f: fn(&'static i64) -> i64) -> i64 { f(&SEVEN) - 3 }

fn hold<T: 'static>(t: T) -> i64 { 1 }

fn keep(x: &'static i64) -> i64 { *x - 2 }

fn call<F: Fn(&i64) -> i64>(f: F) -> i64 {
    let x = 3;
    f(&x)
}

fn main() {
    let x: i64 = 3;
    let a: fn(&i64) -> i64 = get;
    let b: fn(&i64) -> &i64 = pick;
    let c: fn(&i64) -> &i64 = seven;
    let d: fn(fn(&'static i64) -> i64) -> i64 = give;
    let e: fn(i64) -> i64 = hold::<i64>;
    println("{} {} {} {} {} {} {}", a(&x), *b(&x), *c(&x), d(get), e(1), keep(&SEVEN), call(get));
}
