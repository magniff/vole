// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops DerefMut::deref_mut.
// EXPECT: 70
use std::ops::{Bound, Deref, DerefMut};

struct Wrap {
    v: i64,
    b: Bound<i64>,
}

impl Deref for Wrap {
    type Target = i64;

    fn deref(&self) -> &i64 {
        &self.v
    }
}

impl DerefMut for Wrap {
    fn deref_mut(&mut self) -> &mut i64 {
        &mut self.v
    }
}

fn main() {
    let mut w = Wrap { v: 7, b: Bound::Unbounded };
    let r: &mut i64 = w.deref_mut();
    *r *= 10;
    println("{}", w.v);
}
