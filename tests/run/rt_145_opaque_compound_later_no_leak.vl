// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145) `Some(mk(gpa))` and `(mk(gpa), 0)` with mk,
// whose closure owns a String, defined after main: both dropped, nothing
// leaked (0.30.2's first try: check-alloc found 2 blocks not freed). The
// output is rustc's. (x13 of the review of the opaque-type work)
// EXPECT: o true
// EXPECT: t 3
// EXPECT: end
fn main(gpa: Gpa) {
    let o = Some(mk(gpa));
    println("o {}", o.is_some());
    let t = (mk(gpa), 0i64);
    println("t {}", (t.0)());
    println("end");
}

fn mk(gpa: Gpa) -> impl Fn() -> usize {
    let s = String::from_in("abc", gpa);
    move || s.len()
}
