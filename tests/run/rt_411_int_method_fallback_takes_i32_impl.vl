// XFAIL: RT-411: WRONG CODE: a generic method of a trait impl'd for i32 and i64, called with a turbofish on an integer variable later used as i64 (`a.sh::<u8>(1)`), runs i32's impl: vole prints `32 ..`, rustc `64 4000000000` (calls::int_method_type's i32 fallback) (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 64 4000000000
trait Sh { fn sh<T>(&self, t: T) -> i64; }
impl Sh for i32 { fn sh<T>(&self, t: T) -> i64 { 32 } }
impl Sh for i64 { fn sh<T>(&self, t: T) -> i64 { 64 } }

fn main() {
    let a = 2000000000;
    let k = a.sh::<u8>(1);
    let b: i64 = a + a;
    println("{} {}", k, b);
}
