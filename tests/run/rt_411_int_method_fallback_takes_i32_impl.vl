// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 64 4000000000
trait Sh { fn sh<T>(&self, t: T) -> i64; }
impl Sh for i32 { fn sh<T>(&self, t: T) -> i64 { 32 } }
impl Sh for i64 { fn sh<T>(&self, t: T) -> i64 { 64 } }

fn main() {
    let a = 2000000000;
    let k = a.sh::<u8>(1);
    let b: i64 = a + a;
    println("{} {}", k, b);
}
