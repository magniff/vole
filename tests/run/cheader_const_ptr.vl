// RULE: F30.5
// (0.29) --emit-header writes a `*const T` as C's `const T *` (of a
// pointer: `T *const *`; of the unit type: `const void *`) and a `*mut T`
// as `T *`: the C side declares each function again with those types.
// CHEADER: constptr_out.h
// CSOURCE: tests/c/cheader_const_ptr.c
// EXPECT: 44 one 1
extern "C" {
    fn c_drive() -> i32;
}

extern "C" fn total(xs: *const i64, n: i64) -> i64 {
    let mut t = 0;
    for i in 0..n {
        // UNSAFE: reads through the caller's pointer.
        // SAFETY: the caller gives n elements; i is below n.
        t += unsafe { *xs.add(i as usize) };
    }
    t
}

extern "C" fn poke(p: *mut i64, v: i64) {
    // UNSAFE: writes through the caller's pointer.
    // SAFETY: the caller gives a pointer to a live i64 of its own.
    unsafe {
        *p = v;
    }
}

extern "C" fn nth(names: *const *const u8, i: i64) -> *const u8 {
    // UNSAFE: reads through the caller's pointer.
    // SAFETY: the caller gives more than i names.
    unsafe { *names.add(i as usize) }
}

extern "C" fn same(p: *const ()) -> *const () {
    p
}

fn main() {
    // UNSAFE: a C call.
    // SAFETY: c_drive calls back with pointers to its own locals.
    unsafe {
        c_drive();
    }
}
