// 0.30: sort_unstable_by is an introsort (quicksort around the median of
// three, insertion sort up to 24, heapsort when the partitions go too
// deep). Every length from 0 to 130 and some long ones, of seven shapes
// (random, sorted, reversed, equal, few values, organ pipe, sawtooth):
// the result is in order and has the elements it was given (their sum
// and their xor), by a comparator too (largest first), and by a key with
// ties (the pairs come out in the order of their keys).
// EXPECT: 1071 sorted, 0 wrong
// EXPECT: 4 5 0 0
// An adversary (McIlroy's: an element's value is decided when it is first
// compared with another undecided one, so that every pivot is among the
// smallest) drives the quicksort to its depth limit: the heapsort runs.
// EXPECT: adversary 0 out of order, 1999000, more than 60000 comparisons: 1
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

fn next(state: &mut u64) -> u64 {
    *state = state.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
    *state >> 33
}

fn fill(v: &mut Vec<i64, Gpa>, n: usize, shape: usize, state: &mut u64) {
    v.clear();
    for i in 0..n {
        let x = match shape {
            0 => (next(state) % 100000) as i64 - 50000,
            1 => i as i64,
            2 => (n - i) as i64,
            3 => 7,
            4 => (next(state) % 4) as i64,
            5 => if i < n / 2 { i as i64 } else { (n - i) as i64 },
            _ => (i % 17) as i64,
        };
        v.push(x);
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut state = 12345u64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut sorted: i64 = 0;
    let mut wrong: i64 = 0;
    let mut round: usize = 0;
    while round < 153 {
        let n = if round <= 130 { round } else { 1000 + (round - 130) * 997 };
        for shape in 0..7 {
            fill(&mut v, n, shape, &mut state);
            let mut sum: i64 = 0;
            let mut xor: i64 = 0;
            for x in v.iter() {
                sum = sum.wrapping_add(*x);
                xor ^= *x;
            }
            if round % 2 == 0 {
                v.as_mut_slice().sort_unstable();
            } else {
                v.as_mut_slice().sort_unstable_by(|a, b| b.cmp(a));
                v.as_mut_slice().reverse();
            }
            let s = v.as_slice();
            let mut ok = s.len() == n;
            let mut sum2: i64 = 0;
            let mut xor2: i64 = 0;
            for k in 0..s.len() {
                sum2 = sum2.wrapping_add(s[k]);
                xor2 ^= s[k];
                if k > 0 && s[k - 1] > s[k] {
                    ok = false;
                }
            }
            if ok && sum == sum2 && xor == xor2 {
                sorted += 1;
            } else {
                wrong += 1;
            }
        }
        round += 1;
    }
    unsafe { printf(c"%ld sorted, %ld wrong\n", sorted, wrong); }
    // By a key with ties.
    let mut p: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    for i in 0..5000 {
        p.push(((next(&mut state) % 10) as i64, i));
    }
    p.as_mut_slice().sort_unstable_by_key(|x| x.0);
    let mut order: i64 = 0;
    let mut ids: i64 = 0;
    for k in 0..p.len() {
        if k > 0 && p[k - 1].0 > p[k].0 {
            order += 1;
        }
        ids += p[k].1;
    }
    unsafe { printf(c"%ld %ld %ld %ld\n", p[2500].0, p[2600].0, order, ids - 12497500); }
    let n: usize = 2000;
    let gas = n as i64;
    let mut val: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut items: Vec<usize, Gpa> = Vec::new_in(gpa);
    for i in 0..n {
        val.push(gas);
        items.push(i);
    }
    let mut solid: i64 = 0;
    let mut candidate: usize = 0;
    let mut comparisons: i64 = 0;
    items.as_mut_slice().sort_unstable_by(|a, b| {
        let x = *a;
        let y = *b;
        comparisons += 1;
        if val[x] == gas && val[y] == gas {
            if x == candidate {
                val[x] = solid;
            } else {
                val[y] = solid;
            }
            solid += 1;
        }
        if val[x] == gas {
            candidate = x;
        } else if val[y] == gas {
            candidate = y;
        }
        val[x].cmp(&val[y])
    });
    let mut bad: i64 = 0;
    let mut total: i64 = 0;
    for k in 0..n {
        total += items[k] as i64;
        if k > 0 && val[items[k - 1]] > val[items[k]] {
            bad += 1;
        }
    }
    unsafe {
        printf(c"adversary %ld out of order, %ld, more than 60000 comparisons: %d\n", bad, total,
            (comparisons > 60000) as i32);
    }
    0
}
