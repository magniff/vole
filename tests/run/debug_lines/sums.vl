#[derive(Clone, Copy, PartialEq, Eq)] pub enum Kind { Odd, Even }

#[inline(never)]
pub fn squares(n: i64) -> i64 {
    let mut s: i64 = 0;
    for i in 1..n + 1 {
        s += i * i;
    }
    s
}

#[inline(never)]
pub fn kind(i: i64) -> Kind {
    if i % 2 == 1 {
        Kind::Odd
    } else {
        Kind::Even
    }
}
