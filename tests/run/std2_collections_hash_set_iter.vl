// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set Iter.
// EXPECT: 1
use std::collections::{HashSet, hash_set};
use std::collections::hash_set::Iter;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    let it: Iter<'_, i64> = s.iter();
    println("{}", it.count());
}
