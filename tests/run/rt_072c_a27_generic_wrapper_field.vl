// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a27 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 300
// EXPECT: 1
trait TA { fn m(&self) -> i64; }
struct S { k: i64 }
impl S { fn m(&self) -> i64 { 300 } }
impl TA for S { fn m(&self) -> i64 { 1 } }
struct P<T> { t: T }
fn g<Q: Pick>(q: &Q) -> i64 { q.pick().m() }
trait Pick { type Out: TA; fn pick(&self) -> &Self::Out; }
impl<T: TA> Pick for P<T> { type Out = T; fn pick(&self) -> &T { &self.t } }
fn main() { let p = P { t: S { k: 0 } }; println("{}", g(&p)); }
