// RULE: D1.5
// (0.27.1; 0.30: an error) `&mut a[0]` and `&mut a[1]` of an array:
// constant indexes may alias as any two indexes do, rustc's E0499 (R7,
// where they were disjoint, closed in 0.30).
// ERROR: error[borrowck.mut_twice]
// ERROR: line 11, column 13
// ERROR-COUNT: 1
fn main() {
    let mut a = [1i64, 2, 3];
    let p = &mut a[0];
    let q = &mut a[1];
    *p += 10;
    *q += 20;
    println("{} {}", a[0], a[1]);
}
