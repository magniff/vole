// (0.30.1, review 4) An impl's `Fn*` bound is read against the trait's as
// the impl has it: the trait's parameter its argument (`FnMut(T)` with T
// = &'static str is `FnMut(&'static str)`), `Self::R` the impl's
// definition (`FnMut(Self::R)` with R = &'c str is `FnMut(&'c str)`), on
// either side (review 4's b02, b10, b09: before, the lifetimes were
// counted as written, and none paired: trait.impl_generics).
// EXPECT: a
// EXPECT: b
// EXPECT: c
trait Tr<T> {
    fn f<F: FnMut(T)>(&self, g: F);
}

struct W {
    r: &'static str,
}

impl Tr<&'static str> for W {
    fn f<F: FnMut(&'static str)>(&self, mut g: F) {
        g(self.r)
    }
}

trait Tr2 {
    type R;
    fn f<F: FnMut(Self::R)>(&self, g: F);
}

struct V<'c> {
    r: &'c str,
}

impl<'c> Tr2 for V<'c> {
    type R = &'c str;

    fn f<F: FnMut(&'c str)>(&self, mut g: F) {
        g(self.r)
    }
}

struct U<'c> {
    r: &'c str,
}

impl<'c> Tr2 for U<'c> {
    type R = &'c str;

    fn f<F: FnMut(Self::R)>(&self, mut g: F) {
        g(self.r)
    }
}

fn main() {
    let w = W { r: "a" };
    w.f(|s: &'static str| println("{}", s));
    let v = V { r: "b" };
    v.f(|s: &str| println("{}", s));
    let u = U { r: "c" };
    u.f(|s: &str| println("{}", s));
}
