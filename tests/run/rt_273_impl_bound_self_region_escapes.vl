// XFAIL: RT-273: `need(w)` with `w: &W<'s>` needs `i64: Conv<W<'s>>` through an impl's `U: Conv<Self>`, whose only impl needs 's: 'static: accepted (rustc E0521) (0.30.2)
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// The impl `Tr<U> for W<'a>` holds under `U: Conv<Self>`; for U = i64 the
// impl `Conv<W<'a>> for i64` needs 'a: 'static. In `m<'s>`, `need(w)` so
// needs 's: 'static: rustc refuses it (E0521: borrowed data escapes outside
// of method). vole accepts it. The same family as RT-268 (an impl's own
// bound's regions); here no unsound use was found (the body cannot use
// the bound's 'static).
// ERROR: error[
// ERROR: line 41, column 9
// ERROR-COUNT: 1
trait Conv<X> {}

trait Tr<U> {
    fn g(&self) -> &'static str;
}

struct W<'a> {
    r: &'a str,
}

struct X {
    r: i64,
}

impl Conv<X> for i64 {}
impl<'a: 'static> Conv<W<'a>> for i64 {}

impl<'a, U: Conv<Self>> Tr<U> for W<'a> {
    fn g(&self) -> &'static str {
        "x"
    }
}

fn need<T: Tr<i64>>(t: &T) -> &'static str {
    t.g()
}

impl X {
    fn m<'s>(&self, w: &W<'s>) -> &'static str {
        need(w)
    }
}

fn main(gpa: Gpa) {
    let st = String::from_in("hello hello hello hello", gpa);
    let w = W { r: st.as_str() };
    println("{} {}", X { r: 0 }.m(&w), 23);
}
