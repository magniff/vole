// RULE: F6.2
// The probe's autoref is one `&`: `impl Only for &S` with `fn only(&self)`
// has the receiver `&&S`, which `s.only()` on an `S` does not reach
// (rustc E0599); `r.only()` on `r: &S` does, and so does a by-value
// `self` method of the `&S` impl on `s`.
// ERROR: no method 'only' on type 'S'
trait Only {
    fn only(&self) -> i64;
}

trait ByVal {
    fn byval(self) -> i64;
}

struct S {
    n: i64,
}

impl<'a> Only for &'a S {
    fn only(&self) -> i64 {
        5
    }
}

impl<'a> ByVal for &'a S {
    fn byval(self) -> i64 {
        7
    }
}

fn main() -> i64 {
    let s = S { n: 0 };
    let r = &s;
    r.only() + s.byval() + s.only()
}
