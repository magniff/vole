use std::iter::FusedIterator;

fn main() {
    let mut done = false;
    let mut f = std::iter::from_fn(|| {
        if done {
            None
        } else {
            done = true;
            Some(1i64)
        }
    });
    let a = f.next();
    println("{:?} {:?}", a, f.next());
