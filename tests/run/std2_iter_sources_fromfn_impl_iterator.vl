// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::sources FromFn::impl Iterator.
// EXPECT: Some(1) None

fn main() {
    let mut done = false;
    let mut f = std::iter::from_fn(|| {
        if done {
            None
        } else {
            done = true;
            Some(1i64)
        }
    });
    let a = f.next();
    println("{:?} {:?}", a, f.next());
}
