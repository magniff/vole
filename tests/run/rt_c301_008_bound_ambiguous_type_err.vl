// RULE: F11.3, F9.3
// `T::Out` with `T: A + B`, both declaring Out: rustc E0221. 0.30.1 took
// A's (and accepted the program: both are i64 for S).
// ERROR: error[type.ambiguous]: ambiguous associated type 'Out' in the bounds of 'T': traits 'A' and 'B' both declare it
trait A { type Out; fn get(&self) -> Self::Out; }
trait B { type Out; fn get(&self) -> Self::Out; }
struct S;
impl A for S { type Out = i64; fn get(&self) -> i64 { 7 } }
impl B for S { type Out = i64; fn get(&self) -> i64 { 8 } }
fn f<T: A + B>(t: &T) -> T::Out { <T as A>::get(t) }
fn main() { println("{}", f(&S)); }
