// XFAIL: RT-87: `T::mk()` under `T: Tr<i64>`, for a type with impls of Tr<i32> and Tr<i64>, is refused as ambiguous; the bound names the impl (0.30.2)
// rustc prints the EXPECT line.
// EXPECT: 64
trait Tr<U> {
    fn mk() -> i64;
}

struct W;

impl Tr<i32> for W {
    fn mk() -> i64 {
        32
    }
}

impl Tr<i64> for W {
    fn mk() -> i64 {
        64
    }
}

fn go<T: Tr<i64>>() -> i64 {
    T::mk()
}

fn main() {
    println("{}", go::<W>());
}
