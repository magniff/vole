// rustc prints the EXPECT line.
// EXPECT: 64
trait Tr<U> {
    fn mk() -> i64;
}

struct W;

impl Tr<i32> for W {
    fn mk() -> i64 {
        32
    }
}

impl Tr<i64> for W {
    fn mk() -> i64 {
        64
    }
}

fn go<T: Tr<i64>>() -> i64 {
    T::mk()
}

fn main() {
    println("{}", go::<W>());
}
