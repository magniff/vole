use std::collections::{HashMap, hash_map};
use std::collections::hash_map::IntoKeys;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let it: IntoKeys<i64, i64, Gpa> = m.into_keys();
    println("{}", it.count());
}
