// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Chain::impl Iterator.
// EXPECT: Some(1) Some(2) None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64], gpa);
    let b = Vec::from_in([2i64], gpa);
    let mut it = a.iter().chain(b.iter());
    let x = it.next();
    let y = it.next();
    println("{:?} {:?} {:?}", x, y, it.next());
}
