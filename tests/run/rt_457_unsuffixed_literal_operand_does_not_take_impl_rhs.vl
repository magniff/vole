// XFAIL: RT-457: `m * 2` with only `impl Mul<i64> for M` is refused, "expected 'M', got 'i32'": the unsuffixed right operand is typed i32 (or as the left operand's type) instead of taking the one impl's Rhs; `m * 2i64` works; rustc picks the impl and prints 3 (0.30.2)
// From the paused g302oblig work (its mul6). Since v0.30.1 at least (the
// same error on v0.30.1 and on the release build, 38fe466c5). Its
// sibling mul2, `M { .. } * 2i64`, a struct literal on the left, is
// RT-112. The i32 default's family (RT-286, RT-315): a literal typed
// before its context says what it is.
// EXPECT: 3
use std::ops::Mul;

struct M {
    a: [i64; 4],
}

impl Mul<i64> for M {
    type Output = M;

    fn mul(self, r: i64) -> M {
        self
    }
}

fn main() {
    let m0 = M { a: [1, 2, 3, 4] };
    let d = m0 * 2;
    let e: M = M { a: [1, 2, 3, 4] }.mul(2i64);
    let f = Mul::mul(M { a: [1, 2, 3, 4] }, 2i64);
    println("{}", d.a[0] + e.a[0] + f.a[0]);
}
