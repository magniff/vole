// RULE: R6
// (0.30.2) A function whose bound's input is the call's own region (`F:
// Fn(&i64) -> U`) has its body checked by the bound: every call by its
// name checks the callable given (borrowck.fn_value_bound for idr2). As a
// value, `key::<&i64, fn(&i64) -> &i64>`, a call through it would reach
// that body unchecked, and `g(&v[0], idr2)` would return a borrow of v
// after drop(v): the use as a value is refused (rustc E0308 for its
// type: idr2's type is not the bound's).
// ERROR: error[borrowck.fn_value_bound]
// ERROR: line 21, column 49
// ERROR-COUNT: 1
fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn key<U, F: Fn(&i64) -> U>(x: &i64, f: F) -> U {
    f(x)
}

fn main(gpa: Gpa) {
    let g: fn(&i64, fn(&i64) -> &i64) -> &i64 = key::<&i64, fn(&i64) -> &i64>;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = g(&v[0], idr2);
    drop(v);
    println("{}", r);
}
