// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::replace_in.
// EXPECT: this is new ab-ab
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "this is old";
    println("{} {}", s.replace_in("old", "new", gpa),
        "a b".replace_in(' ', "-", gpa).replace_in("a-b", "ab-ab", gpa));
}
