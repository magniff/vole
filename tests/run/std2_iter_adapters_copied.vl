// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Copied.
// EXPECT: [1, 2]
use std::iter::{Copied, FusedIterator};

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let it: Copied<std::slice::Iter<'_, i64>> = s.iter().copied();
    let v: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?}", v);
}
