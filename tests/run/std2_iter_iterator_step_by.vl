// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::step_by.
// EXPECT: [1, 3] [1, 4]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().step_by(2).collect_in(gpa);
    let b: Vec<i64, Gpa> = v.iter().copied().step_by(3).collect_in(gpa);
    println("{:?} {:?}", a, b);
}
