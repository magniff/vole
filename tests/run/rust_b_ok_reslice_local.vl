// RULE: D1.4, Z9.5, D2.3
// Reslicing a slice local, `v = &v[a..]`: the loan is of what `v` points
// to, one deref past `v`, so the assignment to `v` kills it and is no
// conflict (rustc accepts; 0.27.1 reported borrowck.assign_borrowed). A
// slice taken before the reassignment stays valid after it.
// EXPECT: 3 2 4
fn main() {
    let a = [1, 2, 3, 4];
    let mut v: &[i64] = &a[..];
    let w = &v[1..];
    v = &v[2..];
    println("{} {} {}", v[0], w[0], v[1]);
}
