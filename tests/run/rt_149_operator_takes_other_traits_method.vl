// XFAIL: RT-149: an operator (==, !=, <, >, <=, >=, +) calls another trait's method of its name (a user trait's eq or add, Iterator's eq/ne/lt/gt/le/ge), not PartialEq's, PartialOrd's or Add's (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_002_operator_takes_other_traits_method.rs.txt).
// vole prints 'true 100', 'true false', 'false true', 'true true' at -O0 and
// -O2: `a == b` runs the user trait Same's eq and `a + b` Same's add; for It,
// a type that is both an Iterator and PartialEq/PartialOrd, `x == y` and the
// comparisons run Iterator::eq/ne/lt/gt/le/ge over the items (without the
// `IntoIterator for &It` impl the program is refused: 'IntoIterator' is not
// implemented for '&It', required by 'It::eq'). RT-73 and RT-77 are the
// inherent-method forms; here no inherent method exists: the operator is
// resolved as a method call by name and another trait's method wins. Since v0.28.0.
// EXPECT: false 3
// EXPECT: false true
// EXPECT: true true
// EXPECT: true false
use std::ops::Add;

#[derive(Clone, Copy, PartialEq)]
struct S {
    k: i64,
}

trait Same {
    fn eq(&self, o: &S) -> bool;
    fn add(self, o: S) -> S;
}

impl Same for S {
    fn eq(&self, o: &S) -> bool {
        true
    }

    fn add(self, o: S) -> S {
        S { k: 100 }
    }
}

impl Add for S {
    type Output = S;

    fn add(self, o: S) -> S {
        S { k: self.k + o.k }
    }
}

#[derive(Clone, Copy, PartialEq, PartialOrd)]
struct It {
    tag: i64,
    n: i64,
}

impl Iterator for It {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n > 0 {
            self.n -= 1;
            Some(self.n)
        } else {
            None
        }
    }
}

impl IntoIterator for &It {
    type Item = i64;
    type IntoIter = It;

    fn into_iter(self) -> It {
        *self
    }
}

fn main() {
    let a = S { k: 1 };
    let b = S { k: 2 };
    println("{} {}", a == b, (a + b).k);
    let x = It { tag: 1, n: 3 };
    let y = It { tag: 2, n: 3 };
    let z = It { tag: 1, n: 2 };
    println("{} {}", x == y, x != y);
    println("{} {}", x < y, x > z);
    println("{} {}", x <= y, x >= y);
}
