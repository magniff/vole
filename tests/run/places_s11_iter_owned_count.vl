// places IR, S11: count(), filter(): std's bodies built like any
// sem-own: owned items counted: count drops each item.
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: n 2
// PLACES: fn mk
// PLACES: drop(_3) [removed]
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let n = (0..2).map(|i| mk(i, gpa)).count();
    println("n {n}");
}
