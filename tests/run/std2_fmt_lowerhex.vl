// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::fmt LowerHex.
// EXPECT: ff
use std::fmt::{Formatter, LowerHex};

struct W {
    v: u32,
}

impl LowerHex for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main() {
    println("{:x}", W { v: 255u32 });
}
