// RULE: E1.8 (0.30.1) A borrow of a local passed to a callee keeps the
// local's proofs only when the callee's set has no `addr` and its
// signature cannot carry the reference out: no reference or raw pointer
// in its result, no parameter that can keep one (a `&mut` of something
// holding a reference). Before, a callee without `addr` was trusted: it
// could hand the reference back (`id(&d)`, `idg(&d)`, `mk(&d)`, a
// Guard whose drop writes) or store it (`h.put(&d)`), and a function
// with `addr` wrote through it later: -O2 took the division's check and
// the loop's end away, the program divided by 0 or never ended.
// ERROR: 'v_id' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'v_idg' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'v_mk' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'v_method_put' is #[no_panic], but it may panic:
// ERROR: 'v_guard' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'l_id' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR: 'l_put' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR-COUNT: 7

struct H<'a> {
    r: &'a u64,
}

struct Holder<'a> {
    r: Option<&'a u64>,
}

impl<'a> Holder<'a> {
    fn put(&mut self, r: &'a u64) {
        self.r = Some(r);
    }
}

struct Guard<'a> {
    r: &'a u64,
}

impl<'a> Guard<'a> {
    fn new(r: &'a u64) -> Guard<'a> {
        Guard { r: r }
    }
}

impl<'a> Drop for Guard<'a> {
    fn drop(&mut self) {
        let p = self.r as *const u64 as *mut u64;
        // UNSAFE: the attack: a write through a shared reference, at the drop
        // SAFETY: r is a live local's address
        unsafe {
            *p = 0;
        }
    }
}

fn id(r: &u64) -> &u64 {
    r
}

fn idg<T>(r: &T) -> &T {
    r
}

fn mk(r: &u64) -> H<'_> {
    H { r: r }
}

fn zap(r: &u64) {
    let p = r as *const u64 as *mut u64;
    // UNSAFE: the attack
    // SAFETY: p is a live local's address
    unsafe {
        *p = 0;
    }
}

fn zap_h(h: H<'_>) {
    zap(h.r);
}

fn zap_holder(h: &Holder<'_>) {
    if let Some(r) = h.r {
        zap(r);
    }
}

#[no_panic]
fn v_id(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 { zap(id(&d)); x / d } else { 0 }
}

#[no_panic]
fn v_idg(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 { zap(idg(&d)); x / d } else { 0 }
}

#[no_panic]
fn v_mk(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 { zap_h(mk(&d)); x / d } else { 0 }
}

#[no_panic]
fn v_method_put(x: u64, n: u64) -> u64 {
    let d = n;
    let mut h = Holder { r: None };
    if d != 0 { h.put(&d); zap_holder(&h); x / d } else { 0 }
}

#[no_panic]
fn v_guard(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        {
            let _g = Guard::new(&d);
        }
        x / d
    } else {
        0
    }
}

fn idi(r: &i64) -> &i64 {
    r
}

fn zapi(r: &i64) {
    let p = r as *const i64 as *mut i64;
    // UNSAFE: the attack
    // SAFETY: p is a live local's address
    unsafe {
        *p = 0;
    }
}

#[effects(unsafe)]
fn l_id(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        zapi(idi(&i));
        i += 1;
    }
    i
}

struct HolderI<'a> {
    r: Option<&'a i64>,
}

impl<'a> HolderI<'a> {
    fn put(&mut self, r: &'a i64) {
        self.r = Some(r);
    }
}

fn zap_holder_i(h: &HolderI<'_>) {
    if let Some(r) = h.r {
        zapi(r);
    }
}

#[effects(unsafe)]
fn l_put(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let mut h = HolderI { r: None };
        h.put(&i);
        zap_holder_i(&h);
        i += 1;
    }
    i
}

fn main() {
    println("{}", v_id(7, 1) + v_idg(7, 1) + v_mk(7, 1) + v_method_put(7, 1) + v_guard(7, 1));
    println("{} {}", l_id(3), l_put(3));
}
