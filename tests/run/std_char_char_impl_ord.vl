// The std item(s): std::char char::impl PartialEq; char::impl Eq; char::impl PartialOrd; char::impl Ord; char::impl Hash; char::impl Default; std::cmp ()::impl PartialEq; ()::impl Ord.
// EXPECT: true true Greater
// EXPECT: ['b', 'q', 'é'] 1 true '\0' Some('é')
use std::char::CharTryFromError;
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let e: Result<char, CharTryFromError> = char::try_from(0xD800u32);
    let f: Result<char, CharTryFromError> = char::try_from(0x110000u32);
    println("{} {} {:?}", e == f, 'a' < 'b', 'z'.cmp(&'a'));
    let mut v: Vec<char, Gpa> = Vec::new_in(gpa);
    v.push('q');
    v.push('b');
    v.push('é');
    v.sort();
    let mut h: HashSet<char, Gpa, FixedState> = HashSet::new_in(gpa);
    h.insert('x');
    h.insert('x');
    let d: char = Default::default();
    println("{:?} {} {} {:?} {:?}", v, h.len(), h.contains(&'x'), d, v.iter().max());
}
