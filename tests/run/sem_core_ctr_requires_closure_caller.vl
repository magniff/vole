// EDITION: rust
// A call with a requires inside a closure is checked when the closure runs.
// EXPECT: 2
// EXIT: 101
// STDERR: requires failed: 'x % 2 == 0' of 'half'
static mut Z: i64 = 0;

fn half(x: i64) -> i64
    requires x % 2 == 0
{
    x / 2
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let g = |y: i64| half(y);
    println("{}", g(4 + unsafe { Z }));
    println("{}", g(5 + unsafe { Z }));
    0
}
