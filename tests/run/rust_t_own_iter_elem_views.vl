// (0.27.0) Hand-translated from tests/run/own_iter_elem_views.vl to Rust's spelling.
// (0.17, T7) An element of a Vec<&str> yielded by iter() views what the
// elements view (text), not the Vec: returning it after the Vec is
// dropped is fine (0.20: the loop's binding is an access, a reborrow of
// what it designates). lines.as_slice() and lines.get(0) work too.
fn first<'a>(text: &'a str, gpa: Gpa) -> &'a str {
    let mut lines: Vec<&'a str, Gpa> = Vec::new_in(gpa);
    for l in text.split('\n') {
        lines.push(l);
    }
    for line in lines.iter() {
        return *line;
    }
    ""
}

fn main(gpa: Gpa) {
    println("{}", first("a\nb", gpa));
}
// EXPECT: a
// Runs on std since its gap closed (0.27.2.1).
