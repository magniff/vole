// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_sink_self.vl to Rust's spelling.
// sem-own: a `sink self` method consumes the receiver: dropped in the method, dead in the caller.
// EXPECT: fin 1
// EXPECT: drop 1
// EXPECT: after
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

impl D<Gpa> {
    fn finish(self) {
        println("fin {}", self.id);
    }
}

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    a.finish();
    println("after");
}
