// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::io Stdin::lines_in.
// EXPECT: ["x", "y"]
// STDIN: x
// STDIN: y
use std::io::{BufRead, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let v: Vec<String<Gpa>, Gpa> = io::stdin().lines_in(gpa).map(|l| l.unwrap()).collect_in(gpa);
    println("{:?}", v);
}
