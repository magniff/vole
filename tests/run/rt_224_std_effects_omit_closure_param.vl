// XFAIL: RT-224: std's retain (Vec, HashSet), sort_by_key, sort_unstable_by_key, sort_by_key_in, select_nth_unstable_by_key, binary_search_by_key and dedup_by_key declare #[effects] without their closure F: a closure that does io (here `print("")`) is refused inside std (0.30.2)
// EXPECT: [1, 3] 1 1
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.push(2);
    v.retain(|x| {
        print("");
        *x != 2
    });
    v.sort_by_key(|x| {
        print("");
        *x
    });
    v.as_mut_slice().sort_unstable_by_key(|x| {
        print("");
        0 - *x
    });
    v.as_mut_slice().sort_by_key_in(|x| {
        print("");
        *x
    }, gpa);
    v.as_mut_slice().select_nth_unstable_by_key(0, |x| {
        print("");
        *x
    });
    let found = v.binary_search_by_key(&3i64, |x| {
        print("");
        *x
    });
    v.dedup_by_key(|x| {
        print("");
        *x
    });
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(5);
    s.retain(|x| {
        print("");
        true
    });
    println("{:?} {} {}", v, found.unwrap_or(9), s.len());
}
