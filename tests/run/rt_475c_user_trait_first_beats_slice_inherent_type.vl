// XFAIL: RT-475c: (RT-475's mechanism, another result type) with `impl L for [i64] { fn first(&self) -> i64 { 8 } }`, `s.first()` of an `s: &[i64]` is L's (an i64, printed `8`) instead of the slice's Option: vole prints `8 8`, rustc `8 Some(1)` (the call through a `T: L` bound is 8 in both) (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p11e_slice_user_trait_vs_inherent_generic.
// EXPECT: 8 Some(1)
trait L {
    fn first(&self) -> i64;
}

impl L for [i64] {
    fn first(&self) -> i64 {
        8
    }
}

fn via_bound<T: L + ?Sized>(x: &T) -> i64 {
    x.first()
}

fn main() -> i32 {
    let a = [1i64, 2, 3];
    let s: &[i64] = &a;
    println("{} {:?}", via_bound(s), s.first());
    0
}
