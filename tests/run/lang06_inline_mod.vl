// 0.6: inline modules `mod m { ... }`, nested, with privacy, `use`,
// `super` and items of the same name in different modules.
// EXPECT: 10 20 31 7 inner
mod geometry {
    #[derive(Clone, Copy)] pub struct Point { pub x: i64, pub y: i64 }

    pub fn origin() -> Point { Point { x: 0, y: 0 } }

    fn secret() -> i64 { 7 }

    pub fn reveal() -> i64 { secret() }

    pub mod shapes {
        use super::Point;

        pub fn corner(p: Point) -> i64 { p.x + p.y }

        pub fn name() -> &'static str { "inner" }
    }
}

mod twice {
    pub fn value() -> i64 { 20 }
}

use geometry::shapes;

fn value() -> i64 { 10 }

fn main() -> i32 {
    let p = geometry::Point { x: 30, y: 1 };
    print("{}", value());
    std::fmt::print(" ");
    print("{}", twice::value());
    std::fmt::print(" ");
    print("{}", (shapes::corner(p) + geometry::shapes::corner(geometry::origin())));
    std::fmt::print(" ");
    print("{}", geometry::reveal());
    std::fmt::print(" ");
    std::fmt::println("{}", shapes::name());
    0
}
