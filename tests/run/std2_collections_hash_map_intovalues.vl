// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map IntoValues.
// EXPECT: 1
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::IntoValues;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let it: IntoValues<i64, i64, Gpa> = m.into_values();
    println("{}", it.count());
}
