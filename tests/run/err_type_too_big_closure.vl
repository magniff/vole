// (0.30.1) A type made with no syntax of its own: a closure's captures,
// two arrays of 2^60 bytes moved in. No check of a written type sees it;
// the last net, before code is made (front::types::lay_out_types),
// refuses it at the closure. (`volec check` makes no code and does not
// lay every type out: it accepts this program.)
// ERROR: values of the type 'closure() -> u8 at err_type_too_big_closure.vl:12:17' are too big
fn main() {
    let n = std::env::args().count();
    if n > 5 {
        let a = [0u8; 1usize << 60];
        let b = [1u8; 1usize << 60];
        let f = move || a[n] + b[n];
        println("{}", f());
    }
    println("ok");
}
