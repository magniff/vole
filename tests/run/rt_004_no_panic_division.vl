// XFAIL: RT-4: #[no_panic] accepts a division or remainder that panics on a zero divisor (open)
// `a / b` and `a % b` panic when b is 0, at -O0 and -O2 alike ("attempt to
// divide by zero"), but the effect inference gives neither `panic`, so
// both #[no_panic] declarations hold and the program builds; f(1, 0) then
// panics. Each should be error[effect] ('f' is #[no_panic], but it may
// panic: 'a / b' ...).
// ERROR: error[effect]
// ERROR: line 13,
// ERROR: error[effect]
// ERROR: line 18,
// ERROR-COUNT: 2
#[no_panic]
fn f(a: i64, b: i64) -> i64 {
    a / b
}

#[no_panic]
fn g(a: u32, b: u32) -> u32 {
    a % b
}

fn main() {
    println("{} {}", f(1, 0), g(1, 0));
}
