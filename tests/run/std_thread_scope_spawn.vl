// Runs on std since 0.27.2's switch.
// The std item(s): std::thread Scope::spawn.
// EXPECT: 6
use std::thread;

fn main() {
    let base = 1i64;
    let total = thread::scope(|s| {
        let a = s.spawn(|| base);
        let b = s.spawn(|| base + 1);
        let c = s.spawn(|| base + 2);
        a.join().unwrap() + b.join().unwrap() + c.join().unwrap()
    });
    println("{}", total);
}
