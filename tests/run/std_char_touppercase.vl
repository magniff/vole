// Runs on std since 0.27.2's switch.
// The std item(s): std::char ToUppercase.
// EXPECT: 2 S S

fn main() {
    let mut it = 'ß'.to_uppercase();
    let a = it.next();
    let b = it.next();
    let mut n: usize = 0;
    if a.is_some() {
        n += 1;
    }
    if b.is_some() {
        n += 1;
    }
    println("{} {} {}", n, a.unwrap(), b.unwrap());
}
