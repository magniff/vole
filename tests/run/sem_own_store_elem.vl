// EDITION: rust
// (0.25) A store to an element drops the element it replaces, once: an
// index evaluated once, swap/replace on elements, nested `w[0][0]`, a
// field of an element, an array element, a tuple part, Vec::set. (A
// temporary cannot be lent inout, conv.place: swap's second place is t3.)
// EXPECT: drop 1
// EXPECT: calls 1
// EXPECT: drop 2
// EXPECT: old 3
// EXPECT: drop 5
// EXPECT: drop 7
// EXPECT: drop 9
// EXPECT: drop 12
// EXPECT: drop 14
// EXPECT: drop 4
// EXPECT: end
// EXPECT: drop 15
// EXPECT: drop 11
// EXPECT: drop 13
// EXPECT: drop 8
// EXPECT: drop 10
// EXPECT: drop 6
// EXPECT: drop 3
// EXPECT: drop 16
// EXPECT: live 0
use std::mem; use std::alloc::Allocator; static mut LIVE: i64 = 0;
static mut CALLS: i64 = 0;
struct D { id: i64 }
fn mk(id: i64) -> D { unsafe { LIVE += 1; } D { id: id } }
impl Drop for D { fn drop(&mut self) { unsafe { LIVE -= 1; } println("drop {}", self.id); } }
struct H<A: Allocator> { d: D, v: Vec<D, A> }
fn idx() -> i64 { unsafe { CALLS += 1; } 0 }

fn main(gpa: Gpa) -> i32 {
    {
        let mut v: Vec<D, Gpa> = Vec::new_in(gpa);
        v.push(mk(1));
        v[idx() as usize] = mk(2);
        let calls_now = unsafe { CALLS }; println("calls {calls_now}");
        { let mut t3 = mk(3); mem::swap(&mut v[0], &mut t3); }
        let old = mem::replace(&mut v[0], mk(4));
        println("old {}", old.id);
        let mut w: Vec<Vec<D, Gpa>, Gpa> = Vec::new_in(gpa);
        let mut inner: Vec<D, Gpa> = Vec::new_in(gpa);
        inner.push(mk(5));
        w.push(inner);
        w[0][0] = mk(6);
        let mut hs: Vec<H<Gpa>, Gpa> = Vec::new_in(gpa);
        hs.push(H { d: mk(7), v: Vec::new_in(gpa) });
        hs[0].d = mk(8);
        hs[0].v.push(mk(9));
        hs[0].v[0] = mk(10);
        let mut arr = [mk(11), mk(12)];
        arr[1] = mk(13);
        let mut t: Vec<(i64, D), Gpa> = Vec::new_in(gpa);
        t.push((1, mk(14)));
        t[0].1 = mk(15);
        v[0usize] = mk(16);
        println("end");
    }
    let live_now = unsafe { LIVE }; println("live {live_now}");
    0
}
