// RULE: F18.5
// (0.30.2) `a.into()` with nothing at the call saying what it converts
// to: rustc's `{integer}: Into<?U>`, both types left to the function's
// end, the conversion the cast and From of the two types checked there.
// Here `u32` for `a` and `i64` for the result: From<u32> for i64 holds,
// the value is converted from u32 (a closure's result and a format hole
// alike). An earlier 0.30.2 build called the blanket impl's i32 instance.
// EXPECT: 4000000000 4000000000
// EXPECT: 4000000000 4000000000
// EXPECT: 4000000000|4000000000
fn direct() {
    let a = 4000000000;
    let r = a.into();
    let s: i64 = r;
    let c: u32 = a;
    println("{} {}", s, c);
}

fn in_closure() {
    let a = 4000000000;
    let f = || { let r = a.into(); r };
    let s: i64 = f();
    let c: u32 = a;
    println("{} {}", s, c);
}

fn hole() {
    let a = 4000000000;
    let r = a.into();
    let s: i64 = r;
    let c: u32 = a;
    println("{}|{}", s, c);
}

fn main() {
    direct();
    in_closure();
    hole();
}
