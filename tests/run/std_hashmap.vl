// EDITION: rust
// XFAIL: gap 5: compile type error: method 'hash' expects 1 arguments, got 0
// EXPECT: len 1000 sum 499500
// EXPECT: get 49 none
// EXPECT: removed 333 len 999 missing
// EXPECT: replaced 49 now 70
// EXPECT: words 4: the=3 cat=1 sat=1 mat=1
// EXPECT: iterated 4 total 6
// EXPECT: points 2
// 0.9: std's HashMap<K: Hash + Eq, V>: integer keys, string keys, a user
// key type, and iteration by slots.
// (0.26.4) Its PRNG and checksums are written wrapping_*.
use std::hash::Hash; use std::collections::HashMap;

#[derive(Clone, Copy)] struct Point { x: i64, y: i64 }

impl Hash for Point {
    fn hash(&self) -> u64 { self.x.hash() ^ self.y.hash().wrapping_mul(3u64) }
}

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    for i in 0..1000 {
        m.insert(i, i * i);
    }
    let mut sum: i64 = 0;
    for i in 0..1000 {
        sum += m.get(&i).copied().unwrap() - i * i + i;
    }
    print("len ");
    print("{}", (m.len() as i64));
    print(" sum ");
    print("{}", sum);
    println("");
    print("get ");
    print("{}", m.get(&7).copied().unwrap());
    println("{}", if m.get(&1000).copied().is_none() { " none" } else { " some" });
    print("removed ");
    print("{}", (m.remove(&333).unwrap_or(-1) / 333));
    print(" len ");
    print("{}", (m.len() as i64));
    println("{}", if m.contains_key(&333) { " present" } else { " missing" });
    let old = m.insert(7, 70).unwrap();
    print("replaced ");
    print("{}", old);
    print(" now ");
    print("{}", m.get(&7).copied().unwrap());
    println("");
    drop(m);

    let mut counts: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    let words = ["the", "cat", "sat", "the", "mat", "the"];
    for w in words {
        let n = counts.get(&w).copied().unwrap_or(0);
        counts.insert(w, n + 1);
    }
    print("words ");
    print("{}", (counts.len() as i64));
    print(":");
    let order = ["the", "cat", "sat", "mat"];
    for w in order {
        print(" ");
        print("{}", w);
        print("=");
        print("{}", counts.get(&w).copied().unwrap());
    }
    println("");
    let mut seen: i64 = 0;
    let mut total: i64 = 0;
    for i in 0..counts.slots() {
        if let Some(v) = counts.value_at(i) {
            seen += 1;
            total += v;
            if counts.key_at(i).is_none() {
                return 1;
            }
        }
    }
    print("iterated ");
    print("{}", seen);
    print(" total ");
    print("{}", total);
    println("");
    drop(counts);

    let mut pts: HashMap<Point, i64, Gpa> = HashMap::new_in(gpa);
    pts.insert(Point { x: 1, y: 2 }, 1);
    pts.insert(Point { x: 2, y: 1 }, 2);
    pts.insert(Point { x: 1, y: 2 }, 3);
    print("points ");
    print("{}", (pts.len() as i64));
    println("");
    0
}
