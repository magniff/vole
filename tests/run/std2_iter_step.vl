// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Step.
// EXPECT: [1, 2, 3]
// RUSTC: none (Rust's Step is unstable)

fn upto<A: std::iter::Step>(a: A, b: A, gpa: Gpa) -> Vec<A, Gpa> {
    (a..b).collect_in(gpa)
}

fn main(gpa: Gpa) {
    println("{:?}", upto(1i64, 4, gpa));
}
