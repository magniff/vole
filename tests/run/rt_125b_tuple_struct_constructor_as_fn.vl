// XFAIL: RT-125b: (RT-125's mechanism, a tuple struct) a tuple struct's constructor is not a function value: `let f = T;` is "'T' is a type, not a value", and `.map(T)` the same; rustc prints the EXPECT line (0.30.2)
// From the g302static work (its pre/pre05; its variant half, `let g =
// E::A;`, is RT-125). Since v0.30.1 at least (the same error).
// EXPECT: 3 2
struct T(u64);

fn main() {
    let f = T;
    let w = [1u64, 2];
    let n = w.iter().copied().map(T).count();
    println("{} {}", f(3).0, n);
}
