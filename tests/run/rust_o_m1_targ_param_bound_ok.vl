// (0.30.2, obligations M1) rust_o_m1_targ_param_bound_err with A, a Bound:
// `W: Tr<A>` holds. rustc accepts it.
// EXPECT: 1
trait Bound {}
trait Tr<U> { fn f(&self) -> i64; }
struct W;
struct A;
struct B;
impl Bound for A {}
impl<U: Bound> Tr<U> for W { fn f(&self) -> i64 { 1 } }
fn go<T: Tr<A>>(t: &T) -> i64 { t.f() }
fn main() { println("{}", go(&W)); }
