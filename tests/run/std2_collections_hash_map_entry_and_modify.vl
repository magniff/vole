// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map Entry::and_modify.
// EXPECT: 1 11
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.entry(1).and_modify(|x| *x += 10).or_insert(1);
    let a = m[&1];
    m.entry(1).and_modify(|x| *x += 10).or_insert(1);
    println("{} {}", a, m[&1]);
}
