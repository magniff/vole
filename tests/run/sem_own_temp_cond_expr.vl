// EDITION: rust
// sem-own: an owned temporary in an if condition: dropped before the branch runs? (after the condition, as a statement temporary of the if).
// (a temporary lives to the end of its statement, here the whole if, as documented)
// EXPECT: yes
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    { let t = mk(1, gpa); if t.id == 1 { println("yes"); } }
    println("end");
}
