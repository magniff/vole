// EDITION: rust
// let x = v[0] borrows; assigning v[0] while x is used conflicts
// ERROR: error[borrowck.conflict]
// ERROR: line 7, column 5
fn main(gpa: Gpa) {
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa); v.push(Vec::new_in(gpa)); let x = &v[0];
    v[0] = Vec::new_in(gpa); println("{}", x.len());
}
