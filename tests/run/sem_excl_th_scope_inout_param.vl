// EDITION: rust
// a scoped thread writing through the caller's inout parameter
// ERROR: error[borrowck.mut_twice]
// ERROR: line 9, column 61
use std::thread;

fn go(n: &mut i64) {
    thread::scope(|s| ({ let s = s; {
        let a = s.spawn(|| { *n += 1; 0 }); let b = s.spawn(|| { *n += 1; 0 }); a.join().unwrap() + b.join().unwrap()
    } }));
}

fn main() { let mut n: i64 = 0; go(&mut n); println("{n}"); }
