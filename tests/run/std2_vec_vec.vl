// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec.
// EXPECT: 3 [1, 2, 3]
use std::vec::Vec;

fn first(v: &Vec<i64, Gpa>) -> Option<&i64> {
    v.first()
}

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = Vec::from_in([1, 2, 3], gpa);
    println("{} {:?}", v.len(), v);
    let _ = first(&v);
}
