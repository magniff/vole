// EDITION: rust
// RULE: F11.1
// `type Item: Show;` in the trait: an impl's `type Item = U` must have
// `U: Show`.
// ERROR: 'Src::Item = U' must implement 'Show', as the trait declares
trait Show {
    fn show(&self) -> i64;
}

trait Src {
    type Item: Show;
    fn item(&self) -> Self::Item;
}

struct U {
    n: i64,
}

struct S {
    n: i64,
}

impl Src for S {
    type Item = U;

    fn item(&self) -> U {
        U { n: self.n }
    }
}

fn main() -> i64 {
    let s = S { n: 1 };
    s.item().n
}
