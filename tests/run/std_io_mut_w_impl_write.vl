// Runs on std since 0.27.2's switch.
// The std item(s): std::io &mut W::impl Write.
// EXPECT: [7]
use std::io::{ErrorKind, Write};

fn put<W: Write>(mut w: W) {
    w.write_all(&[7]).unwrap();
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    put(&mut v);
    println("{:?}", v);
}
