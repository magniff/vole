// EDITION: rust
// RULE: E3.3a
// (0.27.2.1) A parametric item: `#[effects(T)]` lets through what the
// edges made for T do (Loud's clone counts in a static), checked per
// instance; the
// same body declared `#[effects()]` is refused for that instance.
// ERROR: 'W::dup_bad' is #[effects()], but it touches a static mut or a C static (static): 'self.x.clone()' at
// ERROR: note: in instantiation of 'W<Loud>::dup_bad'
struct W<T> {
    x: T,
}

impl<T: Clone> W<T> {
    #[effects(T)]
    pub fn dup(&self) -> T {
        self.x.clone()
    }

    #[effects()]
    pub fn dup_bad(&self) -> T {
        self.x.clone()
    }
}

struct Loud {
    n: i64,
}

static mut CLONES: i64 = 0;

impl Clone for Loud {
    fn clone(&self) -> Loud {
        // UNSAFE: a static mut written.
        // SAFETY: one thread.
        unsafe {
            CLONES += 1;
        }
        Loud { n: self.n }
    }
}

fn main() {
    let w = W { x: Loud { n: 5 } };
    let v = w.dup();
    let u = w.dup_bad();
    println("{}", v.n + u.n);
}
