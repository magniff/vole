// EDITION: rust
// XFAIL: gap 3: compile type error: no method 'try_alloc' on type 'let Bump'
// (0.16) Allocation through the Allocator trait costs no call where it
// need not: an arena's bump path (here a small arena of the test's own,
// shaped like std's: the fast path inline, the refill a cold function)
// inlines into its caller without a call, and a block from Gpa that does
// not escape is a frame slot (heap to stack through Gpa's inlined
// methods: no malloc, no free, the null check folded).
// EXPECT: 2047 1 84 2047
// CHECK: fn make:
// CHECK-NOT: try_alloc
// CHECK: call bump_refill
// CHECK: fn scratch:
// CHECK-NOT: call
// CHECK: ret
// CHECK: fn main:
use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(n: u64) -> *mut u8;
}

#[derive(Clone, Copy)] struct BumpState { base: *mut u8, used: i64, limit: i64, chunks: i64 }

#[derive(Clone, Copy)] struct Bump { s: *mut BumpState }

// UNSAFE: a test's bump allocator (0.26.3: Allocator is an unsafe trait).
// SAFETY: its memory is its state's buffer, refilled from C's malloc: a piece
// lies inside the buffer it was cut from.
unsafe impl Allocator for Bump {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
            unsafe {
                let s = self.s;
                let at = ((*s).used + align - 1) & (0 - align);
                if at + size <= (*s).limit {
                    (*s).used = at + size;
                    return NonNull::new((*s).base.add(at as usize)).ok_or(AllocError);
                }
                bump_refill(s, size, align)
            }
        }).ok_or(AllocError)
    }

    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr(); let old_size = __old.size() as i64;
        let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
            let q = self.try_alloc(new_size, align);
            if q != 0 as *mut u8 {
                let n = if old_size < new_size { old_size } else { new_size };
                for i in 0..n {
                    (*q.add(i as usize)) = (*p.add(i as usize));
                }
            }
            q
        }).ok_or(AllocError)
    } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> { unsafe { self.grow(p, old, new) } }

    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr(); let size = __layout.size() as i64;
        let align = __layout.align() as i64;
    }
}

#[cold]
#[inline(never)]
unsafe fn bump_refill(s: *mut BumpState, size: i64, align: i64) -> *mut u8 {
    let bytes: i64 = if size + align > 65536 { size + align } else { 65536 };
    let chunk = malloc(bytes as u64);
    if chunk == 0 as *mut u8 {
        return chunk;
    }
    (*s).base = chunk;
    (*s).limit = bytes;
    (*s).chunks += 1;
    let at = (((chunk as i64) + align - 1) & (0 - align)) - (chunk as i64);
    (*s).used = at + size;
    chunk.add(at as usize)
}

#[derive(Clone, Copy)] struct Node { left: *mut Node, right: *mut Node }

fn make(a: Bump, depth: i64) -> *mut Node {
    let n = a
        .allocate(Layout::from_size_align(16 as usize, 8 as usize).unwrap())
        .unwrap()
        .as_ptr() as *mut Node;
    unsafe {
        if depth > 0 {
            (*n).left = make(a, depth - 1);
            (*n).right = make(a, depth - 1);
        } else {
            (*n).left = 0 as *mut Node;
            (*n).right = 0 as *mut Node;
        }
    }
    n
}

fn check(n: Node) -> i64 {
    unsafe {
        if n.left == 0 as *mut Node {
            return 1;
        }
        1 + check(*n.left) + check(*n.right)
    }
}

fn scratch(gpa: Gpa, k: i64) -> i64 {
    let mut g = gpa;
    let p = g
        .allocate(Layout::from_size_align(64 as usize, 8 as usize).unwrap())
        .unwrap()
        .as_ptr() as *mut i64;
    let mut s: i64 = 0;
    unsafe {
        for i in 0..8 {
            (*p.add(i as usize)) = i * k;
        }
        for i in 0..8 {
            s += (*p.add(i as usize));
        }
        g.deallocate(NonNull::new((p as *mut u8)).unwrap(),
            Layout::from_size_align(64 as usize, 8 as usize).unwrap());
    }
    s
}

fn main(gpa: Gpa) -> i32 {
    // (Through a function value: not inlined into main.)
    let f = scratch;
    let mut state = BumpState { base: 0 as *mut u8, used: 0, limit: 0, chunks: 0 };
    let a = Bump { s: &mut state };
    let t = make(a, 10);
    unsafe { printf(c"%ld %ld %ld %ld\n", check(*t), state.chunks, f(gpa, 3i64), check(*t)); }
    0
}
