// From the review of g302bor2 (form B/b31). Since v0.30.1 at least; the
// release build the same. The Item of a Peekable<Enumerate<Iter<i64>>> is
// `(usize, &i64)`, a borrow of v, not of the local i; through
// enumerate() alone or zip() the body is accepted (and RT-387 is the
// unsound side of the same signature).
// EXPECT: Some((0, 1000))
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = first(v.iter().enumerate().peekable(), &k);
    println("{:?}", r);
}
