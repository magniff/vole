// Runs on std since 0.27.2's switch.
// The std item(s): std::option Option::inspect.
// EXPECT: saw 3
// EXPECT: Some(3)
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b = a.inspect(|x| println("saw {}", x));
    let c: Option<i64> = None;
    let _ = c.inspect(|x| println("saw {}", x));
    println("{:?}", b);
}
