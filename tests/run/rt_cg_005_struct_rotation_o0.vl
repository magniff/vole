// RT-CG-5 (fixed in 0.30.1): a rotation of three structs of an i64 and an f64 around a loop's edge, whose pieces share spill slots across classes; x86-64 printed the integers and floats of v10 and v11 as each other's bits
// FLAGS: -O0
// EXPECT: 6 1 3.75 15 5 0 1.875 12 true false 17 14 10.5 6 6.5 18 29 0 0
// Run on x86-64 to see it (`tests/run.sh -t x86_64-macos -n
// rt_cg_005_struct_rotation_o1`, _o2): the release branch was wrong at
// -O1 and -O2 there. From the review's generator (seed 1099), reduced.
// The EXPECT line is rustc's.
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
struct P { a: i64, b: f64 }
#[inline(never)]
fn g(a: i64) -> i64 { K.fetch_add(1, Ordering::Relaxed); a ^ 5 }

fn main() {
    let lim = (g(7) & 15) + 3;
    let mut v0: i32 = (g(3) as i32) & 1023;
    let mut v1: i32 = (g(4) as i32) & 1023;
    let mut v2: f32 = (g(3) as f32) * 0.625;
    let mut v3: P = P { a: g(3), b: (g(8) as f64) * 0.5 };
    let mut v4: f32 = (g(5) as f32) * 0.625;
    let mut v5: f32 = (g(6) as f32) * 0.625;
    let mut v6: i32 = (g(9) as i32) & 1023;
    let mut v7: bool = (g(7) & 1) == 0;
    let mut v8: bool = (g(8) & 1) == 0;
    let mut v9: i64 = g(20);
    let mut v10: P = P { a: g(10), b: (g(15) as f64) * 0.5 };
    let mut v11: P = P { a: g(11), b: (g(16) as f64) * 0.5 };
    let mut v12: i64 = g(23);
    let mut v13: i64 = g(24);
    let mut t: i64 = 0;
    let mut s: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        let c = g(t);
        if (c & 3) == 0 {
            { let tmp_r = v11; v11 = v3; v3 = v10; v10 = tmp_r; }
        }
        t += 1;
    }
    println("{} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}", v0, v1, v2, v3.a, v3.b, v4,
        v5, v6, v7, v8, v9, v10.a, v10.b, v11.a, v11.b, v12, v13, s, sf);
}
