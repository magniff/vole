// RULE: F5.6
// (0.30.1) std's atomics' traits are sealed: an Atomic is one machine
// access of 1 to 8 bytes, which the compiler makes for std's impls only.
// Their method returns a std::sync::atomic::Sealed, a public struct with
// no fields that a program can make, so 0.30.0 took this impl, and the
// Atomic of a 24-byte struct crashed (exit 139).
// ERROR: trait 'AtomicValue' is sealed
// ERROR-COUNT: 1
use std::sync::atomic::{Atomic, AtomicValue, Ordering, Sealed};

#[derive(Clone, Copy, PartialEq)]
struct M {
    a: i64,
    b: i64,
    c: i64,
}

impl AtomicValue for M {
    fn sealed_value(self) -> Sealed {
        Sealed {}
    }
}

fn main() {
    let x = Atomic::new(M { a: 1, b: 2, c: 3 });
    let v = x.load(Ordering::SeqCst);
    println("{}", v.a + v.b + v.c);
}
