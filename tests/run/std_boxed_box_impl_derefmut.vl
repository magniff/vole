// The std item(s): std::boxed Box::impl DerefMut.
// EXPECT: 7 [1, 2, 3]
use std::boxed::Box;
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut b = Box::new_in(1i64, gpa);
    *b = 7;
    let mut v = Box::new_in(Vec::new_in(gpa), gpa);
    v.push(1i64);
    v.push(2);
    v.push(3);
    println("{} {:?}", b, v);
}
