// XFAIL: RT-161: a clause's own binding named `old` is taken as `old(..)`: `ensures { let old = |v| v + 100; old(*x) > 100 }` aborts with "ensures failed" though the clause holds (0.30.2)
// From g302holes (pre-existing, v0.30.1 too): expand.vl replace_olds takes any
// call named `old` before names resolve. The clause's closure shadows.
// EXPECT: 2
// EXPECT: 20
fn old(v: i64) -> i64 {
    v * 10
}

fn f(x: &mut i64)
    ensures { let old = |v: i64| v + 100; old(*x) > 100 }

{
    *x = *x + 1;
}

fn main() {
    let mut a = 1i64;
    f(&mut a);
    println("{}", a);
    println("{}", old(2));
}
