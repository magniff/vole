// RULE: F8.3, D22.3
// RT-C301-8: `T::K`, `T::m(t)`, `T::mk()` with T bounded by one trait are
// that trait's items in the instance, though the instance's type S
// implements another trait with the same names; an impl's parameter too.
// 0.30.1 printed `2 2 1 2 3 3 23`. rustc prints 1 2 1 2 3 4 24.
// EXPECT: 1 2 1 2 3 4 24
trait A { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
trait B { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } fn mk() -> i64 { 3 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } fn mk() -> i64 { 4 } }
fn ka<T: A>() -> i64 { T::K }
fn kb<T: B>() -> i64 { T::K }
fn ma<T: A>(t: &T) -> i64 { T::m(t) }
fn mb<T: B>(t: &T) -> i64 { T::m(t) }
fn mka<T: A>() -> i64 { T::mk() }
fn mkb<T: B>() -> i64 { T::mk() }
struct W<T> { t: T }
impl<T: B> W<T> { fn k(&self) -> i64 { T::K * 10 + T::mk() } }

fn main() {
    println("{} {} {} {} {} {} {}", ka::<S>(), kb::<S>(), ma(&S), mb(&S), mka::<S>(), mkb::<S>(),
        W { t: S }.k());
}
