// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::borrow BorrowMut.
// EXPECT: 2
use std::borrow::{Borrow, BorrowMut};

fn bump<B: BorrowMut<i64>>(mut b: B) -> i64 {
    *b.borrow_mut() += 1;
    *b.borrow()
}

fn main() {
    println("{}", bump(1i64));
}
