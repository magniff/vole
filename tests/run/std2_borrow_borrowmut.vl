// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::borrow BorrowMut.
// EXPECT: 2
use std::borrow::{Borrow, BorrowMut};

fn bump<B: BorrowMut<i64>>(mut b: B) -> i64 {
    *b.borrow_mut() += 1;
    *b.borrow()
}

fn main() {
    println("{}", bump(1i64));
}
