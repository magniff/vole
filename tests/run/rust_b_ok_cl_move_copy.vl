// EDITION: rust
// RULE: D10.2
// (0.27.1) A `move` closure copies a `Copy` capture: the snapshot.

fn main() {
    let mut n: i64 = 1;
    let f = move || n;
    n = 5;
    println("{} {}", f(), n);
}
// EXPECT: 1 5
