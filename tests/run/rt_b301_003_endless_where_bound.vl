// XFAIL: RT-B301-3: an impl whose where-bound needs itself one level deeper is accepted (open, 0.30.2)
// `impl<T> Tr for W<T> where W<W<T>>: Tr` makes `W<i64>: Tr` need
// `W<W<i64>>: Tr`, and so on without end; rustc refuses the use (E0275,
// overflow evaluating the requirement), vole accepts it and prints 1.
// ERROR: error[
// ERROR-COUNT: 1
trait Tr { fn v(&self) -> i64; }
struct W<T> { t: T }
impl<T> Tr for W<T> where W<W<T>>: Tr { fn v(&self) -> i64 { 1 } }
fn use_it<T: Tr>(t: &T) -> i64 { t.v() }

fn main() {
    let w = W { t: 1i64 };
    println("{}", use_it(&w));
}
