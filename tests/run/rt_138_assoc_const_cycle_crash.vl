// XFAIL: RT-138: associated consts defined by each other crash the compiler (SIGBUS) at check and build; rustc reports the cycle (E0391) (0.30.2)
// From the review of c302const; v0.30.1 too.
// ERROR: cycle
struct S;

impl S {
    const X: u8 = Self::Y + 1;
    const Y: u8 = Self::X;
}

fn main() {
    println("{}", S::Y);
}
