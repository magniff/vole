// RULE: Z9.1c
// (0.27.5) `.as_ref()` of a generic receiver bound where `&[u8]` is
// expected: `C = &str` takes `impl AsRef<U> for &T` with T = str, whose
// result has `&self`'s region (no borrowck.outlives), and a body that
// calls through `**self` or a `let t: &T` reaches str's impl, not itself
// (before: a stack overflow, exit 139). A receiver `c: C` by value is the
// bound's method in an instance, `<&str as Tag>`.
// EXPECT: 3 3 4 4 5 5 11
trait View<T: ?Sized> {
    fn view(&self) -> &T;
}

impl View<[u8]> for str {
    fn view(&self) -> &[u8] {
        self.as_bytes()
    }
}

impl<T: ?Sized + View<U>, U: ?Sized> View<U> for &T {
    fn view(&self) -> &U {
        (**self).view()
    }
}

trait Look<T: ?Sized> {
    fn look(&self) -> &T;
}

impl Look<[u8]> for str {
    fn look(&self) -> &[u8] {
        self.as_bytes()
    }
}

impl<T: ?Sized + Look<U>, U: ?Sized> Look<U> for &T {
    fn look(&self) -> &U {
        let t: &T = *self;
        t.look()
    }
}

trait Tag {
    fn tag(&self) -> i64;
}

impl Tag for str {
    fn tag(&self) -> i64 {
        1
    }
}

impl<T: ?Sized + Tag> Tag for &T {
    fn tag(&self) -> i64 {
        (**self).tag() + 10
    }
}

fn bytes<C: AsRef<[u8]>>(c: C) -> usize {
    let b: &[u8] = c.as_ref();
    b.len()
}

fn viewed<C: View<[u8]>>(c: C) -> usize {
    let b: &[u8] = c.view();
    b.len()
}

fn looked<C: Look<[u8]>>(c: C) -> usize {
    let b: &[u8] = c.look();
    b.len()
}

fn tagged<C: Tag>(c: C) -> i64 {
    c.tag()
}

fn main() {
    let s: &str = "abcd";
    println("{} {} {} {} {} {} {}", bytes("abc"), viewed("abc"), bytes(s), looked(s),
        viewed("abcde"), looked("abcde"), tagged(s));
}
