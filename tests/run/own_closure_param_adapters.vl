// XFAIL: gap 4: compile type error: expected 'usize', got 'i64'
// (0.25.3) std's adapters given owned items (map, filter, for_each, fold,
// enumerate's pairs, `|_|`, a generic fn's map): each dropped once, in the
// closure; a borrowing iterator's items (w.iter(), a HashMap's iter and
// values) are the container's, never dropped by the closure; Option and
// Result's closures (map, map_err, unwrap_or_else, and_then) drop their
// payload. Leaked before 0.25.3.
// FLAGS: --check-alloc
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: map 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: filter 1
// EXPECT: each 4
// EXPECT: drop 4
// EXPECT: each 5
// EXPECT: drop 5
// EXPECT: drop 6
// EXPECT: drop 7
// EXPECT: fold 13
// EXPECT: fold-keep 2
// EXPECT: en 0 10
// EXPECT: drop 10
// EXPECT: en 1 11
// EXPECT: drop 11
// EXPECT: us
// EXPECT: drop 12
// EXPECT: us
// EXPECT: drop 13
// EXPECT: eat 14
// EXPECT: drop 14
// EXPECT: eat 15
// EXPECT: drop 15
// EXPECT: drop 16
// EXPECT: drop 17
// EXPECT: fm 17
// EXPECT: drop 18
// EXPECT: drop 19
// EXPECT: generic 37
// EXPECT: w 1
// EXPECT: w 0
// EXPECT: w_
// EXPECT: w_
// EXPECT: borrow 1 1 1 2
// EXPECT: m 2 0
// EXPECT: m 1 1
// EXPECT: map 1 4 1
// EXPECT: drop 30
// EXPECT: opt 30
// EXPECT: drop 31
// EXPECT: res true
// EXPECT: drop 32
// EXPECT: else 32
// EXPECT: and_then true
// EXPECT: end
// EXPECT: drop 33
// EXPECT: drop 8
// EXPECT: drop 9
use std::alloc::Allocator; use std::collections::HashMap;
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn total<I: Iterator<Item = D<Gpa>>>(it: I) -> i64 { it.map(|d| d.id).sum::<i64>() }

fn main(gpa: Gpa) {
    // owned items: map, filter, for_each, fold, filter_map, enumerate pattern, underscore
    let s: i64 = (0i64..2i64).map(|i| mk(i, gpa)).map(|d| d.id).sum::<i64>();
    println("map {s}");
    let n = (2i64..4i64).map(|i| mk(i, gpa)).filter(|x| ({ let d = *x; d.id > 2 })).count();
    println("filter {n}");
    (4i64..6i64).map(|i| mk(i, gpa)).for_each(|d| println("each {}", d.id));
    let f = (6i64..8i64).map(|i| mk(i, gpa)).fold(0i64, |a, d| a + d.id);
    println("fold {f}");
    let g: Vec<D<Gpa>, Gpa> = (8i64..10i64)
        .map(|i| mk(i, gpa))
        .fold(Vec::<D<Gpa>, Gpa>::new_in(gpa), |a, d| { let mut b = a; b.push(d); b });
    println("fold-keep {}", g.len());
    (10i64..12i64).map(|i| mk(i, gpa)).enumerate().for_each(|(k, d)| println("en {k} {}", d.id));
    (12i64..14i64).map(|i| mk(i, gpa)).for_each(|_| println("us"));
    (14i64..16i64).map(|i| mk(i, gpa)).for_each(|d| eat(d));
    let fm: i64 = (16i64..18i64)
        .map(|i| mk(i, gpa))
        .map(|d| d.id)
        .filter(|x| ({ let k = *x; k > 16 }))
        .sum::<i64>();
    println("fm {fm}");
    println("generic {}", total((18i64..20i64).map(|i| mk(i, gpa))));
    // borrowing iterators: items are the container's, never dropped by the closure
    let mut w: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(Vec::new_in(gpa));
    w.push(Vec::new_in(gpa));
    w[0].push(1);
    let lens: i64 = w.iter().map(|x| x.len()).sum::<usize>() as i64;
    w.iter().for_each(|x| println("w {}", x.len()));
    let fl = w.iter().fold(0i64, |a, x| a + x.len() as i64);
    let fc = w.iter().filter(|x| ({ let x = *x; x.len() > 0 })).count();
    let en: i64 = w.iter().enumerate().map(|(i, x)| i + x.len() as i64).sum::<i64>();
    w.iter().for_each(|_| println("w_"));
    println("borrow {lens} {fl} {fc} {en}");
    let mut m: HashMap<i64, Vec<i64, Gpa>, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, w[0].clone());
    m.insert(2, w[1].clone());
    let mv: i64 = m.values().map(|v| v.len()).sum::<usize>() as i64;
    let mk2: i64 = m.iter().map(|(k, v)| k + v.len() as i64).sum::<i64>();
    m.iter().for_each(|(k, v)| println("m {k} {}", v.len()));
    let og = m.get(&1).clone().map(|v| v.len()).unwrap_or(0usize);
    println("map {mv} {mk2} {og}");
    // Option, Result with owned payloads
    let o: Option<D<Gpa>> = Some(mk(30, gpa));
    println("opt {}", o.map(|d| d.id).unwrap_or(0));
    let r: Result<i64, D<Gpa>> = Err(mk(31, gpa));
    println("res {}", r.map_err(|d| d.id).unwrap_or(0) == 0);
    let r2: Result<i64, D<Gpa>> = Err(mk(32, gpa));
    println("else {}", r2.unwrap_or_else(|d| d.id));
    let o2: Option<D<Gpa>> = Some(mk(33, gpa));
    let kept = o2.and_then(|d| if d.id > 0 { Some(d) } else { None });
    println("and_then {}", kept.is_some());
    println("end");
}
