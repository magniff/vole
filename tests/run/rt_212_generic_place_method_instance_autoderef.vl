// XFAIL: RT-212: in a generic body, `x.clone()` on a place of type T that is not a plain local (a field `self.value`, `self.0`, `self.a[0]`, `p.0`) takes the instance's autoderef steps: with T = &W it runs W's Clone (prints "W::clone", gives a W) instead of copying the &W (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_034_generic_place_method_takes_instance_autoderef.rs.txt):
// T's only clone is <T as Clone>::clone, which for T = &W copies the reference.
// vole prints `W::clone` then `field W { k: 101 }` for each of the five; on a
// plain parameter `t.clone()` and on `let r: &T = &self.value; r.clone()` it is
// right (gc/c2.vl, c3.vl), and where the result must be a T (`fn get(&self) -> T
// { self.value.clone() }`) it is refused (`expected '&W', got 'W'`): std's
// Repeat::next is that form, so `std::iter::repeat(&k).take(2).count()` fails
// inside std (gc/c1.vl, om/z44.vl). RT-72 is the inherent-method form. Since
// v0.28.0; every -O; g302probe the same.
// EXPECT: field W { k: 1 }
// EXPECT: tuple W { k: 1 }
// EXPECT: index W { k: 1 }
// EXPECT: param field W { k: 1 }
// EXPECT: by value field W { k: 1 }
use std::fmt::Debug;

#[derive(Debug)]
struct W {
    k: i64,
}

impl Clone for W {
    fn clone(&self) -> W {
        println("W::clone");
        W { k: self.k + 100 }
    }
}

struct Rep<T> {
    value: T,
}

struct Tup<T>(T, i64);

struct Arr<T> {
    a: [T; 1],
}

impl<T: Clone + Debug> Rep<T> {
    fn show(&self) {
        let c = self.value.clone();
        println("field {:?}", c);
    }
}

impl<T: Clone + Debug> Tup<T> {
    fn show(&self) {
        let c = self.0.clone();
        println("tuple {:?}", c);
    }
}

impl<T: Clone + Debug> Arr<T> {
    fn show(&self) {
        let c = self.a[0].clone();
        println("index {:?}", c);
    }
}

fn pair<T: Clone + Debug>(p: (T, i64)) {
    let c = p.0.clone();
    println("param field {:?}", c);
}

fn by_box<T: Clone + Debug>(b: Rep<T>) {
    let c = b.value.clone();
    println("by value field {:?}", c);
}

fn main() {
    let w = W { k: 1 };
    Rep { value: &w }.show();
    Tup(&w, 0i64).show();
    Arr { a: [&w] }.show();
    pair((&w, 0i64));
    by_box(Rep { value: &w });
}
