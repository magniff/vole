// EDITION: rust
// 0.14: closures: captures, calls, parameters from the context.
// EXPECT: 11
// EXPECT: 5 42 2
// EXPECT: 42 81
// EXPECT: 111 103
// EXPECT: 7
fn apply<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn call(f: fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

#[derive(Clone, Copy)] struct Holder<F> {
    f: F,
}

fn main() -> i64 {
    let k: i64 = 10;
    print("{}", apply(|x| x + k, 1i64));
    println("");
    // written types, a pattern parameter, a field holding a closure
    let add = |a: i64, b: i64| a + b;
    let pair = |(a, b): (i64, i64)| a * b;
    let h = Holder { f: |x: i64| x - 1 };
    print("{}", add(2i64, 3));
    print(" ");
    print("{}", pair((6i64, 7i64)));
    print(" ");
    print("{}", (h.f)(3i64));
    println("");
    // a closure that captures nothing is a plain `fn`
    print("{}", call(|x| x * 2, 21));
    print(" ");
    let sq = |x: i64| x * x;
    let fp: fn(i64) -> i64 = sq;
    print("{}", fp(9i64));
    println("");
    // nested closures, and a `move` closure leaving the block it is made in
    let outer = |x: i64| {
        let inner = |y: i64| x + y + k;
        inner(100)
    };
    let plus = {
        let j = k - 7;
        move |x: i64| x + j + 90
    };
    print("{}", outer(1));
    print(" ");
    print("{}", plus(10));
    println("");
    // `return` returns from the closure
    let first = |x: i64| -> i64 {
        if x > 5 {
            return 7;
        }
        x
    };
    print("{}", first(9i64));
    println("");
    0
}
