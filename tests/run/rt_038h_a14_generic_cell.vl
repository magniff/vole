// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a14_generic_cell)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke<i64>', which writes through a shared reference (a cell)
// A generic callee that sets a Cell; the holder is not generic.
use std::cell::Cell;

fn poke<T: Copy>(c: &Cell<T>, v: T) -> bool {
    c.set(v);
    true
}

fn f(c: &Cell<i64>) -> i64
    requires poke(c, 9)
{
    1
}

fn main() {
    let c = Cell::new(1i64);
    println("{}", f(&c));
    println("{}", c.get());
}
