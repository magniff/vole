// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::nth.
// EXPECT: Some(2) Some(4) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = v.iter();
    let a = it.nth(1);
    let b = it.nth(1);
    println("{:?} {:?} {:?}", a, b, it.nth(0));
}
