// RULE: C7.1
// (0.27.1) An impl method adds a `requires` to its trait's: the effective
// precondition is the trait's then the impl's, checked per instance at a
// statically dispatched site, here through a bound in a monomorphized
// body, blaming the caller.
// EXPECT: 4
// EXIT: 101
// STDERR: requires failed: 'i < 10' of 'A::m'
trait Tr {
    fn m(&self, i: i64) -> i64
        requires i >= 0;
}

struct A {
    k: i64,
}

impl Tr for A {
    fn m(&self, i: i64) -> i64
        requires i < 10
    {
        self.k + i
    }
}

fn call<T: Tr>(t: &T, i: i64) -> i64 {
    t.m(i)
}

fn main() {
    let a = A { k: 1 };
    println("{}", call(&a, 3));
    println("{}", call(&a, 20));
}
// (passes on std2: was XFAIL, std2 has no contract_check, which a contract's lowering calls (std2))
