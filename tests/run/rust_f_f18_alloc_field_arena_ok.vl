// RULE: F18.7
// RUSTC: none (std's Arena is vole's: Rust's std has no arena)
// (0.27.6) The compiler's own shape (main.vl's `WgslCx { arena: .. }`):
// a struct that holds an allocator by its parameter, made with an arena
// on main's gpa. `Cx { arena: Arena::new_in(gpa) }` is `Cx<Arena<Gpa>>`,
// not `Cx<Gpa>` (0.27.5: "expected 'Gpa', got 'Arena<Gpa>'").
// EXPECT: 4
use std::alloc::{Allocator, Arena, Gpa};

struct Cx<W: Allocator> {
    arena: W,
}

fn fill(cx: &mut Cx<Arena<Gpa>>) -> usize {
    let mut v: Vec<i64, &Arena<Gpa>> = Vec::new_in(&cx.arena);
    for i in 0..4 {
        v.push(i);
    }
    v.len()
}

fn main(gpa: Gpa) {
    let mut cx = Cx { arena: Arena::new_in(gpa) };
    println("{}", fill(&mut cx));
}
