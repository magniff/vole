// RULE: D2.7
// (0.30.1) A closure's capture by value is the binding moved into its env:
// mutable as that binding is. `&mut x` (or of a field of x) in a move
// closure of a `let x` is rustc's E0596 (RT-B301-7); a `let mut` one, a
// write through a captured `&mut`, a shared borrow of the capture are not.
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 24, column 17
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 33, column 17
// ERROR-COUNT: 2
struct K {
    n: i64,
}

impl K {
    fn bump(&mut self) {
        self.n += 1;
    }
}

fn b() {
    let x = 1i64;
    let mut f = move || {
        let r = &mut x;
        *r = 5;
    };
    f();
}

fn b2() {
    let w = K { n: 1 };
    let mut f = move || {
        let r = &mut w.n;
        *r = 5;
    };
    f();
}

fn b3() {
    let mut v = 1i64;
    let r = &mut v;
    let mut f = move || {
        *r = 7;
    };
    f();
    println("{}", v);
}

fn b4() {
    let x = 1i64;
    let f = move || {
        let y = &x;
        *y + 1
    };
    println("{}", f());
}

fn d() {
    let mut x = 1i64;
    let mut f = move || {
        x += 1;
        let r = &mut x;
        *r += 1;
        println("{}", x);
    };
    f();
    println("{}", x);
}

fn h() {
    let mut k = K { n: 1 };
    let mut f = || {
        k.bump();
        k.n += 1;
    };
    f();
    println("{}", k.n);
}

fn main() {
    b();
    b2();
    b3();
    b4();
    d();
    h();
}
