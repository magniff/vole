// (0.30.1, review 3) A trait's 'static is proven of the type an impl
// gives, its projections resolved: `type Out = Self::Raw` with `type Raw
// = &'a str`, `<&'a str as Id>::V`, `<slice::Iter<'a, i64> as
// Iterator>::Item` (rustc E0477), `fn(&'a str) -> i64` (E0477), and a
// struct whose lifetime the impl leaves out (`impl St for F`, F<'a>: an
// elided lifetime is the impl's own, rustc E0726 asks to write it). Before,
// the check read the type as written and said yes of every form it did not
// know: the first three let a borrowed str reach a thread.
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR-COUNT: 5
trait Id {
    type V;
}

impl<'a> Id for &'a str {
    type V = &'a str;
}

trait Tr {
    type Raw;
    type Out: 'static + Send;
    fn out(self) -> Self::Out;
}

struct H<'a> {
    s: &'a str,
}

impl<'a> Tr for H<'a> {
    type Raw = &'a str;
    type Out = Self::Raw;

    fn out(self) -> Self::Out {
        self.s
    }
}

trait Tr2 {
    type Out: 'static + Send;
    fn out(self) -> Self::Out;
}

impl<'a> Tr2 for H<'a> {
    type Out = < &'a str as Id >::V;

    fn out(self) -> Self::Out {
        self.s
    }
}

struct W<I> {
    i: I,
}

impl<'a> Tr2 for W<std::slice::Iter<'a, i64>> {
    type Out = < std::slice::Iter<'a, i64> as Iterator >::Item;

    fn out(mut self) -> Self::Out {
        self.i.next().unwrap()
    }
}

trait St: 'static {
    fn go(&self) -> i64;
}

impl<'a> St for fn(&'a str) -> i64 {
    fn go(&self) -> i64 {
        1
    }
}

impl St for H {
    fn go(&self) -> i64 {
        2
    }
}

fn main() {}
