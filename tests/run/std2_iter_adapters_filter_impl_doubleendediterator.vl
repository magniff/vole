// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Filter::impl DoubleEndedIterator.
// EXPECT: Some(4) Some(2)

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = s.iter().copied().filter(|x| x % 2 == 0);
    let a = it.next_back();
    println("{:?} {:?}", a, it.next_back());
}
