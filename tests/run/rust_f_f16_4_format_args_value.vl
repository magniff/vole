// RULE: F16.4 format_args's value on std: a Display value that writes the
// literal through the Formatter it is given, wherever it goes (a T:
// Display parameter, to_string_in, a write), its holes evaluated once
// where it is made.
// EXPECT: [2 hi]
// EXPECT: [2 hi]
// EXPECT: [2 hi]
// EXPECT: [    2|"hi"|ff]
// EXPECT: [plain]
// EXPECT: <2> 3
// EXPECT: (1)
// EXPECT: n=3 -> 3
use std::fmt::{Display, Formatter, Result};

fn show<T: Display>(x: T) {
    println("[{}]", x);
}

struct Wrap {
    n: i64,
}

impl Display for Wrap {
    fn fmt(&self, f: &mut Formatter<'_>) -> Result {
        let inner = format_args("({})", self.n);
        write(f, "{}", inner)
    }
}

fn count(c: &mut i64) -> i64 {
    *c += 1;
    *c
}

fn main(gpa: Gpa) {
    let n: i64 = 2;
    let s: &str = "hi";
    show(format_args("{} {}", n, s));
    show(format_args("{n} {s}"));
    show(format_args("{} {x}", n, x = s));
    show(format_args("{:>5}|{:?}|{:x}", n, s, 255));
    show(format_args("plain"));
    let v = format_args("<{n}>").to_string_in(gpa);
    println("{} {}", v, v.len());
    println("{}", Wrap { n: 1 });
    let mut c: i64 = 2;
    let once = format_args("n={}", count(&mut c));
    println("{} -> {}", once, c);
}
