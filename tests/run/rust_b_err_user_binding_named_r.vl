// RULE: D7.4
// (0.30.1, RT-33 round 3, F7) A program's own binding named `__r` is no
// writer receiver of std's write! desugaring: `let __r = r;` moves r, and
// r used after is rustc's E0382. Before, the builder knew the desugaring's
// binding by its name, made this one a reborrow, and accepted it.
// ERROR: error[borrowck.use_moved]: '*r' is used here after it moved
// ERROR: line 11, column 5
// ERROR-COUNT: 1
fn f(r: &mut i64) {
    let __r = r;
    *r += 1;
}

fn main() {
    let mut x = 1i64;
    f(&mut x);
}
