// RT-34: a #[multiversion] function's versions (`f$mvK`) are copies the
// compiler makes of its body; they were lowered under MVS's operand
// rules, so the crc version's `for` freed the moved sequence again (a
// use after free, built for a generic Armv8.0 so the version is
// dispatched at run time). Every version is lowered and checked as
// itself, with and without an `ensures`; rustc prints the EXPECT lines.
// FLAGS: -C target-cpu=generic --check-alloc
// EXPECT: 4
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: took 2
// EXPECT: drop 2
// EXPECT: 3
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

#[multiversion("crc")]
fn lens(v: Vec<Vec<i64, Gpa>, Gpa>) -> i64 {
    let mut s = 0;
    for x in v {
        s += x.len() as i64;
    }
    s
}

#[multiversion("crc")]
fn takes(a: [D; 2]) -> i64
    ensures result == 3
{
    let mut s = 0;
    for d in a {
        s += d.v;
        take(d);
    }
    s
}

fn main(gpa: Gpa) {
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(Vec::from_in([1i64, 2, 3], gpa));
    v.push(Vec::from_in([4i64], gpa));
    println("{}", lens(v));
    println("{}", takes([D { v: 1 }, D { v: 2 }]));
}
