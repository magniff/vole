// EDITION: rust
// a closure inside a closure, the inner one capturing the outer's inout capture
// FLAGS: --check-alloc
// EXPECT: 22
fn main() {
    let mut n: i64 = 0;
    let mut outer = || {
        let mut inner = || { n += 10; };
        inner();
        n += 1;
    };
    outer();
    outer();
    println("{n}");
}
