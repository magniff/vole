// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters Skip.
// EXPECT: [3]
use std::iter::Skip;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3], gpa);
    let it: Skip<std::slice::Iter<'_, i64>> = s.iter().skip(2);
    let v: Vec<i64, Gpa> = it.copied().collect_in(gpa);
    println("{:?}", v);
}
