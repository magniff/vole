// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a04_int_addr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A callee writes through a pointer made from an integer address.
fn poke(addr: usize) -> bool {
    let p = addr as *mut i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(addr: usize) -> i64
    requires poke(addr)
{
    1
}

fn main() {
    let mut x = 1i64;
    let a = &raw mut x as usize;
    println("{}", f(a));
    println("{}", x);
}
