// (0.30.2, obligations M1) The trait argument a parameter of the caller,
// `T: Tr<U>` with U = i64: read with the instance's types, Tr<i64>'s impl.
// rustc accepts it.
// EXPECT: 64
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<U, T: Tr<U>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() };
    println("{}", go::<i64, W>(&x));
}
