// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) (see the program)
// EXPECT: 2
struct H<A: Allocator> { b: Buf<A> }
impl H<Gpa> { fn new(gpa: Gpa) -> H<Gpa> { var b = Buf::new_in(gpa); b.push_str("hi"); H { b: b } }
    fn len(self) -> i64 { self.b.len() as i64 } }
fn mk(gpa: Gpa) -> H<Gpa> { H::new(gpa) }

fn main(gpa: Gpa) -> i32 {
    println(H::new(gpa).len());
    0
}
