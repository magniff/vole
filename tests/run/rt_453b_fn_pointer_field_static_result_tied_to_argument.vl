// XFAIL: RT-453b: (RT-453's mechanism, a struct field) a call through a field `f: fn(&u64) -> &'static u64`, `let r = (ff.f)(&*b); drop(b);`, ties the result to the argument: borrowck.move_borrowed at the drop; the result is 'static, rustc prints 5 (0.30.2)
// From the review of g302static (its form f44_fnptr_field_hr). Since
// v0.30.1 at least (the same error), and on the release build with
// g302static merged.
// EXPECT: 5
struct F {
    f: fn(&u64) -> &'static u64,
}

static S: u64 = 5;

fn st(_x: &u64) -> &'static u64 {
    &S
}

fn main(gpa: Gpa) {
    let g: fn(&u64) -> &'static u64 = st;
    let ff = F { f: g };
    let b = Box::new_in(1u64, gpa);
    let r = (ff.f)(&*b);
    drop(b);
    println("{}", r);
}
