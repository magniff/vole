// XFAIL: RT-146b: (RT-146's mechanism, more positions) in a generic body, an F bound by FnOnce or FnMut and called from a field, a tuple element, a rebinding, an Option, a capturing closure, a loop, a `&F` or a Vec index is checked only in its instances: with Copy closures (and `impl Fn` values) as the instances, a second FnOnce call, a move out of `&F` or `v[0]`, and an FnMut call through a binding that is not `mut` all pass; rustc refuses each body (E0382, E0507, E0596) (0.30.2)
// From the third re-review of g302copy. Since v0.30.1 at least.
// From the review's forms gf03b to gf11, gg04 and gg07 (gg08 and gg09 are
// rt_146's own form). A closure that moves a Box out of its capture as the
// instance is refused right (use_moved), so no double drop is reached.
// ERROR: line 25,
// ERROR: line 29,
// ERROR: line 33,
// ERROR: line 37,
// ERROR: line 41,
// ERROR: line 46,
// ERROR: line 53,
// ERROR: line 59,
// ERROR: line 65,
struct S<F> {
    f: F,
}

fn fn0() -> impl Fn() -> i64 {
    || 1
}

fn r1<F: FnMut() -> i64>(f: F) -> i64 {
    let g = f;
    g()
}

fn r2<F: FnOnce() -> i64>(s: S<F>) -> i64 {
    (s.f)() + (s.f)()
}

fn r3<F: FnOnce() -> i64>(t: (F, i64)) -> i64 {
    (t.0)() + (t.0)() + t.1
}

fn r4<F: FnMut() -> i64>(s: S<F>) -> i64 {
    (s.f)()
}

fn r5<F: FnOnce() -> i64>(f: &F) -> i64 {
    f()
}

fn r6<F: FnOnce() -> i64>(o: Option<F>) -> i64 {
    match o {
        Some(g) => g() + g(),
        None => 0,
    }
}

fn r7<F: FnOnce() -> i64>(f: F) -> i64 {
    let c = move || f() + 1;
    c() + c()
}

fn r8<F: FnOnce() -> i64>(f: F) -> i64 {
    let mut s = 0i64;
    for _ in 0..2 {
        s += f();
    }
    s
}

fn r9<F: FnOnce() -> i64>(v: Vec<F, Gpa>) -> i64 {
    (v[0])()
}

fn main(gpa: Gpa) {
    let c = || 1i64;
    let mut v: Vec<_, Gpa> = Vec::new_in(gpa);
    v.push(c);
    let a = r1(c) + r2(S { f: c }) + r3((c, 0)) + r4(S { f: c }) + r5(&c);
    let b = r6(Some(c)) + r7(c) + r8(c) + r9(v);
    println("{} {} {} {}", a, b, r2(S { f: fn0() }), r1(fn0()));
}
