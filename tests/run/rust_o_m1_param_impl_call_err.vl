// ERROR: 'v' does not live long enough
// The same with the impl the parameter picks needing 'static: the short borrow is refused, as rustc refuses it (E0597; the review's f34).
struct P;
trait Tr<U> { fn f(&self) -> i64; }
trait Q { fn q(&self) -> i64; }
struct W<'a> { r: &'a i64 }
struct Wrap<T, U> { t: T, u: U }
impl<'a> Tr<P> for W<'a> { fn f(&self) -> i64 { 1 } }
impl<'a: 'static> Tr<i64> for W<'a> { fn f(&self) -> i64 { 64 } }
fn call<P1, Z: Tr<P1>>(z: &Z, _p: &P1) -> i64 { z.f() }
impl<P, T: Tr<P>> Q for Wrap<T, P> { fn q(&self) -> i64 { call(&self.t, &self.u) } }
fn go<X: Q>(x: &X) -> i64 { x.q() }
fn main() { let v: i64 = 5; let x = Wrap { t: W { r: &v }, u: 0i64 }; println("{}", go(&x)); }
