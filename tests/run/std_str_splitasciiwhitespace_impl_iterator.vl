// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::str SplitAsciiWhitespace::impl Iterator.
// EXPECT: 2 "a" 5
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = " a\t b\u{3000}c\n".split_ascii_whitespace().collect_in(gpa);
    println("{} {:?} {}", v.len(), v[0], v[1].len());
}
