// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) (see the program)
// (0.28.0) The rust edition drops the temporary at the end of its
// statement, as rustc does (E0716 at the same lines): its view is an error.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 24, column 13
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 27, column 13
struct H { n: i64, t: [u8; 4] }
impl Drop for H { fn drop(&mut self) { println("drop {}", self.n); } }

impl H {
    fn new(n: i64) -> H { H { n: n, t: [b'a', b'b', b'c', b'd'] } }
    fn len(&self) -> i64 { self.n }
    fn view(&self) -> &[u8] { &self.t[..] }
}

fn mk(n: i64) -> H { H::new(n) }

fn main() -> i32 {
    println("{}", H::new(1).len());
    println("a");
    println("{}", mk(2).len());
    println("b");
    let v = H::new(3).view();
    println("{}", str::from_utf8(v).unwrap());
    println("c");
    let w = mk(4).view();
    println("{}", str::from_utf8(w).unwrap());
    println("d");
    0
}
