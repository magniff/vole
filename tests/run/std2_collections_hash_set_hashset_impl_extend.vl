// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_set HashSet::impl Extend.
// EXPECT: 3
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.extend([1i64, 2, 3, 2]);
    println("{}", s.len());
}
