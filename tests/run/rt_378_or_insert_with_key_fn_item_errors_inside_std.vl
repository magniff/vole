// XFAIL: RT-378: `m.entry(5).or_insert_with_key(kk)` with a fn item `fn kk<'a>(k: &'a i64) -> &'a i64` (V = &i64, the value would borrow the map's key) is refused inside std: `<std>:L:C: error[borrowck.return_local] a reference to 'e', a local of this function, escapes it` and `cannot move out of 'e'`; so is `std::alloc::arena_scope(&gpa, mk)` with mk returning a Vec on the scope (`a reference to 's' ... escapes it`, in Arena::scope) (0.30.2)
// rustc: E0308 at the call (line 30: one type is more general
// than the other; twin .rs.txt). vole reports two errors at lines of std's
// Entry::or_insert_with_key, about its local 'e', and none in the program;
// v0.29.0 to v0.30.1 the same (v0.28.0 has no FixedState). The closure form `|k| k` is refused right
// (borrowck.outlives at the closure), and a fn item that keeps no borrow
// (`fn kv(k: &i64) -> i64`) builds. RT-298 is std's iterator adapters
// failing inside std on fn items. The arena form is the same: rustc
// refuses `arena_scope(&gpa, mk)` at the call (the result names the
// scope's late-bound lifetime); vole's one error is at a line of std,
// about Arena::scope's local 's'.
// ERROR: line 30
// ERROR: line 31
// ERROR-COUNT: 2
use std::alloc::ArenaScope;
use std::collections::HashMap;

fn kk<'a>(k: &'a i64) -> &'a i64 {
    k
}

fn mk<'a, 'b, 'g>(s: &'a ArenaScope<'b, &'g Gpa>) -> Vec<i64, &'a ArenaScope<'b, &'g Gpa>> {
    let mut v = Vec::new_in(s);
    v.push(7i64);
    v
}

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, &i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let r: &i64 = *m.entry(5).or_insert_with_key(kk);
    let w = std::alloc::arena_scope(&gpa, mk);
    println("{} {}", r, w[0]);
}
