// XFAIL: gap 14: output: line 2: expected 'it 2', got 'drop 1' [rustc: outside the twin: rustc rejects: error[E0599]: no met...
// sem-own: for over v.take() (an owned Vec temporary): its items dropped once.
// EXPECT: it 1
// EXPECT: it 2
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: end 0
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    v.push(mk(2, gpa));
    for x in v.take() { println("it {}", x.id); }
    println("end {}", v.len());
}
