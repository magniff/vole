// EDITION: rust
// requires is checked after the arguments are evaluated, in order.
// EXPECT: arg 1
// EXPECT: arg 2
// EXPECT: 3
// EXPECT: arg 5
// EXPECT: arg 3
// EXIT: 101
// STDERR: requires failed: 'a < b' of 'f'
static mut Z: i64 = 0;
fn arg(x: i64) -> i64 { println("arg {x}"); x }

fn f(a: i64, b: i64) -> i64
    requires a < b
{
    a + b
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    println("{}", f(arg(1 + unsafe { Z }), arg(2)));
    println("{}", f(arg(5 + unsafe { Z }), arg(3)));
    0
}
