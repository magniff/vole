// EDITION: rust
// XFAIL: gap 17: compile unsafe: slicing a raw pointer is unsafe
// (0.21) std::thread: eight threads at once, each counting into one
// atomic and returning a value its handle's join gives back; a thread that
// moved a Vec in; a handle dropped without join (detached); scope joining
// threads that read the caller's slice.
// EXPECT: 499500
// EXPECT: 800000 28
// EXPECT: scoped 499500 true
// EXPECT: cpus true

use std::thread::JoinHandle; use std::thread;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

static COUNT: AtomicI64 = AtomicI64::new(0i64);

fn part(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for &x in s { t += x; }
    t
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..1000 { v.push(i); }
    let w = v.clone();
    let h = thread::spawn_in(move || part(w.as_slice()), gpa);
    println("{}", h.join().unwrap());

    let mut hs: Vec<JoinHandle<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    for k in 0..8 {
        hs.push(thread::spawn_in(move || {
            for _ in 0..100000 { COUNT.fetch_add(1, Ordering::Relaxed); }
            k
        }, gpa));
    }
    let mut ks: i64 = 0;
    while hs.len() > 0 { ks += hs.pop().unwrap().join().unwrap(); }
    println("{} {ks}", COUNT.load(Ordering::SeqCst));

    let detached = thread::spawn_in(move || 1, gpa);
    drop(detached);

    let s = v.as_slice();
    let n = s.len() / 2;
    let total = thread::scope(|s| ({ let sc = s; {
        let a = sc.spawn(|| part(&s[0..n]));
        let b = sc.spawn(|| part(&s[n..]));
        let c = sc.spawn(|| 0);
        drop(c);
        a.join().unwrap() + b.join().unwrap()
    } }));
    println("scoped {total} {}", v.len() == 1000);
    println("cpus {}", thread::available_parallelism() as i64 >= 1);
}
