// XFAIL: gap 17: compile edition.lenient: '&mut p' is a reference where its value goes
// Indexing through pointers: p[i] reads and writes the i-th element, and
// &p[i] is its address.
// EXPECT: 465 25 400
// EXPECT: 69 l e
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn free(p: *mut u8);
}

#[derive(Clone, Copy)] struct Pt { x: i32, y: i32 }

fn sum(p: *mut i64, n: i64) -> i64 {
    let mut s: i64 = 0;
    for i in 0..n { unsafe { s += (*p.add(i as usize)); } }
    s
}

fn main() -> i64 {
    let mut arr = [10i64, 20, 30, 40];
    let p = &mut arr[0] as *mut i64;
    unsafe { (*p.add(3)) = 400; }
    let q = unsafe { p.add(1) };
    unsafe {
        (*q.add(0)) += 5;
        printf(c"%ld %ld %ld\n", sum(&mut p, 4), arr[1], arr[3]);
    }

    let pts = unsafe { malloc(4 * 8) as *mut Pt };
    for i in 0..4 {
        unsafe { (*pts.add(i as usize)) = Pt { x: i as i32, y: (i * i) as i32 }; }
    }
    unsafe { (*pts.add(2)).y = -1; }
    let mut acc: i32 = 0;
    for i in 0..4 { unsafe { acc += (*pts.add(i as usize)).x * 10 + (*pts.add(i as usize)).y; } }
    let bytes = c"vole";
    let idx: u8 = 2;
    unsafe {
        printf(c"%d %c %c\n", acc, (*bytes.add(idx as usize)) as i32, (*bytes.add(3u8)) as i32);
        free(pts as *mut u8);
    }
    0
}
