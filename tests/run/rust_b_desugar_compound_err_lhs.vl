// RULE: D7.4
// (0.30.1) An overloaded compound assignment is `AddAssign::add_assign(&mut s,
// rhs)`: the left place is borrowed first, so the right side's
// `s.clear()` is E0499 (vole's mut_twice), as rustc.
// ERROR: error[borrowck.mut_twice]
// ERROR: line 11, column 9
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut s = format_in("abc{}", 1, gpa);
    s += {
        s.clear();
        "x"
    };
    println("{s}");
}
