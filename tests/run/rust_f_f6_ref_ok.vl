// EDITION: rust
// RULE: F6.1
// An impl for a reference type, `impl<'a> Tag for &'a S`: a `&S` has
// `tag` by value, before `S`'s own methods are looked at.
// EXPECT: 3
// EXPECT: 1
trait Tag {
    fn tag(&self) -> i64;
}

struct S {
    n: i64,
}

impl S {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a S {
    fn tag(&self) -> i64 {
        3
    }
}

fn main() -> i64 {
    let s = S { n: 0 };
    let r = &s;
    std::print_int(r.tag());
    println("");
    std::print_int(s.tag());
    println("");
    0
}
