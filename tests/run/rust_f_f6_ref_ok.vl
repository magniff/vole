// RULE: F6.1
// RULE: F6.2
// An impl for a reference type, `impl<'a> Tag for &'a S`. The probe takes
// the methods whose receiver type is the step's: for `r: &S` the first
// step, `&S` by value, has `S::tag(&self)` (receiver `&S`), and the impl's
// `tag(&self)` (receiver `&&S`) only comes at the `&` step, so `r.tag()`
// is 1, as rustc's; for `rr: &&S` the impl's comes first (3).
// EXPECT: 1
// EXPECT: 1
// EXPECT: 3
trait Tag {
    fn tag(&self) -> i64;
}

struct S {
    n: i64,
}

impl S {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a S {
    fn tag(&self) -> i64 {
        3
    }
}

fn main() {
    let s = S { n: 0 };
    let r = &s;
    println("{}", r.tag());
    println("{}", s.tag());
    let rr = &r;
    println("{}", rr.tag());
}
