// RULE: D2.7, AT6
// (0.30.1, RT-33) Scoped threads each given the same shared view, each
// swapping through it: a `&mut self` method of a slice on a `&[T]`,
// rustc's E0596. Before, the four threads raced on the two Boxes (a
// double free or a leak).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 13, column 9
// ERROR-COUNT: 1
use std::thread;

fn spin(s: &[Box<i64, Gpa>]) {
    for _ in 0..2000000 {
        s.swap(0, 1);
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<Box<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(Box::new_in(1, gpa));
    v.push(Box::new_in(2, gpa));
    let s: &[Box<i64, Gpa>] = v.as_slice();
    thread::scope(|sc| {
        sc.spawn(|| spin(s));
        sc.spawn(|| spin(s));
    });
    println("{} {}", *v[0], *v[1]);
}
