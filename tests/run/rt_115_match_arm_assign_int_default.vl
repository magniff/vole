// XFAIL: RT-115: a match arm whose block assigns a u8 local then yields a literal makes the match i32: "expected 'u8', got 'i32'" (0.30.2)
// From c302const (pre-existing, r5_v12): the i32 literal default decided
// before the other arm's u8. rustc prints the EXPECT line.
// EXPECT: 6
fn f(x: u8) -> u8 {
    let mut k: u8 = 1;
    let r = match x {
        0 => {
            k = 5;
            1
        }
        _ => k + 4,
    };
    r + k
}

fn main() {
    println("{}", f(1));
}
