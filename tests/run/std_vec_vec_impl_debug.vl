// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::vec Vec::impl Debug.
// EXPECT: [1, 2] [] ["a"]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let s = Vec::from_in(["a"], gpa);
    println("{:?} {:?} {:?}", v, e, s);
}
