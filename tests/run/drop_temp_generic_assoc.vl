// (0.29) The temporary of a call whose result type is an associated type
// (`make_of<M: Make>(m: &M) -> M::Out`), lent or read, is dropped at the
// end of its statement; the method called on the value too.
// EXPECT: a 4
// EXPECT: d2
// EXPECT: b 4
// EXPECT: d3
// EXPECT: c 4
// EXPECT: d4
// EXPECT: d 4
// EXPECT: d5
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

trait Make {
    type Out;
    fn make(&self) -> Self::Out;
}

impl Make for T {
    type Out = T;

    fn make(&self) -> T {
        self.clone()
    }
}

fn make_of<M: Make>(m: &M) -> M::Out {
    m.make()
}

fn run() {
    let t = mk(4);
    println("a {}", obs(&make_of(&t)));
    println("b {}", make_of(&t).v);
    println("c {}", obs(&t.make()));
    println("d {}", t.make().v);
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
