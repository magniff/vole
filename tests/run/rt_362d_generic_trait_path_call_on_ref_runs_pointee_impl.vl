// From the re-review 2 of g302index (its form i08l_ufcs_generic_trait_ref, its G half). Since v0.30.1 at least
// (v0.30.1 and the release build print `1 1 11`).
// RT-362 is the index operator on a T parameter; rt_362b..e path calls.
// EXPECT: 2 1 22
trait G<X> {
    fn g(&self, x: X) -> i64;
}

struct W {
    k: i64,
}

impl G<i64> for W {
    fn g(&self, x: i64) -> i64 {
        1
    }
}

impl<'a> G<i64> for &'a W {
    fn g(&self, x: i64) -> i64 {
        2
    }
}

fn gg<T: G<i64>>(x: T) -> i64 {
    T::g(&x, 0) * 10 + G::g(&x, 0)
}

fn main() {
    let w = W { k: 5 };
    let r = &w;
    println("{} {} {}", G::g(&r, 0), r.g(0), gg(&w));
}
