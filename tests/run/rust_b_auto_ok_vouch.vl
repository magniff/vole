// RULE: AT2
// (0.27.2) `unsafe impl Send for X {}` vouches for a type whose parts are
// not Send; a generic vouch applies where its bounds hold.
// EXPECT: 7 8
struct Handle {
    p: *const i64,
}

// SAFETY: the pointer is never written through, and its target outlives
// every use.
unsafe impl Send for Handle {}

struct Tagged<T> {
    t: T,
    raw: *const u8,
}

// SAFETY: `raw` is a tag, never dereferenced.
unsafe impl<T: Send> Send for Tagged<T> {}

fn send<T: Send>(t: T) -> T {
    t
}

fn main() {
    let v: i64 = 7;
    let h = send(Handle { p: &v as *const i64 });
    let t = send(Tagged { t: 8, raw: 0 as *const u8 });
    let _ = t.raw;
    println("{} {}", unsafe { *h.p }, t.t);
}
