// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl BorrowMut<str>.
// EXPECT: ABC
use std::borrow::BorrowMut;

fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    let t: &mut str = s.borrow_mut();
    t.make_ascii_uppercase();
    println("{}", s);
}
