// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc ArenaScope::alloc_slice_copy.
// EXPECT: 6
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let r = arena.scope(|sc| {
        let s = sc.alloc_slice_copy(&[1i64, 2, 3]);
        s[0] + s[1] + s[2]
    });
    println("{}", r);
}
