// RULE: D2.7
// (0.30.1, RT-33) A shared view held in a field, `w.s.swap(0, 1)` and
// `&mut w.s[..]`, with w itself `&mut W` or owned: the referent is behind
// the view's `&`, rustc's E0596 at each.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*w.s' as mutable, which is behind a `&` reference
// ERROR: line 15, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*w.s' as mutable, which is behind a `&` reference
// ERROR: line 19, column 18
// ERROR-COUNT: 2
struct W<'a> {
    s: &'a [i64],
}

fn k(w: &mut W) {
    w.s.swap(0, 1);
}

fn k2(w: W) {
    let m = &mut w.s[..];
    m[0] = 1;
}

fn main() {
    let a = [2i64, 1];
    let mut w = W { s: &a[..] };
    k(&mut w);
    k2(w);
}
