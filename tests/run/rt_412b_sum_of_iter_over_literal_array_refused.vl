// XFAIL: RT-412: `a.iter().sum()` over an array of literals into i64 is refused (Sum<&i32>); rustc prints 4000000000 (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 4000000000
fn main() {
    let a = [2000000000, 2000000000];
    let s: i64 = a.iter().sum();
    println("{}", s);
}
