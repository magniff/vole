// RULE: D3.6
// (0.28.0) A `&mut T` place given to a C variadic's `...` is moved, as
// rustc's: there is no parameter type to coerce it to, so no reborrow.
// 0.27.8 copied it, which `--verify-places` refused (I7). sscanf writes
// 42 through it; the other `&mut` is still usable after a reborrow given
// explicitly, `&mut *q`.
// FLAGS: --verify-places
// EXPECT: 42 8
extern "C" {
    fn sscanf(s: *const u8, format: *const u8, ...) -> i32;
}

fn read_into(r: &mut i64) -> i32 {
    // UNSAFE: C's sscanf
    // SAFETY: both strings end in a NUL; `%lld` writes one i64 through r, live
    unsafe { sscanf(b"42\0".as_ptr(), b"%lld\0".as_ptr(), r) }
}

fn read_twice(q: &mut i64) {
    // UNSAFE: C's sscanf
    // SAFETY: as read_into's; q is reborrowed for the call, then used
    unsafe {
        sscanf(b"7\0".as_ptr(), b"%lld\0".as_ptr(), &mut *q);
    }
    *q += 1;
}

fn main() {
    let mut x: i64 = 1;
    read_into(&mut x);
    let mut y: i64 = 0;
    read_twice(&mut y);
    println("{} {}", x, y);
}
