// RULE: F35.2 (0.30.2, RT-148) `[C; N]` of a constant that is not Copy is
// made in a temporary, moved into the destination whole once each element
// is made, so the destination never holds the first value's bit copies
// counted as values (10d65043a wrote `_1 = [move _2; 3]` into `a` itself:
// a `return` in C's value, refused now (F34.4), then dropped the copies
// again). An exit through the loop's guard drops the elements made; under
// F34.4 none reaches it, so the construction is what is checked here.
// EXPECT: 4 4
// EXPECT: drop 4
// EXPECT: drop 4
// EXPECT: drop 4
// PLACES: fn main
// PLACES: _3 = [move _2; 3]
// PLACES-NOT: _1[_
// PLACES: _3[_4] = move _6
// PLACES-NOT: _1[_
// PLACES: _1 = move _3
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

const C: D = D { k: 4 };

fn main() {
    let a = [C; 3];
    println("{} {}", a[0].k, a[2].k);
}
