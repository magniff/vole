// a default method with a &self calling a &mut self method (rustc E0596)
// ERROR: error[borrowck.borrow_immutable]
trait C {
    fn bump(&mut self);
    fn twice(&self) { self.bump(); self.bump(); }
}

#[derive(Clone, Copy)] struct P { x: i64 }
impl C for P { fn bump(&mut self) { self.x += 1; } }

fn main() {
    let mut p = P { x: 1 };
    p.twice();
    println("{}", p.x);
}
