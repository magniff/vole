// RULE: D19.1, D19.10
// (0.30.2, RT-44) The same closure in the Drop impl of a generic
// struct's field: the field's drop instance is made when the holder is
// dropped (0.30.1: the compiler panicked).
// EXPECT: ok 2
// EXPECT: dropD 9
struct D<T> {
    t: T,
}

impl<T> Drop for D<T> {
    fn drop(&mut self) {
        let v = [1i64, 2, 3];
        let s: i64 = v.iter().map(|x: &i64| *x + 1).sum();
        println("dropD {}", s);
    }
}

struct W<T> {
    d: D<T>,
    n: i64,
}

fn main() {
    let w = W { d: D { t: 1u8 }, n: 2 };
    let _ = &w.d.t;
    println("ok {}", w.n);
}
