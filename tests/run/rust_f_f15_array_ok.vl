// RULE: F15.3
// `#[array_builtin(N)]` makes an impl, a function or a method a template
// over an array's length N: an instance for each length the program uses,
// with N a `usize` constant inside it; the trait's arguments may name it.
// EXPECT: 106 5 102 1
trait Total {
    fn total(&self) -> i64;
}

#[array_builtin(N)]
impl Total for [i64; N] {
    fn total(&self) -> i64 {
        let mut s = 0;
        let mut i: usize = 0;
        while i < N {
            s += (*self)[i];
            i += 1;
        }
        s
    }
}

#[array_builtin(N)]
fn count<T>(xs: [T; N]) -> usize {
    N
}

struct W {
    x: i64,
}

impl W {
    #[array_builtin(N)]
    fn sum(&self, xs: [i64; N]) -> i64 {
        self.x + xs.total()
    }
}

trait SameLen<Rhs> {
    fn same_len(&self, other: &Rhs) -> bool;
}

#[array_builtin(N)]
impl SameLen<[i64; N]> for W {
    fn same_len(&self, other: &[i64; N]) -> bool {
        N == self.x as usize
    }
}

fn main() {
    let a = [1i64, 2, 3];
    let b = [10i64, 20, 30, 40];
    let w = W { x: 100 };
    print("{}", a.total() + b.total());
    print(" ");
    print("{}", count([1, 2, 3, 4, 5]) as i64);
    print(" ");
    print("{}", w.sum([1, 1]));
    print(" ");
    let two = W { x: 2 };
    println("{}", if two.same_len(&[7i64, 8]) && !two.same_len(&[7i64, 8, 9]) { 1 } else { 0 });
}
