// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters SkipWhile::impl Iterator.
// EXPECT: Some(3) Some(1)

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 3, 1], gpa);
    let mut it = s.iter().copied().skip_while(|x| *x < 2);
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
