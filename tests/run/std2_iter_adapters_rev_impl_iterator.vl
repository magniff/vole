// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Rev::impl Iterator.
// EXPECT: Some(2) (1, Some(1))

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().rev();
    let a = it.next().copied();
    println("{:?} {:?}", a, it.size_hint());
}
