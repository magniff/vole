// From the review of g302probe part 1. v0.30.1: ERR: f71/d03_generic_ref_add.vl:6:87: error[generic.unbounded_use] binary operation '+' cannot be ap
// EXPECT: 103 3
use std::ops::Add;
#[derive(Clone, Copy)]
struct S { k: i64 }

impl<'a> Add<&'a S> for &'a S {
    type Output = S; fn add(self, o: &S) -> S { S { k: self.k + o.k + 100 } }
}

impl Add for S { type Output = S; fn add(self, o: S) -> S { S { k: self.k + o.k } } }
fn sum_refs<'a, T: 'a>(a: &'a T, b: &'a T) -> T where & 'a T: Add<&'a T, Output = T> { a + b }
fn sum_vals<T: Add<Output = T>>(a: T, b: T) -> T { a + b }

fn main() {
    let a = S { k: 1 }; let b = S { k: 2 }; println("{} {}", sum_refs(&a, &b).k, sum_vals(a, b).k);
}
