// RT-321's fix keeps what rustc builds: a read through `*&y` (of a
// `y: &mut S`, of a value, of a field), `*&mut y` used as the `&mut`, and
// a shared `&&mut S` where `&S` goes.
// EXPECT: 1 2 2 2 3
struct S {
    k: i64,
}

fn k(x: &mut S) -> i64 {
    x.k += 1;
    x.k
}

fn read(x: &S) -> i64 {
    x.k
}

fn go(mut y: &mut S) -> i64 {
    let r = read(*&y);
    let m = k(*&mut y);
    let f = (*&y).k;
    let v = *&f;
    let t = read(&y);
    println("{} {} {} {} {}", r, m, f, v, t + 1);
    0
}

fn main() {
    let mut s = S { k: 1 };
    go(&mut s);
}
