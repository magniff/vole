// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FixedState::impl Default.
// EXPECT: true
// RUSTC: none (FixedState is foldhash's (the foldhash crate's FixedState, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{BuildHasher, FixedState, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let s = FixedState::default();
    println("{}", s.hash_one(7u64) == FixedState::new().hash_one(7u64));
}
