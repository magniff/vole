// EDITION: rust
// RULE: D3.6
// (0.27.6) The outer call's `&mut` reborrow lives through its arguments:
// an inner call that takes the same `cx` as a `*mut` is a second mutable
// borrow (rustc E0499; 0.27.5 accepted it, gate 3's nested `is_const(cx,
// ir_val(cx, ..))` calls).
// ERROR: error[borrowck.mut_twice]: cannot borrow '*cx' as mutable more than once at a time
// ERROR: line 25, column 15
struct C {
    x: i64,
}

fn outer(cx: &mut C, v: i64) -> i64 {
    cx.x + v
}

fn inner(cx: *mut C, v: i64) -> i64 {
    // UNSAFE: the test's raw pointer, as middle/ir's ir_val takes it
    // SAFETY: cx points to the live C main made; nothing else uses it here
    unsafe { (*cx).x + v }
}

fn go(cx: &mut C, v: i64) -> i64 {
    outer(cx,
        inner(cx, v))
}

fn main() {
    let mut c = C { x: 1 };
    println("{}", go(&mut c, 3));
}
