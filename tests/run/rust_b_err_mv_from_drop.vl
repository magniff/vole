// EDITION: rust
// RULE: D8.3
// (0.27.1) M4: a field moved out of a value whose type has `impl Drop`.
// ERROR: error[borrowck.move_from_drop]
// ERROR: line 25, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct N {
    v: i64,
}

struct DW {
    n: N,
}

impl Drop for DW {
    fn drop(&mut self) {
        println("drop {}", self.n.v);
    }
}

fn main() {
    let w = DW { n: N { v: 1 } };
    let t = w.n;
    println("{}", t.v);
}
