// (0.28.0, gap 79) unwrap on an Err says where (the caller's place), what
// (rustc's text) and the error's value; a call that is not a statement's
// start has its own column.
// EXPECT: 12
// EXIT: 101
// STDERR: std2_unwrap_value.vl:13:23: called `Result::unwrap()` on an `Err` value: ParseIntError { kind: InvalidDigit }
use std::num::ParseIntError;

fn main() {
    let a: Result<i32, ParseIntError> = "12".parse::<i32>();
    println("{}", a.unwrap());
    let text = "12x";
    println("{}", 1 + text.parse::<i32>().unwrap());
}
