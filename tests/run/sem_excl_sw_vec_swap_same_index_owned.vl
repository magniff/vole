// EDITION: rust
// swap(i, i) on owned elements: no double drop
// EXPECT: 1 2
fn main(gpa: Gpa) {
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa); let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(0);
    v.push(a); let mut b: Vec<i64, Gpa> = Vec::new_in(gpa); b.push(0); b.push(0); v.push(b);
    v.swap(1usize, 1usize);
    v.swap(0usize, 1usize); v.swap(0usize, 1usize); println("{} {}", v[0].len(), v[1].len());
}
