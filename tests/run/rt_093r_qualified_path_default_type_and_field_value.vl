// A qualified path as a type parameter's default, `struct W<T = <<S as A>::Out as B>::E>`, and as a field's value (rustc `3 2`)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): a guard: the first round's build passes.
// EXPECT: 3 2
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

struct H {
    e: i64,
}

struct W<T = <<S as A>::Out as B>::E> {
    t: T,
}

fn main() {
    let h = H { e: <S as A>::C };
    let w: W = W { t: <<S as A>::Out as B>::D };
    println("{} {}", h.e, w.t);
}
