// ERROR: the trait 'Eqv<W>' is not implemented for 'W'
// (RT-270) `Z: Eqv` of `trait Eqv<R = Self>` is Eqv<Z> (rustc E0277; v0.30.1 accepted it).
trait Eqv<R = Self> {
    fn e(&self, r: &R) -> bool;
}

struct W {
    r: i64,
}

impl Eqv<i64> for W {
    fn e(&self, r: &i64) -> bool {
        self.r == *r
    }
}

fn c<Z: Eqv>(z: &Z) -> i64 {
    1
}

fn main() {
    println("{}", c(&W { r: 0 }));
}
