// EDITION: rust
// RULE: F19.3
// A call through an `unsafe fn` pointer outside an `unsafe` block is an
// error (rustc E0133), and an `unsafe fn` value does not coerce to the
// safe fn type (rustc E0308).
// ERROR: error[unsafe]: calling an `unsafe fn` pointer is unsafe
// ERROR: expected 'fn(i64) -> i64', got 'unsafe fn(i64) -> i64'
unsafe fn twice(x: i64) -> i64 {
    x * 2
}

fn apply(f: unsafe fn(i64) -> i64, x: i64) -> i64 {
    f(x)
}

fn main() -> i64 {
    let s: fn(i64) -> i64 = twice;
    apply(twice, 1) + s(1)
}
