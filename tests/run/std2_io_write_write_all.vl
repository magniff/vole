// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::io Write::write_all.
// EXPECT: ab
// EXPECT: WriteZero
use std::io::{ErrorKind, Write, self};

struct Full;

impl Write for Full {
    fn write(&mut self, _buf: &[u8]) -> io::Result<usize> {
        Ok(0)
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

fn main() {
    let mut o = io::stdout();
    o.write_all("ab\n".as_bytes()).unwrap();
    let e = Full.write_all("x".as_bytes()).unwrap_err();
    println("{:?}", e.kind());
}
