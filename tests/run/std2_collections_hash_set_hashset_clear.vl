// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet::clear.
// EXPECT: 0 false
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    s.clear();
    println("{} {}", s.len(), s.contains(&1));
}
