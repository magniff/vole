// XFAIL: RT-362b: WRONG CODE: (RT-362's family, a call by trait path) `Index::index(&r, 0)` with `r: &W`, where W and &W each have their own `Index<usize>` impl, runs W's impl: vole prints `1 1`, rustc `2 1` (`Index::index(r, 0)` is W's, right) (0.30.2)
// From the re-review 2 of g302index (its form i08j_concrete_ufcs_refW). Since v0.30.1 at least
// (v0.30.1 and the release build print `1 1`).
// RT-362 is the index operator on a T parameter; rt_362b..e path calls.
// EXPECT: 2 1
use std::ops::{Index, IndexMut};

struct W {
    k: i64,
}

static ONE: i64 = 1;
static TWO: i64 = 2;

impl Index<usize> for W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &ONE
    }
}

impl<'a> Index<usize> for &'a W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &TWO
    }
}

fn main() {
    let w = W { k: 5 };
    let r = &w;
    println("{} {}", *Index::index(&r, 0), *Index::index(r, 0));
}
