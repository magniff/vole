// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::str::Utf8Decoder'
// std's UTF-8 core (0.20, compiler/std/str/utf8.vl): validation with
// Rust's Utf8Error (the vectors of Rust's from_utf8 tests), decoding both
// ways, encoding every scalar value, lossy decoding by maximal subparts
// (Unicode's own example, Table 3-8), counting, the ASCII prefixes at
// every alignment, char boundaries.
use std::str::Utf8Decoder; use std::str::Utf8Error; use std::str::ascii_prefix_len;
use std::str::ascii_printable_prefix_len; use std::str::ceil_char_boundary;
use std::str::code_points; use std::str::count_chars; use std::str::decode_at;
use std::str::decode_into; use std::str::encode_utf8; use std::str::floor_char_boundary;
use std::str::is_char_boundary; use std::str::is_utf8; use std::str::lossy_next;
use std::str::next_code_point; use std::str::next_code_point_reverse; use std::str::utf8_len;
use std::str::from_utf8 as validate_utf8;

fn show(v: &[u8]) {
    match str::from_utf8(v).map(|_| ()) {
        Ok(()) => println("ok"),
        Err(e) => println("{e} | {e:?}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    show(b"");
    show("hello, κόσμε, 世界, 🌍".as_bytes());
    show(b"\xc3"); // incomplete at the end
    show(b"ab\xe2\x82"); // incomplete
    show(b"ab\xe2\x82x"); // invalid: 2 bytes
    show(b"\x80"); // a lone continuation
    show(b"\xc0\xaf"); // overlong
    show(b"\xe0\x80\xaf"); // overlong, 3 bytes
    show(b"\xed\xa0\x80"); // a surrogate
    show(b"\xf4\x90\x80\x80"); // above 0x10FFFF
    show(b"\xf5\x80\x80\x80"); // never a lead byte
    show(b"\xf0\x9f\x98\x80\xf0\x9f\x98"); // a whole emoji, then 3 of 4 bytes
    show(b"\xf0\x9f\x98x"); // 3 bytes, then not a continuation

    // Every scalar value: encode, then decode it back three ways.
    let mut buf = [0u8; 4];
    let mut bad: i64 = 0;
    let mut total: i64 = 0;
    let mut cp: u32 = 0;
    while cp <= 0x10ffff {
        if cp == 0xd800 {
            cp = 0xe000;
        }
        let n = encode_utf8(cp, &mut buf);
        let s = &buf[0..n as usize];
        let mut p: i64 = 0;
        let mut q = n;
        if n != utf8_len(cp) || !is_utf8(s) || next_code_point(s, &mut p) != Some(cp) || p != n
            || next_code_point_reverse(s, &mut q) != Some(cp) || q != 0
            || decode_at(s, 0) != (cp as u64 | ((n as u64) << 32)) {
            bad += 1;
        }
        total += n;
        cp += 1;
    }
    println("scalars: {total} bytes, {bad} bad");
    let n = encode_utf8(0xd800u32, &mut buf);
    println("surrogate encodes as {n} bytes: {:x} {:x} {:x}", buf[0], buf[1], buf[2]);

    // Unicode 16, Table 3-8: U+FFFD for each maximal subpart.
    let t = "\x61\xf1\x80\x80\xe1\x80\xc2\x62\x80\x63\x80\xbf\x64";
    let mut p: i64 = 0;
    while p < t.len() as i64 {
        print(" {:x}", lossy_next(t, &mut p));
    }
    println("");
    let mut out = [0u32; 32];
    let (c, m) = decode_into(t, &mut out[..]);
    print("decode_into: {c} {m}:");
    for k in 0..m {
        print(" {:x}", out[k as usize]);
    }
    println("");
    // (an incomplete sequence at the end is left for the next buffer)
    let (c, m) = decode_into("ab\xe2\x82", &mut out[..]);
    println("cut: {c} {m}");
    // ... which a decoder keeps across buffers
    let mut d = Utf8Decoder::new();
    let (c1, m1) = d.feed("ab\xe2", &mut out[..]);
    let (c2, m2) = d.feed("\x82\xac!\xf0\x9f", &mut out[m1 as usize..]);
    let m3 = d.finish(&mut out[(m1 + m2) as usize..]);
    print("stream: {c1} {m1} {c2} {m2} {m3}:");
    for k in 0..m1 + m2 + m3 {
        print(" {:x}", out[k as usize]);
    }
    println("");

    // Counting, iterating both ways.
    let s = "añ€😀b";
    println("count_chars: {}", count_chars(s));
    let mut it = code_points(s);
    print("forward:");
    while let Some(c) = it.next() {
        print(" {c:x}");
    }
    let mut back = code_points(s);
    print(" | back:");
    while let Some(c) = back.next_back() {
        print(" {c:x}");
    }
    let mut both = code_points(s);
    println(
        " | mixed: {:x} {:x} {:x} {:x} {:x} {} {}", both.next().unwrap(), both.next_back().unwrap(),
        both.next().unwrap(), both.next_back().unwrap(), both.next().unwrap(),
        both.next().is_none(), both.next_back().is_none());
    let sum = code_points(s).fold(0u32, |a, c| a + c);
    println("sum: {sum:x}");

    // Boundaries in "añ€" (a, then 2 bytes, then 3).
    let b = "añ€";
    for i in 0..b.len() + 2 {
        print(
            " {i}:{},{},{}", is_char_boundary(b, i as i64), floor_char_boundary(b, i as i64),
            ceil_char_boundary(b, i as i64));
    }
    println("");

    // The ASCII prefixes, at every offset and length of a 64-byte text
    // with one byte changed (so every alignment of the word loop is met).
    let mut text: Vec<u8, Gpa> = Vec::new_in(gpa);
    for i in 0..64 {
        text.push((0x21 + i) as u8);
    }
    let mut wrong: i64 = 0;
    for at in 0..64 {
        for bad_byte in [0x80u8, 0x1f, 0x7f, 0xff, 0x09, 0x20, 0x7e] {
            let old = text[at as usize];
            text[at as usize] = bad_byte;
            let all = text.as_slice();
            for lo in 0..17 {
                for hi in lo..65 {
                    let v = &all[lo as usize..hi as usize];
                    let mut a: i64 = 0;
                    while a < v.len() as i64 && v[a as usize] < 0x80 {
                        a += 1;
                    }
                    let mut pr: i64 = 0;
                    while pr < v.len() as i64 && v[pr as usize] >= 0x20 && v[pr as usize] <= 0x7e {
                        pr += 1;
                    }
                    if ascii_prefix_len(v) != a || ascii_printable_prefix_len(v) != pr {
                        wrong += 1;
                    }
                }
            }
            text[at as usize] = old;
        }
    }
    println("prefixes: {wrong} wrong");
    let e = match str::from_utf8("\xff").map(|_| ()) { Err(e) => e, Ok(()) => return 1 };
    println(
        "{} {} {}", e.valid_up_to() as i64, e.error_len().map(|n| n as i64).unwrap(),
        e == e.clone());
    0
}

