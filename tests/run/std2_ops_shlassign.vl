// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops ShlAssign.
// EXPECT: V { x: 48 }
use std::ops::ShlAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl ShlAssign for V {
    fn shl_assign(&mut self, rhs: V) {
        self.x <<= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a <<= V { x: 2 };
    println("{:?}", a);
}
