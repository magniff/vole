// (0.27.1) A declared parameter no field uses (D5.3: left bivariant):
// error borrowck.unused_param (rustc E0392); PhantomData uses it.
// RULE: D5.3
// ERROR: error[borrowck.unused_param]: the parameter 'a' of 'Tag' is never used in its fields
// ERROR: error[borrowck.unused_param]: the parameter 'T' of 'Box1' is never used in its fields
// ERROR-COUNT: 2

struct Tag<'a> {
    n: i64,
}

struct Box1<T> {
    n: i64,
}

struct Used<'a, T> {
    r: &'a T,
}

fn main() -> i32 {
    let t = Tag { n: 1 };
    let b: Box1<i64> = Box1 { n: 2 };
    let x = 3;
    let u = Used { r: &x };
    println("{} {} {}", t.n, b.n, *u.r);
    0
}
