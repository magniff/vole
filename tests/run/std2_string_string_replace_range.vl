// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::replace_range.
// EXPECT: aXYZd
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let mut s = String::from_in("abcd", gpa);
    s.replace_range(1usize..3, "XYZ");
    println("{}", s);
}
