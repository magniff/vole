// XFAIL: gap 20: xfail case fails differently after translation
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `f(vv)`; s grows while it is used
// MVS's XFAIL: OVERSTRICT an element of an element's loop (for x in row) is reported as viewing the loop's __for_seq
// ERROR: error[own.conflict]
// ERROR-COUNT: 1
fn f(l: &Vec<Vec<&str, Gpa>, Gpa>) -> &str {
    let mut r: &str = ""; for row in l { for x in row { r = x; } } r
}

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa); v.push(w);
    let mut vv: Vec<Vec<&str, Gpa>, Gpa> = Vec::new_in(gpa);
    vv.push(v);
    let r = f(&vv);
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
