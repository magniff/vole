// EDITION: rust
// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::iter FromIteratorIn::from_iter_in.
// EXPECT: [1, 2]
// RUSTC: none (std2's FromIteratorIn takes the allocator (Rust's FromIterator))
use std::iter::FromIteratorIn;

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = FromIteratorIn::from_iter_in([1i64, 2], gpa);
    println("{:?}", v);
}
