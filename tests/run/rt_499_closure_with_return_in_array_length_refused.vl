// XFAIL: RT-499: a closure whose body returns, declared inside an array length's block, `[0i64; { let c = || -> usize { return 3; }; 2 }]`, is refused: "array length must be an integer, got '!'" (the closure's return is read as the length's exit); rustc prints 2 (0.30.2)
// From the third re-review of g302copy. Since v0.30.1 at least.
// From the review's form cg08.
// EXPECT: 2
fn main() {
    let a = [0i64; {
        let c = || -> usize {
            return 3;
        };
        2
    }];
    println("{}", a.len());
}
