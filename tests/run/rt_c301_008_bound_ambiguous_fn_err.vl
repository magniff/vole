// RULE: F8.3, F9.3
// `T::m(t)` with `T: A + B`, both declaring m: rustc E0034. 0.30.1 took
// the first bound's.
// ERROR: error[method.ambiguous]: multiple applicable items: 'm' is an item of more than one trait for 'T'
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn f<T: A + B>(t: &T) -> i64 { T::m(t) }
fn main() { println("{}", f(&S)); }
