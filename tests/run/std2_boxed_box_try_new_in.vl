// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::try_new_in.
// EXPECT: 7
// RUSTC: none (Box::try_new is unstable in Rust (allocator_api))
use std::boxed::Box;

fn main(gpa: Gpa) {
    match Box::try_new_in(7i64, gpa) {
        Ok(b) => println("{}", b),
        Err(_) => println("out of memory"),
    }
}
