// XFAIL: RT-395: (RT-395's mechanism, a method) `z.g()` in `fn call2<Z: Tr>(z: &Z)` with `trait Tr<U = i32>` and impls of Tr<i64> and Tr<i32> for W is refused, "'W::g' is ambiguous for arguments ()": the default is not applied; rustc calls Tr<i32>'s g and prints 32 (0.30.2)
// From the review of g302oblig-m2 (form f270g). Since v0.30.1 at least;
// the release build the same. Siblings: rt_395, rt_395b, rt_395d (through
// a supertrait), rt_395e (through an associated type's bound).
// EXPECT: 32
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

impl Tr<i32> for W {
    fn g(&self) -> i64 {
        32
    }
}

fn call2<Z: Tr>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", call2(&W { r: 0 }));
}
