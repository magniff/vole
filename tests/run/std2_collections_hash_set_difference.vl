// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set Difference.
// EXPECT: 1
use std::collections::{HashSet, hash_set};
use std::collections::hash_set::Difference;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [2i64].into_iter().collect_in(gpa);
    let d = a.difference(&b);
    println("{}", d.count());
}
