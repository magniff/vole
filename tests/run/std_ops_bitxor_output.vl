// Runs on std since 0.27.2's switch.
// The std item(s): std::ops BitXor::Output.
// EXPECT: V { x: 9 }
use std::ops::BitXor;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitXor for V {
    type Output = V;

    fn bitxor(self, rhs: V) -> V {
        V { x: self.x ^ rhs.x }
    }
}

fn apply<T: BitXor<Output = T>>(a: T, b: T) -> T {
    a ^ b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    let c: <V as BitXor>::Output = apply(a, b);
    println("{:?}", c);
}
