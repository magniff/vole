// RULE: F34.4 (0.30.2, RT-302) The bodies consteval checks are bodies of
// their own too, checked by the same rule (const_body_exits, the one
// check check_const_value): a scalar constant's (`true || return` folds
// to true, the `return` still refused), a static's, an array length or a
// repeat count, an enum discriminant. rustc refuses each (E0572, E0268);
// a5eefbcae accepted the ones whose value folded past the exit. (c10,
// c22, c25, a19, a21, a23 of the second re-review of g302copy-148)
// ERROR: line 19
// ERROR: line 21
// ERROR: line 23
// ERROR: line 25
// ERROR: line 28
// ERROR: line 33
// ERROR-COUNT: 6
fn yes() -> bool {
    true
}

const A: bool = true || return; // error here

const B: bool = false && return; // error here

static G: bool = true || return; // error here

static H: i64 = { if yes() { return; } 1 }; // error here

enum E {
    X = { if yes() { return; } 1 }, // error here
    Y = 2,
}

fn main() {
    let a = [0; { if yes() { return; } 3 }]; // error here
    println("{} {} {} {} {} {}", A, B, G, H, E::Y as i64, a.len());
}
