// (0.29) Vec::extend_from_slice, extend_from_within, clone, [T]::to_vec_in
// and repeat_in copy Copy elements as one block: the same elements as the
// push per element they replace, for no elements, a few (below the block
// copy's least count), many, a source that starts at an odd address, and
// elements of 1, 8 and 24 bytes.
// The std item(s): std::vec Vec::extend_from_slice, Vec::extend_from_within.
// EXPECT: empty 0 []
// EXPECT: few [1, 2, 3]
// EXPECT: grown [1, 2, 3, 4, 5, 6, 7, 8, 9]
// EXPECT: bytes 300000 37350000
// EXPECT: odd [2, 3, 4, 5, 6, 7, 8] 7
// EXPECT: words 5000 12497500
// EXPECT: points 40 780 1560 2340
// EXPECT: within [1, 2, 3, 4, 2, 3, 4, 1, 2, 3, 4, 2, 3, 4]
// EXPECT: clone true 5000
// EXPECT: to_vec [3, 4, 5] repeat [3, 4, 5, 3, 4, 5, 3, 4, 5]
// EXPECT: text hello, world, hello, world 26
use std::string::String;
use std::vec::Vec;

#[derive(Clone, Copy)]
struct Point {
    x: i64,
    y: i64,
    z: i64,
}

fn main(gpa: Gpa) {
    let mut e: Vec<u8, Gpa> = Vec::new_in(gpa);
    e.extend_from_slice(&[]);
    println("empty {} {:?}", e.len(), e);

    let mut few: Vec<i32, Gpa> = Vec::new_in(gpa);
    few.extend_from_slice(&[1, 2, 3]);
    println("few {:?}", few);
    few.extend_from_slice(&[4, 5, 6, 7, 8, 9]);
    println("grown {:?}", few);

    // 300000 bytes, 1000 at a time: the block grows under the copies.
    let mut chunk = [0u8; 1000];
    for i in 0..1000 {
        chunk[i] = (i % 250) as u8;
    }
    let mut bytes: Vec<u8, Gpa> = Vec::new_in(gpa);
    for _ in 0..300 {
        bytes.extend_from_slice(&chunk);
    }
    let mut sum: u64 = 0;
    for b in bytes.iter() {
        sum += *b as u64;
    }
    println("bytes {} {}", bytes.len(), sum);

    // A source that starts one byte into an array.
    let src = [1u8, 2, 3, 4, 5, 6, 7, 8];
    let mut odd: Vec<u8, Gpa> = Vec::new_in(gpa);
    odd.extend_from_slice(&src[1..]);
    println("odd {:?} {}", odd, odd.len());

    let mut words: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut part: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..50 {
        part.push(i);
    }
    for k in 0..100 {
        for x in part.iter_mut() {
            *x += if k == 0 { 0 } else { 50 };
        }
        words.extend_from_slice(&part);
    }
    let mut wsum: i64 = 0;
    for w in words.iter() {
        wsum += *w;
    }
    println("words {} {}", words.len(), wsum);

    let mut pts: Vec<Point, Gpa> = Vec::new_in(gpa);
    let mut four = [Point { x: 0, y: 0, z: 0 }; 4];
    for k in 0..10 {
        for i in 0..4 {
            let n = (k * 4 + i) as i64;
            four[i] = Point { x: n, y: 2 * n, z: 3 * n };
        }
        pts.extend_from_slice(&four);
    }
    let (mut sx, mut sy, mut sz) = (0i64, 0i64, 0i64);
    for p in pts.iter() {
        sx += p.x;
        sy += p.y;
        sz += p.z;
    }
    println("points {} {} {} {}", pts.len(), sx, sy, sz);

    let mut w = Vec::from_in([1, 2, 3, 4], gpa);
    w.extend_from_within(1..);
    w.extend_from_within(..);
    println("within {:?}", w);

    let c = words.clone();
    println("clone {} {}", c == words, c.len());

    let s = [3, 4, 5];
    let t = s.to_vec_in(gpa);
    let r = s.repeat_in(3, gpa);
    println("to_vec {:?} repeat {:?}", t, r);

    let mut text = String::new_in(gpa);
    text.push_str("hello, world");
    text.push_str(", ");
    text.push_str("hello, world");
    println("text {} {}", text, text.len());
}
