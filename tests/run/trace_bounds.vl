// (0.17) --trace: a failed bounds check prints its line, then the calls
// that led to it, each at the line of its call; a method's frame is
// Type::method.
// FLAGS: --trace
// EXPECT: 6
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
// STDERR: trace, innermost call first:
// STDERR: trace_bounds.vl:20  Table::get
// STDERR: trace_bounds.vl:26  sum
// STDERR: trace_bounds.vl:33  main
#[derive(Clone, Copy)] struct Table { cells: [i64; 3] }

impl Table {
    fn get(self, i: i64) -> i64 {
        let c = self.cells;
        if i < 0 {
            return 0;
        }
        c[i as usize]
    }
}

fn sum(t: Table, n: i64) -> i64 {
    let mut s: i64 = 0;
    for i in 0..n { s += t.get(i); }
    s
}

fn main() -> i32 {
    let t = Table { cells: [1i64, 2, 3] };
    print("{}", sum(t, 3));
    print("{}", sum(t, 4));
    0
}
