// EDITION: rust
// RULE: F27.1
// A `let` takes an irrefutable pattern: a struct pattern with a literal
// field does not match every value (rustc E0005).
// ERROR: refutable pattern in 'let': it does not match every value of type 'Point'
struct Point {
    x: i64,
    y: i64,
}

fn main() -> i64 {
    let p = Point { x: 0, y: 2 };
    let Point { x: 0, y } = p;
    y
}
