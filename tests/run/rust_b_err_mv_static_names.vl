// RULE: M3
// (0.30.1) A move out of a static is named by the static's place, as
// rustc's E0507 (`SD`, `ST.0`, `SW.d`, not a binder or an aggregate's text),
// once per scrutinee (an or-pattern's alternatives too), at the scrutinee,
// and its try borrows the static where a binding reads it, rustc's
// "consider borrowing here" (rust_b_ok_static_borrow_tries runs them).
// ERROR: error[borrowck.move_out]: cannot move out of 'SD', a static
// ERROR: line 49, column 13
// ERROR: --new 'let t = &SD;'
// ERROR: error[borrowck.move_out]: cannot move out of '(SE as B).0', a static
// ERROR: line 50, column 11
// ERROR: --new 'match &SE {'
// ERROR: error[borrowck.move_out]: cannot move out of 'ST.0', a static
// ERROR: line 53, column 18
// ERROR: --new 'let (a, n) = &ST;'
// ERROR: error[borrowck.move_out]: cannot move out of 'SW.d', a static
// ERROR: line 54, column 11
// ERROR: --new 'match &SW {'
// ERROR: error[borrowck.move_out]: cannot move out of 'SD', a static
// ERROR: line 57, column 7
// ERROR: error[borrowck.move_out]: cannot move out of 'SD', a static
// ERROR: line 59, column 12
// ERROR: error[borrowck.move_out]: cannot move out of 'SD', a static
// ERROR: line 60, column 13
// ERROR-COUNT: 7
struct D {
    v: i64,
}

struct W {
    d: D,
}

enum E {
    A(D),
    B(D),
}

static SD: D = D { v: 1 };
static SW: W = W { d: D { v: 2 } };
static SE: E = E::A(D { v: 3 });
static ST: (D, i64) = (D { v: 4 }, 5);

fn take(d: D) {
    println("{}", d.v);
}

fn main() {
    let t = SD;
    match SE {
        E::A(d) | E::B(d) => take(d),
    }
    let (a, n) = ST;
    match SW {
        W { d } => take(d),
    }
    { SD };
    let c = n > 0;
    if c { SD } else { D { v: 2 } };
    let w = W { d: SD };
    take(t);
    take(a);
    take(w.d);
}
