// EDITION: rust
// RULE: F26.3
// A comparison's right operand of another type picks the PartialEq<Rhs>
// impl: a String with a str and a `&str`, a Vec with a slice (as rustc).
// EXPECT: true false true true false
fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let t: &str = "abc";
    let v = Vec::from_in([1i64, 2], gpa);
    let a = [1i64, 2];
    let b = [2i64, 1];
    let sa: &[i64] = &a;
    let sb: &[i64] = &b;
    println("{} {} {} {} {}", s == "abc", s == "x", s == t, v == *sa, v == *sb);
}
