// XFAIL: RT-303: `static Z: [D; 0] = [D { k: 1 }; 0];` with D: Drop is accepted; rustc refuses it (E0493: the destructor of D cannot be evaluated at compile time) (0.30.2)
// A zero-length repeat drops its operand at once; in a static's value that
// drop would run at compile time. v0.30.1 the same. From the g302copy-148
// re-review (s18).
// ERROR: line 17
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

static S: [D; 1] = [D { k: 1 }; 1];
static Z: [D; 0] = [D { k: 1 }; 0];

fn main() {
    println("ok {}", S[0].k + Z.len() as i64);
}
