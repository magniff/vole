// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::string String::impl BorrowMut<str>.
// EXPECT: ABC
use std::borrow::BorrowMut;

fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    let t: &mut str = s.borrow_mut();
    t.make_ascii_uppercase();
    println("{}", s);
}
