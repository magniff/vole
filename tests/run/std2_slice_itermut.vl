// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice IterMut.
// EXPECT: [0, 0]
use std::slice::IterMut;

fn zero(it: IterMut<'_, i64>) {
    for x in it {
        *x = 0;
    }
}

fn main() {
    let mut a = [1, 2];
    zero(a.iter_mut());
    println("{:?}", a);
}
