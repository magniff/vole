// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c06_while_let)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// while let binding named as the moved parameter.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures {
    let a = [1i64, 2];
    let mut it = a.iter();
    let mut ok = true;
    while let Some(s) = it.next() { ok = ok && *s > 0; }
    ok
}

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
