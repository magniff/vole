// RULE: D4.6
// (0.27.6) The item normalized through Skip's header borrows the text
// Split reads: the text moved while the item is live is rustc's E0505.
// ERROR: error[borrowck.move_borrowed]: cannot move out of 'text' because it is borrowed
fn pass<J: Iterator>(it: &mut J) -> Option<J::Item> {
    it.next()
}

fn take(_s: String<Gpa>) {}

fn main(gpa: Gpa) {
    let text = String::from_in("a,b,c", gpa);
    let mut it = text.split(',').skip(1);
    let a = pass(&mut it);
    take(text);
    println("{:?}", a);
}
