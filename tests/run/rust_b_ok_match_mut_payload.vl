// RULE: D1.1
// (0.27.1) A `&mut` into an enum payload through `match` on `&mut o` (a
// variant projection).

fn main() {
    let mut o: Option<i64> = Some(1);
    match &mut o {
        Some(v) => *v += 5,
        None => {}
    }
    match o {
        Some(v) => println("{}", v),
        None => println("none"),
    }
}
// EXPECT: 6
