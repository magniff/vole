// RULE: C3.4
// (0.30.2, review of RT-38f) A `while let` binding in an ensures, named as the by-value
// parameter `s` the body took: no name of the clause resolves to the
// parameter, so it has no view (byref.vl VIEW_USED), which would read it
// after the body (borrowck.use_moved).
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
struct N {
    v: i64,
}

fn f(s: N) -> i64
    ensures {
    let mut o = Some(result);
    let mut n = 0i64;
    while let Some(s) = o {
        n += s;
        o = None;
    }
    n == result
}

{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
