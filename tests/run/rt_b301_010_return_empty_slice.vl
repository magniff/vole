// XFAIL: RT-B301-10: `&[]` returned as a `&'a [Vec<..>]` is refused (open, 0.30.2; 0.30.0 the same, L2)
// rustc promotes the empty array to 'static and accepts `fn pick<'a>(s:
// &'a mut [Vec<i64>], c: bool) -> &'a [Vec<i64>] { if c { s } else { &[] }
// }` (prints 1); vole refuses the empty array's temporary
// (borrowck.return_local), the L2 divergence for `&[]`.
// EXPECT: 1
fn pick<'a>(s: &'a mut [Vec<i64, Gpa>], c: bool) -> &'a [Vec<i64, Gpa>] {
    if c { s } else { &[] }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let mut arr = [v];
    let s: &mut [Vec<i64, Gpa>] = &mut arr;
    let b: &[Vec<i64, Gpa>] = pick(s, true);
    println("{}", b.len());
}
