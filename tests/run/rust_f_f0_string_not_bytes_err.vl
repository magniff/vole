// EDITION: rust
// RULE: F0.6
// (0.27.5) A `&String` derefs to `str` only: where a `&[u8]` goes it is a
// mismatch, rustc E0308 (0.27.4 made it `as_bytes()`).
// ERROR: error[type error]
fn len_of(b: &[u8]) -> usize {
    b.len()
}

fn main(gpa: Gpa) {
    let s = String::from_in("hey", gpa);
    println("{}", len_of(&s));
}
