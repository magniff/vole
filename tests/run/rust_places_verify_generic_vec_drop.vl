// Gap 100: a generic function that drops a `Vec<T, A>` linked without
// --verify-places and not with it: the verifier asked for the shim of the
// template's own drop (`Vec<u8, A>` of the instance that checks the
// template), a shim that calls a `drop` no instance made.
// FLAGS: --verify-places --check-alloc
// EXPECT: 0
// EXPECT: 3
use std::alloc::Allocator;

fn count<A: Allocator>(a: A) -> usize {
    let v: Vec<u8, A> = Vec::new_in(a);
    v.len()
}

struct Bag<T, A: Allocator> {
    items: Vec<T, A>,
}

fn filled<T: Clone, A: Allocator>(a: A, x: T) -> usize {
    let mut b = Bag { items: Vec::new_in(a) };
    b.items.push(x.clone());
    b.items.push(x.clone());
    b.items.push(x);
    b.items.len()
}

fn main(gpa: Gpa) -> i32 {
    println("{}", count(gpa));
    println("{}", filled(gpa, String::from_in("s", gpa)));
    0
}
