fn consume(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }
fn grow(v: &mut Vec<i64, Gpa>) -> i64 { v.push(1); 0 }
fn take(s: &[i64], k: i64) -> i64 { s[0] + k }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let w = v;
    println("{}", v.len());
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(3);
    let t = u.as_slice();
    u.push(4);
    println("{}", t[0]);
    for x in u { if x > 0 { u.push(x); } }
    take(u.as_slice(), grow(&mut u));
    { let at_arg1 = u.as_slice(); u.extend_from_slice(at_arg1) };
    let k = consume(w);
    println("{} {k}", w.len());
}
