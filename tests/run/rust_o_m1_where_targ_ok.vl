// (0.30.2, obligations M1) RT-C301-15's impls with the bound in a where
// clause, `where T: Tr<i64>`: the impl it chooses needs nothing. rustc
// accepts it.
// EXPECT: 64
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<T>(t: &T) -> &'static str where T: Tr<i64> { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() }; println("{}", go(&x));
}
