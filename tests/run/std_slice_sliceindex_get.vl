// Runs on std since 0.27.2's switch.
// The std item(s): std::slice SliceIndex::get.
// EXPECT: Some(1) None
// RUSTC: none (SliceIndex's methods are unstable in Rust)
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3];
    println("{:?} {:?}", 0usize.get(s), 5usize.get(s));
}
