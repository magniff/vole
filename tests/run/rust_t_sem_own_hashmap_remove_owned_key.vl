// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_hashmap_remove_owned_key.vl to Rust's spelling.
// sem-own: remove(key: sink K) of an owned key: the key argument and the stored key each dropped once.
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: rem 5
// EXPECT: drop 5
// EXPECT: end
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

use std::HashMap;

impl Eq for D<Gpa> {
    fn eq(&self, other: &D<Gpa>) -> bool {
        self.id == other.id
    }
}

impl Hash for D<Gpa> {
    fn hash(&self) -> u64 {
        self.id as u64
    }
}

fn main(gpa: Gpa) {
    let mut m: HashMap<D<Gpa>, D<Gpa>, Gpa> = HashMap::new_in(gpa);
    m.insert(mk(1, gpa), mk(5, gpa));
    {
        let r = m.remove(mk(1, gpa));
        if let Some(d) = r {
            println("rem {}", d.id);
        }
    }
    println("end");
}
