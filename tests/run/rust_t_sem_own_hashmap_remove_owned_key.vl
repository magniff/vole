// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_hashmap_remove_owned_key.vl to Rust's spelling.
// sem-own: remove(&k) of a temporary key: the stored key and the temporary each dropped once.
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: rem 5
// EXPECT: drop 5
// EXPECT: end
use std::alloc::Allocator;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

use std::collections::HashMap;
use std::hash::{Hash, Hasher};

impl<A: Allocator> PartialEq for D<A> {
    fn eq(&self, other: &Self) -> bool {
        self.id == other.id
    }
}

impl<A: Allocator> Eq for D<A> {}

impl<A: Allocator> Hash for D<A> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.id.hash(state);
    }
}

fn main(gpa: Gpa) {
    let mut m: HashMap<D<Gpa>, D<Gpa>, Gpa> = HashMap::new_in(gpa);
    m.insert(mk(1, gpa), mk(5, gpa));
    {
        let r = m.remove(&mk(1, gpa));
        if let Some(d) = r {
            println("rem {}", d.id);
        }
    }
    println("end");
}
// XFAIL: HashMap::new_in not found for HashMap<K, V, Gpa> (S defaulted) (front272 F5)
