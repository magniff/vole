// XFAIL: RT-77: a for loop calls the iterated type's inherent into_iter, not IntoIterator::into_iter (0.30.2)
// Rust desugars `for x in e` to `IntoIterator::into_iter(e)`; an inherent
// method named into_iter is never what a for loop calls. vole builds the
// method call `e.into_iter()` by name (front/check/iterate.vl rust_for),
// where the inherent method wins: 600 21 600 for rustc's 6 3 600.
// EXPECT: 6
// EXPECT: 3
// EXPECT: 600
struct Bag { a: [i64; 3] }

struct It { i: usize, a: [i64; 3] }

impl Iterator for It {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.i < 3 { self.i += 1; Some(self.a[self.i - 1]) } else { None }
    }
}

impl Bag {
    fn into_iter(self) -> It { It { i: 0, a: [100, 200, 300] } }
}

impl IntoIterator for Bag {
    type Item = i64;
    type IntoIter = It;
    fn into_iter(self) -> It { It { i: 0, a: self.a } }
}

struct C { n: i64 }

impl C {
    fn into_iter(self) -> It { It { i: 0, a: [7, 7, 7] } }
}

impl Iterator for C {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n > 0 { self.n -= 1; Some(self.n) } else { None }
    }
}

fn main() {
    let mut t = 0;
    for x in (Bag { a: [1, 2, 3] }) { t += x; }
    println("{t}");
    let mut u = 0;
    for x in (C { n: 3 }) { u += x; }
    println("{u}");
    let mut w = 0;
    for x in (Bag { a: [1, 2, 3] }).into_iter() { w += x; }
    println("{w}");
}
