// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char char::from_u32.
// EXPECT: Some('A') Some('é') None None
use std::char::from_u32;

fn main() {
    println("{:?} {:?} {:?} {:?}", char::from_u32(65), char::from_u32(0xE9), char::from_u32(0xD800),
        char::from_u32(0x110000));
}
