// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::try_reserve.
// EXPECT: true true
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let ok = v.try_reserve(10).is_ok();
    let too_big = v.try_reserve(usize::MAX).is_err();
    println("{} {}", ok, too_big);
}
