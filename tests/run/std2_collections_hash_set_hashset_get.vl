// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set HashSet::get.
// EXPECT: Some("a") None
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let mut s: HashSet<String<Gpa>, Gpa> = HashSet::new_in(gpa);
    s.insert("a".to_string_in(gpa));
    println("{:?} {:?}", s.get("a"), s.get("b"));
}
