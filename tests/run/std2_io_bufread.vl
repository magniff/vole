// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io BufRead.
// EXPECT: 2
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn count<B: BufRead>(b: B) -> usize {
    b.lines().count()
}

fn main() {
    println("{}", count(BufReader::new("a\nb\n".as_bytes())));
}
