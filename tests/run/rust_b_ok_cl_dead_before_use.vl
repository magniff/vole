// EDITION: rust
// RULE: D10.3
// (0.27.1) The closure is dead before `c` is used: its capture loan ends.

fn main() {
    let mut c: i64 = 0;
    let mut bump = || c += 1;
    bump();
    bump();
    c += 10;
    println("{}", c);
}
// EXPECT: 12
