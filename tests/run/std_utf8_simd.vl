// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::str::ascii_prefix_len'
// std::str's NEON routines (0.20, D2) against their scalar versions, the
// oracle: random texts, mostly UTF-8 with damage at any place (so that
// errors fall at every position of a 16- and 64-byte block and across
// them), at every offset: validation (the whole Utf8Error), the ASCII and
// printable-ASCII prefixes, counting, lossy decoding with any room,
// memchr and memrchr. On x86-64 both sides are the scalar code.
use std::arch::detect;
use std::str::ascii_prefix_len; use std::str::ascii_prefix_len_scalar;
use std::str::ascii_printable_prefix_len; use std::str::ascii_printable_prefix_len_scalar;
use std::str::count_chars; use std::str::count_chars_scalar; use std::str::decode_into;
use std::str::decode_into_scalar; use std::str::encode_utf8; use std::str::is_utf8;
use std::str::memrchr; use std::str::from_utf8 as validate_utf8; use std::str::validate_utf8_scalar;

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

// Text of n pieces: ASCII runs (printable and controls), scalar values of
// every length, and now and then a damaged byte.
fn make(s: &mut u64, b: &mut Vec<u8, Gpa>, n: u64) {
    let mut e = [0u8; 4];
    for _ in 0..n {
        let x = next(s);
        let k = x % 64;
        if k < 30 {
            for j in 0..1 + (x >> 8) % 20 {
                b.push((0x20 + (x >> (13 + j * 2)) % 95) as u8);
            }
        } else if k < 32 {
            b.push(((x >> 8) % 32) as u8);
        } else if k < 62 {
            let c = (x >> 8) % 4;
            let cp = if c == 0 { 0x80 + (x >> 16) % 0x780 } else if c == 1 {
                0x800 + (x >> 16) % 0xd000
            } else if c == 2 { 0xe000 + (x >> 16) % 0x2000 }
                else { 0x10000 + (x >> 16) % 0x100000 };
            let m = encode_utf8(cp as u32, &mut e);
            b.extend_from_slice(&e[0..m as usize]);
        } else {
            b.push((x >> 8) as u8);
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    println("neon: {}", detect("neon"));
    let mut s: u64 = 0x2545f4914f6cdd1d;
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    let mut out1: Vec<u32, Gpa> = Vec::from_elem_in(0u32, 2048usize, gpa);
    let mut out2: Vec<u32, Gpa> = Vec::from_elem_in(0u32, 2048usize, gpa);
    let mut fails: i64 = 0;
    let mut valid: i64 = 0;
    for round in 0..20000 {
        b.clear();
        let n = 1 + next(&mut s) % 40;
        make(&mut s, &mut b, n);
        let all = b.as_slice();
        let off = (next(&mut s) % 16) as i64;
        let v = if off < all.len() as i64 { &all[off as usize..all.len()] } else { all };
        let mut bad = false;
        let a = str::from_utf8(v).map(|_| ());
        let c = validate_utf8_scalar(v);
        let same = match (a, c) {
            (Ok(()), Ok(())) => true,
            (Err(x), Err(y)) => x == y,
            _ => false,
        };
        if !same {
            bad = true;
        }
        if c.is_ok() {
            valid += 1;
            if count_chars(v) != count_chars_scalar(v) {
                bad = true;
            }
        }
        if ascii_prefix_len(v) != ascii_prefix_len_scalar(v)
            || ascii_printable_prefix_len(v) != ascii_printable_prefix_len_scalar(v)
            || is_utf8(v) != c.is_ok() {
            bad = true;
        }
        let room = 1 + (next(&mut s) % 300) as i64;
        let (c1, m1) = decode_into(v, &mut out1.as_mut_slice()[0..room as usize]);
        let (c2, m2) = decode_into_scalar(v, &mut out2.as_mut_slice()[0..room as usize]);
        if c1 != c2 || m1 != m2 {
            bad = true;
        } else {
            for k in 0..m1 {
                if out1[k as usize] != out2[k as usize] {
                    bad = true;
                }
            }
        }
        let needle = (next(&mut s) % 128) as u8;
        let mut first: i64 = -1;
        let mut last: i64 = -1;
        for k in 0..v.len() {
            if v[k] == needle {
                if first < 0 { first = k as i64; }
                last = k as i64;
            }
        }
        if v.iter().position(|c| *c == needle).map(|i| i as i64).unwrap_or(-1) != first
            || memrchr(needle, v).unwrap_or(-1) != last {
            bad = true;
        }
        if bad {
            fails += 1;
            if fails <= 5 {
                println("round {round}: {} bytes at offset {off}", v.len());
            }
        }
    }
    println("20000 texts, {valid} valid, {fails} differ");
    if fails == 0 { 0 } else { 1 }
}

// EXPECT: neon: true
// EXPECT: 20000 texts, 12650 valid, 0 differ
