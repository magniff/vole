// (0.26.3, decision 6) `a / b` of i64s panics at every level, with the
// overflow checks on or off, with Rust's message at the expression.
// FLAGS: -O2
// EXIT: 101
// EXPECT: before
// STDERR: ovf_div_zero_o2.vl:17:13: attempt to divide by zero

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i64 = id(7) as i64;
    let b: i64 = id(0) as i64;
    println("before");
    let r = a / b;
    println("after {}", r);
}
