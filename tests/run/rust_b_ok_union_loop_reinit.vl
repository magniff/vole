// RULE: M2
// (0.30.1) A union's field assigned where a move of the union reaches it,
// rustc's is_predecessor_of: an earlier statement, or a loop's back edge
// (assigned in each iteration, moved out after it). Before, a false
// borrowck.assign_moved_part.
// EXPECT: each 0
// EXPECT: each 1
// EXPECT: branch 10
// EXPECT: branch 12
// EXPECT: straight 1 2 3
use std::mem::ManuallyDrop;

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

union U {
    a: ManuallyDrop<D>,
    b: i64,
}

// The union is assigned in each iteration and moved out after it: the
// move reaches the assignment through the back edge (rustc's
// is_predecessor_of), so the assignment is the union's anew.
fn each(n: i64) {
    let mut u: U;
    let mut i = 0;
    while i < n {
        u.a = ManuallyDrop::new(D { v: i });
        // UNSAFE: a union's field read
        // SAFETY: a was assigned just above
        let d = unsafe { u.a };
        println("each {}", d.v);
        i += 1;
    }
}

// The move in a branch of the body, later in the iteration.
fn branch(n: i64) {
    let mut u: U;
    let mut i = 0;
    loop {
        if i == n {
            break;
        }
        u.a = ManuallyDrop::new(D { v: 10 + i });
        if i % 2 == 0 {
            // UNSAFE: a union's field read
            // SAFETY: a was assigned above in this iteration
            let d = unsafe { u.a };
            println("branch {}", d.v);
        }
        i += 1;
    }
}

// Straight-line: assigned whole, read, moved out, assigned again.
fn straight() {
    let mut u = U { b: 1 };
    // UNSAFE: a union's field read
    // SAFETY: b was assigned at the union's construction
    let x = unsafe { u.b };
    u.a = ManuallyDrop::new(D { v: 2 });
    // UNSAFE: a union's field read
    // SAFETY: a was assigned just above
    let d = unsafe { u.a };
    u.a = ManuallyDrop::new(D { v: 3 });
    // UNSAFE: a union's field read
    // SAFETY: a was assigned just above
    let e = unsafe { u.a };
    println("straight {} {} {}", x, d.v, e.v);
}

fn main() {
    each(2);
    branch(3);
    straight();
}
