// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a25_holder_vec_option_iter)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// Over-refusal probe: a Vec parameter; the clause iterates an Option of its own.
fn f(v: &Vec<i64, Gpa>, o: Option<i64>) -> i64
    requires o.iter().all(|x: &i64| *x > 0) && v.len() > 0
{
    v[0]
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    println("{}", f(&v, Some(1)));
}
