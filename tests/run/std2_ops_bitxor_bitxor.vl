// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops BitXor::bitxor.
// EXPECT: V { x: 9 } 9
use std::ops::BitXor;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitXor for V {
    type Output = V;

    fn bitxor(self, rhs: V) -> V {
        V { x: self.x ^ rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.bitxor(b), BitXor::bitxor(12i64, 5));
}
