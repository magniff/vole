// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::as_ptr.
// EXPECT: 2
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2], gpa);
    let p = v.as_ptr();
    // UNSAFE: a read through the Vec's pointer.
    // SAFETY: element 1 is initialized and v outlives p's use.
    let x = unsafe { *p.add(1) };
    println("{}", x);
}
