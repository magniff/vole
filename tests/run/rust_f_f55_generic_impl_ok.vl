// RULE: F5.5
// (0.30.1) Generic impls whose methods have their trait's signature, with
// the impl's parameters in the trait's places: accepted, as rustc does.
// EXPECT: 3 4
// EXPECT: Some(5)
// EXPECT: 6
trait Tr<T> {
    fn by_ref(&self) -> i64;
    fn put(&mut self, t: T);
    fn get(&self) -> Option<&T>;
}

struct B<T> {
    t: Option<T>,
    n: i64,
}

impl<T> Tr<T> for B<T> {
    fn by_ref(&self) -> i64 {
        self.n
    }

    fn put(&mut self, t: T) {
        self.t = Some(t);
    }

    fn get(&self) -> Option<&T> {
        self.t.as_ref()
    }
}

struct Count<T> {
    left: T,
}

impl<T: Copy> Iterator for Count<T> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        Some(self.left)
    }
}

fn main() {
    let mut b: B<i64> = B { t: None, n: 3 };
    b.put(5);
    println("{} {}", b.by_ref(), b.by_ref() + 1);
    println("{:?}", b.get());
    let mut c = Count { left: 6 };
    println("{}", c.next().unwrap());
}
