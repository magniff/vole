// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::cmp max_by_key.
// EXPECT: -4 -3
use std::cmp::Ordering;

#[derive(Debug, Clone, Copy)]
struct P {
    x: i64,
}

impl PartialEq for P {
    fn eq(&self, other: &P) -> bool {
        self.x == other.x
    }
}

impl Eq for P {}

impl PartialOrd for P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for P {
    fn cmp(&self, other: &P) -> Ordering {
        self.x.cmp(&other.x)
    }
}

fn main() {
    println("{} {}", std::cmp::max_by_key(-4i64, 2, |x| x.abs()),
        std::cmp::max_by_key(3i64, -3, |x| x.abs()));
}
