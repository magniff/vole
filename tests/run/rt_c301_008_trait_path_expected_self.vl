// RULE: F8.2, F8.3
// RT-C301-8: `Make::make()` with Self from the expected type S is
// `<S as Make>::make`, though S has an inherent `make` too. 0.30.1 called
// the inherent one and printed `0 0 1`. rustc prints 1 0 1.
// EXPECT: 1 0 1
trait Make { fn make() -> Self; }
#[derive(Debug)]
struct S { v: i64 }
impl S { fn make() -> S { S { v: 0 } } }
impl Make for S { fn make() -> S { S { v: 1 } } }

fn main() {
    let a: S = Make::make(); let b = S::make(); let c = <S as Make>::make();
    println("{} {} {}", a.v, b.v, c.v);
}
