// XFAIL: RT-242: with a trait `Same<R>` implemented for W (`Same<W>`, `Same<&W>`) and a blanket `impl<A: Same<B>, B> Same<&B> for &A`, `rx.same(ry)` on two `&&W` runs W's `Same<&W>` (203) instead of the blanket impl for &W found at the first probe step (1103): the probe chooses the autoderef step by the argument's type (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt); the release build, v0.28.0 to
// v0.30.1 and the g302probe build print `203 203 103 203`. The other three
// calls are right. R302E-13 is the refused side of the same pick (std's
// PartialOrd/PartialEq on `&&T`).
// EXPECT: 1103 203 103 203
trait Same<R> {
    fn same(&self, o: &R) -> i64;
}

struct W {
    k: i64,
}

impl Same<W> for W {
    fn same(&self, o: &W) -> i64 {
        100 + self.k + o.k
    }
}

impl<'b> Same<&'b W> for W {
    fn same(&self, o: &&'b W) -> i64 {
        200 + self.k + o.k
    }
}

impl<'a, 'b, A: Same<B>, B> Same<&'b B> for &'a A {
    fn same(&self, o: &&'b B) -> i64 {
        1000 + (**self).same(*o)
    }
}

fn main() {
    let a = W { k: 1 };
    let b = W { k: 2 };
    let x: &W = &a;
    let y: &W = &b;
    let rx = &x;
    let ry = &y;
    println("{} {} {} {}", rx.same(ry), x.same(&y), a.same(&b), a.same(&y));
}
