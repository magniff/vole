// (0.29) -O1 inlines small leaf functions, and a function whose only
// call is a failed check's report (the runtime's, in a panic block) is a
// leaf: `at`, six instructions without the report, is inlined into the
// loop and not emitted. It was a call per element.
// EXPECT: 10
// CHECK-OPT: 1
// CHECK-NOT: fn at:
// CHECK: fn total:
// CHECK-NOT: call at
// CHECK: rt.panic
// CHECK: fn main:
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

fn at(s: &[i64], i: i64) -> i64 {
    s[i as usize]
}

fn total(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        t += at(s, i);
        i += 1;
    }
    t
}

fn main() -> i32 {
    let s: [i64; 4] = [1, 2, 3, 4];
    unsafe { printf(c"%ld\n", total(&s[..])); }
    0
}
