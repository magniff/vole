// (0.30.2, RT-466's family) A closure's body is a function with a frame
// of its own: four locals of 2^60 bytes in it, the fourth refused.
// FLAGS: --target aarch64-macos
// ERROR: frame.too_big
// ERROR: line 13, column 17
fn main() {
    let n = std::env::args().count();
    let f = |k: usize| -> u8 {
        if k > 5 {
            let a = [3u8; 1usize << 60];
            let b = [4u8; 1usize << 60];
            let c = [5u8; 1usize << 60];
            let d = [6u8; 1usize << 60];
            return a[k] + b[k] + c[k] + d[k];
        }
        k as u8
    };
    println("{}", f(n));
}
