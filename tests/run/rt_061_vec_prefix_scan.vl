// FLAGS: -O2
// acc is a running value stored every iteration, so the stores need the
// prefix (1, 3, 7, ...), not a lane-wise reduction. At -O2 the loop is
// vectorized (8 lanes, vec-stats) and stores b[i] itself; -O0 and -O1 are
// right. Also with + over u8 and u16 and with | over u16.
// EXPECT: 65535 [1, 3, 7, 15, 31, 63, 127, 255, 511, 1023, 2047, 4095, 8191, 16383, 32767, 65535]
#[inline(never)]
fn scan(a: &mut [u16], b: &[u16], n: usize) -> u16 {
    let mut acc: u16 = 0;
    let mut i: usize = 0;
    while i < n {
        acc = acc ^ b[i];
        a[i] = acc;
        i += 1;
    }
    acc
}

fn main() -> i32 {
    let b: [u16; 16] = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192, 16384,
        32768];
    let mut a: [u16; 16] = [0; 16];
    let r = scan(&mut a, &b, 16);
    println("{} {:?}", r, a);
    0
}
