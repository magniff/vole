#[derive(Clone, Copy)] struct H<'a> { s: &'a [i64] }
fn keep(h: &mut H<'_>, y: [i64; 2]) { h.s = &y[..]; }

fn main() {
    let a = [1i64, 2]; let e = [0i64, 0]; let mut h = H { s: &e[..] }; keep(&mut h, a);
    println("{}", h.s[0]);
}
