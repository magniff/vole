// EDITION: rust
// RULE: F16.1
// `write(f, "..")` in a Display impl and `writeln(&mut s, "..")` into a
// String: std2's write and writeln, the format literal written in place.
// EXPECT: (1, 2)!
// EXPECT: 7
use std::fmt::{Display, Formatter};

struct Pt {
    x: i64,
    y: i64,
}

impl Display for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "({}, {})", self.x, self.y)
    }
}

fn main(gpa: Gpa) {
    let p = Pt { x: 1, y: 2 };
    let mut s = String::new_in(gpa);
    let _ = writeln(&mut s, "{p}!");
    let _ = write(&mut s, "{}", 7);
    print("{}", s);
}
