// FLAGS: --check-alloc
// RULE: F35.2 (0.30.2, RT-148) A repeat of a constant whose type is not
// Copy makes each element from the constant, of any length: N
// evaluations in a loop of the places IR, no limit (a limit once refused
// these; v0.30.1 copied one value). Each element is dropped once. A Copy
// constant repeats as a copy. The output is rustc's.
// EXPECT: 5000 true
// EXPECT: drops 5000
// EXPECT: 2 8194
// EXPECT: drops 13194
// EXPECT: 100000
use std::sync::atomic::{AtomicI64, Ordering};

static DROPS: AtomicI64 = AtomicI64::new(0);

struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        DROPS.fetch_add(self.k, Ordering::Relaxed);
    }
}

const C: Option<D> = Some(D { k: 1 });
const E: D = D { k: 2 };
const Z: i64 = 0;

fn main() {
    {
        let a = [C; 5000];
        println("{} {}", a.len(), a[4999].is_some());
    }
    println("drops {}", DROPS.load(Ordering::Relaxed));
    {
        let b = [E; 4097];
        let s: i64 = b.iter().map(|d| d.k).sum();
        println("{} {}", b[4096].k, s);
    }
    println("drops {}", DROPS.load(Ordering::Relaxed));
    let z = [Z; 100000];
    println("{}", z.len());
}
