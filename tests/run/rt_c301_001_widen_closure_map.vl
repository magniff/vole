// FLAGS: -O2
// `Some(a).map(|x| x + x).unwrap()` passed to `take(x: i64)`, `a` an
// untyped literal: rustc types the literal i64 from the use and prints
// 4000000000. vole computes `x + x` in i32 in the closure: -294967296 at
// -O2 (a panic at -O0).
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let s = Some(a).map(|x| x + x).unwrap();
    println("{}", take(s));
}
