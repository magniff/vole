// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::default DefaultIn::default_in.
// EXPECT: 0 ""
use std::string::String;

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = Vec::default_in(gpa);
    let s: String<Gpa> = String::default_in(gpa);
    println("{} {:?}", v.len(), s);
}
