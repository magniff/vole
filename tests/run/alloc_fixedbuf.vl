// XFAIL: gap 7: compile parser error: expected expression, got 'mut'
// 0.16: FixedBuf, an allocator in a fixed buffer (an array here): blocks
// bump through it, the last one grows in place, and when it is full the
// try_ functions return Err(OutOfMemory) and leave the container as it
// was. `reset` (unsafe) makes it empty again. Every container works on it.
// (0.25) It holds mem inout: `FixedBuf::new(&mem[..])`.
// EXPECT: pushed 64, then Err(OutOfMemory); len 64, used 512
// EXPECT: try_reserve: Err(OutOfMemory) Ok(())
// EXPECT: buf: abc 42, map: 2
// EXPECT: after reset: 0; tiny: 0 Err(OutOfMemory)
// EXPECT: get: Some(20) None None
use std::hash::FixedState;
use std::alloc::AllocError; use std::alloc::FixedBuf; use std::collections::HashMap;

fn main() {
    let mut mem: [u8; 1024] = [0; 1024];
    let f = FixedBuf::new(&mut mut mem[..]);
    let mut v: Vec<i64, FixedBuf<'_>> = Vec::new_in(f);
    let mut pushed: i64 = 0;
    let mut last: Result<(), AllocError> = Ok(());
    for i in 0..1000 {
        last = v.try_reserve(1).map(|_| v.push(i));
        if last.is_err() {
            break;
        }
        pushed += 1;
    }
    println("pushed {pushed}, then {last:?}; len {}, used {}", v.len(), f.used() as i64);
    drop(v);
    let mut w: Vec<i64, FixedBuf<'_>> = Vec::new_in(f);
    println("try_reserve: {:?} {:?}", w.try_reserve(1000 as usize), w.try_reserve(10 as usize));
    drop(w);
    let mut b: String<FixedBuf<'_>> = String::new_in(f);
    std::fmt::write(&mut b, "abc {}", 42).unwrap();
    // (0.25: a container on f holds mem's inout access until its last use,
    // so the map comes after the Buf's)
    print("buf: {b}, ");
    let mut m: HashMap<i64, i64, FixedBuf<'_>, FixedState> = HashMap::new_in(f);
    m.insert(1, 1);
    m.insert(2, 2);
    println("map: {}", m.len());
    unsafe {
        f.reset();
    }
    let mut small: [u8; 8] = [0; 8];
    let tiny = FixedBuf::new(&mut mut small[..]);
    let mut t: Vec<u8, FixedBuf<'_>> = Vec::new_in(tiny);
    println("after reset: {}; tiny: {} {:?}", f.used() as i64, tiny.used() as i64,
        t.try_reserve(1).map(|_| t.push(1u8)));
    let s = [10i64, 20, 30];
    println("get: {:?} {:?} {:?}", s[..].get(1usize).copied(), s[..].get(3usize).copied(),
        s[..].get(1).copied());
}
