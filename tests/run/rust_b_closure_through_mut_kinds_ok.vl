// RULE: D19.2
// (0.30.1, RT-36) A closure that only reads through a captured `&mut` is
// `Fn`; one whose kind is inferred and that writes through it, by an
// assignment, a slicing, a `&mut self` autoref, a reborrow or a `&raw
// mut`, is FnMut (front/closures/kinds.vl scan_body): accepted.
// EXPECT: 3 9 1 2
fn h(x: &mut [u8]) {
    x[1] = 1;
}

fn read<F: Fn() -> u8>(f: F) -> u8 {
    f()
}

fn main() {
    let mut a = [1u8, 2, 3];
    let v = &mut a[..];
    let n = read(|| v[0] + v[..2].len() as u8);
    let mut c = || {
        v[..2].reverse();
        v[0] = 9;
        v.reverse();
        v.reverse();
        h(v);
        let p = &raw mut v[2];
        unsafe {
            *p = 2;
        }
    };
    c();
    println("{} {} {} {}", n, a[0], a[1], a[2]);
}
