// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a26_ensures_result_raw)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// An ensures whose result is a raw pointer: the callee writes through it.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(r: &mut i64) -> *mut i64
    ensures poke(result)
{
    r as *mut i64
}

fn main() {
    let mut x = 1i64;
    let p = f(&mut x);
    println("{}", x);
}
