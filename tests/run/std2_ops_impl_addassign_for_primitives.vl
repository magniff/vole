// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl AddAssign for primitives.
// EXPECT: 17 17
use std::ops::AddAssign;

fn update<T: AddAssign>(a: &mut T, b: T) {
    a.add_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
