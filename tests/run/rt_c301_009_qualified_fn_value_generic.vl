// XFAIL: RT-C301-9: `<T as B>::m` as a fn value in a generic function is refused (0.30.2)
// From the review: method value of a generic: <T as B>::m as fn value inside generic
// rustc accepts and prints 2.
// EXPECT: 2
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn go<T: A + B>(t: &T) -> i64 { let f = <T as B>::m; f(t) }
fn main() { println("{}", go(&S)); }
