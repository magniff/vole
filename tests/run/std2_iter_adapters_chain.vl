// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Chain.
// EXPECT: [1, 2, 3]
use std::iter::Chain;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64], gpa);
    let b = Vec::from_in([2i64, 3], gpa);
    let it: Chain<std::slice::Iter<'_, i64>, std::slice::Iter<'_, i64>> = a.iter().chain(b.iter());
    let v: Vec<i64, Gpa> = it.copied().collect_in(gpa);
    println("{:?}", v);
}
