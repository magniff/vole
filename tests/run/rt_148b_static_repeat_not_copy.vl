// Statics are never dropped, so no double free; the same Copy rule as RT-148 must decide it.
// ERROR: line 22
// ERROR: line 23
// ERROR-COUNT: 2
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

struct E {
    k: i64,
}

const fn mk() -> E {
    E { k: 2 }
}
static A: [E; 2] = [mk(); 2];
static B: [D; 2] = [D { k: 1 }; 2];

fn main() {
    println("{} {}", A[0].k, B[1].k);
}
