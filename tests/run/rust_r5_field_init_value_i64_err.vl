// RULE: R5
// (0.30.2) A struct field's value, or an assignment's, is checked as a
// `let`'s with its written type: a value where a reference goes is
// type.ref-value (rustc E0308), never lent unasked.
// ERROR: is a value where a reference goes
struct S<'a> { p: &'a i64 }

fn main() {
    let n: i64 = 5;
    let s = S { p: n };
    let mut t = S { p: &0 };
    let m: i64 = 9;
    t.p = m;
    println("{} {}", s.p, t.p);
}
