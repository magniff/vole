// EDITION: rust
// (0.26.3, decision 6) `a % b` of i32s panics at every level, with the
// overflow checks on or off, with Rust's message at the expression.
// FLAGS: -O0 --overflow-checks=off
// EXIT: 101
// EXPECT: before
// STDERR: ovf_rem_min_o0_off.vl:18:13: attempt to calculate the remainder with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i32 = id(-2147483648) as i32;
    let b: i32 = id(-1) as i32;
    println("before");
    let r = a % b;
    println("after {}", r);
}
