// the projection keeps s exclusively borrowed while r is used
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 8, column 71
#[derive(Clone, Copy)] struct S { a: i64, b: i64 }
fn pick(s: &mut S, first: bool) -> &mut i64 { if first { &mut s.a } else { &mut s.b } }

fn main() {
    let mut s = S { a: 1, b: 2 }; let r = pick(&mut s, true); let t = s.b; *r += 10;
    println("{} {t}", s.a);
}
