// XFAIL: RT-480: a `&mut self` slice method on `*p` of a `p: *mut [i64]`, in `unsafe`, is refused, "cannot borrow '*p' as mutable, which is behind a `&` reference" (borrowck.borrow_immutable): `(*p).split_at_mut(1)`, `(*p).chunks_mut(2)`, `(*p).swap(0, 1)`, `(*p).copy_from_slice(..)`; rustc prints the EXPECT lines (0.30.2)
// From the third re-review of g302holes. Since v0.30.1 at least.
// `(*p)[0] = 9`, `let r: &mut [i64] = &mut *p;` and `(*p).swap(0, 1)`
// of a `*mut [i64; 2]` are accepted: the method's autoref of a raw slice
// pointer's pointee is taken as behind `&`.
// EXPECT: 8 9
// EXPECT: 5 6
fn go(p: *mut [i64]) {
    // UNSAFE: test
    // SAFETY: test
    let (a, _) = unsafe { (*p).split_at_mut(1) };
    a[0] = 9;
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        for c in (*p).chunks_mut(2) {
            c[1] = 8;
        }
    }
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        (*p).swap(0, 1);
    }
}

fn copy(p: *mut [i64]) {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        (*p).copy_from_slice(&[5i64, 6]);
    }
}

fn main() {
    let mut a = [1i64, 2];
    go(&mut a[..] as *mut [i64]);
    println("{} {}", a[0], a[1]);
    copy(&mut a[..] as *mut [i64]);
    println("{} {}", a[0], a[1]);
}
