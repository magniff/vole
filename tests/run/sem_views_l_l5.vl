// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello (generic let param passed through)
// EXPECT: hello
// EXPECT: 7
#[derive(Clone, Copy)] struct E { name: [u8; 8], len: i64 }
trait N { fn nm(&self) -> &[u8]; }
impl N for E { fn nm(&self) -> &[u8] { &self.name[..self.len as usize] } }
fn call<X: N>(x: &X) -> &[u8] { x.nm() }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 };
    let n = call(&e);
    let k = clobber();
    println("{}", str::from_utf8(n).unwrap());
    println("{}", k);
    0
}
