// (0.27.0) Hand-translated from tests/run/own_refs.vl to Rust's spelling:
// `&T` and `&mut T` parameters, `&x`, `&mut x`, a reference in a local,
// `&mut a[..]`, a reference converted to a raw pointer.
// EXPECT: 24 24
// EXPECT: 2 22
// EXPECT: 19 19
// EXPECT: 19
// EXPECT: 5 5
// EXPECT: 3
struct P {
    x: i64,
    y: i64,
}

fn bump(p: &mut P) {
    p.x += 1;
}

fn read(p: &P) -> i64 {
    p.x + p.y
}

fn legacy(p: &mut P) {
    p.y += 10;
}

fn total(s: &[i64]) -> i64 {
    let mut t = 0;
    for x in s {
        t += *x;
    }
    t
}

fn fill(s: &mut [i64], v: i64) {
    for i in 0..s.len() {
        s[i] = v;
    }
}

fn setn(out: &mut i64, v: i64) {
    *out = v;
}

fn deep(p: *const *const i64) -> i64 {
    unsafe { **p }
}

fn main() {
    let mut p = P { x: 1, y: 2 };
    bump(&mut p);
    legacy(&mut p);
    legacy(&mut p);
    println("{} {}", read(&p), read(&p));
    let r = &p;
    println("{} {}", r.x, r.y);
    let mut a = [1, 2, 3, 4];
    fill(&mut a[1..3], 7);
    println("{} {}", total(&a[..]), total(&a[..]));
    let s = &a[..];
    println("{}", total(s));
    let mut n = 0;
    setn(&mut n, 5);
    let q: *const i64 = &n;
    println("{n} {}", unsafe { *q });
    let three: i64 = 3;
    let r3 = &three as *const i64;
    println("{}", deep(&r3));
}
