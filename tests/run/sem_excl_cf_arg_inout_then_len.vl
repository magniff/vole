// EDITION: rust
// f(&a, a.len()): the read ends before the inout access begins (two-phase, conventions.md §3): fine
fn add(a: &mut Vec<i64, Gpa>, b: i64) { a.push(b); }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    { let at_arg1 = v.len() as i64; add(&mut v, at_arg1) }; println("{}", v.len());
}
// EXPECT: 1
