// RULE: D2.7, D19.2
// (0.30.1, RT-33 round 2, F1) A closure whose body slices a captured `v:
// &mut [i64]` mutably, `v[..2].reverse()` or `v.reverse()`, writes the
// capture (closures/kinds.vl scan_body): FnMut, a unique borrow of v, which
// conflicts with a live `&v[..]`, rustc's E0502. Before, the closure was
// Fn, its capture shared, and a scoped thread holding r raced the writes.
// ERROR: error[borrowck.conflict]: cannot borrow 'v' as mutable because it is also borrowed as immutable
// ERROR: line 12, column 17
// ERROR-COUNT: 1
fn k(v: &mut [i64]) {
    let r: &[i64] = &v[..];
    let mut f = || v[..2].reverse();
    f();
    println("{}", r[0]);
}

fn main() {
    let mut a = [1i64, 2, 3];
    k(&mut a);
}
