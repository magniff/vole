// XFAIL: RT-220: a user `Index<RangeFrom<usize>>` on a temporary, `let t = &mkcr()[1usize..];`, is refused (borrowck.dropped_borrowed); rustc accepts. With `Index<usize>` it passes (0.30.2)
// Since v0.30.1 at least. From the review of the temporary-scope work.
// EXPECT: [42]
struct CR {
    v: [i64; 2],
}

impl std::ops::Index<std::ops::RangeFrom<usize>> for CR {
    type Output = [i64];

    fn index(&self, r: std::ops::RangeFrom<usize>) -> &[i64] {
        &self.v[r]
    }
}

fn mkcr() -> CR {
    CR { v: [41, 42] }
}

fn main() {
    let t = &mkcr()[1usize..];
    println("{:?}", t);
}
