// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter::sign_plus.
// EXPECT: None None None false true false false
use std::fmt::{Display, Formatter};

struct Spec;

impl Display for Spec {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "{:?} {:?} {:?} {} {} {} {}", f.width(), f.precision(), f.align(), f.alternate(),
            f.sign_plus(), f.sign_minus(), f.sign_aware_zero_pad())
    }
}

fn main() {
    println("{:+}", Spec);
}
