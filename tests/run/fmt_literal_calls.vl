use std::fmt::Display; #[derive(Clone, Copy)] struct P { a: i64, b: i64 }

fn show<T: Display>(x: &T) {
    println("<{}>", x);
}

fn len_ok(v: &[i64]) -> i64
    requires v.len() > 0 else "empty: {} items", v.len()
{
    v[0]
}

static mut LOG: i64 = 0;

fn note(k: i64) -> i64 {
    unsafe { LOG = LOG * 10 + k; }
    k
}

#[no_alloc]
fn check(x: i64) -> i64 {
    if x > 100 {
        panic("too big: {x} > {}", 100);
    }
    x
}

fn main(gpa: Gpa) {
    let p = P { a: 1, b: 2 };
    let t = format_in("{} {}", p.a, p.b, gpa);
    println("{}", str::from_utf8(t.as_bytes()).unwrap());
    let s = "a {plain} string";
    println("{}", s);
    show(&format_args("{} and {}", 1, "x"));
    let mut buf = String::new_in(gpa);
    std::fmt::write(&mut buf, "{}-{}", 3, 4).unwrap();
    println("{}", buf);
    assert(p.a == 1, "a is {}", p.a);
    println("{}", len_ok(&[5i64, 6]));
    println("{}", check(7));
    println("{1} {0}", "second", "first");
    println("{1} {0} {1}", note(1), note(2));
    println("[{y}] [{x}]", x = "a", y = "b");
    println("done");
    check(200);
}
