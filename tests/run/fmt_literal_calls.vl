// 0.26.2: format literals at each format position: format_in (the
// allocator last, a field as an argument), push_fmt, format_args (a value
// of Display for a function of the program), assert's message, a
// contract's `else "..", args`, panic from a #[no_alloc] function (the
// message formatted on the stack); arguments evaluated once each, left to
// right, whatever the holes' order; `println(s)` of a variable unchanged.
// EXPECT: 1 2
// EXPECT: a {plain} string
// EXPECT: <1 and x>
// EXPECT: 3-4
// EXPECT: 5
// EXPECT: 7
// EXPECT: first second
// EXPECT: 2 1 2
// EXPECT: [b] [a]
// EXPECT: done
// EXIT: 101
// STDERR: fmt_literal_calls.vl:41:9: too big: 200 > 100
struct P { a: i64, b: i64 }

fn show<T: Display>(x: T) {
    println("<{}>", x);
}

fn len_ok(v: [i64]) -> i64
    requires v.len() > 0 else "empty: {} items", v.len()
{
    v[0]
}

static var LOG: i64 = 0;

fn note(k: i64) -> i64 {
    LOG = LOG * 10 + k;
    k
}

#[no_alloc]
fn check(x: i64) -> i64 {
    if x > 100 {
        panic("too big: {x} > {}", 100);
    }
    x
}

fn main(gpa: Gpa) {
    let p = P { a: 1, b: 2 };
    let t = format_in("{} {}", p.a, p.b, gpa);
    println(t.as_slice());
    let s = "a {plain} string";
    println(s);
    show(format_args("{} and {}", 1, "x"));
    var buf = String::new_in(gpa);
    buf.push_fmt("{}-{}", 3, 4);
    println("{}", buf);
    assert(p.a == 1, "a is {}", p.a);
    println("{}", len_ok([5, 6]));
    println("{}", check(7));
    println("{1} {0}", "second", "first");
    println("{1} {0} {1}", note(1), note(2));
    println("[{y}] [{x}]", x = "a", y = "b");
    println("done");
    check(200);
}
