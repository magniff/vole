// (0.25) print, println, eprint, eprintln, format_in, format,
// to_string_in and writeln take their value as `let` (the methods
// Buf::push_fmt, String::push_fmt and Fmt::write still take it `sink`):
// it is still usable after printing.
// EXPECT: héllo
// EXPECT: héllohéllo
// EXPECT: P1
// EXPECT: P1
// EXPECT: P1héllo
// EXPECT: héllo
// EXPECT: 6
// STDERR: héllo
use std::alloc::Allocator; use std::fmt::Display; use std::fmt::Formatter as Fmt;
struct P<A: Allocator> { v: Vec<i64, A> }

impl Display for P<Gpa> {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result { write(f, "P{}", self.v.len())?; Ok(()) }
}

fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("héllo", gpa);
    println("{}", s);
    print("{}", s);
    println("{}", s);
    eprintln("{}", s);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let p = P { v: v };
    println("{}", p);
    println("{}", p);
    let mut out = String::new_in(gpa);
    std::fmt::write(&mut out, "{p}{s}").unwrap();
    println("{}", str::from_utf8(out.as_bytes()).unwrap());
    let b = format_in("{}", s, gpa);
    println("{}", str::from_utf8(b.as_bytes()).unwrap());
    println("{}", s.len());
    0
}
