// (0.30.1, review 8) A function whose parameter is a projection, `T::A`
// of the impl's or its own type parameter or `Self::A` of a trait impl,
// used as a value: the projection is read as a projection, never looked
// up as a path (round 8 said "unknown module 'T'"). Here each is i64, no
// reference, so the value needs nothing (rustc accepts each).
// EXPECT: 3
// EXPECT: 4
// EXPECT: 5
trait Tr {
    type A;
}

struct X;

impl Tr for X {
    type A = i64;
}

struct W<T> {
    t: T,
}

impl<T: Tr> W<T> {
    fn f(x: T::A) -> T::A {
        x
    }
}

fn g<T: Tr>(x: T::A) -> T::A {
    x
}

trait Ts {
    type B;
    fn h(x: Self::B) -> Self::B;
}

impl Ts for X {
    type B = i64;

    fn h(x: Self::B) -> Self::B {
        x
    }
}

fn main() {
    let f: fn(i64) -> i64 = W::<X>::f;
    println("{}", f(3));
    let g2: fn(i64) -> i64 = g::<X>;
    println("{}", g2(4));
    let h: fn(i64) -> i64 = X::h;
    println("{}", h(5));
}
