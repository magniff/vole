// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops RemAssign::rem_assign.
// EXPECT: V { x: 2 } 2
use std::ops::RemAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl RemAssign for V {
    fn rem_assign(&mut self, rhs: V) {
        self.x %= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.rem_assign(V { x: 5 });
    let mut n = 12i64;
    n.rem_assign(5);
    println("{:?} {}", a, n);
}
