// RULE: F19.7
// (0.30.2, RT-43) An assignment writes a union's field without reading
// it only up to the first deref (rustc E0133: its assignment_info ends at
// a Deref): `u.r.k = 9` reads u.r's bytes as the reference (here the
// integer 5), through a reference field, a reference in a Copy struct
// field, a tuple through a reference, a reference to a reference, and
// `&raw mut` through one. Each was accepted in safe code, a write through
// a pointer made of an integer.
// ERROR: reading a field of a union is unsafe
// ERROR: line 35, column 5
// ERROR: line 36, column 5
// ERROR: line 37, column 5
// ERROR: line 38, column 5
// ERROR: line 39, column 22
// ERROR-COUNT: 5
struct P {
    k: i64,
}

#[derive(Clone, Copy)]
struct S<'a> {
    r: &'a P,
}

union U<'a> {
    r: &'a mut P,
    s: S<'a>,
    t: &'a mut (i64, i64),
    rr: &'a mut &'a mut P,
    x: i64,
}

fn main() {
    let mut u = U { x: 5 };
    u.r.k = 9;
    u.s.r.k = 9;
    u.t.0 = 9;
    u.rr.k = 9;
    let w = &raw mut u.r.k;
    println("end");
}
