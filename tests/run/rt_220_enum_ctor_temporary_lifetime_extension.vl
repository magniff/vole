// XFAIL: RT-220: an enum variant's constructor does not extend the temporaries of its operands: `let o = Some(&&a);`, `E::One(&&a)`, `E::Two { r: &&a }`, `Ok(&&a)` are refused ("a temporary value is dropped at the end of its statement while it is still borrowed"); a tuple struct's `Q(&&a)` is accepted (0.30.2)
// rustc prints the EXPECT line (twin: r302d_039_enum_variant_does_not_extend_temporaries.rs.txt):
// a braced variant's field and (rustc 1.89 on) a tuple variant's argument are
// extending, like a struct's. vole: borrowck.dropped_borrowed at lines 19, 20, 21,
// 22; `Q(&&a)` (line 18), a tuple `(&&a, 1)`, an array `[&&a]` and a braced struct
// `P { r: &&a }` are extended (gc/te.vl). Since v0.28.0.
// EXPECT: 2 Some(2) One(2) Two { r: 2 } Ok(2)
#[derive(Debug)]
enum E<'a> {
    One(&'a &'a i64),
    Two { r: &'a &'a i64 },
}

struct Q<'a>(&'a &'a i64);

fn main() {
    let a = 2i64;
    let q = Q(&&a);
    let o = Some(&&a);
    let e = E::One(&&a);
    let f = E::Two { r: &&a };
    let r: Result<&&i64, ()> = Ok(&&a);
    println("{} {:?} {:?} {:?} {:?}", q.0, o, e, f, r);
}
