// sem-own (iterator stopgap): a named fn with a sink parameter given to map of w.iter(): its parameter is dropped in the fn, a bit copy of an element the Vec still owns. Expect own.move_out.
// ERROR: own.move_out
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn two(gpa: Gpa) -> Vec<D<Gpa>, Gpa> {
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn idof(d: sink D<Gpa>) -> i64 { d.id }
impl Clone for D<Gpa> { fn clone(self) -> D<Gpa> { D { id: self.id + 100, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let w = two(gpa);
    let s: i64 = w.iter().map(idof).sum();
    println("{s}");
}
