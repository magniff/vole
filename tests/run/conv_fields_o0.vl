// 0.20 T1 (at -O0, conv_fields at the suite's level): writes through accesses reach the caller's place: fields,
// nested fields, compound assignment, owned fields replaced (the old
// value dropped), pushes, through `inout` parameters, `inout self`, an
// `inout r = &x` local, generic instances (`x = v` for T = Vec), and access
// fields (`struct H { p: inout P }`).
// FLAGS: --syntax=0.20 -O0
// EXPECT: 6 15 15 1
// EXPECT: 8 28 2 7 set
// EXPECT: 40 30 3 0
// EXPECT: 9 1 1
// EXPECT: 1 2 0
// EXPECT: 15 2 7
// EXPECT: new
struct In<A: Allocator> { b: i64, w: Vec<i64, A> }
struct P<A: Allocator> { q: i64, a: In<A>, items: Vec<i64, A>, name: String<A> }

impl P<Gpa> {
    fn set(inout self, v: i64, gpa: Gpa) {
        self.q = v;
        self.q += 1;
        self.a.b = v * 2;
        self.a.b *= 2;
        self.items.push(v);
        self.a.w = Vec::new_in(gpa);
        self.a.w.push(v);
        self.name = String::new_in(gpa);
        self.name.push_str("set");
    }
}

fn upd(p: inout P<Gpa>, v: i64, gpa: Gpa) {
    p.q = v;
    p.q += 1;
    p.a.b = v * 3;
    p.items.push(v);
    p.items[0] += 10;
    p.a.w = Vec::new_in(gpa);
    p.a.w.push(1);
    p.name = String::new_in(gpa);
}

fn gen<T>(x: inout T, v: sink T) { x = v; }
fn gen_push<T>(x: inout Vec<T, Gpa>, v: sink T) { x.push(v); }

fn whole(p: inout P<Gpa>, gpa: Gpa) {
    p = P {
        q: 1, a: In { b: 2, w: Vec::new_in(gpa) }, items: Vec::new_in(gpa),
        name: String::new_in(gpa),
    };
}

fn main1(gpa: Gpa) {
    var p = P {
        q: 0, a: In { b: 0, w: Vec::new_in(gpa) }, items: Vec::new_in(gpa),
        name: String::new_in(gpa),
    };
    upd(&p, 5, gpa);
    println("{} {} {} {}", p.q, p.a.b, p.items[0], p.a.w.len());
    p.set(7, gpa);
    println("{} {} {} {} {}", p.q, p.a.b, p.items.len(), p.a.w[0], p.name.as_slice());
    inout r = &p;
    r.q = 40;
    r.a.b += 2;
    r.items.push(1);
    r.a.w = Vec::new_in(gpa);
    println("{} {} {} {}", p.q, p.a.b, p.items.len(), p.a.w.len());
    var n = 1;
    gen(&n, 9);
    var s: Vec<i64, Gpa> = Vec::new_in(gpa);
    s.push(3);
    var t: Vec<i64, Gpa> = Vec::new_in(gpa);
    gen(&s, t);
    gen_push(&s, 4);
    var bs: Vec<Vec<u8, Gpa>, Gpa> = Vec::new_in(gpa);
    gen_push(&bs, Vec::<u8, Gpa>::new_in(gpa));
    println("{n} {} {}", s.len(), bs.len());
    whole(&p, gpa);
    println("{} {} {}", p.q, p.a.b, p.items.len());
}

struct H<A: Allocator> { p: inout P2 < A >, n: inout i64 }
struct P2<A: Allocator> { q: i64, items: Vec<i64, A> }
fn work(h: inout H<Gpa>) { h.p.q += 5; h.p.items.push(3); }

fn main2(gpa: Gpa) {
    var p = P2 { q: 1, items: Vec::new_in(gpa) };
    var k = 0;
    var h = H { p: &p, n: &k };
    h.p.q = 10;
    h.p.items.push(2);
    work(&h);
    h.n = 7;
    println("{} {} {k}", p.q, p.items.len());
    more(gpa);
}

struct B<A: Allocator> { b: inout String<A> }
fn rebuf(x: inout B<Gpa>, gpa: Gpa) { x.b = String::new_in(gpa); x.b.push_str("new"); }

fn more(gpa: Gpa) {
    var buf = String::new_in(gpa);
    buf.push_str("old");
    var x = B { b: &buf };
    rebuf(&x, gpa);
    println(buf.as_slice());
}

fn main(gpa: Gpa) {
    main1(gpa);
    main2(gpa);
}
