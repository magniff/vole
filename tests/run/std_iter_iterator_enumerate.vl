// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::enumerate.
// EXPECT: [(0, 'a'), (1, 'b')]

fn main(gpa: Gpa) {
    let s = Vec::from_in(['a', 'b'], gpa);
    let a: Vec<(usize, char), Gpa> = s.iter().copied().enumerate().collect_in(gpa);
    println("{:?}", a);
}
