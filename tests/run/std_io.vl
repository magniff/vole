// EDITION: rust
// XFAIL: gap 2: compile type error: no 'path' in module 'std'
// FLAGS: --check-alloc
// ARGS: x yz
// EXPECT: 3 x yz 2
// EXPECT: true Err(NotPresent)
// EXPECT: true
// EXPECT: 20 "one\ntwo\r\nthree\nfour\n"
// EXPECT: 20 111
// EXPECT: <one><two><three><four>
// EXPECT: 4 5 "one\ntwo\r\n"
// EXPECT: 16 true false "0 0\n1 1\n2 4\nend\n"
// EXPECT: 5
// EXPECT: ["a", "w.txt"] 1
// EXPECT: true 21
// EXPECT: false false true
// EXPECT: false
// EXPECT: No such file or directory (os error 2) | NotFound | Some(2) | Os { code: 2, kind: NotFound, message: "No such file or directory" }
// EXPECT: invalid data Custom { kind: InvalidData, error: "invalid data" }
// EXPECT: Some("libfoo.so.1") Some("1") Some("libfoo.so") Some("/usr/lib") true
// EXPECT: Some("b") Some("a") true true true true false
// EXPECT: [/][a][b][c]
// EXPECT: /x true
// EXPECT: exit status: 3 false Some(3) "out\n" "err\n"
// EXPECT: true
// EXPECT: spawn: NotFound
// 0.20 (B6): std::fs, std::io, std::path, std::env and std::process:
// create_dir_all (twice), write/append/read_to_string_in/read_in,
// BufReader's lines_in and read_line, BufWriter with writeln (flushed when
// dropped), metadata, OpenOptions' append, Read::read_to_string, read_dir,
// rename, copy, remove_file, remove_dir_all, io::Error's Display and
// Debug, Path's parts and components, PathBuf's push/set_extension/pop,
// env::args/get_in/current_dir_in, Command's output_in and status (and a
// program that is not there).
use std::env; use std::fs; use std::io;
use std::fs::File; use std::fs::OpenOptions;
use std::io::BufReader; use std::io::BufWriter;
use std::path::Path; use std::path::PathBuf;
use std::process::Command; use std::process::Stdio;

fn files(dir: &PathBuf<Gpa>, gpa: Gpa) -> io::Result<()> {
    let sub = dir.join_in("a/b", gpa);
    fs::create_dir_all(str::from_utf8(sub).unwrap())?;
    fs::create_dir_all(str::from_utf8(sub).unwrap())?;
    let x = sub.join_in("x.txt", gpa);
    fs::write(str::from_utf8(x).unwrap(), "one\ntwo\r\nthree")?;
    std::fs::OpenOptions::new()
        .append(true)
        .create(true)
        .open(str::from_utf8(x).unwrap())
        .and_then(|mut f| std::io::Write::write_all(&mut f, "\nfour\n".as_ref()))?;
    let text = fs::read_to_string_in(str::from_utf8(x).unwrap(), gpa)?;
    println("{} {text:?}", text.len());
    let bytes = fs::read_in(str::from_utf8(x).unwrap(), gpa)?;
    println("{} {}", bytes.len(), bytes[0]);
    let r = BufReader::new(File::open(str::from_utf8(x).unwrap())?);
    for line in r.lines_in(gpa) {
        let line = line?;
        print("<{line}>");
    }
    println("");
    let mut r2 = BufReader::new(File::open(str::from_utf8(x).unwrap())?);
    let mut s = String::new_in(gpa);
    let n1 = r2.read_line(&mut s).map(|n| n as i64)?;
    let n2 = r2.read_line(&mut s).map(|n| n as i64)?;
    println("{n1} {n2} {s:?}");
    let w_path = dir.join_in("w.txt", gpa);
    {
        let mut w = BufWriter::new(File::create(str::from_utf8(w_path).unwrap())?);
        for i in 0..3 {
            writeln(&mut w, format_args("{i} {}", i * i))?;
        }
        w.write_all("end\n")?;
    }
    let m = fs::metadata(str::from_utf8(w_path).unwrap())?;
    let wtext = fs::read_to_string_in(str::from_utf8(w_path).unwrap(), gpa)?;
    println("{} {} {} {wtext:?}", m.len(), m.is_file(), m.is_dir());
    let mut f = OpenOptions::new().append(true).open(str::from_utf8(w_path).unwrap())?;
    f.write_all("more\n")?;
    let mut back = String::new_in(gpa);
    let mut rf = File::open(str::from_utf8(w_path).unwrap())?;
    rf.read_to_string(&mut back)?;
    println("{}", back.lines().count());
    let mut names: Vec<&str, Gpa> = Vec::new_in(gpa);
    let mut kinds: i64 = 0;
    let mut list = fs::read_dir(str::from_utf8(dir).unwrap())?;
    let mut keep: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    for e in list {
        let e = e?;
        keep.push(e.file_name().to_str().unwrap().to_string_in(gpa));
        if e.file_type().map(|t| t.is_dir()).unwrap_or(false) {
            kinds += 1;
        }
    }
    keep.sort_unstable();
    println("{keep:?} {kinds}");
    let w2 = dir.join_in("w2.txt", gpa);
    fs::rename(str::from_utf8(w_path).unwrap(), str::from_utf8(w2).unwrap())?;
    let n = std::fs::copy(str::from_utf8(w2).unwrap(), str::from_utf8(w_path).unwrap()).map(
        |n| n as i64)?;
    println("{} {n}", std::fs::exists(str::from_utf8(w_path).unwrap()).unwrap_or(false));
    fs::remove_file(str::from_utf8(w_path).unwrap())?;
    println("{} {} {}", std::fs::exists(str::from_utf8(w_path).unwrap()).unwrap_or(false),
        w_path.as_path().exists(), w2.as_path().is_file());
    fs::remove_dir_all(str::from_utf8(dir).unwrap())?;
    println("{}", std::fs::exists(str::from_utf8(dir).unwrap()).unwrap_or(false));
    Ok(())
}

fn errors() {
    match File::open("/nonexistent-dir-vole/x") {
        Ok(_) => println("??"),
        Err(e) => println("{e} | {:?} | {:?} | {e:?}", e.kind(), e.raw_os_error()),
    }
    let e = io::Error::from(io::ErrorKind::InvalidData);
    println("{e} {e:?}");
}

fn paths(gpa: Gpa) {
    let q = Path::new("/usr/lib/libfoo.so.1");
    println(
        "{:?} {:?} {:?} {:?} {}", q.file_name(), q.extension(), q.file_stem(), q.parent(),
        q.is_absolute());
    let r: Path = "a/b/";
    let s1 = r.starts_with("a");
    let s2 = r.starts_with("a/b");
    let s3 = r.starts_with("a/");
    let s4 = Path::new("ab").starts_with("a");
    println("{:?} {:?} {} {s1} {s2} {s3} {s4}", r.file_name(), r.parent(), r.is_relative());
    for c in Path::new("/a//b/./c/").components() {
        print("[{c}]");
    }
    println("");
    let mut p = PathBuf::from_in("/x", gpa);
    p.push("y.tar");
    p.set_extension("gz");
    let popped = p.pop();
    println("{p} {popped}");
}

fn processes(gpa: Gpa) -> io::Result<()> {
    let mut c = std::process::Command::new_in("sh", gpa);
    c.arg("-c");
    c.arg("echo out; echo err >&2; exit 3");
    let o = c.output_in(gpa)?;
    let out = String::from_utf8(o.stdout).unwrap();
    let err = String::from_utf8(o.stderr).unwrap();
    println("{} {} {:?} {out:?} {err:?}", o.status, o.status.success(), o.status.code());
    let mut t = std::process::Command::new_in("true", gpa);
    t.stdout(Stdio::null());
    println("{}", t.status()?.success());
    let mut missing = std::process::Command::new_in("/nonexistent/program", gpa);
    match missing.output_in(gpa) {
        Ok(o) => println("exit {:?}", o.status.code()),
        Err(e) => println("spawn: {:?}", e.kind()),
    }
    Ok(())
}

fn main(gpa: Gpa) {
    let args: Vec<&str, Gpa> = env::args().collect_in(gpa);
    println("{} {} {} {}", args.len(), args[1], args[2], env::args().skip(1usize).count());
    let home = std::env::var_in("HOME", gpa);
    let none = std::env::var_in("VOLE_NO_SUCH_VAR", gpa);
    println("{} {none:?}", home.is_ok());
    let cwd = std::env::current_dir_in(gpa).ok().unwrap();
    println("{}", cwd.as_path().is_absolute());
    let name = format_in(format_args("/tmp/vole-std-io-{}", (std::process::id() as i32)), gpa);
    let dir = PathBuf::from_in(name.as_bytes(), gpa);
    match files(&dir, gpa) {
        Ok(_) => {}
        Err(e) => println("files: {e}"),
    }
    errors();
    paths(gpa);
    match processes(gpa) {
        Ok(_) => {}
        Err(e) => println("processes: {e}"),
    }
}
