// rustc builds it and prints the EXPECT lines. vole: `places/regions.vl:1342:16:
// index out of bounds: index 3, length 3` and no binary (check, build, every
// -O). The same panic site as RT-44 (a closure in a generic Drop impl), here
// in a non-generic main through std's flat_map: a closure returning an
// iterator that holds a closure (map, filter), moved or not. The two
// closures in sequence (`map(|y| v.iter().map(..).sum())`) or a closure
// returning a closure of an i64 are fine.
// EXPECT: 90
// EXPECT: 4
fn main() {
    let w = [10i64, 20];
    let v = [1i64, 2];
    let s: i64 = w.iter().flat_map(|y| v.iter().map(move |x| x * y)).sum();
    println("{s}");
    let t: i64 = w.iter().flat_map(|_y| v.iter().filter(|x| **x > 1)).sum();
    println("{t}");
}
