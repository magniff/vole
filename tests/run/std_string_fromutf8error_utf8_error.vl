// Runs on std since 0.27.2's switch.
// The std item(s): std::string FromUtf8Error::utf8_error.
// EXPECT: 2 Some(1)

fn main(gpa: Gpa) {
    let r = String::from_utf8(Vec::from_in([97u8, 98, 255], gpa));
    if let Err(e) = r {
        let u = e.utf8_error();
        println("{} {:?}", u.valid_up_to(), u.error_len());
    }
}
