// RULE: D2.7
// (0.27.2) A `mut` local's field, a `&mut` parameter's, a `&mut [i64]`'s element.
struct S {
    n: i64,
}

impl S {
    fn bump(&mut self) {
        self.n += 1;
    }
}

fn set(s: &mut S, v: &mut [i64]) {
    s.n = 5;
    v[0] = 7;
}

fn main() {
    let mut a = S { n: 1 };
    a.n = 2;
    a.bump();
    let mut b = [0i64, 1];
    set(&mut a, &mut b[..]);
    println("{} {}", a.n, b[0]);
}
// EXPECT: 5 7
