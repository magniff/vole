// RT-STD-3 (fixed in 0.30.1): integer pow and abs never panic on overflow at -O0, where the guide says they do
// The abs half of RT-STD-3: `i64::MIN.abs()` gives i64::MIN at -O0 (and
// `i32::MIN.abs()` i32::MIN). Rust's debug build: "attempt to negate with
// overflow".
// FLAGS: -O0
// EXPECT: before
// EXIT: 101
// STDERR: attempt to negate with overflow

fn main() -> i32 {
    let k = std::env::args().count() as i64;
    let x: i64 = -9223372036854775807 - k;
    println("before");
    println("{}", x.abs());
    0
}
