// EDITION: rust
// x as i8 is negative for 200.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551560, length 128
static mut Z: i64 = 0;

#[inline(never)]
fn f(a: [i64; 128], x: i64) -> i64 { a[x as i8 as usize] }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(big, 200 + unsafe { Z }));
    0
}
