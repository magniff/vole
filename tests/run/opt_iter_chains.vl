// 0.30: chains of std's adapters over `next` are the loops written by
// hand. A slice iterator's loop (`n != 0`, n - 1 and the pointer a round)
// gets a counter from 0 and its pointer becomes `base + 8 * c`
// (exits.vl: express_ivs); the loop of `filter`'s `find`, which repeats
// its outer loop's test, becomes part of that loop (unnest_loop) and its
// branch a select; `max`'s `a.cmp(&b).is_gt()` is one comparison
// (ifconv.vl: or_of_comparisons); the checks of `rev`'s `split_last` go
// (range: x - 1 < x when x is not zero); each level of a chain waits with
// its loop passes until it is in its caller (inline.vl:
// moved_into_caller). Every chain against its hand loop on every length
// from 0 to 40: `same` counts the lengths where all agree.
// EXPECT: same 41 of 41
// EXPECT: 18422 468 529 -427 13920 -282 1764 888 620 18422
// EXPECT: nested 2074 2074 868 868
// (callc rt.panic is a failed check, not a call of std)
// CHECK: fn filter_map_sum:
// CHECK-NOT: call
// CHECK: sel
// CHECK: +24
// CHECK-NOT: call
// CHECK: fn filter_count:
// CHECK-NOT: call
// CHECK: v2i64 = load
// CHECK-NOT: call
// CHECK: fn map_max:
// CHECK-NOT: call
// CHECK: v2i64 = load
// CHECK-NOT: call
// CHECK: fn map_min:
// CHECK-NOT: call
// CHECK: v2i64 = load
// CHECK-NOT: call
// CHECK: fn enumerate_sum:
// CHECK-NOT: call
// CHECK: +24
// CHECK-NOT: call
// CHECK: fn zip_dot:
// CHECK-NOT: call
// CHECK: +24
// CHECK-NOT: call
// CHECK: fn rev_sum:
// CHECK-NOT: call
// CHECK: +24
// CHECK-NOT: call
// CHECK: fn take_while_sum:
// CHECK-NOT: call
// CHECK: fn for_filter:
// CHECK-NOT: call
// CHECK: v2i64 = load
// CHECK-NOT: call
// CHECK: fn hand_filter_map_sum:
// CHECK: sel
// CHECK: +24
// CHECK: fn main:
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

#[inline(never)]
fn filter_map_sum(s: &[i64], r: i64) -> i64 {
    s.iter().copied().filter(|x| *x & 1 == 0).map(|x| x * x + r).sum::<i64>()
}

#[inline(never)]
fn filter_count(s: &[i64], r: i64) -> i64 {
    s.iter().filter(|x| **x > r).count() as i64
}

#[inline(never)]
fn map_max(s: &[i64], r: i64) -> i64 {
    s.iter().map(|x| *x ^ r).max().unwrap_or(-1)
}

#[inline(never)]
fn map_min(s: &[i64], r: i64) -> i64 {
    s.iter().map(|x| *x ^ r).min().unwrap_or(-1)
}

#[inline(never)]
fn enumerate_sum(s: &[i64], r: i64) -> i64 {
    s.iter().enumerate().map(|(i, x)| i as i64 * *x + r).sum::<i64>()
}

#[inline(never)]
fn zip_dot(a: &[i64], b: &[i64]) -> i64 {
    a.iter().zip(b.iter()).map(|(x, y)| *x * *y).sum::<i64>()
}

#[inline(never)]
fn rev_sum(s: &[i64], r: i64) -> i64 {
    s.iter().rev().map(|x| *x ^ r).sum::<i64>()
}

// An early exit: no vector loop, but no call and no frame slot.
#[inline(never)]
fn take_while_sum(s: &[i64], r: i64) -> i64 {
    s.iter().take_while(|x| **x != r).map(|x| *x + 1).sum::<i64>()
}

// `for` over a filter: `next`, the loop of `find` inside the `for`.
#[inline(never)]
fn for_filter(s: &[i64], r: i64) -> i64 {
    let mut t: i64 = 0;
    for x in s.iter().filter(|x| **x & 3 != 0) {
        t += *x ^ r;
    }
    t
}

#[inline(never)]
fn hand_filter_map_sum(s: &[i64], r: i64) -> i64 {
    let mut t: i64 = 0;
    for &x in s {
        if x & 1 == 0 {
            t += x * x + r;
        }
    }
    t
}

fn hand_filter_count(s: &[i64], r: i64) -> i64 {
    let mut c: i64 = 0;
    for k in 0..s.len() {
        if s[k] > r {
            c += 1;
        }
    }
    c
}

fn hand_max(s: &[i64], r: i64) -> i64 {
    if s.len() == 0 {
        return -1;
    }
    let mut m = s[0] ^ r;
    for k in 1..s.len() {
        if (s[k] ^ r) >= m {
            m = s[k] ^ r;
        }
    }
    m
}

fn hand_min(s: &[i64], r: i64) -> i64 {
    if s.len() == 0 {
        return -1;
    }
    let mut m = s[0] ^ r;
    for k in 1..s.len() {
        if (s[k] ^ r) < m {
            m = s[k] ^ r;
        }
    }
    m
}

fn hand_enumerate_sum(s: &[i64], r: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..s.len() {
        t += k as i64 * s[k] + r;
    }
    t
}

fn hand_zip_dot(a: &[i64], b: &[i64]) -> i64 {
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    let mut t: i64 = 0;
    for k in 0..n {
        t += a[k] * b[k];
    }
    t
}

fn hand_rev_sum(s: &[i64], r: i64) -> i64 {
    let mut t: i64 = 0;
    let mut k = s.len();
    while k > 0 {
        k -= 1;
        t += s[k] ^ r;
    }
    t
}

fn hand_take_while_sum(s: &[i64], r: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..s.len() {
        if s[k] == r {
            break;
        }
        t += s[k] + 1;
    }
    t
}

fn hand_for_filter(s: &[i64], r: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..s.len() {
        if s[k] & 3 != 0 {
            t += s[k] ^ r;
        }
    }
    t
}

// Loops that must stay nested: the inner loop repeats the outer test,
// but what the outer round began with is read after it.

// `first` is the position the outer round began at.
#[inline(never)]
fn runs(s: &[i64]) -> i64 {
    let mut i: usize = 0;
    let mut t: i64 = 0;
    while i != s.len() {
        let first = i;
        while i != s.len() {
            if s[i] < 0 {
                break;
            }
            i += 1;
        }
        t += (i - first) as i64 * (i - first) as i64;
        if i != s.len() {
            i += 1;
        }
    }
    t
}

fn runs_plain(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    let mut run: i64 = 0;
    for k in 0..s.len() {
        if s[k] < 0 {
            t += run * run;
            run = 0;
        } else {
            run += 1;
        }
    }
    t + run * run
}

// The inner loop's last test is the outer loop's (nothing left: leave
// both), so it would be part of the outer loop; but `before`, what was
// left when the outer round began, is read after it.
#[inline(never)]
fn stops(s: &[i64]) -> i64 {
    let mut left = s.len();
    let mut t: i64 = 0;
    'outer: while left != 0 {
        let before = left;
        loop {
            left -= 1;
            if s[left] & 1 == 0 {
                break;
            }
            if left == 0 {
                break 'outer;
            }
        }
        t += (before - left) as i64 * s[left];
    }
    t
}

// The same without it: one loop.
#[inline(never)]
fn evens(s: &[i64]) -> i64 {
    let mut left = s.len();
    let mut t: i64 = 0;
    'outer: while left != 0 {
        loop {
            left -= 1;
            if s[left] & 1 == 0 {
                break;
            }
            if left == 0 {
                break 'outer;
            }
        }
        t += s[left] + 100;
    }
    t
}

fn evens_plain(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for k in 0..s.len() {
        if s[k] & 1 == 0 {
            t += s[k] + 100;
        }
    }
    t
}

fn stops_plain(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    let mut k = s.len();
    let mut before = k;
    while k > 0 {
        k -= 1;
        if s[k] & 1 == 0 {
            t += (before - k) as i64 * s[k];
            before = k;
        }
    }
    t
}

fn main() -> i32 {
    let mut a = [0i64; 40];
    let mut b = [0i64; 40];
    for i in 0..40 {
        a[i] = (i as i64 * 37 + 11) % 23 - 9;
        b[i] = i as i64 % 5 - 2;
    }
    let mut same: i64 = 0;
    let mut total = [0i64; 10];
    let mut nested = [0i64; 4];
    for n in 0..41 {
        let s = &a[..n];
        let t = &b[..n];
        let got = [
            filter_map_sum(s, 3),
            filter_count(s, 0),
            map_max(s, 5),
            map_min(s, 5),
            enumerate_sum(s, 1),
            zip_dot(s, t),
            rev_sum(s, 7),
            take_while_sum(s, 13),
            for_filter(s, 6),
            hand_filter_map_sum(s, 3),
        ];
        let want = [
            hand_filter_map_sum(s, 3),
            hand_filter_count(s, 0),
            hand_max(s, 5),
            hand_min(s, 5),
            hand_enumerate_sum(s, 1),
            hand_zip_dot(s, t),
            hand_rev_sum(s, 7),
            hand_take_while_sum(s, 13),
            hand_for_filter(s, 6),
            filter_map_sum(s, 3),
        ];
        let mut ok = true;
        for k in 0..10 {
            if got[k] != want[k] {
                ok = false;
            }
            total[k] += got[k] % 1000;
        }
        if runs(s) != runs_plain(s) || stops(s) != stops_plain(s) || evens(s) != evens_plain(s) {
            ok = false;
        }
        if n == 40 || n == 17 {
            nested[if n == 40 { 0 } else { 2 }] = stops(s) + evens(s);
            nested[if n == 40 { 1 } else { 3 }] = stops_plain(s) + evens_plain(s);
        }
        if ok {
            same += 1;
        }
    }
    unsafe {
        printf(c"same %ld of 41\n", same);
        printf(c"%ld %ld %ld %ld %ld %ld %ld %ld %ld %ld\n", total[0], total[1], total[2],
            total[3], total[4], total[5], total[6], total[7], total[8], total[9]);
        printf(c"nested %ld %ld %ld %ld\n", nested[0], nested[1], nested[2], nested[3]);
    }
    0
}
