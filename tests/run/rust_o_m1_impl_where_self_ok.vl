// An impl's where clause naming Self.
// (Review of the obligation engine's M1: v0.30.1 built it; the selection gave 'unknown type Self')
trait Conv<X> {}
trait Tr<U> { fn f(&self) -> i64; }
struct W { r: i64 }
impl Conv<W> for i64 {}
impl<U> Tr<U> for W where U: Conv<Self> { fn f(&self) -> i64 { 1 } }
fn need<T: Tr<i64>>(t: &T) -> i64 { t.f() }
fn main() { println("{}", need(&W { r: 0 })); }
