// (0.30.1, review 3) An inner loop's own labelled break is not the outer
// loop's value: `'i: loop { break 'i a + a; }` gives y, the outer loop's
// value is the literal of `break 'o 1` (rustc accepts: y i32, s i64).
// EXPECT: 2
// EXPECT: 1
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 1;
    let s = 'o: loop {
        let y: i32 = 'i: loop {
            break 'i a + a;
        };
        println("{}", y);
        break 'o 1;
    };
    println("{}", take(s));
}
