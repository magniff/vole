// EXPECT: ["e\u{301}", "\r\n", "🇫🇷", "a"]
// RUSTC: none (vole's addition: graphemes)
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "e\u{301}\r\n🇫🇷a".graphemes(true).collect_in(gpa);
    println("{:?}", v);
}
