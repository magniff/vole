// EDITION: rust
// RULE: D10.3
// (0.27.1) A closure capturing `x` after the `&mut x` is dead.

fn main() {
    let mut x: i64 = 1;
    let r = &mut x;
    *r += 1;
    let f = || x + 1;
    println("{}", f());
}
// EXPECT: 3
