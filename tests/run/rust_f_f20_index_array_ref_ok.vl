// EDITION: rust
// RULE: F20.1
// (0.27.4) `h[i]` of an `h: &mut [T; N]` (or `&[T; N]`, `&&[T; N]`) is
// `(*h)[i]`, the element through the reference, as rustc's autoderef,
// read, written and sliced; 0.27.3 took it for a raw pointer's arithmetic.
// EXPECT: 3 12 [3, 2, 5, 4, 0, 0, 7, 8]
// EXPECT: 2 2
fn bump(h: &mut [u32; 8]) {
    let a = h[1];
    h[0] += a;
    h[2] = h[3] + 1;
    for x in h[4..6].iter_mut() {
        *x = 0;
    }
}

fn sum(h: &[u32; 8]) -> u32 {
    let s: &[u32] = &h[1..3];
    h[0] + s[0] + s[1] + s.len() as u32
}

fn count(counts: &mut [i64; 11], k: usize) {
    counts[k] += 1;
}

fn main() {
    let mut h: [u32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    bump(&mut h);
    println("{} {} {:?}", h[0], sum(&h), h);
    let mut c = [0i64; 11];
    count(&mut c, 3);
    count(&mut c, 3);
    let r = &&c;
    println("{} {}", c[3], r[3]);
}
