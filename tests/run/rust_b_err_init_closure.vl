struct P {
    a: i64,
    b: &'static i64,
}

impl P {
    fn get(&self) -> i64 {
        self.a + *self.b
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

struct Q {
    r: i64,
    s: i64,
}

struct O {
    q: Q,
    z: i64,
}

union U {
    x: i64,
    y: u32,
}

static THREE: i64 = 3;

fn cl() {
    let mut p: P;
    p.a = 1;
    let f = || p.a + *p.b;
    println("{}", f());
}

fn cl_read(c: bool) {
    let p: P;
    if c {
        p = P { a: 1, b: &THREE };
    }
    let f = || *p.b;
    println("{}", f());
}

fn main() {
    cl();
    cl_read(true);
}
