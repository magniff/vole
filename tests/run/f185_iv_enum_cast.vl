// RULE: F18.5
// (0.30.2) An integer literal's value cast to a fieldless enum is checked
// as any integer's (vole's `n as E`, a match on the discriminants), in the
// type a later use gives the variable: `n` is the i64 `take` makes it, 1
// is High; 7 has no variant: the run-time error.
// EXPECT: 1
// STDERR: invalid value 7 for enum Level
// EXIT: 101
enum Level {
    Low,
    High,
}

fn take(x: i64) -> i64 {
    x
}

fn main() -> i32 {
    let n = 1;
    let e = n as Level;
    take(n);
    println("{}", e as i64);
    let k = 7;
    let f = k as Level;
    println("{}", f as i64);
    0
}
