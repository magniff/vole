// 0.25: own.moved's help and try: lines. The try: is a line of its own
// (not joined onto the help), `.clone()` is offered only for a type with
// Clone, and a sink closure's capture is named as such, with no `.clone()`
// wrapped around the closure.
// ERROR: error[borrowck.use_moved]
// ERROR: line 20, column 19
// ERROR:   = try:
// ERROR: error[borrowck.use_moved]
// ERROR: line 23, column 19
// ERROR: error[borrowck.use_moved]
// ERROR: line 27, column 19
// ERROR-COUNT: 3
use std::alloc::Allocator; struct Tok<A: Allocator> { v: Vec<i64, A> }
fn eat(t: Tok<Gpa>) -> i64 { t.v.len() as i64 }
fn eat_vec(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }

fn main(gpa: Gpa) -> i32 {
    let mut s: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{}", eat_vec(s));
    println("{}", s.len());
    let mut names: Vec<i64, Gpa> = Vec::new_in(gpa);
    let f = move || names.len();
    println("{}", names.len());
    println("{}", f());
    let t = Tok { v: Vec::new_in(gpa) };
    println("{}", eat(t));
    println("{}", t.v.len());
    0
}
