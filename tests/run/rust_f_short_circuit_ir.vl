// EDITION: rust
// (0.28.0) A condition's `&&` and `||` are control flow: a branch on each
// operand, no bool merged in a phi and then branched on. 0.27.8's rust
// edition made the bool first, a phi and a branch the optimizer did not
// thread, at every `if` and `while` with `&&` (about 12% of the flipped
// compiler's self-build); MVS's lowering branched.
// EXPECT: 141
// CHECK: fn f:
// CHECK-NOT: phi
// CHECK: ret
// CHECK: fn g:
// CHECK-NOT: phi
// CHECK: ret
#[inline(never)]
fn f(a: i64, b: i64) -> i64 {
    if a != 0 && b > 3 {
        return 7;
    }
    9
}

#[inline(never)]
fn g(a: i64, b: i64) -> i64 {
    if a == 0 || !(b < 3 || b > 6) {
        return 5;
    }
    8
}

fn main() {
    let mut s: i64 = 0;
    for i in 0..10 {
        s += f(i % 3, i);
        s += g(i % 2, i);
    }
    println("{}", s);
}
