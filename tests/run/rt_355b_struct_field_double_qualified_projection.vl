// XFAIL: RT-355: a struct field typed `<<S as A>::Out as B>::Out` does not parse ("expected type, got '<<'"); rustc accepts (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 4
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: u32;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: u32 = 2;
    fn make() -> i64 {
        40
    }
}

fn id<T>(t: T) -> T {
    t
}

fn sz<T>() -> i64 {
    7
}
struct H {
    e: <<S as A>::Out as B>::E,
}

fn main() {
    let h = H { e: 4 };
    println("{}", h.e);
}
