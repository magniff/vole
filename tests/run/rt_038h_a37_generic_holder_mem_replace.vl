// Over-refusal probe: a generic holder; the clause swaps two locals of its own with mem::replace.
use std::mem;

fn f<T: Copy>(t: T, n: i64) -> T
    requires {
    let mut a = n;
    let b = mem::replace(&mut a, 5);
    a == 5 && b == n
}

{
    t
}

fn main() {
    println("{}", f(7u8, 3));
}
