// RULE: D4.6
// (0.27.6) `J::Item` with J = Skip<Split<char>> is Skip's `type Item =
// I::Item`, normalized again through Skip's header: Split's `&'a str`,
// a borrow of the text, not of `*it`. Two `pass(&mut it)` items live
// together are no conflict (0.27.5 read the inner projection as elided,
// tied to `&mut J`: borrowck.mut_twice).
// EXPECT: Some("b") Some("c") None
fn pass<J: Iterator>(it: &mut J) -> Option<J::Item> {
    it.next()
}

fn main() {
    let s = "a,b,c";
    let mut it = s.split(',').skip(1);
    let a = pass(&mut it);
    let b = pass(&mut it);
    let c = pass(&mut it);
    println("{:?} {:?} {:?}", a, b, c);
}
