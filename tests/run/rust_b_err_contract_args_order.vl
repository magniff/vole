// RULE: D7.4
// (0.30.1) A call checked by a `requires` evaluates its arguments once,
// in order, as a call without one: an argument that is a local or
// `&place` is no longer read again at the call after the later arguments
// ran. So `f(&x, { x = 7; 2 })` is rustc's E0506, and
// `Vec::insert(&mut v, 0, { v.clear(); 0 })` (an explicit `&mut`, no
// autoref, so not two-phase) is rustc's E0499, as `Vec::push(&mut v, ..)`
// is without a contract. Before, both were accepted.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 22, column 21
// ERROR: error[borrowck.mut_twice]
// ERROR: line 25, column 30
// ERROR-COUNT: 2
fn f(x: &usize, k: usize) -> usize
    requires k < 100
{
    *x * 10 + k
}

fn main(gpa: Gpa) {
    let mut x = 1;
    let r = f(&x, { x = 7; 2 });
    let mut v: Vec<usize, Gpa> = Vec::new_in(gpa);
    v.push(1);
    Vec::insert(&mut v, 0, { v.clear(); 0 });
    println("{} {} {:?}", r, x, v);
}
