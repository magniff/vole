// XFAIL: RT-423b: (R302I-6's mechanism, array lengths in types) a struct field `b: [u8; f(1)]` and a type alias `type A = [u8; f(3)];` with `const fn f(x: usize) -> usize` are refused with "function 'f' expects 0 arguments, got 1" (its help shows the one-parameter signature); rustc accepts (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). vole reports 2 errors, at
// lines 14 and 17. v0.28.0 to v0.30.1 the same. As for an enum's
// discriminant, a type's array length is evaluated while the types are
// collected, before the fns' signatures are entered. (`[7u8; f(4)]` in a
// body and `[i64; N]` with `const N: usize = f(2);` are RT-194/RT-119's
// "not a compile-time value yet".)
// EXPECT: 2 6
const fn f(x: usize) -> usize {
    x * 2
}

struct S {
    b: [u8; f(1)],
}

type A = [u8; f(3)];

fn main() {
    let s = S { b: [1; 2] };
    let t: A = [0; 6];
    println("{} {}", s.b.len(), t.len());
}
