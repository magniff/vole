// (0.25) An array of structs with an inout field is move-only.
struct C<'a> { n: &'a mut i64 }

fn main() {
    let mut x: i64 = 1; let mut y: i64 = 2; let a = [C { n: &mut x }, C { n: &mut y }]; let b = a;
    *b[0].n += 1; *a[0].n += 1;
    println("{x}");
}
