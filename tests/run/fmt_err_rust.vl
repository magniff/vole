// Rust's formatting (0.15; 0.26.2: a format literal): each macro's help
// is the call without its `!`, written out; `fmt(&self, f: &mut
// Formatter)` gets vole's Display and Debug signatures.
// ERROR: 'println!' is a macro call: vole has no macros
// ERROR: help: write `println("{} = {:>4}, {:?} {name}", a, a * 2, v)`
// ERROR: 'format!' is a macro call
// ERROR: help: write `format_in("{}-{}{{}}", a, b::c, gpa)`
// ERROR: 'eprint!' is a macro call
// ERROR: help: write `eprint("{1:?}{0}", a, v)`
// ERROR: expected identifier, got '&'
// ERROR: help: Display and Debug in vole: `fn fmt(self, f: inout std::Fmt)`
// ERROR: 'writeln!' is a macro call
// ERROR: help: write `f.write("P({}, {})\n", p.x, if a { 1 } else { 2 })`
// ERROR: 'print!' is a macro call
// ERROR: help: the call without its `!` takes a format string: `println("x = {x}, v = {:?}", v)`
// ERROR-COUNT: 6
struct P { x: i64 }

fn main() {
    let a = 1;
    let v = 2;
    println !("{} = {:>4}, {:#?} {name}", a, a * 2, v);
    let s = format !("{}-{}{{}}", a, b::c);
    eprint !("{1:?}{0}", a, v);
}

impl std::Display for P {
    fn fmt(&self, f: &std::fmt::Formatter) -> std::fmt::Result {
        write !(f, "P({})", self.x)
    }
}

fn show(f: *std::Fmt, p: P, a: bool) {
    writeln !(f, "P({}, {})", p.x, if a { 1 } else { 2 });
}

fn other() {
    print !(some_text);
}
