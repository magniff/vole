// RULE: F8.2
// RT-159: more forms. A path call `T0::m(arg)` takes Self from the
// argument as written: `T0::f(&s)` of `f(self)` is `<&S as T0>::f` (no
// impl: rustc E0277), `T0::g(s)` of `g(&mut self)` and `T0::h(b)` of
// `h(&self)` with `b: Box<S>` are E0308, `T0::f(b)` is `<Box<S> as
// T0>::f` (E0277). 0.30.1 adjusted each argument as a method receiver and
// built all four. The forms the case rt_159_ufcs_arg_adjusted_like_receiver
// has not.
// ERROR: line 33
// ERROR-COUNT: 4
trait T0 {
    fn f(self) -> i64;
    fn g(&mut self) -> i64;
    fn h(&self) -> i64;
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl T0 for S {
    fn f(self) -> i64 { self.k }
    fn g(&mut self) -> i64 { self.k += 1; self.k }
    fn h(&self) -> i64 { self.k * 10 }
}

fn main(gpa: Gpa) {
    let mut s = S { k: 1 };
    let b = Box::new_in(s, gpa);
    let c = Box::new_in(s, gpa);
    println("{}", T0::f(&s));
    println("{}", T0::g(s));
    println("{}", T0::h(b));
    println("{}", T0::f(c));
}
