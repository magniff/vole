// RUSTC: none contract clauses are not Rust
// EXPECT: 7
// Over-refusal probe: a holder returning impl Trait; the clause iterates its own array.
fn f(n: i64) -> impl Fn(i64) -> i64
    requires {
    let a = [1i64, 2];
    let mut s = 0i64;
    for x in a.iter() { s += *x; }
    s == 3 && n > 0
}

{
    move |x| x + n
}

fn main() {
    println("{}", f(3)(4));
}
