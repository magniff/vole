// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::repeat_in.
// EXPECT: abcabcabc "" 9
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "abc".repeat_in(3, gpa);
    let e = "abc".repeat_in(0, gpa);
    println("{} {:?} {}", s, e.as_str(), s.len());
}
