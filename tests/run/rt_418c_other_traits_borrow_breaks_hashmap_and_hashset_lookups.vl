// XFAIL: RT-418c: (R302I-1's mechanism through Borrow) with a program trait OtherBorrow whose `borrow(&self) -> &K` returns another key, HashMap<K, _> and HashSet<K> lookups take OtherBorrow::borrow for std's `Borrow<Q>` in find: `hm.get(&k)` is None and `hs.contains(&k)` false for keys that are in them (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). vole prints `2 None None 2
// Some(1) Some(4) 2 false` at -O0 and -O2; v0.28.0 (with `use
// std::hash::FixedState;`) to v0.30.1 the same. BTreeMap's get is right.
// With OtherBorrow's `borrow` typed `&str` and an `impl Borrow<str> for K`
// beside it, `hm.insert(..)` fails inside std instead: "<std>: expected
// '&K', got '&str' in instantiation of HashMap::find<K>" (scratch
// a1/o11.vl); without OtherBorrow that program is right (a1/o12.vl).
// EXPECT: 2 Some(2) Some(3) 2 Some(1) Some(4) 2 true
use std::collections::{BTreeMap, HashMap, HashSet};

#[derive(PartialEq, Eq, Hash, PartialOrd, Ord, Debug)]
struct K {
    s: &'static str,
}

static ZK: K = K { s: "zzz" };

trait OtherBorrow {
    fn borrow(&self) -> &K;
}

impl OtherBorrow for K {
    fn borrow(&self) -> &K {
        &ZK
    }
}

fn main(gpa: Gpa) {
    let mut hm: HashMap<K, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    hm.insert(K { s: "abc" }, 2);
    hm.insert(K { s: "def" }, 3);
    let mut m: BTreeMap<K, i64, Gpa> = BTreeMap::new_in(gpa);
    m.insert(K { s: "abc" }, 1);
    m.insert(K { s: "def" }, 4);
    let mut hs: HashSet<K, Gpa, FixedState> = HashSet::new_in(gpa);
    hs.insert(K { s: "x" });
    hs.insert(K { s: "y" });
    println("{} {:?} {:?} {} {:?} {:?} {} {}", hm.len(), hm.get(&K { s: "abc" }),
        hm.get(&K { s: "def" }), m.len(), m.get(&K { s: "abc" }), m.get(&K { s: "def" }), hs.len(),
        hs.contains(&K { s: "x" }));
}
