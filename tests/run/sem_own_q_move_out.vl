// (0.25) `v.last()?` is a borrowed copy, as `v.last().unwrap()`: moving it
// (into a sink parameter) is own.move_out; reading a field of it is fine.
// ERROR: cannot move 'v.last()?' (T<Gpa>): it is a copy of an element
struct T<A: Allocator> { id: i64, w: Vec<i64, A> }
fn take(t: sink T<Gpa>) -> i64 { t.id }
fn read(v: Vec<T<Gpa>, Gpa>) -> Option<i64> { Some(v.last()?.id) }
fn keep(v: Vec<T<Gpa>, Gpa>) -> Option<i64> { Some(take(v.last()?)) }
fn main() -> i32 { 0 }
