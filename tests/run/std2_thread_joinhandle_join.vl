// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread JoinHandle::join.
// EXPECT: [1, 2, 3]
use std::thread;
use std::mem::swap;
use std::vec::Vec;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || {
        let mut v = Vec::new_in(gpa);
        v.push(1i64);
        v.push(2);
        v.push(3);
        v
    }, gpa);
    println("{:?}", h.join().unwrap());
}
