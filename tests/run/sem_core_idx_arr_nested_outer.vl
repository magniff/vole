// The outer index of a nested array.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 2
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let g = [[0i64; 3]; 2];
    println("{}", g[(2 + unsafe { Z }) as usize][0]);
    println("not reached");
    0
}
