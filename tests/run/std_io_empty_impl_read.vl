use std::io::{BufRead, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    let n = io::empty().read_to_end(&mut v).unwrap();
    println("{} {}", n, v.len());
