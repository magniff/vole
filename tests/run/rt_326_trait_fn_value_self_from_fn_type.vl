// XFAIL: RT-326: a trait's function as a value with Self from the expected fn type, `let f: fn() -> S = Mk2::mk;`, is refused ("'Mk2' is a trait, not a type") (0.30.2)
// Since v0.30.1 at least, the release branch and g302qual too. rustc
// builds it and prints the EXPECT line. (The review's form f43b, its
// value part.)
// EXPECT: 2
trait Mk2 { fn mk() -> Self; }
struct S { v: i64 }
impl Mk2 for S { fn mk() -> S { S { v: 2 } } }
fn main() { let f: fn() -> S = Mk2::mk; println("{}", f().v); }
