// EDITION: rust
// RUSTC: none a type error (E0308): the twin compares the borrow checker's verdicts
// RULE: D3.6a
// (0.27.7) A `&T` coerces to `*const T` only: given where a `*mut T`
// goes it is rustc's E0308, the types differing in mutability (0.27.6
// accepted it, and bump wrote through a shared borrow of x).
// ERROR: error[type error]: expected '*i64', got '&i64'
// ERROR: line 17, column 10
fn bump(p: *mut i64) {
    // UNSAFE: the test's raw pointer, a C-style out parameter
    // SAFETY: p points to the caller's live i64; nothing else uses it here
    unsafe { *p += 1; }
}

fn main() {
    let x = 1i64;
    bump(&x);
    println("{}", x);
}
