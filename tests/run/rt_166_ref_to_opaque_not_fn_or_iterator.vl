// XFAIL: RT-166: a reference to an `impl Trait` value does not get std's impls for references: `&impl Fn` is not Fn, `&mut impl FnMut` not FnMut, and `&mut impl Iterator` fails inside std ('impl Iterator<Item = i64>' has no associated type 'Item') (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_012_ref_to_opaque_not_fn_or_iterator.rs.txt).
// vole: `the type '&impl Fn(i64) -> i64' does not satisfy the bound 'F: Fn(i64) ->
// i64' of 'twice'`, the same for `&mut impl FnMut() -> i64` and call2, and for
// `first2(&mut e)` an error placed in std: `<std>:17413:17: error[type error]
// 'impl Iterator<Item = i64>' has no associated type 'Item'` (the projection
// in `impl Iterator for &mut I`); `.map(&a)`: `no method 'sum' on type
// 'Map<Copied<Iter<i64>>, &impl Fn(i64) -> i64>'`. The same program with a
// closure and a Filter in place of the opaque values builds and is right
// (og/k20.vl). RT-79/RT-145/RT-147's mechanism (the opaque type taken as a
// distinct type, not its hidden type). Since v0.28.0.
// EXPECT: 7
// EXPECT: 3
// EXPECT: 3
// EXPECT: 2
// EXPECT: Some(4)
// EXPECT: 15
fn adder(k: i64) -> impl Fn(i64) -> i64 {
    move |x| x + k
}

fn counter() -> impl FnMut() -> i64 {
    let mut n = 0i64;
    move || {
        n += 1;
        n
    }
}

fn evens() -> impl Iterator<Item = i64> {
    (0..10i64).filter(|x| x % 2 == 0)
}

fn twice<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(f(x))
}

fn call2<F: FnMut() -> i64>(mut f: F) -> i64 {
    f() + f()
}

fn first2<I: Iterator<Item = i64>>(mut it: I) -> i64 {
    it.next().unwrap_or(0) + it.next().unwrap_or(0)
}

fn main() {
    let a = adder(3);
    println("{}", twice(&a, 1));
    let mut c = counter();
    println("{}", call2(&mut c));
    println("{}", c());
    let mut e = evens();
    println("{}", first2(&mut e));
    println("{:?}", e.next());
    let v = [1i64, 2, 3];
    let z: i64 = v.iter().copied().map(&a).sum();
    println("{}", z);
}
