// RULE: D2.7
// (0.30.1) A closure writes through what it captures by `&mut`, through a
// captured `&mut` reference (rustc's unique borrow) and into a by-value
// capture of a `move` closure, as rustc accepts: only a `&mut` behind a
// captured `&` is refused (rust_b_err_closure_through_shared).
// EXPECT: 3 5 7
// EXPECT: 2
struct P<'a> {
    p: &'a mut i64,
}

fn main() {
    let mut a = 0i64;
    let mut b = 0i64;
    let mut q = P { p: &mut b };
    let m: &mut i64 = &mut a;
    let mut c = || {
        *m = 3;
        *q.p = 5;
    };
    c();
    let mut k = 6i64;
    let mut e = move || {
        k += 1;
        k
    };
    let n = e();
    println("{} {} {}", a, b, n);
    let mut s = [1i64, 2];
    let v: &mut [i64] = &mut s;
    let mut f = || v[0] = 2;
    f();
    println("{}", s[0]);
}
