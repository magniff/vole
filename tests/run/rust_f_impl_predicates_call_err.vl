// (0.30.1, review 4) Where `T: Tr` is met by an impl, the impl's own
// predicates are required of the type there (rustc's impl confirmation):
// its header's `'a: 'static`, the same in a `where`, a nested impl's
// (`V<T>` through `T: Sup`), a pattern impl's (`&'a T`), a blanket impl's
// `T: 'static`, a supertrait's impl (`T: Sub` calling Sup's method, its
// impl for G<'a, T> with a `where 'a: 'static` Sub's generic impl does not
// have), an impl of the other trait arguments too (`Tr<i32>` beside
// `Tr<i64>`: both are required, and their parameters' impls'), and a chain `'a: 'b, 'b: 'static`. Before, the impl's lifetime bounds were trusted in its body and
// never required at a generic call (a direct call, `x.up()`, required
// them already): a borrowed str outlived its String
// (a use after free, review 4's c13).
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR: borrowck.return_local
// ERROR-COUNT: 10
trait Sup {
    fn up(&self) -> &'static str;
}

trait Sub: Sup {
    fn n(&self) -> i64;
}

trait Tr<U> {
    fn tup(&self) -> &'static str;
}

trait Foo {
    fn s(&self) -> &str;
}

trait Get {
    fn g(&self) -> &str;
}

struct X<'a> {
    r: &'a str,
}

struct Y<'a> {
    r: &'a str,
}

struct Z<'a> {
    r: &'a str,
}

struct Q<'a, 'b> {
    r: &'a str,
    s: &'b str,
}

struct V<T> {
    t: T,
}

struct S<'a> {
    r: &'a str,
}

impl<'a: 'static> Sup for X<'a> {
    fn up(&self) -> &'static str {
        self.r
    }
}

struct G<'a, T> {
    r: &'a str,
    t: T,
}

impl<'a, T> Sup for G<'a, T> where 'a: 'static {
    fn up(&self) -> &'static str {
        self.r
    }
}

impl<'a, T> Sub for G<'a, T> {
    fn n(&self) -> i64 {
        1
    }
}

impl<'a> Sup for Y<'a> where 'a: 'static {
    fn up(&self) -> &'static str {
        self.r
    }
}

impl<T: Sup> Sup for V<T> {
    fn up(&self) -> &'static str {
        self.t.up()
    }
}

impl Get for str {
    fn g(&self) -> &str {
        self
    }
}

impl<'a, T: Get + ?Sized> Sup for &'a T where 'a: 'static {
    fn up(&self) -> &'static str {
        let r: &'static T = *self;
        r.g()
    }
}

impl<'a> Foo for Z<'a> {
    fn s(&self) -> &str {
        self.r
    }
}

fn keep<T: 'static>(t: &T) -> &'static T {
    keep2(t)
}

fn keep2<T: 'static>(t: &T) -> &'static T {
    loop {}
}

impl<T: Foo + 'static> Sup for T {
    fn up(&self) -> &'static str {
        keep(self).s()
    }
}

impl<'a: 'static> Tr<i32> for S<'a> {
    fn tup(&self) -> &'static str {
        self.r
    }
}

impl<'a> Tr<i64> for S<'a> {
    fn tup(&self) -> &'static str {
        "k"
    }
}

impl<'a: 'b, 'b: 'static> Sup for Q<'a, 'b> {
    fn up(&self) -> &'static str {
        self.r
    }
}

struct N<T> {
    t: T,
}

impl<T: Sup> Tr<i32> for N<T> {
    fn tup(&self) -> &'static str {
        self.t.up()
    }
}

impl<T> Tr<i64> for N<T> {
    fn tup(&self) -> &'static str {
        "n"
    }
}

fn go<T: Sup>(t: &T) -> &'static str {
    t.up()
}

fn go_sub<T: Sub>(t: &T) -> &'static str {
    t.up()
}

fn go_tr<T: Tr<i32>>(t: &T) -> &'static str {
    t.tup()
}

fn header(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let x = X { r: st.as_str() };
    go(&x)
}

fn where_form(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let y = Y { r: st.as_str() };
    go(&y)
}

fn nested(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let v = V { t: X { r: st.as_str() } };
    go(&v)
}

fn pattern(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let r: &str = st.as_str();
    go(&r)
}

fn blanket(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let z = Z { r: st.as_str() };
    go(&z)
}

fn supertrait(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let g = G { r: st.as_str(), t: 1i64 };
    go_sub(&g)
}

fn trait_args(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let s = S { r: st.as_str() };
    go_tr(&s)
}

fn trait_args_nested(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let n = N { t: X { r: st.as_str() } };
    go_tr(&n)
}

fn chain(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let q = Q { r: st.as_str(), s: "k" };
    go(&q)
}

fn direct(gpa: Gpa) -> &'static str {
    let st = String::from_in("a heap string", gpa);
    let x = X { r: st.as_str() };
    x.up()
}

fn main(gpa: Gpa) {
    println("{} {} {} {} {}", header(gpa), where_form(gpa), nested(gpa), pattern(gpa),
        blanket(gpa));
    println("{} {} {} {}", supertrait(gpa), trait_args(gpa), chain(gpa), direct(gpa));
    println("{}", trait_args_nested(gpa));
}
