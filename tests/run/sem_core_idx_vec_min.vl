// A Vec index of i64::MIN is out of bounds (no wrap of the scaled offset).
// EXIT: 101
// STDERR: index out of bounds: index 9223372036854775808, length 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", v[(-9223372036854775807 - 1 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
