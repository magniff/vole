// (0.27.0) The rust edition's region variables (places/regions.vl): a
// parameter's reference is a universal region, a borrow a loan, a local
// holding a reference its own, a call whose result holds one a call's;
// each borrow names its variable (`&'r4 _1[_2]`). (0.27.1) The format of
// docs/design/borrowck.md §16: 'static first, a universal lists the slots
// bound to it (`_1.0`, `return.0`: E2's elided result), a local's slot is
// `_L.i`, a call's region of its callee `bbK[i].j`.
// PLACES: fn first
// PLACES: region 'r1: universal 'static
// PLACES: region 'r2: universal '_1 (_1.0, return.0)
// PLACES: region 'r3: local _0.0
// PLACES: region 'r4: loan bb0[
// PLACES: _0 = &'r4 _1[_2]
// PLACES: fn bump
// PLACES: region 'r2: universal '_1 (_1.0)
// PLACES: fn main
// PLACES: : call bb0[6].0
// PLACES: _3 = &'r20 mut _2

fn first(v: &[i64]) -> &i64 {
    &v[0]
}

fn bump(x: &mut i64) {
    *x += 1;
}

fn main() -> i32 {
    let a = [4, 5];
    let mut n = 1;
    bump(&mut n);
    let r = first(&a[..]);
    println("{} {}", *r, n);
    0
}
// EXPECT: 4 2
