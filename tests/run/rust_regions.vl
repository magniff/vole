// EDITION: rust
// (0.27.0) The rust edition's region variables (places/regions.vl): a
// parameter's reference is a universal region, a borrow a loan, a local
// holding a reference its own, a call whose result holds one a call's;
// each borrow names its variable (`&'r3 _1[_2]`). 0.27.1 solves them.
// PLACES: fn first
// PLACES: region 'r1: local _0
// PLACES: region 'r2: universal _1
// PLACES: region 'r3: loan bb0[
// PLACES: _0 = &'r3 _1[_2]
// PLACES: fn bump
// PLACES: region 'r1: universal _1
// PLACES: fn main
// PLACES: : call bb0[
// PLACES: _3 = &'r9 mut _2

fn first(v: &[i64]) -> &i64 {
    &v[0]
}

fn bump(x: &mut i64) {
    *x += 1;
}

fn main() -> i32 {
    let a = [4, 5];
    let mut n = 1;
    bump(&mut n);
    let r = first(&a[..]);
    println("{} {}", *r, n);
    0
}
// EXPECT: 4 2
