// XFAIL: RT-322: a trait default `fn d(&mut self) -> i64 { Self::f(*self) }`, f taking `self` by value, is accepted: Self is not known to be Sized there (and `*self` moves out of a `&mut`) (0.30.2)
// Since v0.30.1 at least. rustc: error[E0277] the size for values of type
// `Self` cannot be known at compilation time (Self: ?Sized in a trait;
// `where Self: Sized` would be needed, and then E0507 for the move out of
// `*self` unless Self: Copy). vole builds it and runs the impl's f on a
// copy.
// ERROR: line 12
trait T0 {
    fn f(self) -> i64;

    fn d(&mut self) -> i64 {
        Self::f(*self)
    }
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl T0 for S {
    fn f(self) -> i64 {
        self.k
    }
}

fn main() {
    let mut s = S { k: 1 };
    println("{}", s.d());
}
