// XFAIL: RT-125: a tuple variant's constructor is not a function value: `let f = E::Green;`, `.map(Some)`, `.map(E::Green)` are refused (0.30.2)
// In Rust a tuple variant (and a tuple struct) names a function: `E::Green:
// fn(i64) -> E`, `Some: fn(T) -> Option<T>`; `.map(Some)` and
// `.map_err(Some)` are common. vole: "variant 'E::Green' has 1 field |
// help: construct it with 'E::Green(...)'", and for Some a type.infer
// error with the try: `Option::<T>::Some`, which is the same refused form.
// With the fn type written (`let g: fn(i64, bool) -> E = E::Pair;`) it is
// refused the same way. Since 0.28.0.
// EXPECT: Green(1) Pair(2, true) Some(Some(3)) Ok(5) 2 Red
#[derive(Debug, Clone, Copy)]
enum E {
    Red,
    Green(i64),
    Pair(i64, bool),
}

fn main() {
    let f = E::Green;
    let g: fn(i64, bool) -> E = E::Pair;
    let v: Option<Option<i64>> = Some(3i64).map(Some);
    let r: Result<i64, i64> = Some(5i64).ok_or(1).map_err(Some).map_err(|e| e.unwrap_or(0));
    let w = [1i64, 2];
    let n = w.iter().copied().map(E::Green).count();
    println("{:?} {:?} {:?} {:?} {} {:?}", f(1), g(2, true), v, r, n, E::Red);
}
