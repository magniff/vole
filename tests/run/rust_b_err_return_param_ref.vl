// EDITION: rust
// RULE: D6.2.2
// (0.27.1) A reference to a by-value parameter returned: caught by the
// implicit exit access of the parameter (no StorageDead).
// ERROR: :15:16: error[borrowck.return_local]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct N {
    v: i64,
}

fn f<'a>(n: N, o: &'a i64) -> &'a i64 {
    if *o > 0 {
        return &n.v;
    }
    o
}

fn main() {
    let o: i64 = 2;
    println("{}", *f(N { v: 1 }, &o));
}
