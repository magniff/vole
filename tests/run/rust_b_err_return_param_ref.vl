struct N {
    v: i64,
}

fn f<'a>(n: N, o: &'a i64) -> &'a i64 {
    if *o > 0 {
        return &n.v;
    }
    o
}

fn main() {
    let o: i64 = 2;
    println("{}", *f(N { v: 1 }, &o));
}
