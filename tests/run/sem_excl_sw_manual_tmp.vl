// XFAIL: gap 3: compile type error: expected 'inout Vec<i64, Gpa>', got 'Vec<i64, Gpa>'
// a manual swap through a temporary of owned values: moves, no double free
// EXPECT: 2 1
use std::mem;

fn sw(a: &mut Vec<i64, Gpa>, b: &mut Vec<i64, Gpa>) {
    let t = mem::replace(&mut (a), b.take()); *b = t;
}

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa); a.push(1);
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    b.push(2);
    b.push(3); sw(&mut a, &mut b); println("{} {}", a.len(), b.len());
}
