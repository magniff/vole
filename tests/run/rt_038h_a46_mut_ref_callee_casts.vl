// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a46_mut_ref_callee_casts)
// RUSTC: none contract clauses are not Rust
// ERROR: expected '&&mut i64', got '&&i64'
// A callee given &&mut i64 casts the inner &mut to *mut and writes.
fn poke(r: &&mut i64) -> bool {
    let p: *const i64 = &**r;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *(p as *mut i64) = 9; }
    true
}

fn f(r: &mut i64) -> i64
    requires poke(&r)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
