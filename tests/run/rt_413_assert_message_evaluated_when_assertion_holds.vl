// XFAIL: RT-413: WRONG CODE: assert!'s message arguments are evaluated even when the assertion holds: `assert!(x > 0, "{}", note(x))` runs note (it prints) and, with `x + x` for x: i32 = 2000000000, panics at -O0; rustc evaluates the message only when the assertion fails and prints `ok` alone (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: ok
fn note(x: i64) -> i64 {
    println("message evaluated");
    x
}

fn main() {
    let x: i64 = 5;
    assert !(x > 0, "{}", note(x));
    println("ok");
}
