// sem-own: `?` converting an owned error through From: the error dropped once.
// EXPECT: drop 7
// EXPECT: err 7
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
struct E2 { id: i64 }
impl From<D<Gpa>> for E2 { fn from(x: D<Gpa>) -> E2 { E2 { id: x.id } } }
fn g(gpa: Gpa) -> Result<i64, D<Gpa>> { Err(mk(7, gpa)) }
fn f(gpa: Gpa) -> Result<i64, E2> { let n = g(gpa)?; Ok(n) }

fn main(gpa: Gpa) {
    match f(gpa) { Ok(n) => println("ok {n}"), Err(e) => println("err {}", e.id) }
}
