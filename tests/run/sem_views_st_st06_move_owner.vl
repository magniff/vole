fn eat(s: String<Gpa>) { println("{}", s.len()); }

fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("hello", gpa);
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(s.as_str());
    eat(s);
    println("{}", v[0usize]);
    0
}
