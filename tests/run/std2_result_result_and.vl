// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::result Result::and.
// EXPECT: Ok("x") Err("bad")
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let c: Result<&str, &str> = Ok("x");
    println("{:?} {:?}", a.and(c), b.and(c));
}
