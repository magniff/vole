// EDITION: rust
// RULE: D12.1
// (0.27.1) Iterating a std `Vec` (its iterator holds a hidden view, R2) and
// summing.
// RUSTC: none std2's Vec takes an allocator (the twin's subset has none until 0.27.3)

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let mut t: i64 = 0;
    for x in v.iter() {
        t += x;
    }
    println("{}", t);
    0
}
// EXPECT: 3
