// FLAGS: --check-alloc
// `write` and `writeln` with a literal that has no hole, on an io::Write
// (a File, a BufWriter, a Vec<u8>) and on a fmt::Write (a String): the
// text as it is (gap 75).
// EXPECT: head
// EXPECT: x = 3
// EXPECT: tail
// EXPECT: [a|b]
// EXPECT: s{}
use std::fs::File;
use std::io::{BufWriter, Read};

fn main(gpa: Gpa) -> i32 {
    let path = "/tmp/vole-std-io-writeln-file.txt";
    {
        let mut f = File::create(path).unwrap();
        writeln(&mut f, "head").unwrap();
        writeln(&mut f, "x = {}", 3).unwrap();
        let mut b = BufWriter::new(f);
        write(&mut b, "ta").unwrap();
        writeln(&mut b, "il").unwrap();
    }
    let mut text = String::new_in(gpa);
    File::open(path).unwrap().read_to_string(&mut text).unwrap();
    print("{}", text);
    std::fs::remove_file(path).unwrap();
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    write(&mut v, "[a").unwrap();
    write(&mut v, "|b]").unwrap();
    println("{}", std::str::from_utf8(&v[..]).unwrap());
    let mut s = String::new_in(gpa);
    write(&mut s, "s{{}}").unwrap();
    println("{}", s);
    0
}
