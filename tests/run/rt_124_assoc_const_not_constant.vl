// XFAIL: RT-124: an associated constant is "not a compile-time constant": refused as an array length, a repeat count and inside a const item (0.30.2)
// rustc evaluates `S::N` (an inherent associated const), `<S as T>::K`
// (a trait's) and `S::N + 1` at compile time wherever a constant is
// needed. vole refuses each of the five uses below with "expression is
// not a compile-time constant": the return type `[i64; S::N]`, the
// repeat `[7; S::N]`, `const M: usize = S::N + 1;`, a let's annotated
// length and `[0i64; <S as T>::K]`. A free const (`const N: usize = 3;`)
// works in all of them. Since 0.28.0 at least.
// EXPECT: [7, 7, 7] [1, 1, 1] [0, 0] [5, 5, 5, 5]
struct S;

impl S {
    const N: usize = 3;

    fn arr() -> [i64; S::N] {
        [7; S::N]
    }
}

trait T {
    const K: usize;
}

impl T for S {
    const K: usize = 2;
}

const M: usize = S::N + 1;

fn main() {
    let a: [u8; S::N] = [1; S::N];
    let b = [0i64; <S as T>::K];
    let c = [5u8; M];
    println("{:?} {:?} {:?} {:?}", S::arr(), a, b, c);
}
