// Two chained u8 running values (s1 feeds acc): no reduction may be split.
// rustc 1.98 at opt-level 1 prints 1007 537 1727 317 here; its opt-level 0,
// and vole at every -O, print the EXPECT line (tools/rustc-twin.sh retries
// such a case at opt-level 0).
// FLAGS: -O2
// EXPECT: 975 653 1765 497
#[inline(never)]
fn f(b: &[u8]) -> u64 {
    let mut acc: u8 = 91;
    let mut s1: u8 = 7;
    for i in 0..b.len() {
        s1 = s1.wrapping_sub(b[i]);
        acc = acc.wrapping_sub(s1);
    }
    (acc as u64) ^ (s1 as u64).wrapping_mul(7) ^ (s1 as u64)
}

fn main() {
    let mut b = [0u8; 37];
    for i in 0..37 {
        b[i] = (((i * 37 + 11) % 101) as i64 - 30) as u8;
    }
    for n in [7usize, 8, 16, 37] {
        print("{} ", f(&b[0..n]));
    }
    println("");
}
