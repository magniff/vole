// ERROR: the trait 'H2' is not implemented for 'u8'
// (RT-272) `T: H2 + Tr<T::Out>` not met: an error (v0.30.1: bus error).
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H2 {
    type Out;
}

struct W {
    r: i64,
}

impl H2 for W {
    type Out = i64;
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

fn mid<T: H2 + Tr<T::Out>>(t: &T) -> i64 {
    t.g()
}

fn main() {
    println("{}", mid(&5u8));
}
