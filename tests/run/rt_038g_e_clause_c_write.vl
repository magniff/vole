// RULE: C3.4
// (0.30.2, RT-38g) A clause that calls a C function given a `*mut`: C
// may write through it (memset wrote the caller's value), raw_write as a
// raw store is; one given only `*const` pointers to what holds none
// (memcmp) writes nothing and stays allowed.
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'memset', which writes through a raw pointer
// ERROR-COUNT: 1
extern "C" {
    fn memset(p: *mut u8, c: i32, n: usize) -> *mut u8;
    fn memcmp(a: *const u8, b: *const u8, n: usize) -> i32;
}

fn f(p: *mut u8) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        memset(p, 9, 1);
    }
    true
}

{
    1
}

fn g(p: *const u8, q: *const u8) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe { memcmp(p, q, 1) == 0 }
}

{
    1
}

fn main() {
    let mut x = [1u8, 2];
    let y = [1u8, 2];
    println("{}", f(&raw mut x[0]));
    println("{}", g(&raw const x[0], &raw const y[0]));
    println("{}", x[0]);
}
