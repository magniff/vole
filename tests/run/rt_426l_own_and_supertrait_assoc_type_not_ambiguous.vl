// XFAIL: RT-426l: (RT-426's family) `Self::Out` in a default method of `trait Sub: Tr`, where Sub and Tr both declare Out, is accepted and takes Sub's (vole prints 1); rustc E0221 (ambiguous associated type `Out` in bounds of `Self`) (0.30.2)
// From the re-review of g302oblig M2 (its form c12_trait_own_and_super). Since v0.30.1 at
// least (v0.30.1 and the release build print 1).
// ERROR: line 13
trait Tr {
    type Out;
}

trait Sub: Tr {
    type Out;

    fn sz(&self) -> usize {
        std::mem::size_of::<Self::Out>()
    }
}

struct W;

impl Tr for W {
    type Out = i64;
}

impl Sub for W {
    type Out = u8;
}

fn main() {
    println("{}", W.sz());
}
