// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Drain::impl DoubleEndedIterator.
// EXPECT: Some(4) Some(2) [1, 5]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3, 4, 5], gpa);
    let (a, b) = {
        let mut d = v.drain(1..4);
        (d.next_back(), d.next())
    };
    println("{:?} {:?} {:?}", a, b, v);
}
