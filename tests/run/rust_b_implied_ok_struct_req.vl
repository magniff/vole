// EDITION: rust
// RULE: D4.6
// (0.27.2.1) A struct's inferred outlives requirement (RFC 2093): `It<'a,
// T>` holds a `&'a [T]`, so `T: 'a` is implied wherever `It<'a, T>` is
// named; `next` returns an element as `&'a T` through a generic helper.
// EXPECT: a b
struct It<'a, T> {
    v: &'a [T],
}

fn split<'r, U>(s: &'r [U]) -> Option<(&'r U, &'r [U])> {
    if s.len() == 0 { Option::None } else { Option::Some((&s[0], &s[1..])) }
}

impl<'a, T> It<'a, T> {
    fn next(&mut self) -> Option<&'a T> {
        match split(self.v) {
            Option::Some((x, rest)) => {
                self.v = rest;
                Option::Some(x)
            }
            Option::None => Option::None,
        }
    }
}

fn main() {
    let b = ["a", "b"];
    let mut i = It { v: &b };
    let x = i.next().unwrap();
    let y = i.next().unwrap();
    println("{} {}", x, y);
}
