// EDITION: rust
// 0.17: the prelude's `unreachable()`: exit 101, "entered unreachable
// code"; a match arm of type `!`.
// EXIT: 101
// STDERR: entered unreachable code
use std::ops::Add; use std::ops::Sub; #[derive(Clone, Copy)] enum Op { Add, Sub, Pick(i64) }

fn apply(o: Op, a: i64, b: i64) -> i64 {
    match o {
        Op::Add => a + b,
        Op::Sub => a - b,
        Op::Pick(_) => unreachable(),
    }
}

fn main() -> i32 {
    let x = apply(Op::Add, 1, 2) + apply(Op::Sub, 3, 2);
    if x != 4 { return 1; }
    apply(Op::Pick(1i64), 0, 0) as i32
}
