// EDITION: rust
// (0.25) After a match by value moved a part of a local, the local is
// partly moved: moving it whole is own.moved (Rust's partial move); a part
// it still holds can be read (`f.0`). No `.clone()` try inside a pattern.
// ERROR: error[borrowck.use_moved]
// ERROR: line 15, column 10
struct T { id: i64 }
impl Drop for T { fn drop(&mut self) { println("drop {}", self.id); } }
enum E { A(T), N }
fn take(e: E) {}

fn main() {
    let e = E::A(T { id: 1 });
    match e { E::A(x) => println("{}", x.id), E::N => {} }
    take(e);
    let f = (T { id: 4 }, T { id: 5 });
    let (_, b) = f;
    println("{} {}", f.0.id, b.id);
}
