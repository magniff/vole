// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec IntoIter::impl Iterator.
// EXPECT: Some(1) Some(2) None (0, Some(0))
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut it = Vec::from_in([1, 2], gpa).into_iter();
    println("{:?} {:?} {:?} {:?}", it.next(), it.next(), it.next(), it.size_hint());
}
