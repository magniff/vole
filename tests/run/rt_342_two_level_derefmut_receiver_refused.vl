// XFAIL: RT-342: a two-level DerefMut method receiver or assignment (`b.set(10)`, `**b = ..`) gives borrowck.borrow_immutable (0.30.2)
// rustc prints the EXPECT line. Since v0.30.1 at least. From the
// re-review of g302index.
// EXPECT: 15 20 20 20 3 2
use std::ops::{Deref, DerefMut};

struct In {
    v: i64,
}

impl In {
    fn get(&self) -> i64 {
        self.v
    }

    fn set(&mut self, k: i64) {
        self.v = k;
    }
}

struct C {
    a: In,
    z: In,
}

impl C {
    fn deref(&self) -> &In {
        &self.z
    }

    fn deref_mut(&mut self) -> &mut In {
        &mut self.z
    }
}

impl Deref for C {
    type Target = In;

    fn deref(&self) -> &In {
        &self.a
    }
}

impl DerefMut for C {
    fn deref_mut(&mut self) -> &mut In {
        &mut self.a
    }
}

struct B {
    a: C,
    z: C,
}

impl B {
    fn deref(&self) -> &C {
        &self.z
    }

    fn deref_mut(&mut self) -> &mut C {
        &mut self.z
    }
}

impl Deref for B {
    type Target = C;

    fn deref(&self) -> &C {
        &self.a
    }
}

impl DerefMut for B {
    fn deref_mut(&mut self) -> &mut C {
        &mut self.a
    }
}

fn main() {
    let mut b = B {
        a: C { a: In { v: 1 }, z: In { v: 2 } }, z: C { a: In { v: 3 }, z: In { v: 4 } }
    };
    (**b).v = 10;
    b.v += 5;
    let r: &In = &b;
    let x = r.v;
    (**b).v = 20;
    println("{} {} {} {} {} {}", x, b.get(), b.v, b.a.a.v, b.z.a.v, b.a.z.v);
}
