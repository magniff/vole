// EDITION: rust
// RULE: D2.5
// (0.27.1) An assignment to the whole `s` while `&s.x` is live: a write to a
// prefix overwrites the loan's place (Extends by a field).
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 18, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = &s.x;
    s = S { x: 3, y: 4 };
    println("{} {}", *r, s.y);
}
