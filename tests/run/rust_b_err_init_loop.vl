struct P {
    a: i64,
    b: &'static i64,
}

impl P {
    fn get(&self) -> i64 {
        self.a + *self.b
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

struct Q {
    r: i64,
    s: i64,
}

struct O {
    q: Q,
    z: i64,
}

union U {
    x: i64,
    y: u32,
}

static THREE: i64 = 3;

fn lp() {
    let mut p: P;
    let mut i = 0;
    while i < 2 {
        p.a = i;
        i += 1;
    }
}

fn lp_read() {
    let mut p: P;
    let mut i = 0;
    while i < 3 {
        if i > 0 {
            println("{}", *p.b);
        }
        p = P { a: i, b: &THREE };
        i += 1;
    }
}

fn main() {
    lp();
    lp_read();
}
