// RT-38 (F9): one rule for a binding in a clause, the one Rust's `&T`
// gives: a clause reads a parameter (and `result`) as through `&T`, so a
// by-value binding of a part that is not Copy is a move out of it,
// refused (rustc E0507 on `match *r { Some(w) => .. }`), in a `requires`
// as in an `ensures`. Before, `let (a, _b) = t;`, `match o { Some(w) =>
// .. }` and `if let` were accepted in a `requires` as borrowed bindings
// while `let a = t.0;` was contract.move and `ensures` refused the same
// patterns on `result`. A `ref` binding or a match through `&` borrows
// (rt_038_clause_binding_borrows.vl).
// ERROR: error[contract.move]: a clause moves 't'
// ERROR: line 25, column 10
// ERROR: error[contract.move]: a clause moves 'o'
// ERROR: line 35, column 10
// ERROR: error[contract.move]: a clause moves 'o'
// ERROR: line 44, column 26
// ERROR: error[contract.move]: a clause moves 't'
// ERROR: line 52, column 13
// ERROR: error[contract.move]: a clause moves 'result'
// ERROR: line 62, column 10
// ERROR: error[contract.move]: a clause moves 'result'
// ERROR: line 72, column 10
// ERROR-COUNT: 6
fn pre_let(t: (Vec<i64, Gpa>, Vec<i64, Gpa>)) -> i64
    requires {
    let (a, _b) = t;
    a.len() > 0
}

{
    t.0[0] + t.1[0]
}

fn pre_match(o: Option<Vec<i64, Gpa>>) -> i64
    requires match o {
    Some(w) => w.len() > 0,
    None => true,
}

{
    o.unwrap()[0]
}

fn pre_iflet(o: Option<Vec<i64, Gpa>>) -> i64
    requires if let Some(w) = o { w.len() > 0 } else { true }

{
    o.unwrap()[0]
}

fn pre_field(t: (Vec<i64, Gpa>, i64)) -> i64
    requires {
    let a = t.0;
    a.len() > 0
}

{
    t.0[0]
}

fn post_let(gpa: Gpa) -> (Vec<i64, Gpa>, i64)
    ensures {
    let (a, n) = result;
    a.len() as i64 + n > 0
}

{
    (Vec::from_in([5i64], gpa), 1)
}

fn post_match(gpa: Gpa) -> Option<Vec<i64, Gpa>>
    ensures match result {
    Some(w) => w.len() > 0,
    None => true,
}

{
    Some(Vec::from_in([5i64], gpa))
}

fn main(gpa: Gpa) {
    println("{}", pre_let((Vec::from_in([1i64], gpa), Vec::from_in([2i64], gpa))));
    println("{}", pre_match(Some(Vec::from_in([1i64], gpa))));
    println("{}", pre_iflet(Some(Vec::from_in([1i64], gpa))));
    println("{}", pre_field((Vec::from_in([1i64], gpa), 2)));
    println("{}", post_let(gpa).1);
    println("{}", post_match(gpa).unwrap()[0]);
}
