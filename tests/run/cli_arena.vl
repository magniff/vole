// EDITION: rust
// std::cli (0.25): a Command on any allocator (an arena: nothing on the
// Gpa), an option's choices, a program's own error (CliError::custom),
// the unknown letter of a cluster, a positional's value_name.
// EXPECT: mode slow
// EXPECT: error: invalid value 'medium' for '--mode <fast|slow>'
// EXPECT: try: --mode <fast|slow>
// EXPECT: usage: sum [options] [FILE]...
// EXPECT: error: -b and -t together
// EXPECT: try: -b
// EXPECT: usage: sum [options] [FILE]...
// EXPECT: letter x of -bx
// EXPECT: last of -b, -t: text
use std::alloc::Arena; use std::cli::Arg; use std::cli::CliError; use std::cli::Command;


fn main(gpa: Gpa) -> i32 {
    Arena::new_in(gpa).scope(|s| ({ let a = s; {
        let cmd = Command::new_in("sum", a)
            .arg(Arg::flag("binary").short(b'b' as char))
            .arg(Arg::flag("text").short(b't' as char))
            .arg(Arg::option("mode").choices("fast|slow").default("fast"))
            .arg(Arg::positional("file").value_name("FILE").multiple());
        let m = cmd.parse("sum --mode slow x".split(' ')).ok().unwrap();
        println("mode {}", m.get("mode").unwrap());
        match cmd.parse("sum --mode medium".split(' ')) {
            Ok(_) => println("ok"),
            Err(e) => print("{}", str::from_utf8(cmd.render_in(e, a).as_bytes()).unwrap()),
        }
        let e = CliError::custom("-b and -t together", "-b");
        print("{}", str::from_utf8(cmd.render_in(e, a).as_bytes()).unwrap());
        match cmd.parse("sum -bx".split(' ')) {
            Ok(_) => println("ok"),
            Err(e) => {
                let l = [e.letter() as u8];
                println("letter {} of {}", str::from_utf8(&l[..]).unwrap(), e.text);
            }
        }
        // the last of -b and -t wins: indices_of
        let both = cmd.parse("sum -b f -t g".split(' ')).ok().unwrap();
        let b = both.indices_of("binary");
        let t = both.indices_of("text");
        let text = t.len() > 0 && (b.len() == 0 || t[t.len() - 1] > b[b.len() - 1]);
        println("last of -b, -t: {}", if text { "text" } else { "binary" });
    } }));
    0
}
