// EDITION: rust
// An assignment evaluates its right-hand side first, then the place; a
// compound assignment then reads the old value (since 0.3).
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn realloc(p: *mut u8, size: u64) -> *mut u8;
}

static mut LOG: [i64; 16] = [0i64; 16];
static mut N: i64 = 0;

fn note(x: i64) -> i64 {
    unsafe { LOG[N as usize] = x; }
    unsafe { N += 1; }
    x
}

#[derive(Clone, Copy)] struct P { x: i64, y: i64 }

static mut PS: *mut P = 0 as *mut P;
static mut CAP: i64 = 0;

// Grows (moves) PS, as a parser growing its node array would.
fn grow() -> i64 {
    unsafe { CAP *= 4; }
    unsafe { PS = realloc(PS as *mut u8, (CAP * 16) as u64) as *mut P; }
    7
}

fn main() {
    let mut a: [i64; 4] = [0i64; 4];
    a[note(1) as usize] = note(2);
    a[note(3) as usize] += note(5);
    for i in 0..unsafe { N } {
        unsafe { printf(c"%ld ", LOG[i as usize]); }
    }
    unsafe { printf(c"| %ld %ld %ld\n", a[1], a[2], a[3]); }

    unsafe { CAP = 1; }
    unsafe {
        PS = malloc(16) as *mut P;
        (*PS.add(0)) = P { x: 1, y: 2 };
        (*PS.add(0)).y = grow();
        (*PS.add(0)).x += grow();
        printf(c"%ld %ld\n", (*PS.add(0)).x, (*PS.add(0)).y);
    }

    let mut x: i64 = 1;
    x += {
        x = 5;
        1
    };
    unsafe { printf(c"%ld\n", x); }

    let mut y: i64 = 10;
    let p = &mut y as *mut i64;
    unsafe {
        *p -= {
            *p = 100;
            1
        };
        printf(c"%ld\n", y);
    }

    let mut s = P { x: 3, y: 4 };
    let mut t = P { x: 0, y: 0 };
    t = {
        s.x = 30;
        s
    };
    unsafe { printf(c"%ld %ld\n", t.x, t.y); }
}

// EXPECT: 2 1 5 3 | 2 0 5
// EXPECT: 8 7
// EXPECT: 6
// EXPECT: 99
// EXPECT: 30 4
