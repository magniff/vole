// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Values::impl Iterator.
// EXPECT: Some(7) None
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 7);
    let mut v = m.values();
    let a = v.next();
    println("{:?} {:?}", a, v.next());
}
