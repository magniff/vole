// RULE: F20.6
// (0.27.5) A `ref mut` binding of an index place, in a match or an
// `if let`, makes the place mutable once the pattern is checked: the
// index is IndexMut's (a Vec's `as_mut_slice`). A `ref` binding reads.
// EXPECT: 1 2 3
fn main(gpa: Gpa) {
    let mut vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    vs.push(Vec::new_in(gpa));
    match vs[0] {
        ref mut w => w.push(1),
    }
    let mut os: Vec<Option<Vec<i64, Gpa>>, Gpa> = Vec::new_in(gpa);
    os.push(Some(Vec::new_in(gpa)));
    if let Some(ref mut w) = os[0] {
        w.push(2);
        w.push(3);
    }
    let n = match os[0] {
        Some(ref w) => w.len(),
        None => 0,
    };
    let last = match os[0] {
        Some(ref w) => w[1],
        None => 0,
    };
    println("{} {} {}", vs[0].len(), n, last);
}
