// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::scan.
// EXPECT: [1, 3, 6, 10]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let a: Vec<i64, Gpa> = v.iter().scan(0, |acc, x| {
        *acc += x;
        Some(*acc)
    }).collect_in(gpa);
    println("{:?}", a);
}
