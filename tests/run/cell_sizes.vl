// (0.26.1) A cell is its value: the same size and alignment, and no drop
// of its own (`needs_drop` is false; a cell of a Vec needs the Vec's).
// EXPECT: 8 8 false
// EXPECT: 1 1 false
// EXPECT: 16 8 false
// EXPECT: true
use std::cell::{Cell, UnsafeCell};

fn main() {
    println("{} {} {}", size_of(Cell<i64>), align_of(Cell<i64>), needs_drop::<Cell<i64>>());
    println("{} {} {}", size_of(Cell<u8>), align_of(UnsafeCell<u8>),
        needs_drop::<UnsafeCell<u8>>());
    println(
        "{} {} {}", size_of([Cell<i64>; 2]), align_of((Cell<i32>, i64)),
        needs_drop::<(Cell<i64>, i64)>());
    println("{}", needs_drop::<Cell<Vec<u8>>>());
}
