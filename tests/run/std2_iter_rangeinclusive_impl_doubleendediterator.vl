// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter RangeInclusive::impl DoubleEndedIterator.
// EXPECT: [3, 2, 1] [0]

fn main(gpa: Gpa) {
    let a: Vec<i64, Gpa> = (1i64..=3).rev().collect_in(gpa);
    let b: Vec<u8, Gpa> = (0u8..=0).rev().collect_in(gpa);
    println("{:?} {:?}", a, b);
}
