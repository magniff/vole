// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::thread scope; std::thread Scope.
// EXPECT: 10 26
use std::thread;

fn main() {
    let a = [1i64, 2, 3, 4];
    let b = [5i64, 6, 7, 8];
    let (x, y) = thread::scope(|s| {
        let h1 = s.spawn(|| {
            let mut t = 0i64;
            for v in &a {
                t += *v;
            }
            t
        });
        let h2 = s.spawn(|| {
            let mut t = 0i64;
            for v in &b {
                t += *v;
            }
            t
        });
        (h1.join().unwrap(), h2.join().unwrap())
    });
    println("{} {}", x, y);
}
