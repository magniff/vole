// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a41d_debug_old_raw)
// FLAGS: --debug-contracts
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'f' writes through a raw pointer what it did not make
// A debug ensures: old(..) writes through a raw pointer parameter in the clause's own code.
fn f(p: *mut i64) -> i64
    debug ensures old({
        // UNSAFE: test
        // SAFETY: test
        unsafe { *p = 9; }
        1
    }) == 1
    {
    2
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x));
    println("{}", x);
}
