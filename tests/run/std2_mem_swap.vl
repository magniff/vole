// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::mem swap.
// EXPECT: 2 1 b a
use std::mem::swap;

fn main() {
    let mut a = 1i64;
    let mut b = 2i64;
    swap(&mut a, &mut b);
    let mut s = "a";
    let mut t = "b";
    swap(&mut s, &mut t);
    println("{} {} {} {}", a, b, s, t);
}
