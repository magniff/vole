// The std2 item(s): std::collections::hash_set HashSet::impl Eq.
// EXPECT: true
use std::collections::HashSet;
use std::hash::FixedState;

fn same<T: Eq>(a: &T, b: &T) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa, FixedState> = [1i64].into_iter().collect_in(gpa);
    let b = a.clone();
    println("{}", same(&a, &b));
}
