// 0.25.3: include_str and include_bytes: a file's contents as a string
// literal, read when the program is compiled, the path relative to the
// file holding the call (gfx/mod.vl's from gfx/). include_str's is a str
// where one goes (UTF-8), include_bytes' a [u8] of any bytes; both in a
// const and a static; Rust's include_str!(..) is the same call.
// EXPECT: 41 2 [@compute @workgroup_size(1)]
// EXPECT: 4 0 1 254 255
// EXPECT: hello, ☺|9
// EXPECT: 11 true
mod gfx;

const NOTE: [u8] = include_str("data/note.txt");
static BLOB: [u8] = include_bytes("data/blob.bin");

fn first_line(s: str) -> str {
    s.lines().next().unwrap()
}

fn main() -> i32 {
    let w = gfx::shader();
    println("{} {} [{}]", w.len(), gfx::lines(), first_line(w));
    println("{} {} {} {} {}", BLOB.len, BLOB[0], BLOB[1], BLOB[2], BLOB[3]);
    let s: str = include_str!("data/note.txt");
    println("{}|{}", s.trim_end(), s.chars().count());
    let bytes = include_bytes("data/note.txt");
    println("{} {}", bytes.len, bytes == NOTE);
    0
}
