// A module in a subdirectory: its include_str is relative to gfx/.

const WGSL: [u8] = include_str("shader.wgsl");

pub fn shader() -> str {
    include_str("shader.wgsl")
}

pub fn lines() -> i64 {
    var n = 0;
    for c in WGSL {
        if c == '\n' {
            n += 1;
        }
    }
    n
}
