// The std item(s): std::time Instant; std::time Instant::now; std::time Instant::duration_since; std::time Instant::checked_duration_since; std::time Instant::saturating_duration_since; std::time Instant::elapsed; std::time Instant::checked_add; std::time Instant::checked_sub; std::time Instant::impl Add; std::time Instant::impl AddAssign; std::time Instant::impl Sub; std::time Instant::impl SubAssign.
// EXPECT: true true true
// EXPECT: 2s None 0ns true
use std::time::{Duration, Instant};

fn main() {
    let t0 = Instant::now();
    let t1 = Instant::now();
    println("{} {} {}", t1 >= t0, t0.elapsed() < Duration::from_secs(60),
        t1.duration_since(t0) < Duration::from_secs(60));
    let later = t0 + Duration::from_secs(2);
    let mut m = later;
    m -= Duration::from_secs(1);
    m += Duration::from_secs(1);
    println("{:?} {:?} {:?} {}", later - t0, t0.checked_duration_since(later),
        t0.saturating_duration_since(later), m == later && later.checked_sub(Duration::from_secs(2))
            == Some(t0) && t0.checked_add(Duration::from_secs(2)) == Some(later)
            && later - Duration::from_secs(2) == t0);
}
