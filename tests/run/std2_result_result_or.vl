// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::or.
// EXPECT: Ok(3) Ok(7)
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let c: Result<i64, i64> = Ok(7);
    println("{:?} {:?}", a.or(c), b.or(c));
}
