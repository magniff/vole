// EDITION: rust
// RULE: D4.3
// (0.27.1) Each call instantiates the callee's regions afresh.

fn id(x: &i64) -> &i64 {
    x
}

fn main() {
    let a: i64 = 1;
    let r1 = id(&a);
    {
        let b: i64 = 2;
        let r2 = id(&b);
        println("{}", *r2);
    }
    println("{}", *r1);
}
// EXPECT: 2
// EXPECT: 1
