// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::io Stdout::impl Write.
// EXPECT: ab
// EXPECT: 3
use std::io::{BufRead, ErrorKind, Read, Write, self};

fn main() {
    let mut o = io::stdout();
    let n = o.write("ab\n".as_bytes()).unwrap();
    o.flush().unwrap();
    println("{}", n);
}
