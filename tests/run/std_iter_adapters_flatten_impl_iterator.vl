// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Flatten::impl Iterator.
// EXPECT: Some(1) Some(2) None

fn main(gpa: Gpa) {
    let o = Vec::from_in([Some(1i64), None, Some(2)], gpa);
    let mut it = o.iter().flatten();
    let a = it.next().copied();
    let b = it.next().copied();
    println("{:?} {:?} {:?}", a, b, it.next());
}
