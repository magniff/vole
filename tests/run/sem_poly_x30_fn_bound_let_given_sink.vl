// F: FnMut(R) given a closure taking sink R: rejected (the caller would drop R twice)
// ERROR: the closure does not satisfy the bound 'F: FnMut(R)': its parameter 'r' is 'sink R', the bound gives 'let R'
// ERROR: help: a closure takes each parameter the way its bound gives it (let, inout or sink): write it so, or change the bound
// ERROR: fix --suggested
struct R { id: i64 }
impl Drop for R { fn drop(inout self) { println("drop {}", self.id); } }
fn feed<F: FnMut(R) -> i64>(f: sink F) -> i64 { let r = R { id: 1 }; f(r) + r.id }
fn main() { println("{}", feed(|r: sink R| r.id)); }
