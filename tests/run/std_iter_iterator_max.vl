// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::max.
// EXPECT: Some(4) Some("b") None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let s = Vec::from_in(["a", "b"], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{:?} {:?} {:?}", v.iter().max(), s.iter().max(), e.iter().max());
}
