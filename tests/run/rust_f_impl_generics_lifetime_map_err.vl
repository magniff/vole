// (0.30.1, review 3) An impl's `Fn*` bounds are compared with its trait's
// under the one map of lifetimes the whole signature makes: a trait's
// method lifetime maps to the impl method's own, never to the impl's
// (k24, k23: `F: FnMut(&'c str)` with 'c the impl's, for the trait's
// `F: FnMut(&'a str)`, rustc E0195/E0276; a use after free through a
// generic caller); consistent inside the bound but not with the
// parameters (k11), not one to one (k10); a named lifetime where the
// trait's is 'static.
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 5
trait T1 {
    fn f<'a, F: FnMut(&'a str)>(&self, x: &'a str, g: F);
}

struct W<'c> {
    r: &'c str,
}

impl<'c> T1 for W<'c> {
    fn f<'a, F: FnMut(&'c str)>(&self, x: &'a str, mut g: F) {
        g(self.r)
    }
}

trait T2 {
    fn f<'a, F: FnMut(&'a i64)>(&self, x: &'a i64, g: F);
}

struct V<'c> {
    r: &'c i64,
}

impl<'c> T2 for V<'c> {
    fn f<'a, F: FnMut(&'c i64)>(&self, x: &'a i64, mut g: F) {
        g(self.r)
    }
}

trait T3 {
    fn f<'a, 'b, F: FnMut(&'a i64)>(&self, x: &'a i64, y: &'b i64, g: F);
}

struct S;

impl T3 for S {
    fn f<'a, 'b, F: FnMut(&'b i64)>(&self, x: &'a i64, y: &'b i64, mut g: F) {
        g(y)
    }
}

trait T4 {
    fn f<'a, 'b, F: Fn(&'a i64, &'b i64) -> i64>(&self, x: &'a i64, y: &'b i64, g: F) -> i64;
}

impl T4 for S {
    fn f<'a, 'b, F: Fn(&'a i64, &'a i64) -> i64>(&self, x: &'a i64, y: &'b i64, g: F) -> i64 {
        1
    }
}

trait T0 {
    fn each<F: FnMut(&'static str)>(&self, f: F);
}

impl<'c> T0 for W<'c> {
    fn each<F: FnMut(&'c str)>(&self, mut f: F) {
        f(self.r)
    }
}

fn main() {}
