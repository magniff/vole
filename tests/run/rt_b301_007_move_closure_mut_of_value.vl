// XFAIL: RT-B301-7: a move closure takes `&mut` of a by-value capture whose binding is not `mut` (open, 0.30.2; 0.30.0 the same)
// `let x = 1; move || { let r = &mut x; *r = 5; }`: rustc refuses it
// (E0596, cannot borrow `x` as mutable, as it is not declared as mutable);
// vole accepts it and prints 5 then 1.
// ERROR: error[borrowck.borrow_immutable]
// ERROR-COUNT: 1
fn main() {
    let x = 1i64;
    let mut f = move || {
        let r = &mut x;
        *r = 5;
        println("{}", x);
    };
    f();
    println("{}", x);
}
