// EDITION: rust
// Indices of every integer type, including narrowed values whose high bits
// must be ignored.
// EXPECT: 30 40 50 60
// EXPECT: 440 70
// EXPECT: 10
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn main() -> i64 {
    let mut a: [i64; 64] = [0i64; 64];
    let mut k: i64 = 0;
    while k != 64 {
        a[k as usize] = k * 10;
        k += 1;
    }
    let i8i: i8 = 3;
    let u16i: u16 = 4;
    let i32i: i32 = 5;
    let u32i: u32 = 6;
    let big: i64 = 300;
    let wide: u64 = 0x100000007;
    unsafe {
        printf(c"%ld %ld %ld %ld\n", a[i8i as usize], a[u16i as usize], a[i32i as usize],
            a[u32i as usize]);
        printf(c"%ld %ld\n", a[((big as u8) % 64) as usize], a[wide as u32 as usize]);
    }
    let n: u8 = 44;
    unsafe { printf(c"%ld\n", a[((big as u8) - n + 1) as usize]); }
    0
}
