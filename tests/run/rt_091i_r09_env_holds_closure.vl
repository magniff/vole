// (0.30.2, the re-review of g302holes: r91/r09_env_holds_closure)
// EXPECT: 18
// EXPECT: 36
// A closure whose environment holds a closure that returns an iterator with a closure.
fn main() {
    let v = [1i64, 2, 3];
    let v = &v;
    let inner = move |x: i64| v.iter().map(move |y| y + x).sum::<i64>();
    let outer = move |z: i64| inner(z) * 2;
    let outer2 = move |z: i64| { let zz = [z, z + 1]; zz.iter()
        .flat_map(move |q| v.iter().map(move |r| r * q))
        .sum::<i64>() + outer(z) };
    println("{}", outer(1));
    println("{}", outer2(1));
}
