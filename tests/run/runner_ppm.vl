// (0.25.2) EXPECT-PPM: the program writes a 16x8 gradient as a PPM; its
// middle (the region 4,2 of 8x4) is tests/golden/runner_ppm.ppm, each
// channel within 1 (tests/runner/run.sh checks the comparison itself).
// EXPECT: wrote out.ppm
// EXPECT-PPM: out.ppm tests/golden/runner_ppm.ppm region 4,2,8,4 tolerance 1

use std::fs;

fn main(gpa: Gpa) -> i32 {
    var out = Buf::new_in(gpa);
    out.push_str("P6\n16 8\n255\n");
    for y in 0..8 {
        for x in 0..16 {
            out.push((x * 16) as u8);
            out.push((y * 32) as u8);
            out.push(((x + y) * 8) as u8);
        }
    }
    if fs::write("out.ppm", out.as_slice()).is_err() {
        eprintln("cannot write out.ppm");
        return 1;
    }
    println("wrote out.ppm");
    0
}
