// RT-211, a program's own form: a trait with two impls for Vec (`Put<T>`,
// `Put<&'a T>`): the bound `B: Put<I::Item>` is proved by the impl whose
// trait argument is the item, which ties the result to the iterator, `-> B`
// and `-> (B, B)` alike (rustc E0505 at the drop). v0.30.1 built it.
// ERROR: line 43
// ERROR-COUNT: 2
trait Put<T> {
    fn put1(&mut self, t: T);
}

impl<T> Put<T> for Vec<T, Gpa> {
    fn put1(&mut self, t: T) {
        self.push(t);
    }
}

impl<'a, T: Copy> Put<&'a T> for Vec<T, Gpa> {
    fn put1(&mut self, t: &'a T) {
        self.push(*t);
    }
}

fn one<I: Iterator, B: Put<I::Item>>(it: I, mut b: B) -> B {
    for x in it {
        b.put1(x);
    }
    b
}

fn two<I: Iterator, B: Put<I::Item>>(it: I, mut b: B, c: B) -> (B, B) {
    for x in it {
        b.put1(x);
    }
    (b, c)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let a: Vec<&i64, Gpa> = one(v.iter(), Vec::new_in(gpa));
    let (b, _c): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = two(v.iter(), Vec::new_in(gpa),
        Vec::new_in(gpa));
    drop(v);
    println("{:?} {:?}", a, b);
}
