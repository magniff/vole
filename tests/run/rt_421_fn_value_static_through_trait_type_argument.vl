// RT-421 (closed in 0.30.2): UNSOUND: (RT-308/RT-364's other forms) a generic fn used as a value, `v.first().map(kq::<&i64>)`, whose bound needs 'static only through a trait's type argument, `T: KeepQ<&'static i64>` with the one impl `impl KeepQ<&'static i64> for &'static i64` (or `impl<'a> KeepP<&'static i64> for &'a i64 where 'a: 'static`, or a supertrait `trait Sub: KeepQ<&'static i64>` with a blanket impl), keeps v's borrow as 'static: use after free (0.30.2)
// rustc E0597 + E0505 for each (twin .rs.txt). The direct call `kq(&v3[0])`
// is refused right (borrowck.dropped_borrowed). vole checks it clean;
// --check-alloc: `use after free: block #1 (32 bytes), allocated at
// line 57, freed at line 59`. The KeepQ and Sub forms since v0.28.0; the
// KeepP form since v0.30.1 (earlier releases refused its impl). RT-364's
// forms are an associated type equality, a where clause, an impl's
// `where 'a: 'static` with a trait without type parameters, and a
// two-level blanket impl; here the 'static is in the bound trait's type
// argument, which the impl matches.
// FLAGS: --check-alloc
// ERROR: line 58
// ERROR: line 62
// ERROR: line 66
// (each ERROR is at the borrow `v.first()`, as for the direct call)
trait KeepP<X> {
    fn keepp(self) -> X;
}

impl<'a> KeepP<&'static i64> for &'a i64
    where
        'a: 'static,
{
    fn keepp(self) -> &'static i64 {
        self
    }
}

trait KeepQ<X> {
    fn keepq(self) -> X;
}

impl KeepQ<&'static i64> for &'static i64 {
    fn keepq(self) -> &'static i64 {
        self
    }
}

trait Sub: KeepQ<&'static i64> {}

impl<T: KeepQ<&'static i64>> Sub for T {}

fn kp<T: KeepP<&'static i64>>(x: T) -> &'static i64 {
    x.keepp()
}

fn kq<T: KeepQ<&'static i64>>(x: T) -> &'static i64 {
    x.keepq()
}

fn ks<T: Sub>(x: T) -> &'static i64 {
    x.keepq()
}

fn main(gpa: Gpa) {
    let mut v1: Vec<i64, Gpa> = Vec::new_in(gpa);
    v1.push(1001);
    let a: Option<&'static i64> = v1.first().map(kp::<&i64>);
    drop(v1);
    let mut v2: Vec<i64, Gpa> = Vec::new_in(gpa);
    v2.push(1002);
    let b: Option<&'static i64> = v2.first().map(kq::<&i64>);
    drop(v2);
    let mut v3: Vec<i64, Gpa> = Vec::new_in(gpa);
    v3.push(1003);
    let c: Option<&'static i64> = v3.first().map(ks::<&i64>);
    drop(v3);
    println("{:?} {:?} {:?}", a, b, c);
}
