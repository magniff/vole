// 0.26.2: gpu.entry for a RenderDesc's literal entry name (diagnostic 6),
// the shader made from `R.src` in the function.
// ERROR: error[gpu.entry]: the block 'R' has no @fragment fn 'frag'; its entry points: vs (vertex), fs (fragment)
// ERROR: err_gpu_entry_desc.vl: line 19, column 55
// ERROR: help: the block's field names its entry point: R.fs
use std::gpu;

embed wgsl R {
    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
        return vec4<f32>(0.0, 0.0, 0.0, 1.0);
    }
    @fragment fn fs() -> @location(0) vec4<f32> {
        return vec4<f32>(1.0, 0.0, 0.0, 1.0);
    }
}

fn pipe(dev: gpu::Device) -> Result<gpu::RenderPipeline, gpu::Error> {
    let s = dev.shader_wgsl(R.src)?;
    dev.render_pipeline(gpu::RenderDesc::new(s, "vs", "frag", gpu::Format::Bgra8Unorm))
}

fn main() -> i32 {
    0
}
