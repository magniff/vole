// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a17_box)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A Box parameter: the callee writes through its pointer.
fn poke(b: &Box<i64, Gpa>) -> bool {
    let p = &**b as *const i64 as *mut i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(b: &Box<i64, Gpa>) -> i64
    requires poke(b)
{
    **b
}

fn main(gpa: Gpa) {
    let b = Box::new_in(1i64, gpa);
    println("{}", f(&b));
    println("{}", *b);
}
