use std::alloc::Allocator; struct P<'a, A: Allocator> { q: &'a mut Vec<i64, A> }
fn mk(v: &mut Vec<i64, Gpa>) -> P<'_, Gpa> { P { q: v } }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut p = mk(&mut v);
    v.push(1);
    p.q.push(2);
    println("{}", v.len());
    0
}
