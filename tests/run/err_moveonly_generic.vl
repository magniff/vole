// (0.25) A generic struct instantiated with a struct holding an inout
// access is move-only.
struct C<'a> { n: &'a mut i64 }
struct W<T> { x: T }

fn main() {
    let mut x: i64 = 1; let w = W { x: C { n: &mut x } }; let v = w; *v.x.n += 1; *w.x.n += 1;
    println("{x}");
}
