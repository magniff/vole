// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map ValuesMut::impl Iterator.
// EXPECT: Some(70)
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 7);
    if let Some(v) = m.values_mut().next() {
        *v *= 10;
    }
    println("{:?}", m.get(&1));
}
