// ERROR: the trait 'Tr<i64>' is not implemented for 'A'
// (RT-275) a trait impl's header, `impl<A: Tr<i32>> Q for G<A>` of
// `struct G<T: Tr<i64>>` (rustc E0277; v0.30.1 said nothing).
trait Tr<U> {}

trait Q {
    fn q(&self) -> i64;
}

struct G<T: Tr<i64>> {
    t: T,
}

impl<A: Tr<i32>> Q for G<A> {
    fn q(&self) -> i64 {
        1
    }
}

fn main() {
    println("{}", 1);
}
