// EDITION: rust
// RULE: F8.4
// `<T as Tr>::f(..)` in an expression calls T's impl of Tr: a
// primitive's FromStr, a struct's own trait (as rustc).
// EXPECT: -7 5
use std::str::FromStr;

struct W {
    v: i64,
}

trait Make {
    fn make() -> Self;
}

impl Make for W {
    fn make() -> W {
        W { v: 5 }
    }
}

fn main() {
    let b = <i32 as FromStr>::from_str("-7").unwrap();
    let w = <W as Make>::make();
    println("{} {}", b, w.v);
}
