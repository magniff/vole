// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::split_ascii_whitespace.
// EXPECT: ["x", "y", "z"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "x  y\r\nz ".split_ascii_whitespace().collect_in(gpa);
    println("{:?}", v);
}
