// EDITION: rust
// RULE: F18.5
// (0.28.0) An open local is a leaf of the trees built from it, one variable
// with the locals they make, as in rustc: `let c = a;`, `let b = a + 1;`,
// `let p = a * k;` and `let m = if x > 0 { a } else { 0 };` leave a, b, c,
// k and m open, and the use that types one types them all (`return c` in
// an i64 function: `1 << 40` is an i64). Before, the use in the second
// `let` closed a at i32 (256, 255). With no use that types them, the
// fallback is i32's (`small`).
// EXPECT: 1099511627776
// EXPECT: 1099511627776
// EXPECT: 3298534883328
// EXPECT: 1099511627777 1099511627776
// EXPECT: 3 4
// EXPECT: 1099511627776 0
fn copy() -> i64 {
    let a = 1 << 40;
    let c = a;
    c
}

fn plus() -> i64 {
    let a = (1 << 40) - 1;
    let b = a + 1;
    b
}

fn product() -> i64 {
    let a = 1 << 40;
    let k = 3;
    let p = a * k;
    p
}

fn chain(x: i64) -> i64 {
    let a = 1 << 40;
    let b = a + 1;
    let c = b - 1;
    if x > 0 {
        return b;
    }
    c
}

fn pick(x: i64) -> i64 {
    let a = 1 << 40;
    let m = if x > 0 { a } else { 0 };
    m
}

fn small() -> f64 {
    let a = 3;
    let b = a + 1;
    let c = a;
    (c * 10 + b) as f64
}

fn main() {
    println("{}", copy());
    println("{}", plus());
    println("{}", product());
    println("{} {}", chain(1), chain(0));
    let s = small() as i64;
    println("{} {}", s / 10, s % 10);
    println("{} {}", pick(1), pick(0));
}
