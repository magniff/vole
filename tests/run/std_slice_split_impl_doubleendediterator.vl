// Runs on std since 0.27.2's switch.
// The std item(s): std::slice Split::impl DoubleEndedIterator.
// EXPECT: [3] [2] [1]

fn main() {
    let s: &[i64] = &[1, 0, 2, 0, 3];
    let mut it = s.split(|x| *x == 0);
    println("{:?} {:?} {:?}", it.next_back().unwrap(), it.next_back().unwrap(),
        it.next_back().unwrap());
}
