// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Allocator::shrink.
// EXPECT: 5
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let a = Layout::array::<u64>(2).unwrap();
    let b = Layout::new::<u64>();
    let p = gpa.allocate(a).unwrap();
    // UNSAFE: the block is written, shrunk, read and given back.
    // SAFETY: p is gpa's with layout a; q with layout b.
    unsafe {
        (p.as_ptr() as *mut u64)[0] = 5;
        let q = gpa.shrink(p, a, b).unwrap();
        println("{}", (q.as_ptr() as *mut u64)[0]);
        gpa.deallocate(q, b);
    }
}
