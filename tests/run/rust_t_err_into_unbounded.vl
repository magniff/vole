// RUSTC: none a type error (E0277): the twin compares the borrow checker's verdicts
// RULE: D22.3
// (0.28.0) `x.into()` of a type parameter with no `Into` bound is
// refused at the definition, whatever the instances convert.
// ERROR: cannot convert 'T' into 'M': no impl of 'From<T>' for 'M'
// ERROR-COUNT: 1
struct M {
    m: f64,
}

struct F {
    ft: f64,
}

impl From<F> for M {
    fn from(f: F) -> M {
        M { m: f.ft }
    }
}

fn bad<T>(x: T) -> M {
    x.into()
}

fn main() {
    println("{}", bad(F { ft: 1.0 }).m);
}
