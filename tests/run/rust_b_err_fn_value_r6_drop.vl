// RULE: R6
// (0.30.2) The must-fail twins of rust_b_fn_value_r6_ok.vl: a callable
// whose result borrows what its argument borrows, given to an Fn bound
// or held as a `fn` value (a parameter, a struct's or an enum's field, a
// Vec's element, behind a generic forwarder, an opaque `impl Fn` that
// captures, a closure checked against another bound first, Iterator's
// adapters), keeps the borrow: each drop while the result lives is
// refused, as rustc refuses it (E0505, the twin). Before, most were
// accepted: a use after free from safe code (RT-282, RT-297, RT-310).
// FLAGS: --check-alloc
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 117
// ERROR: line 120
// ERROR: line 123
// ERROR: line 126
// ERROR: line 129
// ERROR: line 132
// ERROR: line 135
// ERROR: line 139
// ERROR: line 142
// ERROR: line 145
// ERROR: line 148
// ERROR: line 151
// ERROR: line 154
// ERROR: line 159
// ERROR: line 163
// ERROR-COUNT: 15
fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn idr<'a>(x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn two<'a, 'b>(x: &'a i64, _y: &'b i64) -> &'a i64 {
    x
}

fn sec<'a, 'b>(_x: &'a i64, y: &'b i64) -> &'b i64 {
    y
}

fn sc<'a>(s: &mut i64, x: &'a i64) -> Option<&'a i64> {
    *s += 1;
    Some(x)
}

fn mkv(k: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(k);
    v
}

fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    f(t)
}

fn fw<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    ap(t, f)
}

fn ap2<A, B, U, F: Fn(A, B) -> U>(a: A, b: B, f: F) -> Option<U> {
    Some(f(a, b))
}

fn aph<F: Fn(&i64) -> &i64>(x: &i64, f: F) -> &i64 {
    f(x)
}

struct Holder<A, B> {
    f: fn(A) -> B,
}

struct Outer<A, B> {
    h: Holder<A, B>,
    n: i64,
}

fn apo<T, U>(t: T, o: Outer<T, U>) -> Option<U> {
    Some((o.h.f)(t))
}

struct Back<A, B> {
    f: fn(B) -> A,
}

fn apb<T, U>(t: T, h: Back<U, T>) -> Option<U> {
    Some((h.f)(t))
}

enum E<A, B> {
    F(fn(A) -> B),
    N,
}

fn ape<T, U>(t: T, e: E<T, U>) -> Option<U> {
    match e {
        E::F(g) => Some(g(t)),
        E::N => None,
    }
}

fn mkcap<'a>(r: &'a i64) -> impl Fn(&i64) -> &'a i64 {
    move |_x| r
}

fn mkc<F: Fn(&i64) -> &i64>(f: F) -> F {
    f
}

fn main(gpa: Gpa) {
    let w = mkv(2000, gpa);
    let z = 5i64;
    let v1 = mkv(1, gpa);
    let r1 = aph(&v1[0], idr2);
    drop(v1);
    let v2 = mkv(2, gpa);
    let r2 = apo(&v2[0], Outer { h: Holder { f: idr2 }, n: 1 });
    drop(v2);
    let v3 = mkv(3, gpa);
    let r3 = apb(&v3[0], Back { f: idr2 });
    drop(v3);
    let v4 = mkv(4, gpa);
    let r4 = ape(&v4[0], E::F(idr2));
    drop(v4);
    let v5 = mkv(5, gpa);
    let r5: Vec<&i64, Gpa> = v5.iter().filter_map(idr).collect_in(gpa);
    drop(v5);
    let v6 = mkv(6, gpa);
    let r6: Vec<&i64, Gpa> = v6.iter().flat_map(idr).collect_in(gpa);
    drop(v6);
    let v7 = mkv(7, gpa);
    let r7: Vec<&i64, Gpa> = v7.iter().map(idr2).collect_in(gpa);
    drop(v7);
    let v8 = mkv(8, gpa);
    let mut i8 = v8.iter().map(idr2);
    let r8 = i8.next();
    drop(v8);
    let v9 = mkv(9, gpa);
    let r9 = Some(&z).map(mkcap(&v9[0]));
    drop(v9);
    let v10 = mkv(10, gpa);
    let r10: Vec<&i64, Gpa> = v10.iter().scan(0i64, sc).collect_in(gpa);
    drop(v10);
    let v11 = mkv(11, gpa);
    let r11 = ap2(&w[0], &v11[0], sec);
    drop(v11);
    let v12 = mkv(12, gpa);
    let r12 = ap2(&v12[0], &w[0], two);
    drop(v12);
    let v13 = mkv(13, gpa);
    let r13 = fw(&v13[0], idr2);
    drop(v13);
    let v15 = mkv(15, gpa);
    let mut fs: Vec<fn(&i64) -> &i64, Gpa> = Vec::new_in(gpa);
    fs.push(idr2);
    let r15 = v15.first().map(fs[0]);
    drop(v15);
    let v16 = mkv(16, gpa);
    let c16 = mkc(|x| x);
    let r16 = ap(&v16[0], c16);
    drop(v16);
    println("{} {:?} {:?} {:?} {} {} {} {:?} {:?} {} {:?} {:?} {} {:?} {}", r1, r2, r3, r4,
        r5.len(), r6.len(), r7.len(), r8, r9, r10.len(), r11, r12, r13, r15, r16);
}
