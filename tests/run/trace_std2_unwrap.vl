// (0.28.0) --trace: a failed unwrap in a program prints its line (the
// caller's place, gap 79), then the calls that led to it: std2's panic
// ends in the trace runtime's dump, as a failed check does.
// FLAGS: --trace
// EXIT: 101
// STDERR: trace_std2_unwrap.vl:12:5: called `Result::unwrap()` on an `Err` value: ParseIntError { kind: InvalidDigit }
// STDERR: trace, innermost call first:
// STDERR: trace_std2_unwrap.vl:12  port_of
// STDERR: trace_std2_unwrap.vl:16  show
// STDERR: trace_std2_unwrap.vl:20  main
fn port_of(value: &str) -> i64 {
    value.parse::<i64>().unwrap()
}

fn show(value: &str) {
    println("{}", port_of(value));
}

fn main() {
    show("80a");
}
