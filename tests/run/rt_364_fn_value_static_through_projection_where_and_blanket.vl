// XFAIL: RT-364: UNSOUND: (RT-308's other forms) a generic fn used as a value, `v.first().map(kb::<&i64>)`, whose bound needs 'static only through an associated type equality (`T: Tr<Out = &'static i64>`), a where clause, an impl's `where 'a: 'static`, or a blanket impl over a trait whose only impl is for `&'static i64`, keeps v's borrow as 'static: use after free (0.30.2)
// rustc E0597 + E0505 for each (twin .rs.txt). The direct calls
// (`ka(&v[0])`, `kw(&v[0])`, ...) are refused right by vole too
// (borrowck.dropped_borrowed). --check-alloc: use after free, block #1
// freed at the first drop. A fixed check reports at each borrow, as for
// the direct call.
// FLAGS: --check-alloc
// ERROR: line 80
// ERROR: line 84
// ERROR: line 88
// ERROR: line 92
trait Tr {
    type Out;
    fn get(self) -> Self::Out;
}

impl<'a> Tr for &'a i64 {
    type Out = &'a i64;

    fn get(self) -> &'a i64 {
        self
    }
}

trait Keep {
    fn keep(self) -> &'static i64;
}

impl Keep for &'static i64 {
    fn keep(self) -> &'static i64 {
        self
    }
}

trait Keep2 {
    fn keep2(self) -> &'static i64;
}

impl<T: Keep> Keep2 for T {
    fn keep2(self) -> &'static i64 {
        self.keep()
    }
}

trait Kw {
    fn kw(self) -> &'static i64;
}

impl<'a> Kw for &'a i64
    where
        'a: 'static,
{
    fn kw(self) -> &'static i64 {
        self
    }
}

fn ka<T: Tr<Out = &'static i64>>(x: T) -> &'static i64 {
    x.get()
}

fn kc<T>(x: T) -> &'static i64
    where
        T: Keep,
{
    x.keep()
}

fn kd<T: Keep2>(x: T) -> &'static i64 {
    x.keep2()
}

fn ke<T: Kw>(x: T) -> &'static i64 {
    x.kw()
}

fn main(gpa: Gpa) {
    let mut v1: Vec<i64, Gpa> = Vec::new_in(gpa);
    v1.push(1001);
    let a: Option<&'static i64> = v1.first().map(ka::<&i64>);
    drop(v1);
    let mut v2: Vec<i64, Gpa> = Vec::new_in(gpa);
    v2.push(1002);
    let c: Option<&'static i64> = v2.first().map(kc::<&i64>);
    drop(v2);
    let mut v3: Vec<i64, Gpa> = Vec::new_in(gpa);
    v3.push(1003);
    let d: Option<&'static i64> = v3.first().map(kd::<&i64>);
    drop(v3);
    let mut v4: Vec<i64, Gpa> = Vec::new_in(gpa);
    v4.push(1004);
    let e: Option<&'static i64> = v4.first().map(ke::<&i64>);
    drop(v4);
    println("{:?} {:?} {:?} {:?}", a, c, d, e);
}
