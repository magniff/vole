// XFAIL: RT-337: UNSOUND: an explicit destructor call by path or fn value, `Vec::drop(&mut v)`, `let f = Box::<..>::drop; f(&mut b)`, `W::drop(&mut a)`, is accepted (rustc E0040), and the Drop runs twice: a double free in safe code (0.30.2)
// E0040 is decided only for a method call (synth_method). The fn-value
// form is rt_337b, the program-type form rt_337c. Since v0.30.1 at least.
// From the re-review of g302index.
// FLAGS: --check-alloc
// ERROR: line 10
fn main(gpa: Gpa) {
    let mut v: Vec<Box<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(Box::new_in(1, gpa));
    Vec::drop(&mut v);
    println("end {}", v.len());
}
