// XFAIL: RT-467c: (RT-467, a generic struct's field) `w.x.bump()` on `let mut w = W { x: 1500000000 };` (`struct W<T> { x: T }`), then `let b: i64 = w.x;`, runs i32's `bump(&mut self)`: -O0 panics on the overflow, -O2 prints -1294967296; rustc prints 3000000000 (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 3000000000
trait Bump { fn bump(&mut self); }
impl Bump for i32 { fn bump(&mut self) { *self = *self * 2; } }
impl Bump for i64 { fn bump(&mut self) { *self = *self * 2; } }
struct W<T> { x: T }

fn main() {
    let mut w = W { x: 1500000000 };
    w.x.bump();
    let b: i64 = w.x;
    println("{}", b);
}
