// The std2 item(s): std::iter Iterator::peekable.
// EXPECT: Some(1) 1 Some(2)

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = v.iter().peekable();
    let p = it.peek().copied();
    let n = it.next().unwrap();
    println("{:?} {} {:?}", p, n, it.peek().copied());
}
