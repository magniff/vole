// The std2 item(s): std::panic assert, assert_eq, assert_ne, panic, unreachable in a
// program: each failure says FILE:LINE:COL first; an assertion is a check, with its
// condition's text and its operands' values; assert_eq and assert_ne compare in place
// (their arguments are not moved).
// RUSTC: none (the place and the check's text are vole's form)
// EXIT: 101
// EXPECT: ab ab
// EXPECT: ab ab
// STDERR: std2_panic_location.vl:17:9: assertion failed: 'x + 1 == 4'
fn pick(which: i64, x: i64, gpa: Gpa) {
    let v = String::from_in("ab", gpa);
    let w = String::from_in("ab", gpa);
    assert_eq(v, w);
    assert_ne(v.len(), 3);
    println("{v} {w}");
    if which == 0 {
        assert(x + 1 == 4);
    }
}

fn main(gpa: Gpa) {
    pick(1, 2, gpa);
    pick(0, 2, gpa);
}
