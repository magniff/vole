// RULE: F18.5
// (0.27.7) A shift of a literal bound by an unannotated `let` is open
// until a use solves it: the first, `let a: i64 = bit`, makes it i64, so
// the later u8 use is a type error (rustc E0308). Before 0.27.7 the
// literal was i32 at the `let` and the first use the error.
// ERROR: error[type error]: expected 'u8', got 'i64'
fn main() {
    let s: u32 = 3;
    let bit = 1 << s;
    let a: i64 = bit;
    let b: u8 = bit;
    println("{} {}", a, b);
}
