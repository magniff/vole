// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::cloned.
// EXPECT: ["a", "b"]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let a = "a".to_string_in(gpa);
    let b = "b".to_string_in(gpa);
    let v = Vec::from_in([a, b], gpa);
    let a: Vec<String<Gpa>, Gpa> = v.iter().cloned().collect_in(gpa);
    println("{:?}", a);
}
