// EDITION: rust
// RULE: F27.1
// A match of struct patterns is checked for exhaustiveness field by
// field; the missing value is shown as a struct pattern (rustc E0004).
// ERROR: non-exhaustive match: 'Point { x: 1, y: -9223372036854775808..=1, .. }' is not covered
struct Point {
    x: i64,
    y: i64,
}

fn f(p: Point) -> i64 {
    match p {
        Point { x: 0, .. } => 0,
        Point { x: 1, y: 2 } => 1,
        Point { x: 1, y: 3..=i64::MAX } => 2,
        Point { x: i64::MIN..=-1, .. } => 3,
        Point { x: 2..=i64::MAX, .. } => 4,
    }
}

fn main() -> i64 {
    f(Point { x: 0, y: 0 })
}
