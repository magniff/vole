// RULE: E3.3c (0.30.1) What a listed type parameter does passes its
// declaration: its trait's methods called through it, directly or through
// a callee generic over it (W<T>::show, a generic fn), a drop of its
// value, and its closure's call. Here T's method panics and prints, and
// each `#[effects(T)]` holds (err_effect_type_param_own_methods is what
// does not).
// EXPECT: loud 1
// EXPECT: loud 2
// EXPECT: loud 3
// EXPECT: 4
// EXPECT: dropped

trait Shout {
    fn shout(&self) -> i64;
}

struct Loud {
    n: i64,
}

impl Shout for Loud {
    fn shout(&self) -> i64 {
        assert(self.n < 100);
        println("loud {}", self.n);
        self.n
    }
}

impl Drop for Loud {
    fn drop(&mut self) {
        if self.n == 9 {
            println("dropped");
        }
    }
}

struct W<T> {
    x: T,
}

impl<T: Shout> W<T> {
    fn show(&self) -> i64 {
        self.x.shout()
    }
}

fn twice<T: Shout>(x: &T) -> i64 {
    x.shout()
}

#[effects(T)]
fn direct<T: Shout>(x: &T) -> i64 {
    x.shout()
}

#[effects(T)]
fn through_struct<T: Shout>(w: &W<T>) -> i64 {
    w.show()
}

#[effects(T)]
fn through_fn<T: Shout>(x: &T) -> i64 {
    twice(x)
}

#[effects(F)]
fn call<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

#[effects(T)]
fn consume<T>(x: T) {
    let _ = x;
}

fn main() {
    direct(&Loud { n: 1 });
    through_struct(&W { x: Loud { n: 2 } });
    through_fn(&Loud { n: 3 });
    println("{}", call(|| 4));
    consume(Loud { n: 9 });
}
