// EDITION: rust
// RULE: F7.3
// A unit struct is a value of its type, where a value is synthesized and
// where one of its type is expected (an argument).
// EXPECT: 4
struct Unit;

impl Unit {
    fn three(&self) -> i64 {
        3
    }
}

fn take(u: Unit) -> i64 {
    1
}

fn main() -> i64 {
    let u = Unit;
    std::print_int(u.three() + take(Unit));
    println("");
    0
}
