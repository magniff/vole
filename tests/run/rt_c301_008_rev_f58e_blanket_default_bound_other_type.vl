// RULE: F8.3, F8.4
// RT-C301-8 review (R4, form f58e_blanket_default_bound_other_type): the same with Base declaring a K and an mk of other types.
// rustc prints the EXPECT lines.
// EXPECT: 11
trait Base { const K: bool; fn mk() -> bool; }
trait A { const K: i64; fn mk() -> i64; fn show(&self) -> i64 { Self::K + Self::mk() } }
impl<T: Base> A for T { const K: i64 = 1; fn mk() -> i64 { 10 } }
struct S;
impl Base for S { const K: bool = true; fn mk() -> bool { false } }
fn main() { println("{}", S.show()); }
