// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc AnyAlloc.
// EXPECT: [1, 2]
use std::alloc::AnyAlloc;

fn fill(a: AnyAlloc<'_>) -> usize {
    let mut v = Vec::new_in(a);
    v.push(1);
    v.push(2);
    println("{:?}", v);
    v.len()
}

fn main(gpa: Gpa) {
    fill(AnyAlloc::new(&gpa));
}
