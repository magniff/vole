// EDITION: rust
// std::take of an Option<T> through inout T
// FLAGS: --check-alloc
// EXPECT: true true
// EXPECT: drop 1
use std::mem; struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn grab<T>(o: &mut Option<T>) -> Option<T> { mem::take(&mut (o)) }

fn main() {
    let mut o = Some(R { id: 1 });
    let g = grab(&mut o);
    println("{} {}", o.is_none(), g.is_some());
}
