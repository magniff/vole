// EDITION: rust
// RULE: Z9.1c
// (0.27.4) `&T` of a parameter bound to a view is a reference to the view:
// `Iter<&str>` yields `&&str`, which `copied` makes `&str` again, and
// `Option<&&str>::copied` is an `Option<&str>`. Vec<&str>'s `Extend<T>`
// and `Extend<&T>` are two impls, not one.
// EXPECT: ["ab", "cde"]
// EXPECT: Some("ab")
// EXPECT: 3 5
fn longest(a: &&str, b: &&str) -> usize {
    if a.len() > b.len() { a.len() } else { b.len() }
}

fn main(gpa: Gpa) {
    let words = ["ab", "cde"];
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    for s in words.iter() {
        v.push(*s);
    }
    println("{:?}", v);
    let first: Option<&str> = words.iter().next().copied();
    println("{:?}", first);
    let mut w: Vec<&str, Gpa> = Vec::new_in(gpa);
    w.extend(words.iter());
    w.extend(words.iter().copied());
    let total: usize = w.iter().map(|s| s.len()).sum();
    println("{} {}", longest(&words[0], &words[1]), total / 2);
}
