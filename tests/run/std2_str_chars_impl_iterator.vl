// The std2 item(s): std::str Chars::impl Iterator.
// EXPECT: 4 ['a', 'ß', '€', '😀'] None
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    let mut it = "aß€😀".chars();
    while let Some(c) = it.next() {
        v.push(c);
    }
    println("{} {:?} {:?}", v.len(), v, it.next());
}
