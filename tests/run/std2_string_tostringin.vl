// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::string ToStringIn.
// EXPECT: 7 true
use std::string::ToStringIn;

fn show<T: ToStringIn<Gpa>>(x: &T, gpa: Gpa) -> String<Gpa> {
    x.to_string_in(gpa)
}

fn main(gpa: Gpa) {
    let s = show(&7, gpa);
    println("{} {}", s, s == "7");
}
