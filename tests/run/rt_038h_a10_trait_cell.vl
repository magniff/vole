// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a10_trait_cell)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'S::poke', which writes through a shared reference (a cell)
// A trait method on a struct holding a Cell sets it.
use std::cell::Cell;
trait Poke { fn poke(&self) -> bool; }
struct S { c: Cell<i64> }

impl Poke for S {
    fn poke(&self) -> bool {
        self.c.set(9);
        true
    }
}

fn f(s: &S) -> i64
    requires s.poke()
{
    1
}

fn main() {
    let s = S { c: Cell::new(1) };
    println("{}", f(&s));
    println("{}", s.c.get());
}
