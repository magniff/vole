// Patterns on references (0.18.1, Rust's default binding modes): a
// pattern matched against `&E` (`&mut E`) matches the E, and its bindings
// are `&T` (`&mut T`) references into it; a slice binds a copy. In
// `match`, `if let` and `let`, nested (`Option<&E>`), in a generic, and as
// a switch on the tag. References to two fields of one value are apart.
// EXPECT: 3 5 0 6 12
// EXPECT: 4 5 0 107 92
// EXPECT: 7 -1 100 200 300 43 7
// EXPECT: 6 4 12 0 0 3
// EXPECT: 7 9 7 0 26
use std::alloc::Allocator; use std::ops::Add; use std::ops::Sub; use std::ops::Mul;
use std::ops::Div; use std::ops::Neg;
enum E<'a, A: Allocator> { A(i64), B(&'a str), C, D(Vec<i64, A>, i64), P((i64, i64)) }
#[derive(Clone, Copy)] enum Tok { Num(i64), Op(u8) }
#[derive(Copy)] enum Op<'a> { Add(i64), Sub(i64), Mul(i64), Div(i64), Neg, Name(&'a str) } impl Clone for Op<'_> { fn clone(&self) -> Self { *self } }
enum Tree<A: Allocator> { Leaf(i64), Node(Vec<Tree<A>, A>) }

fn f(e: &E<'_, Gpa>) -> i64 {
    match e {
        E::A(x) => *x,
        E::B(s) => s.len() as i64,
        E::C => 0,
        E::D(v, k) => v.len() as i64 + *k,
        E::P((a, b)) => *a * 10 + *b,
    }
}

fn bump(e: &mut E<'_, Gpa>) {
    match e {
        E::A(x) => { *x += 1; }
        E::D(v, k) => {
            v.push(*k);
            *k += 100;
        }
        E::P((a, _)) => { *a = 9; }
        _ => {}
    }
}

fn g(o: Option<i64>) -> i64 { match o { Some(x) => x, None => -1 } }

fn lit(r: i64) -> i64 { match r { 0 => 100, 1..=5 => 200, _ => 300 } }

fn tok(t: Tok) -> i64 { if let Tok::Op(c) = t { c as i64 } else { 0 } }

fn pair(p: (i64, &str)) -> i64 {
    let (n, s) = p;
    n + s.len() as i64
}

fn apply(op: Op<'_>, x: i64) -> i64 {
    match op {
        Op::Add(n) => x + n,
        Op::Sub(n) => x - n,
        Op::Mul(n) => x * n,
        Op::Div(n) => if n == 0 { 0 } else { x / n },
        Op::Neg => -x,
        Op::Name(s) => x + s.len() as i64,
    }
}

fn sum(t: &Tree<Gpa>) -> i64 {
    match t {
        Tree::Leaf(v) => *v,
        Tree::Node(kids) => {
            let mut s: i64 = 0;
            for k in kids.iter() { s += sum(k); }
            s
        }
    }
}

fn first<T>(o: Option<T>, d: T) -> T { match o { Some(x) => x, None => d } }

fn opt(o: Option<&Op<'_>>) -> i64 { match o { Some(Op::Add(n)) => *n, Some(_) => 1, None => 0 } }

fn pairs(v: &Vec<(i64, i64), Gpa>) -> i64 {
    let mut t: i64 = 0;
    for i in 0..v.len() {
        let (a, b) = v[i];
        t += a * b;
    }
    t
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut es: Vec<E<'_, Gpa>, Gpa> = Vec::new_in(gpa);
    es.push(E::A(3i64));
    es.push(E::B("hello"));
    es.push(E::C);
    es.push(E::D(v, 5i64));
    es.push(E::P((1i64, 2i64)));
    for i in 0..es.len() { if i > 0 { print(" "); } print("{}", f(&es[i])); }
    println("");
    for i in 0..es.len() { bump(&mut es[i]); }
    for i in 0..es.len() { if i > 0 { print(" "); } print("{}", f(&es[i])); }
    println("");
    let o = Some(7i64);
    let n: Option<i64> = None;
    let z: i64 = 0;
    let t: i64 = 3;
    let h: i64 = 9;
    let op = Tok::Op(b'+');
    let pr = (4, "abc");
    println("{} {} {} {} {} {} {}", g(o), g(n), lit(z), lit(t), lit(h), tok(op), pair(pr));
    let ops = [Op::Add(5i64), Op::Sub(2i64), Op::Mul(3i64), Op::Div(0i64), Op::Neg,
        Op::Name("abc")];
    let mut x: i64 = 1;
    for i in 0..6 {
        x = apply(ops[i as usize], x);
        if i > 0 { print(" "); }
        print("{}", x);
    }
    println("");
    let mut kids: Vec<Tree<Gpa>, Gpa> = Vec::new_in(gpa);
    kids.push(Tree::Leaf(3i64));
    kids.push(Tree::Leaf(4i64));
    let tr = Tree::Node(kids);
    let so = Some(9i64);
    let a = Op::Add(7i64);
    let mut pv: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    pv.push((2, 3));
    pv.push((4, 5));
    println("{} {} {} {} {}", sum(&tr), first(so, 0i64), opt(Some(a)), opt(None), pairs(&pv));
}
