// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::partition_in.
// EXPECT: [2, 4] [1, 3]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let (e, o): (Vec<i64, Gpa>, Vec<i64, Gpa>) = v
        .iter()
        .copied()
        .partition_in(|x| x % 2 == 0, gpa);
    println("{:?} {:?}", e, o);
}
