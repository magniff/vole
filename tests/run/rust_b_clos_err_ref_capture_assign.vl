// EDITION: rust
// RULE: D19.2
// (0.27.2) A by-`&` capture is a loan held while the closure lives:
// assigning the variable before the last call is a conflict (rustc E0506).
// ERROR: error[borrowck.assign_borrowed]
fn main() {
    let mut k = 1;
    let f = || k + 2;
    k = 2;
    println("{} {}", f(), k);
}
