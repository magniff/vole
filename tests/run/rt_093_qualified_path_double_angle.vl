// RT-93: a nested qualified path written `<<T as A>::B as C>::D` (rustfmt's form), in a
// result type and in an expression. 0.30.1: `error[parser error] expected type, got '<<'`
// (the `<<` read as a shift); `volec fmt` glued it, `-><<T as Conv>::Out`. Now the parser
// takes `<<` at a type's or an expression path's start as two `<`, and fmt keeps it as
// written. rustc builds it and prints the EXPECT lines.
// EXPECT: 44000
// EXPECT: 7
trait Conv {
    type Out;
    fn conv(&self) -> Self::Out;
    fn make() -> Self;
}

impl Conv for i64 {
    type Out = u8;

    fn conv(&self) -> u8 {
        (*self & 255) as u8
    }

    fn make() -> i64 {
        3
    }
}

impl Conv for u8 {
    type Out = i64;

    fn conv(&self) -> i64 {
        *self as i64 * 1000
    }

    fn make() -> u8 {
        7
    }
}

fn roundtrip<T: Conv>(t: T) -> <<T as Conv>::Out as Conv>::Out
    where
        T::Out: Conv,
{
    t.conv().conv()
}

fn main() {
    println("{}", roundtrip(300i64));
    let m = <<i64 as Conv>::Out as Conv>::make();
    println("{m}");
}
