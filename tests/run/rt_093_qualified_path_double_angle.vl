// XFAIL: RT-93: a nested qualified path written `<<T as A>::B as C>::D` (rustfmt's form) is a parser error: `<<` is read as a shift (0.30.2)
// rustc builds it and prints the EXPECT lines. vole: `error[parser error]
// expected type, got '<<'` in the result type, and in an expression path
// the same. With a space (`< <T as Conv>::Out as Conv>::Out`) or as
// `<T::Out as Conv>::Out` the program builds and prints the same lines.
// EXPECT: 44000
// EXPECT: 7
trait Conv {
    type Out;
    fn conv(&self) -> Self::Out;
    fn make() -> Self;
}

impl Conv for i64 {
    type Out = u8;
    fn conv(&self) -> u8 {
        (*self & 255) as u8
    }
    fn make() -> i64 {
        3
    }
}

impl Conv for u8 {
    type Out = i64;
    fn conv(&self) -> i64 {
        *self as i64 * 1000
    }
    fn make() -> u8 {
        7
    }
}

fn roundtrip<T: Conv>(t: T) -> <<T as Conv>::Out as Conv>::Out
where
    T::Out: Conv,
{
    t.conv().conv()
}

fn main() {
    println("{}", roundtrip(300i64));
    let m = <<i64 as Conv>::Out as Conv>::make();
    println("{m}");
}
