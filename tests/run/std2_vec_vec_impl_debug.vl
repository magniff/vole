// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl Debug.
// EXPECT: [1, 2] [] ["a"]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let s = Vec::from_in(["a"], gpa);
    println("{:?} {:?} {:?}", v, e, s);
}
