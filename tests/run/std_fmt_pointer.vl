// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::fmt Pointer.
// EXPECT: true
use std::fmt::{Formatter, Pointer};

struct Addr {
    p: *const i64,
}

impl Pointer for Addr {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.write_str("0x1000")
    }
}

fn main(gpa: Gpa) {
    let x: i64 = 1;
    let s = format_in("{:p}", Addr { p: &x as *const i64 }, gpa);
    println("{}", s == "0x1000");
}
