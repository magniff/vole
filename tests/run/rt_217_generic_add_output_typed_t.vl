// XFAIL: RT-217: in a generic body, `a + b` with `T: Add<Output = i64>` is typed T in the instance: "expected 'i64', got 'W'" for T = W whose Add has Output = i64 (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_036_generic_operator_output_binding_ignored.rs.txt).
// vole: `expected 'i64', got 'W' | note: in instantiation of 'plain<W>'` (line 26) and
// the same for plain_copy (line 30); on fields (`self.a + self.b`) and a tuple
// parameter (`p.0 + p.1`) the same (gc/o2.vl), and `-self.a` with `Neg<Output =
// i64>` (gc/o1.vl). With T = &W and `impl Add for &W` the plain form works
// (gc/o1.vl). Since v0.28.0 (v0.30.1, g302probe the same).
// EXPECT: 3
// EXPECT: 3
use std::ops::Add;

#[derive(Clone, Copy)]
struct W {
    k: i64,
}

impl Add for W {
    type Output = i64;

    fn add(self, o: W) -> i64 {
        self.k + o.k
    }
}

fn plain<T: Add<Output = i64>>(a: T, b: T) -> i64 {
    a + b
}

fn plain_copy<T: Add<Output = i64> + Copy>(a: T, b: T) -> i64 {
    a + b
}

fn main() {
    println("{}", plain(W { k: 1 }, W { k: 2 }));
    println("{}", plain_copy(W { k: 1 }, W { k: 2 }));
}
