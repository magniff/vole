// (0.30.2, obligations M1; review 4 F3 at a use) rust_o_m1_super_targs_ok
// with Sup<i32>'s impl, the one Sub needs, bounded (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Sup<P> { fn up(&self) -> i64; }
trait Sub: Sup<i32> { fn n(&self) -> &'static str; }
struct X<'c> { r: &'c str }
impl<'c> Sup<i64> for X<'c> { fn up(&self) -> i64 { 64 } }
impl<'c: 'static> Sup<i32> for X<'c> { fn up(&self) -> i64 { 32 } }
impl<'c: 'static> Sub for X<'c> { fn n(&self) -> &'static str { self.r } }
fn go<T: Sub>(t: &T) -> &'static str { t.n() }

fn main(gpa: Gpa) {
    let s = { let st = String::from_in("hello heap string long", gpa); go(&X { r: st.as_str() }) };
    println("{}", s);
}
