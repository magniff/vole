// EXPECT: 120
// (RT-7, RT-53) a chain of `impl<T: Tr> Tr for W<T>` 120 deep, under
// rustc's recursion limit of 128: proved (v0.30.1 cut it at 32 and said
// the trait is not implemented).
trait Tr { fn d(&self) -> i64; }
struct W<T> { t: T }
impl Tr for i64 { fn d(&self) -> i64 { 0 } }
impl<T: Tr> Tr for W<T> { fn d(&self) -> i64 { 1 + self.t.d() } }
fn go<T: Tr>(t: &T) -> i64 { t.d() }

fn main() {
