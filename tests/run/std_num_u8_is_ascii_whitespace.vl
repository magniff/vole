// The std item(s): std::num u8::is_ascii_whitespace.
// u8's ASCII methods, as Rust's.
// EXPECT: true false true true false
// EXPECT: true true false true true
// EXPECT: true false true true false
// EXPECT: 65 122 true 90 113
// EXPECT: 5
fn main() {
    let s = b" a\tZ9_\x0b\n~\x7f";
    println("{} {} {} {} {}", s[0].is_ascii_whitespace(), s[1].is_ascii_whitespace(),
        s[2].is_ascii_whitespace(), s[7].is_ascii_whitespace(), s[6].is_ascii_whitespace());
    println("{} {} {} {} {}", s[1].is_ascii_alphabetic(), s[3].is_ascii_uppercase(),
        s[3].is_ascii_lowercase(), s[4].is_ascii_digit(), s[1].is_ascii_hexdigit());
    println("{} {} {} {} {}", s[4].is_ascii_alphanumeric(), s[0].is_ascii_graphic(),
        s[5].is_ascii_punctuation(), s[9].is_ascii_control(), 200u8.is_ascii());
    let mut u = b'z';
    u.make_ascii_uppercase();
    let mut l = b'Q';
    l.make_ascii_lowercase();
    println("{} {} {} {} {}", b'a'.to_ascii_uppercase(), b'Z'.to_ascii_lowercase(),
        b'k'.eq_ignore_ascii_case(&b'K'), u, l);
    println("{}", s.iter().filter(|c| c.is_ascii_whitespace() || c.is_ascii_control()).count());
}
