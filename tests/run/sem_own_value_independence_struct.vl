// sem-own: `var b = a.clone()` of a struct with a Vec; and `var b = a` of a plain struct: independent copies.
// EXPECT: 1 2
// EXPECT: 0 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
#[derive(Clone, Copy)] struct Pt { x: i64, y: i64 }
#[derive(Clone)]
struct H<A: Allocator> { v: Vec<i64, A> }

fn main(gpa: Gpa) {
    let mut p = Pt { x: 1, y: 1 };
    let mut q = p;
    q.y = 2;
    println("{} {}", p.y, q.y);
    let h = H { v: Vec::new_in(gpa) };
    let mut k = h.clone();
    k.v.push(1);
    println("{} {}", h.v.len(), k.v.len());
}
