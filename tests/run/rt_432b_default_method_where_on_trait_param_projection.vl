// XFAIL: RT-432b: (RT-432's mechanism, a projection) `size_of::<T::Out>()` in a generic trait's default method under a method-level `where T: Sub` (`trait Sub: Tr`, Tr declaring Out), copied into `impl<U> G<Option<U>> for V<U>` and `impl<U> G<U> for W<U>`, is refused: "unknown module 'T'"; rustc prints 2 8 (0.30.2)
// From the paused g302tparam work (its preexisting/pe2). Since v0.30.1
// at least (v0.30.1 the same error). That branch at one point printed
// `0 0` for it, so the EXPECT line matters, not only that it builds.
// EXPECT: 2 8
use std::mem::size_of;

trait Tr {
    type Out;
}

trait Sub: Tr {}

impl Tr for u8 {
    type Out = i64;
}

impl Sub for u8 {}

impl<X> Tr for Option<X> {
    type Out = u16;
}

impl<X> Sub for Option<X> {}

trait G<T> {
    fn w(&self) -> usize
        where
            T: Sub,
    {
        size_of::<T::Out>()
    }
}

struct V<T> {
    t: T,
}

struct W<T> {
    t: T,
}

impl<U> G<Option<U>> for V<U> {}

impl<U> G<U> for W<U> {}

fn main() {
    let v = V { t: 1u8 };
    let w = W { t: 1u8 };
    println("{} {}", v.w(), w.w());
}
