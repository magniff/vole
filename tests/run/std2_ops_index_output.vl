// EDITION: rust
// Runs on std2 since 0.27.3 (front273).
// The std2 item(s): std::ops Index::Output.
// EXPECT: 1
use std::ops::{Index, IndexMut};

struct Grid {
    cells: [i64; 4],
}

impl Index<(usize, usize)> for Grid {
    type Output = i64;

    fn index(&self, at: (usize, usize)) -> &i64 {
        &self.cells[at.0 * 2 + at.1]
    }
}

impl IndexMut<(usize, usize)> for Grid {
    fn index_mut(&mut self, at: (usize, usize)) -> &mut i64 {
        &mut self.cells[at.0 * 2 + at.1]
    }
}

fn first<G: Index<(usize, usize), Output = i64>>(g: &G) -> i64 {
    g[(0, 0)]
}

fn main() {
    println("{}", first(&Grid { cells: [1, 2, 3, 4] }));
}
