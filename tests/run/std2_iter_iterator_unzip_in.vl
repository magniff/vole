// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::unzip_in.
// EXPECT: [1, 2] ['a', 'b']

fn main(gpa: Gpa) {
    let v = Vec::from_in([(1i64, 'a'), (2, 'b')], gpa);
    let (a, b): (Vec<i64, Gpa>, Vec<char, Gpa>) = v.iter().copied().unzip_in(gpa);
    println("{:?} {:?}", a, b);
}
