// FLAGS: --check-unsafe --trace
// REQUIRES: macos
// EXPECT: in use under 72 MB: true
// 0.30.1: the quarantine's 64 MB are C's bytes (its size for each block,
// red zone and rounding included), not the bytes asked for: 6000 threads
// spawned one after another, each block of theirs freed and held, leave
// C's allocator under 72 MB in use. (Counted as asked for, 82 MB.)
// (macOS: malloc_zone_statistics' size_in_use, the second word.)
use std::thread;

extern "C" {
    fn malloc_zone_statistics(zone: *const u8, stats: *mut u64);
}

fn main(gpa: Gpa) {
    let mut s = 0u64;
    for i in 0..6000u64 {
        let h = thread::spawn_in(move || i, gpa);
        s += h.join().unwrap();
    }
    let mut st = [0u64; 4];
    // UNSAFE: C's allocator statistics.
    // SAFETY: st has the 32 bytes of a malloc_statistics_t; a null zone is
    // every zone.
    unsafe { malloc_zone_statistics(0 as *const u8, &mut st[0] as *mut u64) };
    println("in use under 72 MB: {}", s == 17997000 && st[1] < 72 << 20);
}
