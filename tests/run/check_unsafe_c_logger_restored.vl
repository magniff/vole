// FLAGS: --check-unsafe
// REQUIRES: macos
// EXIT: 101
// STDERR: unsafe access out of bounds (just past the end): 1 bytes at offset 48 of a block of 48 bytes
// STDERR: note: the program replaced malloc_logger after --check-unsafe set it
// 0.30.1: the check notices that malloc_logger is not its own at each of
// its entries (each block the program allocates or frees), not only when
// it reports: a program that sets its own logger, allocates, and puts the
// check's back may have had C's frees unseen in between, and a report
// says so (here on a read just past a live block's end). (Earlier on
// 0.30.1's branch only the logger at the report was looked at: no note.)
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn free(p: *mut u8);
    static mut malloc_logger: extern "C" fn(u32, u64, u64, u64, u64, u32);
}

extern "C" fn quiet(_k: u32, _a: u64, _b: u64, _c: u64, _r: u64, _f: u32) {}

fn main() {
    // UNSAFE: C's allocator and its logger; deliberately one byte past p.
    // SAFETY: none for the read: the program exists to be stopped.
    unsafe {
        let p = malloc(48);
        let theirs = malloc_logger;
        malloc_logger = quiet;
        let b = malloc(400);
        malloc_logger = theirs;
        free(b);
        println("read {}", *p.add(48));
    }
}
