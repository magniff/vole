// (0.30.1, review 4) A projection of an impl's parameter is 'static by the
// declaration of the trait it names, and of that trait's supertraits:
// `<T as B1>::X` by B1's `type X: 'static` (not B2's X, another trait's of
// the same name), `<T as Tr>::X` by Tr's supertrait Base's (review 4's
// a09 form, with T constrained; its impl is checked, not called: front
// does not resolve `<H as Tr>::X` to Base's X yet, a false error at a use).
// EXPECT: 1
trait St: 'static {
    fn n(&self) -> i64;
}

trait B1 {
    type X: 'static;
}

trait B2 {
    type X;
}

trait Base {
    type X: 'static;
}

trait Tr: Base {}

struct P<A, B> {
    a: A,
    b: B,
}

struct H;

impl B1 for H {
    type X = i64;
}

impl B2 for H {
    type X = i64;
}

impl Base for H {
    type X = i64;
}

impl Tr for H {}

impl<T: 'static + B1 + B2> St for P<T, <T as B1>::X> {
    fn n(&self) -> i64 {
        1
    }
}

struct Q<A, B> {
    a: A,
    b: B,
}

impl<T: 'static + Tr> St for Q<T, <T as Tr>::X> {
    fn n(&self) -> i64 {
        2
    }
}

fn main() {
    let p = P { a: H, b: 1i64 };
    println("{}", p.n());
}
