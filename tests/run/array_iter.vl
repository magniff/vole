// EDITION: rust
// A fixed-size array place has its slice's methods (0.16): `a.iter()` is
// `a[..].iter()`, for locals, fields, statics and elements of arrays of
// arrays, with adapters and consumers after it; `for x in a` as before,
// and `for x in a.iter()`. A temporary array has none: err_array_iter_temp.
// EXPECT: sum 6 count 3 max 3
// EXPECT: field 26 for 26 26
// EXPECT: static 4 7 rows 5 6
// EXPECT: map 2 4 6 | filter 2

#[derive(Clone, Copy)] struct P { a: [i64; 4] }

static TABLE: [i64; 2] = [4i64, 3];

fn show(x: i64) {
    print(" ");
    print("{}", x);
}

fn main() -> i32 {
    let a = [1i64, 2, 3];
    print("sum");
    show(a.iter().copied().sum::<i64>());
    print(" count");
    show(a.iter().copied().count() as i64);
    print(" max");
    let mut m: i64 = 0;
    for x in a.iter().copied() {
        if x > m {
            m = x;
        }
    }
    show(m);
    println("");
    let p = P { a: [5i64, 6, 7, 8] };
    print("field");
    show(p.a.iter().copied().sum::<i64>());
    print(" for");
    let mut t: i64 = 0;
    for x in p.a {
        t += x;
    }
    show(t);
    let q = p;
    show(unsafe { q.a.iter().copied().fold(0i64, |s, x| s + x) });
    println("");
    print("static");
    show(TABLE.iter().copied().take(1usize).sum::<i64>());
    show(TABLE.iter().copied().sum::<i64>());
    let rows = [[1i64, 2], [3i64, 4]];
    print(" rows");
    let r1: i64 = rows[1].iter().copied().sum::<i64>();
    show(r1 - rows[0].iter().copied().count() as i64);
    show(rows.iter().copied().map(|r| r[1]).sum::<i64>());
    println("");
    print("map");
    for x in a.iter().copied().map(|x| x * 2) {
        show(x);
    }
    print(" | filter");
    show(a.iter().copied().filter(|x| ({ let x = *x; x % 2 == 1 })).count() as i64);
    println("");
    0
}
