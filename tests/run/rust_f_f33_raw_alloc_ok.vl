// RULE: F33.1
// A raw pointer holds no allocator: a field `*mut Node<Gpa>` does not
// make its struct name one (alloc.field looks through references and
// Box, not through raw pointers).
// EXPECT: 0
use std::alloc::Allocator;

struct Node<A: Allocator> {
    next: Vec<u8, A>,
}

struct Handle {
    node: *mut Node<Gpa>,
}

fn main() {
    let h = Handle { node: 0 as *mut Node<Gpa> };
    println("{}", h.node as usize);
}
