// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter::sources from_fn.
// EXPECT: [1, 2, 3]

fn main(gpa: Gpa) {
    let mut n = 0i64;
    let v: Vec<i64, Gpa> = std::iter::from_fn(|| {
        n += 1;
        if n <= 3 { Some(n) } else { None }
    }).collect_in(gpa);
    println("{:?}", v);
}
