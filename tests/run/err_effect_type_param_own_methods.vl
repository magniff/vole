// RULE: E3.3c (0.30.1) A type parameter in an effects list stands for its
// own methods' effects (a trait's, called through it; its closure's body),
// nothing more: a callee generic over it brings only what it does through
// those. Before, `#[effects(T)]` let through all of such a callee's set: a
// panic of W<T>::helper's own, or of a generic fn's, passed where
// `#[effects()]` on the same code was refused (std's HashMap::insert,
// reserve and with_capacity_and_hasher_in were declared so), and the
// probe exited 101 under a declaration without `panic`.
// ERROR: 'user' is #[effects(T)], but it may panic: 'w.helper(n)' at
// ERROR: 'user_fn' is #[effects(T)], but it may panic: 'checked_len(x, n)' at
// ERROR: 'user_deep' is #[effects(T)], but it may panic: 'w.outer(n)' at
// ERROR-COUNT: 3

struct W<T> {
    x: T,
}

impl<T> W<T> {
    fn helper(&self, n: usize) -> usize {
        if n > 5 {
            std::panic::panic("too big");
        }
        n
    }

    fn outer(&self, n: usize) -> usize {
        self.helper(n)
    }
}

fn checked_len<T>(x: &T, n: usize) -> usize {
    let _ = x;
    assert(n < 10);
    n
}

#[effects(T)]
fn user<T>(w: &W<T>, n: usize) -> usize {
    w.helper(n)
}

#[effects(T)]
fn user_fn<T>(x: &T, n: usize) -> usize {
    checked_len(x, n)
}

#[effects(T)]
fn user_deep<T>(w: &W<T>, n: usize) -> usize {
    w.outer(n)
}

fn main() {
    let w = W { x: 1u8 };
    println("{} {} {}", user(&w, 9), user_fn(&1u8, 3), user_deep(&w, 2));
}
