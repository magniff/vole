// EDITION: rust
// a generic identity instantiated with a view: the result views the block's Vec
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 11, column 14
fn pass<T>(x: T) -> T { x }

fn main(gpa: Gpa) {
    let s = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        pass(v.as_slice())
    };
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println("{}", s[5]);
}
