// EDITION: rust
// (0.25) Calling a closure is an access of its captures: `f(&n)` for an f
// that reads n lends n inout while f reads it (-O2 assumed them apart).
fn main() {
    let mut n: i64 = 1;
    let f = |x: &mut i64| -> i64 { let before = n; *x = 5; before * 100 + n };
    let r = f(&mut n);
    println("{r} {n}");
}
