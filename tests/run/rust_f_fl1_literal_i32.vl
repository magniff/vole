// EDITION: rust
// RULE: F18.6, F18.5
// RUSTC-DIFFERS: FL1 a variable fixed by an untyped literal takes i32 at once (`Vec<i32>`); rustc keeps an {integer} that the later `let b: i64 = v[0]` fixes to i64
// An untyped literal where a variable goes gives it the literal's
// provisional type at once: `v.push(1)` makes `Vec<i32>`, and the later
// `i64` use widens (FR5). rustc infers `Vec<i64>`: `wrapping_shl(40)`
// is 1 << 40 there, 1 << 8 in vole's i32.
// EXPECT: 1 256
fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    v.push(1);
    let b: i64 = v[0];
    println("{} {}", b, v[0].wrapping_shl(40));
}
