// RULE: D2.7
// (0.30.1, RT-33) `&mut *s` of an `s: &str`, then a `&mut self` method of
// str: the `&mut str` reborrow of a shared view, rustc's E0596. Before, the
// `&str` was retyped `&mut str` and the literal written.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 9, column 13
// ERROR-COUNT: 1
fn upper(s: &str) {
    let m = &mut *s;
    m.make_ascii_uppercase();
}

fn main() {
    upper("abc");
}
