// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc TryReserveError.
// EXPECT: true false
use std::alloc::Layout;

fn main(gpa: Gpa) {
    let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);
    let e = v.try_reserve(usize::MAX).is_err();
    let ok = v.try_reserve(4).is_err();
    println("{} {}", e, ok);
}
