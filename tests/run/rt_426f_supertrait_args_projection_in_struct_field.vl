// XFAIL: RT-426f: WRONG CODE: (RT-426's family, a struct field) `struct Z<T: Sub> { x: T::Out }` with `trait Sub: Tr<u16>`: `size_of::<Z<W>>()` takes Tr<u8>'s Out (i64): vole prints 8, rustc 1 (0.30.2)
// From the re-review of g302oblig M2 (its form c10_super_proj_with_args_bound). Since v0.30.1 at
// least (v0.30.1 and the release build print 8).
// EXPECT: 1
trait Tr<A> {
    type Out;
}

struct W;

impl Tr<u8> for W {
    type Out = i64;
}

impl Tr<u16> for W {
    type Out = u8;
}

trait Sub: Tr<u16> {}

impl Sub for W {}

struct Z<T: Sub> {
    x: T::Out,
}

fn main() {
    println("{}", std::mem::size_of::<Z<W>>());
}
