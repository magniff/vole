// XFAIL: RT-442: let-chains do not parse: `if let Some(a) = x && let Some(b) = y && a < b { .. }` is a parser error ("expected expression, got 'let'"); rustc (edition 2024) prints 7 (0.30.2)
// From red team round 9's leads (r302i COVERAGE.md). Since v0.30.1 at
// least (the same error). Also `while let .. && let ..` in Rust.
// EXPECT: 7
fn main() {
    let x: Option<i64> = Some(2);
    let y: Option<i64> = Some(5);
    if let Some(a) = x && let Some(b) = y && a < b {
        println("{}", a + b);
    } else {
        println("none");
    }
}
