// EDITION: rust
// A u32 index of 2^32 - 1.
// EXIT: 101
// STDERR: index out of bounds: index 4294967295, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let i: u32 = 4294967295 + unsafe { Z } as u32;
    println("{}", a[i as usize]);
    println("not reached");
    0
}
