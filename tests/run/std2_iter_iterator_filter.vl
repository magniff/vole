// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::filter.
// EXPECT: [2, 4]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().filter(|x| x % 2 == 0).collect_in(gpa);
    println("{:?}", a);
}
