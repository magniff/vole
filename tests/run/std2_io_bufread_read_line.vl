// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io BufRead::read_line.
// EXPECT: 4 "one\n" 3 0
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let mut b = BufReader::new("one\ntwo".as_bytes());
    let mut s: String<Gpa> = String::new_in(gpa);
    let n = b.read_line(&mut s).unwrap();
    let mut t: String<Gpa> = String::new_in(gpa);
    let m = b.read_line(&mut t).unwrap();
    let k = b.read_line(&mut t).unwrap();
    println("{} {:?} {} {}", n, s, m, k);
}
