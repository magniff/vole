// RULE: F20.6, D2.7
// (0.30.1, RT-33 round 3, F2, F3) A user type's slicing as a `&mut self`
// receiver: `w[0usize..3].reverse()` through IndexMut<Range<usize>>,
// `d[..2].reverse()` through DerefMut<Target = [u8]>. The view the Index
// or Deref call gives, read as the view itself (Z4.1), becomes the
// index_mut or deref_mut call (front/check/rust.vl place_to_mut), as
// `&mut w[..]` does. Before round 3 the shared view was passed and
// refused (E0596); before RT-33 it was written through.
// EXPECT: 3 2
use std::ops::{Deref, DerefMut, Index, IndexMut, Range};

struct W {
    s: [u8; 3],
}

impl Index<Range<usize>> for W {
    type Output = [u8];

    fn index(&self, r: Range<usize>) -> &[u8] {
        &self.s[r.start..r.end]
    }
}

impl IndexMut<Range<usize>> for W {
    fn index_mut(&mut self, r: Range<usize>) -> &mut [u8] {
        &mut self.s[r.start..r.end]
    }
}

struct D {
    s: [u8; 3],
}

impl Deref for D {
    type Target = [u8];

    fn deref(&self) -> &[u8] {
        &self.s[..]
    }
}

impl DerefMut for D {
    fn deref_mut(&mut self) -> &mut [u8] {
        &mut self.s[..]
    }
}

fn main() {
    let mut w = W { s: [1, 2, 3] };
    w[0usize..3].reverse();
    let mut d = D { s: [1, 2, 3] };
    d[..2].reverse();
    println("{} {}", w.s[0], d.s[0]);
}
