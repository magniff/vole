// (0.25.5) [T]::starts_with and ends_with (Rust's), on bytes and on any
// slice whose elements have ==: an empty prefix or suffix is always one,
// a longer one never.
// EXPECT: true true false false
// EXPECT: true true false false
// EXPECT: true false true true

fn main() {
    let name: [u8] = "main.vl";
    println(
        "{} {} {} {}", name.starts_with("main"), name.ends_with(".vl"), name.starts_with(".vl"),
        name.ends_with("main.vl!"));
    let line = "# a heading";
    println(
        "{} {} {} {}", line.starts_with("# "), line.starts_with(""), "".starts_with("#"),
        line.ends_with("# a heading."));
    let v = [1, 2, 3, 4];
    let s = v[..];
    println(
        "{} {} {} {}", s.starts_with([1, 2][..]), s.starts_with([2][..]), s.ends_with([3, 4][..]),
        s.ends_with(v[0..0]));
}
