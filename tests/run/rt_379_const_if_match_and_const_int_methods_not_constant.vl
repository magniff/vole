// XFAIL: RT-379: a constant whose value is an `if` or a `match`, or calls one of the integers' const methods (`A.wrapping_mul(3)`, `A.pow(2)`, `A.abs()`, `A.count_ones()`), is refused: "expression is not a compile-time constant" (0.30.2)
// rustc prints `10 1 15 25 5 2` (twin .rs.txt): all six are constant
// expressions (the methods are `const fn` in core). vole: six errors,
// one at each of lines 11 to 16; v0.28.0 to v0.30.1 the same. Built
// today: `'a' as u32 + 1`, `A > 2 && A < 9`, `(A > 2) as i64`, `-(A %
// 3)`. Also seen: `const B: i64 = i64::max(A, 3);` is accepted, where
// rustc refuses it (E0658: Ord::max is not const; RT-119's family).
// RT-316 is `loop { break 6; }`, RT-114/176 a block with `let`.
// EXPECT: 10 1 15 25 5 2
const A: i64 = 5;
const B: i64 = if A > 2 { 10 } else { 20 };
const C: i64 = match A { 5 => 1, _ => 2 };
const D: i64 = A.wrapping_mul(3);
const E: i64 = A.pow(2);
const F: i64 = A.abs();
const G: u32 = A.count_ones();

fn main() {
    println("{} {} {} {} {} {}", B, C, D, E, F, G);
}
