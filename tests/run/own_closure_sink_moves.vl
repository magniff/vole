// EDITION: rust
// XFAIL: gap 8: compile borrowck.move_out: cannot move out of 'a', a captured variable in an `FnMut` closure
// 0.20: a sink closure owns its captures; its body may move one out (each
// has a flag): the closure's drop then skips it, and one never called, or
// that keeps its capture, drops it once. --check-alloc finds no leak and no
// double free.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 101
// EXPECT: once 101
// EXPECT: kept 2
// EXPECT: vec 1
// EXPECT: drop 3
// EXPECT: drop 2
struct R { id: i64 }

impl Drop for R {
    fn drop(&mut self) { println("drop {}", self.id); }
}

impl Clone for R { fn clone(&self) -> R { R { id: self.id + 100 } } }
fn call<F: FnMut() -> i64>(f: F) -> i64 { let mut g = f; g() }
fn call2<F: FnMut() -> i64>(f: F) -> i64 { let mut g = f; g() + g() }

fn main(gpa: Gpa) {
    let a = R { id: 1 };
    let r = call(move || { let c = a.clone(); drop(a); c.id });
    println("once {r}");
    let b = R { id: 2 };
    let k = move || { b.id };
    println("kept {}", k());
    let d = R { id: 3 };
    let u = move || { drop(d); 0 };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    let w = call(move || { let n = v.len(); drop(v); n as i64 });
    println("vec {w}");
}
