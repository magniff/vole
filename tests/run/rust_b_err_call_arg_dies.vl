// RULE: D3.6
// (0.27.1) A result tied to both arguments outlives one of them.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 21, column 24
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn longer<'a>(a: &'a i64, b: &'a i64) -> &'a i64 {
    if *a > *b {
        a
    } else {
        b
    }
}

fn main() {
    let a: i64 = 1;
    let mut r = &a;
    {
        let b: i64 = 2;
        r = longer(&a, &b);
    }
    println("{}", *r);
}
