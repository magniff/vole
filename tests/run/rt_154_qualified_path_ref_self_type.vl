// XFAIL: RT-154: `<&S as Tr>::f` and `<Vec<i64> as Tr>::f` in an expression are parse errors (0.30.2)
// From g302qual (pre-existing, v0.30.1 too). rustc accepts both.
// EXPECT: 1 2
trait Tr {
    fn f(&self) -> i64;
}

struct S;

impl Tr for &S {
    fn f(&self) -> i64 {
        1
    }
}

impl Tr for Vec<i64> {
    fn f(&self) -> i64 {
        2
    }
}

fn main() {
    let s = S;
    let v: Vec<i64> = Vec::new();
    println("{} {}", < &S as Tr >::f(&&s), < Vec<i64> as Tr >::f(&v));
}
