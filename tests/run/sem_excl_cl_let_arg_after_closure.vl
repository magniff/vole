// the closure first, the let argument second
// ERROR: error[borrowck.conflict]
fn f<F: FnMut()>(mut w: F, p: &Vec<i64, Gpa>) -> i64 { let s = p.as_slice(); w(); s[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    let r = f(|| { for i in 0..1000 { v.push(i); } }, &v); println("{r}");
}
