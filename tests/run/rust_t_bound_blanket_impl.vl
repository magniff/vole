// EDITION: rust
// RULE: F14.1
// (0.28.0) An impl for every T, `impl<T> RangeBounds<T> for RangeFull`,
// found through a bound: in an instance the receiver's bound `R:
// RangeBounds<K>` fixes the parameter its type leaves free. `m.range(..)`
// and `v.drain(..)` said "no impl of 'RangeFull::start_bound' takes
// arguments ()".
use std::collections::BTreeMap;
use std::ops::{Bound, RangeBounds};

trait Tr<T> {
    fn get(&self) -> Option<T>;
}

struct Full;

struct One<T> {
    x: T,
}

impl<T> Tr<T> for Full {
    fn get(&self) -> Option<T> { None }
}

impl<T: Copy> Tr<T> for One<T> {
    fn get(&self) -> Option<T> { Some(self.x) }
}

fn has<K, R: Tr<K>>(r: R, _k: &K) -> bool {
    match r.get() {
        None => false,
        Some(_) => true,
    }
}

fn has_ref<K, R: Tr<K>>(r: &R, _k: &K) -> bool { r.get().is_some() }

fn open<K, R: RangeBounds<K>>(r: R, _k: &K) -> bool {
    match r.start_bound() {
        Bound::Unbounded => true,
        Bound::Included(_) => false,
        Bound::Excluded(_) => false,
    }
}

fn main(gpa: Gpa) {
    let k = 3i64;
    println("{} {}", has(Full, &k), has(One { x: 1i64 }, &k));
    println("{} {}", has_ref(&Full, &k), has_ref(&One { x: 1i64 }, &k));
    println("{} {} {}", open(.., &k), open(1i64..5, &k), open(..5i64, &k));
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.drain(..);
    println("{}", v.len());
    let mut m: BTreeMap<i64, i64, Gpa> = BTreeMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    for (a, b) in m.range(..) {
        println("{a} {b}");
    }
    for (a, b) in m.range(2..) {
        println("{a} {b}");
    }
}
// EXPECT: false true
// EXPECT: false true
// EXPECT: true false true
// EXPECT: 0
// EXPECT: 1 10
// EXPECT: 2 20
// EXPECT: 2 20
