// EDITION: rust
// RULE: D19.3, D19.7
// (0.27.2) A closure checked against an `Fn` bound moving a capture out:
// borrowck.move_out (rustc E0507).
// ERROR: error[borrowck.move_out]
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn call<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn main() {
    let s = S { n: 4 };
    println("{}", call(|| eat(s)));
}
