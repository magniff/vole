// EDITION: rust
// RULE: F0.1
// A `&str` is no `&mut str`: given where one goes, a mismatch (rustc
// E0308), so the callee cannot write through it.
// ERROR: error[type error]: expected 'inout str', got 'str'
fn shout(s: &mut str) {
    s.make_ascii_uppercase();
}

fn main(gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str("ab");
    let r: &str = &b;
    shout(r);
}
