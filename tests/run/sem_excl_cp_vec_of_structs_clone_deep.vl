// EXPECT: 1 9
use std::alloc::Allocator; #[derive(Clone)]
struct S<A: Allocator> { v: Vec<i64, A> }

fn main(gpa: Gpa) {
    let mut a: Vec<S<Gpa>, Gpa> = Vec::new_in(gpa); let mut s = S { v: Vec::new_in(gpa) };
    s.v.push(1);
    a.push(s);
    let mut b = a.clone(); b[0].v[0] = 9; println("{} {}", a[0].v[0], b[0].v[0]);
}
