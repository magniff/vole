// Runs on std since 0.27.2's switch.
// The std item(s): std::string String::impl Write.
// EXPECT: x=1 y
use std::fmt::Write;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let _ = s.write_str("x=1");
    let _ = s.write_char(' ');
    let _ = s.write_fmt(format_args("y"));
    println("{}", s);
}
