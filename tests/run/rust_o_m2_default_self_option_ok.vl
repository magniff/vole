// EXPECT: 3
// (RT-271) a trait parameter's default `U = Option<Self>` read for `impl Sub for W` with Self W (v0.30.1: unknown type 'Self').
trait Tr<U> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<Option<W>> for W {
    fn g(&self) -> i64 {
        3
    }
}

trait Sub<U = Option<Self>>: Tr<U> {}

impl Sub for W {}

fn c2<Z: Sub>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", c2(&W { r: 0 }));
}
