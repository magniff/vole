// EDITION: rust
// RULE: D3.6
// (0.27.2) `let r: &'a i64 = &v;` needs the local `v` for the caller's
// `'a` (rustc E0597).
// ERROR: error[borrowck.dropped_borrowed]
fn keep<'a>(x: &'a i64) -> i64 {
    let v = *x + 1;
    let r: &'a i64 = &v;
    *r
}

fn main() {
    let a = 1;
    println("{}", keep(&a));
}
