// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::str SplitTerminator::impl Iterator.
// EXPECT: ["A", "B"] ["A", "", "B", ""]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "A.B.".split_terminator('.').collect_in(gpa);
    let w: Vec<&str, Gpa> = "A..B..".split_terminator('.').collect_in(gpa);
    println("{:?} {:?}", v, w);
}
