// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str Range<usize>::impl SliceIndex<str>.
// EXPECT: "ll" None None "é"
use std::str::CharIndices;

fn main() {
    let s = "hello";
    let t = "aéb";
    println("{:?} {:?} {:?} {:?}", &s[2..4], s.get(3..9), t.get(1..2), &t[1..3]);
}
