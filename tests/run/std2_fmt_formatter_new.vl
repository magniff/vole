// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter::new.
// EXPECT: hi 3
use std::fmt::Formatter;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = f.write_str("hi");
    let w = f.width();
    let _ = w;
    println("{} {}", s, s.len() + 1);
}
