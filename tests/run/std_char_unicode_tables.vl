// The std item(s): std::char char::is_alphabetic; char::is_numeric; char::is_alphanumeric; char::is_whitespace; char::is_uppercase; char::is_lowercase; char::to_uppercase; char::to_lowercase (Unicode's tables, std's private unicode module).
// EXPECT: 'é' true false true false false true "É" "é"
// EXPECT: 'ß' true false true false false true "SS" "ß"
// EXPECT: 'İ' true false true false true false "İ" "i\u{307}"
// EXPECT: 'Σ' true false true false true false "Σ" "σ"
// EXPECT: 'ж' true false true false false true "Ж" "ж"
// EXPECT: 'ǅ' true false true false false false "Ǆ" "ǆ"
// EXPECT: 'ﬁ' true false true false false true "FI" "ﬁ"
// EXPECT: '٣' false true true false false false "٣" "٣"
// EXPECT: 'Ⅻ' true true true false true false "Ⅻ" "ⅻ"
// EXPECT: '中' true false true false false false "中" "中"
// EXPECT: '\u{3000}' false false false true false false "\u{3000}" "\u{3000}"
// EXPECT: '\u{85}' false false false true false false "\u{85}" "\u{85}"
// EXPECT: 'ᾳ' true false true false false true "ΑΙ" "ᾳ"
// EXPECT: 'ŉ' true false true false false true "ʼN" "ŉ"
// EXPECT: 'ꙋ' true false true false false true "Ꙋ" "ꙋ"
// EXPECT: '𐐀' true false true false true false "𐐀" "𐐨"
// EXPECT: 'Ա' true false true false true false "Ա" "ա"
// EXPECT: 'ა' true false true false false true "Ა" "ა"
// EXPECT: 'ᏸ' true false true false false true "Ᏸ" "ᏸ"
// EXPECT: '𞤀' true false true false true false "𞤀" "𞤢"
// EXPECT: '੦' false true true false false false "੦" "੦"
// EXPECT: 'ª' true false true false false true "ª" "ª"
fn main(gpa: Gpa) {
    let cs = ['é', 'ß', 'İ', 'Σ', 'ж', 'ǅ', 'ﬁ', '٣', 'Ⅻ', '中', '\u{3000}', '\u{85}',
        'ᾳ', 'ŉ', 'ꙋ', '𐐀', 'Ա', 'ა', 'ᏸ', '𞤀', '੦', 'ª'];
    for c in cs.iter() {
        let c = *c;
        let up: String<Gpa> = c.to_uppercase().collect_in(gpa);
        let lo: String<Gpa> = c.to_lowercase().collect_in(gpa);
        println("{:?} {} {} {} {} {} {} {:?} {:?}", c, c.is_alphabetic(), c.is_numeric(),
            c.is_alphanumeric(), c.is_whitespace(), c.is_uppercase(), c.is_lowercase(), up, lo);
    }
}
