// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io &[u8]::impl Read.
// EXPECT: 2 [3]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut b = [0u8; 2];
    let n = r.read(&mut b).unwrap();
    println("{} {:?}", n, r);
}
