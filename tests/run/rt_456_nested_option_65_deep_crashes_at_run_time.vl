// XFAIL: RT-456: a value 66 Options deep, `first(&v, &k)` returning `Option<Option<..<<C as IntoIterator>::Item>..>>` (65 written plus the result's own) and matched back with `if let Some(Some(..(s)..))`, builds but crashes at run time with a bus error (SIGBUS, exit 138) at -O1 and -O2, while -O0 prints the line; 64 deep runs at every level; rustc prints the line (0.30.2)
// From the re-review of g302bor2 (its form X/nodrop65, from gen_nest.py
// without the drop). Since v0.30.1 at least: v0.30.1 and the release
// build (38fe466c5) both run it at -O0 and crash at -O1 and -O2, three
// runs each (the review saw a crash at -O0 too, on its branch's build).
// The case is built at -O2 (FLAGS), so that it fails at the suite's
// every level. The cause is not traced: a limit of 64 somewhere in the
// optimizer's handling of nested enums is the guess.
// FLAGS: -O2
// EXPECT: hello heap string long 22
fn first<C: IntoIterator>(c: C, k: &i64) -> Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<<C as IntoIterator>::Item>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> {
    let _ = k;
    match c.into_iter().next() {
        Some(x) => Some(
            Some(
                Some(
                    Some(
                        Some(
                            Some(
                                Some(
                                    Some(
                                        Some(
                                            Some(
                                                Some(
                                                    Some(
                                                        Some(
                                                            Some(
                                                                Some(
                                                                    Some(
                                                                        Some(
                                                                            Some(
                                                                                Some(
                                                                                    Some(
                                                                                        Some(
                                                                                            Some(
                                                                                                Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(x)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))),
        None => None,
    }
}

fn main(gpa: Gpa) {
    let k = 5i64;
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello heap string long", gpa));
    let p = first(&v, &k);

    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    if let Some(
        Some(
            Some(
                Some(
                    Some(
                        Some(
                            Some(
                                Some(
                                    Some(
                                        Some(
                                            Some(
                                                Some(
                                                    Some(
                                                        Some(
                                                            Some(
                                                                Some(
                                                                    Some(
                                                                        Some(
                                                                            Some(
                                                                                Some(
                                                                                    Some(
                                                                                        Some(
                                                                                            Some(
                                                                                                Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(s)))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))))) = p {
        println("{} {}", s, other.len());
    }
}
