// RULE: E3.1a
// (0.27.2.1) A declared function's set is its signature: a caller sees
// the declaration (here `io`, which the body does not do), not the body.
// ERROR: 'caller' is #[pure], but it does io: 'declared()' at
#[effects(io)]
fn declared() -> i64 {
    1
}

#[pure]
fn caller() -> i64 {
    declared() + 1
}

fn main() {
    println("{}", caller());
}
