// 0.25.4 (feedback: pathtrace's UI): an array literal of unsuffixed
// literals takes its element type from the code around it, as a scalar
// literal does: an if's other branch (an `else if` chain too), a match's
// other arm (before or after it), the other elements of an array. Here
// all are `[f32; 4]` beside a `[f32; 4]` constant, and nested arrays.
// EXPECT: 0.1 f32
// EXPECT: 0.3 0.2 0.1 0.5 0.4 0.3
// EXPECT: 0.25 0.5 -0.75 1 2.5
const ACCENT: [f32; 4] = [0.3, 0.6, 0.9, 1.0];

fn bg(down: bool, hovered: bool) -> [f32; 4] {
    let c = if down { ACCENT } else if hovered { [0.20, 0.52, 0.70, 1.0] }
        else { [0.1, 0.3, 0.42, 1.0] };
    c
}

fn arm(k: i64) -> [f32; 4] {
    let a = match k {
        0 => [0.5, 0.5, 0.5, 1.0],
        1 => ACCENT,
        _ => [0.4, -0.25, 0.0, 1.0],
    };
    a
}

fn main() -> i32 {
    let first = if false { [0.25, 0.5, 0.75, 1.0] } else { bg(true, false) };
    let p = [[0.25, 0.5, -0.75, 1.0], ACCENT, [2.5, 0.0, 0.0, 0.0]];
    let grid = if true { [[1.0f32, 2.0], [3.0, 4.0]] } else { [[0.0, 0.0], [0.0, 0.0]] };
    let x: [f32; 4] = first;
    let tenth = if true { [0.1, 0.2] } else { [x[0], x[1]] };
    println(f"{tenth[0]} {if tenth[0] as f64 == 0.1 { "f64" } else { "f32" }}");
    let y: [[f32; 4]; 3] = p;
    let z: [[f32; 2]; 2] = grid;
    println(
        f"{x[0]} {bg(false, true)[0]} {bg(false, false)[0]} {arm(0)[0]} {arm(2)[0]} {arm(1)[0]}");
    println(f"{y[0][0]} {y[0][1]} {y[0][2]} {z[0][0]} {y[2][0]}");
    0
}
