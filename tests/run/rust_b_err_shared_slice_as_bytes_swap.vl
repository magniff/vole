// RULE: D2.7
// (0.30.1, RT-33) `s.as_bytes().swap(1, 2)` of an `s: &str`: the call's
// shared view passed where swap takes `&mut [u8]`, rustc's E0596. Before,
// the contract's binding of the receiver was retyped `&mut [u8]`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 9, column 5
// ERROR-COUNT: 1
fn bytes_of(s: &str) {
    s.as_bytes().swap(1, 2);
}

fn main() {
    bytes_of("a\u{e9}");
}
