// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: 7
// STDERR: unsafe access after free: 16 bytes at offset 0 of a block of 16 bytes
// 0.10: --check-unsafe finds a use after free (through a field).
extern "C" {
    fn printf(f: *const u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn free(p: *mut u8);
    fn fflush(f: *mut u8) -> i32;
}

#[derive(Clone, Copy)] struct Pair { a: i32, b: i32, c: i64 }

fn main() -> i32 {
    let p = unsafe { malloc(16) as *mut Pair };
    unsafe {
        (*p).a = 3;
        (*p).b = 4;
        printf(c"%d\n", (*p).a + (*p).b);
        fflush(0 as *mut u8);
        free(p as *mut u8);
    }
    unsafe { (*p).b }
}
