// RULE: F18.5
// (0.30.2) A generic method of a trait every integer type implements,
// called on an integer variable's value, is made for the type the
// variable takes: `x.hash(&mut h)` hashes the i64 that `take(x)` makes x,
// as rustc's (0.30.1 hashed an i32 5, another hash, and widened x after).
// EXPECT: true
use std::hash::{Hash, Hasher};

fn take(x: i64) -> i64 {
    x
}

fn main() {
    let mut h = std::hash::DefaultHasher::new();
    let x = 5;
    x.hash(&mut h);
    take(x);
    let mut h2 = std::hash::DefaultHasher::new();
    5i64.hash(&mut h2);
    println("{}", h.finish() == h2.finish());
}
