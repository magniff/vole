// RULE: F18.5
// (0.30.2) A generic constructor's parameter that literals bind is their
// integer variable: a later statement types it (FL6's `Vec::from_in([1,
// 2], gpa)` then a `&Vec<i64>`; `W { x: 7 }` then a `&W<u8>`), where
// 0.30.1 bound it to i32 at the call.
// EXPECT: 3000000003 7
struct W<T> {
    x: T,
}

fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut s = 0;
    for x in v.iter() {
        s += *x;
    }
    s
}

fn get(w: &W<u8>) -> u8 {
    w.x
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([3000000000, 3], gpa);
    let w = W { x: 7 };
    println("{} {}", total(&v), get(&w));
}
