// (0.24) Moving a field out of a temporary whose type implements Drop is
// own.partial, as out of a local: its drop needs all of it.
// ERROR: error[borrowck.move_from_drop]
// ERROR: line 18, column 13
use std::alloc::Allocator; struct N<A: Allocator> { v: Vec<i64, A> }

impl Drop for N<Gpa> {
    fn drop(&mut self) { println("drop"); }
}

fn make(gpa: Gpa) -> N<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    N { v: v }
}

fn main(gpa: Gpa) {
    let x = make(gpa).v;
    println("{}", x[0]);
}
