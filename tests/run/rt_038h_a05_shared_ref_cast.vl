// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a05_shared_ref_cast)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A callee writes through a pointer made from a &i64 the clause reads.
fn poke(r: &i64) -> bool {
    let p = r as *const i64 as *mut i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(r: &i64) -> i64
    requires poke(r)
{
    1
}

fn main() {
    let x = 1i64;
    println("{}", f(&x));
    println("{}", x);
}
