// RULE: F34.4, F35.2 (0.30.2, RT-302, RT-148) A constant's value is a body of
// its own: a `return` in it is refused (rustc E0572), so a `[C; N]` part
// built never sees its constant leave the using function.
// `*r = [C; 5]` through a `&mut` of a heap-owning constant whose value
// returns (e12): a double free on 10d65043a.
// The places IR's guard (repeat_each, emit_guard) drops exactly the
// elements made on any exit as well: with the refusal off, this program
// drops each value once and frees each block once.
// ERROR: line 72
// ERROR-COUNT: 1
use std::alloc::{AllocError, Allocator, Layout};
use std::ptr::NonNull;
import "stdlib.h" as c;

static mut LIVE: i64 = 0;
static mut FREES: i64 = 0;
static mut FREED: [usize; 4096] = [0; 4096];
static mut NF: usize = 0;

#[derive(Clone, Copy)]
struct M {}

// UNSAFE: an Allocator impl over C's malloc.
// SAFETY: each block is malloc's, freed by free once.
unsafe impl Allocator for M {
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        // UNSAFE: C's malloc and the counter.
        // SAFETY: single thread; the size is the layout's.
        let p = unsafe { LIVE += 1; c::malloc(layout.size() as u64 + 8) as *mut u8 };
        match NonNull::<u8>::new(p) { Some(n) => Ok(n), None => Err(AllocError {}) }
    }

    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {
        // UNSAFE: C's free and the counter.
        // SAFETY: p is malloc's.
        unsafe {
            let a = p.as_ptr() as usize;
            let mut i: usize = 0;
            while i < NF { if FREED[i] == a { panic("double free"); } i += 1; }
            if NF < 4096 { FREED[NF] = a; NF += 1; }
            LIVE -= 1; FREES += 1;
        }
    }
}

static mut MADE: i64 = 0;

fn mkv() -> Vec<i64, M> {
    // UNSAFE: a counter.
    // SAFETY: single thread.
    let k = unsafe { MADE += 1; MADE };

    let mut v: Vec<i64, M> = Vec::new_in(M {});
    v.push(k);
    v
}

fn live() -> i64 {
    // UNSAFE: a counter read.
    // SAFETY: single thread.
    unsafe { LIVE }
}

fn made() -> i64 {
    // UNSAFE: a counter read.
    // SAFETY: single thread.
    unsafe { MADE }
}

fn take(a: [Vec<i64, M>; 5]) -> usize { a.len() }
struct S<A: Allocator> { a: [Vec<i64, A>; 5], n: i64 }
const C: Vec<i64, M> = { if made() == 2 { return; } mkv() };
fn fill(r: &mut [Vec<i64, M>; 5]) { *r = [C; 5]; }

fn main() {
    let mut x = [Vec::new_in(M {}), Vec::new_in(M {}), Vec::new_in(M {}), Vec::new_in(M {}),
        Vec::new_in(M {})]; fill(&mut x);
    println("end live {} made {} {}", live(), made(), x.len());
}
