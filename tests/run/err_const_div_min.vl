// (0.26.3, decision 6) A constant MIN / -1 or MIN % -1 is an error at
// every level and with the overflow checks off, as at run time it always
// panics (explain arith.overflow).
// FLAGS: --overflow-checks=off
// ERROR: this constant expression overflows 'i64': attempt to divide with overflow
// ERROR: help: MIN / -1 and MIN % -1 overflow at every level, as they panic at run time
// ERROR: this constant expression overflows 'i8': attempt to calculate the remainder with overflow
// ERROR-COUNT: 2
const M: i64 = -9223372036854775808;
const Q: i64 = M / -1;
const R: i8 = -128 % -1;

fn main() {
    println("{} {} {}", M, Q, R);
}
