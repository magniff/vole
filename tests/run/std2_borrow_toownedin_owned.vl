// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::borrow ToOwnedIn::Owned.
// EXPECT: hi 2
// RUSTC: none (std2's ToOwnedIn takes the allocator: Rust's ToOwned has no parameter)
use std::borrow::{Borrow, ToOwnedIn};

fn own<T: ToOwnedIn<Gpa> + ?Sized>(x: &T, gpa: Gpa) -> T::Owned {
    x.to_owned_in(gpa)
}

fn main(gpa: Gpa) {
    let s = own("hi", gpa);
    let v = own(&[3i64, 4][..], gpa);
    println("{} {}", s, v.len());
}
