// an iterator whose Item is a view of a Vec it holds a view of: kept items outlive the Vec?
// ERROR: error[borrowck.conflict]
#[derive(Clone, Copy)]
struct It<'a> { s: &'a [i64], pos: i64 }

impl<'a> Iterator for It<'a> {
    type Item = &'a [i64];

    fn next(&mut self) -> Option<&'a [i64]> {
        if self.pos >= self.s.len() as i64 { return None; }
        self.pos += 1;
        Some(&self.s[(self.pos - 1) as usize..self.pos as usize])
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    let mut it = It { s: v.as_slice(), pos: 0 };
    let a = it.next().unwrap();
    for i in 0..100 { v.push(i); }
    println("{}", a[0]);
}
