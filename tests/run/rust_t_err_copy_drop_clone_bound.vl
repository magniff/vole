// EDITION: rust
// RUSTC: none type errors (E0184, E0277): the twin compares the borrow checker's verdicts
// RULE: F2.6, F0.4
// (0.28.0) A type with a destructor is not Copy (rustc E0184; it was a
// move error in the derived clone, with a fix that did not compile). And
// a struct with no impl of Clone does not meet `T: Clone` (E0277; its
// `x.clone()` was a move error inside the generic body).
// ERROR: the trait `Copy` cannot be implemented for type `G`: the type has a destructor (rustc E0184)
// ERROR: the trait 'Clone' is not implemented for 'N'
// ERROR: help: required by the bound 'T: Clone' of 'dup'
// ERROR-COUNT: 2
#[derive(Clone, Copy)]
struct G {
    n: i64,
}

impl Drop for G {
    fn drop(&mut self) {}
}

struct N {
    n: i64,
}

fn dup<T: Clone>(x: &T) -> T {
    x.clone()
}

fn main() {
    let g = G { n: 1 };
    let a = N { n: 1 };
    let c = dup(&a);
    println("{} {}", g.n, c.n);
}
