// RULE: D2.7
// (0.30.1) A temporary's place is named on one line: the source of a
// block over lines with its whitespace runs one space, so the message
// keeps its `FILE:L:C: error[...]` form (and --json its message).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '{ let q = w; q }.s' as mutable
// ERROR-COUNT: 1
struct W<'a> {
    s: &'a mut [i64],
}

fn fill(s: &mut [i64]) {
    s[0] = 1;
}

fn g(w: &W<'_>) {
    fill({
        let q = w;
        q
    }.s);
}

fn main() {}
