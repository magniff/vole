// ERROR: the trait 'Tr' is not implemented for 'Wr<IntoIter<i64, Gpa>>'
// (RT-269) an impl's `where I::Item: Conv<i64>` is required where it is chosen (rustc E0277; v0.30.1 accepted it).
trait Conv<X> {}

trait Tr {
    fn f(&self) -> i64;
}

struct Wr<I> {
    i: I,
}

impl<I: Iterator> Tr for Wr<I>
    where
        I::Item: Conv<i64>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn need<T: Tr>(t: &T) -> i64 {
    t.f()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", need(&Wr { i: v.into_iter() }));
}
