// XFAIL: RT-352: WRONG CODE: a closure parameter pattern `|&x: &S|` binds x to the reference itself, so `T1::f(x)` and `x.f()` run the impl for &S, not for S (vole `20 20`, rustc `10 10`); `for &x` and `let &y` are right (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 10 10
// EXPECT: 20 20 20 10
trait T1 {
    fn f(self) -> i64;
}

#[derive(Clone, Copy)]
struct S;

impl T1 for S {
    fn f(self) -> i64 {
        10
    }
}

impl<'a> T1 for &'a S {
    fn f(self) -> i64 {
        20
    }
}

fn main() {
    let a = [S, S];
    let c = |&x: &S| T1::f(x);
    let d = |&x: &S| x.f();
    println("{} {}", c(&a[0]), d(&a[0]));
    let w: i64 = a.iter().map(|&x| T1::f(x)).sum();
    let v: i64 = a.iter().map(|&x| x.f()).sum();
    let mut t: i64 = 0;
    for &x in a.iter() {
        t += T1::f(x);
    }
    let &y = &a[0];
    println("{} {} {} {}", w, v, t, T1::f(y));
}
