// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.escape: out stores a view of a sink String, dropped at the return
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 4, column 59
fn f(out: &mut Vec<&str, Gpa>, s: String<Gpa>) { out.push(s.as_str()); }

fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("hello", gpa);
    let mut out: Vec<&str, Gpa> = Vec::new_in(gpa);
    f(&mut out, s);
    println("{}", out[0usize]);
    0
}
