// RULE: F8.4
// `<<W as Mk>::Out as B>::b()`, W generic and bare inside a qualified self type: rustc E0107. A guard: the branch before the fix read a self type that is not a name as a type already; v0.30.1 did not parse it.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// ERROR: 'W' is generic: write its type arguments ('W<...>')
trait Mk {
    fn mk() -> Self;
    const C: i64;
    type Out;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }

    const C: i64 = 7;
    type Out = i64;
}

trait B {
    fn b() -> i64;
}

impl B for i64 {
    fn b() -> i64 {
        8
    }
}

fn main() {
    println("{}", <<W as Mk>::Out as B>::b());
}
