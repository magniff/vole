// RT-396, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig-m2 (form f270y). Since v0.30.1 at least;
// the release build the same. rustc E0271 (type mismatch resolving
// `<W as Tr<i64>>::Out == i64`) at the call (the rustc twin of this file).
// Sibling: rt_396 (the argument by default).
// ERROR: line 29
// ERROR-COUNT: 1
trait Tr<U> {
    type Out;
}

struct W {
    r: i64,
}

impl Tr<i32> for W {
    type Out = i64;
}

impl Tr<i64> for W {
    type Out = i32;
}

fn need<Z: Tr<i64, Out = i64>>(z: &Z) -> i64 {
    1
}

fn main() {
    println("{}", need(&W { r: 0 }));
}
