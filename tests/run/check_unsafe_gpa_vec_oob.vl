// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe address out of bounds: offset 800 of a block of 32 bytes (an address from offset 0)
// 0.30.1: a pointer 100 elements past a Vec's 4 is stopped where it is
// made (std's ptr::add: an address must stay in its block or one past
// its end, as Rust's add), under --check-unsafe alone. From 0.28.0 to
// 0.30.0 the check did not know Gpa's blocks and this read garbage.
fn main(gpa: Gpa) {
    let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let p: *const u64 = v.as_ptr();
    // UNSAFE: a deliberate read past the block, to test --check-unsafe.
    // SAFETY: none: this program exists to be stopped.
    let x = unsafe { *p.add(100) };
    println("read {x}");
}
