// EDITION: rust
// RULE: F18.6, F18.2
// A variable no check fixes by the function's end is error type.infer
// (rustc E0282) at the call that made it, with the annotation to write; so
// is a use that needs its type before then: a format hole, `as`, a method
// of the bare variable.
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'Vec::new_in'
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'Vec::new_in'
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'make'
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'make'
trait Zero {
    fn zero() -> Self;
}

impl Zero for i64 {
    fn zero() -> i64 {
        0
    }
}

fn make<T: Zero>() -> T {
    T::zero()
}

fn never_fixed(gpa: Gpa) {
    let v = Vec::new_in(gpa);
    println("{}", v.len());
}

fn hole(gpa: Gpa) {
    let v = Vec::new_in(gpa);
    println("{:?}", v);
}

fn cast() -> i64 {
    make() as i64
}

fn method() {
    let x = make();
    x.zero();
}

fn main(gpa: Gpa) {
    never_fixed(gpa);
    hole(gpa);
    cast();
    method();
}
