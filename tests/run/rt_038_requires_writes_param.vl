// RT-38 (F1): a `requires` is checked in `f$pre`, whose by-value
// parameters are the call's arguments read in place, borrowed copies.
// A `mut` parameter or a `mut` binding let the clause write one: `o =
// None`, `o.take()`, `mem::replace`, `mem::swap`, a `mut self` method,
// `(mut o, _)` in a match, a write to a Copy parameter: the caller's
// Option was emptied and its Vec freed under the body (use after free),
// or a Drop value dropped twice. The rule: a clause is a predicate, it
// writes, lends `&mut` or moves nothing it did not make; a by-value
// parameter of `f$pre` is read as through `&T`, so each is refused by
// the borrow rules (rustc, of the same clause written on `r: &T`: E0594
// for an assignment, E0596 for `&mut`, E0507 for the `mut` binding's
// move).
// (0.30.2, RT-38g: std's `Option::take`, `mem::replace` and `mem::swap`
// write through raw pointers, which no clause may do, contract.effect:
// the clauses that call them get it as well, beside the borrow error.)
// FLAGS: --check-alloc
// ERROR: error[borrowck.assign_immutable]: cannot assign to 'o', a borrowed copy
// ERROR: line 52, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'o' as mutable, a borrowed copy
// ERROR: line 61, column 14
// ERROR: error[contract.effect]: the 'requires' of 'take' calls 'Option<Vec<i64, Gpa>>::take', which writes through a raw pointer
// ERROR: line 61, column 14
// ERROR: error[contract.effect]: the 'requires' of 'replace' calls 'replace<Option<Vec<i64, Gpa>>>', which writes through a raw pointer
// ERROR: line 67, column 14
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'o' as mutable, a borrowed copy
// ERROR: line 67, column 32
// ERROR: error[contract.effect]: the 'requires' of 'swap' calls 'swap<Option<Vec<i64, Gpa>>>', which writes through a raw pointer
// ERROR: line 75, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'o' as mutable, a borrowed copy
// ERROR: line 75, column 20
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'self.o' as mutable, a borrowed copy
// ERROR: line 89, column 18
// ERROR: error[contract.effect]: the 'requires' of 'by_self' calls 'Option<Vec<i64, Gpa>>::take', which writes through a raw pointer
// ERROR: line 89, column 18
// ERROR: error[contract.move]: a clause moves 't'
// ERROR: line 97, column 6
// ERROR: error[contract.effect]: the 'requires' of 'binding' calls 'Option<Vec<i64, Gpa>>::take', which writes through a raw pointer
// ERROR: line 97, column 19
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'v[_]' as mutable, a borrowed copy
// ERROR: line 105, column 14
// ERROR: error[contract.effect]: the 'requires' of 'element' calls 'Option<Vec<i64, Gpa>>::take', which writes through a raw pointer
// ERROR: line 105, column 14
// ERROR: error[borrowck.assign_immutable]: cannot assign to 'n', a borrowed copy
// ERROR: line 115, column 5
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*s.r', a borrowed copy
// ERROR: line 129, column 5
// ERROR-COUNT: 15
use std::alloc::Allocator;

fn assign(mut o: Option<Vec<i64, Gpa>>) -> i64
    requires {
    o = None;
    true
}

{
    o.unwrap()[0]
}

fn take(mut o: Option<Vec<i64, Gpa>>) -> i64
    requires o.take().is_some()
{
    o.unwrap()[0]
}

fn replace(mut o: Option<Vec<i64, Gpa>>) -> i64
    requires std::mem::replace(&mut o, None).is_some()
{
    o.unwrap()[0]
}

fn swap(mut o: Option<Vec<i64, Gpa>>) -> i64
    requires {
    let mut n: Option<Vec<i64, Gpa>> = None;
    std::mem::swap(&mut o, &mut n);
    n.is_some()
}

{
    o.unwrap()[0]
}

struct S<A: Allocator> {
    o: Option<Vec<i64, A>>,
}

impl<A: Allocator> S<A> {
    fn by_self(mut self) -> i64
        requires self.o.take().is_some()
    {
        self.o.unwrap()[0]
    }
}

fn binding(t: (Option<Vec<i64, Gpa>>, i64)) -> i64
    requires match t {
    (mut o, _) => o.take().is_some(),
}

{
    t.0.unwrap()[0]
}

fn element(mut v: [Option<Vec<i64, Gpa>>; 1]) -> i64
    requires v[0].take().is_some()
{
    match &v[0] {
        Some(w) => w[0],
        None => -1,
    }
}

fn copy(mut n: i64) -> i64
    requires {
    n += 1;
    n > 0
}

{
    n
}

struct R<'a> {
    r: &'a mut i64,
}

fn through(s: R<'_>) -> i64
    requires {
    *s.r = 7;
    true
}

{
    *s.r
}

fn main(gpa: Gpa) {
    println("{}", assign(Some(Vec::from_in([5i64], gpa))));
    println("{}", take(Some(Vec::from_in([5i64], gpa))));
    println("{}", replace(Some(Vec::from_in([5i64], gpa))));
    println("{}", swap(Some(Vec::from_in([5i64], gpa))));
    println("{}", S { o: Some(Vec::from_in([5i64], gpa)) }.by_self());
    println("{}", binding((Some(Vec::from_in([5i64], gpa)), 1)));
    println("{}", element([Some(Vec::from_in([5i64], gpa))]));
    println("{}", copy(5));
    let mut a = 1i64;
    println("{}", through(R { r: &mut a }));
}
