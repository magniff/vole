// (0.27.1) Two `&mut` results of one receiver, both live.
// ERROR: :22:13: error[borrowck.mut_twice]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn x_mut(&mut self) -> &mut i64 {
        &mut self.x
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = s.x_mut();
    let q = s.x_mut();
    *r += 1;
    *q += 1;
    println("{}", s.x);
}
