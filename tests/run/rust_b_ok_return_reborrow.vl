// EDITION: rust
// RULE: D6.2.2
// (0.27.1) `&*x` is not frame-owned: its loan carries the parameter's
// region.

fn f(x: &i64) -> &i64 {
    &*x
}

fn main() {
    let a: i64 = 5;
    println("{}", *f(&a));
}
// EXPECT: 5
