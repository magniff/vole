// RULE: D3.6 (0.30.2, RT-383) A field's written regions bind the part a
// literal stores in it, whether or not the literal's type has a lifetime or
// a type argument of its own: a `&'static` field (in a nested generic, an
// `Option`, an array, a tuple, a `&'static [&'static T]`, a `&'static mut`)
// takes only a `'static` borrow. Each function here returns or keeps a
// borrow of its own local; rustc: E0597 at each (twin: one error a fn).
// Before 0.30.2 a literal of a type with no slots related none of its
// parts: all of these were accepted and read freed stack.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 63, column 19
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 71, column 25
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 76, column 18
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 81, column 19
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 86, column 15
// ERROR: error[borrowck.return_local]
// ERROR: line 91, column 26
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 97, column 16
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 98, column 14
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 103, column 13
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 108, column 17
// ERROR-COUNT: 10
struct V {
    a: &'static u64,
}

struct W<T> {
    t: T,
}

struct G<T> {
    t: T,
    a: &'static u64,
}

struct Opt {
    a: Option<&'static u64>,
}

struct Arr {
    a: [&'static u64; 2],
    b: (u8, &'static u64),
}

struct Sl {
    a: &'static [&'static u64],
}

struct Mu {
    a: &'static mut u64,
}

impl V {
    fn mk() -> Self {
        let e = 1u64;
        Self { a: &e }
    }
}

static K: u64 = 9;

fn nested() -> W<Option<(V, u8)>> {
    let e = 2u64;
    W { t: Some((V { a: &e }, 1)) }
}

fn generic_plus_static() -> G<i64> {
    let e = 3u64;
    G { t: 1, a: &e }
}

fn option_field() -> Opt {
    let e = 4u64;
    Opt { a: Some(&e) }
}

fn array_field() -> Arr {
    let e = 5u64;
    Arr { a: [&e, &K], b: (1, &K) }
}

fn destructured() -> &'static u64 {
    let e = 6u64;
    let V { a } = V { a: &e };
    a
}

fn static_elements() -> Sl {
    let e = 7u64;
    let arr = [&e];
    Sl { a: &arr }
}

fn mut_field() -> Mu {
    let mut e = 8u64;
    Mu { a: &mut e }
}

fn through_deref(p: &mut V) {
    let e = 10u64;
    *p = V { a: &e };
}

fn main() {
    let mut v = V { a: &K };
    through_deref(&mut v);
    println("{} {} {} {} {} {} {} {} {}", V::mk().a, nested().t.unwrap().0.a,
        generic_plus_static().a, option_field().a.unwrap(), array_field().a[0], destructured(),
        static_elements().a[0], mut_field().a, v.a);
}
