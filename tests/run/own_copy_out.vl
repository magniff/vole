// XFAIL: gap 17: compile type error: 'Vec<u8, Gpa>' does not implement Display, which '{x}' needs
// (0.17, T7) What err_own_copy_out's try: lines give: a copy (`.clone()`),
// the value taken out with an empty one left (`std::take`, `v.take()`),
// replaced (`std::replace`), removed (`v.remove(i)`), or borrowed (`&v[i]`).
// Nothing is freed twice, nothing leaks.
// FLAGS: --check-alloc
// EXPECT: x y z 3 1 0 w 2
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
use std::mem; use std::alloc::Allocator; struct S<A: Allocator> { f: Vec<u8, A> }

fn first_clone(v: &Vec<String<Gpa>, Gpa>) -> String<Gpa> { v[0].clone() }
fn take_field(s: &mut S<Gpa>) -> Vec<u8, Gpa> { s.f.take() }
fn swap_in(s: &mut S<Gpa>, b: Vec<u8, Gpa>) -> Vec<u8, Gpa> { mem::replace(&mut s.f, b) }
fn len_of(b: &String<Gpa>) -> i64 { b.len() as i64 }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("x", gpa));
    v.push(String::from_in("y", gpa));
    v.push(String::from_in("z", gpa));
    let a = first_clone(&v);
    let b = v.remove(1usize);
    let c = v[1usize].clone().clone();
    let mut s = S { f: b"abc".to_vec_in(gpa) };
    let t = take_field(&mut s);
    let old = swap_in(&mut s, b"w".to_vec_in(gpa));
    println("{a} {b} {c} {} {} {} {} {}", t.len(), len_of(&v[0]), old.len(), s.f, v.len());
    0
}
