// places IR (0.26.1, R1): S8's case with its bodies kept and loaded back
// (--keep-places, as a build whose code generators read the IR keeps
// them): the same IR as places_s08_tuple_wild.
// FLAGS: --keep-places
// sem-own: `let (a, _) = t;` moves t.0; t.1 stays in t and is dropped at
// t's scope end, once.
// EXPECT: a 1
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn main
// PLACES: drop(_4) [removed]
// PLACES: drop(_3) [removed]
// PLACES: drop(_5) [kept]
// PLACES: drop(_2) [open]
// PLACES: drop(_2.1) [kept]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let t = (mk(1, gpa), mk(2, gpa));
    {
        let (a, _) = t;
        println(f"a {a.id}");
    }
    println("end");
}
