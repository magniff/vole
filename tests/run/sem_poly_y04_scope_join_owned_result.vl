// scoped threads return owned values through join: each dropped once
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: 3
use std::thread;
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

fn main() {
    let t = thread::scope(|s| ({ let s = s; {
        let a = s.spawn(|| R { id: 1 });
        let b = s.spawn(|| R { id: 2 });
        let x = a.join().unwrap();
        let y = b.join().unwrap();
        x.id + y.id
    } }));
    println("{t}");
}
