// RULE: D2.7
// (0.30.1, RT-33 round 2, F2) `(if c { &a[..] } else { &a[1..] })
// .reverse()`: the receiver is the `if`'s shared view, given where
// reverse takes `&mut [T]`, rustc's E0596 (data in a `&` reference). Before,
// a temporary was not asked, and a was written while `r` was live.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 13, column 5
// ERROR-COUNT: 1
fn main() {
    let mut a = [1i64, 2, 3];
    let r: &[i64] = &a[..];
    let before = r[0];
    (if true { &a[..] } else { &a[1..] }).reverse();
    println("{} {}", before, r[0]);
}
