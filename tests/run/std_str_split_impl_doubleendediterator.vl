// Runs on std since 0.27.2's switch.
// The std item(s): std::str Split::impl DoubleEndedIterator.
// EXPECT: Some("c") Some("a") Some("b") None
use std::str::CharIndices;

fn main() {
    let mut it = "a,b,c".split(',');
    let x = it.next_back();
    let y = it.next();
    let z = it.next_back();
    println("{:?} {:?} {:?} {:?}", x, y, z, it.next());
}
