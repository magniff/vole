// XFAIL: RT-72: `c.drop()` in `fn shut<C: Closer>` (Closer's own `drop`) is refused with E0040 at the instance: the instance resolves the call by name (0.30.2)
// rustc prints the EXPECT lines. The trait-default form is rt_072g.
// Since v0.30.1 at least. From the re-review of g302index.
// EXPECT: closer 1
// EXPECT: closer 2
// EXPECT: closer 1
// EXPECT: end
// EXPECT: Drop 2
// EXPECT: Drop 1
trait Closer {
    fn drop(&mut self);
}

struct W<T> {
    t: T,
    k: i64,
}

impl<T> Closer for W<T> {
    fn drop(&mut self) {
        println("closer {}", self.k);
    }
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn shut<C: Closer>(c: &mut C) {
    c.drop();
}

fn main() {
    let mut a = W { t: 1i64, k: 1 };
    let mut b = W { t: 2u8, k: 2 };
    Closer::drop(&mut a);
    Closer::drop(&mut b);
    shut(&mut a);
    println("end");
}
