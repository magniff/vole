#[derive(Clone, Copy)] struct Ring<T> { items: [T; 4], len: i64 }

impl<T> Ring<T> {
    fn at(&self, i: i64) -> T
        requires 0 <= i && i < self.len
    {
        self.items[i as usize]
    }

    fn put(&mut self, x: T)
        requires self.len < 4 else "the ring is full"
        ensures self.len == old(self.len) + 1
    {
        unsafe {
            self.items[self.len as usize] = x;
            self.len += 1;
        }
    }
}

fn first<T: Clone>(s: &[T]) -> T requires s.len() > 0 { s[0].clone() }

fn main() -> i32 {
    let mut r: Ring<i64> = Ring { items: [0i64; 4], len: 0 };
    r.put(7i64);
    print("{}", r.at(0i64));
    println("");
    print("{}", first(&[2i64, 3][..]));
    println("");
    print("{}", r.at(1i64));
    0
}
