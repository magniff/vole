// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Rem::Output.
// EXPECT: V { x: 2 }
use std::ops::Rem;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Rem for V {
    type Output = V;

    fn rem(self, rhs: V) -> V {
        V { x: self.x % rhs.x }
    }
}

fn apply<T: Rem<Output = T>>(a: T, b: T) -> T {
    a % b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    let c: <V as Rem>::Output = apply(a, b);
    println("{:?}", c);
}
