// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::sources Successors::impl Iterator.
// EXPECT: Some(2) Some(4) None
use std::iter::FusedIterator;

fn main() {
    let mut s = std::iter::successors(Some(2i64), |x| if *x < 4 { Some(x * 2) } else { None });
    let a = s.next();
    let b = s.next();
    println("{:?} {:?} {:?}", a, b, s.next());
}
