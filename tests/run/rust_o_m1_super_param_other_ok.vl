// (0.30.2, obligations M1) rust_o_m1_super_param_err with the bound on
// Sup<i64>: Sub<i32> needs Sup<i32> only, whose impl needs nothing. rustc
// accepts it.
// EXPECT: 1
trait Sup<P> { fn up(&self) -> i64; }
trait Sub<P>: Sup<P> { fn n(&self) -> i64; }
struct X<'c> { r: &'c str }
impl<'c> Sup<i32> for X<'c> { fn up(&self) -> i64 { 32 } }
impl<'c: 'static> Sup<i64> for X<'c> { fn up(&self) -> i64 { 64 } }
impl<'c> Sub<i32> for X<'c> { fn n(&self) -> i64 { 1 } }
fn go<T: Sub<i32>>(t: &T) -> i64 { t.n() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello heap string long", gpa);
    println("{}", go(&X { r: st.as_str() }));
}
