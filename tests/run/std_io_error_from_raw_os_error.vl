// Runs on std since 0.27.2's switch.
// The std item(s): std::io Error::from_raw_os_error.
// EXPECT: NotFound Some(2)
// EXPECT: No such file or directory (os error 2)
use std::io::{ErrorKind, self};

fn main() {
    let e = io::Error::from_raw_os_error(2);
    println("{:?} {:?}", e.kind(), e.raw_os_error());
    println("{}", e);
}
