// (0.28.0) `volec test` on std: a #[property] over a struct and an enum
// of the program, which have no generator of their own: the harness
// writes their `impl std::test::Arbitrary`, field by field. A one-letter
// name, `P`, was taken for a type parameter and got none.
// FLAGS: --test-build
// ARGS: --vole-test holds
// EXIT: 0
struct P {
    x: i64,
    on: bool,
}

enum Shape {
    Dot,
    Line(i64),
    Box { w: u8, h: u8 },
}

fn area(s: &Shape) -> i64 {
    match s {
        Shape::Dot => 0,
        Shape::Line(_) => 0,
        Shape::Box { w, h } => (*w as i64) * (*h as i64),
    }
}

#[property]
fn holds(p: P, s: Shape) {
    if p.on && p.x != p.x {
        panic("a field changed");
    }
    if area(&s) < 0 {
        panic("a negative area");
    }
}

fn main() {}
