// a closure that grows v and v itself passed let: the callee's slice of s dangles after f()
// ERROR: borrowck.borrow_immutable
fn run<F: FnMut()>(f: F, s: &Vec<i64, Gpa>) -> i64 { let a = s.as_slice(); f(); a[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    println("{}", run(|| { for i in 0..1000 { v.push(i); } }, &v));
}
