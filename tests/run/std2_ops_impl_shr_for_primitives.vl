// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl Shr for primitives.
// EXPECT: 3 3
use std::ops::Shr;

fn apply<T: Shr<Output = T>>(a: T, b: T) -> T {
    a.shr(b)
}

fn main() {
    println("{} {}", apply(12i64, 2), apply(12u8, 2));
}
