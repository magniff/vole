// XFAIL: gap 3: compile type error: no method 'cloned' on type 'Option<let D<Gpa>>'
// sem-own (iterator stopgap): HashMap::get of an owned value returns a copy the map still owns.
// Accepted: the result is read in place (a borrow), and each value is dropped once.
// EXPECT: drop 5
// EXPECT: drop 1
// EXPECT: drop 2
use std::hash::FixedState;
use std::alloc::Allocator; use std::collections::HashMap;
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn two(gpa: Gpa) -> Vec<D<Gpa>, Gpa> {
    let mut w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn eat(d: D<Gpa>) {}

fn main(gpa: Gpa) {
    let w = two(gpa);
    let mut m: HashMap<i64, D<Gpa>, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, mk(5, gpa));
    let x = m.get(&1).cloned();
}
