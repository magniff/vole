// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::iter.
// EXPECT: [(1, 10), (2, 20), (3, 30)]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(3, 30);
    m.insert(1, 10);
    m.insert(2, 20);
    let mut v: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    for (k, x) in m.iter() {
        v.push((*k, *x));
    }
    v.sort();
    println("{:?}", v);
}
