// (re-review 2 of M2, form p02) As p01, PA held through a blanket impl
// (`impl<X: PB> PA for X`): its rows are not PC's answer (rustc: E0277).
// ERROR: 'Tr' requires 'W<T>: Sup', which is not implemented
// ERROR-COUNT: 1
trait Sup {}

trait Tr: Sup {}

trait PA {}

trait PB {}

trait PC {}

impl<X: PB> PA for X {}

struct W<T> {
    t: T,
}

impl<T: PA + PC> Sup for W<T> {}

impl<T: PB> Tr for W<T> {}

fn main() {
    println("done");
}
