// Recursive quicksort (Lomuto) over an array of pseudo-random numbers.
// EXPECT: 1 -500 -500 -17 498
// (0.26.4) Its PRNG and checksums are written wrapping_*.
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

fn at(a: *mut i64, i: i64) -> *mut i64 { unsafe { a.add(i as usize) } }

fn swap(a: *mut i64, i: i64, j: i64) {
    let t = unsafe { *at(a, i) };
    unsafe {
        *at(a, i) = *at(a, j);
        *at(a, j) = t;
    }
}

fn partition(a: *mut i64, lo: i64, hi: i64) -> i64 {
    let pivot = unsafe { *at(a, hi) };
    let mut i = lo;
    let mut j = lo;
    while j < hi {
        if unsafe { *at(a, j) < pivot } {
            swap(a, i, j);
            i += 1;
        }
        j += 1;
    }
    swap(a, i, hi);
    i
}

fn quicksort(a: *mut i64, lo: i64, hi: i64) {
    if lo < hi {
        let p = partition(a, lo, hi);
        quicksort(a, lo, p - 1);
        quicksort(a, p + 1, hi);
    }
}

fn main() -> i64 {
    let mut data: [i64; 200] = [0i64; 200];
    let mut seed: u64 = 12345;
    let mut i: i64 = 0;
    while i != 200 {
        seed = seed.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        data[i as usize] = ((seed >> 33) % 1000) as i64 - 500;
        i += 1;
    }
    let base = data.as_mut_ptr() as *mut i64;
    unsafe { quicksort(base, 0, 199); }
    let mut ok = true;
    i = 1;
    while i != 200 {
        if data[(i - 1) as usize] > data[i as usize] { ok = false; }
        i += 1;
    }
    unsafe { printf(c"%d %ld %ld %ld %ld\n", ok, data[0], data[1], data[100], data[199]); }
    0
}
