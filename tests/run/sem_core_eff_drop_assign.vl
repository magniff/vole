// Assigning over a value drops the old one.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(&mut self) { println("dropped"); } }

#[no_io]
fn quiet(x: &mut Noisy) { *x = Noisy { n: 9 }; }

fn main() -> i32 {
    let mut a = Noisy { n: 1 };
    quiet(&mut a);
    println("{}", a.n);
    0
}
