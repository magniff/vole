// RULE: F8.3, F8.4
// RT-93, from the g302qual review (form f07_nested_proj): `<<S as A>::Out as C>::K`, `::m`, as a value and called: a nested qualified path.
// rustc prints the EXPECT lines.
// EXPECT: 2 3 30 20
trait A { type Out; }
trait B { const K: i64; fn m(&self) -> i64; }
trait C { const K: i64; fn m(&self) -> i64; }
struct S; struct T;
impl A for S { type Out = T; }
impl B for T { const K: i64 = 2; fn m(&self) -> i64 { 20 } }
impl C for T { const K: i64 = 3; fn m(&self) -> i64 { 30 } }

fn main() {
    let t = T; let f =<<S as A>::Out as C>::m;
    println("{} {} {} {}",<<S as A>::Out as B>::K,<<S as A>::Out as C>::K, f(&t),
        <<S as A>::Out as B>::m(&t));
}
