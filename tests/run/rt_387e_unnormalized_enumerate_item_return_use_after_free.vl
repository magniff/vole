// XFAIL: RT-387: UNSOUND: (RT-387's mechanism, `I::Item` of an Enumerate) `fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item>` is read as borrowing k only: `first(v.iter().enumerate(), &k)` then `drop(v)` before the result's use is accepted, a use after free (rustc E0505) (0.30.2)
// From the review of g302bor2 (form B/b33). Since v0.30.1 at least; the
// release build the same. rustc E0505 at the drop (the rustc twin of this
// file): the Item is `(usize, &i64)`, a borrow of v two levels down. vole
// builds it and --check-alloc reports a use after free of v's buffer.
// Siblings: rt_387, rt_387b, rt_387c, rt_387d (a Zip).
// FLAGS: --check-alloc
// ERROR: line 20
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = first(v.iter().enumerate(), &k);
    drop(v);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?}", r, x);
}
