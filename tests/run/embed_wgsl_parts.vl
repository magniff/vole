// 0.26.2: shader parts (decision 19): `embed wgsl K with A, B { .. }`. K's
// module is its parts' texts, depth-first and each once, then its own; a
// part may hold entry points, which become fields of each block that
// includes it (BLUR's `main` is K_BLUR_X.main), and may read what its
// users declare (BLUR reads DIR, declared after it). COMMON is named
// twice in each kernel's parts and comes once.
// EXPECT: main main
// EXPECT: COMMON 1 1
// EXPECT: DIR last: true true
embed wgsl COMMON {
    @group(0) @binding(0) var<storage, read_write> data: array<f32>;

    fn at(i: u32) -> f32 {
        return data[i];
    }
}

embed wgsl BLUR with COMMON {
    @compute @workgroup_size(64)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        data[id.x] = at(id.x) + f32(DIR.x);
    }
}

embed wgsl K_BLUR_X with COMMON, BLUR {
    const DIR: vec2<i32> = vec2<i32>(1, 0);
}

embed wgsl K_BLUR_Y with BLUR, COMMON {
    const DIR: vec2<i32> = vec2<i32>(0, 1);
}

fn count(s: [u8], word: [u8]) -> i64 {
    var n = 0;
    var i = 0;
    while i + word.len as i64 <= s.len as i64 {
        if s[i..i + word.len as i64] == word {
            n += 1;
        }
        i += 1;
    }
    n
}

fn find(s: [u8], word: [u8]) -> i64 {
    var i = 0;
    while i + word.len as i64 <= s.len as i64 {
        if s[i..i + word.len as i64] == word {
            return i;
        }
        i += 1;
    }
    -1
}

fn main() -> i32 {
    println(f"{K_BLUR_X.main} {K_BLUR_Y.main}");
    println(f"COMMON {count(K_BLUR_X.src, "var<storage")} {count(K_BLUR_Y.src, "var<storage")}");
    let x = K_BLUR_X.src;
    let y = K_BLUR_Y.src;
    println(
        f"DIR last: {find(x, "const DIR") > find(x, "fn main")} {find(y, "const DIR") > find(y, "fn main")}");
    0
}
