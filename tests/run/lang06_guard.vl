// A guard, a value whose Drop runs at its scope's exit, last first, on
// every way out: the end of the block, return, break and continue
// (labelled too); a returned or broken-out value is computed before the
// drops run. (0.6 to 0.26.1: `defer`, which 0.26.2 removes; the guard
// does what it did.)
// EXPECT: 300 21
// EXPECT: -1 341
// EXPECT: 4042 66656665657
// EXPECT: block
// EXPECT: inner
static var LOG: i64 = 0;

fn note(d: i64) {
    LOG = LOG * 10 + d;
}

// Notes its digits when it is dropped.
struct Note { first: i64, then: i64 }

impl Drop for Note {
    fn drop(inout self) {
        note(self.first);
        if self.then != 0 {
            note(self.then);
        }
    }
}

fn early(x: i64) -> i64 {
    let _one = Note { first: 1, then: 0 };
    if x > 0 {
        let _two = Note { first: 2, then: 0 };
        return x * 100;
    }
    let _three_four = Note { first: 3, then: 4 };
    x
}

fn loops() -> i64 {
    var total = 0;
    outer: for i in 0..4 {
        let _five = Note { first: 5, then: 0 };
        var j = 0;
        while j < 3 {
            let _six = Note { first: 6, then: 0 };
            j += 1;
            if j == 2 { continue; }
            if i == 2 { break :outer; }
            total += 1;
        }
    }
    let v = loop {
        let _seven = Note { first: 7, then: 0 };
        break 42;
    };
    total * 1000 + v
}

// Prints `inner` when it is dropped (a guard holds no views).
struct Inner { n: i64 }

impl Drop for Inner {
    fn drop(inout self) { println("inner"); }
}

fn main() -> i32 {
    LOG = 0;
    let a = early(3);
    println("{a} {LOG}");
    LOG = 0;
    let b = early(-1);
    println("{b} {LOG}");
    LOG = 0;
    let l = loops();
    println("{l} {LOG}");
    {
        let _inner = Inner { n: 0 };
        println("block");
    }
    0
}
