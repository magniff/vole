// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::convert AsRef.
// EXPECT: 3 5
use std::convert::{AsRef, Infallible};
use std::string::String;

fn n<S: AsRef<str>>(s: S) -> usize {
    s.as_ref().len()
}

fn main(gpa: Gpa) {
    println("{} {}", n("abc"), n(String::from_in("hello", gpa)));
}
