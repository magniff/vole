// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::convert AsRef.
// EXPECT: 3 5
use std::convert::{AsRef, Infallible};
use std::string::String;

fn n<S: AsRef<str>>(s: S) -> usize {
    s.as_ref().len()
}

fn main(gpa: Gpa) {
    println("{} {}", n("abc"), n(String::from_in("hello", gpa)));
}
