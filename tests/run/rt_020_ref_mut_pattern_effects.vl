// RT-20 (fixed in 0.30.1): a `ref mut` binding of a counted while's variable is not a write: #[effects()] accepts a loop that never ends
// The same loop with `i = 0;` for the write is refused (error[effect]
// ... may not terminate (diverge)); with `match i { ref mut r => *r = 0 }`
// it is accepted, and spin(2) never returns.
// ERROR: error[effect]
// ERROR: line 9,
// ERROR-COUNT: 1
#[effects()]
fn spin(n: i64) -> i64 {
    let mut i = 0i64;
    while i < n {
        match i {
            ref mut r => *r = 0,
        }
        i += 1;
    }
    i
}

fn main() {
    println("{}", spin(0));
}
