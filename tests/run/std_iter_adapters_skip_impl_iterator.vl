// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Skip::impl Iterator.
// EXPECT: Some(3) None (0, Some(0))

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3], gpa);
    let mut it = s.iter().skip(2);
    let a = it.next().copied();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, s.iter().skip(5).size_hint());
}
