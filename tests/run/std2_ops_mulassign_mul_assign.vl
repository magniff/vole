// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops MulAssign::mul_assign.
// EXPECT: V { x: 60 } 60
use std::ops::MulAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl MulAssign for V {
    fn mul_assign(&mut self, rhs: V) {
        self.x *= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.mul_assign(V { x: 5 });
    let mut n = 12i64;
    n.mul_assign(5);
    println("{:?} {}", a, n);
}
