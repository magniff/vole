struct E { name: [u8; 8], len: i64 }
fn nm(e: &E) -> Option<&[u8]> { Some(&e.name[..e.len as usize]) }
fn nt(e: &E) -> (i64, &[u8]) { (e.len, &e.name[..e.len as usize]) }
#[derive(Clone, Copy)] struct V<'a> { t: &'a [u8] }
fn nv(e: &E) -> V<'_> { V { t: &e.name[..e.len as usize] } }

fn main() -> i32 {
    let mut e = E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 };
    let a = nm(&e).unwrap();
    let (_, b) = nt(&e);
    let c = nv(&e);
    e.len = 0;
    println("{a} {b} {}", str::from_utf8(c.t).unwrap(), a = str::from_utf8(a).unwrap(),
        b = str::from_utf8(b).unwrap());
    0
}
