// FLAGS: --check-alloc
// EXIT: 101
// STDERR: use after free: block #1 (4096 bytes), allocated at
// STDERR: checkalloc_arena_scope.vl:17:13, freed at
// STDERR: checkalloc_arena_scope.vl:20:5
// 0.16: --check-alloc: memory of an arena scope read after the scope ended
// is caught at its first use; the release is at the scope's end.
// (0.28: a slice returned out of the scope is borrowck.outlives; what
// leaves here is a raw pointer. std2's arena takes whole chunks from the
// checking Gpa, so the block named is the scope's chunk.)
use std::alloc::{Arena, ArenaScope};

fn main(gpa: Gpa) -> i32 {
    let p: *const i64 = Arena::new_in(gpa).scope(|s| {
        let mut v: Vec<i64, &ArenaScope<'_, Gpa>> = Vec::new_in(s);
        for i in 0..10 {
            v.push(i);
        }
        v.as_ptr()
    });
    // UNSAFE: a pointer into the scope's memory, read after the scope ended.
    // SAFETY: none, on purpose: --check-alloc stops the read.
    println("after {}", unsafe { *p.add(3) });
    0
}
