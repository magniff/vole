// EDITION: rust
// RULE: D2.4a
// (0.27.5) Read where it is evaluated, an operand still meets a loan that
// is live there: a reference kept past a push (rustc E0502), a read of an
// array under a live `&mut` the call takes after it (E0503), a moved value
// borrowed by a later argument (E0382).
// ERROR: error[borrowck.conflict]
// ERROR: line 30, column 5
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 34, column 10
// ERROR: error[borrowck.use_moved]
// ERROR: line 36, column 21
// ERROR-COUNT: 3
struct B {
    v: [i64; 3],
}

fn take(a: i64, w: &mut [i64; 2]) -> i64 {
    a + w[0]
}

fn keep(b: B, r: &B) -> usize {
    b.v.len() + r.v.len()
}

fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    v.push(1i64);
    let r = &v[0];
    v.push(2);
    println("{}", *r);
    let mut a = [1i64, 2];
    let w = &mut a;
    take(a[0], w);
    let b = B { v: [1, 2, 3] };
    let n = keep(b, &b);
    println("{}", n);
}
