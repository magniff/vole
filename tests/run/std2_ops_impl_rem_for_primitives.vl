// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl Rem for primitives.
// EXPECT: 2 2
use std::ops::Rem;

fn apply<T: Rem<Output = T>>(a: T, b: T) -> T {
    a.rem(b)
}

fn main() {
    println("{} {}", apply(12i64, 5), apply(12u8, 5));
}
