// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/f19_struct_shorthand)
// RUSTC: none contract clauses are not Rust
// ERROR: cannot move out of 'p'
// The alias put in a struct by shorthand init, then written through the struct.
type R<'a> = &'a mut i64;

struct S<'a> {
    p: &'a mut i64,
}

fn f(p: R<'_>) -> i64
    ensures {
    let s = S { p };
    *s.p = 9;
    true
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
