// RT-14, fixed in 0.30.1: --trace's SIGSEGV handler has a stack of its own
// (sigaltstack, SA_ONSTACK: middle::trace's runtime), so a stack overflow
// prints `stopped by signal 11` and the frames.
// guide debug: "A program stopped by SIGALRM, SIGINT, SIGTERM or SIGSEGV
// prints `stopped by signal N` and the frames". A null pointer read does
// (`stopped by signal 11 (SIGSEGV: an invalid memory access)`); a stack
// overflow, the SIGSEGV safe code can cause, prints nothing at all, with or
// without --trace: the handler runs on the stack that overflowed (no
// sigaltstack). The process dies by SIGSEGV (exit 139) silently. rustc's
// binary prints "thread 'main' has overflowed its stack". The directive
// asks only for the documented line; the exit code stays the signal's.
// FLAGS: --trace
// STDERR: stopped by signal
// EXIT: 139
fn rec(n: i64) -> i64 {
    if n == 0 {
        0
    } else {
        1 + rec(n - 1)
    }
}

fn main() {
    let n = 100000000 + std::env::args().count() as i64;
    println("{}", rec(n));
}
