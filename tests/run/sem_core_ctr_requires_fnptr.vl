// Through a fn value a requires is not checked at the call (documented);
// the function still keeps its own index check, so nothing is read out of bounds.
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index 1000000, length 3
static mut Z: i64 = 0;

fn at(s: &[i64], i: i64) -> i64
    requires 0 <= i && i < s.len() as i64
{
    s[i as usize]
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let f: fn(&[i64], i64) -> i64 = at;
    let a = [1i64, 2, 3];
    println("{}", f(&a[..], 2 + unsafe { Z }));
    println("{}", f(&a[..], 1000000 + unsafe { Z }));
    0
}
