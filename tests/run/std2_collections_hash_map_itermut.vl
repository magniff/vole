// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map IterMut.
// EXPECT: 1
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::IterMut;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let it: IterMut<'_, i64, i64> = m.iter_mut();
    println("{}", it.count());
}
