// RULE: F8.2, Z4.1
// RT-159: Self of a path call on a view. `Show::show(&s)` with `s: &str`
// is `<&str as Show>::show`, whose `Show::show(&**self)` is str's (`&*v`
// of a view is the view, rustc's `&*v: &str`). 0.30.1 printed `3 3 ab`
// (str's impl for `&s`, the receiver adjusted); a first version of the
// RT-159 fix recursed for ever in `&T`'s impl. rustc prints 3 1003 ab.
// EXPECT: 3 1003 ab
use std::fmt::{Display, Formatter, Result};

trait Show {
    fn show(&self) -> i64;
}

impl Show for str {
    fn show(&self) -> i64 { self.len() as i64 }
}

impl<T: Show + ?Sized> Show for &T {
    fn show(&self) -> i64 { Show::show(&**self) + 1000 }
}

struct W;

impl Display for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> Result { Display::fmt("ab", f) }
}

fn main() {
    let s: &str = "abc";
    println("{} {} {}", Show::show(s), Show::show(&s), W);
}
