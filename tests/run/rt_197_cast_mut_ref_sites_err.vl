struct H<'a> {
    r: &'a mut i64,
}

struct Hg<'a, T> {
    r: &'a mut T,
}

enum E<'a> {
    A(&'a mut i64),
    B,
}

fn g1(e: &E) -> *mut i64 {
    match e {
        E::A(r) => *r as *mut i64,
        E::B => std::ptr::null_mut(),
    }
}

fn g2(o: &Option<&mut i64>) -> *mut i64 {
    match o {
        Some(r) => *r as *mut i64,
        None => std::ptr::null_mut(),
    }
}

fn g3(h: &H) -> [*mut i64; 1] {
    [h.r as *mut i64]
}

fn g4(h: &H) -> [*mut i64; 1] {
    let a: [*mut i64; 1] = [h.r];
    a
}

fn g5<T>(h: &Hg<T>) -> *mut T {
    h.r as *mut T
}

fn g6(h: &H) -> *mut i64 {
    h.r
}

fn g7(h: &H) -> (*mut i64, i64) {
    (h.r as *mut i64, 0)
}

fn g8(hs: &Vec<H, Gpa>) -> *mut i64 {
    hs[0].r as *mut i64
}

fn g9(h: &H) -> Option<*mut i64> {
    Some(h.r)
}

fn g10(h: &H) -> (*mut i64, i64) {
    let t: (*mut i64, i64) = (h.r, 1);
    t
}

fn main() {}
