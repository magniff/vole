// RULE: F8.4, D22.1
// A guard of the qualified-path change (0.30.2): `<K as Lend<Q>>::lend`
// and `<T as Lend<T>>::TAG` where no bound of the parameter is Lend, the
// blanket impl `impl<T: ?Sized> Lend<T> for T` giving them (std's
// BTreeSet::is_subset reaches `<K as Borrow<Q>>::borrow` so). A first
// version of the change refused them in the generic bodies. rustc prints
// this line.
// EXPECT: true false 7
trait Lend<Q: ?Sized> { const TAG: i64; fn lend(&self) -> &Q; }
impl<T: ?Sized> Lend<T> for T { const TAG: i64 = 7; fn lend(&self) -> &T { self } }
fn via<K: Lend<Q>, Q: ?Sized + Ord>(k: &K, q: &Q) -> bool { <K as Lend<Q>>::lend(k) == q }
fn same<T: Ord>(a: &T, b: &T) -> bool { via(a, b) }
fn tag<T>(_: &T) -> i64 { <T as Lend<T>>::TAG }
fn main() { println("{} {} {}", same(&3i64, &3i64), same(&3i64, &4i64), tag(&1u8)); }
