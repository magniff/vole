// (0.25.5) std::process::Command: more than 32 arguments (0.25.4
// panicked past 32), env_remove (the child's environment without a
// variable), and foreground (this process ignores ^C and ^\ while it
// waits; the child starts with their default actions, so a SIGINT ends
// the child and this process reports it).
// ENV: VOLE_T_REMOVE=gone
// ENV: VOLE_T_KEEP=kept
// EXPECT: args 40 first a1 last a40
// EXPECT: env [] [kept]
// EXPECT: foreground: the child ended by signal 2, this process runs
// EXPECT: done

use std::process::{Command, Stdio};

fn main(gpa: Gpa) -> i32 {
    var c = Command::new("/bin/sh");
    c.arg("-c");
    c.arg("echo \"args $# first $1 last ${40}\"");
    c.arg("zero");
    var names: Vec<Buf> = Vec::new_in(gpa);
    for i in 1..41 {
        names.push(format_in(f"a{i}", gpa));
    }
    for n in names.iter_ref() {
        c.arg(n.as_slice());
    }
    let out = c.output_in(gpa).unwrap();
    print(out.stdout.as_slice());

    var e = Command::new("/bin/sh");
    e.args(["-c", "echo \"env [$VOLE_T_REMOVE] [$VOLE_T_KEEP]\""][..]);
    e.env_remove("VOLE_T_REMOVE");
    e.env_remove("VOLE_T_NOT_SET");
    let st = e.status().unwrap();
    if !st.success() {
        println(f"env: {st}");
    }

    var f = Command::new("/bin/sh");
    f.args(["-c", "kill -INT $PPID; kill -INT $$; sleep 1"][..]);
    f.stdout(Stdio::null());
    f.foreground(true);
    let fs = f.status().unwrap();
    match fs.signal() {
        Some(s) => println(f"foreground: the child ended by signal {s}, this process runs"),
        None => println(f"foreground: the child exited: {fs}"),
    }
    println("done");
    0
}
