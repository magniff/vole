// XFAIL: RT-417: `let a = id(255); format_args("{}", a); let b: u8 = a;` is refused: the format_args hole closes a at i32 before the u8 use; rustc types a u8 and prints `255 255` (RT-410's mechanism, a refusal) (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 255 255
fn id<T>(x: T) -> T {
    x
}

fn main() {
    let a = id(255);
    let s = format_args("{}", a);
    let b: u8 = a;
    println("{} {}", s, b);
}
