// XFAIL: gap 20: xfail case fails differently: borrowck.move_out; rustc rejects with E0596 (the closure not mut): the transl...
// a sink closure moving one field out of a captured struct: the other field freed by the closure's drop
// FLAGS: --check-alloc
// EXPECT: 1
// MVS's XFAIL: OVERSTRICT a sink closure may move a whole capture out but not one field of it
use std::alloc::Allocator; struct P<A: Allocator> { a: Vec<i64, A>, b: Vec<i64, A> }
fn eat(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }
fn call<F: FnMut() -> i64>(f: F) -> i64 { f() }

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    b.push(2); b.push(3);
    let p = P { a: a, b: b };
    println("{}", call(move || eat(p.a)));
}
