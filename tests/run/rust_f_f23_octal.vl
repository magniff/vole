// EDITION: rust
// RULE: F23.5
// (0.27.6) `0o` literals: base 8, `_` between digits, typed by the
// expected type or a suffix like any integer literal; `{:o}` prints base 8.
// EXPECT: 420 493 15 511 644 0o755 true
fn mode(m: u32) -> u32 {
    m & 0o777
}

fn main() {
    let a = 0o644;
    let b: u32 = 0o7_55;
    let c = 0o17u8;
    let d = mode(0o1777);
    let e: i64 = -0o10;
    println("{} {} {} {} {:o} {:#o} {}", a, b, c, d, a, b, e == -8);
}
