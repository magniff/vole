// RULE: F35.1 (0.30.2, RT-148) An array repeat `[e; N]`, N > 1, copies e
// into each element: e must be Copy (rustc E0277). Each form below is
// refused by rustc and was built by v0.30.1, its copies each dropped (a
// double free, a Drop run N times). A String, an Option of a Box, a tuple
// holding a String, a closure that owns a Vec, `&mut`, an alias of Vec, a
// nested repeat whose inner array is not Copy, `None` of a Box (a variant,
// not a constant), an iterator returned as `impl Iterator`, a generic T
// with a Clone bound only, a struct holding a T, and a static.
// ERROR: line 46
// ERROR: line 51
// ERROR: line 56
// ERROR: line 63
// ERROR: line 69
// ERROR: line 75
// ERROR: line 80
// ERROR: line 85
// ERROR: line 90
// ERROR: line 95
// ERROR: line 101
// ERROR: line 106
// ERROR-COUNT: 12
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

struct Holder<T> {
    t: T,
}

type V = Vec<i64, Gpa>;

static S: D = D { k: 9 };

fn evens() -> impl Iterator<Item = i64> {
    (0i64..4).map(|x| x * 2)
}

fn strings(gpa: Gpa) -> usize {
    let s = String::from_in("x", gpa);
    let a = [s; 2];
    a.len()
}

fn boxes(gpa: Gpa) -> usize {
    let a = [Some(Box::new_in(1i64, gpa)); 3];
    a.len()
}

fn tuples(gpa: Gpa) -> usize {
    let a = [(String::from_in("x", gpa), 1i64); 2];
    a.len()
}

fn closures(gpa: Gpa) -> usize {
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let c = move || v.len();
    let a = [c; 2];
    a.len()
}

fn muts() -> usize {
    let mut x = 1i64;
    let a = [&mut x; 2];
    a.len()
}

fn aliased(gpa: Gpa) -> usize {
    let v: V = Vec::new_in(gpa);
    let a = [v; 4];
    a.len()
}

fn nested() -> usize {
    let a = [[D { k: 1 }; 1]; 2];
    a.len()
}

fn variants() -> usize {
    let a: [Option<D>; 2] = [None; 2];
    a.len()
}

fn opaque() -> usize {
    let a = [evens(); 2];
    a.len()
}

fn cloned<T: Clone>(t: T) -> usize {
    let a = [t; 2];
    a.len()
}

fn held<T>(t: T) -> usize {
    let h = Holder { t: t };
    let a = [h; 3];
    a.len()
}

fn statics() -> usize {
    let a = [S; 2];
    a.len()
}

fn main(gpa: Gpa) {
    println("{}", strings(gpa) + boxes(gpa) + tuples(gpa) + closures(gpa) + muts());
    println("{}", aliased(gpa) + nested() + variants() + opaque());
    println("{} {} {}", cloned(1i64), held(D { k: 2 }), statics());
}
