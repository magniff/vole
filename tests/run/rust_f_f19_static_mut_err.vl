// EDITION: rust
// RULE: F19.6
// (0.27.3) A `static mut` read or written outside unsafe code is an error,
// as rustc's E0133; inside `unsafe { }` it is accepted
// (rust_b_ok_static_mut_direct).
// ERROR: error[unsafe]: use of a mutable static is unsafe
// ERROR: line 13, column 5
// ERROR-COUNT: 2

static mut M: i64 = 1;

fn bump() {
    M += 1;
}

fn main() {
    bump();
    let t = M;
    println("{}", t);
}
