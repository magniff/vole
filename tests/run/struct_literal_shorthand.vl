// EDITION: rust
// A struct literal's field shorthand (0.15): `P { x, y }` is
// `P { x: x, y: y }`.
// EXPECT: 3 4 5

#[derive(Clone, Copy)] struct P { x: i64, y: i64, z: i64 }

fn main() {
    let x: i64 = 3;
    let y: i64 = 4;
    let p = P { x, y, z: x + 2 };
    print("{}", p.x);
    print(" ");
    print("{}", p.y);
    print(" ");
    print("{}", p.z);
    println("");
}
