// RT-270, fixed in 0.30.2 (obligations M2).
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// `Z: Tr` is `Z: Tr<i32>` (the default). W has only `Tr<i64>`. rustc
// refuses the call (E0277: the trait bound `W: Tr` is not satisfied);
// vole builds it: the front's check of a bound written without arguments
// (check_bounds, pred_holds: `implements`, select with no arguments)
// takes any impl of the trait. The places read the default (no unsound
// use found: a call that needs Tr<i32>'s impl is refused).
// ERROR: is not implemented
// ERROR: line 31, column 19
// ERROR-COUNT: 1
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

fn call2<Z: Tr>(z: &Z) -> i64 {
    1
}

fn main() {
    println("{}", call2(&W { r: 0 }));
}
