// FLAGS: -O2
// EXPECT: 2050
// EXPECT: 7 9
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn reread<T: Copy>(p: *const [T], q: *mut T, v: T) -> (T, T) {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array
    unsafe {
        let a = (*p)[1];
        *q = v;
        let a2 = a;
        pokeg(q, v);
        let b = (*p)[1];
        (a2, b)
    }
}

#[inline(never)]
fn pokeg<T: Copy>(q: *mut T, v: T) {
    // UNSAFE: given by the caller
    // SAFETY: points into main's array
    unsafe {
        *q = v;
    }
}

#[inline(never)]
fn reread2<T: Copy>(p: *const [T], q: *mut T, v: T) -> (T, T) {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array
    unsafe {
        let a = (*p)[1];
        pokeg(q, v);
        let b = (*p)[1];
        (a, b)
    }
}

fn main() -> i32 {
    let mut a = [1i64, 2, 3, 4];
    let base = a.as_mut_ptr();
    // UNSAFE: both from base
    // SAFETY: a outlives them
    let (p, q) = unsafe {
        (std::slice::from_raw_parts_mut(base, 4) as *mut [i64] as *const [i64], base.add(1))
    };
    let (x, y) = reread2(p, q, 50i64);
    println("{}", x * 1000 + y);
    let mut c = [5u8, 7, 8];
    let cb = c.as_mut_ptr();
    // UNSAFE: both from cb
    // SAFETY: c outlives them
    let (cp, cq) = unsafe {
        (std::slice::from_raw_parts_mut(cb, 3) as *mut [u8] as *const [u8], cb.add(1))
    };
    let (u, w) = reread2(cp, cq, 9u8);
    println("{} {}", u, w);
    0
}
