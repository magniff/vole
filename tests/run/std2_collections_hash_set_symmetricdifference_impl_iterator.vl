// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set SymmetricDifference::impl Iterator.
// EXPECT: Some(1) None
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    let mut d = a.symmetric_difference(&b);
    let x = d.next();
    println("{:?} {:?}", x, d.next());
}
