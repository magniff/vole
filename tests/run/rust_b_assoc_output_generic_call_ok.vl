// RULE: D22.2, D2.7
// (0.30.1, RT-33 round 3, F1) A value of an associated type passed on to
// a generic or formatting call under `where T::Output: Display`:
// `println("{m}")`, `p(x.measure())`, `println("{r}")` of `&m`. The
// opaque instance of `show` meets a gap of its model there (its errors
// are forgotten): it is not borrow-checked, its concrete instance is.
// Before round 3 it was built, and `places.not_built` refused the program
// (examples/traits-generics); before round 2 its fallback was silent.
// EXPECT: a 3 3 3
use std::fmt::Display;

trait M {
    type Output;
    fn measure(&self) -> Self::Output;
}

struct A {
    x: i64,
}

impl M for A {
    type Output = i64;

    fn measure(&self) -> i64 {
        self.x
    }
}

fn p<D: Display>(d: D) -> D {
    d
}

fn show<T: M>(label: &str, x: &T) where T::Output: Display {
    let m: T::Output = x.measure();
    let r = &m;
    let q = p(x.measure());
    println("{label} {m} {r} {q}");
}

fn main() {
    show("a", &A { x: 3 });
}
