// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice Chunks::impl DoubleEndedIterator.
// EXPECT: [5] [3, 4] [1, 2] None

fn main() {
    let s: &[i64] = &[1, 2, 3, 4, 5];
    let mut c = s.chunks(2);
    println("{:?} {:?} {:?} {:?}", c.next_back().unwrap(), c.next_back().unwrap(),
        c.next_back().unwrap(), c.next_back());
}
