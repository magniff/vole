// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet::is_empty.
// EXPECT: true false
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    let a = s.is_empty();
    s.insert(1);
    println("{} {}", a, s.is_empty());
}
