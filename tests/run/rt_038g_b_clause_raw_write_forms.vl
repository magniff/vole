// RULE: C3.4
// (0.30.2, RT-38g) A clause writes through no raw pointer: directly
// (`*p = 9`, `p.f = 9` through `*mut S`, `p[0] = 9`, a raw slice's
// element), through a `&mut` made of one (`&mut *q` of a `*mut [T]`
// too), `p.write(9)`, or a safe function that does it (`poke`).
// contract.effect, as for a cell's `set`: the effects cannot tell what a
// raw pointer points to.
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'direct' writes through a raw pointer
// ERROR: the 'requires' of 'field'
// ERROR: the 'requires' of 'index'
// ERROR: the 'requires' of 'slice'
// ERROR: the 'requires' of 'slice_ref'
// ERROR: the 'requires' of 'via_ref'
// ERROR: the 'requires' of 'via_write'
// ERROR: the 'ensures' of 'via_fn' calls 'poke', which writes through a raw pointer
// ERROR-COUNT: 8
struct S {
    f: i64,
}

fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        *p = 9;
    }
    true
}

fn direct(p: *mut i64) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        *p = 9;
    }
    true
}

{
    1
}

fn field(p: *mut S) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        (*p).f = 9;
    }
    true
}

{
    1
}

fn index(p: *mut i64) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        *p.add(0) += 9;
    }
    true
}

{
    1
}

fn slice(q: *mut [i64]) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        (*q)[0] = 9;
    }
    true
}

{
    1
}

fn slice_ref(q: *mut [i64]) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    let s = unsafe { &mut *q };
    s[0] = 9;
    true
}

{
    1
}

fn via_ref(p: *mut i64) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    let r = unsafe { &mut *p };
    *r = 9;
    true
}

{
    1
}

fn via_write(p: *mut i64) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe {
        p.write(9);
    }
    true
}

{
    1
}

fn via_fn(p: *mut i64) -> i64
    ensures poke(p)
{
    1
}

fn main() {
    let mut x = 1i64;
    let mut s = S { f: 1 };
    let mut a = [1i64, 2];
    println("{}", direct(&raw mut x));
    println("{}", field(&raw mut s));
    println("{}", index(&raw mut x));
    let q = &mut a[..] as *mut [i64];
    println("{}", slice(q));
    println("{}", slice_ref(q));
    println("{}", via_ref(&raw mut x));
    println("{}", via_write(&raw mut x));
    println("{}", via_fn(&raw mut x));
}
