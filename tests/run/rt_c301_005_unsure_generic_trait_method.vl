// XFAIL: RT-C301-5: a generic method of a generic trait called through a bound leaves the generic check unsure, its errors dropped (0.30.2)
// `x.f(1i64, 0i64)` of `trait Tr<A> { fn f<B>(&self, a: A, b: B); }` in
// `go<X: Tr<i64>, U>`, then `need(u)` with `need<T: 'static>`: rustc
// refuses (E0310). vole's opaque model instantiates such a method without
// the trait's arguments (FL11), marks the instance unsure and forgets
// its errors.
// ERROR: error[borrowck.param_outlives]: the parameter type 'U' may not live long enough
// ERROR-COUNT: 1
fn need<T: 'static>(t: T) {}

trait Tr<A> {
    fn f<B>(&self, a: A, b: B);
}

struct S;

impl Tr<i64> for S {
    fn f<B>(&self, a: i64, b: B) {}
}

fn go<X: Tr<i64>, U>(x: &X, u: U) {
    x.f(1i64, 0i64);
    need(u)
}

fn main() {
    go(&S, 2i64);
}
