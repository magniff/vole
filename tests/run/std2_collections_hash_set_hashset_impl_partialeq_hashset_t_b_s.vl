// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_set HashSet::impl PartialEq<HashSet<T, B, S>>.
// EXPECT: true false
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa, FixedState> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa, FixedState> = [2i64, 1].into_iter().collect_in(gpa);
    let c: HashSet<i64, Gpa, FixedState> = [1i64].into_iter().collect_in(gpa);
    println("{} {}", a == b, a == c);
}
