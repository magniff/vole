// EDITION: rust
// read_line (0.15) returns Result<bool, IoError>: Ok(true) for a line
// (an empty one too), Ok(false) at the end of input, which leaves `line`
// empty; the last line needs no '\n'.
// STDIN: first
// STDIN:
// STDIN: third, last
// EXPECT: [first] [] [third, last] end []
// EXPECT: still end
use std::io; 

fn main(gpa: Gpa) {
    let mut line = String::new_in(gpa);
    loop {
        match { line.clear(); io::stdin().read_line(&mut line).map(|n| n > 0) } {
            Ok(true) => {
                print("[");
                print("{}", line.trim_end());
                print("] ");
            }
            Ok(false) => break,
            Err(_) => {
                println("read error");
                return;
            }
        }
    }
    print("end [");
    print("{}", line.trim_end());
    println("]");
    println("{}", if { line.clear(); io::stdin().read_line(&mut line) }.map(|n| n > 0).unwrap_or(true) { "more" } else { "still end" });
}
