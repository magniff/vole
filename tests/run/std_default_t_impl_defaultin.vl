// Runs on std since 0.27.2's switch.
// The std item(s): std::default T::impl DefaultIn.
// EXPECT: 0 false
// RUSTC: none (std's DefaultIn takes an allocator: Rust has only Default)
use std::default::DefaultIn;

fn make<T: DefaultIn<Gpa>>(gpa: Gpa) -> T {
    T::default_in(gpa)
}

fn main(gpa: Gpa) {
    let n: i64 = make(gpa);
    let b: bool = make(gpa);
    println("{} {}", n, b);
}
