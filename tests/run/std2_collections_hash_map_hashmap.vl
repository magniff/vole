use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    println("{} {:?} {:?}", m.len(), m.get(&1), m.get(&3));
}
