// RT-211 review 3: a closure `|x: &String| x`, its parameter's region its
// own (a bound region), its result that one (E2): Map's B is then the
// bound's input there, I::Item's region, v's (fn_output_slot,
// bound_input_slot); `drop(v)` while the result lives is refused (rustc
// E0505). v0.30.1 built it: a use after free.
// ERROR: line 18
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello heap string long", gpa));
    let r = first(v.iter().map(|x: &String<Gpa>| x), &k);
    drop(v);
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{:?} {}", r, other.len());
}
