// (0.29.0) A function type's parameter is the type written. Until 0.29 a
// parameter that holds an array, in a function type or an Fn bound whose
// result could hold a view, was read as a reference to it (a rule of the
// parameter conventions the old edition had, left behind for these two
// places alone): `fn([u8; 4], &[u8]) -> &[u8]` was `fn(&[u8; 4], ..)`, and
// no function had that type.

fn pick<'a>(a: [u8; 4], y: &'a [u8]) -> &'a [u8] {
    if a[0] > 1 { y } else { &y[1..] }
}

fn call<'a>(f: fn([u8; 4], &'a [u8]) -> &'a [u8], y: &'a [u8]) -> usize {
    f([1, 2, 3, 4], y).len()
}

fn each<'a, F: Fn([u8; 4], &'a [u8]) -> &'a [u8]>(f: F, y: &'a [u8]) -> usize {
    f([2, 2, 3, 4], y).len()
}

fn main() -> i32 {
    let v = [1u8, 2, 3];
    println("{} {}", call(pick, &v), each(pick, &v));
    println("{}", each(|a: [u8; 4], y: &[u8]| &y[a[1] as usize..], &v));
    0
}
// EXPECT: 2 3
// EXPECT: 1
