// RULE: C3.4
// (0.30.2, the re-review of g302holes: ov/v29_flatten_local)
// RUSTC: none contract clauses are not Rust
// EXPECT: 1
// A slice param; the clause flattens Options of its own.
fn f(s: &[i64]) -> i64
    requires s.iter().flat_map(|x| Some(*x)).count() == 2
{
    s[0]
}

fn main() {
    let a = [1i64, 2];
    println("{}", f(&a));
}
