// RUSTC-EDITION: 2024
// RULE: D21.1, D21.3
// (0.27.2.1) `-> impl Iterator<Item = i32>`: the caller calls the bound's
// method, `next`, which is the hidden type's.
// EXPECT: 123
struct Counter {
    n: i32,
}

impl Iterator for Counter {
    type Item = i32;

    fn next(&mut self) -> Option<i32> {
        if self.n < 3 {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn count() -> impl Iterator<Item = i32> {
    Counter { n: 0 }
}

fn main() {
    let mut it = count();
    let mut n: i32 = 0;
    while let Some(x) = it.next() {
        n = n * 10 + x;
    }
    println("{}", n);
}
