// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops BitAnd::Output.
// EXPECT: V { x: 4 }
use std::ops::BitAnd;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitAnd for V {
    type Output = V;

    fn bitand(self, rhs: V) -> V {
        V { x: self.x & rhs.x }
    }
}

fn apply<T: BitAnd<Output = T>>(a: T, b: T) -> T {
    a & b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    let c: <V as BitAnd>::Output = apply(a, b);
    println("{:?}", c);
}
