// From the review: generic trait with two impls on the same type: <S as Conv<X>>::c
// rustc accepts and prints 64 8 64 8.
// EXPECT: 64 8 64 8
trait Conv<X> { fn c(&self) -> i64; fn mk() -> i64; }
struct S;
impl Conv<i64> for S { fn c(&self) -> i64 { 64 } fn mk() -> i64 { 64 } }
impl Conv<u8> for S { fn c(&self) -> i64 { 8 } fn mk() -> i64 { 8 } }

fn main() {
    let s = S;
    println("{} {} {} {}", <S as Conv<i64>>::c(&s), <S as Conv<u8>>::c(&s), <S as Conv<i64>>::mk(),
        <S as Conv<u8>>::mk());
}
