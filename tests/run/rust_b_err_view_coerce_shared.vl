// RULE: D3.6
// FLAGS: --check-alloc
// (0.30.1) An exclusive reference coerced to a shared one where no call
// takes it is reborrowed shared, as at a call: a `let` with a type, an
// assignment, a struct's field, an array element; a `&mut [T]`, a `&mut
// str` and a `&mut T`. A write through the exclusive one while the
// shared one lives is rustc's E0506/E0502. Before, the place was copied
// with no loan: `s[0] = Vec::new_in(gpa)` freed what `b` still read
// (--check-alloc: a use after free), and `t.make_ascii_uppercase()`
// changed a live `&str`.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 36, column 5
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 39, column 5
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 45, column 31
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 47, column 5
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 50, column 9
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 52, column 5
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 57, column 5
// ERROR: error[borrowck.conflict]
// ERROR: line 62, column 5
// ERROR-COUNT: 8
struct H<'a> {
    b: &'a [i64],
}

fn main(gpa: Gpa) {
    let mut k = 1i64;
    let rk: &mut i64 = &mut k;
    let sk: &i64 = rk;
    *rk = 2;
    println("{}", *sk);
    let a: [&i64; 1] = [rk];
    *rk = 3;
    println("{}", *a[0]);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let mut arr = [v];
    let s: &mut [Vec<i64, Gpa>] = &mut arr;
    let b: &[Vec<i64, Gpa>] = s;
    let r: &i64 = &b[0][0];
    s[0] = Vec::new_in(gpa);
    println("{}", *r);
    let mut c: &[Vec<i64, Gpa>] = &[];
    c = s;
    let q: &i64 = &c[0][0];
    s[0] = Vec::new_in(gpa);
    println("{}", *q);
    let mut x = [1i64, 2];
    let m: &mut [i64] = &mut x;
    let h = H { b: m };
    m[0] = 5;
    println("{}", h.b[0]);
    let mut st = String::from_in("hello", gpa);
    let t: &mut str = st.as_mut_str();
    let u: &str = t;
    t.make_ascii_uppercase();
    println("{}", u);
}
