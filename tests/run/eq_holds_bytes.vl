// EDITION: rust
// EXPECT: struct true false true
// EXPECT: enum true false false true
// EXPECT: option true false true
// EXPECT: tuple true false
// EXPECT: array true false
// EXPECT: user true false
// 0.14: structural == compares a part of type `[u8]` as `==` on it does,
// by bytes (std's `impl Eq for [u8]`); before, a struct or enum holding
// one was rejected ("it holds a '[u8]', which has no ==").
#[derive(Clone, Copy)] struct Person<'a> { name: &'a str, age: i64 }

#[derive(Copy)] enum Token<'a> { Num(i64), Word(&'a str), Pair(&'a str, &'a str), End } impl Clone for Token<'_> { fn clone(&self) -> Self { *self } }

// a part with its own impl Eq is compared by it
#[derive(Clone, Copy)] struct Loose<'a> { tag: &'a str }

impl PartialEq for Loose<'_> {
    fn eq(&self, other: &Loose<'_>) -> bool { self.tag.len() == other.tag.len() }
} impl Eq for Loose {}

#[derive(Clone, Copy)] struct Holder<'a> { l: Loose<'a>, n: i64 }

fn yes(b: bool) -> &'static str {
    if b { " true" } else { " false" }
}

fn word(s: &str) -> Token<'_> {
    Token::Word(s)
}

fn main() -> i32 {
    let text = "ann bob";
    let a = Person { name: &text[0..3], age: 3 };
    let b = Person { name: "ann", age: 3 };
    let c = Person { name: "bob", age: 3 };
    print("struct");
    print("{}", yes(a == b));
    print("{}", yes(a == c));
    print("{}", yes(a != c));
    println("");
    print("enum");
    print("{}", yes(word(&text[4..7]) == word("bob")));
    print("{}", yes(word("bob") == word("bo")));
    print("{}", yes(Token::Pair("a", "b") == Token::Pair("a", "c")));
    print("{}", yes(Token::End == Token::End && Token::Num(1i64) != Token::Word("1")));
    println("");
    let s1: Option<&str> = Some(&text[0..3]);
    let s2: Option<&str> = Some("ann");
    print("option");
    print("{}", yes(s1 == s2));
    let none: Option<&str> = None;
    print("{}", yes(s1 == none));
    print("{}", yes(none == none));
    println("");
    print("tuple");
    print("{}", yes((1, "x") == (1, "x")));
    print("{}", yes(("ab", 2) == ("ab", 3)));
    println("");
    let arr1 = ["a", "b"];
    let arr2 = [&text[0..1], "b"];
    let arr3 = ["a", "c"];
    print("array");
    print("{}", yes(arr1 == arr2));
    print("{}", yes(arr1 == arr3));
    println("");
    print("user");
    print("{}", yes(Holder { l: Loose { tag: "ab" }, n: 1 } == Holder { l: Loose { tag: "cd" }, n: 1 }));
    print("{}", yes(Holder { l: Loose { tag: "ab" }, n: 1 } == Holder { l: Loose { tag: "c" }, n: 1 }));
    println("");
    0
}
