// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Peekable::next_if_eq.
// EXPECT: Some(0) None Some(1)

fn main(gpa: Gpa) {
    let s = Vec::from_in([0i64, 1], gpa);
    let mut it = s.iter().copied().peekable();
    let a = it.next_if_eq(&0i64);
    let b = it.next_if_eq(&0i64);
    println("{:?} {:?} {:?}", a, b, it.next());
}
