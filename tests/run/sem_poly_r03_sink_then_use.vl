struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
trait E { fn eat(self) -> i64; }
impl E for R { fn eat(self) -> i64 { self.id } }

fn main() {
    let r = R { id: 1 };
    let a = r.eat();
    println("{a} {}", r.id);
}
