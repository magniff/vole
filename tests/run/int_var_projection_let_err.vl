// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). A use gave d
// i32 first; the impl chosen, i32's, has Out = i64: rustc E0271 at the
// call. v0.30.1 refused it; 0.30.2's build printed 1705032704 (an i64 read
// as an i32).
// ERROR: (rustc E0271)
// ERROR: line 37, column 13
// ERROR-COUNT: 1
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = u16;

    fn o(self) -> u16 {
        self as u16 * 300
    }
}

impl Tr for i32 {
    type Out = i64;

    fn o(self) -> i64 {
        self as i64 * 3000000000
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let r = f(2);
    let s: i32 = r;
    println("{}", s);
}
