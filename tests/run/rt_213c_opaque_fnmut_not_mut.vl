// From g302copy's report (pre-existing, 0.30.1 too): the `impl FnMut` half
// of rt_213b. A call of an `impl FnMut` value through a binding that is
// not `mut` is refused (rustc E0596), and the same value bound `mut` calls.
// ERROR: line 16
// ERROR-COUNT: 1
fn counter() -> impl FnMut() -> i64 {
    let mut n = 0;
    move || {
        n += 1;
        n
    }
}

fn main() {
    let h = counter();
    println("{}", h());
    let mut k = counter();
    println("{}", k() + k());
}
