// RULE: F18.5
// (0.30.2) A trait's method called on an integer variable's value whose
// impls' signatures differ beyond Self (a generic method with another
// parameter of type Self, `&Self`, a `&mut self` on a field, a tuple's or
// an array's element, a capture): rustc's probe takes the trait's
// declaration with Self the variable, the impl the one of the type a later
// use gives it (i64 here). 0.30.1 called i32's and computed in i32.
// EXPECT: 4000000000
// EXPECT: 4000000000
// EXPECT: 64 5
// EXPECT: 10000000000
// EXPECT: 3000000000 3000000000 3000000000
// EXPECT: 4000000002
trait Ad {
    fn ad<T>(self, o: Self, t: T) -> Self;
}

impl Ad for i32 {
    fn ad<T>(self, o: i32, t: T) -> i32 {
        self.wrapping_add(o)
    }
}

impl Ad for i64 {
    fn ad<T>(self, o: i64, t: T) -> i64 {
        self + o
    }
}

trait Kind {
    fn kind<T>(&self, o: Self, t: T) -> i64;
}

impl Kind for i32 {
    fn kind<T>(&self, o: i32, t: T) -> i64 {
        32
    }
}

impl Kind for i64 {
    fn kind<T>(&self, o: i64, t: T) -> i64 {
        64
    }
}

trait Mx {
    fn mx<T>(&self, o: &Self, t: T) -> Self;
}

impl Mx for i32 {
    fn mx<T>(&self, o: &i32, t: T) -> i32 {
        self.wrapping_mul(*o)
    }
}

impl Mx for i64 {
    fn mx<T>(&self, o: &i64, t: T) -> i64 {
        *self * *o
    }
}

trait Twice {
    fn twice(&mut self);
}

impl Twice for i32 {
    fn twice(&mut self) {
        *self = *self * 2;
    }
}

impl Twice for i64 {
    fn twice(&mut self) {
        *self = *self * 2;
    }
}

trait Inc {
    fn inc(&mut self);
}

impl Inc for i32 {
    fn inc(&mut self) {
        *self += 1;
    }
}

impl Inc for i64 {
    fn inc(&mut self) {
        *self += 1;
    }
}

struct W<T> {
    x: T,
}

fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let c = a.ad(a, 1u8);
    let d: i64 = c;
    println("{}", d);
    let a2 = 2000000000;
    println("{}", take(a2.ad(a2, 1u8)));

    let k = 5;
    let r = k.kind(1, 0u8);
    println("{} {}", r, take(k));

    let m = 100000;
    let n = m.mx(&m, 0u8);
    let o: i64 = n;
    println("{}", o);

    let mut w = W { x: 1500000000 };
    w.x.twice();
    let mut p = (1500000000, 0);
    p.0.twice();
    let mut arr = [1500000000, 1];
    arr[0].twice();
    let b1: i64 = w.x;
    let b2: i64 = p.0;
    let b3: i64 = arr[0];
    println("{} {} {}", b1, b2, b3);

    let mut e = 2000000000;
    e.inc();
    let f = || e + e;
    let g: i64 = f();
    println("{}", g);
}
