// RULE: D2.6
// (0.27.1) Moving the scrutinee in a guard while the guard's `ref` binding
// is used after the move.
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 17, column 18
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct N {
    v: i64,
}

fn main() {
    let o: Option<N> = Some(N { v: 1 });
    match o {
        Some(ref y) if {
            drop(o);
            y.v > 0
        } => println("a"),
        _ => println("b"),
    }
}
