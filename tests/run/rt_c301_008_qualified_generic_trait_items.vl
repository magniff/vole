// RULE: F8.4
// RT-C301-8/9: one generic trait with two impls for S, Conv<i32> and
// Conv<i64>: the written arguments choose the impl, for a value, a
// constant and a call alike. 0.30.1 refused the values and called the
// constants ambiguous. rustc prints these lines.
// EXPECT: 32 64 32 64
// EXPECT: 32 64
// EXPECT: 32 64 32 64
// one generic trait, two impls for one type: the trait's arguments choose
trait Conv<X> { const K: i64; fn c(&self) -> i64; fn mk() -> i64; }
struct S;
impl Conv<i32> for S { const K: i64 = 32; fn c(&self) -> i64 { 32 } fn mk() -> i64 { 32 } }
impl Conv<i64> for S { const K: i64 = 64; fn c(&self) -> i64 { 64 } fn mk() -> i64 { 64 } }

fn main() {
    let s = S;
    let f = <S as Conv<i32>>::c; let g = <S as Conv<i64>>::c;
    let h = <S as Conv<i32>>::mk; let k = <S as Conv<i64>>::mk;
    println("{} {} {} {}", f(&s), g(&s), h(), k());
    println("{} {}", <S as Conv<i32>>::K, <S as Conv<i64>>::K);
    println("{} {} {} {}", <S as Conv<i32>>::c(&s), <S as Conv<i64>>::c(&s), <S as Conv<i32>>::mk(),
        <S as Conv<i64>>::mk());
}
