// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops impl DivAssign for primitives.
// EXPECT: 2 2
use std::ops::DivAssign;

fn update<T: DivAssign>(a: &mut T, b: T) {
    a.div_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
