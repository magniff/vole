// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a53_tls_ptr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which touches a thread-local static
// A callee writes through a raw pointer kept in a thread-local static.
#[thread_local]
static mut P: *mut i64 = 0 as *mut i64;

fn poke() -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *P = 9; }
    true
}

fn f(n: i64) -> i64
    requires poke()
{
    n
}

fn main() {
    let mut x = 1i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { P = &raw mut x; }
    println("{}", f(1));
    println("{}", x);
}
