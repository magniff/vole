// XFAIL: RT-124: an associated constant in a const or static item next to a fn pointer is not a compile-time constant (RT-124's form) (0.30.2)
// From the g302qual review (form f30_const_fnptr).
// EXPECT: 20 161 82
trait A { const K: i64; fn m(&self) -> i64; }
trait B { const K: i64; fn m(&self) -> i64; }
trait Conv<X> { const K: i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 10 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 20 } }
impl Conv<u8> for S { const K: i64 = 8; }
impl Conv<u16> for S { const K: i64 = 16; }
const F: fn(&S) -> i64 = <S as B>::m;
const C: i64 = <S as A>::K + <S as Conv<u16>>::K * 10;
static G: i64 = <S as B>::K + <S as Conv<u8>>::K * 10;
fn main() { println("{} {} {}", F(&S), C, G); }
