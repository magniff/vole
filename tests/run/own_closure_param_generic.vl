// (0.25.3) Generic closures: a closure in a generic fn over owned and
// copyable items, an FnMut(sink T) bound, a closure's sink T parameter;
// fn(T) is fn(let T): a closure given where FnMut(T) is wanted borrows
// (the caller drops), as sort_by, retain, any and position's.
// FLAGS: --check-alloc
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: count 2
// EXPECT: count-int 3
// EXPECT: kept 2
// EXPECT: drop 4
// EXPECT: sink 4
// EXPECT: let 5 5
// EXPECT: drop 6
// EXPECT: gen 5 5
// EXPECT: drop 8
// EXPECT: vec 1 true 0
// EXPECT: end
// EXPECT: drop 9
// EXPECT: drop 5
// EXPECT: drop 2
// EXPECT: drop 3
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn count_all<T, I: Iterator<Item = T>>(it: sink I) -> i64 { it.map(|_x| 1).sum() }

fn keep_all<T, I: Iterator<Item = T>>(it: sink I, gpa: Gpa) -> Vec<T> {
    it.fold(Vec::<T>::new_in(gpa), |a, x| { var b = a; b.push(x); b })
}

fn call_sink<T, F: FnMut(sink T) -> i64>(f: sink F, x: sink T) -> i64 { f(x) }
fn call_let<T, F: FnMut(T) -> i64>(f: sink F, x: T) -> i64 { f(x) }

fn gen_closure<T>(x: sink T) -> i64 {
    let f = |y: sink T| 5;
    f(x)
}

fn main(gpa: Gpa) {
    println(f"count {count_all((0..2).map(|i| mk(i, gpa)))}");
    println(f"count-int {count_all(0..3)}");
    let k = keep_all((2..4).map(|i| mk(i, gpa)), gpa);
    println(f"kept {k.len()}");
    println(f"sink {call_sink(|d: sink D| d.id, mk(4, gpa))}");
    let x = mk(5, gpa);
    println(f"let {call_let(|d| d.id, x)} {x.id}");
    println(f"gen {gen_closure(mk(6, gpa))} {gen_closure(7)}");
    var v: Vec<D> = Vec::new_in(gpa);
    v.push(mk(9, gpa));
    v.push(mk(8, gpa));
    v.sort_by(|a, b| a.id - b.id);
    v.retain(|d| d.id > 8);
    let any = v.iter_ref().any(|d| d.id == 9);
    let pos = v.iter_ref().position(|d| d.id == 9);
    println(f"vec {v.len()} {any} {pos.unwrap_or(-1)}");
    println("end");
}
