// XFAIL: RT-117e: (RT-117's family, no promotion) `const C: Vs = Vs { n: &[4, 11] };` with `n: &'static [u64]`, used as `C.n[1]`, is refused at the const's definition: borrowck.dropped_borrowed "'[4, 11]' does not live long enough"; rustc promotes the array and prints 11 (0.30.2)
// From the review of g302static (its form p12_const_field_local_use).
// Since g302static's merge (0.30.2): v0.30.1 accepted it and printed 11,
// with the slice pointing into the stack (rt_117d). It passes once a
// borrowed literal is promoted.
// EXPECT: 11
struct Vs {
    n: &'static [u64],
}

const C: Vs = Vs { n: &[4, 11] };

fn main() {
    println("{}", C.n[1]);
}
