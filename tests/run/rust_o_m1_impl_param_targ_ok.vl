// (0.30.2, obligations M1) A method's bound naming its impl's parameter,
// `impl<U> Holder<U> { fn go<T: Tr<U>> }` on a Holder<i64>: Tr<i64>'s impl.
// rustc accepts it.
// EXPECT: 64
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
struct Holder<U> { u: U }
impl<U> Holder<U> { fn go<T: Tr<U>>(&self, t: &T) -> &'static str { t.f() } }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() };
    let h = Holder { u: 1i64 }; println("{}", h.go(&x));
}
