// EDITION: rust
// RULE: D22.1a
// (0.27.2.1) A bound's method on Ω is its virtual function: the unused
// template checks, and the used one runs.
// EXPECT: 8
trait Show {
    fn show(&self) -> i32;
}

impl Show for i32 {
    fn show(&self) -> i32 { *self }
}

fn twice<T: Show>(t: &T) -> i32 {
    t.show() + t.show()
}

fn unused<T: Show>(t: T) -> i32 {
    t.show()
}

fn main() {
    let v: i32 = 4;
    println("{}", twice(&v));
}
