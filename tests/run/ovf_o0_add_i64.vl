// (0.26.3, decision 6) `a + b` of i64s panics at -O0, where the overflow
// checks are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_add_i64.vl:17:13: attempt to add with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i64 = id(9223372036854775807) as i64;
    let b: i64 = id(1) as i64;
    println("before");
    let r = a + b;
    println("after {}", r);
}
