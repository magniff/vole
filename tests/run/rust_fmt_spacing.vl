// EDITION: rust
// (0.27.0) Rust's spellings that `volec fmt` keeps as written, and that
// the edition reads: `?Sized` in a bound and a `where`, `union` as a
// method's name (`fn union<'b>`, `a.union(b)`), an impl on a slice
// (`impl<T> Sum for [T]`). The edition.later ones (`<<T as Tr>::X>`,
// `#[builtin_impls(..)]`, 0.27.2: rust_f_f15_builtin_ok) are in rust_err_later.
// EXPECT: 6 0 0 3
fn size<T: ?Sized>(x: &T) -> i64 {
    0
}

fn size2<T>(x: &T) -> i64 where T: Clone + ?Sized {
    0
}

struct Pair<'a> {
    a: &'a i64,
}

impl<'a> Pair<'a> {
    fn union<'b>(&self, o: &'b i64) -> i64 {
        *self.a + *o
    }
}

pub trait Sum {
    fn sum(&self) -> i64;
}

impl<T> Sum for [T] {
    fn sum(&self) -> i64 {
        self.len() as i64
    }
}

fn main() -> i32 {
    let n = 3;
    let p = Pair { a: &n };
    let v = [1, 2, 3];
    println("{} {} {} {}", p.union(&n), size(&n), size2(&n), v[..].sum());
    0
}
