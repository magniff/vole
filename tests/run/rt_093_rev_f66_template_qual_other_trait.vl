// RULE: F8.3, F8.4
// RT-93, from the g302qual review (form f66_template_qual_other_trait): `<W<i64> as Other>::mk(1u8)` beside `Conv<u8>`'s mk: the named trait's.
// rustc prints the EXPECT lines.
// EXPECT: 101 102 3
trait Conv<X> { fn mk(x: X) -> Self; }
trait Other { fn mk(x: u8) -> Self; }
struct W<T> { t: T }
impl Conv<u8> for W<i64> { fn mk(x: u8) -> W<i64> { W { t: x as i64 } } }
impl Other for W<i64> { fn mk(x: u8) -> W<i64> { W { t: 100 + x as i64 } } }

fn main() {
    let a: W<i64> = <W<i64> as Other>::mk(1u8); let b: W<i64> = Other::mk(2u8);
    let c: W<i64> = Conv::mk(3u8); println("{} {} {}", a.t, b.t, c.t);
}
