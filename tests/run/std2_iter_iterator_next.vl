// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::next.
// EXPECT: Some(1) Some(2) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let mut it = v.iter();
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.next());
}
