// RULE: C3.4
// (0.30.2, RT-38f) RT-38f's alias in a `debug ensures`: with
// --debug-contracts it was built and printed `2 9`, without it `2 2`. It
// is refused where it is built (a debug clause is checked only when on).
// RUSTC: none contract clauses are not Rust
// FLAGS: --debug-contracts
// ERROR: cannot assign to '*p'
// ERROR-COUNT: 1
type R<'a> = &'a mut i64;

fn f(p: R<'_>) -> i64
    debug ensures {
    *p = 9;
    true
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
