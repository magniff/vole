// RUSTC-EDITION: 2024
// RULE: D21.4
// (0.27.2.1) The hidden type holds the function's own result,
// `Option<impl Tr>` (rustc E0720).
// ERROR: error[opaque.cycle]
// ERROR: 
trait Tr {
    fn get(&self) -> i32;
}

impl Tr for i32 {
    fn get(&self) -> i32 { *self }
}

impl<T: Tr> Tr for Option<T> {
    fn get(&self) -> i32 { 0 }
}

fn f(n: i32) -> impl Tr {
    Some(f(n - 1))
}

fn main() {
    println("{}", f(3).get());
}
