// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc ArenaScope::alloc.
// EXPECT: 41
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let r = arena.scope(|sc| {
        let x = sc.alloc(40i64);
        *x += 1;
        *x
    });
    println("{}", r);
}
