// 0.14: loops with several exits at their top, each an induction variable
// against an invariant (exits.vl), made counted loops of the smallest
// trip count: down and up, `!=`, `<` and `>`, signed and unsigned, bounds
// that stop the loop before it starts, negative counts (a `!=` test that
// never comes true runs until the other one stops it). The results are
// the same at every level.
// EXPECT: 3996 3996 0 0 2
// EXPECT: 3996 0 0 28
// EXPECT: 1997 0 1997
// EXPECT: 499500 0 24
#[inline(never)]
fn take(s: &[i64], n: i64) -> i64 {
    let mut left = n;
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    loop {
        if left == 0 {
            break;
        }
        if i >= s.len() as i64 {
            break;
        }
        t += s[i as usize];
        i += 1;
        left -= 1;
    }
    t
}

// from `start`, while i < s.len and i != stop
#[inline(never)]
fn between(s: &[i64], start: i64, stop: i64) -> i64 {
    let mut i = start;
    let mut t: i64 = 0;
    loop {
        if i == stop {
            break;
        }
        if i >= s.len() as i64 {
            break;
        }
        t += s[i as usize];
        i += 1;
    }
    t
}

// counting down from `hi`, while i > lo (signed) and k < n (unsigned)
#[inline(never)]
fn down(s: &[i64], hi: i64, lo: i64, n: u64) -> i64 {
    let mut i = hi;
    let mut k = 0u64;
    let mut t: i64 = 0;
    loop {
        if i <= lo {
            break;
        }
        if k >= n {
            break;
        }
        t += s[i as usize];
        i -= 1;
        k += 1u64;
    }
    t
}

// three tests
#[inline(never)]
fn three(s: &[i64], a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    let mut j: i64 = 10;
    let mut t: i64 = 0;
    loop {
        if i >= a {
            break;
        }
        if j == b {
            break;
        }
        if i >= s.len() as i64 {
            break;
        }
        t += s[i as usize];
        i += 1;
        j += 1;
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..1000 {
        v.push(i % 7 + i % 3);
    }
    let s = v.as_slice();
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..1000 {
        w.push(i);
    }
    let u = w.as_slice();
    print("{}", (take(s, 1000) - take(s, 0) + take(s, -5) - take(s, 1000)));
    print(" ");
    print("{}", (take(s, 5000) - take(s, 0)));
    print(" ");
    print("{}", take(&s[0..0], 7));
    print(" ");
    print("{}", take(s, 0));
    print(" ");
    print("{}", take(s, 2));
    println("");
    print("{}", between(s, 0, -1));
    print(" ");
    print("{}", between(s, 5, 5));
    print(" ");
    print("{}", between(s, 2000, 3000));
    print(" ");
    print("{}", between(s, 10, 17));
    println("");
    print("{}", (down(u, 999, 997, 10u64) + down(u, 5, -100, 0u64)));
    print(" ");
    print("{}", down(u, 3, 3, 100u64));
    print(" ");
    print("{}", down(u, 999, 0, 2u64));
    println("");
    print("{}", three(u, 5000, -1));
    print(" ");
    print("{}", three(u, 5000, 10));
    print(" ");
    print("{}", (three(u, 100, 17) + three(u, 2, 1000) + three(u, 30, 1000) - 434 + three(u, -1,
        0) - 2 + three(u, 3, 13)));
    println("");
    0
}
