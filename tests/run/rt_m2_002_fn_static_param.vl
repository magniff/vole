// `bg` needs its reference to live forever (a thread reads it later).
// Coerced to the pointer type `fn(&i64, Gpa) -> ..` (any lifetime), or
// passed for a bound `F: Fn(&i64, Gpa) -> ..`, it is called with a
// reference to a Box that is then freed, and the thread reads freed
// memory (`--check-alloc`: "use after free"). Both must be refused, as
// rustc refuses them (E0308, a fn item `fn(&'static i64)` is not a
// `for<'a> fn(&'a i64)`).
// ERROR: line 34, column 56
// ERROR: line 40, column 18
// ERROR-COUNT: 2
use std::thread;
use std::sync::atomic::{AtomicBool, Ordering};
use std::thread::JoinHandle;

static FREED: AtomicBool = AtomicBool::new(false);

fn bg(x: &'static i64, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    thread::spawn_in(move || {
        while !FREED.load(Ordering::SeqCst) {
            thread::yield_now();
        }
        *x
    }, gpa)
}

fn run<F: Fn(&i64, Gpa) -> JoinHandle<i64, Gpa>>(f: F, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    let b = Box::new_in(1234i64, gpa);
    f(&*b, gpa)
}

fn main(gpa: Gpa) {
    let h = {
        let b = Box::new_in(1234i64, gpa);
        let f: fn(&i64, Gpa) -> JoinHandle<i64, Gpa> = bg;
        f(&*b, gpa)
    };
    let other = Box::new_in(-1i64, gpa);
    FREED.store(true, Ordering::SeqCst);
    println("{} {}", h.join().unwrap(), *other);
    let h2 = run(bg, gpa);
    println("{}", h2.join().unwrap());
}
