// XFAIL: RT-490: `G::Output` of a type parameter bounded by a closure trait, `let v: G::Output = g(4);` under `G: FnOnce(i64) -> i64`, is refused: "'G' has no associated type 'Output'"; rustc prints 10 (0.30.2)
// From the second re-review of the obligation work, M2 (g302oblig). Since v0.30.1 at least.
// From the review's form n08_fnonce_body_let. In a where clause and a
// signature: rt_490b.
// EXPECT: 10
fn once<G: FnOnce(i64) -> i64>(g: G) -> i64 {
    let v: G::Output = g(4);
    v * 2
}

fn main() {
    println("{}", once(|x| x + 1));
}
