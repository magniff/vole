// Shifts beside qualified paths stay shifts: `<S as A>::C << 2`, `a<<b`, `e <<= <S as A>::C`, `3 < <S as A>::C + 1` (rustc `8 12 12 true 8 32768`)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): a guard: the first round's build passes.
// EXPECT: 8 12 12 true 8 32768
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

fn main() {
    let a = 1i64 << 3;
    let b = <S as A>::C << 2;
    let c = (<S as A>::C) << <<S as A>::Out as B>::D;
    let d = 3 < <S as A>::C + 1;
    let mut e = 1i64;
    e <<= <S as A>::C;
    let f = a << b;
    println("{} {} {} {} {} {}", a, b, c, d, e, f);
}
