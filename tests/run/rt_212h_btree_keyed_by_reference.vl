// XFAIL: RT-212: (fuller form of R302D-34) a BTreeSet or BTreeMap keyed by a reference to a program type cannot insert or look up: `BTreeSet<&W, Gpa>::insert`, `BTreeMap<&W, i64, Gpa>::insert` fail inside std (0.30.2)
// rustc prints the EXPECT line (twin: r302d_034h_btree_reference_keys_fail_in_std.rs.txt).
// vole: `<std>:13728:22: error[type error] expected '&&W', got '&W' | .. | try:
// &<K as Borrow<Q>>::borrow(k) | note: in instantiation of 'BBorrowed<&W>::order'`:
// std's `self.key.cmp(<K as Borrow<Q>>::borrow(k))` (btree_map.vl:82) is a fully
// qualified call naming K, resolved per instance by its argument's type to W's
// Borrow (R302D-34e's qualified-path form). BTreeMap<&i64, &i64> works. Since
// v0.28.0.
// EXPECT: Some(W { k: 1 }) true Some(5)
use std::collections::{BTreeMap, BTreeSet};

#[derive(Debug, PartialEq, Eq, PartialOrd, Ord)]
struct W {
    k: i64,
}

fn main(gpa: Gpa) {
    let (a, b) = (W { k: 2 }, W { k: 1 });
    let x = 5i64;
    let mut s: BTreeSet<&W, Gpa> = BTreeSet::new_in(gpa);
    s.insert(&a);
    s.insert(&b);
    let mut m: BTreeMap<&W, i64, Gpa> = BTreeMap::new_in(gpa);
    m.insert(&a, x);
    println("{:?} {} {:?}", s.iter().next(), s.contains(&&b), m.get(&&a));
}
