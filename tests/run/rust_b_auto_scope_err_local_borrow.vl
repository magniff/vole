// EDITION: rust
// RULE: AT6
// (0.27.2) A thread borrows a local of the scope's closure: the loan must
// outlive 'scope, which the local does not (rustc E0373: move it in).
use std::thread;

fn main() {
    thread::scope(|s| {
        let x = 1;
        s.spawn(|| {
            println("{}", x);
        });
    });
}
