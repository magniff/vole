// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl BitXor for primitives.
// EXPECT: 9 9
use std::ops::BitXor;

fn apply<T: BitXor<Output = T>>(a: T, b: T) -> T {
    a.bitxor(b)
}

fn main() {
    println("{} {}", apply(12i64, 5), apply(12u8, 5));
}
