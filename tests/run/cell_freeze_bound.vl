// (0.26.1) std::Freeze, an auto trait: a type holding no UnsafeCell by
// value; through a pointer, a slice or a Vec it is not looked into.
// ERROR: the trait 'Freeze' is not implemented for 'Cell<i64>'
use std::Freeze;
use std::cell::Cell;

fn frozen<T: Freeze>(x: T) -> i64 { 1 }

struct Plain { a: i64, b: [i64; 2] }

fn main(gpa: Gpa) {
    let p = Plain { a: 1, b: [2, 3] };
    let v: Vec<Cell<i64>> = Vec::new_in(gpa);
    let n = frozen(p) + frozen(v) + frozen(5);
    let c = Cell::new(1);
    let m = frozen(c);
}
