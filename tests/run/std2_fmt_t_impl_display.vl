// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt &T::impl Display.
// EXPECT: (1, 2) (1, 2)
use std::fmt::{Debug, Display, Formatter};

struct Pt {
    x: i64,
    y: i64,
}

impl Display for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "({}, {})", self.x, self.y)
    }
}

impl Debug for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Pt").field("x", &self.x).field("y", &self.y).finish()
    }
}

fn show<T: Display>(x: T) {
    println("{}", x);
}

fn main() {
    let p = Pt { x: 1, y: 2 };
    let r: &Pt = &p;
    print("{} ", r);
    show(&p);
}
