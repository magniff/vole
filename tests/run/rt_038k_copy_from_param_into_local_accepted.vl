// RULE: C4
// RUSTC: none contract clauses are not Rust
// (0.30.2, the re-review 3 of g302holes) A clause that copies a
// parameter's pointee into its own local, with ptr::copy_nonoverlapping or
// ptr::copy, reads through the parameter and writes only its local: C's
// memcpy and memmove are given a `*const u8` source, which C does not
// write through (effects/provenance.vl raw_args_mask). Before, every
// argument of C was written, the source too, and the clause was refused.
// EXPECT: 1
// EXPECT: 7
fn go(p: *mut i64, q: *const i64) -> bool {
    let mut a = 0i64;
    let mut b = [0i64; 64];
    // UNSAFE: test
    // SAFETY: p and q point to live i64s, the arrays are 64 long; no overlap with a or b
    unsafe {
        std::ptr::copy_nonoverlapping(p as *const i64, &raw mut a, 1);
        std::ptr::copy(q, &raw mut a, 1);
        std::ptr::copy_nonoverlapping(q, b.as_mut_ptr(), 1);
    }
    a == 7 && b[0] == 7
}

fn f(p: *mut i64, q: *const i64) -> i64
    requires go(p, q)
{
    1
}

fn main() {
    let mut x = 7i64;
    let y = 7i64;
    println("{}", f(&raw mut x, &raw const y));
    println("{}", x);
}
