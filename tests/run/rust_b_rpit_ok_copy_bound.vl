// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.3
// (0.27.2.1) With `Copy` among the bounds, the opaque value is copied.
// EXPECT: 7 7
trait Show {
    fn show(&self) -> i32;
}

impl Show for i32 {
    fn show(&self) -> i32 { *self }
}

fn seven() -> impl Show + Copy {
    let n: i32 = 7;
    n
}

fn take<T: Show>(t: T) -> i32 {
    t.show()
}

fn main() {
    let a = seven();
    let b = take(a);
    let c = take(a);
    println("{} {}", b, c);
}
