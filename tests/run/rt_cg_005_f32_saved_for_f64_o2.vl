            s = s + g(t);
            v7 = (!v7) != (((c & 1) == 0) && v7);
            { let tmp_r = v3; v3 = v10; v10 = v11; v11 = tmp_r; }
            { let tmp_r = v6; v6 = v1; v1 = tmp_r; }
            { let tmp_r = v8; v8 = v7; v7 = tmp_r; }
            { let tmp_r = v4; v4 = v5; v5 = tmp_r; }
            { let tmp_r = v2; v2 = v5; v5 = v4; v4 = tmp_r; }
            { let tmp_r = v8; v8 = v7; v7 = tmp_r; }
        } else {
            { let tmp_r = v0; v0 = v1; v1 = v6; v6 = tmp_r; }
            v10 = P { a: (v10.a ^ c) & 65535, b: v10.b * 0.5 + v10.b * 0.25 };
            { let tmp_r = v11; v11 = v3; v3 = v10; v10 = tmp_r; }
            v13 = (((v13 ^ c) + (v12 & 65535))) & 4294967295;
            v2 = v2 * 0.5 + (c as f32) * 0.25 + v2 * 0.125;
        }
        s = s ^ (a0 + t);
        s = s ^ (a7 + t);
        s = s ^ (a8 + t);
        s = s ^ (a9 + t);
        s = s ^ (a15 + t);
        sf = sf * 0.5 + b1;
        sf = sf * 0.5 + b5;
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b7;
        sf = sf * 0.5 + b8;
        sf = sf * 0.5 + b9;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b15;
        sf = sf * 0.5 + b17;
        sf = sf * 0.5 + b18;
        let e = g(t + 1);
        { let tmp_r = v10; v10 = v3; v3 = v11; v11 = tmp_r; }
        v3 = P { a: (v3.a ^ c) & 65535, b: v3.b * 0.5 + v3.b * 0.25 };
        s = s + g(t);
        s = s + e;
        t += 1;
    }
    println("{} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {} {}", v0, v1, v2, v3.a, v3.b, v4,
        v5, v6, v7, v8, v9, v10.a, v10.b, v11.a, v11.b, v12, v13, s, sf);
}
