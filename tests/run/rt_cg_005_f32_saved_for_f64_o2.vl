// RT-CG-5 (fixed in 0.30.1): a cycle's slot saved as an f32 (the type of the move writing it) and stored back as an f64 (the type of the move reading it): x86-64 `movss 304(%rsp), %xmm15` then `movsd %xmm15, 320(%rsp)`, the f64's upper half lost
// FLAGS: -O2
// EXPECT: 12 1 2.1152344 7 1.54248046875 2.289795 3.7460938 6 false false 18 10 1.58203125 15 2.49169921875 17 91 104 59.25423826302518
// Run on x86-64 to see it (`tests/run.sh -t x86_64-macos -n
// rt_cg_005_f32_saved_for_f64_o2`): the release branch printed 0 for
// the thirteenth value there. The review's generator, seed 1099, whole:
// reduced, the program loses the f32 form. pm_plan saves a source by
// its own type, which the case pins. The EXPECT line is rustc's.
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[derive(Clone, Copy)]
struct P { a: i64, b: f64 }
#[inline(never)]
fn g(a: i64) -> i64 { K.fetch_add(1, Ordering::Relaxed); a ^ 5 }

fn main() {
    let lim = (g(7) & 15) + 3;
    let a0 = g(20);
    let a1 = g(21);
    let a2 = g(22);
    let a3 = g(23);
    let a4 = g(24);
    let a5 = g(25);
    let a6 = g(26);
    let a7 = g(27);
    let a8 = g(28);
    let a9 = g(29);
    let a10 = g(30);
    let a11 = g(31);
    let a12 = g(32);
    let a13 = g(33);
    let a14 = g(34);
