    let a16 = g(36);
    let b0 = (g(40) as f64) * 0.5;
    let b1 = (g(41) as f64) * 0.5;
    let b2 = (g(42) as f64) * 0.5;
    let b3 = (g(43) as f64) * 0.5;
    let b4 = (g(44) as f64) * 0.5;
    let b5 = (g(45) as f64) * 0.5;
    let b6 = (g(46) as f64) * 0.5;
    let b7 = (g(47) as f64) * 0.5;
    let b8 = (g(48) as f64) * 0.5;
    let b9 = (g(49) as f64) * 0.5;
    let b10 = (g(50) as f64) * 0.5;
    let b11 = (g(51) as f64) * 0.5;
    let b12 = (g(52) as f64) * 0.5;
    let b13 = (g(53) as f64) * 0.5;
    let b14 = (g(54) as f64) * 0.5;
    let b15 = (g(55) as f64) * 0.5;
    let b16 = (g(56) as f64) * 0.5;
    let b17 = (g(57) as f64) * 0.5;
    let b18 = (g(58) as f64) * 0.5;
    let mut v0: i32 = (g(3) as i32) & 1023;
    let mut v1: i32 = (g(4) as i32) & 1023;
    let mut v2: f32 = (g(3) as f32) * 0.625;
    let mut v3: P = P { a: g(3), b: (g(8) as f64) * 0.5 };
    let mut v4: f32 = (g(5) as f32) * 0.625;
    let mut v5: f32 = (g(6) as f32) * 0.625;
    let mut v6: i32 = (g(9) as i32) & 1023;
    let mut v7: bool = (g(7) & 1) == 0;
    let mut v8: bool = (g(8) & 1) == 0;
    let mut v9: i64 = g(20);
    let mut v10: P = P { a: g(10), b: (g(15) as f64) * 0.5 };
    let mut v11: P = P { a: g(11), b: (g(16) as f64) * 0.5 };
    let mut v12: i64 = g(23);
    let mut v13: i64 = g(24);
    let mut t: i64 = 0;
    let mut s: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        s = s ^ (a0 + t);
        s = s ^ (a2 + t);
        s = s ^ (a3 + t);
        s = s ^ (a5 + t);
        s = s ^ (a6 + t);
        s = s ^ (a7 + t);
        s = s ^ (a8 + t);
        s = s ^ (a10 + t);
        s = s ^ (a11 + t);
        s = s ^ (a12 + t);
        s = s ^ (a14 + t);
        s = s ^ (a15 + t);
        s = s ^ (a16 + t);
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b2;
        sf = sf * 0.5 + b4;
        sf = sf * 0.5 + b6;
        sf = sf * 0.5 + b7;
        sf = sf * 0.5 + b8;
        sf = sf * 0.5 + b10;
        sf = sf * 0.5 + b11;
        sf = sf * 0.5 + b12;
        sf = sf * 0.5 + b13;
        sf = sf * 0.5 + b15;
        sf = sf * 0.5 + b16;
        sf = sf * 0.5 + b17;
        sf = sf * 0.5 + b18;
        let c = g(t);
        { let tmp_r = v12; v12 = v9; v9 = tmp_r; }
        { let tmp_r = v1; v1 = v6; v6 = tmp_r; }
        s = s + g(t);
        v11 = P { a: (v11.a ^ c) & 65535, b: v11.b * 0.5 + v11.b * 0.25 };
        v5 = v5 * 0.5 + (c as f32) * 0.25 + v5 * 0.125;
        v7 = (!v7) != (((c & 1) == 0) && v8);
        { let tmp_r = v5; v5 = v4; v4 = tmp_r; }
        { let tmp_r = v0; v0 = v1; v1 = tmp_r; }
        if (c & 3) == 0 {
