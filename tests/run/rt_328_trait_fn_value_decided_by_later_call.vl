// XFAIL: RT-328: `let h = E2::mk; h(5)` with impls Conv<i64> and Conv<bool> for E2 is refused (type.infer, "more than one impl"): rustc decides the trait's argument from the later call (0.30.2)
// Since v0.30.1 at least (0.30.1: "no associated function 'mk' in 'E2'";
// the g302qual branch: type.infer at the path, which decides the
// trait's arguments from an expected fn type only). rustc builds it and
// prints the EXPECT line.
// EXPECT: 5
struct E2 {
    c: i64,
}

trait Conv<X> {
    fn mk(x: X) -> Self;
}

impl Conv<i64> for E2 {
    fn mk(x: i64) -> E2 {
        E2 { c: x }
    }
}

impl Conv<bool> for E2 {
    fn mk(x: bool) -> E2 {
        E2 { c: if x { 1 } else { 0 } }
    }
}

fn main() {
    let h = E2::mk;
    println("{}", h(5).c);
}
