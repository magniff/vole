// EDITION: rust
// RULE: D22.1, D22.1a
// (0.27.2.1) `next` of `I: Iterator<Item = i32>`: its virtual signature,
// `Option<I::Item>` with the bound's equality.
// EXPECT: 0
fn sum<I: Iterator<Item = i32>>(mut it: I) -> i32 {
    let mut s: i32 = 0;
    while let Some(x) = it.next() {
        s += x;
    }
    s
}

fn main() {
    println("0");
}
