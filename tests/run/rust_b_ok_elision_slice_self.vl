// EDITION: rust
// RULE: D4.2
// (0.27.2) E3 for a method on a slice: `&self` is a `&[T]`, and an
// elided result borrows from it, with another reference parameter too
// (std2's [T]::iter, `fn iter(&self) -> Iter<'_, T>`, in an instance whose
// T has a reference).
trait Pick {
    fn pick(&self, other: &i64) -> &i64;
}

impl Pick for [i64] {
    fn pick(&self, other: &i64) -> &i64 {
        let _ = other;
        &self[0]
    }
}

fn main() {
    let a = [4, 5];
    let k = 1;
    let s: &[i64] = &a[..];
    println("{}", *s.pick(&k));
}
// EXPECT: 4
