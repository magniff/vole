// RT-38 (F2): an `ensures` check runs in f's wrapper after the body's
// call; the wrapper only passes its parameters on, so none of them is
// `mut` there, and a check that writes one, a Copy one the body did not
// take, is refused: a clause writes nothing it did not make.
// ERROR: error[type error]: cannot assign to immutable variable 'n'
// ERROR: line 10, column 5
// ERROR-COUNT: 1
fn param_after(mut n: i64) -> i64
    ensures {
    n += 1;
    result > 0
}

{
    n
}

fn main() {
    println("{}", param_after(5));
}
