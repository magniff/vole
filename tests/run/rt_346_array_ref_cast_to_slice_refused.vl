// XFAIL: RT-346: `&[mk(1)] as &[D]` is refused: "cannot cast '&[D; 1]' to '&[D]'"; rustc accepts the unsizing cast (0.30.2)
// Since v0.30.1 at least. From the review of the temporary-scope work.
// EXPECT: 1
// EXPECT: drop 1
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn mk(n: i64) -> D {
    D { n: n }
}

fn main() {
    let x = &[mk(1)] as &[D];
    println("{}", x[0].n);
}
