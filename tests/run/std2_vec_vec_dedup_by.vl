// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::dedup_by.
// EXPECT: [1, 5, 9]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 5, 6, 7, 9], gpa);
    v.dedup_by(|a, b| *a - *b <= 2);
    println("{:?}", v);
}
