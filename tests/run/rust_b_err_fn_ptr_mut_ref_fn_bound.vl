// RULE: F33.1
// (0.30.2) `&mut F` of a fn pointer meets FnMut and FnOnce bounds, never
// Fn, as `&mut` of a closure: rustc E0277 (there is no `impl Fn for &mut
// F`). `&p` meets an Fn bound, and `&mut p` an FnMut one.
// ERROR: error[type error]
// ERROR: line 22, column 13
// ERROR-COUNT: 1
fn dbl(x: i64) -> i64 {
    x * 2
}

fn need<F: Fn(i64) -> i64>(f: F) -> i64 {
    f(3)
}

fn need_mut<F: FnMut(i64) -> i64>(mut f: F) -> i64 {
    f(4)
}

fn main() {
    let mut p: fn(i64) -> i64 = dbl;
    let a = need(&mut p);
    let b = need(&p);
    let c = need_mut(&mut p);
    println("{} {} {}", a, b, c);
}
