// Runs on std since 0.27.2's switch.
// The std item(s): std::thread JoinHandle::is_finished.
// EXPECT: true 8
use std::thread;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || 8i64, gpa);
    while !h.is_finished() {
        thread::yield_now();
    }
    println("{} {}", h.is_finished(), h.join().unwrap());
}
