// XFAIL: RT-469b: (RT-469, char) `char::from(a)` with `let a = 65;` and a later `let c: u8 = a;` is refused, "cannot convert 'i32' into 'char'" and "expected 'u8', got 'i32'"; rustc types a u8 and prints `A 65` (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: A 65
fn main() {
    let a = 65;
    let r = char::from(a);
    let c: u8 = a;
    println("{} {}", r, c);
}
