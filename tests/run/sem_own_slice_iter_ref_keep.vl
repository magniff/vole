// sem-own: iter_ref() items are views: keeping one past the Vec is own.escape/conflict; pushing into another Vec: refused.
// XFAIL: DIAG keeping an iter_ref() item is a type error whose help says "read through it with '*'" and try: *x (vole has no `*` on accesses)
// ERROR: own.
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(mk(1, gpa));
    let mut keep: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for x in w.iter() { keep.push(x); }
}
