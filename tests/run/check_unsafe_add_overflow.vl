// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: before
// STDERR: unsafe address out of bounds: an offset of 2305843009213693953 elements of 8 bytes overflows
// 0.30.1: under --check-unsafe, at every level (overflow checks on or
// off), an address whose offset in bytes does not fit an isize is
// refused, as Rust's add requires: here the product wraps to land 8
// bytes into the block, where the address alone would pass.
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(4, gpa);
    for i in 0..4 {
        v.push(i);
    }
    let p = v.as_ptr();
    println("before");
    // UNSAFE: deliberately out of bounds: count * 8 overflows usize.
    // SAFETY: none: the program exists to be stopped.
    let q = unsafe { p.add(usize::MAX / 8 + 2) };
    // UNSAFE: the read the address check stops first.
    // SAFETY: none.
    println("read {}", unsafe { *q });
}
