// Runs on std since 0.27.2's switch.
// The std item(s): std::string String::truncate.
// EXPECT: he
// EXIT: 101

fn main(gpa: Gpa) {
    let mut s = String::from_in("hello", gpa);
    s.truncate(2);
    s.truncate(10);
    println("{}", s);
    let mut t = String::from_in("\u{e9}", gpa);
    t.truncate(1);
}
