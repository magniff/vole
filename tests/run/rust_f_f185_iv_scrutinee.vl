// RULE: F18.5
// (0.30.2) A match on an integer variable leaves it free: its literal
// patterns are of its type, and the later `take(x)` types them all i64
// (FL6: 0.30.1 closed `x` at i32 as a scrutinee, and its literal did not
// fit).
// EXPECT: big 3000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let x = 3000000000;
    match x {
        0..=10 => println("small"),
        3000000000 => println("big {}", take(x)),
        _ => println("other"),
    }
}
