// The trait says `mk` returns a `&'static str`; the impl's `mk` returns
// `&'a str`, a borrow of the struct's field. rustc rejects the impl (E0308,
// method not compatible with trait: lifetime mismatch). vole accepted it,
// and a generic caller then trusts the trait's signature: `go` hands out a
// `&'static str` that points into `s`, freed at the end of the block, and
// the print reads freed memory (--check-alloc: use after free).
// ERROR: error[
// ERROR: line 20, column 5
// ERROR-COUNT: 1
trait Mk {
    fn mk(&self) -> &'static str;
}

struct X<'a> {
    s: &'a str,
}

impl<'a> Mk for X<'a> {
    // must be refused: the trait promises 'static
    fn mk(&self) -> &'a str {
        self.s
    }
}

fn go<T: Mk>(t: &T) -> &'static str {
    t.mk()
}

fn main(gpa: Gpa) {
    let r: &'static str;
    {
        let s = String::from_in("hello", gpa);
        let x = X { s: s.as_str() };
        r = go(&x);
    }
    println("{r}");
}
