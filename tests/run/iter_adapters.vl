// EDITION: rust
// XFAIL: gap 4: compile type error: expected 'i64', got 'usize'
// The Iterator trait on std's sources and a user type (0.14), without
// closures: enumerate, zip and take, `for` over a chain (the `next`
// path), their exact_len and at, the consumers that call next, and a
// generic function bounded by Iterator. (map and filter need closures:
// iter_chain_*.)
// EXPECT: enumerate 5 101 209
// EXPECT: zip 15 12 21 | 0 1 2
// EXPECT: take 0 1 2 | 5 1 9
// EXPECT: len 3 2 8 2 3
// EXPECT: counter 4 10 1 4 | 5 6 3
// EXPECT: first 5 none
#[derive(Clone, Copy)] struct Counter { n: i64, limit: i64 }

impl Iterator for Counter {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n < self.limit {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn first<I: Iterator>(it: I) -> Option<I::Item> {
    let mut i = it;
    i.next()
}

fn show(x: i64) {
    print(" ");
    print("{}", x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    print("enumerate");
    for (i, x) in v.iter().copied().enumerate() {
        show(i * 100 + x);
    }
    println("");
    print("zip");
    for (a, b) in v.iter().copied().zip((10i64..20i64)) {
        show(a + b);
    }
    print(" |");
    for (a, b) in ((0i64..3i64)).zip(v.iter().copied()) {
        show(a);
    }
    println("");
    print("take");
    for x in (0i64..10i64).take(3usize) {
        show(x);
    }
    print(" |");
    for x in v.as_slice().iter().copied().take(5usize) {
        show(x);
    }
    println("");
    print("len");
    show(v.iter().copied().enumerate().size_hint().0);
    let mut z = v.iter().copied().zip((7i64..9i64));
    show(z.size_hint().0);
    show(z.nth(1 as usize).unwrap().1);
    show(v.iter().copied().take(2usize).size_hint().0);
    show((0i64..10i64).take(3usize).size_hint().0);
    println("");
    print("counter");
    show(Counter { n: 0, limit: 4 }.count() as i64);
    show((Counter { n: 0, limit: 4 }).sum::<i64>());
    show(Counter { n: 0, limit: 4 }.min().unwrap());
    show(Counter { n: 0, limit: 4 }.max().unwrap());
    print(" |");
    let mut c = (Counter { n: 0, limit: 6 }).collect_in::<Vec<i64, Gpa>, _>(gpa);
    show(c.len() as i64 - 1);
    show(c[5usize]);
    show((Counter { n: 0, limit: 3 }).enumerate().count() as i64);
    println("");
    print("first");
    show(first(v.iter().copied().zip((0i64..=3i64)).enumerate()).unwrap().1.0);
    if first(Counter { n: 0, limit: 0 }).is_none() {
        print(" none");
    }
    println("");
    0
}
