// Where two integer types meet without an expected type (0.15), the
// result is the wider one: an operator's operands (comparisons too), the
// branches of an if, the arms of a match, two arguments of one type
// parameter (in either order); literals still take the other operand's
// type.
// EXPECT: add 10000000007 10000000007 cmp lt
// EXPECT: if 10000000000 7 match 10000000000 7 max 10000000000 10000000000
// EXPECT: lit 255 u8+u16 300 mixed 4000000007

fn max<T: Ord>(a: T, b: T) -> T {
    if a > b { a } else { b }
}

fn pick(c: bool, a: i32, b: i64) -> i64 {
    if c { a } else { b }
}

fn arm(k: i64, a: i32, b: i64) -> i64 {
    match k {
        0 => b,
        _ => a,
    }
}

fn main() {
    let a: i32 = 7;
    let b: i64 = 10000000000;
    print("add ");
    print("{}", (a + b));
    print(" ");
    print("{}", (b + a));
    print("{}", if a < b { " cmp lt" } else { " cmp ge" });
    println("");
    print("if ");
    print("{}", pick(false, a, b));
    print(" ");
    print("{}", pick(true, a, b));
    let m = match a {
        7 => b,
        _ => a,
    };
    print(" match ");
    print("{}", m);
    print(" ");
    print("{}", arm(1, a, b));
    print(" max ");
    print("{}", max(a, b));
    print(" ");
    print("{}", max(b, a));
    println("");
    let x: u8 = 254;
    print("lit ");
    print("{}", ((x + 1) as i64));
    let y: u16 = 46;
    print(" u8+u16 ");
    print("{}", ((x + y) as i64));
    let u: u32 = 4000000000;
    print(" mixed ");
    print("{}", (u + a as i64));
    println("");
}
