// XFAIL: RT-426i: WRONG CODE: (RT-426's family, an associated const) `T::N` under `T: Tr`, with W implementing Tr (N = 1) and Tr2 (N = 2), the Tr2 impl declared last: vole prints 2, rustc 1 (0.30.2)
// From the re-review of g302oblig M2 (its form c11b_assoc_const_bound_tr). Since v0.30.1 at
// least (v0.30.1 and the release build print 2).
// EXPECT: 1
trait Tr2 {
    const N: i64;
}

trait Tr {
    const N: i64;
}

struct W;

impl Tr for W {
    const N: i64 = 1;
}

impl Tr2 for W {
    const N: i64 = 2;
}

fn n2<T: Tr>() -> i64 {
    T::N
}

fn main() {
    println("{}", n2::<W>());
}
