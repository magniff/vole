// RULE: D21.6 (0.30.2, RT-213, RT-334) An `impl FnOnce` value whose hidden
// closure changes its capture (an FnMut), called once through a binding
// that is not `mut`: accepted, as rustc (the call consumes it, it needs no
// `mut`). (k22 of the review of the opaque-type work)
// EXPECT: 1
// EXPECT: 1
fn mk() -> impl FnOnce() -> i64 {
    let mut n = 0;
    move || {
        n += 1;
        n
    }
}

struct H<F> {
    f: F,
}

fn main() {
    let g = mk();
    println("{}", g());
    let h = H { f: mk() };
    println("{}", (h.f)());
}
