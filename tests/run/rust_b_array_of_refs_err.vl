// EDITION: rust
// RULE: D3.3
// (0.28.0) An array's elements are its type's: `[s.as_str(), "x"]` holds
// the loan of s, and `a[0]` takes it out, so s cannot be changed while r
// is used (rustc E0502). 0.27.8 mapped no slot of an array's element, and
// accepted it.
// ERROR: error[borrowck.conflict]
fn main(gpa: Gpa) {
    let mut s = String::from_in("hello world", gpa);
    let a = [s.as_str(), "x"];
    let r = a[0];
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
}
