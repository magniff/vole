// RULE: D2.10
// (0.30.1) A packed struct's array field is referenced by every slice
// made of it, as `&p.arr` is: the autoref of a slice method
// (`p.arr.first()`, `.iter()`, `.contains(..)`, `.len()`), a slicing
// (`&p.arr[..]`, `&p.arr[0..1]`), the coercion `let r: &[i64] = &p.arr`,
// and one through a Vec's element. rustc: E0793 on each. Before, the
// slicing never reached the check, and an atomic through the misaligned
// slice raised SIGBUS in safe code.
// ERROR: error[borrowck.packed_ref]
// ERROR: line 36, column 13
// ERROR: error[borrowck.packed_ref]
// ERROR: line 37, column 18
// ERROR: error[borrowck.packed_ref]
// ERROR: line 38, column 13
// ERROR: error[borrowck.packed_ref]
// ERROR: line 39, column 13
// ERROR: error[borrowck.packed_ref]
// ERROR: line 40, column 14
// ERROR: error[borrowck.packed_ref]
// ERROR: line 41, column 14
// ERROR: error[borrowck.packed_ref]
// ERROR: line 42, column 22
// ERROR: error[borrowck.packed_ref]
// ERROR: line 48, column 17
// ERROR-COUNT: 8
use std::sync::atomic::{AtomicI64, Ordering};

#[repr(C, packed)]
struct P { a: u8, arr: [i64; 2] }

#[repr(C, packed)]
struct Q { pad: [u8; 61], arr: [AtomicI64; 2] }

fn main(gpa: Gpa) {
    let p = P { a: 1, arr: [3, 4] };
    let f = p.arr.first();
    let s: i64 = p.arr.iter().sum();
    let c = p.arr.contains(&3);
    let n = p.arr.len();
    let w = &p.arr[..];
    let x = &p.arr[0..1];
    let r: &[i64] = &p.arr;
    println("{:?} {} {} {} {:?} {:?} {:?}", f, s, c, n, w, x, r);
    let mut v: Vec<Q, Gpa> = Vec::new_in(gpa);
    v.push(Q { pad: [0; 61], arr: [AtomicI64::new(1), AtomicI64::new(2)] });
    let mut t = 0;
    for i in 0..v.len() {
        let g = v[i].arr.first().unwrap();
        t += g.fetch_add(1, Ordering::SeqCst);
    }
    println("{}", t);
}
