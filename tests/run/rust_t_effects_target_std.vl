// EDITION: rust
// RULE: E3.1a
// (0.28.0) The declared lists of std's ungated modules whose bodies reach
// the target's system (std::__sys: the futex call, the clocks): sync,
// thread and time. Every public function is named as a value under a
// caller that declares no effect, a generic one with its type arguments;
// one that takes a closure is called (the list of a function is checked
// where it is kept, whatever its caller declares). The lists are checked
// for the target of the build: tests/effects-cross.sh builds this case
// and the gated ones for both Linux targets (Linux's futex is C's
// `syscall`, which the checker does not know: its list is declared).
// CROSS: aarch64-linux x86_64-linux
// EXPECT: 30 12 45 7

use std::alloc::Gpa;
use std::sync::{Arc, Condvar, Mutex, Once, PoisonError, RwLock};
use std::time::{Duration, Instant, SystemTime};

#[effects()]
fn sync_fns() -> i64 {
    let _f0 = PoisonError::<i64>::new;
    let _f1 = PoisonError::<i64>::into_inner;
    let _f2 = PoisonError::<i64>::get_ref;
    let _f3 = PoisonError::<i64>::get_mut;
    let _f4 = Mutex::<i64>::new;
    let _f5 = Mutex::<i64>::lock;
    let _f6 = Mutex::<i64>::try_lock;
    let _f7 = Mutex::<i64>::is_poisoned;
    let _f8 = Mutex::<i64>::into_inner;
    let _f9 = Mutex::<i64>::get_mut;
    let _f10 = Condvar::new;
    let _f11 = Condvar::wait::<i64>;
    let _f12 = Condvar::notify_one;
    let _f13 = Condvar::notify_all;
    let _f14 = Once::new;
    let _f15 = Once::is_completed;
    let _f16 = RwLock::<i64>::new;
    let _f17 = RwLock::<i64>::read;
    let _f18 = RwLock::<i64>::write;
    let _f19 = RwLock::<i64>::try_read;
    let _f20 = RwLock::<i64>::try_write;
    let _f21 = RwLock::<i64>::is_poisoned;
    let _f22 = RwLock::<i64>::into_inner;
    let _f23 = RwLock::<i64>::get_mut;
    let _f24 = std::sync::mpsc::channel_in::<i64, Gpa>;
    let _f25 = std::sync::mpsc::Sender::<i64, Gpa>::send;
    let _f26 = std::sync::mpsc::Receiver::<i64, Gpa>::recv;
    let _f27 = std::sync::mpsc::Receiver::<i64, Gpa>::try_recv;
    let _f28 = std::sync::mpsc::Receiver::<i64, Gpa>::iter;
    let _f29 = std::sync::mpsc::Receiver::<i64, Gpa>::try_iter;
    30
}

#[effects()]
fn arc_thread_fns() -> i64 {
    let _f0 = Arc::<i64, Gpa>::new_in;
    let _f1 = Arc::<i64, Gpa>::strong_count;
    let _f2 = Arc::<i64, Gpa>::as_ptr;
    let _f3 = Arc::<i64, Gpa>::ptr_eq;
    let _f4 = Arc::<i64, Gpa>::get_mut;
    let _f5 = Arc::<i64, Gpa>::try_unwrap;
    let _f6 = Arc::<i64, Gpa>::into_inner;
    let _f7 = Arc::<i64, Gpa>::allocator;
    let _f8 = std::thread::yield_now;
    let _f9 = std::thread::available_parallelism;
    let _f10 = std::thread::sleep;
    let _f11 = std::thread::JoinHandle::<i64, Gpa>::is_finished;
    12
}

#[effects()]
fn time_fns() -> i64 {
    let _f0 = Duration::new;
    let _f1 = Duration::from_secs;
    let _f2 = Duration::from_millis;
    let _f3 = Duration::from_micros;
    let _f4 = Duration::from_nanos;
    let _f5 = Duration::from_secs_f64;
    let _f6 = Duration::from_secs_f32;
    let _f7 = Duration::try_from_secs_f64;
    let _f8 = Duration::try_from_secs_f32;
    let _f9 = Duration::is_zero;
    let _f10 = Duration::as_secs;
    let _f11 = Duration::subsec_millis;
    let _f12 = Duration::subsec_micros;
    let _f13 = Duration::subsec_nanos;
    let _f14 = Duration::as_millis;
    let _f15 = Duration::as_micros;
    let _f16 = Duration::as_nanos;
    let _f17 = Duration::as_secs_f64;
    let _f18 = Duration::as_secs_f32;
    let _f19 = Duration::as_millis_f64;
    let _f20 = Duration::checked_add;
    let _f21 = Duration::checked_sub;
    let _f22 = Duration::checked_mul;
    let _f23 = Duration::checked_div;
    let _f24 = Duration::saturating_add;
    let _f25 = Duration::saturating_sub;
    let _f26 = Duration::saturating_mul;
    let _f27 = Duration::abs_diff;
    let _f28 = Duration::mul_f64;
    let _f29 = Duration::div_f64;
    let _f30 = Duration::div_duration_f64;
    let _f31 = Instant::now;
    let _f32 = Instant::duration_since;
    let _f33 = Instant::checked_duration_since;
    let _f34 = Instant::saturating_duration_since;
    let _f35 = Instant::elapsed;
    let _f36 = Instant::checked_add;
    let _f37 = Instant::checked_sub;
    let _f38 = SystemTime::now;
    let _f39 = SystemTime::duration_since;
    let _f40 = SystemTime::elapsed;
    let _f41 = SystemTime::checked_add;
    let _f42 = SystemTime::checked_sub;
    let _f43 = std::time::SystemTimeError::duration;
    let _f44 = Instant::as_nanos;
    45
}

// The ones that take a closure, called: Once::call_once, thread::scope,
// Scope::spawn, ScopedJoinHandle::join and is_finished, thread::spawn_in,
// JoinHandle::join.
fn closure_fns(gpa: Gpa) -> i64 {
    let mut n: i64 = 0;
    let once = Once::new();
    once.call_once(|| {});
    if once.is_completed() {
        n += 1;
    }
    let m = Mutex::new(0i64);
    std::thread::scope(|s| {
        let h = s.spawn(|| {
            *m.lock().unwrap() += 2;
            1i64
        });
        let _ = h.is_finished();
        n += h.join().unwrap();
    });
    n += *m.lock().unwrap();
    let h = std::thread::spawn_in(|| 3i64, gpa);
    n += h.join().unwrap();
    n
}

fn main(gpa: Gpa) {
    println("{} {} {} {}", sync_fns(), arc_thread_fns(), time_fns(), closure_fns(gpa));
}
