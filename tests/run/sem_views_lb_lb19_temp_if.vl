// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: a view of a temporary receiver inside an if branch, kept past it
// ERROR: error[own.escape]
struct H<A: Allocator> { b: Vec<u8, A> }
impl H<Gpa> { fn view(self) -> [u8] { self.b.as_slice() } }

fn mk(gpa: Gpa, c: u8) -> H<Gpa> {
    var b = Vec::<u8, Gpa>::new_in(gpa); b.push(c); b.push(c); H { b: b }
}

fn main(gpa: Gpa) -> i32 {
    var keep: [u8] = "";
    let k = 1;
    if k > 0 { keep = mk(gpa, 'a').view(); }
    println(keep);
    0
}
