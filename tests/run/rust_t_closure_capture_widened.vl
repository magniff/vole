// EDITION: rust
// RULE: FR5, D20.3
// (0.27.4) A `move` closure returning a captured loop variable where the
// bound's `i64` goes, in a loop, as a generic call's argument: the
// variable is the range's i32, widened under the capture (rustc infers
// i64 for it). It was "a function not lowered from its body".
// EXPECT: 4 6
use std::thread;
use std::thread::JoinHandle;

fn main(gpa: Gpa) {
    let mut hs: Vec<JoinHandle<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    for k in 0..4 {
        hs.push(thread::spawn_in(move || k, gpa));
    }
    let n = hs.len();
    let mut sum = 0i64;
    for h in hs {
        sum += h.join().unwrap();
    }
    println("{} {}", n, sum);
}
