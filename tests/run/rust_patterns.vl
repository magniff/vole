// (0.27.0) Patterns in the rust edition: `&x`, `&(a, b)` and `&Some(k)`
// through a reference, `ref` and `ref mut` bindings, match ergonomics.

fn main() -> i32 {
    let n = 9;
    let r = &n;
    let &x = r;
    let t = &(4, 5);
    let &(a, b) = t;
    let mut s = 0;
    match &Some(7) {
        &Some(k) => s += k,
        &None => {}
    }
    match r {
        &y => s += y,
    }
    let mut pair = (1, 2);
    let (ref p, ref mut q) = pair;
    *q += *p;
    match &pair {
        (u, w) => s += *u * 100 + *w,
    }
    println("{} {} {} {} {}", x, a, b, s, pair.1);
    0
}
// EXPECT: 9 4 5 119 3
