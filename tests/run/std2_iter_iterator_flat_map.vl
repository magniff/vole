// EDITION: rust
// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::iter Iterator::flat_map.
// EXPECT: [1, 1, 2, 2]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let a: Vec<i64, Gpa> = v.iter().flat_map(|x| [*x, *x]).collect_in(gpa);
    println("{:?}", a);
}
