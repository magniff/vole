// f-string holes (0.15): a value without Display ({x}) or Debug ({x:?})
// gets the impl to write; x, X, b need an integer, c a u8; an f-string is
// not a [u8].
// ERROR: error[type error]: 'P' does not implement Display, which '{x}' needs
// ERROR: line 25, column 15
// ERROR: help: write 'impl Display for P { fn fmt(self, f: inout std::Fmt) { f.write("..", args); } }'
// ERROR: error[type error]: 'P' does not implement Debug, which '{x:?}' needs
// ERROR: line 30, column 18
// ERROR: help: derive it: '#[derive(Debug)]' before the type, or write 'impl Debug for P
// ERROR: error[type error]: 'x', 'X', 'o' and 'b' write an integer's digits: they need an integer, got 'f64'
// ERROR: line 35, column 15
// ERROR: error[type error]: 'c' writes a byte: it needs a 'u8', got 'i64'
// ERROR: line 40, column 15
// ERROR: error[type error]
// ERROR: line 45, column 23
// ERROR: error[type error]
// ERROR: line 50, column 15
// ERROR-COUNT: 6
#[derive(Clone, Copy)] struct P { x: i64 }

fn takes(s: &str) -> i64 { s.len() as i64 }

fn display() {
    let p = P { x: 1 };
    println("{p}");
}

fn debug() {
    let p = P { x: 1 };
    println("{} {p:?}", p.x);
}

fn hex() {
    let f = 1.5;
    println("{f:x}");
}

fn byte() {
    let n: i64 = 65;
    println("{n:c}");
}

fn slice() {
    let n: i64 = 1;
    takes(format_args("{n}"));
}

fn tuple() {
    let t = (1, 2);
    println("{t}");
}

fn main() {}
