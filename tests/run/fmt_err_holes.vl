// f-string holes (0.15): a value without Display ({x}) or Debug ({x:?})
// gets the impl to write; x, X, b need an integer, c a u8; an f-string is
// not a [u8].
// ERROR: 'P' does not implement Display, which '{x}' needs
// ERROR: help: write 'impl Display for P { fn fmt(self, f: inout std::Fmt) { f.write("..", args); } }'
// ERROR: 'P' does not implement Debug, which '{x:?}' needs
// ERROR: help: derive it: '#[derive(Debug)]' before the type, or write 'impl Debug for P
// ERROR: 'x', 'X', 'o' and 'b' write an integer's digits: they need an integer, got 'f64'
// ERROR: 'c' writes a byte: it needs a 'u8', got 'i64'
// ERROR: a format_args value is a 'std::Interp' (a value that prints), not '[u8]'
// ERROR: help: format it: 'format_in("...", gpa)' makes the text
// ERROR: '(i64, i64)' does not implement Display
// ERROR-COUNT: 6
struct P { x: i64 }

fn takes(s: [u8]) -> i64 { s.len as i64 }

fn display() {
    let p = P { x: 1 };
    println("{p}");
}

fn debug() {
    let p = P { x: 1 };
    println("{} {p:?}", p.x);
}

fn hex() {
    let f = 1.5;
    println("{f:x}");
}

fn byte() {
    let n = 65;
    println("{n:c}");
}

fn slice() {
    let n = 1;
    takes(format_args("{n}"));
}

fn tuple() {
    let t = (1, 2);
    println("{t}");
}

fn main() {}
