// A guarded index of an array field.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

#[derive(Clone, Copy)] struct S { a: [i64; 3], n: i64 }

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let s = S { a: [1i64, 2, 3], n: 0 };
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k < 5 + unsafe { Z } { if k > 100 { t += s.a[i as usize]; } k += 1; }
    println("{}", t);
    0
}
