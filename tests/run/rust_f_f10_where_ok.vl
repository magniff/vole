// EDITION: rust
// RULE: F10.2
// A `where` bound on a projection, `S::Item: Show`, and one on `Self` in
// a trait's default method, `where Self: Double`: both hold here.
// EXPECT: 7
// EXPECT: 14
trait Show {
    fn show(&self) -> i64;
}

trait Src {
    type Item;
    fn item(&self) -> Self::Item;
}

trait Double {
    fn double(&self) -> i64;
}

trait Twice {
    fn twice(&self) -> i64
        where
            Self: Double,
    {
        self.double() * 2
    }
}

struct S {
    n: i64,
}

impl Show for S {
    fn show(&self) -> i64 {
        self.n
    }
}

impl Src for S {
    type Item = S;

    fn item(&self) -> S {
        S { n: self.n }
    }
}

impl Double for S {
    fn double(&self) -> i64 {
        self.n
    }
}

impl Twice for S {}

fn show_item<X: Src>(x: &X) -> i64
    where
        X::Item: Show,
{
    x.item().show()
}

fn main() -> i64 {
    let s = S { n: 7 };
    std::print_int(show_item(&s));
    println("");
    std::print_int(s.twice());
    println("");
    0
}
