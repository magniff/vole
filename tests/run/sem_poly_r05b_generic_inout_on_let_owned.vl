// a generic with a let T calling an inout-self method, T owned: the caller's let value changes through a let borrow,
// while a view of it is held
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 7, column 26
trait B { fn grow(&mut self); }
impl B for Vec<i64, Gpa> { fn grow(&mut self) { for i in 0..1000 { self.push(i); } } }
fn use_it<T: B>(x: &T) { x.grow(); }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let s = v.as_slice();
    use_it(&v);
    println("{} {}", s[0], v.len());
}
