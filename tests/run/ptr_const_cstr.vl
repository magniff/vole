// RULE: F30.5
// (0.29) A `c"..."` literal is a `*const u8`: its bytes are read only.
// It goes where a `*const u8` is expected, and to a C function declared
// with one; a `*mut u8` buffer goes there too.
// EXPECT: 5 104
// EXPECT: hello
// UNSAFE: C's string functions.
// SAFETY: string.h's and stdio.h's prototypes: both read a NUL-terminated
// string and write nothing through it.
extern "C" {
    fn strlen(s: *const u8) -> u64;
    fn puts(s: *const u8) -> i32;
}

fn first(s: *const u8) -> u8 {
    // UNSAFE: reads through the caller's pointer.
    // SAFETY: the caller gives a NUL-terminated string: its first byte
    // is there.
    unsafe { *s }
}

fn main() {
    let text: *const u8 = c"hello";
    let mut buf = [104u8, 101, 108, 108, 111, 0];
    let p: *mut u8 = buf.as_mut_ptr();
    // UNSAFE: C calls on NUL-terminated strings.
    // SAFETY: the literal and the array both end with a 0 byte.
    let n = unsafe { strlen(text) };
    println("{} {}", n, first(p));
    // UNSAFE: as above.
    // SAFETY: as above.
    unsafe {
        puts(p);
    }
}
