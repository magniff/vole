// Runs on std since 0.27.2's switch.
// The std item(s): std::io Error::impl Debug.
// EXPECT: Custom { kind: Other, error: "msg" }
// EXPECT: Os { code: 2, kind: NotFound, message: "No such file or directory" }
// EXPECT: Kind(BrokenPipe)
use std::io::{ErrorKind, self};

fn main() {
    println("{:?}", io::Error::new(ErrorKind::Other, "msg"));
    println("{:?}", io::Error::from_raw_os_error(2));
    println("{:?}", io::Error::from(ErrorKind::BrokenPipe));
}
