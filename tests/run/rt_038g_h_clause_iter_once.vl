// RULE: C3.4
// (0.30.2, review of RT-38g) `iter::once(n).all(..)` and `Some(n).into_iter().count()` in a
// clause. A callee's raw write is refused only
// when a raw pointer may reach it from what the clause reads (a
// parameter's or the result's type holds one, contracts::raw_inputs).
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
fn f(n: i64) -> i64
    requires std::iter::once(n).all(|x: i64| x > 0)
    requires Some(n).into_iter().count() == 1
{
    n
}

fn main() {
    println("{}", f(3));
}
