// RULE: C3.4
// (0.30.2, review of RT-38g) `iter::once(n).all(..)` and `Some(n).into_iter().count()` in a
// clause. A write through a pointer made of
// a `&mut` the clause holds is a `&mut` write, not a raw one: only a write
// through what the clause did not make is refused (effects/provenance.vl).
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
fn f(n: i64) -> i64
    requires std::iter::once(n).all(|x: i64| x > 0)
    requires Some(n).into_iter().count() == 1
{
    n
}

fn main() {
    println("{}", f(3));
}
