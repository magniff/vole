// RUSTC: none contract clauses are not Rust
// ERROR: 's' is used here after it moved
// The real read first, then a shadowing closure param: where is the error?
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures {
    let a = [1i64, 2];
    s.v == 4 && a.iter().all(|s: &i64| *s > 0)
}

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
