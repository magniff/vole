// Runs on std since 0.27.2's switch.
// The std item(s): std::thread ScopedJoinHandle::join.
// EXPECT: hello 5
use std::thread;

fn main() {
    let word = "hello";
    let (w, n) = thread::scope(|s| {
        let h = s.spawn(|| (word, word.len()));
        h.join().unwrap()
    });
    println("{} {}", w, n);
}
