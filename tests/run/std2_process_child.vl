// EDITION: rust
// The std2 item(s): std::process Command::spawn; std::process Command::stdin; std::process Command::stdout; std::process Command::stderr; std::process Stdio; std::process Stdio::piped; std::process Stdio::null; std::process Stdio::inherit; std::process Child; std::process Child::wait; std::process Child::try_wait; std::process Child::kill; std::process Child::id; std::process ChildStdin; std::process ChildStdout; std::process id.
// EXPECT: "abc" true
// EXPECT: true None
// EXPECT: signal: 9 (SIGKILL) None
// EXPECT: true
use std::io::{Read, Write};
use std::process::{Command, Stdio, self};

fn main(gpa: Gpa) {
    let mut c = Command::new_in("cat", gpa).stdin(Stdio::piped()).stdout(Stdio::piped())
        .stderr(Stdio::null()).spawn().unwrap();
    c.stdin.take().unwrap().write_all(b"abc").unwrap();
    let mut s = String::new_in(gpa);
    c.stdout.take().unwrap().read_to_string(&mut s).unwrap();
    println("{:?} {}", s, c.wait().unwrap().success());
    let mut k = Command::new_in("sleep", gpa).arg("5").stdout(Stdio::inherit()).spawn().unwrap();
    let running = k.try_wait().unwrap();
    println("{} {:?}", k.id() > 0, running.map(|s| s.success()));
    k.kill().unwrap();
    let st = k.wait().unwrap();
    println("{} {:?}", st, st.code());
    println("{}", process::id() > 0 && k.kill().is_ok());
}
