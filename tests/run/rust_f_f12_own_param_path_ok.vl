// RULE: F12.2
// A default's own parameter named as an impl's (collect_in's B in Map's
// and Zip's impls) is the default's in a path's head too:
// `B::from_iter_in(..)` builds the collection, not the impl's B.
// EXPECT: [(1, 3), (2, 4)]
// EXPECT: 7
use std::iter::Zip;
use std::slice::Iter;

trait Make {
    fn make() -> Self;
}

impl Make for i64 {
    fn make() -> i64 {
        7
    }
}

trait Pick {
    fn pick<B: Make>(&self) -> B {
        B::make()
    }
}

struct Holder<B> {
    b: B,
}

impl<B> Pick for Holder<B> {}

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let w = Vec::from_in([3i64, 4], gpa);
    let it: Zip<Iter<'_, i64>, Iter<'_, i64>> = s.iter().zip(w.iter());
    let z: Vec<(i64, i64), Gpa> = it.map(|(a, b)| (*a, *b)).collect_in(gpa);
    let h = Holder { b: "x" };
    let k: i64 = h.pick();
    println("{:?}", z);
    println("{}", k);
}
