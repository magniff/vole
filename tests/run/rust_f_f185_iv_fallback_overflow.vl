// RULE: F18.5
// (0.30.2) Where nothing types an integer literal it is i32, rustc's
// fallback: `a + a` is an i32 addition, which overflows (a panic at -O0,
// as rustc's debug build).
// FLAGS: -O0
// EXIT: 101
// STDERR: rust_f_f185_iv_fallback_overflow.vl:13:13: attempt to add with overflow
fn main() {
    let mut a = 2000000000;
    if std::env::args().count() > 5 {
        a = 1;
    }
    let b = a + a;
    println("{b}");
}
