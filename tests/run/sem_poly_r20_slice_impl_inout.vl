// impl for [T] with inout self: reverse in place through a Vec's slice
// (0.30.1, RT-33: of `[T]`, not `&[T]`: a `&mut self` of `&[T]` is a
// `&mut &[T]`, and swapping through its shared view is rustc's E0596)
// FLAGS: --check-alloc
// EXPECT: [3, 2, 1]
trait Rev { fn rev(&mut self); }

impl<T> Rev for [T] {
    fn rev(&mut self) {
        let mut i: i64 = 0;
        let mut j = self.len() - 1;
        while i < j as i64 { self.swap(i as usize, j as usize); i += 1; j -= 1; }
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2); v.push(3);
    v.as_mut_slice().rev();
    println("{v:?}");
}
