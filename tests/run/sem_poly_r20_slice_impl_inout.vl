// EDITION: rust
// impl for [T] with inout self: reverse in place through a Vec's slice
// FLAGS: --check-alloc
// EXPECT: [3, 2, 1]
trait Rev { fn rev(&mut self); }

impl<T> Rev for &[T] {
    fn rev(&mut self) {
        let mut i: i64 = 0;
        let mut j = self.len() - 1;
        while i < j as i64 { self.swap(i as usize, j as usize); i += 1; j -= 1; }
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2); v.push(3);
    v.as_mut_slice().rev();
    println("{v:?}");
}
