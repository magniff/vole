// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash BuildHasherDefault.
// EXPECT: true
use std::hash::{BuildHasher, BuildHasherDefault, Hash, Hasher};

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

impl Default for Fnv {
    fn default() -> Fnv {
        Fnv { h: 0xcbf29ce484222325 }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

fn main() {
    let b: BuildHasherDefault<Fnv> = BuildHasherDefault::default();
    let mut h = fnv();
    h.write_u8(9);
    let mut g = b.build_hasher();
    g.write_u8(9);
    println("{}", g.finish() == h.finish());
}
