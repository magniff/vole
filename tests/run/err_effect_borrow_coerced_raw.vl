// RULE: E1.8 (0.30.1) A reference made a raw pointer with no cast, by
// the coercion (`KEPT = r` into a `*const u64` static, `Keeper { p: r }`
// into a `*mut i64` field, `let q: *mut i64 = r;`, `&mut i` given to
// NonNull::new's `*mut T`), makes a raw pointer of a reference as a cast
// does: the hidden `addr`, and the local's proofs are lost. Before, only
// a written cast counted: -O2 took the loop's end and the division's
// check away.
// ERROR: 'k' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'l_static' is #[effects(unsafe, static)], but it may not terminate (diverge):
// ERROR: 'l_field' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR: 'l_let' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR: 'l_nonnull' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR-COUNT: 5
use std::ptr::NonNull;

static mut KEPT: *const u64 = std::ptr::null();
static mut KEPT_I: *const i64 = std::ptr::null();

fn stash(r: &u64) {
    // UNSAFE: the attack: a reference kept in a static, coerced
    // SAFETY: written once, read while the local lives
    unsafe {
        KEPT = r;
    }
}

fn clobber() {
    // UNSAFE: the attack
    // SAFETY: KEPT is a live local's address
    unsafe {
        let p = KEPT as *mut u64;
        *p = 0;
    }
}

#[no_panic]
fn k(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        stash(&d);
        clobber();
        x / d
    } else {
        0
    }
}

fn stash_i(r: &i64) {
    // UNSAFE: the attack: a reference kept in a static, coerced
    // SAFETY: written once, read while the local lives
    unsafe {
        KEPT_I = r;
    }
}

fn clobber_i() {
    // UNSAFE: the attack
    // SAFETY: KEPT_I is a live local's address
    unsafe {
        *(KEPT_I as *mut i64) = 0;
    }
}

#[effects(unsafe, static)]
fn l_static(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        stash_i(&i);
        clobber_i();
        i += 1;
    }
    i
}

struct Keeper {
    p: *mut i64,
}

impl Keeper {
    fn zero(&self) {
        // UNSAFE: the attack: a write through a kept pointer
        // SAFETY: p is a live local's address
        unsafe {
            *self.p = 0;
        }
    }
}

fn keep(r: &mut i64) -> Keeper {
    Keeper { p: r }
}

#[effects(unsafe)]
fn l_field(n: i64) -> i64 {
    let mut i: i64 = 0;
    let k = keep(&mut i);
    while i < n {
        k.zero();
        i += 1;
    }
    i
}

fn mkp(r: &mut i64) -> Keeper {
    let q: *mut i64 = r;
    Keeper { p: q }
}

#[effects(unsafe)]
fn l_let(n: i64) -> i64 {
    let mut i: i64 = 0;
    let k = mkp(&mut i);
    while i < n {
        // UNSAFE: the attack
        // SAFETY: k.p is i's address
        unsafe {
            *k.p = 0;
        }
        i += 1;
    }
    i
}

fn zero_nn(p: NonNull<i64>) {
    // UNSAFE: the attack
    // SAFETY: p is a live local's address
    unsafe {
        *p.as_ptr() = 0;
    }
}

#[effects(unsafe)]
fn l_nonnull(n: i64) -> i64 {
    let mut i: i64 = 0;
    let p = NonNull::new(&mut i);
    while i < n {
        if let Some(q) = p {
            zero_nn(q);
        }
        i += 1;
    }
    i
}

fn main() {
    println("{}", k(7, 1));
    println("{} {} {} {}", l_static(3), l_field(3), l_let(3), l_nonnull(3));
}
