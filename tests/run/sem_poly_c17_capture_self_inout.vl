// EDITION: rust
// a closure in an inout-self method captures self: assignments reach the receiver
// FLAGS: --check-alloc
// EXPECT: 3
#[derive(Clone, Copy)] struct P { x: i64 }

impl P {
    fn bump2(&mut self) {
        let c = || { self.x += 1; };
        c();
        c();
    }
}

fn main() {
    let mut p = P { x: 1 };
    p.bump2();
    println("{}", p.x);
}
