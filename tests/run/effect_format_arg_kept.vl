// RULE: E1.8 (0.30.1) A format argument's borrow of a proven local keeps
// the proof: the places IR borrows each hole's place (`_k = &i`, D2.9,
// held to the call) and only reads through it (`=f0 = copy (*_k)`); the
// formatting calls get a borrow of that copy, not of i
// (places::build::settle_loans, LOAN_READ_PLAIN). Each counted loop
// below keeps its proof, so none may diverge. (Before, each hole was a
// borrow the effect walk did not see: the proof was lost, a false
// `diverge`; err_effect_format_arg_escapes is where it must be lost.) A
// reference bound to i's borrow and only read through is one too
// (`through`), which the walk also sees.
// EXPECT: 0 0   0|1 1   1|2 2   2|
// EXPECT: e 0 0|e 1 1|
// EXPECT: 0 0   0|
// EXPECT: w 0 0|w 1 1|
// EXPECT: t 3
// EXPECT: 3 2 3 2

use std::fmt::Write;

#[effects(io, static, panic)]
fn inline(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        print("{i} {} {:>3}|", i, i);
        i += 1;
    }
    println("");
    i
}

#[effects(io, static, panic)]
fn to_stderr(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        print("e {} {i}|", i);
        eprint("{i}");
        i += 1;
    }
    println("");
    i
}

#[effects(alloc(Gpa), io, static, panic)]
fn written(n: i64, gpa: Gpa) -> i64 {
    let mut s = String::new_in(gpa);
    let mut i: i64 = 0;
    while i < n {
        write(s, "w {} {i}|", i).unwrap();
        i += 1;
    }
    println("{s}");
    i
}

#[effects(io, static, panic)]
fn through(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut t: i64 = 0;
    while i < n {
        let r = &i;
        t = t + *r;
        i += 1;
    }
    println("t {t}");
    i
}

fn main(gpa: Gpa) {
    let a = inline(3);
    let b = to_stderr(2);
    let c = inline(1) + 2;
    let d = written(2, gpa) + through(3) - 3;
    eprintln("");
    println("{a} {b} {c} {d}");
}
