// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map HashMap::with_capacity_in.
// EXPECT: 0 true
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let m: HashMap<i64, i64, Gpa, FixedState> = HashMap::with_capacity_in(10, gpa);
    println("{} {}", m.len(), m.capacity() >= 10);
}
