// (0.30.1) The sizes just below the limit, 2^61 bytes, are accepted and
// exact: an array, a struct of two arrays, an enum, a zero-sized array of
// usize::MAX elements and none of 2^60 bytes (0 bytes, as Rust's), all
// as types only.
// EXPECT: 2305843009213693951
// EXPECT: 2305843009213693951
// EXPECT: 1152921504606846984
// EXPECT: 0 0
struct Almost {
    a: [u8; 1usize << 60],
    b: [u8; (1usize << 60) - 1],
}

enum E<T> {
    Both(T),
    Neither,
}

fn main() {
    println("{}", std::mem::size_of::<[u8; (1usize << 61) - 1]>());
    println("{}", std::mem::size_of::<Almost>());
    println("{}", std::mem::size_of::<E<[u64; 1usize << 57]>>());
    println("{} {}", std::mem::size_of::<[(); usize::MAX]>(),
        std::mem::size_of::<[[u8; 1usize << 60]; 0]>());
}
