// XFAIL: gap 4: compile type error: the trait 'FromIteratorIn<(usize, D<Gpa>), Gpa>' is not implemented for 'Vec<(i64, D<Gp...
// sem-own: enumerate over owned items, collected: each dropped once with the Vec.
// EXPECT: n 2
// EXPECT: drop 0
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let w: Vec<(i64, D<Gpa>), Gpa> = (0i64..2i64).map(|i| mk(i, gpa)).enumerate().collect_in(gpa);
    println("n {}", w.len());
}
