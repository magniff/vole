// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::option Option<&T>::cloned.
// EXPECT: Some("ab")
use std::option::Option;

fn main(gpa: Gpa) {
    let s = "ab".to_string_in(gpa);
    let a: Option<&String<Gpa>> = Some(&s);
    let c: Option<String<Gpa>> = a.cloned();
    println("{:?}", c);
}
