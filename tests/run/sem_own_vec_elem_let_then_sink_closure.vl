// sem-own: `let x = w[0]; sink || x.id`: moves a borrow into a closure: own.move_out.
// (0.25, fix25e: moves::sink_borrowed_captures) refused: x is a borrow of
// the Vec's element, which a sink closure cannot take.
// ERROR: [own.move_out]: cannot move 'x' (D<Gpa>) into the sink closure: it is borrowed here (let)
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(mk(1, gpa));
    let x = w[0];
    let f = sink || x.id;
}
