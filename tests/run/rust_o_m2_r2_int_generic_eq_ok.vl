// (obligations M2 after the integer-variable merge) A program's
// `impl<T: PartialEq> PartialEq for W<T>` chosen for W<{integer}>: as
// rust_o_m2_r2_int_tuple_eq_ok. rustc prints true.
// EXPECT: true
struct W<T> {
    t: T,
}

impl<T: PartialEq> PartialEq for W<T> {
    fn eq(&self, o: &W<T>) -> bool {
        self.t == o.t
    }
}

fn main() {
    println("{}", W { t: 1 } == W { t: 1 });
}
