// XFAIL: RT-320: a `for<'a>` in a method's bound that shadows its impl's 'a is not refused: rustc E0496 (blocked on RT-207, `for<'a>` does not parse) (0.30.2)
// From g302tparam (F36.2 checks a function's own lifetimes against its
// impl's and trait's, but not a higher-ranked bound's); v0.30.1 too.
// rustc: error[E0496]: lifetime name `'a` shadows a lifetime name that is
// already in scope. Vole now: `expected type, got 'for'` (RT-207).
// ERROR: E0496
// ERROR-COUNT: 1
struct W<'a> {
    r: &'a i64,
}

impl<'a> W<'a> {
    fn m<F>(&self, f: F) -> i64
        where
            F: for < 'a > Fn(&'a i64) -> i64,
    {
        f(self.r)
    }
}

fn main() {
    let x = 5i64;
    let w = W { r: &x };
    println("{}", w.m(|v: &i64| *v + 1));
}
