// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::truncate.
// EXPECT: [1, 2] [1, 2]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3, 4], gpa);
    v.truncate(2);
    let a = v.clone();
    v.truncate(5);
    println("{:?} {:?}", a, v);
}
