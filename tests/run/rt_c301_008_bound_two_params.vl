// RULE: F8.3, F8.4
// RT-C301-8: two parameters bound by different traits, both S in the
// instance: `T::K` is A's, `U::K` B's, and so the calls. 0.30.1 printed
// 210202 (`T::K` B's). rustc prints 210201.
// EXPECT: 210201
trait A { const K: i64; fn m(&self) -> i64; }
trait B { const K: i64; fn m(&self) -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 10 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 20 } }
fn two<T: A, U: B>(t: &T, u: &U) -> i64 { T::K + U::K * 100 + T::m(t) * 1000 + U::m(u) * 10000 }
fn main() { println("{}", two(&S, &S)); }
