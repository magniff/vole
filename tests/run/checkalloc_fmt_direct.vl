// EDITION: rust
// XFAIL: gap 2: compile type error: undefined variable 'forget'
// FLAGS: --check-alloc
// EXPECT: 7! [7]
// STDERR: check-alloc: 2 blocks of Gpa not freed
// STDERR: allocated at
// STDERR: checkalloc_fmt_direct.vl:18:13
// STDERR: allocated at
// STDERR: checkalloc_fmt_direct.vl:20:5
// (0.17) The allocation sites of format_in and push_fmt with their
// f-string written in place (fmt_direct) are the calls', as when std's
// functions were called.

fn main(gpa: Gpa) {
    let n: i64 = 7;
    let mut b: String<Gpa> = String::new_in(gpa);
    let t = format_in("{n}!", gpa);
    // (no room: it grows)
    std::fmt::write(&mut b, "[{n}]").unwrap();
    println("{} {}", str::from_utf8(t.as_bytes()).unwrap(), str::from_utf8(b.as_bytes()).unwrap());
    // (0.17: both would drop; forgotten, they leak and show their sites)
    forget(t);
    forget(b);
}
