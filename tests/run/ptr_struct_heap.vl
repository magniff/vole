// EDITION: rust
// A heap-allocated linked list of structs built and walked through pointers.
// EXPECT: 385 10 100
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(n: u64) -> *mut u8;
}

#[derive(Clone, Copy)] struct Node { value: i64, next: *mut Node }

fn push(head: *mut Node, v: i64) -> *mut Node {
    let n = unsafe { malloc(16) as *mut Node };
    unsafe {
        (*n).value = v;
        (*n).next = head;
    }
    n
}

fn main() -> i64 {
    let null = 0 as *mut Node;
    let mut head = null;
    let mut i: i64 = 1;
    while i <= 10 {
        unsafe { head = push(head, i * i); }
        i += 1;
    }
    let mut sum: i64 = 0;
    let mut count: i64 = 0;
    let mut cur = head;
    while cur != null {
        unsafe { sum += (*cur).value; }
        count += 1;
        unsafe { cur = (*cur).next; }
    }
    unsafe { printf(c"%ld %ld %ld\n", sum, count, (*head).value); }
    0
}
