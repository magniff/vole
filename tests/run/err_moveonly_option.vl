// (0.25) An Option of a struct with an inout field is move-only.
struct C<'a> { n: &'a mut i64 }

fn main() {
    let mut x: i64 = 1;
    let o: Option<C<'_>> = Some(C { n: &mut x });
    let p = o;
    if let Some(c) = p { *c.n += 1; }
    if let Some(c) = o { *c.n += 1; }
    println("{x}");
}
