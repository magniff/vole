// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::fmt UpperHex::fmt.
// EXPECT: FF
use std::fmt::{Formatter, UpperHex};

struct W {
    v: u32,
}

impl UpperHex for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = UpperHex::fmt(&W { v: 255u32 }, &mut f);
    println("{}", s);
}
