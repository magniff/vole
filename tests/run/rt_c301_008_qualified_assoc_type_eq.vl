// RULE: F8.1, D22.1
// RT-C301-8: `<T as B>::Out` beside `<T as A>::Out` in a generic body,
// each bound with its equality: B's is bool. 0.30.1 passes it too: a
// guard for the Ω projections keyed by their trait (0.30.2). rustc
// prints true 8.
// EXPECT: true 8
trait A { type Out; fn get(&self) -> Self::Out; }
trait B { type Out; fn get(&self) -> Self::Out; }
struct S;
impl A for S { type Out = i64; fn get(&self) -> i64 { 7 } }
impl B for S { type Out = bool; fn get(&self) -> bool { true } }
fn f<T: A<Out = i64> + B<Out = bool>>(t: &T) -> bool { let b: <T as B>::Out = <T as B>::get(t); b }

fn g<T: A<Out = i64> + B<Out = bool>>(t: &T) -> i64 {
    let a: <T as A>::Out = <T as A>::get(t); a + 1
}

fn main() { println("{} {}", f(&S), g(&S)); }
