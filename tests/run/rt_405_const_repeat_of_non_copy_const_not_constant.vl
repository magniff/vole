// XFAIL: RT-405: a repeat of a constant that is not Copy, `const VV: [D; 2] = [DL; 2];` with `const DL: D = D { k: 1 };` and D: Drop, is refused, "expression is not a compile-time constant"; rustc accepts it (a path to a constant may be repeated) and prints the EXPECT lines (0.30.2)
// From the re-review of g302copy-148 (form pre/q2). Since v0.30.1 at
// least; the release build the same. rustc makes each element from the
// constant: `[VV; 2]` holds four D, and each is dropped at the end of
// main.
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: drop 1
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

const DL: D = D { k: 1 };
const VV: [D; 2] = [DL; 2];

fn main() {
    let a = [VV; 2];
    println("{}", a[1][1].k);
}
