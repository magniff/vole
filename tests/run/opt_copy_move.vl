// EDITION: rust
// EXPECT: 1498500
// (0.17) A move is a COPY_MOVE (middle/copies.vl): under --values=error,
// `let mut b = a` of an owned local leaves `a` unread until it is bound
// again, so the copy is elided in a loop too; only the copy of the array
// literal stays.
// CHECK: fn main:
// CHECK: callc memcpy
// CHECK-NOT: callc memcpy
// CHECK: ret
use std::alloc::Allocator; 

extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

struct Pack<A: Allocator> { items: Vec<i64, A>, pad: [i64; 20] }

fn main(gpa: Gpa) -> i32 {
    let mut total: i64 = 0;
    for k in 0..1000 {
        let mut a = Pack { items: Vec::new_in(gpa), pad: [0i64; 20] };
        a.pad[(k % 20) as usize] = k;
        let mut b = a;
        b.pad[((k + 3) % 20) as usize] = 2 * k;
        total += b.pad[(k % 20) as usize] + b.pad[((k + 3) % 20) as usize] + b.pad[((k + 7) % 20) as usize];
    }
    unsafe { printf(c"%ld\n", total); }
    0
}
