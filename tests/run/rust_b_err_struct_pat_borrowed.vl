// EDITION: rust
// RULE: F27.2
// (0.27.2) A struct pattern may not move a field out while it is
// borrowed (rustc E0505).
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 20, column 15
// ERROR-COUNT: 1
struct Tok {
    v: i64,
}

struct Two {
    a: Tok,
    n: i64,
}

fn main() {
    let s = Two { a: Tok { v: 1 }, n: 3 };
    let r = &s.a;
    let Two { a, .. } = s;
    println("{} {}", a.v, r.v);
}
