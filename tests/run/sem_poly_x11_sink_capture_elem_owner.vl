// a sink closure capturing an owned for-variable (a borrowed element)
// ERROR: [own.move_out]
fn main(gpa: Gpa) {
    var vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    var a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    vs.push(a);
    var t = 0;
    for x in vs { let c = sink || x.len(); t += c() as i64; }
    println("{t} {}", vs[0].len());
}
