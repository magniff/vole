// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::io Error::raw_os_error.
// EXPECT: Some(13) None
use std::io::{ErrorKind, self};

fn main() {
    let a = io::Error::from_raw_os_error(13);
    let b = io::Error::new(ErrorKind::Other, "x");
    println("{:?} {:?}", a.raw_os_error(), b.raw_os_error());
}
