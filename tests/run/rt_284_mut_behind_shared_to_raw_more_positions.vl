    p
}

fn arms(h: &H, c: bool, q: *mut i64) -> *mut i64 {
    let p: *mut i64 = if c { h.r } else { q };
    p
}

fn arm(h: &H) -> *mut i64 {
    let p: *mut i64 = match 0 {
        _ => h.r,
    };
    p
}

fn arg(h: &H) -> usize {
    takes(h.s)
}

fn elem(h: &H) -> [*mut i64; 1] {
    [h.r]
}

fn variant(h: &H) -> Option<*mut i64> {
