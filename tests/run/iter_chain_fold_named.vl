// XFAIL: gap 3: compile type error: the type 'inout fn(i64) -> i64' does not satisfy the bound 'F: FnOnce(i64) -> i64' of '...
// The sources' `fold` (0.14), counted loops, with named functions as
// the function argument (a fn type satisfies an FnMut bound), and map
// with one.
// EXPECT: fold 45 55 -10 6 330
// EXPECT: map 10 2 18 | 3 | 30
use std::collections::HashMap;

fn add(a: i64, b: i64) -> i64 {
    a + b
}

fn sub(a: i64, b: i64) -> i64 {
    a - b
}

fn add_entry(a: i64, e: (i64, i64)) -> i64 {
    a + e.0 * e.1
}

fn double(x: i64) -> i64 {
    x * 2
}

fn show(x: i64) {
    print(" ");
    print("{}", x);
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(1);
    v.push(9);
    v.push(3);
    v.push(7);
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(10, 3);
    m.insert(20, 15);
    print("fold");
    show((0i64..10i64).fold(0i64, add));
    show((1i64..=10i64).fold(0i64, add));
    show((1i64..=4i64).fold(0i64, sub));
    let mut it = v.iter().copied();
    it.next();
    it.next();
    show(it.fold(-13i64, add));
    show(m.iter().map(|(k, v)| (*k, *v)).fold(0i64, add_entry));
    println("");
    print("map");
    for x in v.iter().copied().take(3usize).map(double) {
        show(x);
    }
    print(" |");
    show(v.iter().copied().take(3usize).map(double).count() as i64);
    print(" |");
    show(v.iter().copied().take(3usize).map(double).sum::<i64>());
    println("");
    0
}
