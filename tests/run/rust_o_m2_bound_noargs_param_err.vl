// ERROR: the trait 'Tr' is not implemented for 'W'
// (RT-270) `T: Tr<i64>` does not give `T: Tr`, Tr<i32> (rustc E0277; v0.30.1 accepted it).
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

fn c<Z: Tr>(z: &Z) -> i64 {
    1
}

fn mid<T: Tr<i64>>(t: &T) -> i64 {
    c(t)
}

fn main() {
    println("{}", mid(&W { r: 0 }));
}
