// EDITION: rust
// RULE: D2.5
// (0.27.1) Two exclusive references to one place passed to one call (f's
// `&mut x, &mut x`: borrowck.mut_twice), and a shared and an exclusive one
// (g's `&v, &mut v`: borrowck.conflict). At v0.27.0 this program was
// accepted with borrowck.unchecked and miscompiled at -O2 by the
// parameters' alias facts (f: 1, g: 0 against -O0's 2 and 1); the
// checker rejects it, and a rust body gets those facts only when it is
// clean (borrowck.md D17.7).
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)
// ERROR: error[borrowck.mut_twice]
// ERROR: line 35, column 23
// ERROR: error[borrowck.conflict]
// ERROR: line 38, column 19
// ERROR-COUNT: 2
// Checked since bc271 M3.

#[inline(never)]
fn f(a: &mut i64, b: &mut i64) -> i64 {
    *a = 1;
    *b = 2;
    *a
}

#[inline(never)]
fn g(v: &Vec<i64, Gpa>, w: &mut Vec<i64, Gpa>) -> usize {
    let n0 = v.len();
    w.push(1);
    let n1 = v.len();
    n1 - n0
}

fn main(gpa: Gpa) -> i64 {
    let mut x = 0;
    let r = f(&mut x, &mut x);
    println("f: {r}");
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let d = g(&v, &mut v);
    println("g: {d}");
    0
}
