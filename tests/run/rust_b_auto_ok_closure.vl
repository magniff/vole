// EDITION: rust
// RULE: AT1, AT3
// (0.27.2) A closure is Send by its captures: by value, the captured type
// is Send; by reference, it is Sync. `F: FnOnce() -> T + Send` holds for
// both.
// EXPECT: 11 3
fn run<F: FnOnce() -> i64 + Send>(f: F) -> i64 {
    f()
}

fn main() {
    let x = 10;
    let y = 3;
    let a = run(move || x + 1);
    let b = run(|| y);
    println("{} {}", a, b);
}
