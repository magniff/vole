// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map VacantEntry::into_key.
// EXPECT: 5 0
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Entry;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let mut k = 0;
    if let Entry::Vacant(e) = m.entry(5) {
        k = e.into_key();
    }
    println("{} {}", k, m.len());
}
