// RULE: F18.5
// (0.30.2) A literal is checked against the type its variable takes, at
// the function's end: 300 where a u8 goes is an error (rustc's
// overflowing_literals, denied), wherever the use that types it is.
// ERROR: integer literal 300 does not fit in type 'u8'
fn take_u8(x: u8) -> u8 {
    x
}

fn main() {
    let a = 300;
    println("{}", take_u8(a));
}
