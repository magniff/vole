// RULE: F18.5
// (0.27.6) A later arm whose element is not an integer where the earlier
// arms gave an integer literal is an error at that element (rustc E0308,
// "expected integer, found `bool`").
// ERROR: error[type error]: expected 'i32', got 'bool'
// ERROR: line 11, column 18
fn main() {
    let gap: usize = 5;
    let p = match gap {
        0 => (gap, 0),
        _ => (1, true),
    };
    println("{}", p.0);
}
