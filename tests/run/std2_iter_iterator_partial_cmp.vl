// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::partial_cmp.
// EXPECT: Some(Less) None

fn main(gpa: Gpa) {
    let a = Vec::from_in([1.0f64, 2.0], gpa);
    let b = Vec::from_in([1.0f64, 3.0], gpa);
    let n = Vec::from_in([f64::NAN], gpa);
    println("{:?} {:?}", a.iter().partial_cmp(b.iter()), a.iter().partial_cmp(n.iter()));
}
