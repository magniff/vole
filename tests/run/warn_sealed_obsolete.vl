// 0.26.0: `#[sealed]` is every struct's rule now: accepted, with a
// warning whose try: line deletes it; the fields stay private.
// WARNING: warning[attr.obsolete]: '#[sealed]' is the default from 0.26: every field not marked 'pub' is private to its module
// WARNING: help: delete it (`volec fix --only obsolete-attr` deletes every one)
// WARNING: fix --only obsolete-attr
// EXPECT: 2
mod m {
    #[sealed]
    pub struct S { pub a: i64, b: i64 }

    pub fn s() -> S {
        S { a: 2, b: 3 }
    }
}

fn main() {
    println(f"{m::s().a}");
}
