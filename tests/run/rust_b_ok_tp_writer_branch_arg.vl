// RULE: D7.1
// (0.30.1) A writer's reservation is activated where it is first
// mentioned after it, in any block: an argument whose `if` or `&&` makes
// blocks between the reservation and the write still reads the writer
// in the reservation window, as rustc's two-phase autoref.
// EXPECT: [97, 49, 116, 114, 117, 101]
use std::io::Write;

fn main(gpa: Gpa) {
    let mut emsg: Vec<u8, Gpa> = Vec::new_in(gpa);
    emsg.push(b'a');
    let c = emsg.len() > 0;
    write(emsg, "{}", if c { emsg.len() } else { 0 }).unwrap();
    write(emsg, "{}", c && emsg.len() > 1).unwrap();
    println("{:?}", emsg);
}
