// The std2 item(s): std::collections::HashMap, HashSet.
// (0.29.0) The hasher is a map's last type argument, always written (no
// default: hash.default). The constructors say which, as Rust's: `new_in`
// and `with_capacity_in` are FixedState's, with the other arguments from
// the variable's type or from the type written whole in the path
// (`HashMap::<K, V, Gpa, FixedState>::new_in`, a pattern impl's function
// found by its instance); `with_hasher_in` takes any BuildHasher, and a
// function generic over the hasher takes either map.
// EXPECT: 2 2 1 1
// EXPECT: 3 3
// EXPECT: Some(20) Some(20) true
use std::collections::{HashMap, HashSet};
use std::hash::{BuildHasher, FixedState, SipHashState};

fn total<S: BuildHasher>(m: &HashMap<i64, i64, Gpa, S>) -> i64 {
    let mut n = 0;
    for (_, v) in m {
        n += *v;
    }
    n
}

fn main(gpa: Gpa) {
    let mut a: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let mut b = HashMap::<i64, i64, Gpa, FixedState>::with_capacity_in(8, gpa);
    let mut c = HashSet::<i64, Gpa, FixedState>::new_in(gpa);
    let mut d: HashSet<&str, Gpa, FixedState> = HashSet::with_capacity_in(4, gpa);
    let mut e: HashMap<i64, i64, Gpa, SipHashState> =
        HashMap::with_hasher_in(SipHashState::new(), gpa);
    let mut f = HashMap::with_hasher_in(FixedState::with_seed(7), gpa);
    for k in 0..2 {
        a.insert(k, k + 1);
        b.insert(k, k + 1);
        e.insert(k, k + 1);
        f.insert(k, k + 1);
    }
    c.insert(5);
    d.insert("x");
    println("{} {} {} {}", a.len(), b.len(), c.len(), d.len());
    println("{} {}", total(&a), total(&e));
    e.insert(9, 20);
    f.insert(9, 20);
    println("{:?} {:?} {}", e.get(&9), f.get(&9), a == b);
}
