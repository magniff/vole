// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::result Result::as_deref.
// EXPECT: Ok("hi") Err(1)
use std::result::Result;

fn main(gpa: Gpa) {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let s: Result<String<Gpa>, i64> = Ok("hi".to_string_in(gpa));
    let t: Result<String<Gpa>, i64> = Err(1);
    let r: Result<&str, &i64> = s.as_deref();
    println("{:?} {:?}", r, t.as_deref());
}
