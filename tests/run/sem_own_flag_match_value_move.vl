// sem-own: a match expression moving one of several owned locals, chosen at run time.
// EXPECT: got 2
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let c = mk(3, gpa);
    let k: i64 = 1;
    {
        let d = match k { 0 => a, 1 => b, _ => c };
        println("got {}", d.id);
    }
}
