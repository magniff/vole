// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters StepBy.
// EXPECT: [0, 3, 6]
use std::iter::StepBy;

fn main(gpa: Gpa) {
    let it: StepBy<std::ops::Range<i64>> = (0i64..8).step_by(3);
    let v: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?}", v);
}
