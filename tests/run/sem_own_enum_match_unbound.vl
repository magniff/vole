// EDITION: rust
// sem-own: matching with `_` binds nothing: the payload stays and is
// dropped with the enum at scope end, once.
// EXPECT: a
// EXPECT: end
// EXPECT: drop 5
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

enum E<A: Allocator> { A(D<A>), B(i64) }

fn main(gpa: Gpa) {
    let e = E::A(mk(5, gpa));
    match e {
        E::A(_) => println("a"),
        E::B(n) => println("b {n}"),
    }
    println("end");
}
