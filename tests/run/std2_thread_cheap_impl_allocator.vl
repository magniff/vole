// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::thread CHeap::impl Allocator.
// EXPECT: 0 1 4 9 16 25 36 49
use std::thread;

fn main() {
    let xs = [0i64, 1, 2, 3, 4, 5, 6, 7];
    thread::scope(|s| {
        let mut i = 0usize;
        while i < 8 {
            let h = s.spawn(move || xs[i] * xs[i]);
            print("{}", h.join().unwrap());
            if i < 7 {
                print(" ");
            }
            i += 1;
        }
    });
    println("");
}
