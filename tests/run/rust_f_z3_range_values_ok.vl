// RULE: Z3.1
// A range literal is std's ops type (Range, RangeInclusive by its
// constructor, RangeFrom, RangeTo, RangeToInclusive, RangeFull), `..b`,
// `a..` and `..` parse, `for i in 5..` runs through RangeFrom, and `sum`
// takes its S from the let's type (F18.1); Step's functions are called by
// the trait's path (F8.2).
// EXPECT: 1 4 2 3 3 6 10 18 [1, 2]
// EXPECT: true
use std::ops::{Range, RangeFrom, RangeFull, RangeInclusive, RangeTo, RangeToInclusive};

fn main(gpa: Gpa) {
    let a: Range<i64> = 1..4;
    let b: RangeInclusive<i64> = 1..=4;
    let c: RangeFrom<i64> = 2..;
    let d: RangeTo<i64> = ..3;
    let e: RangeToInclusive<i64> = ..=3;
    let _f: RangeFull = ..;
    let s: i64 = (1i64..4).sum();
    let t: i64 = (1i64..=4).sum();
    let mut n = 0;
    for i in 5.. {
        if i > 7 {
            break;
        }
        n += i;
    }
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    println("{} {} {} {} {} {} {} {} {:?}", a.start, b.end(), c.start, d.end, e.end, s, t, n,
        &v[..2]);
    println("{}", a.contains(&2));
}
