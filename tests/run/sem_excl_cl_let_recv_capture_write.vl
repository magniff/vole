// EDITION: rust
// a let receiver (owned) and a closure argument that reallocates it
// ERROR: error[borrowck.conflict]
use std::alloc::Allocator; struct S<A: Allocator> { v: Vec<i64, A> }
impl S<Gpa> { fn peek<F: FnMut()>(&self, mut w: F) -> i64 { let s = self.v.as_slice(); w(); s[0] } }

fn main(gpa: Gpa) {
    let mut s = S { v: Vec::new_in(gpa) }; s.v.push(1);
    let r = s.peek(|| { for i in 0..1000 { s.v.push(i); } }); println("{r}");
}
