// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::collections::hash_map Values::impl ExactSizeIterator.
// EXPECT: 2
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    m.insert(2, 2);
    println("{}", m.values().len());
}
