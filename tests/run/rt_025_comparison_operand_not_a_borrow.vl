// The same hole in a comparison: `s == { s.clear(); s.shrink_to_fit(); t }`
// is PartialEq::eq(&s, &{..}) in Rust, so the clear is E0502. Until
// 0.30.1 vole bound the left operand to a hidden `==l` copy of s's words
// with no borrow (places::build::rust_let_place), so both were accepted
// and read the freed block at -O0 --check-alloc. Now the hidden binding
// borrows s to the end of the comparison (hidden_borrow, D2.9).
// `s.as_str() == {..}` and `s.cmp(&{..})` were refused already.
//
// ERROR: error[borrowck.conflict]
// ERROR: line 18,
// ERROR: line 27,
use std::alloc::Allocator;

fn eq(gpa: Gpa) {
    let t = format_in("hello world, a long string {}", 1, gpa);
    let mut s = format_in("hello world, a long string {}", 1, gpa);
    let r = s == {
        s.clear();
        s.shrink_to_fit();
        t.clone()
    };
    println("{r}");
}

fn lt<A: Allocator + Clone>(t: &String<A>, mut s: String<A>) -> bool {
    s < {
        s.clear();
        s.shrink_to_fit();
        t.clone()
    }
}

fn main(gpa: Gpa) {
    eq(gpa);
    let t = format_in("hello world, a long string {}", 2, gpa);
    let s = format_in("hello world, a long string {}", 1, gpa);
    println("{}", lt(&t, s));
}
