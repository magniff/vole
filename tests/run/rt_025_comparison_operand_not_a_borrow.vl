// XFAIL: RT-25: a format argument that names a place is not a borrow: a later argument may free or move it, a use after free in safe code (open)
// The same hole in a comparison: `s == { s.clear(); s.shrink_to_fit(); t }`
// is PartialEq::eq(&s, &{..}) in Rust, so the clear is E0502. vole binds
// the left operand to a hidden `==l` copy of s's words with no borrow
// (the checker's `=`-named bindings, places::build::rust_let_place), so
// both are accepted and read the freed block at -O0 --check-alloc ("use
// after free: block #4 (54 bytes), allocated at ...:17:17, freed at
// ...:20:9"). `s.as_str() == {..}` and `s.cmp(&{..})` are refused as
// they should be.
// ERROR: error[borrowck.conflict]
// ERROR: line 19,
// ERROR: line 28,
use std::alloc::Allocator;

fn eq(gpa: Gpa) {
    let t = format_in("hello world, a long string {}", 1, gpa);
    let mut s = format_in("hello world, a long string {}", 1, gpa);
    let r = s == {
        s.clear();
        s.shrink_to_fit();
        t.clone()
    };
    println("{r}");
}

fn lt<A: Allocator + Clone>(t: &String<A>, mut s: String<A>) -> bool {
    s < {
        s.clear();
        s.shrink_to_fit();
        t.clone()
    }
}

fn main(gpa: Gpa) {
    eq(gpa);
    let t = format_in("hello world, a long string {}", 2, gpa);
    let s = format_in("hello world, a long string {}", 1, gpa);
    println("{}", lt(&t, s));
}
