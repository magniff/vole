// RULE: F8.4, F2.2
// RT-C301-8: bounds written in `where`, and a trait reached as a bound's
// supertrait: `<T as A>::m` with `T: Sub`, `Sub: A`; `T::K` through
// the supertrait. 0.30.1 refused the value. rustc prints 21 111 21.
// EXPECT: 21 111 21
trait A { const K: i64; fn m(&self) -> i64; }
trait B { const K: i64; fn m(&self) -> i64; }
trait Sub: A { fn s(&self) -> i64 { 5 } }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } }
impl Sub for S {}
fn w<T>(t: &T) -> i64 where T: A + B { <T as B>::m(t) * 10 + <T as A>::K }
fn sup<T: Sub>(t: &T) -> i64 { let f = <T as A>::m; f(t) * 100 + <T as A>::K * 10 + T::K }
fn sup2<T: Sub + B>(t: &T) -> i64 { <T as B>::K * 10 + <T as A>::m(t) }
fn main() { let s = S; println("{} {} {}", w(&s), sup(&s), sup2(&s)); }
