// RULE: E1.7 (0.30.1) `MIN / -1` panics at every level ("attempt to
// divide with overflow"): the call of a function whose division may
// overflow so is no nopanic call, and -O2 neither deletes its unused
// result nor merges it with an equal call (before 0.30.1 the effects gave
// `/` no panic, and the program printed `after`). Same output at every
// level.
// FLAGS: -O2
// STDERR: attempt to divide with overflow
// EXIT: 101
#[inline(never)]
fn quot(a: i64, b: i64) -> i64 {
    let mut q = a;
    q /= b;
    q
}

fn main() {
    // no arguments: m is -1
    let m = 0 - std::env::args().count() as i64;
    let _x = quot(i64::MIN, m);
    println("after");
}
