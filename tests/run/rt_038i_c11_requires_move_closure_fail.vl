// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c11_requires_move_closure_fail)
// RUSTC: none contract clauses are not Rust
// ERROR: a clause moves 's': a `requires` or an `ensures` reads its parameters and `result` in place, and the function still has them
// MUST FAIL: a move closure in the requires takes the parameter.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    requires {
    let g = move || s.v;
    g() > 0
}

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
