// EDITION: rust
// f(&v, v[0]): the element is copied before the inout access begins (two-phase, conventions.md §3): fine
fn add(a: &mut Vec<i64, Gpa>, b: i64) { a.push(b); }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(3);
    { let at_arg1 = v[0]; add(&mut v, at_arg1) }; println("{}", v.len());
}
// EXPECT: 2
