// RULE: F29.4
// (0.30.1) what `as` still makes of a reference: the same reference
// (`&x as &i64`), a shared one of an exclusive one (`m as &i64`), a raw
// pointer of its pointee (`&x as *const i64`, `&mut x as *mut i64`), and
// a raw pointer of another one (`p as *const u8`); a value converts with
// `*r as u64`.
// EXPECT: 5 6 7 true true
fn main() {
    let mut x: i64 = 5;
    let a = &x as &i64;
    let a0 = *a;
    let m = &mut x;
    *m += 1;
    let b = m as &i64;
    let b0 = *b;
    let c = *b as u64 + 1;
    let p = &x as *const i64;
    let q = &mut x as *mut i64;
    let r = p as *const u8;
    println("{} {} {} {} {}", a0, b0, c, p == q as *const i64, r as usize == p as usize);
}
