// Runs on std since 0.27.2's switch.
// The std item(s): std::iter Iterator::rposition.
// EXPECT: Some(3) Some(2) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 1, 2], gpa);
    println("{:?} {:?} {:?}", v.iter().rposition(|x| *x == 2), v.iter().rposition(|x| *x == 1),
        v.iter().rposition(|x| *x == 9));
}
