// RULE: F8.3, F14.1
// RT-C301-8: `T::c`, `T::K` with `T: Conv<i64>` are the items of S's impl
// of Conv<i64>, not of Conv<i32>, as values, constants and calls.
// rustc prints 832 352.
// EXPECT: 832 352
trait Conv<X> { const K: i64; fn c(&self) -> i64; fn mk() -> i64; }
struct S;
impl Conv<i32> for S { const K: i64 = 32; fn c(&self) -> i64 { 32 } fn mk() -> i64 { 320 } }
impl Conv<i64> for S { const K: i64 = 64; fn c(&self) -> i64 { 64 } fn mk() -> i64 { 640 } }
fn g<T: Conv<i64>>(t: &T) -> i64 { T::c(t) + T::mk() + T::K + <T as Conv<i64>>::K }
fn h<T: Conv<i32>>(t: &T) -> i64 { let f = T::c; f(t) + T::mk() }
fn main() { let s = S; println("{} {}", g(&s), h(&s)); }
