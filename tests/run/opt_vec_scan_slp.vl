fn main() {
    let mut b_u8: [u8; 16] = [0; 16];
    for i in 0..16 { b_u8[i] = ((i * 7919 + 13) % 97) as u8; }
    let mut a_u8: [u8; 16] = [0; 16];
    let mut acc_u8: u8 = 0;
    for _ in 0..3 { acc_u8 = lanes_u8(&mut a_u8, &b_u8, acc_u8); }
    println("lanes_u8 {} {}", acc_u8, hash_u8(&a_u8));
    for _ in 0..3 { acc_u8 = excl_u8(&mut a_u8, &b_u8, acc_u8); }
    println("excl_u8 {} {}", acc_u8, hash_u8(&a_u8));
    let mut b_i8: [i8; 16] = [0; 16];
    for i in 0..16 { b_i8[i] = ((i * 7919 + 13) % 97) as i8; }
    let mut a_i8: [i8; 16] = [0; 16];
    let mut acc_i8: i8 = 0;
    for _ in 0..3 { acc_i8 = lanes_i8(&mut a_i8, &b_i8, acc_i8); }
    println("lanes_i8 {} {}", acc_i8, hash_i8(&a_i8));
    for _ in 0..3 { acc_i8 = excl_i8(&mut a_i8, &b_i8, acc_i8); }
    println("excl_i8 {} {}", acc_i8, hash_i8(&a_i8));
    let mut b_u16: [u16; 8] = [0; 8];
    for i in 0..8 { b_u16[i] = ((i * 7919 + 13) % 97) as u16; }
    let mut a_u16: [u16; 8] = [0; 8];
    let mut acc_u16: u16 = 0;
    for _ in 0..3 { acc_u16 = lanes_u16(&mut a_u16, &b_u16, acc_u16); }
    println("lanes_u16 {} {}", acc_u16, hash_u16(&a_u16));
    for _ in 0..3 { acc_u16 = excl_u16(&mut a_u16, &b_u16, acc_u16); }
    println("excl_u16 {} {}", acc_u16, hash_u16(&a_u16));
    let mut b_i16: [i16; 8] = [0; 8];
    for i in 0..8 { b_i16[i] = ((i * 7919 + 13) % 97) as i16; }
    let mut a_i16: [i16; 8] = [0; 8];
    let mut acc_i16: i16 = 0;
    for _ in 0..3 { acc_i16 = lanes_i16(&mut a_i16, &b_i16, acc_i16); }
    println("lanes_i16 {} {}", acc_i16, hash_i16(&a_i16));
    for _ in 0..3 { acc_i16 = excl_i16(&mut a_i16, &b_i16, acc_i16); }
    println("excl_i16 {} {}", acc_i16, hash_i16(&a_i16));
    let mut b_u32: [u32; 4] = [0; 4];
    for i in 0..4 { b_u32[i] = ((i * 7919 + 13) % 97) as u32; }
    let mut a_u32: [u32; 4] = [0; 4];
    let mut acc_u32: u32 = 0;
    for _ in 0..3 { acc_u32 = lanes_u32(&mut a_u32, &b_u32, acc_u32); }
    println("lanes_u32 {} {}", acc_u32, hash_u32(&a_u32));
    for _ in 0..3 { acc_u32 = excl_u32(&mut a_u32, &b_u32, acc_u32); }
    println("excl_u32 {} {}", acc_u32, hash_u32(&a_u32));
    let mut b_i32: [i32; 4] = [0; 4];
    for i in 0..4 { b_i32[i] = ((i * 7919 + 13) % 97) as i32; }
    let mut a_i32: [i32; 4] = [0; 4];
    let mut acc_i32: i32 = 0;
    for _ in 0..3 { acc_i32 = lanes_i32(&mut a_i32, &b_i32, acc_i32); }
    println("lanes_i32 {} {}", acc_i32, hash_i32(&a_i32));
    for _ in 0..3 { acc_i32 = excl_i32(&mut a_i32, &b_i32, acc_i32); }
    println("excl_i32 {} {}", acc_i32, hash_i32(&a_i32));
    let mut b_u64: [u64; 2] = [0; 2];
    for i in 0..2 { b_u64[i] = ((i * 7919 + 13) % 97) as u64; }
    let mut a_u64: [u64; 2] = [0; 2];
    let mut acc_u64: u64 = 0;
    for _ in 0..3 { acc_u64 = lanes_u64(&mut a_u64, &b_u64, acc_u64); }
    println("lanes_u64 {} {}", acc_u64, hash_u64(&a_u64));
    for _ in 0..3 { acc_u64 = excl_u64(&mut a_u64, &b_u64, acc_u64); }
    println("excl_u64 {} {}", acc_u64, hash_u64(&a_u64));
    let mut b_i64: [i64; 2] = [0; 2];
    for i in 0..2 { b_i64[i] = ((i * 7919 + 13) % 97) as i64; }
    let mut a_i64: [i64; 2] = [0; 2];
    let mut acc_i64: i64 = 0;
    for _ in 0..3 { acc_i64 = lanes_i64(&mut a_i64, &b_i64, acc_i64); }
    println("lanes_i64 {} {}", acc_i64, hash_i64(&a_i64));
    for _ in 0..3 { acc_i64 = excl_i64(&mut a_i64, &b_i64, acc_i64); }
    println("excl_i64 {} {}", acc_i64, hash_i64(&a_i64));
    let mut b_f32: [f32; 4] = [0.0; 4];
    for i in 0..4 { b_f32[i] = ((i * 7919 + 13) % 97) as f32; }
    let mut a_f32: [f32; 4] = [0.0; 4];
    let mut acc_f32: f32 = 0.0;
    for _ in 0..3 { acc_f32 = lanes_f32(&mut a_f32, &b_f32, acc_f32); }
    println("lanes_f32 {} {}", acc_f32, hash_f32(&a_f32));
    for _ in 0..3 { acc_f32 = excl_f32(&mut a_f32, &b_f32, acc_f32); }
    println("excl_f32 {} {}", acc_f32, hash_f32(&a_f32));
    let mut b_f64: [f64; 2] = [0.0; 2];
    for i in 0..2 { b_f64[i] = ((i * 7919 + 13) % 97) as f64; }
    let mut a_f64: [f64; 2] = [0.0; 2];
    let mut acc_f64: f64 = 0.0;
    for _ in 0..3 { acc_f64 = lanes_f64(&mut a_f64, &b_f64, acc_f64); }
    println("lanes_f64 {} {}", acc_f64, hash_f64(&a_f64));
    for _ in 0..3 { acc_f64 = excl_f64(&mut a_f64, &b_f64, acc_f64); }
    println("excl_f64 {} {}", acc_f64, hash_f64(&a_f64));
}
