// RT-61's family (0.30.2), straight-line code (the SLP vectorizer): one
// vector's lanes, each the running value after (and before) its update.
// A lane that reads another lane's new value is not packed; the output is
// rustc's.
// EXPECT: lanes_u8 235 9152656601082258694
// EXPECT: excl_u8 192 7853064692509911381
// EXPECT: lanes_i8 -21 1274494961623229702
// EXPECT: excl_i8 -64 13801636948946291029
// EXPECT: lanes_u16 1155 6828117384461362351
// EXPECT: excl_u16 1262 13836818486214397228
// EXPECT: lanes_i16 1155 6828117384461362351
// EXPECT: excl_i16 1262 13836818486214397228
// EXPECT: lanes_u32 399 2301703904407738060
// EXPECT: excl_u32 484 11622351465645432163
// EXPECT: lanes_i32 399 2301703904407738060
// EXPECT: excl_i32 484 11622351465645432163
// EXPECT: lanes_u64 264 189000831
// EXPECT: excl_u64 334 264001053
// EXPECT: lanes_i64 264 189000831
// EXPECT: excl_i64 334 264001053
// EXPECT: lanes_f32 399 2301703904407738060
// EXPECT: excl_f32 798 923876369232168933
// EXPECT: lanes_f64 264 189000831
// EXPECT: excl_f64 528 440001773
#[inline(never)]
fn lanes_u8(a: &mut [u8; 16], b: &[u8; 16], start: u8) -> u8 {
    let mut acc = start;
    acc = acc.wrapping_add(b[0]);
    a[0] = acc;
    acc = acc.wrapping_add(b[1]);
    a[1] = acc;
    acc = acc.wrapping_add(b[2]);
    a[2] = acc;
    acc = acc.wrapping_add(b[3]);
    a[3] = acc;
    acc = acc.wrapping_add(b[4]);
    a[4] = acc;
    acc = acc.wrapping_add(b[5]);
    a[5] = acc;
    acc = acc.wrapping_add(b[6]);
    a[6] = acc;
    acc = acc.wrapping_add(b[7]);
    a[7] = acc;
    acc = acc.wrapping_add(b[8]);
    a[8] = acc;
    acc = acc.wrapping_add(b[9]);
    a[9] = acc;
    acc = acc.wrapping_add(b[10]);
    a[10] = acc;
    acc = acc.wrapping_add(b[11]);
    a[11] = acc;
    acc = acc.wrapping_add(b[12]);
    a[12] = acc;
    acc = acc.wrapping_add(b[13]);
    a[13] = acc;
    acc = acc.wrapping_add(b[14]);
    a[14] = acc;
    acc = acc.wrapping_add(b[15]);
    a[15] = acc;
    acc
}

#[inline(never)]
fn excl_u8(a: &mut [u8; 16], b: &[u8; 16], start: u8) -> u8 {
    let mut acc = start;
    a[0] = acc;
    acc = acc ^ b[0];
    a[1] = acc;
    acc = acc ^ b[1];
    a[2] = acc;
    acc = acc ^ b[2];
    a[3] = acc;
    acc = acc ^ b[3];
    a[4] = acc;
    acc = acc ^ b[4];
    a[5] = acc;
    acc = acc ^ b[5];
    a[6] = acc;
    acc = acc ^ b[6];
    a[7] = acc;
    acc = acc ^ b[7];
    a[8] = acc;
    acc = acc ^ b[8];
    a[9] = acc;
    acc = acc ^ b[9];
    a[10] = acc;
    acc = acc ^ b[10];
    a[11] = acc;
    acc = acc ^ b[11];
    a[12] = acc;
    acc = acc ^ b[12];
    a[13] = acc;
    acc = acc ^ b[13];
    a[14] = acc;
    acc = acc ^ b[14];
    a[15] = acc;
    acc = acc ^ b[15];
    acc
}

fn hash_u8(a: &[u8]) -> u64 {
    let mut h: u64 = 0;
    for i in 0..a.len() {
        h = h.wrapping_mul(1000003).wrapping_add(a[i] as u64);
    }
    h
}

