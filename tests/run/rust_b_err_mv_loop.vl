struct N {
    v: i64,
}

fn eat(n: N) -> i64 {
    n.v
}

fn main() {
    let n = N { v: 1 };
    let mut i = 0;
    while i < 2 {
        let k = eat(n);
        println("{}", k);
        i += 1;
    }
}
