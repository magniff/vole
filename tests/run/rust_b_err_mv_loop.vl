// RULE: D8.3
// (0.27.1) M5: a move in a loop, used again in the next iteration.
// ERROR: error[borrowck.use_moved]
// ERROR: line 20, column 21
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct N {
    v: i64,
}

fn eat(n: N) -> i64 {
    n.v
}

fn main() {
    let n = N { v: 1 };
    let mut i = 0;
    while i < 2 {
        let k = eat(n);
        println("{}", k);
        i += 1;
    }
}
