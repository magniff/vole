// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept (the temporary lives as long as r) or reject: a view of a temporary argument
// (0.28.0) The rust edition drops the temporary at the end of its
// statement, as rustc does (E0716 at the same lines): its view is an error.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 13, column 17
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 14, column 17
#[derive(Clone, Copy)] struct E { name: [u8; 4], len: i64 }
fn nm(e: &E) -> &[u8] { &e.name[..e.len as usize] }
fn mk(c: u8) -> E { E { name: [c, c, c, c], len: 4 } }

fn main() -> i32 {
    let r = nm(&mk(b'a'));
    let q = nm(&mk(b'b'));
    println("{r} {q}", r = str::from_utf8(r).unwrap(), q = str::from_utf8(q).unwrap());
    0
}
