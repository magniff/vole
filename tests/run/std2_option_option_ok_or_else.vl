// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::ok_or_else.
// EXPECT: Ok(3) Err(5)
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b: Option<i64> = None;
    let r1: Result<i64, i64> = a.ok_or_else(|| 5);
    let r2: Result<i64, i64> = b.ok_or_else(|| 5);
    println("{:?} {:?}", r1, r2);
}
