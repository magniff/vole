// RULE: D19.1, D19.10
// (0.30.2, RT-91) Three `flat_map`s deep, the innermost closure
// capturing the outer two's references: rustc refuses it (a captured
// variable escapes the FnMut closure body), and so does vole once the
// X_C are made in order (0.30.1: a compiler panic, places/regions.vl).
// ERROR: error[borrowck.outlives]: captured variable cannot escape `FnMut` closure body
// ERROR-COUNT: 1
fn main() {
    let a = [1i64, 2];
    let b = [3i64, 4];
    let c = [5i64, 6];
    let s: i64 = a
        .iter()
        .flat_map(|x| b.iter().flat_map(move |y| c.iter().map(move |z| x * y * z)))
        .sum();
    println("{s}");
}
