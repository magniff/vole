// Eq's eq is #[pure]: an impl that reads a static var is rejected.
// ERROR: 'V::eq' implements 'PartialEq::eq', which is #[pure], but it touches a static mut or a C static (static)
static mut CALLS: i64 = 0;
#[derive(Clone, Copy)] struct V { n: i64 }

impl PartialEq for V {
    fn eq(&self, o: &V) -> bool { unsafe { CALLS += 1; } self.n == o.n }
} impl Eq for V {}

fn main() -> i32 {
    println("{}", V { n: 1 } == V { n: 2 });
    0
}
