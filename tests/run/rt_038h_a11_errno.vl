// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a11_errno)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which touches a static
// A callee writes errno through the pointer an extern function returns.
extern "C" {
    fn __error() -> *mut i32;
}

fn poke() -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *__error() = 77; }
    true
}

fn f(n: i64) -> i64
    requires poke()
{
    n
}

fn main() {
    println("{}", f(1));
    // UNSAFE: test
    // SAFETY: test
    println("{}", unsafe { *__error() });
}
