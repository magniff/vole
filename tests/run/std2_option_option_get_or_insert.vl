// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::option Option::get_or_insert.
// EXPECT: 3 Some(3) Some(7)
use std::option::Option;

fn main() {
    let mut a: Option<i64> = None;
    let x = *a.get_or_insert(3);
    let mut b: Option<i64> = Some(7);
    b.get_or_insert(3);
    println("{} {:?} {:?}", x, a, b);
}
