// XFAIL: RT-C301-3: a caller's type parameter with the name of a called method's own is taken for it (0.30.2)
// `go<X: Tr>` calls `x.pick(7i64)` of `fn pick<X: Copy>(&self, a: X) ->
// X`: the method's X is i64. rustc accepts and prints 7. vole (0.30.0
// too) reports "the trait 'Copy' is not implemented for 'X'", the
// method's bound checked against the caller's X.
// EXPECT: 7
trait Tr {
    fn pick<X: Copy>(&self, a: X) -> X;
}

struct S;

impl Tr for S {
    fn pick<X: Copy>(&self, a: X) -> X {
        a
    }
}

fn go<X: Tr>(x: &X) -> i64 {
    x.pick(7i64)
}

fn main() {
    println("{}", go(&S));
}
