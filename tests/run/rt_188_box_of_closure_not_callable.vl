// XFAIL: RT-188: a Box of a closure (not dyn) is not callable and not Fn: `b(2)` and `twice(b, 1)` with `b = Box::new_in(c, gpa)` are refused (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_019_box_of_closure_not_callable.rs.txt):
// std's `impl<F: Fn> Fn for Box<F>` (FnMut, FnOnce the same). vole: `(*b)(2)` and
// `twice(&*b, 1)` work, `b(2)` is `cannot call non-function type 'Box<closure(i64)
// -> i64 at ..>, Gpa>'` (line 9) and `twice(b, 1)` does not satisfy 'F: Fn(i64) ->
// i64' (line 11); a Box of an `impl Fn` value is the same. Since v0.28.0.
// EXPECT: 6
// EXPECT: 6
// EXPECT: 9
// EXPECT: 9
fn twice<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 {
    f(f(x))
}

fn main(gpa: Gpa) {
    let c = move |x: i64| x * 3;
    let b = Box::new_in(c, gpa);
    println("{}", (*b)(2));
    println("{}", b(2));
    println("{}", twice(&*b, 1));
    println("{}", twice(b, 1));
}
