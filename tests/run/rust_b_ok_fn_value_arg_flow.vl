// EDITION: rust
// RULE: D3.6, R6
// (0.27.2) The arguments of a call through a `fn` value are related, and
// a value stored through one lives as long as the reference it is stored
// into: `v` outlives every read of `*r`, so the store is accepted.
// EXPECT: 2 3
fn store(x: &mut &i64, y: &i64) {
    let _ = y;
    let _ = x;
}

fn bump(x: &mut i64, y: &i64) {
    *x = *x + *y;
}

fn main() {
    let f: fn(&mut &i64, &i64) = store;
    let g: fn(&mut i64, &i64) = bump;
    let a = 1;
    let v = 2;
    let mut p: &i64 = &a;
    let r = &mut p;
    f(&mut *r, &v);
    *r = &v;
    let mut n = 1;
    {
        let w = 2;
        g(&mut n, &w);
    }
    println("{} {}", **r, n);
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
