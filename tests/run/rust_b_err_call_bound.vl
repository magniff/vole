fn tie<'a, 'b: 'a>(x: &mut &'a i64, y: &'b i64) {
    *x = y;
}

fn main() {
    let a: i64 = 1;
    let mut r = &a;
    {
        let b: i64 = 2;
        tie(&mut r, &b);
    }
    println("{}", *r);
}
