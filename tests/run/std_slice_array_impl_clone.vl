// The std item(s): std::slice [T; N]::impl Clone; [T; N]::impl PartialEq; [T; N]::impl PartialOrd; [T; N]::impl Ord; [T; N]::impl Debug; &[T; N]::impl IntoIterator; &mut [T; N]::impl IntoIterator.
// EXPECT: 6 [30, 10, 20] true false Less
// EXPECT: Board { cells: [1, 2, 3], names: [Name(7), Name(8)] } true true
#[derive(Clone, Debug, PartialEq)]
struct Name(i64);

#[derive(Clone, Debug, PartialEq)]
struct Board {
    cells: [i64; 3],
    names: [Name; 2],
}

fn main(gpa: Gpa) {
    let mut a = [3i64, 1, 2];
    let mut sum = 0;
    for x in &a {
        sum += *x;
    }
    for x in &mut a {
        *x *= 10;
    }
    let b = a.clone();
    println("{} {:?} {} {} {:?}", sum, b, a == b, a == [30i64, 10, 21], [1i64, 2].cmp(&[1i64, 3]));
    let s = Board { cells: [1, 2, 3], names: [Name(7), Name(8)] };
    let t = s.clone();
    println("{:?} {} {}", t, s == t, [1i64, 2] < [1i64, 3]);
}
