// RULE: D2.5
// (0.27.1) `&x` while `&mut x` is live: a shared borrow against a mutable
// loan (rustc E0502).
// ERROR: error[borrowck.conflict]
// ERROR: line 12, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let m = &mut x;
    let r = &x;
    *m += 1;
    println("{}", *r);
}
