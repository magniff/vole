// Runs on std since 0.27.2's switch.
// The std item(s): std::fmt Formatter::write_str.
// EXPECT: [ab]
use std::fmt::{Display, Formatter};

struct S;

impl Display for S {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.write_str("ab")
    }
}

fn main() {
    println("[{:8}]", S);
}
