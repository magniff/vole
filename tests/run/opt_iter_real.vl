// CHECK: fn main:

#[inline(never)]
fn kernel(v: &Vec<i64, Gpa>) -> i64 {
    v.iter().copied().map(|x| x * 3).sum::<i64>()
}

#[inline(never)]
fn hand(v: &Vec<i64, Gpa>) -> i64 {
    let s = v.as_slice();
    let mut t: i64 = 0;
    for k in 0..s.len() {
        t += s[k] * 3;
    }
    t
}

// `for` over a chain: `next`, not `fold`
#[inline(never)]
fn take_sum(v: &Vec<i64, Gpa>, n: usize) -> i64 {
    let mut t: i64 = 0;
    for x in v.iter().copied().take(n) {
        t += x;
    }
    t
}

// filter, zip, enumerate, count
#[inline(never)]
fn chains(v: &Vec<i64, Gpa>, w: &Vec<i64, Gpa>) -> i64 {
    let a = v.iter().copied().filter(|x| ({ let x = *x; x % 2 == 0 })).count();
    let b = v.iter().copied().zip(w.iter().copied()).map(|(x, y)| x * y).sum::<i64>();
    let c = v.iter().copied().enumerate().map(|(i, x)| i * x).sum::<i64>();
    let d = v.iter().copied().filter(|x| ({ let x = *x; x % 2 == 0 })).map(|x| x * 2).sum::<i64>();
    a as i64 + b + c + d
}

// max: one `next`, then a fold whose accumulator is plain
#[inline(never)]
fn max_fold(v: &Vec<i64, Gpa>, k: i64) -> i64 {
    v.iter().copied().map(|x| (x * k) % 101).max().unwrap()
}

// six capturing maps
#[inline(never)]
fn deep(v: &Vec<i64, Gpa>, a: i64) -> i64 {
    let b = a + 1;
    let c = a + 2;
    v.iter().copied().map(|x| x + a).map(|x| x + b).map(|x| x - c).map(|x| x * 2).map(|x| x + a)
        .map(|x| x - a).sum::<i64>()
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
        w.push(i % 7);
    }
    print("{}", kernel(&v));
    print(" ");
    print("{}", hand(&v));
    println("");
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..1000 {
        u.push(i);
    }
    print("{}", take_sum(&u, 500));
    print(" ");
    print("{}", (take_sum(&u, 5000) + take_sum(&u, 1) + take_sum(&u, 0)));
    println("");
    let a = v.iter().copied().sum::<i64>();
    let b = v.iter().copied().filter(|x| ({ let x = *x; x % 2 == 0 })).sum::<i64>();
    let c = v.iter().copied().enumerate().map(|(i, x)| i * x).sum::<i64>();
    let d = v.iter().copied().zip(w.iter().copied()).count() * 99;
    print("{}", a);
    print(" ");
    print("{}", b);
    print(" ");
    print("{}", c);
    print(" ");
    print("{}", (d as i64));
    println("");
    print("{}", max_fold(&v, 3));
    print(" ");
    print("{}", chains(&v, &w));
    println("");
    print("{}", deep(&v, 7));
    println("");
    0
}
