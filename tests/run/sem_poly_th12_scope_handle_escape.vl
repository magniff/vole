// a scoped thread's handle returned out of the scope, joined after it
// ERROR: [sync.
use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(9);
    let s = v.as_slice();
    let h = thread::scope(|s| ({ let sc = s; sc.spawn(|| s[0]) }));
    println("{}", h.join().unwrap());
}
