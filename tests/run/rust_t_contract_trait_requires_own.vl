// EDITION: rust
// RULE: C7.6
// (0.27.2.1) A trait method's `requires` is checked for every impl, at a
// call through a bound, and the impl's own after it (C7.1: req_eff =
// req(Tr::m) ++ req(I::m)), with the impl's parameter names.
// EXPECT: 1
// EXIT: 101
// STDERR: requires failed: 'j < self.n' of 'S::pick'
trait Pick {
    fn pick(&self, i: i64) -> i64
        requires i >= 0;
}

struct S {
    n: i64,
}

impl Pick for S {
    fn pick(&self, j: i64) -> i64
        requires j < self.n
    {
        j
    }
}

fn use_it<T: Pick>(t: &T, i: i64) -> i64 {
    t.pick(i)
}

fn main() {
    let s = S { n: 3 };
    println("{}", use_it(&s, 1));
    println("{}", use_it(&s, 5));
}
