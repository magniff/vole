// (obligations M2, after the merge with RT-211's cases) An impl's `where i64: Conv<Self>`,
// Self in a bound of a predicate on another subject: the impl's type, as in
// the subject (M2 resolved the subject with Self bound and the bound without:
// "unknown type 'Self'"). rustc prints 6.
// EXPECT: 6
trait Conv<X> {
    fn c(&self) -> i64;
}

trait Tr {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Conv<W> for i64 {
    fn c(&self) -> i64 {
        5
    }
}

impl Tr for W
    where
        i64: Conv<Self>,
{
    fn g(&self) -> i64 {
        3i64.c() + self.r
    }
}

fn main() {
    println("{}", W { r: 1 }.g());
}
