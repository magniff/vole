// XFAIL: RT-25 (rest): a format_args value kept past its statement holds a copy of each hole's place, with no region (open)
// RULE: D2.9
// (0.30.1) rustc's `let b = format_args!("{}", t);` keeps `&t` in b (the
// format_args temporaries are extended to the `let`), so `drop(t)` while
// b is live is E0505. vole's `format_args("{}", t)` is an `Interp` whose
// closure captures the hole's copy of t's words; the closure's type has
// no region to tie it to t, so the drop is accepted and the print reads
// the freed block (-O0 --check-alloc: "use after free"). The fix is a
// hole closure that captures `&t` (a region in the Interp's type).
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 16, column 10
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let t = format_in("abcdefghijklmnopqrstuvwxyz {}", 6, gpa);
    let b = format_args("{}", t);
    drop(t);
    println("{}", b);
}
