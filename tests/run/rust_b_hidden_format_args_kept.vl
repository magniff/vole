// RULE: D2.9
// (0.30.1) rustc's `let b = format_args!("{}", t);` keeps `&t` in b (the
// format_args temporaries are extended to the `let`), so `drop(t)` while
// b is live is E0505. vole's `format_args("{}", t)` is an `Interp` whose
// closure captured a copy of t's words with no region to tie it to t:
// the drop was accepted and the print read the freed block. Now a hole
// that is a place owning memory is bound to its borrow, `let =f0 = &t`,
// which the closure captures (front/check/interp.vl hole_by_ref): the
// value's region keeps t borrowed while it lives. The second program is
// the same in one statement: the value is an argument and a later
// argument moves t.
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 20, column 10
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 31, column 14
// ERROR-COUNT: 2
fn main(gpa: Gpa) {
    let t = format_in("abcdefghijklmnopqrstuvwxyz {}", 6, gpa);
    let b = format_args("{}", t);
    drop(t);
    println("{}", b);
}

fn show<A: std::fmt::Display>(a: A, n: i64) {
    println("{a} {n}");
}

fn in_one_statement(gpa: Gpa) {
    let s = format_in("abcdefghijklmnopqrstuvwxyz {}", 1, gpa);
    show(format_args("{}", s), {
        drop(s);
        0
    });
}
