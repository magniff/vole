// sem-own: a `return` inside a match arm after binding the payload: the binding and the other locals dropped once.
// EXPECT: drop 5
// EXPECT: drop 1
// EXPECT: r 5
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
enum E<A: Allocator> { A(D<A>), N }

fn f(e: sink E<Gpa>, gpa: Gpa) -> i64 {
    let a = mk(1, gpa); match e { E::A(d) => { return d.id; }, E::N => {} } 0
}

fn main(gpa: Gpa) {
    println("r {}", f(E::A(mk(5, gpa)), gpa));
}
