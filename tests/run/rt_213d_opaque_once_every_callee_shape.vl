// RULE: D21.6 (0.30.2, RT-213) An `impl FnOnce` value is called as its
// bound says, whatever its hidden closure is (here `move || k`, which
// captures a Copy i64 and is Copy itself): a call consumes it, through
// every callee shape: a local, a struct field, a tuple field, an element,
// a binding it was moved to, a closure that calls it. rustc: E0382 (used
// after a move), E0508 (moved out of an array). 0.30.2's first try took
// the call kind from the hidden closure and accepted each. (k19, k20,
// k21, k25, k27, k28 of the review of the opaque-type work)
// ERROR: line 26
// ERROR: line 31
// ERROR: line 36
// ERROR: line 41
// ERROR: line 47
// ERROR: line 54
// ERROR-COUNT: 6
fn once_cap(k: i64) -> impl FnOnce() -> i64 {
    move || k
}

struct H<F> {
    f: F,
}

fn local() -> i64 {
    let g = once_cap(1);
    g() + g() // error here
}

fn field() -> i64 {
    let h = H { f: once_cap(2) };
    (h.f)() + (h.f)() // error here
}

fn tuple_field() -> i64 {
    let t = (once_cap(3), 2);
    (t.0)() + (t.0)() // error here
}

fn element() -> i64 {
    let a = [once_cap(4)];
    (a[0])() // error here
}

fn moved_to() -> i64 {
    let g = once_cap(5);
    let a = g();
    let h = g; // error here
    a + h()
}

fn in_closure() -> i64 {
    let g = once_cap(6);
    let h = || g();
    h() + h() // error here
}

fn main() {
    println("{} {} {}", local(), field(), tuple_field());
    println("{} {} {}", element(), moved_to(), in_closure());
}
