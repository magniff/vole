// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::str str::split.
// EXPECT: ["Mary", "had", "a", "little", "lamb"] [""]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "Mary had a little lamb".split(' ').collect_in(gpa);
    let e: Vec<&str, Gpa> = "".split('x').collect_in(gpa);
    println("{:?} {:?}", v, e);
}
