// RT-325 (fixed in 0.30.2 by qualified::path_trait, which decides the trait a path names): `let b: S = Mk2::mk()` runs Mk's mk (wrong code): a trait path call whose Self comes from the expected type takes the first trait's function by its name (0.30.2)
// Since v0.30.1 at least: v0.30.1 and the release branch print `1 1`.
// The g302qual branch prints `1 2` (path_trait decides the trait the path
// names), so this case passes once it merges. rustc builds it and prints
// the EXPECT line. (The review's form f43, its call part.)
// EXPECT: 1 2
trait Mk { fn mk() -> Self; }
trait Mk2 { fn mk() -> Self; }
struct S { v: i64 }
impl Mk for S { fn mk() -> S { S { v: 1 } } }
impl Mk2 for S { fn mk() -> S { S { v: 2 } } }
fn main() { let a: S = Mk::mk(); let b: S = Mk2::mk(); println("{} {}", a.v, b.v); }
