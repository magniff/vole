// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Bytes::impl DoubleEndedIterator.
// EXPECT: 99 97 98 None
use std::str::CharIndices;

fn main() {
    let mut b = "abc".bytes();
    let z = b.next_back().unwrap();
    let x = b.next().unwrap();
    let y = b.next_back().unwrap();
    println("{} {} {} {:?}", z, x, y, b.next());
}
