// std::cli (0.25.2): Arg::global, a flag or option of a command that its
// subcommands accept at any depth, before or after their names; every
// level's Matches reads it (and counts it over all levels); a required
// one is reported at the end, about the last command; its did-you-mean;
// a subcommand's help lists it.
// EXPECT: $ vc --user u --root a remote add
// EXPECT:   level 0: root=a verbose=0
// EXPECT:   -> remote
// EXPECT:   level 1: root=a verbose=0
// EXPECT:   -> add
// EXPECT:   level 2: root=a verbose=0
// EXPECT: $ vc remote --root b add --user u
// EXPECT:   level 0: root=b verbose=0
// EXPECT:   -> remote
// EXPECT:   level 1: root=b verbose=0
// EXPECT:   -> add
// EXPECT:   level 2: root=b verbose=0
// EXPECT: $ vc -v remote -v add -R c -v --user u
// EXPECT:   level 0: root=c verbose=3
// EXPECT:   -> remote
// EXPECT:   level 1: root=c verbose=3
// EXPECT:   -> add
// EXPECT:   level 2: root=c verbose=3
// EXPECT: $ vc remote add
// EXPECT: error: missing option '--user <USER>'
// EXPECT: try: --user <USER>
// EXPECT: usage: vc remote add [options] --user <USER>
// EXPECT: [MissingRequired 2]
// EXPECT: $ vc remote add --rot x
// EXPECT: error: unknown option '--rot'
// EXPECT: try: --root
// EXPECT: usage: vc remote add [options] --user <USER>
// EXPECT: [UnknownOption 2]
// EXPECT: $ vc remote add --help
// EXPECT: vc remote add
// EXPECT: add one
// EXPECT:
// EXPECT: usage: vc remote add [options] --user <USER>
// EXPECT:
// EXPECT: options:
// EXPECT:   -R, --root <DIR>   the repository
// EXPECT:   -v, --verbose
// EXPECT:       --user <USER>
// EXPECT:   -h, --help         print this help
// EXPECT: [Help 0]
use std::cli::{Arg, Command, Matches};

fn levels(m: Matches, depth: i64) {
    let root = match m.get("root") { Some(r) => r, None => "-" };
    println("  level {depth}: root={root} verbose={}", m.count("verbose"));
    match m.subcommand() {
        Some((name, sub)) => {
            println("  -> {name}");
            levels(sub, depth + 1);
        }
        None => {}
    }
}

fn show(cmd: Command, line: str, gpa: Gpa) {
    println("$ {line}");
    match cmd.parse(line.split(' ')) {
        Ok(m) => levels(m, 0),
        Err(e) => {
            print(cmd.render_in(e, gpa).as_slice());
            println("[{:?} {}]", e.kind, e.exit_code());
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("vc", gpa)
        .arg(Arg::option("root").short('R').value_name("DIR").global().help("the repository"))
        .arg(Arg::flag("verbose").short('v').global())
        .arg(Arg::option("user").global().required())
        .subcommand(Command::new_in("remote", gpa).about("manage the remotes")
            .arg(Arg::flag("all"))
            .subcommand(Command::new_in("add", gpa).about("add one")));
    show(cmd, "vc --user u --root a remote add", gpa);
    show(cmd, "vc remote --root b add --user u", gpa);
    show(cmd, "vc -v remote -v add -R c -v --user u", gpa);
    show(cmd, "vc remote add", gpa);
    show(cmd, "vc remote add --rot x", gpa);
    show(cmd, "vc remote add --help", gpa);
    0
}
