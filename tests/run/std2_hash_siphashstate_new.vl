// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash SipHashState::new.
// EXPECT: 16156531084128653017
// RUSTC: none (SipHashState is std2's; its values are Rust's DefaultHasher's (SipHash-1-3, keys 0 and 0))
use std::hash::{BuildHasher, Hash, Hasher, SipHashState, SipHasher13};

fn main() {
    let w: &str = "hello";
    println("{}", SipHashState::new().hash_one(w));
}
