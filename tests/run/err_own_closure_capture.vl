// EDITION: rust
// 0.20: a closure that is not sink borrows (or copies) what it captures:
// moving the capture in its body would drop its owner's value twice
// (own.move_out), with or without a clone before, called once or twice.
// ERROR: error[borrowck.move_out]
// ERROR: line 22, column 49
// ERROR: error[borrowck.move_out]
// ERROR: line 24, column 29
// ERROR-COUNT: 2
struct R { id: i64 }

impl Drop for R {
    fn drop(&mut self) { println("drop {}", self.id); }
}

impl Clone for R { fn clone(&self) -> R { R { id: self.id + 100 } } }
fn call<F: FnMut() -> i64>(f: F) -> i64 { let mut g = f; g() }
fn call2<F: FnMut() -> i64>(f: F) -> i64 { let mut g = f; g() + g() }

fn main() {
    let tx = R { id: 1 };
    let r = call(|| { let t2 = tx.clone(); drop(tx); 1 });
    let ty = R { id: 2 };
    let s = call2(|| { drop(ty); 1 });
    println("{r} {s}");
}
