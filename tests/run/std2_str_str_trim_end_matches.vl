// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::trim_end_matches.
// EXPECT: "11foo1bar" "bar" "ab"
use std::str::CharIndices;

fn main() {
    println("{:?} {:?} {:?}", "11foo1bar11".trim_end_matches('1'),
        "bar123".trim_end_matches(char::is_numeric), "abxyxy".trim_end_matches("xy"));
}
