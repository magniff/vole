// EDITION: rust
// XFAIL: gap 17: compile type error: cannot index into a value of type '*Vec<i64, Gpa>'
// 0.17 (decided 2026-10-16): a pointer from a call whose function is
// declared `-> *T`, T a type parameter of the function or of its impl
// (`a.as_ptr()`, `first_ptr(p)`), points, as written, to a type
// parameter: `q[i]` on it is pointer arithmetic for every T, Vec<i64> as
// i64; at once (`f(..)[i]`) or through a local. A function declared
// `-> *Vec<T>` gives a pointer whose `[i]` indexes the Vec.
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 6 4
#[derive(Clone, Copy)] struct Arr<T> { p: *mut T }

impl<T> Arr<T> {
    fn as_ptr(self) -> *mut T { self.p }
}

fn first_ptr<T>(p: &mut T) -> *mut T { p }

fn vec_ptr<T>(v: &mut Vec<T, Gpa>) -> *mut Vec<T, Gpa> { v }

fn second_method<T>(a: Arr<T>) -> T {
    let q = a.as_ptr();
    unsafe { (*q.add(1)) }
}

fn second_call<T>(p: &mut T) -> T { unsafe { (*first_ptr(p).add(1)) } }

fn second_local<T>(p: &mut T) -> T {
    let q = first_ptr(p);
    unsafe { (*q.add(1)) }
}

fn last<T>(v: &mut Vec<T, Gpa>) -> T {
    let q = vec_ptr(v);
    unsafe { q[q.len() - 1] }
}

fn main(gpa: Gpa) -> i32 {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    b.push(2);
    b.push(4);
    b.push(6);
    let mut vs = [a, b];
    let mut xs = [7i64, 8, 9];
    println("{} {}", second_method(Arr { p: &mut vs[0] }).len(),
        second_method(Arr { p: &mut xs[0] }));
    println("{} {}", second_call(&mut vs[0]).len(), second_call(&mut xs[0]));
    println("{} {}", second_local(&mut vs[0]).len(), second_local(&mut xs[0]));
    println("{} {}", last(&mut vs[1]), last(&mut vs[1]) - 2);
    0
}
