// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::cmp Ord::cmp.
// EXPECT: Less Equal Greater
use std::cmp::Ordering;

#[derive(Debug, Clone, Copy)]
struct P {
    x: i64,
}

impl PartialEq for P {
    fn eq(&self, other: &P) -> bool {
        self.x == other.x
    }
}

impl Eq for P {}

impl PartialOrd for P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for P {
    fn cmp(&self, other: &P) -> Ordering {
        self.x.cmp(&other.x)
    }
}

fn main() {
    let a = P { x: 2 };
    println("{:?} {:?} {:?}", a.cmp(&P { x: 3 }), a.cmp(&P { x: 2 }), Ord::cmp(&a, &P { x: 1 }));
}
