// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Allocator::FREES.
// EXPECT: true false false
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn frees<A: Allocator>(_a: &A) -> bool {
    A::FREES
}

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let mut mem = [0u8; 16];
    let fb = FixedBuf::new(&mut mem);
    println("{} {} {}", frees(&gpa), frees(&arena), frees(&fb));
}
