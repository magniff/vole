// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::Scanner'
// EXPECT: 123 -45 7 0 9223372036854775807 -9223372036854775808
// EXPECT: none: "" "-" "+" "12a" " 1" "1 " "9223372036854775808" "-9223372036854775809" "99999999999999999999"
// EXPECT: split: [a] [] [b] [] 4
// EXPECT: words: [a] [bb] [ccc] [d] 4
// EXPECT: none: 0 0
// EXPECT: trim: [x y] [] []
// EXPECT: scan: 3 [x] [rest of line] [] end
// 0.14: std's text helpers: parse_int (signs, overflow at both ends,
// anything else rejected), split (empty parts kept), split_whitespace,
// trim, and a Scanner mixing tokens and lines. (0.15: parse_int returns
// a Result.)
use std::Scanner; use std::split_in; use std::split_whitespace_in; use std::trim;

fn show_parts(label: &[u8], parts: &Vec<&[u8], Gpa>) {
    print("{}", str::from_utf8(label).unwrap());
    for &p in parts.as_slice() {
        print(" [");
        print("{}", p);
        print("]");
    }
    print(" ");
    print("{}", (parts.len() as i64));
    println("");
}

fn main(gpa: Gpa) -> i32 {
    for s in ["123", "-45", "+7", "-0", "9223372036854775807", "-9223372036854775808"] {
        print("{}", s.parse::<i64>().unwrap());
        print("{}", if s[0] == b'-' && s.len() > 3 { "\n" } else { " " });
    }
    print("none:");
    for s in ["", "-", "+", "12a", " 1", "1 ", "9223372036854775808", "-9223372036854775809",
        "99999999999999999999"] {
        if s.parse::<i64>().is_err() {
            print(" \"");
            print("{}", s);
            print("\"");
        }
    }
    println("");

    let mut parts = split_in("a,,b,", b',', gpa);
    show_parts(b"split:", &parts);
    let mut words = split_whitespace_in("  a bb\tccc \r\n d ", gpa);
    show_parts(b"words:", &words);
    let mut e1 = split_whitespace_in(" \t\n", gpa);
    let mut e2 = split_whitespace_in("", gpa);
    print("none: ");
    print("{}", (e1.len() as i64));
    print(" ");
    print("{}", (e2.len() as i64));
    println("");

    print("trim: [");
    print("{}", str::from_utf8(trim(" \t x y\r\n")).unwrap());
    print("] [");
    print("{}", str::from_utf8(trim("   ")).unwrap());
    print("] [");
    print("{}", str::from_utf8(trim("")).unwrap());
    println("]");

    let mut sc = Scanner::new("  3 x rest of line\n\nlast");
    print("scan: ");
    print("{}", sc.next_int().unwrap());
    print(" [");
    print("{}", str::from_utf8(sc.next_token().unwrap()).unwrap());
    print("] [");
    print("{}", str::from_utf8(trim(sc.next_line().unwrap())).unwrap());
    print("] [");
    print("{}", str::from_utf8(sc.next_line().unwrap()).unwrap());
    print("]");
    sc.next_line();
    println("{}",
        if sc.next_line().is_none() && sc.next_token().is_none() { " end" } else { " more" });
    0
}
