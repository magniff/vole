// RULE: D4.7, R6
// (0.30.2) A generic function whose parameter needs 'static only through
// a `where` clause (`&'static i64: From<T>`, kf) or through a projection
// of another bound (`T::Out: Into<&'static i64>` with `impl<'a> Has for
// &'a i64 { type Out = &'a i64; }`, kh) is refused as a value, as `fn
// ks(x: &'static i64)` is since 0.30.1: a call through a `fn` value or
// an Fn bound gives a reference of any lifetime. Before this release's
// static_param read those clauses, the compiler built both
// `v.first().map(kf::<&i64>)` and `.map(kh::<&i64>)`, and --check-alloc
// stopped with a use after free after `drop(v)` (the forms of RT-484 and
// RT-485 with a Vec's element: rustc E0597, `v` does not live long
// enough).
// FLAGS: --check-alloc
// ERROR: error[borrowck.fn_value_static]
// ERROR: line 46, column 27
// ERROR: error[borrowck.fn_value_static]
// ERROR: line 47, column 27
// ERROR-COUNT: 2
trait Has {
    type Out;
}

impl<'a> Has for &'a i64 {
    type Out = &'a i64;
}

fn kf<T>(x: T) -> &'static i64
    where
        & 'static i64: From<T>,
{
    From::from(x)
}

fn kh<T: Has>(x: T) -> &'static i64
    where
        T::Out: Into<&'static i64>,
        T: Into<T::Out>,
{
    let o: T::Out = x.into();
    o.into()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let a = v.first().map(kf::<&i64>);
    let b = v.first().map(kh::<&i64>);
    drop(v);
    println("{:?} {:?}", a, b);
}
