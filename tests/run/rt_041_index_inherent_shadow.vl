// XFAIL: RT-41: `w[i]` calls an inherent `fn index` of W instead of `Index::index` (open)
// rustc lowers `w[2]` to `*Index::index(&w, 2)`, always the trait's
// method; an inherent method named `index` is never looked at (rustc
// prints 30 here). vole looks the name up as a method call, so the
// inherent `index` shadows the impl and the program prints 10. With an
// inherent `index` of another type (`-> &[u8]` beside `Index<usize>`'s
// `-> &u8`) `&mut w[1]` is refused with a type error ("cannot deref
// non-pointer type '&mut [u8]'") where rustc reports only E0596 (no
// IndexMut). Pre-existing in 0.30.0; found by the review of the RT-33
// branch.
// EXPECT: 30
use std::ops::Index;

struct W {
    s: [i64; 3],
}

impl W {
    fn index(&self, n: usize) -> &i64 {
        &self.s[0]
    }
}

impl Index<usize> for W {
    type Output = i64;

    fn index(&self, n: usize) -> &i64 {
        &self.s[n]
    }
}

fn main() {
    let w = W { s: [10, 20, 30] };
    println("{}", w[2]);
}
