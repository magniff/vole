// XFAIL: RT-349: a generic trait's const default, `const S: usize = size_of::<T>();`, with `impl<T> G<T> for u16 {}` fails: "unknown type 'T'"; rustc prints the EXPECT line (0.30.2)
// Since v0.30.1 at least. From the review of the type-parameter work.
// EXPECT: 8 1 2
use std::mem::size_of;

trait G<T> {
    const S: usize = size_of::<T>();
}

struct W<T, U> { t: T, u: U }
impl<T, U> G<U> for W<T, U> {}
impl<T> G<T> for u16 {}
fn s<X: G<Y>, Y>() -> usize { <X as G<Y>>::S }

fn main() {
    println("{} {} {}", s::<W<u8, i64>, i64>(), s::<W<i64, u8>, u8>(), s::<u16, u16>());
}
