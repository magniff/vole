// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::string String::leak.
// EXPECT: abc
// STDERR: check-alloc: 1 block of Gpa not freed (3 bytes):
// STDERR:   block #1 (3 bytes), allocated at std2_string_string_leak.vl:10:13
// (leak gives the block up for the program's whole run: --check-alloc lists it)

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let t: &mut str = s.leak();
    println("{}", t);
}
