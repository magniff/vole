// 0.16: Arena::none() (the constant a static started with) has no memory:
// allocating from it stops the program; freeing an empty container on it
// is nothing. (0.26.3: a static holds no allocator, alloc.static; the
// container is main's.)
// EXPECT: 0 0
// EXIT: 101
// STDERR: the arena has no memory: it is Arena::none()
fn main() {
    let a = Arena::none();
    var v: Vec<i64, Arena> = Vec::new_in(Arena::none());
    v.free();
    println("{} {}", a.used(), a.chunk_bytes());
    v.push(1);
    println("not reached");
}
