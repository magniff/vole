// (0.30.1) A struct whose fields fit one by one but not together: two
// halves of 2^61 bytes. Refused at its declaration (the type limit,
// front::types::TYPE_SIZE_LIMIT), never laid out with a wrapped size.
// ERROR: values of the type 'Two' are too big for the target: its size is 2^61 bytes or more
// ERROR-COUNT: 1
struct Two {
    a: [u8; 1usize << 60],
    b: [u8; 1usize << 60],
}

fn main() {
    println("{}", std::mem::size_of::<Two>());
}
