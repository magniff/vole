// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::allocator.
// EXPECT: 3
// RUSTC: none (Box::allocator is unstable in Rust (allocator_api))
use std::boxed::Box;

fn main(gpa: Gpa) {
    let b = Box::new_in(3i64, gpa);
    let a: &Gpa = Box::allocator(&b);
    let c = Box::new_in(*b, *a);
    println("{}", c);
}
