// A byte index of a literal equal to its length.
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let s = "abc";
    println("{}", s[(3 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
