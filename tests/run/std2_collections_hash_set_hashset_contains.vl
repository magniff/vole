// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_set HashSet::contains.
// EXPECT: true false
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<String<Gpa>, Gpa> = HashSet::new_in(gpa);
    s.insert("a".to_string_in(gpa));
    println("{} {}", s.contains("a"), s.contains("b"));
}
