fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut m: std::collections::HashMap<i64, i64, Gpa> = std::collections::HashMap::new_in(gpa);
    m.insert(1, 2);
    let clean = gpa.check_leaks();
    println("live {} {clean}", gpa.live_blocks() as i64);
    drop(v);
    drop(m);
    println("live {} {}", gpa.live_blocks() as i64, gpa.check_leaks());
    let mut b = std::string::String::new_in(gpa);
    b.push_str("leaked");
    // (0.17: b would drop here; forgotten, it leaks)
    forget(b);
}
