// EDITION: rust
// RULE: D3.6
// (0.27.1) A callee stores `&y` into `&mut H<'a>`: `y` must live as long as
// `h`.
// ERROR: :22:21: error[borrowck.dropped_borrowed]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct H<'a> {
    r: &'a i64,
}

fn put<'a>(h: &mut H<'a>, x: &'a i64) {
    h.r = x;
}

fn main() {
    let x: i64 = 1;
    let mut h = H { r: &x };
    {
        let y: i64 = 2;
        put(&mut h, &y);
    }
    println("{}", *h.r);
}
