// Runs on std since 0.27.2's switch.
// The std item(s): std::ops impl BitOrAssign for primitives.
// EXPECT: 13 13
use std::ops::BitOrAssign;

fn update<T: BitOrAssign>(a: &mut T, b: T) {
    a.bitor_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
