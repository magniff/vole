// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Entry::or_insert_with_key.
// EXPECT: 30
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let v = *m.entry(3).or_insert_with_key(|k| *k * 10);
    println("{}", v);
}
