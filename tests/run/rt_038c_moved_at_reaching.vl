// RT-38c (F7): borrowck.use_moved's "moved at" must name the move that
// reaches the use, as rustc's get_moved_indexes does: here the else
// branch's first `eat(d)`, its `d` at line 24, column 13, not the then
// branch's at line 22, from which no path reaches the use (rustc E0382:
// "value moved here" at that `d`). The same through #[multiversion]:
// the user's line, never the dispatcher's (not seen there in this
// release: tests/run/rt_034_multiversion_use_after_move.vl).
// (the message, borrowck.use_moved's, holds the "moved at" position)
// ERROR: line 24, column 13)
// ERROR: line 24, column 22
// ERROR-COUNT: 1
struct D {
    v: i64,
}

fn eat(d: D) -> i64 {
    d.v
}

fn f(d: D, b: bool) -> i64 {
    if b {
        eat(d)
    } else {
        eat(d) + eat(d)
    }
}

fn main() {
    println("{}", f(D { v: 1 }, true));
}
