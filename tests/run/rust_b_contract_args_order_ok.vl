// RULE: D7.4
// (0.30.1) A `requires` never changes what a call sees: each argument is
// evaluated once, in order, as without one (rustc's order). Before, an
// argument that was a local was read again at the call:
// `v.swap(i, { i = 2; 1 })` swapped 2 and 1 (`[10, 30, 20]`), `f(x, { x =
// 7; 2 })` gave 72 with a requires and 12 without, and `g(s, { s = ..; 1
// })` was refused (s read after its move). A receiver's autoref is
// reserved (two-phase): `v.insert(0, v.len())` is accepted, and a `&mut`
// place given is reborrowed, `g2(r, r.len())`.
// EXPECT: [20, 10, 30] 2
// EXPECT: 12 7 12 7
// EXPECT: hello x
// EXPECT: [1, 1]
// EXPECT: 3 2
fn f(x: usize, k: usize) -> usize
    requires k < 100
{
    x * 10 + k
}

fn plain(x: usize, k: usize) -> usize {
    x * 10 + k
}

fn g<A: std::alloc::Allocator>(s: String<A>, k: usize) -> String<A>
    requires k < 100
{
    s
}

fn g2(s: &mut Vec<i64, Gpa>, k: usize) -> i64
    requires k < 100
{
    s[0] + k as i64
}

fn main(gpa: Gpa) {
    let mut v: Vec<usize, Gpa> = Vec::new_in(gpa);
    v.push(10);
    v.push(20);
    v.push(30);
    let mut i: usize = 0;
    v.swap(i, { i = 2; 1 });
    println("{:?} {}", v, i);
    let mut x = 1;
    let r = f(x, { x = 7; 2 });
    let mut y = 1;
    let q = plain(y, { y = 7; 2 });
    println("{} {} {} {}", r, x, q, y);
    let mut s = String::from_in("hello", gpa);
    let t = g(s, { s = String::from_in("x", gpa); 1 });
    println("{} {}", t, s);
    let mut u: Vec<usize, Gpa> = Vec::new_in(gpa);
    u.push(1);
    u.insert(0, u.len());
    println("{:?}", u);
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    a.push(2);
    let w = &mut a;
    let n = g2(w, w.len());
    println("{} {}", n, w.len());
}
