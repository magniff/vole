// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec IntoIter::impl Drop.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: end
use std::vec::Vec;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main(gpa: Gpa) {
    {
        let mut it = Vec::from_in([D { n: 1 }, D { n: 2 }, D { n: 3 }], gpa).into_iter();
        let first = it.next().unwrap();
        println("got {}", first.n);
    }
    println("end");
}
