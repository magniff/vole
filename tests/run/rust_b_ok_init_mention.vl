// RULE: M1
// (0.30.1) A place only mentioned reads nothing (rustc's PlaceMention):
// `let _ = *p;`, `let _ = q;`, a match or `if let` with `_` on a value never
// assigned; `r;` and `s.a;` of assigned values.
// EXPECT: wild
// EXPECT: 7 1
struct P {
    a: i64,
    b: &'static i64,
}

static A: i64 = 7;

fn main() {
    let p: &'static &'static i64;
    let _ = *p;
    let _ = **p;
    match **p {
        _ => {}
    }
    let q: P;
    let _ = q;
    let _ = q.b;
    let _ = *q.b;
    let _: i64 = **p;
    if let _ = **p {
        println("wild");
    }
    let r: &'static i64 = &A;
    r;
    let s = P { a: 1, b: &A };
    s.a;
    println("{} {}", *r, s.a);
}
