// 0.15: on a generic type a field without the trait is found in the
// instance; the error is at the field.
// ERROR: the trait 'Hash' is not implemented for 'Vec<i64, Gpa>'
// ERROR: in instantiation of 'G<i64, Gpa>::hash'
// ERROR-COUNT: 1
use std::HashMap;

#[derive(Hash, Eq)]
struct G<T, A: Allocator> { v: Vec<T, A> }

fn main(gpa: Gpa) {
    var m: HashMap<G<i64, Gpa>, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(G { v: Vec::new_in(gpa) }, 1);
}
