// EDITION: rust
// (0.28.0, F20.8) What indexes: a usize, an untyped literal, a local
// still open (it becomes a usize there), arithmetic of them, a reference
// to a usize (read through), and any other integer converted, `as
// usize`. A negative index converted is a large one: out of bounds, the
// same panic as before the conversion was written.
// EXPECT: 20 30 40 10 30
// EXPECT: [20, 30] [10, 20] ell
// EXPECT: 20 40 2
// EXPECT: 20
// STDERR: index out of bounds
// EXIT: 101
fn pick(xs: &[i64], i: i64) -> i64 {
    xs[i as usize]
}

fn main(gpa: Gpa) -> i32 {
    let a = [10, 20, 30, 40];
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.extend_from_slice(&a);
    let k: usize = 1;
    let n = 2;
    let last = v.len() - 1;
    let q = &k;
    let b: u8 = 2;
    println("{} {} {} {} {}", a[k], v[n], a[last], a[0], a[k + 1]);
    println("{:?} {:?} {}", &a[k..n + 1], &v[..n], &"hello"[k..4]);
    println("{} {} {}", a[*q], v[(b + 1) as usize], n);
    let keys = [3usize, 0];
    let first = keys.iter().map(|i| a[*i]).sum::<i64>();
    if first != 50 {
        return 1;
    }
    let m: i64 = -1;
    println("{}", pick(&a, 1));
    println("{}", pick(&a, m));
    0
}
