// EDITION: rust
// a closure argument replaces the Vec passed let: the let access reads freed memory
// ERROR: error[borrowck.conflict]
fn f<F: FnMut()>(p: &Vec<i64, Gpa>, mut w: F) -> i64 { w(); p[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 { v.push(i + 1); } let r = f(&v, || { v = Vec::new_in(gpa); });
    println("{r} {}", v.len());
}
