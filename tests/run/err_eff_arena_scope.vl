// 0.16: a closure in Arena::scope that allocates from a captured Gpa adds
// alloc(Gpa): only the arena's own use of Gpa is discharged.
// ERROR: error[effect]
// ERROR: line 7, column 1
// ERROR-COUNT: 1
use std::alloc::Arena; #[effects(alloc(Arena<Gpa>), panic)]
fn from_gpa(a: &mut Arena<Gpa>, gpa: Gpa) -> i64 {
    a.scope(|s| ({ let s = s; {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        let n = v.len();
        drop(v);
        n as i64
    } }))
}

fn main(gpa: Gpa) -> i32 {
    let mut a = Arena::new_in(gpa);
    println("{}", from_gpa(&mut a, gpa));
    0
}
