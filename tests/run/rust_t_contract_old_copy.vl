// EDITION: rust
// RULE: C5
// (0.27.1) `old(e)` of a `Copy` value with no region: a scalar parameter,
// and `*v` of a `&mut i64` parameter, read at entry.
// EXPECT: 4 5
// EXIT: 101
// STDERR: ensures failed: '* v == old(*v) + 1' of 'bad'
fn half(x: i64) -> i64
    ensures result <= old(x)
{
    x / 2
}

fn bump(v: &mut i64)
    ensures * v == old(*v) + 1
{
    *v += 1;
}

fn bad(v: &mut i64)
    ensures * v == old(*v) + 1
{
    *v += 2;
}

fn main() {
    let mut a: i64 = 4;
    bump(&mut a);
    println("{} {}", half(8), a);
    bad(&mut a);
}
// XFAIL: std2 has no contract_check, which a contract's lowering calls (std2)
