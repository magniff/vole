// EDITION: rust
// EXPECT: 2 12
#[derive(Clone, Copy)] struct I { a: i64, b: i64 }
#[derive(Clone, Copy)] struct S { i: I, y: i64 }
fn f(a: &mut i64, b: &mut i64) { *a += 1; *b += 10; }

fn main() {
    let mut s = S { i: I { a: 1, b: 2 }, y: 2 }; f(&mut s.i.a, &mut s.i.b); println("{} {}", s.i.a, s.i.b);
}
