// XFAIL: RT-435: `(*p).make_ascii_uppercase()` with `p: *mut str` is refused, borrowck.borrow_immutable ("the receiver is a shared '&str'"); `*p` of a `*mut str` is a mutable place, rustc prints AB (0.30.2)
// From the paused g302debug work (its rt_XXXc, from a re-review of the
// g302holes lend shapes). Since v0.30.1 at least (the same error).
// EXPECT: AB
fn up(p: *mut str) {
    // UNSAFE: the case is about a method call through a raw pointer
    // SAFETY: p comes from a live &mut str of main's String, used once here
    unsafe {
        (*p).make_ascii_uppercase();
    }
}

fn main(gpa: Gpa) {
    let mut s = "ab".to_string_in(gpa);
    up(s.as_mut_str() as *mut str);
    println("{}", s);
}
