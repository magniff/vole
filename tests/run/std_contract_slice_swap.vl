// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): swap's `requires i < self.len() && j < self.len()`, violated last.
// EXPECT: 3
// EXIT: 101
// STDERR: requires failed: 'j < self.len()'

fn main() {
    let mut a = [1, 2, 3];
    let s: &mut [i64] = &mut a;
    s.swap(0, 2);
    println("{}", s[0]);
    s.swap(0, 3);
}
