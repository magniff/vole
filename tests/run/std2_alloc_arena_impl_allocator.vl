// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Arena::impl Allocator.
// EXPECT: [1, 2, 3] 24
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let mut v: Vec<i64, &Arena<Gpa>> = Vec::with_capacity_in(3, &arena);
    v.push(1);
    v.push(2);
    v.push(3);
    println("{:?} {}", v, arena.used());
}
