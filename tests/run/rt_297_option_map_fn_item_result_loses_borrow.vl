// XFAIL: RT-297: `v.first().map(idr2)` with a fn item `fn idr2<'a>(x: &'a i64) -> &'a i64` (also and_then, `Option::map(o, idr2)`, a `fn(&i64) -> &i64` variable) gives a result that keeps no borrow of v: drop(v) while it lives is accepted, a use after free from safe code (0.30.2)
// rustc E0505 at each drop (twin .rs.txt). The release build checks it
// clean; --check-alloc stops with `use after free: block #1 (32 bytes),
// allocated at ..`. The same calls with a closure (`.map(|x| idr2(x))`,
// `.max_by_key(|x| idr2(x))`) and a direct call `f(&v[0])` of a
// `fn(&i64) -> &i64` variable keep the borrow. R302F-1 is the same gap in
// a program fn's `fn(I::Item) -> U` parameter.
// FLAGS: --check-alloc
// ERROR: line 26
// ERROR: line 30
// ERROR: line 34
// ERROR: line 39
// ERROR-COUNT: 4
fn idr<'a>(x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let a = v.first().map(idr2);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let b = w.first().and_then(idr);
    drop(w);
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(3000);
    let c = Option::map(u.first(), idr2);
    drop(u);
    let mut t: Vec<i64, Gpa> = Vec::new_in(gpa);
    t.push(4000);
    let f: fn(&i64) -> &i64 = idr2;
    let d = t.first().map(f);
    drop(t);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?} {:?} {:?} {:?}", a, b, c, d, x);
}
