// RULE: F18.6, F18.1
// A type parameter left free is an inference variable, solved by the
// first check, in the order the function is checked, that meets a definite
// type: `Vec::new_in(a)` by a later push, one whose first use is `len()`
// (the instance waits for the variable), a map by its insert, a value
// passed where its type goes (`mem::replace`), the tail, an `if`'s later
// arm (`Err("neg")` fixes the E of the first arm's `Ok`), an assignment.
// EXPECT: [1, 2] 0 [7] 2 [9] 0 Err("neg") [3]
use std::mem;
use std::collections::HashMap;

fn evens(a: Gpa) -> Vec<i64, Gpa> {
    let mut v = Vec::new_in(a);
    v.push(2i64);
    v
}

fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let mut w = Vec::new_in(gpa);
    let n = w.len();
    w.push(7i64);
    let mut m = HashMap::new_in(gpa);
    m.insert(1i64, 2i64);
    let mut x = Vec::from_in([9i64], gpa);
    let fresh = Vec::new_in(gpa);
    let old = mem::replace(&mut x, fresh);
    let f = |k: i64| if k > 0 { Ok(k * 2) } else { Err("neg") };
    let mut y = Vec::new_in(gpa);
    y = evens(gpa);
    y[0] = 3;
    println("{:?} {} {:?} {} {:?} {} {:?} {:?}", v, n, w, m[&1], old, x.len(), f(-1), y);
}
