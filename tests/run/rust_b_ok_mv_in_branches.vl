// EDITION: rust
// RULE: D8.2
// (0.27.1) A move in each branch, no use after.

struct N {
    v: i64,
}

fn eat(n: N) -> i64 {
    n.v
}

fn main() {
    let n = N { v: 2 };
    if n.v > 1 {
        println("{}", eat(n));
    } else {
        let m = n;
        println("{}", m.v);
    }
}
// EXPECT: 2
