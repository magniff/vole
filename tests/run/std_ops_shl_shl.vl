// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Shl::shl.
// EXPECT: V { x: 48 } 48
use std::ops::Shl;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Shl for V {
    type Output = V;

    fn shl(self, rhs: V) -> V {
        V { x: self.x << rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 2 };
    println("{:?} {}", a.shl(b), Shl::shl(12i64, 2));
}
