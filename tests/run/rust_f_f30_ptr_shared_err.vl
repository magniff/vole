// RULE: F30.5
// (0.29) A `&T` coerces and casts to `*const T` only: where a `*mut T`
// is expected it is a mismatch (rustc E0308), and `&x as *mut T` is no
// cast (rustc E0606). A `&mut T` goes to both.
// ERROR: error[type error]: expected '*mut i64', got '&i64'
// ERROR: line 21, column 9
// ERROR: help: the types differ in mutability (rustc E0308): a `*mut T` takes an exclusive reference, `&mut x`; a `&T` coerces to `*const T` only
// ERROR: error[type.cast]: cannot cast '&i64' to '*mut i64'
// ERROR: line 22, column 13
// ERROR: help: a shared reference casts to `*const T` only (rustc E0606)
// ERROR-COUNT: 2
fn put(p: *mut i64) {}

fn get(p: *const i64) {}

fn main() {
    let mut x: i64 = 5;
    get(&x);
    get(&mut x);
    put(&mut x);
    put(&x);
    let p = &x as *mut i64;
    let q = &x as *const i64 as *mut i64;
    let r = &mut x as *const i64;
}
