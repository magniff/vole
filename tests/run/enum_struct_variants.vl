// EDITION: rust
// XFAIL: gap 17: compile format.args: a format string is a literal: this argument has no hole to go to
// EXPECT: move 3 4; line 1 2 to 5 6; quit
// EXPECT: x=3 only
// EXPECT: px=1 py=2
// EXPECT: if let 7
// EXPECT: order c a b 3 1 2
// EXPECT: while let 2 1 0
// EXPECT: generic 5 [u8]=hi
// EXPECT: used 9
// EXPECT: self 11
// EXPECT: let 4 5
// EXPECT: tuple any
// EXPECT: nested 6
// EXPECT: Move { x: 3, y: 4 } Text { s: "hi", n: 2 } Quit Pair(1, 2)
// EXPECT: eq true false lt true
// EXPECT: clone 3 4 hash same
// 0.17: struct-like enum variants: `V { a: A, b: B }` laid out as `V(A, B)`;
// literals with shorthands and in any order (evaluated in the order written);
// patterns `V { a, b: p, .. }` in match, if let, while let and let; derives.
use std::hash::FixedState; use std::hash::Hash; use std::fmt::Debug; use std::fmt::Formatter as Fmt;

#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy)]
enum Cmd<'a> {
    Move { x: i64, y: i64 },
    Text { s: &'a [u8], n: i64 },
    Quit,
    Pair(i64, i64),
}

#[derive(Clone, Copy)] enum Shape { Line { from: (i64, i64), to: (i64, i64) }, Dot }

#[derive(Clone, Copy)] enum Opt<T> { Some2 { value: T }, None2 }

#[derive(Clone, Copy)] enum One { Only { a: i64, b: i64 } }

#[derive(Copy)] enum Outer<'a> { In { cmd: Cmd<'a>, k: i64 }, Out } impl Clone for Outer<'_> {
    fn clone(&self) -> Self { *self }
}

mod m {
    #[derive(Clone, Copy)] pub enum Ev { Key { code: i64 }, Tick }
}

use m::Ev::Key;

impl<'a> Cmd<'a> {
    fn twice(n: i64) -> Cmd<'a> {
        Self::Move { x: n, y: n }
    }
}

static mut TRACE: i64 = 0;

fn note(c: u8, v: i64) -> i64 {
    unsafe {
        TRACE += 1;
    }
    print(" ");
    let mut s = [0u8; 1];
    s[0] = c;
    print("{}", str::from_utf8(s[0..1]).unwrap());
    v
}

fn show<T: std::fmt::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1i32);
    write(f, "{:?}", x)?;
}

fn describe(c: Cmd<'_>) {
    match c {
        Cmd::Move { x, y } => print("move {x} {y}"),
        Cmd::Text { s, .. } => print("{}", s),
        Cmd::Quit => print("quit"),
        Cmd::Pair(a, b) => print("pair {a} {b}"),
    }
}

fn main() {
    let x: i64 = 3;
    describe(Cmd::Move { x, y: 4i64 });
    print("; ");
    let sh = Shape::Line { to: (5i64, 6i64), from: (1i64, 2i64) };
    match sh {
        Shape::Line { from: (a, b), to: (c, d) } => print("line {a} {b} to {c} {d}; "),
        Shape::Dot => print("dot"),
    }
    describe(Cmd::Quit);
    println("");

    match (Cmd::Move { x: 3i64, y: 9i64 }) {
        Cmd::Move { x, .. } if x == 3 => println("x={x} only"),
        _ => println("other"),
    }
    match (Cmd::Move { y: 2i64, x: 1i64 }) {
        Cmd::Move { x: px, y: py } => println("px={px} py={py}"),
        _ => println("other"),
    }
    if let Cmd::Text { n, s: _ } = (Cmd::Text { s: "t", n: 7i64 }) {
        println("if let {n}");
    }

    // Evaluated in the order written: c, a, b.
    print("order");
    let t = Cmd::Text { n: note(b'c', 3), s: "" };
    let _ = t;
    let m = Cmd::Move { y: note(b'a', 2), x: note(b'b', 1) };
    if let Cmd::Move { x, y } = m {
        println(" {} {x} {y}", unsafe { TRACE });
    }

    let mut cur = Opt::Some2 { value: 2i64 };
    print("while let");
    while let Opt::Some2 { value } = cur {
        print(" {value}");
        cur = if value > 0 { Opt::Some2 { value: value - 1 } } else { Opt::None2 };
    }
    println("");

    let g: Opt<&[u8]> = Opt::Some2 { value: "hi" };
    let h = Opt::Some2 { value: 5i64 };
    if let (Opt::Some2 { value: a }, Opt::Some2 { value: b }) = (h, g) {
        println("generic {a} [u8]={b}");
    }

    let k = Key { code: 9i64 };
    match k {
        Key { code } => println("used {code}"),
        m::Ev::Tick => println("tick"),
    }
    match Cmd::twice(11) {
        Cmd::Move { x, .. } => println("self {x}"),
        _ => println("other"),
    }
    let One::Only { a, b } = (One::Only { a: 4i64, b: 5i64 });
    println("let {a} {b}");
    match Cmd::Pair(1i64, 2i64) {
        Cmd::Pair { .. } => println("tuple any"),
        _ => println("other"),
    }
    let o = Outer::In { cmd: Cmd::Move { x: 6i64, y: 0i64 }, k: 1i64 };
    match o {
        Outer::In { cmd: Cmd::Move { x, y: 0 }, k: 1 } => println("nested {x}"),
        Outer::In { .. } => println("in"),
        Outer::Out => println("out"),
    }

    let all = [Cmd::Move { x: 3i64, y: 4i64 }, Cmd::Text { s: "hi", n: 2i64 }, Cmd::Quit,
        Cmd::Pair(1i64, 2i64)];
    for i in 0..4 {
        if i > 0 {
            print(" ");
        }
        show(&all[i as usize]);
    }
    println("");
    let p = Cmd::Move { x: 1i64, y: 2i64 };
    let q = Cmd::Move { x: 1i64, y: 2i64 };
    let r = Cmd::Move { x: 1i64, y: 3i64 };
    println("eq {} {} lt {}", p == q, p == r, p < r);
    let c = Cmd::Move { x: 3i64, y: 4i64 };
    let d = c.clone();
    let same = FixedState::new().hash_one(&c) == FixedState::new().hash_one(&d);
    match d {
        Cmd::Move { x, y } => println(
            "clone {x} {y} hash {}", if same { "same" } else { "differs" }),
        _ => println("other"),
    }
}
