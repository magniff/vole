// rustc refuses each call in main (twin: r302d_007_ufcs_arg_adjusted_like_receiver.rs.txt):
// E0277 `&mut S: T0` (line 40), `&&S: T0` (41), E0308 (42, 43, 44: `&mut S`
// expected, `&S` found; `&S` expected, `S` found), E0277 `&S: T0` (45). In
// a path call Self is inferred from the argument's type; no autoref or
// autoderef applies. vole refuses only line 43 (borrowck: '**&&s' behind a
// `&`); without it the rest build and run: `T0::g(&s)` takes `&mut s` and
// mutates s (prints 2), `T0::h(s)` borrows s. Since v0.28.0 (the g302probe
// build the same). Found by the method-resolution generator (gmr).
// ERROR: line 40
// ERROR-COUNT: 6
trait T0 {
    fn f(self) -> i64;
    fn g(&mut self) -> i64;
    fn h(&self) -> i64;
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl T0 for S {
    fn f(self) -> i64 {
        self.k
    }

    fn g(&mut self) -> i64 {
        self.k += 1;
        self.k
    }

    fn h(&self) -> i64 {
        self.k * 10
    }
}

fn main() {
    let mut s = S { k: 1 };
    println("{}", T0::f(&mut s));
    println("{}", T0::f(&&s));
    println("{}", T0::g(&s));
    println("{}", T0::g(&&s));
    println("{}", T0::h(s));
    println("{}", T0::h(&&s));
}
