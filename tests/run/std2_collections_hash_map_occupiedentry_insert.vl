// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map OccupiedEntry::insert.
// EXPECT: 9 4
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Entry;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 9);
    let mut old = 0;
    if let Entry::Occupied(mut e) = m.entry(1) {
        old = e.insert(4);
    }
    println("{} {}", old, m[&1]);
}
