// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FixedState::impl BuildHasher.
// EXPECT: 16706263042352196351 true
// RUSTC: none (FixedState is foldhash's (the foldhash crate's FixedState, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{BuildHasher, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let s = FixedState::new();
    let w: &str = "hello";
    let mut h = s.build_hasher();
    w.hash(&mut h);
    println("{} {}", s.hash_one(w), h.finish() == s.hash_one(w));
}
