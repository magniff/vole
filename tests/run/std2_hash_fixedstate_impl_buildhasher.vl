use std::hash::{BuildHasher, FixedState, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let s = FixedState::new();
    let w: &str = "hello";
    let mut h = s.build_hasher();
    w.hash(&mut h);
    println("{} {}", s.hash_one(w), h.finish() == s.hash_one(w));
}
