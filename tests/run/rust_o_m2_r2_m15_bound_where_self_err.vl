// (re-review 2 of M2, form m15) `T::Out` under `T: Sub`, Sub having TrA and,
// by `where Self: TrB`, TrB as supertraits, both declaring Out: rustc's
// E0221 (d4db7fbf8 took TrA's Out and printed 8).
// ERROR: ambiguous associated type 'Out' in the bounds of 'T'
// ERROR-COUNT: 1
trait TrA {
    type Out;
}

trait TrB {
    type Out;
}

trait Sub: TrA
    where
        Self: TrB,
{
}

struct W;

impl TrA for W {
    type Out = i64;
}

impl TrB for W {
    type Out = u8;
}

impl Sub for W {}

fn sz<T: Sub>(_t: &T) -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    println("{}", sz(&W));
}
