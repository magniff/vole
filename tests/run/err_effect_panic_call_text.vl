// (0.30.1) The step a #[no_panic] error names for a call of std's panic
// says so: before, it read "calls an unsafe function".
// ERROR: column 9 calls std's panic
// ERROR-COUNT: 1
#[no_panic]
fn g(d: i64) -> i64 {
    if d == 0 {
        panic("zero");
    }
    d
}

fn main() {
    println("{}", g(1));
}
