// RULE: F30.5
// (0.29) A `c"..."` literal is a `*const u8`: where a `*mut u8` is
// declared it is a mismatch, and its bytes are not written.
// ERROR: error[type error]: expected '*mut u8', got '*const u8'
// ERROR: line 11, column 22
// ERROR: try: c"abc" as *mut u8
// ERROR: expected '*mut u8', got '*const u8'
// ERROR: cannot assign to '*c"abc"', which is behind a `*const` pointer
// ERROR-COUNT: 3
fn main() {
    let p: *mut u8 = c"abc";
    takes(c"abc");
    // UNSAFE: a write through a raw pointer.
    // SAFETY: none: the case shows that it is refused.
    unsafe {
        *c"abc" = 0;
    }
}

fn takes(p: *mut u8) {}
