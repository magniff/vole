// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::as_str.
// EXPECT: abc true
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let t: &str = s.as_str();
    println("{} {}", t, t == "abc");
}
