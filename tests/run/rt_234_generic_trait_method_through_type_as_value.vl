// XFAIL: RT-234: a method of a generic trait named through the implementing type is not a fn value: `.map(i64::from)`, `.map(E2::from)`, `.map_err(E2::from)` and `let f: fn(E1) -> E2 = E2::from;` give "no associated function 'from' in 'E2'" while the call `E2::from(e)` works (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). A non-generic trait's method (`E1::mk`) is a value already.
// EXPECT: [1, 2] Some(E2 { c: 11 }) Err(E2 { c: 13 }) E2 { c: 14 } E1 { c: 5 }
#[derive(Debug)]
struct E1 {
    c: i64,
}
#[derive(Debug)]
struct E2 {
    c: i64,
}

impl From<E1> for E2 {
    fn from(e: E1) -> E2 {
        E2 { c: e.c + 10 }
    }
}

trait Mk {
    fn mk(k: i64) -> Self;
}

impl Mk for E1 {
    fn mk(k: i64) -> E1 {
        E1 { c: k }
    }
}

fn main(gpa: Gpa) {
    let bytes = [1u8, 2];
    let v: Vec<i64, Gpa> = bytes.iter().copied().map(i64::from).collect_in(gpa);
    let w: Option<E2> = Some(E1 { c: 1 }).map(E2::from);
    let r: Result<i64, E1> = Err(E1 { c: 3 });
    let y: Result<i64, E2> = r.map_err(E2::from);
    let f: fn(E1) -> E2 = E2::from;
    let g = E1::mk;
    println("{:?} {:?} {:?} {:?} {:?}", v, w, y, f(E1 { c: 4 }), g(5));
}
