// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::sum.
// EXPECT: 10 2.5
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let f = Vec::from_in([1.0f64, 1.5], gpa);
    let s: i64 = v.iter().sum();
    let t: f64 = f.iter().sum();
    println("{} {}", s, t);
}
