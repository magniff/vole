// XFAIL: gap 5: compile type error: method 'hash' expects 1 arguments, got 0
// EXPECT: index 2 4
// EXPECT: groups 1 2 none
// EXPECT: bykey 5
// EXPECT: wrap 7 1
// EXPECT: store 0 1 4
// 0.14: a struct field or enum payload whose type has bounds
// (`HashMap<i64, i64>`) was checked before the impls were collected,
// so `i64: Hash` was not found ("the trait 'Hash' is not implemented
// for 'i64'"): such bounds are now checked once every impl is known.
use std::hash::FixedState;
use std::alloc::Allocator; use std::hash::Hash; use std::io::Empty; use std::iter::Map;
use std::collections::HashMap;

struct Index<A: Allocator> { ids: HashMap<i64, i64, A, FixedState> }

struct Groups<'a, A: Allocator> {
    by: HashMap<i64, Vec<i64, A>, A, FixedState>,
    names: HashMap<&'a str, i64, A, FixedState>,
    last: Option<HashMap<i64, i64, A, FixedState>>,
}

// a key type whose Hash impl comes after the struct that uses it
struct ByKey<A: Allocator> { m: HashMap<Key, i64, A, FixedState> }

#[derive(Clone, Copy)] struct Key { k: i64 }

impl Hash for Key {
    fn hash(&self) -> u64 { self.k.hash() }
}

struct Wrap<T, A: Allocator> { inner: HashMap<i64, T, A, FixedState>, items: Vec<T, A> }

enum Store<A: Allocator> {
    Empty, Map(HashMap<i64, i64, A, FixedState>), Nested(HashMap<i64, Vec<i64, A>, A, FixedState>),
}

fn store_len(s: Store<Gpa>) -> i64 {
    match s {
        Store::Empty => 0,
        Store::Map(m) => m.len() as i64,
        Store::Nested(m) => m.len() as i64 + 3,
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut ix = Index { ids: HashMap::new_in(gpa) };
    ix.ids.insert(1, 2);
    ix.ids.insert(3, 4);
    print("index ");
    print("{}", (ix.ids.len() as i64));
    print(" ");
    print("{}", ix.ids.get(&3).copied().unwrap());
    println("");
    let mut g = Groups { by: HashMap::new_in(gpa), names: HashMap::new_in(gpa), last: None };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    g.by.insert(7, v);
    g.names.insert("a", 1);
    g.names.insert("b", 2);
    print("groups ");
    print("{}", (g.by.len() as i64));
    print(" ");
    print("{}", (g.names.len() as i64));
    match g.last {
        None => println(" none"),
        Some(_) => println(" some"),
    }
    let mut bk = ByKey { m: HashMap::new_in(gpa) };
    bk.m.insert(Key { k: 5 }, 5);
    print("bykey ");
    print("{}", bk.m.get(&(Key { k: 5 })).copied().unwrap());
    println("");
    let mut w: Wrap<i64, Gpa> = Wrap { inner: HashMap::new_in(gpa), items: Vec::new_in(gpa) };
    w.inner.insert(1, 7);
    w.items.push(7);
    print("wrap ");
    print("{}", w.inner.get(&1).copied().unwrap());
    print(" ");
    print("{}", (w.items.len() as i64));
    println("");
    let mut n: HashMap<i64, Vec<i64, Gpa>, Gpa, FixedState> = HashMap::new_in(gpa);
    n.insert(1, Vec::new_in(gpa));
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    print("store ");
    print("{}", store_len(Store::Empty));
    print(" ");
    print("{}", store_len(Store::Map(m)));
    print(" ");
    print("{}", store_len(Store::Nested(n)));
    println("");
    0
}
