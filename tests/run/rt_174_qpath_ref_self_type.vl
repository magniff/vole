// From the g302qual review (form f04_ref_self).
// EXPECT: 2 1 2 1 2 1
trait A { const K: i64; fn m(&self) -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } }
impl<'a> A for &'a S { const K: i64 = 2; fn m(&self) -> i64 { 2 } }

fn main() {
    let s = S; let r = &s;
    let f = <&S as A>::m; let g = <S as A>::m;
    println("{} {} {} {} {} {}", <&S as A>::K, <S as A>::K, f(&r), g(&s), <&S as A>::m(&r),
        <S as A>::m(&s));
}
