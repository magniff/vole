// RULE: C3.4
// (0.30.2, review of RT-38g) `Option::take`, `mem::replace`, `mem::swap` on the clause's own
// locals. A callee's raw write is refused only
// when a raw pointer may reach it from what the clause reads (a
// parameter's or the result's type holds one, contracts::raw_inputs).
// RUSTC: none contract clauses are not Rust
// EXPECT: 1
fn f(n: i64) -> i64
    requires {
    let mut o = Some(n);
    let t = o.take();
    t.is_some()
}

requires {
    let mut a = n;
    let b = std::mem::replace(&mut a, 3);
    b == n
}
requires {
    let mut a = n;
    let mut b = 2i64;
    std::mem::swap(&mut a, &mut b);
    b == n
}
{
    n
}

fn main() {
    println("{}", f(1));
}
