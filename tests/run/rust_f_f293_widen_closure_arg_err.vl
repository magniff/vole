// (0.30.1, review 3) A closure argument's arithmetic on its parameters,
// whose i32 the call gives them from an untyped literal, reaches an i64:
// `Some(a).map(|x| x + x)` then `take(o.unwrap())` (rustc types it i64 and
// prints 4000000000). Refused: write the type.
// ERROR: widen_i32
// ERROR-COUNT: 1
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let o = Some(a).map(|x| x + x);
    println("{}", take(o.unwrap()));
}
