// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 2
// EXPECT: 2
use std::alloc::Allocator; struct P<'a, A: Allocator> { q: &'a mut Vec<i64, A> }
impl<'a> P<'a, Gpa> { fn add(&mut self, x: i64) { self.q.push(x); } }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut p = P { q: &mut v };
    p.add(1);
    p.add(2);
    println("{}", v.len());
    0
}
