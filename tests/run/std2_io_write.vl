// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Write.
// EXPECT: [104, 105]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn put<W: Write>(w: &mut W) {
    w.write_all("hi".as_bytes()).unwrap();
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    put(&mut v);
    println("{:?}", v);
}
