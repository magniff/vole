// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::io Write.
// EXPECT: [104, 105]
use std::io::{ErrorKind, Write};

fn put<W: Write>(w: &mut W) {
    w.write_all("hi".as_bytes()).unwrap();
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    put(&mut v);
    println("{:?}", v);
}
