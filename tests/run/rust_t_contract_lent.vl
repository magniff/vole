// EDITION: rust
// RULE: D17.1
// (0.27.1) A contracted function taking `&i64` and `&mut Vec`: its
// clauses read through both, and `volec test` lends each a generated
// value (tests/refactor/testrust.t); a failing `requires` names its
// clause.
// EXPECT: 3 4
// EXPECT: 2
// EXIT: 101
// STDERR: requires failed: '* k >= 0' of 'total'
fn total(k: &i64, v: &mut Vec<i64, Gpa>) -> i64
    requires * k >= 0
    ensures result >= *k
{
    v.push(*k);
    let mut s: i64 = 0;
    for x in v.iter() {
        if *x > 0 {
            s += *x;
        }
    }
    s
}

fn grow(v: &mut Vec<i64, Gpa>, by: &i64) -> usize
    ensures result >= 1
{
    v.push(*by);
    v.len()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let k: i64 = 3;
    let t = total(&k, &mut v);
    println("{} {}", t, k + grow(&mut v, &1) as i64 - 1);
    println("{}", v.len());
    let bad: i64 = -1;
    total(&bad, &mut v);
}
// Runs on std2 since its gap closed (0.27.2).
