// XFAIL: RT-77: std's generic code (sort, cmp::max, unwrap_or_default, Option's and a slice's and a reference's ==) calls the element type's inherent cmp, max, default and eq (0.30.2)
// RT-72's mechanism (a generic body's trait call resolved again on the
// concrete type) in std's code: slice::sort_unstable sorts by S's inherent
// cmp (descending), cmp::max returns S's inherent max, unwrap_or_default
// takes S's inherent default, and Option's, a slice's and a reference's ==
// take S's inherent eq. vole: `3 2 1`, `1000`, `77`, `true true true` for
// rustc's lines below.
// EXPECT: 1 2 3
// EXPECT: 2
// EXPECT: 1
// EXPECT: false false false
use std::cmp::Ordering;

#[derive(Clone, Copy, PartialEq, Eq, PartialOrd)]
struct S {
    k: i64,
}

impl S {
    fn cmp(&self, other: &S) -> Ordering {
        other.k.cmp(&self.k)
    }

    fn max(self, other: S) -> S {
        S { k: 1000 }
    }

    fn default() -> S {
        S { k: 77 }
    }
}

impl Ord for S {
    fn cmp(&self, other: &S) -> Ordering {
        self.k.cmp(&other.k)
    }
}

impl Default for S {
    fn default() -> S {
        S { k: 1 }
    }
}

#[derive(Clone, Copy)]
struct E {
    k: i64,
}

impl E {
    fn eq(&self, other: &E) -> bool {
        true
    }
}

impl PartialEq for E {
    fn eq(&self, other: &E) -> bool {
        self.k == other.k
    }
}

fn main() {
    let mut a = [S { k: 3 }, S { k: 1 }, S { k: 2 }];
    a.sort_unstable();
    println("{} {} {}", a[0].k, a[1].k, a[2].k);
    println("{}", std::cmp::max(S { k: 1 }, S { k: 2 }).k);
    let o: Option<S> = None;
    println("{}", o.unwrap_or_default().k);
    let x = E { k: 1 };
    let y = E { k: 2 };
    let u = [x, x];
    let v = [x, y];
    println("{} {} {}", Some(x) == Some(y), u[..] == v[..], &x == &y);
}
