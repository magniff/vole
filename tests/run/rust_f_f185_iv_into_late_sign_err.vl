// RULE: F18.5
// (0.30.2) `let r: i64 = a.into()` of an integer variable a later use
// makes u64: From<u64> for i64 does not hold, rustc's E0277.
// ERROR: the trait 'From<u64>' is not implemented for 'i64' (rustc E0277)
fn main() {
    let a = 18446744073709551615;
    let r: i64 = a.into();
    let c: u64 = a;
    println("{} {}", r, c);
}
