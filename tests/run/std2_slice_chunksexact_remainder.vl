// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice ChunksExact::remainder.
// EXPECT: [4, 5] []

fn main() {
    let s: &[i64] = &[1, 2, 3, 4, 5];
    let t: &[i64] = &[1, 2];
    println("{:?} {:?}", s.chunks_exact(3).remainder(), t.chunks_exact(2).remainder());
}
