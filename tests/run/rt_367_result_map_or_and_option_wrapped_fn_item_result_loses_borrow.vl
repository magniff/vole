// XFAIL: RT-367: UNSOUND: (RT-309/310's root, more forms) a fn item whose result borrows its argument keeps no borrow through Result::map_or (`r.map_or(&Z, idr)`), and a fn item returning `Option<&'a i64>` keeps none through Iterator::find_map and Option::and_then: use after free (0.30.2)
// rustc E0505 at each drop (twin .rs.txt). vole checks it clean;
// --check-alloc: use after free, block #1 freed at the first drop. Each
// form alone (scratch fa/b13a, b13b, b13c) is a use after free on
// v0.28.0 to v0.30.1 and the release build. RT-309 lists Result's
// and_then, map_or_else, unwrap_or_else, map_err, or_else (not map_or);
// RT-297/310 have and_then and find_map with `&'a i64` results, not an
// Option-wrapped one.
// FLAGS: --check-alloc
// ERROR: line 35
// ERROR: line 36
// ERROR: line 37
// ERROR-COUNT: 3
static Z: i64 = 0;

fn idr<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn idr3<'a>(x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r: Result<&i64, i64> = Ok(&v[0]);
    let a = r.map_or(&Z, idr);
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(2000);
    let b = u.iter().find_map(idr3);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(3000);
    let c = w.first().and_then(idr3);
    drop(v);
    drop(u);
    drop(w);
    println("{} {:?} {:?}", a, b, c);
}
