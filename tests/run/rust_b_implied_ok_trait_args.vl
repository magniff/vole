// EDITION: rust
// RULE: D4.6
// (0.27.2.1) A bound's trait argument, `B: Make<S::Item>`: the one impl
// for B (`impl<T> Make<T> for Bag<T>`) says B's T is S's item, so
// `B::make(s)` stores S's items in B, as `collect` does.
// EXPECT: q
trait Src {
    type Item;
    fn take(&mut self) -> Option<Self::Item>;
}

struct One<'a> {
    s: Option<&'a str>,
}

impl<'a> Src for One<'a> {
    type Item = &'a str;
    fn take(&mut self) -> Option<&'a str> {
        let r = self.s;
        self.s = Option::None;
        r
    }
}

trait Make<T> {
    fn make<I: Src<Item = T>>(i: I) -> Self;
}

struct Bag<T> {
    x: Option<T>,
}

impl<T> Make<T> for Bag<T> {
    fn make<I: Src<Item = T>>(i: I) -> Bag<T> {
        let mut i = i;
        Bag { x: i.take() }
    }
}

fn gather<B: Make<S::Item>, S: Src>(s: S) -> B {
    B::make(s)
}

fn main() {
    let b: Bag<&str> = gather(One { s: Option::Some("q") });
    println("{}", b.x.unwrap());
}
