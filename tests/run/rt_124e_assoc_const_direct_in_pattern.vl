// XFAIL: RT-124e: (RT-124's mechanism, a pattern) a trait's associated constant written directly as a match pattern, `S::C =>`, is refused, "expression is not a compile-time constant"; rustc prints `seven` (0.30.2)
// From the third round of the g302qual review. Since v0.30.1 at least.
// rt_124b has the constant reached through a const item; the qualified
// form `<S as Mk>::C =>` does not parse (RT-472).
// EXPECT: seven
trait Mk {
    const C: i64;
}

struct S;

impl Mk for S {
    const C: i64 = 7;
}

fn main() {
    let v: i64 = 7;
    match v {
        S::C => println("seven"),
        _ => println("other"),
    }
}
