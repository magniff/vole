// EXPECT: 5
// (re-review of M2, C1, form i03) `G::Output` under `G: FnOnce() -> i64`: the
// sugar's Output, which no trait bound declares (the branch at d7f4aba3e
// refused it as E0220; v0.30.1 and rustc accept it).
fn once<G: FnOnce() -> i64>(g: G) -> G::Output {
    g()
}

fn main() {
    println("{}", once(|| 5i64));
}
