// RULE: F8.4
// `<W<_> as Mk>::mk()`: a self type whose argument is a hole is not refused (rustc `5`). A guard: v0.30.1 did not parse it.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// EXPECT: 5
trait Mk {
    fn mk() -> Self;
    const C: i64;
    type Out;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }

    const C: i64 = 7;
    type Out = i64;
}

fn main() {
    let x: W<u8> = <W<_> as Mk>::mk();
    println("{}", x.k);
}
