pub fn run(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i * i);
    }
    let mut sum: i64 = 0;
    for &x in v.as_slice() {
        sum += x;
    }
    print("{}", (sum + 0));
    unsafe { std::print_cstr(c"\n"); }
    match v.pop() {
        Option::Some(last) => { print("{}", (last / 4)); unsafe { std::print_cstr(c"\n"); } }
        Option::None => {}
    }
}
