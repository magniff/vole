// EDITION: rust
// XFAIL: gap 3: compile closure.sig: type mismatch in closure arguments: this parameter is written 'i64', but the bound of...
// one generic instantiated with a plain T and an owned T, conventions per instance
// FLAGS: --check-alloc
// EXPECT: 10 2 1
fn both<T, F: Fn(&T) -> i64>(x: &T, f: F) -> i64 { f(x) + f(x) }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    println("{} {} {}", both(&5i64, |x: i64| x), both(&v, |w: Vec<i64, Gpa>| w.len() as i64),
        v.len());
}
