// XFAIL: RT-78: a move closure that uses a field of a value with a Drop impl takes the whole value: the value is dropped with the closure, not at the end of its scope (0.30.2)
// Rust 2021 captures the place a closure uses: `move || d.k * 2` copies d.k
// (an i64) and d stays in main, dropped at main's end; `move || p.n +
// p.d.k` copies p.n and p.d.k. vole captures whole variables (a known cut,
// docs/releases.md: "a program rustc accepts can be refused"), and here it
// is not refused: it moves d into the closure, so `drop(c)` drops d, and
// the program prints `drop D1` before `after drop(c)`. The output of a valid
// program changes with no error (guide rust: "each is an error that names
// the fix, not another meaning"). rustc --edition 2021 prints the EXPECT.
// EXPECT: call 2
// EXPECT: after drop(c)
// EXPECT: call 7
// EXPECT: after drop(c2)
// EXPECT: end
// EXPECT: drop D2
// EXPECT: drop D1
struct D {
    k: i64,
    name: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop D{}", self.k);
    }
}

struct P {
    d: D,
    n: i64,
}

fn main() {
    let d = D { k: 1, name: 0 };
    let c = move || d.k * 2;
    println("call {}", c());
    drop(c);
    println("after drop(c)");
    let p = P { d: D { k: 2, name: 0 }, n: 5 };
    let c2 = move || p.n + p.d.k;
    println("call {}", c2());
    drop(c2);
    println("after drop(c2)");
    println("end");
}
