// EXPECT: 8
// (RT-426) `T::Out` under `T: Sub` of `trait Sub: Tr`, Tr's Out given by
// a blanket impl, W also with Tr2's Out = u8: Tr's, i64 (v0.30.1 took
// Tr2's type in silence: size 1).
trait Tr2 {
    type Out;
}

trait Tr {
    type Out;
}

trait Sub: Tr {}

struct W {
    a: i64,
}

impl Tr2 for W {
    type Out = u8;
}

impl<T: Copy> Tr for T {
    type Out = i64;
}

impl Sub for W {}

impl Clone for W {
    fn clone(&self) -> W {
        *self
    }
}

impl Copy for W {}

fn sz<T: Sub>(t: &T) -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    println("{}", sz(&W { a: 1 }));
}
