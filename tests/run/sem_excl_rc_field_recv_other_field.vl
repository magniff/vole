// receiver a.b, argument &a.c: disjoint
// EXPECT: 2 10
#[derive(Clone, Copy)] struct B { n: i64 }
impl B { fn f(&mut self, x: &mut i64) { self.n += 1; *x += 10; } }
#[derive(Clone, Copy)] struct A { b: B, c: i64 }
fn main() { let mut a = A { b: B { n: 1 }, c: 0 }; a.b.f(&mut a.c); println("{} {}", a.b.n, a.c); }
