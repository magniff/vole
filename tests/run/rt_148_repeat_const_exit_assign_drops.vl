// RULE: F34.4, F35.2 (0.30.2, RT-302, RT-148) A constant's value is a body of
// its own: a `return` in it is refused (rustc E0572), so a `[C; N]` part
// built never sees its constant leave the using function.
// `x = [C; 4]` of a constant whose value returns on its third evaluation
// (e20 of the g302copy-148 re-review): v0.30.1 and 10d65043a dropped the
// first element three times (its copies in the elements not yet made).
// The places IR's guard (repeat_each, emit_guard) drops exactly the
// elements made on any exit as well: with the refusal off, this program
// drops each value once and frees each block once.
// ERROR: line 22
// ERROR-COUNT: 1
struct D { k: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.k); } }
static mut CNT: i64 = 0;

fn side() -> i64 {
    // UNSAFE: test counter
    // SAFETY: single thread
    unsafe { CNT = CNT + 1; CNT }
}

const C: D = { let c = side(); if c == 3 { return; } D { k: c } };

fn run() {
    let mut x = [D { k: 10 }, D { k: 20 }, D { k: 30 }, D { k: 40 }];
    x = [C; 4];
    println("run {}", x[0].k);
}

fn main() { run(); println("end"); }
