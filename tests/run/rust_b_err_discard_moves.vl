// ERROR-COUNT: 11
use std::alloc::Allocator;

struct P {
    v: i64,
}

struct Q<A: Allocator> {
    b: Box<i64, A>,
}

fn takep(p: P) {
    println("took {}", p.v);
}

fn e01() {
    let p = P { v: 1 };
    { p };
    takep(p);
}

fn e02() {
    let p = P { v: 1 };
    p;
    takep(p);
}

fn e03() {
    let mut a = 1;
    let r = &mut a;
    { r };
    *r = 2;
}

fn e04() {
    let mut a = 1;
    let r = &mut a;
    r;
    *r = 2;
}

fn e05(c: bool) {
    let p = P { v: 1 };
    if c { p } else { P { v: 2 } };
    takep(p);
}

fn e06() {
    let p = P { v: 1 };
    unsafe { p };
    takep(p);
}

fn e07() {
    let p = P { v: 1 };
    loop { break p; };
    takep(p);
}

fn e08(p: &P) {
    { p.v };
    { *p };
}

fn let_wild_block() {
    let p = P { v: 1 };
    let _ = { p };
    takep(p);
}

fn boxed(q: Q<Gpa>) {
    q;
    println("{}", *q.b);
}

fn drops(d: D) {
    { d };
    println("{}", d.v);
}

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn main(gpa: Gpa) {
    e01();
    e02();
    e03();
    e04();
    e05(true);
    e06();
    e07();
    e08(&P { v: 1 });
    let_wild_block();
    boxed(Q { b: Box::new_in(1, gpa) });
    drops(D { v: 3 });
}
