// RULE: D2.10
// (0.30.1) What a packed struct's fields still allow, as rustc: a copy of
// a field, a reference to a field whose alignment the packing meets (a
// byte, a byte array), a raw address, a reference to a field of what a
// packed struct's field points to, and a whole packed struct borrowed.
// EXPECT: 2 1 [3, 4] true 9 3

#[repr(C, packed)]
struct P<'a> {
    a: u8,
    x: i64,
    b: [u8; 2],
    r: &'a Q,
}

struct Q {
    y: i64,
}

fn whole(p: &P) -> u8 {
    p.a
}

fn main() {
    let q = Q { y: 9 };
    let p = P { a: 1, x: 2, b: [3, 4], r: &q };
    let x = p.x;
    let ra = &p.a;
    let rb = &p.b;
    let px = &raw const p.x;
    let y = px as usize != 0;
    let rr = p.r;
    let ry = &rr.y;
    println("{x} {} {:?} {y} {} {}", *ra, *rb, *ry, whole(&p) + 2);
}
