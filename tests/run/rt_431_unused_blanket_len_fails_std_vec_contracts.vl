// XFAIL: RT-431: WRONG CODE: a blanket `impl<X> H for X { fn len(&self) -> usize { 7 } }` in a module nothing imports makes the first `v.push(1)` of a Vec panic: std's contract `debug ensures self.capacity() >= self.len() + extra` of Vec::reserve evaluates `self.len()` as H::len (7), "ensures failed ... self.capacity() = 4", exit 101 (0.30.2)
// rustc: exit 21 (twin .rs.txt). vole: `<std>:5260:9: ensures failed:
// 'self.capacity() >= self.len() + extra' of 'Vec<i64, Gpa>::reserve':
// self.capacity() = 4`, exit 101, at -O0 and -O2; v0.28.0 to v0.30.1 the
// same (at that release's line of reserve). With `len` returning 1 the
// panic is Vec::truncate's `ensures self.len() <= n`; with 0 the
// contracts pass (scratch q1/sh.vl). A program's own `v.len()` takes Vec's
// inherent len: the contracts' method calls are resolved by name and take
// a blanket impl's method before the inherent one (R302I-13 is the same
// reach into std's generic bodies).
// EXIT: 21
mod hidden {
    pub trait H {
        fn len(&self) -> usize;
    }

    impl<X> H for X {
        fn len(&self) -> usize {
            7
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let a = v.len();
    v.truncate(1);
    let b = v.len();
    v.clear();
    (a * 10 + b) as i32 + v.len() as i32 * 100
}
