// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::inspect.
// EXPECT: saw 3
// EXPECT: Ok(3)
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let c = a.inspect(|x| println("saw {}", x));
    let _ = b.inspect(|x| println("saw {}", x));
    println("{:?}", c);
}
