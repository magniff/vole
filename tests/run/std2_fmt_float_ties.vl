// The std2 item(s): f64's Display, Debug and LowerExp of a value that lies
// exactly between two shortest candidates (17 digits, the last a tie): the
// upper one, as Rust's flt2dec (0.28.0: std2 took the even one).
// EXPECT: -235497785839029.63 -235497785839029.63 -2.3549778583902963e14
// EXPECT: 99645338404625.13 99645338404625.13 9.964533840462513e13
// EXPECT: 87873670428181.63 87873670428181.63 8.787367042818163e13
// EXPECT: 1624693238624808.3 1624693238624808.3 1.6246932386248083e15
// EXPECT: -653908467105627.3 -653908467105627.3 -6.539084671056273e14
// EXPECT: -15212665596375.313 -15212665596375.313 -1.5212665596375313e13
// EXPECT: 906579488978323.3 906579488978323.3 9.065794889783233e14
// EXPECT: 1423617182840764.3 1423617182840764.3 1.4236171828407643e15
// EXPECT: 1.0000000000000002 1.0000000000000002 1.0000000000000002e0
// EXPECT: 9007199254740994 9007199254740994.0 9.007199254740994e15
// EXPECT: 0.30000000000000004 100000000000000000000000 0.
fn main() {
    let bits: [u64; 10] = [
        0xc2eac5e33bd9b6b4, 0x42d6a81f3ff1c448, 0x42d3faebba4d8568, 0x431716997d6dc8a1,
        0xc30295cf6f2dfada, 0xc2ababf30ed3aea0, 0x4309c43be335ac9a, 0x43143b16d1eadef1,
        0x3ff0000000000001, 0x4340000000000001,
    ];
    for b in bits {
        let v = f64::from_bits(b);
        println("{} {:?} {:e}", v, v, v);
    }
    println("{} {} {}", 0.1 + 0.2, 1e23, 5e-324);
}
