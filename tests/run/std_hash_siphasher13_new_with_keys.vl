// Runs on std since 0.27.2's switch.
// The std item(s): std::hash SipHasher13::new_with_keys.
// EXPECT: 13851880170939887858 false
// RUSTC: none (SipHasher13 is std's; its values are Rust's DefaultHasher's (SipHash-1-3, keys 0 and 0))
use std::hash::{Hash, Hasher, SipHashState, SipHasher13};

fn main() {
    let mut a = SipHasher13::new_with_keys(0, 0);
    a.write("abc".as_bytes());
    let mut b = SipHasher13::new_with_keys(3, 4);
    b.write("abc".as_bytes());
    println("{} {}", a.finish(), a.finish() == b.finish());
}
