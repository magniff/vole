// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a09_fnptr_cell)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'w', a fn value that may call a function which writes through a shared reference (a cell)
// A fn pointer, called in the clause, sets a Cell.
use std::cell::Cell;

fn poke(c: &Cell<i64>) -> bool {
    c.set(9);
    true
}

fn f(c: &Cell<i64>, w: fn(&Cell<i64>) -> bool) -> i64
    requires w(c)
{
    1
}

fn main() {
    let c = Cell::new(1i64);
    println("{}", f(&c, poke));
    println("{}", c.get());
}
