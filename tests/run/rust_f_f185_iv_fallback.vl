// RULE: F18.5
// (0.30.2) An integer variable nothing types is i32, rustc's fallback,
// decided when the function's check ends; one a later use types takes
// that type, whatever came before it (a cast's operand, a format hole).
// EXPECT: 5
// EXPECT: 4 8 4 8
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 5;
    let b = 5;
    println("{b}");
    let c = b as u8;
    take(b);
    let d = 7;
    let e = d as i64;
    let f = 9;
    let g = [f, 1];
    take(g[1]);
    println("{} {} {} {}", std::mem::size_of_val(&a), std::mem::size_of_val(&b),
        std::mem::size_of_val(&d), std::mem::size_of_val(&f) + 0 * (c as usize) + 0 * (e as usize));
}
