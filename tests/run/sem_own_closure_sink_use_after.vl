// EDITION: rust
// sem-own: a local moved into a sink closure is dead: own.moved.
// ERROR: error[borrowck.use_moved]
// RUSTC: accepts L7 whole-variable capture; Rust 2021 captures the disjoint field
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let d = mk(1, gpa);
    let f = move || d.id;
    println("{} {}", d.id, f());
}
