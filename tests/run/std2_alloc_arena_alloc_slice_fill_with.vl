// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Arena::alloc_slice_fill_with.
// EXPECT: [0, 1, 4, 9]
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let s = arena.alloc_slice_fill_with(4, |i| (i * i) as i64);
    println("{:?}", s);
}
