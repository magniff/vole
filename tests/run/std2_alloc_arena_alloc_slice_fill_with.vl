// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Arena::alloc_slice_fill_with.
// EXPECT: [0, 1, 4, 9]
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let s = arena.alloc_slice_fill_with(4, |i| (i * i) as i64);
    println("{:?}", s);
}
