// EDITION: rust
// RULE: D8.1
// (0.27.2) `let ok = a && b;` and `let c = a || b || d;` initialize their
// binding once on each path: the left operand is a temporary, the
// binding assigned where the operator decides (std2's str::from_utf8 and
// str's Debug have these shapes; 0.27.1 reported borrowck.assign_twice).
fn digit(c: u8) -> bool {
    let ok = c >= 48 && c <= 57;
    ok
}

fn space(c: u8) -> bool {
    let s = c == 32 || c == 9 || c == 10;
    s
}

fn main() {
    let mut n = 0;
    let mut i: u8 = 0;
    while i < 128 {
        let both = digit(i) || space(i);
        if both {
            n += 1;
        }
        i += 1;
    }
    println("{}", n);
}
// EXPECT: 13
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
