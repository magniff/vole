// EDITION: rust
// RULE: F15.1, FL1
// (0.27.4) A type variable solved through an impl's existence: the
// literal `5` meets `T: Width`, whose one impl is for u16, and is a u16;
// its Display, a builtin impl, is there because the program names u16.
// EXPECT: 5 16 2
use std::fmt::Display;

trait Width {
    fn bits(self) -> u32;
}

impl Width for u16 {
    fn bits(self) -> u32 {
        16
    }
}

fn show<T: Width + Display + Copy>(x: T) {
    println("{} {} {}", x, x.bits(), std::mem::size_of::<T>());
}

fn main() {
    show(5);
}
