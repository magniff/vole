// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter Iterator::skip_while.
// EXPECT: [3, 4, 1]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4, 1], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().skip_while(|x| *x < 3).collect_in(gpa);
    println("{:?}", a);
}
