// 0.25.3: `m.values(name)` and `m.get_as(name)` of a flag fail as `get`
// does (cli.kind), at the caller's line.
// ARGS: -v
// EXIT: 101
// STDERR: cli_0253_flag_values.vl:12:14: cli.kind: m.values(NAME) of a flag, which has no value (it would always be empty): read a flag with m.flag(NAME), m.count(NAME)
use std::env;
use std::cli::{Arg, Command};

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("t", gpa).arg(Arg::flag("verbose").short('v'));
    let m = cmd.parse_or_exit(env::args());
    let vs = m.values("verbose");
    vs.len() as i32
}
