// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::from_utf8.
// EXPECT: Ok("ok") true
use std::str::CharIndices;

fn main() {
    let b: &[u8] = &[111, 107];
    let r = str::from_utf8(b);
    println("{:?} {}", r, str::from_utf8(&[0xC0, 0x80]).is_err());
}
