// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a13 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 99 true true 77
// EXPECT: 1 false false 0
#[derive(Clone, PartialEq, Default)]
struct S { k: i64 }

impl S {
    fn clone(&self) -> S { S { k: 99 } }
    fn eq(&self, o: &S) -> bool { true }
    fn default() -> S { S { k: 77 } }
}

fn cl<T: Clone>(x: &T) -> T { x.clone() }
fn same<T: PartialEq>(a: &T, b: &T) -> bool { a.eq(b) }
fn same2<T: PartialEq>(a: &T, b: &T) -> bool { a == b }
fn df<T: Default>() -> T { T::default() }

fn main() {
    let a = S { k: 1 }; let b = S { k: 2 };
    println("{} {} {} {}", cl(&a).k, same(&a, &b), same2(&a, &b), df::<S>().k);
}
