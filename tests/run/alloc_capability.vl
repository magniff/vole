// (0.26.3) Allocation as a capability: a type holding an allocator names
// it in its parameters (`Parser<A>`, used as `Parser<Gpa>`), a struct
// literal infers it from its fields, a static holds only what holds no
// allocator, and an `_in` function takes its allocator last. A literal of
// fields that are all `_in` calls infers the allocator from their last
// argument, and `Pool::make(gpa)` is the one instance impl's function.
// EXPECT: 3 6 1
// EXPECT: [7, 8]
// EXPECT: 2 ab
use std::alloc::Allocator; struct Parser<A: Allocator> {
    toks: Vec<i64, A>,
    at: i64,
}

impl<A: Allocator> Parser<A> {
    fn push(&mut self, t: i64) {
        self.toks.push(t);
    }
}

enum Msg<A: Allocator> {
    Quit,
    Text(String<A>),
}

struct Pool<A: Allocator> {
    items: Vec<i64, A>,
    names: String<A>,
}

impl Pool<Gpa> {
    fn make(gpa: Gpa) -> Pool<Gpa> {
        let mut p = Pool { items: Vec::new_in(gpa), names: String::new_in(gpa) };
        p.items.push(1);
        p.items.push(2);
        p.names.push_str("ab");
        p
    }
}

static mut CALLS: i64 = 0;

fn parser_in<A: Allocator>(first: i64, a: A) -> Parser<A> {
    unsafe { CALLS += 1; }
    let mut toks: Vec<i64, A> = Vec::new_in(a);
    toks.push(first);
    Parser { toks: toks, at: 0 }
}

fn pair_in<A: Allocator>(x: i64, y: i64, a: A) -> Vec<i64, A> {
    let mut v: Vec<i64, A> = Vec::new_in(a);
    v.push(x);
    v.push(y);
    v
}

fn main(gpa: Gpa) {
    let mut p = parser_in(1i64, gpa);
    p.push(2);
    p.push(3);
    let mut b: String<Gpa> = String::new_in(gpa);
    b.push_str("hi");
    let m: Msg<Gpa> = Msg::Text(b);
    let n = match m {
        Msg::Text(t) => t.len() as i64,
        Msg::Quit => 0,
    };
    println("{} {} {}", p.toks.len(), p.toks.iter().copied().sum::<i64>(),
        unsafe { CALLS } + n - 2);
    println("{:?}", pair_in(7i64, 8i64, gpa));
    let q = Pool::make(gpa);
    println("{} {}", q.items.len(), str::from_utf8(q.names.as_bytes()).unwrap());
}
