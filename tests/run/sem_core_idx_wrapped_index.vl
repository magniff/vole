// i + 1 that wrapped to i64::MIN.
// EXIT: 101
// STDERR: index out of bounds: index -9223372036854775808, length 3
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static var Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    Z = std::env::args().len() as i64 - 1;
    let a = [1, 2, 3];
    let i = 9223372036854775807 + Z;
    println(a[i + 1]);
    println("not reached");
    0
}
