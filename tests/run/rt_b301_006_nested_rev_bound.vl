        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev());
    let t = total(a
        .iter()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
