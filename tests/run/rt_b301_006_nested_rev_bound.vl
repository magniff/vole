// XFAIL: RT-B301-6: about 32 nested Rev adapters are a false "DoubleEndedIterator is not implemented" (open, 0.30.2)
// `a.iter().rev().rev()...` 141 deep, given where a DoubleEndedIterator
// goes: rustc accepts it (prints 18 6); vole says the bound of `rev` is not
// met for Rev<Rev<...>> (trait.unmet; 0.30.0 the same): a depth limit in
// the trait solver answering no.
// EXPECT: 18 6
fn total<'a, I: DoubleEndedIterator<Item = &'a i64>>(it: I) -> i64 {
    let mut s = 0; for x in it.rev() { s += *x; } s
}

fn main() {
    let a = [1i64, 2, 3];
    let s = total(a
        .iter()
        .chain(a.iter())
        .chain(a.iter())
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
        .rev()
