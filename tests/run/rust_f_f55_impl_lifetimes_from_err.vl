// RULE: F5.5
// (0.30.1) The trait's argument names the impl's 'a (`From<&'a str>`), the
// method asks for a 'static str: less general than the trait. rustc
// E0308.
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 1
struct N<'b> {
    s: &'b str,
}

impl<'a> From<&'a str> for N<'static> {
    fn from(s: &'static str) -> N<'static> {
        N { s: s }
    }
}

fn main() {
    let n: N<'static> = N::from("x");
    println("{}", n.s);
}
