// sem-own: a user Iterator of owned items, partly consumed by take(1): the
// iterator (and its rest) dropped once. (0.25: take is `sink self`: p moves
// into the Take, which collect_in uses up and drops, with the item it did
// not reach, before the println; the Vec then drops the one it holds.)
// EXPECT: drop 1
// EXPECT: n 1
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
struct Pop<A: Allocator> { v: Vec<D<A>, A> }

impl Iterator for Pop<Gpa> {
    type Item = D<Gpa>; fn next(&mut self) -> Option<D<Gpa>> { self.v.pop() }
}

fn main(gpa: Gpa) {
    let mut p = Pop { v: Vec::new_in(gpa) };
    p.v.push(mk(1, gpa));
    p.v.push(mk(2, gpa));
    let c: Vec<D<Gpa>, Gpa> = p.take(1usize).collect_in::<Vec<_, _>, _>(gpa);
    println("n {}", c.len());
}
