// RULE: C3.4
// (0.30.2, RT-38g) What a clause may still do with a raw pointer: read
// through it, and write what it made itself (a local, a local array
// through a `&mut`); the same output with and without --debug-contracts
// (rt_038g_d is this case with them on).
// RUSTC: none contract clauses are not Rust
// EXPECT: 6
// EXPECT: 5
fn f(p: *mut i64, n: i64) -> i64
    requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p > 0 }
}

requires {
    let mut a = [n, 2];
    a[0] += 1;
    let r = &mut a[1];
    *r = 3;
    a[0] + a[1] > 0
}

debug requires {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p < 100 }
}

ensures {
    // UNSAFE: test
    // SAFETY: test
    (unsafe { *p }) == result - n
}

{
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p + n }
}

fn main() {
    let mut x = 5i64;
    println("{}", f(&raw mut x, 1));
    println("{}", x);
}
