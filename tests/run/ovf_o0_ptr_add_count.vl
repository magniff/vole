// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: attempt to multiply with overflow
// 0.30.1: std's ptr::add computes its offset in bytes with the program's
// overflow checks, as Rust's debug add asserts it: a count whose product
// with the size wraps (to land back in the block) panics at -O0, as in
// 0.30.0. (std's add is `&p[count]`, whose index is scaled unchecked:
// the review of 0.30.1 found the check gone.)
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(4, gpa);
    for i in 0..4 {
        v.push(i);
    }
    let p = v.as_ptr();
    println("before");
    // UNSAFE: deliberately out of bounds: count * 8 overflows usize.
    // SAFETY: none: the program exists to be stopped.
    let q = unsafe { p.add(usize::MAX / 8 + 2) };
    println("at {}", q as usize - p as usize);
}
