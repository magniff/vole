// 0.18.1: a heap's peek is a copy of an element the heap keeps (as Vec's
// last): reading it is fine (0.25: a field of it too, `.pri`), moving
// it out would drop it twice.
// ERROR: error[own.move_out]: cannot move 't.peek().unwrap()' (Job<Gpa>): it is a copy of an element the collection keeps
struct Job<A: Allocator> { pri: i64, data: Vec<i64, A> }

impl Eq for Job<Gpa> {
    fn eq(self, o: Job<Gpa>) -> bool { self.pri == o.pri }
}

impl Ord for Job<Gpa> {
    fn cmp(self, o: Job<Gpa>) -> i64 { self.pri - o.pri }
}

fn keep(j: sink Job<Gpa>) -> i64 { j.pri }

fn main(gpa: Gpa) -> i32 {
    var t: MinHeap<Job<Gpa>, Gpa> = MinHeap::new_in(gpa);
    t.push(Job { pri: 1, data: Vec::new_in(gpa) });
    let n = t.peek().unwrap().pri;
    keep(t.peek().unwrap());
    0
}
