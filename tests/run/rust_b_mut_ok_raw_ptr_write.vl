// RULE: D2.7
// (0.27.2) A write through `*mut S` (R1).
struct S {
    n: i64,
}

impl S {
    fn bump(&mut self) {
        self.n += 1;
    }
}

fn main() {
    let mut a = S { n: 1 };
    let p = &mut a as *mut S;
    // SAFETY: p is a, live and not otherwise borrowed.
    unsafe {
        (*p).n = 3;
    }
    println("{}", a.n);
}
// EXPECT: 3
