// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.2
// (0.27.2.1) The hidden type `&i32` is either `x` or `y`: its one lifetime
// must be 'a or 'b, and neither outlives the other (rustc E0700).
// ERROR: error[opaque.ambiguous]
// ERROR: line 16, column 53
trait Tr {
    fn get(&self) -> i32;
}

impl<'a> Tr for &'a i32 {
    fn get(&self) -> i32 { **self }
}

fn pick<'a, 'b>(c: bool, x: &'a i32, y: &'b i32) -> impl Tr {
    if c { x } else { y }
}

fn main() {
    let a: i32 = 1;
    let b: i32 = 2;
    println("{}", pick(true, &a, &b).get());
}
