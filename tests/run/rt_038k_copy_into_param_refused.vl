// RULE: C4
// RUSTC: none contract clauses are not Rust
// (0.30.2, the re-review 3 of g302holes) rt_038k_copy_from_param_into_local
// the other way: ptr::copy_nonoverlapping into the parameter writes the
// caller's memory (memcpy's destination, a `*mut u8`, is written).
// ERROR: writes through a raw pointer what it did not make
fn go(p: *mut i64) -> bool {
    let a = 5i64;
    // UNSAFE: test
    // SAFETY: p points to a live i64
    unsafe {
        std::ptr::copy_nonoverlapping(&raw const a, p, 1);
    }
    true
}

fn f(p: *mut i64) -> i64
    requires go(p)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x));
}
