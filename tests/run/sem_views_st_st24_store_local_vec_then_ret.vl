fn f(s: &mut String<Gpa>, gpa: Gpa) -> &str {
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    v[0usize]
}

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello", gpa);
    println("{}", f(&mut s, gpa));
    0
}
