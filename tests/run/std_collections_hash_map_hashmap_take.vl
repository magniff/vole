// The std item(s): std::collections::hash_map HashMap::take.
// EXPECT: 0 1
// RUSTC: none (vole's addition: HashMap::take (Rust's mem::take))
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let t = m.take();
    println("{} {}", m.len(), t.len());
}
