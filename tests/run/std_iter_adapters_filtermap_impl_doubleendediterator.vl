// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters FilterMap::impl DoubleEndedIterator.
// EXPECT: Some(30)

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 3, -2], gpa);
    println("{:?}", s.iter().filter_map(|x| if *x > 0 { Some(x * 10) } else { None }).next_back());
}
