// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::io BufWriter::get_mut.
// EXPECT: [9]
use std::io::{BufWriter, ErrorKind};

fn main(gpa: Gpa) {
    let mut w = BufWriter::new(Vec::<u8, Gpa>::new_in(gpa));
    w.get_mut().push(9);
    println("{:?}", w.get_ref());
}
