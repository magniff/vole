// EDITION: rust
// RULE: D22.2
// (0.27.2.1) A generic impl's method no one calls: checked with the impl's
// parameter an Ω.
// EXPECT: 0
trait Show {
    fn show(&self) -> i32;
}

struct W<T> {
    t: T,
}

impl<T: Show> W<T> {
    fn get(&self) -> i32 {
        self.t.show()
    }
}

fn main() {
    println("0");
}
