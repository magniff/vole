// RULE: F20.7
// (0.28.0) `g[i] = x` through Deref writes through `deref_mut`: of a guard
// not declared `mut` it is rustc's E0596, as `(*g)[i] = x` is.
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 13, column 5
use std::sync::Mutex;

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    let m = Mutex::new(v);
    let g = m.lock().unwrap();
    g[0] = 7;
    println("{}", g[0]);
    0
}
