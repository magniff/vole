// XFAIL: gap 25: the IR, asm or places CHECK lines no longer match the translation (std2's names, the surface): to update by...
// (0.25.5) What a Vec's index costs, read through its header: the slice
// from 0 that `v[i]` takes (as_slice, `ptr[0..len]`) has len as its
// length, with no `len - 0` (middle::lower::expr::lower_slicing); and its
// ptr (u64) and len (i64), side by side, are loaded by one ldp on AArch64
// (back::isel::pair_accesses pairs two 64-bit integer loads whatever their
// signedness). The compiler's tables are static Vecs read this way.
// (0.26.3: a static holds no allocator, alloc.static: the Vec is main's,
// read through a let parameter, its header behind a pointer as a
// static's is behind its address.)
// EXPECT: 30 3
// EXPECT: 20 2
// CHECK: fn at:
// CHECK-NOT: sub
// CHECK: rt.panic
// CHECK: fn len_of:
// CHECK-NOT: sub
// CHECK: ret
// ASM(aarch64-macos): _vole.at:
// ASM(aarch64-macos): ldp x
// ASM(aarch64-macos): _vole.len_of:
use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; #[derive(Clone, Copy)] struct Heap {}

// UNSAFE: C's allocator, which Heap hands out.
// SAFETY: called with sizes checked non-negative, on blocks Heap allocated.
extern "C" {
    fn malloc(n: u64) -> *mut u8;
    fn realloc(p: *mut u8, n: u64) -> *mut u8;
    fn free(p: *mut u8);
}

// UNSAFE: a test's allocator built over C's (0.26.3: Allocator is an unsafe trait).
// SAFETY: its memory comes from C's malloc, realloc and free, aligned to 16.
unsafe impl Allocator for Heap {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
            if size < 0 {
                return NonNull::new(0 as *mut u8).ok_or(AllocError);
            }
            // UNSAFE: C's allocator.
            // SAFETY: size is checked non-negative.
            unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
        }).ok_or(AllocError)
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block.
    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr(); let old_size = __old.size() as i64;
        let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
            if new_size < 0 {
                return NonNull::new(0 as *mut u8).ok_or(AllocError);
            }
            realloc(p, if new_size == 0 { 1 } else { new_size } as u64)
        }).ok_or(AllocError)
    } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> { unsafe { self.grow(p, old, new) } }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block.
    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr(); let size = __layout.size() as i64;
        let align = __layout.align() as i64;
        free(p);
    }
}

#[inline(never)]
fn at(v: &Vec<i64, Heap>, i: i64) -> i64 {
    v[i as usize]
}

#[inline(never)]
fn len_of(p: *const i64, n: i64) -> i64 {
    // UNSAFE: a raw slice of the test's buffer.
    // SAFETY: p holds n elements (main's Vec).
    let t = unsafe { std::slice::from_raw_parts(p.add((0) as usize), (n - (0)) as usize) };
    t.len() as i64
}

fn main() {
    let mut v: Vec<i64, Heap> = Vec::new_in(Heap {});
    for i in 0..3 {
        v.push(10 * (i + 1));
    }
    println("{} {}", at(&v, v.len() as i64 - 1), v.len());
    println("{} {}", at(&v, 1), len_of(v.as_slice().as_ptr(), v.len() as i64 - 1));
}
