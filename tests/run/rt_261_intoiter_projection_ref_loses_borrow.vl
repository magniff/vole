// XFAIL: RT-261: UNSOUND: a predicate whose argument is a projection `C::Item` of `C: IntoIterator` keeps no borrow when C is a reference (`&v`, `v.as_slice()`): `B: Extend<C::Item>`, `B: FromIteratorIn<C::Item, A>`, `B: From<C::Item>` results outlive `drop(v)`, a use after free from safe code (0.30.2)
// From the review of g302bor (b/g11, g11b, g38, g48, g50, g52). rustc E0505
// at each drop. With `v.iter()` for C the same fns keep the borrow: only a
// reference C misses it. places/regions.vl proj_walk normalizes `C::Item`
// through a direct impl or one blanket impl, never a pattern impl (`impl<'a,
// T, A> IntoIterator for &'a Vec<T, A>`, `&'a [T]`), so the projection reads
// as elided and no region of C is tied (tie_all ties only named ones).
// --check-alloc: `use after free: block #11`. On v0.30.1 too. rustc: the twin
// rt_XXX_intoiter_projection_ref_loses_borrow.rs.txt (E0505 at the six drops);
// tools/rustc-twin.sh rejects the shim's text with E0277 only because its
// partition_in asks `B: Default` where vole's asks `B: DefaultIn<A>`.
// ERROR: line 71
// ERROR: line 74
// ERROR: line 77
// ERROR: line 80
// ERROR: line 83
// ERROR: line 86
// ERROR-COUNT: 6
// ERROR: error[borrowck.move_borrowed]
// RUSTC: none the shim's partition_in asks `B: Default`, vole's `B: DefaultIn<A>`: rustc's verdict is the twin rt_XXX_intoiter_projection_ref_loses_borrow.rs.txt, E0505 at the six drops
// FLAGS: --check-alloc

struct Wr<'a> {
    r: &'a i64,
}

impl<'a> From<&'a i64> for Wr<'a> {
    fn from(r: &'a i64) -> Wr<'a> {
        Wr { r: r }
    }
}

fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v
}

fn by_item<C: IntoIterator, B: DefaultIn<Gpa> + Extend<C::Item>>(c: C, a: Gpa) -> (B, B) {
    c.into_iter().partition_in(|_x| true, a)
}

fn by_qualified<C: IntoIterator, B: DefaultIn<Gpa> + Extend< <C::IntoIter as Iterator>::Item>>(c: C,
    a: Gpa) -> (B, B) {
    c.into_iter().partition_in(|_x| true, a)
}

fn by_where<C: IntoIterator, B>(c: C, a: Gpa) -> (B, B)
    where
        B: DefaultIn<Gpa>,
        B: Extend<C::Item>,
{
    c.into_iter().partition_in(|_x| true, a)
}

fn by_from_iter<C: IntoIterator, B: FromIteratorIn<C::Item, Gpa>>(c: C, a: Gpa) -> B {
    c.into_iter().collect_in(a)
}

fn by_from<C: IntoIterator, B: From<C::Item>>(c: C) -> Option<B> {
    match c.into_iter().next() {
        Some(x) => Some(B::from(x)),
        None => None,
    }
}

fn main(gpa: Gpa) {
    let v1 = mk(gpa);
    let p1: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = by_item(&v1, gpa);
    drop(v1);
    let v2 = mk(gpa);
    let p2: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = by_qualified(&v2, gpa);
    drop(v2);
    let v3 = mk(gpa);
    let p3: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = by_where(&v3, gpa);
    drop(v3);
    let v4 = mk(gpa);
    let p4: Vec<&i64, Gpa> = by_from_iter(&v4, gpa);
    drop(v4);
    let v5 = mk(gpa);
    let p5: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = by_item(v5.as_slice(), gpa);
    drop(v5);
    let v6 = mk(gpa);
    let k6: Option<Wr> = by_from(&v6);
    drop(v6);
    println("{:?} {:?} {:?} {:?} {:?} {}", p1.0, p2.0, p3.0, p4, p5.0, *k6.unwrap().r);
}
