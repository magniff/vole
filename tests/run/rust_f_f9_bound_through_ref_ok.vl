// EDITION: rust
// RULE: D22.3
// `value.fmt(f)` in a generic body with `value: &T`, `T: Debug`, is
// Debug's fmt in every instance, also when T is itself a reference (the
// probe reads `*value`): `{:?}` of an `Option<&i32>` was method.ambiguous
// among i32's formatting traits.
// EXPECT: Some(5) P { a: Some(7) }
#[derive(Debug)]
struct P<'a> {
    a: Option<&'a i32>,
}

fn main() {
    let v = 5i32;
    let x: Option<&i32> = Some(&v);
    let w = 7i32;
    let t = P { a: Some(&w) };
    println("{:?} {:?}", x, t);
}
