// EDITION: rust
// RULE: D5.2
// (0.27.1) `&'a H<'static>` given as `&'a H<'a>`: `&T` is covariant in `T`.

struct H<'a> {
    r: &'a i64,
}

static G: i64 = 9;

fn f<'a>(h: &'a H<'static>) -> &'a H<'a> {
    h
}

fn main() {
    let h = H { r: &G };
    println("{}", *f(&h).r);
}
// EXPECT: 9
