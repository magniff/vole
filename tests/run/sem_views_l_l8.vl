// EDITION: rust
// XFAIL: gap 20: xfail case fails differently after translation
#[derive(Clone, Copy)] // (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: out holds a view of e
// MVS's XFAIL: OVERSTRICT a view of a let parameter stored into an inout parameter is own.escape: the let-as-borrow rule covers results only
// ERROR: error[own.conflict]
struct E { name: [u8; 8], len: i64 }
fn keep(out: &mut Vec<&[u8], Gpa>, e: E) { out.push(&e.name[..e.len as usize]); }

fn main(gpa: Gpa) -> i32 {
    let mut e = E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 };
    let mut out: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    keep(&mut out, e);
    e.name[0] = b'J';
    println("{}", str::from_utf8(out[0usize]).unwrap());
    0
}
