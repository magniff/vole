// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set Intersection::impl Iterator.
// EXPECT: Some(2) None
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [2i64].into_iter().collect_in(gpa);
    let mut i = a.intersection(&b);
    let x = i.next();
    println("{:?} {:?}", x, i.next());
}
