// (0.30.2, review of obligations M1) The guard of the Param candidate's
// unread predicate (front::obligations::param_candidate, PRED_UNREAD):
// `T: Tr` of `trait Tr<U>` (no default: its argument cannot be read) proves
// nothing, so mid's generic check of `call2(t)`, which needs `T: Tr<i32>`,
// is unsure (D22.2) and, mid having no instance, warned generic.unchecked.
// Were the unread predicate a yes, the check would pass and say nothing.
// rustc refuses `T: Tr` (E0107, missing generics), which vole accepts
// (docs/design/obligations.md §11: the front reads it as any arguments).
// WARNING: generic.unchecked
// WARNING: line 20, column 1
// EXPECT: 1
trait Tr<U> {
    fn g(&self) -> i64;
}

fn call2<Z: Tr<i32>>(z: &Z) -> i64 {
    1
}

fn mid<T: Tr>(t: &T) -> i64 {
    call2(t)
}

fn main() {
    println("{}", 1);
}
