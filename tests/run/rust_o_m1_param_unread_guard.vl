// (0.30.2, review of obligations M1, then of M2) `T: Tr` of `trait Tr<U>`
// (no default: its argument cannot be read) was once read as Tr with any
// arguments, and the Param candidate's guard (PRED_UNREAD) kept it from
// proving `T: Tr<i32>`. Since the review of M2 it is rustc's E0107 at the
// bound (convert::bound_arity), before any proof.
// ERROR: trait 'Tr' takes 1 type argument, got 0
// ERROR-COUNT: 1
trait Tr<U> {
    fn g(&self) -> i64;
}

fn call2<Z: Tr<i32>>(z: &Z) -> i64 {
    1
}

fn mid<T: Tr>(t: &T) -> i64 {
    call2(t)
}

fn main() {
    println("{}", 1);
}
