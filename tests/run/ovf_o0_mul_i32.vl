// (0.26.3, decision 6) `a * b` of i32s panics at -O0, where the overflow
// checks are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_mul_i32.vl:17:13: attempt to multiply with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i32 = id(65536) as i32;
    let b: i32 = id(32768) as i32;
    println("before");
    let r = a * b;
    println("after {}", r);
}
