// The source has a raw 0xFF byte inside the "..." literal. rustc
// rejects a non-UTF-8 source file; vole keeps the byte and makes a
// &'static str whose bytes are [97, 255, 98], so a plain safe &str
// breaks its UTF-8 invariant (s.chars().count() is 3).
// ERROR: UTF-8
// ERROR-COUNT: 1
fn main() {
    let s: &str = "aÿb";
    println("{} {:?} {}", s.len(), s.as_bytes(), s.chars().count());
}
