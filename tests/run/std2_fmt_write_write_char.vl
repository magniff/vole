// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt Write::write_char.
// EXPECT: 3 1
use std::fmt::Write;

struct Count {
    bytes: usize,
    calls: usize,
}

impl Write for Count {
    fn write_str(&mut self, s: &str) -> std::fmt::Result {
        self.bytes += s.len();
        self.calls += 1;
        Ok(())
    }
}

fn main() {
    let mut c = Count { bytes: 0, calls: 0 };
    let _ = c.write_char('\u{20ac}');
    println("{} {}", c.bytes, c.calls);
}
