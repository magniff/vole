// a generic Drop that reads its field, T = [i64] viewing a Vec declared after it
// ERROR: [own.drop_view]
trait Show { fn show(&self) -> i64; }
impl Show for &[i64] { fn show(&self) -> i64 { self[0] } }
struct G<T: Show> { x: T }
impl<T: Show> Drop for G<T> { fn drop(&mut self) { println("drop G {}", self.x.show()); } }

fn main(gpa: Gpa) {
    let arr = [1i64, 1];
    let mut g = G { x: &arr[..] };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 { v.push(i + 1000); }
    g = G { x: v.as_slice() };
    println("end");
}
