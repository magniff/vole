// rustc E0505 at both drops (twin .rs.txt). The release build checks it
// clean and --check-alloc stops with a use after free of v's block.
// `I: Iterator<Item = X>` returning `Option<X>` keeps the borrow (refused
// right): the tuple in the equality loses it. The g302bor build (02:20)
// refuses both drops (its tie_all).
// FLAGS: --check-alloc
// ERROR: line 31
// ERROR: line 35
// ERROR-COUNT: 2
use std::alloc::Allocator;

fn firsts<I: Iterator<Item = (X, Y)>, X, Y>(mut it: I) -> Option<X> {
    it.next().map(|p| p.0)
}

fn unz<C: IntoIterator<Item = (X, Y)>, X, Y, A: Allocator + Clone>(c: C, a: A) -> (Vec<X, A>,
    Vec<Y, A>) {
    let mut p: Vec<X, A> = Vec::new_in(a.clone());
    let mut q: Vec<Y, A> = Vec::new_in(a);
    for (x, y) in c {
        p.push(x);
        q.push(y);
    }
    (p, q)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = firsts(v.iter().map(|e| (e, 1i64)));
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let s = unz(w.iter().map(|e| (e, *e)), gpa);
    drop(w);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?} {:?}", r, s.0, x);
}
