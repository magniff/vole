// RULE: C3.4
// (0.30.2, review of RT-38f) A closure in an ensures reading a Copy
// by-value parameter: its capture resolves to the view, which is made.
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
#[derive(Clone, Copy)]
struct N {
    v: i64,
}

fn f(s: N) -> i64
    ensures {
    let a = [1i64, 2];
    a.iter().all(|x| *x <= s.v)
}

{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
