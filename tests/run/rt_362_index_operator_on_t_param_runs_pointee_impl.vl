// XFAIL: RT-362: in a generic body with `T: Index<usize>` (IndexMut, AddAssign<i64>) and T = &W (or &mut V), `x[0]`, `x.index(0)`, `x[0] = 7` and `x.add_assign(7)` on the parameter x itself run W's (V's) impl, not the one for &W (&mut V); in concrete code too, `r[0]` of `r: &W` and `m[0] = 7` of `m: &mut V` (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt): the impl for the reference
// type runs at each site. vole prints `idx_par 1 idx_call 1 not_call 2`
// and `im 7 a 7 b 0` (V's IndexMut wrote a) and `aa2 a 14 b 0` (V's
// AddAssign added to a), at -O0 and -O2; v0.28.0 to
// v0.30.1 the same. Unlike RT-312 the receiver is the parameter written
// `T`: a program trait's `&self` method (`x.get_at(0)`) and a by-value
// operator method (`x.not()`) on it are right; the index operator and
// Index::index autoderef &W to W in the instance. The index operator
// does so without generics: `r[0]` with `r: &W` gives 1 and `m[0] = 7`
// with `m: &mut V` writes a (vole `concrete: r[0] 1 w[0] 1`, `concrete:
// a 7 b 0`): rustc tries Index on the base's own type first. Not RT-254
// (an inherent `index` of W) or RT-41/73/77 (inherent methods).
// EXPECT: &W: idx_par 2 idx_call 2 not_call 2
// EXPECT: iy 2
// EXPECT: im 7 a 0 b 7
// EXPECT: aa2 a 0 b 14
// EXPECT: concrete: r[0] 2 w[0] 1
// EXPECT: concrete: a 0 b 7
use std::ops::{AddAssign, Index, IndexMut, Not};

trait Iy {
    fn get_at(&self, i: usize) -> i64;
}

struct W {
    k: i64,
}

static ONE: i64 = 1;
static TWO: i64 = 2;

impl Index<usize> for W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &ONE
    }
}

impl<'a> Index<usize> for &'a W {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &TWO
    }
}

impl Not for W {
    type Output = i64;

    fn not(self) -> i64 {
        1
    }
}

impl<'a> Not for &'a W {
    type Output = i64;

    fn not(self) -> i64 {
        2
    }
}

impl Iy for W {
    fn get_at(&self, i: usize) -> i64 {
        1
    }
}

impl<'a> Iy for &'a W {
    fn get_at(&self, i: usize) -> i64 {
        2
    }
}

struct V {
    a: i64,
    b: i64,
}

impl Index<usize> for V {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a
    }
}

impl IndexMut<usize> for V {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.a
    }
}

impl<'a> Index<usize> for &'a mut V {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.b
    }
}

impl<'a> IndexMut<usize> for &'a mut V {
    fn index_mut(&mut self, i: usize) -> &mut i64 {
        &mut self.b
    }
}

impl AddAssign<i64> for V {
    fn add_assign(&mut self, r: i64) {
        self.a += r;
    }
}

impl<'x> AddAssign<i64> for &'x mut V {
    fn add_assign(&mut self, r: i64) {
        self.b += r;
    }
}

fn aa2<T: AddAssign<i64>>(mut x: T) {
    x.add_assign(7);
}

fn idx_par<T: Index<usize, Output = i64>>(x: T) -> i64 {
    x[0]
}

fn idx_call<T: Index<usize, Output = i64>>(x: T) -> i64 {
    *x.index(0)
}

fn not_call<T: Not<Output = i64>>(x: T) -> i64 {
    x.not()
}

fn iy<T: Iy>(x: T) -> i64 {
    x.get_at(0)
}

fn im<T: IndexMut<usize, Output = i64>>(mut x: T) -> i64 {
    x[0] = 7;
    x[0]
}

fn main() {
    let w = W { k: 5 };
    println("&W: idx_par {} idx_call {} not_call {}", idx_par(&w), idx_call(&w), not_call(&w));
    println("iy {}", iy(&w));
    let mut v = V { a: 0, b: 0 };
    let r = im(&mut v);
    println("im {} a {} b {}", r, v.a, v.b);
    aa2(&mut v);
    println("aa2 a {} b {}", v.a, v.b);
    let r = &w;
    println("concrete: r[0] {} w[0] {}", r[0], w[0]);
    let mut u = V { a: 0, b: 0 };
    let mut m = &mut u;
    m[0] = 7;
    println("concrete: a {} b {}", u.a, u.b);
}
