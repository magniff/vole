// XFAIL: RT-189: slice and array patterns (`[first, .., last]`, `[x, rest @ ..]`, `let [x, y @ .., z] = a`) are parse errors, and rust.md does not list them as missing (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_020_slice_patterns.rs.txt). vole:
// `expected a pattern, got '['` at lines 3, 13, 18, 21, 30. The gap is named in an
// old handoff (front280) but not in `guide rust`'s "Not in the language" table,
// and the parse error does not say the construct is missing (as `syntax.later` does).
// Since v0.28.0.
// EXPECT: 0
// EXPECT: 4
// EXPECT: 12
// EXPECT: -5
// EXPECT: 310
// EXPECT: 1023
// EXPECT: -8
// EXPECT: 72
// EXPECT: [4, 4, 6, 1]
// EXPECT: [5]
// EXPECT: 2 99 42 7
fn cls(s: &[i64]) -> i64 {
    match s {
        [] => 0,
        [x] => *x,
        [a, b] => a * 10 + b,
        [first, .., 0] => -first,
        [first, mid @ .., last] if mid.len() > 2 => first + last + mid.len() as i64 * 100,
        [_, rest @ ..] => cls(rest) + 1000,
    }
}

fn arr(a: [i64; 5]) -> i64 {
    let [x, y @ .., z] = a;
    x + z + y.iter().sum::<i64>() * 7 + y.len() as i64
}

fn muts(s: &mut [i64]) {
    if let [a, .., b] = s {
        std::mem::swap(a, b);
    }
    if let [_, m @ .., _] = s {
        for v in m.iter_mut() {
            *v *= 2;
        }
    }
}

fn strs(v: &[&str]) -> usize {
    match v {
        ["a", rest @ ..] => rest.len(),
        [.., "z"] => 99,
        [x, y] if x == y => 42,
        _ => 7,
    }
}

fn main() {
    let tests: [&[i64]; 7] = [&[], &[4], &[1, 2], &[5, 3, 0], &[1, 2, 3, 4, 9], &[1, 2, 3],
        &[8, 1, 2, 3, 0]];
    for t in tests {
        println("{}", cls(t));
    }
    println("{}", arr([1, 2, 3, 4, 5]));
    let mut m = [1i64, 2, 3, 4];
    muts(&mut m);
    println("{:?}", m);
    let mut one = [5i64];
    muts(&mut one);
    println("{:?}", one);
    println("{} {} {} {}", strs(&["a", "b", "c"]), strs(&["q", "z"]), strs(&["k", "k"]),
        strs(&["k"]));
}
