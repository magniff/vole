struct It<'a> { s: &'a [i64], i: i64 }

impl Iterator for It<'_> {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.i < self.s.len() as i64 { self.i += 1; Some(self.s[(self.i - 1) as usize]) }
        else { None }
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut it = It { s: v.as_slice(), i: 0 };
    for i in 0..100 { v.push(i); }
    println("{}", it.next().unwrap());
    0
}
