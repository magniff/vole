// (0.30.2, the re-review of g302holes: r91/r19_opaque_iter_after_main)
// EXPECT: 12 4
// A closure returning a fn's impl Iterator that holds a closure, the fn after main.
fn main() {
    let w = [1i64, 2];
    let mk = |y: i64| (it(y), move |x: i64| x + y);
    let (i, f) = mk(3);
    println("{} {}", i.sum::<i64>(), f(1));
}

fn it(n: i64) -> impl Iterator<Item = i64> {
    (0..n).map(move |x| x + n)
}
