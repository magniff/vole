// Runs on std since 0.27.3 (front273).
// The std item(s): std::convert T::impl TryInto.
// EXPECT: true false
use std::convert::{Infallible, TryFrom};

struct Pos {
    v: i64,
}

impl TryFrom<i64> for Pos {
    type Error = ();

    fn try_from(v: i64) -> Result<Pos, ()> {
        if v > 0 { Ok(Pos { v: v }) } else { Err(()) }
    }
}

fn main() {
    let a: Result<Pos, ()> = 1i64.try_into();
    let b: Result<Pos, ()> = (-1i64).try_into();
    println("{} {}", a.is_ok(), b.is_ok());
}
