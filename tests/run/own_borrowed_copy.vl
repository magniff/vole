// EDITION: rust
// XFAIL: gap 5: compile type error: no method 'clone' on type 'Order<Gpa>'
use std::alloc::Allocator; use std::collections::HashMap;
struct Order<A: Allocator> { id: i64, items: Vec<i64, A> }

fn total(list: &Vec<Order<Gpa>, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for i in 0..list.len() {
        let o = list[i].clone();
        t += o.id + o.items.len() as i64;
    }
    match list.last().cloned() {
        Some(o) => t += o.id,
        None => {}
    }
    if let Some(o) = list.last().cloned() { t += o.items.len() as i64; }
    let first = list[0usize].clone();
    t + first.id
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Order<Gpa>, Gpa> = Vec::new_in(gpa);
    let mut it: Vec<i64, Gpa> = Vec::new_in(gpa);
    it.push(5);
    v.push(Order { id: 1, items: it });
    let mut names: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    names.push(String::from_in("x", gpa));
    let n = names[0usize].clone();
    let m: HashMap<i64, Vec<u8, Gpa>, Gpa> = HashMap::new_in(gpa);
    let k = m.get(&3).cloned();
    print("{}", (total(&v) + n.len() as i64));
    println("");
    0
}
// (0.17, T7) A copy of an element a collection keeps (`list.get(i)`,
// `list.last()`, `m.get(k)`, through `if let` and `match` too) is borrowed:
// it is not dropped, so --check-alloc sees no double free.
// FLAGS: --check-alloc
