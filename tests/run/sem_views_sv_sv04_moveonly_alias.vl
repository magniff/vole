// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: v reached directly while P's inout field is live
// ERROR: error[own.conflict]
struct P<A: Allocator> { q: inout Vec<i64, A> }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    var p = P { q: &v };
    v.push(1);
    p.q.push(2);
    println(v.len());
    0
}
