// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str IntErrorKind.
// EXPECT: Empty InvalidDigit PosOverflow NegOverflow true
// RUSTC: none (std2 has no std::num: the parse errors are std::str's)
use std::str::IntErrorKind;

fn main() {
    let a = *"".parse::<i8>().unwrap_err().kind();
    let b = *"1x".parse::<i8>().unwrap_err().kind();
    let c = *"200".parse::<i8>().unwrap_err().kind();
    let d = *"-200".parse::<i8>().unwrap_err().kind();
    println("{:?} {:?} {:?} {:?} {}", a, b, c, d, a == IntErrorKind::Empty);
}
