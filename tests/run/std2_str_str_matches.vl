use std::str::CharIndices;

fn main() {
    let mut n = 0;
    for _ in "abababa".matches("ab") {
        n += 1;
    }
    let mut e = 0;
    for _ in "abc".matches("") {
        e += 1;
    }
    println("{} {}", n, e);
}
