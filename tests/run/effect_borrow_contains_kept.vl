// XFAIL: E1.8: [T]::contains has `addr` (its iteration's pointers), so a borrow of the loop's variable given to it loses the proof: a false `diverge` (0.30.2)
// A borrow given to a callee keeps the local's proofs only when the
// callee's set lacks `addr` and it cannot carry the reference out.
// `s.contains(&i)` cannot carry it out (its result is a bool), but its
// set has `addr`, from the slice iteration's raw pointers, so the counted
// loop is `diverge` and the declaration refused; 0.30.0 accepted it. The
// fix: a callee's `addr` from pointers it makes of its own locals and of
// what it was not given should not count for an argument (0.30.2).
// EXPECT: 3 3

#[effects(alloc(Gpa), panic)]
fn chained(n: i64, gpa: Gpa) -> usize {
    let mut i: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while i < n {
        v.push(i);
        if v.as_slice().contains(&i) {}
        i += 1;
    }
    v.len()
}

#[effects(alloc(Gpa), panic)]
fn bound(n: i64, gpa: Gpa) -> usize {
    let mut i: i64 = 0;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while i < n {
        v.push(i);
        let s = v.as_slice();
        if s.contains(&i) {}
        i += 1;
    }
    v.len()
}

fn main(gpa: Gpa) {
    println("{} {}", chained(3, gpa), bound(3, gpa));
}
