// EDITION: rust
// using the scrutinee inside an arm while its inout binding is live
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 10, column 41
#[derive(Clone, Copy)] enum E { A(i64), B }
fn get(e: E) -> i64 { match e { E::A(n) => n, E::B => 0 } }

fn main() {
    let mut e = E::A(1i64);
    match &mut e { E::A(n) => { let k = get(e); *n += k; } E::B => {} } println("{}", get(e));
}
