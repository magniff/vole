// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::last.
// EXPECT: Some(4) None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{:?} {:?}", v.iter().last(), e.iter().last());
}
