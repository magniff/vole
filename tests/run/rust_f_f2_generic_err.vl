// EDITION: rust
// RULE: F2.3
// A generic impl of a trait with a supertrait: `W<T>: Base` holds only
// for `T: Show`, which this impl's `T` does not promise.
// ERROR: error[trait.unmet]: 'Derived' requires 'W<T>: Base', which is not implemented
trait Show {
    fn show(&self) -> i64;
}

trait Base {}

trait Derived: Base {
    fn twice(&self) -> i64;
}

struct W<T> {
    x: T,
}

impl<T: Show> Base for W<T> {}

impl<T> Derived for W<T> {
    fn twice(&self) -> i64 {
        2
    }
}

fn main() -> i64 {
    0
}
