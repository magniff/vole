// RULE: C3.4
// (0.30.2, the re-review of g302holes: ov/s03_option_result_slice)
// RUSTC: none contract clauses are not Rust
// EXPECT: Some(3)
// The same ensures as s01, the struct holding an array: accepted?
struct Stack {
    items: [i64; 2],
    n: usize,
}

impl Stack {
    fn top(&self) -> Option<i64>
        ensures result.iter().all(|x| *x >= 0)
    {
        if self.n > 0 { Some(self.items[self.n - 1]) } else { None }
    }
}

fn main() {
    let s = Stack { items: [3, 4], n: 1 };
    println("{:?}", s.top());
}
