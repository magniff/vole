// EDITION: rust
// sem-own: a sink closure created on one branch only (a conditional move of d).
// EXPECT: drop 3
// EXPECT: r 3
// EXPECT: n
// EXPECT: drop 4
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn call<F: FnMut() -> i64>(f: F) -> i64 { f() }

fn run(id: i64, c: bool, gpa: Gpa) {
    let d = mk(id, gpa);
    if c { let r = call(move || d.id); println("r {r}"); } else { println("n"); }
}

fn main(gpa: Gpa) { run(3, true, gpa); run(4, false, gpa); }
