// (0.30.2, RT-47's family) argc and argv with a `Result<(), E>` result:
// an Err prints `Error: {e:?}` and exits 1.
// ARGS: a b
// EXPECT: 3
// STDERR: Error: "three"
// EXIT: 1
fn main(argc: i32, argv: *const *const u8) -> Result<(), &'static str> {
    let _ = argv;
    println("{argc}");
    if argc == 3 {
        return Err("three");
    }
    Ok(())
}
