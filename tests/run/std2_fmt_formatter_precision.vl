// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::fmt Formatter::precision.
// EXPECT: None Some(3) None false false false false
use std::fmt::{Display, Formatter};

struct Spec;

impl Display for Spec {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        let (w, p, a, alt) = (f.width(), f.precision(), f.align(), f.alternate());
        let (sp, sm, z) = (f.sign_plus(), f.sign_minus(), f.sign_aware_zero_pad());
        write(f, "{:?} {:?} {:?} {} {} {} {}", w, p, a, alt, sp, sm, z)
    }
}

fn main() {
    println("{:.3}", Spec);
}
