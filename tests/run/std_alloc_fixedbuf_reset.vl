// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc FixedBuf::reset.
// EXPECT: 4 0
use std::alloc::{Allocator, FixedBuf, Layout};

fn main() {
    let mut mem = [0u8; 32];
    let mut fb = FixedBuf::new(&mut mem);
    let _ = fb.allocate(Layout::array::<u8>(4).unwrap());
    let a = fb.used();
    fb.reset();
    println("{} {}", a, fb.used());
}
