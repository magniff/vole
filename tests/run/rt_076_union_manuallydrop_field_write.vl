// XFAIL: RT-76: a write into a union's ManuallyDrop field through DerefMut (`u.m.k = 9`) is accepted; rustc refuses it (E0133 / "not allowed to call DerefMut on a union field") (0.30.2)
// ERROR: union
// Rust refuses an implicit DerefMut of a union field, even inside
// unsafe: it would create `&mut` to a field that may not be the one
// written. Write the whole field (`u.m = ManuallyDrop::new(..)`) or
// through `&mut *u.m` explicitly. rustc: "not automatically applying
// DerefMut on ManuallyDrop union field".
use std::mem::ManuallyDrop;

struct P {
    k: i64,
}

union U {
    m: ManuallyDrop<P>,
    n: i64,
}

fn main() {
    let mut u = U { m: ManuallyDrop::new(P { k: 1 }) };
    unsafe {
        u.m.k = 9;
        println("{}", u.m.k);
    }
}
