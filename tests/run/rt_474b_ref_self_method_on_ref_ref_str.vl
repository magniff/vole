// XFAIL: RT-474b: (RT-474's mechanism, str) `(&t).g(5)` with `t: &str` and impls of G<i64> for String, str (2) and &str (3) runs str's: vole prints `1 2 1 2`, rustc `1 2 1 3` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p03b_str_vs_string_same.
// EXPECT: 1 2 1 3
trait G<X> {
    fn g(&self, x: X) -> i64;
}

impl G<i64> for String<Gpa> {
    fn g(&self, x: i64) -> i64 {
        1 + x * 0
    }
}

impl G<i64> for str {
    fn g(&self, x: i64) -> i64 {
        2 + x * 0
    }
}

impl<'a> G<i64> for &'a str {
    fn g(&self, x: i64) -> i64 {
        3 + x * 0
    }
}

fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("ab", gpa);
    let t: &str = "x";
    let rs = &s;
    println("{} {} {} {}", s.g(5), t.g(5), rs.g(5), (&t).g(5));
    0
}
