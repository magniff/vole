// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::marker Copy.
// EXPECT: 1 2 3 4
use std::marker::{Copy, PhantomData};

struct P {
    x: i64,
    y: i64,
}

impl Clone for P {
    fn clone(&self) -> P {
        *self
    }
}

impl Copy for P {}

fn main() {
    let a = P { x: 1, y: 2 };
    let mut b = a;
    b.x = 3;
    b.y = 4;
    println("{} {} {} {}", a.x, a.y, b.x, b.y);
}
