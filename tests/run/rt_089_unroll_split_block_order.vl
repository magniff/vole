// XFAIL: RT-89: the run-time unroller splits a sum whose step reads a value computed from the running value in an earlier block: membership decided at first visit, in block order (0.30.2)
// FLAGS: -O2
// From the review of RT-61's fix: reduction_set (and v0.30.1's split_reduction)
// accept an Add-family step when one operand is in the set at its first
// visit; the other joins later (an earlier block visited after the
// latch) and the step is never checked again. -O0 is rustc's output;
// -O2 with --no-unroll-runtime is right.
// EXPECT: 1 1 5 5 32 50 79 177 15 367 42 784 81 1655 17 3333 60 6726 91 13549 27 27131 70 54332 6 108670 45 217383 72 434846 8 869708 55 1739469 82 3479028 18 6958082 57 13916227 100 27832554 36 55665144 67 111330361 3 222660731 46 445321508 85 890643099 21 1781286217 48 3562572490 95 2830177777 31 1365388287 58 2730776640 97 1166586087 33 2333172213 76 371377206 12 742754424 43 1485508897 86 2971017880 22 1647068486 [2, 0, 1, 0, 0, 1, 0, 1, 1, 0, 1, 2, 0, 1, 0, 0, 1, 0, 1, 1, 0, 1, 2, 0, 1, 0, 1, 1, 0, 1, 1, 0, 1, 2, 0, 1, 0]
#[inline(never)]
fn f(a: &mut [u32], b: &[u32]) -> u32 {
    let mut acc: u32 = 1;
    for i in 0..a.len() {
        if b[i] > 50 {
            a[i] = 1;
        }
        let u = acc ^ 5;
        if b[i] < 10 {
            a[i] = 2;
        }
        acc = acc ^ u ^ b[i];
    }
    acc
}

#[inline(never)]
fn g(a: &mut [u32], b: &[u32]) -> u32 {
    let mut acc: u32 = 1;
    for i in 0..a.len() {
        if b[i] > 50 {
            a[i] = 1;
        }
        let u = acc.wrapping_add(3);
        if b[i] < 10 {
            a[i] = 2;
        }
        acc = acc.wrapping_add(u).wrapping_add(b[i]);
    }
    acc
}

fn main() -> i32 {
    let mut b: [u32; 37] = [0; 37];
    for i in 0..37 {
        b[i] = (i as u32 * 37) % 101;
    }
    let mut a: [u32; 37] = [0; 37];
    let mut c: [u32; 37] = [0; 37];
    for n in 0..38 {
        let x = f(&mut a[0..n], &b[0..n]);
        let y = g(&mut c[0..n], &b[0..n]);
        print("{} {} ", x, y);
    }
    println("{:?}", a);
    0
}
