// (0.30.2, RT-138) A constant whose value fails is not its own cycle at its
// next use: the mark of a constant being made is cut back with the error
// (0.30.1 said "constant 'P' is defined in terms of itself" at P's second
// use). rustc: the two E0308 alone.
// ERROR: expected 'bool'
// ERROR-COUNT: 2
const P: (i64, bool) = (1, 2);
struct S;

impl S {
    const Q: (i64, bool) = (1, 2);
}

fn main() {
    let a = P;
    let b = P;
    let c = S::Q;
    let d = S::Q;
    println("{} {} {} {}", a.0, b.0, c.0, d.0);
}
