// XFAIL: RT-487: a block expression in a constant's initializer, `const K: bool = { 1 } < 2;` and `const M: i64 = { 1 } << 2;` (or just `const K: i64 = { 7 };`), is "not a compile-time constant"; rustc prints `true 4 true true 5` (0.30.2)
// From the third re-review of the qualified-path work (g302qual). Since v0.30.1 at least.
// From the review's form c1/a19_items_consts. An array length and an enum
// discriminant: rt_487b.
// EXPECT: true 4 true true 5
trait Tr {
    type Out;
    fn f(x: i64) -> i64;
}

struct S {
    a: i64,
}

impl Tr for S {
    type Out = S;

    fn f(x: i64) -> i64 {
        println("f {}", x);
        x + 1
    }
}

const K: bool = { 1 } < 2;

const M: i64 = { 1 } << 2;

impl S {
    fn g(b: u32) -> bool {
        let x = unsafe { 1 } < b as i64;
        x
    }

    fn h(b: u32) -> bool {
        let v = [0; 4];
        v.len() < b as usize
    }
}

enum En {
    A = 4,
    B,
}

fn main() {
    println("{} {} {} {} {}", K, M, S::g(3), S::h(9), En::B as i64);
}
