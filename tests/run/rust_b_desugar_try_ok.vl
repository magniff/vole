// RULE: D8.5
// (0.30.1) `*v.last()?` copies the element out, so the push after it is
// accepted, as rustc.
// EXPECT: Some(1)
fn f(v: &mut Vec<i64, Gpa>) -> Option<i64> {
    let x = *v.last()?;
    v.push(1);
    Some(x)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{:?}", f(&mut v));
}
