// Runs on std since 0.27.2's switch.
// The std item(s): std::option Option::xor.
// EXPECT: None Some(1) Some(2) None
use std::option::Option;

fn main() {
    let none: Option<i64> = None;
    println("{:?} {:?} {:?} {:?}", Some(1i64).xor(Some(2)), Some(1i64).xor(none), none.xor(Some(2)),
        none.xor(none));
}
