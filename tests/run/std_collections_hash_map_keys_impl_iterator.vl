// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map Keys::impl Iterator.
// EXPECT: Some(4) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(4, 1);
    let mut k = m.keys();
    let a = k.next();
    println("{:?} {:?}", a, k.next());
}
