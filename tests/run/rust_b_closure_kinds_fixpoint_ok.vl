// RULE: D19.2
// (0.30.1, RT-33 round 5, F1 and P3) A closure's kind can hang on a
// closure inferred after it: a later sibling that calls an earlier one
// (`h = || g()`, g FnMut: h borrows g `&mut`, so h is FnMut), a nested
// closure that calls an outer sibling, a closure that calls a FnOnce one
// (so it is FnOnce), a closure in a generic fn that calls the instance's
// FnMut parameter. Kinds are inferred to a fixpoint (front/closures/
// kinds.vl infer_kinds): the passes repeat until no kind or capture mode
// grows. Before, one pass innermost first left h `Fn` while g's kind was
// still unknown, and h's body was refused ("a captured variable in a `Fn`
// closure"); rustc and 0.30.0 accept each of these.
// EXPECT: 2
// EXPECT: 2
// EXPECT: 5
// EXPECT: 2
// EXPECT: 1
fn sibling() {
    let mut x = 0i64;
    let r = &mut x;
    let mut g = || *r += 1;
    let mut h = || g();
    h();
    h();
    println("{}", x);
}

fn fill(out: &mut Vec<i64, Gpa>) {
    let mut emit = |n: i64| out.push(n);
    let mut emit2 = |a: i64| {
        emit(a);
        emit(a + 1);
    };
    emit2(1);
}

fn through_fn_once(gpa: Gpa) {
    let b = Box::new_in(5i64, gpa);
    let g = move || {
        let c = b;
        println("{}", *c);
    };
    let h = || g();
    h();
}

fn go<F: FnMut()>(mut g: F) {
    let mut h = || g();
    h();
    h();
}

fn generic() {
    let mut x = 0i64;
    let r = &mut x;
    go(|| *r += 1);
    println("{}", x);
}

fn nested() {
    let mut x = 0i64;
    let r = &mut x;
    let mut g = || *r += 1;
    let mut c = || {
        let mut h = || g();
        h();
    };
    c();
    println("{}", x);
}

fn main(gpa: Gpa) {
    sibling();
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    fill(&mut v);
    println("{}", v.len());
    through_fn_once(gpa);
    generic();
    nested();
}
