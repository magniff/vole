// RULE: D19.1, D19.10
// (0.30.2, RT-44) A closure in a trait's default method that only a
// generic Drop impl's instance calls: the instance is made while the
// bodies are built (places/shim.vl drop_fn), after every other closure's
// kind and X_C slots, and its closures had none (a compiler panic,
// places/regions.vl code_universal). rustc builds it.
// EXPECT: ok
// EXPECT: drop 1
use std::thread;

trait Tr {
    fn f(&self) -> i64 {
        thread::scope(|s| {
            s.spawn(|| 1i64);
        });
        1
    }
}

struct W<T> {
    t: T,
}

impl<T> Tr for W<T> {}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("drop {}", self.f());
    }
}

fn main() {
    let w = W { t: 1u8 };
    let _ = &w.t;
    println("ok");
}
