struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn eat(r: R) -> i64 { r.id }
impl R { fn n(&self) -> i64 { let c = move || eat(self); c() } }

fn main() {
    let r = R { id: 1 };
    println("{}", r.n());
    println("end");
}
