use std::alloc::Allocator; struct Names<'a, A: Allocator> { list: Vec<&'a str, A> }

impl<'a> Names<'a, Gpa> {
    fn add(&mut self, s: &mut String<Gpa>) {
        self.list.push(s.as_str());
        s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello", gpa);
    let mut n = Names { list: Vec::new_in(gpa) };
    n.add(&mut s);
    println("{}", str::from_utf8(n.list[0usize]).unwrap());
    0
}
