// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: self.list stores a view of s, then s grows in the method
// ERROR: error[own.conflict]
struct Names<A: Allocator> { list: Vec<str, A> }

impl Names<Gpa> {
    fn add(inout self, s: inout String<Gpa>) {
        self.list.push(s.as_str());
        s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    }
}

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var n = Names { list: Vec::new_in(gpa) };
    n.add(&s);
    println(n.list.get(0));
    0
}
