// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::borrow ToOwnedIn.
// EXPECT: abc [1, 2]
use std::borrow::{Borrow, ToOwnedIn};

fn main(gpa: Gpa) {
    let s = "abc".to_owned_in(gpa);
    let v = [1i64, 2][..].to_owned_in(gpa);
    println("{} {:?}", s, v);
}
