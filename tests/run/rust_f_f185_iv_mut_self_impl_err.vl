// RULE: F18.5
// (0.30.2) A `&mut self` trait method on an integer variable's value,
// the trait implemented for i32 and u8, the variable later i64: no impl
// for the type it took, rustc's E0277 (an earlier 0.30.2 build called
// i32's and printed 300).
// ERROR: the trait 'Bump' is not implemented for 'i64' (rustc E0277)
trait Bump { fn bump(&mut self); }
impl Bump for i32 { fn bump(&mut self) { *self = *self + 100; } }
impl Bump for u8 { fn bump(&mut self) { *self = self.wrapping_add(100); } }

fn main() {
    let mut a = 200;
    a.bump();
    let b: i64 = a;
    println("{}", b);
}
