// RULE: F18.5
// (0.27.7) A trait's method on a literal tree is i32's, as rustc's
// fallback gives it (`5.max(3)`, `3.clone()`, `1.cmp(&2)`); an integer
// type's own method needs the literal's type said (`1i64 << s`).
// EXPECT: 5 3 true 1099511627775
fn main() {
    let s: i64 = 40;
    let a = 5.max(3);
    let b = 3.clone();
    let c = 1.cmp(&2) == std::cmp::Ordering::Less;
    let d = (1i64 << s).wrapping_sub(1);
    println("{} {} {} {}", a, b, c, d);
}
