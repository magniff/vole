// A guard: a method of a trait not in scope is never taken; the inherent one runs (as rustc and 0.30.1).
// From the review of g302probe part 1, where a build took the trait's.
// EXPECT: 3
mod a {
    pub trait T1 { fn m(self) -> i64; }
    impl T1 for super::S { fn m(self) -> i64 { 1 } }
}

#[derive(Clone, Copy)]
pub struct S { k: i64 }
impl S { fn m(&self) -> i64 { 3 } }
fn main() { let s = S { k: 0 }; println("{}", s.m()); }
