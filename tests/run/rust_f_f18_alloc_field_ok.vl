// RULE: F18.7
// (0.27.6) A struct's or a variant's field typed by its allocator
// parameter itself (`arena: W`) takes the value's own type, as rustc
// infers it. Before, the value's call was read as an `_in` call's
// allocator argument (the rule for a field `Vec<T, W>`), so `Cx { arena:
// first(r, gpa) }` was taken as `Cx<Gpa>` (the last argument's type) and
// `Vec::new_in(cx.arena)` as a `Vec<i64, &Gpa>` was type.ref-value.
// EXPECT: 3 2
use std::alloc::{Allocator, Gpa};

struct Cx<W: Allocator> {
    arena: W,
}

enum Slot<W: Allocator> {
    Held(W),
    Empty,
}

fn first<'a>(g: &'a Gpa, _h: Gpa) -> &'a Gpa {
    g
}

fn main(gpa: Gpa) {
    let r = &gpa;
    let cx = Cx { arena: first(r, gpa) };
    let mut v: Vec<i64, &Gpa> = Vec::new_in(cx.arena);
    v.push(1);
    v.push(2);
    v.push(3);
    let s = Slot::Held(first(r, gpa));
    let n = match s {
        Slot::Held(a) => {
            let mut w: Vec<i64, &Gpa> = Vec::new_in(a);
            w.push(7);
            w.push(8);
            w.len()
        }
        Slot::Empty => 0,
    };
    println("{} {}", v.len(), n);
}
