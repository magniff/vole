// v[i] and v[j] overlap (indexes collapse)
// ERROR: error[borrowck.mut_twice]
// ERROR: line 8, column 27
fn f(a: &mut i64, b: &mut i64) { *a += 1; *b += 10; }

fn main() {
    let mut a = [1i64, 2, 3]; let i: i64 = 0; let j: i64 = 1;
    f(&mut a[i as usize], &mut a[j as usize]); println("{}", a[0]);
}
