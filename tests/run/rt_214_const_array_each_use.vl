// FLAGS: --check-alloc
// RULE: F34.3 (0.30.2, RT-214) An array constant whose type is not Copy is
// a value made at each use, as rustc's temporary: moved (a `let`, an
// argument, a `for`), borrowed (`C.len()`, `&C[0]`, its temporary dropped
// at the statement's end) and repeated (`[P; 2]`, each element made from
// it); each use is dropped as its own value. rustc's output (v0.30.1
// refused each move as a move out of a static).
// EXPECT: a 2
// EXPECT: drop 1
// EXPECT: take 1
// EXPECT: each 7
// EXPECT: drop 7
// EXPECT: each 8
// EXPECT: drop 8
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: drop 1
// EXPECT: n 4
// EXPECT: ref 1
// EXPECT: drop 1
// EXPECT: q 7 4
// EXPECT: rr 7
// EXPECT: iter 15
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: drop 1
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

struct N {
    k: i64,
}

const C: [Option<D>; 2] = [Some(D { k: 1 }), None];
const P: [D; 2] = [D { k: 7 }, D { k: 8 }];
const Q: [N; 2] = [N { k: 3 }, N { k: 4 }];

fn take(a: [Option<D>; 2]) -> i64 {
    match &a[0] {
        Some(d) => d.k,
        None => 0,
    }
}

fn main() {
    let a = C;
    println("a {}", a.len());
    println("take {}", take(C));
    for d in P {
        println("each {}", d.k);
    }
    let n = C.len() + P.len();
    println("n {}", n);
    println("ref {}", match &C[0] {
        Some(d) => d.k,
        None => 0,
    });
    let q = Q;
    let r = Q;
    println("q {} {}", q[0].k + r[1].k, Q[1].k);
    let rr = [P; 2];
    println("rr {}", rr[1][0].k);
    println("iter {}", P.iter().map(|d| d.k).sum::<i64>());
}
