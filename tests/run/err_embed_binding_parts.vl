// 0.26.2: wgsl.binding across parts: two parts of one module declare
// the same @group(G) @binding(B); the error names both, at the second.
// ERROR: error[wgsl.binding]: @group(0) @binding(0) is already 'xs' (A,
// ERROR: err_embed_binding_parts.vl: line 15, column 5
// ERROR: the module of 'K' is the text of its parts (`with`) and its own
fn main() -> i32 {
    0
}

embed wgsl A {
    @group(0) @binding(0) var<storage, read> xs: array<f32>;
}

embed wgsl B {
    @group(0) @binding(0) var<uniform> scale: f32;
}

embed wgsl K with A, B {
    @compute @workgroup_size(64)
    fn run(@builtin(global_invocation_id) id: vec3<u32>) {
        let v = xs[id.x] * scale;
    }
}
