// XFAIL: RT-275: an impl whose Self type's bound (`G<T: Into<i64>>`) it proves only by `where i64: From<A>` is left out of checking, silently: its type error is accepted (0.30.2)
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// A template whose opaque instance cannot be made
// (front::opaque::build_opaque_instances, opaque_instance answering -1)
// is left out of checking with no error and no warning: its body is
// checked nowhere.
// rustc accepts the header (`i64: From<A>` gives `A: Into<i64>` by std's
// blanket impl) and refuses the body (E0308, mismatched types); vole
// prints `ok: 0 errors`.
// ERROR: expected 'i64', got '&str'
// ERROR: line 22, column 22
// ERROR-COUNT: 1
struct G<T: Into<i64>> {
    t: T,
}

impl<A> G<A>
    where
        i64: From<A>,
{
    fn bad(&self) -> i64 {
        let x: i64 = "not an int";
        x
    }
}

fn main() {
    println("{}", 1);
}
