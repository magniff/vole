// XFAIL: RT-B301-4: a call through a `fn() -> !` value does not end its path (open, 0.30.2)
// `if c { v.clear(); f() }` with `f: fn() -> !` never reaches the read of
// r after it, as a call of `die` itself does not: rustc accepts it (and
// prints 1, c being false); vole keeps the path going and refuses
// `v.clear()` (borrowck.conflict). A direct call of a `-> !` function ends
// the path (rust_b_hidden_diverge_ok).
// EXPECT: 1
fn die() -> ! {
    panic("x")
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let c = v.len() == 2;
    let r = &v[0];
    let f: fn() -> ! = die;
    if c {
        v.clear();
        f()
    }
    println("{}", *r);
}
