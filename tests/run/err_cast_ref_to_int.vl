// 0.29: a reference casts to no integer (rustc E0606). `p as usize` of a
// `p: &T` used to give the address without a word, and a loop over
// `v.iter()` that meant the element summed addresses. The help names the
// two things that can be meant: the address, through a raw pointer, or
// the value, `*p`. A raw pointer, and a reference made one first, cast as
// before.
// ERROR: error[type.cast]: cannot cast the reference '&i64' to the integer 'usize'
// ERROR: line 19, column 13
// ERROR: `p as *const T as usize`
// ERROR: error[type.cast]: cannot cast the reference '&mut i64' to the integer 'u64'
// ERROR: line 22, column 13
// ERROR: `p as *mut T as usize`
// ERROR: error[type.cast]: cannot cast the reference '&i64' to the integer 'i64'
// ERROR: line 26, column 17
// ERROR-COUNT: 3
fn main(gpa: Gpa) -> i32 {
    let x: i64 = 5;
    let p: &i64 = &x;
    let a = p as usize;
    let mut y = 1i64;
    let q = &mut y;
    let c = q as u64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    for e in v.iter() {
        let n = e as i64;
        println("{n}");
    }
    let ok = p as *const i64 as usize;
    let raw = p as *const i64;
    let also = raw as usize;
    println("{}", a + c as usize + ok + also);
    0
}
