// From the review of g302bor2 (form B/b01). Since v0.30.1 at least; the
// release build the same. The projection's region is C's, a type
// parameter's, not an elided lifetime of the signature: rustc needs no
// lifetime here. Sibling: rt_389b (`<C::IntoIter as Iterator>::Item`, a
// projection of a projection). RT-387 is the same reading with one
// reference parameter, where it is unsound.
// EXPECT: Some(1000)
fn first<C: IntoIterator>(c: C) -> Option<<C as IntoIterator>::Item> {
    c.into_iter().next()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let p = first(&v);
    println("{:?}", p);
}
