// EDITION: rust
// RULE: F4.2
// Pairs that do not overlap: a blanket impl whose bound the other
// impl's type does not meet; trait arguments that differ (`Conv<T> for
// T` against `Conv<i64> for A`); a reference type no blanket bound
// reaches.
// EXPECT: 1
// EXPECT: 2
// EXPECT: 3
// EXPECT: 4
trait Base {}

trait Show {
    fn show(&self) -> i64;
}

struct A {
    n: i64,
}

struct B {
    n: i64,
}

impl Base for A {}

impl<T: Base> Show for T {
    fn show(&self) -> i64 {
        1
    }
}

impl Show for B {
    fn show(&self) -> i64 {
        self.n
    }
}

impl<'a, T> Show for &'a [T] {
    fn show(&self) -> i64 {
        self.len() as i64
    }
}

trait Conv<X> {
    fn conv(&self) -> i64;
}

impl<T> Conv<T> for T {
    fn conv(&self) -> i64 {
        4
    }
}

impl Conv<i64> for A {
    fn conv(&self) -> i64 {
        5
    }
}

fn main() -> i64 {
    let a = A { n: 0 };
    let b = B { n: 2 };
    let v = [7, 8, 9];
    let s: &[i64] = &v[..];
    std::print_int(a.show());
    println("");
    std::print_int(b.show());
    println("");
    std::print_int(s.show());
    println("");
    std::print_int(b.conv());
    println("");
    0
}
