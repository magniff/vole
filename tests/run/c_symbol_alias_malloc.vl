// 0.30.1: an extern named `malloc`, `calloc` and `free` that links to the
// program's own allocator is not C's malloc: -O2's heap to stack
// (middle::ipo, which knew C's functions by their vole names) removed
// these calls of the program's functions (0.30.0: `allocs 0, frees 0` at
// -O2, `allocs 2, frees 2` at -O0). The C function is the symbol.
// CSOURCE: tests/c/c_symbol_identity.c
// EXPECT: x 42, y 0
// EXPECT: allocs 2, frees 2
extern "C" {
    #[link_name = "csi_alloc"]
    fn malloc(n: usize) -> *mut u8;
    #[link_name = "csi_calloc"]
    fn calloc(n: usize, m: usize) -> *mut u8;
    #[link_name = "csi_free"]
    fn free(p: *mut u8);
    fn csi_allocs() -> i64;
    fn csi_frees() -> i64;
}

fn main() {
    // UNSAFE: the program's C allocator.
    // SAFETY: each block is written and read within its 16 bytes and freed
    // once.
    unsafe {
        let p = malloc(16);
        *p = 42;
        let x = *p;
        free(p);
        let q = calloc(2, 8);
        let y = *q;
        free(q);
        println("x {x}, y {y}");
        println("allocs {}, frees {}", csi_allocs(), csi_frees());
    }
}
