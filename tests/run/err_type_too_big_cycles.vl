// (0.30.1) The size checks of RT-M2-9's fix lay types out where they are
// written; a type on a cycle of by-value fields has no layout, so they
// must not run into one (a recursion without end in the compiler): the
// cycles are reported as before, the non-generic at the declaration, an
// instance where it is written.
// ERROR: struct 'A' has infinite size due to recursive field
// ERROR: struct 'P<u8>' has infinite size due to recursive field
// ERROR: struct 'Q<u16>' has infinite size due to recursive field
struct A {
    b: [B; 1],
}

struct B {
    a: (A, u8),
}

struct P<T> {
    a: T,
    n: Option<P<T>>,
}

struct Q<T> {
    r: R<T>,
}

struct R<T> {
    q: (Q<T>, T),
}

fn main() {
    let x: Option<P<u8>> = None;
    let y: Option<Q<u16>> = None;
    println("{}", x.is_none() && y.is_none());
}
