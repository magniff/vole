// 0.16: a static cannot hold a scope's arena, which lives only while its
// scope runs (constants hold no structs at all). (0.26.3: no static holds
// an allocator, alloc.static, an Arena neither; a scope's arena gets both
// errors.)
// ERROR: error[alloc.static]: the static 'BAD' holds an allocator, 'ScopedArena' (in its type 'Vec<i64, ScopedArena>')
// ERROR: static 'BAD' holds 'ScopedArena' (Vec<i64, ScopedArena>): a scope's arena lives only while its scope runs
// ERROR: help: keep it in the scope's locals
// ERROR: error[alloc.static]: the static 'ARENAS' holds an allocator, 'ScopedArena' (in its type '[*ScopedArena; 2]')
// ERROR: static 'ARENAS' holds 'ScopedArena' ([*ScopedArena; 2])
// ERROR-COUNT: 4
static var BAD: Vec<i64, ScopedArena> = Vec::new_in(Arena::none());
static var ARENAS: [*ScopedArena; 2] = [0 as *ScopedArena, 0 as *ScopedArena];

fn main(gpa: Gpa) {}
