// From g302oblig (2026-11-16). rustc prints 40; v0.30.1 says the trait is
// not implemented: a limit must be an error that says so, never a no.
// EXPECT: 40
trait Tr { fn d(&self) -> i64; }
struct W<T> { t: T }
impl Tr for i64 { fn d(&self) -> i64 { 0 } }
impl<T: Tr> Tr for W<T> { fn d(&self) -> i64 { 1 + self.t.d() } }
fn go<T: Tr>(t: &T) -> i64 { t.d() }

fn main() {
    let w = W {
        t: W {
            t: W {
                t: W {
                    t: W {
                        t: W {
                            t: W {
                                t: W {
                                    t: W {
                                        t: W {
                                            t: W {
                                                t: W {
                                                    t: W {
                                                        t: W {
                                                            t: W {
                                                                t: W {
                                                                    t: W {
                                                                        t: W {
                                                                            t: W {
                                                                                t: W {
                                                                                    t: W {
                                                                                        t: W {
                                                                                            t: W {
                                                                                                t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: W { t: 1i64 } } } } } } } } } } } } } } } } }
                                                                                            }
                                                                                        }
                                                                                    }
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }; println("{}", go(&w));
}
