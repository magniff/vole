// RULE: D19.5
// (0.27.2) An `FnMut` closure called through `&F`: its env is `&mut
// *pred`, and `*pred` is behind a `&` reference (rustc's E0596).
fn call<F: FnMut(i64) -> bool>(pred: &F) -> bool {
    pred(1)
}

fn main() {
    let mut n = 0;
    let p = |x: i64| {
        n += x;
        true
    };
    println("{}", call(&p));
}
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*pred' as mutable, which is behind a `&` reference
// ERROR-COUNT: 1
