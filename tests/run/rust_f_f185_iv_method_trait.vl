// RULE: F18.5
// (0.30.2) A method of a trait every integer type implements, called on an
// integer variable's value, has Self the variable: `m.max(5)` is a
// `{integer}` that `take(k)` types i64, and the call is i64's `max` (FL6:
// 0.30.1 typed the receiver i32 at the call, and 3000000000 did not fit).
// EXPECT: 3000000000
// EXPECT: Greater Some(Less)
// EXPECT: 4000000000
// EXPECT: true
// EXPECT: 7
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let m = 3000000000;
    let k = m.max(5);
    println("{}", take(k));
    let a = 3000000000;
    let b = 5;
    println("{:?} {:?}", a.cmp(&b), b.partial_cmp(&a));
    take(a);
    let c = 2000000000;
    let d = c.clone();
    println("{}", take(d + d));
    let e = 7;
    println("{}", e.eq(&7) && e.min(9) == 7);
    let f: u8 = e;
    println("{f}");
}
