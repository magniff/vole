// EDITION: rust
// A function stored in a struct field is called as (s.f)(x).
// EXPECT: add 13
// EXPECT: mul 42
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy)] struct Op { name: *mut u8, apply: fn(i64, i64) -> i64 }

fn add(a: i64, b: i64) -> i64 { a + b }
fn mul(a: i64, b: i64) -> i64 { a * b }

fn main() -> i64 {
    let ops = [Op { name: c"add", apply: add }, Op { name: c"mul", apply: mul }];
    for i in 0..2 {
        unsafe { printf(c"%s %ld\n", ops[i as usize].name, (ops[i as usize].apply)(6i64, 7i64)); }
    }
    0
}
