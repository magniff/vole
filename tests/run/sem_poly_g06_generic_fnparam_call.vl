// a generic function calling F on a let argument, F a plain fn whose result views it
// (0.30: borrowck.outlives in apply's instance, R6. 0.30.2: refused
// where the value is given, rustc's position (E0308 at the call): the
// bound's elided input is the call's own region, which sl's result may
// not borrow; apply's body is checked by the bound, as in
// rust_b_err_fn_item_bound_result)
// ERROR: error[borrowck.fn_value_bound]
// ERROR: line 17, column 19
// ERROR-COUNT: 1
fn sl(d: &Vec<i64, Gpa>) -> &[i64] { d.as_slice() }
fn apply<T, R, F: Fn(&T) -> R>(x: &T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    let s = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        apply(&v, sl)
    };
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println("{}", s[5]);
}
