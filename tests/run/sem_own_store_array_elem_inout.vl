// EDITION: rust
// (0.25) A store to an element, or through inout, drops the value it replaces.
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
// EXPECT: drop 3
struct D { id: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.id); } }
fn put(a: &mut [D; 2]) { a[0] = D { id: 2 }; }
fn main() { let mut a = [D { id: 1 }, D { id: 3 }]; put(&mut a); println("after"); }
