// XFAIL: RT-6: #[link_name] on an extern named like a C function the compiler calls (memcpy, fmod) redirects the compiler's own calls (open)
// FLAGS: -O2
// The program's extern `fmod` is its C function rt006_not_fmod. A float
// `%` lowers to a C call of `fmod` (middle::lower::expr::lower_operator),
// renamed by the program's #[link_name] like any symbol of that text: -O1
// and -O2 print 42 for 7.5 % 2.0; -O0 prints 1.5.
// CSOURCE: tests/c/rt_006_link_name_memcpy.c
// EXPECT: 1.5
extern "C" {
    #[link_name = "rt006_not_fmod"]
    fn fmod(a: f64, b: f64) -> f64;
}

#[inline(never)]
fn r(a: f64, b: f64) -> f64 {
    a % b
}

fn main() {
    println("{}", r(7.5, 2.0));
}
