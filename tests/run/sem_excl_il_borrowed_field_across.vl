use std::alloc::Allocator; struct S<A: Allocator> { v: Vec<i64, A> }
fn reset(s: &mut S<Gpa>, gpa: Gpa) { s.v = Vec::new_in(gpa); }
fn f(s: &mut S<Gpa>, gpa: Gpa) -> i64 { let x = s.v; reset(s, gpa); x.len() as i64 }
fn main(gpa: Gpa) { let mut s = S { v: Vec::new_in(gpa) }; s.v.push(1); println("{}", f(&mut s, gpa)); }
