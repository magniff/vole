// XFAIL: gap 8: compile borrowck.outlives: the lifetime of 'a' must outlive the lifetime of 'b': a reference of the first f...
// a generic swap of owned values written with std::replace; each dropped once
// FLAGS: --check-alloc
// EXPECT: 2 1
// EXPECT: drop 1
// EXPECT: drop 2
use std::mem; struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn sw<T>(a: &mut T, b: &mut T) { mem::swap(&mut (a), &mut (b)); }

fn main() {
    let mut x = R { id: 1 };
    let mut y = R { id: 2 };
    sw(&mut x, &mut y);
    println("{} {}", x.id, y.id);
}
