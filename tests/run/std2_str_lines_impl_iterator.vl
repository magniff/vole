// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str Lines::impl Iterator.
// EXPECT: ["one", "two", "", "three"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "one\ntwo\r\n\nthree\n".lines().collect_in(gpa);
    println("{:?}", v);
}
