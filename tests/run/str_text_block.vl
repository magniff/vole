// 0.25.3: text blocks. The closing line's indentation is removed from
// every line (a line of blanks may be shorter: it is empty); the line
// breaks after the opening """ and before the closing line are not in the
// value; escapes work as in "...", a \ at a line's end joins it to the
// next; \""" writes three quotes. A text block is a string literal: a
// [u8], a str where one goes, in a const and a static.
// EXPECT: [line one
// EXPECT:   line two
// EXPECT:
// EXPECT: tab	here ☺ """ end]
// EXPECT: [joined here and here]
// EXPECT: [const
// EXPECT:   block]
// EXPECT: [static str]
// EXPECT: 10
// EXPECT: []
// EXPECT: 0
// EXPECT: [keeps trailing
// EXPECT: ]
// EXPECT: [	tab-indented]
// EXPECT: [a "quoted" "" line]
// EXPECT: 3 [left, flush]
const K: [u8] = """
    const
      block
    """;
static S: str = """
    static str
    """;

fn show(s: [u8]) {
    print("[");
    print(s);
    println("]");
}

fn words(s: str) -> i64 {
    s.split_whitespace().count()
}

fn main() -> i32 {
    show("""
        line one
          line two

        tab\there \u{263A} \""" end
        """);
    show("""
        joined \
        here \
        and here
        """);
    show(K);
    show(S);
    println(S.len());
    let empty = """
        """;
    show(empty);
    println(empty.len);
    show("""
        keeps trailing

        """);
    show("""
		\ttab-indented
		""");
    show("""
        a "quoted" "" line
        """);
    let t: str = """
    left,
    flush
    """;
    println(f"{words(t) + 1} [{t.split_once("\n").unwrap().0} {t.split_once("\n").unwrap().1}]");
    0
}
