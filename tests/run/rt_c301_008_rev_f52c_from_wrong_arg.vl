// RULE: F8.3, F8.4
// RT-C301-8 review (R2, form f52c_from_wrong_arg): `<i64 as From<i32>>::from(7u8)` reaches std's From<i32> for i64, its argument widened u8 to i32 as any call's.
// RUSTC-DIFFERS: rustc refuses the u8 argument (E0308); vole widens an integer argument losslessly, as in `f(a)` for f(x: i32), a: u8
// EXPECT: 7
fn main() {
    let c = <i64 as From<i32>>::from(7u8);
    println("{}", c);
}
