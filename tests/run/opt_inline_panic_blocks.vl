// (0.29) The inliner does not count a function's panic blocks (the
// blocks that only lead to a panic: a failed check's report): `cell` is
// a dozen instructions on the paths that return and several times that
// in its three reports (two formatted messages and the index's check),
// and is inlined at both of its calls, not in a loop. Counted whole, it
// was over the threshold and stayed a call.
// EXPECT: 7
// EXIT: 101
// STDERR: row 2 is outside 0..2
// CHECK: fn corners:
// CHECK-NOT: call cell
// CHECK: fn main:
struct Grid<'a> {
    cells: &'a [i64],
    w: i64,
    h: i64,
}

fn cell(g: &Grid, x: i64, y: i64) -> i64 {
    if x < 0 || x >= g.w {
        panic("column {x} is outside 0..{}", g.w);
    }
    if y < 0 || y >= g.h {
        panic("row {y} is outside 0..{}", g.h);
    }
    g.cells[(y * g.w + x) as usize]
}

#[inline(never)]
fn corners(g: &Grid, dy: i64) -> i64 {
    cell(g, 0, 0) + cell(g, g.w - 1, g.h - 1 + dy)
}

fn main() {
    let cells: [i64; 6] = [1, 2, 3, 4, 5, 6];
    let g = Grid { cells: &cells[..], w: 3, h: 2 };
    println("{}", corners(&g, 0));
    println("{}", corners(&g, 1));
}
