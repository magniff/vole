// XFAIL: RT-426g: WRONG CODE: (RT-426's family, a generic subtrait) `T::Out` under `T: Sub<u16>` with `trait Sub<A>: Tr<A>` takes Tr<u8>'s Out: vole prints 8, rustc 1 (0.30.2)
// From the re-review of g302oblig M2 (its form c16_generic_super_args). Since v0.30.1 at
// least (v0.30.1 and the release build print 8).
// EXPECT: 1
trait Tr<A> {
    type Out;
}

struct W;

impl Tr<u8> for W {
    type Out = i64;
}

impl Tr<u16> for W {
    type Out = u8;
}

trait Sub<A>: Tr<A> {}

impl<A> Sub<A> for W where W: Tr<A> {}

fn sz<T: Sub<u16>>() -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    println("{}", sz::<W>());
}
