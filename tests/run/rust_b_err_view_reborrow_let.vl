// RULE: D3.6
// (0.30.1) The reborrow a `let` with a type makes is an exclusive loan of
// the place it is given: a use of the place while the binding lives is
// rustc's E0506/E0502, for a `&mut T` and a `&mut [T]`.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 20, column 5
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 25, column 5
// ERROR: error[borrowck.conflict]
// ERROR: line 28, column 13
// ERROR-COUNT: 3
struct W {
    x: i64,
}

fn main() {
    let mut w = W { x: 1 };
    let r: &mut W = &mut w;
    let t: &mut W = r;
    r.x = 9;
    t.x = 8;
    let mut arr = [0i64, 1];
    let s: &mut [i64] = &mut arr;
    let u: &mut [i64] = s;
    s[0] = 2;
    u[0] = 1;
    let v: &mut [i64] = s;
    let z = s.len();
    v[0] = 1;
    println("{}", z);
}
