// XFAIL: RT-411c: (RT-411's mechanism, Self in another parameter) `fn ad<T>(self, o: Self, t: T) -> Self` impl'd for i32 and i64, `let c = a.ad(a, 1u8); let d: i64 = c;` on an integer variable, runs i32's impl and widens its result: vole prints -294967296, rustc 4000000000 (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// t302int's FL6 (a generic method naming Self in another parameter, on a
// free variable, takes i32) gives the same wrong value. With `self + o`
// in i32's impl instead of wrapping_add, -O0 panics on the overflow and
// -O2 prints -294967296 (the review's r06).
// EXPECT: 4000000000
trait Ad { fn ad<T>(self, o: Self, t: T) -> Self; }
impl Ad for i32 { fn ad<T>(self, o: i32, t: T) -> i32 { self.wrapping_add(o) } }
impl Ad for i64 { fn ad<T>(self, o: i64, t: T) -> i64 { self + o } }

fn main() {
    let a = 2000000000;
    let c = a.ad(a, 1u8);
    let d: i64 = c;
    println("{}", d);
}
