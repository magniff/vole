// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a54_tls_read_ptr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which touches a thread-local static
// A callee reads a thread-local holding a raw pointer (no static write) and writes through it.
#[thread_local]
static mut P: usize = 0;

fn poke() -> bool {
    // UNSAFE: test
    // SAFETY: test
    let p = unsafe { P } as *mut i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(n: i64) -> i64
    requires poke()
{
    n
}

fn main() {
    let mut x = 1i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { P = &raw mut x as usize; }
    println("{}", f(1));
    println("{}", x);
}
