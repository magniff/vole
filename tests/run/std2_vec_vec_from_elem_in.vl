// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::from_elem_in.
// EXPECT: [7, 7, 7] 0
// RUSTC: none (vole's addition: Vec::from_elem_in (Rust's vec![x; n]))
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_elem_in(7, 3, gpa);
    let e = Vec::from_elem_in(7, 0, gpa);
    println("{:?} {}", v, e.len());
}
