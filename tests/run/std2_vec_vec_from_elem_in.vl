// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::from_elem_in.
// EXPECT: [7, 7, 7] 0
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_elem_in(7, 3, gpa);
    let e = Vec::from_elem_in(7, 0, gpa);
    println("{:?} {}", v, e.len());
}
