// RULE: C3.4
// (0.30.2, review of RT-38g) Read-only clauses over an Option parameter: `iter().all`,
// `iter().count`, a `for` loop (option::Iter::next takes, through a raw
// write). A callee's raw write is refused only
// when a raw pointer may reach it from what the clause reads (a
// parameter's or the result's type holds one, contracts::raw_inputs).
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
// EXPECT: 4
// EXPECT: 1
fn f(o: Option<i64>) -> i64
    requires o.iter().all(|x: &i64| *x > 0)
{
    o.unwrap_or(0)
}
fn g(o: Option<i64>) -> i64
    requires o.iter().count() == 1
{
    o.unwrap_or(0)
}
fn h(o: &Option<i64>) -> i64
    requires {
    let mut ok = true;
    for x in o.iter() {
        ok = ok && *x > 0;
    }
    ok
}
{
    1
}
fn main() {
    println("{}", f(Some(3)));
    println("{}", g(Some(4)));
    println("{}", h(&Some(5i64)));
}
