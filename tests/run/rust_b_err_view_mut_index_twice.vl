// EDITION: rust
// RULE: D1.5
// (0.27.1) `&mut s[i]` and `&mut s[j]` by locals through a `&mut [i64]`: may
// alias.
// ERROR: error[borrowck.mut_twice]
// ERROR: line 12, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn touch(s: &mut [i64], i: usize, j: usize) {
    let p = &mut s[i];
    let q = &mut s[j];
    *p += 10;
    *q += 20;
}

fn main() {
    let mut a = [1i64, 2];
    touch(&mut a[..], 0, 1);
    println("{}", a[0]);
}
