// Runs on std since 0.27.2's switch.
// The std item(s): std::hash impl Hash for primitives.
// EXPECT: write [5, 0, 0, 0]
// EXPECT: write [1]
// EXPECT: write [7]
// EXPECT: write [44, 1]
// EXPECT: write [255, 255, 255, 255, 255, 255, 255, 255]
// EXPECT: write [9, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [2, 0]
// EXPECT: 26
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

fn main() {
    let mut h = Show { n: 0 };
    5i32.hash(&mut h);
    true.hash(&mut h);
    7u8.hash(&mut h);
    300u16.hash(&mut h);
    (-1i64).hash(&mut h);
    9usize.hash(&mut h);
    2i16.hash(&mut h);
    println("{}", h.finish());
}
