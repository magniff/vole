// EDITION: rust
// RULE: F22.1
// `for x in s` with `s: &mut [i64]` (and `for x in &mut a[..]`) is
// `impl IntoIterator for &'a mut [T]`'s IterMut: x is a `&mut i64` and
// `*x += 1` writes the element (rustc's choice; `&[T]`'s impl gives Iter).
// EXPECT: 4 6 8
fn bump(s: &mut [i64]) {
    for x in s {
        *x += 1;
    }
}

fn main() {
    let mut a = [1i64, 2, 3];
    bump(&mut a[..]);
    for x in &mut a[..] {
        *x *= 2;
    }
    println("{} {} {}", a[0], a[1], a[2]);
}
