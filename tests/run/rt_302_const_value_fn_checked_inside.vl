// RULE: F34.4 (0.30.2) A function's check is a body of its own wherever it
// is asked from: mk, whose hidden type a constant's value needs, is
// checked inside that value (opaque.vl hidden, check_nested), and its own
// `return` is mk's (a5eefbcae refused it as leaving the constant, since
// check_function reset loop_base but not const_value; with mk written
// before the constant it built), and its locals are its own (env_floor). The output is rustc's for the same
// program with mk called at each element. (o01 of the second re-review)
// EXPECT: in 3 3 3
fn yes() -> bool {
    true
}

trait Tr {
    fn v(&self) -> i64;
}

struct P {
    x: i64,
}

impl Tr for P {
    fn v(&self) -> i64 {
        self.x
    }
}

struct D {
    k: i64,
}

const C: D = D { k: mk().v() };

fn main() {
    let z: i64 = 1;
    let w: i64 = 2;
    let a = [C; 2];
    println("in {} {} {}", a[0].k, a[1].k, z + w);
}

fn mk() -> impl Tr {
    let p = P { x: 3 };
    let q = P { x: 4 };
    if yes() {
        return p;
    }
    q
}
