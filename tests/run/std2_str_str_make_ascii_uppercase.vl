// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str str::make_ascii_uppercase.
// EXPECT: GRüßE, JüRGEN ❤
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let mut s = String::from_in("grüße, jürgen ❤", gpa);
    s.as_mut_str().make_ascii_uppercase();
    println("{}", s);
}
