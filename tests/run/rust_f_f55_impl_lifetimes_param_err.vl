// RULE: F5.5
// (0.30.1) An impl method that takes less than its trait's declaration:
// the trait's `put` takes a `&str` of any lifetime, the impl's only one of
// 'a, the struct's, and keeps it. Through the generic keep_it the
// String's bytes would be read after its drop. rustc E0308 (lifetime mismatch).
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 1
trait Keep {
    fn put(&mut self, x: &str);
    fn last(&self) -> &str;
}

struct V<'a> {
    v: &'a str,
}

impl<'a> Keep for V<'a> {
    fn put(&mut self, x: &'a str) {
        self.v = x;
    }

    fn last(&self) -> &str {
        self.v
    }
}

fn keep_it<K: Keep>(k: &mut K, gpa: Gpa) {
    let s = String::from_in("short", gpa);
    k.put(s.as_str());
}

fn main() {
    let v = V { v: "long" };
    println("{}", v.last());
}
