// XFAIL: RT-389c: (RT-389's mechanism, a projection that does normalize) `fn mk(gpa: Gpa) -> <Y as Tr>::O`, where `<Y as Tr>::O` is `&'static u64`, is refused at the signature as borrowck.elision ("the result of 'mk' borrows, but from which parameter is not said"); rustc normalizes the result to `&'static u64` and refuses only the body's borrow of the local, E0597 (0.30.2)
// From the review of g302static (its form g09_assoc_ret). Since v0.30.1
// at least (the same error), and on the release build with g302static
// merged. RT-389 is a projection the signature cannot normalize.
// ERROR: line 18
trait Tr {
    type O;
}

struct Y;

impl Tr for Y {
    type O = &'static u64;
}

fn mk(gpa: Gpa) -> <Y as Tr>::O {
    let b = Box::new_in(9u64, gpa);
    let r: <Y as Tr>::O = &*b;
    r
}

fn main(gpa: Gpa) {
    let v = mk(gpa);
    println("{}", v);
}
