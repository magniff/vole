// EDITION: rust
// RULE: F18.5
// An open local takes the type of its first constraining use, and its
// literals must fit it: `300` is no u8 (rustc: literal out of range).
// ERROR: error[type error]: integer literal 300 does not fit in type 'u8'
fn byte(x: u8) -> u8 {
    x
}

fn main() {
    let x = 300;
    println("{}", byte(x));
}
