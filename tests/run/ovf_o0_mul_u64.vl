// EDITION: rust
// (0.26.3, decision 6) `a * b` of u64s panics at -O0, where the overflow
// checks are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_mul_u64.vl:18:13: attempt to multiply with overflow

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: u64 = idu(4294967296) as u64;
    let b: u64 = idu(4294967296) as u64;
    println("before");
    let r = a * b;
    println("after {}", r);
}
