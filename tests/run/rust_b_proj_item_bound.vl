// RULE: D4.6 (f)
// (0.27.5) A generic iterator's item, `I: Iterator<Item = &'a str>`: in
// the template (the opaque instance) `it.next()`'s item is the bound's
// `'a`, not a borrow of the local `it`, so it is returned and kept past
// it; a `for` over the iterator alike.
// EXPECT: Some("a") Some("c") b
fn first<'a, I: Iterator<Item = &'a str>>(args: I) -> Option<&'a str> {
    let mut it = args;
    let t = it.next();
    t
}

fn last<'a, I: Iterator<Item = &'a str>>(args: I) -> Option<&'a str> {
    let mut r: Option<&'a str> = None;
    for t in args {
        r = Some(t);
    }
    r
}

struct Holder<'a> {
    word: &'a str,
}

fn hold<'a, I: Iterator<Item = &'a str>>(args: I) -> Holder<'a> {
    let mut it = args;
    let _ = it.next();
    let h = Holder { word: it.next().unwrap_or("") };
    drop(it);
    h
}

fn main() {
    let text = "a b c";
    let h = hold(text.split(' '));
    println("{:?} {:?} {}", first(text.split(' ')), last(text.split(' ')), h.word);
}
