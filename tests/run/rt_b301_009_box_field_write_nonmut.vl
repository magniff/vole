// XFAIL: RT-B301-9: a write through a `&mut` field of a Box that is not `mut` is refused (open, 0.30.2; 0.30.0 the same)
// `let b = Box::new_in(W { s: &mut arr }, gpa); b.s[0] = 7;`: rustc's Box
// deref is built in and the write goes through the `&mut` it holds, so
// rustc accepts it (7); vole's DerefMut of b asks for `let mut b`. The
// same field given to a call is accepted (rust_b_box_field_arg_ok).
// EXPECT: 7
struct W<'a> {
    s: &'a mut [i64],
}

fn main(gpa: Gpa) {
    let mut arr = [3i64, 1];
    let b = Box::new_in(W { s: &mut arr }, gpa);
    b.s[0] = 7;
    println("{}", b.s[0]);
}
