// XFAIL: RT-335c: (RT-335's mechanism, self-recursion) `fn mk(n: i64) -> impl Fn() -> i64` whose body calls `mk(n - 1)` and calls the result (or puts it in a struct field, or borrows it) is refused as opaque.cycle; rustc accepts it and prints the EXPECT lines (0.30.2)
// From the third re-review of g302copy. Since v0.30.1 at least.
// From the review's forms oe01 (oe02 a struct field, oe03 a reference:
// refused the same way). An `impl Iterator`: rt_335d.
// EXPECT: in 1 0
// EXPECT: in 2 1
// EXPECT: f 2
fn mk(n: i64) -> impl Fn() -> i64 {
    if n > 0 {
        let f = mk(n - 1);
        println("in {} {}", n, f());
    }
    move || n
}

fn main() {
    let f = mk(2);
    println("f {}", f());
}
