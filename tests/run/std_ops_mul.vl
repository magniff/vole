// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Mul.
// EXPECT: V { x: 60 }
use std::ops::Mul;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Mul for V {
    type Output = V;

    fn mul(self, rhs: V) -> V {
        V { x: self.x * rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?}", a * b);
}
