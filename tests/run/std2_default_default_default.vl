// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::default Default::default.
// EXPECT: 0 None
use std::default::Default;

fn zero<T: Default>() -> T {
    T::default()
}

fn main() {
    let n: i64 = zero();
    let o: Option<i64> = zero();
    println("{} {:?}", n, o);
}
