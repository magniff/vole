// FLAGS: --check-unsafe
// EXPECT: 21 2430
// 0.30.1: C's getline grows the buffer it is given with C's realloc,
// inside the C library, unseen by the check (here in place: the same
// address, more bytes). macOS: the check sees C's realloc
// (malloc_logger) and forgets the block; glibc: it asks C's allocator
// before it reports, and the block's size there is another now. A valid
// program, run clean.
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn free(p: *mut u8);
    fn fmemopen(buf: *const u8, size: usize, mode: *const u8) -> *mut u8;
    fn fclose(f: *mut u8) -> i32;
    fn getline(line: *mut *mut u8, cap: *mut usize, f: *mut u8) -> isize;
}

fn main() {
    let text = "yyyyyyyyyyyyyyyyyyyy\n";
    // UNSAFE: C's stdio and allocator.
    // SAFETY: text outlives the stream
    // (closed before it ends); the reads are within the n bytes getline
    // returned, in the buffer it returned.
    unsafe {
        let mut buf = malloc(16);
        let mut cap: usize = 16;
        let f = fmemopen(text.as_ptr(), text.len(), c"r" as *const u8);
        let n = getline(&mut buf, &mut cap, f);
        let mut sum = 0u64;
        for i in 0..n as usize {
            sum += *buf.add(i) as u64;
        }
        println("{n} {sum}");
        free(buf);
        fclose(f);
    }
}
