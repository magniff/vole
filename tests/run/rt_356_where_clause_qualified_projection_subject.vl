// XFAIL: RT-356: a where clause `where <T as A>::Out: B` does not parse ("expected '{', got '<'"); rustc accepts (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 55
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: u32;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: u32 = 2;
    fn make() -> i64 {
        40
    }
}

fn id<T>(t: T) -> T {
    t
}

fn sz<T>() -> i64 {
    7
}

fn k<T: A>() -> i64
where
    <T as A>::Out: B,
{
    <<T as A>::Out as B>::make() + <T as A>::C + (<T as A>::C << 2)
}

fn main() {
    println("{}", k::<S>());
}
