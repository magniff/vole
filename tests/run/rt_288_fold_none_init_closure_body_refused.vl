// XFAIL: RT-288: `fold(None, |b, x| Some(..))`, the accumulator's type inferred from the closure's body, is refused: "the closure's body has type 'Option<i64>', expected 'Option<_>'"; with the closure's parameter written, `|b: Option<i64>, x|`, it is closure.sig "the bound of 'F' gives it 'Option<_>'" (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). With the let's type written
// (`let d: Option<i64> = v.iter().fold(None, ..)`) it builds. The same with
// a program's own fold-shaped fn (`fn fl<I: Iterator, B, F: Fn(B,
// I::Item) -> B>`, r302f ii/h/fp2).
// EXPECT: Some(3) Some(3) Some(6) Some(6)
fn main() {
    let v = [1i64, 2, 3];
    let a = v.iter().fold(None, |_b, x| Some(x));
    let b = v.iter().fold(None, |_b, x| Some(*x));
    let c = v.iter().fold(None, |b: Option<i64>, x| Some(b.unwrap_or(0) + *x));
    let d: Option<i64> = v.iter().fold(None, |b, x| Some(b.unwrap_or(0) + *x));
    println("{:?} {:?} {:?} {:?}", a, b, c, d);
}
