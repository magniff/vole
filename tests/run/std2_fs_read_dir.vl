// EDITION: rust
// The std2 item(s): std::fs create_dir; std::fs create_dir_all; std::fs read_dir; std::fs ReadDir; std::fs ReadDir::impl Iterator; std::fs ReadDir::impl Drop; std::fs DirEntry; std::fs DirEntry::file_name; std::fs DirEntry::path; std::fs DirEntry::file_type; std::fs DirEntry::metadata; std::fs FileType; std::fs FileType::is_dir; std::fs FileType::is_file; std::fs FileType::is_symlink; std::fs remove_dir; std::fs remove_dir_all; std::fs symlink_metadata; std::fs Metadata::file_type; std::fs Metadata::is_symlink.
// EXPECT: AlreadyExists
// EXPECT: 1 1 true
// EXPECT: 2 true
// EXPECT: DirectoryNotEmpty
// EXPECT: false NotFound true
use std::fs;

fn main() {
    fs::create_dir_all("t/a/b").unwrap();
    fs::create_dir_all("t/a/b/").unwrap();
    fs::create_dir("t/c").unwrap();
    println("{:?}", fs::create_dir("t/c").unwrap_err().kind());
    fs::write("t/a/x.txt", "x").unwrap();
    let mut dirs = 0;
    let mut files = 0;
    let mut x = false;
    for e in fs::read_dir("t/a").unwrap() {
        let e = e.unwrap();
        let t = e.file_type().unwrap();
        if t.is_dir() {
            dirs += 1;
        }
        if t.is_file() && !t.is_symlink() {
            files += 1;
        }
        if e.file_name() == "x.txt" {
            x = e.path().ends_with("t/a/x.txt") && e.metadata().unwrap().len() == 1;
        }
    }
    println("{} {} {}", dirs, files, x);
    let m = fs::symlink_metadata("t").unwrap();
    println("{} {}", fs::read_dir("t").unwrap().count(), m.file_type().is_dir() && !m.is_symlink());
    println("{:?}", fs::remove_dir("t/a").unwrap_err().kind());
    fs::remove_dir("t/c").unwrap();
    fs::remove_dir_all("t").unwrap();
    let gone = fs::read_dir("t").err().unwrap();
    println("{} {:?} {}", fs::exists("t").unwrap(), gone.kind(),
        fs::symlink_metadata("t").is_err());
}
