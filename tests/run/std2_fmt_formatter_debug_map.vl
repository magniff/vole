// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt Formatter::debug_map.
// EXPECT: {"a": 1, "b": true}
// EXPECT: {
// EXPECT:     "a": 1,
// EXPECT:     "b": true,
// EXPECT: }
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_map().entry(&"a", &self.a).entry(&"b", &self.b).finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
