// (0.30.1, E1.8) A proof that reads a local, a divisor proven not 0 or a
// counted `while`'s variable, does not hold when a raw pointer may hold
// the local's address: a write through it changes the local unseen. The
// address taken raw, a reference to it cast to a raw pointer (directly,
// or a reference held in a local), before the loop or in it. Each of
// these refused a 0.30.1 draft's proof (k3 panicked at -O0 and -O2 under
// #[no_panic]; l1 hung though it was not `diverge`).
// ERROR: 'k3' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k4' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'l1' is #[effects(unsafe)], but it may not terminate
// ERROR: 'l9' is #[effects(unsafe)], but it may not terminate
// ERROR: 'l10' is #[effects(unsafe)], but it may not terminate
// ERROR: 'l11' is #[effects(unsafe)], but it may not terminate
// ERROR-COUNT: 6

#[no_panic]
fn k3(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let p = &raw const d as *mut u64;
        // UNSAFE: the case: a write through a raw pointer to d
        // SAFETY: p is d's address and d is live
        unsafe {
            *p = 0;
        }
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k4(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let p = &d as *const u64 as *mut u64;
        // UNSAFE: the case: a write through a pointer made from &d
        // SAFETY: p is d's address and d is live
        unsafe {
            *p = 0;
        }
        x / d
    } else {
        0
    }
}

#[effects(unsafe)]
fn l1(n: i64) -> i64 {
    let mut i = 0;
    let p = &raw mut i;
    while i < n {
        // UNSAFE: the case: a write through a raw pointer to i
        // SAFETY: p is i's address and i is live
        unsafe {
            *p = 0;
        }
        i += 1;
    }
    i
}

#[effects(unsafe)]
fn l9(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let p = &i as *const i64 as *mut i64;
        // UNSAFE: the case: a write through a pointer made from &i
        // SAFETY: p is i's address and i is live
        unsafe {
            *p = 0;
        }
        i += 1;
    }
    i
}

#[effects(unsafe)]
fn l10(n: i64) -> i64 {
    let mut i: i64 = 0;
    let r = &mut i;
    let p = r as *mut i64;
    while i < n {
        // UNSAFE: the case: a write through a pointer made from a &mut i
        // SAFETY: p is i's address and i is live
        unsafe {
            *p = 0;
        }
        i += 1;
    }
    i
}

fn to_raw(r: &mut i64) -> *mut i64 {
    r as *mut i64
}

#[effects(unsafe)]
fn l11(n: i64) -> i64 {
    let mut i = 0;
    let p = to_raw(&mut i);
    while i < n {
        // UNSAFE: the case: a write through a pointer a call made of &mut i
        // SAFETY: p is i's address and i is live
        unsafe {
            *p = 0;
        }
        i += 1;
    }
    i
}

fn main() {
    println("{} {}", k3(7, 1), k4(7, 1));
    println("{} {} {} {}", l1(0), l9(0), l10(0), l11(0));
}
