// XFAIL: RT-72: wrong code in a generic instance: the instance's call is not decided by the template (RT-72's family): form a04 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 21300 600
// EXPECT: 1100 200
trait Mk { const K: i64; fn make() -> Self; fn val(&self) -> i64; }
struct S { k: i64 }
impl S { const K: i64 = 300; fn make() -> S { S { k: 3 } } fn val(&self) -> i64 { self.k * 7 } }
impl Mk for S { const K: i64 = 100; fn make() -> S { S { k: 1 } } fn val(&self) -> i64 { self.k } }
fn build<T: Mk>() -> i64 { T::make().val() * 1000 + T::K }

trait Mk2: Sized {
    fn make2() -> Self; fn twice() -> i64 where Self: Mk { Self::K + <Self as Mk>::K }
}

impl Mk2 for S { fn make2() -> S { S { k: 2 } } }
fn main() { println("{} {}", build::<S>(), <S as Mk2>::twice()); }
