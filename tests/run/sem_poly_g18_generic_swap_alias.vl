// EDITION: rust
// XFAIL: gap 18: rustc says E0507 (borrowck.move_out); the rust edition: borrowck.mut_twice
// a generic swap called with the same place twice: exclusivity
// ERROR: borrowck.move_out
fn sw<T>(a: &mut T, b: &mut T) { let t = *a; *a = *b; *b = t; }

fn main() {
    let mut x: i64 = 1;
    { let at_arg1 = &mut x; sw(&mut x, at_arg1) };
    println("{x}");
}
