// two `&mut` elements of one array at indices the borrow checker does not
// know (rustc E0499; a constant index of a Copy element is its own place,
// R7, so the indices are cast variables, as in sem_excl_ex_elems_ij)
// ERROR: borrowck.mut_twice
use std::mem;

fn main() {
    let mut a = [1i64, 2];
    let i: i64 = 0;
    let j: i64 = 1;
    mem::swap(&mut a[i as usize], &mut a[j as usize]);
    println("{}", a[0]);
}
