// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): Vec::insert's `requires i <= self.len()`, violated last.
// EXPECT: [1, 2, 3]
// EXIT: 101
// STDERR: requires failed: 'i <= self.len()'
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::from_in([1, 2], gpa);
    v.insert(2, 3);
    println("{:?}", v);
    v.insert(9, 9);
}
