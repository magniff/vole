// The std2 item(s): std::collections::BTreeSet: new_in, insert, contains, get,
// remove, take, len, is_empty, clear, first, last, pop_first, pop_last, iter,
// range, is_subset, is_superset, is_disjoint, clone_in, Clone, PartialEq,
// Debug, Extend, collect_in, `for x in &s`, `for x in s`.
// RUSTC: none (the set takes its allocator)
// FLAGS: --check-alloc
// EXPECT: true false 4 {1, 3, 4, 9}
// EXPECT: true false Some(4) None Some(1) Some(9)
// EXPECT: [3, 4] [9, 4, 3, 1] [4, 9]
// EXPECT: true Some(3) false 2 Some(1) Some(9) {4}
// EXPECT: true true false true false
// EXPECT: {"ant", "bee", "cat"} true 3 ["cat", "bee", "ant"]
// EXPECT: 200 0 199 100 true
use std::alloc::Gpa;
use std::collections::BTreeSet;

fn main(gpa: Gpa) {
    let mut s: BTreeSet<i64, Gpa> = BTreeSet::new_in(gpa);
    let a = s.insert(4);
    s.insert(1);
    s.insert(9);
    s.insert(3);
    let b = s.insert(4);
    println("{a} {b} {} {:?}", s.len(), s);
    println("{} {} {:?} {:?} {:?} {:?}", s.contains(&3), s.contains(&5), s.get(&4), s.get(&2),
        s.first(), s.last());
    let r: Vec<i64, Gpa> = s.range(2..9).map(|x| *x).collect_in(gpa);
    let back: Vec<i64, Gpa> = s.iter().rev().map(|x| *x).collect_in(gpa);
    let tail: Vec<i64, Gpa> = s.range(4..=9).map(|x| *x).collect_in(gpa);
    println("{:?} {:?} {:?}", r, back, tail);
    let all = s.clone();
    println("{} {:?} {} {} {:?} {:?} {:?}", s.remove(&3), all.clone_in(gpa).take(&3), s.remove(&3),
        { s.insert(3); s.take(&3); s.len() - 1 }, s.pop_first(), s.pop_last(), s);
    let mut odd: BTreeSet<i64, Gpa> = BTreeSet::new_in(gpa);
    odd.extend([1i64, 3, 9]);
    println("{} {} {} {} {}", s.is_subset(&all), all.is_superset(&odd), odd.is_subset(&s),
        odd.is_disjoint(&s), all == odd);

    let words: BTreeSet<&str, Gpa> = ["cat", "ant", "bee", "ant"].into_iter().collect_in(gpa);
    let mut seen = 0;
    for w in &words {
        seen += w.len() / 3;
    }
    print("{:?} {} {seen} ", words, words.contains("bee"));
    let mut rev: Vec<&str, Gpa> = Vec::new_in(gpa);
    for w in words.into_iter().rev() {
        rev.push(w);
    }
    println("{:?}", rev);

    let mut big: BTreeSet<u32, Gpa> = BTreeSet::new_in(gpa);
    for i in 0..400 {
        big.insert(((i * 7) % 200) as u32);
    }
    let n = big.len();
    let lo = *big.first().unwrap();
    let hi = *big.last().unwrap();
    for i in 0..100 {
        big.remove(&((i * 2) as u32));
    }
    let left = big.len();
    big.clear();
    println("{n} {lo} {hi} {left} {}", big.is_empty());
}
