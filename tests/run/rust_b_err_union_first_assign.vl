// RULE: M2
// (0.30.1) A union's field assigned where no move of the union reaches it:
// the union's first assignment (rustc E0381), in a loop, beside a branch's
// move of another, before a later move (rust_b_ok_union_loop_reinit).
// ERROR: error[borrowck.assign_moved_part]
// ERROR: line 29, column 9
// ERROR: error[borrowck.assign_moved_part]
// ERROR: line 38, column 9
// ERROR: error[borrowck.assign_moved_part]
// ERROR: line 51, column 5
// ERROR-COUNT: 3
use std::mem::ManuallyDrop;

struct D {
    v: i64,
}

union U {
    a: ManuallyDrop<D>,
    b: i64,
}

// No move of the union before the loop or in it: the assignment is its
// first.
fn in_loop(n: i64) {
    let mut u: U;
    let mut i = 0;
    while i < n {
        u.b = i;
        i += 1;
    }
}

// A move of another union in a branch that does not reach the assignment.
fn other(c: bool) {
    let mut u: U;
    if c {
        u.b = 1;
    } else {
        let w = U { b: 2 };
        // UNSAFE: a union's field read
        // SAFETY: the test is a borrowck error; it never runs
        let d = unsafe { w.a };
        println("{}", d.v);
    }
}

// The move after the assignment, no loop.
fn later() {
    let mut u: U;
    u.b = 3;
    // UNSAFE: a union's field read
    // SAFETY: the test is a borrowck error; it never runs
    let d = unsafe { u.a };
    println("{}", d.v);
}

fn main() {
    in_loop(1);
    other(true);
    later();
}
