// EDITION: rust
// inout self and a let of one of its fields.
// EXPECT: 1
#[derive(Clone, Copy)] struct S { a: i64, b: [i64; 2] }

impl S {
    #[inline(never)]
    fn f(&mut self, b: [i64; 2]) -> i64 { self.b[0] = 10; b[0] }
}

fn main() -> i32 {
    let mut s = S { a: 1, b: [1i64, 2] };
    println("{}", s.f(s.b));
    0
}
