// (0.30.2, obligations M1) A trait's default method with the bound, `fn
// call<T: Tr<i32>>`: Tr<i32>'s `'a: 'static` is required (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
trait Caller { fn call<T: Tr<i32>>(&self, t: &T) -> &'static str { t.f() } }
struct C;
impl Caller for C {}

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa); C.call(&W { r: st.as_str() })
    };
    println("{}", s);
}
