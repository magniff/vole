// EDITION: rust
// RULE: D9.2
// (0.27.1) A holder moved on one path only: the drop flag keeps its drop at
// the scope's end.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 24, column 17
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut h = HD { r: &z };
    let x: i64 = 1;
    h = HD { r: &x };
    if x > 0 {
        drop(h);
    }
    println("{}", x);
}
