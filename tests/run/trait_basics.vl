// 0.9: traits: declarations, impls, default functions, bounds on generic
// functions, associated functions through a bounded parameter, generic
// impls with bounds.
// (0.26.4) Its PRNG and checksums are written wrapping_*.
use std::hash::Hash;

trait Shape {
    fn name(&self) -> &str;
    fn area(&self) -> i64;
    fn corners(&self) -> i64;

    // A default: used by impls that leave it out.
    fn describe(self) {
        print("default: shape with ");
        print("{}", self.corners());
        println(" corners");
    }
}

trait Zero {
    fn zero() -> Self;
}

#[derive(Clone, Copy)] struct Circle { r: i64 }
#[derive(Clone, Copy)] struct Square { side: i64 }

impl Shape for Circle {
    fn name(&self) -> &'static str { "circle" }
    fn area(&self) -> i64 { 3 * self.r * self.r }
    fn corners(&self) -> i64 { 0 }
}

impl Shape for Square {
    fn name(&self) -> &'static str { "square" }
    fn area(&self) -> i64 { self.side * self.side }
    fn corners(&self) -> i64 { 4 }
}

impl Zero for Circle {
    fn zero() -> Circle { Circle { r: 0 } }
}

impl Zero for i64 {
    fn zero() -> i64 { 0 }
}

fn show<T: Shape>(s: &T, size: i64) {
    print("{}", s.name());
    print(" ");
    print("{}", size);
}

fn area_of<T: Shape>(s: T) -> i64 {
    s.area()
}

fn zero_of<T: Zero>() -> T {
    T::zero()
}

#[derive(Clone, Copy)] struct Pair<T> { a: T, b: T }

impl<T: Hash> Hash for Pair<T> {
    fn hash(&self) -> u64 {
        self.a.hash().wrapping_mul(31u64).wrapping_add(self.b.hash())
    }
}

fn hash_twice<T: Hash>(x: T) -> u64 {
    x.hash() + x.hash()
}

fn main() -> i32 {
    let c = Circle { r: 3 };
    let s = Square { side: 4 };
    show(&c, 3i64);
    print(" ");
    show(&s, 4i64);
    println("");
    print("area ");
    print("{}", (area_of(c) + 1));
    print(" ");
    print("{}", area_of(s));
    println("");
    s.describe();
    c.describe();
    print("total ");
    print("{}", (area_of(c) + area_of(s)));
    println("");
    let z: Circle = zero_of();
    let n: i64 = zero_of();
    print("zero ");
    print("{}", z.r);
    print(" ");
    print("{}", n);
    println("");
    let p = Pair { a: 1i64, b: 2i64 };
    let h = p.hash();
    print("hash pair ");
    print("{}", ((hash_twice(p) == 2 * h) as i64));
    println("");
    0
}
