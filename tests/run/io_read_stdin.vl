// EDITION: rust
// XFAIL: gap 17: compile format.args: a format string is a literal: this argument has no hole to go to
// read_stdin (0.15) returns Result<Buf, IoError>: what read_line had
// buffered first, then the rest of stdin (then nothing: an empty Buf).
// STDIN: head
// STDIN: a b
// STDIN: c
// EXPECT: head|a b\nc|0
use std::io; use std::io::read_to_string_in as read_stdin_in;

fn main(gpa: Gpa) {
    let mut line = String::new_in(gpa);
    io::stdin().read_line(&mut line).map(|n| n > 0).unwrap();
    print("{}", str::from_utf8(line.as_bytes()).unwrap());
    print("|");
    let mut rest = match {
        let mut v = Vec::new_in(gpa); io::stdin().read_to_end(&mut v).map(|_| v)
    } {
        Ok(b) => b,
        Err(e) => {
            println("read error");
            return;
        }
    };
    let text = rest.as_slice();
    for i in 0..text.len() {
        if text[i] == b'\n' {
            if i + 1 < text.len() {
                print("\\n");
            }
        } else {
            print("{}", str::from_utf8(text[i..i + 1]).unwrap());
        }
    }
    print("|");
    print("{}",
        ({ let mut v = Vec::new_in(gpa); io::stdin().read_to_end(&mut v).map(|_| v) }
            .unwrap()
                .len() as i64));
    println("");
}
