// RULE: F8.3, F8.4
// RT-C301-8 review (R2, form f51_myfrom_unqual): `i64::from(5u8)` with `impl MyFrom<u8> for i64`: two traits' `from` (rustc E0034), not MyFrom's silently.
// rustc: error[E0034]: multiple applicable items in scope
// ERROR: error[method.ambiguous]: multiple applicable items: 'from' is an item of more than one trait for 'i64'
trait MyFrom<T> { fn from(x: T) -> Self; }
impl MyFrom<u8> for i64 { fn from(x: u8) -> i64 { 1000 + x as i64 } }
fn main() { let a = i64::from(5u8); println("{}", a); }
