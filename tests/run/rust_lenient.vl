// EDITION: rust
// (0.27.0) edition.lenient: what 0.27.0's rust edition accepts and Rust
// rejects, 0.19's meanings kept (`volec guide edition`): a `&T` of a plain
// value read where the value goes, a place lent where `&T` goes. Each such
// line is marked `edition.lenient`, a count; 0.27.1's checker rejects them
// and this case becomes their errors.

fn takes(x: &i64) -> i64 {
    *x + 1
}

fn main() -> i32 {
    let n = 5;
    let r = &n;
    let b: i64 = r; // edition.lenient: a `&i64` read where an `i64` goes
    let c = takes(n); // edition.lenient: a place lent where `&i64` goes
    println("{} {}", b, c);
    0
}
// EXPECT: 5 6
