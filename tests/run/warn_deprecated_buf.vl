// 0.26.3: std's Buf is #[deprecated]: each use (the import, the type, a
// constructor's path) is warning item.deprecated, whose note names
// String<A> for text, Vec<u8, A> for bytes and `volec fix --only buf`;
// the program builds and runs as before. std's own uses (std::gpu::wgsl's,
// until 0.27) warn nothing: a program on std::gpu::wgsl gets a Vec<u8, A>
// or a String<A> from it.
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf': use String<A> for text, Vec<u8, A> for bytes (volec fix --only buf)
// WARNING: help: marked #[deprecated] at
// EXPECT: ab 2
use std::Buf;

fn fill(b: inout Buf<Gpa>) {
    b.push_str("ab");
}

fn main(gpa: Gpa) {
    var b = Buf::new_in(gpa);
    fill(&b);
    println("{} {}", b.as_slice(), b.len());
}
