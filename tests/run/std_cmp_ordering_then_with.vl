// Runs on std since 0.27.2's switch.
// The std item(s): std::cmp Ordering::then_with.
// EXPECT: Less Greater 1
use std::cmp::Ordering;

fn main() {
    let mut calls = 0;
    let a = Ordering::Equal.then_with(|| {
        calls += 1;
        Ordering::Less
    });
    let b = Ordering::Greater.then_with(|| {
        calls += 1;
        Ordering::Less
    });
    println("{:?} {:?} {}", a, b, calls);
}
