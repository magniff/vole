// EDITION: rust
// std::sync::Arc shared with spawned threads: each thread owns a clone,
// reads the value and adds to a shared atomic; the count is back to one
// when they are joined. (Not a std2_ case: those are built with
// --check-alloc, under which the effect check refuses this program;
// std2_sync_arc covers Arc on one thread, with the leak check.)
// EXPECT: [15, 16, 17] 1 3
use std::thread;
use std::sync::Arc;
use std::sync::atomic::{AtomicI64, Ordering};

fn main(gpa: Gpa) {
    let a: Arc<i64, Gpa> = Arc::new_in(5, gpa);
    let total: Arc<AtomicI64, Gpa> = Arc::new_in(AtomicI64::new(0), gpa);
    let mut out: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut hs: Vec<thread::JoinHandle<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 0..3i64 {
        let t = total.clone();
        let base = a.clone();
        hs.push(thread::spawn_in(move || {
            (*t).fetch_add(i, Ordering::SeqCst);
            *base + 10 + i
        }, gpa));
    }
    for h in hs {
        out.push(h.join().unwrap());
    }
    out.sort();
    println("{:?} {} {}", out, Arc::strong_count(&total), (*total).load(Ordering::SeqCst));
}
