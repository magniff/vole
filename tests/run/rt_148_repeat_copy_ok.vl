// FLAGS: --check-alloc
// RULE: F35.1, F35.2 (0.30.2, RT-148) The repeats rustc accepts, with its
// output and drop order: a Copy struct, a `T: Copy` value, an `impl Fn +
// Copy` value, closures that are Copy (one borrowing, one moving an
// i64), shared references, a constant of a type that is not Copy (each
// element made from it: a free constant, an inherent one, a trait's), and
// the lengths 0 (the value dropped at once) and 1 (moved in). The output
// is rustc's, the program built by rustc with std's Vec and Box.
// EXPECT: 7 7 7
// EXPECT: 5 5
// EXPECT: 8 8
// EXPECT: 4 4
// EXPECT: 2 0
// EXPECT: 3 0 0 0
// EXPECT: 2 1 1
// EXPECT: drop 10
// EXPECT: zero 0
// EXPECT: one 1
// EXPECT: drop 30
// EXPECT: two 2
// EXPECT: end
// EXPECT: drop 20
// EXPECT: drop 11
// EXPECT: drop 11
// EXPECT: drop 11
#[derive(Clone, Copy)]
struct P {
    x: i64,
}

struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

const EMPTY: Option<Box<i64, Gpa>> = None;
const E11: D = D { k: 11 };

struct W {}

impl W {
    const NONE: Option<D> = None;
}

trait Tr {
    const C: Option<D>;
}

impl Tr for W {
    const C: Option<D> = None;
}

fn rep<T: Copy>(t: T) -> [T; 2] {
    [t; 2]
}

fn mk(k: i64) -> impl Fn() -> i64 + Copy {
    move || k * 2
}

fn zero(d: D) -> [D; 0] {
    [d; 0]
}

fn main(gpa: Gpa) {
    let p = [P { x: 7 }; 3];
    println("{} {} {}", p[0].x, p[1].x, p[2].x);
    let r = rep(5i64);
    println("{} {}", r[0], r[1]);
    let f = [mk(4); 2];
    println("{} {}", (f[0])(), (f[1])());
    let k = 4i64;
    let by_ref = || k;
    let by_move = move || k;
    let c1 = [by_ref; 2];
    let c2 = [by_move; 2];
    println("{} {}", (c1[1])(), (c2[1])());
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let refs = [&v; 2];
    println("{} {}", refs.len(), refs[1].len());
    let e = [EMPTY; 3];
    let n = [W::NONE; 2];
    let t = [<W as Tr>::C; 2];
    println("{} {} {} {}", e.len(), e[2].is_some() as i64, n[1].is_some() as i64,
        t[0].is_some() as i64);
    let ds = [E11; 3];
    println("{} {} {}", n.len(), ds[0].k / 11, ds[2].k / 11);
    let z = zero(D { k: 10 });
    println("zero {}", z.len());
    let one = [D { k: 20 }; 1];
    println("one {}", one.len());
    let gone = [D { k: 30 }; 0];
    println("two {}", 2 + gone.len());
    println("end");
}
