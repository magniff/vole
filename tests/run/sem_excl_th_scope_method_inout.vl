// a scoped thread calling an inout method on a captured var
// ERROR: error[borrowck.mut_twice]
// ERROR: line 11, column 61
use std::thread;
#[derive(Clone, Copy)] struct C { n: i64 }
impl C { fn inc(&mut self) { self.n += 1; } }

fn main() {
    let mut c = C { n: 0 };
    thread::scope(|s| ({ let s = s; {
        let a = s.spawn(|| { c.inc(); 0 }); let b = s.spawn(|| { c.inc(); 0 });
        a.join().unwrap() + b.join().unwrap()
    } })); println("{}", c.n);
}
