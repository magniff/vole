// XFAIL: RT-M2-3: an impl's method whose lifetimes differ from the trait's is accepted (open)
// The trait promises a `&'static i64` from `get`, and a `put` that takes
// a reference of any lifetime; the impls return a reference into self
// and keep their argument forever. rustc refuses both impls (E0308,
// "method not compatible with trait", lifetime mismatch). vole accepts
// them, and a generic caller that is right by the trait's signature then
// fails to check in its own body, once instantiated (`'b' is dropped
// while it is still borrowed` in `go`), or a program that uses neither
// generically compiles with impls that do not implement the trait.
// ERROR: rt_m2_003_impl_lifetimes.vl:26:
// ERROR: rt_m2_003_impl_lifetimes.vl:32:
// ERROR-COUNT: 2
use std::alloc::Allocator;

trait Leak {
    fn get(&self) -> &'static i64;
}

trait Put {
    fn put(&self, x: &i64) -> i64;
}

struct Holder<A: Allocator> { b: Box<i64, A> }

impl<A: Allocator> Leak for Holder<A> {
    fn get(&self) -> &i64 { &*self.b }
}

struct S;

impl Put for S {
    fn put(&self, x: &'static i64) -> i64 { *x }
}

fn main(gpa: Gpa) {
    let h = Holder { b: Box::new_in(1234i64, gpa) };
    println("{} {}", *h.get(), S.put(&5));
}
