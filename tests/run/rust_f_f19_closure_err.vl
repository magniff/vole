// EDITION: rust
// RULE: F19.3
// RUSTC: accepts FL10 a non-capturing closure coerces to an unsafe fn type
// A closure that captures nothing coerces to a `fn` type, not yet to an
// `unsafe fn` type (rustc coerces it to either).
// ERROR: expected 'unsafe fn(i64) -> i64', got 'closure(i64) -> i64
fn main() -> i64 {
    let f: unsafe fn(i64) -> i64 = |x: i64| x + 1;
    // SAFETY: the closure has no precondition.
    unsafe { f(1) }
}
