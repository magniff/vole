// XFAIL: RT-163: a shift with a reference operand (`ra << 2`, `a >> &1`, `c <<= &4`) and unary minus on a reference (`-ra`, `-&a`) are refused (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_009_shift_neg_on_references.rs.txt):
// std implements Shl/Shr/ShlAssign/ShrAssign and Neg for references of the
// integer and float types. vole: `shift operator requires integer type, got
// '&i64'`, `shift amount must be integer, got '&i32'`, `unary '-' requires
// numeric type, got '&i64'`; the other binary operators (+ - * / % & | ^,
// comparisons, += with a reference) take references and print rustc's values
// (232 lines compared, O0 and O2). RT-139 is `!r` for `r: &bool`. Since v0.28.0.
// EXPECT: 28 3 56
// EXPECT: 12 144
// EXPECT: -7 -7 -2.5
// EXPECT: 8
fn main() {
    let a = 7i64;
    let ra = &a;
    let b = 200u8;
    let rb = &b;
    let f = 2.5f64;
    let rf = &f;
    println("{} {} {}", ra << 2, a >> &1, ra << &3);
    println("{} {}", rb >> 4u32, b << &1i32);
    println("{} {} {}", -ra, -&a, -rf);
    let mut c = 1u32;
    c <<= &4;
    c >>= &1u8;
    println("{}", c);
}
