// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FoldSeeds.
// EXPECT: 995491552043266245 6439210812120103500
// RUSTC: none (FoldSeeds is foldhash's SharedSeed (the foldhash crate's, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let seeds = FoldSeeds::from_u64(77);
    let mut a = FoldHasher::with_seeds(1, seeds);
    a.write("abc".as_bytes());
    let mut b = FoldHasher::with_seeds(1, seeds);
    b.write_u64(9);
    println("{} {}", a.finish(), b.finish());
}
