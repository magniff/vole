// EDITION: rust
// RULE: D19.10
// (0.27.2) The result of `f()` keeps `v` borrowed (through the closure's
// result region): assigning `v` while it is used is a conflict (rustc
// E0506).
// ERROR: error[borrowck.assign_borrowed]
fn main() {
    let mut v = 1;
    let f = || &v;
    let r = f();
    v = 2;
    println("{} {}", *r, v);
}
