#[repr(C)] struct S6_1 { a: S7_2, x: u16, b: (S7_1, [S7_2; 2]), y: u8 }
struct S6_2 { a: S7_3, x: u32, b: (S7_2, [S7_3; 2]), y: u8 }
#[repr(C, packed)] struct S6_3 { a: S7_4, x: u64, b: (S7_3, [S7_4; 2]), y: u8 }
struct S6_4 { a: S7_5, x: i8, b: (S7_4, [S7_5; 2]), y: u8 }
#[repr(C)] struct S6_5 { a: S7_0, x: f32, b: (S7_5, [S7_0; 2]), y: u8 }
#[repr(C)] struct S7_0 { a: S8_1, x: u16, b: (S8_0, [S8_1; 2]), y: u8 }
struct S7_1 { a: S8_2, x: u32, b: (S8_1, [S8_2; 2]), y: u16 }
#[repr(C, packed)] struct S7_2 { a: S8_3, x: u64, b: (S8_2, [S8_3; 2]), y: u32 }
struct S7_3 { a: S8_4, x: i8, b: (S8_3, [S8_4; 2]), y: u64 }
#[repr(C)] struct S7_4 { a: S8_5, x: f32, b: (S8_4, [S8_5; 2]), y: i8 }
struct S7_5 { a: S8_0, x: u8, b: (S8_5, [S8_0; 2]), y: f32 }
struct S8_0 { a: S9_1, x: u32, b: (S9_0, [S9_1; 2]), y: u8 }
#[repr(C, packed)] struct S8_1 { a: S9_2, x: u64, b: (S9_1, [S9_2; 2]), y: u32 }
struct S8_2 { a: S9_3, x: i8, b: (S9_2, [S9_3; 2]), y: i8 }
#[repr(C)] struct S8_3 { a: S9_4, x: f32, b: (S9_3, [S9_4; 2]), y: u8 }
struct S8_4 { a: S9_5, x: u8, b: (S9_4, [S9_5; 2]), y: u32 }
#[repr(C)] struct S8_5 { a: S9_0, x: u16, b: (S9_5, [S9_0; 2]), y: i8 }
#[repr(C, packed)] struct S9_0 { a: S10_1, x: u64, b: (S10_0, [S10_1; 2]), y: u8 }
struct S9_1 { a: S10_2, x: i8, b: (S10_1, [S10_2; 2]), y: u64 }
#[repr(C)] struct S9_2 { a: S10_3, x: f32, b: (S10_2, [S10_3; 2]), y: u8 }
struct S9_3 { a: S10_4, x: u8, b: (S10_3, [S10_4; 2]), y: u64 }
#[repr(C)] struct S9_4 { a: S10_5, x: u16, b: (S10_4, [S10_5; 2]), y: u8 }
struct S9_5 { a: S10_0, x: u32, b: (S10_5, [S10_0; 2]), y: u64 }
struct S10_0 { a: S11_1, x: i8, b: (S11_0, [S11_1; 2]), y: u8 }
#[repr(C)] struct S10_1 { a: S11_2, x: f32, b: (S11_1, [S11_2; 2]), y: i8 }
struct S10_2 { a: S11_3, x: u8, b: (S11_2, [S11_3; 2]), y: u32 }
#[repr(C)] struct S10_3 { a: S11_4, x: u16, b: (S11_3, [S11_4; 2]), y: u8 }
struct S10_4 { a: S11_5, x: u32, b: (S11_4, [S11_5; 2]), y: i8 }
#[repr(C, packed)] struct S10_5 { a: S11_0, x: u64, b: (S11_5, [S11_0; 2]), y: u32 }
#[repr(C)] struct S11_0 { a: U1, x: f32, b: (U0, [U1; 2]), y: u8 }
struct S11_1 { a: U2, x: u8, b: (U1, [U2; 2]), y: f32 }
#[repr(C)] struct S11_2 { a: U3, x: u16, b: (U2, [U3; 2]), y: i8 }
struct S11_3 { a: U4, x: u32, b: (U3, [U4; 2]), y: u64 }
#[repr(C, packed)] struct S11_4 { a: U5, x: u64, b: (U4, [U5; 2]), y: u32 }
struct S11_5 { a: U0, x: i8, b: (U5, [U0; 2]), y: u16 }
union U0 { a: S12_0, x: u8, b: (S12_1, [S12_0; 3]) }
#[repr(C)] union U1 { a: S12_1, x: u16, b: (S12_2, [S12_1; 3]) }
union U2 { a: S12_2, x: u32, b: (S12_3, [S12_2; 3]) }
#[repr(C)] union U3 { a: S12_3, x: u64, b: (S12_4, [S12_3; 3]) }
union U4 { a: S12_4, x: i8, b: (S12_5, [S12_4; 3]) }
#[repr(C)] union U5 { a: S12_5, x: f32, b: (S12_0, [S12_5; 3]) }
#[derive(Clone, Copy)] struct S12_0 { v: u8, w: [u8; 1] }
#[derive(Clone, Copy)] struct S12_1 { v: u16, w: [u8; 2] }
#[derive(Clone, Copy)] struct S12_2 { v: u32, w: [u8; 3] }
#[derive(Clone, Copy)] struct S12_3 { v: u64, w: [u8; 4] }
#[derive(Clone, Copy)] struct S12_4 { v: i8, w: [u8; 5] }
#[derive(Clone, Copy)] struct S12_5 { v: f32, w: [u8; 6] }
enum E0 { A(S0_0, u8, S1_1), B(S0_2), C }
#[repr(C)] enum E1 { A(S0_1, u8, S1_2), B(S0_3), C }
enum E2 { A(S0_2, u8, S1_3), B(S0_4), C }
#[repr(C)] enum E3 { A(S0_3, u8, S1_4), B(S0_5), C }
enum E4 { A(S0_4, u8, S1_5), B(S0_0), C }
#[repr(C)] enum E5 { A(S0_5, u8, S1_0), B(S0_1), C }

fn main() {
    println("{} {}", std::mem::size_of::<S0_0>(), std::mem::align_of::<S0_0>());
    println("{} {}", std::mem::size_of::<S1_0>(), std::mem::align_of::<S1_0>());
    println("{} {}", std::mem::size_of::<(S0_0, S0_1, u8)>(),
        std::mem::align_of::<(S0_0, S0_1, u8)>());
    println("{} {}", std::mem::size_of::<[S2_0; 3]>(), std::mem::align_of::<[S2_0; 3]>());
    println("{} {}", std::mem::size_of::<E0>(), std::mem::align_of::<E0>());
    println("{} {}", std::mem::size_of::<S0_1>(), std::mem::align_of::<S0_1>());
    println("{} {}", std::mem::size_of::<S1_1>(), std::mem::align_of::<S1_1>());
    println("{} {}", std::mem::size_of::<(S0_1, S0_2, u8)>(),
        std::mem::align_of::<(S0_1, S0_2, u8)>());
    println("{} {}", std::mem::size_of::<[S2_1; 3]>(), std::mem::align_of::<[S2_1; 3]>());
    println("{} {}", std::mem::size_of::<E1>(), std::mem::align_of::<E1>());
    println("{} {}", std::mem::size_of::<S0_2>(), std::mem::align_of::<S0_2>());
    println("{} {}", std::mem::size_of::<S1_2>(), std::mem::align_of::<S1_2>());
    println("{} {}", std::mem::size_of::<(S0_2, S0_3, u8)>(),
        std::mem::align_of::<(S0_2, S0_3, u8)>());
    println("{} {}", std::mem::size_of::<[S2_2; 3]>(), std::mem::align_of::<[S2_2; 3]>());
    println("{} {}", std::mem::size_of::<E2>(), std::mem::align_of::<E2>());
    println("{} {}", std::mem::size_of::<S0_3>(), std::mem::align_of::<S0_3>());
    println("{} {}", std::mem::size_of::<S1_3>(), std::mem::align_of::<S1_3>());
    println("{} {}", std::mem::size_of::<(S0_3, S0_4, u8)>(),
        std::mem::align_of::<(S0_3, S0_4, u8)>());
    println("{} {}", std::mem::size_of::<[S2_3; 3]>(), std::mem::align_of::<[S2_3; 3]>());
    println("{} {}", std::mem::size_of::<E3>(), std::mem::align_of::<E3>());
    println("{} {}", std::mem::size_of::<S0_4>(), std::mem::align_of::<S0_4>());
    println("{} {}", std::mem::size_of::<S1_4>(), std::mem::align_of::<S1_4>());
    println("{} {}", std::mem::size_of::<(S0_4, S0_5, u8)>(),
        std::mem::align_of::<(S0_4, S0_5, u8)>());
    println("{} {}", std::mem::size_of::<[S2_4; 3]>(), std::mem::align_of::<[S2_4; 3]>());
    println("{} {}", std::mem::size_of::<E4>(), std::mem::align_of::<E4>());
    println("{} {}", std::mem::size_of::<S0_5>(), std::mem::align_of::<S0_5>());
    println("{} {}", std::mem::size_of::<S1_5>(), std::mem::align_of::<S1_5>());
    println("{} {}", std::mem::size_of::<(S0_5, S0_0, u8)>(),
        std::mem::align_of::<(S0_5, S0_0, u8)>());
    println("{} {}", std::mem::size_of::<[S2_5; 3]>(), std::mem::align_of::<[S2_5; 3]>());
    println("{} {}", std::mem::size_of::<E5>(), std::mem::align_of::<E5>());
