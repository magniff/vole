// (0.30.2, from RT-M2-9's fix) A type's layout is made of its
// parts' once per question (front::types::LayoutMemo), not once per path
// to them: 12 levels of six struct shapes, each holding two of the next
// level's (as a field, in a tuple, in an array), the reprs varied (Rust's
// order, C, C packed), with unions and enums (Rust's and C's) over them.
// Laid out as a tree, each size_of here met millions of parts (25 s for
// the case at -O0); the sizes and alignments are those of that tree walk
// (0.30.2 before the memo, the same output), so a part recorded wrongly
// shows here.
// EXPECT: 711177080 8
// EXPECT: 173221920 8
// EXPECT: 1374802152 8
// EXPECT: 116598744 8
// EXPECT: 890495480 8
// EXPECT: 663625064 8
// EXPECT: 179318384 8
// EXPECT: 1234067608 8
// EXPECT: 134355660 1
// EXPECT: 825060632 8
// EXPECT: 570442536 8
// EXPECT: 161435556 1
// EXPECT: 1097586384 8
// EXPECT: 134533152 8
// EXPECT: 706778208 8
// EXPECT: 527143841 1
// EXPECT: 136335656 8
// EXPECT: 1104988248 8
// EXPECT: 116591160 8
// EXPECT: 668857448 8
// EXPECT: 577844392 8
// EXPECT: 130269392 8
// EXPECT: 1246701840 8
// EXPECT: 97471920 8
// EXPECT: 727036072 8
// EXPECT: 668857440 8
// EXPECT: 149191664 8
// EXPECT: 1380034528 8
// EXPECT: 97778736 8
// EXPECT: 842079376 8
struct S0_0 { a: S1_1, x: u8, b: (S1_0, [S1_1; 2]), y: u8 }
#[repr(C)] struct S0_1 { a: S1_2, x: u16, b: (S1_1, [S1_2; 2]), y: u8 }
struct S0_2 { a: S1_3, x: u32, b: (S1_2, [S1_3; 2]), y: u8 }
#[repr(C, packed)] struct S0_3 { a: S1_4, x: u64, b: (S1_3, [S1_4; 2]), y: u8 }
struct S0_4 { a: S1_5, x: i8, b: (S1_4, [S1_5; 2]), y: u8 }
#[repr(C)] struct S0_5 { a: S1_0, x: f32, b: (S1_5, [S1_0; 2]), y: u8 }
#[repr(C)] struct S1_0 { a: S2_1, x: u16, b: (S2_0, [S2_1; 2]), y: u8 }
struct S1_1 { a: S2_2, x: u32, b: (S2_1, [S2_2; 2]), y: u16 }
