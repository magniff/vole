#[repr(C, packed)] struct S3_0 { a: S4_1, x: u64, b: (S4_0, [S4_1; 2]), y: u8 }
struct S3_1 { a: S4_2, x: i8, b: (S4_1, [S4_2; 2]), y: u64 }
#[repr(C)] struct S3_2 { a: S4_3, x: f32, b: (S4_2, [S4_3; 2]), y: u8 }
struct S3_3 { a: S4_4, x: u8, b: (S4_3, [S4_4; 2]), y: u64 }
#[repr(C)] struct S3_4 { a: S4_5, x: u16, b: (S4_4, [S4_5; 2]), y: u8 }
struct S3_5 { a: S4_0, x: u32, b: (S4_5, [S4_0; 2]), y: u64 }
struct S4_0 { a: S5_1, x: i8, b: (S5_0, [S5_1; 2]), y: u8 }
#[repr(C)] struct S4_1 { a: S5_2, x: f32, b: (S5_1, [S5_2; 2]), y: i8 }
struct S4_2 { a: S5_3, x: u8, b: (S5_2, [S5_3; 2]), y: u32 }
#[repr(C)] struct S4_3 { a: S5_4, x: u16, b: (S5_3, [S5_4; 2]), y: u8 }
struct S4_4 { a: S5_5, x: u32, b: (S5_4, [S5_5; 2]), y: i8 }
#[repr(C, packed)] struct S4_5 { a: S5_0, x: u64, b: (S5_5, [S5_0; 2]), y: u32 }
#[repr(C)] struct S5_0 { a: S6_1, x: f32, b: (S6_0, [S6_1; 2]), y: u8 }
struct S5_1 { a: S6_2, x: u8, b: (S6_1, [S6_2; 2]), y: f32 }
#[repr(C)] struct S5_2 { a: S6_3, x: u16, b: (S6_2, [S6_3; 2]), y: i8 }
struct S5_3 { a: S6_4, x: u32, b: (S6_3, [S6_4; 2]), y: u64 }
#[repr(C, packed)] struct S5_4 { a: S6_5, x: u64, b: (S6_4, [S6_5; 2]), y: u32 }
