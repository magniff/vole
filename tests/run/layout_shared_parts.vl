struct S1_3 { a: S2_4, x: i8, b: (S2_3, [S2_4; 2]), y: u64 }
#[repr(C)] struct S1_4 { a: S2_5, x: f32, b: (S2_4, [S2_5; 2]), y: i8 }
struct S1_5 { a: S2_0, x: u8, b: (S2_5, [S2_0; 2]), y: f32 }
struct S2_0 { a: S3_1, x: u32, b: (S3_0, [S3_1; 2]), y: u8 }
#[repr(C, packed)] struct S2_1 { a: S3_2, x: u64, b: (S3_1, [S3_2; 2]), y: u32 }
struct S2_2 { a: S3_3, x: i8, b: (S3_2, [S3_3; 2]), y: i8 }
#[repr(C)] struct S2_3 { a: S3_4, x: f32, b: (S3_3, [S3_4; 2]), y: u8 }
struct S2_4 { a: S3_5, x: u8, b: (S3_4, [S3_5; 2]), y: u32 }
