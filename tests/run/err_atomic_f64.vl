// (0.25.5) No Atomic<f64>: its fetch_add added the bits as an integer.
// ERROR: the trait 'AtomicValue' is not implemented for 'f64'
// ERROR: = help: required by the bound 'T: AtomicValue' of 'Atomic'

use std::sync::atomic::{Atomic, Ordering};

fn main() -> i32 {
    let a: Atomic<f64> = Atomic::new(1.5);
    println(a.fetch_add(1.0, Ordering::SeqCst));
    0
}
