// RULE: D2.5
// (0.27.1) A `&mut self` call while `&s` is live: the reservation is shared,
// its activation conflicts (Activate, S).
// ERROR: error[borrowck.conflict]
// ERROR: line 23, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = &s;
    s.add(1);
    println("{}", r.x);
}
