// EDITION: rust
// RULE: D19.3, D19.5
// (0.27.2) A closure checked against an `FnOnce` bound may move its
// capture out; its env is the closure, moved by the call.
// EXPECT: 4
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn call<F: FnOnce() -> i64>(f: F) -> i64 {
    f()
}

fn main() {
    let s = S { n: 4 };
    println("{}", call(|| eat(s)));
}
