// EDITION: rust
// REQUIRES: metal
// LINK: std::window names the frameworks it links
// ENV: VOLE_WINDOW_SCRIPT=size 640x480 2; frames 2; key a; key shift+B; keydown ctrl+left; keyup ctrl+left; key f5; move 10 20; click right 30 40 shift; press 5 6; release 5 6; scroll 3; scroll -1 2; resize 300x200; focus off; focus on; frames 1; close
// EXPECT: size 640 480 2
// EXPECT: surface null true
// EXPECT: resize 1 640 480 2
// EXPECT: frame 1 1
// EXPECT: frame 1 2
// EXPECT: key 1 97 shift false ctrl false pressed true text true a true left false
// EXPECT: text 1 97
// EXPECT: key 1 66 shift true ctrl false pressed true text true a false left false
// EXPECT: text 1 66
// EXPECT: key 1 -2 shift false ctrl true pressed true text false a false left true
// EXPECT: key 1 -2 shift false ctrl true pressed false text false a false left true
// EXPECT: key 1 1005 shift false ctrl false pressed true text false a false left false
// EXPECT: mouse move -1 10 20 shift false clicks 0
// EXPECT: mouse press 1 30 40 shift true clicks 1
// EXPECT: mouse release 1 30 40 shift true clicks 0
// EXPECT: mouse press 0 5 6 shift false clicks 1
// EXPECT: mouse release 0 5 6 shift false clicks 0
// EXPECT: scroll 0 3 false
// EXPECT: scroll 2 -1 false
// EXPECT: resize 1 300 200 2
// EXPECT: focus false false
// EXPECT: focus true true
// EXPECT: frame 1 3
// EXPECT: close 1
// EXPECT: quit
// EXPECT: fullscreen true
// (0.28.0) std::window on the rust edition's std: the scripted event loop
// (no display), every command of a script as the event the program reads.
// The output is the old std's for the same program and script.

use std::window::{App, Button, Event, MouseAction, WindowDesc};
use std::window::keys::{KeyCode, Logical, Named};

fn button(b: Button) -> i64 {
    match b {
        Button::Left => 0,
        Button::Right => 1,
        Button::Middle => 2,
        Button::Other(n) => n,
        Button::None => -1,
    }
}

fn logical(l: Logical) -> i64 {
    match l {
        Logical::Char(c) => c as i64,
        Logical::Named(n) => {
            if n == Named::ArrowLeft { -2 } else { -3 }
        }
        Logical::F(n) => 1000 + n,
        _ => -1,
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => return 1,
    };
    let mut win = match app.window(WindowDesc::new("script", 100, 50)) {
        Ok(w) => w,
        Err(_) => return 1,
    };
    let s = win.size();
    println("size {} {} {}", s.w, s.h, s.scale);
    println("surface null {}", win.raw_surface().is_null());
    win.request_frame();
    let mut frames = 0;
    loop {
        let e = match app.wait() {
            Ok(e) => e,
            Err(_) => return 1,
        };
        match e {
            Event::Frame(id) => {
                frames += 1;
                println("frame {} {frames}", id.n);
                win.request_frame();
            }
            Event::Key(k) => println("key {} {} shift {} ctrl {} pressed {} text {} a {} left {}",
                k.win.n, logical(k.key), k.mods.shift(), k.mods.ctrl(), k.pressed, k.text_follows,
                k.code == KeyCode::KeyA, k.code == KeyCode::ArrowLeft),
            Event::Text(t) => println("text {} {}", t.len, t.bytes[0]),
            Event::Preedit(p) => println("preedit {}", p.len),
            Event::Resize(id, s) => println("resize {} {} {} {}", id.n, s.w, s.h, s.scale),
            Event::Mouse(m) => println("mouse {} {} {} {} shift {} clicks {}",
                if m.action == MouseAction::Press { "press" }
                else if m.action == MouseAction::Release { "release" } else { "move" },
                button(m.button), m.x, m.y, m.mods.shift(), m.clicks),
            Event::Scroll(s) => println("scroll {} {} {}", s.dx, s.dy, s.precise),
            Event::Cursor(_, on) => println("cursor {on}"),
            Event::Focus(_, on) => println("focus {on} {}", win.focused()),
            Event::Readable(fd) => println("readable {fd}"),
            Event::Close(id) => {
                println("close {}", id.n);
                win.close();
            }
            Event::Quit => {
                println("quit");
                break;
            }
        }
    }
    win.set_fullscreen(true);
    println("fullscreen {}", win.is_fullscreen());
    0
}
