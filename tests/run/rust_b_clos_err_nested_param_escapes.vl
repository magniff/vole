// EDITION: rust
// RULE: D20.3, D19.10
// (0.27.2) A nested closure's parameter stored into what the outer closure
// captured: the bound region is the inner call's (rustc E0521).
// ERROR: error[borrowck.outlives]
// ERROR-COUNT: 1
struct H<'a> {
    p: &'a i64,
}

fn main() {
    let a = 1;
    let mut h = H { p: &a };
    let mut outer = || {
        let mut inner = |p: &i64| {
            h.p = p;
        };
        let b = 2;
        inner(&b);
    };
    outer();
    println("{}", *h.p);
}
