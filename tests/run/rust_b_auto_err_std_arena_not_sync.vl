// RULE: AT2
// (0.27.2) An Arena allocates through `&self` with no lock: std says
// `impl<P: Allocator> !Sync for Arena<P> {}`, so `&Arena<Gpa>` is not Send
// (a thread allocates from its own arena); an Arena itself moves (Send).
// RUSTC: none std's Arena is not Rust's
use std::alloc::Arena;
fn send<T: Send>() {}

fn main() {
    send::<Arena<Gpa>>();
    send::<&Arena<Gpa>>();
}
// ERROR: error[sync.not_send]
