// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Range::is_empty.
// EXPECT: false true true
use std::ops::Range;

fn main() {
    let a: Range<i64> = 1..4;
    let b: Range<i64> = 3..3;
    let c: Range<i64> = 5..2;
    println("{} {} {}", a.is_empty(), b.is_empty(), c.is_empty());
}
