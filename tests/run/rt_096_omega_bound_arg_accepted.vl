trait Tr<U> { fn g(&self) -> i64; }
struct W { r: i64 }
impl Tr<i32> for W { fn g(&self) -> i64 { 32 } }
impl Tr<i64> for W { fn g(&self) -> i64 { 64 } }
fn call2<Z: Tr<i32>>(z: &Z) -> i64 { z.g() }

fn mid<U, T: Tr<U>>(t: &T, u: U) -> i64 { call2(t) }
fn main() { let x = W { r: 1 }; println("{}", mid(&x, 0i64)); }
