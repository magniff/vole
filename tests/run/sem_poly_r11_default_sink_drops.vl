// a default sink-self method calling let and inout methods, the value dropped once inside it
// FLAGS: --check-alloc
// EXPECT: drop 2
// EXPECT: 200
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

trait C {
    fn get(&self) -> i64;
    fn bump(&mut self);
    fn finish(mut self) -> i64 { self.bump(); self.get() * 100 }
}

impl C for R {
    fn get(&self) -> i64 { self.id }
    fn bump(&mut self) { self.id += 1; }
}

fn main() {
    let r = R { id: 1 };
    println("{}", r.finish());
    println("end");
}
