// RULE: D4.5
// (0.30.1) `T: 'static` met: by the parameter's own bound (in its list or
// a `where`), by a concrete type that lives so long (an i64, a String, a
// `&'static str`), and inside a type of them; the thread through a
// generic function whose F is 'static. rustc accepts each.
// EXPECT: 1 2 (3, 1)
// EXPECT: hi
// EXPECT: 5
use std::thread;
use std::thread::JoinHandle;

fn need<T: 'static>(t: T) -> T {
    t
}

fn ok1<T: 'static>(t: T) -> T {
    need(t)
}

fn ok2<T>(t: T) -> T where T: 'static {
    need(t)
}

fn ok3<T: Copy + 'static>(t: T) -> (T, i64) {
    need((t, 1))
}

fn start<F: FnOnce() -> usize + Send + 'static>(f: F, gpa: Gpa) -> JoinHandle<usize, Gpa> {
    thread::spawn_in(f, gpa)
}

fn main(gpa: Gpa) {
    println("{} {} {:?}", ok1(1), ok2(2), ok3(3));
    let s = need(String::from_in("hi", gpa));
    let r: &'static str = need("x");
    println("{s}");
    let h = start(move || r.len() + 4, gpa);
    println("{}", h.join().unwrap());
}
