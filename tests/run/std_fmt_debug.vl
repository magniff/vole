// Runs on std since 0.27.2's switch.
// The std item(s): std::fmt Debug.
// EXPECT: Pt { x: 1, y: 2 }
use std::fmt::{Debug, Display, Formatter};

struct Pt {
    x: i64,
    y: i64,
}

impl Display for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "({}, {})", self.x, self.y)
    }
}

impl Debug for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Pt").field("x", &self.x).field("y", &self.y).finish()
    }
}

fn main() {
    println("{:?}", Pt { x: 1, y: 2 });
}
