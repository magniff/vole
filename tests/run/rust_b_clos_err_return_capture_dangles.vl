// EDITION: rust
// RULE: D19.10, D20.3
// (0.27.2) `f()`'s result keeps the loan the closure's `&` capture holds:
// `v` dies while the result is still used (rustc E0597).
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 11, column 17
fn main() {
    let r;
    {
        let v = 5;
        let x = &v;
        let f = || x;
        r = f();
    }
    println("{}", *r);
}
