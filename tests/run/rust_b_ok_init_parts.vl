// RULE: M2, M8
// (0.30.1) What rustc accepts of a `let` with no value and its parts: a
// field assigned once the whole is (a branch each, before a loop, in a
// closure, a match, a reference, a nested field, a Copy struct copied
// first), a union's field assigned anew after the union moved, a moved
// field assigned again, a raw pointer and a reference assigned before
// they are read through, and `let _ = x;` of an x never assigned (a
// mention reads nothing).
// EXPECT: 5 14 7 8 9 8 10 6 6 2 9 2
struct P {
    a: i64,
    b: &'static i64,
}

impl P {
    fn get(&self) -> i64 {
        self.a + *self.b
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

struct Q {
    r: i64,
    s: i64,
}

struct O {
    q: Q,
    z: i64,
}

union U {
    x: i64,
    y: u32,
}

static THREE: i64 = 3;

fn whole() -> i64 {
    let mut p: P;
    p = P { a: 1, b: &THREE };
    p.a = 2;
    let q = p;
    q.a + *q.b
}

fn branch(c: bool) -> i64 {
    let mut p: P;
    if c {
        p = P { a: 1, b: &THREE };
    } else {
        p = P { a: 2, b: &THREE };
    }
    p.a += 10;
    p.get()
}

fn lp() -> i64 {
    let mut p: P;
    p = P { a: 0, b: &THREE };
    let mut i = 0;
    while i < 3 {
        p.a += i;
        i += 1;
    }
    let mut n: i64 = 0;
    let mut k = 0;
    while k < 2 {
        let t: (i64, i64);
        t = (k, k + 1);
        n += t.0 + t.1;
        k += 1;
    }
    p.a + n
}

fn cl() -> i64 {
    let mut p: P;
    p = P { a: 4, b: &THREE };
    p.a = 5;
    let f = || p.a + *p.b;
    f()
}

fn mt() -> i64 {
    let p: P;
    p = P { a: 6, b: &THREE };
    match p {
        P { a, b } => a + *b,
    }
}

fn rf() -> i64 {
    let mut p: P;
    p = P { a: 7, b: &THREE };
    p.a = 8;
    let r = &p;
    r.a
}

fn nested() -> i64 {
    let mut o: O;
    o = O { q: Q { r: 1, s: 2 }, z: 3 };
    o.q.r = 5;
    let q = o.q;
    q.r + q.s + o.z
}

fn cp() -> i64 {
    let mut c: C;
    c = C { a: 1, b: 2 };
    let d = c;
    c.a = 3;
    c.a + d.a + d.b
}

fn un() -> i64 {
    let mut u: U;
    u = U { x: 1 };
    u.x = 2;
    let v = u;
    u.x = 4;
    // UNSAFE: a union's field read, the case's subject
    // SAFETY: both unions were last written through x, an i64
    unsafe { u.x + v.x }
}

fn reinit(gpa: Gpa) -> usize {
    let mut t: (Vec<i64, Gpa>, i64);
    t = (Vec::new_in(gpa), 1);
    drop(t.0);
    t.0 = Vec::new_in(gpa);
    t.0.push(1);
    t.0.push(2);
    t.0.len()
}

fn ptr() -> i64 {
    let x: i64 = 9;
    let p: *const i64;
    p = &x;
    // UNSAFE: a raw pointer's read, the case's subject
    // SAFETY: p points to x, live and initialized, read only
    unsafe { *p }
}

fn deref() -> i64 {
    let mut v: i64 = 1;
    let r: &mut i64;
    r = &mut v;
    *r = 2;
    v
}

fn mention() {
    let x: i64;
    let _ = x;
}

fn main(gpa: Gpa) {
    mention();
    println("{} {} {} {} {} {} {} {} {} {} {} {}", whole(), branch(true), lp(), cl(), mt(), rf(),
        nested(), cp(), un(), reinit(gpa), ptr(), deref());
}
