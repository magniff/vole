// spawn_in wants `F: 'static`. `go` moves an `x: T` (T: Send, no
// 'static) into the thread's closure; rustc refuses it in go's body
// (E0310, the parameter type `T` may not live long enough). vole
// accepts it, and main passes a reference to a Box it frees before the
// thread reads it: `--check-alloc` says "use after free".
// ERROR: error[borrowck.param_outlives]
// ERROR: line 25, column 5
use std::thread;
use std::sync::atomic::{AtomicBool, Ordering};
use std::thread::JoinHandle;

static FREED: AtomicBool = AtomicBool::new(false);

trait Get {
    fn get(&self) -> i64;
}

impl<'a> Get for &'a i64 {
    fn get(&self) -> i64 {
        **self
    }
}

fn go<T: Send + Get>(x: T, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    thread::spawn_in(move || {
        while !FREED.load(Ordering::SeqCst) {
            thread::yield_now();
        }
        x.get()
    }, gpa)
}

fn main(gpa: Gpa) {
    let h = {
        let b = Box::new_in(1234i64, gpa);
        go(&*b, gpa)
    };
    let other = Box::new_in(-1i64, gpa);
    FREED.store(true, Ordering::SeqCst);
    println("{} {}", h.join().unwrap(), *other);
}
