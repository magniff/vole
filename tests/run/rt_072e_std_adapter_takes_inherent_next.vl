// XFAIL: RT-72: std's Map instance calls the item type's inherent `next` by name, not Iterator's (0.30.2)
// EXPECT: 2
struct C {
    n: i64,
}

impl C {
    fn next(&mut self) -> i64 {
        5
    }
}

impl Iterator for C {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n == 0 {
            None
        } else {
            self.n -= 1;
            Some(self.n)
        }
    }
}

fn main() {
    let c = C { n: 2 };
    println("{}", c.map(|x| x + 1).count());
}
