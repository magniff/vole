// RUSTC: none an effect declaration's error: the twin compares the borrow checker's verdicts
// RULE: E4.3a
// (0.28.0, gap 87) A print is io with or without a hole, a format_in
// allocates from its allocator, and a write into a sink does what the
// sink's write_str does: a Formatter's sink is its maker's effect. A
// call through a value of the sink's fn type outside Formatter may reach
// every sink of the program (the join).
// ERROR: 'a' is #[no_io], but it does io
// ERROR: 'b' is #[no_io], but it does io
// ERROR: 'c' is #[pure], but it does io
// ERROR: 'd' is #[no_io], but it does io
// ERROR: 'e' is #[no_io], but it does io
// ERROR: 'made' is #[no_alloc], but it allocates from Gpa
// ERROR: 'through' is #[no_io], but it does io
// ERROR: 'any' is #[no_io], but it does io
// ERROR-COUNT: 8
use std::fmt::{Result, Write};

#[no_io]
fn a(x: i64) -> i64 {
    println("{x}");
    x
}

#[no_io]
fn b(x: i64) -> i64 {
    println("counting");
    x
}

#[pure]
fn c(x: i64) -> i64 {
    println("counting");
    x
}

#[no_io]
fn d(x: i64) -> i64 {
    print("counting");
    x
}

#[no_io]
fn e(x: i64) -> i64 {
    eprintln("counting {}", 1);
    x
}

#[no_alloc]
fn made(x: i64, gpa: Gpa) -> usize {
    format_in("{}", x, gpa).len()
}

// A sink that prints.
struct Loud {}

impl Write for Loud {
    fn write_str(&mut self, s: &str) -> Result {
        println("{}", s);
        Ok(())
    }
}

#[no_io]
fn through(l: &mut Loud) {
    let _ = write(l, "x");
}

// A function of the type of Formatter's write field.
fn quiet(p: *mut u8, s: &str) -> Result {
    Ok(())
}

#[no_io]
fn any(w: fn(*mut u8, &str) -> Result, p: *mut u8) {
    let _ = w(p, "x");
}

fn main(gpa: Gpa) {
    any(quiet, std::ptr::null_mut::<u8>());
    let mut l = Loud {};
    through(&mut l);
    println("{}", a(1) + b(1) + c(1) + d(1) + e(1) + made(1, gpa) as i64);
}
