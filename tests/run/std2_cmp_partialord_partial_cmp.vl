// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::cmp PartialOrd::partial_cmp.
// EXPECT: Some(Less) Some(Equal) Some(Greater)
use std::cmp::Ordering;

#[derive(Debug, Clone, Copy)]
struct P {
    x: i64,
}

impl PartialEq for P {
    fn eq(&self, other: &P) -> bool {
        self.x == other.x
    }
}

impl Eq for P {}

impl PartialOrd for P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for P {
    fn cmp(&self, other: &P) -> Ordering {
        self.x.cmp(&other.x)
    }
}

fn main() {
    let a = P { x: 2 };
    println("{:?} {:?} {:?}", a.partial_cmp(&P { x: 3 }), a.partial_cmp(&P { x: 2 }),
        a.partial_cmp(&P { x: 1 }));
}
