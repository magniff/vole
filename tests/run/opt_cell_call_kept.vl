// (0.26.1) A call that only sets a cell through a let parameter has
// effects (interior: memory), so -O2 keeps it, and the load after it.
// CHECK: fn main
// CHECK: call bump
// CHECK: call bump
// EXPECT: 3
use std::cell::Cell;

#[inline(never)]
fn bump(c: Cell<i64>) {
    c.set(c.get() + 1);
}

fn main() {
    let c = Cell::new(1);
    bump(c);
    bump(c);
    println("{}", c.get());
}
