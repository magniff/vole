// RULE: F2.3
// A generic impl's bound that names no trait in scope (`Hash` without its
// `use`) is reported, rustc E0405; the supertrait obligations of the
// derived impls (`Ord` over `PartialOrd`) skip it (0.27.3: they read the
// bound's trait, -1, and crashed: front/traits.vl:220).
// ERROR: error[type error]: 'Hash' is not a trait in scope
#[derive(PartialEq, Eq, PartialOrd, Ord)]
struct Keyed<K: Hash + Eq> {
    k: K,
    n: i64,
}

fn main() {
    let a = Keyed { k: 1, n: 2 };
    println("{}", a.n);
}
