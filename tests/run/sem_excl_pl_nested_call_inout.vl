// EDITION: rust
// nested calls each taking inout of the same var: sequential, fine
// EXPECT: 4 3
fn bump(n: &mut i64) -> i64 { *n += 1; *n }
fn add(a: i64, b: i64) -> i64 { a + b }

fn main() {
    let mut x: i64 = 1; let r = add(bump(&mut x), 0) + 0; let s = bump(&mut x);
    println("{} {x}", r + s - 1);
}
