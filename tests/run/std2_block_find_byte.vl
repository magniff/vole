// (0.29) [u8]::find_byte, the bytes' block search (C's memchr), and what
// searches with it: [u8]::contains (and i8's, bool's), str::find, split,
// split_once, lines and contains with a pattern of one byte or more.
// The std2 item(s): std::slice [u8]::find_byte, [T]::contains.
// RUSTC: none (find_byte is vole's: Rust has it in the memchr crate)
// EXPECT: empty None
// EXPECT: first Some(0) last Some(8) absent None
// EXPECT: zero Some(3) high Some(5) after Some(2)
// EXPECT: odd Some(4) None
// EXPECT: long Some(123456) None
// EXPECT: every true
// EXPECT: contains true false true false true false
// EXPECT: find Some(4) Some(0) None Some(7) None
// EXPECT: words Some(6) Some(4) None Some(9) Some(0)
// EXPECT: rfind Some(10) Some(8)
// EXPECT: split ["a", "bb", "", "ccc", ""]
// EXPECT: split2 ["one", "two", "three::"]
// EXPECT: once Some(("key", "value=x")) None
// EXPECT: lines ["first", "second", "", "last"]
// EXPECT: greek Some(2) Some(7) Some(9)
// EXPECT: count 10000 9999
use std::string::String;
use std::vec::Vec;

fn main(gpa: Gpa) {
    let e: [u8; 0] = [];
    println("empty {:?}", e.find_byte(0));
    let a = b"abcdefgha";
    println("first {:?} last {:?} absent {:?}", a.find_byte(b'a'), a[1..].find_byte(b'a').map(|i|
        i + 1), a.find_byte(b'z'));
    let z = [1u8, 2, 3, 0, 4, 255, 0, 7];
    println("zero {:?} high {:?} after {:?}", z.find_byte(0), z.find_byte(255),
        z[4..].find_byte(0));
    println("odd {:?} {:?}", z[1..].find_byte(255), z[1..5].find_byte(255));

    let mut big: Vec<u8, Gpa> = Vec::new_in(gpa);
    big.resize(200000, b'x');
    big[123456] = b'\n';
    println("long {:?} {:?}", big.find_byte(b'\n'), big[123457..].find_byte(b'\n'));

    // Every start and length of a 40-byte slice, against the loop.
    let mut t = [0u8; 40];
    for i in 0..40 {
        t[i] = (i * 7 % 11) as u8;
    }
    let mut ok = true;
    for from in 0..40usize {
        for to in from..41usize {
            for x in 0..12u8 {
                let s = &t[from..to];
                let mut want: Option<usize> = None;
                for i in 0..s.len() {
                    if s[i] == x {
                        want = Some(i);
                        break;
                    }
                }
                ok = ok && s.find_byte(x) == want;
            }
        }
    }
    println("every {}", ok);

    let i = [-1i8, 5, -128];
    let (b3, b2) = ([false, false, true], [false, false]);
    println("contains {} {} {} {} {} {}", a.contains(&b'h'), a.contains(&b'z'), i.contains(&-128),
        i.contains(&127), b3.contains(&true), b2.contains(&true));

    let s = "the quick brown fox";
    println("find {:?} {:?} {:?} {:?} {:?}", s.find('q'), s.find('t'), s.find('z'), s.find("ck"),
        s.find("cz"));
    println("words {:?} {:?} {:?} {:?} {:?}", "aaaaaaab".find("ab"), "xaabaaab".find("aaab"),
        "ab".find("abc"), "xxxxxxxxxabc".find("abc"), "abc".find(""));
    println("rfind {:?} {:?}", "a,b,c,d,e,f".rfind('f'), "a,b,c,d,e,f".rfind("e,"));
    let parts: Vec<&str, Gpa> = "a,bb,,ccc,".split(',').collect_in(gpa);
    println("split {:?}", parts);
    let parts2: Vec<&str, Gpa> = "one::two::three::".splitn(3, "::").collect_in(gpa);
    println("split2 {:?}", parts2);
    println("once {:?} {:?}", "key=value=x".split_once('='), "key".split_once('='));
    let lines: Vec<&str, Gpa> = "first\nsecond\r\n\nlast".lines().collect_in(gpa);
    println("lines {:?}", lines);
    let g = "αβγ δ αβγ λ";
    println("greek {:?} {:?} {:?}", g.find('β'), g.find("δ α"), g.find(" αβγ λ"));

    let mut text = String::new_in(gpa);
    for i in 0..10000 {
        text.push_str("line ");
        text.push_str(if i % 2 == 0 { "even" } else { "odd" });
        text.push('\n');
    }
    println("count {} {}", text.lines().count(), text.trim_end().matches('\n').count());
}
