// RULE: F34.4 (0.30.2) The loops of a constant's value are its own: a
// `continue`, a `break` and a `break 'o` to them leave nothing, made at
// each use inside the using function's loops, whose labels the value
// does not see. The output is rustc's.
// EXPECT: 21
struct D {
    k: i64,
}

const A: D = {
    let mut s: i64 = 0;
    'o: loop {
        while s < 10 {
            s += 1;
            if s == 2 {
                continue;
            }
            if s == 5 {
                break 'o;
            }
        }
        break;
    }
    loop {
        if s > 6 {
            break;
        }
        s += 1;
    }
    D { k: s }
};

fn main() {
    let mut v: i64 = 0;
    'p: loop {
        let d = A;
        v += d.k;
        while v < 100 {
            let e = A;
            v += e.k;
            if v > 20 {
                break 'p;
            }
        }
    }
    println("{}", v);
}
