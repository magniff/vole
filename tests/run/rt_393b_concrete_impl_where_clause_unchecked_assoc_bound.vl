// RT-393, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig-m2 (form f269aj). Since v0.30.1 at least;
// the release build the same. rustc E0277 at the impl's where clause and
// at the call (the rustc twin of this file). Siblings: rt_393, rt_393c,
// rt_393d.
// ERROR: line 24
// ERROR: line 33
trait Conv {
    fn c(&self) -> i64;
}

trait Tr {
    type Out;
}

struct W {
    r: i64,
}

struct Bx<T> {
    t: T,
}

impl Tr for W where Bx<i64>: Conv {
    type Out = i64;
}

fn need<X: Tr<Out = i64>>(x: &X) -> i64 {
    5
}

fn main() {
    println("{}", need(&W { r: 0 }));
}
