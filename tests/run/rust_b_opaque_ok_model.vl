// RULE: D22.1, D22.1a, FL11
// (0.27.3) The opaque instance models what rustc's type check of a template
// sees, so that no error is reported where rustc has none: an operator on
// an Ω through its bound (`Add`, `PartialOrd`, `Neg`, `Shl` with its
// default `Rhs = Self`), `T::default()` and `A::N` of a bound's trait, a
// bound's type arguments (`AsRef<str>`), `*d` with `Deref`, `g[i]` with
// `Index`. None of these templates is called.
// EXPECT: ok
use std::ops::{Add, Deref, Index, Neg, Shl};

trait Counted {
    const N: i64;
}

fn twice<T: Add<Output = T> + Copy>(x: T) -> T {
    x + x
}

fn less<T: PartialOrd>(a: T, b: T) -> bool {
    a < b
}

fn neg<T: Neg<Output = T>>(a: T) -> T {
    -a
}

fn shifted<T: Shl<Output = T>>(a: T, b: T) -> T {
    a << b
}

fn zero<T: Default>() -> T {
    T::default()
}

fn count<C: Counted>() -> i64 {
    C::N + 1
}

fn len_of<S: AsRef<str>>(s: S) -> usize {
    s.as_ref().len()
}

fn read<D: Deref<Target = i64>>(d: D) -> i64 {
    *d + 1
}

fn at<G: Index<usize, Output = i64>>(g: &G, i: usize) -> i64 {
    g[i] * 2
}

fn main() {
    println("ok");
}
