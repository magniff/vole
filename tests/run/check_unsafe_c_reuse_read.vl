// FLAGS: --check-unsafe
// EXPECT: 707
// 0.30.1: memory the check did not see allocated is never reported as
// freed. A Box of Gpa is dropped, then C's strdup, whose own malloc (not
// the check's) would get the same 8 bytes back, and its copy is read and
// freed. The check holds a freed block back from C's allocator while it
// counts it as freed (a quarantine), so strdup gets other memory. Before
// the hold, this stopped with `unsafe access after free` (the review of
// 0.30.1).
extern "C" {
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
}

fn main(gpa: Gpa) {
    let b = Box::new_in([7u8; 8], gpa);
    let mut s = b[0] as i64;
    drop(b);
    // UNSAFE: C's strdup and free; reads within the copy's 8 bytes (7 and the NUL).
    // SAFETY: strdup's result is a NUL-terminated copy, freed once by free.
    unsafe {
        let p = strdup(c"abcdefg" as *const u8);
        for i in 0..7 {
            s += *p.add(i) as i64;
        }
        free(p);
    }
    println("{s}");
}
