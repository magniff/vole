// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::clone Clone::clone.
// EXPECT: [1, 2] [1, 2, 3]
use std::clone::Clone;
use std::marker::Copy;
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut a = Vec::new_in(gpa);
    a.push(1i64);
    a.push(2);
    let mut b = a.clone();
    b.push(3);
    println("{:?} {:?}", a, b);
}
