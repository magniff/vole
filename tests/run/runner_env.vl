// (0.25.4) ENV: the program runs with the case's variables in its
// environment, spaces and semicolons kept, @ROOT@ the root.
// ENV: VOLE_RUNNER_ENV=a b; c
// ENV: VOLE_RUNNER_ROOT=@ROOT@/tests/run
// EXPECT: a b; c
// EXPECT: root ok

use std::{env, fs};

fn main(gpa: Gpa) -> i32 {
    match env::get_in("VOLE_RUNNER_ENV", gpa) {
        Ok(v) => println(v.as_str()),
        Err(_) => println("VOLE_RUNNER_ENV is not set"),
    }
    let root = env::get_in("VOLE_RUNNER_ROOT", gpa).unwrap_or(String::new_in(gpa));
    var path = String::new_in(gpa);
    path.push_str(root.as_str());
    path.push_str("/runner_env.vl");
    println(if fs::read_in(path.as_str(), gpa).is_ok() { "root ok" } else { "root not found" });
    0
}
