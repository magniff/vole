// (0.25, the semantics fuzzer) Assigning an owned element, `w[i] = x`,
// or `w.set(i, x)` (which writes `self.as_mut_slice()[i] = x`), does not
// drop the old element: it leaks. A field assignment, `s.a = x`, drops
// the old value first, as the design says every owned place does.
// EXPECT: d1
// EXPECT: assigned
// EXPECT: d2
// EXPECT: set
// EXPECT: d5
// EXPECT: field
// EXPECT: d6
// EXPECT: d3
// EXPECT: d4
// EXPECT: live 0

static mut NEXT: i64 = 0;
static mut LIVE: i64 = 0;
struct T { id: i64 }
fn mk() -> T { unsafe { NEXT += 1; } unsafe { LIVE += 1; } T { id: unsafe { NEXT } } }

impl Drop for T {
    fn drop(&mut self) { unsafe { LIVE -= 1; } println("d{}", self.id); }
}

struct S { a: T }

fn run(gpa: Gpa) {
    let mut w: Vec<T, Gpa> = Vec::new_in(gpa);
    w.push(mk());
    w.push(mk());
    w[0] = mk();
    println("assigned");
    w[1usize] = mk();
    println("set");
    let mut s = S { a: mk() };
    s.a = mk();
    println("field");
}

fn main(gpa: Gpa) -> i32 {
    run(gpa);
    let live_now = unsafe { LIVE }; println("live {live_now}");
    0
}
