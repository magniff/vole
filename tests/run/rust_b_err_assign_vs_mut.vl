// RULE: D2.5
// (0.27.1) An assignment to `x` while `&mut x` is live: (WA, M).
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 11, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let m = &mut x;
    x = 2;
    *m += 1;
    println("{}", x);
}
