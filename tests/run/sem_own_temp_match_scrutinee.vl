// sem-own: an owned temporary matched by value, the payload bound: the bound part dropped at the arm end, nothing else left.
// EXPECT: in 5
// EXPECT: drop 5
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
enum E<A: Allocator> { A(D<A>), N }
fn me(gpa: Gpa) -> E<Gpa> { E::A(mk(5, gpa)) }

fn main(gpa: Gpa) {
    match me(gpa) { E::A(d) => println("in {}", d.id), E::N => {} }
    println("end");
}
