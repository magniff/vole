// XFAIL: RT-156: a for loop (and std's adapters) call the iterator's inherent `next`, not Iterator::next (0.30.2)
// rustc --edition 2024 prints 3, 3, 1 (twin: r302d_004_for_calls_inherent_next.rs.txt).
// vole prints 300, 300, 1 at -O0 and -O2: `for x in C { n: 3 }` calls C's
// inherent next (yielding 100 three times), and so does std's map/sum
// (RT-72's mechanism inside std). RT-77's case is the for loop's into_iter;
// the loop's next is a second call built by name (front/check/iterate.vl).
// With a user trait `Step { fn next(&mut self) -> Option<i64>; }` for C in
// place of the inherent method the loop is refused: method.ambiguous, its
// try: lines the whole for loop pasted as an argument
// (`try: Iterator::next(&for x in (C { n: 3 }) {`). Since v0.28.0.
// EXPECT: 3
// EXPECT: 3
// EXPECT: 1
struct C {
    n: i64,
}

impl Iterator for C {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n > 0 {
            self.n -= 1;
            Some(self.n)
        } else {
            None
        }
    }
}

impl C {
    fn next(&mut self) -> Option<i64> {
        if self.n > 0 {
            self.n -= 1;
            Some(100)
        } else {
            None
        }
    }
}

fn main() {
    let mut t = 0;
    for x in (C { n: 3 }) {
        t += x;
    }
    println("{}", t);
    let s: i64 = (C { n: 3 }).map(|x| x).sum();
    println("{}", s);
    let mut w = 0;
    let mut c = C { n: 2 };
    while let Some(x) = Iterator::next(&mut c) {
        w += x;
    }
    println("{}", w);
}
