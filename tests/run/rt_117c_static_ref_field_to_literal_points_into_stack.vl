// XFAIL: RT-117c: UNSOUND: (RT-117's family, no promotion) `struct V { a: &'static u64 }` built as `V { a: &7 }` and returned is accepted, but `&7` is not promoted: the `&'static u64` points into the stack (about 1 KB from a local), where rustc's points into the binary's static data next to a `static`; rustc prints the EXPECT lines (0.30.2)
// From the g302static work (its pre/pre07). Since v0.30.1 at least (the
// same: the value reads 7 by luck, the address is a stack address). The
// g302static branch refuses it (borrowck.dropped_borrowed) as `fn f() ->
// &'static u64 { &7 }` is (RT-117b); rustc promotes the literal. The
// second line checks that the reference is within 256 MB of a static.
// The const form is rt_117d.
// EXPECT: 7
// EXPECT: true
struct V {
    a: &'static u64,
}

static G: u64 = 5;

fn mk() -> V {
    V { a: &7 }
}

fn main() {
    let v = mk();
    let pv = v.a as *const u64 as usize as i64;
    let ps = &G as *const u64 as usize as i64;
    println("{}", v.a);
    println("{}", (pv - ps).abs() < (1i64 << 28));
}
