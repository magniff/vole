// XFAIL: RT-298: an iterator adapter given a fn item or fn pointer instead of a closure fails inside std: `v.iter().map(dbl).sum()`, `.map(idr2).count()`, `.filter_map(some).count()`, `.copied().map(i64::abs).count()` give "the type '&mut fn(&i64) -> i64' does not satisfy the bound 'F: FnOnce(&i64) -> i64' of 'Option::map'" (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). Map::next passes `&mut
// self.f` on; `&mut F` meets an Fn bound when F is a closure (the same
// calls with `|x| dbl(x)` build) but not when F is a fn pointer type
// (Rust: `impl<F: FnMut> FnMut for &mut F` holds for both). collect_in
// over the same Map builds (it calls f directly).
// EXPECT: 12 3 3 [2, 4, 6] 3
fn dbl(x: &i64) -> i64 {
    *x * 2
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn some(x: &i64) -> Option<i64> {
    Some(*x)
}

fn main(gpa: Gpa) {
    let v = [1i64, 2, 3];
    let a: i64 = v.iter().map(dbl).sum();
    let b = v.iter().map(idr2).count();
    let c = v.iter().filter_map(some).count();
    let d: Vec<i64, Gpa> = v.iter().map(dbl).collect_in(gpa);
    let e = v.iter().copied().map(i64::abs).count();
    println("{} {} {} {:?} {}", a, b, c, d, e);
}
