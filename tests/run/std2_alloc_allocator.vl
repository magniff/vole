// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Allocator.
// EXPECT: 16
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn bytes<A: Allocator>(a: &A) -> usize {
    let l = Layout::array::<u64>(2).unwrap();
    let p = a.allocate(l).unwrap();
    // UNSAFE: the block goes back.
    // SAFETY: p came from a with layout l.
    unsafe { a.deallocate(p, l) };
    l.size()
}

fn main(gpa: Gpa) {
    println("{}", bytes(&gpa));
}
