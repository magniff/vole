// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe access out of bounds: 17 bytes at offset 0 of a block of 16 bytes
// STDERR: --> memset, its destination
// 0.30.1: the program's own call of C's memset is checked first under
// --check-unsafe, as std's copies are: 17 bytes into a block of 16.
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn memset(p: *mut u8, c: i32, n: usize) -> *mut u8;
}

fn main() {
    // UNSAFE: deliberately one byte past the block.
    // SAFETY: none: the program exists to be stopped.
    unsafe {
        let p = malloc(16);
        memset(p, 65, 17);
        println("read {}", *p.add(15));
    }
}
