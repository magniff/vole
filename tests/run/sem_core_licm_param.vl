// EDITION: rust
// A guarded index of an array parameter, in a function.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

#[inline(never)]
fn f(a: [i64; 3], i: i64, n: i64) -> i64 {
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k < n { if k > 100 { t += a[i as usize]; } k += 1; }
    t
}

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let a = [1i64, 2, 3];
    println("{}", f(a, i, 5 + unsafe { Z }));
    0
}
