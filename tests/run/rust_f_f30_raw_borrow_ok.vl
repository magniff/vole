// EDITION: rust
// RULE: F30.2, D6.2.5
// `&raw const P` and `&raw mut P` take a place's address, a raw pointer, no
// reference: of a `static mut` (the bare static needs no unsafe, a field of
// it does), of a `mut` local; written and read through in `unsafe`. `raw`
// stays an identifier elsewhere.
// EXPECT: 2 2 6 3
struct V2 {
    n: i64,
}

static mut V: V2 = V2 { n: 1 };

fn main() {
    let p: *mut V2 = &raw mut V;
    let q: *const i64 = unsafe { &raw const V.n };
    let mut s = 5;
    let r = &raw const s;
    let w = &raw mut s;
    let raw = 3;
    let t = &raw;
    unsafe {
        (*p).n += 1;
        *w += 1;
        println("{} {} {} {}", *q, (*p).n, *r, *t);
    }
}
