// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops Sub::sub.
// EXPECT: V { x: 7 } 7
use std::ops::Sub;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Sub for V {
    type Output = V;

    fn sub(self, rhs: V) -> V {
        V { x: self.x - rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.sub(b), Sub::sub(12i64, 5));
}
