// EDITION: rust
// (0.27.0) Hand-translated from tests/run/closure_capture_iter_ok.vl to Rust's spelling.
// ok: closures over captures, through std's iterators
// EXPECT: 10 ccc 3 0
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i);
    }
    let mut total = 0;
    v.iter().for_each(|x| total += x);
    let words: &str = "a bb ccc";
    let mut longest: &str = "";
    for w in words.split_ascii_whitespace() {
        if w.len() > longest.len() {
            longest = w;
        }
    }
    let lens = (0..3).map(|i| v[i] * 2).collect_in(gpa);
    let s = v.as_slice();
    let first = (0..1).map(|i| s[i]).collect_in(gpa);
    println("{total} {longest} {} {}", lens.len(), first[0]);
}
// XFAIL: Vec::iter through Deref<Target=[T]> (front272 F20)
