// XFAIL: RT-335: mutually recursive fns using each other's `impl Iterator` values (`b(n - 1).sum()`, `&mut a(n - 1)`) are refused as opaque.cycle; rustc accepts (0.30.2)
// Since v0.30.1 at least. From the review of the opaque-type work.
// EXPECT: b sees None
// EXPECT: a sees 0
// EXPECT: b sees Some(1)
// EXPECT: a sees 2
// EXPECT: 10
fn a(n: i64) -> impl Iterator<Item = i64> {
    if n > 0 {
        let s: i64 = b(n - 1).sum();
        println("a sees {}", s);
    }
    (0..n).map(|x| x + 1)
}

fn b(n: i64) -> impl Iterator<Item = i64> {
    if n > 0 {
        let mut it = a(n - 1);
        let r = &mut it;
        println("b sees {:?}", r.next());
    }
    (0..n).filter(|x| x % 2 == 0)
}

fn main() {
    let s: i64 = a(4).sum();
    println("{}", s);
}
