// rustc prints the EXPECT lines (twin: r302d_026_blanket_impl_over_fn_skips_opaque.rs.txt).
// vole: `no method 'apply_twice' on type 'impl Fn(i64) -> i64' | help: an `impl
// Trait` result has its bounds' methods only` (line 23) and `the trait 'Apply' is
// not implemented for 'impl Fn(i64) -> i64'` (line 24). A closure value gets the
// impl (`c.apply_twice(1)`), and the same blanket form over `I: Iterator` or
// `T: Debug` covers an `impl Iterator`/`impl Debug` value (bl/x1.vl): only the
// Fn bound of an opaque value is not matched against a blanket impl's F: Fn.
// Since v0.28.0.
// EXPECT: 9
// EXPECT: 12
// EXPECT: 5
trait Apply {
    fn apply_twice(&self, x: i64) -> i64;
}

impl<F: Fn(i64) -> i64> Apply for F {
    fn apply_twice(&self, x: i64) -> i64 {
        self(self(x))
    }
}

fn mk(k: i64) -> impl Fn(i64) -> i64 {
    move |x| x * k
}

fn use_apply<A: Apply>(a: &A) -> i64 {
    a.apply_twice(5)
}

fn main() {
    let k = 3;
    let c = move |x: i64| x * k;
    println("{}", c.apply_twice(1));
    println("{}", mk(2).apply_twice(3));
    println("{}", use_apply(&mk(1)));
}
