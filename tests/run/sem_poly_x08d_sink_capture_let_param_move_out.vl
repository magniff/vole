// EDITION: rust
// a sink closure capturing a let parameter moves it out: the caller's Vec would be freed twice
// ERROR: error[type error]
// ERROR: line 8, column 25
fn eat(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }

fn f(v: &Vec<i64, Gpa>) -> i64 {
    let c = move || eat(v);
    c()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{} {}", f(&v), v.len());
}
