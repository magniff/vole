// EDITION: rust
// RULE: F30.3
// The Rust spellings of a raw pointer's elements: `*p.add(i)` and
// `slice::from_raw_parts(p, n)`.
// EXPECT: 2 6
// XFAIL: slice::from_raw_parts meets borrowck.return_local until a raw slice makes no loan (clos272)
fn main() {
    let b = [1u8, 2, 3];
    let p = &b[0] as *const u8;
    // UNSAFE: p points into b.
    // SAFETY: b has 3 elements and lives to the end of main.
    let second = unsafe { *p.add(1) };
    // UNSAFE: the 3 bytes of b, as a slice.
    // SAFETY: as above.
    let s: &[u8] = unsafe { std::slice::from_raw_parts(p, 3) };
    let mut sum: u8 = 0;
    let mut i: usize = 0;
    while i < s.len() {
        sum += s[i];
        i += 1;
    }
    println("{} {}", second, sum);
}
