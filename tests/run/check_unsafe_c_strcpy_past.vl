// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe access out of bounds (just past the end): 1 bytes at offset 16 of a block of 16 bytes
// STDERR: note: the 16 bytes after the block, which no one is given, were written over before
// 0.30.1: the off-by-one: C's strcpy of 16 characters into malloc(16)
// writes its NUL at p[16] (C's write, unchecked, over the red zone); the
// program then reads p[16], past the end, which is reported, with a note
// that the red zone was written over. (Earlier on 0.30.1's branch a red
// zone written over made the check forget the block, as one C had freed
// and given out again: this read, and every later bug of the block, ran.)
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn strcpy(d: *mut u8, s: *const u8) -> *mut u8;
}

fn main() {
    // UNSAFE: deliberately past the end.
    // SAFETY: none: the program exists to be stopped.
    unsafe {
        let p = malloc(16);
        strcpy(p, c"0123456789abcdef" as *const u8);
        println("read {}", *p.add(16));
    }
}
