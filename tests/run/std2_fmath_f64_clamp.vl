// EDITION: rust
// The std2 item(s): std::fmath f64::clamp.
// EXPECT: 3 0 1.5 true
// EXIT: 101
fn main() {
    println("{} {} {} {}", 5.0f64.clamp(0.0, 3.0), (-1.0f64).clamp(0.0, 3.0),
        1.5f64.clamp(0.0, 3.0), f64::NAN.clamp(0.0, 1.0).is_nan());
    // (min > max panics, as Rust's)
    println("{}", 1.0f64.clamp(2.0, 1.0));
}
