// XFAIL: RT-361: under `X: A` with `trait A where Self: B`, a call to B's function is refused ("no function 'b' in the bounds of 'X'"); rustc prints 6 (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 6
trait A
    where
        Self: B,
{
    fn a(&self) -> i64;
}

trait B {
    fn b(&self) -> i64;
}

struct S;

impl B for S {
    fn b(&self) -> i64 {
        2
    }
}

impl A for S {
    fn a(&self) -> i64 {
        1
    }
}

fn k<X: A>(x: &X) -> i64 {
    x.b() + X::b(x) + B::b(x)
}

fn main() {
    println("{}", k(&S));
}
