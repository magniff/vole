#[derive(Clone, Copy)] // a plain let struct captured: an inout method on it inside the closure; is p changed? (p is let)
// ERROR: borrowck.borrow_immutable
struct P { x: i64 }
impl P { fn bump(&mut self) { self.x += 1; } }

fn main() {
    let p = P { x: 1 };
    let c = || { p.bump(); 0 };
    let r = c();
    println("{}", p.x);
}
