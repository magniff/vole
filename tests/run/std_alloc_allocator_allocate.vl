// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc Allocator::allocate.
// EXPECT: 42
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let l = Layout::new::<i64>();
    let p = gpa.allocate(l).unwrap().as_ptr() as *mut i64;
    // UNSAFE: the block is written, read and given back.
    // SAFETY: p is a fresh block for one i64.
    unsafe {
        *p.add(0) = 42;
        println("{}", *p.add(0));
        gpa.deallocate(std::ptr::NonNull::new(p as *mut u8).unwrap(), l);
    }
}
