// XFAIL: RT-482c: (RT-482, an FnMut forwarded) `kmut(st, gpa)`, where `kmut<K, F: FnMut(&i64) -> K>(mut f: F, ..)` calls f and then passes it on to `kmut2(f, gpa)`, which returns `f(&l[0])` of a local, is refused in kmut2's body (borrowck.return_local); rustc prints 5 (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// EXPECT: 5
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn kl<K, F: Fn(&i64) -> K>(f: F, gpa: Gpa) -> K {
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn kmut<K, F: FnMut(&i64) -> K>(mut f: F, gpa: Gpa) -> K {
    let l = 9i64;
    let _ = f(&l);
    kmut2(f, gpa)
}

fn kmut2<K, F: FnMut(&i64) -> K>(mut f: F, gpa: Gpa) -> K {
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn main(gpa: Gpa) {
    let r = kmut(st, gpa);
    println("{}", r);
}
