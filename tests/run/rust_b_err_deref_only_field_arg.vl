// RULE: D2.7
// (0.30.1) A `&mut` stored behind a type that is only Deref is behind a
// shared reference: reborrowing it is rustc's E0596 (cannot borrow data in
// dereference of `G` as mutable), with g declared `mut` or not.
// ERROR: error[borrowck.borrow_immutable]
// ERROR-COUNT: 1
use std::ops::Deref;

struct W<'a> {
    s: &'a mut [i64],
}

struct G<'b, 'a> {
    r: &'b W<'a>,
}

impl<'b, 'a> Deref for G<'b, 'a> {
    type Target = W<'a>;

    fn deref(&self) -> &W<'a> {
        self.r
    }
}

fn fill(t: &mut [i64]) {
    t[0] = 9;
}

fn main() {
    let mut a2 = [1i64, 2];
    let w = W { s: &mut a2 };
    let g = G { r: &w };
    fill(g.s);
}
