// EDITION: rust
// A slice of v alive across a call of a closure that pushes to v: the
// closure's capture of v is not seen as a change of v, so the view is
// read after the Vec reallocated (--check-alloc: use after free; -O0,
// -O1 and -O2 print different garbage). Expected own.conflict.
// ERROR: error[borrowck.conflict]
// ERROR: line 12, column 20
fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    let mut grow = || { for k in 0..100 { v.push(k); } };
    grow();
    println("{}", s[0]);
    0
}
