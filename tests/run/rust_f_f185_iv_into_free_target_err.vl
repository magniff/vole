// RULE: F18.5
// (0.30.2) `a.into()` with nothing at the call saying what it converts
// to, its result later i32 and a later i64: `i64: Into<i32>` does not
// hold, rustc's E0277 (an earlier 0.30.2 build called the blanket impl's
// i32 instance and printed 705032704).
// ERROR: the trait 'From<i64>' is not implemented for 'i32' (rustc E0277)
fn main() {
    let a = 5000000000;
    let r = a.into();
    let s: i32 = r;
    let c: i64 = a;
    println("{} {}", s, c);
}
