// RULE: F34.4 (0.30.2) An exit of a used constant's value with no loop
// anywhere, and one used inside a loop of the using function: refused
// where the value is written (const.exit), and the use gives the exit no
// target (find_loop 0: no loop of the using function takes the `break`,
// check_break). 70761e43f crashed on the first (find_loop indexed an empty
// loop stack once the use site said nothing). rustc E0268, E0572.
// ERROR: line 19
// ERROR: line 21
// ERROR: line 23
// ERROR-COUNT: 3
struct D {
    k: i64,
}

fn yes() -> bool {
    true
}

const C: D = { if yes() { break; } D { k: 1 } }; // error here

const E: D = { if yes() { continue; } D { k: 1 } }; // error here

const F: i64 = { if yes() { return; } 3 }; // error here

fn main() {
    let a = C;
    let b = E;
    'p: loop {
        let c = C;
        let f = F;
        println("{} {} {} {}", a.k, b.k, c.k, f);
        break 'p;
    }
}
