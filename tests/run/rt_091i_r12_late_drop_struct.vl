// (0.30.2, the re-review of g302holes: r91/r12_late_drop_struct)
// EXPECT: 12
// EXPECT: drop
// A Drop struct holding an iterator with an inner closure built by an outer closure.
struct G<I: Iterator<Item = i64>> { it: I }

impl<I: Iterator<Item = i64>> Drop for G<I> {
    fn drop(&mut self) { println("drop"); }
}

fn main() {
    let v = [1i64, 2, 3];
    let mk = |m: i64| G { it: v.iter().map(move |x| x * m) };
    let mut g = mk(2);
    let mut s = 0i64;
    loop {
        match g.it.next() { Some(x) => s += x, None => break }
    }
    println("{s}");
}
