// EDITION: rust
// RULE: F6.2
// (0.28.0) A reference to an array has its slice's methods, as rustc's
// probe finds them (deref, then unsizing): `r.len()`, `m.iter()`,
// `m.reverse()` of `r: &[i64; 3]`, `m: &mut [i64; 3]` ("no method 'len' on
// type '&[i64; 3]'").
fn total(r: &[i64; 3]) -> i64 { r.iter().sum::<i64>() + r.len() as i64 }

fn main() {
    let mut a = [3i64, 1, 2];
    let r = &a;
    println("{} {}", a.len(), r.len());
    println("{}", total(r));
    let m = &mut a;
    m[0] = 4;
    m.reverse();
    println("{} {} {:?}", m.len(), m.iter().sum::<i64>(), m.first());
    println("{} {}", a[0], a.contains(&4));
}
// EXPECT: 3 3
// EXPECT: 9
// EXPECT: 3 7 Some(2)
// EXPECT: 2 true
