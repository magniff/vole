// EDITION: rust
// RULE: F20.2 (Vec's slice methods through Deref<Target = [T]> and
// DerefMut; `s.get(0)` and `first`'s I fixed by SliceIndex's one impl)
// EXPECT: 2 4 true 3 [5, 4] Some(4) 5
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(4);
    let n = v.iter().count();
    let l = *v.last().unwrap();
    let c = v.contains(&4);
    let f = *v.first().unwrap();
    v.reverse();
    for x in v.iter_mut() {
        *x += 1;
    }
    println("{} {} {} {} {:?} {:?} {}", n, l, c, f, v.as_slice(), v.get(1), v[0]);
}
