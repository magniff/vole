// RULE: F18.5
// (0.30.2) A candidate the probe weighs and rejects binds no integer
// variable: impl selection matches headers and tries arguments in a
// snapshot (infer::probe_begin), as rustc's probe does. An earlier 0.30.2
// build left the rejected candidate's binding behind: a became u8 and
// `a - 10` printed 251.
// EXPECT: 2
// EXPECT: -5
trait Tr<X> { fn go(&self, x: X) -> i32; }
struct S;
impl<T> Tr<(T, T, u8)> for S { fn go(&self, x: (T, T, u8)) -> i32 { 1 } }
impl<U, V> Tr<(U, V, i64)> for S { fn go(&self, x: (U, V, i64)) -> i32 { 2 } }

fn main() {
    let a = 5;
    let t = (Some(a), Some(7u8), 9i64);
    println("{}", S.go(t));
    let b = 10;
    let z = a - b;
    println("{}", z);
}
