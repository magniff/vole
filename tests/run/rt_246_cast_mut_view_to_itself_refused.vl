// XFAIL: RT-246: `s as &mut [i64]` of a `&mut [i64]` (a cast to its own type) is refused, "cannot cast" (0.30.2)
// rustc accepts a cast of a value to its own type (the trivial cast, a lint at most).
// EXPECT: 7 2
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let s: &mut [i64] = v.as_mut_slice();
    let t = s as &mut [i64];
    t[0] = 7;
    println("{} {}", v[0], v.len());
}
