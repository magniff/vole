// sem-own: a thread returning an owned value: dropped once by the joiner.
// EXPECT: got 3
// EXPECT: drop 3
// EXPECT: end
use std::thread; use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    {
        let h = thread::spawn_in(move || mk(3, gpa), gpa);
        let d = h.join().unwrap();
        println("got {}", d.id);
    }
    println("end");
}
