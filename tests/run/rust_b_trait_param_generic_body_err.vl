// (0.30.1, review 2) The body of an impl's function of a generic trait's
// generic method is checked when the trait's parameter is in the method's
// signature (a parameter, the result) or in a bound of the method's own
// parameter: each body below has a type error, as rustc says (E0308).
// Before, the trait's A did not resolve under the opaque instance, the
// instance was unsure and its errors were dropped.
// ERROR: type error
// ERROR: type error
// ERROR: type error
// ERROR-COUNT: 3
trait Tr1<A> {
    fn f<B>(&self, a: A, b: B);
}

trait Tr2<A> {
    fn f<B>(&self, b: B) -> A;
}

trait Tr3<A> {
    fn f<B: Into<A>>(&self, b: B) -> i64;
}

struct S;

impl Tr1<i64> for S {
    fn f<B>(&self, a: i64, b: B) {
        let q: i64 = "x";
    }
}

impl Tr2<i64> for S {
    fn f<B>(&self, b: B) -> i64 {
        let q: i64 = "x";
        1
    }
}

impl Tr3<i64> for S {
    fn f<B: Into<i64>>(&self, b: B) -> i64 {
        let q: i64 = "x";
        1
    }
}

fn main() {}
