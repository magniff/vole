// RULE: F7.3, Z9.1c
// (0.28.0) A field through a reference to a reference derefs each
// (`e.n` of `e: &&E` in `filter(|e| ..)`); and an impl for `&'a [T]` is
// the shared view's where a bound asks (`U: IntoIterator` of zip, a
// program's own trait), as it was for a method call.
// EXPECT: 1 1 3
// EXPECT: 3 2 2
#[derive(Clone, Copy)]
struct E {
    n: i64,
}

trait Count {
    fn count(self) -> usize;
}

impl<'a, T> Count for &'a [T] {
    fn count(self) -> usize {
        self.len()
    }
}

fn of<U: Count>(u: U) -> usize {
    u.count()
}

fn items<U: IntoIterator>(u: U) -> usize {
    u.into_iter().count()
}

fn main() {
    let v = [E { n: 1 }, E { n: 2 }];
    let more = v.iter().filter(|e| e.n > 1).count();
    let by_pattern = v.iter().filter(|&e| e.n > 1).count();
    let sum: i64 = v.iter().map(|&e| e.n).sum();
    println("{more} {by_pattern} {sum}");
    let a = [1i64, 2, 4];
    let steps: i64 = a.iter().zip(&a[1..]).map(|(x, y)| *y - *x).sum();
    println("{steps} {} {}", of(&a[1..]), items(&a[1..]));
}
