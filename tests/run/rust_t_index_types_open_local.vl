// RULE: F18.5
// (0.28.0) An index is a usize, and a literal or a local still open
// takes that type from it: `for i in 0..81 { cells[i]; f(i) }` with `f(i:
// usize)` left i an i32 ("expected 'usize', got 'i32'"), and so did `let
// j = 5; cells[j]; f(j)`.
// EXPECT: 5 3240 81
fn f(i: usize) -> usize {
    i
}

fn main() {
    let cells = [1i64; 81];
    let j = 5;
    let _c = cells[j];
    let t = f(j);
    let mut u = 0usize;
    let mut s = 0i64;
    for i in 0..81 {
        s += cells[i];
        u += f(i);
    }
    println("{t} {u} {s}");
}
