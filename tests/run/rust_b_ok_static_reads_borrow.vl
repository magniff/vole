// RULE: M3
// (0.30.1) What rustc accepts of a static that is not Copy, and of a Copy
// one's binders: a format argument and a comparison's operand borrow the
// static (format_args and PartialEq take `&S`), with or without a Drop
// impl; a Copy static's binders own their copies and may be `mut`. No
// static is dropped: no `drop` line. Before, `println("{:?}", SP)` of a
// static that needs no drop was refused as a move out of it, and a binder
// of a static's part was a borrowed copy. The EXPECT lines are rustc's.
// FLAGS: --check-alloc
// EXPECT: P { x: 1 }
// EXPECT: D { v: 2 }
// EXPECT: true false true
// EXPECT: 13 4
// EXPECT: 101 2
// EXPECT: 7
// EXPECT: 11 2
// EXPECT: 2 1
#[derive(Debug, PartialEq)]
struct P {
    x: i64,
}

#[derive(Debug, PartialEq)]
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

static SP: P = P { x: 1 };
static SD: D = D { v: 2 };
static SC: C = C { a: 1, b: 2 };
static ST: (i64, i64) = (3, 4);

fn main() {
    println("{:?}", SP);
    println("{:?}", SD);
    let q = P { x: 1 };
    println("{} {} {}", SP == q, SD.v == 3, SC.a == 1);
    let (mut x, y) = ST;
    x += 10;
    println("{} {}", x, y);
    let C { mut a, b } = SC;
    a += 100;
    println("{} {}", a, b);
    match SC {
        mut c => {
            c.b = 7;
            println("{}", c.b);
        }
    }
    let mut t = SC;
    t.a += 10;
    println("{} {}", t.a, SC.b);
    println("{} {}", SD.v, SP.x);
}
