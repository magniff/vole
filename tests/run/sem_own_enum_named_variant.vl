// sem-own: a named-field variant destructured; the bound field moved, the
// `..`-skipped one dropped with the value at scope end (once each).
// EXPECT: c 7
// EXPECT: drop 7
// EXPECT: end
// EXPECT: drop 8
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

enum E<A: Allocator> { C { d: D<A>, e: D<A> }, N }

fn main(gpa: Gpa) {
    let x = E::C { d: mk(7, gpa), e: mk(8, gpa) };
    match x {
        E::C { d, .. } => println("c {}", d.id),
        E::N => println("n"),
    }
    println("end");
}
