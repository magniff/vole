// ERROR: trait.overflow
// (review of M2, R1) where predicates that need each other: an overflow (rustc E0275).
trait A { fn a(&self) -> i64; }
trait B { fn b(&self) -> i64; }
struct S { r: i64 }
impl A for S where S: B { fn a(&self) -> i64 { self.b() } }
impl B for S where S: A { fn b(&self) -> i64 { 2 } }
fn need<X: A>(x: &X) -> i64 { x.a() }
fn main() { println("{}", need(&S { r: 0 })); }
