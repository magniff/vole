// (0.25) A tuple holding a struct with an inout field is move-only: `let u =
// t` moves it, a later use of t is own.moved.
struct C<'a> { n: &'a mut i64 }

fn main() {
    let mut x: i64 = 1; let t = (C { n: &mut x }, 2); let u = t; *u.0.n += 1; *t.0.n += 1;
    println("{x}");
}
// ERROR: error[borrowck.use_moved]
