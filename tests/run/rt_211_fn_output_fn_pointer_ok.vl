// RT-211 review 3, re-review: fz01 through an fn pointer, `let g: fn(&i64)
// -> &i64 = id;`: B is the bound's only input region, so dropping the
// adapter's other borrow builds (rustc, the release and v0.30.1 build it).
// EXPECT: Some(1000)
fn id(x: &i64) -> &i64 {
    x
}

struct MyMapZ<'z, I, F> {
    i: I,
    f: F,
    z: &'z i64,
}

impl<'z, B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMapZ<'z, I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        let _ = *self.z;
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut zz: Vec<i64, Gpa> = Vec::new_in(gpa);
    zz.push(3);
    let g: fn(&i64) -> &i64 = id;
    let r = first(MyMapZ { i: v.iter(), f: g, z: &zz[0] }, &k);
    drop(zz);
    println("{:?}", r);
}
