// sem-own: owned items made by map and collected: each dropped once, with the Vec.
// EXPECT: n 3
// EXPECT: end
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: drop 2
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    {
        let w: Vec<D<Gpa>, Gpa> = (0..3).map(|i| mk(i, gpa)).collect_in(gpa);
        println("n {}", w.len());
        println("end");
    }
}
