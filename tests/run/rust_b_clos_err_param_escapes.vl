// EDITION: rust
// RULE: D20.3, D19.10
// (0.27.2) A closure's `&` parameter is a bound region, the call's: storing
// it into a capture is "borrowed data escapes outside of closure" (rustc
// E0521), one error.
// ERROR: error[borrowck.outlives]
// ERROR-COUNT: 1
struct H<'a> {
    p: &'a i64,
}

fn main() {
    let a = 1;
    let mut h = H { p: &a };
    let mut f = |p: &i64| {
        h.p = p;
    };
    let b = 2;
    f(&b);
    println("{}", *h.p);
}
