// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ptr NonNull::impl Clone.
// EXPECT: 9 9
use std::ptr::NonNull;

fn main() {
    let mut x = 9i64;
    let p = NonNull::new(&mut x as *mut i64).unwrap();
    let q = p.clone();
    println("{} {}", unsafe { *p.as_ptr() }, unsafe { *q.as_ptr() });
}
