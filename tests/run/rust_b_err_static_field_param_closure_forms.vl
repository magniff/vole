// RULE: D3.6 (0.30.2, RT-383) A `&'static` field set from a parameter's
// elided region (a method's `Self { a }`, a struct with a lifetime of its
// own), from a closure's parameter, or from a borrow of a `move`
// closure's captured value: the region must outlive 'static, which it does
// not. rustc: "lifetime may not live long enough" for the parameters, and
// E0597 / "borrowed data escapes" for the closures. Before 0.30.2 all but
// the struct with a lifetime were accepted.
// ERROR: error[borrowck.outlives]
// ERROR: line 30, column 9
// ERROR: error[borrowck.outlives]
// ERROR: line 35, column 5
// ERROR: error[borrowck.outlives]
// ERROR: line 35, column 5
// ERROR: error[borrowck.outlives]
// ERROR: line 45, column 23
// ERROR: error[borrowck.outlives]
// ERROR: line 47, column 33
// ERROR-COUNT: 5
struct V {
    a: &'static u64,
}

struct L<'x> {
    x: &'x u64,
    a: &'static u64,
}

impl V {
    fn new(a: &u64) -> Self {
        Self { a }
    }
}

fn with_lifetime<'x>(x: &'x u64, y: &u64) -> L<'x> {
    L { x, a: y }
}

fn keep(v: V) -> u64 {
    *v.a
}

fn main() {
    let k = 1u64;
    let j = 2u64;
    let g = |r: &u64| V { a: r };
    let e = 3u64;
    let f = move || keep(V { a: &e });
    println("{} {} {} {}", V::new(&k).a, with_lifetime(&k, &j).a, g(&k).a, f());
}
