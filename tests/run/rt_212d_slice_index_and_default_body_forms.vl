// XFAIL: RT-212: (other forms of R302D-34) `v[0].clone()` on a `&[T]` parameter and `(*self).clone()` in a trait's default body with Self = &W run W's Clone (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_034d_slice_index_and_default_body_forms.rs.txt).
// vole prints `W::clone` and `slice W { k: 101 }`, `W::clone` and `default W { k: 101 }`;
// `(*t).clone()` on a `&T` parameter and `x.clone()` on a pattern binding are right.
// Since v0.28.0 (the release build; g302probe the same).
// EXPECT: deref W { k: 1 }
// EXPECT: slice W { k: 1 }
// EXPECT: binding W { k: 1 }
// EXPECT: default W { k: 1 }
use std::fmt::Debug;

#[derive(Debug)]
struct W {
    k: i64,
}

impl Clone for W {
    fn clone(&self) -> W {
        println("W::clone");
        W { k: self.k + 100 }
    }
}

fn deref_place<T: Clone + Debug>(t: &T) {
    let c = (*t).clone();
    println("deref {:?}", c);
}

fn vec_elem<T: Clone + Debug>(v: &[T]) {
    let c = v[0].clone();
    println("slice {:?}", c);
}

fn opt<T: Clone + Debug>(o: &Option<T>) {
    if let Some(x) = o {
        let c = x.clone();
        println("binding {:?}", c);
    }
}

trait Dup: Clone + Debug {
    fn dup(&self) {
        let c = (*self).clone();
        println("default {:?}", c);
    }
}

impl<'a> Dup for &'a W {}

fn main() {
    let w = W { k: 1 };
    deref_place(&&w);
    vec_elem(&[&w]);
    opt(&Some(&w));
    (&w).dup();
}
