// EDITION: rust
// RULE: D3.6, L13
// (0.27.2) The arguments of a call through a `fn` value are related
// whether or not the callee stores one through the other: the erased
// `fn` type cannot say it does not, so `&w` is tied to `*r` and `w` dies
// before `*r` is read. Stricter than rustc, which keeps the elided
// regions of `fn(&mut &i64, &i64)` apart (L13).
// RUSTC: accepts L13 the erased fn type's lifetimes are one region
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 23, column 34
// ERROR-COUNT: 1
fn look(x: &mut &i64, y: &i64) -> i64 {
    **x + *y
}

fn main() {
    let f: fn(&mut &i64, &i64) -> i64 = look;
    let a = 1;
    let mut p: &i64 = &a;
    let r = &mut p;
    {
        let w = 2;
        println("{}", f(&mut *r, &w));
    }
    println("{}", **r);
}
// (0.27.2) written against MVS std until it migrates to std2:
