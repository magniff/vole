// places IR (0.26.2): an owned assignment drops the old value wherever it
// stands, as Rust's: a match arm's value and inside an expression (0.25's
// own pass dropped it only at a statement or a block's tail: `drop 0` and
// `drop 4` never printed, their Vecs lost; VOLE_LOWER=ast still does), and
// as before at a block arm's statement and a closure's body.
// FLAGS: --check-alloc
// EXPECT: drop 0
// EXPECT: drop 2
// EXPECT: drop 4
// EXPECT: drop 6
// EXPECT: 1 3 5 7
// EXPECT: drop 7
// EXPECT: drop 5
// EXPECT: drop 3
// EXPECT: drop 1
// PLACES: fn main
// PLACES: call mk(const 1
// PLACES: drop(_
// PLACES: [kept]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    var s = mk(0, gpa);
    let k = 1;
    match k { 1 => s = mk(1, gpa), _ => {} }
    var t = mk(2, gpa);
    let u = match k { 1 => { t = mk(3, gpa); 1 }, _ => 0 };
    var w = mk(4, gpa);
    let n = if k == 1 { (w = mk(5, gpa), 2).1 } else { 0 };
    var c = mk(6, gpa);
    let set = |x: i64| c = mk(x, gpa);
    set(7);
    println("{} {} {} {}", s.id, t.id + u - 1, w.id + n - 2, c.id);
}
