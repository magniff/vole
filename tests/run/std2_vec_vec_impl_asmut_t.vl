// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::impl AsMut<[T]>.
// EXPECT: [0, 2]
use std::vec::Vec;

fn zero<S: AsMut<[i64]>>(s: &mut S) {
    s.as_mut()[0] = 0;
}

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1i64, 2], gpa);
    zero(&mut v);
    println("{:?}", v);
}
