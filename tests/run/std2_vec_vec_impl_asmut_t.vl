// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl AsMut<[T]>.
// EXPECT: [0, 2]
use std::vec::Vec;

fn zero<S: AsMut<[i64]>>(s: &mut S) {
    s.as_mut()[0] = 0;
}

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2], gpa);
    zero(&mut v);
    println("{:?}", v);
}
