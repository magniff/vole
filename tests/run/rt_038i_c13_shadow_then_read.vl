// (0.30.2, the re-review of g302holes: c1/c13_shadow_then_read)
// RUSTC: none contract clauses are not Rust
// ERROR: 's' is used here after it moved
// a shadow first, then a real read of the parameter (not moved): builds, reads 4.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures {
    let a = [1i64, 2];
    a.iter().all(|s: &i64| *s > 0) && s.v == 4
}

{
    s.v
}

fn main() {
    println("{}", f(N { v: 4 }));
}
