// EDITION: rust
// a closure taking two inout params, called with the same place twice
// ERROR: error[borrowck.mut_twice]
// ERROR: line 8, column 32
fn main() {
    let sw = |a: &mut i64, b: &mut i64| { let t = *a; *a = *b; *b = t + 1; };
    let mut x: i64 = 1;
    { let at_arg1 = &mut x; sw(&mut x, at_arg1) };
    println("{x}");
}
