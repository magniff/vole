// RULE: F32.1
// A reference to a shared reference where the inner one goes is read
// through, Rust's deref coercion: `&&str` as a `&str`, `&&i64` as a
// `&i64`; std2's generic bodies over a `&str` type argument rely on it
// (`Box::new_in("hi")` shows "hi"); `v.iter().copied()` binds the impl's T
// from the bound's Item (F14.1).
// EXPECT: 2 7 "hi" Some(1)
fn len_of(s: &str) -> usize {
    s.len()
}

fn get(x: &i64) -> i64 {
    *x
}

fn main(gpa: Gpa) {
    let a = "ab";
    let r = &a;
    let n = 7i64;
    let m = &n;
    let b = Box::new_in("hi", gpa);
    let v = Vec::from_in([1i64, 2], gpa);
    let mut it = v.iter().copied();
    println("{} {} {:?} {:?}", len_of(&r), get(&m), b, it.next());
}
