// EDITION: rust
// RULE: D3.6, R6, L13
// (0.27.2) The result of a call through a `fn` value is related to its
// arguments in its invariant positions too: `pass`'s result is `&mut p`
// itself, `&v` is stored through it, and `v` dies before `p` is read
// (rustc: E0597). The second error is L13's: the erased type's lifetimes
// are one region, so the `&mut p` lives as long as `p`'s referent.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 23, column 14
// ERROR: error[borrowck.use_borrowed]
// ERROR-COUNT: 2
fn pass<'a, 'b>(x: &'a mut &'b i64) -> &'a mut &'b i64 {
    x
}

fn main() {
    let f = pass;
    let a = 1;
    let mut p: &i64 = &a;
    {
        let v = 2;
        let r = f(&mut p);
        *r = &v;
    }
    println("{}", *p);
}
