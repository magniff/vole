// RULE: D2.7
// (0.30.1, RT-33 round 2, F1) The same through a stored view, `w.s[..2]
// .reverse()` while `r = &w.s[..]` is live: rustc's E0502.
// ERROR: error[borrowck.conflict]: cannot borrow 'w.s' as mutable because it is also borrowed as immutable
// ERROR: line 16, column 5
// ERROR-COUNT: 1
struct W<'a> {
    s: &'a mut [i64],
}

fn main() {
    let mut a = [1i64, 2, 3];
    let w = W { s: &mut a[..] };
    let r: &[i64] = &w.s[..];
    let before = r[0];
    w.s[..2].reverse();
    println("{} {}", before, r[0]);
}
