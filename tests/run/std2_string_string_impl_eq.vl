// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl Eq.
// EXPECT: true
use std::string::ToStringIn;

fn same<T: Eq>(a: &T, b: &T) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    println("{}", same(&String::from_in("q", gpa), &String::from_in("q", gpa)));
}
