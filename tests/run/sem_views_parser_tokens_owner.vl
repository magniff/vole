#[derive(Clone, Copy)] // (0.25 semantics audit, views) The guide's parser (guide views): its
// tokens view the input, and `name` (views(*self)) returns a token's text,
// a view of the input. Growing the input while that text is used is
// own.conflict. The element read `self.toks[self.pos]` drops what the
// token views, so it is accepted: a use after free.
// ERROR: error[own.conflict]
use std::alloc::Allocator; struct Tok<'a> { text: &'a str, kind: i64 }
struct Parser<'a, A: Allocator> { toks: Vec<Tok<'a>, A>, pos: i64 }

impl<'a> Parser<'a, Gpa> {
    fn name(&mut self) -> &str {
        let t = self.toks[self.pos as usize];
        self.pos += 1;
        t.text
    }
}

fn main(gpa: Gpa) {
    let mut src = String::new_in(gpa);
    src.push_str("let x");
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: &src.as_str()[0..3], kind: 0 });
    let a = p.name();
    src.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", a);
}
