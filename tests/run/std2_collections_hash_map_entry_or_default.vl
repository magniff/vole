// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map Entry::or_default.
// EXPECT: 0 2
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let a = *m.entry(1).or_default();
    *m.entry(2).or_default() += 2;
    println("{} {}", a, m[&2]);
}
