// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Chars::as_str.
// EXPECT: "ébc" "bc" ""
use std::str::CharIndices;

fn main() {
    let mut it = "ébc".chars();
    let a = it.as_str();
    it.next();
    let b = it.as_str();
    it.next();
    it.next();
    println("{:?} {:?} {:?}", a, b, it.as_str());
}
