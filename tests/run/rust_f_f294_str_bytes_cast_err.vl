// RULE: F29.4
// (0.30.1) `as` makes no `&mut str` of bytes, which safe code would then
// read as UTF-8 (a str of 0xff 0xfe), and no `&[u8]` of a `&str` (rustc
// E0605 both: a str's bytes are `s.as_bytes()`, bytes become a str
// through `str::from_utf8`).
// ERROR: error[type error]: 'as str' does not check that bytes are UTF-8
// ERROR: line 14, column 13
// ERROR: line 17, column 13
// ERROR: error[type.ref_cast]: cannot cast '&str' to the reference '&[u8]'
// ERROR: line 19, column 13
// ERROR-COUNT: 3
fn main(gpa: Gpa) {
    let mut arr = [0xffu8, 0xfe, 0x41];
    let r = &mut arr[..] as &mut str;
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.push(0x41);
    let w = &mut v[..] as &mut str;
    let s = "abc";
    let b = s as &[u8];
    println("{} {} {}", r.len(), w.len(), b.len());
}
