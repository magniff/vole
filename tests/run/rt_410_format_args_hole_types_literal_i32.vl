// XFAIL: RT-410: WRONG CODE: a format_args hole types an integer variable i32 at once: `let a = 2000000000; format_args("{}", a + a); let b: i64 = a;` overflows (panic at -O0, -294967296 at -O2); rustc types a i64 and prints `4000000000 2000000000` (0.30.2)
// The assert! message form is rt_410b.
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 4000000000 2000000000
fn main() {
    let a = 2000000000;
    let s = format_args("{}", a + a);
    let b: i64 = a;
    println("{} {}", s, b);
}
