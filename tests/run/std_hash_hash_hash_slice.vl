// Runs on std since 0.27.2's switch.
// The std item(s): std::hash Hash::hash_slice.
// EXPECT: write [1, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [2, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [3, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [4, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: 32
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

struct Point {
    x: i64,
    y: i64,
}

impl Hash for Point {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.x.hash(state);
        self.y.hash(state);
    }
}

fn main() {
    let mut h = Show { n: 0 };
    let pts: [Point; 2] = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }];
    Point::hash_slice(&pts[..], &mut h);
    println("{}", h.finish());
}
