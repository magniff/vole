// EDITION: rust
// RULE: F34.1
// (0.27.6) `const fn` is a function: at the top level, in an impl,
// after `pub`, `const unsafe fn`; a call of one is constant in a static's
// initializer.
// EXPECT: 42 8 7 3 5
#[derive(Clone, Copy)]
struct D {
    secs: u64,
}

impl D {
    pub const fn new(secs: u64) -> D {
        D { secs }
    }

    const fn twice(self) -> u64 {
        self.secs * 2
    }
}

const fn double(x: u64) -> u64 {
    x * 2
}

pub const fn seven() -> u64 {
    7
}

// UNSAFE: the case of `const unsafe fn`; nothing in it needs unsafe.
// SAFETY: it has no precondition: callers may call it anywhere.
const unsafe fn three() -> u64 {
    3
}

static S: D = D::new(5);

fn main() {
    // UNSAFE: three is an unsafe fn, the case of `const unsafe fn`.
    // SAFETY: three has no precondition.
    let t = unsafe { three() };
    println("{} {} {} {} {}", double(21), D::new(4).twice(), seven(), t, S.secs);
}
