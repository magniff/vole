// RULE: F27.1, F27.2, F7.2, F5.4
// Struct patterns in `let` and `match`: by field name (with `..` and
// shorthand), by position for a tuple struct, `Self { .. }` and
// `Self(..)` in an impl, nested, with literals in a match, and on a
// generic struct; a struct pattern on a place moves only what it binds.
// EXPECT: 3 4
// EXPECT: 12
// EXPECT: origin
// EXPECT: x axis 5
// EXPECT: other
// EXPECT: 7
// EXPECT: hi 9
use std::alloc::Allocator;

struct Point {
    x: i64,
    y: i64,
}

struct Pair(i64, i64);

struct Line {
    from: Point,
    to: Point,
}

struct W<T> {
    v: T,
    n: i64,
}

struct Named<A: Allocator> {
    name: String<A>,
    n: i64,
}

impl Point {
    fn sum(&self) -> i64 {
        let Self { x, y } = *self;
        x + y
    }
}

impl Pair {
    fn product(&self) -> i64 {
        match *self {
            Self(a, b) => a * b,
        }
    }
}

fn describe(p: Point) -> i64 {
    match p {
        Point { x: 0, y: 0 } => {
            println("origin");
            0
        }
        Point { x, y: 0 } => {
            print("x axis ");
            println("{}", x);
            1
        }
        Point { .. } => {
            println("other");
            2
        }
    }
}

fn main(gpa: Gpa) -> i64 {
    let p = Point { x: 3, y: 4 };
    let Point { x, y: why } = p;
    print("{}", x);
    print(" ");
    println("{}", why);
    let q = Pair(3, 4);
    let Pair(a, b) = q;
    println("{}", a * b + p.sum() - 7 + q.product() - 12);
    describe(Point { x: 0, y: 0 });
    describe(Point { x: 5, y: 0 });
    describe(Point { x: 5, y: 1 });
    let l = Line { from: Point { x: 1, y: 2 }, to: Point { x: 3, y: 1 } };
    let Line { from: Point { x: x1, .. }, to: Point { y: y2, x: x2 } } = l;
    let w = W { v: 2u8, n: 1 };
    let W { v, n } = w;
    println("{}", x1 + y2 + x2 + v as i64 + n - 1);
    let s = Named { name: String::from_in("hi", gpa), n: 9 };
    let Named { name, n: k } = s;
    print("{}", name.as_str());
    print(" ");
    println("{}", k);
    0
}
// Runs on std since its gap closed (0.27.2).
