// rustc prints the EXPECT lines.
// EXPECT: 7 0
trait T0 { fn base(&self) -> i64 { 0 } }
trait T1: T0 {}
trait T2: T1 {}
trait T3: T2 {}
trait T4: T3 {}
trait T5: T4 {}
trait T6: T5 {}
trait T7: T6 {}
trait T8: T7 {}
trait T9: T8 {}
trait T10: T9 {}
trait Top: T10 { const K: i64; fn mk() -> i64; }
struct S;
impl T0 for S {}
impl T1 for S {}
impl T2 for S {}
impl T3 for S {}
impl T4 for S {}
impl T5 for S {}
impl T6 for S {}
impl T7 for S {}
impl T8 for S {}
impl T9 for S {}
impl T10 for S {}
impl Top for S { const K: i64 = 3; fn mk() -> i64 { 4 } }
fn f<X: Top>() -> i64 { X::K + X::mk() }
fn main() { println("{} {}", f::<S>(), S.base()); }
