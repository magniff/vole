// RT-34: `old(v.len())` read at entry, then v moved into the body and
// out by its `for`; an `ensures` reading `result` that holds the moved
// values, in place. Each value is dropped once, as without the clauses;
// rustc prints the EXPECT lines.
// FLAGS: --check-alloc
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: took 2
// EXPECT: drop 2
// EXPECT: 2
// EXPECT: drop 4
// EXPECT: kept 3 5
// EXPECT: passed 7
// EXPECT: drop 7
// EXPECT: drop 3
// EXPECT: drop 5
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

// old(v.len()) read at entry, then v moved into the body and its for
fn count(v: Vec<D, Gpa>) -> usize
    requires v.len() > 0
    ensures result == old(v.len())
{
    let mut n: usize = 0;
    for d in v {
        take(d);
        n += 1;
    }
    n
}

// result holds the moved values; the ensures reads it in place
fn keep(v: Vec<D, Gpa>, gpa: Gpa) -> Vec<D, Gpa>
    ensures result.len() == 2 && result[0].v == 3
{
    let mut w: Vec<D, Gpa> = Vec::new_in(gpa);
    for d in v {
        if d.v != 4 {
            w.push(d);
        }
    }
    w
}

fn pass(d: D) -> D
    ensures result.v == old(d.v)
{
    d
}

fn main(gpa: Gpa) {
    println("{}", count(Vec::from_in([D { v: 1 }, D { v: 2 }], gpa)));
    let w = keep(Vec::from_in([D { v: 3 }, D { v: 4 }, D { v: 5 }], gpa), gpa);
    println("kept {} {}", w[0].v, w[1].v);
    let p = pass(D { v: 7 });
    println("passed {}", p.v);
}
