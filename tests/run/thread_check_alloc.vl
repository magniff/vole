// (0.25.5) --check-alloc under threads: eight threads allocate and free
// at once through the checking allocator, which now holds a lock (0.25.4
// reported invalid and double frees, or crashed: its tables changed from
// two threads at once).
// FLAGS: --check-alloc
// EXPECT: 48000

use std::thread;

fn main(gpa: Gpa) {
    var hs: Vec<thread::JoinHandle<i64>> = Vec::new_in(gpa);
    for k in 0..8 {
        hs.push(thread::spawn(sink || {
            var t = 0;
            for i in 0..3000 {
                var v: Vec<i64> = Vec::new_in(gpa);
                v.push(i);
                v.push(k);
                t += v.len() as i64;
            }
            t
        }));
    }
    var s = 0;
    while hs.len() > 0 { s += hs.pop().unwrap().join(); }
    println(s);
}
