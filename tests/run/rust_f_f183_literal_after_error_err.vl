// EDITION: rust
// RULE: F18.3
// (0.27.7) A literal beside a value an error left untyped takes the error
// type: `value > 9223372036854775807` after the mismatch in `let value =
// parse("x")` is no second error (0.27.6 checked the literal against the
// i32 fallback: "does not fit in type 'i32'"). rustc reports the E0308
// only.
// ERROR: error[type error]: expected 'i64', got 'str'
// ERROR: line 16, column 23
// ERROR-COUNT: 1
fn parse(n: i64) -> u64 {
    n as u64
}

fn main() {
    let value = parse("x");
    println("{}", value > 9223372036854775807);
}
