// EDITION: rust
#[derive(Clone, Copy)] // a closure calling an inout method on a captured plain let struct (captured by copy)
// ERROR: borrowck.borrow_immutable
struct P { x: i64 }
impl P { fn bump(&mut self) { self.x += 1; } }

fn main() {
    let p = P { x: 1 };
    let c = || { p.bump(); p.x };
    println("{} {} {}", c(), c(), p.x);
}
