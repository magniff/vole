// 0.26.2: gpu.entry for a string literal (diagnostic 6): a pipeline of a
// shader made from `K.src` in the function, named by an entry point the
// module has not; the fix is the block's field.
// ERROR: error[gpu.entry]: the block 'K' has no @compute fn 'evolv'; its entry points: evolve (compute)
// ERROR: err_gpu_entry_literal.vl: line 23, column 45
// ERROR: help: the block's field names its entry point: K.evolve
// ERROR: fix --suggested
use std::gpu;
use std::gpu::BufferUsage;

embed wgsl K {
    @group(0) @binding(0) var<uniform> params: vec4<f32>;
    @group(0) @binding(1) var<storage, read_write> cells: array<u32>;

    @compute @workgroup_size(64)
    fn evolve(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] = cells[id.x] + u32(params.x);
    }
}

fn setup(dev: gpu::Device) -> Result<gpu::ComputePipeline, gpu::Error> {
    let shader = dev.shader_wgsl(K.src)?;
    let pipe = dev.compute_pipeline(shader, "evolv")?;
    Ok(pipe)
}

fn main() -> i32 {
    0
}
