// EDITION: rust
// RULE: F20.6, F20.4
// (0.27.5) Through a user DerefMut: `w.x.push(..)` reads `w.x` through
// Deref, and the `&mut self` push makes it DerefMut's; `deref` would
// print. An index under it is IndexMut's too.
// EXPECT: 2 1
use std::alloc::Allocator;
use std::ops::{Deref, DerefMut};

struct In<A: Allocator> {
    x: Vec<i64, A>,
}

struct W<A: Allocator> {
    inner: In<A>,
}

impl<A: Allocator> Deref for W<A> {
    type Target = In<A>;

    fn deref(&self) -> &In<A> {
        println("deref");
        &self.inner
    }
}

impl<A: Allocator> DerefMut for W<A> {
    fn deref_mut(&mut self) -> &mut In<A> {
        &mut self.inner
    }
}

fn main(gpa: Gpa) {
    let mut w = W { inner: In { x: Vec::new_in(gpa) } };
    w.x.push(1);
    w.x.push(2);
    let mut ws: Vec<W<Gpa>, Gpa> = Vec::new_in(gpa);
    ws.push(W { inner: In { x: Vec::new_in(gpa) } });
    ws[0].x.push(5);
    println("{} {}", w.inner.x.len(), ws[0].inner.x.len());
}
