// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::chunks.
// EXPECT: [1, 2] [3, 4] [5]
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 2, 3, 4, 5];
    let mut c = s.chunks(2);
    println("{:?} {:?} {:?}", c.next().unwrap(), c.next().unwrap(), c.next().unwrap());
}
