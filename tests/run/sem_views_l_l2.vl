// XFAIL: gap 8: compile borrowck.return_local: a reference to 'self', a local of this function, escapes it (borrowed at sem...
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello / 5
// EXPECT: hello
// EXPECT: 5
#[derive(Clone, Copy)] struct E { name: [u8; 8], len: i64 }
impl E { fn name(self) -> &'static [u8] { &self.name[..self.len as usize] } }
fn mk() -> E { E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 } }

fn main() -> i32 {
    let e = mk();
    let n = e.name();
    println("{}", str::from_utf8(n).unwrap());
    println("{}", n.len());
    0
}
