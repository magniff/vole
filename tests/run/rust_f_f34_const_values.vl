// RULE: F34.2
// (0.27.6) A constant of a struct or tuple type, or whose value calls a
// `const fn`, is its value made again at each use, as in Rust: two uses
// of a constant with a Drop field are two values, each changed and
// dropped on its own. A `const fn` is constant in a static's value.
// EXPECT: 15 6 42 1 5 5
// EXPECT: 0 99 7 7 12
// EXPECT: 11 21
// EXPECT: drop 21
// EXPECT: drop 11
mod time {
    #[derive(Clone, Copy)]
    pub struct D {
        pub secs: u64,
    }

    impl D {
        pub const ZERO: D = D { secs: 0 };
        pub const MAX: D = D::new(99);

        pub const fn new(secs: u64) -> D {
            D { secs }
        }
    }

    pub const EPOCH: D = D { secs: 7 };
}

use time::EPOCH;

#[derive(Clone, Copy)]
struct P {
    secs: u64,
    nanos: u32,
}

impl P {
    pub const fn new(secs: u64, nanos: u32) -> P {
        P { secs, nanos }
    }
}

const fn double(x: u64) -> u64 {
    x * 2
}

const fn mk(secs: u64) -> P {
    P { secs, nanos: 0 }
}

const N: u64 = double(21);
const ORIGIN: P = P { secs: 5, nanos: 1 };
const SECOND: P = P::new(1, 0);
const PAIR: (u64, P) = (3, P { secs: 2, nanos: 2 });
static S: P = mk(12);

struct Bag {
    n: i64,
}

impl Drop for Bag {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

const B: Bag = Bag { n: 1 };

fn bags() {
    let mut a = B;
    let mut b = B;
    a.n += 10;
    b.n += 20;
    println("{} {}", a.n, b.n);
}

fn main() {
    let mut b = ORIGIN;
    b.secs += 10;
    let c = ORIGIN;
    println("{} {} {} {} {} {}", b.secs, c.secs + c.nanos as u64, N, SECOND.secs,
        PAIR.0 + PAIR.1.secs, ORIGIN.secs);
    let z = time::D::ZERO;
    println("{} {} {} {} {}", z.secs, time::D::MAX.secs, EPOCH.secs, time::EPOCH.secs, S.secs);
    bags();
}
