// XFAIL: RT-121: String::extend_from_within checks no char boundary: safe code appends half a char and the String is not UTF-8 (0.30.2)
// rustc's String::extend_from_within asserts that the range's ends are
// char boundaries ("assertion failed: self.is_char_boundary(start)",
// exit 101). vole's (compiler/std/string.vl:331-335) passes the range
// to Vec::extend_from_within unchecked: "é" with 0..1 appends the byte
// 0xC3, `from_utf8(s.as_bytes())` is false and chars() yields U+FFFD.
// Every other String mutator (drain, replace_range, split_off, truncate,
// insert, remove) asserts its boundaries. std's unsafe code relies on a
// String being UTF-8 (drain and retain read it with
// from_utf8_unchecked); probe e2.vl reaches a std panic "byte index 5 is
// out of bounds of a str of 3 bytes" from such a String.
// EXPECT: before
// EXIT: 101
fn main(gpa: Gpa) {
    let mut s = String::from_in("é", gpa);
    println("before");
    s.extend_from_within(0..1);
    println("{} {}", s.len(), std::str::from_utf8(s.as_bytes()).is_ok());
}
