// RT-308 (closed in 0.30.2): UNSOUND: a generic fn used as a value, `v.first().map(kb::<&i64>)`, whose bound `T: Keep` only `impl Keep for &'static i64` meets (or a `trait St: 'static` supertrait), is accepted with v's borrow: kb returns it as `&'static i64`, a use after free (0.30.2)
// rustc E0597 + E0505 for each (twin .rs.txt). The direct calls
// `kb(&v[0])` and `ks(&v[0])` are refused right (borrowck.dropped_borrowed),
// and a fn value whose own signature says 'static (`T: 'static`, `&'static`,
// `Wr<'static>`, `where 'a: 'static`) is borrowck.fn_value_static; that check
// reads the signature only, not the 'static that the bound's impl (or a
// supertrait) requires. --check-alloc: use after free, block #1 freed at
// line 45. A fixed check reports at the borrow, as for the direct call.
// FLAGS: --check-alloc
// ERROR: line 43
// ERROR: line 47
trait Keep {
    fn keep(self) -> &'static i64;
}

impl Keep for &'static i64 {
    fn keep(self) -> &'static i64 {
        self
    }
}

trait St: 'static {
    fn me(self) -> Self;
}

impl<T: 'static> St for T {
    fn me(self) -> Self {
        self
    }
}

fn kb<T: Keep>(x: T) -> &'static i64 {
    x.keep()
}

fn ks<T: St>(x: T) -> T {
    x.me()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let a: Option<&'static i64> = v.first().map(kb::<&i64>);
    drop(v);
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(3000);
    let c = u.first().map(ks::<&i64>);
    drop(u);
    println("{:?} {:?}", a, c);
}
