// sem-own: if let Some(d) = o moves d out; the None branch drops nothing.
// EXPECT: got 3
// EXPECT: drop 3
// EXPECT: none
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn f(o: Option<D<Gpa>>) {
    if let Some(d) = o { println("got {}", d.id); } else { println("none"); }
}

fn main(gpa: Gpa) {
    f(Some(mk(3, gpa)));
    f(None);
    println("end");
}
