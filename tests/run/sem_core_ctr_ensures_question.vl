// EDITION: rust
// ensures is checked on the return a `?` makes.
// EXPECT: 12
// EXIT: 101
// STDERR: ensures failed: 'result.is_ok()' of 'parse'
static mut Z: i64 = 0;

fn parse(s: &str) -> Result<i64, std::str::ParseIntError>
    ensures result.is_ok()
{
    let n = s.parse::<i64>()?;
    Ok(n)
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    println("{}", parse("12").unwrap());
    println("{}", parse("zz").is_ok());
    0
}
