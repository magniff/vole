// EDITION: rust
// (0.26.1) A cell in a let local, a var, a struct field and an array
// element, written through shared receivers.
// EXPECT: 3 4 5 6
use std::cell::Cell;

struct Pair { a: Cell<i64>, b: Cell<i64> }

fn main() {
    let c = Cell::new(1i64);
    c.set(3);
    let mut v = Cell::new(1i64);
    v.set(4);
    let p = Pair { a: Cell::new(0i64), b: Cell::new(0i64) };
    p.a.set(5);
    let arr = [Cell::new(0i64), Cell::new(0i64)];
    arr[1].set(6);
    println("{} {} {} {}", c.get(), v.get(), p.a.get(), arr[1].get());
}
