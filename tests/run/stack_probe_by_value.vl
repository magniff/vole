// (0.30.2, RT-83) Thread t1 (2 MiB stack) holds a 480 KB array and waits; t2
// (128 KiB stack) is mapped just above it, its 16 KiB guard page between
// them. The form: a 240 KB array passed by value, in the branch not taken:
// its copy (AArch64) or the outgoing argument area (x86-64, -O2) is in the
// caller's frame.
// v0.30.1 moved sp by the whole frame at once, past t2's stack and its guard
// page, which nothing touched, into t1's stack: t2 ran on, writing t1's
// array (`t1: canary sum before 46620000, after ...`, exit 0). Now every
// page of a frame of a page or more is written, top down, before sp is below
// it (gen0 a64_frame_reserve, x64_frame_reserve): t2 dies on its guard page, SIGBUS on
// macOS (exit 138), before anything is printed.
// REQUIRES: macos
// EXIT: 138
use std::thread;
use std::sync::atomic::{AtomicI64, Ordering};
use std::time::Duration;

static STAGE: AtomicI64 = AtomicI64::new(0);

#[inline(never)]
fn total(a: &[i64]) -> i64 {
    let mut t = 0;
    for x in a {
        t += *x;
    }
    t
}

// Writes 1 into a local array of 64 elements: its own frame, in safe code.
#[inline(never)]
fn fill() -> i64 {
    let mut a = [0i64; 64];
    for i in 0..64 {
        a[i] = 1;
    }
    total(&a)
}

#[inline(never)]
fn wait() {
    STAGE.store(1, Ordering::SeqCst);
    while STAGE.load(Ordering::SeqCst) < 2 {
        thread::sleep(Duration::from_millis(1));
    }
}

// Thread t1's 480 KB canary, on a 2 MiB stack, just below t2's guard page.
#[inline(never)]
fn hold() -> i64 {
    let canary = [777i64; 60000];
    let before = total(&canary);
    wait();
    let after = total(&canary);
    println("t1: canary sum before {before}, after {after}");
    0
}

#[inline(never)]
fn far() -> bool {
    STAGE.load(Ordering::SeqCst) > 5
}

// A large argument passed by value, in the branch not taken.
#[inline(never)]
fn take(a: [i64; 30000]) -> i64 {
    a[0] + a[29999] + fill()
}

#[inline(never)]
fn jump(b: Box<[i64; 30000], Gpa>) -> i64 {
    if far() {
        return take(*b);
    }
    fill()
}

fn run(b: Box<[i64; 30000], Gpa>) -> i64 {
    jump(b)
}

fn main(gpa: Gpa) {
    let h1 = thread::Builder::new().stack_size(2097152).spawn_in(move || hold(), gpa).unwrap();
    while STAGE.load(Ordering::SeqCst) < 1 {
        thread::sleep(Duration::from_millis(1));
    }
    let b: Box<[i64; 30000], Gpa> = Box::new_in([3i64; 30000], gpa);
    let h2 = thread::Builder::new().stack_size(131072).spawn_in(move || run(b), gpa).unwrap();
    let r2 = h2.join().unwrap();
    println("t2: {r2}");
    STAGE.store(2, Ordering::SeqCst);
    h1.join().unwrap();
}
