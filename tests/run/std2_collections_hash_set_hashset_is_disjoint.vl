// EDITION: rust
// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_set HashSet::is_disjoint.
// EXPECT: false true
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [2i64, 3].into_iter().collect_in(gpa);
    let c: HashSet<i64, Gpa> = [7i64].into_iter().collect_in(gpa);
    println("{} {}", a.is_disjoint(&b), a.is_disjoint(&c));
}
