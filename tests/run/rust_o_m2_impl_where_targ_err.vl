// ERROR: the trait 'Tr<u8>' is not implemented for 'W'
// (RT-269) an impl's `where i32: Conv<U>`, U fixed by the trait's argument only: Tr<i64> holds, Tr<u8> does not (rustc E0277; v0.30.1 accepted both).
trait Conv<X> {}

impl Conv<i64> for i32 {}

trait Tr<U> {
    fn f(&self) -> i64;
}

struct W {
    r: i64,
}

impl<U> Tr<U> for W
    where
        i32: Conv<U>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn need<V, T: Tr<V>>(t: &T) -> i64 {
    t.f()
}

fn main() {
    println("{}", need::<i64, W>(&W { r: 0 }));
    println("{}", need::<u8, W>(&W { r: 0 }));
}
