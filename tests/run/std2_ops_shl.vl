// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Shl.
// EXPECT: V { x: 48 }
use std::ops::Shl;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Shl for V {
    type Output = V;

    fn shl(self, rhs: V) -> V {
        V { x: self.x << rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 2 };
    println("{:?}", a << b);
}
