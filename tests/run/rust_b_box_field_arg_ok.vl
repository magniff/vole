// RULE: D2.7, D3.6
// (0.30.1) A `&mut` stored in a container, reborrowed where one goes (a
// call's argument, a `let` with its type): its path is made mutable,
// IndexMut and DerefMut, as rustc's is; a Box's needs no `let mut` (rustc's
// Box deref is built in), a Vec's and a user DerefMut's do. Before, the
// field argument of a Box needed `let mut b` (borrowck.borrow_immutable),
// `fill(vs[0])` and `let t: &mut [i64] = vs[0].s;` were reborrowed through
// the shared Index (borrow_immutable), as `let t = g.s;` through Deref.
// EXPECT: 9 9 2
// EXPECT: 2
// EXPECT: 5 2
// EXPECT: 5 6
use std::ops::{Deref, DerefMut};

struct W<'a> {
    s: &'a mut [i64],
}

struct P<'a> {
    p: &'a mut i64,
}

struct G<'b, 'a> {
    r: &'b mut W<'a>,
}

impl<'b, 'a> Deref for G<'b, 'a> {
    type Target = W<'a>;

    fn deref(&self) -> &W<'a> {
        self.r
    }
}

impl<'b, 'a> DerefMut for G<'b, 'a> {
    fn deref_mut(&mut self) -> &mut W<'a> {
        self.r
    }
}

fn fill(t: &mut [i64]) {
    t[0] = 9;
}

fn fillv(t: &mut [Vec<i64, Gpa>]) {
    t[0].push(2);
}

fn inc(t: &mut i64) {
    *t += 1;
}

fn main(gpa: Gpa) {
    let mut a1 = [1i64];
    let b = Box::new_in(W { s: &mut a1 }, gpa);
    fill(b.s);
    let mut a2 = [1i64];
    let bb = Box::new_in(Box::new_in(W { s: &mut a2 }, gpa), gpa);
    fill(bb.s);
    let mut x = 1i64;
    let bp = Box::new_in(P { p: &mut x }, gpa);
    inc(bp.p);
    println("{} {} {}", b.s[0], bb.s[0], *bp.p);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let mut arr = [v];
    let mut vs: Vec<&mut [Vec<i64, Gpa>], Gpa> = Vec::new_in(gpa);
    vs.push(&mut arr);
    fillv(vs[0]);
    println("{}", vs[0][0].len());
    let mut a3 = [1i64];
    let mut ws: Vec<W<'_>, Gpa> = Vec::new_in(gpa);
    ws.push(W { s: &mut a3 });
    let t: &mut [i64] = ws[0].s;
    t[0] = 5;
    let u: &mut [Vec<i64, Gpa>] = vs[0];
    u[0].push(3);
    println("{} {}", ws[0].s[0], vs[0][0].len() - 1);
    let mut a4 = [1i64, 2];
    let mut w = W { s: &mut a4 };
    let mut g = G { r: &mut w };
    let t2: &mut [i64] = g.s;
    t2[0] = 5;
    g.s[1] = 6;
    println("{} {}", g.s[0], g.s[1]);
}
