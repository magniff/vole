// EDITION: rust
// RULE: (for the fixer)
// (0.27.4, gate 3's hidden borrowck wall: borrowck/constraints.vl's
// `edge(bck.regs2[i], bck.regs2[i + 1], loc, bck)`) Two values copied out
// of index expressions, then the root itself as a `&mut` argument: rustc
// accepts it; vole keeps both temporaries live to the call (two
// conflicts), though it accepts the two-phase `bck.regs.push(bck.regs[0])`.
// EXPECT: 12 3
use std::alloc::Allocator;

struct Ctx<A: Allocator> {
    regs: Vec<i64, A>,
    n: i64,
}

fn edge(a: i64, b: i64, bck: &mut Ctx<Gpa>) {
    bck.n += a * 10 + b;
}

fn main(gpa: Gpa) {
    let mut c = Ctx { regs: Vec::new_in(gpa), n: 0 };
    c.regs.push(1);
    c.regs.push(2);
    let bck = &mut c;
    bck.regs.push(bck.regs[0] + bck.regs.len() as i64);
    edge(bck.regs[0], bck.regs[1], bck);
    println("{} {}", c.n, c.regs[2]);
}
