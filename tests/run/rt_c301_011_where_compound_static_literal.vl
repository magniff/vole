// XFAIL: RT-C301-11: a concrete type holding a reference is not taken as 'static under a where predicate, a literal's &'static str too (0.30.2)
// From the review: where Option<T>: 'static, T = &'static str (rustc ok)
// rustc accepts it.
// EXPECT: thread lit
// EXPECT: main XXXXXXXXXXXXXXXXXXXXXXX
use std::thread;
use std::fmt::Display;
use std::thread::JoinHandle;

fn f<T: Send + Display>(t: T, gpa: Gpa) -> JoinHandle<i64, Gpa> where Option<T>: 'static {
    thread::spawn_in(move || { println("thread {}", t); 0i64 }, gpa)
}

fn main(gpa: Gpa) {
    let h = { let st = String::from_in("hello heap string long", gpa); f("lit", gpa) };
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    h.join();
    println("main {}", w);
}
