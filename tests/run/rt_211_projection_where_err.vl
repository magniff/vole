// RT-211, a `where` predicate on a projection, `I::Item: PutInto<B>`, met by
// a pattern impl for `&'a T`, and a named lifetime through `I: Iterator<Item
// = &'a i64>`: each relates the result to the items (rustc E0505 at the
// drop). v0.30.1 kept only the second.
// ERROR: line 50
// ERROR-COUNT: 2
trait PutInto<B> {
    fn put_into(self, b: &mut B);
}

impl<'a, T> PutInto<Vec<&'a T, Gpa>> for &'a T {
    fn put_into(self, b: &mut Vec<&'a T, Gpa>) {
        b.push(self);
    }
}

trait Put<T> {
    fn put1(&mut self, t: T);
}

impl<T> Put<T> for Vec<T, Gpa> {
    fn put1(&mut self, t: T) {
        self.push(t);
    }
}

fn gather<I: Iterator, B>(it: I, mut b: B, c: B) -> (B, B)
    where I::Item: PutInto<B>,
{
    for x in it {
        x.put_into(&mut b);
    }
    (b, c)
}

fn named<'a, I: Iterator<Item = &'a i64>, T: Put<&'a i64>>(it: I, mut t: T, c: T) -> (T, T) {
    for x in it {
        t.put1(x);
    }
    (c, t)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let (a, _b): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = gather(v.iter(), Vec::new_in(gpa),
        Vec::new_in(gpa));
    let (_c, d): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = named(v.iter(), Vec::new_in(gpa),
        Vec::new_in(gpa));
    drop(v);
    println("{:?} {:?}", a, d);
}
