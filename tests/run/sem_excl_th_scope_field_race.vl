// EDITION: rust
// ERROR: sync
use std::thread;
#[derive(Clone, Copy)] struct S { n: i64 }
fn bump(n: &mut i64) { *n += 1; }

fn main() {
    let mut s = S { n: 0 };
    thread::scope(|s| ({ let sc = s; {
        let x = sc.spawn(|| { for i in 0..1000000 { bump(&mut s.n); } 0 });
        let y = sc.spawn(|| { for i in 0..1000000 { bump(&mut s.n); } 0 }); x.join().unwrap() + y.join().unwrap()
    } })); println("{}", s.n);
}
