// XFAIL: gap 2: compile alloc.no_in: 'std::thread::spawn' allocates from nothing: pass the allocator, last, to 'std::thread...
// (0.21) With exclusive-pair loops (--atomics=llsc): litmus SB (store buffering), SeqCst: in each round one thread
// FLAGS: --atomics=llsc
// stores X = 1 and loads Y, the other stores Y = 1 and loads X; both
// loads 0 is forbidden for SeqCst (allowed with Release/Acquire). 20000
// rounds, started together by a round counter.
// (0.25) The waits yield after 256 turns: spinning alone, 30 copies of the
// test at once took up to 80 s (the suite's limit is 20 s).
// EXPECT: sb ok

use std::thread;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

static X: AtomicI64 = AtomicI64::new(0i64);
static Y: AtomicI64 = AtomicI64::new(0i64);
static ROUND: AtomicI64 = AtomicI64::new(0i64);
static DONE: AtomicI64 = AtomicI64::new(0i64);
static R1: AtomicI64 = AtomicI64::new(0i64);
static R2: AtomicI64 = AtomicI64::new(0i64);

const N: i64 = 20000;

fn main() {
    let a = thread::spawn(move || {
        for r in 1..N + 1 {
            let mut spins: i64 = 0;
            while ROUND.load(Ordering::Acquire) < r {
                spins += 1;
                if spins % 256 == 0 {
                    thread::yield_now();
                }
            }
            X.store(1, Ordering::SeqCst);
            R1.store(Y.load(Ordering::SeqCst), Ordering::Relaxed);
            DONE.fetch_add(1, Ordering::AcqRel);
        }
        0
    });
    let b = thread::spawn(move || {
        for r in 1..N + 1 {
            let mut spins: i64 = 0;
            while ROUND.load(Ordering::Acquire) < r {
                spins += 1;
                if spins % 256 == 0 {
                    thread::yield_now();
                }
            }
            Y.store(1, Ordering::SeqCst);
            R2.store(X.load(Ordering::SeqCst), Ordering::Relaxed);
            DONE.fetch_add(1, Ordering::AcqRel);
        }
        0
    });
    let mut bad: i64 = 0;
    for r in 1..N + 1 {
        X.store(0, Ordering::Relaxed);
        Y.store(0, Ordering::Relaxed);
        ROUND.store(r, Ordering::Release);
        let mut spins: i64 = 0;
        while DONE.load(Ordering::Acquire) < 2 * r {
            spins += 1;
            if spins % 256 == 0 {
                thread::yield_now();
            }
        }
        if R1.load(Ordering::Relaxed) == 0 && R2.load(Ordering::Relaxed) == 0 { bad += 1; }
    }
    a.join().unwrap();
    b.join().unwrap();
    println("{}", if bad == 0 { "sb ok" } else { "sb FORBIDDEN outcome seen" });
}
