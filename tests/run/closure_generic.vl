// XFAIL: gap 3: compile closure.sig: type mismatch in closure arguments: this parameter is written 'i64', but the bound of...
// 0.14: closures and generics: a closure in a generic instance, the
// result type inferred from the closure (or a function passed for F),
// pointer parameters from the bound, a generic struct holding a closure.
// EXPECT: 30 4
// EXPECT: 1 8
// EXPECT: 9 3
// EXPECT: 42
fn sum_by<T, F: Fn(&T) -> i64>(s: &[T], f: F) -> i64 {
    let mut t: i64 = 0;
    for &x in s {
        t += f(x);
    }
    t
}

fn scaled<T>(s: &[T], k: i64) -> i64 {
    sum_by(s, |x: T| k * 2)
}

fn map_one<A, B, F: FnMut(&A) -> B>(x: A, f: F) -> B {
    f(x)
}

fn pick<T, F: FnMut(&T, &T) -> bool>(a: T, b: T, better: F) -> T {
    if better(&a, &b) { a } else { b }
}

fn double(x: i64) -> i64 {
    x * 2
}

#[derive(Clone, Copy)] struct Op<F: Fn(i64) -> i64> {
    f: F,
    x: i64,
}

fn main() -> i64 {
    let arr = [1i64, 2, 3];
    print("{}", scaled(&arr[0..3], 5i64));
    print(" ");
    print("{}", scaled(&[true, false][0..2], 1i64));
    println("");
    let big = map_one(3i64, |x| x * 1000 == 3000);
    print("{}", (if big { 1 } else { 0 }));
    print(" ");
    print("{}", map_one(4i64, double));
    println("");
    print("{}", pick(3i64, 9i64, |a, b| a > b));
    print(" ");
    print("{}", pick(3i64, 9i64, |a, b| a < b));
    println("");
    let k: i64 = 40;
    let op = Op { f: |x| x + k, x: 2 };
    print("{}", (op.f)(op.x));
    println("");
    0
}
