// RULE: D2.9
// (0.30.1) A comparison's hidden borrows end with the comparison, as
// rustc's PartialEq borrows do: the place compared may be written in the
// branch or the loop body it decides (`if s == t { s.clear() }`, `while
// s != t { s.push(..) }`).
// EXPECT: 0
// EXPECT: aaa
use std::alloc::Allocator;

fn grow<A: Allocator>(s: &mut String<A>, t: &String<A>) {
    while *s != *t {
        s.push('a');
    }
}

fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    let t = String::from_in("abc", gpa);
    if s == t {
        s.clear();
    }
    println("{}", s.len());
    let goal = String::from_in("aaa", gpa);
    let mut u = String::new_in(gpa);
    while u != goal {
        u.push('a');
    }
    grow(&mut s, &goal);
    println("{}", u);
}
