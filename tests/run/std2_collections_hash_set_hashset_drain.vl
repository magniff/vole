// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set HashSet::drain.
// EXPECT: [1, 2] 0
use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(2);
    s.insert(1);
    let mut v: Vec<i64, Gpa> = s.drain().collect_in(gpa);
    v.sort();
    println("{:?} {}", v, s.len());
}
