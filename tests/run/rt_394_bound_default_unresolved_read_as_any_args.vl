// RT-394, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig-m2 (form f270x). Since v0.30.1 at least;
// the release build the same. rustc E0277 at the signature of c, at its
// body's call and at main's call (the rustc twin of this file): the
// default is `<Z as H>::Out`, which needs `Z: H`. Sub-forms: rt_394b (the
// same with no call in the body), rt_394c (a parameter with no default
// and none written, E0107).
// ERROR: line 28
// ERROR: line 33
trait H {
    type Out;
}

trait Sub<U = <Self as H>::Out> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Sub<i64> for W {
    fn g(&self) -> i64 {
        7
    }
}

fn c<Z: Sub>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", c(&W { r: 0 }));
}
