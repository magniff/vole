// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::borrow Borrow.
// EXPECT: 3 3
use std::borrow::Borrow;
use std::string::String;

fn len_of<B: Borrow<str>>(b: B) -> usize {
    b.borrow().len()
}

fn main(gpa: Gpa) {
    println("{} {}", len_of("abc"), len_of(String::from_in("xyz", gpa)));
}
