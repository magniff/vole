// A `<<` after an `unsafe { .. }` operand, then a cast: a shift, not a qualified path (rustc `20 1`)
// From the re-review of the qualified paths in fmt: fmt marked a `<` or `<<` after a `}` that ends an operand as type arguments when `NAME as` followed, removed its space and indented every later line of the block one level deeper. fmt keeps this file as written (tests/fmt/run.sh tree), and it prints rustc's line.
// EXPECT: 20 1
fn main() {
    let a: i64 = 5;
    let b: u32 = 2;
    let c = unsafe { a } << b as i64;
    let d = 1;
    println("{} {}", c, d);
}
