// 0.30.1, a pin (0.30.0 passes it too): an extern named `exit` that links
// to a function of the program that returns is not C's exit: it does not
// diverge (front::effects knew C's functions by their symbols already),
// and a panic still exits through C's exit whatever the program names its
// externs.
// CSOURCE: tests/c/c_symbol_identity.c
// EXIT: 101
// EXPECT: after exit, exits 1
// STDERR: called `Option::unwrap()` on a `None` value
extern "C" {
    #[link_name = "csi_exit"]
    fn exit(code: i32);
    fn csi_exits() -> i64;
}

#[inline(never)]
fn none(n: i64) -> Option<i64> {
    if n > 100 { Option::Some(n) } else { Option::None }
}

fn main() {
    // UNSAFE: the program's C function.
    // SAFETY: it takes any code and returns.
    unsafe {
        exit(3);
    }
    // UNSAFE: the program's C function.
    // SAFETY: it reads a counter.
    println("after exit, exits {}", unsafe { csi_exits() });
    let v = none(1).unwrap();
    println("not reached {v}");
}
