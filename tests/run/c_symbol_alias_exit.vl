// 0.30.1: an extern named `exit` that links to a function of the program
// that returns is not C's exit: it does not diverge (front::effects knew
// C's functions by their symbols already; this pins it), and the
// compiler's own exit (a panic's, gen0's runtime at -O0) is C's whatever
// the program names its externs (gen0::target::emit_symbol_ref renamed
// every symbol of the text `exit` by the program's #[link_name] before).
// CSOURCE: tests/c/c_symbol_identity.c
// EXIT: 101
// EXPECT: after exit, exits 1
// STDERR: called `Option::unwrap()` on a `None` value
extern "C" {
    #[link_name = "csi_exit"]
    fn exit(code: i32);
    fn csi_exits() -> i64;
}

#[inline(never)]
fn none(n: i64) -> Option<i64> {
    if n > 100 { Option::Some(n) } else { Option::None }
}

fn main() {
    // UNSAFE: the program's C function.
    // SAFETY: it takes any code and returns.
    unsafe {
        exit(3);
    }
    // UNSAFE: the program's C function.
    // SAFETY: it reads a counter.
    println("after exit, exits {}", unsafe { csi_exits() });
    let v = none(1).unwrap();
    println("not reached {v}");
}
