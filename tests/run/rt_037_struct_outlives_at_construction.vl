// RT-37 A struct's declared outlives (`'b: 'c` inline or in a `where`)
// and the outlives its fields imply are not proven where a value of it is
// built: rustc refuses this literal (E0597, `st` does not live long
// enough for 'c), vole accepts it. No rule trusts them since review 7
// (the Drop rule refused them, a call of a function or method of the type
// requires them), so no use after free is known; the proof belongs to the
// obligation engine's well-formedness at every construction (0.30.2).
// Before review 7 the Drop rule trusted them: with `impl<'o, 'b: 'c, 'c,
// A> Drop for S` pushing `self.s` into `out`, --check-alloc reported "use
// after free: block #1 (22 bytes)" (review 7's h10). That impl is refused
// now (rust_f_drop_impl_outlives_err); a method or a function of S, and a
// trait impl reached through a bound, require 'b: 'c at the call.
// XFAIL: RT-37: a struct's declared outlives are not proven where a value is built (0.30.2)
// ERROR: borrowck.dropped_borrowed
// ERROR-COUNT: 1
use std::alloc::Allocator;

struct S<'o, 'b: 'c, 'c, A: Allocator> { out: &'o mut Vec<&'c str, A>, s: &'b str }

struct T<'o, 'b, 'c, A: Allocator> where 'b: 'c { out: &'o mut Vec<&'c str, A>, s: &'b str }

fn main(gpa: Gpa) {
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    {
        let st = String::from_in("hello heap string long", gpa);
        let x = S { out: &mut v, s: st.as_str() };
    }
    v.push("y");
    println("{}", v.len());
}
