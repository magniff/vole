// RT-37 A struct's declared outlives (`'b: 'c`) are not proven where a
// value of it is built, and a function of the type taken as a value does
// not require them at its call: `g` assumes 'b: 'c of its parameter, the
// call through `f` checks nothing of it, and `y.s`, a dropped String's
// str, is kept in `v` (review 8's m01; also a method as a value, m02,
// m04; every build). --check-alloc: "use after free: block #1 (22
// bytes), allocated at 24:18, freed at 27:5". rustc refuses the literal
// (E0597: `st` does not live long enough for 'c). The obligation engine
// proves a type's predicates at every construction (0.30.2). (A Drop impl
// may not assume them since review 7; a direct call requires them.)
// XFAIL: RT-37: a struct's declared outlives are not proven where a value is built (0.30.2)
// FLAGS: --check-alloc
// ERROR: borrowck.dropped_borrowed
// ERROR-COUNT: 1
struct S<'o, 'b: 'c, 'c> { out: &'o mut Option<&'c str>, s: &'b str }

fn g<'o, 'b, 'c>(y: S<'o, 'b, 'c>) {
    y.out.replace(y.s);
}

fn main(gpa: Gpa) {
    let mut v: Option<&str> = None;
    {
        let st = String::from_in("hello heap string long", gpa);
        let f = g;
        f(S { out: &mut v, s: st.as_str() });
    }
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", v.unwrap(), w);
}
