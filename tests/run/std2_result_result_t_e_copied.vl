// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result<&T, E>::copied.
// EXPECT: Ok(5) Err("bad")
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let five = 5;
    let c: Result<&i64, &str> = Ok(&five);
    let d: Result<&i64, &str> = Err("bad");
    println("{:?} {:?}", c.copied(), d.copied());
}
