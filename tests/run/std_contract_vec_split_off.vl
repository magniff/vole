// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): Vec::split_off's `requires at <= self.len()`, violated last.
// EXPECT: [1] [2, 3]
// EXIT: 101
// STDERR: requires failed: 'at <= self.len()'
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::from_in([1, 2, 3], gpa);
    let w = v.split_off(1);
    println("{:?} {:?}", v, w);
    let x = v.split_off(4);
}
