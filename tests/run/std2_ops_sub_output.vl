// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Sub::Output.
// EXPECT: V { x: 7 }
use std::ops::Sub;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Sub for V {
    type Output = V;

    fn sub(self, rhs: V) -> V {
        V { x: self.x - rhs.x }
    }
}

fn apply<T: Sub<Output = T>>(a: T, b: T) -> T {
    a - b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    let c: <V as Sub>::Output = apply(a, b);
    println("{:?}", c);
}
