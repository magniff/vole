// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::io BufReader.
// EXPECT: [1, 2, 3]
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    b.read_to_end(&mut v).unwrap();
    println("{:?}", v);
}
