// The std2 item(s): std::collections::hash_map HashMap::insert.
// EXPECT: None Some(1) Some(2) 1
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let a = m.insert(7, 1);
    let b = m.insert(7, 2);
    println("{:?} {:?} {:?} {}", a, b, m.get(&7), m.len());
}
