// EDITION: rust
// XFAIL: gap 17: compile effect: 'std::mem::drop' is #[effects(T)], but it allocates from C (malloc) (--check-alloc and a Sender moved to a thread)
// owned values moved through a channel: each dropped once; a failed send gives the value back
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: sum 6
use std::thread;
use std::sync::mpsc;
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<R, Gpa>(gpa);
    let h = thread::spawn_in(move || {
        for i in 1..=3 { tx.send(R { id: i }).ok().unwrap(); }
        0
    }, gpa);
    h.join().unwrap();
    let mut sum: i64 = 0;
    for r in rx.iter() { sum += r.id; }
    println("sum {sum}");
}
