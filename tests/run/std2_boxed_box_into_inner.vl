// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::into_inner.
// EXPECT: 8 abc
// RUSTC: none (Box::into_inner is unstable in Rust, which moves out with *b)
use std::boxed::Box;
use std::string::String;

fn main(gpa: Gpa) {
    let b = Box::new_in(8i64, gpa);
    let s = Box::new_in(String::from_in("abc", gpa), gpa);
    let x: i64 = Box::into_inner(b);
    let t: String<Gpa> = Box::into_inner(s);
    println("{} {}", x, t);
}
