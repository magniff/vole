// `need(y)`, `Z: T0`, from `Y: T11`: the bound holds through 12 supertraits (opaque::entails cut at 8 and read it as no; v0.30.1: "the trait 'T0' is not implemented for 'Y'"; rustc 8)
// From the re-review of the qualified paths (RT-360, RT-353): fails on v0.30.1.
// EXPECT: 8
trait T0 {
    const K: i64;
    type Out;
    fn top(&self) -> i64;
}

trait T1: T0 {}

trait T2: T1 {}

trait T3: T2 {}

trait T4: T3 {}

trait T5: T4 {}

trait T6: T5 {}

trait T7: T6 {}

trait T8: T7 {}

trait T9: T8 {}

trait T10: T9 {}

trait T11: T10 {}

struct S;

impl T0 for S {
    const K: i64 = 5;
    type Out = i64;

    fn top(&self) -> i64 {
        3
    }
}

impl T1 for S {}

impl T2 for S {}

impl T3 for S {}

impl T4 for S {}

impl T5 for S {}

impl T6 for S {}

impl T7 for S {}

impl T8 for S {}

impl T9 for S {}

impl T10 for S {}

impl T11 for S {}

fn need<Z: T0>(z: &Z) -> i64 {
    z.top() + Z::K
}

fn k<Y: T11>(y: &Y) -> i64 {
    need(y)
}

fn main() {
    println("{}", k(&S));
}
