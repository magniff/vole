// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::collections::hash_map HashMap::get_key_value.
// EXPECT: Some(("a", 1)) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<String<Gpa>, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert("a".to_string_in(gpa), 1);
    println("{:?} {:?}", m.get_key_value("a"), m.get_key_value("b"));
}
