// RT-211, std's forms: a partition_in result bound without a pattern and
// reborrowed, then a push (E0502); unzip_in of `(i64, &i64)` items, then a
// clear (E0502); a HashMap of borrows unzipped, then the drop (E0505).
// v0.30.1 built it.
// ERROR: line 17
// ERROR: line 20
// ERROR: line 25
// ERROR-COUNT: 3
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let p: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = v.iter().partition_in(|x| **x > 1, gpa);
    let r = &p.0;
    v.push(3);
    println("{:?}", r);
    let (k, q): (Vec<i64, Gpa>, Vec<&i64, Gpa>) = v.iter().map(|e| (*e, e)).unzip_in(gpa);
    v.clear();
    println("{:?} {:?}", k, q);
    let mut h: HashMap<i64, &i64, Gpa, FixedState> = HashMap::new_in(gpa);
    h.insert(1, &v[0]);
    let (hk, hv): (Vec<i64, Gpa>, Vec<&i64, Gpa>) = h.into_iter().unzip_in(gpa);
    drop(v);
    println("{:?} {:?}", hk, hv);
}
