// XFAIL: `m.get(&(1, 2))` with K = (i64, i64): the literals are typed i32 before K is known, 'Borrow<(i32, i32)>' is not implemented for '(i64, i64)' (0.30.0 too; 0.30.2)
// rustc infers the tuple's literals from HashMap::get's `K: Borrow<Q>`
// with the map's K; vole types `(1, 2)` as (i32, i32) first.
// EXPECT: 3
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<(i64, i64), i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert((1, 2), 3);
    match m.get(&(1, 2)) {
        Some(v) => println("{}", *v),
        None => println("none"),
    }
}
