// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::fmt LowerExp::fmt.
// EXPECT: 1.2345e3
use std::fmt::{Formatter, LowerExp};

struct W {
    v: f64,
}

impl LowerExp for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = LowerExp::fmt(&W { v: 1234.5f64 }, &mut f);
    println("{}", s);
}
