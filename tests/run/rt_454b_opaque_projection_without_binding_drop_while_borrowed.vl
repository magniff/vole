// XFAIL: RT-454b: (RT-454's mechanism, the borrow it must keep) `pick(mk(&v), &k)` with `fn pick<S: Src>(s: S, k: &i64) -> S::It` and mk returning `impl Src + 'a` over `&'a Vec<String>`, then `drop(v)` while the result lives: rustc E0505 at the drop; vole refuses the program earlier, "'impl Src + 'a' has no associated type 'It'" (0.30.2)
// From the re-review of g302bor2 (its form t07_opaque_no_binding_uaf).
// Since v0.30.1 at least. A fix of RT-454 that accepts it must refuse
// the drop, as RT-387 does for a projection read as borrowing k only.
// FLAGS: --check-alloc
// ERROR: line 36
use std::fmt::Debug;

trait Src {
    type It: Debug;
    fn get(self) -> Self::It;
}

impl<'a> Src for &'a Vec<String<Gpa>, Gpa> {
    type It = &'a String<Gpa>;

    fn get(self) -> &'a String<Gpa> {
        &self[0]
    }
}

fn mk<'a>(v: &'a Vec<String<Gpa>, Gpa>) -> impl Src + 'a {
    v
}

fn pick<S: Src>(s: S, k: &i64) -> S::It {
    let _ = k;
    s.get()
}

fn main(gpa: Gpa) {
    let k = 5i64;
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello heap string long", gpa));
    let p = pick(mk(&v), &k);
    drop(v);
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{:?} {}", p, other.len());
}
