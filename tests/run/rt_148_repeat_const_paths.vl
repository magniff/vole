// FLAGS: --check-alloc
// RULE: F35.2 (0.30.2, RT-148) `[C; N]` of a constant whatever path names
// it: a trait's associated constant through a type parameter (`T::ZERO`,
// in a generic function, an impl's method, one never called), an
// inherent one (`D::ONE`), a qualified path (`<D as Z>::ZERO`), a free
// constant in a generic body; each element made from it. Every resolver's
// use is marked in one place (names.vl const_use), so `T::ZERO`, refused
// before, is a constant too. The output is rustc's.
// EXPECT: a 2
// EXPECT: b 0
// EXPECT: c 1
// EXPECT: d 2
// EXPECT: e 2 5
// EXPECT: w 3
// EXPECT: drop 2
// EXPECT: drop 2
// EXPECT: drop 0
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: drop 1
// EXPECT: drop 0
// EXPECT: drop 0
// EXPECT: drop 0
// EXPECT: drop 0
// EXPECT: drop 0
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

trait Z {
    const ZERO: Self;
}

impl Z for D {
    const ZERO: D = D { k: 0 };
}

impl D {
    const ONE: D = D { k: 1 };
}

const TWO: D = D { k: 2 };

struct W<T> {
    t: T,
}

impl<T: Z> W<T> {
    fn f() -> [T; 3] {
        [T::ZERO; 3]
    }
}

fn rep<T: Z>() -> [T; 2] {
    [T::ZERO; 2]
}

fn never<T: Z>() -> [T; 4] {
    [T::ZERO; 4]
}

fn free<T>(t: T) -> ([D; 2], T) {
    ([TWO; 2], t)
}

fn main() {
    let a = rep::<D>();
    println("a {}", a.len());
    let b = W::<D>::f();
    println("b {}", b[2].k);
    let c = [D::ONE; 2];
    println("c {}", c[1].k);
    let d = [<D as Z>::ZERO; 2];
    println("d {}", d.len());
    let (e, n) = free(5i64);
    println("e {} {}", e[0].k, n);
    let w = W { t: 3i64 };
    println("w {}", w.t);
}
