// RULE: C3.4
// (0.30.2, the re-review of g302holes: ov/s02_impl_trait_param)
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
// An impl Trait parameter; the clause iterates an Option parameter.
fn f(it: impl Iterator<Item = i64>, o: Option<i64>) -> i64
    requires o.iter().all(|x| *x > 0)
{
    it.sum()
}

fn main() {
    let a = [1i64, 2];
    println("{}", f(a.iter().copied(), Some(1)));
}
