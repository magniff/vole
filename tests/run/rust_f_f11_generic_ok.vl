// RULE: F11.1
// A generic impl's associated type meets the declared bound through
// the impl parameter's own bound.
// EXPECT: 5
trait Show {
    fn show(&self) -> i64;
}

trait Src {
    type Item: Show;
    fn first(&self) -> i64;
}

struct W<T> {
    x: T,
}

struct S {
    n: i64,
}

impl Show for S {
    fn show(&self) -> i64 {
        self.n
    }
}

impl<T: Show> Src for W<T> {
    type Item = T;

    fn first(&self) -> i64 {
        self.x.show()
    }
}

fn main() {
    let w = W { x: S { n: 5 } };
    println("{}", w.first());
}
