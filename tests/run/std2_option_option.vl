// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::option Option.
// EXPECT: Some(3) None
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b: Option<i64> = None;
    match a {
        Some(x) => println("{:?} {:?}", Some(x), b),
        None => println("none"),
    }
}
