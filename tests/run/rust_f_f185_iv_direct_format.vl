// RULE: F18.5
// (0.30.2) A hole of println of an integer variable leaves it free: its
// write is made with the type the variable has at the function's end,
// here i64 from `take(d + d)`.
// EXPECT: 2000000000
// EXPECT: 4000000000
// EXPECT: 300 300
fn take(x: i64) -> i64 {
    x
}

fn take_u16(x: u16) -> u16 {
    x
}

fn main() {
    let d = 2000000000;
    println("{d}");
    println("{}", take(d + d));
    let e = 300;
    println("{e} {:?}", e);
    take_u16(e);
}
