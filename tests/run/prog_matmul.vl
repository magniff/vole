// EDITION: rust
// Integer and floating-point matrix multiplication with 2D arrays.
// EXPECT: 70 50 10 -50 | 0.307417
// EXPECT: 150 98 -6 -162 | 1.016333
// EXPECT: 230 146 -22 -274 | 2.656677
// EXPECT: 310 194 -38 -386 | 12.095238
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn main() -> i64 {
    let mut a: [[i64; 4]; 4] = [[0i64; 4]; 4];
    let mut b: [[i64; 4]; 4] = [[0i64; 4]; 4];
    let mut c: [[i64; 4]; 4] = [[0i64; 4]; 4];
    let mut f: [[f64; 4]; 4] = [[0.0; 4]; 4];
    let mut i: i64 = 0;
    while i != 4 {
        let mut j: i64 = 0;
        while j != 4 {
            a[i as usize][j as usize] = i * 4 + j + 1;
            b[i as usize][j as usize] = (i - j) * (i + j + 1);
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i != 4 {
        let mut j: i64 = 0;
        while j != 4 {
            let mut k: i64 = 0;
            let mut s: i64 = 0;
            let mut fs: f64 = 0.0;
            while k != 4 {
                s += a[i as usize][k as usize] * b[k as usize][j as usize];
                fs += a[i as usize][k as usize] as f64 * 0.5 / (
                    b[k as usize][j as usize] as f64 + 10.5);
                k += 1;
            }
            c[i as usize][j as usize] = s;
            f[i as usize][j as usize] = fs;
            j += 1;
        }
        i += 1;
    }
    i = 0;
    while i != 4 {
        unsafe {
            printf(c"%ld %ld %ld %ld | %.6f\n", c[i as usize][0], c[i as usize][1],
                c[i as usize][2], c[i as usize][3], f[i as usize][i as usize]);
        }
        i += 1;
    }
    0
}
