// (0.29.0) `while let`: the scrutinee's temporaries, and what the pattern
// leaves of its value, are dropped at the end of each iteration (after
// the body's locals), on `continue` and `break` too, and before the code
// after the loop when the pattern does not match. The same in every
// edition of rustc, and the output is rustc 2024's (tools/rustc-twin.sh).
// RUSTC-EDITION: 2024
// EXPECT: count 4
// EXPECT: body 7 24
// EXPECT: d24
// EXPECT: d14
// EXPECT: body 6 23
// EXPECT: d23
// EXPECT: d13
// EXPECT: d12
// EXPECT: after
// EXPECT: count 1
// EXPECT: d11
// EXPECT: after
// EXPECT: stop 7
// EXPECT: continue
// EXPECT: d37
// EXPECT: body 36
// EXPECT: d36
// EXPECT: body 35
// EXPECT: d35
// EXPECT: break
// EXPECT: d34
// EXPECT: after
// EXPECT: stop 3
// EXPECT: body 33
// EXPECT: d33
// EXPECT: d32
// EXPECT: after
struct T {
    id: i64,
    v: i64,
}

fn mk(id: i64, v: i64) -> T {
    T { id: id, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn big(t: &T) -> Option<i64> {
    if t.v > 5 { Some(t.v) } else { None }
}

fn own(t: T) -> Result<T, T> {
    if t.v > 5 { Ok(t) } else { Err(t) }
}

fn count(mut i: i64) {
    println("count {i}");
    while let Some(n) = big(&mk(10 + i, i + 3)) {
        let l = mk(20 + i, 0);
        println("body {n} {}", l.id);
        i -= 1;
    }
    println("after");
}

fn stop(mut i: i64) {
    println("stop {i}");
    while let Ok(t) = own(mk(30 + i, i + 3)) {
        if i == 4 {
            println("break");
            break;
        }
        i -= 1;
        if i == 6 {
            println("continue");
            continue;
        }
        println("body {}", t.id);
    }
    println("after");
}

fn main() -> i32 {
    count(4);
    count(1);
    stop(7);
    stop(3);
    0
}
