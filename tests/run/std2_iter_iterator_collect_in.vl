// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter Iterator::collect_in.
// EXPECT: [1, 2, 3, 4] cba

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().collect_in(gpa);
    let s: String<Gpa> = "abc".chars().rev().collect_in(gpa);
    println("{:?} {}", a, s);
}
