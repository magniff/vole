// Runs on std since 0.27.2's switch.
// The std item(s): std::str str::strip_prefix.
// EXPECT: Some("bar") Some("foo:bar") None
use std::str::CharIndices;

fn main() {
    println("{:?} {:?} {:?}", "foo:bar".strip_prefix("foo:"), "foo:bar".strip_prefix(""),
        "foo:bar".strip_prefix("bar"));
}
