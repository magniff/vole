// 0.26.0: Gpa's private field `_private: ()` is zero-sized: Gpa stays size
// 0 and alignment 1, and a Vec on it three words (main's implicit
// `Gpa {}` compiles with the field).
// EXPECT: 0 1 24 8 24 8
fn main(gpa: Gpa) {
    var v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println(
        f"{size_of(Gpa)} {align_of(Gpa)} {size_of(Vec<u8, Gpa>)} {align_of(Vec<u8, Gpa>)} {size_of(Vec<i64>)} {align_of(Vec<i64>)}");
}
