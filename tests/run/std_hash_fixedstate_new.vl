// Runs on std since 0.27.2's switch.
// The std item(s): std::hash FixedState::new.
// EXPECT: 11372875485421594496
// EXPECT: 589684135938649225
// RUSTC: none (FixedState is foldhash's (the foldhash crate's FixedState, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{BuildHasher, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let mut h = FixedState::new().build_hasher();
    h.write_u64(5);
    println("{}", h.finish());
    println("{}", FixedState::new().hash_one(()));
}
