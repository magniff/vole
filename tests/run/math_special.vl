// std::math (0.25.2.1): the special values, bit for bit (the sign of a
// zero too): NaN, +-0, +-inf, subnormals and each domain's edges, C99's
// Annex F and Rust's semantics; the constants of f32 and f64.
// EXPECT: math special: ok

use std::math;
use std::num::{f32_to_bits, f64_from_bits, f64_to_bits};

struct Count { failed: i64 }

fn same(c: inout Count, what: [u8], got: f64, want: f64) {
    if got != got && want != want {
        return;
    }
    if f64_to_bits(got) != f64_to_bits(want) {
        println("{what}: {got:?}, want {want:?}");
        c.failed += 1;
    }
}

fn same32(c: inout Count, what: [u8], got: f32, want: f32) {
    if got != got && want != want {
        return;
    }
    if f32_to_bits(got) != f32_to_bits(want) {
        println("{what}: {got:?}, want {want:?}");
        c.failed += 1;
    }
}

fn yes(c: inout Count, what: [u8], b: bool) {
    if !b {
        println("{what}: false");
        c.failed += 1;
    }
}

fn main() -> i32 {
    var c = Count { failed: 0 };
    let inf = f64::INFINITY;
    let ninf = f64::NEG_INFINITY;
    let nan = f64::NAN;
    let tiny = f64_from_bits(1);
    let pi = f64::consts::PI;
    // constants
    yes(&c, "f64::EPSILON", f64_to_bits(f64::EPSILON) == 0x3cb0000000000000);
    yes(&c, "f64::MAX", f64_to_bits(f64::MAX) == 0x7fefffffffffffff);
    yes(&c, "f64::MIN", f64_to_bits(f64::MIN) == 0xffefffffffffffff);
    yes(&c, "f64::MIN_POSITIVE", f64_to_bits(f64::MIN_POSITIVE) == 0x0010000000000000);
    yes(&c, "f64::NAN", nan != nan);
    yes(&c, "f64::consts::E", f64_to_bits(f64::consts::E) == 0x4005bf0a8b145769);
    yes(&c, "f64::consts::TAU", f64::consts::TAU == 2.0 * pi);
    yes(&c, "std::f64::consts::SQRT_2", std::f64::consts::SQRT_2 == 1.4142135623730951);
    yes(&c, "math::PI", math::PI == pi && math::LN_2 == f64::consts::LN_2);
    yes(&c, "f32::EPSILON", f32_to_bits(f32::EPSILON) == 0x34000000);
    yes(&c, "f32::MAX", f32_to_bits(f32::MAX) == 0x7f7fffff);
    yes(&c, "f32::MIN", f32_to_bits(f32::MIN) == 0xff7fffff);
    yes(&c, "f32::MIN_POSITIVE", f32_to_bits(f32::MIN_POSITIVE) == 0x00800000);
    yes(&c, "f32::INFINITY", f32_to_bits(f32::INFINITY) == 0x7f800000);
    yes(&c, "f32::NEG_INFINITY", f32_to_bits(f32::NEG_INFINITY) == 0xff800000);
    yes(&c, "f32::consts::PI", f32_to_bits(f32::consts::PI) == 0x40490fdb);
    yes(&c, "f32::consts::E", f32_to_bits(f32::consts::E) == 0x402df854);
    yes(&c, "f32::consts::FRAC_1_SQRT_2", f32_to_bits(f32::consts::FRAC_1_SQRT_2) == 0x3f3504f3);
    // sqrt
    same(&c, "sqrt(+0)", (0.0).sqrt(), 0.0);
    same(&c, "sqrt(-0)", (-0.0).sqrt(), -0.0);
    same(&c, "sqrt(inf)", inf.sqrt(), inf);
    same(&c, "sqrt(-inf)", ninf.sqrt(), nan);
    same(&c, "sqrt(-1)", (-1.0).sqrt(), nan);
    same(&c, "sqrt(nan)", nan.sqrt(), nan);
    same(&c, "sqrt(4)", (4.0).sqrt(), 2.0);
    same(&c, "sqrt(2^-1074)", tiny.sqrt(), f64_from_bits(0x1e60000000000000));
    same(&c, "sqrt(MAX)", f64::MAX.sqrt(), 1.3407807929942596e154);
    same(&c, "sqrt(2^-1022 - ulp)", f64_from_bits(0x000fffffffffffff).sqrt(),
        1.4916681462400412e-154);
    // cbrt
    same(&c, "cbrt(-0)", (-0.0).cbrt(), -0.0);
    same(&c, "cbrt(-inf)", ninf.cbrt(), ninf);
    same(&c, "cbrt(-8)", (-8.0).cbrt(), -2.0);
    same(&c, "cbrt(27)", (27.0).cbrt(), 3.0);
    same(&c, "cbrt(2^-1074)", tiny.cbrt(), f64_from_bits(0x2990000000000000));
    // hypot
    same(&c, "hypot(3, 4)", (3.0).hypot(4.0), 5.0);
    same(&c, "hypot(-0, -0)", (-0.0).hypot(-0.0), 0.0);
    same(&c, "hypot(inf, nan)", inf.hypot(nan), inf);
    same(&c, "hypot(nan, -inf)", nan.hypot(ninf), inf);
    same(&c, "hypot(nan, 1)", nan.hypot(1.0), nan);
    same(&c, "hypot(MAX, MAX)", f64::MAX.hypot(f64::MAX), inf);
    same(&c, "hypot(1e300, 1e300)", (1e300).hypot(1e300), 1.4142135623730952e300);
    same(&c, "hypot(tiny, tiny)", tiny.hypot(tiny), tiny);
    // sin, cos, tan
    same(&c, "sin(-0)", (-0.0).sin(), -0.0);
    same(&c, "sin(inf)", inf.sin(), nan);
    same(&c, "sin(nan)", nan.sin(), nan);
    same(&c, "sin(tiny)", tiny.sin(), tiny);
    same(&c, "sin(pi)", pi.sin(), 1.2246467991473532e-16);
    same(&c, "sin(1e22)", (1e22).sin(), -0.8522008497671888);
    same(&c, "sin(MAX)", f64::MAX.sin(), 0.004961954789184062);
    same(&c, "cos(-0)", (-0.0).cos(), 1.0);
    same(&c, "cos(-inf)", ninf.cos(), nan);
    same(&c, "cos(pi)", pi.cos(), -1.0);
    same(&c, "tan(-0)", (-0.0).tan(), -0.0);
    same(&c, "tan(inf)", inf.tan(), nan);
    same(&c, "tan(pi/4)", f64::consts::FRAC_PI_4.tan(), 0.9999999999999999);
    let (s, co) = (-0.0).sin_cos();
    same(&c, "sin_cos(-0).0", s, -0.0);
    same(&c, "sin_cos(-0).1", co, 1.0);
    let (s2, c2) = (3.0).sin_cos();
    same(&c, "sin_cos(3).0", s2, (3.0).sin());
    same(&c, "sin_cos(3).1", c2, (3.0).cos());
    // asin, acos, atan
    same(&c, "asin(-0)", (-0.0).asin(), -0.0);
    same(&c, "asin(1)", (1.0).asin(), f64::consts::FRAC_PI_2);
    same(&c, "asin(-1)", (-1.0).asin(), -f64::consts::FRAC_PI_2);
    same(&c, "asin(1.5)", (1.5).asin(), nan);
    same(&c, "asin(tiny)", tiny.asin(), tiny);
    same(&c, "acos(1)", (1.0).acos(), 0.0);
    same(&c, "acos(-1)", (-1.0).acos(), pi);
    same(&c, "acos(0)", (0.0).acos(), f64::consts::FRAC_PI_2);
    same(&c, "acos(-2)", (-2.0).acos(), nan);
    same(&c, "atan(-0)", (-0.0).atan(), -0.0);
    same(&c, "atan(inf)", inf.atan(), f64::consts::FRAC_PI_2);
    same(&c, "atan(-inf)", ninf.atan(), -f64::consts::FRAC_PI_2);
    same(&c, "atan(nan)", nan.atan(), nan);
    same(&c, "atan(1)", (1.0).atan(), f64::consts::FRAC_PI_4);
    // atan2(y, x)
    same(&c, "atan2(+0, +0)", (0.0).atan2(0.0), 0.0);
    same(&c, "atan2(-0, +0)", (-0.0).atan2(0.0), -0.0);
    same(&c, "atan2(+0, -0)", (0.0).atan2(-0.0), pi);
    same(&c, "atan2(-0, -0)", (-0.0).atan2(-0.0), -pi);
    same(&c, "atan2(+0, -1)", (0.0).atan2(-1.0), pi);
    same(&c, "atan2(-1, +0)", (-1.0).atan2(0.0), -f64::consts::FRAC_PI_2);
    same(&c, "atan2(1, -0)", (1.0).atan2(-0.0), f64::consts::FRAC_PI_2);
    same(&c, "atan2(inf, inf)", inf.atan2(inf), f64::consts::FRAC_PI_4);
    same(&c, "atan2(-inf, -inf)", ninf.atan2(ninf), -3.0 * f64::consts::FRAC_PI_4);
    same(&c, "atan2(1, -inf)", (1.0).atan2(ninf), pi);
    same(&c, "atan2(-1, inf)", (-1.0).atan2(inf), -0.0);
    same(&c, "atan2(nan, 1)", nan.atan2(1.0), nan);
    same(&c, "atan2(1, 1)", (1.0).atan2(1.0), f64::consts::FRAC_PI_4);
    same(&c, "math::atan2(1, -1)", math::atan2(1.0, -1.0), 3.0 * f64::consts::FRAC_PI_4);
    // exp, exp2
    same(&c, "exp(-0)", (-0.0).exp(), 1.0);
    same(&c, "exp(-inf)", ninf.exp(), 0.0);
    same(&c, "exp(inf)", inf.exp(), inf);
    same(&c, "exp(nan)", nan.exp(), nan);
    same(&c, "exp(710)", (710.0).exp(), inf);
    same(&c, "exp(-746)", (-746.0).exp(), 0.0);
    same(&c, "exp(-745.1)", (-745.1).exp(), tiny);
    // (within 1 ulp: fdlibm's exp(1) is e + 1 ulp)
    yes(&c, "exp(1)", ((1.0).exp() - f64::consts::E).abs() <= f64::EPSILON * 2.0);
    same(&c, "exp2(-inf)", ninf.exp2(), 0.0);
    same(&c, "exp2(inf)", inf.exp2(), inf);
    same(&c, "exp2(10)", (10.0).exp2(), 1024.0);
    same(&c, "exp2(1023)", (1023.0).exp2(), 8.98846567431158e307);
    same(&c, "exp2(1024)", (1024.0).exp2(), inf);
    same(&c, "exp2(-1074)", (-1074.0).exp2(), tiny);
    same(&c, "exp2(-1075)", (-1075.0).exp2(), 0.0);
    yes(&c, "exp2(0.5)", ((0.5).exp2() - f64::consts::SQRT_2).abs() <= f64::EPSILON * 2.0);
    // ln, log2, log10, log
    same(&c, "ln(+0)", (0.0).ln(), ninf);
    same(&c, "ln(-0)", (-0.0).ln(), ninf);
    same(&c, "ln(1)", (1.0).ln(), 0.0);
    same(&c, "ln(-1)", (-1.0).ln(), nan);
    same(&c, "ln(inf)", inf.ln(), inf);
    same(&c, "ln(-inf)", ninf.ln(), nan);
    same(&c, "ln(nan)", nan.ln(), nan);
    same(&c, "ln(tiny)", tiny.ln(), -744.4400719213812);
    same(&c, "ln(e)", f64::consts::E.ln(), 1.0);
    same(&c, "log2(8)", (8.0).log2(), 3.0);
    same(&c, "log2(2^-1074)", tiny.log2(), -1074.0);
    same(&c, "log2(0)", (0.0).log2(), ninf);
    same(&c, "log10(1000)", (1000.0).log10(), 3.0);
    same(&c, "log10(1e-300)", (1e-300).log10(), -300.0);
    same(&c, "log10(-1)", (-1.0).log10(), nan);
    same(&c, "log(8, 2)", (8.0).log(2.0), 3.0);
    // pow
    same(&c, "pow(nan, 0)", nan.powf(0.0), 1.0);
    same(&c, "pow(1, nan)", (1.0).powf(nan), 1.0);
    same(&c, "pow(2, nan)", (2.0).powf(nan), nan);
    same(&c, "pow(-1, inf)", (-1.0).powf(inf), 1.0);
    same(&c, "pow(0.5, inf)", (0.5).powf(inf), 0.0);
    same(&c, "pow(0.5, -inf)", (0.5).powf(ninf), inf);
    same(&c, "pow(2, -inf)", (2.0).powf(ninf), 0.0);
    same(&c, "pow(-0, -3)", (-0.0).powf(-3.0), ninf);
    same(&c, "pow(-0, -2)", (-0.0).powf(-2.0), inf);
    same(&c, "pow(-0, 3)", (-0.0).powf(3.0), -0.0);
    same(&c, "pow(+0, -inf)", (0.0).powf(ninf), inf);
    same(&c, "pow(-inf, -3)", ninf.powf(-3.0), -0.0);
    same(&c, "pow(-inf, 3)", ninf.powf(3.0), ninf);
    same(&c, "pow(-inf, 2)", ninf.powf(2.0), inf);
    same(&c, "pow(-8, 1/3)", (-8.0).powf(1.0 / 3.0), nan);
    same(&c, "pow(-2, 3)", (-2.0).powf(3.0), -8.0);
    same(&c, "pow(-2, -2)", (-2.0).powf(-2.0), 0.25);
    same(&c, "pow(2, 0.5)", (2.0).powf(0.5), f64::consts::SQRT_2);
    same(&c, "pow(2, 1024)", (2.0).powf(1024.0), inf);
    same(&c, "pow(2, -1074)", (2.0).powf(-1074.0), tiny);
    same(&c, "pow(10, 2)", (10.0).powf(2.0), 100.0);
    same(&c, "pow(10, 15)", (10.0).powf(15.0), 1e15);
    same(&c, "pow(-10, 1e300)", (-10.0).powf(1e300), inf);
    same(&c, "math::pow(9, 0.5)", math::pow(9.0, 0.5), 3.0);
    // powi
    same(&c, "powi(2, -2)", (2.0).powi(-2), 0.25);
    same(&c, "powi(nan, 0)", nan.powi(0), 1.0);
    same(&c, "powi(-3, 3)", (-3.0).powi(3), -27.0);
    same(&c, "powi(2, 1023)", (2.0).powi(1023), 8.98846567431158e307);
    // rounding
    same(&c, "floor(-0)", (-0.0).floor(), -0.0);
    same(&c, "floor(-0.5)", (-0.5).floor(), -1.0);
    same(&c, "floor(0.5)", (0.5).floor(), 0.0);
    same(&c, "floor(-inf)", ninf.floor(), ninf);
    same(&c, "floor(nan)", nan.floor(), nan);
    same(&c, "floor(2^52 + 0.5)", (4503599627370496.5).floor(), 4503599627370496.0);
    same(&c, "ceil(-0.5)", (-0.5).ceil(), -0.0);
    same(&c, "ceil(0.2)", (0.2).ceil(), 1.0);
    same(&c, "ceil(tiny)", tiny.ceil(), 1.0);
    same(&c, "round(0.5)", (0.5).round(), 1.0);
    same(&c, "round(-0.5)", (-0.5).round(), -1.0);
    same(&c, "round(-0.4)", (-0.4).round(), -0.0);
    same(&c, "round(0.49999999999999994)", (0.49999999999999994).round(), 0.0);
    same(&c, "round(2.5)", (2.5).round(), 3.0);
    same(&c, "round(2^52 + 1)", (4503599627370497.0).round(), 4503599627370497.0);
    same(&c, "round_ties_even(0.5)", (0.5).round_ties_even(), 0.0);
    same(&c, "round_ties_even(1.5)", (1.5).round_ties_even(), 2.0);
    same(&c, "round_ties_even(2.5)", (2.5).round_ties_even(), 2.0);
    same(&c, "round_ties_even(-0.5)", (-0.5).round_ties_even(), -0.0);
    same(&c, "round_ties_even(-3.5)", (-3.5).round_ties_even(), -4.0);
    same(&c, "trunc(-0.9)", (-0.9).trunc(), -0.0);
    same(&c, "trunc(inf)", inf.trunc(), inf);
    same(&c, "trunc(-1.5)", (-1.5).trunc(), -1.0);
    same(&c, "fract(-1.25)", (-1.25).fract(), -0.25);
    same(&c, "fract(inf)", inf.fract(), nan);
    // abs, signs, min, max, clamp
    same(&c, "abs(-0)", (-0.0).abs(), 0.0);
    same(&c, "abs(-inf)", ninf.abs(), inf);
    same(&c, "signum(-0)", (-0.0).signum(), -1.0);
    same(&c, "signum(+0)", (0.0).signum(), 1.0);
    same(&c, "signum(nan)", nan.signum(), nan);
    same(&c, "signum(-7)", (-7.0).signum(), -1.0);
    same(&c, "copysign(3, -0)", (3.0).copysign(-0.0), -3.0);
    same(&c, "copysign(-3, nan)", (-3.0).copysign(nan), 3.0);
    yes(&c, "is_nan", nan.is_nan() && !inf.is_nan() && !(1.0).is_nan());
    yes(&c, "is_finite", (1.0).is_finite() && !inf.is_finite() && !nan.is_finite());
    yes(&c, "is_infinite", ninf.is_infinite() && !nan.is_infinite() && !f64::MAX.is_infinite());
    yes(&c, "is_sign_negative", (-0.0).is_sign_negative() && !(0.0).is_sign_negative());
    yes(&c, "is_sign_positive", (0.0).is_sign_positive() && !(-1.0).is_sign_positive());
    same(&c, "min(nan, 1)", nan.min(1.0), 1.0);
    same(&c, "min(1, nan)", (1.0).min(nan), 1.0);
    same(&c, "max(nan, 1)", nan.max(1.0), 1.0);
    same(&c, "min(-0, +0)", (-0.0).min(0.0), -0.0);
    same(&c, "min(+0, -0)", (0.0).min(-0.0), -0.0);
    same(&c, "max(-0, +0)", (-0.0).max(0.0), 0.0);
    same(&c, "min(2, -3)", (2.0).min(-3.0), -3.0);
    same(&c, "clamp(5, 0, 1)", (5.0).clamp(0.0, 1.0), 1.0);
    same(&c, "clamp(-5, 0, 1)", (-5.0).clamp(0.0, 1.0), 0.0);
    same(&c, "clamp(nan, 0, 1)", nan.clamp(0.0, 1.0), nan);
    same(&c, "recip(-0)", (-0.0).recip(), ninf);
    same(&c, "to_radians(180)", (180.0).to_radians(), pi);
    same(&c, "to_degrees(pi)", pi.to_degrees(), 180.0);
    // f32
    let nan32 = f32::NAN;
    same32(&c, "f32 sqrt(2)", (2.0f32).sqrt(), 1.4142135);
    same32(&c, "f32 sqrt(-0)", (-0.0f32).sqrt(), -0.0);
    same32(&c, "f32 sqrt(-1)", (-1.0f32).sqrt(), nan32);
    same32(&c, "f32 sin(-0)", (-0.0f32).sin(), -0.0);
    same32(&c, "f32 cos(inf)", f32::INFINITY.cos(), nan32);
    same32(&c, "f32 exp(89)", (89.0f32).exp(), f32::INFINITY);
    same32(&c, "f32 exp(-104)", (-104.0f32).exp(), 0.0);
    same32(&c, "f32 ln(0)", (0.0f32).ln(), f32::NEG_INFINITY);
    same32(&c, "f32 powf(2, 10)", (2.0f32).powf(10.0), 1024.0);
    same32(&c, "f32 powi(3, 4)", (3.0f32).powi(4), 81.0);
    same32(&c, "f32 floor(-0.5)", (-0.5f32).floor(), -1.0);
    same32(&c, "f32 round(-2.5)", (-2.5f32).round(), -3.0);
    same32(&c, "f32 min(nan, 2)", nan32.min(2.0), 2.0);
    same32(&c, "f32 max(-0, +0)", (-0.0f32).max(0.0), 0.0);
    same32(&c, "f32 signum(-0)", (-0.0f32).signum(), -1.0);
    same32(&c, "f32 copysign(2, -1)", (2.0f32).copysign(-1.0), -2.0);
    same32(&c, "f32 hypot(inf, nan)", f32::INFINITY.hypot(nan32), f32::INFINITY);
    same32(&c, "f32 hypot(3e38, 3e38)", (3.0e38f32).hypot(3.0e38), f32::INFINITY);
    same32(&c, "f32 atan2(-0, -1)", (-0.0f32).atan2(-1.0), -f32::consts::PI);
    same32(&c, "f32 to_degrees(pi)", f32::consts::PI.to_degrees(), 180.0);
    same32(&c, "f32 clamp(2, -1, 1)", (2.0f32).clamp(-1.0, 1.0), 1.0);
    same32(&c, "math::sqrt(f32)", math::sqrt(16.0f32), 4.0);
    let x: f32 = 0.25;
    same32(&c, "math::max(f32)", math::max(x, 0.5), 0.5);
    if c.failed == 0 {
        println("math special: ok");
        0
    } else {
        println("math special: {} failed", c.failed);
        1
    }
}
