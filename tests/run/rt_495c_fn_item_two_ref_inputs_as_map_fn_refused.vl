// XFAIL: RT-495c: (RT-495, two reference inputs) `fn inner<'a, 'b>(x: &'a &'b i64) -> &'b i64` as MyMap's F over `vv.iter()` of a Vec<&i64>, then `drop(vv)` before the result's use, is refused (borrowck.move_borrowed): the result borrows the inner reference ('b), not vv; rustc prints `Some(5000)` (0.30.2)
// From the third re-review of the borrow-check work (g302bor2).
// EXPECT: Some(5000)
static SEVEN: i64 = 7;

fn st(_x: &i64) -> &'static i64 {
    &SEVEN
}

struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn inner<'a, 'b>(x: &'a &'b i64) -> &'b i64 {
    *x
}

fn main(gpa: Gpa) {
    let w = 5000i64;
    let mut vv: Vec<&i64, Gpa> = Vec::new_in(gpa);
    vv.push(&w);
    let r = MyMap { i: vv.iter(), f: inner }.next();
    drop(vv);
    println("{:?}", r);
}
