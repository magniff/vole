// XFAIL: RT-489: `<W<_> as Tg<u8>>::h()` with `impl<X> Tg<X> for W<X>` does not parse on the release build ("expected expression, got '<'", RT-154's family); the `_` is then to be inferred from the trait's argument (X = u8); rustc prints 110 (0.30.2)
// From the third re-review of the qualified-path work (g302qual). Since v0.30.1 at least.
// From the review's form c2/o15b_hole_from_trait_arg. Once the g302qual
// work parses `<W<_> as ..>`, this case may fail differently (the hole).
// fmt (0.30.2, RT-409 fixed) keeps `<W<_> as Tg<u8>>::h()` as written; it
// once laid it out as `< W<_> as Tg<u8 >>::h()`.
// EXPECT: 110
trait Tr {
    const C: i64;
    type Out;
    fn f() -> i64;
}

struct W<T> {
    t: T,
}

impl<T> Tr for W<T> {
    const C: i64 = 1;
    type Out = i64;

    fn f() -> i64 {
        2
    }
}

impl<T> W<T> {
    fn mk() -> i64 {
        3
    }
}

trait Tg<X> {
    fn h() -> i64;
}

impl<X> Tg<X> for W<X> {
    fn h() -> i64 {
        110
    }
}

fn main() {
    println("{}", <W<_> as Tg<u8>>::h());
}
