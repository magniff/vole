// Runs on std since 0.27.2's switch.
// The std item(s): std::iter Iterator::find_map.
// EXPECT: Some(6) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    println("{:?} {:?}", v.iter().find_map(|x| if *x > 2 { Some(x * 2) } else { None }),
        v.iter().find_map(|x| if *x > 9 { Some(*x) } else { None }));
}
