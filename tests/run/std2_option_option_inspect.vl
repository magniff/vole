// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::option Option::inspect.
// EXPECT: saw 3
// EXPECT: Some(3)
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b = a.inspect(|x| println("saw {}", x));
    let c: Option<i64> = None;
    let _ = c.inspect(|x| println("saw {}", x));
    println("{:?}", b);
}
