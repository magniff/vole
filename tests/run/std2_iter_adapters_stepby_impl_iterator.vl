// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters StepBy::impl Iterator.
// EXPECT: Some(1) Some(3) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3], gpa);
    let mut it = s.iter().copied().step_by(2);
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.next());
}
