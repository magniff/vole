// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: grown 3
// STDERR: unsafe access out of bounds (just past the end): 8 bytes at offset 32 of a block of 32 bytes
// 0.30.1: realloc of a null pointer is malloc, and its block is recorded:
// a list grown from nothing by realloc (the book's Ints) is checked, and
// a read just past its end stops. (A first version of the quarantine
// passed a realloc of null through as C's own block, unchecked; the book's
// session 15-unsafe-and-c found it.)
extern "C" {
    fn realloc(p: *mut u8, n: usize) -> *mut u8;
    fn free(p: *mut u8);
}

fn main() {
    // UNSAFE: C's realloc and free, and a deliberate read past the block.
    // SAFETY: none for the last read: the program exists to be stopped.
    unsafe {
        let p = realloc(std::ptr::null_mut(), 16) as *mut i64;
        let q = realloc(p as *mut u8, 32) as *mut i64;
        *q.add(3) = 3;
        println("grown {}", *q.add(3));
        println("past {}", *q.add(4));
        free(q as *mut u8);
    }
}
