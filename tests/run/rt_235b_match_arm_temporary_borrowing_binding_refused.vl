// XFAIL: RT-235b: (fuller form of R302E-12) a temporary in a match arm's expression that borrows the arm's binding is refused, "'h' is dropped while it is still borrowed": the binding is dropped before the temporary (0.30.2)
// rustc builds it and prints the EXPECT lines (twin .rs.txt): R, which borrows h, is dropped first.
// EXPECT: drop R reads 7
// EXPECT: drop H 7
// EXPECT: x 7 99
use std::alloc::Allocator;

struct H<A: Allocator> {
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for H<A> {
    fn drop(&mut self) {
        println("drop H {}", self.v[0]);
    }
}

struct R<'a, A: Allocator> {
    h: &'a H<A>,
}

impl<'a, A: Allocator> Drop for R<'a, A> {
    fn drop(&mut self) {
        println("drop R reads {}", self.h.v[0]);
    }
}

impl<'a, A: Allocator> R<'a, A> {
    fn val(&self) -> i64 {
        self.h.v[0]
    }
}

fn pick(n: i64, gpa: Gpa) -> Option<H<Gpa>> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(n);
    if n > 0 { Some(H { v: v }) } else { None }
}

fn main(gpa: Gpa) {
    let x = match pick(7, gpa) {
        Some(h) => R { h: &h }.val(),
        None => 0,
    };
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(99);
    println("x {} {}", x, w[0]);
}
