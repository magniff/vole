// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::product.
// EXPECT: 24 1

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let p: i64 = v.iter().product();
    let q: i64 = e.iter().product();
    println("{} {}", p, q);
}
