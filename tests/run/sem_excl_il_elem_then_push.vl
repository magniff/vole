// EDITION: rust
// an inout element live across a push of its Vec: realloc
// ERROR: error[borrowck.mut_twice]
// ERROR: line 7, column 23
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let e = &mut v[0];
    for i in 0..100 { v.push(i); } *e += 5; println("{}", v[0]);
}
