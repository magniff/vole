// RULE: F9.1
// Two traits' methods of one name on one type, and an inherent one on
// another: the inherent method wins a method call, and a qualified call
// names the trait's.
// EXPECT: 1
// EXPECT: 2
// EXPECT: 3
// EXPECT: 4
trait A {
    fn get(&self) -> i64;
}

trait B {
    fn get(&self) -> i64;
}

struct S {
    n: i64,
}

impl A for S {
    fn get(&self) -> i64 {
        1
    }
}

impl B for S {
    fn get(&self) -> i64 {
        2
    }
}

struct T {
    n: i64,
}

impl T {
    fn get(&self) -> i64 {
        self.n
    }
}

impl A for T {
    fn get(&self) -> i64 {
        4
    }
}

fn main() {
    let s = S { n: 0 };
    let t = T { n: 3 };
    println("{}", A::get(&s));
    println("{}", B::get(&s));
    println("{}", t.get());
    println("{}", A::get(&t));
}
