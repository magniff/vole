// RULE: D21.5, D21.6 (0.30.2, RT-301, closed with the opaque call kinds) Was: an `impl Fn(&i64) -> &i64` value (a fn's opaque result) passed where `F: FnOnce(T) -> U` is wanted is refused: `v.first().map(mk())` and `ap(&v[0], mk())` give "cannot infer type parameter 'U'" (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). `mk()(&v[0])` (a direct
// call), a closure or a fn item in the same place, and an `impl Fn(i64) ->
// i64` without references build.
// EXPECT: Some(1) 1 2 4
fn mk() -> impl Fn(&i64) -> &i64 {
    |x| x
}

fn mk2() -> impl Fn(i64) -> i64 {
    |x| x * 2
}

fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    f(t)
}

fn main() {
    let v = [1i64, 2];
    let a = v.first().map(mk());
    let b = ap(&v[0], mk());
    let c = mk()(&v[1]);
    let d = ap(2i64, mk2());
    println("{:?} {} {} {}", a, b, c, d);
}
