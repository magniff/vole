// sem-own: moving an owned value out of a static: own.move_out (statics are
// never dropped), as Rust's E0507 "cannot move out of static". (0.26.1)
// Also where the function makes no place for the static (nothing in it
// borrows or assigns it): `let x = S;` alone was accepted, and x dropped
// what S keeps (each call of peek freed S's Vec again, a double free).
// ERROR: error[own.move_out]: cannot move 'S' (Option<Vec<i64>>) out of a static
// ERROR: cannot move 'T' (D) out of a static
// ERROR-COUNT: 3
struct D { id: i64 }

impl Drop for D {
    fn drop(inout self) {
        println(f"drop {self.id}");
    }
}

static var S: Option<Vec<i64>> = None;
static var T: D = D { id: 7 };

fn peek() -> i64 {
    let x = S;
    match x {
        Some(v) => v.len() as i64,
        None => 0,
    }
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(41);
    S = Some(v);
    println(f"{peek()}");
    let x = S;
    let t = T;
    println(f"{t.id}");
}
