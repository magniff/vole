// sem-own: moving an owned value out of a static: own.move_out (statics are
// never dropped), as Rust's E0507 "cannot move out of static". (0.26.1)
// Also where the function makes no place for the static (nothing in it
// borrows or assigns it): `let x = S;` alone was accepted, and x dropped
// what S keeps (each call of peek dropped S's value again, a double drop).
// (0.26.3: a static holds no allocator, alloc.static; the owned value is
// a type with Drop.)
// ERROR: error[own.move_out]: cannot move 'S' (Option<D>) out of a static
// ERROR: cannot move 'T' (D) out of a static
// ERROR-COUNT: 3
struct D { id: i64 }

impl Drop for D {
    fn drop(inout self) {
        println("drop {}", self.id);
    }
}

static var S: Option<D> = None;
static var T: D = D { id: 7 };

fn peek() -> i64 {
    let x = S;
    match x {
        Some(d) => d.id,
        None => 0,
    }
}

fn main() {
    S = Some(D { id: 41 });
    println("{}", peek());
    let x = S;
    let t = T;
    println("{}", t.id);
}
