// FLAGS: --check-unsafe
// CSOURCE: tests/c/c_symbol_identity.c
// EXIT: 101
// EXPECT: allocs 1
// STDERR: unsafe access after free: 1 bytes at offset 3 of a block of 8 bytes
// STDERR: c_symbol_check_unsafe.vl: line 36, column 51
// 0.30.1: --check-unsafe knows C's allocator by the symbols the program's
// externs link to: `grab` and `release` are C's malloc and free (their
// blocks are recorded, a use after free stops), and the extern the
// program calls `malloc`, which links to its own csi_alloc, is not
// redirected to the check's malloc (its call is made: allocs 1). A pin:
// 0.30.0 passes it too, by another way (it renamed every symbol `malloc`,
// the check's runtime's own calls included, to csi_alloc).
extern "C" {
    #[link_name = "malloc"]
    fn grab(n: usize) -> *mut u8;
    #[link_name = "free"]
    fn release(p: *mut u8);
    #[link_name = "csi_alloc"]
    fn malloc(n: usize) -> *mut u8;
    #[link_name = "csi_free"]
    fn free(p: *mut u8);
    fn csi_allocs() -> i64;
}

fn main() {
    // UNSAFE: the program's allocator. SAFETY: written and freed once.
    unsafe {
        let a = malloc(8);
        *a = 1;
        free(a);
        println("allocs {}", csi_allocs());
    }
    // UNSAFE: C's malloc and a deliberate use after free.
    // SAFETY: none: this program exists to be stopped.
    let x = unsafe { let p = grab(8); release(p); *p.add(3) };
    println("read {x}");
}
