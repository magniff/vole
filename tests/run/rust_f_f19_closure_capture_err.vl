// RULE: F19.3
// A closure that captures a variable coerces to no fn pointer type, an
// `unsafe fn` one included.
// ERROR: a closure that captures variables cannot be a 'unsafe fn(i64) -> i64' (it captures 'k')
fn main() {
    let k = 3;
    let f: unsafe fn(i64) -> i64 = |x: i64| x + k;
    // SAFETY: the closure has no precondition.
    let _a = unsafe { f(1) };
}
