// EDITION: rust
// RULE: F12.1
// A default body in a generic trait (`Rhs = Self`), copied into the impl
// with the trait's arguments substituted.
// EXPECT: 1
// EXPECT: 0
trait Cmp<Rhs = Self> {
    fn same(&self, o: &Rhs) -> bool;

    fn differs(&self, o: &Rhs) -> bool {
        !self.same(o)
    }
}

struct S {
    n: i64,
}

impl Cmp for S {
    fn same(&self, o: &S) -> bool {
        self.n == o.n
    }
}

fn main() -> i64 {
    let a = S { n: 1 };
    let b = S { n: 2 };
    std::print_int(if a.differs(&b) { 1 } else { 0 });
    println("");
    std::print_int(if a.differs(&a) { 1 } else { 0 });
    println("");
    0
}
