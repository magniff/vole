// XFAIL: RT-127: tuples have no Default: `Default::default()` for a tuple and #[derive(Default)] on a struct with a tuple field are refused (0.30.2)
// Rust implements Default for tuples (each element's default). vole: "no
// associated function 'default' in '(i64, bool)'", at the derive's field
// for #[derive(Default)] and at the call for `let a: (u8, char) =
// Default::default();`. Arrays and Option fields derive. Since 0.28.0.
// EXPECT: S { t: (0, false), a: [0, 0, 0], o: None } (0, '\0')
#[derive(Default, Debug)]
struct S {
    t: (i64, bool),
    a: [u8; 3],
    o: Option<i64>,
}

fn main() {
    let s = S::default();
    let a: (u8, char) = Default::default();
    println("{:?} {:?}", s, a);
}
