// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::fmt Octal.
// EXPECT: 10
use std::fmt::{Formatter, Octal};

struct W {
    v: u32,
}

impl Octal for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main() {
    println("{:o}", W { v: 8u32 });
}
