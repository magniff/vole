// places IR (0.26.1, R3): a sink closure's body that moves a capture out
// of its env clears the capture's live flag, `(*_1).1 = const false`, as
// the own pass does, so that the env's shim does not drop it again.
// FLAGS: --check-alloc
// EXPECT: 1
// PLACES: fn closure
// PLACES: call take(move (*_1).0)
// PLACES: (*_1).1 = const false
fn take(v: sink Vec<i64>) -> i64 {
    v.len()
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let f = sink || println(f"{take(v)}");
    f();
}
