// (0.30.1, review 2) A labelled `break 'o a + a` from a loop nested in the
// labelled one gives the outer loop its value: an i32 computed from
// untyped literals, used as an i64 (rustc types the literals i64 and
// prints 4000000000). Refused, as the other forms are: write the type.
// (0.30.2) Accepted: each literal is typed from its use, as rustc types
// it (F18.5), and the sum is computed in i64, rustc's output.
// EXPECT: 4000000000
// EXPECT: 4000000000
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let a = 2000000000;
    let s = 'o: loop {
        loop {
            break 'o a + a;
        }
    };
    println("{}", take(s));
    let b = 2000000000;
    let t = 'p: loop {
        while true {
            break 'p b + b;
        }
    };
    println("{}", take(t));
}
