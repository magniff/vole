// Runs on std since 0.27.2's switch.
// The std item(s): std::str str::eq_ignore_ascii_case.
// EXPECT: true false true
use std::str::CharIndices;

fn main() {
    println("{} {} {}", "Ferris".eq_ignore_ascii_case("FERRIS"),
        "Ferrös".eq_ignore_ascii_case("FERRÖS"), "".eq_ignore_ascii_case(""));
}
