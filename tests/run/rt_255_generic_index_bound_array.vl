// XFAIL: RT-255: `T: Index<usize>` instantiated with an array `[i64; N]` is refused: "the trait 'Index<usize>' is not implemented for '[i64; 2]'" (0.30.2)
// rustc's arrays implement Index<I> (`impl<T, I, const N: usize> Index<I>
// for [T; N] where [T]: Index<I>`), so `first(&a)` builds and prints 22.
// A Vec and a slice instance build. From the review of g302index (form
// i20); v0.30.1 the same.
// EXPECT: 22
use std::ops::Index;

fn first<T: Index<usize> + ?Sized>(t: &T) -> &T::Output {
    &t[0]
}

fn main() {
    let a = [22i64, 0];
    println("{}", first(&a));
}
