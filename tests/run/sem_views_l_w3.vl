// EXPECT: 1
use std::alloc::Allocator; struct H<A: Allocator> { b: Vec<u8, A> }
impl H<Gpa> {
    fn from(s: &[u8], gpa: Gpa) -> H<Gpa> {
        let mut b = Vec::<u8, Gpa>::new_in(gpa); b.extend_from_slice(s); H { b: b }
    }

    fn num(n: i64, gpa: Gpa) -> H<Gpa> {
        let mut b = Vec::<u8, Gpa>::new_in(gpa);
        b.extend_from_slice(format_in("{}", n, *b.allocator()).as_bytes()); H { b: b }
    }

    fn len(&self) -> i64 { self.b.len() as i64 } }
fn mkf(s: &[u8], gpa: Gpa) -> H<Gpa> { H::from(s, gpa) }

fn main(gpa: Gpa) -> i32 {
    let a: i64 = 3; println("{}", H::num(a, gpa).len());
    0
}
