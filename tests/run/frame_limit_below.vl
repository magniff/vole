// (0.30.2, RT-466's family) A frame under every target's limit builds:
// a local of 256 MiB in a function that is never entered (its frame is
// reserved, and probed, only when it is called). The limit refuses no
// frame that fits.
// EXPECT: before
// EXPECT: after
#[inline(never)]
fn big(n: usize) -> u8 {
    let a = [5u8; 1usize << 28];
    a[n]
}

fn main() {
    let n = std::env::args().count();
    println("before");
    if n > 5 {
        println("{}", big(n));
    }
    println("after");
}
