// (0.29.0) The matching block of an `if let` gives a borrow of a
// temporary of its scrutinee: the temporary is dropped at the end of that
// block (rustc's rule from its 2024 edition, where this is E0716; in
// 2021 it lived to the end of the `let`).
// RUSTC-EDITION: 2024
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 24, column 35
// ERROR-COUNT: 1
struct T {
    id: i64,
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn opt(t: T) -> Option<T> {
    Some(t)
}

fn main() {
    let r: &T = if let Some(x) = &opt(T { id: 1 }) { x } else { return };
    println("{}", r.id);
}
