// The std2 item(s): std::fmath f64::sqrt; f64::cbrt; f64::hypot; f64::powi; f64::powf; f64::recip; f64::to_radians; f64::to_degrees; f64::min; f64::max; f64::div_euclid; f64::rem_euclid.
// EXPECT: 1.4142135623730951 4 true 3
// EXPECT: 5 1024 0.25 3
// EXPECT: 0.25 3.141592653589793 180
// EXPECT: 2 7.5 1 -0
// EXPECT: 2 -3 1 -2
fn main() {
    println("{} {} {} {}", 2.0f64.sqrt(), 16.0f64.sqrt(), (-1.0f64).sqrt().is_nan(),
        27.0f64.cbrt());
    println("{} {} {} {}", 3.0f64.hypot(4.0), 2.0f64.powi(10), 2.0f64.powi(-2), 9.0f64.powf(0.5));
    println("{} {} {}", 4.0f64.recip(), 180.0f64.to_radians(), std::f64::consts::PI.to_degrees());
    println("{} {} {} {}", 7.5f64.min(2.0), 7.5f64.max(f64::NAN), f64::NAN.min(1.0),
        (-0.0f64).max(-1.0));
    println("{} {} {} {}", (-7.0f64).rem_euclid(3.0), (-7.0f64).div_euclid(3.0),
        7.0f64.rem_euclid(-3.0), 7.0f64.div_euclid(-3.0));
}
