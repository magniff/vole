// EDITION: rust
// 0.14: in `a[i]`, `a[lo..hi]` and a vector load or store, the base `a`
// is evaluated first to its location, then the index or bounds, and only
// then is what `a` holds read (a slice's pointer and length, a pointer).
// An index that grows the table `a` views and re-takes the view is seen:
// nothing reads the old storage. `move_table` stands for the realloc that
// moves a table: it copies the elements to a new Vec, poisons the old one
// (99) and keeps it, so a read of the old storage shows as 99.
// (0.16: the tables are statics on an arena, set up in main; 0.26.3:
// main's, reached through a static's address.)
// (0.28, the rust edition: the tables are main's, on the Gpa, reached
// through a static's address as plain bytes; every view is re-taken through
// raw pointers, in unsafe, since the borrow checker refuses a view kept
// across the call that moves its table: that the order holds there is the
// point. The stores go through a `&mut [i64]` view of their own. A raw
// pointer has no index: `*p.add(i)` is a method call, whose receiver is read
// before its argument as in Rust, so the 0.14 raw-pointer rows are gone.)
use std::alloc::Allocator;

struct Tables<A: Allocator> {
    arena: A, v: Vec<i64, A>, old: Vec<Vec<i64, A>, A>, bytes: Vec<u8, A>,
    oldb: Vec<Vec<u8, A>, A>,
}

static mut TB: *mut u8 = 0 as *mut u8;
static mut S: &[u8] = b"";
static mut SS: [&[u8]; 2] = [b"", b""];
static mut MT: *mut u8 = 0 as *mut u8;

#[derive(Clone, Copy)] struct Table<'a> { view: &'a [i64], pad: i64 }

// The view the stores go through (0.28: a `&[i64]` is not written through).
struct Written<'a> { view: &'a mut [i64] }

fn written() -> *mut Written<'static> {
    // UNSAFE: a static mut read.
    // SAFETY: one thread; MT is set once, first thing in main.
    (unsafe { MT }) as *mut Written<'static>
}

fn tb() -> *mut Tables<Gpa> {
    (unsafe { TB }) as *mut Tables<Gpa>
}

fn reset(t: *mut Table<'_>) {
    // UNSAFE: main's tables, through TB, and t's view.
    // SAFETY: TB is main's `tables`, set first and live for the whole run;
    // t is main's Table.
    unsafe {
        let m = tb();
        (*m).v = Vec::new_in((*m).arena);
        for x in 0..8 { (*m).v.push(10 + x); }
        (*m).bytes = Vec::new_in((*m).arena);
        for x in 0..8 { (*m).bytes.push(20 + x as u8); }
        t.view = (*m).v.as_slice();
        (*written()).view = std::slice::from_raw_parts_mut((*m).v.as_mut_ptr(), (*m).v.len());
        S = (*m).bytes.as_slice();
        SS[1] = (*m).bytes.as_slice();
    }
}

// Moves the tables (the old storage poisoned and kept), re-takes every
// view of them; returns k.
fn move_table(t: *mut Table<'_>, k: i64) -> i64 {
    // UNSAFE: main's tables, through TB, and t's view.
    // SAFETY: as in reset.
    unsafe {
        let m = tb();
        let mut w: Vec<i64, Gpa> = Vec::new_in((*m).arena);
        for x in (*m).v.iter() { w.push(*x); }
        for i in 0..(*m).v.len() { (*m).v[i] = 99i64; }
        let tabs: &mut Tables<Gpa> = &mut *m;
        tabs.old.push(std::mem::replace(&mut tabs.v, w));
        t.view = (*m).v.as_slice();
        (*written()).view = std::slice::from_raw_parts_mut((*m).v.as_mut_ptr(), (*m).v.len());
        let mut b: Vec<u8, Gpa> = Vec::new_in((*m).arena);
        for x in (*m).bytes.iter() { b.push(*x); }
        for i in 0..(*m).bytes.len() { (*m).bytes[i] = 99u8; }
        tabs.oldb.push(std::mem::replace(&mut tabs.bytes, b));
        S = (*m).bytes.as_slice();
        SS[1] = (*m).bytes.as_slice();
    }
    k
}

fn via_param(t: *mut Table<'_>) -> i64 { unsafe { t.view[move_table(t, 2) as usize] } }

fn main(gpa: Gpa) -> i32 {
    let arena = gpa;
    let mut tables: Tables<Gpa> = Tables {
        arena: arena, v: Vec::new_in(arena), old: Vec::new_in(arena),
        bytes: Vec::new_in(arena), oldb: Vec::new_in(arena),
    };
    // UNSAFE: tables' address kept in the static, as bytes.
    // SAFETY: tables lives to the end of main, past every use of TB.
    unsafe { TB = &mut tables as *mut Tables<Gpa> as *mut u8; }
    let mut none = [0i64; 1];
    let mut wr = Written { view: &mut none };
    let w = &mut wr as *mut Written<'_>;
    // UNSAFE: wr's address kept in the static, as bytes.
    // SAFETY: wr lives to the end of main, past every use of MT.
    unsafe { MT = w as *mut u8; }
    let mut out = String::new_in(gpa);
    let mut t = Table { view: tables.v.as_slice(), pad: 0 };
    reset(&mut t);
    std::fmt::write(&mut out, t.view[move_table(&mut t, 1) as usize]).unwrap();
    reset(&mut t);
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, via_param(&mut t)).unwrap();
    reset(&mut t);
    // UNSAFE: the written view is reached through the pointer the static keeps.
    // SAFETY: w is main's `wr`, live here; move_table re-took its view.
    unsafe { (*w).view[move_table(&mut t, 3) as usize] = 7; }
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, tables.v[3usize]).unwrap();
    reset(&mut t);
    // UNSAFE: the written view is reached through the pointer the static keeps.
    // SAFETY: w is main's `wr`, live here; move_table re-took its view.
    unsafe { (*w).view[move_table(&mut t, 4) as usize] += 100; }
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, tables.v[4usize]).unwrap();
    println("{}", str::from_utf8(out.as_bytes()).unwrap());
    out.clear();

    // Slicing: the bounds, then the slice.
    reset(&mut t);
    std::fmt::write(&mut out, (unsafe { S[move_table(&mut t, 1) as usize..][0] } as i64)).unwrap();
    reset(&mut t);
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, (unsafe { S[..move_table(&mut t, 3) as usize][2] } as i64)).unwrap();
    reset(&mut t);
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out,
        (unsafe { S[move_table(&mut t, 1) as usize..move_table(&mut t, 4) as usize][1] } as i64)).unwrap();
    reset(&mut t);
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, t.view[move_table(&mut t, 2) as usize..=5][0]).unwrap();
    reset(&mut t);
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, (unsafe { SS[1][move_table(&mut t, 5) as usize] } as i64)).unwrap();
    reset(&mut t);
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, (unsafe { SS[1][move_table(&mut t, 5) as usize..][1] } as i64)).unwrap();
    println("{}", str::from_utf8(out.as_bytes()).unwrap());
    out.clear();

    // A local view re-taken inside the index.
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in 0..4 { v.push(x); }
    let mut s = v.as_slice();
    let a = s[{
        for x in 0..1000 { v.push(x); }
        s = v.as_slice();
        3
    } as usize];
    let b = s[{
        for x in 0..1000 { v.push(x); }
        s = v.as_slice();
        1
    } as usize..3][1];
    std::fmt::write(&mut out, a).unwrap();
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, b).unwrap();
    println("{}", str::from_utf8(out.as_bytes()).unwrap());
    out.clear();

    // Vector loads and stores: s, the index, then s's pointer and length.
    reset(&mut t);
    std::fmt::write(&mut out, (v2i64::load(t.view, move_table(&mut t, 2)).sum())).unwrap();
    reset(&mut t);
    v2i64::splat(5).store(t.view, move_table(&mut t, 6));
    out.push(char::from_u32(' ' as u32).unwrap());
    std::fmt::write(&mut out, (tables.v[6usize] + tables.v[7usize])).unwrap();
    println("{}", str::from_utf8(out.as_bytes()).unwrap());
    out.clear();
    drop(v);
    drop(out);
    0
}

// EXPECT: 11 12 7 114
// EXPECT: 21 22 22 12 25 26
// EXPECT: 3 2
// EXPECT: 25 10
