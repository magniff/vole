// 0.14: in `a[i]`, `a[lo..hi]` and a vector load or store, the base `a`
// is evaluated first to its location, then the index or bounds, and only
// then is what `a` holds read (a slice's pointer and length, a pointer).
// An index that grows the table `a` views and re-takes the view is seen:
// nothing reads the old storage. `move_table` stands for the realloc that
// moves a table: it copies the elements to a new Vec, poisons the old one
// (99) and keeps it, so a read of the old storage shows as 99.
// (0.16: the tables are statics on an arena, set up in main; 0.26.3:
// main's, reached through a static's address.)
// FLAGS: --values=off
// (0.17 rejects re-taking a static's view after a call that grows it,
// own.static: err_own_static_readonly; --values=off keeps 0.16's
// semantics, where the evaluation order is what keeps it right.)
use std::Buf;

// (0.26.3: a static holds no allocator, alloc.static: the tables are
// main's, in one struct on its arena, and reset and move_table reach them
// through the address a static keeps, as plain bytes; the views and the
// pointer the indexes read stay statics.)
struct Tables<A: Allocator> {
    arena: A, v: Vec<i64, A>, old: Vec<Vec<i64, A>, A>, bytes: Vec<u8, A>,
}

static var TB: *u8 = 0 as *u8;
static var S: [u8] = "";
static var SS: [[u8]; 2] = ["", ""];
static var P: *u8 = 0 as *u8;

struct Table { view: [i64], pad: i64 }

fn tb() -> *Tables<Arena> {
    TB as *Tables<Arena>
}

fn reset(t: *Table) {
    // UNSAFE: main's tables, through TB, and t's view.
    // SAFETY: TB is main's `tables`, set first and live for the whole run;
    // t is main's Table.
    unsafe {
        let m = tb();
        (*m).v = Vec::new_in((*m).arena);
        for x in 0..8 { (*m).v.push(10 + x); }
        (*m).bytes = Vec::new_in((*m).arena);
        for x in 0..8 { (*m).bytes.push(20 + x as u8); }
        t.view = (*m).v.as_slice();
        S = (*m).bytes.as_slice();
        SS[1] = (*m).bytes.as_slice();
        P = (*m).bytes.as_slice().ptr;
    }
}

// Moves the tables (the old storage poisoned and kept), re-takes every
// view of them; returns k.
fn move_table(t: *Table, k: i64) -> i64 {
    // UNSAFE: main's tables, through TB, and t's view.
    // SAFETY: as in reset.
    unsafe {
        let m = tb();
        var w: Vec<i64, Arena> = Vec::new_in((*m).arena);
        for x in (*m).v { w.push(x); }
        for i in 0..(*m).v.len() { (*m).v.set(i, 99); }
        (*m).old.push((*m).v);
        (*m).v = w;
        t.view = (*m).v.as_slice();
        var b: Vec<u8, Arena> = Vec::new_in((*m).arena);
        for x in (*m).bytes { b.push(x); }
        for i in 0..(*m).bytes.len() { (*m).bytes.set(i, 99); }
        (*m).bytes = b;
        S = (*m).bytes.as_slice();
        SS[1] = (*m).bytes.as_slice();
        P = (*m).bytes.as_slice().ptr;
    }
    k
}

fn via_param(t: *Table) -> i64 { unsafe { t.view[move_table(t, 2)] } }

fn main(gpa: Gpa) -> i32 {
    let arena = Arena::new_in(gpa);
    var tables: Tables<Arena> = Tables {
        arena: arena, v: Vec::new_in(arena), old: Vec::new_in(arena),
        bytes: Vec::new_in(arena),
    };
    // UNSAFE: tables' address kept in the static, as bytes.
    // SAFETY: tables lives to the end of main, past every use of TB.
    unsafe { TB = &tables as *Tables<Arena> as *u8; }
    var out = Buf::new_in(gpa);
    var t = Table { view: tables.v.as_slice(), pad: 0 };
    reset(&t);
    out.push_int(t.view[move_table(&t, 1)]);
    reset(&t);
    out.push(' ');
    out.push_int(via_param(&t));
    reset(&t);
    t.view[move_table(&t, 3)] = 7;
    out.push(' ');
    out.push_int(tables.v.get(3));
    reset(&t);
    t.view[move_table(&t, 4)] += 100;
    out.push(' ');
    out.push_int(tables.v.get(4));
    println(out.as_slice());
    out.clear();

    // Slicing: the bounds, then the slice.
    reset(&t);
    out.push_int(S[move_table(&t, 1)..][0] as i64);
    reset(&t);
    out.push(' ');
    out.push_int(S[..move_table(&t, 3)][2] as i64);
    reset(&t);
    out.push(' ');
    out.push_int(S[move_table(&t, 1)..move_table(&t, 4)][1] as i64);
    reset(&t);
    out.push(' ');
    out.push_int(t.view[move_table(&t, 2)..=5][0]);
    reset(&t);
    out.push(' ');
    out.push_int(SS[1][move_table(&t, 5)] as i64);
    reset(&t);
    out.push(' ');
    out.push_int(SS[1][move_table(&t, 5)..][1] as i64);
    println(out.as_slice());
    out.clear();

    // A local view re-taken inside the index.
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in 0..4 { v.push(x); }
    var s = v.as_slice();
    let a = s[{
        for x in 0..1000 { v.push(x); }
        s = v.as_slice();
        3
    }];
    let b = s[{
        for x in 0..1000 { v.push(x); }
        s = v.as_slice();
        1
    } ..3][1];
    out.push_int(a);
    out.push(' ');
    out.push_int(b);
    println(out.as_slice());
    out.clear();

    // Vector loads and stores: s, the index, then s's pointer and length.
    reset(&t);
    out.push_int(v2i64::load(t.view, move_table(&t, 2)).sum());
    reset(&t);
    v2i64::splat(5).store(t.view, move_table(&t, 6));
    out.push(' ');
    out.push_int(tables.v.get(6) + tables.v.get(7));
    println(out.as_slice());
    out.clear();

    // Raw pointers (unsafe code) the same: the pointer is read after the index.
    reset(&t);
    out.push_int(unsafe { P[move_table(&t, 3)] } as i64);
    reset(&t);
    unsafe { P[move_table(&t, 0)] = 1; }
    out.push(' ');
    out.push_int(tables.bytes.get(0) as i64);
    reset(&t);
    unsafe { P[move_table(&t, 1)] += 1; }
    out.push(' ');
    out.push_int(tables.bytes.get(1) as i64);
    reset(&t);
    out.push(' ');
    out.push_int(unsafe { P[move_table(&t, 2)..move_table(&t, 4)] } [1] as i64);
    var q = tables.bytes.as_slice().ptr;
    out.push(' ');
    out.push_int(unsafe {
        q[{
            move_table(&t, 0);
            q = tables.bytes.as_slice().ptr;
            5
        }]
    } as i64);
    println(out.as_slice());
    // (--values=off: nothing drops)
    v.free();
    out.free();
    0
}

// EXPECT: 11 12 7 114
// EXPECT: 21 22 22 12 25 26
// EXPECT: 3 2
// EXPECT: 25 10
// EXPECT: 23 1 22 23 25
