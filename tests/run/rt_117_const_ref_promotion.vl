// XFAIL: RT-117: a const reference to a struct or nested slice literal (`const A: &P = &P { .. }`) is refused as dropped while borrowed; rustc promotes it (0.30.2)
// From c302const (pre-existing, r5_p12/p13). rustc prints the EXPECT line.
// EXPECT: 3 4 3
struct P {
    x: u8,
    y: u8,
}

const A: &P = &P { x: 3, y: 4 };
const B: &[&[u8]] = &[&[1, 2], &[3]];

fn main() {
    println("{} {} {}", A.x, A.y, B[1][0]);
}
