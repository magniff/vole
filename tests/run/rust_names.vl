// (0.27.0) MVS's keywords that are not Rust's (`var`, `inout`, `sink`,
// `defer`) are names in the rust edition.

struct Slot {
    var: i64,
    inout: i64,
}

fn sink(defer: i64) -> i64 {
    defer + 1
}

fn main() -> i32 {
    let s = Slot { var: 2, inout: 3 };
    let sink_v = sink(s.var * s.inout);
    println("{}", sink_v);
    0
}
// EXPECT: 7
