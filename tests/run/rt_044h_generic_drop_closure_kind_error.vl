// RULE: D19.6
// (0.30.2, RT-44) A closure made in a generic Drop impl's instance that
// does not meet its bound: closure.kind (rustc E0525), reported once, and
// the bodies that would be borrow-checked with a kind it does not have
// are left out (place_late_closures, as at the start).
// ERROR: error[closure.kind]
// ERROR: line 23, column 17
// ERROR-COUNT: 1
fn call_fn<F: Fn()>(f: &F) {
    f();
    f();
}

struct W<T> {
    n: i64,
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let mut k = 0i64;
        let r = &mut k;
        let c = || {
            *r += 1;
        };
        call_fn(&c);
        println("drop {}", k);
    }
}

fn main() {
    let w = W { n: 10, t: 1u8 };
    let _ = &w.t;
    println("ok");
}
