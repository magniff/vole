// EDITION: rust
// RULE: D19.2
// (0.27.2) Writing through a captured `&mut` makes the capture `&mut`
// without the binding being `mut` (rustc's unique borrow).
// EXPECT: 3
fn main() {
    let mut x = 1;
    let r = &mut x;
    let mut f = || *r += 1;
    f();
    f();
    println("{}", x);
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
