// XFAIL: std is not the edition's std until 0.27.2's switch (front272 M3)
// The std item(s): std::iter Iterator::filter_map.
// EXPECT: [1, 3]

fn main(gpa: Gpa) {
    let s = Vec::from_in(["1", "x", "3"], gpa);
    let a: Vec<i64, Gpa> = s.iter().filter_map(|t| t.parse().ok()).collect_in(gpa);
    println("{:?}", a);
}
