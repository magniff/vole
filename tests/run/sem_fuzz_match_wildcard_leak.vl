// EDITION: rust
// (0.25, the semantics fuzzer) A by-value match on an owned enum that
// moves some of the payload out leaks the rest: the parts bound by `_`
// or `..`, and the whole value when it takes a wildcard arm of a match
// with a binding arm elsewhere. Every Tracked value must be dropped once.
// EXPECT: a1
// EXPECT: d1
// EXPECT: d2
// EXPECT: a3
// EXPECT: d3
// EXPECT: d4
// EXPECT: a5
// EXPECT: d5
// EXPECT: d6
// EXPECT: wild
// EXPECT: d7
// EXPECT: d8
// EXPECT: live 0

static mut NEXT: i64 = 0;
static mut LIVE: i64 = 0;
struct T { id: i64 }
fn mk() -> T { unsafe { NEXT += 1; } unsafe { LIVE += 1; } T { id: unsafe { NEXT } } }

impl Drop for T {
    fn drop(&mut self) { unsafe { LIVE -= 1; } println("d{}", self.id); }
}

enum E { One(T), Two { a: T, b: T } }
enum F { P(T, T), Q }

fn run() {
    { let e = E::Two { a: mk(), b: mk() };
        match e { E::Two { a, b: _ } => println("a{}", a.id), _ => {} } }
    { let e = E::Two { a: mk(), b: mk() };
        match e { E::Two { a, .. } => println("a{}", a.id), _ => {} } }
    { let e = F::P(mk(), mk()); match e { F::P(a, _) => println("a{}", a.id), _ => {} } }
    { let e = E::Two { a: mk(), b: mk() };
        match e { E::One(t) => println("t{}", t.id), _ => println("wild") } }
}

fn main() -> i32 {
    run();
    let live_now = unsafe { LIVE }; println("live {live_now}");
    0
}
