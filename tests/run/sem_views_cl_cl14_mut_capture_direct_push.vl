// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: v pushed directly while a mutating closure is live
// ERROR: error[borrowck.mut_twice]
// ERROR: line 8, column 5
fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut add = |x: i64| v.push(x);
    add(1);
    v.push(5);
    add(2);
    println("{}", v.len());
    0
}
