// EDITION: rust
// RULE: AT6
// (0.27.2) The scope's body changes what a thread borrows: the thread's loan
// lasts to the end of 'scope, so the push conflicts (rustc E0502).
use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    thread::scope(|s| {
        s.spawn(|| {
            println("{}", v.len());
        });
        v.push(2);
    });
}
// ERROR: error[borrowck.conflict]
// ERROR: line 14, column 9
