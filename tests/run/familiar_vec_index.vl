// EDITION: rust
// 0.17: `v[i]` on a Vec or a Buf is `v.as_slice()[i]`: read, assign,
// compound-assign, a field of an element, slicing; checked.
// EXPECT: 15 2 7
// EXPECT: 3 2 7
// EXPECT: Hey 3
// EXPECT: 11 20
#[derive(Clone, Copy)] struct Pt { x: i64, y: i64 }

fn bump(v: &mut Vec<i64, Gpa>) { v[0] += 1; }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(2);
    v.push(9);
    v[0] += 10;
    v[2] = v[1] + 5;
    println("{} {} {}", v[0], v[1], v[2]);
    let tail = &v[1..];
    println("{} {} {}", v[0..3].len(), tail.len(), tail[1]);
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(b"hey");
    b[0] = b'H';
    println("{} {}", &str::from_utf8(b[0..3]).unwrap(), b.as_slice().len());
    let mut ps: Vec<Pt, Gpa> = Vec::new_in(gpa);
    ps.push(Pt { x: 10, y: 20 });
    ps[0].x += 1;
    bump(&mut v);
    println("{} {}", ps[0].x, ps[0].y);
    if v[0] != 16 { return 1; }
    0
}
