// RULE: C3.4
// (0.30.2, the re-review 2 of g302holes: holes/q10_mutref_slice_index)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'from_raw_parts_mut<i64>', which writes through a raw pointer what it did not make
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

// &mut [i64] param of a callee given a slice made in the clause
fn set0(s: &mut [i64]) -> bool { s[0] = 9; true }

fn f(p: *mut i64) -> i64
    requires set0(unsafe { std::slice::from_raw_parts_mut(p, 1) })
{ 1 }

fn main() { let mut x = 1i64; println("{}", f(&raw mut x)); println("{}", x); }
