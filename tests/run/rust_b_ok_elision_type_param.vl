// EDITION: rust
// RULE: D4.2
// (0.27.2) E2 counts the lifetimes written in the inputs: a type
// parameter's slots are not one, so `fn put<T, A>(a: &A, x: T) -> &T`
// borrows from `a` (rustc accepts; std2's alloc_in has this shape), also
// in an instance whose T has a reference.
struct Arena {
    slot: i64,
}

fn first<T, A>(a: &A, x: T) -> &A {
    let _ = x;
    a
}

fn main() {
    let ar = Arena { slot: 7 };
    let k = 1;
    let r = first(&ar, &k);
    println("{}", r.slot);
}
// EXPECT: 7
