// RULE: D4.4
// (0.27.2) A projection's regions are the substitution's: the item
// `Fuse<Iter<'a, i32>>::next` returns borrows the array, so it cannot
// outlive it.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 12, column 22
// ERROR-COUNT: 1
fn main() {
    let x;
    {
        let a = [1i32, 2, 3];
        let mut it = a.iter().fuse();
        x = it.next();
    }
    println("{}", x.is_some());
}
