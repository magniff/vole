// EDITION: rust
// RULE: D8.3
// (0.27.2) An f-string's argument that is a value, not a place, is owned
// by its hidden binding and dropped at the end of the statement, as
// rustc's temporaries: `println("{}", make(1))` drops the value before
// the next statement; a place argument is only read, not dropped.
#[derive(Debug)]
struct Noisy {
    n: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn make(n: i64) -> Noisy {
    Noisy { n: n }
}

fn main() {
    let kept = make(0);
    println("{} {}", make(1).n, kept.n);
    println("then");
    println("{:?}", make(2));
    println("end {}", kept.n);
}
// EXPECT: 1 0
// EXPECT: drop 1
// EXPECT: then
// EXPECT: Noisy { n: 2 }
// EXPECT: drop 2
// EXPECT: end 0
// EXPECT: drop 0
