// RULE: F8.3, F8.4
// The same in a generic body under `T: Conv<bool, u8> + Conv<bool, i64>`, in the instance for S (rustc 21)
// From the second round of the qualified paths: the arguments a path writes beside a `_` choose the impl (convert::dispatch's wargs); fails on v0.30.1 ("ambiguous").
// EXPECT: 21
trait Conv<A, B> {
    fn c(x: A) -> i64;
}

struct S;

impl Conv<bool, i64> for S {
    fn c(x: bool) -> i64 {
        1
    }
}

impl Conv<bool, u8> for S {
    fn c(x: bool) -> i64 {
        2
    }
}

fn k<T: Conv<bool, u8> + Conv<bool, i64>>() -> i64 {
    <T as Conv<_, u8>>::c(true) * 10 + <T as Conv<_, i64>>::c(true)
}

fn main() {
    println("{}", k::<S>());
}
