// EDITION: rust
// RULE: D3.3
// (0.28.0) The loan an array of references holds ends with its last use:
// s is changed after r's.
// EXPECT: hello world x
// EXPECT: hello worldXX
fn main(gpa: Gpa) {
    let mut s = String::from_in("hello world", gpa);
    let a = [s.as_str(), "x"];
    let r = a[0];
    println("{} {}", r, a[1]);
    s.push_str("XX");
    println("{}", s);
}
