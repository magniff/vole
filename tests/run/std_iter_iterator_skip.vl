// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::skip.
// EXPECT: [3, 4] 0

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().skip(2).collect_in(gpa);
    println("{:?} {}", a, v.iter().skip(9).count());
}
