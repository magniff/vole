// places IR (0.26.1, R4): a match on an integer or an enum, its arms
// values, is one switch with a target per value; an enum's arm with
// several values is reached through a block per value, so that each
// edge says which variant the scrutinee is (the payload moved out on one
// arm is not dropped again).
// FLAGS: --check-alloc --verify-places
// EXPECT: 268
// EXPECT: 0 0 1 7 6
// EXPECT: 0 0 1 7 6
// PLACES: fn small
// PLACES: switch copy _1 [0: bb3, 1: bb4, 2: bb4, 3: bb5, 4: bb6, 5: bb6, 6: bb6, 7: bb7, otherwise: bb8]
// PLACES: fn size
// PLACES: switch copy _2 [0: bb8, 1: bb9, 2: bb4, 3: bb5, 4: bb6, otherwise: bb7]
// PLACES: fn take
// PLACES: switch copy _2 [0: bb8, 1: bb9, 2: bb4, 3: bb5, 4: bb6, otherwise: bb7]
enum Shape { Dot, Line(i64), Box(Vec<i64>), Pair(Vec<i64>, i64), Tri(i64, i64, i64) }

fn small(x: i64) -> i64 {
    match x {
        0 => 10,
        1 | 2 => 20,
        3 => 30,
        4..=6 => 40,
        7 => 70,
        _ => -1,
    }
}

fn size(s: Shape) -> i64 {
    match s {
        Shape::Dot | Shape::Line(_) => 0,
        Shape::Box(v) => v.len() as i64,
        Shape::Pair(v, k) => v.len() as i64 + k,
        Shape::Tri(a, b, c) => a + b + c,
    }
}

fn len_of(v: sink Vec<i64>) -> i64 {
    v.len() as i64
}

fn take(s: sink Shape) -> i64 {
    match s {
        Shape::Dot | Shape::Line(_) => 0,
        Shape::Box(v) => len_of(v),
        Shape::Pair(v, k) => len_of(v) + k,
        Shape::Tri(a, b, c) => a + b + c,
    }
}

fn vec_of(gpa: Gpa, n: i64) -> Vec<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn main(gpa: Gpa) {
    var t = 0;
    for i in -1..9 {
        t += small(i);
    }
    println(f"{t}");
    let a = size(Shape::Dot);
    let b = size(Shape::Line(3));
    let c = size(Shape::Box(vec_of(gpa, 1)));
    let d = size(Shape::Pair(vec_of(gpa, 2), 5));
    let e = size(Shape::Tri(1, 2, 3));
    println(f"{a} {b} {c} {d} {e}");
    let a2 = take(Shape::Dot);
    let b2 = take(Shape::Line(3));
    let c2 = take(Shape::Box(vec_of(gpa, 1)));
    let d2 = take(Shape::Pair(vec_of(gpa, 2), 5));
    let e2 = take(Shape::Tri(1, 2, 3));
    println(f"{a2} {b2} {c2} {d2} {e2}");
}
