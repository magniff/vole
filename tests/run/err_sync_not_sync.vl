// EDITION: rust
// (0.21) A value shared with scoped threads may not hold a raw pointer:
// it could change through a shared reference without a lock.
// ERROR: error[sync.not_send]
// ERROR: line 16, column 17

use std::thread;

#[derive(Clone, Copy)] struct Cache { slots: *mut i64, n: i64 }

fn main() {
    let mut x: i64 = 3;
    let mut c = Cache { slots: &mut x as *mut i64, n: 1 };
    c.n += 1;
    let n = thread::scope(|s| ({ let s = s; {
        let h = s.spawn(|| c.n);
        h.join().unwrap()
    } }));
    println("{n}");
}
