// EDITION: rust
// RULE: F19.2, F19.4
// `use a::{self, B}` imports the module a by its name beside B;
// `size_of::<T>()` is the constant of T's size.
// EXPECT: 20
mod shapes {
    pub mod circle {
        pub struct Circle {
            pub r: i64,
        }

        pub fn area(c: &Circle) -> i64 {
            3 * c.r * c.r
        }
    }
}

use shapes::circle::{Circle, self};

fn main() -> i64 {
    let c = Circle { r: 2 };
    std::print_int(circle::area(&c) + size_of::<i64>() as i64);
    println("");
    0
}
