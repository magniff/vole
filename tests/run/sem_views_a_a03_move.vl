fn eat(v: Vec<i64, Gpa>) { println("{}", v.len()); }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let sl = v.as_slice();
    eat(v);
    println("{}", sl[0]);
    0
}
