// RULE: F6.2
// rustc's probe on `&S`, `&&S` and `&mut S` receivers with inherent
// methods on S and trait impls on `&S` and `&mut S` (each line rustc's
// answer): `r.g()` finds the `&S` impl at `&&S` (S's `g(self)` wants an
// S), `rr.j()` and `r.j()` S's `j(&self)` before the impl's at one step
// (inherent first), `m.i()` the `&mut S` impl's at `&&mut S` before
// S's `&self` one at the next autoderef.
// EXPECT: 51 80 80 90
// EXPECT: 90
// EXPECT: 60 71
// EXPECT: 50
struct S {
    n: i64,
}

trait G2 {
    fn g(&self) -> i64;
}

impl S {
    fn g(self) -> i64 {
        50
    }
}

impl<'a> G2 for &'a S {
    fn g(&self) -> i64 {
        51
    }
}

trait H2 {
    fn h(self) -> i64;
}

impl S {
    fn h(&mut self) -> i64 {
        60
    }
}

impl<'a> H2 for &'a S {
    fn h(self) -> i64 {
        61
    }
}

trait I2 {
    fn i(&self) -> i64;
}

impl S {
    fn i(&self) -> i64 {
        70
    }
}

impl<'a> I2 for &'a mut S {
    fn i(&self) -> i64 {
        71
    }
}

trait J2 {
    fn j(self) -> i64;
}

impl S {
    fn j(&self) -> i64 {
        80
    }
}

impl<'a> J2 for &'a S {
    fn j(self) -> i64 {
        81
    }
}

trait K1 {
    fn k(&self) -> i64;
}

trait K2 {
    fn k(&mut self) -> i64;
}

impl K1 for S {
    fn k(&self) -> i64 {
        90
    }
}

impl<'a> K2 for &'a S {
    fn k(&mut self) -> i64 {
        91
    }
}

fn main() {
    let mut s = S { n: 0 };
    {
        let r = &s;
        let rr = &r;
        println("{} {} {} {}", r.g(), rr.j(), r.j(), r.k());
        println("{}", s.k());
    }
    {
        let m = &mut s;
        println("{} {}", m.h(), m.i());
    }
    println("{}", s.g());
}
