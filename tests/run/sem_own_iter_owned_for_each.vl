// EDITION: rust
// sem-own: owned items given to for_each: each dropped in the closure (0.25.3).
// EXPECT: it 0
// EXPECT: drop 0
// EXPECT: it 1
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    (0i64..2i64).map(|i| mk(i, gpa)).for_each(|d| println("it {}", d.id));
    println("end");
}
