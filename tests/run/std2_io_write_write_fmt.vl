use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.write_fmt(format_args("n={}", 7)).unwrap();
    let mut o = io::stdout();
    write(o, "n={} ", 7).unwrap();
    println("{:?}", v);
}
