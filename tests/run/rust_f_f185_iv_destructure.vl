// RULE: F18.5
// (0.30.2) A destructuring `let` of literals binds integer variables:
// `take(p + p)` types `p` i64 (FL6: 0.30.1 typed the tuple `(i32, i32)`
// at the `let`), and `q`, given no type, is the fallback i32.
// EXPECT: 4000000000 1 4
fn take(x: i64) -> i64 {
    x
}

fn main() {
    let (p, q) = (2000000000, 1);
    println("{} {} {}", take(p + p), q, std::mem::size_of_val(&q));
}
