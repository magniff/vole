// EDITION: rust
// RULE: AT6
// (0.27.2) Scoped threads borrow from the caller: one reads a Vec, one
// writes a counter (a `mut` capture whose `&mut i64` is Send); both
// borrows end with the scope, so the caller uses them after.
use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let mut total = 0;
    thread::scope(|s| {
        s.spawn(|| {
            println("{}", v.len());
        });
        s.spawn(|| {
            total += 5;
        });
    });
    println("{} {}", v.len(), total);
}
// EXPECT: 2
// EXPECT: 2 5
