use std::fmt::{Formatter, UpperExp};

struct W {
    v: f64,
}

impl UpperExp for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main() {
    println("{:E}", W { v: 1234.5f64 });
}
