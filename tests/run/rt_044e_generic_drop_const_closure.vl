// RULE: D19.1, D19.10
// (0.30.2, RT-44) A closure in an associated const's initializer of a
// generic impl, read only by a generic Drop impl's instance (made while
// the bodies are built, as rt_044b's). rustc takes no call of a closure in
// a const (E0015), so the const is the closure, as a `fn` value.
// EXPECT: ok
// EXPECT: drop 7
struct W<T> {
    t: T,
}

impl<T> W<T> {
    const F: fn(i64) -> i64 = |y| y + 5;
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let f = Self::F;
        println("drop {}", f(2));
    }
}

fn main() {
    let w = W { t: 1u8 };
    let _ = &w.t;
    println("ok");
}
