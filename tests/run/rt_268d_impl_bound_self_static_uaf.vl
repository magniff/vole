// XFAIL: RT-268: (the bound names Self) `impl<'a, U: Conv<Self>> Tr<U> for W<'a>` with only `impl Conv<W<'static>> for i64`: 'a is never tied to 'static, use after free (0.30.2)
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// RT-268c with the bound written `U: Conv<Self>` (Self is W<'a>).
// rustc refuses it (E0597: `st` does not live long enough, at the borrow
// `st.as_str()`). vole builds it, and the print reads the freed string:
// it prints XXXXXXXXXXXXXXXXXXXXXXX (the bytes of `other`), and under
// --check-alloc: "use after free: block #1 (23 bytes)". A bound written
// directly on a function (`fn need<'a, U: Conv<W<'a>>>`) or a direct method
// call ties the region; only the impl's own bound, met while the impl is
// chosen for a generic function's bound, does not.
// FLAGS: --check-alloc
// ERROR: error[
// ERROR: line 47, column 24
// ERROR-COUNT: 1
trait Conv<X> {
    fn c(x: &X) -> &'static str;
}

trait Tr<U> {
    fn g(&self) -> &'static str;
}

struct W<'a> {
    r: &'a str,
}

impl Conv<W<'static>> for i64 {
    fn c(x: &W<'static>) -> &'static str {
        x.r
    }
}

impl<'a, U: Conv<Self>> Tr<U> for W<'a> {
    fn g(&self) -> &'static str {
        U::c(self)
    }
}

fn need<T: Tr<i64>>(t: &T) -> &'static str {
    t.g()
}

fn main(gpa: Gpa) {
    let mut keep: &'static str = "none";
    {
        let st = String::from_in("hello hello hello hello", gpa);
        let w = W { r: st.as_str() };
        keep = need(&w);
    }
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", keep, other.len());
}
