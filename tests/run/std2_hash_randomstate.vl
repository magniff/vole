// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::hash RandomState.
// EXPECT: true true
use std::hash::{BuildHasher, Hash, Hasher, RandomState};

fn main() {
    let s = RandomState::new();
    let mut h = s.build_hasher();
    5u64.hash(&mut h);
    println("{} {}", s.hash_one(5u64) == s.hash_one(5u64), h.finish() == s.hash_one(5u64));
}
