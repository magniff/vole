// RULE: F8.4
// RT-234: a generic trait's function named through the implementing type,
// as a value, takes the trait's arguments from the expected fn type: a
// `let f: fn(E1) -> E2 = E2::from`, and a parameter bounded by Fn
// (`.map(E2::from)`, `.map_err(E2::from)`: map's `F: FnOnce(T) -> U`, T
// known). `<E2 as From<E1>>::from` and `<E2 as Conv<i64>>::mk` too. 0.30.1:
// "no associated function 'from' in 'E2'". rustc prints the EXPECT line.
// EXPECT: Some(E2 { c: 11 }) Err(E2 { c: 13 }) E2 { c: 14 } E2 { c: 15 } Some(E2 { c: 107 }) 108 E1 { c: 5 }
#[derive(Debug)]
struct E1 {
    c: i64,
}

#[derive(Debug)]
struct E2 {
    c: i64,
}

impl From<E1> for E2 {
    fn from(e: E1) -> E2 {
        E2 { c: e.c + 10 }
    }
}

trait Conv<X> {
    fn mk(x: X) -> Self;
}

impl Conv<i64> for E2 {
    fn mk(x: i64) -> E2 {
        E2 { c: x + 100 }
    }
}

impl Conv<bool> for E2 {
    fn mk(x: bool) -> E2 {
        E2 { c: if x { 1 } else { 0 } }
    }
}

trait Mk {
    fn mk1(k: i64) -> Self;
}

impl Mk for E1 {
    fn mk1(k: i64) -> E1 {
        E1 { c: k }
    }
}

fn main() {
    let w: Option<E2> = Some(E1 { c: 1 }).map(E2::from);
    let r: Result<i64, E1> = Err(E1 { c: 3 });
    let y: Result<i64, E2> = r.map_err(E2::from);
    let f: fn(E1) -> E2 = E2::from;
    let q = <E2 as From<E1>>::from;
    let m: Option<E2> = Some(7i64).map(E2::mk);
    let k: fn(i64) -> E2 = E2::mk;
    let g = E1::mk1;
    println("{:?} {:?} {:?} {:?} {:?} {} {:?}", w, y, f(E1 { c: 4 }), q(E1 { c: 5 }), m, k(8).c,
        g(5));
}
