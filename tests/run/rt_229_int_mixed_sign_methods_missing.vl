// XFAIL: RT-229: the mixed-sign methods are missing: checked/wrapping/saturating/overflowing_add_signed and cast_signed on unsigned integers, checked/wrapping/saturating_add_unsigned, checked_sub_unsigned and cast_unsigned on signed ones (0.30.2)
// rustc 1.98 prints the EXPECT lines (twin: r302e_006_int_mixed_sign.rs.txt); guide rust does not list them as missing.
// EXPECT: i8 Some(2) 2 2 Some(-16) 249
// EXPECT: i16 Some(2) 2 2 Some(-16) 65529
// EXPECT: i32 Some(2) 2 2 Some(-16) 4294967289
// EXPECT: i64 Some(2) 2 2 Some(-16) 18446744073709551609
// EXPECT: isize Some(2) 2 2 Some(-16) 18446744073709551609
// EXPECT: u8 None 255 0 (255, true) -1
// EXPECT: u16 None 65535 0 (65535, true) -1
// EXPECT: u32 None 4294967295 0 (4294967295, true) -1
// EXPECT: u64 None 18446744073709551615 0 (18446744073709551615, true) -1
// EXPECT: usize None 18446744073709551615 0 (18446744073709551615, true) -1
fn main() {
    let a: i8 = -7;
    let b: i8 = 3;
    println("i8 {:?} {:?} {:?} {:?} {:?}", a.checked_add_unsigned(9), a.wrapping_add_unsigned(9),
        a.saturating_add_unsigned(9), a.checked_sub_unsigned(9), a.cast_unsigned());
    let a: i16 = -7;
    let b: i16 = 3;
    println("i16 {:?} {:?} {:?} {:?} {:?}", a.checked_add_unsigned(9), a.wrapping_add_unsigned(9),
        a.saturating_add_unsigned(9), a.checked_sub_unsigned(9), a.cast_unsigned());
    let a: i32 = -7;
    let b: i32 = 3;
    println("i32 {:?} {:?} {:?} {:?} {:?}", a.checked_add_unsigned(9), a.wrapping_add_unsigned(9),
        a.saturating_add_unsigned(9), a.checked_sub_unsigned(9), a.cast_unsigned());
    let a: i64 = -7;
    let b: i64 = 3;
    println("i64 {:?} {:?} {:?} {:?} {:?}", a.checked_add_unsigned(9), a.wrapping_add_unsigned(9),
        a.saturating_add_unsigned(9), a.checked_sub_unsigned(9), a.cast_unsigned());
    let a: isize = -7;
    let b: isize = 3;
    println("isize {:?} {:?} {:?} {:?} {:?}", a.checked_add_unsigned(9), a.wrapping_add_unsigned(9),
        a.saturating_add_unsigned(9), a.checked_sub_unsigned(9), a.cast_unsigned());
    let a: u8 = 7;
    let b: u8 = u8::MAX;
    println("u8 {:?} {:?} {:?} {:?} {:?}", a.checked_add_signed(-8), a.wrapping_add_signed(-8),
        a.saturating_add_signed(-8), a.overflowing_add_signed(-8), b.cast_signed());
    let a: u16 = 7;
    let b: u16 = u16::MAX;
    println("u16 {:?} {:?} {:?} {:?} {:?}", a.checked_add_signed(-8), a.wrapping_add_signed(-8),
        a.saturating_add_signed(-8), a.overflowing_add_signed(-8), b.cast_signed());
    let a: u32 = 7;
    let b: u32 = u32::MAX;
    println("u32 {:?} {:?} {:?} {:?} {:?}", a.checked_add_signed(-8), a.wrapping_add_signed(-8),
        a.saturating_add_signed(-8), a.overflowing_add_signed(-8), b.cast_signed());
    let a: u64 = 7;
    let b: u64 = u64::MAX;
    println("u64 {:?} {:?} {:?} {:?} {:?}", a.checked_add_signed(-8), a.wrapping_add_signed(-8),
        a.saturating_add_signed(-8), a.overflowing_add_signed(-8), b.cast_signed());
    let a: usize = 7;
    let b: usize = usize::MAX;
    println("usize {:?} {:?} {:?} {:?} {:?}", a.checked_add_signed(-8), a.wrapping_add_signed(-8),
        a.saturating_add_signed(-8), a.overflowing_add_signed(-8), b.cast_signed());
}
