// XFAIL: RT-50: a const of a reference to a struct literal is refused as a dropped temporary (0.30.2)
// rustc promotes the literal to a static (constant promotion) and prints
// 3 7. vole: error[borrowck.dropped_borrowed] at the literal, once for
// each use of the const. The tuple (and `&[7, 8]`, `&5`) is accepted.
// EXPECT: 3 7
struct P {
    a: i64,
}

const K: &P = &P { a: 3 };
const L: &(i64, i64) = &(7, 8);

fn main() -> i32 {
    println("{} {}", K.a, L.0);
    0
}
