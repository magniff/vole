// sem-own: `for x in arr` over an array local of owned values, keeping x: refused: the items are borrowed from the array.
// ERROR: own.move_out
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let arr = [mk(1, gpa), mk(2, gpa)];
    var keep: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for x in arr { keep.push(x); }
    println("n {}", keep.len());
}
