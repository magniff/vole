use std::sync::Mutex;

fn main(gpa: Gpa) {
    let text: &str = "hello world";
    let d: Vec<&str, Gpa> = Vec::new_in(gpa);
    let m = Mutex::new(d);
    m.with(|d| d.push(text));
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    let n = Mutex::new(v);
    let x = n.with(|d| d[0]);
    let len = m.with(|d| d[0].len());
    println("{x} {len}");
}
