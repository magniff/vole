// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::cycle.
// EXPECT: [1, 2, 1, 2, 1]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().cycle().take(5).collect_in(gpa);
    println("{:?}", a);
}
