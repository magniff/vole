// EDITION: rust
// RULE: E3.3a
// (0.27.2.1) `#[effects(T)]` on a generic method: an instance whose T
// prints passes the print to its callers (the caller's set has io), an
// instance whose T does not adds nothing.
// EXPECT: clone
// EXPECT: 5 7
struct W<T> {
    x: T,
}

impl<T: Clone> W<T> {
    #[effects(T)]
    pub fn dup(&self) -> T {
        self.x.clone()
    }
}

struct Loud {
    n: i64,
}

impl Clone for Loud {
    fn clone(&self) -> Loud {
        println("clone");
        Loud { n: self.n }
    }
}

#[effects(io, T)]
fn loud_dup<T: Clone>(w: &W<T>) -> T {
    w.dup()
}

#[pure]
fn quiet_dup(w: &W<i64>) -> i64 {
    w.dup()
}

fn main() {
    let w = W { x: Loud { n: 5 } };
    let q = W { x: 7 };
    let v = loud_dup(&w);
    println("{} {}", v.n, quiet_dup(&q));
}
