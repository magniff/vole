// XFAIL: RT-388: UNSOUND: an impl's bound `T: Get<Out = W<'a>>` ties 'a to the impl's region only through the associated-type equality, and that equality is dropped when the impl is chosen for a nested obligation (`need<Z: Tr>` with Z = H<'a, i64>): `i64`'s `Out = W<'static>` should force 'a = 'static, a borrow of a dropped String escapes as `&'static str` (rustc E0597) (0.30.2)
// From the review of g302bor2 (form A/a04). Since v0.30.1 at least; the
// release build the same. rustc E0597 (`st` does not live long enough) at
// the borrow (the rustc twin of this file). vole builds it and
// --check-alloc reports a use after free of st's buffer. The mechanism is
// in impl_bound_ties: the impl's nested obligation's associated-type
// equality never ties its regions. Sub-forms: rt_388b (the bound in a
// `where` clause), rt_388c (`I: Iterator<Item = &'a i64>`, no use after
// free). A direct call with the bound on a fn (`fn f<T: Get<Out = W<'a>>>`)
// is refused right.
// FLAGS: --check-alloc
// ERROR: line 53
trait Get {
    type Out;
    fn get(&self, w: Self::Out) -> &'static str;
}

trait Tr {
    fn g(self) -> &'static str;
}

struct W<'a> {
    r: &'a str,
}

impl Get for i64 {
    type Out = W<'static>;

    fn get(&self, w: W<'static>) -> &'static str {
        w.r
    }
}

struct H<'a, T> {
    w: W<'a>,
    t: T,
}

impl<'a, T: Get<Out = W<'a>>> Tr for H<'a, T> {
    fn g(self) -> &'static str {
        self.t.get(self.w)
    }
}

fn need<Z: Tr>(z: Z) -> &'static str {
    z.g()
}

fn main(gpa: Gpa) {
    let mut keep: &'static str = "none";
    {
        let st = String::from_in("hello hello hello hello", gpa);
        let w = W { r: st.as_str() };
        keep = need(H { w: w, t: 0i64 });
    }
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", keep, other.len());
}
