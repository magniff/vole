// RULE: F29.3
// (0.30.1) Where vole's widening of an i32 gives Rust's value it stays:
// a literal, an element of a literal array or tuple, an Option's value,
// each operand of a sum checked against i64 (each is widened, then
// added), a loop's binding, a local open until its use (F18.5: `acc`).
// rustc prints the same (it types the literals i64 from the use). An i32
// written as such widens too (widen_*), which rustc refuses.
// EXPECT: 4000000000 4000000000 4000000000 4000000000 4000000000
// EXPECT: 6 30 7 12 1000
#[inline(never)]
fn take(x: i64) -> i64 {
    x
}

fn main(gpa: Gpa) {
    let s = 2000000000;
    let t = s + s;
    let c = (2000000000, 1);
    let o = Some(2000000000);
    let y = o.unwrap();
    let arr = [2000000000, 2];
    let mut v = Vec::new_in(gpa);
    v.push(2000000000);
    println("{} {} {} {} {}", take(t), take(c.0 + c.0), take(y + y), take(arr[0] + arr[0]),
        take(v[0] + v[0]));
    let mut sum: i64 = 0;
    for x in [1, 2, 3] {
        sum += take(x);
    }
    let k: i32 = 10;
    let w = k as i64 * 3;
    let mut acc = 1;
    acc = acc * 1000;
    println("{} {} {} {} {}", sum, w, take(7), take((k + 2) as i64), take(acc));
}
