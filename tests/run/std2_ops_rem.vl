// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops Rem.
// EXPECT: V { x: 2 }
use std::ops::Rem;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Rem for V {
    type Output = V;

    fn rem(self, rhs: V) -> V {
        V { x: self.x % rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?}", a % b);
}
