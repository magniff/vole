// RULE: D4.6
// (0.27.4) An iterator of `&str`s collects into a `Vec<&str>`: in std's
// `extend<I: IntoIterator<Item = T>>` and `Copied<I>`'s Iterator impl the
// items' region is T's (rustc compiles it).
// EXPECT: ["ab", "cde"] ["ab", "cde"]
fn main(gpa: Gpa) {
    let words = ["ab", "cde"];
    let a: Vec<&str, Gpa> = words.into_iter().collect_in(gpa);
    let b: Vec<&str, Gpa> = words.iter().copied().collect_in(gpa);
    println("{:?} {:?}", a, b);
}
