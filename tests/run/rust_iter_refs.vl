// EDITION: rust
// (0.27.0) `for` in the rust edition: `&v`, `&a` and a slice give `&T`,
// `&mut v` gives `&mut T`, a Vec or an array by value gives the values;
// `&x` patterns take the value through the reference. In 0.27.0 the
// edition runs on MVS std, whose `iter()` gives copies (edition.std_copy).

fn sum(v: &[i64]) -> i64 {
    let mut t = 0;
    for x in v {
        t += *x;
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let mut s = 0;
    for x in v.iter() {
        s += x;
    }
    for x in &v {
        s += *x;
    }
    for x in &mut v {
        *x *= 10;
    }
    let a = [1, 2, 3];
    for x in a {
        s += x;
    }
    for x in &a {
        s += *x;
    }
    for &x in &a {
        s += x;
    }
    let pairs = [(1, 2), (3, 4)];
    for &(p, q) in &pairs {
        s += p * q;
    }
    println("{} {}", s, sum(v.as_slice()));
    for x in v {
        s += x;
    }
    println("{}", s);
    0
}
// EXPECT: 38 30
// EXPECT: 68
// XFAIL: Vec::iter through Deref<Target=[T]> (front272 F20)
