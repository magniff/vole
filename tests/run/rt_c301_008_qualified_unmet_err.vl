// RULE: F8.4
// `<S as B>::m`, S having no impl of B: rustc E0277. 0.30.1 took A's m.
// ERROR: error[trait.unmet]: 'S' has no impl of 'B' that gives 'm'
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
fn main() { let s = S; let f = <S as B>::m; println("{}", f(&s)); }
