// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters Fuse::impl FusedIterator.
// EXPECT: true
use std::iter::FusedIterator;

fn fused<I: FusedIterator>(_: &I) -> bool {
    true
}

fn main(gpa: Gpa) {
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{}", fused(&e.iter().fuse()));
}
