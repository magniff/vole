// XFAIL: RT-426h: WRONG CODE: (RT-426's family, an impl's method) `size_of::<Self::Out>()` in `impl Sub for W` with `trait Sub: Tr<u16>` takes Tr<u8>'s Out: vole prints 8, rustc 1 (0.30.2)
// From the re-review of g302oblig M2 (its form c17_impl_trait_super_self_out). Since v0.30.1 at
// least (v0.30.1 and the release build print 8).
// EXPECT: 1
trait Tr<A> {
    type Out;
}

struct W;

impl Tr<u8> for W {
    type Out = i64;
}

impl Tr<u16> for W {
    type Out = u8;
}

trait Sub: Tr<u16> {
    fn sz(&self) -> usize;
}

impl Sub for W {
    fn sz(&self) -> usize {
        std::mem::size_of::<Self::Out>()
    }
}

fn main() {
    println("{}", W.sz());
}
