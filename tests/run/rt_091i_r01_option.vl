// (0.30.2, the re-review of g302holes: r91/r01_option)
// EXPECT: 13
// EXPECT: 23
// A closure returning an Option holding a closure that holds a closure.
fn main() {
    let k = 3i64;
    let mk = |a: i64| Some(move |b: i64| a * b + k);
    let g = mk(2).unwrap();
    println("{}", g(5));
    let w = [1i64, 2];
    let s: i64 = w.iter().map(|y| (Some(move |x: i64| x + *y)).map(|f| f(10)).unwrap()).sum();
    println("{s}");
}
