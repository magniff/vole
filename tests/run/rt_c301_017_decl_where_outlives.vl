// RT-C301-17 (0.30.1, review 8) A struct's or enum's `where 'b: 'c` is
// not trusted in a function's body: rustc's implied bounds give it for a
// parameter of the type (each program here is accepted by rustc), vole
// refuses each use (as the release build does). It is the safe side:
// nothing proves the predicate where a value is built (RT-37), and the
// inline form `'b: 'c` is trusted only because a call requires it. The
// obligation engine proves both at construction (0.30.2).
// XFAIL: RT-C301-17: a type's `where 'b: 'c` is not assumed in a body taking the type (0.30.2)
// EXPECT: 1
// EXPECT: abc
// EXPECT: abc
// EXPECT: abc
use std::alloc::Allocator;

struct S<'o, 'b, 'c, A: Allocator> where 'b: 'c { out: &'o mut Vec<&'c str, A>, s: &'b str }

fn g<'o, 'b, 'c, A: Allocator>(y: S<'o, 'b, 'c, A>) {
    y.out.push(y.s);
}

struct T<'b, 'c> where 'b: 'c { k: &'c u8, s: &'b str }

fn get<'b, 'c>(x: &T<'b, 'c>) -> &'c str {
    x.s
}

enum E<'b, 'c> where 'b: 'c {
    A(&'c u8, &'b str),
    B,
}

fn get_e<'b, 'c>(x: &E<'b, 'c>) -> &'c str {
    match x {
        E::A(_, s) => *s,
        E::B => "",
    }
}

impl<'b, 'c> T<'b, 'c> {
    fn get(&self) -> &'c str {
        self.s
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    let st = String::from_in("hello", gpa);
    {
        let x = S { out: &mut v, s: st.as_str() };
        g(x);
    }
    println("{}", v.len());
    let n: u8 = 1;
    let t = T { k: &n, s: "abc" };
    println("{}", get(&t));
    let e = E::A(&n, "abc");
    println("{}", get_e(&e));
    println("{}", t.get());
}
