// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops BitOrAssign.
// EXPECT: V { x: 13 }
use std::ops::BitOrAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitOrAssign for V {
    fn bitor_assign(&mut self, rhs: V) {
        self.x |= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a |= V { x: 5 };
    println("{:?}", a);
}
