// swapping owned values: each dropped once (check-alloc)
// EXPECT: 2 1
use std::mem; fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa); a.push(1);
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    b.push(2);
    b.push(3); mem::swap(&mut a, &mut b); println("{} {}", a.len(), b.len());
}
