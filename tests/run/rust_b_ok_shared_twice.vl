// (0.27.1) Two shared loans of one place and a read: (Read, S) and
// (Read-borrow, S) are fine.

fn main() {
    let x: i64 = 3;
    let a = &x;
    let b = &x;
    let t = x;
    println("{}", *a + *b + t);
}
