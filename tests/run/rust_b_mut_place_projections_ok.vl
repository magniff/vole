// RULE: D2.7
// (0.30.1, RT-33 round 3, F5) A mutable use of a place with an element
// index or a field between its slicings: `a[1..][0][..1].reverse()`,
// `&mut a[1..][0][..]`, `a[1..][0].reverse()`, `a[1..][0].b[..]`,
// `a[1..][0][0] = 9`, through a `&mut` too. Each slicing on the path is a
// mutable one (front/check/rust.vl mut_slicing walks every projection, as
// rustc's place has them). Before, the walk stopped at the element, and
// each was E0596 (0.30.0 and rustc accept).
// EXPECT: 7 8 2 4 6 5
struct P {
    b: [u8; 2],
}

fn main() {
    let mut a = [[1u8, 2], [3, 4]];
    a[1..][0][0] = 9;
    let r = &mut a[1..][0][..];
    r[1] = 8;
    let m = &mut a;
    m[0][..].reverse();
    m[1..][0][0] = 7;
    a[1..][0].reverse();
    a[0][..1].reverse();
    let mut ps = [P { b: [1, 2] }, P { b: [5, 6] }];
    ps[1..][0].b[..].reverse();
    println("{} {} {} {} {} {}", a[1][1], a[1][0], a[0][0], a[0][1] + 3, ps[1].b[0], ps[1].b[1]);
}
