// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter Iterator::is_sorted.
// EXPECT: true false true

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2, 2, 5], gpa);
    let b = Vec::from_in([3i64, 1], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{} {} {}", a.iter().is_sorted(), b.iter().is_sorted(), e.iter().is_sorted());
}
