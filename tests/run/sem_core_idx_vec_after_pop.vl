// EDITION: rust
// After pop the old last index is out of bounds.
// EXIT: 101
// STDERR: index out of bounds: index 1, length 1
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    let i = v.len() - 1;
    v.pop();
    println("{}", v[(i as i64 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
