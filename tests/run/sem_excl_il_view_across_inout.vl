fn grow(v: &mut Vec<i64, Gpa>) { for i in 0..100 { v.push(i); } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let s = v.as_slice(); grow(&mut v);
    println("{}", s[0]);
}
