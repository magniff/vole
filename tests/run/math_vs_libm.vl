// EDITION: rust
// std::math (0.25.2.1) against the system's libm (test code: C's math
// through unsafe): for each function, f64 and f32, many inputs over its
// domain; the largest difference in ulps, which must stay within the
// bound (0 for the exact ones: sqrt, floor, ...). The difference is ours
// and libm's error together: macOS's and glibc's differ.
// TIMEOUT: 4 tens of thousands of inputs per function, at -O0 too
// EXPECT: sqrt f64: {int} ulp
// EXPECT: cbrt f64: {int} ulp
// EXPECT: hypot f64: {int} ulp
// EXPECT: sin f64: {int} ulp
// EXPECT: cos f64: {int} ulp
// EXPECT: tan f64: {int} ulp
// EXPECT: sin_cos f64: {int} ulp
// EXPECT: asin f64: {int} ulp
// EXPECT: acos f64: {int} ulp
// EXPECT: atan f64: {int} ulp
// EXPECT: atan2 f64: {int} ulp
// EXPECT: exp f64: {int} ulp
// EXPECT: exp2 f64: {int} ulp
// EXPECT: ln f64: {int} ulp
// EXPECT: log2 f64: {int} ulp
// EXPECT: log10 f64: {int} ulp
// EXPECT: powf f64: {int} ulp
// EXPECT: powi f64: {int} ulp
// EXPECT: floor f64: {int} ulp
// EXPECT: ceil f64: {int} ulp
// EXPECT: round f64: {int} ulp
// EXPECT: round_ties_even f64: {int} ulp
// EXPECT: trunc f64: {int} ulp
// EXPECT: fract f64: {int} ulp
// EXPECT: min f64: {int} ulp
// EXPECT: max f64: {int} ulp
// EXPECT: sqrt f32: {int} ulp
// EXPECT: cbrt f32: {int} ulp
// EXPECT: hypot f32: {int} ulp
// EXPECT: sin f32: {int} ulp
// EXPECT: cos f32: {int} ulp
// EXPECT: tan f32: {int} ulp
// EXPECT: asin f32: {int} ulp
// EXPECT: acos f32: {int} ulp
// EXPECT: atan f32: {int} ulp
// EXPECT: atan2 f32: {int} ulp
// EXPECT: exp f32: {int} ulp
// EXPECT: exp2 f32: {int} ulp
// EXPECT: ln f32: {int} ulp
// EXPECT: log2 f32: {int} ulp
// EXPECT: log10 f32: {int} ulp
// EXPECT: powf f32: {int} ulp
// EXPECT: floor f32: {int} ulp
// EXPECT: round f32: {int} ulp
// EXPECT: math vs libm: ok
// (0.26.4) Its PRNG and checksums are written wrapping_*.

import "math.h" as c;



const N: i64 = 40000;

#[derive(Clone, Copy)] struct Rng { s: u64 }

impl Rng {
    // xorshift64*
    fn next(&mut self) -> u64 {
        self.s ^= self.s >> 12;
        self.s ^= self.s << 25;
        self.s ^= self.s >> 27;
        self.s.wrapping_mul(0x2545F4914F6CDD1Du64)
    }

    // in [0, 1)
    fn unit(&mut self) -> f64 { (self.next() >> 11) as f64 * 1.1102230246251565e-16 }
    fn lin(&mut self, lo: f64, hi: f64) -> f64 { lo + (hi - lo) * self.unit() }

    // 2^e, e uniform in [e0, e1), times a random sign when signed
    fn logu(&mut self, e0: f64, e1: f64, signed: bool) -> f64 {
        let e = self.lin(e0, e1).floor() as i32;
        let x = unsafe { c::ldexp(1.0 + self.unit(), e) };
        if signed && self.next() & 1 == 1 { -x } else { x }
    }
}

// The distance in ulps; 0 for two NaNs, a large one for NaN against a
// number or different signs.
fn ulp64(a: f64, b: f64) -> i64 {
    if a != a && b != b {
        return 0;
    }
    if a != a || b != b {
        return 1 << 40;
    }
    let ua = a.to_bits();
    let ub = b.to_bits();
    if ua == ub {
        return 0;
    }
    if ua >> 63 != ub >> 63 {
        return if a == 0.0 && b == 0.0 { 1 } else { 1 << 40 };
    }
    let d = (ua & 0x7fffffffffffffff) as i64 - (ub & 0x7fffffffffffffff) as i64;
    if d < 0 { -d } else { d }
}

fn ulp32(a: f32, b: f32) -> i64 {
    if a != a && b != b {
        return 0;
    }
    if a != a || b != b {
        return 1 << 40;
    }
    let ua = a.to_bits();
    let ub = b.to_bits();
    if ua == ub {
        return 0;
    }
    if ua >> 31 != ub >> 31 {
        return if a == 0.0 && b == 0.0 { 1 } else { 1 << 40 };
    }
    let d = (ua & 0x7fffffff) as i64 - (ub & 0x7fffffff) as i64;
    if d < 0 { -d } else { d }
}

#[derive(Clone, Copy)] struct Worst<'a> { name: &'a str, ulp: i64, x: f64, y: f64, ours: f64, theirs: f64, ok: bool }

fn worst(name: &str) -> Worst<'_> {
    Worst { name: name, ulp: 0, x: 0.0, y: 0.0, ours: 0.0, theirs: 0.0, ok: true }
}

fn see(w: &mut Worst<'_>, d: i64, x: f64, y: f64, ours: f64, theirs: f64) {
    if d > w.ulp {
        w.ulp = d;
        w.x = x;
        w.y = y;
        w.ours = ours;
        w.theirs = theirs;
    }
}

fn report(w: Worst<'_>, bound: i64) -> bool {
    println("{}: {} ulp", w.name, w.ulp);
    if w.ulp > bound {
        println("  over {bound} at x = {:?}, y = {:?}: {:?}, libm {:?}", w.x, w.y, w.ours,
            w.theirs);
        return false;
    }
    true
}

fn un64(name: &str, f: fn(f64) -> f64, g: fn(f64) -> f64, xs: &[f64], bound: i64) -> bool {
    let mut w = worst(name);
    for x in xs.iter().copied() {
        let a = f(x);
        let b = g(x);
        see(&mut w, ulp64(a, b), x, 0.0, a, b);
    }
    report(w, bound)
}

fn bin64(name: &str, f: fn(f64, f64) -> f64, g: fn(f64, f64) -> f64, xs: &[f64], ys: &[f64],
    bound: i64) -> bool {
    let mut w = worst(name);
    for i in 0..xs.len() {
        let a = f(xs[i], ys[i]);
        let b = g(xs[i], ys[i]);
        see(&mut w, ulp64(a, b), xs[i], ys[i], a, b);
    }
    report(w, bound)
}

fn un32(name: &str, f: fn(f32) -> f32, g: fn(f32) -> f32, xs: &[f64], bound: i64) -> bool {
    let mut w = worst(name);
    for x in xs.iter().copied() {
        let a = f(x as f32);
        let b = g(x as f32);
        see(&mut w, ulp32(a, b), x as f32 as f64, 0.0, a as f64, b as f64);
    }
    report(w, bound)
}

fn bin32(name: &str, f: fn(f32, f32) -> f32, g: fn(f32, f32) -> f32, xs: &[f64], ys: &[f64],
    bound: i64) -> bool {
    let mut w = worst(name);
    for i in 0..xs.len() {
        let x = xs[i] as f32;
        let y = ys[i] as f32;
        let a = f(x, y);
        let b = g(x, y);
        see(&mut w, ulp32(a, b), x as f64, y as f64, a as f64, b as f64);
    }
    report(w, bound)
}

// Inputs: n of each kind, into v.
fn lins(r: &mut Rng, v: &mut Vec<f64, Gpa>, lo: f64, hi: f64) {
    for _ in 0..N {
        v.push(r.lin(lo, hi));
    }
}

fn logs(r: &mut Rng, v: &mut Vec<f64, Gpa>, e0: f64, e1: f64, signed: bool) {
    for _ in 0..N {
        v.push(r.logu(e0, e1, signed));
    }
}

// ours
fn v_sqrt(x: f64) -> f64 { x.sqrt() }
fn v_cbrt(x: f64) -> f64 { x.cbrt() }
fn v_hypot(x: f64, y: f64) -> f64 { x.hypot(y) }
fn v_sin(x: f64) -> f64 { x.sin() }
fn v_cos(x: f64) -> f64 { x.cos() }
fn v_tan(x: f64) -> f64 { x.tan() }
fn v_asin(x: f64) -> f64 { x.asin() }
fn v_acos(x: f64) -> f64 { x.acos() }
fn v_atan(x: f64) -> f64 { x.atan() }
fn v_atan2(y: f64, x: f64) -> f64 { y.atan2(x) }
fn v_exp(x: f64) -> f64 { x.exp() }
fn v_exp2(x: f64) -> f64 { x.exp2() }
fn v_ln(x: f64) -> f64 { x.ln() }
fn v_log2(x: f64) -> f64 { x.log2() }
fn v_log10(x: f64) -> f64 { x.log10() }
fn v_pow(x: f64, y: f64) -> f64 { x.powf(y) }
fn v_powi(x: f64, y: f64) -> f64 { x.powi(y as i32) }
fn v_floor(x: f64) -> f64 { x.floor() }
fn v_ceil(x: f64) -> f64 { x.ceil() }
fn v_round(x: f64) -> f64 { x.round() }
fn v_rint(x: f64) -> f64 { x.round_ties_even() }
fn v_trunc(x: f64) -> f64 { x.trunc() }
fn v_fract(x: f64) -> f64 { x.fract() }
fn v_min(x: f64, y: f64) -> f64 { x.min(y) }
fn v_max(x: f64, y: f64) -> f64 { x.max(y) }

// libm's
fn c_sqrt(x: f64) -> f64 { unsafe { x.sqrt() } }
fn c_cbrt(x: f64) -> f64 { unsafe { x.cbrt() } }
fn c_hypot(x: f64, y: f64) -> f64 { unsafe { x.hypot(y) } }
fn c_sin(x: f64) -> f64 { unsafe { x.sin() } }
fn c_cos(x: f64) -> f64 { unsafe { x.cos() } }
fn c_tan(x: f64) -> f64 { unsafe { x.tan() } }
fn c_asin(x: f64) -> f64 { unsafe { x.asin() } }
fn c_acos(x: f64) -> f64 { unsafe { x.acos() } }
fn c_atan(x: f64) -> f64 { unsafe { x.atan() } }
fn c_atan2(y: f64, x: f64) -> f64 { unsafe { y.atan2(x) } }
fn c_exp(x: f64) -> f64 { unsafe { x.exp() } }
fn c_exp2(x: f64) -> f64 { unsafe { x.exp2() } }
fn c_ln(x: f64) -> f64 { unsafe { c::log(x) } }
fn c_log2(x: f64) -> f64 { unsafe { x.log2() } }
fn c_log10(x: f64) -> f64 { unsafe { x.log10() } }
fn c_pow(x: f64, y: f64) -> f64 { unsafe { x.powf(y) } }
fn c_powi(x: f64, y: f64) -> f64 { unsafe { x.powf(((y as i32) as f64)) } }
fn c_floor(x: f64) -> f64 { unsafe { x.floor() } }
fn c_ceil(x: f64) -> f64 { unsafe { x.ceil() } }
fn c_round(x: f64) -> f64 { unsafe { x.round() } }
fn c_rint(x: f64) -> f64 { unsafe { c::rint(x) } }
fn c_trunc(x: f64) -> f64 { unsafe { x.trunc() } }
fn c_fract(x: f64) -> f64 { x - unsafe { x.trunc() } }
fn c_min(x: f64, y: f64) -> f64 { unsafe { c::fmin(x, y) } }
fn c_max(x: f64, y: f64) -> f64 { unsafe { c::fmax(x, y) } }

fn v_sqrtf(x: f32) -> f32 { x.sqrt() }
fn v_cbrtf(x: f32) -> f32 { x.cbrt() }
fn v_hypotf(x: f32, y: f32) -> f32 { x.hypot(y) }
fn v_sinf(x: f32) -> f32 { x.sin() }
fn v_cosf(x: f32) -> f32 { x.cos() }
fn v_tanf(x: f32) -> f32 { x.tan() }
fn v_asinf(x: f32) -> f32 { x.asin() }
fn v_acosf(x: f32) -> f32 { x.acos() }
fn v_atanf(x: f32) -> f32 { x.atan() }
fn v_atan2f(y: f32, x: f32) -> f32 { y.atan2(x) }
fn v_expf(x: f32) -> f32 { x.exp() }
fn v_exp2f(x: f32) -> f32 { x.exp2() }
fn v_lnf(x: f32) -> f32 { x.ln() }
fn v_log2f(x: f32) -> f32 { x.log2() }
fn v_log10f(x: f32) -> f32 { x.log10() }
fn v_powf(x: f32, y: f32) -> f32 { x.powf(y) }
fn v_floorf(x: f32) -> f32 { x.floor() }
fn v_roundf(x: f32) -> f32 { x.round() }

fn c_sqrtf(x: f32) -> f32 { unsafe { c::sqrtf(x) } }
fn c_cbrtf(x: f32) -> f32 { unsafe { c::cbrtf(x) } }
fn c_hypotf(x: f32, y: f32) -> f32 { unsafe { c::hypotf(x, y) } }
fn c_sinf(x: f32) -> f32 { unsafe { c::sinf(x) } }
fn c_cosf(x: f32) -> f32 { unsafe { c::cosf(x) } }
fn c_tanf(x: f32) -> f32 { unsafe { c::tanf(x) } }
fn c_asinf(x: f32) -> f32 { unsafe { c::asinf(x) } }
fn c_acosf(x: f32) -> f32 { unsafe { c::acosf(x) } }
fn c_atanf(x: f32) -> f32 { unsafe { c::atanf(x) } }
fn c_atan2f(y: f32, x: f32) -> f32 { unsafe { c::atan2f(y, x) } }
fn c_expf(x: f32) -> f32 { unsafe { c::expf(x) } }
fn c_exp2f(x: f32) -> f32 { unsafe { c::exp2f(x) } }
fn c_lnf(x: f32) -> f32 { unsafe { c::logf(x) } }
fn c_log2f(x: f32) -> f32 { unsafe { c::log2f(x) } }
fn c_log10f(x: f32) -> f32 { unsafe { c::log10f(x) } }
fn c_powf(x: f32, y: f32) -> f32 { unsafe { x.powf(y) } }
fn c_floorf(x: f32) -> f32 { unsafe { c::floorf(x) } }
fn c_roundf(x: f32) -> f32 { unsafe { c::roundf(x) } }

fn main(gpa: Gpa) -> i32 {
    let mut r = Rng { s: 0x9E3779B97F4A7C15 };
    // positive numbers of every size; signed ones; around 1
    let mut pos: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut pos, -1074.0, 1024.0, false);
    let mut any: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut any, -1074.0, 1024.0, true);
    // the trigonometric functions: small, medium, near multiples of
    // pi/2, huge
    let mut trig: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut trig, -10.0, 10.0);
    lins(&mut r, &mut trig, -1.0e6, 1.0e6);
    logs(&mut r, &mut trig, -40.0, 1024.0, true);
    for k in 1..N {
        trig.push((k as f64) * f64::consts::FRAC_PI_2);
    }
    let mut unit: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut unit, -1.0, 1.0);
    logs(&mut r, &mut unit, -60.0, 0.0, true);
    let mut wide: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut wide, -60.0, 80.0, true);
    let mut e1: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut e1, -745.2, 709.8);
    lins(&mut r, &mut e1, -2.0, 2.0);
    let mut e2: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut e2, -1075.0, 1024.0);
    lins(&mut r, &mut e2, -2.0, 2.0);
    let mut logx: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut logx, -1074.0, 1024.0, false);
    lins(&mut r, &mut logx, 0.5, 2.0);
    // pairs
    let mut ax: Vec<f64, Gpa> = Vec::new_in(gpa);
    let mut ay: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut ax, -1074.0, 1024.0, true);
    logs(&mut r, &mut ay, -1074.0, 1024.0, true);
    logs(&mut r, &mut ax, -10.0, 10.0, true);
    logs(&mut r, &mut ay, -10.0, 10.0, true);
    // pow: x > 0 any y; x < 0 integer y; x near 1, big y
    let mut px: Vec<f64, Gpa> = Vec::new_in(gpa);
    let mut py: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut px, -20.0, 20.0, false);
    lins(&mut r, &mut py, -30.0, 30.0);
    lins(&mut r, &mut px, -10.0, 10.0);
    for _ in 0..N {
        py.push(r.lin(-20.0, 20.0).round());
    }
    for _ in 0..N {
        px.push(1.0 + r.lin(-1.0e-3, 1.0e-3));
    }
    lins(&mut r, &mut py, -1.0e5, 1.0e5);
    let mut ix: Vec<f64, Gpa> = Vec::new_in(gpa);
    let mut iy: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut ix, -3.0, 3.0);
    for _ in 0..N {
        iy.push(r.lin(-12.0, 12.0).round());
    }
    // integers and fractions for the rounding functions
    let mut rnd: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut rnd, -5.0, 60.0, true);
    for k in -40..40 {
        rnd.push(k as f64 * 0.5);
    }
    // f32: in range
    let mut pos32: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut pos32, -149.0, 128.0, false);
    let mut trig32: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut trig32, -10.0, 10.0);
    logs(&mut r, &mut trig32, -20.0, 127.0, true);
    let mut e32: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut e32, -104.0, 89.0);
    let mut e232: Vec<f64, Gpa> = Vec::new_in(gpa);
    lins(&mut r, &mut e232, -150.0, 128.0);
    let mut ax32: Vec<f64, Gpa> = Vec::new_in(gpa);
    let mut ay32: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut ax32, -149.0, 128.0, true);
    logs(&mut r, &mut ay32, -149.0, 128.0, true);
    let mut px32: Vec<f64, Gpa> = Vec::new_in(gpa);
    let mut py32: Vec<f64, Gpa> = Vec::new_in(gpa);
    logs(&mut r, &mut px32, -10.0, 10.0, false);
    lins(&mut r, &mut py32, -10.0, 10.0);

    let mut ok = true;
    ok = un64("sqrt f64", v_sqrt, c_sqrt, pos.as_slice(), 0) && ok;
    // (4: glibc's cbrt is 3 ulp off at -2.9334366318027884e78, where ours
    // is correctly rounded; its documented bound is 4)
    ok = un64("cbrt f64", v_cbrt, c_cbrt, any.as_slice(), 4) && ok;
    ok = bin64("hypot f64", v_hypot, c_hypot, ax.as_slice(), ay.as_slice(), 1) && ok;
    ok = un64("sin f64", v_sin, c_sin, trig.as_slice(), 1) && ok;
    ok = un64("cos f64", v_cos, c_cos, trig.as_slice(), 1) && ok;
    // (3: macOS libm's own tan is 3 ulp off at -839902.6931820604, where
    // ours is correctly rounded)
    ok = un64("tan f64", v_tan, c_tan, trig.as_slice(), 3) && ok;
    let mut w = worst("sin_cos f64");
    for x in trig.iter().copied() {
        let (s, co) = x.sin_cos();
        see(&mut w, ulp64(s, c_sin(x)), x, 0.0, s, c_sin(x));
        see(&mut w, ulp64(co, c_cos(x)), x, 0.0, co, c_cos(x));
    }
    ok = report(w, 1) && ok;
    ok = un64("asin f64", v_asin, c_asin, unit.as_slice(), 1) && ok;
    ok = un64("acos f64", v_acos, c_acos, unit.as_slice(), 1) && ok;
    ok = un64("atan f64", v_atan, c_atan, wide.as_slice(), 1) && ok;
    ok = bin64("atan2 f64", v_atan2, c_atan2, ax.as_slice(), ay.as_slice(), 2) && ok;
    ok = un64("exp f64", v_exp, c_exp, e1.as_slice(), 1) && ok;
    ok = un64("exp2 f64", v_exp2, c_exp2, e2.as_slice(), 2) && ok;
    ok = un64("ln f64", v_ln, c_ln, logx.as_slice(), 1) && ok;
    ok = un64("log2 f64", v_log2, c_log2, logx.as_slice(), 1) && ok;
    ok = un64("log10 f64", v_log10, c_log10, logx.as_slice(), 2) && ok;
    ok = bin64("powf f64", v_pow, c_pow, px.as_slice(), py.as_slice(), 1) && ok;
    ok = bin64("powi f64", v_powi, c_powi, ix.as_slice(), iy.as_slice(), 16) && ok;
    ok = un64("floor f64", v_floor, c_floor, rnd.as_slice(), 0) && ok;
    ok = un64("ceil f64", v_ceil, c_ceil, rnd.as_slice(), 0) && ok;
    ok = un64("round f64", v_round, c_round, rnd.as_slice(), 0) && ok;
    ok = un64("round_ties_even f64", v_rint, c_rint, rnd.as_slice(), 0) && ok;
    ok = un64("trunc f64", v_trunc, c_trunc, rnd.as_slice(), 0) && ok;
    ok = un64("fract f64", v_fract, c_fract, rnd.as_slice(), 0) && ok;
    ok = bin64("min f64", v_min, c_min, ax.as_slice(), ay.as_slice(), 0) && ok;
    ok = bin64("max f64", v_max, c_max, ax.as_slice(), ay.as_slice(), 0) && ok;
    ok = un32("sqrt f32", v_sqrtf, c_sqrtf, pos32.as_slice(), 0) && ok;
    ok = un32("cbrt f32", v_cbrtf, c_cbrtf, ax32.as_slice(), 1) && ok;
    ok = bin32("hypot f32", v_hypotf, c_hypotf, ax32.as_slice(), ay32.as_slice(), 1) && ok;
    ok = un32("sin f32", v_sinf, c_sinf, trig32.as_slice(), 1) && ok;
    ok = un32("cos f32", v_cosf, c_cosf, trig32.as_slice(), 1) && ok;
    ok = un32("tan f32", v_tanf, c_tanf, trig32.as_slice(), 1) && ok;
    ok = un32("asin f32", v_asinf, c_asinf, unit.as_slice(), 1) && ok;
    ok = un32("acos f32", v_acosf, c_acosf, unit.as_slice(), 1) && ok;
    ok = un32("atan f32", v_atanf, c_atanf, ax32.as_slice(), 1) && ok;
    ok = bin32("atan2 f32", v_atan2f, c_atan2f, ax32.as_slice(), ay32.as_slice(), 1) && ok;
    ok = un32("exp f32", v_expf, c_expf, e32.as_slice(), 1) && ok;
    ok = un32("exp2 f32", v_exp2f, c_exp2f, e232.as_slice(), 1) && ok;
    ok = un32("ln f32", v_lnf, c_lnf, pos32.as_slice(), 1) && ok;
    ok = un32("log2 f32", v_log2f, c_log2f, pos32.as_slice(), 1) && ok;
    // (2: glibc's log10f is 2 ulp off at 1.3058513402938843, where ours is
    // correctly rounded)
    ok = un32("log10 f32", v_log10f, c_log10f, pos32.as_slice(), 2) && ok;
    ok = bin32("powf f32", v_powf, c_powf, px32.as_slice(), py32.as_slice(), 1) && ok;
    ok = un32("floor f32", v_floorf, c_floorf, ax32.as_slice(), 0) && ok;
    ok = un32("round f32", v_roundf, c_roundf, ax32.as_slice(), 0) && ok;
    println("{}", if ok { "math vs libm: ok" } else { "math vs libm: FAILED" });
    if ok { 0 } else { 1 }
}
