// 0.25.2.1 (eval 0.25.2: sph, mandelbulb): an array literal where a slice
// of numbers is wanted takes the slice's element type (it was `[i64; N]`,
// `expected '[u32]', got '[i64; 5]'`): a `let` with a slice annotation, an
// argument; then it is viewed as a slice, as before.
// EXPECT: 10 15 1.5 255 5 2
fn sum(xs: [u32]) -> u32 {
    var s: u32 = 0;
    for x in xs {
        s += x;
    }
    s
}

fn main() {
    let xs: [u32] = [1, 2, 3, 0, 4];
    let fs: [f32] = [0.5, 1.5];
    let bs: [u8] = [255, 1];
    let ws: [i16] = [-1, 2];
    println(f"{sum(xs)} {sum([4, 5, 6])} {fs[1]} {bs[0]} {xs.len} {ws[1]}");
}
