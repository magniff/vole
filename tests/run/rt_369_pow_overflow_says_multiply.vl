// XFAIL: RT-369: an integer `pow` that overflows panics with "attempt to multiply with overflow" at a line of std (`<std>:10995:23`), where rustc says "attempt to exponentiate with overflow" (0.30.2)
// rustc (overflow checks on): `attempt to exponentiate with overflow`,
// exit 101, after `81` (twin .rs.txt). vole: `<std>:10995:23: attempt to
// multiply with overflow` (std's pow multiplies with the checks of the
// program's level), at i8, i16, i32, i64, isize, u16 and the rest (the
// integer-edge sweep: p_i8_8, p_isize_8, p_u16_8). v0.28.0 to v0.30.0
// wrapped silently at -O0 (3i64.pow(40) printed -6289078614652622815);
// the panic and its message are v0.30.1's.
// FLAGS: --overflow-checks=on
// EXPECT: 81
// STDERR: attempt to exponentiate with overflow
// EXIT: 101
fn id(x: u32) -> u32 {
    x
}

fn main() {
    let a: i64 = 3;
    println("{}", a.pow(id(4)));
    println("{}", a.pow(id(40)));
}
