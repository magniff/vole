// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::into_values.
// EXPECT: [10, 20]
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(2, 20);
    m.insert(1, 10);
    let mut vs: Vec<i64, Gpa> = m.into_values().collect_in(gpa);
    vs.sort();
    println("{:?}", vs);
}
