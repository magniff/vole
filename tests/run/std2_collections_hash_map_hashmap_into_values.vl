// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::into_values.
// EXPECT: [10, 20]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(2, 20);
    m.insert(1, 10);
    let mut vs: Vec<i64, Gpa> = m.into_values().collect_in(gpa);
    vs.sort();
    println("{:?}", vs);
}
