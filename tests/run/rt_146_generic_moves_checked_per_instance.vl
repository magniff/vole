// XFAIL: RT-146: a generic fn's body is borrow-checked only per instance once it has a caller: moves of a T (use after move, out of `&T`, out of `self.t`) and a second call of an FnOnce pass while every caller passes a Copy type (0.30.2)
// rustc refuses each body (E0382 on `x` and `f`, E0507 on `*x` and
// `self.t`) whatever the callers pass. vole refuses dup, take and W::get
// when nothing calls them (borrowck.use_moved, borrowck.move_out), but
// with the i64 callers below checks clean; twice is accepted even with no
// caller. A String caller makes the instance fail at the body's line, so
// a library's generic fn checks clean until a user instantiates it.
// ERROR: line 15, column 9
// ERROR: line 19, column 11
// ERROR: line 23, column 5
// ERROR: line 32, column 9
// ERROR-COUNT: 4
fn dup<T>(x: T) -> (T, T) {
    let a = x;
    (a, x)
}

fn twice<F: FnOnce() -> i64>(f: F) -> i64 {
    f() + f()
}

fn take<T>(x: &T) -> T {
    *x
}

struct W<T> {
    t: T,
}

impl<T> W<T> {
    fn get(&self) -> T {
        self.t
    }
}

fn main() {
    let p = dup(3i64);
    let k = 5i64;
    let w = W { t: 7i64 };
    println("{} {} {} {}", p.0, twice(move || k), take(&k), w.get());
}
