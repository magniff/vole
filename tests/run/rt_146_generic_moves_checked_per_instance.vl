// XFAIL: RT-146: a generic fn that uses a T or an FnOnce value twice is accepted when every caller passes a Copy type: the body's moves are checked per instance, not against its bounds (0.30.2)
// rustc refuses both bodies (E0382 use of moved value `x`, and `f`)
// whatever the callers pass. vole: dup with no caller is
// borrowck.use_moved, with a caller of i64 nothing; twice is accepted with
// no caller and with a Copy closure, refused only when a caller passes a
// closure that is not Copy (then at the body's line). A library's generic
// fn checks clean until a user instantiates it.
// ERROR: line 13, column 9
// ERROR: line 17, column 11
// ERROR-COUNT: 2
fn dup<T>(x: T) -> (T, T) {
    let a = x;
    (a, x)
}

fn twice<F: FnOnce() -> i64>(f: F) -> i64 {
    f() + f()
}

fn main() {
    let p = dup(3i64);
    let k = 5i64;
    println("{} {}", p.0, twice(move || k));
}
