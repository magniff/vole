// RULE: M3
// (0.30.1) A binding the program names `__for_seq` is no `for` loop's
// sequence: before, a move out of its referent was taken for the lowering's
// own and accepted (one value dropped twice).
// ERROR: error[borrowck.move_out]
// ERROR: line 25, column 10
// ERROR-COUNT: 1
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

fn main() {
    let d = D { v: 1 };
    let __for_seq = &d;
    take(*__for_seq);
}
