// (re-review 2 of M2, form m12) `where Self: TrB` on a trait is a
// supertrait to every reader: method lookup saw it (`self.b()` resolved),
// projections did not, and `Self::Out` took TrA's Out, i64, for a u8 (it
// printed 200). rustc: E0221.
// ERROR: is ambiguous: more than one supertrait of 'Sub' declares it
// ERROR-COUNT: 1
trait TrA {
    type Out;
    fn a(&self) -> Self::Out;
}

trait TrB {
    type Out;
    fn b(&self) -> Self::Out;
}

trait Sub: TrA
    where
        Self: TrB,
{
    fn get(&self) -> Self::Out {
        self.b()
    }
}

struct W;

impl TrA for W {
    type Out = i64;

    fn a(&self) -> i64 {
        1
    }
}

impl TrB for W {
    type Out = u8;

    fn b(&self) -> u8 {
        200
    }
}

impl Sub for W {}

fn main() {
    let v = W.get();
    println("{}", v);
}
