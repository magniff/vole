// EDITION: rust
// RULE: D4.6
// (0.27.2.1) The implied bound goes one way: `It<'a, &'b i64>` implies
// `'b: 'a`, not `'a: 'b`, so the reference held for 'a cannot be returned
// for 'b (rustc: lifetime may not live long enough).
struct It<'a, T> {
    v: &'a T,
}

fn back<'a, 'b>(i: It<'a, &'b i64>) -> &'b &'b i64 {
    i.v
}

fn main() {
    let n: i64 = 1;
    let r = &n;
    println("{}", **back(It { v: &r }));
}
// ERROR: error[borrowck.outlives]
