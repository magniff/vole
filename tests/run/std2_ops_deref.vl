// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Deref.
// EXPECT: 8 Equal
use std::ops::{Bound, Deref, DerefMut};

struct Wrap {
    v: i64,
    b: Bound<i64>,
}

impl Deref for Wrap {
    type Target = i64;

    fn deref(&self) -> &i64 {
        &self.v
    }
}

impl DerefMut for Wrap {
    fn deref_mut(&mut self) -> &mut i64 {
        &mut self.v
    }
}

fn main() {
    let w = Wrap { v: 7, b: Bound::Unbounded };
    println("{} {:?}", *w + 1, w.cmp(&7));
}
