// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash BuildHasher::build_hasher.
// EXPECT: true
use std::hash::{BuildHasher, Hash, Hasher};

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

impl Default for Fnv {
    fn default() -> Fnv {
        Fnv { h: 0xcbf29ce484222325 }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

struct FnvState {}

impl BuildHasher for FnvState {
    type Hasher = Fnv;

    fn build_hasher(&self) -> Fnv {
        fnv()
    }
}

fn main() {
    let s = FnvState {};
    let mut a = s.build_hasher();
    let mut b = s.build_hasher();
    a.write_u8(1);
    b.write_u8(1);
    println("{}", a.finish() == b.finish());
}
