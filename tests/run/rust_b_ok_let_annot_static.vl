// RULE: D3.6
// (0.27.2) A `let` annotation that holds: a static's reference is
// `'static`, and a parameter's reference has its named lifetime.
// EXPECT: 4 2
static N: i64 = 4;

fn pick<'a>(x: &'a i64) -> &'a i64 {
    let r: &'a i64 = x;
    r
}

fn main() {
    let r: &'static i64 = &N;
    let v = 2;
    println("{} {}", *r, *pick(&v));
}
