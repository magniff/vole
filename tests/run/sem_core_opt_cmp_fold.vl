// EDITION: rust
// Comparisons an optimizer might rewrite assuming no overflow.
// EXPECT: false true true false false
// EXPECT: false true true false true
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static mut Z: i64 = 0;

#[inline(never)]
fn lt_by_sub(a: i64, b: i64) -> bool { a - b < 0 }
#[inline(never)]
fn neg_lt(x: i64) -> bool { -x < 0 }
#[inline(never)]
fn twice_half(x: i64) -> bool { x * 2 / 2 == x }
#[inline(never)]
fn plus_gt(x: i32) -> bool { x + 1 > x }
#[inline(never)]
fn sub_ge(x: u8, y: u8) -> bool { x - y >= 0 }
#[inline(never)]
fn add_lt(x: u64, y: u64) -> bool { x + y < x }
#[inline(never)]
fn abs_ge(x: i64) -> bool { let y = if x < 0 { -x } else { x }; y >= 0 }
#[inline(never)]
fn mul_neg(x: i16) -> bool { x * -1 == -x }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let min = -9223372036854775807 - 1 + unsafe { Z };
    let max = 9223372036854775807 + unsafe { Z };
    println(
        "{} {} {} {} {}", lt_by_sub(min, 1 + unsafe { Z }), lt_by_sub(max, -1 + unsafe { Z }),
        neg_lt(min), twice_half(max), twice_half(4611686018427387904 + unsafe { Z }));
    println(
        "{} {} {} {} {}", plus_gt((2147483647 + unsafe { Z }) as i32),
        sub_ge((1 + unsafe { Z }) as u8, (2 + unsafe { Z }) as u8),
        add_lt((-1 + unsafe { Z }) as u64, (1 + unsafe { Z }) as u64), abs_ge(min),
        mul_neg((-32768 + unsafe { Z }) as i16));
    0
}
