// XFAIL: gap 17: compile effect: 'in_scope' is #[effects(alloc(Arena<Gpa>), panic)], but it allocates from ArenaScope<Gpa>:...
// EXPECT: 3 2
// 0.16: Arena::scope discharges as designed (§2.3): its effects are the
// closure's minus alloc(ScopedArena), plus alloc(Arena); the arena's own
// refills from Gpa and its frees to Gpa at the scope's end are the
// arena's business, as they are for its Allocator methods.
use std::alloc::Arena; use std::alloc::ArenaScope as ScopedArena;
#[effects(alloc(Arena<Gpa>), panic)]
fn in_scope(a: &mut Arena<Gpa>) -> i64 {
    a.scope(|s| ({ let s = s; {
        let mut v: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::new_in(s);
        for i in 0..3 { v.push(i); }
        v.len() as i64
    } }))
}

#[effects(alloc(Arena<Gpa>), panic)]
fn nested(a: &mut Arena<Gpa>) -> i64 {
    a.scope(|s| ({ let s = s; s.scope(|s| ({ let t = s; {
        let mut v: Vec<i64, &ScopedArena<'_, Gpa>> = Vec::new_in(t);
        v.push(1);
        v.push(2);
        v.len() as i64
    } })) }))
}

fn main(gpa: Gpa) -> i32 {
    let mut a = Arena::new_in(gpa);
    println("{} {}", in_scope(&mut a), nested(&mut a));
    unsafe { drop(a); }
    0
}
