// RULE: M2, M8
// RUSTC: none a union's field that needs drop is vole's (rustc E0740: it must be Copy or ManuallyDrop)
// (0.30.1) A struct's field under a union's field, moved alone (`u.p.d`),
// has a move path of its own, and an assignment to it initializes that
// path (init_path, rustc's exact lookup against vole's paths): read
// again after it, straight on and across a loop's iterations. Review 4
// found init_path's first form, which initialized nothing under a union's
// field, refusing both (E0382).
// EXPECT: moved 1
// EXPECT: again 2
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: moved 3
// EXPECT: drop 3
// EXPECT: moved 10
// EXPECT: drop 10
// EXPECT: moved 11
// EXPECT: drop 11
// EXPECT: again 12
// EXPECT: drop 12
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct P {
    d: D,
    k: i64,
}

union U {
    p: P,
    x: i64,
}

fn straight() {
    let mut u = U { p: P { d: D { v: 1 }, k: 0 } };
    // UNSAFE: moves the union's field it was made with
    // SAFETY: p was assigned, d initialized and not moved yet
    let a = unsafe { u.p.d };
    println("moved {}", a.v);
    u.p.d = D { v: 2 };
    // UNSAFE: moves the field just assigned anew
    // SAFETY: u.p.d was assigned after its move
    let b = unsafe { u.p.d };
    println("again {}", b.v);
}

fn in_loop() {
    let mut u = U { p: P { d: D { v: 3 }, k: 0 } };
    for i in 0..3 {
        // UNSAFE: moves the field assigned before the loop or in the last iteration
        // SAFETY: u.p.d is initialized at each iteration's start
        let a = unsafe { u.p.d };
        println("moved {}", a.v);
        u.p.d = D { v: 10 + i };
    }
    // UNSAFE: moves the field the last iteration assigned
    // SAFETY: u.p.d was assigned after its last move
    let b = unsafe { u.p.d };
    println("again {}", b.v);
}

fn main() {
    straight();
    in_loop();
}
