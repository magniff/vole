// RULE: M2, M8, F19.8
// (0.30.1) A union's field moved out moves the union, and an assignment
// to the field initializes it again (init_path, rustc's exact lookup
// against vole's paths): read again after it, straight on and across a
// loop's iterations. Review 4 found init_path's first form, which
// initialized nothing under a union's field, refusing both (E0382).
// (0.30.2, RT-43) The field that needs drop is a ManuallyDrop<P>, as Rust
// requires (E0740): before, `p: P` was accepted and the case moved
// `u.p.d`, a part under the field, which a union's field can no longer
// hold (a part of a Copy field is not moved; one behind ManuallyDrop is
// reached through its Deref, out of which nothing moves).
// EXPECT: moved 1
// EXPECT: again 2
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: moved 3
// EXPECT: drop 3
// EXPECT: moved 10
// EXPECT: drop 10
// EXPECT: moved 11
// EXPECT: drop 11
// EXPECT: again 12
// EXPECT: drop 12
use std::mem::ManuallyDrop;

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct P {
    d: D,
    k: i64,
}

union U {
    p: ManuallyDrop<P>,
    x: i64,
}

fn straight() {
    let mut u = U { p: ManuallyDrop::new(P { d: D { v: 1 }, k: 0 }) };
    // UNSAFE: moves the union's field it was made with
    // SAFETY: p was assigned and not moved yet
    let a = ManuallyDrop::into_inner(unsafe { u.p });
    println("moved {}", a.d.v);
    u.p = ManuallyDrop::new(P { d: D { v: 2 }, k: a.k });
    // UNSAFE: moves the field just assigned anew
    // SAFETY: u.p was assigned after its move
    let b = ManuallyDrop::into_inner(unsafe { u.p });
    println("again {}", b.d.v);
}

fn in_loop() {
    let mut u = U { p: ManuallyDrop::new(P { d: D { v: 3 }, k: 0 }) };
    for i in 0..3 {
        // UNSAFE: moves the field assigned before the loop or in the last iteration
        // SAFETY: u.p is initialized at each iteration's start
        let a = ManuallyDrop::into_inner(unsafe { u.p });
        println("moved {}", a.d.v);
        u.p = ManuallyDrop::new(P { d: D { v: 10 + i }, k: a.k });
    }
    // UNSAFE: moves the field the last iteration assigned
    // SAFETY: u.p was assigned after its last move
    let b = ManuallyDrop::into_inner(unsafe { u.p });
    println("again {}", b.d.v);
}

fn main() {
    straight();
    in_loop();
}
