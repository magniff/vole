// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Peekable::peek_mut.
// EXPECT: [10, 2]

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().copied().peekable();
    if let Some(p) = it.peek_mut() {
        *p *= 10;
    }
    let v: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?}", v);
}
