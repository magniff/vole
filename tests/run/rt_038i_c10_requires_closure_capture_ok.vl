// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c10_requires_closure_capture_ok)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// a closure in the requires captures the by-value parameter: reads it, builds.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    requires {
    let g = || s.v;
    g() > 0
}

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
