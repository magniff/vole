// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::cell Cell.
// EXPECT: 3
use std::cell::Cell;

struct Hits {
    n: Cell<i64>,
}

impl Hits {
    fn hit(&self) {
        self.n.set(self.n.get() + 1);
    }
}

fn main() {
    let h = Hits { n: Cell::new(0) };
    let r1 = &h;
    let r2 = &h;
    r1.hit();
    r2.hit();
    r1.hit();
    println("{}", h.n.get());
}
