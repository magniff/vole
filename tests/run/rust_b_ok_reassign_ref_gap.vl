// EDITION: rust
// RULE: D2.4
// (0.27.1) A reference local reassigned: the first loan is out of scope
// where the local is dead (between its last use and the reassignment), so `a
// = 5` is fine. rustc agrees.

fn main() {
    let mut a: i64 = 1;
    let b: i64 = 2;
    let mut r = &a;
    println("{}", *r);
    r = &b;
    a = 5;
    println("{} {}", *r, a);
}
// EXPECT: 1
// EXPECT: 2 5
