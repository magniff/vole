// XFAIL: RT-M2-10: #[derive] on a generic type with both inline bounds and a where clause fails in the derive's own text (open)
// `struct S<T: Copy> where T: Clone` is Rust, and rustc derives Clone,
// Debug, PartialEq for it. vole stops with an error in the generated
// impl: `<derive>:1:15: error[type error] 'where' is a reserved keyword
// (reserved for future use)` (the impl's text seems to put the struct's
// where clause inside its generic parameters).
// EXPECT: S { a: 3 } true
#[derive(Clone, Debug, PartialEq)]
struct S<T: Copy>
    where
        T: Clone,
{
    a: T,
}

fn main() {
    let s = S { a: 3i64 };
    let t = s.clone();
    println("{:?} {}", t, s == t);
}
