// EXPECT: 1
// (RT-269) an impl's `where W: Conv<U>`, met: chosen.
trait Conv<X> {}

impl Conv<i64> for W {}

trait Tr<U> {
    fn f(&self) -> i64;
}

struct W {
    r: i64,
}

impl<U> Tr<U> for W
    where
        W: Conv<U>,
{
    fn f(&self) -> i64 {
        1
    }
}

fn need<T: Tr<i64>>(t: &T) -> i64 {
    t.f()
}

fn main() {
    println("{}", need(&W { r: 0 }));
}
