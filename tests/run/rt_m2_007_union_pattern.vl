// Reading a union field is unsafe (`u.r` is refused: "reading a field of
// a union is unsafe"), and so is matching one with a pattern (rustc
// E0133: access to union field is unsafe). vole accepts the patterns in
// safe code: the reference read from the usize 16 crashes the program.
// ERROR: union
// ERROR: union
// ERROR: union
// ERROR: union
// ERROR-COUNT: 4
union U {
    a: usize,
    r: &'static i64,
}

fn main() {
    let n = std::env::args().count();
    let u = U { a: 15 + n };
    println("start");
    if n == 1 {
        let U { r, .. } = u;
        println("{}", *r);
        match u {
            U { r, .. } => println("{}", *r),
        }
        if let U { r, .. } = u {
            println("{}", *r);
        }
        let f = |U { r, .. }: U| *r;
        println("{}", f(u));
    }
}
