// a static passed let (plain: a copy) to a function that writes it: fine, the copy is independent
// EXPECT: 101 5
static mut G: i64 = 1;
fn f(x: i64) -> i64 { let before = x; unsafe { G = 5; } before * 100 + x }
fn main() { let r = f(unsafe { G }); let g_now = unsafe { G }; println("{r} {g_now}"); }
