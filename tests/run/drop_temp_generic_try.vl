// (0.29) `?` on a generic call's Result or Option of its parameter, the
// payload lent or read (`obs(&dup_res(t)?)`, `dup_res(t)?.v`): the payload
// is dropped at the end of its statement, on the path that returns early
// nothing is left either.
// EXPECT: d2
// EXPECT: d3
// EXPECT: a 8
// EXPECT: d4
// EXPECT: d5
// EXPECT: b 8
// EXPECT: d6
// EXPECT: d8
// EXPECT: d7
// EXPECT: c 7
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn dup_res<X: Clone>(x: &X) -> Result<X, i64> {
    Ok(x.clone())
}

fn dup_opt<X: Clone>(x: &X) -> Option<X> {
    Some(x.clone())
}

fn fail<X: Clone>(x: &X) -> Result<X, i64> {
    let _y = x.clone();
    Err(7)
}

fn try_res(t: &T) -> Result<i64, i64> {
    let a = obs(&dup_res(t)?);
    let b = dup_res(t)?.v;
    Ok(a + b)
}

fn try_opt(t: &T) -> Option<i64> {
    let a = obs(&dup_opt(t)?);
    let b = dup_opt(t)?.v;
    Some(a + b)
}

fn try_fail(t: &T) -> Result<i64, i64> {
    let a = obs(&dup_res(t)?);
    let b = obs(&dup_res(t)?) + fail(t)?.v;
    Ok(a + b)
}

fn run() {
    let t = mk(4);
    println("a {}", try_res(&t).unwrap());
    println("b {}", try_opt(&t).unwrap());
    println("c {}", try_fail(&t).unwrap_err());
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
