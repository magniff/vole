use std::thread;

fn main(gpa: Gpa) {
    let n = thread::scope(|s| ({ let s = s; {
        let mut mine: Vec<i64, Gpa> = Vec::new_in(gpa);
        mine.push(1);
        let h = s.spawn(|| mine.len());
        h.join().unwrap()
    } }));
    println("{n}");
}
