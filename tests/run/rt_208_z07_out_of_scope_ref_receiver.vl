// XFAIL: RT-208: a method of a trait not in scope is taken by the method probe (wrong code): form z07 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 1
// EXPECT: 2
mod a {
    pub trait T1 { fn m(&self) -> i64; }
    impl<'x> T1 for &'x super::S { fn m(&self) -> i64 { 1 } }
}

trait T2 { fn m(self) -> i64; }
pub struct S { k: i64 }
impl<'x> T2 for &'x S { fn m(self) -> i64 { 2 } }
fn main() { let s = S { k: 0 }; let r = &s; println("{}", (&r).m()); }
