// sem-own: a `sink self` method called on self inside an inout self method: own.move_out.
// ERROR: error[borrowck.move_out]
// ERROR: line 12, column 52
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
impl D<Gpa> { fn finish(self) {} fn g(&mut self) { self.finish(); } }

fn main(gpa: Gpa) {
    let mut a = mk(1, gpa);
    a.g();
}
