// XFAIL: RT-492b: (RT-492, a let) `let f = |x| x;` later put in `MyMap { i: a.iter(), f: f }` is "cannot infer the type of closure parameter 'x'" at the let; rustc infers it from the later use and prints 6 (0.30.2)
// From the third re-review of the borrow-check work (g302bor2), written as programs rustc accepts. Since v0.30.1 at least.
// EXPECT: 6
struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn main() {
    let a = [1i64, 2, 3];
    let f = |x| x;
    let m = MyMap { i: a.iter(), f: f };
    let s: i64 = m.map(|r: &i64| *r).sum();
    println("{}", s);
}
