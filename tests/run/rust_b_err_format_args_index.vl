// RULE: D2.9
// (0.30.1) A format_args value's hole that is an element, `v[0]` (which
// the checker writes `v.as_slice()[0]`) or `w.v[0]`, is a place of v's
// block and is borrowed while the value lives, as a whole local is:
// dropping or clearing the Vec before the value is printed is rustc's
// E0505 or E0502. Before, the element was copied with no borrow and the
// print read the freed String (--check-alloc: a use after free).
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 25, column 10
// ERROR: error[borrowck.conflict]
// ERROR: line 30, column 5
// ERROR: error[borrowck.conflict]
// ERROR: line 35, column 5
// ERROR-COUNT: 3
use std::alloc::Allocator;

struct W<A: Allocator> {
    v: Vec<String<A>, A>,
}

fn main(gpa: Gpa) {
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello", gpa));
    let a = format_args("{}", v[0]);
    drop(v);
    println("{}", a);
    let mut u: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    u.push(String::from_in("hello", gpa));
    let b = format_args("{:?} {}", u[0], 1);
    u.clear();
    println("{}", b);
    let mut w = W { v: Vec::new_in(gpa) };
    w.v.push(String::from_in("hello", gpa));
    let c = format_args("{}", w.v[0]);
    w.v.clear();
    println("{}", c);
}
