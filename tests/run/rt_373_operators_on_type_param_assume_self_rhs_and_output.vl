// XFAIL: RT-373: (RT-217's other operators) in a generic body, `x == 5i64` with `T: PartialEq<i64>`, `x < 5i64` with `T: PartialOrd<i64>`, `!x` with `T: Not<Output = i64>` and `-x` with `T: Neg<Output = i64>` are refused: "expected 'T', got 'i64'", "expected 'i64', got 'W'" (0.30.2)
// rustc prints `true true 1 1 true true` (twin .rs.txt). vole: four
// errors, "expected 'T', got 'i64'" at the two comparisons (the right
// operand taken as T) and "expected 'i64', got 'W'" at the two unary
// operators in the instance (the result taken as T; "got 'T'" in the
// template when nothing calls them); v0.28.0 to v0.30.1 the same. The
// concrete forms (`w == 5i64`, `w < 6i64`) build. RT-217 is `a + b` with
// `T: Add<Output = i64>`.
// EXPECT: true true 1 1 true true
use std::cmp::Ordering;
use std::ops::{Neg, Not};

struct W {
    k: i64,
}

impl PartialEq<i64> for W {
    fn eq(&self, o: &i64) -> bool {
        self.k == *o
    }
}

impl PartialOrd<i64> for W {
    fn partial_cmp(&self, o: &i64) -> Option<Ordering> {
        self.k.partial_cmp(o)
    }
}

impl Not for W {
    type Output = i64;

    fn not(self) -> i64 {
        1
    }
}

impl Neg for W {
    type Output = i64;

    fn neg(self) -> i64 {
        1
    }
}

fn eqp<T: PartialEq<i64>>(x: T) -> bool {
    x == 5i64
}

fn ltp<T: PartialOrd<i64>>(x: T) -> bool {
    x < 5i64
}

fn notp<T: Not<Output = i64>>(x: T) -> i64 {
    !x
}

fn negp<T: Neg<Output = i64>>(x: T) -> i64 {
    -x
}

fn main() {
    let w = W { k: 5 };
    println("{} {} {} {} {} {}", eqp(W { k: 5 }), ltp(W { k: 4 }), notp(W { k: 0 }),
        negp(W { k: 0 }), w == 5i64, w < 6i64);
}
