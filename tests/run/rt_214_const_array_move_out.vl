// XFAIL: RT-214: `let a = A;` with `const A: [Option<D>; 2] = [None, None]` is refused: "cannot move out of 'A', a static" (a const is a fresh value at each use) (0.30.2)
// From g302copy's report (pre-existing, 0.30.1 too).
// EXPECT: 2
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

const A: [Option<D>; 2] = [None, None];

fn main() {
    let a = A;
    println("{}", a.len());
}
