// EDITION: rust
// RULE: D1.3
// (0.27.1) `&mut **r` through `&'a mut &'b mut i64` is supported by both
// derefs: its region is bounded by `'a`, which does not outlive `'b`.
// ERROR: error[borrowck.outlives]
// ERROR: line 11, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn f<'a, 'b>(r: &'a mut &'b mut i64) -> &'b mut i64 {
    &mut **r
}

fn main() {
    let mut x: i64 = 1;
    let mut m = &mut x;
    let r = f(&mut m);
    *r += 1;
    println("{}", x);
}
