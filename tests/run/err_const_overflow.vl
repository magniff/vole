// EDITION: rust
// (0.26.3, decision 6) With the overflow checks on, a constant expression
// whose + - *, unary - or shift overflows its type is an error, where the
// same arithmetic at run time would panic (explain arith.overflow). A
// negative literal is no negation: -128 as an i8 is fine.
// FLAGS: --overflow-checks=on
// ERROR: this constant expression overflows 'i32': attempt to add with overflow
// ERROR: help: with the overflow checks on (-O0, or --overflow-checks=on) a constant's arithmetic is checked as the program's
// ERROR: this constant expression overflows 'u8': attempt to subtract with overflow
// ERROR: this constant expression overflows 'i64': attempt to multiply with overflow
// ERROR: this constant expression overflows 'i8': attempt to negate with overflow
// ERROR: this constant expression overflows 'u32': attempt to shift left with overflow
// ERROR-COUNT: 5
const A: i32 = 2147483647 + 1;
const B: u8 = 3 - 4;
const C: i64 = 9223372036854775807 * 2;
const M: i8 = -128;
const F: u64 = 0xffffffff * 0xffffffff;
const N: i8 = -M;
const S: u32 = 1 << 32;

fn main() {
    println("{} {} {} {} {} {} {}", A, B, C, M, F, N, S);
}
