// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 5
// EXPECT: 5
fn mid(v: &mut Vec<i64, Gpa>) -> &mut [i64] { &mut v[0..1] }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let m = mid(&mut v);
    m[0] = 5;
    println("{}", v[0]);
    0
}
