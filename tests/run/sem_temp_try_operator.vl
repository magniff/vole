// EDITION: rust
// (0.25) An operator's owned temporary operand is dropped, once, when the
// other operand's `?` leaves the statement first, and at the end of the
// statement when the operator runs.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: r -1
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 5
// EXPECT: r 5
use std::alloc::Allocator; use std::ops::Add; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

impl Add for D<Gpa> { type Output = D<Gpa>;
    fn add(self, other: D<Gpa>) -> D<Gpa> { D { id: self.id + other.id, v: self.v.clone() } }
}

fn bad(gpa: Gpa) -> Result<D<Gpa>, i64> { Err(-1i64) }
fn good(gpa: Gpa) -> Result<D<Gpa>, i64> { Ok(mk(3, gpa)) }
fn f1(gpa: Gpa) -> Result<i64, i64> { let s = mk(1, gpa) + bad(gpa)?; Ok(s.id) }
fn f2(gpa: Gpa) -> Result<i64, i64> { let s = mk(2, gpa) + good(gpa)?; Ok(s.id) }

fn main(gpa: Gpa) {
    println("r {}", match f1(gpa) { Ok(x) => x, Err(e) => e });
    println("r {}", match f2(gpa) { Ok(x) => x, Err(e) => e });
}
