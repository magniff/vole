// RULE: D8.1
// (0.28.0) Each operand of `&&` and `||` is a terminating scope, as
// rustc's: its temporaries drop before the other operand is evaluated,
// in a condition (if, while, a match guard, under `!`) and in a value
// (`let v = a && b`). 0.27.8 dropped them at the end of the condition or
// the statement. Two guards of one lock in `l.lock().a() > 0 &&
// l.lock().b() > 1` are then held one at a time: 0.27.8 held both (a
// deadlock with a real lock; here, the guard says so).
// EXPECT: test 1 true
// EXPECT: drop 1
// EXPECT: test 2 false
// EXPECT: drop 2
// EXPECT: else 1
// EXPECT: test 3 false
// EXPECT: drop 3
// EXPECT: test 4 true
// EXPECT: drop 4
// EXPECT: then 2
// EXPECT: test 5 true
// EXPECT: drop 5
// EXPECT: test 6 true
// EXPECT: drop 6
// EXPECT: test 7 false
// EXPECT: drop 7
// EXPECT: else 3
// EXPECT: test 10 true
// EXPECT: drop 10
// EXPECT: test 20 true
// EXPECT: drop 20
// EXPECT: test 11 true
// EXPECT: drop 11
// EXPECT: test 21 true
// EXPECT: drop 21
// EXPECT: test 12 false
// EXPECT: drop 12
// EXPECT: test 30 true
// EXPECT: drop 30
// EXPECT: test 31 true
// EXPECT: drop 31
// EXPECT: v true
// EXPECT: test 32 false
// EXPECT: drop 32
// EXPECT: test 33 false
// EXPECT: drop 33
// EXPECT: w false
// EXPECT: test 40 true
// EXPECT: drop 40
// EXPECT: test 41 true
// EXPECT: drop 41
// EXPECT: test 40 false
// EXPECT: drop 40
// EXPECT: guard 1 2
// EXPECT: both
// EXPECT: both true
// EXPECT: n 2
use std::cell::Cell;

struct D {
    id: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

impl D {
    fn ok(&self, v: bool) -> bool {
        println("test {} {}", self.id, v);
        v
    }
}

struct Lock {
    held: Cell<bool>,
    a: i64,
    b: i64,
}

struct Guard<'a> {
    l: &'a Lock,
}

impl Lock {
    fn lock(&self) -> Guard<'_> {
        if self.held.get() {
            println("deadlock");
        }
        self.held.set(true);
        Guard { l: self }
    }
}

impl<'a> Drop for Guard<'a> {
    fn drop(&mut self) {
        self.l.held.set(false);
    }
}

impl<'a> Guard<'a> {
    fn a(&self) -> i64 {
        self.l.a
    }

    fn b(&self) -> i64 {
        self.l.b
    }
}

fn guard(x: i64) -> i64 {
    match x {
        n if (D { id: 40 }).ok(n > 0) && (D { id: 41 }).ok(n < 10) => 1,
        _ => 2,
    }
}

fn main() {
    if (D { id: 1 }).ok(true) && (D { id: 2 }).ok(false) {
        println("then 1");
    } else {
        println("else 1");
    }
    if (D { id: 3 }).ok(false) || (D { id: 4 }).ok(true) {
        println("then 2");
    }
    if !((D { id: 5 }).ok(true) && (D { id: 6 }).ok(true)) || (D { id: 7 }).ok(false) {
        println("then 3");
    } else {
        println("else 3");
    }
    let mut k = 0;
    while (D { id: 10 + k }).ok(k < 2) && (D { id: 20 + k }).ok(true) {
        k += 1;
    }
    let v = (D { id: 30 }).ok(true) && (D { id: 31 }).ok(true);
    println("v {}", v);
    let w = (D { id: 32 }).ok(false) || (D { id: 33 }).ok(false);
    println("w {}", w);
    println("guard {} {}", guard(5), guard(-1));
    let l = Lock { held: Cell::new(false), a: 1, b: 2 };
    if l.lock().a() > 0 && l.lock().b() > 1 {
        println("both");
    }
    let both = l.lock().a() == 1 && l.lock().b() == 2;
    println("both {}", both);
    let mut n = 0;
    while l.lock().a() > 0 && l.lock().b() > n {
        n += 1;
    }
    println("n {}", n);
}
