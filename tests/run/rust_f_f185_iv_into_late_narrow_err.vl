// RULE: F18.5
// (0.30.2) `let r: i32 = a.into()` of an integer variable a later use
// makes i64: From<i64> for i32 does not hold, rustc's E0277.
// ERROR: the trait 'From<i64>' is not implemented for 'i32' (rustc E0277)
fn main() {
    let a = 5000000000;
    let r: i32 = a.into();
    let c: i64 = a;
    println("{} {}", r, c);
}
