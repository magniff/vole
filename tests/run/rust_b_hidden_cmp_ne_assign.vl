// RULE: D2.9
// (0.30.1) An overloaded comparison is `PartialEq::ne(&a, &b)`: the left
// operand is borrowed for the call, so the right operand's write to it
// is E0506 (vole's assign_borrowed) at the write.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 17, column 9
// ERROR-COUNT: 1
#[derive(PartialEq, Clone, Copy)]
struct P {
    x: i64,
}

fn main() {
    let mut p = P { x: 1 };
    let q = P { x: 2 };
    let r = p != {
        p.x = 2;
        q
    };
    println("{r}");
}
