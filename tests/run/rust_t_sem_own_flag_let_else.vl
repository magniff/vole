// (0.27.0) Hand-translated from tests/run/sem_own_flag_let_else.vl to Rust's spelling.
// sem-own: let-else moving an owned payload; the else diverges.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn f(o: Option<D<Gpa>>) -> i64 {
    let Some(d) = o else {
        return -1;
    };
    println("got {}", d.id);
    d.id
}

fn main(gpa: Gpa) {
    f(Some(mk(1, gpa)));
    println("end");
}
