// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Mul::Output.
// EXPECT: V { x: 60 }
use std::ops::Mul;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Mul for V {
    type Output = V;

    fn mul(self, rhs: V) -> V {
        V { x: self.x * rhs.x }
    }
}

fn apply<T: Mul<Output = T>>(a: T, b: T) -> T {
    a * b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    let c: <V as Mul>::Output = apply(a, b);
    println("{:?}", c);
}
