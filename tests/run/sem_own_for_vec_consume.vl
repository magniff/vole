// sem-own: `for x in v` over an owned Vec of owned items: each item dropped
// once (in the body, or with the Vec), never twice.
// EXPECT: it 1
// EXPECT: it 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    v.push(mk(2, gpa));
    for x in &v { println("it {}", x.id); }
    println("end");
}
