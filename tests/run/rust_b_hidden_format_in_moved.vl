// RULE: D2.9
// (0.30.1) format_in's holes borrow as println's do: the move of s into
// a later argument while the first hole holds it is E0505 (vole's
// move_borrowed) at the move. Before, the result was made from the
// freed block (a use after free under --check-alloc).
// ERROR: error[borrowck.move_borrowed]
// ERROR: line 11, column 45
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let s = format_in("abcdefghijklmnopqrstuvwxyz {}", 1, gpa);
    let t = format_in("{} {}", s, { let q = s; q.len() }, gpa);
    println("{t}");
}
