// EDITION: rust
// RULE: F6.3
// A `&mut self` method of a generic trait called on a `let` binding,
// `s.index_mut(r)` of IndexMut, needs the binding mutable, as any other
// `&mut self` method does (rustc E0596).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 's' as mutable, as it is not declared as mutable (rustc E0596)
// ERROR-COUNT: 1
// RUSTC: rejects E0596 cannot borrow `s` as mutable
use std::ops::IndexMut;

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let t = s.index_mut(1usize..);
    println("{}", t);
}
