// sem-own (iterator stopgap): for (k, v) in a BTreeMap's iter() keeping v.
// ERROR: own.
use std::HashMap;
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn two(gpa: Gpa) -> Vec<D<Gpa>, Gpa> {
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn eat(d: sink D<Gpa>) {}
impl Eq for D<Gpa> { fn eq(self, other: D<Gpa>) -> bool { self.id == other.id } }
impl Ord for D<Gpa> { fn cmp(self, other: D<Gpa>) -> i64 { self.id - other.id } }
fn gcollect<T>(s: [T], gpa: Gpa) -> Vec<T, Gpa> { s.iter().collect_in(gpa) }

fn gkeep<T>(s: [T], gpa: Gpa) -> Vec<T, Gpa> {
    var k: Vec<T, Gpa> = Vec::new_in(gpa); for x in s.iter() { k.push(x); } k
}

fn gfirst<T>(s: [T]) -> T { s[0] }
fn gvget<T>(v: Vec<T, Gpa>) -> T { v.get(0) }

fn main(gpa: Gpa) {
    let w = two(gpa);
    var m: std::BTreeMap<i64, D<Gpa>, Gpa> = std::BTreeMap::new_in(gpa);
    m.insert(1, mk(3, gpa));
    var keep: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for (k, v) in m.iter() { keep.push(v); }
}
