// RT-40 (0.30.1, review 8) A Drop impl's trait bound can add an outlives
// through an associated-type binding: the declaration's `T:
// Iterator<Item = &'a str>`, the impl's `Item = &'static str` (review 8's
// d18), or an `Fn` bound's result, `Fn() -> &'static str` for `Fn() ->
// &'a str` (d19). The bounds are compared as resolved types, whose
// lifetimes are erased, so they look the same; `drop` keeps a dropped
// String's str as 'static. --check-alloc: "use after free: block #1 (22
// bytes), allocated at 31:18, freed at 33:5". rustc E0367. Every build
// accepts it. Also accepted where rustc gives E0367, with no hole found:
// `where Self: 'static` and `where (T,): 'static` on a Drop impl (d13,
// d12; such a predicate is not assumed in the body). The obligation
// engine compares the predicates with their regions (0.30.2).
// XFAIL: RT-40: a Drop impl's associated-type binding or Fn result adds an outlives the declaration lacks (0.30.2)
// FLAGS: --check-alloc
// ERROR: trait.drop_impl
// ERROR-COUNT: 1
struct W<'o, 'a, T: Iterator<Item = &'a str>> { out: &'o mut Option<&'static str>, t: T, k: &'a u8 }

impl<'o, 'a, T: Iterator<Item = &'static str>> Drop for W<'o, 'a, T> {
    fn drop(&mut self) {
        if let Some(s) = self.t.next() {
            self.out.replace(s);
        }
    }
}

fn main(gpa: Gpa) {
    let n: u8 = 1;
    let mut v: Option<&'static str> = None;
    {
        let st = String::from_in("hello heap string long", gpa);
        let x = W { out: &mut v, t: std::iter::once(st.as_str()), k: &n };
    }
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", v.unwrap(), w);
}
