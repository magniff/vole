// EDITION: rust
// RULE: F24.1
// `pub(crate)` on an item or a field makes it visible in the whole crate;
// a module's own items are visible in it and its descendants.
// EXPECT: 7
mod shapes {
    pub(crate) struct Sq {
        pub(crate) side: i64,
    }

    pub(crate) fn area(s: &Sq) -> i64 {
        inner::scale(s.side * s.side)
    }

    mod inner {
        pub(crate) fn scale(x: i64) -> i64 {
            x - 2
        }
    }
}

fn main() {
    let s = shapes::Sq { side: 3 };
    println("{}", shapes::area(&s));
}
