// XFAIL: RT-172: a trait path used as a constant, `let c: S = Mk::Z;`, is refused ("'Mk' is a trait, not a type") (0.30.2)
// From the g302qual review (form f43_trait_static_path_inferred).
// EXPECT: 1 2 5 2
trait Mk { fn mk() -> Self; const Z: Self; }
trait Mk2 { fn mk() -> Self; }
#[derive(Debug)]
struct S { v: i64 }
impl Mk for S { fn mk() -> S { S { v: 1 } } const Z: S = S { v: 5 }; }
impl Mk2 for S { fn mk() -> S { S { v: 2 } } }

fn main() {
    let a: S = Mk::mk(); let b: S = Mk2::mk(); let c: S = Mk::Z; let f: fn() -> S = Mk2::mk;
    println("{} {} {} {}", a.v, b.v, c.v, f().v);
}
