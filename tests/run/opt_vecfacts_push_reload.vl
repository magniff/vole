// FLAGS: --check-alloc
// EXPECT: inout 40 39 780 780
// EXPECT: local 40 39 780
// EXPECT: static 40 39 780
// EXPECT: copy 64 64 16 1584
// EXPECT: every 6 1 2 3 1 2 3
// (0.25.4) A loop that pushes to the Vec it indexes: the push writes the
// header (len, and ptr and cap when it grows), so the header is read
// again after it; middle::vecfacts' facts are about stores through the
// buffer only. The Vec starts small, so it moves several times while the
// loop runs: a ptr kept from before a growth would read freed memory
// (--check-alloc: the pages of a block given back are gone).
// Through an inout parameter, a local and a static; the bound re-read in
// a while loop; `for i in 0..v.len()` (the bound read once) copying each
// element to the end.
struct Heap {}

// UNSAFE: C's allocator, which Heap hands out.
// SAFETY: called with sizes checked non-negative, on blocks Heap allocated.
extern "C" {
    fn malloc(n: u64) -> *u8;
    fn realloc(p: *u8, n: u64) -> *u8;
    fn free(p: *u8);
}

impl Allocator for Heap {
    fn try_alloc(self: *Heap, size: i64, align: i64) -> *u8 {
        if size < 0 {
            return 0 as *u8;
        }
        // UNSAFE: C's allocator.
        // SAFETY: size is checked non-negative.
        unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block.
    unsafe fn try_resize(self: *Heap, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        realloc(p, if new_size <= 0 { 1 } else { new_size } as u64)
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block, once.
    unsafe fn free(self: *Heap, p: *u8, size: i64, align: i64) {
        free(p);
    }
}

static var S: Vec<i64, Heap> = Vec::new_in(Heap {});

// Each element below 30 pushes itself + 10 (chains up to 39); the loop's
// bound is the length, read again each time. Returns the sum.
#[inline(never)]
fn chain(v: inout Vec<i64>) -> i64 {
    var i = 0;
    var s = 0;
    while i < v.len() {
        let x = v[i];
        if x < 30 {
            v.push(x + 10);
        }
        s += x;
        i += 1;
    }
    s
}

#[inline(never)]
fn total(v: Vec<i64>) -> i64 {
    var t = 0;
    for i in 0..v.len() {
        t += v[i];
    }
    t
}

#[inline(never)]
fn chain_static() -> i64 {
    var i = 0;
    while i < S.len() {
        let x = S[i];
        if x < 30 {
            S.push(x + 10);
        }
        i += 1;
    }
    S[S.len() - 1]
}

// Copies each of the first n elements to the end: 2n elements, then their
// sum.
#[inline(never)]
fn double(v: inout Vec<i64>) -> i64 {
    for i in 0..v.len() {
        v.push(v[i] * 2);
    }
    var t = 0;
    for i in 0..v.len() {
        t += v[i];
    }
    t
}

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        a.push(i);
    }
    let r = chain(&a);
    println(f"inout {a.len()} {a[a.len() - 1]} {r} {total(a)}");
    var b: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        b.push(i);
    }
    var i = 0;
    while i < b.len() {
        let x = b[i];
        if x < 30 {
            b.push(x + 10);
        }
        i += 1;
    }
    println(f"local {b.len()} {b[b.len() - 1]} {total(b)}");
    for k in 0..10 {
        S.push(k);
    }
    let last = chain_static();
    var st = 0;
    for k in 0..S.len() {
        st += S[k];
    }
    println(f"static {S.len()} {last} {st}");
    var c: Vec<i64> = Vec::new_in(gpa);
    for k in 0..32 {
        c.push(k + 1);
    }
    let t = double(&c);
    println(f"copy {c.len()} {c[63]} {c[15]} {t}");
    var d: Vec<i64> = Vec::new_in(gpa);
    d.push(1);
    d.push(2);
    d.push(3);
    for k in 0..d.len() {
        d.push(d[k]);
    }
    println(f"every {d.len()} {d[0]} {d[1]} {d[2]} {d[3]} {d[4]} {d[5]}");
}
