// EDITION: rust
// FLAGS: --check-alloc
// EXPECT: inout 40 39 780 780
// EXPECT: local 40 39 780
// EXPECT: static 40 39 780
// EXPECT: copy 64 64 16 1584
// EXPECT: every 6 1 2 3 1 2 3
// (0.25.4) A loop that pushes to the Vec it indexes: the push writes the
// header (len, and ptr and cap when it grows), so the header is read
// again after it; middle::vecfacts' facts are about stores through the
// buffer only. The Vec starts small, so it moves several times while the
// loop runs: a ptr kept from before a growth would read freed memory
// (--check-alloc: the pages of a block given back are gone).
// Through an inout parameter, a local and a static; the bound re-read in
// a while loop; `for i in 0..v.len()` (the bound read once) copying each
// element to the end.
use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError; use std::alloc::Allocator; #[derive(Clone, Copy)] struct Heap {}

// UNSAFE: C's allocator, which Heap hands out.
// SAFETY: called with sizes checked non-negative, on blocks Heap allocated.
extern "C" {
    fn malloc(n: u64) -> *mut u8;
    fn realloc(p: *mut u8, n: u64) -> *mut u8;
    fn free(p: *mut u8);
}

// UNSAFE: a test's allocator built over C's (0.26.3: Allocator is an unsafe trait).
// SAFETY: its memory comes from C's malloc, realloc and free, aligned to 16.
unsafe impl Allocator for Heap {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> { let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
        if size < 0 {
            return NonNull::new(0 as *mut u8).ok_or(AllocError);
        }
        // UNSAFE: C's allocator.
        // SAFETY: size is checked non-negative.
        unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
    }).ok_or(AllocError) }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block.
    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>, AllocError> { let p = __p.as_ptr(); let old_size = __old.size() as i64; let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
        realloc(p, if new_size <= 0 { 1 } else { new_size } as u64)
    }).ok_or(AllocError) } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>, AllocError> { unsafe { self.grow(p, old, new) } }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block, once.
    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) { let p = __p.as_ptr(); let size = __layout.size() as i64; let align = __layout.align() as i64;
        free(p);
    }
}

// (0.26.3: a static holds no allocator, alloc.static: the static keeps
// the address of main's Vec, as plain bytes, and chain_static reaches the
// Vec through it, its header in memory a call may change.)
static mut S_AT: *mut u8 = 0 as *mut u8;

// Each element below 30 pushes itself + 10 (chains up to 39); the loop's
// bound is the length, read again each time. Returns the sum.
#[inline(never)]
fn chain(v: &mut Vec<i64, Gpa>) -> i64 {
    let mut i: i64 = 0;
    let mut s: i64 = 0;
    while i < v.len() as i64 {
        let x = v[i as usize];
        if x < 30 {
            v.push(x + 10);
        }
        s += x;
        i += 1;
    }
    s
}

#[inline(never)]
fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for i in 0..v.len() {
        t += v[i];
    }
    t
}

#[inline(never)]
fn chain_static() -> i64 {
    // UNSAFE: main's Vec, through the address the static keeps.
    // SAFETY: S_AT is main's `s`, set before the call; s outlives it and
    // nothing else uses it meanwhile.
    unsafe {
        let s = S_AT as *mut Vec<i64, Heap>;
        let mut i: i64 = 0;
        while i < (*s).len() as i64 {
            let x = (*s)[i as usize];
            if x < 30 {
                (*s).push(x + 10);
            }
            i += 1;
        }
        (*s)[(*s).len() - 1]
    }
}

// Copies each of the first n elements to the end: 2n elements, then their
// sum.
#[inline(never)]
fn double(v: &mut Vec<i64, Gpa>) -> i64 {
    for i in 0..v.len() {
        { let at_arg1 = v[i] * 2; v.push(at_arg1) };
    }
    let mut t: i64 = 0;
    for i in 0..v.len() {
        t += v[i];
    }
    t
}

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 {
        a.push(i);
    }
    let r = chain(&mut a);
    println("inout {} {} {r} {}", a.len(), a[a.len() - 1], total(&a));
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 {
        b.push(i);
    }
    let mut i: i64 = 0;
    while i < b.len() as i64 {
        let x = b[i as usize];
        if x < 30 {
            b.push(x + 10);
        }
        i += 1;
    }
    println("local {} {} {}", b.len(), b[b.len() - 1], total(&b));
    let mut s: Vec<i64, Heap> = Vec::new_in(Heap {});
    for k in 0..10 {
        s.push(k);
    }
    // UNSAFE: s's address kept in the static, as bytes.
    // SAFETY: s lives to the end of main, past chain_static's use.
    unsafe { S_AT = &mut s as *mut Vec<i64, Heap> as *mut u8; }
    let last = chain_static();
    let mut st: i64 = 0;
    for k in 0..s.len() {
        st += s[k];
    }
    println("static {} {last} {st}", s.len());
    let mut c: Vec<i64, Gpa> = Vec::new_in(gpa);
    for k in 0..32 {
        c.push(k + 1);
    }
    let t = double(&mut c);
    println("copy {} {} {} {t}", c.len(), c[63], c[15]);
    let mut d: Vec<i64, Gpa> = Vec::new_in(gpa);
    d.push(1);
    d.push(2);
    d.push(3);
    for k in 0..d.len() {
        { let at_arg1 = d[k]; d.push(at_arg1) };
    }
    println("every {} {} {} {} {} {} {}", d.len(), d[0], d[1], d[2], d[3], d[4], d[5]);
}
