// XFAIL: RT-454: a bound's associated type of an opaque type, `fn pick<S: Src>(s: S) -> S::It` called with `mk(&v)` returning `impl Src + 'a` (no `It =` written), is refused in the instance: "'impl Src + 'a' has no associated type 'It'"; rustc keeps the projection opaque (It: Debug) and prints 1000 (0.30.2)
// From the re-review of g302bor2 (its form o15_opaque_nobinding_two_ok).
// Since v0.30.1 at least (the same error on v0.30.1 and the release
// build, 38fe466c5). Its use-after-free side (once it is accepted, the
// result must keep v's borrow) is rt_454b; the `Item =` form rt_454c and
// rt_454d. The zip form of the review (o14) fails first with RT-200's
// error.
// EXPECT: 1000
use std::fmt::Debug;

trait Src {
    type It: Debug;
    fn get(self) -> Self::It;
}

impl<'a> Src for &'a Vec<i64, Gpa> {
    type It = &'a i64;

    fn get(self) -> &'a i64 {
        &self[0]
    }
}

fn mk<'a>(v: &'a Vec<i64, Gpa>) -> impl Src + 'a {
    v
}

fn pick<S: Src>(s: S) -> S::It {
    s.get()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(5);
    let a = pick(mk(&v));
    drop(w);
    println("{:?}", a);
}
