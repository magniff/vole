// (0.30.1, E3.3c) std's generic functions with an #[effects] list, at
// instances whose type arguments' methods do nothing (i64, a struct with
// derived traits): a list that held only because a key's own method
// brought the same effect (&str's cmp a panic) is found here. BTreeMap's
// entry, or_insert, or_insert_with, or_default and clone_in lacked
// `panic` (their checked index in locate and iter): refused before.
// EXPECT: 321
use std::collections::{BTreeMap, BTreeSet, BinaryHeap, HashMap, HashSet};
use std::hash::FixedState;

#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]
struct P {
    a: i64,
}

fn btree_i64(gpa: Gpa) -> i64 {
    let mut b: BTreeMap<i64, i64, Gpa> = BTreeMap::new_in(gpa);
    b.insert(1, 2);
    *b.entry(2).or_insert(0) += 1;
    *b.entry(3).or_insert_with(|| 4) += 1;
    *b.entry(4).or_default() += 1;
    b.entry(5).and_modify(|v| *v += 1).or_insert(9);
    let mut t: i64 = 0;
    if let Some(v) = b.get(&1) { t += *v; }
    if let Some(v) = b.get_mut(&1) { *v += 1; }
    t += b.len() as i64 + if b.contains_key(&2) { 1 } else { 0 };
    if let Some((k, v)) = b.first_key_value() { t += *k + *v; }
    if let Some((k, v)) = b.last_key_value() { t += *k + *v; }
    if let Some((k, v)) = b.get_key_value(&2) { t += *k + *v; }
    for (k, v) in b.iter() { t += *k + *v; }
    for k in b.keys() { t += *k; }
    for v in b.values() { t += *v; }
    for (k, _) in b.range(1..3) { t += *k; }
    let c = b.clone();
    t += if c == b { 1 } else { 0 };
    t += b[&1];
    b.remove(&1);
    b.remove_entry(&2);
    b.pop_first();
    b.pop_last();
    for (k, v) in c { t += k + v; }
    b.clear();
    t
}

fn btree_p(gpa: Gpa) -> i64 {
    let mut b: BTreeMap<P, P, Gpa> = BTreeMap::new_in(gpa);
    b.insert(P { a: 1 }, P { a: 2 });
    b.entry(P { a: 2 }).or_insert(P { a: 0 }).a += 1;
    b.entry(P { a: 3 }).or_default().a += 1;
    let mut t: i64 = 0;
    if let Some(v) = b.get(&P { a: 1 }) { t += v.a; }
    for (k, v) in b.iter() { t += k.a + v.a; }
    b.remove(&P { a: 1 });
    let mut s: BTreeSet<P, Gpa> = BTreeSet::new_in(gpa);
    s.insert(P { a: 1 });
    s.insert(P { a: 2 });
    t += if s.contains(&P { a: 1 }) { 1 } else { 0 };
    if let Some(x) = s.first() { t += x.a; }
    if let Some(x) = s.last() { t += x.a; }
    if let Some(x) = s.get(&P { a: 2 }) { t += x.a; }
    for x in s.iter() { t += x.a; }
    s.remove(&P { a: 1 });
    s.take(&P { a: 2 });
    s.pop_first();
    s.pop_last();
    t
}

fn bset_i64(gpa: Gpa) -> i64 {
    let mut s: BTreeSet<i64, Gpa> = BTreeSet::new_in(gpa);
    let mut o: BTreeSet<i64, Gpa> = BTreeSet::new_in(gpa);
    s.insert(1);
    s.insert(2);
    o.insert(2);
    let mut t: i64 = s.len() as i64;
    t += if s.is_subset(&o) { 1 } else { 0 };
    t += if s.is_superset(&o) { 1 } else { 0 };
    t += if s.is_disjoint(&o) { 1 } else { 0 };
    for x in s.range(0..5) { t += *x; }
    let c = s.clone();
    t += c.len() as i64;
    t
}

fn hash_i64(gpa: Gpa) -> i64 {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    *m.entry(2).or_insert(0) += 1;
    *m.entry(3).or_default() += 1;
    *m.entry(4).or_insert_with(|| 7) += 1;
    let mut t: i64 = 0;
    if let Some(v) = m.get(&1) { t += *v; }
    if let Some(v) = m.get_mut(&1) { *v += 1; }
    t += if m.contains_key(&2) { 1 } else { 0 };
    for (k, v) in m.iter() { t += *k + *v; }
    for k in m.keys() { t += *k; }
    for v in m.values() { t += *v; }
    m.reserve(10);
    m.shrink_to_fit();
    let c = m.clone();
    t += c.len() as i64;
    m.remove(&1);
    m.retain(|k: &i64, _v: &mut i64| *k > 2);
    m.clear();
    let mut h: HashSet<P, Gpa, FixedState> = HashSet::new_in(gpa);
    h.insert(P { a: 1 });
    t += if h.contains(&P { a: 1 }) { 1 } else { 0 };
    h.remove(&P { a: 1 });
    for x in h.iter() { t += x.a; }
    t
}

fn heap_i64(gpa: Gpa) -> i64 {
    let mut h: BinaryHeap<i64, Gpa> = BinaryHeap::new_in(gpa);
    h.push(3);
    h.push(1);
    let mut t: i64 = 0;
    if let Some(x) = h.peek() { t += *x; }
    if let Some(x) = h.pop() { t += x; }
    t += h.len() as i64;
    let v = h.into_sorted_vec();
    t += v.len() as i64;
    t
}

fn vec_i64(gpa: Gpa) -> i64 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.push(2);
    v.extend_from_slice(&[5, 4]);
    v.insert(0, 9);
    v.remove(1);
    v.swap_remove(0);
    v.retain(|x| *x > 0);
    v.sort();
    v.sort_by(|a, b| b.cmp(a));
    v.sort_unstable();
    v.dedup();
    v.reverse();
    v.truncate(4);
    v.resize(6, 0);
    let mut t: i64 = 0;
    t += if v.contains(&3) { 1 } else { 0 };
    if let Some(x) = v.first() { t += *x; }
    if let Some(x) = v.last() { t += *x; }
    if let Some(x) = v.iter().max() { t += *x; }
    if let Some(x) = v.iter().min() { t += *x; }
    t += v.iter().sum::<i64>();
    t += v.iter().map(|x| x * 2).filter(|x| *x > 2).count() as i64;
    if let Ok(i) = v.binary_search(&3) { t += i as i64; }
    let c = v.clone();
    t += c.len() as i64;
    let s = v.as_slice();
    t += s.iter().rev().take(2).sum::<i64>();
    for w in s.windows(2) { t += w[0]; }
    for ch in s.chunks(2) { t += ch[0]; }
    v.pop();
    v.clear();
    let mut q: Vec<P, Gpa> = Vec::new_in(gpa);
    q.push(P { a: 2 });
    q.push(P { a: 1 });
    q.sort();
    q.dedup();
    t += if q.contains(&P { a: 1 }) { 1 } else { 0 };
    t
}

fn opt_res() -> i64 {
    let o: Option<i64> = Some(3);
    let r: Result<i64, i64> = Ok(4);
    let mut t: i64 = 0;
    t += o.unwrap_or(0) + o.map(|x| x + 1).unwrap_or_default();
    t += r.unwrap_or(0) + r.map(|x| x + 1).unwrap_or(0);
    t += o.ok_or(0).unwrap_or(0);
    t += std::cmp::max(t, 3) + std::cmp::min(t, 3);
    t
}

fn main(gpa: Gpa) {
    println("{}", btree_i64(gpa) + btree_p(gpa) + bset_i64(gpa) + hash_i64(gpa) + heap_i64(gpa)
        + vec_i64(gpa) + opt_res());
}
