// EDITION: rust
// a scoped thread given an inout slice (exclusive) of v: writes through it
// ERROR: error[borrowck.mut_twice]
// ERROR: line 12, column 26
use std::thread;
fn fill(s: &mut [i64]) { for i in 0..s.len() { s[i] = 7; } }

fn main() {
    let mut a = [0i64, 0, 0, 0];
    thread::scope(|s| ({ let sc = s; {
        let x = sc.spawn(|| { fill(&mut a[0..2]); 0 });
        let y = sc.spawn(|| { fill(&mut a[0..2]); 0 });
        x.join().unwrap() + y.join().unwrap()
    } })); println("{}", a[0]);
}
