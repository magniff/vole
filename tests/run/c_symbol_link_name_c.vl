// 0.30.1: C's functions under other vole names are C's: `#[link_name =
// "exit"] fn leave` diverges and does io, `#[link_name = "malloc"] fn grab`
// allocates (front::effects knows a C function by its symbol), so the
// declared effects below refuse them.
// ERROR: [effect]: 'quiet' is #[no_io], but it does io: 'leave(0)'
// ERROR: [effect]: 'fixed' is #[no_alloc], but it allocates from C (malloc): 'grab(8)'
extern "C" {
    #[link_name = "exit"]
    fn leave(code: i32);
    #[link_name = "malloc"]
    fn grab(n: usize) -> *mut u8;
}

#[no_io]
fn quiet() {
    // UNSAFE: C's exit. SAFETY: any code.
    unsafe { leave(0) }
}

#[no_alloc]
fn fixed() -> *mut u8 {
    // UNSAFE: C's malloc. SAFETY: any size.
    unsafe { grab(8) }
}

fn main() {
    let _ = fixed();
    quiet();
}
