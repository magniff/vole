// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter::pad_integral.
// EXPECT: [  -42] [+42] [-0042] [0x2a] [0x002a]
use std::fmt::{Display, Formatter};

struct N {
    neg: bool,
    digits: &'static str,
}

impl Display for N {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.pad_integral(!self.neg, "0x", self.digits)
    }
}

fn main() {
    let m = N { neg: true, digits: "42" };
    let p = N { neg: false, digits: "42" };
    let h = N { neg: false, digits: "2a" };
    println("[{:5}] [{:+}] [{:05}] [{:#}] [{:#06}]", m, p, m, h, h);
}
