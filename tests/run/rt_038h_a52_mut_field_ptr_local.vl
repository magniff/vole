// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a52_mut_field_ptr_local)
// RUSTC: none contract clauses are not Rust
// ERROR: cannot borrow '*h.r' as mutable
// A held &mut cast to *mut into a local, then passed to a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

struct H<'a> { r: &'a mut i64 }

fn f(h: H) -> i64
    requires {
    let p: *mut i64 = h.r;
    poke(p)
}

{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(H { r: &mut x }));
    println("{}", x);
}
