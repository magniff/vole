// EDITION: rust
// FLAGS: --check-alloc --check-unsafe
// EXIT: 101
// EXPECT: 7
// STDERR: unsafe access out of bounds: 1 byte at offset 48 of block #1 (48 bytes), allocated at
// STDERR: checkalloc_unsafe.vl:13:13
// STDERR: -->
// STDERR: checkalloc_unsafe.vl: line 20, column 9
// 0.16: --check-unsafe with --check-alloc: raw accesses are checked
// against the checking Gpa's blocks, exactly (a block's last page has room
// after its end, which a fault would not find).
use std::alloc::Layout; fn main(gpa: Gpa) {
    let p = gpa
        .allocate(Layout::from_size_align(48 as usize, 8 as usize).unwrap())
        .unwrap()
        .as_ptr();
    unsafe {
        (*p.add(47)) = 7;
        println("{}", (*p.add(47)));
        (*p.add(48)) = 1;
    }
}
