// RULE: F15.1
// A primitive's builtin Sum and Product are of references too, `Sum<&'a
// P> for P` (`v.iter().sum()`), and char is Clone and Copy, as in Rust's
// core.
// EXPECT: 6 6 6.5 xtrueyz
fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3], gpa);
    let s: i64 = v.iter().sum();
    let p: i64 = v.iter().product();
    let f = Vec::from_in([2.5f64, 4.0], gpa);
    let t: f64 = f.iter().sum();
    let c = 'x';
    let d = c;
    let cs = ['y', 'z'];
    let e: Vec<char, Gpa> = cs.iter().copied().collect_in(gpa);
    println("{} {} {} {}{}{}{}", s, p, t, c, d.clone() == 'x', e[0], e[1]);
}
