// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Map::impl Iterator.
// EXPECT: Some(2) (1, Some(1))
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().map(|x| x * 2);
    let a = it.next();
    println("{:?} {:?}", a, it.size_hint());
}
