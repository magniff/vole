// 0.25.3: a text block's line indented less than its closing """ (the
// indentation removed from every line) is lex.text-block-indent, its fix
// the line indented as the closing line; tabs and spaces are told apart.
// The lexing goes on: the next block's error too.
// ERROR: error[lex.text-block-indent]: a text block's line is indented 6 bytes; its closing '"""' is indented 8
// ERROR: help: the closing line's indentation is removed from every line: indent the line at least as much, or move the closing '"""' left
// ERROR: fix --suggested
// ERROR: error[lex.text-block-indent]: a text block's line is indented 1 byte; its closing '"""' is indented 4
// ERROR: help: the indentation mixes tabs and spaces: the closing line's indentation must begin every line, byte for byte
fn main() -> i32 {
    let a = """
        fine
      short
        """;
    let b = """
	tab
    """;
    println(a);
    println(b);
    0
}
