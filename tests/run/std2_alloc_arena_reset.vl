// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Arena::reset.
// EXPECT: 0 true 5
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let mut arena = Arena::new_in(gpa);
    arena.alloc_slice_fill_with(20000, |_| 0u8);
    arena.reset();
    let used = arena.used();
    let kept = arena.allocated_bytes() < 20000;
    let x = arena.alloc(5i64);
    println("{} {} {}", used, kept, x);
}
