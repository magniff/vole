// 0.26.0: what private fields allow. A `pub` field is visible wherever its
// struct is (a literal of a struct whose fields are all `pub` too); a
// module inside the declaring one sees the private ones; the compiler's
// own code is let through: main's `Gpa {}` (Gpa has a private field), a
// derive (Eq, Clone, Debug, Ord), structural `==`, a closure capturing a
// struct, an f-string, std's generic functions instantiated here
// (std::time::sleep's SysTimespec, Vec's fields).
// EXPECT: 3 4 7
// EXPECT: true false Tag { id: 3, hidden: 30 } true
// EXPECT: 9 [1, 2]
// EXPECT: open 5
mod geo {
    pub struct Rect { pub w: i64, pub h: i64 }

    #[derive(Eq, Ord, Clone, Debug)]
    pub struct Tag { pub id: i64, hidden: i64 }

    pub fn tag(id: i64) -> Tag {
        Tag { id: id, hidden: id * 10 }
    }

    pub struct Plain { pub a: i64, b: i64 }

    pub fn plain(a: i64) -> Plain {
        Plain { a: a, b: a + 1 }
    }

    pub mod inner {
        use super::Tag;

        // A module inside the declaring one sees its private fields.
        pub fn hidden(t: Tag) -> i64 {
            t.hidden
        }
    }
}

use geo::{Rect, Tag};

fn main(gpa: Gpa) {
    var r = Rect { w: 3, h: 2 };
    r.h = 4;
    println(f"{r.w} {r.h} {r.w + r.h}");
    let a = geo::tag(3);
    let b = a.clone();
    println(f"{a == b} {a == geo::tag(4)} {b:?} {a < geo::tag(4)}");
    let p = geo::plain(4);
    let q = geo::plain(4);
    let same = p == q;
    let f = || p.a + q.a + 1;
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    println(f"{f()} {v:?}");
    std::time::sleep(std::time::Duration::from_millis(1));
    let s = f"open {geo::inner::hidden(a) / 6}";
    if same {
        println(s);
    }
}
