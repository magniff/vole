// The std2 item(s): std::sync RwLock (new, read, write, try_read, try_write, get_mut,
// into_inner), RwLockReadGuard, RwLockWriteGuard, with scoped threads.
// EXPECT: 10 true true
// EXPECT: true
// EXPECT: 6
// EXPECT: 4006 4000
// EXPECT: 4007
use std::thread;
use std::sync::RwLock;

fn main() {
    let rw = RwLock::new(5);
    {
        let r1 = rw.read().unwrap();
        let r2 = rw.read().unwrap();
        println("{} {} {}", *r1 + *r2, rw.try_write().is_err(), rw.try_read().is_ok());
    }
    {
        let w = rw.write().unwrap();
        println("{}", rw.try_read().is_err());
        drop(w);
    }
    *rw.write().unwrap() += 1;
    println("{}", *rw.read().unwrap());
    let seen = RwLock::new(0);
    thread::scope(|s| {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..1000 {
                    *rw.write().unwrap() += 1;
                    let now = *rw.read().unwrap();
                    if now > 6 {
                        *seen.write().unwrap() += 1;
                    }
                }
            });
        }
    });
    println("{} {}", *rw.read().unwrap(), *seen.read().unwrap());
    let mut rw = rw;
    *rw.get_mut().unwrap() += 1;
    println("{}", rw.into_inner().unwrap());
}
