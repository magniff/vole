// RULE: F8.3, F8.4
// RT-C301-8 review (R2, form f52b_myfrom_qualified_ok): qualified paths to MyFrom and to From's intrinsic impls each their own trait's.
// rustc prints the EXPECT lines.
// EXPECT: 1005 5 7
trait MyFrom<T> { fn from(x: T) -> Self; }
impl MyFrom<u8> for i64 { fn from(x: u8) -> i64 { 1000 + x as i64 } }

fn main() {
    let a = <i64 as MyFrom<u8>>::from(5u8); let b = <i64 as From<u8>>::from(5u8);
    let c = <i64 as From<i32>>::from(7i32); println("{} {} {}", a, b, c);
}
