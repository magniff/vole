// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: n views a temporary
// EXPECT: hello
fn mk(gpa: Gpa) -> String<Gpa> { let mut b = String::new_in(gpa); b.push_str("hello"); b }

fn main(gpa: Gpa) -> i32 {
    let n = mk(gpa).as_bytes();
    println("{}", str::from_utf8(n).unwrap());
    0
}
