// EDITION: rust
// RULE: F18.3
// A negated literal where an unsigned integer goes is an error (rustc
// E0600), not the negation of the unsigned value.
// ERROR: error[type error]: cannot apply unary operator '-' to type 'usize'
fn main() {
    let v: Option<usize> = None;
    println("{}", v.unwrap_or(-1));
}
