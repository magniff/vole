// RULE: F18.6
// (0.30.2, the re-review of the obligations, y01/y02) `f(2)` of `f<T: Tr>(t:
// T) -> T::Out` is a variable d standing for `<{integer} as Tr>::Out`,
// settled when the integer's type is known (infer::settle_deps). Out =
// Option<i32> used as Option<i32>.
// EXPECT: 2000000000
trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = Option<u8>;

    fn o(self) -> Option<u8> {
        Some(self)
    }
}

impl Tr for i32 {
    type Out = Option<i32>;

    fn o(self) -> Option<i32> {
        Some(self * 1000000000)
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let v: Option<i32> = f(2);
    println("{}", v.unwrap());
}
