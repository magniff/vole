// XFAIL: RT-495: a fn item whose result is 'static from a reference input, `fn st(_x: &i64) -> &'static i64`, as a Map-like adapter's F (`MyMap { i: v.iter(), f: st }.next()`) is taken to keep v borrowed: `drop(v)` before the result's use is refused (borrowck.move_borrowed); vole's fn types carry no regions, so the output is read by elision from the input; rustc prints `Some(7)` (0.30.2)
// From the third re-review of the borrow-check work (g302bor2).
// Since the g302bor2 merge; v0.30.1 accepted it through a rule that also
// accepted real uses after free. A fn pointer: rt_495b; two reference
// inputs: rt_495c; a struct with 'static: rt_495d; a direct call: rt_495e.
// EXPECT: Some(7)
static SEVEN: i64 = 7;

fn st(_x: &i64) -> &'static i64 {
    &SEVEN
}

struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = MyMap { i: v.iter(), f: st }.next();
    drop(v);
    println("{:?}", r);
}
