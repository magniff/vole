// rustc prints the EXPECT lines (twin: r302d_025_call_through_two_references.rs.txt):
// a callee is autoderefed, and &F, &mut F are Fn/FnMut for F: Fn/FnMut. vole calls
// `r(1)` (one `&`) and passes `&&c` to `F: Fn`, but refuses `rr(2)` (line 11)
// and `gmm(4)` (line 19). The same refusal is reached inside a blanket
// `impl<F: Fn(i64) -> i64> Apply for F { fn apply_twice(&self, ..) { self(..) } }`
// when the method probe picks F = &closure (bl/u1.vl on the release build;
// g302probe picks F = closure); R302D-19 is the Box form. Since v0.28.0.
// EXPECT: 3 6 9 3
// EXPECT: 4
fn call<F: Fn(i64) -> i64>(f: F) -> i64 {
    f(1)
}

fn main() {
    let k = 3;
    let c = move |x: i64| x * k;
    let r = &c;
    let rr = &&c;
    let m = &mut &c;
    println("{} {} {} {}", r(1), rr(2), m(3), call(&&c));
    let mut n = 0;
    let mut g = |x: i64| {
        n += x;
        n
    };
    let gm = &mut g;
    let gmm = &mut &mut *gm;
    println("{}", gmm(4));
}
