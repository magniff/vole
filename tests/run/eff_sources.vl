// EDITION: rust
// XFAIL: gap 3: compile type error: no method 'try_alloc' on type 'let Bump'
// 0.16 T1: --verify-effects (the effects against the IR) on a program
// with a source of each effect, C's table and declarations, callbacks,
// allocators, closures and fn values; tests/query/effects016.q has the
// sets inferred for the same program.
// FLAGS: --verify-effects
// EXPECT: yg
// EXPECT: !!17
use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; use std::alloc::Arena; extern "C" {
    fn putchar(c: i32) -> i32;
    fn malloc(n: u64) -> *mut u8;
    fn free(p: *mut u8);
    fn labs(x: i64) -> i64;
    fn qsort(base: *mut u8, n: u64, size: u64, cmp: extern "C" fn(*mut u8, *mut u8) -> i32);
    #[link_name = "labs"]
    #[effects(io)]
    fn mystery(x: i64) -> i64;
    #[link_name = "llabs"]
    #[pure]
    fn ext_pure(x: i64) -> i64;
}

static mut COUNT: i64 = 0;
static LIMIT: i64 = 10;

#[derive(Clone, Copy, PartialEq, Eq)] enum Color { Red, Green }

fn add(a: i64, b: i64) -> i64 { a + b + LIMIT }
fn bump() { unsafe { COUNT += 1; } }
fn address() -> *mut i64 { unsafe { &raw mut COUNT } }
fn at(s: &[i64], i: i64) -> i64 { s[i as usize] }
fn part(s: &[i64]) -> &[i64] { &s[1..] }
fn whole(s: &[i64]) -> &[i64] { &s[..] }
fn color(x: i64) -> Color { x as Color }

fn sum(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for i in 0..s.len() { t += s[i]; }
    for &x in s { t += x; }
    let a = [1i64, 2, 3];
    for i in 0..3 { t += a[i as usize]; }
    for x in a { t += x; }
    t + a[2]
}

fn same(a: [i64; 3], b: [i64; 3], s: &str, r: &str) -> bool { a == b && s == r }

fn spin(n: i64) -> i64 {
    let mut k = n;
    while k > 0 { k -= 1; }
    k
}

fn forever() -> i64 { loop { return 1; } }
fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn even(n: i64) -> bool { if n == 0 { true } else { odd(n - 1) } }
fn odd(n: i64) -> bool { if n == 0 { false } else { even(n - 1) } }
fn deref(p: i64) -> i64 { unsafe { *(&mut p as *mut i64) } }
fn raw_index(q: *mut i64) -> i64 { unsafe { (*q.add(1)) } }
unsafe fn trusted() -> i64 { 1 }
fn calls_c() -> i64 { unsafe { labs(-3) + ext_pure(2) } }
fn declared() -> i64 { unsafe { mystery(1) } }
fn heap() { unsafe { free(malloc(8)); } }
fn out(c: u8) { unsafe { putchar(c as i32); } }
extern "C" fn by_c(a: *mut u8, b: *mut u8) -> i32 { bump(); 0 }

fn sorter() {
    let mut a = [3u8, 1u8];
    unsafe { qsort(&mut a[0], 2, 1, by_c); }
}

fn main(gpa: Gpa) -> i32 {
    let v = [1i64, 2, 3];
    let mut k = t0();
    let t = add(1, 2) + at(&v[..], 0) + sum(&v[..]) + part(&v[..]).len() as i64 + whole(&v[..]).len() as i64 + spin(3)
        + forever() + fact(3) + calls_c() + unsafe { trusted() } + deref(k) + raw_index(&mut k);
    if same(v, v, "ab", "ab") && even(4) {
        out(b'y');
    }
    bump();
    match color(1) {
        Color::Green => out(b'g'),
        Color::Red => out(b'r'),
    }
    heap();
    sorter();
    out(b'\n');
    let n = allocators(gpa);
    out(b'0' + (n / 10) as u8);
    out(b'0' + (n % 10) as u8);
    out(b'\n');
    if t > 0 && address() != 0 as *mut i64 { 0 } else { 1 }
}

fn t0() -> i64 { 5 }

#[derive(Clone, Copy)] struct Bump { base: *mut u8, used: i64, cap: i64 }

// UNSAFE: a test's bump allocator (0.26.3: Allocator is an unsafe trait).
// SAFETY: its memory is the buffer at base, cap bytes: a piece lies inside it.
unsafe impl Allocator for Bump {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
            if unsafe { self.used + size > self.cap } {
                return NonNull::new(0 as *mut u8).ok_or(AllocError);
            }
            let p = unsafe { (self.base as i64 + self.used) as *mut u8 };
            unsafe { self.used += size; }
            p
        }).ok_or(AllocError)
    }

    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr(); let old_size = __old.size() as i64;
        let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
            let q = self.try_alloc(new_size, align);
            if q != 0 as *mut u8 {
                for i in 0..(if old_size < new_size { old_size } else { new_size }) {
                    (*q.add(i as usize)) = (*p.add(i as usize));
                }
            }
            q
        }).ok_or(AllocError)
    } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> { unsafe { self.grow(p, old, new) } }

    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr(); let size = __layout.size() as i64;
        let align = __layout.align() as i64;
    }
}

fn fill<A: Allocator>(v: &mut Vec<i64, A>) { v.push(1); }

fn in_scope(a: &mut Arena<Gpa>) -> i64 { a.scope(|s| ({ let s = s; 1 })) }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn double(x: i64) -> i64 { x * 2 }
fn shout(x: i64) -> i64 { out(b'!'); x }
fn hof<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }

fn allocators(gpa: Gpa) -> i64 {
    let mut g: Vec<i64, Gpa> = Vec::new_in(gpa);
    fill(&mut g);
    let mut buf = [0u8; 4096];
    let b = Bump { base: &mut buf[0], used: 0, cap: 4096 };
    let mut w: Vec<i64, Bump> = Vec::new_in(b);
    fill(&mut w);
    let k: i64 = 2;
    hof(|x| x + k, 1i64) + hof(|x| shout(x), 2i64) + apply(double, 3) + apply(shout, 4) + g.len() as i64
        + w.len() as i64
}
