// EDITION: rust
// (0.27.0) Hand-translated from tests/run/closure_generic.vl to Rust's spelling.
// 0.14: closures and generics: a closure in a generic instance, the
// result type inferred from the closure (or a function passed for F),
// pointer parameters from the bound, a generic struct holding a closure.
// EXPECT: 30 4
// EXPECT: 1 8
// EXPECT: 9 3
// EXPECT: 42
fn sum_by<T, F: Fn(&T) -> i64>(s: &[T], f: F) -> i64 {
    let mut t = 0;
    for x in s {
        t += f(x);
    }
    t
}

fn scaled<T>(s: &[T], k: i64) -> i64 {
    sum_by(s, |x: &T| k * 2)
}

fn map_one<A, B, F: FnMut(A) -> B>(x: A, mut f: F) -> B {
    f(x)
}

fn pick<T, F: FnMut(&T, &T) -> bool>(a: T, b: T, mut better: F) -> T {
    if better(&a, &b) { a } else { b }
}

fn double(x: i64) -> i64 {
    x * 2
}

struct Op<F: Fn(i64) -> i64> {
    f: F,
    x: i64,
}

fn main() {
    let arr = [1, 2, 3];
    print("{}", scaled(&arr[0..3], 5));
    print(" ");
    println("{}", scaled(&[true, false][0..2], 1));
    let big = map_one(3, |x| x * 1000 == 3000);
    print("{}", if big { 1 } else { 0 });
    print(" ");
    println("{}", map_one(4, double));
    print("{}", pick(3, 9, |a, b| a > b));
    print(" ");
    println("{}", pick(3, 9, |a, b| a < b));
    let k = 40;
    let op = Op { f: |x| x + k, x: 2 };
    println("{}", (op.f)(op.x));
}
