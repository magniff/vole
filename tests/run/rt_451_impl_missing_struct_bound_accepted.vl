// XFAIL: RT-451: an impl whose parameter lacks its struct's bound (`struct H<S: B>`, `impl<S> H<S>`) is accepted; rustc E0277 at the impl's self type. std had eleven such impls (HashMap's and HashSet's `S` without BuildHasher) (0.30.2)
// From g302probe2. rustc: error[E0277] the trait bound `S: B` is not
// satisfied (line 13). v0.30.1 and the release build build it and print 3.
// ERROR: line 13
trait B {
    fn b(&self) -> i64;
}

struct H<S: B> {
    s: S,
}

impl<S> H<S> {
    fn new(s: S) -> H<S> {
        H { s: s }
    }
}

struct K {}

impl B for K {
    fn b(&self) -> i64 {
        3
    }
}

fn main() {
    let h = H::new(K {});
    println("{}", h.s.b());
}
