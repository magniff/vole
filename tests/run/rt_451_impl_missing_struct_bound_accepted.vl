// RT-451, fixed in 0.30.2 (obligations M2: an impl header's own parameter held to its struct's bounds, header_sure; std's impls state S: BuildHasher, 710a617ef).
// From g302probe2. rustc: error[E0277] the trait bound `S: B` is not
// satisfied (line 13). v0.30.1 and the release build build it and print 3.
// ERROR: line 13
trait B {
    fn b(&self) -> i64;
}

struct H<S: B> {
    s: S,
}

impl<S> H<S> {
    fn new(s: S) -> H<S> {
        H { s: s }
    }
}

struct K {}

impl B for K {
    fn b(&self) -> i64 {
        3
    }
}

fn main() {
    let h = H::new(K {});
    println("{}", h.s.b());
}
