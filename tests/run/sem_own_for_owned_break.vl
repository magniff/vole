// sem-own: a for loop over owned items that moves the item out on one
// iteration and breaks: the moved one dropped by its taker, the others in
// the loop.
// EXPECT: drop 0
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    for d in (0..3).map(|i| mk(i, gpa)) { if d.id == 1 { eat(d); break; } }
    println("end");
}
