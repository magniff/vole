// RULE: F8.3, F8.4
// RT-C301-8 review (R1, form f12_derived_const): `Self::K` in two traits' default constants `L`: each its own trait's K.
// rustc prints the EXPECT lines.
// EXPECT: 10 21
trait A { const K: i64; const L: i64 = Self::K * 2; }
trait B { const K: i64; const L: i64 = Self::K * 3; }
struct S;
impl A for S { const K: i64 = 5; }
impl B for S { const K: i64 = 7; }
fn main() { println("{} {}", <S as A>::L, <S as B>::L); }
