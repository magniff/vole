// RULE: D2.7
// (0.30.1, RT-33) A copy of a shared view, `let mut t = s`, is a shared
// view still: `&mut t[..]` is rustc's E0596 though t is `mut`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*t' as mutable, which is behind a `&` reference
// ERROR: line 9, column 18
// ERROR-COUNT: 1
fn k(s: &[i64]) {
    let mut t = s;
    let m = &mut t[..];
    m[0] = 1;
}

fn main() {
    let a = [2i64, 1];
    k(&a[..]);
}
