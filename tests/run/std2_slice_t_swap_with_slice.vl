// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::swap_with_slice.
// EXPECT: [4, 5] [1, 2]
use std::slice::SliceIndex;

fn main() {
    let mut a = [1, 2];
    let mut b = [4, 5];
    a.swap_with_slice(&mut b);
    println("{:?} {:?}", a, b);
}
