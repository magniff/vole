use std::alloc::AnyAlloc;

fn main(gpa: Gpa) {
    let a = AnyAlloc::new(&gpa);
    let v = Vec::from_in([1], a);
    let w = Vec::from_in([2], a);
    println("{}", v.len() + w.len());
}
