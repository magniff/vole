// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::cmp Reverse::impl Ord.
// EXPECT: Less [3, 2, 1]
use std::cmp::Reverse;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 3, 2], gpa);
    v.sort_by_key(|x| Reverse(*x));
    println("{:?} {:?}", Reverse(5).cmp(&Reverse(1)), v);
}
