// XFAIL: RT-170: an alias to a qualified projection, `type O = <S as A>::Out;` then `<O as B>::K`, is refused (false trait.unmet) (0.30.2)
// From the g302qual review (form f07c_nested_alias).
// EXPECT: 2 3 30 20
trait A { type Out; }
trait B { const K: i64; fn m(&self) -> i64; }
trait C { const K: i64; fn m(&self) -> i64; }
struct S; struct T;
impl A for S { type Out = T; }
impl B for T { const K: i64 = 2; fn m(&self) -> i64 { 20 } }
impl C for T { const K: i64 = 3; fn m(&self) -> i64 { 30 } }
type O = <S as A>::Out;

fn main() {
    let t = T; let f = <O as C>::m;
    println("{} {} {} {}", <O as B>::K, <O as C>::K, f(&t), <O as B>::m(&t));
}
