// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::strip_suffix.
// EXPECT: Some("bar") Some("ba") None
use std::str::CharIndices;

fn main() {
    println("{:?} {:?} {:?}", "bar:foo".strip_suffix(":foo"), "bar".strip_suffix('r'),
        "bar:foo".strip_suffix("bar"));
}
