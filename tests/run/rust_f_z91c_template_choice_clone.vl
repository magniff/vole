// EDITION: rust
// RULE: Z9.1c
// (0.27.6) Through a bounded parameter `a: A`, `a.clone()`,
// `Clone::clone(&a)` and `A::clone(&a)` are the bound's clone of the type
// A stands for: with A = &G each is a `&G`, whose name is the reference
// impl's (0.27.5 took G's clone through the reference: a type error).
// EXPECT: 33 3
trait Name {
    fn name(&self) -> i64;
}

#[derive(Clone)]
struct G;

impl Name for G {
    fn name(&self) -> i64 {
        1
    }
}

impl<T: ?Sized + Name> Name for &T {
    fn name(&self) -> i64 {
        (**self).name() + 10
    }
}

fn two<A: Name + Clone>(a: A) -> i64 {
    let b: A = a.clone();
    let c: A = Clone::clone(&a);
    let d: A = A::clone(&a);
    b.name() + c.name() + d.name()
}

fn main() {
    let g = G;
    println("{} {}", two(&g), two(G));
}
