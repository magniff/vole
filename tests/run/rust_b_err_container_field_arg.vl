// RULE: D2.7
// (0.30.1) A `&mut` stored in a Vec element is reborrowed through IndexMut,
// which needs the Vec mutable (rustc E0596: cannot borrow `vs` as
// mutable). Only a Box's deref needs no `mut` (rust_b_box_field_arg_ok;
// a Deref-only type's: rust_b_err_deref_only_field_arg).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'vs' as mutable, as it is not declared as mutable
// ERROR-COUNT: 1
struct W<'a> {
    s: &'a mut [i64],
}

fn fill(t: &mut [i64]) {
    t[0] = 9;
}

fn main(gpa: Gpa) {
    let mut arr = [1i64];
    let vs: Vec<W<'_>, Gpa> = {
        let mut x: Vec<W<'_>, Gpa> = Vec::new_in(gpa);
        x.push(W { s: &mut arr });
        x
    };
    fill(vs[0].s);
}
