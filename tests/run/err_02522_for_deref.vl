// 0.25.2.2 (eval 0.25.2.1: sph): `*x` on a `for` loop's variable: it is
// the element's value already.
// ERROR: cannot deref non-pointer type 'u32'
// ERROR: help: 'x' is a `for` loop's variable, the element's value already: write `x`, not `*x`
// ERROR: cannot deref non-pointer type 'i64'
// ERROR: help: 'v' is a `for` loop's variable
// ERROR-COUNT: 2
fn total(xs: [u32]) -> u32 {
    var s: u32 = 0;
    for x in xs {
        s += *x;
    }
    s
}

fn pairs(ps: [(i64, i64)]) -> i64 {
    var s = 0;
    for (k, v) in ps {
        s += k + *v;
    }
    s
}

