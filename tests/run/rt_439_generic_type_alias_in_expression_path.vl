// EXPECT: drop 1
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

type OV<T> = Option<T>;

fn main() {
    let d = D { n: 1 };
    let o = OV::Some(&d);
    println("{}", o.unwrap().n);
}
