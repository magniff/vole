// EDITION: rust
// RULE: D4.6
// (0.27.2.1) A bound's equality ties `I::Item` to `&'a str`, and no more:
// the item is not a `&'b str` (rustc: lifetime may not live long enough).
trait Src {
    type Item;
    fn take(&mut self) -> Option<Self::Item>;
}

struct One<'a> {
    s: Option<&'a str>,
}

impl<'a> Src for One<'a> {
    type Item = &'a str;

    fn take(&mut self) -> Option<&'a str> {
        self.s
    }
}

fn first<'a, 'b, I: Src<Item = &'a str>>(i: I, d: &'b str) -> &'b str {
    let mut i = i;
    match i.take() {
        Option::Some(x) => x,
        Option::None => d,
    }
}

fn main() {
    println("{}", first(One { s: Option::Some("x") }, "d"));
}
// ERROR: error[borrowck.outlives]
