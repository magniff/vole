// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Enumerate::impl Iterator.
// EXPECT: Some((0, 5)) (1, Some(1))

fn main(gpa: Gpa) {
    let s = Vec::from_in([5i64, 6], gpa);
    let mut it = s.iter().copied().enumerate();
    let a = it.next();
    println("{:?} {:?}", a, it.size_hint());
}
