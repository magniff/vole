// RULE: F24.1
// An item or a field without `pub` is visible only in its module and
// the module's descendants (rustc E0603, E0616).
// ERROR: error[field.private]: field 'side' of 'Sq' is private to module 'shapes'
mod shapes {
    pub struct Sq {
        side: i64,
    }

    pub fn make() -> Sq {
        Sq { side: 3 }
    }
}

fn main() -> i64 {
    let s = shapes::make();
    s.side
}
