// RULE: F8.3, F8.4
// RT-C301-8: `T::K`, `T::mk()`, `T::m(t)`, `let f = T::m;` with T: A are
// A's items though the instance's type S has inherent items of those
// names (rustc: a parameter's path sees only its bounds). 0.30.1 refused
// the values and gave the calls S's own. rustc prints this line.
// EXPECT: 111 111 101 99
trait A { const K: i64; fn mk() -> i64; fn m(&self) -> i64; }
struct S;
impl S { const K: i64 = 9; fn mk() -> i64 { 90 } fn m(&self) -> i64 { 900 } }
impl A for S { const K: i64 = 1; fn mk() -> i64 { 10 } fn m(&self) -> i64 { 100 } }
fn g<T: A>(t: &T) -> i64 { T::K + T::mk() + T::m(t) }
fn h<T: A>(t: &T) -> i64 { let f = T::m; let c = T::mk; f(t) + c() + <T as A>::K }
struct W<T> { t: T }
impl<T: A> W<T> { fn go(&self) -> i64 { T::K + T::m(&self.t) } }
fn main() { println("{} {} {} {}", g(&S), h(&S), W { t: S }.go(), S::K + S::mk()); }
