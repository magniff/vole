fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa); v.push(w); let mut it = v.iter().copied();
    let r = it.next().unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
