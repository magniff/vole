// `f(&v[0], v)`: an inout access of an element and a let access of the
// whole Vec overlap in one call (the law of exclusivity: f(&a.x, a)).
// It is accepted, and the let parameter changes under the callee (10).
// (For plain arrays and fields the let argument is a copy: see
// sem_core_noalias_inout_elem_and_let_arr.)
// ERROR: error[borrowck.conflict]
// ERROR: line 14, column 32
#[inline(never)]
fn f(a: &mut i64, v: &Vec<i64, Gpa>) -> i64 { *a = 10; v[0] }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", f(&mut v[0], &v));
    0
}
