// XFAIL: RT-1: an impl method's signature is not checked against its trait's lifetimes: a use after free in safe code (open)
// The same hole through std: the impl says `type Item = &'static str` and
// its `next` returns `Option<&'a str>`, a borrow of `s`. rustc rejects the
// impl (E0308: lifetime mismatch). vole accepted it; std's collect_in then
// keeps the items as `&'static str`, and the print reads `s` after its
// drop (--check-alloc: use after free, block allocated at line 27).
// ERROR: error[
// ERROR: line 21,
// ERROR-COUNT: 1
struct X<'a> {
    s: &'a str,
    done: bool,
}

impl<'a> Iterator for X<'a> {
    type Item = &'static str;

    // must be refused: Self::Item is &'static str
    fn next(&mut self) -> Option<&'a str> {
        if self.done {
            None
        } else {
            self.done = true;
            Some(self.s)
        }
    }
}

fn main(gpa: Gpa) {
    let v: Vec<&'static str, Gpa>;
    {
        let s = String::from_in("hello", gpa);
        let x = X { s: s.as_str(), done: false };
        v = x.collect_in(gpa);
    }
    println("{v:?}");
}
