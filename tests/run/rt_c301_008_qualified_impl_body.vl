// RULE: F8.4
// RT-C301-8: qualified paths in impl bodies, through `Self` and through
// the type's name. 0.30.1 printed `2222 20001`. rustc prints 1122 21122.
// EXPECT: 1122 21122
// qualified paths inside an impl body, through Self and through the type's name
trait A { const K: i64; fn m(&self) -> i64; }
trait B { const K: i64; fn m(&self) -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } }

impl B for S {
    const K: i64 = 2;

    fn m(&self) -> i64 {
        let f = <Self as A>::m;
        let g = <S as A>::m;
        20 + f(self) + g(self) + <Self as A>::K * 100 + <S as A>::K * 1000
    }
}

impl S {
    fn run(&self) -> i64 {
        let f = <Self as B>::m;
        f(self) + <Self as B>::K * 10000
    }
}

fn main() {
    let s = S;
    println("{} {}", <S as B>::m(&s), s.run());
}
