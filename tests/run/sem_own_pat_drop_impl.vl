// (0.25) A match by value taking parts out of an enum that implements Drop
// is own.partial: its drop needs all of it (Rust's E0509).
// ERROR: own.partial
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
enum E<A: Allocator> { A(D<A>), N }
impl Drop for E<Gpa> { fn drop(inout self) { println("drop e"); } }

fn main(gpa: Gpa) {
    let e = E::A(D { id: 1, v: Vec::new_in(gpa) });
    match e { E::A(d) => println("{}", d.id), E::N => {} }
}
