// RULE: D2.7
// (0.30.1, RT-33) `b.swap(1, 2)` of a `b: &[u8]`, the bytes of a str: a
// `&mut self` method of a slice called on a shared view, rustc's E0596.
// Before, the str was made invalid UTF-8.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*b' as mutable, which is behind a `&` reference
// ERROR: line 11, column 5
// ERROR-COUNT: 1
fn main() {
    let s: &str = "a\u{e9}";
    let b: &[u8] = s.as_bytes();
    b.swap(1, 2);
    for c in s.chars() {
        println("{}", c as u32);
    }
}
