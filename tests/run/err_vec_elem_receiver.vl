// (0.25) `&v[0]` lent inout next to v as the receiver of the same call,
// let or inout self: own.conflict (-O2 assumed them apart).
trait Peek {
    fn peek_with(&self, a: &mut i64) -> i64;
}

impl Peek for Vec<i64, Gpa> {
    fn peek_with(&self, a: &mut i64) -> i64 {
        let b = self[0];
        *a = 5;
        b * 100 + self[0]
    }
}

trait Grow {
    fn grow_with(&mut self, a: &mut i64);
}

impl Grow for Vec<i64, Gpa> {
    fn grow_with(&mut self, a: &mut i64) {
        self.push(*a);
        *a = 1;
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", v.peek_with(&mut v[0]));
    { let at_arg1 = &mut v[0]; v.grow_with(at_arg1) };
}
// ERROR: error[borrowck.conflict]
// ERROR: line 29, column 36
// ERROR: error[borrowck.mut_twice]
