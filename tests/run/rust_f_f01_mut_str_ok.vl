// RULE: F0.1
// `&mut str` keeps its mutability: a `&mut self` method of str runs on it
// (from a String's `as_mut_str`, through DerefMut on the String itself,
// from `&mut s` of a String), it coerces to `&str`, and it is lent, not
// moved, to a call and to a `&self` method (as rustc).
// EXPECT: ABC 65 3 3
fn shout(s: &mut str) {
    s.make_ascii_uppercase();
}

fn first(s: &str) -> u8 {
    s.as_bytes()[0]
}

fn take(s: &mut str) -> usize {
    s.make_ascii_lowercase();
    s.len()
}

fn main(gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str("abc");
    let t = take(&mut b);
    b.as_mut_str().make_ascii_uppercase();
    b.make_ascii_lowercase();
    let m: &mut str = b.as_mut_str();
    shout(m);
    let f = first(m);
    let n = m.len();
    let s: &str = m;
    println("{} {} {} {}", s, f, n, t);
}
