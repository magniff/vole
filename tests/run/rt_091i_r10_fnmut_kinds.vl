// (0.30.2, the re-review of g302holes: r91/r10_fnmut_kinds)
// EXPECT: 7
// EXPECT: 9
// Kinds: an outer closure returning an FnMut closure, and one returning an FnOnce one.
fn main() {
    let mk = |start: i64| {
        let mut n = start;
        move || { n += 1; n }
    };
    let mut c = mk(5);
    c();
    println("{}", c());
    let s = [1i64, 2];
    let mk2 = |m: i64| move || s.iter().map(move |x| x * m).sum::<i64>();
    let once = mk2(3);
    println("{}", once());
}
