// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::drain.
// EXPECT: [(1, 10), (2, 20)] 0
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(2, 20);
    m.insert(1, 10);
    let mut v: Vec<(i64, i64), Gpa> = m.drain().collect_in(gpa);
    v.sort();
    println("{:?} {}", v, m.len());
}
