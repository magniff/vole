// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::drain.
// EXPECT: [(1, 10), (2, 20)] 0
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(2, 20);
    m.insert(1, 10);
    let mut v: Vec<(i64, i64), Gpa> = m.drain().collect_in(gpa);
    v.sort();
    println("{:?} {}", v, m.len());
}
