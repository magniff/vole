// (0.25.2) A program that names nothing of std, with contracts: a clause
// is checked by std::contract_check, so `requires` and `ensures` load
// std's core as a std name does; the failure is reported as usual.
// EXIT: 101
// STDERR: contract_no_std.vl:27:12: requires failed: 'x > 0' of 'half' (
// STDERR: contract_no_std.vl:9:5): x = 0

fn half(x: i32) -> i32
    requires x > 0
    requires x % 2 == 0 else "an even number"
{
    x / 2
}

fn next(x: i32) -> i32 ensures result > x { x + 1 }

struct P { v: i32 }

impl P {
    fn get(self) -> i32 requires self.v != 0 { self.v }
}

fn main() -> i32 {
    if half(4) != 2 || next(1) != 2 || (P { v: 3 }).get() != 3 {
        return 1;
    }
    return half(0);
}
