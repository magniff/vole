// EDITION: rust
// an owned sink closure (it holds a Vec) called as FnMut through a let parameter: its own Vec grows
// through a let borrow of the caller's closure
// ERROR: [own.readonly]
// XFAIL: WRONG an FnMut called through a let parameter changes the caller's let closure (3 7)
fn run<F: FnMut() -> i64>(mut f: &F) -> i64 { f() + f() }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let c = move || { v.push(1); v.len() };
    let a = run(c);
    let b = run(c);
    println("{a} {b}");
}
