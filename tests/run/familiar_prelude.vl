// EDITION: rust
// XFAIL: gap 2: compile type error: undefined variable 'split_whitespace_in'
// 0.17: the prelude has the names programs reach for first, so none of
// these needs a `use`: Buf, HashMap, read_line, Scanner, parse_int, trim,
// split_in, split_whitespace_in, sort, sort_by, cmp_of, eq_of, Fmt.
// STDIN: 3 1 2
// STDIN: a,b,,c
// EXPECT: 1 2 3
// EXPECT: 4 parts, 3 words
// EXPECT: 42 -1 true
// EXPECT: [3, 2, 1] counted 2
// EXPECT: P(7)
use std::io; use std::fmt::Display; use std::fmt::Formatter as Fmt; use std::collections::HashMap;
#[derive(Clone, Copy)] struct P { x: i64 }

impl Display for P {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result { write(f, "P({})", self.x)?; Ok(()) }
}

fn main(gpa: Gpa) -> i32 {
    let mut line = String::new_in(gpa);
    io::stdin().read_line(&mut line).map(|n| n > 0).unwrap();
    let mut words = split_whitespace_in(line.as_str(), gpa);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for w in words.iter().copied() { v.push(w.parse::<i64>().unwrap()); }
    v.as_mut_slice().sort_unstable();
    println("{} {} {}", v[0usize], v[1usize], v[2usize]);
    io::stdin().read_line(&mut line).map(|n| n > 0).unwrap();
    let mut parts = split_in(line.as_str(), b',', gpa);
    let mut sc = Scanner::new("x y  z");
    let mut n: i64 = 0;
    while sc.next_token().is_some() { n += 1; }
    println("{} parts, {n} words", parts.len());
    let (one, two) = (1, 2);
    // (eq_of takes `*T`, an exclusive loan: not &two twice in one call)
    let two_again = two;
    println("{} {} {}", trim("  42 ").parse::<i64>().unwrap(), one.cmp(&two) as i64,
        two == two_again);
    v.as_mut_slice().sort_unstable_by(|a, b| ({ let a = a; let b = b; b - a }).cmp(&0));
    let mut m: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    m.insert("a", 1);
    m.insert("b", 2);
    println("{v:?} counted {}", m.len());
    println("{}", P { x: 7 });
    0
}
