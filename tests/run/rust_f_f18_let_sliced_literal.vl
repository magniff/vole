// EDITION: rust
// RULE: F18.4
// (0.27.6) `let s: &[T] = &[..][a..b];` hoists the array with the
// annotation's element type: its literals are T, not the i32 fallback.
// EXPECT: 2 2 4 3 5000000000
fn main() {
    let s: &[i64] = &[1, 2, 3][1..];
    let t: &[u8] = &[1, 2, 3][..2];
    let u = &[1u16, 2, 3][1..];
    let w: &[u64] = &[0, 5000000000][1..=1];
    println("{} {} {} {} {}", s.len(), s[0], t.len() + t[1] as usize, u[1], w[0]);
}
