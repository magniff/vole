// EDITION: rust
// A method called through a raw pointer outside unsafe.
// ERROR: calling a method through a raw pointer is unsafe
#[derive(Clone, Copy)] struct S { a: i64 }
impl S { fn get(self) -> i64 { self.a } }
fn main() -> i32 { let mut s = S { a: 1 }; let p = &mut s as *mut S; println("{}", p.get()); 0 }
