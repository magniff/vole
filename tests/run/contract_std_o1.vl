// (0.18) std's clauses: a failure in std names the caller's line, with
// std's message as before (Option::unwrap, Vec::get, Vec::insert, ...).
// FLAGS: -O1
// EXIT: 101
// EXPECT: 30
// STDERR: contract_std_o1.vl:21:13: called `Option::unwrap()` on a `None` value

fn find(v: &[i64], x: i64) -> Option<i64> {
    for i in 0..v.len() {
        if v[i] == x { return Some(i as i64); }
    }
    None
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(10);
    v.insert(0usize, 30i64);
    print("{}", v[(find(v.as_slice(), 30).unwrap()) as usize]);
    println("");
    let k = find(v.as_slice(), 99).unwrap();
    print("{}", k);
    0
}
