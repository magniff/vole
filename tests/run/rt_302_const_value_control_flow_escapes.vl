// rustc refuses each: E0572 (return outside of a fn body), E0268 (break
// outside of a loop) and the `?` form. v0.30.1 the same. This lets a
// constant's evaluation exit the using function half way through, e.g.
// while `[C; N]` is only partly built (the g302copy-148 re-review's double
// drops). From the g302copy-148 re-review (p04).
// ERROR: line 21
// ERROR: line 27
// ERROR: line 29
struct D {
    k: i64,
}

fn f() -> bool {
    true
}

fn mk() -> D {
    D { k: 5 }
}

const C: D = { if f() { return; } mk() };

fn g() -> Option<i64> {
    None
}

const Q: D = { let v = g()?; D { k: v } };

const B: D = { if f() { break; } mk() };

fn run() {
    let x = C;
    println("run {}", x.k);
}

fn run2() -> Option<i64> {
    let y = Q;
    Some(y.k)
}

fn main() {
    run();
    println("{}", run2().is_some());
    loop {
        let b = B;
        println("b {}", b.k);
        break;
    }
}
