fn pick<'a, 'b>(x: &'a i64, y: &'b i64) -> &'a i64 {
    if *x > 0 {
        return y;
    }
    x
}

fn main() {
    let a: i64 = 1;
    let b: i64 = 2;
    println("{}", *pick(&a, &b));
}
