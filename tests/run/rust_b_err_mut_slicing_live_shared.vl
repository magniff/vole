// RULE: D2.7, D7.4
// (0.30.1, RT-33 round 2, F1) `v[..2].reverse()` of a `v: &mut [i64]`
// while `r = &v[..]` is live: the receiver's slicing is an exclusive loan
// of v (front/check/rust.vl mut_slicing), rustc's E0502. Before, it was a
// shared slicing the call wrote through, and a thread reading r raced.
// ERROR: error[borrowck.conflict]: cannot borrow 'v' as mutable because it is also borrowed as immutable
// ERROR: line 12, column 5
// ERROR-COUNT: 1
fn k(v: &mut [i64]) {
    let r: &[i64] = &v[..];
    let before = r[0];
    v[..2].reverse();
    println("{} {}", before, r[0]);
}

fn main() {
    let mut a = [1i64, 2, 3];
    k(&mut a);
}
