// Runs on std since 0.27.2's switch.
// The std item(s): std::boxed Box::impl PartialOrd.
// EXPECT: Some(Less) true false
use std::boxed::Box;

fn main(gpa: Gpa) {
    let a = Box::new_in(1i64, gpa);
    let b = Box::new_in(2i64, gpa);
    println("{:?} {} {}", a.partial_cmp(&b), a < b, a >= b);
}
