// ERROR: the trait 'Into<i64>' is not implemented for 'T'
// `T: Into<U>` (U a parameter) does not prove `T: Into<i64>` (rustc E0277; v0.30.1 accepted it).
fn need<Z: Into<i64>>(z: Z) -> i64 { z.into() }
fn mid<T: Into<U>, U>(t: T, u: U) -> i64 { need(t) }
fn main() { println("{}", mid(5i32, 0i64)); }
