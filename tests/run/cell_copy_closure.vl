// (0.26.1) A closure that captures an atomic by access writes the
// caller's atomic, not a copy in its environment.
// EXPECT: 9
use std::sync::atomic::{AtomicI64, Ordering};

fn main() {
    let a = AtomicI64::new(1);
    let f = || a.store(9, Ordering::SeqCst);
    f();
    println("{}", a.load(Ordering::SeqCst));
}
