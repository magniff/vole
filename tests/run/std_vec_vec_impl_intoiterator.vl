// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::vec Vec::impl IntoIterator; std::vec &Vec::impl IntoIterator.
// EXPECT: 6
// EXPECT: 1
// EXPECT: 2
// EXPECT: 3
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2, 3], gpa);
    let mut t = 0;
    for x in &v {
        t += *x;
    }
    println("{}", t);
    for x in v {
        println("{}", x);
    }
}
