// XFAIL: RT-174: the parser refuses `<S as B>::K` as a match pattern (0.30.2)
// From the g302qual review (form f02_pattern_const).
// EXPECT: 10 20 0
trait A { const K: i64; }
trait B { const K: i64; }
struct S;
impl A for S { const K: i64 = 1; }
impl B for S { const K: i64 = 2; }
fn cls(x: i64) -> i64 { match x { <S as B>::K => 20, <S as A>::K => 10, _ => 0 } }
fn main() { println("{} {} {}", cls(1), cls(2), cls(3)); }
