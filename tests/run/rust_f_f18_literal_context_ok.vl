// EDITION: rust
// RULE: F18.3, F18.4, F0.3
// An unsuffixed literal typed by its context: `&[..]` under a `&[u8]`
// annotation is an array of u8 (F18.4); `1..3` where the bound
// `I: At<[i64]>` has impls for `Range<usize>` only is a `Range<usize>`
// (F18.3); an impl for `Range<usize>` does not cover `Range<i64>` (F0.3).
// EXPECT: 3 255
// EXPECT: 2
use std::ops::Range;

trait At<S: ?Sized> {
    fn width(&self, s: &S) -> usize;
}

impl<T> At<[T]> for Range<usize> {
    fn width(&self, s: &[T]) -> usize {
        (self.end - self.start).min(s.len())
    }
}

fn width<I: At<[i64]>>(i: I, s: &[i64]) -> usize {
    i.width(s)
}

fn main() {
    let b: &[u8] = &[1, 2, 255];
    println("{} {}", b.len(), b[2]);
    println("{}", width(1..3, &[5, 6, 7]));
}
