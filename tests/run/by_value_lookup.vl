// 0.18.1: Rust's `m.get(&k)`, `v.contains(&x)` with a number: the
// reference is read through (a `&i64` where an `i64` is expected), as are
// a pattern's bindings on a reference.
// EXPECT: 30 true 8
use std::collections::HashMap; #[derive(Clone, Copy)] enum E { A(i64), B }

fn twice(n: i64) -> i64 { n * 2 }

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(3, 30);
    let k: i64 = 3;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    let x: i64 = 4;
    let e = E::A(4i64);
    let d = match e { E::A(n) => twice(n), E::B => 0 };
    println("{} {} {d}", m.get(&k).copied().unwrap(), v.contains(&x));
}
