// EDITION: rust
// match &e binds inout; arms change the payload; the scrutinee is used after
// EXPECT: 11 5
#[derive(Clone, Copy)] enum E { A(i64), B(i64, i64) }
fn get(e: E) -> i64 { match e { E::A(n) => n, E::B(a, b) => a + b } }

fn main() {
    let mut e = E::A(1i64); let mut f = E::B(2i64, 2i64);
    match &mut e { E::A(n) => { *n += 10; } E::B(a, b) => { *a += 1; } } match &mut f {
        E::A(n) => { *n += 10; } E::B(a, b) => { *a += 1; }
    } println("{} {}", get(e), get(f));
}
