// XFAIL: RT-426o: (RT-426's family, the other side) `Self::Out` in `impl<T: Tr2 + Tr> Sub for T` with `trait Sub: Tr` is refused, "'W::Out' is ambiguous: traits 'Tr2' and 'Tr' both define it"; rustc takes the trait's supertrait Tr and prints 8 (0.30.2)
// From the re-review of g302oblig M2 (its form c13_generic_impl_self_out). Since v0.30.1 at
// least (v0.30.1 and the release build refuse it the same).
// EXPECT: 8
trait Tr2 {
    type Out;
}

trait Tr {
    type Out;
}

trait Sub: Tr {
    fn sz(&self) -> usize;
}

struct W;

impl Tr2 for W {
    type Out = u8;
}

impl Tr for W {
    type Out = i64;
}

impl<T: Tr2 + Tr> Sub for T {
    fn sz(&self) -> usize {
        std::mem::size_of::<Self::Out>()
    }
}

fn main() {
    println("{}", W.sz());
}
