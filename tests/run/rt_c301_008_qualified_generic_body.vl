// RULE: F8.4, D22.1, D22.1a
// RT-C301-8/9: qualified paths in a generic body, on the parameter (its
// Ω's bounds, then each instance's impls) and on a concrete type: values,
// constants and associated functions. 0.30.1 refused `<T as A>::m` as a
// value. rustc prints 121234 21.
// EXPECT: 121234 21
// qualified paths inside a generic body, on the parameter and on a concrete type
trait A { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
trait B { const K: i64; fn m(&self) -> i64; fn mk() -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } fn mk() -> i64 { 3 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } fn mk() -> i64 { 4 } }

fn go<T: A + B>(t: &T) -> i64 {
    let fa = <T as A>::m; let fb = <T as B>::m;
    let ga = <T as A>::mk; let gb = <T as B>::mk;
    fa(t) * 1000 + fb(t) * 100 + ga() * 10 + gb() + <T as A>::K * 100000 + <T as B>::K * 10000
}

fn conc<T>(_t: &T) -> i64 {
    let f = <S as B>::m;
    f(&S) * 10 + <S as A>::K
}

fn main() {
    println("{} {}", go(&S), conc(&0));
}
