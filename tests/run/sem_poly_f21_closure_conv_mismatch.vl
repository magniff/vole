fn fold_in<F: FnMut(&mut i64, i64)>(f: F, n: i64) -> i64 {
    let mut acc: i64 = 0; for i in 0..n { f(&acc, i); } acc
}

fn main() { println("{}", fold_in(|a: i64, x: i64| { print("{}", a); }, 3)); }
