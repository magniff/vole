// F: FnMut(inout i64, i64) given a closure whose first param is let: rejected
// ERROR: the closure does not satisfy the bound 'F: FnMut(inout i64, i64)': its parameter 'a' is 'i64', the bound gives 'inout i64'
// ERROR: fix --suggested
fn fold_in<F: FnMut(inout i64, i64)>(f: sink F, n: i64) -> i64 {
    var acc = 0; for i in 0..n { f(&acc, i); } acc
}

fn main() { println(f"{fold_in(|a: i64, x: i64| { print(a); }, 3)}"); }
