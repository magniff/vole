// EDITION: rust
// RULE: D19.6
// (0.27.2) A closure inferred `FnOnce` where an `FnMut` bound is asked:
// closure.kind (rustc E0525).
// ERROR: error[closure.kind]
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn call<F: FnMut() -> i64>(mut f: F) -> i64 {
    f()
}

fn main() {
    let s = S { n: 4 };
    let f = move || eat(s);
    println("{}", call(f));
}
