// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl Write.
// EXPECT: x=1 y
use std::fmt::Write;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let _ = s.write_str("x=1");
    let _ = s.write_char(' ');
    let _ = s.write_fmt(format_args("y"));
    println("{}", s);
}
