// RULE: D19.10
// (0.30) Map's Item is `B` of `impl<B, I: Iterator, F: FnMut(I::Item) ->
// B>`, given by the bound's result only: map's closure returns the item,
// fold's closure returns it as the result, which then borrows x (rustc
// E0506). It was accepted: B had no universal in the instance.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 15, column 5
// ERROR-COUNT: 1
fn main() {
    let mut x = 1i64;
    let px = &x;
    let a = [px];
    let z = 0i64;
    let out = a.iter().map(|p| *p).fold(&z, |acc, p| p);
    x = 2;
    println("{}", *out);
}
