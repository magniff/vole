// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops BitOr.
// EXPECT: V { x: 13 }
use std::ops::BitOr;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitOr for V {
    type Output = V;

    fn bitor(self, rhs: V) -> V {
        V { x: self.x | rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?}", a | b);
}
