// Over-refusal probe: a generic holder; the clause only iterates an Option param with a closure.
fn f<T: Copy>(t: T, o: Option<i64>) -> T
    requires o.iter().all(|x: &i64| *x > 0)
{
    t
}

fn main() {
    println("{}", f(7u8, Some(1)));
}
