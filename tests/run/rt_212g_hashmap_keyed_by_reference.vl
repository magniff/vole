// XFAIL: RT-212: (fuller form of R302D-34) a HashMap or HashSet whose key is a reference to a sized type cannot insert: `HashMap<&i64, i64, ..>::insert` and `HashSet<&W, ..>::insert` fail inside std (0.30.2)
// rustc prints the EXPECT line (twin: r302d_034g_hashmap_reference_keys_insert_fails_in_std.rs.txt).
// vole: `<std>:15594:34: error[type error] expected '&&i64', got '&i64' | note: in
// instantiation of 'HashMap<&i64, i64, Gpa, FixedState>::find<&i64>' .. | try:
// &self.table.slot(i).0.borrow()` and the same with `&&W` for the HashSet: std's
// find calls `.borrow()` on a tuple field place of type K = &i64, resolved per
// instance to i64's Borrow (R302D-34). `HashMap<&str, usize>` works. Since
// v0.28.0 (v0.30.1 the same).
// EXPECT: Some(1) Some(1) true
use std::collections::{HashMap, HashSet};

#[derive(PartialEq, Eq, Hash, Debug)]
struct W {
    k: i64,
}

fn main(gpa: Gpa) {
    let k = 3i64;
    let w = W { k: 1 };
    let mut a: HashMap<&str, usize, Gpa, FixedState> = HashMap::new_in(gpa);
    *a.entry("x").or_insert(0) += 1;
    let mut b: HashMap<&i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    b.insert(&k, 1);
    let mut c: HashSet<&W, Gpa, FixedState> = HashSet::new_in(gpa);
    c.insert(&w);
    println("{:?} {:?} {}", a.get("x"), b.get(&&k), c.contains(&&w));
}
