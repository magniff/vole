// XFAIL: RT-114: a block with `let` as a static's or const's value gives "undefined variable": check_const_expr has no locals (0.30.2)
// From c302const (pre-existing, r5_y06/y15). rustc prints the EXPECT line.
// EXPECT: 2 3
static S: u8 = {
    let v = [1u8, 2];
    v[1]
};

const C: u8 = {
    let v: u8 = 2;
    v + 1
};

fn main() {
    println("{} {}", S, C);
}
