// sem-own: an owned temporary as a method receiver (let self): dropped after the statement.
// EXPECT: drop 1
// EXPECT: len 1
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
impl D<Gpa> { fn len(self) -> i64 { self.v.len() as i64 } }

fn main(gpa: Gpa) {
    let n = mk(1, gpa).len();
    println("len {n}");
    println("end");
}
