// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::slice [T]::chunks_mut.
// EXPECT: [0, 0, 1, 1, 2]

fn main() {
    let mut a = [9, 9, 9, 9, 9];
    let mut k = 0;
    for c in a.chunks_mut(2) {
        for x in c.iter_mut() {
            *x = k;
        }
        k += 1;
    }
    println("{:?}", a);
}
