// v[grow(&v)] = 5: the index is evaluated first (documented order), so its inout ends before the place
// EXPECT: 5
fn grow(v: &mut Vec<i64, Gpa>) -> i64 { v.push(0); 0 }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    { let at_ix = grow(&mut v) as usize; v[at_ix] = 5 }; println("{}", v[0]);
}
