// XFAIL: RT-118: a string literal as a match pattern on a &str is a parse error: "expected a pattern, got 'string literal'" (0.30.2)
// From c302const (pre-existing, r5_mt10). rustc prints the EXPECT line.
// EXPECT: 3 1 7
fn f(x: &str) -> u8 {
    match x {
        "a" => 1,
        "b" => 7,
        _ => 3,
    }
}

fn main() {
    println("{} {} {}", f("z"), f("a"), f("b"));
}
