// XFAIL: RT-69: a trait method with `self: Box<Self>` at an earlier autoderef step loses to an inherent `&self` method (RT-69's family): form b09 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 3
// EXPECT: 6
trait TA { fn m(self: Box<Self, Gpa>) -> i64; }
struct S { k: i64 }
impl S { fn m(&self) -> i64 { 3 } }
impl TA for S { fn m(self: Box<Self, Gpa>) -> i64 { self.k + 1 } }
fn main(gpa: Gpa) { let b = Box::new_in(S { k: 5 }, gpa); println("{}", b.m()); }
