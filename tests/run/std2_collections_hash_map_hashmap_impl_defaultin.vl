// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::impl DefaultIn.
// EXPECT: 0
use std::collections::HashMap;
use std::default::DefaultIn;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let m: HashMap<i64, i64, Gpa, FixedState> = DefaultIn::default_in(gpa);
    println("{}", m.len());
}
