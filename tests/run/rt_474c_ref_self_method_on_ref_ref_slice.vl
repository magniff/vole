// XFAIL: RT-474c: (RT-474's mechanism, a slice) `(&s).g(5)` with `s: &[i64]`, `impl G<i64> for [i64]` (2) and `impl G<i64> for &[i64]` (1) runs [i64]'s: vole prints `2 2`, rustc `2 1` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p11b_slice_view_generic_trait_ok.
// EXPECT: 2 1
trait G<X> {
    fn g(&self, x: X) -> i64;
}

impl<'a> G<i64> for &'a [i64] {
    fn g(&self, x: i64) -> i64 {
        1 + x * 0
    }
}

impl G<i64> for [i64] {
    fn g(&self, x: i64) -> i64 {
        2 + x * 0
    }
}

fn main() -> i32 {
    let a = [1i64, 2];
    let s: &[i64] = &a;
    println("{} {}", s.g(5), (&s).g(5));
    0
}
