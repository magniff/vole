// RULE: L14
// (0.27.3) A substitution's impl bounds are read where it is used: in
// `total<I = Copied<Chain<Iter<'x, i64>, Iter<'y, i64>>>>`, 'x and 'y are
// one region by Chain's `B: Iterator<Item = A::Item>`, through Rev's and
// Copied's impls too; in `total<I = Map<Iter<'x, i64>, C>>` C's signature
// is tied to Iter's Item by Map's `F: FnMut(I::Item) -> B` (and
// Inspect's `F: FnMut(&I::Item)`). rustc checks the generic bodies, where
// no such pair exists; before, the instance's call of Chain's (Map's)
// `next` was borrowck.outlives.
// EXPECT: 6
// EXPECT: 6
// EXPECT: 12
// EXPECT: 6
fn total<I: Iterator<Item = i64>>(it: I) -> i64 {
    let mut t = 0;
    for x in it {
        t += x;
    }
    t
}

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64], gpa);
    let b = Vec::from_in([2i64, 3], gpa);
    println("{}", total(a.iter().chain(b.iter()).copied()));
    println("{}", total(a.iter().chain(b.iter()).rev().copied()));
    println("{}", total(a.iter().chain(b.iter()).map(|x| x * 2)));
    println("{}", total(b.iter().inspect(|_| {}).copied().chain(a.iter().copied())));
}
