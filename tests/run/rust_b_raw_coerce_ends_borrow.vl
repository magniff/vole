// EDITION: rust
// RULE: D3.6
// (0.27.6) A `&mut` given where a raw pointer goes ends its reborrow
// there: the later `&mut cx.cap` and the read of `cx.f` are no conflict
// (rustc accepts and prints 3; 0.27.5 held the reborrow through the call,
// gate 3's class S: middle/loops.vl's block_array).
// EXPECT: 3
struct C {
    f: *mut i64,
    cap: i64,
    n: i64,
}

fn block_array(cx: *mut C, arr: *mut i64, cap: &mut i64, fi: i64) -> *mut i64 {
    // UNSAFE: the test's raw pointer, as middle/loops.vl's block_array takes it
    // SAFETY: cx points to the live C main made; nothing else uses it here
    unsafe {
        *cap += (*cx).n + fi;
    }
    arr
}

fn go(cx: &mut C) {
    cx.f = block_array(cx, cx.f, &mut cx.cap, 1);
}

fn main() {
    let mut c = C { f: std::ptr::null_mut(), cap: 0, n: 2 };
    go(&mut c);
    println("{}", c.cap);
}
