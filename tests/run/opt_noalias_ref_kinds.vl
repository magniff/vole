// (0.30.2, RT-46) A parameter's alias facts come from its reference kind
// (front/types.vl ref_aliasing): `&[T]`, `&T` and `&mut [T]` keep them
// (a load before a call that does not get the parameter is reused after
// it: no load between the call and the return), a raw slice `*const [T]`
// has none (its load after the call is a new one). The program itself
// writes no parameter's memory in the call (`set` writes a static), so
// every level prints the same.
// CHECK: fn shared:
// CHECK: call set
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn shared_ref:
// CHECK: call set
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn exclusive:
// CHECK: call set
// CHECK-NOT: load
// CHECK: ret
// CHECK: fn raw:
// CHECK: call set
// CHECK-NOT: ret
// CHECK: load
// CHECK: ret
// CHECK: fn main:
// EXPECT: 4 4 4 6 4
static mut COUNT: i64 = 0;

#[inline(never)]
fn set() {
    // UNSAFE: COUNT is a static mut
    // SAFETY: one thread
    unsafe {
        COUNT += 1;
    }
}

#[inline(never)]
fn shared(x: &[i64]) -> i64 {
    let a = x[0];
    set();
    a + x[0]
}

#[inline(never)]
fn shared_ref(x: &i64) -> i64 {
    let a = *x;
    set();
    a + *x
}

#[inline(never)]
fn exclusive(x: &mut [i64]) -> i64 {
    let a = x[0];
    set();
    a + x[0]
}

#[inline(never)]
fn raw(x: *const [i64]) -> i64 {
    // UNSAFE: a raw slice given by the caller
    // SAFETY: it points to main's array, live across the call
    unsafe {
        let a = (*x)[0];
        set();
        a + (*x)[0] + 2
    }
}

fn main() -> i32 {
    let mut v = [2i64, 3];
    let s = shared(&v);
    let r = shared_ref(&v[0]);
    let e = exclusive(&mut v);
    let w = raw(&v[..] as *const [i64]);
    // UNSAFE: COUNT is a static mut
    // SAFETY: one thread
    let c = unsafe { COUNT };
    println("{} {} {} {} {}", s, r, e, w, c);
    0
}
