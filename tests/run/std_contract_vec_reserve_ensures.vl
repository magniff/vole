// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): Vec::reserve's `ensures self.capacity() >= self.len() + extra`, exercised.
// EXPECT: true
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::from_in([1], gpa);
    v.reserve(9);
    println("{}", v.capacity() >= 10);
}
