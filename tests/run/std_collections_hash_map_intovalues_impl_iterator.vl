// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map IntoValues::impl Iterator.
// EXPECT: Some(1) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(3, 1);
    let mut it = m.into_values();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
