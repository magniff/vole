// EXPECT: 2
// (RT-271) `U = <Self as H>::Out` for a generic impl, `impl<T> Sub for Y<T>` (v0.30.1: unknown type 'Self').
trait H {
    type Out;
}

trait Tr<U> {
    fn g(&self) -> i64;
}

struct Y<T> {
    t: T,
}

impl<T> H for Y<T> {
    type Out = i64;
}

impl<T> Tr<i64> for Y<T> {
    fn g(&self) -> i64 {
        2
    }
}

trait Sub<U = <Self as H>::Out>: H + Tr<U> {}

impl<T> Sub for Y<T> {}

fn c2<Z: Sub>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", c2(&Y { t: 1u8 }));
}
