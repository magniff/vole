// RULE: F29.4
// (0.30.1) `as` makes a reference only of a reference to the same type:
// a reference to another type is a transmute, a raw pointer cast to a
// reference one of any address, a `&T` cast to a `&mut T` an alias, and
// a `&mut str` cast to `&mut [u8]` would write bytes that are not UTF-8
// (rustc E0605 for each).
// ERROR: error[type.ref_cast]: cannot cast '&i64' to the reference '&u64'
// ERROR: line 25, column 13
// ERROR: error[type.ref_cast]: cannot cast '*const i64' to the reference '&i64'
// ERROR: line 27, column 13
// ERROR: help: a raw pointer becomes a reference by `&*p`
// ERROR: error[type.ref_cast]: cannot cast '&i64' to the reference '&mut i64'
// ERROR: line 28, column 13
// ERROR: help: a shared reference does not become an exclusive one
// ERROR: line 30, column 13
// ERROR: help: a str is UTF-8
// ERROR: error[type.ref_cast]: cannot cast '&mut String<Gpa>' to the reference '&mut Vec<u8, Gpa>'
// ERROR: line 31, column 13
// ERROR: error[type.ref_cast]: cannot cast '&mut [i64; 2]' to the reference '&mut [i64; 3]'
// ERROR: line 33, column 13
// ERROR-COUNT: 6
fn main(gpa: Gpa) {
    let x: i64 = 5;
    let p = &x as *const i64;
    let a = &x as &u64;
    println("{}", a);
    let b = p as &i64;
    let c = &x as &mut i64;
    let mut s = String::from_in("abc", gpa);
    let d = s.as_mut_str() as &mut [u8];
    let e = &mut s as &mut Vec<u8, Gpa>;
    let mut w: [i64; 2] = [1, 2];
    let f = &mut w as &mut [i64; 3];
    println("{} {} {} {} {}", b, c, d.len(), e.len(), f.len());
}
