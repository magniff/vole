// RULE: D2.7
// (0.30.1, RT-33) `s.reverse()` of an `s: &[i64]`, and of its slicing
// `s[1..]`: rustc's E0596 at each.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 10, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 11, column 5
// ERROR-COUNT: 2
fn k(s: &[i64]) {
    s.reverse();
    s[1..].reverse();
}

fn main() {
    let a = [3i64, 2, 1];
    k(&a[..]);
    println("{} {}", a[0], a[1]);
}
