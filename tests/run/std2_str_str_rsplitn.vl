// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str str::rsplitn.
// EXPECT: ["lamb", "little", "Mary had a"] 0
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "Mary had a little lamb".rsplitn(3, ' ').collect_in(gpa);
    let mut n = 0;
    for _ in "abc".rsplitn(0, 'b') {
        n += 1;
    }
    println("{:?} {}", v, n);
}
