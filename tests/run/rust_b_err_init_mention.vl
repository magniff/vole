// RULE: M1, M8
// (0.30.1) `x;` reads x (rustc E0381 of one never assigned), through
// a deref or a field too; `let _ = a[i];` reads the base of its index; the
// message names the binding (`x`, not `*x`); a value that may be unassigned
// since its `let` is E0381 although a loop's body moves it (rustc's
// back-edge rule), not "used after it moved".
// ERROR: error[borrowck.use_uninit]
// ERROR: line 47, column 5
// ERROR: error[borrowck.use_uninit]: used binding 'p' is possibly-uninitialized (rustc E0381)
// ERROR: line 52, column 5
// ERROR: error[borrowck.use_uninit]
// ERROR: line 57, column 5
// ERROR: error[borrowck.use_uninit]
// ERROR: line 63, column 13
// ERROR: error[borrowck.use_uninit]
// ERROR: line 68, column 13
// ERROR: error[borrowck.use_uninit]: used binding 'x' is possibly-uninitialized (rustc E0381)
// ERROR: line 73, column 19
// ERROR: error[borrowck.use_uninit]
// ERROR: line 84, column 24
// ERROR-COUNT: 7
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct P {
    a: i64,
    b: &'static i64,
}

fn take(d: D) {
    println("took {}", d.v);
}

fn peek(d: &D) -> i64 {
    d.v
}

fn stmt() {
    let p: &'static i64;
    p;
}

fn stmt_deref() {
    let p: &'static &'static i64;
    **p;
}

fn stmt_field() {
    let p: P;
    p.a;
}

fn wild_index() {
    let a: [&'static i64; 2];
    let i = 1;
    let _ = *a[i];
}

fn wild_const_index() {
    let a: [i64; 2];
    let _ = a[1];
}

fn read_deref() {
    let x: &i64;
    println("{}", *x);
}

fn loop_moved(n: i64) {
    let mut d: D;
    let mut i = 0;
    while i < n {
        d = D { v: i };
        take(d);
        i += 1;
    }
    println("{}", peek(&d));
}

fn main() {
    stmt();
    stmt_deref();
    stmt_field();
    wild_index();
    wild_const_index();
    read_deref();
    loop_moved(3);
}
