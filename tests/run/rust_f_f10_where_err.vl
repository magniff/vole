// RULE: F10.2
// A method's `where Self: Double` does not hold for U: the call is an
// error naming the bound.
// ERROR: error[trait.unmet]: the bound 'Self: Double' of 'twice' is not met: 'U' does not implement it
trait Double {
    fn double(&self) -> i64;
}

trait Twice {
    fn twice(&self) -> i64
        where
            Self: Double,
    {
        self.double() * 2
    }
}

struct U {
    n: i64,
}

impl Twice for U {}

fn main() -> i64 {
    let u = U { n: 7 };
    u.twice()
}
