// RULE: M2, M8
// (0.30.1) a nested field assigned, `o.q.r = 1`: rustc names the outermost
// base not assigned, `o`.
// ERROR: error[borrowck.assign_moved_part]
// ERROR: line 45, column 5
// ERROR: error[borrowck.assign_moved_part]
// ERROR: line 51, column 5
// ERROR-COUNT: 2
struct P {
    a: i64,
    b: &'static i64,
}

impl P {
    fn get(&self) -> i64 {
        self.a + *self.b
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

struct Q {
    r: i64,
    s: i64,
}

struct O {
    q: Q,
    z: i64,
}

union U {
    x: i64,
    y: u32,
}

static THREE: i64 = 3;

fn nested() {
    let mut o: O;
    o.q.r = 1;
    println("{}", o.q.s);
}

fn nested_mid() {
    let mut o: O;
    o.z = 1;
    o.q.r = 2;
    println("{}", o.q.s);
}

fn main() {
    nested();
    nested_mid();
}
