// RULE: D19.1, D19.10
// (0.30.2, RT-44) A `filter` closure in a generic Drop impl reached
// through an Option a generic function returns (0.30.1: the compiler
// panicked).
// EXPECT: ok true
// EXPECT: drop 2
struct W<T> {
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let v = [1i64, 2, 3];
        let n = v.iter().filter(|x: &&i64| **x > 1).count();
        println("drop {}", n);
    }
}

fn make<T>(t: T) -> Option<W<T>> {
    Some(W { t: t })
}

fn main() {
    let o = make(1u8);
    println("ok {}", o.is_some());
}
