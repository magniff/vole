// XFAIL: RT-395: WRONG CODE: a projection under a bound written without arguments, `T::Out` with `T: Tr` and `trait Tr<U = i32>`, does not apply the default: it takes the first-declared impl, Tr<i64>, and the program prints 6400000000; rustc takes Tr<i32> and prints 32 (0.30.2)
// From the review of g302oblig-m2 (form f270o2). Since v0.30.1 at least;
// the release build the same, at -O0 and -O2. The bound `T: Tr` is
// `T: Tr<i32>`: its Out is i32 and its mk is Tr<i32>'s. With the impls in
// the other order (Tr<i32> first, f270o) the output is right, so the
// choice follows declaration order. Sub-forms: rt_395b (the projection
// passed on to a bound with `Out = i32`, refused), rt_395c, rt_395d,
// rt_395e (a method through such a bound reported ambiguous).
// EXPECT: 32
trait Tr<U = i32> {
    type Out;
    fn mk(&self) -> Self::Out;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    type Out = i64;

    fn mk(&self) -> i64 {
        6400000000
    }
}

impl Tr<i32> for W {
    type Out = i32;

    fn mk(&self) -> i32 {
        32
    }
}

fn f<T: Tr>(t: &T) -> T::Out {
    t.mk()
}

fn main() {
    let x = f(&W { r: 0 });
    println("{}", x);
}
