// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::map_or_else.
// EXPECT: 4 -1
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b: Option<i64> = None;
    println("{} {}", a.map_or_else(|| -1, |x| x + 1), b.map_or_else(|| -1, |x| x + 1));
}
