// RULE: D19.5
// (0.28.0) Calling an FnMut closure borrows it `&mut`: its binding, a
// `let` or a parameter, must be `mut` (rustc E0596).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'f' as mutable, as it is not declared as mutable
// ERROR: line 10, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'g' as mutable, as it is not declared as mutable
// ERROR: line 23, column 19
// ERROR-COUNT: 2
fn call<F: FnMut() -> i64>(f: F) -> i64 {
    f()
}

fn call_mut<F: FnMut() -> i64>(mut f: F) -> i64 {
    f()
}

fn main() {
    let mut n = 0i64;
    let g = || {
        n += 1;
        n
    };
    println("{}", g());
    let mut k = 0i64;
    let mut m = 0i64;
    println("{}", call(|| {
        k += 1;
        k
    }));
    println("{}", call_mut(|| {
        m += 1;
        m
    }));
}
