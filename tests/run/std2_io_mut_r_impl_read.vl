// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io &mut R::impl Read.
// EXPECT: [1, 2]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn take2<R: Read>(mut r: R) -> [u8; 2] {
    let mut b = [0u8; 2];
    r.read_exact(&mut b).unwrap();
    b
}

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    println("{:?}", take2(&mut r));
}
