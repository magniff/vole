// EXIT: 101
// EXPECT: 3
// STDERR: index out of bounds: index 5, length 3
// STDERR: canary_bounds_slice.vl:9:5
// 0.30.1, a canary of the bounds check on a slice index, at every level
// (an index the optimizer cannot see through: a function's parameter).
#[inline(never)]
fn at(s: &[i64], i: usize) -> i64 {
    s[i]
}

fn main() {
    let a: [i64; 3] = [1, 2, 3];
    let n = at(&a[..], 2);
    println("{n}");
    println("{}", at(&a[..], 5));
}
