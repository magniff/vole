// XFAIL: RT-482b: (RT-482, through `*&p`) `kl(*q, gpa)` with `let p = st; let q = &p;` is refused in kl's body (borrowck.return_local); rustc prints 5 (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// EXPECT: 5
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn kl<K, F: Fn(&i64) -> K>(f: F, gpa: Gpa) -> K {
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn main(gpa: Gpa) {
    let p = st;
    let q = &p;
    let r = kl(*q, gpa);
    println("{}", r);
}
