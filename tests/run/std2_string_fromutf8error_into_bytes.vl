// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string FromUtf8Error::into_bytes.
// EXPECT: [97, 255]
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let r = String::from_utf8(Vec::from_in([97u8, 255], gpa));
    if let Err(e) = r {
        let v: Vec<u8, Gpa> = e.into_bytes();
        println("{:?}", v);
    }
}
