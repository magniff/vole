use std::cell::Cell;

struct Tagged<T> {
    t: T,
    raw: *const u8,
}

// SAFETY: `raw` is a tag, never dereferenced.
unsafe impl<T: Send> Send for Tagged<T> {}

fn send<T: Send>(t: T) -> T {
    t
}

fn main() {
    let c = Cell::new(1);
    let _ = send(Tagged { t: &c, raw: 0 as *const u8 });
}
