// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::shrink_to_fit.
// EXPECT: true
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::with_capacity_in(100, gpa);
    s.push_str("ab");
    s.shrink_to_fit();
    println("{}", s.capacity() < 100);
}
