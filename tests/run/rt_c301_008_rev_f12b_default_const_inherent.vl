// RULE: F8.3, F8.4
// RT-C301-8 review (R1, form f12b_default_const_inherent): `Self::K` in a default constant beside an inherent `S::K`: the trait's (0.30.2's first round printed 200).
// rustc prints the EXPECT lines.
// EXPECT: 10
trait A { const K: i64; const L: i64 = Self::K * 2; }
struct S;
impl S { const K: i64 = 100; }
impl A for S { const K: i64 = 5; }
fn main() { println("{}", <S as A>::L); }
