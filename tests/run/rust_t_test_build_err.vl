// FLAGS: --test-build
// ARGS: --vole-test parses
// EXIT: 101
// EXPECT: before
// STDERR: test returned Err(
#[test]
fn parses() -> Result<(), std::str::ParseIntError> {
    println("before");
    let n = "x2".parse::<i64>()?;
    assert(n == 12);
    Ok(())
}

fn main() {
    println("not run");
}
