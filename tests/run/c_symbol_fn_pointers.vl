// CSOURCE: tests/c/c_symbol_identity.c
// EXPECT: allocs 1 frees 1 sqrt 42 4
// 0.30.1: a function pointer to an extern is the symbol it links to. Taken
// from `#[link_name = "csi_alloc"] fn malloc` it is the program's
// allocator (counted), from `#[link_name = "malloc"] fn grab` C's; the
// same for free and sqrt. At -O2 0.30.0 printed `allocs 0 frees 0` (the
// review of 0.30.1): once the calls through `m` and `f` were direct calls,
// they were taken for C's malloc and free by their vole names, and the
// block was put on the stack (middle::ipo's heap to stack).
mod c {
    pub extern "C" {
        #[link_name = "csi_alloc"]
        fn malloc(n: usize) -> *mut u8;
        #[link_name = "free"]
        fn release(p: *mut u8);
        fn csi_allocs() -> i64;
        fn csi_frees() -> i64;
        #[link_name = "csi_sqrt"]
        fn sqrt(x: f64) -> f64;
    }
}

extern "C" {
    #[link_name = "malloc"]
    fn grab(n: usize) -> *mut u8;
    #[link_name = "csi_free"]
    fn free(p: *mut u8);
    #[link_name = "sqrt"]
    fn root(x: f64) -> f64;
}

fn main() {
    let m: unsafe extern "C" fn(usize) -> *mut u8 = c::malloc;
    let g: unsafe extern "C" fn(usize) -> *mut u8 = grab;
    let r: unsafe extern "C" fn(*mut u8) = c::release;
    let f: unsafe extern "C" fn(*mut u8) = free;
    let s1: unsafe extern "C" fn(f64) -> f64 = c::sqrt;
    let s2: unsafe extern "C" fn(f64) -> f64 = root;
    // UNSAFE: C's functions through pointers.
    // SAFETY: each block freed once, by its allocator's free.
    unsafe {
        let p = m(16);
        let q = g(16);
        *p = 1;
        *q = 2;
        f(p);
        r(q);
        println("allocs {} frees {} sqrt {} {}", c::csi_allocs(), c::csi_frees(), s1(16.0),
            s2(16.0));
    }
}
