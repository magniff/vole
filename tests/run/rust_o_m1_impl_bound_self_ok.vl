// EXPECT: 1
// An impl's bound naming Self (`impl<U: Conv<Self>> Tr<U> for W`) is read with Self the impl's type, asked from a method of another type too.
// (Review of the obligation engine's M1: v0.30.1 built it; the selection gave 'unknown type Self')
trait Conv<X> {}
trait Tr<U> { fn f(&self) -> i64; }
struct W { r: i64 }
struct X { r: i64 }
impl Conv<W> for i64 {}
impl<U: Conv<Self>> Tr<U> for W { fn f(&self) -> i64 { 1 } }
fn need<T: Tr<i64>>(t: &T) -> i64 { t.f() }
impl X { fn m(&self) -> i64 { need(&W { r: 0 }) } }
fn main() { println("{}", X { r: 0 }.m()); println("{}", need(&W { r: 0 })); }
