// XFAIL: gap 2: compile type error: no associated function 'to_fd' in 'Formatter'
// EXPECT: Pair { a: 1, b: "x" } Pair { a: 1, b: "y" } Pair { a: 2, b: "a" }
// EXPECT: eq true hash true
// EXPECT: Some2(5) None2
// EXPECT: lt true
// EXPECT: deep 1 2
// EXPECT: Inner { v: 3 }
// 0.15: #[derive] on generic structs and enums: each parameter gets the
// trait as a bound, after the bounds it has (`impl<K: Hash + Eq + Ord> Ord
// for Keyed<K>`); derives in an inline module, with #[repr(C)].
use std::hash::Hash; use std::fmt::Debug; use std::alloc::Allocator; use std::fmt::Formatter as Fmt;
use std::collections::HashMap;

#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy)]
struct Pair<A, B> { a: A, b: B }

#[derive(Debug, PartialOrd, Ord, PartialEq, Eq, Clone, Copy)]
enum Maybe<T> { Some2(T), None2 }

#[derive(PartialOrd, Ord, PartialEq, Eq, Clone, Copy)]
struct Keyed<K: Hash + Eq> { k: K, n: i64 }

#[derive(Clone)]
struct Stack<T, A: Allocator> { items: Vec<T, A> }

mod inner {
    #[repr(C)]
    #[derive(Debug, Clone, PartialEq, Eq, Copy)]
    pub struct Inner { pub v: i64 }
}

fn show<T: std::fmt::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1i32);
    write(f, "{:?}", x)?;
}

fn main(gpa: Gpa) {
    let mut v: Vec<Pair<i64, &str>, Gpa> = Vec::new_in(gpa);
    v.push(Pair { a: 2i64, b: "a" });
    v.push(Pair { a: 1i64, b: "y" });
    v.push(Pair { a: 1i64, b: "x" });
    v.sort_unstable();
    for i in 0..v.len() {
        if i > 0 {
            print(" ");
        }
        show(&v.as_slice()[i]);
    }
    println("");

    let p = Pair { a: 1i64, b: "x" };
    let q = p.clone();
    let mut m: HashMap<Pair<i64, &str>, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(p, 7);
    print("{}", if p == q { "eq true" } else { "eq false" });
    println("{}", if m.get(&q).copied().unwrap_or(0) == 7 { " hash true" } else { " hash false" });

    let s: Maybe<i64> = Maybe::Some2(5i64);
    let n: Maybe<i64> = Maybe::None2;
    show(&s);
    print(" ");
    let n2 = n.clone();
    show(&n2);
    println("");

    let k1 = Keyed { k: 1i64, n: 5 };
    let k2 = Keyed { k: 2i64, n: 0 };
    println("{}", if k1 < k2 && s < n { "lt true" } else { "lt false" });

    let mut items: Vec<i64, Gpa> = Vec::new_in(gpa);
    items.push(1);
    let st = Stack { items: items };
    let mut st2 = st.clone();
    st2.items.push(2);
    print("deep ");
    print("{}", (st.items.len() as i64));
    print(" ");
    print("{}", (st2.items.len() as i64));
    println("");

    let i = inner::Inner { v: 3 };
    let j = i.clone();
    if i == j {
        show(&j);
    }
    println("");
}
