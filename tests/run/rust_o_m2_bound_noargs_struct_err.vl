// ERROR: the trait 'Tr<i32>' is not implemented for 'W'
// (RT-270) a struct's `T: Tr` read with Tr's default (rustc E0277; v0.30.1 accepted it).
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

struct S<T: Tr> {
    t: T,
}

fn main() {
    let s: S<W> = S { t: W { r: 0 } };
    println("{}", s.t.r);
}
