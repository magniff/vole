// 0.25.2.1 (eval 0.25.2: mandelbulb): `var code = 0;` returned from a
// `-> i32` function: the note names the literal default and the fix.
// ERROR: expected 'i32', got 'i64'
// ERROR: (a float literal is f64, an integer one i64, where nothing gives their type): annotate it, `var code: i32 = ...`
// ERROR: --old 'var code =' --new 'var code: i32 ='
fn status(fail: bool) -> i32 {
    var code = 0;
    if fail {
        code = 1;
    }
    code
}

fn main() -> i32 {
    status(false)
}
