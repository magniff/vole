// XFAIL: RT-414: `r.max(&5)` is refused, borrowck.dropped_borrowed of the temporary `5`; rustc promotes `&5` to a static and prints `2000000000 4000000000` (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXPECT: 2000000000 4000000000
fn main() {
    let a = 2000000000;
    let r = &a;
    let m = r.max(&5);
    let b: i64 = a;
    println("{} {}", m, b + b);
}
