// EDITION: rust
// RUSTC-EDITION: 2024
// RUSTC: none a struct generic over its allocator (allocator_api is nightly)
// RULE: D21.1, D21.3
// (0.27.2.1) An inherent method's opaque result borrows `self` (`&self`'s
// lifetime is captured).
// EXPECT: 30
use std::alloc::Allocator;

struct Bag<A: Allocator> {
    v: Vec<i32, A>,
}

impl<A: Allocator> Bag<A> {
    fn big(&self) -> impl Iterator<Item = &i32> {
        self.v.iter().filter(|x| **x > 5)
    }
}

fn main(gpa: Gpa) {
    let v: Vec<i32, Gpa> = Vec::new_in(gpa);
    let mut b = Bag { v: v };
    b.v.push(10);
    b.v.push(3);
    b.v.push(20);
    let mut s: i32 = 0;
    for x in b.big() {
        s += *x;
    }
    println("{}", s);
}
