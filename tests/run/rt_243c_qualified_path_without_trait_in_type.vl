// RT-243c, closed by the qualified paths' parser (a `<` where a type starts, types::opens_args).
// From the re-review of g302oblig M2 (its form a13_angle_t). Since v0.30.1 at
// least (v0.30.1 and the release build give the same parser error).
// EXPECT: 8
trait Tr2 {
    type Out;
}

trait Tr {
    type Out;
    fn get(&self) -> Self::Out;
}

trait Sub: Tr {
    fn h(&self) -> i64;
}

#[derive(Clone, Copy, Debug)]
struct W {
    a: i64,
}

impl Tr2 for W {
    type Out = u8;
}

impl Tr for W {
    type Out = i64;

    fn get(&self) -> i64 {
        self.a
    }
}

impl Sub for W {
    fn h(&self) -> i64 {
        1
    }
}

fn sz<T: Sub>(t: &T) -> usize {
    std::mem::size_of::< <T>::Out>()
}

fn main() {
    let w = W { a: 300 };
    println("{}", sz(&w));
}
