// FLAGS: --check-alloc
// RULE: D21.6, D19.5 (0.30.2, RT-213, RT-195) An opaque value is called as
// its bound says, whatever its hidden closure is: an `impl Fn` passes an
// `F: FnOnce` and an `F: FnMut` bound, an `impl FnMut` bound `mut` is
// called and passes `F: FnOnce`, an `impl FnOnce` is called once (its
// closure captures nothing, or a D it drops then); a call through two
// references reaches the closure (`&&F`, `&mut &mut F`, `&mut &F`). The
// output is rustc's.
// EXPECT: apply 4
// EXPECT: twice 9
// EXPECT: by value 5
// EXPECT: count 1
// EXPECT: call_mut 5
// EXPECT: call_once 4
// EXPECT: once 5
// EXPECT: once again 5
// EXPECT: drop 4
// EXPECT: owns 4
// EXPECT: drop 6
// EXPECT: owns passed 6
// EXPECT: rr 17
// EXPECT: rr call 8
// EXPECT: mm 3
// EXPECT: mm call 3
// EXPECT: m& 12
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn add(n: i64) -> impl Fn(i64) -> i64 {
    move |x| x + n
}

fn counter() -> impl FnMut() -> i64 {
    let mut n = 0;
    move || {
        n += 1;
        n
    }
}

fn once() -> impl FnOnce() -> i64 {
    || 5
}

fn owns(k: i64) -> impl FnOnce() -> i64 {
    let d = D { k };
    move || {
        let v = d.k;
        drop(d);
        v
    }
}

fn call_once<F: FnOnce() -> i64>(f: F) -> i64 {
    f()
}

fn call_mut<F: FnMut() -> i64>(mut f: F) -> i64 {
    f() + f()
}

fn apply<F: FnOnce(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn twice<F: FnMut(i64) -> i64>(mut f: F) -> i64 {
    f(1) + f(2)
}

fn through<F: Fn(i64) -> i64>(f: &&F) -> i64 {
    f(10)
}

fn through_mut<F: FnMut() -> i64>(g: &mut &mut F) -> i64 {
    g() + g()
}

fn main() {
    let a = add(3);
    println("apply {}", apply(&a, 1));
    println("twice {}", twice(&a));
    println("by value {}", apply(a, 2));
    let mut c = counter();
    println("count {}", c());
    println("call_mut {}", call_mut(&mut c));
    println("call_once {}", call_once(c));
    let o = once();
    println("once {}", o());
    println("once again {}", call_once(once()));
    let w = owns(4);
    println("owns {}", w());
    println("owns passed {}", call_once(owns(6)));
    let b = add(7);
    let rb = &b;
    println("rr {}", through(&rb));
    let rrb = &rb;
    println("rr call {}", rrb(1));
    let mut k = counter();
    let mut km = &mut k;
    println("mm {}", through_mut(&mut km));
    let mk = &mut km;
    println("mm call {}", mk());
    let s = &b;
    let mut ms = &s;
    let mms = &mut ms;
    println("m& {}", mms(5));
}
