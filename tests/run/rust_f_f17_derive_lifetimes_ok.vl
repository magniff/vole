// EDITION: rust
// RULE: F17.1
// A derive on an item with lifetimes writes them (`impl<'a> Clone for
// W<'a>`), so clone_from's `&Self` is the item's type; a shared reference
// field is passed as it is and its clone is a copy, as Rust's impls for
// `&T` give: std2's Chars (`rest: &'a str`) clones, and Cycle::new clones
// its iterator.
// EXPECT: 3 W { s: "x", v: 5 } true false 5
#[derive(Clone, Debug, PartialEq, Hash)]
struct W<'a> {
    s: &'a str,
    v: &'a i64,
}

fn main() {
    let a = [1i64, 2];
    let c = "abc".chars();
    let mut d = c.clone();
    d.clone_from(&c);
    let x = 5i64;
    let y = 6i64;
    let w = W { s: "x", v: &x };
    let mut u = W { s: "y", v: &y };
    u.clone_from(&w);
    let z = W { s: "x", v: &y };
    let n = a.iter().cycle().take(5).count();
    println("{} {:?} {} {} {}", d.count(), u, u == w, z == w, n);
}
