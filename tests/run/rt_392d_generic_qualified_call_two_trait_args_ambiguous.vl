// XFAIL: RT-392d: (RT-392's mechanism, two trait arguments and a generic impl) `<U as Tr<u8, i64>>::get(u)` in `fn n1<U: Tr<u8, i64>>(u: &U)`, instantiated with S, which has `impl<Y> Tr<u8, Y>` and `impl Tr<i64, i64>`, is refused in the instance: "'S::get' is ambiguous for arguments ()"; rustc takes Tr<u8, i64> and prints 1 (0.30.2)
// From the review of g302elab. Since v0.30.1 at least.
// From the review's form pre/generic_ufcs_ambiguous.
// EXPECT: 1
trait Tr<X, Y> {
    fn get(&self) -> i64;
}

struct S {}

impl<Y> Tr<u8, Y> for S {
    fn get(&self) -> i64 {
        1
    }
}

impl Tr<i64, i64> for S {
    fn get(&self) -> i64 {
        10
    }
}

fn n1<U: Tr<u8, i64>>(u: &U) -> i64 {
    <U as Tr<u8, i64>>::get(u)
}

fn main() {
    println("{}", n1(&S {}));
}
