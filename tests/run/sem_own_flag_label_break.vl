// sem-own: a value moved in an inner loop then `break :outer`: drop flags for the locals of both loops.
// EXPECT: drop 10
// EXPECT: drop 20
// EXPECT: drop 0
// EXPECT: drop 10
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    outer: for i in 0..3 {
        let a = mk(i, gpa);
        for j in 0..3 {
            let b = mk(10 * (j + 1), gpa);
            if i == 0 && j == 0 { continue; }
            break;
        }
        if i == 1 { eat(a); break :outer; }
    }
    println("end");
}
