// own.partial (0.26.1): a field of a value whose type has a Drop impl is
// not assigned after the value moved, on every path or on some: the drop
// needs all of it, and one field cannot make it whole again (Rust's
// E0382). Nor is a field moved out on one path while the whole moves on
// another. With the value there (the other branch) the write is allowed.
// ERROR: cannot assign to 'k.t': 'k' moved at 30:10, and 'G' implements Drop, which needs all of it
// ERROR: cannot assign to 'm.t': 'm' may have moved at 36:14, and 'G' implements Drop, which needs all of it
// ERROR: cannot assign to 'h.g.t': 'h.g' moved at 40:10, and 'G' implements Drop, which needs all of it
// ERROR: cannot move 'q.t' out of 'q': 'G' implements Drop, which needs all of it
struct T { id: i64 }

impl Drop for T {
    fn drop(inout self) { println(f"d{self.id}"); }
}

struct G { t: T, k: i64 }

impl Drop for G {
    fn drop(inout self) { println(f"dg{self.k}"); }
}

struct H { g: G, x: T }

fn geat(g: sink G) {}

fn teat(t: sink T) {}

fn run(c: i64) {
    var k = G { t: T { id: 1 }, k: 1 };
    geat(k);
    k.t = T { id: 2 };
    var m = G { t: T { id: 3 }, k: 2 };
    if c > 1 {
        m.t = T { id: 4 };
    } else {
        geat(m);
    }
    m.t = T { id: 5 };
    var h = H { g: G { t: T { id: 6 }, k: 3 }, x: T { id: 7 } };
    geat(h.g);
    h.g.t = T { id: 8 };
    var q = G { t: T { id: 9 }, k: 4 };
    if c > 1 {
        teat(q.t);
    } else {
        geat(q);
    }
}

fn main() -> i32 {
    run(0);
    0
}
