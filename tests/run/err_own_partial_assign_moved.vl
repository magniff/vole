// own.partial (0.26.1): a field of a value whose type has a Drop impl is
// not assigned after the value moved, on every path or on some: the drop
// needs all of it, and one field cannot make it whole again (Rust's
// E0382). Nor is a field moved out on one path while the whole moves on
// another. With the value there (the other branch) the write is allowed.
// ERROR: error[borrowck.use_moved]
// ERROR: line 35, column 5
// ERROR: error[borrowck.use_moved]
// ERROR: line 42, column 5
// ERROR: error[borrowck.use_moved]
// ERROR: line 45, column 5
// ERROR: error[borrowck.move_from_drop]
// ERROR: line 48, column 14
struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

struct G { t: T, k: i64 }

impl Drop for G {
    fn drop(&mut self) { println("dg{}", self.k); }
}

struct H { g: G, x: T }

fn geat(g: G) {}

fn teat(t: T) {}

fn run(c: i64) {
    let mut k = G { t: T { id: 1 }, k: 1 };
    geat(k);
    k.t = T { id: 2 };
    let mut m = G { t: T { id: 3 }, k: 2 };
    if c > 1 {
        m.t = T { id: 4 };
    } else {
        geat(m);
    }
    m.t = T { id: 5 };
    let mut h = H { g: G { t: T { id: 6 }, k: 3 }, x: T { id: 7 } };
    geat(h.g);
    h.g.t = T { id: 8 };
    let mut q = G { t: T { id: 9 }, k: 4 };
    if c > 1 {
        teat(q.t);
    } else {
        geat(q);
    }
}

fn main() -> i32 {
    run(0);
    0
}
