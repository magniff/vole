// RULE: C3.4
// (0.30.2, RT-38f) A parameter whose type is an associated type that is
// a `&mut i64`: written as a path, it had no view after the body, and
// `*p = 9` in the ensures wrote the caller's value. Every parameter a
// clause mentions is read through a view, whatever its type is written as.
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*p'
// ERROR-COUNT: 1
trait Tr {
    type Out;
}

struct K;

impl<'a> Tr for &'a K {
    type Out = &'a mut i64;
}

fn f<'a>(p: < &'a K as Tr >::Out) -> i64
    ensures {
    *p = 9;
    true
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
