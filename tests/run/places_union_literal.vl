// places IR (0.26.1): a union literal names one field; its aggregate has
// a part per field of the union, `()` but the one written (the value of a
// field after the first was dropped from the IR before).
// EXPECT: 7
// PLACES: fn main
// PLACES: aggregate U(const (), const 7)
union U { a: f64, b: i64 }

fn main() {
    let u = U { b: 7 };
    // UNSAFE: a union's field is read as written.
    // SAFETY: b is the field the literal wrote.
    let b = unsafe { u.b };
    println("{b}");
}
