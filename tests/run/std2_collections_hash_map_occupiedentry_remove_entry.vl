// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map OccupiedEntry::remove_entry.
// EXPECT: (1, 9) 0
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Entry;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 9);
    let mut kv = (0, 0);
    if let Entry::Occupied(e) = m.entry(1) {
        kv = e.remove_entry();
    }
    println("{:?} {}", kv, m.len());
}
