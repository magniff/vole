// RULE: F19.8, D22.1
// (0.30.2, RT-43) A generic union's field `T` with no `T: Copy` is
// refused at its declaration, as rustc's E0740, though the program uses
// it only as Md<i64>: the union's opaque instance (each parameter a type
// with its bounds only) is asked, as rustc asks the declaration.
// ERROR: error[union.field]: a union's field must be Copy, a reference or a `ManuallyDrop<T>`: field 'value' of union 'Md<T>' has type 'T' (rustc E0740)
// ERROR-COUNT: 1
union Md<T> {
    value: T,
    x: i64,
}

fn main() {
    let u: Md<i64> = Md { value: 7 };
    // UNSAFE: reads the field it was not made with
    // SAFETY: both fields are 8 bytes of an integer
    println("{}", unsafe { u.x });
}
