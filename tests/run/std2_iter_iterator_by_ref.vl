// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter Iterator::by_ref.
// EXPECT: [1, 2] [3, 4]

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = v.iter().copied();
    let a: Vec<i64, Gpa> = it.by_ref().take(2).collect_in(gpa);
    let b: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?} {:?}", a, b);
}
