// sem-own: HashMap::insert over a key, its result discarded: the old value is dropped at the statement end.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, D<Gpa>, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    m.insert(1, mk(2, gpa));
    println("end");
}
