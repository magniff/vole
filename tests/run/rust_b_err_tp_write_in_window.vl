// RULE: D7.2
// (0.27.1) An assignment to the reserved place inside the window.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 22, column 9
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add({
        s.x = 5;
        1
    });
    println("{}", s.x);
}
