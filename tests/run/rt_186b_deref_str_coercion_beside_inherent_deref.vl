// XFAIL: RT-186b: (RT-186's mechanism, with an inherent `deref` beside) `impl Deref for N { type Target = str; }` and an inherent `fn deref(&self) -> &str` returning another string: `let s: &str = &n;` and `show(&n)` are refused, "expected '&str', got '&N'"; rustc coerces through the Deref impl and prints 2 2 (0.30.2)
// From the paused g302index work (its pre/pre6). Since v0.30.1 at least
// (the same two errors). A fix of RT-186 must call Deref::deref, not the
// inherent one (RT-251's family): this case prints 4 4 then.
// EXPECT: 2 2
use std::ops::Deref;

struct N {
    a: &'static str,
    z: &'static str,
}

impl N {
    fn deref(&self) -> &str {
        self.z
    }
}

impl Deref for N {
    type Target = str;

    fn deref(&self) -> &str {
        self.a
    }
}

fn show(s: &str) -> usize {
    s.len()
}

fn main() {
    let n = N { a: "ab", z: "zzzz" };
    let s: &str = &n;
    println("{} {}", show(&n), s.len());
}
