// str::chars (0.30): count() by blocks of sixteen bytes and next() with
// its ASCII step, against a plain decoder of the bytes: random text of
// every length from 0 to 200 bytes at every offset from 0 to 16, text
// with a continuation byte in every lane for more than 63 steps of four
// blocks (the counts are bytes, added up before they wrap), every code
// point of a stride and each length's first and last one, forward, back
// and by char_indices; and char::from_u32's one compare against the two
// ranges it stands for, on every value to 0x120000 and around u32's ends.
// EXPECT: texts 3417, long 16, code points 11487, from_u32 1179904: 0 differ

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

// The code point at b[*i] (b is UTF-8), by its bits; *i moves past it.
fn plain_next(b: &[u8], i: &mut usize) -> u32 {
    let x = b[*i] as u32;
    let mut len = 1usize;
    let mut cp = x;
    if x >= 0xF0 {
        len = 4;
        cp = x & 7;
    } else if x >= 0xE0 {
        len = 3;
        cp = x & 15;
    } else if x >= 0xC0 {
        len = 2;
        cp = x & 31;
    }
    for k in 1..len {
        cp = cp * 64 + (b[*i + k] as u32 - 0x80);
    }
    *i += len;
    cp
}

fn push_char(b: &mut Vec<u8, Gpa>, cp: u32) {
    let mut e = [0u8; 4];
    let t = char::from_u32(cp).unwrap().encode_utf8(&mut e);
    b.extend_from_slice(t.as_bytes());
}

// A scalar value of 1 to 4 bytes, or mostly ASCII.
fn random_cp(x: u64) -> u32 {
    let c = (x >> 8) % 8;
    let r = x >> 16;
    (if c < 4 {
        0x20 + r % 95
    } else if c == 4 {
        0x80 + r % 0x780
    } else if c == 5 {
        0x800 + r % 0xd000
    } else if c == 6 {
        0xe000 + r % 0x2000
    } else {
        0x10000 + r % 0x100000
    }) as u32
}

// How s's iterators differ from the plain decoder: 0 when they agree.
fn check(s: &str) -> i64 {
    let b = s.as_bytes();
    let mut bad = 0;
    let mut i = 0usize;
    let mut n = 0usize;
    let mut it = s.chars();
    let mut ci = s.char_indices();
    while i < b.len() {
        let at = i;
        let want = plain_next(b, &mut i);
        n += 1;
        match it.next() {
            Some(c) => if c as u32 != want {
                bad += 1;
            },
            None => bad += 1,
        }
        match ci.next() {
            Some((k, c)) => if k != at || c as u32 != want {
                bad += 1;
            },
            None => bad += 1,
        }
        if it.as_str().len() != b.len() - i {
            bad += 1;
        }
    }
    if it.next().is_some() || ci.next().is_some() {
        bad += 1;
    }
    if s.chars().count() != n {
        bad += 1;
    }
    // (from the end: the same code points, last first)
    let mut back = s.chars().rev();
    let mut fwd = 0usize;
    let mut sum_back = 0u64;
    let mut sum_fwd = 0u64;
    let mut k = 0usize;
    while let Some(c) = back.next() {
        k += 1;
        sum_back = sum_back.wrapping_mul(31).wrapping_add(c as u64);
    }
    let mut j = b.len();
    while j > 0 {
        j -= 1;
        if b[j] & 0xC0 != 0x80 {
            let mut at = j;
            sum_fwd = sum_fwd.wrapping_mul(31).wrapping_add(plain_next(b, &mut at) as u64);
            fwd += 1;
        }
    }
    if k != n || fwd != n || sum_back != sum_fwd {
        bad += 1;
    }
    bad
}

fn main(gpa: Gpa) -> i32 {
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    let mut s: u64 = 0x9e3779b97f4a7c15;
    let mut differ = 0;
    let mut texts = 0;
    for len in 0..201usize {
        for off in 0..17usize {
            b.clear();
            for k in 0..off {
                b.push(b'a' + (k % 26) as u8);
            }
            while b.len() < off + len {
                push_char(&mut b, random_cp(next(&mut s)));
            }
            let t = std::str::from_utf8(&b.as_slice()[off..]).unwrap();
            texts += 1;
            if check(t) != 0 {
                differ += 1;
                if differ < 5 {
                    println("differ: len {len} off {off}");
                }
            }
        }
    }
    // (four-byte sequences: three bytes of four are continuation bytes,
    // and after `lead` bytes of ASCII a lane has one in each block)
    let mut long = 0;
    for lead in 0..4usize {
        for size in [4032usize, 4096, 16384, 20000] {
            b.clear();
            for _ in 0..lead {
                b.push(b'x');
            }
            while b.len() < size {
                let face = 0x1F600 + (b.len() % 64) as u32;
                push_char(&mut b, face);
            }
            let t = std::str::from_utf8(b.as_slice()).unwrap();
            long += 1;
            let mut n = 0usize;
            for _ in t.chars() {
                n += 1;
            }
            if t.chars().count() != n || n != lead + (b.len() - lead) / 4 {
                differ += 1;
                println("differ: long text, lead {lead} size {size}");
            }
        }
    }
    // (every 97th code point, and the ends of each length and of the
    // surrogates' gap, in one text; then each alone)
    b.clear();
    let mut cps = 0;
    let mut cp = 0u32;
    while cp < 0x110000 {
        if cp < 0xD800 || cp > 0xDFFF {
            push_char(&mut b, cp);
            cps += 1;
        }
        cp += 97;
    }
    let edges = [0u32, 0x7F, 0x80, 0x7FF, 0x800, 0xD7FF, 0xE000, 0xFFFD, 0xFFFF, 0x10000, 0x10FFFF];
    for e in edges {
        push_char(&mut b, e);
        cps += 1;
    }
    if check(std::str::from_utf8(b.as_slice()).unwrap()) != 0 {
        differ += 1;
        println("differ: the code points' text");
    }
    for e in edges {
        b.clear();
        push_char(&mut b, e);
        let t = std::str::from_utf8(b.as_slice()).unwrap();
        cps += 1;
        if t.chars().next() != char::from_u32(e) || t.chars().next_back() != char::from_u32(e)
            || t.chars().count() != 1 {
            differ += 1;
            println("differ: U+{:X} alone", e);
        }
    }
    let mut tried = 0;
    let mut i = 0u32;
    while i < 0x120000 {
        let want = !(i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF));
        tried += 1;
        match char::from_u32(i) {
            Some(c) => if !want || c as u32 != i {
                differ += 1;
            },
            None => if want {
                differ += 1;
            },
        }
        i += 1;
    }
    for d in 0..128u32 {
        tried += 2;
        if char::from_u32(0xFFFFFFFF - d).is_some() || char::from_u32(0x80000000 + d).is_some() {
            differ += 1;
        }
    }
    println("texts {texts}, long {long}, code points {cps}, from_u32 {tried}: {differ} differ");
    0
}
