// RULE: R6
// (0.30.2) Callables meeting an Fn bound or a `fn` type whose result
// borrows nothing the call's arguments do not let it: each accepted, as
// rustc accepts it (the twin), while the value the arguments borrow is
// dropped before the result is used. A fn item given for `F: Fn(T) -> U`
// relates T and U by its own signature (`st` returns 'static, `sec`
// borrows its second argument only); a `fn` value given there relates
// every argument to its result. Their must-fail twins:
// rust_b_err_fn_value_r6_drop.vl.
// FLAGS: --check-alloc
// EXPECT: 7 7 7 2000 2000 1 1 Some(7) 3 2000 2000 7 1 Some(2) 2000 2000
static SEVEN: i64 = 7;

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn st(_x: &i64) -> &'static i64 {
    &SEVEN
}

fn two<'a, 'b>(x: &'a i64, _y: &'b i64) -> &'a i64 {
    x
}

fn sec<'a, 'b>(_x: &'a i64, y: &'b i64) -> &'b i64 {
    y
}

fn sk(x: &i64) -> i64 {
    *x
}

fn sks(_x: &i64) -> &'static i64 {
    &SEVEN
}

fn sc<'a>(s: &mut i64, x: &'a i64) -> Option<&'a i64> {
    *s += 1;
    Some(x)
}

fn dbl(x: &i64) -> i64 {
    *x * 2
}

fn mkv(k: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(k);
    v
}

fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    f(t)
}

fn fw<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    ap(t, f)
}

fn app<T, U>(t: T, f: fn(T) -> U) -> U {
    f(t)
}

fn ap2<A, B, U, F: Fn(A, B) -> U>(a: A, b: B, f: F) -> Option<U> {
    Some(f(a, b))
}

fn aph<F: Fn(&i64) -> &i64>(x: &i64, f: F) -> &i64 {
    f(x)
}

struct Holder<A, B> {
    f: fn(A) -> B,
}

struct Outer<A, B> {
    h: Holder<A, B>,
    n: i64,
}

fn apo<T, U>(t: T, o: Outer<T, U>) -> Option<U> {
    Some((o.h.f)(t))
}

fn mkcap<'a>(r: &'a i64) -> impl Fn(&i64) -> &'a i64 {
    move |_x| r
}

fn main(gpa: Gpa) {
    let v1 = mkv(1, gpa);
    let r1 = v1.first().map(st);
    drop(v1);
    let v2 = mkv(2, gpa);
    let r2 = ap(&v2[0], st);
    drop(v2);
    let v3 = mkv(3, gpa);
    let r3 = app(&v3[0], st);
    drop(v3);
    let w = mkv(2000, gpa);
    let v4 = mkv(4, gpa);
    let r4 = ap2(&v4[0], &w[0], sec);
    drop(v4);
    let v5 = mkv(5, gpa);
    let r5 = ap2(&w[0], &v5[0], two);
    drop(v5);
    let mut u6 = mkv(6, gpa);
    u6.sort_by_key(sk);
    u6.sort_by_key(sks);
    let r6 = u6.len();
    drop(u6);
    let v7 = mkv(7, gpa);
    let r7: Vec<&i64, Gpa> = w.iter().scan(0i64, sc).collect_in(gpa);
    drop(v7);
    let v8 = mkv(8, gpa);
    let o8: Option<&Vec<i64, Gpa>> = Some(&v8);
    let r8 = o8.map(Vec::<i64, Gpa>::len);
    drop(v8);
    let v9 = mkv(9, gpa);
    let r9 = apo(&w[0], Outer { h: Holder { f: idr2 }, n: 1 });
    drop(v9);
    let z = 5i64;
    let v10 = mkv(10, gpa);
    let c10 = mkcap(&SEVEN);
    let r10 = Some(&v10[0]).map(c10);
    drop(v10);
    let v11 = mkv(11, gpa);
    let r11 = fw(&v11[0], st);
    drop(v11);
    let v12 = mkv(1, gpa);
    let r12: Vec<i64, Gpa> = v12.iter().map(dbl).collect_in(gpa);
    drop(v12);
    let r13 = aph(&w[0], idr2);
    let r14 = aph(&z, idr2);
    println("{} {} {} {} {} {} {} {:?} {} {} {} {} {} {:?} {} {}", r1.unwrap(), r2, r3,
        r4.unwrap(), r5.unwrap(), r6, r8.unwrap(), r10, r7.len() + 2, r9.unwrap(), *r13, *r14 + 2,
        r12.len(), r12.first(), w[0], w.len() * 2000);
}
