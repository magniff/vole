// RT-STD-3 (fixed in 0.30.1): integer pow and abs never panic on overflow at -O0, where the guide says they do
// guide math#integers: "`i64::MIN.abs()` and a `pow` past the type's
// range panic with the overflow checks on (-O0) and wrap with them off".
// At -O0 both wrap silently (0.28.0 to 0.30.0), while `x - 1` on the same
// value panics. Rust's debug build: "attempt to multiply with overflow".
// FLAGS: -O0
// EXPECT: before
// EXIT: 101
// STDERR: attempt to multiply with overflow

fn main() -> i32 {
    let k = std::env::args().count() as u32;
    let e: u32 = 69 + k;
    let b: u64 = 1 + (k as u64);
    println("before");
    println("{}", b.pow(e));
    0
}
