// EDITION: rust
// Block layout and scheduling (51_layout.vl, 50_isel.vl): the panic of
// a bounds check goes after the loop (cold blocks last), the loop's
// comparison fuses with its branch, the constant a loop stores is made
// once, outside it, and callee-saved registers are saved in pairs.
// (0.10: without vectorization, which would take both loops; 0.11: and
// without unrolling with run-time trip counts.)
// FLAGS: --no-vectorize --no-unroll-runtime
// EXPECT: 4950 100
// EXPECT: 45
// ASM(aarch64-macos): _vole.sum:
// ASM(aarch64-macos): b.hs
// ASM(aarch64-macos): b.lt
// ASM(aarch64-macos): ret
// ASM(aarch64-macos): rt.panic
// ASM(aarch64-macos): _vole.mark:
// ASM(aarch64-macos): mov x
// ASM(aarch64-macos): strb w
// ASM-NOT(aarch64-macos): mov
// ASM(aarch64-macos): b.l
// ASM(aarch64-macos): _main:
// ASM(aarch64-macos): stp x19, x20
// ASM(aarch64-macos): ldp x19, x20
// ASM(x86_64-macos): _vole.sum:
// ASM(x86_64-macos): jae
// ASM(x86_64-macos): jl
// ASM(x86_64-macos): ret
// ASM(x86_64-macos): rt.panic
// ASM(x86_64-linux): vole.sum:
// ASM(x86_64-linux): jae
// ASM(x86_64-linux): jl
// ASM(x86_64-linux): ret
// ASM(x86_64-linux): rt.panic
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *mut u8;
}

// A slice loop whose bounds check stays (the length is the caller's).
fn sum(s: &[i64], n: i64) -> i64 {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        total += s[i as usize];
        i += 1;
    }
    total
}

// Stores of a constant in a loop. (Not inlined: its pointer, from calloc,
// is then main's to keep; inlined, the IR's lowering (0.26.1) sees the
// call through `m` is mark's, and the buffer goes to the stack.)
#[inline(never)]
fn mark(p: *mut u8, n: i64) {
    let mut i: i64 = 0;
    while i < n {
        unsafe { (*p.add(i as usize)) = 1; }
        i += 1;
    }
}

fn count(p: *mut u8, n: i64) -> i64 {
    let mut c: i64 = 0;
    for i in 0..n {
        unsafe { c += (*p.add(i as usize)) as i64; }
    }
    c
}

fn main() -> i32 {
    let p = unsafe { calloc(100, 8) as *mut i64 };
    for i in 0..100 {
        unsafe { (*p.add(i as usize)) = i; }
    }
    let s = sum;
    let m = unsafe { mark };
    let bytes = unsafe { calloc(100, 1) };
    unsafe {
        m(bytes, 100i64);
        printf(c"%ld %ld\n",
            s(std::slice::from_raw_parts(p.add((0) as usize), (100 - (0)) as usize), 100i64),
            count(&mut *bytes, 100));
    }
    // main keeps p and bytes across calls: two callee-saved registers.
    unsafe { printf(c"%ld\n", count(&mut *bytes, 10) + 35 + (*p.add(0))); }
    0
}
