// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str SplitTerminator::impl Iterator.
// EXPECT: ["A", "B"] ["A", "", "B", ""]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "A.B.".split_terminator('.').collect_in(gpa);
    let w: Vec<&str, Gpa> = "A..B..".split_terminator('.').collect_in(gpa);
    println("{:?} {:?}", v, w);
}
