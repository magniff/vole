// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::impl Hash.
// EXPECT: true false
use std::hash::{DefaultHasher, Hash, Hasher};

fn h<T: Hash + ?Sized>(x: &T) -> u64 {
    let mut s = DefaultHasher::new();
    x.hash(&mut s);
    s.finish()
}

fn main() {
    println("{} {}", h("abc") == h("abc"), h(&("ab", "c")) == h(&("a", "bc")));
}
