// (0.30.1) An assertion whose condition compares two literals is no panic
// only when the condition is true as the type reads the literals: an
// unsigned one of 2^63 or more is not negative. Before, `u64::MAX < 1`
// (always false: the assertion always fails) was read as `-1 < 1`,
// proven true, and #[no_panic] held.
// ERROR: 'always_fails' is #[no_panic], but it may panic
// ERROR-COUNT: 1
#[no_panic]
fn always_fails() -> i64 {
    assert(18446744073709551615u64 < 1);
    1
}

#[no_panic]
fn always_holds() -> i64 {
    assert(18446744073709551615u64 > 1);
    assert(9223372036854775807i64 > 1);
    2
}

fn main() {
    println("{} {}", always_fails(), always_holds());
}
