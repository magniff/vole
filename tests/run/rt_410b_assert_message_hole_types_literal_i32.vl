// XFAIL: RT-410: WRONG CODE: an assert! message hole types an integer variable i32 at once: the message reads `msg -294967296` (overflow at -O0); rustc's is `msg 4000000000` (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// EXIT: 101
// STDERR: msg 4000000000
fn main() {
    let a = 2000000000;
    assert !(a < 0, "msg {}", a + a);
    let b: i64 = a;
    println("{}", b);
}
