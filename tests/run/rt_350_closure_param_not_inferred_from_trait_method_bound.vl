// XFAIL: RT-350: a closure's parameter type is not inferred from a trait method's `F: FnMut(T)` where T is the trait's parameter: "cannot infer the type of closure parameter"; rustc accepts (0.30.2)
// Since v0.30.1 at least. From the review of the type-parameter work.
// EXPECT: 6 7 1
trait Tr<T> {
    fn each<F: FnMut(T)>(&self, f: F) -> i64;
}

struct S;

impl Tr<u8> for S {
    fn each<F: FnMut(u8)>(&self, mut f: F) -> i64 { f(1); f(2); f(3); 6 }
}

struct W<T> { t: T }

impl<T: Copy> Tr<T> for W<T> {
    fn each<F: FnMut(T)>(&self, mut f: F) -> i64 { f(self.t); 3 }
}

fn run<X: Tr<u8>>(x: &X) -> i64 { let mut s: i64 = 0; x.each(|v| s = s + v as i64); s }

fn main() {
    let mut acc: i64 = 0;
    let a = S.each(|v| acc = acc + v as i64);
    let mut b: i64 = 0;
    W { t: 7u8 }.each(|v| b = b + v as i64);
    println("{} {} {}", a, b, run(&W { t: 1u8 }));
}
