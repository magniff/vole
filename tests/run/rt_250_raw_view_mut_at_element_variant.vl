// XFAIL: RT-250: a `&mut [i64]` behind a `&` made into `*mut [i64]` at an array element or an enum variant is accepted, a mutable access through a shared reference from safe code (0.30.2)
// The field form (`P { p: h.s }`) is refused by the RT-197 fix (g302bor); the element and the variant are not: `*const [T]` and `*mut [T]` are one type, and the checker records a view's mutable coercion only at let, assign, return and cast.
// rustc: E0596 at both (cannot borrow `*h.s` as mutable, as it is behind a `&` reference).
// ERROR: line 12
// ERROR: line 16
// ERROR-COUNT: 2
struct H<'a> {
    s: &'a mut [i64],
}

fn v2(h: &H) -> [*mut [i64]; 1] {
    [h.s]
}

fn v3(h: &H) -> Option<*mut [i64]> {
    Some(h.s)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let h = H { s: v.as_mut_slice() };
    let a = v2(&h);
    let b = v3(&h);
    println("{} {}", a.len(), b.is_some());
}
