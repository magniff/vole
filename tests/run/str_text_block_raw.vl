// 0.25.3: raw text blocks, r""" .. """: no escapes, a backslash is a
// backslash (regular expressions, WGSL); a line starting with """ goes in
// a block with #s, r#""" .. """#, and a closing """ needs as many #s.
// EXPECT: [^\d+\.\d+$ "\n" \]
// EXPECT: [a\
// EXPECT: b]
// EXPECT: ["""
// EXPECT: between
// EXPECT:   """]
// EXPECT: ["""#]
// EXPECT: 9
const RE: [u8] = r"""
    ^\d+\.\d+$ "\n" \
    """;

fn show(s: [u8]) {
    print("[");
    print(s);
    println("]");
}

fn main() -> i32 {
    show(RE);
    show(r"""
        a\
        b
        """);
    show(r#"""
        """
        between
          """
        """#);
    show(r##"""
        """#
        """##);
    let wgsl = r"""
        fn f() {}
        """;
    println(wgsl.len);
    0
}
