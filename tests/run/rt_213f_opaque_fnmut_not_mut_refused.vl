// RULE: D21.6 (0.30.2, RT-213) An `impl FnMut` value is called as FnMut,
// whatever its hidden closure is (`move || k` reads only): through a
// binding that is not `mut` it is refused, rustc E0596, as a local, a
// struct field, with an i64 or a String captured. 0.30.2's first try
// accepted each (the hidden closure was Fn). (k23, k24, k31 of the
// review of the opaque-type work)
// ERROR: line 27
// ERROR: line 29
// ERROR: line 31
// ERROR-COUNT: 3
fn counter() -> impl FnMut() -> i64 {
    let k = 5;
    move || k
}

fn fm(gpa: Gpa) -> impl FnMut() -> usize {
    let s = String::from_in("abc", gpa);
    move || s.len()
}

struct H<F> {
    f: F,
}

fn main(gpa: Gpa) {
    let h = counter();
    println("{}", h()); // error here
    let s = H { f: counter() };
    println("{}", (s.f)()); // error here
    let g = fm(gpa);
    println("{}", g()); // error here
    let mut m = counter();
    println("{}", m());
}
