// sem-own: insert and swap move elements around without dropping any.
// EXPECT: end
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    {
        let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
        v.push(mk(1, gpa));
        v.push(mk(2, gpa));
        v.insert(0usize, mk(3, gpa));
        v.swap(1usize, 2usize);
        println("end");
    }
}
