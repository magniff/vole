// EDITION: rust
// RULE: D8.2
// (0.27.2) A moved-from value is not dropped again on std2: moved into a
// function it drops there, once; moved on one branch only, a drop flag
// drops it on the other; returned, the caller drops it.
struct D {
    id: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn take(d: D) {
    println("take {}", d.id);
}

fn pass(d: D) -> D {
    d
}

fn main() {
    let a = D { id: 1 };
    take(a);
    println("after take");
    for i in 0..2 {
        let b = D { id: 10 + i };
        if i == 0 {
            take(b);
        }
        println("iteration {}", i);
    }
    let c = pass(D { id: 3 });
    println("passed {}", c.id);
}
// EXPECT: take 1
// EXPECT: drop 1
// EXPECT: after take
// EXPECT: take 10
// EXPECT: drop 10
// EXPECT: iteration 0
// EXPECT: iteration 1
// EXPECT: drop 11
// EXPECT: passed 3
// EXPECT: drop 3
