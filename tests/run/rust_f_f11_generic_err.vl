// EDITION: rust
// RULE: F11.1
// A generic impl's associated type must meet the bound the trait
// declares on it with the impl's parameters as declared: `T` is not
// known to be `Show`.
// ERROR: error[trait.unmet]: 'Src::Item = T' must implement 'Show', as the trait declares
trait Show {
    fn show(&self) -> i64;
}

trait Src {
    type Item: Show;
    fn first(&self) -> i64;
}

struct W<T> {
    x: T,
}

impl<T> Src for W<T> {
    type Item = T;

    fn first(&self) -> i64 {
        0
    }
}

fn main() -> i64 {
    0
}
