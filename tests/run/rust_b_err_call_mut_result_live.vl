// RULE: D3.6
// (0.27.1) A `&mut` result keeps its receiver mutably borrowed: assigning a
// field while it is live.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 23, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn x_mut(&mut self) -> &mut i64 {
        &mut self.x
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = s.x_mut();
    s.y = 1;
    *r += 1;
    println("{}", s.x);
}
