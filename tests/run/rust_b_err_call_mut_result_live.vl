// EDITION: rust
// RULE: D3.6
// (0.27.1) A `&mut` result keeps its receiver mutably borrowed: assigning a
// field while it is live.
// ERROR: :23:5: error[borrowck.assign_borrowed]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn x_mut(&mut self) -> &mut i64 {
        &mut self.x
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = s.x_mut();
    s.y = 1;
    *r += 1;
    println("{}", s.x);
}
