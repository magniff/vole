// XFAIL: RT-204: a generic fn as a value with its type known from the context (`let f: fn(i64) -> (i64, i64) = dup;`, `.map(twice)`, `Some(3).map(dup)`) and `[1, 2, 3].iter()` on an array temporary are refused, and `guide rust` does not list either (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_029_generic_fn_value_and_array_temp_iter.rs.txt).
// vole: `generic function 'dup' needs its type arguments to be used as a value
// ('f::<T>')` (lines 21, 23, 24) and `no method 'iter' on type '[i64; 3]' | help: an
// array has its slice's methods where it is a place: bind it to a variable first`
// (line 26). Both are deliberate (tests/run/err_generic_value_needs_args.vl,
// err_array_iter_temp.vl, 0.16), but rustc accepts both forms: the first test's
// `let f = id;` has no type from its context (rustc E0282 there too), these do.
// Since v0.28.0.
// EXPECT: (1, 1) [2, 4] Some((3, 3))
// EXPECT: 3
fn dup<T: Copy>(x: T) -> (T, T) {
    (x, x)
}

fn twice<T: std::ops::Add<Output = T> + Copy>(x: T) -> T {
    x + x
}

fn main(gpa: Gpa) {
    let f: fn(i64) -> (i64, i64) = dup;
    let a = [1i64, 2];
    let v: Vec<i64, Gpa> = a.iter().copied().map(twice).collect_in(gpa);
    let o = Some(3i64).map(dup);
    println("{:?} {:?} {:?}", f(1), v, o);
    println("{}", [1i64, 2, 3].iter().count());
}
