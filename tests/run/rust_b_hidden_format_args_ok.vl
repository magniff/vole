// RULE: D2.9
// (0.30.1) A format_args value borrows the places its holes name for as
// long as it lives, and no longer: it may be kept in a `let` and used,
// the place changed or moved after its last use; a Copy place, a value
// and a width are copies. rustc-twin's output is the EXPECT.
// FLAGS: --check-alloc
// EXPECT: [abc1 7 [] 3]
// EXPECT: [4     abc1]
// EXPECT: [abc1x]
fn show<A: std::fmt::Display>(a: A) {
    println("[{a}]");
}

fn main(gpa: Gpa) {
    let mut s = format_in("abc{}", 1, gpa);
    let n = 7;
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let a = format_args("{s} {n} {:?} {}", v, 1 + 2);
    show(a);
    show(format_args("{} {s:>8}", s.len()));
    s.push('x');
    let b = format_args("{s}");
    show(b);
    drop(s);
    drop(v);
}
