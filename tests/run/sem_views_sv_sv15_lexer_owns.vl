// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a lexer that owns its text; second word() changes it while first used
// ERROR: error[borrowck.mut_twice]
// ERROR: line 17, column 13
use std::alloc::Allocator; struct Lexer<A: Allocator> { src: String<A>, pos: i64 }

impl Lexer<Gpa> {
    fn word(&mut self) -> &str {
        let a = self.pos; self.pos += 1; &self.src.as_str()[a as usize..self.pos as usize]
    }
}

fn main(gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str("ab");
    let mut lx = Lexer { src: b, pos: 0 };
    let a = lx.word();
    let c = lx.word();
    println("{a} {c}");
}
