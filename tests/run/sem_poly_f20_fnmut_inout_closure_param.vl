// EDITION: rust
// F: FnMut(inout i64, i64) given a closure; called with &
// FLAGS: --check-alloc
// EXPECT: 10
fn fold_in<F: FnMut(&mut i64, i64)>(f: F, n: i64) -> i64 {
    let mut acc: i64 = 0; for i in 0..n { f(&mut acc, i); } acc
}

fn main() { println("{}", fold_in(|a: &mut i64, x: i64| { *a += x; }, 5i64)); }
