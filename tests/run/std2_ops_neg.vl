// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Neg.
// EXPECT: V { x: -12 }
use std::ops::Neg;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Neg for V {
    type Output = V;

    fn neg(self) -> V {
        V { x: -self.x }
    }
}

fn main() {
    let a = V { x: 12 };
    println("{:?}", -a);
}
