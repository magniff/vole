// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::rposition.
// EXPECT: Some(3) Some(2) None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 1, 2], gpa);
    println("{:?} {:?} {:?}", v.iter().rposition(|x| *x == 2), v.iter().rposition(|x| *x == 1),
        v.iter().rposition(|x| *x == 9));
}
