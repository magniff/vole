// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::iter_mut.
// EXPECT: [2, 4, 6]
use std::slice::SliceIndex;

fn main() {
    let mut a = [1, 2, 3];
    for x in a.iter_mut() {
        *x *= 2;
    }
    println("{:?}", a);
}
