// XFAIL: RT-398: `t.get().g()` in `fn mid<T: H>(t: &T)`, with `trait H: Sized { type Out: Tr<Self>; .. }` and `impl<T> Tr<B<T>> for W`, is refused, "no impl of 'W::g' takes arguments () | help: its impls: Tr"; rustc accepts it and prints the EXPECT line (0.30.2)
// From the review of g302oblig-m2 (form f271i). Since v0.30.1 at least;
// the release build the same. The bound `Out: Tr<Self>` with Self =
// B<i64> is `W: Tr<B<i64>>`, which the generic impl gives. RT-397 is the
// other side: the same bound never checked where the impl is written.
// EXPECT: 9
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H: Sized {
    type Out: Tr<Self>;
    fn get(&self) -> &Self::Out;
}

struct W {
    r: i64,
}

struct B<T> {
    w: W,
    t: T,
}

impl<T> Tr<B<T>> for W {
    fn g(&self) -> i64 {
        9
    }
}

impl<T> H for B<T> {
    type Out = W;

    fn get(&self) -> &W {
        &self.w
    }
}

fn mid<T: H>(t: &T) -> i64 {
    t.get().g()
}

fn main() {
    println("{}", mid(&B { w: W { r: 0 }, t: 1i64 }));
}
