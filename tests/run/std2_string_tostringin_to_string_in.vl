// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string ToStringIn::to_string_in.
// EXPECT: 42 abc
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let a = 42.to_string_in(gpa);
    let b = "abc".to_string_in(gpa);
    println("{} {}", a, b);
}
