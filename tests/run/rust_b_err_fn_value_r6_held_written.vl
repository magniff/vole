// RULE: R6
// (0.30.2) A local is read as the fn item it holds only when one
// statement writes it, by that item or by a copy of a local that holds
// one: a `let` with no value assigned in two branches, a `match` whose
// arms give two items, a `mut` local written through `&mut`, a copy of
// the parameter into a `mut` local then written, each may hold idr2,
// whose result borrows its argument, and is refused where it is given to
// kl, whose bound's input is the call's own region. A held local read
// through more than one write builds each of these, and --check-alloc
// stops with a use after free (a planted fault of the review of
// g302fnval, its forms h03 and h16, that no case caught). rustc refuses
// them (E0308: mismatched types, one type is more general than the other).
// RUSTC: none main gives idr2 where a `fn(&i64) -> &'static i64` is (a local assigned two fn items, a typed local, F's argument): rustc refuses those types first (E0308), its fn types keep their lifetimes, vole's are erased (R6); the program exists only where that type is erased
// FLAGS: --check-alloc
// ERROR: error[borrowck.fn_value_bound]
// ERROR: line 41, column 8
// ERROR: line 51, column 16
// ERROR: line 56, column 16
// ERROR: line 60, column 16
// ERROR-COUNT: 4
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn kl<K, F: Fn(&i64) -> K>(f: F, gpa: Gpa) -> K {
    let mut l: Vec<i64, Gpa> = Vec::new_in(gpa);
    l.push(4242);
    f(&l[0])
}

fn fw<K, F: Fn(&i64) -> K + Copy>(f: F, fs: &[F], gpa: Gpa) -> K {
    let mut g = f;
    let r = &mut g;
    *r = fs[0];
    kl(g, gpa)
}

fn main(gpa: Gpa) {
    let p;
    if ZST > 3 {
        p = idr2;
    } else {
        p = st;
    }
    let a = kl(p, gpa);
    let q = match ZST {
        5 => idr2,
        _ => st,
    };
    let b = kl(q, gpa);
    let mut s = st;
    let r = &mut s;
    *r = idr2;
    let c = kl(s, gpa);
    let k: fn(&i64) -> &'static i64 = idr2;
    let d = fw::<&'static i64, fn(&i64) -> &'static i64>(st, &[k], gpa);
    println("{} {} {} {}", a, b, c, d);
}
