// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::remove.
// EXPECT: Some(1) None 0
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(7, 1);
    let a = m.remove(&7);
    let b = m.remove(&7);
    println("{:?} {:?} {}", a, b, m.len());
}
