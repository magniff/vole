// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string FromUtf8Error::utf8_error.
// EXPECT: 2 Some(1)
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let r = String::from_utf8(Vec::from_in([97u8, 98, 255], gpa));
    if let Err(e) = r {
        let u = e.utf8_error();
        println("{} {:?}", u.valid_up_to(), u.error_len());
    }
}
