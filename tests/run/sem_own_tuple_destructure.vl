// sem-own: a tuple of owned values destructured by let: each part dropped
// once by its new name, in reverse declaration order.
// EXPECT: 1 2
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    {
        let t = (mk(1, gpa), mk(2, gpa));
        let (a, b) = t;
        println("{} {}", a.id, b.id);
    }
    println("end");
}
