// EDITION: rust
// Runs on std2 since 0.27.3 (front273).
// The std2 item(s): std::convert TryInto::Error.
// EXPECT: err 9
use std::convert::{Infallible, TryFrom};

struct Even {
    v: i64,
}

impl TryFrom<i64> for Even {
    type Error = i64;

    fn try_from(v: i64) -> Result<Even, i64> {
        if v % 2 == 0 { Ok(Even { v: v }) } else { Err(v) }
    }
}

fn main() {
    let r: Result<Even, i64> = 9i64.try_into();
    match r {
        Ok(e) => println("ok {}", e.v),
        Err(x) => println("err {}", x),
    }
}
