// a closure passing a captured var to an inout param, given to an Fn bound
// ERROR: so it is not 'Fn' as the bound of 'F' of 'apply' asks
fn bump(n: &mut i64) { *n += 1; }
fn apply<F: Fn()>(f: &F) { f(); f(); }

fn main() {
    let mut n: i64 = 0;
    apply(|| bump(&mut n));
    println("{n}");
}
