// (0.30.1, review 2) A callee's `where` predicate that asks 'static is
// proven by a concrete caller: `where Option<T>: 'static` with T a
// borrowed str (rustc E0597), `where I::Item: 'static` with I a
// `v.iter()` of a local (E0597), and an impl's function that adds
// `where I::Item: 'static` to a trait's that has none (E0276, here
// refused at the caller through the trait). Before, the first instance
// was unsure and dropped its errors, the others were not compared, and
// each read freed memory on a thread.
// ERROR: borrowck.param_outlives
// ERROR: borrowck.param_outlives
// ERROR: borrowck.param_outlives
// ERROR-COUNT: 3
use std::thread;
use std::fmt::Display;
use std::thread::JoinHandle;

fn f<T: Send + Display>(t: T, gpa: Gpa) -> JoinHandle<i64, Gpa> where Option<T>: 'static {
    thread::spawn_in(move || {
        println("thread {}", t);
        0i64
    }, gpa)
}

fn g<I: Iterator + Send>(i: I, gpa: Gpa) -> JoinHandle<i64,
    Gpa> where I::Item: Display + Send + 'static {
    let mut out: Vec<I::Item, Gpa> = Vec::new_in(gpa);
    for x in i {
        out.push(x);
    }
    thread::spawn_in(move || {
        for x in out.iter() {
            println("thread {}", x);
        }
        0i64
    }, gpa)
}

trait Tr {
    fn f<I: Iterator + Send>(&self, i: I, gpa: Gpa) -> JoinHandle<i64,
        Gpa> where I::Item: Display + Send;
}

struct S;

impl Tr for S {
    fn f<I: Iterator + Send>(&self, i: I, gpa: Gpa) -> JoinHandle<i64,
        Gpa> where I::Item: Display + Send + 'static {
        let mut out: Vec<I::Item, Gpa> = Vec::new_in(gpa);
        for x in i {
            out.push(x);
        }
        thread::spawn_in(move || {
            for x in out.iter() {
                println("thread {}", x);
            }
            0i64
        }, gpa)
    }
}

fn go<X: Tr>(x: &X, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    x.f(v.iter(), gpa)
}

fn main(gpa: Gpa) {
    let h = {
        let st = String::from_in("hello heap string long", gpa);
        f(st.as_str(), gpa)
    };
    h.join();
    let k = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        g(v.iter(), gpa)
    };
    k.join();
    go(&S, gpa).join();
}
