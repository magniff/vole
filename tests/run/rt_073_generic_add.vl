// XFAIL: RT-73: `a + b` (and in generic code) calls S's inherent add, not Add::add (0.30.2)
// rustc prints the EXPECT line; vole 1002 1002 1002.
// EXPECT: 3 3 1002
use std::ops::Add;

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl S {
    fn add(self, o: S) -> S {
        S { k: self.k * 1000 + o.k }
    }
}

impl Add for S {
    type Output = S;

    fn add(self, o: S) -> S {
        S { k: self.k + o.k }
    }
}

fn sum2<T: Add<Output = T>>(a: T, b: T) -> T {
    a + b
}

fn main() -> i32 {
    let a = S { k: 1 };
    let b = S { k: 2 };
    println("{} {} {}", (a + b).k, sum2(a, b).k, a.add(b).k);
    0
}
