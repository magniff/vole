// RULE: D21.3, D21.5 (0.30.2, RT-145) A value of an opaque type moves as
// its hidden type does, and is Copy only when a bound says so (rustc
// E0382 for each): one moved twice, a nested opaque moved twice, one
// moved out of an Option and used, one moved into a Vec and used, and
// one whose hidden closure is Copy but whose bounds do not say so. Each
// is refused as use_moved; a `+ Copy` bound is copied (accepted below).
// ERROR: line 45
// ERROR: line 48
// ERROR: line 52
// ERROR: line 56
// ERROR: line 59
// ERROR-COUNT: 5
fn mk(gpa: Gpa) -> impl Fn() -> usize {
    let s = String::from_in("abc", gpa);
    move || s.len()
}

fn plain(k: i64) -> impl Fn() -> i64 {
    move || k
}

fn copied(k: i64) -> impl Fn() -> i64 + Copy {
    move || k
}

fn inner(gpa: Gpa) -> impl Fn() -> usize {
    mk(gpa)
}

fn outer(gpa: Gpa) -> impl Fn() -> usize {
    inner(gpa)
}

fn take<F: Fn() -> usize>(f: F) -> usize {
    f()
}

fn take_i<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn main(gpa: Gpa) {
    let f = mk(gpa);
    let n = take(f);
    let m = take(f);
    let g = outer(gpa);
    let a = take(g);
    let b = g();
    let o = Some(mk(gpa));
    let h = o.unwrap();
    println("{}", take(h));
    let c = o.is_some();
    let mut v: Vec<_, Gpa> = Vec::new_in(gpa);
    let w = mk(gpa);
    v.push(w);
    println("{}", w());
    let p = plain(3);
    let q = p;
    println("{} {}", p(), q());
    let r = copied(4);
    let t = r;
    println("{} {} {}", take_i(r), take_i(t), r());
    println("{} {} {} {} {}", n, m, a, b, c);
}
