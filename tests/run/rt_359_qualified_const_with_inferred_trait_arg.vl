// XFAIL: RT-359: `let c: i64 = <S as Tr<_>>::C;` is refused ("expected 'i64', got 'bool'" / type.infer); the hole is inferred from the expected type (rustc prints the EXPECT line) (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 7 true
trait Tr<T> {
    const C: T;
}

struct S;

impl Tr<i64> for S {
    const C: i64 = 7;
}

impl Tr<bool> for S {
    const C: bool = true;
}

fn main() {
    let c: i64 = <S as Tr<_>>::C;
    let d: bool = <S as Tr<_>>::C;
    println("{} {}", c, d);
}
