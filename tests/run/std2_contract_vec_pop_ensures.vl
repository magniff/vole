// EDITION: rust
// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): Vec::pop's `ensures self.len() <= old(self.len())`, exercised.
// EXPECT: true false 0
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::from_in([1], gpa);
    let a = v.pop();
    let b = v.pop();
    println("{} {} {}", a.is_some(), b.is_some(), v.len());
}
