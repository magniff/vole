use std::collections::{HashSet, hash_set};

fn main(gpa: Gpa) {
    let s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    let a: &Gpa = s.allocator();
    let mut t: HashSet<i64, &Gpa> = HashSet::new_in(a);
    t.insert(1);
    println("{}", t.len());
}
