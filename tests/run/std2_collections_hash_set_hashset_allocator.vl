// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet::allocator.
// EXPECT: 1
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    let a: &Gpa = s.allocator();
    let mut t: HashSet<i64, &Gpa, FixedState> = HashSet::new_in(a);
    t.insert(1);
    println("{}", t.len());
}
