// XFAIL: RT-315: `v.iter().fold(0, |s, x| s + x)` over a Vec<i64> is refused, "expected 'i32', got '&i64'": the init literal is typed i32 before `s + x` (i64: Add<&i64>) says B is i64 (0.30.2)
// rustc accepts it and prints the EXPECT line. Since v0.28.0 (v0.30.1 and
// the release build the same). The integer-default family (RT-286), from
// red team round 7's notes.
// EXPECT: 3000000004
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3000000000);
    v.push(4);
    let s = v.iter().fold(0, |s, x| s + x);
    println("{}", s);
}
