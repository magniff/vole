// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a06_struct_int_addr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A struct holding an address as usize: the callee writes through it.
struct H { addr: usize }

fn poke(h: &H) -> bool {
    let p = h.addr as *mut i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(h: H) -> i64
    requires poke(&h)
{
    1
}

fn main() {
    let mut x = 1i64;
    let h = H { addr: &raw mut x as usize };
    println("{}", f(h));
    println("{}", x);
}
