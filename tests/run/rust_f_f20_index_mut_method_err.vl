// EDITION: rust
// RULE: F20.6, F20.4
// (0.27.5) A type with Index and no IndexMut keeps `index`: a `&mut self`
// method on its index place borrows through the `&` it returns (rustc
// E0596).
// ERROR: error[borrowck.borrow_immutable]:
use std::alloc::Allocator;
use std::ops::Index;

struct Ro<A: Allocator> {
    v: Vec<Vec<i64, A>, A>,
}

impl<A: Allocator> Index<usize> for Ro<A> {
    type Output = Vec<i64, A>;

    fn index(&self, i: usize) -> &Vec<i64, A> {
        &self.v[i]
    }
}

fn main(gpa: Gpa) {
    let mut r = Ro { v: Vec::new_in(gpa) };
    r.v.push(Vec::new_in(gpa));
    r[0].push(1);
    println("{}", r[0].len());
}
