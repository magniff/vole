// EDITION: rust
// sem-own: matching an owned enum local by value moves the payload into the
// binding; dropped once, at the arm's end.
// EXPECT: some 5
// EXPECT: drop 5
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

enum E<A: Allocator> { A(D<A>), B(i64), C { d: D<A>, n: i64 } }

fn main(gpa: Gpa) {
    let e = E::A(mk(5, gpa));
    match e {
        E::A(d) => println("some {}", d.id),
        E::B(n) => println("b {n}"),
        E::C { d, n } => println("c {}", d.id),
    }
    println("end");
}
