// EDITION: rust
// The std2 item(s): std::convert TryInto.
// EXPECT: 8 -1
use std::convert::{Infallible, TryFrom, TryInto};

struct Even {
    v: i64,
}

impl TryFrom<i64> for Even {
    type Error = i64;

    fn try_from(v: i64) -> Result<Even, i64> {
        if v % 2 == 0 { Ok(Even { v: v }) } else { Err(v) }
    }
}

fn half<T: TryInto<Even>>(x: T) -> i64 {
    match x.try_into() {
        Ok(e) => e.v,
        Err(_) => -1,
    }
}

fn main() {
    println("{} {}", half(8i64), half(7i64));
}
