// (0.26.3) alloc.static (rule 1): a static's type may not hold an
// allocator (AllocFree), looking through its fields, payloads, tuples,
// arrays and pointers: any function could allocate through it with
// nothing in its signature saying so. No fix: the value moves into main.
// ERROR: error[alloc.static]: the static 'NAMES' holds an allocator, 'Gpa' (in its type 'Option<Vec<i64, Gpa>>'): a static's type may not hold one
// ERROR: help: any function could allocate through it with nothing in its signature saying so: keep the value in main and pass it down (or what it allocates, as a slice)
// ERROR: error[alloc.static]: the static 'HELD' holds an allocator, 'Gpa' (in its type '*Holder<Gpa>')
// ERROR: error[alloc.static]: the static 'THROUGH' holds an allocator, 'Gpa' (in its type '*Vec<i64, Gpa>')
// ERROR: error[alloc.static]: the static 'BARE' holds an allocator, 'Gpa' (in its type '*Gpa')
// ERROR-COUNT: 4
struct Holder<A: Allocator> {
    v: Vec<i64, A>,
}

// (set at run time from main's gpa: the hole rule 1 closes)
static var NAMES: Option<Vec<i64, Gpa>> = None;
static var HELD: *Holder<Gpa> = 0 as *Holder<Gpa>;
static var THROUGH: *Vec<i64, Gpa> = 0 as *Vec<i64, Gpa>;
static var BARE: *Gpa = 0 as *Gpa;
// (AllocFree: integers, arrays, slices of them, plain structs)
static var COUNTS: [i64; 4] = [0; 4];
static WORDS: [[u8]; 2] = ["a", "b"];

fn main() {}
