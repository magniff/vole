// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe access after free: 1 bytes at offset 0 of a block of 16 bytes
// 0.30.1: free through a fn pointer is the check's free (the block held,
// counted freed), as a call of free is: the use after it is reported.
// (Earlier on 0.30.1's branch the pointer was C's own free, and the read
// of the memory C had back ran.)
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn free(p: *mut u8);
}

fn main() {
    // UNSAFE: deliberately after the free.
    // SAFETY: none: the program exists to be stopped.
    unsafe {
        let p = malloc(16);
        *p = 5;
        let f: unsafe extern "C" fn(*mut u8) = free;
        f(p);
        println("after free {}", *p);
    }
}
