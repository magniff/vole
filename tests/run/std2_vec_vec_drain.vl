// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::vec Vec::drain.
// EXPECT: [2, 3] [1, 4, 5]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3, 4, 5], gpa);
    let d: Vec<i64, Gpa> = v.drain(1..3).collect_in(gpa);
    println("{:?} {:?}", d, v);
}
