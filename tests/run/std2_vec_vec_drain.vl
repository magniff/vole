// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::drain.
// EXPECT: [2, 3] [1, 4, 5]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2, 3, 4, 5], gpa);
    let d: Vec<i64, Gpa> = v.drain(1..3).collect_in(gpa);
    println("{:?} {:?}", d, v);
}
