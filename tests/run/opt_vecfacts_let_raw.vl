// EXPECT: launder 15 10
// EXPECT: helper 15 10
// EXPECT: kept 4 4
// EXPECT: other 4950 20
// EXPECT: string 532 5
// EXPECT: mutex 8 8
// FLAGS: --check-alloc
// (0.25.4) A let parameter's Vec and raw pointers. While a Vec is lent
// let, nothing may change it, a raw pointer included (guide unsafe): the
// optimizer keeps its ptr, len and cap from before a loop (middle::
// vecfacts, fact 1), so a callee that pushes to the caller's Vec through
// a raw pointer it keeps breaks that rule, and the function may not see
// the push. Outside that rule too, but seen: a function that makes a
// raw pointer of its own let parameter (`&v as *Vec<i64>`, accepted in
// unsafe code) and pushes through it, inlined or not, or truncates it
// through a static it keeps the pointer in, sees the change (the fact holds only for
// a parameter the function never writes through nor passes on: the
// optimizer sees the function's own code). Within the rule: a callee
// that changes another Vec through a raw pointer changes nothing of the
// parameter; a String's bytes (a sealed std struct around a Vec) read in
// a loop. A Mutex<Vec<i64>> lent let, locked and pushed to in a loop
// (`locked`): a behaviour check only. It cannot catch fact 1 following a
// Mutex (sealed since 0.25.4): every read of a Mutex's data locks it,
// and the lock's compare-exchange on the parameter is a use other than a
// read (param_written), so the fact is off for the function either way
// (the same code from 0.25.4 before and after the narrowing).
use std::sync::Mutex;

static var P: *Vec<i64> = 0 as *Vec<i64>;

#[inline(never)]
fn launder(v: Vec<i64>) -> i64 {
    let p = &v as *Vec<i64>;
    var i = 0;
    var s = 0;
    while i < v.len() as i64 {
        if i < 5 {
            // UNSAFE: v's push through its raw pointer.
            // SAFETY: p points to the caller's Vec, which has no other
            // access during the call.
            unsafe { (*p).push(i); }
        }
        s += v[i];
        i += 1;
    }
    s
}

#[inline(never)]
fn push_raw(p: *Vec<i64>, x: i64) {
    // UNSAFE: a push through a raw pointer.
    // SAFETY: the caller's p points to a live Vec.
    unsafe { (*p).push(x); }
}

#[inline(never)]
fn helper(v: Vec<i64>) -> i64 {
    let p = &v as *Vec<i64>;
    var i = 0;
    var s = 0;
    while i < v.len() as i64 {
        if i < 5 {
            push_raw(p, i);
        }
        s += v[i];
        i += 1;
    }
    s
}

static var Q: *Vec<i64> = 0 as *Vec<i64>;

#[inline(never)]
fn kept(v: Vec<i64>) -> i64 {
    // UNSAFE: v's address kept in a static.
    // SAFETY: Q is used only during this call.
    unsafe { Q = &v as *Vec<i64>; }
    var i = 0;
    var s = 0;
    while i < v.len() as i64 {
        if i == 2 {
            // UNSAFE: v's truncate through the static (no call: only its
            // length is written).
            // SAFETY: Q points to the caller's Vec, live.
            unsafe { (*Q).truncate(4); }
        }
        s += v[i];
        i += 1;
    }
    s
}

#[inline(never)]
fn bump(x: i64) {
    // UNSAFE: the other Vec, through P.
    // SAFETY: P points to main's Vec w, live, not v.
    unsafe { (*P).push(x); }
}

#[inline(never)]
fn other(v: Vec<i64>) -> i64 {
    var s = 0;
    for i in 0..v.len() {
        s += v[i];
        if i % 5 == 0 {
            bump(i as i64);
        }
    }
    s
}

#[inline(never)]
fn bytes_sum(s: String) -> i64 {
    var t = 0;
    for i in 0..s.bytes.len() {
        t += s.bytes[i] as i64;
    }
    t
}

#[inline(never)]
fn locked(m: Mutex<Vec<i64>>) -> i64 {
    var i = 0;
    var s = 0;
    while i < m.with(|v| v.len() as i64) {
        if i < 3 {
            m.with(|v| v.push(i));
        }
        s += m.with(|v| v[i]);
        i += 1;
    }
    s
}

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..5 {
        a.push(1);
    }
    let r = launder(a);
    println("launder {r} {}", a.len());
    var b: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..5 {
        b.push(1);
    }
    let h = helper(b);
    println("helper {h} {}", b.len());
    var k: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..10 {
        k.push(1);
    }
    let kk = kept(k);
    println("kept {kk} {}", k.len());
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    // UNSAFE: a raw pointer to w kept in a static, for bump.
    // SAFETY: w outlives every call of bump.
    unsafe { P = &w as *Vec<i64>; }
    println("other {} {}", other(v), w.len());
    var st = String::new_in(gpa);
    st.push_str("hello");
    println("string {} {}", bytes_sum(st), st.len());
    var mv: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..5 {
        mv.push(1);
    }
    let m = Mutex::new(mv);
    let ms = locked(m);
    println("mutex {ms} {}", m.with(|v| v.len()));
}
