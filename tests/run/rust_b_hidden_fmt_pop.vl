// RULE: D2.9
// (0.30.1) `println("{:?} {:?}", v, v.pop())`: the first hole borrows v
// to the end of the call, so the pop's `&mut v` is E0502 (vole's
// conflict) at the receiver. Before, the hole was a copy of v's words
// taken before the pop and printed `[1, 2, 3] Some(3)`.
// ERROR: error[borrowck.conflict]
// ERROR: line 15, column 29
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let _ = 0;
    println("{:?} {:?}", v, v.pop());
}
