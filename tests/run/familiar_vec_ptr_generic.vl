// 0.17 (decided 2026-10-16): `p[i]` means what p's type, as written, says.
// Where p points to a type parameter (`p: *T`, a field `*T`, `x as *T`,
// a local from one), it is pointer arithmetic in every instance, T = Vec
// as T = i64: a generic body means one thing for every T. A pointer
// written to a Vec (`*Vec<T>`) indexes the Vec.
// (0.29) What such a read gives is the caller's value, as any call's
// result: a Vec read out of vs is a second owner of its buffer, so the
// case forgets it (`len_of`); a temporary of it would be dropped at the
// end of its statement, and vs would free the buffer again. (Until 0.29
// a generic result's temporary was taken for a copy and not dropped,
// which leaked every `dup(&t).v`: drop_temp_generic_result.)
// FLAGS: --check-alloc
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 3 8
// EXPECT: 1 7
#[derive(Clone, Copy)] struct Arr<T> { p: *mut T }

fn second<T>(p: *mut T) -> T { unsafe { (*p.add(1)) } }

fn second_mut<T>(p: *mut T) -> T { unsafe { (*p.add(1)) } }

fn second_field<T>(a: Arr<T>) -> T { unsafe { (*a.p.add(1)) } }

fn second_local<T>(q: *mut T) -> T {
    let r = q;
    unsafe { (*r.add(1)) }
}

fn second_cast<T>(x: *mut u8) -> T { unsafe { (*(x as *mut T).add(1)) } }

fn len_of(v: Vec<i64, Gpa>) -> usize {
    let n = v.len();
    std::mem::forget(v);
    n
}

fn head<T>(v: &Vec<T, Gpa>) -> T { v[0] }

fn main(gpa: Gpa) -> i32 {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    b.push(2);
    b.push(4);
    b.push(6);
    let mut vs = [a, b];
    let mut xs = [7i64, 8, 9];
    println("{} {}", len_of(second(&mut vs[0])), second(&mut xs[0]));
    println("{} {}", len_of(second_mut(&mut vs[0])), second_mut(&mut xs[0]));
    println("{} {}", len_of(second_field(Arr { p: &mut vs[0] })),
        second_field(Arr { p: &mut xs[0] }));
    println("{} {}", len_of(second_local(&mut vs[0])),
        unsafe { second_cast::<i64>(&raw const xs[0] as *mut u8) });
    println("{} {}", len_of(unsafe { second_cast::<Vec<i64, Gpa>>(&raw const vs[0] as *mut u8) }),
        second_local(&mut xs[0]));
    let mut c: Vec<i64, Gpa> = Vec::new_in(gpa);
    c.push(7);
    println("{} {}", head(&vs[0]), head(&c));
    0
}
