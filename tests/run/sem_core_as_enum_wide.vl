// An i64 whose low byte is a valid discriminant is still not one.
// EXIT: 101
// STDERR: invalid value 261 for enum Level
static mut Z: i64 = 0;

#[derive(Clone, Copy, PartialEq, Eq)] #[repr(u8)]
enum Level { Low = 1, Mid = 5, High = 9 }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let v = 256 + 5 + unsafe { Z }; // low byte 5
    let l = v as Level;
    println("not reached {}", l as i64);
    0
}
