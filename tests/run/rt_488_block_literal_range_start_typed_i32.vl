// XFAIL: RT-488: `for i in { 0 }..unsafe { a } << 1` with `a: i64` is refused, "expected 'i32', got 'i64'": the literal in the block `{ 0 }` is typed i32 before the range's end says i64 (`let r = { 0 }..a;` is refused the same way); rustc prints `i 9` and `j 9` (0.30.2)
// From the third re-review of the qualified-path work (g302qual). Since v0.30.1 at least.
// From the review's form c1/a25_labeled_for_head; the first loop, with
// `0..(unsafe { a } << 1)`, is accepted.
// EXPECT: i 9
// EXPECT: j 9
trait Tr {
    type Out;
    fn f(x: i64) -> i64;
}

struct S {
    a: i64,
}

impl Tr for S {
    type Out = S;

    fn f(x: i64) -> i64 {
        println("f {}", x);
        x + 1
    }
}

fn main() {
    let a: i64 = 5;
    'o: for i in 0..(unsafe { a } << 1) {
        if i > 8 {
            println("i {}", i);
            break 'o;
        }
    }
    'p: for i in { 0 } ..unsafe { a } << 1 {
        if i > 8 {
            println("j {}", i);
            break 'p;
        }
    }
}
