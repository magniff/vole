// XFAIL: RT-212: (fuller form of R302D-34) with `trait Tag` implemented for W (1) and for &W (2), a generic body's `self.v.tag()` and `p.0.tag()` with T = &W run W's impl, not &W's (0.30.2)
// rustc prints `2 2 2 2 0` (twin: r302d_034b_generic_place_method_picks_impl_for_target.rs.txt):
// the bound T: Tag is &W's impl in every form. vole prints `2 2 1 1 0`: a plain
// parameter (`plain`, `by_ref`) is right, a field and a tuple field take the
// instance's probe (W's `tag(&self)` matches the place type &W at the first
// step). Not Clone-specific: any trait implemented for both W and &W.
// Since v0.28.0; g302probe the same.
// EXPECT: 2 2 2 2 0
struct W {
    k: i64,
}

trait Tag {
    fn tag(&self) -> i64;
}

impl Tag for W {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a W {
    fn tag(&self) -> i64 {
        2
    }
}

struct Rep<T> {
    v: T,
}

fn plain<T: Tag>(t: T) -> i64 {
    t.tag()
}

fn by_ref<T: Tag>(t: &T) -> i64 {
    t.tag()
}

impl<T: Tag> Rep<T> {
    fn field(&self) -> i64 {
        self.v.tag()
    }
}

fn tuple<T: Tag>(p: (T, i64)) -> i64 {
    p.0.tag()
}

fn main() {
    let w = W { k: 0 };
    let r = Rep { v: &w };
    println("{} {} {} {} {}", plain(&w), by_ref(&&w), r.field(), tuple((&w, 0i64)), w.k);
}
