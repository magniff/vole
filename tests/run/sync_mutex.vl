// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::sync::Mutex'
// (0.21) std::sync::Mutex under contention: four scoped threads add to the
// data with `with` (two Mutexes, borrowed); the totals are exact. try_with
// on a held lock gives None; the guard (unsafe in 0.21.0) unlocks when it
// is dropped.
// EXPECT: 40000 40000
// EXPECT: busy true

use std::thread;
use std::sync::Mutex;

fn main(gpa: Gpa) {
    let m: Mutex<Vec<i64, Gpa>> = Mutex::new(Vec::new_in(gpa));
    let c = Mutex::new(0i64);
    thread::scope(|s| ({ let s = s; {
        for _ in 0..4 {
            s.spawn(|| {
                for i in 0..10000 {
                    m.with(|v| v.push(i));
                    c.with(|n| *n += 1);
                }
                0
            });
        }
        0
    } }));
    let len = m.with(|v| v.len());
    println("{len} {}", c.with(|n| *n));
    let busy = unsafe {
        let g = c.lock();
        let r = c.try_with(|n| *n).is_none();
        drop(g);
        r && c.try_with(|n| *n).is_some()
    };
    println("busy {busy}");
}
