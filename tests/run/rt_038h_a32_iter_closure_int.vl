// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a32_iter_closure_int)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'Iter<i64>::all<closure(&i64) -> bool
// A clause iterates its own array with a closure whose callee writes through an address param.
fn poke(addr: usize) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *(addr as *mut i64) += 1; }
    true
}

fn f(addr: usize) -> i64
    requires {
    let a = [1i64, 2, 3];
    a.iter().all(|x: &i64| *x > 0 && poke(addr))
}

{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x as usize));
    println("{}", x);
}
