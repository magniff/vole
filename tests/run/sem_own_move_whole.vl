// EDITION: rust
// sem-own: a whole move: the moved-to name owns, the old one is not dropped.
// EXPECT: b 1
// EXPECT: c 1
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    {
        let a = mk(1, gpa);
        let b = a;
        println("b {}", b.id);
        let mut c = b;
        println("c {}", c.id);
    }
    println("end");
}
