fn apply<F: Fn() -> i64>(x: &mut Vec<i64, Gpa>, f: F) -> i64 { x.clear(); f() }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let r = apply(&mut v, || v.len() as i64);
    println("{r}");
}
