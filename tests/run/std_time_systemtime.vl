// The std item(s): std::time SystemTime; std::time SystemTime::now; std::time SystemTime::duration_since; std::time SystemTime::elapsed; std::time SystemTime::checked_add; std::time SystemTime::checked_sub; std::time SystemTime::impl Add; std::time SystemTime::impl AddAssign; std::time SystemTime::impl Sub; std::time SystemTime::impl SubAssign; std::time UNIX_EPOCH; std::time SystemTimeError; std::time SystemTimeError::duration; std::time SystemTimeError::impl Display.
// EXPECT: true true
// EXPECT: 5s second time provided was later than self 5s
// EXPECT: SystemTimeError(5s) true
use std::time::{Duration, SystemTime, UNIX_EPOCH};

fn main() {
    let now = SystemTime::now();
    let since = now.duration_since(UNIX_EPOCH).unwrap();
    println("{} {}", since.as_secs() > 1700000000, now.elapsed().is_ok());
    let five = UNIX_EPOCH + Duration::from_secs(5);
    let e = UNIX_EPOCH.duration_since(five).unwrap_err();
    println("{:?} {} {:?}", five.duration_since(UNIX_EPOCH).unwrap(), e, e.duration());
    let mut t = five;
    t -= Duration::from_secs(1);
    t += Duration::from_secs(1);
    println("{:?} {}", e, t == five && five.checked_sub(Duration::from_secs(5)) == Some(UNIX_EPOCH)
        && UNIX_EPOCH.checked_add(Duration::from_secs(5)) == Some(five)
        && five - Duration::from_secs(5) == UNIX_EPOCH);
}
