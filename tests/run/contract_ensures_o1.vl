// EDITION: rust
// XFAIL: gap 17: compile contract.effect: the 'ensures' of 'quarter' calls 'Option<i64>::unwrap', which does io: a condition...
// (0.18) An ensures is checked at every return of the function (the tail,
// `return`, `?`), on the value returned (`result`); `old(e)` is e at
// entry. Its failure blames the function, at the clause.
// FLAGS: -O1
// EXIT: 101
// EXPECT: 4
// EXPECT: 3
// EXPECT: 2
// STDERR: contract_ensures_o1.vl:24:5: ensures failed: 'result <= n' of 'count_up': result = 9, n = 8

#[derive(Clone, Copy)] struct Counter { n: i64 }

fn bump(c: &mut Counter, by: i64) -> i64
    ensures c.n == old(c.n) + by
    ensures result == c.n
{
    unsafe { c.n += by; c.n }
}

fn count_up(n: i64) -> i64
    ensures 0 <= result
    ensures result <= n
{
    if n > 7 {
        return n + 1;
    }
    n
}

fn half(x: i64) -> Option<i64>
    ensures result.is_some() || x % 2 == 1
{
    if x % 2 == 1 {
        return None;
    }
    Some(x / 2)
}

fn quarter(x: i64) -> Option<i64>
    ensures !result.is_some() || result.unwrap() * 4 <= x
{
    let h = half(x)?;
    half(h)
}

fn main() -> i32 {
    let mut c = Counter { n: 1 };
    bump(&mut c, 3);
    print("{}", bump(&mut c, 0));
    println("");
    print("{}", count_up(3));
    println("");
    print("{}", quarter(8).unwrap());
    println("");
    let _ = quarter(6);
    print("{}", count_up(8));
    0
}
