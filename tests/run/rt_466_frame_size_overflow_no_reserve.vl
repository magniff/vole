// XFAIL: RT-466: UNSOUND: a frame whose size overflows i64, one local `[0u8; 1usize << 63]` in a branch not taken, gets no stack reserve, so the frame's slots are addressed above sp: -O0 panics in std ("attempt to subtract with overflow", exit 101), -O2 faults (SIGBUS, exit 138) after "before"; rustc refuses the type (too big for the target) (0.30.2)
// From g302probes (its form one63). Since v0.30.1 at least (v0.30.1 and
// the release build the same). g302std's 6986b630d fixes it (not on
// this branch yet). rustc refuses the type: "values of the type `[u8;
// 9223372036854775808]` are too big for the target architecture".
// ERROR: line 11
// one local of 2^63 bytes: a frame whose size is negative as i64
#[inline(never)]
fn one(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 1usize << 63];
        return a[n];
    }
    println("inside");
    0
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", one(n));
}
