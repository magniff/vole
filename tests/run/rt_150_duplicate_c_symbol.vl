// XFAIL: RT-150: two exported C functions with one symbol reach the assembler: "internal error: cannot assemble: label defined twice", not a diagnostic (0.30.2)
// From g302raw (pre-existing, v0.30.1 too). rustc refuses two #[no_mangle]
// items with one symbol ("symbol `helper` is already defined"). g302raw
// catches only `main` (main.symbol); every other symbol is unchecked.
// ERROR: line 14
// ERROR-COUNT: 1
mod a {
    pub extern "C" fn helper() -> i64 {
        1
    }
}

mod b {
    pub extern "C" fn helper() -> i64 {
        2
    }
}

fn main() {
    println("{} {}", a::helper(), b::helper());
}
