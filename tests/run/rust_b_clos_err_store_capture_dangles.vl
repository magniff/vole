// EDITION: rust
// RULE: D19.10
// (0.27.2) The closure's requirement (`r`'s referent outlives `h.p`'s) is
// checked where the closure is made: `b` does not live as long as `h`
// (rustc E0597).
// ERROR: error[borrowck.dropped_borrowed]
struct H<'a> {
    p: &'a i64,
}

fn main() {
    let a = 1;
    let mut h = H { p: &a };
    {
        let b = 2;
        let r = &b;
        let mut f = || {
            h.p = r;
        };
        f();
    }
    println("{}", *h.p);
}
