// usize is not u64, nor isize i64 (0.26.2): the same 64 bits, but types
// of their own, as in Rust; only widening is implicit, and these convert
// by `as`.
// ERROR: expected 'u64', got 'usize'
// ERROR: try: a as u64
// ERROR: expected 'isize', got 'i64'
// ERROR: try: b as isize
// ERROR: expected 'usize', got 'u64'
// ERROR-COUNT: 3
fn take_u64(x: u64) -> u64 {
    x
}

fn take_isize(x: isize) -> isize {
    x
}

fn main() {
    let a: usize = 5;
    take_u64(a);
    let b: i64 = 3;
    take_isize(b);
    let c: u64 = 4;
    let x = a + c;
}
