// 0.17: `v.len` on a Vec reads as `v.len()`, but it is no place: writing
// it, or taking its address (0.20: `&v.len as *i64`), is the private
// field's error, and a compound assignment to it is no assignment target.
// ERROR: error[field.private]: field 'len' of 'Vec<i64>' is private to module 'std'
// ERROR: help: use the methods of 'Vec'
// ERROR: field 'len' of 'Vec<i64>' is private to module 'std'
// ERROR: invalid assignment target
// ERROR-COUNT: 3
fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.len = 0;
    let p = &v.len as *i64;
    v.len += 1;
}
