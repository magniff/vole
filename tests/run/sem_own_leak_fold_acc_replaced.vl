// sem-own: (0.25.3) a fold whose closure drops its accumulator by returning a new one.
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let r = (0..2).fold(mk(0, gpa), |a, i| mk(i + 1, gpa));
    println("end");
}
