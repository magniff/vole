// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.moved: p used after `let p2 = p`
// ERROR: error[own.moved]
struct P<A: Allocator> { q: inout Vec<i64, A> }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    var p = P { q: &v };
    let p2 = p;
    p.q.push(1);
    println(p2.q.len());
    0
}
