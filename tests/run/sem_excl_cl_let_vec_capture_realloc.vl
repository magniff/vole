// EDITION: rust
// an owned var passed let while a closure argument reallocates it: the let access dangles
// ERROR: error[borrowck.conflict]
fn f<F: FnMut()>(p: &Vec<i64, Gpa>, mut w: F) -> i64 { let s = p.as_slice(); w(); s[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1);
    let r = f(&v, || { v.clear(); for i in 0..1000 { v.push(i + 7); } });
    println("{r} {}", v.len());
}
