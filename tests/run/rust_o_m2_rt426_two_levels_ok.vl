// EXPECT: 300
// (RT-426) through two supertraits, `trait Top: Mid`, `trait Mid: Tr`,
// with another trait's Out on the type: Tr's (v0.30.1: ambiguous).
trait Tr2 {
    type Out;
}

trait Tr {
    type Out;
    fn get(&self) -> Self::Out;
}

trait Mid: Tr {}

trait Top: Mid {}

struct W {
    a: i64,
}

impl Tr2 for W {
    type Out = u8;
}

impl Tr for W {
    type Out = i64;

    fn get(&self) -> i64 {
        self.a
    }
}

impl Mid for W {}

impl Top for W {}

fn f<T: Top>(t: &T) -> T::Out {
    t.get()
}

fn main() {
    println("{}", f(&W { a: 300 }));
}
