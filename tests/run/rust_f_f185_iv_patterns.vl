// RULE: F18.5
// (0.30.2) Literal and range patterns against an integer variable are of
// its type: a later u8 use types `y` u8, and `-5` matched as an i64.
// EXPECT: two hundred
// EXPECT: neg -5000000000
fn take_u8(x: u8) -> u8 {
    x
}

fn take(x: i64) -> i64 {
    x
}

fn main() {
    let y = 200;
    match y {
        0..=9 => println("small"),
        200 => println("two hundred"),
        _ => println("other"),
    }
    take_u8(y);
    let neg = -5;
    match neg {
        -10..=-1 => println("neg {}", take(neg * 1000000000)),
        _ => println("other"),
    }
}
