// (0.29.0) The temporaries of an `if let` scrutinee are dropped before the
// `else` block, and on a match at the end of the matching block: rustc's
// rule from its 2024 edition (the edition guide's "if let temporary
// scope"; before it, and in vole until 0.28.0, after the whole `if let ..
// else`). So are a temporary lent to the scrutinee's call, what the
// pattern leaves of the scrutinee's own value, and both inside a longer
// statement (before its other temporaries). A `match` keeps its
// temporaries to the end of its statement. The output is rustc 2024's
// (tools/rustc-twin.sh).
// RUSTC-EDITION: 2024
// EXPECT: lent 1
// EXPECT: d1
// EXPECT: else 0
// EXPECT: d3
// EXPECT: after
// EXPECT: lent 9
// EXPECT: some 9 0
// EXPECT: d2
// EXPECT: d1
// EXPECT: after
// EXPECT: value 1
// EXPECT: d4
// EXPECT: else
// EXPECT: after
// EXPECT: value 9
// EXPECT: ok 4
// EXPECT: d4
// EXPECT: after
// EXPECT: inner 1
// EXPECT: d5
// EXPECT: else
// EXPECT: d6
// EXPECT: after 1
// EXPECT: inner 9
// EXPECT: then
// EXPECT: d5
// EXPECT: d6
// EXPECT: after 10
// EXPECT: bare 1
// EXPECT: d7
// EXPECT: after
// EXPECT: bare 9
// EXPECT: d7
// EXPECT: after
// EXPECT: 9
// EXPECT: match 1
// EXPECT: none
// EXPECT: d8
// EXPECT: after
// EXPECT: match 9
// EXPECT: some 9
// EXPECT: d8
// EXPECT: after
struct T {
    id: i64,
    v: i64,
}

fn mk(id: i64, v: i64) -> T {
    T { id: id, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn big(t: &T) -> Option<i64> {
    if t.v > 5 { Some(t.v) } else { None }
}

fn own(t: T) -> Result<T, T> {
    if t.v > 5 { Ok(t) } else { Err(t) }
}

fn two(a: i64, b: &T) -> i64 {
    a + b.v
}

// A temporary lent to the scrutinee's call.
fn lent(v: i64) {
    println("lent {v}");
    if let Some(n) = big(&mk(1, v)) {
        let l = mk(2, 0);
        println("some {n} {}", l.v);
    } else {
        let l = mk(3, 0);
        println("else {}", l.v);
    }
    println("after");
}

// The scrutinee's own value: what the pattern does not move out of it.
fn value(v: i64) {
    println("value {v}");
    if let Ok(t) = own(mk(4, v)) {
        println("ok {}", t.id);
    } else {
        println("else");
    }
    println("after");
}

// Inside a longer statement: before the statement's other temporaries.
fn inner(v: i64) {
    println("inner {v}");
    let r = two(
        if let Some(n) = big(&mk(5, v)) {
            println("then");
            n
        } else {
            println("else");
            0
        },
        &mk(6, 1),
    );
    println("after {r}");
}

// No `else`: the same place, the end of the `if let`.
fn bare(v: i64) -> i64 {
    println("bare {v}");
    let mut r = 0;
    if let Some(n) = big(&mk(7, v)) {
        r = n;
    }
    println("after");
    r
}

// A `match` keeps its temporaries to the end of its statement.
fn matched(v: i64) {
    println("match {v}");
    match big(&mk(8, v)) {
        Some(n) => println("some {n}"),
        None => println("none"),
    }
    println("after");
}

fn main() -> i32 {
    lent(1);
    lent(9);
    value(1);
    value(9);
    inner(1);
    inner(9);
    println("{}", bare(1) + bare(9));
    matched(1);
    matched(9);
    0
}
