// RULE: C3.4
// (0.30.2, RT-38f) An alias of an alias, written in a block of the
// ensures' condition itself: the clause changed `*p`, and so its own
// verdict (0.30.1: ensures failed, the caller's value 9).
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*p'
// ERROR-COUNT: 1
type R<'a> = &'a mut i64;
type R2<'a> = R<'a>;

fn f(p: R2 < '_ >) -> i64
    ensures old(*p) + 1 == {
    *p = 9;
    *p
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
