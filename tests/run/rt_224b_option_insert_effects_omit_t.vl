// XFAIL: RT-224b: `Option::insert` is declared #[effects(panic)] without T, so inserting over a Some whose value's Drop does io is refused inside std: "'Option::insert' is #[effects(panic)], but it does io: .. calls 'L::drop'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). get_or_insert_with, replace,
// take, take_if and the other std methods that drop a T (ef/e1.vl, e2.vl) are
// declared with T and build.
// EXPECT: drop 1
// EXPECT: now 2
// EXPECT: drop 2
struct L {
    n: i64,
}

impl Drop for L {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main() {
    let mut o = Some(L { n: 1 });
    let r = o.insert(L { n: 2 });
    println("now {}", r.n);
}
