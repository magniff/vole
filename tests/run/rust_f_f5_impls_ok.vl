// RULE: F5.3
// Several inherent impls of one type, also of a generic one, with
// disjoint method names; a trait's method may share an inherent one's
// name (the inherent one is what `x.m()` calls).
// EXPECT: 3 4 7
// EXPECT: 9
trait Show {
    fn get(&self) -> i64;
}

struct S {
    a: i64,
}

impl S {
    fn get(&self) -> i64 {
        self.a
    }
}

impl S {
    fn twice(&self) -> i64 {
        self.a + 1
    }
}

impl Show for S {
    fn get(&self) -> i64 {
        100
    }
}

struct W<T> {
    v: T,
    n: i64,
}

impl<T> W<T> {
    fn n(&self) -> i64 {
        self.n
    }
}

impl<T> W<T> {
    fn more(&self) -> i64 {
        self.n * 3
    }
}

fn main() {
    let s = S { a: 3 };
    let w = W { v: 1u8, n: 3 };
    println("{} {} {}", s.get(), s.twice(), s.get() + s.twice());
    println("{}", w.n() + w.more() - 3);
}
