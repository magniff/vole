// RULE: D3.6, R6
// (0.27.2) The result of a call through a `fn` value lives as long as its
// argument does: used while `v` lives, it is accepted.
// EXPECT: 1 2
fn id(x: &i64) -> &i64 {
    x
}

fn first(x: &i64, y: &i64) -> i64 {
    *x + *y - *y
}

fn main() {
    let f: fn(&i64) -> &i64 = id;
    let g: fn(&i64, &i64) -> i64 = first;
    let v = 1;
    let r = f(&v);
    let w = 2;
    println("{} {}", *r, g(&v, &w) + 1);
}
