// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 2 (an inout projection, written through)
// EXPECT: 2
fn top(v: &mut Vec<i64, Gpa>) -> &mut i64 { &mut v[0] }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let t = top(&mut v);
    *t += 1;
    println("{}", v[0]);
    0
}
