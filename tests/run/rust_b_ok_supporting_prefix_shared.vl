// EDITION: rust
// RULE: D1.3
// (0.27.1) `&**r` through `&'a &'b i64`: the supporting prefixes stop at the
// shared deref, so the result lives for `'b`.

fn f<'a, 'b>(r: &'a &'b i64) -> &'b i64 {
    &**r
}

fn main() {
    let x: i64 = 4;
    let rx = &x;
    let y = f(&rx);
    println("{}", *y);
}
// EXPECT: 4
