// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_set HashSet::with_capacity_in.
// EXPECT: 0 true
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let s: HashSet<i64, Gpa, FixedState> = HashSet::with_capacity_in(10, gpa);
    println("{} {}", s.len(), s.capacity() >= 10);
}
