// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Pattern::next_match.
// EXPECT: Some((1, 2)) Some((3, 4)) None Some((1, 3))
// RUSTC: none (Rust's Pattern is unstable)
use std::str::Pattern;

fn main() {
    let mut c = ',';
    let mut s = "bc";
    println("{:?} {:?} {:?} {:?}", c.next_match("a,b,c", 0), c.next_match("a,b,c", 3),
        c.next_match("abc", 0), s.next_match("abc", 0));
}
