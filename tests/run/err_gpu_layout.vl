// 0.26.2: gpu.layout at check time (diagnostic 2): a bind group's entry
// of another kind than the shader's binding (a storage buffer for a
// uniform one), and one the module does not declare.
// ERROR: error[gpu.layout]: bind group 0 of 'K.evolve' (
// ERROR: err_gpu_layout.vl: line 27, column 32
// ERROR: error[gpu.layout]: bind group 0 of 'K.evolve' (
// ERROR: err_gpu_layout.vl: line 27, column 74
use std::gpu;
use std::gpu::BufferUsage;

embed wgsl K {
    @group(0) @binding(0) var<uniform> params: vec4<f32>;
    @group(0) @binding(1) var<storage, read_write> cells: array<u32>;

    @compute @workgroup_size(64)
    fn evolve(@builtin(global_invocation_id) id: vec3<u32>) {
        cells[id.x] = cells[id.x] + u32(params.x);
    }
}

fn setup(dev: gpu::Device) -> Result<gpu::BindGroup, gpu::Error> {
    let shader = dev.shader_wgsl(K.src)?;
    let pipe = dev.compute_pipeline(shader, K.evolve)?;
    let layout = pipe.bind_layout(0);
    let cells = dev.buffer(256, BufferUsage::STORAGE | BufferUsage::COPY_DST);
    let extra = dev.buffer(256, BufferUsage::STORAGE);
    Ok(dev.bind_group(layout, [gpu::bind(0, cells), gpu::bind(1, cells), gpu::bind(2, extra)][..]))
}

fn main() -> i32 {
    0
}
