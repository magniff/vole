// 0.25.4: a contract message's f-string holes are integers (a failed
// check prints them with no allocator), three at most. 0.25.3 said
// "expected 'i64', got 'str'" with no help, and left a fourth hole out
// of the message silently.
// ERROR: error[contract.message]: a contract message's f-string hole is an integer, and this is 'str'
// ERROR: help: a failed check prints its message with no allocator, its holes as integers (three at most); a float or text shows as an operand of the condition (`requires x > 0.0` prints x), or in the message's own words
// ERROR: error[contract.message]: a contract message's f-string has at most three holes
// ERROR: help: a failed check prints at most three values
// ERROR-COUNT: 2
fn scale(x: f64, name: str) -> f64
    requires x > 0.0 else "{name}: x is too small"
{
    x * 2.0
}

fn many(a: i64, b: i64) -> i64
    requires a < b else "{a} {b} {} {}", a + b, a - b
{
    a + b
}

fn main() {
    let s: str = "w";
    println("{} {}", scale(1.0, s), many(1, 2));
}
