// (0.30.2, obligations M1) Two impls told apart only by a region of their
// trait argument are one impl twice, as selection reads types without
// regions (rustc E0119).
// ERROR: conflicting impls of trait 'Tr'
trait Tr<U> { fn f(&self) -> i64; }
struct W;
impl Tr<&'static str> for W { fn f(&self) -> i64 { 1 } }
impl<'a> Tr<&'a str> for W { fn f(&self) -> i64 { 2 } }
fn go<'b, T: Tr<&'b str>>(t: &T) -> i64 { t.f() }
fn main() { println("{}", go::<W>(&W)); }
