// EDITION: rust
// RULE: D9.1
// (0.27.1) A holder without drop glue may outlive its referent's storage by
// declaration order.

struct H<'a> {
    r: &'a i64,
}

fn main() {
    let z: i64 = 0;
    let mut h = H { r: &z };
    let x: i64 = 1;
    h = H { r: &x };
    println("{}", *h.r);
}
// EXPECT: 1
