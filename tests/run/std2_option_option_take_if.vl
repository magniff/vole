// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::take_if.
// EXPECT: None Some(4) Some(5) None
use std::option::Option;

fn main() {
    let mut a: Option<i64> = Some(4);
    let t1 = a.take_if(|x| *x > 10);
    let mut b: Option<i64> = Some(5);
    let t2 = b.take_if(|x| *x == 5);
    println("{:?} {:?} {:?} {:?}", t1, a, t2, b);
}
