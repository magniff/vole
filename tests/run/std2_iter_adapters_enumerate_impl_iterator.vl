// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Enumerate::impl Iterator.
// EXPECT: Some((0, 5)) (1, Some(1))

fn main(gpa: Gpa) {
    let s = Vec::from_in([5i64, 6], gpa);
    let mut it = s.iter().copied().enumerate();
    let a = it.next();
    println("{:?} {:?}", a, it.size_hint());
}
