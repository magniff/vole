// RULE: D2.7
// (0.30.1, RT-33) `let m: &mut [i64] = &mut *s` of an `s: &[i64]`: rustc's
// E0596. Before, the shared view was retyped `&mut [i64]`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 8, column 25
// ERROR-COUNT: 1
fn k(s: &[i64]) {
    let m: &mut [i64] = &mut *s;
    m[0] = 3;
}

fn main() {
    let a = [5i64, 6];
    k(&a[..]);
    println("{}", a[0]);
}
