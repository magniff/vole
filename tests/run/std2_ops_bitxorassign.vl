// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops BitXorAssign.
// EXPECT: V { x: 9 }
use std::ops::BitXorAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitXorAssign for V {
    fn bitxor_assign(&mut self, rhs: V) {
        self.x ^= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a ^= V { x: 5 };
    println("{:?}", a);
}
