// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io &mut W::impl Write.
// EXPECT: [7]
use std::io::{ErrorKind, Write};

fn put<W: Write>(mut w: W) {
    w.write_all(&[7]).unwrap();
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    put(&mut v);
    println("{:?}", v);
}
