// EDITION: rust
// a generic with a let T calling a sink-self method: copy for i64, own.move_out for an owned T
// ERROR: error[borrowck.move_out]
// ERROR: line 10, column 33
trait E { fn eat(self) -> i64; }
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
impl E for R { fn eat(self) -> i64 { self.id } }
impl E for i64 { fn eat(self) -> i64 { self } }
fn use_it<T: E>(x: &T) -> i64 { x.eat() }

fn main() {
    println("{}", use_it(&4i64));
    let r = R { id: 1 };
    println("{}", use_it(&r));
    println("{}", r.id);
}
