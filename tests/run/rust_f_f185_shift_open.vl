// RULE: F18.5, F18.3
// (0.27.7) A shift whose left operand is a literal tree is a literal tree:
// the right operand does not type it, so an unannotated `let` of one is
// open and the first use that gives a type solves it, as rustc infers
// it. Before, the literal took i32 at the `let`: `let bit = 1 << (l % 64)`
// then `v[w] | bit` (an i64) computed 1 << (l % 32), and `(0 - 1) << (bits
// - 1)` passed as an i64 was i32's minimum. With no use that types it,
// the fallback is i32's (`small`). So is `!` of one (`!0`, then a u64).
// EXPECT: 1099511627784 -9223372036854775808 -128 1099511627776 1099511627775 1099511627780
// EXPECT: 1099511627776 8 -1 8
// EXPECT: 18446744073709551615 8 1099511627776 -1099511627776 44
fn id(x: i64) -> i64 {
    x
}

fn set(v: &mut Vec<i64, Gpa>, l: i64) {
    let w = l / 64;
    let bit = 1 << (l % 64);
    v[w as usize] = v[w as usize] | bit;
}

fn min_of(bits: i64) -> i64 {
    let min = (0 - 1) << (bits - 1);
    id(min)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(0);
    set(&mut v, 40);
    set(&mut v, 3);
    let s: i64 = 40;
    let h = 1 << s;
    let m = (1 << s) - 1;
    let y: i64 = m;
    let f = (1 << s) | (1 << 2);
    let g: i64 = f;
    let c = 1 << 40;
    let r: i64 = c;
    let k: u8 = 3;
    let z = 1 << k;
    let zz: u64 = z;
    let n = -1 >> 1u32;
    let nn: i64 = n;
    let small = 1 << 3;
    println("{} {} {} {} {} {}", v[0], min_of(64), min_of(8), id(h), y, g);
    println("{} {} {} {}", r, zz, nn, small);
    let a = !0;
    let a2: u64 = a;
    let t = (1 << 3) & 0xff;
    let t2: u16 = t;
    let arr = [1 << s, 2];
    let arr2: [i64; 2] = arr;
    let neg = -(1 << s);
    let neg2: i64 = neg;
    let mut acc = 1 << 2;
    acc += s;
    println("{} {} {} {} {}", a2, t2, arr2[0], neg2, acc);
}
