// RULE: D2.7
// (0.30.1, RT-33) An array is its own referent: `a[..1].swap(0, 0)` of a
// `let a` (no `mut`) borrows a mutably, rustc's E0596 (not declared as
// mutable).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow 'a' as mutable, as it is not declared as mutable
// ERROR: line 10, column 5
// ERROR-COUNT: 1
fn main() {
    let a = [1i64, 2];
    a[..1].swap(0, 0);
    println("{}", a[0]);
}
