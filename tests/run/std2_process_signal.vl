// The std2 item(s): std::process ExitStatus::signal; std::process Command::foreground; std::process abort.
// EXPECT: Some(15) None signal: 15 (SIGTERM)
// EXPECT: Some(6) true
// EXPECT: Some(0)
// RUSTC: none (signal is Rust's ExitStatusExt, foreground vole's own)
use std::process::Command;

fn main(gpa: Gpa) {
    let st = Command::new_in("sh", gpa).arg("-c").arg("kill -TERM $$").status().unwrap();
    println("{:?} {:?} {}", st.signal(), st.code(), st);
    let st = Command::new_in("sh", gpa).arg("-c").arg("kill -ABRT $$").status().unwrap();
    println("{:?} {}", st.signal(), !st.success());
    let st = Command::new_in("true", gpa).foreground(true).status().unwrap();
    println("{:?}", st.code());
}
