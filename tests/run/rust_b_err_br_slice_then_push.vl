// RULE: D12.2
// (0.27.1) A `[T]` result of `as_slice` borrows `v` (one slot): `v.push`
// while it is live.
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)
// ERROR: error[borrowck.conflict]
// ERROR: line 14, column 5
// ERROR-COUNT: 1
// Checked since clos272's std fixes.

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = v.as_slice();
    v.push(2);
    println("{}", s.len());
    0
}
