// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops ShrAssign::shr_assign.
// EXPECT: V { x: 3 } 3
use std::ops::ShrAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl ShrAssign for V {
    fn shr_assign(&mut self, rhs: V) {
        self.x >>= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.shr_assign(V { x: 2 });
    let mut n = 12i64;
    n.shr_assign(2);
    println("{:?} {}", a, n);
}
