// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters FilterMap::impl Iterator.
// EXPECT: Some(10) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, -2], gpa);
    let mut it = s.iter().filter_map(|x| if *x > 0 { Some(x * 10) } else { None });
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
