// RULE: F18.5
// (0.30.2) A cast gives its operand no type: `x` is the fallback i32,
// and 3000000000 does not fit it (rustc: literal out of range for i32,
// denied).
// ERROR: integer literal 3000000000 does not fit in type 'i32'
fn main() {
    let x = 3000000000;
    let y = x as i64;
    println("{y}");
}
