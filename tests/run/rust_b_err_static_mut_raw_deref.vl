// RUSTC-EDITION: 2024
// RULE: D6.2.5
// (0.27.4) Through a raw borrow a method's autoref is no reference to the
// `static mut`, but the static's own `&mut S` still is (rustc's
// static_mut_refs).
// ERROR: error[borrowck.static_mut_ref]
// ERROR: line 24, column 17
// ERROR-COUNT: 1
struct V2 {
    n: i64,
}

impl V2 {
    fn push(&mut self, x: i64) {
        self.n += x;
    }
}

static mut V: V2 = V2 { n: 0 };

fn main() {
    unsafe {
        (*&raw mut V).push(2);
        let r = &mut V;
        r.push(1);
    }
}
