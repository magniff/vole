// (0.30.1, review 2) The generic check of an impl's function of a generic
// trait's generic method is not dropped: its B, which may be a borrowed
// str, is moved into a thread, so B needs 'static (rustc E0310). Before,
// the check was unsure, dropped, and `S.f(1i64, st.as_str(), gpa)` read
// freed memory on the thread.
// ERROR: borrowck.param_outlives
// ERROR-COUNT: 1
use std::thread;
use std::fmt::Display;
use std::thread::JoinHandle;

trait Tr<A> {
    fn f<B: Send + Display>(&self, a: A, b: B, gpa: Gpa) -> JoinHandle<i64, Gpa>;
}

struct S;

impl Tr<i64> for S {
    fn f<B: Send + Display>(&self, a: i64, b: B, gpa: Gpa) -> JoinHandle<i64, Gpa> {
        thread::spawn_in(move || {
            println("thread {}", b);
            0i64
        }, gpa)
    }
}

fn main(gpa: Gpa) {
    let h = {
        let st = String::from_in("hello heap string long", gpa);
        S.f(1i64, st.as_str(), gpa)
    };
    h.join();
}
