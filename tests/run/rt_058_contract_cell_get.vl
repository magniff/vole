// XFAIL: RT-58: a contract that reads a Cell with get() is refused: Cell::get is said to write through a shared reference (0.30.2)
// Cell::get only reads (`unsafe { *self.value.get() }`); the effects take
// UnsafeCell::get's address, made from &self, as written (interior), so
// contract.effect refuses `requires c.get() < v.len()` with "calls
// 'Cell<usize>::get', which writes through a shared reference (a cell)".
// A condition that reads a Cell changes nothing the program does.
// EXPECT: 2 4
use std::cell::Cell;

fn f(c: &Cell<usize>, v: &[i64]) -> i64
    requires c.get() < v.len()
{
    v[c.get()]
}

fn g(c: &Cell<i64>) -> i64
    ensures c.get() >= 0
{
    c.get().abs()
}

fn main() -> i32 {
    let c = Cell::new(1usize);
    let d = Cell::new(-4i64);
    let v = [1i64, 2, 3];
    println("{} {}", f(&c, &v), g(&d));
    0
}
