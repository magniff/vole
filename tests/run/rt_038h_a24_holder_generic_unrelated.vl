// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a24_holder_generic_unrelated)
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
// Over-refusal probe: a generic holder (T unused by the clause) swapping and reversing an array of its own.
fn f<T: Copy>(t: T, n: i64) -> i64
    requires {
    let mut a = [3i64, 1, 2];
    let s = &mut a[..];
    s.swap(0, 1);
    s.reverse();
    a[0] == 2 && n > 0
}

{
    n
}

fn main() {
    println("{}", f(1u8, 3));
}
