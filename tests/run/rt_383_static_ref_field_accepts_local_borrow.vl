// `let r: &'static u64 = &e;` is refused (borrowck.return_local): the hole is in
// struct and union literals. The slice form is rt_383b, the union form rt_383c.
// From the re-review of the std and raw-pointer work. Since v0.30.1 at least.
// ERROR: line 9
struct V { a: &'static u64 }

fn mk() -> V {
    let e = 7u64;
    V { a: &e }
}

fn main() { let v = mk(); println("{}", v.a); }
