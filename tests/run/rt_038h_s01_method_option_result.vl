// RULE: C3.4
// (0.30.2, the re-review of g302holes: ov/s01_method_option_result)
// RUSTC: none contract clauses are not Rust
// EXPECT: Some(3)
// A common ensures: a method of a struct holding a Vec returns an Option; the clause iterates it.
use std::alloc::Allocator;

struct Stack<A: Allocator> {
    items: Vec<i64, A>,
}

impl Stack<Gpa> {
    fn top(&self) -> Option<i64>
        ensures result.iter().all(|x| *x >= 0)
        ensures result.is_some() == (self.items.len() > 0)
    {
        self.items.last().copied()
    }
}

fn main(gpa: Gpa) {
    let mut s = Stack { items: Vec::new_in(gpa) };
    s.items.push(3);
    println("{:?}", s.top());
}
