// Runs on std since 0.27.2's switch.
// The std item(s): std::ops impl MulAssign for primitives.
// EXPECT: 60 60
use std::ops::MulAssign;

fn update<T: MulAssign>(a: &mut T, b: T) {
    a.mul_assign(b);
}

fn main() {
    let mut x = 12i64;
    let mut y = 12u32;
    update(&mut x, 5);
    update(&mut y, 5);
    println("{} {}", x, y);
}
