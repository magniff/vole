// XFAIL: RT-397: (RT-397's mechanism, used) with `type Out: Tr<Self>` and `impl<T> H for B<T> { type Out = W; }`, W having only Tr<B<i64>>, `mid(&B { .., t: 1i32 })` builds: `t.get().g()` under `T: H` needs `W: Tr<B<i32>>`, which no impl gives, and runs Tr<B<i64>>'s g, printing 9 (rustc E0277) (0.30.2)
// From the review of g302oblig-m2 (form f271m). Since v0.30.1 at least;
// the release build the same. rustc E0277 (`W: Tr<B<T>>` is not
// satisfied) at `type Out = W` (the rustc twin of this file). Siblings:
// rt_397, rt_397b.
// ERROR: line 33
// ERROR-COUNT: 1
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H: Sized {
    type Out: Tr<Self>;
    fn get(&self) -> &Self::Out;
}

struct W {
    r: i64,
}

struct B<T> {
    w: W,
    t: T,
}

impl Tr<B<i64>> for W {
    fn g(&self) -> i64 {
        9
    }
}

impl<T> H for B<T> {
    type Out = W;

    fn get(&self) -> &W {
        &self.w
    }
}

fn mid<T: H>(t: &T) -> i64 {
    t.get().g()
}

fn main() {
    println("{}", mid(&B { w: W { r: 0 }, t: 1i32 }));
}
