// EDITION: rust
// RULE: F20.6, FL1
// (0.27.5) The container's element type is solved by a later statement
// (FL1): `v[0].push(1)` makes `v[0]` mutable while the inner Vec's
// element type is still a type variable, which the push then solves.
// EXPECT: 2 1 3
fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    v.push(Vec::new_in(gpa));
    v[0].push(1);
    v[0].push(3);
    let mut w = Vec::new_in(gpa);
    w.push(Vec::new_in(gpa));
    w.push(Vec::new_in(gpa));
    w[1].push(v[0][1]);
    println("{} {} {}", v[0].len(), w[1].len(), w[1][0]);
}
