// The std2 item(s): std::slice [T]::to_vec_in.
// EXPECT: [1, 2, 3] 3
use std::slice::SliceIndex;

fn main(gpa: Gpa) {
    let s: &[i64] = &[1, 2, 3];
    let v = s.to_vec_in(gpa);
    println("{:?} {}", v, v.len());
}
