// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Allocator::allocate_zeroed.
// EXPECT: 0 0
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let l = Layout::array::<u64>(2).unwrap();
    let p = gpa.allocate_zeroed(l).unwrap();
    let q = p.as_ptr() as *mut u64;
    // UNSAFE: the zeroed block is read and given back.
    // SAFETY: p is a block of two u64s.
    unsafe {
        println("{} {}", *q.add(0), *q.add(1));
        gpa.deallocate(p, l);
    }
}
