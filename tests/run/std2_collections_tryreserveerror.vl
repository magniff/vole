// FLAGS: --check-alloc
// The std2 item(s): std::collections TryReserveError (Rust's place for
// it; std::alloc names the same type).
// EXPECT: capacity overflow
// EXPECT: true
use std::collections::TryReserveError;

fn why(e: &std::alloc::TryReserveError) -> &'static str {
    match e {
        TryReserveError::CapacityOverflow => "capacity overflow",
        TryReserveError::AllocError { .. } => "the allocator",
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);
    match v.try_reserve(usize::MAX) {
        Ok(()) => println("reserved?"),
        Err(e) => println("{}", why(&e)),
    }
    println("{}", v.try_reserve(4).is_ok());
    0
}
