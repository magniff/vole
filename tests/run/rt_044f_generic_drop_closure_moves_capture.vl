// RULE: D19.2
// (0.30.2, RT-44) A closure in a generic Drop impl's instance (made while
// the bodies are built) whose body moves a capture: the capture is by
// value (D19.2), as every closure's. It stayed a borrow, the value moved
// out of it by `eat` and dropped again at the end of `drop` ("dropD 10"
// twice: a double drop, of an owning value a double free).
// EXPECT: ok
// EXPECT: dropD 10
// EXPECT: drop 10
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("dropD {}", self.v);
    }
}

fn eat(d: D) -> i64 {
    d.v
}

struct W<T> {
    n: i64,
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let d = D { v: self.n };
        let c = || eat(d);
        println("drop {}", c());
    }
}

fn main() {
    let w = W { n: 10, t: 1u8 };
    let _ = &w.t;
    println("ok");
}
