// EDITION: rust
// RULE: D19.2, D19.3
// (0.27.2) A closure that is not `move` but moves a capture captures it by
// value and is `FnOnce`.
// EXPECT: 4
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn main() {
    let s = S { n: 4 };
    let f = || eat(s);
    println("{}", f());
}
