// sem-own (iterator stopgap): BTreeMap::first_key_value of an owned value.
// (0.25) Kept, its value moved out: own.move_out (it would be freed twice).
// ERROR: own.move_out
use std::HashMap;
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn two(gpa: Gpa) -> Vec<D<Gpa>, Gpa> {
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn eat(d: sink D<Gpa>) {}

fn main(gpa: Gpa) {
    let w = two(gpa);
    var m: std::BTreeMap<i64, D<Gpa>, Gpa> = std::BTreeMap::new_in(gpa);
    m.insert(1, mk(3, gpa));
    let p = m.first_key_value().unwrap();
    eat(p.1);
}
