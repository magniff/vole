// EXPECT: 5
// (RT-426) `Self::Out` in a trait's default body whose supertrait
// declares Out, the type also with Tr2's Out: the supertrait's (v0.30.1:
// ambiguous).
trait Tr2 {
    type Out;
}

trait Tr {
    type Out;
    fn get(&self) -> Self::Out;
}

trait Sub: Tr {
    fn twice(&self) -> Self::Out {
        self.get()
    }
}

struct W {
    a: i64,
}

impl Tr2 for W {
    type Out = u8;
}

impl Tr for W {
    type Out = i64;

    fn get(&self) -> i64 {
        self.a
    }
}

impl Sub for W {}

fn main() {
    println("{}", W { a: 5 }.twice());
}
