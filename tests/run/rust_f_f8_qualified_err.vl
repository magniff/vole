// RULE: F8.2
// `Tr::m(x)` on a type without an impl of Tr: the bound unmet, rustc's
// E0277 (0.30.2, RT-159: a path call is not a method call, whose error
// this was).
// ERROR: error[trait.unmet]: 'U' has no impl of 'Show' that gives 'show'
trait Show {
    fn show(&self) -> i64;
}

struct U {
    n: i64,
}

fn main() -> i64 {
    let u = U { n: 7 };
    Show::show(&u)
}
