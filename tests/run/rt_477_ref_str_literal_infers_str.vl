// XFAIL: RT-477: `n(&"abc")` for `fn n<T: L>(x: &T)` with `impl L for &str` infers T = str ("the size of 'str' cannot be known", "the trait 'L' is not implemented for 'str'"); rustc infers T = &str and prints 90 (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form g15c_ref_str_literal_infer.
// EXPECT: 90
trait L {
    fn ln(&self) -> i64;
}

impl<'a> L for &'a str {
    fn ln(&self) -> i64 {
        90
    }
}

fn n<T: L>(x: &T) -> i64 {
    x.ln()
}

fn main() -> i32 {
    println("{}", n(&"abc"));
    0
}
