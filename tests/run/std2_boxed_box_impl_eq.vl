// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::boxed Box::impl Eq.
// EXPECT: true
use std::boxed::Box;

fn same<T: Eq>(a: &T, b: &T) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    let a = Box::new_in(4i64, gpa);
    let b = Box::new_in(4i64, gpa);
    println("{}", same(&a, &b));
}
