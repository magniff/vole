// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a43_mut_ref_rawaddr)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// &raw mut *r of a &mut parameter in the clause, written by a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(r: &mut i64) -> i64
    requires poke(&raw mut *r)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
