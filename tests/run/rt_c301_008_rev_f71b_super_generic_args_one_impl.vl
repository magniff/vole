// RULE: F8.3, F8.4
// RT-C301-8 review (R3, form f71b_super_generic_args_one_impl): the supertrait's arguments with one impl.
// rustc prints the EXPECT lines.
// EXPECT: 768
trait Conv<X> { const K: i64; fn mk() -> i64; }
trait Sub: Conv<i64> {}
struct S;
impl Conv<i64> for S { const K: i64 = 64; fn mk() -> i64 { 640 } }
impl Sub for S {}
fn g<T: Sub>() -> i64 { let f = T::mk; T::K + f() + <T as Conv<i64>>::K }
fn main() { println("{}", g::<S>()); }
