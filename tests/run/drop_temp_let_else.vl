// (0.29.0) `let PAT = e else { .. };`: the temporaries of e, and its own
// value when PAT does not match, are dropped before the else block runs
// (rustc's rule in every edition; vole until 0.28.0 dropped them after
// it). On a match they live to the end of the `let`. The output is
// rustc 2024's (tools/rustc-twin.sh).
// RUSTC-EDITION: 2024
// EXPECT: lent 1
// EXPECT: d1
// EXPECT: else 0
// EXPECT: d2
// EXPECT: 0
// EXPECT: lent 9
// EXPECT: d1
// EXPECT: got 9
// EXPECT: 9
// EXPECT: value 1
// EXPECT: d4
// EXPECT: else 0
// EXPECT: d3
// EXPECT: 0
// EXPECT: value 9
// EXPECT: got 4
// EXPECT: d4
// EXPECT: d3
// EXPECT: 9
// EXPECT: looped
// EXPECT: d13
// EXPECT: skip 3
// EXPECT: d14
// EXPECT: skip 4
// EXPECT: d15
// EXPECT: skip 5
// EXPECT: d16
// EXPECT: d17
// EXPECT: 13
struct T {
    id: i64,
    v: i64,
}

fn mk(id: i64, v: i64) -> T {
    T { id: id, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn big(t: &T) -> Option<i64> {
    if t.v > 5 { Some(t.v) } else { None }
}

fn own(t: T) -> Result<T, T> {
    if t.v > 5 { Ok(t) } else { Err(t) }
}

fn lent(v: i64) -> i64 {
    println("lent {v}");
    let Some(n) = big(&mk(1, v)) else {
        let l = mk(2, 0);
        println("else {}", l.v);
        return 0;
    };
    println("got {n}");
    n
}

fn value(v: i64) -> i64 {
    println("value {v}");
    let l = mk(3, 0);
    let Ok(t) = own(mk(4, v)) else {
        println("else {}", l.v);
        return 0;
    };
    println("got {}", t.id);
    t.v
}

fn looped() -> i64 {
    println("looped");
    let mut sum = 0;
    for i in 3..8 {
        let Some(n) = big(&mk(10 + i, i)) else {
            println("skip {i}");
            continue;
        };
        sum += n;
    }
    sum
}

fn main() -> i32 {
    println("{}", lent(1));
    println("{}", lent(9));
    println("{}", value(1));
    println("{}", value(9));
    println("{}", looped());
    0
}
