// XFAIL: RT-74: drop glue (scope end, std::mem::drop) runs the type's inherent drop(&mut self) instead of its Drop impl (0.30.2)
// D has an inherent `fn drop(&mut self)` and `impl Drop for D`. Rust runs
// Drop::drop when a D dies; vole runs the inherent method and never the
// Drop impl. rustc prints the EXPECT lines.
// EXPECT: Drop 2
// EXPECT: end
// EXPECT: Drop 1
struct D {
    k: i64,
}

impl D {
    fn drop(&mut self) {
        println("inherent drop {}", self.k);
    }
}

impl Drop for D {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn body() {
    let mut d = D { k: 1 };
    d.k += 0;
    let e = D { k: 2 };
    std::mem::drop(e);
    println("end");
}

fn main() -> i32 {
    body();
    0
}
