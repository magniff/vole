// RT-211 review 3 (o17b, o17c, o17d, o22_*): Map's `type Item = B`, B bound
// only by `F: FnMut(I::Item) -> B`, is read through the closure's own
// signature (places/regions.vl fn_output_slot): its result's region is
// an X_C position of the closure, not every region of Map (its captures
// too), so `first(v.iter().map(|x| { w.len(); x }), &k); drop(w);` keeps
// only v borrowed. Review 2's fix tied B to all of Map's regions and
// refused the drop; v0.30.1 and rustc build every form. The output is rustc's.
// EXPECT: Some(1000) Some((1000, 1)) Some(1000) Some(1000) Some(1000)
// EXPECT: Some((0, 1000)) Some(1000) Some(1000) Some(7)
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

struct S {
    n: i64,
}

impl S {
    fn get(&self) -> i64 {
        self.n
    }
}

static SEVEN: i64 = 7;

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(5);
    let r1 = first(v.iter().map(|x| {
        let _ = w.len();
        x
    }), &k);
    let r2 = first(v.iter().map(|x| (x, w.len())), &k);
    let r3 = first(v.iter().filter_map(|x| if w.len() > 0 { Some(x) } else { None }), &k);
    let r4 = first(v.iter().map_while(|x| if w.len() > 0 { Some(x) } else { None }), &k);
    let r5 = first(v.iter().scan(0i64, |s, x| {
        let _ = w.len();
        *s += 1;
        Some(x)
    }), &k);
    let r6 = first(v.iter().map(|x| {
        let _ = w.len();
        x
    }).enumerate(), &k);
    let r7 = first(v.iter().map(|x: &i64| {
        let _ = w.len();
        x
    }), &k);
    let s = S { n: 3 };
    let r8 = first(v.iter().map(|x| {
        let _ = s.get();
        x
    }), &k);
    drop(w);
    let r9 = {
        let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
        u.push(1);
        first(u.iter().map(|_x| -> &'static i64 { &SEVEN }), &k)
    };
    println("{:?} {:?} {:?} {:?} {:?}", r1, r2, r3, r4, r5);
    println("{:?} {:?} {:?} {:?}", r6, r7, r8, r9);
}
