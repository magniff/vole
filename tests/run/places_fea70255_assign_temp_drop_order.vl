// places IR, family ea70255c: tmp = v; drop(P); P = move tmp, then the statement's temporaries
// 0.25.2: an owned assignment's right side keeps its temporaries to the
// end of the assignment, conventions.md §2.2: the old value drops first,
// then the temporaries, in reverse (0.25.1 dropped them before the old
// value after a call, `t = f1(k(), mk(1))`, and `step` read garbage).
// Through a field, a block's tail, a loop, a receiver by sink, and `?`
// leaving before the temporary is made.
// FLAGS: --check-alloc
// EXPECT: call first
// EXPECT: d1
// EXPECT: d2
// EXPECT: place first
// EXPECT: d3
// EXPECT: d4
// EXPECT: receiver
// EXPECT: d5
// EXPECT: d7
// EXPECT: d6
// EXPECT: field
// EXPECT: d9
// EXPECT: d10
// EXPECT: tail
// EXPECT: d8
// EXPECT: d12
// EXPECT: loop
// EXPECT: d13
// EXPECT: d14
// EXPECT: d15
// EXPECT: d16
// EXPECT: early exit
// EXPECT: true 9
// EXPECT: d17
// EXPECT: d18
// EXPECT: 51 51
// EXPECT: end
// EXPECT: d11
// EXPECT: d19
// PLACES: fn T::bump
// PLACES: drop(_1) [kept]
// PLACES: fn step
// PLACES: drop((*_1)) [kept]
// PLACES: drop(_9) [kept]
// PLACES: drop(_3) [removed]
// PLACES: drop(_3) [removed]
// PLACES: fn main
// PLACES: drop(_1) [kept]
// PLACES: drop(_5) [kept]
// PLACES: drop(_3) [removed]
// PLACES: drop(_1) [kept]
// PLACES: drop(_8) [kept]
// PLACES: drop(_7) [removed]
// PLACES: drop(_1) [removed]
// PLACES: drop(_16) [kept]
// PLACES: drop(_13) [kept]
// PLACES: drop(_10) [removed]
// PLACES: drop(_19) [removed]
// PLACES: drop(_18.0) [kept]
// PLACES: drop(_21) [kept]
// PLACES: drop(_20) [removed]
// PLACES: drop(_1) [kept]
// PLACES: drop(_25) [kept]
// PLACES: drop(_24) [removed]
// PLACES: drop(_1) [kept]
// PLACES: drop(_32) [kept]
// PLACES: drop(_31) [removed]
// PLACES: drop(_18) [kept]
// PLACES: drop(_1) [kept]

static var NEXT: i64 = 0;
struct T { id: i64, v: i64 }
fn mk(v: i64) -> T { NEXT += 1; T { id: NEXT, v: v } }

impl Drop for T {
    fn drop(inout self) { println(f"d{self.id}"); }
}

impl T {
    fn bump(sink self, n: i64) -> T { mk(self.v + n) }
}

fn k() -> i64 { 0 }
fn peek(a: T) -> i64 { a.v }
fn f1(n: i64, a: T) -> T { mk(a.v + n) }
struct H { t: T, n: i64 }
fn may(fail: bool) -> Option<i64> { if fail { Option::None } else { Option::Some(1) } }

fn step(t: inout T, fail: bool) -> Option<i64> {
    t = f1(may(fail)?, mk(50));
    Option::Some(t.v)
}

fn main() -> i32 {
    var t = mk(0);
    println("call first");
    t = f1(k(), mk(1));
    println("place first");
    t = f1(0, mk(2));
    println("receiver");
    t = t.bump(peek(mk(3)) + peek(mk(4)));
    println("field");
    var h = H { t: mk(5), n: 1 };
    h.t = f1(h.n, mk(6));
    println("tail");
    if h.n > 0 {
        t = f1(0, mk(7))
    }
    println("loop");
    for i in 0..2 {
        t = f1(i, mk(8));
    }
    println("early exit");
    let a = step(&t, true);
    println(f"{a.is_none()} {t.v}");
    let b = step(&t, false);
    println(f"{b.unwrap()} {t.v}");
    println("end");
    0
}
