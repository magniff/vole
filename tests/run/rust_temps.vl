// (0.27.0) `&f(x)` of a value, as Rust's: a temporary of its statement,
// made where it stands (the order kept) and dropped at the statement's
// end; a second one in a statement too (before, cannot take address of
// non-lvalue expression).
// FLAGS: --check-alloc
// EXPECT: 6 10
// EXPECT: 4
// EXPECT: 2
fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut s = 0;
    for x in v {
        s += *x;
    }
    s
}

fn make(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn main(gpa: Gpa) -> i32 {
    println("{} {}", total(&make(4, gpa)), total(&make(5, gpa)));
    let c = total(&make(2, gpa)) + total(&make(3, gpa));
    println("{c}");
    println("{}", len(&mk()) + len(&mk()));
    0
}

fn len(v: &(i64, i64)) -> i64 {
    v.0
}

fn mk() -> (i64, i64) {
    (1, 2)
}
