// XFAIL: RT-491: an impl whose type parameter is fixed only by a closure bound's result, `impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> { type Item = B; .. }`, gives "unknown type 'B'" at `type Item = B` when it is reached through `fn wrap<B, I: Iterator, F: FnMut(I::Item) -> B>(i: I, f: F) -> impl Iterator<Item = B>`; rustc prints 60 (0.30.2)
// From the third re-review of the borrow-check work (g302bor2), written as programs rustc accepts. Since v0.30.1 at least.
// The same impl used directly (`MyMap { .. }` and a method on it) is
// accepted. B inside a tuple of the bound's result: rt_491b.
// EXPECT: 60
struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn wrap<B, I: Iterator, F: FnMut(I::Item) -> B>(i: I, f: F) -> impl Iterator<Item = B> {
    MyMap { i: i, f: f }
}

fn main() {
    let a = [1i64, 2, 3];
    let s: i64 = wrap(a.iter(), |x| *x * 10).sum();
    println("{}", s);
}
