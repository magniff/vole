// EDITION: rust
// RULE: D2.6
// (0.27.1) A write through a `ref mut` binding in its guard: read-only there
// (L6, as rustc).
// ERROR: error[borrowck.guard_write]
// ERROR: line 14, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut o: Option<i64> = Some(1);
    match o {
        Some(ref mut y) if {
            *y += 1;
            true
        } => println("a"),
        _ => println("b"),
    }
}
