// XFAIL: gap 2: compile type error: unresolved import 'std::trim'
// std's grapheme clusters (0.20, compiler/std/unicode/grapheme.vl)
// against Unicode's own GraphemeBreakTest.txt (tests/std/unicode/, the
// tables' version, Unicode 18.0.0), every line: GraphemeState fed the
// code points one at a time, and next_grapheme_end, Graphemes and
// count_graphemes over the line's UTF-8.
// ARGS: @ROOT@/tests/std/unicode/GraphemeBreakTest.txt
import "stdio.h" as c;

use std::trim;
use std::str::encode_utf8;
use std::unicode::GraphemeState; use std::unicode::count_graphemes; use std::unicode::graphemes;
use std::unicode::next_grapheme_end;

fn read_all(path: *mut u8, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut text = Vec::<u8, Gpa>::new_in(gpa);
    let f = unsafe { c::fopen(path, c"rb") };
    if f == 0 as *mut c::FILE {
        return text;
    }
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::fread(&mut chunk[0], 1u64, 65536u64, f) } as i64;
        if n <= 0 {
            break;
        }
        text.extend_from_slice(&chunk[0..n as usize]);
    }
    unsafe { c::fclose(f); }
    text
}

fn hex(s: &[u8]) -> i64 {
    let mut v: i64 = 0;
    for i in 0..s.len() {
        let b = s[i];
        let d = if b >= b'0' && b <= b'9' { (b - b'0') as i64 } else { (b - b'A') as i64 + 10 };
        v = v * 16 + d;
    }
    v
}

fn main(argc: i32, argv: *mut *mut u8, gpa: Gpa) -> i32 {
    if argc < 2 {
        return 2;
    }
    let text = unsafe { read_all((*argv.add(1)), gpa) };
    let t = text.as_slice();
    let mut cps: Vec<u32, Gpa> = Vec::new_in(gpa);
    // breaks[k]: a boundary before cps[k] (k = cps.len(): the end)
    let mut breaks: Vec<bool, Gpa> = Vec::new_in(gpa);
    let mut utf8 = Vec::<u8, Gpa>::new_in(gpa);
    let mut offsets: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut lines: i64 = 0;
    let mut fails: i64 = 0;
    let mut from: i64 = 0;
    for i in 0..t.len() + 1 {
        if i < t.len() && t[i] != b'\n' {
            continue;
        }
        let mut line = &t[from as usize..i];
        from = i as i64 + 1;
        for k in 0..line.len() {
            if line[k] == b'#' {
                line = &line[0..k];
                break;
            }
        }
        line = trim(line);
        if line.len() == 0 {
            continue;
        }
        cps.clear();
        breaks.clear();
        // tokens: ÷ (C3 B7), × (C3 97), hex code points
        let mut k: i64 = 0;
        while k < line.len() as i64 {
            if line[k as usize] == b' ' || line[k as usize] == b'\t' {
                k += 1;
            } else if line[k as usize] == 0xc3 && k + 1 < line.len() as i64 {
                breaks.push(line[(k + 1) as usize] == 0xb7);
                k += 2;
            } else {
                let mut e = k;
                while e < line.len() as i64 && line[e as usize] != b' '
                    && line[e as usize] != b'\t' {
                    e += 1;
                }
                cps.push(hex(&line[k as usize..e as usize]) as u32);
                k = e;
            }
        }
        lines += 1;
        if breaks.len() != cps.len() + 1 {
            println("line {lines}: cannot read it");
            fails += 1;
            continue;
        }
        // one code point at a time
        let mut st = GraphemeState::new();
        let mut bad = false;
        for j in 0..cps.len() {
            if st.push(cps[j]) != breaks[j] {
                bad = true;
            }
        }
        // the same over UTF-8
        utf8.clear();
        offsets.clear();
        let mut e = [0u8; 4];
        for j in 0..cps.len() {
            offsets.push(utf8.len() as i64);
            let n = encode_utf8(cps[j], &mut e);
            utf8.extend_from_slice(&e[0..n as usize]);
        }
        offsets.push(utf8.len() as i64);
        let s = utf8.as_slice();
        let mut want: i64 = 0;
        for j in 1..cps.len() + 1 {
            if breaks[j] {
                want += 1;
            }
        }
        let mut at: i64 = 0;
        for g in graphemes(s) {
            at += g.len() as i64;
            // (at must be the offset of a code point with a boundary before it)
            let mut j: i64 = 0;
            while j < offsets.len() as i64 && offsets[j as usize] != at {
                j += 1;
            }
            if j == offsets.len() as i64 || !breaks[j as usize] {
                bad = true;
            }
        }
        if count_graphemes(s) != want || next_grapheme_end(s, 0) > s.len() as i64 {
            bad = true;
        }
        if bad {
            fails += 1;
            if fails <= 10 {
                println("line {lines}: {line}", line = str::from_utf8(line).unwrap());
            }
        }
    }
    println("GraphemeBreakTest: {lines} lines, {fails} failures");
    if fails == 0 { 0 } else { 1 }
}

// EXPECT: GraphemeBreakTest: 853 lines, 0 failures
