// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c17_let_else)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// a let-else binding named as the moved parameter.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures {
    let Some(s) = Some(result) else { panic("no") };
    s > 0
}

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
