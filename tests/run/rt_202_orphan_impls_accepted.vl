// XFAIL: RT-202: the orphan rule is not enforced: impls of std's traits for std's types (`impl Add<u8> for i64`, `impl Display for Option<i64>`, `impl Iterator for u8`, `impl<T: Local> Default for T`) are accepted; `a + b` then ignores the Add impl while `a.add(b)` runs it (0.30.2)
// rustc refuses the four impls: E0117 (lines 19, 27, 33) and E0210
// (line 43); twin: r302d_027_orphan_impls_accepted.rs.txt. vole builds it and
// prints `8 5003`, `opt`, `None`: the operator `a + b` (i64 + u8) takes the
// implicit widening and gives 8, the method call `a.add(b)` the program's impl,
// 5003; `println("{}", Some(1i64))` uses the program's Display for std's Option.
// An impl that collides with one of std's is refused (trait.overlap, or
// "conflicting impls" placed in std), and `impl PartialEq<S> for i64` gives
// `<std>:1053:26: error[type error] unknown type 'S'` (co/r7.vl): the program's
// impl is read in std's scope. Since v0.28.0.
// ERROR: line 19
// ERROR: line 27
// ERROR: line 33
// ERROR: line 43
// ERROR-COUNT: 4
use std::fmt;
use std::ops::Add;

impl Add<u8> for i64 {
    type Output = i64;

    fn add(self, o: u8) -> i64 {
        self * 1000 + o as i64
    }
}

impl fmt::Display for Option<i64> {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        write(f, "opt")
    }
}

impl Iterator for u8 {
    type Item = u8;

    fn next(&mut self) -> Option<u8> {
        None
    }
}

trait Local {}

impl<T: Local> Default for T {
    fn default() -> T {
        loop {}
    }
}

fn main() {
    let a = 5i64;
    let b = 3u8;
    println("{} {}", a + b, a.add(b));
    println("{}", Some(1i64));
    let mut x = 3u8;
    println("{:?}", x.next());
}
