// XFAIL: RT-104: a trait's default method body is not checked unless some impl uses it: a type error and an unbounded method call pass (0.30.2)
// rustc checks every default body and refuses this program (E0308
// mismatched types, E0599 no method `len` on `T`). vole: `ok: 0 errors`:
// Tr's default bodies are checked only in an instance, and S overrides d
// and f, so none is made. With an impl that uses the defaults the same
// bodies are refused (at their instance: `no method 'len' on type 'i64'`).
// A use after move in a default body (`fn e(self) -> (Self, Self) {
// (self, self) }`) passes the same way. RT-TL-24 is the signature's form
// of the same laziness. The ERROR lines are the errors vole gives for
// these forms in a generic fn (g1, g2 in the probes), at this file's lines.
// ERROR: error[type error]: expected 'i64', got '&str'
// ERROR: line 18, column 9
// ERROR: error[generic.unbounded_use]
// ERROR: line 22, column 9
// ERROR-COUNT: 2
trait Tr {
    fn d(&self) -> i64 {
        "s"
    }

    fn f<T>(&self, t: T) -> i64 {
        t.len() as i64
    }
}

struct S;

impl Tr for S {
    fn d(&self) -> i64 {
        1
    }

    fn f<T>(&self, t: T) -> i64 {
        2
    }
}

fn main() {
    let s = S;
    println("{} {}", s.d(), s.f(5i64));
}
