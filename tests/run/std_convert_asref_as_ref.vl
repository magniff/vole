// Runs on std since 0.27.2's switch.
// The std item(s): std::convert AsRef::as_ref.
// EXPECT: 2
use std::convert::{AsRef, Infallible};

struct W {
    v: i64,
}

impl AsRef<i64> for W {
    fn as_ref(&self) -> &i64 {
        &self.v
    }
}

fn main() {
    let w = W { v: 2 };
    let r: &i64 = w.as_ref();
    println("{}", r);
}
