// RULE: D2.7, D7.4
// (0.30.1, RT-33) `s.swap(0, 1)` of an `s: &[i64]`: swap's `requires`
// binds the receiver as its reborrow, which is the `&mut` of a shared
// view's referent, rustc's E0596; the message names `*s`, not the
// binding. A regression of 0.30.1's contract desugar, which 0.30.0 refused.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 10, column 5
// ERROR-COUNT: 1
fn k(s: &[i64]) {
    s.swap(0, 1);
}

fn main() {
    let a = [2i64, 1];
    k(&a[..]);
    println("{} {}", a[0], a[1]);
}
