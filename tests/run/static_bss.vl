// 0.25.5: a writable static whose bytes are all zero goes in the
// zero-fill section (Mach-O's __DATA,__bss zerofill, ELF's .bss nobits):
// the object holds its size, not its bytes, and the loader zeroes it. An
// array, an integer, a bool, a struct and a float of zero bytes; a static
// with a non-zero byte stays in the data, and an immutable one of zeros
// stays read-only. The values start at zero and change like any static's,
// at both ends of a 64 KiB array; the program has bss and data both
// (std's statics), linked by the compiler's own linker by default.
// EXPECT: zero 0 0 false 0 0 0 0 0.5
// EXPECT: after 1 2 0 3 true 3 1.5
// EXPECT: data 7
// CROSS: aarch64-linux
// ASM(aarch64-macos): .section __DATA,__bss,zerofill
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.BIG:
// ASM(aarch64-macos): .space 65536
// ASM(aarch64-macos): .section __DATA,__bss,zerofill
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.COUNT:
// ASM(aarch64-macos): .section __DATA,__bss,zerofill
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.FLAG:
// ASM(aarch64-macos): .section __DATA,__bss,zerofill
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.ORIGIN:
// ASM(aarch64-macos): .section __DATA,__bss,zerofill
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.ZERO_F:
// ASM(aarch64-macos): .section __DATA,__data
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.HALF:
// ASM(aarch64-macos): .section __DATA,__data
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.SEEDED:
// ASM(aarch64-macos): .section __TEXT,__const
// ASM-NOT(aarch64-macos): .section
// ASM(aarch64-macos): _vole.static.TABLE:
// ASM(aarch64-linux): .section .bss,"aw",@nobits
// ASM-NOT(aarch64-linux): .section
// ASM(aarch64-linux): vole.static.BIG:
// ASM(aarch64-linux): .space 65536
// ASM(aarch64-linux): .section .bss,"aw",@nobits
// ASM-NOT(aarch64-linux): .section
// ASM(aarch64-linux): vole.static.COUNT:
// ASM(aarch64-linux): .data
// ASM-NOT(aarch64-linux): .section
// ASM(aarch64-linux): vole.static.HALF:
// ASM(aarch64-linux): .section .rodata
// ASM-NOT(aarch64-linux): .data
// ASM(aarch64-linux): vole.static.TABLE:

#[derive(Clone, Copy)] struct Point {
    x: i64,
    y: i32,
}

static mut BIG: [u8; 65536] = [0; 65536];
static mut COUNT: i64 = 0;
static mut FLAG: bool = false;
static mut ORIGIN: Point = Point { x: 0, y: 0 };
static mut ZERO_F: f64 = 0.0;
static mut HALF: f64 = 0.5;
static mut SEEDED: i64 = 7;
static TABLE: [i64; 4] = [0i64; 4];

#[inline(never)]
fn bump(i: i64) {
    unsafe { BIG[i as usize] = BIG[i as usize] + 1; }
    unsafe { COUNT += 1; }
}

fn main() {
    let mut sum: i64 = 0;
    for i in 0..65536 {
        sum += unsafe { BIG[i as usize] } as i64;
    }
    let count_now = unsafe { COUNT }; let flag_now = unsafe { FLAG };
    let zero_f_now = unsafe { ZERO_F }; let half_now = unsafe { HALF };
    println("zero {sum} {count_now} {flag_now} {} {} {zero_f_now} {} {half_now}",
        unsafe { ORIGIN.x }, unsafe { ORIGIN.y }, TABLE[3]);
    bump(0);
    bump(65535);
    bump(65535);
    unsafe { FLAG = true; }
    unsafe { ORIGIN.y = 3; }
    unsafe { ZERO_F = 1.5; }
    let count_now = unsafe { COUNT }; let flag_now = unsafe { FLAG };
    let zero_f_now = unsafe { ZERO_F };
    println("after {} {} {} {count_now} {flag_now} {} {zero_f_now}", unsafe { BIG[0] },
        unsafe { BIG[65535] }, unsafe { BIG[1] }, unsafe { ORIGIN.y });
    let seeded_now = unsafe { SEEDED }; println("data {seeded_now}");
}
