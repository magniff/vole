// RULE: F30.5
// (0.29) What a C header declares `T *` takes no `*const T` (rustc
// E0308): the pointer may be written through. A field declared `const T
// *` is not written through (E0594).
// CSOURCE: tests/c/constptr.c
// ERROR: error[type error]: expected '*mut i64', got '*const i64'
// ERROR: line 17, column 22
// ERROR: help: the types differ in mutability (rustc E0308)
// ERROR: try: a.as_ptr() as *mut i64
// ERROR: fix --suggested
// ERROR: cannot assign to '*s.data', which is behind a `*const` pointer
// ERROR-COUNT: 2
import "../c/constptr.h" as c;

fn main() {
    let a = [1i64, 2, 3];
    unsafe { c::fill(a.as_ptr(), 3, 7) };
    let text = [97u8, 98, 99];
    let mut out = [0u8; 3];
    let s = c::span { data: text.as_ptr(), out: out.as_mut_ptr(), n: 3 };
    unsafe {
        *s.data = 1;
        *s.out = 1;
    }
}
