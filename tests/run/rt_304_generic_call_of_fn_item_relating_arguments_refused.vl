// XFAIL: RT-304: a generic body that calls its `F: Fn(A, B)` (or `fn(A, B)`) parameter, instantiated with a fn item whose signature ties B's lifetime to A's (`fn push_ref<'a>(v: &mut Vec<&'a i64, Gpa>, x: &'a i64)`), is refused in the body: "the lifetime in 'B' must outlive the lifetime in 'A'", twice per body (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). The generic body is
// borrow-checked per instance (RT-146) with the instance's A and B regions
// unrelated, so the fn item's own signature, which relates them, reads as
// a flow the body does not allow. The same shape as RT-225 (fixed by select
// on the release branch, c21004ac2) through a call of a function value
// instead of an Extend bound. Misuse (`drop(v)` while out holds &v[0]) is
// refused too, in the body, not at the call (r302f ii/fa/w/main.vl).
// EXPECT: [1000, 2000] [7]
fn push_ref<'a>(v: &mut Vec<&'a i64, Gpa>, x: &'a i64) {
    v.push(x);
}

fn apply2<A, B, F: Fn(A, B)>(a: A, b: B, f: F) {
    f(a, b)
}

fn apply2p<A, B>(a: A, b: B, f: fn(A, B)) {
    f(a, b)
}

fn main(gpa: Gpa) {
    let mut out: Vec<&i64, Gpa> = Vec::new_in(gpa);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    apply2(&mut out, &v[0], push_ref);
    apply2p(&mut out, &w[0], push_ref);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?}", out, x);
}
