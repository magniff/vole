// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Sub.
// EXPECT: V { x: 7 }
use std::ops::Sub;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Sub for V {
    type Output = V;

    fn sub(self, rhs: V) -> V {
        V { x: self.x - rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?}", a - b);
}
