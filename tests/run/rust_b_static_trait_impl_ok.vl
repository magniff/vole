// (0.30.1, review 2) What meets a trait's 'static, as rustc accepts:
// Self 'static (`&'static str`, i64, a struct of them), an associated
// type's value 'static, an impl's parameter bounded 'static.
// EXPECT: 1 hi 2 3
trait St: 'static + std::fmt::Display {}

impl St for &'static str {}

impl St for i64 {}

trait Tr {
    type Out: 'static + std::fmt::Display;
    fn out(&self) -> Self::Out;
}

struct W<'a> {
    s: &'a str,
}

impl<'a> Tr for W<'a> {
    type Out = i64;

    fn out(&self) -> i64 {
        self.s.len() as i64
    }
}

struct K<T> {
    t: T,
}

impl<T: 'static + Copy + std::fmt::Display> Tr for K<T> {
    type Out = T;

    fn out(&self) -> T {
        self.t
    }
}

fn show<T: St>(t: T) -> T {
    t
}

fn main(gpa: Gpa) {
    let s = String::from_in("hi", gpa);
    let w = W { s: s.as_str() };
    println("{} {} {} {}", show(1i64), show("hi"), w.out(), K { t: 3i64 }.out());
}
