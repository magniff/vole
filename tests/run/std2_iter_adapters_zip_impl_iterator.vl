// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Zip::impl Iterator.
// EXPECT: Some((1, 3)) None (2, Some(2))

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64], gpa);
    let b = Vec::from_in([3i64, 4], gpa);
    let mut it = a.iter().copied().zip(b.iter().copied());
    let x = it.next();
    println("{:?} {:?} {:?}", x, it.next(), b.iter().zip(b.iter().cycle()).size_hint());
}
