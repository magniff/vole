// XFAIL: gap 18: rustc says E0596 (borrowck.borrow_immutable); the rust edition: borrowck.conflict
// a closure that pushes to v (inout capture) and v passed let to the same call
// ERROR: borrowck.borrow_immutable
fn run<F: FnMut()>(f: F, s: &Vec<i64, Gpa>) -> i64 { f(); s.len() as i64 }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", run(|| v.push(2), &v));
}
