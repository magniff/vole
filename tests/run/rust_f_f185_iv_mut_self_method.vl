// RULE: F18.5
// (0.30.2) A trait's `&mut self` method called on an integer variable's
// value, several integer types implementing it with the same declaration:
// rustc's probe takes the trait's method with Self the variable, and the
// impl is the one of the type a later use gives it (i64 here), the result
// typed by the declaration. An earlier 0.30.2 build closed the variable
// to i32 at the call and computed in i32.
// EXPECT: 64 4000000000
// EXPECT: 3000000000
// EXPECT: 4000000002
// EXPECT: 64 10
trait Bump {
    fn bump(&mut self) -> i64;
}

impl Bump for i32 {
    fn bump(&mut self) -> i64 {
        *self = *self + 1;
        32
    }
}

impl Bump for i64 {
    fn bump(&mut self) -> i64 {
        *self = *self + *self;
        64
    }
}

trait Twice {
    fn twice(&mut self);
}

impl Twice for i32 {
    fn twice(&mut self) {
        *self = *self * 2;
    }
}

impl Twice for i64 {
    fn twice(&mut self) {
        *self = *self * 2;
    }
}

trait Inc {
    fn inc(&mut self);
}

impl Inc for i32 {
    fn inc(&mut self) {
        *self += 1;
    }
}

impl Inc for i64 {
    fn inc(&mut self) {
        *self += 1;
    }
}

fn take(x: i64) -> i64 {
    x
}

fn main() {
    let mut a = 2000000000;
    let k = a.bump();
    let b: i64 = a;
    println("{} {}", k, b);

    let mut c = 1500000000;
    c.twice();
    let d: i64 = c;
    println("{}", d);

    let mut e = 2000000000;
    e.inc();
    e += e;
    let f: i64 = e;
    println("{}", f);

    let mut g = 5;
    let k2 = g.bump();
    println("{} {}", k2, take(g));
}
