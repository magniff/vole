// std::cli (0.24): parsing any argument list returns Ok or a CliError,
// never panics, and every accessor works on what it returns: a
// #[property] over generated lists (indexes into a vocabulary of the
// tricky tokens), and main runs the same check over 3000 lists of its
// own (a fixed generator) for the suite.
// EXPECT: true
// (0.26.4) Its PRNG and checksums are written wrapping_*.
use std::cli::Arg; use std::cli::Command; use std::cli::Matches;

fn command(gpa: Gpa) -> Command<'static, Gpa> {
    Command::new_in("prog", gpa).version("1")
        .arg(Arg::flag("verbose").short(b'v' as char))
        .arg(Arg::option("out").short(b'o' as char).default("-"))
        .arg(Arg::option("n").short(b'n' as char))
        .arg(Arg::positional("input").required())
        .arg(Arg::positional("rest").multiple())
        .subcommand(Command::new_in("add", gpa)
            .arg(Arg::flag("force").short(b'f' as char))
            .arg(Arg::positional("what")))
}

const WORDS: [&str; 24] = [
    "-", "--", "-v", "-vv", "-vo", "-ov", "--out", "--out=", "--out=x", "-o", "-o=",
    "-n", "--n=-5", "-5", "x", "add", "-f", "--force", "--zz", "-vx", "--verbose=1", "=", "-h",
    "--version",
];

// Every accessor on m and its subcommand; a checksum of what they give.
fn touch(m: &Matches<'_, Gpa>) -> i64 {
    let mut t = m.count("verbose") as i64 + m.values("rest").len() as i64 + m
        .values("out")
        .len() as i64;
    if m.flag("n") {
        t += 1;
    }
    match m.get_as::<i64>("n") {
        Ok(n) => t += n,
        Err(e) => t += e.exit_code() as i64,
    }
    t += m.get("input").unwrap_or("").len() as i64;
    match m.subcommand() {
        Some((_, sub)) => {
            t += sub.count("force") as i64 + sub.values("what").len() as i64;
            if sub.get("what").is_some() {
                t += 1;
            }
        }
        None => {}
    }
    t
}

fn check(cmd: &Command<'_, Gpa>, picks: &[i64], gpa: Gpa) -> i64 {
    let mut toks: Vec<&str, Gpa> = Vec::new_in(gpa);
    toks.push("prog");
    for &p in picks {
        let k = if p < 0 { 0 - (p % 24) } else { p % 24 };
        toks.push(WORDS[k as usize]);
    }
    match cmd.parse(toks.iter().copied()) {
        Ok(m) => touch(&m),
        Err(e) => {
            let text = cmd.render_in(e, gpa);
            text.len() as i64 + e.exit_code() as i64
        }
    }
}

#[property]
fn parse_never_panics(picks: &Vec<i64, Gpa>) {
    let gpa = *picks.allocator();
    let _ = check(&command(gpa), picks.as_slice(), gpa);
}

fn main(gpa: Gpa) -> i32 {
    let cmd = command(gpa);
    let mut seed: u64 = 0x9e3779b97f4a7c15;
    let mut total: i64 = 0;
    let mut picks: Vec<i64, Gpa> = Vec::new_in(gpa);
    for _ in 0..3000 {
        picks.clear();
        seed = seed.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        let n = ((seed >> 33) % 7) as i64;
        for _ in 0..n {
            seed = seed.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
            picks.push(((seed >> 33) % 24) as i64);
        }
        total += check(&cmd, picks.as_slice(), gpa);
    }
    println("{}", total > 0);
    0
}
