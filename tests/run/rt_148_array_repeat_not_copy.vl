// XFAIL: RT-148: an array repeat `[e; N]` of a value that is not Copy is accepted: the value is copied bitwise N times and dropped N times (double free, double Drop) (0.30.2)
// rustc refuses each of the four (E0277 "the trait bound `..: Copy` is not
// satisfied ... required because this value will be copied for each element
// of the array"; rustc twin: r302d_001_array_repeat_not_copy.rs.txt, 4 errors).
// vole builds it: under --check-alloc `[v; 2]` ends in `double free: block #1
// ... freed at main's end, freed again`; `[D { k: 1 }; 3]` prints `drop 1`
// three times for one value; a generic `[t; 2]` and an `impl FnMut` value
// (whose copies share one Vec buffer: use after free once one grows) the
// same. Neither synth_mode's nor check_mode's Repeat arm asks for Copy (a
// const item as the element is Rust's other allowed form). Since v0.28.0.
// ERROR: Copy
// ERROR: line 40
// ERROR-COUNT: 4
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn rep<T>(t: T) -> [T; 2] {
    [t; 2]
}

fn mk_push(gpa: Gpa) -> impl FnMut() -> usize {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    move || {
        v.push(1);
        v.len()
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let a = [v; 2];
    println("{} {}", a[0].len(), a[1].len());
    let d = [D { k: 1 }; 3];
    println("{}", d.len());
    let b = rep(D { k: 2 });
    println("{}", b.len());
    let mut f = [mk_push(gpa); 2];
    println("{}", (f[0])());
    println("{}", (f[1])());
    0
}
