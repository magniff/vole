// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice Windows.
// EXPECT: 2
use std::slice::Windows;

fn n(w: Windows<'_, i64>) -> usize {
    w.count()
}

fn main() {
    let s: &[i64] = &[1, 2, 3];
    println("{}", n(s.windows(2)));
}
