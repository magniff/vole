// RULE: D19.1
// (0.30.2, RT-91) A closure whose result is a struct of the program holding a
// closure: the outer closure's X_C was made
// before the inner one's, so its type's slots were counted without them
// (0.30.1: a compiler panic, places/regions.vl code_universal). A
// closure's X_C is made after those of the closures its type holds
// (closures/kinds.vl sig_slots_ordered).
// EXPECT: 90
struct Wrap<I> {
    it: I,
}

fn main() {
    let w = [1i64, 2];
    let v = [10i64, 20];
    let s: i64 = w
        .iter()
        .map(|y| Wrap { it: v.iter().map(move |x| x * y) })
        .map(|m| m.it.sum::<i64>())
        .sum();
    println("{s}");
}
