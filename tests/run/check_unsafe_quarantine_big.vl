// FLAGS: --check-unsafe
// EXIT: 101
// STDERR: unsafe access after free: 8 bytes at offset 0 of a block of 8 bytes
// 0.30.1: a block that alone is more than the quarantine's 64 MB is given
// back to C at once, and only it: a small Box freed before it stays held,
// and its use after the free is still reported. (Earlier on 0.30.1's
// branch the big block, the newest, was given back last, after every
// block held before it.)
fn main(gpa: Gpa) {
    let b = Box::new_in(41u64, gpa);
    let p = &*b as *const u64;
    drop(b);
    let v: Vec<u8, Gpa> = Vec::from_elem_in(1u8, 96 << 20, gpa);
    drop(v);
    // UNSAFE: deliberately after the free.
    // SAFETY: none: the program exists to be stopped.
    println("read {}", unsafe { *p });
}
