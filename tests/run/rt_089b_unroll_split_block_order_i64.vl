// FLAGS: -O2
// From the review of RT-61's fix. rustc prints the EXPECT line; -O2 printed 2384.
// EXPECT: 1542864
#[inline(never)]
fn grow(log: &mut [i64], b: &[i64]) -> i64 {
    let mut acc: i64 = 1;
    for i in 0..b.len() {
        if b[i] > 50 {
            log[i] = 1;
        }
        let bonus = acc.wrapping_add(b[i]);
        if b[i] < 10 {
            log[i] = 2;
        }
        acc = acc.wrapping_add(bonus);
    }
    acc
}

fn main() {
    let mut b: [i64; 16] = [0; 16];
    for i in 0..16 {
        b[i] = (i as i64 * 37) % 101;
    }
    let mut log: [i64; 16] = [0; 16];
    println("{}", grow(&mut log, &b));
}
