// The name of an alias-&mut parameter shadowed in the ensures, then the shadow written: allowed (writes its own).
type R<'a> = &'a mut i64;

fn f(p: R<'_>) -> i64
    ensures {
    let mut p = 3i64;
    p += 1;
    p > 0
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
