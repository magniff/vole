// XFAIL: RT-376: an associated function called through a type parameter's associated type, `T::Out::default()` (unknown module 'T' in the instance) and `<T as Tr>::Out::default()` (a parser error after `::Out`), is refused (0.30.2)
// rustc prints `0 0 0` (twin .rs.txt). vole: `error[type error] unknown
// module 'T' | note: in instantiation of 'df<W>'` and `error[parser
// error] expected ';' or '}' after expression, got '::'`; v0.28.0 to
// v0.30.1 the same. `Default::default()` with the result type T::Out
// builds. RT-174 is `<X::Out as C>::m` (a projection as a qualified
// path's Self); RT-221's `unknown module 'I'` is std's IndexMut path.
// EXPECT: 0 0 0
trait Tr {
    type Out: Default + std::fmt::Debug;
}

struct W {
    k: i64,
}

impl Tr for W {
    type Out = i64;
}

fn df<T: Tr>() -> T::Out {
    T::Out::default()
}

fn df3<T: Tr>() -> T::Out {
    <T as Tr>::Out::default()
}

fn df4<T: Tr>() -> T::Out {
    Default::default()
}

fn main() {
    println("{:?} {:?} {:?}", df::<W>(), df3::<W>(), df4::<W>());
}
