// EDITION: rust
// RULE: F30.3
// A raw pointer is not indexed, as in Rust (E0608): `*p.add(i)` reads
// an element, `slice::from_raw_parts(p, n)` makes a slice.
// ERROR: error[type error]: cannot index into a value of type '*u8'
fn get(p: *const u8, i: usize) -> u8 {
    // UNSAFE: the caller's pointer.
    // SAFETY: p is valid for i + 1 bytes (the caller below).
    unsafe { p[i] }
}

fn main() {
    let b = [1u8, 2, 3];
    let x = get(&b[0] as *const u8, 1);
}
