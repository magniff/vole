// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::boxed Box.
// EXPECT: 6
use std::alloc::Allocator;
use std::boxed::Box;

enum List<A: Allocator> {
    Cons(i64, Box<List<A>, A>),
    Nil,
}

fn sum<A: Allocator>(l: &List<A>) -> i64 {
    match l {
        List::Cons(x, rest) => *x + sum(rest),
        List::Nil => 0,
    }
}

fn main(gpa: Gpa) {
    let l = List::Cons(1,
        Box::new_in(List::Cons(2, Box::new_in(List::Cons(3, Box::new_in(List::Nil, gpa)), gpa)),
            gpa));
    println("{}", sum(&l));
}
