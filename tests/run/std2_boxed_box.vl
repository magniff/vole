// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::boxed Box.
// EXPECT: 6
use std::boxed::Box;

enum List {
    Cons(i64, Box<List, Gpa>),
    Nil,
}

fn sum(l: &List) -> i64 {
    match l {
        List::Cons(x, rest) => *x + sum(rest),
        List::Nil => 0,
    }
}

fn main(gpa: Gpa) {
    let l = List::Cons(1,
        Box::new_in(List::Cons(2, Box::new_in(List::Cons(3, Box::new_in(List::Nil, gpa)), gpa)),
            gpa));
    println("{}", sum(&l));
}
