// pushing a view T into a Vec<T> outliving the viewed Vec
// ERROR: [own.escape]: 'words' is used here, but 'v', which it views, was dropped
fn store<T>(dst: &mut Vec<T, Gpa>, x: T) { dst.push(x); }

fn main(gpa: Gpa) {
    let mut words: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        store(&mut words, v.as_slice());
    }
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println("{}", words[0][5]);
}
