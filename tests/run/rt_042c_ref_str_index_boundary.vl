// XFAIL: RT-42c: indexing through a `&&str` or a `&mut &str` is not checked for char boundaries: an invalid str in safe code (open)
// `&r[0..1]` of `r = &s`, s = "éa" (bytes C3 A9 61), and `&s[0..1]` of a
// parameter `s: &mut &str`, are the str [C3]: from_utf8 refuses its
// bytes, and vole prints `false` twice and exits 0. rustc panics: "byte
// index 1 is not a char boundary; it is inside 'é' (bytes 0..2) of `éa`"
// (exit 101), as vole does for `&s[0..1]` of the `&str` itself. The
// boundary check (RULE Z9.1b, front/check/synth_mode.vl synth_index)
// matches only a base whose type is `str_type` exactly; through a
// reference to a reference the index is read as a byte range (RT-42 is
// the same root, for a `&mut str`).
// STDERR: not a char boundary
// EXIT: 101
fn g<'a>(s: &mut &'a str) -> &'a str {
    &s[0..1]
}

fn main() {
    let mut s = "éa";
    let r = &s;
    let u: &str = &r[0..1];
    println("{}", std::str::from_utf8(u.as_bytes()).is_ok());
    let t = g(&mut s);
    println("{}", std::str::from_utf8(t.as_bytes()).is_ok());
}
