// a closure growing a captured owned let while a view of it is used after
// ERROR: borrowck.borrow_immutable
fn main(gpa: Gpa) {
    let mut v0: Vec<i64, Gpa> = Vec::new_in(gpa);
    v0.push(7);
    let v = v0;
    let s = v.as_slice();
    let c = || { for i in 0..1000 { v.push(i); } };
    c();
    println("{}", s[0]);
}
