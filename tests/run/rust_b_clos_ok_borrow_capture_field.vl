// EDITION: rust
// RULE: D19.10, D1.3
// (0.27.2) `|| &s.n` returns a reference into a `&` capture: the loan of
// `(*(*env).s).n` is supported by the capture's region, which outlives the
// result by a requirement; the result keeps `s` borrowed in `main`.
// EXPECT: 4
struct S {
    n: i64,
}

fn main() {
    let s = S { n: 4 };
    let f = || &s.n;
    let r = f();
    println("{}", *r);
}
