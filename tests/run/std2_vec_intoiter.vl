// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec IntoIter.
// EXPECT: 2
use std::vec::IntoIter;

fn n(it: IntoIter<i64, Gpa>) -> usize {
    it.count()
}

fn main(gpa: Gpa) {
    println("{}", n(Vec::from_in([1, 2], gpa).into_iter()));
}
