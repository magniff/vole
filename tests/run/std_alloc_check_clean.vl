// FLAGS: --check-alloc
// RULE: Z5.1
// The std item(s): std::alloc Gpa::live_blocks, Gpa::check_leaks.
// EXPECT: 100 1
// EXPECT: 0 true
// A program that frees what it allocates: no block is listed at exit
// (the runner fails a std case whose blocks are left).
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut i = 0;
    while i < 100 {
        v.push(i);
        i += 1;
    }
    println("{} {}", v.len(), gpa.live_blocks());
    drop(v);
    println("{} {}", gpa.live_blocks(), gpa.check_leaks());
}
