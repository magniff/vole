// XFAIL: RT-193: `v.into() as usize` with `V: Into<i64>` is refused when v comes from a for loop over `I: Iterator<Item = V>` (or `(K, V)`): "'into' needs the type it converts to: 'u8' into what?" in the instance (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_023_into_bound_lost_through_iterator_item.rs.txt):
// in the generic body v is a V, and V's only Into bound says the target, i64.
// vole refuses f4 (line 8) and f5 (line 20) per instance (`note: in instantiation
// of 'f5<IntoIter<u8, [u8; 2]>, u8>'`), where v is a u8 with many Into impls;
// `v.into()` with a parameter `v: V` (not a loop item) works, and so does
// `n += v.into()` with n an i64 (f6). Since v0.28.0.
// EXPECT: 6
// EXPECT: 6
// EXPECT: 6
fn f4<I, K, V>(it: I) -> usize
    where
        I: Iterator<Item = (K, V)>,
        V: Into<i64>,
{
    let mut n = 0;
    for (_k, v) in it {
        n += v.into() as usize;
    }
    n
}

fn f5<I, V>(it: I) -> usize
    where
        I: Iterator<Item = V>,
        V: Into<i64>,
{
    let mut n = 0;
    for v in it {
        n += v.into() as usize;
    }
    n
}

fn f6<I, K, V>(it: I) -> i64
    where
        I: Iterator<Item = (K, V)>,
        V: Into<i64>,
{
    let mut n = 0i64;
    for (_k, v) in it {
        n += v.into();
    }
    n
}

fn main() {
    println("{}", f4([(1i64, 2u8), (3, 4)].into_iter()));
    println("{}", f5([2u8, 4].into_iter()));
    println("{}", f6([(1i64, 2u8), (3, 4)].into_iter()));
}
