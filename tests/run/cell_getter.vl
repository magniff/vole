// (0.26.1) own.interior_copy: std's copying getter gives a copy of a cell,
// another cell, so a write through it would be lost.
// ERROR: [own.interior_copy]: a copy of a 'Cell<i64>' is another cell: a write through it is lost
// ERROR: cell_getter.vl:11 --old 'v.get(0)' --new 'v[0]'
// ERROR: [own.interior_copy]: a copy of a 'Cell<i64>' is another cell
use std::cell::Cell;

fn main(gpa: Gpa) {
    var v: Vec<Cell<i64>> = Vec::new_in(gpa);
    v.push(Cell::new(1));
    let a = v.get(0);
    a.set(9);
    let b = v.last().unwrap();
    b.set(8);
}
