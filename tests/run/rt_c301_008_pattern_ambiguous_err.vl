// RULE: F8.3, F9.3, F5.1
// `W::m(&w)` of a generic struct whose two traits' pattern impls
// (`impl<T> A for W<T, u8>`) both give m: rustc E0034. 0.30.1 called A's.
// ERROR: error[method.ambiguous]: multiple applicable items: 'm' is an item of more than one trait for 'W'
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct W<T, U> { t: T, u: U }
impl<T> A for W<T, u8> { fn m(&self) -> i64 { 1 } }
impl<T> B for W<T, u8> { fn m(&self) -> i64 { 2 } }
fn main() { let w = W { t: 0i64, u: 0u8 }; println("{}", W::m(&w)); }
