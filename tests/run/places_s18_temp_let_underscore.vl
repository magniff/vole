// places IR, S18: let _ = e: a value dropped at once, a place mentioned
// sem-own: `let _ = e` of an owned value: dropped at once (Rust: at once).
// EXPECT: drop 1
// EXPECT: end
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn eat
// PLACES: drop(_1) [kept]
// PLACES: fn main
// PLACES: drop(_2) [kept]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    let _ = mk(1, gpa);
    println("end");
}
