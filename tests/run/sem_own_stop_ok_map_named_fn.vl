// XFAIL: gap 20: xfail case fails differently: type error: 'inout fn' does not satisfy FnOnce of Option::map (another failure)
// sem-own (iterator stopgap): a named let fn given to map: should be accepted (the 0.24 notes list it as a known overbreadth).
// MVS's XFAIL: DIAG/OVERSTRICT a let fn refused for map: the message prints the bound as FnMut(D), not FnMut(sink D)
// EXPECT: 3
// EXPECT: drop 1
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn two(gpa: Gpa) -> Vec<D<Gpa>, Gpa> {
    let mut w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa); w.push(mk(1, gpa)); w.push(mk(2, gpa)); w
}

fn idof(d: &D<Gpa>) -> i64 { d.id }
impl Clone for D<Gpa> { fn clone(&self) -> D<Gpa> { D { id: self.id + 100, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let w = two(gpa);
    let s: i64 = w.iter().map(idof).sum();
    println("{s}");
}
