// values left in the channel when both ends drop: dropped once each
// FLAGS: --check-alloc
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: drop 2
use std::sync::mpsc;
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<R, Gpa>(gpa);
    tx.send(R { id: 1 }).ok().unwrap();
    tx.send(R { id: 2 }).ok().unwrap();
    let r = rx.recv().ok().unwrap();
    println("got {}", r.id);
}
