// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: two P's over the same v
// ERROR: error[own.conflict]
struct P<A: Allocator> { q: inout Vec<i64, A> }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    var p = P { q: &v };
    var r = P { q: &v };
    p.q.push(1);
    r.q.push(2);
    println(v.len());
    0
}
