// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::sources from_fn.
// EXPECT: [1, 2, 3]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let mut n = 0i64;
    let v: Vec<i64, Gpa> = std::iter::from_fn(|| {
        n += 1;
        if n <= 3 { Some(n) } else { None }
    }).collect_in(gpa);
    println("{:?}", v);
}
