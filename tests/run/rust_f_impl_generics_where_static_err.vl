// (0.30.1, review 2) An impl's function that adds `where I::Item:
// 'static` to its trait's, which has none: rustc refuses the impl
// (E0276). vole does not compare the where clauses yet; the predicate is
// proven where the impl's function is instantiated, so a generic caller
// through the trait that passes a `v.iter()` of a local is refused there.
// Before, the predicate was not proven and a borrowed item reached a
// thread after it was freed.
// ERROR: borrowck.param_outlives
// ERROR-COUNT: 1
use std::thread;
use std::fmt::Display;
use std::thread::JoinHandle;

trait Tr {
    fn f<I: Iterator + Send>(&self, i: I, gpa: Gpa) -> JoinHandle<i64,
        Gpa> where I::Item: Display + Send;
}

struct S;

impl Tr for S {
    fn f<I: Iterator + Send>(&self, i: I, gpa: Gpa) -> JoinHandle<i64,
        Gpa> where I::Item: Display + Send + 'static {
        let mut out: Vec<I::Item, Gpa> = Vec::new_in(gpa);
        for x in i {
            out.push(x);
        }
        thread::spawn_in(move || {
            for x in out.iter() {
                println("thread {}", x);
            }
            0i64
        }, gpa)
    }
}

fn go<X: Tr>(x: &X, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    x.f(v.iter(), gpa)
}

fn main(gpa: Gpa) {
    go(&S, gpa).join();
}
