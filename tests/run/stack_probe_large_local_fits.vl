// (0.30.1) Frames of a page or more are probed page by page, top to
// bottom (rustc's stack clash protection): a large frame that fits runs
// as before. 2 MiB and a page on the main thread (an 8 MiB stack; -O0
// keeps two copies of the array), 1 MiB and a page on a spawned thread
// (8 MiB), and an over-aligned frame (its probes reach the aligned
// bottom); each written at both ends.
// EXPECT: main 2101248 1 2
// EXPECT: thread 1052672 3 4
// EXPECT: aligned 0 5
use std::thread;

#[repr(C, align(4096))]
struct Wide {
    b: [u8; 16384],
}

#[inline(never)]
fn on_main(k: usize) -> usize {
    let mut a = [0u8; 2101248];
    a[0] = 1;
    a[a.len() - 1] = 2;
    println("main {} {} {}", a.len(), a[k - 1], a[a.len() - k]);
    a.len()
}

#[inline(never)]
fn on_thread(k: usize) -> usize {
    let mut a = [0u8; 1052672];
    a[0] = 3;
    a[a.len() - 1] = 4;
    println("thread {} {} {}", a.len(), a[k - 1], a[a.len() - k]);
    a.len()
}

#[inline(never)]
fn aligned(k: usize) -> usize {
    let mut w = Wide { b: [0u8; 16384] };
    w.b[16383] = 5;
    let at = &w as *const Wide as usize;
    println("aligned {} {}", at % 4096, w.b[16384 - k]);
    at
}

fn main(gpa: Gpa) {
    let k = std::env::args().count();
    on_main(k);
    let h = thread::spawn_in(move || on_thread(k), gpa);
    h.join().unwrap();
    aligned(k);
}
