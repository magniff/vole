// EDITION: rust
// sem-own: `?` inside a closure returning Result: the closure's locals dropped on the early return.
// EXPECT: drop 1
// EXPECT: r -1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn g() -> Result<i64, i64> { Err(-1i64) }

fn main(gpa: Gpa) {
    let f = |k: i64| -> Result<i64, i64> { let a = mk(k, gpa); let n = g()?; Ok(n + a.id) };
    println("r {}", match f(1) { Ok(x) => x, Err(e) => e });
}
