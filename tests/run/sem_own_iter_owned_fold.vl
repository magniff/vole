// sem-own: fold over owned items, the closure reading each: dropped in the closure (0.25.3).
// EXPECT: drop 0
// EXPECT: drop 1
// EXPECT: s 1
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let s = (0..2).map(|i| mk(i, gpa)).fold(0, |a, d| a + d.id);
    println("s {s}");
}
