// 0.30: the forms of a raw pointer's place that Rust spells `(*p).f`,
// which vole also writes `p.f` and `p.0` (a field through a raw pointer to
// a struct or a tuple), drop the old value as `(*p).f = v` does; so does
// `*p = v` as an arm's value, in a closure and behind `?`. A String is
// freed (FLAGS).
// FLAGS: --check-alloc
// EXPECT: field
// EXPECT: mk2
// EXPECT: d1
// EXPECT: mk4
// EXPECT: d3
// EXPECT: --
// EXPECT: one
// EXPECT: d4
// EXPECT: d2
// EXPECT: arm
// EXPECT: mk6
// EXPECT: d5
// EXPECT: closure
// EXPECT: mk8
// EXPECT: d7
// EXPECT: try
// EXPECT: mk10
// EXPECT: d9
// EXPECT: ok 10
// EXPECT: d10
// EXPECT: d8
// EXPECT: d6
// EXPECT: heap
// EXPECT: two
// EXPECT: end

use std::alloc::Allocator;

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

struct H<A: Allocator> { f: T, s: String<A> }

fn put(p: *mut T, ok: bool) -> Result<i64, i64> {
    let id: i64 = if ok { Ok(10) } else { Err(0) }?;
    // UNSAFE: a write through a raw pointer.
    // SAFETY: a contract on the caller: p is valid and its T initialized.
    unsafe { *p = mk(id); }
    Ok(id)
}

fn main(gpa: Gpa) -> i32 {
    println("field");
    {
        let mut h = H { f: T { id: 1 }, s: String::from_in("one", gpa) };
        let p = &mut h as *mut H<Gpa>;
        let mut t = (T { id: 3 }, 0i64);
        let q = &mut t as *mut (T, i64);
        // UNSAFE: writes through raw pointers.
        // SAFETY: p is h's address and q is t's, both initialized.
        unsafe {
            p.f = mk(2);
            q.0 = mk(4);
        }
        println("--");
        println("{}", h.s);
    }
    println("arm");
    let mut a = T { id: 5 };
    let pa = &mut a as *mut T;
    let k = 1;
    match k {
        // UNSAFE: a write through a raw pointer.
        // SAFETY: pa is a's address, a initialized.
        1 => unsafe { *pa = mk(6) },
        _ => {}
    }
    println("closure");
    let mut c = T { id: 7 };
    let pc = &mut c as *mut T;
    let f = || {
        // UNSAFE: a write through a raw pointer.
        // SAFETY: pc is c's address, c initialized and live past f.
        unsafe { *pc = mk(8); }
    };
    f();
    println("try");
    let mut d = T { id: 9 };
    let pd = &mut d as *mut T;
    let _ = put(pd, false);
    match put(pd, true) {
        Ok(n) => println("ok {n}"),
        Err(_) => println("err"),
    }
    drop(d);
    drop(c);
    drop(a);
    println("heap");
    {
        let mut h = H { f: T { id: 0 }, s: String::from_in("one", gpa) };
        let p = &mut h as *mut H<Gpa>;
        // UNSAFE: a write through a raw pointer.
        // SAFETY: p is h's address, h initialized.
        unsafe { p.s = String::from_in("two", gpa); }
        println("{}", h.s);
        std::mem::forget(h.f);
    }
    println("end");
    0
}
