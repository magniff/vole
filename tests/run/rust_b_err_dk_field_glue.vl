struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

struct W<'a> {
    h: HD < 'a >,
    k: i64,
}

fn main() {
    let z: i64 = 0;
    let mut w = W { h: HD { r: &z }, k: 1 };
    let x: i64 = 1;
    w = W { h: HD { r: &x }, k: 2 };
    println("{}", w.k);
}
