// FLAGS: --check-unsafe
// REQUIRES: macos
// EXPECT: peak under 160 MB: true
// 0.30.1: the blocks --check-unsafe holds back from C once freed are at
// most 64 MB: a block that alone is more is given back at once, the one
// just freed too. Four Vecs of 96 MB made and dropped one after another
// need 96 MB at a time, under the check as without it (were the last one
// held, two at a time). (macOS: getrusage's peak is in bytes.)
extern "C" {
    fn getrusage(who: i32, usage: *mut i64) -> i32;
}

fn main(gpa: Gpa) {
    let mut s = 0u64;
    for i in 0..4u64 {
        let v: Vec<u8, Gpa> = Vec::from_elem_in(i as u8 + 1, 96 << 20, gpa);
        s += v[(96 << 20) - 1] as u64;
    }
    let mut u = [0i64; 18];
    // UNSAFE: C's getrusage.
    // SAFETY: u has the 144 bytes of a struct
    // rusage; its peak resident size is the fifth word.
    let r = unsafe { getrusage(0, &mut u[0] as *mut i64) };
    println("peak under 160 MB: {}", r == 0 && s == 10 && u[4] < 160 << 20);
}
