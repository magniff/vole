// XFAIL: RT-152: a trait default's or a generic impl's method call is refused as ambiguous (E0034) in an instance whose type implements two traits with that method; rustc picks the bound's (0.30.2)
// From g302qual (pre-existing, v0.30.1 too; m1). The same family as RT-72.
// EXPECT: 10 1 2
trait A { fn m(&self) -> i64; fn go(&self) -> i64 { self.m() * 10 } }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn ga<T: A>(t: &T) -> i64 { t.m() }
fn gb<T: B>(t: &T) -> i64 { t.m() }
fn main() { let s = S; println("{} {} {}", s.go(), ga(&s), gb(&s)); }
