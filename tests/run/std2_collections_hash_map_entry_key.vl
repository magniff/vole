// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Entry::key.
// EXPECT: 4 5
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(4, 0);
    let a = *m.entry(4).key();
    let b = *m.entry(5).key();
    println("{} {}", a, b);
}
