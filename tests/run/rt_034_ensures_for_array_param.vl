// RT-34: `for d in a` over an array parameter in a function with an
// `ensures` (its body in `f$body`, made by the compiler) moved each
// element out and then dropped the array again: `took 1 drop 1 drop 1`.
// Lowered under Rust's rules as itself, each element drops once, as
// without the clause (rustc prints the EXPECT lines).
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: took 1
// EXPECT: drop 1
// EXPECT: took 2
// EXPECT: drop 2
// EXPECT: 4
// EXPECT: 6
// EXPECT: took 9
// EXPECT: drop 9
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

fn f(a: [D; 1], n: i64) -> i64
    ensures result > 0
{
    for d in a {
        take(d);
    }
    n
}

fn sum(a: [D; 2], n: i64) -> i64
    requires n > 0
    ensures result >= 0
{
    let mut s = 0;
    for d in a {
        s += d.v;
        take(d);
    }
    s + n
}

fn count(a: &[i64; 3]) -> i64
    requires a.len() == 3
{
    let mut c = 0;
    for x in a {
        c += *x;
    }
    c
}

fn main() {
    println("{}", f([D { v: 1 }], 1));
    println("{}", sum([D { v: 1 }, D { v: 2 }], 1));
    println("{}", count(&[1, 2, 3]));
    let g = |a: [D; 1]| {
        for d in a {
            take(d);
        }
    };
    g([D { v: 9 }]);
}
