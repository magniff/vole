// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str CharIndices::offset.
// EXPECT: 0 1 3 4
use std::str::CharIndices;

fn main() {
    let mut it = "aßc".char_indices();
    let a = it.offset();
    it.next();
    let b = it.offset();
    it.next();
    let c = it.offset();
    it.next();
    println("{} {} {} {}", a, b, c, it.offset());
}
