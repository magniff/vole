// RULE: C3
// (0.27.1) `ensures` in the rust edition: `result` and the parameters
// read at exit, a `&mut i64` parameter's referent through `shared(..)`
// (the body's reborrow is dead by then: borrowck D17.3).
// EXPECT: 3 5
// EXIT: 101
// STDERR: ensures failed: 'result >= s.x' of 'get'
struct S {
    x: i64,
}

fn get(s: &S, k: i64) -> i64
    ensures result >= s.x
{
    s.x + k
}

fn bump(v: &mut i64, by: i64)
    ensures * v >= by
{
    *v += by;
}

fn main() {
    let s = S { x: 2 };
    let mut a: i64 = 1;
    bump(&mut a, 4);
    println("{} {}", get(&s, 1), a);
    println("{}", get(&s, -1));
}
// (passes on std2: was XFAIL, std2 has no contract_check, which a contract's lowering calls (std2))
