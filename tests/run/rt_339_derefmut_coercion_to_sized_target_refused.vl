// XFAIL: RT-339: a DerefMut coercion to a sized target, `put(&mut b)` with `B: DerefMut<Target = In>`, is refused: "expected '&mut In', got '&mut B'" (0.30.2)
// rustc prints the EXPECT line. Since v0.30.1 at least. From the
// re-review of g302index.
// EXPECT: 9
use std::ops::{Deref, DerefMut};

struct In {
    v: i64,
}

struct B {
    a: In,
}

impl Deref for B {
    type Target = In;

    fn deref(&self) -> &In {
        &self.a
    }
}

impl DerefMut for B {
    fn deref_mut(&mut self) -> &mut In {
        &mut self.a
    }
}

fn put(i: &mut In) {
    i.v = 9;
}

fn main() {
    let mut b = B { a: In { v: 1 } };
    put(&mut b);
    println("{}", b.a.v);
}
