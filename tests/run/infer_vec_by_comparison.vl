// EXPECT: 2 1 7
// 0.29: a list's element type fixed only by comparing an element with a
// literal: the operator is asked of the type the literal gave the
// element, not of the unsolved variable (that was "equality requires
// ..., got '_'", and for `<` "comparison requires numeric type"). The
// literal's type is the element's from there on: an i32, as an integer
// literal nothing else types.
fn equal_to(gpa: Gpa, k: i32) -> i64 {
    let mut v = Vec::new_in(gpa);
    let mut n = 0;
    for i in 0..v.len() {
        if v[i] == 3 {
            n += 1;
        }
    }
    v.push(k);
    v.push(3);
    v.push(3);
    for i in 0..v.len() {
        if v[i] == 3 {
            n += 1;
        }
    }
    n
}

fn above(gpa: Gpa) -> i64 {
    let mut v = Vec::new_in(gpa);
    let mut n = 0;
    for x in v.iter() {
        if *x > 0 {
            n += 100;
        }
    }
    v.push(5);
    v.push(-5);
    for x in v.iter() {
        if *x > 0 {
            n += 1;
        }
    }
    n
}

fn main(gpa: Gpa) -> i32 {
    let mut w = Vec::new_in(gpa);
    w.push(7u8);
    let big = if w[0] != 0 { w[0] } else { 0 };
    println("{} {} {}", equal_to(gpa, 9), above(gpa), big);
    0
}
