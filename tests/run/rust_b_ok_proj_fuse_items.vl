// RULE: D4.4
// (0.27.2) A projection in a signature is the associated type its impl
// defines for the substitution, its regions the substitution's own:
// `Fuse<I>::next(&mut self) -> Option<I::Item>` with `I = Iter<'a, i32>`
// returns `Option<&'a i32>`, not tied to `&mut self` (E3), so two items
// live at once are not borrowck.mut_twice, and Fuse's own body may reset
// its iterator while the item it returns is live.
fn main() {
    let a = [1i32, 2, 3];
    let mut it = a.iter().fuse();
    let x = it.next();
    let y = it.next();
    let mut s: i32 = 0;
    while let Some(z) = it.next() {
        s += *z;
    }
    println("{} {} {}", *x.unwrap(), *y.unwrap(), s);
}
// EXPECT: 1 2 3
