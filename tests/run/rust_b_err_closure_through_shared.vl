// RULE: D2.7
// FLAGS: --check-alloc
// (0.30.1) In a closure body, a `&mut` reached through a captured shared
// reference is behind a `&` there as anywhere: a write through it and a
// mutable view of it given to a call are rustc's E0594/E0596. The
// closure's own derefs (its env's, a by-reference capture's) are not the
// program's. Before, every place under a closure's env counted as
// mutable: `*r.p = 9` wrote under a live `&i64` (printed 9), and
// `clobber(r.s, gpa)` freed what `x` read (--check-alloc: a use after
// free).
// ERROR: error[borrowck.assign_immutable]
// ERROR: line 35, column 18
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 44, column 24
// ERROR-COUNT: 2
use std::alloc::Allocator;

struct P<'a> {
    p: &'a mut i64,
}

struct W<'a, A: Allocator> {
    s: &'a mut [Vec<i64, A>],
}

fn clobber(s: &mut [Vec<i64, Gpa>], gpa: Gpa) {
    s[0] = Vec::new_in(gpa);
}

fn main(gpa: Gpa) {
    let mut a = 0i64;
    let w = P { p: &mut a };
    let r: &P = &w;
    let x: &i64 = &*r.p;
    let c = || { *r.p = 9; };
    c();
    println("{}", *x);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let mut arr = [v];
    let w2 = W { s: &mut arr };
    let r2: &W<Gpa> = &w2;
    let y: &i64 = &r2.s[0][0];
    let d = || clobber(r2.s, gpa);
    d();
    println("{}", *y);
}
