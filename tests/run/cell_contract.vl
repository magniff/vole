// (0.26.1) A contract condition may not read a cell (EFF_INTERIOR cannot
// tell a read from a write): compute the value in the body.
// ERROR: [contract.effect]: the 'requires' of 'need' calls 'Cell<i64>::get', which writes through a shared reference (a cell): a condition may not do io, allocate, touch statics or write through a shared reference
// ERROR: --why interior
use std::cell::Cell;

fn need(c: Cell<i64>, n: i64)
    requires c.get() > 0
{
    c.set(n);
}

fn main() {
    let c = Cell::new(1);
    need(c, 2);
}
