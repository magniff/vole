// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt DebugStruct.
// EXPECT: B { a: 1, b: true }
// EXPECT: B {
// EXPECT:     a: 1,
// EXPECT:     b: true,
// EXPECT: }
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        let mut d: std::fmt::DebugStruct<'_, '_> = f.debug_struct("B");
        d.field("a", &self.a);
        d.field("b", &self.b);
        d.finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
