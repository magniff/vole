// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::cmp max.
// EXPECT: 4 abc
use std::cmp::Ordering;

#[derive(Debug, Clone, Copy)]
struct P {
    x: i64,
}

impl PartialEq for P {
    fn eq(&self, other: &P) -> bool {
        self.x == other.x
    }
}

impl Eq for P {}

impl PartialOrd for P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for P {
    fn cmp(&self, other: &P) -> Ordering {
        self.x.cmp(&other.x)
    }
}

fn main() {
    println("{} {}", std::cmp::max(4, 1), std::cmp::max("abc", "ab"));
}
