// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c23_shorthand_requires)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// A requires reading a Copy by-value param only through a struct shorthand.
#[derive(Clone, Copy)]
struct P {
    v: i64,
}
fn g(p: P) -> bool { p.v == 4 }

fn f(v: i64) -> i64
    requires g(P { v })
    ensures g(P { v }) && result == 4
{
    v
}

fn main() {
    println("{}", f(4));
}
