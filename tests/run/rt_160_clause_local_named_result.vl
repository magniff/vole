// XFAIL: RT-160: a clause's own binding named `result` is taken as the function's result: `let result = x` in requires, a match arm's `Some(result)`, and a unit fn's ensures are refused (contract.result) (0.30.2)
// From g302holes (pre-existing, v0.30.1 too): expand.vl find_ident decides
// `result` by its symbol before names resolve. A clause's own binding
// shadows, as any local does.
// EXPECT: 4
// EXPECT: 4
// EXPECT: 4
fn f(x: i64) -> i64
    requires { let result = x; result > 0 }

{
    x + 1
}

fn main_r1() {
    println("{}", f(3));
}

fn g(x: i64)
    ensures { let result = x; result > 0 }

{
    println("{}", x);
}

fn main_r2() {
    g(4);
}

fn f3(x: Option<i64>) -> i64
    requires { match x { Some(result) => result > 0, None => true } }

{
    x.unwrap_or(0) + 1
}

fn main_r3() {
    println("{}", f3(Some(3)));
}

fn main() {
    main_r1();
    main_r2();
    main_r3();
}
