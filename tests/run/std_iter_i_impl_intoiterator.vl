// Runs on std since 0.27.2's switch.
// The std item(s): std::iter I::impl IntoIterator.
// EXPECT: 3

fn total<C: IntoIterator<Item = i64>>(c: C) -> i64 {
    let mut s = 0;
    for x in c {
        s += x;
    }
    s
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    println("{}", total(v.iter().copied()));
}
