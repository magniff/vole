// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice Split::impl DoubleEndedIterator.
// EXPECT: [3] [2] [1]
use std::slice::SliceIndex;

fn main() {
    let s: &[i64] = &[1, 0, 2, 0, 3];
    let mut it = s.split(|x| *x == 0);
    println("{:?} {:?} {:?}", it.next_back().unwrap(), it.next_back().unwrap(),
        it.next_back().unwrap());
}
