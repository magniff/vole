// EDITION: rust
// RULE: C5
// Checked since bc271 M3.
// (0.27.1) `old(e)` is refused when `e` holds a region: `old(x)` of a
// `&mut i64` (a view kept across the body), and `old(&n)` (a loan across
// the body, which C5 makes unreachable for borrowck D17.2); the rust
// edition offers no `old(e.clone())`.
// ERROR: error[contract.old]: 'old(x)'
// ERROR: error[contract.old]: 'old(&n)'
// ERROR-COUNT: 2
fn f(x: &mut i64) -> i64
    ensures result == *old(x) + 1
{
    *x += 1;
    *x
}

fn g(n: i64) -> i64
    ensures result == *old(&n)
{
    n
}

fn main() {
    let mut a: i64 = 1;
    println("{} {}", f(&mut a), g(2));
}
