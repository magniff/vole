// EDITION: rust
// a closure in a struct field returns a view of its argument; the Vec grown meanwhile
// ERROR: borrowck.return_local
#[derive(Clone, Copy)] struct H<F> { f: F }

fn main(gpa: Gpa) {
    let h = H { f: |d: Vec<i64, Gpa>| d.as_slice() };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = (h.f)(v);
    for i in 0..1000 { v.push(i); }
    println("{}", s[0]);
}
