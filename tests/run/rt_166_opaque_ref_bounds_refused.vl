// RULE: D21.5 (0.30.2, RT-166) A reference to an opaque value is a callee
// only as far as the opaque type's own bound lets a caller go, as rustc's
// impls for references: `&impl FnMut` is not Fn (its closure writes),
// `&impl FnOnce` is not Fn, `&mut impl FnOnce` is not FnMut, whatever
// the hidden closure is (rustc E0277 for each).
// ERROR: line 34
// ERROR: line 35
// ERROR: line 36
// ERROR-COUNT: 3
fn counter() -> impl FnMut() -> i64 {
    let mut n = 0i64;
    move || {
        n += 1;
        n
    }
}

fn once() -> impl FnOnce() -> i64 {
    move || 1
}

fn call<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn call_mut<F: FnMut() -> i64>(mut f: F) -> i64 {
    f()
}

fn main() {
    let mut c = counter();
    let o = once();
    let mut p = once();
    println("{}", call(&c));
    println("{}", call(&o));
    println("{}", call_mut(&mut p));
    println("{}", c());
}
