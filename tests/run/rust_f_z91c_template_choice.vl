// EDITION: rust
// RULE: Z9.1c
// XFAIL: Z9.1c not yet: an instance's call is resolved again in the instance, not the template's choice substituted (`(**self).tag()` with T = &str takes str's impl: 11, not 21)
// (0.27.5) A method call in a generic body is resolved once, on the
// template: `(**self).tag()` in the impl for `&T` is `<T as Tag>` for
// every T. With C = &&str the reference impl runs twice.
// EXPECT: 11 11 21
trait Tag {
    fn tag(&self) -> i64;
}

impl Tag for str {
    fn tag(&self) -> i64 {
        1
    }
}

impl<T: ?Sized + Tag> Tag for &T {
    fn tag(&self) -> i64 {
        (**self).tag() + 10
    }
}

fn via<C: Tag>(c: C) -> i64 {
    c.tag()
}

fn main() {
    let s: &str = "x";
    let r: &&str = &s;
    println("{} {} {}", r.tag(), via(s), via(r));
}
