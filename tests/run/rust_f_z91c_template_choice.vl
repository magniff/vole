// RULE: Z9.1c
// (0.27.5) A method call in a generic body is resolved once, on the
// template: `(**self).tag()` in the impl for `&T` is `<T as Tag>` for
// every T. With C = &&str the reference impl runs twice (0.27.4 took
// str's impl for `(**self)` with T = &str: 11, not 21).
// EXPECT: 11 11 21
trait Tag {
    fn tag(&self) -> i64;
}

impl Tag for str {
    fn tag(&self) -> i64 {
        1
    }
}

impl<T: ?Sized + Tag> Tag for &T {
    fn tag(&self) -> i64 {
        (**self).tag() + 10
    }
}

fn via<C: Tag>(c: C) -> i64 {
    c.tag()
}

fn main() {
    let s: &str = "x";
    let r: &&str = &s;
    println("{} {} {}", r.tag(), via(s), via(r));
}
