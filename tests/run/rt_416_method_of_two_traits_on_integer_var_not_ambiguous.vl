// XFAIL: RT-416: two traits each with a method `m`, one impl'd for i32 and one for i64, called as `a.m()` on an integer variable: vole accepts it; rustc E0034 (multiple applicable items) (0.30.2)
// From the review of the integer-literal work (t302int). Since v0.30.1 at least.
// ERROR: line 10
trait A { fn m(self) -> Self; }
impl A for i32 { fn m(self) -> i32 { self } }
trait B { fn m(self) -> Self; }
impl B for i64 { fn m(self) -> i64 { self } }

fn main() {
    let a = 2000000000;
    let b = a.m();
    let c: i64 = a + a;
    println("{} {}", b, c);
}
