// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt Formatter::debug_tuple.
// EXPECT: B(1, true)
// EXPECT: B(
// EXPECT:     1,
// EXPECT:     true,
// EXPECT: )
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_tuple("B").field(&self.a).field(&self.b).finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
