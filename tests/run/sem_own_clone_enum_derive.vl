// sem-own: #[derive(Clone)] on an enum with owned payloads: a deep copy.
// EXPECT: 1 0
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
#[derive(Clone)]
enum E<A: Allocator> { A(Vec<i64, A>), N }

fn main(gpa: Gpa) {
    let e = E::A(Vec::new_in(gpa));
    var f = e.clone();
    match &f { E::A(v) => v.push(1), E::N => {} }
    let a = match f { E::A(v) => v.len(), E::N => 0 };
    let b = match e { E::A(v) => v.len(), E::N => 0 };
    println("{a} {b}");
    println("end");
}
