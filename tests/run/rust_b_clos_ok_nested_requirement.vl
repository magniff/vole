// EDITION: rust
// RULE: D19.10
// (0.27.2) The inner closure stores a capture into a capture: its
// requirement is a constraint of the outer closure's body where the inner
// one is made, propagated again to `main` (both regions are `main`'s).
// EXPECT: 2
struct H<'a> {
    p: &'a i64,
}

fn main() {
    let a = 1;
    let b = 2;
    let mut h = H { p: &a };
    let r = &b;
    let mut outer = || {
        let mut inner = || {
            h.p = r;
        };
        inner();
    };
    outer();
    println("{}", *h.p);
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
