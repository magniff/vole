// RULE: F19.8
// (0.30.2, RT-43) RT-43's assignment through a generic union, Md<D>
// made by a generic `new`: `value: T` without `T: Copy` is refused once,
// at the declaration, by Md<D> and by the opaque Md<T> alike (with the
// bound, Md<D> could not be made).
// ERROR: error[union.field]: a union's field must be Copy, a reference or a `ManuallyDrop<T>`: field 'value' of union
// ERROR-COUNT: 1
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

union Md<T> {
    value: T,
    x: i64,
}

impl<T> Md<T> {
    fn new(v: T) -> Md<T> {
        Md { value: v }
    }
}

fn main() {
    let mut u = Md::new(D { v: 1 });
    u.x = 5;
    u.value = D { v: 3 };
    println("end");
}
