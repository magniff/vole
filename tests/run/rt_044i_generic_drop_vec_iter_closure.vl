// RULE: D19.1, D19.10
// (0.30.2, RT-44) An iterator's closure in a generic Drop impl whose
// instance a Vec's drop makes (while the bodies are built): it had no
// X_C slots (0.30.1: the compiler panicked, places/regions.vl).
// EXPECT: ok
// EXPECT: drop 12
struct W<T> {
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        let v = [1i64, 2, 3];
        let s: i64 = v.iter().map(|x: &i64| *x * 2).sum();
        println("drop {}", s);
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<W<u8>, Gpa> = Vec::new_in(gpa);
    v.push(W { t: 1u8 });
    let _ = &v[0].t;
    println("ok");
}
