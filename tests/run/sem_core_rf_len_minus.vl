// EDITION: rust
// i <= len - 1 with len == 0 is i <= -1: false, no index.
// EXPECT: 0
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], i: i64) -> i64 {
    if i >= 0 && i <= s.len() as i64 - 1 { s[i as usize] } else { 0 }
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(&s[0..0], 0 + unsafe { Z }));
    0
}
