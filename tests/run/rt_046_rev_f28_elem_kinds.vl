// FLAGS: -O2
// EXPECT: 2050
// EXPECT: 2050
// EXPECT: 2050
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

#[derive(Clone, Copy)]
struct P {
    x: i64,
    y: i64,
}

#[inline(never)]
fn r_arr(p: *const [[i64; 2]], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array
    unsafe {
        let a = (*p)[0][1];
        poke(q, 50);
        let b = (*p)[0][1];
        a * 1000 + b
    }
}

#[inline(never)]
fn r_tup(p: *const [(i64, i64)], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array
    unsafe {
        let a = (*p)[0].1;
        poke(q, 50);
        let b = (*p)[0].1;
        a * 1000 + b
    }
}

#[inline(never)]
fn r_struct(p: *const [P], q: *mut i64) -> i64 {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array
    unsafe {
        let a = (*p)[0].y;
        poke(q, 50);
        let b = (*p)[0].y;
        a * 1000 + b
    }
}

fn main() -> i32 {
    let mut a = [[1i64, 2], [3, 4]];
    let base = &mut a as *mut [[i64; 2]; 2] as *mut i64;
    // UNSAFE: both from a
    // SAFETY: a outlives them
    let (p, q) = unsafe {
        (std::slice::from_raw_parts_mut(&mut a as *mut [[i64; 2]; 2] as *mut [i64; 2], 2) as *mut [
            [i64; 2]] as *const [[i64; 2]], base.add(1))
    };
    println("{}", r_arr(p, q));
    let mut t = [(1i64, 2i64), (3, 4)];
    let tb = &mut t as *mut [(i64, i64); 2] as *mut i64;
    // UNSAFE: both from t
    // SAFETY: t outlives them
    let (tp, tq) = unsafe { (
        std::slice::from_raw_parts_mut(&mut t as *mut [(i64, i64); 2] as *mut (i64, i64), 2) as *mut [(i64, i64)] as *const [(i64, i64)], tb.add(1)) };
    println("{}", r_tup(tp, tq));
    let mut s = [P { x: 1, y: 2 }, P { x: 3, y: 4 }];
    let sb = &mut s as *mut [P; 2] as *mut i64;
    // UNSAFE: both from s
    // SAFETY: s outlives them
    let (sp, sq) = unsafe { (
        std::slice::from_raw_parts_mut(&mut s as *mut [P; 2] as *mut P, 2) as *mut [P] as *const [
            P], sb.add(1)) };
    println("{}", r_struct(sp, sq));
    0
}
