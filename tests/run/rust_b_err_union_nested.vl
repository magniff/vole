// RULE: M2, M8
// (0.30.1) An assignment through a union's field that is itself a union,
// `o.i.a = 7`, initializes neither o.i nor o (rustc's gather_init: only
// the immediate union base, and only when it has a move path of its own;
// nothing under a union's field has one). Before, it initialized o: a read
// of o after it, in a loop never assigned (rustc E0381), after a move in a
// branch or straight on (rustc E0382), was accepted, and the loop printed
// o's other field's uninitialized bytes.
// ERROR: error[borrowck.use_uninit]
// ERROR: line 41, column 17
// ERROR: error[borrowck.use_moved]
// ERROR: line 57, column 13
// ERROR: error[borrowck.use_moved]
// ERROR: line 68, column 13
// ERROR-COUNT: 3
union I {
    a: i64,
    b: i64,
}

impl Clone for I {
    fn clone(&self) -> I {
        *self
    }
}

impl Copy for I {}

union O {
    i: I,
    c: [i64; 4],
}

// Never assigned whole: the loop's first iteration reads o's bytes that
// no assignment wrote.
fn in_loop() {
    let mut o: O;
    let mut n = 0;
    while n < 1 {
        o.i.a = 7;
        let w = o;
        // UNSAFE: reads a union's field, the test's point
        // SAFETY: never runs: the program is refused
        println("{}", unsafe { w.c[3] });
        n += 1;
    }
}

// Moved in one branch, never assigned on the other.
fn after_branch(c: bool) {
    let mut o: O;
    if c {
        o = O { c: [1, 2, 3, 4] };
        let _w = o;
    }
    o.i.a = 7;
    let x = o;
    // UNSAFE: reads a union's field, the test's point
    // SAFETY: never runs: the program is refused
    println("{}", unsafe { x.c[3] });
}

// Moved, then assigned through the nested union only.
fn straight() {
    let mut o = O { c: [1, 2, 3, 4] };
    let w = o;
    o.i.a = 2;
    let x = o;
    // UNSAFE: reads a union's field, the test's point
    // SAFETY: never runs: the program is refused
    println("{}", unsafe { x.i.b + w.c[0] });
}

fn main() {
    in_loop();
    after_branch(std::env::args().count() > 5);
    straight();
}
