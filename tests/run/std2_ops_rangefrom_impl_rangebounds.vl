// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops RangeFrom::impl RangeBounds.
// EXPECT: Included(3) Unbounded true false
use std::ops::{RangeBounds, RangeFrom};

fn main() {
    let r: RangeFrom<i64> = 3..;
    println("{:?} {:?} {} {}", r.start_bound(), r.end_bound(), r.contains(&100), r.contains(&2));
}
