use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut w = BufWriter::new(Vec::<u8, Gpa>::new_in(gpa));
    let n = w.write(&[1]).unwrap();
    w.flush().unwrap();
    println("{} {:?}", n, w.get_ref());
