// a let parameter of a plain type with storage is passed by reference when the
// result views it (let-as-borrow); then it aliases an inout argument of the same value
// ERROR: error[borrowck.conflict]
// ERROR: line 9, column 75
#[derive(Clone, Copy)] struct A { arr: [i64; 4] }
fn g<'a>(x: &mut A, y: &'a A) -> &'a [i64] { x.arr[0] = 9; &y.arr[..] }

fn main() {
    let mut a = A { arr: [1i64, 2, 3, 4] }; let s = { let at_arg1 = &a; g(&mut a, at_arg1) };
    println("{}", s[0]);
}
