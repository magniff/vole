// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::io BufReader::buffer.
// EXPECT: [] [2, 3]
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    print("{:?} ", b.buffer());
    let mut one = [0u8; 1];
    b.read_exact(&mut one).unwrap();
    println("{:?}", b.buffer());
}
