// RULE: D19.2
// (0.30.1, RT-36) An `Fn() + Sync` closure that writes through a captured
// `&mut`, run on two threads through `&F`: rustc's E0594. Before, it was
// accepted, and the two threads' `*r += 1` raced (10.2M for 20M).
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*r', as it is a captured variable in a `Fn` closure
// ERROR: line 23, column 13
// ERROR-COUNT: 1
use std::thread;

fn race<F: Fn() + Sync>(f: F) {
    let g = &f;
    thread::scope(|s| {
        s.spawn(move || g());
        s.spawn(move || g());
    });
}

fn main() {
    let mut x = 0i64;
    let r = &mut x;
    race(|| {
        for _ in 0..1000 {
            *r += 1;
        }
    });
    println("{}", x);
}
