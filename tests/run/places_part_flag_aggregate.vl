// places IR (0.26.1, R6): a part's drop flag, made for an open drop's
// part, is cleared at entry and set where the whole is made by an
// aggregate (before, the flag was made after the rewrite had passed its
// writes: `drop(_2.0) [flag _7]` with no write to _7 before it). With an
// enum's payload, sem_own_pat_partial's `O::In(E::B(_, b), _)`.
// FLAGS: --check-alloc --verify-places
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: nb 5
// EXPECT: drop 5
// EXPECT: drop 4
// EXPECT: drop 6
// PLACES: fn f
// PLACES: _7 = const false
// PLACES: _2 = aggregate S(move _3, move _4)
// PLACES: _7 = const true
// PLACES: _6 = call eat(move _2.0)
// PLACES: _7 = const false
// PLACES: drop(_2) [open]
// PLACES: drop(_2.0) [flag _7]
// PLACES: fn nested
// PLACES: _2 = aggregate In(move _4, move _7)
// PLACES: const true
// PLACES: drop(_2) [open]
struct T { id: i64 }

impl Drop for T {
    fn drop(self: inout T) {
        println(f"drop {self.id}");
    }
}

struct S { a: T, b: T }

enum E { A(T), B(T, T) }

enum O { In(E, T), Out }

fn mk(id: i64) -> T {
    T { id }
}

fn eat(t: sink T) {
    println(f"eat {t.id}");
}

fn f(k: i64) {
    let s = S { a: mk(2), b: mk(3) };
    if k > 1 {
        eat(s.a);
    }
}

fn nested(k: i64) {
    let o = if k == 0 { O::In(E::B(mk(4), mk(5)), mk(6)) } else { O::Out };
    match o {
        O::In(E::B(_, b), _) => println(f"nb {b.id}"),
        _ => println("other"),
    }
}

fn main() {
    f(1);
    f(2);
    nested(0);
}
