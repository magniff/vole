// EDITION: rust
// RULE: F18.5
// (0.28.0) A `for` loop over a range of literals and open locals (`0..64`,
// `0..n` of an open n) makes its local open, its init the range, as rustc's
// integer variable: `return i`, `show(i)`, `v.push(i + 1)`, `bytes[i]`
// and `t = 3 * j + x` type it (and the range), and `s += x` makes s and x
// one variable; a shift amount (`1 << k`) and a cast's operand (`(..) as
// u64`) give it no type. Before, the loop closed it at i32 and each such
// use widened an i32 (FR5): `i * i` wrapped past 2^31.
// EXPECT: 46341 2147483649
// EXPECT: 2147483648 2147483650
// EXPECT: 45 193273528320
// EXPECT: 7 3
// EXPECT: 103079215109
// EXPECT: 3 3
// EXPECT: 40 40
fn root(n: i64) -> i64 {
    for i in 0..4000000000 {
        if i * i > n {
            return i;
        }
    }
    -1
}

fn show(x: i64) -> i64 {
    x
}

fn pushed(gpa: Gpa) -> (i64, i64) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..3 {
        v.push(i + (1 << 31));
    }
    (v[0], v[2])
}

fn sum() -> i64 {
    let mut s = 0;
    for x in 0..10 {
        s += x;
    }
    s
}

fn fold(bytes: &[u8]) -> u8 {
    let mut h = 0;
    for i in 0..4 {
        h ^= bytes[i];
    }
    h
}

fn bounded() -> i64 {
    let r = 4;
    let mut best = 0;
    for q in 0..r {
        if q > 2 {
            best = q;
        }
    }
    best + show(0)
}

fn mixed() -> i64 {
    let j: i64 = 1 << 35;
    let k = 3;
    let mut t = 0;
    for x in 0..3 {
        t = 3 * j + x + k;
    }
    t
}

fn small() -> (i32, i32) {
    let mut last = 0;
    for i in 0..4 {
        last = i;
    }
    (last, last)
}

fn bits(nc: i64) -> i64 {
    let mut last = -1;
    for k in 0..63 {
        if nc & (1 << k) != 0 {
            last = show(k);
        }
    }
    last
}

fn trailing(x: u64) -> i64 {
    for i in 0..64 {
        let bit = (x >> (if i > 100 { 63 - i } else { i }) as u64) & 1;
        if bit != 0 {
            return i;
        }
    }
    64
}

fn main(gpa: Gpa) {
    println("{} {}", root(1 << 31), root(1 << 62));
    let (a, b) = pushed(gpa);
    println("{} {}", a, b);
    println("{} {}", sum(), sum() << 32);
    println("{} {}", fold(&[1, 2, 4, 0]), bounded());
    println("{}", mixed());
    let (p, q) = small();
    println("{} {}", p, q);
    println("{} {}", bits((1 << 40) | 1), trailing(1 << 40));
}
