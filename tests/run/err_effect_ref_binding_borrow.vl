// RULE: E1.8 (0.30.1) A binding by reference of a local's place, in any
// pattern (a `match` arm, an `if let`, a `while let`, a `let`, a
// let-else, an or-pattern's alternatives), is a borrow of the local: the
// bound name is an alias of it (note_ref_bindings), and given to a callee
// with `addr` (zap writes through it) the local's proof is lost. Before,
// `match i { ref q => zapi(q) }` kept the counted loop's proof (-O2
// deleted the loop, -O0 never ended) and `match d { ref q => zap(q) }`
// kept the division's (-O2 deleted the check, -O0 divided by 0); 0.30.0
// the same. A `for`'s pattern and a parameter's bind items and arguments,
// no place of the function's; a binding by reference of a value (`match
// (d, 0) { (ref q, _) => .. }`) borrows a temporary.
// ERROR: 'k_match' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_if_let' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_alias' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'l_match' is #[effects(unsafe)], but it may not terminate (diverge):
// ERROR: 'k_let_ref' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_let_else' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_or' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_while_let' is #[no_panic], but it may panic: 'x / d' at
// ERROR-COUNT: 8

fn zap(r: &u64) {
    let p = r as *const u64 as *mut u64;
    // UNSAFE: the attack: a write through a shared reference
    // SAFETY: p is a live local's address
    unsafe {
        *p = 0;
    }
}

fn zapi(r: &i64) {
    let p = r as *const i64 as *mut i64;
    // UNSAFE: the attack: a write through a shared reference
    // SAFETY: p is a live local's address
    unsafe {
        *p = 0;
    }
}

#[no_panic]
fn k_match(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        match d {
            ref q => zap(q),
        }
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_if_let(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        if let ref q = d {
            zap(q);
        }
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_alias(x: u64, n: u64) -> u64 {
    let d = n;
    let r = &d;
    if d != 0 {
        match *r {
            ref q => zap(q),
        }
        x / d
    } else {
        0
    }
}

#[effects(unsafe)]
fn l_match(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        match i {
            ref q => zapi(q),
        }
        i += 1;
    }
    i
}

#[no_panic]
fn k_let_ref(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let ref q = d;
        zap(q);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_let_else(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let ref q = d else {
            return 0;
        };
        zap(q);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_or(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        match d {
            0 => {}
            ref q => zap(q),
        }
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_while_let(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        while let ref q = d {
            zap(q);
            break;
        }
        x / d
    } else {
        0
    }
}

fn main() {
    println("{} {} {} {}", k_match(7, 1), k_if_let(7, 1), k_alias(7, 1), l_match(3));
    println("{} {} {} {}", k_let_ref(7, 1), k_let_else(7, 1), k_or(7, 1), k_while_let(7, 1));
}
