// RT-35 (0.30.1, review 7) What the fix must still accept (rustc accepts
// each): an impl with an elided header lifetime and a type parameter
// whose methods have lifetimes and type parameters of their own, return
// the header's lifetime through `self`, use closures; a trait impl and a
// trait's default method over such a type; a constructor.
// EXPECT: ab x 2
// EXPECT: 97 y
// EXPECT: 4 abc 3
// EXPECT: ab ab
// EXPECT: abc 6
struct V<'b, T, U> { t: T, out: &'b mut Option<usize>, u: U }

impl<'b, U> V<'b, &str, U> {
    fn get<'q>(&'q self) -> &'q str { self.t }
    fn pick<'q, X>(&self, x: &'q str, _y: X) -> &'q str { x }
    fn len(&self) -> usize { self.t.len() }

    fn f(&mut self) {
        let t = self.t;
        let c = |n: usize| t.len() + n;
        self.out.replace(c(1));
    }

    fn h<'q>(&'q self) -> &'q str {
        let c = || self.t;
        c()
    }
}

trait Tr {
    fn first(&self) -> u8;
    fn same<'q>(&self, x: &'q str) -> &'q str;
}

struct P<T, U> { t: T, u: U }

impl<U> Tr for P<&str, U> {
    fn first(&self) -> u8 { self.t.as_bytes()[0] }
    fn same<'q>(&self, x: &'q str) -> &'q str { x }
}

struct W<T, U> { t: T, u: U }

impl<U> W<&str, U> {
    fn t(&self) -> &str { self.t }
    fn both<'q>(&'q self, o: &'q str) -> &'q str { if o.len() > 0 { o } else { self.t } }
}

trait Show {
    fn name(&self) -> &str;
    fn twice(&self) -> usize { self.name().len() * 2 }
}

struct Q<T, U> { t: T, u: U }

impl<U> Show for Q<&str, U> {
    fn name(&self) -> &str { self.t }
}

impl<U> Q<&str, U> {
    fn mk(t: &str, u: U) -> Q<&str, U> { Q { t: t, u: u } }
}

fn main() {
    let mut k: Option<usize> = None;
    let s: &str = "ab";
    {
        let v = V { t: s, out: &mut k, u: 1i64 };
        println("{} {} {}", v.get(), v.pick("x", 2i64), v.len());
    }
    let p = P { t: s, u: 1i64 };
    println("{} {}", p.first(), p.same("y"));
    let s3: &str = "abc";
    {
        let mut v = V { t: s3, out: &mut k, u: 0i64 };
        v.f();
        println("{} {} {}", k_of(&v), v.h(), v.len());
    }
    let w = W { t: s, u: 1u8 };
    println("{} {}", w.t(), w.both(""));
    let q = Q::mk("abc", 1i64);
    println("{} {}", q.name(), q.twice());
}

fn k_of<U>(v: &V<&str, U>) -> usize {
    (*v.out).unwrap_or(0)
}
