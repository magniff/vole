// EDITION: rust
// (0.28.0) A `#[thread_local] static mut` in a rust-edition program: each
// thread has its own copy, made from the initial value at its first
// access (std2's std::thread::__tls_addr, as MVS std's). 0.27.8 had no
// __tls_addr in std2: an object build crashed in gen0, an executable
// stopped with "internal error: a thread-local without std::thread".
// RUSTC: none (#[thread_local] is unstable in rustc: its thread_local! macro is the stable form)
// EXPECT: 5
// EXPECT: 1 2
// EXPECT: main 5 7
#[thread_local]
static mut T: i64 = 0;

#[thread_local]
static mut U: i64 = 7;

fn bump(k: i64) -> i64 {
    // UNSAFE: the test's thread-local
    // SAFETY: each thread reads and writes its own copy
    unsafe {
        T += k;
        T
    }
}

fn main() {
    // UNSAFE: the test's thread-locals
    // SAFETY: main's own copies
    unsafe {
        T = 5;
    }
    println("{}", unsafe { T });
    let (a, b) = std::thread::scope(|s| {
        let h1 = s.spawn(|| bump(1));
        let h2 = s.spawn(|| bump(2));
        (h1.join().unwrap(), h2.join().unwrap())
    });
    println("{} {}", a, b);
    println("main {} {}", unsafe { T }, unsafe { U });
}
