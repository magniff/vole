// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::slice SliceIndex.
// EXPECT: 2 [2, 3]
// RUSTC: none (SliceIndex's methods are unstable in Rust)
use std::slice::SliceIndex;

fn at<I: SliceIndex<[i64]>>(s: &[i64], i: I) -> &I::Output {
    i.index(s)
}

fn main() {
    let s: &[i64] = &[1, 2, 3];
    println("{} {:?}", at(s, 1), at(s, 1..3));
}
