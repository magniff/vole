// i < 3 for a negative i32 index.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551611, length 8
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], i: i32) -> i64 { if i < 3 { s[i as usize] } else { 0 } }

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s, (-5 + unsafe { Z }) as i32));
    0
}
