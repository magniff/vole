// std::sync::mpsc between threads: two senders on spawned threads and one
// on a scoped thread, a receiver that waits and ends when every sender is
// gone. (Not a std2_ case: those are built with --check-alloc, under which
// a value that owns a Vec, moved to another thread, is refused by the
// effect check; std2_sync_mpsc covers the channel on one thread.)
// EXPECT: 110 Err(Disconnected) Err(RecvError)
// EXPECT: 6
use std::thread;
use std::sync::mpsc;

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in(gpa);
    let tx2 = tx.clone();
    let h = thread::spawn_in(move || {
        for i in 0..5i64 {
            tx.send(i).unwrap();
        }
    }, gpa);
    let h2 = thread::spawn_in(move || {
        tx2.send(100).unwrap();
    }, gpa);
    let mut sum = 0;
    for x in rx.iter() {
        sum += x;
    }
    h.join().unwrap();
    h2.join().unwrap();
    println("{} {:?} {:?}", sum, rx.try_recv(), rx.recv());

    let (tx, rx) = mpsc::channel_in(gpa);
    thread::scope(|s| {
        s.spawn(move || {
            for i in 1..4i64 {
                tx.send(i).unwrap();
            }
        });
    });
    let mut total = 0;
    for x in rx {
        total += x;
    }
    println("{}", total);
}
