// 0.26.2: `#[repr(wgsl)]` structs and shared consts (plan §10.1 item 3):
// one definition for host and shader. The struct's layout is WGSL's
// (a [f32; 3] is a vec3<f32>, aligned to 16, sized 12; a nested struct
// rounds up to its alignment; an array's stride is its element's), and a
// block that names it in `with` gets its WGSL `struct`, its nested
// structs first, once each; a const becomes WGSL's `const`.
// EXPECT: Light 32 16 pos 0 power 12 color 16
// EXPECT: Scene 112 16 lights 0 ambient 64 count 76 weights 80 dims 96
// EXPECT: struct Light {
// EXPECT: const MAX_LIGHTS: u32 = 2u;
// EXPECT: const GAIN: f32 = 0.1f;
// EXPECT: const OFFSETS: array<i32, 3> = array<i32, 3>(-1i, 0i, 1i);
// EXPECT: Light once: true, before Scene: true
// EXPECT: main
#[repr(wgsl)]
pub struct Light {
    pos: [f32; 3],
    power: f32,
    color: [f32; 4],
}

#[repr(wgsl)]
pub struct Scene {
    lights: [Light; 2],
    ambient: [f32; 3],
    count: u32,
    weights: [f32; 4],
    dims: [u32; 2],
}

pub const MAX_LIGHTS: u32 = 2;
pub const GAIN: f32 = 0.1;
pub const OFFSETS: [i32; 3] = [-1, 0, 1];

embed wgsl SHADE with Light, Scene, MAX_LIGHTS, GAIN, OFFSETS {
    @group(0) @binding(0) var<uniform> scene: Scene;
    @group(0) @binding(1) var<storage, read_write> out: array<vec4<f32>>;

    @compute @workgroup_size(1)
    fn main() {
        var c = scene.ambient * GAIN;
        for (var i = 0u; i < min(scene.count, MAX_LIGHTS); i++) {
            let l: Light = scene.lights[i];
            c += l.color.xyz * l.power / f32(OFFSETS[0] + 2);
        }
        out[0] = vec4<f32>(c, 1.0);
    }
}

fn find(s: [u8], word: [u8], from: i64) -> i64 {
    var i = from;
    while i + word.len <= s.len {
        if s[i..i + word.len] == word {
            return i;
        }
        i += 1;
    }
    -1
}

fn line_of(s: [u8], word: [u8]) -> [u8] {
    let i = find(s, word, 0);
    var e = i;
    while e < s.len && s[e] != '\n' {
        e += 1;
    }
    s[i..e]
}

fn main() -> i32 {
    let l = Light { pos: [0.0; 3], power: 0.0, color: [0.0; 4] };
    let base = &l as *Light as i64;
    println(
        f"Light {size_of(Light)} {align_of(Light)} pos {&l.pos as *[f32; 3] as i64 - base} power {&l.power as *f32 as i64 - base} color {&l.color as *[f32; 4] as i64 - base}");
    let s = Scene { lights: [l; 2], ambient: [0.0; 3], count: 0, weights: [0.0; 4], dims: [0; 2] };
    let sb = &s as *Scene as i64;
    println(
        f"Scene {size_of(Scene)} {align_of(Scene)} lights {&s.lights as *[Light; 2] as i64 - sb} ambient {&s.ambient as *[f32; 3] as i64 - sb} count {&s.count as *u32 as i64 - sb} weights {&s.weights as *[f32; 4] as i64 - sb} dims {&s.dims as *[u32; 2] as i64 - sb}");
    let src = SHADE.src;
    println(line_of(src, "struct Light"));
    println(line_of(src, "const MAX_LIGHTS"));
    println(line_of(src, "const GAIN"));
    println(line_of(src, "const OFFSETS"));
    let first = find(src, "struct Light", 0);
    println(
        f"Light once: {find(src, "struct Light", first + 1) < 0}, before Scene: {first < find(src, "struct Scene", 0)}");
    println(SHADE.main);
    0
}
