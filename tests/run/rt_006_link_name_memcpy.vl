// XFAIL: RT-6: #[link_name] on an extern named like a C function the compiler calls (memcpy, fmod) redirects the compiler's own calls (open)
// FLAGS: -O2
// The program's extern `memcpy` is its C function rt006_rev_copy (a copy
// in reverse). gen0::target::emit_symbol_ref renames every C symbol by
// pcx.link_names, keyed by the symbol's text, so the compiler's own block
// copies (middle::lower::lower_copy's CallC "memcpy") also call
// rt006_rev_copy wherever the program names its extern `memcpy`: at -O2,
// with std's printing inlined into main, the line printed is reversed or
// lost (0.30.0 prints nothing, exit 0). The same holds for `fmod`, the
// call `x % y` of floats lowers to. 0.29.0 printed the line.
// CSOURCE: tests/c/rt_006_link_name_memcpy.c
// EXPECT: 4 3 2 1
// EXPECT: copied 4 bytes
extern "C" {
    #[link_name = "rt006_rev_copy"]
    fn memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;
}

fn main() {
    let src: [u8; 4] = [1, 2, 3, 4];
    let mut dst: [u8; 4] = [0; 4];
    // UNSAFE: the program's C function
    // SAFETY: both arrays have 4 bytes
    unsafe {
        memcpy(dst.as_mut_ptr(), src.as_ptr(), 4);
    }
    println("{} {} {} {}", dst[0], dst[1], dst[2], dst[3]);
    println("copied {} bytes", dst.len());
}
