// EDITION: rust
// RULE: F15.4
// The integers' inherent methods are the compiler's, from its list:
// wrapping, checked, overflowing and saturating arithmetic, the bit
// counts and the rotations, with Rust's results.
// EXPECT: 4
// EXPECT: 254
// EXPECT: 0
// EXPECT: true
// EXPECT: 44 true
// EXPECT: -128
// EXPECT: 3 3 31
// EXPECT: 40
// Passes on std2 since 0.27.2's switch.
fn main() {
    let a: u8 = 250;
    println("{}", a.wrapping_add(10));
    println("{}", 127u8.wrapping_mul(2));
    println("{}", 5u64.saturating_sub(9));
    println("{}", u64::MAX.checked_mul(2).is_none());
    let (r, o) = 200u8.overflowing_add(100);
    println("{} {}", r, o);
    println("{}", (-128i8).wrapping_neg());
    println("{} {} {}", 7u32.count_ones(), 8u32.trailing_zeros(), 1u32.leading_zeros());
    println("{}", 5u8.rotate_left(3));
}
