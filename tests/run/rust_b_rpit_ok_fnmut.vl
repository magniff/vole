// RUSTC-EDITION: 2024
// RULE: D21.4, D19.5
// (0.27.2.1) `-> impl FnMut() -> i32`: a counter closure that owns its state.
// EXPECT: 1 2 3
fn counter() -> impl FnMut() -> i32 {
    let mut n: i32 = 0;
    move || {
        n += 1;
        n
    }
}

fn main() {
    let mut c = counter();
    let a = c();
    let b = c();
    println("{} {} {}", a, b, c());
}
