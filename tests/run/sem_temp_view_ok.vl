// EDITION: rust
// (0.25) A view of a temporary lives as long as the temporary: to the end
// of the block when a `let` binds the view, to the end of the statement
// otherwise. Both are fine while they are used inside that.
// EXPECT: aa
// EXPECT: bb
// EXPECT: cc 2
use std::alloc::Allocator; struct H<A: Allocator> { b: Vec<u8, A> }
impl H<Gpa> { fn view(&self) -> &[u8] { self.b.as_slice() } }

fn mk(gpa: Gpa, c: u8) -> H<Gpa> {
    let mut b = Vec::<u8, Gpa>::new_in(gpa); b.push(c); b.push(c); H { b: b }
}

fn main(gpa: Gpa) {
    let s = mk(gpa, b'a').view();
    println("{}", str::from_utf8(s).unwrap());
    println("{}", str::from_utf8(mk(gpa, b'b').view()).unwrap());
    let n = mk(gpa, b'c').view().len();
    println("{} {n}", str::from_utf8(mk(gpa, b'c').view()).unwrap());
}
