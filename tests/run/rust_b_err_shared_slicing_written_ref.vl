// RULE: D2.7
// (0.30.1, RT-33 round 2, F2) `(&v[..]).reverse()` of a `v: &mut [i64]`:
// the written `&` makes a shared view, never made a `&mut` by its use,
// rustc's E0596. Before, it wrote through the shared view while `r` was
// live.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 12, column 5
// ERROR-COUNT: 1
fn k(v: &mut [i64]) {
    let r: &[i64] = &v[..];
    let before = r[0];
    (&v[..]).reverse();
    println("{} {}", before, r[0]);
}

fn main() {
    let mut a = [1i64, 2, 3];
    k(&mut a);
}
