// XFAIL: RT-69: a method call takes the inherent method even when a trait's method is found at an earlier autoref step: another method runs (0.30.2)
// Rust looks a method up receiver type by receiver type (T, then &T, then
// &mut T), inherent methods before trait methods at each step. So `s.val()`
// on an S takes T1's `val(self)` (step S) before the inherent
// `val(&self)` (step &S), and on a P takes Get's `val(&self)` (step &P)
// before the inherent `val(&mut self)` (step &mut P). vole takes the
// inherent method whatever its receiver: 5000 for 6, and P's mutating
// `val` runs (105 205 205 for 6 6 5). rustc prints the EXPECT lines.
// EXPECT: 6
// EXPECT: 5000
// EXPECT: 6 6 5
trait T1 {
    fn val(self) -> i64;
}

trait Get {
    fn val(&self) -> i64;
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl S {
    fn val(&self) -> i64 {
        self.k * 1000
    }
}

impl T1 for S {
    fn val(self) -> i64 {
        self.k + 1
    }
}

struct P {
    k: i64,
}

impl P {
    fn val(&mut self) -> i64 {
        self.k += 100;
        self.k
    }
}

impl Get for P {
    fn val(&self) -> i64 {
        self.k + 1
    }
}

fn main() -> i32 {
    let s = S { k: 5 };
    println("{}", s.val());
    let r = &s;
    println("{}", r.val());
    let mut p = P { k: 5 };
    let a = p.val();
    let b = p.val();
    println("{} {} {}", a, b, p.k);
    0
}
