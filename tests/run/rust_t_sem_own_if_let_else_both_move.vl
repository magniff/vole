// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_if_let_else_both_move.vl to Rust's spelling.
// sem-own: if let ... else on an owned Option, both branches moving: no leak, no double drop.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
use std::alloc::Allocator;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn main(gpa: Gpa) {
    let o: Option<D<Gpa>> = Some(mk(1, gpa));
    let b = mk(2, gpa);
    if let Some(d) = o {
        eat(d);
    } else {
        eat(b);
    }
    println("end");
}
