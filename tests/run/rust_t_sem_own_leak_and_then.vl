// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_leak_and_then.vl to Rust's spelling.
// sem-own: (0.25.3) Option::and_then's closure takes the payload sink and drops it.
// EXPECT: drop 1
// EXPECT: v 1
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn main(gpa: Gpa) {
    let o: Option<D<Gpa>> = Some(mk(1, gpa));
    let v = o.and_then(|d| Some(d.id));
    println("v {}", v.unwrap_or(0));
}
