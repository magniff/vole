// XFAIL: RT-152: `t.m()` with `T: C`, `C: B` is refused as ambiguous (E0034) when the type also implements A with m (0.30.2)
// From g302qual (pre-existing, v0.30.1 too; m6).
// EXPECT: 4 6
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
trait C: B { fn twice(&self) -> i64 { self.m() * 2 } }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
impl C for S {}
fn gc<T: C>(t: &T) -> i64 { t.m() + t.twice() }
fn main() { println("{} {}", S.twice(), gc(&S)); }
