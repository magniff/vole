// RULE: D8.5
// (0.27.2.1) A comparison takes its operands by reference,
// `PartialEq::eq(&a, &b)`: both are usable after it, and dropped once.
// EXPECT: true 1 1
// EXPECT: drop 1
// EXPECT: drop 1
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl PartialEq for D {
    fn eq(&self, o: &D) -> bool {
        self.n == o.n
    }
}

fn main() {
    let a = D { n: 1 };
    let b = D { n: 1 };
    let same = a == b;
    println("{} {} {}", same, a.n, b.n);
}
