// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc FixedBuf.
// EXPECT: [1, 2]
use std::alloc::{Allocator, FixedBuf, Layout};

fn main() {
    let mut mem = [0u8; 64];
    let fb = FixedBuf::new(&mut mem);
    let mut v = Vec::new_in(&fb);
    v.push(1);
    v.push(2);
    println("{:?}", v);
}
