// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Allocator::grow.
// EXPECT: 7 9
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let a = Layout::new::<u64>();
    let b = Layout::array::<u64>(2).unwrap();
    let p = gpa.allocate(a).unwrap();
    // UNSAFE: the block is written, grown, read and given back.
    // SAFETY: p is gpa's with layout a; q with layout b.
    unsafe {
        (p.as_ptr() as *mut u64)[0] = 7;
        let q = gpa.grow(p, a, b).unwrap();
        let r = q.as_ptr() as *mut u64;
        r[1] = 9;
        println("{} {}", r[0], r[1]);
        gpa.deallocate(q, b);
    }
}
