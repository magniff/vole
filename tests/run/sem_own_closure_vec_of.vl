// EDITION: rust
// sem-own: sink closures pushed to a Vec: each capture dropped once with the Vec.
// EXPECT: 3
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut fs: Vec<i64, Gpa> = Vec::new_in(gpa);
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let f = move || a.id;
    let g = move || b.id;
    println("{}", f() + g());
    println("end");
}
