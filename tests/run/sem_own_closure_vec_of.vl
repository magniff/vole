// sem-own: sink closures pushed to a Vec: each capture dropped once with the Vec.
// EXPECT: 3
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    var fs: Vec<i64, Gpa> = Vec::new_in(gpa);
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let f = sink || a.id;
    let g = sink || b.id;
    println("{}", f() + g());
    println("end");
}
