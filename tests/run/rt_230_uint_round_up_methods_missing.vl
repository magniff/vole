// XFAIL: RT-230: the rounding-up methods of unsigned integers are missing: div_ceil, next_multiple_of, checked_next_multiple_of, next_power_of_two, checked_next_power_of_two (0.30.2)
// rustc 1.98 prints the EXPECT lines (twin: r302e_007_int_multiples.rs.txt); guide rust does not list them as missing.
// EXPECT: u8 1 255 Some(255) 8 Some(8) None
// EXPECT: u16 1 65535 Some(65535) 8 Some(8) None
// EXPECT: u32 1 4294967295 Some(4294967295) 8 Some(8) None
// EXPECT: u64 1 18446744073709551615 Some(18446744073709551615) 8 Some(8) None
// EXPECT: usize 1 18446744073709551615 Some(18446744073709551615) 8 Some(8) None
fn main() {
    let a: u8 = 7;
    let b: u8 = u8::MAX;
    println("u8 {:?} {:?} {:?} {:?} {:?} {:?}", a.div_ceil(b), a.next_multiple_of(b),
        a.checked_next_multiple_of(b), a.next_power_of_two(), a.checked_next_power_of_two(),
        b.checked_next_power_of_two());
    let a: u16 = 7;
    let b: u16 = u16::MAX;
    println("u16 {:?} {:?} {:?} {:?} {:?} {:?}", a.div_ceil(b), a.next_multiple_of(b),
        a.checked_next_multiple_of(b), a.next_power_of_two(), a.checked_next_power_of_two(),
        b.checked_next_power_of_two());
    let a: u32 = 7;
    let b: u32 = u32::MAX;
    println("u32 {:?} {:?} {:?} {:?} {:?} {:?}", a.div_ceil(b), a.next_multiple_of(b),
        a.checked_next_multiple_of(b), a.next_power_of_two(), a.checked_next_power_of_two(),
        b.checked_next_power_of_two());
    let a: u64 = 7;
    let b: u64 = u64::MAX;
    println("u64 {:?} {:?} {:?} {:?} {:?} {:?}", a.div_ceil(b), a.next_multiple_of(b),
        a.checked_next_multiple_of(b), a.next_power_of_two(), a.checked_next_power_of_two(),
        b.checked_next_power_of_two());
    let a: usize = 7;
    let b: usize = usize::MAX;
    println("usize {:?} {:?} {:?} {:?} {:?} {:?}", a.div_ceil(b), a.next_multiple_of(b),
        a.checked_next_multiple_of(b), a.next_power_of_two(), a.checked_next_power_of_two(),
        b.checked_next_power_of_two());
}
