// passing the same owned value to a sink T twice: own.moved per instance; i64 copies
// ERROR: error[borrowck.use_moved]
// ERROR: line 10, column 34
fn take<T>(x: T) -> i64 { 1 }

fn main(gpa: Gpa) {
    let n: i64 = 1;
    println("{}", take(n) + take(n));
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{}", take(v) + take(v));
}
