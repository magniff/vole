// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice IterMut::impl Iterator.
// EXPECT: [10, 2] (1, Some(1))
use std::slice::SliceIndex;

fn main() {
    let mut a = [1, 2];
    let mut it = a.iter_mut();
    *it.next().unwrap() = 10;
    let h = it.size_hint();
    println("{:?} {:?}", a, h);
}
