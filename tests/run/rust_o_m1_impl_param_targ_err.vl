// (0.30.2, obligations M1) rust_o_m1_impl_param_targ_ok on a Holder<i32>:
// Tr<i32>'s impl, whose `'a: 'static` is required (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
struct Holder<U> { u: U }
impl<U> Holder<U> { fn go<T: Tr<U>>(&self, t: &T) -> &'static str { t.f() } }

fn main(gpa: Gpa) {
    let h = Holder { u: 1i32 };
    let s = {
        let st = String::from_in("hello heap string long", gpa); h.go(&W { r: st.as_str() })
    };
    println("{}", s);
}
