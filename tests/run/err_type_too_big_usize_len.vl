// (0.30.1) An array length of usize::MAX (a constant: one that wraps,
// `0 - 1` at -O2, gives it too): 2^64 - 1 bytes, refused, its length
// printed as the usize it is.
// ERROR: values of the type '[u8; 18446744073709551615]' are too big
const N: usize = usize::MAX;

fn main() {
    let a = [0u8; N];
    println("{}", a.len());
}
