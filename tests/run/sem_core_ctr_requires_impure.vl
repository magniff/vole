// EDITION: rust
// A requires that allocates is contract.effect.
// ERROR: contract.effect
fn f(v: &Vec<i64, Gpa>) -> i64
    requires v.clone().len() > 0
{
    v.len() as i64
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", f(&v));
    0
}
