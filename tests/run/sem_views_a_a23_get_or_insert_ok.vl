// XFAIL: gap 17: compile unsafe: indexing a raw pointer is unsafe
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 2 1
// EXPECT: 2 1
use std::hash::FixedState;
use std::collections::HashMap; fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<&str, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for w in ["a", "b", "a"] { m.entry(w).or_insert(0)[0] += 1; }
    println("{} {}", m.get(&"a").copied().unwrap(), m.get(&"b").copied().unwrap());
    0
}
