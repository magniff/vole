// HashMap::insert allocates.
// ERROR: 'put' is #[no_alloc], but it allocates from Gpa
use std::collections::HashMap; #[no_alloc]
fn put(m: &mut HashMap<i64, i64, Gpa, FixedState>, k: i64) { m.insert(k, 1); }

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    put(&mut m, 3);
    println("{}", m.len());
    0
}
