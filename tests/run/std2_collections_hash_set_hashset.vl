// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet.
// EXPECT: 2 true false
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    s.insert(2);
    s.insert(1);
    println("{} {} {}", s.len(), s.contains(&1), s.contains(&3));
}
