// XFAIL: RT-117: `fn f() -> &'static u8 { &7 }` is refused as returning a local; rustc promotes the literal (0.30.2)
// The fn form of RT-117 (from the review of c302const; v0.30.1 too).
// EXPECT: 7 3
fn f() -> &'static u8 {
    &7
}

fn g() -> &'static [i64] {
    &[1, 2, 3]
}

fn main() {
    println("{} {}", *f(), g().len());
}
