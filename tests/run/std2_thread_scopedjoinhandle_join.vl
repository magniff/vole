// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread ScopedJoinHandle::join.
// EXPECT: hello 5
use std::thread;
use std::mem::swap;

fn main() {
    let word = "hello";
    let (w, n) = thread::scope(|s| {
        let h = s.spawn(|| (word, word.len()));
        h.join().unwrap()
    });
    println("{} {}", w, n);
}
