// RULE: D4.6
// (0.30.1) The fixpoint adds only what the fields imply: in `M<'a, 'b,
// T>`, which names itself unswapped, nothing makes T outlive 'b, so
// returning its `&'c i64` as a `&'b i64` is rustc's "lifetime may not
// live long enough" (borrowck.outlives).
// ERROR: error[borrowck.outlives]
// ERROR-COUNT: 1
struct M<'a, 'b, T> {
    x: &'a T,
    y: Option<&'a M<'a, 'b, T>>,
    z: &'b i64,
}

fn conv<'a, 'b, 'c>(l: &M<'a, 'b, &'c i64>, r: &'c i64) -> &'b i64 {
    let _ = l;
    r
}

fn main() {
    let v = 5i64;
    let rv = &v;
    let l: M<&i64> = M { x: &rv, y: None, z: rv };
    println("{}", *conv(&l, rv));
}
