// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a47_generic_instance_raw)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls '*mut i64::w', which writes through a raw pointer what it did not make
// A generic holder instantiated with *mut i64: a trait method writes through it.
trait W { fn w(self) -> bool; }

impl W for *mut i64 {
    fn w(self) -> bool {
        // UNSAFE: test
        // SAFETY: test
        unsafe { *self = 9; }
        true
    }
}

fn f<T: W + Copy>(t: T) -> i64
    requires t.w()
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&raw mut x));
    println("{}", x);
}
