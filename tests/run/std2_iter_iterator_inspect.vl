// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::inspect.
// EXPECT: saw 1
// EXPECT: saw 2
// EXPECT: 3

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let s: i64 = v.iter().inspect(|x| println("saw {}", x)).sum();
    println("{}", s);
}
