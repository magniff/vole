// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::get_mut.
// EXPECT: Some(11) None
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    if let Some(x) = m.get_mut(&1) {
        *x += 10;
    }
    let none = m.get_mut(&2).is_none();
    println("{:?} {}", m.get(&1), if none { "None" } else { "Some" });
}
