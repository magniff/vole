// The std item(s): std::env var_in; std::env var_os_in; std::env set_var; std::env remove_var; std::env VarError.
// EXPECT: Ok("1/2") Some([49, 47, 50])
// EXPECT: Err(NotPresent) None environment variable not found
// EXPECT: Err(NotPresent)
// RUSTC: none (std's var_os_in is a Vec<u8, A>, Rust's var_os an OsString; the names take an allocator)
use std::env;

fn main(gpa: Gpa) {
    // UNSAFE: changes the environment. SAFETY: one thread, no view kept.
    unsafe { env::set_var("STD_ENV_TEST", "1/2") };
    println("{:?} {:?}", env::var_in("STD_ENV_TEST", gpa), env::var_os_in("STD_ENV_TEST", gpa));
    // UNSAFE: as above. SAFETY: as above.
    unsafe { env::remove_var("STD_ENV_TEST") };
    let e = env::var_in("STD_ENV_TEST", gpa);
    println("{:?} {:?} {}", e, env::var_os_in("STD_ENV_TEST", gpa), env::VarError::NotPresent);
    println("{:?}", env::var_in("A=B", gpa));
}
