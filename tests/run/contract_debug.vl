fn is_sorted(s: &[i64]) -> bool {
    for i in 1..s.len() {
        if s[i - 1] > s[i] { return false; }
    }
    true
}

fn search(s: &[i64], x: i64) -> i64
    debug requires is_sorted(s)
{
    debug_assert(is_sorted(s));
    let mut lo: i64 = 0;
    let mut hi = s.len();
    while lo < hi as i64 {
        let mid = (lo + hi as i64) / 2;
        if s[mid as usize] < x { lo = mid + 1; } else { hi = mid as usize; }
    }
    lo
}

fn main() -> i32 {
    let a = [1i64, 3, 5, 7, 9, 11];
    print("{}", search(&a[..], 10));
    println("");
    let b = [3i64, 1, 2];
    print("{}", search(&b[..], 2));
    0
}
