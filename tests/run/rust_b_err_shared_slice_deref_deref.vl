// RULE: D2.7
// (0.30.1, RT-33) `&mut **r` of an `r: &&mut [i64]`: the reborrow of a
// `&mut [T]` reached through a `&`, rustc's E0596.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '**r' as mutable, which is behind a `&` reference
// ERROR: line 9, column 25
// ERROR-COUNT: 1
fn k(r: &&mut [i64]) {
    // the reborrow
    let m: &mut [i64] = &mut **r;
    m[0] = 1;
}

fn main() {
    let mut a = [1i64, 2];
    let v: &mut [i64] = &mut a;
    k(&v);
}
