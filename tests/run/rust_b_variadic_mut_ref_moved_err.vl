// RULE: D3.6
// (0.28.0) A `&mut T` given to a C variadic's `...` is moved (rustc's
// E0382 at a later use): no parameter type makes it a coercion site.
// (rustc twin by hand, the twin tools skip an extern block: E0382 at the
// `*r += 1`.)
// ERROR: error[borrowck.use_moved]
// ERROR: line 19, column 5
// ERROR-COUNT: 1
extern "C" {
    fn sscanf(s: *const u8, format: *const u8, ...) -> i32;
}

fn read_into(r: &mut i64) {
    // UNSAFE: C's sscanf
    // SAFETY: both strings end in a NUL; `%lld` writes one i64 through r
    unsafe {
        sscanf(b"42\0".as_ptr(), b"%lld\0".as_ptr(), r);
    }
    *r += 1;
}

fn main() {
    let mut x: i64 = 1;
    read_into(&mut x);
    println("{}", x);
}
