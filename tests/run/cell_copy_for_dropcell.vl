// (0.26.1) `for e in arr` over an array of an owned stand-in for a cell
// (an empty Drop, a write through `&self.v as *i64`): the array is copied
// and the write lost (the review's table).
// XFAIL: WRONG `for` over an array copies it: the write reaches the copy
// EXPECT: 9
struct DropCell { v: i64 }

impl Drop for DropCell {
    fn drop(inout self) {}
}

impl DropCell {
    fn set(self, x: i64) {
        unsafe {
            let p = &self.v as *i64;
            *p = x;
        }
    }

    fn get(self) -> i64 {
        self.v
    }
}

fn main() {
    let arr = [DropCell { v: 1 }, DropCell { v: 1 }];
    for e in arr {
        e.set(9);
    }
    println(f"{arr[0].get()}");
}
