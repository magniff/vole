// (0.26.1) `for e in arr` over an array of an owned type with a Drop that
// holds a cell (the review's DropCell, its value now a Cell): the array is
// iterated in place and the write kept.
// EXPECT: 9
use std::cell::Cell;

struct DropCell { v: Cell<i64> }

impl Drop for DropCell {
    fn drop(inout self) {}
}

impl DropCell {
    fn set(self, x: i64) { self.v.set(x); }
    fn get(self) -> i64 { self.v.get() }
}

fn main() {
    let arr = [DropCell { v: Cell::new(1) }, DropCell { v: Cell::new(1) }];
    for e in arr {
        e.set(9);
    }
    println(f"{arr[0].get()}");
}
