// From the review: let f = || a + a; println("{}", take(f()));
// rustc types the literals i64 and prints 4000000000; vole panics at -O0 (attempt to add with overflow).
// EXPECT: 4000000000
fn take(x: i64) -> i64 { x }
fn main() { let c = true; let a = 2000000000; let f = || a + a; println("{}", take(f())); }
