// EDITION: rust
// RULE: D10.2
// (0.27.1) A closure that reads a shared view (`[T]`, `str`) captures a
// copy of it, not a reference, until a reference to a view is one of its
// own (0.27.2): the view is Copy and immutable, so the copy reads the
// same, and the closure's slot is the view's region, so a value it pushes
// out lives as long as the view, not the closure (the spec's R12).
// PLACES: fn main
// PLACES: let _7: [i64]    // s
// PLACES: (move _10, copy _7)
// PLACES-NOT: &raw
// EXPECT: 2 3
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    v.push(3);
    let mut out: Vec<[i64], Gpa> = Vec::new_in(gpa);
    {
        let s = v.as_slice();
        let mut f = |x: i64| {
            if x > 0 {
                out.push(s);
            }
        };
        f(1);
    }
    let w = out[0];
    println("{} {}", w[0], w[1]);
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
