// EDITION: rust
// RULE: D10.2, Z9.6
// (0.27.1) A closure that reads a shared view (`[T]`, `str`) captured a
// copy of it (R12). (0.27.2) It captures it by `&`, a loan `&'c &'a [T]`
// with two slots: a value it pushes out is a copy of the view, which lives
// as long as the view's region, not the closure's loan.
// PLACES: fn main
// PLACES: let _7: [i64]    // s
// PLACES: let _11: let [i64]    // temp
// PLACES: _11 = &'r
// PLACES: (move _10, move _11)
// PLACES-NOT: &raw
// EXPECT: 2 3
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    v.push(3);
    let mut out: Vec<[i64], Gpa> = Vec::new_in(gpa);
    {
        let s = v.as_slice();
        let mut f = |x: i64| {
            if x > 0 {
                out.push(s);
            }
        };
        f(1);
    }
    let w = out[0];
    println("{} {}", w[0], w[1]);
}
// Runs on std2 since its gap closed (0.27.2).
