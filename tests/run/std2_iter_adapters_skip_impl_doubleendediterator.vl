// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Skip::impl DoubleEndedIterator.
// EXPECT: [4, 3] None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3, 4], gpa);
    let v: Vec<i64, Gpa> = s.iter().skip(2).rev().copied().collect_in(gpa);
    println("{:?} {:?}", v, s.iter().skip(4).next_back());
}
