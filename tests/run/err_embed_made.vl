// 0.26.2: an error in the WGSL the compiler writes for a const or a
// struct is reported at the item's declaration, "in the WGSL made for"
// it (here with vole's own error on the same literal).
// ERROR: error[wgsl.const]: this u32 literal is above 4294967295 (in the WGSL made for 'BIG')
// ERROR: err_embed_made.vl: line 6, column 5
pub const BIG: u32 = 5000000000;

embed wgsl K with BIG {
    @compute @workgroup_size(1)
    fn main() {}
}

fn main() -> i32 {
    println(K.main);
    0
}
