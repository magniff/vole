// RULE: D2.6
// (0.27.1) Moving the scrutinee in a guard: rustc's fake borrows conflict
// with assignments and `&mut`, not with moves.

struct N {
    v: i64,
}

fn main() {
    let o: Option<N> = Some(N { v: 1 });
    match o {
        Some(_) if {
            drop(o);
            false
        } => println("a"),
        _ => println("b"),
    }
}
// EXPECT: b
