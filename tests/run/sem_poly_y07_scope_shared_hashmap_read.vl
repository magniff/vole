// XFAIL: gap 4: compile type error: the trait 'Borrow<i32>' is not implemented for 'i64'
// two scoped threads reading one HashMap by let: accepted
// FLAGS: --check-alloc
// EXPECT: 9900
use std::hash::FixedState;
use std::collections::HashMap; use std::thread;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for i in 0..100 { m.insert(i, i * 2); }
    let t = thread::scope(|s| ({ let s = s; {
        let a = s.spawn(|| {
            let mut t: i64 = 0; for i in 0..50 { t += m.get(&i).copied().unwrap(); } t
        });
        let b = s.spawn(|| {
            let mut t: i64 = 0; for i in 50..100 { t += m.get(&i).copied().unwrap(); } t
        });
        a.join().unwrap() + b.join().unwrap()
    } }));
    println("{t}");
}
