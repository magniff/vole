// let receiver (owned) plus the same value inout, through a trait
// ERROR: own.conflict
trait Look { fn look(self, o: inout Self) -> i64; }
struct S<A: Allocator> { v: Vec<i64, A> }
impl Look for S<Gpa> { fn look(self, o: inout S<Gpa>) -> i64 { o.v.clear(); self.v.len() as i64 } }
fn main(gpa: Gpa) { var s = S { v: Vec::new_in(gpa) }; s.v.push(1); println("{}", s.look(&s)); }
