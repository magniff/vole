// EDITION: rust
// let receiver (owned) plus the same value inout, through a trait
// ERROR: error[borrowck.conflict]
// ERROR: line 10, column 78
use std::alloc::Allocator; trait Look { fn look(&self, o: &mut Self) -> i64; }
struct S<A: Allocator> { v: Vec<i64, A> }
impl Look for S<Gpa> { fn look(&self, o: &mut S<Gpa>) -> i64 { o.v.clear(); self.v.len() as i64 } }

fn main(gpa: Gpa) {
    let mut s = S { v: Vec::new_in(gpa) }; s.v.push(1); println("{}", s.look(&mut s));
}
