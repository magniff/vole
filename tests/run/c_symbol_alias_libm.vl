// 0.30.1, a pin (0.30.0 passes it too): externs named `sin` and `sqrt` that
// link to the program's own functions are not C's: each call of `sin` is
// made, and `sqrt` is a call, not the square root instruction (0.30.0 made
// no extern with a #[link_name] a libcall; c_symbol_libcall_sqrt is the
// other way, which 0.30.0 failed).
// CSOURCE: tests/c/c_symbol_identity.c
// EXPECT: 2 6
// EXPECT: sines 5, sqrt 42
extern "C" {
    #[link_name = "csi_sin"]
    fn sin(x: f64) -> f64;
    #[link_name = "csi_sqrt"]
    fn sqrt(x: f64) -> f64;
    fn csi_sines() -> i64;
}

fn main() {
    // UNSAFE: the program's C functions.
    // SAFETY: they take any number.
    unsafe {
        let a = sin(1.0);
        let b = sin(1.0);
        let mut c = 0.0;
        for _ in 0..3 {
            c += sin(2.0);
        }
        println("{} {}", a + b, c);
        println("sines {}, sqrt {}", csi_sines(), sqrt(4.0));
    }
}
