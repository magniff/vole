// XFAIL: gap 3: compile type error: expected 'inout i64', got 'inout i32'
// (0.25) The mutable places an inout access takes: a var local and its
// parts, an inout parameter, `inout self`, a `static var`, an `inout r`
// local, a var Vec, a sink parameter, and memory through a raw pointer.
use std::mem; #[derive(Clone, Copy)] struct S { n: i64 }

impl S {
    fn inc(&mut self) { self.n += 1; bump(&mut self.n); }
}

static mut G: i64 = 1;
fn bump(n: &mut i64) { *n += 1; }
fn twice(n: &mut i64) { bump(n); bump(n); }
fn own(mut x: i64) -> i64 { bump(&mut x); x }
fn addr(n: i64) -> i64 { let p = &mut n as *mut i64; unsafe { *p } }

fn main(gpa: Gpa) {
    let mut n: i64 = 1;
    bump(&mut n);
    let mut s = S { n: 1 };
    bump(&mut s.n);
    s.inc();
    let mut a = [1i64, 2, 3];
    bump(&mut a[1]);
    let mut t = (1, 2);
    bump(&mut t.0);
    let r = &mut n;
    *r += 1;
    twice(&mut n);
    bump(unsafe { &mut (*(&raw mut G)) });
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    bump(&mut v[0]);
    v[0] += 1;
    let mut o: Option<i64> = Some(1i64);
    match &mut o { Some(k) => { *k += 1; } None => {} }
    let mut x: i64 = 1;
    let mut y: i64 = 2;
    mem::swap(&mut x, &mut y);
    unsafe {
        let p = &mut a[0] as *mut i64;
        *p = 9;
    }
    let g_now = unsafe { G };
    println("{n} {} {} {} {} {g_now} {} {} {x} {y} {} {}", s.n, a[0], a[1], t.0, v[0], o.unwrap(),
        own(5), addr(4));
}
// EXPECT: 5 4 9 3 2 2 3 2 2 1 6 4
