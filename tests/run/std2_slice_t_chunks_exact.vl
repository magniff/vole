// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::chunks_exact.
// EXPECT: [1, 2] [3, 4] None [5]

fn main() {
    let s: &[i64] = &[1, 2, 3, 4, 5];
    let mut c = s.chunks_exact(2);
    println("{:?} {:?} {:?} {:?}", c.next().unwrap(), c.next().unwrap(), c.next(), c.remainder());
}
