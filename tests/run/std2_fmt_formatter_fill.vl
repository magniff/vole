// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter::fill.
// EXPECT: * true
use std::fmt::{Display, Formatter};

struct Fill;

impl Display for Fill {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        let c = f.fill();
        write(f, "{} {}", c, c == '*')
    }
}

fn main() {
    println("{:*<3}", Fill);
}
