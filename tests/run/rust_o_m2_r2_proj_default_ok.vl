// EXPECT: 32
// (review of M2, R2) `T::Out` under `T: Tr` of `trait Tr<U = i32>` is Tr<i32>'s Out, though Tr<i64>'s impl comes first (the first M2 printed 6400000000: a miscompile).
trait Tr<U = i32> { type Out; fn mk(&self) -> Self::Out; }
struct W { r: i64 }
impl Tr<i64> for W { type Out = i64; fn mk(&self) -> i64 { 6400000000 } }
impl Tr<i32> for W { type Out = i32; fn mk(&self) -> i32 { 32 } }
fn f<T: Tr>(t: &T) -> T::Out { t.mk() }
fn main() { let x = f(&W { r: 0 }); println("{}", x); }
