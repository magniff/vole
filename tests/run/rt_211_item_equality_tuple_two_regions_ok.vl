// RT-211's second review (K/k04, k05): `I: Iterator<Item = (X, Y)>` with
// I = Zip<Iter<'a, i64>, Iter<'b, i64>> makes X 'a's and Y 'b's: Zip's
// `type Item = (A::Item, B::Item)` normalized again through the impl
// select chose for each (places/regions.vl norm_value, norm_nested), so a
// result of X keeps v borrowed and not w. The first fix tied X and Y one
// region (Zip's Item not read) and refused `drop(w)`; v0.30.1 and rustc
// build both. The output is rustc's.
// EXPECT: Some(1000) [1000]
use std::alloc::Allocator;

fn firsts<I: Iterator<Item = (X, Y)>, X, Y>(mut it: I) -> Option<X> {
    match it.next() {
        Some(p) => Some(p.0),
        None => None,
    }
}

fn split<I: Iterator<Item = (X, Y)>, X, Y, A: Allocator + Clone>(it: I, a: A)
    -> (Vec<X, A>, Vec<Y, A>) {
    let mut p: Vec<X, A> = Vec::new_in(a.clone());
    let mut q: Vec<Y, A> = Vec::new_in(a);
    for (x, y) in it {
        p.push(x);
        q.push(y);
    }
    (p, q)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(5);
    let r = firsts(v.iter().zip(w.iter()));
    drop(w);
    let mut w2: Vec<i64, Gpa> = Vec::new_in(gpa);
    w2.push(5);
    let (p, q) = split(v.iter().zip(w2.iter()), gpa);
    drop(q);
    drop(w2);
    println("{:?} {:?}", r, p);
}
