// RULE: F18.4
// (0.27.5) `&e` of an array, repeat or tuple literal where `&U` of its
// kind goes, with no `let` hoisting it (a branch's, a block's tail, an
// argument): its literals take their types from U, not the `i32`
// fallback; and a sliced array literal where `&[U]` goes.
// EXPECT: 5000000000 9000000000 7 255 3 2 4000000000
fn first(a: &[i64; 2]) -> i64 {
    a[0]
}

fn main() {
    let c = true;
    let b: &[i64; 2] = if c { &[5000000000, 2] } else { &[3, 4] };
    let k: &[u64; 3] = { &[9000000000; 3] };
    let t: &(i64, bool) = if c { &(7, true) } else { &(8, false) };
    let m: &(u8, i64) = match t.0 {
        7 => &(255, 1),
        _ => &(0, 2),
    };
    let s: &[i64] = if c { &[1, 2, 3][..] } else { &[0][..] };
    let u: &[i64] = if c { &[1, 2, 3][1..] } else { &[0][..] };
    println("{} {} {} {} {} {} {}", b[0], k[1], t.0, m.0, s.len(), u.len(),
        first(if c { &[4000000000, 0] } else { &[1, 1] }));
}
