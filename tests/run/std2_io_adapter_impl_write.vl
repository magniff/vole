// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::io Adapter::impl Write.
// EXPECT: [49, 45, 120] BrokenPipe
use std::io::{ErrorKind, Write, self};

struct Broken;

impl Write for Broken {
    fn write(&mut self, _buf: &[u8]) -> io::Result<usize> {
        Err(io::Error::from(ErrorKind::BrokenPipe))
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    write(v, "{}-{}", 1, "x").unwrap();
    let e = write(Broken, "{}", 2).unwrap_err();
    println("{:?} {:?}", v, e.kind());
}
