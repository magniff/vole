// XFAIL: RT-52: a method on `&W` through impls for `&'a W<'b>` told apart by trait argument is not found (0.30.2)
// From g302oblig (2026-11-16). rustc picks Tr<i64> from go's bound and
// prints 64; v0.30.1: "no method 'f' on type '&W'".
// EXPECT: 64
trait Tr<U> { fn f(&self) -> i64; }
struct W<'a> { r: &'a str }
impl<'a, 'b: 'static> Tr<i32> for &'a W<'b> { fn f(&self) -> i64 { 32 } }
impl<'a, 'b> Tr<i64> for &'a W<'b> { fn f(&self) -> i64 { 64 } }
fn go<T: Tr<i64>>(t: T) -> i64 { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = W { r: st.as_str() }; println("{}", go(&x));
}
