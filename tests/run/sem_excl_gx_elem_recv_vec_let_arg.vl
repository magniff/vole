#[derive(Clone, Copy)] struct S { n: i64 }

impl S {
    fn look(&mut self, v: &Vec<S, Gpa>) -> i64 { let b = v[0].n; self.n = 7; b * 100 + v[0].n }
}

fn main(gpa: Gpa) {
    let mut v: Vec<S, Gpa> = Vec::new_in(gpa); v.push(S { n: 1 }); println("{}", v[0].look(&v));
}
