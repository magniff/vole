// Runs on std since 0.27.2's switch.
// The std item(s): std::ops BitOr::bitor.
// EXPECT: V { x: 13 } 13
use std::ops::BitOr;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitOr for V {
    type Output = V;

    fn bitor(self, rhs: V) -> V {
        V { x: self.x | rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.bitor(b), BitOr::bitor(12i64, 5));
}
