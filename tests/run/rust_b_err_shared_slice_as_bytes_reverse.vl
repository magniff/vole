// RULE: D2.7
// (0.30.1, RT-33) `s.as_bytes()[1..].reverse()`: a slicing of a call's
// shared view, passed to a `&mut self` method (no contract), rustc's
// E0596. Before, the temporary view was not asked.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow data in a `&` reference as mutable
// ERROR: line 9, column 5
// ERROR-COUNT: 1
fn rev(s: &str) {
    s.as_bytes()[1..].reverse();
}

fn main() {
    rev("ab\u{e9}");
}
