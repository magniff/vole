// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str F::impl Pattern.
// EXPECT: Some(1) "abc" ["a", "b", "c"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "a1b2c";
    let digit = |c: char| c.is_ascii_digit();
    println("{:?} {:?} {:?}", s.find(digit), "12abc34".trim_matches(|c: char| c.is_ascii_digit()),
        s.split(|c: char| c.is_ascii_digit()).collect_in::<Vec<&str, Gpa>, Gpa>(gpa));
}
