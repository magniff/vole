use std::path::Path; use std::path::PathBuf;
fn base(p: Path) -> &str { p.file_name().unwrap() }

fn main(gpa: Gpa) -> i32 {
    let mut p = PathBuf::from_in("/usr/local", gpa);
    let b = base(p.as_path());
    p.push("binXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", b);
    0
}
