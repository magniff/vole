// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd 7 (a nested struct of arrays; the view of an inner field)
// EXPECT: abcd 7
#[derive(Clone, Copy)] struct In { name: [u8; 4] }
#[derive(Clone, Copy)] struct E { i: In, len: i64 }
fn nm(e: &E) -> &[u8] { &e.i.name[..e.len as usize] }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { i: In { name: [b'a', b'b', b'c', b'd'] }, len: 4 };
    let r = nm(&e);
    let k = clobber();
    println("{r} {k}", r = str::from_utf8(r).unwrap());
    0
}
