// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops RangeInclusive.
// EXPECT: 1..=4 10
use std::ops::RangeInclusive;

fn main() {
    let r: RangeInclusive<i64> = 1..=4;
    let mut sum = 0;
    for i in r.clone() {
        sum += i;
    }
    println("{:?} {}", r, sum);
}
