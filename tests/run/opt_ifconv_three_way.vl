// XFAIL: gap 17: compile edition.lenient: 'a' is a value where a reference goes
// 0.26.1: a comparator with early returns, inlined in an innermost loop
// and compared with 0 (`cmp3(a, b) < 0`, std's sort_by on `i64::cmp`),
// joins three ways: true from `a < b`, false from `a == b` and false
// from the rest, two constants made apart. If-conversion selected
// between the two falses, and combine_select took `k ? false : false`
// for `!k`, so the test became `a < b || a != b` (fold/mod.vl). Two
// trues (`a != b` by early returns) and the sort itself beside it.
// EXPECT: pick 11335
// EXPECT: either 0 1 0 1 1 0
// EXPECT: sorted 9 7 5 3 2 1
fn cmp3(a: i64, b: i64) -> i64 {
    if a < b {
        return -1;
    }
    if a == b {
        return 0;
    }
    1
}

// The heap's child step: the smaller of two (as sort_by picks it).
#[inline(never)]
fn pick(v: &[i64], end: i64) -> i64 {
    let mut acc: i64 = 0;
    let mut child: i64 = 0;
    for _ in 0..64 {
        if child + 1 >= end {
            break;
        }
        let mut c = child;
        if c + 1 < end && cmp3(v[(c + 1) as usize], v[c as usize]) < 0 {
            c += 1;
        }
        acc = acc * 10 + c;
        child += 1;
    }
    acc
}

// Two trues: a < b, a > b, else false: `a != b`, never always true.
fn differ(a: i64, b: i64) -> bool {
    if a < b {
        return true;
    }
    if a > b {
        return true;
    }
    false
}

#[inline(never)]
fn either(v: &[i64]) {
    print("either");
    for i in 0..v.len() - 1 {
        let n: i64 = if differ(v[i], v[i + 1]) { 1 } else { 0 };
        print(" {n}");
    }
    println("");
}

fn main(gpa: Gpa) -> i32 {
    let v = [5i64, 1, 9, 3, 7, 2];
    println("pick {}", pick(&v[..], 6));
    let e = [4i64, 4, 6, 6, 1, 8, 8];
    either(&e[..]);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in v {
        w.push(x);
    }
    w.sort_unstable_by(|a, b| ({ let a = *a; let b = *b; b.cmp(a) }).cmp(&0));
    print("sorted");
    for &x in w.as_slice() {
        print(" {x}");
    }
    println("");
    0
}
