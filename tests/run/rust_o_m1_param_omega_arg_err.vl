// ERROR: the trait 'Tr<i32>' is not implemented for 'T'
// `T: Tr<U>` (U a parameter) does not prove `T: Tr<i32>`.
// (Review of the obligation engine's M1: refused by v0.30.1 through the places' every-candidate
// rule, built and read freed memory once that rule was gone; the front's Param candidate refuses it, rustc E0277.)
trait Tr<U> { fn g(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn g(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn g(&self) -> &'static str { "i64" } }
fn call2<Z: Tr<i32>>(z: &Z) -> &'static str { z.g() }

fn mid<U, T: Tr<U>>(t: &T, u: U) -> &'static str { call2(t) }

fn main(gpa: Gpa) {
    let mut keep: &'static str = "none";
    {
        let st = String::from_in("hello hello hello hello", gpa);
        let x = W { r: st.as_str() };
        keep = mid(&x, 0i64);
    }
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", keep, other.len());
}
