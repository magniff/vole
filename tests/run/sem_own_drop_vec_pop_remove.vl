// sem-own: pop and remove hand the element out: dropped by the taker; truncate and clear drop the rest; set drops the old one.
// EXPECT: drop 4
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 3
// EXPECT: drop 9
// EXPECT: drop 5
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn main(gpa: Gpa) {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 1..5 { v.push(mk(i, gpa)); }
    { let p = v.pop(); }
    { let r = v.remove(1usize); }
    v[0usize] = mk(9, gpa);
    v.truncate(1usize);
    v.push(mk(5, gpa));
    v.clear();
    println("end");
}
