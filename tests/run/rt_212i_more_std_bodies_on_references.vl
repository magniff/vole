// XFAIL: RT-212: (more forms of RT-212 in std) `[&W]::clone_from_slice`, `Vec<&W>::extend_from_within` and `Iterator::lt/le/gt/ge/partial_cmp` over items `&W` fail inside std (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt; W::clone is never called: the clones copy references).
// EXPECT: [W { k: 3 }, W { k: 1 }] [W { k: 1 }, W { k: 2 }, W { k: 1 }]
// EXPECT: true true false false
// EXPECT: Some(Less)
use std::cmp::Ordering;

#[derive(Debug, PartialEq, Eq, PartialOrd, Ord)]
struct W {
    k: i64,
}

impl Clone for W {
    fn clone(&self) -> W {
        println("W::clone");
        W { k: self.k + 100 }
    }
}

fn main(gpa: Gpa) {
    let a = W { k: 1 };
    let b = W { k: 2 };
    let c = W { k: 3 };
    let mut d = [&a, &b];
    d.clone_from_slice(&[&c, &a]);
    let mut v: Vec<&W, Gpa> = Vec::new_in(gpa);
    v.push(&a);
    v.push(&b);
    v.extend_from_within(0..1);
    println("{:?} {:?}", d, v);
    let x = [&a, &b];
    let y = [&a, &c];
    println("{} {} {} {}", x.iter().lt(y.iter()), x.iter().le(y.iter()), x.iter().gt(y.iter()),
        x.iter().ge(y.iter()));
    let o: Option<Ordering> = x.iter().partial_cmp(y.iter());
    println("{:?}", o);
}
