// RULE: F8.3, F8.4
// RT-C301-8 review (R4, form f58_blanket_default_self): `Self::K` in a default copied into `impl<T: Base> A for T`: A's, not looked up in Base.
// rustc prints the EXPECT lines.
// EXPECT: 105
trait Base { fn base(&self) -> i64; }

trait A {
    const K: i64; fn show(&self) -> i64 { Self::K * 100 + self.base2() } fn base2(&self) -> i64;
}

trait B { const K: i64; }
impl<T: Base> A for T { const K: i64 = 1; fn base2(&self) -> i64 { self.base() } }
struct S;
impl Base for S { fn base(&self) -> i64 { 5 } }
impl B for S { const K: i64 = 2; }
fn main() { println("{}", S.show()); }
