// XFAIL: RT-C301-2: a function that needs a 'static parameter is refused as a value even where its calls give one (0.30.2)
// `run<F: Fn(&'static str) -> usize>(f: F)` given `keep(x: &'static
// str)`: rustc accepts and prints 1 (the bound says the calls give
// 'static strs). vole refuses (borrowck.fn_value_static): a call through
// F is checked with the bound's erased type, so the bound's 'static is
// not read; the answer is to read the bound's lifetimes at those calls.
// EXPECT: 1
fn keep(x: &'static str) -> usize {
    x.len()
}

fn run<F: Fn(&'static str) -> usize>(f: F) -> usize {
    f("x")
}

fn main() {
    println("{}", run(keep));
}
