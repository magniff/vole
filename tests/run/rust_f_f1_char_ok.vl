// EDITION: rust
// RULE: F1.1, F1.2, F1.4, F1.5
// RUSTC: accepts FR3
// `char` is a type of its own: a literal is one Unicode scalar (any, as
// `'é'`, `'\u{1F600}'`), it casts to the integers, compares and matches
// by its scalar, and has inherent impls with constants; `b'A'` is a u8.
// (rustc reserves `impl char` to core: FR3.)
// EXPECT: 233
// EXPECT: 321
// EXPECT: 65
// EXPECT: cmp
// EXPECT: 122
// EXPECT: 1
impl char {
    const LAST: char = 'z';

    fn is_lower(&self) -> bool {
        *self >= 'a' && *self <= 'z'
    }
}

fn kind(c: char) -> i64 {
    match c {
        'a'..='z' => 1,
        'é' => 2,
        _ => 3,
    }
}

fn main() -> i64 {
    let c = 'é';
    let d: char = 'z';
    let u = c as u32;
    std::print_int(u as i64);
    println("");
    std::print_int(kind(d) + kind(c) * 10 + kind('\u{1F600}') * 100);
    println("");
    let b = b'A';
    std::print_int(b as i64);
    println("");
    if c == 'é' && d > 'a' && (b as char) == 'A' {
        println("cmp");
    }
    std::print_int(char::LAST as i64);
    println("");
    std::print_int(if d.is_lower() && !c.is_lower() { 1 } else { 0 });
    println("");
    0
}
