// RULE: D2.7, D19.2
// (0.30.1, RT-33) A closure that captures a shared view and slices or
// swaps through it: the referent is behind the captured `&`, rustc's
// E0596 in the closure's body.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 12, column 22
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 16, column 20
// ERROR-COUNT: 2
fn k(s: &[i64]) {
    let mut f = || {
        let m = &mut s[..];
        m[0] = 1;
    };
    f();
    let mut g = || s.swap(0, 1);
    g();
}

fn main() {
    let a = [2i64, 1];
    k(&a[..]);
}
