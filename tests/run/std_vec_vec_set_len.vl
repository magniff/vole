// Runs on std since 0.27.2's switch.
// The std item(s): std::vec Vec::set_len.
// EXPECT: [1, 2, 3]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(3, gpa);
    let p = v.as_mut_ptr();
    // UNSAFE: writes the spare capacity, then counts it.
    // SAFETY: capacity >= 3, and the three are written before set_len.
    unsafe {
        *p = 1;
        *p.add(1) = 2;
        *p.add(2) = 3;
        v.set_len(3);
    }
    println("{:?}", v);
}
