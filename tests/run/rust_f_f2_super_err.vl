// EDITION: rust
// RULE: F2.3
// `impl Derived for U` needs `U: Base` first.
// ERROR: 'Derived' requires 'U: Base', which is not implemented
trait Base {
    fn base(&self) -> i64;
}

trait Derived: Base {
    fn more(&self) -> i64;
}

struct U {
    n: i64,
}

impl Derived for U {
    fn more(&self) -> i64 {
        2
    }
}

fn main() -> i64 {
    let u = U { n: 7 };
    u.more()
}
