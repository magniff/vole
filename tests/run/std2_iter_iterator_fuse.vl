// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::fuse.
// EXPECT: Some(1) None None
use std::iter::FusedIterator;

fn main() {
    let mut n = 0;
    let mut it = std::iter::from_fn(|| {
        n += 1;
        if n == 1 || n == 3 { Some(n) } else { None }
    }).fuse();
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.next());
}
