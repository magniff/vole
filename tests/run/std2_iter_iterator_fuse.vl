// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter Iterator::fuse.
// EXPECT: Some(1) None None

fn main() {
    let mut n = 0;
    let mut it = std::iter::from_fn(|| {
        n += 1;
        if n == 1 || n == 3 { Some(n) } else { None }
    }).fuse();
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.next());
}
