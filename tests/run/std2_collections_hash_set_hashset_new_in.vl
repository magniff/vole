// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet::new_in.
// EXPECT: 0 true
use std::collections::HashSet;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    println("{} {}", s.len(), s.is_empty());
}
