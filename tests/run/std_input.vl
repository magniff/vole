// EDITION: rust
// XFAIL: gap 2: compile type error: unresolved import 'std::Scanner'
// STDIN: 3 lines first
// STDIN:
// STDIN:   padded
// STDIN: 10 -20 x 30
// STDIN: second line
// STDIN:
// STDIN: last, no newline
// EXPECT: [3 lines first] [] [  padded] [padded]
// EXPECT: ints: 10 -20 none 30
// EXPECT: lines: <> <second line> <> <last, no newline>
// EXPECT: done true, rest 0
// EXPECT: end false []
// 0.14: reading stdin without unsafe: read_line (an empty line apart from
// the end of input, the last line without '\n'), then read_stdin for the
// rest (what read_line had buffered included), and a Scanner over it.
// (0.15: read_line, read_stdin and next_int return a Result.)
use std::io; use std::Scanner; use std::io::read_to_string_in as read_stdin_in; use std::trim;

fn main(gpa: Gpa) -> i32 {
    let mut line = String::new_in(gpa);
    for _ in 0..3 {
        io::stdin().read_line(&mut line).map(|n| n > 0).unwrap();
        print("[");
        print("{}", str::from_utf8(line.as_bytes()).unwrap());
        print("] ");
    }
    print("[");
    print("{}", str::from_utf8(trim(line.as_bytes())).unwrap());
    println("]");

    let mut input = { let mut v = Vec::new_in(gpa); io::stdin().read_to_end(&mut v).map(|_| v) }.unwrap();
    let mut sc = Scanner::new(input.as_slice());
    print("ints:");
    for _ in 0..4 {
        print(" ");
        match sc.next_int() {
            Ok(n) => print("{}", n),
            Err(_) => print("none"),
        }
    }
    println("");
    print("lines:");
    while let Some(l) = sc.next_line() {
        print(" <");
        print("{}", l);
        print(">");
    }
    println("");
    print("{}", if sc.is_done() { "done true" } else { "done false" });
    print(", rest ");
    print("{}", (sc.rest().len() as i64));
    println("");

    line.push_str("stale");
    let more = io::stdin().read_line(&mut line).map(|n| n > 0).unwrap();
    print("{}", if more { "end true [" } else { "end false [" });
    print("{}", str::from_utf8(line.as_bytes()).unwrap());
    println("]");
    0
}
