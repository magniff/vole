// RULE: D2.5
// (0.27.1) `&mut s.x` while `&mut s` is live: the old loan's place is a
// prefix of the new one's.
// ERROR: :17:13: error[borrowck.mut_twice]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct S {
    x: i64,
    y: i64,
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let b = &mut s;
    let a = &mut s.x;
    *a += 1;
    b.y += 1;
    println("{}", s.x);
}
