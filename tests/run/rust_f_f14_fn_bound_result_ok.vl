// RULE: F14.1
// An impl parameter fixed only by a closure bound's result with
// arguments, `F: Fn(i64) -> Option<B>`, binds from the closure's result,
// so `Self::Out` is known in a default method's instance.
// EXPECT: 8 true
trait Gen {
    type Out;
    fn get(&self) -> Option<Self::Out>;

    fn get_or(&self, d: Self::Out) -> Self::Out {
        match self.get() {
            Some(v) => v,
            None => d,
        }
    }
}

struct Maker<F> {
    f: F,
}

impl<B, F: Fn(i64) -> Option<B>> Gen for Maker<F> {
    type Out = B;

    fn get(&self) -> Option<B> {
        (self.f)(4)
    }
}

fn main() {
    let m = Maker { f: |x: i64| Some(x * 2) };
    let n = Maker { f: |x: i64| if x > 9 { Some(true) } else { None } };
    println("{} {}", m.get_or(0), n.get_or(true));
}
