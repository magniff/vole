// (0.30.2, RT-138) Three inherent constants in one cycle; the error names
// each: rustc E0391.
// ERROR: const.cycle]: constant 'S::A' is defined in terms of itself (a cycle: S::A -> S::B -> S::C -> S::A)
struct S;

impl S {
    const A: u32 = Self::B + 1;
    const B: u32 = Self::C + 1;
    const C: u32 = Self::A + 1;
}

fn main() {
    println("{}", S::A);
}
