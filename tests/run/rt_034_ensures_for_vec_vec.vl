// RT-34: an `ensures` moved the body into `f$body`, a function the
// compiler made, and such a function was lowered under MVS's operand
// rules (a read of a place is a copy) while being trusted to be checked
// through its original: the `for` copied `v` into its iterator, moved
// each element out, then dropped `v` again (SIGTRAP: a double free).
// Every function whose body is user code is now lowered under Rust's
// rules and borrow-checked and drop-elaborated as itself. rustc prints
// the EXPECT lines; with and without the clauses alike.
// FLAGS: --check-alloc
// EXPECT: 4
// EXPECT: 4
// EXPECT: 3
fn f(v: Vec<Vec<i64, Gpa>, Gpa>) -> i64
    ensures result >= 0
{
    let mut s = 0;
    for x in v {
        s += x.len() as i64;
    }
    s
}

fn g(v: Vec<Vec<i64, Gpa>, Gpa>) -> i64
    requires v.len() > 0
{
    let mut s = 0;
    for x in v {
        s += x.len() as i64;
    }
    s
}

fn main(gpa: Gpa) {
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(Vec::from_in([1i64, 2, 3], gpa));
    v.push(Vec::from_in([4i64], gpa));
    println("{}", f(v));
    let w = Vec::from_in([7, 8, 9, 10], gpa);
    println("{}", w.len());
    let mut u: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    u.push(Vec::from_in([1i64, 2, 3], gpa));
    println("{}", g(u));
}
