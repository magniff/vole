// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::lt.
// EXPECT: true false
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([1i64, 3], gpa);
    println("{} {}", a.iter().lt(b.iter()), a.iter().lt(a.iter()));
}
