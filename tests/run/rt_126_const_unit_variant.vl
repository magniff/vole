// XFAIL: RT-126: a const of an enum's unit variant or struct variant (`const R: E = E::Red;`, `E::Blue { k: 2 }`) is "not a compile-time constant" (0.30.2)
// rustc accepts all three consts. vole accepts the tuple variant
// (`E::Green(3)`), `None`, `Some(4)`, an array `[E::Red, E::Red]`, a tuple
// `(E::Red, 1)` and a struct literal, and refuses a unit variant alone and
// a struct-variant literal: "expression is not a compile-time constant".
// Since 0.28.0.
// EXPECT: Red Blue { k: 2 } Green(3)
#[derive(Debug, Clone, Copy)]
enum E {
    Red,
    Green(i64),
    Blue { k: i64 },
}

const R: E = E::Red;
const B: E = E::Blue { k: 2 };
const G: E = E::Green(3);

fn main() {
    println("{:?} {:?} {:?}", R, B, G);
}
