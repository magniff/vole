// EDITION: rust
// RULE: D4.6
// (0.27.7) The items of `v.iter().copied()` are the `&str`s the vector
// holds: here they borrow a local String, so returning one is rustc's
// E0515, the borrow of the String, not of the vector.
// ERROR: error[borrowck.return_local]: a reference to 's', a local of this function, escapes it
fn first<'a, I: Iterator<Item = &'a str>>(mut it: I) -> &'a str {
    it.next().unwrap()
}

fn g<'a>(gpa: Gpa) -> &'a str {
    let s = String::from_in("x", gpa);
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa);
    v.push(s.as_str());
    first(v.iter().copied())
}

fn main(gpa: Gpa) {
    println("{}", g(gpa));
}
