// XFAIL: RT-329: an unsizing coercion of a variable is refused: `let s: &[i64] = x;` with `x: &[i64; 2]` gives "expected '&[i64]', got '&[i64; 2]'" (0.30.2)
// rustc coerces &[T; N] to &[T] at any coercion site (a let with a type,
// an argument, a return) and prints the EXPECT line. `&a` written at the
// site is coerced; a variable of the array-reference type is not. Since
// v0.30.1 at least. Found by the type_size work.
// EXPECT: 2 3 4
fn tot(s: &[i64]) -> i64 {
    s.len() as i64
}

fn back(x: &[i64; 4]) -> &[i64] {
    x
}

fn main() {
    let a: [i64; 2] = [1, 2];
    let x: &[i64; 2] = &a;
    let s: &[i64] = x;
    let b: [i64; 3] = [1, 2, 3];
    let y: &[i64; 3] = &b;
    let c: [i64; 4] = [1, 2, 3, 4];
    println("{} {} {}", s.len(), tot(y), back(&c).len());
}
