// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt Formatter::pad.
// EXPECT: [abc  ] [  abc] [ab]
use std::fmt::{Display, Formatter};

struct S;

impl Display for S {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.pad("abc")
    }
}

fn main() {
    println("[{:5}] [{:>5}] [{:.2}]", S, S, S);
}
