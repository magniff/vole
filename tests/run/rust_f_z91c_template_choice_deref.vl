// RULE: Z9.1c
// (0.27.5) A receiver whose type as written is a bare type parameter
// takes the bound's method of the type it stands for: `(*x).tag()` of
// `x: &T` and of `y: &T` (a `let`'s annotation) with T = &str is the
// reference impl's, `x.tag()` of `x: &T` T's; with T = str both are
// str's.
// EXPECT: 11 11 11 1 1 1
trait Tag {
    fn tag(&self) -> i64;
}

impl Tag for str {
    fn tag(&self) -> i64 {
        1
    }
}

impl<T: ?Sized + Tag> Tag for &T {
    fn tag(&self) -> i64 {
        (**self).tag() + 10
    }
}

fn deref<T: ?Sized + Tag>(x: &T) -> i64 {
    (*x).tag()
}

fn annotated<T: ?Sized + Tag>(x: &T) -> i64 {
    let y: &T = x;
    (*y).tag()
}

fn direct<T: ?Sized + Tag>(x: &T) -> i64 {
    x.tag()
}

fn main() {
    let s: &str = "x";
    println("{} {} {} {} {} {}", deref(&s), annotated(&s), direct(&s), deref(s), annotated(s),
        direct(s));
}
