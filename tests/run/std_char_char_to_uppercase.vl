// Runs on std since 0.27.2's switch.
// The std item(s): std::char char::to_uppercase.
// EXPECT: A É SS Ж Σ 1

fn up(c: char) {
    let mut it = c.to_uppercase();
    while let Some(u) = it.next() {
        print("{}", u);
    }
}

fn main() {
    let cs = ['a', 'é', 'ß', 'ж', 'ς', '1'];
    let mut i: usize = 0;
    while i < cs.len() {
        if i > 0 {
            print(" ");
        }
        up(cs[i]);
        i += 1;
    }
    println("");
}
