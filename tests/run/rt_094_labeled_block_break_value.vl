// XFAIL: RT-94: a labeled block with a break value (`'b: { .. break 'b v; .. }`) is refused with `expected expression, got ''` (0.30.2)
// Stable Rust since 1.65; rustc prints the EXPECT line. vole: `3:13:
// error[parser error] expected expression, got ''`: the token is named by
// an empty string, and nothing says labeled blocks are missing (`guide
// rust` does not list them; `'a: loop` and `'a: for` work).
// EXPECT: 1
fn main() {
    let x = 3i64;
    let v = 'b: {
        if x > 2 {
            break 'b 1i64;
        }
        2
    };
    println("{v}");
}
