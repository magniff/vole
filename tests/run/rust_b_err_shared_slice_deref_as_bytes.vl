// RULE: D2.7
// (0.30.1, RT-33) `&mut *s.as_bytes()`: a reborrow of a shared view's
// referent as `&mut`, rustc's E0596. Before, the view was retyped `&mut
// [u8]`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s.as_bytes()' as mutable, which is behind a `&` reference
// ERROR: line 9, column 24
// ERROR-COUNT: 1
fn poke(s: &str) {
    let m: &mut [u8] = &mut *s.as_bytes();
    m[0] = 0xff;
}

fn main() {
    poke("abc");
}
