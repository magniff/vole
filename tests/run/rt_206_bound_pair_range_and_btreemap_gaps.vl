// XFAIL: RT-206: std has no `RangeBounds<T> for (Bound<T>, Bound<T>)`: `m.range((Bound::Excluded(3), Bound::Unbounded))` is refused (first as "cannot infer type parameter 'T' of 'Bound'"), and BTreeMap has no `split_off` or `retain`; `guide rust` lists none of them (0.30.2)
// rustc prints the EXPECT lines (twin: r302d_031_bound_pair_range_and_btreemap_gaps.rs.txt).
// vole: `cannot infer type parameter 'T' of 'Bound'` (lines 19, 20), and with the
// type written (`Bound::<i64>::Unbounded`, bt/b3.vl) `the trait 'RangeBounds<i64>' is
// not implemented for '(Bound<i64>, Bound<i64>)'`; line 22 is the same with an i32
// literal; `no method 'split_off' on type 'BTreeMap<i64, i64, Gpa>'` (line 24),
// and `retain` the same. compiler/std/ops.vl has RangeBounds for the six Range
// types only. Since v0.28.0 (not bisected further).
// EXPECT: [(4, 16), (5, 25)] [(0, 0), (1, 1)] [(0, 0), (1, 1)]
// EXPECT: {0: 0, 1: 1, 2: 4, 3: 9} {4: 16}
use std::collections::BTreeMap;
use std::ops::Bound;

fn main(gpa: Gpa) {
    let mut m: BTreeMap<i64, i64, Gpa> = BTreeMap::new_in(gpa);
    for i in 0..6i64 {
        m.insert(i, i * i);
    }
    let a: Vec<(&i64, &i64), Gpa> = m
        .range((Bound::Excluded(3i64), Bound::Unbounded))
        .collect_in(gpa);
    let b: Vec<(&i64, &i64), Gpa> = m
        .range((Bound::Unbounded, Bound::Included(1i64)))
        .collect_in(gpa);
    let lo: Bound<i64> = Bound::Unbounded;
    let c: Vec<(&i64, &i64), Gpa> = m.range((lo, Bound::Excluded(2))).collect_in(gpa);
    println("{:?} {:?} {:?}", a, b, c);
    let mut hi = m.split_off(&4);
    hi.retain(|k, _v| k % 2 == 0);
    println("{:?} {:?}", m, hi);
}
