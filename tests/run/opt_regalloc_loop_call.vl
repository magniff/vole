// A loop with a call on one of its paths, in a function with more values
// alive across the loop than callee-saved registers (0.30). The values
// the loop reads and carries (the slice, its length, the index, the sum)
// keep callee-saved registers for the whole loop, taken from values the
// loop does not read, which wait on the stack from before the loop: the
// path that makes no call is a load, a compare and two additions, with no
// move and nothing brought back from the stack. Before, the loop's values
// were in caller-saved registers up to the call and callee-saved ones
// after it (two moves a round on the path without the call), and the
// values put out of those at the call came back at the back edge (three
// loads a round).
// EXPECT: 2786245560176528151
// ASM(aarch64-macos): _vole.walk:
// ASM(aarch64-macos): ldrb
// ASM-NOT(aarch64-macos): mov x
// ASM-NOT(aarch64-macos): ldr x
// ASM-NOT(aarch64-macos): ldp x
// ASM(aarch64-macos): ldrb
// ASM(aarch64-macos): bl _vole.slow

#[inline(never)]
fn slow(x: u64) -> u64 {
    x.wrapping_mul(0x9E3779B97F4A7C15) >> 7
}

#[inline(never)]
fn walk(b: &[u8], k1: u64, k2: u64) -> u64 {
    let a1 = slow(k1);
    let a2 = slow(k2);
    let a3 = slow(k1 + k2);
    let a4 = slow(k1 + 4);
    let a5 = slow(k1 + 5);
    let a6 = slow(k1 + 6);
    let a7 = slow(k1 + 7);
    let a8 = slow(k1 + 8);
    let a9 = slow(k1 + 9);
    let a10 = slow(k1 + 10);
    let a11 = slow(k1 + 11);
    let a12 = slow(k1 + 12);
    let mut acc = 0u64;
    let mut n = 0u64;
    for i in 0..b.len() {
        let x = b[i];
        if x < 0x80 {
            acc += x as u64;
        } else {
            acc += slow(x as u64);
            n += 1;
        }
    }
    acc + a1 * 3 + a2 * 5 + a3 * 7 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + n + slow(1)
}

fn main() -> i32 {
    let s = "the quick brown fox, \u{e9}t\u{e9} \u{4e16}\u{754c}";
    let n = std::env::args().count() as u64;
    println("{}", walk(s.as_bytes(), n, n + 1));
    0
}
