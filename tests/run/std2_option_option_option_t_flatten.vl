// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option<Option<T>>::flatten.
// EXPECT: Some(1) None None
use std::option::Option;

fn main() {
    let a: Option<Option<i64>> = Some(Some(1));
    let b: Option<Option<i64>> = Some(None);
    let c: Option<Option<i64>> = None;
    println("{:?} {:?} {:?}", a.flatten(), b.flatten(), c.flatten());
}
