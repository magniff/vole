// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a33_trait_generic_callee)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'call<A>', which writes through a raw pointer what it did not make
// A trait method on a usize newtype writes through the address; called from a non-generic holder.
trait Poke { fn poke(&self) -> bool; }
struct A { addr: usize }

impl Poke for A {
    fn poke(&self) -> bool {
        // UNSAFE: test
        // SAFETY: test
        unsafe { *(self.addr as *mut i64) = 9; }
        true
    }
}

fn call<T: Poke>(t: &T) -> bool { t.poke() }

fn f(a: &A) -> i64
    requires call(a)
{
    1
}

fn main() {
    let mut x = 1i64;
    let a = A { addr: &raw mut x as usize };
    println("{}", f(&a));
    println("{}", x);
}
