// EDITION: rust
// RULE: D22.1, D22.3
// (0.28.0) A type parameter has what an impl for every type gives it:
// `K: Borrow<K>` of HashMap::get holds by std's `impl<T> Borrow<T> for
// T`, in a generic impl whose K has no such bound; and a bound `T:
// Into<M>` with a program's M serves `x.into()`.
// EXPECT: Some(2) None
// EXPECT: 3.5
use std::alloc::Allocator;
use std::collections::HashMap;
use std::hash::Hash;

struct Index<K, A: Allocator> {
    slots: HashMap<K, i32, A>,
}

impl<K: Hash + Eq, A: Allocator> Index<K, A> {
    fn at(&self, key: K) -> Option<i32> {
        self.slots.get(&key).copied()
    }
}

struct M {
    m: f64,
}

struct F {
    ft: f64,
}

impl From<F> for M {
    fn from(f: F) -> M {
        M { m: f.ft }
    }
}

fn one<T: Into<M>>(x: T) -> M {
    x.into()
}

fn main(gpa: Gpa) {
    let mut ix: Index<i64, Gpa> = Index { slots: HashMap::new_in(gpa) };
    ix.slots.insert(7, 2);
    println("{:?} {:?}", ix.at(7), ix.at(8));
    println("{}", one(F { ft: 3.5 }).m);
}
