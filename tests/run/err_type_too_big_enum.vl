// (0.30.1) An enum instance whose variant holds two values of 2^60
// bytes: refused where it is written.
// ERROR: values of the type 'E<[u8; 1152921504606846976]>' are too big
// ERROR-COUNT: 1
enum E<T> {
    Both(T, T),
    Neither,
}

fn main() {
    let e: E<[u8; 1usize << 60]> = E::Neither;
    match e {
        E::Neither => println("neither"),
        _ => {}
    }
}
