// EDITION: rust
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: 11 (an inout self method returning inout T)
// EXPECT: 11
#[derive(Clone, Copy)] struct C { n: i64 }
impl C { fn cell(&mut self) -> &mut i64 { &mut self.n } }

fn main() -> i32 {
    let mut c = C { n: 10 };
    let r = c.cell();
    *r += 1;
    println("{}", c.n);
    0
}
