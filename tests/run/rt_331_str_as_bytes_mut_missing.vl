// XFAIL: RT-331: std has no `str::as_bytes_mut` (an unsafe fn in Rust, reached from a String through Deref): "no method 'as_bytes_mut' on type 'String<Gpa>'" (0.30.2)
// rustc prints the EXPECT line. Since v0.30.1 at least. Seen by the second
// re-review of g302holes.
// EXPECT: Ab
fn main(gpa: Gpa) {
    let mut s = String::from_in("ab", gpa);
    // UNSAFE: as_bytes_mut is an unsafe fn: the bytes must stay UTF-8
    // SAFETY: 65 is ASCII 'A', so the string stays valid UTF-8
    let b = unsafe { s.as_bytes_mut() };
    b[0] = 65;
    println("{}", s);
}
