// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter IntoIterator::into_iter.
// EXPECT: [1, 2]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let it = v.into_iter();
    let a: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?}", a);
}
