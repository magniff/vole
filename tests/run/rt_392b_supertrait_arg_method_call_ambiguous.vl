// XFAIL: RT-392: (RT-392's mechanism, a method call) `t.get()` in `fn go<T: Sub>(t: &T)`, where `trait Sub: Tr<i64>` and W has impls of Tr<i32> and Tr<i64>, is refused as "'W::get' is ambiguous for arguments ()"; rustc accepts it and prints the EXPECT line (0.30.2)
// From the review of g302bor2 (form B/b26). Since v0.30.1 at least; the
// release build the same. In the generic body the only bound that gives a
// `get` is Sub's supertrait Tr<i64>. Siblings: rt_392, rt_392c.
// EXPECT: hello heap string long 22
trait Tr<U> {
    type Out;
    fn get(&self) -> Self::Out;
}

trait Sub: Tr<i64> {}

struct W<'a> {
    r: &'a str,
}

impl<'a> Tr<i32> for W<'a> {
    type Out = &'static str;

    fn get(&self) -> &'static str {
        "s"
    }
}

impl<'a> Tr<i64> for W<'a> {
    type Out = &'a str;

    fn get(&self) -> &'a str {
        self.r
    }
}

impl<'a> Sub for W<'a> {}

fn go<T: Sub>(t: &T) -> T::Out {
    t.get()
}

fn main(gpa: Gpa) {
    let st = String::from_in("hello heap string long", gpa);
    let s = {
        go(&W { r: st.as_str() })
    };
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", s, other.len());
}
