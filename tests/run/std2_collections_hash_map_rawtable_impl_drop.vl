// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// EXPECT: drop 2
// EXPECT: done
use std::collections::{HashMap, hash_map};
use std::ops::Drop;

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, Noisy, Gpa> = HashMap::new_in(gpa);
    m.insert(2, Noisy { id: 2 });
    {
        let it = m.into_iter();
        let _ = it;
    }
    println("done");
}
