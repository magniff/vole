// Runs on std2 since 0.27.2's switch.
// EXPECT: drop 2
// EXPECT: done
use std::collections::HashMap;
use std::hash::FixedState;
use std::ops::Drop;

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, Noisy, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(2, Noisy { id: 2 });
    {
        let it = m.into_iter();
        let _ = it;
    }
    println("done");
}
