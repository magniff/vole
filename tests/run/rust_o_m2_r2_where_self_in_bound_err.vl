// (obligations M2) As rust_o_m2_r2_where_self_in_bound_ok, with no impl of
// Conv<W> for i64: the impl's `where i64: Conv<Self>` does not hold, so W has
// no Tr (rustc E0277, the clause not met at the impl).
// ERROR: does not hold
trait Conv<X> {
    fn c(&self) -> i64;
}

trait Tr {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Conv<i64> for i64 {
    fn c(&self) -> i64 {
        5
    }
}

impl Tr for W
    where
        i64: Conv<Self>,
{
    fn g(&self) -> i64 {
        3i64.c() + self.r
    }
}

fn main() {
    println("{}", W { r: 1 }.g());
}
