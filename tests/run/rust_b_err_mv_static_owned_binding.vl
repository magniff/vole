// RULE: M3
// (0.30.1) A by-value binding of a static that is not Copy, or of such a
// part of one, is a move out of the static (rustc E0507), reported once at
// the static: the binding owns what it took, so its later move, write or
// use is no second error. Before, each binding was a borrowed copy and
// every later move of it was a second `cannot move out of 't', a borrowed
// copy`. The forms: a `let` of a static with no Drop, a guard's binder, a
// `for` over a static array, `while let`, `let mut` then a write, a
// tuple's operand. rustc gives these six E0507, at these positions.
// ERROR: error[borrowck.move_out]
// ERROR: line 58, column 13
// ERROR: error[borrowck.move_out]
// ERROR: line 63, column 11
// ERROR: error[borrowck.move_out]
// ERROR: line 70, column 14
// ERROR: error[borrowck.move_out]
// ERROR: line 76, column 25
// ERROR: error[borrowck.move_out]
// ERROR: line 82, column 17
// ERROR: error[borrowck.move_out]
// ERROR: line 88, column 14
// ERROR-COUNT: 6
#[derive(Debug, PartialEq)]
struct P {
    x: i64,
}

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct W {
    d: D,
    k: i64,
}

static SP: P = P { x: 1 };
static SD: D = D { v: 2 };
static SW: W = W { d: D { v: 4 }, k: 5 };
static SA: [D; 2] = [D { v: 6 }, D { v: 7 }];
static SO: Option<D> = Some(D { v: 8 });

fn takep(p: P) {
    println("{}", p.x);
}

fn take(d: D) {
    println("took {}", d.v);
}

fn a() {
    let t = SP;
    takep(t);
}

fn b() {
    match SW {
        W { d, .. } if d.v > 0 => take(d),
        _ => {}
    }
}

fn c() {
    for d in SA {
        take(d);
    }
}

fn d() {
    while let Some(x) = SO {
        take(x);
    }
}

fn e() {
    let mut t = SD;
    t.v = 3;
    take(t);
}

fn f() {
    let k = (SD, 1);
    take(k.0);
}

fn main() {
    a();
    b();
    c();
    d();
    e();
    f();
}
