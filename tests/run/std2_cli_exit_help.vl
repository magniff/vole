// RUSTC: none (std::cli is vole's: Rust's std has no command-line parser)
// std::cli (0.24): --help prints the help on stdout and exits with 0.
// ARGS: --name x --help
// (0.27.5) cmd.exit is process::exit, which runs no destructors (Rust's):
// the command's and the matches' blocks are left, and listed.
// STDERR: check-alloc: 3 blocks of Gpa not freed
// EXPECT: hello
// EXPECT:
// EXPECT: usage: hello [options] <file>...
// EXPECT:
// EXPECT: arguments:
// EXPECT:   <file>...          what to greet
// EXPECT:
// EXPECT: options:
// EXPECT:       --name <NAME>  [default: you]
// EXPECT:   -h, --help         print this help
use std::env;
use std::cli::Arg; use std::cli::Command;

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("hello", gpa)
        .arg(Arg::option("name").default("you"))
        .arg(Arg::positional("file").multiple().required().help("what to greet"));
    let m = cmd.parse_or_exit(env::args());
    println("hello {}", m.get("name").unwrap());
    0
}
