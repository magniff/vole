// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: aligned 0, first 1
// STDERR: unsafe access after free: 8 bytes at offset 0 of a block of 256 bytes
// STDERR: check_unsafe_gpa_aligned.vl: line 27, column 22
// 0.30.1: a type aligned above 16 is Gpa's through posix_memalign
// (`#[link_name = "posix_memalign"] fn gpa_c_posix_memalign`), which
// --check-unsafe wraps too: its blocks are known, and a use after free of
// one stops (the Vec's first block: 4 elements of 64 bytes).
#[repr(C, align(64))]
struct Line {
    a: u64,
    b: u64,
}

fn main(gpa: Gpa) {
    let mut v: Vec<Line, Gpa> = Vec::new_in(gpa);
    v.push(Line { a: 1, b: 2 });
    let p: *const u64 = v.as_ptr() as *const u64;
    println("aligned {}, first {}", (p as usize) % 64, v[0].a);
    let q: *const Line = v.as_ptr();
    // UNSAFE: a read while the Vec lives. SAFETY: element 0 is there.
    let _b = unsafe { (*q).b };
    drop(v);
    // UNSAFE: a deliberate use after free, to test --check-unsafe.
    // SAFETY: none: this program exists to be stopped.
    let x = unsafe { *p };
    println("read {x}");
}
