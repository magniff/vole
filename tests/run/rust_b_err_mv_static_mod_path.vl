// RULE: M3
// (0.30.1) A move out of a static named by a path, `m::MD`: the move-out
// check read the static's IR local's src, its symbol, as a LOCALS index to
// ask whether it was a `for` loop's sequence (index out of bounds; 0.30.0
// too). The sequence is LF_FOR_SEQ now, the desugaring's mark.
// ERROR: error[borrowck.move_out]
// ERROR: line 30, column 13
// ERROR: error[borrowck.move_out]
// ERROR: line 35, column 10
// ERROR-COUNT: 2
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

mod m {
    pub static MD: crate::D = crate::D { v: 3 };
}

fn take(d: D) {
    println("took {}", d.v);
}

fn a() {
    let t = m::MD;
    take(t);
}

fn b() {
    take(m::MD);
}

fn main() {
    a();
    b();
}
