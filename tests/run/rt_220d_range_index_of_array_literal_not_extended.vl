// XFAIL: RT-220d: (RT-220's family) a range index of an array literal does not extend the array temporary: `let a = &[mk(1), mk(2)][..];` and `&[mk(5), mk(6)][1..]` are refused as dropped while borrowed; `&[mk(3), mk(4)][1]`, `&(mk(7), mk(8)).1` and `&vec_temp[..]` are extended (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt): an indexing expression with an extended scope extends the indexed operand, overloaded or not.
// EXPECT: use 2 4 6 8 9 42
// EXPECT: drop 9
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: drop 5
// EXPECT: drop 6
// EXPECT: drop 3
// EXPECT: drop 4
// EXPECT: drop 1
// EXPECT: drop 2
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl D {
    fn me(&self) -> &D {
        self
    }
}

fn mk(n: i64) -> D {
    D { n: n }
}

fn id<'a>(d: &'a D) -> &'a D {
    d
}

fn mkv(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(41);
    v.push(42);
    v
}

fn main(gpa: Gpa) {
    let a = &[mk(1), mk(2)][..];
    let b = &[mk(3), mk(4)][1];
    let c = &[mk(5), mk(6)][1..];
    let d = &(mk(7), mk(8)).1;
    let e = &[mk(9)][0].n;
    let f = &[mkv(gpa)][0][1];
    println("use {} {} {} {} {} {}", a[1].n, b.n, c[0].n, d.n, e, f);
}
