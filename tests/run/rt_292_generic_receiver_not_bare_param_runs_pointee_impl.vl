// XFAIL: RT-292: (RT-212's mechanism, receivers that are plain values of type T) in a generic body with T = &W, `y.tag()` of `let y = x;`, `id(x).tag()`, a closure's `|z: T| z.tag()`, a match or if-let binding's `z.tag()` and `o.unwrap().tag()` run W's impl (1) instead of &W's (2) (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt); the release build prints
// `1 1 1`, `1 1 1`, `2 2 2 2`. Right today: the parameter itself (`x.tag()`),
// `(*x).tag()` of `x: &T`, `for z in v` over `&[T]`, `get(o).tag()` of a
// `&T` result, `v.iter().map(|z| z.tag())` and `Tag::tag(&x)`. RT-212's
// cases are a field, an index or a tuple field of a T place; these are
// whole values of type T. The in-flight g302tparam, g302probe and g302copy
// builds (03:52) print the same.
// EXPECT: 2 2 2
// EXPECT: 2 2 2
// EXPECT: 2 2 2 2
trait Tag {
    fn tag(&self) -> i64;
}

struct W {
    k: i64,
}

impl Tag for W {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a W {
    fn tag(&self) -> i64 {
        2
    }
}

fn id<T>(t: T) -> T {
    t
}

fn a_let<T: Tag>(x: T) -> i64 {
    let y = x;
    y.tag()
}

fn b_call<T: Tag>(x: T) -> i64 {
    id(x).tag()
}

fn c_closure<T: Tag + Copy>(x: T) -> i64 {
    let f = |z: T| z.tag();
    f(x)
}

fn e_match<T: Tag>(o: Option<T>) -> i64 {
    match o {
        Some(z) => z.tag(),
        None => 0,
    }
}

fn f_iflet<T: Tag>(o: Option<T>) -> i64 {
    if let Some(z) = o { z.tag() } else { 0 }
}

fn h_unwrap<T: Tag>(o: Option<T>) -> i64 {
    o.unwrap().tag()
}

fn p_param<T: Tag>(x: T) -> i64 {
    x.tag()
}

fn k_deref<T: Tag>(x: &T) -> i64 {
    (*x).tag()
}

fn g_for<T: Tag>(v: &[T]) -> i64 {
    let mut s = 0i64;
    for z in v {
        s += z.tag() - 1;
    }
    s
}

fn n_path<T: Tag>(x: T) -> i64 {
    Tag::tag(&x)
}

fn main() {
    let w = W { k: 0 };
    let r = &w;
    let v = [r, r, r];
    println("{} {} {}", a_let(r), b_call(r), c_closure(r));
    println("{} {} {}", e_match(Some(r)), f_iflet(Some(r)), h_unwrap(Some(r)));
    println("{} {} {} {}", p_param(r), k_deref(&r), g_for(&v) - 1, n_path(r));
}
