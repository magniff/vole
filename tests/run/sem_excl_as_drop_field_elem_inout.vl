// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
struct H<A: Allocator> { v: Vec<D, A> }
fn put(h: inout H<Gpa>) { h.v[0] = D { id: 2 }; }

fn main(gpa: Gpa) {
    var h = H { v: Vec::new_in(gpa) }; h.v.push(D { id: 1 }); put(&h); println("after");
}
