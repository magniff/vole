// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set IntoIter.
// EXPECT: 1
use std::collections::{HashSet, hash_set};
use std::collections::hash_set::IntoIter;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(1);
    let it: IntoIter<i64, Gpa> = s.into_iter();
    println("{}", it.count());
}
