// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Formatter::write_char.
// EXPECT: <x>
use std::fmt::{Display, Formatter};

struct S;

impl Display for S {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.write_char('<')?;
        f.write_char('x')?;
        f.write_char('>')
    }
}

fn main() {
    println("{}", S);
}
