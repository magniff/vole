// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::io BufReader::impl Read.
// EXPECT: 2 [1, 2] 1
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    let mut buf = [0u8; 2];
    let n = b.read(&mut buf).unwrap();
    let m = b.read(&mut buf).unwrap();
    println("{} {:?} {}", n, [1u8, 2], m);
}
