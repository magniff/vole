fn both<T>(a: &mut T, b: &mut T, v: T) { *a = v; *b = *a; }

fn main() {
    let mut n: i64 = 1; { let at_arg1 = &mut n; both(&mut n, at_arg1, 5i64) }; println("{n}");
}
