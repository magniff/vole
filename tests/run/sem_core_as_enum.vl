// An integer cast to a fieldless enum is checked; a valid one round-trips.
// EXPECT: 50 5 2
// EXPECT: 50
// EXIT: 101
// STDERR: invalid value 4 for enum Level
static var Z: i64 = 0;

#[repr(u8)]
enum Level { Low = 1, Mid = 5, High = 9 }

enum Plain { A, B, C }

fn name(l: Level) -> i64 {
    match l {
        Level::Low => 10,
        Level::Mid => 50,
        Level::High => 90,
    }
}

fn main() -> i32 {
    Z = std::env::args().len() as i64 - 1;
    let ok = (5 + Z) as Level;
    println("{} {} {}", name(ok), ok as i64, (2 + Z) as Plain as i64);
    let wrapped = (261 + Z) as u8; // 5 as a u8
    println("{}", name(wrapped as Level));
    let bad = (4 + Z) as Level; // exits 101
    println("not reached {}", name(bad));
    0
}
