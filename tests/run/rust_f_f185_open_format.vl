// EDITION: rust
// RULE: F18.5
// (0.28.0) A format hole gives an open local no type, as in rustc: after
// `println("{}", max)` the later `return max` (an i64) types it, and the
// hole writes it as an i64 (its write is made again, its impl i64's).
// Before, the hole closed it at i32 (256 for `1 << 40`). With no use that
// types it, the hole writes the i32 (`small`, `-1` in hex).
// EXPECT: 1099511627776
// EXPECT: 1099511627776
// EXPECT: [1099511627777] 10000000001 1099511627777
// EXPECT: 1099511627777
// EXPECT: 3 ffffffff
fn shown() -> i64 {
    let max = 1 << 40;
    println("{}", max);
    max
}

fn specs() -> u64 {
    let v = (1 << 40) + 1;
    println("[{:>5}] {:x} {v}", v, v);
    v
}

fn small() {
    let s = 3;
    let m = -1;
    println("{} {:x}", s, m);
}

fn main() {
    println("{}", shown());
    println("{}", specs());
    small();
}
