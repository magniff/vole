// a fn pointer whose result views its argument: the result views the block's Vec
// ERROR: error[borrowck.dropped_borrowed]
fn sl(d: &Vec<i64, Gpa>) -> &[i64] { d.as_slice() }

fn main(gpa: Gpa) {
    let f: fn(&Vec<i64, Gpa>) -> &[i64] = sl;
    let s = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        for i in 0..100 { v.push(i + 1000); }
        f(&v)
    };
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 { w.push(i); }
    println("{}", s[5]);
}
