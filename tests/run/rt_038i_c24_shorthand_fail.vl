// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c24_shorthand_fail)
// RUSTC: none contract clauses are not Rust
// EXIT: 101
// STDERR: requires failed: 'g(P { v })' of 'f'
// A requires checks a by-value param through a struct shorthand: a false requires must panic.
#[derive(Clone, Copy)]
struct P {
    v: i64,
}
fn g(p: P) -> bool { p.v == 4 }

fn f(v: i64) -> i64
    requires g(P { v })
{
    v
}

fn main() {
    println("{}", f(5));
}
