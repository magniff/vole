// RULE: F26.1
// Every binary operator and `op=` form on a user type is its std ops
// trait's method: PartialEq (`==` by eq, not structurally), PartialOrd
// (`<` by lt), Rem, BitAnd/Or/Xor, Shl/Shr with an Rhs other than Self (the
// literal takes it), and the Assign traits, as rustc.
// EXPECT: true false true false
// EXPECT: 3 5 31 26
// EXPECT: 52 6 -13 -14
// EXPECT: 18
use std::cmp::Ordering;
use std::ops::{
    Add, AddAssign, BitAnd, BitOr, BitOrAssign, BitXor, Neg, Not, Rem, RemAssign, Shl, ShlAssign,
    Shr,
};

#[derive(Debug, Clone, Copy)]
struct V { x: i64 }

impl PartialEq for V {
    fn eq(&self, o: &V) -> bool { self.x % 10 == o.x % 10 }
}

impl PartialOrd for V {
    fn partial_cmp(&self, o: &V) -> Option<Ordering> { (self.x % 10).partial_cmp(&(o.x % 10)) }
}

impl Add for V { type Output = V; fn add(self, o: V) -> V { V { x: self.x + o.x } } }
impl Rem for V { type Output = V; fn rem(self, o: V) -> V { V { x: self.x % o.x } } }
impl BitAnd for V { type Output = V; fn bitand(self, o: V) -> V { V { x: self.x & o.x } } }
impl BitOr for V { type Output = V; fn bitor(self, o: V) -> V { V { x: self.x | o.x } } }
impl BitXor for V { type Output = V; fn bitxor(self, o: V) -> V { V { x: self.x ^ o.x } } }
impl Shl<u32> for V { type Output = V; fn shl(self, n: u32) -> V { V { x: self.x << n } } }
impl Shr<u32> for V { type Output = V; fn shr(self, n: u32) -> V { V { x: self.x >> n } } }
impl AddAssign for V { fn add_assign(&mut self, o: V) { self.x += o.x; } }
impl RemAssign for V { fn rem_assign(&mut self, o: V) { self.x %= o.x; } }
impl BitOrAssign for V { fn bitor_assign(&mut self, o: V) { self.x |= o.x; } }
impl ShlAssign<u32> for V { fn shl_assign(&mut self, n: u32) { self.x <<= n; } }
impl Neg for V { type Output = V; fn neg(self) -> V { V { x: -self.x } } }
impl Not for V { type Output = V; fn not(self) -> V { V { x: !self.x } } }

fn main() {
    let a = V { x: 13 };
    let b = V { x: 23 };
    let c = V { x: 5 };
    println("{} {} {} {}", a == b, a != b, a < c, a >= c);
    println("{} {} {} {}", (a % c).x, (a & b).x, (a | b).x, (a ^ b).x);
    println("{} {} {} {}", (a << 2).x, (a >> 1).x, (-a).x, (!a).x);
    let mut m = a;
    m += b;
    m %= c;
    m |= V { x: 8 };
    m <<= 1;
    println("{}", m.x);
}
