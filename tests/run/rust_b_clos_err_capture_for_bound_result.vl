// EDITION: rust
// RULE: D19.10, D20.3
// (0.27.2) For `Fn(&i64) -> &i64` the result is the parameter's bound
// region: a capture returned there must outlive every such region, so the
// requirement is `'static` and `w` does not live long enough (rustc E0597).
// ERROR: error[borrowck.dropped_borrowed]
fn call<F: Fn(&i64) -> &i64>(f: F) -> i64 {
    let v = 7;
    *f(&v)
}

fn main() {
    let w = 3;
    let x = &w;
    println("{}", call(|p| x));
}
