// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc ArenaScope::used.
// EXPECT: 0 8
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let (a, b) = arena.scope(|sc| {
        let a = sc.used();
        sc.alloc(1u64);
        (a, sc.used())
    });
    println("{} {}", a, b);
}
