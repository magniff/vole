// RULE: F18.5
// (0.30.2) `i32::from(a)` in a closure, of a captured integer variable
// a later use makes i64: rustc's E0277, checked at the function's end.
// ERROR: the trait 'From<i64>' is not implemented for 'i32' (rustc E0277)
fn main() {
    let a = 5000000000;
    let f = || i32::from(a);
    let c: i64 = a;
    println("{} {}", f(), c);
}
