// (0.30.2, RT-237) a program fn that returns std's partition_in result,
// `-> (B, B)`, keeps the borrow of the iterator it is called with: drop(v)
// while the result lives is refused (rustc E0505 at the drop). v0.30.1
// accepted it and read v's freed block (a use after free from safe code).
// Fixed by choosing the impl that proves `B: Extend<I::Item>` with the
// whole trait reference (front::obligations::select): of Vec's two Extend
// impls only `Extend<T>` fits, so B's element is tied to I::Item.
// The unzip_in form is rt_237b.
// FLAGS: --check-alloc
// ERROR: line 22
use std::alloc::Allocator;

fn part<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> (B, B) {
    it.partition_in(|_x| true, a)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let (p, q): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = part(v.iter(), gpa);
    drop(v);
    println("{:?} {:?}", p, q);
}
