// XFAIL: RT-237: (RT-211 through a program's fn) a program fn that returns std's partition_in or unzip_in result, `-> (B, B)` / `-> (FX, FY)`, is accepted, and its call's result does not keep the borrow of the iterator: drop(v) then reading the result is a use after free from safe code (0.30.2)
// rustc E0505 at drop(v) (line 27; twin .rs.txt with Default for DefaultIn).
// The release build checks it clean; -O0 prints `[7, 8] [] [7, 8] [1000, 1001] [7, 8]`
// (p and s read x's values from v's freed block) and --check-alloc stops with
// `use after free: block #1 (32 bytes), allocated at ..:23:5, freed at ..:27:5`.
// A collector of the same shape that extends B itself is refused in its body
// (R302E-2), so it is the call into std's partition_in/unzip_in that lets the
// body through and RT-211's call-site gap that loses the borrow.
// FLAGS: --check-alloc
// ERROR: line 27
use std::alloc::Allocator;

fn part<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> (B, B) {
    it.partition_in(|_x| true, a)
}

fn split<I: Iterator<Item = (X, Y)>, X, Y, FX: DefaultIn<A> + Extend<X>,
    FY: DefaultIn<A> + Extend<Y>, A: Allocator + Clone>(it: I, a: A) -> (FX, FY) {
    it.unzip_in(a)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    v.push(1001);
    let (p, q): (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = part(v.iter(), gpa);
    let (s, t): (Vec<&i64, Gpa>, Vec<i64, Gpa>) = split(v.iter().map(|e| (e, *e)), gpa);
    drop(v);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    x.push(8);
    println("{:?} {:?} {:?} {:?} {:?}", p, q, s, t, x);
}
