// RUSTC: none a type error (E0308): the twin compares the borrow checker's verdicts
// RULE: D3.6a
// (0.27.7) A `&T` where a `*mut T` goes is rustc's E0308 wherever the
// `*mut T` is written: a struct literal's field, the function's result (its
// tail and a `return`), and an assignment's place (a local, a field, `*pp`).
// 0.27.6 accepted each.
// ERROR: error[type error]: expected '*mut i64', got '&i64'
// ERROR: line 22, column 12
// ERROR: line 26, column 5
// ERROR: line 30, column 12
// ERROR: line 37, column 9
// ERROR: line 39, column 11
// ERROR: line 43, column 20
// ERROR-COUNT: 6
struct S {
    p: *mut i64,
}

fn field(x: &i64) -> S {
    let mut y = 0i64;
    let _ = S { p: &mut y };
    S { p: x }
}

fn tail(x: &i64) -> *mut i64 {
    x
}

fn ret(x: &i64) -> *mut i64 {
    return x;
}

fn main() {
    let x = 1i64;
    let mut y = 2i64;
    let mut p: *mut i64 = &mut y;
    p = &x;
    let mut s = S { p: p };
    s.p = &x;
    let pp: *mut *mut i64 = &mut p;
    // UNSAFE: the test's raw pointer
    // SAFETY: pp points to p, live; the case is refused before it runs
    unsafe { *pp = &x; }
    field(&x);
    tail(&x);
    ret(&x);
}
