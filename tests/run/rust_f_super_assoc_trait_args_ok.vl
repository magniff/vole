// (0.30.1, review 4) rust_f_super_assoc_trait_args_err's subtrait read
// through the supertrait impl of its own trait arguments: Sup<i32>'s `A =
// &'c str` is what Sub's `get` returns, Sup<i64>'s `&'static str` beside
// it is another impl's.
// EXPECT: x y
trait Sup<P> {
    type A;
}

trait Sub: Sup<i32> {
    fn get(&self) -> Self::A;
}

struct X<'c> {
    r: &'c str,
}

impl<'c> Sup<i64> for X<'c> {
    type A = &'static str;
}

impl<'c> Sup<i32> for X<'c> {
    type A = &'c str;
}

impl<'c> Sub for X<'c> {
    fn get(&self) -> &'c str {
        self.r
    }
}

fn main(gpa: Gpa) {
    let s = String::from_in("y", gpa);
    let x = X { r: "x" };
    let y = X { r: s.as_str() };
    println("{} {}", x.get(), y.get());
}
