// (0.17, T7) A `&mut self` method on a place reached through a `&T` is a
// write through it: own.readonly, as an assignment is (it was accepted,
// and 0.17's migration could make such a parameter `&T`). A legacy `*T`
// receiver is not checked (the legacy rule), and a `&mut` parameter is
// fine. (0.20: an `inout self` method through a let parameter; an inout
// parameter is fine.)
use std::alloc::Allocator; struct Bag<A: Allocator> { v: Vec<i64, A> }

fn bump(b: &Bag<Gpa>) {
    b.v.push(7);
}

fn grow(b: &mut Bag<Gpa>) {
    b.v.push(7);
}

fn main(gpa: Gpa) -> i32 {
    let mut b = Bag { v: Vec::new_in(gpa) };
    grow(&mut b);
    bump(&b);
    0
}
