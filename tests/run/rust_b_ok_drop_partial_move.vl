// EDITION: rust
// RULE: D8.1
// (0.27.2) A partial move on std2: a field moved out of a struct with no
// `impl Drop` of its own drops where it went; the fields left drop at the
// struct's scope end, in declaration order.
struct D {
    id: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

struct Pair {
    a: D,
    b: D,
    c: D,
}

fn take(d: D) {
    println("take {}", d.id);
}

fn main() {
    let p = Pair { a: D { id: 1 }, b: D { id: 2 }, c: D { id: 3 } };
    take(p.b);
    println("end");
}
// EXPECT: take 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 1
// EXPECT: drop 3
