// (0.26.1) `#[pure]` refuses a write through a shared reference, a cell's
// read too; `#[no_io]`, `#[no_alloc]` and `#[no_panic]` allow it, and so
// does a trait method's #[pure] (Cell's Eq reads its cells).
// ERROR: [effect]: 'peek' is #[pure], but it writes through a shared reference (a cell, interior): 'c.get()' at
// ERROR: try: volec query effects peek --why interior
// ERROR-COUNT: 1
use std::cell::Cell;

#[pure]
fn peek(c: Cell<i64>) -> i64 {
    c.get()
}

#[no_io]
#[no_alloc]
#[no_panic]
fn quiet(c: Cell<i64>) -> i64 {
    c.set(2);
    c.get()
}

fn main() {
    let c = Cell::new(1);
    println("{} {} {}", peek(c), quiet(c), c == Cell::new(2));
}
