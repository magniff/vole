// RULE: D2.7, D19.2
// (0.30.1, RT-33 round 2, F4) `&mut *v` of a captured `v: &mut [i64]` in
// a closure: the reborrow, built and borrow-checked (before, the body
// could not be built: check said ok, and a build stopped with `places: a
// function not generated from its body`).
// EXPECT: 7
fn k(v: &mut [i64]) {
    let mut f = || {
        let m = &mut *v;
        m[0] = 7;
    };
    f();
}

fn main() {
    let mut a = [1i64, 2];
    k(&mut a);
    println("{}", a[0]);
}
