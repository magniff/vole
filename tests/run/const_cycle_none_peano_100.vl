// (0.30.2, RT-138) One trait constant's declaration at 100 instances
// (Peano: N::V of S<N> names V of N): each is another constant to the
// mark of a constant being made, no cycle. v0.30.1 refused it past 32
// levels ("the trait 'Nat' is not implemented"); 0.30.2's selection
// builds it, as rustc does (its own limit, E0275, is at 128).
// EXPECT: 100
trait Nat {
    const V: usize;
}

struct Z;

struct S<N> {
    n: N,
}

impl Nat for Z {
    const V: usize = 0;
}

impl<N: Nat> Nat for S<N> {
    const V: usize = N::V + 1;
}

fn v<T: Nat>() -> usize {
    T::V
}

fn main() {
    println("{}",
        v::<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<S<Z>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>());
}
