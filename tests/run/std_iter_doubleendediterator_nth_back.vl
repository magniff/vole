// Runs on std since 0.27.2's switch.
// The std item(s): std::iter DoubleEndedIterator::nth_back.
// EXPECT: Some(3) Some(1) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = v.iter();
    let a = it.nth_back(1);
    let b = it.nth_back(1);
    println("{:?} {:?} {:?}", a, b, it.nth_back(0));
}
