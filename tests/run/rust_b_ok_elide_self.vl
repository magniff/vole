// RULE: D4.2
// (0.27.1) E3: with `&self`, the elided output is self's region.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn pick(&self, o: &i64) -> &i64 {
        if *o > 0 {
            &self.x
        } else {
            &self.y
        }
    }
}

fn main() {
    let s = S { x: 7, y: 2 };
    let k: i64 = 1;
    let r = s.pick(&k);
    println("{}", *r);
}
// EXPECT: 7
