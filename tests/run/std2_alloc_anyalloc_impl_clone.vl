// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc AnyAlloc::impl Clone.
// EXPECT: 1 1
use std::alloc::AnyAlloc;

fn main(gpa: Gpa) {
    let a = AnyAlloc::new(&gpa);
    let b = a.clone();
    let v = Vec::from_in([1], a);
    let w = Vec::from_in([1], b);
    println("{} {}", v.len(), w.len());
}
