// XFAIL: gap 8: compile borrowck.use_moved: 'a' is used here after it moved (moved at alloc_fmt_room.vl: line 40, column 70...
// 0.16: formatting allocates nothing. A Fmt to a Buf writes into the room
// the Buf has and counts what does not fit; push_fmt then grows the Buf to
// the count and runs the Display again (twice only then). format_in
// formats into 256 bytes on the stack first. Padding, precision and
// right-alignment come out the same whether the text fit or not; a long
// precision of a float needs no heap either.
// EXPECT: runs 1: [x=     5|ab|   -7|00ff]
// EXPECT: runs 2: true [x=     5|ab|   -7|00ff] 24
// EXPECT: long: 300 300 [         a]
// EXPECT: 1.50000000000000000000 1107 true
// EXPECT: Ok(()) runs 4
// EXPECT:     3 3 1.500
use std::fmt::Display; use std::alloc::Arena; use std::alloc::AllocError;
use std::fmt::Formatter as Fmt;

static mut RUNS: i64 = 0;

#[derive(Clone, Copy)] struct Counted { n: i64 }

impl Display for Counted {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        unsafe { RUNS += 1; }
        write(f, "x={:>6}|{:.2}|{:>5}|{:04x}", self.n, "abcdef", -7, 255)?;
        Ok(()) }
}

#[no_alloc]
fn show(x: i64) {
    println("{x:>5} {x:x} {:.3}", 1.5);
}

fn main(gpa: Gpa) {
    let mut b: String<Gpa> = String::with_capacity_in(64usize, gpa);
    b.push_str("[");
    std::fmt::write(&mut b, (Counted { n: 5 })).unwrap();
    b.push_str("]");
    let runs_now = unsafe { RUNS }; println("runs {runs_now}: {b}");
    // a Buf with less room than the text: two runs, the same text
    unsafe { RUNS = 0; }
    let mut a = Arena::new_in(gpa);
    let mut c: String<Arena<Gpa>> = String::with_capacity_in(4usize, a);
    c.push_str("[");
    std::fmt::write(&mut c, (Counted { n: 5 })).unwrap();
    c.push_str("]");
    let runs_now = unsafe { RUNS };
    println("runs {runs_now}: {} {c} {}", c.capacity() > 4, c.len());
    // longer than format_in's 256 bytes on the stack
    let long = format_in("{:>300}", "a", a);
    let text = long.as_bytes();
    println("long: {} {} [{}]", long.len(), text.len(), &str::from_utf8(text[290..300]).unwrap());
    // a precision past a double's digits
    let p = format_in("{:.1105}", 1.5, gpa);
    let q = p.as_bytes();
    println("{} {} {}", &str::from_utf8(q[0..22]).unwrap(), q.len(), &q[1100..1107] == b"0000000");
    unsafe { RUNS = 0; }
    let mut d: String<Arena<Gpa>> = String::new_in(a);
    for i in 0..2 {
        std::fmt::write(&mut d, (Counted { n: i })).unwrap();
    }
    let r: Result<(), AllocError> = Ok(());
    let runs_now = unsafe { RUNS }; println("{r:?} runs {runs_now}");
    show(3);
}
