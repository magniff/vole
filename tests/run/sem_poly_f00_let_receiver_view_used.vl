// EDITION: rust
// the let-receiver bug with a view used after: h views s.v, s.grow() on a let s, then h read
// (0.25: rejected first as a write of the let s)
// ERROR: borrowck.borrow_immutable
use std::alloc::Allocator; struct S<A: Allocator> { v: Vec<i64, A> }
impl S<Gpa> { fn grow(&mut self) { for i in 0..1000 { self.v.push(i); } } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    let s = S { v: v };
    let h = s.v.as_slice();
    s.grow();
    println("{} {}", h[0], s.v.len());
}
