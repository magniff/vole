// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Not.
// EXPECT: V { x: -13 }
use std::ops::Not;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Not for V {
    type Output = V;

    fn not(self) -> V {
        V { x: !self.x }
    }
}

fn main() {
    let a = V { x: 12 };
    println("{:?}", !a);
}
