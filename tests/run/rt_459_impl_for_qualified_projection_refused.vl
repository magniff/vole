// XFAIL: RT-459: `impl G for <S as A>::Out { .. }` (an impl whose self type is a qualified projection, normalizing to S2) is refused, "'S' is not a module", and then `t.g()` on an S2 is "no method 'g'"; rustc prints 23 (0.30.2)
// From the second re-review of g302qual (its form p04_impl_for_projection). Since v0.30.1 at
// least (v0.30.1 and the release build give the same errors).
// EXPECT: 23
trait A {
    type Out;
    const N: i64;
    fn f() -> i64;
}

trait B {
    type Y;
    const M: i64;
}

struct S {}

impl A for S {
    type Out = S2;
    const N: i64 = 3;

    fn f() -> i64 {
        11
    }
}

#[derive(Clone, Copy)]
struct S2 {
    a: i64,
}

impl B for S2 {
    type Y = i64;
    const M: i64 = 2;
}

trait G {
    fn g(&self) -> i64;
}

impl G for <S as A>::Out {
    fn g(&self) -> i64 {
        23
    }
}

fn main() {
    let t = S2 { a: 1 };
    println("{}", t.g());
}
