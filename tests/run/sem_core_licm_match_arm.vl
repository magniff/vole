// EDITION: rust
// A guarded index in a match arm that never matches.
// FLAGS: -O2
// EXPECT: 5
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    let a = [1i64, 2, 3];
    let i = -1099511627776 + unsafe { Z };
    while k < 5 + unsafe { Z } { match k { 1000 => t += a[i as usize], _ => t += 1 } k += 1; }
    println("{}", t);
    0
}
