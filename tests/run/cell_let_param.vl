// (0.26.1) A let parameter of a cell, or of a struct holding one, is a
// shared reference to the caller's place: the callee's write reaches the
// caller (the review's DropCell row, with std's Cell).
// EXPECT: 2
// EXPECT: 3
// EXPECT: 4
// EXPECT: 5 6
use std::cell::Cell;

struct Counter { hits: Cell<i64>, name: i64 }

impl Counter {
    fn hit(self) { self.hits.set(self.hits.get() + 1); }
}

#[inline(never)]
fn bump(c: Cell<i64>) {
    c.set(c.get() + 1);
}

#[inline(never)]
fn hit_twice(k: Counter) {
    k.hit();
    k.hit();
}

#[inline(never)]
fn both(a: Cell<i64>, b: Cell<i64>) {
    a.set(5);
    b.set(6);
}

fn main() {
    let c = Cell::new(1);
    bump(c);
    println("{}", c.get());
    bump(c);
    println("{}", c.get());
    let k = Counter { hits: Cell::new(2), name: 0 };
    hit_twice(k);
    println("{}", k.hits.get());
    let x = Cell::new(0);
    let y = Cell::new(0);
    both(x, y);
    println("{} {}", x.get(), y.get());
}
