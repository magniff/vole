// RT-321's written forms: `*&y` of a `y: &mut S` is a place behind a `&`
// (places/build.vl deref_place folded `*&x` to x for any borrow), so
// using it as a `&mut S` or writing through it is refused, as rustc does:
// `k(*&y)` and `let w: &mut S = *&y` E0596, `(*&y).k += 1` E0594. A read
// through `*&y` and a `*&mut y` still build
// (rt_321c).
// ERROR: error[borrowck.
// ERROR: line 22
// ERROR: line 26
// ERROR: line 31
// ERROR-COUNT: 3
struct S {
    k: i64,
}

fn k(x: &mut S) -> i64 {
    x.k += 1;
    x.k
}

fn a(y: &mut S) -> i64 {
    k(*&y)
}

fn b(y: &mut S) -> i64 {
    let w: &mut S = *&y;
    k(w)
}

fn c(y: &mut S) -> i64 {
    (*&y).k += 1;
    0
}

fn main() {
    let mut s = S { k: 1 };
    println("{} {} {}", a(&mut s), b(&mut s), c(&mut s));
}
