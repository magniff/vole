// EDITION: rust
// XFAIL: gap 3: compile type error: expected 'let Cell<i64>', got 'Cell<i64>'
// (0.26.1) std::cell::Cell and UnsafeCell: every method, through a
// shared receiver.
// EXPECT: 1 2
// EXPECT: 2 3
// EXPECT: 3 0
// EXPECT: 10
// EXPECT: 7 5
// EXPECT: 5 7
// EXPECT: same 7
// EXPECT: 8 9
// EXPECT: clone 8 9
// EXPECT: default 0 false
// EXPECT: Cell { value: 4 }
// EXPECT: eq true false
// EXPECT: cmp -1 0 1
// EXPECT: unsafe 12 13 14
use std::cell::Cell; use std::cell::UnsafeCell;

fn main() {
    let c = Cell::new(1i64);
    let a = c.get();
    c.set(2);
    println("{a} {}", c.get());
    let old = c.replace(3);
    println("{old} {}", c.get());
    let t = c.take();
    println("{t} {}", c.get());
    c.set(5);
    c.update(|x| x * 2);
    println("{}", c.get());
    let p = Cell::new(7i64);
    let q = Cell::new(5i64);
    println("{} {}", p.get(), q.get());
    p.swap(&q);
    println("{} {}", p.get(), q.get());
    q.swap(&q);
    println("same {}", q.get());
    let r = Cell::new(8i64);
    let s = r.clone();
    s.set(9);
    println("{} {}", r.get(), s.get());
    println("clone {} {}", r.clone().get(), s.clone().into_inner());
    let d: Cell<i64> = Cell::default();
    let e: Cell<bool> = Cell::default();
    println("default {} {}", d.get(), e.get());
    println("{:?}", Cell::new(4i64));
    println("eq {} {}", Cell::new(1i64) == Cell::new(1i64), Cell::new(1i64) == Cell::new(2i64));
    println(
        "cmp {} {} {}", Cell::new(1i64).cmp(Cell::new(2i64)), Cell::new(2i64).cmp(Cell::new(2i64)),
        Cell::new(3i64).cmp(Cell::new(2i64)));
    let u = UnsafeCell::new(12i64);
    let up = u.get();
    // UNSAFE: a read and a write through UnsafeCell's pointer.
    // SAFETY: up is u's value's address; u lives and nothing else reaches it.
    let v0 = unsafe { *up };
    // UNSAFE: as above. SAFETY: as above.
    unsafe { *up = 13; }
    // UNSAFE: as above. SAFETY: as above.
    let v1 = unsafe { *u.get() };
    let w = Cell::new(14i64);
    println("unsafe {v0} {v1} {}", w.into_inner());
    let z = Cell::new(1i64);
    // UNSAFE: a read through as_ptr. SAFETY: z lives; nothing writes it meanwhile.
    let zp = unsafe { *z.as_ptr() };
    if zp != 1 {
        println("as_ptr");
    }
}
