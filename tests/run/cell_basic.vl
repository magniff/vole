// (0.26.1) std::cell::Cell and UnsafeCell: every method, through a
// shared receiver.
// EXPECT: 1 2
// EXPECT: 2 3
// EXPECT: 3 0
// EXPECT: 10
// EXPECT: 7 5
// EXPECT: 5 7
// EXPECT: same 7
// EXPECT: 8 9
// EXPECT: clone 8 9
// EXPECT: default 0 false
// EXPECT: Cell { value: 4 }
// EXPECT: eq true false
// EXPECT: cmp -1 0 1
// EXPECT: unsafe 12 13 14
use std::cell::{Cell, UnsafeCell};

fn main() {
    let c = Cell::new(1);
    let a = c.get();
    c.set(2);
    println(f"{a} {c.get()}");
    let old = c.replace(3);
    println(f"{old} {c.get()}");
    let t = c.take();
    println(f"{t} {c.get()}");
    c.set(5);
    c.update(|x| x * 2);
    println(f"{c.get()}");
    let p = Cell::new(7);
    let q = Cell::new(5);
    println(f"{p.get()} {q.get()}");
    p.swap(q);
    println(f"{p.get()} {q.get()}");
    q.swap(q);
    println(f"same {q.get()}");
    let r = Cell::new(8);
    let s = r.clone();
    s.set(9);
    println(f"{r.get()} {s.get()}");
    println(f"clone {r.clone().get()} {s.clone().into_inner()}");
    let d: Cell<i64> = Cell::default();
    let e: Cell<bool> = Cell::default();
    println(f"default {d.get()} {e.get()}");
    println(f"{Cell::new(4):?}");
    println(f"eq {Cell::new(1) == Cell::new(1)} {Cell::new(1) == Cell::new(2)}");
    println(
        f"cmp {Cell::new(1).cmp(Cell::new(2))} {Cell::new(2).cmp(Cell::new(2))} {Cell::new(3).cmp(Cell::new(2))}");
    let u = UnsafeCell::new(12);
    let up = u.get();
    // UNSAFE: a read and a write through UnsafeCell's pointer.
    // SAFETY: up is u's value's address; u lives and nothing else reaches it.
    let v0 = unsafe { *up };
    // UNSAFE: as above. SAFETY: as above.
    unsafe { *up = 13; }
    // UNSAFE: as above. SAFETY: as above.
    let v1 = unsafe { *u.get() };
    let w = Cell::new(14);
    println(f"unsafe {v0} {v1} {w.into_inner()}");
    let z = Cell::new(1);
    // UNSAFE: a read through as_ptr. SAFETY: z lives; nothing writes it meanwhile.
    let zp = unsafe { *z.as_ptr() };
    if zp != 1 {
        println("as_ptr");
    }
}
