// Runs on std since 0.27.2's switch.
// The std item(s): std::string String::clone_in.
// EXPECT: abc abc

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let arena = std::alloc::Arena::new_in(gpa);
    let t: String<&std::alloc::Arena<Gpa>> = s.clone_in(&arena);
    println("{} {}", s, t);
}
