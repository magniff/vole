// EDITION: rust
// RULE: D20.1, D20.3
// (0.27.2) The bound `Fn(&i64) -> &i64` gives the closure its signature: the
// result is the parameter's bound region (E2 at the bound), so `|p| p`
// returns what it is given.
// EXPECT: 7
fn call<F: Fn(&i64) -> &i64>(f: F) -> i64 {
    let v = 7;
    *f(&v)
}

fn main() {
    println("{}", call(|p| p));
}
