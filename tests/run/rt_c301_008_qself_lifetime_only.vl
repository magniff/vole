// RULE: F8.4
// `<L as Mk>::C`, L with only a lifetime parameter: no type argument to write (rustc 12). A guard: v0.30.1 builds it too.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// EXPECT: 12
trait Mk {
    fn mk() -> Self;
    const C: i64;
    type Out;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }

    const C: i64 = 7;
    type Out = i64;
}

struct L<'a> {
    r: Option<&'a i64>,
}

impl<'a> Mk for L<'a> {
    fn mk() -> L<'a> {
        L { r: None }
    }

    const C: i64 = 12;
    type Out = i64;
}

fn main() {
    println("{}", <L as Mk>::C);
}
