// XFAIL: RT-387f: UNSOUND: (RT-387 in methods: the result side of an unnormalized projection, with `&self` as the one reference parameter) an inherent `fn first<C: IntoIterator>(&self, c: C) -> Option<C::Item>` and a trait method of that signature tie the result to self, not to C: with C = `&v` or `w.as_slice()` the result outlives `drop(v)`, use after free (0.30.2)
// rustc E0505 at both drops (twin .rs.txt). vole checks it clean;
// --check-alloc: `use after free: block #1 (32 bytes)`, freed at the first
// drop. v0.28.0 to v0.30.1 the same. The ERRORs are at the drops. Elision gives `&self`'s region to every elided
// lifetime of the result, and the unnormalized `C::Item` reads as one.
// FLAGS: --check-alloc
// ERROR: line 34
// ERROR: line 38
struct H {
    n: i64,
}

impl H {
    fn first<C: IntoIterator>(&self, c: C) -> Option<C::Item> {
        c.into_iter().next()
    }
}

trait Pick {
    fn pick<C: IntoIterator>(&self, c: C) -> Option<C::Item>;
}

impl Pick for H {
    fn pick<C: IntoIterator>(&self, c: C) -> Option<C::Item> {
        c.into_iter().next()
    }
}

fn main(gpa: Gpa) {
    let h = H { n: 1 };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1001);
    let p = h.first(&v);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(1002);
    let q = h.pick(w.as_slice());
    drop(w);
    println("{:?} {:?}", p, q);
}
