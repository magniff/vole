// EXPECT: 7
// (RT-272) `T: H2 + Tr<Option<T::Out>>`: v0.30.1 crashed (bus error).
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H2 {
    type Out;
}

struct W {
    r: i64,
}

impl H2 for W {
    type Out = i64;
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

impl Tr<Option<i64>> for i64 {
    fn g(&self) -> i64 {
        7
    }
}

impl H2 for i64 {
    type Out = i64;
}

fn mid<T: H2 + Tr<Option<T::Out>>>(t: &T) -> i64 {
    t.g()
}

fn main() {
    println("{}", mid(&5i64));
}
