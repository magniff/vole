// XFAIL: RT-266: an impl block's `where` predicate on a compound type, `impl<T> Wr<T> where V<T>: Sup`, is not assumed in its methods: `self.v.up()` is refused, "the trait 'Sup' is not implemented for 'T'" (0.30.2)
// From the review of g302bor (c/c01, c07). rustc builds it and prints the
// EXPECT line. The same predicate on a fn (`fn go<T>(v: &V<T>) where V<T>:
// Sup`) is assumed (RT-C301-11's compound form); on an impl block it is not
// read. On v0.30.1 too.
// EXPECT: lit lit
trait Sup {
    fn up(&self) -> &'static str;
}

struct X<'a> {
    r: &'a str,
}

struct V<T> {
    t: T,
}

impl<'a: 'static> Sup for X<'a> {
    fn up(&self) -> &'static str {
        self.r
    }
}

impl<T: Sup> Sup for V<T> {
    fn up(&self) -> &'static str {
        self.t.up()
    }
}

impl<T: Sup> Sup for Option<T> {
    fn up(&self) -> &'static str {
        match self {
            Some(t) => t.up(),
            None => "none",
        }
    }
}

struct Wr<T> {
    v: V<T>,
}

impl<T> Wr<T>
    where
        V<T>: Sup,
{
    fn go(&self) -> &'static str {
        self.v.up()
    }
}

struct Wo<T> {
    o: Option<T>,
}

impl<T> Wo<T>
    where
        Option<T>: Sup,
{
    fn go(&self) -> &'static str {
        self.o.up()
    }
}

fn main() {
    let a = Wr { v: V { t: X { r: "lit" } } }.go();
    let b = Wo { o: Some(X { r: "lit" }) }.go();
    println("{} {}", a, b);
}
