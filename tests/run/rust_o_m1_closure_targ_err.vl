// (0.30.2, obligations M1) The call in a closure: Tr<i32>'s `'a: 'static`
// is required where the closure calls go (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<T: Tr<i32>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa); let w = W { r: st.as_str() };
        let c = || go(&w); c()
    };
    println("{}", s);
}
