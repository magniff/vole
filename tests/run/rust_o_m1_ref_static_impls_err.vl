// (0.30.2, obligations M1) An impl for `&'a T` beside one for `&'static T`
// overlap (rustc E0119).
// ERROR: trait.overlap
trait Tr { fn f(&self) -> i64; }
impl<'a, T> Tr for &'a T { fn f(&self) -> i64 { 1 } }
impl<T> Tr for &'static T { fn f(&self) -> i64 { 2 } }
fn go<T: Tr>(t: &T) -> i64 { t.f() }
fn main() { let x = 5i64; println("{}", go(&&x)); }
