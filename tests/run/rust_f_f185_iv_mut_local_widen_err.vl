// RULE: F18.5
// (0.30.1, F29.3; 0.30.2) A `let mut` local whose literal a use made
// i32 (`take32(a)`), computed in i32 after: not widened to i64 (rustc
// E0308; the value computed in i32 would differ). Its type is a variable
// until the function's end: the check reads it through the solution.
// ERROR: this 'i32' is not widened to 'i64' implicitly
fn take32(x: i32) -> i32 { x }

fn main() {
    let mut a = 2000000000;
    take32(a);
    a = a.wrapping_add(a);
    let b: i64 = a;
    println("{}", b);
}
