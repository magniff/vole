// (0.25.2) An import nothing in its file names is a warning, use.unused,
// whose try: line removes it (`volec fix --only unused`); one named only
// in an f-string, a #[test] or a generic function's body is used.
// WARNING: unused import 'Buf'
use std::{Buf, HashMap, Vec};
use std::string::String;

fn count<T>(v: Vec<T>, gpa: Gpa) -> i64 {
    let m: HashMap<i64, i64> = HashMap::new_in(gpa);
    v.len() + m.len()
}

fn main(gpa: Gpa) -> i32 {
    println(f"{String::new_in(gpa).len()}");
    0
}

#[test]
fn t(gpa: Gpa) {
    let v: Vec<i64> = Vec::new_in(gpa);
    assert(count(v, gpa) == 0);
}
// EXPECT: 0
