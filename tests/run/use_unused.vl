// WARNING: unused import 'HashSet'
use std::collections::{HashMap, HashSet};

fn count<T>(v: &Vec<T, Gpa>, gpa: Gpa) -> i64 {
    let m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    v.len() as i64 + m.len() as i64
}

fn main(gpa: Gpa) -> i32 {
    println("{}", String::new_in(gpa).len());
    0
}

#[test]
fn t(gpa: Gpa) {
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    assert(count(&v, gpa) == 0);
}
// EXPECT: 0
