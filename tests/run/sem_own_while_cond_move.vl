// sem-own: a value moved on some path inside a loop that may run again
// without reassigning is own.moved.
// ERROR: own.moved
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) {}

fn main(gpa: Gpa) {
    var d = mk(0, gpa);
    var i = 0;
    while i < 3 {
        if i == 1 { eat(d); }
        i += 1;
    }
}
