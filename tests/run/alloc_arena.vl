// XFAIL: gap 2: compile type error: unresolved import 'std::split_in'
// 0.16: an Arena (its chunks from main's Gpa) under every container:
// Vec, Buf, HashMap, and what std makes on an allocator it is given
// (format_in, collect_in, clone_in, split_in, sort_stable_in). Blocks
// bump through chunks; the last block grows in place; a request above
// 32 KB gets a chunk of its own (given back by `free`); `reset` keeps the
// chunks, `free_all` gives everything back.
// EXPECT: 499500 1000 4950 hello 42 [1, 2, 3]
// EXPECT: grew in place: true; used 24 then 48
// EXPECT: large: true, freed: true
// EXPECT: x=7 y=[1, 2, 3] 1234567890
// EXPECT: [0, 2, 4, 6, 8] 5 [a, bb, ccc] [1, 2, 3, 5, 8]
// EXPECT: copy on gpa: 45 [0, 1, 2]
// EXPECT: reset: used 0, chunks kept: true
// EXPECT: free_all: used 0
use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::Allocator; use std::alloc::Arena;
use std::collections::HashMap; use std::split_in;

fn total<A: Allocator>(v: &Vec<i64, A>) -> i64 {
    let mut t: i64 = 0;
    for x in v.iter().copied() {
        t += x;
    }
    t
}

fn main(gpa: Gpa) {
    let mut a = Arena::new_in(gpa);
    // containers
    let mut v: Vec<i64, Arena<Gpa>> = Vec::new_in(a);
    for i in 0..1000 {
        v.push(i);
    }
    let mut m: HashMap<i64, i64, Arena<Gpa>, FixedState> = HashMap::with_capacity_in(10usize, a);
    for i in 0..100 {
        m.insert(i, i);
    }
    let mut mt: i64 = 0;
    for i in 0..100 {
        mt += m.get(&i).copied().unwrap();
    }
    let mut b: String<Arena<Gpa>> = String::new_in(a);
    b.push_str("hello ");
    std::fmt::write(&mut b, 42i64).unwrap();
    let mut w: Vec<i64, Arena<Gpa>> = Vec::with_capacity_in(2usize, a);
    w.extend_from_slice(&[1i64, 2, 3][..]);
    println("{} {} {mt} {b} {w:?}", total(&v), v.len());
    // the last block grows in place
    let mut g = Arena::new_in(gpa);
    let p = g.allocate(Layout::from_size_align(16 as usize, 8 as usize).unwrap()).unwrap().as_ptr();
    let q = unsafe { g.resize(p, 16, 48, 8) };
    let before = g.used() as i64;
    unsafe {
        g.deallocate(NonNull::new(q).unwrap(),
            Layout::from_size_align(48 as usize, 8 as usize).unwrap());
    }
    let after = g
        .allocate(Layout::from_size_align(24 as usize, 8 as usize).unwrap())
        .unwrap()
        .as_ptr();
    println("grew in place: {}; used {} then {before}", p == q, g.used() as i64);
    // a block of its own
    let held = g.allocated_bytes() as i64;
    let mut big: Vec<u8, Arena<Gpa>> = Vec::with_capacity_in(80000usize, g);
    for i in 0..80000 {
        big.push((i % 7) as u8);
    }
    let lent = g.allocated_bytes() as i64 - held;
    drop(big);
    println("large: {}, freed: {}", lent >= 80000, g.allocated_bytes() as i64 == held);
    // formatting and std's functions on an arena
    let s = format_in("x={} y={w:?}", 7, a);
    let mut t: String<Arena<Gpa>> = String::new_in(a);
    std::fmt::write(&mut t, 1234567890i64).unwrap();
    println("{s} {t}");
    let evens = (0i64..5i64).map(|i: i64| i * 2).collect_in::<Vec<i64, Arena>, _>(a);
    let parts = split_in("a,bb,ccc", b',', a);
    let mut fib: Vec<i64, Arena<Gpa>> = Vec::new_in(a);
    for x in [8i64, 3, 5, 1, 2] {
        fib.push(x);
    }
    fib.as_mut_slice().sort_in(a);
    print("{evens:?} {} [", evens.len());
    for i in 0..parts.len() {
        print("{}", if i > 0 { ", " } else { "" });
        print("{}", str::from_utf8(parts[i]).unwrap());
    }
    println("] {fib:?}");
    let small: Vec<i64, Arena<Gpa>> = ((0i64..10i64)).collect_in(a);
    let mut copy = small.clone_in(gpa);
    copy.truncate(3usize);
    println("copy on gpa: {} {copy:?}", total(&small));
    drop(copy);
    // reset keeps the chunks; free_all gives them back
    let chunks = a.allocated_bytes() as i64;
    unsafe {
        a.reset();
    }
    println("reset: used {}, chunks kept: {}", a.used() as i64,
        a.allocated_bytes() as i64 == chunks);
    unsafe {
        drop(a);
        drop(g);
    }
    println("free_all: used {}", a.used() as i64);
}
