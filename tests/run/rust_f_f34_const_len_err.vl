// EDITION: rust
// RULE: F34.2
// (0.27.6) A constant whose value calls a function is made at each use:
// not yet a compile-time value, so not an array length (rustc evaluates
// `double(2)`; vole's gap, documented).
// ERROR: constant 'N' is made at each use
const fn double(x: usize) -> usize {
    x * 2
}

const N: usize = double(2);

fn main() {
    let a = [0u8; N];
    println("{}", a.len());
}
