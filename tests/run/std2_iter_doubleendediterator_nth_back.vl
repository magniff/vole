// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter DoubleEndedIterator::nth_back.
// EXPECT: Some(3) Some(1) None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = v.iter();
    let a = it.nth_back(1);
    let b = it.nth_back(1);
    println("{:?} {:?} {:?}", a, b, it.nth_back(0));
}
