// a generic over a trait returning a view: per instance the result views the argument
// ERROR: error[borrowck.conflict]
// ERROR: line 13, column 23
use std::alloc::Allocator; trait H { fn data(&self) -> &[i64]; }
struct S<A: Allocator> { v: Vec<i64, A> }
impl H for S<Gpa> { fn data(&self) -> &[i64] { self.v.as_slice() } }
fn get<T: H>(t: &T) -> &[i64] { t.data() }

fn main(gpa: Gpa) {
    let mut s = S { v: Vec::new_in(gpa) };
    s.v.push(1);
    let h = get(&s);
    for i in 0..100 { s.v.push(i); }
    println("{}", h[0]);
}
