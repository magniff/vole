// RT-282 (closed in 0.30.2): a generic fn's result tied to an iterator's item only through a fn-pointer parameter, `f: fn(I::Item) -> U` or `fn(B, C::Item) -> B`, keeps no borrow of the iterator: drop(v) while the result lives is accepted, a use after free from safe code (0.30.2)
// rustc E0505 at each drop (twin .rs.txt). The release build checks it
// clean; --check-alloc stops with `use after free: block #1 (32 bytes),
// allocated at ..:38:5, freed at ..:40:5`. The same shape with a closure,
// `F: Fn(I::Item) -> U`, keeps the borrow (refused right), and so does
// `I: Iterator<Item = X>` with result X. Not closed by g302bor's tie_all.
// FLAGS: --check-alloc
// ERROR: line 40
// ERROR: line 44
// ERROR: line 48
// ERROR-COUNT: 3
fn ap7<I: Iterator, U>(mut it: I, f: fn(I::Item) -> U) -> Option<U> {
    it.next().map(f)
}

fn ap6<C: IntoIterator, U>(c: C, f: fn(C::Item) -> U) -> Option<U> {
    c.into_iter().next().map(f)
}

fn fl<I: Iterator, B>(it: I, init: B, f: fn(B, I::Item) -> B) -> B {
    let mut b = init;
    for x in it {
        b = f(b, x);
    }
    b
}

fn idr<'a>(x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn pick<'a>(_b: Option<&'a i64>, x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = ap7(v.iter(), idr);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let s = ap6(&w, idr);
    drop(w);
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(3000);
    let t = fl(u.iter(), None, pick);
    drop(u);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?} {:?} {:?}", r, s, t, x);
}
