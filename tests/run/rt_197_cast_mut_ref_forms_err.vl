use std::ops::Deref;

struct H<'a> {
    r: &'a mut i64,
    s: &'a mut [i64],
}

struct W<'a> {
    h: H<'a>,
}

impl<'a> Deref for W<'a> {
    type Target = H<'a>;

    fn deref(&self) -> &H<'a> {
        &self.h
    }
}

fn f1(h: &H) -> *mut i64 {
    h.r as *mut i64
}

fn f2(h: &H) -> *mut [i64] {
    h.s as *mut [i64]
}

fn f3(h: &H) -> *mut [i64] {
    let p: *mut [i64] = h.s;
    p
}

fn f4<'a>(h: &'a H) -> &'a mut i64 {
    h.r as &mut i64
}

fn f5(t: &(&mut i64, i64)) -> *mut i64 {
    t.0 as *mut i64
}

fn f6(v: &[&mut i64]) -> *mut i64 {
    v[0] as *mut i64
}

fn f7(b: &Box<H, Gpa>) -> *mut i64 {
    b.r as *mut i64
}

fn f8(w: &W) -> *mut i64 {
    w.r as *mut i64
}

fn f9(h: &H) -> *mut i64 {
    let mut c = || h.r as *mut i64;
    c()
}

fn f10(h: &&mut i64) -> *mut i64 {
    *h as *mut i64
}

fn f11(h: &H) -> *mut u8 {
    h.r as *mut i64 as *mut u8
}

fn f12(h: &H) -> usize {
    h.r as *mut i64 as usize
}

fn f14(x: &mut i64) -> i64 {
    let a = &*x;
    let p = x as *mut i64;
    let _ = p;
    *a
}

