// RULE: F9.1, F9.3
// A generic type's inherent method and two traits' methods of the same
// name: `x.m()` is the inherent one, `Tr::m(&x)` each trait's.
// EXPECT: 123
trait A {
    fn get(&self) -> i64;
}

trait B {
    fn get(&self) -> i64;
}

struct W<T> {
    v: T,
}

impl<T> W<T> {
    fn get(&self) -> i64 {
        100
    }
}

impl<T> A for W<T> {
    fn get(&self) -> i64 {
        20
    }
}

impl<T> B for W<T> {
    fn get(&self) -> i64 {
        3
    }
}

fn main() {
    let w = W { v: 0u8 };
    println("{}", w.get() + A::get(&w) + B::get(&w));
}
