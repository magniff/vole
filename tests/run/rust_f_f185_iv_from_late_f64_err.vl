// RULE: F18.5
// (0.30.2) `f64::from(a)` of an integer variable a later use makes
// i64: From<i64> for f64 does not hold (it loses bits), rustc's E0277.
// ERROR: the trait 'From<i64>' is not implemented for 'f64' (rustc E0277)
fn main() {
    let a = 9007199254740993;
    let r = f64::from(a);
    let c: i64 = a;
    println("{} {}", r, c);
}
