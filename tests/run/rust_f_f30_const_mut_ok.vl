// EDITION: rust
// RULE: F30.3
// RUSTC: none FR4 (vole's `*const T` and `*mut T` are one type: rustc rejects it, E0308)
// vole's `*const T` and `*mut T` are one type (divergence FR4): a
// `*const u8` is passed for a `*mut u8` with no cast, which rustc
// rejects (E0308).
// EXPECT: 7
fn put(p: *mut u8, v: u8) {
    // UNSAFE: the caller's pointer.
    // SAFETY: p points to a live, writable u8 (main's).
    unsafe {
        *p = v;
    }
}

fn main() {
    let mut x: u8 = 0;
    let q: *const u8 = &mut x as *mut u8;
    put(q, 7);
    println("{}", x);
}
