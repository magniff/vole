// (0.30.2, the re-review of g302holes: r91/r18_opaque_after_main)
// EXPECT: 6 12
// EXPECT: 18
// A closure's result holds an impl Fn of a fn item defined after main, and an iterator closure.
fn main() {
    let v = [1i64, 2, 3];
    let mk = |m: i64| (base(m), v.iter().map(move |x| x * m));
    let (f, it) = mk(2);
    println("{} {}", f(1), it.sum::<i64>());
    let w = [1i64, 2];
    let s: i64 = w.iter().map(|y| base(*y)).map(|g| g(3)).sum();
    println("{s}");
}

fn base(k: i64) -> impl Fn(i64) -> i64 {
    let c = move |x: i64| x + k;
    move |x| c(x) * 2
}
