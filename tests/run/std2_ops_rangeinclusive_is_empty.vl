// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops RangeInclusive::is_empty.
// EXPECT: false false true
use std::ops::RangeInclusive;

fn main() {
    let a: RangeInclusive<i64> = 2..=5;
    let b: RangeInclusive<i64> = 3..=3;
    let c: RangeInclusive<i64> = 5..=2;
    println("{} {} {}", a.is_empty(), b.is_empty(), c.is_empty());
}
