// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter impl Sum for primitives.
// EXPECT: 6 6 1.5
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3], gpa);
    let u = Vec::from_in([1u8, 2, 3], gpa);
    let f = Vec::from_in([0.5f64, 1.0], gpa);
    let a: i64 = v.iter().copied().sum();
    let b: u8 = u.iter().sum();
    let c: f64 = f.iter().copied().sum();
    println("{} {} {}", a, b, c);
}
