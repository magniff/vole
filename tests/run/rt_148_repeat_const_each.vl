// FLAGS: --check-alloc
// RULE: F35.2, F34.2 (0.30.2, RT-148) A repeat of a constant whose type
// is not Copy makes each element from the constant: vole makes a
// constant at each use (F34.2), so a constant whose value calls a
// function calls it once per element, and each element is its own value,
// dropped once (v0.30.1 made one value and copied it: `mk` ran once and
// its D was dropped three times). rustc refuses `mk` in a constant (not a
// `const fn`, E0015), so this is vole's own case. A repeat of length 0
// of a local Vec frees it at once (v0.30.1 leaked it), one of length 1
// moves it.
// EXPECT: mk 1
// EXPECT: mk 2
// EXPECT: mk 3
// EXPECT: 3 1 2 3
// EXPECT: 0 1
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: end
use std::sync::atomic::{AtomicI64, Ordering};

struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

static N: AtomicI64 = AtomicI64::new(0);

fn mk() -> D {
    let k = N.fetch_add(1, Ordering::Relaxed) + 1;
    println("mk {}", k);
    D { k: k }
}

const C: D = mk();

fn main(gpa: Gpa) {
    {
        let a = [C; 3];
        println("{} {} {} {}", a.len(), a[0].k, a[1].k, a[2].k);
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        let z = [v; 0];
        let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
        w.push(2);
        let o = [w; 1];
        println("{} {}", z.len(), o[0].len());
    }
    println("end");
}
