// RULE: F18.1, F18.2
// A parameter neither the arguments nor the expected type fix is error
// type.infer (rustc E0282), with the turbofish to write.
// ERROR: error[type.infer]: cannot infer type parameter 'T' of 'make'
trait Zero {
    fn zero() -> Self;
}

impl Zero for i64 {
    fn zero() -> i64 {
        0
    }
}

fn make<T: Zero>() -> T {
    T::zero()
}

fn main() -> i64 {
    let x = make();
    0
}
