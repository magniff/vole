// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::binary_search_by.
// EXPECT: Ok(1) Err(0)

fn main() {
    let s: &[i64] = &[1, 3, 5, 7];
    println("{:?} {:?}", s.binary_search_by(|x| x.cmp(&3)), s.binary_search_by(|x| x.cmp(&0)));
}
