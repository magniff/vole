// RULE: F30.5
// (0.29) A `*const T` is not written through (rustc E0594), nor
// borrowed `&mut` (E0596): `*c = v`, a field or an element behind it,
// `&mut *c`. A `*mut T` field reached through a `*const T` is written
// through: the write goes through that pointer. `write` is a method of
// `*mut T` only.
// ERROR: error[type error]: cannot assign to '*c', which is behind a `*const` pointer
// ERROR: line 31, column 9
// ERROR: help: a `*const T` is read only: declare the pointer `*mut T` to write through it (rustc E0594)
// ERROR: cannot assign to '(*ps).x', which is behind a `*const` pointer
// ERROR: cannot assign to '(*ps).a[1]', which is behind a `*const` pointer
// ERROR: cannot borrow '*c' as mutable, as it is behind a `*const` pointer
// ERROR: help: a `*const T` is read only: declare the pointer `*mut T` to write through it (rustc E0596)
// ERROR: no method 'write' on type '*const i64'
// ERROR-COUNT: 5
struct S {
    x: i64,
    q: *mut i64,
    a: [i64; 2],
}

fn main() {
    let mut v: i64 = 5;
    let m: *mut i64 = &mut v;
    let c: *const i64 = m;
    let s = S { x: 1, q: m, a: [1, 2] };
    let ps: *const S = &s;
    // UNSAFE: reads and writes through raw pointers.
    // SAFETY: they point to the live locals v and s.
    unsafe {
        *c = 1;
        *m = 2;
        (*ps).x = 3;
        (*ps).a[1] = 3;
        *(*ps).q = 4;
        let r = &mut *c;
        let shared = &*c;
        c.write(7);
    }
}
