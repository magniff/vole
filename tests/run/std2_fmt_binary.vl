// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Binary.
// EXPECT: 101
use std::fmt::{Binary, Formatter};

struct W {
    v: u32,
}

impl Binary for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main() {
    println("{:b}", W { v: 5u32 });
}
