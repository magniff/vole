// Named arguments (0.15; 0.28.0: no parameter has a default value, F33.1):
// after the positional arguments, `name: value` in parameter order, for a
// function, a method and a generic function; every parameter is given.
// EXPECT: hello a|hi b|hello c|hello c|yo d|yo d|
// EXPECT: 1 1 0
// EXPECT: 30 6
// EXPECT: 2 7 7 b
// EXPECT: 5

fn greet(name: &str, greeting: &str, times: i64) {
    for _ in 0..times {
        print("{}", greeting);
        print(" ");
        print("{}", name);
        print("|");
    }
}

fn with(gpa: Gpa, x: i64, v: Option<Vec<i64, Gpa>>) -> Vec<i64, Gpa> {
    let mut v2 = match v {
        Some(v) => v,
        None => Vec::new_in(gpa),
    };
    v2.push(x);
    v2
}

#[derive(Clone, Copy)] struct Rect { w: i64, h: i64 }

impl Rect {
    fn scaled(self, by: i64) -> i64 {
        self.w * self.h * by
    }
}

fn twice<T>(x: T, n: i64) -> T {
    print("{}", n);
    print(" ");
    x
}

fn small(n: i32) -> i64 {
    n
}

fn main(gpa: Gpa) {
    greet("a", "hello", 1);
    greet("b", "hi", times: 1);
    greet("c", greeting: "hello", times: 2);
    greet("d", greeting: "yo", times: 2);
    println("");
    let a = with(gpa, 1, None);
    let b = with(gpa, 2, v: None);
    let mut c: Vec<i64, Gpa> = Vec::new_in(gpa);
    c.push(9);
    let d = with(gpa, 3, Some(c));
    print("{}", (a.len() as i64));
    print(" ");
    print("{}", (b.len() as i64));
    print(" ");
    print("{}", (a[0usize] - 1));
    println("");
    let r = Rect { w: 2, h: 3 };
    print("{}", r.scaled(5));
    print(" ");
    print("{}", r.scaled(by: 1));
    println("");
    print("{}", twice(7i64, 2i64));
    print(" ");
    println("{}", twice("b", n: 7i64));
    print("{}", small(5));
    println("");
}
