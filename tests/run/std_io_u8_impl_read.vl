// Runs on std since its gap closed (0.27.3).
// The std item(s): std::io &[u8]::impl Read.
// EXPECT: 2 [3]
use std::io::{BufRead, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut b = [0u8; 2];
    let n = r.read(&mut b).unwrap();
    println("{} {:?}", n, r);
}
