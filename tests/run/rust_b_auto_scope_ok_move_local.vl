// EDITION: rust
// RULE: AT6
// (0.27.2) A local of the scope's closure moved into the thread (`move`):
// no loan of it.
use std::thread;

fn main(gpa: Gpa) {
    let n = thread::scope(|s| {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(4);
        let h = s.spawn(move || v.len());
        h.join().unwrap()
    });
    println("{}", n);
}
// EXPECT: 1
