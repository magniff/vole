// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter &mut I::impl Iterator.
// EXPECT: Some(1) Some(2)

fn take_one<I: Iterator<Item = i64>>(mut it: I) -> Option<i64> {
    it.next()
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let mut it = v.iter().copied();
    let a = take_one(&mut it);
    println("{:?} {:?}", a, it.next());
}
