// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash RandomState::impl BuildHasher.
// EXPECT: true
use std::hash::{Hash, Hasher, RandomState};

fn main() {
    let s = RandomState::new();
    let mut a = s.build_hasher();
    let mut b = s.build_hasher();
    a.write("abc".as_bytes());
    b.write("abc".as_bytes());
    println("{}", a.finish() == b.finish());
}
