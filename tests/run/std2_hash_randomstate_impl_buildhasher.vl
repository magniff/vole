use std::hash::{BuildHasher, Hash, Hasher, RandomState};

fn main() {
    let s = RandomState::new();
    let mut a = s.build_hasher();
    let mut b = s.build_hasher();
    a.write("abc".as_bytes());
    b.write("abc".as_bytes());
    println("{}", a.finish() == b.finish());
}
