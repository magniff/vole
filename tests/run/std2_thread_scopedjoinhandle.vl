// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::thread ScopedJoinHandle.
// EXPECT: 1 4 9
use std::thread::{ScopedJoinHandle, self};

fn main() {
    let xs = [1i64, 2, 3];
    thread::scope(|s| {
        let h0: ScopedJoinHandle<i64> = s.spawn(|| xs[0] * xs[0]);
        let h1: ScopedJoinHandle<i64> = s.spawn(|| xs[1] * xs[1]);
        let h2: ScopedJoinHandle<i64> = s.spawn(|| xs[2] * xs[2]);
        println("{} {} {}", h0.join().unwrap(), h1.join().unwrap(), h2.join().unwrap());
    });
}
