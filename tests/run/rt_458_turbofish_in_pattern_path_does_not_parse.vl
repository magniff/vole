// XFAIL: RT-458: a turbofish in a pattern's path, `E::<u8>::V(x) =>`, `E::<u8>::N =>` and `let P::<u8> { t } = p;`, does not parse ("expected identifier, got '<'"); rustc prints `3 5` (0.30.2)
// From the second re-review of g302qual (its form p20_pattern_turbofish). Since v0.30.1 at
// least (v0.30.1 and the release build give the same parser errors).
// EXPECT: 3 5
enum E<T> {
    V(T),
    N,
}

struct P<T> {
    t: T,
}

fn main() {
    let e: E<u8> = E::V(3);
    let r = match e {
        E::<u8>::V(x) => x as i64,
        E::<u8>::N => 0,
    };
    let p = P::<u8> { t: 5 };
    let P::<u8> { t } = p;
    println("{} {}", r, t);
}
