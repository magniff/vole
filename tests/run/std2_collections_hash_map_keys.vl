// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Keys.
// EXPECT: 1
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Keys;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let k: Keys<'_, i64, i64> = m.keys();
    println("{}", k.count());
}
