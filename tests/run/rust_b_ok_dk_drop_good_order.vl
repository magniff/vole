// EDITION: rust
// RULE: D9.2
// (0.27.1) The referent declared first: it outlives the holder's drop.
// Checked since bc271 M3.

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let x: i64 = 1;
    let h = HD { r: &x };
    println("{}", *h.r);
}
// EXPECT: 1
// EXPECT: drop 1
