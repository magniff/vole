// EDITION: rust
// RULE: D9.2
// (0.27.1) The referent declared first: it outlives the holder's drop.
// XFAIL: bc271 M3: own.drop_view rejects `impl Drop` for a type holding references in the rust edition (dropck, S9, replaces it)

struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let x: i64 = 1;
    let h = HD { r: &x };
    println("{}", *h.r);
}
// EXPECT: 1
// EXPECT: drop 1
