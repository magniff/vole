// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::adapters Scan::impl Iterator.
// EXPECT: Some(1) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().scan(0i64, |a, x| {
        *a += x;
        if *a < 3 { Some(*a) } else { None }
    });
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
