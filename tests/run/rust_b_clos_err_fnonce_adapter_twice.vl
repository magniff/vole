// EDITION: rust
// RULE: D19.5, D19.7
// (0.27.2) An `Fn` closure (not `Copy`: it owns `d`) called twice through an
// `FnOnce` bound: the first call moves it (rustc E0382).
// ERROR: error[borrowck.use_moved]
struct D {
    v: i64,
}

fn twice<F: FnOnce() -> i64>(f: F) -> i64 {
    f() + f()
}

fn main() {
    let d = D { v: 2 };
    let c = move || d.v + 1;
    println("{}", twice(c));
}
