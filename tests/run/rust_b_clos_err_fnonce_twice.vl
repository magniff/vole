// EDITION: rust
// RULE: D19.7
// (0.27.2) An `FnOnce` closure is moved by its call: a second call uses a
// moved value (rustc E0382).
// ERROR: error[borrowck.use_moved]
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn main() {
    let s = S { n: 4 };
    let f = move || eat(s);
    let a = f();
    let b = f();
    println("{} {}", a, b);
}
