// XFAIL: RT-447c: (RT-447's mechanism, `&mut`) #[derive(PartialEq)] on `enum E<'a> { M(&'a mut i64), N }` is refused inside the derive: "no impl of 'i64::eq' takes arguments (&&mut i64)"; rustc prints `true false` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form r02b_derive_eq_enum_mut_ref.
// EXPECT: true false
#[derive(PartialEq)]
enum E<'a> {
    M(&'a mut i64),
    N,
}

fn main() {
    let mut x = 5i64;
    let mut y = 5i64;
    let m1 = E::M(&mut x);
    let m2 = E::M(&mut y);
    println("{} {}", m1 == m2, m1 == E::N);
}
