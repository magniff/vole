// XFAIL: RT-233: a borrowed temporary made in a block's tail, a match arm or an if arm and then used as a method receiver (`{ &mk(1) }.me()`, `match c { _ => &mk(2) }.me()`, `if c { &mk(3) } else { &mk(4) }.me()`) is accepted and never dropped (its Drop never runs, its memory leaks); `&mk(5).me().n` and `Some(&mk(6)).unwrap()` are accepted too (rustc E0716 at each) (0.30.2)
// rustc --edition 2024 refuses every `let` below with E0716 (twin .rs.txt;
// rustc 2021 accepts line 41's block form and drops its D at the end of the
// statement). The release build builds it and prints `use 1 2 3 5 6 7` and
// `vec [41, 42]`; no `drop 1`, `drop 2`, `drop 3` or `drop 7` is ever
// printed, and --check-alloc reports line 48's Vec (allocated at line 32) never freed.
// ERROR: line 41
// ERROR: line 42
// ERROR: line 43
// ERROR: line 44
// ERROR: line 45
// ERROR: line 46
// ERROR: line 48
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl D {
    fn me(&self) -> &D {
        self
    }
}

fn mk(n: i64) -> D {
    D { n: n }
}

fn mkv(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(41);
    v.push(42);
    v
}

fn w0() -> bool {
    true
}

fn main(gpa: Gpa) {
    let r = { &mk(1) }.me();
    let s = match w0() { _ => &mk(2) }.me();
    let t = if w0() { &mk(3) } else { &mk(4) }.me();
    let u = &mk(5).me().n;
    let o = Some(&mk(6)).unwrap();
    let p = (match 0 { _ => &mk(7) }).n;
    println("use {} {} {} {} {} {}", r.n, s.n, t.n, u, o.n, p);
    let v = { &mkv(gpa) }.as_slice();
    println("vec {:?}", v);
}
