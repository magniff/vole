// XFAIL: RT-155: `?` converts the error with the error type's inherent `from` or another trait's `from`, not From::from (0.30.2)
// rustc --edition 2024 prints the EXPECT lines (twin: r302d_003_try_calls_inherent_from.rs.txt).
// vole prints 'Err(E2 { c: -1 })' for 'Err(E2 { c: 998 })', 'Err(E3 { c: -3 })'
// for 'Err(E3 { c: 2998 })' and 'Err(E2 { c: -1 })' for 'Err(E2 { c: 1007 })',
// at -O0 and -O2: the `?` on a Result<_, E1> in a fn returning Result<_, E2>
// runs E2's inherent `fn from(e: E1)`, and for E3 the user trait Mk's `from`.
// `.into()` (the first line) is right. front/convert/mod.vl error_conversion
// builds `E2::from(e)` as a path call by name (line 1731). RT-77's and
// R302D-2's mechanism at one more site. Since v0.28.0 (v0.27.8 the same
// for the `?` lines).
// EXPECT: E2 { c: 1005 } E3 { c: 3006 }
// EXPECT: Ok(4) Err(E2 { c: 998 })
// EXPECT: Ok(6) Err(E3 { c: 2998 })
// EXPECT: Ok(Some(3)) Ok(None) Err(E2 { c: 1007 })
// EXPECT: Some(6) None None
#[derive(Debug)]
struct E1 {
    c: i64,
}

#[derive(Debug)]
struct E2 {
    c: i64,
}

impl From<E1> for E2 {
    fn from(e: E1) -> E2 {
        E2 { c: e.c + 1000 }
    }
}

impl E2 {
    fn from(e: E1) -> E2 {
        E2 { c: -1 }
    }
}

trait Mk {
    fn from(e: E1) -> Self;
}

#[derive(Debug)]
struct E3 {
    c: i64,
}

impl From<E1> for E3 {
    fn from(e: E1) -> E3 {
        E3 { c: e.c + 3000 }
    }
}

impl Mk for E3 {
    fn from(e: E1) -> E3 {
        E3 { c: -3 }
    }
}

fn f1(k: i64) -> Result<i64, E1> {
    if k > 0 { Ok(k) } else { Err(E1 { c: k }) }
}

fn g2(k: i64) -> Result<i64, E2> {
    let v = f1(k)?;
    Ok(v * 2)
}

fn g3(k: i64) -> Result<i64, E3> {
    let v = f1(k)?;
    Ok(v * 3)
}

fn nested(k: i64) -> Result<Option<i64>, E2> {
    let o: Option<i64> = if k > 5 { None } else { Some(k) };
    let r: Result<Option<i64>, E1> = if k < 0 { Err(E1 { c: 7 }) } else { Ok(o) };
    let inner = r?;
    Ok(inner)
}

fn opt(k: i64) -> Option<i64> {
    let a = Some(k).filter(|x| *x > 0)?;
    let b = nested(a).ok()??;
    Some(a + b)
}

fn main() {
    let e2: E2 = E1 { c: 5 }.into();
    let e3: E3 = E1 { c: 6 }.into();
    println("{:?} {:?}", e2, e3);
    println("{:?} {:?}", g2(2), g2(-2));
    println("{:?} {:?}", g3(2), g3(-2));
    println("{:?} {:?} {:?}", nested(3), nested(9), nested(-1));
    println("{:?} {:?} {:?}", opt(3), opt(9), opt(-1));
}
