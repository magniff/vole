// XFAIL: RT-235: a match arm whose body is an expression, not a block, drops the arm's binding before the temporaries of that expression: `Some(d) => show(d.n, mk(2).val())` prints `drop 1` then `drop 2`; rustc drops the temporary first (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt); the release build swaps the two drops in a, b and f, at -O0 and -O2.
// EXPECT: a: arm is a call
// EXPECT: show 1 2
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: b: arm is a binary expression
// EXPECT: drop 4
// EXPECT: drop 3
// EXPECT: x 7
// EXPECT: c: if-let body is a call
// EXPECT: show 5 6
// EXPECT: drop 6
// EXPECT: drop 5
// EXPECT: d: arm with a block
// EXPECT: show 7 8
// EXPECT: drop 8
// EXPECT: drop 7
// EXPECT: e: by-reference binding of a temporary scrutinee
// EXPECT: show 9 10
// EXPECT: drop 10
// EXPECT: drop 9
// EXPECT: f: closure arm
// EXPECT: drop 12
// EXPECT: drop 11
// EXPECT: f 1112
// EXPECT: end
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl D {
    fn val(&self) -> i64 {
        self.n
    }
}

fn mk(n: i64) -> D {
    D { n: n }
}

fn pick(n: i64) -> Option<D> {
    if n > 0 { Some(mk(n)) } else { None }
}

fn show(a: i64, b: i64) -> i64 {
    println("show {} {}", a, b);
    a + b
}

fn main() {
    println("a: arm is a call");
    match pick(1) {
        Some(d) => show(d.n, mk(2).val()),
        None => 0,
    };
    println("b: arm is a binary expression");
    let x = match pick(3) {
        Some(d) => d.n + mk(4).val(),
        None => 0,
    };
    println("x {}", x);
    println("c: if-let body is a call");
    if let Some(d) = pick(5) {
        show(d.n, mk(6).val());
    }
    println("d: arm with a block");
    match pick(7) {
        Some(d) => {
            show(d.n, mk(8).val())
        }
        None => 0,
    };
    println("e: by-reference binding of a temporary scrutinee");
    match &pick(9) {
        Some(d) => show(d.n, mk(10).val()),
        None => 0,
    };
    println("f: closure arm");
    let f = |o: Option<D>| match o {
        Some(d) => d.n * 100 + mk(12).val(),
        None => 0,
    };
    println("f {}", f(pick(11)));
    println("end");
}
