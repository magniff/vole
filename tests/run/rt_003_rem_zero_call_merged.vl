// RT-3 (fixed in 0.30.1): -O2 deletes a call whose division by zero panics: the effects count no division as a panic
// FLAGS: -O2
// The same with `%`: rem(5, 0) panics; at -O2 its two calls are merged and
// the third (unused) is deleted, so nothing panics and `same`, `end` print.
// STDERR: attempt to calculate the remainder with a divisor of zero
// EXIT: 101
#[inline(never)]
fn rem(a: i64, b: i64) -> i64 {
    a % b
}

fn main() {
    let n = std::env::args().count() as i64 - 1;
    let a = rem(5, n);
    let b = rem(5, n);
    if a == b {
        println("same");
    }
    let _c = rem(9, n);
    println("end");
}
