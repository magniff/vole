// XFAIL: RT-447b: (RT-447's mechanism, a braced variant) #[derive(PartialEq)] on `enum F<'a> { A { r: &'a u64 }, B }` is refused inside the derive: "no impl of 'u64::eq' takes arguments (&&u64)"; rustc prints true false false (0.30.2)
// Found while checking RT-447. Since v0.30.1 at least (the same error).
// EXPECT: true false false
#[derive(PartialEq)]
enum F<'a> {
    A { r: &'a u64 },
    B,
}

fn main() {
    let k = 3u64;
    let j = 4u64;
    println("{} {} {}", F::A { r: &k } == F::A { r: &k }, F::A { r: &k } == F::A { r: &j },
        F::A { r: &k } == F::B);
}
