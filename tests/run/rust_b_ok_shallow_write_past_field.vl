// EDITION: rust
// RULE: D2.5
// (0.27.2) A shallow write of `h` while `*h.r` is borrowed: the loan is past a
// deref beyond h's field, so the write does not reach it (rustc's
// Shallow(None)) and kills it; the old referent is written through p after.
struct H<'a> {
    r: &'a mut i64,
}

fn main() {
    let mut x = 1;
    let mut y = 2;
    let mut h = H { r: &mut x };
    let p = &mut *h.r;
    h = H { r: &mut y };
    *p = 5;
    *h.r = 6;
    println("{} {}", x, y);
}
// EXPECT: 5 6
