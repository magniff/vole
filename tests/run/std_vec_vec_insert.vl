// Runs on std since 0.27.2's switch.
// The std item(s): std::vec Vec::insert.
// EXPECT: [0, 1, 9, 2, 3]
// EXIT: 101
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2], gpa);
    v.insert(1, 9);
    v.insert(0, 0);
    v.insert(4, 3);
    println("{:?}", v);
    v.insert(9, 9);
}
