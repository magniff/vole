// RUSTC-EDITION: 2024
// RULE: D21.3, AT4
// (0.27.2.1) Auto traits leak: an `i32` hidden type makes the opaque type
// Send without the bound saying so.
// EXPECT: 4
trait Tr {
    fn get(&self) -> i32;
}

impl Tr for i32 {
    fn get(&self) -> i32 { *self }
}

fn make() -> impl Tr {
    let n: i32 = 4;
    n
}

fn need<T: Send + Tr>(t: T) -> i32 {
    t.get()
}

fn main() {
    println("{}", need(make()));
}
