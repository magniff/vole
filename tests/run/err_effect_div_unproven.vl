// RULE: E1.7 (0.30.1) What does not prove a divisor (effect_div_proofs.vl
// is what does): each of these may panic, and #[no_panic] refuses it. A
// literal 0, a signed -1 (MIN / -1), a constant 0, a cast constant that
// is -1, a mutable local however guarded, the branch where the guard
// fails, a division after the `if` that guarded only its branch, a signed
// divisor proven not 0 but not proven not -1 (and the other way round),
// an unsigned `d < 5` and a signed `d >= 0` (both allow 0), the MIN test
// of another local or of another value than MIN, an early `if` whose
// branch goes on, a closure inside a guarded branch (its own walk), a
// guard on a field, and `/=` guarded by its dividend and a signed `%=`
// whose divisor may be -1 (the dividend of `y op= d` is the place itself).
// ERROR: 'x / 0' at
// ERROR: column 5 is an integer division, which panics when the divisor is 0 or MIN / -1
// ERROR: 'x % ZERO' at
// ERROR: line 57, column 5 is an integer division
// ERROR: line 65, column 9 is an integer division
// ERROR: line 73, column 28 is an integer division
// ERROR: line 81, column 5 is an integer division
// ERROR: line 86, column 17 is an integer division
// ERROR: line 91, column 18 is an integer remainder
// ERROR: line 96, column 16 is an integer division
// ERROR: line 101, column 17 is an integer division
// ERROR: line 106, column 56 is an integer division
// ERROR: line 111, column 56 is an integer division
// ERROR: line 119, column 5 is an integer division
// ERROR: line 126, column 9 calls 'closure
// ERROR: line 134, column 19 is an integer division
// ERROR: line 142, column 9 is an integer division
// ERROR: line 152, column 9 is an integer remainder
// ERROR: line 159, column 28 is an integer division
// ERROR: line 165, column 63 is an integer division
// ERROR: line 173, column 56 is an integer division
// ERROR-COUNT: 21
const ZERO: u64 = 0;

struct S {
    d: u64,
}

#[no_panic]
fn f1(x: u64) -> u64 {
    x / 0
}

#[no_panic]
fn f2(x: i64) -> i64 {
    x / -1
}

#[no_panic]
fn f3(x: u64) -> u64 {
    x % ZERO
}

#[no_panic]
fn f4(x: i64) -> i64 {
    x / (18446744073709551615u64 as i64)
}

#[no_panic]
fn f5(x: u64, n: u64) -> u64 {
    let mut d = n;
    if d != 0 {
        d = d - 1;
        x / d
    } else {
        0
    }
}

#[no_panic]
fn f6(x: u64, d: u64) -> u64 {
    if d != 0 { 0 } else { x / d }
}

#[no_panic]
fn f7(x: u64, d: u64) -> u64 {
    if d != 0 {
        let _a = 1;
    }
    x / d
}

#[no_panic]
fn f8(x: i64, d: i64) -> i64 {
    if d != 0 { x / d } else { 0 }
}

#[no_panic]
fn f9(x: i64, d: i64) -> i64 {
    if d != -1 { x % d } else { 0 }
}

#[no_panic]
fn f10(x: u64, d: u64) -> u64 {
    if d < 5 { x / d } else { 0 }
}

#[no_panic]
fn f11(x: i64, d: i64) -> i64 {
    if d >= 0 { x / d } else { 0 }
}

#[no_panic]
fn f12(x: i64, y: i64, d: i64) -> i64 {
    if d == 0 || y == i64::MIN && d == -1 { 0 } else { x / d }
}

#[no_panic]
fn f13(x: i64, d: i64) -> i64 {
    if d == 0 || x == i64::MAX && d == -1 { 0 } else { x / d }
}

#[no_panic]
fn f14(x: u64, d: u64) -> u64 {
    if d == 0 {
        let _a = 1;
    }
    x / d
}

#[no_panic]
fn f15(x: u64, d: u64) -> u64 {
    if d != 0 {
        let f = |y: u64| y / d;
        f(x)
    } else {
        0
    }
}

#[no_panic]
fn f16(x: u64, s: &S) -> u64 {
    if s.d != 0 { x / s.d } else { 0 }
}

#[no_panic]
fn f17(x: u64, d: u64) -> u64 {
    // (the guard is the dividend's)
    let mut y = x;
    if x != 0 {
        y /= d;
    }
    y
}

#[no_panic]
fn f18(x: i64, d: i64) -> i64 {
    // (`y %= d`: d not 0, but it may be -1, and y may be MIN)
    let mut y = x;
    if d != 0 {
        y %= d;
    }
    y
}

#[no_panic]
fn f19(x: u64, d: u64, lo: u64) -> u64 {
    if d > lo { 0 } else { x / d }
}

#[no_panic]
fn f20(x: i32, d: i32) -> i32 {
    // i64::MIN is no i32 value: not i32's MIN
    if d == 0 || x as i64 == i64::MIN && d == -1 { 0 } else { x / d }
}

#[no_panic]
fn f21(x: i64, d: i64) -> i64 {
    // the dividend is mutable: its MIN test proves nothing
    let mut y = x;
    y = y + 0;
    if d == 0 || y == i64::MIN && d == -1 { 0 } else { y / d }
}

fn main() {
    let s = S { d: 2 };
    println("{} {} {} {} {} {} {}", f1(1), f2(1), f3(1), f4(1), f5(1, 2), f6(1, 0), f7(1, 1));
    println("{} {} {} {} {} {} {}", f8(1, 1), f9(1, 1), f10(1, 1), f11(1, 1), f12(1, 1, 1),
        f13(1, 1), f14(1, 1));
    println("{} {} {} {} {} {} {}", f15(1, 1), f16(1, &s), f17(1, 1), f18(1, 2), f19(1, 1, 0),
        f20(1, 1), f21(1, 1));
}
