// in a generic body with an owned T, var b = a of a let parameter cannot move
// ERROR: error[type error]
// ERROR: line 4, column 53
fn set<T>(a: &T, v: T) -> T { let mut b = a; b = v; b }

fn main(gpa: Gpa) {
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa); let y = set(&x, Vec::new_in(gpa));
    println("{} {}", x.len(), y.len());
}
