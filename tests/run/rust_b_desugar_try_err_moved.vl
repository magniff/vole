// RULE: D8.5
// (0.30.1) `r?` moves r into the desugaring's match (rustc's
// `Try::branch(r)`): a later use of r is E0382 (vole's use_moved).
// ERROR: error[borrowck.use_moved]
// ERROR: line 10, column 21
// ERROR-COUNT: 1
fn f(gpa: Gpa) -> Result<i64, String<Gpa>> {
    let r: Result<i64, String<Gpa>> = Ok(1);
    let x = r?;
    println("{:?}", r);
    Ok(x)
}

fn main(gpa: Gpa) {
    let _ = f(gpa);
}
