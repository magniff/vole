// RULE: D2.5
// (0.27.1) `&mut s` while `&mut s.x` is live: the new loan's place is a
// prefix of the old one's.
// ERROR: error[borrowck.mut_twice]
// ERROR: line 17, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let a = &mut s.x;
    let b = &mut s;
    *a += 1;
    b.y += 1;
    println("{}", s.x);
}
