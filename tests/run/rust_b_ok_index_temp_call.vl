// EDITION: rust
// RULE: (for the fixer)
// (0.27.4, gate 3's hidden borrowck wall: 2,677 of compiler/src's
// translated errors) A value copied out of an index expression,
// `pcx.nodes[p].start`, is an argument beside a reborrow of the same root
// (`pcx`): Index::index's reference temporary ends at the copy out, so
// rustc accepts the call; vole keeps it live to the call (a conflict).
// EXPECT: 5
use std::alloc::Allocator;

struct Node {
    start: i64,
}

struct Ctx<A: Allocator> {
    nodes: Vec<Node, A>,
    n: i64,
}

fn err_begin(at: i64, pcx: &mut Ctx<Gpa>) {
    pcx.n += at;
}

fn walk(p: i64, pcx: &mut Ctx<Gpa>) {
    err_begin(pcx.nodes[p as usize].start, pcx);
}

fn main(gpa: Gpa) {
    let mut c = Ctx { nodes: Vec::new_in(gpa), n: 0 };
    c.nodes.push(Node { start: 5 });
    walk(0, &mut c);
    println("{}", c.n);
}
