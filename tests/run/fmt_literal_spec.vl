// 0.26.2: format literals' specs, byte for byte Rust's: each EXPECT line
// is the output of the same line under rustc 1.98.0 (`println!`; an i64
// where vole's integer literal is one, `b as char` for vole's `{:c}`).
// EXPECT: [1] [1.0] [ffffffffffffffd6] [-0000042] [65] [A] ["hi\n"] [Some(3)] [  true] [1.5e3]
// EXPECT: plain {} braces
// EXPECT: [42] [42] [42] [1.5]
// EXPECT: [    42] [42    ] [  42  ] [**hi***]
// EXPECT: [   42   ] [+42] [0x2a] [52] [0o52] [0b101010] [00000042] [+00042] [0x0000002a]
// EXPECT: [1.500] [    1.50] [+1.5] [1.5e0] [1.5e3]
// EXPECT: ["hi"] [   hi] [h]
// EXPECT: [     42] [        9] [1.500] [   1.50]
// EXPECT: [1] [two] [1]
// EXPECT: [Some(3)]
// EXPECT: [ffffffffffffffd6] [-0000042] [   -42   ]
// EXPECT: [A] [0x0]
// EXPECT: [-1.5] [+0] [+0] [ 7] [7 ] [-7] [7] [    -7] [-0007]
// EXPECT: [2A] [101] [0x2A] [0x2a] [1.5E3] [0x002a] [==2a==]
// EXPECT: [ab   ] [ ab  ] [abc] [  a] [ 1.25]
// EXPECT: no newline 2
fn main() {
    let b: u8 = 65;
    println("[{}] [{:?}] [{:x}] [{:08}] [{}] [{:c}] [{:?}] [{:?}] [{:>6}] [{:e}]", 1, 1.0, -42, -42, b, b, "hi\n", Some(3), true, 1500.0);
    let n = 42;
    let x = 1.5;
    let s = "hi";
    println("plain {{}} braces");
    println("[{}] [{n}] [{0}] [{}]", n, x);
    println("[{:>6}] [{:<6}] [{:^6}] [{:*^7}]", n, n, n, s);
    println("[{n:^8}] [{n:+}] [{n:#x}] [{n:o}] [{n:#o}] [{n:#b}] [{n:08}] [{n:+06}] [{n:#010x}]");
    println("[{x:.3}] [{x:8.2}] [{x:+}] [{x:e}] [{:e}]", 1500.0);
    println("[{s:?}] [{s:>5}] [{s:.1}]");
    let w = 7;
    let p = 2;
    println("[{:w$}] [{:>1$}] [{:.*}] [{x:w$.p$}]", n, 9, 3, x);
    println("[{a}] [{b}] [{a}]", a = 1, b = "two");
    let v: Option<i64> = Some(3);
    println("[{v:?}]");
    let neg = -42;
    println("[{neg:x}] [{neg:08}] [{neg:^9}]");
    println("[{b:c}] [{:p}]", 0 as *u8);
    let m = -7;
    println("[{:+}] [{:+}] [{:+}] [{:2}] [{:<2}] [{m}] [{:-}] [{m:6}] [{m:05}]", -1.5, 0, -0, 7, 7, 7);
    println("[{n:X}] [{:b}] [{n:#X}] [{n:#x}] [{:E}] [{n:#06x}] [{n:=^6x}]", 5, 1500.0);
    println("[{:<5}] [{:^5}] [{:.3}] [{:>3.1}] [{:5.2}]", "ab", "ab", "abcdef", "abc", 1.25);
    print("no newline {}\n", 2);
}
