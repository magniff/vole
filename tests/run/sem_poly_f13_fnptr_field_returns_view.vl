// a fn pointer in a struct field whose result views its argument
// ERROR: error[borrowck.conflict]
#[derive(Clone, Copy)]
struct Ops { get: fn(&Vec<i64, Gpa>) -> &[i64] }
fn sl(d: &Vec<i64, Gpa>) -> &[i64] { d.as_slice() }

fn main(gpa: Gpa) {
    let o = Ops { get: sl };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = (o.get)(&v);
    for i in 0..1000 { v.push(i); }
    println("{}", s[0]);
}
