// EDITION: rust
// RULE: F26.3
// `g[i]` of a `g: &Grid`, Grid with Index: through the reference, as
// rustc's auto-deref does, `*g.index(i)`.
// EXPECT: 4 6
use std::ops::Index;

struct Grid {
    cells: [i64; 4],
}

impl Index<usize> for Grid {
    type Output = i64;

    fn index(&self, at: usize) -> &i64 {
        &self.cells[at]
    }
}

fn at(g: &Grid, i: usize) -> i64 {
    g[i] * 2
}

fn main() {
    let g = Grid { cells: [1, 2, 3, 4] };
    println("{} {}", at(&g, 1), at(&g, 2));
}
