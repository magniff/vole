// XFAIL: RT-238: `"-nan".parse::<f64>()` and `"-NaN".parse::<f32>()` drop the sign: a positive NaN, where rustc gives a NaN with the sign bit set (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt); the release build prints
// `7ff8000000000000 7fc00000 7ff8000000000000 false false true` at -O0 and -O2.
// EXPECT: fff8000000000000 ffc00000 7ff8000000000000 true true true
fn main() {
    let a = "-nan".parse::<f64>().unwrap();
    let b = "-NaN".parse::<f32>().unwrap();
    let c = "+nan".parse::<f64>().unwrap();
    let d = (-f64::NAN).is_sign_negative();
    println("{:016x} {:08x} {:016x} {} {} {}", a.to_bits(), b.to_bits(), c.to_bits(),
        a.is_sign_negative(), b.is_sign_negative(), d);
}
