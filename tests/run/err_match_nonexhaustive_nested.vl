// EDITION: rust
// ERROR: non-exhaustive match: '(Op::Div, false)' is not covered
use std::ops::Add; use std::ops::Div; #[derive(Clone, Copy, PartialEq, Eq)] enum Op { Add, Div }

fn f(p: (Op, bool)) -> i64 {
    match p {
        (Op::Add, _) => 1,
        (_, true) => 2,
    }
}

fn main() -> i64 { f((Op::Add, true)) }
