// Integer `/` and `%` panic on a zero divisor (and MIN / -1) at every -O
// level, so a #[no_panic] function that divides by a parameter may panic
// and must be refused, as an index or an unwrap is.
// ERROR: 'quot' is #[no_panic], but it may panic
// ERROR: 'rem' is #[no_panic], but it may panic
// ERROR-COUNT: 2
#[no_panic]
fn quot(a: i64, b: i64) -> i64 {
    a / b
}

#[no_panic]
fn rem(a: i64, b: i64) -> i64 {
    a % b
}

fn main() {
    let z = std::env::args().count() as i64 - 1;
    println("{}", rem(7, 3));
    println("{}", quot(1, z));
}
