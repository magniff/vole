// EDITION: rust
// XFAIL: gap 17: compile type error: function 'println' expects 1 arguments, got 2
// 0.6: the prelude comes last: a program's own items and its imports
// shadow it, and so do local bindings.
// EXPECT: mine 3
// EXPECT: 2 9
#[derive(Clone, Copy)] enum Opt { Some(i64), None }
use Opt::{None, Some};

fn println(x: i64) {
    std::fmt::print("mine ");
    print("{}", x);
    std::fmt::println("");
}

fn main() -> i32 {
    println("{}", 3);
    let o = Some(2i64);
    let n = match o { Some(v) => v, None => 0 };
    let print: i64 = 9;
    print("{}", n);
    std::fmt::print(" ");
    print("{}", print);
    std::fmt::println("");
    0
}
