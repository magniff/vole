// EDITION: rust
// RULE: F20.6
// (0.27.5) The place made mutable must be: `vs[0].push(..)` of a `let vs`
// changes vs (rustc E0596).
// ERROR: error[own.readonly]:
fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    let vs: Vec<Vec<i64, Gpa>, Gpa> = {
        let mut t = Vec::new_in(gpa);
        t.push(a);
        t
    };
    vs[0].push(2);
    println("{}", vs[0].len());
}
