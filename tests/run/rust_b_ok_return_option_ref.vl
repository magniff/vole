// RULE: D4.2
// (0.27.1) An `Option<&i64>` into a slice parameter returned (E2).

fn find(a: &[i64], k: i64) -> Option<&i64> {
    for x in a {
        if *x == k {
            return Some(x);
        }
    }
    None
}

fn main() {
    let a = [3i64, 4, 5];
    match find(&a[..], 4) {
        Some(r) => println("{}", *r),
        None => println("none"),
    }
}
// EXPECT: 4
