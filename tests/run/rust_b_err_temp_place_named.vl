// RULE: D2.7
// (0.30.1) A message names a temporary's place by the source of the
// expression it holds: `mk(w).s`, as rustc's E0596 names `*mk(w).s`.
// Before, the IR's form was printed, `(*_2).0`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*mk(w).s' as mutable
// ERROR: line 21, column 10
// ERROR-COUNT: 1
struct W<'a> {
    s: &'a mut [i64],
}

fn fill(s: &mut [i64]) {
    s[0] = 1;
}

fn mk<'a>(r: &'a W<'a>) -> &'a W<'a> {
    r
}

fn g(w: &W<'_>) {
    fill(mk(w).s);
}

fn main() {}
