// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Take::impl Iterator.
// EXPECT: Some(1) None (2, Some(2))
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3], gpa);
    let mut it = s.iter().take(1);
    let a = it.next().copied();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, s.iter().take(2).size_hint());
}
