// EDITION: rust
// RULE: D19.10, D20.3
// (0.27.2) `|| x` returns its `&` capture's reference: the result's region
// is the closure's (X_C), the capture's slot outlives it by a requirement
// checked where the closure is made, and `f()`'s result keeps `x`'s loan
// (0.27.1: a false borrowck.elision).
// EXPECT: 5
fn main() {
    let v = 5;
    let x = &v;
    let f = || x;
    let r = f();
    println("{}", *r);
}
