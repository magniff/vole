// EDITION: rust
// RULE: L3
// (0.27.3) An `if`'s condition and a match guard are terminating scopes
// in the rust edition (the Rust reference, "Temporary scopes"): `mk(1)`'s
// value drops once the condition is evaluated, before the branch runs,
// and a guard's temporary before its arm's body; a `while`'s condition's
// each time it is evaluated. A `let`'s temporary, `mk(4)` below, lives
// to the end of its statement.
// EXPECT: drop 1
// EXPECT: yes
// EXPECT: drop 2
// EXPECT: no
// EXPECT: drop 3
// EXPECT: arm
// EXPECT: drop 5
// EXPECT: loop
// EXPECT: drop 5
// EXPECT: drop 4
// EXPECT: sum 5
// EXPECT: end
struct D {
    id: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64) -> D {
    D { id: id }
}

fn main() {
    if mk(1).id == 1 {
        println("yes");
    }
    if mk(2).id == 0 {
        println("yes");
    } else {
        println("no");
    }
    let k: i64 = 7;
    match k {
        7 if mk(3).id == 3 => println("arm"),
        _ => println("other"),
    }
    let mut n: i64 = 0;
    while mk(5).id > n + 4 {
        println("loop");
        n += 1;
    }
    let s = mk(4).id + 1;
    println("sum {}", s);
    println("end");
}
