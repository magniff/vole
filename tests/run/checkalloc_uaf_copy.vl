// EDITION: rust
// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: 2
// STDERR: use after free: block #1 (32 bytes), allocated at
// STDERR: checkalloc_uaf_copy.vl:23:5, freed at
// STDERR: checkalloc_uaf_copy.vl:27:5
// 0.16: --check-alloc, the checking Gpa: a Vec's elements read after its
// free faults, reported with where the block was allocated and freed.
// (0.28: a second handle is a move, borrowck.use_moved; what outlives the
// Vec here is a raw pointer to its block.)
fn sum(p: *const i64, n: usize) -> i64 {
    let mut t: i64 = 0;
    for k in 0..n {
        // UNSAFE: the read goes through a pointer kept past the Vec's drop.
        // SAFETY: none after the drop, on purpose: --check-alloc stops it.
        t += unsafe { *p.add(k) };
    }
    t
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(1);
    let p = v.as_ptr();
    println("{}", sum(p, 2));
    drop(v);
    println("{}", sum(p, 2));
}
