// EDITION: rust
// XFAIL: gap 8: compile borrowck.use_moved: 'v' is used here after it moved (moved at checkalloc_uaf_copy.vl: line 23, colu...
// FLAGS: --check-alloc
// EXIT: 101
// EXPECT: 2
// STDERR: use after free: block #1 (32 bytes), allocated at
// STDERR: checkalloc_uaf_copy.vl:22:5, freed at
// STDERR: checkalloc_uaf_copy.vl:26:5
// 0.16 (0.17 rejects this code: --values=off, 0.16's semantics): --check-alloc, the checking Gpa: a Vec used after its free
// through a copied handle (a copy shares the memory: the gap 0.17's moves
// close) faults, reported with where the block was allocated and freed.
fn sum(v: Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for x in v.iter().copied() {
        t += x;
    }
    t
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(1);
    let copy = v;
    println("{}", sum(copy));
    drop(v);
    println("{}", sum(copy));
}
