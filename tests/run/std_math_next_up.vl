// (0.25.5) f64::next_up and next_down (Rust's), and f32's: the
// neighbouring numbers, by their bits, through zero, the subnormals and to
// the infinities; NaN and the infinity in the step's direction unchanged.
// EXPECT: 1 3ff0000000000001 3fefffffffffffff
// EXPECT: zero 1 8000000000000001 1 8000000000000001
// EXPECT: tiny 8000000000000000 0
// EXPECT: max inf true -inf
// EXPECT: nan true true
// EXPECT: -1 bfefffffffffffff bff0000000000001
// EXPECT: f32 3f800001 3f7fffff 1 80000001 inf
// EXPECT: sweep 1.0000000000000004 0.9999999999999997

use std::num::{f32_to_bits, f64_from_bits, f64_to_bits};

fn hex(x: f64) -> u64 { f64_to_bits(x) }

fn main() {
    println("1 {:x} {:x}", hex(1.0.next_up()), hex(1.0.next_down()));
    println(
        "zero {:x} {:x} {:x} {:x}", hex(0.0.next_up()), hex(0.0.next_down()), hex((-0.0).next_up()),
        hex((-0.0).next_down()));
    let tiny = f64_from_bits(1);
    println("tiny {:x} {:x}", hex((-tiny).next_up()), hex(tiny.next_down()));
    let inf = 1.0 / 0.0;
    println("max {} {} {}", f64::MAX.next_up(), (-inf).next_up() == -f64::MAX,
        (-f64::MAX).next_down());
    let nan = 0.0 / 0.0;
    println("nan {} {}", nan.next_up().is_nan(), inf.next_up() == inf);
    println("-1 {:x} {:x}", hex((-1.0).next_up()), hex((-1.0).next_down()));
    let one: f32 = 1.0;
    let z: f32 = 0.0;
    println(
        "f32 {:x} {:x} {:x} {:x} {}", f32_to_bits(one.next_up()), f32_to_bits(one.next_down()),
        f32_to_bits(z.next_up()), f32_to_bits(z.next_down()), f32::MAX.next_up());
    var x = 1.0;
    for _ in 0..2 { x = x.next_up(); }
    var y = 1.0;
    for _ in 0..3 { y = y.next_down(); }
    println("sweep {x} {y}");
}
