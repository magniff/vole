// RULE: M3
// (0.30.1) What rustc accepts of a static's parts: binders of Copy parts,
// `_`, `ref` binders, a match on `&SD`, a borrow, a Copy field read.
// EXPECT: 7 5 4 5 6 4 8 8 4 1 2 14
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct W {
    d: D,
    k: i64,
}

static SW: W = W { d: D { v: 4 }, k: 5 };
static ST: (D, i64) = (D { v: 6 }, 7);
static SD: D = D { v: 8 };
static SA: [i64; 2] = [1, 2];

fn peek(d: &D) -> i64 {
    d.v
}

fn main() {
    let (_, b) = ST;
    let W { k, .. } = SW;
    let W { ref d, k: k2 } = SW;
    let (ref a, _) = ST;
    let r = &SW;
    let n = match SD {
        ref x => peek(x),
    };
    let m = match &SD {
        x => x.v,
    };
    let s = if let W { ref d, .. } = SW { d.v } else { 0 };
    let p = SA[0];
    let q = SA[1];
    let _ = SD;
    let v = SW.k + ST.1 + SA[1];
    println("{} {} {} {} {} {} {} {} {} {} {} {}", b, k, d.v, k2, a.v, r.d.v, n, m, s, p, q, v);
}
