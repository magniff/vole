// EDITION: rust
// two live projections of the same value
// ERROR: error[borrowck.mut_twice]
// ERROR: line 9, column 76
#[derive(Clone, Copy)] struct S { a: i64, b: i64 }
fn pick(s: &mut S, first: bool) -> &mut i64 { if first { &mut s.a } else { &mut s.b } }

fn main() {
    let mut s = S { a: 1, b: 2 }; let r = pick(&mut s, true); let q = pick(&mut s, true); *q += 5;
    *r += 10;
    println("{}", s.a);
}
