// XFAIL: RT-400: a projection cycle is accepted: `impl<T: H> H for W<T> { type Out = <W<W<T>> as H>::Out; }` defines W<T>'s Out by W<W<T>>'s, without end, and `need(&W { t: 0i64 })` under `Z: H<Out = i64>` builds and prints 1 (rustc E0275, overflow evaluating the requirement) (0.30.2)
// From the review of g302oblig-m2 (form fcyc_proj). Since v0.30.1 at
// least; the release build the same. rustc E0275 at the projection in
// the impl (the rustc twin of this file). A limit is an error, never a
// yes: the normalization that cannot end must be refused, here or at the
// use.
// ERROR: line 17
trait H {
    type Out;
}

struct W<T> {
    t: T,
}

impl<T: H> H for W<T> {
    type Out = < W<W<T>> as H >::Out;
}

impl H for i64 {
    type Out = i64;
}

fn need<Z: H<Out = i64>>(z: &Z) -> i64 {
    1
}

fn main() {
    println("{}", need(&W { t: 0i64 }));
}
