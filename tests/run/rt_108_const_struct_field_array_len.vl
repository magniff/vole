// XFAIL: RT-108: an array length read from a const struct's field (`[u8; P.y]`) is "not a compile-time constant" (0.30.2)
// rustc prints the EXPECT line.
// EXPECT: 5
struct Pt {
    x: usize,
    y: usize,
}

const P: Pt = Pt { x: 1, y: 5 };

struct S {
    a: [u8; P.y],
}

fn main() {
    let s = S { a: [0; 5] };
    println("{}", s.a.len() + P.x - 1);
}
