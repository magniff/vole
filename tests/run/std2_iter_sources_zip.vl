// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::sources zip.
// EXPECT: [(1, 'a'), (2, 'b')]
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2, 3], gpa);
    let b = Vec::from_in(['a', 'b'], gpa);
    let v: Vec<(i64, char),
        Gpa> = std::iter::zip(a.iter().copied(), b.iter().copied()).collect_in(gpa);
    println("{:?}", v);
}
