// Gap 12: a method with a `requires` clause called through a `&mut`
// parameter. The clause's companion reads its arguments in place before
// the call reborrows the receiver; --verify-places took that read for a
// copy of an exclusive reference (I7) and refused the body.
// FLAGS: --verify-places
// EXPECT: 8
// EXPECT: 3
struct Queue {
    n: usize,
}

impl Queue {
    fn write(&mut self, at: usize, v: usize)
        requires at < 8
    {
        self.n += at + v;
    }
}

fn fill(q: &mut Queue) {
    q.write(1, 2);
    q.write(2, 3);
}

struct Pass<'a> {
    q: &'a mut Queue,
}

fn draw(p: &mut Pass) {
    p.q.write(0, 3);
}

fn main() -> i32 {
    let mut q = Queue { n: 0 };
    fill(&mut q);
    println("{}", q.n);
    let mut r = Queue { n: 0 };
    let mut p = Pass { q: &mut r };
    draw(&mut p);
    println("{}", r.n);
    0
}
