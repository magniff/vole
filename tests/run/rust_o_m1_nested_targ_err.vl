// (0.30.2, obligations M1) rust_o_m1_nested_targ_ok with the bound on the
// impl the reference chooses: `Tr<Option<i32>>`'s `'a: 'static` is required
// where go is called with a short W (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<Option<i32>> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<Option<i64>> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<T: Tr<Option<i32>>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = { let st = String::from_in("hello heap string long", gpa); go(&W { r: st.as_str() }) };
    println("{}", s);
}
