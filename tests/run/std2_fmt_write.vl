// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt Write.
// EXPECT: 5 2
use std::fmt::Write;

struct Count {
    bytes: usize,
    calls: usize,
}

impl Write for Count {
    fn write_str(&mut self, s: &str) -> std::fmt::Result {
        self.bytes += s.len();
        self.calls += 1;
        Ok(())
    }
}

fn main() {
    let mut c = Count { bytes: 0, calls: 0 };
    let _ = c.write_str("abc");
    let _ = c.write_str("de");
    println("{} {}", c.bytes, c.calls);
}
