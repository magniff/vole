// XFAIL: RT-123: two non-capturing closures in an if, a match or an array literal are refused as different types; Rust unifies them as a fn pointer (0.30.2)
// rustc takes the least upper bound of two distinct closure types that
// capture nothing as their common fn pointer type, `fn(i64) -> i64`.
// vole refuses `if c { |x: i64| x - 1 } else { |x: i64| x + 100 }`,
// the same in match arms, and `[|x: i64| x + 1, |x: i64| x + 2]`:
// "expected 'closure(i64) -> i64 at ..', got 'closure(i64) -> i64 at
// ..'". With the fn type written (`let fs: [fn(i64) -> i64; 2]`) it
// works. Since 0.28.0.
// EXPECT: 10 4 -5 2
fn main() {
    let fs: [fn(i64) -> i64; 2] = [|x| x + 1, |x| x * 2];
    let g = if fs.len() > 1 { |x: i64| x - 1 } else { |x: i64| x + 100 };
    let h = match 3 { 1 => |x: i64| x, _ => |x: i64| -x };
    let k = [|x: i64| x + 1, |x: i64| x + 2];
    println("{} {} {} {}", fs[1](5), g(5), h(5), k[1](0));
}
