// RULE: F8.1, D22.1
// `<T as B>::get(t)` under `T: A<Out = i64> + C<Out = bool>`, `trait C: B`: B reached through a supertrait (rustc `true 7`).
// From the gate suite of 0.30.2 (rt_c301_008_qualified_assoc_type_eq after the g302bor2 merge): `Self::Out` in trait B's declaration is `<Self as B>::Out` however the signature is read; places::regions::instance_type read a virtual function's signature without its trait (resolve::signature_enter) and called it ambiguous between A's and B's `Out`.
// EXPECT: true 7
trait A {
    type Out;
    fn get(&self) -> Self::Out;
}

trait B {
    type Out;
    fn get(&self) -> Self::Out;
}

trait C: B {
    fn c(&self) -> i64;
}

struct S;

impl A for S {
    type Out = i64;

    fn get(&self) -> i64 {
        7
    }
}

impl B for S {
    type Out = bool;

    fn get(&self) -> bool {
        true
    }
}

impl C for S {
    fn c(&self) -> i64 {
        3
    }
}

fn f<T: A<Out = i64> + C<Out = bool>>(t: &T) -> bool {
    let b: <T as B>::Out = <T as B>::get(t);
    b && t.c() == 3
}

fn main() {
    println("{} {}", f(&S), <S as A>::get(&S));
}
