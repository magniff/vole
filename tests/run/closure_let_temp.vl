// FLAGS: --check-alloc
// EXPECT: 6 6
// EXPECT: 13 105
// EXPECT: 0
// EXPECT: 0
// EXPECT: 1
// 0.25.4: a closure's let parameter takes a value with no place (a call's
// result), lent as a temporary of the statement and dropped at its end,
// as a function's let parameter does (0.25.3: "this value has no
// place"). Nothing leaks (--check-alloc).
fn make(n: i64, gpa: Gpa) -> Vec<i64> {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn total(v: Vec<i64>) -> i64 {
    var s = 0;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

fn main(gpa: Gpa) {
    let sum = |v: let Vec<i64>| -> i64 {
        var s = 0;
        for i in 0..v.len() {
            s += v[i];
        }
        s
    };
    let base = 100;
    let with_base = |v: let Vec<i64>, w: let String| base + v.len() as i64 + w.len() as i64;
    println(f"{total(make(4, gpa))} {sum(make(4, gpa))}");
    let n = sum(make(5, gpa)) + sum(make(3, gpa));
    let m = with_base(make(2, gpa), String::from_in("abc", gpa));
    println(f"{n} {m}");
    for k in 0..3 {
        println(f"{sum(make(k, gpa))}");
    }
}
