fn make(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut s: i64 = 0;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

fn main(gpa: Gpa) {
    let sum = |v: &Vec<i64, Gpa>| -> i64 {
        let mut s: i64 = 0;
        for i in 0..v.len() {
            s += v[i];
        }
        s
    };
    let base: i64 = 100;
    let with_base = |v: &Vec<i64, Gpa>, w: &String<Gpa>| base + v.len() as i64 + w.len() as i64;
    println("{} {}", total(&make(4, gpa)), sum(&make(4, gpa)));
    let n = sum(&make(5, gpa)) + sum(&make(3, gpa));
    let m = with_base(&make(2, gpa), String::from_in("abc", gpa));
    println("{n} {m}");
    for k in 0..3 {
        println("{}", sum(&make(k, gpa)));
    }
}
