impl Ord for D<Gpa> {
    fn cmp(&self, other: &D<Gpa>) -> std::cmp::Ordering { ({ self.id - other.id }).cmp(&0) }
} impl PartialOrd for D<Gpa> { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } }

fn gcollect<T>(s: &[T], gpa: Gpa) -> Vec<T, Gpa> { s.iter().copied().collect_in(gpa) }

fn gkeep<T>(s: &[T], gpa: Gpa) -> Vec<T, Gpa> {
    let mut k: Vec<T, Gpa> = Vec::new_in(gpa); for x in s.iter().copied() { k.push(x); } k
}

fn gfirst<T>(s: &[T]) -> T { s[0] }
fn gvget<T>(v: &Vec<T, Gpa>) -> T { v[0usize] }

