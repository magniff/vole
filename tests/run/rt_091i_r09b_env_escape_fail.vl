// (0.30.2, the re-review of g302holes: r91/r09b_env_escape_fail)
// ERROR: captured variable cannot escape `FnMut` closure body: the lifetime of the closure's environment is only the call's, but it flows where a lifetime of the closure's signature, from outside it is required, which lasts longer
// A closure whose environment holds a closure made later in source but used earlier in id order.
fn main() {
    let v = [1i64, 2, 3];
    let inner = move |x: i64| v.iter().map(move |y| y + x).sum::<i64>();
    let outer = move |z: i64| inner(z) * 2;
    let outer2 = move |z: i64| { let zz = [z, z + 1]; zz.iter()
        .flat_map(move |q| v.iter().map(move |r| r * q))
        .sum::<i64>() + outer(z) };
    println("{}", outer(1));
    println("{}", outer2(1));
}
