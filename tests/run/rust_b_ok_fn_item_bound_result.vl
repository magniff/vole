// RULE: R6
// (0.30) The accepted side of rust_b_err_fn_item_bound_result: a fn item
// whose result owns nothing, or borrows nothing of the argument, given
// for `F: Fn(&T) -> R`; and adapters' items through fold where nothing is
// borrowed after its last use.
// EXPECT: 2 5
// EXPECT: 3
fn len(d: &Vec<i64, Gpa>) -> usize {
    d.len()
}

fn first(d: &Vec<i64, Gpa>) -> i64 {
    d[0]
}

fn apply<T, R, F: Fn(&T) -> R>(x: &T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(5);
    v.push(6);
    println("{} {}", apply(&v, len), apply(&v, first));
    let x = 3i64;
    let a = [&x];
    let z = 0i64;
    let out = a.iter().copied().fold(&z, |acc, p| p);
    let out2 = a.iter().map(|p| *p).fold(out, |acc, p| p);
    println("{}", *out2);
}
