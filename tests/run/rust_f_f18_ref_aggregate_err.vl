// RULE: F18.4
// (0.27.5) The borrowed literal checked where `&U` goes keeps U's shape:
// an array of another length is a type error (rustc E0308), and a literal
// that does not fit its element type is out of range (rustc: a deny lint).
// ERROR: error[type error]: array has 3 elements, expected 2
// ERROR: line 12, column 32
// ERROR: error[type error]: integer literal 256 does not fit
// ERROR: line 13, column 32
// ERROR-COUNT: 2
fn main() {
    let c = true;
    let b: &[i64; 2] = if c { &[1, 2, 3] } else { &[3, 4] };
    let d: &[u8; 1] = if c { &[256] } else { &[0] };
    println("{} {}", b[0], d[0]);
}
