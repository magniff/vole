// XFAIL: RT-38e: in a fn with `ensures`, a closure writing through a captured `&mut` binding gets a false "not declared as mutable" (open)
// `let q = &mut y; let mut c = || { *q += n; }; c();` writes through q,
// which needs no `let mut` (rustc and vole accept it in a fn without
// contracts: the same body without the `ensures` builds and returns 3).
// With an `ensures` clause on the fn, whatever the clause holds, vole
// reports "cannot borrow 'q' as mutable, as it is not declared as
// mutable" at the closure. Pre-existing in 0.30.0; found by the review of
// the RT-33 branch.
// EXPECT: 3
fn f(n: i64) -> i64
    ensures { let mut x = 0i64; let r = &mut x; let mut c = || { *r += 1; }; c(); x == 1 }

{
    let mut y = 0i64;
    let q = &mut y;
    let mut c = || {
        *q += n;
    };
    c();
    y
}

fn main() {
    println("{}", f(3));
}
