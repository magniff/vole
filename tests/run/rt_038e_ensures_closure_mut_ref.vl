// RT-38e (0.30.1): in a fn with `ensures`, a closure writing through a
// captured `&mut` binding: `let q = &mut y; let mut c = || { *q += n; };
// c();` writes through q, which needs no `let mut` (rustc accepts it, and
// vole without the clause). In 0.30.0, with an `ensures` clause on the
// fn, whatever the clause held, vole reported "cannot borrow 'q' as
// mutable, as it is not declared as mutable" at the closure; the
// compiler-made bodies under Rust's rules (RT-34, RT-38) accept it.
// Found by the review of the RT-33 branch.
// EXPECT: 3
fn f(n: i64) -> i64
    ensures { let mut x = 0i64; let r = &mut x; let mut c = || { *r += 1; }; c(); x == 1 }

{
    let mut y = 0i64;
    let q = &mut y;
    let mut c = || {
        *q += n;
    };
    c();
    y
}

fn main() {
    println("{}", f(3));
}
