// EDITION: rust
// The std2 item(s): std::fmath f64::to_bits; f64::from_bits; f64::abs; f64::signum; f64::copysign; f64::is_nan; f64::is_finite; f64::is_infinite; f64::is_normal; f64::is_subnormal; f64::is_sign_positive; f64::is_sign_negative; f64::next_up; f64::next_down; f64::total_cmp.
// EXPECT: 3ff0000000000000 8000000000000000 3.141592653589793
// EXPECT: 2.5 -1 1 -2
// EXPECT: false true false false false true false
// EXPECT: false true false true false false true
// EXPECT: false true false false true true false
// EXPECT: false false true false false true false
// EXPECT: true false false false false true false
// EXPECT: false true false true false true false
// EXPECT: 1.0000000000000002 0.9999999999999999 0. inf
// EXPECT: [-inf, -3.5, -0.0, 0.0, 2.0] true
use std::cmp::Ordering;

fn main(gpa: Gpa) {
    println("{:x} {:x} {}", 1.0f64.to_bits(), (-0.0f64).to_bits(),
        f64::from_bits(0x400921fb54442d18));
    println("{} {} {} {}", (-2.5f64).abs(), (-0.0f64).signum(), 3.0f64.signum(),
        2.0f64.copysign(-1.0));
    let vals = [0.0f64, -1.5, 1e-310, f64::INFINITY, f64::NAN, f64::MIN_POSITIVE];
    for v in vals.iter() {
        let v = *v;
        println("{} {} {} {} {} {} {}", v.is_nan(), v.is_finite(), v.is_infinite(), v.is_normal(),
            v.is_subnormal(), v.is_sign_positive(), v.is_sign_negative());
    }
    println("{} {} {} {}", 1.0f64.next_up(), 1.0f64.next_down(), 0.0f64.next_up(),
        f64::MAX.next_up());
    let mut v: Vec<f64, Gpa> = Vec::new_in(gpa);
    v.push(2.0);
    v.push(-0.0);
    v.push(f64::NEG_INFINITY);
    v.push(0.0);
    v.push(-3.5);
    v.sort_by(|a, b| a.total_cmp(b));
    println("{:?} {:?}", v, 1.0f64.total_cmp(&f64::NAN) == Ordering::Less);
}
