// (0.26.3) alloc.last: an `_in` function takes its allocator last, as
// Rust's allocator API does (`Vec::with_capacity_in(cap, alloc)`). No fix:
// `volec refactor signature` moves it, with every call.
// ERROR: error[alloc.last]: 'copy_in' takes its allocator 'a' before its last parameter: an `_in` function takes it last
// ERROR: help: move the allocator to the end of the parameters (Rust's `with_capacity_in(cap, alloc)`), and at every call: `volec refactor signature` does both
// ERROR: error[alloc.last]: 'fill_in' takes its allocator 'gpa' before its last parameter
// ERROR-COUNT: 2
use std::alloc::Allocator; fn copy_in<A: Allocator>(a: A, s: &[i64]) -> Vec<i64, A> {
    let mut v: Vec<i64, A> = Vec::new_in(a);
    for &x in s {
        v.push(x);
    }
    v
}

fn fill_in(gpa: Gpa, n: usize) -> Vec<i64, Gpa> {
    Vec::from_elem_in(0i64, n, gpa)
}

// (last: allowed)
fn ok_in<A: Allocator>(s: &[i64], a: A) -> Vec<i64, A> {
    copy_in(a, s)
}

fn main() {}
