// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str char::impl Pattern; std::str &[char]::impl Pattern.
// EXPECT: Some(2) Some(4) ["a", "b", "c"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "a-b-c";
    println("{:?} {:?} {:?}", s.find('b'), s.rfind('-').map(|i| i + 1),
        s.split('-').collect_in::<Vec<&str, Gpa>, Gpa>(gpa));
}
