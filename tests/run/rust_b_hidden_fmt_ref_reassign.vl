// RULE: D2.9
// (0.30.1) A format argument that is a reference is borrowed itself (the
// hole is `&r`): giving r a new value in a later argument is E0506, as
// rustc. Before, the hole was a copy of r and the program printed the
// old referent.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 14, column 9
// ERROR-COUNT: 1
fn main() {
    let a = 1;
    let b = 2;
    let mut r = &a;
    println("{} {}", r, {
        r = &b;
        0
    });
    println("{r}");
}
