// The std2 item(s): std::alloc Arena.
// EXPECT: 3 [1, 2] hi
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let x = arena.alloc(3i64);
    let s = arena.alloc_slice_copy(&[1, 2]);
    let t = arena.alloc_str("hi");
    println("{} {:?} {}", x, s, t);
}
