// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter Iterator::flatten.
// EXPECT: [1, 2, 3]

fn main(gpa: Gpa) {
    let v = Vec::from_in([Some(1i64), None, Some(2), Some(3)], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().flatten().collect_in(gpa);
    println("{:?}", a);
}
