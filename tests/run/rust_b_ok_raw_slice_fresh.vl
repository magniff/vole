// RULE: D3.8
// (0.27.2) A reference through a raw pointer is a deref of it: no loan, and
// the reference's region is fresh (F30.1), so `slice::from_raw_parts(p, n)`
// (std2's ptr::slice_parts, `&p[0..n]` in std2's ptr module only, F30.3)
// returned as `&'a [T]` is not borrowck.return_local, nor `&*d.add(i)` with
// d a local, and two `from_raw_parts_mut` of one pointer are not
// borrowck.mut_twice.
unsafe fn parts<'a, T>(p: *const T, n: usize) -> &'a [T] {
    std::slice::from_raw_parts(p, n)
}

unsafe fn at<'a>(p: *const i64, i: usize) -> &'a i64 {
    let d = p;
    &*d.add(i)
}

unsafe fn halves<'a>(p: *mut i64, n: usize) -> (&'a mut [i64], &'a mut [i64]) {
    (std::slice::from_raw_parts_mut(p, 1), std::slice::from_raw_parts_mut(p.add(1), n - 1))
}

fn main() {
    let mut a = [1i64, 2, 3];
    let p = &mut a[0] as *mut i64;
    // SAFETY: p points at a's 3 elements, which outlive the uses below.
    let (n, x) = unsafe { (parts(p as *const i64, 3).len(), *at(p as *const i64, 1)) };
    // SAFETY: as above; [0, 1) and [1, 3) do not overlap.
    let (h, t) = unsafe { halves(p, 3) };
    h[0] = 10;
    t[0] = 20;
    println("{} {} {} {}", n, x, a[0], a[1]);
}
// EXPECT: 3 2 10 20
