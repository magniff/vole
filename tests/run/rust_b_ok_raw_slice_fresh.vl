// EDITION: rust
// RULE: D3.8
// RUSTC: none indexing a raw pointer is vole's (std2's slice_parts; rustc writes slice::from_raw_parts)
// (0.27.2) Slicing a raw pointer, or a reference through one is a deref of it: no loan,
// and the reference's region is fresh (F30.1), so `&p[0..n]` returned as
// `&'a [T]` is not borrowck.return_local, p a parameter or a local, and
// two `&mut p[..]` of one pointer are not borrowck.mut_twice (std2's
// ptr::slice_parts behind from_raw_parts).
unsafe fn parts<'a, T>(p: *const T, n: usize) -> &'a [T] {
    &p[0..n]
}

unsafe fn at<'a>(p: *const i64, i: usize) -> &'a i64 {
    let d = p;
    &*(&d[i])
}

unsafe fn halves<'a>(p: *mut i64, n: usize) -> (&'a mut [i64], &'a mut [i64]) {
    (&mut p[0..1], &mut p[1..n])
}

fn main() {
    let mut a = [1, 2, 3];
    let p = &mut a[0] as *mut i64;
    // SAFETY: p points at a's 3 elements, which outlive the uses below.
    let (n, x) = unsafe { (parts(p as *const i64, 3).len(), *at(p as *const i64, 1)) };
    // SAFETY: as above; [0, 1) and [1, 3) do not overlap.
    let (h, t) = unsafe { halves(p, 3) };
    h[0] = 10;
    t[0] = 20;
    println("{} {} {} {}", n, x, a[0], a[1]);
}
// EXPECT: 3 2 10 20
// XFAIL: indexes a raw pointer, an error since E0608 (F30.3); rewrite to ptr::slice_parts' shape (clos272)
