// (0.30.2, RT-138) A free constant (made at each use: a tuple) and an
// associated one in one cycle: rustc E0391. (A free i64 constant naming an
// associated one is RT-124's "not a compile-time constant" so far; once
// consteval reads it, const_value's mark is the same one.)
// ERROR: const.cycle]: constant 'S::X' is defined in terms of itself (a cycle: S::X -> F -> S::X)
const F: (i64, i64) = (S::X.1, 1);
struct S;

impl S {
    const X: (i64, i64) = (2, F.0);
}

fn main() {
    println("{}", S::X.0);
}
