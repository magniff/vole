// RULE: D4.5, F10.2
// (0.30.1) The bounds that give `T: 'static` without writing it on the
// parameter, as rustc reads them: the implied bound of `t: &'static T`, a
// `where I::Item: 'static` on a projection, a supertrait `trait St:
// 'static`, an associated type declared `type Out: 'static`, a lifetime
// `'a: 'static` with `T: 'a`, a `where T: 'static`; and a `where` clause
// on a projection gives its bounds to the generic check (`I::Item: Copy`
// lets the body copy an item).
// EXPECT: 3 0 1 2 4 5 6 7 9
use std::thread;
fn need<T: 'static>(t: T) -> i64 { 1 }

fn implied<T: Sync>(t: &'static T, gpa: Gpa) -> i64 {
    let h = thread::spawn_in(move || { let q = t; 3i64 }, gpa);
    h.join().unwrap()
}

static X: i64 = 3;

fn projected<I: Iterator>(mut i: I) -> i64 where I::Item: 'static { need(i.next()) - 1 }

trait St: 'static {}
impl St for i64 {}
fn supertrait<T: St>(t: T) -> i64 { need(t) }

trait Tr { type Out: 'static; fn out(&self) -> Self::Out; }
impl Tr for i64 { type Out = i64; fn out(&self) -> i64 { *self } }
fn assoc<T: Tr>(t: T) -> i64 { need(t.out()) + 1 }

fn outlives<'a: 'static, T: 'a>(t: T) -> i64 { need(t) + 3 }
fn where_static<T>(t: T) -> i64 where T: 'static { need(t) + 4 }

fn copies<I: Iterator>(mut i: I) -> i64 where I::Item: Copy, I::Item: Into<i64> {
    let x = i.next().unwrap();
    let y = x;
    x.into() + y.into()
}

trait Tr2 { fn f<T: 'static>(&self, x: T) -> i64; fn g(self) -> i64 where Self: 'static; }
impl Tr2 for i64 { fn f<T: 'static>(&self, x: T) -> i64 { *self } fn g(self) -> i64 { self } }
fn through<X: Tr2, T: 'static>(x: &X, t: T) -> i64 { x.f(t) }
fn through_self<X: Tr2 + 'static>(x: X) -> i64 { x.g() }

fn main(gpa: Gpa) {
    println("{} {} {} {} {} {} {} {} {}", implied(&X, gpa), projected(0..3i64), supertrait(1i64),
        assoc(1i64), outlives(1i64), where_static(2i64), copies(3..4i64), through(&7i64, 1i64),
        through_self(9i64));
}
