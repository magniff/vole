// XFAIL: RT-324: the bound `T: Conv<i64, Out = i64>` is checked against Conv<i32>'s Out at the call `g(&s)` (S has impls of Conv<i32> and Conv<i64>): "'S::Out' is 'u8', but the bound ... requires 'i64'" (0.30.2)
// Since v0.30.1 at least (the review's form f25). RT-86's family (T::Out
// read from Tr<i32>'s impl under T: Tr<i64>), here in the bound check of a
// call. rustc builds it and prints the EXPECT line.
// EXPECT: 4 1001 1 1001
trait Conv<X> { type Out; fn get(&self) -> Self::Out; }
struct S;
impl Conv<i32> for S { type Out = u8; fn get(&self) -> u8 { 250 } }
impl Conv<i64> for S { type Out = i64; fn get(&self) -> i64 { 1000 } }

fn g<T: Conv<i64, Out = i64>>(t: &T) -> i64 {
    let v: <T as Conv<i64>>::Out = <T as Conv<i64>>::get(t); v + 1
}

fn main() {
    let s = S;
    let a: <S as Conv<i32>>::Out = <S as Conv<i32>>::get(&s);
    let b: <S as Conv<i64>>::Out = <S as Conv<i64>>::get(&s);
    println("{} {} {} {}", a.wrapping_add(10), b + 1,
        std::mem::size_of::< <S as Conv<i32>>::Out>(), g(&s));
}
