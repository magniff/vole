// 0.25.3 (eval 0.25.2.2: six agents on std::gpu's handles): own.moved and
// own.move_out name the statement that moved a move-only handle: a struct
// literal moves its fields, a tuple its parts, `Vec::push` keeps what it is
// given (std's: no "take it let" there); a std::gpu handle's help points at
// `volec guide gpu#handles`.
// ERROR: 'd' is used here after it moved into the struct literal 'App { .. }' at
// ERROR: help: a literal moves the values it is given: use it before the literal, or reach it through its new owner (the literal's field); a function that only reads it takes it let ('x: T'); std::gpu's handles move and are kept by one owner: `volec guide gpu#handles`
// ERROR: 'b' is used here after it moved into 'Vec::push(sink x)' at
// ERROR: help: 'Vec::push' keeps it: use it before the call, or reach it where it is kept ('v[i]', 'v.last()')
// ERROR: cannot move 'self.a' (Buffer) out of a reference
// ERROR: help: a tuple moves 'self.a' out of its owner, and 'Buffer' has no Default to leave in its place (no 'std::take') and no '.clone()': read it in place where it is needed, passing 'self.a' itself to a let parameter (`f(self.a)`), or make the literal where the value is owned (a 'sink' parameter, a local); std::gpu's handles move and are kept by one owner: `volec guide gpu#handles`
// ERROR: cannot move 'self.b' (Buffer) out of a reference
// ERROR: cannot move 'self.a' (Buffer) out of a reference
// ERROR: help: the struct literal 'Holder { .. }' moves 'self.a' out of its owner
// ERROR: cannot move 'self.a' (Buffer) out of a reference
// ERROR: help: an `if` or `match` that picks 'self.a' moves it out
// ERROR: cannot move 'self.b' (Buffer) out of a reference
// ERROR-COUNT: 7
use std::gpu;

struct App { dev: gpu::Device, n: i64 }

struct Holder { buf: gpu::Buffer }

fn look(d: gpu::Device) {}

fn read(b: gpu::Buffer) {}

fn make(d: sink gpu::Device) -> App {
    let app = App { dev: d, n: 0 };
    look(d);
    app
}

fn keep(b: sink gpu::Buffer, gpa: Gpa) {
    var v: Vec<gpu::Buffer> = Vec::new_in(gpa);
    v.push(b);
    read(b);
}

struct Pair { a: gpu::Buffer, b: gpu::Buffer }

impl Pair {
    fn swap(inout self) {
        let (x, y) = (self.a, self.b);
    }

    fn hold(inout self) -> Holder {
        Holder { buf: self.a }
    }

    fn pick(inout self, k: i64) {
        let g = if k == 0 { self.a } else { self.b };
        read(g);
    }
}

fn main() {}
