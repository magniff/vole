// A call whose requires fails, under a condition that never holds, in a loop.
// EXPECT: 10
static mut Z: i64 = 0;

fn half(x: i64) -> i64
    requires x > 0
{
    x / 2
}

#[inline(never)]
fn half_ni(x: i64) -> i64
    requires x > 0
{
    x / 2
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let x = unsafe { Z };
    let mut s: i64 = 0;
    for k in 0..10 + unsafe { Z } {
        if k > 100 { s += half(x) + half_ni(x); }
        s += 1;
    }
    let o: Option<i64> = if unsafe { Z } == 1 { Some(3i64) } else { None };
    for k in 0..10 + unsafe { Z } {
        if o.is_some() { s += o.unwrap(); }
    }
    println("{}", s);
    0
}
