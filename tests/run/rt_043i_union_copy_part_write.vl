// RULE: F19.7
// (0.30.2, RT-43) A write to a part of a union's Copy field reads
// nothing and stays safe, as in Rust: a struct's field, a tuple's, an
// array's whole, nested through a Copy struct to an inner union.
// EXPECT: 9
// EXPECT: 4
// EXPECT: 6
// EXPECT: 8
#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

union In {
    x: i64,
    y: f64,
}

impl Clone for In {
    fn clone(&self) -> In {
        *self
    }
}

impl Copy for In {}

#[derive(Clone, Copy)]
struct H {
    i: In,
    k: i64,
}

union U {
    c: C,
    t: (i64, i64),
    h: H,
    arr: [i64; 2],
}

fn main() {
    let mut u = U { arr: [0, 0] };
    u.c.a = 9;
    // UNSAFE: reads the array the struct's field wrote over
    // SAFETY: C is two i64s laid out as the array's
    println("{}", unsafe { u.arr[0] });
    u.t.1 = 4;
    // UNSAFE: reads the array the tuple's field wrote over
    // SAFETY: the tuple is two i64s laid out as the array's
    println("{}", unsafe { u.arr[1] });
    u.h.i.x = 6;
    // UNSAFE: reads the inner union's field just written
    // SAFETY: x was written, an i64
    println("{}", unsafe { u.h.i.x });
    u.arr = [8, 8];
    // UNSAFE: reads the struct over the array just written
    // SAFETY: C is two i64s laid out as the array's
    println("{}", unsafe { u.c.b });
}
