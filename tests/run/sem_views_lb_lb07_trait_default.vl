// EDITION: rust
// XFAIL: gap 8: compile borrowck.return_local: a reference to 'self', a local of this function, escapes it (borrowed at sem...
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: abcd (a trait default method returning a view of self)
// EXPECT: abcd 7
#[derive(Clone, Copy)] struct E { name: [u8; 4], len: i64 }

trait N {
    fn raw(&self) -> &[u8];
    fn nm(self) -> &'static [u8] { self.raw() }
}

impl N for E { fn raw(&self) -> &[u8] { &self.name[..self.len as usize] } }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: [b'a', b'b', b'c', b'd'], len: 4 };
    let n = e.nm();
    let k = clobber();
    println("{n} {k}", n = str::from_utf8(n).unwrap());
    0
}
