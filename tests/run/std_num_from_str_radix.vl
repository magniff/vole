// The std item(s): the integers' from_str_radix (i8 .. usize); std::num
// ParseIntError, IntErrorKind, their Display.
// EXPECT: Ok(-255) Ok(5) Ok(1295) Ok(255)
// EXPECT: Ok(-128) Ok(127) Ok(-9223372036854775808) Ok(18446744073709551615)
// EXPECT: InvalidDigit InvalidDigit InvalidDigit Empty
// EXPECT: PosOverflow NegOverflow PosOverflow PosOverflow
// EXPECT: invalid digit found in string
// EXPECT: cannot parse integer from empty string
// EXPECT: number too large to fit in target type
// EXPECT: number too small to fit in target type
// EXPECT: Ok(7) Ok(35) true
use std::num::{IntErrorKind, ParseIntError};

fn kind<T>(r: Result<T, ParseIntError>) -> IntErrorKind {
    match r {
        Ok(_) => IntErrorKind::Zero,
        Err(e) => e.kind().clone(),
    }
}

fn main() {
    println("{:?} {:?} {:?} {:?}", i64::from_str_radix("-ff", 16), u8::from_str_radix("101", 2),
        u64::from_str_radix("zz", 36), u8::from_str_radix("+FF", 16));
    println("{:?} {:?} {:?} {:?}", i8::from_str_radix("-80", 16), i8::from_str_radix("7f", 16),
        i64::from_str_radix("-9223372036854775808", 10),
        u64::from_str_radix("18446744073709551615", 10));
    println("{:?} {:?} {:?} {:?}", kind(u8::from_str_radix("-1", 10)),
        kind(i32::from_str_radix("12", 2)), kind(i16::from_str_radix("-", 10)),
        kind(usize::from_str_radix("", 10)));
    println("{:?} {:?} {:?} {:?}", kind(i8::from_str_radix("80", 16)),
        kind(i8::from_str_radix("-81", 16)), kind(u64::from_str_radix("18446744073709551616", 10)),
        kind(u16::from_str_radix("10000", 16)));
    println("{}", u8::from_str_radix("x", 10).unwrap_err());
    println("{}", "".parse::<i32>().unwrap_err());
    println("{}", "300".parse::<u8>().unwrap_err());
    println("{}", "-129".parse::<i8>().unwrap_err());
    let e = "x".parse::<i64>().unwrap_err();
    println("{:?} {:?} {}", isize::from_str_radix("7", 8), u32::from_str_radix("z", 36),
        *e.kind() == IntErrorKind::InvalidDigit);
}
