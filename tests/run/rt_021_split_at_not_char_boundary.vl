// `s.split_at(1)` of "\u{e9}t" (bytes C3 A9 74) must panic: 1 is inside
// the first char. std's split_at is `(&self[..mid], &self[mid..])`, and
// the checker gives std's `s[a..b]` of a str no boundary check
// (front/check/synth_mode.vl synth_index, RULE Z9.1b: only a program's,
// `!within_std`), so it returns the strs [C3] and [A9 74]: not UTF-8.
// The program's own `&s[1..]` panics as it should.
// STDERR: not a char boundary
// EXIT: 101
fn main() {
    let s = "\u{e9}t";
    // no arguments: a is 1
    let a = std::env::args().count();
    let (x, y) = s.split_at(a);
    println("{:?} {:?}", x.as_bytes(), y.as_bytes());
}
