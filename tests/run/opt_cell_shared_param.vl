// (0.26.1) Two shared parameters of a cell alias one value, and a writer
// changes it between two loads: a let parameter (`&Cell<i64>` in the IR)
// and a slice of cells, with the writer not inlined, then inlined (a store
// through UnsafeCell::get's pointer between the loads). A shared reference
// to what is not Freeze gives GVN no fact (param_class_of: PC_NONE), so
// -O2 reloads after the write and prints it.
// CHECK: fn twice:
// CHECK: call put
// CHECK: load
// CHECK: fn twice_slice:
// CHECK: call put_slice
// CHECK: load
// CHECK: fn twice_inl:
// CHECK: store
// CHECK: load
// FLAGS: -O2
// EXPECT: 5
// EXPECT: 6
// EXPECT: 7
use std::cell::Cell;

#[inline(never)]
fn put(d: Cell<i64>, x: i64) {
    d.set(x);
}

#[inline(never)]
fn twice(c: Cell<i64>, d: Cell<i64>) -> i64 {
    let a = c.get();
    put(d, 5);
    c.get() + a * 0
}

#[inline(never)]
fn put_slice(d: [Cell<i64>], x: i64) {
    d[0].set(x);
}

#[inline(never)]
fn twice_slice(c: [Cell<i64>], d: [Cell<i64>]) -> i64 {
    let a = c[0].get();
    put_slice(d, 6);
    c[0].get() + a * 0
}

#[inline]
fn put_inl(d: Cell<i64>, x: i64) {
    d.set(x);
}

#[inline(never)]
fn twice_inl(c: Cell<i64>, d: Cell<i64>) -> i64 {
    let a = c.get();
    put_inl(d, 7);
    c.get() + a * 0
}

fn main() {
    let c = Cell::new(1);
    println(f"{twice(c, c)}");
    let arr = [Cell::new(1), Cell::new(2)];
    println(f"{twice_slice(arr[0..2], arr[0..2])}");
    println(f"{twice_inl(c, c)}");
}
