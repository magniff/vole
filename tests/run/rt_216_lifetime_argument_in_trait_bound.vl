// XFAIL: RT-216: a bound naming a trait's lifetime parameter (`M: Mk<'a>`, inline or in a where clause) is a parser error, "expected a type argument"; `impl<'a> Mk<'a> for H<'a>` parses (0.30.2)
// rustc prints the EXPECT line (twin: r302d_035_lifetime_argument_in_trait_bound.rs.txt).
// vole: `expected a type argument` at lines 19 and 25. Since v0.28.0.
// EXPECT: 4 4
trait Mk<'a> {
    fn mk(r: &'a i64) -> Self;
}

struct H<'a> {
    r: &'a i64,
}

impl<'a> Mk<'a> for H<'a> {
    fn mk(r: &'a i64) -> H<'a> {
        H { r }
    }
}

fn build<'a, M: Mk<'a>>(r: &'a i64) -> M {
    M::mk(r)
}

fn build2<'a, M>(r: &'a i64) -> M
    where
        M: Mk<'a>,
{
    M::mk(r)
}

fn main() {
    let k = 4i64;
    let h: H = build(&k);
    let g: H = build2(&k);
    println("{} {}", h.r, g.r);
}
