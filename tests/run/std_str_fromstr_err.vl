// Runs on std since 0.27.2's switch.
// The std item(s): std::str FromStr::Err.
// EXPECT: Err(ParseIntError { kind: InvalidDigit })
// RUSTC: none (std has no std::num: the parse errors are std::str's)
use std::str::{FromStr, ParseIntError};

fn main() {
    let r: Result<u8, <u8 as FromStr>::Err> = u8::from_str("x1");
    let e: Result<u8, ParseIntError> = r;
    println("{:?}", e);
}
