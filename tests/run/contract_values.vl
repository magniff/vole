// (0.18 with 0.17's values) Clauses read owned parameters in place: a
// requires check's companion takes the call's arguments without moving
// them (nor dropping them), so a by-value Vec passed to a function with a
// requires is moved once, into the function; std's `unwrap` (a requires)
// of an owned Option and `v.get(i)` (a borrowed copy) through a requires
// check's block keep their 0.17 meaning. --check-alloc: nothing leaks and
// nothing is freed twice.
// FLAGS: --check-alloc
// EXPECT: 7
// EXPECT: hi
// EXPECT: x 2
// EXPECT: 3

fn total(v: Vec<i64, Gpa>) -> i64
    requires v.len() > 0 else "total of nothing"
    ensures result >= old(v.len()) as i64
{
    let mut s: i64 = 0;
    for x in v.iter().copied() {
        s += x;
    }
    s
}

fn first(v: &Vec<String<Gpa>, Gpa>) -> String<Gpa>
    requires v.len() > 0
{
    v[0usize].clone().clone()
}

fn grow(v: &mut Vec<String<Gpa>, Gpa>, b: String<Gpa>) -> i64
    requires b.len() > 0
    ensures result == (old(v.len()) + 1) as i64
{
    v.push(b);
    v.len() as i64
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(4);
    println("{}", total(v));
    let mut b: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    b.push(String::from_in("hi", gpa));
    let f = first(&b);
    println("{f}");
    let o: Option<String<Gpa>> = Option::Some(String::from_in("x", gpa));
    let u = o.unwrap();
    let n = grow(&mut b, u);
    println("{} {n}", b[1usize].clone());
    println("{}", grow(&mut b, b[0usize].clone().clone()));
    0
}
