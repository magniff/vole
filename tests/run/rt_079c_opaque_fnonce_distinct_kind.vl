// From g302copy's report.
// rustc: E0277
// ERROR: line 30
// ERROR-COUNT: 1
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn eat(d: D) -> i64 {
    d.k
}

fn mk(k: i64) -> impl FnOnce() -> i64 {
    let d = D { k: k };
    move || eat(d)
}

fn twice<F: Fn() -> i64>(f: F) -> i64 {
    f() + f()
}

fn main() {
    let f = mk(1);
    println("{}", twice(f));
    let g = mk(2);
    println("{}", g());
    println("{}", g());
}
