// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.2
// (0.27.2.1) With `'a: 'b` declared, a hidden closure holding both `x` and
// `y` has the lifetime 'b, which both outlive (rustc accepts).
// EXPECT: 3
fn both<'a: 'b, 'b>(x: &'a i32, y: &'b i32) -> impl Fn() -> i32 {
    move || *x + *y
}

fn main() {
    let a: i32 = 1;
    let b: i32 = 2;
    let f = both(&a, &b);
    println("{}", f());
}
