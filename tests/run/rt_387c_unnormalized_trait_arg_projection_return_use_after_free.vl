// XFAIL: RT-387: UNSOUND: (RT-387's mechanism, a trait with an argument) `fn go<T: Tr<i64>>(t: T, k: &i64) -> <T as Tr<i64>>::Out` is read as borrowing k only: with `W<'a>`'s `Out = &'a str`, the result outlives the String it borrows, a use after free (rustc E0597) (0.30.2)
// From the review of g302bor2 (form B/b20). Since v0.30.1 at least; the
// release build the same. rustc E0597 (`st` does not live long enough) at
// the borrow (the rustc twin of this file). vole builds it and
// --check-alloc reports a use after free of st's buffer, freed at the end
// of the block. Siblings: rt_387, rt_387b, rt_387d, rt_387e.
// FLAGS: --check-alloc
// ERROR: line 43
trait Tr<U> {
    type Out;
    fn get(&self) -> Self::Out;
}

struct W<'a> {
    r: &'a str,
}

impl<'a> Tr<i32> for W<'a> {
    type Out = &'static str;

    fn get(&self) -> &'static str {
        "s"
    }
}

impl<'a> Tr<i64> for W<'a> {
    type Out = &'a str;

    fn get(&self) -> &'a str {
        self.r
    }
}

fn go<T: Tr<i64>>(t: T, k: &i64) -> <T as Tr<i64>>::Out {
    let _ = k;
    t.get()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let s = {
        let st = String::from_in("hello heap string long", gpa);
        go(W { r: st.as_str() }, &k)
    };
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", s, other.len());
}
