// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl BorrowMut<[T]>.
// EXPECT: [9, 2]
use std::borrow::BorrowMut;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2], gpa);
    let s: &mut [i64] = v.borrow_mut();
    s[0] = 9;
    println("{:?}", v);
}
