// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::vec Vec::impl BorrowMut<[T]>.
// EXPECT: [9, 2]
use std::borrow::BorrowMut;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1, 2], gpa);
    let s: &mut [i64] = v.borrow_mut();
    s[0] = 9;
    println("{:?}", v);
}
