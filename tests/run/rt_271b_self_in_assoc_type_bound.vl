// XFAIL: RT-271: `Self` in an associated type's bound, `type Out: Tr<Self>;`, is unknown type 'Self' (0.30.2)
// From the review of g302oblig M1 (pre-existing: v0.28.0 to v0.30.1 and the release branch before M1's merge).
// rustc builds it and prints 9. vole: "unknown type 'Self'" at the bound.
// EXPECT: 9
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H: Sized {
    type Out: Tr<Self>;
    fn get(&self) -> &Self::Out;
}

struct W {
    r: i64,
}

struct B {
    w: W,
}

impl Tr<B> for W {
    fn g(&self) -> i64 {
        9
    }
}

impl H for B {
    type Out = W;

    fn get(&self) -> &W {
        &self.w
    }
}

fn needg<V, Z: Tr<V>>(z: &Z) -> i64 {
    z.g()
}

fn mid<T: H>(t: &T) -> i64 {
    needg::<T, T::Out>(t.get())
}

fn main() {
    println("{}", mid(&B { w: W { r: 0 } }));
}
