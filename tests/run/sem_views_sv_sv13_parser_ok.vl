// XFAIL: gap 8: compile borrowck.mut_twice: cannot borrow 'p' as mutable more than once at a time (mutably borrowed at sem_...
// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: let x
// EXPECT: let x
use std::alloc::Allocator; #[derive(Clone, Copy)] struct Tok<'a> { text: &'a str, kind: i64 }
struct Parser<'a, A: Allocator> { toks: Vec<Tok<'a>, A>, pos: i64 }

impl<'a> Parser<'a, Gpa> {
    fn name(&mut self) -> &str {
        let t = self.toks[self.pos as usize];
        self.pos += 1;
        t.text
    }
}

fn main(gpa: Gpa) {
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "let", kind: 0 });
    p.toks.push(Tok { text: "x", kind: 1 });
    let a = p.name();
    let b = p.name();
    println("{a} {b}");
}
