// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: let x
// EXPECT: let x
struct Tok { text: [u8], kind: i64 }
struct Parser<A: Allocator> { toks: Vec<Tok, A>, pos: i64 }

impl Parser<Gpa> {
    fn name(inout self) -> [u8] {
        let t = self.toks[self.pos];
        self.pos += 1;
        t.text
    }
}

fn main(gpa: Gpa) {
    var p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "let", kind: 0 });
    p.toks.push(Tok { text: "x", kind: 1 });
    let a = p.name();
    let b = p.name();
    println("{a} {b}");
}
