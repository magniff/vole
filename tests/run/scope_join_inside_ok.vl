// XFAIL: gap 17: compile sync.not_send: the closure cannot be sent between threads (it is not Send): it captures 's', '&Scop...
// ok: scoped threads read what outlives the scope, and their results are joined inside
// EXPECT: 45
use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 { v.push(i); }
    let s = v.as_slice();
    let total = thread::scope(|s| ({ let sc = s; {
        let a = sc.spawn(|| { let mut t: i64 = 0; for i in 0..5 { t += s[i as usize]; } t });
        let b = sc.spawn(|| { let mut t: i64 = 0; for i in 5..10 { t += s[i as usize]; } t });
        a.join().unwrap() + b.join().unwrap()
    } }));
    println("{total}");
}
