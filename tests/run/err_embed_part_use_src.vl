// 0.26.2: a part has no module of its own, so its `.src` is no value
// (embed.part_use): the help names the blocks that include it, the fix
// the first.
// ERROR: error[embed.part_use]: 'BLUR' is a part (named in 'with' at
// ERROR: err_embed_part_use_src.vl: line 28, column 13
// ERROR: help: the modules that include it: K_BLUR_X.src, K_BLUR_Y.src
// ERROR: fix --suggested
embed wgsl COMMON {
    @group(0) @binding(0) var<storage, read_write> data: array<f32>;
}

embed wgsl BLUR with COMMON {
    @compute @workgroup_size(64)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        data[id.x] = f32(DIR.x);
    }
}

embed wgsl K_BLUR_X with BLUR {
    const DIR: vec2<i32> = vec2<i32>(1, 0);
}

embed wgsl K_BLUR_Y with BLUR {
    const DIR: vec2<i32> = vec2<i32>(0, 1);
}

fn main() -> i32 {
    let s = BLUR.src;
    println(s.len());
    0
}
