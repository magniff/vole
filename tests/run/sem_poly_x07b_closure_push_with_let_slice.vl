// ERROR: borrowck.borrow_immutable
fn run<F: FnMut()>(f: F, s: &[i64]) -> i64 { f(); s[0] }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(7);
    println("{}", run(|| { for i in 0..1000 { v.push(i); } }, v.as_slice()));
}
