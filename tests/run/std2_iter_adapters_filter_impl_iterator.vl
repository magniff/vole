// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::adapters Filter::impl Iterator.
// EXPECT: Some(2) Some(4) None

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3, 4], gpa);
    let mut it = s.iter().copied().filter(|x| x % 2 == 0);
    let a = it.next();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.next());
}
