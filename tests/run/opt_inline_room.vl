// EXPECT: charged 1861
// EXPECT: leaves 240
// EXPECT: looped 4950 100
// EXPECT: once 836
// (0.29) What a function takes in by inlining is bounded by its own room
// (middle/inline.vl, INLINE_ROOM: 40 more than its size), not by a budget
// of the whole program: the decision depends on the call, the callee and
// the caller alone.
// - charged: six calls of a callee that is no leaf (it calls `note`) and
//   not small: the first ones fit the room, the others stay calls;
// - leaves: ten calls of a small leaf (a checked accessor): none is
//   charged, all are inlined;
// - looped: a small callee that is no leaf, called in a loop: not
//   charged either;
// - once: a function's only call, of a callee that is not large, is
//   inlined after the room is used up (it is moved, not copied).
// CHECK: fn charged:
// CHECK: call mid
// CHECK: call mid
// CHECK: call mid
// CHECK: fn leaves:
// CHECK-NOT: call at
// CHECK: fn looped:
// CHECK-NOT: call push_twice
// CHECK: fn once:
// CHECK-NOT: call only_here
// CHECK: ret
use std::alloc::Allocator;

struct Tab<A: Allocator> { v: Vec<i64, A>, seen: i64 }

#[inline(never)]
fn note(t: &mut Tab<Gpa>, x: i64) {
    t.seen += x;
}

// Not a leaf, and about 25 instructions.
fn mid(t: &mut Tab<Gpa>, a: i64, b: i64) -> i64 {
    let mut x = a * 3 + b;
    if x > 100 {
        x = x - a / 2 + b * 7;
    }
    if x % 3 == 1 {
        x = x * x - b;
    }
    note(t, x);
    if x < 0 {
        x = -x + a;
    }
    x ^ (a << 2) ^ (b >> 1)
}

// A small leaf, not tiny: two checked accesses.
fn at(t: &Tab<Gpa>, i: usize) -> i64 {
    t.v[i] * 3 - t.v[i + 1]
}

// Small, and no leaf.
fn push_twice(t: &mut Tab<Gpa>, x: i64) {
    t.v.push(x);
    note(t, x);
}

fn only_here(t: &mut Tab<Gpa>, a: i64) -> i64 {
    let mut s = a;
    for i in 0..t.v.len() {
        if t.v[i] % 2 == 0 {
            s += t.v[i] * 3;
        } else {
            s -= t.v[i];
        }
        if s > 1000 {
            s = s / 2 + 7;
        }
    }
    s + t.seen % 5
}

#[inline(never)]
fn charged(t: &mut Tab<Gpa>, a: i64) -> i64 {
    mid(t, a, 1) + mid(t, a, 2) + mid(t, a, 3) + mid(t, a, 4) + mid(t, a, 5) + mid(t, a, 6)
}

#[inline(never)]
fn leaves(t: &Tab<Gpa>, k: usize) -> i64 {
    at(t, k) + at(t, k + 1) * 2 + at(t, k + 2) + at(t, k + 3) * 2 + at(t, k + 4) + at(t, k + 5) * 2
        + at(t, k + 6) + at(t, k + 7) * 2 + at(t, k + 8) * 2
}

#[inline(never)]
fn looped(t: &mut Tab<Gpa>, n: i64) -> i64 {
    let mut s = 0;
    for i in 0..n {
        push_twice(t, i);
        s += i;
    }
    s
}

#[inline(never)]
fn once(t: &mut Tab<Gpa>, a: i64) -> i64 {
    let x = mid(t, a, 1) + mid(t, a, 2) + mid(t, a, 3);
    x + only_here(t, a)
}

fn main(gpa: Gpa) -> i32 {
    let mut t = Tab { v: Vec::new_in(gpa), seen: 0 };
    for k in 0..10 {
        t.v.push(k * 2 + 1);
    }
    println("charged {}", charged(&mut t, 9));
    println("leaves {}", leaves(&t, t.v.len() - 10));
    let mut u = Tab { v: Vec::new_in(gpa), seen: 0 };
    println("looped {} {}", looped(&mut u, 100), u.v.len());
    // (a second call, so that the one in the loop is not its only one)
    push_twice(&mut u, 1);
    println("once {}", once(&mut t, 9));
    0
}
