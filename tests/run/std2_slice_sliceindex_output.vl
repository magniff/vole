// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice SliceIndex::Output.
// EXPECT: [3]
// RUSTC: none (SliceIndex's methods are unstable in Rust)
use std::slice::SliceIndex;

fn first<I: SliceIndex<[i64]>>(s: &[i64], i: I) -> Option<&<I as SliceIndex<[i64]>>::Output> {
    i.get(s)
}

fn main() {
    let s: &[i64] = &[1, 2, 3];
    println("{:?}", first(s, 2..).unwrap());
}
