// 0.26.2: the errors of format literals: format.syntax (a brace not
// doubled), format.spec (not Rust's spec; `{:#?}` not in this release),
// format.args (an argument no hole takes, a hole with no argument,
// arguments after a format that is not a literal), format.expr-hole (an
// expression in a hole). No error of the call's arity follows one.
// ERROR: error[format.syntax]: a hole of the format string is not closed: expected '}'
// ERROR: help: a '{' of the text is written '{{'
// ERROR: error[format.syntax]: unmatched '}' in a format string
// ERROR: help: a '}' of the text is written '}}'
// ERROR: error[format.spec]: invalid format spec ':q': unknown format trait 'q'
// ERROR: error[format.spec]: invalid format spec ':#?': '{:#?}', Debug written over several lines, is not in this release
// ERROR: error[format.args]: 2 positional arguments in the format string, but the call has 1
// ERROR: error[format.args]: this argument is never used: no hole of the format string takes it
// ERROR: error[type error]: undefined variable 'nope'
// ERROR: error[format.expr-hole]: '{p.a}': a hole of a format string holds a name, not an expression
// ERROR: help: write '{}' and pass the expression after the format string, as Rust does: 'println("{} {x}", a.b)'
// ERROR: error[format.expr-hole]: '{x + 1}': a hole of a format string holds a name, not an expression
// ERROR: error[format.args]: a format string is a literal: this argument has no hole to go to
// ERROR: error[format.args]: this named argument is never used: no hole of the format string names it
// ERROR: error[format.args]: 3 positional arguments in the format string, but the call has 2
// ERROR-COUNT: 12
struct P { a: i64 }

fn main() {
    let x = 1;
    let p = P { a: 2 };
    let s = "lit";
    println("{");
    println("a } b");
    println("{:q}", x);
    println("{:#?}", x);
    println("{} {}", x);
    println("{}", x, x);
    println("{nope}");
    println("{p.a}");
    println("{x + 1}");
    println(s, x);
    println("{x}", b = 1);
    eprintln("{0} {2}", x, x);
}
