// XFAIL: gap 14: output: line 1: expected '24 40 24 0', got '24 48 24 0' [rustc: outside the twin: rustc rejects: error: com...
// 0.16: std's containers on an allocator, Gpa (C's malloc) by default; a
// program's Gpa is the one its main takes, passed down. A Vec on Gpa is
// three words; growth and frees go through the allocator.
// EXPECT: 24 40 24 0
// EXPECT: 4950 99 hello 42
// EXPECT: [1, 2, 3] 3
use std::alloc::Layout; use std::ptr::NonNull; fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for x in v.iter().copied() {
        t += x;
    }
    t
}

fn fill(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..100 {
        v.push(i);
    }
    v
}

fn main(gpa: Gpa) {
    println(
        "{} {} {} {}", size_of(Vec<i64, Gpa>),
        size_of(std::collections::HashMap<i64, i64, Gpa, FixedState>),
        size_of(std::string::String<Gpa>), size_of(Gpa));
    let mut v = fill(gpa);
    let mut m: std::collections::HashMap<i64, i64, Gpa,
        FixedState> = std::collections::HashMap::new_in(gpa);
    for i in 0..100 {
        m.insert(i, i * i);
    }
    let mut b: std::string::String<Gpa> = std::string::String::new_in(gpa);
    b.push_str("hello ");
    std::fmt::write(&mut b, 42i64).unwrap();
    let mut w: Vec<i64, Gpa> = Vec::with_capacity_in(2usize, gpa);
    w.extend_from_slice(&[1i64, 2, 3][0..3]);
    let mut c = w.clone();
    println("{} {} {}", total(&v), m.len() - 1, str::from_utf8(b.as_bytes()).unwrap());
    println("{c:?} {}", c.len());
    let p = gpa
        .allocate(Layout::from_size_align(64 as usize, 64 as usize).unwrap())
        .unwrap()
        .as_ptr();
    unsafe {
        (*p.add(63)) = 7;
        gpa.deallocate(NonNull::new(p).unwrap(),
            Layout::from_size_align(64 as usize, 64 as usize).unwrap());
    }
    drop(v);
    drop(m);
    drop(b);
    drop(w);
    drop(c);
}
