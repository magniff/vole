use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }
enum E<A: Allocator> { A(D<A>), B(i64), C(Vec<i64, A>, D<A>) }
struct H<A: Allocator> { d: D<A>, arr: [D<A>; 2], n: i64 }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let h = H { d: mk(1, gpa), arr: [mk(2, gpa), mk(3, gpa)], n: 0 };
    let e = E::C(Vec::new_in(gpa), mk(4, gpa));
    let d = mk(5, gpa);
    let f = move || println("in {}", d.id);
    f();
    println("end {}", h.n);
    let _ = e;
}
