// places IR (0.26.1, R2): the drop shims a body's drops call, printed by
// --emit-shims: a Drop impl's call then its fields' drops, a struct's
// fields, an array's counted loop, an enum's switch on its discriminant,
// a sink closure's capture under its live flag.
// FLAGS: --emit-shims --verify-places
// EXPECT: in 5
// EXPECT: end 0
// EXPECT: drop 5
// EXPECT: drop 4
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// PLACES: fn main
// PLACES: fn drop_in_place::<closure
// PLACES: switch copy (*_1).1 [0: bb3, otherwise: bb2]
// PLACES: drop((*_1).0) [kept]
// PLACES: fn drop_in_place::<E>
// PLACES: _3 = discriminant (*_1)
// PLACES: switch copy _3 [0: bb3, 2: bb4, otherwise: bb2]
// PLACES: drop(((*_1) as A).0) [kept]
// PLACES: drop(((*_1) as C).0) [kept]
// PLACES: drop(((*_1) as C).1) [kept]
// PLACES: fn drop_in_place::<H>
// PLACES: drop((*_1).0) [kept]
// PLACES: drop((*_1).1) [kept]
// PLACES-NOT: drop((*_1).2)
// PLACES: fn drop_in_place::<D>
// PLACES: _3 = &mut (*_1)
// PLACES: _2 = call D::drop(move _3)
// PLACES: drop((*_1).1) [kept]
// PLACES: fn drop_in_place::<Vec<i64>>
// PLACES: _2 = call Vec<i64>::drop(move _3)
// PLACES-NOT: drop(
// PLACES: fn drop_in_place::<[D; 2]>
// PLACES: _4 = copy _3 < const 2
// PLACES: drop((*_1)[_3]) [kept]
// PLACES: goto bb2 (back edge)
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
enum E { A(D), B(i64), C(Vec<i64>, D) }
struct H { d: D, arr: [D; 2], n: i64 }

fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let h = H { d: mk(1, gpa), arr: [mk(2, gpa), mk(3, gpa)], n: 0 };
    let e = E::C(Vec::new_in(gpa), mk(4, gpa));
    let d = mk(5, gpa);
    let f = sink || println(f"in {d.id}");
    f();
    println(f"end {h.n}");
    let _ = e;
}
