// RULE: C3.4
// (0.30.2, review of RT-38g) A clause sorting, swapping, reversing its own local array. A callee's raw write is refused only
// when a raw pointer may reach it from what the clause reads (a
// parameter's or the result's type holds one, contracts::raw_inputs).
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
fn f(n: i64) -> i64
    requires {
    let mut a = [n, 1, 2];
    a.sort_unstable();
    a[0] <= a[1]
}
requires {
    let mut a = [n, 1];
    a.swap(0, 1);
    a[0] == 1
}
requires {
    let mut a = [n, 1];
    a.reverse();
    a[1] == n
}
{
    n
}
fn main() {
    println("{}", f(3));
}
