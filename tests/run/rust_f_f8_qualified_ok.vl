// EDITION: rust
// RULE: F8.2
// `Tr::m(x, args)`: a trait's method called with its receiver explicit,
// through a blanket impl too.
// EXPECT: 7
// EXPECT: 7
trait Show {
    fn show(&self) -> i64;
}

trait Describe {
    fn describe(&self) -> i64;
}

struct S {
    n: i64,
}

impl Show for S {
    fn show(&self) -> i64 {
        self.n
    }
}

impl<T: Show> Describe for T {
    fn describe(&self) -> i64 {
        self.show()
    }
}

fn main() -> i64 {
    let s = S { n: 7 };
    std::print_int(Show::show(&s));
    println("");
    std::print_int(Describe::describe(&s));
    println("");
    0
}
