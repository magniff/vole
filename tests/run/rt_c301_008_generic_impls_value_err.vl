// RULE: F8.4
// `S::c` as a value, S having two impls of Conv: which is not said
// (rustc E0283). The qualified `<S as Conv<i32>>::c` is fine.
// ERROR: error[type.infer]: 'S' has more than one impl of 'Conv' that gives 'c': which one is not said
trait Conv<X> { fn c(&self) -> i64; }
struct S;
impl Conv<i32> for S { fn c(&self) -> i64 { 32 } }
impl Conv<i64> for S { fn c(&self) -> i64 { 64 } }
fn main() { let s = S; let f = <S as Conv<i32>>::c; let g = S::c; println("{} {}", f(&s), g(&s)); }
