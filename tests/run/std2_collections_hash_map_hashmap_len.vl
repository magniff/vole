// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::len.
// EXPECT: 0 3 2
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let a = m.len();
    m.insert(1, 1);
    m.insert(2, 2);
    m.insert(3, 3);
    let b = m.len();
    m.remove(&2);
    println("{} {} {}", a, b, m.len());
}
