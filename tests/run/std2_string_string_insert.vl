// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::insert.
// EXPECT: xab
// EXIT: 101
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let mut s = String::from_in("ab", gpa);
    s.insert(0, 'x');
    println("{}", s);
    let mut t = String::from_in("\u{e9}", gpa);
    t.insert(1, 'x');
}
