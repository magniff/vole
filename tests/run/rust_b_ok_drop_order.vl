// RULE: D8.2
// (0.27.2) A user `impl Drop` runs on std: locals at their scope's end in
// the reverse of their declaration, a temporary at its statement's end,
// a shadowed binding at its scope's end, not at the shadowing.
struct D {
    id: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn make(id: i64) -> D {
    D { id: id }
}

fn main() {
    {
        let _a = D { id: 1 };
        let _b = D { id: 2 };
        let _c = make(3);
        println("inner end");
    }
    let _ = make(4);
    println("after the temporary");
    let x = D { id: 5 };
    let x = D { id: x.id + 1 };
    println("shadowed {}", x.id);
}
// EXPECT: inner end
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: drop 4
// EXPECT: after the temporary
// EXPECT: shadowed 6
// EXPECT: drop 6
// EXPECT: drop 5
