struct H<'a> {
    r: &'a mut i64,
}

fn takep(p: *mut i64) -> i64 {
    let _ = p;
    1
}

fn lbrk(h: &H) -> *mut i64 {
    let p: *mut i64 = loop {
        break h.r;
    };
    p
}

fn brk(h: &H) -> i64 {
    let mut n = 0i64;
    let mut f = || {
        let p: *mut i64 = loop {
            break h.r;
        };
        n += takep(p);
    };
    f();
    let mut g = || {
        let p: *mut i64 = match 1 {
            _ => h.r,
        };
        n += takep(p);
    };
    g();
    n
}

fn arr_asg(h: &H, a: &mut [*mut i64; 2]) {
    a[0] = h.r;
}

fn main() {
    let mut a = 1i64;
    let h = H { r: &mut a };
    let _ = (lbrk(&h), brk(&h));
    let mut ar = [std::ptr::null_mut(); 2];
    arr_asg(&h, &mut ar);
    println("end");
}
