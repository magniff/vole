// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Peekable::peek.
// EXPECT: Some(1) Some(1) None
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64], gpa);
    let mut it = s.iter().copied().peekable();
    let a = it.peek().copied();
    let b = it.next();
    println("{:?} {:?} {:?}", a, b, it.peek());
}
