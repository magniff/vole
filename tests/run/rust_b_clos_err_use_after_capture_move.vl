// EDITION: rust
// RULE: D19.2
// (0.27.2) The moved capture is moved into the closure where it is made: a
// use of the variable after that is a use of a moved value (rustc E0382).
// ERROR: error[borrowck.use_moved]
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn main() {
    let s = S { n: 4 };
    let f = || eat(s);
    println("{} {}", s.n, f());
}
