// XFAIL: gap 25: the IR, asm or places CHECK lines no longer match the translation (std2's names, the surface): to update by...
// 0.15 (AArch64): loads and stores of one base at offsets one access
// apart are scheduled side by side (isel's pair_accesses) and emitted as
// one ldp or stp (mc_arm64's pair_with_last): 64-bit integers, f64, and
// vectors (q registers). A load whose result is the base of the next
// (a list followed through its links) is no pair.
// EXPECT: 84 84
// EXPECT: 2.5 9.5
// EXPECT: 120 63
// EXPECT: 6 1 49
// ASM(aarch64-macos): _vole.dot:
// ASM(aarch64-macos): ldp x
// ASM(aarch64-macos): _vole.sum_f64:
// ASM(aarch64-macos): ldp d
// ASM(aarch64-macos): _vole.vsum:
// ASM(aarch64-macos): ldp q
// ASM(aarch64-macos): _vole.store_pair:
// ASM(aarch64-macos): stp x
extern "C" {
    fn printf(f: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy)] struct Pair { a: i64, b: i64 }

#[derive(Clone, Copy)] struct Node { next: *mut Node, value: i64 }

#[inline(never)]
fn dot(a: &[i64], b: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for k in 0..a.len() {
        t += a[k] * b[k];
    }
    t
}

#[inline(never)]
fn sum_f64(p: *mut Pair, q: *mut [f64; 2]) -> f64 {
    unsafe { (*q)[0] + (*q)[1] + ((*p).a + (*p).b) as f64 }
}

#[inline(never)]
fn vsum(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for &x in s {
        t += x;
    }
    t
}

#[inline(never)]
fn store_pair(p: &mut Pair, x: i64, y: i64) {
    unsafe {
        p.a = x;
        p.b = y;
    }
}

#[inline(never)]
fn walk(n: *mut Node) -> i64 {
    let mut p = n;
    let mut t: i64 = 0;
    while p != 0 as *mut Node {
        unsafe {
            t = t * 10 + (*p).value;
            p = (*p).next;
        }
    }
    t
}

fn main() -> i32 {
    let a: [i64; 7] = [1i64, 2, 3, 4, 5, 6, 7];
    let b: [i64; 7] = [7i64, 6, 5, 4, 3, 2, 1];
    let mut h: i64 = 0;
    for k in 0..7 {
        h += a[k as usize] * b[k as usize];
    }
    unsafe { printf(c"%ld %ld\n", dot(&a[..], &b[..]), h); }
    let mut p = Pair { a: 3, b: 6 };
    let mut q: [f64; 2] = [0.25, 0.25];
    unsafe { printf(c"%g %g\n", sum_f64(&mut p, &mut q) - 7.0, sum_f64(&mut p, &mut q)); }
    let mut v: [i64; 15] = [0i64; 15];
    for k in 0..15 {
        v[k as usize] = k + 1;
    }
    unsafe { printf(c"%ld %ld\n", vsum(&v[..]), vsum(&v[2..11])); }
    let mut s = Pair { a: 0, b: 0 };
    store_pair(&mut s, 6, 1);
    let mut n3 = Node { next: 0 as *mut Node, value: 9 };
    let mut n2 = Node { next: &mut n3, value: 4 };
    unsafe { printf(c"%ld %ld %ld\n", s.a, s.b, walk(&mut n2)); }
    0
}
