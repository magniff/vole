// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl Sub for primitives.
// EXPECT: 7 7
use std::ops::Sub;

fn apply<T: Sub<Output = T>>(a: T, b: T) -> T {
    a.sub(b)
}

fn main() {
    println("{} {}", apply(12i64, 5), apply(12u8, 5));
}
