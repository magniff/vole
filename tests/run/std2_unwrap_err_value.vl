// EDITION: rust
// (0.28.0, gap 79) unwrap_err on an Ok shows the value; expect's message
// may have holes of its own (it is a &str by then).
// EXPECT: 2
// EXIT: 101
// STDERR: std2_unwrap_err_value.vl:11:13: called `Result::unwrap_err()` on an `Ok` value: [1, 2]
fn main() {
    let a: Result<i64, i64> = Err(2);
    println("{}", a.unwrap_err());
    let b: Result<[i64; 2], i64> = Ok([1, 2]);
    let x = b.unwrap_err();
}
