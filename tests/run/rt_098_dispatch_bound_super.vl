// XFAIL: RT-98: a method through a supertrait bound with trait arguments is refused as ambiguous (impls of Tr<i32> and Tr<i64>) (0.30.2)
// From the review of the obligation engine's M1 (pre-existing: v0.30.1 too).
// EXPECT: 64
trait Tr<U> { fn f(&self) -> i64; }
struct W { r: i64 }
impl Tr<i32> for W { fn f(&self) -> i64 { 32 } }
impl Tr<i64> for W { fn f(&self) -> i64 { 64 } }
trait Sub: Tr<i64> {}
impl Sub for W {}
fn go<T: Sub>(t: &T) -> i64 { t.f() }
fn main() { let x = W { r: 1 }; println("{}", go(&x)); }
