// RULE: D2.7
// (0.30.1, RT-33) `s.sort_in(gpa)` of an `s: &[i64]`: rustc's E0596 (its
// `sort`).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 8, column 5
// ERROR-COUNT: 1
fn k(s: &[i64], gpa: Gpa) {
    s.sort_in(gpa);
}

fn main(gpa: Gpa) {
    let a = [2i64, 1];
    k(&a[..], gpa);
    println("{} {}", a[0], a[1]);
}
