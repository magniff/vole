// (0.30.1, review 2) A trait's 'static is asked of its impls: a 'static
// supertrait of Self (rustc E0478), a `type Out: 'static` of the
// associated type's value (rustc E0477). Before, a generic function took
// `T: St` as `T: 'static` and no impl was made to meet it: a borrowed str
// reached a thread and was read after it was freed.
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR-COUNT: 2
use std::thread;
use std::thread::JoinHandle;

trait St: 'static + Send + std::fmt::Display {}

impl<'a> St for &'a str {}

trait Tr {
    type Out: 'static + Send + std::fmt::Display;
    fn out(&self) -> Self::Out;
}

struct W<'a> {
    s: &'a str,
}

impl<'a> Tr for W<'a> {
    type Out = &'a str;

    fn out(&self) -> &'a str {
        self.s
    }
}

fn f<T: St>(t: T, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    thread::spawn_in(move || {
        println("thread {}", t);
        0i64
    }, gpa)
}

fn g<T: Tr>(t: T, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    let o = t.out();
    thread::spawn_in(move || {
        println("thread {}", o);
        0i64
    }, gpa)
}

fn main(gpa: Gpa) {
    let h = {
        let st = String::from_in("hello heap string long", gpa);
        f(st.as_str(), gpa)
    };
    h.join();
    let k = {
        let st = String::from_in("hello heap string long", gpa);
        g(W { s: st.as_str() }, gpa)
    };
    k.join();
}
