use std::thread;

fn go(v: &Vec<i64, Gpa>) -> i64 {
    let h = thread::spawn(move || v.len());
    h.join().unwrap() as i64
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", go(&v));
}
