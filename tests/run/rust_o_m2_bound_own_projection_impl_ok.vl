// EXPECT: 65
// (RT-272) an impl's `T: H2 + Tr<T::Out>`: v0.30.1 crashed (bus error).
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H2 {
    type Out;
}

struct W {
    r: i64,
}

impl H2 for W {
    type Out = i64;
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

trait Q {
    fn q(&self) -> i64;
}

struct Y<T> {
    t: T,
}

impl<T: H2 + Tr<T::Out>> Q for Y<T> {
    fn q(&self) -> i64 {
        self.t.g() + 1
    }
}

fn main() {
    println("{}", Y { t: W { r: 0 } }.q());
}
