// RULE: M2, M8
// (0.30.1) What an assignment through a union's field initializes, as
// rustc's gather_init: a direct field of a union initializes the union
// (`o.i = ..` after a move of o, in a loop too); a field of a union that
// is a struct's field initializes that union, a path of its own (`s.u.a =
// 5` after `s.u` moved); through a nested union, `o.i.a = 7`, of an o
// initialized, nothing needs initializing (rust_b_err_union_nested: of an
// o not initialized, it is refused).
// EXPECT: 7
// EXPECT: 5 2
// EXPECT: 1
// EXPECT: 0 0
// EXPECT: 3
union I {
    a: i64,
    b: i64,
}

impl Clone for I {
    fn clone(&self) -> I {
        *self
    }
}

impl Copy for I {}

union O {
    i: I,
    c: [i64; 4],
}

union J {
    a: i64,
    b: i64,
}

struct S {
    u: J,
    k: i64,
}

fn main() {
    let mut o = O { c: [1, 2, 3, 4] };
    o.i.a = 7;
    let w = o;
    // UNSAFE: reads the union's field just written
    // SAFETY: i.a was assigned last, an i64 every bit pattern of which is valid
    println("{}", unsafe { w.i.a });

    let mut s = S { u: J { b: 1 }, k: 2 };
    let t = s.u;
    s.u.a = 5;
    let r = s.u;
    // UNSAFE: reads the union's field just written
    // SAFETY: a was assigned last, an i64
    println("{} {}", unsafe { r.a }, s.k);
    // UNSAFE: reads the union's field it was made with
    // SAFETY: b was assigned, an i64
    println("{}", unsafe { t.b });

    let mut p = O { c: [0, 0, 0, 0] };
    let mut n = 0;
    while n < 2 {
        let v = p;
        p.i = I { a: n };
        // UNSAFE: reads the union's field written last
        // SAFETY: the array's first word or i.a, an i64 either way
        print("{}{}", unsafe { v.c[0] }, if n == 0 { " " } else { "\n" });
        n += 1;
    }

    let mut q = S { u: J { a: 0 }, k: 0 };
    let mut m = 0;
    while m < 3 {
        let x = q.u;
        q.u.b = m + 1;
        // UNSAFE: reads the union's field written last
        // SAFETY: a or b, an i64 either way
        q.k = unsafe { x.a } + 1;
        m += 1;
    }
    // UNSAFE: reads the union's field written last
    // SAFETY: b, an i64
    println("{}", unsafe { q.u.b });
}
