// Runs on std since its gap closed (0.27.3).
// The std item(s): std::io Read::read_to_end.
// EXPECT: 3 [9, 1, 2, 3]
use std::io::{BufRead, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut v = Vec::from_in([9u8], gpa);
    let n = r.read_to_end(&mut v).unwrap();
    println("{} {:?}", n, v);
}
