// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice Split.
// EXPECT: 3
use std::slice::Split;

fn n<P: FnMut(&i64) -> bool>(s: Split<'_, i64, P>) -> usize {
    s.count()
}

fn main() {
    let s: &[i64] = &[1, 0, 2, 0, 3];
    println("{}", n(s.split(|x| *x == 0)));
}
