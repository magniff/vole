// EDITION: rust
// (0.28.0) std::collections and std::unicode are read only by a program
// that names them (the lazy std's gates), and a hello-world keeps none of
// std's float text. What was moved for that keeps its meaning:
// char::is_whitespace has Unicode's White_Space itself (25 code points);
// an integer's `{:e}` makes its digits without the floats' big numbers
// (rounded half to even, trailing zeros left out); std::str::lossy_next
// and ascii_printable_prefix_len call std::unicode's; TryReserveError is
// defined in std::alloc and named from std::collections too.
// EXPECT: 25 true true true false false
// EXPECT: 1.234e3 1e3 0e0 1.24e3 1.22e3 1.0e4 1.8446744073709551615e19 -1.5E1 +7e0 2e3 1.000e3
// EXPECT: 233 2 3
// EXPECT: true

fn main() {
    let mut n = 0;
    let mut c: u32 = 0;
    while c < 0x110000 {
        match char::from_u32(c) {
            Some(ch) => {
                if ch.is_whitespace() {
                    n += 1;
                }
            }
            None => {}
        }
        c += 1;
    }
    println("{} {} {} {} {} {}", n, '\u{85}'.is_whitespace(), '\u{200A}'.is_whitespace(),
        '\u{3000}'.is_whitespace(), '\u{200B}'.is_whitespace(), '\u{180E}'.is_whitespace());
    println("{:e} {:e} {:e} {:.2e} {:.2e} {:.1e} {:e} {:E} {:+e} {:.0e} {:.3e}", 1234, 1000, 0,
        1235, 1225, 9999, 18446744073709551615u64, -15, 7, 1500, 1000);
    let v: [u8; 4] = [0xC3, 0xA9, 0x41, 0x07];
    let mut pos: usize = 0;
    let cp = std::str::lossy_next(&v, &mut pos);
    println("{} {} {}", cp, pos, std::str::ascii_printable_prefix_len(b"abc\n"));
    let a: std::alloc::TryReserveError = std::alloc::TryReserveError::CapacityOverflow;
    let b: std::collections::TryReserveError = std::collections::TryReserveError::CapacityOverflow;
    println("{}", a == b);
}
