// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'mk', which writes through a raw pointer what it did not make
// a non-generic wrapper over from_raw_parts_mut
fn mk<'a>(p: *mut i64) -> &'a mut [i64] { unsafe { std::slice::from_raw_parts_mut(p, 1) } }

fn f(p: *mut i64) -> i64
    requires { let s = mk(p); s[0] = 9; true }

{ 1 }
fn main() { let mut x = 1i64; println("{}", f(&raw mut x)); println("{}", x); }
