// XFAIL: RT-423: an enum discriminant that calls a const fn, directly (`A = f(5) as isize`, `A = g()`) or through a constant (`A = K as isize` with `const K: i64 = f(3);`), is refused with "function 'f' expects 0 arguments, got 1" (its help shows the one-parameter signature) and "an enum discriminant must be an integer, got '()'"; the constant K itself then fails too; rustc accepts (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). vole reports 4 errors, at
// K's value, at F::A's and at G::A's. v0.28.0 to v0.30.1 the same.
// Without the enums `const K: i64 = f(3);` checks and runs right. The
// cause (inferred from the code): collect.vl eval_discriminant runs
// synth_expr on the discriminant during collection, before the fns'
// signatures are entered, so f has no parameters and g's result is ().
// EXPECT: 6 7 11 5
const fn f(x: i64) -> i64 {
    x * 2
}

const fn g() -> isize {
    4
}

const K: i64 = f(3);

enum E {
    A = K as isize,
    B,
}

enum F {
    A = f(5) as isize,
    B,
}

enum G {
    A = g(),
    B,
}

fn main() {
    println("{} {} {} {}", K, E::B as i64, F::B as i64, G::B as i64);
}
