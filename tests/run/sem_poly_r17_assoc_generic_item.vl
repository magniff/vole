// EDITION: rust
// a generic over I: Iterator collecting I::Item; Item owned and plain
// FLAGS: --check-alloc
// EXPECT: 2
// EXPECT: drop 2
// EXPECT: 0
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
#[derive(Clone, Copy)] struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(&mut self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn firstof<I: Iterator>(mut it: I) -> Option<I::Item> { it.next() }

fn main() {
    let a = firstof(Gen { n: 3 });
    println("{}", a.unwrap().id);
    println("{}", firstof(0i64..4i64).unwrap());
    println("end");
}
