// EXPECT: 4 8
// (RT-426) `Self::Output` written in a trait two supertraits above Index
// (`trait Top: Get`, `trait Get: Index<usize>`), the type also with a
// Mul impl's Output: Index's (v0.30.1: ambiguous). (`M { .. } * 2i64` and
// `m * 2` are refused, typed from the other operand: separate bugs,
// reported.)
use std::ops::{Index, Mul};

struct M {
    a: [i64; 4],
}

impl Index<usize> for M {
    type Output = i64;

    fn index(&self, i: usize) -> &i64 {
        &self.a[i]
    }
}

impl Mul<i64> for M {
    type Output = M;

    fn mul(self, r: i64) -> M {
        M { a: [self.a[0] * r, self.a[1] * r, self.a[2] * r, self.a[3] * r] }
    }
}

trait Get: Index<usize> {}

trait Top: Get {
    fn last(&self) -> &Self::Output;
}

impl Get for M {}

impl Top for M {
    fn last(&self) -> &i64 {
        &self.a[3]
    }
}

fn main() {
    let m = M { a: [1, 2, 3, 4] };
    let m2 = M { a: [1, 2, 3, 4] };
    let d = m2 * 2i64;
    println("{} {}", m.last(), d.last());
}
