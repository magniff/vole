// EXPECT: 2 3
// 0.9: writing a union's field is safe, and taking its address with
// `&raw mut` (0.30: a reference to one, `&mut u.a`, is unsafe, as rustc's
// E0133: err_unsafe_union_borrow).
extern "C" {
    fn printf(f: *const u8, ...) -> i32;
}

#[repr(C)]
union U { a: i64, b: f64 }
// (0.29: a Copy struct's every field is Copy, a union's by its impls)
impl Clone for U { fn clone(&self) -> U { *self } }
impl Copy for U {}

#[derive(Clone, Copy)] #[repr(C)]
struct Holder { u: U, n: i64 }

fn main() -> i32 {
    let mut u = U { a: 1 };
    u.a = 2;
    let mut h = Holder { u: U { a: 0 }, n: 0 };
    h.u.a = 3;
    let pa = &raw mut u.a;
    unsafe {
        printf(c"%ld %ld\n", *pa, h.u.a);
    }
    0
}
