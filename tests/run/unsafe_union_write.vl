// EDITION: rust
// EXPECT: 2 3
// 0.9: writing a union's field, and taking its address, are safe; only
// reading one is unsafe.
extern "C" {
    fn printf(f: *mut u8, ...) -> i32;
}

#[repr(C)]
union U { a: i64, b: f64 }

#[derive(Clone, Copy)] #[repr(C)]
struct Holder { u: U, n: i64 }

fn main() -> i32 {
    let mut u = U { a: 1 };
    u.a = 2;
    let mut h = Holder { u: U { a: 0 }, n: 0 };
    h.u.a = 3;
    let pa = &mut u.a as *mut i64;
    unsafe {
        printf(c"%ld %ld\n", *pa, h.u.a);
    }
    0
}
