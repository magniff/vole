// XFAIL: RT-226: the Euclidean division methods are missing at every integer width: rem_euclid, div_euclid and their checked_, wrapping_ and overflowing_ forms (0.30.2)
// rustc 1.98 prints the EXPECT lines (twin: r302e_003_int_euclid.rs.txt); guide rust does not list them as missing.
// EXPECT: i8 2 -3 Some(2) None 2 -3 (2, false)
// EXPECT: i16 2 -3 Some(2) None 2 -3 (2, false)
// EXPECT: i32 2 -3 Some(2) None 2 -3 (2, false)
// EXPECT: i64 2 -3 Some(2) None 2 -3 (2, false)
// EXPECT: isize 2 -3 Some(2) None 2 -3 (2, false)
// EXPECT: u8 1 2 Some(1) None 1 2 (1, false)
// EXPECT: u16 1 2 Some(1) None 1 2 (1, false)
// EXPECT: u32 1 2 Some(1) None 1 2 (1, false)
// EXPECT: u64 1 2 Some(1) None 1 2 (1, false)
// EXPECT: usize 1 2 Some(1) None 1 2 (1, false)
fn main() {
    let a: i8 = -7;
    let b: i8 = 3;
    println("i8 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.rem_euclid(b), a.div_euclid(b),
        a.checked_rem_euclid(b), a.checked_div_euclid(0), a.wrapping_rem_euclid(b),
        a.wrapping_div_euclid(b), a.overflowing_rem_euclid(b));
