        a.wrapping_div_euclid(b), a.overflowing_rem_euclid(b));
    let a: u32 = 7;
    let b: u32 = 3;
    println("u32 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.rem_euclid(b), a.div_euclid(b),
        a.checked_rem_euclid(b), a.checked_div_euclid(0), a.wrapping_rem_euclid(b),
