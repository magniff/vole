    let a: isize = -7;
    let b: isize = 3;
    println("isize {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.rem_euclid(b), a.div_euclid(b),
        a.checked_rem_euclid(b), a.checked_div_euclid(0), a.wrapping_rem_euclid(b),
        a.wrapping_div_euclid(b), a.overflowing_rem_euclid(b));
    let a: u8 = 7;
    let b: u8 = 3;
    println("u8 {:?} {:?} {:?} {:?} {:?} {:?} {:?}", a.rem_euclid(b), a.div_euclid(b),
