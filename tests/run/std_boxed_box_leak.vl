// Runs on std since 0.27.2's switch.
// The std item(s): std::boxed Box::leak.
// EXPECT: 6
use std::boxed::Box;

fn main(gpa: Gpa) {
    let r: &mut i64 = Box::leak(Box::new_in(5i64, gpa));
    *r += 1;
    println("{}", r);
}
// (the leak is the item's: Box::leak gives the block up for good)
// STDERR: check-alloc: 1 block of Gpa not freed (8 bytes):
