// a sink closure capturing a let self of an owned type
// ERROR: [own.move_out]
struct S { v: Vec<i64> }

impl S {
    fn n(self) -> i64 { let c = sink || self.v.len(); c() as i64 }
}

fn main(gpa: Gpa) {
    var s = S { v: Vec::new_in(gpa) };
    s.v.push(1);
    println("{} {}", s.n(), s.v.len());
}
