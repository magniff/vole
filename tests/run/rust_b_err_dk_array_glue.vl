struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut a = [HD { r: &z }];
    let x: i64 = 1;
    a = [HD { r: &x }];
    println("{}", *a[0].r);
}
