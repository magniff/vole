use std::collections::HashMap;
use std::hash::FixedState;
fn fill<'a>(s: &mut [&'a str], x: &'a str) { for i in 0..s.len() { s[i] = x; } }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut m: HashMap<i64, &str, Gpa, FixedState> = HashMap::new_in(gpa); m.entry(1).or_insert(w);
    let r = m.get(&1).copied().unwrap();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
