// (0.25) Loads under a condition that never holds, in loops, at an index
// far out of bounds: an array's element, a static array's, an array field
// through a reference, a slice's, a Vec's, a field through a raw pointer
// behind a null test. No optimization level may run one where the program
// does not (LICM, scalar promotion): -O2 prints what -O0 does.
// FLAGS: -O2
// EXPECT: 5 5 5 5 5 5 5
// EXPECT: 15 15
// EXPECT: 4 5
static mut Z: i64 = 0;
static mut TABLE: [i64; 4] = [1i64, 2, 3, 4];

#[derive(Clone, Copy)] struct Grid { cells: [i64; 3], n: i64 }
#[derive(Clone, Copy)] struct Node { v: i64, next: i64 }

fn arr_local(i: i64) -> i64 {
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k < 5 + unsafe { Z } { if k > 100 { t += a[i as usize]; } t += 1; k += 1; }
    t
}

fn arr_static(i: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..5 + unsafe { Z } { if k == 1000 { t += unsafe { TABLE[i as usize] }; } t += 1; }
    t
}

fn field_ref(g: Grid, i: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..5 + unsafe { Z } { if k < 0 { t += g.cells[i as usize]; } t += 1; }
    t
}

fn slice_elem(s: &[i64], i: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..5 + unsafe { Z } { if k > 50 { t += s[i as usize]; } t += 1; }
    t
}

fn vec_elem(v: &Vec<i64, Gpa>, i: i64) -> i64 {
    let mut t: i64 = 0;
    for k in 0..5 + unsafe { Z } { if k > 50 { t += v[i as usize]; } t += 1; }
    t
}

fn raw_field(p: *mut Node) -> i64 {
    let mut t: i64 = 0;
    for k in 0..5 + unsafe { Z } {
        if unsafe { Z } > 0 && p != 0 as *mut Node { t += unsafe { (*p).v }; }
        t += 1;
    }
    t
}

fn after_continue(i: i64) -> i64 {
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    while k
        < 5 + unsafe { Z } {
        t += 1; k += 1; if unsafe { Z } == 0 { continue; } t += a[i as usize];
    }
    t
}

// Nested: the inner loop's guarded load, hoisted to either preheader.
fn nested(i: i64) -> i64 {
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    for j in 0..3 + unsafe { Z } {
        for k in 0..5 + unsafe { Z } { if j + k > 100 { t += a[i as usize]; } t += 1; }
    }
    t
}

// A guarded read and write of one element: scalar promotion's case.
fn promoted(i: i64) -> i64 {
    let mut a = [1i64, 2, 3];
    let mut t: i64 = 0;
    for k in 0..15 + unsafe { Z } { if k > 100 { a[i as usize] += k; } t += 1; }
    t
}

// In bounds, the hoisted and promoted forms must still compute the same.
fn in_bounds(i: i64) -> i64 {
    let mut a = [1i64, 2, 3];
    let mut t: i64 = 0;
    for k in 0..3 + unsafe { Z } { t += a[i as usize]; a[i as usize] = 1; }
    t + a[i as usize] - 1
}

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let far = -1099511627776 + unsafe { Z };
    let g = Grid { cells: [7i64, 8, 9], n: 3 };
    let s = [1i64, 2, 3];
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println(
        "{} {} {} {} {} {} {}", arr_local(far), arr_static(far), field_ref(g, far),
        slice_elem(&s[0..3], far), vec_elem(&v, far), raw_field(0 as *mut Node),
        after_continue(far));
    println("{} {}", nested(far), promoted(far));
    println("{} {}", in_bounds(1 + unsafe { Z }), in_bounds(2 + unsafe { Z }));
    0
}
