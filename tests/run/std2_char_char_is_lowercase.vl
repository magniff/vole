// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char char::is_lowercase.
// EXPECT: true false true true true false

fn main() {
    println("{} {} {} {} {} {}", 'a'.is_lowercase(), 'A'.is_lowercase(), 'ß'.is_lowercase(),
        'ж'.is_lowercase(), 'ω'.is_lowercase(), '1'.is_lowercase());
}
