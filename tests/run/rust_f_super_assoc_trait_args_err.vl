// (0.30.1, review 4) A subtrait's `Self::A` of its supertrait is the
// definition in the supertrait's impl for the type chosen by the whole
// trait reference: `Sub: Sup<i32>` reads Sup<i32>'s, never Sup<i64>'s,
// whichever impl comes first (review 4's c01, c09; before, the first impl
// of Sup was read). And it is read with that impl's names: a `'static`
// there is not the impl's 'c (c03), and lifetimes named alike in the two
// headers but at other places are not one (c04: Sup's 'a is Sub's 'b).
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 4
trait Sup<P> {
    type A;
}

trait Sub: Sup<i32> {
    fn get(&self) -> Self::A;
}

struct X<'c> {
    r: &'c str,
}

struct Y<'c> {
    r: &'c str,
}

impl<'c> Sup<i64> for X<'c> {
    type A = &'c str;
}

impl<'c> Sup<i32> for X<'c> {
    type A = &'static str;
}

impl<'c> Sub for X<'c> {
    fn get(&self) -> &'c str {
        self.r
    }
}

impl<'c> Sup<i32> for Y<'c> {
    type A = &'static str;
}

impl<'c> Sup<i64> for Y<'c> {
    type A = &'c str;
}

impl<'c> Sub for Y<'c> {
    fn get(&self) -> &'c str {
        self.r
    }
}

trait Sup2 {
    type A;
}

trait Sub2: Sup2 {
    fn get(&self) -> Self::A;
}

struct Z<'c> {
    r: &'c str,
}

struct W<'p, 'q> {
    r: &'p str,
    s: &'q str,
}

impl<'c> Sup2 for Z<'c> {
    type A = &'static str;
}

impl<'c> Sub2 for Z<'c> {
    fn get(&self) -> &'c str {
        self.r
    }
}

impl<'a, 'b> Sup2 for W<'a, 'b> {
    type A = &'a str;
}

impl<'b, 'a> Sub2 for W<'a, 'b> {
    fn get(&self) -> &'b str {
        self.s
    }
}

fn main() {}
