// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ptr NonNull::as_mut.
// EXPECT: 10
use std::ptr::NonNull;

fn main() {
    let mut x = 5i64;
    let mut p = NonNull::new(&mut x as *mut i64).unwrap();
    let r: &mut i64 = unsafe { p.as_mut() };
    *r *= 2;
    println("{}", x);
}
