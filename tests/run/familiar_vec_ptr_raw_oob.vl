// EDITION: rust
// XFAIL: gap 17: compile type error: cannot index into a value of type '*Vec<i64, Gpa>'
// 0.17: `p[i]` through a raw pointer to a Vec, in unsafe code, is checked
// as the Vec's own index is: out of bounds stops the program.
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
fn set(mut v: *mut Vec<i64, Gpa>, i: i64) {
    unsafe {
        v[i as usize] = 4;
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let p = &mut v;
    println("{}", unsafe { p[2] });
    set(&mut v, 3);
    0
}
