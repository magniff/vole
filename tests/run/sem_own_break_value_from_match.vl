// EDITION: rust
// sem-own: `break` with an owned value bound in a match arm inside a loop.
// EXPECT: drop 0
// EXPECT: got 1
// EXPECT: drop 1
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn g(i: i64, gpa: Gpa) -> Option<D<Gpa>> { Some(mk(i, gpa)) }

fn main(gpa: Gpa) {
    let mut i: i64 = 0;
    let d = loop {
        match g(i, gpa) { Some(x) => { if x.id == 1 { break x; } }, None => {} }
        i += 1;
    };
    println("got {}", d.id);
}
