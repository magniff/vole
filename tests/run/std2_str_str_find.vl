// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::find.
// EXPECT: Some(0) Some(6) Some(3) None Some(5)
use std::str::CharIndices;

fn main() {
    let s = "Löwe 老虎 Léopard";
    println("{:?} {:?} {:?} {:?} {:?}", s.find('L'), s.find("老虎"), s.find('w'), s.find('X'),
        s.find(char::is_whitespace));
}
