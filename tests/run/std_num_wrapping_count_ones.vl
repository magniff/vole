// The std item(s): std::num Wrapping::count_ones.
// Wrapping's methods (in Rust they are unstable, `wrapping_int_impl`:
// the rustc twin leaves this case outside).
// EXPECT: 240 15 18 72
// EXPECT: 81 -1 5 true
// EXPECT: 4 15 3 0
use std::num::Wrapping;

fn main() {
    let x = Wrapping(0x0fu8);
    println("{} {} {} {}", x.rotate_left(4), x.rotate_right(8), Wrapping(0x1200u16).swap_bytes(),
        Wrapping(18u8).reverse_bits());
    println("{} {} {} {}", Wrapping(3u8).pow(4), Wrapping(-5i32).signum(), Wrapping(-5i64).abs(),
        Wrapping(64u8).is_power_of_two());
    println("{} {} {} {}", Wrapping(0xf0u8).count_ones(), Wrapping(1u16).leading_zeros(),
        Wrapping(-8i8).trailing_zeros(), Wrapping(-1i32).count_zeros());
}
