// RULE: F9.2, F19.2, F15.1
// FLAGS: --deny-warnings
// Trait imports used only through method calls (Write, Hash, Hasher,
// BuildHasher) and `use std::io::{self, ..}` with `io::stdout()` are not
// use.unused; a `&self` method of a scalar takes a temporary receiver.
// EXPECT: hi
// EXPECT: true true
use std::cmp::Ordering;
use std::hash::{BuildHasher, FixedState, Hash, Hasher};
use std::io::{Write, self};

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64, 2], gpa);
    let b = Vec::from_in([1i64], gpa);
    let o = a.len().cmp(&b.len());
    let mut h = FixedState::new().build_hasher();
    5i64.hash(&mut h);
    let x = h.finish();
    let mut out = io::stdout();
    let _ = out.write_all("hi\n".as_bytes());
    println("{} {}", o == Ordering::Greater, x != 0);
}
