// v[0].f(&v[1]): receiver and argument are elements of one Vec
// ERROR: error[borrowck.mut_twice]
// ERROR: line 9, column 19
#[derive(Clone, Copy)] struct S { n: i64 }
impl S { fn add(&mut self, o: &mut S) { self.n += o.n; o.n = 0; } }

fn main(gpa: Gpa) {
    let mut v: Vec<S, Gpa> = Vec::new_in(gpa); v.push(S { n: 1 }); v.push(S { n: 2 });
    v[0].add(&mut v[1]);
    println("{} {}", v[0].n, v[1].n);
}
