// EDITION: rust
// (0.25) A store to an element, or through inout, drops the value it replaces.
// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
use std::alloc::Allocator; struct D { id: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.id); } }
struct H<A: Allocator> { v: Vec<D, A> }
fn put(h: &mut H<Gpa>) { h.v[0] = D { id: 2 }; }

fn main(gpa: Gpa) {
    let mut h = H { v: Vec::new_in(gpa) }; h.v.push(D { id: 1 }); put(&mut h); println("after");
}
