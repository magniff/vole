// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::io Stdin; std::io stdin.
// EXPECT: abc
// STDIN: abc
use std::io::{BufRead, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    io::stdin().read_line(&mut s).unwrap();
    print("{}", s);
}
