// EXPECT: drop 1
// EXPECT: after
// EXPECT: drop 2
struct D { id: i64 }
impl Drop for D { fn drop(&mut self) { println("drop {}", self.id); } }
fn put(s: &mut [D]) { s[0] = D { id: 2 }; }

fn main(gpa: Gpa) {
    let mut v: Vec<D, Gpa> = Vec::new_in(gpa); v.push(D { id: 1 }); put(&mut v); println("after");
}
