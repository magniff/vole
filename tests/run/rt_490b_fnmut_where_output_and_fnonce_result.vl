// XFAIL: RT-490b: (RT-490, more positions) `let r: F::Output = f(x);` under `where F: FnMut(i64) -> u8` and a result type `-> G::Output` under `G: FnOnce() -> i64` are refused, "'F' has no associated type 'Output'"; rustc prints `1 5` (0.30.2)
// From the second re-review of the obligation work, M2 (g302oblig). Since v0.30.1 at least.
// From the review's form i02_fnmut_where_output.
// EXPECT: 1 5
fn app<F>(mut f: F, x: i64) -> usize
    where
        F: FnMut(i64) -> u8,
{
    let r: F::Output = f(x);
    std::mem::size_of_val(&r)
}

fn once<G: FnOnce() -> i64>(g: G) -> G::Output {
    g()
}

fn main() {
    println("{} {}", app(|x| x as u8, 1i64), once(|| 5i64));
}
