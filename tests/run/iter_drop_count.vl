// 0.25: count over owned items drops each one (a counting Drop type).
// FLAGS: --check-alloc
// EXPECT: count 3
// EXPECT: count: made 3 dropped 3
// EXPECT: pop: made 7 dropped 7
static var MADE: i64 = 0;
static var DROPS: i64 = 0;
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { DROPS += 1; } }
impl Eq for D<Gpa> { fn eq(self, o: Self) -> bool { self.id == o.id } }
impl Ord for D<Gpa> { fn cmp(self, o: Self) -> i64 { self.id - o.id } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    MADE += 1;
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen<A: Allocator> { n: i64, k: i64, gpa: A }

impl Iterator for Gen<Gpa> {
    type Item = D<Gpa>;

    fn next(inout self) -> Option<D<Gpa>> {
        if self.k >= self.n { return None; }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen<Gpa> { Gen { n: n, k: 0, gpa: gpa } }
// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop<A: Allocator> { v: Vec<D<A>, A> }

impl Iterator for Pop<Gpa> {
    type Item = D<Gpa>;
    fn next(inout self) -> Option<D<Gpa>> { self.v.pop() }
}

fn pop(n: i64, gpa: Gpa) -> Pop<Gpa> {
    var v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 1..=n { v.push(mk(i, gpa)); }
    Pop { v: v }
}

fn report(what: [u8]) {
    println("{what}: made {MADE} dropped {DROPS}");
}

fn main(gpa: Gpa) {
    println("count {}", gen(3, gpa).count());
    report("count");
    let n = pop(4, gpa).count();
    report("pop");
}
