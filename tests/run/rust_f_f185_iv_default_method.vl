// RULE: F18.5
// (0.30.2) A trait's default method whose body has integer literals,
// instanced for u8 and for i32: each instance's check retypes its own
// nodes, the template's that it shares and those its check made
// (infer.vl swept's extras); without the extras one instance kept the
// other's variables and the back end had "an operand not in a register".
// From the review of the integer-literal work; rustc prints the EXPECT line.
// EXPECT: 4000000001 4000000002
trait T {
    fn k(&self, x: i64) -> i64 {
        let a = 2000000000;
        let b = a + a;
        b + x
    }
}

impl T for u8 {}
impl T for i32 {}

fn main() {
    println("{} {}", 5u8.k(1), 5i32.k(2));
}
