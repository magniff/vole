// RULE: D2.4a
// (0.30.1) Rust's left-to-right order with moved places: a tuple's (and
// an array's, a struct literal's, a variant's) part that moves a place is
// moved where it is evaluated, so a later part that gives the place a new
// value leaves the aggregate the old one, and a part after that may move
// the new one (`(c, { c = new; 0 }, c)`); a by-value receiver, an
// operator's left operand, a builtin index's place, an assignment's value
// before its place's index, a compound assignment's, and Copy parts are
// in rustc's order too. rustc-twin's output is the EXPECT.
// EXPECT: recv old 1 new 1
// EXPECT: add old 2x new 2
// EXPECT: index 7
// EXPECT: assign [0, 5, 0] 1
// EXPECT: vassign [0, 6] 1
// EXPECT: compound [1, 11, 1] 1
// EXPECT: tuple3 old 3 0 new 3
// EXPECT: copy (1, 2, 2)
// EXPECT: last 0 new 4
use std::alloc::Allocator;

struct W<A: Allocator> {
    s: String<A>,
}

impl<A: Allocator> W<A> {
    fn take(self, n: i64) -> String<A> {
        let _ = n;
        self.s
    }
}

fn main(gpa: Gpa) {
    let mut w = W { s: format_in("old {}", 1, gpa) };
    let r = w.take({
        w = W { s: format_in("new {}", 1, gpa) };
        0
    });
    println("recv {} {}", r, w.s);
    let mut a = format_in("old {}", 2, gpa);
    let b = a + {
        a = format_in("new {}", 2, gpa);
        "x"
    };
    println("add {} {}", b, a);
    let mut arr = [1, 2, 3];
    let v = arr[{
        arr = [7, 8, 9];
        0
    }];
    println("index {v}");
    let mut i: usize = 0;
    let mut xs = [0, 0, 0];
    xs[i] = {
        i += 1;
        5
    };
    println("assign {:?} {i}", xs);
    let mut j: usize = 0;
    let mut vs: Vec<i64, Gpa> = Vec::new_in(gpa);
    vs.push(0);
    vs.push(0);
    vs[j] = {
        j += 1;
        6
    };
    println("vassign {:?} {j}", vs);
    let mut k: usize = 0;
    let mut ys = [1, 1, 1];
    ys[k] += {
        k += 1;
        10
    };
    println("compound {:?} {k}", ys);
    let mut c = format_in("old {}", 3, gpa);
    let t = (c, {
        c = format_in("new {}", 3, gpa);
        0
    }, c);
    println("tuple3 {} {} {}", t.0, t.1, t.2);
    let mut n = 1;
    let q = (n, {
        n += 1;
        n
    }, n);
    println("copy {:?}", q);
    let mut d = format_in("old {}", 4, gpa);
    let e = ({
        d = format_in("new {}", 4, gpa);
        0
    }, d);
    println("last {} {}", e.0, e.1);
}
