// XFAIL: RT-485: `fn kf<T>(x: T) -> &'static i64 where &'static i64: From<T> { From::from(x) }` is refused in its body, borrowck.outlives "the lifetime in 'T' must outlive 'static": the where clause already says it; rustc builds it and `Some(&K).map(kf::<&'static i64>)` prints `Some(1000)` (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// The review's sp01 passes a Vec's element instead of a static's, which
// rustc refuses at the call (E0597); vole refuses kf itself.
// EXPECT: Some(1000)
static K: i64 = 1000;

fn kf<T>(x: T) -> &'static i64
    where
        & 'static i64: From<T>,
{
    From::from(x)
}

fn main() {
    let a = Some(&K).map(kf::<&'static i64>);
    println("{:?}", a);
}
