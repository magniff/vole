// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter &mut I::impl Iterator.
// EXPECT: Some(1) Some(2)

fn take_one<I: Iterator<Item = i64>>(mut it: I) -> Option<i64> {
    it.next()
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let mut it = v.iter().copied();
    let a = take_one(&mut it);
    println("{:?} {:?}", a, it.next());
}
