// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::values_mut.
// EXPECT: [2, 4]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    m.insert(2, 2);
    for x in m.values_mut() {
        *x *= 2;
    }
    let mut vs: Vec<i64, Gpa> = m.values().copied().collect_in(gpa);
    vs.sort();
    println("{:?}", vs);
}
