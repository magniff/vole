// XFAIL: gap 2: compile type error: no 'sys' in module 'std'
// EXPECT: new 3 500000000 millis 1 250000000 micros 0 1500 nanos 2 5
// EXPECT: add 5 100000000 sub 0 900000000 sub under true add over true
// EXPECT: sat max true zero true mul 7 500000000 div 0 333333333 mul over true div0 true
// EXPECT: f64 1.5 2 999999999 rounded 1 0 bad true true
// EXPECT: as_millis 1250 as_micros 1250000 as_nanos 1250000000 sat true
// EXPECT: cmp -1 1 0 abs_diff 0 250000000 zero true
// EXPECT: monotonic true sleep true realtime true
// 0.20 (A7): std::time's Duration, its arithmetic at its edges, and the
// clocks (monotonic, realtime, sleep).
use std::sys::SYS_CLOCK_REALTIME;
use std::time::Duration; use std::time::clock_now; use std::time::monotonic_now;
use std::time::sleep;

fn main() -> i32 {
    let a = Duration::new(1u64, 2500000000u32);
    let b = Duration::from_millis(1250u64);
    let c = Duration::from_micros(1500u64);
    let d = Duration::from_nanos(2000000005u64);
    println(
        "new {} {} millis {} {} micros {} {} nanos {} {}", a.as_secs(), a.subsec_nanos(),
        b.as_secs(), b.subsec_nanos(), c.as_secs(), c.subsec_micros(), d.as_secs(),
        d.subsec_nanos());

    let s = Duration::new(3u64, 600000000u32)
        .checked_add(Duration::new(1u64, 500000000u32))
        .unwrap();
    let t = Duration::new(2u64, 0u32).checked_sub(Duration::new(1u64, 100000000u32)).unwrap();
    let under = Duration::new(1u64, 0u32).checked_sub(Duration::new(1u64, 1u32)).is_none();
    let over = Duration::max_value().checked_add(Duration::from_nanos(1u64)).is_none();
    println(
        "add {} {} sub {} {} sub under {under} add over {over}", s.as_secs(), s.subsec_nanos(),
        t.as_secs(), t.subsec_nanos());

    let sat = Duration::max_value().saturating_add(Duration::from_secs(1u64))
        == Duration::max_value();
    let zero = Duration::from_secs(1u64).saturating_sub(Duration::from_secs(2u64)).is_zero();
    let m = Duration::new(2u64, 500000000u32).mul_u32(3u32);
    let dv = Duration::from_secs(1u64).div_u32(3u32);
    let mover = Duration::from_secs(9223372036854775807u64).checked_mul(3u32).is_none();
    let div0 = Duration::from_secs(1u64).checked_div(0u32).is_none();
    println(
        "sat max {sat} zero {zero} mul {} {} div {} {} mul over {mover} div0 {div0}", m.as_secs(),
        m.subsec_nanos(), dv.as_secs(), dv.subsec_nanos());

    let f = Duration::from_secs_f64(2.999999999);
    let r = Duration::from_secs_f64(0.9999999999);
    let bad1 = Duration::try_from_secs_f64(-1.0).is_none();
    let bad2 = Duration::try_from_secs_f64(1.0e30).is_none();
    println(
        "f64 {} {} {} rounded {} {} bad {bad1} {bad2}",
        Duration::new(1u64, 500000000u32).as_secs_f64(), f.as_secs(), f.subsec_nanos(), r.as_secs(),
        r.subsec_nanos());

    let ms = Duration::from_millis(1250u64);
    let satm = Duration::max_value().as_nanos() == 18446744073709551615;
    println(
        "as_millis {} as_micros {} as_nanos {} sat {satm}", ms.as_millis(), ms.as_micros(),
        ms.as_nanos());

    let x = Duration::new(1u64, 0u32);
    let y = Duration::new(1u64, 1u32);
    let ad = Duration::from_millis(1000u64).abs_diff(Duration::from_millis(1250u64));
    println(
        "cmp {} {} {} abs_diff {} {} zero {}", x.cmp(y), y.cmp(x), x.cmp(x), ad.as_secs(),
        ad.subsec_nanos(), Duration::zero().is_zero());

    let mut prev = monotonic_now();
    let mut mono = true;
    for _ in 0..1000 {
        let now = monotonic_now();
        if now < prev {
            mono = false;
        }
        prev = now;
    }
    let t0 = monotonic_now();
    sleep(Duration::from_millis(20u64));
    let slept = monotonic_now().checked_sub(t0).unwrap();
    let real = clock_now(SYS_CLOCK_REALTIME).as_secs() > 1700000000;
    println("monotonic {mono} sleep {} realtime {real}", slept >= Duration::from_millis(20u64));

    0
}
