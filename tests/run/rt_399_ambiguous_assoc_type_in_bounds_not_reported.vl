// RT-399, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig-m2 (form f272q). Since v0.30.1 at least;
// the release build the same. rustc E0221 at `T::Out` (the rustc twin of
// this file); `<T as H2>::Out` names one.
// ERROR: line 27
// ERROR-COUNT: 1
trait H2 {
    type Out;
}

trait H3 {
    type Out;
}

struct W {
    r: i64,
}

impl H2 for W {
    type Out = i64;
}

impl H3 for W {
    type Out = i32;
}

fn mid<T: H2 + H3>(t: &T, o: T::Out) -> i64 {
    1
}

fn main() {
    println("{}", mid(&W { r: 0 }, 5));
}
