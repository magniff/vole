// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io BufReader::get_mut.
// EXPECT: [1] [2, 3]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    let mut one = [0u8; 1];
    b.get_mut().read_exact(&mut one).unwrap();
    println("{:?} {:?}", one, b.fill_buf().unwrap());
}
