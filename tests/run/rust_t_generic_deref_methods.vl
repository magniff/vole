// RULE: F6.2
// (0.28.0) Methods and fields through a generic Deref impl: `g.push(x)`
// of a guard over a Vec, `g.n` and `g.bump()` over a struct, `b.get()`
// of a Box. The impl's `Target`, projected for the receiver's type, says
// what to look in (a generic impl has no resolved signature to read).
// EXPECT: 1
// EXPECT: 2 2
// EXPECT: 5 5 41 41
use std::ops::{Deref, DerefMut};

struct Guard<'a, T> {
    v: &'a mut T,
}

impl<'a, T> Deref for Guard<'a, T> {
    type Target = T;

    fn deref(&self) -> &T {
        self.v
    }
}

impl<'a, T> DerefMut for Guard<'a, T> {
    fn deref_mut(&mut self) -> &mut T {
        &mut *self.v
    }
}

struct P {
    n: i64,
}

impl P {
    fn get(&self) -> i64 {
        self.n
    }

    fn bump(&mut self) {
        self.n += 1;
    }
}

struct W {
    p: P,
}

impl Deref for W {
    type Target = P;

    fn deref(&self) -> &P {
        &self.p
    }
}

fn main(gpa: Gpa) {
    let mut vec: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut g = Guard { v: &mut vec };
    g.push(1);
    println("{}", g.len());
    let mut p = P { n: 1 };
    let mut gp = Guard { v: &mut p };
    gp.bump();
    println("{} {}", gp.get(), gp.n);
    let w = W { p: P { n: 5 } };
    let b = Box::new_in(P { n: 41 }, gpa);
    println("{} {} {} {}", w.get(), w.n, b.get(), b.n);
}
