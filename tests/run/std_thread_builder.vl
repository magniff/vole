use std::thread;

fn main(gpa: Gpa) {
    let h = thread::Builder::new().spawn_in(move || {
        let mut t = 0i64;
        for i in 1..11 {
            t += i;
        }
        t
    }, gpa).unwrap();
    println("{}", h.join().unwrap());
}
