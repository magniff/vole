// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Read::by_ref.
// EXPECT: [1] [2, 3]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut a = [0u8; 1];
    r.by_ref().read_exact(&mut a).unwrap();
    let mut b = [0u8; 2];
    r.read_exact(&mut b).unwrap();
    println("{:?} {:?}", a, b);
}
