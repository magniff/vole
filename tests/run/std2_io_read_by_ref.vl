// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io Read::by_ref.
// EXPECT: [1] [2, 3]
use std::io::{BufRead, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut a = [0u8; 1];
    r.by_ref().read_exact(&mut a).unwrap();
    let mut b = [0u8; 2];
    r.read_exact(&mut b).unwrap();
    println("{:?} {:?}", a, b);
}
