// RULE: D7.4
// (0.27.1) An explicit `&mut s` argument is not two-phase: `add2(&mut s,
// s.x)` reads a mutably borrowed place.
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 20, column 18
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct S {
    x: i64,
    y: i64,
}

fn add2(s: &mut S, k: i64) {
    s.x += k;
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    add2(&mut s, s.x);
    println("{}", s.x);
}
