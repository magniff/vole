// 0.26.2: the check-time GPU lint over a function whose temporaries
// read ones of the same name (the for loop's over a Vec field, a call
// with field arguments): it once recursed without end (voxel's draw).
// EXPECT: 3
embed wgsl R {
    @compute @workgroup_size(1)
    fn main() {
    }
}

struct Chunk {
    cx: i64,
    cz: i64,
}

struct World {
    chunks: Vec<Chunk>,
}

struct Camera {
    x: f64,
}

fn visible(cam: Camera, cx: i64, cz: i64) -> bool {
    cam.x > (cx + cz) as f64
}

fn draw(world: World, cam: Camera) -> i64 {
    var count = 0;
    for chunk in world.chunks {
        if visible(cam, chunk.cx, chunk.cz) { count += 1; }
    }
    count
}

fn main(gpa: Gpa) -> i32 {
    var chunks: Vec<Chunk> = Vec::new_in(gpa);
    for i in 0..4 {
        chunks.push(Chunk { cx: i * 10, cz: i * 10 });
    }
    let w = World { chunks: chunks };
    let cam = Camera { x: 50.0 };
    println(draw(w, cam));
    0
}
