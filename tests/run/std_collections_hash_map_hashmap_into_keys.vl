// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::collections::hash_map HashMap::into_keys.
// EXPECT: [1, 2]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(2, 0);
    m.insert(1, 0);
    let mut ks: Vec<i64, Gpa> = m.into_keys().collect_in(gpa);
    ks.sort();
    println("{:?}", ks);
}
