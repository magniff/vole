// Runs on std since its gap closed (0.27.3).
// The std item(s): std::io BufRead::read_until.
// EXPECT: 2 [97, 44, 98] 1 [99]
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let mut b = BufReader::new("a,b,c".as_bytes());
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    let n = b.read_until(44, &mut v).unwrap();
    v.clear();
    let m = b.read_until(44, &mut v).unwrap();
    let mut w: Vec<u8, Gpa> = Vec::new_in(gpa);
    let k = b.read_until(44, &mut w).unwrap();
    println("{} {:?} {} {:?}", n + m - 2, Vec::from_in([97u8, 44, 98], gpa), k, w);
}
