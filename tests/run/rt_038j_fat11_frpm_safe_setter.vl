// RULE: C3.4
// (0.30.2, the re-review 2 of g302holes: holes/fat11_frpm_safe_setter)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'go', which writes through a raw pointer what it did not make
// from_raw_parts_mut handed to a safe setter, in a callee
fn set0(s: &mut [i64]) { s[0] = 9; }
fn go(p: *mut i64) -> bool { set0(unsafe { std::slice::from_raw_parts_mut(p, 1) }); true }

fn f(p: *mut i64) -> i64
    requires go(p)
{ 1 }

fn main() { let mut x = 1i64; println("{}", f(&raw mut x)); println("{}", x); }
