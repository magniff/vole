// XFAIL: gap 17: errors at other places or codes: MVS alloc.default@18:13; item.deprecated@22:12; alloc.default@22:12; alloc...
// (0.26.3) alloc.default: std's types have no default allocator type, so
// a container's allocator is always written (`Vec<i64, Gpa>`, or a
// generic `A`). The fix writes Gpa, what the 0.26.2 default meant, and in
// an item generic over one allocator that parameter (err_alloc_generic);
// a declared default on an allocator parameter is the same error.
// ERROR: error[alloc.default]: 'Vec' names no allocator: its 'A' is written, last
// ERROR: help: the allocator is part of the type: `Gpa` (the type of main's `gpa`), or a generic `A: Allocator`
// ERROR: fix --only alloc
// ERROR: fix --suggested
// ERROR: error[alloc.default]: 'Buf' names no allocator: its 'A' is written
// ERROR: error[alloc.default]: 'HashMap' names no allocator: its 'A' is written
// ERROR: help: this item is generic over the allocator 'A': write it (`, A`, the fix), or `Gpa`
// ERROR: error[alloc.default]: the allocator parameter 'A' has a default: an allocator type is always written (0.26.3)
// ERROR-COUNT: 5
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
use std::alloc::Allocator; use std::collections::HashMap;

fn total(v: &Vec<i64>) -> i64 {
    v.iter().copied().sum::<i64>()
}

fn name(b: &Buf) -> usize {
    b.len()
}

fn keys(m: &HashMap<i64, i64>) -> usize {
    m.len()
}

fn grow<A: Allocator>(v: &mut Vec<i64, A>, w: &Vec<i64>) {
    v.push(w.len() as i64);
}

struct Pool<A: Allocator = Gpa> {
    items: Vec<i64, A>,
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let w: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&mut v, &w);
    println("{}", total(&v));
}
