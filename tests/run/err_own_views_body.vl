// XFAIL: gap 8: errors at other places or codes: MVS own.views@14:9; own.views@20:50; rust borrowck.outlives@20:5; borrowck...
// 0.17 (value semantics, T3): a #[views] declaration is checked against
// the body (own.views); its help gives the declaration the body makes.
// ERROR: 'Lexer<Gpa>::word' is #[views(*self)] but returns a view of 'self': 'self.src.as_slice()[a..b]'
// ERROR: 'keep' is #[stores()] but 'names' may hold a view of 'word' when it returns
use std::alloc::Allocator; struct Lexer<A: Allocator> { src: String<A>, pos: i64 }

impl Lexer<Gpa> {
    #[views(*self)]
    fn word(&mut self) -> &str {
        let a = self.pos;
        let b = a + 1;
        self.pos = b;
        &self.src.as_str()[a as usize..b as usize]
    }
}

#[views()]
#[stores()]
fn keep(names: &mut Vec<&str, Gpa>, word: &str) {
    names.push(word);
}

fn main(gpa: Gpa) {
    let mut lx = Lexer { src: String::new_in(gpa), pos: 0 };
    lx.src.push_str("ab");
    println("{}", lx.word());
    let mut names: Vec<&str, Gpa> = Vec::new_in(gpa);
    keep(&mut names, "x");
}
