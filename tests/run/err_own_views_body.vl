// 0.17 (value semantics, T3): a #[views] declaration is checked against
// the body (own.views); its help gives the declaration the body makes.
// FLAGS: --values=error
// ERROR: 'Lexer<Gpa>::word' is #[views(*self)] but returns a view of 'self': 'self.src.as_slice()[a..b]'
// ERROR: 'keep' is #[stores()] but 'names' may hold a view of 'word' when it returns
struct Lexer<A: Allocator> { src: String<A>, pos: i64 }

impl Lexer<Gpa> {
    #[views(*self)]
    fn word(inout self) -> [u8] {
        let a = self.pos;
        let b = a + 1;
        self.pos = b;
        self.src.as_slice()[a..b]
    }
}

#[views()]
#[stores()]
fn keep(names: inout Vec<[u8], Gpa>, word: [u8]) {
    names.push(word);
}

fn main(gpa: Gpa) {
    var lx = Lexer { src: String::new_in(gpa), pos: 0 };
    lx.src.push_str("ab");
    println(lx.word());
    var names: Vec<[u8], Gpa> = Vec::new_in(gpa);
    keep(&names, "x");
}
