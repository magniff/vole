// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::thread available_parallelism.
// EXPECT: true
// RUSTC: none (std2's returns a usize; Rust's an io::Result<NonZero<usize>>)
use std::thread;

fn main() {
    let n: usize = thread::available_parallelism();
    println("{}", n >= 1);
}
