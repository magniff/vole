// RULE: F8.3, F8.4
// RT-C301-8 review (R2, form f50c_myinto_generic): `i64::from(6u8)` with a program's `Conv::from` and std's From both applicable: rustc E0034.
// rustc: error[E0034]: multiple applicable items in scope
// ERROR: error[method.ambiguous]: multiple applicable items: 'from' is an item of more than one trait for 'i64'
trait Conv<T> { fn from(x: T) -> Self; }
impl Conv<u8> for i64 { fn from(x: u8) -> i64 { 1000 + x as i64 } }
fn g<T: Conv<u8>>() -> T { T::from(5u8) }
fn main() { let a: i64 = g(); let b = i64::from(6u8); println("{} {}", a, b); }
