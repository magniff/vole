// std::cli (0.25.2): Arg::num_values (an option of n values, each
// occurrence n more, fewer a MissingValue), Arg::default_missing (an
// optional value: only the = form gives one), Arg::allow_hyphen_values (a
// positional takes a word starting with '-' that is no option), Arg::last
// (a positional of the words after --) and how the help shows them.
// EXPECT: $ tool --overlay a.vl b.vl --overlay=c.vl d.vl
// EXPECT: tool overlay=[a.vl,b.vl,c.vl,d.vl] stats=[] pattern=[] at 4
// EXPECT: $ tool -O a.vl b.vl -Oc.vl d.vl
// EXPECT: tool overlay=[a.vl,b.vl,c.vl,d.vl] stats=[] pattern=[] at 4
// EXPECT: $ tool --overlay a.vl
// EXPECT: error: option '--overlay' needs a value
// EXPECT: try: --overlay <PATH> <COPY>
// EXPECT: usage: tool [options] [pattern] [command]
// EXPECT: [MissingValue 2]
// EXPECT: $ tool -O
// EXPECT: error: option '-O' needs a value
// EXPECT: try: --overlay <PATH> <COPY>
// EXPECT: usage: tool [options] [pattern] [command]
// EXPECT: [MissingValue 2]
// EXPECT: $ tool --stats
// EXPECT: tool overlay=[] stats=[all] pattern=[] at 0
// EXPECT: $ tool --stats=functions
// EXPECT: tool overlay=[] stats=[functions] pattern=[] at 0
// EXPECT: $ tool --stats -q
// EXPECT: tool overlay=[] stats=[all] pattern=[] at 0
// EXPECT: $ tool -sq
// EXPECT: tool overlay=[] stats=[all] pattern=[] at 0
// EXPECT: $ tool -s=passes
// EXPECT: tool overlay=[] stats=[passes] pattern=[] at 0
// EXPECT: $ tool -q ->bool
// EXPECT: tool overlay=[] stats=[] pattern=[->bool] at 0
// EXPECT: $ tool -q -qx
// EXPECT: error: unknown option '-x' in '-qx'
// EXPECT: try: --help
// EXPECT: usage: tool [options] [pattern] [command]
// EXPECT: [UnknownOption 2]
// EXPECT: $ tool -q -5
// EXPECT: tool overlay=[] stats=[] pattern=[-5] at 0
// EXPECT: $ tool -q --frob
// EXPECT: tool overlay=[] stats=[] pattern=[--frob] at 0
// EXPECT: $ tool --quiet
// EXPECT: tool overlay=[] stats=[] pattern=[] at 0
// EXPECT: $ tool probe f.vl:3 x -y -- -a b
// EXPECT: probe expr=[f.vl:3,x,-y] args=[-a,b]
// EXPECT: $ tool probe f.vl:3 -- --help
// EXPECT: probe expr=[f.vl:3] args=[--help]
// EXPECT: $ tool probe --help
// EXPECT: tool probe
// EXPECT: values at a line
// EXPECT:
// EXPECT: usage: tool probe [options] [expr]... [-- args]...
// EXPECT:
// EXPECT: arguments:
// EXPECT:   <expr>...
// EXPECT:   <args>...
// EXPECT:
// EXPECT: options:
// EXPECT:   -h, --help     print this help
// EXPECT: [Help 0]
// EXPECT: $ tool --help
// EXPECT: tool
// EXPECT:
// EXPECT: usage: tool [options] [pattern] [command]
// EXPECT:
// EXPECT: arguments:
// EXPECT:   <pattern>
// EXPECT:
// EXPECT: options:
// EXPECT:   -O, --overlay <PATH> <COPY>
// EXPECT:                          read COPY for PATH
// EXPECT:   -s, --stats[=<STATS>]  print counts
// EXPECT:   -q, --quiet
// EXPECT:   -h, --help             print this help
// EXPECT:
// EXPECT: commands:
// EXPECT:   probe                  values at a line
// EXPECT: [Help 0]
use std::cli::{Arg, Command, Matches};

fn list(m: Matches, name: str) {
    print(" {name}=[");
    let v = m.values(name);
    for k in 0..v.len() {
        if k > 0 {
            print(",");
        }
        print(v[k]);
    }
    print("]");
}

fn show(cmd: Command, line: str, gpa: Gpa) {
    println("$ {line}");
    match cmd.parse(line.split(' ')) {
        Ok(m) => match m.subcommand() {
            Some((name, sub)) => {
                print(name);
                list(sub, "expr");
                list(sub, "args");
                println("");
            }
            None => {
                print("tool");
                list(m, "overlay");
                list(m, "stats");
                list(m, "pattern");
                println(" at {}", m.indices_of("overlay").len());
            }
        },
        Err(e) => {
            print(cmd.render_in(e, gpa).as_slice());
            println("[{:?} {}]", e.kind, e.exit_code());
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("tool", gpa)
        .arg(Arg::option("overlay").short('O').num_values(2).value_name("PATH COPY")
            .help("read COPY for PATH"))
        .arg(Arg::option("stats").short('s').default_missing("all").help("print counts"))
        .arg(Arg::flag("quiet").short('q'))
        .arg(Arg::positional("pattern").allow_hyphen_values())
        .subcommand(Command::new_in("probe", gpa).about("values at a line")
            .arg(Arg::positional("expr").multiple().allow_hyphen_values())
            .arg(Arg::positional("args").multiple().last()));
    show(cmd, "tool --overlay a.vl b.vl --overlay=c.vl d.vl", gpa);
    show(cmd, "tool -O a.vl b.vl -Oc.vl d.vl", gpa);
    show(cmd, "tool --overlay a.vl", gpa);
    show(cmd, "tool -O", gpa);
    show(cmd, "tool --stats", gpa);
    show(cmd, "tool --stats=functions", gpa);
    show(cmd, "tool --stats -q", gpa);
    show(cmd, "tool -sq", gpa);
    show(cmd, "tool -s=passes", gpa);
    show(cmd, "tool -q ->bool", gpa);
    show(cmd, "tool -q -qx", gpa);
    show(cmd, "tool -q -5", gpa);
    show(cmd, "tool -q --frob", gpa);
    show(cmd, "tool --quiet", gpa);
    show(cmd, "tool probe f.vl:3 x -y -- -a b", gpa);
    show(cmd, "tool probe f.vl:3 -- --help", gpa);
    show(cmd, "tool probe --help", gpa);
    show(cmd, "tool --help", gpa);
    0
}
