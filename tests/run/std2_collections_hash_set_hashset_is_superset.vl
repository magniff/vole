// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set HashSet::is_superset.
// EXPECT: false true
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    println("{} {}", a.is_superset(&b), b.is_superset(&a));
}
