// (0.26.2) A usize count of i64 elements is vectorized: since 0.26.2's
// std, Iterator::count and a loop's counter are usize (u64 in the IR),
// and the vectorizer took u64 and i64 for two element types and left the
// loop scalar (bench/iterchain's max_count, 1.47x the instructions).
// Integers of one width share their lanes; the sign is checked where it
// matters (a comparison, a minimum).
// EXPECT: 4 6
// CHECK: fn count_above:
// CHECK: v2i64 = load
// CHECK: fn count_even:
// CHECK: v2i64 = load
// CHECK: fn main:

#[inline(never)]
fn count_above(v: Vec<i64>, r: i64) -> usize {
    v.iter().filter(|x| x > r).count()
}

#[inline(never)]
fn count_even(s: [i64]) -> usize {
    var n: usize = 0;
    for x in s {
        if x & 1 == 0 {
            n += 1;
        }
    }
    n
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..12 {
        v.push(i);
    }
    println("{} {}", count_above(v, 7), count_even(v.as_slice()));
    0
}
