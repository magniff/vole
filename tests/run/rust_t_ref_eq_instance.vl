// RULE: F6.2, F26.3
// (0.28.0, gap 103) `Option<&u8> == Option<&u8>`: in the instance
// `Option<&u8>::eq` the derive's `PartialEq::eq(a, b)` is T's own impl,
// `<&u8 as PartialEq<&u8>>::eq` (it looked for `u8::eq` with `&&u8`); so
// is `a.eq(b)` of `a: &T`. A comparison's other operand takes the type
// of the first when that has one impl of the trait: `a == Some(0)`,
// `v.last() == Some(&0)`, `Some(0) == a`. `&a == &b` of two `&u8`, and
// `a == b` of `a: &T` with T = `&u8`, compared the addresses.
#[derive(PartialEq)]
enum O<T> {
    S(T),
    N,
}

struct W<T> {
    x: T,
}

impl<T: PartialEq> PartialEq for W<T> {
    fn eq(&self, o: &W<T>) -> bool { self.x == o.x }
}

fn same<T: PartialEq>(a: &T, b: &T) -> bool { a == b }

fn same2<T: PartialEq>(a: &T, b: &T) -> bool { a.eq(b) }

fn same3<T: PartialEq>(a: T, b: T) -> bool { a == b }

fn main() {
    let x = 1u8;
    let y = 1u8;
    println("{} {} {}", same3(&x, &y), same(&&x, &&y), same2(&&x, &&y));
    println("{}", W { x: &x } == W { x: &y });
    println("{}", O::S(&x) == O::S(&y));
    let n: O<&u8> = O::N;
    println("{}", n == O::S(&3));
    let s = "abc";
    println("{}", s.as_bytes().first() == Some(&b'a'));
    let v = [1i64, 0];
    println("{} {}", v.last() == Some(&0), v.first() == Some(&0));
    let a: Option<i64> = Some(0);
    println("{} {} {}", a == Some(0), Some(0) == a, a != Some(1));
    let r: Result<u8, i64> = Ok(1);
    println("{} {}", r == Ok(1), r == Err(2));
    let t: (i64, u8) = (1, 2);
    println("{}", t == (1, 2));
    // references compare what they refer to, level by level
    let rx = &x;
    let ry = &y;
    let f = 1.5f64;
    println("{} {} {} {}", &rx == &ry, &&x == &&y, &&x != &&y, &f < &2.0);
    let wa = W { x: 1i64 };
    let wb = W { x: 1i64 };
    println("{} {}", &wa == &wb, &&wa == &&wb);
    let p: *const u8 = &x;
    let q: *const u8 = &y;
    println("{} {}", p == q, p == p);
}
// EXPECT: true true true
// EXPECT: true
// EXPECT: true
// EXPECT: false
// EXPECT: true
// EXPECT: true false
// EXPECT: true true true
// EXPECT: true false
// EXPECT: true
// EXPECT: true true false true
// EXPECT: true true
// EXPECT: false true
