// XFAIL: RT-289: the default methods of a generic trait copied into `impl PartialEq<S> for T` (two program types) resolve the impl's trait arguments in the trait's module: `T { k: 1 } == S { k: 1 }` gives "unknown type 'S'" in std's cmp.vl (0.30.2)
// rustc prints true. RT-203 is the same with a primitive Self (`impl
// PartialEq<S> for i64`); this is a program type as Self. From g302probe;
// v0.30.1 the same.
// EXPECT: true false
struct S {
    k: i64,
}

struct T {
    k: i64,
}

impl PartialEq<S> for T {
    fn eq(&self, o: &S) -> bool {
        self.k == o.k
    }
}

fn main() {
    println("{} {}", T { k: 1 } == S { k: 1 }, T { k: 1 } != S { k: 1 });
}
