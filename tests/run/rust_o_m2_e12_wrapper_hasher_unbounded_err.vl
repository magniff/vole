// (re-review of M2, e12) A struct field `HashMap<i64, i64, A, S>` with S
// unbounded. std's HashMap declares `S: BuildHasher` on the type (vole's
// hasher is part of the type, always written, never defaulted; Rust's
// HashMap has no bound there), so a type that holds one with S must
// bound S as the type does, as rustc requires of any struct's field
// type's bounds (E0277). v0.30.1 accepted it: the impl header's type was
// never held to the struct's bounds (RT-401's mechanism). vole reports it
// at the impl's header; rustc would at the field (the WF pass, M5).
// ERROR: the trait 'BuildHasher' is not implemented for 'S'
use std::alloc::Allocator;
use std::collections::HashMap;

struct Wrap<S, A: Allocator> {
    m: HashMap<i64, i64, A, S>,
}

impl<S, A: Allocator> Wrap<S, A> {
    fn n(&self) -> usize {
        7
    }
}

fn main(gpa: Gpa) {
    let w = Wrap { m: HashMap::new_in(gpa) };
    println("{}", w.n());
}
