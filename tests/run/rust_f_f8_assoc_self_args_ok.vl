// RULE: F8.2
// `Tr::f(args)` takes Self from the expected type only when f's result is
// `Self`: `Step::steps_between(&a, &b)` returns a tuple, and its Self is
// the arguments' type (0.27.3: it was the expected tuple).
// RUSTC: none std::iter::Step is unstable in rustc (E0658)
// EXPECT: (3, Some(3)) 0
use std::iter::Step;

struct Span {
    a: i64,
    b: i64,
}

impl Span {
    fn len(&self) -> (usize, Option<usize>) {
        Step::steps_between(&self.a, &self.b)
    }
}

fn main() {
    let s = Span { a: 2, b: 5 };
    let d: i64 = Default::default();
    println("{:?} {}", s.len(), d);
}
