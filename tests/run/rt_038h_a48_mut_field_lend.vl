// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a48_mut_field_lend)
// RUSTC: none contract clauses are not Rust
// ERROR: cannot borrow '*h.r' as mutable
// A struct by value holding a &mut: the clause lends the field to a &mut callee.
fn bump(r: &mut i64) -> bool {
    *r = 9;
    true
}

struct H<'a> { r: &'a mut i64 }

fn f(h: H) -> i64
    requires bump(h.r)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(H { r: &mut x }));
    println("{}", x);
}
