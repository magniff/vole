// The std2 item(s): std::random Xoshiro256pp, Xoshiro256pp::seed_from_u64, from_state, state,
// from_entropy, next_u64, next_u32, random_range_u64, random_range_i64, random_range_usize,
// below_u64, unit_f64, random_bool, fill_bytes, jump; splitmix64_next, shuffle, fill_bytes_os.
// The values are MVS's std::random's on the same seeds (rand_xoshiro's).
// RUSTC: none (std::random is vole's: Rust's std has no generator)
// EXPECT: 7191089600892374487 11400714819323198492
// EXPECT: 15021278609987233951 5881210131331364753 4225793275
// EXPECT: 17 2 588098470
// EXPECT: 0.1253524420627421 false
// EXPECT: [199, 204, 149, 240, 218, 243, 44, 53, 212, 160, 180, 25, 50]
// EXPECT: [3, 7, 4, 2, 1, 8, 6, 5]
// EXPECT: 7205810220806046474
// EXPECT: true true
// EXPECT: 41943041 [7, 0, 262146, 211106232532992]
// EXPECT: true true 3
use std::random::{Xoshiro256pp, fill_bytes_os, shuffle, splitmix64_next};

fn main() {
    let mut st: u64 = 7;
    println("{} {}", splitmix64_next(&mut st), st);
    let mut r = Xoshiro256pp::seed_from_u64(42);
    println("{} {} {}", r.next_u64(), r.next_u64(), r.next_u32());
    println("{} {} {}", r.random_range_u64(10, 20), r.random_range_i64(-5, 5),
        r.below_u64(1000000007));
    println("{} {}", r.unit_f64(), r.random_bool(0.5));
    let mut b: [u8; 13] = [0; 13];
    r.fill_bytes(&mut b);
    println("{:?}", b);
    let mut v = [1, 2, 3, 4, 5, 6, 7, 8];
    shuffle(&mut v, &mut r);
    println("{:?}", v);
    r.jump();
    println("{}", r.next_u64());
    let mut z = Xoshiro256pp::from_state([0, 0, 0, 0]);
    let mut w = Xoshiro256pp::seed_from_u64(0);
    println("{} {}", z.next_u64() == w.next_u64(), z == w);
    let mut s = Xoshiro256pp::from_state([1, 2, 3, 4]);
    println("{} {:?}", s.next_u64(), s.state());
    let mut e = Xoshiro256pp::from_entropy();
    let x = e.next_u64();
    let mut big: [u8; 600] = [0; 600];
    println("{} {} {}", fill_bytes_os(&mut big), x == x, r.random_range_usize(3, 4));
}
