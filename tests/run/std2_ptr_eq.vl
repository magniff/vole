// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ptr eq.
// EXPECT: true false
use std::ptr;
use std::ptr::NonNull;

fn main() {
    let a = 1i64;
    let b = 1i64;
    let pa = &a as *const i64;
    println("{} {}", ptr::eq(pa, &a as *const i64), ptr::eq(pa, &b as *const i64));
}
