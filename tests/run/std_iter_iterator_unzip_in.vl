// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::unzip_in.
// EXPECT: [1, 2] ['a', 'b']

fn main(gpa: Gpa) {
    let v = Vec::from_in([(1i64, 'a'), (2, 'b')], gpa);
    let (a, b): (Vec<i64, Gpa>, Vec<char, Gpa>) = v.iter().copied().unzip_in(gpa);
    println("{:?} {:?}", a, b);
}
