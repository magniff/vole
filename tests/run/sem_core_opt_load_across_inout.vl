// EDITION: rust
// A value read before an inout call is re-read after it.
// EXPECT: 1 2 1 2 1 42 2 7 2 50
static mut Z: i64 = 0;

#[inline(never)]
fn bump(v: &mut Vec<i64, Gpa>) { v[0] += 1; v.push(9); }
#[inline(never)]
fn set(x: &mut i64) { *x = 42; }
#[derive(Clone, Copy)] struct P { a: i64, b: i64 }
#[inline(never)]
fn setb(p: &mut P) { p.b = 7; }

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1 + unsafe { Z });
    let a = v[0];
    let l1 = v.len();
    bump(&mut v);
    let b = v[0];
    let l2 = v.len();
    let mut x = 1 + unsafe { Z };
    let x1 = x;
    set(&mut x);
    let mut p = P { a: 1, b: 2 };
    let pb = p.b;
    setb(&mut p);
    let mut arr = [1i64, 2, 3];
    let s = arr[1];
    let r = &mut arr;
    r[1] = 50;
    println("{a} {b} {l1} {l2} {x1} {x} {pb} {} {s} {}", p.b, arr[1]);
    0
}
