// RULE: E1.8 (0.30.1) A borrow of a proven local that goes only to
// callees that make no raw pointer of a reference keeps the proof: a
// counted loop that reads its counter through a helper, a guarded
// divisor compared and shown through one. (err_effect_address_escapes is
// what does not.)
// EXPECT: 5 3

fn peek(r: &i64) -> i64 {
    *r
}

fn same(a: &u64, b: &u64) -> bool {
    *a == *b
}

#[effects()]
fn count(n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut s: i64 = 0;
    while i < n {
        s = peek(&i);
        i += 1;
    }
    s + 1
}

#[no_panic]
fn ratio(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        if same(&d, &x) {
            return 1;
        }
        x / d
    } else {
        0
    }
}

fn main() {
    println("{} {}", count(5), ratio(9, 3));
}
