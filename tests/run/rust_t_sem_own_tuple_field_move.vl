// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_tuple_field_move.vl to Rust's spelling.
// sem-own: t.1 moved out of a tuple: t.0 dropped at scope end, t.1 by its taker.
// EXPECT: eat 2
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 1
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn main(gpa: Gpa) {
    let t = (mk(1, gpa), mk(2, gpa));
    eat(t.1);
    println("end");
}
