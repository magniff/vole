// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::impl IntoIterator; std::collections::hash_map &HashMap::impl IntoIterator.
// EXPECT: [(1, 10), (2, 20)]
// EXPECT: 30
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(2, 20);
    m.insert(1, 10);
    let mut sum = 0i64;
    for (_, x) in &m {
        sum += *x;
    }
    let mut v: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    for (k, x) in m {
        v.push((k, x));
    }
    v.sort();
    println("{:?}", v);
    println("{}", sum);
}
