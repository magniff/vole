// 0.25.3: a view through a cast (gpu::f32s, bytes viewed as f32s,
// #[views(b)]) keeps its loan on what it views, also through a function
// of the program's own with no #[views] (inferred views(v)): growing the
// Vec under it is own.conflict, as for a view of its own element type.
// ERROR: 'bytes.push(1)' may change 'bytes' while 'f'
// ERROR: 'bytes.push(2)' may change 'bytes' while 'g'
// ERROR-COUNT: 2
use std::gpu;

fn floats(v: inout Vec<u8>) -> [f32] {
    gpu::f32s(v.as_slice())
}

fn main(gpa: Gpa) {
    var bytes: Vec<u8> = Vec::filled_in(16, 0u8, gpa);
    let f = gpu::f32s(bytes.as_slice());
    bytes.push(1);
    println(f"{f[0]}");
    let g = floats(&bytes);
    bytes.push(2);
    println(f"{g[0]}");
}
