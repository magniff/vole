use std::gpu;

fn floats(v: &mut Vec<u8, Gpa>) -> &[f32] {
    gpu::f32s(v.as_slice())
}

fn main(gpa: Gpa) {
    let mut bytes: Vec<u8, Gpa> = Vec::from_elem_in(0u8, 16usize, gpa);
    let f = gpu::f32s(bytes.as_slice());
    bytes.push(1u8);
    println("{}", f[0]);
    let g = floats(&mut bytes);
    bytes.push(2u8);
    println("{}", g[0]);
}
