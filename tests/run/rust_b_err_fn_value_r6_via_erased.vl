// RULE: R6
// (0.30.2) A `fn` value's result borrows from every argument (its type's
// lifetimes are erased, R6), so `via`'s parameter `g`, given for scan's
// `F: FnMut(&mut St, Self::Item) -> Option<B>`, is refused though its
// type names the item's lifetime and its caller gives `sc`, whose result
// borrows only the item: the call's own region (the state's `&mut`) would
// reach B (borrowck.fn_value_bound). rustc keeps the elided `&mut`'s
// region apart in g's type and builds it (L13).
// RUSTC: accepts L13 a `fn` value's erased lifetimes are one region: its result borrows the scan state too
// ERROR: error[borrowck.fn_value_bound]
// ERROR: line 19, column 25
// ERROR-COUNT: 1
fn sc<'a>(s: &mut i64, x: &'a i64) -> Option<&'a i64> {
    *s += 1;
    Some(x)
}

fn via<'b>(w: &'b Vec<i64, Gpa>, g: fn(&mut i64, &'b i64) -> Option<&'b i64>) -> usize {
    w.iter().scan(0i64, g).count()
}

fn main(gpa: Gpa) {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    println("{}", via(&w, sc));
}
