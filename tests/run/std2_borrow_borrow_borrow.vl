// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::borrow Borrow::borrow.
// EXPECT: 9
use std::borrow::Borrow;

struct W {
    v: i64,
}

impl Borrow<i64> for W {
    fn borrow(&self) -> &i64 {
        &self.v
    }
}

fn main() {
    let w = W { v: 9 };
    let r: &i64 = w.borrow();
    println("{}", r);
}
