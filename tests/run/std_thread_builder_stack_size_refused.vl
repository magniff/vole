// The std item(s): std::thread Builder::spawn_in, Builder::stack_size
// (0.30.1): a stack no memory can hold makes no thread: an Err, and the
// closure is dropped, not run; a small size is rounded up, and runs.
// EXPECT: dropped
// EXPECT: refused: true
// EXPECT: small: 3
use std::thread;

struct Noisy {
    n: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        if self.n == 1 {
            println("dropped");
        }
    }
}

fn main(gpa: Gpa) {
    let x = Noisy { n: 1 };
    let r = thread::Builder::new().stack_size(1 << 62).spawn_in(move || {
        println("ran {}", x.n);
        0i64
    }, gpa);
    println("refused: {}", r.is_err());
    let h = thread::Builder::new().stack_size(1).spawn_in(move || 3i64, gpa).unwrap();
    println("small: {}", h.join().unwrap());
}
