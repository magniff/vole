// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash FoldHasher::impl Hasher.
// EXPECT: 12637988351518856153
// EXPECT: 11372875485421594496
// RUSTC: none (FoldHasher is foldhash's (the foldhash crate's, 0.2, gives these values); Rust's std has no foldhash)
use std::hash::{BuildHasher, FixedState, FoldHasher, FoldSeeds, Hash, Hasher};

fn main() {
    let mut h = FixedState::new().build_hasher();
    h.write("0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz0123456789abcdefghijklmnopqrstuvwxyz".as_bytes());
    println("{}", h.finish());
    let mut g = FixedState::new().build_hasher();
    5u64.hash(&mut g);
    println("{}", g.finish());
}
