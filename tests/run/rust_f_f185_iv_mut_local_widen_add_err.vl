// RULE: F18.5
// (0.30.1, F29.3; 0.30.2) As rust_f_f185_iv_mut_local_widen_err, with
// `a = a + 1`: not widened (rustc E0308).
// ERROR: this 'i32' is not widened to 'i64' implicitly
fn take32(x: i32) -> i32 { x }

fn main() {
    let mut a = 1;
    take32(a);
    a = a + 1;
    let b: i64 = a;
    println("{}", b);
}
