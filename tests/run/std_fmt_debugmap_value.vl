// Runs on std since 0.27.2's switch.
// The std item(s): std::fmt DebugMap::value.
// EXPECT: {"a": 1}
// EXPECT: {
// EXPECT:     "a": 1,
// EXPECT: }
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_map().key(&"a").value(&self.a).finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
