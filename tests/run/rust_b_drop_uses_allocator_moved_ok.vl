// RULE: D9.1
// (0.30.1, RT-M2-14) A container whose drop uses the arena no longer
// keeps it borrowed once it is gone before the reset: moved into a
// function that drops it, or forgotten (`mem::forget`: its drop never
// runs). rustc accepts both.
// EXPECT: 2
// EXPECT: 3
// EXPECT: done
use std::alloc::Arena;

fn consume(v: Vec<Box<i64, Gpa>, &Arena<Gpa>>) -> usize {
    v.len()
}

fn main(gpa: Gpa) {
    let mut ar = Arena::new_in(gpa);
    let mut a: Vec<Box<i64, Gpa>, &Arena<Gpa>> = Vec::new_in(&ar);
    a.push(Box::new_in(1, gpa));
    a.push(Box::new_in(2, gpa));
    println("{}", consume(a));
    ar.reset();
    let mut b: Vec<i64, &Arena<Gpa>> = Vec::new_in(&ar);
    b.push(1);
    b.push(2);
    b.push(3);
    println("{}", b.len());
    std::mem::forget(b);
    ar.reset();
    println("done");
}
