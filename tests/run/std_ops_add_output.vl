// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Add::Output.
// EXPECT: V { x: 17 }
use std::ops::Add;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Add for V {
    type Output = V;

    fn add(self, rhs: V) -> V {
        V { x: self.x + rhs.x }
    }
}

fn apply<T: Add<Output = T>>(a: T, b: T) -> T {
    a + b
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    let c: <V as Add>::Output = apply(a, b);
    println("{:?}", c);
}
