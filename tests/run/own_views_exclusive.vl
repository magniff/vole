// 0.17 (value semantics, T2): views and exclusivity that check clean.
// EXPECT: 3 4 7
// EXPECT: 10 2
// EXPECT: 11
#[derive(Clone, Copy)] struct Stack { items: [i64; 8], n: i64 }

impl Stack {
    fn len(self) -> i64 { self.n }
    fn push(&mut self, x: i64) { self.items[self.n as usize] = x; self.n += 1; }
    fn top(self) -> i64 { self.items[(self.n - 1) as usize] }
}

#[derive(Clone, Copy)] struct Pair { x: i64, y: i64 }

fn bump(p: &mut i64) { *p += 1; }
fn add(to: &mut i64, from: i64) { *to += from; }
fn fill(s: &mut Stack, n: i64) { for i in 0..n { s.push(i); } }

fn main() {
    // two-phase receivers: the receiver is read by its own arguments
    let mut s = Stack { items: [0i64; 8], n: 0 };
    { let at_arg1 = s.len(); s.push(at_arg1) };
    { let at_arg1 = s.len() + 1; s.push(at_arg1) };
    { let at_arg1 = s.top() + 5; s.push(at_arg1) };
    // a `&mut` local passed to several calls: implicit reborrows
    let mut a: i64 = 1;
    let r = &mut a;
    bump(r);
    bump(r);
    // disjoint fields
    let mut p = Pair { x: 3, y: 4 };
    add(&mut p.x, p.y);
    println("{} {} {}", s.top() - 4, a + 1, p.x);
    // a plain read of a place an earlier `&mut` argument borrows
    let mut t = Stack { items: [0i64; 8], n: 0 };
    { let at_arg1 = t.n + 5; fill(&mut t, at_arg1) };
    let q = &mut t;
    q.push(10);
    println("{} {}", q.top(), t.n - 4);
    // a reborrow written through, then its parent used
    let mut arr = [1i64, 2, 3];
    let whole = &mut arr[..];
    let part = &mut whole[1..];
    part[0] = 10;
    println("{}", whole[0] + whole[1]);
}
