// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: one past the end: 4
// STDERR: unsafe access out of bounds (just past the end): 8 bytes at offset 32 of a block of 32 bytes
// STDERR: check_unsafe_gpa_one_past.vl: line 31, column 22
// 0.30.1: an address one past a block's end is made (std's ptr::add,
// `&p[len]`: Rust's add allows it) and compared, not reported; reading
// through it is. (0.30.0 counted the address as an access of the element
// there: NonNull::add's `&self.pointer[count]`.)
fn main(gpa: Gpa) {
    let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);
    for i in 0..4 {
        v.push(i);
    }
    let p: *const u64 = v.as_ptr();
    // UNSAFE: an address one past the block's end, and a walk to it.
    // SAFETY: every read is below the end, which is only compared.
    let n = unsafe {
        let end = p.add(v.capacity());
        let mut q = p;
        let mut n = 0;
        while q != end {
            n += 1;
            q = q.add(1);
        }
        n
    };
    println("one past the end: {n}");
    // UNSAFE: a deliberate read at the end, to test --check-unsafe.
    // SAFETY: none: this program exists to be stopped.
    let x = unsafe { *p.add(v.capacity()) };
    println("read {x}");
}
