// a struct holding a raw pointer shared by let with scoped threads: sync.not_sync
// ERROR: error[sync.not_send]
// ERROR: line 11, column 9
use std::thread;
#[derive(Clone, Copy)] struct P { p: *mut i64 }

fn main() {
    let mut k: i64 = 1;
    let w = P { p: &mut k as *mut i64 };
    thread::scope(|s| ({ let s = s; {
        s.spawn(|| { let q = w.p; 0 });
        0
    } }));
    println("ok");
}
