// EDITION: rust
// RULE: D6.2.1
// (0.27.1) A reborrow of a field through `&'a mut S` returned as `&'static
// mut`.
// ERROR: error[borrowck.outlives]
// ERROR: line 16, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

fn f<'a>(s: &'a mut S) -> &'static mut i64 {
    &mut s.x
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = f(&mut s);
    *r += 5;
}
