// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Allocator::grow_zeroed.
// EXPECT: 7 0
use std::alloc::{Allocator, Layout};

fn main(gpa: Gpa) {
    let a = Layout::new::<u64>();
    let b = Layout::array::<u64>(2).unwrap();
    let p = gpa.allocate(a).unwrap();
    // UNSAFE: the block is written, grown, read and given back.
    // SAFETY: p is gpa's with layout a; q with layout b.
    unsafe {
        *(p.as_ptr() as *mut u64) = 7;
        let q = gpa.grow_zeroed(p, a, b).unwrap();
        let r = q.as_ptr() as *mut u64;
        println("{} {}", *r.add(0), *r.add(1));
        gpa.deallocate(q, b);
    }
}
