// EDITION: rust
// RULE: D8.3
// (0.27.1) The rust edition's operands (places/build.vl): a value moves
// unless its type is Copy (`#[derive(Copy)]`, `impl Copy`, scalars), glue
// or not; a place moved into a call is a statement of its own at the
// argument; a `&mut` given to a call is reborrowed (`&mut2 (*r)`, `&(*r)`
// for a `&T` parameter, D3.6); a `for` loop over a `&mut` moves it; a
// match with a guard fake-borrows its scrutinee and the places its
// patterns test, mentioned at each arm (D2.6), and a `ref mut` binding is
// a shared borrow in the guard.
// PLACES: fn eat
// PLACES: fn twice
// PLACES: mut2 (*_1)
// PLACES: call bump(move
// PLACES: = &'r
// PLACES: call peek(move
// PLACES: fn sum
// PLACES: = move _1
// PLACES: fn pick
// PLACES: fake _2
// PLACES: fake _2.0
// PLACES: mention
// PLACES: fn guard_ref
// PLACES: fake _2
// PLACES: = &'r6 (_2 as Some).0
// PLACES: mention _3
// PLACES: mut (_2 as Some).0
// PLACES: fn main
// PLACES: = copy _1
// PLACES: = copy _3
// PLACES: = move _5
// PLACES: = move _6
// PLACES: call eat(move
// EXPECT: 4 3 1 2 3
// EXPECT: 9
// EXPECT: 3
// EXPECT: 4
#[derive(Clone, Copy)]
struct P {
    x: i64,
}

struct Q {
    x: i64,
}

impl Clone for Q {
    fn clone(&self) -> Q {
        Q { x: self.x }
    }
}

impl Copy for Q {}

struct N {
    v: i64,
}

fn eat(n: N) -> i64 {
    n.v
}

fn bump(n: &mut N) {
    n.v += 1;
}

fn peek(n: &N) -> i64 {
    n.v
}

fn twice(n: &mut N) -> i64 {
    bump(n);
    bump(n);
    peek(n)
}

fn sum(s: &mut [i64]) -> i64 {
    let mut t = 0;
    for x in s {
        *x += 1;
        t += *x;
    }
    t
}

fn pick(x: (i64, i64)) -> i64 {
    let y = x;
    match y {
        (1, b) if b > 0 => b,
        (_, b) => b + 1,
    }
}

fn guard_ref(o: Option<i64>) -> i64 {
    let mut p = o;
    match p {
        Some(ref mut v) if *v > 2 => {
            *v += 1;
            *v
        }
        Some(_) => 2,
        None => 3,
    }
}

fn main() {
    let p = P { x: 1 };
    let p2 = p;
    let q = Q { x: 2 };
    let q2 = q;
    let n = N { v: 3 };
    let m = n;
    let mut k = N { v: 2 };
    println("{} {} {} {} {}", twice(&mut k), eat(m), p.x + p2.x - 1, q.x + q2.x - 2, k.v - 1);
    let mut a = [1, 2, 3];
    println("{}", sum(&mut a));
    println("{}", pick((1, 3)));
    println("{}", guard_ref(Some(3)));
}
