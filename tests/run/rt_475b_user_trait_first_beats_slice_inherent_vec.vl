// XFAIL: RT-475b: (RT-475's mechanism, first, and a Vec) with `impl L for [i64] { fn first(&self) -> Option<&i64> { None } }`, `s.first()` of an `s: &[i64]` and `v.first()` of a Vec<i64> (through its deref to [i64]) run L's: vole prints `None None`, rustc `Some(1) Some(1)` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p07g_vec_slice_user_trait_other_name.
// EXPECT: Some(1) Some(1)
trait L {
    fn first(&self) -> Option<&i64>;
}

impl L for [i64] {
    fn first(&self) -> Option<&i64> {
        None
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s: &[i64] = &v;
    println("{:?} {:?}", s.first(), v.first());
    0
}
