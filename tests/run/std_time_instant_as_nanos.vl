// (0.28.0) Instant::as_nanos, vole's own: the monotonic clock's reading in
// nanoseconds. Two readings do not go back, and their difference is the
// Duration between them.
// EXPECT: true true true

use std::time::Instant;

fn main() {
    let a = Instant::now();
    let b = Instant::now();
    let d = b.duration_since(a);
    let diff: u64 = b.as_nanos() - a.as_nanos();
    println("{} {} {}", b.as_nanos() >= a.as_nanos(), a.as_nanos() > 0,
        diff == d.as_secs() * 1000000000 + d.subsec_nanos() as u64);
}
