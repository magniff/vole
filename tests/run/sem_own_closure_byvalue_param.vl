// sem-own: (0.25.3) a closure's parameter annotated `sink` takes its argument
// (the call moves it) and drops it at the end of the closure's body.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: end
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }

fn main(gpa: Gpa) {
    let f = |d: sink D| println(f"got {d.id}");
    let x = mk(1, gpa);
    f(x);
    println("end");
}
