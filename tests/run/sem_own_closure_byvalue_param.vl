// XFAIL: gap 7: compile parser error: expected '|', got 'D'
// sem-own: (0.25.3) a closure's parameter annotated `sink` takes its argument
// (the call moves it) and drops it at the end of the closure's body.
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let f = |d: sink D<Gpa>| println("got {}", d.id);
    let x = mk(1, gpa);
    f(x);
    println("end");
}
