// (0.27.1) Storing `&'b i64` into `&mut H<'a>` with no relation between `'a`
// and `'b`.
// ERROR: :14:5: error[borrowck.outlives]
// ERROR-COUNT: 1
// XFAIL: bc271 M2: loans, accesses and region errors are not checked yet

struct H<'a> {
    r: &'a i64,
}

fn set<'a, 'b>(h: &mut H<'a>, x: &'b i64) {
    h.r = x;
}

fn main() {
    let x: i64 = 1;
    let y: i64 = 2;
    let mut h = H { r: &x };
    set(&mut h, &y);
    println("{}", *h.r);
}
