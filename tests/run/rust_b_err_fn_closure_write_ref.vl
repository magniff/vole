// RULE: D19.2
// (0.30.1, RT-36) An `Fn` closure (its bound `F: Fn()` fixes the kind)
// that writes through a capture: `*r += 1` of a captured `r: &mut i64` (E0594). Its env is behind its `&`, so the
// place is not mutable (places/borrowck/moves.vl immutable_why). Before,
// the closure's part of the path counted as mutable, and two threads given
// `&F` with `F: Fn() + Sync` raced.
// ERROR: error[borrowck.assign_immutable]: cannot assign to '*r', as it is a captured variable in a `Fn` closure
// ERROR: line 21, column 13
// ERROR-COUNT: 1
fn h(x: &mut i64) {
    *x += 1;
}

fn call<F: Fn()>(f: F) {
    f();
}

fn main() {
    let mut x = 1i64;
    let r = &mut x;
    call(|| *r += 1);
}
