// EDITION: rust
// XFAIL: gap 17: compile type error: the trait 'Write' is not implemented for '*String<Gpa>'
// (0.17) An f-string passed straight to print, println, eprint, eprintln,
// format_in or Buf::push_fmt is written in place (front/check/interp.vl,
// direct_call): its holes are evaluated once, left to right, where the
// call is (push_fmt's receiver first, format_in's allocator last), then
// the Fmt calls run; push_fmt and format_in run the writes again when the
// text did not fit, with the holes' values kept. fmt_direct_o0 is this
// program at -O0.
// EXPECT: [1] n=7 x=ff b=101 |  ab|ab  | -42|0042|3.14|[u8]="q\"t"|p=(3, 4)|q=(5, 6)|c=Z
// EXPECT: raw (5, 6) Point { x: 5, y: 6 }
// EXPECT: [2] plain
// EXPECT: log 34 count 0 log 1234
// EXPECT: push: 12345678901234567890123456789012345678901234567890-r7-8-9-(3, 4)-end
// EXPECT: displays 2
// EXPECT: log 6789 after push, len 74
// EXPECT: big 300 xxxxx...yyyyy log 1011
// EXPECT: small [13|14] len 7 log 1314
// EXPECT: nested <a5b>
// EXPECT: wide [         7]
// EXPECT: printed no newline
// STDERR: [e] 15 err
// STDERR: [e2] Some(16)
use std::fmt::Debug; use std::fmt::Display; use std::fmt::Formatter as Fmt;

static mut LOG: i64 = 0;
static mut COUNT: i64 = 0;

// k, noted in LOG (its digits appended): the order the holes ran in.
fn note(k: i64) -> i64 {
    unsafe {
        LOG = if k >= 10 { LOG * 100 + k } else { LOG * 10 + k };
    }
    k
}

fn take_log() -> i64 {
    unsafe {
        let l = LOG;
        LOG = 0;
        l
    }
}

#[derive(Debug, Clone, Copy)]
struct Point { x: i64, y: i64 }

impl Display for Point {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        unsafe {
            COUNT += 1;
        }
        f.write_str("(")?;
        write(f, "{}", self.x)?;
        f.write_str(", ")?;
        write(f, "{}", self.y)?;
        f.write_str(")")?;
        Ok(()) }
}

fn pick(b: &mut String<Gpa>) -> *mut String<Gpa> {
    note(6);
    b
}

fn main(gpa: Gpa) {
    let n: i64 = 7;
    let s: &[u8] = b"q\"t";
    let p = Point { x: 3, y: 4 };
    let mut q = Point { x: 5, y: 6 };
    let pp: *mut Point = &mut q;
    let c: u8 = b'Z';
    let ab: &[u8] = b"ab";
    let ten: &[u8] = b"1234567890";
    println(
        "[{}] n={n} x={:x} b={:b} |{ab:>4}|{ab:<4}|{:>4}|{:04}|{:.2}|[u8]={s:?}|p={p}|q={q}|c={c_c}", note(1), 255, 5, -42, 42, 3.14159, ab = str::from_utf8(ab).unwrap(), c_c = c as char);
    unsafe {
        println("raw {pp} {pp:?}");
    }
    println("[{}] plain", note(2));
    unsafe {
        COUNT = 0;
    }
    print("log {}{}", note(3), note(4));
    unsafe {
        println(" count {COUNT} log {}", take_log());
    }
    // push_fmt into a Buf with no room: the writes run twice, the holes once.
    let mut b: String<Gpa> = String::new_in(gpa);
    std::fmt::write(&mut b, "push: ").unwrap();
    unsafe {
        COUNT = 0;
        { let ten = str::from_utf8(ten).unwrap();
            std::fmt::write(&mut pick(&mut b), "{ten:<10}{ten}{ten}{ten}{ten}-r{}-{}-{}-{p}-end",
                note(7), note(8), note(9)).unwrap() };
        println("{}", str::from_utf8(b.as_bytes()).unwrap());
        println("displays {COUNT}");
    }
    println("log {} after push, len {}", take_log(), b.len());
    b.clear();
    // format_in over 256 bytes: from the stack buffer to the Buf's room.
    let mut long: Vec<u8, Gpa> = Vec::<u8, Gpa>::new_in(gpa);
    for i in 0..150 {
        long.push(if i < 75 { b'x' } else { b'y' });
    }
    let mut t = format_in("{}{}{}{}", str::from_utf8(long.as_slice()).unwrap(), note(10),
        str::from_utf8(long.as_slice()).unwrap(), note(11), gpa);
    let ts = t.as_bytes();
    println("big {} {}...{} log {}", ts.len() - 4, &str::from_utf8(ts[0..5]).unwrap(),
        &str::from_utf8(ts[ts.len() - 9..ts.len() - 4]).unwrap(), take_log());
    let mut u = format_in("[{}|{}]", note(13), note(14), gpa);
    println("small {} len {} log {}", str::from_utf8(u.as_bytes()).unwrap(), u.len(), take_log());
    let mut inner = format_in("a{}b", note(5), gpa);
    println("nested <{}>", str::from_utf8(inner.as_bytes()).unwrap());
    inner.clear();
    take_log();
    println("wide [{n:>10}]");
    eprint("[e] {}", note(15));
    eprintln(" err");
    let o: Option<i64> = Some(16i64);
    eprintln("[e2] {o:?}");
    print("printed no newline");
    println("");
    t.clear();
    u.clear();
    drop(long);
}
