// (0.26.3, decision 6) + - *, unary - and the shifts wrap at -O0 with
// --overflow-checks=off: each integer type's MAX + 1, MIN - 1, MAX * MAX,
// -MIN, and shifts by more than the bits, masked (Rust's release arithmetic,
// its wrapping_*).
// FLAGS: -O0 --overflow-checks=off
// EXPECT: i8 -128 127 1 -128 -8 15
// EXPECT: i16 -32768 32767 1 -32768 -8 4095
// EXPECT: i32 -2147483648 2147483647 1 -2147483648 -8 268435455
// EXPECT: i64 -9223372036854775808 9223372036854775807 1 -9223372036854775808 -8 1152921504606846975
// EXPECT: u8 0 255 1 255 248 31
// EXPECT: u16 0 65535 1 65535 65528 8191
// EXPECT: u32 0 4294967295 1 4294967295 4294967288 536870911
// EXPECT: u64 0 18446744073709551615 1 18446744073709551615 18446744073709551608 2305843009213693951
// EXPECT: usize 0 18446744073709551615 1 18446744073709551615 18446744073709551608 2305843009213693951

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: i8 = id(127) as i8;
    let c: i8 = id(-128) as i8;
    let one: i8 = id(1) as i8;
    let s: u32 = id(11) as u32;
    println("i8 {} {} {} {} {} {}", a + one, c - one, a * a, -c, a << s, a >> s);
    let a: i16 = id(32767) as i16;
    let c: i16 = id(-32768) as i16;
    let one: i16 = id(1) as i16;
    let s: u32 = id(19) as u32;
    println("i16 {} {} {} {} {} {}", a + one, c - one, a * a, -c, a << s, a >> s);
    let a: i32 = id(2147483647) as i32;
    let c: i32 = id(-2147483648) as i32;
    let one: i32 = id(1) as i32;
    let s: u32 = id(35) as u32;
    println("i32 {} {} {} {} {} {}", a + one, c - one, a * a, -c, a << s, a >> s);
    let a: i64 = id(9223372036854775807) as i64;
    let c: i64 = id(-9223372036854775808) as i64;
    let one: i64 = id(1) as i64;
    let s: u32 = id(67) as u32;
    println("i64 {} {} {} {} {} {}", a + one, c - one, a * a, -c, a << s, a >> s);
    let a: u8 = idu(255) as u8;
    let c: u8 = idu(0) as u8;
    let one: u8 = idu(1) as u8;
    let s: u32 = idu(11) as u32;
    println("u8 {} {} {} {} {} {}", a + one, c - one, a * a, c - one, a << s, a >> s);
    let a: u16 = idu(65535) as u16;
    let c: u16 = idu(0) as u16;
    let one: u16 = idu(1) as u16;
    let s: u32 = idu(19) as u32;
    println("u16 {} {} {} {} {} {}", a + one, c - one, a * a, c - one, a << s, a >> s);
    let a: u32 = idu(4294967295) as u32;
    let c: u32 = idu(0) as u32;
    let one: u32 = idu(1) as u32;
    let s: u32 = idu(35) as u32;
    println("u32 {} {} {} {} {} {}", a + one, c - one, a * a, c - one, a << s, a >> s);
    let a: u64 = idu(18446744073709551615) as u64;
    let c: u64 = idu(0) as u64;
    let one: u64 = idu(1) as u64;
    let s: u32 = idu(67) as u32;
    println("u64 {} {} {} {} {} {}", a + one, c - one, a * a, c - one, a << s, a >> s);
    let a: usize = idu(18446744073709551615) as usize;
    let c: usize = idu(0) as usize;
    let one: usize = idu(1) as usize;
    let s: u32 = idu(67) as u32;
    println("usize {} {} {} {} {} {}", a + one, c - one, a * a, c - one, a << s, a >> s);
}
