// RULE: D2.7
// (0.30.1) A capture by value of a capture by value of a `let x` (not
// `mut`): `&mut x` in the inner move closure is rustc's E0596.
// ERROR: error[borrowck.borrow_immutable]
// ERROR: line 11, column 21
// ERROR-COUNT: 1
fn a() -> i64 {
    let x = 1i64;
    let f = move || {
        let mut g = move || {
            let r = &mut x;
            *r += 1;
            *r
        };
        g()
    };
    f()
}

fn main() {
    println("{}", a());
}
