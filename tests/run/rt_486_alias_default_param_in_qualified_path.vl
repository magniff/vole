// XFAIL: RT-486: `<A as Tr>::f()` with `type A<T = i64> = W<T>;` is refused, "type alias 'A' is generic: write its type arguments": the alias's default is not applied; rustc prints 2 (0.30.2)
// From the third re-review of the qualified-path work (g302qual). Since v0.30.1 at least.
// From the review's form c2/o08_alias_default. Writing `<A<i64> as Tr>`
// is a parser error on the release build (RT-154's family).
// EXPECT: 2
trait Tr {
    const C: i64;
    type Out;
    fn f() -> i64;
}

struct W<T> {
    t: T,
}

impl<T> Tr for W<T> {
    const C: i64 = 1;
    type Out = i64;

    fn f() -> i64 {
        2
    }
}

impl<T> W<T> {
    fn mk() -> i64 {
        3
    }
}

type A<T = i64> = W<T>;

fn main() {
    println("{}", <A as Tr>::f());
}
