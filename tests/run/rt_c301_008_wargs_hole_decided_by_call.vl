// RULE: F8.3, F8.4
// `<S as Conv<_, u8>>::c(true)` and `::c(5i32)` with impls Conv<bool, i64>, Conv<bool, u8> and Conv<i32, u8>: the impls alone do not fill the `_`, so the call's arguments choose among the impls that agree with the written `u8` (convert::dispatch's wargs: Conv<bool, i64> takes `true` too and is left out by them). rustc 2 3 1.
// From the second round of the qualified paths: the valid form that reaches dispatch's wargs (the re-review's plant 2 failed no case); fails on v0.30.1 ("ambiguous").
// EXPECT: 2 3 1
trait Conv<A, B> {
    fn c(x: A) -> i64;
}

struct S;

impl Conv<bool, i64> for S {
    fn c(x: bool) -> i64 {
        1
    }
}

impl Conv<bool, u8> for S {
    fn c(x: bool) -> i64 {
        2
    }
}

impl Conv<i32, u8> for S {
    fn c(x: i32) -> i64 {
        3
    }
}

fn main() {
    println("{} {} {}", <S as Conv<_, u8>>::c(true), <S as Conv<_, u8>>::c(5i32),
        <S as Conv<_, i64>>::c(false));
}
