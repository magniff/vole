// XFAIL: RT-220: a `let`-else whose pattern binds by `ref` does not extend its scrutinee temporary: `let Some(ref a) = pick(1) else { return; };` is refused (borrowck.dropped_borrowed); rustc accepts (0.30.2)
// The same pattern without `else` passes. The ref-mut, tuple and struct
// forms are the same mechanism. Since v0.30.1 at least. From the review of
// the temporary-scope work.
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: 2
// EXPECT: drop 2
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn mk(n: i64) -> D {
    D { n: n }
}

fn pick(n: i64) -> Option<D> {
    if n > 0 { Some(mk(n)) } else { None }
}

fn main() {
    let Some(ref a) = pick(1) else { return; };
    println("{}", a.n);
    f2();
}

fn f2() {
    let Some(ref mut b) = pick(2) else { return; };
    println("{}", b.n);
}
