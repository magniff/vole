// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c22_fstring_panic)
// RUSTC: none contract clauses are not Rust
// EXPECT: 5
// A requires reading a by-value param only inside a panic f-string (implicit capture).
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N, k: i64) -> i64
    requires {
    if k < 0 {
        panic("bad {k}");
    }
    true
}

{
    take(s) + k
}

fn main() {
    println("{}", f(N { v: 4 }, 1));
}
