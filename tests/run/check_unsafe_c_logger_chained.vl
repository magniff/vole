// FLAGS: --check-unsafe
// REQUIRES: macos
// EXPECT: its own hook saw 1000 frees or more: true
// 0.30.1: a program's own malloc_logger, set before its first malloc,
// keeps running under --check-unsafe: the check calls the logger that was
// there before its own, every time. (Earlier on 0.30.1's branch the
// check's replaced it, and it ran once.)
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn free(p: *mut u8);
    fn strdup(s: *const u8) -> *mut u8;
    static mut malloc_logger: extern "C" fn(u32, u64, u64, u64, u64, u32);
}

static mut FREES: u64 = 0;

extern "C" fn counted(kind: u32, _a: u64, _b: u64, _c: u64, _r: u64, _f: u32) {
    // UNSAFE: a counter of the program's.
    // SAFETY: one thread; libmalloc calls the logger on it.
    unsafe {
        if kind & 4 != 0 {
            FREES += 1;
        }
    }
}

fn main() {
    // UNSAFE: C's allocator and its logger.
    // SAFETY: each block written within its 8 bytes and freed once.
    unsafe {
        malloc_logger = counted;
        for i in 0..1000 {
            let p = malloc(8);
            *p = i as u8;
            free(p);
        }
        // (the blocks the check holds are given back to C later: a strdup
        // and free of C's own each time count instead)
        for _ in 0..1000 {
            let s = strdup(c"x" as *const u8);
            free(s);
        }
        println("its own hook saw 1000 frees or more: {}", FREES >= 1000);
    }
}
