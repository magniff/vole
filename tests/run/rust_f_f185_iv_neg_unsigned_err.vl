// RULE: F18.5
// (0.30.2) A negation of an integer variable's value that a later use
// types unsigned is an error at the function's end (rustc E0277/E0600:
// `u32` has no `Neg`).
// ERROR: cannot apply unary operator '-' to type 'u32'
fn main() {
    let a = 5;
    let b = -a;
    let c: u32 = b;
    println("{c}");
}
