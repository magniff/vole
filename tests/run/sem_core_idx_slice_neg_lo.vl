// A negative lo.
// EXIT: 101
// STDERR: slice range out of bounds: 18446744073709551615..2, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let s = &a[(-1 + unsafe { Z }) as usize..2];
    println("{}", s.len());
    println("not reached");
    0
}
