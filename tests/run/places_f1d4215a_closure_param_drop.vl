// places IR, family 1d4215a4: a closure's by-value parameter
// (0.25.3) A closure's by-value parameter (`|d: sink D|`, or an FnMut(sink T)
// bound's) is dropped at the end of its body unless moved out: called
// once, many times, stored and called later, returning it, moving it into
// a capture, passing it on by sink, moved on one path, `|_|`; a let
// parameter borrows (the caller drops it). Leaked before 0.25.3.
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: once 1
// EXPECT: drop 10
// EXPECT: many 10
// EXPECT: drop 11
// EXPECT: many 11
// EXPECT: drop 12
// EXPECT: many 12
// EXPECT: drop 20
// EXPECT: stored 40
// EXPECT: back 30
// EXPECT: kept 2
// EXPECT: eat 50
// EXPECT: drop 50
// EXPECT: drop 60
// EXPECT: eat 61
// EXPECT: drop 61
// EXPECT: drop 70
// EXPECT: us 7
// EXPECT: drop 80
// EXPECT: run 80
// EXPECT: drop 81
// EXPECT: run2 81
// EXPECT: run2v 1
// EXPECT: drop 82
// EXPECT: let 90 90
// EXPECT: end
// EXPECT: drop 90
// EXPECT: drop 40
// EXPECT: drop 41
// EXPECT: drop 30
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn eat
// PLACES: drop(_1) [kept]
// PLACES: fn main
// PLACES: drop(_4) [removed]
// PLACES: drop(_16) [removed]
// PLACES: drop(_25) [removed]
// PLACES: drop(_33) [removed]
// PLACES: drop(_44) [removed]
// PLACES: drop(_46) [removed]
// PLACES: drop(_55) [removed]
// PLACES: drop(_57) [removed]
// PLACES: drop(_58) [removed]
// PLACES: drop(_61) [removed]
// PLACES: drop(_69) [removed]
// PLACES: drop(_77) [removed]
// PLACES: drop(_85) [removed]
// PLACES: drop(_86) [kept]
// PLACES: drop(_94) [kept]
// PLACES: drop(_40) [kept]
// PLACES: drop(_32) [kept]
// PLACES: fn closure(D) -> i64
// PLACES: drop(_1) [kept]
// PLACES: fn closure(D) -> i64
// PLACES: drop(_1) [kept]
// PLACES: fn closure(D) -> D
// PLACES: drop(_1) [removed]
// PLACES: fn closure(D) -> ()
// PLACES: drop(_2) [removed]
// PLACES: fn closure(D) -> ()
// PLACES: drop(_1) [removed]
// PLACES: fn closure(D) -> ()
// PLACES: drop(_1) [flag _4]
// PLACES: fn closure(D) -> i64
// PLACES: drop(_1) [kept]
// PLACES: fn closure(D) -> i64
// PLACES: drop(_1) [kept]
// PLACES: fn run<closure(D) -> i64
// PLACES: drop(_2) [removed]
// PLACES: fn closure(D) -> i64
// PLACES: drop(_1) [kept]
// PLACES: fn run2<D, closure(D) -> i64
// PLACES: drop(_2) [removed]
// PLACES: fn closure(Vec<i64>) -> i64
// PLACES: drop(_1) [kept]
// PLACES: fn run2<Vec<i64>, closure(Vec<i64>) -> i64
// PLACES: drop(_2) [removed]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }
struct Holder<F> { f: F }
fn run<F: FnMut(sink D) -> i64>(f: sink F, d: sink D) -> i64 { f(d) }
fn run2<T, F: FnMut(sink T) -> i64>(f: sink F, d: sink T) -> i64 { f(d) }

fn main(gpa: Gpa) {
    // once
    let f = |d: sink D| d.id;
    println(f"once {f(mk(1, gpa))}");
    // many times
    for i in 10..13 {
        println(f"many {f(mk(i, gpa))}");
    }
    // stored and called later
    let h = Holder { f: |d: sink D| d.id * 2 };
    println(f"stored {(h.f)(mk(20, gpa))}");
    // returns its parameter
    let id = |d: sink D| d;
    let back = id(mk(30, gpa));
    println(f"back {back.id}");
    // moves it into a capture
    var keep: Vec<D> = Vec::new_in(gpa);
    var put = |d: sink D| keep.push(d);
    put(mk(40, gpa));
    put(mk(41, gpa));
    println(f"kept {keep.len()}");
    // passes it on by sink
    let on = |d: sink D| eat(d);
    on(mk(50, gpa));
    // conditionally moved
    let cond = |d: sink D| { if d.id > 60 { eat(d); } };
    cond(mk(60, gpa));
    cond(mk(61, gpa));
    // underscore
    let us = |_: sink D| 7;
    println(f"us {us(mk(70, gpa))}");
    // through bounds
    println(f"run {run(|d| d.id, mk(80, gpa))}");
    println(f"run2 {run2(|d| d.id, mk(81, gpa))}");
    println(f"run2v {run2(|v: sink Vec<i64>| v.len() as i64, mk(82, gpa).v.clone())}");
    // let parameter: borrowed, the caller drops
    let lf = |d: D| d.id;
    let x = mk(90, gpa);
    println(f"let {lf(x)} {lf(x)}");
    println("end");
}
