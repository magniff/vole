// RULE: D2.5
// (0.27.1) A value with drop glue dropped at its scope's end while `&d.v` is
// live.
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 23, column 13
// ERROR-COUNT: 1

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn main() {
    let z: i64 = 0;
    let mut r = &z;
    {
        let d = D { v: 1 };
        r = &d.v;
    }
    println("{}", *r);
}
