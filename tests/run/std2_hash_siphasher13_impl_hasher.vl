// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash SipHasher13::impl Hasher.
// EXPECT: 15794382300316794652 true
// RUSTC: none (SipHasher13 is std2's; its values are Rust's DefaultHasher's (SipHash-1-3, keys 0 and 0))
use std::hash::{Hash, Hasher, SipHashState, SipHasher13};

fn main() {
    let mut a = SipHasher13::new_with_keys(0, 0);
    5u64.hash(&mut a);
    let mut b = SipHasher13::new_with_keys(0, 0);
    b.write_u8(5);
    for _ in 0..7 {
        b.write_u8(0);
    }
    println("{} {}", a.finish(), a.finish() == b.finish());
}
