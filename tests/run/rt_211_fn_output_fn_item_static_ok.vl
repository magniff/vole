// RT-211 review 3, re-review: an fn item with no input region, `fn sev(_x:
// i64) -> &'static i64`, over an owned iterator: B is 'static (an output
// region with no input region is 'static), so the result of `first(..,
// &*k)` outlives k (rustc builds it; the release refused it).
// EXPECT: Some(7)
static SEVEN: i64 = 7;

fn sev(_x: i64) -> &'static i64 {
    &SEVEN
}

struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

struct Own {
    n: i64,
    m: i64,
}

impl Iterator for Own {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.n < self.m {
            self.n += 1;
            Some(self.n)
        } else {
            None
        }
    }
}

fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let r: Option<&i64>;
    {
        let k: Box<i64, Gpa> = Box::new_in(1, gpa);
        r = first(MyMap { i: Own { n: 0, m: 2 }, f: sev }, &*k);
    }
    println("{:?}", r);
}
