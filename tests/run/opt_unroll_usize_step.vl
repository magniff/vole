// (0.26.2) A loop over a slice counts in a usize, and its step, a u64 1,
// sits beside the body's i64 1: the run-time unroller counted the two
// constants twice, the loop came out one instruction over the size for
// four copies and got two (bench/iterloop's filter_map_sum, 1.18x the
// instructions). A constant with the bits of one counted already is
// counted once: four copies, the fourth element at +24.
// EXPECT: 135
// CHECK: fn filter_map_sum:
// CHECK: load
// CHECK: +24
// CHECK: fn main:

#[inline(never)]
fn filter_map_sum(v: Vec<i64>, r: i64) -> i64 {
    let s = v.as_slice();
    var t = 0;
    for x in s {
        if x & 1 == 0 {
            t += x * x + r;
        }
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    for i in 0..10 {
        v.push(i);
    }
    println(f"{filter_map_sum(v, 3)}");
    0
}
