// XFAIL: RT-117d: UNSOUND: (RT-117's family, no promotion, a const) `const C: Vs = Vs { n: &[4, 11] };` with `n: &'static [u64]`, and `fn get() -> &'static [u64] { C.n }`: the slice get returns points into the stack, where rustc's points into the binary's static data next to a `static`; rustc prints the EXPECT lines (0.30.2)
// From the g302static work (its pre/pre07). Since v0.30.1 at least (the
// values read right by luck; the address is a stack address). The
// g302static branch refuses it (borrowck.return_local). The second line
// checks that the slice is within 256 MB of a static. RT-117 is a
// const of a reference to a struct literal, refused.
// EXPECT: 11 11
// EXPECT: true
struct Vs {
    n: &'static [u64],
}

const C: Vs = Vs { n: &[4, 11] };

static G: u64 = 5;

fn get() -> &'static [u64] {
    C.n
}

fn main() {
    let g = get();
    let pg = g.as_ptr() as usize as i64;
    let ps = &G as *const u64 as usize as i64;
    println("{} {}", C.n[1], g[1]);
    println("{}", (pg - ps).abs() < (1i64 << 28));
}
