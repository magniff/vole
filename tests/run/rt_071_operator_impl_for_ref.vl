// XFAIL: RT-71: an operator impl for a reference type (impl Add<&S> for &S) is not used: `&a + &b` is refused with "arithmetic operator requires numeric type, got '&S'" (0.30.2)
// Rust looks the operator up on the operand types as written: &S + &S
// takes Add<&S> for &S. vole refuses every expression whose left operand
// is a reference to a non-numeric type (16 of 60 programs of the matrix,
// every one with &a on the left). rustc prints the EXPECT line.
// EXPECT: 2102 3
use std::ops::Add;

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl<'a> Add<&'a S> for &'a S {
    type Output = i64;

    fn add(self, o: &'a S) -> i64 {
        self.k * 100 + o.k + 2000
    }
}

fn main() -> i32 {
    let a = S { k: 1 };
    let b = S { k: 2 };
    let r = &a + &b;
    println("{} {}", r, a.k + b.k);
    0
}
