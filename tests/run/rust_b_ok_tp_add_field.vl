// EDITION: rust
// RULE: D7.2
// (0.27.1) `s.add(s.x)`: a read of the reserved place in the window.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn main() {
    let mut s = S { x: 3, y: 2 };
    s.add(s.x);
    println("{}", s.x);
}
// EXPECT: 6
