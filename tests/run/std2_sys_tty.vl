// EDITION: rust
// FLAGS: --check-alloc
// What a terminal program asks of std::sys (examples/openhtop): termios
// (raw mode and back), poll, read and write on descriptors, isatty, the
// window's size, kill. On a pipe: the terminal calls are refused, the
// others work.
// EXPECT: isatty(pipe): false
// EXPECT: termios on a pipe: refused
// EXPECT: winsize on a pipe: refused
// EXPECT: TIOCGWINSZ known: true
// EXPECT: poll before: 0
// EXPECT: wrote: 4
// EXPECT: poll after: 1 true
// EXPECT: read: 4 keys
// EXPECT: kill(self, 0): true
// EXPECT: kill(no such): true
use std::sys::{
    SYS_POLLIN, SYS_SIGTERM, SYS_TIOCGWINSZ, SysPollFd, SysTermios, sys_close, sys_get_winsize,
    sys_getpid, sys_isatty, sys_kill, sys_make_raw, sys_pipe, sys_poll, sys_read, sys_tcgetattr,
    sys_tcsetattr, sys_write,
};

fn raw_mode(fd: i32) -> Result<SysTermios, i32> {
    let saved = sys_tcgetattr(fd)?;
    let mut raw = saved;
    sys_make_raw(&mut raw);
    sys_tcsetattr(fd, raw)?;
    Ok(saved)
}

fn main() -> i32 {
    let (r, w) = match sys_pipe() {
        Ok(p) => p,
        Err(e) => {
            println("pipe: {e}");
            return 1;
        }
    };
    println("isatty(pipe): {}", sys_isatty(r));
    match raw_mode(r) {
        Ok(saved) => {
            let _ = sys_tcsetattr(r, saved);
            println("raw mode on a pipe?");
        }
        Err(_) => println("termios on a pipe: refused"),
    }
    match sys_get_winsize(r) {
        Ok(ws) => println("winsize on a pipe? {} {}", ws.ws_row, ws.ws_col),
        Err(_) => println("winsize on a pipe: refused"),
    }
    println("TIOCGWINSZ known: {}", SYS_TIOCGWINSZ != 0);
    let mut fds = [SysPollFd { fd: r, events: SYS_POLLIN, revents: 0 }];
    println("poll before: {}", sys_poll(&mut fds[..], 0).unwrap_or(-1));
    println("wrote: {}", sys_write(w, "keys").unwrap_or(-1));
    println("poll after: {} {}", sys_poll(&mut fds[..], 100).unwrap_or(-1),
        fds[0].revents & SYS_POLLIN != 0);
    let mut buf = [0u8; 16];
    let n = sys_read(r, &mut buf[..]).unwrap_or(-1);
    println("read: {} {}", n, std::str::from_utf8(&buf[..n as usize]).unwrap_or("?"));
    // signal 0: only whether the process may be signalled
    println("kill(self, 0): {}", sys_kill(sys_getpid(), 0).is_ok());
    println("kill(no such): {}", sys_kill(0x3fffffff, SYS_SIGTERM).is_err());
    let _ = sys_close(r);
    let _ = sys_close(w);
    0
}
