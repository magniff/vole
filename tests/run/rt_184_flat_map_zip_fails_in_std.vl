// XFAIL: RT-184: `.flat_map(..).zip(other)` fails inside std unless other's iterator type is the flat_map's inner one: zip's own U is read as FlatMap's U (0.30.2)
// rustc prints the EXPECT line (twin: r302d_014b_flat_map_zip_fails_in_std.rs.txt).
// vole: `<std>:16813:24: error[type error] expected 'Range<i64>', got
// 'Rev<Range<i64>>' | note: in instantiation of 'FlatMap<Range<i64>, Range<i64>,
// ..>::zip<Rev<Range<i64>>>'` and the same for the second line (expected
// 'Map<Range<i64>, closure..>', got 'Range<i64>'). R302D-14's mechanism inside
// std: Iterator::zip<U: IntoIterator>(self, other: U) -> Zip<Self, U::IntoIter>
// copied into FlatMap<I, U, F>. `a.zip(b.flat_map(..))` works. Found by the
// opaque generator gen/gop.py (seeds 11, 13, 20, 24, 30, 63, 65, 87, 96, 115).
// Since v0.28.0.
// EXPECT: 49 63
fn main() {
    let a: i64 = (0..3i64).flat_map(|x| 0..x).zip((0..15i64).rev()).map(|(a, b)| a * 10 + b).sum();
    let b: i64 = (0..3i64)
        .flat_map(|x| (0..x).map(move |y| x + y))
        .zip(0..15i64)
        .map(|(a, b)| a * 10 + b)
        .sum();
    println("{a} {b}");
}
