// The std2 item(s): std::fmath f64::floor; f64::ceil; f64::round; f64::round_ties_even; f64::trunc; f64::fract.
// EXPECT: -3 -2 -3 -2 -2 -0.5
// EXPECT: -1 -0 -1 -0 -0 -0.5
// EXPECT: -0 -0 -0 -0 -0 0
// EXPECT: 0 1 1 0 0 0.5
// EXPECT: 1 2 2 2 1 0.5
// EXPECT: 2 3 3 2 2 0.5
// EXPECT: 3 4 4 4 3 0.7000000000000002
// EXPECT: -4 -3 -4 -4 -3 -0.7000000000000002
// EXPECT: 100000000000000000000 100000000000000000000 100000000000000000000 100000000000000000000 100000000000000000000 0
// EXPECT: 4503599627370497 4503599627370497 4503599627370497 4503599627370497 4503599627370497 0
// EXPECT: true inf -inf
fn main() {
    let xs = [-2.5f64, -0.5, -0.0, 0.5, 1.5, 2.5, 3.7, -3.7, 1e20, 4503599627370497.0];
    for x in xs.iter() {
        let x = *x;
        println("{} {} {} {} {} {}", x.floor(), x.ceil(), x.round(), x.round_ties_even(), x.trunc(),
            x.fract());
    }
    println("{} {} {}", f64::NAN.floor().is_nan(), f64::INFINITY.ceil(), f64::NEG_INFINITY.round());
}
