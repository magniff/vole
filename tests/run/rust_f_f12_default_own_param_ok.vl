// EDITION: rust
// RULE: F12.2
// A trait default whose own parameter has the name of one of the impl's:
// in the copy it is its own, as fold's B in `impl<B, I, F> Iterator for
// Map<I, F>`.
// EXPECT: 6
// EXPECT: 10
trait Fold {
    fn get(&self) -> i64;

    fn fold_with<B, F: Fn(B, i64) -> B>(&self, init: B, f: F) -> B {
        f(init, self.get())
    }
}

struct W<B> {
    b: B,
    n: i64,
}

impl<B> Fold for W<B> {
    fn get(&self) -> i64 {
        self.n
    }
}

fn main() {
    let w = W { b: true, n: 4 };
    let r: i64 = w.fold_with(2, |a, x| a + x);
    println("{}", r);
    let s = w.fold_with(6i64, |a, x| a + x);
    println("{}", s);
    if w.b {}
}
