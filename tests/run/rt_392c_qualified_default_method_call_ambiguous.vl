// XFAIL: RT-392: (RT-392's mechanism, a default method) `<W as Tr<i64>>::twice(&w)`, a qualified call of a default method of `trait Tr<U>` with impls of Tr<i32> and Tr<i64>, is refused as "'W::twice' is ambiguous for arguments ()"; rustc accepts it and prints the EXPECT line (0.30.2)
// From the review of g302bor2 (form B/b34). Since v0.30.1 at least; the
// release build the same. The qualified path names the impl; the default
// body's `self.get()` is Tr<i64>'s. Siblings: rt_392, rt_392b.
// EXPECT: hello heap string long 22
trait Tr<U> {
    type Out;
    fn get(&self) -> Self::Out;

    fn twice(&self) -> Self::Out {
        self.get()
    }
}

struct W<'a> {
    r: &'a str,
}

impl<'a> Tr<i32> for W<'a> {
    type Out = &'static str;

    fn get(&self) -> &'static str {
        "s"
    }
}

impl<'a> Tr<i64> for W<'a> {
    type Out = &'a str;

    fn get(&self) -> &'a str {
        self.r
    }
}

fn main(gpa: Gpa) {
    let st = String::from_in("hello heap string long", gpa);
    let s = {
        let w = W { r: st.as_str() };
        <W as Tr<i64>>::twice(&w)
    };
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", s, other.len());
}
