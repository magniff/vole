// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map Entry::or_insert.
// EXPECT: 5 6
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    let a = *m.entry(1).or_insert(5);
    *m.entry(1).or_insert(9) += 1;
    println("{} {}", a, m[&1]);
}
