// (re-review 2 of M2, form m07) A supertrait written `where Self: TrB`:
// rustc reads `trait Sub: TrA where Self: TrB` as `trait Sub: TrA + TrB`,
// so `Self::Out` in Sub's text names Out of both: E0221. d4db7fbf8 counted
// the supertraits of `trait Sub: ..` only and took TrA's Out (it printed 8).
// ERROR: is ambiguous: more than one supertrait of 'Sub' declares it
// ERROR-COUNT: 1
trait TrA {
    type Out;
}

trait TrB {
    type Out;
}

trait Sub: TrA
    where
        Self: TrB,
{
    fn sz(&self) -> usize {
        std::mem::size_of::<Self::Out>()
    }
}

struct W;

impl TrA for W {
    type Out = i64;
}

impl TrB for W {
    type Out = u8;
}

impl Sub for W {}

fn main() {
    println("{}", W.sz());
}
