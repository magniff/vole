// EXIT: 0
// 0.25.2.1: Float methods in an impl's method nothing calls, in a program
// that names nothing else of std.
struct V { x: f64, y: f64 }

impl V {
    fn len(self) -> f64 {
        self.x.hypot(self.y)
    }

    fn angle(self) -> f64 {
        self.y.atan2(self.x).to_degrees()
    }
}

fn main() {
}
