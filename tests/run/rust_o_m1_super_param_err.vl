// (0.30.2, obligations M1) rust_o_m1_super_param_ok as `Sub<i32>`, whose
// supertrait Sup<i32>'s impl needs `'c: 'static`: refused at Sub's impl,
// which does not say it (rustc E0478's family), and at the use with a short X.
// ERROR: trait.unmet
// ERROR: borrowck.dropped_borrowed
trait Sup<P> { fn up(&self) -> i64; }
trait Sub<P>: Sup<P> { fn n(&self) -> i64; }
struct X<'c> { r: &'c str }
impl<'c: 'static> Sup<i32> for X<'c> { fn up(&self) -> i64 { 32 } }
impl<'c> Sup<i64> for X<'c> { fn up(&self) -> i64 { 64 } }
impl<'c> Sub<i32> for X<'c> { fn n(&self) -> i64 { 1 } }
fn go<T: Sub<i32>>(t: &T) -> i64 { t.n() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello heap string long", gpa);
    println("{}", go(&X { r: st.as_str() }));
}
