// (0.30.1, review 5) rust_f_impl_predicates_classes_err with a 'static
// str: both impls' predicates hold, the pattern impl's runs.
// EXPECT: lit
trait Get {
    fn g(&self) -> &str;
}

impl Get for str {
    fn g(&self) -> &str {
        self
    }
}

trait Tr<U> {
    fn f(&self) -> &'static str;
}

impl<'a, T: Get + ?Sized> Tr<i32> for &'a T where 'a: 'static {
    fn f(&self) -> &'static str {
        let r: &'static T = *self;
        r.g()
    }
}

impl<'a> Tr<i64> for &'a str {
    fn f(&self) -> &'static str {
        "64"
    }
}

fn go<T: Tr<i32>>(t: &T) -> &'static str {
    t.f()
}

fn leak(gpa: Gpa) -> &'static str {
    let r: &'static str = "lit";
    go(&r)
}

fn main(gpa: Gpa) {
    println("{}", leak(gpa));
}
