// XFAIL: RT-179: `const A: &P = &P { .. }` and `const B: &[&[u8]] = &[&[1, 2], &[3]]` give borrowck.dropped_borrowed, 2 and 3 times; rustc promotes them (0.30.2)
// From the c302const branch's report.
// EXPECT: 3 4 2 3
struct P {
    x: u8,
    y: u8,
}

const A: &P = &P { x: 3, y: 4 };
const B: &[&[u8]] = &[&[1, 2], &[3]];

fn main() {
    println("{} {} {} {}", A.x, A.y, B[0][1], B[1][0]);
}
