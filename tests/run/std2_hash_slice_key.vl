// EDITION: rust
// The std2 item(s): std::hash [T]::impl Hash.
// (0.27.6) A map keyed by byte slices: `[T]`'s hash calls its element's
// `T::hash_slice`. It called `Hash::hash_slice(self, state)`, which the
// front read with `Self = [u8]`, so `HashMap<&[u8], V>` did not check.
// EXPECT: Some(1) None 2
use std::alloc::Gpa;
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<&[u8], i64, Gpa> = HashMap::new_in(gpa);
    m.insert(b"ab", 1);
    m.insert(b"cd", 2);
    let k: &[u8] = b"ab";
    let other: &[u8] = b"zz";
    println("{:?} {:?} {}", m.get(k), m.get(other), m.len());
}
