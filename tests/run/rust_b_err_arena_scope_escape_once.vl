// RULE: D19.10
// (0.28.0) A Vec on arena_scope's arena returned from its closure: one
// error, not the same line twice (the parameter has two regions, and
// each flows out).
// ERROR: error[borrowck.outlives]: lifetime may not live long enough: the lifetime of the closure's parameter 'a' is only the call's
// ERROR: line 12, column 21
// ERROR-COUNT: 1
use std::alloc::arena_scope;

fn main(gpa: Gpa) {
    let squares = arena_scope(&gpa, |a| {
        let mut v = Vec::new_in(a);
        v.push(1);
        v.push(4);
        v
    });
    println("{}", squares.len());
}
