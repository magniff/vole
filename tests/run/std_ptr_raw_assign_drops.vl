// 0.30: an assignment through a raw pointer drops the old value, as in
// Rust and as `*r = v` through a `&mut` does (0.29 wrote over it and
// leaked it): after the right side, before the write, once. The pointee
// must be initialized (the `unsafe` code's obligation); ptr::write is
// the write that drops nothing. `*p`, `(*p).f`, `(*p).0`, `(*p)[i]`,
// `*p.add(i)` of a Vec's element, a generic `*mut T` (with a Drop type,
// a String and an i64), and in a loop; the Strings are freed (FLAGS).
// FLAGS: --check-alloc
// EXPECT: whole
// EXPECT: mk1
// EXPECT: mk2
// EXPECT: d1
// EXPECT: --
// EXPECT: d2
// EXPECT: field
// EXPECT: mk3
// EXPECT: mk4
// EXPECT: d3
// EXPECT: --
// EXPECT: mk5
// EXPECT: d5
// EXPECT: --
// EXPECT: 1
// EXPECT: d5
// EXPECT: d4
// EXPECT: index
// EXPECT: mk6
// EXPECT: mk7
// EXPECT: mk8
// EXPECT: d7
// EXPECT: --
// EXPECT: d6
// EXPECT: d8
// EXPECT: element
// EXPECT: mk9
// EXPECT: mk10
// EXPECT: mk11
// EXPECT: d10
// EXPECT: --
// EXPECT: d9
// EXPECT: d11
// EXPECT: generic
// EXPECT: mk12
// EXPECT: mk13
// EXPECT: d12
// EXPECT: --
// EXPECT: b 2
// EXPECT: d13
// EXPECT: loop
// EXPECT: mk20
// EXPECT: mk21
// EXPECT: d20
// EXPECT: mk22
// EXPECT: d21
// EXPECT: mk23
// EXPECT: d22
// EXPECT: --
// EXPECT: d23
// EXPECT: heap
// EXPECT: second bb
// EXPECT: end

struct T { id: i64 }

impl Drop for T {
    fn drop(&mut self) { println("d{}", self.id); }
}

fn mk(id: i64) -> T {
    println("mk{id}");
    T { id: id }
}

struct H { f: T, n: i64 }

// UNSAFE: writes through a raw pointer.
// SAFETY: a contract on the caller: p is valid and its T initialized.
unsafe fn set<T>(p: *mut T, v: T) {
    *p = v;
}

fn main(gpa: Gpa) -> i32 {
    println("whole");
    {
        let mut x = mk(1);
        let p = &mut x as *mut T;
        // UNSAFE: a write through a raw pointer.
        // SAFETY: p is x's address, x initialized and not otherwise used here.
        unsafe { *p = mk(2); }
        println("--");
    }
    println("field");
    {
        let mut h = H { f: mk(3), n: 0 };
        let p = &mut h as *mut H;
        // UNSAFE: writes through a raw pointer.
        // SAFETY: p is h's address, h initialized and not otherwise used here.
        unsafe {
            (*p).f = mk(4);
            (*p).n = 1;
        }
        println("--");
        let mut t = (mk(5), 0i64);
        let q = &mut t as *mut (T, i64);
        // UNSAFE: a write through a raw pointer.
        // SAFETY: q is t's address, t initialized and not otherwise used here.
        unsafe { (*q).0 = T { id: 5 + (*q).1 }; }
        println("--");
        println("{}", h.n);
    }
    println("index");
    {
        let mut a = [mk(6), mk(7)];
        let p = &mut a as *mut [T; 2];
        // UNSAFE: a write through a raw pointer.
        // SAFETY: p is a's address, a initialized and not otherwise used here.
        unsafe { (*p)[1] = mk(8); }
        println("--");
    }
    println("element");
    {
        let mut v: Vec<T, Gpa> = Vec::new_in(gpa);
        v.push(mk(9));
        v.push(mk(10));
        let p = v.as_mut_ptr();
        // UNSAFE: a write through a raw pointer.
        // SAFETY: v has 2 elements, so p.add(1) is the second, initialized.
        unsafe { *p.add(1) = mk(11); }
        println("--");
    }
    println("generic");
    {
        let mut x = mk(12);
        let mut b = 1i64;
        // UNSAFE: set writes through its raw pointer.
        // SAFETY: the pointers are x's and b's addresses, both initialized.
        unsafe {
            set(&mut x as *mut T, mk(13));
            println("--");
            set(&mut b as *mut i64, 2);
        }
        println("b {b}");
    }
    println("loop");
    {
        let mut x = mk(20);
        let p = &mut x as *mut T;
        for i in 21..24 {
            // UNSAFE: a write through a raw pointer.
            // SAFETY: p is x's address; x initialized on every round.
            unsafe { *p = mk(i); }
        }
        println("--");
    }
    println("heap");
    {
        let mut s = String::from_in("first", gpa);
        let p = &mut s as *mut String<Gpa>;
        // UNSAFE: set writes through its raw pointer.
        // SAFETY: p is s's address, s initialized; the old String is dropped.
        unsafe { set(p, String::from_in("second", gpa)); }
        let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
        v.push(String::from_in("a", gpa));
        let q = v.as_mut_ptr();
        // UNSAFE: a write through a raw pointer.
        // SAFETY: v has 1 element, the String q points to, initialized.
        unsafe { *q = String::from_in("bb", gpa); }
        println("{} {}", s, v[0]);
    }
    println("end");
    0
}
