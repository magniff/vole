// 0.25.3 (eval 0.25.2.2: terrain, a 120 s GPU run lost): `m.get(name)` of
// a flag was None, silently (a flag has no value); get, get_as and values
// now require an argument that takes a value (cli.kind, naming the
// caller's line). The reverse is defined: `m.flag(name)` of an option is
// whether it was given (a default does not count).
// ARGS: --headless --max 5
// EXIT: 101
// EXPECT: flag max: true, flag headless: true, flag out: false
// EXPECT: max: 5, count headless: 1
// STDERR: cli_0253_flag_get.vl:26:8: cli.kind: m.get(NAME) of a flag, which has no value (it would always be None): read a flag with m.flag(NAME)
use std::env;
use std::cli::{Arg, Command};

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("t", gpa)
        .arg(Arg::flag("headless"))
        .arg(Arg::option("max").default("3"))
        .arg(Arg::option("out").default("a.ppm"));
    let m = cmd.parse_or_exit(env::args());
    println(
        "flag max: {}, flag headless: {}, flag out: {}", m.flag("max"), m.flag("headless"),
        m.flag("out"));
    let n = m.get_as::<i64>("max").unwrap_or(0);
    println("max: {n}, count headless: {}", m.count("headless"));
    // (the eval's: always false before 0.25.3)
    if m.get("headless").is_some() {
        println("headless");
    }
    0
}
