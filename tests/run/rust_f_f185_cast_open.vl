// EDITION: rust
// RULE: F18.5
// (0.27.7) A cast's operand gives an open local no type, as in rustc: `let
// max = (1 << bits) - 1;` then `max as f64` leaves max open, and the later
// `return max` (an i64) types it. Before, the cast closed it at i32 and
// clamp(40, ..) returned 255. With no use that types it, the fallback is
// i32's (`small`).
// EXPECT: 1099511627775 0
// EXPECT: 1099511627775 1099511627775
// EXPECT: 1099511627775
// EXPECT: 3 3
fn clamp(bits: i64, value: f64) -> i64 {
    let max = (1 << bits as u64) - 1;
    if value >= max as f64 {
        return max;
    }
    0
}

fn widths(bits: i64) -> i64 {
    let max = (1 << bits as u64) - 1;
    let lim = max as u64;
    let x: i64 = max;
    println("{} {}", lim, x);
    max
}

fn annotated(bits: i64) -> i64 {
    let max = (1 << bits as u64) - 1;
    let f = max as f64;
    let m: i64 = max;
    if f > 0.0 {
        return m;
    }
    0
}

fn small() -> f64 {
    let s = 3;
    s as f64
}

fn main() {
    println("{} {}", clamp(40, 1e300), clamp(40, 1.0));
    widths(40);
    println("{}", annotated(40));
    println("{} {}", small(), small() as i64);
}
