// RT-38 (round 2, must pass): a borrowed copy is read as through `&T`
// and never written; what is not one stays writable as rustc's: a copy
// of a Copy static (`let mut x = S; x.a = 5;`), a guard's binding
// re-bound `mut` in its arm, a `for` element of a plain array. The
// EXPECT lines are rustc's output.
// EXPECT: 4
// EXPECT: 2
// EXPECT: 3
// EXPECT: 6 0 1
#[derive(Clone, Copy)]
struct P {
    a: i64,
    b: i64,
}

static S: P = P { a: 1, b: 2 };

fn main() {
    let mut x = S;
    x.a = 5;
    x = P { a: x.a + 1, b: 0 };
    let o = Some(3i64);
    match o {
        Some(mut n) if n > 0 => {
            n += 1;
            println("{}", n);
        }
        _ => {}
    }
    for mut y in [1i64, 2] {
        y += 1;
        println("{}", y);
    }
    println("{} {} {}", x.a, x.b, S.a);
}
