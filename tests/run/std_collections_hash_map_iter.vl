// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map Iter.
// EXPECT: 2
use std::collections::{HashMap, hash_map};
use std::collections::hash_map::Iter;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    m.insert(2, 2);
    let it: Iter<'_, i64, i64> = m.iter();
    println("{}", it.count());
}
