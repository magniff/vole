// Runs on std since 0.27.2's switch.
// The std item(s): std::iter ExactSizeIterator::is_empty.
// EXPECT: false true
// RUSTC: none (Rust's ExactSizeIterator::is_empty is unstable)

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64], gpa);
    let mut it = v.iter();
    let a = it.is_empty();
    it.next();
    println("{} {}", a, it.is_empty());
}
