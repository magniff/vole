// EDITION: rust
// An array field indexed out of bounds through an inout parameter.
// EXIT: 101
// STDERR: index out of bounds: index 4, length 4
static mut Z: i64 = 0;

#[derive(Clone, Copy)] struct S { a: [i64; 4] }

fn poke(s: &mut S, i: i64) {
    s.a[i as usize] = 9;
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut s = S { a: [1i64, 2, 3, 4] };
    poke(&mut s, 4 + unsafe { Z });
    println("{}", s.a[0]);
    0
}
