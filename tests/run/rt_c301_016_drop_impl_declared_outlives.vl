// RT-C301-16 (0.30.1, review 7) A Drop impl may repeat its type's
// declared or implied outlives (rustc accepts each: `'b: 'a` inline or in
// a `where`, `T: 'a`, `T: 'static`, `T: 'a` that a field `&'a T`
// implies). vole proves none of a type's outlives where a value of it is
// built (RT-37), so the Drop rule trusts none and refuses all: false
// errors, not holes, until the obligation engine proves them at
// construction (0.30.2).
// XFAIL: RT-C301-16: a Drop impl repeating its type's declared or implied outlives is refused (0.30.2)
// EXPECT: drop w 1
// EXPECT: drop k
// EXPECT: d04
// EXPECT: d14 x
// EXPECT: d05
struct W<'a, 'b: 'a> {
    r: &'a &'b str,
}

impl<'a, 'b: 'a> Drop for W<'a, 'b> {
    fn drop(&mut self) {
        println("drop w {}", self.r.len());
    }
}

struct K<T: 'static + Copy> {
    t: T,
}

impl<T: 'static + Copy> Drop for K<T> {
    fn drop(&mut self) {
        println("drop k");
    }
}

struct Wa<'a, 'b, T> where 'b: 'a, T: 'a { r: &'a &'b T }

impl<'a, 'b: 'a, T: 'a> Drop for Wa<'a, 'b, T> {
    fn drop(&mut self) { println("d04"); }
}

struct Wb<'a, 'b> where 'b: 'a { r: &'a &'b str }

impl<'a, 'b: 'a> Drop for Wb<'a, 'b> {
    fn drop(&mut self) { println("d14 {}", *self.r); }
}

struct Wi<'a, T> { r: &'a T }

impl<'a, T: 'a> Drop for Wi<'a, T> {
    fn drop(&mut self) { println("d05"); }
}

fn main() {
    let s: &str = "x";
    let i: &i64 = &1;
    let y = 2i64;
    {
        let w = W { r: &s };
    }
    {
        let k = K { t: 2i64 };
    }
    {
        let w = Wa { r: &i };
    }
    {
        let w = Wb { r: &s };
    }
    {
        let w = Wi { r: &y };
    }
}
