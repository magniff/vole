// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::is_sorted_by_key.
// EXPECT: true false
use std::slice::SliceIndex;

fn main() {
    let a: &[i64] = &[-1, 2, -3];
    let b: &[i64] = &[3, 1];
    println("{} {}", a.is_sorted_by_key(|x| if *x < 0 { -*x } else { *x }),
        b.is_sorted_by_key(|x| *x));
}
