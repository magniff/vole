// Vec::remove has a requires: a #[no_panic] function calling it may panic.
// ERROR: 'take' is #[no_panic], but it may panic
#[no_panic]
fn take(v: &mut Vec<i64, Gpa>, i: i64) -> i64 { v.remove(i as usize) }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{}", take(&mut v, 3));
    0
}
