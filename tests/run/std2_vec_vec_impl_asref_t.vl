// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl AsRef<[T]>.
// EXPECT: 2
use std::vec::Vec;

fn n<S: AsRef<[i64]>>(s: S) -> usize {
    s.as_ref().len()
}

fn main(gpa: Gpa) {
    println("{}", n(Vec::from_in([1, 2], gpa)));
}
