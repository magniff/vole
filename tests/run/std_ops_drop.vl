// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Drop.
// EXPECT: in
// EXPECT: drop 1
// EXPECT: end
use std::ops::Drop;

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main() {
    {
        let _n = Noisy { id: 1 };
        println("in");
    }
    println("end");
}
