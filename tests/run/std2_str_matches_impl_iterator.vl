// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str Matches::impl Iterator.
// EXPECT: ["1", "2", "3"] 2
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<&str, Gpa> = "a1b2c3".matches(|c: char| c.is_ascii_digit()).collect_in(gpa);
    let mut n = 0;
    for _ in "aXbXc".matches('X') {
        n += 1;
    }
    println("{:?} {}", v, n);
}
