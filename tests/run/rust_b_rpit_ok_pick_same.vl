// RUSTC-EDITION: 2024
// RULE: D21.2
// (0.27.2.1) One lifetime on both inputs: the hidden `&'a i32`'s member is
// 'a (rustc accepts).
// EXPECT: 2
trait Tr {
    fn get(&self) -> i32;
}

impl<'a> Tr for &'a i32 {
    fn get(&self) -> i32 { **self }
}

fn pick<'a>(c: bool, x: &'a i32, y: &'a i32) -> impl Tr {
    if c { x } else { y }
}

fn main() {
    let a: i32 = 1;
    let b: i32 = 2;
    println("{}", pick(false, &a, &b).get());
}
