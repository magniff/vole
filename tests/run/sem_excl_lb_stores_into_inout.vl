// MVS's XFAIL: OVERSTRICT the let-as-borrow rule covers results, not a let parameter stored into an inout one (own.escape)
// a let param stored (as a view) into an inout param: by reference; then the same value passed both ways
// ERROR: own.conflict
#[derive(Clone, Copy)] struct H<'a> { s: &'a [i64] }
fn keep(h: &mut H<'_>, y: [i64; 2]) { h.s = &y[..]; }

fn main() {
    let mut a = [1i64, 2]; let e = [0i64, 0]; let mut h = H { s: &e[..] }; keep(&mut h, a);
    a[0] = 5;
    println("{}", h.s[0]);
}
