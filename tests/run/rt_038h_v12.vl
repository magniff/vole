// (0.30.2, the re-review of g302holes: ov/v12)
// RUSTC: none contract clauses are not Rust
// EXPECT: 1
fn f(v: &Vec<i64, Gpa>) -> i64
    requires v.iter().map(|x| x * 2).sum::<i64>() == 6
{
    v[0]
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    println("{}", f(&v));
}
