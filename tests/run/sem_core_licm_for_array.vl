// A guarded array index in a counted for loop.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let i = -1099511627776 + unsafe { Z };
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    for k in 0..5 + unsafe { Z } { if k > 100 { t += a[i as usize]; } }
    println("{}", t);
    0
}
