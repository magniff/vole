// EDITION: rust
// FLAGS: --check-alloc
// EXIT: 101
// STDERR: double free: block #3 (64 bytes), allocated at
// STDERR: checkalloc_double_free.vl:15:9, freed at
// STDERR: checkalloc_double_free.vl:23:5, freed again at
// STDERR: checkalloc_double_free.vl:24:5
// 0.16: --check-alloc: a container freed twice through two copies of its
// handle (blocks #1 and #2 are the Vec's first, freed when it grew).
// (0.28: a second handle is a move, borrowck.use_moved; the copy here is
// made from its parts, in `unsafe`.)
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(1usize, gpa);
    for i in 0..5 {
        v.push(i);
    }
    v.push(5);
    // UNSAFE: a second handle to the Vec's block, made from its parts.
    // SAFETY: none, on purpose: both handles are dropped, and
    // --check-alloc stops the second free. (No element in it: a drop that
    // read the freed elements first would be a use after free.)
    let w: Vec<i64, Gpa> = unsafe { Vec::from_raw_parts_in(v.as_mut_ptr(), 0, v.capacity(), gpa) };
    drop(v);
    drop(w);
}
