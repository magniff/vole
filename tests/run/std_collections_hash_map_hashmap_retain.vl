// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::collections::hash_map HashMap::retain.
// EXPECT: [2, 4]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for i in 1..5i64 {
        m.insert(i, i);
    }
    m.retain(|k: &i64, _v: &mut i64| *k % 2 == 0);
    let mut ks: Vec<i64, Gpa> = m.keys().copied().collect_in(gpa);
    ks.sort();
    println("{:?}", ks);
}
