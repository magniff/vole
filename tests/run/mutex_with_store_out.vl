use std::sync::Mutex;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let m = Mutex::new(v);
    let mut out: Vec<&[i64], Gpa> = Vec::new_in(gpa);
    m.with(|d| out.push(d.as_slice()));
    m.with(|d| { for i in 0..1000 { d.push(i); } });
    println("{}", out[0][0]);
}
