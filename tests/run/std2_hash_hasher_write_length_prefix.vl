// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash Hasher::write_length_prefix.
// EXPECT: write [3, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: 8
// RUSTC: none (write_length_prefix is unstable in Rust (hasher_prefixfree_extras); std2's is stable)
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

fn main() {
    let mut h = Show { n: 0 };
    h.write_length_prefix(3);
    println("{}", h.finish());
}
