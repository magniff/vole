// (0.30.2, RT-83) The main thread's own large frame: jump's 104 MB array
// (in the branch not taken), more than main's 8 MiB stack and the 56 MiB
// guard macOS reserves below it. Its pages are written top down
// (stack_probe_sizes.vl: main's prologue is probed), so the guard is hit:
// SIGSEGV (exit 139). On macOS nothing is mapped within reach below that
// guard, so v0.30.1, which skipped it, died by SIGSEGV too (on Linux the
// main stack's guard gap is 1 MiB, with other mappings below it).
// REQUIRES: macos
// EXIT: 139
use std::sync::atomic::{AtomicI64, Ordering};

static STAGE: AtomicI64 = AtomicI64::new(0);

#[inline(never)]
fn total(a: &[i64]) -> i64 {
    let mut t = 0;
    for x in a {
        t += *x;
    }
    t
}

#[inline(never)]
fn fill() -> i64 {
    let mut a = [0i64; 64];
    for i in 0..64 {
        a[i] = 1;
    }
    total(&a)
}

// 104 MB: more than the main thread's 8 MiB stack and its 56 MiB guard.
#[inline(never)]
fn jump(big: bool) -> i64 {
    if big {
        let b = [3i64; 13000000];
        return total(&b);
    }
    fill()
}

fn main() {
    println("main: {}", jump(STAGE.load(Ordering::SeqCst) > 5));
}
