// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter Sum.
// EXPECT: M { v: 7 }
use std::iter::{Product, Sum};

#[derive(Debug, Clone, Copy)]
struct M {
    v: i64,
}

impl Sum for M {
    fn sum<I: Iterator<Item = M>>(iter: I) -> M {
        let mut s = 0;
        for m in iter {
            s += m.v;
        }
        M { v: s }
    }
}

impl Product for M {
    fn product<I: Iterator<Item = M>>(iter: I) -> M {
        let mut s = 1;
        for m in iter {
            s *= m.v;
        }
        M { v: s }
    }
}

fn main(gpa: Gpa) {
    let v = Vec::from_in([M { v: 2 }, M { v: 5 }], gpa);
    let s: M = v.iter().copied().sum();
    println("{:?}", s);
}
