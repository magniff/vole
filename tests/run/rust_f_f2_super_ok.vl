// EDITION: rust
// RULE: F2.2
// `trait Derived: Base`: a `T: Derived` bound gives `T` Base's methods too.
// EXPECT: 9
trait Base {
    fn base(&self) -> i64;
}

trait Derived: Base {
    fn more(&self) -> i64;
}

struct S {
    n: i64,
}

impl Base for S {
    fn base(&self) -> i64 {
        self.n
    }
}

impl Derived for S {
    fn more(&self) -> i64 {
        2
    }
}

fn both<T: Derived>(x: &T) -> i64 {
    x.base() + x.more()
}

fn main() -> i64 {
    let s = S { n: 7 };
    std::print_int(both(&s));
    println("");
    0
}
