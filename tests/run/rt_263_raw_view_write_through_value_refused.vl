// XFAIL: RT-263: a write through a `*mut [i64]` returned by a call (`(*o.unwrap())[0] = 9` with `o: Option<*mut [i64]>`; a tuple field's, `(*t.0)[1] = 8`, is taken) is refused: "cannot assign to 'o.unwrap()[_]', which is behind a `&` reference" (0.30.2)
// From the review of g302bor (ok/k08). rustc builds it and prints the EXPECT
// line. The pointer is made from `&mut x[..]`, a mutable view, so the write is
// allowed; the checker takes the raw view it cannot tell from a `*const [T]`
// (one type) for a shared one where the place is no local it saw written as
// `*mut`. On v0.30.1 too.
// EXPECT: 9 8
fn main() {
    let mut x = [1i64, 2];
    let o: Option<*mut [i64]> = Some(&mut x[..] as *mut [i64]);
    // UNSAFE: the case: a write through a raw mutable view held in an Option
    // SAFETY: o points to x, alive and not otherwise borrowed during the write
    unsafe {
        (*o.unwrap())[0] = 9;
    }
    let t: (*mut [i64], i64) = (&mut x[..] as *mut [i64], 0i64);
    // UNSAFE: the case: a write through a raw mutable view held in a tuple
    // SAFETY: t.0 points to x, alive and not otherwise borrowed during the write
    unsafe {
        (*t.0)[1] = 8;
    }
    println("{} {}", x[0], x[1]);
}
