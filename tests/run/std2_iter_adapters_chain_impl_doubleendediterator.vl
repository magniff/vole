// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::iter::adapters Chain::impl DoubleEndedIterator.
// EXPECT: [3, 2, 1]

fn main(gpa: Gpa) {
    let a = Vec::from_in([1i64], gpa);
    let b = Vec::from_in([2i64, 3], gpa);
    let v: Vec<i64, Gpa> = a.iter().chain(b.iter()).rev().copied().collect_in(gpa);
    println("{:?}", v);
}
