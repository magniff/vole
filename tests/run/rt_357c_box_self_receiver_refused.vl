// XFAIL: RT-357: a method with `self: Box<Self>` is refused ("a method's receiver is 'self', '&self', '&mut self' or 'self: *S'"); rustc accepts (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 4
trait B {
    fn bx(self: Box<Self, Gpa>) -> i64;
}

struct S {
    k: i64,
}

impl B for S {
    fn bx(self: Box<Self, Gpa>) -> i64 {
        self.k
    }
}

fn main(gpa: Gpa) {
    let b = Box::new_in(S { k: 4 }, gpa);
    println("{}", B::bx(b));
}
