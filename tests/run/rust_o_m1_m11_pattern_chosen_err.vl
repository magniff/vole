// (0.30.2, obligations M1) Review 5's m11: the chosen impl is a pattern one,
// `Tr<i32> for &'a str where 'a: 'static`, beside `Tr<i64>` for every
// `&'a str`; its where is required at the call (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
impl<'a> Tr<i32> for &'a str where 'a: 'static { fn f(&self) -> &'static str { *self } }
impl<'a> Tr<i64> for &'a str { fn f(&self) -> &'static str { "64" } }
fn go<T: Tr<i32>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa); let r: &str = st.as_str(); go(&r)
    };
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{}", s); println("{}", w);
}
