// EDITION: rust
// (0.26.3, decision 6) `a - b` of usizes panics at -O2 with --overflow-
// checks=on, with Rust's message at the expression.
// FLAGS: -O2 --overflow-checks=on
// EXIT: 101
// EXPECT: before
// STDERR: ovf_on_o2_sub_usize.vl:18:13: attempt to subtract with overflow

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: usize = idu(0) as usize;
    let b: usize = idu(1) as usize;
    println("before");
    let r = a - b;
    println("after {}", r);
}
