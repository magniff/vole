// RULE: Z9.1c
// (0.27.4) A raw pointer to the unsized place is fat, as rustc's: a
// `NonNull<[u8]>`, a `*const [u8]` and a `*const str` are two words; a
// `NonNull<u8>` and a `&&str` (a reference to the view) are one.
// EXPECT: 16 16 16
// EXPECT: 8 8
use std::mem::size_of;
use std::ptr::NonNull;

fn main() {
    println("{} {} {}", size_of::<NonNull<[u8]>>(), size_of::<*const [u8]>(),
        size_of::<*const str>());
    println("{} {}", size_of::<NonNull<u8>>(), size_of::<&&str>());
}
