// (0.25.2, feedbacks/galaga.md #2) A local whose type came from its
// literals' defaults (f64) used where f32 goes: one error, at the first
// use, naming the `let` and the annotation (try: an edit patch; fix
// --suggested writes it); the other uses of that `let` are not reported.
// ERROR: 'col' is '[f64; 4]' from its literals at
// ERROR-COUNT: 1
struct Quad { color: [f32; 4], x: f32 }

fn draw(c: [f32; 4]) -> f32 {
    c[0]
}

fn main() -> i32 {
    let flag = true;
    let col = if flag { [1.0, 0.0, 0.0, 1.0] } else { [0.0, 1.0, 0.0, 1.0] };
    let q = Quad { color: col, x: 1.0 };
    let a = draw(col);
    let b: f32 = col[1];
    (q.x + a + b) as i32
}
