// (0.25.5) The arithmetic is the integers': AtomicBool has fetch_and,
// fetch_or and fetch_xor, not fetch_add (nor fetch_nand, max, min).
// ERROR: the trait 'AtomicInteger' is not implemented for 'bool'
// ERROR: = help: required by the bound 'T: AtomicInteger' of 'Atomic::fetch_add'

use std::sync::atomic::{AtomicBool, Ordering};

fn main() -> i32 {
    let b = AtomicBool::new(true);
    b.fetch_or(false, Ordering::SeqCst);
    println(b.fetch_add(true, Ordering::SeqCst));
    0
}
