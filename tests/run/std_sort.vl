// XFAIL: gap 7: compile parser error: expected expression, got 'mut'
// EXPECT: sizes ok
// EXPECT: patterns ok
// EXPECT: records ok
// EXPECT: bytes: a ab b ba
// EXPECT: chaos 3000 sum 4498500
// 0.14: std::sort is an introsort. Every size up to a few hundred (the
// insertion sort, the partition and their boundaries), the inputs that
// break simple quicksorts (sorted, reversed, all equal, organ pipe, few
// keys), records by key, byte strings, and a cmp that is not an order
// (which must not leave the slice or lose elements; its partitions are
// lopsided enough to reach the heapsort).
// (0.26.4) Its PRNG and checksums are written wrapping_*.

#[derive(Clone, Copy)] struct Rng { x: u64 }

impl Rng {
    fn next(&mut self) -> i64 {
        self.x = self.x.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
        (self.x >> 33) as i64
    }
}

// The input of a pattern: n elements.
fn fill(v: &mut Vec<i64, Gpa>, pattern: i64, n: i64, rng: &mut Rng) {
    v.clear();
    for i in 0..n {
        let x: i64 = if pattern == 0 {
            rng.next() % 1000000
        } else if pattern == 1 {
            i
        } else if pattern == 2 {
            n - i
        } else if pattern == 3 {
            7
        } else if pattern == 4 {
            if i < n / 2 { i } else { n - i }
        } else if pattern == 5 {
            rng.next() % 3
        } else if pattern == 6 {
            if i % 2 == 0 { i } else { n + i }
        } else {
            if i % 50 == 0 { rng.next() } else { i }
        };
        v.push(x);
    }
}

// Whether s is sorted and holds the same multiset as before (by sum and
// sum of squares, wrapping).
fn check(s: &[i64], sum: i64, squares: i64) -> bool {
    let mut a: i64 = 0;
    let mut b: i64 = 0;
    for i in 0..s.len() {
        if i > 0 && s[i - 1] > s[i] {
            return false;
        }
        a = a.wrapping_add(s[i]);
        b = b.wrapping_add(s[i].wrapping_mul(s[i]));
    }
    a == sum && b == squares
}

fn sorts(v: &mut Vec<i64, Gpa>) -> bool {
    let s = v.as_mut_slice();
    let mut sum: i64 = 0;
    let mut squares: i64 = 0;
    for &x in s {
        sum += x;
        squares = squares.wrapping_add(x.wrapping_mul(x));
    }
    s.sort_unstable();
    check(s, sum, squares)
}

#[derive(Clone, Copy)] struct Rec { key: i64, id: i64 }

impl Ord for Rec {
    fn cmp(&self, other: &Rec) -> std::cmp::Ordering { ({
        self.key - other.key
    }).cmp(&0) }
} impl PartialOrd for Rec { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } } impl PartialEq for Rec {
    fn eq(&self, o: &Self) -> bool { self.cmp(o) == std::cmp::Ordering::Equal }
} impl Eq for Rec {}

// Not an order: the answer depends on a counter. (0.16: Ord::cmp is
// #[pure], so the counter is not a static: each key points at it, and a
// write through a raw pointer is unsafe, not global.)
#[derive(Clone, Copy)] struct Chaos { x: i64, calls: *mut i64 }

impl Ord for Chaos {
    fn cmp(&self, other: &Chaos) -> std::cmp::Ordering { ({
        unsafe {
            *self.calls += 1;
            (*self.calls * 7919 + self.x - other.x) % 3 - 1
        }
    }).cmp(&0) }
} impl PartialOrd for Chaos { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } } impl PartialEq for Chaos {
    fn eq(&self, o: &Self) -> bool { self.cmp(o) == std::cmp::Ordering::Equal }
} impl Eq for Chaos {}

fn main(gpa: Gpa) -> i32 {
    let mut rng = Rng { x: 12345u64 };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut ok = true;
    for n in 0..300 {
        fill(&mut v, n % 8, n, &mut rng);
        ok = ok && sorts(&mut v);
    }
    println("{}", if ok { "sizes ok" } else { "sizes WRONG" });
    for p in 0..8 {
        for n in [1000i64, 4099, 50000] {
            fill(&mut v, p, n, &mut rng);
            ok = ok && sorts(&mut v);
        }
    }
    println("{}", if ok { "patterns ok" } else { "patterns WRONG" });

    let mut r: Vec<Rec, Gpa> = Vec::new_in(gpa);
    for i in 0..20000 {
        r.push(Rec { key: rng.next() % 100, id: i });
    }
    let rs = r.as_mut_slice();
    rs.sort_unstable();
    let mut ids: i64 = 0;
    for i in 0..rs.len() {
        if i > 0 && rs[i - 1].key > rs[i].key {
            ok = false;
        }
        ids += rs[i].id;
    }
    println("{}", if ok && ids == 19999 * 10000 { "records ok" } else { "records WRONG" });

    let mut words = ["ba", "b", "ab", "a"];
    mut words[..].sort_unstable();
    print("bytes:");
    for w in words {
        print(" ");
        print("{}", w);
    }
    println("");

    let mut c: Vec<Chaos, Gpa> = Vec::new_in(gpa);
    let mut calls: i64 = 0;
    for i in 0..3000 {
        c.push(Chaos { x: i, calls: &mut calls as *mut i64 });
    }
    c.as_mut_slice().sort_unstable();
    let mut total: i64 = 0;
    for &x in c.as_slice() {
        total += x.x;
    }
    print("chaos ");
    print("{}", (c.len() as i64));
    print(" sum ");
    print("{}", total);
    println("");
    0
}
