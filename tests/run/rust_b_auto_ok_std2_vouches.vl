// RULE: AT2, AT1
// (0.27.2) std2's containers state their own Send and Sync (`unsafe impl<T:
// Send, A: Allocator + Send> Send for Vec<T, A> {}` and the rest, as
// Rust's): by their type and allocator arguments, not their raw fields; a
// String and a HashMap by their Vec and table; a JoinHandle for every T.
use std::cell::Cell;
use std::collections::HashMap;
use std::hash::FixedState;
fn send<T: Send>() {}
fn sync<T: Sync>() {}

fn main() {
    send::<Vec<i64, Gpa>>();
    sync::<Vec<i64, Gpa>>();
    send::<Box<i64, Gpa>>();
    sync::<Box<i64, Gpa>>();
    send::<String<Gpa>>();
    sync::<String<Gpa>>();
    send::<HashMap<i64, i64, Gpa, FixedState>>();
    sync::<HashMap<i64, i64, Gpa, FixedState>>();
    send::<std::vec::IntoIter<i64, Gpa>>();
    sync::<std::vec::IntoIter<i64, Gpa>>();
    send::<Vec<Vec<i64, Gpa>, Gpa>>();
    send::<Cell<i64>>();
    send::<std::thread::JoinHandle<i64, Gpa>>();
    sync::<std::thread::JoinHandle<i64, Gpa>>();
    println("ok");
}
// EXPECT: ok
