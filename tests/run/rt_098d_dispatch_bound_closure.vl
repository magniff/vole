// XFAIL: RT-98: a closure parameter of type &T, T: Tr<i64>: `t.f()` is refused as ambiguous (0.30.2)
// From the review of the obligation engine's M1 (pre-existing: v0.30.1 too).
// EXPECT: 64
trait Tr<U> { fn f(&self) -> i64; }
struct W { r: i64 }
impl Tr<i32> for W { fn f(&self) -> i64 { 32 } }
impl Tr<i64> for W { fn f(&self) -> i64 { 64 } }
fn go<T: Tr<i64>>(t: &T) -> i64 { let c = |z: &T| z.f(); c(t) }
fn main() { let x = W { r: 1 }; println("{}", go(&x)); }
