// XFAIL: RT-296: byte slices lack is_ascii, eq_ignore_ascii_case, make_ascii_uppercase, make_ascii_lowercase and escape_ascii: "no method 'is_ascii' on type '[u8; 3]'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). str has the ASCII methods;
// `[u8]`, Rust's other home for them, does not (`guide rust` lists only
// u8::is_ascii_whitespace as missing).
// EXPECT: true false
// EXPECT: true
// EXPECT: [65, 66, 67] [97, 98, 99]
// EXPECT: a\x00\xff
fn main() {
    let mut b: [u8; 3] = [65, 98, 67];
    let c: [u8; 2] = [200, 1];
    println("{} {}", b.is_ascii(), c.is_ascii());
    println("{}", b.eq_ignore_ascii_case(&[97u8, 66, 99]));
    b.make_ascii_uppercase();
    let u = b;
    b.make_ascii_lowercase();
    println("{:?} {:?}", u, b);
    let d: [u8; 3] = [97, 0, 255];
    println("{}", d.escape_ascii());
}
