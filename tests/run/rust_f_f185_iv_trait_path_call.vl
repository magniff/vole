// RULE: F18.5
// (0.30.2) A trait's function by its path with Self an integer variable
// (`Bump::bump(&mut a)`, `Ord::max(c, 7)`, `Clone::clone(&g)`): rustc's
// `<{integer} as Tr>`, the impl the one of the type a later use gives the
// variable (i64, i64, u8 here); a format hole's `Display::fmt(&v, f)` is
// one. 0.30.1 typed the literals i32 at the call.
// EXPECT: 64 4000000000
// EXPECT: 7
// EXPECT: 18
// EXPECT: <1>|xrt.m3:4
trait Bump {
    fn bump(&mut self) -> i64;
}

impl Bump for i32 {
    fn bump(&mut self) -> i64 {
        *self += 1;
        32
    }
}

impl Bump for i64 {
    fn bump(&mut self) -> i64 {
        *self += *self;
        64
    }
}

fn main() {
    let mut a = 2000000000;
    let k = Bump::bump(&mut a);
    let b: i64 = a;
    println("{} {}", k, b);
    let c = 5;
    let m = Ord::max(c, 7);
    let d: i64 = m;
    println("{}", d);
    let g = 9;
    let h: u8 = g;
    println("{}", Clone::clone(&g) + h);
    let decl = true;
    println("{}|{}", format_args("<{}>", if decl { 1 } else { 0 }), {
        let i = 3;
        let k = [1, 2, 3, 4][i as usize];
        format_args("xrt.m{i}:{k}")
    });
}
