// EDITION: rust
// RULE: D4.6
// (0.27.2.1) A requirement carried through a field's own type: `Outer<'a,
// T>` holds an `Inner<'a, T>`, whose `&'a T` gives `T: 'a`, so Outer's
// signature implies it too.
// EXPECT: 7
struct Inner<'a, T> {
    r: &'a T,
}

struct Outer<'a, T> {
    i: Inner<'a, T>,
}

fn id<'r, U>(u: &'r U) -> &'r U {
    u
}

impl<'a, T> Outer<'a, T> {
    fn get(&self) -> &'a T {
        id(self.i.r)
    }
}

fn main() {
    let n: i64 = 7;
    let s = [&n];
    let o = Outer { i: Inner { r: &s[0] } };
    println("{}", **o.get());
}
