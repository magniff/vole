// EDITION: rust
// RULE: D8.6
// (0.27.2.1) What E0508 leaves: the whole array moves; an element is
// borrowed (`&a[0]`) or its Copy field read (`a[1].v`); a Copy element
// moves out by its index (a copy).
// EXPECT: 1 2
// EXPECT: 3 7 8
struct N {
    v: i64,
}

fn main() {
    let a = [N { v: 1 }, N { v: 2 }];
    let r = &a[0];
    let w = a[1].v;
    println("{} {}", r.v, w);
    let b = a;
    let c = [7i64, 8];
    let k = c[0];
    println("{} {} {}", b[0].v + b[1].v, k, c[1]);
}
