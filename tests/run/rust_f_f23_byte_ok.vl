// EDITION: rust
// RULE: F23.2
// `b'x'` is a u8: an ASCII character or an escape (`\n`, `\\`, `\'`,
// `\0`, `\xHH`).
// EXPECT: 65 10 92 39 0 255
fn main() {
    let a: u8 = b'A';
    let bytes = [b'\n', b'\\', b'\'', b'\0', b'\xff'];
    println("{} {} {} {} {} {}", a, bytes[0], bytes[1], bytes[2], bytes[3], bytes[4]);
}
