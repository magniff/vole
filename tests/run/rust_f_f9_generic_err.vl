// RULE: F9.3
// Two traits' methods of one name on a generic type, neither inherent: a
// method call does not say which (rustc E0034).
// ERROR: error[method.ambiguous]: multiple applicable items: 'get' is a method of more than one trait for 'W<u8>'
trait A {
    fn get(&self) -> i64;
}

trait B {
    fn get(&self) -> i64;
}

struct W<T> {
    v: T,
}

impl<T> A for W<T> {
    fn get(&self) -> i64 {
        1
    }
}

impl<T> B for W<T> {
    fn get(&self) -> i64 {
        2
    }
}

fn main() -> i64 {
    let w = W { v: 0u8 };
    w.get()
}
