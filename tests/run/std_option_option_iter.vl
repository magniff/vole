// Runs on std since 0.27.2's switch.
// The std item(s): std::option Option::iter.
// EXPECT: 3
// EXPECT: 0
use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    let b: Option<i64> = None;
    for x in a.iter() {
        println("{}", x);
    }
    println("{}", b.iter().count());
}
