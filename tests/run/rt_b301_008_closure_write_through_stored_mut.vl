// XFAIL: RT-B301-8: a closure writing through a `&mut` held by a binding that is not `mut` is refused (open, 0.30.2; 0.30.0 the same)
// `let pp = P { p: &mut x }; || { *pp.p += 9; }` and `let a = [&mut x];
// || { *a[0] = 5; }`: the write goes through the `&mut` (rustc's unique
// borrow of pp, LocalMutationIsAllowed::Yes), so rustc accepts both (10,
// 5); vole asks for `let mut pp` (borrowck.borrow_immutable).
// EXPECT: 10
// EXPECT: 5
struct P<'a> {
    p: &'a mut i64,
}

fn main() {
    let mut x = 1i64;
    let pp = P { p: &mut x };
    let mut f = || {
        *pp.p += 9;
    };
    f();
    println("{}", *pp.p);
    let mut y = 1i64;
    let a = [&mut y];
    let mut g = || {
        *a[0] = 5;
    };
    g();
    println("{}", y);
}
