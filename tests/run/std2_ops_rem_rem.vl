// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops Rem::rem.
// EXPECT: V { x: 2 } 2
use std::ops::Rem;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Rem for V {
    type Output = V;

    fn rem(self, rhs: V) -> V {
        V { x: self.x % rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.rem(b), Rem::rem(12i64, 5));
}
