// EDITION: rust
// The std2 item(s): std::clone Clone for tuples (one to six elements).
// RUSTC: none (Vec::from_elem_in is vole's)
// EXPECT: [(-1, -1), (-1, -1), (-1, -1)]
// EXPECT: (1, "a", (2,)) (1, "a", (2,))
// EXPECT: (1, 2, 3, 4, 5, 6)
fn main(gpa: Gpa) {
    let v: Vec<(i64, i64), Gpa> = Vec::from_elem_in((-1i64, -1i64), 3, gpa);
    println("{:?}", v);
    let t = (1i64, String::from_in("a", gpa), (2u8,));
    let u = t.clone();
    println("{:?} {:?}", u, t);
    let six = (1, 2, 3, 4, 5, 6);
    println("{:?}", six.clone());
}
