// Labels, `continue`, `break` and a guard in the body of a `for` over an
// iterator (0.14): the loop keeps its label, `continue` takes the next
// item, and a guard made in the body is dropped at the end of each pass
// (0.26.2: a guard, as `defer` was).
// EXPECT: 1 2 | 2 4
// EXPECT: a;b;c;
// EXPECT: 10 30 50
// EXPECT: found 7
struct Evens { n: i64 }

// Prints `;` when it is dropped.
struct Semi { at: i64 }

impl Drop for Semi {
    fn drop(inout self) { print(";"); }
}

impl Iterator for Evens {
    type Item = i64;

    fn next(inout self) -> Option<i64> {
        self.n += 2;
        if self.n > 10 { None } else { Some(self.n) }
    }
}

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    outer: for x in v.iter() {
        for y in v {
            if y == 2 {
                continue :outer;
            }
            if x == 3 {
                break :outer;
            }
            std::print_int(x * y);
            print(" ");
        }
    }
    print("|");
    for e in (Evens { n: 0 }) {
        if e > 4 {
            break;
        }
        print(" ");
        std::print_int(e);
    }
    println("");

    let names = ["a", "b", "c"];
    for k in 0..3 {
        let _semi = Semi { at: k };
        print(names[k]);
    }
    println("");

    var first = true;
    for x in 10..60 {
        if x % 20 != 10 {
            continue;
        }
        if !first {
            print(" ");
        }
        first = false;
        std::print_int(x);
    }
    println("");

    let found = loop {
        var hit = 0;
        for x in (Evens { n: -1 }) {
            if x % 7 == 0 {
                hit = x;
                break;
            }
        }
        break hit;
    };
    print("found ");
    std::print_int(found);
    println("");
    0
}
