// EDITION: rust
// (0.27.0) Hand-translated from tests/run/own_const_views.vl to Rust's spelling.
// (0.17, T7) A const (or a static without mut) is never written: viewing
// it across a call with global effects (println) is not own.static.
const A: [&str; 2] = ["a", "b"];

fn main() -> i32 {
    for t in A[..].iter() {
        println("{t}");
    }
    0
}
// EXPECT: a
// EXPECT: b
// Runs on std2 since its gap closed (0.27.2.1).
