// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::convert TryInto::try_into.
// EXPECT: 6
use std::convert::{Infallible, TryFrom, TryInto};

struct Even {
    v: i64,
}

impl TryFrom<i64> for Even {
    type Error = i64;

    fn try_from(v: i64) -> Result<Even, i64> {
        if v % 2 == 0 { Ok(Even { v: v }) } else { Err(v) }
    }
}

fn main() {
    let e: Even = match 6i64.try_into() {
        Ok(e) => e,
        Err(_) => Even { v: 0 },
    };
    println("{}", e.v);
}
