// XFAIL: RT-395: (RT-395's mechanism, passed on) `fn g<T: Tr<Out = i32>>(t: &T) -> i32 { f(t) }` with `fn f<T: Tr>(t: &T) -> T::Out` and `trait Tr<U = i32>` is refused, "'W::Out' is 'Big', but the bound 'T: Tr<Out = i32>' of 'g' requires 'i32'": the default is not applied, Tr<i64>'s Out is taken; rustc prints 32 (0.30.2)
// From the review of g302oblig-m2 (form f270o3). Since v0.30.1 at least;
// the release build the same. Both bounds are Tr<i32>, whose Out is i32.
// Siblings: rt_395 (wrong code), rt_395c, rt_395d, rt_395e.
// EXPECT: 32
trait Tr<U = i32> {
    type Out;
    fn mk(&self) -> Self::Out;
}

struct W {
    r: i64,
}

struct Big {
    a: i64,
    b: i64,
    c: i64,
}

impl Tr<i64> for W {
    type Out = Big;

    fn mk(&self) -> Big {
        Big { a: 1, b: 2, c: 3 }
    }
}

impl Tr<i32> for W {
    type Out = i32;

    fn mk(&self) -> i32 {
        32
    }
}

fn f<T: Tr>(t: &T) -> T::Out {
    t.mk()
}

fn g<T: Tr<Out = i32>>(t: &T) -> i32 {
    f(t)
}

fn main() {
    println("{}", g(&W { r: 0 }));
}
