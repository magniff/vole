// XFAIL: RT-237b: (RT-237's unzip form) a program fn returning std's unzip_in result, `-> (FX, FY)`, called with `v.iter().map(|e| (e, *e))`, does not keep the borrow of the iterator: drop(v) then reading the result is a use after free from safe code (0.30.2)
// rustc E0505 at drop(v). The release build checks it clean, and
// --check-alloc stops with `use after free`. The tuple Item that the
// closure's return type gives Map is not tied element by element to FX
// and FY (a projection through an Fn bound); `split(pairs.into_iter())`
// is refused. Split from rt_237, whose partition_in form is fixed.
// FLAGS: --check-alloc
// ERROR: line 22
use std::alloc::Allocator;

fn split<I: Iterator<Item = (X, Y)>, X, Y, FX: DefaultIn<A> + Extend<X>,
    FY: DefaultIn<A> + Extend<Y>, A: Allocator + Clone>(it: I, a: A) -> (FX, FY) {
    it.unzip_in(a)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    v.push(1001);
    let (s, t): (Vec<&i64, Gpa>, Vec<i64, Gpa>) =
        split(v.iter().map(|e| (e, *e)), gpa);
    drop(v);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?} {:?}", s, t, x);
}
