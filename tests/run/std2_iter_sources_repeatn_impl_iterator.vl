// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter::sources RepeatN::impl Iterator.
// EXPECT: Some(1) Some(1) None

fn main() {
    let mut r = std::iter::repeat_n(1i64, 2);
    let a = r.next();
    let b = r.next();
    println("{:?} {:?} {:?}", a, b, r.next());
}
