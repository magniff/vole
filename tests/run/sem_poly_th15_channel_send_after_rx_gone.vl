// send after the receiver is dropped: Err(x) gives x back, dropped once
// FLAGS: --check-alloc
// EXPECT: back 5
// EXPECT: drop 5
// EXPECT: end
use std::sync::mpsc;
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

fn main(gpa: Gpa) {
    let (tx, rx) = mpsc::channel_in::<R, Gpa>(gpa);
    drop(rx);
    match tx.send(R { id: 5 }) {
        Ok(_) => println("sent"),
        Err(e) => println("back {}", e.0.id),
    }
    println("end");
}
