// EDITION: rust
// Ranges at the integer extremes run exactly their length: no wrap into an
// endless loop, no lost iteration.
// EXPECT: 2 3 2 6 3 0 1
// EXPECT: 9223372036854775807
static mut Z: i64 = 0;

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let max = 9223372036854775807 + unsafe { Z };
    let min = -9223372036854775807 - 1 + unsafe { Z };
    let mut n: i64 = 0;
    for _ in max - 2..max { n += 1; }
    print("{n} ");
    n = 0;
    for _ in max - 2..=max { n += 1; }
    print("{n} ");
    n = 0;
    for _ in min..min + 2 { n += 1; }
    print("{n} ");
    n = 0;
    let lo: u8 = 250 + unsafe { Z } as u8;
    let hi: u8 = 255 + unsafe { Z } as u8;
    for _ in lo..=hi { n += 1; }
    print("{n} ");
    n = 0;
    let ilo: i8 = 125 + unsafe { Z } as i8;
    let ihi: i8 = 127 + unsafe { Z } as i8;
    for _ in ilo..=ihi { n += 1; }
    print("{n} ");
    n = 0;
    for _ in max..min { n += 1; }
    print("{n} ");
    n = 0;
    for _ in max..=max { n += 1; }
    println("{n}");
    let mut last: i64 = 0;
    for i in max - 1..=max { last = i; }
    println("{}", last);
    0
}
