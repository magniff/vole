// (0.30.2, RT-138) A generic trait impl's constants defined by each other,
// met through a generic function's instance: rustc E0391.
// ERROR: const.cycle
trait T {
    const A: i64;
    const B: i64;
}

struct W<X> {
    x: X,
}

impl<X> T for W<X> {
    const A: i64 = Self::B;
    const B: i64 = Self::A - 1;
}

fn get<Y: T>() -> i64 {
    Y::B
}

fn main() {
    println("{}", get::<W<bool>>());
}
