// EDITION: rust
// The std2 item(s): std::str str::floor_char_boundary.
// floor_char_boundary and ceil_char_boundary, as Rust's (1.91).
// EXPECT: 0 1 1 3 4
// EXPECT: 0 1 3 3 4
// EXPECT: 4 4 4 8
// EXPECT: 4 8 8 8
// EXPECT: 0 0
fn main() {
    let s = "a\u{e9}b";
    println("{} {} {} {} {}", s.floor_char_boundary(0), s.floor_char_boundary(1),
        s.floor_char_boundary(2), s.floor_char_boundary(3), s.floor_char_boundary(9));
    println("{} {} {} {} {}", s.ceil_char_boundary(0), s.ceil_char_boundary(1),
        s.ceil_char_boundary(2), s.ceil_char_boundary(3), s.ceil_char_boundary(9));
    let e = "\u{1f600}\u{1f600}";
    println("{} {} {} {}", e.floor_char_boundary(5), e.floor_char_boundary(6),
        e.floor_char_boundary(7), e.floor_char_boundary(8));
    println("{} {} {} {}", e.ceil_char_boundary(4), e.ceil_char_boundary(5),
        e.ceil_char_boundary(7), e.ceil_char_boundary(100));
    println("{} {}", "".floor_char_boundary(3), "".ceil_char_boundary(0));
}
