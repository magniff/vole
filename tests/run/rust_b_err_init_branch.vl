struct P {
    a: i64,
    b: &'static i64,
}

impl P {
    fn get(&self) -> i64 {
        self.a + *self.b
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

struct Q {
    r: i64,
    s: i64,
}

struct O {
    q: Q,
    z: i64,
}

union U {
    x: i64,
    y: u32,
}

static THREE: i64 = 3;

fn branch(c: bool) {
    let mut p: P;
    if c {
        p = P { a: 1, b: &THREE };
    }
    p.a = 2;
}

fn branch_read(c: bool) {
    let p: P;
    if c {
        p = P { a: 1, b: &THREE };
    }
    println("{}", *p.b);
}

fn branch_field(c: bool) {
    let mut p: P;
    if c {
        p.a = 1;
    } else {
        p = P { a: 2, b: &THREE };
    }
    println("{}", p.a);
}

fn main() {
    branch(true);
    branch_read(true);
    branch_field(true);
}
