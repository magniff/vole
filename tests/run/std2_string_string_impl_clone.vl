// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl Clone.
// EXPECT: abc abcd
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    let mut t = s.clone();
    t.push('d');
    println("{} {}", s, t);
}
