// EDITION: rust
// RULE: F16.3
// (0.27.3) `write(w, ..)` and `writeln` on an io::Write (a Vec<u8>, Stdout,
// a generic `W: io::Write`) write through it as Rust's io::Write::write_fmt,
// their value an io::Result<()>; on a fmt::Write (a String) as before.
// EXPECT: "x=3 y=[3, 4]\n7"
// EXPECT: to stdout 1
// EXPECT: 1-2
use std::fmt::Write as FmtWrite;
use std::io::{Write, self};

fn put<W: Write>(w: &mut W, x: i64) -> io::Result<()> {
    write(w, "x={} ", x)?;
    writeln(w, "y={:?}", [x, x + 1])
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    put(&mut v, 3).unwrap();
    write(&mut v, "{}", 7).unwrap();
    println("{:?}", std::str::from_utf8(&v).unwrap());
    let mut out = io::stdout();
    writeln(&mut out, "to stdout {}", 1).unwrap();
    let mut s = String::new_in(gpa);
    let _ = write(&mut s, "{}-{}", 1, 2);
    println("{}", s);
}
