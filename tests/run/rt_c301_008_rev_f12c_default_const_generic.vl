// RULE: F8.3, F8.4
// RT-C301-8 review (R1, form f12c_default_const_generic): `T::L` of a default constant through a bound, S having another trait's K.
// rustc prints the EXPECT lines.
// EXPECT: 10
trait A { const K: i64; const L: i64 = Self::K * 2; }
trait B { const K: i64; }
struct S;
impl A for S { const K: i64 = 5; }
impl B for S { const K: i64 = 7; }
fn g<T: A>() -> i64 { T::L }
fn main() { println("{}", g::<S>()); }
