// RULE: D8.5
// (0.27.2.1) `a + b` is `Add::add(a, b)`: both operands move into `add`,
// and each is dropped once (it was a borrowed copy, dropped again at the
// end of main: a double free).
// EXPECT: 3
// EXPECT: drop 3
use std::ops::Add;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl Add for D {
    type Output = D;

    fn add(self, o: D) -> D {
        let n = self.n + o.n;
        std::mem::forget(self);
        std::mem::forget(o);
        D { n: n }
    }
}

fn main() {
    let a = D { n: 1 };
    let b = D { n: 2 };
    let c = a + b;
    println("{}", c.n);
}
