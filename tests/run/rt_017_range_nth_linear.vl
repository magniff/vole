// XFAIL: RT-17: a Range's nth (and so step_by and skip) walks every element: a large step never ends (open)
// std::ops::Range has no nth of its own: Iterator's default calls next n
// times, and StepBy::next is `self.iter.nth(self.step)`. Rust's Range
// implements nth in O(1), so this program prints at once (rustc: the three
// steps 0, 9223372036854775807, 18446744073709551614, and 2 for the
// skip); vole runs 2^63 nexts per step and is stopped by the time limit
// (the case costs the runner's TIMEOUT at each level until it is fixed).
// EXPECT: 0 9223372036854775807 18446744073709551614
// EXPECT: 2
#[inline(never)]
fn id<T>(x: T) -> T {
    x
}

fn main(gpa: Gpa) {
    let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);
    for i in (id(0u64)..id(u64::MAX)).step_by(id(u64::MAX / 2) as usize) {
        v.push(i);
    }
    println("{} {} {}", v[0], v[1], v[2]);
    let n = (id(0u64)..id(u64::MAX)).skip(id(u64::MAX - 2) as usize).count();
    println("{n}");
}
