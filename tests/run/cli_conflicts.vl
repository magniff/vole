// std::cli (0.25.2): Command::subcommand_required (no subcommand: a
// MissingSubcommand error whose try: line names the visible subcommands)
// and Arg::conflicts_with (both given: an ArgumentConflict naming both as
// written, the later first; '|' for several names), exit code 2.
// EXPECT: $ tool
// EXPECT: error: missing command for 'tool'
// EXPECT: try: tool <sum|remote|one>
// EXPECT: usage: tool [options] <command>
// EXPECT: [MissingSubcommand 2]
// EXPECT:   display: error: missing command for 'tool'
// EXPECT: try: --help
// EXPECT: $ tool remote
// EXPECT: error: missing command for 'tool remote'
// EXPECT: try: tool remote <add|remove>
// EXPECT: usage: tool remote [options] <command>
// EXPECT: [MissingSubcommand 2]
// EXPECT:   display: error: missing command for 'remote'
// EXPECT: try: --help
// EXPECT: $ tool one
// EXPECT: error: missing command for 'tool one'
// EXPECT: try: tool one only
// EXPECT: usage: tool one [options] <command>
// EXPECT: [MissingSubcommand 2]
// EXPECT:   display: error: missing command for 'one'
// EXPECT: try: --help
// EXPECT: $ tool remote add
// EXPECT: remote add
// EXPECT: $ tool --help
// EXPECT: tool
// EXPECT:
// EXPECT: usage: tool [options] <command>
// EXPECT:
// EXPECT: options:
// EXPECT:   -h, --help     print this help
// EXPECT:
// EXPECT: commands:
// EXPECT:   sum            checksums
// EXPECT:   remote
// EXPECT:   one
// EXPECT: [Help 0]
// EXPECT:   display: help requested: cmd.exit(e) prints it
// EXPECT: $ tool sum -b x
// EXPECT: sum binary=true text=false
// EXPECT: $ tool sum -b -t x
// EXPECT: error: '-t' cannot be used with '-b'
// EXPECT: try: drop '-t' (or '-b')
// EXPECT: usage: tool sum [options] [file]...
// EXPECT: [ArgumentConflict 2]
// EXPECT:   display: error: '-t' cannot be used with '-b'
// EXPECT: try: drop '-t' (or '-b')
// EXPECT: $ tool sum --text x -b
// EXPECT: error: '-b' cannot be used with '--text'
// EXPECT: try: drop '-b' (or '--text')
// EXPECT: usage: tool sum [options] [file]...
// EXPECT: [ArgumentConflict 2]
// EXPECT:   display: error: '-b' cannot be used with '--text'
// EXPECT: try: drop '-b' (or '--text')
// EXPECT: $ tool sum -tb
// EXPECT: error: '-b' cannot be used with '-t'
// EXPECT: try: drop '-b' (or '-t')
// EXPECT: usage: tool sum [options] [file]...
// EXPECT: [ArgumentConflict 2]
// EXPECT:   display: error: '-b' cannot be used with '-t'
// EXPECT: try: drop '-b' (or '-t')
// EXPECT: $ tool sum --tag -t
// EXPECT: error: '-t' cannot be used with '--tag'
// EXPECT: try: drop '-t' (or '--tag')
// EXPECT: usage: tool sum [options] [file]...
// EXPECT: [ArgumentConflict 2]
// EXPECT:   display: error: '-t' cannot be used with '--tag'
// EXPECT: try: drop '-t' (or '--tag')
use std::cli::{Arg, Command};

fn show(cmd: Command, line: str, gpa: Gpa) {
    println(f"$ {line}");
    match cmd.parse(line.split(' ')) {
        Ok(m) => match m.subcommand() {
            Some((name, sub)) => match sub.subcommand_name() {
                Some(n) => println(f"{name} {n}"),
                None => println(f"{name} binary={sub.flag("binary")} text={sub.flag("text")}"),
            },
            None => println("none"),
        },
        Err(e) => {
            print(cmd.render_in(e, gpa).as_slice());
            println(f"[{e.kind:?} {e.exit_code()}]");
            println(f"  display: {e}");
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("tool", gpa).subcommand_required()
        .subcommand(Command::new_in("sum", gpa).about("checksums")
            .arg(Arg::flag("binary").short('b').conflicts_with("text"))
            .arg(Arg::flag("text").short('t'))
            .arg(Arg::flag("tag").conflicts_with("binary|text"))
            .arg(Arg::positional("file").multiple()))
        .subcommand(Command::new_in("remote", gpa).subcommand_required()
            .subcommand(Command::new_in("add", gpa))
            .subcommand(Command::new_in("remove", gpa))
            .subcommand(Command::new_in("rm", gpa).hide()))
        .subcommand(Command::new_in("one", gpa).subcommand_required()
            .subcommand(Command::new_in("only", gpa)));
    show(cmd, "tool", gpa);
    show(cmd, "tool remote", gpa);
    show(cmd, "tool one", gpa);
    show(cmd, "tool remote add", gpa);
    show(cmd, "tool --help", gpa);
    show(cmd, "tool sum -b x", gpa);
    show(cmd, "tool sum -b -t x", gpa);
    show(cmd, "tool sum --text x -b", gpa);
    show(cmd, "tool sum -tb", gpa);
    show(cmd, "tool sum --tag -t", gpa);
    0
}
