// XFAIL: gap 8: errors at other places or codes: MVS own.conflict@23:13; own.conflict@25:25; own.conflict@28:13; own.confli...
// 0.17 (value semantics, T2): own.conflict, one per rule. (0.20: a let
// parameter of a plain type is a copy, so the first rule's 'a' is a Vec.)
// ERROR: 'a' has an inout access, '&a', and is read by 'a' in the same call
// ERROR: the receiver 'rng' of 'rng.big(1 + rng.next() % 600)' is changed by its own argument 'rng.next()'
// ERROR: 'b' is read while 'r'
// ERROR: 'grow(&arr)' may change 'arr' while 'view'
// ERROR: 'grow(&arr)' may change what argument 'arr[..]'
#[derive(Clone, Copy)] struct Rng { s: i64 }

impl Rng {
    fn next(&mut self) -> i64 { self.s = self.s * 7 + 1; self.s }
    fn big(&mut self, k: i64) -> i64 { self.s + k }
}

fn add(to: &mut Vec<i64, Gpa>, from: &Vec<i64, Gpa>) { to.push(from.len() as i64); }
fn first(s: &[i64]) -> i64 { s[0] }
fn grow(v: &mut [i64; 4]) -> i64 { v[0] += 1; 0 }
fn sum(s: &[i64], k: i64) -> i64 { s[0] + k }

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    add(&mut a, &a);
    let mut rng = Rng { s: 1 };
    let x = { let at_arg1 = 1 + rng.next() % 600; rng.big(at_arg1) };
    let mut b: i64 = 2;
    let r = &mut b;
    let c = b + 1;
    *r += 1;
    let mut arr = [1i64, 2, 3, 4];
    let view = &arr[..];
    grow(&mut arr);
    let y = first(view);
    let z = sum(&arr[..], grow(&mut arr));
    println("{} {x} {c} {y} {z}", a.len());
}
