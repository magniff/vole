// RULE: D4.6
// (0.30.1) A declaration's inferred outlives requirements are the least
// fixpoint over the declarations it names, itself included: in `L<'a,
// 'b, T>`, `T: 'a` from x and L's use of itself with its lifetimes
// swapped give `T: 'b` too, so `conv` may return the `&'c i64` its T
// holds as a `&'b i64`, as rustc's RFC 2093 inference accepts. Before,
// a declaration met again on the walk added nothing, and `conv` was
// borrowck.outlives ('c must outlive 'b).
// EXPECT: 5 5
struct L<'a, 'b, T> {
    x: &'a T,
    y: Option<&'a L<'b, 'a, T>>,
}

fn conv<'a, 'b, 'c>(l: &L<'a, 'b, &'c i64>, r: &'c i64) -> &'b i64 {
    let _ = l;
    r
}

fn conv2<'a, 'b, 'c>(l: &L<'a, 'b, &'c i64>, r: &'c i64) -> &'a i64 {
    let _ = l;
    r
}

fn main() {
    let v = 5i64;
    let rv = &v;
    let l: L<&i64> = L { x: &rv, y: None };
    println("{} {}", *conv(&l, rv), *conv2(&l, rv));
}
