// EXIT: 127
mod hidden {
    pub trait H {
        fn eq(&self, o: &Self) -> bool;
    }

    impl<X> H for X {
        fn eq(&self, o: &Self) -> bool {
            false
        }
    }
}

#[derive(PartialEq)]
struct P {
    k: i64,
}

fn geq<T: PartialEq>(a: &T, b: &T) -> bool {
    a == b
}

fn bit(b: bool, n: i32) -> i32 {
    if b { n } else { 0 }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(1);
    let x = 1i64;
    let y = 1i64;
    bit(v == u, 1) + bit(geq(&x, &y), 2) + bit([1i64, 2] == [1i64, 2], 4) + bit(Some(3i64)
        == Some(3i64), 8)
        + bit(x == y, 16) + bit(P { k: 1 } == P { k: 1 }, 32) + bit(v.contains(&1), 64)
}
