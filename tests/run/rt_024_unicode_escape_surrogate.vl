// RT-24 (fixed in 0.30.1), checked: a `\u{...}` that names a surrogate,
// D800 to DFFF, is no scalar and is refused in a str (lex_unicode_escape),
// as Rust's `invalid unicode character escape`.
// ERROR: invalid unicode escape
// ERROR-COUNT: 1
fn main() {
    let s = "\u{D800}";
    println("{:?}", s.as_bytes());
}
