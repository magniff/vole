// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option IterMut::impl Iterator.
// EXPECT: true Some(4)
use std::option::Option;

fn main() {
    let mut a: Option<i64> = Some(3);
    let mut it = a.iter_mut();
    if let Some(x) = it.next() {
        *x += 1;
    }
    let done = it.next().is_none();
    println("{} {:?}", done, a);
}
