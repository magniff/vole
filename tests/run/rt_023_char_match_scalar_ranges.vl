// XFAIL: RT-23: a char match over the two ranges of scalar values is refused as not exhaustive (open)
// A char is a Unicode scalar value: 0..=D7FF and E000..=10FFFF are all
// of them, and rustc takes the match as exhaustive. vole refuses it:
// "non-exhaustive match: '55296..=57343' is not covered", and its try:
// line asks for arms over the surrogates and 1114112..=4294967295,
// values no char has.
// EXPECT: 1 2 2
fn class(c: char) -> i64 {
    match c {
        '\u{0}'..='\u{D7FF}' => 1,
        '\u{E000}'..='\u{10FFFF}' => 2,
    }
}

fn main() {
    println("{} {} {}", class('a'), class('\u{E000}'), class('\u{10FFFF}'));
}
