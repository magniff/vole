// XFAIL: RT-107: Option<&T> is 16 bytes; Rust guarantees the null-pointer niche (8, the size of &T), so FFI and transmute code built on it breaks (0.30.2)
// rustc prints the EXPECT line.
// EXPECT: 8 8 8
use std::mem::size_of;

enum E<'a> {
    R(&'a u8),
    N,
}

fn main() {
    println("{} {} {}", size_of::<Option<&'static u8>>(), size_of::<Option<&'static mut i64>>(),
        size_of::<E<'static>>());
}
