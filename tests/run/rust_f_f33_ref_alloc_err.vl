// RULE: F33.1
// A reference is looked through, as before: `&'a Node<Gpa>` holds Gpa,
// which the struct's parameters do not name.
// ERROR: error[alloc.field]: the struct 'Handle' holds an allocator its parameters do not name: 'Gpa', in field 'node'
use std::alloc::Allocator;

struct Node<A: Allocator> {
    next: Vec<u8, A>,
}

struct Handle<'a> {
    node: &'a Node<Gpa>,
}

fn main() {}
