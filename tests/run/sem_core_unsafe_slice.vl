// EDITION: rust
// Slicing a raw pointer outside unsafe.
// ERROR: error[unsafe]
// ERROR: line 7, column 13
fn main() -> i32 {
    let mut a = [1i64, 2]; let p = a.as_mut_ptr() as *mut i64;
    let s = std::slice::from_raw_parts(p.add((0) as usize), (2 - (0)) as usize);
    println("{}", s.len()); 0
}
