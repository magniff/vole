// (0.30.2, obligations M1) Review 5's m05: the chosen impl, `Tr<i32>`'s,
// needs `'a: 'static`; its predicates are required where go is called with a
// short W (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Tr<U> { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> &'static str { self.r } }
impl<'a> Tr<i64> for W<'a> { fn f(&self) -> &'static str { "64" } }
fn go<T: Tr<i32>>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = {
        let st = String::from_in("hello heap string long", gpa); let x = W { r: st.as_str() };
        go(&x)
    };
    let w = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{}", s); println("{}", w);
}
