// XFAIL: RT-430c: WRONG CODE: with a blanket `impl<X: ?Sized> Size for X { fn len(&self) -> usize { 0 } }` in scope, `a.len()` on an `[i64; 3]` runs the slice's len and prints 3; rustc probes the array by value first, where Size::len (autoref) applies before unsizing to [i64], and prints `0 3` (the slice's own `s.len()` is 3 in both) (0.30.2)
// From red team round 9's leads (r302i COVERAGE.md). Since v0.30.1 at
// least (v0.30.1 prints `3 3` too). RT-430's family: a program's blanket
// impl against std's method of the same name.
// EXPECT: 0 3
trait Size {
    fn len(&self) -> usize;
}

impl<X: ?Sized> Size for X {
    fn len(&self) -> usize {
        0
    }
}

fn main() {
    let a: [i64; 3] = [1, 2, 3];
    let s: &[i64] = &a;
    println("{} {}", a.len(), s.len());
}
