// FLAGS: --check-alloc
// RULE: Z5.1
// The std item(s): std::alloc Gpa (the checking allocator, --check-alloc).
// EXPECT: live 1
// EXPECT: live 2 1
// STDERR: check-alloc: 1 block of Gpa not freed (32 bytes):
// STDERR:   block #1 (32 bytes), allocated at std_alloc_check_leak.vl:15:5
// A Vec forgotten (mem::forget) leaks its buffer: the checking Gpa counts
// its live blocks and lists the ones left at exit (the exit status is
// unchanged); the second Vec drops at main's end.
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    println("live {}", gpa.live_blocks());
    std::mem::forget(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(3);
    println("live {} {}", gpa.live_blocks(), w.len());
}
