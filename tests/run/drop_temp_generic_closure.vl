// (0.29) The temporary a closure returns, called directly and through a
// generic function whose result is the closure's (`call<X, F: Fn() -> X>(f:
// &F) -> X`), lent or read, is dropped at the end of its statement (the
// generic one's leaked, as drop_temp_generic_result's).
// EXPECT: a 4
// EXPECT: d2
// EXPECT: b 4
// EXPECT: d3
// EXPECT: c 4
// EXPECT: d4
// EXPECT: d 4
// EXPECT: d5
// EXPECT: e 4
// EXPECT: d6
// EXPECT: f 4
// EXPECT: d7
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn call<X, F: Fn() -> X>(f: &F) -> X {
    f()
}

fn call_with<X: Clone, F: Fn(&X) -> X>(f: F, x: &X) -> X {
    f(x)
}

fn run() {
    let t = mk(4);
    let f = || t.clone();
    println("a {}", obs(&f()));
    println("b {}", f().v);
    println("c {}", obs(&call(&f)));
    println("d {}", call(&f).v);
    println("e {}", obs(&call_with(|x: &T| x.clone(), &t)));
    println("f {}", call_with(|x: &T| x.clone(), &t).v);
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
