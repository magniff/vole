// XFAIL: gap 8: compile borrowck.move_out: cannot move out of 'a', a captured variable in an `FnMut` closure
// a sink closure moving its capture out on one call only: the R dropped once, by the move or the closure's drop
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: 1
// EXPECT: drop 2
// EXPECT: 0
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
fn eat(r: R) -> i64 { r.id }
fn run<F: FnMut(bool) -> i64>(f: F, k: bool) -> i64 { f(false) + f(k) }

fn main() {
    let a = R { id: 1 };
    let b = R { id: 2 };
    println("{}", run(move |m: bool| if m { eat(a) } else { 0 }, true));
    println("{}", run(move |m: bool| if m { eat(b) } else { 0 }, false));
    println("end");
}
