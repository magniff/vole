// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) reject: the callee stores a view of s into out, then grows s (out outlives the call)
// ERROR: error[own.conflict]
fn f(out: inout Vec<str, Gpa>, s: inout String<Gpa>) {
    out.push(s.as_str());
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
}

fn main(gpa: Gpa) -> i32 {
    var s = String::from_in("hello", gpa);
    var out: Vec<str, Gpa> = Vec::new_in(gpa);
    f(&out, &s);
    println(out.get(0));
    0
}
