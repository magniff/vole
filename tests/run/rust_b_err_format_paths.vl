// RULE: D2.9
// (0.30.1) Every format path binds its holes by borrow until its writes
// are done: print and println, eprint, format_in, assert's message,
// format_args, fmt::write and writeln, an inline capture (evaluated after
// the explicit arguments, as rustc's format_args), and panic's message
// (its own path, written in place, whose call never returns: the hidden
// borrow is used last at that call, places/build.vl mention_open). A
// later argument that moves the hole's place is rustc's E0505 (E0382 for
// the inline capture). Before, panic's was accepted and freed the String
// it then printed.
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.use_moved]
// ERROR: error[borrowck.move_borrowed]
// ERROR: error[borrowck.move_borrowed]
// ERROR-COUNT: 9
fn main(gpa: Gpa) {
    let s1 = String::from_in("a", gpa);
    println("{} {}", s1, { drop(s1); 1 });
    let s2 = String::from_in("b", gpa);
    eprint("{} {}", s2, { drop(s2); 1 });
    let s3 = String::from_in("c", gpa);
    let f = format_in("{} {}", s3, { drop(s3); 1 }, gpa);
    let mut out = String::new_in(gpa);
    let s5 = String::from_in("e", gpa);
    assert(f.len() > 0, "{} {}", s5, { drop(s5); 1 });
    let s6 = String::from_in("f", gpa);
    let a = format_args("{} {}", s6, { drop(s6); 1 });
    println("{}", a);
    let s7 = String::from_in("g", gpa);
    write(&mut out, "{} {}", s7, { drop(s7); 1 });
    let s8 = String::from_in("h", gpa);
    println("{s8} {}", { drop(s8); 1 });
    let s9 = String::from_in("i", gpa);
    writeln(&mut out, "{} {}", s9, { drop(s9); 1 });
    let s10 = String::from_in("j", gpa);
    debug_assert(f.len() > 0, "{} {}", s10, { drop(s10); 1 });
    println("{}", out);
    let s11 = String::from_in("l", gpa);
    if out.len() > 100 {
        panic("{} {}", s11, { drop(s11); 1 });
    }
}
