// The inner index of a nested array is checked against the inner length.
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut g = [[0i64; 3]; 2];
    g[1][2] = 5;
    println("{}", g[0][(3 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
