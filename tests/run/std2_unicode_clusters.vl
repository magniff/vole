// EDITION: rust
// The std2 item(s): std::unicode: props, grapheme_class, GraphemeState,
// next_grapheme_end, count_graphemes, graphemes (Graphemes::offset),
// props_width, char_width, char_width_cjk, ClusterWidth, cluster_width,
// str_width, str_width_chars, lossy_next, ascii_printable_prefix_len,
// UNICODE_VERSION.
// RUSTC: none (vole's own: Rust's std has no segmentation or width)
// EXPECT: (18, 0, 0) 0 4 6 14 true
// EXPECT: 1 2 0 -1 1 2 2
// EXPECT: 5 [1, 3, 8, 25, 2] 39
// EXPECT: true false false true false true
// EXPECT: 10 6 12 10 2 2 1
// EXPECT: 61 ef bf bd | 3 1 65533 65533 8364 128512 11
// EXPECT: 5 0 3 21 2
// EXPECT: 11 12 2 4
use std::unicode::{
    ClusterWidth, GCB_EXTEND, GCB_EXT_PICT, GCB_OTHER, GCB_REGIONAL_INDICATOR, GraphemeState,
    PROP_EMOJI, UNICODE_VERSION, ascii_printable_prefix_len, char_width, char_width_cjk,
    cluster_width, count_graphemes, grapheme_class, graphemes, lossy_next, next_grapheme_end, props,
    props_width, str_width, str_width_chars,
};

fn main(gpa: Gpa) {
    println("{:?} {} {} {} {} {}", UNICODE_VERSION, grapheme_class(0x61), grapheme_class(0x301),
        grapheme_class(0x1f1e6), grapheme_class(0x1f600), (props(0x1f600) & PROP_EMOJI) != 0);
    println("{} {} {} {} {} {} {}", char_width(0x61), char_width(0x4eac), char_width(0x301),
        char_width(0x0a), char_width(0xa1), char_width_cjk(0xa1),
        props_width(props(0x1f600), false));
    // a, e + acute, CR LF... : "a", "é" (2 code points), a flag, a family
    let text = "ae\u{301}\u{1f1e9}\u{1f1ea}\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}\u{200d}\u{1f466}\r\n";
    let s = text.as_bytes();
    let mut ends: Vec<usize, Gpa> = Vec::new_in(gpa);
    let mut it = graphemes(s);
    loop {
        match it.next() {
            Some(g) => ends.push(g.len()),
            None => break,
        }
    }
    let mut sum = 0;
    for n in &ends {
        sum += *n;
    }
    println("{} {:?} {}", count_graphemes(s), ends, it.offset() + sum - s.len());
    let mut st = GraphemeState::new();
    let a = st.push(0x61);
    let b = st.push(0x301);
    let c = st.push(0x200d);
    let d = st.push(0x62);
    let mut ri = GraphemeState::new();
    ri.push(0x1f1e9);
    let e = ri.push(0x1f1ea);
    let f = ri.push(0x1f1eb);
    println("{a} {b} {c} {d} {e} {f}");
    // widths: a wide text, clusters against code points, the variation selectors
    let w = "日本語 abc".as_bytes();
    println("{} {} {} {} {} {} {}", str_width(w, false), str_width(s, false),
        str_width_chars(s, false), str_width_chars(w, false),
        cluster_width("\u{1f468}\u{200d}\u{1f469}".as_bytes(), false),
        cluster_width("\u{2764}\u{fe0f}".as_bytes(), false),
        cluster_width("\u{2764}\u{fe0e}".as_bytes(), false));
    // broken UTF-8 reads as U+FFFD, a maximal part at a time
    let broken: [u8; 12] = [0x61, 0xff, 0xe2, 0x82, 0xe2, 0x82, 0xac, 0xf0, 0x9f, 0x98, 0x80, 0xc3];
    let mut out: Vec<u8, Gpa> = String::from_utf8_lossy_in(&broken[..2], gpa).into_bytes();
    print("{:x} {:x} {:x} {:x} | ", out[0], out[1], out[2], out[3]);
    out.clear();
    let mut i = 0;
    let mut cps: Vec<u32, Gpa> = Vec::new_in(gpa);
    while i < broken.len() - 1 {
        cps.push(lossy_next(&broken[..], &mut i));
    }
    let n = cps.len();
    println("{} {} {} {} {} {} {i}", ascii_printable_prefix_len("abc\ndef".as_bytes()),
        ascii_printable_prefix_len(&broken[..]), cps[1], cps[2], cps[3], cps[4]);
    let mut cw = ClusterWidth::start(0x1f44b, props(0x1f44b), false);
    cw.push(0x1f3fd, props(0x1f3fd));
    println("{} {} {} {} {}", n, str_width(&broken[..0], false),
        next_grapheme_end("a\u{301}b".as_bytes(), 0), next_grapheme_end(s, 20), cw.width());
    println("{} {} {} {}", GCB_OTHER + GCB_EXTEND + GCB_REGIONAL_INDICATOR + 1, GCB_EXT_PICT - 2,
        cluster_width("\u{1f1e9}\u{1f1ea}".as_bytes(), false),
        str_width("\u{a1}\u{a1}".as_bytes(), true));
}
