// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: a b (sort_by over views)
// EXPECT: a b
fn main(gpa: Gpa) -> i32 {
    let s = String::from_in("b a", gpa);
    let mut v: Vec<&str, Gpa> = s.split(b' ' as char).collect_in::<Vec<_, _>, _>(gpa);
    v.sort_unstable_by(|a, b| ({ let a = *a; let b = *b; if a < b { -1 } else { 1 } }).cmp(&0));
    println("{} {}", v[0usize], v[1usize]);
    0
}
