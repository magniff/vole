// EDITION: rust
// RULE: D2.7
// (0.27.2) A `Cell` changed through `&`: its methods write through a raw pointer, no exception is needed.
use std::cell::Cell;

fn tick(c: &Cell<i64>) {
    c.set(c.get() + 1);
}

fn main() {
    let c = Cell::new(1i64);
    tick(&c);
    tick(&c);
    println("{}", c.get());
}
// EXPECT: 3
