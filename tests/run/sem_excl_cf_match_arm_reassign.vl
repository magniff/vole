// EDITION: rust
// assigning the scrutinee inside an arm while the binding is live
// ERROR: borrowck.assign_borrowed
use std::alloc::Allocator; enum E<A: Allocator> { A(Vec<i64, A>), B }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let mut e = E::A(v);
    match &mut e { E::A(w) => { e = E::B; w.push(2); } E::B => {} }
}
