// RULE: M1
// (0.30.1) A `let _ =` inside a discarded block or branch only mentions
// its place (rustc's PlaceMention): a value never assigned passes there;
// a discarded tail of an assigned value is read and dropped.
// EXPECT: 2 4
struct D {
    v: i64,
}

fn main() {
    let c = true;
    let a: i64;
    {
        let _ = a;
    };
    let b: D;
    if c {
        let _ = b;
    } else {
        let _ = 1;
    };
    let e: i64;
    let n = {
        let _ = e;
        2
    };
    let f: i64;
    match c {
        _ => {
            let _ = f;
        }
    };
    let g = 3;
    { g };
    let d = D { v: 4 };
    if c { d.v } else { 0 };
    {
        let h: i64;
        let _ = h;
        5
    };
    println("{} {}", n, d.v);
}
