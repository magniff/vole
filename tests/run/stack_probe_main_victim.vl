// (0.30.2, RT-83) The main thread's stack, written by another thread's
// frame: macOS maps the first thread's stack just above the main thread's,
// its guard page between them. main's hold() keeps a 480 KB array and
// starts thread t (128 KiB stack), whose jump() has a 240 KB frame (the
// array in the branch not taken). v0.30.1 moved sp by the whole frame at
// once, past t's guard page, into main's stack: t wrote main's array
// (`main: canary sum before 46620000, after ...`, exit 0). Now t dies on
// its guard page, SIGBUS (exit 138), before anything is printed.
// REQUIRES: macos
// EXIT: 138
use std::thread;
use std::sync::atomic::{AtomicI64, Ordering};

static STAGE: AtomicI64 = AtomicI64::new(0);

#[inline(never)]
fn total(a: &[i64]) -> i64 {
    let mut t = 0;
    for x in a {
        t += *x;
    }
    t
}

#[inline(never)]
fn fill() -> i64 {
    let mut a = [0i64; 64];
    for i in 0..64 {
        a[i] = 1;
    }
    total(&a)
}

#[inline(never)]
fn jump(big: bool) -> i64 {
    if big {
        let b = [3i64; 30000];
        return total(&b);
    }
    fill()
}

#[inline(never)]
fn hold(gpa: Gpa) -> i64 {
    let canary = [777i64; 60000];
    let before = total(&canary);
    let h = thread::Builder::new()
        .stack_size(131072)
        .spawn_in(move || jump(STAGE.load(Ordering::SeqCst) > 5), gpa)
        .unwrap();
    let r = h.join().unwrap();
    println("t: {r}");
    let after = total(&canary);
    println("main: canary sum before {before}, after {after}");
    0
}

fn main(gpa: Gpa) {
    hold(gpa);
}
