// (0.30.1, review 4) rust_f_super_impl_predicates_err's impls with the
// bounds their supertraits' impls ask for, in the header or a `where`, or
// implied by the header's type (`&'a &'b str`: 'b outlives 'a); and an
// impl's `where 'a: 'static` read as its header's `'a: 'static` would be
// (a 'static trait's impl, review 4's a08, a12).
// EXPECT: y 3
// EXPECT: 1 1
trait Sup {
    type A;
}

trait Sub: Sup {
    fn get(&self) -> Self::A;
}

struct X<'p, 'q> {
    r: &'p str,
    s: &'q str,
}

struct Y<'p> {
    r: &'p str,
}

struct R<'p, 'q> {
    r: &'p &'q str,
}

impl<'a, 'b> Sup for X<'a, 'b> where 'a: 'b {
    type A = &'b str;
}

impl<'a: 'b, 'b> Sub for X<'a, 'b> {
    fn get(&self) -> &'b str {
        self.s
    }
}

impl<'a: 'static> Sup for Y<'a> {
    type A = &'static str;
}

impl<'a> Sub for Y<'a> where 'a: 'static {
    fn get(&self) -> &'static str {
        "y"
    }
}

impl<'a, 'b> Sup for R<'a, 'b> where 'b: 'a {
    type A = i64;
}

impl<'a, 'b> Sub for R<'a, 'b> {
    fn get(&self) -> i64 {
        self.r.len() as i64
    }
}

trait St: 'static {
    fn show(&self) -> i64;
}

struct W<'a> {
    r: &'a str,
}

impl<'a> St for W<'a> where 'a: 'static {
    fn show(&self) -> i64 {
        1
    }
}

impl<'a> St for fn(&'a str) where 'a: 'static {
    fn show(&self) -> i64 {
        1
    }
}

fn main() {
    let x = X { r: "p", s: "q" };
    let _ = x.get();
    let y = Y { r: "r" };
    let s: &'static str = "abc";
    let r = R { r: &s };
    println("{} {}", y.get(), r.get());
    let w = W { r: "w" };
    println("{} {}", w.show(), w.show());
}
