// (0.26.1) The places a cell is reached through, each the caller's or the
// container's: a requires check's binding of an argument (`arr[1]`), a
// match through a reference, a borrowing iterator's items in `for`, a Vec
// and a slice in `for`, a closure capturing by access. Every write is
// kept.
// EXPECT: 7 8
// EXPECT: 9 8 6
// EXPECT: 5
// EXPECT: 9 11
use std::cell::Cell;

enum Slot { Empty, Full(Cell<i64>) }

#[inline(never)]
fn bump(a: Cell<i64>, x: i64)
    requires x > 0
{
    a.set(x);
}

fn main(gpa: Gpa) {
    let arr = [Cell::new(1), Cell::new(1)];
    bump(arr[1], 7);
    var v: Vec<Cell<i64>> = Vec::new_in(gpa);
    v.push(Cell::new(1));
    v.push(Cell::new(1));
    bump(v[0], 8);
    println(f"{arr[1].get()} {v[0].get()}");
    for e in v.iter() {
        e.set(9);
    }
    let a = v[0].get();
    for e in v {
        e.set(8);
    }
    let b = v[1].get();
    let s: [Cell<i64>] = v.as_slice();
    for e in s {
        e.set(6);
    }
    println(f"{a} {b} {v[1].get()}");
    var w: Vec<Slot> = Vec::new_in(gpa);
    w.push(Slot::Full(Cell::new(1)));
    match w[0] {
        Slot::Full(c) => c.set(4),
        Slot::Empty => {}
    }
    for s in w.iter() {
        match s {
            Slot::Full(c) => c.set(c.get() + 1),
            Slot::Empty => {}
        }
    }
    match w[0] {
        Slot::Full(c) => println(f"{c.get()}"),
        Slot::Empty => {}
    }
    let k = Cell::new(1);
    let f = || k.set(9);
    f();
    let g = || k.set(k.get() + 1);
    let n = k.get();
    g();
    g();
    println(f"{n} {k.get()}");
}
