// RULE: F34.3 (0.30.2, RT-214) An array constant whose type is not Copy is
// a value made at each use, but an element is not moved out of it by an
// index (rustc E0508): `C[0]` is refused, `&C[0]` borrows it.
// ERROR: line 19
// ERROR-COUNT: 1
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

const C: [Option<D>; 2] = [None, None];

fn main() {
    let z = C[0];
    let r = &C[1];
    println("{} {}", z.is_none(), r.is_none());
}
