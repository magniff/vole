// RULE: D19.6
// (0.30.1, RT-33 round 4, F1) A closure whose inner closure writes through
// its captured `&mut` is FnMut; given where `F: Fn() + Sync` is bound, on
// two threads, it is rustc's E0525 at the closure (front/closures/kinds.vl
// infer_kind), and no body is borrow-checked with a kind it lacks.
// ERROR: error[closure.kind]: expected a closure that implements the `Fn` trait, but this closure only implements `FnMut`: it changes what it captures
// ERROR: line 21, column 13
// ERROR-COUNT: 1
use std::thread;

fn race<F: Fn() + Sync>(f: &F) {
    thread::scope(|s| {
        s.spawn(move || f());
        s.spawn(move || f());
    });
}

fn main() {
    let mut x = 0i64;
    let r = &mut x;
    let c = || {
        let mut g = || {
            for _ in 0..1000 {
                *r += 1;
            }
        };
        g();
    };
    race(&c);
    println("{}", x);
}
