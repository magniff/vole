// a call through fn(inout i64, inout i64) with the same place twice: own.conflict
// ERROR: error[borrowck.mut_twice]
// ERROR: line 9, column 15
fn sw(a: &mut i64, b: &mut i64) { let t = *a; *a = *b; *b = t + 1; }

fn main() {
    let f: fn(&mut i64, &mut i64) = sw;
    let mut x: i64 = 1;
    f(&mut x, &mut x);
    println("{x}");
}
