// Runs on std since 0.27.2's switch.
// The std item(s): std::str from_utf8.
// EXPECT: Ok("hé") 1 Some(1)
use std::str::CharIndices;

fn main() {
    let ok = std::str::from_utf8(&[104, 195, 169]);
    let bad = std::str::from_utf8(&[104, 255, 104]);
    let e = bad.unwrap_err();
    println("{:?} {} {:?}", ok, e.valid_up_to(), e.error_len());
}
