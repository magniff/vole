// EDITION: rust
// RULE: D19.10
// (0.27.2) `o.map(|x| x)` through a generic `map<U, F: FnOnce(T) -> U>`:
// in map's instance the closure's signature positions are T's and U's
// (its bound's), so its requirement (the parameter outlives the result)
// is a bound between T and U, assumed there and checked at the call
// (std2's Option::map; 0.27.2 reported borrowck.outlives in map).
enum Opt<T> {
    S(T),
    N,
}

impl<T> Opt<T> {
    fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Opt<U> {
        match self {
            Opt::S(x) => Opt::S(f(x)),
            Opt::N => Opt::N,
        }
    }
}

fn pick(o: Opt<&i64>) -> Opt<&i64> {
    o.map(|x| x)
}

fn main() {
    let a = 1;
    match pick(Opt::S(&a)) {
        Opt::S(r) => println("{}", *r),
        Opt::N => println("none"),
    }
}
// EXPECT: 1
