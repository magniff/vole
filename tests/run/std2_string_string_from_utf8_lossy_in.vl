// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::from_utf8_lossy_in.
// EXPECT: [97, 239, 191, 189, 98] 5
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let bytes = [97u8, 255, 98];
    let s = String::from_utf8_lossy_in(&bytes, gpa);
    println("{:?} {}", s.as_bytes(), s.len());
}
