// RT-211 review 3: `.map(|x| { w; x })` returns the item: Map's B is the
// closure's result X_C position, which the closure's requirement makes
// outlived by its input's, v's; `drop(v)` is refused (rustc E0505).
// v0.30.1 built it: a use after free.
// ERROR: line 18
fn first<I: Iterator>(i: I, k: &i64) -> Option<I::Item> {
    let _ = k;
    let mut i = i;
    i.next()
}

fn main(gpa: Gpa) {
    let k = 1i64;
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello heap string long", gpa));
    let w = 3i64;
    let r = first(v.iter().map(|x| { let _ = w; x }), &k);
    drop(v);
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{:?} {}", r, other.len());
}
