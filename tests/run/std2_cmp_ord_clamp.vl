// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::cmp Ord::clamp.
// EXPECT: P { x: 2 } 0 10 7
// EXIT: 101
use std::cmp::Ordering;

#[derive(Debug, Clone, Copy)]
struct P {
    x: i64,
}

impl PartialEq for P {
    fn eq(&self, other: &P) -> bool {
        self.x == other.x
    }
}

impl Eq for P {}

impl PartialOrd for P {
    fn partial_cmp(&self, other: &P) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for P {
    fn cmp(&self, other: &P) -> Ordering {
        self.x.cmp(&other.x)
    }
}

fn main() {
    println("{:?} {} {} {}", P { x: 5 }.clamp(P { x: 0 }, P { x: 2 }), (-3i64).clamp(0, 10),
        30i64.clamp(0, 10), 7i64.clamp(0, 10));
    println("{}", 1i64.clamp(5, 0));
}
