// (0.17, T7) `==`, `!=`, `<`, `<=`, `>`, `>=` on two references compare
// what they point to (T's Eq and Ord, derived or numeric or an enum's
// order), as Rust's do; raw `*T` pointers compare as addresses, and a
// reference cast to one (`a as *P`) too.
#[derive(PartialEq, Eq, PartialOrd, Ord, Clone, Copy)]
struct P { x: i64, y: i64 }
#[derive(Clone, Copy, PartialEq, Eq)] enum Color { Red, Green }
fn lt(a: P, b: P) -> bool { a < b }
fn eq(a: P, b: P) -> bool { a == b }
fn ne_int(a: i64, b: &mut i64) -> bool { a != *b }
fn same(a: *mut P, b: *mut P) -> bool { a == b }
fn same_ref(a: *mut P, b: *mut P) -> bool { a as *mut P == b as *mut P }
fn col(a: Color, b: Color) -> bool { a < b }

fn main() -> i32 {
    let mut p = P { x: 1, y: 2 };
    let mut q = P { x: 1, y: 2 };
    let r = P { x: 0, y: 9 };
    let mut k: i64 = 3;
    let three: i64 = 3;
    let red = Color::Red;
    let green = Color::Green;
    println(
        "{} {} {} {} {} {} {} {}", eq(p, q), lt(r, p), lt(p, r), ne_int(three, &mut k),
        same(&mut p, &mut q), same_ref(&mut p, &mut p), same_ref(&mut p, &mut q), col(red, green));
    0
}
// EXPECT: true true false false false true false true
