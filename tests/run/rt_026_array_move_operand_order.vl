// XFAIL: RT-26: a tuple's, struct literal's or variant's operand that moves a place is read after the later operands (open)
// The array form: `[w, { w = new; x }]` moves w first and then gives it a
// new value, so the later `w` is the new string (rustc accepts it and
// prints `array old new`). vole moves w after the block and refuses the
// later use: "error[borrowck.use_moved] 'w' is used here after it moved
// (moved at ...:10:15)".
// EXPECT: array old new
fn main(gpa: Gpa) {
    let mut w = format_in("old", gpa);
    let arr = [w, {
        w = format_in("new", gpa);
        format_in("x", gpa)
    }];
    println("array {} {}", arr[0], w);
}
