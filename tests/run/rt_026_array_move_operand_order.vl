// The array form: `[w, { w = new; x }]` moves w first and then gives it a
// new value, so the later `w` is the new string (rustc accepts it and
// prints `array old new`). Until 0.30.1 vole moved w after the block and
// refused the later use (borrowck.use_moved); now the part is moved where
// it is evaluated (places/build.vl settle_move, D2.4a).
// EXPECT: array old new
fn main(gpa: Gpa) {
    let mut w = format_in("old", gpa);
    let arr = [w, {
        w = format_in("new", gpa);
        format_in("x", gpa)
    }];
    println("array {} {}", arr[0], w);
}
