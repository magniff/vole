// The std2 item(s): std::collections::hash_set HashSet::hasher.
// EXPECT: true
use std::collections::HashSet;
use std::hash::BuildHasher;

fn main(gpa: Gpa) {
    let mut s = HashSet::with_hasher_in(FixedState::new(), gpa);
    s.insert(1i64);
    let h = s.hasher();
    println("{}", h.hash_one(3i64) == h.hash_one(3i64));
}
