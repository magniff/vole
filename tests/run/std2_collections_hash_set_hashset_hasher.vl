// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::collections::hash_set HashSet::hasher.
// EXPECT: true
use std::collections::HashSet;
use std::hash::{BuildHasher, FixedState};

fn main(gpa: Gpa) {
    let mut s = HashSet::with_hasher_in(FixedState::new(), gpa);
    s.insert(1i64);
    let h = s.hasher();
    println("{}", h.hash_one(3i64) == h.hash_one(3i64));
}
