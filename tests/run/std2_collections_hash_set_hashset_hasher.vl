// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_set HashSet::hasher.
// EXPECT: true
use std::collections::{HashSet, hash_set};
use std::hash::{BuildHasher, FixedState};

fn main(gpa: Gpa) {
    let mut s = HashSet::with_hasher_in(FixedState::new(), gpa);
    s.insert(1i64);
    let h = s.hasher();
    println("{}", h.hash_one(3i64) == h.hash_one(3i64));
}
