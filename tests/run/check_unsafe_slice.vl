// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: 6
// STDERR: unsafe access out of bounds: 48 bytes at offset 0 of a block of 24 bytes
// 0.10: --check-unsafe checks a slice made from a raw pointer.
extern "C" {
    fn printf(f: *const u8, ...) -> i32;
    fn calloc(n: u64, size: u64) -> *mut u8;
    fn fflush(f: *mut u8) -> i32;
}

fn sum(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for &x in s {
        t += x;
    }
    t
}

fn main() -> i32 {
    let p = unsafe { calloc(3, 8) as *mut i64 };
    unsafe {
        (*p.add(0)) = 1;
        (*p.add(1)) = 2;
        (*p.add(2)) = 3;
        printf(c"%ld\n", sum(std::slice::from_raw_parts(p.add((0) as usize), (3 - (0)) as usize)));
        fflush(0 as *mut u8);
        printf(c"%ld\n", sum(std::slice::from_raw_parts(p.add((0) as usize), (6 - (0)) as usize)));
    }
    0
}
