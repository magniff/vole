// XFAIL: RT-437d: (RT-437's mechanism, an annotation) in `impl<'a> Q<'a>`, `let q: Self = Q(&d);` with d a local is accepted, while `let q: Q<'a> = Q(&d);` is refused; rustc E0597 (0.30.2)
// From the g302static work (its selfc/s02: annot_regions walks the
// annotation with self_node 0, so Self is not expanded). Since v0.30.1 at
// least.
// ERROR: line 15
struct D {
    n: i64,
}

struct Q<'a>(&'a D);

impl<'a> Q<'a> {
    fn make() {
        let d = D { n: 1 };
        let q: Self = Q(&d);
        println("{}", q.0.n);
    }
}

fn main() {
    Q::make();
}
