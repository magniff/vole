// a Vec moved into a thread, used after
// ERROR: error[borrowck.use_moved]
// ERROR: line 10, column 22
use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let h = thread::spawn_in(move || v.len(), gpa);
    println("{} {}", v.len(), h.join().unwrap());
}
