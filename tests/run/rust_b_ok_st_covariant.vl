// EDITION: rust
// RULE: D5.2
// (0.27.1) `H<'static>` given as `H<'a>`: covariant in `'a`.

struct H<'a> {
    r: &'a i64,
}

static G: i64 = 9;

fn shorten<'a>(h: H<'static>, o: &'a i64) -> H<'a> {
    if *o > 0 {
        return h;
    }
    H { r: o }
}

fn main() {
    let k: i64 = 1;
    let h = shorten(H { r: &G }, &k);
    println("{}", *h.r);
}
// EXPECT: 9
