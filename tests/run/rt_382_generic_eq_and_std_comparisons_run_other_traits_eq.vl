// XFAIL: RT-382: (RT-149 through generic code) with F: PartialEq and another trait OtherEq whose `eq` says false, a program's generic `a == b` (T: PartialEq), std's Vec, slice, array and tuple `==` and `!=`, `v.contains(..)` and `v.dedup()` run OtherEq::eq; tuple `<` runs another trait's partial_cmp (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). vole prints `gen false
// arr false tup false`, `vec false slice false contains false ne true`
// and `tuplt false dedup 2`, at -O0 and -O2; v0.28.0 to v0.30.1 the same. Right
// today: Option's ==, sort, max, iter().max(), HashMap and BTreeMap
// lookups (scratch rc/c38.vl). RT-149 is the operator on
// the program's own value (`a == b` of two F, `a + b`); here the
// comparison is inside a generic body, the program's or std's, whose
// bound is PartialEq (PartialOrd), and the instance takes the method by
// its name (RT-72's form with another trait's method, not an inherent one).
// EXPECT: gen true arr true tup true
// EXPECT: vec true slice true contains true ne false
// EXPECT: tuplt true dedup 1
use std::cmp::Ordering;

trait OtherEq {
    fn eq(&self, o: &Self) -> bool;
}

trait OtherOrd {
    fn partial_cmp(&self, o: &Self) -> Option<Ordering>;
}

#[derive(Clone, Copy, Debug)]
struct F {
    k: i64,
}

impl OtherEq for F {
    fn eq(&self, o: &F) -> bool {
        false
    }
}

impl PartialEq for F {
    fn eq(&self, o: &F) -> bool {
        self.k == o.k
    }
}

impl OtherOrd for F {
    fn partial_cmp(&self, o: &F) -> Option<Ordering> {
        Some(o.k.cmp(&self.k))
    }
}

impl PartialOrd for F {
    fn partial_cmp(&self, o: &F) -> Option<Ordering> {
        Some(self.k.cmp(&o.k))
    }
}

fn geq<T: PartialEq>(a: &T, b: &T) -> bool {
    a == b
}

fn main(gpa: Gpa) {
    let a = [F { k: 4 }];
    let b = [F { k: 4 }];
    let t1 = (F { k: 1 }, 2i64);
    let t2 = (F { k: 1 }, 2i64);
    let mut v: Vec<F, Gpa> = Vec::new_in(gpa);
    v.push(F { k: 3 });
    v.push(F { k: 1 });
    let mut u: Vec<F, Gpa> = Vec::new_in(gpa);
    u.push(F { k: 3 });
    u.push(F { k: 1 });
    println("gen {} arr {} tup {}", geq(&a[0], &b[0]), a == b, t1 == t2);
    println("vec {} slice {} contains {} ne {}", v == u, v[..] == u[..], v.contains(&F { k: 1 }),
        a != b);
    let mut w: Vec<F, Gpa> = Vec::new_in(gpa);
    w.push(F { k: 1 });
    w.push(F { k: 1 });
    w.dedup();
    println("tuplt {} dedup {}", (F { k: 1 }, 1i64) < (F { k: 2 }, 0i64), w.len());
}
