// RULE: D2.7
// (0.30.1) A mutable view reached through a shared reference cannot be
// reborrowed mutably, rustc's E0596: given to a call (`two(r1.s, r2.s)`
// of two `&W`, with or without a `requires`), or sliced by hand (`&mut
// r.s[..]`). Before, all three were accepted, and two shared references
// passed one `&mut [i64]` twice.
// ERROR: error[borrowck.borrow_immutable]
// ERROR: error[borrowck.borrow_immutable]
// ERROR: error[borrowck.borrow_immutable]
// ERROR: error[borrowck.borrow_immutable]
// ERROR: error[borrowck.borrow_immutable]
// ERROR-COUNT: 5
struct W<'a> {
    s: &'a mut [i64],
}

fn two(a: &mut [i64], b: &mut [i64]) -> i64 {
    a[0] = 1;
    b[0] = 2;
    a[0]
}

fn two_checked(a: &mut [i64], b: &mut [i64]) -> i64
    requires a.len() > 0
{
    a[0] = 1;
    b[0] = 2;
    a[0]
}

fn main() {
    let mut arr = [0i64, 0];
    let w = W { s: &mut arr };
    let r1 = &w;
    let r2 = &w;
    let x = two(r1.s, r2.s);
    let y = two_checked(r1.s, r2.s);
    let a = &mut r1.s[..];
    a[0] = 3;
    println("{} {} {}", x, y, a[0]);
}
