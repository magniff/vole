// XFAIL: RT-242b: (fuller form of R302E-19) a by-value method of a trait implemented for `&W`: `x.add(y)` with x, y: &W runs W's `Add<&W>` on a copy of *x (23) instead of `&W: Add<&W>` (33), and `x.tk(5u8)` with `impl Tk<u8> for &W` is refused ("no impl of 'W::tk' takes arguments (u8)") because W has `Tk<i64>` (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt); the release build refuses
// line 58, and without it prints `23 23 13`. rustc refuses `x.tk(5i64)`
// (E0308: the first step is &W, whose impl takes u8), which vole builds and
// runs W's Tk<i64> (R302E-19c).
// EXPECT: 33 23 13
// EXPECT: 205
use std::ops::Add;

#[derive(Clone, Copy)]
struct W {
    k: i64,
}

impl Add<W> for W {
    type Output = i64;

    fn add(self, o: W) -> i64 {
        10 + self.k + o.k
    }
}

impl<'b> Add<&'b W> for W {
    type Output = i64;

    fn add(self, o: &'b W) -> i64 {
        20 + self.k + o.k
    }
}

impl<'a, 'b> Add<&'b W> for &'a W {
    type Output = i64;

    fn add(self, o: &'b W) -> i64 {
        30 + self.k + o.k
    }
}

trait Tk<R> {
    fn tk(self, o: R) -> i64;
}

impl Tk<i64> for W {
    fn tk(self, o: i64) -> i64 {
        100 + o
    }
}

impl<'a> Tk<u8> for &'a W {
    fn tk(self, o: u8) -> i64 {
        200 + o as i64
    }
}

fn main() {
    let a = W { k: 1 };
    let b = W { k: 2 };
    let x = &a;
    let y = &b;
    println("{} {} {}", x.add(y), a.add(y), a.add(b));
    println("{}", x.tk(5u8));
}
