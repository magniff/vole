// EDITION: rust
// an induction variable that wraps to negative.
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551609, length 8
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64]) -> i64 {
    let mut t: i64 = 0; let mut i: i64 = 9223372036854775806; let mut n: i64 = 0;
    while n < 3 { t += s[((i + 2) % 8) as usize]; i += 1; n += 1; } t
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s));
    0
}
