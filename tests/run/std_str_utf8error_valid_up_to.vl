// Runs on std since 0.27.2's switch.
// The std item(s): std::str Utf8Error::valid_up_to.
// EXPECT: 1 3
use std::str::CharIndices;

fn main() {
    let a = std::str::from_utf8(&[0x61, 0xE2, 0x28]).unwrap_err();
    let b = std::str::from_utf8(&[0x61, 0xC3, 0xA9, 0xF0, 0x9F]).unwrap_err();
    println("{} {}", a.valid_up_to(), b.valid_up_to());
}
