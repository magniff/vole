// XFAIL: RT-242e: (RT-242c's shape on a slice) `s.g(true)` with `s: &[i64]`, `impl G<i64> for [i64]` and `impl G<bool> for &[i64]` (`g(&self, ..)`) is accepted and runs &[i64]'s, printing 1; rustc E0308 (the probe stops at the first step, [i64]'s G<i64>, whose g takes an i64) (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form p11_slice_view_generic_trait_mismatch.
// ERROR: line 24
trait G<X> {
    fn g(&self, x: X) -> i64;
}

impl<'a> G<bool> for &'a [i64] {
    fn g(&self, x: bool) -> i64 {
        if x { 1 } else { 0 }
    }
}

impl G<i64> for [i64] {
    fn g(&self, x: i64) -> i64 {
        2 + x * 0
    }
}

fn main() -> i32 {
    let a = [1i64, 2];
    let s: &[i64] = &a;
    println("{}", s.g(true));
    0
}
