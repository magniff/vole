// EDITION: rust
// EXPECT: or 1 2 3
// EXPECT: closure 7
// EXPECT: for 3
// EXPECT: generic fn 4
// EXPECT: unit 1
// EXPECT: mut 6
// 0.17: struct-like variants in or-patterns, closure parameters, `for`
// patterns, generic functions; `E::V {}` of a variant without fields;
// `mut` in a field's shorthand.
#[derive(Clone, Copy)] enum Ev { Key { code: i64, shift: bool }, Click { code: i64, x: i64 }, Quit }

#[derive(Clone, Copy)] enum One { Only { a: i64, b: i64 } }

#[derive(Clone, Copy)] enum Wrap<T> { Item { v: T, n: i64 }, Nothing {} }

fn code(e: Ev) -> i64 {
    match e {
        Ev::Key { code, .. } | Ev::Click { code, .. } => code,
        Ev::Quit => 3,
    }
}

fn count<T>(w: Wrap<T>) -> i64 {
    match w {
        Wrap::Item { n, .. } => n,
        Wrap::Nothing {} => 0,
    }
}

fn main() {
    println(
        "or {} {} {}", code(Ev::Key { code: 1i64, shift: true }), code(Ev::Click { x: 0i64, code: 2i64 }),
        code(Ev::Quit));
    let f = |One::Only { a, b }: One| a + b;
    println("closure {}", f(One::Only { a: 3i64, b: 4i64 }));
    let arr = [One::Only { a: 1i64, b: 0i64 }, One::Only { a: 2i64, b: 0i64 }];
    let mut total: i64 = 0;
    for One::Only { a, .. } in arr {
        total += a;
    }
    println("for {total}");
    println("generic fn {}", count(Wrap::Item { v: "x", n: 4i64 }));
    let w: Wrap<i64> = Wrap::Nothing {};
    match w {
        Wrap::Nothing {} => println("unit 1"),
        Wrap::Item { .. } => println("unit 0"),
    }
    if let Ev::Click { mut x, .. } = (Ev::Click { code: 0i64, x: 5i64 }) {
        x += 1;
        println("mut {x}");
    }
}
