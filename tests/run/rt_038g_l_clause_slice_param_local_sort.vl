// RULE: C3.4
// (0.30.2, review of RT-38g) A clause of a function taking a shared slice
// sorts a local copy of it: `sort_unstable` writes through raw pointers
// made of the local's `&mut`, and no raw pointer reaches it from the
// clause's inputs (a `&[i64]` holds none), so the clause is accepted.
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
fn smallest(v: &[i64]) -> i64
    requires v.len() == 3
    ensures {
    let mut a = [v[0], v[1], v[2]];
    a.sort_unstable();
    a[0] == result
}

{
    let mut m = v[0];
    for x in v.iter() {
        if *x < m {
            m = *x;
        }
    }
    m
}

fn main() {
    let v = [5i64, 3, 4];
    println("{}", smallest(&v));
}
