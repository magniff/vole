// EDITION: rust
// i * 2 wraps to i64::MIN: the guard i * 2 >= 0 fails, no index.
// EXPECT: -1
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], i: i64) -> i64 {
    if i * 2 < s.len() as i64 && i * 2 >= 0 { s[i as usize] } else { -1 }
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s, 4611686018427387904 + unsafe { Z }));
    0
}
