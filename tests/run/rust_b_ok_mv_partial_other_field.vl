// EDITION: rust
// RULE: D8.1
// (0.27.1) A field moved, the other field used: move paths per field.

struct N {
    v: i64,
}

struct P2 {
    a: N,
    b: N,
}

fn main() {
    let p = P2 { a: N { v: 1 }, b: N { v: 2 } };
    let t = p.a;
    println("{} {}", t.v, p.b.v);
}
// EXPECT: 1 2
