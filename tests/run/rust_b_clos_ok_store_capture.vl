// RULE: D19.10
// (0.27.2) A closure that stores one capture into another: the body needs
// `r`'s referent to outlive `h.p`'s, both regions of its creator, so it is
// a requirement checked at the closure's creation, where it holds (0.27.1:
// two false borrowck.outlives).
// EXPECT: 2
struct H<'a> {
    p: &'a i64,
}

fn main() {
    let a = 1;
    let b = 2;
    let mut h = H { p: &a };
    let r = &b;
    let mut f = || {
        h.p = r;
    };
    f();
    println("{}", *h.p);
}
