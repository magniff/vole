// places IR (0.26.1, R7): a sink closure's body that moves a flagged
// capture out of its env first reads the capture's live flag: moved out
// already (the closure called again), the program stops with the own
// pass's message; else the move, then the flag cleared (R3). The value is
// dropped once, never twice.
// FLAGS: --verify-places
// EXPECT: drop 4
// EXIT: 101
// STDERR: a sink closure moved its captured value out a second time
// PLACES: fn closure
// PLACES: _3 = copy (*_1).1
// PLACES: switch copy _3 [0: bb2, otherwise: bb3]
// PLACES: intrinsic panic(const 0)
// PLACES: unreachable
// PLACES: call drop<R>(move (*_1).0)
// PLACES: (*_1).1 = const false
struct R { id: i64 }

impl Drop for R {
    fn drop(inout self) {
        println(f"drop {self.id}");
    }
}

fn call2<F: FnMut() -> i64>(f: sink F) -> i64 {
    var g = f;
    g() + g()
}

fn main() {
    let e = R { id: 4 };
    let t = call2(sink || {
        drop(e);
        1
    });
    println(f"twice {t}");
}
