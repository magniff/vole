// EDITION: rust
// (0.27.0) Hand-translated from tests/run/iter_drop_borrowed.vl to Rust's spelling.
// 0.25: the same adapters over a borrowing iterator (w.iter() of a Vec<D>)
// drop nothing: its items are copies of the elements the Vec keeps, which
// drop with it, once.
// FLAGS: --check-alloc
// EXPECT: 3 1 true 1 2 3
// EXPECT: borrowed: made 3 dropped 0
// EXPECT: end: made 3 dropped 3
use std::alloc::Allocator;
use std::cmp::Ordering;

static mut MADE: i64 = 0;
static mut DROPS: i64 = 0;

struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl<A: Allocator> Drop for D<A> {
    fn drop(&mut self) {
        DROPS += 1;
    }
}

impl<A: Allocator> PartialEq for D<A> {
    fn eq(&self, o: &Self) -> bool {
        self.id == o.id
    }
}

impl<A: Allocator> Eq for D<A> {}

impl<A: Allocator> PartialOrd for D<A> {
    fn partial_cmp(&self, o: &Self) -> Option<Ordering> {
        Some(self.cmp(o))
    }
}

impl<A: Allocator> Ord for D<A> {
    fn cmp(&self, o: &Self) -> Ordering {
        self.id.cmp(&o.id)
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    MADE += 1;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

// Makes D 1, 2, ..., n, one per call to next.
struct Gen<A: Allocator> {
    n: i64,
    k: i64,
    gpa: A,
}

impl Iterator for Gen<Gpa> {
    type Item = D<Gpa>;

    fn next(&mut self) -> Option<D<Gpa>> {
        if self.k >= self.n {
            return None;
        }
        self.k += 1;
        Some(mk(self.k, self.gpa))
    }
}

fn gen(n: i64, gpa: Gpa) -> Gen<Gpa> {
    Gen { n: n, k: 0, gpa: gpa }
}

// Owns D 1..n (pops n first): the ones it has not given out drop with it.
struct Pop<A: Allocator> {
    v: Vec<D<A>, A>,
}

impl Iterator for Pop<Gpa> {
    type Item = D<Gpa>;

    fn next(&mut self) -> Option<D<Gpa>> {
        self.v.pop()
    }
}

fn pop(n: i64, gpa: Gpa) -> Pop<Gpa> {
    let mut v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 1..=n {
        v.push(mk(i, gpa));
    }
    Pop { v: v }
}

fn report(what: &str) {
    println("{what}: made {MADE} dropped {DROPS}");
}

fn run(gpa: Gpa) {
    let mut w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for i in 1..=3 {
        w.push(mk(i, gpa));
    }
    let c = w.iter().count();
    let f = w.iter().filter(|d| d.id > 2).count();
    let a = w.iter().any(|d| d.id == 2);
    let p = w.iter().position(|d| d.id == 2).unwrap_or(-1);
    let z = w.iter().zip(w.iter().take(2)).count();
    let mut e = 0;
    for (i, d) in w.iter().enumerate() {
        e += 1;
    }
    println("{c} {f} {a} {p} {z} {e}");
    report("borrowed");
}

fn main(gpa: Gpa) {
    run(gpa);
    report("end");
}
// XFAIL: a `&x` pattern of an iterator's references is typed twice a reference (front272 F22)
