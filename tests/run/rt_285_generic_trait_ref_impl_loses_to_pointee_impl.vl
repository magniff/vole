// XFAIL: RT-285: (RT-242d's wrong-code side) with `impl T<&i64> for S` and `impl T<&i64> for &mut S` (and `for &S`), a `&self` method called on a `&mut S`, a `&&mut S` or a `&&S` runs S's impl: `m.f(&x)` prints 156 where rustc prints 206 (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt); the release build prints
// `a 156`, `b 156`, `c 156`, `d 156`, `e 412` (c is right: rustc's first
// step, `&S` by value, is `&self` of S). RT-242d: an impl of a
// generic trait for a reference type is not found (`m.f(&x)` with only the
// `&mut S` impl is "no method 'f' on type '&mut S'"); when the pointee has
// an impl of the same trait argument the probe takes that one, so the
// program builds and runs another impl. A trait without a type parameter
// (`impl U for &mut S`) is picked right; a Box<S> impl is too (e).
// EXPECT: a 206
// EXPECT: b 206
// EXPECT: c 156
// EXPECT: d 306
// EXPECT: e 412
trait T<R> {
    fn f(&self, o: R) -> i64;
}

struct S {
    k: i64,
}

impl<'b> T<&'b i64> for S {
    fn f(&self, o: &'b i64) -> i64 {
        150 + self.k + *o
    }
}

impl<'a, 'b> T<&'b i64> for &'a mut S {
    fn f(&self, o: &'b i64) -> i64 {
        200 + self.k + *o
    }
}

impl<'a, 'b> T<&'b i64> for &'a S {
    fn f(&self, o: &'b i64) -> i64 {
        300 + self.k + *o
    }
}

impl<'b> T<&'b i64> for Box<S, Gpa> {
    fn f(&self, o: &'b i64) -> i64 {
        400 + self.k + *o
    }
}

fn main(gpa: Gpa) {
    let mut s = S { k: 1 };
    let x = 5i64;
    let m = &mut s;
    println("a {}", m.f(&x));
    let mm = &m;
    println("b {}", mm.f(&x));
    let r = &s;
    println("c {}", r.f(&x));
    let rr = &r;
    println("d {}", rr.f(&x));
    let b = Box::new_in(S { k: 7 }, gpa);
    println("e {}", b.f(&x));
}
