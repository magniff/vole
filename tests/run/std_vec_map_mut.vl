// XFAIL: gap 17: compile unsafe: indexing a raw pointer is unsafe
// EXPECT: vec: 1 10 30 2 3 4, last 4, removed 0, len 6
// EXPECT: empty last none, truncate 2: 1 10
// EXPECT: counts: a=3 b=1 c=1, contains_key b true z false
// EXPECT: get_mut: alice 110 2, bob missing
// EXPECT: grown: 1000 keys, sum 499500
// 0.14: changing values in place: Vec's last, swap, insert, remove,
// truncate; HashMap's get_mut and get_or_insert (one-element views of the
// value), contains_key; a view taken again after the map grows.
use std::collections::HashMap;

#[derive(Clone, Copy)] struct Account { balance: i64, txns: i64 }

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i);
    }
    v.insert(0usize, 10i64);
    v.insert(6usize, 20i64);
    v.insert(3usize, 30i64);
    let removed = v.remove(1usize);
    v.swap(0usize, 1usize);
    v.truncate(6usize);
    v.truncate(100usize);
    print("vec:");
    for &x in v.as_slice() {
        print(" ");
        print("{}", x);
    }
    print(", last ");
    print("{}", v.last().copied().unwrap());
    print(", removed ");
    print("{}", removed);
    print(", len ");
    print("{}", (v.len() as i64));
    println("");
    let mut e: Vec<i64, Gpa> = Vec::new_in(gpa);
    print("{}", if e.last().copied().is_none() { "empty last none" } else { "empty last some" });
    v.truncate(2usize);
    print(", truncate 2: ");
    print("{}", v[0usize]);
    print(" ");
    print("{}", v[1usize]);
    println("");

    let mut counts: HashMap<&str, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for w in ["a", "b", "a", "c", "a"] {
        counts.entry(w).or_insert(0)[0] += 1;
    }
    print("counts:");
    for w in ["a", "b", "c"] {
        print(" ");
        print("{}", w);
        print("=");
        print("{}", counts.get(&w).copied().unwrap());
    }
    print(", contains_key b ");
    print("{}", if counts.contains_key(&"b") { "true" } else { "false" });
    print(" z ");
    println("{}", if counts.contains_key(&"z") { "true" } else { "false" });

    let mut accounts: HashMap<&str, Account, Gpa, FixedState> = HashMap::new_in(gpa);
    accounts.insert("alice", Account { balance: 100, txns: 1 });
    if let Some(a) = accounts.get_mut(&"alice") {
        a[0].balance += 10;
        a[0].txns += 1;
    }
    let a = accounts.get(&"alice").copied().unwrap();
    print("get_mut: alice ");
    print("{}", a.balance);
    print(" ");
    print("{}", a.txns);
    println("{}", if accounts.get_mut(&"bob").is_none() { ", bob missing" } else { ", bob found" });

    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for i in 0..1000 {
        m.entry(i).or_insert(0)[0] += i;
        m.entry(0).or_insert(0)[0] += 0;
    }
    let mut sum: i64 = 0;
    for i in 0..m.slots() {
        if let Some(x) = m.value_at(i) {
            sum += x;
        }
    }
    print("grown: ");
    print("{}", (m.len() as i64));
    print(" keys, sum ");
    print("{}", sum);
    println("");
    0
}
