// Runs on std since 0.27.2's switch.
// The std item(s): std::alloc Allocator::by_ref.
// EXPECT: [1, 2] 16
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let mut v: Vec<i32, &Arena<Gpa>> = Vec::new_in(arena.by_ref());
    v.push(1);
    v.push(2);
    println("{:?} {}", v, arena.used());
}
