// XFAIL: RT-445b: (RT-445 with the key type written) `v.sort_by_key(k)` in `fn sorted<F: FnMut(&i64) -> i64>(v: &mut Vec<i64, Gpa>, mut k: F)` is type.infer, "cannot infer type parameter 'K' of 'Vec::sort_by_key'", though F's bound says K is i64; rustc prints [3, 1] (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// EXPECT: [3, 1]
fn key(x: &i64) -> i64 {
    -*x
}

fn sorted<F: FnMut(&i64) -> i64>(v: &mut Vec<i64, Gpa>, mut k: F) {
    let _ = k(&0);
    v.sort_by_key(k);
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(3);
    sorted(&mut v, key);
    println("{:?}", v);
}
