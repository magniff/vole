// EDITION: rust
// `\xNN` is a single byte, even for values >= 0x80.
// EXPECT: 3 65 255 128
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn main() -> i64 {
    let s = "\x41\xff\x80";
    let p = s.as_ptr();
    unsafe { printf(c"%lu %d %d %d\n", (s.len() as u64), *p, (*p.add(1)), (*p.add(2))); }
    0
}
