// EDITION: rust
// RULE: F6.2
// The probe's `&` step: `s.tag()` on an `S` finds the method of the impl
// for `&S`, whose `self` is the reference; also through a `&mut` step.
// EXPECT: 5
// EXPECT: 6
trait Tag {
    fn tag(self) -> i64;
}

trait Bump {
    fn bump(self) -> i64;
}

struct S {
    a: i64,
}

impl<'a> Tag for &'a S {
    fn tag(self) -> i64 {
        self.a
    }
}

impl<'a> Bump for &'a mut S {
    fn bump(self) -> i64 {
        self.a += 1;
        self.a
    }
}

fn main() {
    let mut s = S { a: 5 };
    println("{}", s.tag());
    println("{}", s.bump());
}
