// `t.remove(1)` of "\u{e9}t\u{e9}" must panic: byte 1 is inside the first
// char. String::remove reads `self.as_str()[i..].chars().next()`, a
// slice std does not check, decodes the bytes A9 74 as U+0274 (a char of
// two bytes), returns it and removes them: the String is then C3 C3 A9,
// not UTF-8. (On such Strings std's own methods fail inside std: `pop` of
// one that ends in a lone F0 panics with "attempt to subtract with
// overflow" at -O0, and at -O2 returns Some forever.)
// STDERR: not a char boundary
// EXIT: 101
fn main(gpa: Gpa) {
    let mut t = String::new_in(gpa);
    t.push_str("\u{e9}t\u{e9}");
    // no arguments: a is 1
    let a = std::env::args().count();
    let c = t.remove(a);
    println("{} {:?}", c as u32, t.as_bytes());
}
