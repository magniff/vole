// RULE: R6
// (0.30) A fn item whose result borrows from its argument given for `F:
// Fn(&T) -> R`, a bound whose result cannot borrow from the argument
// (rustc E0308: one type is more general than the other). The call
// through the fn value in apply's instance makes x's region flow into R:
// reported there (it was exempted as a flow between an instance's
// substitutions, and `apply(&v, sl)` returned a view of a dropped Vec).
// RUSTC: none rustc rejects the fn item for the bound first (E0308: one type is more general than the other), a type error before its borrow check
// ERROR: error[borrowck.outlives]
// ERROR: line 16, column 52
// ERROR-COUNT: 1
fn sl(d: &Vec<i64, Gpa>) -> &[i64] {
    d.as_slice()
}

fn apply<T, R, F: Fn(&T) -> R>(x: &T, f: F) -> R { f(x) }

fn len(d: &Vec<i64, Gpa>) -> usize {
    d.len()
}

fn main(gpa: Gpa) {
    let s = {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(1);
        apply(&v, sl)
    };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    println("{} {}", s[0], apply(&v, len));
}
