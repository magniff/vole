// (0.26.1) std's copying getter: `v.get(0)` gives a copy of the element,
// so a store through it is lost today.
// XFAIL: WRONG `v.get(0)` copies the atomic: the store reaches the copy
// EXPECT: 9
use std::sync::atomic::{AtomicI64, Ordering};

fn main(gpa: Gpa) {
    var v: Vec<AtomicI64> = Vec::new_in(gpa);
    v.push(AtomicI64::new(1));
    let a = v.get(0);
    a.store(9, Ordering::SeqCst);
    println(f"{v[0].load(Ordering::SeqCst)}");
}
