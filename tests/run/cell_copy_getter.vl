// (0.26.1) std's copying getter: `v.get(0)` gives a copy of the element,
// so a store through it was lost through 0.26.0. An atomic holds an
// UnsafeCell: own.interior_copy, with the element's place as the try.
// ERROR: [own.interior_copy]: a copy of a 'Atomic<i64>' holds another cell (UnsafeCell<i64> at .v): a write through it is lost
// ERROR: cell_copy_getter.vl:11 --old 'v.get(0)' --new 'v[0]'
use std::sync::atomic::{AtomicI64, Ordering};

fn main(gpa: Gpa) {
    var v: Vec<AtomicI64> = Vec::new_in(gpa);
    v.push(AtomicI64::new(1));
    let a = v.get(0);
    a.store(9, Ordering::SeqCst);
    println("{}", v[0].load(Ordering::SeqCst));
}
