// EDITION: rust
// RULE: D3.3
// XFAIL: bc271 M1 ties every argument to a call's one region (the stopgap until ir271 M1's callee regions)
// (0.27.1) Two lifetimes in one struct; a getter returns the first's.

struct P<'a, 'b> {
    a: &'a i64,
    b: &'b i64,
}

fn geta<'a, 'b>(p: &P<'a, 'b>) -> &'a i64 {
    p.a
}

fn main() {
    let a: i64 = 1;
    let mut r = &a;
    {
        let b: i64 = 2;
        let p = P { a: &a, b: &b };
        r = geta(&p);
        println("{}", *p.b);
    }
    println("{}", *r);
}
// EXPECT: 2
// EXPECT: 1
