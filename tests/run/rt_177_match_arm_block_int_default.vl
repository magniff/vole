// XFAIL: RT-177: `k + 254` as a match arm, with k: u8 assigned in another arm, gives "expected 'u8', got 'i32'" (the i32 default) (0.30.2)
// From the c302const branch's report.
// EXPECT: 127 127
fn f(x: u8) -> u8 {
    let mut k: u8 = 1;
    let r = match x {
        0 => {
            k = 255;
            1
        }
        _ => k + 254,
    };
    r / 2 + k / 2
}

fn main() {
    println("{} {}", f(0), f(1));
}
