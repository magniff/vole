// XFAIL: `v.sort_by_key(f)` with `f: F` and `F: FnMut(&i64) -> K` in a generic function: cannot infer sort_by_key's K (0.30.0 too; 0.30.2)
// rustc reads K from F's bound; vole asks for `sort_by_key::<K, F>(f)`.
// EXPECT: 3 2 1
fn by_key<K: Ord, F: FnMut(&i64) -> K>(v: &mut Vec<i64, Gpa>, f: F) {
    v.sort_by_key(f);
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.push(2);
    by_key(&mut v, |x| -*x);
    println("{} {} {}", v[0], v[1], v[2]);
}
