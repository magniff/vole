// XFAIL: RT-432: a generic trait's default method with a method-level `where T: Tr` on the trait's own parameter, `trait G<T> { fn w(&self) -> i64 where T: Tr { T::mk() } }`, is refused in `impl<U> G<U> for W<U> {}`: "no associated function 'mk' in 'U'" (the copied default does not give U the bound); rustc prints 5 (0.30.2)
// From the paused g302tparam work (its preexisting/pe1). Since v0.30.1
// at least (v0.30.1 the same error). The projection form, `T::Out` under
// `where T: Sub`, is rt_432b.
// EXPECT: 5
trait Tr {
    fn mk() -> i64;
}

impl Tr for u8 {
    fn mk() -> i64 {
        5
    }
}

trait G<T> {
    fn w(&self) -> i64
        where
            T: Tr,
    {
        T::mk()
    }
}

struct W<T> {
    t: T,
}

impl<U> G<U> for W<U> {}

fn main() {
    let w = W { t: 1u8 };
    println("{}", w.w());
}
