// (0.26.1) A match through a reference (a let parameter, a Vec element, a
// borrowing iterator's item) binds the payload's place: a write through an
// atomic in it reaches the caller's value.
// EXPECT: 9
// EXPECT: 7
use std::sync::atomic::{AtomicI64, Ordering};

enum Slot { Empty, Full(AtomicI64) }

#[inline(never)]
fn fill(s: Slot) {
    match s {
        Slot::Full(a) => a.store(9, Ordering::SeqCst),
        Slot::Empty => {}
    }
}

fn main(gpa: Gpa) {
    let s = Slot::Full(AtomicI64::new(1));
    fill(s);
    match s {
        Slot::Full(a) => println("{}", a.load(Ordering::SeqCst)),
        Slot::Empty => println("empty"),
    }
    var v: Vec<Slot> = Vec::new_in(gpa);
    v.push(Slot::Full(AtomicI64::new(1)));
    match v[0] {
        Slot::Full(a) => a.store(9, Ordering::SeqCst),
        Slot::Empty => {}
    }
    for s in v.iter() {
        match s {
            Slot::Full(a) => a.store(7, Ordering::SeqCst),
            Slot::Empty => {}
        }
    }
    match v[0] {
        Slot::Full(a) => println("{}", a.load(Ordering::SeqCst)),
        Slot::Empty => println("empty"),
    }
}
