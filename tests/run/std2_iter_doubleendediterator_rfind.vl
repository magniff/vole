// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter DoubleEndedIterator::rfind.
// EXPECT: Some(4) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    println("{:?} {:?}", v.iter().rfind(|x| **x % 2 == 0), v.iter().rfind(|x| **x > 9));
}
