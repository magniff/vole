// rustc refuses a type that does not fit the address space ("values of
// the type `[u64; 2305843009213693952]` are too big for the current
// architecture"). vole computes its size modulo 2^64: 0 here, so a
// local `[0u64; 1usize << 61]` gets no room in the frame while its
// indexing allows 2^61 elements (probe c8: a loop writing a[0..64]
// crashes with SIGSEGV at -O0 and -O2, after writing over the frame).
// ERROR: rt_m2_009_type_size_wraps.vl:
fn main() {
    let n = std::env::args().count();
    println("{}", std::mem::size_of::<[u64; 1usize << 61]>());
    if n > 5 {
        let mut a = [0u64; 1usize << 61];
        for i in 0..(64 * n) {
            a[i] = 0xDEAD;
        }
        println("{}", a[3]);
    }
}
