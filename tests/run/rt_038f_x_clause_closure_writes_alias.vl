// RULE: C3.4
// (0.30.2, RT-38f) A closure in an ensures that writes through an alias
// parameter it captures: the capture is a use of the view, which is made
// (byref.vl VIEW_USED) and refuses the write (0.30.1 printed 2 9).
// RUSTC: none contract clauses are not Rust
// ERROR: cannot borrow 'p' as mutable
// ERROR-COUNT: 1
type R<'a> = &'a mut i64;

fn f(p: R<'_>) -> i64
    ensures {
    let mut g = || {
        *p = 9;
    };
    g();
    true
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
