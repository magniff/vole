// EDITION: rust
// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): Vec::truncate's `ensures self.len() <= n`, exercised.
// EXPECT: 1
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::from_in([1, 2, 3], gpa);
    v.truncate(5);
    v.truncate(1);
    println("{}", v.len());
}
