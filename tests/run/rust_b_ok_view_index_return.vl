// RULE: D1.4
// (0.27.1) `&s[0]` of a `&[i64]` parameter returned: the index is a deref
// through the view, so the loan is not frame-owned and carries the view's
// region.

fn first(s: &[i64]) -> &i64 {
    &s[0]
}

fn main() {
    let a = [5i64, 6];
    println("{}", *first(&a[..]));
}
// EXPECT: 5
