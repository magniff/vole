// EDITION: rust
// RULE: D3.2
// (0.28.0) A static holds what outlives 'static: a literal, another
// static's value.
// EXPECT: hello world 3
static mut K: &str = "";
static W: &str = "world";
static N: i64 = 3;
static mut Q: &str = "";

fn main() {
    // UNSAFE: the test's statics
    // SAFETY: one thread
    unsafe {
        K = "hello";
        Q = W;
        let k = K;
        let q = Q;
        println("{} {} {}", k, q, N);
    }
}
