// EDITION: rust
// RULE: Z9.2
// `&v` as `&[T]` borrows v: a push while the slice is used conflicts
// (rustc E0502).
// ERROR: error[borrowck.conflict]: cannot borrow 'v' as mutable because it is also borrowed as immutable
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(10);
    let s: &[i64] = &v;
    v.push(1);
    println("{}", s.len());
}
