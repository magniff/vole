// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt Pointer::fmt.
// EXPECT: 0x1000
use std::fmt::{Formatter, Pointer};

struct Addr {
    p: usize,
}

impl Pointer for Addr {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "0x{:x}", self.p)
    }
}

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = Pointer::fmt(&Addr { p: 4096 }, &mut f);
    println("{}", s);
}
