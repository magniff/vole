// RULE: F34.4 (0.30.2) A constant's value whose only loop is a `while`: its
// `continue`, `continue 'w` and `break` are the value's own (the walk,
// exits_in, reaches the loop's body as body.vl check_while does), so the
// value is accepted and leaves nothing. The output is rustc's.
// EXPECT: 6
struct D {
    k: i64,
}

const W: D = {
    let mut s: i64 = 0;
    'w: while s < 10 {
        s += 1;
        if s == 2 {
            continue;
        }
        if s == 3 {
            continue 'w;
        }
        if s == 6 {
            break;
        }
    }
    D { k: s }
};

fn main() {
    let w = W;
    println("{}", w.k);
}
