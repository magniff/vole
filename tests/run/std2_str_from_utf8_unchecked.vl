// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str from_utf8_unchecked.
// EXPECT: abc
use std::str::CharIndices;

fn main() {
    let b: &[u8] = &[97, 98, 99];
    // UNSAFE: the test's bytes as a str.
    // SAFETY: they are ASCII, so UTF-8.
    let s = unsafe { std::str::from_utf8_unchecked(b) };
    println("{}", s);
}
