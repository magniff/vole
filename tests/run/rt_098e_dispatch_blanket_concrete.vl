// XFAIL: RT-98: a blanket impl beside a concrete one: the bound's method call is refused as ambiguous (0.30.2)
// From the review of the obligation engine's M1 (pre-existing: v0.30.1 too).
// EXPECT: 7
trait Mk {}
impl Mk for i64 {}
trait Tr<U> { fn f(&self) -> i64; }
struct W<'a> { r: &'a i64 }
impl<'a: 'static> Tr<i32> for W<'a> { fn f(&self) -> i64 { 32 } }
impl<'a, U: Mk> Tr<U> for W<'a> { fn f(&self) -> i64 { 7 } }
fn go<T: Tr<i64>>(t: &T) -> i64 { t.f() }
fn main() { let v: i64 = 5; let x = W { r: &v }; println("{}", go(&x)); }
