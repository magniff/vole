// EDITION: rust
// RULE: F19.3
// RUSTC: accepts FL9 a safe C fn pointer is called safely
// A call through a safe `extern "C" fn` pointer needs `unsafe`, as in
// MVS (rustc calls one safely): the pointer may come from C.
// ERROR: error[unsafe]: calling an extern "C" function pointer is unsafe
extern "C" fn twice(x: i64) -> i64 {
    x * 2
}

fn main() -> i64 {
    let f: extern "C" fn(i64) -> i64 = twice;
    f(1)
}
