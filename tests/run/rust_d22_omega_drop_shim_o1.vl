// RULE: D22.2
// (0.27.6) The opaque instance of `two<A>` drops a `Vec<i64, Ω>`: it asks
// for no drop shim. 0.27.4 and 0.27.5 made that shim, lowered at -O0 and
// -O1, and it called a `Vec::drop` no instance made (an undefined symbol at
// the link). At -O1: rust_d22_omega_drop_shim runs at -O0 and -O2.
// FLAGS: -O1
// EXPECT: 1 2
use std::alloc::Allocator;

fn two<A: Allocator>(a: A, n: i64) -> usize {
    let mut v: Vec<i64, A> = Vec::new_in(a);
    for i in 0..n {
        v.push(i);
    }
    v.len()
}

fn main(gpa: Gpa) {
    println("{} {}", two(&gpa, 1), two(gpa, 2));
}
