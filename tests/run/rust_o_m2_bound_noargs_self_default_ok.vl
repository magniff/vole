// EXPECT: true
// (RT-270) `Z: Eqv` of `trait Eqv<R = Self>`, met by `impl Eqv for W`.
trait Eqv<R = Self> {
    fn e(&self, r: &R) -> bool;
}

struct W {
    r: i64,
}

impl Eqv for W {
    fn e(&self, r: &W) -> bool {
        self.r == r.r
    }
}

fn c<Z: Eqv>(z: &Z) -> bool {
    z.e(z)
}

fn main() {
    println("{}", c(&W { r: 0 }));
}
