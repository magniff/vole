// XFAIL: RT-351: `#[effects(alloc(B), panic)]` on a function that allocates through its parameter `b: B` with B = &Arena<Gpa> is refused: "allocates from Arena<Gpa>"; the allocation is from B (0.30.2)
// Since v0.30.1 at least. From the review of the type-parameter work.
// EXPECT: 1
use std::alloc::{Allocator, Arena};
fn inner<A: Allocator>(a: A) -> Vec<i64, A> { let mut v = Vec::new_in(a); v.push(1i64); v }
#[effects(alloc(B), panic)]
fn outer<A: Allocator, B: Allocator>(a: A, b: B) -> usize { inner(b).len() }

fn main(gpa: Gpa) {
    let ar = Arena::new_in(gpa);
    println("{}", outer(gpa, &ar));
}
