// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello (Option and tuple results of a let-param view)
// EXPECT: hello hello hello 7
#[derive(Clone, Copy)] struct E { name: [u8; 8], len: i64 }
fn nm(e: &E) -> Option<&[u8]> { Some(&e.name[..e.len as usize]) }
fn nt(e: &E) -> (i64, &[u8]) { (e.len, &e.name[..e.len as usize]) }
#[derive(Clone, Copy)] struct V<'a> { t: &'a [u8] }
fn nv(e: &E) -> V<'_> { V { t: &e.name[..e.len as usize] } }
fn clobber() -> i64 { let z = [7i64, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7, 7]; z[3] }

fn main() -> i32 {
    let e = E { name: [b'h', b'e', b'l', b'l', b'o', 0, 0, 0], len: 5 };
    let a = nm(&e).unwrap();
    let (_, b) = nt(&e);
    let c = nv(&e);
    let k = clobber();
    println("{a} {b} {} {k}", str::from_utf8(c.t).unwrap(), a = str::from_utf8(a).unwrap(),
        b = str::from_utf8(b).unwrap());
    0
}
