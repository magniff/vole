// (0.30) A reference to a union's field, or to a place within one, is
// unsafe, as rustc's E0133 ("access to union field is unsafe"): the
// reference reads the union's bytes as the field's type. Writing a field
// and `&raw const`/`&raw mut` of one stay safe (unsafe_union_write).
// ERROR: error[unsafe]: borrowing a field of a union is unsafe (rustc E0133)
// ERROR: line 41, column 14
// ERROR: error[unsafe]: borrowing a field of a union is unsafe (rustc E0133)
// ERROR: line 43, column 18
// ERROR: error[unsafe]: borrowing a field of a union is unsafe (rustc E0133)
// ERROR: line 47, column 18
// ERROR: error[unsafe]: borrowing a field of a union is unsafe (rustc E0133)
// ERROR: line 49, column 14
// ERROR-COUNT: 4
#[derive(Clone, Copy)]
struct P {
    x: i64,
    y: i64,
}

#[repr(C)]
union U {
    a: i64,
    p: P,
}

impl Clone for U {
    fn clone(&self) -> U {
        *self
    }
}

impl Copy for U {}

struct H {
    u: U,
}

fn main() {
    let mut u = U { a: 1 };
    u.a = 2;
    let r = &u.a;
    let _ = *r;
    let m = &mut u.p.x as *mut i64;
    let w = &raw mut u.a;
    let _ = (m, w);
    let mut h = H { u: U { a: 0 } };
    let t = &mut h.u.a;
    *t = 3;
    let s = &h.u.p;
    let whole = &h.u;
    let ok = unsafe { &u.a };
    let _ = (s, whole, ok);
}
