// RULE: D3.6, D2.7
// (0.28.0) A `&mut T` field given as a `&mut self` function's result is
// reborrowed, `&mut *self.v`, as rustc does at a coercion site (it was a
// move out of `self.v`); and a `&mut` held in a binding that is not
// `mut` is written through, as before.
// EXPECT: 5 4
struct G<'a> {
    v: &'a mut i64,
}

impl<'a> G<'a> {
    fn get(&mut self) -> &mut i64 {
        self.v
    }

    fn get_by_return(&mut self) -> &mut i64 {
        return self.v;
    }
}

fn bump(r: &mut i64) {
    *r += 1;
}

fn main() {
    let mut n = 1i64;
    let mut m = 1i64;
    {
        let mut g = G { v: &mut n };
        *g.get() += 1;
        *g.get_by_return() += 1;
        *g.get() += 1;
        let h = G { v: &mut m };
        *h.v += 1;
        bump(h.v);
        let r = &mut n;
        *r += 1;
    }
    println("{} {}", n, m + 1);
}
