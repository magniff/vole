// EDITION: rust
// (0.27.0) The two seams of 0.27.0's rust edition, which ran on MVS std:
// its getters gave copies where Rust's give `&T` (`*v.last().unwrap()`:
// edition.std_copy), and some of its functions took a value where Rust's
// take `&T` (`v.contains(&t)` of Strings: edition.std_by_value). (0.27.2)
// On std2 both are gone (Z4.1): Rust's spellings are right.
// RULE: Z4.1
// EXPECT: 2
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut s = 0;
    s += *v.last().unwrap();
    let mut names: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    let t = String::from_in("a", gpa);
    names.push(t.clone());
    if names.contains(&t) {
        s += 1;
    }
    println("{}", s);
}
