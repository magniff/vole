// EDITION: rust
// (0.27.0) The two seams of 0.27.0's rust edition, which runs on MVS std:
// its getters give copies where Rust's give `&T` (`*v.last().unwrap()`:
// edition.std_copy), and some of its functions take a value where Rust's
// take `&T` (`v.contains(&t)` of Strings: edition.std_by_value).
// ERROR: error[edition.std_copy]: 'v.last().unwrap()' is a 'i64', not a reference
// ERROR: try: v.last().unwrap()
// ERROR: error[edition.std_by_value]: a reference where a 'String<Gpa>' goes
// ERROR: try: t.clone()

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut s = 0;
    s += *v.last().unwrap();
    let mut names: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    let t = String::from_in("a", gpa);
    if names.contains(&t) {
        s += 1;
    }
    s as i32
}
