// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter Iterator::flatten.
// EXPECT: [1, 2, 3]

fn main(gpa: Gpa) {
    let v = Vec::from_in([Some(1i64), None, Some(2), Some(3)], gpa);
    let a: Vec<i64, Gpa> = v.iter().copied().flatten().collect_in(gpa);
    println("{:?}", a);
}
