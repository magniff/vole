// RULE: F18.6 (g)
// (0.27.6) A `_` solved to a type its bound does not hold is the bound's
// error, at the call and at the `_` (rustc E0277), once it is solved.
// ERROR: the trait 'Allocator' is not implemented for 'i64'
// ERROR: line 8, column 13
// ERROR: line 8, column 23
fn main() {
    let v = Vec::<u8, _>::new_in(5i64);
    println("{}", v.len());
}
