// RULE: F8.3, F8.4
// `<S as Conv<u8, _>>::c(true)`: the written first argument chooses (rustc 2 1)
// From the second round of the qualified paths: the arguments a path writes beside a `_` choose the impl; fails on v0.30.1 ("ambiguous").
// EXPECT: 2 1
trait Conv<A, B> {
    fn c(x: B) -> i64;
}

struct S;

impl Conv<i64, bool> for S {
    fn c(x: bool) -> i64 {
        1
    }
}

impl Conv<u8, bool> for S {
    fn c(x: bool) -> i64 {
        2
    }
}

fn main() {
    println("{} {}", <S as Conv<u8, _>>::c(true), <S as Conv<i64, _>>::c(false));
}
