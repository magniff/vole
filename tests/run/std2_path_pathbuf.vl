// The std2 item(s): std::path Path::as_str, Path::to_str, Path::as_bytes, Path::has_root,
// Path::is_relative, Path::metadata, Path::symlink_metadata, Path::is_symlink, Path::impl AsRef,
// Components::as_path, Iter::as_path, Component::as_str, StripPrefixError, PathBuf::with_capacity_in,
// PathBuf::capacity, PathBuf::clear, PathBuf::from_string, PathBuf::into_string, PathBuf::as_str,
// PathBuf::impl Deref, PathBuf::impl AsRef, PathBuf::impl Clone, PathBuf::impl PartialEq, and
// Path's methods on PathBuf; std::fs's AsRef<str> paths (a Path, a &PathBuf).
// RUSTC: none (std::path's named divergence: Path<'a>, as_str, from_string, into_string)
// EXPECT: /tmp/x.d/f.txt Some("/tmp/x.d/f.txt") 14 true false
// EXPECT: tmp/x.d/f.txt tmp
// EXPECT: /tmp/x.d ..
// EXPECT: prefix not found
// EXPECT: true 0 true
// EXPECT: "rel/dir" true true false
// EXPECT: 7 7 Some("dir") None
// EXPECT: Some("dir") Some("rel") true
// EXPECT: true Ok("dir")
// EXPECT: rel/dir/x rel/dir/x 9
// EXPECT: 3 3 4
// EXPECT: "" 3 2
// EXPECT: true true false true
// EXPECT: 3 true false
// EXPECT: 3 false
use std::fs;
use std::path::{Component, Path, PathBuf};

fn takes(p: impl AsRef<str>) -> usize {
    p.as_ref().len()
}

fn main(gpa: Gpa) {
    let p = Path::new("/tmp/x.d/f.txt");
    println("{} {:?} {} {} {}", p.as_str(), p.to_str(), p.as_bytes().len(), p.has_root(),
        p.is_relative());
    let mut c = p.components();
    c.next();
    println("{} {}", c.as_path(), c.next().unwrap().as_str());
    let mut it = p.iter();
    it.next_back();
    println("{} {}", it.as_path(), Component::ParentDir.as_str());
    println("{}", p.strip_prefix("/var").unwrap_err());
    let mut b: PathBuf<Gpa> = PathBuf::with_capacity_in(32, gpa);
    println("{} {} {}", b.capacity() >= 32, b.as_str().len(), b.parent().is_none());
    b.push("rel");
    b.push("dir");
    let b2 = b.clone();
    println("{:?} {} {} {}", b, b == b2, b.is_relative(), b.has_root());
    println("{} {} {:?} {:?}", b.len(), takes(&b), b.file_name(), b.extension());
    println("{:?} {:?} {}", b.file_stem(), b.parent(), b.starts_with("rel"));
    println("{} {:?}", b.ends_with("dir"), b.strip_prefix("rel"));
    let j = b.join_in("x", gpa);
    println("{} {} {}", j.display(), j.to_str().unwrap(), j.as_bytes().len());
    let mut n = 0;
    for _ in j.components() {
        n += 1;
    }
    println("{} {} {}", n, j.iter().count(), j.ancestors().count());
    let s = j.into_string();
    let mut k = PathBuf::from_string(s);
    k.clear();
    println("{:?} {} {}", k, takes(Path::new("abc")), takes("ab"));
    fs::create_dir_all("t/sub").unwrap();
    fs::write("t/sub/a.txt", "hey").unwrap();
    let f = PathBuf::from_in("t/sub/a.txt", gpa);
    let d = Path::new("t/sub");
    println("{} {} {} {}", f.exists(), f.is_file(), f.is_dir(), d.is_dir());
    println("{} {} {}", f.metadata().unwrap().len(), d.symlink_metadata().unwrap().is_dir(),
        d.is_symlink());
    println("{} {}", fs::metadata(&f).unwrap().len(), Path::new("t/none").exists());
    fs::remove_dir_all("t").unwrap();
}
