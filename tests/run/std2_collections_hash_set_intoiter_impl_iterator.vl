use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    s.insert(1);
    let mut it = s.into_iter();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
