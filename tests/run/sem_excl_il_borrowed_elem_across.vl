// let x = v[0] borrows an owned element (D13); v.clear() while x is used
// ERROR: error[borrowck.conflict]
// ERROR: line 6, column 5
fn main(gpa: Gpa) {
    let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa); v.push(Vec::new_in(gpa)); let x = &v[0];
    v.clear();
    println("{}", x.len());
}
