// XFAIL: RT-422: UNSOUND: (RT-383's other forms) a `&'static` field takes a borrow of a local or of a Box's contents through an enum variant (`E::A(&*b)`, `E::B { r: &*b }`), a tuple struct (`T(&*b)`), a struct literal passed to a fn that returns the field, a nested literal, `Box::new_in(V { .. })`, a closure's literal, `Some(V { .. })`, a parameter's borrow and `s.as_str()` of a local String: use after free under --check-alloc (0.30.2)
// rustc E0597 (+ E0505 at each drop) for each (twin .rs.txt): 14 errors.
// vole checks it clean; --check-alloc: `use after free: block #1 (8
// bytes)`, freed at the first `drop(b1)`. v0.28.0 to v0.30.1 the same.
// RT-383 is the struct and union literal returned from the function that
// owns the local (`V { a: &e }`); `let r: &'static u64 = &e;`, a tuple
// `(&e, 1)` typed `(&'static u64, i64)`, `v.a = &e` and a generic
// `V<&'static u64>` literal are refused right (borrowck.return_local,
// dropped_borrowed). Here the main forms keep no local of a returning
// function at all: a heap value's borrow goes into the literal and the
// callee returns it as 'static.
// FLAGS: --check-alloc
// ERROR: line 56
// ERROR: line 61
// ERROR: line 66
// ERROR: line 72
// ERROR: line 76
// ERROR: line 81
// ERROR: line 86
// ERROR: line 89
// ERROR: line 92
// ERROR: line 95
// (each ERROR is at a borrow; rustc's E0505 at the drops follow from them)
enum E {
    A(&'static u64),
    B { r: &'static u64 },
}

struct T(&'static u64);

struct V {
    a: &'static u64,
}

struct O {
    v: V,
}

struct Vs {
    s: &'static str,
}

fn ka(e: E) -> &'static u64 {
    match e {
        E::A(r) => r,
        E::B { r } => r,
    }
}

fn kv(v: V) -> &'static u64 {
    v.a
}

fn mk_nested() -> O {
    let e = 7u64;
    O { v: V { a: &e } }
}

fn mk_boxed(gpa: Gpa) -> Box<V, Gpa> {
    let e = 7u64;
    Box::new_in(V { a: &e }, gpa)
}

fn mk_closure() -> V {
    let e = 7u64;
    let f = || V { a: &e };
    f()
}

fn mk_some() -> Option<V> {
    let e = 7u64;
    Some(V { a: &e })
}

fn mk_param(e: u64) -> V {
    V { a: &e }
}

fn mk_str(gpa: Gpa) -> Vs {
    let s = String::from_in("hello", gpa);
    Vs { s: s.as_str() }
}

fn main(gpa: Gpa) {
    let b1 = Box::new_in(1001u64, gpa);
    let r1 = ka(E::A(&*b1));
    drop(b1);
    let b2 = Box::new_in(1002u64, gpa);
    let r2 = ka(E::B { r: &*b2 });
    drop(b2);
    let b3 = Box::new_in(1003u64, gpa);
    let t = T(&*b3);
    drop(b3);
    let b4 = Box::new_in(1004u64, gpa);
    let r4 = kv(V { a: &*b4 });
    drop(b4);
    println("{} {} {} {}", r1, r2, t.0, r4);
    println("{} {} {} {} {} {}", mk_nested().v.a, mk_boxed(gpa).a, mk_closure().a,
        mk_some().unwrap().a, mk_param(7).a, mk_str(gpa).s);
}
