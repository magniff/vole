// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::iter_mut.
// EXPECT: [(1, 11), (2, 22)]
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    for (k, x) in m.iter_mut() {
        *x += *k;
    }
    let mut v: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    for (k, x) in m.iter() {
        v.push((*k, *x));
    }
    v.sort();
    println("{:?}", v);
}
