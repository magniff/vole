// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::iter_mut.
// EXPECT: [(1, 11), (2, 22)]
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 10);
    m.insert(2, 20);
    for (k, x) in m.iter_mut() {
        *x += *k;
    }
    let mut v: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    for (k, x) in m.iter() {
        v.push((*k, *x));
    }
    v.sort();
    println("{:?}", v);
}
