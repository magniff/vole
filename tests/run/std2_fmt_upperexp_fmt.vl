// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::fmt UpperExp::fmt.
// EXPECT: 1.2345E3
use std::fmt::{Formatter, UpperExp};

struct W {
    v: f64,
}

impl UpperExp for W {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        self.v.fmt(f)
    }
}

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = UpperExp::fmt(&W { v: 1234.5f64 }, &mut f);
    println("{}", s);
}
