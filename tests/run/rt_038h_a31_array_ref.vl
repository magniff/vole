// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a31_array_ref)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A &[i64; 2] the clause reads: the callee writes through as_ptr.
fn poke(a: &[i64; 2]) -> bool {
    let p = a.as_ptr() as *mut i64;
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(a: &[i64; 2]) -> i64
    requires poke(a)
{
    a[0]
}

fn main() {
    let a = [1i64, 2];
    println("{}", f(&a));
    println("{}", a[0]);
}
