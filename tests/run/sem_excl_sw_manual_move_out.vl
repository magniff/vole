// XFAIL: gap 3: errors at other places or codes: type errors: not every error is a covered type error [first rust error: ex...
// moving out of an inout parameter is own.move_out (it must keep a value)
// ERROR: own.move_out
fn sw(a: &mut Vec<i64, Gpa>, b: &mut Vec<i64, Gpa>) { let t = a; *a = b; *b = t; }

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa); let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    sw(&mut a, &mut b);
    println("{}", a.len());
}
