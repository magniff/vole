// 0.16: a static's value can be made by a constant constructor (its body
// is one struct literal): one takes arguments (`P::at(3, 4)`), nests in
// another (`Seg::of(P::at(1, 2), 6)`), fills tuples and arrays. (0.26.3: a
// static holds no allocator, alloc.static: the containers this case kept
// in statics on an arena, which main gave them, are main's, on its arena,
// and passed down.)
// EXPECT: 7 3 4 9 1 6
// EXPECT: 3 nodes, 6 total; 2 names; text: a1b2
struct Node { id: i64, weight: i64 }

struct P { x: i64, y: i64 }

impl P {
    fn at(x: i64, y: i64) -> P {
        P { x: x, y: y }
    }
}

struct Seg { a: P, len: i64 }

impl Seg {
    fn of(a: P, len: i64) -> Seg {
        Seg { a: a, len: len }
    }
}

fn with_weight(p: P, k: i64) -> (P, i64) {
    (p, k * 2 + 1)
}

static var PAIR: (i64, [i64; 2]) = (7, [0, 0]);
static var PS: [P; 2] = [P::at(3, 4), P::at(5, 6)];
static var T: (P, i64) = with_weight(P::at(3, 4), 4);
static var S: Seg = Seg::of(P::at(1, 2), 6);

fn add(nodes: inout Vec<Node, Arena>, id: i64, weight: i64) {
    nodes.push(Node { id: id, weight: weight });
}

fn main(gpa: Gpa) {
    println("{} {} {} {} {} {}", PAIR.0, PS[0].x, PS[0].y, T.1, S.a.x, S.len);
    let arena = Arena::new_in(gpa);
    var nodes: Vec<Node, Arena> = Vec::new_in(arena);
    var names: std::HashMap<i64, [u8], Arena> = std::HashMap::new_in(arena);
    var text: String<Arena> = String::new_in(arena);
    add(&nodes, 1, 1);
    add(&nodes, 2, 2);
    add(&nodes, 3, 3);
    names.insert(1, "one");
    names.insert(2, "two");
    text.push_str("a1");
    text.push_str("b2");
    var total = 0;
    for n in nodes.as_slice() {
        total += n.weight;
    }
    println("{} nodes, {total} total; {} names; text: {text}", nodes.len(), names.len());
}
