// 0.16: a static's value can be made by a constant constructor (its body
// is one struct literal): one takes arguments (`P::at(3, 4)`), nests in
// another (`Seg::of(P::at(1, 2), 6)`), fills tuples and arrays. (0.26.3: a
// static holds no allocator, alloc.static: the containers this case kept
// in statics on an arena, which main gave them, are main's, on its arena,
// and passed down.)
// EXPECT: 7 3 4 9 1 6
// EXPECT: 3 nodes, 6 total; 2 names; text: a1b2
use std::alloc::Arena; #[derive(Clone, Copy)] struct Node { id: i64, weight: i64 }

#[derive(Clone, Copy)] struct P { x: i64, y: i64 }

impl P {
    fn at(x: i64, y: i64) -> P {
        P { x: x, y: y }
    }
}

#[derive(Clone, Copy)] struct Seg { a: P, len: i64 }

impl Seg {
    fn of(a: P, len: i64) -> Seg {
        Seg { a: a, len: len }
    }
}

fn with_weight(p: P, k: i64) -> (P, i64) {
    (p, k * 2 + 1)
}

static mut PAIR: (i64, [i64; 2]) = (7, [0i64, 0]);
static mut PS: [P; 2] = [P::at(3, 4), P::at(5, 6)];
static mut T: (P, i64) = with_weight(P::at(3, 4), 4);
static mut S: Seg = Seg::of(P::at(1, 2), 6);

fn add(nodes: &mut Vec<Node, &Arena<Gpa>>, id: i64, weight: i64) {
    nodes.push(Node { id: id, weight: weight });
}

fn main(gpa: Gpa) {
    println("{} {} {} {} {} {}", unsafe { PAIR.0 }, unsafe { PS[0].x }, unsafe { PS[0].y },
        unsafe { T.1 }, unsafe { S.a.x }, unsafe { S.len });
    let arena = Arena::new_in(gpa);
    let mut nodes: Vec<Node, &Arena<Gpa>> = Vec::new_in(&arena);
    let mut names: std::collections::HashMap<i64, &str,
        &Arena<Gpa>> = std::collections::HashMap::new_in(&arena);
    let mut text: String<&Arena<Gpa>> = String::new_in(&arena);
    add(&mut nodes, 1, 1);
    add(&mut nodes, 2, 2);
    add(&mut nodes, 3, 3);
    names.insert(1, "one");
    names.insert(2, "two");
    text.push_str("a1");
    text.push_str("b2");
    let mut total: i64 = 0;
    for &n in nodes.as_slice() {
        total += n.weight;
    }
    println("{} nodes, {total} total; {} names; text: {text}", nodes.len(), names.len());
}
