// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::ops RangeToInclusive::impl RangeBounds.
// EXPECT: Unbounded Included(4) true false
use std::ops::{RangeBounds, RangeToInclusive};

fn main() {
    let r: RangeToInclusive<i64> = ..=4;
    println("{:?} {:?} {} {}", r.start_bound(), r.end_bound(), r.contains(&4), r.contains(&5));
}
