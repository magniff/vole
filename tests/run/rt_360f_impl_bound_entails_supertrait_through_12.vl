// An impl under `Y: T11` calls T0's `top` on a Y: the bound gives T0 through 12 supertraits (coherence::trait_implies and opaque::entails cut at 8; v0.30.1: "no method 'top' on type parameter 'Y'"; rustc 40)
// From the re-review of the qualified paths (RT-360, RT-353): fails on v0.30.1.
// EXPECT: 40
trait T0 {
    const K: i64;
    type Out;
    fn top(&self) -> i64;
}

trait T1: T0 {}

trait T2: T1 {}

trait T3: T2 {}

trait T4: T3 {}

trait T5: T4 {}

trait T6: T5 {}

trait T7: T6 {}

trait T8: T7 {}

trait T9: T8 {}

trait T10: T9 {}

trait T11: T10 {}

struct S;

impl T0 for S {
    const K: i64 = 5;
    type Out = i64;

    fn top(&self) -> i64 {
        3
    }
}

impl T1 for S {}

impl T2 for S {}

impl T3 for S {}

impl T4 for S {}

impl T5 for S {}

impl T6 for S {}

impl T7 for S {}

impl T8 for S {}

impl T9 for S {}

impl T10 for S {}

impl T11 for S {}

trait Q: T0 {
    fn q(&self) -> i64;
}

struct W<Y>(Y);

impl<Y: T11> T0 for W<Y> {
    const K: i64 = 7;
    type Out = i64;

    fn top(&self) -> i64 {
        self.0.top() + 1
    }
}

impl<Y: T11> Q for W<Y> {
    fn q(&self) -> i64 {
        self.top() * 10
    }
}

fn main() {
    println("{}", W(S).q());
}
