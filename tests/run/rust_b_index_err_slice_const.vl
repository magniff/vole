// EDITION: rust
// RULE: D8.6
// (0.27.2.1) A move out of a slice's element by a constant index (rustc
// E0508: cannot move out of a non-copy slice).
// ERROR: error[borrowck.move_out]: cannot move out of 's[_]', an element of a slice whose type is not Copy
// ERROR-COUNT: 1
struct N {
    v: i64,
}

fn first(s: &[N]) -> i64 {
    let n = s[0];
    n.v
}

fn main() {
    let a = [N { v: 1 }, N { v: 2 }];
    println("{}", first(&a));
}
