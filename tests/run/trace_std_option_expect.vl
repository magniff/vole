// (0.28.0) --trace: a failed Option::expect in a program prints its line (the
// caller's place, gap 79), then the calls that led to it: std's panic
// ends in the trace runtime's dump, as a failed check does.
// FLAGS: --trace
// EXIT: 101
// STDERR: trace_std_option_expect.vl:12:5: a colon
// STDERR: trace, innermost call first:
// STDERR: trace_std_option_expect.vl:12  port_of
// STDERR: trace_std_option_expect.vl:16  show
// STDERR: trace_std_option_expect.vl:20  main
fn port_of(value: &str) -> i64 {
    value.find(":").map(|i| i as i64).expect("a colon")
}

fn show(value: &str) {
    println("{}", port_of(value));
}

fn main() {
    show("80a");
}
