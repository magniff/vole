// RULE: C3.4
// (0.30.2, RT-38f) A parameter written `Self` in `impl Set for &mut
// i64`: a `&mut i64` with no view after the body (0.30.1 printed 2 9).
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*s'
// ERROR-COUNT: 1
trait Set {
    fn set(s: Self) -> i64;
}

impl Set for &mut i64 {
    fn set(s: Self) -> i64
        ensures {
        *s = 9;
        true
    }

    {
        *s += 1;
        *s
    }
}

fn main() {
    let mut x = 1i64;
    println("{}", Set::set(&mut x));
    println("{}", x);
}
