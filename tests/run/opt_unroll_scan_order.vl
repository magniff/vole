fn main() {
    let mut b_u8: [u8; 64] = [0; 64];
    for i in 0..64 { b_u8[i] = ((i * 37 + 11) % 101) as u8; }
    let mut b_i8: [i8; 64] = [0; 64];
    for i in 0..64 { b_i8[i] = ((i * 37 + 11) % 101) as i8; }
    let mut b_u16: [u16; 64] = [0; 64];
    for i in 0..64 { b_u16[i] = ((i * 37 + 11) % 101) as u16; }
    let mut b_i16: [i16; 64] = [0; 64];
    for i in 0..64 { b_i16[i] = ((i * 37 + 11) % 101) as i16; }
    let mut b_u32: [u32; 64] = [0; 64];
    for i in 0..64 { b_u32[i] = ((i * 37 + 11) % 101) as u32; }
    let mut b_i32: [i32; 64] = [0; 64];
    for i in 0..64 { b_i32[i] = ((i * 37 + 11) % 101) as i32; }
    let mut b_u64: [u64; 64] = [0; 64];
    for i in 0..64 { b_u64[i] = ((i * 37 + 11) % 101) as u64; }
    let mut b_i64: [i64; 64] = [0; 64];
    for i in 0..64 { b_i64[i] = ((i * 37 + 11) % 101) as i64; }
    print("order_add_u8:");
    for n in [0usize, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 33, 64] {
        let mut a: [u8; 64] = [0; 64];
        let mut c: [u8; 64] = [0; 64];
        let r = order_add_u8(&mut a[0..n], &b_u8[0..n], &mut c[0..n]);
        print(" {}/{}", r, hash_u8(&a).wrapping_add(hash_u8(&c)));
    }
    println("");
    print("three_add_u8:");
    for n in [0usize, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 33, 64] {
        let mut a: [u8; 64] = [0; 64];
        let mut c: [u8; 64] = [0; 64];
        let r = three_add_u8(&mut a[0..n], &b_u8[0..n], &mut c[0..n]);
        print(" {}/{}", r, hash_u8(&a).wrapping_add(hash_u8(&c)));
    }
    println("");
    print("phis_add_u8:");
    for n in [0usize, 1, 2, 3, 4, 5, 7, 8, 9, 15, 16, 17, 33, 64] {
        let mut a: [u8; 64] = [0; 64];
        let mut c: [u8; 64] = [0; 64];
        let r = phis_add_u8(&mut a[0..n], &b_u8[0..n], &mut c[0..n]);
        print(" {}/{}", r, hash_u8(&a).wrapping_add(hash_u8(&c)));
    }
    println("");
    print("spread_add_u8:");
