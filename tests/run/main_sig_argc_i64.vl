// (0.30.2, RT-47's family) main's argc is C's int: an i32. Taken as an
// i64, its upper half is whatever the register held (AArch64 and x86-64
// leave it undefined), so it is refused, as rustc refuses any parameter
// of main (E0580).
// ERROR: main.signature
// ERROR: line 7, column 9
fn main(argc: i64, argv: *mut *mut u8) -> i32 {
    println("{argc}");
    let _ = argv;
    0
}
