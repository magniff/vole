// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::impl PartialEq<Vec<U, B>>.
// EXPECT: true false
use std::alloc::Arena;

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let a = Vec::from_in([1, 2], gpa);
    let b = Vec::from_in([1, 2], &arena);
    let c = Vec::from_in([1], gpa);
    println("{} {}", a == b, a == c);
}
