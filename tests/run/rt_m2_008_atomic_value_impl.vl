// AtomicValue is for the integers, bool and raw pointers only ("no
// program can implement it": guide threads); its seal is a method
// returning std::sync::atomic::Sealed, "private", but Sealed is a
// `pub struct` any program names. An Atomic<Big> then loads
// `Big { a: 6, b: 6093827096, c: 288230376151711746 }` at -O0 (and the
// stored value at -O2). The impl must be refused.
// ERROR: error[trait.sealed]
// ERROR: line 18, column 1
use std::sync::atomic::{Atomic, AtomicValue, Ordering, Sealed};

#[derive(Clone, Copy, PartialEq, Debug)]
struct Big {
    a: i64,
    b: i64,
    c: i64,
}

impl AtomicValue for Big {
    fn sealed_value(self) -> Sealed {
        panic("never called")
    }
}

fn main() {
    let a: Atomic<Big> = Atomic::new(Big { a: 1, b: 2, c: 3 });
    a.store(Big { a: 4, b: 5, c: 6 }, Ordering::SeqCst);
    println("{:?}", a.load(Ordering::SeqCst));
}
