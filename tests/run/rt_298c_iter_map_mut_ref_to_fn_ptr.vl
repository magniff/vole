// XFAIL: RT-298c: (RT-298's mechanism, `.map(&mut p)`) `a.iter().map(|x| *x).map(&mut p).sum()` with `p: fn(i64) -> i64` is refused ("no method 'sum' on type 'Map<.., &mut fn(i64) -> i64>'", B not inferred); rustc prints 6 (0.30.2)
// From the re-review of the fn-value work (g302fnval). Since v0.30.1 at least.
// EXPECT: 6
fn dbl(x: i64) -> i64 {
    x * 2
}

fn main() {
    let mut p: fn(i64) -> i64 = dbl;
    let a = [1i64, 2];
    let s: i64 = a.iter().map(|x| *x).map(&mut p).sum();
    println("{}", s);
}
