// (0.30.2, obligations M1) A blanket impl beside a concrete one coherence
// allows (W is no Sup): the concrete impl, the one selection chooses for W,
// has its `'a: 'static` required where go is called (rustc E0597).
// ERROR: borrowck.dropped_borrowed
trait Sup { fn up(&self) -> i64; }
trait Tr { fn f(&self) -> &'static str; }
struct W<'a> { r: &'a str }
struct V;
impl Sup for V { fn up(&self) -> i64 { 1 } }
impl<T: Sup> Tr for T { fn f(&self) -> &'static str { "blanket" } }
impl<'a: 'static> Tr for W<'a> { fn f(&self) -> &'static str { self.r } }
fn go<T: Tr>(t: &T) -> &'static str { t.f() }

fn main(gpa: Gpa) {
    let s = { let st = String::from_in("hello heap string long", gpa); go(&W { r: st.as_str() }) };
    println("{} {}", s, go(&V));
}
