// EDITION: rust
// RULE: D3.6
// (0.27.7) A `&mut` made a written `*mut` is `&raw mut`, a deep write of
// what it points to, however it is made: a `&mut [T]` given or cast to
// `*mut [T]`, `&mut s[..]` made a fat raw pointer (to `*const [T]` too:
// the `&mut` is written), `x as *mut T` of a `&mut T`. A shared borrow
// live across it is rustc's E0502 at each. 0.27.6 accepted all five.
// ERROR: error[borrowck.conflict]
// ERROR: line 21, column 24
// ERROR: line 28, column 13
// ERROR: line 35, column 29
// ERROR: line 42, column 31
// ERROR: line 49, column 13
// ERROR-COUNT: 5
fn sink<T>(_p: T) {}

// (each borrow r is read after the raw pointer is made)

fn given(s: &mut [u8]) -> u8 {
    let r = &s[0];
    let p: *mut [u8] = s;
    sink(p);
    *r
}

fn cast(s: &mut [u8]) -> u8 {
    let r = &s[0];
    let p = s as *mut [u8];
    sink(p);
    *r
}

fn sliced(s: &mut [u8]) -> u8 {
    let r = &s[0];
    let p: *mut [u8] = &mut s[..];
    sink(p);
    *r
}

fn sliced_const(s: &mut [u8]) -> u8 {
    let r = &s[0];
    let p: *const [u8] = &mut s[1..];
    sink(p);
    *r
}

fn thin_cast(x: &mut i64) -> i64 {
    let r = &*x;
    let p = x as *mut i64;
    sink(p);
    *r
}

fn main() {
    let mut m = [1u8, 2];
    let mut v = 1i64;
    println("{} {} {} {} {}", given(&mut m), cast(&mut m), sliced(&mut m), sliced_const(&mut m),
        thin_cast(&mut v));
}
