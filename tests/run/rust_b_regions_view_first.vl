// EDITION: rust
// (0.27.1) The regions dump (`check --emit-places=regions`, borrowck.md
// section 16) on two small bodies: an element loan through a view (D1.4:
// the view's slot supports it, `'r2: 'r3`, and it flows into the return
// place), and a slice loan flowing through a call's region into the
// caller's reference (`'r9: 'r2`, `'r2: 'r10`, `'r10: 'r1`); a `&mut`
// argument whose call returns no reference makes no call region.
// RULE: D1.4
// RULE: D3.6
// RULE: D3.7
// FLAGS: --emit-places=regions
// EXPECT: 6 6
// PLACES: fn first
// PLACES: live _1: bb0[0..5]
// PLACES: constraint 'r2: 'r4 @ bb0[5]
// PLACES: constraint 'r4: 'r3 @ bb0[5]
// PLACES: constraint 'r3: 'r2 @ bb1[0]
// PLACES: value 'r2: bb0[0..8+] bb1[0..0+] end('r2)
// PLACES: value 'r4: bb0[0..8+] bb1[0..0+] end('r2)
// PLACES: loan L1: &_1[_2] @ bb0[5] 'r4
// PLACES: fn pick
// PLACES: live _2: bb0[0..1]
// PLACES: value 'r2: bb0[0..2+] bb1[0..0+] end('r2)
// PLACES: fn main
// PLACES: constraint 'r10: 'r3 @ bb0[4]
// PLACES: constraint 'r3: 'r11 @ bb0[5]
// PLACES: constraint 'r11: 'r2 @ bb0[5]
// PLACES: constraint 'r12: 'r4 @ bb0[10]
// PLACES: value 'r10: bb0[4+..11]
// PLACES: loan L1: &_1 @ bb0[4] 'r10
// PLACES: loan L2: &mut _4 @ bb0[10] 'r12
// PLACES: solved: 3 bodies, 0 reused (key)
fn first(s: &[i64]) -> &i64 {
    &s[0]
}

fn pick(a: &i64, b: &mut i64) -> i64 {
    *b += *a;
    *b
}

fn main() {
    let v = [1, 2, 3];
    let r = first(&v[..]);
    let mut n = 5;
    let k = pick(r, &mut n);
    println("{} {}", k, n);
}
