// EDITION: rust
// RULE: Z9.2, F26.1
// `==` of two slices or two strs is `PartialEq::eq` with the right-hand
// side as it is: `&[T]` is the view (str::find's `&h[i..j] == needle`).
// EXPECT: true false
// EXPECT: Some(1)
fn main() {
    let a = [1u8, 2, 3];
    let b = [1u8, 2, 3];
    let c = [1u8, 2];
    println("{} {}", &a[..] == &b[..], &a[..] == &c[..]);
    println("{:?}", "abc".find("bc"));
}
