// (0.25.2) EXPECT holes: a line of output that changes from run to run
// (a time, a count) is matched with {num} (a number), {int} (an integer)
// and {..} (any text within the line); the rest of the line is exact.
// EXPECT: start
// EXPECT: took {num} ms
// EXPECT: {int} ticks, {..}
// EXPECT: P { a: {int} }
// EXPECT: done

use std::time::monotonic_now;

fn main() {
    println("start");
    let t0 = monotonic_now();
    var sum: u64 = 0;
    for i in 0..1000 {
        sum += i as u64;
    }
    let t = monotonic_now().saturating_sub(t0);
    println("took {} ms", t.as_millis_f64());
    println("{} ticks, sum {sum} (varies: {})", t.as_nanos() % 1000, t.as_nanos());
    println("P {{ a: {} }}", sum % 7);
    println("done");
}
