// (0.30.2, RT-47's family) Only the program's entry is held to main's
// forms: a module's `fn main` and a method named main are functions like
// any other, with any parameters and result.
// EXPECT: 2 x 7
mod m {
    pub fn main(v: Vec<i64, Gpa>, s: &str) -> String<Gpa> {
        let mut out = v.len().to_string_in(*v.allocator());
        out.push_str(" ");
        out.push_str(s);
        out
    }
}

struct S {
    x: i64,
}

impl S {
    fn main(self, y: i64) -> u8 {
        (self.x + y) as u8
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let s = S { x: 4 };
    println("{} {}", m::main(v, "x"), s.main(3));
}
