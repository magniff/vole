// match on integers and enums becomes a switch (a jump table when dense,
// a binary search otherwise), at every level the same values.
// CHECK-OPT: 1
// CHECK: fn dense
// CHECK: switch
// CHECK: fn sparse
// CHECK: switch
// CHECK: fn op_name
// CHECK: switch
// CHECK: fn eval
// CHECK: switch
use std::ops::Add; use std::ops::Sub; use std::ops::Mul; extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn dense(x: i32) -> i32 {
    match x {
        0 => 10,
        1 => 11,
        2 | 3 => 12,
        4 => 14,
        5..=7 => 15,
        9 => 19,
        -1 => 99,
        _ => -1,
    }
}

fn sparse(x: u64) -> i64 {
    match x {
        1 => 1,
        10 => 2,
        100 => 3,
        1000 => 4,
        100000 => 5,
        10000000000 => 6,
        18446744073709551615 => 7,
        _ => 0,
    }
}

#[derive(Clone, Copy)] enum Op { Push(i64), Pop, Add, Sub, Mul, Dup, Swap, Jump(i64) }

fn op_name(op: Op) -> *mut u8 {
    match op {
        Op::Push(_) => c"push",
        Op::Pop => c"pop",
        Op::Add => c"add",
        Op::Sub => c"sub",
        Op::Mul => c"mul",
        Op::Dup => c"dup",
        Op::Swap => c"swap",
        Op::Jump(_) => c"jump",
    }
}

fn eval(ops: &[Op]) -> i64 {
    let mut stack: [i64; 16] = [0i64; 16];
    let mut sp: i64 = 0;
    let mut pc: u64 = 0;
    while pc < ops.len() as u64 {
        match ops[pc as usize] {
            Op::Push(v) => {
                stack[sp as usize] = v;
                sp += 1;
            }
            Op::Pop => sp -= 1,
            Op::Add => {
                sp -= 1;
                stack[(sp - 1) as usize] += stack[sp as usize];
            }
            Op::Sub => {
                sp -= 1;
                stack[(sp - 1) as usize] -= stack[sp as usize];
            }
            Op::Mul => {
                sp -= 1;
                stack[(sp - 1) as usize] *= stack[sp as usize];
            }
            Op::Dup => {
                stack[sp as usize] = stack[(sp - 1) as usize];
                sp += 1;
            }
            Op::Swap => {
                let t = stack[(sp - 1) as usize];
                stack[(sp - 1) as usize] = stack[(sp - 2) as usize];
                stack[(sp - 2) as usize] = t;
            }
            Op::Jump(k) => pc = k as u64 - 1,
        }
        pc += 1;
    }
    stack[(sp - 1) as usize]
}

fn main() {
    for i in -2i32..12 {
        unsafe { printf(c"%d,", dense(i)); }
    }
    unsafe { printf(c"\n"); }
    let xs: [u64; 9] = [0, 1, 10, 100, 1000, 100000, 10000000000, 18446744073709551615, 5];
    for i in 0..9 {
        unsafe { printf(c"%ld,", sparse(xs[i as usize])); }
    }
    unsafe {
        printf(c"\n%s %s %s\n", op_name(Op::Push(1i64)), op_name(Op::Swap),
            op_name(Op::Jump(3i64)));
    }
    let prog: [Op; 9] = [Op::Push(6i64), Op::Push(7i64), Op::Mul, Op::Dup, Op::Add, Op::Push(4i64),
        Op::Swap, Op::Sub, Op::Push(0i64)];
    unsafe { printf(c"%ld\n", eval(&prog[..8])); }
}

// EXPECT: -1,99,10,11,12,12,14,15,15,15,-1,19,-1,-1,
// EXPECT: 0,1,2,3,4,5,6,7,0,
// EXPECT: push swap jump
// EXPECT: -80
