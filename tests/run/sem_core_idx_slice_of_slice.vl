// EDITION: rust
// An index into a subslice is checked against the subslice, not the whole.
// EXIT: 101
// STDERR: index out of bounds: index 2, length 2
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3, 4, 5];
    let s = &a[1..3];
    println("{}", s[(2 + unsafe { Z }) as usize]);
    println("not reached");
    0
}
