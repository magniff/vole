// RULE: E1.7 (0.30.1) With the overflow checks on (-O0's default, and
// --overflow-checks=on at any level, as here at -O2) `+`, `-`, `*`, `<<`
// and a `-x` panic: the effects give the function the raw panic the
// optimizer reads (no nopanic), so -O2 keeps a call whose unused result
// overflows. The visible effect, which #[no_panic] reads, does not
// depend on the level. Before 0.30.1 the call was deleted and the
// program printed `after`.
// FLAGS: -O2 --overflow-checks=on
// STDERR: attempt to negate with overflow
// EXIT: 101
#[inline(never)]
fn add(a: i64, b: i64) -> i64 {
    a + b
}

#[inline(never)]
fn neg(a: i64) -> i64 {
    -a
}

#[inline(never)]
fn shl(a: i32, b: i32) -> i32 {
    a << b
}

fn main() {
    // no arguments: n is 1
    let n = std::env::args().count() as i64;
    let _a = add(1, n);
    let _s = shl(1, n as i32);
    let _x = neg(i64::MIN + n - 1);
    println("after");
}
