// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::keys.
// EXPECT: [1, 2, 3]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(2, 0);
    m.insert(3, 0);
    m.insert(1, 0);
    let mut ks: Vec<i64, Gpa> = m.keys().copied().collect_in(gpa);
    ks.sort();
    println("{:?}", ks);
}
