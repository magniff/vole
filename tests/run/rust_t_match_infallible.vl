// EDITION: rust
// RULE: F11.3
// (0.28.0) A `Result<T, Infallible>` has no `Err` value: a match on it
// need not write the arm (it was "non-exhaustive"), and may write it (it
// was "unreachable": no spelling compiled; rustc takes both, the arm with
// at most a lint, and nothing is said here). Its `{:?}` too.
// EXPECT: 3 3
// EXPECT: Ok(3)
use std::convert::Infallible;

fn value(r: Result<i64, Infallible>) -> i64 {
    match r {
        Ok(v) => v,
    }
}

fn written(r: Result<i64, Infallible>) -> i64 {
    match r {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn main() {
    let r: Result<i64, Infallible> = Ok(3);
    let w: Result<i64, Infallible> = Ok(3);
    println("{} {}", value(r), written(w));
    let s: Result<i64, Infallible> = Ok(3);
    println("{:?}", s);
}
