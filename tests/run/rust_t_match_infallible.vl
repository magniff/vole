// EDITION: rust
// RULE: F11.3
// (0.28.0) A `Result<T, Infallible>` has no `Err` value: a match on it
// need not write the arm (it was "non-exhaustive", and writing the arm
// was "unreachable": no spelling compiled). Its `{:?}` too.
// EXPECT: 3
// EXPECT: Ok(3)
use std::convert::Infallible;

fn value(r: Result<i64, Infallible>) -> i64 {
    match r {
        Ok(v) => v,
    }
}

fn main() {
    let r: Result<i64, Infallible> = Ok(3);
    println("{}", value(r));
    let s: Result<i64, Infallible> = Ok(3);
    println("{:?}", s);
}
