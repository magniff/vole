// EDITION: rust
// XFAIL: gap 2: errors at other places or codes: MVS effect@26:5; effect@35:5; effect@44:5; rust type error@21:29; type err...
// 0.16: std's Eq::eq, Ord::cmp and Hash::hash are #[pure], so every impl
// of them is checked: no alloc, io or global (at -O0 too). A derived impl
// and a pure one by hand pass; one writing a static, one printing and one
// allocating are errors at the impl.
// FLAGS: -O0
// ERROR: 'Counted::hash' implements 'Hash::hash', which is #[pure], but it touches a static mut or a C static (static)
// ERROR: 'Loud::eq' implements 'Eq::eq', which is #[pure], but it does io
// ERROR: 'Boxed<Gpa>::cmp' implements 'Ord::cmp', which is #[pure], but it allocates from Gpa
// ERROR-COUNT: 3
use std::alloc::Allocator; use std::cmp::PartialEq as Eq; use std::hash::Hash;

static mut HASHES: i64 = 0;

#[derive(PartialEq, Eq, Hash, Clone, Copy)]
struct Plain { v: i64 }

#[derive(Clone, Copy)] struct ByHand { v: i64 }

impl Hash for ByHand {
    fn hash(&self) -> u64 { std::hash_u64(self.v as u64) }
}

#[derive(Clone, Copy)] struct Counted { v: i64 }

impl Hash for Counted {
    fn hash(&self) -> u64 {
        unsafe { HASHES += 1; }
        self.v as u64
    }
}

#[derive(Clone, Copy)] struct Loud { v: i64 }

impl PartialEq for Loud {
    fn eq(&self, other: &Loud) -> bool {
        println("comparing");
        self.v == other.v
    }
} impl Eq for Loud {}

#[derive(Clone, Copy)] struct Boxed<A: Allocator> { v: i64, gpa: A }

impl Ord for Boxed<Gpa> {
    fn cmp(&self, other: &Boxed<Gpa>) -> std::cmp::Ordering { ({
        let mut t: Vec<i64, Gpa> = Vec::new_in(self.gpa);
        t.push(self.v - other.v);
        let d = t.as_slice()[0];
        drop(t);
        d
    }).cmp(&0) }
} impl PartialOrd for Boxed<Gpa> {
    fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(self.cmp(o)) }
} impl PartialEq for Boxed<Gpa> {
    fn eq(&self, o: &Self) -> bool { self.cmp(o) == std::cmp::Ordering::Equal }
} impl Eq for Boxed<Gpa> {}

fn main(gpa: Gpa) {
    let p = Plain { v: 1 };
    let b = ByHand { v: 2 };
    let c = Counted { v: 3 };
    let l = Loud { v: 4 };
    let x = Boxed { v: 5, gpa: gpa };
    println("{} {} {} {} {}", p.hash() == p.hash(), b.hash(), c.hash(), l.eq(&l), x.cmp(&x));
}
