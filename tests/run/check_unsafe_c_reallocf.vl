// FLAGS: --check-unsafe
// EXPECT: sum 3198
// 0.30.1: a block from malloc (the check records it) grown by C's
// reallocf, which C frees inside the C library, unseen; C's strdup then
// gets the old block's memory, the same size by C's allocator (the check's
// red zone rounds both up alike), and its copy is read past the old
// block's end. The new owner wrote over the red zone's tag: the record is
// forgotten, not reported. A valid program, run clean.
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn reallocf(p: *mut u8, n: usize) -> *mut u8;
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
}

fn main() {
    // UNSAFE: C's allocator.
    // SAFETY: every read is inside strdup's copy of
    // 61 bytes and its NUL; p is not used after reallocf.
    unsafe {
        let p = malloc(48);
        let q = reallocf(p, 4096);
        let s = strdup(
            c"0123456789012345678901234567890123456789012345678901234567890" as *const u8);
        let mut sum = 0u64;
        for i in 0..61 {
            sum += *s.add(i) as u64;
        }
        println("sum {sum}");
        free(s);
        free(q);
    }
}
