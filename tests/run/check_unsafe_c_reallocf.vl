// FLAGS: --check-unsafe
// EXPECT: sum 3198
// XFAIL(aarch64-linux): glibc has no malloc_logger: C's free inside reallocf is not seen, and strdup's copy is reported as the old block's (docs/releases.md, 0.30.1's known issues)
// XFAIL(x86_64-linux): glibc has no malloc_logger: C's free inside reallocf is not seen, and strdup's copy is reported as the old block's (docs/releases.md, 0.30.1's known issues)
// 0.30.1: a block from malloc (the check records it) grown by C's
// reallocf, which C frees inside the C library; C's strdup then gets the
// old block's memory, and its copy is read past the old block's end. On
// macOS the check sees C's own frees (malloc_logger): the block is
// forgotten when reallocf frees it, and nothing is reported. A valid
// program, run clean. (glibc has no such hook, and the same size there
// keeps the record: a known false report, XFAIL there.)
extern "C" {
    fn malloc(n: usize) -> *mut u8;
    fn reallocf(p: *mut u8, n: usize) -> *mut u8;
    fn strdup(s: *const u8) -> *mut u8;
    fn free(p: *mut u8);
}

fn main() {
    // UNSAFE: C's allocator.
    // SAFETY: every read is inside strdup's copy of
    // 61 bytes and its NUL; p is not used after reallocf.
    unsafe {
        let p = malloc(48);
        let q = reallocf(p, 4096);
        let s = strdup(
            c"0123456789012345678901234567890123456789012345678901234567890" as *const u8);
        let mut sum = 0u64;
        for i in 0..61 {
            sum += *s.add(i) as u64;
        }
        println("sum {sum}");
        free(s);
        free(q);
    }
}
