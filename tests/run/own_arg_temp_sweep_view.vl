fn show(n: str, r: Result<i64, i64>) {
    match r {
        Ok(v) => println(f"{n} ok {v}"),
        Err(e) => println(f"{n} err {e}"),
    }
}

fn main(gpa: Gpa) -> i32 {
    let dev = Dev { gpa: gpa, on: true };
    show("sh_q_w_mf_q", case_sh_q_w_mf_q(dev));
    show("sh_q_w_mf_noq", case_sh_q_w_mf_noq(dev));
