    show("sh_q_w_mf_bin", case_sh_q_w_mf_bin(dev));
    show("sh_q_w_ml_q", case_sh_q_w_ml_q(dev));
    show("sh_q_w_ml_noq", case_sh_q_w_ml_noq(dev));
    show("sh_q_w_ml_ret", case_sh_q_w_ml_ret(dev));
    show("sh_q_w_ml_tail", case_sh_q_w_ml_tail(dev));
    show("sh_q_w_ml_scrq", case_sh_q_w_ml_scrq(dev));
    show("sh_q_w_ml_scr", case_sh_q_w_ml_scr(dev));
    show("sh_q_w_ml_bin", case_sh_q_w_ml_bin(dev));
    show("sh_q_w_ff_q", case_sh_q_w_ff_q(dev));
    show("sh_q_w_ff_noq", case_sh_q_w_ff_noq(dev));
    show("sh_q_w_ff_ret", case_sh_q_w_ff_ret(dev));
    show("sh_q_w_ff_tail", case_sh_q_w_ff_tail(dev));
    show("sh_q_w_ff_scrq", case_sh_q_w_ff_scrq(dev));
    show("sh_q_w_ff_scr", case_sh_q_w_ff_scr(dev));
    show("sh_q_w_ff_bin", case_sh_q_w_ff_bin(dev));
