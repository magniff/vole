// 0.29: a struct or an enum is Copy only when every field is (rustc
// E0204). `#[derive(Clone, Copy)]` on a type that holds a Vec, a String
// or a struct that is moved was accepted, and a copy of the value was a
// second owner of the field's allocation. The error is at the field,
// where the type's fields are known: an instance of a generic type.
// A type of plain fields, raw pointers, shared references, arrays,
// tuples, a fn pointer, a PhantomData and Copy type arguments stays Copy.
// ERROR: the trait `Copy` cannot be implemented for type `S<Gpa>`: its field 'v' of type 'Vec<i64, Gpa>' is not Copy (rustc E0204)
// ERROR: line 21, column 5
// ERROR: take `Copy` out of the derive
// ERROR: the trait `Copy` cannot be implemented for type `E<Gpa>`: field 1 of its variant 'A' of type 'String<Gpa>' is not Copy (rustc E0204)
// ERROR: line 38, column 12
// ERROR: the trait `Copy` cannot be implemented for type `Holds<Gpa>`: its field 'inner' of type 'OnlyClone<Gpa>' is not Copy (rustc E0204)
// ERROR: line 49, column 5
// ERROR-COUNT: 3
use std::alloc::Allocator;
use std::marker::PhantomData;

#[derive(Clone, Copy)]
struct S<A: Allocator> {
    v: Vec<i64, A>,
    n: i64,
}

#[derive(Clone, Copy)]
struct Fine<'a, T> {
    t: T,
    p: *mut u8,
    a: [i64; 3],
    r: &'a str,
    f: fn(i64) -> i64,
    u: (i64, bool),
    m: PhantomData<&'a T>,
}

#[derive(Clone, Copy)]
enum E<A: Allocator> {
    A(i64, String<A>),
    B,
}

#[derive(Clone)]
struct OnlyClone<A: Allocator> {
    v: Vec<i64, A>,
}

#[derive(Clone, Copy)]
struct Holds<A: Allocator> {
    inner: OnlyClone<A>,
}

fn inc(x: i64) -> i64 {
    x + 1
}

fn main(gpa: Gpa) -> i32 {
    let s: S<Gpa> = S { v: Vec::new_in(gpa), n: 1 };
    let f: Fine<i64> =
        Fine { t: 1, p: 0 as *mut u8, a: [1, 2, 3], r: "x", f: inc, u: (1, true), m: PhantomData };
    let g = f;
    let e: E<Gpa> = E::B;
    let h: Holds<Gpa> = Holds { inner: OnlyClone { v: Vec::new_in(gpa) } };
    println("{} {} {}", f.t, g.t, s.n);
    0
}
