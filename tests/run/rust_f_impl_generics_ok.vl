// RULE: F5.5
// (0.30.1) An impl's generic function as its trait declares it: its type
// parameters renamed, bounds the same or weaker (`T: Copy` of the trait,
// none in the impl; a bound the trait's implies through a supertrait),
// an `Fn*` bound with the trait's lifetimes, elided or 'static; called by
// name and through a bound.
// EXPECT: 3 7 5 hi 2
trait Tr {
    fn pick<X: Copy, Y>(&self, a: X, b: Y) -> X;
    fn each<F: FnMut(&str)>(&self, f: F);
    fn keep<F: FnMut(&'static str)>(&self, f: F);
    fn ord<T: Ord>(&self, a: T, b: T) -> bool;
}

struct S { n: i64 }

impl Tr for S {
    fn pick<P, Q>(&self, a: P, b: Q) -> P { a }
    fn each<G: FnMut(&str)>(&self, mut f: G) { f("x") }
    fn keep<F: FnMut(&'static str)>(&self, mut f: F) { f("hi") }
    fn ord<T: PartialOrd>(&self, a: T, b: T) -> bool { a < b }
}

fn go<Z: Tr>(x: &Z) -> i64 { x.pick(7i64, "y") }

fn main() {
    let s = S { n: 3 };
    let mut k = 0i64;
    s.each(|t| k += 5);
    let mut kept: &'static str = "";
    s.keep(|t| kept = t);
    let b = if s.ord(1i64, 2i64) { 2 } else { 0 };
    println("{} {} {} {} {}", s.n, go(&s), k, kept, b);
}
