// XFAIL: RT-208: a method of a trait not in scope is taken by the method probe (wrong code): form z10 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 99
// EXPECT: 3
mod a {
    pub trait L { fn len(self) -> usize; }
    impl L for [i64; 3] { fn len(self) -> usize { 99 } }
}

fn main() { let a = [1i64, 2, 3]; println("{}", a.len()); }
