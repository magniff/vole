// 0.15: derived Debug and Clone of fields whose types are std's
// (Vec, Option, Result, HashMap): their Debug comes from std/fmt.vl,
// their Clone from std/clone.vl.
// EXPECT: R { name: "x", v: [1, 2], o: Some(3), r: Err("bad") }
// EXPECT: R { name: "x", v: [1, 2, 9], o: Some(3), r: Err("bad") } 2
// EXPECT: A([R { name: "x", v: [1, 2], o: None, r: Ok(4) }]) B
// EXPECT: M { m: {1: 2} } 1
use std::hash::FixedState;
use std::fmt::Debug; use std::alloc::Allocator; use std::collections::HashMap;

#[derive(Debug, Clone)]
struct R<'a, A: Allocator> {
    name: &'a str, v: Vec<i64, A>, o: Option<i64>, r: Result<i64, &'a str>,
}

#[derive(Debug)]
enum E<'a, A: Allocator> { A(Vec<R<'a, A>, A>), B }

#[derive(Debug, Clone)]
struct M<A: Allocator> { m: HashMap<i64, i64, A, FixedState> }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let r = R { name: "x", v, o: Some(3i64), r: Err("bad") };
    let mut s = r.clone();
    s.v.push(9);
    println("{r:?}");
    println("{s:?} {}", r.v.len());
    let mut w: Vec<R<'_, Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(R { name: "x", v: r.v.clone(), o: None, r: Ok(4i64) });
    println("{:?} {:?}", E::A(w), E::<Gpa>::B);
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let n = M { m }.clone();
    println("{n:?} {}", n.m.len());
}
