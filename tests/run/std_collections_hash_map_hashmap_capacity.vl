// Runs on std since 0.27.2's switch.
// The std item(s): std::collections::hash_map HashMap::capacity.
// EXPECT: true true
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for i in 0..100i64 {
        m.insert(i, i);
    }
    println("{} {}", m.capacity() >= 100, m.len() == 100);
}
