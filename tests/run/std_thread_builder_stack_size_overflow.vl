// The std item(s): std::thread Builder::spawn_in (0.30.1): a stack size
// that cannot be rounded up to whole pages is InvalidInput, not a thread.
// EXPECT: InvalidInput
use std::thread;

fn main(gpa: Gpa) {
    match thread::Builder::new().stack_size(usize::MAX).spawn_in(move || 1i64, gpa) {
        Ok(_) => println("a thread"),
        Err(e) => println("{:?}", e.kind()),
    }
}
