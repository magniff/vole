// XFAIL: RT-128: std lacks Rust's lossless From impls between char, bool, ints and floats, FromStr for char, and Clone for tuples of 5 or more (0.30.2)
// Each line below is accepted by rustc. vole refuses: `char::from(65u8)`
// ("cannot convert 'u8' into 'char': no impl of 'From<u8>'"),
// `u32::from('x')`, `f64::from(3i32)`, `f32::from(7u8)`, `i64::from(true)`,
// `"x".parse::<char>()` ("the trait 'FromStr' is not implemented for
// 'char'") and `(1i64, 2i64, 3i64, 4i64, 5i64).clone()` (4-tuples clone;
// 5-tuples have == but no clone). The guide's conversions page names only
// integer widening for From. Since 0.30.0 at least.
// EXPECT: A 120 3.0 7.0 1 Ok('x') (1, 2, 3, 4, 5)
fn main() {
    let a = char::from(65u8);
    let b = u32::from('x');
    let c = f64::from(3i32);
    let d = f32::from(7u8);
    let e = i64::from(true);
    let f = "x".parse::<char>();
    let g = (1i64, 2i64, 3i64, 4i64, 5i64).clone();
    println("{} {} {:?} {:?} {} {:?} {:?}", a, b, c, d, e, f, g);
}
