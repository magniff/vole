// EDITION: rust
// RULE: E2.1, E3.1b
// (0.28.0) A `for` over a slice, a Vec's iterator or a range that ends
// is a counted loop, and a slice's iterator does not panic: a sum over
// one is `#[effects()]`, as MVS's was. `for i in 0..s.len()` makes
// `s[i]` in bounds. A #[no_alloc] function forbids alloc and declares
// nothing (E3.1b): its caller with `#[effects()]` sees what it does.
// EXPECT: 5 5 5 6
struct Order {
    qty: i64,
    price: i64,
}

#[effects()]
fn total(orders: &[Order]) -> i64 {
    let mut t: i64 = 0;
    for o in orders {
        t += o.qty * o.price;
    }
    t
}

#[effects()]
fn by_index(orders: &[Order]) -> i64 {
    let mut t: i64 = 0;
    for i in 0..orders.len() {
        t += orders[i].qty * orders[i].price;
    }
    t
}

#[effects()]
fn of_vec(orders: &Vec<Order, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for o in orders.iter() {
        t += o.qty * o.price;
    }
    t
}

#[effects()]
fn up_to(n: i64) -> i64 {
    let mut t: i64 = 0;
    for i in 0..n {
        t += i;
    }
    t
}

#[no_alloc]
fn twice(x: i64) -> i64 {
    x * 2
}

#[effects()]
fn through(x: i64) -> i64 {
    twice(x)
}

fn main(gpa: Gpa) {
    let v = [Order { qty: 1, price: 2 }, Order { qty: 3, price: 1 }];
    let mut w: Vec<Order, Gpa> = Vec::new_in(gpa);
    w.push(Order { qty: 1, price: 2 });
    w.push(Order { qty: 3, price: 1 });
    println("{} {} {} {}", total(&v), by_index(&v), of_vec(&w), up_to(4) + through(0));
}
