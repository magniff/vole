struct N {
    v: i64,
}

fn eat(n: N) -> i64 {
    n.v
}

fn main() {
    let o = Some(N { v: 1 });
    match o {
        Some(n) => println("{}", eat(n)),
        None => {}
    }
    let p = o;
    match p {
        Some(n) => println("{}", n.v),
        None => {}
    }
}
