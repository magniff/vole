// (0.25.2, feedbacks/galaga.md #5) Bytes where a str goes: the try:
// `str::from_utf8(b)?` only where it type-checks (the function returns a
// Result whose error takes a Utf8Error); elsewhere the help says why not.
// ERROR: 'b' is '[u8]' where 'str' goes
// ERROR: not with '?' here: the function does not return a Result
fn take(s: str) -> i64 {
    s.len()
}

fn bad(b: [u8]) -> i64 {
    take(b)
}

fn main() -> i32 {
    bad("abc".as_bytes()) as i32
}
