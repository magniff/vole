// EDITION: rust
// RULE: F20.6, F20.4
// (0.27.5) A `&mut self` method on an index place makes the place
// mutable once the method is found, as rustc's autoref does: each index
// on its path is IndexMut's (a Vec's `as_mut_slice`), through fields and
// nested indexes, through a `&mut Vec`, in a closure. A user type's
// IndexMut is called and its Index is not: `index` would print.
// EXPECT: 0 1 8 2
// EXPECT: 3 9 2
use std::alloc::Allocator;
use std::ops::{Index, IndexMut};

struct P<A: Allocator> {
    x: Vec<i64, A>,
}

struct Grid<A: Allocator> {
    rows: Vec<Vec<i64, A>, A>,
}

impl<A: Allocator> Index<usize> for Grid<A> {
    type Output = Vec<i64, A>;

    fn index(&self, i: usize) -> &Vec<i64, A> {
        println("index {}", i);
        &self.rows[i]
    }
}

impl<A: Allocator> IndexMut<usize> for Grid<A> {
    fn index_mut(&mut self, i: usize) -> &mut Vec<i64, A> {
        &mut self.rows[i]
    }
}

fn bump(r: &mut Vec<Vec<i64, Gpa>, Gpa>) {
    r[0].push(2);
}

fn main(gpa: Gpa) {
    let mut vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    vs.push(a);
    vs[0].clear();
    vs[0].shrink_to_fit();
    let mut ps: Vec<P<Gpa>, Gpa> = Vec::new_in(gpa);
    ps.push(P { x: Vec::new_in(gpa) });
    ps[0].x.push(3);
    let mut m: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    m.push(Vec::new_in(gpa));
    m[0].push(7);
    for x in m[0].iter_mut() {
        *x += 1;
    }
    bump(&mut m);
    println("{} {} {} {}", vs[0].len(), ps[0].x.len(), m[0][0], m[0][1]);
    let mut g = Grid { rows: Vec::new_in(gpa) };
    g.rows.push(Vec::new_in(gpa));
    let mut gs: Vec<Grid<Gpa>, Gpa> = Vec::new_in(gpa);
    gs.push(g);
    gs[0][0].push(9);
    let mut add = |k: i64| gs[0][0].push(k);
    add(4);
    add(5);
    println("{} {} {}", gs[0].rows[0].len(), gs[0].rows[0][0], gs.len() + 1);
}
