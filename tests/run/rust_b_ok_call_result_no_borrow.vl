// EDITION: rust
// RULE: D3.6
// (0.27.1) A plain result borrows nothing: the argument is written after.

struct S {
    x: i64,
    y: i64,
}

fn sum(s: &S) -> i64 {
    s.x + s.y
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let n = sum(&s);
    s.x = n;
    println("{}", s.x);
}
// EXPECT: 3
