// RULE: D2.7, D19.2
// (0.30.1, RT-33 round 2, F3) A `&mut self` method of a captured shared
// reference, in a closure: `s.bump()` of an `s: &S`, `r.push(i)` of an `r:
// &Vec`, `v[..].reverse()` of a `v: &Vec`: rustc's E0596 at each. Before,
// the closure copied the reference to a temporary, which was not asked:
// `r.push` reallocated under a live `&r[0]` (a use after free).
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable, which is behind a `&` reference
// ERROR: line 25, column 20
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*r' as mutable, which is behind a `&` reference
// ERROR: line 30, column 20
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*v' as mutable, which is behind a `&` reference
// ERROR: line 35, column 20
// ERROR-COUNT: 3
struct S {
    x: i64,
}

impl S {
    fn bump(&mut self) {
        self.x += 1;
    }
}

fn k(s: &S) {
    let mut f = || s.bump();
    f();
}

fn k2(r: &Vec<i64, Gpa>) {
    let mut f = || r.push(1);
    f();
}

fn k3(v: &Vec<i64, Gpa>) {
    let mut f = || v[..].reverse();
    f();
}

fn main(gpa: Gpa) {
    let s = S { x: 1 };
    k(&s);
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    k2(&v);
    k3(&v);
}
