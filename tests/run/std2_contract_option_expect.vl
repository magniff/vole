// EDITION: rust
// (0.28.0, gap 79) Option::expect on a None: the caller's place, then the
// message (no `requires failed`).
// EXPECT: 1
// EXIT: 101
// STDERR: std2_contract_option_expect.vl:12:13: b

fn main() {
    let a: Option<i64> = Option::Some(1);
    let b: Option<i64> = Option::None;
    println("{}", a.expect("a"));
    let x = b.expect("b");
}
