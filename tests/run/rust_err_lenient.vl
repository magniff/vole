// (0.27.0) type.ref-value: what 0.27.0's rust edition accepted and Rust
// rejects, 0.19's meanings kept: a `&T` of a plain value read where the
// value goes, a place lent where `&T` goes. (0.27.1) R5 closed: each is
// error type.ref-value (rustc E0308), its try: Rust's spelling, given
// to a rust-edition function or a `let`'s written type.
// RULE: R5
// ERROR: error[type.ref-value]: 'r' is a reference where its value goes
// ERROR: try: *r
// ERROR: error[type.ref-value]: 'n' is a value where a reference goes
// ERROR: try: &n
// ERROR: error[type.ref-value]: '&n' is a reference where its value goes
// ERROR: try: n
// ERROR-COUNT: 3

fn takes(x: &i64) -> i64 {
    *x + 1
}

fn plain(x: i64) -> i64 {
    x
}

fn main() -> i32 {
    let n = 5;
    let r = &n;
    let b: i64 = r;
    let c = takes(n);
    let d = plain(&n);
    println("{} {} {}", b, c, d);
    0
}
