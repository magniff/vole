// XFAIL: RT-278: a static's or a constant's value that names a constant of a non-scalar type is "not a compile-time constant" (0.30.2)
// rustc evaluates each at compile time: an array constant repeating a
// struct constant (`[C; 3]`), a static repeating and naming an Option
// constant (`[E; 2]`, `E`), and an array of an array constant (`[A; 2]`).
// vole refuses each of the four values with "expression is not a
// compile-time constant"; a scalar constant works in all of them. RT-124
// is the same message for an associated constant, RT-256 for an index,
// RT-108 for a field. From g302copy's review forms c09 and c19; v0.30.1
// the same.
// EXPECT: 1 2 true 3
struct D {
    k: i64,
}

const C: D = D { k: 1 };
const E: Option<D> = None;
const A: [D; 3] = [C; 3];
const B: [[D; 3]; 2] = [A; 2];
static S: [Option<D>; 2] = [E; 2];
static T: Option<D> = E;

fn main() {
    println("{} {} {} {}", A[2].k, S.len(), T.is_none(), B[1][2].k + 2);
}
