// EDITION: rust
// RULE: F18.5
// (0.27.7) An integer type's own method called on a literal tree, whose
// type nothing gives, is error type.infer, rustc's E0689: `(1 << s)
// .wrapping_sub(1)` is no longer i32's method (1 << 40 was 1 << 8).
// ERROR: error[type.infer]: cannot call method 'wrapping_sub' on an integer literal whose type nothing gives
fn main() {
    let s: i64 = 40;
    let r: i64 = (1 << s).wrapping_sub(1);
    println("{}", r);
}
