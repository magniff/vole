// EDITION: rust
// RULE: D8.2
// (0.27.1) A move and a reassignment in each iteration: initialized at the
// back edge.

struct N {
    v: i64,
}

fn main() {
    let mut n = N { v: 0 };
    let mut i = 0;
    while i < 3 {
        let m = n;
        n = N { v: m.v + 1 };
        i += 1;
    }
    println("{}", n.v);
}
// EXPECT: 3
// (0.27.2) written against MVS std until it migrates to std2:
