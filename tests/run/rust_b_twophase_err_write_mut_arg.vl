// RULE: D7.4
// (0.27.2.1) A reservation admits reads only: an argument that borrows
// the writer mutably while `write(f, ..)`'s reborrow is reserved conflicts
// with it (rustc E0499 for `write!(f, "{}", bump(f))`).
// RUSTC: none `write(` is std2's spelling of `write!(`
// ERROR: error[borrowck.mut_twice]
use std::fmt::{Display, Formatter};

struct Spec;

fn bump(f: &mut Formatter<'_>) -> i64 {
    let _ = f.write_str("");
    1
}

impl Display for Spec {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "{}", bump(f))
    }
}

fn main() {
    println("{}", Spec);
}
