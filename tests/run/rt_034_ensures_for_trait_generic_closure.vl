// RT-34: the forms an `ensures` reaches through a copy: a trait's clause
// copied onto an impl's method (whose body goes to its `$body`), a
// generic function's instance, a `move` closure inside a #[multiversion]
// function with an `ensures` (its body cloned into each version). Each
// moved-out value is dropped once; rustc prints the EXPECT lines.
// FLAGS: -C target-cpu=generic --check-alloc
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: 3
// EXPECT: drop 3
// EXPECT: drop 4
// EXPECT: 2
// EXPECT: drop 4
// EXPECT: drop 5
// EXPECT: 9
use std::alloc::Allocator;

struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

trait Sum {
    fn total(self) -> i64
        ensures result >= 0;
}

struct Bag<A: Allocator> {
    items: Vec<D, A>,
}

impl Sum for Bag<Gpa> {
    fn total(self) -> i64 {
        let mut s = 0;
        for d in self.items {
            s += d.v;
        }
        s
    }
}

fn gen<T>(v: Vec<T, Gpa>) -> usize
    ensures result == 2
{
    let mut n: usize = 0;
    for _x in v {
        n += 1;
    }
    n
}

#[multiversion("crc")]
fn closure_in(v: Vec<D, Gpa>) -> i64
    ensures result == 9
{
    let f = move || {
        let mut s = 0;
        for d in v {
            s += d.v;
        }
        s
    };
    f()
}

fn main(gpa: Gpa) {
    let b = Bag { items: Vec::from_in([D { v: 1 }, D { v: 2 }], gpa) };
    println("{}", b.total());
    println("{}", gen(Vec::from_in([D { v: 3 }, D { v: 4 }], gpa)));
    println("{}", closure_in(Vec::from_in([D { v: 4 }, D { v: 5 }], gpa)));
}
