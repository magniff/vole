// EDITION: rust
// XFAIL: gap 16: the rust edition accepts the translation: rc 0; MVS effect
// Dropping a struct drops its fields.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(&mut self) { println("dropped"); } }
struct Outer { inner: Noisy, k: i64 }

#[no_io]
fn quiet(o: Outer) -> i64 { o.k }

fn main() -> i32 {
    println("{}", quiet(Outer { inner: Noisy { n: 1 }, k: 2 }));
    0
}
