// XFAIL: RT-C301-8: `<S as B>::mk` as a fn value is A's mk: a miscompile, the wrong function runs (0.30.2)
// From the review: <S as B>::mk as fn value (no receiver)
// rustc prints 2 1.
// EXPECT: 2 1
trait A { fn mk() -> i64; }
trait B { fn mk() -> i64; }
struct S;
impl A for S { fn mk() -> i64 { 1 } }
impl B for S { fn mk() -> i64 { 2 } }
fn main() { let f = <S as B>::mk; let g = <S as A>::mk; println("{} {}", f(), g()); }
