// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io Result.
// EXPECT: Ok(3) Err(Kind(NotFound))
use std::io::{ErrorKind, self};

fn find(x: i64) -> io::Result<i64> {
    if x > 0 { Ok(x) } else { Err(io::Error::from(ErrorKind::NotFound)) }
}

fn main() {
    println("{:?} {:?}", find(3), find(0));
}
