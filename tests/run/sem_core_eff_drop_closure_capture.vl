// A sink closure owns what it captures and drops it.
// ERROR: 'quiet' is #[no_io], but it does io
struct Noisy { n: i64 }
impl Drop for Noisy { fn drop(&mut self) { println("dropped"); } }

#[no_io]
fn quiet(x: Noisy) -> i64 {
    let f = move || x.n;
    f()
}

fn main() -> i32 {
    println("{}", quiet(Noisy { n: 4 }));
    0
}
