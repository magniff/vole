// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::leak.
// EXPECT: [1, 20]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1, 2], gpa);
    let s: &mut [i64] = v.leak();
    s[1] = 20;
    println("{:?}", s);
}
