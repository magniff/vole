// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::vec Vec::leak.
// EXPECT: [1, 20]
// STDERR: check-alloc: 1 block of Gpa not freed (16 bytes):
// STDERR:   block #1 (16 bytes), allocated at std2_vec_vec_leak.vl:11:13
// (leak gives the block up for the program's whole run: --check-alloc lists it)
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let s: &mut [i64] = v.leak();
    s[1] = 20;
    println("{:?}", s);
}
