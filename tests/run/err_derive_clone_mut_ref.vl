// (0.28.0) `#[derive(Clone)]` on a type that holds a `&mut T`: a `&mut`
// has no Clone, so neither has the struct (the enum). The error is at
// the field and says so; it was the type error of the derived impl's
// call, with a `try:` made of the field's text.
// ERROR: cannot derive Clone for 'Cursor': field 'buf' holds a `&mut` reference, which has no Clone
// ERROR: help: a `&mut T` is the only access to its value, so a copy of it would be a second one: remove Clone from #[derive] and move the value or lend it (`&x`); or hold a shared `&T`, which is Copy; or write `impl Clone` yourself, making what the `&mut` points to anew
// ERROR: cannot derive Clone for 'Slot': variant 'Full' holds a `&mut` reference, which has no Clone
// ERROR-COUNT: 2
#[derive(Clone)]
struct Cursor<'a> {
    buf: &'a mut i64,
    pos: usize,
}

#[derive(Clone)]
enum Slot<'a> {
    Empty,
    Full(&'a mut i64),
}

#[derive(Clone)]
struct View<'a> {
    buf: &'a i64,
}

fn main() {
    let mut n: i64 = 1;
    let mut m: i64 = 2;
    let c = Cursor { buf: &mut n, pos: 0 };
    let s = Slot::Full(&mut m);
    let e: Slot = Slot::Empty;
    let v = View { buf: &3 };
    let w = v.clone();
    *c.buf += 1;
    if let Slot::Full(p) = s {
        *p += 1;
    }
    if let Slot::Empty = e {
        println("{} {}", c.pos, w.buf);
    }
}
