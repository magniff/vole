// XFAIL: gap 2: compile type error: no associated function 'to_fd' in 'Formatter'
// EXPECT: Circle(1) Circle(3) Rect(1, 9) Rect(2, 0) Empty
// EXPECT: Red < Blue true; Low < High true
// EXPECT: eq true false true false
// EXPECT: hash 3
// EXPECT: Tagged(Rect(1, 2), "s") Rect(1, 2)
// EXPECT: clone 2 1
// EXPECT: Many
// 0.15: #[derive] on enums: Ord compares the variants in declaration order,
// then their fields (a written discriminant does not change the order:
// `Low = 9` goes before `High = 2`, where Rust orders by discriminant);
// Eq compares the fields with == (a `[u8]` by bytes); Hash mixes in the
// variant first; Debug writes `V(a, b)`; Clone clones the fields.
use std::hash::Hash; use std::fmt::Debug; use std::io::Empty; use std::alloc::Allocator;
use std::fmt::Formatter as Fmt; use std::collections::HashMap;

#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy)]
enum Shape { Circle(i64), Rect(i64, i64), Empty }

#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy)]
enum Color { Red, Green, Blue }

#[derive(PartialOrd, Ord, PartialEq, Eq, Debug, Clone, Copy)]
enum Level { Low = 9, High = 2 }

#[derive(Debug, Clone, PartialEq, Eq, Copy)]
enum Wrap<'a> { Tagged(Shape, &'a str), Plain }

#[derive(Clone)]
enum Holder<A: Allocator> { Many(Vec<i64, A>), One(i64) }

fn many_len(h: &Holder<Gpa>) -> i64 {
    match h {
        Holder::Many(zs) => zs.len() as i64,
        Holder::One(_) => -1,
    }
}

fn show<T: std::fmt::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1i32);
    write(f, "{:?}", x)?;
}

fn main(gpa: Gpa) {
    let mut v: Vec<Shape, Gpa> = Vec::new_in(gpa);
    v.push(Shape::Empty);
    v.push(Shape::Rect(2i64, 0i64));
    v.push(Shape::Circle(3i64));
    v.push(Shape::Rect(1i64, 9i64));
    v.push(Shape::Circle(1i64));
    v.sort_unstable();
    for i in 0..v.len() {
        if i > 0 {
            print(" ");
        }
        show(&v.as_slice()[i]);
    }
    println("");

    let lt = Color::Red < Color::Blue;
    let low = Level::Low;
    let high = Level::High;
    print("{}", if lt { "Red < Blue true; " } else { "Red < Blue false; " });
    println("{}", if low < high { "Low < High true" } else { "Low < High false" });

    let a = Shape::Rect(1i64, 2i64);
    let b = Shape::Rect(1i64, 2i64);
    let c = Shape::Rect(1i64, 3i64);
    let e = Shape::Empty;
    print("eq ");
    print("{}", if a == b { "true " } else { "false " });
    print("{}", if a == c { "true " } else { "false " });
    print("{}", if e == Shape::Empty { "true " } else { "false " });
    println("{}", if Color::Red == Color::Green { "true" } else { "false" });

    let mut m: HashMap<Shape, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(a, 1);
    m.insert(c, 2);
    m.insert(b, 3);
    m.insert(Shape::Circle(2i64), 4);
    print("hash ");
    print("{}", (m.get(&(Shape::Rect(1i64, 2i64))).copied().unwrap() + m.len() as i64 - 3));
    println("");

    let w = Wrap::Tagged(a, "s");
    show(&w);
    print(" ");
    if let Wrap::Tagged(s, _) = w.clone() {
        show(&s);
    }
    println("");

    let mut xs: Vec<i64, Gpa> = Vec::new_in(gpa);
    xs.push(1);
    let h = Holder::Many(xs);
    let h2 = h.clone();
    if let Holder::Many(mut ys) = h2 {
        ys.push(2);
        print("clone ");
        print("{}", (ys.len() as i64));
        print(" ");
        print("{}", many_len(&h));
        println("");
    }
    if let Holder::Many(_) = h {
        println("Many");
    }
}
