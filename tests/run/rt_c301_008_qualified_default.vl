// RULE: F8.4, F12.1
// RT-C301-8: the traits' default functions and constants, not overridden:
// `<S as B>::K`, `<S as B>::m` are B's defaults. 0.30.1 printed
// `20 20` and `10 10 11 11`. rustc prints these lines.
// EXPECT: 10 20
// EXPECT: 10 20 11 21
// EXPECT: 10 20 11 21
// default methods and constants of the traits, not overridden
trait A { const K: i64 = 10; fn m(&self) -> i64 { 10 } fn mk() -> i64 { 11 } }
trait B { const K: i64 = 20; fn m(&self) -> i64 { 20 } fn mk() -> i64 { 21 } }
struct S;
impl A for S {}
impl B for S {}

fn main() {
    let s = S;
    let fa = <S as A>::m; let fb = <S as B>::m;
    let ga = <S as A>::mk; let gb = <S as B>::mk;
    println("{} {}", <S as A>::K, <S as B>::K);
    println("{} {} {} {}", fa(&s), fb(&s), ga(), gb());
    println("{} {} {} {}", <S as A>::m(&s), <S as B>::m(&s), <S as A>::mk(), <S as B>::mk());
}
