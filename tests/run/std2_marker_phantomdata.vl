// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::marker PhantomData.
// EXPECT: 3 0
use std::marker::PhantomData;

struct Meters<T> {
    v: i64,
    unit: PhantomData<T>,
}

fn main() {
    let m: Meters<bool> = Meters { v: 3, unit: PhantomData };
    println("{} {}", m.v, std::mem::size_of::<PhantomData<i64>>());
}
