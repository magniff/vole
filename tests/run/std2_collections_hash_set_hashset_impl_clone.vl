// The std2 item(s): std::collections::hash_set HashSet::impl Clone.
// EXPECT: 1 2
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa, FixedState> = HashSet::new_in(gpa);
    s.insert(1);
    let c = s.clone();
    s.insert(2);
    println("{} {}", c.len(), s.len());
}
