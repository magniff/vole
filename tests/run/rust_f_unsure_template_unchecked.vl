// (0.30.1, review 3) A template whose generic check is unsure and that
// has no instance is checked nowhere: a warning, generic.unchecked, not a
// silent yes (rustc refuses this one, E0310: U is not 'static).
// WARNING: generic.unchecked
use std::ops::RangeBounds;

fn need<T: 'static>(t: T) {}

fn go<R: RangeBounds<i64>, U>(r: &R, u: U) -> bool {
    need(u);
    r.contains(&1)
}

fn main() {}
