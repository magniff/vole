// XFAIL: gap 25: the IR, asm or places CHECK lines no longer match the translation (std's names, the surface): to update by...
// `for x in v` over a Vec, a pointer to one and `v.iter()` (0.14), and
// over a range value, stay counted loops: no `next` call, and the
// vectorizer takes them as it takes the loop over `v.as_slice()`. (Each
// is called twice, so that it is not inlined into main.)
// EXPECT: 39600 39600 39600 39600 4950
// CHECK: fn sum_vec:
// CHECK-NOT: next
// CHECK: vbin.add
// CHECK: fn sum_ref:
// CHECK-NOT: next
// CHECK: vbin.add
// CHECK: fn sum_iter:
// CHECK-NOT: next
// CHECK: vbin.add
// CHECK: fn main:
fn sum_vec(v: &Vec<i64, Gpa>) -> i64 {
    let mut s: i64 = 0;
    for x in v {
        s += x;
    }
    s
}

fn sum_ref(v: &Vec<i64, Gpa>) -> i64 {
    let mut s: i64 = 0;
    for x in v {
        s += x;
    }
    s
}

fn sum_iter(v: &Vec<i64, Gpa>) -> i64 {
    let mut s: i64 = 0;
    for x in v.iter().copied() {
        s += x;
    }
    s
}

fn sum_range(r: std::ops::Range<i64>) -> i64 {
    let mut s: i64 = 0;
    for x in r {
        s += x;
    }
    s
}

fn main(argc: i32, argv: *mut *mut u8, gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..argc as i64 * 100 {
        v.push(i * 8);
    }
    let a = sum_vec(&v) * 2 - sum_vec(&v);
    let b = sum_ref(&v) * 2 - sum_ref(&v);
    let c = sum_iter(&v) * 2 - sum_iter(&v);
    let mut d: i64 = 0;
    for &x in v.as_slice() {
        d += x;
    }
    print("{}", a);
    print(" ");
    print("{}", b);
    print(" ");
    print("{}", c);
    print(" ");
    print("{}", d);
    print(" ");
    print("{}", (sum_range(0i64..argc as i64 * 100) * 2 - sum_range(0i64..argc as i64 * 100)));
    println("");
    0
}
