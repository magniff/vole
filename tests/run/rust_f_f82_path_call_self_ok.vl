// RULE: F8.2
// (0.30.1) `Tr::m(x)` takes Self from x's type against the receiver's
// written type, with no autoderef: `Tr::g(&d)` of a `g(self)` is the impl
// for &D, which reads d; d is not moved, so the later use and the Vec's
// element are fine (rustc accepts this program; 0.30.0 moved d).
// EXPECT: 101
// EXPECT: after: 1
// EXPECT: 102
// EXPECT: end
// EXPECT: drop 2
// EXPECT: drop 1
trait Tr {
    fn g(self) -> i64;
}

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl Tr for D {
    fn g(self) -> i64 {
        self.n
    }
}

impl<'a> Tr for &'a D {
    fn g(self) -> i64 {
        self.n + 100
    }
}

fn main(gpa: Gpa) {
    let d = D { n: 1 };
    println("{}", Tr::g(&d));
    println("after: {}", d.n);
    let mut v: Vec<D, Gpa> = Vec::new_in(gpa);
    v.push(D { n: 2 });
    println("{}", Tr::g(&v[0]));
    println("end");
}
