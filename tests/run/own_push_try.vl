// A call's `?` argument (0.18.1): `v.push(p.item()?)` is not a conflict.
// The `?`'s early return drops `v`, but the return skips the call; the
// drops and scope ends inside an argument never change what an earlier
// argument (the two-phase receiver) borrows.
// EXPECT: 4 [1, 2, 3, 4]
// EXPECT: none
// EXPECT: 2
#[derive(Clone, Copy)] struct P { pos: i64, end: i64 }

impl P {
    fn item(&mut self) -> Option<i64> {
        if self.pos == self.end { return None; }
        self.pos += 1;
        Some(self.pos)
    }
}

fn next(p: &mut P) -> Result<i64, &str> {
    match p.item() { Some(x) => Ok(x), None => Err("end") }
}

fn items(p: &mut P, gpa: Gpa) -> Option<Vec<i64, Gpa>> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(p.item()?);
    v.push(next(p).ok()?);
    let o = Some(3i64);
    v.push(o?);
    v.push(match p.item() { Some(x) => x + 1, None => return None });
    Some(v)
}

fn all(p: &mut P, gpa: Gpa) -> Result<i64, &str> {
    let mut n: i64 = 0;
    loop {
        let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
        v.push(next(p)?);
        n += v.len() as i64;
    }
    Ok(n)
}

fn main(gpa: Gpa) -> i32 {
    let mut p = P { pos: 0, end: 3 };
    let v = items(&mut p, gpa).unwrap();
    println("{} {v:?}", v.len());
    let mut q = P { pos: 0, end: 1 };
    match items(&mut q, gpa) { Some(_) => println("some"), None => println("none") }
    let mut r = P { pos: 0, end: 2 };
    match all(&mut r, gpa) { Ok(n) => println("{}", n), Err(_) => println("{}", r.pos) }
    0
}
