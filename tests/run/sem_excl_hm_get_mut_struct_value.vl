// XFAIL: gap 17: compile unsafe: indexing a pointer is unsafe pointer arithmetic; the value 'v' points to is `*v`
// EXPECT: 5
use std::collections::HashMap; #[derive(Clone, Copy)] struct P { x: i64, y: i64 }

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, P, Gpa> = HashMap::new_in(gpa); m.insert(1, P { x: 1, y: 2 });
    match m.get_mut(&1) { Some(v) => { v[0].x = 5; } None => {} } println("{}",
        m.get(&1).copied().unwrap().x);
}
