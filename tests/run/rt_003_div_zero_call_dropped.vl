// RT-3 (fixed in 0.30.1): -O2 deletes a call whose division by zero panics: the effects count no division as a panic
// FLAGS: -O2
// div's `a / b` panics when b is 0, at every level. The effect inference
// (front::effects::infer) gives div no `panic`, so ipo::effects_attrs marks
// it nopanic (and readnone, willreturn): at -O2 the call whose result is
// unused is dead code, and the two equal calls of rem are one, so the
// program prints `after` / `same`, `end` and exits 0 instead of panicking.
// -O0 is right.
// STDERR: attempt to divide by zero
// EXIT: 101
#[inline(never)]
fn div(a: i64, b: i64) -> i64 {
    a / b
}

fn main() {
    // no arguments: n is 0
    let n = std::env::args().count() as i64 - 1;
    // the result is unused: the division by zero must still panic
    let _q = div(7, n);
    println("after");
}
