// RULE: F26.3
// A `&mut self` method of str called on a String's index borrows it
// through IndexMut, as rustc's mutable autoref does; so does `&mut s[..]`.
// EXPECT: aBC aBX
fn main(gpa: Gpa) {
    let mut s = String::from_in("abc", gpa);
    s[1usize..].make_ascii_uppercase();
    print("{} ", s);
    let t: &mut str = &mut s[2usize..];
    t.make_ascii_lowercase();
    s.pop();
    s.push('X');
    println("{}", s);
}
