// Runs on std since 0.27.2's switch.
// The std item(s): std::hash ()::impl Hash.
// EXPECT: 0
// EXPECT: 14695981039346656037
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

impl Default for Fnv {
    fn default() -> Fnv {
        Fnv { h: 0xcbf29ce484222325 }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

fn main() {
    let mut h = Show { n: 0 };
    ().hash(&mut h);
    println("{}", h.finish());
    let mut f = fnv();
    ().hash(&mut f);
    println("{}", f.finish());
}
