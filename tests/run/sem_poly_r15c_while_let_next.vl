// the same items through while let: dropped at the end of each iteration
// FLAGS: --check-alloc
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: got 0
// EXPECT: drop 0
// EXPECT: end
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }
#[derive(Clone, Copy)] struct Gen { n: i64 }

impl Iterator for Gen {
    type Item = R;

    fn next(&mut self) -> Option<R> {
        if self.n == 0 { return None; }
        self.n -= 1;
        Some(R { id: self.n })
    }
}

fn main() {
    let mut g = Gen { n: 2 };
    while let Some(r) = g.next() { println("got {}", r.id); }
    println("end");
}
