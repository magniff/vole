// EDITION: rust
// RULE: D7.3
// (0.27.1) Activated loans end at their calls: one call after another.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn get(&self) -> i64 {
        self.x
    }

    fn add(&mut self, k: i64) {
        self.x += k;
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add(1);
    s.add(s.get());
    s.add(s.y);
    println("{}", s.x);
}
// EXPECT: 6
