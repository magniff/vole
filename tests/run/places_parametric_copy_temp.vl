// EDITION: rust
// XFAIL: gap 25: the IR, asm or places CHECK lines no longer match the translation (std2's names, the surface): to update by...
// places IR (0.26.1, R8): a generic call whose result is a copy of what
// its arguments keep (`second<T>(p: *T) -> T { p[1] }`, own's
// parametric_copy) gives a temporary the caller does not own: no drop,
// as the own pass's (not fresh). The Vec read is still vs's, dropped
// once with it; a block's value, `unsafe { second_cast(..) }`, too.
// FLAGS: --check-alloc
// EXPECT: 3 3
// PLACES: fn main
// PLACES: call second<Vec<i64, Gpa>>
// PLACES-NOT: drop(
// PLACES: call second_cast<Vec<i64, Gpa>>
// PLACES-NOT: drop(
// PLACES: call std::fmt::__print_end
fn second<T>(p: *mut T) -> T {
    // UNSAFE: the test reads an element through a raw pointer.
    // SAFETY: p points to the first of two elements of vs.
    unsafe { (*p.add(1)) }
}

fn second_cast<T>(x: *mut u8) -> T {
    // UNSAFE: the test reads an element through a cast raw pointer.
    // SAFETY: x points to the first of two elements of type T.
    unsafe { (*(x as *mut T).add(1)) }
}

fn main(gpa: Gpa) {
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut b: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    b.push(2);
    b.push(4);
    b.push(6);
    let mut vs = [a, b];
    // UNSAFE: the test passes vs's first element as bytes.
    // SAFETY: vs holds two Vec<i64>, read as such.
    println("{} {}", second(&mut vs[0]).len(),
        unsafe { second_cast::<Vec<i64, Gpa>>(&raw const vs[0] as *mut u8) }.len());
}
