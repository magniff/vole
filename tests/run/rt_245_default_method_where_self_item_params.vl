// XFAIL: RT-245: a default method whose `where Self: Iterator<Item = (X, Y)>` names the method's own type parameters, under a blanket impl, is refused with "unknown type 'X'" (0.30.2)
// rustc accepts it: X and Y are the method's parameters, in scope in its where clause.
// EXPECT: 4 [1, 3] [2, 4]
trait Split {
    fn split2<X: Copy, Y: Copy>(self, gpa: Gpa) -> (Vec<X, Gpa>, Vec<Y, Gpa>)
        where
            Self: Sized + Iterator<Item = (X, Y)>,
    {
        let mut a: Vec<X, Gpa> = Vec::new_in(gpa);
        let mut b: Vec<Y, Gpa> = Vec::new_in(gpa);
        for (x, y) in self {
            a.push(x);
            b.push(y);
        }
        (a, b)
    }
}

impl<I: Iterator> Split for I {}

fn main(gpa: Gpa) {
    let mut v: Vec<(i64, i64), Gpa> = Vec::new_in(gpa);
    v.push((1, 2));
    v.push((3, 4));
    let (a, b) = v.iter().copied().split2(gpa);
    println("{} {:?} {:?}", a.len() + b.len(), a, b);
}
