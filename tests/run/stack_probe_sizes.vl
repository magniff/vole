// (0.30.2, RT-83) Which frames are probed: every page of a frame that can
// reach 4096 bytes below sp or more (its realignment counted) is written,
// top down, before sp is below it (gen0's a64_frame_reserve and
// x64_frame_reserve), and no smaller frame gets a probe. The step is 4 KiB
// on every target, the smallest page any has (Apple's arm64 pages are 16
// KiB: a frame of 4 to 16 KiB is probed there too, for safety over a few
// instructions). fN holds an N-byte array, so its frame at -O2 is N
// rounded up to 16: f4095's and f16383's are one byte under a page before
// rounding, a page after; f4097's and f16385's one byte over. fal's frame
// is realigned to 4096 (a 32-byte local aligned to 4096): sp moves by up
// to its size + 4080, so it is probed. main's 20000-byte frame is probed
// on every target: the main thread's prologue is no different. v0.30.1
// probed nothing: `sub sp, sp, x16`, `subq $N, %rsp`.
// EXPECT: 61
// CROSS: aarch64-linux x86_64-linux
// ASM(aarch64-macos): vole.f4080:
// ASM-NOT(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f4095:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f4096:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f4097:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f16368:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f16383:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f16384:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.f16385:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): vole.fal:
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-macos): main:
// ASM(aarch64-macos): sub sp, sp, #4096
// ASM(aarch64-macos): str xzr, [sp]
// ASM(aarch64-linux): vole.f4080:
// ASM-NOT(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f4095:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f4096:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f4097:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f16368:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f16383:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f16384:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.f16385:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): vole.fal:
// ASM(aarch64-linux): str xzr, [sp]
// ASM(aarch64-linux): main:
// ASM(aarch64-linux): sub sp, sp, #4096
// ASM(aarch64-linux): str xzr, [sp]
// ASM(x86_64-linux): vole.f4080:
// ASM-NOT(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f4095:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f4096:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f4097:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f16368:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f16383:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f16384:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.f16385:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): vole.fal:
// ASM(x86_64-linux): movq $0, (%rsp)
// ASM(x86_64-linux): main:
// ASM(x86_64-linux): subq $4096, %rsp
// ASM(x86_64-linux): movq $0, (%rsp)

#[inline(never)]
fn keep(a: &[u8]) -> i64 {
    a[0] as i64 + a[a.len() - 1] as i64
}

#[inline(never)]
fn f4080(x: u8) -> i64 {
    let a = [x; 4080];
    keep(&a)
}

#[inline(never)]
fn f4095(x: u8) -> i64 {
    let a = [x; 4095];
    keep(&a)
}

#[inline(never)]
fn f4096(x: u8) -> i64 {
    let a = [x; 4096];
    keep(&a)
}

#[inline(never)]
fn f4097(x: u8) -> i64 {
    let a = [x; 4097];
    keep(&a)
}

#[inline(never)]
fn f16368(x: u8) -> i64 {
    let a = [x; 16368];
    keep(&a)
}

#[inline(never)]
fn f16383(x: u8) -> i64 {
    let a = [x; 16383];
    keep(&a)
}

#[inline(never)]
fn f16384(x: u8) -> i64 {
    let a = [x; 16384];
    keep(&a)
}

#[inline(never)]
fn f16385(x: u8) -> i64 {
    let a = [x; 16385];
    keep(&a)
}

#[repr(C, align(4096))]
struct Page {
    v: [u8; 32],
}

#[inline(never)]
fn fal(x: u8) -> i64 {
    let p = Page { v: [x; 32] };
    keep(&p.v) + (&p as *const Page as usize % 4096) as i64
}

fn main() {
    let n = std::env::args().count() as u8;
    let big = [n; 20000];
    let s = f4080(n) + f4095(n) + f4096(n) + f4097(n) + f16368(n) + f16383(n) + f16384(n)
        + f16385(n) + fal(n);
    println("{}", s * 3 + keep(&big) + 5);
}
