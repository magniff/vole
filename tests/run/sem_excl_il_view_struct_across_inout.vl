// EDITION: rust
// a struct holding a view, alive across an inout of what it views
// ERROR: error[borrowck.conflict]
// ERROR: line 9, column 97
#[derive(Clone, Copy)] struct W<'a> { s: &'a [i64] }
fn grow(v: &mut Vec<i64, Gpa>) { for i in 0..100 { v.push(i); } }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); let w = W { s: v.as_slice() }; grow(&mut v);
    println("{}", w.s[0]);
}
