// EDITION: rust
// RULE: D7.4
// (0.27.2.1) `write(f, ..)`'s writer is a two-phase reborrow, as Rust's
// `write!(f, ..)` receiver: the arguments read f before it is activated,
// and f is used again after the call.
// RUSTC: none `write(` is std2's spelling of `write!(`
// EXPECT: None|.
use std::fmt::{Display, Formatter};

struct Spec;

impl Display for Spec {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "{:?}|", f.width())?;
        write(f, ".")
    }
}

fn main() {
    println("{}", Spec);
}
