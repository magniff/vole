// EDITION: rust
// RULE: D2.4a, D7.1
// (0.27.5) An operand read through a view or a reference is copied out
// where it is evaluated, so the view is dead before what follows: the
// slice view of `pcx.nodes` before `pcx`'s reborrow is activated, the
// right side's view before the place's `index_mut`, a two-phase push's
// argument before its receiver is activated (`v.push(v[0])`,
// `v.push(v.len())`), a field or a local read before a later `&mut` of
// it.
// EXPECT: 5 7 12 3 [1, 2, 3, 1, 4] 1 4
use std::alloc::Allocator;

#[derive(Clone, Copy)]
struct Node {
    a: i64,
    b: i64,
}

struct Ctx<A: Allocator> {
    nodes: Vec<Node, A>,
    regs: Vec<i64, A>,
    n: i64,
}

struct S {
    x: i64,
    n: i64,
}

fn err_begin(at: i64, pcx: &mut Ctx<Gpa>) {
    pcx.n += at;
}

fn walk(p: usize, pcx: &mut Ctx<Gpa>) {
    err_begin(pcx.nodes[p].a, pcx);
}

fn copy_a(p: usize, q: usize, pcx: &mut Ctx<Gpa>) {
    pcx.nodes[p].b = pcx.nodes[q].a;
}

fn edge(a: i64, b: i64, bck: &mut Ctx<Gpa>) {
    bck.n += a * 10 + b;
}

fn add_x(a: i64, s: &mut S) {
    s.n += a;
}

fn twice(a: i64, y: &mut i64) {
    *y += a;
}

fn main(gpa: Gpa) {
    let mut c = Ctx { nodes: Vec::new_in(gpa), regs: Vec::new_in(gpa), n: 0 };
    c.nodes.push(Node { a: 5, b: 0 });
    c.nodes.push(Node { a: 7, b: 0 });
    walk(0, &mut c);
    copy_a(0, 1, &mut c);
    let walked = c.n;
    c.n = 0;
    c.regs.push(1);
    c.regs.push(2);
    let bck = &mut c;
    bck.regs.push(bck.regs[0] + bck.regs.len() as i64);
    edge(bck.regs[0], bck.regs[1], bck);
    let mut v = Vec::new_in(gpa);
    v.push(1i64);
    v.push(2);
    v.push(3);
    v.push(v[0]);
    v.push(v.len() as i64);
    let mut s = S { x: 1, n: 0 };
    add_x(s.x, &mut s);
    let mut y = 2;
    twice(y, &mut y);
    println("{} {} {} {} {:?} {} {}", walked, c.nodes[0].b, c.n, c.regs[2], v, s.n, y);
}
