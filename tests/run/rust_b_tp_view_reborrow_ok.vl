// RULE: D3.6, D7.4
// (0.30.1) A mutable view given to a call, or bound by a `requires`
// check, is reborrowed two-phase, as rustc's implicit `&mut *s`: a later
// argument may read the view (`s.split_at_mut(s.len() / 2)`, `s.swap(0,
// s.len() - 1)`, `g(s, s[1] as usize)`, a `&mut str`'s `t.len()`). The
// review of the hidden bindings found these refused after the view's
// binding became a reborrow that was not two-phase.
// EXPECT: 4
// EXPECT: [3, 2, 1]
// EXPECT: 3 3 3 3
// EXPECT: 3 3
// EXPECT: 2
fn g(s: &mut [i64], k: usize) -> i64
    requires k < 100
{
    s[0] + k as i64
}

fn h(s: &mut [i64], k: usize) -> i64 {
    s[0] + k as i64
}

fn gs(s: &mut str, k: usize) -> usize
    requires k < 100
{
    s.len() + k - 3
}

fn halves(s: &mut [i64]) -> i64 {
    let (a, b) = s.split_at_mut(s.len() / 2);
    a[0] + b[0]
}

fn rev(s: &mut [i64]) {
    s.swap(0, s.len() - 1);
}

fn chunks(s: &mut [i64]) -> usize {
    let mut n = 0;
    for c in s.chunks_mut(s.len() / 2) {
        c[0] += 1;
        n += 1;
    }
    n
}

fn middle(s: &mut [i64]) -> i64 {
    let (_, m, _) = s.select_nth_unstable(s.len() / 2);
    *m
}

fn main(gpa: Gpa) {
    let mut a = [1i64, 2, 3, 4];
    println("{}", halves(&mut a));
    let mut b = [1i64, 2, 3];
    rev(&mut b);
    println("{:?}", b);
    let s: &mut [i64] = &mut a;
    let r = g(s, s.len() - 1);
    let q = h(s, s.len() - 1);
    let r2 = g(s, s[1] as usize + 1);
    let mut st = String::from_in("abc", gpa);
    let t: &mut str = st.as_mut_str();
    let r3 = gs(t, t.len());
    println("{} {} {} {}", r - 1, q - 1, r2 - 1, r3);
    let mut c = [5i64, 1, 3];
    println("{} {}", middle(&mut c), chunks(&mut b));
    println("{}", b[0] - b[2]);
}
