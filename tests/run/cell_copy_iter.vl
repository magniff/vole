// (0.26.1) A borrowing iterator's items, a Vec's and a slice's elements:
// each is the element's place, so a store through it is kept.
// EXPECT: 9
// EXPECT: 8
// EXPECT: 6
use std::sync::atomic::{AtomicI64, Ordering};

fn main(gpa: Gpa) {
    var v: Vec<AtomicI64> = Vec::new_in(gpa);
    v.push(AtomicI64::new(1));
    v.push(AtomicI64::new(1));
    for e in v.iter() {
        e.store(9, Ordering::SeqCst);
    }
    println(f"{v[0].load(Ordering::SeqCst)}");
    for e in v {
        e.store(8, Ordering::SeqCst);
    }
    println(f"{v[1].load(Ordering::SeqCst)}");
    let s: [AtomicI64] = v.as_slice();
    for e in s {
        e.store(6, Ordering::SeqCst);
    }
    println(f"{v[1].load(Ordering::SeqCst)}");
}
