// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a50_ensures_mut_field_cast)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'get' calls 'poke', which writes through a raw pointer what it did not make
// An ensures of a method on &self whose struct holds a &mut: cast to *mut for a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

struct H<'a> { r: &'a mut i64 }

impl<'a> H<'a> {
    fn get(&self) -> i64
        ensures poke(self.r as *const i64 as *mut i64)
    {
        *self.r
    }
}

fn main() {
    let mut x = 1i64;
    let h = H { r: &mut x };
    println("{}", h.get());
    println("{}", *h.r);
}
