// XFAIL: RT-93: `trait A: B<<Self as A>::X>` does not parse ("expected '{', got '<<'"); rustc prints x (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: x
trait B<T> {}

trait A: B<<Self as A>::X> {
    type X;
}

struct S;

impl B<i64> for S {}

impl A for S {
    type X = i64;
}

fn main() {
    println("x");
}
