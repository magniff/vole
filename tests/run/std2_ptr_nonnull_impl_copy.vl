// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ptr NonNull::impl Copy.
// EXPECT: 2
use std::ptr::NonNull;

fn main() {
    let mut x = 1i64;
    let p = NonNull::new(&mut x as *mut i64).unwrap();
    let q = p;
    unsafe { *q.as_ptr() += 1 };
    println("{}", unsafe { *p.as_ptr() });
}
