// The std2 item(s): std::io IntoInnerError::into_inner.
// EXPECT: [1]
use std::io::{BufWriter, ErrorKind, Write, self};

struct Full;

impl Write for Full {
    fn write(&mut self, _buf: &[u8]) -> io::Result<usize> {
        Ok(0)
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

fn main() {
    let mut b = BufWriter::new(Full);
    b.write_all(&[1]).unwrap();
    let w: BufWriter<Full> = b.into_inner().err().unwrap().into_inner();
    println("{:?}", w.buffer());
    std::mem::forget(w);
}
