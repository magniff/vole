// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::convert TryFrom::try_from.
// EXPECT: true false
use std::convert::{Infallible, TryFrom};

struct Small {
    v: i64,
}

impl TryFrom<i64> for Small {
    type Error = ();

    fn try_from(v: i64) -> Result<Small, ()> {
        if v < 10 { Ok(Small { v: v }) } else { Err(()) }
    }
}

fn main() {
    let a: Result<Small, ()> = TryFrom::try_from(3i64);
    let b = Small::try_from(30);
    println("{} {}", a.is_ok(), b.is_ok());
}
