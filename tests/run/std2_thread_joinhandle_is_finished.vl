// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread JoinHandle::is_finished.
// EXPECT: true 8
use std::thread;
use std::mem::swap;

fn main(gpa: Gpa) {
    let h = thread::spawn_in(move || 8i64, gpa);
    while !h.is_finished() {
        thread::yield_now();
    }
    println("{} {}", h.is_finished(), h.join().unwrap());
}
