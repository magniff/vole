// The std2 item(s): std::fs File (Read and Write for &File).
// (0.27.5) A shared File reads and writes: `impl Write for &File`, whose
// body reaches the fd through `&mut &File` (it did not check before, and
// its unchecked body made every formatted panic's effects unknown).
// EXPECT: 2 "hi"
use std::fs::File;
use std::io::{Read, Write};

fn main() {
    let f = File::create("std2_fs_file_ref.txt").unwrap();
    let mut w = &f;
    let n = w.write(b"hi").unwrap();
    drop(f);
    let g = File::open("std2_fs_file_ref.txt").unwrap();
    let mut r = &g;
    let mut buf = [0u8; 8];
    let k = r.read(&mut buf).unwrap();
    println("{} {:?}", n, std::str::from_utf8(&buf[0..k]).unwrap());
    std::fs::remove_file("std2_fs_file_ref.txt").unwrap();
}
