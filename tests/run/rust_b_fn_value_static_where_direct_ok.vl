// RULE: D4.7, R6
// (0.30.2) RT-484's and RT-485's functions called by their names: kh
// (a `'static` its parameter needs through a projection of another
// bound) crashed the compiler (bus error) in v0.30.1, and kf (`where
// &'static i64: From<T>`) was refused in its body, borrowck.outlives;
// both build, and a closure calling them on a 'static reference builds
// too, as rustc builds each. Used as a value (`.map(kf::<&'static i64>)`)
// each is refused, as `fn ks(x: &'static i64)` is since v0.30.1 (D4.7:
// rust_b_err_fn_value_static_where_uaf, RT-484, RT-485).
// FLAGS: --check-alloc
// EXPECT: Some(1000) Some(1000) Some(1000) Some(1000)
trait Has {
    type Out;
}

impl<'a> Has for &'a i64 {
    type Out = &'a i64;
}

fn kf<T>(x: T) -> &'static i64
    where
        & 'static i64: From<T>,
{
    From::from(x)
}

fn kh<T: Has>(x: T) -> &'static i64
    where
        T::Out: Into<&'static i64>,
        T: Into<T::Out>,
{
    let o: T::Out = x.into();
    o.into()
}

static K: i64 = 1000;

fn main() {
    let a = Some(kf::<&'static i64>(&K));
    let b = Some(kh::<&'static i64>(&K));
    let c = Some(&K).map(|x| kf::<&'static i64>(x));
    let d = Some(&K).map(|x| kh::<&'static i64>(x));
    println("{:?} {:?} {:?} {:?}", a, b, c, d);
}
