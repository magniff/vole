// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.views: pinned views() for a function returning an element view of l
// ERROR: error[own.views]
#[views()]
fn first(l: Vec<str, Gpa>) -> str { l.get(0) }

fn main(gpa: Gpa) -> i32 {
    var v: Vec<str, Gpa> = Vec::new_in(gpa); v.push("x"); println(first(v)); 0
}
