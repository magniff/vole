// RULE: F8.4
// RT-C301-8: qualified paths inside closures. 0.30.1 printed `12 2`.
// rustc prints 21 2.
// EXPECT: 21 2
// qualified paths inside closures
trait A { const K: i64; fn m(&self) -> i64; }
trait B { const K: i64; fn m(&self) -> i64; }
struct S;
impl A for S { const K: i64 = 1; fn m(&self) -> i64 { 1 } }
impl B for S { const K: i64 = 2; fn m(&self) -> i64 { 2 } }

fn main() {
    let s = S;
    let c = |x: &S| { let f = <S as B>::m; f(x) * 10 + <S as A>::K };
    let d = || <S as B>::K;
    println("{} {}", c(&s), d());
}
