// sem-own: an array of owned values moved whole, into a sink fn: dropped
// there, once.
// EXPECT: got 2
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(a: sink [D<Gpa>; 2]) { println("got {}", a.len()); }

fn main(gpa: Gpa) {
    let a = [mk(1, gpa), mk(2, gpa)];
    eat(a);
    println("end");
}
