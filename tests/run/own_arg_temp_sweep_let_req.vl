        Ok(v) => Ok(v),
        Err(e) => Err(e),
    }
}

fn case_str_local_wl_m_ret(dev: Dev) -> Result<i64, i64> {
    let k = 1;
    let loc = dev.mks(7);
    return Ok(dev.cs_let_r(loc, dev.num(-2)?)?);
}

fn case_str_local_wl_m_tail(dev: Dev) -> Result<i64, i64> {
    let k = 1;
    let loc = dev.mks(7);
    dev.cs_let_r(loc, dev.num(-2)?)
}

fn case_str_local_wl_m_scrq(dev: Dev) -> Result<i64, i64> {
    let k = 1;
    let loc = dev.mks(7);
    match dev.cs_let_r(loc, dev.num(-2)?)? {
        v => Ok(v),
    }
}

fn case_str_local_wl_m_scr(dev: Dev) -> Result<i64, i64> {
    let k = 1;
    let loc = dev.mks(7);
    match dev.cs_let_r(loc, dev.num(-2)?) {
        Ok(v) => Ok(v),
        Err(e) => Err(-100 + e),
    }
}

fn case_str_local_wl_m_bin(dev: Dev) -> Result<i64, i64> {
    let k = 1;
    let loc = dev.mks(7);
    Ok(dev.cs_let_r(loc, dev.num(-2)?)? + 0)
}

fn show(n: str, r: Result<i64, i64>) {
    match r {
        Ok(v) => println(f"{n} ok {v}"),
        Err(e) => println(f"{n} err {e}"),
    }
}

