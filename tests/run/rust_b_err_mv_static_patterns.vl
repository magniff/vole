// RULE: M3
// (0.30.1) A pattern's binder of a static's part that is not Copy moves
// out of the static (rustc E0507): `let (a, b)`, `let W { d, k }`, its
// let-else, a match's binder, `if let`, and `SD;`. The builder copies the
// part into a borrowed binder: before, each call took the one static value
// and dropped it (a double free with an owning type).
// ERROR: error[borrowck.move_out]
// ERROR: line 46, column 18
// ERROR: error[borrowck.move_out]
// ERROR: line 52, column 22
// ERROR: error[borrowck.move_out]
// ERROR: line 58, column 23
// ERROR: error[borrowck.move_out]
// ERROR: line 65, column 11
// ERROR: error[borrowck.move_out]
// ERROR: line 71, column 11
// ERROR: error[borrowck.move_out]
// ERROR: line 77, column 26
// ERROR: error[borrowck.move_out]
// ERROR: line 83, column 5
// ERROR-COUNT: 7
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

struct W {
    d: D,
    k: i64,
}

static SW: W = W { d: D { v: 4 }, k: 5 };
static ST: (D, i64) = (D { v: 6 }, 7);
static SD: D = D { v: 8 };

fn take(d: D) {
    println("took {}", d.v);
}

fn tuple() {
    let (a, b) = ST;
    take(a);
    println("{}", b);
}

fn strukt() {
    let W { d, k } = SW;
    take(d);
    println("{}", k);
}

fn let_else() {
    let W { d, .. } = SW else {
        return;
    };
    take(d);
}

fn match_tuple() {
    match ST {
        (x, _) => take(x),
    }
}

fn match_whole() {
    match SD {
        x => take(x),
    }
}

fn if_let() {
    if let W { d, .. } = SW {
        take(d);
    }
}

fn read_stmt() {
    SD;
}

fn main() {
    tuple();
    strukt();
    let_else();
    match_tuple();
    match_whole();
    if_let();
    read_stmt();
}
