// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a44_mut_slice_param)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'requires' of 'f' calls 'poke', which writes through a raw pointer what it did not make
// A &mut [i64] parameter: the clause passes as_mut_ptr to a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(s: &mut [i64]) -> i64
    requires poke(s.as_mut_ptr())
{
    1
}

fn main() {
    let mut a = [1i64, 2];
    println("{}", f(&mut a[..]));
    println("{}", a[0]);
}
