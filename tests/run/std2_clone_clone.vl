// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::clone Clone.
// EXPECT: 1 2 1
use std::clone::Clone;
use std::marker::Copy;

struct P {
    x: i64,
}

impl Clone for P {
    fn clone(&self) -> P {
        P { x: self.x }
    }
}

fn main() {
    let a = P { x: 1 };
    let mut b = a.clone();
    b.x = 2;
    let c = a.clone();
    println("{} {} {}", a.x, b.x, c.x);
}
