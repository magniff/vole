// Runs on std since 0.27.2's switch.
// The std item(s): std::fmt Formatter::write_char.
// EXPECT: <x>
// RUSTC: none (std's Formatter::write_char is inherent; Rust's comes from fmt::Write)
use std::fmt::{Display, Formatter};

struct S;

impl Display for S {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.write_char('<')?;
        f.write_char('x')?;
        f.write_char('>')
    }
}

fn main() {
    println("{}", S);
}
