// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_assign_inout_param.vl to Rust's spelling.
// sem-own: assigning through an inout parameter drops the caller's old value.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

fn set(r: &mut D<Gpa>, gpa: Gpa) {
    *r = mk(2, gpa);
}

fn main(gpa: Gpa) {
    let mut a = mk(1, gpa);
    set(&mut a, gpa);
    println("end");
}
