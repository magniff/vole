// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter impl Step for primitives.
// EXPECT: [250, 251] [-2, -1] 3

fn main(gpa: Gpa) {
    let a: Vec<u8, Gpa> = (250u8..252).collect_in(gpa);
    let b: Vec<i32, Gpa> = (-2i32..0).collect_in(gpa);
    println("{:?} {:?} {}", a, b, (0usize..3).count());
}
