// XFAIL: RT-447: #[derive(PartialEq)] on an enum whose tuple variant holds a reference, `enum E<'a> { A(&'a u64), B }`, is refused inside the derive: "no impl of 'u64::eq' takes arguments (&&u64)"; rustc prints true false (0.30.2)
// From the g302static work (its pre/pre01). Since v0.30.1 at least (the
// same error). A struct with a reference field, braced or tuple, derives
// right; the braced variant form is rt_447b.
// EXPECT: true false
#[derive(PartialEq)]
enum E<'a> {
    A(&'a u64),
    B,
}

fn main() {
    let k = 3u64;
    let j = 4u64;
    println("{} {}", E::A(&k) == E::A(&k), E::A(&k) == E::A(&j));
}
