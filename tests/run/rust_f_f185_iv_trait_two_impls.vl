// RULE: F18.5
// (0.30.2) A trait's method called on an integer variable's value where
// several integer types implement the trait: Self is the variable and the
// impl is that of the type a later use gives it, as rustc's (`e.show()`
// then `take(e)` calls i64's); so for a generic function's `impl Show`
// result made with one (`id(e)`). 0.30.1 called i32's.
// EXPECT: 107
// EXPECT: 103
trait Show {
    fn show(&self) -> u32;
}

impl Show for i32 {
    fn show(&self) -> u32 {
        *self as u32
    }
}

impl Show for i64 {
    fn show(&self) -> u32 {
        *self as u32 + 100
    }
}

fn take(x: i64) -> i64 {
    x
}

fn id<T: Show>(t: T) -> impl Show {
    t
}

fn main() {
    let e = 7;
    println("{}", e.show());
    take(e);
    let a = 3;
    let b = id(a);
    take(a);
    println("{}", b.show());
}
