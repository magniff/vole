// ERROR: is ambiguous
// (review of M2, C3) the same, the impls telling them apart: E0221, not "not implemented".
trait Tr<U> { fn g(&self) -> i64; }
trait H2 { type Out; }
trait H3 { type Out; }
struct W { r: i64 }
impl H2 for W { type Out = i64; }
impl H3 for W { type Out = i32; }
impl Tr<i32> for W { fn g(&self) -> i64 { 32 } }
fn mid<T: H2 + H3 + Tr<T::Out>>(t: &T) -> i64 { t.g() }
fn main() { println("{}", mid(&W { r: 0 })); }
