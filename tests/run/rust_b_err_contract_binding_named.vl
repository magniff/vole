// RULE: D7.4, D2.7
// (0.30.1, RT-33) A call with a `requires` binds its receiver `?a0`; a
// refused `&mut` of it names the argument, `*v`, as without the contract
// (and as rustc's E0596), not the binding `*?a0`.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*v' as mutable, which is behind a `&` reference
// ERROR: line 9, column 5
// ERROR-COUNT: 1
fn k(v: &Vec<i64, Gpa>) {
    v.insert(0, 1);
}

fn main(gpa: Gpa) {
    let v: Vec<i64, Gpa> = Vec::new_in(gpa);
    k(&v);
}
