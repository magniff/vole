// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::impl Drop.
// EXPECT: drop 1
// EXPECT: done
use std::collections::HashMap;
use std::ops::Drop;

struct Noisy {
    id: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn main(gpa: Gpa) {
    {
        let mut m: HashMap<i64, Noisy, Gpa> = HashMap::new_in(gpa);
        m.insert(1, Noisy { id: 1 });
    }
    println("done");
}
