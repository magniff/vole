// RULE: C4
// RUSTC: none contract clauses are not Rust
// (0.30.2, the re-review 3 of g302holes) C given a `*const *mut u8` may
// write through the `*mut u8` it reads: only a `*const T` to what holds
// no `*mut` is read only (infer.vl holds_mut), so this argument is still
// written (provenance.vl raw_args_mask), and the clause refused.
// ERROR: writes through a raw pointer what it did not make
extern "C" {
    // UNSAFE: test, never called
    // SAFETY: test
    fn strtol(s: *const u8, end: *const *mut u8, base: i32) -> i64;
}

fn go(e: *const *mut u8) -> bool {
    // UNSAFE: test
    // SAFETY: never run: the clause is refused
    unsafe { strtol(c"1", e, 10) == 1 }
}

fn f(e: *const *mut u8) -> i64
    requires go(e)
{
    1
}

fn main() {
    let mut b = 0u8;
    let mut p = &raw mut b;
    println("{}", f(&raw const p));
}
