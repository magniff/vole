// (0.30.2, from RT-138's fix) A generic constant naming itself at a bigger
// type each time is no cycle the mark sees (each W<..> is another
// instance): the nesting limit refuses it, at once (rustc: "queries
// overflow the depth limit"). tests/redteam/rt_138b times it.
// ERROR: type arguments nested too deeply
struct W<T> {
    x: T,
}

impl<T> W<T> {
    const P: usize = W::<W<T>>::P + 1;
}

fn main() {
    println("{}", W::<i32>::P);
}
