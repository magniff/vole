// EDITION: rust
// RULE: D20.3
// (0.27.2) A closure checked against a bound that names a projection,
// `F: FnMut(B, Self::Item) -> B` with `Self::Item = &'a str`: the
// projection's positions are the closure's external regions, tied to
// the slots the instance resolves it to, so `|_, x| Some(x)` returns x.
trait It {
    type Item;
    fn next(&mut self) -> Option<Self::Item>;

    fn fold2<B, F: FnMut(B, Self::Item) -> B>(mut self, init: B, mut f: F) -> B
        where
            Self: Sized,
    {
        let mut acc = init;
        while let Some(x) = self.next() {
            acc = f(acc, x);
        }
        acc
    }

    fn last2(self) -> Option<Self::Item>
        where
            Self: Sized,
    {
        self.fold2(None, |_, x| Some(x))
    }
}

struct Words<'a> {
    s: &'a str,
    done: bool,
}

impl<'a> It for Words<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.done {
            None
        } else {
            self.done = true;
            Some(self.s)
        }
    }
}

fn main() {
    let w = Words { s: "hi", done: false };
    match w.last2() {
        Some(s) => println("{}", s.len()),
        None => println("none"),
    }
}
// EXPECT: 2
