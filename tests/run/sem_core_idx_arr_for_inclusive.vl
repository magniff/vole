// EDITION: rust
// for i in 0..=3 over an array of 3 indexes a[3].
// EXIT: 101
// STDERR: index out of bounds: index 3, length 3
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    let mut t: i64 = 0;
    for i in 0..=3 { t += a[i as usize]; }
    println("{}", t);
    println("not reached");
    0
}
