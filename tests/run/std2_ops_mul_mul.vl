// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops Mul::mul.
// EXPECT: V { x: 60 } 60
use std::ops::Mul;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl Mul for V {
    type Output = V;

    fn mul(self, rhs: V) -> V {
        V { x: self.x * rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.mul(b), Mul::mul(12i64, 5));
}
