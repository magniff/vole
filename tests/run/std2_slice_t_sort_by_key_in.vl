// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::sort_by_key_in.
// EXPECT: [(1, 2), (1, 4), (2, 1), (2, 3)]
use std::slice::SliceIndex;

fn main(gpa: Gpa) {
    let mut a = [(2, 1), (1, 2), (2, 3), (1, 4)];
    a.sort_by_key_in(|p| p.0, gpa);
    println("{:?}", a);
}
