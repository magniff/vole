// EDITION: rust
// XFAIL: gap 3: compile closure.sig: type mismatch in closure arguments: this parameter is written 'Vec<i64, Gpa>', but the...
// ok: a generic function's closure result that views nothing it is given
// EXPECT: 1 static 2
fn apply<T, R, F: Fn(&T) -> R>(x: &T, f: F) -> R { f(x) }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let n = apply(&v, |d: Vec<i64, Gpa>| d.len());
    let w: &str = apply(&v, |d: Vec<i64, Gpa>| "static");
    v.push(2);
    println("{n} {w} {}", v.len());
}
