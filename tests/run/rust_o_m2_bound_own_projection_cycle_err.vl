// (RT-272) `T: H<T::Out>`, the bound that declares Out naming T::Out, a cycle (rustc E0391; the depth limit's overflow here): an error, never a crash (v0.30.1: bus error).
trait H<U> {
    type Out;
}

struct W {
    r: i64,
}

impl H<i64> for W {
    type Out = i64;
