// RULE: D7.4
// (0.30.1) A contract call's shared view parameter binds a shared
// reborrow: given with another view, or with the same one before its
// exclusive use starts, it is accepted as rustc accepts it. `s.len()` and
// `s[0]` read the view a `&mut [T]` parameter is given (two-phase).
// EXPECT: 3
// EXPECT: 5 6
// EXPECT: 4
fn f(a: &mut [i64], b: &[i64]) -> i64
    requires a.len() == b.len()
{
    a[0] = b[0] + b[1];
    a[0]
}

fn g(a: &mut [i64], n: usize) -> i64
    requires n <= a.len()
{
    a[0] = n as i64 * 2;
    a[0]
}

fn main() {
    let mut x = [0i64, 0];
    let y = [1i64, 2];
    let s: &mut [i64] = &mut x;
    println("{}", f(s, &y));
    let mut z = [9i64, 9];
    let t: &mut [i64] = &mut z;
    t.copy_from_slice(&[5i64, 6]);
    println("{} {}", t[0], t[1]);
    println("{}", g(s, s.len()));
}
