// RULE: D2.7
// (0.30.1, RT-33) `&mut b[..]` of a shared view is a `&mut` of what the
// view refers to, behind its `&`: rustc's E0596. Before, it was accepted
// and the write went into the string literal (SIGBUS) or made the str
// invalid UTF-8.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*b' as mutable, which is behind a `&` reference
// ERROR: line 13, column 18
// ERROR-COUNT: 1
fn main() {
    let s: &str = "ab\u{e9}";
    let b: &[u8] = s.as_bytes();
    // the write the borrow would allow
    let m = &mut b[..];
    m[3] = 0xc3;
    println("{}", s.chars().count());
}
