// EDITION: rust
// 0.17: a tuple's element through a raw pointer (a local holding one) is
// unsafe, as a struct's field through one is.
// ERROR: access to a field through a raw pointer is unsafe
// ERROR-COUNT: 1
fn main() -> i32 {
    let mut t = (1, 2);
    let p: *mut (i64, i64) = &mut t;
    p.0 as i32 - 1
}
