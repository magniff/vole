// EDITION: rust
// XFAIL: use.unused: a `use m::{self}` import is reported unused though the file names `m::item` (front272)
// The std2 item(s): std::io copy.
// EXPECT: 3 [1, 2, 3]
use std::io::{ErrorKind, self};

fn main(gpa: Gpa) {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    let n = io::copy(&mut r, &mut v).unwrap();
    println("{} {:?}", n, v);
}
