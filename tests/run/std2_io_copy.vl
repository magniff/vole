// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::io copy.
// EXPECT: 3 [1, 2, 3]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let data: &[u8] = &[1, 2, 3];
    let mut r = data;
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    let n = io::copy(&mut r, &mut v).unwrap();
    println("{} {:?}", n, v);
}
