// EDITION: rust
// ok: closures over captures, through std's iterators
// EXPECT: 10 ccc 3 0
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..5 { v.push(i); }
    let mut total: i64 = 0;
    v.iter().copied().for_each(|x| total += x);
    let words: &str = "a bb ccc";
    let mut longest: &str = "";
    for w in words.split_ascii_whitespace() { if w.len() > longest.len() { longest = w; } }
    let lens = (0i64..3i64).map(|i| v[i as usize] * 2).collect_in::<Vec<i64, Gpa>, _>(gpa);
    let s = v.as_slice();
    let first = (0i64..1i64).map(|i| s[i as usize]).collect_in::<Vec<i64, Gpa>, _>(gpa);
    println("{total} {longest} {} {}", lens.len(), first[0]);
}
