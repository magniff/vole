// (0.25) A captured Vec or Buf given as an `inout [T]` (`bump(&v)`) inside
// a closure writes the captured container (it segfaulted: the coercion
// replaced the name the closure rewrites).
// EXPECT: 5 5 7
// EXPECT: 15 98
// EXPECT: 18
fn bump(s: &mut [i64]) { s[0] += 5; }
fn up(s: &mut [u8]) { s[0] = s[0] + 1; }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(0);
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    b.extend_from_slice(b"a");
    let mut a = [2i64, 0];
    {
        let mut f = || bump(&mut v);
        f();
    }
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(0);
    {
        let mut g = || bump(&mut u[..]);
        g();
    }
    {
        let mut h = || bump(&mut a);
        h();
    }
    {
        let mut k = || up(&mut b);
        k();
    }
    println("{} {} {}", v[0], u[0], a[0]);
    {
        let mut f = || { bump(&mut v); bump(&mut v); };
        f();
    }
    println("{} {}", v[0], b[0]);
    let mut mut_sink = move || { bump(&mut v); bump(&mut v[..]); v[0] - 7 };
    println("{}", mut_sink());
}
