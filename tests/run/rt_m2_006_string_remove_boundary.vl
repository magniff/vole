// String::remove(2) of "aé€" (2 is inside 'é') decodes a char from the
// continuation byte on (U+0262) and removes two bytes, leaving
// [97, 195, 130, 172], which is not UTF-8. Rust panics: byte index 2 is
// not a char boundary.
// EXPECT: start
// STDERR: not a char boundary
// EXIT: 101
fn main(gpa: Gpa) {
    let i = std::env::args().count() + 1;
    let mut t = String::from_in("aé€", gpa);
    println("start");
    let c = t.remove(i);
    println("{} {:?}", c as u32, t.as_bytes());
}
