// XFAIL: gap 17: compile item.private: 'unicode' is private
// std's per-code-point Unicode data (0.20, compiler/std/unicode/) against
// Rust's, for every scalar value: char_width and char_width_cjk against
// unicode-width 0.2.2's `width` and `width_cjk`, the class predicates
// against Rust std's char methods, to_lower and to_upper against
// char::to_lowercase and to_uppercase (tests/std/unicode/reference-rust.txt,
// printed by the oracle in tests/std/oracle/unicode/). Rust is at Unicode
// 17.0: the code points new in 18.0 (tests/std/unicode/new-in-18.txt) are
// left out, and the few whose data 18.0 changed are the differences
// expected below: four lowercase letters whose uppercase letters are new in
// 18.0 (U+A7DD, U+A7E2, U+AB6C, U+AB6D).
// ARGS: @ROOT@/tests/std/unicode/reference-rust.txt @ROOT@/tests/std/unicode/new-in-18.txt
import "stdio.h" as c;

use std::unicode::char_width; use std::unicode::char_width_cjk;

fn read_all(path: *mut u8, gpa: Gpa) -> Vec<u8, Gpa> {
    let mut text = Vec::<u8, Gpa>::new_in(gpa);
    let f = unsafe { c::fopen(path, c"rb") };
    if f == 0 as *mut c::FILE {
        return text;
    }
    let mut chunk = [0u8; 65536];
    loop {
        let n = unsafe { c::fread(&mut chunk[0], 1u64, 65536u64, f) } as i64;
        if n <= 0 {
            break;
        }
        text.extend_from_slice(&chunk[0..n as usize]);
    }
    unsafe { c::fclose(f); }
    text
}

// The words of a line, as numbers: hex, or a decimal with a sign.
fn numbers(line: &[u8], out: &mut Vec<i64, Gpa>) {
    out.clear();
    let mut k: i64 = 0;
    while k < line.len() as i64 {
        while k < line.len() as i64 && line[k as usize] == b' ' {
            k += 1;
        }
        let mut e = k;
        while e < line.len() as i64 && line[e as usize] != b' ' {
            e += 1;
        }
        if e > k {
            let w = &line[k as usize..e as usize];
            let mut v: i64 = 0;
            let neg = w[0] == b'-';
            for i in (if neg { 1 } else { 0 })..w.len() as i64 {
                let b = w[i as usize];
                let d = if b >= b'0' && b <= b'9' { (b - b'0') as i64 }
                    else if b >= b'A' && b <= b'F' { (b - b'A') as i64 + 10 }
                    else { (b - b'a') as i64 + 10 };
                v = v * 16 + d;
            }
            out.push(if neg { -v } else { v });
        }
        k = e;
    }
}

fn each_line<F: FnMut(&[u8])>(t: &[u8], mut f: &F) {
    let mut g = f;
    let mut from: i64 = 0;
    for i in 0..t.len() + 1 {
        if i == t.len() || t[i] == b'\n' {
            let line = &t[from as usize..i];
            from = i as i64 + 1;
            if line.len() > 0 && line[0] != b'#' {
                g(line);
            }
        }
    }
}

fn flags(cp: u32) -> i64 {
    let mut v: i64 = 0;
    if char::from_u32(cp).map_or(false, |c| c.is_alphabetic()) { v |= 1; }
    if char::from_u32(cp).map_or(false, |c| c.is_numeric()) { v |= 2; }
    if char::from_u32(cp).map_or(false, |c| c.is_whitespace()) { v |= 4; }
    if char::from_u32(cp).map_or(false, |c| c.is_lowercase()) { v |= 8; }
    if char::from_u32(cp).map_or(false, |c| c.is_uppercase()) { v |= 16; }
    if char::from_u32(cp).map_or(false, |c| c.is_control()) { v |= 32; }
    v
}

fn main(argc: i32, argv: *mut *mut u8, gpa: Gpa) -> i32 {
    if argc < 3 {
        return 2;
    }
    let reference = unsafe { read_all((*argv.add(1)), gpa) };
    let new18 = unsafe { read_all((*argv.add(2)), gpa) };
    let n: i64 = 0x110000;
    let mut skip: Vec<bool, Gpa> = Vec::from_elem_in(false, (n as usize), gpa);
    let mut nums: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut new_count: i64 = 0;
    each_line(new18.as_slice(), |line| {
        numbers(line, &mut nums);
        for cp in nums[0]..nums[1] + 1 {
            skip[cp as usize] = true;
            new_count += 1;
        }
    });
    for cp in 0xd800..0xe000 {
        skip[cp as usize] = true;
    }
    // (Rust's mappings: 0 where it has none)
    let mut lower: Vec<i64, Gpa> = Vec::from_elem_in(0i64, (n as usize * 3), gpa);
    let mut upper: Vec<i64, Gpa> = Vec::from_elem_in(0i64, (n as usize * 3), gpa);
    let mut checked: i64 = 0;
    let mut wrong: i64 = 0;
    let mut shown: i64 = 0;
    each_line(reference.as_slice(), |line| {
        numbers(&line[1..line.len()], &mut nums);
        let kind = line[0];
        if kind == b'w' || kind == b'p' {
            for cp in nums[0]..nums[1] + 1 {
                if skip[cp as usize] {
                    continue;
                }
                checked += 1;
                let c = cp as u32;
                let ok = if kind == b'w' {
                    char_width(c) == nums[2] && char_width_cjk(c) == nums[3]
                } else {
                    flags(c) == nums[2]
                };
                if !ok {
                    wrong += 1;
                    if shown < 20 {
                        shown += 1;
                        if kind == b'w' {
                            println(
                                "U+{cp:04X}: width {} {}, Rust {} {}", char_width(c),
                                char_width_cjk(c), nums[2], nums[3]);
                        } else {
                            println("U+{cp:04X}: classes {}, Rust {}", flags(c), nums[2]);
                        }
                    }
                }
            }
        } else if kind == b'l' || kind == b'u' {
            for k in 1..nums.len() {
                if kind == b'l' {
                    lower[(nums[0] * 3 + k as i64 - 1) as usize] = nums[k];
                } else {
                    upper[(nums[0] * 3 + k as i64 - 1) as usize] = nums[k];
                }
            }
        }
    });
    let mut cases: i64 = 0;
    for cp in 0..n {
        if skip[cp as usize] {
            continue;
        }
        let c = cp as u32;
        for which in 0..2 {
            let m = if which == 0 { &mut lower } else { &mut upper };
            let mut want = [m[(cp * 3) as usize], m[(cp * 3 + 1) as usize],
                m[(cp * 3 + 2) as usize]];
            if want[0] == 0 {
                want[0] = cp;
            }
            let got = if which == 0 { to_lower(c) } else { to_upper(c) };
            cases += 1;
            if got[0] as i64 != want[0] || got[1] as i64 != want[1] || got[2] as i64 != want[2] {
                wrong += 1;
                if shown < 20 {
                    shown += 1;
                    println(
                        "U+{cp:04X}: case {which} {:x} {:x} {:x}, Rust {:x} {:x} {:x}", got[0],
                        got[1], got[2], want[0], want[1], want[2]);
                }
            }
        }
    }
    println(
        "{checked} widths and classes, {cases} case mappings, {new_count} new in 18.0 left out, {wrong} differ");
    0
}

// EXPECT: U+0277: case 1 a7dd 0 0, Rust 277 0 0
// EXPECT: U+027C: case 1 a7e2 0 0, Rust 27c 0 0
// EXPECT: U+AB4B: case 1 ab6c 0 0, Rust ab4b 0 0
// EXPECT: U+AB4C: case 1 ab6d 0 0, Rust ab4c 0 0
// EXPECT: 2198114 widths and classes, 2198114 case mappings, 13007 new in 18.0 left out, 4 differ
