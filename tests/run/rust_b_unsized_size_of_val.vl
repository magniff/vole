// EDITION: rust
// RULE: F21.4, Z9.1
// (0.27.2.1) `size_of_val` of a slice is its length times the element's
// size, of a str its length (0.27.2: the view's 16 bytes).
// EXPECT: 6 4 0
use std::mem::size_of_val;

fn main() {
    let a: [u16; 3] = [1, 2, 3];
    let s: &[u16] = &a;
    let e: &[u64] = &[];
    println("{} {} {}", size_of_val(s), size_of_val("abcd"), size_of_val(e));
}
