// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: ok
// STDERR: unsafe address out of bounds: an offset of 9223372036854775808 elements of 1 bytes overflows
// 0.30.1: a count of isize::MAX + 1 bytes on a pointer into a local (no
// block the check knows) is refused, as Rust's add requires: the bytes
// must fit an isize. isize::MAX itself is allowed: the address is formed,
// never read.
fn main() {
    let b = [0u8; 4];
    let q = &b[0] as *const u8;
    let m = isize::MAX as usize;
    // UNSAFE: an address only, never read.
    // SAFETY: nothing reads it.
    let x = unsafe { q.add(m) as usize };
    println("ok");
    // UNSAFE: deliberately past add's rule.
    // SAFETY: none: the program
    // exists to be stopped.
    let y = unsafe { q.add(m + 1) as usize };
    println("formed {}", x != y);
}
