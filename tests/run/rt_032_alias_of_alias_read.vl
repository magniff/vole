// RT-32 (fixed in 0.30.1): a read through an alias's alias drops the borrow: `let r = &d; let rr = &r; zap(*rr); x / d` keeps the divisor's proof
// `*rr` of `rr = &r`, `r = &d`, is d's address, but the effect walk took
// every read through an alias (`*r`) for no use of it, so the borrow
// went nowhere: #[no_panic] was accepted over a division by a divisor
// zap had made 0 (it panicked), and a counted loop whose counter was
// zeroed so never ended. Present on 0.30.0 too. Now a read whose value
// may be an address (front::effects::infer::read_gives_address, the rule
// the places IR's read-through borrows are settled by) is a use of what
// the alias reaches, at any depth (`**rr` reads the value, `*rr` the
// address), and the IR notes every such read, which the walk must have
// followed (tests/e18_loans.sh). Each function below must be refused.
// ERROR: 'k' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_ref' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_amp' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_reborrow' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k_three' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'l_loop' is #[effects(panic)], but it may not terminate
// ERROR: 'l_rebind' is #[effects(panic)], but it may not terminate
// ERROR: 'l_method' is #[effects(panic)], but it may not terminate
// ERROR-COUNT: 8

type D = distinct u64;

impl D {
    fn zap(&self) {
        // UNSAFE: the case: a write through a shared reference made a pointer
        // SAFETY: self is a live local's address
        unsafe {
            *(self as *const D as *mut D) = 0 as D;
        }
    }
}

fn zap_ref(r: &D) {
    r.zap();
}

fn zap(r: &u64) {
    // UNSAFE: the case: a write through a shared reference made a pointer
    // SAFETY: r is a live local's address
    unsafe {
        *(r as *const u64 as *mut u64) = 0;
    }
}

#[no_panic]
fn k(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        zap(*rr);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_ref(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let ref rr = r;
        zap(*rr);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_amp(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        let &r2 = rr;
        zap(r2);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_reborrow(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        zap(&**rr);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k_three(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let r = &d;
        let rr = &r;
        let rrr = &rr;
        zap(**rrr);
        x / d
    } else {
        0
    }
}

#[effects(panic)]
fn l_loop(n: u64) -> u64 {
    let mut i: u64 = 0;
    while i < n {
        let r = &i;
        let rr = &r;
        zap(*rr);
        i += 1;
    }
    i
}

#[effects(panic)]
fn l_rebind(n: D) -> D {
    let mut i: D = 0;
    while i < n {
        let r = &i;
        let rr = &r;
        let r2 = *rr;
        zap_ref(r2);
        i += 1;
    }
    i
}

#[effects(panic)]
fn l_method(n: D) -> D {
    let mut i: D = 0;
    while i < n {
        let r = &i;
        let rr = &r;
        (**rr).zap();
        i += 1;
    }
    i
}

fn main() {
    println("{} {} {} {} {}", k(7, 1), k_ref(7, 1), k_amp(7, 1), k_reborrow(7, 1), k_three(7, 1));
    println("{} {} {}", l_loop(3), l_rebind(3 as D) as u64, l_method(3 as D) as u64);
}
