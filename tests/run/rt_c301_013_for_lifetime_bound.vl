// XFAIL: RT-C301-13: `for<'r>` in a bound is not parsed (0.30.2)
// From the review: for<'r> in the impl, elided in the trait (equivalent)
// rustc accepts and prints 3.
// EXPECT: 3
trait Tr { fn f<F: Fn(&str) -> usize>(&self, g: F) -> usize; }
struct S;
impl Tr for S { fn f<F: for < 'r> Fn(&'r str) -> usize > (&self, g: F) -> usize { g("abc") } }
fn main() { println("{}", S.f(|s| s.len())); }
