// XFAIL: gap 7: compile parser error: expected ')', got '&'
// sem-own: a named fn with a sink parameter given
// where an FnMut(sink D) is expected: dropped by the fn, once.
// EXPECT: drop 5
// EXPECT: id 5
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn idof(d: D<Gpa>) -> i64 { d.id }
fn run<F: FnMut(sink & D<Gpa>) -> i64>(f: F, d: D<Gpa>) -> i64 { f(d) }

fn main(gpa: Gpa) {
    println("id {}", run(idof, mk(5, gpa)));
    println("end");
}
