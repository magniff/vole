// sem-own: a named fn with a sink parameter given
// where an FnMut(sink D) is expected: dropped by the fn, once.
// EXPECT: drop 5
// EXPECT: id 5
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn idof(d: sink D<Gpa>) -> i64 { d.id }
fn run<F: FnMut(sink D<Gpa>) -> i64>(f: sink F, d: sink D<Gpa>) -> i64 { f(d) }

fn main(gpa: Gpa) {
    println("id {}", run(idof, mk(5, gpa)));
    println("end");
}
