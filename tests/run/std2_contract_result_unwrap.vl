// (0.28.0, gap 79) Result::unwrap on an Err: the caller's place, rustc's
// text, then the error.
// EXPECT: 1
// EXIT: 101
// STDERR: std2_contract_result_unwrap.vl:11:13: called `Result::unwrap()` on an `Err` value: 2

fn main() {
    let a: Result<i64, i64> = Result::Ok(1);
    let b: Result<i64, i64> = Result::Err(2);
    println("{}", a.unwrap());
    let x = b.unwrap();
}
