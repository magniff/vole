// XFAIL: RT-363: (RT-312's mechanism, more forms) in a generic body, a supertrait's method and a default method called on a field or an array element of type T (T = &W); `g.t.tag()`, `let y = x; y.tag()`, `p.0.tag()`, `o.unwrap().tag()` with T = &&W; and `let y = x; y.tag()`, `v[0].tag()` of an `impl Tag` argument (x: impl Tag, v: Vec<impl Tag>); and in `impl<T: Tag + Copy> H<T>`, `let s: Self = self; let u = s.t; u.tag()` and `(*self).t.tag()` run the impl one deref down (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). vole prints `sup_fld 100
// dflt_fld 10 sup_arr 100` (W's Sup and W's tag under the default) and
// `refref: par 5 fld 2 lety 2 tup 2 opt 2` (&W's impl for T = &&W), at
// -O0 and -O2; v0.28.0 to v0.30.1 the same. T = &mut W and T = Box<W>
// are right at every receiver, and so is the parameter itself (`par`).
// With `impl Tag` arguments and &W: vole `it 2 itl 1 itv 1`; in H's
// impl, `viaself 1 deref_self 1 assoc 2` (Self::h(self.t), the parameter
// itself, is right).
// EXPECT: sup_fld 200 dflt_fld 20 sup_arr 200
// EXPECT: refref: par 5 fld 5 lety 5 tup 5 opt 5
// EXPECT: impl: it 2 itl 2 itv 2
// EXPECT: self: viaself 2 deref_self 2 assoc 2
trait Sup {
    fn sup(&self) -> i64;
}

trait Tag: Sup {
    fn tag(&self) -> i64;

    fn tag10(&self) -> i64 {
        self.tag() * 10
    }
}

#[derive(Clone, Copy)]
struct W {
    k: i64,
}

impl Sup for W {
    fn sup(&self) -> i64 {
        100
    }
}

impl<'a> Sup for &'a W {
    fn sup(&self) -> i64 {
        200
    }
}

impl<'a, 'b> Sup for &'a &'b W {
    fn sup(&self) -> i64 {
        300
    }
}

impl Tag for W {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a W {
    fn tag(&self) -> i64 {
        2
    }
}

impl<'a, 'b> Tag for &'a &'b W {
    fn tag(&self) -> i64 {
        5
    }
}

struct G<T> {
    t: T,
}

fn sup_fld<T: Tag>(g: G<T>) -> i64 {
    g.t.sup()
}

fn dflt_fld<T: Tag>(g: G<T>) -> i64 {
    g.t.tag10()
}

fn sup_arr<T: Tag + Copy>(x: T) -> i64 {
    let a = [x, x];
    a[1].sup()
}

fn par<T: Tag>(x: T) -> i64 {
    x.tag()
}

fn fld<T: Tag>(g: G<T>) -> i64 {
    g.t.tag()
}

fn lety<T: Tag>(x: T) -> i64 {
    let y = x;
    y.tag()
}

fn tup<T: Tag>(p: (T, i64)) -> i64 {
    p.0.tag()
}

fn opt<T: Tag>(o: Option<T>) -> i64 {
    o.unwrap().tag()
}

#[derive(Clone, Copy)]
struct H<T> {
    t: T,
}

impl<T: Tag + Copy> H<T> {
    fn h(t: T) -> i64 {
        t.tag()
    }

    fn viaself(self) -> i64 {
        let s: Self = self;
        let u = s.t;
        u.tag()
    }

    fn deref_self(&self) -> i64 {
        (*self).t.tag()
    }

    fn assoc(&self) -> i64 {
        Self::h(self.t)
    }
}

fn it(x: impl Tag) -> i64 {
    x.tag()
}

fn itl(x: impl Tag) -> i64 {
    let y = x;
    y.tag()
}

fn itv(v: Vec<impl Tag, Gpa>) -> i64 {
    v[0].tag()
}

fn main(gpa: Gpa) {
    let w = W { k: 5 };
    println("sup_fld {} dflt_fld {} sup_arr {}", sup_fld(G { t: &w }), dflt_fld(G { t: &w }),
        sup_arr(&w));
    let r = &w;
    println("refref: par {} fld {} lety {} tup {} opt {}", par(&r), fld(G { t: &r }), lety(&r),
        tup((&r, 0i64)), opt(Some(&r)));
    let mut v: Vec<&W, Gpa> = Vec::new_in(gpa);
    v.push(&w);
    println("impl: it {} itl {} itv {}", it(&w), itl(&w), itv(v));
    let h = H { t: &w };
    println("self: viaself {} deref_self {} assoc {}", h.viaself(), h.deref_self(), h.assoc());
}
