#[derive(Clone, Copy, PartialEq, Eq)] enum Other { A }
#[derive(Clone, Copy)] struct Missing { what: i64 }
#[derive(Clone, Copy)] enum AppError { Parse(i64), Missing(Missing) }

fn get() -> Option<i64> { Some(1i64) }
fn res() -> Result<i64, Other> { Ok(1i64) }
fn miss() -> Result<i64, Missing> { Ok(1i64) }

fn a() -> i64 {
    let x = get()?;
    x
}

fn b() -> Result<i64, AppError> {
    let x = get()?;
    Ok(x)
}

