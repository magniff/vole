// (0.30.2, the re-review of g302holes: r91/r05b_three_deep_escape_fail)
// ERROR: captured variable cannot escape `FnMut` closure body: the lifetime of the closure's environment is only the call's, but it flows where a lifetime of the closure's signature, from outside it is required, which lasts longer
// Three and four levels: flat_map of flat_map of map, and a closure making a closure making a closure.
fn main() {
    let a = [1i64, 2];
    let b = [10i64, 20];
    let c = [100i64, 200];
    let s: i64 = a
        .iter()
        .flat_map(|x| b.iter().flat_map(move |y| c.iter().map(move |z| x * y * z)))
        .sum();
    println("{s}");
    let f = |p: i64| move |q: i64| move |r: i64| move |t: i64| p + q * r + t;
    println("{}", f(1)(2)(3)(4));
}
