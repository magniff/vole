// RT-24 (fixed in 0.30.1), a form of it: a `\xFF` escape in a text block
// made a &str that is not UTF-8 (lex_text_block decodes through
// lex_escape, ESC_STR).
// ERROR: out of range hex escape
// ERROR-COUNT: 1
const T: &str = """
    a\xFFb
    """;

fn main() {
    println("{:?}", T.as_bytes());
}
