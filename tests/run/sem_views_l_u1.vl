use std::alloc::Allocator; struct H<A: Allocator> { b: String<A> }
impl H<Gpa> {
    fn new(gpa: Gpa) -> H<Gpa> { let mut b = String::new_in(gpa); b.push_str("hi"); H { b: b } }
    fn len(&self) -> i64 { self.b.len() as i64 } }
fn mk(gpa: Gpa) -> H<Gpa> { H::new(gpa) }

fn main(gpa: Gpa) -> i32 {
    println("{}", Vec::<u8, Gpa>::new_in(gpa).len());
    0
}
