// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::fmt Debug::fmt.
// EXPECT: Pt { x: 3, y: 4 }
use std::fmt::{Debug, Display, Formatter};

struct Pt {
    x: i64,
    y: i64,
}

impl Display for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        write(f, "({}, {})", self.x, self.y)
    }
}

impl Debug for Pt {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("Pt").field("x", &self.x).field("y", &self.y).finish()
    }
}

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let mut f = Formatter::new(&mut s);
    let _ = Debug::fmt(&Pt { x: 3, y: 4 }, &mut f);
    println("{}", s);
}
