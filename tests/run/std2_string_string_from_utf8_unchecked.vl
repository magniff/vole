// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string String::from_utf8_unchecked.
// EXPECT: hi

fn main(gpa: Gpa) {
    let v = Vec::from_in([104u8, 105], gpa);
    // UNSAFE: the test of from_utf8_unchecked.
    // SAFETY: the bytes are ASCII.
    let s = unsafe { String::from_utf8_unchecked(v) };
    println("{}", s);
}
