// EDITION: rust
// RULE: C7.6
// (0.27.3) The requires of a trait method's default body, checked at a
// call through a bound of an impl that does not define it (C7.4).
// EXPECT: 4
// EXIT: 101
// STDERR: requires failed: 'i >= 0' of 'S::pick'
trait Pick {
    fn pick(&self, i: i64) -> i64
        requires i >= 0
    {
        i + 3
    }
}

struct S;

impl Pick for S {}

fn use_it<P: Pick>(p: &P, i: i64) -> i64 {
    p.pick(i)
}

fn main() {
    println("{}", use_it(&S, 1));
    println("{}", use_it(&S, -1));
}
