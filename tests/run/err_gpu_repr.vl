// 0.26.2: a #[repr(wgsl)] struct's fields are host-shareable or gpu.repr,
// each naming its field, with the fix when there is one (u32 for a bool).
// ERROR: error[gpu.repr]: Bad.flag (bool) is a bool, and WGSL's bool is not host-shareable
// ERROR: err_gpu_repr.vl: line 22, column 5
// ERROR: fix --suggested
// ERROR: error[gpu.repr]: Bad.n (usize) is no WGSL scalar
// ERROR: error[gpu.repr]: Bad.big (i64) is no WGSL scalar
// ERROR: error[gpu.repr]: Bad.p (*f32) is not host-shareable
// ERROR: error[gpu.repr]: Bad.v (Vec<f32>) is not host-shareable
// ERROR: error[gpu.repr]: Bad.t ((f32, f32)) is not host-shareable
// ERROR: error[gpu.repr]: Bad.k (Kind) is not host-shareable
// ERROR: error[gpu.repr]: Bad.cols ([[f32; 3]; 2]) is an array of 3-element arrays
// ERROR: error[gpu.repr]: Bad.plain (Plain) is a struct without #[repr(wgsl)]
enum Kind { A, B }

struct Plain {
    x: f32,
}

#[repr(wgsl)]
struct Bad {
    flag: bool,
    n: usize,
    big: i64,
    p: *f32,
    v: Vec<f32>,
    t: (f32, f32),
    k: Kind,
    cols: [[f32; 3]; 2],
    plain: Plain,
}

fn main() -> i32 {
    0
}
