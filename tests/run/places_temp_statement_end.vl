// places IR (0.26.1, R5): a statement temporary drops at the end of its
// statement (or of the block, when a binding views it), as the own pass's
// prelude defer: not at the end of the hidden `let` that holds an
// operator's operand or an f-string's hole. `v == v.clone()` compares
// before the clone drops; `b + mk(3)` adds before mk(3) drops;
// `mk(1).id` prints before mk(1) drops.
// FLAGS: --check-alloc
// EXPECT: true
// EXPECT: add 2 3
// EXPECT: drop 3
// EXPECT: 5
// EXPECT: 1
// EXPECT: drop 1
// EXPECT: drop 0
// EXPECT: drop 2
// PLACES: fn main
// PLACES: call Vec<i64>::clone
// PLACES: call Vec<i64>::eq
// PLACES: drop(_8) [kept]
// PLACES: call mk(const 3)
// PLACES: call T::add
// PLACES: drop(_
// PLACES: call mk(const 1)
// PLACES: call std::fmt::__print_end
// PLACES: drop(_
struct T { id: i64 }

impl Drop for T {
    fn drop(self: inout T) {
        println(f"drop {self.id}");
    }
}

impl Add for T {
    fn add(self, other: T) -> T {
        println(f"add {self.id} {other.id}");
        T { id: 0 }
    }
}

fn mk(id: i64) -> T {
    T { id }
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(1);
    let same = v == v.clone();
    println(f"{same}");
    let b = mk(2);
    let c = b + mk(3);
    println(f"{c.id + 5}");
    println(f"{mk(1).id}");
}
