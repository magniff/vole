// RULE: F8.3, F8.4
// RT-C301-8 review (C1, form f65_qual_no_args_two_impls_call): `<S as Conv<_>>::mk(x)`: the `_` filled from the impls by the argument.
// rustc prints the EXPECT lines.
// EXPECT: 8 32
trait Conv<X> { fn mk(x: X) -> i64; }
trait Other { fn mk(x: u8) -> i64; }
struct S;
impl Conv<i32> for S { fn mk(_x: i32) -> i64 { 32 } }
impl Conv<u8> for S { fn mk(_x: u8) -> i64 { 8 } }
impl Other for S { fn mk(_x: u8) -> i64 { 99 } }
fn main() { println("{} {}", <S as Conv<_>>::mk(1u8), <S as Conv<_>>::mk(1i32)); }
