// XFAIL: RT-487b: (RT-487, other constant positions) `[0; { 2 } << 1]` and an enum discriminant `A = { 1 } << 2` are "not a compile-time constant"; rustc prints `4 5` (0.30.2)
// From the third re-review of the qualified-path work (g302qual). Since v0.30.1 at least.
// From the review's form c1/a19b_array_len_block.
// EXPECT: 4 5
trait Tr {
    type Out;
    fn f(x: i64) -> i64;
}

struct S {
    a: i64,
}

impl Tr for S {
    type Out = S;

    fn f(x: i64) -> i64 {
        println("f {}", x);
        x + 1
    }
}

enum En {
    A = { 1 } << 2,
    B,
}

fn main() {
    let v = [0; { 2 } << 1];
    println("{} {}", v.len(), En::B as i64);
}
