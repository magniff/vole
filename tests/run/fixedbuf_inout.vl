// EDITION: rust
// XFAIL: gap 7: compile parser error: expected expression, got 'mut'
// (0.25) FixedBuf::new(&mem[..]): the allocator holds mem inout; mem is
// used again once the containers on it are done, and containers used one
// after the other share one buffer.
use std::alloc::FixedBuf;

fn main() {
    let mut mem = [0u8; 256];
    let fb = FixedBuf::new(&mut mut mem[..]);
    let mut v: Vec<i64, FixedBuf<'_>> = Vec::new_in(fb);
    v.push(7);
    v.push(8);
    println("{} {}", v[0] + v[1], fb.used() as i64);
    drop(v);
    let mut w: Vec<u8, FixedBuf<'_>> = Vec::new_in(fb);
    w.push(1u8);
    println("{}", w.len());
    let mut other = [0u8; 64];
    let mut t: Vec<u8, FixedBuf<'_>> = Vec::new_in(FixedBuf::new(&mut mut other[..]));
    t.push(2u8);
    println("{}", t[0] + w[0]);
    println("{}", mem[0] + other[0]);
}
// EXPECT: 15 32
// EXPECT: 1
// EXPECT: 3
// EXPECT: 8
