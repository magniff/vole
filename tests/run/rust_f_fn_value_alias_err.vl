// (0.30.1, review 7) A function whose parameter is `Si`, `type Si =
// &'static i64`, needs a 'static reference: as a `fn(&i64)` value it is
// refused (rustc E0308), as with `&'static i64` written (RT-M2-2); before,
// the alias's text hid the 'static and the value was called with a Box's
// reference.
// ERROR: borrowck.fn_value_static
// ERROR-COUNT: 1
type Si = &'static i64;

fn bg(x: Si) -> i64 {
    *x
}

fn main(gpa: Gpa) {
    let f: fn(&i64) -> i64 = bg;
    let b = Box::new_in(1i64, gpa);
    println("{}", f(&*b));
}
