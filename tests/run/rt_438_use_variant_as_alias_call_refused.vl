// XFAIL: RT-438: a variant imported under another name, `use E::A as AA;`, then `AA(&d)`, is refused: "no variant or associated function 'AA' in 'E'"; rustc prints the EXPECT lines (0.30.2)
// From the paused g302temps work (PAUSED.md, findings not yet reported:
// form p01). Since v0.30.1 at least (the same error).
// EXPECT: c 1
// EXPECT: drop 1
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

enum E<'a> {
    A(&'a D),
    B,
}

use E::A as AA;

fn main() {
    let d = D { n: 1 };
    let c = AA(&d);
    if let E::A(x) = c {
        println("c {}", x.n);
    }
}
