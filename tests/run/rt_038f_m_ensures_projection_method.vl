// RULE: C3.4
// (0.30.2, RT-38f) A trait impl's method whose parameter is a
// projection, `<&K as Tr>::Out = &mut i64`: no view after the body
// (0.30.1 printed 2 9).
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*p'
// ERROR-COUNT: 1
trait Tr {
    type Out;
}

struct K;

impl<'a> Tr for &'a K {
    type Out = &'a mut i64;
}

trait Run {
    fn run(&self, p: < &K as Tr >::Out) -> i64;
}

impl Run for K {
    fn run(&self, p: < &K as Tr >::Out) -> i64
        ensures {
        *p = 9;
        true
    }

    {
        *p += 1;
        *p
    }
}

fn main() {
    let mut x = 1i64;
    println("{}", K.run(&mut x));
    println("{}", x);
}
