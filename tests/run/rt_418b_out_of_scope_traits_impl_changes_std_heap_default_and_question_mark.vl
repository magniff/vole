// XFAIL: RT-418b: (R302I-1 and R302I-2 with the other traits out of scope) impls of traits declared in a module `other` that main never imports (OtherOrd::partial_cmp, OtherDef::default, OtherFrom::from) change std's BinaryHeap pop order, `Default::default()` and the `?` operator's error conversion in main (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt): a trait that is not in
// scope takes no part in a method or path lookup, and std's generic code
// cannot see the program's traits at all. vole prints `1 -1 Err(F { k: -1
// })` at -O0 and -O2; v0.28.0 to v0.30.1 the same. So the lookup by name
// spans every impl of F in the program, in or out of scope (the same in
// a separate file, `mod other;`: scratch a2/).
// EXPECT: 3 42 Err(F { k: 9 })
use std::cmp::Ordering;
use std::collections::BinaryHeap;

mod other {
    use std::cmp::Ordering;

    use super::F;

    pub trait OtherOrd {
        fn partial_cmp(&self, o: &Self) -> Option<Ordering>;
    }

    impl OtherOrd for F {
        fn partial_cmp(&self, o: &F) -> Option<Ordering> {
            Some(o.k.cmp(&self.k))
        }
    }

    pub trait OtherDef {
        fn default() -> Self;
    }

    impl OtherDef for F {
        fn default() -> F {
            F { k: -1 }
        }
    }

    impl Default for F {
        fn default() -> F {
            F { k: 42 }
        }
    }

    pub trait OtherFrom {
        fn from(x: i64) -> Self;
    }

    impl OtherFrom for F {
        fn from(x: i64) -> F {
            F { k: -1 }
        }
    }
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct F {
    pub k: i64,
}

impl PartialOrd for F {
    fn partial_cmp(&self, o: &F) -> Option<Ordering> {
        Some(self.k.cmp(&o.k))
    }
}

impl Ord for F {
    fn cmp(&self, o: &F) -> Ordering {
        self.k.cmp(&o.k)
    }
}

impl From<i64> for F {
    fn from(x: i64) -> F {
        F { k: x }
    }
}

fn q(x: i64) -> Result<i64, F> {
    let r: Result<i64, i64> = Err(x);
    let v = r?;
    Ok(v)
}

fn main(gpa: Gpa) {
    let mut h: BinaryHeap<F, Gpa> = BinaryHeap::new_in(gpa);
    h.push(F { k: 3 });
    h.push(F { k: 1 });
    h.push(F { k: 2 });
    let a: F = Default::default();
    println("{} {} {:?}", h.pop().unwrap().k, a.k, q(9));
}
