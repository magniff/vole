// Runs on std since 0.27.2's switch.
// The std item(s): std::iter IntoIterator::IntoIter.
// EXPECT: Some(1)

fn first<C: IntoIterator>(c: C) -> Option<C::Item> {
    let mut it: C::IntoIter = c.into_iter();
    it.next()
}

fn main(gpa: Gpa) {
    println("{:?}", first(Vec::from_in([1i64, 2], gpa)));
}
