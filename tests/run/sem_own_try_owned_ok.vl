// EDITION: rust
// sem-own: `?` on Ok moving an owned payload into a local: dropped once.
// EXPECT: got 4
// EXPECT: drop 4
// EXPECT: drop 1
// EXPECT: r 4
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn g(gpa: Gpa) -> Result<D<Gpa>, i64> { Ok(mk(4, gpa)) }

fn f(gpa: Gpa) -> Result<i64, i64> {
    let a = mk(1, gpa);
    let d = g(gpa)?;
    println("got {}", d.id);
    Ok(d.id)
}

fn main(gpa: Gpa) {
    println("r {}", f(gpa).unwrap_or(0));
}
