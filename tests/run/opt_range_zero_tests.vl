// (0.29) The value ranges take a test for zero in any spelling for the
// same fact: unsigned, `x > 0` and `x >= 1` are `x != 0`, and `x < 1` and
// `x <= 0` are `x == 0` (middle/range, zero_test). A slice's length is
// unsigned and its sign unknown to the intervals, so `len > 0` (the check
// of `s[0]`) decided nothing about `len >= 1` (the check of `s[1..]`),
// and `!s.is_empty()` neither: every step of a slice's iterator kept both
// checks. Here: the second test of each pair is folded (no call of
// `other` is left), the loops over a slice and over a Vec have no check,
// and a signed `x >= 1` after `x != 0` is still asked (-5 is not zero).
// EXPECT: other 2
// EXPECT: 1 1 1 1
// EXPECT: 3 1
// EXPECT: 14 9 45
// CHECK: fn gt_ge:
// CHECK-NOT: call other
// CHECK: fn ne_gt:
// CHECK-NOT: call other
// CHECK: fn conv_ne_gt:
// CHECK-NOT: call other
// CHECK: fn lt_eq:
// CHECK-NOT: call other
// CHECK: fn signed_ne_ge:
// CHECK: call other
// CHECK: fn sum_iter:
// CHECK-NOT: rt.panic
// CHECK: fn sum_vec:
// CHECK-NOT: rt.panic
// CHECK: fn main:
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[inline(never)]
fn other(k: i64) -> i64 {
    unsafe { printf(c"other %ld\n", k); }
    k
}

#[inline(never)]
fn gt_ge(n: usize) -> i64 {
    if n > 0 {
        if n >= 1 { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn ne_gt(n: usize) -> i64 {
    if n != 0 {
        if n > 0 { 1 } else { other(2) }
    } else {
        0
    }
}

// The form of `!s.is_empty()` and then `s[0]`: the length read as an i64.
#[inline(never)]
fn conv_ne_gt(n: usize) -> i64 {
    if n as i64 != 0 {
        if n > 0 { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn lt_eq(n: usize) -> i64 {
    if n < 1 {
        if n == 0 { 1 } else { other(2) }
    } else {
        0
    }
}

// Signed: not zero does not make it at least 1.
#[inline(never)]
fn signed_ne_ge(x: i64) -> i64 {
    if x != 0 {
        if x >= 1 { 1 } else { other(2) }
    } else {
        0
    }
}

#[inline(never)]
fn sum_iter(s: &[i64]) -> i64 {
    let mut t: i64 = 0;
    for x in s {
        t += *x;
    }
    t
}

#[inline(never)]
fn sum_vec(v: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for x in v {
        t += *x;
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    let a: [i64; 5] = [1, 2, 3, 4, 5];
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..10 {
        v.push(i);
    }
    let pairs = (gt_ge(3) + gt_ge(0), ne_gt(3) + ne_gt(0), conv_ne_gt(3) + conv_ne_gt(0),
        lt_eq(0) + lt_eq(7));
    let signed = signed_ne_ge(-5) + signed_ne_ge(4) + signed_ne_ge(0);
    let empty: [i64; 0] = [];
    unsafe {
        printf(c"%ld %ld %ld %ld\n", pairs.0, pairs.1, pairs.2, pairs.3);
        printf(c"%ld %ld\n", signed, gt_ge(1));
        printf(c"%ld %ld %ld\n", sum_iter(&a[1..]), sum_iter(&a[3..]) + sum_iter(&empty[..]),
            sum_vec(&v));
    }
    0
}
