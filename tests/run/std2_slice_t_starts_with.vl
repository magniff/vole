// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::starts_with.
// EXPECT: true false true

fn main() {
    let s: &[i64] = &[1, 2, 3];
    let e: &[i64] = &[];
    println("{} {} {}", s.starts_with(&[1, 2]), s.starts_with(&[2]), s.starts_with(e));
}
