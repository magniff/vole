// EDITION: rust
// (0.26.3, decision 6) With the overflow checks off, a constant's + - *,
// unary - and shifts wrap, as the program's own arithmetic does (shifts by
// at least the bits masked, Rust's release arithmetic).
// FLAGS: -O0 --overflow-checks=off
// EXPECT: -2147483648 255 -2 -128 -128 1 16
const A: i32 = 2147483647 + 1;
const B: u8 = 3 - 4;
const C: i64 = 9223372036854775807 * 2;
const M: i8 = -128;
const N: i8 = -M;
const S: u32 = 1 << 32;
const T: u8 = 1 << 12;

fn main() {
    println("{} {} {} {} {} {} {}", A, B, C, M, N, S, T);
}
