// (0.26.3, decision 6) `c += b` of u8s panics at -O0, where the overflow
// checks are on by default, with Rust's message at the expression.
// FLAGS: -O0
// EXIT: 101
// EXPECT: before
// STDERR: ovf_o0_add_assign_u8.vl:18:5: attempt to add with overflow

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: u8 = idu(200) as u8;
    let b: u8 = idu(56) as u8;
    println("before");
    let mut c = a;
    c += b;
    println("after {}", c);
}
