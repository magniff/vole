// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::hash Hasher.
// EXPECT: 1 3
use std::hash::{BuildHasher, BuildHasherDefault, Hash, Hasher};

struct Fnv {
    h: u64,
}

impl Hasher for Fnv {
    fn finish(&self) -> u64 {
        self.h
    }

    fn write(&mut self, bytes: &[u8]) {
        for b in bytes {
            self.h = (self.h ^ *b as u64).wrapping_mul(0x100000001b3);
        }
    }
}

fn fnv() -> Fnv {
    Fnv { h: 0xcbf29ce484222325 }
}

struct Count {
    n: u64,
}

impl Hasher for Count {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        self.n += bytes.len() as u64;
    }
}

// any Hasher: what it makes of the same input
fn digest<H: Hasher>(h: &mut H) -> u64 {
    h.write_u8(1);
    h.write_u16(2);
    h.finish()
}

fn main() {
    let mut c = Count { n: 0 };
    let mut c1 = Count { n: 0 };
    c1.write_u8(1);
    println("{} {}", c1.finish(), digest(&mut c));
}
