// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::clone_in.
// EXPECT: Some(1) Some(5)
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    let c = m.clone_in(gpa);
    m.insert(1, 5);
    println("{:?} {:?}", c.get(&1), m.get(&1));
}
