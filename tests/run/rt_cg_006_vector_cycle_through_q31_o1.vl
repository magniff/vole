// RT-CG-6 (fixed in 0.30.1): a cycle of an edge's moves through vector spill slots and the scalars beside them, at -O1 (tests/fuzz/run.sh -M -V, seed 13 of the release branch's failures)
// FLAGS: -O1
// EXPECT: 10
// EXPECT: 4.5
// EXPECT: 0
// EXPECT: 48
// EXPECT: 8.1875
// EXPECT: 3.5
// EXPECT: 6
// EXPECT: 2.25
// EXPECT: 104
// EXPECT: 7.5
// EXPECT: 7.75
// EXPECT: 14
// EXPECT: 13
// EXPECT: 115 45.709676057100296
// CHECK-OPT: 1
// ASM(aarch64-macos): ldr q31, [sp
// The loop's back edge rotates vectors in spill slots: the ASM line pins
// that the edge breaks a cycle through q31 (the vector cycle register).
// The release branch printed 10.75 for v12 at -O1 on
// aarch64-macos; the EXPECT line is -O0's (and every level's on both
// arches now).
use std::sync::atomic::{AtomicI64, Ordering};
static K: AtomicI64 = AtomicI64::new(0);
#[inline(never)]
fn g(a: i64) -> i64 {
    K.fetch_add(1, Ordering::Relaxed);
    a ^ 5
}

fn main() {
    let lim = (g(7) & 15) + 3;
    let a0 = g(20);
    let a1 = g(21);
    let a2 = g(22);
    let a3 = g(23);
    let a4 = g(24);
    let b0 = (g(40) as f64) * 0.5;
    let b1 = (g(41) as f64) * 0.5;
    let b2 = (g(42) as f64) * 0.5;
    let mut v0: v4f32 = v4f32::splat((g(0) as f32) * 0.5);
    let mut v1: f64 = (g(3) as f64) * 0.375;
    let mut v2: v1f64 = v1f64::splat((g(2) as f64) * 0.5);
    let mut v3: v8i32 = v8i32::splat((g(3) & 15) as i32);
    let mut v4: v4f32 = v4f32::splat((g(4) as f32) * 0.5);
    let mut v5: v1f64 = v1f64::splat((g(5) as f64) * 0.5);
    let mut v6: v2i64 = v2i64::splat((g(6) & 15) as i64);
    let mut v7: f64 = (g(9) as f64) * 0.375;
    let mut v8: v8u8 = v8u8::splat((g(8) & 15) as u8);
    let mut v9: v2f64 = v2f64::splat((g(9) as f64) * 0.5);
    let mut v10: v2f64 = v2f64::splat((g(10) as f64) * 0.5);
    let mut v11: v2f64 = v2f64::splat((g(11) as f64) * 0.5);
    let mut v12: v2f64 = v2f64::splat((g(12) as f64) * 0.5);
    let mut t: i64 = 0;
    let mut s: i64 = 0;
    let mut sf: f64 = 0.0;
    while t < lim {
        s = s ^ (a4 + t);
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b1;
        let c = g(t);
        v4 = v4 * v4f32::splat(0.5) + v0 * v4f32::splat(0.25) + v4f32::splat((c as f32) * 0.125);
        { let tmp_r = v7; v7 = v1; v1 = tmp_r; }
        s = s + g(t);
        s = s ^ (a1 + t);
        s = s ^ (a2 + t);
        s = s ^ (a3 + t);
        s = s ^ (a4 + t);
        sf = sf * 0.5 + b0;
        sf = sf * 0.5 + b1;
        sf = sf * 0.5 + b2;
        let e = g(t + 1);
        { let tmp_r = v5; v5 = v2; v2 = tmp_r; }
        s = s + g(t);
        { let tmp_r = v10; v10 = v12; v12 = v9; v9 = tmp_r; }
        v10 = v10 * v2f64::splat(0.5) + v10 * v2f64::splat(0.25) + v2f64::splat((c as f64) * 0.125);
        s = s + e;
        t += 1;
    }
    println("{}", v0.sum());
    println("{}", v1);
    println("{}", v2.sum());
    println("{}", v3.sum());
    println("{}", v4.sum());
    println("{}", v5.sum());
    println("{}", v6.sum());
    println("{}", v7);
    println("{}", v8.sum());
    println("{}", v9.sum());
    println("{}", v10.sum());
    println("{}", v11.sum());
    println("{}", v12.sum());
    println("{} {}", s, sf);
}
