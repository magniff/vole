// EXPECT: two 2 4 6 8 10 12 14 16 9
// EXPECT: same 120 36
// EXPECT: nested 4 3 0 10 135
// EXPECT: grid 6 15 24 45
// (0.25.4) Stores through another Vec's elements: middle::vecfacts' fact
// 2 is about a Vec's own buffer, so a store through one Vec's buffer
// still reaches another Vec's header when that header lives there (a
// Vec<Vec<i64>>: the inner headers are the outer buffer's elements), and
// another Vec's elements when the two share memory. Two inout Vecs
// (distinct, by exclusivity); the inner Vecs of a Vec<Vec<i64>> replaced
// through the outer buffer while their lengths and elements are read in
// the loop; a static Vec<Vec<i64>> grid summed by rows while rows are
// pushed.
// FLAGS: --check-alloc
#[inline(never)]
fn two(dst: inout Vec<i64>, src: inout Vec<i64>) -> i64 {
    for i in 0..dst.len() {
        dst[i] = src[i] * 2;
        src[i] = src[i] + 1;
    }
    src[0] + dst.len() as i64 - 1
}

#[inline(never)]
fn same(v: inout Vec<i64>) -> i64 {
    // (one Vec, its element i written, then read through i - 1 + 1)
    var s = 0;
    for i in 1..v.len() {
        v[i] = v[i - 1] + i as i64;
        s += v[i - 1 + 1];
    }
    s
}

#[inline(never)]
fn nested(vv: inout Vec<Vec<i64>>, gpa: Gpa) -> i64 {
    // vv[k] replaced whole (the outer buffer's element, which is vv[k]'s
    // header) while vv[k].len() and vv[k][0] are read
    var s = 0;
    for k in 0..vv.len() {
        let before = vv[k].len();
        var w: Vec<i64> = Vec::new_in(gpa);
        for j in 0..k + 1 {
            w.push(j as i64 + k as i64);
        }
        vv[k] = w;
        s = s * 10 + before as i64 + vv[k].len() as i64 + vv[k][0] * 0;
    }
    s
}

#[inline(never)]
fn grid_sum(g: inout Vec<Vec<i64>>, gpa: Gpa) -> i64 {
    var t = 0;
    for r in 0..g.len() {
        var row = 0;
        for c in 0..g[r].len() {
            row += g[r][c];
            g[r][c] = 0;
        }
        t = t * 100 + row;
    }
    t
}

fn main(gpa: Gpa) {
    var a: Vec<i64> = Vec::new_in(gpa);
    var b: Vec<i64> = Vec::new_in(gpa);
    for i in 0..8 {
        a.push(0);
        b.push(i + 1);
    }
    let r = two(&a, &b);
    println("two {} {} {} {} {} {} {} {} {r}", a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7]);
    var c: Vec<i64> = Vec::new_in(gpa);
    for _ in 0..9 {
        c.push(0);
    }
    let sc = same(&c);
    println("same {sc} {}", c[8]);
    var vv: Vec<Vec<i64>> = Vec::new_in(gpa);
    for k in 0..3 {
        var w: Vec<i64> = Vec::new_in(gpa);
        for _ in 0..k {
            w.push(7);
        }
        vv.push(w);
    }
    let n = nested(&vv, gpa);
    println("nested {} {} {} {} {n}", vv[2].len() + 1, vv[2].len(), vv[0][0], vv[2][2] * 2 + 2);
    var g: Vec<Vec<i64>> = Vec::new_in(gpa);
    for r in 0..3 {
        var row: Vec<i64> = Vec::new_in(gpa);
        for c in 0..3 {
            row.push(r * 3 + c + 1);
        }
        g.push(row);
    }
    let t = grid_sum(&g, gpa);
    println(
        "grid {} {} {} {}", t / 10000, (t / 100) % 100, t % 100,
        t / 10000 + (t / 100) % 100 + t % 100);
}
