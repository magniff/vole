// EDITION: rust
// REQUIRES: metal
// LINK: std::window names the frameworks it links
// (0.28.0) std::window::Button compares (PartialEq, Eq) and prints, and
// std::window::Error prints (Debug) and compares.
// EXPECT: true false true Other(4) NoDisplay Failed("no screen") true

use std::window::{Button, Error};

fn main() {
    let e = Error::Failed("no screen");
    println("{} {} {} {:?} {:?} {:?} {}", Button::Left == Button::Left,
        Button::Left == Button::Right, Button::Other(4) != Button::Other(5), Button::Other(4),
        Error::NoDisplay, e, e == Error::Failed("no screen"));
}
