// From the g302qual review (form f07d_nested_generic).
// EXPECT: 230
trait A { type Out: B + C; }
trait B { const K: i64; fn m(&self) -> i64; }
trait C { const K: i64; fn m(&self) -> i64; }
struct S; struct T;
impl A for S { type Out = T; }
impl B for T { const K: i64 = 2; fn m(&self) -> i64 { 20 } }
impl C for T { const K: i64 = 3; fn m(&self) -> i64 { 30 } }
fn g<X: A>(o: &X::Out) -> i64 { let f = <X::Out as C>::m; <X::Out as B>::K * 100 + f(o) }
fn main() { println("{}", g::<S>(&T)); }
