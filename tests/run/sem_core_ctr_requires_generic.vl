// EDITION: rust
// requires on a generic function, checked in every instance.
// EXPECT: 2
// EXIT: 101
// STDERR: past the end: i = 1, s.len() as i64 = 1
static mut Z: i64 = 0;

fn at<T>(s: &[T], i: i64) -> T
    requires i < s.len() as i64 else "past the end"
{
    s[i as usize]
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2];
    let b = [true];
    println("{}", at(&a[..], 1 + unsafe { Z }));
    println("{}", at(&b[..], 1 + unsafe { Z }));
    0
}
