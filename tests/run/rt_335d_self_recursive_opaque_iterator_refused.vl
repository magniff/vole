// XFAIL: RT-335d: (RT-335's mechanism, self-recursion, an iterator) `fn evens(n: i64) -> impl Iterator<Item = i64>` whose body sums `evens(n - 1)` is refused as opaque.cycle; rustc accepts it and prints the EXPECT lines (0.30.2)
// From the third re-review of g302copy. Since v0.30.1 at least.
// From the review's form oe04.
// EXPECT: in 1 0
// EXPECT: in 2 0
// EXPECT: in 3 0
// EXPECT: in 4 2
// EXPECT: s 2
fn evens(n: i64) -> impl Iterator<Item = i64> {
    if n > 0 {
        let s: i64 = evens(n - 1).sum();
        println("in {} {}", n, s);
    }
    (0..n).filter(|x| x % 2 == 0)
}

fn main() {
    let s: i64 = evens(4).sum();
    println("s {}", s);
}
