// EDITION: rust
// RULE: D8.5
// (0.27.2.1) What an aggregate may do: read a part before moving the whole,
// move disjoint parts, and copy a Copy place twice.
// EXPECT: 1 2 3 7 7
struct D {
    n: i64,
}

struct P {
    a: D,
    b: D,
}

fn main() {
    let t = D { n: 1 };
    let p = (t.n, t);
    let q = P { a: D { n: 2 }, b: D { n: 3 } };
    let r = (q.a, q.b);
    let k: i64 = 7;
    let c = (k, k);
    println("{} {} {} {} {}", p.1.n, r.0.n, r.1.n, c.0, c.1);
}
