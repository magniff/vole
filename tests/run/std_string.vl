// EXPECT: <  héllo, wörld  >< second line><third>
// EXPECT: ["a", "b", "", "c"] 4
// EXPECT: ["a", "b", "c"]
// EXPECT: ["", "a", "b", "c", ""]
// EXPECT: ["a", "b-c-d"]
