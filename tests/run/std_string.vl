// EXPECT: Ok("from buf")
// EXPECT: ["x", "y", "z"] 2 true
// 0.20 (B5): std's `str` and String: literals as `str`, `&str`
// parameters, split/splitn with byte and substring patterns (an empty one
// matches at every char boundary), find/rfind/contains, trim and
// strip_prefix, split_once/rsplit_once, parse::<T>() for numbers and
// bools, Unicode case mapping (ß is SS), replace_in/repeat_in, String's
// push/push_str/push_fmt/pop, `&s` where a `str` goes, `s.trim()` on a
// String, to_string_in of an f-string, chars().rev(), width, graphemes,
// char_indices, from_utf8 and from_utf8_lossy_in, String::from_buf.
// WARNING: warning[item.deprecated]: use of deprecated struct 'Buf'
fn count_words(s: &str) -> i64 { s.split_whitespace().count() as i64 }

fn main(gpa: Gpa) -> Result<(), std::str::ParseIntError> {
    // (0.20: a literal is a `str` where one goes, `&str` is `str`)
    let text: &str = "  héllo, wörld  \n second line\r\nthird";
    println("{:?} {} {}", text.trim(), text.len(), text.chars().map(|c| c as u32).count());
    for line in text.lines() {
        print("<{line}>");
    }
    println("");
    let csv: &str = "a,b,,c";
    let parts: Vec<&str, Gpa> = csv.split(',').collect_in(gpa);
    println("{parts:?} {}", parts.len());
    let parts2: Vec<&str, Gpa> = "a, b, c".split(", ").collect_in(gpa);
    println("{parts2:?}");
    let e: Vec<&str, Gpa> = "abc".split("").collect_in(gpa);
    println("{e:?}");
    let n: Vec<&str, Gpa> = "a-b-c-d".splitn(2i64 as usize, '-').collect_in(gpa);
    println("{n:?}");
    let a1 = csv.find(|x| ',' (*x));
    let a2 = csv.rfind(',');
    let a3 = csv.find(|x| "zz" (*x));
    let a4 = csv.contains(&"b,");
    println("{a1:?} {a2:?} {a3:?} {a4}");
    let b1 = text.trim().starts_with("hé");
    let b2 = csv.ends_with('c');
    let b3 = csv.strip_prefix("a,");
    println("{b1} {b2} {b3:?}");
    let (k1, v1) = "key=value".split_once('=').unwrap();
    let (k2, v2) = "a.b.c".rsplit_once('.').unwrap();
    println("{k1}|{v1} {k2}|{v2}");
    let v: i64 = " 42 ".trim().parse::<i64>()?;
    let f = "2.5".parse::<f64>();
    let b = "true".parse::<bool>();
    let d1 = "x1".parse::<i32>();
    let d2 = "300".parse::<u8>();
    println("{v} {f:?} {b:?} {d1:?} {d2:?}");
    let up = text.trim().to_uppercase_in(gpa);
    let low = "ÀÉÎ Straße".to_lowercase_in(gpa);
    let up2 = "straße".to_uppercase_in(gpa);
    println("{up:?} {low} {up2}");
    let r = "one two two".replace_in("two", "2", gpa);
    let r2 = "ab".repeat_in(3usize, gpa);
    println("{r} {r2}");
    let mut s = String::new_in(gpa);
    s.push_str("hello");
    s.push(char::from_u32(' ' as u32).unwrap());
    s.push(char::from_u32(0x4e16u32).unwrap());
    std::fmt::write(&mut s, " {}!", v + 1).unwrap();
    std::fmt::write(&mut s, " [{v}]").unwrap();
    println("{s} {} {} {}", s.len(), count_words(s), s.trim_end_matches(b']'));
    let p = s.pop().map(|c| c as u32);
    println("{p:?} {s:?}");
    let t = format_in("{}", format_args("{v}-{v}"), gpa);
    let t2 = t.as_str() == "42-42";
    println("{t} {} {t2}", t == s);
    let mut chars_rev = String::new_in(gpa);
    for c in "abç".chars().map(|c| c as u32).rev() {
        chars_rev.push(char::from_u32(c).unwrap());
    }
    let w = "日本語".width() as i64;
    let g = "e\u{301}x".graphemes(true).count();
    println("{chars_rev} {w} {g}");
    for (i, c) in "aé".char_indices().map(|(i, c)| (i, c as u32)) {
        print("{i}:{c},");
    }
    println("");
    let bytes = s.as_bytes();
    let back = str::from_utf8(bytes);
    let bad: &str = "\xff\xfe";
    let lossy = String::from_utf8_lossy_in(bad, gpa);
    let bad2 = str::from_utf8(bad);
    println("{back:?} {bad2:?} {lossy}");
    let mut buf = Vec::<u8, _>::new_in(gpa);
    buf.extend_from_slice(b"from buf");
    let sb = String::from_utf8(buf);
    println("{sb:?}");
    let ws: Vec<&str, Gpa> = " x  y\tz ".split_whitespace().collect_in(gpa);
    let m = "aXbXc".matches('X').count();
    let q = "Hello".eq_ignore_ascii_case("hELLO");
    println("{ws:?} {m} {q}");
    Ok(())
}
