// RULE: F8.4, D21.3
// `Debug::fmt(&self.0, f)` in an instance whose T is an `impl Debug`, and `{:?}` of one (rustc `5 5`).
// From the gate suite of 0.30.2 (rt_211_through_program_fn_err): an `impl Tr` result has no impl of its own; a trait its bounds entail gives the hidden type's item to a path (qualified::impl_self), as its methods are the hidden type's. The g302qual merge refused it ("'impl Debug' has no impl of 'Debug' that gives 'fmt'"); v0.30.1 and the release before it print rustc's lines.
// EXPECT: 5 5
use std::fmt;
use std::fmt::Debug;

struct W<T>(T);

impl<T: Debug> fmt::Display for W<T> {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        Debug::fmt(&self.0, f)
    }
}

fn mk() -> impl Debug {
    5i64
}

fn main() {
    let w = W(mk());
    println("{} {:?}", w, mk());
}
