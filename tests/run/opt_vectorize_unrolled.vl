// EDITION: rust
// XFAIL: gap 25: the IR, asm or places CHECK lines no longer match the translation (std2's names, the surface): to update by...
// 0.11, the vectorizer's cost model against full unrolling
// EXPECT: 1184 5049
// A copy of 10 elements (bench/fannkuch's) is not made a vector loop (an
// overlap test, here of two arrays on the stack, five vector iterations
// and a scalar fallback): it is unrolled whole, the copies keep a load
// and a store each, and SLP packs them into five vector copies. A copy
// of 100 elements is still a vector loop.
// CHECK: fn copy10:
// CHECK-NOT: cmp.le
// CHECK: v2i64 = load
// CHECK: v2i64 = load
// CHECK: v2i64 = load
// CHECK: v2i64 = load
// CHECK: v2i64 = load
// CHECK-NOT: v2i64 = load
// CHECK-NOT: cmp.le
// CHECK: fn copy100:
// CHECK: v2i64 = load
// CHECK: fn main:
extern "C" {
    fn printf(f: *mut u8, ...) -> i32;
}

// (Its checks, which the ranges remove after the unroller has run, keep
// the unroller from it at first.)
#[inline(never)]
fn copy10(k: i64) -> i64 {
    let mut a: [i64; 16] = [0i64; 16];
    let mut b: [i64; 16] = [0i64; 16];
    a[(k & 15) as usize] = k;
    for i in 0..10 {
        b[i as usize] = a[i as usize];
    }
    b[(k % 10) as usize] + b[9]
}

#[inline(never)]
fn copy100(k: i64) -> i64 {
    let mut a: [i64; 100] = [0i64; 100];
    let mut b: [i64; 100] = [0i64; 100];
    a[(k % 100) as usize] = k;
    for i in 0..100 {
        b[i as usize] = a[i as usize];
    }
    b[(k % 100) as usize] + b[99]
}

fn main() -> i32 {
    let mut s1: i64 = 0;
    let mut s2: i64 = 0;
    for k in 0..100 {
        s1 += copy10(k);
        s2 += copy100(k);
    }
    unsafe { printf(c"%ld %ld\n", s1, s2); }
    0
}
