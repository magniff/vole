// EDITION: rust
// (0.25) A static lent to a callee that does not reach it by name, or
// passed as a copy (a plain let), is fine; one static lent while the
// callee changes another is fine too.
static mut G: i64 = 1;
static mut H: i64 = 10;
fn bump(x: &mut i64) { *x += 1; }
fn seth(x: &mut i64) -> i64 { *x += 1; unsafe { H = 20; } *x }
fn copy_then_write(x: i64) -> i64 { unsafe { G = 7; } x }

fn main() {
    bump(unsafe { &mut (*(&raw mut G)) });
    let a = seth(unsafe { &mut (*(&raw mut G)) });
    let b = copy_then_write(unsafe { G });
    let g_now = unsafe { G }; let h_now = unsafe { H }; println("{g_now} {h_now} {a} {b}");
}
// EXPECT: 7 20 3 3
