use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;

static C: AtomicI64 = AtomicI64::new(0i64);

#[pure]
fn tick() -> i64 { C.fetch_add(1, Ordering::Relaxed) }

fn need(a: &AtomicI64)
    requires a.load(Ordering::Relaxed) > 0
{
    a.store(2, Ordering::Relaxed);
}

fn main() {
    let a = AtomicI64::new(1i64);
    need(&a);
    println("{}", tick());
}
