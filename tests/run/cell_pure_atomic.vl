// (0.26.1) An atomic holds an UnsafeCell: a #[pure] function that changes
// or reads one is refused (it was allowed through 0.26.0), and so is a
// contract condition that loads one.
// ERROR: [effect]: 'tick' is #[pure], but it writes through a shared reference (a cell, interior): 'C.fetch_add(1, Ordering::Relaxed)'
// ERROR: try: volec query effects tick --why interior
// ERROR: [contract.effect]: the 'requires' of 'need' calls 'Atomic<i64>::load', which writes through a shared reference (a cell)
use std::sync::atomic::{AtomicI64, Ordering};

static C: AtomicI64 = AtomicI64::new(0);

#[pure]
fn tick() -> i64 { C.fetch_add(1, Ordering::Relaxed) }

fn need(a: AtomicI64)
    requires a.load(Ordering::Relaxed) > 0
{
    a.store(2, Ordering::Relaxed);
}

fn main() {
    let a = AtomicI64::new(1);
    need(a);
    println("{}", tick());
}
