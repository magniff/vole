// EDITION: rust
// (0.25) A Vec of structs with an inout field moves, and its element is
// not copied out: own.move_out.
struct C<'a> { n: &'a mut i64 }

fn main(gpa: Gpa) {
    let mut x: i64 = 1; let mut v: Vec<C<'_>, Gpa> = Vec::new_in(gpa); v.push(C { n: &mut x });
    let mut c = v[0]; *c.n += 1;
    println("{x}");
}
