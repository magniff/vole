// EDITION: rust
// RULE: F18.2
// std2's own bodies say the type a `let` cannot infer (F18.2: no deferred
// inference): Box::new_in through try_new_in (`NonNull::dangling()` in an
// `if`), String::from_in through Vec::with_capacity_in.
// EXPECT: 5 hey 4
fn main(gpa: Gpa) {
    let b = Box::new_in(5i32, gpa);
    let s = String::from_in("hey", gpa);
    let v: Vec<i32, Gpa> = Vec::with_capacity_in(4, gpa);
    println("{} {} {}", *b, s, v.capacity());
}
