// FLAGS: --check-unsafe
// EXIT: 101
// EXPECT: box 5, string 3
// STDERR: unsafe access after free: 1 bytes at offset 1 of a block of
// STDERR: check_unsafe_gpa_string_box.vl: line 22, column 22
// 0.30.1: a String's and a Box's memory are Gpa's, which --check-unsafe
// alone now knows: a use after free through a String's pointer stops.
fn main(gpa: Gpa) {
    let b: Box<i64, Gpa> = Box::new_in(5, gpa);
    let bp: *const i64 = &*b as *const i64;
    // UNSAFE: a read through the Box's pointer while it lives.
    // SAFETY: the Box is alive.
    let five = unsafe { *bp };
    let mut s = String::new_in(gpa);
    s.push_str("abc");
    println("box {five}, string {}", s.len());
    let p: *const u8 = s.as_ptr();
    drop(s);
    drop(b);
    // UNSAFE: a deliberate use after free, to test --check-unsafe.
    // SAFETY: none: this program exists to be stopped.
    let x = unsafe { *p.add(1) };
    println("read {x}");
}
