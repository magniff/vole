// RT-368 (closed in 0.30.2): (RT-299's forms) a key fn item whose result borrows its argument is accepted by Vec::dedup_by_key (`fn kd<'a>(x: &'a mut i64) -> &'a i64`) and Iterator::max_by_key / min_by_key (`fn kk<'a, 'b>(x: &'a &'b i64) -> &'a i64`) (0.30.2)
// rustc E0308 at each call (twin .rs.txt): one type is more general than
// the other (the key's type K cannot name the call's lifetime). vole
// checks it clean and prints `[1, 2] Some(2) Some(1)`; v0.28.0 to
// v0.30.1 the same. No use after free is reachable through these three
// (the keys are compared and dropped inside std); RT-299 has
// sort_by_key and sort_unstable_by_key.
// ERROR: line 25
// ERROR: line 26
// ERROR: line 27
// ERROR-COUNT: 3
fn kd<'a>(x: &'a mut i64) -> &'a i64 {
    x
}

fn kk<'a, 'b>(x: &'a &'b i64) -> &'a i64 {
    *x
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(1);
    v.push(2);
    v.dedup_by_key(kd);
    let a = v.iter().max_by_key(kk);
    let b = v.iter().min_by_key(kk);
    println("{:?} {:?} {:?}", v, a, b);
}
