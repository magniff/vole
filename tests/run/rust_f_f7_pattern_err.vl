// EDITION: rust
// RULE: F7.2
// A tuple struct's pattern has one sub-pattern per field, and only a
// tuple struct is matched by position (rustc E0023, E0769); its type is
// the matched value's.
// ERROR: 'Point' has named fields: match them by name
// ERROR: 'Pair' has 2 fields, the pattern has 1
// ERROR: expected 'Point', got 'Pair'
struct Point {
    x: i64,
    y: i64,
}

struct Pair(i64, i64);

fn k(p: Point) -> i64 {
    let Point(a, b) = p;
    a + b
}

fn m(q: Pair) -> i64 {
    let Pair(a) = q;
    a
}

fn o() -> i64 {
    let Pair(a, b) = Point { x: 1, y: 2 };
    a + b
}

fn main() -> i64 {
    k(Point { x: 1, y: 2 }) + m(Pair(1, 2)) + o()
}
