// A field of a #[repr(C, packed)] struct may be unaligned, and so would
// be a reference to it; rustc refuses `&p.x` there (E0793, reference to
// packed field is unaligned). Until 0.30.1 vole accepted it, and an atomic
// operation through such a reference, here one that straddles 16 bytes,
// stopped the program with SIGBUS (exit 138); borrowck.packed_ref, D2.10.
// ERROR: error[borrowck.packed_ref]
// ERROR: line 20, column 29
// ERROR-COUNT: 1
use std::sync::atomic::{AtomicI64, Ordering};

#[repr(C, packed)]
struct P {
    pad: [u8; 61],
    x: AtomicI64,
}

fn bump(v: &Vec<P, Gpa>) -> i64 {
    let mut s = 0;
    for i in 0..v.len() {
        let r: &AtomicI64 = &v[i].x;
        r.fetch_add(1, Ordering::SeqCst);
        s += r.load(Ordering::SeqCst);
    }
    s
}

fn main(gpa: Gpa) {
    let mut v: Vec<P, Gpa> = Vec::new_in(gpa);
    for _ in 0..16 {
        v.push(P { pad: [0; 61], x: AtomicI64::new(5) });
    }
    println("{}", bump(&v));
}
