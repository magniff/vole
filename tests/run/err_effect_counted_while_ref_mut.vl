// RULE: E2.1 (0.30.1, RT-20) A counted `while` keeps its proof only when
// nothing else writes its variable: a `ref mut` binding of it in an `if
// let`, a `match` whose value outlives it, a `let` or a pattern's part,
// and a raw borrow of it (`&raw const`, then written through a cast),
// are writes, and each loop here never ends for n > 0: `diverge`, which
// #[effects()] refuses. (rt_020_ref_mut_pattern_effects.vl is the
// `match` form; the copy of w5 is no write of i: it holds.)
// ERROR: 'w1' is #[effects()], but it may not terminate
// ERROR: 'w2' is #[effects()], but it may not terminate
// ERROR: 'w3' is #[effects()], but it may not terminate
// ERROR: 'w4' is #[effects(unsafe)], but it may not terminate
// ERROR: 'w6' is #[effects()], but it may not terminate
// ERROR-COUNT: 5
#[effects()]
fn w1(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        if let ref mut r = i {
            *r = 0;
        }
        i += 1;
    }
    i
}

#[effects()]
fn w2(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let r = match i {
            ref mut r => r,
        };
        *r = 0;
        i += 1;
    }
    i
}

#[effects()]
fn w3(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let mut t = (1i64, 2i64);
        let r = match t {
            (ref mut a, _) if *a > 5 => a,
            _ => match i {
                ref mut b => b,
            },
        };
        *r = 0;
        i += 1;
    }
    i
}

#[effects(unsafe)]
fn w4(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let p = &raw const i;
        // UNSAFE: the test of a raw borrow's write, which the loop's proof must see
        // SAFETY: p is i's address, i is a live mutable local, no reference to it is held
        unsafe {
            *(p as *mut i64) = 0;
        }
        i += 1;
    }
    i
}

#[effects()]
fn w5(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let mut t = (i, 1);
        let (ref mut a, _) = t;
        *a = 0;
        i += 1;
    }
    i
}

#[effects()]
fn w6(n: i64) -> i64 {
    let mut i = 0;
    while i < n {
        let mut z = (0, 0);
        let (ref mut a, _) = z;
        *a = 1;
        let ref mut r = i;
        *r = 0;
        i += 1;
    }
    i
}

fn main() {
    println("{} {} {} {} {} {}", w1(0), w2(0), w3(0), w4(0), w5(3), w6(0));
}
