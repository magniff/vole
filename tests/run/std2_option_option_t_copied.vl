// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option<&T>::copied.
// EXPECT: Some(3) None
use std::option::Option;

fn main() {
    let x = 3;
    let a: Option<&i64> = Some(&x);
    let b: Option<&i64> = None;
    let c: Option<i64> = a.copied();
    println("{:?} {:?}", c, b.copied());
}
