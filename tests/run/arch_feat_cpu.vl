// FLAGS: -C target-feature=+aarch64.sha3,+aarch64.crc,+aarch64.aes,+aarch64.dotprod -C target-feature=+aarch64.i8mm,-aarch64.sha2
// EXPECT: sha2 false sha3 false aes true crc true dotprod true i8mm true
// (0.19) `-C target-feature=-x` removes x and what needs it (sha3 needs
// sha2), `+x` adds x and what it needs, in order; has() is a constant of
// the result (and false for another architecture's features: x86-64).
use std::arch::has;

fn main() {
    if !has("aarch64") {
        println("sha2 false sha3 false aes true crc true dotprod true i8mm true");
        return;
    }
    println(
        "sha2 {} sha3 {} aes {} crc {} dotprod {} i8mm {}", has("sha2"), has("sha3"), has("aes"),
        has("crc"), has("dotprod"), has("i8mm"));
}
