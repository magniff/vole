// XFAIL: RT-151: --check-unsafe does not check a deref through a raw slice pointer: a use after free through `*const [T]` reads freed memory and exits 0 (0.30.2)
// From g302raw (pre-existing, v0.30.1 too): is_raw_pointer is Ptr-only.
// The same access through a thin `*const i64` stops with "unsafe access
// after free" (exit 101).
// RUSTC-DIFFERS: --check-unsafe is vole's own run-time check; rustc runs the read as undefined behaviour
// FLAGS: --check-unsafe
// EXIT: 101
fn fat(gpa: Gpa) -> i64 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let p: *const [i64] = &v[..] as *const [i64];
    drop(v);
    // UNSAFE: the case: a read through a raw slice after its block is freed
    // SAFETY: none: --check-unsafe must stop it before the read
    unsafe { (*p)[0] }
}

fn main(gpa: Gpa) {
    println("{}", fat(gpa));
}
