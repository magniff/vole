// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::thread Result.
// EXPECT: Ok(3) true
use std::thread;
use std::mem::swap;

fn run() -> thread::Result<i64> {
    thread::scope(|s| s.spawn(|| 3i64).join())
}

fn main() {
    let r = run();
    println("{:?} {}", r, r.is_ok());
}
