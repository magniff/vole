// RULE: D8.5
// (0.30.1) `?` binds its operand to a hidden `?try` and matches it: `v.last()?`
// gives `&i64` borrowing `*v`, so the push while x is live is E0502
// (vole's conflict), as rustc.
// ERROR: error[borrowck.conflict]
// ERROR: line 10, column 5
// ERROR-COUNT: 1
fn f(v: &mut Vec<i64, Gpa>) -> Option<i64> {
    let x = v.last()?;
    v.push(1);
    Some(*x)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    println("{:?}", f(&mut v));
}
