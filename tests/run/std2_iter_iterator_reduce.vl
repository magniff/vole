// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter Iterator::reduce.
// EXPECT: Some(24) None

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2, 3, 4], gpa);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    println("{:?} {:?}", v.iter().copied().reduce(|a, b| a * b),
        e.iter().copied().reduce(|a, b| a * b));
}
