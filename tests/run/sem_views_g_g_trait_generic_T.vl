// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) own.conflict: a view of s's text kept through `b.g()`; s grows while it is used
// ERROR: borrowck.move_out
use std::alloc::Allocator; trait G<T> { fn g(&self) -> T; }
struct B<T, A: Allocator> { items: Vec<T, A> }
impl<T, A: Allocator> G<T> for B<T, A> { fn g(&self) -> T { self.items[0usize] } }

fn main(gpa: Gpa) -> i32 {
    let mut s = String::from_in("hello world", gpa);
    let w = s.as_str();
    let mut v: Vec<&str, Gpa> = Vec::new_in(gpa); v.push(w); let b = B { items: v };
    let r = b.g();
    s.push_str("XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX");
    println("{}", r);
    0
}
