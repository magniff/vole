// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Inspect::impl Iterator.
// EXPECT: saw 1
// EXPECT: Some(1)
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64], gpa);
    let mut it = s.iter().copied().inspect(|x| println("saw {}", x));
    let a = it.next();
    println("{:?}", a);
}
