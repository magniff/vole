// RULE: Z9.6
// (0.27.2) `&*p` of a fat raw pointer is a reference of a fresh region
// (D3.8): returned as `&'a [u8]`, no outlives error.
fn view<'a>(p: *const [u8]) -> &'a [u8] {
    // SAFETY: the callers pass a live slice.
    unsafe { &*p }
}

fn main() {
    let b = [1u8, 2, 3];
    let p = &b[..] as *const [u8];
    println("{}", view(p).len());
}
// EXPECT: 3
