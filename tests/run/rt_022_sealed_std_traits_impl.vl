// std says of each "Sealed: std's impls only" (Rust: Pattern and Step are
// unstable, E0658; SliceIndex is sealed), and std's code relies on it:
// a Pattern's match is sliced without a char-boundary check (RT-21), so
// `s.find(Liar)` is Some(1) inside "\u{e9}" and `s.split(Liar)` yields
// the strs [C3] and [A9 74]; a Range of a Step type is counted as ending
// (front/check/iterate.vl ends_by_itself), so a `for` over a Range<M>
// whose forward_checked never advances has no `diverge`, and -O2 deletes
// the call that never returns (the red team's probe cw/st2.vl: -O0
// hangs, -O2 returns). Each impl should be refused.
// ERROR: line 22, column 1
// ERROR: line 38, column 1
// ERROR: line 54, column 1
// ERROR-COUNT: 3
use std::iter::Step;
use std::slice::SliceIndex;
use std::str::Pattern;

struct Liar {
    n: usize,
}

impl Pattern for Liar {
    fn next_match(&mut self, _hay: &str, _start: usize) -> Option<(usize, usize)> {
        self.n += 1;
        if self.n > 1 { None } else { Some((1, 2)) }
    }

    fn next_match_back(&mut self, _hay: &str, _end: usize) -> Option<(usize, usize)> {
        None
    }
}

#[derive(Clone, PartialEq, PartialOrd)]
struct M {
    v: i64,
}

impl Step for M {
    fn steps_between(_start: &M, _end: &M) -> (usize, Option<usize>) {
        (0, None)
    }

    fn forward_checked(start: M, _count: usize) -> Option<M> {
        Some(start)
    }

    fn backward_checked(start: M, _count: usize) -> Option<M> {
        Some(start)
    }
}

struct Mid;

impl SliceIndex<str> for Mid {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        Some(s.split_at(1).1)
    }

    fn get_mut(self, _s: &mut str) -> Option<&mut str> {
        None
    }

    fn index(self, s: &str) -> &str {
        s.split_at(1).1
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        s
    }
}

fn main() {
    let s = "\u{e9}t";
    println("{:?}", s.find(Liar { n: 0 }));
    let mut k = 0;
    for _m in (std::ops::Range { start: M { v: 0 }, end: M { v: 0 } }) {
        k += 1;
    }
    println("{k} {:?}", s.get(Mid).map(|p| p.as_bytes()));
}
