// RT-408, fixed in 0.30.2 (obligations M2, the review's fixes).
// From the review of g302oblig M2 (that branch raises the limit). Since v0.30.1 at least.
// EXPECT: 127
trait Tr { type Out; fn d(&self) -> i64; }
struct W<T> { t: T }
impl Tr for i64 { type Out = i64; fn d(&self) -> i64 { 0 } }
impl<T: Tr> Tr for W<T> { type Out = T::Out; fn d(&self) -> i64 { 1 + self.t.d() } }
fn go<T: Tr<Out = i64>>(t: &T) -> i64 { t.d() }

fn main() {
    let w = W {
        t: W {
            t: W {
                t: W {
                    t: W {
                        t: W {
                            t: W {
                                t: W {
