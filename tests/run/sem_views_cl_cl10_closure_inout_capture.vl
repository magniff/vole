fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut add = |x: i64| v.push(x);
    let sl = v.as_slice();
    for i in 0..100 { add(i); }
    println("{}", sl[0]);
    0
}
