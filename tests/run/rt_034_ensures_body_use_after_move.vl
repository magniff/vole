// RT-34: the body of a function with an `ensures` is `f$body`, which was
// lowered under MVS's operand rules (a read of a place is a copy), so the
// borrow checker saw no move and accepted a use after one; rustc gives
// E0382. Checked as itself, it is refused where the same body without
// the clause is.
// ERROR: error[borrowck.use_moved]: 'v' is used here after it moved
// ERROR: line 20, column 14
// ERROR-COUNT: 1
fn take(v: Vec<i64, Gpa>) -> usize {
    v.len()
}

fn twice(v: Vec<i64, Gpa>) -> usize
    ensures result > 0
{
    let mut n: usize = 0;
    for _x in v {
        n += 1;
    }
    n + take(v)
}

fn main(gpa: Gpa) {
    println("{}", twice(Vec::from_in([1i64, 2], gpa)));
}
