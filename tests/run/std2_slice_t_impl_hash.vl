// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::impl Hash.
// EXPECT: true false
use std::hash::{BuildHasher, FixedState};

fn h(s: &[i64]) -> u64 {
    FixedState::new().hash_one(s)
}

fn main() {
    println("{} {}", h(&[1, 2]) == h(&[1, 2]), h(&[1, 2]) == h(&[2, 1]));
}
