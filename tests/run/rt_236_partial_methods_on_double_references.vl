// XFAIL: RT-236: a PartialOrd or PartialEq method called on a `&&T` with a `&&T` argument (`a.partial_cmp(b)` in `f.iter().max_by(|a, b| ..)`, `x.eq(&&1)`, `x.lt(y)`) is refused, "no impl of 'f64::partial_cmp' takes arguments (&&f64)": the probe takes T's impl, not &T's (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). `a.cmp(b)` (Ord, no Rhs parameter) on the same receivers works.
// EXPECT: Some(2.5) [2.0, -1.0] 1 2 (Some(Greater), false, false, true)
#[derive(Debug, PartialEq, Eq, PartialOrd, Ord)]
struct W {
    k: i64,
}

fn by_ref(x: &&W, y: &&W) -> (Option<std::cmp::Ordering>, bool, bool, bool) {
    (x.partial_cmp(y), x.lt(y), x.eq(y), x.ne(y))
}

fn main(gpa: Gpa) {
    let f = [1.5f64, 0.5, 2.5];
    let m = f.iter().max_by(|a, b| a.partial_cmp(b).unwrap());
    let mut g: Vec<f64, Gpa> = Vec::new_in(gpa);
    g.push(2.0);
    g.push(-1.0);
    let mut r: Vec<&f64, Gpa> = g.iter().collect_in(gpa);
    r.sort_by(|a, b| b.partial_cmp(a).unwrap());
    let n = [3i64, 1, 2];
    let ones = n.iter().filter(|x| x.eq(&&1i64)).count();
    let small = n.iter().filter(|x| x.lt(&&3i64)).count();
    let a = W { k: 2 };
    let b = W { k: 1 };
    println("{:?} {:?} {} {} {:?}", m, r, ones, small, by_ref(&&a, &&b));
}
