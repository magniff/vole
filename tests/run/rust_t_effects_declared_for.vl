// EDITION: rust
// RULE: E3.1a
// (0.28.0, gap 97) A declared function with a `for` in it is checked
// against what the loop does, as `query effects` prints it: over a slice
// (`for &x in xs`, `for x in xs`, the slice's iterator and its
// adapters), a Vec, a range, a str's chars. A std function with a list
// allows a cell's write and does none: a `#[pure]` function over a slice
// was refused for a write its iterator does not do (an undeclared std
// function over a listed one carried the list's allowance)
// (tests/query/declfor028 has the sets).
// EXPECT:  2 3 4 5
// EXPECT: 5.25 10 10 10 14 14
// EXPECT: 10 15 20 30 6 20 4321 20 2
#[pure]
fn mean(xs: &[f64]) -> f64 {
    let mut total = 0.0;
    for &x in xs {
        total += x;
    }
    total / xs.len() as f64
}

#[pure]
fn sum_ref(xs: &[i64]) -> i64 {
    let mut t = 0;
    for x in xs {
        t += *x;
    }
    t
}

#[effects()]
fn sum_copied(xs: &[i64]) -> i64 {
    let mut t = 0;
    for x in xs.iter().copied() {
        t += x;
    }
    t
}

#[no_alloc]
#[no_io]
fn sum_index(xs: &[i64]) -> i64 {
    let mut t = 0;
    for i in 0..xs.len() {
        t += xs[i];
    }
    t
}

#[pure]
fn sum_vec(v: &Vec<i64, Gpa>) -> i64 {
    let mut t = 0;
    for x in v {
        t += *x;
    }
    t
}

#[no_alloc]
fn sum_vec_iter(v: &Vec<i64, Gpa>) -> i64 {
    let mut t = 0;
    for x in v.iter() {
        t += *x;
    }
    t
}

#[effects(panic)]
fn bump(v: &mut Vec<i64, Gpa>) {
    for x in v.iter_mut() {
        *x += 1;
    }
}

#[pure]
fn tri(n: i64) -> i64 {
    let mut t = 0;
    for i in 0..n {
        t += i;
    }
    t
}

#[effects()]
fn tri_incl(n: i64) -> i64 {
    let mut t = 0;
    for i in 1..=n {
        t += i;
    }
    t
}

#[pure]
fn weighted(xs: &[i64]) -> i64 {
    let mut t = 0;
    for (i, x) in xs.iter().enumerate() {
        t += i as i64 * *x;
    }
    t
}

#[no_io]
fn dot(a: &[i64], b: &[i64]) -> i64 {
    let mut t = 0;
    for (x, y) in a.iter().zip(b.iter()) {
        t += *x * *y;
    }
    t
}

#[pure]
fn evens(xs: &[i64]) -> i64 {
    let mut t = 0;
    for x in xs.iter().filter(|x| **x % 2 == 0) {
        t += *x;
    }
    t
}

#[effects()]
fn doubled(xs: &[i64]) -> i64 {
    let mut t = 0;
    for x in xs.iter().map(|x| *x * 2) {
        t += x;
    }
    t
}

#[pure]
fn back(xs: &[i64]) -> i64 {
    let mut t = 0;
    for x in xs.iter().rev() {
        t = t * 10 + *x;
    }
    t
}

#[effects(panic)]
fn pairs(xs: &[i64]) -> i64 {
    let mut t = 0;
    for w in xs.windows(2) {
        t += w[0] * w[1];
    }
    t
}

#[no_alloc]
#[no_io]
fn letters(s: &str) -> i64 {
    let mut n = 0;
    for c in s.chars() {
        if c.is_alphabetic() {
            n += 1;
        }
    }
    n
}

#[no_alloc]
fn show(xs: &[i64]) {
    for x in xs {
        print(" {}", *x);
    }
    println("");
}

#[no_io]
fn collect(xs: &[i64], out: &mut Vec<i64, Gpa>) {
    for x in xs {
        out.push(*x);
    }
}

fn main(gpa: Gpa) {
    let a = [1i64, 2, 3, 4];
    let f = [1.0, 9.5];
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    collect(&a, &mut v);
    bump(&mut v);
    show(&v);
    println("{} {} {} {} {} {}", mean(&f), sum_ref(&a), sum_copied(&a), sum_index(&a),
        sum_vec(&v), sum_vec_iter(&v));
    println("{} {} {} {} {} {} {} {} {}", tri(5), tri_incl(5), weighted(&a), dot(&a, &a),
        evens(&a), doubled(&a), back(&a), pairs(&a), letters("a1b2"));
}
