// (0.21) The scope's closure may not change what its threads may read.
// ERROR: error[borrowck.conflict]
// ERROR: line 12, column 9

use std::thread;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let n = thread::scope(|s| ({ let s = s; {
        let h = s.spawn(|| v.len());
        v.push(2);
        h.join().unwrap()
    } }));
    println("{n}");
}
