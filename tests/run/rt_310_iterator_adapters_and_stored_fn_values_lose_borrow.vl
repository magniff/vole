// RT-310 (closed in 0.30.2): UNSOUND: (RT-297's root, iterators and stored fn values) a fn item whose result borrows its argument, given to Iterator::scan, find_map, map_while, fold, a program's `impl<I: Iterator, B, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F>`, or kept in a generic struct's field or a Vec and then given to Option::map, keeps no borrow: a use after free (0.30.2)
// rustc E0505 at each drop (twin .rs.txt). Each form alone (scratch
// r302g/fn/p: f14, f17b, f18-f22) checks clean, and --check-alloc stops
// with `use after free: block #1 (32 bytes)`. The closure forms
// (`scan(0, |st, x| sc(st, x))`, `find_map(|x| idr(x))`) and the direct
// calls `(h.f)(&v[0])`, `fs[0](&v[0])` keep the borrow (scratch fn/c).
// Iterator::map, filter_map and flat_map with a fn item cannot show it:
// RT-298 refuses them inside std.
// FLAGS: --check-alloc
// ERROR: line 65
// ERROR: line 68
// ERROR: line 71
// ERROR: line 74
// ERROR: line 78
// ERROR: line 82
// ERROR: line 87
// ERROR-COUNT: 7
fn idr<'a>(x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn sc<'a>(st: &mut i64, x: &'a i64) -> Option<&'a i64> {
    *st += 1;
    Some(x)
}

fn pick<'a>(_b: Option<&'a i64>, x: &'a i64) -> Option<&'a i64> {
    Some(x)
}

struct H<F> {
    f: F,
}

struct MyMap<I, F> {
    it: I,
    f: F,
}

impl<I: Iterator, B, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.it.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn mkv(k: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(k);
    v
}

fn main(gpa: Gpa) {
    let z = 7i64;
    let v1 = mkv(1, gpa);
    let a1: Vec<&i64, Gpa> = v1.iter().scan(0i64, sc).collect_in(gpa);
    drop(v1);
    let v2 = mkv(2, gpa);
    let a2 = v2.iter().find_map(idr);
    drop(v2);
    let v3 = mkv(3, gpa);
    let a3: Vec<&i64, Gpa> = v3.iter().map_while(idr).collect_in(gpa);
    drop(v3);
    let v4 = mkv(4, gpa);
    let a4 = v4.iter().fold(Some(&z), pick);
    drop(v4);
    let v5 = mkv(5, gpa);
    let mut m = MyMap { it: v5.iter(), f: idr2 };
    let a5 = m.next();
    drop(v5);
    let v6 = mkv(6, gpa);
    let h = H { f: idr2 };
    let a6 = v6.first().map(h.f);
    drop(v6);
    let v7 = mkv(7, gpa);
    let mut fs: Vec<fn(&i64) -> &i64, Gpa> = Vec::new_in(gpa);
    fs.push(idr2);
    let a7 = v7.first().map(fs[0]);
    drop(v7);
    println("{:?} {:?} {:?} {:?} {:?} {:?} {:?}", a1, a2, a3, a4, a5, a6, a7);
}
