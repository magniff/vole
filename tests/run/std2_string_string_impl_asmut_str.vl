// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string String::impl AsMut<str>.
// EXPECT: AB
use std::string::ToStringIn;

fn up<S: AsMut<str>>(s: &mut S) {
    s.as_mut().make_ascii_uppercase();
}

fn main(gpa: Gpa) {
    let mut s = String::from_in("ab", gpa);
    up(&mut s);
    println("{}", s);
}
