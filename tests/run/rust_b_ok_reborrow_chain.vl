// EDITION: rust
// RULE: D2.3
// (0.27.1) `r = q` where `q = &mut *r`: the write to `r` kills the loans of
// `*r` (D2.3 through a deref), the chain stays linear (I3').

fn main() {
    let mut x: i64 = 1;
    let mut r = &mut x;
    let mut i = 0;
    while i < 3 {
        let q = &mut *r;
        *q += 1;
        r = q;
        i += 1;
    }
    *r += 1;
    println("{}", x);
}
// EXPECT: 5
