// RULE: F8.3, F8.4
// RT-C301-8 review (R4, form f58f_blanket_default_value_only): `let f = Self::mk;` in such a default.
// rustc prints the EXPECT lines.
// EXPECT: 10
trait Base { fn base(&self) -> i64; }
trait A { fn mk() -> i64; fn show(&self) -> i64 { let f = Self::mk; f() * 10 } }
impl<T: Base> A for T { fn mk() -> i64 { 1 } }
struct S;
impl Base for S { fn base(&self) -> i64 { 10 } }
fn main() { println("{}", S.show()); }
