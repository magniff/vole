// a trait with a default, implemented for Vec<T> generically; sink self drops the Vec once
// FLAGS: --check-alloc
// EXPECT: 4 2
// (0.26.3: the impl names Vec's allocator parameter, as every type does)
trait Sz {
    fn n(self) -> i64;
    fn twice(self) -> i64 { self.n() * 2 }
    fn done(sink self) -> i64 { self.n() }
}

impl<T, A: Allocator> Sz for Vec<T, A> { fn n(self) -> i64 { self.len() as i64 } }

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1); v.push(2);
    println("{} {}", v.twice(), v.done());
}
