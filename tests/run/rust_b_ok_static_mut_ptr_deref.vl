// RULE: D6.2.5
// (0.27.7) A reference through the pointer a `static mut` holds is the
// pointee's, not the static's: `&mut *P` of a `static mut P: *mut T`,
// `&mut *S.1` of a field that is one, `(*Q).add()` (an autoref through
// it) read the static's value and borrow what it points to, as rustc's
// static_mut_refs allows. 0.27.6 refused each as borrowck.static_mut_ref
// (the flip rehearsal's `assemble_bytes(&mut *A_CTX, ..)`).
// EXPECT: 2 3 8
static mut P: *mut i32 = 0 as *mut i32;
static mut S: (i32, *mut i32) = (0, 0 as *mut i32);
static mut Q: *mut Pt = 0 as *mut Pt;

struct Pt {
    x: i32,
}

impl Pt {
    fn add(&mut self) {
        self.x += 1;
    }
}

fn bump(x: &mut i32) {
    *x += 1;
}

fn main() {
    let mut v = 1;
    let mut w = 2;
    let mut pt = Pt { x: 7 };
    // UNSAFE: the case is about references through a static mut's pointer.
    // SAFETY: P, S.1 and Q point at v, w and pt, live for the block, and no
    // other reference to them is used while these are.
    unsafe {
        P = &raw mut v;
        bump(&mut *P);
        S.1 = &raw mut w;
        bump(&mut *S.1);
        Q = &raw mut pt;
        (*Q).add();
    }
    println("{} {} {}", v, w, pt.x);
}
