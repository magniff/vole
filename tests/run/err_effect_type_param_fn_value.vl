// RULE: E3.3c (0.30.1) A fn value called in a callee generic over a
// listed T passes the declaration only when it is T's own (the listed
// parameter, or a value whose type names it): `via(x, boom, n)` calls
// boom, no method of T. Before, `#[effects(T)]` let boom's panic through
// where `#[effects()]` on the same code was refused. The fn value made
// for F, `#[effects(F)]` over a closure, still passes (apply below; its
// closure's type is no fn pointer's here: a call through `&F` reaches
// every function of its type whose address is taken, E4.3, boom too).
// ERROR: 'user' is #[effects(T)], but it may panic: 'via(x, boom, n)' at
// ERROR: 'user_deep' is #[effects(T)], but it may panic: 'outer(x, n)' at
// ERROR-COUNT: 2

fn boom(n: usize) -> usize {
    10 / n
}

fn via<T>(x: &T, f: fn(usize) -> usize, n: usize) -> usize {
    let _ = x;
    f(n)
}

fn outer<T>(x: &T, n: usize) -> usize {
    via(x, boom, n)
}

#[effects(T)]
fn user<T>(x: &T, n: usize) -> usize {
    via(x, boom, n)
}

#[effects(T)]
fn user_deep<T>(x: &T, n: usize) -> usize {
    outer(x, n)
}

fn call_it<F: Fn(u32) -> u32>(f: &F, n: u32) -> u32 {
    f(n)
}

#[effects(F)]
fn apply<F: Fn(u32) -> u32>(f: &F, n: u32) -> u32 {
    call_it(f, n)
}

fn main() {
    println("{}", user(&1u8, 1));
    println("{}", user_deep(&1u8, 1));
    println("{}", apply(&|n: u32| 10 / n, 2));
}
