// RULE: E1.8 (0.30.1) A format argument whose value holds a borrow of a
// proven local takes the proof away when what formats it may make a raw
// pointer of it: the hole's own borrow is only read through (its value
// copied, places::build::settle_loans), but the copy holds the borrow,
// and it goes on to the formatting calls. Here a Display impl writes 0
// through the reference it is shown, so each loop would never end:
// through a struct holding `&i` (an aggregate, rule 4: the function's set
// has `addr`), bound first or in the hole, and through an alias of i in
// the hole (`let r = &i;`, `{r}`) given on to a callee that makes a
// pointer of it. (effect_format_arg_kept is what keeps the proof.)
// ERROR: 'shown' is #[effects(io, static, panic, unsafe)], but it may not terminate
// ERROR: 'bound' is #[effects(io, static, panic, unsafe)], but it may not terminate
// ERROR: 'aliased' is #[effects(io, static, panic, unsafe)], but it may not terminate
// ERROR-COUNT: 3

use std::fmt::Display;
use std::fmt::Formatter as Fmt;

struct Show<'a> {
    r: &'a i64,
}

impl Display for Show<'_> {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        // UNSAFE: the case: a write through a shown reference
        // SAFETY: r is a live local's address
        unsafe {
            *(self.r as *const i64 as *mut i64) = 0;
        }
        write(f, "{}", *self.r)
    }
}

fn zap(r: &i64) -> i64 {
    // UNSAFE: the case: a write through a reference made a pointer
    // SAFETY: r is a live local's address
    unsafe {
        *(r as *const i64 as *mut i64) = 0;
    }
    1
}

#[effects(io, static, panic, unsafe)]
fn shown(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        print("{}", Show { r: &i });
        i += 1;
    }
    i
}

#[effects(io, static, panic, unsafe)]
fn bound(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let s = Show { r: &i };
        print("{s}");
        i += 1;
    }
    i
}

#[effects(io, static, panic, unsafe)]
fn aliased(n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let r = &i;
        print("{r} {}", zap(r));
        i += 1;
    }
    i
}

fn main() {
    println("{} {} {}", shown(2), bound(2), aliased(2));
}
