// places IR, S16: an operator's owned operands: two drops at the statement's end
// sem-own: `mk(1) + mk(2)` with a let-param Add: both temporaries dropped once.
// (0.25: the temporaries at the end of the statement, the last made first)
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: 3
// EXPECT: drop 3
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn eat
// PLACES: drop(_1) [kept]
// PLACES: fn D::add
// PLACES: drop(_4) [removed]
// PLACES: fn main
// PLACES: drop(_6) [kept]
// PLACES: drop(_4) [kept]
// PLACES: drop(_2) [kept]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println("eat {}", d.id); }
impl Add for D { fn add(self, other: D) -> D { D { id: self.id + other.id, v: self.v.clone() } } }

fn main(gpa: Gpa) {
    let c = mk(1, gpa) + mk(2, gpa);
    println("{}", c.id);
}
