// XFAIL: RT-72h: (RT-72's family, the receiver a field or a deref) `h.t.drop()` in `fn g<T: Closer>(h: &mut H<T>)`, Closer declaring its own `drop`, instantiated with W1 (which also has Drop) and W2 is refused with E0040 ("explicit use of destructor method") at the instance: the call is resolved by name in the instance, not as the bound's Closer::drop; rustc runs Closer's drop and prints the EXPECT lines (0.30.2)
// From the re-review 2 of g302index (its form d47_field_receiver_two_instances). Since v0.30.1 at
// least (the same error). rt_072f is the parameter itself, `c.drop()`.
// EXPECT: closer W1 1
// EXPECT: closer W2 2
// EXPECT: end
// EXPECT: Drop W1 1
trait Closer {
    fn drop(&mut self);
}

struct W1 {
    k: i64,
}

impl Drop for W1 {
    fn drop(&mut self) {
        println("Drop W1 {}", self.k);
    }
}

impl Closer for W1 {
    fn drop(&mut self) {
        println("closer W1 {}", self.k);
    }
}

struct W2 {
    k: i64,
}

impl Closer for W2 {
    fn drop(&mut self) {
        println("closer W2 {}", self.k);
    }
}

struct H<T> {
    t: T,
}

fn g<T: Closer>(h: &mut H<T>) {
    h.t.drop();
}

fn main() {
    let mut a = H { t: W1 { k: 1 } };
    g(&mut a);
    let mut b = H { t: W2 { k: 2 } };
    g(&mut b);
    println("end");
}
