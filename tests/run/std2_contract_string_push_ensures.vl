// EDITION: rust
// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): String::push's `ensures self.len() > old(self.len())`, exercised.
// EXPECT: 3
use std::string::String;

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::from_in("a", gpa);
    s.push('é');
    println("{}", s.len());
}
