// RULE: D7.4
// (0.30.1) A contract call's receiver reserved before its arguments is
// two-phase: the arguments read the receiver in the window, as rustc's
// `v.insert(0, v.len())`.
// EXPECT: [1, 3, 1, 1]
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.insert(0, v.len() as i64);
    v.insert(v.len() - 1, {
        let n = v.len() as i64;
        n + 1
    });
    v.push(v.len() as i64 - 2);
    println("{:?}", v);
}
