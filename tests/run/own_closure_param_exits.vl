// (0.25.3) A closure's by-value parameter is dropped on every exit of its
// body (return, ?), in a sink closure with captures, a nested closure, and
// a pattern parameter (its parts not moved out dropped with it).
// FLAGS: --check-alloc
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: early 2 1
// EXPECT: drop 3
// EXPECT: drop 4
// EXPECT: try 3 0
// EXPECT: drop 6
// EXPECT: both 11
// EXPECT: drop 7
// EXPECT: nested 8
// EXPECT: drop 9
// EXPECT: drop 8
// EXPECT: pair 17
// EXPECT: drop 10
// EXPECT: drop 11
// EXPECT: part 10
// EXPECT: eat 12
// EXPECT: drop 12
// EXPECT: drop 13
// EXPECT: mv 13
// EXPECT: end
// EXPECT: drop 5
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println("drop {}", self.id); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println("eat {}", d.id); }

fn main(gpa: Gpa) -> i32 {
    let early = |d: sink D| -> i64 {
        if d.id > 1 {
            return 1;
        }
        2
    };
    println("early {} {}", early(mk(1, gpa)), early(mk(2, gpa)));
    let q = |d: sink D| -> Result<i64, i64> {
        let e: Result<i64, i64> = if d.id > 3 { Err(d.id) } else { Ok(d.id) };
        let n = e?;
        Ok(n)
    };
    println("try {} {}", q(mk(3, gpa)).unwrap_or(0), q(mk(4, gpa)).unwrap_or(0));
    let cap = mk(5, gpa);
    let both = sink |d: sink D| d.id + cap.id;
    println("both {}", both(mk(6, gpa)));
    let nested = |d: sink D| {
        let inner = |e: sink D| e.id;
        inner(d) + 1
    };
    println("nested {}", nested(mk(7, gpa)));
    let pair = |(a, b): sink (D, D)| a.id + b.id;
    println("pair {}", pair((mk(8, gpa), mk(9, gpa))));
    let part = |(a, _): sink (D, D)| a.id;
    println("part {}", part((mk(10, gpa), mk(11, gpa))));
    let mv = |(a, b): sink (D, D)| { eat(a); b.id };
    println("mv {}", mv((mk(12, gpa), mk(13, gpa))));
    println("end");
    0
}
