// EDITION: rust
// RULE: F15.1
// `#[builtin_impls(..)]` makes a trait's impls for the primitives it
// lists, as if written: the operator by the machine operation, `eq` by
// `==`, `not` by the bits (a xor with all ones on an integer), `clone` by
// a copy, `default` by zero; a bound on the trait is then met by them.
// EXPECT: 14
// EXPECT: 1
// EXPECT: -8
// EXPECT: 0
// EXPECT: 9
#[builtin_impls(i64, u8)]
trait Add<Rhs = Self> {
    type Output;
    fn add(self, rhs: Rhs) -> Self::Output;
}

#[builtin_impls(i64, bool)]
trait PartialEq<Rhs = Self> {
    fn eq(&self, other: &Rhs) -> bool;
}

#[builtin_impls(i64, bool)]
trait Not {
    type Output;
    fn not(self) -> Self::Output;
}

#[builtin_impls(i64)]
trait Default {
    fn default() -> Self;
}

#[builtin_impls(i64)]
trait Clone {
    fn clone(&self) -> Self;
}

fn twice<T: Add<Output = T> + Clone>(x: T) -> T {
    x.clone().add(x)
}

fn main() -> i64 {
    std::print_int(twice(7));
    println("");
    let same = PartialEq::eq(&true, &true);
    std::print_int(if same { 1 } else { 0 });
    println("");
    std::print_int(7.not());
    println("");
    let z = i64::default();
    std::print_int(z);
    println("");
    std::print_int((4u8).add(5u8) as i64);
    println("");
    0
}
