// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str str::from_utf8_unchecked.
// EXPECT: é 2
use std::str::CharIndices;

fn main() {
    let b: &[u8] = &[195, 169];
    // UNSAFE: the test's bytes as a str.
    // SAFETY: C3 A9 is the UTF-8 of U+00E9.
    let s = unsafe { str::from_utf8_unchecked(b) };
    println("{} {}", s, s.len());
}
