// XFAIL: RT-418: (RT-382's mechanism through PartialOrd) with F: PartialOrd and another trait OtherOrd whose `partial_cmp` and `lt` are reversed, a program's generic `a > b`, `a.partial_cmp(b)`, `a.lt(b)` (T: PartialOrd), std's BinaryHeap (push/pop order), Reverse's `<`, Vec, slice and array `<` and `partial_cmp`, `is_sorted` and Iterator's `lt` and `partial_cmp` run OtherOrd's methods (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). vole prints `gen gt false
// pc Some(Less) lt true`, `heap 1 2 rev 3 rev< true`, `vec< false slice<
// false arr< false vec pc Some(Greater)` and `is_sorted false
// iter.is_sorted false iter.lt false iter pc Some(Greater)`, at -O0 and
// -O2; v0.28.0 to v0.30.1 the same. A BinaryHeap pops its elements in the
// wrong order. Right today: Ord::cmp through BTreeSet, BTreeMap (range too),
// sort, sort_unstable, sort_by_key, binary_search, iter().max/min,
// max_by_key, cmp::max/min, clamp, select_nth_unstable (scratch a1/o1-o3).
// RT-382 is `==` and tuple `<`; this is PartialOrd's methods in std's and
// the program's generic bodies, taken by name.
// EXPECT: gen gt true pc Some(Greater) lt false
// EXPECT: heap 3 2 rev 1 rev< false
// EXPECT: vec< true slice< true arr< true vec pc Some(Less)
// EXPECT: is_sorted true iter.is_sorted true iter.lt true iter pc Some(Less)
use std::cmp::{Ordering, Reverse};
use std::collections::BinaryHeap;

trait OtherOrd {
    fn partial_cmp(&self, o: &Self) -> Option<Ordering>;
    fn lt(&self, o: &Self) -> bool;
}

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
struct F {
    k: i64,
}

impl OtherOrd for F {
    fn partial_cmp(&self, o: &F) -> Option<Ordering> {
        Some(o.k.cmp(&self.k))
    }

    fn lt(&self, o: &F) -> bool {
        o.k < self.k
    }
}

impl PartialOrd for F {
    fn partial_cmp(&self, o: &F) -> Option<Ordering> {
        Some(self.k.cmp(&o.k))
    }
}

impl Ord for F {
    fn cmp(&self, o: &F) -> Ordering {
        self.k.cmp(&o.k)
    }
}

fn ggt<T: PartialOrd>(a: &T, b: &T) -> bool {
    a > b
}

fn gpc<T: PartialOrd>(a: &T, b: &T) -> Option<Ordering> {
    a.partial_cmp(b)
}

fn glt<T: PartialOrd>(a: &T, b: &T) -> bool {
    a.lt(b)
}

fn mk(gpa: Gpa, a: i64, b: i64) -> Vec<F, Gpa> {
    let mut v: Vec<F, Gpa> = Vec::new_in(gpa);
    v.push(F { k: a });
    v.push(F { k: b });
    v
}

fn main(gpa: Gpa) {
    let a = F { k: 2 };
    let b = F { k: 1 };
    println("gen gt {} pc {:?} lt {}", ggt(&a, &b), gpc(&a, &b), glt(&a, &b));
    let mut h: BinaryHeap<F, Gpa> = BinaryHeap::new_in(gpa);
    h.push(F { k: 3 });
    h.push(F { k: 1 });
    h.push(F { k: 2 });
    let x = h.pop().unwrap().k;
    let y = h.pop().unwrap().k;
    let mut r: BinaryHeap<Reverse<F>, Gpa> = BinaryHeap::new_in(gpa);
    r.push(Reverse(F { k: 3 }));
    r.push(Reverse(F { k: 1 }));
    r.push(Reverse(F { k: 2 }));
    println("heap {} {} rev {} rev< {}", x, y, r.pop().unwrap().0.k,
        Reverse(F { k: 1 }) < Reverse(F { k: 2 }));
    let v = mk(gpa, 1, 2);
    let u = mk(gpa, 2, 1);
    println("vec< {} slice< {} arr< {} vec pc {:?}", v < u, v[..] < u[..],
        [F { k: 1 }] < [F { k: 2 }], v.partial_cmp(&u));
    println("is_sorted {} iter.is_sorted {} iter.lt {} iter pc {:?}", v.is_sorted(),
        v.iter().is_sorted(), v.iter().lt(u.iter()), v.iter().partial_cmp(u.iter()));
}
