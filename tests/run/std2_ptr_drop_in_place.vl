// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ptr drop_in_place.
// EXPECT: drop 4
// EXPECT: end
// EXPECT: drop 5
use std::ptr;

struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

fn main() {
    let mut d = D { n: 4 };
    let p = &mut d as *mut D;
    unsafe {
        ptr::drop_in_place(p);
        ptr::write(p, D { n: 5 });
    }
    println("end");
}
