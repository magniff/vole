// From the review of g302oblig-m2 (form f275p). Since v0.30.1 at least;
// the release build the same. rustc E0277 at `G<A>` in the header and at
// `&self` of its method; vole reports the one unmet bound once, at the header.
// ERROR: line 11
// ERROR-COUNT: 1
struct G<T: Send> {
    t: T,
}

impl<A> G<A> {
    fn good(&self) -> i64 {
        1
    }
}

fn main() {
    println("{}", 1);
}
