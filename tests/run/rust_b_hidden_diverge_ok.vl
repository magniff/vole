// RULE: D2.9
// (0.30.1) A hidden borrow is used where its copy is read: on a path cut
// short before that (a `return`, `std::process::exit`, a panic in the
// other operand or a later hole), it keeps nothing alive, and the place
// may be moved or written there, as rustc accepts. A callee that returns
// `!` ends the path even where its call is typed as its branch's `()`.
// Before, a borrow open at a call of type `!` or at an exit was mentioned
// there whatever the path, and these were refused.
// EXPECT: false
// EXPECT: a 1
// EXPECT: false
// EXPECT: q 1
fn early(c: bool, mut s: String<Gpa>, t: &String<Gpa>) {
    let e = s == {
        if c {
            s.clear();
            return;
        }
        t.clone()
    };
    println("{}", e);
}

fn main(gpa: Gpa) {
    let c = std::env::args().count() > 5;
    let s = String::from_in("a", gpa);
    let t = String::from_in("b", gpa);
    early(c, s.clone(), &t);
    println("{} {}", s, {
        if c {
            drop(s);
            std::process::exit(0);
        }
        1
    });
    let mut u = String::from_in("a", gpa);
    let e = u == {
        if c {
            u.clear();
            panic("x")
        }
        t.clone()
    };
    println("{}", e);
    let s2 = String::from_in("q", gpa);
    println("{} {}", s2, {
        if c {
            drop(s2);
            panic("y")
        }
        1
    });
}
