// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::str ParseBoolError.
// EXPECT: ParseBoolError true
// RUSTC: none (std's ParseBoolError is a unit struct; Rust's has a private field)
use std::str::ParseBoolError;

fn main() {
    let e: ParseBoolError = "yes".parse::<bool>().unwrap_err();
    println("{:?} {}", e, e == ParseBoolError);
}
