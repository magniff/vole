// EDITION: rust
// RULE: F26.3
// IndexMut's `&mut self` needs the place mutable: a `let s` is read-only
// (rustc E0596).
// ERROR: error[own.readonly]: 's[1usize..]' changes 's', a let binding: it is read-only
// RUSTC: rejects E0596 cannot borrow `s` as mutable
fn main(gpa: Gpa) {
    let s = String::from_in("abc", gpa);
    s[1usize..].make_ascii_uppercase();
    println("{}", s);
}
