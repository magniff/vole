// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str ParseIntError.
// EXPECT: ParseIntError { kind: PosOverflow } true
// RUSTC: none (std2 has no std::num: the parse errors are std::str's)
use std::str::ParseIntError;

fn main() {
    let e: ParseIntError = "300".parse::<u8>().unwrap_err();
    println("{:?} {}", e, e.clone() == e);
}
