// RULE: D2.7
// (0.30.1, RT-33) A shared view `&[T]` where `&mut [T]` is expected (a
// `&mut self` method of a slice: sort_unstable, sort_in) is rustc's E0596,
// cannot borrow `*s` as mutable, behind a `&` reference: the parameter's
// view, `v.as_slice()` and `w.as_slice()` (a call's shared view; the fixes
// are `&mut [i64]`, `v.as_mut_slice()`). `&mut a[..]` of a `let mut` array
// is the exclusive view, accepted. The positions are rustc's: 17:5,
// 24:5, 29:5.
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*s' as mutable
// ERROR: line 17, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*v.as_slice()' as mutable
// ERROR: line 24, column 5
// ERROR: error[borrowck.borrow_immutable]: cannot borrow '*w.as_slice()' as mutable
// ERROR: line 29, column 5
// ERROR-COUNT: 3
fn by_hand(s: &[i64]) {
    s.sort_unstable();
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    v.push(1);
    v.as_slice().sort_unstable();
    let mut a: [i64; 3] = [3i64, 1, 2];
    (&mut a[..]).sort_unstable_by(|a, b| ({ let x = a; let y = b; x - y }).cmp(&0));
    by_hand(&a[..]);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.as_slice().sort_in(gpa);
    println("{} {}", v[0], a[0]);
}
