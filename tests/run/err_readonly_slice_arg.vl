// XFAIL: gap 8: errors at other places or codes: MVS own.readonly@16:10; own.readonly@23:10; own.readonly@25:13; own.readon...
// ERROR: error[own.readonly]: 's', a '[i64]', is read-only where 'inout [i64]' is expected
// ERROR: refactor signature by_hand --type s 'inout [i64]'
// ERROR: error[own.readonly]: 'v.as_slice()', a '[i64]', is read-only where 'inout [i64]' is expected: the callee writes through it
// ERROR: try: v.sort()
// ERROR: error[own.readonly]: 'a[..]', a '[i64]', is read-only where 'inout [i64]' is expected
// ERROR: try: &a[..]
// ERROR: error[own.readonly]: 'w.as_slice()', a '[i64]', is read-only
// ERROR: try: w.as_mut_slice()
// ERROR-COUNT: 4
// (0.19.1) A read-only view `[T]` where `&mut [T]` is expected (a callee
// that writes through it: std's sort, a store intrinsic) is own.readonly;
// 0.17's legacy rule took it as the exclusive view. The fixes: the method
// for `sort(v.as_slice())`, `&mut a[..]`, `v.as_mut_slice()`, and a `[T]`
// parameter retyped with its calls.
fn by_hand(s: &[i64]) {
    s.sort_unstable();
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    v.push(1);
    v.as_slice().sort_unstable();
    let mut a: [i64; 3] = [3i64, 1, 2];
    (&mut a[..]).sort_unstable_by(|a, b| ({ let x = a; let y = b; x - y }).cmp(&0));
    by_hand(&a[..]);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.as_slice().sort_in(gpa);
    println("{} {}", v[0], a[0]);
}
