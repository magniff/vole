// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str Utf8Error::error_len.
// EXPECT: Some(1) Some(1) None
use std::str::CharIndices;

fn main() {
    let a = std::str::from_utf8(&[0x80]).unwrap_err();
    let b = std::str::from_utf8(&[0xE2, 0x28, 0xA1]).unwrap_err();
    let c = std::str::from_utf8(&[0xF0, 0x9F, 0x98]).unwrap_err();
    println("{:?} {:?} {:?}", a.error_len(), b.error_len(), c.error_len());
}
