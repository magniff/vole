// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::fill_with.
// EXPECT: [1, 2, 3]

fn main() {
    let mut a = [0, 0, 0];
    let mut n = 0;
    a.fill_with(|| {
        n += 1;
        n
    });
    println("{:?}", a);
}
