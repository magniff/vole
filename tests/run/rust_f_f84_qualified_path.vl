// RULE: F8.4, F6.2
// (0.30.1) `<S as Tr>::m` is Tr's function for S, as rustc's: of two
// traits' methods the one named, an associated function too, a trait's
// method over an inherent one, in a generic function too. And a
// reference `&P` to a primitive P with impls for P and for &P: `x.m()`
// and `Tr::m(x)` take P's `&self` method at the by-value step, as for a
// struct; the &P impl by `(&x).m()`, or with T = &P.
// EXPECT: 1 2 1 2
// EXPECT: 1 2
// EXPECT: 0 1 1
// EXPECT: 12 12
// EXPECT: T T T &T
// EXPECT: 1 1 1 2
trait A { fn m(&self) -> i64; fn mk() -> i64; }
trait B { fn m(&self) -> i64; fn mk() -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } fn mk() -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } fn mk() -> i64 { 2 } }
struct R;
impl R { fn m(&self) -> i64 { 0 } }
impl A for R { fn m(&self) -> i64 { 1 } fn mk() -> i64 { 1 } }
fn go<T: A + B>(t: &T) -> i64 { <T as A>::m(t) * 10 + <T as B>::m(t) }
fn go2<T: A + B>(t: &T) -> i64 { A::m(t) * 10 + B::m(t) }
trait Tr { fn n(&self) -> &'static str; }
impl Tr for i64 { fn n(&self) -> &'static str { "T" } }
impl<'a> Tr for &'a i64 { fn n(&self) -> &'static str { "&T" } }
trait Ts { fn t(&self) -> i64; }
impl Ts for u8 { fn t(&self) -> i64 { 1 } }
impl<'a> Ts for &'a u8 { fn t(&self) -> i64 { 2 } }
fn g1<T: Ts>(x: &T) -> i64 { T::t(x) }
fn g3<T: Ts>(x: &T) -> i64 { x.t() }
fn g4<T: Ts>(x: T) -> i64 { Ts::t(&x) }

fn main() {
    let s = S;
    println("{} {} {} {}", A::m(&s), B::m(&s), <S as A>::m(&s), <S as B>::m(&s));
    println("{} {}", <S as A>::mk(), <S as B>::mk());
    let r = R;
    println("{} {} {}", r.m(), A::m(&r), <R as A>::m(&r));
    println("{} {}", go(&s), go2(&s));
    let v = 5i64;
    let x = &v;
    println("{} {} {} {}", x.n(), Tr::n(x), v.n(), (&x).n());
    let a = 5u8;
    println("{} {} {} {}", g1(&a), g3(&a), g4(a), g4(&a));
}
