// std::process::exit does not return: diverge. (0.26.1: exit flushes std's
// print buffer, which is no `global` now: diverge is the first excess.)
// ERROR: 'stop' is #[effects(io, panic)], but it may not terminate (diverge)
#[effects(io, panic)]
fn stop() { std::process::exit(3); }

fn main() -> i32 {
    stop();
    0
}
