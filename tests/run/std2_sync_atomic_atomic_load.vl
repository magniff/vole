// The std2 item(s): std::sync::atomic Atomic::load (a Release load panics, as Rust's).
// EXPECT: 1
// EXIT: 101
// RUSTC: none (rustc rejects a Release load when it builds: the invalid_atomic_ordering lint; std2 panics when it runs)
use std::sync::atomic::{AtomicI64, Ordering};

fn main() {
    let a = AtomicI64::new(1);
    println("{}", a.load(Ordering::Acquire));
    println("{}", a.load(Ordering::Release));
}
