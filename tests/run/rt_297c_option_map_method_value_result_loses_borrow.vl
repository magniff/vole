// RT-297c (closed in 0.30.2): (R302F-14 through a method value) `o.as_ref().map(String::<Gpa>::as_str)` and `Some(&s).map(S::<Gpa>::head)` give a result that keeps no borrow: drop(o) / drop(s) while it lives is accepted, a use after free from safe code (0.30.2)
// rustc E0505 at both drops (twin .rs.txt, with `String::as_str` and
// `S::head`; vole needs the type arguments written, RT-204's family). The
// release build checks it clean; --check-alloc stops with `use after free:
// block #1 (5 bytes), allocated at ..`. Rust's idiom for an
// `Option<&str>` from an `Option<String>`.
// FLAGS: --check-alloc
// ERROR: line 26
// ERROR: line 31
// ERROR-COUNT: 2
use std::alloc::Allocator;

struct S<A: Allocator> {
    v: Vec<i64, A>,
}

impl<A: Allocator> S<A> {
    fn head(&self) -> &i64 {
        &self.v[0]
    }
}

fn main(gpa: Gpa) {
    let o: Option<String<Gpa>> = Some(String::from_in("hello", gpa));
    let r = o.as_ref().map(String::<Gpa>::as_str);
    drop(o);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let s = S { v: v };
    let q = Some(&s).map(S::<Gpa>::head);
    drop(s);
    let mut x: Vec<i64, Gpa> = Vec::new_in(gpa);
    x.push(7);
    println("{:?} {:?} {:?}", r, q, x);
}
