// EDITION: rust
// RULE: D17.3
// (0.27.1) `ensures` reads `*v` of a `&mut` parameter at exit: the body's
// reborrow is dead by then. (`check` reports test.generate for the `&mut
// i64` parameter until the generator reads it, D17's finding; the build is
// fine.)
// RUSTC: none contract clauses are not Rust

fn bump(v: &mut i64)
    ensures * v == old(*v) + 1
{
    *v += 1;
}

fn main() {
    let mut a: i64 = 4;
    bump(&mut a);
    println("{}", a);
}
// EXPECT: 5
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
