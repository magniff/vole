// sem-own: `for x in p` over an owning user iterator: the iterator consumed
// once, its Vec freed once.
// EXPECT: 2
// EXPECT: 1
// EXPECT: end
use std::alloc::Allocator; struct Pop<A: Allocator> { v: Vec<i64, A> }
impl Iterator for Pop<Gpa> { type Item = i64; fn next(&mut self) -> Option<i64> { self.v.pop() } }

fn main(gpa: Gpa) {
    let mut p = Pop { v: Vec::new_in(gpa) };
    p.v.push(1);
    p.v.push(2);
    for x in p { println("{x}"); }
    println("end");
}
