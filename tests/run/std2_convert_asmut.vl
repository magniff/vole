// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::convert AsMut.
// EXPECT: 4
use std::convert::{AsMut, Infallible};

struct W {
    v: i64,
}

impl AsMut<i64> for W {
    fn as_mut(&mut self) -> &mut i64 {
        &mut self.v
    }
}

fn twice<T: AsMut<i64>>(x: &mut T) {
    *x.as_mut() *= 2;
}

fn main() {
    let mut w = W { v: 2 };
    twice(&mut w);
    println("{}", w.v);
}
