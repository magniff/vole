// (0.26.1) A cell in a `static var` and a `#[thread_local] static var`,
// and an immutable static atomic, all written at run time.
// EXPECT: 1 2 3
// EXPECT: 4 5
use std::cell::Cell;
use std::sync::atomic::{AtomicU64, Ordering};

static OK: AtomicU64 = AtomicU64::new(0);
static var MINE: Cell<i64> = Cell::new(0);
#[thread_local]
static var LOCAL: Cell<i64> = Cell::new(0);

#[inline(never)]
fn more() {
    MINE.set(MINE.get() + 3);
    LOCAL.update(|x| x + 3);
}

fn main() {
    MINE.set(1);
    LOCAL.set(2);
    OK.store(3, Ordering::SeqCst);
    println("{} {} {}", MINE.get(), LOCAL.get(), OK.load(Ordering::SeqCst));
    more();
    println("{} {}", MINE.get(), LOCAL.get());
}
