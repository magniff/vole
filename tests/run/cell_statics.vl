// (0.26.1) A cell in a `static var` and a `#[thread_local] static var`,
// and an immutable static atomic, all written at run time.
// EXPECT: 1 2 3
// EXPECT: 4 5
use std::cell::Cell;
use std::sync::atomic::AtomicU64; use std::sync::atomic::Ordering;

static OK: AtomicU64 = AtomicU64::new(0u64);
static mut MINE: Cell<i64> = Cell::new(0i64);
#[thread_local]
static mut LOCAL: Cell<i64> = Cell::new(0i64);

#[inline(never)]
fn more() {
    unsafe { (*(&raw const MINE)).set((*(&raw const MINE)).get() + 3) };
    unsafe { (*(&raw const LOCAL)).update(|x| x + 3) };
}

fn main() {
    unsafe { (*(&raw const MINE)).set(1) };
    unsafe { (*(&raw const LOCAL)).set(2) };
    OK.store(3u64, Ordering::SeqCst);
    println("{} {} {}", unsafe { (*(&raw const MINE)).get() },
        unsafe { (*(&raw const LOCAL)).get() }, OK.load(Ordering::SeqCst));
    more();
    println("{} {}", unsafe { (*(&raw const MINE)).get() }, unsafe { (*(&raw const LOCAL)).get() });
}
