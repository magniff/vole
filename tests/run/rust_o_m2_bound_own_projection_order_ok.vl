// EXPECT: 64
// (RT-272) `T: Tr<T::Out> + H2`, the projecting bound first: v0.30.1 crashed (bus error).
trait Tr<U> {
    fn g(&self) -> i64;
}

trait H2 {
    type Out;
}

struct W {
    r: i64,
}

impl H2 for W {
    type Out = i64;
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

fn mid<T: Tr<T::Out> + H2>(t: &T) -> i64 {
    t.g()
}

fn main() {
    println("{}", mid(&W { r: 0 }));
}
