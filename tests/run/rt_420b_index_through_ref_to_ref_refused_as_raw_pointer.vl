// XFAIL: RT-420b: (R302I-3's safe side) an index or a slice through two references, `v[0]` in `vs.iter().filter(|v| v[0] > 0)` (v: &&Vec), `&s[0..1]` of an `&&String`, `h[&1]` of an `&&HashMap`, `rows[1]` of a `rows: &&Vec<i64>` parameter, `pp[1] = 9` of `pp: &mut &mut Vec<i64>`, is refused as raw-pointer indexing ("indexing a raw pointer is unsafe", "slicing a raw pointer is unsafe") plus a type error; rustc accepts (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). vole reports 10 errors:
// one unsafe and one type error at each site. The try: `volec fix --only
// unsafe` wraps the sites in unsafe blocks, turning each into pointer
// arithmetic over the reference (R302I-3: a segfault). `x[0]` of an
// `&&[i64; 2]` (F20.1) and of an `&&[i64]` are right. Since v0.28.0 (v0.28.0
// to v0.30.1 the same).
// EXPECT: 1 1 1 2
// EXPECT: 9
use std::collections::HashMap;

fn second(rows: &&Vec<i64, Gpa>) -> i64 {
    rows[1]
}

fn main(gpa: Gpa) {
    let mut vs: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    let mut a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    a.push(2);
    vs.push(a);
    let n = vs.iter().filter(|v| v[0] > 0).count();
    let mut ss: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    ss.push(String::from_in("hey", gpa));
    let k = ss.iter().filter(|s| &s[0..1] == "h").count();
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let mut ms: Vec<HashMap<i64, i64, Gpa, FixedState>, Gpa> = Vec::new_in(gpa);
    ms.push(m);
    let j = ms.iter().filter(|h| h[&1] == 2).count();
    println("{} {} {} {}", n, k, j, second(&&vs[0]));
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(4);
    w.push(5);
    let mut p = &mut w;
    let pp = &mut p;
    pp[1] = 9;
    println("{}", w[1]);
}
