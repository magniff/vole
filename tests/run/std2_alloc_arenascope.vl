// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc ArenaScope.
// EXPECT: 5
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let n = arena.scope(|sc: &std::alloc::ArenaScope<'_, Gpa>| {
        let v = Vec::from_in([1, 2, 3, 4, 5], sc);
        v.len()
    });
    println("{}", n);
}
