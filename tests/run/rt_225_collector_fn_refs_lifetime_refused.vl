// XFAIL: RT-225: a program's collector fn `fn bare<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> B` (and `-> (B,)`, `-> (B, B)`, `-> Pair<B>`) called with an iterator of references is refused in its body: "the lifetime in 'I' must outlive the lifetime in 'B'" (a regression in v0.30.1) (0.30.2)
// rustc builds the twin (r302e_002_program_collector_refused_in_body.rs.txt) and prints the EXPECT line;
// v0.30.0 builds this program too. Its must-fail side (the call must keep the borrow) is R302E-2b.
// EXPECT: [1, 2, 3] [1, 2, 3] [1, 3] [2] Some([10, 20, 30]) [1, 2, 3] 0
use std::alloc::Allocator;
use std::default::DefaultIn;

struct Pair<B> {
    a: B,
    b: B,
}

fn bare<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> B {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    b
}

fn one<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> (B,) {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    (b,)
}

fn two<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> (B, B) {
    let mut y = B::default_in(a.clone());
    let mut n = B::default_in(a);
    let mut k = 0i64;
    for x in it {
        if k % 2 == 0 {
            y.extend(Some(x));
        } else {
            n.extend(Some(x));
        }
        k += 1;
    }
    (y, n)
}

fn opt<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> Option<B> {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    Some(b)
}

fn pair<I: Iterator, B: DefaultIn<A> + Extend<I::Item>,
    A: Allocator + Clone>(it: I, a: A) -> Pair<B> {
    let mut y = B::default_in(a.clone());
    let n = B::default_in(a);
    for x in it {
        y.extend(Some(x));
    }
    Pair { a: y, b: n }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let r0: Vec<&i64, Gpa> = bare(v.iter(), gpa);
    let r1: (Vec<&i64, Gpa>,) = one(v.iter(), gpa);
    let r2: (Vec<&i64, Gpa>, Vec<&i64, Gpa>) = two(v.iter(), gpa);
    let r3: Option<Vec<i64, Gpa>> = opt(v.iter().map(|x| *x * 10), gpa);
    let r4: Pair<Vec<&i64, Gpa>> = pair(v.iter(), gpa);
    println("{:?} {:?} {:?} {:?} {:?} {:?} {}", r0, r1.0, r2.0, r2.1, r3, r4.a, r4.b.len());
}
