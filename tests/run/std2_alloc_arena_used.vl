// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::alloc Arena::used.
// EXPECT: 8 20 22
use std::alloc::{Allocator, Arena, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    arena.alloc(1i64);
    let a = arena.used();
    arena.alloc_slice_copy(&[1i32, 2, 3]);
    let b = arena.used();
    arena.alloc_str("hi");
    println("{} {} {}", a, b, arena.used());
}
