// RT-269c, fixed in 0.30.2 (obligations M2: an impl's where clause required where the impl is chosen, impl_applies, 3faf7632b).
// From the re-review of g302bor2 (its form f01_where_nonparam_false_bound). Since v0.30.1 at least
// (the same output, 1, on v0.30.1 and on the release build, 38fe466c5).
// RT-269 is a concrete subject (`where W: Conv<U>`), rt_269b `Self`. Not
// RT-451's root: that one is the struct's own bound missing from an
// impl header.
// ERROR: line 35
trait Dup {
    fn dup(&self) -> i64;
}

struct W<T> {
    t: T,
}

trait Never {
    fn never(&self) -> i64;
}

impl<T> Dup for W<T>
    where
        Vec<T, Gpa>: Never,
{
    fn dup(&self) -> i64 {
        1
    }
}

fn need<Z: Dup>(z: &Z) -> i64 {
    z.dup()
}

fn main() {
    let w = W { t: 1i64 };
    println("{}", need(&w));
}
