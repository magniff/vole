// ERROR: line 35
trait Dup {
    fn dup(&self) -> i64;
}

struct W<T> {
    t: T,
}

trait Never {
    fn never(&self) -> i64;
}

impl<T> Dup for W<T>
    where
        Vec<T, Gpa>: Never,
{
    fn dup(&self) -> i64 {
        1
    }
}

fn need<Z: Dup>(z: &Z) -> i64 {
    z.dup()
}

fn main() {
    let w = W { t: 1i64 };
    println("{}", need(&w));
}
