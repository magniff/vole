// RULE: D3.6
// (0.27.1) A `&` result keeps its receiver borrowed: `&mut s` while it is
// live.
// ERROR: error[borrowck.conflict]
// ERROR: line 23, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn first(&self) -> &i64 {
        &self.x
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    let r = s.first();
    let m = &mut s;
    m.x = 1;
    println("{}", *r);
}
