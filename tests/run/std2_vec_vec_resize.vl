// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::vec Vec::resize.
// EXPECT: [1, 0, 0] [1]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1], gpa);
    v.resize(3, 0);
    let a = v.clone();
    v.resize(1, 9);
    println("{:?} {:?}", a, v);
}
