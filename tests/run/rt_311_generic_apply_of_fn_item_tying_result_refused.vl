// RT-311 (closed in 0.30.2): (RT-304's result form) a generic `fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U { f(t) }` (also FnOnce wrapped in Some, and `f: fn(T) -> U`) called with a fn item whose result borrows its argument, `ap(&v[0], idr2)`, is refused in the body: "the lifetime in 'T' must outlive the lifetime in 'U'" (0.30.2)
// rustc prints the EXPECT line (twin .rs.txt). v0.28.0 and v0.29.0 build
// it; v0.30.0 to the release build refuse it, at the three bodies (lines
// 15, 19, 23). The same calls with a closure `|x| x` build, and so does a
// body that pushes `f(*t)` into a Vec<U> (apv, idr2): only a body whose
// result is the call's value is refused. RT-304 is the two-argument form
// (a fn item tying B's lifetime to A's); RT-297b/R302G-5 are the other side
// (a fn item's result keeps no borrow where nothing is refused).
// EXPECT: 1 Some(1) 1 [1, 2] 1
fn idr2<'a>(x: &'a i64) -> &'a i64 {
    x
}

fn ap<T, U, F: Fn(T) -> U>(t: T, f: F) -> U {
    f(t)
}

fn apo<T, U, F: FnOnce(T) -> U>(t: T, f: F) -> Option<U> {
    Some(f(t))
}

fn app<T, U>(t: T, f: fn(T) -> U) -> U {
    f(t)
}

fn apv<T: Copy, U, F: FnMut(T) -> U>(ts: &[T], mut f: F, gpa: Gpa) -> Vec<U, Gpa> {
    let mut out: Vec<U, Gpa> = Vec::new_in(gpa);
    for t in ts {
        out.push(f(*t));
    }
    out
}

fn main(gpa: Gpa) {
    let v = [1i64, 2];
    let a = ap(&v[0], idr2);
    let b = apo(&v[0], idr2);
    let c = app(&v[0], idr2);
    let r = [&v[0], &v[1]];
    let f = apv(&r[..], idr2, gpa);
    let d = ap(&v[0], |x| x);
    println("{} {:?} {} {:?} {}", a, b, c, f, d);
}
