// 0.25.2.1 (eval 0.25.2: sdftext): a failing assertion shows a float
// operand's value too (a call's, with float arguments), in millionths: the
// run-time helper prints integers.
// EXIT: 101
// STDERR: assertion failed: 'field_at(v.as_slice(), 4.0) > 0.99': field_at(v.as_slice(), 4.0) = 710000e-6
fn field_at(xs: [f64], x: f64) -> f64 {
    xs[0] * x * 0.25
}

fn main(gpa: Gpa) {
    var v: Vec<f64> = Vec::new_in(gpa);
    v.push(0.71);
    let small: f32 = -0.25;
    assert(small < 0.0);
    assert(field_at(v.as_slice(), 4.0) > 0.99);
}
