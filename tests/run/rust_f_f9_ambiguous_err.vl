// EDITION: rust
// RULE: F9.3
// Two traits' methods of one name on one type, neither inherent: a
// method call does not say which (rustc E0034).
// ERROR: error[method.ambiguous]: multiple applicable items: 'get' is a method of more than one trait for 'S'
trait A {
    fn get(&self) -> i64;
}

trait B {
    fn get(&self) -> i64;
}

struct S {
    n: i64,
}

impl A for S {
    fn get(&self) -> i64 {
        1
    }
}

impl B for S {
    fn get(&self) -> i64 {
        2
    }
}

fn main() -> i64 {
    let s = S { n: 0 };
    s.get()
}
