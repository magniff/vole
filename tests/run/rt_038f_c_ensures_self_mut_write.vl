// RULE: C3.4
// (0.30.2, RT-38f) `self` of `impl Bump for &mut i64`, a `&mut i64` with
// no type written: it had no view after the body, and the ensures wrote
// through it.
// RUSTC: none contract clauses are not Rust
// ERROR: cannot assign to '*self'
// ERROR-COUNT: 1
trait Bump {
    fn bump(self) -> i64;
}

impl Bump for &mut i64 {
    fn bump(self) -> i64
        ensures {
        *self = 9;
        true
    }

    {
        *self += 1;
        *self
    }
}

fn main() {
    let mut x = 1i64;
    println("{}", (&mut x).bump());
    println("{}", x);
}
