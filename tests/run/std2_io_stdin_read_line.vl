// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io Stdin::read_line.
// EXPECT: 3 "ab\n" 2 0
// STDIN: ab
// STDIN: cd
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut s: String<Gpa> = String::new_in(gpa);
    let n = io::stdin().read_line(&mut s).unwrap();
    let mut t: String<Gpa> = String::new_in(gpa);
    let m = io::stdin().read_line(&mut t).unwrap();
    let k = io::stdin().read_line(&mut t).unwrap();
    println("{} {:?} {} {}", n, s, m, k);
}
