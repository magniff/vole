// RULE: F27.1
// A struct pattern names each field once, only fields of the struct, and
// every field unless it ends with `..` (rustc E0027, E0026).
// ERROR: the pattern of 'Point' does not mention field 'y'
// ERROR: no field 'z' in struct 'Point'
struct Point {
    x: i64,
    y: i64,
}

fn g(p: Point) -> i64 {
    let Point { x } = p;
    x
}

fn h(p: Point) -> i64 {
    let Point { z, .. } = p;
    z
}

fn main() -> i64 {
    g(Point { x: 1, y: 2 }) + h(Point { x: 1, y: 2 })
}
