// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops BitAnd::bitand.
// EXPECT: V { x: 4 } 4
use std::ops::BitAnd;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl BitAnd for V {
    type Output = V;

    fn bitand(self, rhs: V) -> V {
        V { x: self.x & rhs.x }
    }
}

fn main() {
    let a = V { x: 12 };
    let b = V { x: 5 };
    println("{:?} {}", a.bitand(b), BitAnd::bitand(12i64, 5));
}
