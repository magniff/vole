// RT-61's family (0.30.2): a running maximum whose comparison is read by
// something else (a count of new maxima, the index of the maximum, a
// stored flag) is no reduction either. The output is rustc's.
// v0.30.1 at -O2 counted the new maxima and stored the flags per lane
// (count_new and flags were vectorized: wrong from 17 elements on).
// EXPECT: 0 -1000000 0 -1000 0 0
// EXPECT: 1 13001 0 13 295347237 77
// EXPECT: 3 75002 1 75 393796316 107
// EXPECT: 4 75002 1 75 393796316 122
// EXPECT: 5 75002 1 75 393796316 137
// EXPECT: 8 96003 6 96 155518327 140
// EXPECT: 9 96003 6 96 155518327 134
// EXPECT: 17 96003 6 96 155518327 86
// EXPECT: 100 122007 78 122 974590666 -1584
#[inline(never)]
fn count_new(b: &[i32], n: usize) -> i32 {
    let mut m: i32 = -1000;
    let mut cnt: i32 = 0;
    for i in 0..n {
        if b[i] > m {
            m = b[i];
            cnt += 1;
        }
    }
    m * 1000 + cnt
}

#[inline(never)]
fn argmax(b: &[i32], n: usize) -> usize {
    let mut m: i32 = -1000;
    let mut idx: usize = 0;
    for i in 0..n {
        if b[i] > m {
            m = b[i];
            idx = i;
        }
    }
    idx
}

#[inline(never)]
fn flags(a: &mut [i32], b: &[i32], n: usize) -> i32 {
    let mut m: i32 = -1000;
    for i in 0..n {
        let k = b[i] > m;
        m = if k { b[i] } else { m };
        a[i] = if k { 1 } else { 0 };
    }
    m
}

#[inline(never)]
fn minsum(b: &[i16], n: usize) -> i16 {
    let mut m: i16 = 1000;
    let mut s: i16 = 0;
    for i in 0..n {
        m = if b[i] < m { b[i] } else { m };
        s = s.wrapping_add(m);
    }
    s
}

fn main() {
    let mut b: [i32; 100] = [0; 100];
    let mut c: [i16; 100] = [0; 100];
    for i in 0..100 {
        b[i] = ((i * 7919 + 13) % 97) as i32 + (i as i32) / 3;
        c[i] = 90 - b[i] as i16;
    }
    for n in [0usize, 1, 3, 4, 5, 8, 9, 17, 100] {
        let mut a: [i32; 100] = [0; 100];
        let f = flags(&mut a, &b, n);
        let mut h: i64 = 0;
        for i in 0..100 {
            h = h * 3 + a[i] as i64;
            h = h % 1000000007;
        }
        println("{} {} {} {} {} {}", n, count_new(&b, n), argmax(&b, n), f, h, minsum(&c, n));
    }
}
