// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a40_old_io)
// RUSTC: none contract clauses are not Rust
// ERROR: the 'ensures' of 'f' calls 'say', which does io
// old(..) does io.
fn say() -> i64 {
    println("io");
    1
}

fn f(n: i64) -> i64
    ensures old(say()) == 1
{
    n
}

fn main() {
    println("{}", f(2));
}
