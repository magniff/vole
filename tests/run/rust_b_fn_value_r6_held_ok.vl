// RULE: R6
// (0.30.2) A fn item a local surely holds (`let p = st;`, `let k: fn(&i64)
// -> &'static i64 = st;`, not `mut`, assigned once) is read by its own
// signature where a bound's input is the call's own region, as the item
// written there is: sort_by_key builds, as rustc builds it. A function
// whose only callable parameter is a written `fn(..)` type (`pick`) is a
// value as any other: its body is checked as R6 reads that type. A
// `mut f: F` only called, as an FnMut is, holds its caller's value (kl).
// v0.30.2's first rule refused the first three, and kl's body.
// EXPECT: [1, 3] [1, 3] 5 5 5 5
static ZST: i64 = 5;

fn st(_x: &i64) -> &'static i64 {
    &ZST
}

fn idk(x: &i64) -> i64 {
    *x
}

fn pick<'a>(d: &'a i64, k: fn(&i64) -> &'a i64) -> &'a i64 {
    let l = 3i64;
    let _ = k(&l);
    k(d)
}

fn kl<K, F: FnMut(&i64) -> K>(mut f: F) -> K {
    let l = 9i64;
    f(&l)
}

fn main(gpa: Gpa) {
    let p = st;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.sort_by_key(p);
    let q = idk;
    v.sort_by_key(q);
    let k: fn(&i64) -> &'static i64 = st;
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(3);
    w.push(1);
    w.sort_by_key(idk);
    w.sort_by_key(k);
    let x = 4i64;
    let a = pick(&x, st);
    let g = pick;
    let b = g(&x, st);
    let c = kl(st);
    println("{:?} {:?} {} {} {} {}", v, w, a, b, c, ZST);
}
