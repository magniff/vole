// (0.30.2, obligations M1; review 4 F3 at a use) `trait Sub: Sup<i32>`: a
// bound `T: Sub` needs Sup<i32>'s impl, by its trait argument, not Sup<i64>'s,
// whose `'c: 'static` a short X does not meet. rustc accepts it.
// EXPECT: 1
trait Sup<P> { fn up(&self) -> i64; }
trait Sub: Sup<i32> { fn n(&self) -> i64; }
struct X<'c> { r: &'c str }
impl<'c: 'static> Sup<i64> for X<'c> { fn up(&self) -> i64 { 64 } }
impl<'c> Sup<i32> for X<'c> { fn up(&self) -> i64 { 32 } }
impl<'c> Sub for X<'c> { fn n(&self) -> i64 { 1 } }
fn go<T: Sub>(t: &T) -> i64 { t.n() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa); let x = X { r: st.as_str() }; println("{}", go(&x));
}
