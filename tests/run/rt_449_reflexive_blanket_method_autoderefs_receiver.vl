// XFAIL: RT-449: with a reflexive blanket `impl<T> Same<T> for T`, `x.same()` in `fn ks<X, T: Same<X>>(x: T) -> X` instantiated with T = X = &i64 takes the impl for the dereferenced receiver (i64: Same<i64>): "expected '&i64', got 'i64'" in the instance; rustc calls the bound's method on T itself and prints 5 (0.30.2)
// From the review of g302fnval (its form p01_reflexive_method_autoderef).
// Since v0.30.1 at least (the same error). RT-212 and RT-363 are other
// generic bodies that take an instance's autoderef steps for T = &W.
// EXPECT: 5
trait Same<X> {
    fn same(self) -> X;
}

impl<T> Same<T> for T {
    fn same(self) -> T {
        self
    }
}

fn ks<X, T: Same<X>>(x: T) -> X {
    x.same()
}

fn main() {
    let a = 5i64;
    let r: &i64 = ks::<&i64, &i64>(&a);
    println("{}", r);
}
