// A module and an item of the same name (0.14), as in Rust: `use
// eval::eval;` beside `mod eval;` makes `eval(x)` the function, while
// `eval::twice` goes through the module; the same for a type. String
// constants (0.14): `const S: [u8] = "..."` is the literal.
// EXPECT: hello
// EXPECT: eval
// EXPECT: static
// EXPECT: 27
mod eval;
mod token;
use eval::eval;
use token::token;
const GREETING: &str = "hello";
static ALSO: &str = "static";

fn main() -> i32 {
    let t: token = token { v: 2 };
    println("{}", GREETING);
    println("{}", eval::NAME);
    println("{}", ALSO);
    print("{}", (eval(t.v) + GREETING.len() as i64 + eval::twice(1)));
    println("");
    0
}
