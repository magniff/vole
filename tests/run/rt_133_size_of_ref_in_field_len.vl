// XFAIL: RT-133: size_of::<&A>() in a field's array length is refused with "missing lifetime" (0.30.2)
// rustc accepts it: a reference's size needs no lifetime. Found by the
// review of g302std; v0.30.1 too.
// EXPECT: 8 8
use std::mem::size_of;

struct A {
    x: u64,
}

struct B {
    r: [u8; size_of::<&A>()],
}

fn main() {
    println("{} {}", size_of::<&A>(), size_of::<B>());
}
