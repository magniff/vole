// a struct holding an atomic is move-only too: a copy would not be shared
// ERROR: error[borrowck.use_moved]
// ERROR: line 11, column 22
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;
struct C { a: AtomicI64 }

fn main() {
    let c = C { a: AtomicI64::new(1i64) };
    let d = c;
    d.a.fetch_add(1, Ordering::SeqCst);
    println("{} {}", c.a.load(Ordering::SeqCst), d.a.load(Ordering::SeqCst));
}
