// RULE: D4.6 (f), D4.4 (e)
// (0.27.5) The item of `I: Iterator<Item = &'b str>` is 'b's: returned
// as an `&'a str` it needs 'b: 'a, which nothing says (rustc's "lifetime
// may not live long enough"); and an iterator over a local's text still
// borrows the local (E0515), whatever the bound of the other parameter.
// (0.27.6, D4.4 (e)) Only the template's errors, as rustc: 0.27.5 also
// reported mixed<Split<char>>'s, at the `let`, of Split's lifetime.
// ERROR: error[borrowck.outlives]
// ERROR: line 15, column 5
// ERROR: error[borrowck.return_local]
// ERROR: line 20, column 34
// ERROR-COUNT: 2
fn mixed<'a, 'b, I: Iterator<Item = &'b str>>(args: I) -> Option<&'a str> {
    let mut it = args;
    it.next()
}

fn local<'a, I: Iterator<Item = &'a str>>(_args: I) -> Option<&'a str> {
    let text = [b'x'; 3];
    let s = std::str::from_utf8(&text).unwrap();
    let mut it = s.split(' ');
    it.next()
}

fn main() {
    println("{:?} {:?}", mixed("x".split(' ')), local("y".split(' ')));
}
