// (0.28.0, F20.8) An index, and an end of a range that slices, is a
// usize and nothing else, as in Rust (rustc E0277): no other integer
// type, signed or unsigned, and no widening to it (a u8 is converted as
// an i64 is). Of an array, a Vec, a slice and a str. The try: is the
// conversion `fix --suggested` writes: `i as usize`, an operation in
// parentheses, a reference read through, and of an index that is a cast
// of an integer the cast with its type changed.
// ERROR: an index is a 'usize', got 'i32'
// ERROR: n as usize
// ERROR: an index is a 'usize', got 'i64'
// ERROR: help: indexing takes a usize alone, as Rust's (no other integer type, no widening): convert it, or give the variable the type usize where it is declared
// ERROR: i as usize
// ERROR: an index is a 'usize', got 'u8'
// ERROR: b as usize
// ERROR: an index is a 'usize', got 'u32'
// ERROR: (w - 3) as usize
// ERROR: an index is a 'usize', got 'i64'
// ERROR: i as usize
// ERROR: an index is a 'usize', got 'u8'
// ERROR: b as usize
// ERROR: an index is a 'usize', got 'i64'
// ERROR: i as usize
// ERROR: an index is a 'usize', got 'i64'
// ERROR: *r as usize
// ERROR: an index is a 'usize', got 'i64'
// ERROR: (b >> 1) as usize
// ERROR: an index is a 'usize', got 'i64'
// ERROR: (if b > 1 { i } else { 0 }) as usize
// ERROR-COUNT: 10
fn at(xs: &[i64], n: i32) -> i64 {
    xs[n]
}

fn main(gpa: Gpa) -> i32 {
    let a = [10, 20, 30, 40];
    let mut v: Vec<i32, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let s = "hello";
    let i: i64 = 1;
    let b: u8 = 2;
    let w: u32 = 3;
    let r = &i;
    println("{}", a[i]);
    println("{}", a[b]);
    println("{}", v[w - 3]);
    println("{:?}", &a[i..]);
    println("{:?}", &a[..b]);
    println("{}", &s[i..]);
    println("{}", a[r]);
    println("{}", a[(b >> 1) as i64]);
    println("{}", a[if b > 1 { i } else { 0 }]);
    println("{}", at(&[1, 2], 0));
    0
}
