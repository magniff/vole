// RULE: F8.4, D21.3
// `Tr2::n(&o)` of an `impl Tr` result whose hidden type S also implements Tr2: no bound entails Tr2, rustc E0277 (the trait bound `impl Tr: Tr2` is not satisfied). A guard: the hidden type is not seen.
// From the gate suite of 0.30.2 (rt_211_through_program_fn_err): an `impl Tr` result has no impl of its own; a trait its bounds entail gives the hidden type's item to a path (qualified::impl_self), as its methods are the hidden type's.
// ERROR: 'impl Tr' has no impl of 'Tr2' that gives 'n'
trait Tr {
    fn m(&self) -> i64;
}

trait Tr2 {
    fn n(&self) -> i64;
}

struct S {
    k: i64,
}

impl Tr for S {
    fn m(&self) -> i64 {
        self.k
    }
}

impl Tr2 for S {
    fn n(&self) -> i64 {
        self.k * 2
    }
}

fn mk() -> impl Tr {
    S { k: 4 }
}

fn main() {
    let o = mk();
    println("{}", Tr2::n(&o));
}
