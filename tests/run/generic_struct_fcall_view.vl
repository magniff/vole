// a generic struct's method calls its stored closure, whose result views a captured Vec
// ERROR: error[borrowck.conflict]
// ERROR: line 15, column 24
#[derive(Clone, Copy)] struct H<R, F: Fn(i64) -> R> { f: F }

impl<R, F: Fn(i64) -> R> H<R, F> {
    fn call(self, x: i64) -> R { (self.f)(x) }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let h = H { f: |i: i64| v.as_slice() };
    let s = h.call(0);
    for i in 0..1000 { v.push(i); }
    println("{}", s[0]);
}
