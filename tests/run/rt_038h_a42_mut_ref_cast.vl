// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a42_mut_ref_cast)
// RUSTC: none contract clauses are not Rust
// ERROR: cannot cast '&i64' to '*mut i64'
// A &mut i64 parameter cast to *mut in the clause, written by a callee.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(r: &mut i64) -> i64
    requires poke(r as *mut i64)
{
    1
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
