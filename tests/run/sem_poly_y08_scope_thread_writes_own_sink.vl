// EDITION: rust
// XFAIL: gap 10: own.readonly in std's thread_run instance ('(p.f)()' changes 'p'), its closure a FnMut
// a scoped thread with a sink closure changing its own copy: the caller's n unchanged
// FLAGS: --check-alloc
// EXPECT: 11 1
use std::thread;

fn main() {
    let mut n: i64 = 1;
    let r = thread::scope(|s| ({ let s = s; {
        let h = s.spawn(move || { n += 10; n });
        h.join().unwrap()
    } }));
    println("{r} {n}");
}
