// EDITION: rust
// RULE: D3.6, R6
// (0.27.2) A call through a `fn` value relates its arguments: the erased
// `fn` type's lifetimes are one region, so every region of an argument is
// equal to every region under a `&mut` of another. `f` is `store` as a
// `fn` value, `store` writes `&v` into `*r`, and `v` dies before `*r` is
// read (rustc: E0597, through the fn item's `'a`).
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 22, column 20
// ERROR-COUNT: 1
fn store<'a>(x: &mut &'a i64, y: &'a i64) {
    *x = y;
}

fn main() {
    let f = store;
    let a = 1;
    let mut p: &i64 = &a;
    let r = &mut p;
    {
        let v = 2;
        f(&mut *r, &v);
    }
    println("{}", **r);
}
