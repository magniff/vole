// EDITION: rust
// RULE: D19.7, R3
// (0.27.2) A generic body calls its `FnOnce` parameter twice, given a
// `Copy` closure: the instance copies it, so it is accepted; rustc checks
// the template, where `F` is not `Copy`, and rejects it (E0382). Per
// instance checking (R3) until the opaque instance (0.27.2.1).
// RUSTC: rejects R3 the instance's F is Copy, the template's is not
// EXPECT: 4
fn twice<F: FnOnce() -> i64>(f: F) -> i64 {
    f() + f()
}

fn main() {
    let k = 2;
    println("{}", twice(move || k));
}
