// (0.30.1, review 4) An impl of a trait with a supertrait holds only where
// the supertrait's impl for its type holds: that impl's predicates must
// follow from this one's (rustc E0478). Sup's impls ask for `'a: 'b` (a
// `where`), `'a: 'static` (its header) and one lifetime at two places
// (`Z<'a, 'a>`); Sub's impls do not say them. Before, Sub's impl was taken
// as is, and a generic caller through `T: Sub` met Sup's methods with the
// borrowed lifetimes (review 4's c06, c11, c12).
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR: trait.unmet
// ERROR-COUNT: 3
trait Sup {
    type A;
}

trait Sub: Sup {
    fn get(&self) -> Self::A;
}

struct X<'p, 'q> {
    r: &'p str,
    s: &'q str,
}

struct Y<'p> {
    r: &'p str,
}

struct Z<'p, 'q> {
    r: &'p str,
    s: &'q str,
}

impl<'a, 'b> Sup for X<'a, 'b> where 'a: 'b {
    type A = &'b str;
}

impl<'a, 'b> Sub for X<'a, 'b> {
    fn get(&self) -> &'b str {
        self.s
    }
}

impl<'a: 'static> Sup for Y<'a> {
    type A = &'static str;
}

impl<'a> Sub for Y<'a> {
    fn get(&self) -> &'static str {
        "y"
    }
}

impl<'a> Sup for Z<'a, 'a> {
    type A = &'a str;
}

impl<'a, 'b> Sub for Z<'a, 'b> {
    fn get(&self) -> &'a str {
        self.r
    }
}

fn main() {}
