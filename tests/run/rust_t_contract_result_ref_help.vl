// EDITION: rust
// RULE: C3.3
// (0.27.1) An `ensures` of a `-> &mut i64` method reading `self`: the
// wrapper's `result` holds the mutable loan of `*self` until the return,
// so the read is borrowck.use_borrowed (D2.5), with the contract's help
// ("`self` is borrowed by `result`; state the promise on `*result` or on
// `old(..)`").
// ERROR: error[borrowck.use_borrowed]
// ERROR-COUNT: 1
struct S {
    x: i64,
}

impl S {
    fn get(&mut self) -> &mut i64
        ensures self.x >= 0
    {
        &mut self.x
    }
}

fn main() {
    let mut s = S { x: 1 };
    *s.get() += 1;
    println("{}", s.x);
}
