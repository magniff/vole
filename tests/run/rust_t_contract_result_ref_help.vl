// EDITION: rust
// RULE: C3.3
// (0.27.1) An `ensures` of a `-> &mut i64` method reading `self`: the
// wrapper's `result` holds the mutable loan of `*self` until the return,
// so the shared reborrow of `*self` the clause reads through is
// borrowck.conflict (D2.5, RB against an M loan), with the contract's help
// ("`self` is borrowed by `result`; state the promise on `*result` or on
// `old(..)`").
// ERROR: error[borrowck.conflict]
// ERROR-COUNT: 1
struct S {
    x: i64,
}

impl S {
    fn get(&mut self) -> &mut i64
        ensures self.x >= 0
    {
        &mut self.x
    }
}

fn main() {
    let mut s = S { x: 1 };
    *s.get() += 1;
    println("{}", s.x);
}
// (passes on std2: was XFAIL, std2 has no contract_check, which a contract's lowering calls (std2))
