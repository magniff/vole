// The std2 item(s): std::sync::atomic AtomicUsize; Atomic::impl Sync; Atomic::impl Send; fence.
// EXPECT: 4001 8000
use std::sync::atomic::{AtomicUsize, Ordering, fence};

static HITS: AtomicUsize = AtomicUsize::new(0);

fn main() {
    HITS.fetch_add(1, Ordering::Relaxed);
    let local = AtomicUsize::new(0);
    std::thread::scope(|s| {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..1000 {
                    HITS.fetch_add(1, Ordering::Relaxed);
                    local.fetch_add(2, Ordering::Relaxed);
                }
            });
        }
    });
    fence(Ordering::SeqCst);
    println("{} {}", HITS.load(Ordering::SeqCst), local.load(Ordering::Acquire));
}
