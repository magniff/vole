// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::char CharTryFromError.
// EXPECT: Err(CharTryFromError(())) true
use std::char::CharTryFromError;
use std::convert::TryFrom;

fn main() {
    let e: Result<char, CharTryFromError> = char::try_from(0xD800u32);
    println("{:?} {}", e, e == char::try_from(0x110000u32));
}
