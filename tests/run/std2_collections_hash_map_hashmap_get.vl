// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::get.
// EXPECT: Some(1) None Some(2)
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<String<Gpa>, i64, Gpa> = HashMap::new_in(gpa);
    m.insert("a".to_string_in(gpa), 1);
    m.insert("b".to_string_in(gpa), 2);
    println("{:?} {:?} {:?}", m.get("a"), m.get("z"), m.get(&"b".to_string_in(gpa)));
}
