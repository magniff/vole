// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::iter DoubleEndedIterator.
// EXPECT: 3 1

struct Two {
    a: i64,
    b: i64,
}

impl Iterator for Two {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.a <= self.b {
            self.a += 1;
            Some(self.a - 1)
        } else {
            None
        }
    }
}

impl DoubleEndedIterator for Two {
    fn next_back(&mut self) -> Option<i64> {
        if self.a <= self.b {
            self.b -= 1;
            Some(self.b + 1)
        } else {
            None
        }
    }
}

fn main() {
    let mut t = Two { a: 1, b: 3 };
    let x = t.next_back().unwrap();
    println("{} {}", x, t.next().unwrap());
}
