// RULE: E3.3b
// (0.28.0) In a program's function what is checked is all it does: a
// println, a Drop that prints reached by a drop (through Vec's), a
// closure it makes and calls. Each is io in a #[no_io] function.
// ERROR: 'say' is #[no_io], but it does io
// ERROR: 'quiet' is #[no_io], but it does io
// ERROR: 'calls' is #[no_io], but it does io
// ERROR-COUNT: 3
struct Noisy {
    n: i64,
}

impl Drop for Noisy {
    fn drop(&mut self) {
        println("dropped");
    }
}

#[no_io]
fn say(x: i64) -> i64 {
    println("{}", x);
    x
}

#[no_io]
fn quiet(v: Vec<Noisy, Gpa>) -> i64 {
    v.len() as i64
}

#[no_io]
fn calls(x: i64) -> i64 {
    let f = |y: i64| {
        println("{}", y);
        y
    };
    f(x)
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<Noisy, Gpa> = Vec::new_in(gpa);
    v.push(Noisy { n: 1 });
    println("{}", say(1) + quiet(v) + calls(2));
    0
}
