// XFAIL: RT-446i: UNSOUND: (RT-446's mechanism, a projection) (the store form) `v.o = &*b` into a field `o: X::O` (`type O = &'static u64` for Y) of a `&mut V<Y>` parameter, b a Box local, is accepted, and main reads it after the free; rustc E0597 (`*b` does not live long enough) (0.30.2)
// From the review of g302static (its form g10_assoc_field_store). Since v0.30.1 at
// least, and on the release build with g302static merged (the same use
// after free under --check-alloc). RT-446's root through a projection: the
// field's type is `X::O`, which normalizes to `&'static u64` for X = Y,
// and the region walk does not see the 'static in it.
// FLAGS: --check-alloc
// ERROR: line 27
trait Tr {
    type O;
}

struct Y;

impl Tr for Y {
    type O = &'static u64;
}

struct V<X: Tr> {
    o: X::O,
}

static S: u64 = 5;

fn set(v: &mut V<Y>, gpa: Gpa) {
    let b = Box::new_in(9u64, gpa);
    v.o = &*b;
}

fn main(gpa: Gpa) {
    let mut v: V<Y> = V { o: &S };
    set(&mut v, gpa);
    println("{}", v.o);
}
