// XFAIL: RT-18: a generic struct named like a type parameter breaks every instance of that parameter (open)
// A struct `T<X>` (or `K<X>`, `V<X>`: std's own parameter names) is a
// valid Rust name. Instantiating `get<T: Name>` with `T<u8>`, or
// `BTreeMap<K, V>` with `K<u8>`, resolves the method on the parameter
// to the struct with fresh arguments and refuses the instance.
// EXPECT: 6
// EXPECT: 7000
// EXPECT: 2 Less
use std::cmp::Ordering;
use std::collections::BTreeMap;

trait Name {
    fn name(&self) -> i64;
}

struct T<X> {
    a: i64,
    x: X,
}

impl<X> Name for T<X> {
    fn name(&self) -> i64 {
        self.a * 1000
    }
}

impl Name for i64 {
    fn name(&self) -> i64 {
        *self + 1
    }
}

fn get<T: Name>(x: &T) -> i64 {
    x.name()
}

struct K<X> {
    v: i64,
    x: X,
}

impl<X> PartialEq for K<X> {
    fn eq(&self, o: &Self) -> bool {
        self.v == o.v
    }
}

impl<X> Eq for K<X> {}

impl<X> PartialOrd for K<X> {
    fn partial_cmp(&self, o: &Self) -> Option<Ordering> {
        Some(self.cmp(o))
    }
}

impl<X> Ord for K<X> {
    fn cmp(&self, o: &Self) -> Ordering {
        self.v.cmp(&o.v)
    }
}

fn main(gpa: Gpa) {
    println("{}", get(&5i64));
    let t = T { a: 7, x: 1u8 };
    println("{}", get(&t));
    let mut b: BTreeMap<K<u8>, i64, Gpa> = BTreeMap::new_in(gpa);
    b.insert(K { v: 3, x: 1u8 }, 30);
    b.insert(K { v: 1, x: 2u8 }, 10);
    let a = K { v: 1, x: 0u8 };
    let c = K { v: 2, x: 0u8 };
    println("{} {:?}", b.len(), a.cmp(&c));
    let _ = t.x;
    let _ = a.x;
}
