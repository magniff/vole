// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::str CharIndices::impl DoubleEndedIterator.
// EXPECT: Some((3, 'c')) Some((0, 'a')) Some((1, 'ß')) None
use std::str::CharIndices;

fn main() {
    let mut it = "aßc".char_indices();
    let x = it.next_back();
    let y = it.next();
    let z = it.next_back();
    println("{:?} {:?} {:?} {:?}", x, y, z, it.next());
}
