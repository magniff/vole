// The std2 item(s): std::unicode's grapheme clusters against Unicode's own
// GraphemeBreakTest.txt (tests/std/unicode/, the tables' version, 18.0.0),
// every line: GraphemeState fed the code points one at a time, and
// graphemes, next_grapheme_end and count_graphemes over the line's UTF-8.
// RUSTC: none (vole's own: Rust's std has no segmentation)
// ARGS: @ROOT@/tests/std/unicode/GraphemeBreakTest.txt
// EXPECT: 853 lines, 0 wrong by state, 0 wrong by text
use std::unicode::{GraphemeState, count_graphemes, graphemes, next_grapheme_end};

fn encode(cp: u32, out: &mut Vec<u8, Gpa>) {
    if cp < 0x80 {
        out.push(cp as u8);
    } else if cp < 0x800 {
        out.push((0xc0 | (cp >> 6)) as u8);
        out.push((0x80 | (cp & 0x3f)) as u8);
    } else if cp < 0x10000 {
        out.push((0xe0 | (cp >> 12)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        out.push((0x80 | (cp & 0x3f)) as u8);
    } else {
        out.push((0xf0 | (cp >> 18)) as u8);
        out.push((0x80 | ((cp >> 12) & 0x3f)) as u8);
        out.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        out.push((0x80 | (cp & 0x3f)) as u8);
    }
}

fn main(gpa: Gpa) {
    let path = std::env::args().nth(1).unwrap();
    let text = std::fs::read_to_string_in(path, gpa).unwrap();
    let mut lines = 0;
    let mut wrong_state = 0;
    let mut wrong_text = 0;
    let mut cps: Vec<u32, Gpa> = Vec::new_in(gpa);
    // breaks[i]: a boundary before code point i
    let mut breaks: Vec<bool, Gpa> = Vec::new_in(gpa);
    let mut utf8: Vec<u8, Gpa> = Vec::new_in(gpa);
    let mut starts: Vec<usize, Gpa> = Vec::new_in(gpa);
    for line in text.lines() {
        let rule = match line.find('#') {
            Some(at) => &line[..at],
            None => line,
        };
        cps.clear();
        breaks.clear();
        let mut brk = false;
        for word in rule.split_whitespace() {
            if word == "\u{f7}" {
                brk = true;
            } else if word == "\u{d7}" {
                brk = false;
            } else {
                cps.push(u32::from_str_radix(word, 16).unwrap());
                breaks.push(brk);
            }
        }
        if cps.len() == 0 {
            continue;
        }
        lines += 1;
        let mut st = GraphemeState::new();
        let mut ok = true;
        for i in 0..cps.len() {
            if st.push(cps[i]) != breaks[i] {
                ok = false;
            }
        }
        if !ok {
            wrong_state += 1;
        }
        // the same boundaries as byte offsets of the line's UTF-8
        utf8.clear();
        starts.clear();
        let mut surrogate = false;
        for i in 0..cps.len() {
            if breaks[i] {
                starts.push(utf8.len());
            }
            if cps[i] >= 0xd800 && cps[i] < 0xe000 {
                surrogate = true;
            }
            encode(cps[i], &mut utf8);
        }
        if surrogate {
            continue;
        }
        let s = utf8.as_slice();
        let mut same = count_graphemes(s) == starts.len();
        let mut at = 0;
        let mut k = 0;
        for g in graphemes(s) {
            if k >= starts.len() || starts[k] != at {
                same = false;
            }
            let end = if k + 1 < starts.len() { starts[k + 1] } else { s.len() };
            if next_grapheme_end(s, at) != end || g.len() != end - at {
                same = false;
            }
            at += g.len();
            k += 1;
        }
        if !same || at != s.len() {
            wrong_text += 1;
        }
    }
    println("{lines} lines, {wrong_state} wrong by state, {wrong_text} wrong by text");
}
