// sem-own: an Add impl on an owned type (let self, let other) building a new value: each operand dropped once by its owner.
// EXPECT: 3
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }

impl Add for D<Gpa> {
    fn add(self, other: D<Gpa>) -> D<Gpa> {
        var v: Vec<i64, Gpa> = self.v.clone(); D { id: self.id + other.id, v: v }
    }
}

fn main(gpa: Gpa) {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    let c = a + b;
    println("{}", c.id);
}
