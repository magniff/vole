// Runs on std since 0.27.2's switch.
// The std item(s): std::str str::is_char_boundary.
// EXPECT: true true false true true false
use std::str::CharIndices;

fn main() {
    let s = "Löwe";
    println("{} {} {} {} {} {}", s.is_char_boundary(0), s.is_char_boundary(1),
        s.is_char_boundary(2), s.is_char_boundary(3), s.is_char_boundary(5), s.is_char_boundary(6));
}
