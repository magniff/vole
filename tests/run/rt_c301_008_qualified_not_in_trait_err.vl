// RULE: F8.4
// `<S as B>::m`, B declaring no m: rustc E0576. 0.30.1 called A's m.
// ERROR: error[trait.no_item]: no function or constant 'm' in trait 'B'
trait A { fn m(&self) -> i64; }
trait B { fn n(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn n(&self) -> i64 { 2 } }
fn main() { let s = S; println("{}", <S as B>::m(&s)); }
