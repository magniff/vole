// From the red team (RT-38f, 2026-11-15). A clause's views are chosen from
// the parameter's type as written, so `type R<'a> = &'a mut i64` gets none
// and `*p = 9` writes the caller's x. Written `p: &mut i64`, the same clause
// is refused: a clause writes nothing it did not make (RT-38).
// ERROR: cannot assign to '*p'
type R<'a> = &'a mut i64;

fn f(p: R<'_>) -> i64
    ensures {
    *p = 9;
    true
}

{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
