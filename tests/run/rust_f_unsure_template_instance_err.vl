// (0.30.1, review 3) A template whose generic check is unsure (a `where`
// predicate on a compound type, a generic method of a generic trait
// called through a bound) has each concrete instance borrow-checked
// whole, nothing left to the template: its U, a borrowed str, moved into
// a thread is refused there (rustc E0310 at the template). Before, the
// template's errors were dropped and the instance left them to it: a use
// after free on the thread.
// (The third error is the whole check's: an instance does not know which
// of its type arguments' lifetimes the caller wrote as one, RT-C301-14.)
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR: borrowck.outlives
// ERROR-COUNT: 3
use std::thread;
use std::fmt::Display;
use std::thread::JoinHandle;

fn go<T, U: Send + Display>(t: T, u: U, gpa: Gpa) -> JoinHandle<i64, Gpa> where Option<T>: Clone {
    thread::spawn_in(move || {
        println("thread {}", u);
        0i64
    }, gpa)
}

trait Tr<A> {
    fn f<B>(&self, a: A, b: B);
}

struct S;

impl Tr<i64> for S {
    fn f<B>(&self, a: i64, b: B) {}
}

fn run<X: Tr<i64>, U: Send + Display>(x: &X, u: U, gpa: Gpa) -> JoinHandle<i64, Gpa> {
    x.f(1i64, 0i64);
    thread::spawn_in(move || {
        println("thread {}", u);
        0i64
    }, gpa)
}

fn main(gpa: Gpa) {
    let h = {
        let st = String::from_in("hello heap string long", gpa);
        go(1i64, st.as_str(), gpa)
    };
    h.join();
    let k = {
        let st = String::from_in("hello heap string long", gpa);
        run(&S, st.as_str(), gpa)
    };
    k.join();
}
