// RT-61 (0.30.2): a reduction whose running value nothing in the loop reads
// but its own update is still vectorized (in lanes, combined after the
// loop), at every width, beside stores of other values; a scan (the
// running value stored) is not. The output is rustc's.
// EXPECT: 176 14 96 0 4784 4784 17
// EXPECT: [13, 88, 31, 36, 6, 38, 35, 94, 21, 10, 61, 77, 58, 4, 12, 82]
// CHECK-OPT: 2
// CHECK: fn sum_u8:
// CHECK: v16i8 = load
// CHECK: vbin.add
// CHECK: fn xor_u16:
// CHECK: v8i16 = load
// CHECK: vbin.xor
// CHECK: fn max_i32:
// CHECK: v4i32 = load
// CHECK: fn and_i64:
// CHECK: v2i64 = load
// CHECK: vbin.and
// CHECK: fn sum_store_i32:
// CHECK: v4i32 = load
// CHECK: vbin.add
// CHECK: store
// CHECK: fn min_i16:
// CHECK: v8i16 = load
// CHECK: fn scan_i32:
// CHECK-NOT: vbin
// CHECK: fn main:

#[inline(never)]
fn sum_u8(b: &[u8], n: usize) -> u8 {
    let mut acc: u8 = 0;
    for i in 0..n {
        acc = acc.wrapping_add(b[i]);
    }
    acc
}

#[inline(never)]
fn xor_u16(b: &[u16], n: usize) -> u16 {
    let mut acc: u16 = 0;
    for i in 0..n {
        acc = acc ^ b[i];
    }
    acc
}

#[inline(never)]
fn max_i32(b: &[i32], n: usize) -> i32 {
    let mut acc: i32 = 0;
    for i in 0..n {
        acc = acc.max(b[i]);
    }
    acc
}

#[inline(never)]
fn and_i64(b: &[i64], n: usize) -> i64 {
    let mut acc: i64 = -1;
    for i in 0..n {
        acc = acc & b[i];
    }
    acc
}

// A sum beside a store of another value: the store is per lane.
#[inline(never)]
fn sum_store_i32(a: &mut [i32], b: &[i32], n: usize) -> i32 {
    let mut acc: i32 = 0;
    for i in 0..n {
        acc = acc.wrapping_add(b[i]);
        a[i] = b[i].wrapping_mul(3);
    }
    acc
}

#[inline(never)]
fn min_i16(b: &[i16], n: usize) -> i16 {
    let mut acc: i16 = 100;
    for i in 0..n {
        acc = acc.min(b[i]);
    }
    acc
}

// The running value stored: a scan, left scalar.
#[inline(never)]
fn scan_i32(a: &mut [i32], b: &[i32], n: usize) -> i32 {
    let mut acc: i32 = 0;
    for i in 0..n {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc;
    }
    acc
}

fn main() {
    let mut b8: [u8; 100] = [0; 100];
    let mut b16: [u16; 100] = [0; 100];
    let mut s16: [i16; 100] = [0; 100];
    let mut b32: [i32; 100] = [0; 100];
    let mut b64: [i64; 100] = [0; 100];
    for i in 0..100 {
        let x = (i * 7919 + 13) % 97;
        b8[i] = x as u8;
        b16[i] = x as u16;
        s16[i] = x as i16 + 17;
        b32[i] = x as i32;
        b64[i] = -(x as i64);
    }
    let mut a: [i32; 100] = [0; 100];
    let r1 = sum_store_i32(&mut a, &b32, 100);
    let r2 = scan_i32(&mut a, &b32, 100);
    println("{} {} {} {} {} {} {}", sum_u8(&b8, 100), xor_u16(&b16, 100), max_i32(&b32, 100),
        and_i64(&b64, 100), r1, r2, min_i16(&s16, 100));
    let mut first: [i32; 16] = [0; 16];
    for i in 0..16 {
        first[i] = a[i] % 97;
    }
    println("{:?}", first);
}
