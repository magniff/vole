// EXPECT: 32
// (RT-270) `Z: Tr` met by the impl of the default, Tr<i32>.
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

struct W {
    r: i64,
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

impl Tr for i64 {
    fn g(&self) -> i64 {
        32
    }
}

fn c<Z: Tr>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", c(&5));
}
