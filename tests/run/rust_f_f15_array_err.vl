// EDITION: rust
// RULE: F15.3
// A length parameter has one value per instance: two arrays of two
// lengths where one N is wanted are a mismatch (rustc E0308).
// ERROR: array has 3 elements, expected 2
#[array_builtin(N)]
fn both(a: [i64; N], b: [i64; N]) -> usize {
    N
}

fn main() -> i64 {
    both([1, 2], [1, 2, 3]) as i64
}
