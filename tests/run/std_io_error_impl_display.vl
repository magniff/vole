// Runs on std since 0.27.2's switch.
// The std item(s): std::io Error::impl Display.
// EXPECT: msg
// EXPECT: Permission denied (os error 13)
// EXPECT: entity not found
use std::io::{ErrorKind, self};

fn main() {
    println("{}", io::Error::new(ErrorKind::Other, "msg"));
    println("{}", io::Error::from_raw_os_error(13));
    println("{}", io::Error::from(ErrorKind::NotFound));
}
