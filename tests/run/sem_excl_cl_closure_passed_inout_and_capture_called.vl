// EDITION: rust
// the closure is called inside the callee that also has n inout (through a generic helper)
// ERROR: error[borrowck.mut_twice]
// ERROR: line 6, column 80
fn run<F: FnMut()>(f: &mut F, x: &mut i64) -> i64 { let b = *x; f(); b * 100 + *x }
fn main() { let mut n: i64 = 1; let mut g = || { n = 5; }; let r = run(&mut g, &mut n); println("{r}"); }
