// EDITION: rust
// RULE: D2.4
// (0.27.1) NLL: a mutable loan ends at its last use, so `x` is read after
// it.

fn main() {
    let mut x: i64 = 1;
    let m = &mut x;
    *m += 1;
    let t = x;
    println("{}", t);
}
// EXPECT: 2
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
