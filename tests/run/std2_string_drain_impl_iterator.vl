// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::string Drain::impl Iterator.
// EXPECT: Some('b') Some('c') None

fn main(gpa: Gpa) {
    let mut s = String::from_in("abcd", gpa);
    let mut d = s.drain(1usize..3);
    let x = d.next();
    let y = d.next();
    println("{:?} {:?} {:?}", x, y, d.next());
}
