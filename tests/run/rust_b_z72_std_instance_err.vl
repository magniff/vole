// RULE: Z7.2, D8.4
// (0.27.4) A build leaves std's own non-generic bodies unsolved, but an
// instance of a std template that a program's type reaches is solved as
// before: a `Vec<D<'_>>` whose D's Drop uses its `&mut` keeps the loan
// alive to the Vec's drop, so writing x in between is an error (rustc
// E0506).
// ERROR: error[borrowck.assign_borrowed]:
struct D<'a> {
    r: &'a mut i32,
}

impl<'a> Drop for D<'a> {
    fn drop(&mut self) {
        *self.r += 1;
    }
}

fn main(gpa: Gpa) {
    let mut x = 0;
    let mut v = Vec::new_in(gpa);
    v.push(D { r: &mut x });
    x = 5;
    println("{}", v.len());
}
