// EDITION: rust
// XFAIL: gap 2: compile type error: no 'sys' in module 'std'
// EXPECT: echo: hello from a child
// EXPECT: exit 0 signal none
// EXPECT: false: exit 1
// EXPECT: env child: FOO=bar
// EXPECT: running true then killed by 9
// EXPECT: bad argv InvalidInput missing prog NotFound
// EXPECT: env count true at has = true PATH true
// EXPECT: set ok get v1 unset gone
// 0.20 (A7): std's OS layer on processes: pipe, posix_spawnp with file
// actions, waitpid (blocking and WNOHANG), the wait status, kill, and the
// environment (environ, getenv, setenv, unsetenv).
use std::sys::SYS_SIGKILL; use std::sys::SysErrorKind; use std::sys::SysSpawnActions;
use std::sys::sys_close; use std::sys::sys_env_at; use std::sys::sys_env_count;
use std::sys::sys_errno_kind; use std::sys::sys_exit_code; use std::sys::sys_exit_signal;
use std::sys::sys_getenv; use std::sys::sys_kill; use std::sys::sys_pipe; use std::sys::sys_read;
use std::sys::sys_setenv; use std::sys::sys_spawn; use std::sys::sys_spawn_actions;
use std::sys::sys_unsetenv; use std::sys::sys_waitpid;

// Runs argv with its stdout into a pipe: what it wrote, and its status.
fn run_capture(argv: &[*mut u8], envp: &[*mut u8], out: &mut [u8]) -> (i64, i32) {
    let p = sys_pipe().unwrap();
    let mut acts = sys_spawn_actions().unwrap();
    acts.dup2(p.1, 1i32).unwrap();
    acts.close(p.0).unwrap();
    let pid = unsafe { sys_spawn(argv[0], argv, envp, &mut acts) }.unwrap();
    acts.free();
    sys_close(p.1).unwrap();
    let mut n: i64 = 0;
    for _ in 0..100 {
        let k = sys_read(p.0, &mut out[n as usize..out.len()]).unwrap();
        if k == 0 {
            break;
        }
        n += k;
    }
    sys_close(p.0).unwrap();
    let w = sys_waitpid(pid, false).unwrap();
    (n, w.1)
}

fn show_signal(status: i32) -> i64 {
    match sys_exit_signal(status) {
        Some(s) => s as i64,
        None => -1,
    }
}

fn main() -> i32 {
    let mut out = [0u8; 256];
    let none: [*mut u8; 0] = [];
    let echo: [*mut u8; 5] = [c"echo", c"hello", c"from", c"a child", 0 as *mut u8];
    let r = run_capture(&echo[..], &none[..], &mut out[..]);
    print("echo: {}", &str::from_utf8(out[0..r.0 as usize]).unwrap());
    println(
        "exit {} signal {}", sys_exit_code(r.1).unwrap(),
        if show_signal(r.1) < 0 { "none" } else { "some" });

    let f: [*mut u8; 2] = [c"false", 0 as *mut u8];
    let r2 = run_capture(&f[..], &none[..], &mut out[..]);
    println("false: exit {}", sys_exit_code(r2.1).unwrap());

    let sh: [*mut u8; 4] = [c"/bin/sh", c"-c", c"echo FOO=$FOO", 0 as *mut u8];
    let env: [*mut u8; 2] = [c"FOO=bar", 0 as *mut u8];
    let r3 = run_capture(&sh[..], &env[..], &mut out[..]);
    print("env child: {}", &str::from_utf8(out[0..r3.0 as usize]).unwrap());

    let sl: [*mut u8; 3] = [c"sleep", c"10", 0 as *mut u8];
    let pid = unsafe { sys_spawn(sl[0], &sl[..], &none[..], 0 as *mut SysSpawnActions) }.unwrap();
    let w0 = sys_waitpid(pid, true).unwrap();
    sys_kill(pid, SYS_SIGKILL).unwrap();
    let w1 = sys_waitpid(pid, false).unwrap();
    println("running {} then killed by {}", w0.0 == 0, show_signal(w1.1));

    let bad: [*mut u8; 1] = [c"echo"];
    let e1 = match unsafe { sys_spawn(bad[0], &bad[..], &none[..], 0 as *mut SysSpawnActions) } {
        Ok(_) => SysErrorKind::Other,
        Err(e) => sys_errno_kind(e),
    };
    let missing: [*mut u8; 2] = [c"no-such-program-vole", 0 as *mut u8];
    let e2 = match unsafe {
        sys_spawn(missing[0], &missing[..], &none[..], 0 as *mut SysSpawnActions)
    } {
        Ok(p) => {
            // (glibc reports a missing program as the child's exit 127)
            let w = sys_waitpid(p, false).unwrap();
            if sys_exit_code(w.1).unwrap_or(0i32) == 127 { SysErrorKind::NotFound }
            else { SysErrorKind::Other }
        }
        Err(e) => sys_errno_kind(e),
    };
    println("bad argv {e1:?} missing prog {e2:?}");

    let n = sys_env_count();
    let mut has_eq = true;
    for i in 0..n {
        let v = sys_env_at(i);
        let mut found = false;
        for &c in v {
            if c == b'=' { found = true; }
        }
        if !found { has_eq = false; }
    }
    println("env count {} at has = {has_eq} PATH {}", n > 0, sys_getenv("PATH").is_some());

    let set = unsafe { sys_setenv("VOLE_SYS_TEST", "v1") };
    set.unwrap();
    let got = sys_getenv("VOLE_SYS_TEST").unwrap();
    print("set ok get {got}", got = str::from_utf8(got).unwrap());
    let unset = unsafe { sys_unsetenv("VOLE_SYS_TEST") };
    unset.unwrap();
    println(" unset {}", if sys_getenv("VOLE_SYS_TEST").is_none() { "gone" } else { "still" });
    0
}
