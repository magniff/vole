// RULE: F3.2
// A generic impl's constant belongs to the types its header applies to:
// `impl W<i64>`'s K is not `W<u8>`'s (rustc E0599).
// ERROR: no associated function 'K' in 'W<u8>'
struct W<T> {
    t: T,
}

impl W<i64> {
    const K: i64 = 1;
}

fn main() -> i64 {
    W::<i64>::K + W::<u8>::K
}
