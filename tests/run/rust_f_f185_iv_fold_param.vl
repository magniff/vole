// RULE: F18.5
// (0.30.2) The literal that starts a fold is an integer variable, which
// the closure's `s + x` with `x: &i64` types i64 (FL6's form: rustc
// infers it). 0.30.1 typed the `0` i32 first and refused `s + x`.
// EXPECT: 6000000003
fn main() {
    let v = [3000000000i64, 3000000000, 3];
    println("{}", v.iter().fold(0, |s, x| s + x));
}
