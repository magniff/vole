// sem-own: a user Iterator yielding owned items it pops: each dropped once by the consumer.
// EXPECT: got 2
// EXPECT: drop 2
// EXPECT: got 1
// EXPECT: drop 1
// EXPECT: end
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
struct Pop<A: Allocator> { v: Vec<D<A>, A> }

impl Iterator for Pop<Gpa> {
    type Item = D<Gpa>; fn next(inout self) -> Option<D<Gpa>> { self.v.pop() }
}

fn main(gpa: Gpa) {
    var p = Pop { v: Vec::new_in(gpa) };
    p.v.push(mk(1, gpa));
    p.v.push(mk(2, gpa));
    while let Some(d) = p.next() { println("got {}", d.id); }
    println("end");
}
