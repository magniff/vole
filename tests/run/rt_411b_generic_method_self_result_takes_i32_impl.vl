// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// The t302int branch, which makes RT-411 (the turbofish form) pass,
// still prints -294967296 here. i32's impl wraps, so -O0 and -O2 agree.
// EXPECT: 4000000000
trait Ad { fn ad<T>(self, t: T) -> Self; }
impl Ad for i32 { fn ad<T>(self, t: T) -> i32 { self.wrapping_add(self) } }
impl Ad for i64 { fn ad<T>(self, t: T) -> i64 { self + self } }

fn main() {
    let a = 2000000000;
    let c = a.ad(1u8);
    let d: i64 = c;
    println("{}", d);
}
