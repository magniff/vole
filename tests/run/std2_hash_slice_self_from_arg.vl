// RULE: F8.2
// The std2 item(s): std::hash [T]::impl Hash.
// (0.27.6) `[T]`'s hash writes the length, then calls
// `Hash::hash_slice(self, state)`, as Rust's does: Self is T, from the
// argument `&[Self]`, so an element type's own hash_slice runs (the 99).
// EXPECT: write [2, 0, 0, 0, 0, 0, 0, 0]
// EXPECT: write [99]
// EXPECT: write [1]
// EXPECT: write [2]
// EXPECT: 11
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

struct Tag(u8);

impl Hash for Tag {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u8(self.0);
    }

    fn hash_slice<H: Hasher>(data: &[Self], state: &mut H) {
        state.write_u8(99);
        for t in data {
            t.hash(state);
        }
    }
}

fn main() {
    let mut h = Show { n: 0 };
    let tags: [Tag; 2] = [Tag(1), Tag(2)];
    tags[..].hash(&mut h);
    println("{}", h.finish());
}
