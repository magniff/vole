// The std2 item(s): std::time Duration::checked_add; std::time Duration::checked_sub; std::time Duration::checked_mul; std::time Duration::checked_div; std::time Duration::saturating_add; std::time Duration::saturating_sub; std::time Duration::saturating_mul; std::time Duration::abs_diff; std::time Duration::mul_f64; std::time Duration::div_f64; std::time Duration::div_duration_f64; std::time Duration::impl Add; std::time Duration::impl AddAssign; std::time Duration::impl Sub; std::time Duration::impl SubAssign; std::time Duration::impl Mul; std::time Duration::impl MulAssign; std::time Duration::impl Div; std::time Duration::impl DivAssign.
// EXPECT: Some(2.5s) None Some(4.5s) Some(500ms) None
// EXPECT: 0ns 18446744073709551615.999999999s 1s
// EXPECT: 3s 750ms 2.5
// EXPECT: 2.5s 500ms 3s 1.5s true
use std::time::Duration;

fn main() {
    let a = Duration::new(1, 500000000);
    let b = Duration::from_secs(1);
    println("{:?} {:?} {:?} {:?} {:?}", a.checked_add(b), b.checked_sub(a), a.checked_mul(3u32),
        b.checked_div(2u32), b.checked_div(0u32));
    println("{:?} {:?} {:?}", b.saturating_sub(a), a.saturating_mul(u32::MAX).saturating_add(
        Duration::from_secs(u64::MAX)), a.abs_diff(Duration::from_millis(500)));
    println("{:?} {:?} {}", a.mul_f64(2.0), a.div_f64(2.0),
        a.div_duration_f64(Duration::from_millis(600)));
    let mut c = a + b;
    println("{:?} {:?} {:?} {:?} {}", c, c - a - Duration::from_millis(500), a * 2u32,
        (a * 2u32) / 2u32, c > a);
    c -= b;
    c += b;
    c *= 2u32;
    c /= 2u32;
    let _ = c;
}
