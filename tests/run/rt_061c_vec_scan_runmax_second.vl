// FLAGS: -O2
// From the red team (R302B-15, its sc3): every width, +, *, a running max, a
// second reduction of the running value. -O0 is rustc's output.
// EXPECT: 10 [0, 7, 7, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]
// EXPECT: 211540
#[inline(never)]
fn runmax(a: &mut [i32], b: &[i32]) -> i32 {
    let mut acc: i32 = -1000;
    for i in 0..a.len() {
        acc = if b[i] > acc { b[i] } else { acc };
        a[i] = acc;
    }
    acc
}

#[inline(never)]
fn cmpuse(b: &[i64]) -> i64 {
    let mut acc: i64 = 0;
    let mut c: i64 = 0;
    for i in 0..b.len() {
        acc = acc.wrapping_add(b[i]);
        c = c.wrapping_add(acc);
    }
    acc * 1000 + c
}

fn main() -> i32 {
    let mut b: [i32; 20] = [0; 20];
    let mut bl: [i64; 20] = [0; 20];
    for i in 0..20 {
        b[i] = ((i * 7) % 11) as i32;
        bl[i] = i as i64 + 1;
    }
    let mut a: [i32; 20] = [0; 20];
    println("{} {:?}", runmax(&mut a, &b), a);
    println("{}", cmpuse(&bl));
    0
}
