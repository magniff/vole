// RULE: F21.1, F21.2
// Slices and strs behind references: parameters, results, fields, locals
// and tuple elements of `&[T]`, `&mut [T]`, `&str`; `Sized` written as a
// bound says nothing more.
// EXPECT: 6 3 hi
struct View<'a> {
    xs: &'a [i64],
    name: &'a str,
}

fn sum(xs: &[i64]) -> i64 {
    let mut s = 0;
    for x in xs.iter() {
        s += *x;
    }
    s
}

fn bump(xs: &mut [i64]) {
    xs[0] += 1;
}

fn pick<'a>(p: (&'a str, i64)) -> &'a str {
    p.0
}

fn size<T: Sized>(x: T) -> i64 {
    1
}

fn main() {
    let mut v = [1, 2, 2];
    bump(&mut v);
    let w = View { xs: &v[..], name: "hi" };
    let t: (&str, i64) = (w.name, 3);
    println("{} {} {}", sum(w.xs), w.xs.len() as i64 * size(0), pick(t));
}
