// (0.29) A call that leaves out a message (`assert(ok)`: the one default
// argument left, F33.1) is checked without the caller's locals, which are
// put back after it, on an error too: two errors in one function, with
// such calls between them, are both reported, and the local they use
// (`width`) is known at the second as at the first.
// ERROR: error[type error]: function 'half' expects 1 arguments, got 2
// ERROR: line 17, column 13
// ERROR: error[type error]: expected 'bool', got 'i64'
// ERROR: line 20, column 19
// ERROR-COUNT: 2
fn half(n: i64) -> i64 {
    n / 2
}

fn main() {
    let width = 8;
    let a = half(width, 1);
    assert(width > 0);
    assert_eq(half(width), 4);
    let b: bool = half(width);
    println("{}", width);
}
