// EDITION: rust
// RULE: D2.4a
// (0.27.5) A rust body reads an operand where it is evaluated, left to
// right, as Rust: a call's argument before the next one changes it, an
// assignment's right side before its place (and its index) is evaluated,
// `=` and a primitive `op=` alike, a literal's element before the next.
// EXPECT: 12 5 6 7 1 2 2 3 3 4
struct P {
    a: i64,
    b: i64,
}

fn f(a: i64, b: i64) -> i64 {
    a * 10 + b
}

fn main() {
    let mut x = 1;
    let r = f(x, {
        x += 1;
        x
    });
    let mut v = [0i64; 2];
    let mut y = 5;
    v[{
        y += 1;
        0
    }] = y;
    v[{
        y += 1;
        1
    }] += y;
    let mut z = 1;
    let t = (z, {
        z += 1;
        z
    });
    let p = P {
        a: z,
        b: {
            z += 1;
            z
        },
    };
    let a = [z, {
        z += 1;
        z
    }];
    println("{} {} {} {} {} {} {} {} {} {}", r, v[0], v[1], y, t.0, t.1, p.a, p.b, a[0], a[1]);
}
