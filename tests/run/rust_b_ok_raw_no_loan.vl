// EDITION: rust
// RULE: D2.1
// (0.27.1) A reference cast to `*mut` at once: the loan ends with its
// temporary (R1), so `x` is written while the raw pointer lives.

fn main() {
    let mut x: i64 = 1;
    let p = &mut x as *mut i64;
    x += 1;
    unsafe {
        *p += 1;
    }
    println("{}", x);
}
// EXPECT: 3
