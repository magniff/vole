// are not judged: the functions that failed to check are unknown, and so
// are the closures they make, and std's instances made from them seemed
// to break their lists (`Vec::sort_by ... may panic`, `channel_in ... may
// panic` were reported beside the program's one error, which 0.30.0
// reported alone). They are judged when the program checks clean.
// ERROR: 'rwlock' is private
// ERROR-COUNT: 1
use std::sync::rwlock::RwLock;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(1);
    v.sort();
    let (tx, rx) = std::sync::mpsc::channel_in::<i64, Gpa>(gpa);
    let _ = tx.send(1);
    let _ = rx.try_recv();
    let rw = RwLock::new(1i64);
    let _ = rw.try_read();
    println("{}", v.len());
}
