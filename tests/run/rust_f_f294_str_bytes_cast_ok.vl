// RULE: F29.4
// (0.30.1) The checked ways between bytes and a str: `s.as_bytes()`,
// `str::from_utf8`; a pointer to its bytes, `s.as_ptr()`.
// EXPECT: 3 3 b true
fn main() {
    let s = "abc";
    let b: &[u8] = s.as_bytes();
    let arr = [0x61u8, 0x62, 0x63];
    let t = str::from_utf8(&arr[1..2]).unwrap();
    let p = s.as_ptr();
    println("{} {} {} {}", b.len(), str::from_utf8(b).unwrap().len(), t, !p.is_null());
}
