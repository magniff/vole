// EDITION: rust
// RULE: D8.5
// (0.27.2.1) `for x in v` moves v: a use after the loop is a use of a
// moved value (rustc E0382).
fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    for x in v {
        println("{}", x);
    }
    println("{}", v.len());
}
// ERROR: error[borrowck.use_moved]
