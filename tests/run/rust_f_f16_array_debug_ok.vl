// RULE: F16.4
// `{:?}` of an array, or of a reference to one, is its slice's on std2;
// and the signed integers' abs, every integer's pow (F15.4).
// EXPECT: [3, 2, 1]
// EXPECT: [3, 2, 1] [(1, 2), (3, 4)]
// EXPECT: 4 27 -1 1024
fn main() {
    let mut a = [1, 2, 3];
    a.swap(0, 2);
    println("{:?}", a);
    println("{:?} {:?}", &a, [(1, 2), (3, 4)]);
    println("{} {} {} {}", (-4i64).abs(), 3i32.pow(3), (-2i8).signum(), 2u64.pow(10));
}
