// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/c05_if_let)
// RUSTC: none contract clauses are not Rust
// EXPECT: 4
// if let binding named as the moved parameter.
struct N {
    v: i64,
}

fn take(n: N) -> i64 { n.v }

fn f(s: N) -> i64
    ensures if let Some(s) = Some(result) { s > 0 } else { false }

{
    take(s)
}

fn main() {
    println("{}", f(N { v: 4 }));
}
