// EDITION: rust
// RULE: D3.6
// (0.27.1) A result tied to both arguments, both live at its use.

fn longer<'a>(a: &'a i64, b: &'a i64) -> &'a i64 {
    if *a > *b {
        a
    } else {
        b
    }
}

fn main() {
    let a: i64 = 1;
    let b: i64 = 2;
    let r = longer(&a, &b);
    println("{}", *r);
}
// EXPECT: 2
