// XFAIL: RT-293: Iterator's try_fold, try_for_each, is_sorted_by and is_sorted_by_key are missing: "no method 'try_fold' on type 'Iter<i64>'" (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). Rust's stable Iterator
// methods checked against std/iter (r302f): these four are the ones absent
// (collect, partition and unzip are the `_in` forms; intersperse,
// advance_by, map_windows, try_reduce, try_find, array_chunks, cmp_by and
// is_partitioned are unstable in Rust). Slices have is_sorted_by.
// EXPECT: Some(6) None
// EXPECT: Err(2)
// EXPECT: true false
fn main() {
    let v = [1i64, 2, 3];
    let a = v.iter().try_fold(0i64, |s, x| s.checked_add(*x));
    let b = v.iter().try_fold(i64::MAX, |s, x| s.checked_add(*x));
    println("{:?} {:?}", a, b);
    let c: Result<(), i64> = v.iter().try_for_each(|x| if *x == 2 { Err(*x) } else { Ok(()) });
    println("{:?}", c);
    let d = v.iter().is_sorted_by(|p, q| p <= q);
    let e = v.iter().is_sorted_by_key(|x| -*x);
    println("{} {}", d, e);
}
