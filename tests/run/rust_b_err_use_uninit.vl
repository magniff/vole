// ERROR: line 24, column 24
// ERROR-COUNT: 2
fn main() {
    let y: i64;
    let z = y + 1;
    let w: i64;
    if z > 0 {
        w = 1;
    }
    let ok: i64;
    if z > 0 {
        ok = 1;
    } else {
        ok = 2;
    }
    println("{z} {ok} {w}");
}
