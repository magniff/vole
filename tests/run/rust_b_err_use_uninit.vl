// RULE: M8
// (0.28.0) A `let` with no value is read only where every path has
// assigned it: `let y: i64; println("{y}")` printed 0; it is rustc's
// E0381, for a value with a destructor too (it said "after it moved").
// Assigned on every path, it is read.
// ERROR: error[borrowck.use_uninit]: used binding 'y' is possibly-uninitialized (rustc E0381)
// ERROR: line 15, column 13
// ERROR: error[borrowck.use_uninit]: used binding 'v' is possibly-uninitialized (rustc E0381)
// ERROR: line 27, column 13
// ERROR: error[borrowck.use_uninit]: used binding 'w' is possibly-uninitialized (rustc E0381)
// ERROR: line 28, column 28
// ERROR-COUNT: 3
fn main(gpa: Gpa) {
    let y: i64;
    let z = y + 1;
    let w: i64;
    if z > 0 {
        w = 1;
    }
    let ok: i64;
    if z > 0 {
        ok = 1;
    } else {
        ok = 2;
    }
    let v: Vec<i64, Gpa>;
    let n = v.len();
    println("{z} {ok} {n} {w}");
    drop(gpa);
}
