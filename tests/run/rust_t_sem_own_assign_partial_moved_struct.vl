// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_assign_partial_moved_struct.vl to Rust's spelling.
// sem-own: assigning a whole struct after a field was moved out: only the unmoved field is dropped.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: end
// EXPECT: drop 3
// EXPECT: drop 4
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

struct P<A: Allocator> {
    a: D<A>,
    b: D<A>,
}

fn main(gpa: Gpa) {
    let mut p = P { a: mk(1, gpa), b: mk(2, gpa) };
    eat(p.a);
    p = P { a: mk(3, gpa), b: mk(4, gpa) };
    println("end");
}
