// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::option Option::and_then.
// EXPECT: Some(2) None None
use std::option::Option;

fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn main() {
    let none: Option<i64> = None;
    println("{:?} {:?} {:?}", Some(4).and_then(half), Some(3).and_then(half), none.and_then(half));
}
