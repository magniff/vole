use std::thread;
use std::sync::Mutex;
use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering;
struct St { m: Mutex<i64>, a: AtomicI64 }

fn main() {
    let st = St { m: Mutex::new(0i64), a: AtomicI64::new(0i64) };
    thread::scope(|s| ({ let s = s; {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..500 { st.m.with(|n| *n += 1); st.a.fetch_add(1, Ordering::Relaxed); } 0
            });
        }
        0
    } }));
    println("{} {}", st.m.with(|n| *n), st.a.load(Ordering::SeqCst));
}
