// EDITION: rust
// requires n > 0 makes x % n in 0..n only for x >= 0: -1 % 3 == -1.
// EXPECT: 20
// EXIT: 101
// STDERR: index out of bounds: index 18446744073709551615, length 3
static mut Z: i64 = 0;

fn pick(a: &[i64], x: i64, n: i64) -> i64
    requires n > 0 && n <= a.len() as i64
{
    a[(x % n) as usize]
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [10i64, 20, 30];
    println("{}", pick(&a[..], 4 + unsafe { Z }, 3));
    println("{}", pick(&a[..], -1 + unsafe { Z }, 3));
    0
}
