// The std item(s): std::result Result::ok; std::result Result::and; std::result Result::or; std::result Result::unwrap_or; std::option Option::unwrap_or; std::option Option::ok_or; std::option Option::and; std::option Option::or; std::option Option::xor; std::option Option::zip.
// (0.27.5) Each drops the part it does not return (a String here, whose
// drop frees it): its effects list that type parameter, so an instance
// over a type with drop glue checks. In 0.27.4 `Result::ok` was
// `#[effects()]`, the effect error "allocates from Gpa ... calls
// 'Vec::drop'".
// EXPECT: Some("a") None Ok(2) Err("e") 3 7
// EXPECT: "d" Ok("s") Some("y") Some("o") None Some(("p", "q"))
fn s(t: &str, gpa: Gpa) -> String<Gpa> {
    String::from_in(t, gpa)
}

fn main(gpa: Gpa) {
    let a: Result<String<Gpa>, String<Gpa>> = Ok(s("a", gpa));
    let b: Result<String<Gpa>, String<Gpa>> = Err(s("b", gpa));
    let c: Result<String<Gpa>, String<Gpa>> = Ok(s("c", gpa));
    let d: Result<i64, String<Gpa>> = Ok(2);
    let e: Result<i64, String<Gpa>> = Err(s("e", gpa));
    let f: Result<i64, String<Gpa>> = Ok(3);
    let g: Result<i64, String<Gpa>> = Err(s("g", gpa));
    println("{:?} {:?} {:?} {:?} {} {}", a.ok(), b.ok(), c.and(d),
        e.or::<String<Gpa>>(Err(s("e", gpa))), f.unwrap_or(0), g.unwrap_or(7));
    let n: Option<String<Gpa>> = None;
    let x: Option<String<Gpa>> = Some(s("s", gpa));
    let y: Option<String<Gpa>> = Some(s("x", gpa));
    let o: Option<String<Gpa>> = Some(s("o", gpa));
    let z: Option<String<Gpa>> = Some(s("z", gpa));
    let p: Option<String<Gpa>> = Some(s("p", gpa));
    println("{:?} {:?} {:?} {:?} {:?} {:?}", n.unwrap_or(s("d", gpa)), x.ok_or(s("err", gpa)),
        y.and(Some(s("y", gpa))), o.or(Some(s("other", gpa))), z.xor(Some(s("w", gpa))),
        p.zip(Some(s("q", gpa))));
}
