// EDITION: rust
// The std2 item(s): std::str str::to_lowercase_in (Final_Sigma); str::to_uppercase_in.
// EXPECT: οδος ΟΔΟΣ
// EXPECT: σας σας. ΣΑΣ ΣΑΣ.
// EXPECT: σ Σ
// EXPECT: aσ'b AΣ'B
// EXPECT: ας' ΑΣ'
// EXPECT: straße STRASSE
// EXPECT: i̇stanbul İSTANBUL
// EXPECT: ǆungla ǄUNGLA
// EXPECT: όσος και ΌΣΟΣ ΚΑΙ
// EXPECT: ας1 ΑΣ1
fn main(gpa: Gpa) {
    let words = ["ΟΔΟΣ", "ΣΑΣ ΣΑΣ.", "Σ", "AΣ'B", "ΑΣ'", "Straße", "İSTANBUL",
        "ǅungla", "ΌΣΟΣ ΚΑΙ", "ΑΣ1"];
    for w in words.iter() {
        println("{} {}", w.to_lowercase_in(gpa), w.to_uppercase_in(gpa));
    }
}
