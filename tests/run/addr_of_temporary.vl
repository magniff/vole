// XFAIL: gap 10: output: line 8: expected '-1 0 1', got '0 1 2' [rustc prints the MVS output: the rust edition is wrong]
// `&` of a value (0.18.1): a temporary, named by the checker, lives to the
// end of the block and is dropped there: `let r = &f(x);` (Rust's
// temporary lifetime extension), a call's argument `g(&f(x))`, nested,
// `&mut`, in a condition, in a loop; `&x.text()` is a slice (its own
// view), or a `&[u8]` where one is expected (`cmp_of`, whose T is then
// the slice). Nothing leaks (--check-alloc).
// FLAGS: --check-alloc
// EXPECT: 7
// EXPECT: 9
// EXPECT: 18
// EXPECT: 5
// EXPECT: 1 1
// EXPECT: 41
// EXPECT: big
// EXPECT: -1 0 1
// EXPECT: 18
#[derive(Clone, Copy)] struct P { x: i64, y: i64 }

#[derive(Clone, Copy)] struct T<'a> { s: &'a str }

impl<'a> T<'a> {
    fn text(self, a: i64) -> &'a str { &self.s[a as usize..] }
}

fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(3);
    v.push(4);
    v
}

fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for x in v { t += x; }
    t
}

fn px(p: P) -> i64 { p.x * 10 + p.y }

fn bump(p: &mut P) -> i64 {
    p.x += 1;
    p.x
}

fn tick(n: &mut i64) -> i64 {
    *n += 1;
    *n
}

fn main(gpa: Gpa) {
    println("{}", total(&mk(gpa)));
    let r = &mut mk(gpa);
    println("{}", r.len() as i64 + total(r));
    // (0.25: a temporary lent inout is conv.place; named first)
    let mut p5 = P { x: 5, y: 0 };
    println("{}", px(P { x: 1, y: 2 }) + bump(&mut p5));
    let s = "hello";
    println("{}", s.len());
    let mut c: i64 = 0;
    println("{} {c}", tick(&mut c));
    let q = (c + 40);
    println("{}", q);
    if total(&mk(gpa)) > 3 { println("big"); }
    let t = T { s: "hello" };
    let u = T { s: "help" };
    let a = t.text(1).cmp(&u.text(1)) as i64;
    let b = t.text(3).cmp(&t.text(3)) as i64;
    println("{a} {b} {}", u.text(3).cmp(&t.text(3)) as i64);
    let mut sum: i64 = 0;
    for i in 0..3 { sum += total(&mk(gpa)) - i; }
    println("{}", sum - total(&mk(gpa)) + 7);
}
