// (0.29.0) The scrutinee's temporaries of an `if let` on the ways out of
// its blocks (`continue`, `return`, `break`: dropped once, after the
// block's locals where the pattern matched, before the else block's
// where it did not), with a place for a scrutinee, and where the matching
// block's value is moved out of the scrutinee; and a let-else whose
// scrutinee is `&temporary`: kept to the end of the block where the
// pattern matches (rustc's extension), dropped before the else block
// where it does not. The output is rustc 2024's (tools/rustc-twin.sh).
// FLAGS: --check-alloc
// RUSTC-EDITION: 2024
// EXPECT: ext 1
// EXPECT: d1
// EXPECT: else
// EXPECT: 0
// EXPECT: ext 9
// EXPECT: got 1 2
// EXPECT: d2
// EXPECT: d1
// EXPECT: 9
// EXPECT: early 1
// EXPECT: d11
// EXPECT: else
// EXPECT: d31
// EXPECT: next
// EXPECT: d12
// EXPECT: break 32
// EXPECT: d32
// EXPECT: after
// EXPECT: 0
// EXPECT: early 5
// EXPECT: then 6
// EXPECT: d21
// EXPECT: d11
// EXPECT: next
// EXPECT: continue 22
// EXPECT: d22
// EXPECT: d12
// EXPECT: return 23
// EXPECT: d23
// EXPECT: d13
// EXPECT: 8
// EXPECT: early 6
// EXPECT: continue 21
// EXPECT: d21
// EXPECT: d11
// EXPECT: return 22
// EXPECT: d22
// EXPECT: d12
// EXPECT: 8
// EXPECT: none
// EXPECT: n 9
// EXPECT: d40
// EXPECT: has 41
// EXPECT: d40
// EXPECT: small
// EXPECT: d41
// EXPECT: moved 1
// EXPECT: d50
// EXPECT: have 51
// EXPECT: moved 9
// EXPECT: have 50
// EXPECT: end 51 50
// EXPECT: d50
// EXPECT: d51
struct T {
    id: i64,
    v: i64,
}

fn mk(id: i64, v: i64) -> T {
    T { id: id, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        println("d{}", self.id);
    }
}

fn big(t: &T) -> Option<i64> {
    if t.v > 5 { Some(t.v) } else { None }
}

fn own(t: T) -> Result<T, T> {
    if t.v > 5 { Ok(t) } else { Err(t) }
}

fn opt(t: T) -> Option<T> {
    if t.v > 5 { Some(t) } else { None }
}

fn ext(v: i64) -> i64 {
    println("ext {v}");
    let Some(x) = &opt(mk(1, v)) else {
        println("else");
        return 0;
    };
    let l = mk(2, 0);
    println("got {} {}", x.id, l.id);
    x.v
}

fn early(v: i64) -> i64 {
    println("early {v}");
    let mut i = 0;
    while i < 3 {
        i += 1;
        if let Some(n) = big(&mk(10 + i, v + i)) {
            let l = mk(20 + i, 0);
            if n == 7 {
                println("continue {}", l.id);
                continue;
            }
            if n == 8 {
                println("return {}", l.id);
                return n;
            }
            println("then {n}");
        } else {
            let l = mk(30 + i, 0);
            if i == 2 {
                println("break {}", l.id);
                break;
            }
            println("else");
        }
        println("next");
    }
    println("after");
    0
}

struct H {
    o: Option<T>,
}

fn place(h: &H) {
    if let Some(t) = &h.o {
        println("has {}", t.id);
    } else {
        println("none");
    }
    if let Some(n) = big(h.o.as_ref().unwrap_or(&mk(40, 9))) {
        println("n {n}");
    } else {
        println("small");
    }
}

fn moved(v: i64) -> T {
    println("moved {v}");
    let t = if let Ok(t) = own(mk(50, v)) { t } else { mk(51, 0) };
    println("have {}", t.id);
    t
}

fn main() -> i32 {
    println("{}", ext(1));
    println("{}", ext(9));
    println("{}", early(1));
    println("{}", early(5));
    println("{}", early(6));
    place(&H { o: None });
    place(&H { o: Some(mk(41, 1)) });
    let a = moved(1);
    let b = moved(9);
    println("end {} {}", a.id, b.id);
    0
}
