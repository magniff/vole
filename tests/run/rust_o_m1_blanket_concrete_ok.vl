// (0.30.2, obligations M1) rust_o_m1_blanket_concrete_err with the blanket
// impl chosen (V is a Sup): the concrete impl's `'a: 'static` is another
// impl's, not required. rustc accepts it.
// EXPECT: 1
trait Sup { fn up(&self) -> i64; }
trait Tr { fn f(&self) -> i64; }
struct W<'a> { r: &'a str }
struct V<'a> { r: &'a str }
impl<'a> Sup for V<'a> { fn up(&self) -> i64 { 1 } }
impl<T: Sup> Tr for T { fn f(&self) -> i64 { self.up() } }
impl<'a: 'static> Tr for W<'a> { fn f(&self) -> i64 { 2 } }
fn go<T: Tr>(t: &T) -> i64 { t.f() }

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa);
    println("{}", go(&V { r: st.as_str() }));
}
