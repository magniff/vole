// EDITION: rust
// RULE: D9.1
// (0.27.1) The container table: `Vec<&i64>`'s drop needs no element region
// live, so `x` declared after `v` is fine.
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<&i64, Gpa> = Vec::new_in(gpa);
    let x: i64 = 1;
    v.push(&x);
    println("{}", v.len());
    0
}
// EXPECT: 1
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
