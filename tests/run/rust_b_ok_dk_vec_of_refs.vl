// EDITION: rust
// RULE: D9.1
// (0.27.1) The container table: `Vec<&i64>`'s drop needs no element region
// live, so `x` declared after `v` is fine.
// RUSTC: none MVS std's Vec takes an allocator (the twin's subset has none until 0.27.3)
// XFAIL: ir271: `Vec<&i64, Gpa>` is a type error (`expected Vec<let i64, Gpa>, got Vec<*i64, Gpa>`)

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<&i64, Gpa> = Vec::new_in(gpa);
    let x: i64 = 1;
    v.push(&x);
    println("{}", v.len());
    0
}
// EXPECT: 1
