// RULE: D3.6
// (0.30.1) A `let` with a type, `let t: &mut [i64] = s;`, reborrows the
// exclusive reference it is given, as rustc's coercion site: s is used
// again once t is done. Without a type it moves (`let t = s;`). A shared
// coercion's reborrow ends with its last use. A view field of a Box or of
// a Vec element given to a call is reached through DerefMut and IndexMut
// (`fill(b.s)`, `fill(v[0].s)`), as `&mut b.s[..]` is. Before, the
// annotated `let` moved s (borrowck.use_moved), and `fill(b.s)` reborrowed
// the shared deref's `&W` mutably (borrowck.borrow_immutable naming a
// temporary).
// EXPECT: 2 1
// EXPECT: 9
// EXPECT: 4 4
// EXPECT: 1 3 1
// EXPECT: 5
struct W<'a> {
    s: &'a mut [i64],
    r: &'a mut i64,
}

fn fill(s: &mut [i64]) {
    s[0] = 1;
}

fn bump(r: &mut i64) {
    *r += 1;
}

fn main(gpa: Gpa) {
    let mut arr = [0i64, 1];
    let s: &mut [i64] = &mut arr;
    let t: &mut [i64] = s;
    t[0] = 1;
    s[0] = 2;
    println("{} {}", s[0], s[1]);
    let mut k = 1i64;
    let r: &mut i64 = &mut k;
    let u: &mut i64 = r;
    *u = 8;
    *r += 1;
    println("{}", *r);
    let b: &[i64] = s;
    let n = b[1] + 3;
    s[1] = n;
    println("{} {}", s[1], n);
    let mut a2 = [0i64, 0];
    let mut k2 = 0i64;
    let mut bx = Box::new_in(W { s: &mut a2, r: &mut k2 }, gpa);
    fill(bx.s);
    bx.s[1] = 3;
    bump(bx.r);
    println("{} {} {}", bx.s[0], bx.s[1], *bx.r);
    let mut a3 = [0i64, 0];
    let mut k3 = 4i64;
    let mut v: Vec<W, Gpa> = Vec::new_in(gpa);
    v.push(W { s: &mut a3, r: &mut k3 });
    fill(v[0].s);
    bump(v[0].r);
    println("{}", *v[0].r + v[0].s[0] - 1);
}
