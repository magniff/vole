// RULE: E2.1
// (0.28.0, gap 85) Loops that end by what is written are no `diverge`:
// `while i < n { ..; i += 1; }` with a bound that cannot change, `while
// let Some(p) = it.next()` over one of std's iterators that end by
// themselves, a `for` over std's adapters of such (map, filter, rev,
// enumerate, zip), and the iterator methods that loop that way (sum,
// count, max). The last element of a slice that is not empty is in
// bounds (`rev` is no `panic`), and a HashMap's lookup is a counted
// probe.
// EXPECT: 6 3 3 12 4 2 3 10 14 7
use std::collections::HashMap;

struct Grid {
    cap: usize,
}

impl Grid {
    #[effects()]
    fn cells(&self) -> usize {
        let mut i: usize = 0;
        let mut t: usize = 0;
        while i < self.cap {
            t += i;
            i += 1;
        }
        t
    }
}

#[effects()]
fn upto(n: i64) -> i64 {
    let mut t = 0;
    let mut i = 0;
    while i < n {
        t += i;
        i += 1;
    }
    t
}

#[effects()]
fn literal() -> i64 {
    let mut i = 0;
    while i < 3 {
        i += 1;
    }
    i
}

#[effects()]
fn indexed(v: &[i64]) -> usize {
    let mut i = 0;
    while i < v.len() {
        if i > 100 {
            break;
        }
        i += 1;
    }
    i
}

#[effects()]
fn doubled(v: &[i64]) -> i64 {
    v.iter().map(|x| *x * 2).sum()
}

#[effects()]
fn big(v: &[i64]) -> i64 {
    v.iter().filter(|x| **x > 1).count() as i64 + v
        .iter()
        .filter_map(|x| if *x > 2 { Some(*x) } else { None })
        .count() as i64
}

#[effects()]
fn largest(v: &[i64]) -> i64 {
    match v.iter().max() {
        Some(x) => *x,
        None => 0,
    }
}

#[effects()]
fn weighted(v: &[i64]) -> i64 {
    let mut it = v.iter().rev().enumerate();
    let mut t = 0;
    while let Some((k, x)) = it.next() {
        t += *x * (k as i64 + 1);
    }
    t
}

#[effects()]
fn dot(a: &[i64], b: &[i64]) -> i64 {
    let mut t = 0;
    for (x, y) in a.iter().zip(b.iter()) {
        t += *x * *y;
    }
    t
}

#[effects()]
fn lookup(m: &HashMap<i64, i64, Gpa>) -> i64 {
    m.get(&1).copied().unwrap_or(0)
}

fn main(gpa: Gpa) {
    let a = [1i64, 2, 3];
    let mut m = HashMap::new_in(gpa);
    m.insert(1i64, 7i64);
    let g = Grid { cap: 4 };
    println("{} {} {} {} {} {} {} {} {} {}", g.cells(), upto(3), literal(), doubled(&a),
        indexed(&a) + 1, big(&a) - 1, largest(&a), weighted(&a), dot(&a, &a), lookup(&m));
}
