// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::with_capacity_and_hasher_in.
// EXPECT: true Some(2)
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m = HashMap::with_capacity_and_hasher_in(20, FixedState::new(), gpa);
    m.insert(1i64, 2i64);
    let big = m.capacity() >= 20;
    println("{} {:?}", big, m.get(&1));
}
