// RULE: F18.5
// (0.30.2) `a.into()` with its target free, given by a call's i32
// parameter, of an a a later use makes i64: rustc's E0277.
// ERROR: the trait 'From<i64>' is not implemented for 'i32' (rustc E0277)
fn take(x: i32) -> i32 { x }

fn main() {
    let a = 5000000000;
    let r = a.into();
    println("{}", take(r));
    let c: i64 = a;
    println("{}", c);
}
