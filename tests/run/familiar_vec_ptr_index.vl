// XFAIL: gap 17: compile type error: cannot index into a value of type '*[i64]'
// 0.17: through a borrow of a Vec, a Buf or a slice (a reference, `&v`),
// `p[i]` indexes the pointee: `p.as_slice()[i]`, `(*p)[i]` for a slice;
// read, assign, compound-assign, slicing, generic; checked, safe. Through
// a raw `*[T]` (0.18.1: every `*T` parameter) it means the same, in unsafe.
// EXPECT: true false 7
// EXPECT: 1 9 7 -1
// EXPECT: azc z
// EXPECT: 16 16
// EXPECT: 2 9 3
// EXPECT: 9 7
fn relax(dist: &mut Vec<i64, Gpa>, u: i64, nd: i64) -> bool {
    if dist[u as usize] < 0 || nd < dist[u as usize] {
        dist[u as usize] = nd;
        return true;
    }
    false
}

fn bump(b: &mut Vec<u8, Gpa>, i: i64) -> &mut [u8] {
    b[i as usize] += 1;
    &mut b[i as usize..(i + 1) as usize]
}

fn total(s: *mut &[i64]) -> i64 {
    unsafe {
        let mut t: i64 = 0;
        for i in 0..(*s).len() {
            t += s[i];
        }
        s[0] = t;
        t
    }
}

fn mid(v: &Vec<i64, Gpa>) -> &[i64] { &v[1..3] }

fn tail(s: *mut &[i64]) -> &'static [i64] { unsafe { &s[1..] } }

fn at<T>(v: &Vec<T, Gpa>, i: i64) -> T { v[i as usize] }

fn main(gpa: Gpa) -> i32 {
    let mut d: Vec<i64, Gpa> = Vec::new_in(gpa);
    for _ in 0..4 {
        d.push(-1);
    }
    let a = relax(&mut d, 2, 7);
    let b = relax(&mut d, 2, 9);
    println("{a} {b} {}", d[2]);
    d[0] = 1;
    d[1] += 10;
    println("{} {} {} {}", d[0], d[1], d[2], d[3]);
    let mut buf = Vec::<u8, Gpa>::new_in(gpa);
    buf.extend_from_slice(b"abc");
    let one = bump(&mut buf, 1);
    one[0] = b'z';
    let one: &[u8] = one;
    print("{}", str::from_utf8(buf.as_slice()).unwrap());
    println(" {one}", one = str::from_utf8(one).unwrap());
    let mut s = d.as_slice();
    let t = total(&mut s);
    println("{t} {}", d[0]);
    let m = mid(&d);
    println("{} {} {}", m.len(), m[0], tail(&mut s).len());
    println("{} {}", at(&d, 1i64), (&mut d)[2]);
    0
}
