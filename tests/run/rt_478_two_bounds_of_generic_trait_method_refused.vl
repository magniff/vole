// XFAIL: RT-478: `x.g(true)` in `fn q<T: G<i64> + G<bool>>(x: T)` is refused, "expected 'i64', got 'bool'": the method of the first bound is taken without the second; rustc selects G<bool> by the argument and prints `2 1 32 0` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form g21_generic_trait_two_steps_in_generic.
// EXPECT: 2 1 32 0
trait G<X> {
    fn g(&self, x: X) -> i64;
}

struct W {
    k: i64,
}

impl G<i64> for W {
    fn g(&self, x: i64) -> i64 {
        1 + x * 0
    }
}

impl<'a> G<i64> for &'a W {
    fn g(&self, x: i64) -> i64 {
        2 + x * 0
    }
}

impl<'a> G<bool> for &'a W {
    fn g(&self, x: bool) -> i64 {
        if x { 3 } else { 0 }
    }
}

fn p<T: G<i64>>(x: T) -> i64 {
    let y = x;
    y.g(5)
}

fn q<T: G<i64> + G<bool>>(x: T) -> i64 {
    x.g(true) * 10 + x.g(5i64)
}

fn main() -> i32 {
    let w = W { k: 0 };
    println("{} {} {} {}", p(&w), p(W { k: 1 }), q(&w), w.k);
    0
}
