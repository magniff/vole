// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::get_unchecked_mut.
// EXPECT: [9, 2, 3]

fn main() {
    let mut a = [1, 2, 3];
    // UNSAFE: the call's contract.
    // SAFETY: 0 < len.
    unsafe {
        *a.get_unchecked_mut(0) = 9;
