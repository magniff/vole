// RULE: F18.5
// (0.30.2) A range of literals bound by a `let` and used as an index later
// is a range of usize, from the index (`SliceIndex`), as rustc infers it;
// 0.30.1 typed it Range<i32> at the let (RT-177c's family): an array's
// elements typed by the slice's annotation, a str's RangeFrom.
// EXPECT: [20, 30] llo 40
fn main() {
    let v = [10, 20, 30, 40];
    let r = 1..3;
    let a: &[i64] = &v[r];
    let s = "hello";
    let q = 2..;
    let k = 3;
    println("{:?} {} {}", a, &s[q], v[k]);
}
