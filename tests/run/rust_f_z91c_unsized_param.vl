// RULE: Z9.1c, F21.1
// (0.27.4) A `?Sized` parameter takes the unsized place (`T = str`, `T =
// [i64]`) through `&T`, and `size_of_val` reads its length; a written
// `&&[i64]` is a thin pointer, an `NonNull<[u8]>` and `*const [u8]` fat.
// EXPECT: "ab" 2
// EXPECT: [1, 2, 3] 24
// EXPECT: 8 16 16
use std::fmt::Debug;
use std::mem::{size_of, size_of_val};
use std::ptr::NonNull;

fn show<T: ?Sized + Debug>(x: &T) -> usize {
    let n = size_of_val(x);
    println("{:?} {}", x, n);
    n
}

fn main() {
    show("ab");
    let a = [1i64, 2, 3];
    show(&a[..]);
    println("{} {} {}", size_of::<&&[i64]>(), size_of::<NonNull<[u8]>>(), size_of::<*const [u8]>());
}
