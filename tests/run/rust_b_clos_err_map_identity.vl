// EDITION: rust
// RULE: D19.10
// (0.27.2) The same `map` and `|x| x`, with the result's lifetime not
// the argument's: the requirement checked at the call is 'a: 'b
// (rustc: lifetime may not live long enough).
// ERROR: error[borrowck.outlives]
enum Opt<T> {
    S(T),
    N,
}

impl<T> Opt<T> {
    fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Opt<U> {
        match self {
            Opt::S(x) => Opt::S(f(x)),
            Opt::N => Opt::N,
        }
    }
}

fn pick<'a, 'b>(o: Opt<&'a i64>) -> Opt<&'b i64> {
    o.map(|x| x)
}

fn main() {
    let a = 1;
    let _b = pick(Opt::S(&a));
}
