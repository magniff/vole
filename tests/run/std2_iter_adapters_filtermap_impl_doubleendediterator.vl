// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters FilterMap::impl DoubleEndedIterator.
// EXPECT: Some(30)
use std::iter::FusedIterator;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 3, -2], gpa);
    println("{:?}", s.iter().filter_map(|x| if *x > 0 { Some(x * 10) } else { None }).next_back());
}
