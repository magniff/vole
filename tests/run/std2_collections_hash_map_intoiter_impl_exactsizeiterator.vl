// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map IntoIter::impl ExactSizeIterator.
// EXPECT: 2
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 1);
    m.insert(2, 2);
    println("{}", m.into_iter().len());
}
