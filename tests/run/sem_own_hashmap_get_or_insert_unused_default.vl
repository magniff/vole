// sem-own: get_or_insert on a present key: the unused default is dropped once.
// EXPECT: drop 9
// EXPECT: end
// EXPECT: drop 1
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
use std::HashMap;

fn main(gpa: Gpa) {
    var m: HashMap<i64, D<Gpa>, Gpa> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    m.get_or_insert(1, mk(9, gpa));
    println("end");
}
