// (0.26.1) The baseline: a Copy struct that writes through `&self.v as
// *i64` is copied, as receiver and as let parameter, so both writes are
// lost. A cell is not Copy (std::cell); this one is a plain value.
// EXPECT: 1
// EXPECT: 1
struct MyCell { v: i64 }

impl MyCell {
    fn set(self, x: i64) {
        unsafe {
            let p = &self.v as *i64;
            *p = x;
        }
    }

    fn get(self) -> i64 {
        self.v
    }
}

#[inline(never)]
fn write_param(c: MyCell, x: i64) {
    c.set(x);
}

fn main() {
    let c = MyCell { v: 1 };
    c.set(2);
    println("{}", c.get());
    write_param(c, 3);
    println("{}", c.get());
}
