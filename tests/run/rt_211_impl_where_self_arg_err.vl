// RT-211's second review (A/a09_where_self_bound): an impl's `where i64: Conv<Self>`, a predicate on
// a subject that is no parameter of the impl, met by the only impl,
// `impl Conv<W<'static>> for i64`, makes the impl's 'a 'static where it is
// chosen (places/regions.vl impl_where_ties; the parser keeps the
// predicate on the impl, front::traits::own_impl_where_preds). Accepted
// before (latent: the body does not use the 'static). rustc: E0597.
// ERROR: error[borrowck.
trait Conv<X> {
    fn c(&self, x: &X) -> &'static str;
}

trait Tr {
    fn g(&self) -> &'static str;
}

struct W<'a> {
    r: &'a str,
}

impl Conv<W<'static>> for i64 {
    fn c(&self, x: &W<'static>) -> &'static str {
        x.r
    }
}

impl<'a> Tr for W<'a>
    where
        i64: Conv<Self>,
{
    fn g(&self) -> &'static str {
        "x"
    }
}

fn need<Z: Tr>(z: &Z) -> &'static str {
    z.g()
}

fn main(gpa: Gpa) {
    let mut keep: &'static str = "none";
    {
        let st = String::from_in("hello hello hello hello", gpa);
        let w = W { r: st.as_str() };
        keep = need(&w);
    }
    let other = String::from_in("XXXXXXXXXXXXXXXXXXXXXXX", gpa);
    println("{} {}", keep, other.len());
}
