// RULE: M1
// (0.30.1) `s;` moves s (rustc E0382: borrow of moved value `s`).
// ERROR: error[borrowck.use_moved]
// ERROR: line 23, column 24
// ERROR-COUNT: 1
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn peek(d: &D) -> i64 {
    d.v
}

fn main() {
    let s = D { v: 1 };
    s;
    println("{}", peek(&s));
}
