// XFAIL: RT-124: an associated constant used in a const item that is a match pattern is not a compile-time constant (RT-124's form) (0.30.2)
// From the g302qual review (form f02b_pattern_via_const).
// EXPECT: 10 20 0
trait A { const K: i64; }
trait B { const K: i64; }
struct S;
impl A for S { const K: i64 = 1; }
impl B for S { const K: i64 = 2; }
const BK: i64 = <S as B>::K;
const AK: i64 = <S as A>::K;
fn cls(x: i64) -> i64 { match x { BK => 20, AK => 10, _ => 0 } }
fn main() { println("{} {} {}", cls(1), cls(2), cls(3)); }
