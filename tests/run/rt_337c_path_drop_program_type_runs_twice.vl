// XFAIL: RT-337: `W::drop(&mut a)` with only `impl Drop for W` is accepted (rustc E0040), and the Drop runs twice (0.30.2)
// From the re-review of g302index.
// ERROR: line 17
struct W<T> {
    t: T,
    k: i64,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("Drop {}", self.k);
    }
}

fn main() {
    let mut a = W { t: 1i64, k: 1 };
    W::drop(&mut a);
    println("end");
}
