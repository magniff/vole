// EDITION: rust
// XFAIL: gap 8: compile borrowck.outlives: the lifetime of 'word' must outlive the lifetime of 'names': a reference of the...
// 0.17 (value semantics, T3): view summaries inferred callees first. Each
// call below is clean only because its callee's summary is precise, not
// one region: a parser method returning a view of its tokens' text is
// views(*self), so the parser can move on while the view lives; a
// recursive pair is views(s); intern stores into 'names' only, not into
// the map beside it (the type filter); a generic result (Vec::get) is the
// T value, not a loan on the Vec.
// EXPECT: ab cd
// EXPECT: yz 2
// EXPECT: ab 1
use std::alloc::Allocator; use std::collections::HashMap;
#[derive(Clone, Copy)] struct Tok<'a> { text: &'a str, k: i64 }
struct Parser<'a, A: Allocator> { toks: Vec<Tok<'a>, A>, pos: i64 }

impl<'a> Parser<'a, Gpa> {
    fn name(&mut self) -> &str {
        let t = self.toks[self.pos as usize];
        self.pos += 1;
        t.text
    }
}

fn even(n: i64, s: &str) -> &str {
    if n == 0 { s } else { odd(n - 1, s) }
}

fn odd(n: i64, s: &str) -> &str {
    if n == 0 { &s[1..] } else { even(n - 1, s) }
}

fn intern(ids: &mut HashMap<&str, i64, Gpa>, names: &mut Vec<&str, Gpa>, word: &str) -> i64 {
    match ids.get(&word).copied() {
        Some(i) => i,
        None => {
            names.push(word);
            ids.insert(word, names.len() as i64 - 1);
            names.len() as i64 - 1
        }
    }
}

fn main(gpa: Gpa) {
    let mut p = Parser { toks: Vec::new_in(gpa), pos: 0 };
    p.toks.push(Tok { text: "ab", k: 1 });
    p.toks.push(Tok { text: "cd", k: 1 });
    let a = p.name();
    let b = p.name();
    println("{a} {b}");
    let s = even(3, "xyz");
    let mut ids: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    let mut names: Vec<&str, Gpa> = Vec::new_in(gpa);
    intern(&mut ids, &mut names, "ab");
    let n = intern(&mut ids, &mut names, "cd");
    println("{s} {}", ids.len());
    let first = names[0usize];
    intern(&mut ids, &mut names, "ab");
    println("{first} {n}");
}
