// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::char char::is_whitespace.
// EXPECT: true true true true false

fn main() {
    println("{} {} {} {} {}", ' '.is_whitespace(), '\n'.is_whitespace(), '\u{A0}'.is_whitespace(),
        '\u{3000}'.is_whitespace(), 'x'.is_whitespace());
}
