// 0.9: operator overloading through std's traits (Add, Sub, Mul, Div, Neg,
// Eq, Ord), and generic code over them, which builtin types satisfy
// without impls.
use std::ops::Add; use std::ops::Sub; use std::ops::Mul; use std::ops::Div; use std::ops::Neg;

#[derive(Clone, Copy)] struct Vec2 { x: i64, y: i64 }

impl Add for Vec2 { type Output = Vec2;
    fn add(self, other: Vec2) -> Vec2 { Vec2 { x: self.x + other.x, y: self.y + other.y } }
}

impl Sub for Vec2 { type Output = Vec2;
    fn sub(self, other: Vec2) -> Vec2 { Vec2 { x: self.x - other.x, y: self.y - other.y } }
}

impl Mul for Vec2 { type Output = Vec2;
    fn mul(self, other: Vec2) -> Vec2 { Vec2 { x: self.x * other.x, y: self.y * other.y } }
}

impl Div for Vec2 { type Output = Vec2;
    fn div(self, other: Vec2) -> Vec2 { Vec2 { x: self.x / other.x, y: self.y / other.y } }
}

impl Neg for Vec2 { type Output = Vec2;
    fn neg(self) -> Vec2 { Vec2 { x: -self.x, y: -self.y } }
}

// Equal when x is: the impl wins over the structural ==.
impl PartialEq for Vec2 {
    fn eq(&self, other: &Vec2) -> bool { self.x == other.x }
} impl Eq for Vec2 {}

// By x, then y.
impl Ord for Vec2 {
    fn cmp(&self, other: &Vec2) -> std::cmp::Ordering { ({
        if self.x != other.x { self.x - other.x } else { self.y - other.y }
    }).cmp(&0) }
} impl PartialOrd for Vec2 { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } }

fn show(v: Vec2) {
    print("(");
    print("{}", v.x);
    print(", ");
    print("{}", v.y);
    println(")");
}

fn sum<T: Add>(items: &[T], zero: T) -> T {
    let mut total = zero;
    for &x in items {
        total = total + x;
    }
    total
}

fn print_bool(b: bool) {
    print("{}", if b { "true" } else { "false" });
}

fn main() -> i32 {
    let a = Vec2 { x: 1, y: 2 };
    let b = Vec2 { x: 3, y: 4 };
    show(a + b);
    show(a - b);
    show(a * Vec2 { x: 3, y: 3 });
    show(b / Vec2 { x: 3, y: 2 });
    show(-a);
    print("equal ");
    print_bool(a == Vec2 { x: 1, y: 99 });
    print(" ");
    print_bool(a != Vec2 { x: 1, y: 0 });
    println("");
    print("less ");
    print_bool(a < b);
    print(" ");
    print_bool(b <= a);
    print(" ");
    print_bool(a >= Vec2 { x: 1, y: 2 });
    println("");
    let vs = [Vec2 { x: 1, y: 2 }, Vec2 { x: 4, y: 8 }, Vec2 { x: 5, y: 10 }];
    print("sum ");
    show(sum(&vs[..], Vec2 { x: 0, y: 0 }));
    let mut ns = [5i64, 3, 8, 1, 2];
    ns.sort_unstable();
    print("sorted");
    for n in ns {
        print(" ");
        print("{}", n);
    }
    println("");
    let mut ps = [Vec2 { x: 2, y: 2 }, Vec2 { x: 1, y: 0 }, Vec2 { x: 0, y: 1 }];
    ps.sort_unstable();
    print("points");
    for p in ps {
        print(" (");
        print("{}", p.x);
        print(", ");
        print("{}", p.y);
        print(")");
    }
    println("");
    if sum(&[1i64, 2, 3][..], 0i64) != 6 {
        return 1;
    }
    0
}
