// FLAGS: --check-alloc
// RULE: F35.1 (0.30.2, RT-148) A repeat of length 0 makes no element: its
// value, when it is not a constant, is made and dropped at once, before
// anything after it (an argument's next, a match's arm, a `let` that
// borrows the array, a struct's next field); `[C; 0]` of a constant makes
// nothing; `[x; 1]` moves x. The output is rustc's.
// EXPECT: mk 1
// EXPECT: drop 1
// EXPECT: take 0
// EXPECT: mk 2
// EXPECT: drop 2
// EXPECT: take 0
// EXPECT: n 2
// EXPECT: mk 3
// EXPECT: drop 3
// EXPECT: arm
// EXPECT: mk 4
// EXPECT: drop 4
// EXPECT: r 0
// EXPECT: mk 5
// EXPECT: drop 5
// EXPECT: h 6 0
// EXPECT: c 0
// EXPECT: mk 7
// EXPECT: one 7
// EXPECT: drop 8
// EXPECT: z 0
// EXPECT: drop 7
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

struct H {
    a: [D; 0],
    n: i64,
}

const C: D = D { k: 9 };

fn mk(k: i64) -> D {
    println("mk {}", k);
    D { k }
}

fn take(a: [D; 0]) -> i64 {
    println("take {}", a.len());
    1
}

fn main() {
    let n = take([mk(1); 0]) + take([mk(2); 0]);
    println("n {}", n);
    match [mk(3); 0] {
        _ => println("arm"),
    }
    let r = &[mk(4); 0];
    println("r {}", r.len());
    let h = H { a: [mk(5); 0], n: 6 };
    println("h {} {}", h.n, h.a.len());
    let c = [C; 0];
    println("c {}", c.len());
    let one = [mk(7); 1];
    println("one {}", one[0].k);
    let d = D { k: 8 };
    let z = [d; 0];
    println("z {}", z.len());
}
