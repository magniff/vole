// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc Arena::alloc_str.
// EXPECT: HI 2
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main(gpa: Gpa) {
    let arena = Arena::new_in(gpa);
    let s: &mut str = arena.alloc_str("hi");
    s.make_ascii_uppercase();
    println("{} {}", s, arena.used());
}
