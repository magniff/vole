// XFAIL: RT-61: a reduction whose running value is used in the loop is vectorized as lane partials at -O2 (0.30.2)
// FLAGS: -O2
// From the red team (R302B-15, its sc2): every width, +, *, a running max, a
// second reduction of the running value. -O0 is rustc's output.
// EXPECT: 210 [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 66, 78, 91, 105, 120, 136, 153, 171, 190, 210]
// EXPECT: 255 [1, 3, 7, 15, 31, 63, 127, 255, 254, 252, 248, 240, 224, 192, 128, 0, 1, 3, 7, 15, 31, 63, 127, 255, 254, 252, 248, 240, 224, 192, 128, 0, 1, 3, 7, 15, 31, 63, 127, 255]
// EXPECT: 27776 [2, 3, 7, 7, 13, 37, 37, 73, 217, 217, 433, 1297, 1297, 2593, 7777, 7777, 15553, -18879, -18879, 27777]
// EXPECT: 10 [0, 7, 7, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10]
#[inline(never)]
fn scan32(a: &mut [i32], b: &[i32]) -> i32 {
    let mut acc: i32 = 0;
    for i in 0..a.len() {
        acc = acc.wrapping_add(b[i]);
        a[i] = acc;
    }
    acc
}

#[inline(never)]
fn scan8(a: &mut [u8], b: &[u8]) -> u8 {
    let mut acc: u8 = 0;
    for i in 0..a.len() {
        acc = acc ^ b[i];
        a[i] = acc;
    }
    acc
}

#[inline(never)]
fn scan16_mul(a: &mut [i16], b: &[i16]) -> i16 {
    let mut acc: i16 = 1;
    for i in 0..a.len() {
        acc = acc.wrapping_mul(b[i]);
        a[i] = acc.wrapping_add(1);
    }
    acc
}

#[inline(never)]
fn scan16_max(a: &mut [u16], b: &[u16]) -> u16 {
    let mut acc: u16 = 0;
    for i in 0..a.len() {
        acc = acc.max(b[i]);
        a[i] = acc;
    }
    acc
}

fn main() -> i32 {
    let mut b32: [i32; 20] = [0; 20];
    let mut b8: [u8; 40] = [0; 40];
    let mut b16: [i16; 20] = [0; 20];
    let mut u16s: [u16; 20] = [0; 20];
    for i in 0..20 {
        b32[i] = i as i32 + 1;
        b16[i] = (i as i16) % 3 + 1;
        u16s[i] = ((i * 7) % 11) as u16;
    }
    for i in 0..40 {
        b8[i] = (1u32 << (i % 8)) as u8;
    }
    let mut a32: [i32; 20] = [0; 20];
    let mut a8: [u8; 40] = [0; 40];
    let mut a16: [i16; 20] = [0; 20];
    let mut au: [u16; 20] = [0; 20];
    println("{} {:?}", scan32(&mut a32, &b32), a32);
    println("{} {:?}", scan8(&mut a8, &b8), a8);
    println("{} {:?}", scan16_mul(&mut a16, &b16), a16);
    println("{} {:?}", scan16_max(&mut au, &u16s), au);
    0
}
