// RULE: AT6
// (0.27.2) Two threads of one scope both write a counter: two `&mut`
// loans that each last to the end of 'scope (rustc E0499).
use std::thread;

fn main() {
    let mut total = 0;
    thread::scope(|s| {
        s.spawn(|| {
            total += 1;
        });
        s.spawn(|| {
            total += 2;
        });
    });
    println("{}", total);
}
