// (0.30.1, review 6) A Drop impl is read from resolved types and
// predicates, never from the text. Selection erases lifetimes, so a drop
// written for `V<concrete>` runs on every lifetime of it: a type argument
// that is not a parameter of the impl must hold no lifetime once resolved
// (the header's own `'c` reused in it, an alias of `&'static str`, a
// projection, an alias in a wrapper, `L<'static>` by an alias, an elided
// lifetime: rustc E0366). A bound is the declaration's only when it
// resolves to the same trait with the same arguments (another `Tr` of the
// same name, `Tr<U>` with another U: E0367). And a Drop impl is for a
// struct, enum or union of the program (not a tuple, a reference, an
// array: E0120). Before, each of these was accepted, and `drop` stored a
// short str as `'static` or never ran.
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: the trait 'Tr' is not implemented for 'T'
// ERROR: trait.drop_impl
// ERROR: the trait 'Tg<X>' is not implemented for 'T'
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// (0.30.2, RT-275: the impls whose bound is not the type's declaration's, d66
// and d67, are E0277 at their header too, as rustc says: the type the impl
// is for does not meet its declaration's bound)
// ERROR-COUNT: 16
use std::alloc::Allocator;

// (d29: the header's 'c in a concrete argument)
struct Vc<'b, 'c, T, A: Allocator> { t: T, out: &'b mut Vec<&'c str, A> }

impl<'b, 'c, A: Allocator> Drop for Vc<'b, 'c, &'c str, A> {
    fn drop(&mut self) { self.out.push(self.t); }
}

struct V<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }
struct Va<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }
struct Vp<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }
struct Vw<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }
struct Vl<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }
struct Ve<'b, T, A: Allocator> { t: T, out: &'b mut Vec<&'static str, A> }

// (d01: an alias of `&'static str`)
type Sr = &'static str;

impl<'b, A: Allocator> Drop for Va<'b, Sr, A> {
    fn drop(&mut self) { self.out.push(self.t); }
}

// (d03: a projection that is `&'static str`)
trait Tr { type A; }
impl Tr for i64 { type A = &'static str; }

impl<'b, Al: Allocator> Drop for Vp<'b, <i64 as Tr>::A, Al> {
    fn drop(&mut self) { self.out.push(self.t); }
}

// (d10: the alias inside a wrapper)
struct Wr<T> { x: T }

impl<'b, A: Allocator> Drop for Vw<'b, Wr<Sr>, A> {
    fn drop(&mut self) { self.out.push(self.t.x); }
}

// (d11: `L<'static>` by an alias)
struct L<'x> { s: &'x str }
type LS = L<'static>;

impl<'b, A: Allocator> Drop for Vl<'b, LS, A> {
    fn drop(&mut self) { self.out.push(self.t.s); }
}

// (d06: an elided lifetime in the argument)
impl<'b, A: Allocator> Drop for V<'b, &str, A> {
    fn drop(&mut self) { self.out.push(self.t); }
}

// (d15: `L<'_>`)
impl<'b, A: Allocator> Drop for Ve<'b, L<'_>, A> {
    fn drop(&mut self) { self.out.push(self.t.s); }
}

// (d27: another trait of the same name)
mod a {
    pub trait Tr {}
    pub struct W<T: Tr> { pub t: T }
}

mod b {
    pub trait Tr { fn name(&self) -> i64; }
}

impl<T: b::Tr> Drop for a::W<T> {
    fn drop(&mut self) { println("drop {}", self.t.name()); }
}

// (d67: `Tr<U>` whose U is another parameter)
trait Tg<X> { fn name(&self) -> i64; }
struct Wg<T: Tg<U>, U, X> { t: T, u: U, v: X }

impl<T: Tg<U>, X, U> Drop for Wg<T, X, U> {
    fn drop(&mut self) { println("drop {}", self.t.name()); }
}

// (d50-d54: not a struct, enum or union of the program)
impl Drop for (i64, i64) {
    fn drop(&mut self) { println("drop tuple {}", self.0); }
}

impl Drop for &'static str {
    fn drop(&mut self) { println("drop {}", *self); }
}

struct R<'b> { r: &'b str }

impl<'a, 'b> Drop for &'a R<'b> where 'a: 'static {
    fn drop(&mut self) { println("drop ref {}", self.r); }
}

struct Q<'a> { r: &'a str }

impl Drop for [Q<'static>; 1] {
    fn drop(&mut self) { println("drop arr"); }
}

// (an alias of a reference, resolved first)
type Rs = (u8, u8);

impl Drop for Rs {
    fn drop(&mut self) { println("drop alias"); }
}

fn main() {}
