// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result::iter.
// EXPECT: Some(3) None
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let mut i = a.iter();
    let x = i.next();
    println("{:?} {:?}", x, b.iter().next());
}
