// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::vec Vec::impl PartialEq<[U]>; std::vec Vec::impl PartialEq<&[U]>.
// EXPECT: true false
use std::vec::Vec;

fn main(gpa: Gpa) {
    let v = Vec::from_in([1i64, 2], gpa);
    let s: &[i64] = &[1, 2];
    println("{} {}", v == s, v == s[..1]);
}
