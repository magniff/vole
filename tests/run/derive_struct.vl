// XFAIL: gap 2: compile type error: no associated function 'to_fd' in 'Formatter'
// EXPECT: P { x: 0, y: 9 } P { x: 1, y: 2 } P { x: 1, y: 3 }
// EXPECT: lt true eq true cmp -1 1 0
// EXPECT: map 20 10 none len 2
// EXPECT: same hash true
// EXPECT: Named { id: 7, name: "seven", at: P { x: 1, y: 2 } }
// EXPECT: Empty
// EXPECT: deep 3 1
// EXPECT: buf ab a
// 0.15: #[derive(Eq, Ord, Hash, Debug, Clone)] on structs: Ord is
// lexicographic over the fields in their order (so `<` and std::sort use
// it), Hash keys a HashMap, Debug is Rust's text, Clone of a Vec field is
// deep, Eq is the structural ==.
use std::hash::Hash; use std::fmt::Debug; use std::alloc::Allocator; use std::fmt::Formatter as Fmt;
use std::collections::HashMap;

#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Clone, Copy)]
struct P { x: i64, y: i64 }

#[derive(Debug, PartialOrd, Ord, PartialEq, Eq, Hash, Clone, Copy)]
struct Named<'a> { id: i64, name: &'a str, at: P }

#[derive(Debug, Clone, PartialOrd, Ord, Hash, Copy, PartialEq, Eq)]
struct Empty {}

#[derive(Clone)]
struct Bag<A: Allocator> { items: Vec<i64, A>, label: String<A>, n: i64 }

fn show<T: std::fmt::Debug>(x: &T) {
    let mut f = Fmt::to_fd(1i32);
    write(f, "{:?}", x)?;
}

fn main(gpa: Gpa) {
    let a = P { x: 1, y: 2 };
    let b = P { x: 1, y: 3 };
    let mut v: Vec<P, Gpa> = Vec::new_in(gpa);
    v.push(b);
    v.push(a);
    v.push(P { x: 0, y: 9 });
    v.sort_unstable();
    for i in 0..v.len() {
        if i > 0 {
            print(" ");
        }
        show(&v.as_slice()[i]);
    }
    println("");

    print("lt ");
    print("{}", if a < b { "true" } else { "false" });
    print(" eq ");
    let a2 = P { x: 1, y: 2 };
    print("{}", if a == a2 { "true" } else { "false" });
    print(" cmp ");
    print("{}", a.cmp(b));
    print(" ");
    print("{}", b.cmp(a));
    print(" ");
    // (`cmp` takes `*Self`, an exclusive loan: compare a with a copy)
    let a_copy = a;
    print("{}", a.cmp(a_copy));
    println("");

    let mut m: HashMap<P, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(a, 10);
    m.insert(b, 20);
    m.insert(P { x: 1, y: 2 }, 10);
    print("map ");
    print("{}", m.get(&(P { x: 1, y: 3 })).copied().unwrap());
    print(" ");
    print("{}", m.get(&a).copied().unwrap());
    print("{}", if m.get(&(P { x: 2, y: 1 })).copied().is_none() { " none" } else { " some" });
    print(" len ");
    print("{}", (m.len() as i64));
    println("");

    let n1 = Named { id: 7, name: "seven", at: a };
    let n2 = Named { id: 7, name: "seven", at: P { x: 1, y: 2 } };
    print("same hash ");
    println("{}",
        if n1.hash() == n2.hash() && n1 == n2 && n1.cmp(n2) == 0 { "true" } else { "false" });
    show(&n1);
    println("");
    let e = Empty {};
    let e2 = e.clone();
    show(&e2);
    println("");

    let mut items: Vec<i64, Gpa> = Vec::new_in(gpa);
    items.push(1);
    items.push(2);
    let mut label = String::new_in(gpa);
    label.push(char::from_u32('a' as u32).unwrap());
    let bag = Bag { items: items, label: label, n: 1 };
    let mut copy = bag.clone();
    copy.items.push(3);
    copy.label.push(char::from_u32('b' as u32).unwrap());
    print("deep ");
    print("{}", (copy.items.len() as i64 + bag.items.len() as i64 - 2));
    print(" ");
    print("{}", bag.n);
    println("");
    print("buf ");
    print("{}", copy.label.as_str());
    print(" ");
    println("{}", bag.label.as_str());
}
