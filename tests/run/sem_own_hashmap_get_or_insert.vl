// EDITION: rust
// XFAIL: gap 17: compile unsafe: indexing a pointer is unsafe pointer arithmetic; the value 's' points to is `*s`
// sem-own: get_or_insert returns an inout slot: assigning drops the old value once.
// EXPECT: drop 9
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, D<Gpa>, Gpa> = HashMap::new_in(gpa);
    m.insert(1, mk(1, gpa));
    {
        let s = &m.entry(1).or_insert(mk(9, gpa));
        s[0] = mk(2, gpa);
    }
    println("end");
}
