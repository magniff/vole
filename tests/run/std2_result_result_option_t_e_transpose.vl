// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::result Result<Option<T>, E>::transpose.
// EXPECT: Some(Ok(1)) Some(Err("bad")) None
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let c: Result<Option<i64>, &str> = Ok(Some(1));
    let d: Result<Option<i64>, &str> = Err("bad");
    let e: Result<Option<i64>, &str> = Ok(None);
    println("{:?} {:?} {:?}", c.transpose(), d.transpose(), e.transpose());
}
