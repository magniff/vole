// (0.27.0) Hand-translated from tests/run/own_closure_sink_twice.vl to Rust's spelling.
// 0.20: a sink closure that moves its capture out and is called again
// stopped the program at the second move. (0.27.2) A closure checked
// against an `FnMut` bound is `FnMut` (D19.3(a)): its env is `&mut Env`,
// so moving a capture out is borrowck.move_out (rustc E0507), D19.7.
// RULE: D19.3, D19.7
// ERROR: borrowck.move_out
struct R {
    id: i64,
}

impl Drop for R {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn call2<F: FnMut() -> i64>(f: F) -> i64 {
    let mut g = f;
    g() + g()
}

fn main() {
    let e = R { id: 4 };
    let t = call2(move || {
        drop(e);
        1
    });
    println("twice {t}");
}
