// EDITION: rust
// (0.27.0) Hand-translated from tests/run/own_closure_sink_twice.vl to Rust's spelling.
// 0.20: a sink closure that moves its capture out and is called again
// stops the program at the second move (no closure is FnOnce yet): the
// value is dropped once, never twice.
// EXPECT: drop 4
// EXIT: 101
// STDERR: a sink closure moved its captured value out a second time
struct R {
    id: i64,
}

impl Drop for R {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn call2<F: FnMut() -> i64>(f: F) -> i64 {
    let mut g = f;
    g() + g()
}

fn main() {
    let e = R { id: 4 };
    let t = call2(move || {
        drop(e);
        1
    });
    println("twice {t}");
}
