// XFAIL: RT-357: a path call to a method on `(Self, i32)` is refused ("no method 'p' on type '(S, i32)'"); rustc accepts (0.30.2)
// From the re-review of the qualified-path work. Since v0.30.1 at least.
// EXPECT: 5
trait P {
    fn p(x: (Self, i64)) -> i64
        where
            Self: Sized;
}

struct S;

impl P for S {
    fn p(x: (S, i64)) -> i64 {
        x.1
    }
}

fn main() {
    println("{}", P::p((S, 5)));
}
