// RULE: F33.1
// `&mut F` meets FnMut and FnOnce bounds when F is FnMut, `&F` every
// kind when F is Fn: Map's next passes `&mut self.f` to Option::map.
// EXPECT: 3
// EXPECT: 7
// EXPECT: 2 3
// EXPECT: Some(3)
fn apply<F: FnOnce(i64) -> i64>(f: F, x: i64) -> i64 {
    f(x)
}

fn twice<F: FnMut(i64) -> i64>(mut f: F) -> i64 {
    f(1) + f(2)
}

fn main(gpa: Gpa) {
    let mut n = 0;
    let mut count = |x: i64| {
        n += 1;
        x + n
    };
    println("{}", apply(&mut count, 2));
    let add = |x: i64| x + 2;
    println("{}", twice(&add));
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    let mut it = v.iter().map(|x| x + 1);
    let a = it.next().unwrap();
    let b = it.next().unwrap();
    println("{} {}", a, b);
    // (Iterator::last, fold through Map: fold's own B apart from Map's, F12.2)
    println("{:?}", v.iter().map(|x| x + 1).last());
}
