// a trait inout-self method on a let binding of an owned type: the let Vec grows
// ERROR: borrowck.borrow_immutable
use std::alloc::Allocator; trait B { fn grow(&mut self); }
struct S<A: Allocator> { v: Vec<i64, A> }
impl B for S<Gpa> { fn grow(&mut self) { self.v.push(1); } }

fn main(gpa: Gpa) {
    let s = S { v: Vec::new_in(gpa) };
    s.grow();
    s.grow();
    println("{}", s.v.len());
}
