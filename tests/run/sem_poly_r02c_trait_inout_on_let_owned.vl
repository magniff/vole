// a trait inout-self method on a let binding of an owned type: the let Vec grows
// ERROR: [own.readonly]
trait B { fn grow(inout self); }
struct S<A: Allocator> { v: Vec<i64, A> }
impl B for S<Gpa> { fn grow(inout self) { self.v.push(1); } }

fn main(gpa: Gpa) {
    let s = S { v: Vec::new_in(gpa) };
    s.grow();
    s.grow();
    println("{}", s.v.len());
}
