// Runs on std2 since its arrays' by-value IntoIterator (0.27.3).
// The std2 item(s): std::collections::hash_set HashSet::union.
// EXPECT: [1, 2, 3]
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let a: HashSet<i64, Gpa> = [1i64, 2].into_iter().collect_in(gpa);
    let b: HashSet<i64, Gpa> = [2i64, 3].into_iter().collect_in(gpa);
    let mut v: Vec<i64, Gpa> = a.union(&b).copied().collect_in(gpa);
    v.sort();
    println("{:?}", v);
}
