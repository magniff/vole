// (0.28.0) std::str::from_utf8 checks the ASCII start of its bytes in
// blocks of sixteen, and Chars::count counts the bytes that start a char
// without decoding. The answers are the byte-by-byte ones: an error's
// place after 0, 15, 16, 17, 31, 32 and 33 ASCII bytes, a sequence cut at
// the end, and the count of what an iterator has left.
// EXPECT: 0 15 16 17 31 32 33
// EXPECT: 40 true 34 None
// EXPECT: 0 5 22 21 4 3
// EXPECT: 3 1

fn main() {
    let mut buf = [b'a'; 40];
    let at: [usize; 7] = [0, 15, 16, 17, 31, 32, 33];
    let mut k = 0;
    while k < 7 {
        buf[at[k]] = 0xFF;
        let up = match std::str::from_utf8(&buf) {
            Ok(_) => 999,
            Err(e) => e.valid_up_to(),
        };
        buf[at[k]] = b'a';
        if k < 6 {
            print("{} ", up);
        } else {
            println("{}", up);
        }
        k += 1;
    }
    let all = std::str::from_utf8(&buf).unwrap().len();
    // a two-byte char across the second block's end, then one cut short
    buf[31] = 0xC3;
    buf[32] = 0xA9;
    let two = std::str::from_utf8(&buf).is_ok();
    buf[31] = b'a';
    buf[32] = b'a';
    buf[34] = 0xE2;
    buf[35] = 0x82;
    let cut = std::str::from_utf8(&buf[..36]).unwrap_err();
    println("{} {} {} {:?}", all, two, cut.valid_up_to(), cut.error_len());
    let s = "aé€😀b, sixteen or more";
    let mut it = s.chars();
    let whole = s.chars().count();
    let _ = it.next();
    let after = it.clone().count();
    let _ = it.next_back();
    println("{} {} {} {} {} {}", "".chars().count(), "hello".chars().count(), whole, after,
        "é€😀b".chars().count(), "€😀b".chars().rev().count());
    println("{} {}", "日本語".chars().count(), "\u{10FFFF}".chars().count());
}
