// RULE: D8.5
// (0.27.2.1) A non-Copy part moved, then the whole used in the same tuple:
// t is partially moved (rustc E0382).
// ERROR: error[borrowck.use_moved]
// ERROR-COUNT: 1
struct N {
    v: i64,
}

struct T {
    n: N,
}

fn main() {
    let t = T { n: N { v: 1 } };
    let p = (t.n, t);
    println("{}", p.0.v);
}
