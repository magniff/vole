// Runs on std since 0.27.2's switch.
// The std item(s): std::slice SliceIndex::get_mut.
// EXPECT: [1, 9, 3]
// RUSTC: none (SliceIndex's methods are unstable in Rust)
use std::slice::SliceIndex;

fn main() {
    let mut a = [1, 2, 3];
    *1usize.get_mut(&mut a[..]).unwrap() = 9;
    println("{:?}", a);
}
