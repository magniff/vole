// RULE: F8.3, F8.4
// `<S as Conv<_, u8>>::c(true)`: the hole is filled from the call, the written `u8` leaves Conv<bool, i64>'s impl out (rustc 2 1)
// From the second round of the qualified paths: the arguments a path writes beside a `_` choose the impl; fails on v0.30.1 ("ambiguous").
// EXPECT: 2 1
trait Conv<A, B> {
    fn c(x: A) -> i64;
}

struct S;

impl Conv<bool, i64> for S {
    fn c(x: bool) -> i64 {
        1
    }
}

impl Conv<bool, u8> for S {
    fn c(x: bool) -> i64 {
        2
    }
}

fn main() {
    println("{} {}", <S as Conv<_, u8>>::c(true), <S as Conv<_, i64>>::c(true));
}
