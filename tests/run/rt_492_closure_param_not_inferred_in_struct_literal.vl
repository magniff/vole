// XFAIL: RT-492: a closure in a struct literal whose type parameter an impl's bound fixes, `MyMap { i: a.iter(), f: |x| { let _ = n; x } }` with `impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F>`, is "cannot infer the type of closure parameter 'x'"; rustc infers `&i64` from the use as an Iterator and prints 6 (0.30.2)
// From the third re-review of the borrow-check work (g302bor2), written as programs rustc accepts. Since v0.30.1 at least.
// The closure bound to a variable first: rt_492b. RT-350 is a trait
// method's own F bound.
// EXPECT: 6
struct MyMap<I, F> {
    i: I,
    f: F,
}

impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for MyMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.i.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

fn main() {
    let a = [1i64, 2, 3];
    let n = 4i64;
    let m = MyMap { i: a.iter(), f: |x| { let _ = n; x } };
    let s: i64 = m.map(|r| *r).sum();
    println("{}", s);
}
