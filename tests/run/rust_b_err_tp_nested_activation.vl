// EDITION: rust
// RULE: D7.2
// (0.27.1) `s.add(s.take())`: the inner call's mutable activation inside the
// outer reservation (rustc E0499).
// ERROR: error[borrowck.mut_twice]
// ERROR: line 29, column 11
// ERROR-COUNT: 1
// Checked since bc271 M3.

struct S {
    x: i64,
    y: i64,
}

impl S {
    fn add(&mut self, k: i64) {
        self.x += k;
    }

    fn take(&mut self) -> i64 {
        let t = self.x;
        self.x = 0;
        t
    }
}

fn main() {
    let mut s = S { x: 1, y: 2 };
    s.add(s.take());
    println("{}", s.x);
}
