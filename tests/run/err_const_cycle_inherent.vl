// (0.30.2, RT-138) Two inherent associated constants defined by each other:
// rustc E0391 (cycle detected when const-evaluating), at the first.
// ERROR: const.cycle
// ERROR: line 8, column 5
struct S;

impl S {
    const A: i64 = Self::B;
    const B: i64 = Self::A;
}

fn main() {
    println("{}", S::A);
}
