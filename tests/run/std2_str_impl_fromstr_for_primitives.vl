// EDITION: rust
// The std2 item(s): std::str impl FromStr for primitives.
// EXPECT: -128 255 -9 18446744073709551615 2.5 1e-3 false
// EXPECT: true true
use std::str::CharIndices;

fn main() {
    let a: i8 = "-128".parse().unwrap();
    let b: u8 = "255".parse().unwrap();
    let c: isize = "-9".parse().unwrap();
    let d: u64 = "18446744073709551615".parse().unwrap();
    let e: f64 = "2.5".parse().unwrap();
    let f: f32 = "1e-3".parse().unwrap();
    let g: bool = "false".parse().unwrap();
    println("{} {} {} {} {} {:e} {}", a, b, c, d, e, f, g);
    println("{} {}", "256".parse::<u8>().is_err(), "".parse::<i32>().is_err());
}
