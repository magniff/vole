// RULE: D2.9
// (0.30.1) What the hidden borrows of format arguments and comparison
// operands still accept, as rustc: a hole read again in a later argument,
// a write after the call, a shared reference to a `&mut`'s referent in a
// hole and its write after, a comparison whose right operand changes the
// place before the left one is read (the left is a block), a name the
// format string captures after an argument that changes it (rustc
// evaluates the arguments first), holes in a loop.
// EXPECT: x1 2 x1
// EXPECT: x1y 3
// EXPECT: true
// EXPECT: true x1yz
// EXPECT: w 0
// EXPECT: 3 4
// EXPECT: 4
// EXPECT: true P { x: 5 }
// EXPECT: [0] 1
// EXPECT: [0, 1] 2
// EXPECT: [0, 1, 2] 3
// EXPECT: [0, 1] Some(2)
#[derive(PartialEq, Clone, Copy, Debug)]
struct P {
    x: i64,
}

fn bump(r: &mut i64) {
    println("{} {}", r, *r + 1);
    *r += 1;
}

fn main(gpa: Gpa) {
    let mut s = format_in("x{}", 1, gpa);
    println("{} {} {}", s, s.len(), s);
    s.push('y');
    println("{s} {}", s.len());
    let t = s.clone();
    println("{}", s == t);
    let r = {
        s.push('z');
        s.clone()
    } == s;
    println("{r} {s}");
    println("{s} {}", {
        s.clear();
        s.push('w');
        0
    });
    let mut n = 3;
    bump(&mut n);
    println("{n}");
    let mut p = P { x: 1 };
    let q = { p.x = 5; p } == p;
    println("{q} {:?}", p);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..3 {
        v.push(i);
        println("{:?} {}", v, v.len());
    }
    let w = v.pop();
    println("{:?} {:?}", v, w);
}
