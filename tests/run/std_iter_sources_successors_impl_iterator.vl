// Runs on std since 0.27.2's switch.
// The std item(s): std::iter::sources Successors::impl Iterator.
// EXPECT: Some(2) Some(4) None

fn main() {
    let mut s = std::iter::successors(Some(2i64), |x| if *x < 4 { Some(x * 2) } else { None });
    let a = s.next();
    let b = s.next();
    println("{:?} {:?} {:?}", a, b, s.next());
}
