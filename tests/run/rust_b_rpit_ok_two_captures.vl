// RUSTC-EDITION: 2024
// RULE: D21.2
// (0.27.2.1) The hidden closure captures `x` and `y` apart: each capture's
// lifetime is its own member choice, 'a and 'b (rustc accepts).
// EXPECT: 1
fn both<'a, 'b>(c: bool, x: &'a i32, y: &'b i32) -> impl Fn() -> i32 {
    move || if c { *x } else { *y }
}

fn main() {
    let a: i32 = 1;
    let b: i32 = 2;
    let f = both(true, &a, &b);
    println("{}", f());
}
