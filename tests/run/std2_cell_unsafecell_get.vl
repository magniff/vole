// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::cell UnsafeCell::get.
// EXPECT: 9
use std::cell::UnsafeCell;
use std::mem::swap;

fn main() {
    let c = UnsafeCell::new(1i64);
    let p: *mut i64 = c.get();
    unsafe { *p = 9 };
    println("{}", c.into_inner());
}
