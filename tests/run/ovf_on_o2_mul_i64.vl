// (0.26.3, decision 6) `a * b` of i64s panics at -O2 with --overflow-
// checks=on, with Rust's message at the expression.
// FLAGS: -O2 --overflow-checks=on
// EXIT: 101
// EXPECT: before
// STDERR: ovf_on_o2_mul_i64.vl:17:13: attempt to multiply with overflow

#[inline(never)]
fn id(x: i64) -> i64 {
    x
}

fn main() {
    let a: i64 = id(-4294967296) as i64;
    let b: i64 = id(2147483649) as i64;
    println("before");
    let r = a * b;
    println("after {}", r);
}
