// EDITION: rust
// RULE: D19.6
// (0.27.2) A closure inferred `FnOnce` (it moves a capture) where an `Fn`
// bound is asked: closure.kind (rustc E0525).
// ERROR: error[closure.kind]
struct S {
    n: i64,
}

fn eat(s: S) -> i64 {
    s.n
}

fn call<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn main() {
    let s = S { n: 4 };
    let f = || eat(s);
    println("{}", call(f));
}
