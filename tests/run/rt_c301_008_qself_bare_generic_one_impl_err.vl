// RULE: F8.4
// `<W as Mk>::mk()`, W generic with one impl of Mk, in main and in a generic function: rustc E0107. v0.30.1 printed `5 5` (W's arguments inferred).
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// ERROR: 'W' is generic: write its type arguments ('W<...>')
trait Mk {
    fn mk() -> Self;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }
}

fn g<Q>() -> i64 {
    let w: W<Q> = <W as Mk>::mk();
    w.k
}

fn main() {
    let x: W<u8> = <W as Mk>::mk();
    println("{} {}", x.k, g::<u8>());
}
