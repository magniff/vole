// EXPECT: 8 1
// (RT-426b) `T::Out` under `T: Sub` of `trait Sub: a::Tr`, where a::Tr
// and b::Tr2 both declare Out and each has a blanket impl, in different
// modules: Tr's (i64) for T::Out, Tr2's (u8) only when Tr2 is named.
// v0.30.1 gets this one right too (a guard for the bound path).
mod a {
    pub trait Tr {
        type Out;
    }

    impl<T: Copy> Tr for T {
        type Out = i64;
    }
}

mod b {
    pub trait Tr2 {
        type Out;
    }

    impl<T: Copy> Tr2 for T {
        type Out = u8;
    }
}

trait Sub: a::Tr {}

#[derive(Clone, Copy)]
struct W {
    v: i64,
}

impl Sub for W {}

fn sz<T: Sub>(t: &T) -> usize {
    std::mem::size_of::<T::Out>()
}

fn sz2<T: b::Tr2>(t: &T) -> usize {
    std::mem::size_of::<T::Out>()
}

fn main() {
    let w = W { v: 1 };
    println("{} {}", sz(&w), sz2(&w));
}
