// RULE: D4.5
// (0.30.1) A callee's `T: 'static` (or a struct's) asked of the caller's
// type parameter: met only by the parameter's own bounds, as rustc's E0310
// says. Each function below passes a T, or a type holding one (a tuple, a
// closure that captures it, a struct), where 'static is required, and its
// T has no such bound.
// ERROR: borrowck.param_outlives
// ERROR: borrowck.param_outlives
// ERROR: borrowck.param_outlives
// ERROR: borrowck.param_outlives
// ERROR-COUNT: 4
struct Keep<T: 'static> {
    t: T,
}

fn need<T: 'static>(t: T) -> T {
    t
}

fn pass<T>(t: T) -> T {
    need(t)
}

fn tup<T>(t: T) -> (T, i64) {
    need((t, 1))
}

fn clo<T: Send>(t: T) -> usize {
    let f = move || {
        let _x = t;
        1usize
    };
    need(f)()
}

fn mk<T: Copy>(t: T) -> Keep<T> {
    Keep { t: t }
}

fn main() {
    println("{} {:?} {} {}", pass(1), tup(2), clo(3), mk(4).t);
}
