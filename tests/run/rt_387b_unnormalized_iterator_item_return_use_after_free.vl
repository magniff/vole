// From the review of g302bor2 (form B/b28). Since v0.30.1 at least; the
// release build the same. rustc E0505 at the drop (the rustc twin of this
// file): the Item of `Iter<i64>` is `&i64`, a borrow of v. vole builds it
// and --check-alloc reports a use after free of v's buffer. Siblings:
// rt_387 (IntoIterator), rt_387c, rt_387d, rt_387e.
// FLAGS: --check-alloc
// ERROR: line 23
fn nth<I: Iterator>(i: I, k: &usize) -> Option<<I as Iterator>::Item> {
    let mut i = i;
    let mut n = *k;
    while n > 0 {
        let _ = i.next();
        n -= 1;
    }
    i.next()
}

fn main(gpa: Gpa) {
    let k = 0usize;
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1000);
    let r = nth(v.iter(), &k);
    drop(v);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(7);
    println("{:?} {:?}", r, w);
}
