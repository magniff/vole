// RULE: F8.3, F8.4
// RT-C301-8 review (C1, form f65c_tryfrom_infer): `<u8 as TryFrom<_>>::try_from(300i64)`, `<i64 as From<_>>::from(5i32)`.
// rustc prints the EXPECT lines.
// EXPECT: true 5
use std::convert::TryFrom;

fn main() {
    let a = <u8 as TryFrom<_>>::try_from(300i64).is_err();
    let b: i64 = <i64 as From<_>>::from(5i32); println("{} {}", a, b);
}
