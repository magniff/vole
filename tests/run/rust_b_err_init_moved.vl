// RULE: M2, M8
// (0.30.1) a field assigned after the whole moved is rustc's E0382 ("assign to
// part of moved value"), not E0381.
// ERROR: error[borrowck.use_moved]
// ERROR: line 44, column 5
// ERROR-COUNT: 1
struct P {
    a: i64,
    b: &'static i64,
}

impl P {
    fn get(&self) -> i64 {
        self.a + *self.b
    }
}

#[derive(Clone, Copy)]
struct C {
    a: i64,
    b: i64,
}

struct Q {
    r: i64,
    s: i64,
}

struct O {
    q: Q,
    z: i64,
}

union U {
    x: i64,
    y: u32,
}

static THREE: i64 = 3;

fn mv() {
    let mut p = P { a: 1, b: &THREE };
    let q = p;
    p.a = 2;
    println("{}", q.a);
}

fn main() {
    mv();
}
