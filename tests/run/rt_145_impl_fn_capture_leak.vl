// XFAIL: RT-145: a closure returned as `impl Fn` never drops what it captured: its String and Vec are not freed, even after drop(f) (0.30.2)
// FLAGS: --check-alloc
// rustc frees both (Rust drops a closure's captures with the closure);
// vole's --check-alloc reports, at exit, `2 blocks of Gpa not freed`:
// the String made in mk_len and the Vec grown in mk_push. A closure
// that captures the same String locally, or is passed to a generic F,
// frees it. Since v0.28.0 at least.
// EXPECT: 3
// EXPECT: 2
// EXPECT: 6
// EXPECT: end
fn mk_len(gpa: Gpa) -> impl Fn() -> usize {
    let s = String::from_in("abc", gpa);
    move || s.len()
}

fn mk_push(gpa: Gpa) -> impl FnMut() -> usize {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    move || {
        v.push(1);
        v.len()
    }
}

fn take<F: Fn() -> usize>(f: F) -> usize {
    f()
}

fn main(gpa: Gpa) {
    let f = mk_len(gpa);
    println("{}", f());
    drop(f);
    {
        let mut h = mk_push(gpa);
        h();
        println("{}", h());
    }
    let s = String::from_in("passed", gpa);
    println("{}", take(move || s.len()));
    println("end");
}
