// XFAIL: RT-145: a value returned as `impl Trait` is never dropped: a closure's captured String and Vec, and an iterator struct's Vec, are not freed, even after drop(f) (0.30.2)
// FLAGS: --check-alloc
// rustc frees all three (Rust drops an opaque value like any other);
// vole's --check-alloc reports, at exit, `3 blocks of Gpa not freed`:
// the String made in mk_len, the Vec grown in mk_push and the Vec in
// mk_iter's It. The same closure kept local, or passed to a generic F,
// is freed. A value whose type has a Drop impl is refused here instead
// (RT-79, distinct.kind: the opaque type is treated as a plain type,
// copied freely and never dropped). Since v0.28.0 at least.
// EXPECT: 3
// EXPECT: 2
// EXPECT: 9
// EXPECT: 6
// EXPECT: end
use std::alloc::Allocator;

struct It<A: Allocator> {
    v: Vec<i64, A>,
    i: usize,
}

impl<A: Allocator> Iterator for It<A> {
    type Item = i64;

    fn next(&mut self) -> Option<i64> {
        if self.i < self.v.len() {
            self.i += 1;
            Some(self.v[self.i - 1])
        } else {
            None
        }
    }
}

fn mk_iter(gpa: Gpa) -> impl Iterator<Item = i64> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    v.push(5);
    It { v: v, i: 0 }
}

fn mk_len(gpa: Gpa) -> impl Fn() -> usize {
    let s = String::from_in("abc", gpa);
    move || s.len()
}

fn mk_push(gpa: Gpa) -> impl FnMut() -> usize {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    move || {
        v.push(1);
        v.len()
    }
}

fn take<F: Fn() -> usize>(f: F) -> usize {
    f()
}

fn main(gpa: Gpa) {
    let f = mk_len(gpa);
    println("{}", f());
    drop(f);
    {
        let mut h = mk_push(gpa);
        h();
        println("{}", h());
    }
    let mut n = 0i64;
    for x in mk_iter(gpa) {
        n += x;
    }
    println("{}", n);
    let s = String::from_in("passed", gpa);
    println("{}", take(move || s.len()));
    println("end");
}
