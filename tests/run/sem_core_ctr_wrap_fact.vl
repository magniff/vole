// requires i >= 0 && i + 1 <= len does not prove i < len when i + 1 wraps.
// EXPECT: 3
// EXIT: 101
// STDERR: index out of bounds: index 9223372036854775807, length 3
// (0.26.4) The overflow checks off: it tests code on arithmetic that wrapped.
// FLAGS: --overflow-checks=off
static mut Z: i64 = 0;

#[inline(never)]
fn at(s: &[i64], i: i64) -> i64
    requires i >= 0 && i + 1 <= s.len() as i64
{
    s[i as usize]
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [1i64, 2, 3];
    println("{}", at(&a[..], 2 + unsafe { Z }));
    println("{}", at(&a[..], 9223372036854775807 + unsafe { Z }));
    0
}
