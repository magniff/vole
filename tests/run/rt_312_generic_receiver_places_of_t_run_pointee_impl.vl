// XFAIL: RT-312: (RT-292's and RT-212's mechanism, more receivers) in a generic body with T = &W, `a[0].tag()` of a `[T; 2]`, `g.t.tag()` of a `G<T>` parameter, `g.get().tag()`, `(*&x).tag()`, `(*b).tag()` of a `Box<T>`, `z.tag()` of `for z in v` over a `Vec<T>`, `v.into_iter().next().unwrap().tag()`, `let (a, _b) = p` and `let G { t } = g` bindings, `s[0].tag()` of a `&[T]`, and `y.tag10()` (a default method) of `let y = x` run W's impl (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt): <&W as Tag>::tag (2) at
// every receiver. vole prints 1 for arr, fld, meth, derefref, boxd, items,
// next1, tup, destr and slc, and `dflt2 10`, at -O0 and -O2; v0.28.0 to
// v0.30.1 the same. Right today: closures capturing x (capref, capmove),
// `if let Some(z) = &o` (a &T), `x.tag10()` of the parameter, `T::KK`,
// `T::mk()`, `<T as Tag>::tag(&x)`. RT-292 has `let y = x; y.tag()`,
// `id(x).tag()`, a closure parameter, match/if-let bindings and unwrap;
// RT-212 a generic impl's `self.v`, `p.0`, an index and a call's result.
// EXPECT: arr 2 fld 2 meth 2 derefref 2
// EXPECT: boxd 2
// EXPECT: items 2 next1 2
// EXPECT: capref 2 capmove 2 tup 2 destr 2
// EXPECT: refopt 2
// EXPECT: dflt 20 dflt2 20 konst 2 assoc 2 qual 2
// EXPECT: slc 2 k 0
use std::ops::Neg;

trait Tag {
    fn tag(&self) -> i64;

    fn tag10(&self) -> i64 {
        self.tag() * 10
    }
}

trait K {
    const KK: i64;
    fn mk() -> i64;
}

#[derive(Clone, Copy)]
struct W {
    k: i64,
}

impl Tag for W {
    fn tag(&self) -> i64 {
        1
    }
}

impl<'a> Tag for &'a W {
    fn tag(&self) -> i64 {
        2
    }
}

impl K for W {
    const KK: i64 = 1;

    fn mk() -> i64 {
        1
    }
}

impl<'a> K for &'a W {
    const KK: i64 = 2;

    fn mk() -> i64 {
        2
    }
}

impl Neg for W {
    type Output = i64;

    fn neg(self) -> i64 {
        1
    }
}

impl<'a> Neg for &'a W {
    type Output = i64;

    fn neg(self) -> i64 {
        2
    }
}

struct G<T> {
    t: T,
}

impl<T: Tag + Copy> G<T> {
    fn get(&self) -> T {
        self.t
    }
}

fn id<T>(t: T) -> T {
    t
}

fn arr<T: Tag + Copy>(x: T) -> i64 {
    let a = [x, x];
    a[0].tag()
}

fn fld<T: Tag>(g: G<T>) -> i64 {
    g.t.tag()
}

fn meth<T: Tag + Copy>(g: G<T>) -> i64 {
    g.get().tag()
}

fn derefref<T: Tag>(x: T) -> i64 {
    (*&x).tag()
}

fn boxd<T: Tag>(b: Box<T, Gpa>) -> i64 {
    (*b).tag()
}

fn items<T: Tag>(v: Vec<T, Gpa>) -> i64 {
    let mut s = 0i64;
    for z in v {
        s += z.tag();
    }
    s
}

fn next1<T: Tag>(v: Vec<T, Gpa>) -> i64 {
    v.into_iter().next().unwrap().tag()
}

fn capref<T: Tag>(x: T) -> i64 {
    let f = || x.tag();
    f()
}

fn capmove<T: Tag>(x: T) -> i64 {
    let f = move || x.tag();
    f()
}

fn tup<T: Tag>(p: (T, T)) -> i64 {
    let (a, _b) = p;
    a.tag()
}

fn destr<T: Tag>(g: G<T>) -> i64 {
    let G { t } = g;
    t.tag()
}

fn refopt<T: Tag>(o: Option<T>) -> i64 {
    if let Some(z) = &o { z.tag() } else { 0 }
}

fn dflt<T: Tag>(x: T) -> i64 {
    x.tag10()
}

fn dflt2<T: Tag>(x: T) -> i64 {
    let y = x;
    y.tag10()
}

fn konst<T: K>(_x: T) -> i64 {
    T::KK
}

fn assoc<T: K>(_x: T) -> i64 {
    T::mk()
}

fn qual<T: Tag>(x: T) -> i64 {
    <T as Tag>::tag(&x)
}

fn slc<T: Tag>(s: &[T]) -> i64 {
    s[0].tag()
}

fn main(gpa: Gpa) {
    let w = W { k: 0 };
    let r = &w;
    println("arr {} fld {} meth {} derefref {}", arr(r), fld(G { t: r }), meth(G { t: r }),
        derefref(r));
    println("boxd {}", boxd(Box::new_in(r, gpa)));
    let mut v: Vec<&W, Gpa> = Vec::new_in(gpa);
    v.push(r);
    let mut v2: Vec<&W, Gpa> = Vec::new_in(gpa);
    v2.push(r);
    println("items {} next1 {}", items(v), next1(v2));
    println("capref {} capmove {} tup {} destr {}", capref(r), capmove(r), tup((r, r)),
        destr(G { t: r }));
    println("refopt {}", refopt(Some(r)));
    println("dflt {} dflt2 {} konst {} assoc {} qual {}", dflt(r), dflt2(r), konst(r), assoc(r),
        qual(r));
    let a = [r, r];
    println("slc {} k {}", slc(&a[..]), w.k);
}
