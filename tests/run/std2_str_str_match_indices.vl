// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str str::match_indices.
// EXPECT: [(1, "é"), (4, "é")]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let v: Vec<(usize, &str), Gpa> = "xéyé".match_indices('é').collect_in(gpa);
    println("{:?}", v);
}
