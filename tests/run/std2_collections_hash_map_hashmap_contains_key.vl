// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map HashMap::contains_key.
// EXPECT: true false
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 1);
    println("{} {}", m.contains_key(&1), m.contains_key(&2));
}
