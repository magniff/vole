// EDITION: rust
// RULE: F26.1, F18.5
// (0.28.0) `!` of an integer literal tree takes its type from the code
// around it, as `-` and rustc do: `x & !(1 << 40)` with x an i64 typed
// `1 << 40` an i32 by itself, 256, and cleared bit 8, not bit 40.
// EXPECT: -1099511627777 -1099511627777 -1099511627777 7fffffffffffffff false
fn main() {
    let x: i64 = -1;
    let k: i64 = 40;
    let y = x & !(1 << 40);
    let z = x & !(1 << k);
    let d: i64 = !(1 << 40);
    let mut w: u64 = 0xffff_ffff_ffff_ffff;
    w &= !(1 << 63);
    let b = true;
    let c: bool = !b;
    println("{} {} {} {:x} {}", y, z, d, w, c);
}
