// XFAIL: RT-256: an index of a const array in a const item, `const B: i64 = A[1]`, is "not a compile-time constant" (0.30.2)
// rustc evaluates both consts (and the array length `A[2] as usize`) and
// prints the EXPECT line. RT-108 and RT-144 are a const struct's field and
// a const array's len; this is the index. From the review of g302index
// (form i08); v0.30.1 the same.
// EXPECT: 2 3
const A: [i64; 3] = [1, 2, 3];
const B: i64 = A[1];
const N: usize = A[2] as usize;

fn main() {
    let x: [u8; A[2] as usize] = [0; N];
    println("{} {}", B, x.len());
}
