// RULE: F8.4
// `<A as Mk>::mk()`, A a generic type alias written bare: rustc E0107 (missing generics for type alias `A`). A guard: v0.30.1 and the branch before the fix refused it too, by the alias's own rule.
// From the second re-review of the qualified paths: a qualified path's self type is a type, read as one; a generic type written there without its arguments is rustc's E0107, as in `let x: W`.
// ERROR: type alias 'A' is generic: write its type arguments ('A<...>')
trait Mk {
    fn mk() -> Self;
    const C: i64;
    type Out;
}

struct W<U> {
    p: Option<U>,
    k: i64,
}

impl<U> Mk for W<U> {
    fn mk() -> W<U> {
        W { p: None, k: 5 }
    }

    const C: i64 = 7;
    type Out = i64;
}

type A<T> = W<T>;

fn main() {
    let x: W<u8> = <A as Mk>::mk();
    println("{}", x.k);
}
