// RULE: C1 (0.27.2.1, std's clauses)
// The std item(s): swap_with_slice's `requires self.len() == other.len()`, violated last.
// EXPECT: 3
// EXIT: 101
// STDERR: requires failed: 'self.len() == other.len()'

fn main() {
    let mut a = [1, 2];
    let mut b = [3, 4];
    let mut c = [5];
    a.swap_with_slice(&mut b);
    println("{}", a[0]);
    a.swap_with_slice(&mut c);
}
