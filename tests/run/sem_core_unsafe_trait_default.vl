// EDITION: rust
// A trait's default method dereferencing a raw pointer.
// ERROR: dereference of a raw pointer is unsafe
trait R { fn p(&self) -> *mut i64; fn read(self) -> i64 { *self.p() } }
#[derive(Clone, Copy)] struct S { q: *mut i64 }
impl R for S { fn p(&self) -> *mut i64 { self.q } }

fn main() -> i32 {
    let mut x: i64 = 1; let s = S { q: &mut x as *mut i64 }; println("{}", s.read()); 0
}
