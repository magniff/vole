// (0.30.1, review 7) What a type implies or needs is read from the type
// resolved, never from its text. `&'static K<T>` with `type K<T> = <T as
// Tr>::A` is `&'static u8`: it implies nothing of T, so `need(t)` needs
// `T: 'static` (rustc E0310); before, the text gave T: 'static and a
// caller's `&str` met it.
// ERROR: borrowck.param_outlives
// ERROR-COUNT: 1
trait Tr {
    type A;
}

impl<T> Tr for T {
    type A = u8;
}

type K<T> = <T as Tr>::A;

fn need<T: 'static>(t: T) {}

fn go<T>(x: &'static K<T>, t: T) {
    need(t);
}

static N: u8 = 1;

fn main(gpa: Gpa) {
    let s = String::from_in("x", gpa);
    go::<&str>(&N, s.as_str());
}
