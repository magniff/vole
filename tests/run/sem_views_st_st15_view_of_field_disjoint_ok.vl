// (0.25 semantics audit, views; docs/design/semantics-audit-025-views.md) accept: hello 2 (disjoint field changed)
// EXPECT: hello 2
use std::alloc::Allocator; struct P<A: Allocator> { name: String<A>, n: i64 }

fn main(gpa: Gpa) -> i32 {
    let mut p = P { name: String::from_in("hello", gpa), n: 1 };
    let w = p.name.as_str();
    p.n += 1;
    println("{w} {}", p.n);
    0
}
