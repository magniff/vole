// a user projection -> inout T
// EXPECT: 11 2
#[derive(Clone, Copy)] struct S { a: i64, b: i64 }
fn pick(s: &mut S, first: bool) -> &mut i64 { if first { &mut s.a } else { &mut s.b } }

fn main() {
    let mut s = S { a: 1, b: 2 }; let r = pick(&mut s, true); *r += 10; println("{} {}", s.a, s.b);
}
