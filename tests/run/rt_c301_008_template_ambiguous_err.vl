// RULE: F8.3, F9.3
// `W::m(&w)` of a generic struct W whose two traits' impls both give m:
// rustc E0034. 0.30.1 called A's.
// ERROR: error[method.ambiguous]: multiple applicable items: 'm' is an item of more than one trait for 'W'
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct W<T> { t: T }
impl<T> A for W<T> { fn m(&self) -> i64 { 10 } }
impl<T> B for W<T> { fn m(&self) -> i64 { 20 } }
fn main() { let w = W { t: 5i64 }; println("{}", W::m(&w)); }
