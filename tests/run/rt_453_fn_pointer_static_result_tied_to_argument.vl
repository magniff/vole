// XFAIL: RT-453: a call through a fn pointer whose result is `&'static u64`, `let g: fn(&u64) -> &'static u64 = st; let r = g(&*b); drop(b);`, ties the result to the argument: borrowck.move_borrowed at the drop ("cannot move out of 'b' because it is borrowed"); the result is 'static, rustc prints 5 (0.30.2)
// From the review of g302static (its form o12_fnptr_static_ret). Since
// v0.30.1 at least (the same error), and on the release build with
// g302static merged. A direct call `st(&*b)` is not refused. The
// struct-field form, `(ff.f)(&*b)`, is rt_453b.
// EXPECT: 5
static S: u64 = 5;

fn st(_x: &u64) -> &'static u64 {
    &S
}

fn main(gpa: Gpa) {
    let g: fn(&u64) -> &'static u64 = st;
    let b = Box::new_in(1u64, gpa);
    let r = g(&*b);
    drop(b);
    println("{}", r);
}
