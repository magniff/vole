// RULE: D8.2
// (0.28.0) A `let`'s temporaries drop at the end of the statement unless
// its initializer is extending (`&temp`, rustc's temporary lifetime
// extension): `v[0].clone()` dies there while w still borrows it (rustc
// E0716). 0.27.8 kept every temporary of a `let` of a view to the end of
// the block, and accepted it.
// ERROR: error[borrowck.dropped_borrowed]
fn main(gpa: Gpa) {
    let mut v: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(String::from_in("hello", gpa));
    let w = v[0].clone().as_str();
    v.clear();
    println("{}", w);
}
