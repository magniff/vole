// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::fmt DebugMap.
// EXPECT: {"a": 1, "b": true}
// EXPECT: {
// EXPECT:     "a": 1,
// EXPECT:     "b": true,
// EXPECT: }
use std::fmt::{Debug, Formatter};

struct B {
    a: i64,
    b: bool,
}

impl Debug for B {
    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
        let mut d: std::fmt::DebugMap<'_, '_> = f.debug_map();
        d.entry(&"a", &self.a);
        d.entry(&"b", &self.b);
        d.finish()
    }
}

fn main() {
    let x = B { a: 1, b: true };
    println("{:?}", x);
    println("{:#?}", x);
}
