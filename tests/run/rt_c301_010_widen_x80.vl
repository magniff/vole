// XFAIL: RT-C301-10: an i32 computed from untyped literals reaches an i64 use through a form the check does not follow (a struct field, a container written later): widened after the i32 arithmetic (0.30.2)
// rustc types the literals i64 and prints 4000000000; vole panics at -O0 (attempt to add with overflow).
// EXPECT: 4000000000
fn take(x: i64) -> i64 { x }
fn main() { let a = 2000000000; let mut t = (0, 0); t.0 = a + a; println("{}", take(t.0)); }
