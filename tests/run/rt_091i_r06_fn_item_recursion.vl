// (0.30.2, the re-review of g302holes: r91/r06_fn_item_recursion)
// EXPECT: 473
// A recursive fn item whose body builds closures returning closures that call it.
fn rec(n: i64) -> i64 {
    if n <= 0 {
        return 1;
    }
    let f = |x: i64| move |y: i64| x + y + rec(n - 1);
    let v = [1i64, 2];
    let s: i64 = v.iter().flat_map(|a| v.iter().map(move |b| a * b + rec(n - 1))).sum();
    f(n)(1) + s
}

fn main() {
    println("{}", rec(3));
}
