// std's own `&self[..mid]` of a str is a byte slice, unchecked (the
// char-boundary check is for programs' indexing only), so std's
// split_at, which promises to panic when mid is not a char boundary,
// returns [97, 195] and [169, 226, 130, 172] for "aé€" split at 2.
// EXPECT: start
// STDERR: byte index 2 is not a char boundary
// EXIT: 101
fn main() {
    let mid = std::env::args().count() + 1;
    let s: &str = "aé€";
    println("start");
    let (a, b) = s.split_at(mid);
    println("{:?} {:?}", a.as_bytes(), b.as_bytes());
}
