// A guard: a method of a trait not in scope is never taken; the inherent one runs (as rustc and 0.30.1).
// From the review of g302probe part 1, where a build took the trait's.
// EXPECT: 2
mod a {
    pub trait T1 { fn val(self) -> i64; }
    impl T1 for i64 { fn val(self) -> i64 { 1 } }
}

trait T2 { fn val(&self) -> i64; }
impl T2 for i64 { fn val(&self) -> i64 { 2 } }
fn main() { let x: i64 = 5; println("{}", x.val()); }
