// (0.30.1, review 3) What rustc takes as 'static for a 'static trait's
// impl: a type parameter bounded by a 'static trait (`T: St2` with `trait
// St2: 'static`), an impl lifetime bounded `'a: 'static`, a `fn` type
// whose lifetimes it binds itself (`fn(&str) -> i64`).
// EXPECT: hi
// EXPECT: 3
trait St2: 'static {}

trait St: 'static {
    fn show(&self) -> i64;
}

impl St2 for i64 {}

impl<T: St2> St for T {
    fn show(&self) -> i64 {
        1
    }
}

trait Sh: 'static {
    fn show(&self);
}

impl<'a: 'static> Sh for &'a str {
    fn show(&self) {
        println("{}", self);
    }
}

impl Sh for fn(&str) -> i64 {
    fn show(&self) {
        println("{}", 3);
    }
}

fn f<T: St>(t: T) -> i64 {
    t.show()
}

fn g<T: Sh>(t: T) {
    t.show();
}

fn len(s: &str) -> i64 {
    s.len() as i64
}

fn main() {
    let _ = f(1i64);
    g("hi");
    let p: fn(&str) -> i64 = len;
    g(p);
}
