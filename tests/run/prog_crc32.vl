// Bitwise CRC-32 (IEEE) of a few strings.
// EXPECT: 414fa339 cbf43926 00000000
// (0.26.4) Its PRNG and checksums are written wrapping_*.
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn crc32(p: *mut u8, n: u64) -> u32 {
    let mut crc: u32 = 0xFFFFFFFF;
    let mut i: u64 = 0;
    while i != n {
        unsafe { crc = crc ^ (*p.add(i as usize)) as u32; }
        let mut k: i64 = 0;
        while k != 8 {
            let mask: u32 = (crc & 1).wrapping_neg();
            crc = (crc >> 1) ^ (0xEDB88320 & mask);
            k += 1;
        }
        i += 1;
    }
    ~crc
}

fn main() -> i64 {
    let a = "The quick brown fox jumps over the lazy dog";
    let b = "123456789";
    let c = "";
    unsafe {
        printf(c"%08x %08x %08x\n", crc32(&mut *a.as_ptr(), (a.len() as u64)),
            crc32(&mut *b.as_ptr(), (b.len() as u64)), crc32(&mut *c.as_ptr(), (c.len() as u64)));
    }
    0
}
