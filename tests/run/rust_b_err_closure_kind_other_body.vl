// RULE: D19.6
// (0.30.1, RT-33 round 5) A closure whose kind fails its bound (closure.kind,
// rustc's E0525) keeps only the bodies that hold it from the borrow
// check: the closure's and the fn's that makes it. Every other body is
// checked, and its errors reported: here other()'s E0502, as rustc
// reports both. Before, one kind error skipped every body of the program.
// ERROR: error[borrowck.conflict]: cannot borrow 'v' as mutable because it is also borrowed as immutable
// ERROR: line 20,
// ERROR: error[closure.kind]: expected a closure that implements the `Fn` trait, but this closure only implements `FnMut`: it changes what it captures
// ERROR: line 28,
// ERROR-COUNT: 2
fn shared<F: Fn()>(f: &F) {
    f();
    f();
}

fn other() {
    let mut v = 1i64;
    let a = &v;
    let b = &mut v;
    *b += 1;
    println("{}", *a);
}

fn main() {
    let mut x = 0i64;
    let r = &mut x;
    let c = || {
        *r += 1;
    };
    shared(&c);
    other();
    println("{}", x);
}
