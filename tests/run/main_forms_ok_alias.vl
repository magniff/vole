// (0.30.2, RT-47's family) A type is what it resolves to: aliases of i32
// and of argv's pointer type are main's own.
// ARGS: one two
// EXPECT: 3
// EXIT: 3
type Status = i32;
type Argv = *const *const u8;

fn main(argc: Status, argv: Argv) -> Status {
    let _ = argv;
    println("{argc}");
    argc
}
