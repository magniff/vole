// EDITION: rust
// (0.27.0) Hand-translated from tests/run/sem_own_generic_needs_drop.vl to Rust's spelling.
// sem-own: std::needs_drop reports owned vs plain types.
// EXPECT: true false true
struct D<A: Allocator> {
    id: i64,
    v: Vec<i64, A>,
}

impl Drop for D<Gpa> {
    fn drop(&mut self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn eat(d: D<Gpa>) {
    println("eat {}", d.id);
}

struct Pt {
    x: i64,
}

fn main(gpa: Gpa) {
    println(
        "{} {} {}",
        std::needs_drop::<D<Gpa>>(),
        std::needs_drop::<Pt>(),
        std::needs_drop::<Vec<i64, Gpa>>(),
    );
}
