// FLAGS: --check-alloc
// RULE: D21.5 (0.30.2, RT-145) A generic `wrap(mk(1))` returning `(T,
// i64)`, T an opaque type checked after main: the tuple is dropped with
// the closure's D (0.30.2's first try dropped nothing). The output is
// rustc's. (x11 of the review)
// EXPECT: w 1
// EXPECT: end
// EXPECT: drop 1
fn main() {
    let w = wrap(mk(1));
    println("w {}", (w.0)());
    println("end");
}

fn wrap<T>(t: T) -> (T, i64) {
    (t, 0)
}

struct D {
    k: i64,
}

fn val(d: &D) -> i64 {
    d.k
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

fn mk(k: i64) -> impl Fn() -> i64 {
    let d = D { k: k };
    move || val(&d)
}
