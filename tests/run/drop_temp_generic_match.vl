// (0.29) A generic call's result as a match scrutinee: bound by value, a
// part of it bound, a field of it matched, matched through a reference,
// nothing of it bound. Each value is dropped once: what an arm binds at the
// arm's end, the scrutinee's temporary at the end of the match.
// EXPECT: a 4
// EXPECT: d2
// EXPECT: b 4
// EXPECT: d3
// EXPECT: c 4
// EXPECT: d4
// EXPECT: d 4
// EXPECT: d5
// EXPECT: e some
// EXPECT: d6
// EXPECT: f 4
// EXPECT: d7
// EXPECT: d8
// EXPECT: g 4
// EXPECT: d9
// EXPECT: d10
// EXPECT: h 4
// EXPECT: d11
// EXPECT: end
// EXPECT: d1
// EXPECT: live 0
use std::sync::atomic::{AtomicI64, Ordering};

static NEXT: AtomicI64 = AtomicI64::new(0);
static LIVE: AtomicI64 = AtomicI64::new(0);

struct T {
    id: i64,
    v: i64,
}

fn mk(v: i64) -> T {
    LIVE.fetch_add(1, Ordering::Relaxed);
    T { id: NEXT.fetch_add(1, Ordering::Relaxed) + 1, v: v }
}

impl Drop for T {
    fn drop(&mut self) {
        LIVE.fetch_sub(1, Ordering::Relaxed);
        println("d{}", self.id);
    }
}

impl Clone for T {
    fn clone(&self) -> T {
        mk(self.v)
    }
}

fn obs(t: &T) -> i64 {
    t.v
}

fn dup<X: Clone>(x: &X) -> X {
    x.clone()
}

fn dup_opt<X: Clone>(x: &X) -> Option<X> {
    Some(x.clone())
}

fn dup_pair<X: Clone>(x: &X) -> (X, X) {
    (x.clone(), x.clone())
}

fn run() {
    let t = mk(4);
    match dup(&t) {
        T { v, .. } => println("a {v}"),
    }
    match dup(&t).v {
        4 => println("b 4"),
        _ => println("b other"),
    }
    match &dup(&t) {
        x => println("c {}", x.v),
    }
    match dup_opt(&t) {
        Some(x) => println("d {}", x.v),
        None => {}
    }
    match dup_opt(&t) {
        Some(_) => println("e some"),
        None => {}
    }
    match dup_pair(&t).0 {
        x => println("f {}", x.v),
    }
    match dup_pair(&t) {
        (x, _) => println("g {}", x.v),
    }
    match obs(&dup(&t)) {
        n => println("h {n}"),
    }
    println("end");
}

fn main() -> i32 {
    run();
    println("live {}", LIVE.load(Ordering::Relaxed));
    0
}
