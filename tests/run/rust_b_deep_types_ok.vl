// RULE: D4.2, F5.5
// (0.30.1) 25 nested Options of a reference, with the lifetimes right: an
// impl's signature as its trait's, a result tied to its argument.
// EXPECT: deep deep
trait Mk {
    fn mk(&self) -> Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<&'static str>>>>>>>>>>>>>>>>>>>>>>>>>;
}

struct S;

impl Mk for S {
    fn mk(&self) -> Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<&'static str>>>>>>>>>>>>>>>>>>>>>>>>> { Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some("deep"))))))))))))))))))))))))) }
}

fn deep<'a>(x: &'a str) -> Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<Option<&'a str>>>>>>>>>>>>>>>>>>>>>>>>> { Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(Some(x))))))))))))))))))))))))) }

fn main(gpa: Gpa) {
    let st = String::from_in("deep", gpa);
    let v = deep(st.as_str());
    println("{} {}",
        v
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap(),
        S
            .mk()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap()
            .unwrap());
}
