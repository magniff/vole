// EDITION: rust
// The std2 item(s): std::str str::replacen_in.
// EXPECT: new new 123 foo foo new23 abc
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "foo foo 123 foo";
    println("{} {} {}", s.replacen_in("foo", "new", 2, gpa),
        "foo 123".replacen_in(char::is_numeric, "new", 1, gpa),
        "abc".replacen_in("z", "y", 5, gpa));
}
