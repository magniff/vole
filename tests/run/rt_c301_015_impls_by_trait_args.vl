// From review 5's m01 (also m03, m04, m13): before review 4's fix the predicates of neither impl were required (a use after free in the unsound form, m05); now both are.
// rustc accepts it: the chosen impl, Tr<i64>'s, has no bound.
// EXPECT: 64
trait Tr<U> {
    fn f(&self) -> i64;
}

struct W<'a> {
    r: &'a str,
}

impl<'a: 'static> Tr<i32> for W<'a> {
    fn f(&self) -> i64 {
        32
    }
}

impl<'a> Tr<i64> for W<'a> {
    fn f(&self) -> i64 {
        64
    }
}

fn go<T: Tr<i64>>(t: &T) -> i64 {
    t.f()
}

fn main(gpa: Gpa) {
    let st = String::from_in("hello", gpa);
    let x = W { r: st.as_str() };
    println("{}", go(&x));
}
