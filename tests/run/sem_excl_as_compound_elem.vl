// v[i] += through inout with an index computed by a call that reads v
// EXPECT: 1 12
fn last(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 - 1 }
fn f(v: inout Vec<i64, Gpa>) { v[last(v)] += 10; }

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v.push(2); f(&v);
    println("{} {}", v[0], v[1]);
}
