// EDITION: rust
// v[i] += through inout with an index computed by a call that reads v
// EXPECT: 1 12
fn last(v: &Vec<i64, Gpa>) -> i64 { v.len() as i64 - 1 }
fn f(v: &mut Vec<i64, Gpa>) { { let at_ix = last(v) as usize; v[at_ix] += 10 }; }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v.push(2); f(&mut v);
    println("{} {}", v[0], v[1]);
}
