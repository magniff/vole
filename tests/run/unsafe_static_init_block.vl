// In unsafe code a static's initializer may make a pointer from an
// integer (0.25): `unsafe { e }` is constant when e is, in an aggregate
// too; the literal 0 (null) needs none.
// EXPECT: 4096 8192 0 true
// EXPECT: 12288
static P: *mut i64 = unsafe { 4096 as *mut i64 };
static Q: [*mut i64; 2] = [unsafe { 8192 as *mut i64 }, 0 as *mut i64];
const A: i64 = unsafe { (12288 as *mut u8) as i64 };

fn main() -> i32 {
    println("{} {} {} {}", P as i64, Q[0] as i64, Q[1] as i64, Q[1].is_null());
    println("{}", A);
    0
}
