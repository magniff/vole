// RULE: D2.5
// (0.27.1) Reading `*m` while its reborrow `&mut *m` is live.
// ERROR: error[borrowck.use_borrowed]
// ERROR: line 12, column 13
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn main() {
    let mut x: i64 = 1;
    let m = &mut x;
    let q = &mut *m;
    let t = *m;
    *q += t;
    println("{}", x);
}
