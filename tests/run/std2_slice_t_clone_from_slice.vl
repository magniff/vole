// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice [T]::clone_from_slice.
// EXPECT: ["a", "b"]
use std::slice::SliceIndex;

fn main(gpa: Gpa) {
    let mut a = [String::new_in(gpa), String::new_in(gpa)];
    let b = [String::from_in("a", gpa), String::from_in("b", gpa)];
    a.clone_from_slice(&b);
    println("{:?}", a);
}
