// EDITION: rust
// RULE: F6.2
// Two traits' methods with one receiver type at one step of the probe
// (`F1::f(&self)` of S and `F2::f(self)` of `&S`, both `&S`) are
// ambiguous (rustc E0034).
// ERROR: error[method.ambiguous]: multiple applicable items: 'f' of trait 'F1' and of trait 'F2' take one receiver type
struct S {
    n: i64,
}

trait F1 {
    fn f(&self) -> i64;
}

trait F2 {
    fn f(self) -> i64;
}

impl F1 for S {
    fn f(&self) -> i64 {
        1
    }
}

impl<'a> F2 for &'a S {
    fn f(self) -> i64 {
        2
    }
}

fn main() -> i64 {
    let s = S { n: 0 };
    let r = &s;
    r.f() + s.f()
}
