// RULE: F5.6
// (0.30.1) std's sealed traits through std's own impls: a str searched for
// a char, a &str and a closure (Pattern), a Range of integers (Step), an
// index and a range of a slice and a str (SliceIndex).
// EXPECT: Some(1) Some(2) Some(3)
// EXPECT: 10 [2, 3] bc
fn main() {
    let s = "abcd";
    println("{:?} {:?} {:?}", s.find('b'), s.find("cd"), s.find(|c: char| c == 'd'));
    let mut n = 0;
    for i in 0..5 {
        n += i;
    }
    let a = [1, 2, 3];
    println("{} {:?} {}", n, &a[1..], &s[1..3]);
}
