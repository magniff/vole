// EDITION: rust
// (0.21) Atomics and fences are barriers for shared memory
// (docs/design/concurrency.md §4.2): a plain store before a release is
// kept and stays before it, a plain load after an acquire stays after it
// and is not forwarded from before, two acquire loads are not merged, a
// spin loop's load is not hoisted, and a store before a fence is not
// dead though the location is stored again after it.
// CHECK: fn publish
// CHECK: store
// CHECK: atomic.store.release
// CHECK: fn consume
// CHECK: atomic.load.acquire
// CHECK: load
// CHECK: fn reread
// CHECK: store
// CHECK: atomic.load.acquire
// CHECK: load
// CHECK: fn twice
// CHECK: atomic.load.acquire
// CHECK: atomic.load.acquire
// CHECK: fn overwrite
// CHECK: store
// CHECK: fence.seqcst
// CHECK: store
// EXPECT: 42 2 7 5

use std::sync::atomic::AtomicBool; use std::sync::atomic::AtomicI64; use std::sync::atomic::Ordering; use std::sync::atomic::fence;

static mut DATA: i64 = 0;
static mut READY: AtomicBool = AtomicBool::new(false);
static mut SEQ: AtomicI64 = AtomicI64::new(0i64);

#[inline(never)]
fn publish(x: i64) {
    unsafe { DATA = x; }
    unsafe { (*(&raw const READY)).store(true, Ordering::Release) };
}

#[inline(never)]
fn consume() -> i64 {
    while !unsafe { (*(&raw const READY)).load(Ordering::Acquire) } {}
    unsafe { DATA }
}

#[inline(never)]
fn reread() -> i64 {
    unsafe { DATA = 5; }
    unsafe { (*(&raw const READY)).load(Ordering::Acquire) };
    unsafe { DATA }
}

#[inline(never)]
fn twice() -> i64 {
    (unsafe { (*(&raw const SEQ)).load(Ordering::Acquire) }) + unsafe { (*(&raw const SEQ)).load(Ordering::Acquire) }
}

#[inline(never)]
fn overwrite() {
    unsafe { DATA = 1; }
    fence(Ordering::SeqCst);
    unsafe { DATA = 2; }
}

fn main() {
    publish(42);
    let a = consume();
    overwrite();
    unsafe { (*(&raw const SEQ)).store(3, Ordering::Relaxed) };
    let b = unsafe { DATA };
    println("{a} {b} {} {}", twice() + 1, reread());
}
