// XFAIL: RT-444: std::iter::successors given a fn item, `nx: fn(&&'a i64) -> Option<&'a i64>`, is refused inside std, borrowck.return_local on its 'item'; rustc prints [2000] (v0.30.1 too) (0.30.2)
// EXPECT: [2000]
fn nx<'a>(x: &&'a i64) -> Option<&'a i64> {
    if **x > 0 { None } else { Some(*x) }
}

fn main(gpa: Gpa) {
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(2000);
    let r: Vec<&i64, Gpa> = std::iter::successors(Some(&w[0]), nx).collect_in(gpa);
    println("{:?}", r);
}
