// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::slice ChunksExact.
// EXPECT: 2
use std::slice::ChunksExact;

fn n(c: ChunksExact<'_, i64>) -> usize {
    c.count()
}

fn main() {
    let s: &[i64] = &[1, 2, 3, 4, 5];
    println("{}", n(s.chunks_exact(2)));
}
