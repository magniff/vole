// Runs on std since 0.27.2's switch.
// The std item(s): std::ops Deref::Target.
// EXPECT: 7
use std::ops::{Bound, Deref, DerefMut};

struct Wrap {
    v: i64,
    b: Bound<i64>,
}

impl Deref for Wrap {
    type Target = i64;

    fn deref(&self) -> &i64 {
        &self.v
    }
}

impl DerefMut for Wrap {
    fn deref_mut(&mut self) -> &mut i64 {
        &mut self.v
    }
}

fn get<D: Deref<Target = i64>>(d: &D) -> i64 {
    **d
}

fn main() {
    println("{}", get(&Wrap { v: 7, b: Bound::Unbounded }));
}
