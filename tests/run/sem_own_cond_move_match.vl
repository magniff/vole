// sem-own: moved in one match arm only; drop flag decides.
// EXPECT: eat 1
// EXPECT: drop 1
// EXPECT: kept
// EXPECT: drop 2
// EXPECT: kept
// EXPECT: drop 3
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }

fn run(id: i64, k: i64, gpa: Gpa) {
    let d = mk(id, gpa);
    match k {
        0 => eat(d),
        1 => println("kept"),
        _ => { println("kept"); }
    }
}

fn main(gpa: Gpa) { run(1, 0, gpa); run(2, 1, gpa); run(3, 2, gpa); }
