// RUSTC-EDITION: 2024
// RULE: D21.1, D21.3
// (0.27.2.1) A generic function's opaque result, one per instance: its
// hidden type is the instance's.
// EXPECT: 3 120
trait Show {
    fn show(&self) -> u32;
}

impl Show for i32 {
    fn show(&self) -> u32 { *self as u32 }
}

impl Show for char {
    fn show(&self) -> u32 { *self as u32 }
}

fn id<T: Show>(t: T) -> impl Show {
    t
}

fn main() {
    let a = id(3);
    let b = id('x');
    println("{} {}", a.show(), b.show());
}
