// XFAIL: RT-452b: (RT-452's call, no inherent into) `Into::<M>::into(6i64)` with `impl From<i64> for M` is refused, "'into' needs the type it converts to: 'i64' into what?": the turbofish's M is not taken as the target; rustc prints `8 12` (0.30.2)
// From the review of the method-probe work (g302probe2). Since v0.30.1 at least.
// From the review's form k02e_into_path_generic_i64_only. The same call
// in a generic body (conv3, `T: Into<M>`) is accepted.
// EXPECT: 8 12
struct M {
    k: i64,
}

impl From<i64> for M {
    fn from(x: i64) -> M {
        M { k: x * 2 }
    }
}

fn conv3<T: Into<M>>(x: T) -> i64 {
    Into::<M>::into(x).k
}

fn main() -> i32 {
    println("{} {}", conv3(4i64), Into::<M>::into(6i64).k);
    0
}
