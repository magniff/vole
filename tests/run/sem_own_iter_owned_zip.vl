// EDITION: rust
// sem-own: zip of two owned-item iterators, the longer one's extra item: dropped once.
// EXPECT: n 1
// EXPECT: drop 0
// EXPECT: drop 10
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    let w: Vec<(D<Gpa>, D<Gpa>), Gpa> = (0i64..1i64)
        .map(|i| mk(i, gpa)).zip((0i64..2i64).map(|i| mk(10 + i, gpa)))
        .collect_in(gpa);
    println("n {}", w.len());
}
