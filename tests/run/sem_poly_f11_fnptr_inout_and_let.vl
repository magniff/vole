fn app(d: &mut Vec<i64, Gpa>, s: &Vec<i64, Gpa>) { for x in s { d.push(x); } }

fn main(gpa: Gpa) {
    let f: fn(&mut Vec<i64, Gpa>, &Vec<i64, Gpa>) = app;
