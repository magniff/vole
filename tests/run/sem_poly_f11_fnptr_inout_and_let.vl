// a call through fn(inout Vec, let Vec) with the same Vec: own.conflict
// ERROR: [own.conflict]: 'v' has an inout access, '&v', and is read by 'v' in the same call
fn app(d: inout Vec<i64, Gpa>, s: Vec<i64, Gpa>) { for x in s { d.push(x); } }

fn main(gpa: Gpa) {
    let f: fn(inout Vec<i64, Gpa>, Vec<i64, Gpa>) = app;
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    f(&v, v);
    println("{}", v.len());
}
