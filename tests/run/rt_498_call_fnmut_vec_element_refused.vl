// XFAIL: RT-498: calling an FnMut element of a Vec through its index, `(v[1])()` (an `impl FnMut` element) and `(w[0])()` (a closure that writes its capture), is refused: "cannot borrow 'v[_]' as mutable, which is behind a `&` reference"; rustc calls through IndexMut and prints `11 1` (0.30.2)
// From the third re-review of g302copy. Since v0.30.1 at least.
// From the review's forms rf07b and rf07c; `v.iter_mut()` and an
// array's `(a[0])()` are accepted.
// EXPECT: 11 1
fn fm1(k: i64) -> impl FnMut() -> i64 {
    let mut n = k;
    move || {
        n += 1;
        n
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<_, Gpa> = Vec::new_in(gpa);
    v.push(fm1(0));
    v.push(fm1(10));
    let mut a = 0i64;
    let mut w: Vec<_, Gpa> = Vec::new_in(gpa);
    w.push(move || {
        a += 1;
        a
    });
    println("{} {}", (v[1])(), (w[0])());
}
