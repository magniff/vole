// XFAIL: RT-152: `self.t.m()` in `impl<T: B> H<T>` is refused as ambiguous (E0034) when T's type implements A and B with m (0.30.2)
// From g302qual (pre-existing, v0.30.1 too; m5).
// EXPECT: 1 2 2
trait A { fn m(&self) -> i64; }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn ga<T: A>(t: &T) -> i64 { t.m() }
fn gb<T: B>(t: &T) -> i64 { t.m() }
struct H<T> { t: T }
impl<T: B> H<T> { fn go(&self) -> i64 { self.t.m() } }
fn main() { let s = S; println("{} {} {}", ga(&s), gb(&s), H { t: S }.go()); }
