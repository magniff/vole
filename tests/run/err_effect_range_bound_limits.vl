// RULE: E2.1 (0.30.1, RT-19) `for i in 0..N` proves `a[i]` in bounds for
// an array of length at least N only when N, as the type reads it, is a
// number the proof can hold: a bound of 2^63 or more (negative as an
// i64), and `0..=9223372036854775807`, whose end does not fit, prove
// nothing (before, the first was -1 and the second wrapped to i64::MIN,
// both "at most" every length). `0..3` and `0..=2` still prove it.
// ERROR: 'big' is #[no_panic], but it may panic
// ERROR: 'top' is #[no_panic], but it may panic
// ERROR: 'top_i' is #[no_panic], but it may panic
// ERROR-COUNT: 3
#[no_panic]
fn big(a: &[i64; 3], stop: usize) -> i64 {
    for i in 0..18446744073709551614usize {
        if i == stop {
            return a[i];
        }
    }
    0
}

#[no_panic]
fn top(a: &[i64; 3], stop: usize) -> i64 {
    for i in 0..=9223372036854775807usize {
        if i == stop {
            return a[i];
        }
    }
    0
}

#[no_panic]
fn top_i(a: &[i64; 3], stop: i64) -> i64 {
    for i in 0..=9223372036854775807i64 {
        if i == stop {
            return a[i as usize];
        }
    }
    0
}

#[no_panic]
fn fits(a: &[i64; 3]) -> i64 {
    let mut s = 0i64;
    for i in 0..3 {
        s = s.wrapping_add(a[i]);
    }
    for i in 0..=2 {
        s = s.wrapping_add(a[i]);
    }
    s
}

fn main() {
    let a: [i64; 3] = [1, 2, 3];
    println("{} {} {} {}", big(&a, 1), top(&a, 1), top_i(&a, 1), fits(&a));
}
