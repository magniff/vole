use std::alloc::Allocator; struct S<A: Allocator> { v: Vec<i64, A>, n: i64 }

impl S<Gpa> {
    fn each<F: FnMut(i64)>(&mut self, mut f: &F) {
        for i in 0..self.v.len() { f(self.v[i]); self.v.push(0); }
    }
}

fn main(gpa: Gpa) {
    let mut s = S { v: Vec::new_in(gpa), n: 0 }; s.v.push(1); s.each(|x| { s.n += x; });
    println("{}", s.n);
}
