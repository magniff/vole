// EDITION: rust
// The std2 item(s): std::sync Mutex (new, lock, try_lock, is_poisoned, get_mut, into_inner),
// MutexGuard (Deref, DerefMut, Drop), TryLockError, Condvar (new, wait, wait_while, notify_one,
// notify_all), Once (new, call_once, is_completed), with scoped threads.
// EXPECT: 4000
// EXPECT: true false
// EXPECT: 4001 false
// EXPECT: woken true
// EXPECT: 3
// EXPECT: 1 true
use std::thread;
use std::sync::{Condvar, Mutex, Once};

fn main() {
    let m = Mutex::new(0i64);
    thread::scope(|s| {
        for _ in 0..4 {
            s.spawn(|| {
                for _ in 0..1000 {
                    *m.lock().unwrap() += 1;
                }
            });
        }
    });
    println("{}", *m.lock().unwrap());
    {
        let g = m.lock().unwrap();
        println("{} {}", m.try_lock().is_err(), m.is_poisoned());
        drop(g);
    }
    let mut m = m;
    *m.get_mut().unwrap() += 1;
    let free = m.try_lock().is_ok();
    println("{} {}", m.into_inner().unwrap(), !free);

    let ready = Mutex::new(false);
    let cv = Condvar::new();
    thread::scope(|s| {
        s.spawn(|| {
            *ready.lock().unwrap() = true;
            cv.notify_one();
        });
        let mut g = ready.lock().unwrap();
        while !*g {
            g = cv.wait(g).unwrap();
        }
        println("woken {}", *g);
    });

    let count = Mutex::new(0);
    let all = Condvar::new();
    thread::scope(|s| {
        for _ in 0..3 {
            s.spawn(|| {
                *count.lock().unwrap() += 1;
                all.notify_all();
            });
        }
        let g = all.wait_while(count.lock().unwrap(), |n| *n < 3).unwrap();
        println("{}", *g);
    });

    let once = Once::new();
    let hits = Mutex::new(0);
    thread::scope(|s| {
        for _ in 0..4 {
            s.spawn(|| once.call_once(|| *hits.lock().unwrap() += 1));
        }
    });
    println("{} {}", *hits.lock().unwrap(), once.is_completed());
}
