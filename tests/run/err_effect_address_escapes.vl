// RULE: E1.8 (0.30.1) A borrow of a proven local that goes where it may
// become a raw pointer takes the proof away: to a callee that makes a
// pointer of a reference (or calls code that does), or into a value, a
// binding or a capture in a function that does. A shared borrow counts as
// an exclusive one. Each of these was accepted by this branch's draft of
// E1.8, which listed the ways to make a pointer: a pointer kept in a
// struct a helper returns (l1 hung at -O0, and -O2 deleted its loop), in
// a tuple, in a static, a shared reference made writable in a helper (k1
// panicked at -O0), through a struct holding the reference, a closure.
// ERROR: 'l1' is #[effects(unsafe)], but it may not terminate
// ERROR: 'l2' is #[effects(unsafe)], but it may not terminate
// ERROR: 'k1' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k2' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k3' is #[no_panic], but it may panic: 'x / d' at
// ERROR: 'k4' is #[no_panic], but it may panic: 'x / d' at
// ERROR-COUNT: 6

static mut KEPT: *mut u64 = std::ptr::null_mut();

struct Keeper {
    p: *mut i64,
}

impl Keeper {
    fn zero(&self) {
        // UNSAFE: the case: a write through a kept pointer
        // SAFETY: p is a live local's address
        unsafe {
            *self.p = 0;
        }
    }
}

fn keep(r: &mut i64) -> Keeper {
    Keeper { p: r as *mut i64 }
}

fn keep_pair(r: &mut i64) -> (i64, *mut i64) {
    (0, r as *mut i64)
}

fn zap(r: &u64) {
    let p = r as *const u64 as *mut u64;
    // UNSAFE: the case: a write through a pointer made of a shared reference
    // SAFETY: p is a live local's address
    unsafe {
        *p = 0;
    }
}

fn stash(r: &u64) {
    // UNSAFE: the case: a pointer kept in a static
    // SAFETY: the static is written once here
    unsafe {
        KEPT = r as *const u64 as *mut u64;
    }
}

fn clobber() {
    // UNSAFE: the case: a write through the kept pointer
    // SAFETY: KEPT is a live local's address
    unsafe {
        *KEPT = 0;
    }
}

struct H<'a> {
    r: &'a u64,
}

fn zap_h(h: H) {
    zap(h.r);
}

#[effects(unsafe)]
fn l1(n: i64) -> i64 {
    let mut i: i64 = 0;
    let k = keep(&mut i);
    while i < n {
        k.zero();
        i += 1;
    }
    i
}

#[effects(unsafe)]
fn l2(n: i64) -> i64 {
    let mut i: i64 = 0;
    let (_, p) = keep_pair(&mut i);
    while i < n {
        // UNSAFE: the case: a write through a pointer kept in a tuple
        // SAFETY: p is i's address and i is live
        unsafe {
            *p = 0;
        }
        i += 1;
    }
    i
}

#[no_panic]
fn k1(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        zap(&d);
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k2(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        stash(&d);
        clobber();
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k3(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        zap_h(H { r: &d });
        x / d
    } else {
        0
    }
}

#[no_panic]
fn k4(x: u64, n: u64) -> u64 {
    let d = n;
    if d != 0 {
        let f = || zap(&d);
        f();
        x / d
    } else {
        0
    }
}

fn main() {
    println("{} {}", l1(0), l2(0));
    println("{} {} {} {}", k1(7, 1), k2(7, 1), k3(7, 1), k4(7, 1));
}
