// EXPECT: 2 1
use std::mem; use std::alloc::Allocator; struct S<A: Allocator> { a: Vec<i64, A>, b: Vec<i64, A> }

fn main(gpa: Gpa) {
    let mut s = S { a: Vec::new_in(gpa), b: Vec::new_in(gpa) }; s.a.push(1); s.b.push(1);
    s.b.push(1);
    mem::swap(&mut s.a, &mut s.b); println("{} {}", s.a.len(), s.b.len());
}
