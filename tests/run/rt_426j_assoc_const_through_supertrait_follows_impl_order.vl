// XFAIL: RT-426j: WRONG CODE: (RT-426's family, an associated const through a supertrait) `T::N` under `T: Tr2`, with W implementing Tr2 (N = 2, declared first) and Tr (N = 1), and `trait Sub: Tr`, gives Tr's N: vole prints `1 1`, rustc `2 1` (`T::N` under `T: Sub` is right) (0.30.2)
// From the re-review of g302oblig M2 (its form a21b_assoc_const_order). Since v0.30.1 at
// least (v0.30.1 and the release build print `1 1`).
// EXPECT: 2 1
trait Tr2 {
    const N: i64;
}

trait Tr {
    const N: i64;
}

trait Sub: Tr {}

struct W;

impl Tr2 for W {
    const N: i64 = 2;
}

impl Tr for W {
    const N: i64 = 1;
}

impl Sub for W {}

fn n<T: Sub>() -> i64 {
    T::N
}

fn n2<T: Tr2>() -> i64 {
    T::N
}

fn main() {
    println("{} {}", n2::<W>(), n::<W>());
}
