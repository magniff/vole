// EDITION: rust
// 0.27.4: a closure whose body is a captured i32 where its bound's i64
// goes: the use is widened (a Cast over it), and the capture still found
// under it (closures::rewrite_use); it was "a function not lowered from its
// body".
// EXPECT: 3 4
fn run<F: Fn() -> i64>(f: F) -> i64 {
    f()
}

fn main() {
    let k: i32 = 3;
    println("{} {}", run(|| k), run(|| k + 1));
}
