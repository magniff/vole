// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::str str::impl AsRef<str>.
// EXPECT: 5 5
use std::str::CharIndices;

fn n<S: AsRef<str>>(s: S) -> usize {
    s.as_ref().len()
}

fn main(gpa: Gpa) {
    let owned = String::from_in("hello", gpa);
    println("{} {}", n("hello"), n(owned.as_str()));
}
