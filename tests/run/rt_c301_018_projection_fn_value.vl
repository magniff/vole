// RT-C301-18 (0.30.1, review 8) A function whose parameter is a
// projection, `<T as Tr>::A` or `T::A`, used as a value needs a 'static
// reference whenever the parameter's type holds one: the rule cannot read
// the projection's lifetimes from its text, and a 'static it hides would
// let a short reference through the value (RT-M2-2). Here `A = &'q str`
// with 'q the argument's own: rustc accepts both (review 8's f18, f14).
// A false error until the projection is read with its lifetimes (0.30.2).
// XFAIL: RT-C301-18: a projection parameter holding a non-'static reference refuses its function as a value (0.30.2)
// EXPECT: abc
// EXPECT: xyz
trait Tr {
    type A;
}

struct X;

impl<'q> Tr for &'q X {
    type A = &'q str;
}

fn f<T: Tr>(x: <T as Tr>::A) -> <T as Tr>::A {
    x
}

struct W<T> {
    t: T,
}

impl<T: Tr> W<T> {
    fn g(x: T::A) -> T::A {
        x
    }
}

fn main() {
    let a = f::<&X>;
    println("{}", a("abc"));
    let b = W::<&X>::g;
    println("{}", b("xyz"));
}
