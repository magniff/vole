// The std2 item(s): std::str str::graphemes.
// EXPECT: 4 [3, 2, 8, 1]
// RUSTC: none (vole's addition: graphemes)
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let mut lens = Vec::new_in(gpa);
    for g in "e\u{301}\r\n🇫🇷a".graphemes(true) {
        lens.push(g.len());
    }
    println("{} {:?}", lens.len(), lens);
}
