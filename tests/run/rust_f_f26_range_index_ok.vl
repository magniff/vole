// RULE: F26.3, F14.1
// A range value indexes a slice, an array or a str through Index and the
// SliceIndex impls: `a[r]` with `r: Range<usize>`, a RangeFrom, a
// RangeFull. A RangeFull's RangeBounds
// parameter comes from the expected type: `r.start_bound()` taken as a
// `Bound<&i64>`.
// EXPECT: [2, 3] [1, 2, 3] [3] ell Unbounded
use std::ops::{Bound, Range, RangeBounds, RangeFrom, RangeFull};

fn main() {
    let a = [1i64, 2, 3];
    let s: &[i64] = &a;
    let r: Range<usize> = 1..3;
    let f: RangeFull = ..;
    let from: RangeFrom<usize> = 2..;
    let t: &str = "hello";
    let tr: Range<usize> = 1..4;
    let b: Bound<&i64> = f.start_bound();
    println("{:?} {:?} {:?} {} {:?}", &s[r], &a[f], &a[from], &t[tr], b);
}
