// (0.28.0) alloc.default inside an item generic over an allocator: the
// help names the item's allocator parameter and the fix writes it (the
// impl's `A`, the function's `B`), not `Gpa`; with two allocator
// parameters the help names both and there is no fix (no `try:`); the
// transcript tests/refactor/allocgeneric0280.t has the fix's output.
// ERROR: error[alloc.default]: 'Vec' names no allocator: its 'A' is written, last
// ERROR: help: this item is generic over the allocator 'A': write it (`, A`, the fix), or `Gpa`
// ERROR: fix --only alloc
// ERROR: help: this item is generic over the allocator 'B': write it (`, B`, the fix), or `Gpa`
// ERROR: help: this item is generic over the allocators 'B' and 'C': write the one this 'Vec' allocates from as its last type argument (`, B`); no fix chooses between them
// ERROR-COUNT: 6
use std::alloc::Allocator;

struct Ring<T, A: Allocator> {
    items: Vec<T, A>,
    spare: Vec<T>,
}

impl<T: Copy, A: Allocator> Ring<T, A> {
    fn all(&self) -> &Vec<T> {
        let v: &Vec<T> = &self.items;
        v
    }

    fn count(&self, other: &Vec<T>) -> usize {
        other.len() + self.spare.len()
    }
}

fn same<T: Copy, B: Allocator>(v: &Vec<T, B>) -> &Vec<T, B> {
    let w: &Vec<T> = v;
    w
}

fn both<T: Copy, B: Allocator, C: Allocator>(v: &Vec<T, B>, w: &Vec<T, C>) -> usize {
    let u: &Vec<T> = v;
    u.len() + w.len()
}

fn main(gpa: Gpa) {
    let mut r: Ring<i64, Gpa> = Ring { items: Vec::new_in(gpa), spare: Vec::new_in(gpa) };
    r.items.push(1);
    let a = r.all();
    let n = r.count(a);
    let b = same(a);
    println("{n} {}", both(a, b));
}
