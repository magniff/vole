// The std item(s): std::collections BinaryHeap and MinHeap: new_in, with_capacity_in, from_vec,
// From<Vec>, push, pop, peek, len, is_empty, clear, capacity, iter, into_sorted_vec, append,
// Extend, Clone, Debug, `for x in &heap`; BinaryHeap<Reverse<T>>.
// RUSTC: none (the heaps take their allocator, and MinHeap is vole's)
// FLAGS: --check-alloc
// EXPECT: 7 Some(9) false
// EXPECT: [9, 8, 7, 5, 3, 2, 1] None
// EXPECT: Some(0) 0 1 3 4 7 9
// EXPECT: [1, 1, 2, 3, 4, 5, 6, 9] 8
// EXPECT: [1, 1, 2, 3, 4, 5, 6, 9]
// EXPECT: 2
// EXPECT: 4 0 Some("zoo") true
// EXPECT: 4 0
use std::cmp::Reverse;
use std::collections::{BinaryHeap, MinHeap};

fn main(gpa: Gpa) {
    let mut h: BinaryHeap<i64, Gpa> = BinaryHeap::new_in(gpa);
    for x in [5, 1, 8, 3, 9, 2, 7] {
        h.push(x);
    }
    println("{} {:?} {}", h.len(), h.peek(), h.is_empty());
    let mut out = Vec::new_in(gpa);
    while let Some(x) = h.pop() {
        out.push(x);
    }
    println("{:?} {:?}", out, h.pop());
    let mut m: MinHeap<i64, Gpa> = MinHeap::from_vec(Vec::from_in([4, 9, 1, 7, 3], gpa));
    m.push(0);
    print("{:?}", m.peek());
    while let Some(x) = m.pop() {
        print(" {}", x);
    }
    println("");
    let b: BinaryHeap<i64, Gpa> = BinaryHeap::from(Vec::from_in([3i64, 1, 4, 1, 5, 9, 2, 6], gpa));
    let c = b.clone();
    println("{:?} {}", b.into_sorted_vec(), c.iter().count());
    let mm: MinHeap<i64, Gpa> = MinHeap::from(Vec::from_in([3i64, 1, 4, 1, 5, 9, 2, 6], gpa));
    println("{:?}", mm.into_sorted_vec());
    let mut r: BinaryHeap<Reverse<i64>, Gpa> = BinaryHeap::new_in(gpa);
    let src = [5i64, 2, 8];
    r.extend(src.iter().map(|x| Reverse(*x)));
    println("{}", r.pop().unwrap().0);
    let mut s: BinaryHeap<String<Gpa>, Gpa> = BinaryHeap::with_capacity_in(4, gpa);
    s.push(String::from_in("pear", gpa));
    s.push(String::from_in("apple", gpa));
    s.push(String::from_in("zoo", gpa));
    let mut t: BinaryHeap<String<Gpa>, Gpa> = BinaryHeap::new_in(gpa);
    t.push(String::from_in("mango", gpa));
    s.append(&mut t);
    println("{} {} {:?} {}", s.len(), t.len(), s.peek(), s.capacity() >= 4);
    let mut n = 0;
    for _ in &s {
        n += 1;
    }
    s.clear();
    println("{} {}", n, s.len());
}
