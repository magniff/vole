// RULE: D2.4a
// (0.30.1) An array's part that moves a place moves it where it is
// evaluated: the later part's `w.clone()` reads the moved w (rustc E0382,
// vole's use_moved), at the read. Before, w moved after both parts and
// the program was accepted.
// ERROR: error[borrowck.use_moved]
// ERROR: line 11, column 17
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let w = format_in("old", gpa);
    let a = [w, w.clone()];
    println("{}", a[1]);
}
