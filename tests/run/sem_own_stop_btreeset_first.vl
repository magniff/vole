use std::alloc::Allocator; use std::hash::Hash; use std::collections::HashMap;
struct K<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for K<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }
impl PartialEq for K<Gpa> { fn eq(&self, other: &K<Gpa>) -> bool { self.id == other.id } } impl Eq for K<Gpa> {}
impl Hash for K<Gpa> { fn hash(&self) -> u64 { self.id as u64 } }

fn mk(id: i64, gpa: Gpa) -> K<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); K { id: id, v: v }
}

impl Ord for K<Gpa> {
    fn cmp(&self, other: &K<Gpa>) -> std::cmp::Ordering { ({ self.id - other.id }).cmp(&0) }
} impl PartialOrd for K<Gpa> { fn partial_cmp(&self, o: &Self) -> Option<std::cmp::Ordering> { Some(
    self.cmp(o)) } }

fn main(gpa: Gpa) {
    let mut s: std::BTreeSet<K<Gpa>, Gpa> = std::BTreeSet::new_in(gpa);
    s.insert(mk(1, gpa));
    let mut keep: Vec<K<Gpa>, Gpa> = Vec::new_in(gpa);
