// EDITION: rust
// RULE: D2.1
// (0.27.1) A `*const` from `&x`: no loan (R1); `x` is assigned while the
// pointer lives.

fn main() {
    let mut x: i64 = 1;
    let p = &x as *const i64;
    x = 2;
    let v = unsafe { *p };
    println("{}", v);
}
// EXPECT: 2
