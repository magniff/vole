// XFAIL: RT-265: a fn whose result is a projection of a parameter, `fn first<C: IntoIterator>(c: C) -> Option<C::Item>`, is refused: borrowck.elision "the result of 'first' borrows, but from which parameter is not said" (0.30.2)
// From the review of g302bor (b/g47). rustc builds it and prints the EXPECT
// line: the result's regions are C's, through the projection, and no lifetime
// is elided. On v0.30.1 too.
// EXPECT: Some(1) Some(3) None
fn first<C: IntoIterator>(c: C) -> Option<C::Item> {
    c.into_iter().next()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    w.push(3);
    let e: Vec<i64, Gpa> = Vec::new_in(gpa);
    let p: Option<&i64> = first(&v);
    let q: Option<i64> = first(w);
    let n: Option<i64> = first(e);
    println("{:?} {:?} {:?}", p, q, n);
}
