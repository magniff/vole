// XFAIL: gap 4: compile type error: the trait 'Borrow<i32>' is not implemented for 'i64'
// FLAGS: --check-alloc --verify-effects
// EXPECT: [0, 1, 4, 9, 16] 30 [16, 9, 4, 1, 0]
// EXPECT: 100 4950 x=42
// EXPECT: 3
// EXPECT: live 0 true
// 0.16: --check-alloc runs a correct program as without it: std's
// containers (growth, clone, HashMap's rehashes, Buf, sort, split) on the
// checking Gpa, everything freed at the end.

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i * i);
    }
    let mut w = v.clone();
    w.as_slice().sort_unstable_by(|a, b| (|a: i64, b: i64| b - a)(*a, *b).cmp(&0));
    let total = v.iter().copied().sum::<i64>();
    println("{v:?} {total} {w:?}");
    let mut m: std::collections::HashMap<i64, i64, Gpa,
        FixedState> = std::collections::HashMap::new_in(gpa);
    for i in 0..100 {
        m.insert(i, i);
    }
    let mut keys: i64 = 0;
    for i in 0..100 {
        if m.get(&i).copied().is_some() {
            keys += i;
        }
    }
    let mut b = std::string::String::new_in(gpa);
    b.push_str("x=");
    std::fmt::write(&mut b, 42i64).unwrap();
    println("{} {keys} {}", m.len(), str::from_utf8(b.as_bytes()).unwrap());
    let mut parts = std::split_in("a bb ccc", b' ', gpa);
    println("{}", parts.len());
    drop(v);
    drop(w);
    drop(m);
    drop(b);
    drop(parts);
    println("live {} {}", gpa.live_blocks() as i64, gpa.check_leaks());
}
