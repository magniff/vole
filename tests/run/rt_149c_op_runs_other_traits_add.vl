// XFAIL: RT-149: `a + b` runs a user trait's `add` of the same name instead of std::ops::Add's (RT-149's form through a qualified-path program) (0.30.2)
// From the g302qual review (form f17_op_trait).
// EXPECT: 12 7 12 7 7
use std::ops::Add;
trait MyAdd { fn add(self, o: S) -> i64; }
#[derive(Clone, Copy)]
struct S { v: i64 }
impl Add for S { type Output = i64; fn add(self, o: S) -> i64 { self.v + o.v } }
impl MyAdd for S { fn add(self, o: S) -> i64 { self.v * o.v } }

fn main() {
    let a = S { v: 3 }; let b = S { v: 4 }; let f = <S as MyAdd>::add; let g = <S as Add>::add;
    println("{} {} {} {} {}", <S as MyAdd>::add(a, b), <S as Add>::add(a, b), f(a, b), g(a, b),
        a + b);
}
