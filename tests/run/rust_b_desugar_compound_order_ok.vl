// RULE: D2.4a
// (0.30.1) A primitive compound assignment evaluates the right side first, then
// the place: `a[i] += { i = 2; 10 }` adds to a[2], as rustc.
// EXPECT: [1, 2, 13]
fn main() {
    let mut i: usize = 0;
    let mut a = [1, 2, 3];
    a[i] += {
        i = 2;
        10
    };
    println("{:?}", a);
}
