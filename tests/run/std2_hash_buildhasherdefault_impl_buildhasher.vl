// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::hash BuildHasherDefault::impl BuildHasher.
// EXPECT: write [7]
// EXPECT: 1
// EXPECT: 0
use std::hash::{BuildHasher, BuildHasherDefault, Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

impl Default for Show {
    fn default() -> Show {
        Show { n: 0 }
    }
}

fn main() {
    let b: BuildHasherDefault<Show> = BuildHasherDefault::default();
    println("{}", b.hash_one(7u8));
    println("{}", b.build_hasher().finish());
}
