// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_map IntoKeys::impl Iterator.
// EXPECT: Some(3) None
use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(3, 1);
    let mut it = m.into_keys();
    let a = it.next();
    println("{:?} {:?}", a, it.next());
}
