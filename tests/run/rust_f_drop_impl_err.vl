// (0.30.1, review 5) A Drop impl runs for every value of its type, so it
// is as general as the type's declaration (rustc E0366, E0367): no
// lifetime bound the declaration lacks, in a `where` (review 5's f31) or
// the header (f06), no extra bound of a type parameter (`T: Clone`, `T:
// 'static`), and the type written with distinct parameters (not
// `S<'static>`, `V<&'static str>`, `Q<'a, 'a>`; a type with no 'static
// in it, `V<i64>`, is a drop of those values only, which assumes
// nothing). Before, the `'a: 'static` was
// assumed in `drop` and required nowhere: `drop` pushed a dropped
// String's str into a `Vec<&'static str>`.
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR: trait.drop_impl
// ERROR-COUNT: 7
use std::alloc::Allocator;

struct W<'a, 'b, A: Allocator> {
    r: &'a str,
    out: &'b mut Vec<&'static str, A>,
}

impl<'a, 'b, A: Allocator> Drop for W<'a, 'b, A> where 'a: 'static {
    fn drop(&mut self) {
        self.out.push(self.r);
    }
}

struct H<'a, 'b, A: Allocator> {
    r: &'a str,
    out: &'b mut Vec<&'static str, A>,
}

impl<'a: 'static, 'b, A: Allocator> Drop for H<'a, 'b, A> {
    fn drop(&mut self) {
        self.out.push(self.r);
    }
}

struct S<'a> {
    r: &'a str,
}

impl Drop for S<'static> {
    fn drop(&mut self) {}
}

struct V<T> {
    t: T,
}

impl Drop for V<&'static str> {
    fn drop(&mut self) {}
}

struct Q<'a, 'b> {
    r: &'a str,
    s: &'b str,
}

impl<'a> Drop for Q<'a, 'a> {
    fn drop(&mut self) {}
}

struct C<T> {
    t: T,
}

impl<T: Clone> Drop for C<T> {
    fn drop(&mut self) {}
}

struct K<T> {
    t: T,
}

impl<T: 'static> Drop for K<T> {
    fn drop(&mut self) {}
}

fn main() {}
