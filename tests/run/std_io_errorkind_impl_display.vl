// Runs on std since 0.27.2's switch.
// The std item(s): std::io ErrorKind::impl Display.
// EXPECT: entity not found|unexpected end of file|other error|invalid data
use std::io::ErrorKind;

fn main() {
    println("{}|{}|{}|{}", ErrorKind::NotFound, ErrorKind::UnexpectedEof, ErrorKind::Other,
        ErrorKind::InvalidData);
}
