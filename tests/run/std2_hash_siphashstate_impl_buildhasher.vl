// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash SipHashState::impl BuildHasher.
// EXPECT: 13851880170939887858
// RUSTC: none (SipHashState is std2's; its values are Rust's DefaultHasher's (SipHash-1-3, keys 0 and 0))
use std::hash::{Hash, Hasher, SipHashState, SipHasher13};

fn main() {
    let mut h = SipHashState::new().build_hasher();
    h.write("abc".as_bytes());
    println("{}", h.finish());
}
