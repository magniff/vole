// RULE: D3.6, R6
// (0.27.2) A call through a `fn` value ties its result to its arguments by
// E1-E2 over the `fn` type: `r` keeps `v` borrowed, and `v` dies first
// (rustc E0597; 0.27.1 made no constraint at such a call).
// ERROR: error[borrowck.dropped_borrowed]
// ERROR: line 17, column 15
// ERROR-COUNT: 1
fn id(x: &i64) -> &i64 {
    x
}

fn main() {
    let f: fn(&i64) -> &i64 = id;
    let r;
    {
        let v = 1;
        r = f(&v);
    }
    println("{}", *r);
}
