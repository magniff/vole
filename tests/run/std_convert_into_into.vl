// Runs on std since 0.27.2's switch.
// The std item(s): std::convert Into::into.
// EXPECT: 7
use std::convert::{From, Infallible};

struct M {
    v: i64,
}

impl From<i64> for M {
    fn from(v: i64) -> M {
        M { v: v }
    }
}

fn main() {
    let m: M = 7i64.into();
    println("{}", m.v);
}
