fn call<F: Fn(&mut i64) -> i64>(f: F, x: &mut i64) -> i64 { f(x) }

fn main() {
    let mut n: i64 = 1;
    let r = call(|x: &mut i64| -> i64 { let before = n; *x = 5; before * 100 + n }, &mut n);
    println("{r} {n}");
}
