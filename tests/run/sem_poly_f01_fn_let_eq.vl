// fn(T) and fn(let T) are one type: assigned both ways, compared, passed
// FLAGS: --check-alloc
// EXPECT: 1 1 1 1
fn len(v: &Vec<i64, Gpa>) -> i64 { v.len() as i64 }
fn lenl(v: &Vec<i64, Gpa>) -> i64 { v.len() as i64 }
fn run(f: fn(&Vec<i64, Gpa>) -> i64, v: &Vec<i64, Gpa>) -> i64 { f(v) }

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let a: fn(&Vec<i64, Gpa>) -> i64 = lenl;
    let b: fn(&Vec<i64, Gpa>) -> i64 = len;
    let mut c = a;
    c = b;
    println("{} {} {} {}", run(len, &v), run(lenl, &v), c(&v), v.len());
}
