// EDITION: rust
// RULE: D4.4 (g)
// (0.28.0) A closure that captures or returns a reference beside items
// that hold one, through std's adapters: the instances of Filter's find
// and Option's map have a universal per slot of each type argument, and
// the flows between them (an item into the closure's parameter) are the
// template's to judge, as rustc's, not an instance's outlives error.
// EXPECT: 1
// EXPECT: 1
// EXPECT: 2
use std::collections::HashMap;

#[derive(Clone, Copy)]
struct E<'a> {
    s: &'a str,
    n: i64,
}

fn main(gpa: Gpa) {
    let text = String::from_in("ab", gpa);
    let v = [E { s: &text, n: 1 }];
    let key = "ab";
    let n: i64 = v.iter().copied().filter(|e| e.s == key).map(|e| e.n).sum();
    println("{n}");
    let w: Vec<(&str, i64), Gpa> = v.iter().map(|e| (e.s, e.n)).collect_in(gpa);
    println("{}", w.len());
    let mut counts: HashMap<&[u8], u64, Gpa> = HashMap::new_in(gpa);
    counts.insert(b"ab", 2);
    let mut total: u64 = 0;
    for (_, c) in counts.iter().map(|(k, v)| (*k, *v)) {
        total += c;
    }
    println("{total}");
}
