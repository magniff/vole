// EDITION: rust
// a closure given to a user generic function stores a local into a capture
// ERROR: error[borrowck.dropped_borrowed]
fn twice<F: FnMut(i64)>(mut f: F) { let mut g = f; g(1); g(2); }

fn main(gpa: Gpa) {
    let mut saved: Vec<&str, Gpa> = Vec::new_in(gpa);
    twice(|i: i64| { let s = String::from_in("t", gpa); saved.push(s.as_str()); });
    println("{saved:?}");
}
