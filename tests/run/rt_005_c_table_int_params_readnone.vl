// XFAIL: RT-5: a C library function of std's table declared with integer parameters is readnone: -O1 and -O2 delete memset and fold strlen (open)
// FLAGS: -O2
// memset and strlen are in std's C table with no effects (`mem*`/`str*`:
// none), and middle::ipo::front_attrs makes an undeclared C function whose
// parameters are all numbers readnone. Declared with the pointer as a
// usize (ABI-compatible), memset becomes a call with no effect whose result
// is unused: -O1 and -O2 delete it and print [1, 2, 3]. strlen is taken as
// reading nothing, so buf, whose only stores are constants, becomes a
// constant table with its later store already in: both calls see "ab", and
// -O1 and -O2 print `2 2`. -O0 is right.
// EXPECT: [9, 9, 9]
// EXPECT: 4 2
extern "C" {
    fn memset(p: usize, c: i32, n: usize) -> usize;
    fn strlen(s: usize) -> usize;
}

fn main(gpa: Gpa) {
    let mut v: Vec<u8, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v.push(3);
    let a = v.as_mut_ptr() as usize;
    // UNSAFE: C's memset, the pointer passed as an integer
    // SAFETY: v has 3 bytes at a
    unsafe {
        memset(a, 9, 3);
    }
    println("{:?}", v);
    let mut buf: [u8; 8] = [b'a', b'b', b'c', b'd', 0, 0, 0, 0];
    let p = buf.as_mut_ptr() as usize;
    // UNSAFE: C's strlen, the pointer passed as an integer
    // SAFETY: buf is NUL-terminated
    let x = unsafe { strlen(p) };
    buf[2] = 0;
    // UNSAFE: C's strlen, the pointer passed as an integer
    // SAFETY: buf is NUL-terminated
    let y = unsafe { strlen(p) };
    println("{x} {y}");
}
