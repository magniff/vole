// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::result Result::inspect_err.
// EXPECT: err bad
// EXPECT: Err("bad")
use std::result::Result;

fn main() {
    let a: Result<i64, &str> = Ok(3);
    let b: Result<i64, &str> = Err("bad");
    let _ = a.inspect_err(|e| println("err {}", e));
    let c = b.inspect_err(|e| println("err {}", e));
    println("{:?}", c);
}
