// sem-own: keeping a `for x in v` item of an owned Vec (pushing it to
// another Vec) would own it twice: refused, or it moves. Expect a refusal.
// ERROR: own.move_out
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn main(gpa: Gpa) {
    var v: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    var w: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    for x in v { w.push(x); }
}
