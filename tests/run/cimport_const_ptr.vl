// RULE: F30.5
// (0.29) A C header's `const T *` is a `*const T`, its `T *` a `*mut T`:
// a parameter, a result, a field, a pointer to a const pointer, and an
// array parameter of const elements. A `*mut T` goes where the header
// says `const` (the coercion); a `c"..."` literal is a `*const u8`.
// CSOURCE: tests/c/constptr.c
// EXPECT: 6 21 3
// EXPECT: b 5
// EXPECT: 3 97 99
import "../c/constptr.h" as c;

fn main() {
    let mut a = [1i64, 2, 3];
    // UNSAFE: C calls on the array's pointers.
    // SAFETY: each call gets the array's pointer and its length, 3; fill
    // writes through the `*mut` one, which no reference is live across;
    // the last call gives a `*mut i64` where the header says `const long *`.
    let (before, after) = unsafe {
        let before = c::sum_const(a.as_ptr(), 3);
        c::fill(a.as_mut_ptr(), 3, 7);
        (before, c::sum_const(a.as_mut_ptr(), 3))
    };
    println("{} {} {}", before, after, a.len());
    let names: [*const u8; 2] = [c"a", c"b"];
    // UNSAFE: C calls on C strings.
    // SAFETY: names holds two NUL-terminated literals and 1 is in it;
    // pick returns one of them, read as a byte; cstr_len reads to the NUL.
    let (second, len) = unsafe {
        let second: *const u8 = c::pick(names.as_ptr(), 1);
        (*second, c::cstr_len(c"hello") as i64)
    };
    println("{} {}", second as char, len);
    let text = [97u8, 98, 99];
    let mut out = [0u8; 3];
    let s = c::span { data: text.as_ptr(), out: out.as_mut_ptr(), n: 3 };
    // UNSAFE: a C call that reads s.data and writes s.out.
    // SAFETY: both point to 3 bytes, s.n; the two arrays are apart.
    let n = unsafe { c::span_copy(&s) };
    println("{} {} {}", n, out[0], out[2]);
}
