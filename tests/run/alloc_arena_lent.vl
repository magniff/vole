// EDITION: rust
// XFAIL: gap 8: compile borrowck.use_moved: 'a' is used here after it moved (moved at alloc_arena_lent.vl: line 9, column 5...
// 0.16: while an arena is lent to a scope, allocating from it stops the
// program (the scope rewinds it when it ends).
// EXPECT: in the scope
// EXIT: 101
// STDERR: the arena is lent to a scope: allocate from the scope's arena
use std::alloc::Arena; use std::alloc::ArenaScope as ScopedArena; fn main(gpa: Gpa) {
    let a = Arena::new_in(gpa);
    let mut v: Vec<i64, Arena<Gpa>> = Vec::new_in(a);
    a.scope(|s| (|s: &ScopedArena<'_, Gpa>| {
        println("in the scope");
        v.push(1);
    })(s));
    println("not reached");
}
