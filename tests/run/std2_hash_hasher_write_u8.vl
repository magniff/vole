// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::hash Hasher::write_u8.
// EXPECT: write [7]
// EXPECT: 1
use std::hash::{Hash, Hasher};

struct Show {
    n: u64,
}

impl Hasher for Show {
    fn finish(&self) -> u64 {
        self.n
    }

    fn write(&mut self, bytes: &[u8]) {
        println("write {:?}", bytes);
        self.n += bytes.len() as u64;
    }
}

fn main() {
    let mut h = Show { n: 0 };
    h.write_u8(7);
    println("{}", h.finish());
}
