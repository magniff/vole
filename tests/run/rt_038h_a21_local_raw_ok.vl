// RULE: C3.4
// (0.30.2, the re-review of g302holes: c2/a21_local_raw_ok)
// RUSTC: none contract clauses are not Rust
// EXPECT: 3
// Must build: the clause's own array, written by a callee through a raw pointer.
fn poke(p: *mut i64) -> bool {
    // UNSAFE: test
    // SAFETY: test
    unsafe { *p = 9; }
    true
}

fn f(n: i64) -> i64
    requires { let mut a = [n, 0]; poke(&raw mut a[1]) && a[1] == 9 }

{
    n
}

fn main() {
    println("{}", f(3));
}
