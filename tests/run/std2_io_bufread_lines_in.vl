// The std2 item(s): std::io BufRead::lines_in.
// EXPECT: ["a", "b", "", "c"]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let b = BufReader::new("a\nb\r\n\nc".as_bytes());
    let v: Vec<String<Gpa>, Gpa> = b.lines_in(gpa).map(|l| l.unwrap()).collect_in(gpa);
    println("{:?}", v);
}
