// RULE: F8.2
// RT-159, a guard: the path calls rustc builds keep building. `T0::h(&mut
// s)` (a `&mut S` where `&Self` goes: the coercion any argument has),
// `T0::g(&mut s)`, `T0::f(s)`, `<S as T0>::h(&s)`, `S::g(&mut s)`, through
// a bound `T::h(&t)`, and `Self::h(self)` in a default. rustc prints this
// line.
// EXPECT: 10 2 2 20 3 30 30 3
trait T0 {
    fn f(self) -> i64;
    fn g(&mut self) -> i64;
    fn h(&self) -> i64;
    fn d(&mut self) -> i64 { Self::h(self) }
}

#[derive(Clone, Copy)]
struct S {
    k: i64,
}

impl T0 for S {
    fn f(self) -> i64 { self.k }
    fn g(&mut self) -> i64 { self.k += 1; self.k }
    fn h(&self) -> i64 { self.k * 10 }
}

fn go<T: T0>(t: &T) -> i64 { T::h(t) }

fn main() {
    let mut s = S { k: 1 };
    let a = T0::h(&mut s);
    let b = T0::g(&mut s);
    let c = T0::f(s);
    let d = <S as T0>::h(&s);
    let e = S::g(&mut s);
    let f = go(&s);
    let g = s.d();
    println("{} {} {} {} {} {} {} {}", a, b, c, d, e, f, g, s.k);
}
