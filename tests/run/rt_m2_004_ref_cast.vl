// `&T as &U` and `&mut T as &mut U` are transmutes: rustc refuses every
// one of them (E0605, non-primitive cast). vole accepts them in safe
// code: the first reads 800 KB past an i64 (a crash), the second makes a
// reference from the number 16, the third puts 100 in a bool (which
// then is neither true nor false), the fourth puts 0x110000 in a char.
// ERROR: line 19, column 17
// ERROR: line 22, column 17
// ERROR: line 27, column 13
// ERROR: line 31, column 13
// ERROR-COUNT: 4
fn pick(b: bool) -> i64 {
    match b { true => 1, false => 2 }
}

fn main() {
    let n = std::env::args().count();
    let x: i64 = 5;
    if n == 1 {
        let a = &x as &[i64; 100000];
        println("{}", a[99999]);
        let mut r: &i64 = &x;
        let p = &mut r as &mut usize;
        *p = 16;
        println("{}", *r);
    }
    let mut b = false;
    let q = &mut b as &mut u8;
    *q = 100;
    println("{}", pick(b));
    let mut c = 'a';
    let w = &mut c as &mut u32;
    *w = 0x110000;
    println("{}", c as u32);
}
