// EDITION: rust
// Runs on std2 since its gap closed (0.27.3).
// The std2 item(s): std::iter::adapters Scan.
// EXPECT: [1, 3]
use std::iter::Scan;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let v: Vec<i64, Gpa> = s.iter().scan(0i64, |a, x| {
        *a += x;
        Some(*a)
    }).collect_in(gpa);
    println("{:?}", v);
}
