// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Scan.
// EXPECT: [1, 3]
use std::iter::{FusedIterator, Scan};

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let v: Vec<i64, Gpa> = s.iter().scan(0, |a, x| {
        *a += x;
        Some(*a)
    }).collect_in(gpa);
    println("{:?}", v);
}
