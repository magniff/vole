// XFAIL: RT-395: (RT-395's mechanism, a supertrait) `z.g()` in `fn c<Z: Sub>(z: &Z)` with `trait Sub: Tr` and `trait Tr<U = i32>`, W having impls of Tr<i32> and Tr<i64>, is refused, "'W::g' is ambiguous for arguments ()": the supertrait's default is not applied; rustc prints 32 (0.30.2)
// From the review of g302oblig-m2 (form f270r). Since v0.30.1 at least;
// the release build the same. `trait Sub: Tr` is `Sub: Tr<i32>`.
// Siblings: rt_395, rt_395b, rt_395c, rt_395e.
// EXPECT: 32
trait Tr<U = i32> {
    fn g(&self) -> i64;
}

trait Sub: Tr {}

struct W {
    r: i64,
}

impl Tr<i32> for W {
    fn g(&self) -> i64 {
        32
    }
}

impl Tr<i64> for W {
    fn g(&self) -> i64 {
        64
    }
}

impl Sub for W {}

fn c<Z: Sub>(z: &Z) -> i64 {
    z.g()
}

fn main() {
    println("{}", c(&W { r: 0 }));
}
