// (0.30.1) Two locals of 2^60 bytes each fit as types; their frame of
// 2^61 bytes is accepted at every level (it was refused at -O0, with no
// position, and built at -O2, where the two shared a slot), as rustc
// accepts it. No stack is that large: the frame's probes fault on the
// guard page as the function is entered (its locals in a branch not
// taken), before it writes anything; the frame's size stays at the
// limit, never wrapped.
// EXPECT: before
// EXIT: 139
#[inline(never)]
fn two(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 1usize << 60];
        let b = [1u8; 1usize << 60];
        return a[n] + b[n];
    }
    println("inside");
    0
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", two(n));
}
