// XFAIL(x86_64-macos): RT-CG-4: x86-64 addresses a frame's slots with 32-bit displacements: a frame of 2 GiB or more cannot be assembled (open)
// XFAIL(x86_64-linux): RT-CG-4: x86-64 addresses a frame's slots with 32-bit displacements: a frame of 2 GiB or more cannot be assembled (open)
// (0.30.2, RT-83) Two locals of 2^60 bytes each; their frame of 2^61
// bytes is built at every level, as rustc builds it. No stack is that
// large, and sp - 2^61 is below 0: the frame's probes go down to 0 and
// fault on the guard page as the function is entered (its locals in a
// branch not taken), before it writes anything. v0.30.1 moved sp by the
// whole frame and ran on (at -O0 without printing `inside`, its output
// lost; at -O2 printing it), exit 0.
// EXPECT: before
// EXIT: 139
#[inline(never)]
fn two(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 1usize << 60];
        let b = [1u8; 1usize << 60];
        return a[n] + b[n];
    }
    println("inside");
    0
}

fn main() {
    let n = std::env::args().count();
    println("before");
    println("{}", two(n));
}
