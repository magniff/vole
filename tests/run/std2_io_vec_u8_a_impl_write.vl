// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::io Vec<u8, A>::impl Write.
// EXPECT: [1, 2, 3]
use std::io::{BufRead, ErrorKind, Read, Write};

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1u8], gpa);
    v.write_all(&[2, 3]).unwrap();
    println("{:?}", v);
}
