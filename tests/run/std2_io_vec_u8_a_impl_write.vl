// EDITION: rust
// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io Vec<u8, A>::impl Write.
// EXPECT: [1, 2, 3]
use std::io::{BufRead, BufReader, BufWriter, ErrorKind, Read, Write, self};

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1u8], gpa);
    v.write_all(&[2, 3]).unwrap();
    println("{:?}", v);
}
