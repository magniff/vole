// RULE: D19.1, D19.10
// (0.30.2, RT-44) A closure in a generic function that only a generic
// Drop impl's instance calls (late, as rt_044b's).
// EXPECT: ok
// EXPECT: drop 3
use std::thread;

fn g<T>(t: &T) -> i64 {
    let _ = t;
    thread::scope(|s| {
        s.spawn(|| 1i64);
    });
    3
}

struct W<T> {
    t: T,
}

impl<T> Drop for W<T> {
    fn drop(&mut self) {
        println("drop {}", g(&self.t));
    }
}

fn main() {
    let w = W { t: 1u8 };
    let _ = &w.t;
    println("ok");
}
