// RULE: AT2
// (0.27.2) A negative impl is of an auto trait only, is not `unsafe`, and
// has no items; a positive vouch of an auto trait is `unsafe impl`; a
// positive and a negative vouch for one type conflict.
// RUSTC: none negative impls are unstable in rustc (`negative_impls`)
// ERROR: a negative impl is of an auto trait (`impl !Send for T {}`, `impl !Sync for T {}`), not of 'Clone'
// ERROR: a negative impl is not unsafe: it promises nothing (rustc E0198)
// ERROR: the trait 'Send' is unsafe: its impl is `unsafe impl`
// ERROR: conflicting impls of trait 'Sync' for 'D'
struct A {
    a: i64,
}

impl !Clone for A {}

struct B {
    b: i64,
}

unsafe impl !Send for B {}

struct C {
    c: i64,
}

impl Send for C {}

struct D {
    d: i64,
}

unsafe impl Sync for D {}

impl !Sync for D {}

fn main() {}
