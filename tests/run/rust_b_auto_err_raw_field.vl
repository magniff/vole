// ERROR: line 22, column 13
// ERROR-COUNT: 1
struct Inner {
    p: *const i64,
}

struct Outer {
    inner: Inner,
}

fn send<T: Send>(t: T) -> T {
    t
}

fn main() {
    let v: i64 = 1;
    let _ = send(Outer { inner: Inner { p: &v as *const i64 } });
}
