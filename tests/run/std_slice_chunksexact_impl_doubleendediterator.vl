// Runs on std since 0.27.2's switch.
// The std item(s): std::slice ChunksExact::impl DoubleEndedIterator.
// EXPECT: [3, 4] [1, 2] None

fn main() {
    let s: &[i64] = &[1, 2, 3, 4, 5];
    let mut c = s.chunks_exact(2);
    println("{:?} {:?} {:?}", c.next_back().unwrap(), c.next_back().unwrap(), c.next_back());
}
