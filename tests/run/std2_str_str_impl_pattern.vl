// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::str &str::impl Pattern.
// EXPECT: Some(3) true ["a", "c"]
use std::str::CharIndices;

fn main(gpa: Gpa) {
    let s = "abcbc";
    let p: &str = "bc";
    println("{:?} {} {:?}", s.rfind(p), s.starts_with("ab"),
        "a--c".split("--").collect_in::<Vec<&str, Gpa>, Gpa>(gpa));
}
