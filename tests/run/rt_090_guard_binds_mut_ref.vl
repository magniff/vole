// XFAIL: RT-90: a guarded match arm that binds a `&mut` scrutinee by value is refused: "'x' is used here after it moved (moved at" the same position) (0.30.2)
// `match x { v if *v > 0 => *v += 1, _ => .. }` with x: &mut i64 is valid
// Rust (rustc prints the EXPECT line): a guard sees its bindings by
// reference, and v takes x only once the arm is chosen. vole refuses both
// functions with `error[borrowck.use_moved] 'x' is used here after it
// moved (moved at g3.vl:3:9)`, the use and the move at one position, even
// in h, where nothing else uses x; its `try:` (`ref v if ...`) gives
// `compound assignment requires numeric type, got '&mut i64'`. With an
// owned scrutinee (a D with Drop) the same arm form is accepted and runs
// as in Rust.
// EXPECT: 7 100
fn f(x: &mut i64) {
    match x {
        v if *v > 0 => *v += 1,
        _ => *x = 100,
    }
}

fn h(x: &mut i64) {
    match x {
        v if *v > 0 => *v += 1,
        _ => {}
    }
}

fn main() {
    let mut a = 5i64;
    f(&mut a);
    let mut b = -5i64;
    f(&mut b);
    h(&mut a);
    println("{a} {b}");
}
