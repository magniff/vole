// (0.30.2, RT-46) A `*const [T]` made from a `&mut [T]`, and the write
// done through a `&mut` the callee makes from a raw pointer: the raw
// slice parameter p promises nothing, so its load after the call is a new
// load. reread's p and q are the same pointer; the callee writes through
// `&mut *q`. Also a `*mut str` parameter (its byte changed through a `&mut
// [u8]` made from a raw pointer to it). rustc (debug and -O): 2050, 98122;
// v0.30.1 -O1 and -O2: 2002, 98098.
// EXPECT: 2050
// EXPECT: 98122
// EXPECT: [1, 50, 3, 4] azc
#[inline(never)]
fn poke_slice(q: *mut [i64], v: i64) {
    // UNSAFE: a raw slice given by the caller made a `&mut`
    // SAFETY: it points to main's array, live across the call; nothing else uses it meanwhile
    let m: &mut [i64] = unsafe { &mut *q };
    m[1] = v;
}

#[inline(never)]
fn reread(p: *const [i64], q: *mut [i64]) -> i64 {
    // UNSAFE: raw slices given by the caller
    // SAFETY: both point to main's array, live across the call
    unsafe {
        let a = (*p)[1];
        poke_slice(q, 50);
        let b = (*p)[1];
        a * 1000 + b
    }
}

#[inline(never)]
fn poke_bytes(q: *mut u8, v: u8) {
    // UNSAFE: a raw pointer given by the caller made a `&mut`
    // SAFETY: it points into main's buffer, live across the call
    let m: &mut u8 = unsafe { &mut *q };
    *m = v;
}

#[inline(never)]
fn reread_str(p: *mut str, q: *mut u8) -> usize {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's buffer, live across the call
    unsafe {
        let a = (*p).as_bytes()[1] as usize;
        poke_bytes(q, b'z');
        let b = (*p).as_bytes()[1] as usize;
        a * 1000 + b
    }
}

fn main() -> i32 {
    let mut a = [1i64, 2, 3, 4];
    let r: &mut [i64] = &mut a;
    let p = r as *mut [i64];
    println("{}", reread(p as *const [i64], p));
    let mut buf = [b'a', b'b', b'c'];
    let base = buf.as_mut_ptr();
    // UNSAFE: a str over the buffer and a pointer to its second byte, both from base
    // SAFETY: the buffer is ASCII and outlives both; no reference to it is used meanwhile
    let (s, q) = unsafe {
        (std::str::from_utf8_unchecked(std::slice::from_raw_parts(base, 3)) as *const str
            as *mut str, base.add(1))
    };
    println("{}", reread_str(s, q));
    println("{:?} {}", a, std::str::from_utf8(&buf).unwrap());
    0
}
