// EDITION: rust
// A guarded index of an array in a tuple.
// FLAGS: -O2
// EXPECT: 0
static mut Z: i64 = 0;

fn main(gpa: Gpa) -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let mut t: i64 = 0;
    let mut k: i64 = 0;
    let p = ([1i64, 2, 3], 4);
    let i = -1099511627776 + unsafe { Z };
    while k < 5 + unsafe { Z } { if k > 100 { t += p.0[i as usize]; } k += 1; }
    println("{}", t);
    0
}
