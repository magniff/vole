// places IR, S12 (3.12): a later argument's ? drops the earlier temporaries on its return
// sem-own: `?` as a call argument: the earlier argument (an owned temporary) is dropped on the early return.
// EXPECT: drop 1
// EXPECT: r -1
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn eat
// PLACES: drop(_1) [kept]
// PLACES: fn two
// PLACES: drop(_1) [kept]
// PLACES: fn f
// PLACES: drop(_3) [removed]
// PLACES: drop(_3) [kept]
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn g(gpa: Gpa) -> Result<i64, i64> { Err(-1i64) }
fn two(a: D<Gpa>, n: i64) -> i64 { a.id + n }
fn f(gpa: Gpa) -> Result<i64, i64> { Ok(two(mk(1, gpa), g(gpa)?)) }

fn main(gpa: Gpa) {
    println("r {}", match f(gpa) { Ok(x) => x, Err(e) => e });
}
