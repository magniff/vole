// EDITION: rust
// RULE: F27.2
// (0.27.2) A struct pattern on a place moves only the fields it binds by
// value: another field stays usable, also borrowed across the move, and a
// `ref` binding borrows its field alone.
// EXPECT: 1 2 3
// EXPECT: 9 4
struct Tok {
    v: i64,
}

struct Two {
    a: Tok,
    b: Tok,
    n: i64,
}

fn main() {
    let s = Two { a: Tok { v: 1 }, b: Tok { v: 2 }, n: 3 };
    let r = &s.b;
    let Two { a, .. } = s;
    println("{} {} {}", a.v, r.v, s.n);
    let mut t = Two { a: Tok { v: 4 }, b: Tok { v: 5 }, n: 6 };
    let Two { ref a, .. } = t;
    t.n = 9;
    t.b = Tok { v: 7 };
    println("{} {}", t.n, a.v);
}
// (0.27.2) written against MVS std until it migrates to std2:
// ENV: VOLE_STD2=0
