// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::collections::hash_map HashMap::entry.
// EXPECT: [("a", 2), ("b", 1)]
use std::collections::{HashMap, hash_map};

fn main(gpa: Gpa) {
    let mut m: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    for w in ["a", "b", "a"] {
        *m.entry(w).or_insert(0) += 1;
    }
    let mut v: Vec<(&str, i64), Gpa> = Vec::new_in(gpa);
    for (k, x) in m.iter() {
        v.push((*k, *x));
    }
    v.sort();
    println("{:?}", v);
}
