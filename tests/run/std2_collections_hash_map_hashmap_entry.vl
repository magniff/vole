// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::collections::hash_map HashMap::entry.
// EXPECT: [("a", 2), ("b", 1)]
use std::collections::HashMap;

fn main(gpa: Gpa) {
    let mut m: HashMap<&str, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    for w in ["a", "b", "a"] {
        *m.entry(w).or_insert(0) += 1;
    }
    let mut v: Vec<(&str, i64), Gpa> = Vec::new_in(gpa);
    for (k, x) in m.iter() {
        v.push((*k, *x));
    }
    v.sort();
    println("{:?}", v);
}
