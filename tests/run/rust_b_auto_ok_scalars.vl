// EDITION: rust
// RULE: AT1
// (0.27.2) The scalars, `()`, tuples and arrays of them, fieldless enums
// and `fn` types are Send and Sync.
// EXPECT: 3 true 7 2
#[derive(Clone, Copy)]
enum Dir {
    Up,
    Down,
}

fn send<T: Send>(t: T) -> T {
    t
}

fn sync<T: Sync>(t: T) -> T {
    t
}

fn twice(x: i64) -> i64 {
    2 * x
}

fn main() {
    let a = send(3);
    let b = sync(true);
    let t = send((1, 'x', [2u8; 4], ()));
    let d = sync(Dir::Down);
    let f: fn(i64) -> i64 = twice;
    let g = sync(send(f));
    let n = match d {
        Dir::Up => 0,
        Dir::Down => t.2[0] as i64 + 5,
    };
    println("{} {} {} {}", a, b, n, g(1));
}
