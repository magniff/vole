use std::option::Option;

fn main() {
    let a: Option<i64> = Some(3);
    for x in &a {
        println("{}", x);
    }
    for x in a {
        println("{}", x);
    }
    let b: Option<i64> = None;
    let mut n = 0;
    for _ in b {
        n += 1;
    }
    println("{}", n);
}
