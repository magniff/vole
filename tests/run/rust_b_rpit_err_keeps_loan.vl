// EDITION: rust
// RUSTC-EDITION: 2024
// RULE: D21.3
// (0.27.2.1) The result captures every input lifetime: while it is live,
// the argument's loan is, so `v.push` conflicts (rustc E0502).
// ERROR: error[borrowck.conflict]
// ERROR: line 16, column 5
fn evens(v: &Vec<i32, Gpa>) -> impl Iterator<Item = &i32> {
    v.iter().filter(|x| **x % 2 == 0)
}

fn main(gpa: Gpa) {
    let mut v: Vec<i32, Gpa> = Vec::new_in(gpa);
    v.push(2);
    let it = evens(&v);
    v.push(6);
    for x in it {
        println("{}", *x);
    }
}
