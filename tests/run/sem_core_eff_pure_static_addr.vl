// Taking a static's address and reading it in unsafe code is still global.
// ERROR: 'read' is #[pure], but it touches a static mut or a C static (static)
static mut G: i64 = 1;

#[pure]
fn read() -> i64 { let p = unsafe { &mut (*(&raw mut G)) } as *mut i64; unsafe { *p } }

fn main() -> i32 {
    println("{}", read());
    0
}
