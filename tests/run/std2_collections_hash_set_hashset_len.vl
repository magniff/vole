// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::collections::hash_set HashSet::len.
// EXPECT: 0 2
use std::collections::HashSet;

fn main(gpa: Gpa) {
    let mut s: HashSet<i64, Gpa> = HashSet::new_in(gpa);
    let a = s.len();
    s.insert(1);
    s.insert(2);
    println("{} {}", a, s.len());
}
