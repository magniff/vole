// C's mem*/str* have no effects but read and write memory: calls are not
// removed or value-numbered across a store.
// EXPECT: 3 1 4 2 65 120
extern "C" {
    fn strlen(s: *mut u8) -> u64;
    fn memset(p: *mut u8, c: i32, n: u64) -> *mut u8;
    fn memcpy(d: *mut u8, s: *mut u8, n: u64) -> *mut u8;
}

fn main() -> i32 {
    let mut buf: [u8; 8] = [104, 105, 33, 0, 0, 0, 0, 0];
    let p = buf.as_mut_ptr() as *mut u8;
    let a = unsafe { strlen(p) };
    unsafe { (*p.add(1)) = 0; }
    let b = unsafe { strlen(p) };
    unsafe { memset(p, 120, 4); }
    let c = unsafe { strlen(p) };
    let mut src: [u8; 8] = [65, 66, 0, 0, 0, 0, 0, 0];
    unsafe { memcpy(p, src.as_mut_ptr() as *mut u8, 3); }
    let d = unsafe { strlen(p) };
    println("{a} {b} {c} {d} {} {}", buf[0], buf[3]);
    0
}
