// -O2: a counted store loop of 510 iterations into an inout struct's array ran past the array end
// (0.25.2): the vectorizer's cost model picked 3 vector bodies of 4 lanes, and the vector loop's
// trip count, rounded down to a multiple of 12 with a mask (510 & -12 = 500), was not one: the
// `!=` exit test was never met. The unroll factor is now a power of two (1, 2 or 4).
// See also opt_loop_trip_sweep_{len,types,steps}.vl.
// EXPECT: 32 true
struct O {
    cells: [u32; 510],
    shown: bool,
}

fn fill(o: inout O) {
    for i in 0..17 * 30 {
        o.cells[i] = 32;
    }
}

fn main() -> i32 {
    var o = O { cells: [7; 510], shown: true };
    fill(&o);
    println(f"{o.cells[509]} {o.shown}");
    0
}
