// RULE: F0.4, F8.2, F26.3
// A `&str` is Copy and clones by copying: `copied()` over `&&str` items,
// `Option<&&str>::copied`, `r.clone()` of a `&&str`, a `T: Clone` bound.
// `TryFrom::try_from(x)` takes Self from an expected `Result<Self, _>`, and
// `x.try_into()` against an expected `Result<U, _>` is `U::try_from(x)`.
// EXPECT: ab b Some("cd") ab ab true false
use std::convert::{TryFrom, TryInto};

struct Small {
    v: i64,
}

impl TryFrom<i64> for Small {
    type Error = ();

    fn try_from(v: i64) -> Result<Small, ()> {
        if v < 10 { Ok(Small { v: v }) } else { Err(()) }
    }
}

fn dup<T: Clone>(x: &T) -> T {
    x.clone()
}

fn main() {
    let parts = ["ab", "b"];
    let mut it = parts.iter().copied();
    let first: &str = it.next().unwrap();
    let s: &str = "cd";
    let r: Option<&&str> = Some(&s);
    let c: Option<&str> = r.copied();
    let q = &first;
    let a: Result<Small, ()> = TryFrom::try_from(3i64);
    let b: Result<Small, ()> = 30i64.try_into();
    println("{} {} {:?} {} {} {} {}", first, it.next().unwrap(), c, q.clone(), dup(&first),
        a.is_ok(), b.is_ok());
}
