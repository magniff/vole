// a sink closure owning an R, moved into another binding, then called through the old one: own.moved
// ERROR: error[borrowck.use_moved]
// RUSTC: accepts L7 whole-variable capture; Rust 2021 captures the disjoint field
struct R { id: i64 }
impl Drop for R { fn drop(&mut self) { println("drop {}", self.id); } }

fn main() {
    let a = R { id: 1 };
    let k = move || a.id;
    let k2 = k;
    println("{} {}", k(), k2());
}
