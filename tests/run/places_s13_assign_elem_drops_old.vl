// places IR, S13, S17: an assignment through an index drops the old element, kept as written
// sem-own: assigning an element of a Vec (`v[i] = x`) drops the old element.
// EXPECT: drop 1
// EXPECT: end
// EXPECT: drop 2
// PLACES: fn mk
// PLACES: drop(_3) [removed]
// PLACES: fn eat
// PLACES: drop(_1) [kept]
// PLACES: fn main
// PLACES: drop(_4) [removed]
// PLACES: drop(_7[_9]) [kept]
// PLACES: drop(_6) [removed]
// PLACES: drop(_2) [kept]
struct D { id: i64, v: Vec<i64> }
impl Drop for D { fn drop(inout self) { println(f"drop {self.id}"); } }
fn mk(id: i64, gpa: Gpa) -> D { var v: Vec<i64> = Vec::new_in(gpa); v.push(id); D { id: id, v: v } }
fn eat(d: sink D) { println(f"eat {d.id}"); }

fn main(gpa: Gpa) {
    var v: Vec<D> = Vec::new_in(gpa);
    v.push(mk(1, gpa));
    v[0] = mk(2, gpa);
    println("end");
}
