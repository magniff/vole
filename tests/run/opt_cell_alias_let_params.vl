// (0.26.1) Two let parameters of an owned type (references to the caller's
// place) alias one value, and a non-inlined writer changes it between two
// loads (the review's DropCell, its value now a cell: writing through
// `&self.v as *i64` without one is not allowed). -O2 keeps the second
// load: the type is not Freeze.
// FLAGS: -O2
// EXPECT: 5
use std::cell::Cell;

struct DropCell { v: Cell<i64> }

impl Drop for DropCell {
    fn drop(inout self) {}
}

impl DropCell {
    fn set(self, x: i64) { self.v.set(x); }
    fn get(self) -> i64 { self.v.get() }
}

#[inline(never)]
fn put(d: DropCell, x: i64) {
    d.set(x);
}

#[inline(never)]
fn twice(c: DropCell, d: DropCell) -> i64 {
    let a = c.get();
    put(d, 5);
    c.get() + a * 0
}

fn main() {
    let c = DropCell { v: Cell::new(1) };
    println("{}", twice(c, c));
}
