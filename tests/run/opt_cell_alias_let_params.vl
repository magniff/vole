// (0.26.1) Two let parameters of an owned type (references to the caller's
// place) alias one value, and a non-inlined writer changes it between two
// loads. At -O2 the second load is forwarded from the first today.
// XFAIL: WRONG -O2 keeps `c.get()` across `put(d, 5)` with c and d one value
// FLAGS: -O2
// EXPECT: 5
struct DropCell { v: i64 }

impl Drop for DropCell {
    fn drop(inout self) {}
}

impl DropCell {
    fn set(self, x: i64) {
        unsafe {
            let p = &self.v as *i64;
            *p = x;
        }
    }

    fn get(self) -> i64 {
        self.v
    }
}

#[inline(never)]
fn put(d: DropCell, x: i64) {
    d.set(x);
}

#[inline(never)]
fn twice(c: DropCell, d: DropCell) -> i64 {
    let a = c.get();
    put(d, 5);
    c.get() + a * 0
}

fn main() {
    let c = DropCell { v: 1 };
    println(f"{twice(c, c)}");
}
