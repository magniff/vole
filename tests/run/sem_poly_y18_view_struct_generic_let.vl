// ERROR: [own.conflict]: 'b.push_str(" world, a much longer text to force a reallocat
#[derive(Clone, Copy)] struct Tok<'a> { t: &'a str }

fn keep<T>(x: &T, gpa: Gpa) -> Vec<T, Gpa> {
    let mut r: Vec<T, Gpa> = Vec::new_in(gpa); r.push(x); r
}

fn main(gpa: Gpa) {
    let mut b = String::new_in(gpa);
    b.push_str("hello");
    let tk = Tok { t: b.as_str() };
    let ks = keep(&tk, gpa);
    b.push_str(" world, a much longer text to force a reallocation of the buffer's storage");
    println("{}", ks[0].t);
}
