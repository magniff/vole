// 0.26.2: a part's entry points are the fields of the blocks that include
// it, and not its own (embed.part_use): BLUR.main is K_BLUR_X.main or
// K_BLUR_Y.main.
// ERROR: error[embed.part_use]: 'BLUR' is a part
// ERROR: err_embed_part_use_entry.vl: line 27, column 13
// ERROR: help: the modules that include it: K_BLUR_X.main, K_BLUR_Y.main
embed wgsl COMMON {
    @group(0) @binding(0) var<storage, read_write> data: array<f32>;
}

embed wgsl BLUR with COMMON {
    @compute @workgroup_size(64)
    fn main(@builtin(global_invocation_id) id: vec3<u32>) {
        data[id.x] = f32(DIR.x);
    }
}

embed wgsl K_BLUR_X with BLUR {
    const DIR: vec2<i32> = vec2<i32>(1, 0);
}

embed wgsl K_BLUR_Y with BLUR {
    const DIR: vec2<i32> = vec2<i32>(0, 1);
}

fn main() -> i32 {
    println(BLUR.main);
    0
}
