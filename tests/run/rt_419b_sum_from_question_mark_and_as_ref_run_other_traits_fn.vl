// XFAIL: RT-419b: (R302I-2's mechanism, more of std) `iter.sum()` runs another trait's `sum` instead of Sum::sum, the `?` operator's error conversion and `From::from(4)` and `T::from(x)` (T: From<i64>) run another trait's `from`, and a generic `x.as_ref()` (T: AsRef<i64>) runs another trait's `as_ref` (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt). vole prints `sum -1 from
// -1 -1` and `asref -7 q Err(F { k: -1 })` at -O0 and -O2; v0.28.0 to
// v0.30.1 the same. The `?` in `q` converts the i64 error by (RT-155 is the `?` form:
// kept here beside the rest) OtherFrom::from, not by `impl From<i64> for F`. In each pair the other
// trait's impl is declared first (R302I-2: the first impl of the name wins).
// EXPECT: sum 5 from 4 4
// EXPECT: asref 11 q Err(F { k: 9 })
use std::iter::Sum;

trait OtherSum {
    fn sum<I: Iterator<Item = F>>(i: I) -> Self;
}

trait OtherFrom {
    fn from(x: i64) -> Self;
}

trait OtherAsRef {
    fn as_ref(&self) -> &i64;
}

#[derive(Clone, Copy, Debug)]
struct F {
    k: i64,
}

static BAD: i64 = -7;

impl OtherSum for F {
    fn sum<I: Iterator<Item = F>>(i: I) -> F {
        F { k: -1 }
    }
}

impl Sum for F {
    fn sum<I: Iterator<Item = F>>(i: I) -> F {
        let mut t = 0;
        for x in i {
            t += x.k;
        }
        F { k: t }
    }
}

impl OtherFrom for F {
    fn from(x: i64) -> F {
        F { k: -1 }
    }
}

impl From<i64> for F {
    fn from(x: i64) -> F {
        F { k: x }
    }
}

struct B {
    v: i64,
}

impl OtherAsRef for B {
    fn as_ref(&self) -> &i64 {
        &BAD
    }
}

impl AsRef<i64> for B {
    fn as_ref(&self) -> &i64 {
        &self.v
    }
}

fn gfrom<T: From<i64>>(x: i64) -> T {
    T::from(x)
}

fn gasref<T: AsRef<i64>>(x: &T) -> i64 {
    *x.as_ref()
}

fn q(x: i64) -> Result<i64, F> {
    let r: Result<i64, i64> = Err(x);
    let v = r?;
    Ok(v)
}

fn main(gpa: Gpa) {
    let mut v: Vec<F, Gpa> = Vec::new_in(gpa);
    v.push(F { k: 2 });
    v.push(F { k: 3 });
    let s: F = v.iter().copied().sum();
    let f2: F = From::from(4);
    let f3: F = gfrom(4);
    println("sum {} from {} {}", s.k, f2.k, f3.k);
    let b = B { v: 11 };
    println("asref {} q {:?}", gasref(&b), q(9));
}
