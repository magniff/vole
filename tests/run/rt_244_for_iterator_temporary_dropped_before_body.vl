// XFAIL: RT-244: a temporary of a for loop's iterator expression that the iterator does not borrow is dropped before the loop's body: `for k in mk(70).get() { .. }` prints `drop 70` before the body; rustc drops it after the loop (0.30.2)
// rustc prints the EXPECT lines (twin .rs.txt); the release build prints
// `drop 70`, `for 70`, `drop 71`, `for 71`, `drop 72`, `w 72`, `end`. A
// temporary the iterator borrows (`for x in mkh(gpa).items().iter()`) is
// kept to the loop's end (dl/f1.vl). R302E-12 (RT-235) is the match arm's
// order; here the loop is the home rustc gives the temporary (the `let`'s
// temporary, dropped at its `;`, is right in both).
// EXPECT: for 70
// EXPECT: drop 70
// EXPECT: for 71
// EXPECT: drop 71
// EXPECT: drop 72
// EXPECT: w 72
// EXPECT: end
struct D {
    n: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.n);
    }
}

impl D {
    fn get(&self) -> Option<i64> {
        Some(self.n)
    }
}

fn mk(n: i64) -> D {
    D { n: n }
}

fn main() {
    for k in mk(70).get() {
        println("for {}", k);
    }
    for k in mk(71).get().into_iter() {
        println("for {}", k);
    }
    let mut it = mk(72).get().into_iter();
    while let Some(w) = it.next() {
        println("w {}", w);
    }
    println("end");
}
