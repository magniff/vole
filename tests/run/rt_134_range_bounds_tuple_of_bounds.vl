// XFAIL: RT-134: (Bound<usize>, Bound<usize>) is not RangeBounds: a slice or Vec drain with it is refused (0.30.2)
// rustc implements RangeBounds<T> for (Bound<T>, Bound<T>). Found by the
// review of g302std; v0.30.1 too.
// EXPECT: [2, 3, 4]
// EXPECT: [1, 5]
use std::ops::Bound;

fn main() {
    let mut v = vec ![1usize, 2, 3, 4, 5];
    let d: Vec<usize> = v.drain((Bound::Excluded(0), Bound::Included(3))).collect();
    println("{:?}", d);
    println("{:?}", v);
}
