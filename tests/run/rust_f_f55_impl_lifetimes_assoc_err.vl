// RULE: F5.5
// (0.30.1) The impl's associated type is a borrow of its 'a; its method
// returns the trait's Self::Item with another lifetime, the method's own
// elided one of `&self`, which the trait does not say outlives 'a. rustc
// E0308.
// ERROR: trait.impl_lifetimes
// ERROR-COUNT: 1
trait First {
    type Item;
    fn first(&self) -> Self::Item;
}

struct S<'a> {
    v: &'a [i64],
}

impl<'a> First for S<'a> {
    type Item = &'a i64;

    fn first<'s>(&'s self) -> &'s i64 {
        &self.v[0]
    }
}

fn main() {
    let a = [1, 2];
    let s = S { v: &a };
    println("{}", s.first());
}
