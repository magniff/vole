// XFAIL: use.unused: a trait import the file calls a method of, through a blanket impl or a default method, is reported unused (front272)
// The std2 item(s): std::io BufReader::into_inner.
// EXPECT: [3]
use std::io::{BufRead, BufReader, ErrorKind, Read, Write};

fn main() {
    let data: &[u8] = &[1, 2, 3];
    let mut b = BufReader::new(data);
    let mut two = [0u8; 2];
    b.get_mut().read_exact(&mut two).unwrap();
    let r: &[u8] = b.into_inner();
    println("{:?}", r);
}
