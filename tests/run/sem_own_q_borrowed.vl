// XFAIL: gap 3: compile type error: no method 'cloned' on type 'Option<let T>'
// (0.25) `?` on a borrowed copy (`v.last()?`, `s.get(i)?`, HashMap::get, in a
// closure, an arm, a loop, an early return; a struct payload): the payload
// borrows, as with unwrap or match; the element is dropped once, by its Vec.
// EXPECT: last 1 1
// EXPECT: first 1 1
// EXPECT: get 1 1
// EXPECT: inline 1 1
// EXPECT: closure 1 1
// EXPECT: arm 1 1
// EXPECT: loop 2 1
// EXPECT: early 1 1
// EXPECT: none 0 1
// EXPECT: il 1 1
// EXPECT: struct 2 2
// EXPECT: map 3 3
// EXPECT: live 0
use std::hash::FixedState;
use std::alloc::Allocator; use std::collections::HashMap;
static mut LIVE: i64 = 0;
struct T { id: i64 }
fn mk(id: i64) -> T { unsafe { LIVE += 1; } T { id: id } }

impl Drop for T {
    fn drop(&mut self) { unsafe { LIVE -= 1; } }
}

struct P<A: Allocator> { a: T, b: Vec<i64, A> }

fn q_last(v: &Vec<T, Gpa>) -> Option<i64> { let t = v.last().cloned()?; Some(t.id) }

fn q_first(v: &Vec<T, Gpa>) -> Option<i64> {
    let s = v.as_slice(); let t = s.get(0usize).cloned()?; Some(t.id)
}

fn q_get(v: &Vec<T, Gpa>) -> Option<i64> { let t = v.as_slice().get(0usize).cloned()?; Some(t.id) }
fn q_inline(v: &Vec<T, Gpa>) -> Option<i64> { Some(v.last().cloned()?.id) }

fn q_closure(v: &Vec<T, Gpa>) -> i64 {
    let f = || -> Option<i64> { let t = v.last().cloned()?; Some(t.id) }; f().unwrap_or(0)
}

fn q_struct(v: &Vec<P<Gpa>, Gpa>) -> Option<i64> { let p = v.last().cloned()?; Some(p.a.id) }

fn q_arm(v: &Vec<T, Gpa>, k: i64) -> Option<i64> {
    match k { 0 => { let t = v.last().cloned()?; Some(t.id) }, _ => None }
}

fn q_loop(v: &Vec<T, Gpa>) -> Option<i64> {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i
        < 3 {
        i += 1; let t = v.as_slice().get(0usize).cloned()?; if t.id == 9 { continue; } s += t.id;
        if i == 2 { break; }
    }
    Some(s)
}

fn q_early(v: &Vec<T, Gpa>) -> Option<i64> {
    if v.len() > 0 { let t = v.last().cloned()?; return Some(t.id); } None
}

fn q_none(v: &Vec<T, Gpa>) -> Option<i64> { let t = v.as_slice().get(5usize).cloned()?; Some(t.id) }
fn il(v: &Vec<T, Gpa>) -> i64 { if let Some(t) = v.last().cloned() { t.id } else { 0 } }

fn q_map(m: &HashMap<i64, T, Gpa, FixedState>) -> Option<i64> {
    let t = m.get(&1).cloned()?; Some(t.id)
}

fn run(gpa: Gpa) {
    let mut v: Vec<T, Gpa> = Vec::new_in(gpa);
    v.push(mk(1));
    let live_now = unsafe { LIVE }; println("last {} {live_now}", q_last(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("first {} {live_now}", q_first(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("get {} {live_now}", q_get(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("inline {} {live_now}", q_inline(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("closure {} {live_now}", q_closure(&v));
    let live_now = unsafe { LIVE }; println("arm {} {live_now}", q_arm(&v, 0).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("loop {} {live_now}", q_loop(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("early {} {live_now}", q_early(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("none {} {live_now}", q_none(&v).unwrap_or(0));
    let live_now = unsafe { LIVE }; println("il {} {live_now}", il(&v));
    let mut w: Vec<P<Gpa>, Gpa> = Vec::new_in(gpa);
    w.push(P { a: mk(2), b: Vec::new_in(gpa) });
    let live_now = unsafe { LIVE }; println("struct {} {live_now}", q_struct(&w).unwrap_or(0));
    let mut m: HashMap<i64, T, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, mk(3));
    let live_now = unsafe { LIVE }; println("map {} {live_now}", q_map(&m).unwrap_or(0));
}

fn main(gpa: Gpa) -> i32 { run(gpa); let live_now = unsafe { LIVE }; println("live {live_now}"); 0 }
