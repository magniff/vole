// RULE: D2.6
// (0.27.1) Guards that read the scrutinee and its bindings.

fn main() {
    let o: Option<i64> = Some(3);
    match o {
        Some(y) if y > 5 => println("big {}", y),
        Some(y) if { o.is_some() && y > 1 } => println("mid {}", y),
        _ => println("other"),
    }
}
// EXPECT: mid 3
