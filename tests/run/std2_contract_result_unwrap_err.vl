// RULE: C1 (0.27.2.1, std2's clauses)
// The std2 item(s): Result::unwrap_err's `requires self.is_err()`, violated last.
// EXPECT: 1
// EXIT: 101
// STDERR: called `Result::unwrap_err()` on an `Ok` value

fn main() {
    let a: Result<i64, i64> = Result::Err(1);
    let b: Result<i64, i64> = Result::Ok(2);
    println("{}", a.unwrap_err());
    let x = b.unwrap_err();
}
