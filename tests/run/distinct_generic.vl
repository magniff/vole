// EDITION: rust
// XFAIL: gap 17: compile distinct.method: 'fmt' is a method of 'i64', not of 'NodeId'
// 0.18: an explicit impl of a trait replaces the one a distinct type takes
// from its underlying type; a generic distinct type (`Id<T>`) has generic
// impls (`impl<T> Id<T>`) and is inferred through generic functions;
// `as` converts a distinct type as its underlying type converts.
// EXPECT: n4 4
// EXPECT: 7 7 7
// EXPECT: 6
use std::fmt::Display; use std::fmt::Formatter as Fmt; type NodeId = distinct i64;
type Id<T> = distinct i64;
#[derive(Clone, Copy)] struct Node {}

impl Display for NodeId {
    fn fmt(&self, f: &mut Fmt<'_>) -> std::fmt::Result {
        f.write_str("n")?;
        write(f, "{}", self)?;
        Ok(()) }
}

impl<T> Id<T> {
    fn raw(self) -> i64 { self as i64 }
    fn make(v: i64) -> Id<T> { v as Id<T> }
}

fn first<T>(ids: &[Id<T>]) -> Id<T> { ids[0] }

fn main() {
    let a: NodeId = 4;
    println("{a} {a:?}");
    let i: Id<Node> = Id::make(7i64);
    let arr: [Id<Node>; 2] = [i, 9];
    println("{} {} {i}", i.raw(), first(&arr[..]).raw());
    let x = a as f64 * 1.5;
    println("{x}");
}
