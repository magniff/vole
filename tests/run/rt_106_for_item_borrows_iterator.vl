// XFAIL: RT-106: a for loop over an adapter of an adapter whose item holds a reference is refused: the item is taken to borrow the loop's iterator ('__for_it' does not live long enough) (0.30.2)
// rustc accepts every loop here. vole refuses the first: `for p in Wrap {
// it: w.iter().map(|x| Some(x)) }` with `e.push(p)` is `'__for_it' does
// not live long enough ... (mutably borrowed at 29:5)`: the item's region
// is tied to the `&mut` of next on the hidden iterator, not to w. The same
// loop over `Wrap { it: w.iter() }` (item `&i64`), and a `while let
// Some(p) = it.next()` over std's Skip, pass. Inside std the same error
// comes out of Vec::extend's loop (`<std>:5976:9`, not the program's
// line) for `w.iter().enumerate().skip(1).collect_in(gpa)` collected into
// `Vec<(usize, &i64), Gpa>`, and with take, zip and `map(|x| Some(x))`
// before skip. Since 0.28.0.
// EXPECT: [Some(3), Some(1), Some(4)] [3, 1, 4] [Some(1), Some(4)]
// EXPECT: [(1, 1), (2, 4)]
struct Wrap<I> {
    it: I,
}

impl<I: Iterator> Iterator for Wrap<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        self.it.next()
    }
}

fn main(gpa: Gpa) {
    let w = [3i64, 1, 4];
    let mut e: Vec<Option<&i64>, Gpa> = Vec::new_in(gpa);
    for p in (Wrap { it: w.iter().map(|x| Some(x)) }) {
        e.push(p);
    }
    let mut f: Vec<&i64, Gpa> = Vec::new_in(gpa);
    for p in (Wrap { it: w.iter() }) {
        f.push(p);
    }
    let mut g: Vec<Option<&i64>, Gpa> = Vec::new_in(gpa);
    let mut it = w.iter().map(|x| Some(x)).skip(1);
    while let Some(p) = it.next() {
        g.push(p);
    }
    println("{:?} {:?} {:?}", e, f, g);
    let h: Vec<(usize, &i64), Gpa> = w.iter().enumerate().skip(1).collect_in(gpa);
    println("{:?}", h);
}
