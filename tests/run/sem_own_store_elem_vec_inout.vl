// (0.25) A store to an element, or through inout, drops the value it replaces.
// FLAGS: --check-alloc
// EXPECT: 1
// EXPECT: live 0
fn put(v: &mut Vec<Vec<i64, Gpa>, Gpa>, gpa: Gpa) { v[0] = Vec::new_in(gpa); v[0].push(2); }

fn main(gpa: Gpa) {
    {
        let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
        let mut e: Vec<i64, Gpa> = Vec::new_in(gpa);
        e.push(1);
        v.push(e);
        put(&mut v, gpa); println("{}", v[0].len());
    }
    println("live {}", gpa.live_blocks() as i64);
}
