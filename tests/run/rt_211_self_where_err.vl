// RT-211, a `where` predicate on Self, `Self: Iterator<Item = (X, Y)>` of a
// default method (unzip_in's form): it ties X to the items. v0.30.1 refused
// the method's body (borrowck.outlives) and kept no borrow at the call;
// rustc builds the body and refuses the drop (E0505).
// ERROR: line 56
// ERROR-COUNT: 1
trait Put<T> {
    fn put1(&mut self, t: T);
}

impl<T> Put<T> for Vec<T, Gpa> {
    fn put1(&mut self, t: T) {
        self.push(t);
    }
}

struct Pairs<'a> {
    s: &'a [i64],
    i: usize,
}

impl<'a> Iterator for Pairs<'a> {
    type Item = (&'a i64, i64);

    fn next(&mut self) -> Option<(&'a i64, i64)> {
        if self.i >= self.s.len() {
            return None;
        }
        self.i += 1;
        Some((&self.s[self.i - 1], self.s[self.i - 1]))
    }
}

trait Split: Iterator {
    fn split2<X, Y, FX, FY>(self, mut a: FX, mut b: FY) -> (FX, FY)
        where
            FX: Put<X>,
            FY: Put<Y>,
            Self: Sized + Iterator<Item = (X, Y)>,
    {
        for (x, y) in self {
            a.put1(x);
            b.put1(y);
        }
        (a, b)
    }
}

impl<'a> Split for Pairs<'a> {}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let (a, b): (Vec<&i64, Gpa>, Vec<i64, Gpa>) =
        Pairs { s: v.as_slice(), i: 0 }.split2(Vec::new_in(gpa), Vec::new_in(gpa));
    drop(v);
    println("{:?} {:?}", a, b);
}
