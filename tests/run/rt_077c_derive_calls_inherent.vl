// XFAIL: RT-77: #[derive(Default)] and #[derive(PartialOrd)] call a field type's inherent default and partial_cmp, not its Default and PartialOrd impls (0.30.2)
// Rust's derived `default()` calls `Default::default()` for each field and
// the derived `partial_cmp` calls `PartialOrd::partial_cmp`; S's inherent
// methods of those names are never called. vole's derives build the calls by
// name, where the inherent method wins: `77 0`, `77`, `false`, `Some(Greater)`
// for rustc's lines below. (A derived Clone, Hash, Debug and Ord are right.)
// EXPECT: 1 0
// EXPECT: 1
// EXPECT: true
// EXPECT: Some(Less)
use std::cmp::Ordering;

#[derive(Clone, Copy, PartialEq)]
struct S {
    k: i64,
}

impl S {
    fn default() -> S {
        S { k: 77 }
    }

    fn partial_cmp(&self, other: &S) -> Option<Ordering> {
        Some(other.k.cmp(&self.k))
    }
}

impl Default for S {
    fn default() -> S {
        S { k: 1 }
    }
}

impl PartialOrd for S {
    fn partial_cmp(&self, other: &S) -> Option<Ordering> {
        Some(self.k.cmp(&other.k))
    }
}

#[derive(Default, Clone, Copy, PartialEq, PartialOrd)]
struct W {
    s: S,
    n: i64,
}

fn main() {
    let w: W = Default::default();
    println("{} {}", w.s.k, w.n);
    println("{}", W::default().s.k);
    let a = W { s: S { k: 1 }, n: 0 };
    let b = W { s: S { k: 2 }, n: 0 };
    println("{}", a < b);
    println("{:?}", a.partial_cmp(&b));
}
