// RULE: F8.1, D22.1
// `<T as A>::Out` and `<T as B>::Out` are two types in the generic body
// (rustc E0308), though S's are both i64. 0.30.1 read both as one.
// ERROR: error[type error]: expected '<T as B>::Out', got '<T as A>::Out'
trait A { type Out; fn get(&self) -> Self::Out; }
trait B { type Out; fn get(&self) -> Self::Out; }
struct S;
impl A for S { type Out = i64; fn get(&self) -> i64 { 7 } }
impl B for S { type Out = i64; fn get(&self) -> i64 { 8 } }
fn f<T: A + B>(x: <T as A>::Out) -> <T as B>::Out { x }
fn main() { println("{}", f::<S>(3)); }
