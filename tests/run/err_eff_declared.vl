use std::alloc::Layout; use std::ptr::NonNull; use std::alloc::AllocError;
use std::alloc::Allocator; extern "C" {
    fn putchar(c: i32) -> i32;
}

static mut SEEN: i64 = 0;

trait Key {
    #[pure]
    fn key(&self) -> u64;
}

#[derive(Clone, Copy)] struct K { v: i64 }

impl Key for K {
    fn key(&self) -> u64 {
        unsafe { SEEN += 1; }
        self.v as u64
    }
}

#[no_alloc]
fn total(v: &mut Vec<i64, Gpa>, x: i64) -> i64 {
    v.push(x);
    v.len() as i64
}

#[no_panic]
fn avg(s: &[i64], i: i64) -> i64 {
    s[i as usize]
}

#[pure]
fn counted(x: i64) -> i64 {
    note(x)
}

fn note(x: i64) -> i64 {
    unsafe { SEEN += x; }
    x
}

#[no_io]
fn chatty() {
    unsafe { putchar(33); }
}

#[effects(io)]
fn raw(p: *mut i64) -> i64 {
    unsafe { *(p as *mut i64) }
}

#[effects()]
fn wait(n: i64) -> i64 {
    let mut k = n;
    while k > 0 {
        k -= 1;
    }
    k
}

#[effects(panic)]
fn rec(n: i64) -> i64 {
    if n == 0 { 0 } else { rec(n - 1) }
}

#[effects(alloc(Gpa), panic, diverge)]
fn grow_in<A: Allocator>(v: &mut Vec<i64, A>) {
    v.push(1);
}

fn apply<F: Fn(i64) -> i64 + effects(panic)>(f: F, x: i64) -> i64 {
    f(x)
}

fn shout(x: i64) -> i64 {
    unsafe { putchar(33); }
    x
}

#[derive(Clone, Copy)] struct Bump { used: i64 }

// UNSAFE: a test's allocator (0.26.3: Allocator is an unsafe trait).
// SAFETY: it hands out no memory: try_alloc and try_resize are null.
unsafe impl Allocator for Bump {
    fn allocate(&self, __layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let size = __layout.size() as i64; let align = __layout.align() as i64; NonNull::new({
            0 as *mut u8
        }).ok_or(AllocError)
    }

    unsafe fn grow(&self, __p: NonNull<u8>, __old: Layout, __new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let p = __p.as_ptr(); let old_size = __old.size() as i64;
        let new_size = __new.size() as i64; let align = __new.align() as i64; NonNull::new({
            0 as *mut u8
        }).ok_or(AllocError)
    } unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> { unsafe { self.grow(p, old, new) } }

    unsafe fn deallocate(&self, __p: NonNull<u8>, __layout: Layout) {
        let p = __p.as_ptr(); let size = __layout.size() as i64;
        let align = __layout.align() as i64;
        putchar(33);
    }
}

fn main(gpa: Gpa) -> i32 {
    let k = K { v: 1 };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut w: Vec<i64, Bump> = Vec::new_in(Bump { used: 0 });
    grow_in(&mut v);
    grow_in(&mut w);
    let mut n = apply(|x| shout(x), 2i64);
    (total(&mut v, 1) + avg(&[1i64, 2][..], 0) + k.key() as i64 + n + counted(1) + raw(&mut n) + wait(2)
        + rec(2)) as i32
}
