// EDITION: rust
// XFAIL: gap 8: compile borrowck.borrow_immutable: cannot borrow '*f' as mutable, which is behind a `&` reference
// an FnMut called from a let parameter: the guide says call it from sink or var
// FLAGS: --check-alloc
// EXPECT: 2
fn run<F: FnMut()>(mut f: &F) { f(); f(); }

fn main() {
    let mut n: i64 = 0;
    run(|| { n += 1; });
    println("{n}");
}
