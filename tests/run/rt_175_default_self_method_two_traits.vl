// XFAIL: RT-175: `self.m()` in a default method of A, with S implementing A and B that both declare m, is refused with E0034; rustc picks A's (the bound of the default's Self) (0.30.2)
// From the g302qual review (form f90_method_call_bound).
// EXPECT: 11 2
trait A { fn m(&self) -> i64; fn d(&self) -> i64 { self.m() * 10 } }
trait B { fn m(&self) -> i64; }
struct S;
impl A for S { fn m(&self) -> i64 { 1 } }
impl B for S { fn m(&self) -> i64 { 2 } }
fn g<T: A>(t: &T) -> i64 { t.m() + t.d() }
fn h<T: B>(t: &T) -> i64 { t.m() }
fn main() { println("{} {}", g(&S), h(&S)); }
