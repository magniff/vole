// sem-own: `?` moving an owned error out: the error dropped once, by the caller.
// EXPECT: drop 1
// EXPECT: err 9
// EXPECT: drop 9
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(inout self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: sink D<Gpa>) { println("eat {}", d.id); }
fn g(gpa: Gpa) -> Result<i64, D<Gpa>> { Err(mk(9, gpa)) }

fn f(gpa: Gpa) -> Result<i64, D<Gpa>> {
    let a = mk(1, gpa);
    let n = g(gpa)?;
    Ok(n)
}

fn main(gpa: Gpa) {
    match f(gpa) { Ok(x) => println("ok {x}"), Err(e) => println("err {}", e.id) }
}
