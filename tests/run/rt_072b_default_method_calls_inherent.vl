// XFAIL: RT-72: a trait's default method calls the implementing type's inherent method of the same name instead of the trait's (0.30.2)
// `self.area()` in Shape::describe means Shape::area (Self: Shape);
// vole calls Sq's inherent area. rustc prints 1009, vole 1900.
// EXPECT: 1009
trait Shape {
    fn area(&self) -> i64;

    fn describe(&self) -> i64 {
        self.area() + 1000
    }
}

struct Sq {
    s: i64,
}

impl Sq {
    // a helper of the same name, in another unit
    fn area(&self) -> i64 {
        self.s * self.s * 100
    }
}

impl Shape for Sq {
    fn area(&self) -> i64 {
        self.s * self.s
    }
}

fn main() -> i32 {
    let q = Sq { s: 3 };
    println("{}", q.describe());
    0
}
