// RULE: D5.3
// (0.27.2) A type parameter used only through a projection, `U::Out`, is
// used: not borrowck.unused_param, and invariant there, as rustc reads
// it (std2's FlatMap<I, U, F> holds `Option<U::IntoIter>`).
trait Source {
    type Out;
    fn make(&self) -> Self::Out;
}

struct Num {
    v: i64,
}

impl Source for Num {
    type Out = i64;

    fn make(&self) -> i64 {
        self.v
    }
}

struct Held<U: Source> {
    front: Option<U::Out>,
}

fn main() {
    let n = Num { v: 5 };
    let h: Held<Num> = Held { front: Some(n.make()) };
    match h.front {
        Some(x) => println("{}", x),
        None => println("none"),
    }
}
// EXPECT: 5
