// (0.26.3, decision 6) `a << b` of u32s panics at -O2 with --overflow-
// checks=on, with Rust's message at the expression.
// FLAGS: -O2 --overflow-checks=on
// EXIT: 101
// EXPECT: before
// STDERR: ovf_on_o2_shl_u32.vl:17:13: attempt to shift left with overflow

#[inline(never)]
fn idu(x: u64) -> u64 {
    x
}

fn main() {
    let a: u32 = idu(1) as u32;
    let b: u32 = idu(32) as u32;
    println("before");
    let r = a << b;
    println("after {}", r);
}
