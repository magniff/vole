// Runs on std since 0.27.2's switch.
// The std item(s): std::convert TryFrom::Error.
// EXPECT: 5
use std::convert::{Infallible, TryFrom};

struct Even {
    v: i64,
}

impl TryFrom<i64> for Even {
    type Error = i64;

    fn try_from(v: i64) -> Result<Even, i64> {
        if v % 2 == 0 { Ok(Even { v: v }) } else { Err(v) }
    }
}

fn odd_part<T: TryFrom<i64, Error = i64>>(v: i64) -> i64 {
    match T::try_from(v) {
        Ok(_) => 0,
        Err(e) => e,
    }
}

fn main() {
    println("{}", odd_part::<Even>(5));
}
