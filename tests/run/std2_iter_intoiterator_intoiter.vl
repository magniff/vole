// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter IntoIterator::IntoIter.
// EXPECT: Some(1)
use std::iter::FusedIterator;

fn first<C: IntoIterator>(c: C) -> Option<C::Item> {
    let mut it: C::IntoIter = c.into_iter();
    it.next()
}

fn main(gpa: Gpa) {
    println("{:?}", first(Vec::from_in([1i64, 2], gpa)));
}
