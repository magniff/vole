// 0.26.2: a plain literal at a format position is a format literal (Rust's
// std::fmt): `{x}` is the local's value, `{{` and `}}` are braces. Until
// 0.26.1 this file's literals printed their braces with warning[format];
// `volec fix --only fstring` doubles the braces of such a literal, and
// these are the literals it writes. A literal that is not at a format
// position (a variable printed, `println(s)`) is text, braces and all.
// EXPECT: x = 5
// EXPECT: {y}    5 }
// EXPECT: {y} {x} {z}
// EXPECT: x = {x}
// EXPECT: {}
fn main() {
    let x = 5;
    println("x = {x}");
    print("{{y}} {x:>4} }}\n");
    println("{{y}} {{x}} {{z}}");
    let s = "x = {x}";
    println(s);
    let t: [u8] = "{}";
    println(t);
}
