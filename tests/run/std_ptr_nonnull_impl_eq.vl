// Runs on std since 0.27.2's switch.
// The std item(s): std::ptr NonNull::impl Eq.
// EXPECT: true
use std::ptr::NonNull;

fn same<T: Eq>(a: &T, b: &T) -> bool {
    a == b
}

fn main() {
    let mut x = 1i64;
    let p = NonNull::new(&mut x as *mut i64).unwrap();
    println("{}", same(&p, &p.clone()));
}
