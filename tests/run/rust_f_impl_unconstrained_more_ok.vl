// (0.30.1, review 4) What constrains an impl's parameter, as rustc: the
// self type (a lifetime too, `&'a [T]`, `&'a str`, `S<'a>`), the trait's
// arguments, an associated-type constraint of a bound of a constrained
// parameter (`I: Iterator<Item = T>`), an `Fn*` bound's result (`F:
// FnMut() -> Option<T>`); and a lifetime no associated type uses may be
// free. (The impl for `&'a [T]` is std's form, `IntoIterator for &'a
// [T]`: checked here as declared.)
// EXPECT: 6 3 2 1
trait Tr<T> {
    type Out;
    fn tget(&self) -> i64;
}

trait Plain {
    fn tget(&self) -> i64;
}

struct S<'a> {
    r: &'a str,
}

struct M<I> {
    i: I,
}

struct G<F> {
    f: F,
}

impl<'a, T> Tr<T> for &'a [T] {
    type Out = &'a T;

    fn tget(&self) -> i64 {
        self.len() as i64
    }
}

impl<'a> Tr<i64> for S<'a> {
    type Out = &'a str;

    fn tget(&self) -> i64 {
        self.r.len() as i64
    }
}

impl<T, I: Iterator<Item = T>> Tr<i32> for M<I> {
    type Out = T;

    fn tget(&self) -> i64 {
        2
    }
}

impl<T, F: Fn() -> Option<T>> Tr<u8> for G<F> {
    type Out = T;

    fn tget(&self) -> i64 {
        1
    }
}

impl<'a> Plain for i64 {
    fn tget(&self) -> i64 {
        *self
    }
}

fn main(gpa: Gpa) {
    let mut v = Vec::new_in(gpa);
    for k in 0..6i64 {
        v.push(k);
    }
    let a: &[i64] = v.as_slice();
    let s = S { r: "abc" };
    let m = M { i: v.iter() };
    let g = G { f: || Some(1i64) };
    println("{} {} {} {}", a.len(), s.tget(), m.tget(), g.tget());
}
