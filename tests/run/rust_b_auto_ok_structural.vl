// EDITION: rust
// RULE: AT1
// (0.27.2) A struct or enum without a vouch is Send (Sync) when every part
// is, with its type arguments substituted; a type recursive through a
// reference holds as rustc's auto traits do (coinductively).
// EXPECT: 3 4 1
struct Pair<T> {
    a: T,
    b: i64,
}

enum List<'a> {
    Nil,
    Cons(i64, &'a List<'a>),
}

struct View<'a> {
    p: &'a Pair<i64>,
}

fn send<T: Send>(t: T) -> T {
    t
}

fn sync<T: Sync>(t: T) -> T {
    t
}

fn main() {
    let p = sync(send(Pair { a: 1i64, b: 2 }));
    let v = send(View { p: &p });
    let nil = List::Nil;
    let l = sync(send(List::Cons(1, &nil)));
    let head = match l {
        List::Cons(h, _) => h,
        List::Nil => 0,
    };
    println("{} {} {}", v.p.a + v.p.b, p.b + 2, head);
}
