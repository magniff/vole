// RULE: D2.9
// (0.30.1) The names a format string captures are borrowed after the
// explicit arguments are evaluated, as rustc's format_args: `{s}` after
// `drop(s)` is a use of the moved s (rustc E0382, vole's use_moved), at
// the hole. Before, the hole was a copy taken first and printed the
// freed block.
// ERROR: error[borrowck.use_moved]
// ERROR: line 12, column 15
// ERROR-COUNT: 1
fn main(gpa: Gpa) {
    let s = format_in("abcdefghijklmnopqrstuvwxyz {}", 1, gpa);
    println("{s} {:?}", drop(s));
}
