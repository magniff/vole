// The std item(s): std::fmath f64::sin; f64::cos; f64::tan; f64::sin_cos; f64::asin; f64::acos; f64::atan; f64::atan2; f64::exp; f64::exp2; f64::ln; f64::log2; f64::log10; f64::log.
// EXPECT: 0.841470984808 0.540302305868 1.557407724655 0.479425538604 0.877582561890
// EXPECT: 0.523598775598 1.047197551197 0.785398163397 -2.356194490192
// EXPECT: 2.718281828459 1024 2.302585092994 3 3
// EXPECT: 4.191806548579 -inf true
// EXPECT: -0.852200849767 -0.575386111958
// (12 digits: the algorithms are fdlibm's, within an ulp or two of the
// system's libm that Rust calls)
fn main() {
    let (s, c) = 0.5f64.sin_cos();
    println("{:.12} {:.12} {:.12} {:.12} {:.12}", 1.0f64.sin(), 1.0f64.cos(), 1.0f64.tan(), s, c);
    println("{:.12} {:.12} {:.12} {:.12}", 0.5f64.asin(), 0.5f64.acos(), 1.0f64.atan(),
        (-1.0f64).atan2(-1.0));
    println("{:.12} {} {:.12} {} {}", 1.0f64.exp(), 10.0f64.exp2(), 10.0f64.ln(), 8.0f64.log2(),
        1000.0f64.log10());
    println("{:.12} {} {}", 100.0f64.log(3.0), 0.0f64.ln(), (-1.0f64).ln().is_nan());
    println("{:.12} {:.12}", 1e22f64.sin(), 1e300f64.cos());
}
