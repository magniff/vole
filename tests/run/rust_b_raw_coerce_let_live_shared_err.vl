// EDITION: rust
// RULE: D3.6
// (0.27.7) A `&mut` given to a `let` written `*mut T` is reborrowed raw,
// a write of what it points to: a shared borrow of it used after the
// `let` is a conflict (rustc E0502). 0.27.6 copied the `&mut` and
// accepted the program.
// ERROR: error[borrowck.conflict]: cannot borrow '*x' as mutable because it is also borrowed as immutable
// ERROR: line 12, column 23
// ERROR-COUNT: 1
fn f(x: &mut i64) -> i64 {
    let r = &*x;
    let p: *mut i64 = x;
    let _ = p;
    *r
}

fn main() {
    let mut v = 1i64;
    println("{}", f(&mut v));
}
