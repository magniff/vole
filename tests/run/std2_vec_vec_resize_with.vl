// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::vec Vec::resize_with.
// EXPECT: [1, 2, 3, 4] [1]
use std::vec::Vec;

fn main(gpa: Gpa) {
    let mut v = Vec::from_in([1], gpa);
    let mut n = 1;
    v.resize_with(4, || {
        n += 1;
        n
    });
    let a = v.clone();
    v.resize_with(1, || 0);
    println("{:?} {:?}", a, v);
}
