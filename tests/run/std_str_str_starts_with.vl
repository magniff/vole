// Runs on std since 0.27.2's switch.
// The std item(s): std::str str::starts_with.
// EXPECT: true true false true
use std::str::CharIndices;

fn main() {
    println("{} {} {} {}", "bananas".starts_with("ban"), "bananas".starts_with('b'),
        "bananas".starts_with("nan"), "abc".starts_with(""));
}
