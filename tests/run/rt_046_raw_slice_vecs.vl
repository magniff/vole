// (0.30.2, RT-46) A raw slice of Vecs: the Vec's header (its length) read
// through the raw slice before and after a call that pushes to that Vec
// through another raw pointer. A raw pointer promises nothing, so the
// length after the call is loaded again. rustc (debug and -O): 1002;
// v0.30.1 -O1 and -O2: 1001.
// EXPECT: 1002
// EXPECT: [1, 2]
#[inline(never)]
fn push(q: *mut Vec<i64, Gpa>, x: i64) {
    // UNSAFE: a raw pointer given by the caller made a `&mut`
    // SAFETY: it points to main's Vec, live across the call; nothing else uses it meanwhile
    let v: &mut Vec<i64, Gpa> = unsafe { &mut *q };
    v.push(x);
}

#[inline(never)]
fn lens(p: *const [Vec<i64, Gpa>], q: *mut Vec<i64, Gpa>) -> usize {
    // UNSAFE: raw pointers given by the caller
    // SAFETY: both point into main's array of Vecs, live across the call
    unsafe {
        let a = (*p)[0].len();
        push(q, 2);
        let b = (*p)[0].len();
        a * 1000 + b
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    let mut vs = [v];
    let base = vs.as_mut_ptr();
    // UNSAFE: a raw slice over vs, and its first element's pointer, both from base
    // SAFETY: vs has 1 element and outlives both pointers; no reference to it is used meanwhile
    let p = unsafe { std::slice::from_raw_parts(base, 1) as *const [Vec<i64, Gpa>] };
    println("{}", lens(p, base));
    println("{:?}", vs[0]);
    0
}
