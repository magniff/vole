// XFAIL: RT-C301-11: a trait's `where Self: 'static` does not give a bound's Omega 'static, as rustc's implied supertrait does (0.30.2)
// From the review: trait St where Self: 'static (rustc: implied as a supertrait)
// rustc accepts and prints 1.
// EXPECT: 1
fn need<T: 'static>(t: T) -> i64 { 1 }
trait St where Self: 'static {}
fn f<T: St>(t: T) -> i64 { need(t) }
impl St for i64 {}
fn main() { println("{}", f(1i64)); }
