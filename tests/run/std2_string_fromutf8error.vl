// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::string FromUtf8Error.
// EXPECT: 1 [104, 255]
use std::string::ToStringIn;

fn main(gpa: Gpa) {
    let r = String::from_utf8(Vec::from_in([104u8, 255], gpa));
    match r {
        Ok(_) => println("ok"),
        Err(e) => println("{} {:?}", e.utf8_error().valid_up_to(), e.as_bytes()),
    }
}
