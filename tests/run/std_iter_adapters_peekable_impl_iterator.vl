// Runs on std since its gap closed (0.27.2.1).
// The std item(s): std::iter::adapters Peekable::impl Iterator.
// EXPECT: [1, 2] 0

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2], gpa);
    let mut it = s.iter().copied().peekable();
    let _ = it.peek();
    let v: Vec<i64, Gpa> = it.by_ref().collect_in(gpa);
    println("{:?} {}", v, it.count());
}
