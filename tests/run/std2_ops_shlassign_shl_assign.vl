// EDITION: rust
// Runs on std2 since 0.27.2's switch.
// The std2 item(s): std::ops ShlAssign::shl_assign.
// EXPECT: V { x: 48 } 48
use std::ops::ShlAssign;

#[derive(Debug, Clone, Copy, PartialEq)]
struct V {
    x: i64,
}

impl ShlAssign for V {
    fn shl_assign(&mut self, rhs: V) {
        self.x <<= rhs.x;
    }
}

fn main() {
    let mut a = V { x: 12 };
    a.shl_assign(V { x: 2 });
    let mut n = 12i64;
    n.shl_assign(2);
    println("{:?} {}", a, n);
}
