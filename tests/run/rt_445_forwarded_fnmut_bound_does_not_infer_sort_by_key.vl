// XFAIL: RT-445: a generic fn forwarding its `F: FnMut(&i64) -> K` to Vec::sort_by_key gives type.infer, "cannot infer type parameter 'K' of 'Vec::sort_by_key'"; rustc infers K from F's bound and prints 1 (v0.30.1 too) (0.30.2)
// EXPECT: 1
static SEVEN: i64 = 7;

fn sk(_x: &i64) -> &'static i64 {
    &SEVEN
}

fn mys<K: Ord, F: FnMut(&i64) -> K>(u: &mut Vec<i64, Gpa>, f: F) {
    u.sort_by_key(f)
}

fn main(gpa: Gpa) {
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    u.push(3);
    mys(&mut u, sk);
    println("{}", u.len());
}
