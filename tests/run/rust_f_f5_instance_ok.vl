// RULE: F5.1
// An inherent impl on an instance, `impl<'a, T: Copy> Holder<&'a T>`:
// its method exists on `Holder<&i64>`.
// EXPECT: 5
struct Holder<V> {
    v: V,
}

impl<'a, T: Copy> Holder<&'a T> {
    fn get(&self) -> T {
        *self.v
    }
}

fn main() {
    let n = 5;
    let h = Holder { v: &n };
    println("{}", h.get());
}
