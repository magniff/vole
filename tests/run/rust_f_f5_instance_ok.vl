// EDITION: rust
// RULE: F5.1
// An inherent impl on an instance, `impl<'a, T: Copy> Holder<&'a T>`:
// its method exists on `Holder<&i64>`.
// EXPECT: 5
struct Holder<V> {
    v: V,
}

impl<'a, T: Copy> Holder<&'a T> {
    fn get(&self) -> T {
        *self.v
    }
}

fn main() -> i64 {
    let n = 5;
    let h = Holder { v: &n };
    std::print_int(h.get());
    println("");
    0
}
