// RULE: F18.5
// (0.30.2) `a.into()` with its target free, later i64, of an a later
// u64: rustc's E0277 (an earlier 0.30.2 build printed -1).
// ERROR: the trait 'From<u64>' is not implemented for 'i64' (rustc E0277)
fn main() {
    let a = 18446744073709551615;
    let r = a.into();
    let s: i64 = r;
    let c: u64 = a;
    println("{} {}", s, c);
}
