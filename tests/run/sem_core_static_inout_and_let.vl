// EDITION: rust
// an inout and a let access of one static: f(&G, G) overlaps.
// FLAGS: -O2
// EXPECT: 1
#[derive(Clone, Copy)] struct Big { a: i64, b: i64, c: i64, d: i64 }

static mut G: Big = Big { a: 1, b: 2, c: 3, d: 4 };

#[inline(never)]
fn f(x: &mut Big, y: Big) -> i64 { x.a = 10; y.a }

fn main() -> i32 { println("{}", f(unsafe { &mut (*(&raw mut G)) }, unsafe { G })); 0 }
