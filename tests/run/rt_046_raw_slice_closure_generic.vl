// (0.30.2, RT-46) A raw slice reaching a function as a closure's
// parameter, as a closure's capture, and as a generic `T` (a trait method
// of `*const [i64]` called through `T`): each is a raw pointer, so a load
// through it is not kept across a call that writes the memory through
// another raw pointer. rustc (debug and -O): 2050 three times; v0.30.1 -O1
// and -O2 print 2002 for the closure's parameter and the generic.
// EXPECT: 2050
// EXPECT: 2050
// EXPECT: 2050
// EXPECT: [1, 50, 3, 4]
#[inline(never)]
fn poke(q: *mut i64, v: i64) {
    // UNSAFE: a raw pointer given by the caller
    // SAFETY: it points into main's array, which lives across the call
    unsafe {
        *q = v;
    }
}

trait At {
    fn at(self, i: usize) -> i64;
}

impl At for *const [i64] {
    fn at(self, i: usize) -> i64 {
        // UNSAFE: the raw slice is the caller's
        // SAFETY: main's array, live across the call
        unsafe { (*self)[i] }
    }
}

#[inline(never)]
fn generic<T: At + Copy>(p: T, q: *mut i64) -> i64 {
    let a = p.at(1);
    poke(q, 50);
    let b = p.at(1);
    a * 1000 + b
}

#[inline(never)]
fn reset(q: *mut i64) {
    poke(q, 2);
}

fn main() -> i32 {
    let mut a = [1i64, 2, 3, 4];
    let base = a.as_mut_ptr();
    // UNSAFE: the raw slice and the element pointer are both made from base
    // SAFETY: a has 4 elements and outlives both pointers; no reference to a
    // is used while they are
    let (p, q) = unsafe {
        (std::slice::from_raw_parts(base, 4) as *const [i64], base.add(1))
    };
    let param = |p: *const [i64], q: *mut i64| -> i64 {
        // UNSAFE: raw pointers given by the caller
        // SAFETY: both point into main's array, live across the call
        unsafe {
            let a = (*p)[1];
            poke(q, 50);
            let b = (*p)[1];
            a * 1000 + b
        }
    };
    println("{}", param(p, q));
    reset(q);
    let capture = move || -> i64 {
        // UNSAFE: the captured raw pointers point into main's array
        // SAFETY: main's array lives across the call
        unsafe {
            let a = (*p)[1];
            poke(q, 50);
            let b = (*p)[1];
            a * 1000 + b
        }
    };
    println("{}", capture());
    reset(q);
    println("{}", generic(p, q));
    println("{:?}", a);
    0
}
