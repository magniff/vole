// RULE: D2.9
// (0.30.1) A format argument naming a place is a shared borrow of it held
// to the end of the call, as rustc's format_args takes `&arg`: a Copy
// place too, so the later argument's `x += 1` is E0506 (vole's
// assign_borrowed) at the write, the loan the hole's.
// ERROR: error[borrowck.assign_borrowed]
// ERROR: line 12, column 9
// ERROR-COUNT: 1
fn main() {
    let mut x = 1;
    println("{} {}", x, {
        x += 1;
        x
    });
}
