// sem-own: a sink parameter is dropped at the function end, after the locals.
// EXPECT: body
// EXPECT: drop 3
// EXPECT: drop 2
// EXPECT: drop 1
// EXPECT: end
use std::alloc::Allocator; struct D<A: Allocator> { id: i64, v: Vec<i64, A> }
impl Drop for D<Gpa> { fn drop(&mut self) { println("drop {}", self.id); } }

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(id); D { id: id, v: v }
}

fn eat(d: D<Gpa>) { println("eat {}", d.id); }
fn f(a: D<Gpa>, b: D<Gpa>, gpa: Gpa) { let c = mk(3, gpa); println("body"); }

fn main(gpa: Gpa) {
    f(mk(1, gpa), mk(2, gpa), gpa);
    println("end");
}
