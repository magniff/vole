// XFAIL: gap 17: compile trait.unmet: 'Ord' requires 'Q: PartialOrd<Self>', which is not implemented
// (0.17, T7) std's Eq, Ord and Hash take `&Self` (eq_of, cmp_of, hash_of
// `&T`): `a.cmp(&a)`, `a == a` through one reference, a value compared
// with itself while borrowed. Derived impls take `&Self`; a hand-written
// impl with the legacy `*Self` is taken as the trait's `&Self`.
use std::alloc::Allocator; use std::hash::Hash;
#[derive(PartialEq, Eq, Clone)]
struct P<A: Allocator> { name: Vec<i64, A>, n: i64 }
#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Clone, Copy)]
struct R { a: i64, b: i64 }
#[derive(Clone, Copy)] struct Q { v: i64 }
impl std::cmp::PartialEq for Q { fn eq(&self, other: &Q) -> bool { self.v == other.v } }
impl std::cmp::Ord for Q { fn cmp(&self, other: &Q) -> i64 { self.v - other.v } }
fn same(a: R) -> bool { a.cmp(a) == 0 && a == a }

fn main(gpa: Gpa) -> i32 {
    let mut a = P { name: Vec::new_in(gpa), n: 1 };
    a.name.push(4);
    let b = a.clone();
    let e = a == b && a == a && a == b;
    let r = R { a: 1, b: 2 };
    let s = R { a: 1, b: 3 };
    let c = r.cmp(r) + r.cmp(&s) as i64 + s.cmp(r);
    let q = Q { v: 2 };
    let t = Q { v: 3 };
    println("{e} {c} {} {} {} {}", same(r), q == q, q < t,
        FixedState::new().hash_one(&r) == FixedState::new().hash_one(&r));
    0
}
// FLAGS: --check-alloc
// EXPECT: true 0 true true true true
