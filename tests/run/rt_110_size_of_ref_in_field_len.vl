// XFAIL: RT-110: `size_of::<&B>()` in a struct field's array length is refused with E0106 "missing lifetime specifier"; rustc builds it (0.30.2)
// EXPECT: 8
use std::mem::size_of;

struct B {
    k: i64,
}

struct S {
    b: [u8; size_of::<&B>()],
}

fn main() {
    let s = S { b: [0; 8] };
    let b = B { k: 0 };
    println("{}", s.b.len() + b.k as usize);
}
