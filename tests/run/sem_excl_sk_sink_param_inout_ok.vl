// EDITION: rust
// a sink parameter is the callee's own: it may be lent inout
// EXPECT: 3
fn grow(v: &mut Vec<i64, Gpa>) { v.push(1); }
fn f(mut v: Vec<i64, Gpa>) -> i64 { grow(&mut v); grow(&mut v); v.len() as i64 }
fn main(gpa: Gpa) { let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(0); println("{}", f(v)); }
