// RT-38 (F2, F6): a contract never changes what the program does: its
// clauses read through views and write nothing they did not make, so
// with --debug-contracts on and off (rt_038_debug_contracts_on.vl and
// _off.vl) the output is the same, rustc's for the body alone. Before,
// the ensures on `first`, whose `result` borrows from v, was
// borrowck.conflict at 1:1: the wrapper's `let v = &*v;` view was made
// for a clause that never reads v.
// FLAGS: --debug-contracts --check-alloc
// EXPECT: drop 3
// EXPECT: 3
// EXPECT: -1
// EXPECT: 1
// EXPECT: 2
// EXPECT: 15
// EXPECT: drop 15
// EXPECT: drop 6
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take_opt(o: Option<D>) -> i64
    debug ensures old(o.is_some()) == (result >= 0)
    debug ensures result == old(match &o {
        Some(d) => d.v,
        None => -1,
    })
    {
    match o {
        Some(d) => d.v,
        None => -1,
    }
}

fn grow(v: &mut Vec<D, Gpa>, n: i64) -> usize
    debug requires n > 0
    debug ensures v.len() == old(v.len()) + 1
    debug ensures result == v.len()
{
    v.push(D { v: n });
    v.len()
}

fn first<'a>(v: &'a mut Vec<D, Gpa>) -> &'a mut D
    debug ensures result.v > 0
{
    &mut v[0]
}

fn main(gpa: Gpa) {
    println("{}", take_opt(Some(D { v: 3 })));
    println("{}", take_opt(None));
    let mut v: Vec<D, Gpa> = Vec::new_in(gpa);
    println("{}", grow(&mut v, 5));
    println("{}", grow(&mut v, 6));
    first(&mut v).v += 10;
    println("{}", v[0].v);
}
