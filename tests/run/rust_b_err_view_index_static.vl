// RULE: D1.4
// (0.27.1) `&s[0]` of a view returned as `&'static`: the view's region
// supports the loan and does not outlive `'static`.
// ERROR: error[borrowck.outlives]
// ERROR: line 10, column 5
// ERROR-COUNT: 1
// Checked since bc271 M3.

fn first(s: &[i64]) -> &'static i64 {
    &s[0]
}

fn main() {
    let a = [5i64, 6];
    println("{}", *first(&a[..]));
}
