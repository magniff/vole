use crate::a::Flags;
use crate::a::take as taken;
use crate::a::Flags::B as TWO;

pub fn run() {
    let v1 = crate::a::take(Flags::A);
    let v2 = crate::a::below(Flags::A);
    let v3 = crate::a::grows(TWO);
    let v4 = crate::a::stepped(Flags::A) - 1;
    let v5 = crate::a::stepped(Flags::B, Flags::B + 1) + 3;
    let v6 = crate::a::generic(Flags::B, true) + 1;
    let c = crate::a::Counter::make(Flags::B);
    let v7 = c.add(Flags::B) + 3;
    let v8 = taken(Flags::A) + 7;
    println(f"{v1} {v2} {v3} {v4} {v5} {v6} {v7} {v8}");
}
