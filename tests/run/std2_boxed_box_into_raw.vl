// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::boxed Box::into_raw.
// EXPECT: 10
use std::boxed::Box;

fn main(gpa: Gpa) {
    let p: *mut i64 = Box::into_raw(Box::new_in(9i64, gpa));
    let b = unsafe {
        *p += 1;
        Box::from_raw_in(p, gpa)
    };
    println("{}", b);
}
