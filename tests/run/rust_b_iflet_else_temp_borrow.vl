// (0.29.0) A borrow held by a temporary of an `if let` scrutinee (a guard
// with a destructor) ends before the `else` block: the else block, and
// the next `else if let`, use what it borrowed. rustc accepts this from
// its 2024 edition (2021: E0503, E0499, E0506, the guard is dropped after
// the else block), and the let-else in every edition.
// RUSTC-EDITION: 2024
// EXPECT: unlock 1
// EXPECT: else 11
// EXPECT: over 11
// EXPECT: unlock 12
// EXPECT: unlock 13
// EXPECT: unlock 14
// EXPECT: unlock 1
// EXPECT: unlock 2
// EXPECT: unlock 1
// EXPECT: 101
// EXPECT: unlock 102
// EXPECT: 101
// EXPECT: 102
struct Counter {
    n: i64,
}

struct Guard<'a> {
    c: &'a mut Counter,
}

impl Drop for Guard<'_> {
    fn drop(&mut self) {
        self.c.n += 1;
        println("unlock {}", self.c.n);
    }
}

impl Guard<'_> {
    fn over(&self, lim: i64) -> Option<i64> {
        if self.c.n > lim { Some(self.c.n) } else { None }
    }
}

fn lock(c: &mut Counter) -> Guard<'_> {
    Guard { c: c }
}

fn step(c: &mut Counter, lim: i64) {
    if let Some(n) = lock(c).over(lim) {
        println("over {n}");
    } else {
        c.n += 10;
        println("else {}", c.n);
    }
}

fn chain(c: &mut Counter) {
    if let Some(n) = lock(c).over(100) {
        println("first {n}");
    } else if let Some(n) = lock(c).over(20) {
        println("second {n}");
    } else {
        c.n = 0;
    }
}

fn first(c: &mut Counter) -> i64 {
    let Some(n) = lock(c).over(50) else {
        c.n += 100;
        return c.n;
    };
    n
}

fn main() {
    let mut c = Counter { n: 0 };
    step(&mut c, 5);
    step(&mut c, 5);
    chain(&mut c);
    chain(&mut c);
    println("{}", first(&mut c));
    println("{}", first(&mut c));
    println("{}", c.n);
}
