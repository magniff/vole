// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::alloc FixedBuf::used.
// EXPECT: 3
use std::alloc::{Allocator, Arena, FixedBuf, Layout};

fn main() {
    let mut mem = [0u8; 32];
    let fb = FixedBuf::new(&mut mem);
    let _ = fb.allocate(Layout::array::<u8>(3).unwrap());
    println("{}", fb.used());
}
