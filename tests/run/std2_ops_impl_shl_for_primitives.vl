// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::ops impl Shl for primitives.
// EXPECT: 48 48
use std::ops::Shl;

fn apply<T: Shl<Output = T>>(a: T, b: T) -> T {
    a.shl(b)
}

fn main() {
    println("{} {}", apply(12i64, 2), apply(12u8, 2));
}
