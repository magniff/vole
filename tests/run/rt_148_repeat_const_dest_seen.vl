// RULE: F35.2 (0.30.2, RT-148) `x = [C; N]` evaluates the N constants
// before the destination changes, as rustc's `x = [mk(), mk()]`: a
// constant's value that reads the destination (a static mut) sees its
// old value each time, and the old value is dropped after the last
// element is made. The output is rustc's (the twin with `mk()` calls).
// EXPECT: side 1 sees 2 3
// EXPECT: side 2 sees 2 3
// EXPECT: drop 7
// EXPECT: drop 8
// EXPECT: x 10 20
// EXPECT: side 3 sees 2 3
// EXPECT: side 4 sees 2 3
// EXPECT: side 5 sees 2 3
// EXPECT: drop 1
// EXPECT: drop 2
// EXPECT: drop 3
// EXPECT: end
// EXPECT: drop 10
// EXPECT: drop 20
struct D {
    k: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.k);
    }
}

static mut S: [D; 3] = [D { k: 1 }, D { k: 2 }, D { k: 3 }];
static mut CNT: i64 = 0;

fn side() -> i64 {
    // UNSAFE: the test's counter and its destination, read while it is built
    // SAFETY: one thread; S is always initialized
    let (c, a, b) = unsafe {
        CNT = CNT + 1;
        (CNT, S[1].k, S[2].k)
    };
    println("side {} sees {} {}", c, a, b);
    c * 10
}

const C: D = D { k: side() };

fn main() {
    let mut x = [D { k: 7 }, D { k: 8 }];
    x = [C; 2];
    println("x {} {}", x[0].k, x[1].k);
    // UNSAFE: the destination is a static mut
    // SAFETY: one thread
    unsafe {
        S = [C; 3];
    }
    println("end");
}
