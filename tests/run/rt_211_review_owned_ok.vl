// RT-211's review (m11, m16, m17, d/b03, b/g49's body): what must still
// build. A lifetime of an impl its header does not bind (`impl<'a, 'b>
// Extend<&'a i64> for Bag<'b>`, std's `Extend<&'a T> for Vec<T>`) relates
// to nothing of the subject: its slot is bound to the bound's argument
// for the impl's own predicates, never a reason to tie all (0.30.2's
// first fix refused m11, m16 and m17, which v0.30.1 and rustc build). A
// collector's body, `for x in c { b.extend(Some(x)) }` with `B: Extend<
// C::Item>`, is checked by its opaque instance and builds (b03, g49). The
// output is rustc's (the review's twins; tools/rustc-twin.sh rejects the shim's
// text with E0277 only because its partition_in asks `B: Default`).
// EXPECT: bag 3 0 2 1
// EXPECT: ["a", "bb"] ["bb"] ["a"] ["a", "bb"]
// EXPECT: [1, 2] [1, 2]
use std::alloc::Allocator;

fn mk(gpa: Gpa) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    v.push(2);
    v
}

struct Bag<'b> {
    name: &'b str,
    n: i64,
}

impl<'a, 'b> Extend<&'a i64> for Bag<'b> {
    fn extend<T: IntoIterator<Item = &'a i64>>(&mut self, it: T) {
        for x in it {
            self.n += *x;
        }
    }
}

impl<'b, A> DefaultIn<A> for Bag<'b> {
    fn default_in(_a: A) -> Bag<'b> {
        Bag { name: "bag", n: 0 }
    }
}

fn part<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator + Clone>(it: I, a: A)
    -> (B, B) {
    it.partition_in(|_x| true, a)
}

fn bare<I: Iterator, B: DefaultIn<A> + Extend<I::Item>, A: Allocator>(it: I, a: A) -> B {
    let mut b = B::default_in(a);
    for x in it {
        b.extend(Some(x));
    }
    b
}

fn coll<C: IntoIterator, B: DefaultIn<A> + Extend<C::Item>, A: Allocator>(c: C, a: A) -> B {
    let mut b = B::default_in(a);
    for x in c {
        b.extend(Some(x));
    }
    b
}

fn main(gpa: Gpa) {
    let v = mk(gpa);
    let (a, b): (Bag<'static>, Bag<'static>) = part(v.iter(), gpa);
    let (c, d): (Bag<'static>, Bag<'static>) = v.iter().partition_in(|x| **x > 1, gpa);
    drop(v);
    println("{} {} {} {} {}", a.name, a.n, b.n, c.n, d.n);
    let mut words: Vec<&'static str, Gpa> = Vec::new_in(gpa);
    words.push("a");
    words.push("bb");
    let r: Vec<&str, Gpa> = bare(words.iter(), gpa);
    let (p, q): (Vec<&str, Gpa>, Vec<&str, Gpa>) = words.iter().partition_in(|x| x.len() > 1,
        gpa);
    let mut e: Vec<&str, Gpa> = Vec::new_in(gpa);
    e.extend(words.iter());
    drop(words);
    println("{:?} {:?} {:?} {:?}", r, p, q, e);
    let w = mk(gpa);
    let x: Vec<&i64, Gpa> = coll(&w, gpa);
    let y: Vec<&i64, Gpa> = coll(w.as_slice(), gpa);
    println("{:?} {:?}", x, y);
}
