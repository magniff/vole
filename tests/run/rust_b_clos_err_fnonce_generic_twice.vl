// EDITION: rust
// RULE: D19.5, D19.7
// (0.27.2) A generic body calls its `FnOnce` parameter twice: the first
// call moves it (rustc E0382).
// ERROR: error[borrowck.use_moved]
fn twice<F: FnOnce() -> i64>(f: F) -> i64 {
    f() + f()
}

struct S {
    n: i64,
}

fn main() {
    let s = S { n: 2 };
    println("{}", twice(move || s.n));
}
