// EDITION: rust
// RULE: F34.2
// (0.27.6) A constant made at each use is read as at the constant: a
// local or a type parameter of the use with the same name as one in its
// value does not take its place (0.27.6's first F34.2 and 0.27.5's
// inherent constants resolved the copy in the use's scope: the closure
// `double` was called, and `D` was the type parameter).
// EXPECT: 42 7 44 6 3 5
#[derive(Clone, Copy)]
struct D {
    secs: u64,
}

impl D {
    const TWICE: u64 = double(22);
    const SIX: D = D { secs: double(3) };
}

const fn double(x: u64) -> u64 {
    x * 2
}

const N: u64 = double(21);
const M: D = D { secs: 7 };

fn generic<D: Copy>(_x: D) -> u64 {
    M.secs
}

fn main() {
    let double = |x: u64| x + 1000;
    let secs = 99u64;
    let n = N;
    let m = generic(1u8);
    let t = D::TWICE;
    let s = D::SIX.secs;
    let three = (|v: u64| v)(3);
    println("{} {} {} {} {} {}", n, m, t, s, three, double(5) - 1000 + secs - 99);
}
