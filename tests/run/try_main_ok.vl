// EDITION: rust
// `fn main() -> Result<(), E>` that returns Ok(()): exit status 0.
// EXPECT: 3
fn parse(s: &str) -> Result<i64, &str> {
    if s.len() == 0 { Err("empty") } else { Ok(s.len() as i64) }
}

fn main() -> Result<(), &'static str> {
    print("{}", (parse("abc")?));
    println("");
    Ok(())
}
