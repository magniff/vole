// A method's turbofish whose argument is a qualified path, `M.m::<<S as A>::Out>()` and `M.m::<<<S as A>::Out as B>::E>()` (v0.30.1: "expected ';', got '::'"; rustc 9 9)
// From the second round of the qualified paths (RT-93: `<<` and `<` where a type, type arguments or an expression start): fails on v0.30.1.
// EXPECT: 9 9
trait A {
    type Out;
    const C: i64;
}

trait B {
    type E;
    const D: i64;
    fn make() -> i64;
}

struct S;

struct O;

impl A for S {
    type Out = O;
    const C: i64 = 3;
}

impl B for O {
    type E = i64;
    const D: i64 = 2;

    fn make() -> i64 {
        40
    }
}

trait G<T> {
    fn g(&self) -> i64;
}

impl G<O> for S {
    fn g(&self) -> i64 {
        5
    }
}

struct M;

impl M {
    fn m<T>(&self) -> i64 {
        9
    }
}

fn main() {
    let x = M.m::<<S as A>::Out>();
    let y = M.m::<<<S as A>::Out as B>::E>();
    println("{} {}", x, y);
}
