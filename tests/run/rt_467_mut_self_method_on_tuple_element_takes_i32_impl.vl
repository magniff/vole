// XFAIL: RT-467: WRONG CODE: a tuple element holding an untyped literal, mutated through a `&mut self` method of a trait impl'd for i32 and i64 (`p.0.bump()`) and then read as i64 (`let b: i64 = p.0;`), runs i32's impl and widens after it: -O0 panics (attempt to multiply with overflow), -O2 prints -1294967296; rustc types the element i64 and prints 3000000000 (0.30.2)
// From the re-review of the integer-literal work (t302int). Since v0.30.1 at least.
// type.widen_i32 refuses the same program on a plain variable
// (`let mut p = 1500000000; p.bump(); let b: i64 = p;`); an element of a
// tuple, an array or a struct field (rt_467b, rt_467c) escapes it.
// EXPECT: 3000000000
trait Bump { fn bump(&mut self); }
impl Bump for i32 { fn bump(&mut self) { *self = *self * 2; } }
impl Bump for i64 { fn bump(&mut self) { *self = *self * 2; } }

fn main() {
    let mut p = (1500000000, 0);
    p.0.bump();
    let b: i64 = p.0;
    println("{}", b);
}
