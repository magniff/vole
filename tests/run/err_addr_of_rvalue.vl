// EDITION: rust
// `&(1 + 2)` takes a temporary (0.18.1, addr_of_temporary.vl); one
// after a call in its statement does not (the call could see the order
// change), and the error's try: names it first. 0.20: `&` of a value is
// a raw pointer's address (`p: *P`) or an inout argument.
// ERROR: error[type error]
// ERROR: line 16, column 16
#[derive(Clone, Copy)] struct P { x: i64 }

fn one() -> i64 { 1 }

fn get(n: i64, p: *mut P) -> i64 { n + unsafe { (*p).x } }

fn main() -> i64 {
    let q = &mut (1 + 2);
    get(one(), &P { x: one() }) + unsafe { *q }
}
