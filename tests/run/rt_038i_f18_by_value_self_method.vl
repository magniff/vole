// RULE: C3.4
// (0.30.2, the re-review of g302holes: c1/f18_by_value_self_method)
// RUSTC: none contract clauses are not Rust
// ERROR: cannot borrow '*p' as mutable
// A by-value self method of &mut i64 called on the alias.
type R<'a> = &'a mut i64;

trait Set9 {
    fn set9(self) -> bool;
}

impl Set9 for &mut i64 {
    fn set9(self) -> bool {
        *self = 9;
        true
    }
}

fn f(p: R<'_>) -> i64
    ensures p.set9()
{
    *p += 1;
    *p
}

fn main() {
    let mut x = 1i64;
    println("{}", f(&mut x));
    println("{}", x);
}
