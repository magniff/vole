// XFAIL: RT-77: a call the compiler builds by name (as_str for str methods, iter for `for x in &v`, as_slice for indexing) takes a program's trait method of that name (RT-77's family): form x02 (0.30.2)
// From the review of g302probe part 1. v0.30.1: 27 9 2
// EXPECT: 3 2 2
static NINE: [i64; 3] = [9, 9, 9];
trait AS { fn as_slice(self) -> &'static [i64]; fn iter(self) -> std::slice::Iter<'static, i64>; }

impl<'a> AS for &'a Vec<i64, Gpa> {
    fn as_slice(self) -> &'static [i64] { &NINE } fn iter(self) -> std::slice::Iter<'static, i64> {
        NINE.iter()
    }
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa); v.push(1); v.push(2); let mut s = 0;
    for x in &v { s += *x; } let r = &v; println("{} {} {}", s, r[1], r.len());
}
