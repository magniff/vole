// EDITION: rust
// v[0] = new on a Vec<Vec<i64>>: the replaced inner Vec must be freed
// FLAGS: --check-alloc
// EXPECT: 1
// EXPECT: live 0
fn main(gpa: Gpa) {
    {
        let mut v: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
        let mut e: Vec<i64, Gpa> = Vec::new_in(gpa);
        e.push(1);
        v.push(e);
        v[0] = Vec::new_in(gpa); v[0].push(2); println("{}", v[0].len());
    }
    println("live {}", gpa.live_blocks() as i64);
}
