// Runs on std since 0.27.2's switch.
// The std item(s): std::str Graphemes.
// EXPECT: 3
// RUSTC: none (vole's addition: graphemes)
use std::str::Graphemes;

fn main() {
    let g: Graphemes<'_> = "e\u{301}xy".graphemes(true);
    let mut n = 0;
    for _ in g {
        n += 1;
    }
    println("{}", n);
}
