// qsort calls back into a vole function that prints.
// ERROR: 'sort3' is #[no_io], but it does io
extern "C" {
    fn qsort(base: *mut u8, n: u64, size: u64, cmp: extern "C" fn(*mut u8, *mut u8) -> i32);
}

extern "C" fn cmp(a: *mut u8, b: *mut u8) -> i32 {
    println("io");
    unsafe { (*(a as *mut i64) - *(b as *mut i64)) as i32 }
}

#[no_io]
fn sort3(a: &mut [i64; 3]) {
    unsafe { qsort(a.as_mut_ptr() as *mut u8, 3, 8, cmp); }
}

fn main() -> i32 {
    let mut a = [3i64, 1, 2];
    sort3(&mut a);
    println("{} {} {}", a[0], a[1], a[2]);
    0
}
