// EDITION: rust
// FLAGS: --check-alloc
// EXIT: 101
// STDERR: check-alloc: out of memory maps at block #101, with 100 blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)
// STDERR: try: sudo sysctl vm.max_map_count=1048576
// 0.16: --check-alloc: each live block has pages of its own, and Linux
// limits a process's memory maps (vm.max_map_count): reaching the limit
// stops the program with the fix. VOLE_ALLOC_MAX_LIVE gives the same
// stop at a count of live blocks, on any system (for this test).
use std::alloc::Layout; extern "C" {
    fn setenv(name: *mut u8, value: *mut u8, overwrite: i32) -> i32;
}

fn main(gpa: Gpa) {
    unsafe {
        setenv(c"VOLE_ALLOC_MAX_LIVE", c"100", 1);
    }
    let mut keep: [*mut u8; 200] = [0 as *mut u8; 200];
    for i in 0..200 {
        keep[i as usize] = gpa
            .allocate(Layout::from_size_align(16 as usize, 8 as usize).unwrap())
            .unwrap()
            .as_ptr();
    }
}
