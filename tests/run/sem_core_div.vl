// (0.26.3, decision 6) x / 0, x % 0, MIN / -1 and MIN % -1 panic at every
// level (tests/run/ovf_div_*): checked_div and checked_rem give None for
// them at every width, wrapping_div and wrapping_rem MIN and 0 for
// MIN / -1; truncation and the sign of the dividend, constant and at run
// time. (Before 0.26.3: x / 0 == 0, x % 0 == x, MIN / -1 == MIN.)
// EXPECT: None None None None
// EXPECT: None None None None
// EXPECT: None None None None
// EXPECT: None None None None
// EXPECT: -128 0 -32768 0
// EXPECT: -2147483648 0 -9223372036854775808 0
// EXPECT: None None None None
// EXPECT: -3 -1 -3 1 3 -1
// EXPECT: -3 -1 -1 -3 0 -7 1 -3
// EXPECT: 9223372036854775807 5 6148914691236517205
static var Z: i64 = 0;

fn main() -> i32 {
    Z = std::env::args().len() as i64 - 1;
    let z = Z;
    // by zero, run time, every width
    let i8v: i8 = -7 + z as i8;
    let u8v: u8 = 250 + z as u8;
    let i16v: i16 = -700 + z as i16;
    let u16v: u16 = 65000 + z as u16;
    let i32v: i32 = -70000 + z as i32;
    let u32v: u32 = 4000000000 + z as u32;
    let u64v: u64 = 18446744073709551615 + z as u64;
    println("{:?} {:?} {:?} {:?}", i8v.checked_div(z as i8), i8v.checked_rem(z as i8),
        u8v.checked_div(z as u8), u8v.checked_rem(z as u8));
    println("{:?} {:?} {:?} {:?}", i16v.checked_div(z as i16), i16v.checked_rem(z as i16),
        u16v.checked_div(z as u16), u16v.checked_rem(z as u16));
    println("{:?} {:?} {:?} {:?}", i32v.checked_div(z as i32), i32v.checked_rem(z as i32),
        u32v.checked_div(z as u32), u32v.checked_rem(z as u32));
    println("{:?} {:?} {:?} {:?}", u64v.checked_div(z as u64), u64v.checked_rem(z as u64),
        (-7 + z).checked_div(z), (-7 + z).checked_rem(z));
    // MIN / -1
    let m1 = -1 + z;
    let n8: i8 = -128 + z as i8;
    let n16: i16 = -32768 + z as i16;
    let n32: i32 = -2147483648 + z as i32;
    let n64: i64 = -9223372036854775807 - 1 + z;
    println("{} {} {} {}", n8.wrapping_div(m1 as i8), n8.wrapping_rem(m1 as i8),
        n16.wrapping_div(m1 as i16), n16.wrapping_rem(m1 as i16));
    println("{} {} {} {}", n32.wrapping_div(m1 as i32), n32.wrapping_rem(m1 as i32),
        n64.wrapping_div(m1), n64.wrapping_rem(m1));
    println("{:?} {:?} {:?} {:?}", n8.checked_div(m1 as i8), n8.checked_rem(m1 as i8),
        n64.checked_div(m1), n64.checked_rem(m1));
    // truncation and signs
    println("{} {} {} {} {} {}", -7 / 2, -7 % 2, 7 / -2, 7 % -2, -7 / -2, -7 % -2);
    let s = -7 + z;
    println("{} {} {} {} {} {} {} {}", s / 2, s % 2, s / 4, s % 4, s / 8, s % 8, s / -4, s % -4);
    let big: u64 = 18446744073709551615 + z as u64;
    println("{} {} {}", big / 2, big % 10, big / 3);
    0
}
