// (0.30.1) Two locals of 2^60 bytes each fit as types, but not together
// in one frame: the code generator refuses a frame of 2^61 bytes or
// more, where it wrapped before (an offset past i64 is a memory error).
// ERROR: a function's frame is 2^61 bytes or more
fn main() {
    let n = std::env::args().count();
    if n > 5 {
        let a = [0u8; 1usize << 60];
        let b = [1u8; 1usize << 60];
        println("{} {}", a[n], b[n]);
    }
    println("ok");
}
