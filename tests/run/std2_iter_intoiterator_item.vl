// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter IntoIterator::Item.
// EXPECT: 3

fn total<C: IntoIterator<Item = i64>>(c: C) -> C::Item {
    let mut s = 0;
    for x in c {
        s += x;
    }
    s
}

fn main(gpa: Gpa) {
    println("{}", total(Vec::from_in([1i64, 2], gpa)));
}
