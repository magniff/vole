// EDITION: rust
// RULE: F19.3
// A closure that captures nothing coerces to an `unsafe fn` type as well
// as to a `fn` type, as in rustc: a `let` with the type, an argument,
// and a field.
// EXPECT: 2 13 30
fn apply(f: unsafe fn(i64) -> i64, x: i64) -> i64 {
    // SAFETY: every closure given here has no precondition.
    unsafe { f(x) }
}

struct Table {
    op: unsafe fn(i64) -> i64,
}

fn main() {
    let f: unsafe fn(i64) -> i64 = |x: i64| x + 1;
    let t = Table { op: |x| x * 3 };
    // SAFETY: the closures have no precondition.
    let a = unsafe { f(1) };
    let b = apply(|x| x + 10, 3);
    let c = apply(t.op, 10);
    print("{}", a);
    print(" ");
    print("{}", b);
    print(" ");
    println("{}", c);
}
