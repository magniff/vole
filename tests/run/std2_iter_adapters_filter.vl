// EDITION: rust
// XFAIL: std2 is not the edition's std until 0.27.2's switch (front272 M3)
// The std2 item(s): std::iter::adapters Filter.
// EXPECT: [2]
use std::iter::{Filter, FusedIterator};

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3], gpa);
    let it = s.iter().copied().filter(|x| x % 2 == 0);
    let v: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?}", v);
}
