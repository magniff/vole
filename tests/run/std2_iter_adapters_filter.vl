// EDITION: rust
// Runs on std2 since its gap closed (0.27.2.1).
// The std2 item(s): std::iter::adapters Filter.
// EXPECT: [2]
use std::iter::Filter;

fn main(gpa: Gpa) {
    let s = Vec::from_in([1i64, 2, 3], gpa);
    let it = s.iter().copied().filter(|x| x % 2 == 0);
    let v: Vec<i64, Gpa> = it.collect_in(gpa);
    println("{:?}", v);
}
