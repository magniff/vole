// EDITION: rust
// RULE: F18.5
// (0.28.0) A comparison of two trees of literals and open locals keeps
// them open, one variable, as in rustc: after `if a > b` (or `a + 1 ==
// n`), `return a` in an i64 function types a and b. Before, the first
// operand's use closed it at i32 (255 for `1 << 40`, 0 for `1 << 41`).
// EXPECT: 1099511627776
// EXPECT: 7
// EXPECT: 2199023255551 1
// EXPECT: 5
fn larger(x: i64) -> i64 {
    let a = 1 << 40;
    let b = 7;
    if a > b && x > 0 {
        return a;
    }
    b
}

fn near(m: i64) -> i64 {
    let n = 1 << 41;
    let a = n - 1;
    if a + 1 == n {
        return a;
    }
    m
}

fn none() -> u8 {
    let a = 4;
    let b = 5;
    if a < b {
        return b;
    }
    a
}

fn main() {
    println("{}", larger(1));
    println("{}", larger(0));
    println("{} {}", near(0), near(0) & 1);
    println("{}", none());
}
