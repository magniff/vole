// rustc prints the EXPECT lines (twin .rs.txt). The release build: six
// errors, the last `s.put((2u8, 4000000000))` "does not fit in type 'i32'"
// because s is taken as `S<u8>` with `p: (u8, i32)`. Right today
// (misc/tup2.vl): a generic fn's own result `(t, 3000000000)` for `-> (T,
// i64)`, `S::new(1u8)` then `s.put((2u8, 4000000000))`, a struct literal
// under a written `let s2: S<u8>`, a literal beside the tuple (`two((1u8,
// 2i64), 3000000000)`).
// EXPECT: 3000000000
// EXPECT: 3000000000
// EXPECT: 4000000000
fn ap<T, F: Fn() -> (T, i64)>(f: F) -> i64 {
    f().1
}

fn arr<T>(a: [(T, i64); 1]) -> i64 {
    a[0].1
}

struct S<T> {
    p: (T, i64),
}

impl<T> S<T> {
    fn put(&mut self, p: (T, i64)) {
        self.p = p;
    }
}

fn main() {
    println("{}", ap(|| (1u8, 3000000000)));
    println("{}", arr([(1u8, 3000000000)]));
    let mut s = S { p: (1u8, 1) };
    s.put((2u8, 4000000000));
    println("{}", s.p.1);
}
