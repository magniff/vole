// a clamp written wrong (max instead of min) is still checked.
// EXIT: 101
// STDERR: index out of bounds: index 8, length 8
static mut Z: i64 = 0;

#[inline(never)]
fn f(s: &[i64], i: i64) -> i64 {
    let j = if i > (s.len() - 1) as i64 { i } else { (s.len() - 1) as i64 }; s[j as usize]
}

fn main() -> i32 {
    unsafe { Z = std::env::args().len() as i64 - 1; }
    let a = [0i64, 1, 2, 3, 4, 5, 6, 7];
    let s = &a[..];
    let big = [0i64; 128];
    println("{}", f(s, 8 + unsafe { Z }));
    0
}
