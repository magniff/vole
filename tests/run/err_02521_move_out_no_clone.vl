struct Pool<A: Allocator> { items: Vec<i64, A> }

struct Owner<A: Allocator> { pool: Pool<A> }

struct Many<A: Allocator> { v: Vec<i64, A> }

fn own(p: Pool<Gpa>) -> Owner<Gpa> {
    Owner { pool: p }
}

fn many(v: Vec<i64, Gpa>) -> Many<Gpa> {
    Many { v: v }
}

