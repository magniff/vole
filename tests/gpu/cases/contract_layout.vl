// A bind group with an entry for every binding the module declares, for
// a layout that holds only the two its entry point uses: gpu.layout at
// the call, naming the layout's bindings (0.25.2.1).
// EXIT: 101
// STDERR: contract_layout.vl:26:17: gpu.layout: the layout has 2 bindings, 0 and 3, and binding 1 of the bind group does not fit them: a layout is the bindings the pipeline's own entry points use

use std::gpu::BufferUsage;

const SHADER: [u8] = "@group(0) @binding(0) var<storage, read_write> xs: array<u32>;\n\
    @group(0) @binding(1) var<storage, read_write> unused: array<u32>;\n\
    @group(0) @binding(3) var<storage, read_write> ys: array<u32>;\n\
    @compute @workgroup_size(8) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    xs[id.x] = ys[id.x];\n\
    }\n";

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let shader = dev.shader_wgsl(SHADER).unwrap();
    let pipe = dev.compute_pipeline(shader, "main").unwrap();
    let a = dev.buffer(64, BufferUsage::STORAGE);
    let b = dev.buffer(64, BufferUsage::STORAGE);
    let c = dev.buffer(64, BufferUsage::STORAGE);
    let entries = [std::gpu::bind(0, a), std::gpu::bind(1, b), std::gpu::bind(3, c)];
    let group = dev.bind_group(pipe.bind_layout(0), entries[..]);
    println("not reached");
    0
}
