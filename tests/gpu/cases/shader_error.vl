// EDITION: rust
// MSL that does not compile: dev.shader returns Error::Shader with
// Metal's message; nothing leaks.
// EXPECT: shader error ok

use std::gpu::Reflection; use std::gpu::ShaderSource;

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, mut queue) = adapter.device().unwrap();
    let mut refl = Reflection::new_in(gpa);
    refl.compute("main", "k", 64);
    let src = ShaderSource::msl(
        "kernel void k(device uint* xs [[buffer(0)]]) { xs[0] = undefined_name; }", refl);
    match dev.shader(&src) {
        Ok(_) => println("compiled?"),
        Err(e) => {
            let text = format_in("{e}", gpa);
            let msg = text.as_bytes();
            let mut found = false;
            for i in 0..msg.len() {
                if i + 14 <= msg.len() && msg[i..i + 14] == b"undefined_name" { found = true; }
            }
            if found { println("shader error ok"); } else { println("unexpected: {msg}", msg = str::from_utf8(msg).unwrap()); }
        }
    }
    0
}
