// A buffer over the device's max_buffer_size: gpu.limits names the limit
// as a program reads it and says how to raise it (0.25.2.2; before:
// `a buffer's size is 0..limits.max_buffer_size: size = ..,
// self.limits.max_buffer_size = ..`). adapter.limits() is the most the
// adapter takes, more than the default's 1 GiB here; a device opened with
// a smaller max_buffer_size refuses a larger buffer.
// EXIT: 101
// EXPECT: adapter max over 1 GiB true
// EXPECT: device(adapter.limits()) true
// STDERR: contract_limits_buffer.vl:25:16: gpu.limits: a buffer of 2048 bytes; this device makes them up to 1024 (dev.limits().max_buffer_size; Limits::default() has 1 GiB): ask for more when opening it, up to the adapter's largest (adapter.limits().max_buffer_size): `var lim = Limits::default(); lim.max_buffer_size = 2048; adapter.device(lim)`

use std::gpu::{BufferUsage, Limits};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let max = adapter.limits().max_buffer_size;
    println(f"adapter max over 1 GiB {max > 1 << 30}");
    let (all, _q) = adapter.device(adapter.limits()).unwrap();
    println(f"device(adapter.limits()) {all.limits().max_buffer_size == max}");
    var lim = Limits::default();
    lim.max_buffer_size = 1024;
    let (dev, _queue) = adapter.device(lim).unwrap();
    let _ok = dev.buffer(1024, BufferUsage::STORAGE);
    let _big = dev.buffer(2048, BufferUsage::STORAGE);
    println("not reached");
    0
}
