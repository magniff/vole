// (0.25.3) WebGPU's rule: MAP_WRITE goes with COPY_SRC alone (the GPU
// could read a uniform buffer while the CPU writes it mapped):
// dev.buffer_init stops with gpu.usage.
// EXIT: 101
// STDERR: contract_usage_map_write.vl:14:13: gpu.usage: a buffer made with BufferUsage::MAP_WRITE has COPY_SRC besides and nothing more (WebGPU's rule: the GPU could read it while the CPU writes); this one's usage is 66: write the buffer the GPU uses with queue.write_buffer, or write one of MAP_WRITE | COPY_SRC and copy it (enc.copy_buffer)

use std::gpu;
use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var _queue) = inst.adapter()?.device()?;
    let bytes: [u8; 16] = [0; 16];
    let _ = dev.buffer_init(bytes[..], BufferUsage::MAP_WRITE | BufferUsage::UNIFORM);
    println("not reached");
    Ok(())
}
