// 0.26.0: an embedded block end to end: `embed wgsl K { .. }` checked at
// compile time, its text `K.src` into dev.shader_wgsl, its entry point
// `K.square` into compute_pipeline, run, read back.
// EXPECT: block ok 0 1 4 9 16 25 36 49

use std::gpu::BufferUsage;

embed wgsl K {
    @group(0) @binding(0) var<storage, read> xs: array<u32>;
    @group(0) @binding(1) var<storage, read_write> ys: array<u32>;

    @compute @workgroup_size(8)
    fn square(@builtin(global_invocation_id) id: vec3<u32>) {
        ys[id.x] = xs[id.x] * xs[id.x];
    }
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let shader = dev.shader_wgsl(K.src).unwrap();
    let pipe = dev.compute_pipeline(shader, K.square).unwrap();
    var xs: Vec<u32> = Vec::new_in(gpa);
    for i in 0..8 {
        xs.push(i as u32);
    }
    let xb = dev.buffer_init(std::gpu::bytes_of_u32(xs.as_slice()), BufferUsage::STORAGE);
    var yb = dev.buffer(8 * 4, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    var yb_read = dev.buffer(8 * 4, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let group = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind(0, xb), std::gpu::bind(1, yb)][..]);
    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(1);
    });
    enc.copy_buffer(yb, 0, yb_read, 0, 8 * 4);
    queue.submit(enc.finish());
    let ys = std::gpu::u32s(yb_read.map_read(dev));
    print("block ok");
    for i in 0..8 {
        print(" {}", ys[i]);
    }
    println("");
    0
}
