// A pipeline's layout is the bindings its own entry points use, through
// their calls, not those of the module's other entry points (0.25.2.2,
// WebGPU's `layout: "auto"`; before, every entry point of the pipeline's
// stages in the module added its bindings). Two kernels of one module get
// their own layouts and run with bind groups of their own bindings only;
// render pipelines from one module too: a water pipeline (vs_water,
// fs_water) beside the terrain's (vs, fs) gets 0 and 2, not 0, 1 and 2,
// and a depth-only pipeline of vs gets 0 and 1.
// EXPECT: ka 0 1
// EXPECT: kb 0 2
// EXPECT: ka ok 1 2 3 4
// EXPECT: kb ok 0 2 4 6
// EXPECT: terrain 0 1
// EXPECT: water 0 2
// EXPECT: depth 0 1

use std::gpu::{BufferUsage, Format};

const KERNELS: [u8] = "@group(0) @binding(0) var<storage, read> xs: array<u32>;\n\
    @group(0) @binding(1) var<storage, read_write> a: array<u32>;\n\
    @group(0) @binding(2) var<storage, read_write> b: array<u32>;\n\
    fn put_b(i: u32) { b[i] = xs[i] * 2u; }\n\
    @compute @workgroup_size(4) fn ka(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    a[id.x] = xs[id.x] + 1u;\n\
    }\n\
    @compute @workgroup_size(4) fn kb(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    put_b(id.x);\n\
    }\n";

const SCENE: [u8] = "struct U { m: vec4<f32> }\n\
    @group(0) @binding(0) var<uniform> u: U;\n\
    @group(0) @binding(1) var<uniform> light: U;\n\
    @group(0) @binding(2) var<uniform> water: U;\n\
    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n\
    return u.m + light.m * f32(i);\n\
    }\n\
    @fragment fn fs() -> @location(0) vec4<f32> { return u.m + light.m; }\n\
    @vertex fn vs_water(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n\
    return u.m * f32(i);\n\
    }\n\
    @fragment fn fs_water() -> @location(0) vec4<f32> { return water.m; }\n";

fn show(name: [u8], l: std::gpu::BindLayout) {
    print(name);
    for i in 0..l.count {
        print(f" {l.entries[i].binding}");
    }
    println("");
}

fn run(dev: std::gpu::Device, queue: inout std::gpu::Queue, pipe: std::gpu::ComputePipeline,
    xs: std::gpu::Buffer, out: i64, name: [u8]) {
    var ys = dev.buffer(16, BufferUsage::STORAGE | BufferUsage::MAP_READ);
    let group = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind(0, xs), std::gpu::bind(out, ys)][..]);
    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(1);
    });
    queue.submit(enc.finish());
    let got = std::gpu::u32s(ys.map_read(dev));
    print(f"{name} ok");
    for i in 0..4 {
        print(f" {got[i]}");
    }
    println("");
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let k = dev.shader_wgsl(KERNELS).unwrap();
    let ka = dev.compute_pipeline(k, "ka").unwrap();
    let kb = dev.compute_pipeline(k, "kb").unwrap();
    show("ka", ka.bind_layout(0));
    show("kb", kb.bind_layout(0));
    let xs = dev.buffer_init(std::gpu::bytes_of_u32([0u32, 1, 2, 3][..]), BufferUsage::STORAGE);
    run(dev, &queue, ka, xs, 1, "ka");
    run(dev, &queue, kb, xs, 2, "kb");

    let s = dev.shader_wgsl(SCENE).unwrap();
    let terrain = dev.render_pipeline(std::gpu::RenderDesc::new(s, "vs", "fs", Format::Rgba8Unorm))
        .unwrap();
    let water = dev.render_pipeline(
        std::gpu::RenderDesc::new(s, "vs_water", "fs_water", Format::Rgba8Unorm)).unwrap();
    let depth = dev.render_pipeline(std::gpu::RenderDesc::depth_only(s, "vs", Format::Depth32Float))
        .unwrap();
    show("terrain", terrain.bind_layout(0));
    show("water", water.bind_layout(0));
    show("depth", depth.bind_layout(0));
    0
}
