// (0.25.3) WebGPU's rule: MAP_READ goes with COPY_DST alone (a storage
// buffer the GPU writes could change a mapped view under the program),
// so a mappable buffer is reached by copies only; dev.buffer stops with
// gpu.usage and the way to read a kernel's output back.
// EXIT: 101
// STDERR: contract_usage_map.vl:15:13: gpu.usage: a buffer made with BufferUsage::MAP_READ has COPY_DST besides and nothing more (WebGPU's rule: what the GPU writes otherwise could change a mapped view); this one's usage is 129: make the buffer the GPU writes with COPY_SRC (not MAP_READ), copy it into one of MAP_READ | COPY_DST (enc.copy_buffer) and map that

use std::gpu;
use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var _queue) = inst.adapter()?.device()?;
    let ok = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let _ = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::STORAGE);
    println("not reached {}", ok.size());
    Ok(())
}
