// A uniform buffer read by a dispatch before anything wrote it: the
// gpu.unwritten contract at queue.submit (0.25.2.2; before, the kernel
// read zeros and wrote nothing, silently). First the ways a uniform is
// written, none of which fails: write_buffer before the encoding, after
// the encoding and before the submit (the write comes before the
// commands, as WebGPU's), buffer_init, a copy into it earlier in the
// same commands, and a kernel writing it as storage in commands
// submitted before. Then the one never written.
// EXIT: 101
// EXPECT: written 4 4 4 4 4
// STDERR: contract_unwritten.vl:106:5: gpu.unwritten: binding 0 of group 0 (a uniform buffer of 16 bytes) was never written: write it (queue.write_buffer) before submitting the first dispatch or draw that reads it

use std::gpu::{BufferUsage, ComputePipeline};

const KERNEL: [u8] = "struct P { n: u32, pad0: u32, pad1: u32, pad2: u32 }\n\
    @group(0) @binding(0) var<uniform> p: P;\n\
    @group(0) @binding(1) var<storage, read_write> out: array<u32>;\n\
    @compute @workgroup_size(1) fn main() { out[0] = p.n; }\n";

const FILL: [u8] = "@group(0) @binding(0) var<storage, read_write> u: array<u32>;\n\
    @compute @workgroup_size(1) fn main() { u[0] = 4u; }\n";

const UNIFORM: u32 = BufferUsage::UNIFORM | BufferUsage::COPY_DST;

// Encodes the kernel over (u, out).
fn encode(dev: std::gpu::Device, pipe: ComputePipeline, u: std::gpu::Buffer,
    out: std::gpu::Buffer) -> std::gpu::Encoder {
    let group = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind(0, u), std::gpu::bind(1, out)][..]);
    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(1);
    });
    enc
}

// out's first u32, read through a copy (a mappable buffer is not storage)
fn result(dev: std::gpu::Device, queue: inout std::gpu::Queue, out: std::gpu::Buffer) -> u32 {
    var rb = dev.buffer(4, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.copy_buffer(out, 0, rb, 0, 4);
    queue.submit(enc.finish());
    std::gpu::u32s(rb.map_read(dev))[0]
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let pipe = dev.compute_pipeline(dev.shader_wgsl(KERNEL).unwrap(), "main").unwrap();
    let four = std::gpu::bytes_of_u32([4u32, 0, 0, 0][..]);
    let out = dev.buffer(4, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    print("written");

    // write_buffer, then the commands
    let u1 = dev.buffer(16, UNIFORM);
    queue.write_buffer(u1, 0, four);
    queue.submit(encode(dev, pipe, u1, out).finish());
    print(f" {result(dev, &queue, out)}");

    // the commands, then write_buffer, then the submit
    let u2 = dev.buffer(16, UNIFORM);
    let enc = encode(dev, pipe, u2, out);
    queue.write_buffer(u2, 0, four);
    queue.submit(enc.finish());
    print(f" {result(dev, &queue, out)}");

    // made with its bytes
    let u3 = dev.buffer_init(four, UNIFORM);
    queue.submit(encode(dev, pipe, u3, out).finish());
    print(f" {result(dev, &queue, out)}");

    // a copy into it, earlier in the same commands
    let src = dev.buffer_init(four, BufferUsage::COPY_SRC);
    let u4 = dev.buffer(16, UNIFORM);
    var enc4 = dev.encoder();
    enc4.copy_buffer(src, 0, u4, 0, 16);
    let group4 = dev.bind_group(pipe.bind_layout(0),
        [std::gpu::bind(0, u4), std::gpu::bind(1, out)][..]);
    enc4.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group4);
        pass.dispatch(1);
    });
    queue.submit(enc4.finish());
    print(f" {result(dev, &queue, out)}");

    // a kernel wrote it as storage, in commands submitted before
    let fill = dev.compute_pipeline(dev.shader_wgsl(FILL).unwrap(), "main").unwrap();
    let u5 = dev.buffer(16, UNIFORM | BufferUsage::STORAGE);
    let fg = dev.bind_group(fill.bind_layout(0), [std::gpu::bind(0, u5)][..]);
    var enc5 = dev.encoder();
    enc5.compute_pass(|pass| {
        pass.set_pipeline(fill);
        pass.set_bind_group(0, fg);
        pass.dispatch(1);
    });
    queue.submit(enc5.finish());
    queue.submit(encode(dev, pipe, u5, out).finish());
    println(f" {result(dev, &queue, out)}");

    // never written
    let u6 = dev.buffer(16, UNIFORM);
    queue.submit(encode(dev, pipe, u6, out).finish());
    println("not reached");
    0
}
