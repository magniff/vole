// Compute: a sum of 1M u32s by threadgroup memory and an atomic, checked
// against the CPU's sum.
// EXPECT: reduce ok

use std::gpu::BindingType; use std::gpu::BufferUsage; use std::gpu::Limits; use std::gpu::Power;
use std::gpu::Reflection;
use std::gpu::ShaderSource; use std::gpu::StageSlots;

const MSL: [&str; 15] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "kernel void reduce(device const uint* xs [[buffer(0)]], device atomic_uint* total [[buffer(1)]],",
    "                   constant uint& n [[buffer(2)]],",
    "                   uint i [[thread_position_in_grid]], uint l [[thread_position_in_threadgroup]]) {",
    "    threadgroup uint tmp[256];",
    "    tmp[l] = i < n ? xs[i] : 0;",
    "    threadgroup_barrier(mem_flags::mem_threadgroup);",
    "    for (uint s = 128; s > 0; s >>= 1) {",
    "        if (l < s) { tmp[l] += tmp[l + s]; }",
    "        threadgroup_barrier(mem_flags::mem_threadgroup);",
    "    }",
    "    if (l == 0) { atomic_fetch_add_explicit(total, tmp[0], memory_order_relaxed); }",
    "}",
    "",
];

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter(Power::High).unwrap();
    let (dev, mut queue) = adapter.device(Limits::default()).unwrap();
    let mut text = lines(&MSL[..], gpa);
    let mut refl = Reflection::new_in(gpa);
    refl.compute("main", "reduce", 256, 1, 1);
    refl.bind(0, 0, BindingType::ReadOnlyStorage, StageSlots::compute(0));
    refl.bind(0, 1, BindingType::Storage, StageSlots::compute(1));
    refl.bind(0, 2, BindingType::Uniform, StageSlots::compute(2));
    let src = ShaderSource::msl(text.as_str(), refl);
    let mut shader = dev.shader(&src).unwrap();
    let mut pipe = dev.compute_pipeline(&shader, "main").unwrap();

    let n: i64 = 1000003;
    let mut xs: Vec<u32, Gpa> = Vec::new_in(gpa);
    let mut want: u32 = 0;
    for i in 0..n {
        let v = ((i * 7919) % 101) as u32;
        xs.push(v);
        want += v;
    }
    let mut xb = dev.buffer_init(std::gpu::bytes_of_u32(xs.as_slice()), BufferUsage::STORAGE);
    let mut total = dev.buffer(4, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    let mut total_read = dev.buffer(4, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let params: [u32; 4] = [n as u32, 0, 0, 0];
    let mut pb = dev.buffer_init(std::gpu::bytes_of_u32(&params[..]), BufferUsage::UNIFORM);
    let mut group = dev.bind_group(pipe.bind_layout(0),
        &[std::gpu::bind(0, &xb), std::gpu::bind(1, &total), std::gpu::bind(2, &pb)][..]);
    let mut enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(&pipe);
        pass.set_bind_group(0, &group);
        pass.dispatch((n + 255) / 256, 1, 1);
    });
    enc.copy_buffer(&total, 0, &total_read, 0, 4);
    queue.submit(enc.finish());
    let got = std::gpu::u32s(total_read.map_read(&dev))[0];
    if got == want { println("reduce ok"); } else { println("reduce: {got}, the CPU {want}"); }
    0
}
