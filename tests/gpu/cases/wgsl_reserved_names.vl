// EDITION: rust
// Every name MSL keeps for itself (std::gpu::wgsl::msl's RESERVED and
// type families: macros, typedefs like `quad` and `float4`, keywords) that
// the WGSL front end accepts is a usable identifier: four shaders use each
// as a function, a parameter and a local, a struct and its member, a
// private global, and a compute entry point; Metal compiles them, they
// compute what the interpreter would, and every entry point is found by
// its WGSL name. Names that escaping could map together (`quad`,
// `quad_`, `_quad`, `u_quad_`) are there too.
// EXPECT: names ok
// EXPECT: functions ok
// EXPECT: structs ok
// EXPECT: globals ok
// EXPECT: entries ok
// NO-LEAKS: a long shader; leaks is run by the other wgsl cases

use std::cmp; use std::gpu;
use std::gpu::BufferUsage; use std::gpu::wgsl;
use std::gpu::wgsl::msl;

const EXTRA: [&[u8]; 8] = [b"quad_", b"_quad", b"u_quad_", b"_quad_", b"uu_quad_", b"float4_",
    b"x_1", b"q"];

// Whether the front end takes n as a function, struct, member and local.
fn accepted(n: &[u8], gpa: Gpa) -> bool {
    let mut src = String::new_in(gpa);
    { let n = str::from_utf8(n).unwrap();
        std::fmt::write(&mut src,
            "struct {n} {{ {n}: f32 }}\nfn f(x: f32) -> f32 {{ let {n} = x; return {n}; }}\n").unwrap() };
    { let n = str::from_utf8(n).unwrap();
        std::fmt::write(&mut src, "fn g(x: {n}) -> f32 {{ return x.{n}; }}\n").unwrap() };
    let mut code = Vec::<u8, Gpa>::new_in(gpa);
    let mut refl = wgsl::new_reflection(gpa);
    let mut err = wgsl::new_error(gpa);
    if !wgsl::translate(src.as_bytes(), wgsl::options(wgsl::TARGET_CHECK), &mut code, &mut refl,
        &mut err, gpa) {
        return false;
    }
    let mut src2 = String::new_in(gpa);
    { let n = str::from_utf8(n).unwrap();
        std::fmt::write(&mut src2,
            "var<private> {n}: f32;\n@compute @workgroup_size(1) fn {n}2() {{ {n} = 1.0; }}\n").unwrap() };
    { let n = str::from_utf8(n).unwrap();
        std::fmt::write(&mut src2, "fn h({n}: f32) -> f32 {{ return {n}; }}\n").unwrap() };
    wgsl::translate(src2.as_bytes(), wgsl::options(wgsl::TARGET_CHECK), &mut code, &mut refl,
        &mut err, gpa)
}

const HEAD: &str = "@group(0) @binding(0) var<storage, read_write> xs: array<f32>;\n";

// A shader's result, xs[0], after one dispatch of its entry `run`.
fn run(dev: &gpu::Device<Gpa>, queue: &mut gpu::Queue, src: &str, gpa: Gpa) -> f32 {
    let shader = match dev.shader_wgsl(src) {
        Ok(s) => s,
        Err(e) => {
            let m = format_in("{e}", gpa);
            println("shader: {}",
                &str::from_utf8(m.as_bytes()[0..cmp::min(m.len(), 400usize)]).unwrap());
            return -1.0;
        }
    };
    let pipe = dev.compute_pipeline(&shader, "run").unwrap();
    let mut buf = dev.buffer(16, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    let mut buf_read = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let group = dev.bind_group(pipe.bind_layout(0), &[gpu::bind(0, &buf)][..]);
    let mut enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(&pipe);
        pass.set_bind_group(0, &group);
        pass.dispatch(1);
    });
    enc.copy_buffer(&buf, 0, &buf_read, 0, 16);
    queue.submit(enc.finish());
    gpu::f32s(buf_read.map_read(dev))[0]
}

fn report(what: &[u8], got: f32, want: i64) {
    if got == want as f32 {
        println("{what} ok", what = str::from_utf8(what).unwrap());
    } else {
        println("{what}: {got}, want {want}", what = str::from_utf8(what).unwrap());
    }
}

fn main(gpa: Gpa) -> i32 {
    // the names: every reserved one the front end takes, and EXTRA
    let mut names: Vec<String<Gpa>, Gpa> = Vec::new_in(gpa);
    let mut nb = String::new_in(gpa);
    let mut rejected: i64 = 0;
    for i in 0..msl::reserved_count() {
        msl::reserved_name(i, &mut nb);
        if !msl::is_reserved(nb.as_bytes()) || nb.as_bytes()[nb.len() - 1] == b'_' {
            println("table: {}", str::from_utf8(nb.as_bytes()).unwrap());
        }
        // (the families' bare bases are C++ keywords too: once)
        let mut seen = false;
        for k in 0..names.len() {
            if names[k].as_bytes() == nb.as_bytes() {
                seen = true;
            }
        }
        if seen {
            continue;
        }
        if accepted(nb.as_bytes(), gpa) {
            names.push(nb.clone());
        } else {
            rejected += 1;
        }
    }
    for e in EXTRA {
        names.push(String::from_utf8_lossy_in(e, gpa));
    }
    // most are WGSL identifiers (the front end rejects its own keywords)
    if names.len() > 1500 && rejected < 100 {
        println("names ok");
    } else {
        println("names: {} taken, {rejected} rejected", names.len());
    }
    let inst = gpu::Instance::new_in(gpa);
    let (dev, mut queue) = inst.adapter().unwrap().device().unwrap();
    let count = names.len();

    // functions, parameters, locals: each fn adds 1
    let mut f = String::from_in(HEAD, gpa);
    for i in 0..count {
        let n = names[i].as_bytes();
        { let n = str::from_utf8(n).unwrap();
            std::fmt::write(&mut f, "fn {n}(x: f32) -> f32 {{ return x + 1.0; }}\n").unwrap() };
        { let n = str::from_utf8(n).unwrap(); std::fmt::write(&mut f, "fn h{i}({n}: f32) -> f32 {{ var r = {n}; {{ let {n} = r * 1.0; r = {n}; }} return r; }}\n").unwrap() };
    }
    f.push_str("@compute @workgroup_size(1) fn run() {\n    var acc = 0.0;\n");
    for i in 0..count {
        std::fmt::write(&mut f, "    acc = h{i}({}(acc));\n",
            str::from_utf8(names[i].as_bytes()).unwrap()).unwrap();
    }
    f.push_str("    xs[0] = acc;\n}\n");
    report(b"functions", run(&dev, &mut queue, f.as_str(), gpa), count as i64);

    // structs and their members, a local of each struct's name after it
    let mut s = String::from_in(HEAD, gpa);
    for i in 0..count {
        let n = names[i].as_bytes();
        { let n = str::from_utf8(n).unwrap();
            std::fmt::write(&mut s, "struct {n} {{ {n}: f32, v: vec3<f32> }}\n").unwrap() };
        // (a function each: Metal compiles one long body far slower)
        { let n = str::from_utf8(n).unwrap(); std::fmt::write(&mut s, "fn u{i}() -> f32 {{ var s: {n}; s.{n} = 1.0; let {n} = s.{n} + s.v.x; var t = s; t.v = vec3<f32>({n}); return t.v.y; }}\n").unwrap() };
    }
    s.push_str("@compute @workgroup_size(1) fn run() {\n    var acc = 0.0;\n");
    for i in 0..count {
        std::fmt::write(&mut s, "    acc = acc + u{i}();\n").unwrap();
    }
    s.push_str("    xs[0] = acc;\n}\n");
    report(b"structs", run(&dev, &mut queue, s.as_str(), gpa), count as i64);

    // private globals
    let mut g = String::from_in(HEAD, gpa);
    for i in 0..count {
        std::fmt::write(&mut g, "var<private> {}: f32 = 1.0;\n",
            str::from_utf8(names[i].as_bytes()).unwrap()).unwrap();
    }
    g.push_str("@compute @workgroup_size(1) fn run() {\n    var acc = 0.0;\n");
    for i in 0..count {
        std::fmt::write(&mut g, "    acc = acc + {};\n",
            str::from_utf8(names[i].as_bytes()).unwrap()).unwrap();
    }
    g.push_str("    xs[0] = acc;\n}\n");
    report(b"globals", run(&dev, &mut queue, g.as_str(), gpa), count as i64);

    // entry points, found by their WGSL names
    let mut e = String::from_in(HEAD, gpa);
    for i in 0..count {
        std::fmt::write(&mut e, "@compute @workgroup_size(1) fn {}() {{ xs[0] = {i}.0; }}\n",
            str::from_utf8(names[i].as_bytes()).unwrap()).unwrap();
    }
    match dev.shader_wgsl(e.as_str()) {
        Ok(shader) => {
            let mut missing: i64 = 0;
            for i in 0..count {
                match dev.compute_pipeline(&shader, names[i].as_str()) {
                    Ok(_) => {}
                    Err(_) => {
                        missing += 1;
                    }
                }
            }
            if missing == 0 { println("entries ok"); }
            else { println("entries: {missing} missing"); }
        }
        Err(err) => {
            let m = format_in("{err}", gpa);
            println("entries: {}",
                &str::from_utf8(m.as_bytes()[0..cmp::min(m.len(), 400usize)]).unwrap());
        }
    }
    0
}
