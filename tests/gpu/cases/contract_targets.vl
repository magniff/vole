// A pipeline of one color target in a pass of two color attachments:
// gpu.format at set_pipeline, naming both counts (0.25.2.1).
// EXIT: 101
// STDERR: contract_targets.vl:28:9: gpu.format: the pipeline has 1 color targets and the pass 2 color attachments

use std::gpu::{Format, PassDesc, TextureUsage};

const SHADER: [u8] = "@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n\
    return vec4<f32>(f32(i), 0.0, 0.0, 1.0);\n\
    }\n\
    @fragment fn fs() -> @location(0) vec4<f32> { return vec4<f32>(1.0); }\n";

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let shader = dev.shader_wgsl(SHADER).unwrap();
    let pipe = dev.render_pipeline(
        std::gpu::RenderDesc::new(shader, "vs", "fs", Format::Rgba8Unorm)).unwrap();
    let a = dev.texture(SIZE, SIZE, Format::Rgba8Unorm, usage: TextureUsage::RENDER_ATTACHMENT);
    let b = dev.texture(SIZE, SIZE, Format::Rgba8Unorm, usage: TextureUsage::RENDER_ATTACHMENT);
    let av = a.view();
    let bv = b.view();
    var enc = dev.encoder();
    enc.render_pass(PassDesc::color(av).with_color(bv), |pass| {
        // a second target for the second attachment would be
        // desc.target(Format::Rgba8Unorm) before render_pipeline
        pass.set_pipeline(pipe);
    });
    queue.submit(enc.finish());
    println("not reached");
    0
}
