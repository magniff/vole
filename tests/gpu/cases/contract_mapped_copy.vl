// (0.25.3, the round 3 eval's ocean) A copy into a buffer mapped for
// reading: map_read keeps the buffer mapped until unmap, so the copy
// that would change the view under the program stops where it is
// recorded (gpu.state), naming the argument; before, `v` read 1, then 2.
// EXIT: 101
// STDERR: contract_mapped_copy.vl:25:5: gpu.state: copy_buffer's destination, its third argument (a buffer of 16 bytes), is mapped (map_read): the copy would change its view. Unmap it (buf.unmap(dev)) when its view is done, or read a copy (map_read_copy_in)

use std::gpu;
use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter()?.device()?;
    let one: [f32] = [1.0, 1.0, 1.0, 1.0];
    let two: [f32] = [2.0, 2.0, 2.0, 2.0];
    let a = dev.buffer_init(gpu::bytes_of_f32(one), BufferUsage::COPY_SRC);
    let b = dev.buffer_init(gpu::bytes_of_f32(two), BufferUsage::COPY_SRC);
    var r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.copy_buffer(a, 0, r, 0, 16);
    queue.submit(enc.finish());
    let v = gpu::f32s(r.map_read(dev));
    let before = v[0];
    var enc2 = dev.encoder();
    enc2.copy_buffer(b, 0, r, 0, 16);
    queue.submit(enc2.finish());
    dev.wait_idle();
    let after = v[0];
    println("before {before}, after {after}");
    Ok(())
}
