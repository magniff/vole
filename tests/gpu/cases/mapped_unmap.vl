// (0.25.3) map_read, unmap, then copy into the buffer again: two
// separate reads, each view unchanged while it lives. map_read_copy_in
// maps, copies and unmaps by itself: a copy into the buffer right after
// it is fine. Mapping again while mapped is fine too.
// EXPECT: before 1, after 2
// EXPECT: copied 2, then 3
// EXPECT: again 3 3

use std::gpu;
use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter()?.device()?;
    let one: [f32] = [1.0, 1.0, 1.0, 1.0];
    let two: [f32] = [2.0, 2.0, 2.0, 2.0];
    let three: [f32] = [3.0, 3.0, 3.0, 3.0];
    let a = dev.buffer_init(gpu::bytes_of_f32(one), BufferUsage::COPY_SRC);
    let b = dev.buffer_init(gpu::bytes_of_f32(two), BufferUsage::COPY_SRC);
    let c = dev.buffer_init(gpu::bytes_of_f32(three), BufferUsage::COPY_SRC);
    var r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.copy_buffer(a, 0, r, 0, 16);
    queue.submit(enc.finish());
    let v = gpu::f32s(r.map_read(dev));
    let before = v[0];
    r.unmap(dev); // v is done
    var enc2 = dev.encoder();
    enc2.copy_buffer(b, 0, r, 0, 16);
    queue.submit(enc2.finish());
    let after = gpu::f32s(r.map_read(dev))[0];
    println("before {before}, after {after}");
    r.unmap(dev);

    let copy = r.map_read_copy_in(dev, gpa); // maps, copies, unmaps
    var enc3 = dev.encoder();
    enc3.copy_buffer(c, 0, r, 0, 16);
    queue.submit(enc3.finish());
    let now = gpu::f32s(r.map_read(dev))[0];
    println("copied {}, then {now}", gpu::f32s(copy.as_slice())[0]);
    let again = gpu::f32s(r.map_read(dev))[1];
    println("again {now} {again}");
    Ok(())
}
