// More workgroups in a dimension than the device takes: gpu.limits names
// the limit as a program reads it (dev.limits().max_compute_workgroups_per_dimension)
// and what to do (0.25.2.2; before: `workgroups per dimension: x = 65536,
// self.max_groups = 65535`).
// EXIT: 101
// STDERR: contract_limits_dispatch.vl:25:9: gpu.limits: a dispatch of 65536 workgroups in one dimension; at most 65535 (dev.limits().max_compute_workgroups_per_dimension, the device's own, which device(lim) cannot raise)

use std::gpu::BufferUsage;

const KERNEL: [u8] = "@group(0) @binding(0) var<storage, read_write> xs: array<u32>;\n\
    @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    xs[id.x] = id.x;\n\
    }\n";

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter().unwrap().device().unwrap();
    let pipe = dev.compute_pipeline(dev.shader_wgsl(KERNEL).unwrap(), "main").unwrap();
    let xs = dev.buffer(256, BufferUsage::STORAGE);
    let group = dev.bind_group(pipe.bind_layout(0), [std::gpu::bind(0, xs)][..]);
    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(65536);
    });
    queue.submit(enc.finish());
    0
}
