// Every format Format::is_storable says is storable is one the WGSL
// translator takes as a texture_storage_2d (0.25.2.2: rgba16float,
// rgba8uint and rg32float were storable to std and refused by the
// translator): a kernel writes one texel of each, copied back and
// compared bytewise. And a format that is not storable is refused by
// both (r8unorm).
// EXPECT: r32uint 07000000
// EXPECT: r32sint fdffffff
// EXPECT: r32float 0000003f
// EXPECT: rgba8unorm ff00ff00
// EXPECT: rgba8uint 01020304
// EXPECT: rg32float 0000003f0000803f
// EXPECT: rgba16float 0038003c00c00034
// EXPECT: rgba32uint 01000000020000000300000004000000
// EXPECT: rgba32float 0000003f0000803f000000c00000803e
// EXPECT: r8unorm storable false

use std::gpu::{BufferUsage, Format, TextureUsage};

const FORMATS: [Format; 10] = [
    Format::R32Uint, Format::R32Sint, Format::R32Float, Format::Rgba8Unorm, Format::Rgba8Uint,
    Format::Rg32Float, Format::Rgba16Float, Format::Rgba32Uint, Format::Rgba32Float,
    Format::R8Unorm,
];

const NAMES: [[u8]; 10] = [
    "r32uint", "r32sint", "r32float", "rgba8unorm", "rgba8uint", "rg32float", "rgba16float",
    "rgba32uint", "rgba32float", "r8unorm",
];

// The value each format's kernel stores.
fn value(name: [u8]) -> [u8] {
    if name == "r32uint" { return "vec4<u32>(7u, 0u, 0u, 0u)"; }
    if name == "rgba8uint" { return "vec4<u32>(1u, 2u, 3u, 4u)"; }
    if name == "rgba32uint" { return "vec4<u32>(1u, 2u, 3u, 4u)"; }
    if name == "r32sint" { return "vec4<i32>(-3, 0, 0, 0)"; }
    if name == "rgba8unorm" { return "vec4<f32>(1.0, 0.0, 1.0, 0.0)"; }
    "vec4<f32>(0.5, 1.0, -2.0, 0.25)"
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    for i in 0..FORMATS.len() {
        let f = FORMATS[i];
        let name = NAMES[i];
        if !f.is_storable() {
            println("{name} storable false");
            let src = format_in(
                "@group(0) @binding(0) var t: texture_storage_2d<{name}, write>;\n@compute @workgroup_size(1) fn main() {{ textureStore(t, vec2<i32>(0, 0), {}); }}\n", value(name),
                gpa);
            match dev.shader_wgsl(src.as_slice()) {
                Ok(_) => println("{name}: the translator takes a format is_storable refuses"),
                Err(_) => {}
            }
            continue;
        }
        let src = format_in(
            "@group(0) @binding(0) var t: texture_storage_2d<{name}, write>;\n@compute @workgroup_size(1) fn main() {{ textureStore(t, vec2<i32>(0, 0), {}); }}\n", value(name),
            gpa);
        let shader = match dev.shader_wgsl(src.as_slice()) {
            Ok(s) => s,
            Err(e) => {
                println("{name}: is_storable, and the translator refuses it: {e}");
                continue;
            }
        };
        let pipe = dev.compute_pipeline(shader, "main").unwrap();
        let tex = dev.texture(4, 4, f,
            usage: TextureUsage::STORAGE_BINDING | TextureUsage::COPY_SRC);
        var rb = dev.buffer(256 * 4, BufferUsage::COPY_DST | BufferUsage::MAP_READ);
        let group = dev.bind_group(pipe.bind_layout(0),
            [std::gpu::bind_texture(0, tex.view())][..]);
        var enc = dev.encoder();
        enc.compute_pass(|pass| {
            pass.set_pipeline(pipe);
            pass.set_bind_group(0, group);
            pass.dispatch(1);
        });
        enc.copy_texture_to_buffer(tex, rb, 256);
        queue.submit(enc.finish());
        let px = rb.map_read(dev);
        print("{name} ");
        for k in 0..f.size() {
            print("{:02x}", px[k]);
        }
        println("");
    }
    0
}
