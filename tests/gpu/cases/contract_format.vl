// A pipeline drawing Bgra8Unorm in a pass whose target is Rgba8Unorm: the
// gpu.format contract.
// EXIT: 101
// STDERR: gpu.format:

use std::gpu::Color; use std::gpu::Format; use std::gpu::Limits; use std::gpu::Load;
use std::gpu::{PassDesc, Power};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter(Power::High).unwrap();
    let (dev, mut queue) = adapter.device(Limits::default()).unwrap();
    let mut shader = rect_shader(&dev, gpa);
    let mut desc = std::gpu::RenderDesc::new(&shader, "vs", "fs", Format::Bgra8Unorm);
    desc.vertex_buffer(rect_layout());
    let mut pipe = dev.render_pipeline(desc).unwrap();
    let mut tex = target(&dev);
    let mut view = tex.view();
    let mut enc = dev.encoder();
    enc.render_pass(PassDesc::color(&view, Color::black(), Load::Clear), |pass| {
        pass.set_pipeline(&pipe);
    });
    println("not reached");
    0
}
