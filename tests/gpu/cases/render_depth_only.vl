// EDITION: rust
// A depth-only pass (0.25.2.1), a shadow map's: no color attachment
// (PassDesc::depth_only) and a pipeline with no fragment stage and no
// color target (RenderDesc::depth_only). Two quads, the nearer drawn
// first, so the depth test (Less) must reject part of the second; the
// depth texture is read back and compared exactly: the left half 0.25,
// the bottom right 0.75, the top right the clear value 1.0.
// EXPECT: depth only ok: 2048 at 0.25, 1024 at 0.75, 1024 at 1.0

use std::gpu::BufferUsage; use std::gpu::Compare; use std::gpu::Format; use std::gpu::Limits;
use std::gpu::PassDesc;
use std::gpu::Power; use std::gpu::StepMode; use std::gpu::TextureUsage;
use std::gpu::VertexFormat; use std::gpu::VertexLayout;

const SHADER: &str = "@vertex fn vs(@location(0) p: vec3<f32>) -> @builtin(position) vec4<f32> {\n\
    return vec4<f32>(p, 1.0);\n\
    }\n";

// two triangles of (x, y, z) for the rectangle x0..x1, y0..y1 at depth z
fn quad(out: &mut Vec<f32, Gpa>, x0: f32, y0: f32, x1: f32, y1: f32, z: f32) {
    let c: [f32; 18] = [x0, y0, z, x1, y0, z, x0, y1, z, x0, y1, z, x1, y0, z, x1, y1, z];
    for v in c {
        out.push(v);
    }
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter(Power::High).unwrap();
    let (dev, mut queue) = adapter.device(Limits::default()).unwrap();
    let shader = dev.shader_wgsl(SHADER).unwrap();
    let mut desc = std::gpu::RenderDesc::depth_only(&shader, "vs", Format::Depth32Float,
        Compare::Less);
    let mut layout = VertexLayout::new(12, StepMode::Vertex);
    layout.attribute(0, VertexFormat::Float32x3, 0);
    desc.vertex_buffer(layout);
    let pipe = dev.render_pipeline(desc).unwrap();
    let mut verts: Vec<f32, Gpa> = Vec::new_in(gpa);
    quad(&mut verts, -1.0, -1.0, 0.0, 1.0, 0.25); // the left half, near
    quad(&mut verts, -1.0, -1.0, 1.0, 0.0, 0.75); // the bottom half, far
    let vb = dev.buffer_init(std::gpu::bytes_of_f32(verts.as_slice()), BufferUsage::VERTEX);
    let shadow = dev.texture(SIZE, SIZE, Format::Depth32Float,
        TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);
    let sview = shadow.view();
    let mut rb = readback(&dev);
    let mut enc = dev.encoder();
    enc.render_pass(PassDesc::depth_only(&sview, 1.0, true), |pass| {
        pass.set_pipeline(&pipe);
        pass.set_vertex_buffer(0, &vb, 0);
        pass.draw(0i64..12i64, 0i64..1i64);
    });
    enc.copy_texture_to_buffer(&shadow, &rb, 256);
    queue.submit(enc.finish());
    let d = std::gpu::f32s(rb.map_read(&dev));
    let mut near: i64 = 0;
    let mut far: i64 = 0;
    let mut clear: i64 = 0;
    let mut bad: i64 = 0;
    for y in 0..SIZE {
        for x in 0..SIZE {
            let want: f32 = if x < 32 { 0.25 } else if y >= 32 { 0.75 } else { 1.0 };
            let got = d[y * 64 + x];
            if got != want {
                if bad < 3 { println("depth at {x},{y}: {got}, want {want}"); }
                bad += 1;
            } else if got == 0.25 {
                near += 1;
            } else if got == 0.75 {
                far += 1;
            } else {
                clear += 1;
            }
        }
    }
    if bad == 0 {
        println("depth only ok: {near} at 0.25, {far} at 0.75, {clear} at 1.0");
    }
    0
}
