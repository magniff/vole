// A depth-only pass (0.25.2.1), a shadow map's: no color attachment
// (PassDesc::depth_only) and a pipeline with no fragment stage and no
// color target (RenderDesc::depth_only). Two quads, the nearer drawn
// first, so the depth test (Less) must reject part of the second; the
// depth texture is read back and compared exactly: the left half 0.25,
// the bottom right 0.75, the top right the clear value 1.0.
// EXPECT: depth only ok: 2048 at 0.25, 1024 at 0.75, 1024 at 1.0

use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage, VertexFormat, VertexLayout};

const SHADER: [u8] = "@vertex fn vs(@location(0) p: vec3<f32>) -> @builtin(position) vec4<f32> {\n\
    return vec4<f32>(p, 1.0);\n\
    }\n";

// two triangles of (x, y, z) for the rectangle x0..x1, y0..y1 at depth z
fn quad(out: inout Vec<f32>, x0: f32, y0: f32, x1: f32, y1: f32, z: f32) {
    let c: [f32; 18] = [x0, y0, z, x1, y0, z, x0, y1, z, x0, y1, z, x1, y0, z, x1, y1, z];
    for v in c {
        out.push(v);
    }
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let shader = dev.shader_wgsl(SHADER).unwrap();
    var desc = std::gpu::RenderDesc::depth_only(shader, "vs");
    var layout = VertexLayout::new(12);
    layout.attribute(0, VertexFormat::Float32x3, 0);
    desc.vertex_buffer(layout);
    let pipe = dev.render_pipeline(desc).unwrap();
    var verts: Vec<f32> = Vec::new_in(gpa);
    quad(&verts, -1.0, -1.0, 0.0, 1.0, 0.25); // the left half, near
    quad(&verts, -1.0, -1.0, 1.0, 0.0, 0.75); // the bottom half, far
    let vb = dev.buffer_init(std::gpu::bytes_of_f32(verts.as_slice()), BufferUsage::VERTEX);
    let shadow = dev.texture(SIZE, SIZE, Format::Depth32Float,
        usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC);
    let sview = shadow.view();
    var rb = readback(dev);
    var enc = dev.encoder();
    enc.render_pass(PassDesc::depth_only(sview), |pass| {
        pass.set_pipeline(pipe);
        pass.set_vertex_buffer(0, vb);
        pass.draw(0..12, 0..1);
    });
    enc.copy_texture_to_buffer(shadow, rb, 256);
    queue.submit(enc.finish());
    let d = std::gpu::f32s(rb.map_read(dev));
    var near = 0;
    var far = 0;
    var clear = 0;
    var bad = 0;
    for y in 0..SIZE {
        for x in 0..SIZE {
            let want: f32 = if x < 32 { 0.25 } else if y >= 32 { 0.75 } else { 1.0 };
            let got = d[y * 64 + x];
            if got != want {
                if bad < 3 { println("depth at {x},{y}: {got}, want {want}"); }
                bad += 1;
            } else if got == 0.25 {
                near += 1;
            } else if got == 0.75 {
                far += 1;
            } else {
                clear += 1;
            }
        }
    }
    if bad == 0 {
        println("depth only ok: {near} at 0.25, {far} at 0.75, {clear} at 1.0");
    }
    0
}
