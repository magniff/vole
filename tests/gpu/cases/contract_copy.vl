// copy_buffer from a buffer made without COPY_SRC: gpu.usage names the
// source buffer (its argument, its size) and the missing usage (0.25.2.1).
// EXIT: 101
// STDERR: gpu.usage: copy_buffer's source, its first argument (a buffer of 512 bytes), was made without BufferUsage::COPY_SRC

use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let src = dev.buffer(512, BufferUsage::STORAGE);
    let dst = dev.buffer(512, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.copy_buffer(src, 0, dst, 0, 512);
    println("not reached");
    0
}
