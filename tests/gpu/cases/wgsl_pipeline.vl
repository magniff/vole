// EDITION: rust
// WGSL straight into pipelines: dev.shader_wgsl translates with
// std::gpu::wgsl and converts its reflection (shader::from_wgsl). A
// compute shader over runtime-sized arrays (its sizes buffer bounds the
// writes), the rect scene drawn by a WGSL render shader whose vec4<f32>
// input is fed by Unorm8x4 (compared exactly with the CPU's image), and a
// rejected shader's error.
// EXPECT: compute ok 0 1 4 9 16 25 36 0
// EXPECT: rects ok
// EXPECT: error 3:12: error wgsl.name
// EXPECT: reflection vs vs fs fs inputs 3 bindings 1

use std::gpu::BufferUsage; use std::gpu::Format; use std::gpu::Limits; use std::gpu::Load;
use std::gpu::{PassDesc, Power};

const COMPUTE: &str = "@group(0) @binding(0) var<storage, read> xs: array<u32>;\n\
    @group(0) @binding(1) var<storage, read_write> ys: array<u32>;\n\
    @compute @workgroup_size(8) fn main(@builtin(global_invocation_id) id: vec3<u32>) {\n\
    ys[id.x] = xs[id.x] * xs[id.x];\n\
    }";

const RECTS: &str = "struct G { size: vec2<f32> }\n\
    @group(0) @binding(0) var<uniform> g: G;\n\
    struct VOut { @builtin(position) pos: vec4<f32>, @location(0) color: vec4<f32> }\n\
    @vertex fn vs(@location(0) pos: vec2<f32>, @location(1) color: vec4<f32>,\n\
    @location(2) z: f32) -> VOut {\n\
    let n = pos / g.size * 2.0 - 1.0;\n\
    return VOut(vec4<f32>(n.x, -n.y, z, 1.0), color);\n\
    }\n\
    @fragment fn fs(v: VOut) -> @location(0) vec4<f32> { return v.color; }";

const BAD: &str = "@fragment\nfn fs() -> @location(0) vec4<f32> {\n    return colour;\n}";

fn compute(dev: &std::gpu::Device<Gpa>, queue: &mut std::gpu::Queue, gpa: Gpa) {
    let shader = dev.shader_wgsl(COMPUTE).unwrap();
    let pipe = dev.compute_pipeline(&shader, "main").unwrap();
    let mut xs: Vec<u32, Gpa> = Vec::new_in(gpa);
    for i in 0..8 {
        xs.push(i as u32);
    }
    let xb = dev.buffer_init(std::gpu::bytes_of_u32(xs.as_slice()), BufferUsage::STORAGE);
    // ys holds 7 of the 8 invocations' writes: the last is skipped
    let mut yb = dev.buffer(8 * 4, BufferUsage::STORAGE | BufferUsage::COPY_SRC);
    let mut yb_read = dev.buffer(8 * 4, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    let group = dev.bind_group(pipe.bind_layout(0),
        &[std::gpu::bind(0, &xb), std::gpu::bind_range(1, &yb, 0, 7 * 4)][..]);
    let mut enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(&pipe);
        pass.set_bind_group(0, &group);
        pass.dispatch(1, 1, 1);
    });
    enc.copy_buffer(&yb, 0, &yb_read, 0, 8 * 4);
    queue.submit(enc.finish());
    let ys = std::gpu::u32s(yb_read.map_read(dev));
    print("compute ok");
    for i in 0..8 {
        let want = if i == 7 { 0 } else { xs[i as usize] * xs[i as usize] };
        if ys[i as usize] != want {
            println(" ys[{i}] = {}, want {want}", ys[i as usize]);
            return;
        }
        print(" {}", ys[i as usize]);
    }
    println("");
}

fn rects(dev: &std::gpu::Device<Gpa>, queue: &mut std::gpu::Queue, gpa: Gpa) {
    let shader = dev.shader_wgsl(RECTS).unwrap();
    let mut desc = std::gpu::RenderDesc::new(&shader, "vs", "fs", Format::Rgba8Unorm);
    desc.vertex_buffer(rect_layout());
    let pipe = dev.render_pipeline(desc).unwrap();
    let scene = scene_rects();
    let mut verts = rect_vertices(scene[..], gpa);
    let vb = dev.buffer_init(verts.as_slice(), BufferUsage::VERTEX);
    let g = globals(dev);
    let group = dev.bind_group(pipe.bind_layout(0), &[std::gpu::bind(0, &g)][..]);
    let tex = target(dev);
    let view = tex.view();
    let mut rb = readback(dev);
    let n: i64 = 6 * 6;
    let mut enc = dev.encoder();
    enc.render_pass(PassDesc::color(&view, clear: clear_color(), load: Load::Clear), |pass| {
        pass.set_pipeline(&pipe);
        pass.set_bind_group(0, &group);
        pass.set_vertex_buffer(0, &vb, 0);
        pass.draw(0i64..n, 0i64..1i64);
    });
    enc.copy_texture_to_buffer(&tex, &rb, 256);
    queue.submit(enc.finish());
    let px = rb.map_read(dev);
    if check_image(px, SIZE, SIZE, 256, "tests/gpu/ref/rects.ppm", 0, 0, gpa) {
        println("rects ok");
    }
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter(Power::High).unwrap();
    let (dev, mut queue) = adapter.device(Limits::default()).unwrap();
    compute(&dev, &mut queue, gpa);
    rects(&dev, &mut queue, gpa);
    match dev.shader_wgsl(BAD) {
        Ok(_) => println("compiled?"),
        Err(e) => {
            let text = format_in("{e}", gpa);
            let msg = text.as_str();
            let at = "gpu: the shader did not compile: ".len();
            println("error {}", &msg[at..at + 21]);
        }
    }
    // the reflection as std::gpu keeps it
    let mut code = std::vec::Vec::<u8, Gpa>::new_in(gpa);
    let mut refl = std::gpu::wgsl::new_reflection(gpa);
    let mut err = std::gpu::wgsl::new_error(gpa);
    let _ = std::gpu::wgsl::translate(RECTS.as_bytes(),
        std::gpu::wgsl::options(std::gpu::wgsl::TARGET_MSL), &mut code, &mut refl, &mut err, gpa);
    let r = std::gpu::shader::from_wgsl(&refl, gpa).ok().unwrap();
    print("reflection");
    for e in r.entries.iter().copied() {
        print(" {} {}", e.name, e.native);
    }
    println(" inputs {} bindings {}", r.inputs.len(), r.bindings.len());
    0
}
