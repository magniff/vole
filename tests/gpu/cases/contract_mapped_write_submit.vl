// (0.25.3) The same for a write mapping: a copy from a buffer recorded
// before its map_write, submitted while it is mapped, would read it
// while the CPU writes it: queue.submit stops (gpu.state).
// EXIT: 101
// STDERR: contract_mapped_write_submit.vl:19:5: gpu.state: these commands copy from a buffer of 16 bytes that was mapped for writing (map_write) after the copy was recorded: unmap it (buf.unmap(dev)) before submitting, which sends what was written

use std::gpu;
use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter()?.device()?;
    var w = dev.buffer(16, BufferUsage::MAP_WRITE | BufferUsage::COPY_SRC);
    let dst = dev.buffer(16, BufferUsage::STORAGE | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.copy_buffer(w, 0, dst, 0, 16);
    let p = gpu::f32s_mut(w.map_write(dev));
    p[0] = 3.0;
    queue.submit(enc.finish());
    println("not reached");
    Ok(())
}
