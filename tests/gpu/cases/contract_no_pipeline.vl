// (0.28.0, gap 108) A dispatch with no pipeline set: gpu.pipeline is a
// `requires` of dispatch and draw, so the stop names the caller's line.
// EXIT: 101
// STDERR: contract_no_pipeline.vl:14:9: gpu.pipeline: set a pipeline before drawing or dispatching

use std::gpu::{Limits, Power};

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter(Power::High).unwrap();
    let (dev, mut queue) = adapter.device(Limits::default()).unwrap();
    let mut enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.dispatch(4, 1, 1);
    });
    println("not reached");
    0
}
