// An Objective-C exception through vole frames ends the process (no
// vole frame catches it: a crash, not undefined behaviour), after
// objc::init's handler printed its name and reason.
// EXIT: 134
// STDERR: objc: uncaught exception NSRangeException
// EDITION: rust

use std::objc;
use std::objc::foundation::{NSArray, NSArrayMethods};

fn main(gpa: Gpa) -> i32 {
    objc::init();
    objc::framework("Metal");
    // MTLCopyAllDevices: a +1 NSArray of the system's devices
    // UNSAFE: symbol takes a C string.
    // SAFETY: the name is a NUL-terminated c"" literal.
    let f = unsafe { objc::symbol(c"MTLCopyAllDevices") };
    // UNSAFE: a symbol's address read as a function pointer (a union field).
    // SAFETY: MTLCopyAllDevices is Metal's (opened above), `NSArray *MTLCopyAllDevices(void)`.
    let raw = unsafe { CFn0 { p: f }.f };
    // UNSAFE: a call through a C function pointer, its result taken over as a +1 object.
    // SAFETY: raw is that function; a Copy function returns a +1 NSArray (or nil).
    let all = unsafe { objc::Id::<NSArray>::from_owned_or_nil(raw()) };
    let n = all.r().count();
    let x = all.r().object_at_index(n + 5);
    println("not reached {}", x.is_nil());
    0
}

#[repr(C)]
union CFn0 {
    p: *mut u8,
    f: extern "C" fn() -> *mut u8,
}
