// A shader dev.shader_wgsl cannot use is an Err, never a panic, and says
// where in the WGSL: Metal's message on the translation is mapped back to
// the WGSL function it is in (wgsl::target_error, from the reflection's
// lines); what the shader asks beyond the device (17 runtime-sized
// bindings) is Error::Shader too. A helper named like a Metal type
// (`quad`) compiles.
// EXPECT: mapped 3:6: error wgsl.target: Metal rejected the translation of fn b: use of undeclared identifier 'zz' (MSL 12:5)
// EXPECT: header false
// EXPECT: limits gpu: the shader did not compile: gpu.limits: 17 runtime-sized storage bindings; at most 16 (the sizes buffer)
// EXPECT: quad 16

use std::gpu::BufferUsage;

const TWO: [u8] = "fn a(x: f32) -> f32 { return x; }\n\n  fn b(x: f32) -> f32 { return x * 2.0; }\n@group(0) @binding(0) var<storage, read_write> xs: array<f32>;\n@compute @workgroup_size(1) fn main() { xs[0] = b(a(xs[0])); }\n";

const QUAD: [u8] = "@group(0) @binding(0) var<storage, read_write> xs: array<f32>;\n\
    fn quad(x: f32) -> f32 { return x * x * x * x; }\n\
    @compute @workgroup_size(1) fn main() { xs[0] = quad(2.0); }\n";

fn main(gpa: Gpa) -> i32 {
    // the mapping, on a log as Metal writes it (MSL line 12 is in b's body)
    var code = Buf::new_in(gpa);
    var refl = std::gpu::wgsl::new_reflection(gpa);
    var err = std::gpu::wgsl::new_error(gpa);
    let _ = std::gpu::wgsl::translate(TWO, std::gpu::wgsl::options(std::gpu::wgsl::TARGET_MSL),
        &code, &refl, &err, gpa);
    var m = Buf::new_in(gpa);
    let log = "program_source:12:5: error: use of undeclared identifier 'zz'\n    zz;\n    ^\n";
    if std::gpu::wgsl::target_error(TWO, refl, log, &m) {
        println(f"mapped {m.as_slice()}");
    } else {
        println("not mapped");
    }
    var h = Buf::new_in(gpa);
    let in_header = "program_source:2:10: error: 'x.h' file not found\n";
    println(f"header {std::gpu::wgsl::target_error(TWO, refl, in_header, &h)}");

    let inst = std::gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter().unwrap().device().unwrap();
    // 17 runtime-sized storage buffers: one more than the sizes buffer holds
    var many = Buf::new_in(gpa);
    for i in 0..17 {
        many.push_fmt(f"@group(0) @binding({i}) var<storage, read_write> b{i}: array<u32>;\n");
    }
    many.push_str("@compute @workgroup_size(1) fn main() {\n");
    for i in 0..17 {
        many.push_fmt(f"    b{i}[0] = 1u;\n");
    }
    many.push_str("}\n");
    match dev.shader_wgsl(many.as_slice()) {
        Ok(_) => println("limits: compiled?"),
        Err(e) => println(f"limits {e}"),
    }
    // the helper named like Metal's `quad` typedef
    let shader = dev.shader_wgsl(QUAD).unwrap();
    let pipe = dev.compute_pipeline(shader, "main").unwrap();
    var buf = dev.buffer(16, BufferUsage::STORAGE | BufferUsage::MAP_READ);
    let group = dev.bind_group(pipe.bind_layout(0), [std::gpu::bind(0, buf)][..]);
    var enc = dev.encoder();
    enc.compute_pass(|pass| {
        pass.set_pipeline(pipe);
        pass.set_bind_group(0, group);
        pass.dispatch(1);
    });
    queue.submit(enc.finish());
    println(f"quad {std::gpu::f32s(buf.map_read(dev))[0]}");
    0
}
