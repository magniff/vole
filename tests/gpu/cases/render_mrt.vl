// Multiple render targets (0.25.2.1): one pass, three color attachments
// of three formats (Rgba8Unorm, R32Float, R32Uint), written by one
// fragment shader at @location(0..2); each read back and compared, texel
// by texel, with what the shader computes from the texel's position. One
// readback returns its bytes from the function that owns the buffer
// (map_read_copy_in).
// EXPECT: mrt ok: 3 targets, 4096 texels each

use std::gpu::{BufferUsage, Format, PassDesc, TextureUsage};

const SHADER: [u8] = "struct Out {\n\
    @location(0) color: vec4<f32>,\n\
    @location(1) x: f32,\n\
    @location(2) id: u32,\n\
    }\n\
    @vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {\n\
    var p = vec2<f32>(-1.0, -1.0);\n\
    if (i == 1u) { p = vec2<f32>(3.0, -1.0); }\n\
    if (i == 2u) { p = vec2<f32>(-1.0, 3.0); }\n\
    return vec4<f32>(p, 0.0, 1.0);\n\
    }\n\
    @fragment fn fs(@builtin(position) pos: vec4<f32>) -> Out {\n\
    let x = u32(pos.x);\n\
    let y = u32(pos.y);\n\
    var o: Out;\n\
    o.color = vec4<f32>(1.0, 0.0, select(0.0, 1.0, x < 32u), 1.0);\n\
    o.x = pos.x + 1000.0 * pos.y;\n\
    o.id = x * 7u + y * 1000u + 3u;\n\
    return o;\n\
    }\n";

fn texture(dev: std::gpu::Device, format: Format) -> std::gpu::Texture {
    dev.texture(SIZE, SIZE, format, usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC)
}

// The bytes of a SIZE x SIZE texture of 4-byte texels, rows 256 bytes
// apart: a copy, so they outlive the readback buffer made here.
fn texels_of(dev: std::gpu::Device, queue: inout std::gpu::Queue, tex: std::gpu::Texture,
    gpa: Gpa) -> Vec<u8> {
    var rb = readback(dev);
    var enc = dev.encoder();
    enc.copy_texture_to_buffer(tex, rb, 256);
    queue.submit(enc.finish());
    rb.map_read_copy_in(dev, gpa)
}

fn main(gpa: Gpa) -> i32 {
    let inst = std::gpu::Instance::new_in(gpa);
    let adapter = inst.adapter().unwrap();
    let (dev, var queue) = adapter.device().unwrap();
    let shader = dev.shader_wgsl(SHADER).unwrap();
    var desc = std::gpu::RenderDesc::new(shader, "vs", "fs", Format::Rgba8Unorm);
    desc.target(Format::R32Float);
    desc.target(Format::R32Uint);
    let pipe = dev.render_pipeline(desc).unwrap();
    let t0 = texture(dev, Format::Rgba8Unorm);
    let t1 = texture(dev, Format::R32Float);
    let t2 = texture(dev, Format::R32Uint);
    let v0 = t0.view();
    let v1 = t1.view();
    let v2 = t2.view();
    var enc = dev.encoder();
    enc.render_pass(PassDesc::color(v0).with_color(v1).with_color(v2), |pass| {
        pass.set_pipeline(pipe);
        pass.draw(0..3, 0..1);
    });
    queue.submit(enc.finish());
    let b0 = texels_of(dev, &queue, t0, gpa);
    let b1 = texels_of(dev, &queue, t1, gpa);
    let b2 = texels_of(dev, &queue, t2, gpa);
    let xs = std::gpu::f32s(b1.as_slice());
    let ids = std::gpu::u32s(b2.as_slice());
    var bad = 0;
    for y in 0..SIZE {
        for x in 0..SIZE {
            let o = y * 256 + x * 4;
            let blue: u8 = if x < 32 { 255 } else { 0 };
            if b0[o] != 255 || b0[o + 1] != 0 || b0[o + 2] != blue || b0[o + 3] != 255 {
                if bad < 3 { println(f"target 0 at {x},{y}: {b0[o]} {b0[o + 1]} {b0[o + 2]}"); }
                bad += 1;
            }
            let want_x = x as f32 + 0.5 + 1000.0 * (y as f32 + 0.5);
            if xs[o / 4] != want_x {
                if bad < 3 { println(f"target 1 at {x},{y}: {xs[o / 4]}, want {want_x}"); }
                bad += 1;
            }
            let want_id = (x * 7 + y * 1000 + 3) as u32;
            if ids[o / 4] != want_id {
                if bad < 3 { println(f"target 2 at {x},{y}: {ids[o / 4]}, want {want_id}"); }
                bad += 1;
            }
        }
    }
    if bad == 0 {
        println(f"mrt ok: 3 targets, {SIZE * SIZE} texels each");
    }
    0
}
