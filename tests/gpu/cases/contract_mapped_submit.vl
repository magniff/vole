// (0.25.3) A copy recorded while its destination was not mapped, then
// submitted after a map_read of it: the write happens at the submit, so
// queue.submit stops (gpu.state; the map state is the native buffer's,
// which the recorded commands see), and the view never changes.
// EXIT: 101
// STDERR: contract_mapped_submit.vl:26:5: gpu.state: these commands copy into a buffer of 16 bytes that was mapped (map_read) after the copy was recorded: the copy would change its view. Unmap it (buf.unmap(dev)) when its view is done, or read a copy (map_read_copy_in)

use std::gpu;
use std::gpu::BufferUsage;

fn main(gpa: Gpa) -> Result<(), gpu::Error> {
    let inst = gpu::Instance::new_in(gpa);
    let (dev, var queue) = inst.adapter()?.device()?;
    let one: [f32] = [1.0, 1.0, 1.0, 1.0];
    let two: [f32] = [2.0, 2.0, 2.0, 2.0];
    let a = dev.buffer_init(gpu::bytes_of_f32(one), BufferUsage::COPY_SRC);
    let b = dev.buffer_init(gpu::bytes_of_f32(two), BufferUsage::COPY_SRC);
    var r = dev.buffer(16, BufferUsage::MAP_READ | BufferUsage::COPY_DST);
    var enc = dev.encoder();
    enc.copy_buffer(a, 0, r, 0, 16);
    queue.submit(enc.finish());
    var enc2 = dev.encoder();
    enc2.copy_buffer(b, 0, r, 0, 16); // r is not mapped yet
    let v = gpu::f32s(r.map_read(dev));
    let before = v[0];
    queue.submit(enc2.finish());
    dev.wait_idle();
    println("before {before}, after {}", v[0]);
    Ok(())
}
