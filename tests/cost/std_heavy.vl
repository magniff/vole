// The std-heavy program of the gate's compile-cost row
// (tests/compile_cost.sh: std): text, collections, iterators, formatting
// and a file, so that most of std's sections are read, checked and
// emitted. Written in what the previous release compiles too: the row
// builds it with both.
use std::fs;
use std::collections::{HashMap, HashSet};
use std::default::DefaultIn;
use std::string::String;

fn main(gpa: Gpa) -> i32 {
    let text = "the quick brown fox jumps over the lazy dog\nthe dog sleeps, the fox runs\n";
    let mut counts: HashMap<&str, i64, Gpa, FixedState> = DefaultIn::default_in(gpa);
    let mut by_len: HashMap<usize, i64, Gpa, FixedState> = DefaultIn::default_in(gpa);
    let mut order: HashSet<i64, Gpa, FixedState> = DefaultIn::default_in(gpa);
    let mut words: Vec<&str, Gpa> = Vec::new_in(gpa);
    let mut lens: Vec<usize, Gpa> = Vec::new_in(gpa);
    for line in text.lines() {
        for w in line.split_whitespace() {
            let w = w.trim_matches(',');
            *counts.entry(w).or_insert(0) += 1;
            *by_len.entry(w.len()).or_insert(0) += 1;
            words.push(w);
            lens.push(w.len());
        }
    }
    words.sort();
    let mut out = String::new_in(gpa);
    for i in 0..words.len() {
        let w = words[i];
        order.insert(w.len() as i64);
        out.push_str(w);
        out.push(' ');
        let row = format_in(" {}:{} {:.2}\n", w.len(), w.to_uppercase_in(gpa), 1.5 * i as f64, gpa);
        out.push_str(row.as_str());
    }
    let mut long = 0;
    let mut total: usize = 0;
    for n in lens.as_slice().iter() {
        total += *n;
        if *n > 3 {
            long += 1;
        }
    }
    let mut vowels = 0;
    for c in text.chars() {
        if "aeiou".contains(c) {
            vowels += 1;
        }
    }
    let path = "/tmp/vole-compile-cost.txt";
    match fs::write(path, out.as_bytes()) {
        Ok(_) => {}
        Err(e) => eprintln("cannot write {path}: {e}"),
    }
    let back = fs::read_to_string_in(path, gpa);
    let read = match back {
        Ok(s) => s.len(),
        Err(_) => 0,
    };
    let n: i64 = "42".parse::<i64>().unwrap_or(0);
    let first = lens.pop();
    println("{} words, {} entries, {} lengths, {long} long, {total} bytes, {vowels} vowels",
        counts.len(), order.len(), by_len.len());
    println("{n:>5} {first:?} {:x} {read}", total);
    0
}
