// compile_cost's regions row (0.27.8): many calls of functions whose
// parameters are a few structs with lifetimes, nested. Each call reads
// the callee's signature (places::regions sig_of), and with it each
// type's declared bounds and inferred outlives requirements (D4.5, D4.6),
// which a check computes once per type, not once per call. Written by a
// script: 120 functions, each calling the 12 before it, their parameters
// a struct of 12 references to a struct of 36 fields.

struct Span<'a> {
    text: &'a [u8],
    at: usize,
}

struct Tok<'a> {
    span: Span<'a>,
    kind: u8,
}

struct Line<'a, 'b> {
    first: Tok<'a>,
    rest: &'b [Tok<'a>],
    prev: Option<&'b Line<'a, 'b>>,
}

struct Doc<'a, 'b> {
    lines: &'b [Line<'a, 'b>],
    name: Span<'a>,
    last: &'b Tok<'a>,
}

struct Big<'a, 'b> {
    f0: Span<'a>,
    f1: Tok<'a>,
    f2: &'b Tok<'a>,
    f3: Line<'a, 'b>,
    f4: &'b [Line<'a, 'b>],
    f5: Option<Tok<'a>>,
    f6: Span<'a>,
    f7: Tok<'a>,
    f8: &'b Tok<'a>,
    f9: Line<'a, 'b>,
    f10: &'b [Line<'a, 'b>],
    f11: Option<Tok<'a>>,
    f12: Span<'a>,
    f13: Tok<'a>,
    f14: &'b Tok<'a>,
    f15: Line<'a, 'b>,
    f16: &'b [Line<'a, 'b>],
    f17: Option<Tok<'a>>,
    f18: Span<'a>,
    f19: Tok<'a>,
    f20: &'b Tok<'a>,
    f21: Line<'a, 'b>,
    f22: &'b [Line<'a, 'b>],
    f23: Option<Tok<'a>>,
    f24: Span<'a>,
    f25: Tok<'a>,
    f26: &'b Tok<'a>,
    f27: Line<'a, 'b>,
    f28: &'b [Line<'a, 'b>],
    f29: Option<Tok<'a>>,
    f30: Span<'a>,
    f31: Tok<'a>,
    f32: &'b Tok<'a>,
    f33: Line<'a, 'b>,
    f34: &'b [Line<'a, 'b>],
    f35: Option<Tok<'a>>,
}

struct Huge<'a, 'b> {
    b0: &'b Big<'a, 'b>,
    b1: &'b Big<'a, 'b>,
    b2: &'b Big<'a, 'b>,
    b3: &'b Big<'a, 'b>,
    b4: &'b Big<'a, 'b>,
    b5: &'b Big<'a, 'b>,
    b6: &'b Big<'a, 'b>,
    b7: &'b Big<'a, 'b>,
    b8: &'b Big<'a, 'b>,
    b9: &'b Big<'a, 'b>,
    b10: &'b Big<'a, 'b>,
    b11: &'b Big<'a, 'b>,
    doc: Doc<'a, 'b>,
}

fn f0<'a, 'b>(h: &Huge<'a, 'b>, l: &Line<'a, 'b>, t: &Tok<'a>) -> usize {
    h.doc.name.at + l.first.span.at + t.span.at + h.doc.lines.len()
}

fn f1<'a, 'b>(h: &Huge<'a, 'b>, l: &Line<'a, 'b>, t: &Tok<'a>) -> usize {
    let mut n: usize = t.kind as usize;
    // (never at run time: the calls are for the check)
    if t.kind > 200 {
        n += f0(h, l, t);
    }
    n
}

fn f2<'a, 'b>(h: &Huge<'a, 'b>, l: &Line<'a, 'b>, t: &Tok<'a>) -> usize {
    let mut n: usize = t.kind as usize;
    // (never at run time: the calls are for the check)
    if t.kind > 200 {
        n += f0(h, l, t);
        n += f1(h, l, t);
    }
    n
}

