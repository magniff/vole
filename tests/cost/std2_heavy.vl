// EDITION: rust
// The std-heavy program of the compile-cost row's rust half
// (tests/compile_cost.sh: std-rust): text, collections, iterators and
// formatting on std2, so that much of the rust edition's std is read,
// checked and emitted.
use std::collections::HashMap;
use std::default::DefaultIn;
use std::string::String;

fn main(gpa: Gpa) {
    let text = "the quick brown fox jumps over the lazy dog\nthe dog sleeps, the fox runs\n";
    let mut by_len: HashMap<usize, i64, Gpa> = DefaultIn::default_in(gpa);
    let mut lens: Vec<usize, Gpa> = Vec::new_in(gpa);
    let mut out = String::new_in(gpa);
    for line in text.lines() {
        for w in line.split_whitespace() {
            let w = w.trim_matches(',');
            *by_len.entry(w.len()).or_insert(0) += 1;
            lens.push(w.len());
            out.push_str(w);
            out.push(' ');
        }
    }
    let mut long = 0;
    let mut total: usize = 0;
    for n in lens.as_slice().iter() {
        total += *n;
        if *n > 3 {
            long += 1;
        }
    }
    let mut vowels = 0;
    for c in text.chars() {
        if "aeiou".contains(c) {
            vowels += 1;
        }
    }
    let n: i64 = "42".parse::<i64>().unwrap_or(0);
    let first = lens.pop();
    println("{} words, {} lengths, {long} long, {total} bytes, {vowels} vowels", lens.len(),
        by_len.len());
    println("{n:>5} {first:?} {:x} {}", total, out.len());
}
