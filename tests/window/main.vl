// EDITION: rust
// The window library's tests (terminal.md §4.1, "std::window Cocoa"),
// run by tests/window/run.sh, and a demo to try by hand.
//
//   main test      the headless checks (key tables, modifiers, UTF-8 and
//                  UTF-16 helpers), then, when a window server is there
//                  (NEEDS: display), the Cocoa checks: a window, its first
//                  size, frames on request and none without, the window's
//                  surface presenting the renderer's grid (std::gpu), keys and text
//                  through interpretKeyEvents, the input method's
//                  composition, the mouse, a resize, the clipboard (the
//                  user's is restored), a watched pipe, close and Quit,
//                  and no CPU used while idle
//   main demo      a window showing what you type through the terminal's
//                  renderer (Command-Q quits)
//
// Events are synthesized with +[NSEvent keyEventWithType:...] and sent to
// the window (-[NSWindow sendEvent:]), so no Accessibility permission is
// needed and the window need not be the key window.
//
// `render` is a link to examples/voltty/render: a program's modules sit
// under its root.

use std::alloc::{Allocator, arena_scope};
use std::fmt::Display;
mod count;
mod render;

use std::gpu::{Format, RawSurface, Surface};
use std::window::{App, Button, CursorIcon, Event, MouseAction, Window, WindowDesc, WindowId};
use std::window::keys::{
    ALT_L, ALT_R, CAPS, CTRL_L, CTRL_R, KeyCode, Logical, Named, SHIFT_L, SHIFT_R, SUPER_L,
    first_char, mac_keycode, mac_logical, mac_modifier_down, mac_mods, utf16_to_byte, utf8_cut,
};

use render::input::{
    CURSOR_BEAM, CURSOR_BLOCK, Cell, CellGrid, CursorView, DEFAULT_BG, DEFAULT_FG, cell, named,
};
use render::objc::{
    Point, Range, Rect, class, msg_b, msg_i, msg_p, msg_p_p, msg_p_u, msg_p_utudipiif,
    msg_p_utudipppbh, msg_r_gP, msg_u, msg_v_p, msg_v_pg, msg_v_pgg, msg_v_z, nsstring, pool_pop,
    pool_push, sel,
};
use render::objc::Size as NsSize;
use render::renderer::Renderer;

extern "C" {
    fn pipe(fds: *mut i32) -> i32;
    fn write(fd: i32, p: *mut u8, n: u64) -> i64;
    fn read(fd: i32, p: *mut u8, n: u64) -> i64;
    fn close(fd: i32) -> i32;
    fn getrusage(who: i32, usage: *mut u8) -> i32;
    fn getenv(name: *mut u8) -> *mut u8;

    fn CGEventCreateScrollWheelEvent2(source: *mut u8, units: u32, count: u32, w1: i32, w2: i32,
        w3: i32) -> *mut u8;

    fn CFRelease(o: *mut u8);

    fn CGSessionCopyCurrentDictionary() -> *mut u8;
    fn CGMainDisplayID() -> u32;
    fn CGDisplayIsAsleep(display: u32) -> i32;
}

#[derive(Clone, Copy)]
struct T {
    failed: i64,
}

impl T {
    fn check<N: Display, D: Display>(&mut self, name: N, ok: bool, why: D) {
        if ok {
            println("ok {name}");
        } else {
            println("FAIL {name}: {why}");
            self.failed += 1;
        }
    }

    // (0.25.2) A check that cannot run here: `skip NAME: why`, which the
    // runner counts apart (never as a pass).
    fn skip<N: Display, D: Display>(&mut self, name: N, why: D) {
        println("skip {name}: {why}");
    }

    // (0.25.2) A time budget: over it, `slow NAME: why`, which run.sh
    // makes a FAIL on an idle machine and a SKIP on a loaded one
    // (tests/load.sh); not counted here.
    fn budget<N: Display, D: Display>(&mut self, name: N, ok: bool, why: D) {
        if ok {
            println("ok {name}");
        } else {
            println("slow {name}: {why}");
        }
    }
}

// ---- whether frames can come ---------------------------------------------

// (0.25.2) Why the display can give no frames now (a nonzero code, see
// no_frames_why), or 0 when it should: a display link fires only for a
// visible window on an awake display of the console's session. `win` is
// an NSWindow to ask for its occlusion state, or null.
// VOLE_TEST_NO_FRAMES (set to anything) pretends there are none (the
// runner's check of its SKIP outcome).
fn no_frames_code(win: *mut u8) -> i64 {
    if std::sys::sys_getenv("VOLE_TEST_NO_FRAMES").is_some() {
        return 1;
    }
    // UNSAFE: CoreGraphics' C function, returning a raw CFDictionary.
    // SAFETY: it takes nothing; the result is a +1 dictionary or null,
    // released below and not used after.
    let d = unsafe { CGSessionCopyCurrentDictionary() };
    if d == 0 as *mut u8 {
        return 2;
    }
    let pool = pool_push();
    let mut code: i64 = 0;
    if session_flag(d, b"CGSSessionScreenIsLocked") == 1 {
        code = 3;
    } else if session_flag(d, b"kCGSSessionOnConsoleKey") == 0 {
        code = 4;
    }
    pool_pop(pool);
    // UNSAFE: CoreFoundation's release, on a raw pointer.
    // SAFETY: `d` is the +1 dictionary from above, released once.
    unsafe { CFRelease(d); }
    if code != 0 {
        return code;
    }
    // UNSAFE: CoreGraphics' C function.
    // SAFETY: it takes nothing and returns the main display's id.
    let main = unsafe { CGMainDisplayID() };
    // UNSAFE: CoreGraphics' C function.
    // SAFETY: it takes a display id (any value is accepted) and returns
    // a boolean_t.
    if unsafe { CGDisplayIsAsleep(main) } != 0 {
        return 5;
    }
    if win != 0 as *mut u8 {
        // UNSAFE: an Objective-C message on the window's raw pointer.
        // SAFETY: `win` is a live NSWindow (the caller's); occlusionState
        // returns an NSUInteger, bit 1 NSWindowOcclusionStateVisible.
        let occ = unsafe { msg_u(win, sel(c"occlusionState")) };
        if (occ & 2) == 0 {
            return 6;
        }
    }
    0
}

// (0.25.2) A boolean of the session dictionary `d`: 1, 0, or -1 when the
// key is not there.
fn session_flag(d: *mut u8, key: &[u8]) -> i64 {
    let k = nsstring(key);
    // UNSAFE: an Objective-C message on the dictionary's raw pointer.
    // SAFETY: `d` is the caller's live NSDictionary (toll-free bridged
    // CFDictionary); objectForKey: takes the NSString `k` (autoreleased in
    // the caller's pool) and returns an object or null.
    let v = unsafe { msg_p_p(d, sel(c"objectForKey:"), k) };
    if v == 0 as *mut u8 {
        return -1;
    }
    // UNSAFE: an Objective-C message on the value's raw pointer.
    // SAFETY: the session dictionary's values for these keys are
    // CFBooleans (NSNumbers), alive while `d` is; boolValue returns a BOOL.
    if unsafe { msg_b(v, sel(c"boolValue")) } { 1 } else { 0 }
}

fn no_frames_why(code: i64) -> &'static str {
    match code {
        1 => "VOLE_TEST_NO_FRAMES=1 (pretended, to check the runner's SKIP)",
        2 => "no window server session",
        3 => "the screen is locked",
        4 => "the session is not the console's (another user is logged in on it)",
        5 => "the display is asleep",
        _ => "the test window is not visible (occluded)",
    }
}

// ---- headless ------------------------------------------------------------

fn code_is(c: KeyCode, want: KeyCode) -> bool {
    c == want
}

fn test_keys(t: &mut T) {
    t.check("keys_letters",
        code_is(mac_keycode(0x00u16), KeyCode::KeyA) && code_is(mac_keycode(0x06u16), KeyCode::KeyZ)
            && code_is(mac_keycode(0x2Eu16), KeyCode::KeyM), "kVK_ANSI_A/Z/M");
    t.check("keys_digits",
        code_is(mac_keycode(0x1Du16), KeyCode::Digit0)
            && code_is(mac_keycode(0x16u16), KeyCode::Digit6)
            && code_is(mac_keycode(0x17u16), KeyCode::Digit5), "kVK_ANSI_0/6/5");
    t.check("keys_named",
        code_is(mac_keycode(0x24u16), KeyCode::Enter)
            && code_is(mac_keycode(0x33u16), KeyCode::Backspace)
            && code_is(mac_keycode(0x75u16), KeyCode::Delete)
            && code_is(mac_keycode(0x7Eu16), KeyCode::ArrowUp)
            && code_is(mac_keycode(0x7Au16), KeyCode::F1)
            && code_is(mac_keycode(0x6Fu16), KeyCode::F12)
            && code_is(mac_keycode(0x4Cu16), KeyCode::NumpadEnter),
        "Return, Delete, ForwardDelete, Up, F1, F12");
    t.check("keys_modifiers", code_is(mac_keycode(0x38u16), KeyCode::ShiftLeft)
        && code_is(mac_keycode(0x3Cu16), KeyCode::ShiftRight)
        && code_is(mac_keycode(0x37u16), KeyCode::SuperLeft)
        && code_is(mac_keycode(0x36u16), KeyCode::SuperRight)
        && code_is(mac_keycode(0x3Du16), KeyCode::AltRight),
        "Shift, RightShift, Command, RightCommand, RightOption");
    t.check("keys_unknown", code_is(mac_keycode(0x34u16), KeyCode::Unidentified)
        && code_is(mac_keycode(0x200u16), KeyCode::Unidentified), "0x34, 0x200");
    // Every code below 0x80 maps somewhere or to Unidentified, and the
    // known ones are distinct.
    let mut seen: i64 = 0;
    for a in 0..128 {
        let ca = mac_keycode(a as u16);
        if ca == KeyCode::Unidentified {
            continue;
        }
        seen += 1;
        for b in a + 1..128 {
            if mac_keycode(b as u16) == ca {
                t.check(format_args("keys_distinct_{a}_{b}"), false, "two codes map to one key");
            }
        }
    }
    t.check("keys_count", seen >= 110, format_args("{seen} mapped codes"));

    let up = mac_logical(0xF700u32, KeyCode::ArrowUp);
    t.check("logical_arrow", match up {
        Logical::Named(Named::ArrowUp) => true,
        _ => false,
    }, "U+F700");
    let f5 = mac_logical(0xF708u32, KeyCode::F5);
    t.check("logical_f5", match f5 {
        Logical::F(n) => n == 5,
        _ => false,
    }, "U+F708");
    let ret = mac_logical(13u32, KeyCode::Enter);
    let a = mac_logical(b'a' as u32, KeyCode::KeyA);
    let sh = mac_logical(0u32, KeyCode::ShiftRight);
    t.check("logical_misc", match ret {
        Logical::Named(Named::Enter) => true,
        _ => false,
    } && match a {
        Logical::Char(c) => c == b'a' as u32,
        _ => false,
    } && match sh {
        Logical::Named(Named::Shift) => true,
        _ => false,
    }, "Return, a, RightShift");

    // Modifier flags: device bits tell left from right.
    let m1 = mac_mods((1 << 17) | 0x04);
    let m2 = mac_mods((1 << 18) | (1 << 19) | 0x01 | 0x40);
    let m3 = mac_mods(1 << 20);
    let m4 = mac_mods(1 << 16);
    t.check("mods_sides",
        m1.bits == SHIFT_R && m2.bits == (CTRL_L | ALT_R) && m3.bits == SUPER_L && m4.bits == CAPS,
        format_args("{} {} {} {}", m1.bits, m2.bits, m3.bits, m4.bits));
    t.check("mods_accessors", m2.ctrl() && m2.alt() && !m2.shift() && !m2.sup() && m4.caps(),
        "ctrl alt");
    t.check("mods_flags_changed", mac_modifier_down(KeyCode::ShiftRight, (1 << 17) | 0x04)
        && !mac_modifier_down(KeyCode::ShiftLeft, (1 << 17) | 0x04)
        && !mac_modifier_down(KeyCode::ControlRight, (1 << 18) | 0x01),
        "right shift down, left not");
    let _ = SHIFT_L;
    let _ = CTRL_R;
    let _ = ALT_L;

    t.check("utf8_first", first_char(b"a") == 97 && first_char(b"\xc3\xa9") == 0xE9
        && first_char(b"\xe4\xb8\xad") == 0x4E2D && first_char(b"\xf0\x9f\x98\x80") == 0x1F600
        && first_char(b"") == 0 && first_char(b"\xe4") == 0xFFFD, "a, e-acute, U+4E2D, U+1F600");
    // "aé中😀": UTF-16 units 1, 1, 1, 2; bytes 1, 2, 3, 4.
    let s: &[u8] = b"a\xc3\xa9\xe4\xb8\xad\xf0\x9f\x98\x80";
    t.check("utf16_to_byte",
        utf16_to_byte(s, 0) == 0 && utf16_to_byte(s, 1) == 1 && utf16_to_byte(s, 2) == 3
            && utf16_to_byte(s, 3) == 6 && utf16_to_byte(s, 5) == 10 && utf16_to_byte(s, 9) == 10,
        "unit offsets to byte offsets");
    // "z" and ten 3-byte characters (31 bytes) cut at 30: the last
    // character does not fit whole.
    let long: &[u8] = b"z\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad\xe4\xb8\xad";
    t.check("utf8_cut",
        utf8_cut(long, 30) == 28 && utf8_cut(&long[1..long.len()], 30) == 30
            && utf8_cut(b"ab", 30) == 2,
        format_args("{} {}", utf8_cut(long, 30), utf8_cut(&long[1..long.len()], 30)));
}

// ---- with a display ------------------------------------------------------

// Waits up to `ms` for an event `want` accepts; the others are dropped
// (counted in `other`).
fn wait_for(app: &mut App<Gpa>, ms: i64, want: fn(&Event) -> bool, other: &mut i64) -> Option<Event> {
    let t0 = clock_ms();
    loop {
        let left = ms - (clock_ms() - t0);
        if left <= 0 {
            return None;
        }
        match app.wait_timeout(left) {
            Some(e) => {
                if want(&e) {
                    return Some(e);
                }
                *other += 1;
            }
            None => return None,
        }
    }
}

extern "C" {
    fn clock_gettime_nsec_np(clock: i32) -> u64;
}

fn clock_ms() -> i64 {
    // SAFETY: a libc clock read.
    unsafe { (clock_gettime_nsec_np(8) / 1000000) as i64 }
}

fn is_resize(e: &Event) -> bool {
    match e {
        Event::Resize(_, _) => true,
        _ => false,
    }
}

fn is_frame(e: &Event) -> bool {
    match e {
        Event::Frame(_) => true,
        _ => false,
    }
}

fn is_key(e: &Event) -> bool {
    match e {
        Event::Key(k) => k.pressed,
        _ => false,
    }
}

fn is_key_any(e: &Event) -> bool {
    match e {
        Event::Key(_) => true,
        _ => false,
    }
}

fn is_text(e: &Event) -> bool {
    match e {
        Event::Text(_) => true,
        _ => false,
    }
}

fn is_preedit(e: &Event) -> bool {
    match e {
        Event::Preedit(_) => true,
        _ => false,
    }
}

fn is_mouse_press(e: &Event) -> bool {
    match e {
        Event::Mouse(m) => m.action == MouseAction::Press,
        _ => false,
    }
}

fn is_scroll(e: &Event) -> bool {
    match e {
        Event::Scroll(_) => true,
        _ => false,
    }
}

fn is_readable(e: &Event) -> bool {
    match e {
        Event::Readable(_) => true,
        _ => false,
    }
}

fn is_close(e: &Event) -> bool {
    match e {
        Event::Close(_) => true,
        _ => false,
    }
}

fn is_quit(e: &Event) -> bool {
    match e {
        Event::Quit => true,
        _ => false,
    }
}

fn is_any(e: &Event) -> bool {
    true
}

// A key event as the hardware would make it, sent to the window.
fn send_key(w: &mut Window, down: bool, code: u16, chars: &[u8], plain: &[u8], flags: u64) {
    // SAFETY: +[NSEvent keyEventWithType:location:modifierFlags:timestamp:
    // windowNumber:context:characters:charactersIgnoringModifiers:
    // isARepeat:keyCode:] with its types; -[NSWindow sendEvent:]
    // dispatches it to the first responder, our view. The event and
    // strings are autoreleased in the pool around.
    unsafe {
        let p = pool_push();
        let num = msg_i(w.ns.win, sel(c"windowNumber"));
        let ev = msg_p_utudipppbh(class(c"NSEvent"),
            sel(c"keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:"),
            if down { 10 } else { 11 }, Point { x: 0.0, y: 0.0 }, flags, 0.0, num, 0 as *mut u8,
            nsstring(chars), nsstring(plain), false, code);
        msg_v_p(w.ns.win, sel(c"sendEvent:"), ev);
        pool_pop(p);
    }
}

// A left-button press at (x, y) points from the content's bottom-left
// (AppKit's window coordinates).
fn send_click(w: &mut Window, x: f64, y: f64) {
    // SAFETY: +[NSEvent mouseEventWithType:location:modifierFlags:
    // timestamp:windowNumber:context:eventNumber:clickCount:pressure:].
    unsafe {
        let p = pool_push();
        let num = msg_i(w.ns.win, sel(c"windowNumber"));
        let ev = msg_p_utudipiif(class(c"NSEvent"),
            sel(c"mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:"),
            1, Point { x: x, y: y }, 0, 0.0, num, 0 as *mut u8, 0, 1, 1.0);
        msg_v_p(w.ns.win, sel(c"sendEvent:"), ev);
        pool_pop(p);
    }
}

// The renderer's grid for the display test and the demo.
struct Screen<A: Allocator> {
    lines: i64,
    cols: i64,
    cells: Vec<Cell, A>,
    dirty: Vec<bool, A>,
    all: bool,
}

impl Screen<Gpa> {
    fn new_in(lines: i64, cols: i64, gpa: Gpa) -> Screen<Gpa> {
        let mut s = Screen {
            lines: lines, cols: cols, cells: Vec::new_in(gpa),
            dirty: Vec::from_elem_in(true, lines as usize, gpa),
            all: true,
        };
        for _ in 0..lines * cols {
            s.cells.push(cell(32, named(DEFAULT_FG), named(DEFAULT_BG), 0));
        }
        s
    }

    fn put(&mut self, l: i64, x: i64, c: u32, fg: u32) {
        if l >= 0 && l < self.lines && x >= 0 && x < self.cols {
            self.cells[(l * self.cols + x) as usize] = cell(c, fg, named(DEFAULT_BG), 0);
            self.dirty[l as usize] = true;
        }
    }

    fn text(&mut self, l: i64, x: i64, s: &[u8], fg: u32) {
        for i in 0..s.len() {
            self.put(l, x + i as i64, s[i] as u32, fg);
        }
    }

    // Sizes to lines × cols, keeping what fits.
    fn resize(&mut self, lines: i64, cols: i64, gpa: Gpa) {
        if lines == self.lines && cols == self.cols {
            return;
        }
        let mut n = Screen::new_in(lines, cols, gpa);
        for l in 0..lines {
            for x in 0..cols {
                if l < self.lines && x < self.cols {
                    n.cells[(l * cols + x) as usize] = self.cells[(l * self.cols + x) as usize];
                }
            }
        }
        *self = n;
    }
}

impl CellGrid for Screen<Gpa> {
    fn lines(&self) -> i64 {
        self.lines
    }

    fn cols(&self) -> i64 {
        self.cols
    }

    fn row(&self, l: i64) -> &[Cell] {
        &self.cells[(l * self.cols) as usize..((l + 1) * self.cols) as usize]
    }

    fn damaged(&self, l: i64) -> bool {
        self.dirty[l as usize]
    }

    fn damage_all(&self) -> bool {
        self.all
    }

    fn scrolled(&self) -> i64 {
        0
    }

    fn reset_damage(&mut self) {
        for l in 0..self.lines {
            self.dirty[l as usize] = false;
        }
        self.all = false;
    }
}

// Draws the screen into the surface's next frame and presents it.
fn present(r: &mut Renderer<Gpa>, s: &mut Screen<Gpa>, surf: &mut Surface<Gpa>) -> bool {
    r.update(s);
    match surf.frame() {
        Err(_) => false,
        Ok(f) => {
            let view = f.texture.view();
            r.render(&view);
            f.present(&mut r.queue);
            true
        }
    }
}

// The window's surface on the renderer's device, w × h pixels.
fn surface(r: &Renderer<Gpa>, win: &Window, w: i64, h: i64, gpa: Gpa) -> Option<Surface<Gpa>> {
    let inst = std::gpu::Instance::new_in(gpa);
    match inst.surface(&r.dev, RawSurface::MetalLayer(win.raw_surface())) {
        Ok(sf) => {
            let mut surf = sf;
            surf.configure(&r.dev, w, h);
            Some(surf)
        }
        Err(_) => None,
    }
}

fn cpu_seconds() -> f64 {
    // struct rusage: ru_utime and ru_stime (timevals of i64 seconds and
    // i32 microseconds, padded to 16 bytes) first, then 14 longs.
    let mut ru: [i64; 18] = [0i64; 18];
    // SAFETY: getrusage writes one struct rusage (144 bytes) into the
    // 144-byte array.
    unsafe { getrusage(0, ru.as_mut_ptr() as *mut u8); }
    let us = (ru[1] & 0xFFFFFFFF) + (ru[3] & 0xFFFFFFFF);
    (ru[0] + ru[2]) as f64 + us as f64 / 1000000.0
}

fn test_display(t: &mut T, gpa: Gpa) {
    let mut app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            t.check("app_new", false, "NSApplication failed with a display");
            return;
        }
    };
    let desc = WindowDesc::new("vole window test", 400, 300);
    let mut win = match app.window(desc) {
        Ok(w) => w,
        Err(_) => {
            t.check("window_open", false, "NSWindow");
            return;
        }
    };
    let mut other: i64 = 0;
    // The first size: the content in physical pixels.
    match wait_for(&mut app, 2000, is_resize, &mut other) {
        Some(Event::Resize(id, s)) => {
            t.check("window_first_size", id.eq(win.id) && s.w == (400.0 * s.scale) as i64
                && s.h == (300.0 * s.scale) as i64 && s.scale >= 1.0,
                format_args("{}x{} at {}", s.w, s.h, s.scale));
        }
        _ => t.check("window_first_size", false, "no Resize"),
    }

    // Frames come only when asked for. (0.25.2: a loaded machine may take
    // seconds; none at all while the display cannot give frames is a
    // skip, with the reason, and so are the checks that need frames.)
    let t0 = clock_ms();
    let mut frames = no_frames_code(win.ns.win);
    if frames == 1 {
        t.skip("frame_on_request", no_frames_why(frames));
    } else {
        win.request_frame();
        let mut f = wait_for(&mut app, 1000, is_frame, &mut other);
        if f.is_none() {
            f = wait_for(&mut app, 4000, is_frame, &mut other);
        }
        let dt = clock_ms() - t0;
        if f.is_some() {
            frames = 0;
            t.check("frame_on_request", true, "");
            let none = wait_for(&mut app, 150, is_frame, &mut other);
            t.check("frame_not_unasked", none.is_none(), "a Frame without request_frame");
        } else {
            frames = no_frames_code(win.ns.win);
            if frames != 0 {
                t.skip("frame_on_request",
                    format_args("no Frame in {dt} ms: {}",
                        no_frames_why(frames)));
            } else {
                t.check("frame_on_request", false,
                    format_args(
                        "no Frame in {dt} ms (the display is awake, unlocked, the window visible)"));
            }
        }
    }

    // The window's surface presents the renderer's grid (std::gpu).
    let sz = win.size();
    if frames != 0 {
        t.skip("layer_present", no_frames_why(frames));
    } else {
        match Renderer::new_in(b"Menlo", 13.0, sz.scale, Format::Bgra8Unorm, gpa) {
            Err(e) => t.check("layer_present", false, e.as_str()),
            Ok(rr) => {
                let mut r = rr;
                match surface(&r, &win, sz.w, sz.h, gpa) {
                    None => t.check("layer_present", false, "no surface for the window's layer"),
                    Some(sf) => {
                        let mut surf = sf;
                        let mut s = Screen::new_in(sz.h / r.cell_h(), sz.w / r.cell_w(), gpa);
                        s.text(0, 0, b"vole: std::window on Cocoa", named(2));
                        s.text(1, 0, b"one instanced draw per frame", named(DEFAULT_FG));
                        r.set_cursor(CursorView { line: 2, col: 0, shape: CURSOR_BLOCK });
                        let mut shown: i64 = 0;
                        for _ in 0..3 {
                            win.request_frame();
                            if wait_for(&mut app, 3000, is_frame, &mut other).is_some()
                                && present(&mut r, &mut s, &mut surf) {
                                shown += 1;
                            }
                        }
                        r.wait_idle();
                        let why = no_frames_code(win.ns.win);
                        if shown < 3 && why != 0 {
                            t.skip("layer_present",
                                format_args("{shown} of 3 frames presented: {}",
                                    no_frames_why(why)));
                        } else {
                            t.check("layer_present", shown == 3,
                                format_args("{shown} of 3 frames presented"));
                        }
                    }
                }
            }
        }
    }

    // Keys: a letter (a Key, then its Text), Return (no text), Control-C
    // (no text), a release, a modifier.
    send_key(&mut win, true, 0x00, b"a", b"a", 0);
    match wait_for(&mut app, 500, is_key, &mut other) {
        Some(Event::Key(k)) => t.check("key_letter",
            k.code == KeyCode::KeyA && k.pressed && k.text_follows && !k.ime
                && match k.key {
                Logical::Char(c) => c == b'a' as u32,
                _ => false,
            }, "KeyA"),
        _ => t.check("key_letter", false, "no Key"),
    }
    match wait_for(&mut app, 500, is_text, &mut other) {
        Some(Event::Text(x)) => t.check("key_letter_text",
            &x.bytes[0..x.len as usize] == b"a",
            &str::from_utf8(x.bytes[0..x.len as usize]).unwrap()),
        _ => t.check("key_letter_text", false, "no Text"),
    }
    send_key(&mut win, true, 0x24, b"\r", b"\r", 0);
    match wait_for(&mut app, 500, is_key, &mut other) {
        Some(Event::Key(k)) => t.check("key_return",
            k.code == KeyCode::Enter && !k.text_follows && match k.key {
                Logical::Named(Named::Enter) => true,
                _ => false,
            }, "Enter"),
        _ => t.check("key_return", false, "no Key"),
    }
    send_key(&mut win, true, 0x08, b"\x03", b"c", (1 << 18) | 0x01);
    match wait_for(&mut app, 500, is_key, &mut other) {
        Some(Event::Key(k)) => t.check("key_ctrl_c",
            k.code == KeyCode::KeyC && k.mods.ctrl() && !k.text_follows,
            format_args("text_follows {}", k.text_follows)),
        _ => t.check("key_ctrl_c", false, "no Key"),
    }
    send_key(&mut win, false, 0x00, b"a", b"a", 0);
    match wait_for(&mut app, 500, is_key_any, &mut other) {
        Some(Event::Key(k)) => t.check("key_release", k.code == KeyCode::KeyA && !k.pressed,
            "KeyA up"),
        _ => t.check("key_release", false, "no Key"),
    }
    // Shift-Option-e on a US layout: Option composes (a dead key) and
    // Shift-letter text arrives as one more Key and Text.
    send_key(&mut win, true, 0x0E, b"E", b"e", 1 << 17);
    match wait_for(&mut app, 500, is_text, &mut other) {
        Some(Event::Text(x)) => t.check("key_shift_text",
            &x.bytes[0..x.len as usize] == b"E",
            &str::from_utf8(x.bytes[0..x.len as usize]).unwrap()),
        _ => t.check("key_shift_text", false, "no Text"),
    }

    // The input method: a composition, then its commit.
    // SAFETY: the NSTextInputClient methods of our view, called as an
    // input method calls them (NSString, NSRange by value).
    unsafe {
        let p = pool_push();
        msg_v_pgg(win.ns.view, sel(c"setMarkedText:selectedRange:replacementRange:"),
            nsstring(b"\xe3\x81\xab\xe3\x81\xbb"), Range { loc: 1, len: 0 },
            Range { loc: 0x7fffffffffffffff, len: 0 });
        pool_pop(p);
    }
    match wait_for(&mut app, 500, is_preedit, &mut other) {
        Some(Event::Preedit(pe)) => t.check("ime_preedit", pe.len == 6 && pe.cursor == 3
            && app.preedit() == b"\xe3\x81\xab\xe3\x81\xbb",
            format_args("len {} cursor {}", pe.len, pe.cursor)),
        _ => t.check("ime_preedit", false, "no Preedit"),
    }
    // SAFETY: as above.
    let has = unsafe { msg_b(win.ns.view, sel(c"hasMarkedText")) };
    t.check("ime_has_marked", has, "hasMarkedText");
    win.set_ime_area(20.0, 40.0, 10.0, 30.0);
    // SAFETY: firstRectForCharacterRange:actualRange: returns an NSRect.
    let rect = unsafe {
        let mut act = Range { loc: 0, len: 0 };
        msg_r_gP(win.ns.view, sel(c"firstRectForCharacterRange:actualRange:"),
            Range { loc: 0, len: 1 }, &mut act)
    };
    t.check("ime_rect", rect.h > 1.0 && rect.w > 1.0,
        format_args("{},{} {}x{}", rect.x, rect.y, rect.w, rect.h));
    // SAFETY: as above.
    unsafe {
        let p = pool_push();
        msg_v_pg(win.ns.view, sel(c"insertText:replacementRange:"),
            nsstring(b"\xe6\x97\xa5\xe6\x9c\xac"), Range { loc: 0x7fffffffffffffff, len: 0 });
        pool_pop(p);
    }
    let mut ended = false;
    let mut committed = false;
    for _ in 0..2 {
        match wait_for(&mut app, 500, is_any, &mut other) {
            Some(Event::Preedit(pe)) => ended = pe.len == 0,
            Some(Event::Text(x)) => committed = &x.bytes[0..x.len as usize]
                == b"\xe6\x97\xa5\xe6\x9c\xac",
            _ => {}
        }
    }
    t.check("ime_commit", ended && committed, format_args("ended {ended}, committed {committed}"));

    // The mouse: a press at (100, 100) points from the bottom-left is at
    // (100, 200) from the top-left of a 300-point-high view.
    send_click(&mut win, 100.0, 100.0);
    match wait_for(&mut app, 500, is_mouse_press, &mut other) {
        Some(Event::Mouse(m)) => {
            let s = win.size().scale;
            // (std::window's Button has no PartialEq)
            let left = match m.button {
                Button::Left => true,
                _ => false,
            };
            t.check("mouse_press",
                left && m.clicks == 1 && m.x == 100.0 * s && m.y == 200.0 * s,
                format_args("at {},{} clicks {}", m.x, m.y, m.clicks));
        }
        _ => t.check("mouse_press", false, "no Mouse"),
    }

    // A wheel: 3 lines up, not precise. (Given to the view directly: the
    // window would route it by the pointer's position.)
    // SAFETY: CGEventCreateScrollWheelEvent2 (the non-variadic form)
    // returns +1, released after +[NSEvent eventWithCGEvent:] (+0, in
    // the pool) has copied it; scrollWheel: takes the NSEvent.
    unsafe {
        let p = pool_push();
        let cg = CGEventCreateScrollWheelEvent2(0 as *mut u8, 1, 1, 3, 0, 0);
        let ev = msg_p_p(class(c"NSEvent"), sel(c"eventWithCGEvent:"), cg);
        msg_v_p(win.ns.view, sel(c"scrollWheel:"), ev);
        CFRelease(cg);
        pool_pop(p);
    }
    match wait_for(&mut app, 500, is_scroll, &mut other) {
        Some(Event::Scroll(sc)) => t.check("scroll_lines",
            !sc.precise && sc.dy > 0.0 && sc.dx == 0.0,
            format_args("dy {} precise {}", sc.dy, sc.precise)),
        _ => t.check("scroll_lines", false, "no Scroll"),
    }
    win.set_cursor(std::window::CursorIcon::Arrow);
    win.set_cursor(std::window::CursorIcon::Text);

    // A resize: the new size arrives, and the layer follows.
    // SAFETY: setContentSize: takes an NSSize.
    unsafe { msg_v_z(win.ns.win, sel(c"setContentSize:"), NsSize { w: 500.0, h: 360.0 }); }
    match wait_for(&mut app, 1000, is_resize, &mut other) {
        Some(Event::Resize(_, s)) => t.check("resize", s.w == (500.0 * s.scale) as i64
            && s.h == (360.0 * s.scale) as i64, format_args("{}x{}", s.w, s.h)),
        _ => t.check("resize", false, "no Resize"),
    }

    // The clipboard, restored afterwards; the paste is read into a
    // ScopedArena, as a frame would (it is sent to the pty and forgotten).
    let saved = app.clipboard_get_in(gpa);
    app.clipboard_set("vole clipboard \xe2\x9c\x93");
    let pasted = arena_scope(&gpa, |a| match app.clipboard_get_in(a) {
        Some(b) => b.as_bytes() == b"vole clipboard \xe2\x9c\x93",
        None => false,
    });
    t.check("clipboard", pasted, "the clipboard did not round-trip");
    match saved {
        Some(b) => app.clipboard_set(b.as_str()),
        None => {}
    }

    // Event batches allocate nothing once the queue has its working size:
    // 50 keys, each a Key and a Text, delivered and drained. (0.25.2: the
    // events still queued from the checks before are drained first; on a
    // loaded machine one can come later, so more than 50 Texts is no
    // failure: the check is that nothing allocates.)
    loop {
        match app.poll() {
            Some(_) => {}
            None => break,
        }
    }
    let a0 = count::allocs();
    let mut got: i64 = 0;
    for _ in 0..50 {
        send_key(&mut win, true, 0x00, b"a", b"a", 0);
        loop {
            match app.poll() {
                Some(Event::Text(_)) => got += 1,
                Some(_) => {}
                None => break,
            }
        }
    }
    let n = count::allocs() - a0;
    t.check("events_no_allocations", n == 0 && got >= 50,
        format_args("{n} allocations for {got} keys"));
    println("bench event_allocations: {n} in 50 key batches");

    // A watched pipe.
    let mut fds: [i32; 2] = [0, 0];
    // SAFETY: pipe writes two fds into the array.
    unsafe { pipe(fds.as_mut_ptr() as *mut i32); }
    t.check("watch_add", app.watch(fds[0]), "CFFileDescriptor");
    let quiet = wait_for(&mut app, 100, is_readable, &mut other);
    t.check("watch_quiet", quiet.is_none(), "Readable before any write");
    // SAFETY: write and read one byte through the pipe's fds.
    unsafe { write(fds[1], c"x", 1); }
    match wait_for(&mut app, 1000, is_readable, &mut other) {
        Some(Event::Readable(fd)) => t.check("watch_readable", fd == fds[0],
            format_args("fd {fd}")),
        _ => t.check("watch_readable", false, "no Readable"),
    }
    let mut byte: [u8; 4] = [0; 4];
    // SAFETY: reads at most 4 bytes into the array.
    unsafe { read(fds[0], byte.as_mut_ptr() as *mut u8, 4); }
    let drained = wait_for(&mut app, 100, is_readable, &mut other);
    t.check("watch_drained", drained.is_none(), "Readable after the data was read");
    app.unwatch(fds[0]);
    // SAFETY: closes the pipe's fds.
    unsafe {
        close(fds[0]);
        close(fds[1]);
    }

    // Idle: nothing requested, nothing happens, no CPU. (0.25.2: up to
    // three seconds measured, the best one counts: on a loaded machine a
    // second's few wakeups can cost more than 20 ms, while a busy loop
    // costs most of every second.)
    let mut used = 1.0;
    let mut idle_frame = false;
    for _ in 0..3 {
        if used >= 0.02 {
            let c0 = cpu_seconds();
            if wait_for(&mut app, 1000, is_frame, &mut other).is_some() {
                idle_frame = true;
            }
            let u = cpu_seconds() - c0;
            if u < used {
                used = u;
            }
        }
    }
    t.check("idle", !idle_frame, "a Frame while idle");
    t.budget("idle_cpu", used < 0.02,
        format_args("{used} s of CPU in the best of 3 idle seconds (budget 0.02 s)"));
    println("bench idle_cpu: {} ms of CPU in 1 s", used * 1000.0);

    // (0.25.2.1) A window not shown gets its frames all the same, from
    // the timer (10 a second), and after 3 s without a display frame the
    // diagnostic on stderr (run.sh checks the line). orderOut: hides it
    // (no display link fires for it then), makeKeyAndOrderFront: shows it
    // again.
    // SAFETY: orderOut: takes a sender (nil).
    unsafe { msg_v_p(win.ns.win, sel(c"orderOut:"), 0 as *mut u8); }
    let mut hidden: i64 = 0;
    let h0 = clock_ms();
    while clock_ms() - h0 < 3600 {
        win.request_frame();
        if wait_for(&mut app, 1000, is_frame, &mut other).is_none() {
            break;
        }
        hidden += 1;
    }
    let hdt = clock_ms() - h0;
    t.check("frame_hidden", hidden >= 15 && hidden <= 45 && hdt >= 3600,
        format_args("{hidden} frames in {hdt} ms while hidden (want 10 a second)"));
    let none = wait_for(&mut app, 300, is_frame, &mut other);
    t.check("frame_hidden_not_unasked", none.is_none(), "a Frame without request_frame");
    // SAFETY: makeKeyAndOrderFront: takes a sender (nil).
    unsafe { msg_v_p(win.ns.win, sel(c"makeKeyAndOrderFront:"), 0 as *mut u8); }

    // Close asks; the window stays until dropped.
    // SAFETY: performClose: takes a sender (nil).
    unsafe { msg_v_p(win.ns.win, sel(c"performClose:"), 0 as *mut u8); }
    match wait_for(&mut app, 1000, is_close, &mut other) {
        Some(Event::Close(id)) => t.check("close_request", id.eq(win.id), "Close"),
        _ => t.check("close_request", false, "no Close"),
    }
    // Quit from the menu.
    // SAFETY: the main menu built by the App: item 0's submenu has Quit
    // at index 0.
    unsafe {
        let bar = msg_p(msg_p(class(c"NSApplication"), sel(c"sharedApplication")),
            sel(c"mainMenu"));
        let menu = msg_p(msg_p_u(bar, sel(c"itemAtIndex:"), 0), sel(c"submenu"));
        msg_p_u(menu, sel(c"performActionForItemAtIndex:"), 0);
    }
    t.check("quit", wait_for(&mut app, 1000, is_quit, &mut other).is_some(), "no Quit");
    // (0.25.4) A closed window's methods do nothing (its objects are
    // released and its pointers nulled), and closing again is a no-op.
    win.close();
    win.request_frame();
    win.set_title("closed");
    win.set_cursor(CursorIcon::Text);
    win.set_ime_area(1.0, 2.0, 3.0, 4.0);
    win.set_fullscreen(true);
    let cs = win.size();
    win.close();
    t.check("closed_window", cs.w == 0 && cs.h == 0 && !win.focused(),
        format_args("a closed window's size {}x{}", cs.w, cs.h));
    let _ = Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };
    let _ = WindowId { n: 0 };
}

// ---- the demo -----------------------------------------------------------

fn demo(gpa: Gpa) -> i32 {
    let mut app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            println("no display");
            return 1;
        }
    };
    let desc = WindowDesc::new("vole", 720, 420);
    // (std::window's Error has no Debug: no unwrap)
    let mut win = match app.window(desc) {
        Ok(w) => w,
        Err(_) => {
            println("no window");
            return 1;
        }
    };
    let sz = win.size();
    let mut r = match Renderer::new_in(b"Menlo", 14.0, sz.scale, Format::Bgra8Unorm, gpa) {
        Ok(r) => r,
        Err(e) => {
            println("{}", e.as_str());
            return 1;
        }
    };
    let mut surf = match surface(&r, &win, sz.w, sz.h, gpa) {
        Some(sf) => sf,
        None => {
            println("no surface");
            return 1;
        }
    };
    let mut s = Screen::new_in(sz.h / r.cell_h(), sz.w / r.cell_w(), gpa);
    s.text(0, 0, b"vole window demo: type; Return for a new line; Command-Q quits", named(2));
    let mut line: i64 = 2;
    let mut col: i64 = 0;
    r.set_cursor(CursorView { line: line, col: col, shape: CURSOR_BEAM });
    win.request_frame();
    loop {
        match app.wait() {
            Ok(Event::Frame(_)) => {
                present(&mut r, &mut s, &mut surf);
            }
            Ok(Event::Text(x)) => {
                let b = &x.bytes[0..x.len as usize];
                let mut i: i64 = 0;
                while i < b.len() as i64 {
                    let n: i64 = if b[i as usize] >= 0xF0 { 4 } else if b[i as usize] >= 0xE0 { 3 }
                        else if b[i as usize] >= 0xC0 { 2 } else { 1 };
                    let c = first_char(&b[i as usize..b.len()]);
                    s.put(line, col, c, named(DEFAULT_FG));
                    col += 1;
                    i += n;
                }
                r.set_cursor(CursorView { line: line, col: col, shape: CURSOR_BEAM });
                win.request_frame();
            }
            Ok(Event::Key(k)) => {
                if k.pressed && k.code == KeyCode::Enter && !k.ime {
                    line += 1;
                    col = 0;
                } else if k.pressed && k.code == KeyCode::Backspace && !k.ime && col > 0 {
                    col -= 1;
                    s.put(line, col, 32, named(DEFAULT_FG));
                }
                r.set_cursor(CursorView { line: line, col: col, shape: CURSOR_BEAM });
                win.request_frame();
            }
            Ok(Event::Resize(_, z)) => {
                surf.configure(&r.dev, z.w, z.h);
                s.resize(z.h / r.cell_h(), z.w / r.cell_w(), gpa);
                s.all = true;
                win.request_frame();
            }
            Ok(Event::Close(_)) => break,
            Ok(Event::Quit) => break,
            _ => {}
        }
    }
    0
}

// (0.25.2) `main probe`: whether a window gets frames here now, for the
// runner to tell a failure from a display that gives none (tests/window/
// run.sh, after the voltty app drew nothing): `frames: ok`, or `frames:
// none: WHY` with WHY a reason no frames can come (no_frames_why), or
// `frames: none (the display is awake, unlocked, the window visible)`.
fn probe(gpa: Gpa) -> i32 {
    if !std::window::cocoa::has_display() {
        println("frames: none: {}", no_frames_why(2));
        return 0;
    }
    let mut app = match App::new_in(gpa) {
        Ok(a) => a,
        Err(_) => {
            println("frames: none: NSApplication failed");
            return 0;
        }
    };
    let mut win = match app.window(WindowDesc::new("vole frame probe", 160, 120)) {
        Ok(w) => w,
        Err(_) => {
            println("frames: none: no window");
            return 0;
        }
    };
    let mut other: i64 = 0;
    let _ = wait_for(&mut app, 2000, is_resize, &mut other);
    win.request_frame();
    // (0.25.2.1) A Frame comes always (the timer answers when the display
    // cannot): one while the display gives none is reported as none.
    if wait_for(&mut app, 3000, is_frame, &mut other).is_some() && no_frames_code(win.ns.win) == 0 {
        println("frames: ok");
        return 0;
    }
    let why = no_frames_code(win.ns.win);
    if why != 0 {
        println("frames: none: {}", no_frames_why(why));
    } else {
        println("frames: none (the display is awake, unlocked, the window visible)");
    }
    0
}

fn main(argc: i64, argv: *mut *mut u8, gpa: Gpa) -> i32 {
    // SAFETY: argv holds argc NUL-terminated strings.
    let mode = if argc > 1 { unsafe { render::objc::cstr((*argv.add(1))) } } else { b"test" };
    if mode == b"demo" {
        return demo(gpa);
    }
    if mode == b"probe" {
        return probe(gpa);
    }
    let mut t = T { failed: 0 };
    test_keys(&mut t);
    // SAFETY: getenv with a literal; read only when not null.
    let no_display = unsafe {
        let p = getenv(c"VOLE_NO_DISPLAY_TESTS");
        p != 0 as *mut u8 && (*p.add(0)) == b'1'
    };
    if no_display || !std::window::cocoa::has_display() {
        println("skip display: no window server (NEEDS: display)");
    } else {
        test_display(&mut t, gpa);
    }
    if t.failed > 0 { 1 } else { 0 }
}
