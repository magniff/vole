// One call borrows `a` mutably and reads it in another argument.
// OWN: own.conflict
fn add_into(dst: inout Vec<i64, Gpa>, src: Vec<i64, Gpa>) {
    for x in src { dst.push(x); }
}

fn main(gpa: Gpa) {
    var a: Vec<i64, Gpa> = Vec::new_in(gpa);
    a.push(1);
    add_into(&a, a);
    println("{}", a.len());
}
