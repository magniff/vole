// A write through a let parameter (U2; 0.20: a let P that owns a Vec is
// borrowed read-only, as a `&P` was).
// OWN: own.readonly
// TRY: refactor signature reset --type p 'inout P<Gpa>'
struct P<A: Allocator> { x: i64, log: Vec<i64, A> }

fn reset(p: P<Gpa>) { p.x = 0; }

fn main(gpa: Gpa) {
    var q = P { x: 3, log: Vec::new_in(gpa) };
    reset(q);
    println("{}", q.x);
}
