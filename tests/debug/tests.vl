// A test build (tests/debug.sh): at -O2 the test and the dispatcher are
// inlined into the `main` the compiler writes, and the test's own code is
// folded away, so that no function of this file is emitted. The line
// table must have a row all the same (that main's, at this file's first
// line).
#[test]
fn parses() -> Result<(), std::str::ParseIntError> {
    let n = "x2".parse::<i64>()?;
    assert(n == 12);
    Ok(())
}

fn main() {
    println("not run");
}
