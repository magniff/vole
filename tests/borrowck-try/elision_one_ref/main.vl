// EDITION: rust
// RULE: D4.2
// E4 with one reference parameter (and a struct's elided region): the
// try: writes `<'a>` and `&'a` on it.
// CODE: borrowck.elision
// TRY: <'a>
// XFAIL: ir271: elision errors at the signature are not reported yet
struct H<'a> {
    r: &'a i64,
}

fn pick(a: &i64, h: H) -> &i64 {
    if *h.r > 0 {
        return a;
    }
    a
}

fn main() {
    let x: i64 = 1;
    let h = H { r: &x };
    println("{}", *pick(&x, h));
}
