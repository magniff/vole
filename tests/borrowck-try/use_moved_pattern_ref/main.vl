// EDITION: rust
// RULE: D8.3
// A pattern's binding moves a part out, and the part is used after: the
// try: borrows it with `ref a` (`.clone()` cannot go in a pattern).
// CODE: borrowck.use_moved
// TRY: ref a
struct Tok {
    v: i64,
}

fn main() {
    let t = (Tok { v: 1 }, 3);
    let (a, n) = t;
    println("{} {} {}", a.v, n, t.0.v);
}
