// EDITION: rust
// RULE: D7.3
// The shared loan is an argument of the same call: the try: takes the
// value out first.
// CODE: borrowck.conflict
// TRY: let n =
// XFAIL: 0.27.2: the try: needs a line rewrite beyond a node wrap (a hoisted `let`, a moved declaration)
struct S {
    x: i64,
}

impl S {
    fn first(&self) -> &i64 {
        &self.x
    }

    fn add_ref(&mut self, k: &i64) {
        self.x += *k;
    }
}

fn main() {
    let mut s = S { x: 1 };
    s.add_ref(s.first());
    println("{}", s.x);
}
