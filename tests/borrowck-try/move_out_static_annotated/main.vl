// RULE: M3
// (0.30.1) A move out of a static into a `let` with its type written:
// `&SD` there is a `&D` where a D goes (it did not build, and `edit patch`
// refused it, edit.breaks), so no try borrows it; one without the type
// written gets `let t = &SD;` (move_out_static_at, rust_b_err_mv_static_names).
// CODE: borrowck.move_out
// TRY-NOT: &SD
struct D {
    v: i64,
}

static SD: D = D { v: 1 };

fn main() {
    let t2: D = SD;
    println("{}", t2.v);
}
