// RULE: D6.2.1
// The blame path ends at two elided parameter regions (self's, by E3,
// and `o`'s): the try: names one lifetime on both.
// CODE: borrowck.outlives
// TRY: 'a
// Checked since bc271 M3.
struct S {
    x: i64,
}

impl S {
    fn other(&self, o: &i64) -> &i64 {
        if self.x > 0 {
            return o;
        }
        &self.x
    }
}

fn main() {
    let s = S { x: 1 };
    let k: i64 = 2;
    println("{}", *s.other(&k));
}
