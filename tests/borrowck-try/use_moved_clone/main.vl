// EDITION: rust
// RULE: D8.3
// A use after a move of a `Clone` value: the try: clones at the move.
// CODE: borrowck.use_moved
// TRY: .clone()
// XFAIL: bc271 M3: moves on the IR are not reported yet (own.moved reports it today)
#[derive(Clone)]
struct N {
    v: i64,
}

fn main() {
    let n = N { v: 1 };
    let m = n;
    println("{} {}", n.v, m.v);
}
