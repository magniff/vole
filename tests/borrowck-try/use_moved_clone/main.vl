// EDITION: rust
// RULE: D8.3
// A use after a move of a `Clone` value: the try: clones at the move.
// CODE: borrowck.use_moved
// TRY: .clone()
// Checked since bc271 M3.
#[derive(Clone)]
struct N {
    v: i64,
}

fn main() {
    let n = N { v: 1 };
    let m = n;
    println("{} {}", n.v, m.v);
}
