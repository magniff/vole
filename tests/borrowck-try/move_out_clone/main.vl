// EDITION: rust
// RULE: D8.3
// A move out of `*r` of a `Clone` type: the try: clones it.
// CODE: borrowck.move_out
// TRY: .clone()
// Checked since bc271 M3.
#[derive(Clone)]
struct N {
    v: i64,
}

fn f(r: &N) -> N {
    *r
}

fn main() {
    let n = N { v: 1 };
    println("{}", f(&n).v);
}
