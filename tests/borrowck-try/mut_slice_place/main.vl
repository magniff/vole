// RULE: F18.4
// A shared slice of a place where `&mut [T]` goes: rustc's E0308; the
// try: borrows it exclusively.
// CODE: type error
// TRY: &mut a[..]
fn first(v: &mut [i64]) -> i64 {
    v[0] += 1;
    v[0]
}

fn main() {
    let mut a = [1i64, 2];
    let b = first(&a[..]);
    println("{} {}", b, a[0]);
}
