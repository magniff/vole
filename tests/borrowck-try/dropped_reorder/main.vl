// EDITION: rust
// RULE: D9.2
// Two locals of one block, the holder declared first: the try: declares
// the referent before it.
// CODE: borrowck.dropped_borrowed
// TRY: fix
// XFAIL: bc271 M3 (dropck); and own.drop_view rejects a Drop type holding a reference in the rust edition
struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut h = HD { r: &z };
    let x: i64 = 1;
    h = HD { r: &x };
    println("{}", *h.r);
}
