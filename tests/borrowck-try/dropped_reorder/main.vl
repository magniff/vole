// RULE: D9.2
// Two locals of one block, the holder declared first: the try: declares
// the referent before it.
// CODE: borrowck.dropped_borrowed
// TRY: fix
// XFAIL: 0.27.2: the try: needs a line rewrite beyond a node wrap (a hoisted `let`, a moved declaration)
struct HD<'a> {
    r: &'a i64,
}

impl<'a> Drop for HD < 'a > {
    fn drop(&mut self) {
        println("drop {}", *self.r);
    }
}

fn main() {
    let z: i64 = 0;
    let mut h = HD { r: &z };
    let x: i64 = 1;
    h = HD { r: &x };
    println("{}", *h.r);
}
