// EDITION: rust
// RULE: F18.4
// A shared sliced literal where `&mut [T]` goes: rustc's E0308; the try:
// borrows it exclusively.
// CODE: type error
// TRY: &mut [1i64, 2, 3][..]
fn first(v: &mut [i64]) -> i64 {
    v[0] += 1;
    v[0]
}

fn main() {
    println("{}", first(&[1i64, 2, 3][..]));
}
