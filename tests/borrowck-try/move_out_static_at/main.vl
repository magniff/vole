// RULE: M3
// (0.30.1) A move out of a static bound by a match: the try borrows the
// scrutinee by position (`edit patch --at FILE:LINE`), so a line written
// twice in one fn, `match SE {`, is patched where the error is; by the
// item's FILE:LINE it was patch.ambiguous.
// CODE: borrowck.move_out
// TRY: edit patch --at main.vl:25 --old 'match SE {' --new 'match &SE {'
struct D {
    v: i64,
}

enum E {
    A(D),
    B(D),
}

static SE: E = E::A(D { v: 3 });

fn main() {
    let n = match SE {
        E::A(_) => 1,
        E::B(_) => 2,
    };
    println("{}", n);
    match SE {
        E::A(d) => println("{}", d.v),
        E::B(_) => println("b"),
    }
}
