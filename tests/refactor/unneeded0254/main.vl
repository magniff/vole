// `volec fix --only unneeded-unsafe` (0.25.4): the unsafe blocks with
// nothing unsafe inside taken away, the code kept in its scope.
static mut COUNT: i64 = 0;

extern "C" {
    fn strlen(s: *mut u8) -> u64;
}

// The whole body: its lines, one level less indented.
fn add(x: i64) -> i64 {
    unsafe {
        let y = x + 1;
        bump(y);
        y
    }
}

fn two(x: i64) -> i64 {
    // (declares nothing: opened in the middle of the body)
    unsafe {
        bump(1);
    }
    let c = unsafe { count() };
    if unsafe { count() > 3 } {
        return c;
    }
    // (an expression whose operators could bind otherwise: parenthesized)
    let d = 2 * unsafe { c + x };
    unsafe { bump(d); }
    // (declares z and is not last: left, its scope kept)
    unsafe {
        let z = 5;
        bump(z);
    }
    // (needed: a C call)
    let n = unsafe { strlen(c"abc") } as i64;
    unsafe { if x > 0 { d } else { n } }
}

fn three() -> i64 {
    // UNSAFE: kept: its comments say why, a reader's to judge.
    // SAFETY: nothing to it.
    unsafe {
        bump(1);
    }
    // (inside another one taken away: the next run takes it)
    unsafe {
        unsafe {
            bump(2);
        }
        count()
    }
}

fn main() {
    let s = add(1) + two(2) + three();
    unsafe {
        println("{s} {}", count());
    }
}

// COUNT's accessors, safe to call.
fn bump(k: i64) {
    // UNSAFE: COUNT is a static mut.
    // SAFETY: one thread; no reference to COUNT outlives the statement.
    unsafe {
        COUNT += k;
    }
}

fn count() -> i64 {
    // UNSAFE: COUNT is a static mut.
    // SAFETY: one thread; a copy of the value is read.
    unsafe { COUNT }
}
