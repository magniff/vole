// fix --edition rust (0.27.4, gate 3's third wall): an array's address
// cast to a raw pointer is its first element's (`a.as_mut_ptr() as *mut
// u8`, `as_ptr` for a `let` one); a static's `.len` is closed after its
// `()`; an index of any integer type is cast to usize.
static var SRC: [u8] = "";

fn sys(p: *u8, n: i64) -> i64 {
    unsafe { p[0] as i64 + n }
}

fn sum3(p: *i64) -> i64 {
    unsafe { p[0] + p[1] + p[2] }
}

fn main() {
    var attr: [i64; 4] = [7, 0, 0, 0];
    let st: [i64; 3] = [1, 2, 3];
    SRC = "hello";
    let n = SRC.len;
    let k: u64 = 2;
    let m: u8 = 1;
    println("{} {} {} {}", sys(&attr as *u8, 1), sum3(&st as *i64), n, SRC.len + 1);
    println("{} {}", st[k], attr[m]);
}
