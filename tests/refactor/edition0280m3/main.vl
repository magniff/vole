struct Counter { n: inout i64, step: i64 }

impl Counter {
    fn tick(inout self) {
        self.n += self.step;
    }
}

fn bump(c: sink Counter) {
    c.n += 10;
    c.n = c.n * 2;
}

fn main() {
    var x = 1;
    var c = Counter { n: &x, step: 3 };
    c.tick();
    c.tick();
    let seen = c.n + 0;
    bump(c);
    println("{seen} {x}");
}
