mod outer {
    pub mod a {
        pub(super) fn super_fn() -> i64 { 2 }
        pub(self) fn self_fn() -> i64 { 3 }
        pub(in crate::outer::a) fn in_fn() -> i64 { 4 }
        pub struct S { pub(super) s: i64, pub c: i64 }

        pub fn make() -> S {
            S { s: 2, c: 1 }
        }
    }
}

fn main() -> i32 {
    let a = outer::a::super_fn();
    let b = outer::a::self_fn();
    let c = outer::a::in_fn();
    let d = outer::a::make().s;
    (a + b + c + d) as i32
}
