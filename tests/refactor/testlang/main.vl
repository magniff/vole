// A program with tests in the language (0.18): #[test], #[property], a
// snapshot, a contract tested as a property, a test module in a file.
use std::io; use std::fmt::Debug; 

#[derive(Debug, Clone, Copy)]
struct Range { lo: i64, hi: i64 }

// The largest difference between neighbours of a sorted slice.
fn max_gap(v: &[i64]) -> i64 {
    let mut best: i64 = 0;
    for i in 1..v.len() {
        let d = v[i] - v[i - 1];
        if d > best {
            best = d;
        }
    }
    best
}

// A bubble sort that stops one pass early: wrong from three elements.
fn bubble(v: &mut [i64]) {
    if v.len() < 2 {
        return;
    }
    for i in 0..v.len() - 2 {
        for j in 0..v.len() - 1 - i {
            if v[j] > v[j + 1] {
                let t = v[j];
                v[j] = v[j + 1];
                v[j + 1] = t;
            }
        }
    }
}

fn clamp(x: i64, lo: i64, hi: i64) -> i64
    requires lo <= hi
    ensures lo <= result && result <= hi
{
    if x < lo { lo } else if x > hi { hi } else { x }
}

fn span(v: &[i64]) -> Range {
    let mut r = Range { lo: 0, hi: 0 };
    for i in 0..v.len() {
        if i == 0 || v[i] < r.lo {
            r.lo = v[i];
        }
        if i == 0 || v[i] > r.hi {
            r.hi = v[i];
        }
    }
    r
}

fn scale(x: i64) -> i64 {
    x * 12345
}

fn main(gpa: Gpa) -> i32 {
    let mut line = String::new_in(gpa);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    while io::stdin().read_line(&mut line).map(|n| n > 0).unwrap_or(false) {
        v.push(line.trim().parse::<i64>().unwrap_or(0));
        line.clear();
    }
    v.as_mut_slice().sort_unstable();
    println("{} {}", max_gap(v.as_slice()), scale(1));
    line.clear();
    drop(v);
    0
}

