// `volec fix --only statics` with a view (0.26.5,
// tests/refactor/statics0265v.t): `tick` and `tock` are used as values (a
// thread's start, say) and reach the context through a pointer, VIEW.

pub struct Cx {
    pub count: i64,
    pub total: i64,
}

pub fn cx_new() -> Cx {
    Cx { count: 0, total: 7 }
}

static var COUNT: i64 = 0;
static var TOTAL: i64 = 7;

// (the context's address, as C's void *)
static var VIEW: *u8 = 0 as *u8;

fn total_len() -> i64 {
    TOTAL + 1
}

fn bump() -> i64 {
    COUNT += 1;
    COUNT
}

// (a view: its calls are given the context through VIEW, let)
fn tick() -> i64 {
    // UNSAFE: the context is reached through VIEW.
    // SAFETY: VIEW is the owner's context, alive while apply runs.
    unsafe { total_len() }
}

// (a view whose callee changes the context: refused; --prune leaves out
// COUNT, which it writes)
fn tock() -> i64 {
    // UNSAFE: as tick's.
    // SAFETY: as tick's.
    unsafe { bump() }
}

fn apply(f: fn() -> i64) -> i64 {
    f()
}

// (the owner)
fn run() -> i64 {
    apply(tick) + apply(tock) + total_len() + bump()
}

fn main() -> i32 {
    println("{}", run());
    0
}
