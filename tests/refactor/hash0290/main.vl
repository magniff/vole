use std::alloc::Allocator;
use std::collections::{HashMap, HashSet};
use std::hash::BuildHasher;

fn keys(m: &HashMap<i64, i64, Gpa>) -> usize {
    m.len()
}

fn bare(m: &HashMap<i64, i64>, s: &HashSet<i64>) -> usize {
    m.len() + s.len()
}

fn same<S: BuildHasher>(a: &HashSet<i64, Gpa, S>, b: &HashSet<i64, Gpa>) -> usize {
    a.len() + b.len()
}

fn pick<S: BuildHasher, T: BuildHasher>(a: &HashSet<i64, Gpa, S>, b: &HashSet<i64, Gpa, T>,
    c: &HashSet<i64, Gpa>) -> usize {
    a.len() + b.len() + c.len()
}

struct Cache<K, A: Allocator, S: BuildHasher> {
    slots: Vec<K, A>,
    hasher: S,
}

fn slots(c: &Cache<i64, Gpa>) -> usize {
    c.slots.len()
}

fn main(gpa: Gpa) {
    let mut m: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let mut s = HashSet::<i64, Gpa>::new_in(gpa);
    s.insert(3);
    let t: HashSet<i64, Gpa> = HashSet::with_capacity_in(4, gpa);
    let c: Cache<i64, Gpa> = Cache {
        slots: Vec::new_in(gpa), hasher: std::hash::FixedState::new(),
    };
    println("{} {} {} {}", keys(&m), same(&s, &t), pick(&s, &t, &t), slots(&c));
    println("{}", bare(&m, &s));
}
