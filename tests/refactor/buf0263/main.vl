// fix --only buf: each Buf by the evidence of its writes.

struct Log<A: Allocator> {
    lines: Buf<A>,
    count: i64,
}

enum Msg<A: Allocator> {
    Text(Buf<A>),
    Code(i64),
}

const HEAD: [u8] = "head;";

// text: a push_str of a str
fn greet(gpa: Gpa) -> Buf<Gpa> {
    var b = Buf::new_in(gpa);
    b.push_str("hello");
    b
}

// bytes: a push of a byte that is not a constant (through the parameter)
fn put(out: inout Buf<Gpa>, x: u8) {
    out.push(x);
}

// a holder: the Option's Buf is the result's, `Some(b)` the caller's
fn first_word(gpa: Gpa, s: [u8]) -> Option<Buf<Gpa>> {
    if s.len() == 0 {
        return None;
    }
    var w = Buf::new_in(gpa);
    w.push_str(s[0..1]);
    Some(w)
}

// refused: written through a by-value parameter (a Buf there is the
// caller's)
fn more(b: Buf<Gpa>, k: i64) {
    b.push_fmt(" [{k}]");
}

fn main(gpa: Gpa) {
    // text: a format write
    var t = Buf::new_in(gpa);
    t.push_fmt("{} + {} = {}", 1, 2, 3);
    // text: a constant byte below 0x80
    var a = Buf::new_in(gpa);
    a.push('o');
    a.push('k');
    // bytes: a constant byte at or above 0x80
    var hi = Buf::new_in(gpa);
    hi.push(0xC3);
    // bytes: a push_str of a [u8]
    let raw: [u8] = "xyz";
    var r = Buf::new_in(gpa);
    r.push_str(raw);
    put(&r, 7);
    // a field: text
    var log = Log { lines: Buf::new_in(gpa), count: 0 };
    log.lines.push_str("started");
    log.count += 1;
    // bytes: a str (weak text) and a byte, a [u8] constant, an index
    var p = Buf::new_in(gpa);
    p.push_str("dir");
    p.push('/');
    p.push_str(HEAD);
    p[0] = 'D';
    // an enum variant's field, a pattern: text
    var mt = Buf::new_in(gpa);
    mt.push_fmt("{}", 42);
    let msg: Msg<Gpa> = Msg::Text(mt);
    // a closure's capture: one with its local, bytes
    var cap = Buf::new_in(gpa);
    let fill = || put(&cap, 9);
    fill();
    // refused: mixed
    var m = Buf::new_in(gpa);
    m.push_fmt("a");
    let k: u8 = 9;
    m.push(k);
    // refused: passed to std, which takes a Buf
    var f = Buf::new_in(gpa);
    f.push_str("from_buf");
    let fs = String::from_buf(f).unwrap();
    // refused: text, but take has no String form (and what it takes)
    var c = Buf::from_in("taken", gpa);
    let taken = c.take();
    // bytes: no write
    var e = Buf::new_in(gpa);
    var lp = Buf::new_in(gpa);
    more(lp, 3);
    let g = greet(gpa);
    println(g.as_slice());
    println(t.as_slice());
    println(a.as_slice());
    println(hi.len() as i64);
    println(r.len() as i64);
    println(log.lines.as_slice());
    println(p.as_slice());
    match msg {
        Msg::Text(s) => println(s.as_slice()),
        Msg::Code(n) => println(n),
    }
    match first_word(gpa, "vole") {
        Some(w) => println(w.as_slice()),
        None => println("none"),
    }
    println(cap.len() as i64 + lp.len() as i64);
    println(fs.as_str());
    println(taken.as_slice());
    println(m.len() as i64 + e.len() as i64);
}
