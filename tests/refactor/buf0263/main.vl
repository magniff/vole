// fix --only buf: each Buf by the evidence of its writes.

struct Log<A: Allocator> {
    lines: Buf<A>,
    count: i64,
}

// text: a push_str of a str
fn greet(gpa: Gpa) -> Buf<Gpa> {
    var b = Buf::new_in(gpa);
    b.push_str("hello");
    b
}

// bytes: a push of a byte that is not a constant (through the parameter)
fn put(out: inout Buf<Gpa>, x: u8) {
    out.push(x);
}

fn main(gpa: Gpa) {
    // text: a format write
    var t = Buf::new_in(gpa);
    t.push_fmt("{} + {} = {}", 1, 2, 3);
    // text: a constant byte below 0x80
    var a = Buf::new_in(gpa);
    a.push('o');
    a.push('k');
    // bytes: a constant byte at or above 0x80
    var hi = Buf::new_in(gpa);
    hi.push(0xC3);
    // bytes: a push_str of a [u8]
    let raw: [u8] = "xyz";
    var r = Buf::new_in(gpa);
    r.push_str(raw);
    put(&r, 7);
    // a field: text
    var log = Log { lines: Buf::new_in(gpa), count: 0 };
    log.lines.push_str("started");
    log.count += 1;
    // refused: mixed
    var m = Buf::new_in(gpa);
    m.push_str("a");
    let k: u8 = 9;
    m.push(k);
    // refused: passed to std, which takes a Buf
    var f = Buf::new_in(gpa);
    f.push_str("from_buf");
    let fs = String::from_buf(f).unwrap();
    // refused: text, but take has no String form
    var c = Buf::from_in("taken", gpa);
    let taken = c.take();
    // refused: no write
    var e = Buf::new_in(gpa);
    let g = greet(gpa);
    println(g.as_slice());
    println(t.as_slice());
    println(a.as_slice());
    println(hi.len() as i64);
    println(r.len() as i64);
    println(log.lines.as_slice());
    println(fs.as_str());
    println(taken.as_slice());
    println(m.len() as i64 + e.len() as i64);
}
