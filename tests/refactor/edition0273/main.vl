// fix --edition rust (0.27.3): an MVS program of each rewrite kind.
use std::HashMap;

static var CALLS: i64 = 0;

#[derive(Eq, Debug)]
struct Money { cents: i64 }

impl Add for Money {
    fn add(self, o: Money) -> Money { Money { cents: self.cents + o.cents } }
}

impl Display for Money {
    fn fmt(self, f: inout Fmt) { f.write("${}.{}", self.cents / 100, self.cents % 100); }
}

struct Ledger<A: Allocator> { names: Vec<i64, A>, total: i64 }

impl Ledger<Gpa> {
    fn count(self) -> usize { self.names.len() }
    fn add(inout self, n: i64) { self.names.push(n); self.total += n; }
}

fn label(n: i64) -> [u8] { if n > 10 { "big" } else { "small" } }

fn sum(v: [i64]) -> i64 {
    var t = 0;
    for x in v {
        t += x;
    }
    t
}

fn bump(n: inout i64) {
    n += 1;
    CALLS += 1;
}

fn total(l: Ledger<Gpa>) -> i64 { l.total }

fn none() -> *u8 { 0 as *u8 }

fn main(gpa: Gpa) {
    var l = Ledger { names: Vec::new_in(gpa), total: 0 };
    l.add(5);
    l.add(20);
    var k = 1;
    bump(&k);
    inout r = &k;
    r += 10;
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in [4, 1, 3] {
        v.push(x);
    }
    v.sort();
    var seen: HashMap<i64, i64, Gpa> = HashMap::new_in(gpa);
    seen.insert(1, 2);
    let a = Money { cents: 150 };
    let b = Money { cents: 275 };
    println(label(total(l)));
    println("{} {} {} {}", l.count(), k, v.get(0), sum(v[1..]));
    println("{} {} {}", a + b, seen.contains_key(1), CALLS);
    let arr = [7, 8, 9];
    let i = 1;
    println("{} {CALLS} {}", arr[i + 1], none() == 0 as *u8);
}
