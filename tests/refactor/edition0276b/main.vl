// fix --edition rust (0.27.6): the classes the std::gpu::wgsl port found.
// A prelude variant's `use` goes; Buf<A> is Vec<u8, A>; a Buf's
// push_fmt, push_str and len through a field or a parameter take their
// rows (`len` once); a text literal where a row's bytes go is b".."; a
// bytes hole of a function's format call is bound by a `let`; parse_f64
// of bytes is str::from_utf8's; a non-Copy element bound by `let` is a
// reference.
use std::Option::Some;
use std::{Allocator, Buf, Gpa, Vec};

pub struct Fr<A: Allocator> {
    pub emsg: Buf<A>,
}

impl<A: Allocator> Fr<A> {
    pub fn err(inout self, what: [u8]) {
        self.emsg.push_str("ref to ");
        self.emsg.push_fmt("'{what}' is not here");
    }
}

fn note(out: inout Buf<Gpa>, what: [u8]) {
    out.push_fmt("'{what}' is not here");
}

fn num(s: [u8]) -> f64 {
    std::num::parse_f64(s[0..3]).unwrap_or(0.0)
}

fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

struct F<A: Allocator> {
    params: Vec<i64, A>,
}

fn count(fs: Vec<F<Gpa>, Gpa>) -> i64 {
    let f = fs[0];
    f.params.len as i64
}

fn main(gpa: Gpa) {
    var f = Fr { emsg: Buf::new_in(gpa) };
    f.err("x");
    var b: Vec<u8, Gpa> = Vec::new_in(gpa);
    b.push('1');
    b.push('.');
    b.push('5');
    b.push('x');
    var out = Buf::new_in(gpa);
    note(&out, b[3..4]);
    var fs: Vec<F<Gpa>, Gpa> = Vec::new_in(gpa);
    var p: Vec<i64, Gpa> = Vec::new_in(gpa);
    p.push(1);
    fs.push(F { params: p });
    match half(4) {
        Some(h) => println("{} {} {} {} {}", f.emsg.len, out.len, num(b.as_slice()), h, count(fs)),
        None => println("odd"),
    }
}
