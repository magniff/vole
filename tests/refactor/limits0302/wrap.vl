// Three locals of 2^62 bytes: their frame's sum passes 2^63 (RT-466c).
#[inline(never)]
fn three(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; 1usize << 62];
        let b = [1u8; 1usize << 62];
        let c = [2u8; 1usize << 62];
        return a[n] + b[n] + c[n];
    }
    7
}

fn main() {
    println("{}", three(std::env::args().count()));
}
