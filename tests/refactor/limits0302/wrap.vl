// Five locals of 2^61 - 8 bytes, each of a type that fits (below 2^61):
// their frame's sum passes 2^63 (RT-466c). (0.30.3: a local of 2^62
// bytes, the first form, is a type too big for the target, refused before
// its frame is laid out, RT-M2-9.)
#[inline(never)]
fn five(n: usize) -> u8 {
    if n > 5 {
        let a = [0u8; (1usize << 61) - 8];
        let b = [1u8; (1usize << 61) - 8];
        let c = [2u8; (1usize << 61) - 8];
        let d = [3u8; (1usize << 61) - 8];
        let e = [4u8; (1usize << 61) - 8];
        return a[n] + b[n] + c[n] + d[n] + e[n];
    }
    7
}

fn main() {
    println("{}", five(std::env::args().count()));
}
