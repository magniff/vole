// The compilation's allocator: zero-sized, so `Comp {}` is a constant a
// static can hold.
use crate::base::{free, malloc, realloc};

pub struct Comp {}

impl Allocator for Comp {
    fn try_alloc(self: *Comp, size: i64, align: i64) -> *u8 {
        if align > 16 {
            return 0 as *u8;
        }
        unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
    }

    unsafe fn try_resize(self: *Comp, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        if align > 16 {
            return 0 as *u8;
        }
        realloc(p, if new_size == 0 { 1 } else { new_size } as u64)
    }

    unsafe fn free(self: *Comp, p: *u8, size: i64, align: i64) {
        free(p);
    }
}
