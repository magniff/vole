// refactor table's cases (tests/refactor/table254.t): four tables, two
// of them refused.
mod base;
mod count;
mod items;
mod marks;
mod refused;
mod report;
mod tokens;

use crate::items::{ITEM_COUNT, add_item, add_pair, drop_last, drop_some, reset_items, total};
use crate::marks::{last, mark};
use crate::tokens::{TOK_COUNT, add_tok, reserve_toks};

fn main() {
    add_item(9);
    reset_items();
    for v in 1..6 {
        add_item(v);
    }
    add_pair(10);
    drop_last(1);
    drop_some(2);
    mark(7);
    mark(8);
    reserve_toks(50);
    for t in 0..100 {
        add_tok(t);
    }
    println(f"{ITEM_COUNT} {total()} {crate::items::PLACES} {crate::count::count()}");
    println(f"{crate::marks::MARK_COUNT} {last()} {crate::marks::seen(1)}");
    println(f"{TOK_COUNT} {crate::tokens::tok(99)} {crate::report::report()}");
    println(f"{crate::tokens::try_toks(5)} {TOK_COUNT}");
    println(f"{crate::refused::add_bad(3)} {crate::refused::room()}");
}
