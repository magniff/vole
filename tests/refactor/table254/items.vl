// A table: ITEMS, ITEM_COUNT, ITEM_CAP, grown by grow.
use crate::base::grow;

pub struct Item {
    pub v: i64,
    pub next: i64,
}

pub static var ITEMS: *Item = 0 as *Item;
pub static var ITEM_COUNT: i64 = 0;
static var ITEM_CAP: i64 = 0;
// What add_item saw of the count between its store and its increment.
pub static var PLACES: i64 = 0;

// The store, reads after it, the increment after the unsafe block.
pub fn add_item(v: i64) -> i64 {
    unsafe {
        ITEMS = grow(ITEMS, ITEM_COUNT, &ITEM_CAP);
        ITEMS[ITEM_COUNT] = Item { v, next: ITEM_COUNT + 1 };
        PLACES += ITEM_COUNT * 2 + (ITEM_COUNT + 1);
    }
    ITEM_COUNT += 1;
    ITEM_COUNT - 1
}

// The store at a local set to the count.
pub fn add_pair(v: i64) -> i64 {
    unsafe {
        ITEMS = grow(ITEMS, ITEM_COUNT, &ITEM_CAP);
        let n = ITEM_COUNT;
        ITEMS[n] = Item { v, next: -1 };
        ITEM_COUNT += 1;
        n
    }
}

pub fn reset_items() {
    ITEM_COUNT = 0;
}

pub fn drop_last(k: i64) {
    ITEM_COUNT -= k;
}

pub fn drop_some(k: i64) {
    ITEM_COUNT -= k - 1;
}

pub fn total() -> i64 {
    var s = 0;
    for i in 0..ITEM_COUNT {
        s += unsafe { ITEMS[i].v };
    }
    s
}
