// Tables refactor table refuses: each use it cannot place is listed.
use crate::base::{free, grow};

pub struct Bad {
    pub v: i64,
}

pub static var BADS: *Bad = 0 as *Bad;
pub static var BAD_COUNT: i64 = 0;
static var BAD_CAP: i64 = 0;

fn peek(b: *Bad) -> i64 {
    unsafe { (*b).v }
}

fn noted() -> i64 {
    BAD_COUNT
}

pub fn add_bad(v: i64) -> i64 {
    unsafe {
        BADS = grow(BADS, BAD_COUNT, &BAD_CAP);
        BADS[BAD_COUNT] = Bad { v };
        noted();
    }
    BAD_COUNT += 1;
    unsafe { peek(&BADS[0]) }
}

pub fn set_count(n: i64) {
    BAD_COUNT = n;
}

pub fn room() -> i64 {
    BAD_CAP - BAD_COUNT
}

pub fn clear_all() {
    unsafe {
        free(BADS as *u8);
    }
    BADS = 0 as *Bad;
}

// A return between the store and the increment.
pub static var RETS: *i64 = 0 as *i64;
pub static var RET_COUNT: i64 = 0;
static var RET_CAP: i64 = 0;

pub fn add_ret(v: i64) {
    unsafe {
        RETS = grow(RETS, RET_COUNT, &RET_CAP);
        RETS[RET_COUNT] = v;
        if v < 0 {
            return;
        }
    }
    RET_COUNT += 1;
}

// (0.25.5) A call in an index that may grow the table: BADS's buffer and
// length are read before add_bad pushes (through again, a caller of it);
// a call that only reads the count is no problem.
fn again() -> i64 {
    add_bad(2)
}

pub fn new_value() -> i64 {
    unsafe { BADS[again()].v + BADS[noted() - 1].v }
}
