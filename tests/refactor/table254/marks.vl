// A table whose increment comes before its store (at a local set before).
use crate::base::grow;

pub struct Mark {
    pub at: i64,
    pub seen: i64,
}

pub static var MARKS: *Mark = 0 as *Mark;
pub static var MARK_COUNT: i64 = 0;
pub static var MARK_CAP: i64 = 0;

pub fn mark(at: i64) -> i64 {
    unsafe {
        let id = MARK_COUNT;
        MARKS = grow(MARKS, MARK_COUNT, &MARK_CAP);
        MARK_COUNT += 1;
        let seen = MARK_COUNT - 1 + MARK_COUNT * 10;
        MARKS[id] = Mark { at, seen: seen + MARK_COUNT };
        id
    }
}

pub fn last() -> i64 {
    unsafe { MARKS[MARK_COUNT - 1].at }
}

pub fn seen(i: i64) -> i64 {
    unsafe { MARKS[i].seen }
}
