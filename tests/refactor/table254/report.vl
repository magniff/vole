// The table read from another module, by its import and by its path.
use crate::items::{ITEMS, ITEM_COUNT};

pub fn report() -> i64 {
    var s = 0;
    for i in 0..ITEM_COUNT {
        s += unsafe { ITEMS[i].next };
    }
    s + crate::items::ITEM_COUNT * 100 + unsafe { crate::items::ITEMS[0].v }
}
