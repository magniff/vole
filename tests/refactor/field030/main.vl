// A table in the middle of a conversion: `regs` and `uses` are IntVecs
// that should be Vecs.
struct IntVec {
    data: [i64; 4],
    count: i64,
}

impl IntVec {
    fn new() -> IntVec {
        IntVec { data: [0; 4], count: 0 }
    }

    fn push(&mut self, v: i64) {
        self.data[self.count as usize] = v;
        self.count += 1;
    }

    fn get(&self, i: i64) -> i64 {
        self.data[i as usize]
    }
}

struct Cx {
    regs: IntVec,
    uses: IntVec,
    spare: IntVec,
    depth: i64,
}

fn total(cx: &Cx) -> i64 {
    cx.regs.get(0) + cx.uses.get(1) + cx.spare.get(0) + cx.depth
}

fn fill(cx: &mut Cx) {
    cx.regs.push(1);
    cx.uses.push(2);
    cx.uses.push(3);
    cx.spare.push(4);
}

fn main(gpa: Gpa) -> i32 {
    let mut cx = Cx { regs: IntVec::new(), uses: IntVec::new(), spare: IntVec::new(), depth: 0 };
    fill(&mut cx);
    total(&cx) as i32
}
