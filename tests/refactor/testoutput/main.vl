fn main() {
    println("hello");
    eprintln("warning: on stderr");
}

#[test]
fn prints_ok() {
    println("value is 42");
    eprintln("to stderr 7");
}

#[test]
fn quiet_ok() {
    assert(true);
}

#[test]
fn prints_and_fails() {
    println("x = 3");
    eprintln("note from the test");
    assert(1 + 1 == 3);
}

#[test]
fn errs() -> Result<(), [u8]> {
    println("before the Err");
    Result::Err("bad thing")
}

#[property]
fn small(x: u8) {
    println(f"x={x}");
    assert(x < 200);
}

#[property]
fn fine(x: u8) {
    println(f"x={x}");
}
