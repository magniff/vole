fn side(n: &mut i64) -> i64 {
    *n += 1;
    *n
}

fn enabled(x: i64) -> bool {
    println("checking {x}");
    true
}

fn main() -> i32 {
    let mut c = 0;
    if enabled(side(&mut c)) {
        println("on");
    } else {
        println("off");
    }
    let b = enabled(2) && c > 0;
    println("{c} {b}");
    0
}
