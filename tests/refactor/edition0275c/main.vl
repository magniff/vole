// fix --edition rust (0.27.5, F0.6): `&str` is no `&[u8]` in the rust
// edition, as in Rust. A text literal whose value goes where bytes are
// declared is `b".."`: compared with bytes, an `if` branch, an array's
// element, a field, an assignment, a match arm, a tuple's part. A value
// declared text given there is `.as_bytes()`: a `str` binding, a local
// of literals, an element of a local array of them, a tuple pattern's.
struct Help {
    cmd: [u8],
    n: i64,
}

fn count(b: [u8]) -> i64 {
    b.len() as i64
}

fn kind(k: i64) -> [u8] {
    match k {
        0 => "zero",
        _ => "many",
    }
}

fn pair(c: bool) -> ([u8], i64) {
    if c { ("yes", 1) } else { ("no", 0) }
}

fn word(c: bool) -> ([u8], i64) {
    let (w, n) = if c { ("long", 4) } else { ("", 0) };
    if n > 0 { (w, n) } else { ("none", 0) }
}

fn main() {
    let c = std::env::args().count() > 5;
    let path: [u8] = "main.vl";
    let name: str = "text";
    let open: [u8] = if c { "" } else if path.len() > 20 { "[" } else { "(" };
    let list: [[u8]; 2] = ["b", "cd"];
    var head: [u8] = "x";
    head = "head";
    let h = Help { cmd: "help", n: 1 };
    let m = if c { "7" } else { "15" };
    let kws = ["fn ", "struct "];
    var hits: i64 = 0;
    if path[path.len() - 3..] == ".vl" {
        hits += 1;
    }
    if path != "other.vl" {
        hits += 1;
    }
    if path.ends_with(".vl") {
        hits += 1;
    }
    let (p, pn) = pair(!c);
    let (w, wn) = word(!c);
    println("{} {} {} {} {}", hits, count(name), count(open), list.len(), count(head));
    println("{} {} {} {}", count(h.cmd) + h.n, count(kind(0)), count(list[1]), count(m));
    println("{} {} {} {}", count(kws[1]), count(p) + pn, count(w) + wn, path[0] as i64);
}
