struct P {
    x: i64,
}

// The methods of P.
impl P {
    // x, doubled.
    fn twice(&self) -> i64 {
        self.x * 2
    }
}

// One.
// (a second line)
fn one() -> i64 {
    1
}

// Two.
fn two() -> i64 {
    2
}

#[inline]
// Three.
fn three() -> i64 {
    3
}

fn main() -> i32 {
    let p = P { x: 1 };
    (p.twice() + one() + two() + three()) as i32
}
