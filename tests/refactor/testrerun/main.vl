use std::{fs, io};
use std::thread::sleep;
use std::time::Duration;

fn main(gpa: Gpa) -> i32 {
    let mut l = String::new_in(gpa);
    while io::stdin().read_line(&mut l).map(|n| n > 0).unwrap_or(false) {
        let t = l.trim_end();
        if t == "once" {
            // stalls on its first run only (a marker file)
            if !std::fs::exists("stalled").unwrap_or(false) {
                fs::write("stalled", "x\n").ok().unwrap();
                sleep(Duration::from_secs(5u64));
            }
        }
        if t == "forever" {
            sleep(Duration::from_secs(100u64));
        }
        println("{t}");
        l.clear();
    }
    0
}
