use std::{Buf, Gpa, println, read_line};
use std::fs;
use std::time::sleep;
use std::time::Duration;

fn main(gpa: Gpa) -> i32 {
    var l = Buf::new_in(gpa);
    while read_line(&l).unwrap_or(false) {
        if l.as_slice() == "once" {
            // stalls on its first run only (a marker file)
            if !fs::exists("stalled") {
                fs::write("stalled", "x\n").unwrap();
                sleep(Duration::from_secs(5));
            }
        }
        if l.as_slice() == "forever" {
            sleep(Duration::from_secs(100));
        }
        println(l.as_slice());
    }
    0
}
