use std::ops::{Index, IndexMut};

#[derive(Clone, Copy)]
pub struct Row {
    pub reg: i64,
    pub len: i64,
}

pub struct Tab {
    pub rows: [Row; 4],
    pub n: usize,
}

impl Tab {
    pub fn new() -> Tab {
        Tab { rows: [Row { reg: 0, len: 0 }; 4], n: 0 }
    }

    pub fn push(&mut self, r: Row) {
        self.rows[self.n] = r;
        self.n += 1;
    }

    pub fn get(&self, i: usize) -> &Row {
        &self.rows[i]
    }
}

impl Index<usize> for Tab {
    type Output = Row;

    fn index(&self, i: usize) -> &Row {
        self.get(i)
    }
}

impl IndexMut<usize> for Tab {
    fn index_mut(&mut self, i: usize) -> &mut Row {
        &mut self.rows[i]
    }
}

pub fn at(t: &Tab, i: usize) -> Row {
    *t.get(i)
}

pub fn raw_at(t: &Tab, i: usize) -> Row {
    *t.get(i)
}

pub fn first(t: &Tab) -> Row {
    *t.get(0)
}

// Twice the length of s.
pub fn twice_len(s: &[u8]) -> i64 {
    s.len() as i64 * 2
}

// 1 for a C string, 0 for none.
pub fn tag(s: *const u8) -> i64 {
    if s == 0 as *const u8 { 0 } else { 1 }
}
