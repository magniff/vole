mod tab;

use crate::tab::{Row, Tab, at, first, raw_at, tag, twice_len};

fn main() -> i32 {
    let mut t = Tab::new();
    t.push(Row { reg: 1, len: 2 });
    t.push(Row { reg: 3, len: 4 });
    let a = at(&t, 0).reg;
    let b = raw_at(&t, 1).len;
    let c = (at(&t, (1))).len;
    let d = first(&t).reg + (0);
    let n = twice_len(b"vole") + b"abc".len() as i64 * 2;
    let m = tag(c"malloc") + tag(c"calloc");
    (a + b + c + d + n + m) as i32
}
