use std::alloc::Allocator;

struct Ring<T, A: Allocator> {
    items: Vec<T, A>,
    spare: Vec<T>,
    head: usize,
}

impl<T: Copy> Ring<T> {
    fn all(&self) -> &Vec<T> {
        let v: &Vec<T> = &self.items;
        v
    }

    fn count(&self, other: &Vec<T>) -> usize {
        other.len() + self.head + self.spare.len()
    }
}

fn same<T: Copy, B: Allocator>(v: &Vec<T, B>) -> &Vec<T> {
    v
}

fn both<T: Copy, B: Allocator, C: Allocator>(v: &Vec<T, B>, w: &Vec<T>) -> usize {
    v.len() + w.len()
}

fn plain(gpa: Gpa) -> Vec<i32> {
    Vec::new_in(gpa)
}

fn main(gpa: Gpa) {
    let mut r: Ring<i64, Gpa> = Ring { items: Vec::new_in(gpa), spare: Vec::new_in(gpa), head: 0 };
    r.items.push(1);
    let a = r.all();
    let n = r.count(a);
    let b = same(a);
    let c = both(a, b);
    let d = plain(gpa);
    let done: bool = 3;
    println("{n} {c} {} {done}", d.len());
}
