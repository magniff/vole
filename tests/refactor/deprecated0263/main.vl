use std::fmt::Debug; mod m {
    #[deprecated(since = "0.26.3", note = "use new_fn")]
    pub fn old_fn() -> i64 {
        1
    }

    pub fn new_fn() -> i64 {
        2
    }

    #[derive(Clone, Copy)] #[deprecated = "use Point"]
    pub struct OldPoint {
        pub x: i64,
    }

    #[derive(Debug, Clone, Copy)]
    pub struct P {
        #[deprecated(note = "use y")]
        pub x: i64,
        pub y: i64,
    }

    impl P {
        #[deprecated]
        pub fn get(self) -> i64 {
            self.y
        }
    }

    #[deprecated]
    pub const OLD: i64 = 3;
}

use m::old_fn;

fn take(p: m::OldPoint) -> i64 {
    p.x
}

fn main() {
    let a = old_fn();
    let b = m::old_fn() + m::new_fn();
    let p = m::P { x: 1, y: 2 };
    let c = p.x + p.get();
    let o = m::OldPoint { x: 5 };
    println("{} {} {} {} {}", a, b, c, take(o), m::OLD);
}
