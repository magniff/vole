// Two impls of Tr for W<'a>: a blanket one for every Sup and W's own.
// Coherence refuses them (trait.overlap); with that error planted away,
// the places must not pick one: trait.ambiguous.
trait Sup {}
trait Tr {}
struct W<'a> { r: &'a i64 }
impl<'a> Sup for W<'a> {}
impl<T: Sup> Tr for T {}
impl<'a> Tr for W<'a> {}
fn go<T: Tr>(t: &T) -> i64 { 1 }

fn main() {
    let v: i64 = 7;
    println("{}", go(&W { r: &v }));
}
