// A chain of three impls the front proves, `W<W<W<i64>>>: Tr` by `impl<T:
// Tr> Tr for W<T>`; a short borrow inside keeps the places walking it.
trait Tr { fn d(&self) -> i64; }
struct W<T> { t: T }
impl Tr for i64 { fn d(&self) -> i64 { 0 } }
impl<T: Tr> Tr for W<T> { fn d(&self) -> i64 { 1 + self.t.d() } }
struct R<'a> { r: &'a i64 }
impl<'a> Tr for R<'a> { fn d(&self) -> i64 { *self.r } }
fn go<T: Tr>(t: &T) -> i64 { t.d() }

fn main() {
    let v: i64 = 7;
    let w = W { t: W { t: W { t: R { r: &v } } } };
    println("{}", go(&w));
}
