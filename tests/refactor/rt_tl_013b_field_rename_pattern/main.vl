#[derive(Debug)]
struct P {
    a: i64,
    b: i64,
}

#[derive(Debug)]
enum E {
    K { a: i64 },
}

fn mk(a: i64) -> P {
    P { a, b: 2 }
}

fn main() -> i32 {
    let p = mk(1);
    let P { a, .. } = p;
    let P { a: x, b } = mk(5);
    let e = E::K { a: 9 };
    let E::K { a: ea } = e;
    let q = P { b, a };
    println("{a} {x} {b} {ea} {q:?} {:?}", mk(3));
    0
}
