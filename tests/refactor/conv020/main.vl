struct Counter<A: Allocator> { n: i64, log: Vec<i64, A> }
struct Parser<A: Allocator> { toks: [i64], pos: i64, out: &mut Vec<i64, A> }

impl Counter<Gpa> {
    fn get(self: &Counter<Gpa>) -> i64 { self.n }
    fn bump(self: &mut Counter<Gpa>) { self.n += 1; self.log.push(self.n); }
    fn finish(self: Counter<Gpa>) -> i64 { self.log.len() as i64 }
}

impl Parser<Gpa> {
    fn item(self: &mut Parser<Gpa>) { self.out.push(self.toks[self.pos]); self.pos += 1; }
}

fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut s = 0;
    for i in 0..v.len() { s += v[i]; }
    s
}

fn fill(v: &mut Vec<i64, Gpa>, n: i64) {
    for i in 0..n { v.push(i); }
}

fn fill_twice(v: &mut Vec<i64, Gpa>) { fill(v, 1); fill(v, 2); }

fn report(a: &i64, out: &mut i64) { *out += *a; }

fn consume(v: Vec<i64, Gpa>) -> i64 { v.len() as i64 }

fn countdown(mut n: i64) -> i64 { let mut k = 0; while n > 0 { n -= 1; k += 1; } k }

fn parse(toks: [i64], out: &mut Vec<i64, Gpa>) {
    let mut p = Parser { toks: toks, pos: 0, out: out };
    while p.pos < p.toks.len() as i64 { p.item(); }
}

static mut HITS: i64 = 0;

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    fill(&mut v, 4);
    fill_twice(&mut v);
    println(total(&v));
    let r = &mut v;
    fill(r, 2);
    r.push(9);
    let mut sum = 0;
    let k = 5;
    report(&k, &mut sum);
    println(sum);
    let mut c = Counter { n: 0, log: Vec::new_in(gpa) };
    c.bump();
    println(c.get());
    println(c.finish());
    let f = move || k + 1;
    println(f());
    unsafe { HITS += 1; println(HITS); }
    let mut out: Vec<i64, Gpa> = Vec::new_in(gpa);
    let toks = [7, 8, 9];
    parse(toks[..], &mut out);
    println(out.len());
    let shared = &v;
    println(shared.len());
    println(countdown(3));
    println(consume(v));
}
