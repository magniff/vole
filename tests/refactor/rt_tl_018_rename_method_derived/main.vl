#[derive(Clone, Debug, PartialEq)]
struct S {
    v: i64,
}

impl S {
    fn dup(&self) -> S {
        S { v: self.v + 100 }
    }

    fn len2(&self) -> usize {
        7
    }
}

fn main() -> i32 {
    let s = S { v: 1 };
    let a = s.clone();
    let b = s.dup();
    let w = "abc";
    println("{:?} {:?} {}", a, b, w.len());
    0
}
