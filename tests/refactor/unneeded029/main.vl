// `volec fix --only unneeded-unsafe` (0.29): the shapes written over
// several lines, the blocks that declare, and why a block is left.
use std::alloc::Allocator;

struct Table<A: Allocator> {
    cells: Vec<i64, A>,
    width: i64,
}

// A function's whole body, an expression over two lines.
fn cell_at(table: &Table<Gpa>, row: i64, column: i64) -> i64 { unsafe { (
    table.cells[(row * table.width + column) as usize]) } }

fn first_cells(table: &Table<Gpa>, rows_wanted: i64) -> &[i64] {
    unsafe { &table.cells[
        (0 * table.width) as usize..(rows_wanted * table.width + table.width - table.width) as usize] }
}

fn row_sum_is(table: &Table<Gpa>, row: i64, wanted: i64) -> bool {
    unsafe { same(
        cell_at(table, row, 0) + cell_at(table, row, 1) + cell_at(table, row, 2) + cell_at(table,
            row, 3),
        wanted) }
}

fn same(a: i64, b: i64) -> bool {
    a == b
}

fn conditions(table: &Table<Gpa>, gpa: Gpa) -> i64 {
    let mut open: Vec<i64, Gpa> = Vec::new_in(gpa);
    open.push(1);
    open.push(2);
    open.push(7);
    // a `while` condition
    while unsafe {
        open.len() as i64 > 0
            && (open[(open.len() as i64 - 1) as usize])
            != cell_at(table, 0, 1) + cell_at(table, 0, 0)
    } {
        open.pop();
    }
    // an `if` condition
    if unsafe {
        cell_at(table, 0, 0) == 1 && cell_at(table, 0, 1) == 2 && cell_at(table, 0, 2) == 3
            && cell_at(table, 0, 3) == 4 && row_sum_is(table, 0, 10)
    } {
        open.push(5);
    }
    // a `let`'s value
    let corner = unsafe {
        (table.cells[
            ((table.cells.len() as i64 / table.width - 1) * table.width + table.width - 1) as usize])
    };
    // an operand, on a line of its statement
    // UNSAFE: the table was a raw one; every read was.
    // SAFETY: two cells at least before the second from the end is read.
    while open.len() as i64 >= 2
        && unsafe { (open[(open.len() as i64 - 2) as usize]) }
    >= corner + cell_at(table, 0, 0) + cell_at(table, 0, 1) + cell_at(table, 0, 2) + 100 {
        open.pop();
    }
    // two blocks under one comment
    // UNSAFE: a raw pointer was given to both calls.
    // SAFETY: it pointed to the table for both.
    let both = cell_at(unsafe { &*table }, 1, 1) == cell_at(unsafe { &*table }, 1, 1);
    // statements where an expression stands: a plain block
    let total = unsafe {
        let a = cell_at(table, 1, 0);
        a + corner
    };
    open.len() as i64 + total + if both { 1 } else { 0 }
}

// A block that declares, followed by the value of the block around it:
// opened, as nothing runs between the two ends.
fn find(table: &Table<Gpa>, wanted: i64) -> bool {
    unsafe {
        let mut i: i64 = 0;
        while i < table.cells.len() as i64 {
            if (table.cells[i as usize]) == wanted {
                return true;
            }
            i += 1;
        }
    }
    false
}

// A block that declares what the code after it names too, or is followed
// by code that runs: a plain block.
fn shadowed(table: &Table<Gpa>) -> i64 {
    let n = cell_at(table, 0, 0);
    unsafe {
        let n = cell_at(table, 1, 0);
        println("{n}");
    }
    unsafe {
        let m = cell_at(table, 1, 1);
        println("{m}");
    }
    println("{n}");
    n
}

// Left: the comments above justify a block that stays too.
fn kept(table: &Table<Gpa>, p: *mut i64) -> i64 {
    // UNSAFE: p is a raw pointer.
    // SAFETY: p points to a live i64, main's.
    let v = cell_at(unsafe { &*table }, 0, 0) == 1 && unsafe { *p } == 1;
    // (an expression ending in a comment: left)
    let w = unsafe {
        cell_at(table, 0, 1) // the second
    };
    w + if v { 1 } else { 0 }
}

fn main(gpa: Gpa) {
    let mut cells: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..8 {
        cells.push(i + 1);
    }
    let table = Table { cells: cells, width: 4 };
    let mut one: i64 = 1;
    println("{} {} {}", cell_at(&table, 1, 2), first_cells(&table, 1).len(),
        row_sum_is(&table, 0, 10));
    println("{} {} {}", conditions(&table, gpa), find(&table, 7), shadowed(&table));
    println("{}", kept(&table, &mut one as *mut i64));
}
