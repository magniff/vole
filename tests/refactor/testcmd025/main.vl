// (0.25) a contract whose requires the small values rarely meet (the
// -O0 run's 20 cases discard more than -O2's 100: no DIFF), and a
// #[property] that takes the test's allocator.
fn wrap(i: i64, cap: i64) -> i64
    requires cap > 0 && 0 <= i && i - cap < cap
    ensures result < cap
{
    if i >= cap { i - cap } else { i }
}

#[property]
fn copies(xs: &Vec<i64, Gpa>, gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for x in xs.iter().copied() {
        v.push(x);
    }
    assert(v.len() == xs.len());
}

fn main() -> i32 {
    println("{}", wrap(3, 2));
    0
}
