// (0.25.3) A closure's by-value parameter is dropped at the end of its
// body: each #[test] is built with --check-alloc, so a parameter left
// undropped fails it as a leak (it did before 0.25.3).
fn make(gpa: Gpa, n: i64) -> Vec<i64, Gpa> {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn feed<F: FnMut(Vec<i64, Gpa>) -> i64>(f: F, gpa: Gpa) -> i64 {
    f(make(gpa, 1)) + f(make(gpa, 2))
}

struct Holder<F> {
    f: F,
}

#[test]
fn called_once(gpa: Gpa) {
    let f = |v: Vec<i64, Gpa>| v.len() as i64;
    assert(f(make(gpa, 3)) == 3);
}

#[test]
fn called_many_times(gpa: Gpa) {
    let f = |v: Vec<i64, Gpa>| v.len() as i64;
    let mut total: i64 = 0;
    for i in 0..10 {
        total += f(make(gpa, i));
    }
    assert(total == 45);
}

#[test]
fn stored_and_called_later(gpa: Gpa) {
    let h = Holder { f: |v: Vec<i64, Gpa>| v.len() };
    let a = make(gpa, 4);
    assert((h.f)(a) == 4);
}

#[test]
fn through_a_bound(gpa: Gpa) {
    assert(feed(|v| v.len() as i64, gpa) == 3);
}

#[test]
fn adapters(gpa: Gpa) {
    let m: i64 = (0i64..4i64).map(|i| make(gpa, i)).map(|v| v.len() as i64).sum();
    assert(m == 6);
    let n = (0i64..4i64).map(|i| make(gpa, i)).filter(|v| v.len() > 1).count();
    assert(n == 2);
    let mut seen: i64 = 0;
    (0i64..4i64).map(|i| make(gpa, i)).for_each(|v| seen += v.len() as i64);
    assert(seen == 6);
    let f = (0i64..4i64).map(|i| make(gpa, i)).fold(0i64, |a, v| a + v.len() as i64);
    assert(f == 6);
    let o: Option<Vec<i64, Gpa>> = Some(make(gpa, 2));
    assert(o.map(|v| v.len()).unwrap_or(0usize) == 2);
}

#[test]
fn moved_out_once(gpa: Gpa) {
    let mut keep: Vec<Vec<i64, Gpa>, Gpa> = Vec::new_in(gpa);
    (0i64..3i64).map(|i| make(gpa, i)).for_each(|v| keep.push(v));
    let back = |v: Vec<i64, Gpa>| v;
    let w = back(make(gpa, 5));
    assert(keep.len() == 3 && w.len() == 5);
}
