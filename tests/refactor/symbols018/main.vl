// (0.18) Every symbol the compiler makes: a contract's companions, drop
// glue, closures, derive, tests, properties, fuzz targets, coverage.
use std::alloc::Allocator; struct Acc<A: Allocator> { items: Vec<i64, A> }

impl Acc<Gpa> {
    fn get(&self, i: i64) -> i64
        requires i < self.items.len() as i64
        ensures result >= 0
    {
        self.items[i as usize]
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Copy)]
enum Shape { Dot, Line(i64) }

fn total(v: &Vec<i64, Gpa>) -> i64 {
    v.iter().copied().map(|x| x * 2).fold(0i64, |a, b| a + b)
}

#[test]
fn adds() {
    assert_eq(&(1 + 1), &2);
}

#[property]
fn commutes(a: i64, b: i64) {
    assert(a + b == b + a);
}

#[fuzz]
fn never(data: &[u8]) {
    if data.len() > 3 && data[0] == b'F' { assert(data[1] != b'U'); }
}

fn main(gpa: Gpa) {
    let mut a = Acc { items: Vec::new_in(gpa) };
    a.items.push(3);
    let s = Shape::Line(4i64);
    println("{} {} {s:?}", a.get(0), total(&a.items));
    assert(a.get(0) == 3);
}
// EDITION: rust
