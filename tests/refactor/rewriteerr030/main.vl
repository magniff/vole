// premerge: broken on purpose
// A program in the middle of a conversion: `regs` was an IntVec and is
// an array now, so its `get`s are errors; `noise` holds more errors than
// a check reports (50), before the code the rewrites are for.
struct IntVec {
    data: [i64; 4],
}

impl IntVec {
    fn get(&self, i: i64) -> i64 {
        self.data[i as usize]
    }
}

struct Map {
    keys: [i64; 4],
}

impl Map {
    fn get(&self, k: i64) -> i64 {
        self.keys[(k % 4) as usize]
    }
}

struct Cx {
    regs: [i64; 4],
    uses: IntVec,
    head: Map,
}

fn noise(cx: &Cx) -> i64 {
    let e0: i64 = cx.head.nope0();
    let e1: i64 = cx.head.nope1();
    let e2: i64 = cx.head.nope2();
    let e3: i64 = cx.head.nope3();
    let e4: i64 = cx.head.nope4();
    let e5: i64 = cx.head.nope5();
    let e6: i64 = cx.head.nope6();
    let e7: i64 = cx.head.nope7();
    let e8: i64 = cx.head.nope8();
    let e9: i64 = cx.head.nope9();
    let e10: i64 = cx.head.nope10();
    let e11: i64 = cx.head.nope11();
    let e12: i64 = cx.head.nope12();
    let e13: i64 = cx.head.nope13();
    let e14: i64 = cx.head.nope14();
    let e15: i64 = cx.head.nope15();
    let e16: i64 = cx.head.nope16();
    let e17: i64 = cx.head.nope17();
    let e18: i64 = cx.head.nope18();
    let e19: i64 = cx.head.nope19();
    let e20: i64 = cx.head.nope20();
    let e21: i64 = cx.head.nope21();
    let e22: i64 = cx.head.nope22();
    let e23: i64 = cx.head.nope23();
    let e24: i64 = cx.head.nope24();
    let e25: i64 = cx.head.nope25();
    let e26: i64 = cx.head.nope26();
    let e27: i64 = cx.head.nope27();
    let e28: i64 = cx.head.nope28();
    let e29: i64 = cx.head.nope29();
    let e30: i64 = cx.head.nope30();
    let e31: i64 = cx.head.nope31();
    let e32: i64 = cx.head.nope32();
    let e33: i64 = cx.head.nope33();
    let e34: i64 = cx.head.nope34();
    let e35: i64 = cx.head.nope35();
    let e36: i64 = cx.head.nope36();
    let e37: i64 = cx.head.nope37();
    let e38: i64 = cx.head.nope38();
    let e39: i64 = cx.head.nope39();
    let e40: i64 = cx.head.nope40();
    let e41: i64 = cx.head.nope41();
    let e42: i64 = cx.head.nope42();
    let e43: i64 = cx.head.nope43();
    let e44: i64 = cx.head.nope44();
    let e45: i64 = cx.head.nope45();
    let e46: i64 = cx.head.nope46();
    let e47: i64 = cx.head.nope47();
    let e48: i64 = cx.head.nope48();
    let e49: i64 = cx.head.nope49();
    let e50: i64 = cx.head.nope50();
    let e51: i64 = cx.head.nope51();
    0
}

fn total(cx: &Cx) -> i64 {
    let a = cx.uses.get(1) + cx.head.get(cx.regs.get(2));
    let z = cx.head.get(1).get(2);
    let w: i64 = cx.regs.get(1).get(0);
    a + z + w
}

fn main() -> i32 {
    let cx = Cx {
        regs: [1, 2, 3, 4], uses: IntVec { data: [5, 6, 7, 8] }, head: Map { keys: [0, 1, 2, 3] },
    };
    (total(&cx) + noise(&cx)) as i32
}
