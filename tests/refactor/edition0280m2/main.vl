fn make(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..n {
        v.push(i);
    }
    v
}

fn apply<F: Fn(let i64) -> i64>(f: F) -> i64 { f(1) + f(2) }

fn twice(f: fn(Vec<i64, Gpa>) -> i64, v: Vec<i64, Gpa>) -> i64 { f(v) * 2 }

fn last(v: Vec<i64, Gpa>) -> i64 { v[v.len - 1] }

fn main(gpa: Gpa) {
    let sum = |v: let Vec<i64, Gpa>| -> i64 {
        var t = 0;
        for x in v.iter() {
            t += x;
        }
        t
    };
    let sq = |x: let i64| -> i64 { x * x };
    let inc = |x: i64| x + 1;
    let v = make(3, gpa);
    println("{} {} {} {}", sum(make(4, gpa)), sum(v), sq(3), inc(4));
    println("{} {}", apply(|x| x + 1), twice(last, make(5, gpa)));
}
