struct P { a: i64, b: [u8] }

impl Display for P {
    fn fmt(self, f: inout Fmt) {
        f.write(f"P({self.a}, {self.b:?})");
    }
}

fn first(v: [i64]) -> i64
    requires v.len() > 0 else f"empty: {v.len()} items"
{
    v[0]
}

fn show<T: Display>(x: T) {
    println(x);
}

fn never<T: Display>(x: T) {
    println(f"never {x} {1 + 1}");
}

fn main(gpa: Gpa) {
    let n = 42;
    let p = P { a: 1, b: "x" };
    println(f"n = {n}, {n:>5} {p.a + 1} {"lit"} {{brace}}");
    println("text {n} {{");
    print(f"no holes\n");
    let s = format_in(f"{n}-{p.a}", gpa);
    eprintln(f"{s.as_slice()}");
    let line = f"{n} {p}";
    show(line);
    show(f"{n:x}");
    var b = String::new_in(gpa);
    b.push_str(f"[{p.a}]");
    println(b.as_str());
    println(f"""
        block {n}
        and {p.a}
        """);
    println(f"{first([1])}");
}
