use std::HashMap;

fn total(v: Vec<i64>) -> i64 {
    v.iter().sum()
}

fn keys(m: HashMap<i64, Buf>) -> usize {
    m.len()
}

fn grow<A: Allocator>(v: inout Vec<i64, A>, w: Vec<i64>) {
    v.push(w.len() as i64);
}

struct Pool<A: Allocator = Gpa> {
    items: Vec<i64, A>,
}

fn empty() -> Vec<i64, Gpa> {
    Vec::new()
}

fn main(gpa: Gpa) {
    let t: Vec<i64, Gpa> = (0..3).collect();
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let w: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&v, w);
    println("{}", total(v));
}

struct Bag {
    items: Vec<i64, Gpa>,
}

fn bag_len(b: Bag) -> usize {
    b.items.len()
}

struct Stack<T> {
    items: Vec<T>,
}

impl<T> Stack<T> {
    fn push(inout self, x: sink T) -> usize {
        self.items.push(x);
        self.items.len()
    }

    fn me(sink self) -> Stack<T> {
        self
    }
}

fn fresh(gpa: Gpa) -> usize {
    let u = Vec::<i64>::new_in(gpa);
    u.len()
}
