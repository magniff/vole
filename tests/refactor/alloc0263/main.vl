use std::HashMap;

fn total(v: Vec<i64>) -> i64 {
    v.iter().sum()
}

fn keys(m: HashMap<i64, Buf>) -> usize {
    m.len()
}

fn grow<A: Allocator>(v: inout Vec<i64, A>, w: Vec<i64>) {
    v.push(w.len() as i64);
}

struct Pool<A: Allocator = Gpa> {
    items: Vec<i64, A>,
}

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let w: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&v, w);
    println("{}", total(v));
}
