## 0.25.5: dependent edits in one checked call (docs/refactor.md,
## "Several dependent edits in one call"), what a refused edit says, and
## generated files.
## A table grown alone is refused; the summary line names the error.
$ edit patch NAMES --old '[c"one", c"two"]' --new '[c"one", c"two", c"three"]'
names.vl:4:39: error[type error] array has 3 elements, expected 2  [edited: crate::names::NAMES]
error edit.breaks: 1 new error; nothing written; the error: names.vl:4:39: array has 3 elements, expected 2
note edit.together: several steps are one call, checked at its end: `edit patch NAME --old A --new B --old C --new D` (`--in OTHER` before another item's pairs), `edit apply FILE`; or this step alone with --no-check
try: volec edit patch NAMES --old '[c"one", c"two"]' --new '[c"one", c"two", c"three"]' --no-check
[exit 1]
## The table and its count in one call: --in for the count.
$ edit patch NAMES --old '[c"one", c"two"]' --new '[c"one", c"two", c"three"]' --in NAME_COUNT --old '= 2' --new '= 3' --show
patched crate::names::NAME_COUNT, crate::names::NAMES	names.vl	+2 -2 lines
// names.vl:3-4
3	pub const NAME_COUNT: i64 = 3;
4	pub static NAMES: [*u8; NAME_COUNT] = [c"one", c"two", c"three"];
$ undo
undid patched crate::names::NAME_COUNT, crate::names::NAMES	names.vl	+2 -2 lines
## --pairs FILE and --old/--new together: the file's blocks before an `@@`
## line are the command line TARGET's.
$ edit patch NAMES --pairs $T/inputs/edit255_names.pairs --in NAME_COUNT --old '= 2' --new '= 3' --dry-run
--- a/names.vl
+++ b/names.vl
@@ -3,2 +3,2 @@
-pub const NAME_COUNT: i64 = 2;
-pub static NAMES: [*u8; NAME_COUNT] = [c"one", c"two"];
+pub const NAME_COUNT: i64 = 3;
+pub static NAMES: [*u8; NAME_COUNT] = [c"one", c"two", c"three"];
## `@@ FILE` blocks: one pairs file over several files.
$ edit patch --pairs $T/inputs/edit255_files.pairs --dry-run
--- a/main.vl
+++ b/main.vl
@@ -19 +19 @@
-    if t == 4 && a == 6 && usage::READ + usage::WRITE == 3 { 0 } else { 1 }
+    if t == 6 && a == 6 && usage::READ + usage::WRITE == 3 { 0 } else { 1 }
--- a/names.vl
+++ b/names.vl
@@ -3,2 +3,2 @@
-pub const NAME_COUNT: i64 = 2;
-pub static NAMES: [*u8; NAME_COUNT] = [c"one", c"two"];
+pub const NAME_COUNT: i64 = 3;
+pub static NAMES: [*u8; NAME_COUNT] = [c"one", c"two", c"three"];
## OLDs that touch (one ends where the next begins) are fine; overlapping
## ones are refused, naming both.
$ edit patch area --old 'w * h' --new 'h * w' --old ';' --new '; // swapped' --dry-run
--- a/main.vl
+++ b/main.vl
@@ -11 +11 @@
-    let a = w * h;
+    let a = h * w; // swapped
$ edit patch area --old 'a = w' --new 'a = h' --old 'w * h' --new 'h * w'
error patch.overlap: OLD 2 (line 11) overlaps OLD 1 (line 11); make them one pair (OLDs that only touch are fine)
[exit 1]
## Lines inserted above FILE:LINEs: an empty OLD, a FILE:LINE target each
## (the lines as the files were before the edit), indented like the line.
$ edit patch --pairs $T/inputs/edit255_above.pairs --show
patched crate::names::count, crate::main	2 files	+3 -0 lines
// main.vl:16
16	    // The names.
// names.vl:8
8	    // Each name of the table.
// names.vl:10
10	        // (a null one is not counted)
$ undo
undid patched crate::names::count, crate::main	2 files	+3 -0 lines
$ edit patch main.vl:11 --old '' --new '// the product' --dry-run
--- a/main.vl
+++ b/main.vl
@@ -10,0 +11 @@
+    // the product
## An empty OLD of a target that is no line.
$ edit patch area --old '' --new '// x'
error edit.usage: OLD 1 is empty; an empty OLD inserts NEW above the line of a FILE:LINE target
try: volec edit patch FILE:LINE --old '' --new TEXT
[exit 2]
## A refused edit: the error is in the summary line, not hidden by an
## import added for the unknown name (`use std::size` does not resolve).
$ edit patch area --old 'w * h' --new 'w * size'
main.vl:11:17: error[type error] undefined variable 'size' | help: add `use std::size;` | try: volec fix --suggested main.vl  [edited: crate::area]
error edit.breaks: 1 new error; nothing written; the error: main.vl:11:17: undefined variable 'size'
note edit.together: several steps are one call, checked at its end: `edit patch NAME --old A --new B --old C --new D` (`--in OTHER` before another item's pairs), `edit apply FILE`; or this step alone with --no-check
try: volec edit patch area --old 'w * h' --new 'w * size' --no-check
[exit 1]
## A generated file (`// Generated by SCRIPT`): refused, naming the script;
## --force edits it anyway.
$ edit patch twice --old 'n + n' --new 'n * 2'
error edit.generated: gen.vl is generated by tools/mkgen.sh (its first line says so): change what the script makes it from and run it; nothing written
try: volec edit patch twice --old 'n + n' --new 'n * 2' --force
[exit 1]
$ edit patch twice --old 'n + n' --new 'n * 2' --force --dry-run
--- a/gen.vl
+++ b/gen.vl
@@ -3 +3 @@
-    n + n
+    n * 2
## A module of no file of its own: its text, to its closing brace.
$ edit patch usage --old 'WRITE: u32 = 2' --new 'WRITE: u32 = 2 + 0' --dry-run
--- a/main.vl
+++ b/main.vl
@@ -7 +7 @@
-    pub const WRITE: u32 = 2;
+    pub const WRITE: u32 = 2 + 0;
## rewrite --text as a step of a script: the program's files, checked once.
$ refactor --script $T/inputs/edit255.script --dry-run
main.vl	2 matches
rewrote 2 matches in 1 file
patched crate::main	main.vl	+1 -1 lines
--- a/main.vl
+++ b/main.vl
@@ -10 +10 @@
-fn area(w: i64, h: i64) -> i64 {
+fn surface(w: i64, h: i64) -> i64 {
@@ -18 +18 @@
