struct Table {
    enum_count: i64,
    width: i64,
}

fn grow(t: &mut Table, n: i64) {
    t.entry_count = n;
    t.entry_count += 1;
}

fn total(t: &Table) -> i64 {
    t.entry_count + t.enum_count + wide(t)
}

fn wide(t: &Table) -> i64 {
    t.widht
}

fn main() -> i32 {
    let mut t = Table { enum_count: 1, width: 2 };
    grow(&mut t, 3);
    total(&t) as i32
}
