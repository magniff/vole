fn total(s: &[i64]) -> i64 {
    let mut t = 0;
    let mut i = 0;
    while i < s.len {
        t += s[i];
        i += 1;
    }
    t
}

fn same(a: &[u8], b: &str) -> bool {
    a.ptr == b.as_bytes().ptr && a.len == b.len()
}

fn main() {
    let v = [4i64, 5, 6];
    let text = "abc";
    println("{} {} {}", total(&v[..]), same(text.as_bytes(), text), v[1..].len);
}
