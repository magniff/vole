struct Pt {
    x: i64,
    y: i64,
}

fn f(p: &Pt) -> i64 {
    match p {
        Pt { x: 0, .. } => 0,
        Pt { x, y } => *x + *y,
    }
}

fn main() {
    let p = Pt { x: 3, y: 4 };
    let Pt { x, y } = p;
    let q = Pt { x: 1, y: 2 };
    if let Pt { x: 1, y: yy } = q {
        println("{yy}");
    }
    println("{} {x} {y}", f(&Pt { x: 5, y: 6 }));
}
