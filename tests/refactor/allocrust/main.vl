struct Log {
    lines: Vec<String<Gpa>, Gpa>,
}

fn split_path(path: &str) -> Vec<&str, Gpa> {
    let mut parts: Vec<&str, Gpa> = Vec::new_in(gpa);
    for p in path.split('/') {
        parts.push(p);
    }
    parts
}

fn main(gpa: Gpa) {
    let log = Log { lines: Vec::new_in(gpa) };
    let parts = split_path("/users/ada");
    println("{} {parts:?}", log.lines.len());
}
