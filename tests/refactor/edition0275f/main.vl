// fix --edition rust (0.27.5): std::process's and std::env's calls that
// change in std2, by rewrite.tsv: Command::new (Command::new_in on the
// function's allocator), process::id and Child::id (u32s), env::get_in
// (std2's var_in); a program or argument given as bytes (a Vec<[u8]>'s
// element, a slice) is `str::from_utf8(p).unwrap()`.
use std::{env, process};
use std::process::Command;

fn run(gpa: Gpa) -> i32 {
    var words = Vec::<[u8], Gpa>::new_in(gpa);
    words.push("/bin/sh");
    words.push("-c");
    words.push("exit 3");
    var cmd = Command::new(words[0]);
    for k in 1..words.len() {
        cmd.arg(words[k]);
    }
    // (a byte read: the program's [u8] are bytes, not text)
    let z: [u8] = "z";
    if z[0] == 'z' {
        cmd.arg(z[0..1]);
    }
    match cmd.status() {
        Ok(st) => match st.code() {
            Some(c) => c,
            None => -1,
        },
        Err(_) => -2,
    }
}

fn main(gpa: Gpa) {
    println("{}", run(gpa));
    println("{}", process::id() > 0);
    var c = Command::new("/bin/sh");
    c.arg("-c");
    c.arg("true");
    match c.spawn() {
        Ok(ch) => {
            println("{}", ch.id() > 0);
            var w = ch;
            match w.wait() {
                Ok(st) => println("{}", st.success()),
                Err(_) => println("no wait"),
            }
        }
        Err(_) => println("no spawn"),
    }
    match env::get_in("VOLE_T_NOT_SET_X", gpa) {
        Ok(v) => println("set {}", v),
        Err(_) => println("unset"),
    }
}
