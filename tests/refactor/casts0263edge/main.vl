// `volec fix --only casts` (0.26.3, tests/refactor/casts0263edge.t): the
// edges of its rules, one function each.
use std::{Gpa, Vec};

// (kept) a sign test written the other way round
fn nonneg(s: [u8]) -> bool {
    0 <= s.len as i64
}

// (kept) both sides of a comparison: the right one reaches a subtraction,
// so the left one is compared with an i64
fn one_shorter(a: [u8], b: [u8]) -> bool {
    a.len as i64 == b.len as i64 - 1
}

// (removed, both) a let copied into another let, then an index
fn last_of(s: [u8]) -> u8 {
    let n = s.len as i64;
    let m = n;
    if m > 0 { s[0] } else { 'x' }
}

// (removed) a counter compared with a let this fix makes a usize
fn below(s: [u8]) -> i64 {
    let n = s.len as i64;
    var c = 0;
    for i in 0..s.len as i64 {
        if i < n {
            c += 1;
        }
    }
    c
}

// (kept) a slicing to the end of a call's result (not a name), and an
// inclusive one from an i64
fn tails(s: [u8], i: i64) -> i64 {
    let a = std::trim(s)[i..std::trim(s).len as i64];
    let b = s[i..=a.len as i64];
    b.len as i64 + 0
}

// (kept) in a generic function, checked once per instance
fn nonempty<T>(v: Vec<T, Gpa>) -> bool {
    v.len() as i64 > 0
}

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    var w: Vec<u8, Gpa> = Vec::new_in(gpa);
    w.push('a');
    println("{} {} {} {}", nonneg("ab"), one_shorter("abc", "abcd"), last_of("vole"), below("abc"));
    println("{} {} {}", tails(" abcd ", 1), nonempty(v), nonempty(w));
}
