// The program `volec run` runs (tests/refactor/run254.t): a line, then its
// arguments; its exit status is their number.
use std::env;

fn main() -> i32 {
    println("hello from run254");
    var n = 0;
    for a in env::args() {
        if n > 0 {
            println(f"arg: {a}");
        }
        n += 1;
    }
    (n - 1) as i32
}
