// Ends by a signal, SIGTERM (15): `volec run` says 128 + 15, as a shell.
// UNSAFE: C's function, declared for the test.
// SAFETY: its signature is the C one.
extern "C" {
    fn raise(sig: i32) -> i32;
}

fn main() -> i32 {
    println("about to be terminated");
    // UNSAFE: raise is C's; std sends no signal.
    // SAFETY: raise takes any int and only signals this process.
    unsafe { raise(15); }
    0
}
