struct Countdown { n: i64 }

impl Iterator for Countdown {
    type Item = i64;

    fn next(inout self) -> Option<i64> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        Some(self.n)
    }
}

fn squares(n: i64, gpa: Gpa) -> Vec<i64, Gpa> {
    (0..n).map(|x| x * x).collect_in(gpa)
}

fn main(gpa: Gpa) {
    let c = Countdown { n: 3 }.collect_in(gpa);
    let s = (0..4).map(|x| x * x).collect_in(gpa);
    var words: Vec<[u8], Gpa> = Vec::new_in(gpa);
    words.push("a");
    words.push("b");
    let w: Vec<[u8], Gpa> = words.iter().collect_in(gpa);
    println("{c:?} {s:?} {} {:?}", w.len(), squares(3, gpa));
}
