use std::io;

fn main(gpa: Gpa) -> i32 {
    let mut n: i64 = 0;
    let mut l = String::new_in(gpa);
    while io::stdin().read_line(&mut l).map(|n| n > 0).unwrap_or(false) {
        let t = l.trim_end();
        if t == "crash" {
            return 3;
        }
        if t == "hang" {
            let mut k: i64 = 0;
            while k >= 0 {
                k = (k + 1) % 7;
            }
        }
        n += 1;
        println("line {n}: {t}");
        l.clear();
    }
    0
}
// EDITION: rust
