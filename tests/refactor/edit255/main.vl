// Dependent edits in one checked call (tests/refactor/edit255.t).
mod names;
mod gen;

pub mod usage {
    pub const READ: u32 = 1;
    pub const WRITE: u32 = 2;
}

fn area(w: i64, h: i64) -> i64 {
    let a = w * h;
    a
}

fn main() -> i32 {
    let n = names::count();
    let t = gen::twice(n);
    let a = area(2, 3);
    if t == 4 && a == 6 && usage::READ + usage::WRITE == 3 { 0 } else { 1 }
}
