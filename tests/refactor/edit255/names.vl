// A table and its count, which change together.

pub const NAME_COUNT: i64 = 2;
pub static NAMES: [*const u8; NAME_COUNT] = [c"one", c"two"];

pub fn count() -> i64 {
    let mut n: i64 = 0;
    for i in 0..NAME_COUNT {
        if NAMES[i as usize] != 0 as *mut u8 {
            n += 1;
        }
    }
    n
}
