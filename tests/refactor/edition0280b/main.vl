// The modules are named as compiler/src's (places, base) so that
// statics.tsv's rows name two of these statics: an `atomic` row's, a
// `justified` row's; the others have none.
mod base;
mod places;

use crate::base::{ROOT_LEX_ABS, set_abs};
use crate::places::{COUNT, NAMES, TOTALS, bump, partial};

static var STATE: i64 = 0;

fn main() {
    bump(3);
    COUNT += 1;
    NAMES.push(7);
    TOTALS[2] = COUNT;
    STATE = partial(true);
    let n = NAMES.count;
    set_abs(true);
    println("{} {} {} {} {}", COUNT, n, TOTALS[2], STATE, ROOT_LEX_ABS);
    println("{COUNT}");
}
