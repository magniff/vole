pub struct IntVec {
    pub count: i64, pub last: i64,
}

impl IntVec {
    pub fn push(inout self, v: i64) {
        self.count += 1;
        self.last = v;
    }
}

// (statics.tsv: crate::places::BORROWCK_PARTIAL is `atomic`)
static var BORROWCK_PARTIAL: bool = false;

pub static var COUNT: i64 = 0;
pub static var NAMES: IntVec = IntVec { count: 0, last: 0 };
pub static var TOTALS: [i64; 4] = [0; 4];

pub fn bump(by: i64) {
    COUNT = COUNT + by;
}

pub fn partial(on: bool) -> i64 {
    BORROWCK_PARTIAL = on;
    if BORROWCK_PARTIAL { 1 } else { 0 }
}
