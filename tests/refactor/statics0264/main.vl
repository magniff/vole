// `volec fix --only statics --group body.group` (0.26.4,
// tests/refactor/statics0264.t): the statics TABLE, COUNT and LABEL moved
// into the context `Body`, made by the owner `run`.

pub struct Tab {
    pub a: [i64; 8],
    pub n: i64,
}

impl Tab {
    fn push(inout self, x: i64) {
        self.a[self.n] = x;
        self.n += 1;
    }

    fn len(self) -> i64 {
        self.n
    }
}

pub struct Body {
    pub table: Tab,
    pub count: i64,
    pub label: [u8],
}

pub fn body_new() -> Body {
    Body { table: Tab { a: [0; 8], n: 0 }, count: 0, label: "body" }
}

static var TABLE: Tab = Tab { a: [0; 8], n: 0 };
static var COUNT: i64 = 0;
static var LABEL: [u8] = "body";

// (reads only: let)
fn total() -> i64 {
    var s = 0;
    for i in 0..TABLE.len() {
        s += TABLE.a[i];
    }
    s + COUNT
}

// (a method of the table, an assignment: inout)
fn add(x: i64) -> i64 {
    TABLE.push(x);
    COUNT += 1;
    TABLE.len()
}

// (a caller of an inout one: inout; a call inside another's arguments)
fn two(a: i64, b: i64) -> i64 {
    a + add(add(b) + a)
}

// (a method of the table given an argument that changes the context:
// the argument becomes a `let` before the statement)
fn again(x: i64) -> i64 {
    TABLE.push(add(x));
    COUNT
}

// (a parameter with a default: the context goes before it)
fn scaled(x: i64, by: i64 = 2) -> i64 {
    (x + total()) * by
}

// (no parameters; the name's text)
fn label_len() -> i64 {
    LABEL.len() as i64
}

// (the context's user nothing calls but the owner, through a method)
struct Probe {
    k: i64,
}

impl Probe {
    fn look(self) -> i64 {
        self.k + total()
    }
}

// (the owner: it makes the context)
fn run() -> i64 {
    let a = two(1, 2);
    let b = scaled(1);
    let c = scaled(1, by: 3);
    let p = Probe { k: 1 };
    let d = again(4);
    a + b + c + d + p.look() + label_len()
}

fn main() -> i32 {
    println("{}", run());
    0
}
