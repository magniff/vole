// fix --suggested (0.18): the errors whose fix the compiler knows
// exactly, one of each kind.
mod lib;
mod table;
mod text;

fn total(v: &Vec<i64, Gpa>) -> i64 {
    let mut s: i64 = 0;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

fn count(xs: &[i64]) -> i64 {
    xs.len() as i64
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    let t = totl(&v);
    let n = count(&[1i64, 2, 3]);
    let small: u8 = total(&v);
    if n {
        println("{n}");
    }
    let wide: f64 = n;
    let s = "  x ".trim();
    let w = String::from(s);
    let low = size_of::<Rect>() as i64;
    let d = text::describe(n);
    let r = table::make(3);
    let mut b: String<Gpa> = String::new_in(gpa);
    b.push_string(wrap(s));
    let cat: i64 = 1;
    let cot: i64 = 2;
    let both = cut + 1;
    println("{small} {wide} {} {low} {d} {} {} {both}", w, r.width, b);
}
