// Whether the new way is on: it always is, now.
pub fn on_new() -> bool {
    true
}

pub fn new_step(x: i64) -> i64 {
    x + 1
}

pub fn legacy_step(x: i64) -> i64 {
    x - 1
}

pub fn old_only(x: i64) -> i64 {
    x * 2
}

pub fn shared(x: i64) -> i64 {
    x
}

pub fn traced(x: i64) -> bool {
    x > 0
}
