// A program written against 0.26.1's std, where lengths were i64: `volec
// fix --only usize` converts where a usize length meets an i64 and where
// an i64 goes as a length or an index (tests/refactor/usize.t).
use std::{Gpa, Vec};

fn total(v: Vec<i64>) -> i64 {
    var s = 0;
    var i = 0;
    while i < v.len() {
        s += v[i];
        i += 1;
    }
    s
}

fn last_index(b: [u8]) -> i64 {
    let n: i64 = b.len;
    n - 1
}

fn main(gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    for k in 0..6 {
        v.push(k * k);
    }
    let keep: i64 = 4;
    v.truncate(keep);
    let a: i64 = 0;
    v.swap(a, 3);
    let name = "vole";
    println(f"{total(v)} {v[0]} {last_index(name)}");
}
