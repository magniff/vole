trait Tr {
    type Out;
    fn o(self) -> Self::Out;
}

impl Tr for u8 {
    type Out = &'static str;

    fn o(self) -> &'static str {
        "hello"
    }
}

impl Tr for i32 {
    type Out = u64;

    fn o(self) -> u64 {
        8
    }
}

fn f<T: Tr>(t: T) -> T::Out {
    t.o()
}

fn main() {
    let s: &str = f(2);
    println("{}", s.len());
}
