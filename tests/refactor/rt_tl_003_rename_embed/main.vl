const BOUNCES: u32 = 4;

embed wgsl TRACE with BOUNCES {
    // BOUNCES in a comment
    @group(0) @binding(0) var<storage, read_write> image: array<f32>;
    @compute @workgroup_size(1) fn main() {
        image[0] = f32(BOUNCES);
    }
}

fn main() {
    println("{} bounces, shader embedded: {}", BOUNCES, TRACE.src.len() > 0);
    println("{}", TRACE.main);
}
