#[derive(Clone, Copy, Debug, PartialEq)]
struct P {
    a: i64,
    b: i64,
}

#[derive(Clone, Copy, Debug)]
enum E {
    X,
    Y(i64),
}

fn sum(p: P) -> i64 {
    let P { a, b } = p;
    a + b
}

fn name(e: E) -> i64 {
    match e {
        E::X => 1,
        E::Y(n) => n,
    }
}

fn name2(e: &E) -> i64 {
    match *e {
        E::X => 1,
        _ => 0,
    }
}

fn main() -> i32 {
    let p = P { a: 1, b: 2 };
    let q = P { a: 5, b: p.b };
    let r = P { b: 9, a: 3 };
    println("{} {} {}", sum(p), sum(q), sum(r));
    println("{} {} {}", name(E::X), name(E::Y(4)), name2(&E::Y(1)));
    if let E::Y(k) = E::Y(3) {
        println("{k}");
    }
    println("{:?}", p == q);
    0
}
