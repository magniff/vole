const LIMIT: i64 = 5;

fn classify(x: i64) -> i64 {
    match x {
        LIMIT => 1,
        other => other * 10,
    }
}

fn pick(o: Option<i64>) -> i64 {
    if let Some(found) = o { found } else { -1 }
}

fn main() -> i32 {
    println("{} {} {}", classify(5), classify(0), classify(9));
    println("{} {}", pick(Some(3)), pick(None));
    0
}
