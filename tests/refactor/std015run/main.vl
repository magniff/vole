// A program written against 0.14's std (Option and bool for failure),
// run before and after `fix --only std015`: the same output. (0.26.3:
// its allocator is written, as 0.16's alloc016 wrote it; read_stdin_in is
// 0.16's, Result already.)
use std::{Buf, Scanner, parse_int, print, print_int, read_line, read_stdin_in};

fn parse_or(s: [u8], d: i64) -> i64 {
    match parse_int(s) {
        Some(v) => v,
        None => d,
    }
}

fn show(label: [u8], v: i64) {
    print(label);
    print_int(v);
    print("\n");
}

fn main(gpa: Gpa) -> i32 {
    show("a ", parse_or("41", 0) + 1);
    show("b ", parse_or("4x", -1));
    show("c ", parse_int("7").unwrap_or(0));
    show("empty ", if parse_int("").is_none() { 1 } else { 0 });
    let input = read_stdin_in(gpa).unwrap();
    let mut sc = Scanner::new(input.as_slice());
    let mut total = 0;
    let mut count = 0;
    while let Some(v) = sc.next_int() {
        total += v;
        count += 1;
    }
    show("total ", total);
    show("count ", count);
    let mut line = Buf::new_in(gpa);
    show("more ", if read_line(&mut line) { 1 } else { 0 });
    line.free();
    0
}
