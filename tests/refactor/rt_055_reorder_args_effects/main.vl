// The arguments of `order` change d: a block with an assignment, no call.
// Swapping them at the call evaluates them in the other order.
fn order(a: i64, b: i64) -> i64 {
    a * 10 + b
}

fn div(a: i64, b: i64) -> i64 {
    a - b
}

fn first(a: i64, b: i64) -> i64 {
    a
}

fn main() -> i32 {
    let mut d: i64 = 0;
    let r = order({ d += 1; d }, { d += 2; d });
    let f = first(r, { d += 100; d });
    println("{r} {f} {d}");
    let arr: [i64; 3] = [1, 2, 3];
    let z: i64 = r - r;
    let i: usize = 5;
    let q = div(arr[i], 10 / z);
    println("{q}");
    0
}
