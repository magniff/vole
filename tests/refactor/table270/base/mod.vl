// The C library, growable arrays, the allocator (as compiler/src/base).
pub mod comp;

pub extern "C" {
    fn malloc(size: u64) -> *u8;
    fn realloc(ptr: *u8, size: u64) -> *u8;
    fn free(ptr: *u8);
}

// Makes room for one more element in an array of `count` elements of T
// with capacity `*cap`; returns the (possibly moved) data.
pub fn grow<T>(data: *T, count: i64, cap: *i64) -> *T {
    unsafe {
        if count < *cap {
            return data;
        }
        *cap = if *cap < 8 { 8 } else { *cap * 2 };
        realloc(data as *u8, (*cap * size_of(T)) as u64) as *T
    }
}

// Room for at least `n` elements in all.
pub fn reserve<T>(data: *T, cap: *i64, n: i64) -> *T {
    unsafe {
        if n <= *cap {
            return data;
        }
        *cap = n;
        realloc(data as *u8, (n * size_of(T)) as u64) as *T
    }
}
