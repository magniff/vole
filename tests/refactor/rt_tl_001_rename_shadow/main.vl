trait Tr {
    fn n(&self) -> i64;
}

struct S {
    k: i64,
}

impl Tr for S {
    fn n(&self) -> i64 {
        1
    }
}

impl S {
    fn m(&self) -> i64 {
        2
    }
}

fn f(x: i64) -> i64 {
    x + 1
}

fn h(x: i64) -> i64 {
    x + 2
}

fn main() -> i32 {
    let g = |x: i64| x * 100;
    let s = S { k: 5 };
    let a = 3;
    let b = 4;
    {
        let c = a + 1;
        println("{} {} {}", f(2), g(1), c + b);
    }
    println("{} {}", s.n(), s.m());
    println("{}", h(s.k));
    0
}
