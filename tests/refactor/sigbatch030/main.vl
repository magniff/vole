#[derive(Clone, Copy)]
struct Buf {
    data: [i64; 4],
    len: i64,
}

fn first(b: Buf) -> i64 {
    b.data[0]
}

fn last(b: Buf, n: i64) -> i64 {
    b.data[(n - 1) as usize]
}

fn scale(x: i32, k: i32) -> i32 {
    (x as i64 * k as i64) as i32
}

fn main() -> i32 {
    let b = Buf { data: [1, 2, 3, 4], len: 4 };
    let a = first(b) + last(b, b.len);
    scale(a as i32, 2) + scale(scale(1, 2), 3)
}
