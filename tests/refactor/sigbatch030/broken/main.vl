// premerge: broken on purpose
// A program with an error: the call of `first` after it, in the same
// expression, is one the checker did not see.
#[derive(Clone, Copy)]
struct Buf {
    data: [i64; 4],
}

fn first(b: Buf) -> i64 {
    b.data[0]
}

fn main() -> i32 {
    let b = Buf { data: [1, 2, 3, 4] };
    let a = first(b);
    let z = missing(1) + first(b);
    (a + z) as i32
}
