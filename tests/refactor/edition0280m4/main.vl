fn front(v: inout Vec<i64, Gpa>, n: i64) -> inout [i64] { &v[0..n] }

fn fill(s: inout [i64], x: i64) {
    for i in 0..s.len {
        s[i] = x;
    }
}

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    for i in 0..5 {
        v.push(i);
    }
    let f = front(&v, 2);
    f[0] = 9;
    fill(&v[3..5], 7);
    println("{v:?}");
}
