// UNSAFE: raise and exit are C's: a test that ends its process with a
// signal or an exit code of its own
// SAFETY: each ends this process, the test's own, at once
extern "C" {
    fn raise(sig: i32) -> i32;
    fn exit(code: i32) -> !;
}

#[test]
fn t_ok() {
    assert_eq(1, 1);
}

#[test]
fn t_segv() {
    // UNSAFE: raise is C's
    // SAFETY: SIGSEGV on this process, the test's own
    unsafe { raise(11); }
}

#[test]
fn t_exit3() {
    // UNSAFE: exit is C's
    // SAFETY: ends this process, the test's own
    unsafe { exit(3); }
}

fn main() {}
