// The mechanical classes the check hook makes itself (`--codes
// conv.marker,conv.rust`): a call's `&` marker, Rust's spellings.
pub struct Ui { pub n: i64 }

fn bump(ui: inout Ui) {
    ui.n += 1;
}

pub fn twice(ui: inout Ui) {
    bump(ui);
    bump(&mut ui);
}

pub fn start() -> i64 {
    let mut u = Ui { n: 0 };
    twice(&u);
    u.n
}
