// (0.25.2.1) fix --suggested makes only the fixes that keep the program's
// meaning: each case is one an agent got from it in the 0.25.2 eval.
mod mathx;
mod glyphs;
mod casts;
mod marks;

// ocean: a method that is std's function for another type (0.25.2's
// float `abs` became std's i64 `abs`; 0.25.2.2 gave integers `abs`, so
// the case is an i32's `is_ascii_digit`, std's `is_digit` of a u8)
fn worst(a: i32, b: i32) -> bool {
    let d = a - b;
    d.is_ascii_digit()
}

// deferred (a std::gpu program): `check` is no name here;
// std::gpu::wgsl's `check` is a function
fn clear() -> std::gpu::Color {
    std::gpu::Color::black()
}

fn run(frames: i64) -> i64 {
    if check {
        println("checking");
    }
    frames
}

// gpu2521: the near name is the function the call is in
fn read_back(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    readback(n - 1) + 1
}

fn main() -> i32 {
    let n = run(3);
    let d = glyphs::dist(3.0, 4.0);
    println(f"{n} {d} {worst(3, 5)} {read_back(2)} {marks::start()}");
    0
}
