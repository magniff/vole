// cloth: an array of f64 zeros where [f32; 4] goes: the annotation is
// the fix, not a cast of the cast. A narrowing conversion wraps: shown,
// not made.
pub fn to_f32(m: [f64; 4]) -> [f32; 4] {
    var r = [0.0; 4];
    for k in 0..4 {
        r[k] = m[k] as f32;
    }
    r
}

pub fn small(t: i64) -> u8 {
    let s: u8 = t;
    s
}
