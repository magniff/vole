// `volec check --deny=unsafe` (0.29): each unsafe site without its
// comments and each unsafe block with nothing unsafe inside is an error
// where it is.
extern "C" {
    fn abs(x: i32) -> i32;
}

fn six(x: i32) -> i32 {
    let a = unsafe { abs(x) };
    let b = unsafe { abs(a) };
    let c = unsafe { abs(b) };
    let d = unsafe { abs(c) };
    // SAFETY: abs reads its argument alone.
    let e = unsafe { abs(d) };
    e
}

fn spare(x: i32) -> i32 {
    let y = unsafe { x + 1 };
    // UNSAFE: none: the block holds a sum.
    // SAFETY: nothing to it.
    let z = unsafe { y + 1 };
    // UNSAFE: abs is C's.
    // SAFETY: abs reads its argument alone.
    unsafe { abs(z) }
}

fn main() {
    println("{}", six(-3) + spare(-9));
}
