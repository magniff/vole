use std::alloc::{Allocator, Gpa};
use std::collections::HashMap;
use std::fmt::{Display, Formatter, Result};
use std::hash::FixedState;
use std::option::Option;
use std::vec::Vec;

mod shapes;

struct P {
    x: i64,
}

impl Display for P {
    fn fmt(&self, f: &mut Formatter) -> Result {
        write(f, "{}", self.x)
    }
}

fn first<A: Allocator>(v: &Vec<i64, A>) -> Option<i64> {
    v.first().copied()
}

fn main(gpa: Gpa) -> i32 {
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(m[&1]);
    println("{} {}", P { x: 3 }, shapes::area(2));
    first(&v).unwrap_or(0) as i32
}
