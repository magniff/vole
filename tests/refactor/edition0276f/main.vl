// fix --edition rust (0.27.6): a struct that holds views (`Line.words`,
// `Leaf.word`) is translated `Line<'a>`; its impl names that lifetime,
// `impl<'a> Line<'a>`, and a method that returns a view of a field, or
// takes a view it stores, says `'a` (not `'_`, nor `'static`).
use std::{Allocator, Gpa, Vec};

#[derive(Clone)]
struct Opt {
    name: str,
    takes: bool,
}

#[derive(Clone)]
struct Line {
    words: [str],
}

impl Line {
    fn len(self) -> i64 {
        self.words.len as i64
    }

    fn word(self, k: i64) -> str {
        if k >= 0 && k < self.words.len as i64 { self.words[k] } else { "" }
    }
}

#[derive(Clone)]
struct Leaf<A: Allocator> {
    opts: Vec<Opt, A>,
    word: str,
    last: str,
}

impl<A: Allocator> Leaf<A> {
    fn new(opts: sink Vec<Opt, A>, word: str) -> Leaf<A> {
        Leaf { opts: opts, word: word, last: "" }
    }

    fn with_last(sink self, last: str) -> Leaf<A> {
        self.last = last;
        self
    }
}

fn first_word(l: Line) -> str {
    l.word(1)
}

fn main(gpa: Gpa) {
    let ws: [str; 3] = ["prog", "query", "--all"];
    let l = Line { words: ws[0..3] };
    let w = first_word(l);
    var opts: Vec<Opt, Gpa> = Vec::new_in(gpa);
    opts.push(Opt { name: "all", takes: false });
    let leaf = Leaf::new(opts, "name").with_last("args");
    println("{} {} {} {} {} {}", l.len(), w, l.word(5) == "", leaf.word, leaf.last,
        leaf.opts.len());
}
