// EDITION: rust
// The rust edition's contracts tested as properties: a `&T` or `&mut T`
// parameter is lent a generated T.
fn total(k: &i64, v: &mut Vec<i64, Gpa>) -> i64
    requires * k >= 0 && *k < 1000
    ensures result >= *k
{
    v.push(*k);
    let mut s: i64 = 0;
    for x in v.iter() {
        s += *x;
    }
    s
}

fn grow(v: &mut Vec<i64, Gpa>, by: &i64) -> usize
    requires * by >= 0
    ensures result >= 1
{
    v.push(*by);
    v.len()
}

fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let k: i64 = 3;
    println("{} {}", total(&k, &mut v), grow(&mut v, &k));
}
