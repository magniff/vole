fn bits(x: u32) -> u32 {
    x * 3
}

fn take(v: u64) -> u64 {
    v + 1
}

fn main() {
    let bytes: [u8] = "abc";
    var h: u64 = 7;
    for i in 0..bytes.len {
        h ^= bytes[i];
    }
    let n: i64 = 2;
    let w: i64 = if n > 1 { bytes[0] } else { 0 };
    let k = take(bits(5));
    let s: u8 = 3;
    let t: u8 = 4;
    let u = take(s + t);
    println("{} {} {} {}", h, w, k, u);
}
