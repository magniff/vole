// A program with two errors (tests/refactor/cachename0253.t): an edit
// fixes one, the other stays, and its `try:` line names the compiler.
fn average(total: i64, n: i64) -> i64 {
    totl / n
}

fn count_to(n: i64) -> i64 {
    let count = 0;
    while count < n {
        count += 1;
    }
    count
}

fn main() -> i32 {
    (average(4, 2) + count_to(3) - 5) as i32
}
