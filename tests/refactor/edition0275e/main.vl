// fix --edition rust (0.27.5): std::fs's calls that change in std2, by
// rewrite.tsv: exists (an io::Result<bool>), append (none in Rust: an
// OpenOptions in append mode), copy (a u64), Metadata::modified (a
// SystemTime, MVS's the Duration since the epoch), DirEntry::is_file (its
// FileType's); a path given as bytes is `str::from_utf8(p).unwrap()`.
use std::fs;

fn main(gpa: Gpa) {
    let p = "f.txt";
    let q = "g.txt";
    fs::write(p, "ab").unwrap();
    fs::append(p, "cd").unwrap();
    let n = fs::copy(p, q).unwrap();
    println("{} {} {}", fs::exists(q), fs::exists("/nonexistent/x"), n);
    let pb: [u8] = "g.txt";
    var files = 0;
    match fs::read_dir(".") {
        Result::Ok(it) => {
            for e in it {
                match e {
                    Result::Ok(x) => {
                        if x.is_file() {
                            files += 1;
                        }
                    }
                    Result::Err(_) => {}
                }
            }
        }
        Result::Err(_) => {}
    }
    println("{} {}", fs::exists(pb), files > 1);
    let m = fs::metadata(q).unwrap();
    println("{} {}", m.len(), m.modified().as_secs() > 1000);
    fs::remove_file(p).unwrap();
    fs::remove_file(q).unwrap();
}
