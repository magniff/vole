// fix --edition rust (0.27.6): an argument given to a parameter taken
// `&mut` is `&mut`, whatever it views: a part of an inout array, of a
// Vec or of a local, given to an `inout [u32]` or to std::arch's `&mut
// [u32]` (rustc E0308: the types differ in mutability).
use std::arch::aarch64::{vld1q_u32, vst1q_u32};

fn bump(s: inout [u32], i: i64) {
    s[i] += 1;
}

fn by_param(h: inout [u32; 8]) {
    bump(&h[..], 0);
    bump(&h[2..4], 1);
    let v = vld1q_u32(h[..], 0);
    vst1q_u32(&h[..], 4, v);
}

fn by_vec(v: inout Vec<u32, Gpa>) {
    bump(&v[..], 1);
    bump(&v[1..3], 0);
    let w = vld1q_u32(v[..], 0);
    vst1q_u32(&v[..], 0, w);
}

fn main(gpa: Gpa) {
    var h: [u32; 8] = [1, 2, 3, 4, 5, 6, 7, 8];
    by_param(&h);
    var a: [u32; 4] = [0, 0, 0, 0];
    bump(&a[..], 3);
    bump(&a[1..3], 1);
    vst1q_u32(&a[..], 0, vld1q_u32(h[..], 4));
    var v: Vec<u32, Gpa> = Vec::new_in(gpa);
    for i in 0..4 {
        v.push(10 * (i as u32 + 1));
    }
    by_vec(&v);
    bump(&v[..], 2);
    bump(&v[0..2], 0);
    println("{} {} {} {} {} {} {} {}", h[0], h[3], h[4], a[3], a[2], v[0], v[1], v[2]);
}
