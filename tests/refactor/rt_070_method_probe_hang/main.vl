// rustc's probe: &mut S (none), &&mut S, &mut &mut S (none), then the
// deref step S (none), &S: TB for &S, `self` = &s: 2. volec check never
// ends on this program (memory growing about 12 MB a second); 0.28.0 to
// 0.30.0 died of SIGSEGV instead. Also `(&&s).m()` with impls of `self`
// methods for &S and &&S.
// EXPECT: 2 0
#[derive(Clone, Copy)]
struct S {
    k: i64,
}

trait TB {
    fn m(self) -> i64;
}

impl<'a> TB for &'a S {
    fn m(self) -> i64 {
        2
    }
}

fn main() -> i32 {
    let mut s = S { k: 0 };
    let r = (&mut s).m();
    println("{} {}", r, s.k);
    0
}
