struct Tally {
    n: i64, seen: i64,
}

static var TALLY: Tally = Tally { n: 0, seen: 0 };

// writes TALLY itself: a copy of TALLY made around a call of it would
// lose that write
fn next() -> i64 {
    TALLY.seen += 1;
    TALLY.seen
}

fn bump(t: inout Tally) {
    t.n += 1;
}

fn main() {
    // (proven: bump does not touch TALLY)
    bump(&TALLY);
    // (not proven: next writes TALLY while the assignment's copy would live)
    TALLY.n = next() + 10;
    println("{} {}", TALLY.n, TALLY.seen);
}
