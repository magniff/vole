mod catalog;
mod geom;

use catalog::Catalog;
use geom::{Point, area};

// Sum of the areas; `total` counts them.
fn total(points: &Vec<Point, Gpa>) -> i64 {
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < points.len() as i64 {
        let p = points[i as usize];
        total = total + area(p);
        i = i + 1;
    }
    total
}

// `a` twice; `s` is the sum.
fn twice<T: std::ops::Add<Output = T> + Copy>(a: T) -> T {
    let s = a + a;
    s
}

fn main(gpa: Gpa) {
    let mut v: Vec<Point, Gpa> = Vec::new_in(gpa);
    v.push(Point { x: 2, y: 3 });
    let x = total(&v);
    {
        let x = x + 1;
        print("{}", x);
    }
    print("{}", twice(x));
    let mut c = Catalog { items: Vec::new_in(gpa) };
    c.add(1, 3);
    print("{}", c.add(1, 2));
}
// EDITION: rust
