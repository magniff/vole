// A title: `Item.qty` copies owned.
use std::alloc::Allocator; #[derive(Clone, Copy)] pub struct Item {
    pub id: i64,
    pub qty: i64,
}

pub struct Catalog<A: Allocator> {
    pub items: Vec<Item, A>,
}

impl Catalog<Gpa> {
    // Adds `qty` copies of the book `id`; see `Catalog::total`.
    pub fn add(&mut self, id: i64, qty: i64) -> i64 {
        let mut i: i64 = 0;
        while i < self.items.len() as i64 {
            let mut it = self.items[i as usize];
            if it.id == id {
                // `qty` more; `Item::qty` is the count.
                it.qty += qty;
                self.items[i as usize] = it;
                return it.qty;
            }
            i += 1;
        }
        self.items.push(Item { id: id, qty: qty });
        qty
    }

    // The sum of `Item.qty`.
    pub fn total(&self) -> i64 {
        let mut n: i64 = 0;
        for k in 0..self.items.len() {
            n += self.items[k].qty;
        }
        n
    }
}
