// A small program with two bugs, for the debugging tools (0.17): a key
// whose values are all negative crashes `best`; WIDTH 0 never ends.
use std::io; mod stats;



fn main(gpa: Gpa) -> i32 {
    let mut keys: Vec<&[u8], Gpa> = Vec::new_in(gpa);
    let mut values: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut width: i64 = 8;
    let input = { let mut v = Vec::new_in(gpa); io::stdin().read_to_end(&mut v).map(|_| v) }.unwrap();
    let lines = stats::split(gpa, input.as_slice(), b'\n');
    for l in 0..lines.len() {
        let words = stats::split(gpa, lines[l], b' ');
        if words.len() == 2 && words[0usize] == b"WIDTH" {
            width = stats::number(words[1usize]);
        } else if words.len() == 2 {
            keys.push(words[0usize]);
            values.push(stats::number(words[1usize]));
        }
    }
    let mut i: i64 = 0;
    while i < keys.len() as i64 {
        let v = stats::positive(gpa, values.as_slice(), keys.as_slice(), keys[i as usize]);
        println("{} best {}", str::from_utf8(keys[i as usize]).unwrap(), stats::best(v.as_slice()));
        i += 1;
    }
    stats::bar(width, values.len() as i64);
    0
}
