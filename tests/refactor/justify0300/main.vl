fn read(p: *const i64) -> i64 {
    unsafe { *p }
}

fn twice(p: *const i64) -> i64 {
    let a = unsafe { *p };
    // UNSAFE: a raw pointer is read
    let b = unsafe { *p };
    let c =
        unsafe { *p };
    a + b + c
}

fn pick(p: *const i64, first: bool) -> i64 {
    if first {
        0
    } else if unsafe { *p } > 0 {
        1
    } else {
        2
    }
}

fn sum(p: *const i64, n: usize) -> i64 {
    let mut total: i64 = 0;
    unsafe {
        for i in 0..n {
            total += *p.add(i);
        }
    }
    total
}

fn main() -> i32 {
    let x: i64 = 4;
    let p = &x as *const i64;
    (read(p) + twice(p) + pick(p, false) + sum(p, 1)) as i32
}
