use std::fmt::Display;

fn show<T>(x: T, y: impl   Display) where T: Display+Copy, {
    println("{x} {y}");
}

#[derive(Clone, Copy)] struct Pair<A, B>   where A: Display, B: Display { a: A, b: B }

fn long_one<Aaaaaaaaaaa, Bbbbbbbbbbbbb, Cccccccccccc>(a: &Aaaaaaaaaaa, b: &Bbbbbbbbbbbbb, c: &Cccccccccccc) -> i64 where Aaaaaaaaaaa: Display, Bbbbbbbbbbbbb: Display + Copy, Cccccccccccc: Copy {
    0
}

fn own_line<T, U>(x: T, u: &U)
where
    T: Display,
    U: Copy,
{
    println("{x}");
}

fn main() -> i32 {
    show(1i64, "a");
    own_line(2i64, &3i64);
    let p = Pair { a: 1i64, b: 2i64 };
    println("{}", p.a);
    long_one(&1i64, &2i64, &3i64) as i32
}
