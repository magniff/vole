struct Name { bytes: [u8; 8], len: i64 }

fn shown(n: Name) -> Option<[u8]> { if n.len > 0 { Some(n.bytes[..n.len]) } else { None } }

fn part(n: Name, k: i64) -> [u8] { n.bytes[..k] }

fn main(gpa: Gpa) {
    let n = Name { bytes: ['v', 'o', 'l', 'e', 0, 0, 0, 0], len: 4 };
    let a = shown(n).unwrap();
    var keep: Vec<[u8], Gpa> = Vec::new_in(gpa);
    keep.push(part(n, 2));
    keep.push(part(n, 3));
    println("{a} {} {}", keep.get(0), keep.get(1));
}
