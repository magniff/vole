mod util;

#[pure]
#[no_io]
fn mid(a: i64, b: i64) -> i64 {
    a + (b - a) / 2
}

#[effects(alloc(Gpa), panic)]
fn grow(v: inout Vec<i64, Gpa>) {
    v.push(1);
}

#[inline]
#[pure]
fn twice(x: i64) -> i64 {
    x * 2
}

fn main(gpa: Gpa) {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&v);
    println(mid(2, 10) + twice(v.len() as i64) + util::one());
}
