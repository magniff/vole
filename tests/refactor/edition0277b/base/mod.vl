// The compiler's base::buf_done in small: a slice of a buffer that is
// never written again (docs/design/src-buffer.md, "Views of other
// storage"). Its body is not one static_returns reads as 'static (a
// range of a static that is not SRC): the translator's row says it is.
pub static var BUF: [u8] = "";

pub fn fill() {
    // UNSAFE: a static var's write.
    // SAFETY: one thread; a literal, static data.
    unsafe {
        BUF = "frozen text";
    }
}

pub fn buf_done(n: i64) -> [u8] {
    // UNSAFE: a static var's read.
    // SAFETY: one thread; BUF views static data.
    unsafe { BUF[0..n] }
}
