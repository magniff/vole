// `volec check`'s unsafe.unjustified (0.25.3): each unsafe site without
// `// UNSAFE:` and `// SAFETY:` right above it is a warning.

// UNSAFE: C's puts.
// SAFETY: called with NUL-terminated literals.
extern "C" {
    fn puts(s: *u8) -> i32;
}

fn main() -> i32 {
    // UNSAFE: C's puts.
    // SAFETY: a NUL-terminated literal.
    unsafe {
        puts(c"justified");
    }
    unsafe {
        puts(c"no comments");
    }
    // SAFETY: a NUL-terminated literal (but why not safe?)
    let n = unsafe { puts(c"no UNSAFE:") };
    n
}
