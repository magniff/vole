// Named arguments (0.15) under the refactorings (0.28.0: no parameter
// has a default value; every call passes every argument).
fn area(w: i64, h: i64, depth: i64) -> i64 {
    w * h * depth
}

fn label(n: i64, unused: i64, wide: bool) -> i64 {
    if wide { n * 10 } else { n }
}

fn twice(x: i64, k: i64) -> i64 {
    x * k
}

#[derive(Clone, Copy)] struct Box { w: i64 }

impl Box {
    fn grow(&mut self, by: i64, times: i64) {
        self.w += by * times;
    }
}

fn main() -> i32 {
    let a = area(2, 1, 1);
    let b = area(2, h: 3, depth: 1);
    let c = area(2, 3, depth: 4);
    let d = area(2, h: 1, depth: 5);
    let e = twice(3, 2) + twice(4, k: 5);
    let f = label(1, unused: 0, wide: true) + label(2, 0, false) + label(3, 0, wide: false);
    let mut x = Box { w: 1 };
    x.grow(2, times: 3);
    x.grow(1, 1);
    (a + b + c + d + e + f + x.w - 2 - 6 - 24 - 10 - 26 - 15 - 8) as i32
}
