// The tools' fixes of 0.17 (tests/refactor/tools017.t).
mod calc;
mod report;
mod geo;

use calc::{Text, empties, percent, twice};
use std::cmp::min;

const GREETING: *mut u8 = c"hello";
const TITLE: &str = "totals";
static A: i64 = 1;
static B: i64 = 2;

extern "C" {
    fn puts(s: *mut u8) -> i32;
}

fn main(gpa: Gpa) -> i32 {
    let a: i64 = 3;
    let b: i64 = 4;
    println("{TITLE}: share {}%, twice {}", percent(a, b), twice(a));
    unsafe {
        puts(GREETING);
    }
    println("{} {} {} {}", geo::area(2), A + B, twice(b), calc::header());
    let words: Vec<&str, Gpa> = Vec::new_in(gpa);
    let text = Text { n: min(0, 1) };
    println("{}", empties(&words, &text));
    0
}
// EDITION: rust
