fn digit(hex: &[u8], b: u8) -> u8 {
    hex[(b >> 4) as i64]
}

fn total(xs: &[i64], from: i64, n: i32) -> i64 {
    let mut sum = 0;
    for x in &xs[from..] {
        sum += *x;
    }
    sum + xs[n] + xs[from + 1]
}

fn main() -> i32 {
    let a = [1, 2, 3, 4];
    let k: u8 = 2;
    let wide: u8 = total(&a, 1, 0) as u8;
    println("{} {} {}", a[k], digit(b"0123456789abcdef", 0x4f), wide);
    0
}
