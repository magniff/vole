// fix --edition rust (0.27.4, gate 3's fourth wall): rewrite.tsv's type
// rows where an MVS std type is written (`Arena` is `Arena<Gpa>`,
// `thread::JoinHandle<i64>` `JoinHandle<i64, Gpa>`, imported); a row's
// `$a` with no allocator given is the one in scope (`thread::spawn(f)`
// is `thread::spawn_in(f, gpa)`).
use std::{Arena, thread};

pub struct Cx<W: Allocator> {
    pub arena: W,
}

fn init(gpa: Gpa, cx: inout Cx<Arena>) {
    cx.arena = Arena::with_capacity_in(0, gpa);
}

fn work(gpa: Gpa, cx: inout Cx<Arena>) -> i64 {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(4);
    v.push(5);
    v[0] + v[1]
}

fn main(gpa: Gpa) {
    var cx: Cx<Arena> = Cx { arena: Arena::new_in(gpa) };
    init(gpa, &cx);
    let h: thread::JoinHandle<i64> = thread::spawn(sink || { 7 });
    println("{} {}", work(gpa, &cx), h.join());
}
