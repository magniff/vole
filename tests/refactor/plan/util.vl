// Helpers.

pub fn square(x: i64) -> i64 {
    times(x, x)
}

fn times(a: i64, b: i64) -> i64 {
    a * b
}

pub fn cube(x: i64) -> i64 {
    times(square(x), x)
}

pub fn unused_helper() -> i64 {
    7
}

#[derive(Clone, Copy)] pub enum Shape {
    Circle(i64),
    Dot,
    Line,
}

pub struct Pair {
    pub a: i64,
    pub b: i64,
}
