fn bump(p: *mut i64) {
    // UNSAFE: writes through the caller's pointer.
    // SAFETY: main gives a pointer to its own live local.
    unsafe {
        *p += 1;
    }
}

fn main() {
    let mut x: i64 = 41;
    let c: *const i64 = &mut x;
    bump(c);
    let m: *mut i64 = if x > 0 { c } else { c };
    bump(m);
    println("{} {}", x, c == m);
}
