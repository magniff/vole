// EDITION: rust
use std::env;
use std::fmt::Write;

// The vole side of tests/std/oracle/num_oracle.rs (0.20; std2's since
// 0.28): the same lines from std's number conversion (`{}`, `{:?}`,
// `{:e}` and `parse` of floats and integers), plus checks that need no
// oracle: every text parses back to its value, and parsing agrees with
// C's strtod and strtof. A failed check prints a line starting with
// `FAIL`. The modes and the value generators are the oracle's.
//
//   num_check f32 LO HI | f64 SEED N | parse SEED N | text SEED N | ints SEED N

// UNSAFE: C's own conversions, the second opinion on parse.
// SAFETY: each call passes a NUL-terminated buffer the caller owns and a
// null end pointer, which C allows.
extern "C" {
    fn strtod(s: *const u8, end: *mut *mut u8) -> f64;
    fn strtof(s: *const u8, end: *mut *mut u8) -> f32;
}

const CHUNK: u64 = 1048576;
const FNV_START: u64 = 0xcbf29ce484222325;

struct Fnv { h: u64 }

fn fnv_bytes(f: &mut Fnv, s: &[u8]) {
    let mut h = f.h;
    for b in s.iter() {
        h = (h ^ *b as u64).wrapping_mul(0x100000001b3);
    }
    f.h = (h ^ 10).wrapping_mul(0x100000001b3);
}

fn fnv_u64(f: &mut Fnv, x: u64, buf: &mut String<Gpa>) {
    buf.clear();
    write(buf, "{}", x).unwrap();
    fnv_bytes(f, buf.as_bytes());
}

struct Rng { s: u64 }

fn rng_next(r: &mut Rng) -> u64 {
    let mut x = r.s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    r.s = x;
    x
}

fn rng_below(r: &mut Rng, n: u64) -> u64 {
    rng_next(r) % n
}

const POW10: [f64; 21] = [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11, 1e12,
    1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20];

fn num_value(r: &mut Rng) -> f64 {
    let kind = rng_below(r, 4);
    if kind == 0 {
        loop {
            let v = f64::from_bits(rng_next(r));
            if v - v == 0.0 {
                return v;
            }
        }
    }
    if kind == 1 {
        let m = rng_next(r) & 0xfffffffffffff;
        let e = 1023 - 70 + rng_below(r, 140);
        return f64::from_bits((rng_next(r) & (1 << 63)) | (e << 52) | m);
    }
    if kind == 2 {
        let bits = rng_below(r, 64);
        return (rng_next(r) >> bits) as f64;
    }
    let digits = 1 + rng_below(r, 17);
    let mut d: u64 = 0;
    for _ in 0..digits {
        d = d * 10 + rng_below(r, 10);
    }
    let k = rng_below(r, 41) as i64 - 20;
    let p = POW10[(if k < 0 { -k } else { k }) as usize];
    if k < 0 { d as f64 / p } else { d as f64 * p }
}

fn num_text(r: &mut Rng, out: &mut [u8; 128]) -> usize {
    let mut n = 0usize;
    let sign = rng_below(r, 4);
    if sign == 0 {
        out[n] = b'-';
        n += 1;
    } else if sign == 1 {
        out[n] = b'+';
        n += 1;
    }
    let digits = if rng_below(r, 8) == 0 { 1 + rng_below(r, 40) } else { 1 + rng_below(r, 19) };
    let point = rng_below(r, digits + 2);
    let zeros = rng_below(r, 3);
    for i in 0..digits {
        if i == point && i > 0 {
            out[n] = b'.';
            n += 1;
        }
        let d = if zeros == 0 && rng_below(r, 3) == 0 { 0 } else { rng_below(r, 10) };
        out[n] = b'0' + d as u8;
        n += 1;
    }
    if point == digits {
        out[n] = b'.';
        n += 1;
    }
    if rng_below(r, 3) != 0 {
        out[n] = if rng_below(r, 2) == 0 { b'e' } else { b'E' };
        n += 1;
        let es = rng_below(r, 3);
        if es == 0 {
            out[n] = b'-';
            n += 1;
        } else if es == 1 {
            out[n] = b'+';
            n += 1;
        }
        let e = if rng_below(r, 2) == 0 { rng_below(r, 30) } else { rng_below(r, 400) };
        if e >= 100 {
            out[n] = b'0' + (e / 100) as u8;
            n += 1;
        }
        if e >= 10 {
            out[n] = b'0' + (e / 10 % 10) as u8;
            n += 1;
        }
        out[n] = b'0' + (e % 10) as u8;
        n += 1;
    }
    n
}

fn hex16(x: u64) {
    print("{:016x}", x);
}

fn fail_line(what: &str, s: &str, bits: u64) {
    println("FAIL {what} {s} {:016x}", bits);
}

fn f32_mode(lo: u64, hi: u64, gpa: Gpa) -> i32 {
    let mut out = String::new_in(gpa);
    let mut c = lo / CHUNK;
    let mut failures = 0;
    while c * CHUNK < hi {
        let mut h = Fnv { h: FNV_START };
        let start = if c * CHUNK > lo { c * CHUNK } else { lo };
        let end = if (c + 1) * CHUNK < hi { (c + 1) * CHUNK } else { hi };
        for bits in start..end {
            let v = f32::from_bits(bits as u32);
            if v - v != 0.0 {
                continue;
            }
            out.clear();
            write(&mut out, "{}", v).unwrap();
            fnv_bytes(&mut h, out.as_bytes());
            match out.as_str().parse::<f32>() {
                Ok(x) => {
                    if x.to_bits() as u64 != bits && failures < 20 {
                        fail_line("f32 roundtrip", out.as_str(), bits);
                        failures += 1;
                    }
                }
                Err(_) => fail_line("f32 parse", out.as_str(), bits),
            }
            out.clear();
            write(&mut out, "{:?}", v).unwrap();
            fnv_bytes(&mut h, out.as_bytes());
            out.clear();
            write(&mut out, "{:e}", v).unwrap();
            fnv_bytes(&mut h, out.as_bytes());
            match out.as_str().parse::<f32>() {
                Ok(x) => {
                    if x.to_bits() as u64 != bits && failures < 20 {
                        fail_line("f32 roundtrip e", out.as_str(), bits);
                        failures += 1;
                    }
                }
                Err(_) => fail_line("f32 parse e", out.as_str(), bits),
            }
        }
        print("{c} ");
        hex16(h.h);
        println("");
        c += 1;
    }
    0
}

// One digit fewer does not read back: the shortest. `e` is v's `{:e}`
// text, `D.DDDeK`; its digits with the last one dropped, rounded either
// way, must be another value.
fn check_shortest(v: f64, e: &str, buf: &mut String<Gpa>) -> bool {
    let text = e.as_bytes();
    let mut d: u64 = 0;
    let mut nd = 0;
    let mut i = 0usize;
    if text[0] == b'-' {
        i = 1;
    }
    while text[i] != b'e' {
        if text[i] != b'.' {
            d = d * 10 + (text[i] - b'0') as u64;
            nd += 1;
        }
        i += 1;
    }
    if d < 10 {
        return true;
    }
    let k: i64 = e[i + 1..].parse().unwrap();
    // (v = d * 10^(k - (nd - 1)); one digit fewer: d / 10 at one power more)
    let p = k - (nd - 1) + 1;
    for up in 0..2u64 {
        buf.clear();
        write(buf, "{}e{}", d / 10 + up, p).unwrap();
        match buf.as_str().parse::<f64>() {
            Ok(x) => {
                if x.to_bits() == (if v < 0.0 { -v } else { v }).to_bits() {
                    return false;
                }
            }
            Err(_) => return false,
        }
    }
    true
}

fn f64_mode(seed: u64, count: u64, gpa: Gpa) -> i32 {
    let mut out = String::new_in(gpa);
    let mut buf = String::new_in(gpa);
    let mut r = Rng { s: seed };
    let mut h = Fnv { h: FNV_START };
    let mut failures = 0;
    for i in 0..count {
        let v = num_value(&mut r);
        let bits = v.to_bits();
        out.clear();
        write(&mut out, "{}", v).unwrap();
        fnv_bytes(&mut h, out.as_bytes());
        match out.as_str().parse::<f64>() {
            Ok(x) => {
                if x.to_bits() != bits && failures < 20 {
                    fail_line("f64 roundtrip", out.as_str(), bits);
                    failures += 1;
                }
            }
            Err(_) => fail_line("f64 parse", out.as_str(), bits),
        }
        out.clear();
        write(&mut out, "{:?}", v).unwrap();
        fnv_bytes(&mut h, out.as_bytes());
        out.clear();
        write(&mut out, "{:e}", v).unwrap();
        fnv_bytes(&mut h, out.as_bytes());
        if !check_shortest(v, out.as_str(), &mut buf) && failures < 20 {
            fail_line("f64 not shortest", out.as_str(), bits);
            failures += 1;
        }
        if (i + 1) % CHUNK == 0 || i + 1 == count {
            print("{} ", i / CHUNK);
            hex16(h.h);
            println("");
            h.h = FNV_START;
        }
    }
    0
}

fn parse_mode(seed: u64, count: u64, text: bool, gpa: Gpa) -> i32 {
    let mut t: [u8; 128] = [0; 128];
    let mut buf = String::new_in(gpa);
    let mut r = Rng { s: seed };
    let mut h = Fnv { h: FNV_START };
    let mut failures = 0;
    for i in 0..count {
        let n = num_text(&mut r, &mut t);
        let (x, y) = {
            let s = std::str::from_utf8(&t[0..n]).unwrap();
            let x = s.parse::<f64>().unwrap();
            let y = s.parse::<f32>().unwrap();
            if text {
                println("{s} {:016x} {:016x}", x.to_bits(), y.to_bits() as u64);
                continue;
            }
            (x, y)
        };
        fnv_u64(&mut h, x.to_bits(), &mut buf);
        fnv_u64(&mut h, y.to_bits() as u64, &mut buf);
        // (C's, from a NUL-terminated copy)
        t[n] = 0;
        // UNSAFE: C's strtod and strtof read the text.
        // SAFETY: t[0..n] is the text and t[n] the NUL just written (n <
        // 128, num_text's longest is under 80); the end pointer is null.
        let (cx, cy) = unsafe {
            (strtod(t.as_ptr(), 0 as *mut *mut u8), strtof(t.as_ptr(), 0 as *mut *mut u8))
        };
        if (cx.to_bits() != x.to_bits() || cy.to_bits() != y.to_bits()) && failures < 20 {
            fail_line("parse differs from strtod", std::str::from_utf8(&t[0..n]).unwrap(),
                x.to_bits());
            failures += 1;
        }
        if (i + 1) % CHUNK == 0 || i + 1 == count {
            print("{} ", i / CHUNK);
            hex16(h.h);
            println("");
            h.h = FNV_START;
        }
    }
    0
}

fn ints_mode(seed: u64, count: u64, gpa: Gpa) -> i32 {
    let mut r = Rng { s: seed };
    let mut h = Fnv { h: FNV_START };
    let mut out = String::new_in(gpa);
    let mut buf = String::new_in(gpa);
    for i in 0..count {
        let x = rng_next(&mut r);
        let v0 = (x >> rng_below(&mut r, 64)) as i64;
        let v = if rng_below(&mut r, 2) == 0 { v0 } else { 0i64.wrapping_sub(v0) };
        out.clear();
        write(&mut out, "{}", v).unwrap();
        fnv_bytes(&mut h, out.as_bytes());
        let back = out.as_str().parse::<i64>().unwrap();
        fnv_u64(&mut h, back as u64, &mut buf);
        if back != v {
            fail_line("int roundtrip", out.as_str(), v as u64);
        }
        if (i + 1) % CHUNK == 0 || i + 1 == count {
            print("{} ", i / CHUNK);
            hex16(h.h);
            println("");
            h.h = FNV_START;
        }
    }
    0
}

fn ftext_mode(seed: u64, count: u64) -> i32 {
    let mut r = Rng { s: seed };
    for _ in 0..count {
        let v = num_value(&mut r);
        println("{:016x} {} {:?} {:e}", v.to_bits(), v, v, v);
    }
    0
}

fn main(gpa: Gpa) -> i32 {
    let mut args = env::args();
    args.next();
    let mode = args.next().unwrap_or("");
    let a = args.next().unwrap_or("").parse::<u64>();
    let b = args.next().unwrap_or("").parse::<u64>();
    let (a, b) = match (a, b) {
        (Ok(a), Ok(b)) => (a, b),
        _ => {
            eprintln(
                "usage: num_check f32 LO HI | f64 SEED N | parse SEED N | text SEED N | ints SEED N");
            return 2;
        }
    };
    if mode == "f32" {
        return f32_mode(a, b, gpa);
    }
    if mode == "f64" {
        return f64_mode(a, b, gpa);
    }
    if mode == "ftext" {
        return ftext_mode(a, b);
    }
    if mode == "parse" {
        return parse_mode(a, b, false, gpa);
    }
    if mode == "text" {
        return parse_mode(a, b, true, gpa);
    }
    ints_mode(a, b, gpa)
}
