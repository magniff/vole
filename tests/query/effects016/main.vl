// 0.16 T1 (tests/query/effects016.q): the effects inferred for each
// source: none, global, panic, diverge, unsafe, io, alloc(extern), C's
// builtin table and declarations, unknown C and its callbacks, recursion,
// counted loops and in-bounds indexes; allocators (encapsulation, generic
// instances with different A, an arena scope's discharge); closures and
// fn values (closed world).
use std::alloc::{AllocError, Allocator, Arena, Layout};
use std::cell::Cell;
use std::ptr::NonNull;

extern "C" {
    fn putchar(c: i32) -> i32;
    fn malloc(n: u64) -> *mut u8;
    fn free(p: *mut u8);
    fn labs(x: i64) -> i64;
    fn qsort(base: *mut u8, n: u64, size: u64, cmp: extern "C" fn(*const u8, *const u8) -> i32);
    #[link_name = "labs"]
    #[effects(io)]
    fn mystery(x: i64) -> i64;
    #[link_name = "llabs"]
    #[pure]
    fn ext_pure(x: i64) -> i64;
}

static mut COUNT: i64 = 0;
static LIMIT: i64 = 10;

enum Color { Red, Green }

fn plus(a: i64, b: i64) -> i64 { a + b + LIMIT }
fn bump() { unsafe { COUNT += 1; } }
fn address() -> *const i64 { &raw const COUNT }
fn at(s: &[i64], i: usize) -> i64 { s[i] }
fn part(s: &[i64]) -> &[i64] { &s[1..] }
fn whole(s: &[i64]) -> &[i64] { &s[..] }

fn color(x: i64) -> Color {
    if x == 0 { Color::Red } else if x == 1 { Color::Green } else { panic("no color") }
}

fn sum(s: &[i64]) -> i64 {
    let mut t = 0;
    for i in 0..s.len() { t += s[i]; }
    for x in s { t += *x; }
    let a = [1, 2, 3];
    for i in 0..3 { t += a[i]; }
    for x in a { t += x; }
    t + a[2]
}

fn same(a: [i64; 3], b: [i64; 3], s: &[u8], r: &[u8]) -> bool { a == b && s == r }

fn spin(n: i64) -> i64 {
    let mut k = n;
    while k > 0 { k -= 1; }
    k
}

fn forever() -> i64 { loop { return 1; } }
fn fact(n: i64) -> i64 { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn even(n: i64) -> bool { if n == 0 { true } else { odd(n - 1) } }
fn odd(n: i64) -> bool { if n == 0 { false } else { even(n - 1) } }
fn deref(p: *const i64) -> i64 { unsafe { *p } }
fn raw_index(q: *const i64) -> i64 { unsafe { *q.add(1) } }
unsafe fn trusted() -> i64 { 1 }
fn calls_c() -> i64 { unsafe { labs(-3) + ext_pure(2) } }
fn declared() -> i64 { unsafe { mystery(1) } }
fn heap() { unsafe { free(malloc(8)); } }
fn out(c: u8) { unsafe { putchar(c as i32); } }
extern "C" fn by_c(a: *const u8, b: *const u8) -> i32 { bump(); 0 }

fn sorter() {
    let mut a = [3u8, 1u8];
    unsafe { qsort(a.as_mut_ptr(), 2, 1, by_c); }
}

fn main() -> i32 {
    let v = [1, 2, 3];
    let k = t0();
    let t = plus(1, 2) + at(&v[..], 0) + sum(&v[..]) + part(&v[..]).len() as i64 + whole(&v[..]).len() as i64
        + spin(3) + forever() + fact(3) + calls_c() + unsafe { trusted() } + deref(&k) + raw_index(
            &k);
    if same(v, v, b"ab", b"ab") && even(4) {
        out(b'y');
    }
    bump();
    match color(1) {
        Color::Green => out(b'g'),
        Color::Red => out(b'r'),
    }
    heap();
    sorter();
    out(b'\n');
    if t > 0 && !address().is_null() { 0 } else { 1 }
}

fn t0() -> i64 { 5 }

struct Bump { base: *mut u8, used: Cell<usize>, cap: usize }

// UNSAFE: a test's bump allocator (Allocator is an unsafe trait).
// SAFETY: its memory is the buffer at base, cap bytes: a piece lies inside it.
unsafe impl Allocator for Bump {
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        if self.used.get() + layout.size() > self.cap {
            return Err(AllocError);
        }
        let p = unsafe { self.base.add(self.used.get()) };
        self.used.set(self.used.get() + layout.size());
        NonNull::new(p).ok_or(AllocError)
    }

    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}
}

fn fill_one<A: Allocator>(v: &mut Vec<i64, A>) { v.push(1); }

fn in_scope(a: &Arena<Gpa>) -> i64 { a.scope(|s| 1) }

fn apply(f: fn(i64) -> i64, x: i64) -> i64 { f(x) }
fn double(x: i64) -> i64 { x * 2 }
fn shout(x: i64) -> i64 { out(b'!'); x }
fn hof<F: Fn(i64) -> i64>(f: F, x: i64) -> i64 { f(x) }

fn allocators(gpa: Gpa) -> i64 {
    let mut g: Vec<i64, Gpa> = Vec::new_in(gpa);
    fill_one(&mut g);
    let mut buf = [0u8; 4096];
    let b = Bump { base: buf.as_mut_ptr(), used: Cell::new(0), cap: 4096 };
    let mut w: Vec<i64, Bump> = Vec::new_in(b);
    fill_one(&mut w);
    let k = 2;
    hof(|x| x + k, 1) + hof(|x| shout(x), 2) + apply(double, 3) + apply(shout, 4) + g.len() as i64
        + w.len() as i64
}
