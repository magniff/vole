pub trait Area {
    fn area(&self) -> i64;
    // A default.
    fn twice(self) -> i64 {
        self.area() * 2
    }
}

#[derive(Clone, Copy)] pub struct Square {
    pub side: i64,
}

impl Area for Square {
    fn area(&self) -> i64 {
        self.side * self.side
    }
}

#[derive(Clone, Copy)] pub enum Shape {
    Circle(i64),
    Dot,
}

pub const UNIT: i64 = 1;
static mut COUNT: i64 = 0;
pub type Side = i64;

// (0.28.0) COUNT's accessors: every use of it is one of them.
