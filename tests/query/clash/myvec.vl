// A user type named like std's Vec, with push, len and an inherent add.
#[derive(Clone, Copy)] pub struct Vec {
    pub n: i64,
}

impl Vec {
    pub fn push(&mut self, x: i64) {
        self.n += x;
    }

    pub fn len(self) -> i64 {
        self.n
    }

    pub fn add(&mut self, k: i64) {
        self.n += k;
    }
}
