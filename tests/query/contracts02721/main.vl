// (0.27.2.1) query contracts and query items --undeclared
trait Pick {
    fn pick(&self, i: i64) -> i64
        requires i >= 0;
}

pub struct S {
    n: i64,
}

impl Pick for S {
    fn pick(&self, j: i64) -> i64
        requires j < self.n
    {
        j
    }
}

#[effects(panic)]
pub fn declared(x: i64) -> i64
    requires x > 0
    ensures result > x
{
    x + 1
}

pub fn undeclared(s: &S) -> i64 {
    s.pick(1)
}

fn main() {
    let s = S { n: 3 };
    println("{} {}", declared(1), undeclared(&s));
}
