

#[derive(Clone, Copy)] pub enum Shape {
    Circle(i64),
    Square(i64),
}

impl Shape {
    pub fn area(self) -> i64 {
        match self {
            Shape::Circle(r) => 3 * r * r,
            Shape::Square(s) => s * s,
        }
    }

    pub fn name(self) -> &'static str {
        "shape"
    }
}

fn main(gpa: Gpa) -> i32 {
    let s = Shape::Square(2i64);
    let mut b = Vec::<u8, _>::new_in(gpa);
    b.extend_from_slice(s.name().as_bytes());
    s.area() as i32
}
