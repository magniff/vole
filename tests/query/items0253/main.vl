use std::fmt::{Display, Fmt};

pub struct Shape {
    pub w: f64,
    pub h: f64,
}

impl Shape {
    pub fn area(self) -> f64 {
        self.w * self.h
    }

    pub fn scaled(self, k: f64) -> Shape requires k > 0.0 else "shape.scale: k must be positive" {
        Shape { w: self.w * k, h: self.h * k }
    }
}

impl Display for Shape {
    fn fmt(self, f: inout Fmt) {
        f.str("shape");
    }
}

pub enum Unit {
    Metre,
    Foot,
}

const UNIT_AREA: f64 = 1.0;

fn total_area(a: Shape, b: Shape) -> f64 {
    a.area() + b.area()
}

fn main() {
    let s = Shape { w: 2.0, h: 3.0 };
    println(f"{total_area(s, s.scaled(2.0))} {UNIT_AREA}");
    let _u = Unit::Metre;
}
