// EDITION: rust
// UNSAFE: the test's unsafe fn
// SAFETY: twice has no precondition
unsafe fn twice(x: i64) -> i64 {
    x * 2
}

fn main() {
    let f: unsafe fn(i64) -> i64 = twice;
    // UNSAFE: a call through an unsafe fn pointer
    // SAFETY: f is twice, which has no precondition
    let y = unsafe { f(3) };
    let _ = y;
}
