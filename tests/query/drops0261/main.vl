// `query drops` (0.26.1): each drop of a function as the places IR
// decides it, with where it runs.
struct D<A: Allocator> { id: i64, v: Vec<i64, A> }

impl Drop for D<Gpa> {
    fn drop(inout self) {
        println("drop {}", self.id);
    }
}

fn mk(id: i64, gpa: Gpa) -> D<Gpa> {
    var v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn keep(all: inout Vec<D<Gpa>, Gpa>, d: sink D<Gpa>) {
    all.push(d);
}

fn pick(flag: bool, gpa: Gpa) -> i64 {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    var all: Vec<D<Gpa>, Gpa> = Vec::new_in(gpa);
    if flag {
        keep(&all, a);
    }
    for i in 0..3 {
        let t = mk(10 + i, gpa);
        if i == 1 {
            break;
        }
        println("{}", t.id);
    }
    let (x, _) = (b, mk(3, gpa));
    x.id + all.len() as i64
}

fn main(gpa: Gpa) {
    println("{}", pick(true, gpa));
}
