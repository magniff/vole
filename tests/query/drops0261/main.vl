// `query drops` (0.26.1): each drop of a function as the places IR
// decides it, with where it runs.
struct D { id: i64, v: Vec<i64> }

impl Drop for D {
    fn drop(inout self) {
        println(f"drop {self.id}");
    }
}

fn mk(id: i64, gpa: Gpa) -> D {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(id);
    D { id: id, v: v }
}

fn keep(all: inout Vec<D>, d: sink D) {
    all.push(d);
}

fn pick(flag: bool, gpa: Gpa) -> i64 {
    let a = mk(1, gpa);
    let b = mk(2, gpa);
    var all: Vec<D> = Vec::new_in(gpa);
    if flag {
        keep(&all, a);
    }
    for i in 0..3 {
        let t = mk(10 + i, gpa);
        if i == 1 {
            break;
        }
        println(f"{t.id}");
    }
    let (x, _) = (b, mk(3, gpa));
    x.id + all.len()
}

fn main(gpa: Gpa) {
    println(f"{pick(true, gpa)}");
}
