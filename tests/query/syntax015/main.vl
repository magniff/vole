// The syntax of 0.15 (phase 0): what the parser takes, before the checking
// is implemented. `?`, f-strings with specs, named arguments (0.28.0:
// no parameter defaults), field shorthand, `#[derive]`, generic traits and bounds with
// type arguments.

#[derive(PartialEq, Eq, PartialOrd, Ord, Debug, Clone, Copy)]
struct P { x: i64, y: i64 }

trait Convert<T> {
    fn convert(x: &T) -> Self;
}

fn area(w: i64, h: i64) -> i64 {
    w * h
}

fn pick<T: From<i64> + Eq, I: Iterator<Item = T>>(it: I) -> i64 {
    0
}

fn half(x: i64) -> Option<i64> {
    if x % 2 == 0 { Some(x / 2) } else { None }
}

fn main() -> Option<i64> {
    let x = half(8)?;
    let y = area(x, h: 2);
    let p = P { x, y };
    println("p = {p:?}, x = {x:>4}, {{y}} = {y:08x}");
    Some(p.x)
}
