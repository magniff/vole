// (0.28.0) The functions whose `query effects` answer tests/query/run.sh
// writes as their `#[effects(..)]` (effects_agree): the line `//@ NAME`
// above each names it for the query and is where the list goes.
use std::{fmt, fs, io, thread};
use std::sync::Mutex;
use std::sync::atomic::{AtomicI64, Ordering};

// UNSAFE: C's functions
// SAFETY: each is called as C declares it
extern "C" {
    fn putchar(c: i32) -> i32;
    fn malloc(n: u64) -> *mut u8;
    fn free(p: *mut u8);
}

static HITS: AtomicI64 = AtomicI64::new(0);
static mut COUNT: i64 = 0;
#[thread_local]
static mut CALLS: i64 = 0;

struct Point {
    x: i64,
    y: i64,
}

impl fmt::Display for Point {
    //@ Point::fmt
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        write(f, "({}, {})", self.x, self.y)
    }
}

trait Shape {
    fn area(&self) -> i64;
    fn name_len(&self, gpa: Gpa) -> usize;
}

impl Shape for Point {
    //@ Point::area
    fn area(&self) -> i64 {
        self.x * self.y
    }

    //@ Point::name_len
    fn name_len(&self, gpa: Gpa) -> usize {
        let mut s = String::new_in(gpa);
        s.push_str("point");
        s.len()
    }
}

impl Point {
    //@ Point::print
    fn print(&self) {
        println("{self}");
    }
}

//@ crate::say
fn say() {
    println("hi");
}

//@ crate::mid
fn mid(a: i64, b: i64) -> i64 {
    a / 2 + b / 2
}

//@ crate::at
fn at(s: &[i64], i: usize) -> i64 {
    s[i]
}

//@ crate::grow
fn grow(v: &mut Vec<i64, Gpa>) {
    v.push(1);
}

//@ crate::spawned
fn spawned(gpa: Gpa) -> i64 {
    let h = thread::spawn_in(|| 7i64, gpa);
    h.join().unwrap()
}

// (not here: `thread::scope`, whose set names `alloc(CHeap)`, a private
// type of std's that no list outside std can spell; only `alloc` admits it)

//@ crate::locked
fn locked(m: &Mutex<i64>) -> i64 {
    *m.lock().unwrap()
}

//@ crate::atomic
fn atomic() -> i64 {
    HITS.fetch_add(1, Ordering::Relaxed)
}

//@ crate::counted
fn counted() -> i64 {
    // UNSAFE: a static mut, the effect under test
    // SAFETY: one thread calls it
    unsafe {
        COUNT += 1;
        COUNT
    }
}

//@ crate::local
fn local() -> i64 {
    // UNSAFE: a thread-local static mut, the effect under test
    // SAFETY: each thread has its own
    unsafe {
        CALLS += 1;
        CALLS
    }
}

//@ crate::slurp
fn slurp(gpa: Gpa) -> io::Result<usize> {
    let s = fs::read_to_string_in("/nonexistent/vole", gpa)?;
    Ok(s.len())
}

//@ crate::spin
fn spin(n: i64) -> i64 {
    let mut k = n;
    while k != 1 {
        k = if k % 2 == 0 { k / 2 } else { 3 * k + 1 };
    }
    k
}

//@ crate::first
fn first<T: Copy>(s: &[T]) -> T {
    s[0]
}

//@ crate::show
fn show<T: fmt::Display>(x: &T) {
    println("{x}");
}

//@ crate::each
fn each<F: Fn(i64) -> i64>(s: &[i64], f: F) -> i64 {
    let mut t = 0;
    for x in s {
        t += f(*x);
    }
    t
}

//@ crate::deref
fn deref(p: *const i64) -> i64 {
    // UNSAFE: a raw pointer read, the effect under test
    // SAFETY: main passes the address of a live local
    unsafe { *p }
}

//@ crate::heap
fn heap() -> i32 {
    // UNSAFE: C's malloc, free and putchar, the effects under test
    // SAFETY: the block is freed once, and not used
    unsafe {
        let p = malloc(8);
        free(p);
        putchar(10)
    }
}

//@ crate::main
fn main(gpa: Gpa) {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    grow(&mut v);
    say();
    let p = Point { x: 2, y: 3 };
    show(&p);
    p.print();
    let m = Mutex::new(1i64);
    let x = 5i64;
    println("{} {} {} {}", mid(1, 2), at(v.as_slice(), 0), spawned(gpa), v.len());
    println("{} {} {} {}", locked(&m), atomic(), counted(), local());
    println("{} {} {}", slurp(gpa).is_ok(), spin(6), first(v.as_slice()));
    println("{} {} {}", deref(&x), heap(), each(v.as_slice(), |k| k + counted()));
    println("{} {}", p.area(), p.name_len(gpa));
}
