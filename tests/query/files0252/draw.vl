use crate::shapes::Square;

pub trait Render<T> {
    fn render(self) -> i64;
}

impl Render<Square> for Square {
    fn render(self) -> i64 {
        self.area()
    }
}

impl Square {
    pub fn outline(self) -> i64 {
        4 * self.side
    }
}

pub fn paint(s: Square) -> i64 {
    s.render() + s.outline()
}
