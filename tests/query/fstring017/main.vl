use std::fmt::Display;

fn show<T: Display>(x: T) {
    println("{}", x);
}

fn main(gpa: Gpa) {
    let n: i64 = 4;
    println("n = {n}");
    show(format_args("n = {n}"));
    let mut b: String<Gpa> = String::new_in(gpa);
    std::fmt::write(&mut b, "[{n}]").unwrap();
    let mut t = format_in("{n}!", gpa);
    println("{}", str::from_utf8(t.as_bytes()).unwrap());
    b.clear();
    t.clear();
}
