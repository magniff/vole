use std::{Buf, Display, Gpa, format_in, println};

fn show<T: Display>(x: sink T) {
    println(x);
}

fn main(gpa: Gpa) {
    let n = 4;
    println("n = {n}");
    show(format_args("n = {n}"));
    var b: String<Gpa> = String::new_in(gpa);
    b.push_fmt("[{n}]");
    var t = format_in("{n}!", gpa);
    println(t.as_slice());
    b.clear();
    t.clear();
}
