// `query drops` (0.30.1, RT-34): a function with a contract has its
// companions, made with its text; each one's drops are shown.
struct D {
    v: i64,
}

impl Drop for D {
    fn drop(&mut self) {
        println("drop {}", self.v);
    }
}

fn take(d: D) {
    println("took {}", d.v);
}

fn f(a: Vec<D, Gpa>, n: i64) -> i64
    requires n > 0
    ensures result > 0
{
    for d in a {
        take(d);
    }
    n
}

fn main(gpa: Gpa) {
    println("{}", f(Vec::from_in([D { v: 1 }, D { v: 2 }], gpa), 1));
    println("{}", g(Vec::from_in([1i64], gpa)) + g(Vec::from_in([true], gpa)));
    println("{}", h(Vec::from_in([D { v: 3 }], gpa)));
}

// (round 2) a generic function's instances are one: the first is shown
fn g<T>(v: Vec<T, Gpa>) -> usize {
    let n = v.len();
    n
}

// a #[multiversion] function's closure and its copy in the version, each
// named with the function it is in
#[multiversion("crc")]
fn h(a: Vec<D, Gpa>) -> i64 {
    let c = |d: D| d.v;
    let mut n = 0;
    for d in a {
        n += c(d);
    }
    n
}
