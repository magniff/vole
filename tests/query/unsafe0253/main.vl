// `volec query unsafe` (0.25.3): every kind of site, class and
// justification (tests/query/unsafe0253.q).
mod raw;

// UNSAFE: C's memory functions.
// SAFETY: called with sizes this file computes, pointers malloc gave.
extern "C" {
    fn malloc(n: u64) -> *u8;
    fn free(p: *u8);
    fn abs(x: i32) -> i32;
}

static var TABLE: *i64 = 0 as *i64;

union Bits {
    i: i64,
    f: f64,
}

fn main() -> i32 {
    // UNSAFE: the table is raw memory from C.
    // SAFETY: 3 i64s, 24 bytes, freed at the end.
    let p = unsafe { malloc(24) as *i64 };
    unsafe {
        TABLE = p;
        TABLE[0] = 1;
        TABLE[1] = 2;
        TABLE[2] = 3;
    }
    // SAFETY: a C call without side effects.
    let a = unsafe { abs(-4) };
    let b = add(3,
        // UNSAFE: first's contract.
        // SAFETY: p holds 3 i64s.
        unsafe { raw::first(p) });
    // UNSAFE: sum's contract.
    // SAFETY: p holds 3 i64s.
    let c = unsafe { raw::sum(p, 3, b) };
    let u = Bits { i: 1 };
    let i = unsafe { u.i }; // UNSAFE: a union. SAFETY: i was written.
    // UNSAFE: nothing here needs it.

    // SAFETY: (a blank line above: not right above)
    unsafe {
        let s = "unsafe { in a string }";
    }
    let q = unsafe { 64 as *u8 };
    unsafe { free(p as *u8); }
    (a as i64 + c + i + q as i64) as i32
}

fn add(x: i64, y: i64) -> i64 {
    x + y
}
