// Raw pointers' helpers.

// UNSAFE: p is raw.
// SAFETY: the caller passes n valid i64s.
pub unsafe fn sum(p: *i64, n: i64, extra: i64) -> i64 {
    var t = extra;
    for k in 0..n {
        t += p[k];
    }
    t
}

pub unsafe fn first(p: *i64) -> i64 {
    *p
}

// A generic never instantiated: its body is checked all the same.
pub fn peek<T>(p: *T) -> T {
    unsafe { *p }
}
