// Raw pointers' helpers.

// UNSAFE: p is raw.
// SAFETY: the caller passes n valid i64s.
pub unsafe fn sum(p: *const i64, n: i64, extra: i64) -> i64 {
    let mut t = extra;
    for k in 0..n {
        t += *p.add(k as usize);
    }
    t
}

pub unsafe fn first(p: *const i64) -> i64 {
    *p
}

// A generic never instantiated: its body is checked all the same.
pub fn peek<T: Copy>(p: *const T) -> T {
    unsafe { *p }
}
