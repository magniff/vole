// A program whose answers name std's items (tests/query/stdcache0253.q,
// 0.25.3): the same from the tools' cache.

use std::collections::HashMap;
use std::hash::FixedState;

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(2);
    let mut m: HashMap<i64, i64, Gpa, FixedState> = HashMap::new_in(gpa);
    m.insert(1, 2);
    print("{}", (v.len() as i64 + m.len() as i64));
    0
}
