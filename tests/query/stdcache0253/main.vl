// A program whose answers name std's items (tests/query/stdcache0253.q,
// 0.25.3): the same from the tools' cache.
use std::print_int;
use std::collections::HashMap;

fn main(gpa: Gpa) -> i32 {
    var v: Vec<i64> = Vec::new_in(gpa);
    v.push(2);
    var m: HashMap<i64, i64> = HashMap::new_in(gpa);
    m.insert(1, 2);
    print_int(v.len() + m.len());
    0
}
