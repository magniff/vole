#[derive(Clone, Copy)] pub struct Table { pub data: [i64; 8], pub count: i64 }

static mut TABLE: Table = Table { data: [0i64; 8], count: 0 };

// One more item: the table grows.
pub fn grow(x: i64) {
    unsafe {
        put(table_ptr(), x);
    }
}

fn put(t: *mut Table, x: i64) {
    unsafe {
        (*t).data[(*t).count as usize] = x;
        (*t).count += 1;
    }
}

pub fn peek() -> i64 {
    unsafe { get_table().count }
}

pub fn reset() {
    unsafe {
        { let mut table_copy = get_table(); table_copy.count = 0; set_table(table_copy); }
    }
}

// (0.28.0) TABLE's accessors: every use of it is one of them.
pub fn get_table() -> Table {
    unsafe { TABLE }
}

pub fn set_table(v: Table) {
    unsafe {
        TABLE = v;
    }
}

pub fn table_ptr() -> *mut Table {
    &raw mut TABLE
}
