// (0.26.2) The effects of a drop, at a check: the places IR's drop edges
// (the own pass places no drop since step 7).
struct Loud {
    n: i64,
}

impl Drop for Loud {
    fn drop(inout self) {
        println("drop {}", self.n);
    }
}

// Drops l at its end: io.
fn quiet(n: i64) -> i64 {
    let l = Loud { n: n };
    l.n + 1
}

// Gives l back: nothing dropped, no io.
fn keep(n: i64) -> Loud {
    let l = Loud { n: n };
    l
}

// Drops the temporary: io.
fn temp(n: i64) -> i64 {
    Loud { n: n }.n
}

fn main() {
    println("{}", quiet(2));
    let k = keep(3);
    println("{}", k.n + temp(4));
}
