// A small inventory for `query context` (tests/query/context.q, 0.15).

mod stock;

use stock::{Item, restock, total};

// ---- Reports ----

// The total, after restocking the empty items.
fn report(items: &mut Vec<Item<'_>, Gpa>) -> i64 {
    for i in 0..items.len() {
        restock(items, i as i64, 5);
    }
    total(items)
}

fn main(gpa: Gpa) -> i32 {
    let mut items: Vec<Item<'_>, Gpa> = Vec::new_in(gpa);
    items.push(Item { name: "bolt", count: 0 });
    items.push(Item { name: "nut", count: 3 });
    let n = report(&mut items);
    print("{}", n);
    println("");
    let m = report(&mut items);
    (n - m) as i32
}
// EDITION: rust
