// Every kind of name the language server resolves: std's items (the prelude,
// std::cli, std::thread), allocators, methods through traits, generics,
// operators, names in format literals, contracts, attributes and references.
use std::thread;
use std::alloc::{Allocator, Arena, ArenaScope, FixedBuf};
use std::cli::{Arg, Command};
use std::collections::HashMap;
use std::ops::Add;
// A point of the plane.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
struct V2 { x: i64, y: i64 }

impl Add for V2 {
    type Output = V2; fn add(self, o: V2) -> V2 { V2 { x: self.x + o.x, y: self.y + o.y } }
}

trait Named {
    fn name(&self) -> &str;
}

impl Named for V2 {
    fn name(&self) -> &str { "v2" }
}

fn label<T: Named>(t: &T) -> &str { t.name() }

fn largest<T: Ord + Copy>(s: &[T]) -> T {
    let mut m = s[0];
    for &x in s { if x > m { m = x; } }
    m
}

fn fill<A: Allocator>(v: &mut Vec<i64, A>, n: i64) { for i in 0..n { v.push(i); } }

fn bump(v: &mut Vec<i64, Gpa>, x: i64) { v.push(x); }

fn peek(v: &Vec<i64, Gpa>) -> i64
    requires v.len() > 0 else "empty"
    ensures result >= 0
{
    v.len() as i64
}

// x, twice.
#[pure]
fn twice(x: i64) -> i64 { x + x }

fn arena_sum(gpa: Gpa) -> i64 {
    Arena::new_in(gpa).scope(|a: &ArenaScope<'_, Gpa>| {
        let mut tmp: Vec<i64, &ArenaScope<'_, Gpa>> = Vec::new_in(a);
        tmp.push(1);
        tmp.len() as i64
    })
}

fn fixed() -> i64 {
    let mut mem: [u8; 256] = [0; 256];
    let fb = FixedBuf::new(&mut mem[..]);
    let mut w: Vec<i64, FixedBuf<'_>> = Vec::new_in(fb);
    w.push(2);
    w.len() as i64
}

fn main(gpa: Gpa) -> i32 {
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    v.push(1);
    bump(&mut v, 2);
    fill(&mut v, 3);
    let s = String::from_in("hi", gpa);
    let mut m: HashMap<&str, i64, Gpa> = HashMap::new_in(gpa);
    m.insert("k", 3);
    let p = V2 { x: 1, y: 2 } + V2 { x: 3, y: 4 };
    let n = label(&p);
    let big = largest(v.as_slice());
    let total = thread::scope(|sc| {
        let a = sc.spawn(|| twice(big));
        a.join().unwrap()
    });
    let cmd = Command::new_in("t", gpa).arg(Arg::flag("v"));
    let _inst = std::gpu::Instance::new_in(gpa);
    println("{} {} {n} {total} {} {} {}", v.len(), s.len(), peek(&v), arena_sum(gpa), fixed());
    let sum: i64 = v.iter().copied().sum();
    println("{}", sum);
    println("{}", more::run());
    0
}

mod more;
