// The reports: stock, members, overdue loans and totals.

use crate::Library;
use crate::catalog::Book;
use crate::loans::{days_late, late_fee};
use crate::text::{push_int, push_money};

// Every title: its id, title, copies on the shelf and copies owned.
pub fn report_stock(lib: Library, out: inout Vec<u8, Gpa>) {
    out.extend_from_slice("stock:\n");
    if lib.catalog.items.len() == 0 {
        out.extend_from_slice("  none\n");
    }
    for it in lib.catalog.items.as_slice() {
        let it: Book = it;
        out.extend_from_slice("  ");
        push_int(&out, it.id);
        out.push(' ');
        out.extend_from_slice(it.title);
        out.extend_from_slice(": ");
        push_int(&out, it.available());
        out.push('/');
        push_int(&out, it.copies);
        out.push('\n');
    }
}

// Every member: books held, fees owed and paid.
pub fn report_members(lib: Library, out: inout Vec<u8, Gpa>) {
    out.extend_from_slice("members:\n");
    if lib.members.list.len() == 0 {
        out.extend_from_slice("  none\n");
    }
    for m in lib.members.list.as_slice() {
        out.extend_from_slice("  ");
        push_int(&out, m.id);
        out.push(' ');
        out.extend_from_slice(m.name);
        out.extend_from_slice(": ");
        push_int(&out, m.on_loan);
        out.extend_from_slice(" on loan, owes ");
        push_money(&out, m.owes);
        out.extend_from_slice(", paid ");
        push_money(&out, m.paid);
        out.push('\n');
    }
}

// Every loan late on `day`, oldest first, with the fee if returned then.
pub fn report_overdue(lib: Library, day: i64, out: inout Vec<u8, Gpa>) {
    out.extend_from_slice("overdue on day ");
    push_int(&out, day);
    out.extend_from_slice(":\n");
    var count = 0;
    for l in lib.loans.list.as_slice() {
        let late = days_late(day - l.day);
        if late == 0 {
            continue;
        }
        count += 1;
        out.extend_from_slice("  ");
        match lib.members.find(l.member) {
            Some(mi) => out.extend_from_slice(lib.members.list.get(mi as usize).name),
            None => out.push('?'),
        }
        out.extend_from_slice(" has ");
        match lib.catalog.find(l.book) {
            Some(bi) => out.extend_from_slice(lib.catalog.items.get(bi as usize).title),
            None => out.push('?'),
        }
        out.extend_from_slice(", ");
        push_int(&out, late);
        out.extend_from_slice(" days late, fee ");
        push_money(&out, late_fee(day - l.day));
        out.push('\n');
    }
    if count == 0 {
        out.extend_from_slice("  none\n");
    }
}

// Totals over the whole library.
pub fn report_summary(lib: Library, out: inout Vec<u8, Gpa>) {
    out.extend_from_slice("summary: ");
    push_int(&out, lib.catalog.items.len() as i64);
    out.extend_from_slice(" titles, ");
    push_int(&out, lib.catalog.total_qty());
    out.extend_from_slice(" copies, ");
    push_int(&out, lib.catalog.total_lent());
    out.extend_from_slice(" lent, ");
    push_int(&out, lib.members.list.len() as i64);
    out.extend_from_slice(" members, owed ");
    push_money(&out, lib.members.total_owed());
    out.extend_from_slice(", collected ");
    push_money(&out, lib.collected);
    out.push('\n');
}
