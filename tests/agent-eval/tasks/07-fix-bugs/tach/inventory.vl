// The stock: items kept sorted by SKU, found by binary search.

use std::sort;

pub struct Item {
    pub sku: i64,
    pub name: [u8],
    pub price: i64, // cents
    pub stock: i64,
}

impl Ord for Item {
    fn cmp(self, other: Item) -> i64 {
        self.sku - other.sku
    }
}

pub struct Inventory {
    pub items: Vec<Item>,
}

impl Inventory {
    pub fn new(gpa: Gpa) -> Inventory {
        Inventory { items: Vec::new_in(gpa) }
    }

    pub fn add(inout self, item: Item) {
        self.items.push(item);
    }

    // Puts the items in SKU order; `find` needs it.
    pub fn sort_by_sku(inout self) {
        self.items.sort();
    }

    // The index of the item with this SKU, if there is one.
    pub fn find(self, sku: i64) -> Option<i64> {
        let items = self.items.as_slice();
        var lo = 0;
        var hi = items.len() - 1;
        while lo < hi as i64 {
            let mid = (lo + hi as i64) / 2;
            let here = items[mid].sku;
            if here == sku {
                return Some(mid);
            }
            if here < sku {
                lo = mid + 1;
            } else {
                hi = mid as usize - 1;
            }
        }
        None
    }

    // Takes `qty` units of item `index` out of stock; false (and nothing
    // taken) when there are not enough.
    pub fn take(inout self, index: i64, qty: i64) -> bool {
        let items = self.items.as_mut_slice();
        if items[index].stock < qty {
            return false;
        }
        items[index].stock -= qty;
        true
    }

    // One line per item, in SKU order: "  SKU NAME STOCK".
    pub fn report(self, out: inout Vec<u8, Gpa>) {
        out.extend_from_slice("inventory\n");
        for item in self.items.as_slice() {
            out.extend_from_slice("  ");
            out.extend_from_slice(format_in("{}", item.sku, out.allocator()).as_bytes());
            out.push(' ');
            out.extend_from_slice(item.name);
            out.push(' ');
            out.extend_from_slice(format_in("{}", item.stock, out.allocator()).as_bytes());
            out.push('\n');
        }
    }
}
