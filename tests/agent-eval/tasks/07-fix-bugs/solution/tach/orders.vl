// Orders: each line is filled from the inventory or rejected, then the
// order's discount and total are computed.

use crate::inventory::Inventory;
use crate::money::{percent_of, push_cents};

pub enum Tier {
    Basic,
    Silver,
    Gold,
}

pub fn parse_tier(word: [u8]) -> Tier {
    if word == "gold" {
        Tier::Gold
    } else if word == "silver" {
        Tier::Silver
    } else {
        Tier::Basic
    }
}

pub fn tier_name(tier: Tier) -> [u8] {
    match tier {
        Tier::Basic => "basic",
        Tier::Silver => "silver",
        Tier::Gold => "gold",
    }
}

pub struct OrderLine {
    pub sku: i64,
    pub qty: i64,
}

pub struct Order {
    pub customer: [u8],
    pub tier: Tier,
    pub lines: Vec<OrderLine>,
}

// Orders of at least this much (in cents, before discount) get BULK_PERCENT more off.
const BULK_MIN: i64 = 10000;
const BULK_PERCENT: i64 = 5;

// The discount, in percent, for an order of `subtotal` cents.
pub fn discount_percent(tier: Tier, subtotal: i64) -> i64 {
    var percent = match tier {
        Tier::Basic => 0,
        Tier::Silver => 5,
        Tier::Gold => 10,
    };
    if subtotal >= BULK_MIN {
        percent += BULK_PERCENT;
    }
    percent
}

// What one order has added up to so far.
struct Tally {
    subtotal: i64,
    filled: i64,
    rejected: i64,
}

impl Tally {
    fn new() -> Tally {
        Tally { subtotal: 0, filled: 0, rejected: 0 }
    }

    // Starts the next order.
    fn reset(inout self) {
        self.subtotal = 0;
        self.filled = 0;
        self.rejected = 0;
    }
}

// Fills one order line, or rejects it; writes its report line.
fn fill_line(inv: inout Inventory, line: OrderLine, tally: inout Tally, out: inout Vec<u8, Gpa>) {
    out.extend_from_slice("  ");
    out.extend_from_slice(format_in("{}", line.sku, out.allocator()).as_bytes());
    let index = match inv.find(line.sku) {
        Some(i) => i,
        None => {
            out.extend_from_slice(" x");
            out.extend_from_slice(format_in("{}", line.qty, out.allocator()).as_bytes());
            out.extend_from_slice(": unknown\n");
            tally.rejected += 1;
            return;
        }
    };
    let item = inv.items.get(index as usize);
    out.push(' ');
    out.extend_from_slice(item.name);
    out.extend_from_slice(" x");
    out.extend_from_slice(format_in("{}", line.qty, out.allocator()).as_bytes());
    if !inv.take(index, line.qty) {
        out.extend_from_slice(": short (");
        out.extend_from_slice(format_in("{}", item.stock, out.allocator()).as_bytes());
        out.extend_from_slice(" in stock)\n");
        tally.rejected += 1;
        return;
    }
    let cost = item.price * line.qty;
    out.extend_from_slice(" @ ");
    push_cents(&out, item.price);
    out.extend_from_slice(" = ");
    push_cents(&out, cost);
    out.push('\n');
    tally.subtotal += cost;
    tally.filled += 1;
}

// Processes the orders in turn and writes their reports; returns the
// revenue (the sum of the totals).
pub fn process_orders(inv: inout Inventory, list: Vec<Order>, out: inout Vec<u8, Gpa>) -> i64 {
    var revenue = 0;
    var tally = Tally::new();
    for i in 0..list.len() {
        let order = list[i];
        tally.reset();
        out.extend_from_slice("order ");
        out.extend_from_slice(format_in("{}", i as i64 + 1, out.allocator()).as_bytes());
        out.push(' ');
        out.extend_from_slice(order.customer);
        out.extend_from_slice(" (");
        out.extend_from_slice(tier_name(order.tier));
        out.extend_from_slice(")\n");
        for line in order.lines.as_slice() {
            fill_line(&inv, line, &tally, &out);
        }
        let percent = discount_percent(order.tier, tally.subtotal);
        let discount = percent_of(tally.subtotal, percent);
        let total = tally.subtotal - discount;
        out.extend_from_slice("  subtotal ");
        push_cents(&out, tally.subtotal);
        out.extend_from_slice(", discount ");
        out.extend_from_slice(format_in("{}", percent, out.allocator()).as_bytes());
        out.extend_from_slice("% ");
        push_cents(&out, discount);
        out.extend_from_slice(", total ");
        push_cents(&out, total);
        out.extend_from_slice(" (");
        out.extend_from_slice(format_in("{}", tally.filled, out.allocator()).as_bytes());
        out.extend_from_slice(" filled, ");
        out.extend_from_slice(format_in("{}", tally.rejected, out.allocator()).as_bytes());
        out.extend_from_slice(" rejected)\n");
        revenue += total;
    }
    revenue
}
