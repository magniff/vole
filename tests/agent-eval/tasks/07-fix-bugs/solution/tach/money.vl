// Money is kept in cents (an integer) and printed as D.CC.

// Appends `cents` as dollars and cents: 1234 -> "12.34", 5 -> "0.05".
pub fn push_cents(out: inout Vec<u8, Gpa>, cents: i64) {
    var c = cents;
    if c < 0 {
        out.push('-');
        c = -c;
    }
    out.extend_from_slice(format_in("{}", c / 100, out.allocator()).as_bytes());
    out.push('.');
    let rest = c % 100;
    if rest < 10 {
        out.push('0');
    }
    out.extend_from_slice(format_in("{}", rest, out.allocator()).as_bytes());
}

// `percent`% of `cents`, rounded down to a whole cent.
pub fn percent_of(cents: i64, percent: i64) -> i64 {
    cents * percent / 100
}
