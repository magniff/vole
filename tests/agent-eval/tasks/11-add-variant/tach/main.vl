// A stack machine: reads a program from stdin, checks it, lists it if
// asked, runs it, and reports how it stopped.

mod op;
mod parse;
mod verify;
mod vm;

import "stdio.h" as c;

use op::{Op, kind_name, mnemonic};
use vm::{DIVIDE_BY_ZERO, HALTED, OUT_OF_STEPS};

// The instruction as a listing shows it: its name and operand.
fn write_op(out: inout Vec<u8, Gpa>, op: Op) {
    out.extend_from_slice(mnemonic(op));
    match op {
        Op::Push(n) | Op::Jmp(n) | Op::Jz(n) => {
            out.push(' ');
            out.extend_from_slice(format_in("{}", n, out.allocator()).as_bytes());
        }
        Op::Pop | Op::Dup | Op::Swap | Op::Over => {}
        Op::Add | Op::Sub | Op::Mul | Op::Div | Op::Mod | Op::Lt | Op::Eq => {}
        Op::Print | Op::Halt => {}
    }
}

fn main(gpa: Gpa) -> i32 {
    var input = Vec::<u8, Gpa>::new_in(gpa);
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        input.push(ch as u8);
    }
    var out = Vec::<u8, Gpa>::new_in(gpa);
    run_program(input.as_slice(), &out, gpa);
    print(out.as_slice());
    0
}

fn run_program(input: [u8], out: inout Vec<u8, Gpa>, gpa: Gpa) {
    var prog = match parse::parse(input, gpa) {
        Ok(p) => p,
        Err(e) => {
            out.extend_from_slice("parse error on line ");
            out.extend_from_slice(format_in("{}", e.line, out.allocator()).as_bytes());
            out.extend_from_slice(": ");
            e.message.push_to(&out);
            out.push('\n');
            return;
        }
    };
    if let Err(e) = verify::verify(prog.ops.as_slice(), gpa) {
        out.extend_from_slice("verify error at ");
        out.extend_from_slice(format_in("{}", e.pc, out.allocator()).as_bytes());
        out.extend_from_slice(": ");
        out.extend_from_slice(e.message);
        out.push('\n');
        return;
    }
    if prog.list {
        for pc in 0..prog.ops.len() {
            out.extend_from_slice(format_in("{}", pc as i64, out.allocator()).as_bytes());
            out.extend_from_slice(": ");
            write_op(&out, prog.ops.get(pc));
            out.push('\n');
        }
    }
    var m = vm::run(prog.ops.as_slice(), &out, gpa);
    if m.status == HALTED {
        out.extend_from_slice("halted");
    } else if m.status == DIVIDE_BY_ZERO {
        out.extend_from_slice("division by zero");
    } else if m.status == OUT_OF_STEPS {
        out.extend_from_slice("out of steps");
    }
    out.extend_from_slice(" at ");
    out.extend_from_slice(format_in("{}", m.pc, out.allocator()).as_bytes());
    out.extend_from_slice(" after ");
    out.extend_from_slice(format_in("{}", m.steps, out.allocator()).as_bytes());
    out.extend_from_slice(" steps, cost ");
    out.extend_from_slice(format_in("{}", m.cost, out.allocator()).as_bytes());
    out.push('\n');
    out.extend_from_slice("stack:");
    if m.stack.len() == 0 {
        out.extend_from_slice(" empty");
    }
    for v in m.stack.as_slice() {
        out.push(' ');
        out.extend_from_slice(format_in("{}", v, out.allocator()).as_bytes());
    }
    out.push('\n');
    for k in 0..4 {
        out.extend_from_slice(if k == 0 { "steps: " } else { ", " });
        out.extend_from_slice(kind_name(k));
        out.push(' ');
        out.extend_from_slice(format_in("{}", m.counts[k], out.allocator()).as_bytes());
    }
    out.push('\n');
}
