// A line calculator: each line of stdin is an expression over 64-bit
// integers; its value (or an error) is printed on a line of its own.

mod eval;
mod lexer;
mod parser;

import "stdio.h" as c;

use std::HashMap;

use eval::{EvalError, evaluate};
use lexer::tokenize;
use parser::parse;

fn read_all(gpa: Gpa) -> Vec<u8, Gpa> {
    var b = Vec::<u8, Gpa>::new_in(gpa);
    loop {
        let ch = unsafe { c::getchar() };
        if ch < 0 {
            break;
        }
        b.push(ch as u8);
    }
    b
}

// Evaluates one line and appends the result line to `out`. A line with
// no tokens (blank, or only a comment) prints nothing.
fn run_line(line: [u8], vars: inout HashMap<[u8], i64>, out: inout Vec<u8, Gpa>, gpa: Gpa) {
    var tokens = match tokenize(line, gpa) {
        Some(t) => t,
        None => {
            out.extend_from_slice("error: syntax\n");
            return;
        }
    };
    if tokens.len() == 1 {
        return; // only the end marker
    }
    var tree = match parse(tokens, gpa) {
        Some(t) => t,
        None => {
            out.extend_from_slice("error: syntax\n");
            return;
        }
    };
    match evaluate(tree, tree.root, vars) {
        Ok(v) => {
            if let Some(name) = tree.let_name {
                out.extend_from_slice(name);
                out.extend_from_slice(" = ");
                vars.insert(name, v);
            }
            out.extend_from_slice(format_in("{}", v, out.allocator()).as_bytes());
            out.push('\n');
        }
        Err(EvalError::DivisionByZero) => out.extend_from_slice("error: division by zero\n"),
        Err(EvalError::UnknownVariable(name)) => {
            out.extend_from_slice("error: unknown variable ");
            out.extend_from_slice(name);
            out.push('\n');
        }
    }
}

fn main(gpa: Gpa) -> i32 {
    let input = read_all(gpa);
    let text = input.as_slice();
    var vars: HashMap<[u8], i64> = HashMap::new_in(gpa);
    var out = Vec::<u8, Gpa>::new_in(gpa);
    var start = 0;
    for i in 0..text.len() + 1 {
        if i == text.len() || text[i] == '\n' {
            run_line(text[start..i], &vars, &out, gpa);
            start = i as i64 + 1;
        }
    }
    print(out.as_slice());
    0
}
