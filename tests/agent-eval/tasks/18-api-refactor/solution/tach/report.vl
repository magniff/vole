// What the program prints about a level and its state.

use crate::grid::{Pos, cell_index, push_pos, tile_at};
use crate::level::{Level, LoadError};
use crate::world::World;

// The line for a load_level error.
pub fn push_load_error(out: inout Vec<u8, Gpa>, err: LoadError) {
    out.extend_from_slice("error: ");
    match err {
        LoadError::EmptyMap => out.extend_from_slice("the map is empty"),
        LoadError::NoSeparator => out.extend_from_slice("no '---' line after the map"),
        LoadError::RaggedRow(row, len, width) => {
            out.extend_from_slice("row ");
            out.extend_from_slice(format_in("{}", row, out.allocator()).as_bytes());
            out.extend_from_slice(" has length ");
            out.extend_from_slice(format_in("{}", len, out.allocator()).as_bytes());
            out.extend_from_slice(", expected ");
            out.extend_from_slice(format_in("{}", width, out.allocator()).as_bytes());
        }
        LoadError::UnknownTile(at, tile) => {
            out.extend_from_slice("unknown tile '");
            out.push(tile);
            out.extend_from_slice("' at ");
            push_pos(&out, at);
        }
        LoadError::NoRobot => out.extend_from_slice("no robot on the map"),
        LoadError::SecondRobot(at) => {
            out.extend_from_slice("second robot at ");
            push_pos(&out, at);
        }
        LoadError::OddTeleporters(n) => {
            out.extend_from_slice(format_in("{}", n, out.allocator()).as_bytes());
            out.extend_from_slice(" teleporters, expected an even number");
        }
    }
    out.push('\n');
}

// "level WxH, B boxes, G goals, T teleporters"
pub fn push_summary(out: inout Vec<u8, Gpa>, level: Level) {
    out.extend_from_slice("level ");
    out.extend_from_slice(format_in("{}", level.width, out.allocator()).as_bytes());
    out.push('x');
    out.extend_from_slice(format_in("{}", level.height, out.allocator()).as_bytes());
    out.extend_from_slice(", ");
    out.extend_from_slice(format_in("{}", level.boxes.len() as i64, out.allocator()).as_bytes());
    out.extend_from_slice(" boxes, ");
    out.extend_from_slice(format_in("{}", level.goals.len() as i64, out.allocator()).as_bytes());
    out.extend_from_slice(" goals, ");
    out.extend_from_slice(
        format_in("{}", level.teleporters.len() as i64, out.allocator()).as_bytes());
    out.extend_from_slice(" teleporters\n");
}

// "moves M, pushes P, boxes on goals B/N", and " (solved)" when every
// box is on a goal.
pub fn push_status(out: inout Vec<u8, Gpa>, level: Level, world: World) {
    let on = world.boxes_on_goals(level);
    let n = world.boxes.len();
    out.extend_from_slice("moves ");
    out.extend_from_slice(format_in("{}", world.moves, out.allocator()).as_bytes());
    out.extend_from_slice(", pushes ");
    out.extend_from_slice(format_in("{}", world.pushes, out.allocator()).as_bytes());
    out.extend_from_slice(", boxes on goals ");
    out.extend_from_slice(format_in("{}", on, out.allocator()).as_bytes());
    out.push('/');
    out.extend_from_slice(format_in("{}", n as i64, out.allocator()).as_bytes());
    if n > 0 && on == n as i64 {
        out.extend_from_slice(" (solved)");
    }
    out.push('\n');
}

// The map as it is now: '@' the robot, '$' a box, '*' a box on a goal.
pub fn push_map(out: inout Vec<u8, Gpa>, level: Level, world: World, gpa: Gpa) {
    var cells: Vec<u8> = Vec::new_in(gpa);
    for i in 0..level.tiles.len() {
        cells.push(level.tiles.get(i));
    }
    for i in 0..world.boxes.len() {
        let b = world.boxes.get(i);
        let k = cell_index(level, b);
        cells.set(k as usize, if tile_at(level, b) == 'G' { '*' } else { '$' });
    }
    cells.set(cell_index(level, world.robot) as usize, '@');
    for r in 0..level.height {
        for c in 0..level.width {
            out.push(cells.get(cell_index(level, Pos::new(r, c)) as usize));
        }
        out.push('\n');
    }
}
