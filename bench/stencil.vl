// EDITION: rust
// A 5-point stencil (Jacobi relaxation) on a 400x400 grid of f64, 200
// sweeps, through slices: loops, bounds checks, strided addresses.
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *mut u8;
}

const N: i64 = 400;

fn sweep(src: &[f64], dst: &mut [f64]) {
    for i in 1..N - 1 {
        for j in 1..N - 1 {
            let k = i * N + j;
            dst[k as usize] = 0.25 * (
                src[(k - 1) as usize] + src[(k + 1) as usize] + src[(k - N) as usize] + src[
                    (k + N) as usize]);
        }
    }
}

fn main() -> i32 {
    let a = unsafe { calloc((N * N) as u64, 8) as *mut f64 };
    let b = unsafe { calloc((N * N) as u64, 8) as *mut f64 };
    let sa = unsafe { std::slice::from_raw_parts_mut(a.add((0) as usize), (N * N - (0)) as usize) };
    let sb = unsafe { std::slice::from_raw_parts_mut(b.add((0) as usize), (N * N - (0)) as usize) };
    // A hot edge: the left column at 100.
    for i in 0..N {
        sa[(i * N) as usize] = 100.0;
        sb[(i * N) as usize] = 100.0;
    }
    for _ in 0..100 {
        sweep(sa, sb);
        sweep(sb, sa);
    }
    let mut total = 0.0;
    for k in 0..N * N {
        total += sa[k as usize];
    }
    unsafe { printf(c"%.6f\n", total); }
    0
}
