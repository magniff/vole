// EDITION: rust

// bench/std: parse 1,000,000 float texts `d.ddddddddddddddddeX` (17 random
// digits, the exponent in [-300, 300]: the shape of a shortest f64) with
// std::num::parse_f64, the texts made first, in one Buf, five times. Prints the
// count and the FNV-1a hash of the bits read.
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 1000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut text = Vec::<u8, Gpa>::with_capacity_in(n as usize * 24, gpa);
    for _ in 0..n {
        let mut m = next(&mut st) % 100000000000000000;
        let mut d: [u8; 17] = [0; 17];
        for k in 0..17 {
            d[(16 - k) as usize] = b'0' + (m % 10) as u8;
            m = m / 10;
        }
        text.push(d[0]);
        text.push(b'.');
        text.extend_from_slice(&d[1..17]);
        let e = (next(&mut st) % 601) as i64 - 300;
        text.extend_from_slice(format_in("e{e} ", *text.allocator()).as_bytes());
    }
    let s = text.as_slice();
    let mut h = 0xcbf29ce484222325u64;
    let mut count: i64 = 0;
    for _ in 0..5 {
        let mut start: i64 = 0;
        for i in 0..s.len() {
            if s[i] == b' ' {
                let v = str::from_utf8(&s[start as usize..i]).unwrap().parse::<f64>().unwrap();
                h = (h ^ v.to_bits()) * 0x100000001b3u64;
                count += 1;
                start = i as i64 + 1;
            }
        }
    }
    println("{count} {h}");
    0
}
