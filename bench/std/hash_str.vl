// bench/std: word count, 4,000,000 pseudo-random words (about 20 MB of
// text, skewed toward short frequent words) counted in a
// HashMap<[u8], u64> keyed by slices of the text. Prints the distinct
// words, the words, and the sum of the counts' squares.
use std::collections::HashMap;

fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let words: i64 = 4000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut text: Vec<u8, Gpa> = Vec::with_capacity_in(words as usize * 6, gpa);
    for _ in 0..words {
        let a = next(&mut st) % 4096u64;
        let b = next(&mut st) % 4096u64;
        let mut id = a * b / 64u64;
        loop {
            text.push(b'a' + (id % 26u64) as u8);
            id = id / 26u64;
            if id == 0u64 {
                break;
            }
        }
        text.push(b' ');
    }
    let s = text.as_slice();
    let mut counts: HashMap<&[u8], u64, Gpa, FixedState> = HashMap::new_in(gpa);
    let mut total = 0u64;
    let mut i: i64 = 0;
    while i < s.len() as i64 {
        let start = i;
        while s[i as usize] != b' ' {
            i += 1;
        }
        *counts.entry(&s[start as usize..i as usize]).or_insert(0u64) += 1u64;
        total += 1u64;
        i += 1;
    }
    let mut squares = 0u64;
    for (_, c) in counts.iter() {
        squares += *c * *c;
    }
    println("{} {total} {squares}", counts.len());
    0
}
