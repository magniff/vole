// EDITION: rust
// bench/std: str's methods on 2,000,000 CSV-like lines (`k123, -4567 ,
// abcab`, made first): lines(), split(','), trim(), parse::<i64>(),
// starts_with, contains, three times. Prints the lines, the sum of the
// numbers, the words that contain "ab" and the keys that start with "k1".
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 2000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut text = String::with_capacity_in(n as usize * 32, gpa);
    let letters: &[u8] = b"abcde";
    for _ in 0..n {
        let r = next(&mut st);
        std::fmt::write(&mut text, "k{}, {} , ", r % 1000, (r >> 10) as i64 % 100000 - 50000).unwrap();
        let len = 3 + (r >> 40) % 6;
        for j in 0..len {
            text.push(
                char::from_u32((letters[((r >> (j * 3)) % 5) as usize] as u32)).unwrap());
        }
        text.push(char::from_u32('\n' as u32).unwrap());
    }
    let s = text.as_str();
    let mut lines: i64 = 0;
    let mut sum: i64 = 0;
    let mut ab: i64 = 0;
    let mut k1: i64 = 0;
    for _ in 0..3 {
        for line in s.lines() {
            let mut f = line.split(',');
            let key = f.next().unwrap();
            let num = f.next().unwrap().trim().parse::<i64>().unwrap_or(0);
            let word = f.next().unwrap().trim();
            lines += 1;
            sum += num;
            if word.contains(&"ab") {
                ab += 1;
            }
            if key.starts_with("k1") {
                k1 += 1;
            }
        }
    }
    println("{lines} {sum} {ab} {k1}");
    0
}
