// bench/std: Display of 10,000,000 random i64 (random magnitude and sign)
// into one Buf, a space after each, cleared every 64 KB. Prints the length
// written and the FNV-1a hash.
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn hash(h: u64, s: &[u8]) -> u64 {
    let mut x = h;
    for i in 0..s.len() {
        x = (x ^ s[i] as u64) * 0x100000001b3u64;
    }
    x
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 10000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut out = String::with_capacity_in(1 << 17, gpa);
    let mut h = 0xcbf29ce484222325u64;
    let mut total: i64 = 0;
    for _ in 0..n {
        let r = next(&mut st);
        let v0 = (r >> (r & 63)) as i64;
        let v = if (r & 64) != 0 { 0 - v0 } else { v0 };
        std::fmt::write(&mut out, "{v} ").unwrap();
        if out.len() > 65536 {
            h = hash(h, out.as_bytes());
            total += out.len() as i64;
            out.clear();
        }
    }
    h = hash(h, out.as_bytes());
    total += out.len() as i64;
    println("{total} {h}");
    0
}
