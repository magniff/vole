// bench/std chars (0.20 A4): the number of code points plus their sum, over
// source-like ASCII and mixed text (text_gen.vl): `s.chars().count()`
// and the chars' sum. Rust: the same; C: a decode loop by hand.
mod text_gen;

fn main(gpa: Gpa) -> i32 {
    text_gen::run_str("chars", &[0, 4], |s| {
        let n = s.chars().count() as u64;
        n + s.chars().fold(0u64, |a, c| a + c as u64)
    }, gpa)
}
