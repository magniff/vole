// bench/std: parse 10,000,000 decimal i64 texts (random magnitude and
// sign, made first, in one Buf) with parse_int, three times. Prints the
// count and the sum (a text out of range counts 0).
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 10000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut text = Vec::<u8, Gpa>::with_capacity_in(n as usize * 21, gpa);
    for _ in 0..n {
        let r = next(&mut st);
        let mut m = r >> (r & 63);
        if (r & 64) != 0 {
            text.push(b'-');
        }
        let mut d: [u8; 20] = [0; 20];
        let mut k: i64 = 20;
        loop {
            k -= 1;
            d[k as usize] = b'0' + (m % 10) as u8;
            m = m / 10;
            if m == 0 {
                break;
            }
        }
        text.extend_from_slice(&d[k as usize..20]);
        text.push(b' ');
    }
    let t = std::str::from_utf8(text.as_slice()).unwrap();
    let s = t.as_bytes();
    let mut sum: i64 = 0;
    let mut count: i64 = 0;
    for _ in 0..3 {
        let mut start: i64 = 0;
        for i in 0..s.len() {
            if s[i] == b' ' {
                sum += t[start as usize..i].parse::<i64>().unwrap_or(0);
                count += 1;
                start = i as i64 + 1;
            }
        }
    }
    println("{count} {sum}");
    0
}
