// EDITION: rust
// bench/std spawn (0.20, A7; the sys half of B6's row): 1000 times, spawn
// /usr/bin/true through std's OS layer (sys_spawn: posix_spawnp, the
// environment inherited) and wait for it (sys_waitpid); then the number
// that exited 0. spawn.rs is Rust's Command::status, spawn.c posix_spawn
// and waitpid.
use std::sys::{SysSpawnActions, sys_exit_code, sys_spawn, sys_waitpid};

fn main() -> i32 {
    let argv: [*const u8; 2] = [c"/usr/bin/true", std::ptr::null()];
    let none: [*const u8; 0] = [];
    let mut ok = 0;
    for _ in 0..1000 {
        // (argv: C strings, then null)
        // UNSAFE: sys_spawn takes raw C strings.
        // SAFETY: argv holds a C string literal and the null that ends it;
        // no file actions.
        let pid = unsafe { sys_spawn(argv[0], &argv, &none, std::ptr::null::<SysSpawnActions>()) }
        .unwrap();
        let w = sys_waitpid(pid, false).unwrap();
        if sys_exit_code(w.1) == Some(0) {
            ok += 1;
        }
    }
    println("{ok}");
    0
}
