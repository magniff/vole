// EDITION: rust
// bench/std: sort 5,000,000 random u64 (xorshift64), stable
// (std::sort_stable_in, driftsort since 0.20; Rust: sort; C: mergesort). Prints
// a checksum of the sorted values.
fn next(s: &mut u64) -> u64 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    *s = x;
    x
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 5000000;
    let mut st = 0x9E3779B97F4A7C15u64;
    let mut v: Vec<u64, Gpa> = Vec::with_capacity_in(n as usize, gpa);
    for _ in 0..n {
        v.push(next(&mut st));
    }
    v.as_mut_slice().sort_in(gpa);
    let s = v.as_slice();
    let mut sum = 0u64;
    for i in 0..n {
        sum = sum * 31u64 + s[i as usize];
    }
    println("{sum}");
    0
}
