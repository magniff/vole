// EDITION: rust
// The text of bench/fmtloop.vl made without f-strings: Buf's push_int
// and push_str, hex digits and padding by hand (bench/run.sh prints the
// ratio of the two times).

fn push_hex(b: &mut Vec<u8, Gpa>, v: u32) {
    let digits = "0123456789abcdef";
    let mut d: [u8; 8] = [0; 8];
    let mut n: i64 = 8;
    let mut u = v;
    loop {
        n -= 1;
        d[n as usize] = digits[(u & 15) as usize];
        u = u >> 4;
        if u == 0 {
            break;
        }
    }
    b.extend_from_slice(&d[n as usize..8]);
}

fn main(gpa: Gpa) {
    let mut x: u64 = 88172645463325252;
    let mut b = Vec::<u8, Gpa>::new_in(gpa);
    let mut total: i64 = 0;
    for i in 0..1000000 {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        let k = (x % 2000) as i64 - 1000;
        let h = (x >> 40) as u32;
        b.extend_from_slice(format_in("{}", i, *b.allocator()).as_bytes());
        b.push(b' ');
        b.extend_from_slice(format_in("{}", k, *b.allocator()).as_bytes());
        b.push(b' ');
        push_hex(&mut b, h);
        b.push(b' ');
        let m = i * 3 % 7;
        if m < 10 {
            b.extend_from_slice(b"  ");
        } else if m < 100 {
            b.push(b' ');
        }
        b.extend_from_slice(format_in("{}", m, *b.allocator()).as_bytes());
        b.extend_from_slice(b"|\n");
        if b.len() > 60000 {
            total += b.len() as i64;
            b.clear();
        }
    }
    total += b.len() as i64;
    print("{}", str::from_utf8(b.as_slice()).unwrap());
    print("{}", total);
    println(" bytes");
}
