// Sieve of Eratosthenes up to 30,000,000: the number of primes.
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
    fn calloc(count: u64, size: u64) -> *mut u8;
}

fn count_primes(limit: i64) -> i64 {
    let composite = unsafe { calloc(limit as u64 + 1, 1) };
    let mut count: i64 = 0;
    let mut i: i64 = 2;
    while i <= limit {
        if unsafe { (*composite.add(i as usize)) == 0 } {
            count += 1;
            let mut j = i * i;
            while j <= limit {
                unsafe { (*composite.add(j as usize)) = 1; }
                j += i;
            }
        }
        i += 1;
    }
    count
}

fn main() -> i32 {
    unsafe { printf(c"%ld\n", count_primes(30000000)); }
    0
}
