// Iterator chains (0.14): six kernels over a vector of 2^20 integers, as
// chains of std's adapters and closures; bench/iterloop.vl computes the
// same with hand-written loops, and bench/run.sh prints the ratio of the
// two times (zero cost: about 1).

extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[inline(never)]
fn filter_map_sum(v: &Vec<i64, Gpa>, r: i64) -> i64 {
    v.iter().copied().filter(|x| *x & 1 == 0).map(|x| x * x + r).sum::<i64>()
}

#[inline(never)]
fn dot(v: &Vec<i64, Gpa>, w: &Vec<i64, Gpa>, r: i64) -> i64 {
    v.iter().copied().zip(w.iter().copied()).map(|(a, b)| a * b + r).sum::<i64>()
}

#[inline(never)]
fn enumerate_sum(v: &Vec<i64, Gpa>, r: i64) -> i64 {
    v.iter().copied().enumerate().map(|(i, x)| i as i64 * x + r).sum::<i64>()
}

#[inline(never)]
fn max_count(v: &Vec<i64, Gpa>, r: i64) -> i64 {
    v.iter().copied().map(|x| x ^ r).max().unwrap() + v
        .iter()
        .copied()
        .filter(|x| *x > r)
        .count() as i64
}

#[inline(never)]
fn take_loop(v: &Vec<i64, Gpa>, n: i64) -> i64 {
    let mut t: i64 = 0;
    for x in v.iter().copied().take(n as usize) {
        t += x;
    }
    t
}

#[inline(never)]
fn collect_sort(v: &Vec<i64, Gpa>, m: i64, r: i64, gpa: Gpa) -> i64 {
    let mut u = v
        .iter()
        .copied()
        .take(m as usize)
        .map(|x| x ^ r)
        .collect_in::<Vec<i64, Gpa>, _>(gpa);
    u.sort_unstable_by(|a, b| b.cmp(a));
    u[0usize] - u[m as usize - 1] + u[m as usize / 2]
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 1048576;
    let reps: i64 = 200;
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);
    let mut w: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);
    for i in 0..n {
        v.push(i * 2654435761 % 1000003 % 1001 - 500);
        w.push(i % 17 - 8);
    }
    let mut c1: i64 = 0;
    let mut c2: i64 = 0;
    let mut c3: i64 = 0;
    let mut c4: i64 = 0;
    let mut c5: i64 = 0;
    for r in 0..reps {
        c1 += filter_map_sum(&v, r);
        c2 += dot(&v, &w, r);
        c3 += enumerate_sum(&v, r);
        c4 += max_count(&v, r * 4999);
        c5 += take_loop(&v, n - r);
    }
    let mut c6: i64 = 0;
    for r in 0..10 {
        c6 += collect_sort(&v, 65536, r, gpa);
    }
    unsafe { printf(c"%ld %ld %ld %ld %ld %ld\n", c1, c2, c3, c4, c5, c6); }
    0
}
