// (0.25.4) Loops over a std Vec<i64> reached through a parameter and over
// a static Vec of 48-byte nodes, the kernels of
// docs/design/modernize-0254.md §2; bench/vecloop/raw.vl is the same
// program on the compiler's older idiom (an IntVec-like struct of a raw
// pointer, a count and a capacity; a raw static table with its count).
// The two print the same lines. With an argument 1-8 only that kernel
// runs, and its CPU time is written on stderr (for timing one at a
// time); without, all of them.
use std::env;

// A zero-sized allocator a static can hold (the compiler's Comp).
struct Heap {}

// UNSAFE: C's allocator, which Heap hands out.
// SAFETY: called with sizes checked non-negative, on blocks Heap allocated.
extern "C" {
    fn malloc(n: u64) -> *u8;
    fn realloc(p: *u8, n: u64) -> *u8;
    fn free(p: *u8);
    fn clock() -> i64;
}

impl Allocator for Heap {
    fn try_alloc(self: *Heap, size: i64, align: i64) -> *u8 {
        if align > 16 || size < 0 {
            return 0 as *u8;
        }
        // UNSAFE: C's allocator.
        // SAFETY: size is checked non-negative; the block is this allocator's.
        unsafe { malloc(if size == 0 { 1 } else { size } as u64) }
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block, of old_size bytes.
    unsafe fn try_resize(self: *Heap, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        if align > 16 || new_size < 0 {
            return 0 as *u8;
        }
        realloc(p, if new_size == 0 { 1 } else { new_size } as u64)
    }

    // UNSAFE: the trait's unsafe method (p must be Heap's block).
    // SAFETY: Vec passes its own block, once.
    unsafe fn free(self: *Heap, p: *u8, size: i64, align: i64) {
        free(p);
    }
}

struct Node { start: i64, end: i64, kind: i64, a: i64, b: i64, c: i64 }

static var NODES: Vec<Node, Heap> = Vec::new_in(Heap {});

const N: i64 = 4194304;
const ROUNDS: i64 = 15;

#[inline(never)]
fn fill(v: inout Vec<i64>, n: i64) {
    for i in 0..n {
        v.push(i & 1023);
    }
}

#[inline(never)]
fn sum_let(v: Vec<i64>, k: i64) -> i64 {
    var s = k;
    for i in 0..v.len() {
        s += v[i];
    }
    s
}

#[inline(never)]
fn sum_iter(v: Vec<i64>, k: i64) -> i64 {
    var s = k;
    for x in v.iter() {
        s += x;
    }
    s
}

#[inline(never)]
fn inc_inout(v: inout Vec<i64>) {
    for i in 0..v.len() {
        v[i] = v[i] + 1;
    }
}

#[inline(never)]
fn chase(v: Vec<i64>, steps: i64) -> i64 {
    var k = 0;
    for _ in 0..steps {
        let x = v[k];
        k = (x * 7 + k) & 65535;
    }
    k
}

#[inline(never)]
fn add_nodes(n: i64) {
    NODES.clear();
    for i in 0..n {
        NODES.push(Node { start: i, end: 0, kind: i & 3, a: (i * 7919 + 1) % n, b: 0, c: 0 });
    }
}

#[inline(never)]
fn walk(steps: i64) -> i64 {
    var k = 0;
    var s = 0;
    for _ in 0..steps {
        k = NODES[k].a;
        s += k;
    }
    s
}

#[inline(never)]
fn mark() {
    for i in 0..NODES.len() {
        NODES[i].end = NODES[i].start + NODES[i].kind;
    }
}

// The CPU time in microseconds (C's clock, CLOCKS_PER_SEC 1000000 on
// macOS and Linux).
fn now() -> i64 {
    // UNSAFE: C's clock.
    // SAFETY: no arguments; it reads the process's CPU time.
    unsafe { clock() }
}

fn run(which: i64, gpa: Gpa) {
    var v: Vec<i64> = Vec::new_in(gpa);
    if which != 1 {
        fill(&v, N);
    }
    var w: Vec<i64> = Vec::new_in(gpa);
    for i in 0..65536 {
        w.push((i * 31 + 7) & 65535);
    }
    if which >= 7 {
        add_nodes(1000000);
    }
    let t = now();
    if which == 0 || which == 1 {
        var total = 0;
        for _ in 0..ROUNDS {
            v.clear();
            fill(&v, N);
            total += v.len();
        }
        println(f"fill {total}");
    }
    if which == 0 || which == 2 {
        var s = 0;
        for r in 0..ROUNDS * 5 {
            s += sum_let(v, r);
        }
        println(f"sum {s}");
    }
    if which == 0 || which == 3 {
        var s = 0;
        for r in 0..ROUNDS * 5 {
            s += sum_iter(v, r);
        }
        println(f"iter {s}");
    }
    if which == 0 || which == 4 {
        for _ in 0..ROUNDS {
            inc_inout(&v);
        }
        println(f"inc {v[0]} {v[N - 1]}");
    }
    if which == 0 || which == 5 {
        var s = 0;
        for r in 0..ROUNDS {
            s += chase(w, 1000000 + r);
        }
        println(f"chase {s}");
    }
    if which == 0 || which == 6 {
        for _ in 0..10 {
            add_nodes(1000000);
        }
        println(f"nodes {NODES.len()}");
    }
    if which == 0 || which == 7 {
        println(f"walk {walk(10000000)}");
    }
    if which == 0 || which == 8 {
        for _ in 0..ROUNDS {
            mark();
        }
        println(f"mark {NODES[999999].end}");
    }
    if which != 0 {
        eprintln(f"kernel {which}: {(now() - t) / 1000} ms");
    }
}

fn main(gpa: Gpa) {
    var which = 0;
    for (k, a) in env::args().enumerate() {
        if k == 1 {
            which = a.parse::<i64>().unwrap_or(0);
        }
    }
    run(which, gpa);
}
