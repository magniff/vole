// (0.25.4) bench/vecloop/vec.vl on the compiler's older idiom: an IntVec (a
// raw pointer, a count and a capacity, passed by value or inout) for the
// Vec<i64>, and a raw static table with its count and capacity for the
// static Vec of nodes (docs/design/modernize-0254.md §2). The two print
// the same lines. With an argument 1-8 only that kernel
// runs, and its CPU time is written on stderr (for timing one at a
// time); without, all of them.
use std::env;

// UNSAFE: C's allocator and clock.
// SAFETY: called with sizes checked non-negative, on blocks this file allocated.
extern "C" {
    fn realloc(p: *mut u8, n: u64) -> *mut u8;
    fn clock() -> i64;
}

// The compiler's base::IntVec.
#[derive(Clone, Copy)]
struct IntVec { data: *mut i64, count: i64, cap: i64 }

// Makes room for one more element in an array of `count` elements of T
// with capacity `cap` (base::grow).
fn grow<T>(data: *mut T, count: i64, cap: &mut i64) -> *mut T {
    if count < *cap {
        return data;
    }
    let mut new_cap = *cap * 2;
    if new_cap < 64 {
        new_cap = 64;
    }
    *cap = new_cap;
    // UNSAFE: C's realloc of the table's block.
    // SAFETY: data is this table's block (or null), of count elements.
    unsafe { realloc(data as *mut u8, (new_cap * size_of(T)) as u64) as *mut T }
}

impl IntVec {
    fn push(&mut self, value: i64) {
        let n = self.count;
        if n < self.cap {
            // UNSAFE: a raw table's element.
            // SAFETY: n < cap, inside the block.
            unsafe { (*self.data.add(n as usize)) = value; }
            self.count = n + 1;
            return;
        }
        self.data = grow(self.data, n, &mut self.cap);
        // UNSAFE: a raw table's element.
        // SAFETY: grow made room for n + 1 elements.
        unsafe { (*self.data.add(n as usize)) = value; }
        self.count = n + 1;
    }
}

#[derive(Clone, Copy)]
struct Node { start: i64, end: i64, kind: i64, a: i64, b: i64, c: i64 }

static mut NODES: *mut Node = 0 as *mut Node;
static mut NODES_COUNT: i64 = 0;
static mut NODES_CAP: i64 = 0;

const N: i64 = 4194304;
const ROUNDS: i64 = 15;

#[inline(never)]
fn fill(v: &mut IntVec, n: i64) {
    for i in 0..n {
        v.push(i & 1023);
    }
}

#[inline(never)]
fn sum_let(v: IntVec, k: i64) -> i64 {
    let mut s = k;
    for i in 0..v.count {
        // UNSAFE: a raw table's element.
        // SAFETY: i < count.
        s += unsafe { (*v.data.add(i as usize)) };
    }
    s
}

#[inline(never)]
fn sum_iter(v: IntVec, k: i64) -> i64 {
    // (IntVec has no iterator: its slice)
    let mut s = k;
    // UNSAFE: a slice of a raw table.
    // SAFETY: count elements, valid for the loop.
    for x in unsafe {
        std::slice::from_raw_parts(v.data.add((0) as usize), (v.count - (0)) as usize)
    } {
        s += x;
    }
    s
}

#[inline(never)]
fn inc_inout(v: &mut IntVec) {
    for i in 0..v.count {
        // UNSAFE: a raw table's element.
        // SAFETY: i < count.
        unsafe { (*v.data.add(i as usize)) = (*v.data.add(i as usize)) + 1; }
    }
}

#[inline(never)]
fn chase(v: IntVec, steps: i64) -> i64 {
    let mut k: i64 = 0;
    for _ in 0..steps {
        // UNSAFE: a raw table's element.
        // SAFETY: k < 65536 = count.
        let x = unsafe { (*v.data.add(k as usize)) };
        k = (x * 7 + k) & 65535;
    }
    k
}

#[inline(never)]
fn add_nodes(n: i64) {
    set_nodes_count(0);
    for i in 0..n {
        set_nodes({
            let mut nodes_cap_copy = get_nodes_cap();
            let r_copy = grow(get_nodes(), get_nodes_count(), &mut nodes_cap_copy);
            set_nodes_cap(nodes_cap_copy); r_copy
        });
        // UNSAFE: a raw table's element.
        // SAFETY: grow made room for NODES_COUNT + 1.
        unsafe {
            (*get_nodes().add(get_nodes_count() as usize)) = Node {
                start: i, end: 0, kind: i & 3, a: (i * 7919 + 1) % n, b: 0, c: 0,
            };
        }
        set_nodes_count(get_nodes_count() + (1));
    }
}

#[inline(never)]
fn walk(steps: i64) -> i64 {
    let mut k: i64 = 0;
    let mut s: i64 = 0;
    for _ in 0..steps {
        // UNSAFE: a raw table's element.
        // SAFETY: every link is below NODES_COUNT.
        k = unsafe { (*get_nodes().add(k as usize)).a };
        s += k;
    }
    s
}

#[inline(never)]
fn mark() {
    for i in 0..get_nodes_count() {
        // UNSAFE: a raw table's element.
        // SAFETY: i < NODES_COUNT.
        unsafe { (*get_nodes().add(i as usize)).end = (*get_nodes().add(i as usize)).start + (
            *get_nodes().add(i as usize)).kind; }
    }
}

// The CPU time in microseconds (C's clock, CLOCKS_PER_SEC 1000000 on
// macOS and Linux).
fn now() -> i64 {
    // UNSAFE: C's clock.
    // SAFETY: no arguments; it reads the process's CPU time.
    unsafe { clock() }
}

fn run(which: i64, gpa: Gpa) {
    let mut v = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    if which != 1 {
        fill(&mut v, N);
    }
    let mut w = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    for i in 0..65536 {
        w.push((i * 31 + 7) & 65535);
    }
    if which >= 7 {
        add_nodes(1000000);
    }
    let t = now();
    if which == 0 || which == 1 {
        let mut total: i64 = 0;
        for _ in 0..ROUNDS {
            v.count = 0;
            fill(&mut v, N);
            total += v.count;
        }
        println("fill {total}");
    }
    if which == 0 || which == 2 {
        let mut s: i64 = 0;
        for r in 0..ROUNDS * 5 {
            s += sum_let(v, r);
        }
        println("sum {s}");
    }
    if which == 0 || which == 3 {
        let mut s: i64 = 0;
        for r in 0..ROUNDS * 5 {
            s += sum_iter(v, r);
        }
        println("iter {s}");
    }
    if which == 0 || which == 4 {
        for _ in 0..ROUNDS {
            inc_inout(&mut v);
        }
        // UNSAFE: a raw table's elements.
        // SAFETY: count is N.
        let (first, last) = unsafe { ((*v.data.add(0)), (*v.data.add((N - 1) as usize))) };
        println("inc {first} {last}");
    }
    if which == 0 || which == 5 {
        let mut s: i64 = 0;
        for r in 0..ROUNDS {
            s += chase(w, 1000000 + r);
        }
        println("chase {s}");
    }
    if which == 0 || which == 6 {
        for _ in 0..10 {
            add_nodes(1000000);
        }
        let nodes_count_now = get_nodes_count(); println("nodes {nodes_count_now}");
    }
    if which == 0 || which == 7 {
        println("walk {}", walk(10000000));
    }
    if which == 0 || which == 8 {
        for _ in 0..ROUNDS {
            mark();
        }
        // UNSAFE: a raw table's element.
        // SAFETY: NODES_COUNT is 1000000.
        println("mark {}", unsafe { (*get_nodes().add(999999)).end });
    }
    if which != 0 {
        eprintln("kernel {which}: {} ms", (now() - t) / 1000);
    }
}

fn main(gpa: Gpa) {
    let mut which: i64 = 0;
    for (k, a) in env::args().enumerate() {
        if k == 1 {
            which = a.parse::<i64>().unwrap_or(0);
        }
    }
    run(which, gpa);
}

// (0.28.0) NODES's accessors: every use of it is one of them.
fn get_nodes() -> *mut Node {
    unsafe { NODES }
}

fn set_nodes(v: *mut Node) {
    unsafe {
        NODES = v;
    }
}

// (0.28.0) NODES_COUNT's accessors: every use of it is one of them.
fn get_nodes_count() -> i64 {
    unsafe { NODES_COUNT }
}

fn set_nodes_count(v: i64) {
    unsafe {
        NODES_COUNT = v;
    }
}

// (0.28.0) NODES_CAP's accessors: every use of it is one of them.
fn get_nodes_cap() -> i64 {
    unsafe { NODES_CAP }
}

fn set_nodes_cap(v: i64) {
    unsafe {
        NODES_CAP = v;
    }
}
