// (0.25.4) bench/vecloop/vec.vl on the compiler's older idiom: an IntVec (a
// raw pointer, a count and a capacity, passed by value or inout) for the
// Vec<i64>, and a raw static table with its count and capacity for the
// static Vec of nodes (docs/design/modernize-0254.md §2). The two print
// the same lines. With an argument 1-8 only that kernel
// runs, and its CPU time is written on stderr (for timing one at a
// time); without, all of them.
use std::env;

// UNSAFE: C's allocator and clock.
// SAFETY: called with sizes checked non-negative, on blocks this file allocated.
extern "C" {
    fn realloc(p: *u8, n: u64) -> *u8;
    fn clock() -> i64;
}

// The compiler's base::IntVec.
struct IntVec { data: *i64, count: i64, cap: i64 }

// Makes room for one more element in an array of `count` elements of T
// with capacity `cap` (base::grow).
fn grow<T>(data: *T, count: i64, cap: inout i64) -> *T {
    if count < cap {
        return data;
    }
    var new_cap = cap * 2;
    if new_cap < 64 {
        new_cap = 64;
    }
    cap = new_cap;
    // UNSAFE: C's realloc of the table's block.
    // SAFETY: data is this table's block (or null), of count elements.
    unsafe { realloc(data as *u8, (new_cap * size_of(T)) as u64) as *T }
}

impl IntVec {
    fn push(inout self, value: i64) {
        let n = self.count;
        if n < self.cap {
            // UNSAFE: a raw table's element.
            // SAFETY: n < cap, inside the block.
            unsafe { self.data[n] = value; }
            self.count = n + 1;
            return;
        }
        self.data = grow(self.data, n, &self.cap);
        // UNSAFE: a raw table's element.
        // SAFETY: grow made room for n + 1 elements.
        unsafe { self.data[n] = value; }
        self.count = n + 1;
    }
}

struct Node { start: i64, end: i64, kind: i64, a: i64, b: i64, c: i64 }

static var NODES: *Node = 0 as *Node;
static var NODES_COUNT: i64 = 0;
static var NODES_CAP: i64 = 0;

const N: i64 = 4194304;
const ROUNDS: i64 = 15;

#[inline(never)]
fn fill(v: inout IntVec, n: i64) {
    for i in 0..n {
        v.push(i & 1023);
    }
}

#[inline(never)]
fn sum_let(v: IntVec, k: i64) -> i64 {
    var s = k;
    for i in 0..v.count {
        // UNSAFE: a raw table's element.
        // SAFETY: i < count.
        s += unsafe { v.data[i] };
    }
    s
}

#[inline(never)]
fn sum_iter(v: IntVec, k: i64) -> i64 {
    // (IntVec has no iterator: its slice)
    var s = k;
    // UNSAFE: a slice of a raw table.
    // SAFETY: count elements, valid for the loop.
    for x in unsafe { v.data[0..v.count] } {
        s += x;
    }
    s
}

#[inline(never)]
fn inc_inout(v: inout IntVec) {
    for i in 0..v.count {
        // UNSAFE: a raw table's element.
        // SAFETY: i < count.
        unsafe { v.data[i] = v.data[i] + 1; }
    }
}

#[inline(never)]
fn chase(v: IntVec, steps: i64) -> i64 {
    var k = 0;
    for _ in 0..steps {
        // UNSAFE: a raw table's element.
        // SAFETY: k < 65536 = count.
        let x = unsafe { v.data[k] };
        k = (x * 7 + k) & 65535;
    }
    k
}

#[inline(never)]
fn add_nodes(n: i64) {
    NODES_COUNT = 0;
    for i in 0..n {
        NODES = grow(NODES, NODES_COUNT, &NODES_CAP);
        // UNSAFE: a raw table's element.
        // SAFETY: grow made room for NODES_COUNT + 1.
        unsafe {
            NODES[NODES_COUNT] = Node {
                start: i, end: 0, kind: i & 3, a: (i * 7919 + 1) % n, b: 0, c: 0,
            };
        }
        NODES_COUNT += 1;
    }
}

#[inline(never)]
fn walk(steps: i64) -> i64 {
    var k = 0;
    var s = 0;
    for _ in 0..steps {
        // UNSAFE: a raw table's element.
        // SAFETY: every link is below NODES_COUNT.
        k = unsafe { NODES[k].a };
        s += k;
    }
    s
}

#[inline(never)]
fn mark() {
    for i in 0..NODES_COUNT {
        // UNSAFE: a raw table's element.
        // SAFETY: i < NODES_COUNT.
        unsafe { NODES[i].end = NODES[i].start + NODES[i].kind; }
    }
}

// The CPU time in microseconds (C's clock, CLOCKS_PER_SEC 1000000 on
// macOS and Linux).
fn now() -> i64 {
    // UNSAFE: C's clock.
    // SAFETY: no arguments; it reads the process's CPU time.
    unsafe { clock() }
}

fn run(which: i64, gpa: Gpa) {
    var v = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    if which != 1 {
        fill(&v, N);
    }
    var w = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for i in 0..65536 {
        w.push((i * 31 + 7) & 65535);
    }
    if which >= 7 {
        add_nodes(1000000);
    }
    let t = now();
    if which == 0 || which == 1 {
        var total = 0;
        for _ in 0..ROUNDS {
            v.count = 0;
            fill(&v, N);
            total += v.count;
        }
        println(f"fill {total}");
    }
    if which == 0 || which == 2 {
        var s = 0;
        for r in 0..ROUNDS * 5 {
            s += sum_let(v, r);
        }
        println(f"sum {s}");
    }
    if which == 0 || which == 3 {
        var s = 0;
        for r in 0..ROUNDS * 5 {
            s += sum_iter(v, r);
        }
        println(f"iter {s}");
    }
    if which == 0 || which == 4 {
        for _ in 0..ROUNDS {
            inc_inout(&v);
        }
        // UNSAFE: a raw table's elements.
        // SAFETY: count is N.
        println(f"inc {unsafe { v.data[0] }} {unsafe { v.data[N - 1] }}");
    }
    if which == 0 || which == 5 {
        var s = 0;
        for r in 0..ROUNDS {
            s += chase(w, 1000000 + r);
        }
        println(f"chase {s}");
    }
    if which == 0 || which == 6 {
        for _ in 0..10 {
            add_nodes(1000000);
        }
        println(f"nodes {NODES_COUNT}");
    }
    if which == 0 || which == 7 {
        println(f"walk {walk(10000000)}");
    }
    if which == 0 || which == 8 {
        for _ in 0..ROUNDS {
            mark();
        }
        // UNSAFE: a raw table's element.
        // SAFETY: NODES_COUNT is 1000000.
        println(f"mark {unsafe { NODES[999999].end }}");
    }
    if which != 0 {
        eprintln(f"kernel {which}: {(now() - t) / 1000} ms");
    }
}

fn main(gpa: Gpa) {
    var which = 0;
    for (k, a) in env::args().enumerate() {
        if k == 1 {
            which = a.parse::<i64>().unwrap_or(0);
        }
    }
    run(which, gpa);
}
