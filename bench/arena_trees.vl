// EDITION: rust
// arena_trees (0.16): bench/binarytrees.vl with its nodes in std's
// arenas: a tree per iteration bumps through an arena that is reset after
// it, the long-lived tree has an arena of its own. The allocations go
// through the Allocator trait (`a.alloc(16, 8)`, generic code), and the
// arena's bump path inlines without a call (its refill is cold and out of
// line), so this runs faster than binarytrees (malloc and free per node).
use std::alloc::{Allocator, Arena, Layout};

extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy)]
struct Node { left: *mut Node, right: *mut Node }

fn make<A: Allocator>(a: &mut A, depth: i64) -> *mut Node {
    let n = a
        .allocate(Layout::from_size_align(16 as usize, 8 as usize).unwrap())
        .unwrap()
        .as_ptr() as *mut Node;
    unsafe {
        if depth > 0 {
            (*n).left = make(a, depth - 1);
            (*n).right = make(a, depth - 1);
        } else {
            (*n).left = 0 as *mut Node;
            (*n).right = 0 as *mut Node;
        }
    }
    n
}

unsafe fn check(n: *mut Node) -> i64 {
    if (*n).left == 0 as *mut Node {
        return 1;
    }
    1 + check((*n).left) + check((*n).right)
}

fn main(gpa: Gpa) -> i32 {
    let min_depth: i64 = 4;
    let max_depth: i64 = 16;
    let stretch = max_depth + 1;
    let mut a = Arena::new_in(gpa);
    let mut long_arena = Arena::new_in(gpa);
    unsafe {
        let t = make(&mut a, stretch);
        printf(c"stretch tree of depth %ld\t check: %ld\n", stretch, check(t));
        a.reset();
    }
    let long_lived = make(&mut long_arena, max_depth);
    let mut depth = min_depth;
    while depth <= max_depth {
        let iterations = 1 << (max_depth - depth + min_depth);
        let mut sum: i64 = 0;
        for _ in 0..iterations {
            unsafe {
                let t = make(&mut a, depth);
                sum += check(t);
                a.reset();
            }
        }
        unsafe { printf(c"%ld\t trees of depth %ld\t check: %ld\n", iterations, depth, sum); }
        depth += 2;
    }
    unsafe {
        printf(c"long lived tree of depth %ld\t check: %ld\n", max_depth, check(long_lived));
        drop(a);
        drop(long_arena);
    }
    0
}
