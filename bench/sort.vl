// EDITION: rust
// Sorting: std::sort (an introsort) of 1,000,000 pseudo-random integers,
// then of 200,000 records by key; the results checked and summed.
use std::cmp::Ordering;

extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

#[derive(Clone, Copy, PartialEq, Eq)]
struct Rec { key: i64, id: i64 }

impl Ord for Rec {
    fn cmp(&self, other: &Rec) -> Ordering {
        self.key.cmp(&other.key).then(self.id.cmp(&other.id))
    }
}

impl PartialOrd for Rec {
    fn partial_cmp(&self, other: &Rec) -> Option<Ordering> { Some(self.cmp(other)) }
}

fn next(state: &mut u64) -> u64 {
    *state = *state * 6364136223846793005u64 + 1442695040888963407u64;
    *state >> 17
}

fn main(gpa: Gpa) -> i32 {
    let mut state = 42u64;
    let n: i64 = 1000000;
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);
    for _ in 0..n {
        v.push(next(&mut state) as i64);
    }
    let s = v.as_mut_slice();
    s.sort_unstable();
    let mut sum = 0u64;
    let mut sorted = true;
    for i in 0..n {
        sum = sum * 31u64 + s[i as usize] as u64;
        if i > 0 && s[(i - 1) as usize] > s[i as usize] {
            sorted = false;
        }
    }
    unsafe { printf(c"%d %lu\n", sorted as i32, sum); }

    let m: i64 = 200000;
    let mut r: Vec<Rec, Gpa> = Vec::with_capacity_in(m as usize, gpa);
    for i in 0..m {
        r.push(Rec { key: (next(&mut state) % 1000u64) as i64, id: i });
    }
    let t = r.as_mut_slice();
    t.sort_unstable();
    let mut sum2 = 0u64;
    for i in 0..m {
        sum2 = sum2 * 31u64 + (t[i as usize].key * 1000003 + t[i as usize].id) as u64;
    }
    unsafe { printf(c"%lu\n", sum2); }
    drop(v);
    drop(r);
    0
}
