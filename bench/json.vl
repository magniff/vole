// EDITION: rust
// A JSON-ish parser: about 24 MB of generated text (nested arrays and
// objects of numbers, strings with escapes and literals) parsed by
// recursive descent, byte by byte; branchy code. Prints what it counted.
use std::alloc::Allocator;

extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

struct Gen<A: Allocator> { out: Vec<u8, A>, state: u64 }

impl Gen<Gpa> {
    fn next(&mut self) -> u64 {
        self.state = self.state * 6364136223846793005u64 + 1442695040888963407u64;
        self.state >> 33
    }

    fn push(&mut self, c: u8) {
        self.out.push(c);
    }

    fn number(&mut self) {
        let mut v = (self.next() % 200000u64) as i64 - 100000;
        if v < 0 {
            self.push(b'-');
            v = -v;
        }
        let mut digits: [u8; 20] = [0; 20];
        let mut n: i64 = 0;
        loop {
            digits[n as usize] = b'0' + (v % 10) as u8;
            n += 1;
            v = v / 10;
            if v == 0 {
                break;
            }
        }
        while n > 0 {
            n -= 1;
            self.push(digits[n as usize]);
        }
    }

    fn string(&mut self) {
        self.push(b'"');
        let len = self.next() % 12u64;
        for _ in 0..len {
            let r = self.next() % 32u64;
            if r == 0u64 {
                self.push(b'\\');
                self.push(b'"');
            } else if r == 1u64 {
                self.push(b'\\');
                self.push(b'n');
            } else {
                self.push(b'a' + (r % 26u64) as u8);
            }
        }
        self.push(b'"');
    }

    fn literal(&mut self, w: &[u8]) {
        for &c in w {
            self.push(c);
        }
    }

    fn value(&mut self, depth: i64) {
        let r = if depth >= 6 { self.next() % 6u64 } else { self.next() % 10u64 };
        if r <= 1u64 || r == 5u64 {
            self.number();
        } else if r <= 3u64 {
            self.string();
        } else if r == 4u64 {
            let k = self.next() % 3u64;
            if k == 0u64 {
                self.literal(b"true");
            } else if k == 1u64 {
                self.literal(b"false");
            } else {
                self.literal(b"null");
            }
        } else if r <= 7u64 {
            self.push(b'[');
            let n = self.next() % 6u64;
            for i in 0..n {
                if i > 0u64 {
                    self.push(b',');
                    self.push(b' ');
                }
                self.value(depth + 1);
            }
            self.push(b']');
        } else {
            self.push(b'{');
            let n = self.next() % 6u64;
            for i in 0..n {
                if i > 0u64 {
                    self.push(b',');
                    self.push(b' ');
                }
                self.string();
                self.push(b':');
                self.push(b' ');
                self.value(depth + 1);
            }
            self.push(b'}');
        }
    }
}

#[derive(Clone, Copy)]
struct Parser<'a> {
    s: &'a [u8], pos: i64,
    values: i64, numbers: i64, sum: i64, strings: i64, chars: i64,
    literals: i64, arrays: i64, objects: i64, max_depth: i64,
}

impl<'a> Parser<'a> {
    fn peek(self) -> u8 {
        if self.pos < self.s.len() as i64 { self.s[self.pos as usize] } else { 0 }
    }

    fn skip_space(&mut self) {
        while self.pos < self.s.len() as i64 {
            let c = self.s[self.pos as usize];
            if c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' {
                self.pos += 1;
            } else {
                break;
            }
        }
    }

    fn string(&mut self) -> bool {
        self.pos += 1;
        loop {
            if self.pos >= self.s.len() as i64 {
                return false;
            }
            let c = self.s[self.pos as usize];
            self.pos += 1;
            if c == b'"' {
                self.strings += 1;
                return true;
            }
            if c == b'\\' {
                if self.pos >= self.s.len() as i64 {
                    return false;
                }
                self.pos += 1;
            }
            self.chars += 1;
        }
    }

    fn number(&mut self) -> bool {
        let mut negative = false;
        if self.peek() == b'-' {
            negative = true;
            self.pos += 1;
        }
        let start = self.pos;
        let mut v: i64 = 0;
        while self.pos < self.s.len() as i64 {
            let c = self.s[self.pos as usize];
            if c < b'0' || c > b'9' {
                break;
            }
            v = v * 10 + (c - b'0') as i64;
            self.pos += 1;
        }
        if self.pos == start {
            return false;
        }
        self.numbers += 1;
        self.sum += if negative { -v } else { v };
        true
    }

    fn literal(&mut self, w: &[u8]) -> bool {
        for &c in w {
            if self.peek() != c {
                return false;
            }
            self.pos += 1;
        }
        self.literals += 1;
        true
    }

    fn value(&mut self, depth: i64) -> bool {
        if depth > self.max_depth {
            self.max_depth = depth;
        }
        self.skip_space();
        let c = self.peek();
        if c == b'[' {
            self.arrays += 1;
            self.pos += 1;
            self.skip_space();
            if self.peek() == b']' {
                self.pos += 1;
                return true;
            }
            loop {
                if !self.value(depth + 1) {
                    return false;
                }
                self.skip_space();
                let d = self.peek();
                self.pos += 1;
                if d == b']' {
                    return true;
                }
                if d != b',' {
                    return false;
                }
            }
        }
        if c == b'{' {
            self.objects += 1;
            self.pos += 1;
            self.skip_space();
            if self.peek() == b'}' {
                self.pos += 1;
                return true;
            }
            loop {
                self.skip_space();
                if self.peek() != b'"' || !self.string() {
                    return false;
                }
                self.skip_space();
                if self.peek() != b':' {
                    return false;
                }
                self.pos += 1;
                if !self.value(depth + 1) {
                    return false;
                }
                self.skip_space();
                let d = self.peek();
                self.pos += 1;
                if d == b'}' {
                    return true;
                }
                if d != b',' {
                    return false;
                }
            }
        }
        if c == b'"' {
            return self.string();
        }
        if c == b'-' || (c >= b'0' && c <= b'9') {
            return self.number();
        }
        if c == b't' {
            return self.literal(b"true");
        }
        if c == b'f' {
            return self.literal(b"false");
        }
        if c == b'n' {
            return self.literal(b"null");
        }
        false
    }
}

fn main(gpa: Gpa) -> i32 {
    let mut g = Gen { out: Vec::new_in(gpa), state: 12345u64 };
    while g.out.len() < 24000000 {
        g.value(0);
        g.push(b'\n');
    }
    let mut p = Parser {
        s: g.out.as_slice(), pos: 0,
        values: 0, numbers: 0, sum: 0, strings: 0, chars: 0,
        literals: 0, arrays: 0, objects: 0, max_depth: 0,
    };
    loop {
        p.skip_space();
        if p.pos >= p.s.len() as i64 {
            break;
        }
        if !p.value(1) {
            unsafe { printf(c"error at %ld\n", p.pos); }
            return 1;
        }
        p.values += 1;
    }
    unsafe {
        printf(c"%ld bytes, %ld values\n", p.s.len(), p.values);
        printf(c"%ld numbers (sum %ld), %ld strings (%ld chars), %ld literals\n",
            p.numbers, p.sum, p.strings, p.chars, p.literals);
        printf(c"%ld arrays, %ld objects, depth %ld\n", p.arrays, p.objects, p.max_depth);
    }
    drop(g.out);
    0
}
