// Priority queues: std's BinaryHeap (a max-heap) fed 1,000,000 pseudo-random
// integers and emptied; then a MinHeap of (distance, node) pairs as
// Dijkstra uses it, 2,000,000 rounds of a pop and one or two pushes. The
// popped values are checked (in order) and summed.
use std::collections::{BinaryHeap, MinHeap};

// UNSAFE: printf is C's (the same output calls as heap.c).
// SAFETY: every call below gives a C string literal and arguments of the
// types its conversions name.
extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

fn next(state: &mut u64) -> u64 {
    *state = state.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
    *state >> 17
}

fn main(gpa: Gpa) -> i32 {
    let mut state = 42u64;
    let n = 1000000;
    let mut h: BinaryHeap<i64, Gpa> = BinaryHeap::with_capacity_in(n as usize, gpa);
    for _ in 0..n {
        h.push(next(&mut state) as i64);
    }
    let mut sum = 0u64;
    let mut ordered = true;
    let mut last = i64::MAX;
    while let Some(x) = h.pop() {
        sum = sum.wrapping_mul(31u64).wrapping_add(x as u64);
        if x > last {
            ordered = false;
        }
        last = x;
    }
    // UNSAFE: C's printf.
    // SAFETY: %d takes the i32, %lu the u64.
    unsafe { printf(c"%d %lu\n", ordered as i32, sum); }

    let mut q: MinHeap<(i64, i64), Gpa> = MinHeap::new_in(gpa);
    for i in 0..1000 {
        q.push(((next(&mut state) % 1000u64) as i64, i));
    }
    let mut sum2 = 0u64;
    let mut ordered2 = true;
    let mut prev = 0;
    for r in 0..2000000 {
        let (d, u) = q.pop().unwrap();
        if d < prev {
            ordered2 = false;
        }
        prev = d;
        sum2 = sum2.wrapping_mul(31u64).wrapping_add((d + u) as u64);
        q.push((d + (next(&mut state) % 1000u64) as i64, (u * 7 + r) % 100000));
        if r % 2 == 0 && q.len() < 200000 {
            q.push((d + (next(&mut state) % 5000u64) as i64, r % 100000));
        }
    }
    // UNSAFE: C's printf.
    // SAFETY: %d takes the i32, %lu the u64, %ld the length as an i64.
    unsafe { printf(c"%d %lu %ld\n", ordered2 as i32, sum2, q.len() as i64); }
    0
}
