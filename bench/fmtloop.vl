// EDITION: rust
// Formatting (0.15): 10^6 lines made with f-strings into a Buf, numbers in
// decimal and hex, padded; bench/fmtints.vl makes the same text with
// Buf's push_int and push_str, as before f-strings, and bench/run.sh
// prints the ratio of the two times (zero cost: at most 1). The text is
// written out in pieces of about 60 KB: the total length and the last
// piece are printed.

fn main(gpa: Gpa) {
    let mut x: u64 = 88172645463325252;
    let mut b = String::new_in(gpa);
    let mut total: i64 = 0;
    for i in 0..1000000 {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
        let k = (x % 2000) as i64 - 1000;
        let h = (x >> 40) as u32;
        std::fmt::write(&mut b, "{i} {k} {h:x} {:>3}|\n", i * 3 % 7).unwrap();
        if b.len() > 60000 {
            total += b.len() as i64;
            b.clear();
        }
    }
    total += b.len() as i64;
    print("{}", str::from_utf8(b.as_bytes()).unwrap());
    println("{total} bytes");
}
