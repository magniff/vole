// The kernels of bench/iterchain.vl as hand-written loops: the same
// results, the time an iterator chain should match (bench/run.sh prints
// the ratio).

extern "C" {
    fn printf(format: *const u8, ...) -> i32;
}

#[inline(never)]
fn filter_map_sum(v: &Vec<i64, Gpa>, r: i64) -> i64 {
    let s = v.as_slice();
    let mut t: i64 = 0;
    for &x in s {
        if x & 1 == 0 {
            t += x * x + r;
        }
    }
    t
}

#[inline(never)]
fn dot(v: &Vec<i64, Gpa>, w: &Vec<i64, Gpa>, r: i64) -> i64 {
    let a = v.as_slice();
    let b = w.as_slice();
    let n = if a.len() < b.len() { a.len() } else { b.len() };
    let mut t: i64 = 0;
    for k in 0..n {
        t += a[k] * b[k] + r;
    }
    t
}

#[inline(never)]
fn enumerate_sum(v: &Vec<i64, Gpa>, r: i64) -> i64 {
    let s = v.as_slice();
    let mut t: i64 = 0;
    for k in 0..s.len() {
        t += k as i64 * s[k] + r;
    }
    t
}

#[inline(never)]
fn max_count(v: &Vec<i64, Gpa>, r: i64) -> i64 {
    let s = v.as_slice();
    let mut m = s[0] ^ r;
    for k in 1..s.len() {
        let x = s[k] ^ r;
        if x > m {
            m = x;
        }
    }
    let mut c: i64 = 0;
    for &x in s {
        if x > r {
            c += 1;
        }
    }
    m + c
}

#[inline(never)]
fn take_loop(v: &Vec<i64, Gpa>, n: i64) -> i64 {
    let s = v.as_slice();
    let m = if n < s.len() as i64 { n } else { s.len() as i64 };
    let mut t: i64 = 0;
    for k in 0..m {
        t += s[k as usize];
    }
    t
}

// std's heapsort, largest first.
fn sift_down(s: &mut [i64], start: i64, end: i64) {
    let mut root = start;
    loop {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end && s[(child + 1) as usize] < s[child as usize] {
            child += 1;
        }
        if s[child as usize] >= s[root as usize] {
            return;
        }
        let t = s[root as usize];
        s[root as usize] = s[child as usize];
        s[child as usize] = t;
        root = child;
    }
}

// (a library function, as std's sort is: not inlined into its caller)
#[inline(never)]
fn sort_desc(s: &mut [i64]) {
    let n = s.len();
    let mut start = n / 2;
    while start > 0 {
        start -= 1;
        sift_down(s, start as i64, n as i64);
    }
    let mut end = n;
    while end > 1 {
        end -= 1;
        let top = s[0];
        s[0] = s[end];
        s[end] = top;
        sift_down(s, 0, end as i64);
    }
}

#[inline(never)]
fn collect_sort(v: &Vec<i64, Gpa>, m: i64, r: i64, gpa: Gpa) -> i64 {
    let s = v.as_slice();
    let mut u: Vec<i64, Gpa> = Vec::new_in(gpa);
    for k in 0..m {
        u.push(s[k as usize] ^ r);
    }
    sort_desc(u.as_mut_slice());
    u[0usize] - u[m as usize - 1] + u[m as usize / 2]
}

fn main(gpa: Gpa) -> i32 {
    let n: i64 = 1048576;
    let reps: i64 = 200;
    let mut v: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);
    let mut w: Vec<i64, Gpa> = Vec::with_capacity_in(n as usize, gpa);
    for i in 0..n {
        v.push(i * 2654435761 % 1000003 % 1001 - 500);
        w.push(i % 17 - 8);
    }
    let mut c1: i64 = 0;
    let mut c2: i64 = 0;
    let mut c3: i64 = 0;
    let mut c4: i64 = 0;
    let mut c5: i64 = 0;
    for r in 0..reps {
        c1 += filter_map_sum(&v, r);
        c2 += dot(&v, &w, r);
        c3 += enumerate_sum(&v, r);
        c4 += max_count(&v, r * 4999);
        c5 += take_loop(&v, n - r);
    }
    let mut c6: i64 = 0;
    for r in 0..10 {
        c6 += collect_sort(&v, 65536, r, gpa);
    }
    unsafe { printf(c"%ld %ld %ld %ld %ld %ld\n", c1, c2, c3, c4, c5, c6); }
    0
}
