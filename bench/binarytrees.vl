// EDITION: rust
// binary-trees of the benchmarks game: allocation-heavy, many small nodes
// from malloc, walked and freed; maximum depth 16.
extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
    fn malloc(size: u64) -> *mut u8;
    fn free(p: *mut u8);
}

#[derive(Clone, Copy)]
struct Node { left: *mut Node, right: *mut Node }

fn make(depth: i64) -> *mut Node {
    let n = unsafe { malloc(16) as *mut Node };
    if depth > 0 {
        let l = make(depth - 1);
        let r = make(depth - 1);
        unsafe {
            (*n).left = l;
            (*n).right = r;
        }
    } else {
        unsafe {
            (*n).left = 0 as *mut Node;
            (*n).right = 0 as *mut Node;
        }
    }
    n
}

unsafe fn check(n: *mut Node) -> i64 {
    if (*n).left == 0 as *mut Node {
        return 1;
    }
    1 + check((*n).left) + check((*n).right)
}

unsafe fn release(n: *mut Node) {
    if (*n).left != 0 as *mut Node {
        release((*n).left);
        release((*n).right);
    }
    free(n as *mut u8);
}

fn main() -> i32 {
    let min_depth: i64 = 4;
    let max_depth: i64 = 16;
    let stretch = max_depth + 1;
    unsafe {
        let t = make(stretch);
        printf(c"stretch tree of depth %ld\t check: %ld\n", stretch, check(t));
        release(t);
    }
    let long_lived = make(max_depth);
    let mut depth = min_depth;
    while depth <= max_depth {
        let iterations = 1 << (max_depth - depth + min_depth);
        let mut sum: i64 = 0;
        for _ in 0..iterations {
            unsafe {
                let t = make(depth);
                sum += check(t);
                release(t);
            }
        }
        unsafe { printf(c"%ld\t trees of depth %ld\t check: %ld\n", iterations, depth, sum); }
        depth += 2;
    }
    unsafe {
        printf(c"long lived tree of depth %ld\t check: %ld\n", max_depth, check(long_lived));
        release(long_lived);
    }
    0
}
