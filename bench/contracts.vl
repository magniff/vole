// contracts (0.18.1): do checked contracts make the code faster? Four
// kernels over Vec<i64> whose clauses give the range analysis facts:
// bench/contracts_plain.vl is the same program without the clauses
// (docs/optimizer.md, "Contracts and generated code: the evidence").
// With an argument K (1-4) only kernel K runs; with none, all four.
//
// 1 prefix: `requires n <= v.len()` on a summing loop to n;
// 2 window: a helper reading v[i..i + 4] called in a hot loop, whose
//   requires states the window is inside v;
// 3 bucket: a hash helper whose ensures bounds its result by n, the
//   length of the table the caller indexes;
// 4 dot: a dot product whose requires says both vectors are as long.

use std::cli::{Arg, Command};

fn sum_prefix(v: &Vec<i64, Gpa>, n: i64) -> i64
    requires 0 <= n && n <= v.len() as i64
{
    let mut s: i64 = 0;
    for i in 0..n {
        s += v[i as usize];
    }
    s
}

fn weigh(v: &Vec<i64, Gpa>, i: i64) -> i64
    requires 0 <= i && i + 4 <= v.len() as i64
{
    v[i as usize] + 2 * v[(i + 1) as usize] + 3 * v[(i + 2) as usize] + 4 * v[(i + 3) as usize]
}

fn bucket(x: u64, n: i64) -> i64
    requires n > 0
    ensures 0 <= result && result < n
{
    let mut h = x ^ (x >> 31);
    h = h.wrapping_mul(0x7fb5d329728ea185);
    h = h ^ (h >> 27);
    (h % (n as u64)) as i64
}

fn dot(a: &Vec<i64, Gpa>, b: &Vec<i64, Gpa>) -> i64
    requires a.len() == b.len()
{
    let mut s: i64 = 0;
    for i in 0..a.len() {
        s += a[i] * b[i];
    }
    s
}

fn prefix(v: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for r in 0..40000 {
        t += sum_prefix(v, v.len() as i64 - (r & 63));
    }
    t
}

fn window(v: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for _ in 0..20000 {
        for i in 0..v.len() - 3 {
            t += weigh(v, i as i64);
        }
    }
    t
}

fn buckets(gpa: Gpa) -> i64 {
    let mut counts: Vec<i64, Gpa> = Vec::new_in(gpa);
    for _ in 0..1021 {
        counts.push(0);
    }
    let mut x: u64 = 1;
    for _ in 0..60000000 {
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let b = bucket(x, counts.len() as i64);
        counts[b as usize] += 1;
    }
    let mut t: i64 = 0;
    for i in 0..counts.len() {
        t = t.wrapping_mul(31).wrapping_add(counts[i]);
    }
    t
}

fn dots(v: &Vec<i64, Gpa>, w: &Vec<i64, Gpa>) -> i64 {
    let mut t: i64 = 0;
    for r in 0..40000 {
        t = t.wrapping_add(dot(v, w) ^ r);
    }
    t
}

fn main(gpa: Gpa) -> i32 {
    let cmd = Command::new_in("contracts", gpa)
        .arg(Arg::positional("kernel").default("0").help("1-4: only that kernel (0: all four)"));
    let m = cmd.parse_or_exit(std::env::args());
    let k = match m.get_as::<i64>("kernel") {
        Ok(k) => k,
        Err(e) => cmd.exit(e),
    };
    let mut v: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut w: Vec<i64, Gpa> = Vec::new_in(gpa);
    let mut x: u64 = 7;
    for _ in 0..4096 {
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        v.push((x >> 40) as i64);
        w.push((x >> 50) as i64);
    }
    if k == 0 || k == 1 {
        println("prefix {}", prefix(&v));
    }
    if k == 0 || k == 2 {
        println("window {}", window(&v));
    }
    if k == 0 || k == 3 {
        println("bucket {}", buckets(gpa));
    }
    if k == 0 || k == 4 {
        println("dot {}", dots(&v, &w));
    }
    0
}
