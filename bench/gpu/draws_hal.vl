// EDITION: rust
// bench/gpu: draws.vl's encoding through std::gpu::hal::metal directly,
// below the public API: no contracts, no pass state. The difference from
// draws.vl is what the API's checks cost (docs/design/gpu.md §5: under
// 3%); bench/gpu/run.sh runs it with the others.

use std::gpu;
use std::gpu::{
    BindingType, BufferUsage, Format, Reflection, ShaderSource, TextureUsage, VertexFormat,
    VertexLayout,
};
use std::gpu::hal::{Api, Render};
use std::gpu::hal::metal::Metal;
use std::gpu::types::Load;
use std::time::Instant;

const DRAWS: i64 = 10000;
const GROUPS: i64 = 16;
const ITERS: i64 = 60;

const MSL: [&str; 10] = [
    "#include <metal_stdlib>",
    "using namespace metal;",
    "struct Globals { float2 size; };",
    "struct VIn { float2 pos [[attribute(0)]]; float4 color [[attribute(1)]]; };",
    "struct VOut { float4 pos [[position]]; float4 color; };",
    "vertex VOut vs_main(VIn in [[stage_in]], constant Globals& g [[buffer(0)]]) {",
    "    VOut o; float2 n = in.pos / g.size * 2.0 - 1.0;",
    "    o.pos = float4(n.x, -n.y, 0.5, 1.0); o.color = in.color; return o;",
    "}",
    "fragment float4 fs_main(VOut in [[stage_in]]) { return in.color; }",
];

fn main(gpa: Gpa) -> i32 {
    let inst = gpu::Instance::new_in(gpa);
    let adapter = inst.adapter(gpu::Power::High).unwrap();
    let (dev, mut queue) = adapter.device(gpu::Limits::default()).unwrap();
    let mut text = String::new_in(gpa);
    for l in MSL {
        text.push_str(l);
        text.push('\n');
    }
    let mut refl = Reflection::new_in(gpa);
    refl.vertex("vs", "vs_main");
    refl.fragment("fs", "fs_main");
    refl.bind(0, 0, BindingType::Uniform, gpu::StageSlots::vertex(0));
    refl.input(0, VertexFormat::Float32x2);
    refl.input(1, VertexFormat::Unorm8x4);
    let src = ShaderSource::msl(text.as_str(), refl);
    let shader = dev.shader(&src).unwrap();
    let mut desc = gpu::RenderDesc::new(&shader, "vs", "fs", Format::Rgba8Unorm);
    let mut layout = VertexLayout::new(12, gpu::StepMode::Vertex);
    layout.attribute(0, VertexFormat::Float32x2, 0);
    layout.attribute(1, VertexFormat::Unorm8x4, 8);
    desc.vertex_buffer(layout);
    let pipe = dev.render_pipeline(desc).unwrap();
    let tex = dev.texture(64, 64, Format::Rgba8Unorm, TextureUsage::RENDER_ATTACHMENT);
    let view = tex.view();
    let verts = dev.buffer(6 * 12, BufferUsage::VERTEX);
    // a Globals (the target's size) every 256 bytes, one a group
    let mut sizes = [0.0f32; 1024];
    for k in 0..GROUPS as usize {
        sizes[k * 64] = 64.0;
        sizes[k * 64 + 1] = 64.0;
    }
    let uni = dev.buffer_init(gpu::bytes_of_f32(&sizes[..]), BufferUsage::UNIFORM);
    let mut groups: Vec<gpu::BindGroup, Gpa> = Vec::new_in(gpa);
    for k in 0..GROUPS {
        groups.push(dev.bind_group(pipe.bind_layout(0),
            &[gpu::bind_range(0, &uni, k * 256, 16)][..]));
    }
    let mut times: Vec<f64, Gpa> = Vec::new_in(gpa);
    for _ in 0..ITERS {
        let t0 = Instant::now();
        let mut cb = Metal::begin(&dev.raw);
        let mut p = Metal::pass_new();
        Metal::pass_color(&mut p, 0, &view.raw, Load::Clear, gpu::Color::black(), true);
        let mut e = Metal::begin_render(&mut cb, &p);
        Metal::render_set_pipeline(&mut e, &pipe.raw);
        Metal::render_set_vertex_buffer(&mut e, 0, &verts.raw, 0);
        for i in 0..DRAWS {
            if i % 10 == 0 {
                Metal::render_set_bind_group(&mut e, &groups[((i / 10) % GROUPS) as usize].raw);
            }
            Metal::draw(&mut e, 0, 6, 0, 1);
        }
        Metal::end_render(&mut e);
        let us = t0.elapsed().as_secs_f64() * 1e6;
        Metal::submit(&mut queue.raw, &mut cb);
        queue.wait_idle().unwrap();
        times.push(us);
    }
    times.sort_unstable_by(|a, b| a.total_cmp(b));
    println("vole-hal {DRAWS} draws: median {:.0} us, min {:.0} us", times[(ITERS / 2) as usize],
        times[0]);
    0
}
