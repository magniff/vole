// Word counting: 3,000,000 pseudo-random words (about 17 MB of text,
// skewed toward short, frequent words) split and counted in a
// std::HashMap<[u8], i64> keyed by slices of the text.
use std::collections::HashMap;

extern "C" {
    fn printf(format: *mut u8, ...) -> i32;
}

fn next(state: &mut u64) -> u64 {
    *state = state.wrapping_mul(6364136223846793005u64).wrapping_add(1442695040888963407u64);
    *state >> 33
}

fn is_letter(c: u8) -> bool {
    c >= b'a' && c <= b'z'
}

// The checksum's hash, FNV-1a as bench/wordcount.c's (0.20: std's Hash
// is foldhash now, so the table's own hash cannot be the checksum's).
fn fnv1a(w: &[u8]) -> u64 {
    let mut h = 14695981039346656037u64;
    for &b in w {
        h = (h ^ (b as u64)).wrapping_mul(1099511628211u64);
    }
    h
}

fn main(gpa: Gpa) -> i32 {
    let mut text: Vec<u8, Gpa> = Vec::new_in(gpa);
    let mut state = 7u64;
    let words: i64 = 3000000;
    for w in 0..words {
        let a = next(&mut state) % 4096u64;
        let b = next(&mut state) % 4096u64;
        let mut id = a * b / 64u64;
        loop {
            text.push(b'a' + (id % 26u64) as u8);
            id = id / 26u64;
            if id == 0u64 {
                break;
            }
        }
        text.push(if w % 12 == 11 { b'\n' } else { b' ' });
    }

    let s = text.as_slice();
    let n = s.len();
    let mut counts: HashMap<&[u8], i64, Gpa, FixedState> = HashMap::new_in(gpa);
    let mut total: i64 = 0;
    let mut i: i64 = 0;
    while i < n as i64 {
        while i < n as i64 && !is_letter(s[i as usize]) {
            i += 1;
        }
        let start = i;
        while i < n as i64 && is_letter(s[i as usize]) {
            i += 1;
        }
        if i > start {
            let w = &s[start as usize..i as usize];
            let c = counts.get(&w).copied().unwrap_or(0);
            counts.insert(w, c + 1);
            total += 1;
        }
    }

    let mut best: &[u8] = b"";
    let mut best_count: i64 = 0;
    let mut checksum = 0u64;
    for (w, c) in &counts {
        let (w, c) = (*w, *c);
        checksum = checksum.wrapping_add((c as u64).wrapping_mul(fnv1a(w)));
        if c > best_count || (c == best_count && w < best) {
            best = w;
            best_count = c;
        }
    }
    unsafe {
        printf(c"%ld words, %ld distinct, checksum %lu\n", total, counts.len(), checksum);
        printf(c"most frequent: %.*s (%ld)\n", best.len() as i32, best.as_ptr(), best_count);
    }
    drop(counts);
    drop(text);
    0
}
