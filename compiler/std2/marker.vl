// EDITION: rust
// std::marker: Copy and PhantomData. Send, Sync, Sized, Freeze and
// AllocFree ("holds no allocator", plan §2.0 rule 1: what a static's type
// must be) are the compiler's structural markers: they are not declared
// here, they need no `use`, and as bounds (`T: Send`) they wait for
// `edition.later: auto_trait`. MVS's `Freeze` and `AllocFree`, traits
// with a sealed method, are gone into them (gone.tsv).

use crate::clone::Clone;

// A type whose values are copied by a move: its bits are the value, and
// the source stays usable. Every part must be Copy, and Clone must agree
// (`#[derive(Clone, Copy)]`). Integers, floats, bool, char, `&T`, raw
// pointers and Gpa are Copy; `&mut T` and anything with a Drop are not.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]
pub trait Copy: Clone {}

// std2: new
impl Copy for () {}

// A zero-sized field that makes a type act as if it held a T: for a
// type's variance and drop check (`PhantomData<&'a T>` ties a raw
// pointer's struct to 'a; plan §4). Built in: it has no field, and
// `PhantomData` is its one value.
pub struct PhantomData<T: ?Sized>;
