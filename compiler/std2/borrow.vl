// EDITION: rust
// std::borrow: Borrow, BorrowMut and ToOwnedIn<A>. Borrow is what lets a
// HashMap<String<A>, V, A> be looked up by a &str: `String<A>:
// Borrow<str>`, with the same Hash and Eq (Hash must not depend on A).
// Cow<'a, B, A> waits for 0.29 (plan §3; it needs ToOwnedIn's Owned to
// carry A through a type).

use crate::alloc::Allocator;

// A view of self as a &Borrowed that hashes and compares as self does.
pub trait Borrow<Borrowed: ?Sized> {
    fn borrow(&self) -> &Borrowed;
}

// The same, mutable.
pub trait BorrowMut<Borrowed: ?Sized>: Borrow<Borrowed> {
    fn borrow_mut(&mut self) -> &mut Borrowed;
}

// Every T is a view of itself (a HashMap<i64, V, A> looked up by &i64).
// later: blanket_impl
impl<T: ?Sized> Borrow<T> for T {
    fn borrow(&self) -> &T {
        self
    }
}

// later: blanket_impl
impl<T: ?Sized> BorrowMut<T> for T {
    fn borrow_mut(&mut self) -> &mut T {
        self
    }
}

// Rust's ToOwned, with the allocator named: an owned copy of a view, on a.
// `"x".to_owned_in(gpa)` is a String<Gpa>, `[1, 2][..].to_owned_in(gpa)` a
// Vec<i64, Gpa>; a Clone type's owned form is a clone (a's unused).
pub trait ToOwnedIn<A: Allocator> {
    type Owned;

    fn to_owned_in(&self, a: A) -> Self::Owned;
}
