// EDITION: rust
// std2: new: the floats' digits, for their Display, Debug, LowerExp and
// UpperExp and their FromStr (front-rust.md F15.5; the compiler's builtin
// impls call these). Exact: a float's value is m * 2^e, and its digits
// are found with big integers (Steele and White's free format and an exact
// division, as Rust's flt2dec Dragon fallback), so `{}` gives the shortest
// digits that read back as the same float, `{:.N}` and `{:.Ne}` round the
// exact value half to even, and parsing rounds to the nearest float.
// Not Rust's: no Grisu fast path (a few big-integer steps per digit).

use crate::fmt::{Alignment, Formatter, Result};

// A big unsigned integer: base 2^32 limbs, least significant first.
// 160 limbs hold 5120 bits: an f64's exact value scaled by 10^k, and a
// parse's 781 digits by its power of ten, are less than 4000.
struct Big {
    d: [u32; 160],
    n: usize,
}

impl Big {
    fn from_u64(v: u64) -> Big {
        let mut b = Big { d: [0u32; 160], n: 0 };
        b.d[0] = v as u32;
        b.d[1] = (v >> 32) as u32;
        b.n = 2;
        b.trim();
        b
    }

    fn copy(&self) -> Big {
        let mut b = Big { d: [0u32; 160], n: self.n };
        let mut i: usize = 0;
        while i < self.n {
            b.d[i] = self.d[i];
            i += 1;
        }
        b
    }

    fn trim(&mut self) {
        while self.n > 0 && self.d[self.n - 1] == 0 {
            self.n -= 1;
        }
    }

    fn is_zero(&self) -> bool {
        self.n == 0
    }

    fn bits(&self) -> usize {
        if self.n == 0 {
            return 0;
        }
        let mut top = self.d[self.n - 1];
        let mut b: usize = (self.n - 1) * 32;
        while top != 0 {
            b += 1;
            top = top >> 1;
        }
        b
    }

    fn mul_small(&mut self, m: u32) {
        let mut carry: u64 = 0;
        let mut i: usize = 0;
        while i < self.n {
            let t = (self.d[i] as u64) * (m as u64) + carry;
            self.d[i] = t as u32;
            carry = t >> 32;
            i += 1;
        }
        if carry != 0 {
            self.d[self.n] = carry as u32;
            self.n += 1;
        }
    }

    fn add_small(&mut self, a: u32) {
        let mut carry: u64 = a as u64;
        let mut i: usize = 0;
        while carry != 0 {
            if i == self.n {
                self.d[i] = 0;
                self.n += 1;
            }
            let t = (self.d[i] as u64) + carry;
            self.d[i] = t as u32;
            carry = t >> 32;
            i += 1;
        }
    }

    fn mul_pow10(&mut self, k: usize) {
        let mut k = k;
        while k >= 9 {
            self.mul_small(1000000000);
            k -= 9;
        }
        let mut m: u32 = 1;
        while k > 0 {
            m = m * 10;
            k -= 1;
        }
        if m != 1 {
            self.mul_small(m);
        }
    }

    fn shl(&mut self, s: usize) {
        if self.n == 0 || s == 0 {
            return;
        }
        let words = s / 32;
        let bits = s % 32;
        let mut i = self.n;
        // the top limb's spill, then each limb from the top down
        self.d[self.n + words] = 0;
        while i > 0 {
            i -= 1;
            let v = self.d[i] as u64;
            let hi = ((v << bits) >> 32) as u32;
            self.d[i + words + 1] = self.d[i + words + 1] | hi;
            self.d[i + words] = (v << bits) as u32;
        }
        let mut j: usize = 0;
        while j < words {
            self.d[j] = 0;
            j += 1;
        }
        self.n = self.n + words + 1;
        self.trim();
    }

    fn shr1(&mut self) {
        let mut i: usize = 0;
        while i < self.n {
            let hi: u32 = if i + 1 < self.n { self.d[i + 1] << 31 } else { 0 };
            self.d[i] = (self.d[i] >> 1) | hi;
            i += 1;
        }
        self.trim();
    }

    // -1, 0 or 1 as self is less than, equal to or greater than o.
    fn cmp(&self, o: &Big) -> i32 {
        if self.n != o.n {
            return if self.n < o.n { -1 } else { 1 };
        }
        let mut i = self.n;
        while i > 0 {
            i -= 1;
            if self.d[i] != o.d[i] {
                return if self.d[i] < o.d[i] { -1 } else { 1 };
            }
        }
        0
    }

    fn add(&mut self, o: &Big) {
        let n = if self.n > o.n { self.n } else { o.n };
        let mut carry: u64 = 0;
        let mut i: usize = 0;
        while i < n {
            let a: u64 = if i < self.n { self.d[i] as u64 } else { 0 };
            let b: u64 = if i < o.n { o.d[i] as u64 } else { 0 };
            let t = a + b + carry;
            self.d[i] = t as u32;
            carry = t >> 32;
            i += 1;
        }
        self.n = n;
        if carry != 0 {
            self.d[n] = carry as u32;
            self.n += 1;
        }
    }

    // self - o, o not greater than self.
    fn sub(&mut self, o: &Big) {
        let mut borrow: u64 = 0;
        let mut i: usize = 0;
        while i < self.n {
            let a = self.d[i] as u64;
            let b: u64 = (if i < o.n { o.d[i] as u64 } else { 0 }) + borrow;
            if a >= b {
                self.d[i] = (a - b) as u32;
                borrow = 0;
            } else {
                self.d[i] = (a + 4294967296 - b) as u32;
                borrow = 1;
            }
            i += 1;
        }
        self.trim();
    }

    // The next digit of r / s, r < 10 s: the quotient, r left the remainder.
    fn digit(r: &mut Big, s: &Big) -> u8 {
        let mut d: u8 = 0;
        while r.cmp(s) >= 0 {
            r.sub(s);
            d += 1;
        }
        d
    }
}

// -1, 0 or 1 as a + b is less than, equal to or greater than c.
fn cmp_sum(a: &Big, b: &Big, c: &Big) -> i32 {
    let mut t = a.copy();
    t.add(b);
    t.cmp(c)
}

// A finite, nonzero v's m and e (v = m * 2^e), for an f64 (53 bits, e at
// least -1074) or an f32 (24 bits, e at least -149), without its bits:
// scaling by a power of two is exact for a float of this range.
fn decompose(v: f64, is32: bool) -> (u64, i32) {
    let two32: f64 = 4294967296.0;
    let mut x = v;
    let mut e: i32 = 0;
    while x >= 9007199254740992.0 * two32 {
        x = x / two32;
        e += 32;
    }
    while x >= 9007199254740992.0 {
        x = x / 2.0;
        e += 1;
    }
    while x < 4503599627370496.0 / two32 {
        x = x * two32;
        e -= 32;
    }
    while x < 4503599627370496.0 {
        x = x * 2.0;
        e -= 1;
    }
    let mut m = x as u64;
    // A subnormal's m has the low bits zero that its exponent cannot show.
    let (bits_down, min_e): (i32, i32) = if is32 { (29, -149) } else { (0, -1074) };
    let mut te = e + bits_down;
    if te < min_e {
        te = min_e;
    }
    m = m >> ((te - e) as u64);
    (m, te)
}

// A float as digits: d[..n], the value 0.d1d2.. * 10^k.
struct Digits {
    d: [u8; 1200],
    n: usize,
    k: i32,
}

// The bits a float's mantissa has, and its least exponent.
fn format_params(is32: bool) -> (u64, i32) {
    if is32 { (24, -149) } else { (53, -1074) }
}

// r / s scaled into [1/10, 1): the k with value = r / s * 10^k.
fn scale(r: &mut Big, s: &mut Big, mp: &mut Big, mm: &mut Big, m: u64, e: i32) -> i32 {
    // an estimate of ceil(log10(value)), then exact fixups
    let bitlen: i32 = 64 - (m.leading_zeros() as i32) + e;
    let mut k: i32 = ((bitlen as i64) * 30103 / 100000) as i32;
    if k > 0 {
        s.mul_pow10(k as usize);
    } else if k < 0 {
        r.mul_pow10((-k) as usize);
        mp.mul_pow10((-k) as usize);
        mm.mul_pow10((-k) as usize);
    }
    while r.cmp(s) >= 0 {
        s.mul_small(10);
        k += 1;
    }
    loop {
        let mut t = r.copy();
        t.mul_small(10);
        if t.cmp(s) >= 0 {
            break;
        }
        r.mul_small(10);
        mp.mul_small(10);
        mm.mul_small(10);
        k -= 1;
    }
    k
}

// The shortest digits that read back as m * 2^e (Steele and White's free
// format, Burger and Dybvig's fixup): a reader rounds half to even, so the
// interval's ends count when m is even.
fn shortest(m: u64, e: i32, is32: bool) -> Digits {
    let (mbits, min_e) = format_params(is32);
    let hidden: u64 = 1 << (mbits - 1);
    let lower_close = m == hidden && e > min_e;
    let mut r = Big::from_u64(m);
    let mut s = Big::from_u64(1);
    let mut mp = Big::from_u64(1);
    let mut mm = Big::from_u64(1);
    if e >= 0 {
        r.shl(e as usize);
        mp.shl(e as usize);
        mm.shl(e as usize);
    } else {
        s.shl((-e) as usize);
    }
    // doubled, so the half gaps are whole: r = 2v, the gaps mp and mm
    r.shl(1);
    s.shl(1);
    if lower_close {
        // the gap below is half the gap above
        r.shl(1);
        s.shl(1);
        mp.shl(1);
    }
    let even = m % 2 == 0;
    let mut out = Digits { d: [0u8; 1200], n: 0, k: 0 };
    // k: the least with v + gap below 10^k (counted as the reader would)
    let bitlen: i32 = 64 - (m.leading_zeros() as i32) + e;
    let est: i32 = ((bitlen as i64) * 30103 / 100000) as i32;
    if est > 0 {
        s.mul_pow10(est as usize);
    } else if est < 0 {
        r.mul_pow10((-est) as usize);
        mp.mul_pow10((-est) as usize);
        mm.mul_pow10((-est) as usize);
    }
    let mut k = est;
    loop {
        let c = cmp_sum(&r, &mp, &s);
        if c > 0 || (c == 0 && even) {
            s.mul_small(10);
            k += 1;
        } else {
            break;
        }
    }
    loop {
        let mut t = r.copy();
        t.add(&mp);
        t.mul_small(10);
        let c = t.cmp(&s);
        if c < 0 || (c == 0 && !even) {
            r.mul_small(10);
            mp.mul_small(10);
            mm.mul_small(10);
            k -= 1;
        } else {
            break;
        }
    }
    out.k = k;
    loop {
        r.mul_small(10);
        mp.mul_small(10);
        mm.mul_small(10);
        let mut d = Big::digit(&mut r, &s);
        let c1 = r.cmp(&mm);
        let low = c1 < 0 || (c1 == 0 && even);
        let c2 = cmp_sum(&r, &mp, &s);
        let high = c2 > 0 || (c2 == 0 && even);
        if low || high {
            if high && !low {
                d += 1;
            } else if low && high {
                // both ends reach: the nearer digit, an even one at a tie
                let mut t = r.copy();
                t.shl(1);
                let c = t.cmp(&s);
                if c > 0 || (c == 0 && d % 2 == 1) {
                    d += 1;
                }
            }
            out.d[out.n] = d;
            out.n += 1;
            return out;
        }
        out.d[out.n] = d;
        out.n += 1;
    }
}

// The exact digits of m * 2^e, rounded half to even at a place: with
// `sig`, to `count` significant digits; else to `count` digits after the
// point. n may be less (the rest are zeros); a rounding up that carries
// out of the first digit raises k.
fn exact(m: u64, e: i32, sig: bool, count: i64) -> Digits {
    let mut r = Big::from_u64(m);
    let mut s = Big::from_u64(1);
    if e >= 0 {
        r.shl(e as usize);
    } else {
        s.shl((-e) as usize);
    }
    let mut mp = Big::from_u64(0);
    let mut mm = Big::from_u64(0);
    let k = scale(&mut r, &mut s, &mut mp, &mut mm, m, e);
    let mut out = Digits { d: [0u8; 1200], n: 0, k: k };
    // the digits wanted: value = 0.d1d2.. * 10^k, so the place 10^-count
    // is digit k + count
    let want: i64 = if sig { count } else { (k as i64) + count };
    if want < 0 {
        // below half of the last place: zero
        return out;
    }
    let mut i: i64 = 0;
    while i < want && !r.is_zero() && out.n < 1200 {
        r.mul_small(10);
        let d = Big::digit(&mut r, &s);
        out.d[out.n] = d;
        out.n += 1;
        i += 1;
    }
    if r.is_zero() || i < want {
        // exact: nothing left to round (or more digits than the value has)
        return out;
    }
    // round on what is left: r / s against a half
    r.shl(1);
    let c = r.cmp(&s);
    let last_odd = out.n > 0 && out.d[out.n - 1] % 2 == 1;
    if c > 0 || (c == 0 && last_odd) {
        // up, carrying
        let mut j = out.n;
        loop {
            if j == 0 {
                // 9.99 up to 10.0: one digit, a place higher
                out.d[0] = 1;
                out.n = 1;
                out.k += 1;
                break;
            }
            j -= 1;
            if out.d[j] == 9 {
                out.d[j] = 0;
                out.n = j;
            } else {
                out.d[j] += 1;
                break;
            }
        }
    }
    out
}

// The text of a float: [sign] head zeros tail, padded as the hole says.
struct Text {
    head: [u8; 1400],
    hn: usize,
    zeros: usize,
    tail: [u8; 8],
    tn: usize,
}

impl Text {
    fn new() -> Text {
        Text { head: [0u8; 1400], hn: 0, zeros: 0, tail: [0u8; 8], tn: 0 }
    }

    fn push(&mut self, b: u8) {
        if self.zeros > 0 {
            // a digit after counted zeros: write them out first
            while self.zeros > 0 && self.hn < 1400 {
                self.head[self.hn] = 48;
                self.hn += 1;
                self.zeros -= 1;
            }
        }
        if self.hn < 1400 {
            self.head[self.hn] = b;
            self.hn += 1;
        }
    }

    fn push_str(&mut self, s: &str) {
        let b = s.as_bytes();
        let mut i: usize = 0;
        while i < b.len() {
            self.push(b[i]);
            i += 1;
        }
    }

    fn exponent(&mut self, upper: bool, x: i32) {
        self.tail[0] = if upper { 69 } else { 101 };
        self.tn = 1;
        let mut v = x;
        if v < 0 {
            self.tail[1] = 45;
            self.tn = 2;
            v = -v;
        }
        let mut buf = [0u8; 4];
        let mut i: usize = 4;
        loop {
            i -= 1;
            buf[i] = 48 + (v % 10) as u8;
            v = v / 10;
            if v == 0 {
                break;
            }
        }
        while i < 4 {
            self.tail[self.tn] = buf[i];
            self.tn += 1;
            i += 1;
        }
    }

    fn len(&self) -> usize {
        self.hn + self.zeros + self.tn
    }
}

fn write_bytes(f: &mut Formatter<'_>, b: &[u8]) -> Result {
    match crate::str::from_utf8(b) {
        crate::result::Result::Ok(s) => f.write_str(s),
        crate::result::Result::Err(_) => crate::result::Result::Ok(()),
    }
}

fn write_fill(f: &mut Formatter<'_>, c: char, n: usize) -> Result {
    let mut i: usize = 0;
    while i < n {
        f.write_char(c)?;
        i += 1;
    }
    crate::result::Result::Ok(())
}

// sign and t padded to the width: `0` puts zeros after the sign, else the
// fill goes where the alignment says (right by default), as Rust's
// pad_formatted_parts.
fn pad(f: &mut Formatter<'_>, sign: &str, t: &Text) -> Result {
    let len = sign.len() + t.len();
    let width = match f.width() {
        crate::option::Option::Some(w) => w,
        crate::option::Option::None => 0,
    };
    if len < width && f.sign_aware_zero_pad() {
        f.write_str(sign)?;
        write_fill(f, '0', width - len)?;
        return write_text(f, t);
    }
    let p: usize = if len >= width { 0 } else { width - len };
    let fill = f.fill();
    let (pre, post): (usize, usize) = match f.align() {
        crate::option::Option::Some(Alignment::Left) => (0, p),
        crate::option::Option::Some(Alignment::Center) => (p / 2, p - p / 2),
        _ => (p, 0),
    };
    write_fill(f, fill, pre)?;
    f.write_str(sign)?;
    write_text(f, t)?;
    write_fill(f, fill, post)
}

fn write_text(f: &mut Formatter<'_>, t: &Text) -> Result {
    write_bytes(f, &t.head[..t.hn])?;
    write_fill(f, '0', t.zeros)?;
    write_bytes(f, &t.tail[..t.tn])
}

// digits as a fixed-point number: at least `frac` digits after the point
// (and exactly `frac` when `exactly`).
fn fixed(t: &mut Text, d: &Digits, frac: usize, exactly: bool) {
    let k = d.k as i64;
    let n = d.n as i64;
    // the integer part
    if k <= 0 {
        t.push(48);
    } else {
        let mut i: i64 = 0;
        while i < k {
            t.push(if i < n { 48 + d.d[i as usize] } else { 48 });
            i += 1;
        }
    }
    // the fraction: the digits after the point, then zeros to frac
    let have: i64 = if n > k { n - k } else { 0 };
    let shown: i64 = if exactly { frac as i64 } else if have > frac as i64 { have }
        else { frac as i64 };
    if shown == 0 {
        return;
    }
    t.push(46);
    let mut j: i64 = 0;
    while j < shown {
        // place j after the point is digit k + j
        let at = k + j;
        if at >= n {
            t.zeros += (shown - j) as usize;
            return;
        }
        t.push(if at < 0 { 48 } else { 48 + d.d[at as usize] });
        j += 1;
    }
}

// digits as d.ddd e x: `frac` digits after the point at least.
fn scientific(t: &mut Text, d: &Digits, frac: usize, upper: bool) {
    let n = d.n;
    t.push(48 + if n > 0 { d.d[0] } else { 0 });
    let have = if n > 1 { n - 1 } else { 0 };
    let shown = if have > frac { have } else { frac };
    if shown > 0 {
        t.push(46);
        let mut j: usize = 1;
        while j < n {
            t.push(48 + d.d[j]);
            j += 1;
        }
        t.zeros += shown - have;
    }
    t.exponent(upper, if n > 0 { d.k - 1 } else { 0 });
}

// A float as its Display (kind 0), Debug (1), LowerExp (2) or UpperExp (3)
// writes it; an f32's value comes as the f64 it converts to, exactly.
#[effects(panic, diverge)]
pub(crate) fn fmt_float(v: f64, is32: bool, kind: u8, f: &mut Formatter<'_>) -> Result {
    let mut t = Text::new();
    if v != v {
        // NaN: no sign, even with `+`
        t.push_str("NaN");
        return pad(f, "", &t);
    }
    let neg = v < 0.0 || (v == 0.0 && 1.0 / v < 0.0);
    let sign: &str = if neg { "-" } else if f.sign_plus() { "+" } else { "" };
    let a = if neg { -v } else { v };
    let upper = kind == 3;
    if a == 1.0 / 0.0 {
        t.push_str("inf");
        return pad(f, sign, &t);
    }
    let prec = f.precision();
    let exp_form = kind >= 2
        || (kind == 1 && prec.is_none() && a != 0.0 && (a < 0.0001 || a >= 10000000000000000.0));
    if a == 0.0 {
        let p = match prec {
            crate::option::Option::Some(p) => p,
            crate::option::Option::None => if kind == 1 && !exp_form { 1 } else { 0 },
        };
        let zero = Digits { d: [0u8; 1200], n: 0, k: 1 };
        if exp_form {
            scientific(&mut t, &zero, p, upper);
        } else {
            fixed(&mut t, &zero, p, true);
        }
        return pad(f, sign, &t);
    }
    let (m, e) = decompose(a, is32);
    match prec {
        crate::option::Option::Some(p) => {
            if exp_form {
                let d = exact(m, e, true, (p as i64) + 1);
                scientific(&mut t, &d, p, upper);
            } else {
                let d = exact(m, e, false, p as i64);
                fixed(&mut t, &d, p, true);
            }
        }
        crate::option::Option::None => {
            let d = shortest(m, e, is32);
            if exp_form {
                scientific(&mut t, &d, 0, upper);
            } else {
                fixed(&mut t, &d, if kind == 1 { 1 } else { 0 }, false);
            }
        }
    }
    pad(f, sign, &t)
}

// s as a float, rounded to the nearest (half to even): Rust's grammar, a
// sign, then `inf`, `infinity` or `nan` in any case, or digits with a
// point and an exponent (`1.5`, `.5`, `5.`, `1e-3`, `+3.5E+2`). Err(true)
// when s is empty, Err(false) when it is not a float. An f32's comes as
// the f64 of its value, exactly.
#[effects(panic, diverge)]
pub(crate) fn parse_float(s: &str, is32: bool) -> crate::result::Result<f64, bool> {
    let b = s.as_bytes();
    let n = b.len();
    if n == 0 {
        return crate::result::Result::Err(true);
    }
    let mut i: usize = 0;
    let mut neg = false;
    if b[0] == 43 || b[0] == 45 {
        neg = b[0] == 45;
        i = 1;
    }
    let sign: f64 = if neg { -1.0 } else { 1.0 };
    let rest = &b[i..];
    if eq_lower(rest, "inf") || eq_lower(rest, "infinity") {
        return crate::result::Result::Ok(sign / 0.0);
    }
    if eq_lower(rest, "nan") {
        let z: f64 = 0.0;
        return crate::result::Result::Ok(z / z);
    }
    // the digits: at most 780 kept, a dropped nonzero one kept as a 1
    let mut big = Big::from_u64(0);
    let mut kept: usize = 0;
    let mut dropped = false;
    let mut exp10: i64 = 0;
    let mut any = false;
    let mut point = false;
    while i < n {
        let c = b[i];
        if c >= 48 && c <= 57 {
            any = true;
            if kept == 0 && c == 48 {
                // a leading zero: only the place moves
                if point {
                    exp10 -= 1;
                }
            } else if kept < 780 {
                big.mul_small(10);
                big.add_small((c - 48) as u32);
                kept += 1;
                if point {
                    exp10 -= 1;
                }
            } else {
                if c != 48 {
                    dropped = true;
                }
                if !point {
                    exp10 += 1;
                }
            }
        } else if c == 46 && !point {
            point = true;
        } else {
            break;
        }
        i += 1;
    }
    if !any {
        return crate::result::Result::Err(false);
    }
    if i < n {
        if b[i] != 101 && b[i] != 69 {
            return crate::result::Result::Err(false);
        }
        i += 1;
        let mut eneg = false;
        if i < n && (b[i] == 43 || b[i] == 45) {
            eneg = b[i] == 45;
            i += 1;
        }
        if i == n {
            return crate::result::Result::Err(false);
        }
        let mut x: i64 = 0;
        while i < n {
            let c = b[i];
            if c < 48 || c > 57 {
                return crate::result::Result::Err(false);
            }
            if x < 100000000 {
                x = x * 10 + ((c - 48) as i64);
            }
            i += 1;
        }
        exp10 += if eneg { -x } else { x };
    }
    if dropped {
        big.mul_small(10);
        big.add_small(1);
        kept += 1;
        exp10 -= 1;
    }
    if big.is_zero() {
        return crate::result::Result::Ok(sign * 0.0);
    }
    // the decimal exponent of the first digit: past the ranges, inf or 0
    let top = exp10 + (kept as i64);
    if top > 310 {
        return crate::result::Result::Ok(sign / 0.0);
    }
    if top < -326 {
        return crate::result::Result::Ok(sign * 0.0);
    }
    let (mbits, min_e) = format_params(is32);
    let mbits = mbits as i64;
    let min_e = min_e as i64;
    let max_biased: i64 = if is32 { 255 } else { 2047 };
    let bias: i64 = if is32 { 127 } else { 1023 };
    // value = num / den
    let mut num = big;
    let mut den = Big::from_u64(1);
    if exp10 >= 0 {
        num.mul_pow10(exp10 as usize);
    } else {
        den.mul_pow10((-exp10) as usize);
    }
    // q = floor(value / 2^b), mbits + 2 bits at most
    let mut b2: i64 = (num.bits() as i64) - (den.bits() as i64) - mbits - 2;
    if b2 < min_e - 1 {
        b2 = min_e - 1;
    }
    if b2 < 0 {
        num.shl((-b2) as usize);
    } else {
        den.shl(b2 as usize);
    }
    let mut q: u64 = 0;
    let mut t = den.copy();
    t.shl(57);
    let mut bit: i64 = 57;
    while bit >= 0 {
        if num.cmp(&t) >= 0 {
            num.sub(&t);
            q = q | (1u64 << (bit as u64));
        }
        t.shr1();
        bit -= 1;
    }
    let mut sticky = !num.is_zero();
    let limit: u64 = 1u64 << ((mbits + 1) as u64);
    while q >= limit {
        sticky = sticky || q % 2 == 1;
        q = q >> 1;
        b2 += 1;
    }
    let round = q % 2 == 1;
    let mut m = q >> 1;
    let mut e = b2 + 1;
    if round && (sticky || m % 2 == 1) {
        m += 1;
        if m == (1u64 << (mbits as u64)) {
            m = m >> 1;
            e += 1;
        }
    }
    let hidden: u64 = 1u64 << ((mbits - 1) as u64);
    if m >= hidden && e + bias + mbits - 1 >= max_biased {
        return crate::result::Result::Ok(sign / 0.0);
    }
    crate::result::Result::Ok(sign * scale2(m as f64, e))
}

// x * 2^e, exactly: each step's value is m * 2^j between the two, which
// the float holds.
fn scale2(x: f64, e: i64) -> f64 {
    let two32: f64 = 4294967296.0;
    let mut v = x;
    let mut e = e;
    while e >= 32 {
        v = v * two32;
        e -= 32;
    }
    while e > 0 {
        v = v * 2.0;
        e -= 1;
    }
    while e <= -32 {
        v = v / two32;
        e += 32;
    }
    while e < 0 {
        v = v / 2.0;
        e += 1;
    }
    v
}

// b equal to the ASCII word w, in any case.
fn eq_lower(b: &[u8], w: &str) -> bool {
    let wb = w.as_bytes();
    if b.len() != wb.len() {
        return false;
    }
    let mut i: usize = 0;
    while i < b.len() {
        let c = b[i];
        let lc = if c >= 65 && c <= 90 { c + 32 } else { c };
        if lc != wb[i] {
            return false;
        }
        i += 1;
    }
    true
}

// "true" or "false", as bool's FromStr reads them.
#[effects(panic, diverge)]
pub(crate) fn parse_bool(s: &str) -> crate::option::Option<bool> {
    let b = s.as_bytes();
    if b == "true".as_bytes() {
        crate::option::Option::Some(true)
    } else if b == "false".as_bytes() {
        crate::option::Option::Some(false)
    } else {
        crate::option::Option::None
    }
}

// An integer's LowerExp or UpperExp (`{:e}` of 1234 is 1.234e3): its exact
// digits, rounded half to even to the precision.
#[effects(panic, diverge)]
pub(crate) fn fmt_int_exp(neg: bool, v: u64, upper: bool, f: &mut Formatter<'_>) -> Result {
    let mut t = Text::new();
    let sign: &str = if neg { "-" } else if f.sign_plus() { "+" } else { "" };
    let p = match f.precision() {
        crate::option::Option::Some(p) => p,
        crate::option::Option::None => 0,
    };
    if v == 0 {
        let zero = Digits { d: [0u8; 1200], n: 0, k: 1 };
        scientific(&mut t, &zero, p, upper);
        return pad(f, sign, &t);
    }
    let count: i64 = match f.precision() {
        crate::option::Option::Some(p) => (p as i64) + 1,
        crate::option::Option::None => 40,
    };
    let d = exact(v, 0, true, count);
    scientific(&mut t, &d, p, upper);
    pad(f, sign, &t)
}
