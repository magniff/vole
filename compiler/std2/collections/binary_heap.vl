// EDITION: rust
// std::collections::binary_heap (0.18.1; std2 0.28.0): priority queues in
// a Vec. `BinaryHeap` is Rust's, a max-heap: `pop` takes the largest
// element first. `MinHeap`, vole's own, has the same API and takes the
// smallest first (Rust spells it `BinaryHeap<Reverse<T>>`, which works
// too). `push` and `pop` are O(log n), building one from a Vec O(n).
// mvs: std::BinaryHeap, std::MinHeap

use crate::alloc::Allocator;
use crate::clone::Clone;
use crate::cmp::Ord;
use crate::convert::From;
use crate::fmt::{Debug, Formatter};
use crate::iter::{Extend, IntoIterator, Iterator};
use crate::option::Option;
use crate::slice::Iter;
use crate::vec::Vec;

// Which of two elements a heap keeps nearer the root.
trait HeapOrder {
    fn above<T: Ord>(a: &T, b: &T) -> bool;
}

struct HeapMax {}

struct HeapMin {}

impl HeapOrder for HeapMax {
    #[inline]
    fn above<T: Ord>(a: &T, b: &T) -> bool {
        *a > *b
    }
}

impl HeapOrder for HeapMin {
    #[inline]
    fn above<T: Ord>(a: &T, b: &T) -> bool {
        *a < *b
    }
}

// Moves v[i] towards the root while it is above its parent.
fn sift_up<T: Ord, O: HeapOrder>(v: &mut [T], i: usize) {
    let mut i = i;
    while i > 0 {
        let parent = (i - 1) / 2;
        if !O::above(&v[i], &v[parent]) {
            break;
        }
        v.swap(i, parent);
        i = parent;
    }
}

// Moves v[i] down while a child of it in v[..end] is above it.
fn sift_down<T: Ord, O: HeapOrder>(v: &mut [T], i: usize, end: usize) {
    let mut i = i;
    loop {
        let mut child = 2 * i + 1;
        if child >= end {
            break;
        }
        if child + 1 < end && O::above(&v[child + 1], &v[child]) {
            child += 1;
        }
        if !O::above(&v[child], &v[i]) {
            break;
        }
        v.swap(i, child);
        i = child;
    }
}

// Makes v a heap, in O(n).
fn build<T: Ord, O: HeapOrder>(v: &mut [T]) {
    let n = v.len();
    let mut k = n / 2;
    while k > 0 {
        k -= 1;
        sift_down::<T, O>(v, k, n);
    }
}

fn push<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>, x: T) {
    v.push(x);
    let n = v.len();
    sift_up::<T, O>(v.as_mut_slice(), n - 1);
}

fn pop<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>) -> Option<T> {
    let n = v.len();
    if n == 0 {
        return Option::None;
    }
    v.as_mut_slice().swap(0, n - 1);
    let top = v.pop();
    sift_down::<T, O>(v.as_mut_slice(), 0, n - 1);
    top
}

// The heap in v sorted in place: the root's end of the order last.
fn sort<T: Ord, O: HeapOrder>(v: &mut [T]) {
    let mut end = v.len();
    while end > 1 {
        end -= 1;
        v.swap(0, end);
        sift_down::<T, O>(v, 0, end);
    }
}

// A max-heap on allocator A.
pub struct BinaryHeap<T: Ord, A: Allocator> {
    data: Vec<T, A>,
}

// A min-heap on allocator A, BinaryHeap's API with the order reversed.
// std2: kept: vole's own (Rust: BinaryHeap<Reverse<T>>)
pub struct MinHeap<T: Ord, A: Allocator> {
    data: Vec<T, A>,
}

impl<T: Ord, A: Allocator> BinaryHeap<T, A> {
    // An empty heap.
    #[effects(T, A)]
    pub fn new_in(a: A) -> BinaryHeap<T, A> {
        BinaryHeap { data: Vec::new_in(a) }
    }

    // An empty heap with room for cap elements.
    #[effects(T, A)]
    pub fn with_capacity_in(cap: usize, a: A) -> BinaryHeap<T, A> {
        BinaryHeap { data: Vec::with_capacity_in(cap, a) }
    }

    // A heap of v's elements, in O(n), on v's memory (Rust's
    // `BinaryHeap::from(v)`).
    #[effects(T, A)]
    pub fn from_vec(v: Vec<T, A>) -> BinaryHeap<T, A> {
        let mut data = v;
        build::<T, HeapMax>(data.as_mut_slice());
        BinaryHeap { data: data }
    }

    #[effects(T, A)]
    pub fn len(&self) -> usize {
        self.data.len()
    }

    #[effects(T, A)]
    pub fn is_empty(&self) -> bool {
        self.data.len() == 0
    }

    // Adds x, in O(log n).
    #[effects(T, A)]
    pub fn push(&mut self, x: T) {
        push::<T, HeapMax, A>(&mut self.data, x);
    }

    // Takes the largest element out (None when empty), in O(log n).
    #[effects(T, A)]
    pub fn pop(&mut self) -> Option<T> {
        pop::<T, HeapMax, A>(&mut self.data)
    }

    // The largest element, which stays.
    // std2: changed: Option<&T> (MVS: a copy)
    #[effects(T, A)]
    pub fn peek(&self) -> Option<&T> {
        self.data.first()
    }

    // Drops the elements; the room stays.
    #[effects(T, A)]
    pub fn clear(&mut self) {
        self.data.clear();
    }

    #[effects(T, A)]
    pub fn capacity(&self) -> usize {
        self.data.capacity()
    }

    // Room for extra more elements.
    pub fn reserve(&mut self, extra: usize) {
        self.data.reserve(extra);
    }

    // Its allocator.
    // std2: changed: a &A (MVS: a copy)
    pub fn allocator(&self) -> &A {
        self.data.allocator()
    }

    // Its elements in heap order (the largest first, the rest in no useful
    // order).
    pub fn as_slice(&self) -> &[T] {
        self.data.as_slice()
    }

    // Its elements, in heap order.
    #[effects(T, A)]
    pub fn iter(&self) -> Iter<'_, T> {
        self.data.iter()
    }

    // Its elements in a Vec, in heap order, on the same memory.
    pub fn into_vec(self) -> Vec<T, A> {
        self.data
    }

    // Its elements in a Vec, smallest first, on the same memory: a
    // heapsort, in O(n log n).
    #[effects(T, A)]
    pub fn into_sorted_vec(self) -> Vec<T, A> {
        let mut v = self.data;
        sort::<T, HeapMax>(v.as_mut_slice());
        v
    }

    // Moves other's elements into it, leaving other empty.
    #[effects(diverge, T, A)]
    pub fn append(&mut self, other: &mut BinaryHeap<T, A>) {
        while let Option::Some(x) = other.data.pop() {
            self.push(x);
        }
    }
}

impl<T: Ord, A: Allocator> MinHeap<T, A> {
    // An empty heap.
    pub fn new_in(a: A) -> MinHeap<T, A> {
        MinHeap { data: Vec::new_in(a) }
    }

    // An empty heap with room for cap elements.
    pub fn with_capacity_in(cap: usize, a: A) -> MinHeap<T, A> {
        MinHeap { data: Vec::with_capacity_in(cap, a) }
    }

    // A heap of v's elements, in O(n), on v's memory.
    #[effects(T, A)]
    pub fn from_vec(v: Vec<T, A>) -> MinHeap<T, A> {
        let mut data = v;
        build::<T, HeapMin>(data.as_mut_slice());
        MinHeap { data: data }
    }

    pub fn len(&self) -> usize {
        self.data.len()
    }

    pub fn is_empty(&self) -> bool {
        self.data.len() == 0
    }

    // Adds x, in O(log n).
    #[effects(T, A)]
    pub fn push(&mut self, x: T) {
        push::<T, HeapMin, A>(&mut self.data, x);
    }

    // Takes the smallest element out (None when empty), in O(log n).
    #[effects(T, A)]
    pub fn pop(&mut self) -> Option<T> {
        pop::<T, HeapMin, A>(&mut self.data)
    }

    // The smallest element, which stays.
    // std2: changed: Option<&T> (MVS: a copy)
    #[effects(T, A)]
    pub fn peek(&self) -> Option<&T> {
        self.data.first()
    }

    // Drops the elements; the room stays.
    pub fn clear(&mut self) {
        self.data.clear();
    }

    pub fn capacity(&self) -> usize {
        self.data.capacity()
    }

    // Room for extra more elements.
    pub fn reserve(&mut self, extra: usize) {
        self.data.reserve(extra);
    }

    // Its allocator.
    // std2: changed: a &A (MVS: a copy)
    pub fn allocator(&self) -> &A {
        self.data.allocator()
    }

    // Its elements in heap order (the smallest first, the rest in no
    // useful order).
    pub fn as_slice(&self) -> &[T] {
        self.data.as_slice()
    }

    // Its elements, in heap order.
    pub fn iter(&self) -> Iter<'_, T> {
        self.data.iter()
    }

    // Its elements in a Vec, in heap order, on the same memory.
    pub fn into_vec(self) -> Vec<T, A> {
        self.data
    }

    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same
    // memory, in O(n log n).
    #[effects(T, A)]
    pub fn into_sorted_vec(self) -> Vec<T, A> {
        let mut v = self.data;
        sort::<T, HeapMin>(v.as_mut_slice());
        v.as_mut_slice().reverse();
        v
    }

    // Moves other's elements into it, leaving other empty.
    pub fn append(&mut self, other: &mut MinHeap<T, A>) {
        while let Option::Some(x) = other.data.pop() {
            self.push(x);
        }
    }
}

impl<T: Ord, A: Allocator> From<Vec<T, A>> for BinaryHeap<T, A> {
    fn from(v: Vec<T, A>) -> BinaryHeap<T, A> {
        BinaryHeap::from_vec(v)
    }
}

impl<T: Ord, A: Allocator> From<Vec<T, A>> for MinHeap<T, A> {
    fn from(v: Vec<T, A>) -> MinHeap<T, A> {
        MinHeap::from_vec(v)
    }
}

impl<T: Ord, A: Allocator> Extend<T> for BinaryHeap<T, A> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.push(x);
        }
    }
}

impl<T: Ord, A: Allocator> Extend<T> for MinHeap<T, A> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.push(x);
        }
    }
}

// A copy on the same allocator.
impl<T: Ord + Clone, A: Allocator + Clone> Clone for BinaryHeap<T, A> {
    fn clone(&self) -> BinaryHeap<T, A> {
        BinaryHeap { data: self.data.clone() }
    }
}

impl<T: Ord + Clone, A: Allocator + Clone> Clone for MinHeap<T, A> {
    fn clone(&self) -> MinHeap<T, A> {
        MinHeap { data: self.data.clone() }
    }
}

// Its elements in heap order, as a list (Rust's).
impl<T: Ord + Debug, A: Allocator> Debug for BinaryHeap<T, A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        Debug::fmt(self.data.as_slice(), f)
    }
}

impl<T: Ord + Debug, A: Allocator> Debug for MinHeap<T, A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        Debug::fmt(self.data.as_slice(), f)
    }
}

// `for x in &heap`: its elements, in heap order.
impl<'a, T: Ord, A: Allocator> IntoIterator for &'a BinaryHeap<T, A> {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.data.iter()
    }
}

impl<'a, T: Ord, A: Allocator> IntoIterator for &'a MinHeap<T, A> {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.data.iter()
    }
}
