// EDITION: rust
// std::collections: HashMap, HashSet, BTreeMap, BTreeSet, BinaryHeap and
// MinHeap.

pub mod binary_heap;
pub mod btree_map;
pub mod hash_map;
pub mod hash_set;

pub use binary_heap::{BinaryHeap, MinHeap};
pub use btree_map::{BTreeMap, BTreeSet};
pub use hash_map::HashMap;
pub use hash_set::HashSet;

// Why try_reserve failed: the capacity overflowed, or the allocator.
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum TryReserveError {
    CapacityOverflow,
    AllocError { layout: crate::alloc::Layout },
}
