// EDITION: rust
// std::collections::hash_set: HashSet<T, A, S>, a HashMap<T, (), A, S>,
// and its iterators. As HashMap: A always written, S defaulted to
// FixedState and last, lookups by a reference to anything T Borrows.

use crate::alloc::Allocator;
use crate::borrow::Borrow;
use crate::clone::Clone;
use crate::cmp::{Eq, PartialEq};
use crate::default::{Default, DefaultIn};
use crate::fmt::{Debug, Formatter};
use crate::hash::{BuildHasher, FixedState, Hash};
use crate::iter::{Extend, FromIteratorIn, IntoIterator, Iterator};
use crate::option::Option;

use super::hash_map::{self, HashMap};

// A set of T on A, hashed by S.
// std2: changed: an S, defaulted; the bounds moved to the impls
pub struct HashSet<T, A: Allocator, S = FixedState> {
    map: HashMap<T, (), A, S>,
}

impl<T, A: Allocator> HashSet<T, A, FixedState> {
    pub fn new_in(a: A) -> HashSet<T, A, FixedState> {
        HashSet { map: HashMap::new_in(a) }
    }

    pub fn with_capacity_in(n: usize, a: A) -> HashSet<T, A, FixedState> {
        HashSet { map: HashMap::with_capacity_in(n, a) }
    }
}

impl<T, A: Allocator, S> HashSet<T, A, S> {
    pub fn with_hasher_in(hasher: S, a: A) -> HashSet<T, A, S> {
        HashSet { map: HashMap::with_hasher_in(hasher, a) }
    }

    pub fn len(&self) -> usize {
        self.map.len()
    }

    pub fn is_empty(&self) -> bool {
        self.map.is_empty()
    }

    pub fn capacity(&self) -> usize {
        self.map.capacity()
    }

    // std2: changed: returns &A
    pub fn allocator(&self) -> &A {
        self.map.allocator()
    }

    pub fn hasher(&self) -> &S {
        self.map.hasher()
    }

    // Its elements, by reference.
    // std2: changed: yields &T
    pub fn iter(&self) -> Iter<'_, T> {
        Iter { inner: self.map.keys() }
    }

    pub fn clear(&mut self) {
        self.map.clear()
    }

    // Every element, removed and yielded by the iterator.
    pub fn drain(&mut self) -> Drain<'_, T, A> {
        Drain { inner: self.map.drain() }
    }

    // Keeps the elements f says true of.
    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {
        let mut f = f;
        self.map.retain(|k, _| f(k))
    }
}

impl<T: Hash + Eq, A: Allocator, S: BuildHasher> HashSet<T, A, S> {
    pub fn reserve(&mut self, n: usize) {
        self.map.reserve(n)
    }

    // std2: changed: takes &Q
    pub fn contains<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> bool
    where
        T: Borrow<Q>,
    {
        self.map.contains_key(x)
    }

    // The stored element equal to x.
    pub fn get<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> Option<&T>
    where
        T: Borrow<Q>,
    {
        self.map.get_key_value(x).map(|(k, _)| k)
    }

    // Adds x; false when it was there already.
    pub fn insert(&mut self, x: T) -> bool {
        self.map.insert(x, ()).is_none()
    }

    // Adds x, replacing an equal element; the old one.
    pub fn replace(&mut self, x: T) -> Option<T> {
        crate::panic::todo()
    }

    // Removes x; whether it was there.
    // std2: changed: takes &Q
    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> bool
    where
        T: Borrow<Q>,
    {
        self.map.remove(x).is_some()
    }

    // Removes and returns the stored element equal to x.
    pub fn take<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> Option<T>
    where
        T: Borrow<Q>,
    {
        self.map.remove_entry(x).map(|(k, _)| k)
    }

    // The elements of either, each once.
    pub fn union<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Union<'a, T, A, S> {
        Union { a: self.iter(), b: other.iter(), a_set: self }
    }

    // The elements of both.
    pub fn intersection<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Intersection<'a, T, A, S> {
        Intersection { a: self.iter(), other: other }
    }

    // The elements of self that other has not.
    pub fn difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Difference<'a, T, A, S> {
        Difference { a: self.iter(), other: other }
    }

    // The elements of one of them only.
    pub fn symmetric_difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> SymmetricDifference<'a, T, A, S> {
        SymmetricDifference { a: self.difference(other), b: other.difference(self) }
    }

    pub fn is_disjoint(&self, other: &HashSet<T, A, S>) -> bool {
        self.iter().all(|x| !other.contains(x))
    }

    pub fn is_subset(&self, other: &HashSet<T, A, S>) -> bool {
        self.iter().all(|x| other.contains(x))
    }

    pub fn is_superset(&self, other: &HashSet<T, A, S>) -> bool {
        other.is_subset(self)
    }
}

// std2: changed: needs A: Clone and S: Clone
impl<T: Hash + Eq + Clone, A: Allocator + Clone, S: BuildHasher + Clone> Clone for HashSet<T, A, S> {
    fn clone(&self) -> HashSet<T, A, S> {
        HashSet { map: self.map.clone() }
    }
}

impl<T: Hash + Eq, A: Allocator, B: Allocator, S: BuildHasher> PartialEq<HashSet<T, B, S>> for HashSet<T, A, S> {
    fn eq(&self, other: &HashSet<T, B, S>) -> bool {
        self.len() == other.len() && self.iter().all(|x| other.contains(x))
    }
}

impl<T: Hash + Eq, A: Allocator, S: BuildHasher> Eq for HashSet<T, A, S> {}

impl<T: Debug, A: Allocator, S> Debug for HashSet<T, A, S> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.debug_set().entries(self.iter()).finish()
    }
}

impl<T: Hash + Eq, A: Allocator, S: BuildHasher> Extend<T> for HashSet<T, A, S> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.insert(x);
        }
    }
}

impl<T: Hash + Eq, A: Allocator, S: BuildHasher + Default> FromIteratorIn<T, A> for HashSet<T, A, S> {
    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> HashSet<T, A, S> {
        let mut s = HashSet::with_hasher_in(S::default(), a);
        s.extend(iter);
        s
    }
}

impl<T, A: Allocator, S: Default> DefaultIn<A> for HashSet<T, A, S> {
    fn default_in(a: A) -> HashSet<T, A, S> {
        HashSet::with_hasher_in(S::default(), a)
    }
}

impl<T, A: Allocator, S> IntoIterator for HashSet<T, A, S> {
    type Item = T;
    type IntoIter = IntoIter<T, A>;

    fn into_iter(self) -> IntoIter<T, A> {
        IntoIter { inner: self.map.into_keys() }
    }
}

impl<'a, T, A: Allocator, S> IntoIterator for &'a HashSet<T, A, S> {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.iter()
    }
}

// HashSet::iter's iterator.
// mvs: HashSetIter
// std2: renamed
pub struct Iter<'a, T> {
    inner: hash_map::Keys<'a, T, ()>,
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        self.inner.next()
    }
}

// A set's elements, by value.
pub struct IntoIter<T, A: Allocator> {
    inner: hash_map::IntoKeys<T, (), A>,
}

impl<T, A: Allocator> Iterator for IntoIter<T, A> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        self.inner.next()
    }
}

// HashSet::drain's iterator.
pub struct Drain<'a, T, A: Allocator> {
    inner: hash_map::Drain<'a, T, (), A>,
}

impl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        self.inner.next().map(|(k, _)| k)
    }
}

// HashSet::union's iterator.
pub struct Union<'a, T, A: Allocator, S> {
    a: Iter<'a, T>,
    b: Iter<'a, T>,
    a_set: &'a HashSet<T, A, S>,
}

impl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Union<'a, T, A, S> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        if let Option::Some(x) = self.a.next() {
            return Option::Some(x);
        }
        while let Option::Some(x) = self.b.next() {
            if !self.a_set.contains(x) {
                return Option::Some(x);
            }
        }
        Option::None
    }
}

// HashSet::intersection's iterator.
pub struct Intersection<'a, T, A: Allocator, S> {
    a: Iter<'a, T>,
    other: &'a HashSet<T, A, S>,
}

impl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Intersection<'a, T, A, S> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        while let Option::Some(x) = self.a.next() {
            if self.other.contains(x) {
                return Option::Some(x);
            }
        }
        Option::None
    }
}

// HashSet::difference's iterator.
pub struct Difference<'a, T, A: Allocator, S> {
    a: Iter<'a, T>,
    other: &'a HashSet<T, A, S>,
}

impl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Difference<'a, T, A, S> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        while let Option::Some(x) = self.a.next() {
            if !self.other.contains(x) {
                return Option::Some(x);
            }
        }
        Option::None
    }
}

// HashSet::symmetric_difference's iterator.
pub struct SymmetricDifference<'a, T, A: Allocator, S> {
    a: Difference<'a, T, A, S>,
    b: Difference<'a, T, A, S>,
}

impl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for SymmetricDifference<'a, T, A, S> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        match self.a.next() {
            Option::Some(x) => Option::Some(x),
            Option::None => self.b.next(),
        }
    }
}
