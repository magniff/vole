// EDITION: rust
// std::ops: the operator traits, Deref and DerefMut, Index and IndexMut,
// Drop, and the ranges (`a..b` and the rest; MVS had Range and
// RangeInclusive in std::iter). Fn, FnMut and FnOnce are the compiler's.
// The arithmetic on numbers is built in; the traits are for other types
// (a vector, a matrix, a String's `+`).

use crate::cmp::PartialOrd;

// `*x`, and method calls through it: `v.len()` on a Box<Vec<T, A>, A>
// finds Vec's method, `s.trim()` on a String finds str's (autoderef).
pub trait Deref {
    type Target:? Sized;

    fn deref(&self) -> &Self::Target;
}

// `*x = v` and `&mut *x`, and `&mut self` methods through autoderef.
pub trait DerefMut: Deref {
    fn deref_mut(&mut self) -> &mut Self::Target;
}

// `c[i]` as a place that is read: `*c.index(i)`. Vec, slices and arrays
// are indexed by the compiler (by usize and by ranges); a user type
// implements Index. Out of bounds panics, as `c.index` says.
pub trait Index<Idx:? Sized> {
    type Output:? Sized;

    fn index(&self, index: Idx) -> &Self::Output;
}

// `c[i] = v` and `&mut c[i]`.
pub trait IndexMut<Idx:? Sized>: Index<Idx> {
    fn index_mut(&mut self, index: Idx) -> &mut Self::Output;
}

// What runs when a value goes out of scope (not on a panic: decision 18).
// `drop` cannot be called by hand: `std::mem::drop(x)` ends x early.
pub trait Drop {
    fn drop(&mut self);
}

// `a + b`. MVS's Add (`fn add(self, other: Self) -> Self`) becomes
// Rust's, with a right-hand type and an Output (so `String + &str`).
// std2: changed: Rust's shape, Rhs and Output
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait Add<Rhs = Self> {
    type Output;

    fn add(self, rhs: Rhs) -> Self::Output;
}

// `a - b`.
// std2: changed: Rust's shape, Rhs and Output
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait Sub<Rhs = Self> {
    type Output;

    fn sub(self, rhs: Rhs) -> Self::Output;
}

// `a * b`.
// std2: changed: Rust's shape, Rhs and Output
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait Mul<Rhs = Self> {
    type Output;

    fn mul(self, rhs: Rhs) -> Self::Output;
}

// `a / b`.
// std2: changed: Rust's shape, Rhs and Output
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait Div<Rhs = Self> {
    type Output;

    fn div(self, rhs: Rhs) -> Self::Output;
}

// `a % b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait Rem<Rhs = Self> {
    type Output;

    fn rem(self, rhs: Rhs) -> Self::Output;
}

// `-a`.
// std2: changed: Rust's shape, an Output
#[builtin_impls(i8, i16, i32, i64, isize, f32, f64)]
pub trait Neg {
    type Output;

    fn neg(self) -> Self::Output;
}

// `!a`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait Not {
    type Output;

    fn not(self) -> Self::Output;
}

// `a & b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait BitAnd<Rhs = Self> {
    type Output;

    fn bitand(self, rhs: Rhs) -> Self::Output;
}

// `a | b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait BitOr<Rhs = Self> {
    type Output;

    fn bitor(self, rhs: Rhs) -> Self::Output;
}

// `a ^ b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait BitXor<Rhs = Self> {
    type Output;

    fn bitxor(self, rhs: Rhs) -> Self::Output;
}

// `a << b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]
pub trait Shl<Rhs = Self> {
    type Output;

    fn shl(self, rhs: Rhs) -> Self::Output;
}

// `a >> b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]
pub trait Shr<Rhs = Self> {
    type Output;

    fn shr(self, rhs: Rhs) -> Self::Output;
}

// `a += b` (String's `s += "x"` grows s from its own allocator).
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait AddAssign<Rhs = Self> {
    fn add_assign(&mut self, rhs: Rhs);
}

// `a -= b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait SubAssign<Rhs = Self> {
    fn sub_assign(&mut self, rhs: Rhs);
}

// `a *= b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait MulAssign<Rhs = Self> {
    fn mul_assign(&mut self, rhs: Rhs);
}

// `a /= b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait DivAssign<Rhs = Self> {
    fn div_assign(&mut self, rhs: Rhs);
}

// `a %= b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]
pub trait RemAssign<Rhs = Self> {
    fn rem_assign(&mut self, rhs: Rhs);
}

// `a &= b`, `a |= b`, `a ^= b`, `a <<= b`, `a >>= b`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait BitAndAssign<Rhs = Self> {
    fn bitand_assign(&mut self, rhs: Rhs);
}

#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait BitOrAssign<Rhs = Self> {
    fn bitor_assign(&mut self, rhs: Rhs);
}

#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait BitXorAssign<Rhs = Self> {
    fn bitxor_assign(&mut self, rhs: Rhs);
}

#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]
pub trait ShlAssign<Rhs = Self> {
    fn shl_assign(&mut self, rhs: Rhs);
}

#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]
pub trait ShrAssign<Rhs = Self> {
    fn shr_assign(&mut self, rhs: Rhs);
}

// ---- Ranges ----

// `start..end`: start included, end not. An iterator over integers and
// chars (std::iter's Step); a slice index (`&v[1..3]`).
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct Range<Idx> {
    pub start: Idx,
    pub end: Idx,
}

impl<Idx: PartialOrd<Idx>> Range<Idx> {
    // Whether start <= item < end.
    pub fn contains<U>(&self, item: &U) -> bool
        where
            Idx: PartialOrd<U>,
            U:? Sized + PartialOrd<Idx>,
    {
        *item >= self.start && *item < self.end
    }

    // Whether it holds nothing: !(start < end).
    pub fn is_empty(&self) -> bool {
        !(self.start < self.end)
    }
}

// `start..=end`: both ends included. Its fields are private, as Rust's: it
// remembers whether it is exhausted, so that `0..=u8::MAX` ends.
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeInclusive<Idx> {
    start: Idx,
    end: Idx,
    exhausted: bool,
}

impl<Idx> RangeInclusive<Idx> {
    // `start..=end`.
    pub fn new(start: Idx, end: Idx) -> RangeInclusive<Idx> {
        RangeInclusive { start: start, end: end, exhausted: false }
    }

    pub fn start(&self) -> &Idx {
        &self.start
    }

    pub fn end(&self) -> &Idx {
        &self.end
    }

    // (start, end).
    pub fn into_inner(self) -> (Idx, Idx) {
        (self.start, self.end)
    }
}

impl<Idx: PartialOrd<Idx>> RangeInclusive<Idx> {
    // Whether start <= item <= end.
    pub fn contains<U>(&self, item: &U) -> bool
        where
            Idx: PartialOrd<U>,
            U:? Sized + PartialOrd<Idx>,
    {
        *item >= self.start && *item <= self.end
    }

    // Whether it holds nothing: exhausted, or end < start.
    pub fn is_empty(&self) -> bool {
        self.exhausted || !(self.start <= self.end)
    }
}

// `start..`: from start on (a slice's tail, `&s[3..]`).
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeFrom<Idx> {
    pub start: Idx,
}

// `..end`: up to end, not included.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub struct RangeTo<Idx> {
    pub end: Idx,
}

// `..=end`: up to end, included.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub struct RangeToInclusive<Idx> {
    pub end: Idx,
}

// `..`: everything (`&v[..]`).
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub struct RangeFull;

// One end of a range, as RangeBounds gives it.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum Bound<T> {
    Included(T),
    Excluded(T),
    Unbounded,
}

// Any range, for what takes one (`v.drain(1..)`, `s.replace_range(..3, "x")`).
pub trait RangeBounds<T:? Sized> {
    fn start_bound(&self) -> Bound<&T>;
    fn end_bound(&self) -> Bound<&T>;

    // Whether item is in the range.
    fn contains<U>(&self, item: &U) -> bool
        where
            T: PartialOrd<U>,
            U:? Sized + PartialOrd<T>,
    {
        (match self.start_bound() {
            Bound::Included(s) => *s <= *item,
            Bound::Excluded(s) => *s < *item,
            Bound::Unbounded => true,
        }) && (match self.end_bound() {
            Bound::Included(e) => *item <= *e,
            Bound::Excluded(e) => *item < *e,
            Bound::Unbounded => true,
        })
    }
}

impl<T> RangeBounds<T> for Range<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Included(&self.start)
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Excluded(&self.end)
    }
}

impl<T> RangeBounds<T> for RangeInclusive<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Included(&self.start)
    }

    fn end_bound(&self) -> Bound<&T> {
        if self.exhausted { Bound::Excluded(&self.end) } else { Bound::Included(&self.end) }
    }
}

impl<T> RangeBounds<T> for RangeFrom<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Included(&self.start)
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }
}

impl<T> RangeBounds<T> for RangeTo<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Excluded(&self.end)
    }
}

impl<T> RangeBounds<T> for RangeToInclusive<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Included(&self.end)
    }
}

impl<T:? Sized> RangeBounds<T> for RangeFull {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }
}
