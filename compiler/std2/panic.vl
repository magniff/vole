// EDITION: rust
// std::panic: panic, assert and the other functions Rust spells as
// macros (vole has none: plan §3). A panic formats its message into a
// fixed buffer, truncating it, so it never allocates and is callable
// from #[no_alloc] code; it then exits with 101, with no unwinding
// (decisions 5 and 18). A message is a format literal (`panic("bad
// {x}")`): the compiler checks it and builds its Display value
// (`edition.later: format_fns`); the default parameters are std's own.

use crate::cmp::PartialEq;
use crate::fmt::{Debug, Display};

// UNSAFE: C's abort, the spec's way out until the compiler's panic path
// (format_fns) writes the message and exits with 101.
// SAFETY: abort takes nothing and does not return.
extern "C" {
    fn abort() -> !;
}

// Ends the program with msg on stderr, the caller's place and exit 101.
// MVS's panic (a C string, unsafe) and panic_str are gone into it.
// mvs: panic_str, panic
// std2: renamed
// later: format_fns
pub fn panic<M: Display>(msg: M) -> ! {
    // UNSAFE: the extern call above.
    // SAFETY: abort has no precondition.
    unsafe { abort() }
}

// Panics when ok is false, with msg.
// later: format_fns
pub fn assert(ok: bool, msg: &str = "") {
    if !ok {
        panic(msg);
    }
}

// Panics when a != b, showing both.
// std2: changed: by reference, Rust's assert_eq
// later: format_fns
pub fn assert_eq<T: PartialEq + Debug +? Sized>(a: &T, b: &T, msg: &str = "") {
    crate::panic::todo()
}

// Panics when a == b, showing both.
// std2: changed: by reference, Rust's assert_ne
// later: format_fns
pub fn assert_ne<T: PartialEq + Debug +? Sized>(a: &T, b: &T, msg: &str = "") {
    crate::panic::todo()
}

// assert, only in debug builds (-O0, or with debug assertions).
// later: format_fns
pub fn debug_assert(ok: bool, msg: &str = "") {
    crate::panic::todo()
}

// Code that cannot be reached: panics if it is.
// std2: changed: a format literal for its message
// later: format_fns
pub fn unreachable(msg: &str = "") -> ! {
    panic(msg)
}

// Code not written yet: panics with "not yet implemented". The spec
// tree's bodies are this. Until format_fns the message is a &str: a
// type parameter is not fixed by its default argument.
// later: format_fns
pub fn todo(msg: &str = "") -> ! {
    panic("not yet implemented")
}

// Code that will not be written: panics with "not implemented".
// later: format_fns
pub fn unimplemented(msg: &str = "") -> ! {
    panic("not implemented")
}
