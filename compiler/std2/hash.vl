// A reference hashes as what it refers to.
impl<T: Hash +? Sized> Hash for &T {
    fn hash<H: Hasher>(&self, state: &mut H) {
        (**self).hash(state)
    }
}

impl<T: Hash +? Sized> Hash for &mut T {
    fn hash<H: Hasher>(&self, state: &mut H) {
        (**self).hash(state)
    }
}

impl Hash for () {
    fn hash<H: Hasher>(&self, state: &mut H) {}
}
