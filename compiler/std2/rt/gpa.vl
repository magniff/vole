// EDITION: rust
// Gpa's implementation (Z5): C's malloc. Not a module of std2's tree:
// compiler/std/embed.sh --edition rust embeds it as std2_gpa_source, and
// the compiler's tail (front/stdalloc.vl: std2_tail) puts it in
// `std::__gpa` unless --check-alloc asks for the checking allocator
// (rt/alloc_check.vl). alloc.vl's `impl Allocator for Gpa` calls these.

use crate::alloc::{AllocError, Layout};
use crate::option::Option;
use crate::ptr::NonNull;
use crate::result::Result;

// UNSAFE: C's heap, under Gpa.
// SAFETY: malloc and posix_memalign return a block of at least size bytes
// (null when out of memory), aligned to 16 or to align; free takes what
// they returned, once. The functions below keep to that.
extern "C" {
    #[link_name = "malloc"]
    fn gpa_c_malloc(size: usize) -> *mut u8;
    #[link_name = "posix_memalign"]
    fn gpa_c_posix_memalign(out: *mut *mut u8, align: usize, size: usize) -> i32;
    #[link_name = "free"]
    fn gpa_c_free(p: *mut u8);
}

// A block for layout: from malloc (posix_memalign above 16), or a
// dangling aligned pointer for size 0 (Rust's Global).
pub fn allocate(layout: Layout) -> Result<NonNull<u8>, AllocError> {
    if layout.size() == 0 {
        // UNSAFE: an address made a pointer (an integer-to-pointer cast).
        // SAFETY: it is never read or written: a zero-size block.
        return match NonNull::new(unsafe { layout.align() as *mut u8 }) {
            Option::Some(p) => Result::Ok(p),
            Option::None => Result::Err(AllocError {}),
        };
    }
    // UNSAFE: C's heap.
    // SAFETY: malloc and posix_memalign take any size; posix_memalign's
    // align is a power of two (Layout's) and at least a word (above 16
    // only), and it writes p only on success.
    let p = unsafe {
        if layout.align() <= 16 {
            gpa_c_malloc(layout.size())
        } else {
            let mut out: *mut u8 = crate::ptr::null_mut();
            if gpa_c_posix_memalign(&mut out, layout.align(), layout.size()) == 0 {
                out
            } else {
                crate::ptr::null_mut()
            }
        }
    };
    match NonNull::new(p) {
        Option::Some(p) => Result::Ok(p),
        Option::None => Result::Err(AllocError {}),
    }
}

// Gives block p (of layout) back to C's heap.
// UNSAFE: p must be a block allocate gave, with this layout, not yet given
// back.
// SAFETY: a contract on the caller (Allocator::deallocate's).
pub unsafe fn deallocate(p: NonNull<u8>, layout: Layout) {
    if layout.size() != 0 {
        // UNSAFE: C's free.
        // SAFETY: the caller's contract: p came from malloc or
        // posix_memalign, once.
        unsafe { gpa_c_free(p.as_ptr()) }
    }
}

// Without --check-alloc no block is counted.
pub fn live_blocks() -> usize {
    0
}

pub fn check_leaks() -> bool {
    true
}
