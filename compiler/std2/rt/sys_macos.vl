// EDITION: rust
// The target's system for std2 (macOS): what differs between the C
// libraries. Not a module of std2's tree: compiler/std/embed.sh --edition
// rust embeds it and rt/sys_linux.vl as std2_sys_source, and the
// compiler's tail (front/stdalloc.vl: std2_tail) puts the target's in
// `std::__sys`. std::env calls these.

// UNSAFE: C. SAFETY: crt_externs.h's prototypes.
extern "C" {
    #[link_name = "_NSGetArgc"]
    fn sys_c_argc() -> *mut i32;
    #[link_name = "_NSGetArgv"]
    fn sys_c_argv() -> *mut *mut *mut u8;
    #[link_name = "_NSGetEnviron"]
    fn sys_c_environ() -> *mut *mut *mut u8;
}

// The program's arguments: argc, and argv, crt's NUL-ended C strings,
// valid for the whole program. macOS: crt's own, which _NSGetArgc and
// _NSGetArgv point to.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn args() -> (usize, *const *const u8) {
    // UNSAFE: reads crt's argc and argv through the pointers it gives.
    // SAFETY: crt sets both before main and keeps them for the program;
    // the pointers are to its own statics.
    unsafe { (*sys_c_argc() as usize, *sys_c_argv() as *const *const u8) }
}

// C's environment: a null-ended array of NUL-ended `NAME=value` strings,
// as it is now (setenv may replace it). macOS: crt's, through
// _NSGetEnviron.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn environ() -> *const *const u8 {
    // UNSAFE: reads crt's environ through the pointer it gives.
    // SAFETY: the pointer is to crt's own static, set before main.
    unsafe { *sys_c_environ() as *const *const u8 }
}

// C's CLOCK_MONOTONIC, std::time::Instant's clock.
pub const CLOCK_MONOTONIC: i32 = 6;

// (0.27.6) The system: 0 macOS, 1 Linux, as MVS's std::TARGET_OS
// (std::TARGET_OS, std2_tail).
pub const TARGET_OS: i64 = 0;

// (0.27.6) mmap's flags, <sys/mman.h>'s: an anonymous mapping, and one
// that reserves no swap (base's sources' region,
// docs/design/src-buffer.md).
pub const MAP_ANON: i32 = 0x1000;
pub const MAP_NORESERVE: i32 = 0x40;

// std::fs's numbers (<sys/fcntl.h>, <sys/errno.h>, <sys/syslimits.h>).
pub const O_CREAT: i32 = 0x200;
pub const O_TRUNC: i32 = 0x400;
pub const O_APPEND: i32 = 0x8;
pub const O_EXCL: i32 = 0x800;
pub const O_CLOEXEC: i32 = 0x1000000;
pub const ENAMETOOLONG: i32 = 63;
pub const PATH_MAX: usize = 1024;
// struct dirent: d_type's offset, d_name's (<sys/dirent.h>, 64-bit inodes).
pub const DIRENT_TYPE: usize = 20;
pub const DIRENT_NAME: usize = 21;

// UNSAFE: C. SAFETY: errno.h's prototype: this thread's errno's address.
extern "C" {
    #[link_name = "__error"]
    fn sys_c_error() -> *mut i32;
}

// This thread's errno, for a call that says "failed" only through it
// (readdir).
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn errno_location() -> *mut i32 {
    // UNSAFE: C. SAFETY: __error takes nothing and returns a valid pointer.
    unsafe { sys_c_error() }
}

// What std::fs reads of a struct stat (arm64, 64-bit inodes: st_mode a
// u16 at byte 4, st_mtimespec at 48, st_size at 96), from the words stat
// wrote: (st_mode, st_size, mtime's seconds, its nanoseconds).
#[effects()]
pub fn stat_fields(w: &[u64; 20]) -> (u32, u64, i64, i64) {
    (((w[0] >> 32) & 0xffff) as u32, w[12], w[6] as i64, w[7] as i64)
}

// A signal's name, as std::process's ExitStatus prints it (<sys/signal.h>);
// "" for a number this system does not name.
#[effects()]
pub fn signal_name(sig: i32) -> &'static str {
    match sig {
        1 => "SIGHUP",
        2 => "SIGINT",
        3 => "SIGQUIT",
        4 => "SIGILL",
        5 => "SIGTRAP",
        6 => "SIGABRT",
        7 => "SIGEMT",
        8 => "SIGFPE",
        9 => "SIGKILL",
        10 => "SIGBUS",
        11 => "SIGSEGV",
        12 => "SIGSYS",
        13 => "SIGPIPE",
        14 => "SIGALRM",
        15 => "SIGTERM",
        16 => "SIGURG",
        17 => "SIGSTOP",
        18 => "SIGTSTP",
        19 => "SIGCONT",
        20 => "SIGCHLD",
        21 => "SIGTTIN",
        22 => "SIGTTOU",
        23 => "SIGIO",
        24 => "SIGXCPU",
        25 => "SIGXFSZ",
        26 => "SIGVTALRM",
        27 => "SIGPROF",
        28 => "SIGWINCH",
        29 => "SIGINFO",
        30 => "SIGUSR1",
        31 => "SIGUSR2",
        _ => "",
    }
}

// (0.28.0) std::sys's numbers, as MVS's std::sys had them (its SYS_*
// constants): <sys/fcntl.h>, <sys/errno.h>, <sys/signal.h>, <sys/ttycom.h>.
pub const O_NONBLOCK: i32 = 0x4;
pub const O_NOCTTY: i32 = 0x20000;
pub const O_DIRECTORY: i32 = 0x100000;
pub const EAGAIN: i32 = 35;
pub const ENOTEMPTY: i32 = 66;
pub const ETIMEDOUT: i32 = 60;
pub const ENOSYS: i32 = 78;
pub const ENOTSUP: i32 = 45;
pub const ELOOP: i32 = 62;
pub const SIGCHLD: i32 = 20;
pub const TIOCSWINSZ: u64 = 0x80087467;
pub const TIOCGWINSZ: u64 = 0x40087468;
pub const TIOCSCTTY: u64 = 0x20007461;

// UNSAFE: C. SAFETY: string.h's prototype of the XSI strerror_r
// (strerror_r): it writes at most n bytes, its NUL included, at buf.
extern "C" {
    #[link_name = "strerror_r"]
    fn sys_c_strerror_r(e: i32, buf: *mut u8, n: usize) -> i32;
}

// C's message for errno e, into buf (NUL-ended, cut to fit): 0, or an
// errno (std::sys::sys_strerror_into calls it).
// UNSAFE: C writes through a raw pointer.
// SAFETY: (the caller's) buf points to n writable bytes.
pub unsafe fn strerror_r(e: i32, buf: *mut u8, n: usize) -> i32 {
    sys_c_strerror_r(e, buf, n)
}
