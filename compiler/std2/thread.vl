// EDITION: rust
// std::thread: scoped threads, spawned threads, and the thread's own
// queries. `thread::scope` is the safe way to share a borrow with
// threads: every thread spawned in the scope is joined before it returns,
// so they may borrow what outlives the scope ('env). It allocates
// nothing of its own. `spawn_in(f, a)` runs a 'static closure on a thread
// of its own, its closure and result kept on a (plan §2: MVS's spawn
// allocated through C, unnamed). A panic in any thread ends the process
// with 101 (decision 18), so `join` never returns an Err; it returns a
// Result anyway, so that `.join().unwrap()` reads as in Rust.

use crate::alloc::Allocator;
use crate::fmt::{Debug, Formatter};
use crate::marker::PhantomData;

// join's result: never an Err in vole (a panic exits the process).
pub type Result<T> = crate::result::Result<T, JoinError>;

// A thread's panic, as join would report it: no value is ever made.
#[derive(Debug)]
pub struct JoinError {
    never: crate::convert::Infallible,
}

// Runs f with a Scope, joins every thread spawned in it, and returns f's
// value. Each region in f's argument is elided, so it is late-bound (no
// `for<'a>`, cut to 0.29): the scope's region 'scope cannot be named
// outside f, and Scope is invariant in it, so a thread cannot borrow a
// local of f's body (plan §4, threads).
// std2: changed: FnOnce(&Scope<'_, 'env>) (MVS: FnMut(inout Scope))
pub fn scope<'env, F, T>(f: F) -> T
    where
        F: FnOnce(&Scope<'_, 'env>) -> T,
{
    crate::panic::todo()
}

// The scope threads are spawned in. 'scope is the scope's own region
// ('env outlives it); invariant in both, as Rust's.
// std2: changed: two regions, invariant
pub struct Scope<'scope, 'env: 'scope> {
    threads: crate::cell::Cell<usize>,
    scope: PhantomData<&'scope mut &'scope ()>,
    env: PhantomData<&'env mut &'env ()>,
}

impl<'scope, 'env> Scope<'scope, 'env> {
    // Runs f on a new thread, joined at the latest when the scope ends;
    // f may borrow anything that outlives 'scope. `&self`, not Rust's
    // `&'scope self`: scope's argument elides its two regions separately,
    // so the reference may be shorter than 'scope; the bound F: 'scope,
    // with Scope invariant in 'scope, is what keeps f's borrows alive.
    // std2: changed: &self, FnOnce, Send, a 'scope bound (MVS: inout self, FnMut)
    // later: auto_trait
    pub fn spawn<F, T>(&self, f: F) -> ScopedJoinHandle<'scope, T>
        where
            F: FnOnce() -> T + Send + 'scope,
            T: Send + 'scope,
    {
        crate::panic::todo()
    }
}

// A scoped thread: join waits for its value.
// std2: changed: a region 'scope
pub struct ScopedJoinHandle<'scope, T> {
    native: u64,
    result: *mut crate::option::Option<T>,
    scope: PhantomData<&'scope ()>,
}

impl<'scope, T> ScopedJoinHandle<'scope, T> {
    // Waits for the thread and returns its value (always Ok).
    // std2: changed: a thread::Result
    pub fn join(self) -> Result<T> {
        crate::panic::todo()
    }

    // Whether the thread has finished (join would not wait).
    pub fn is_finished(&self) -> bool {
        crate::panic::todo()
    }
}

// Runs f on a new thread of its own; its closure and its result live on
// a until join (or the handle's drop, which detaches it).
