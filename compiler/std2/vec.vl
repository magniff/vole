// EDITION: rust
// std::vec: Vec<T, A>, a growable array on A's heap. A is always written
// (`Vec<u8, Gpa>`, `Vec<Tok<'s>, &'a Arena<Gpa>>`: plan §2.0 rule 2);
// `Vec::new_in(a)`, `Vec::with_capacity_in(n, a)`, `Vec::from_in([..], a)`.
// What a Vec shares with every slice (get, first, iter, sort_unstable,
// contains, ...) is [T]'s, reached through Deref: `v.get(i)` is
// `Option<&T>`, `v.iter()` yields `&T`. Vec's own methods are the ones
// that change its length or its storage, and allocate from its A only:
// push, extend, clone and the stable sorts.

use crate::alloc::{Allocator, Layout, TryReserveError};
use crate::borrow::{Borrow, BorrowMut};
use crate::clone::Clone;
use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::convert::{AsMut, AsRef};
use crate::default::DefaultIn;
use crate::fmt::{Debug, Formatter};
use crate::hash::{Hash, Hasher};
use crate::iter::{
    DoubleEndedIterator, ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator,
};
use crate::marker::PhantomData;
use crate::ops::{Bound, Deref, DerefMut, Drop, Index, IndexMut, RangeBounds};
use crate::option::Option;
use crate::ptr::NonNull;
use crate::result::Result;
use crate::slice::{Iter, IterMut, SliceIndex};

// A contiguous, growable array of T on A. Its elements are dropped and its
// block freed when it is.
pub struct Vec<T, A: Allocator> {
    ptr: NonNull<T>,
    cap: usize,
    len: usize,
    alloc: A,
}

impl<T, A: Allocator> Vec<T, A> {
    // An empty Vec on a; it allocates at its first push.
    pub fn new_in(a: A) -> Vec<T, A> {
        // A zero-sized T never allocates: its capacity is unbounded.
        let cap = if crate::mem::size_of::<T>() == 0 { usize::MAX } else { 0 };
        Vec { ptr: NonNull::dangling(), cap: cap, len: 0, alloc: a }
    }

    // An empty Vec on a with room for cap elements.
    pub fn with_capacity_in(cap: usize, a: A) -> Vec<T, A> {
        let mut v = Vec::new_in(a);
        v.reserve_exact(cap);
        v
    }

    // A Vec of the array's elements, moved, on a (`Vec::from_in([1, 2, 3],
    // gpa)`, Rust's `vec![1, 2, 3]`). Compiler-provided for every length N
    // until const generics (plan §6): `#[array_builtin(N)]` names the
    // length, and the compiler makes the item for each N a program uses.
    // later: array_builtin
    #[array_builtin(N)]
    pub fn from_in(items: [T; N], a: A) -> Vec<T, A> {
        let mut v = Vec::with_capacity_in(N, a);
        for x in items {
            v.push(x);
        }
        v
    }

    // A Vec of its parts: a pointer from a Vec on an allocator equal to a,
    // its length and its capacity.
    // UNSAFE: the parts must be a Vec's, as Rust's from_raw_parts_in.
    // SAFETY: a contract on the caller: ptr allocated by a for cap T's,
    // the first len initialized.
    pub unsafe fn from_raw_parts_in(ptr: *mut T, len: usize, cap: usize, a: A) -> Vec<T, A> {
        match NonNull::new(ptr) {
            Option::Some(p) => Vec { ptr: p, cap: cap, len: len, alloc: a },
            Option::None => crate::panic::panic("Vec::from_raw_parts_in: a null pointer"),
        }
    }

    // Element i's address (i <= cap: in the block or one past it).
    fn slot(&self, i: usize) -> *mut T {
        // UNSAFE: pointer arithmetic on the block.
        // SAFETY: every caller has i <= cap, so the address is inside the
        // block or one past its end; nothing is read here.
        unsafe { self.ptr.add(i).as_ptr() }
    }

    // The block's layout (cap T's; T not zero-sized, cap > 0).
    fn layout(&self) -> Layout {
        match Layout::array::<T>(self.cap) {
            Result::Ok(l) => l,
            Result::Err(_) => crate::panic::unreachable(),
        }
    }

    // Makes the block hold new_cap T's (new_cap > cap).
    fn grow_to(&mut self, new_cap: usize) -> Result<(), TryReserveError> {
        if crate::mem::size_of::<T>() == 0 {
            // Its capacity is usize::MAX already: only an overflow comes here.
            return Result::Err(TryReserveError::CapacityOverflow);
        }
        let new_layout = match Layout::array::<T>(new_cap) {
            Result::Ok(l) => l,
            Result::Err(_) => return Result::Err(TryReserveError::CapacityOverflow),
        };
        let got = if self.cap == 0 {
            self.alloc.allocate(new_layout)
        } else {
            // UNSAFE: grows A's block.
            // SAFETY: ptr is the block A gave for layout() (cap > 0, T not
            // zero-sized) and new_layout is larger with the same alignment.
            unsafe { self.alloc.grow(self.ptr.cast::<u8>(), self.layout(), new_layout) }
        };
        match got {
            Result::Ok(p) => {
                self.ptr = p.cast::<T>();
                self.cap = new_cap;
                Result::Ok(())
            }
            Result::Err(_) => Result::Err(TryReserveError::AllocError { layout: new_layout }),
        }
    }

    pub fn len(&self) -> usize {
        self.len
    }

    pub fn is_empty(&self) -> bool {
        self.len == 0
    }

    // How many elements fit before it reallocates.
    pub fn capacity(&self) -> usize {
        self.cap
    }

    // The allocator it grows into.
    // std2: changed: returns &A (MVS: a copy of A)
    pub fn allocator(&self) -> &A {
        &self.alloc
    }

    // Room for extra more elements (at least: it may take more).
    pub fn reserve(&mut self, extra: usize) {
        if let Result::Err(e) = self.try_reserve(extra) {
            capacity_error(e);
        }
    }

    // Room for exactly extra more.
    pub fn reserve_exact(&mut self, extra: usize) {
        if self.cap - self.len >= extra {
            return;
        }
        if extra > usize::MAX - self.len {
            capacity_error(TryReserveError::CapacityOverflow);
        }
        if let Result::Err(e) = self.grow_to(self.len + extra) {
            capacity_error(e);
        }
    }

    // reserve, with the error instead of a panic.
    // std2: changed: takes usize, returns TryReserveError (MVS: i64, AllocError)
    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {
        if self.cap - self.len >= extra {
            return Result::Ok(());
        }
        if extra > usize::MAX - self.len {
            return Result::Err(TryReserveError::CapacityOverflow);
        }
        // Amortized: at least double, at least 4.
        let doubled = if self.cap > usize::MAX / 2 { usize::MAX } else { self.cap * 2 };
        let new_cap = crate::cmp::max(crate::cmp::max(self.len + extra, doubled), 4);
        self.grow_to(new_cap)
    }

    // Gives back the room beyond its length.
    pub fn shrink_to_fit(&mut self) {
        self.shrink_to(0)
    }

    // Gives back the room beyond max(its length, min_capacity).
    pub fn shrink_to(&mut self, min_capacity: usize) {
        let target = crate::cmp::max(self.len, min_capacity);
        if self.cap <= target || crate::mem::size_of::<T>() == 0 {
            return;
        }
        let old = self.layout();
        if target == 0 {
            // UNSAFE: gives the block back to A.
            // SAFETY: cap > 0 and T is not zero-sized, so ptr is the block A
            // gave for old; it is not used again (ptr is reset below).
            unsafe { self.alloc.deallocate(self.ptr.cast::<u8>(), old) };
            self.ptr = NonNull::dangling();
            self.cap = 0;
            return;
        }
        let new_layout = match Layout::array::<T>(target) {
            Result::Ok(l) => l,
            Result::Err(_) => crate::panic::unreachable(),
        };
        // UNSAFE: shrinks A's block.
        // SAFETY: ptr is the block A gave for old, and new_layout is smaller
        // (target < cap) with the same alignment; the first len elements fit.
        match unsafe { self.alloc.shrink(self.ptr.cast::<u8>(), old, new_layout) } {
            Result::Ok(p) => {
                self.ptr = p.cast::<T>();
                self.cap = target;
            }
            Result::Err(_) => capacity_error(TryReserveError::AllocError { layout: new_layout }),
        }
    }

    // Appends x, growing from A when it is full.
    pub fn push(&mut self, x: T) {
        if self.len == self.cap {
            self.reserve(1);
        }
        // UNSAFE: writes past the initialized part.
        // SAFETY: len < cap here, so slot len is room in the block; len counts
        // it right after.
        unsafe { crate::ptr::write(self.slot(self.len), x) };
        self.len += 1;
    }

    // The last element, moved out; None when empty.
    pub fn pop(&mut self) -> Option<T> {
        if self.len == 0 {
            return Option::None;
        }
        self.len -= 1;
        // UNSAFE: moves the last element out.
        // SAFETY: slot len was initialized and is no longer counted, so it is
        // read once.
        Option::Some(unsafe { crate::ptr::read(self.slot(self.len)) })
    }

    // Inserts x at i, moving the ones after it up; panics when i > len.
    pub fn insert(&mut self, i: usize, x: T) {
        let n = self.len;
        if i > n {
            crate::panic::panic("insertion index (is {}) should be <= len (is {})", i, n);
        }
        if n == self.cap {
            self.reserve(1);
        }
        // UNSAFE: moves [i, n) up one and writes x at i.
        // SAFETY: n < cap, so [i + 1, n + 1) is in the block; ptr::copy allows
        // the overlap; slot i is then written once and len counts it.
        unsafe {
            let p = self.slot(i);
            crate::ptr::copy(p, self.slot(i + 1), n - i);
            crate::ptr::write(p, x);
        }
        self.len = n + 1;
    }

    // Removes element i, moving the ones after it down; panics when out of
    // bounds.
    pub fn remove(&mut self, i: usize) -> T {
        let n = self.len;
        if i >= n {
            crate::panic::panic("removal index (is {}) should be < len (is {})", i, n);
        }
        // UNSAFE: moves element i out and [i + 1, n) down one.
        // SAFETY: i < n: slot i is initialized and read once; the moved range is
        // initialized; len then drops the duplicated last slot.
        unsafe {
            let p = self.slot(i);
            let x = crate::ptr::read(p);
            crate::ptr::copy(self.slot(i + 1), p, n - i - 1);
            self.len = n - 1;
            x
        }
    }

    // Removes element i, putting the last one in its place: O(1), the
    // order not kept.
    pub fn swap_remove(&mut self, i: usize) -> T {
        let n = self.len;
        if i >= n {
            crate::panic::panic("swap_remove index (is {}) should be < len (is {})", i, n);
        }
        // UNSAFE: moves element i out and the last element into its slot.
        // SAFETY: i < n: both slots are initialized; the last is no longer
        // counted, so each value is owned once (i == n - 1 copies onto itself).
        unsafe {
            let x = crate::ptr::read(self.slot(i));
            crate::ptr::copy(self.slot(n - 1), self.slot(i), 1);
            self.len = n - 1;
            x
        }
    }

    // Keeps the first n elements, dropping the rest.
    pub fn truncate(&mut self, n: usize) {
        let old = self.len;
        if n >= old {
            return;
        }
        self.len = n;
        let mut i = n;
        while i < old {
            // UNSAFE: drops the elements past the new length.
            // SAFETY: [n, old) was initialized and is no longer counted: each is
            // read (and dropped) once.
            crate::mem::drop(unsafe { crate::ptr::read(self.slot(i)) });
            i += 1;
        }
    }

    // Drops every element; the capacity stays.
    pub fn clear(&mut self) {
        self.truncate(0)
    }

    // Its elements as a slice (`&v[..]`, or Deref).
    pub fn as_slice(&self) -> &[T] {
        let p = self.ptr.as_ptr();
        // UNSAFE: a slice of the block.
        // SAFETY: the first len elements are initialized; the slice borrows self.
        unsafe { &p[0..self.len] }
    }

    // std2: changed: returns &mut [T] (MVS: an inout view)
    pub fn as_mut_slice(&mut self) -> &mut [T] {
        let p = self.ptr.as_ptr();
        // UNSAFE: a &mut slice of the block.
        // SAFETY: the first len elements are initialized; the slice borrows self
        // mutably, so nothing else reaches them.
        unsafe { &mut p[0..self.len] }
    }

    pub fn as_ptr(&self) -> *const T {
        self.ptr.as_ptr() as *const T
    }

    pub fn as_mut_ptr(&mut self) -> *mut T {
        self.ptr.as_ptr()
    }

    // Sets its length, nothing dropped or initialized.
    // UNSAFE: the first n elements must be initialized and n <= capacity.
    // SAFETY: a contract on the caller, as Rust's set_len.
    pub unsafe fn set_len(&mut self, n: usize) {
        self.len = n;
    }

    // Keeps the elements f says true of, in order.
    // std2: changed: FnMut(&T) (MVS: a let T)
    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {
        let mut f = f;
        self.retain_mut(|x| f(&*x))
    }

    // retain, with each element given as &mut.
    pub fn retain_mut<F: FnMut(&mut T) -> bool>(&mut self, f: F) {
        let mut f = f;
        let n = self.len;
        let mut kept: usize = 0;
        let mut i: usize = 0;
        while i < n {
            if f(&mut self.as_mut_slice()[i]) {
                if kept != i {
                    self.as_mut_slice().swap(kept, i);
                }
                kept += 1;
            }
            i += 1;
        }
        self.truncate(kept);
    }

    // Removes consecutive elements with the same key (f's), keeping the first.
    // mvs: dedup_by_key
    // std2: changed: Vec's method (MVS: a free function over a slice)
    pub fn dedup_by_key<K: PartialEq, F: FnMut(&mut T) -> K>(&mut self, key: F) {
        let mut key = key;
        self.dedup_by(|a, b| key(a) == key(b))
    }

    // Removes consecutive elements that same_bucket(a, b) says are equal.
    // mvs: dedup_by
    // std2: changed: Vec's method (MVS: a free function over a slice)
    pub fn dedup_by<F: FnMut(&mut T, &mut T) -> bool>(&mut self, same_bucket: F) {
        let mut same = same_bucket;
        let n = self.len;
        if n < 2 {
            return;
        }
        // [0, w) is kept; element r is compared with the last kept one.
        let mut w: usize = 1;
        let mut r: usize = 1;
        while r < n {
            let (head, tail) = self.as_mut_slice().split_at_mut(r);
            if !same(&mut tail[0], &mut head[w - 1]) {
                if w != r {
                    self.as_mut_slice().swap(w, r);
                }
                w += 1;
            }
            r += 1;
        }
        self.truncate(w);
    }

    // Moves every element of other to its end, leaving other empty.
    pub fn append(&mut self, other: &mut Vec<T, A>) {
        let m = other.len;
        self.reserve(m);
        // UNSAFE: moves other's elements to the end of self's block.
        // SAFETY: reserve made room for m more; the two blocks are distinct
        // (&mut self and &mut other); other's length is set to 0 so each value
        // is owned once.
        unsafe { crate::ptr::copy_nonoverlapping(other.slot(0), self.slot(self.len), m) };
        self.len += m;
        other.len = 0;
    }

    // The elements in range, removed and yielded by the iterator; the
    // rest closes up when it is dropped.
    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, T, A> {
        let n = self.len;
        let (start, end) = range_of(&range, n);
        // While the Drain lives the Vec holds [0, start); its drop moves the
        // tail [end, n) down.
        self.len = start;
        let vec = match NonNull::new(self as *mut Vec<T, A>) {
            Option::Some(p) => p,
            Option::None => crate::panic::unreachable(),
        };
        Drain {
            vec: vec, start: start, end: end, tail: end, tail_len: n - end, marker: PhantomData,
        }
    }

    // The elements from at on, as a new Vec on a clone of A.
    pub fn split_off(&mut self, at: usize) -> Vec<T, A>
        where
            A: Clone,
    {
        let n = self.len;
        if at > n {
            crate::panic::panic("`at` split index (is {}) should be <= len (is {})", at, n);
        }
        let mut other = Vec::with_capacity_in(n - at, self.alloc.clone());
        // UNSAFE: moves [at, n) into other's block.
        // SAFETY: other has room for n - at; the blocks are distinct; self's
        // length drops to at, so each value is owned once.
        unsafe { crate::ptr::copy_nonoverlapping(self.slot(at), other.slot(0), n - at) };
        other.len = n - at;
        self.len = at;
        other
    }

    // Its length made n: new elements are f()'s.
    pub fn resize_with<F: FnMut() -> T>(&mut self, n: usize, f: F) {
        let mut f = f;
        if n <= self.len {
            self.truncate(n);
            return;
        }
        self.reserve(n - self.len);
        while self.len < n {
            self.push(f());
        }
    }

    // The elements, never freed: a &mut slice that lives as long as A's memory.
    pub fn leak<'a>(self) -> &'a mut [T]
        where
            A: 'a,
    {
        let p = self.ptr.as_ptr();
        let n = self.len;
        crate::mem::forget(self);
        // UNSAFE: a &mut slice of a block nothing frees.
        // SAFETY: the Vec is forgotten, so the block and its first n
        // initialized elements stay as long as A's memory ('a); only this
        // slice reaches them.
        unsafe { &mut p[0..n] }
    }

    // Moves the Vec out, leaving an empty one on a clone of its allocator
    // (vole's: a Vec has no Default, so `mem::take` does not apply).
    // std2: changed: needs A: Clone
    pub fn take(&mut self) -> Vec<T, A>
        where
            A: Clone,
    {
        let a = self.alloc.clone();
        crate::mem::replace(self, Vec::new_in(a))
    }

    // Sorts it, stable (equal elements keep their order), with scratch from
    // its own A: Rust's `sort`. MVS's sort was unstable: it is
    // `sort_unstable` now ([T]'s, allocates nothing).
    // std2: changed: stable, scratch from A (MVS: unstable)
    pub fn sort(&mut self)
        where
            T: Ord,
    {
        self.sort_by(|a, b| a.cmp(b))
    }

    // sort, by a comparison.
    // mvs: Vec::sort_by, [T]::sort_by, sort_by
    // std2: changed: stable, an Ordering (MVS: unstable, an i64)
    pub fn sort_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {
        let p = self.ptr.as_ptr();
        // UNSAFE: the elements as a &mut slice while the allocator is borrowed
        // for the scratch: two disjoint parts of self the checker sees as one.
        // SAFETY: the slice covers the initialized elements only and the sort
        // does not touch self.alloc but through &A.
        let s = unsafe { &mut p[0..self.len] };
        s.sort_by_in(compare, &self.alloc)
    }

    // sort, by a key.
    // std2: changed: stable, FnMut(&T) (MVS: unstable, a let T)
    pub fn sort_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {
        let mut f = f;
        self.sort_by(|a, b| f(a).cmp(&f(b)))
    }
}

impl<T: Clone, A: Allocator> Vec<T, A> {
    // A Vec of n clones of x on a (Rust's `vec![x; n]`, its order).
    // mvs: Vec::filled_in
    // std2: renamed
    pub fn from_elem_in(x: T, n: usize, a: A) -> Vec<T, A> {
        let mut v = Vec::with_capacity_in(n, a);
        v.resize(n, x);
        v
    }

    // Appends clones of s's elements.
    pub fn extend_from_slice(&mut self, s: &[T]) {
        self.reserve(s.len());
        let mut i: usize = 0;
        while i < s.len() {
            self.push(s[i].clone());
            i += 1;
        }
    }

    // Appends clones of the elements in src (its own elements).
    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {
        let (start, end) = range_of(&src, self.len);
        self.reserve(end - start);
        let mut i = start;
        while i < end {
            let x = self.as_slice()[i].clone();
            self.push(x);
            i += 1;
        }
    }

    // Its length made n: new elements are clones of x.
    pub fn resize(&mut self, n: usize, x: T) {
        if n <= self.len {
            self.truncate(n);
            return;
        }
        self.reserve(n - self.len);
        while self.len + 1 < n {
            self.push(x.clone());
        }
        self.push(x);
    }

    // A copy on another allocator.
    pub fn clone_in<B: Allocator>(&self, b: B) -> Vec<T, B> {
        let mut v = Vec::with_capacity_in(self.len, b);
        v.extend_from_slice(self.as_slice());
        v
    }
}

impl<T: PartialEq, A: Allocator> Vec<T, A> {
    // Removes consecutive equal elements, keeping the first.
    // mvs: dedup
    // std2: changed: Vec's method (MVS: a free function over a slice)
    pub fn dedup(&mut self) {
        self.dedup_by(|a, b| *a == *b)
    }
}

impl<T, A: Allocator> Drop for Vec<T, A> {
    fn drop(&mut self) {
        self.truncate(0);
        if self.cap != 0 && crate::mem::size_of::<T>() != 0 {
            // UNSAFE: gives the block back to A.
            // SAFETY: cap > 0 and T is not zero-sized: ptr is the block A gave
            // for layout(); the elements are dropped already.
            unsafe { self.alloc.deallocate(self.ptr.cast::<u8>(), self.layout()) };
        }
    }
}

impl<T, A: Allocator> Deref for Vec<T, A> {
    type Target = [T];

    fn deref(&self) -> &[T] {
        self.as_slice()
    }
}

impl<T, A: Allocator> DerefMut for Vec<T, A> {
    fn deref_mut(&mut self) -> &mut [T] {
        self.as_mut_slice()
    }
}

// `v[i]` and `&v[a..b]`: built in for Vec in 0.27.0; this is the trait's.
impl<T, I: SliceIndex<[T]>, A: Allocator> Index<I> for Vec<T, A> {
    type Output = I::Output;

    fn index(&self, index: I) -> &I::Output {
        index.index(self.as_slice())
    }
}

impl<T, I: SliceIndex<[T]>, A: Allocator> IndexMut<I> for Vec<T, A> {
    fn index_mut(&mut self, index: I) -> &mut I::Output {
        index.index_mut(self.as_mut_slice())
    }
}

// A copy on the same allocator (a clone of it): plan §2.0, `Clone`
// reuses the stored allocator.
// std2: changed: needs A: Clone
impl<T: Clone, A: Allocator + Clone> Clone for Vec<T, A> {
    fn clone(&self) -> Vec<T, A> {
        self.clone_in(self.alloc.clone())
    }
}

// mvs: Vec::impl Eq
// std2: changed: PartialEq against any Vec<U, B>
impl<T: PartialEq<U>, U, A: Allocator, B: Allocator> PartialEq<Vec<U, B>> for Vec<T, A> {
    fn eq(&self, other: &Vec<U, B>) -> bool {
        self.as_slice() == other.as_slice()
    }
}

impl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U]> for Vec<T, A> {
    fn eq(&self, other: &[U]) -> bool {
        self.as_slice() == other
    }
}

impl<T: PartialEq<U>, U, A: Allocator> PartialEq<&[U]> for Vec<T, A> {
    fn eq(&self, other: &&[U]) -> bool {
        self.as_slice() == *other
    }
}

// Compiler-provided for every N (array_builtin, as from_in).
// later: array_builtin
#[array_builtin(N)]
impl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U; N]> for Vec<T, A> {
    fn eq(&self, other: &[U; N]) -> bool {
        self.as_slice() == &other[..]
    }
}

impl<T: Eq, A: Allocator> Eq for Vec<T, A> {}

impl<T: PartialOrd, A: Allocator> PartialOrd for Vec<T, A> {
    fn partial_cmp(&self, other: &Vec<T, A>) -> Option<Ordering> {
        self.as_slice().partial_cmp(other.as_slice())
    }
}

impl<T: Ord, A: Allocator> Ord for Vec<T, A> {
    fn cmp(&self, other: &Vec<T, A>) -> Ordering {
        self.as_slice().cmp(other.as_slice())
    }
}

// The elements' hashes, as the slice's: the same for any A.
impl<T: Hash, A: Allocator> Hash for Vec<T, A> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_slice().hash(state)
    }
}

// `[1, 2, 3]`.
impl<T: Debug, A: Allocator> Debug for Vec<T, A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        self.as_slice().fmt(f)
    }
}

impl<T, A: Allocator> AsRef<[T]> for Vec<T, A> {
    fn as_ref(&self) -> &[T] {
        self.as_slice()
    }
}

impl<T, A: Allocator> AsMut<[T]> for Vec<T, A> {
    fn as_mut(&mut self) -> &mut [T] {
        self.as_mut_slice()
    }
}

impl<T, A: Allocator> Borrow<[T]> for Vec<T, A> {
    fn borrow(&self) -> &[T] {
        self.as_slice()
    }
}

impl<T, A: Allocator> BorrowMut<[T]> for Vec<T, A> {
    fn borrow_mut(&mut self) -> &mut [T] {
        self.as_mut_slice()
    }
}

// An empty Vec on a (`map.entry(k).or_default()` for Vec values).
impl<T, A: Allocator> DefaultIn<A> for Vec<T, A> {
    fn default_in(a: A) -> Vec<T, A> {
        Vec::new_in(a)
    }
}

impl<T, A: Allocator> Extend<T> for Vec<T, A> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.push(x);
        }
    }
}

impl<'a, T: Copy + 'a, A: Allocator> Extend<&'a T> for Vec<T, A> {
    fn extend<I: IntoIterator<Item = &'a T>>(&mut self, iter: I) {
        for x in iter {
            self.push(*x);
        }
    }
}

// `iter.collect_in(a)` into a Vec.
impl<T, A: Allocator> FromIteratorIn<T, A> for Vec<T, A> {
    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Vec<T, A> {
        let mut v = Vec::new_in(a);
        v.extend(iter);
        v
    }
}

// `for x in v`: the elements, moved out.
impl<T, A: Allocator> IntoIterator for Vec<T, A> {
    type Item = T;
    type IntoIter = IntoIter<T, A>;

    fn into_iter(self) -> IntoIter<T, A> {
        let v = self;
        let buf = v.ptr;
        let cap = v.cap;
        let len = v.len;
        // UNSAFE: moves the allocator out of a value whose Drop is not run.
        // SAFETY: v is forgotten right after, so the allocator is owned once
        // (by the IntoIter), as are the block and the elements.
        let alloc = unsafe { crate::ptr::read(&v.alloc as *const A) };
        crate::mem::forget(v);
        IntoIter { buf: buf, cap: cap, start: 0, end: len, alloc: alloc }
    }
}

// `for x in &v`: &T's.
impl<'a, T, A: Allocator> IntoIterator for &'a Vec<T, A> {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.iter()
    }
}

// `for x in &mut v`: &mut T's.
impl<'a, T, A: Allocator> IntoIterator for &'a mut Vec<T, A> {
    type Item = &'a mut T;
    type IntoIter = IterMut<'a, T>;

    fn into_iter(self) -> IterMut<'a, T> {
        self.iter_mut()
    }
}

// reserve's failure: a panic, as Rust's (vole has no abort hook).
fn capacity_error(e: TryReserveError) -> ! {
    match e {
        TryReserveError::CapacityOverflow => crate::panic::panic("capacity overflow"),
        TryReserveError::AllocError { layout } => {
            crate::panic::panic("memory allocation of {} bytes failed", layout.size())
        }
    }
}

// A RangeBounds as [start, end) within 0..n; panics when it is not.
fn range_of<R: RangeBounds<usize>>(r: &R, n: usize) -> (usize, usize) {
    let start = match r.start_bound() {
        Bound::Included(s) => *s,
        Bound::Excluded(s) => *s + 1,
        Bound::Unbounded => 0,
    };
    let end = match r.end_bound() {
        Bound::Included(e) => *e + 1,
        Bound::Excluded(e) => *e,
        Bound::Unbounded => n,
    };
    if start > end {
        crate::panic::panic("slice index starts at {} but ends at {}", start, end);
    }
    if end > n {
        crate::panic::panic("range end index {} out of range for slice of length {}", end, n);
    }
    (start, end)
}

// A Vec's elements, by value; what is left is dropped with it.
pub struct IntoIter<T, A: Allocator> {
    buf: NonNull<T>,
    cap: usize,
    start: usize,
    end: usize,
    alloc: A,
}

impl<T, A: Allocator> IntoIter<T, A> {
    // What is left, as a slice.
    pub fn as_slice(&self) -> &[T] {
        let p = self.buf.as_ptr();
        // UNSAFE: a slice of the block.
        // SAFETY: [start, end) is the initialized part not yet yielded.
        unsafe { &p[self.start..self.end] }
    }
}

impl<T, A: Allocator> Iterator for IntoIter<T, A> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        if self.start == self.end {
            return Option::None;
        }
        // UNSAFE: moves element start out.
        // SAFETY: start < end: it is initialized and, start moving past it, read once.
        let x = unsafe { crate::ptr::read(self.buf.add(self.start).as_ptr()) };
        self.start += 1;
        Option::Some(x)
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.end - self.start, Option::Some(self.end - self.start))
    }
}

impl<T, A: Allocator> DoubleEndedIterator for IntoIter<T, A> {
    fn next_back(&mut self) -> Option<T> {
        if self.start == self.end {
            return Option::None;
        }
        self.end -= 1;
        // UNSAFE: moves element end out.
        // SAFETY: it was in [start, end) and, end moving below it, is read once.
        Option::Some(unsafe { crate::ptr::read(self.buf.add(self.end).as_ptr()) })
    }
}

impl<T, A: Allocator> ExactSizeIterator for IntoIter<T, A> {}

impl<T, A: Allocator> Drop for IntoIter<T, A> {
    fn drop(&mut self) {
        while self.start < self.end {
            // UNSAFE: drops the elements not yielded.
            // SAFETY: [start, end) is initialized and each is read once.
            crate::mem::drop(unsafe { crate::ptr::read(self.buf.add(self.start).as_ptr()) });
            self.start += 1;
        }
        if self.cap != 0 && crate::mem::size_of::<T>() != 0 {
            let layout = match Layout::array::<T>(self.cap) {
                Result::Ok(l) => l,
                Result::Err(_) => crate::panic::unreachable(),
            };
            // UNSAFE: gives the Vec's block back to its allocator.
            // SAFETY: buf is the block the allocator gave for cap T's; no element
            // is left in it.
            unsafe { self.alloc.deallocate(self.buf.cast::<u8>(), layout) };
        }
    }
}

// Vec::drain's iterator: the removed elements; the Vec closes up when it
// is dropped.
pub struct Drain<'a, T, A: Allocator> {
    vec: NonNull<Vec<T, A>>,
    start: usize,
    end: usize,
    tail: usize,
    tail_len: usize,
    marker: PhantomData<&'a mut Vec<T, A>>,
}

impl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        if self.start == self.end {
            return Option::None;
        }
        // UNSAFE: the Vec reached through the Drain's pointer; element start
        // moved out.
        // SAFETY: the Drain holds the Vec's &mut for 'a; [start, end) is
        // initialized, past the Vec's length, and read once.
        let x = unsafe { crate::ptr::read(self.vec.as_mut().slot(self.start)) };
        self.start += 1;
        Option::Some(x)
    }
}

impl<'a, T, A: Allocator> DoubleEndedIterator for Drain<'a, T, A> {
    fn next_back(&mut self) -> Option<T> {
        if self.start == self.end {
            return Option::None;
        }
        self.end -= 1;
        // UNSAFE: as next's.
        // SAFETY: as next's, for element end.
        Option::Some(unsafe { crate::ptr::read(self.vec.as_mut().slot(self.end)) })
    }
}

impl<'a, T, A: Allocator> ExactSizeIterator for Drain<'a, T, A> {}

impl<'a, T, A: Allocator> Drop for Drain<'a, T, A> {
    fn drop(&mut self) {
        // UNSAFE: the Vec reached through the Drain's pointer.
        // SAFETY: the Drain holds the Vec's &mut for 'a.
        let v = unsafe { self.vec.as_mut() };
        while self.start < self.end {
            // UNSAFE: drops the drained elements not yielded.
            // SAFETY: [start, end) is initialized and each is read once.
            crate::mem::drop(unsafe { crate::ptr::read(v.slot(self.start)) });
            self.start += 1;
        }
        let len = v.len;
        if self.tail_len > 0 && self.tail != len {
            // UNSAFE: moves the tail down to the Vec's length.
            // SAFETY: [tail, tail + tail_len) is initialized and inside the
            // block; ptr::copy allows the overlap; len then counts it.
            unsafe { crate::ptr::copy(v.slot(self.tail), v.slot(len), self.tail_len) };
        }
        v.len = len + self.tail_len;
    }
}
