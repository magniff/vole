// EDITION: rust
// std::mem: moving values in and out of places, and the sizes of types.
// size_of, align_of and needs_drop are evaluated by the compiler; the
// others are plain functions over `&mut T`.

use crate::default::Default;

// Exchanges the values of two places (MVS: two inout parameters).
// std2: changed: takes &mut T twice
pub fn swap<T>(a: &mut T, b: &mut T) {
    crate::panic::todo()
}

// Moves src into dest and returns dest's old value.
// std2: changed: takes &mut T
pub fn replace<T>(dest: &mut T, src: T) -> T {
    crate::panic::todo()
}

// Moves dest's value out, leaving its Default (`take(&mut v)` on an
// allocator-free type; a Vec has no Default, and Vec::take, inherent,
// leaves an empty Vec on a clone of its allocator).
// std2: changed: takes &mut T
pub fn take<T: Default>(dest: &mut T) -> T {
    replace(dest, T::default())
}

// Ends x's life here: its Drop runs now, not at the end of its scope.
pub fn drop<T>(x: T) {}

// Ends x's life without running its Drop: what it owns is leaked (unless
// something else frees it). Safe, as in Rust: a leak is not undefined.
pub fn forget<T>(x: T) {
    crate::panic::todo()
}

// The size of a T in bytes, padding included (built in).
pub fn size_of<T>() -> usize {
    crate::panic::todo()
}

// The alignment of a T in bytes (built in).
pub fn align_of<T>() -> usize {
    crate::panic::todo()
}

// The size of the value x refers to (for str and [T], from its length).
pub fn size_of_val<T:? Sized>(x: &T) -> usize {
    crate::panic::todo()
}

// Whether dropping a T runs code: a Drop impl, or a part with one. For a
// container on an allocator that does not free (Allocator::FREES false:
// an arena, a FixedBuf), only its elements count (plan §9.1): an arena's
// `alloc(x)` takes a T for which this is false (built in).
pub fn needs_drop<T:? Sized>() -> bool {
    crate::panic::todo()
}
