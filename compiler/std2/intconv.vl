// EDITION: rust
// Generated by tools/std2-intconv.py (do not edit): the integers' TryFrom
// impls and from_str_radix, which Rust's std writes with macros.
//
// `T::try_from(x)` of an integer x: Ok when x is one of T's values, else
// Err(TryFromIntError), as Rust's. A conversion that cannot fail (Rust has
// `From` for it, and Infallible for its TryFrom's error) has the error
// type TryFromIntError here too, and is always Ok: `{:?}` of a
// Result<T, Infallible> does not compile yet (its Err arm is refused as
// unreachable). usize and isize are 64 bits. One generic impl over a
// private trait of the ten types does it.
//
// `T::from_str_radix(s, radix)`: s as a T in radix (2 to 36, else a panic):
// an optional `+` (or `-`, for a signed type), then digits (`a`-`z` and
// `A`-`Z` are 10 to 35), nothing else; the errors are `s.parse::<T>()`'s.

use crate::convert::{TryFrom, TryFromIntError};
use crate::result::Result;
use crate::str::{IntErrorKind, ParseIntError};

// The value of s in radix, as its 64 bits (two's complement for a negative
// one): at most `pos` when positive, and, for a signed type, at most `neg`
// in magnitude when negative.
#[effects(io, panic, diverge)]
fn parse_radix(s: &str, radix: u32, signed: bool, pos: u64, neg: u64) -> Result<u64,
    ParseIntError> {
    if radix < 2 || radix > 36 {
        crate::panic::panic("from_str_radix: the radix must lie in the range `[2, 36]`");
    }
    let b = s.as_bytes();
    if b.len() == 0 {
        return Result::Err(crate::str::int_error(IntErrorKind::Empty));
    }
    let mut i: usize = 0;
    let mut negative = false;
    if b[0] == b'+' {
        i = 1;
    } else if b[0] == b'-' && signed {
        negative = true;
        i = 1;
    }
    if i == b.len() {
        return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));
    }
    let limit = if negative { neg } else { pos };
    let r = radix as u64;
    let mut acc: u64 = 0;
    while i < b.len() {
        let c = b[i];
        let d: u64 = if c >= b'0' && c <= b'9' {
            (c - b'0') as u64
        } else if c >= b'a' && c <= b'z' {
            (c - b'a') as u64 + 10
        } else if c >= b'A' && c <= b'Z' {
            (c - b'A') as u64 + 10
        } else {
            36
        };
        if d >= r {
            return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));
        }
        // (acc * r + d <= limit, without overflow: d < r <= 36 <= limit)
        if acc > (limit - d) / r {
            return Result::Err(crate::str::int_error(if negative { IntErrorKind::NegOverflow }
                else { IntErrorKind::PosOverflow }));
        }
        acc = acc * r + d;
        i += 1;
    }
    Result::Ok(if negative { (!acc).wrapping_add(1) } else { acc })
}

impl i8 {
    #[effects(io, panic, diverge)]
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i8, ParseIntError> {
        match parse_radix(src, radix, true, 127, 128) {
            Result::Ok(v) => Result::Ok(v as i8),
            Result::Err(e) => Result::Err(e),
        }
    }
}

