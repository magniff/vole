// Every pair of integer types (one impl, not a hundred: the lazy std keeps
// an impl of a trait for a primitive type in every program).
impl<S: IntBits, T: IntBits> TryFrom<S> for T {
    type Error = TryFromIntError;

    fn try_from(x: S) -> Result<T, TryFromIntError> {
        let (v, negative_kind) = x.int_bits();
        // (T's range: is it signed? its -1 has the top bit of 64 set)
        let (_, signed) = T::int_from(0).int_bits();
        let width = 8 * crate::mem::size_of::<T>() as u64;
        // (its largest value: width - 1 ones when signed, width ones when not)
        let max: u64 = if signed { (1u64 << (width - 1)) - 1 }
            else if width == 64 { 0xffffffffffffffff }
            else { (1u64 << width) - 1 };
        if negative_kind && (v as i64) < 0 {
            // (its smallest: -(max + 1) when signed, 0 when not)
            if !signed || (v as i64) < -(max as i64) - 1 {
                return Result::Err(crate::convert::int_range_error(true));
            }
        } else if v > max {
            return Result::Err(crate::convert::int_range_error(false));
        }
        Result::Ok(T::int_from(v))
    }
}

// std::num::Wrapping<T> (0.28.0), as Rust's: an integer T whose `+`, `-`,
// `*`, `/`, `%`, unary `-` and shifts wrap at T's width instead of
// panicking (a shift's count is taken modulo the width; `/` and `%` by zero
// still panic); `!`, `&`, `|`, `^`; each with its assignment (`+=` takes a
// Wrapping<T> or a T); Display, Debug and the radix formats are T's; Sum
// and Product. The arithmetic is done on the value's 64 bits (IntBits) and
// cut to T's width: one generic impl an operator, kept only by a program
// that names Wrapping. Not there: the impls for references (`&a + &b`), the
// constants MIN, MAX and BITS, to_be, to_le, from_be, from_le. abs, signum,
// is_positive and is_negative (Rust: signed T only) and is_power_of_two
// (Rust: unsigned T only) are there for every T.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Wrapping<T>(pub T);

// T's width in bits, and the mask of its bits in 64.
#[effects()]
fn wrap_width<T: IntBits>() -> (u64, u64) {
    let width = 8 * crate::mem::size_of::<T>() as u64;
    (width, if width == 64 { 0xffffffffffffffff } else { (1u64 << width) - 1 })
}

// T's value as its width's bits, zero-extended.
#[effects()]
fn wrap_bits<T: IntBits>(x: T) -> u64 {
    let (_, mask) = wrap_width::<T>();
    x.int_bits().0 & mask
}

