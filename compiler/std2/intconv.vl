// What the one TryFrom impl below reads of an integer type: std's own.
// (Two one-line methods a type: the lazy std keeps these impls in every
// program. The type's range comes from its size and whether it is signed.)
pub trait IntBits: Sized {
    // The value as 64 bits, sign-extended, and whether the type is signed.
    fn int_bits(self) -> (u64, bool);
    // The value of its width's low bits of v.
    fn int_from(v: u64) -> Self;
}

impl IntBits for i8 {
    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }
    fn int_from(v: u64) -> i8 { v as i8 }
}

impl IntBits for i16 {
    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }
    fn int_from(v: u64) -> i16 { v as i16 }
}

impl IntBits for i32 {
    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }
    fn int_from(v: u64) -> i32 { v as i32 }
}

impl IntBits for i64 {
    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }
    fn int_from(v: u64) -> i64 { v as i64 }
}

impl IntBits for isize {
    fn int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }
    fn int_from(v: u64) -> isize { v as isize }
}

impl IntBits for u8 {
    fn int_bits(self) -> (u64, bool) { (self as u64, false) }
    fn int_from(v: u64) -> u8 { v as u8 }
}

impl IntBits for u16 {
    fn int_bits(self) -> (u64, bool) { (self as u64, false) }
    fn int_from(v: u64) -> u16 { v as u16 }
}

impl IntBits for u32 {
    fn int_bits(self) -> (u64, bool) { (self as u64, false) }
    fn int_from(v: u64) -> u32 { v as u32 }
}

impl IntBits for u64 {
    fn int_bits(self) -> (u64, bool) { (self, false) }
    fn int_from(v: u64) -> u64 { v }
}

impl IntBits for usize {
    fn int_bits(self) -> (u64, bool) { (self as u64, false) }
    fn int_from(v: u64) -> usize { v as usize }
}

// Every pair of integer types (one impl, not a hundred: the lazy std keeps
// an impl of a trait for a primitive type in every program).
impl<S: IntBits, T: IntBits> TryFrom<S> for T {
    type Error = TryFromIntError;

    fn try_from(x: S) -> Result<T, TryFromIntError> {
        let (v, negative_kind) = x.int_bits();
        // (T's range: is it signed? its -1 has the top bit of 64 set)
        let (_, signed) = T::int_from(0).int_bits();
        let width = 8 * crate::mem::size_of::<T>() as u64;
        // (its largest value: width - 1 ones when signed, width ones when not)
        let max: u64 = if signed { (1u64 << (width - 1)) - 1 }
            else if width == 64 { 0xffffffffffffffff }
            else { (1u64 << width) - 1 };
        if negative_kind && (v as i64) < 0 {
            // (its smallest: -(max + 1) when signed, 0 when not)
            if !signed || (v as i64) < -(max as i64) - 1 {
                return Result::Err(crate::convert::int_range_error(true));
            }
        } else if v > max {
            return Result::Err(crate::convert::int_range_error(false));
        }
        Result::Ok(T::int_from(v))
    }
}
