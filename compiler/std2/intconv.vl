// The value of s in radix, as its 64 bits (two's complement for a negative
// one): at most `pos` when positive, and, for a signed type, at most `neg`
// in magnitude when negative.
fn parse_radix(s: &str, radix: u32, signed: bool, pos: u64, neg: u64) -> Result<u64,
    ParseIntError> {
    if radix < 2 || radix > 36 {
        crate::panic::panic("from_str_radix: the radix must lie in the range `[2, 36]`");
    }
    let b = s.as_bytes();
    if b.len() == 0 {
        return Result::Err(crate::str::int_error(IntErrorKind::Empty));
    }
    let mut i: usize = 0;
    let mut negative = false;
    if b[0] == b'+' {
        i = 1;
    } else if b[0] == b'-' && signed {
        negative = true;
        i = 1;
    }
    if i == b.len() {
        return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));
    }
    let limit = if negative { neg } else { pos };
    let r = radix as u64;
    let mut acc: u64 = 0;
    while i < b.len() {
        let c = b[i];
        let d: u64 = if c >= b'0' && c <= b'9' {
            (c - b'0') as u64
        } else if c >= b'a' && c <= b'z' {
            (c - b'a') as u64 + 10
        } else if c >= b'A' && c <= b'Z' {
            (c - b'A') as u64 + 10
        } else {
            36
        };
        if d >= r {
            return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));
        }
        // (acc * r + d <= limit, without overflow: d < r <= 36 <= limit)
        if acc > (limit - d) / r {
            return Result::Err(crate::str::int_error(if negative { IntErrorKind::NegOverflow }
                else { IntErrorKind::PosOverflow }));
        }
        acc = acc * r + d;
        i += 1;
    }
    Result::Ok(if negative { (!acc).wrapping_add(1) } else { acc })
}

