// EDITION: rust
// std::option: Option<T>, Rust's API. `Some` and `None` are in the
// prelude. What MVS's Option had is kept, with Rust's receivers; what
// references make possible is new: `as_ref` and `as_mut` (an Option of a
// reference into self), `take`, `insert` and `get_or_insert` (a &mut T
// into self), and `copied` and `cloned` on an Option<&T>.

use crate::clone::Clone;
use crate::default::Default;
use crate::iter::{IntoIterator, Iterator};
use crate::ops::{Deref, DerefMut};
use crate::option::Option::{None, Some};
use crate::result::Result;

// A value or nothing.
// mvs: Option, Option::impl Clone, Option::impl Debug
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Option<T> {
    None,
    Some(T),
}

impl<T> Option<T> {
    pub fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }

    // Some and f(the value).
    // std2: changed: FnOnce(T) -> bool (Rust's)
    pub fn is_some_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {
        match self {
            Some(x) => f(x),
            None => false,
        }
    }

    pub fn is_none(&self) -> bool {
        !self.is_some()
    }

    // None, or f(the value).
    pub fn is_none_or<F: FnOnce(T) -> bool>(self, f: F) -> bool {
        match self {
            Some(x) => f(x),
            None => true,
        }
    }

    // An Option of a reference to the value: look without moving it out
    // (`if let Some(n) = opt.as_ref()`).
    pub fn as_ref(&self) -> Option<&T> {
        match self {
            Some(x) => Some(x),
            None => None,
        }
    }

    // An Option of a &mut to the value: change it in place.
    pub fn as_mut(&mut self) -> Option<&mut T> {
        match self {
            Some(x) => Some(x),
            None => None,
        }
    }

    // The value; panics with msg when None.
    // later: format_fns
    pub fn expect(self, msg: &str) -> T {
        match self {
            Some(x) => x,
            None => crate::panic::panic(msg),
        }
    }

    // The value; panics when None.
    pub fn unwrap(self) -> T {
        match self {
            Some(x) => x,
            None => crate::panic::panic("called `Option::unwrap()` on a `None` value"),
        }
    }

    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(x) => x,
            None => default,
        }
    }

    // std2: changed: FnOnce (MVS: Fn)
    pub fn unwrap_or_else<F: FnOnce() -> T>(self, f: F) -> T {
        match self {
            Some(x) => x,
            None => f(),
        }
    }

    // The value, or T's Default.
    pub fn unwrap_or_default(self) -> T
        where
            T: Default,
    {
        match self {
            Some(x) => x,
            None => T::default(),
        }
    }

    // The value, with no check.
    // UNSAFE: None here is undefined.
    // SAFETY: a contract on the caller: self is Some.
    pub unsafe fn unwrap_unchecked(self) -> T {
        match self {
            Some(x) => x,
            None => crate::panic::unreachable("unwrap_unchecked on None"),
        }
    }

    // std2: changed: FnOnce (MVS: Fn(sink T))
    pub fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Option<U> {
        match self {
            Some(x) => Some(f(x)),
            None => None,
        }
    }

    // Calls f on a reference to the value, then gives self back.
    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Option<T> {
        if let Some(x) = &self {
            f(x);
        }
        self
    }

    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {
        match self {
            Some(x) => f(x),
            None => default,
        }
    }

    pub fn map_or_else<U, D: FnOnce() -> U, F: FnOnce(T) -> U>(self, default: D, f: F) -> U {
        match self {
            Some(x) => f(x),
            None => default(),
        }
    }

    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Some(x) => Result::Ok(x),
            None => Result::Err(err),
        }
    }

    pub fn ok_or_else<E, F: FnOnce() -> E>(self, err: F) -> Result<T, E> {
        match self {
            Some(x) => Result::Ok(x),
            None => Result::Err(err()),
        }
    }

    // An Option of the Deref target (`Option<String<A>>` to `Option<&str>`).
    pub fn as_deref(&self) -> Option<&T::Target>
        where
            T: Deref,
    {
        match self {
            Some(x) => Some(x.deref()),
            None => None,
        }
    }

    pub fn as_deref_mut(&mut self) -> Option<&mut T::Target>
        where
            T: DerefMut,
    {
        match self {
            Some(x) => Some(x.deref_mut()),
            None => None,
        }
    }

    // An iterator over the value: one item or none.
    pub fn iter(&self) -> Iter<'_, T> {
        Iter { inner: self.as_ref() }
    }

    pub fn iter_mut(&mut self) -> IterMut<'_, T> {
        IterMut { inner: self.as_mut() }
    }

    // None if self is None, else optb.
    pub fn and<U>(self, optb: Option<U>) -> Option<U> {
        match self {
            Some(_) => optb,
            None => None,
        }
    }

    // std2: changed: FnOnce (MVS: Fn(sink T))
    pub fn and_then<U, F: FnOnce(T) -> Option<U>>(self, f: F) -> Option<U> {
        match self {
            Some(x) => f(x),
            None => None,
        }
    }

    // Some only when predicate holds for the value.
    pub fn filter<P: FnOnce(&T) -> bool>(self, predicate: P) -> Option<T> {
        if let Some(x) = self {
            if predicate(&x) {
                return Some(x);
            }
        }
        None
    }

    pub fn or(self, optb: Option<T>) -> Option<T> {
        match self {
            Some(x) => Some(x),
            None => optb,
        }
    }

    pub fn or_else<F: FnOnce() -> Option<T>>(self, f: F) -> Option<T> {
        match self {
            Some(x) => Some(x),
            None => f(),
        }
    }

    // Some when exactly one of the two is.
    pub fn xor(self, optb: Option<T>) -> Option<T> {
        match (self, optb) {
            (Some(a), None) => Some(a),
            (None, Some(b)) => Some(b),
            _ => None,
        }
    }

    // Stores value and returns a &mut to it.
    pub fn insert(&mut self, value: T) -> &mut T {
        *self = Some(value);
        match self {
            Some(x) => x,
            None => crate::panic::unreachable(),
        }
    }

    // The value, after storing value if self was None.
    pub fn get_or_insert(&mut self, value: T) -> &mut T {
        if self.is_none() {
            *self = Some(value);
        }
        match self {
            Some(x) => x,
            None => crate::panic::unreachable(),
        }
    }

    pub fn get_or_insert_with<F: FnOnce() -> T>(&mut self, f: F) -> &mut T {
        if self.is_none() {
            *self = Some(f());
        }
        match self {
            Some(x) => x,
            None => crate::panic::unreachable(),
        }
    }

    // Moves the value out, leaving None.
    pub fn take(&mut self) -> Option<T> {
        crate::mem::replace(self, None)
    }

    // take, when predicate holds for the value.
    pub fn take_if<P: FnOnce(&mut T) -> bool>(&mut self, predicate: P) -> Option<T> {
        let hit = match self.as_mut() {
            Some(x) => predicate(x),
            None => false,
        };
        if hit { self.take() } else { None }
    }

    // Stores value, returning the old one.
    pub fn replace(&mut self, value: T) -> Option<T> {
        crate::mem::replace(self, Some(value))
    }

    // Some((a, b)) when both are Some.
    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        match (self, other) {
            (Some(a), Some(b)) => Some((a, b)),
            _ => None,
        }
    }
}

// later: impl_on_instance
impl<T, U> Option<(T, U)> {
    pub fn unzip(self) -> (Option<T>, Option<U>) {
        match self {
            Some((a, b)) => (Some(a), Some(b)),
            None => (None, None),
        }
    }
}

// later: impl_on_instance
impl<T: Copy> Option<&T> {
    // An Option of a copy of the value (`v.get(i).copied()`).
    pub fn copied(self) -> Option<T> {
        match self {
            Some(&x) => Some(x),
            None => None,
        }
    }
}

// later: impl_on_instance
impl<T: Clone> Option<&T> {
    pub fn cloned(self) -> Option<T> {
        match self {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

// later: impl_on_instance
impl<T: Copy> Option<&mut T> {
    pub fn copied(self) -> Option<T> {
        match self {
            Some(&mut x) => Some(x),
            None => None,
        }
    }
}

// later: impl_on_instance
impl<T: Clone> Option<&mut T> {
    pub fn cloned(self) -> Option<T> {
        match self {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

// later: impl_on_instance
impl<T, E> Option<Result<T, E>> {
    // Some(Ok(x)) to Ok(Some(x)), and so on.
    pub fn transpose(self) -> Result<Option<T>, E> {
        match self {
            Some(Result::Ok(x)) => Result::Ok(Some(x)),
            Some(Result::Err(e)) => Result::Err(e),
            None => Result::Ok(None),
        }
    }
}

// later: impl_on_instance
impl<T> Option<Option<T>> {
    pub fn flatten(self) -> Option<T> {
        match self {
            Some(x) => x,
            None => None,
        }
    }
}

impl<T> Default for Option<T> {
    fn default() -> Option<T> {
        None
    }
}

impl<T> From<T> for Option<T> {
    fn from(value: T) -> Option<T> {
        Some(value)
    }
}

// The iterator of a &Option<T>: its value, once.
pub struct Iter<'a, T> {
    inner: Option<&'a T>,
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        self.inner.take()
    }
}

// The iterator of a &mut Option<T>.
pub struct IterMut<'a, T> {
    inner: Option<&'a mut T>,
}

impl<'a, T> Iterator for IterMut<'a, T> {
    type Item = &'a mut T;

    fn next(&mut self) -> Option<&'a mut T> {
        self.inner.take()
    }
}

// The iterator of an Option<T>, by value.
pub struct IntoIter<T> {
    inner: Option<T>,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        self.inner.take()
    }
}

impl<T> IntoIterator for Option<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;

    fn into_iter(self) -> IntoIter<T> {
        IntoIter { inner: self }
    }
}

impl<'a, T> IntoIterator for &'a Option<T> {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.iter()
    }
}

impl<'a, T> IntoIterator for &'a mut Option<T> {
    type Item = &'a mut T;
    type IntoIter = IterMut<'a, T>;

    fn into_iter(self) -> IterMut<'a, T> {
        self.iter_mut()
    }
}
