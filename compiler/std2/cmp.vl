// EDITION: rust
// std::cmp: PartialEq, Eq, PartialOrd, Ord and Ordering, Rust's shape.
// MVS's Eq (`eq(self, other: Self)`) and Ord (`cmp` returning an i64: <0,
// 0, >0) are gone into them: `==` is PartialEq::eq on two references, `<`
// is PartialOrd's, and floats are PartialOrd but not Ord (NaN). The
// numbers', bool's, char's and pointers' impls are built in; derive makes
// the others (`#[derive(PartialEq, Eq, PartialOrd, Ord)]`, field by field).

use crate::option::Option;

// `==` and `!=`. Not necessarily an equivalence (f64's NaN != NaN).
// mvs: Eq
// std2: changed: Rust's PartialEq, over references, with a right-hand type
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]
pub trait PartialEq<Rhs: ?Sized = Self> {
    // mvs: Eq::eq
    // std2: changed: takes &self and &Rhs
    fn eq(&self, other: &Rhs) -> bool;

    fn ne(&self, other: &Rhs) -> bool {
        !self.eq(other)
    }
}

// PartialEq that is an equivalence: every value equals itself. HashMap's
// keys need it.
// std2: changed: a marker over PartialEq (MVS's Eq had the method)
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait Eq: PartialEq<Self> {}

// The result of a comparison.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

impl Ordering {
    pub fn is_eq(self) -> bool {
        match self {
            Ordering::Equal => true,
            _ => false,
        }
    }

    pub fn is_ne(self) -> bool {
        !self.is_eq()
    }

    pub fn is_lt(self) -> bool {
        match self {
            Ordering::Less => true,
            _ => false,
        }
    }

    pub fn is_gt(self) -> bool {
        match self {
            Ordering::Greater => true,
            _ => false,
        }
    }

    pub fn is_le(self) -> bool {
        !self.is_gt()
    }

    pub fn is_ge(self) -> bool {
        !self.is_lt()
    }

    // Less for Greater and the other way round (`b.cmp(a)` from `a.cmp(b)`).
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }

    // self, or other when self is Equal: comparing by several keys,
    // `a.x.cmp(&b.x).then(a.y.cmp(&b.y))`.
    pub fn then(self, other: Ordering) -> Ordering {
        match self {
            Ordering::Equal => other,
            _ => self,
        }
    }

    // `then`, with the second comparison made only when needed.
    pub fn then_with<F: FnOnce() -> Ordering>(self, f: F) -> Ordering {
        match self {
            Ordering::Equal => f(),
            _ => self,
        }
    }
}

// `<`, `<=`, `>` and `>=`; None when the two are not comparable (NaN).
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]
pub trait PartialOrd<Rhs: ?Sized = Self>: PartialEq<Rhs> {
    fn partial_cmp(&self, other: &Rhs) -> Option<Ordering>;

    fn lt(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Option::Some(Ordering::Less) => true,
            _ => false,
        }
    }

    fn le(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Option::Some(Ordering::Less) | Option::Some(Ordering::Equal) => true,
            _ => false,
        }
    }

    fn gt(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Option::Some(Ordering::Greater) => true,
            _ => false,
        }
    }

    fn ge(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Option::Some(Ordering::Greater) | Option::Some(Ordering::Equal) => true,
            _ => false,
        }
    }
}

// A total order: what sorting, BinaryHeap and BTreeMap need.
// std2: changed: Rust's Ord, cmp returns an Ordering (MVS: an i64)
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]
pub trait Ord: Eq + PartialOrd<Self> {
    // std2: changed: takes &self and &Self, returns an Ordering
    fn cmp(&self, other: &Self) -> Ordering;

    fn max(self, other: Self) -> Self
        where
            Self: Sized,
    {
        if other.cmp(&self).is_lt() { self } else { other }
    }

    fn min(self, other: Self) -> Self
        where
            Self: Sized,
    {
        if other.cmp(&self).is_lt() { other } else { self }
    }

    // self within [min, max]; panics when min > max.
    // mvs: clamp
    // std2: changed: a method of Ord (MVS: the free function std::clamp)
    fn clamp(self, min: Self, max: Self) -> Self
        where
            Self: Sized,
    {
        if min.cmp(&max).is_gt() {
            crate::panic::panic("clamp: min > max");
        }
        if self.cmp(&min).is_lt() {
            min
        } else if self.cmp(&max).is_gt() {
            max
        } else {
            self
        }
    }
}

// The smaller of two; a when they are equal.
pub fn min<T: Ord>(a: T, b: T) -> T {
    a.min(b)
}

// The larger of two; b when they are equal.
pub fn max<T: Ord>(a: T, b: T) -> T {
    a.max(b)
}

// The smaller by a key (`min_by_key(a, b, |p| p.len())`).
pub fn min_by_key<T, K: Ord, F: FnMut(&T) -> K>(a: T, b: T, f: F) -> T {
    let mut f = f;
    if f(&b).cmp(&f(&a)).is_lt() { b } else { a }
}

// The larger by a key.
pub fn max_by_key<T, K: Ord, F: FnMut(&T) -> K>(a: T, b: T, f: F) -> T {
    let mut f = f;
    if f(&b).cmp(&f(&a)).is_lt() { a } else { b }
}

// T's order turned round: `v.sort_by_key(|x| Reverse(x.score))`.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug, Default)]
pub struct Reverse<T>(pub T);

impl<T: PartialOrd> PartialOrd for Reverse<T> {
    fn partial_cmp(&self, other: &Reverse<T>) -> Option<Ordering> {
        other.0.partial_cmp(&self.0)
    }
}

impl<T: Ord> Ord for Reverse<T> {
    fn cmp(&self, other: &Reverse<T>) -> Ordering {
        other.0.cmp(&self.0)
    }
}

// Tuples compare as Rust's do, field by field, left to right: equal
// when every field is, ordered by the first field that differs.
impl<A: PartialEq> PartialEq for (A,) {
    fn eq(&self, other: &(A,)) -> bool {
        self.0 == other.0
    }
}

impl<A: Eq> Eq for (A,) {}

impl<A: PartialOrd> PartialOrd for (A,) {
    fn partial_cmp(&self, other: &(A,)) -> Option<Ordering> {
        self.0.partial_cmp(&other.0)
    }
}

impl<A: Ord> Ord for (A,) {
    fn cmp(&self, other: &(A,)) -> Ordering {
        self.0.cmp(&other.0)
    }
}

impl<A: PartialEq, B: PartialEq> PartialEq for (A, B) {
    fn eq(&self, other: &(A, B)) -> bool {
        self.0 == other.0 && self.1 == other.1
    }
}

impl<A: Eq, B: Eq> Eq for (A, B) {}

impl<A: PartialOrd, B: PartialOrd> PartialOrd for (A, B) {
    fn partial_cmp(&self, other: &(A, B)) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        self.1.partial_cmp(&other.1)
    }
}

impl<A: Ord, B: Ord> Ord for (A, B) {
    fn cmp(&self, other: &(A, B)) -> Ordering {
        match self.0.cmp(&other.0) {
            Ordering::Equal => {}
            c => return c,
        }
        self.1.cmp(&other.1)
    }
}

impl<A: PartialEq, B: PartialEq, C: PartialEq> PartialEq for (A, B, C) {
    fn eq(&self, other: &(A, B, C)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2
    }
}

impl<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {}

impl<A: PartialOrd, B: PartialOrd, C: PartialOrd> PartialOrd for (A, B, C) {
    fn partial_cmp(&self, other: &(A, B, C)) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.1.partial_cmp(&other.1) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        self.2.partial_cmp(&other.2)
    }
}

impl<A: Ord, B: Ord, C: Ord> Ord for (A, B, C) {
    fn cmp(&self, other: &(A, B, C)) -> Ordering {
        match self.0.cmp(&other.0) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.1.cmp(&other.1) {
            Ordering::Equal => {}
            c => return c,
        }
        self.2.cmp(&other.2)
    }
}

impl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq> PartialEq for (A, B, C, D) {
    fn eq(&self, other: &(A, B, C, D)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3
    }
}

impl<A: Eq, B: Eq, C: Eq, D: Eq> Eq for (A, B, C, D) {}

impl<A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd> PartialOrd for (A, B, C, D) {
    fn partial_cmp(&self, other: &(A, B, C, D)) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.1.partial_cmp(&other.1) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.2.partial_cmp(&other.2) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        self.3.partial_cmp(&other.3)
    }
}

impl<A: Ord, B: Ord, C: Ord, D: Ord> Ord for (A, B, C, D) {
    fn cmp(&self, other: &(A, B, C, D)) -> Ordering {
        match self.0.cmp(&other.0) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.1.cmp(&other.1) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.2.cmp(&other.2) {
            Ordering::Equal => {}
            c => return c,
        }
        self.3.cmp(&other.3)
    }
}

impl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq, E: PartialEq> PartialEq for (A, B, C,
    D, E) {
    fn eq(&self, other: &(A, B, C, D, E)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3
            && self.4 == other.4
    }
}

impl<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq> Eq for (A, B, C, D, E) {}

impl<A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd, E: PartialOrd> PartialOrd for (A,
    B, C, D, E) {
    fn partial_cmp(&self, other: &(A, B, C, D, E)) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.1.partial_cmp(&other.1) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.2.partial_cmp(&other.2) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.3.partial_cmp(&other.3) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        self.4.partial_cmp(&other.4)
    }
}

impl<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord> Ord for (A, B, C, D, E) {
    fn cmp(&self, other: &(A, B, C, D, E)) -> Ordering {
        match self.0.cmp(&other.0) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.1.cmp(&other.1) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.2.cmp(&other.2) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.3.cmp(&other.3) {
            Ordering::Equal => {}
            c => return c,
        }
        self.4.cmp(&other.4)
    }
}

impl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq, E: PartialEq,
    F: PartialEq> PartialEq for (A, B, C, D, E, F) {
    fn eq(&self, other: &(A, B, C, D, E, F)) -> bool {
        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3
            && self.4 == other.4 && self.5 == other.5
    }
}

impl<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq> Eq for (A, B, C, D, E, F) {}

impl<A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd, E: PartialOrd,
    F: PartialOrd> PartialOrd for (A, B, C, D, E, F) {
    fn partial_cmp(&self, other: &(A, B, C, D, E, F)) -> Option<Ordering> {
        match self.0.partial_cmp(&other.0) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.1.partial_cmp(&other.1) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.2.partial_cmp(&other.2) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.3.partial_cmp(&other.3) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        match self.4.partial_cmp(&other.4) {
            Option::Some(Ordering::Equal) => {}
            c => return c,
        }
        self.5.partial_cmp(&other.5)
    }
}

impl<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord, F: Ord> Ord for (A, B, C, D, E, F) {
    fn cmp(&self, other: &(A, B, C, D, E, F)) -> Ordering {
        match self.0.cmp(&other.0) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.1.cmp(&other.1) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.2.cmp(&other.2) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.3.cmp(&other.3) {
            Ordering::Equal => {}
            c => return c,
        }
        match self.4.cmp(&other.4) {
            Ordering::Equal => {}
            c => return c,
        }
        self.5.cmp(&other.5)
    }
}

// References compare as what they point to (Rust's `impl PartialEq<&B>
// for &A`): `&a == &b`, and an iterator of references' eq and ne.
impl<'a, 'b, A: ?Sized + PartialEq<B>, B: ?Sized> PartialEq<&'b B> for &'a A {
    fn eq(&self, other: &&'b B) -> bool {
        PartialEq::eq(*self, *other)
    }
}

impl<'a, 'b, A: ?Sized + PartialOrd<B>, B: ?Sized> PartialOrd<&'b B> for &'a A {
    fn partial_cmp(&self, other: &&'b B) -> Option<Ordering> {
        PartialOrd::partial_cmp(*self, *other)
    }
}
