// EDITION: rust
// std::default: Default, for types that hold no allocator, and
// DefaultIn<A>, for the ones that do (plan §3). Vec, String and HashMap
// are never Default (there is no ambient allocator); a blanket impl makes
// every Default type DefaultIn<A> for any A, which is coherent under
// Rust's rules exactly because the containers have no Default impl
// (checked with rustc 1.98). So `map.entry(k).or_default()` makes a 0, a
// None or an empty Vec on a clone of the map's allocator alike.

use crate::alloc::Allocator;

// A type's natural empty or zero value: 0, false, None, "", (), an empty
// struct of Defaults (`#[derive(Default)]`).
pub trait Default: Sized {
    fn default() -> Self;
}

// A type's empty value, made with an allocator: `Vec::new_in(a)`,
// `String::new_in(a)`, or Default's for a type that holds none
// (`#[derive(DefaultIn)]` for a struct of DefaultIn fields).
pub trait DefaultIn<A>: Sized {
    fn default_in(a: A) -> Self;
}

// later: blanket_impl
impl<T: Default, A> DefaultIn<A> for T {
    fn default_in(a: A) -> T {
        T::default()
    }
}
