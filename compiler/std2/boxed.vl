// EDITION: rust
// std::boxed: Box<T, A>, one value on the heap of A (MVS had none: a
// recursive type took a Vec or raw pointers). `Box::new_in(x, a)`,
// allocator last as nightly's allocator_api (plan §0); there is no
// `Box::new`, as there is no default allocator. A is always written
// (`Box<Node, Gpa>`, `Box<Node, &'a Arena<Gpa>>`). Box<[T], A> and
// Box<str, A> wait for unsized boxes (0.29, with user DSTs).

use crate::alloc::{AllocError, Allocator, Layout};
use crate::borrow::{Borrow, BorrowMut};
use crate::clone::Clone;
use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::convert::{AsMut, AsRef};
use crate::fmt::{Debug, Display, Formatter};
use crate::hash::{Hash, Hasher};
use crate::ops::{Deref, DerefMut, Drop};
use crate::option::Option;
use crate::ptr::NonNull;
use crate::result::Result;

// A T on A's heap, freed (and dropped) when the Box is.
pub struct Box<T, A: Allocator> {
    ptr: NonNull<T>,
    alloc: A,
}

impl<T, A: Allocator> Box<T, A> {
    // x moved to a block of a; out of memory panics.
    pub fn new_in(x: T, a: A) -> Box<T, A> {
        match Box::try_new_in(x, a) {
            Result::Ok(b) => b,
            Result::Err(_) => out_of_memory(),
        }
    }

    // The same, with AllocError instead of a panic.
    pub fn try_new_in(x: T, a: A) -> Result<Box<T, A>, AllocError> {
        let ptr: NonNull<T> = if crate::mem::size_of::<T>() == 0 {
            NonNull::dangling()
        } else {
            match a.allocate(Layout::new::<T>()) {
                Result::Ok(p) => p.cast::<T>(),
                Result::Err(e) => return Result::Err(e),
            }
        };
        // UNSAFE: x is moved into the block through a raw pointer.
        // SAFETY: ptr is a fresh block of T's layout from a (or, for a
        // zero-sized T, a dangling aligned pointer, which a write of no
        // bytes may use).
        unsafe { crate::ptr::write(ptr.as_ptr(), x) };
        Result::Ok(Box { ptr: ptr, alloc: a })
    }

    // The value, moved out; the block is freed. (`*b` moves out of a Box
    // in Rust; vole spells it into_inner.)
    pub fn into_inner(b: Box<T, A>) -> T {
        let (p, a) = Box::into_raw_with_allocator(b);
        // UNSAFE: the value is moved out and the block given back.
        // SAFETY: p and a come from a Box: p holds an initialized T in a
        // block a gave for T's layout (none for a zero-sized T), and the Box
        // is gone, so neither is used again.
        unsafe {
            let x = crate::ptr::read(p as *const T);
            free_block(p, &a);
            x
        }
    }

    // The allocator the Box frees into.
    pub fn allocator(b: &Box<T, A>) -> &A {
        &b.alloc
    }

    // A copy of the value on b.
    pub fn clone_in<B: Allocator>(&self, b: B) -> Box<T, B>
        where
            T: Clone,
    {
        Box::new_in(self.deref().clone(), b)
    }

    // The value, never freed: a &mut that lives as long as A's memory.
    pub fn leak<'a>(b: Box<T, A>) -> &'a mut T
        where
            A: 'a,
    {
        // UNSAFE: the block is never freed, so the &mut can outlive the Box.
        // SAFETY: p holds an initialized T; A: 'a keeps its memory for 'a,
        // and the Box is forgotten, so nothing else reaches the value.
        unsafe { &mut *Box::into_raw(b) }
    }

    // The block's pointer, the Box forgotten: from_raw_in takes it back.
    pub fn into_raw(b: Box<T, A>) -> *mut T {
        let (p, a) = Box::into_raw_with_allocator(b);
        // Rust's into_raw leaves the allocator undropped too.
        crate::mem::forget(a);
        p
    }

    // The pointer and the allocator, the Box forgotten.
    pub fn into_raw_with_allocator(b: Box<T, A>) -> (*mut T, A) {
        let p = b.ptr.as_ptr();
        // UNSAFE: the allocator is moved out of the Box bit for bit.
        // SAFETY: the Box is forgotten right after, so the allocator is
        // dropped once, by the caller, and the value is not dropped.
        let a = unsafe { crate::ptr::read(&b.alloc as *const A) };
        crate::mem::forget(b);
        (p, a)
    }

    // A Box again, from into_raw's pointer and the allocator it came from.
    // UNSAFE: p must come from a Box<T, A> on an allocator equal to a.
    // SAFETY: a contract on the caller, as Rust's Box::from_raw_in.
    pub unsafe fn from_raw_in(p: *mut T, a: A) -> Box<T, A> {
        match NonNull::new(p) {
            Option::Some(ptr) => Box { ptr: ptr, alloc: a },
            Option::None => crate::panic::unreachable(),
        }
    }
}

// Gives p's block back to a (a zero-sized T has none).
// UNSAFE: deallocates a block through the allocator.
// SAFETY: a contract on the caller: p is a Box's block from a, its value
// moved out or dropped.
unsafe fn free_block<T, A: Allocator>(p: *mut T, a: &A) {
    if crate::mem::size_of::<T>() != 0 {
        match NonNull::new(p as *mut u8) {
            Option::Some(q) => a.deallocate(q, Layout::new::<T>()),
            Option::None => {}
        }
    }
}

// Out of memory where the API has no Result: Rust's handle_alloc_error.
fn out_of_memory() -> ! {
    let msg: &str = "memory allocation failed";
    crate::panic::panic(msg)
}

impl<T, A: Allocator> Deref for Box<T, A> {
    type Target = T;

    fn deref(&self) -> &T {
        // UNSAFE: the Box's block, read through its pointer.
        // SAFETY: ptr holds an initialized T for the Box's life, and &self
        // borrows the Box, so no &mut reaches it meanwhile.
        unsafe { self.ptr.as_ref() }
    }
}

impl<T, A: Allocator> DerefMut for Box<T, A> {
    fn deref_mut(&mut self) -> &mut T {
        // UNSAFE: the Box's block, written through its pointer.
        // SAFETY: ptr holds an initialized T for the Box's life, and &mut
        // self is the one access to it.
        unsafe { self.ptr.as_mut() }
    }
}

impl<T, A: Allocator> Drop for Box<T, A> {
    fn drop(&mut self) {
        // UNSAFE: drops the value and gives the block back.
        // SAFETY: ptr holds an initialized T in a block alloc gave for
        // T's layout (none for a zero-sized T); the Box is dropped once.
        unsafe {
            crate::ptr::drop_in_place(self.ptr.as_ptr());
            free_block(self.ptr.as_ptr(), &self.alloc);
        }
    }
}

// A Box on the same allocator (a clone of it).
impl<T: Clone, A: Allocator + Clone> Clone for Box<T, A> {
    fn clone(&self) -> Box<T, A> {
        self.clone_in(self.alloc.clone())
    }
}

impl<T: PartialEq, A: Allocator> PartialEq for Box<T, A> {
    fn eq(&self, other: &Box<T, A>) -> bool {
        self.deref() == other.deref()
    }
}

impl<T: Eq, A: Allocator> Eq for Box<T, A> {}

impl<T: PartialOrd, A: Allocator> PartialOrd for Box<T, A> {
    fn partial_cmp(&self, other: &Box<T, A>) -> crate::option::Option<Ordering> {
        self.deref().partial_cmp(other.deref())
    }
}

impl<T: Ord, A: Allocator> Ord for Box<T, A> {
    fn cmp(&self, other: &Box<T, A>) -> Ordering {
        self.deref().cmp(other.deref())
    }
}

impl<T: Hash, A: Allocator> Hash for Box<T, A> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.deref().hash(state)
    }
}

impl<T: Debug, A: Allocator> Debug for Box<T, A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        self.deref().fmt(f)
    }
}

impl<T: Display, A: Allocator> Display for Box<T, A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        self.deref().fmt(f)
    }
}

impl<T, A: Allocator> AsRef<T> for Box<T, A> {
    fn as_ref(&self) -> &T {
        self.deref()
    }
}

impl<T, A: Allocator> AsMut<T> for Box<T, A> {
    fn as_mut(&mut self) -> &mut T {
        self.deref_mut()
    }
}

impl<T, A: Allocator> Borrow<T> for Box<T, A> {
    fn borrow(&self) -> &T {
        self.deref()
    }
}

impl<T, A: Allocator> BorrowMut<T> for Box<T, A> {
    fn borrow_mut(&mut self) -> &mut T {
        self.deref_mut()
    }
}
