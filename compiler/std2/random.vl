// EDITION: rust
// std::random (0.28.0): a pseudo-random generator, MVS's (0.20), vole's
// own: Rust's std has none (the rand crates' names are kept).
//
// xoshiro256++ (Blackman and Vigna), 32 bytes of state, with rand 0.9's
// names. Seeding from a number is pure and the same on every target
// (`Xoshiro256pp::seed_from_u64`: splitmix64, as rand_xoshiro seeds it, so
// the outputs match that crate's); seeding from the system's entropy is io
// (`from_entropy`). Ranges use Lemire's nearly divisionless method: no
// bias, a division only in about 1 of 2^64/n draws.
// mvs: std::random

use crate::num::wrapping::mul_hi;

// UNSAFE: the OS's random bytes.
// SAFETY: getentropy fills the len (at most 256) bytes at buf and returns
// 0, or -1 with nothing promised of them; its one caller passes a slice's
// pointer and a length within it and within 256.
extern "C" {
    #[link_name = "getentropy"]
    fn c_getentropy(buf: *mut u8, len: usize) -> i32;
}

#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct Xoshiro256pp {
    s0: u64,
    s1: u64,
    s2: u64,
    s3: u64,
}

// One step of splitmix64 on state: the next output.
#[effects()]
pub fn splitmix64_next(state: &mut u64) -> u64 {
    *state = state.wrapping_add(0x9e3779b97f4a7c15);
    let mut z = *state;
    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);
    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);
    z ^ (z >> 31)
}

impl Xoshiro256pp {
    // The generator seeded from n through splitmix64 (rand_xoshiro's
    // seed_from_u64): pure, the same everywhere.
    #[effects()]
    pub fn seed_from_u64(n: u64) -> Xoshiro256pp {
        let mut st = n;
        let a = splitmix64_next(&mut st);
        let b = splitmix64_next(&mut st);
        let c = splitmix64_next(&mut st);
        let d = splitmix64_next(&mut st);
        Xoshiro256pp { s0: a, s1: b, s2: c, s3: d }
    }

    // The generator with this state (not all zero: an all-zero state is
    // replaced by seed_from_u64(0)'s, as rand_xoshiro does).
    #[effects()]
    pub fn from_state(s: [u64; 4]) -> Xoshiro256pp {
        if s[0] == 0 && s[1] == 0 && s[2] == 0 && s[3] == 0 {
            return Xoshiro256pp::seed_from_u64(0);
        }
        Xoshiro256pp { s0: s[0], s1: s[1], s2: s[2], s3: s[3] }
    }

    // Its state, for from_state.
    #[effects()]
    pub fn state(&self) -> [u64; 4] {
        [self.s0, self.s1, self.s2, self.s3]
    }

    // The generator seeded from the system's entropy (getentropy); panics
    // when the system has none to give.
    #[effects(alloc(extern), io, static, panic, diverge)]
    pub fn from_entropy() -> Xoshiro256pp {
        let mut b: [u8; 32] = [0; 32];
        let mut s: [u64; 4] = [0, 0, 0, 0];
        if !fill_bytes_os(&mut b) {
            crate::panic::panic("from_entropy: the system gave no entropy");
        }
        for i in 0..32 {
            s[i / 8] |= (b[i] as u64) << ((i % 8) * 8) as u64;
        }
        Xoshiro256pp::from_state(s)
    }

    // The next 64 random bits.
    #[inline]
    #[effects()]
    pub fn next_u64(&mut self) -> u64 {
        let s0 = self.s0;
        let s3 = self.s3;
        let sum = s0.wrapping_add(s3);
        let result = ((sum << 23) | (sum >> 41)).wrapping_add(s0);
        let t = self.s1 << 17;
        let s2 = self.s2 ^ s0;
        let s3b = s3 ^ self.s1;
        let s1 = self.s1 ^ s2;
        let s0b = s0 ^ s3b;
        self.s0 = s0b;
        self.s1 = s1;
        self.s2 = s2 ^ t;
        self.s3 = (s3b << 45) | (s3b >> 19);
        result
    }

    // The next 32 random bits (the high half of next_u64, as rand_xoshiro).
    #[effects()]
    pub fn next_u32(&mut self) -> u32 {
        (self.next_u64() >> 32) as u32
    }

    // A uniform u64 in [lo, hi); panics when the range is empty.
    #[effects(io, panic, diverge)]
    pub fn random_range_u64(&mut self, lo: u64, hi: u64) -> u64 {
        if lo >= hi {
            crate::panic::panic("cannot sample empty range");
        }
        lo + self.below_u64(hi - lo)
    }

    // A uniform i64 in [lo, hi); panics when the range is empty.
    #[effects(io, panic, diverge)]
    pub fn random_range_i64(&mut self, lo: i64, hi: i64) -> i64 {
        if lo >= hi {
            crate::panic::panic("cannot sample empty range");
        }
        let n = (hi as u64).wrapping_sub(lo as u64);
        (lo as u64).wrapping_add(self.below_u64(n)) as i64
    }

    // A uniform usize in [lo, hi), for indices; panics when the range is
    // empty.
    #[effects(io, panic, diverge)]
    pub fn random_range_usize(&mut self, lo: usize, hi: usize) -> usize {
        if lo >= hi {
            crate::panic::panic("cannot sample empty range");
        }
        lo + self.below_u64((hi - lo) as u64) as usize
    }

    // A uniform u64 in [0, n), n > 0: Lemire's method. A draw is rejected
    // with probability under n / 2^64; after 128 rejections in a row (less
    // likely than 2^-128) the last one is taken.
    #[inline]
    #[effects()]
    pub fn below_u64(&mut self, n: u64) -> u64 {
        let mut x = self.next_u64();
        let mut lo = x.wrapping_mul(n);
        if lo < n {
            let t = n.wrapping_neg() % n;
            for _ in 0..128 {
                if lo >= t {
                    break;
                }
                x = self.next_u64();
                lo = x.wrapping_mul(n);
            }
        }
        mul_hi(x, n)
    }

    // A uniform f64 in [0, 1): 53 random bits.
    #[effects()]
    pub fn unit_f64(&mut self) -> f64 {
        (self.next_u64() >> 11) as f64 * 0.00000000000000011102230246251565
    }

    // true with probability p (0 <= p <= 1; panics otherwise).
    #[effects(io, panic, diverge)]
    pub fn random_bool(&mut self, p: f64) -> bool {
        if !(p >= 0.0 && p <= 1.0) {
            crate::panic::panic("random_bool: p is not in [0, 1]");
        }
        if p == 1.0 {
            return true;
        }
        // (p * 2^64 < 2^64)
        let cut = (p * 18446744073709551616.0) as u64;
        self.next_u64() < cut
    }

    // Fills buf with random bytes: each next_u64's bytes, least
    // significant first.
    // std2: changed: buf a &mut [u8]
    #[effects(panic, diverge)]
    pub fn fill_bytes(&mut self, buf: &mut [u8]) {
        let mut i: usize = 0;
        while i < buf.len() {
            let mut x = self.next_u64();
            let mut k = 0;
            while k < 8 && i < buf.len() {
                buf[i] = x as u8;
                x >>= 8;
                i += 1;
                k += 1;
            }
        }
    }

    // Moves the generator 2^128 steps ahead (xoshiro's jump): for 2^128
    // non-overlapping sequences.
    #[effects()]
    pub fn jump(&mut self) {
        let jump: [u64; 4] = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa,
            0x39abdc4529b1661c];
        let mut a: u64 = 0;
        let mut b: u64 = 0;
        let mut c: u64 = 0;
        let mut d: u64 = 0;
        for i in 0..4 {
            for bit in 0..64 {
                if (jump[i] & (1u64 << bit as u64)) != 0 {
                    a ^= self.s0;
                    b ^= self.s1;
                    c ^= self.s2;
                    d ^= self.s3;
                }
                self.next_u64();
            }
        }
        self.s0 = a;
        self.s1 = b;
        self.s2 = c;
        self.s3 = d;
    }
}

// Shuffles s uniformly (Fisher-Yates, from the end, as rand's shuffle).
// std2: changed: s a &mut [T], rng a &mut Xoshiro256pp
#[effects(diverge, T)]
pub fn shuffle<T>(s: &mut [T], rng: &mut Xoshiro256pp) {
    let n = s.len();
    let mut i = n;
    while i > 1 {
        i -= 1;
        let j = rng.below_u64((i + 1) as u64) as usize;
        s.swap(i, j);
    }
}

// Fills buf with random bytes from the system (getentropy, 256 bytes a
// call); false when the system fails. Rust's getrandom.
// std2: changed: buf a &mut [u8]
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn fill_bytes_os(buf: &mut [u8]) -> bool {
    let mut at: usize = 0;
    while at < buf.len() {
        let n = if buf.len() - at < 256 { buf.len() - at } else { 256 };
        let rest = &mut buf[at..at + n];
        // UNSAFE: the OS writes through a raw pointer.
        // SAFETY: rest is a live &mut [u8] of n <= 256 bytes, borrowed for
        // the call; getentropy writes at most n bytes there.
        if unsafe { c_getentropy(rest.as_mut_ptr(), n) } != 0 {
            return false;
        }
        at += n;
    }
    true
}
