// EDITION: rust
// ---- Shader compiler implementation, lex (0.22) ----
// The WGSL lexer: the whole source becomes arrays of tokens (kind, start,
// end, and for an identifier its symbol). Identifiers are interned: the
// predeclared names (names.vl) have fixed symbols, so the parser
// compares integers. Comments (`//`, nesting `/* */`) and blanks are
// skipped.

use crate::alloc::Allocator;
use crate::collections::HashMap;

use super::names::PREDECLARED;

pub(crate) const T_EOF: u8 = 0;
pub(crate) const T_IDENT: u8 = 1;
// an integer literal: its text is start .. end, the suffix included
pub(crate) const T_INT: u8 = 2;
pub(crate) const T_FLOAT: u8 = 3;
pub(crate) const T_LPAREN: u8 = 4;
pub(crate) const T_RPAREN: u8 = 5;
pub(crate) const T_LBRACE: u8 = 6;
pub(crate) const T_RBRACE: u8 = 7;
pub(crate) const T_LBRACKET: u8 = 8;
pub(crate) const T_RBRACKET: u8 = 9;
pub(crate) const T_COMMA: u8 = 10;
pub(crate) const T_SEMI: u8 = 11;
pub(crate) const T_COLON: u8 = 12;
pub(crate) const T_DOT: u8 = 13;
pub(crate) const T_AT: u8 = 14;
pub(crate) const T_ARROW: u8 = 15;
pub(crate) const T_EQ: u8 = 16;
pub(crate) const T_EQEQ: u8 = 17;
pub(crate) const T_NE: u8 = 18;
pub(crate) const T_LT: u8 = 19;
pub(crate) const T_LE: u8 = 20;
pub(crate) const T_GT: u8 = 21;
pub(crate) const T_GE: u8 = 22;
pub(crate) const T_PLUS: u8 = 23;
pub(crate) const T_MINUS: u8 = 24;
pub(crate) const T_STAR: u8 = 25;
pub(crate) const T_SLASH: u8 = 26;
pub(crate) const T_PERCENT: u8 = 27;
pub(crate) const T_AMP: u8 = 28;
pub(crate) const T_PIPE: u8 = 29;
pub(crate) const T_CARET: u8 = 30;
pub(crate) const T_TILDE: u8 = 31;
pub(crate) const T_BANG: u8 = 32;
pub(crate) const T_ANDAND: u8 = 33;
pub(crate) const T_OROR: u8 = 34;
pub(crate) const T_SHL: u8 = 35;
pub(crate) const T_SHR: u8 = 36;
pub(crate) const T_PLUSEQ: u8 = 37;
pub(crate) const T_MINUSEQ: u8 = 38;
pub(crate) const T_STAREQ: u8 = 39;
pub(crate) const T_SLASHEQ: u8 = 40;
pub(crate) const T_PERCENTEQ: u8 = 41;
pub(crate) const T_AMPEQ: u8 = 42;
pub(crate) const T_PIPEEQ: u8 = 43;
pub(crate) const T_CARETEQ: u8 = 44;
pub(crate) const T_SHLEQ: u8 = 45;
pub(crate) const T_SHREQ: u8 = 46;
pub(crate) const T_PLUSPLUS: u8 = 47;
pub(crate) const T_MINUSMINUS: u8 = 48;
pub(crate) const T_UNDERSCORE: u8 = 49;
// a byte that starts no token
pub(crate) const T_BAD: u8 = 50;

pub(crate) struct Tokens<'a, A: Allocator> {
    pub(crate) kinds: Vec<u8, A>,
    pub(crate) starts: Vec<i64, A>,
    pub(crate) ends: Vec<i64, A>,
    // the symbol of an identifier, else -1
    pub(crate) syms: Vec<i64, A>,
    // symbol -> its text
    pub(crate) names: Vec<&'a [u8], A>,
    intern: HashMap<&'a [u8], i64, A>,
    // a comment that is not closed: its start, else -1
    pub(crate) open_comment: i64,
}

fn is_ident_start(c: u8) -> bool {
    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_'
}

fn is_ident_char(c: u8) -> bool { is_ident_start(c) || (c >= b'0' && c <= b'9') }

fn is_hex(c: u8) -> bool {
    (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')
}

fn is_dec(c: u8) -> bool { c >= b'0' && c <= b'9' }

impl<'a, A: Allocator + Copy> Tokens<'a, A> {
    #[effects(A)]
    pub(crate) fn sym(&mut self, s: &'a [u8]) -> i64 {
        if let Some(h) = self.intern.get(&s).copied() {
            return h;
        }
        let h = self.names.len() as i64;
        self.names.push(s);
        self.intern.insert(s, h);
        h
    }

    fn push_token(&mut self, k: u8, s: i64, e: i64, sym: i64) {
        self.kinds.push(k);
        self.starts.push(s);
        self.ends.push(e);
        self.syms.push(sym);
    }
}

// The length of the number at src[i ..], and whether it is a float.
fn number_len(src: &[u8], i: i64) -> (i64, bool) {
    let n = src.len() as i64;
    let mut j = i;
    let mut float = false;
    if src[j as usize] == b'0' && j + 1 < n
        && (src[(j + 1) as usize] == b'x' || src[(j + 1) as usize] == b'X') {
        j += 2;
        while j < n && is_hex(src[j as usize]) {
            j += 1;
        }
        if j < n && src[j as usize] == b'.' {
            float = true;
            j += 1;
            while j < n && is_hex(src[j as usize]) {
                j += 1;
            }
        }
        if j < n && (src[j as usize] == b'p' || src[j as usize] == b'P') {
            float = true;
            j += 1;
            if j < n && (src[j as usize] == b'+' || src[j as usize] == b'-') {
                j += 1;
            }
            while j < n && is_dec(src[j as usize]) {
                j += 1;
            }
        }
        if j < n && (src[j as usize] == b'f' || src[j as usize] == b'h') && float {
            j += 1;
        } else if j < n && (src[j as usize] == b'i' || src[j as usize] == b'u') && !float {
            j += 1;
        }
        return (j - i, float);
    }
    while j < n && is_dec(src[j as usize]) {
        j += 1;
    }
    if j < n && src[j as usize] == b'.' && !(j + 1 < n && src[(j + 1) as usize] == b'.') {
        float = true;
        j += 1;
        while j < n && is_dec(src[j as usize]) {
            j += 1;
        }
    }
    if j < n && (src[j as usize] == b'e' || src[j as usize] == b'E') {
        let mut k = j + 1;
        if k < n && (src[k as usize] == b'+' || src[k as usize] == b'-') {
            k += 1;
        }
        if k < n && is_dec(src[k as usize]) {
            float = true;
            j = k;
            while j < n && is_dec(src[j as usize]) {
                j += 1;
            }
        }
    }
    if j < n && (src[j as usize] == b'f' || src[j as usize] == b'h') {
        float = true;
        j += 1;
    } else if j < n && (src[j as usize] == b'i' || src[j as usize] == b'u') && !float {
        j += 1;
    }
    (j - i, float)
}

#[effects(panic, diverge, A)]
pub(crate) fn lex<'a, A: Allocator + Copy>(src: &'a [u8], a: A) -> Tokens<'a, A> {
    let mut t = Tokens {
        kinds: Vec::with_capacity_in(src.len() / 3 + 16, a),
        starts: Vec::with_capacity_in(src.len() / 3 + 16, a),
        ends: Vec::with_capacity_in(src.len() / 3 + 16, a),
        syms: Vec::with_capacity_in(src.len() / 3 + 16, a),
        names: Vec::with_capacity_in(512usize, a),
        intern: HashMap::with_capacity_in(512usize, a),
        open_comment: -1,
    };
    for i in 0..PREDECLARED.len() {
        t.sym(PREDECLARED[i]);
    }
    let n = src.len() as i64;
    let mut i: i64 = 0;
    while i < n {
        let c = src[i as usize];
        if c == b' ' || c == b'\n' || c == b'\t' || c == b'\r' || c == 11 || c == 12 {
            i += 1;
            continue;
        }
        if c == b'/' && i + 1 < n && src[(i + 1) as usize] == b'/' {
            while i < n && src[i as usize] != b'\n' {
                i += 1;
            }
            continue;
        }
        if c == b'/' && i + 1 < n && src[(i + 1) as usize] == b'*' {
            let start = i;
            let mut depth: i64 = 1;
            i += 2;
            while i < n && depth > 0 {
                if src[i as usize] == b'/' && i + 1 < n && src[(i + 1) as usize] == b'*' {
                    depth += 1;
                    i += 2;
                } else if src[i as usize] == b'*' && i + 1 < n && src[(i + 1) as usize] == b'/' {
                    depth -= 1;
                    i += 2;
                } else {
                    i += 1;
                }
            }
            if depth > 0 {
                t.open_comment = start;
            }
            continue;
        }
        if is_ident_start(c) {
            let s = i;
            while i < n && is_ident_char(src[i as usize]) {
                i += 1;
            }
            if i - s == 1 && c == b'_' {
                t.push_token(T_UNDERSCORE, s, i, -1);
            } else {
                let sym = t.sym(&src[s as usize..i as usize]);
                t.push_token(T_IDENT, s, i, sym);
            }
            continue;
        }
        if is_dec(c) || (c == b'.' && i + 1 < n && is_dec(src[(i + 1) as usize])) {
            let (len, float) = number_len(src, i);
            t.push_token(if float { T_FLOAT } else { T_INT }, i, i + len, -1);
            i += len;
            continue;
        }
        let c1 = if i + 1 < n { src[(i + 1) as usize] } else { 0 };
        let c2 = if i + 2 < n { src[(i + 2) as usize] } else { 0 };
        let mut k = T_BAD;
        let mut len: i64 = 1;
        if c == b'(' {
            k = T_LPAREN;
        } else if c == b')' {
            k = T_RPAREN;
        } else if c == b'{' {
            k = T_LBRACE;
        } else if c == b'}' {
            k = T_RBRACE;
        } else if c == b'[' {
            k = T_LBRACKET;
        } else if c == b']' {
            k = T_RBRACKET;
        } else if c == b',' {
            k = T_COMMA;
        } else if c == b';' {
            k = T_SEMI;
        } else if c == b':' {
            k = T_COLON;
        } else if c == b'.' {
            k = T_DOT;
        } else if c == b'@' {
            k = T_AT;
        } else if c == b'~' {
            k = T_TILDE;
        } else if c == b'=' {
            if c1 == b'=' {
                k = T_EQEQ;
                len = 2;
            } else {
                k = T_EQ;
            }
        } else if c == b'!' {
            if c1 == b'=' {
                k = T_NE;
                len = 2;
            } else {
                k = T_BANG;
            }
        } else if c == b'<' {
            if c1 == b'<' && c2 == b'=' {
                k = T_SHLEQ;
                len = 3;
            } else if c1 == b'<' {
                k = T_SHL;
                len = 2;
            } else if c1 == b'=' {
                k = T_LE;
                len = 2;
            } else {
                k = T_LT;
            }
        } else if c == b'>' {
            if c1 == b'>' && c2 == b'=' {
                k = T_SHREQ;
                len = 3;
            } else if c1 == b'>' {
                k = T_SHR;
                len = 2;
            } else if c1 == b'=' {
                k = T_GE;
                len = 2;
            } else {
                k = T_GT;
            }
        } else if c == b'+' {
            if c1 == b'+' {
                k = T_PLUSPLUS;
                len = 2;
            } else if c1 == b'=' {
                k = T_PLUSEQ;
                len = 2;
            } else {
                k = T_PLUS;
            }
        } else if c == b'-' {
            if c1 == b'>' {
                k = T_ARROW;
                len = 2;
            } else if c1 == b'-' {
                k = T_MINUSMINUS;
                len = 2;
            } else if c1 == b'=' {
                k = T_MINUSEQ;
                len = 2;
            } else {
                k = T_MINUS;
            }
        } else if c == b'*' {
            if c1 == b'=' {
                k = T_STAREQ;
                len = 2;
            } else {
                k = T_STAR;
            }
        } else if c == b'/' {
            if c1 == b'=' {
                k = T_SLASHEQ;
                len = 2;
            } else {
                k = T_SLASH;
            }
        } else if c == b'%' {
            if c1 == b'=' {
                k = T_PERCENTEQ;
                len = 2;
            } else {
                k = T_PERCENT;
            }
        } else if c == b'&' {
            if c1 == b'&' {
                k = T_ANDAND;
                len = 2;
            } else if c1 == b'=' {
                k = T_AMPEQ;
                len = 2;
            } else {
                k = T_AMP;
            }
        } else if c == b'|' {
            if c1 == b'|' {
                k = T_OROR;
                len = 2;
            } else if c1 == b'=' {
                k = T_PIPEEQ;
                len = 2;
            } else {
                k = T_PIPE;
            }
        } else if c == b'^' {
            if c1 == b'=' {
                k = T_CARETEQ;
                len = 2;
            } else {
                k = T_CARET;
            }
        }
        t.push_token(k, i, i + len, -1);
        i += len;
    }
    t.push_token(T_EOF, n, n, -1);
    t
}

// How a token is written, for messages.
#[effects()]
pub(crate) fn token_text(k: u8) -> &'static [u8] {
    if k == T_EOF {
        b"the end of the file"
    } else if k == T_IDENT {
        b"an identifier"
    } else if k == T_INT || k == T_FLOAT {
        b"a number"
    } else if k == T_LPAREN {
        b"'('"
    } else if k == T_RPAREN {
        b"')'"
    } else if k == T_LBRACE {
        b"'{'"
    } else if k == T_RBRACE {
        b"'}'"
    } else if k == T_LBRACKET {
        b"'['"
    } else if k == T_RBRACKET {
        b"']'"
    } else if k == T_COMMA {
        b"','"
    } else if k == T_SEMI {
        b"';'"
    } else if k == T_COLON {
        b"':'"
    } else if k == T_DOT {
        b"'.'"
    } else if k == T_AT {
        b"'@'"
    } else if k == T_ARROW {
        b"'->'"
    } else if k == T_EQ {
        b"'='"
    } else if k == T_LT {
        b"'<'"
    } else if k == T_GT {
        b"'>'"
    } else if k == T_UNDERSCORE {
        b"'_'"
    } else if k == T_BAD {
        b"a character WGSL does not use"
    } else {
        b"an operator"
    }
}
