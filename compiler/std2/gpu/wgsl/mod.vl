// EDITION: rust
// std::gpu::wgsl (0.27.6): the shader compiler's front end, MVS's
// (docs/design/gpu.md §2.10), translated: WGSL (the subset of §2.10)
// parsed, resolved and type-checked into the target-neutral IR, and the
// uniformity analysis. What the compiler checks an `embed wgsl` block
// with:
//
//   let mut fr = front::new_front(text, a);
//   fr.module();
//   if !fr.failed {
//       uniformity::check(&fr);
//   }
//   // fr.failed: fr.err_code (wgsl.*), fr.err_pos, fr.emsg, fr.ehelp
//
// `a` is an allocator the front's tables live in (an arena's scope, `&s`).
// The back ends (0.28.0): `bounds` (the bounds checks), `msl` (Metal
// Shading Language), `spirv` (a stub), `interp` (the CPU interpreter of
// compute jobs), `dump` (the IR as text), `job` (a compute job's text
// form) and `api`: `translate`, the reflection and the errors.
// mvs: std::gpu::wgsl

pub mod ir;
mod names;
mod lex;
pub mod front;
mod expr;
mod builtins;
pub mod entry;
pub mod bounds;
pub mod uniformity;
pub mod msl;
pub mod spirv;
pub mod interp;
pub mod dump;
pub mod job;
pub mod api;

pub use api::{
    BK_COMPARISON_SAMPLER, BK_READ_ONLY_STORAGE, BK_SAMPLER, BK_STORAGE, BK_STORAGE_TEXTURE,
    BK_TEXTURE, BK_UNIFORM, BindingInfo, EntryInfo, InputInfo, Options, Reflection, ShaderError,
    SourceLine, TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, line_col, new_error,
    new_reflection, options, sizes_words, target_error, translate,
};
pub(crate) use api::translate_buf;
