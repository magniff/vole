#[derive(Clone, Copy)] pub struct Expr {
    pub op: u8, pub ty: i64, pub a: i64, pub b: i64, pub c: i64, pub d: i64,
}

// ---- Shader compiler implementation, ir: Statements (0.22) ----

// a .. b: the expressions evaluated here, in order
pub(crate) const S_EMIT: u8 = 0;
// a: the block
pub(crate) const S_BLOCK: u8 = 1;
// a: the condition; b: then; c: else (a block, possibly empty)
pub(crate) const S_IF: u8 = 2;
// a: the selector (i32 or u32); b, c: cases[b .. b + c]
pub(crate) const S_SWITCH: u8 = 3;
// a: body; b: continuing; c: the break-if expression, or -1 (evaluated
// at the end of continuing, after its emits)
pub(crate) const S_LOOP: u8 = 4;
pub(crate) const S_BREAK: u8 = 5;
pub(crate) const S_CONTINUE: u8 = 6;
// a: the value, or -1
pub(crate) const S_RETURN: u8 = 7;
// discard
pub(crate) const S_KILL: u8 = 8;
// a: BARRIER_* bits
pub(crate) const S_BARRIER: u8 = 9;
// a: the pointer; b: the value
pub(crate) const S_STORE: u8 = 10;
// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1
pub(crate) const S_CALL: u8 = 11;
// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;
// e: the comparand (AT_CMPXCHG) or -1
pub(crate) const S_ATOMIC: u8 = 12;
// a: the texture; b: the coordinates; c: the value; d: the array index or -1
pub(crate) const S_IMAGE_STORE: u8 = 13;
// a: the pointer; b: the E_WG_UNIFORM_RESULT
pub(crate) const S_WG_UNIFORM_LOAD: u8 = 14;

pub(crate) const BARRIER_WORKGROUP: i64 = 1;
pub(crate) const BARRIER_STORAGE: i64 = 2;

pub(crate) const AT_ADD: i64 = 0;
pub(crate) const AT_SUB: i64 = 1;
pub(crate) const AT_AND: i64 = 2;
pub(crate) const AT_OR: i64 = 3;
pub(crate) const AT_XOR: i64 = 4;
pub(crate) const AT_MIN: i64 = 5;
pub(crate) const AT_MAX: i64 = 6;
pub(crate) const AT_EXCHANGE: i64 = 7;
pub(crate) const AT_LOAD: i64 = 8;
pub(crate) const AT_STORE: i64 = 9;
// the result is __atomic_compare_exchange_result: { old_value, exchanged }
pub(crate) const AT_CMPXCHG: i64 = 10;

#[derive(Clone, Copy)] pub struct Stmt {
    pub op: u8, pub a: i64, pub b: i64, pub c: i64, pub d: i64, pub e: i64,
}

// A switch clause: its selector values (vals[vstart .. vstart + vcount]),
// whether it is the default, its body.
#[derive(Clone, Copy)] pub struct Case {
    pub vstart: i64, pub vcount: i64, pub is_default: bool, pub body: i64,
}

// A run of statement handles: items[start .. start + count].
#[derive(Clone, Copy)] pub struct Block { pub start: i64, pub count: i64 }

#[derive(Clone, Copy)] pub struct Param<'a> {
    pub name: &'a [u8], pub ty: i64, pub binding: Binding,
}

#[derive(Clone, Copy)] pub struct Local<'a> { pub name: &'a [u8], pub ty: i64 }

pub(crate) struct Function<'a, A: Allocator> {
    pub(crate) name: &'a [u8],
    pub(crate) params: Vec<Param<'a>, A>,
    // -1: no result
    pub(crate) result: i64,
    pub(crate) result_binding: Binding,
    pub(crate) locals: Vec<Local<'a>, A>,
    pub(crate) exprs: Vec<Expr, A>,
    // the names of `let` declarations: names[e] for expression e, or ""
    pub(crate) names: Vec<&'a [u8], A>,
    pub(crate) stmts: Vec<Stmt, A>,
    pub(crate) blocks: Vec<Block, A>,
    pub(crate) items: Vec<i64, A>,
    pub(crate) args: Vec<i64, A>,
    pub(crate) cases: Vec<Case, A>,
    pub(crate) vals: Vec<i64, A>,
    pub(crate) body: i64,
    // the source position of the declaration (a byte offset)
    pub(crate) pos: i64,
}

#[derive(Clone, Copy)] pub struct Global<'a> {
    pub(crate) name: &'a [u8],
    pub(crate) space: u8,
    pub(crate) access: u8,
    // the value's type (a texture, a sampler, or what the pointer points to)
    pub(crate) ty: i64,
    pub(crate) group: i64,
    pub(crate) binding: i64,
    // private globals: an expression of the module's init function, or -1
    pub(crate) init: i64,
    pub(crate) pos: i64,
}

pub(crate) const STAGE_VERTEX: u8 = 0;
pub(crate) const STAGE_FRAGMENT: u8 = 1;
pub(crate) const STAGE_COMPUTE: u8 = 2;

#[derive(Clone, Copy)] pub struct Entry<'a> {
    pub(crate) stage: u8, pub name: &'a [u8], pub func: i64, pub wg: [i64; 3],
    pub early_depth: bool,
}

#[derive(PartialEq, Eq, Hash, Clone, Copy)]
pub(crate) struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }

pub(crate) struct Module<'a, A: Allocator> {
    pub(crate) types: Vec<Type<'a>, A>,
    types_map: HashMap<TypeKey, i64, A>,
    pub(crate) members: Vec<StructMember<'a>, A>,
    pub(crate) globals: Vec<Global<'a>, A>,
    pub(crate) functions: Vec<Function<'a, A>, A>,
    pub(crate) entries: Vec<Entry<'a>, A>,
    // private globals' initializers live in this function's expressions
    // (literals, zero, compose only)
    pub(crate) consts: Function<'a, A>,
    pub(crate) a: A,
}

// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----

pub(crate) const T_BOOL: i64 = 0;
pub(crate) const T_I32: i64 = 1;
pub(crate) const T_U32: i64 = 2;
pub(crate) const T_F32: i64 = 3;

// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four
// concrete scalars
#[effects()]
pub(crate) fn vec_ty(sk: u8, n: i64) -> i64 {
    if n == 1 {
        return sk as i64;
    }
    4 + (n - 2) * 4 + sk as i64
}

// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)
#[effects()]
pub(crate) fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }

pub(crate) const T_FIXED_COUNT: i64 = 25;

#[effects(A)]
pub(crate) fn new_function<'a, A: Allocator + Copy>(name: &'a [u8], a: A) -> Function<'a, A> {
    Function {
        name: name,
        params: Vec::new_in(a),
        result: -1,
        result_binding: no_binding(),
        locals: Vec::new_in(a),
        exprs: Vec::new_in(a),
        names: Vec::new_in(a),
        stmts: Vec::new_in(a),
        blocks: Vec::new_in(a),
        items: Vec::new_in(a),
        args: Vec::new_in(a),
        cases: Vec::new_in(a),
        vals: Vec::new_in(a),
        body: -1,
        pos: 0,
    }
}

fn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }

impl<'a, A: Allocator + Copy> Module<'a, A> {
    #[effects(A)]
    pub(crate) fn new(a: A) -> Module<'a, A> {
        let mut m = Module {
            types: Vec::new_in(a),
            types_map: HashMap::new_in(a),
            members: Vec::new_in(a),
            globals: Vec::new_in(a),
            functions: Vec::new_in(a),
            entries: Vec::new_in(a),
            consts: new_function(b"", a),
            a: a,
        };
        for sk in 0..4 {
            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);
        }
        for n in 2..5 {
            for sk in 0..4 {
                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);
            }
        }
        for c in 2..5 {
            for r in 2..5 {
                m.push_type(TK_MATRIX, SK_F32, c, r, -1);
            }
        }
        m
    }

    fn push_type(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {
        let mut t = Type {
            kind: kind,
            scalar: sk,
            space: 0,
            access: 0,
            n: n,
            m: mm,
            base: base,
            mstart: 0,
            mcount: 0,
            name: b"",
            size: 4,
            align: 4,
            stride: 0,
        };
        if kind == TK_VECTOR {
            t.size = 4 * n;
            t.align = if n == 2 { 8 } else { 16 };
        } else if kind == TK_MATRIX {
            let col_align: i64 = if mm == 2 { 8 } else { 16 };
            t.align = col_align;
            t.stride = round_up(4 * mm, col_align);
            t.size = n * t.stride;
        }
        self.types.push(t);
        self.types.len() as i64 - 1
    }

    // The handle of a type made of these parts, made once.
    #[effects(panic, A)]
    pub(crate) fn intern(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,
        access: u8) -> i64 {
        if kind == TK_SCALAR {
            return sk as i64;
        }
        if kind == TK_VECTOR {
            return vec_ty(sk, n);
        }
        if kind == TK_MATRIX {
            return mat_ty(n, mm);
        }
        let key = TypeKey {
            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base,
        };
        if let Some(h) = self.types_map.get(&key).copied() {
            return h;
        }
        let h = self.push_type(kind, sk, n, mm, base);
        self.types[h as usize].space = space;
        self.types[h as usize].access = access;
        if kind == TK_ARRAY {
            let el = self.types[base as usize];
            let stride = round_up(el.size, el.align);
            self.types[h as usize].align = el.align;
            self.types[h as usize].stride = stride;
            self.types[h as usize].size = if n == 0 { stride } else { stride * n };
        } else if kind == TK_POINTER {
            self.types[h as usize].size = 8;
            self.types[h as usize].align = 8;
        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {
            self.types[h as usize].size = 8;
            self.types[h as usize].align = 8;
        }
        self.types_map.insert(key, h);
        h
    }

    #[effects(A)]
    pub(crate) fn array_ty(&mut self, elem: i64, n: i64) -> i64 {
        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)
    }

    #[effects(A)]
    pub(crate) fn ptr_ty(&mut self, pointee: i64, space: u8, access: u8) -> i64 {
        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)
    }

    #[effects(A)]
    pub(crate) fn atomic_ty(&mut self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }

    // A struct type: a new handle for each declaration (structs are
    // nominal); members[mstart ..] must already be pushed, offsets unset.
    #[effects(panic, A)]
    pub(crate) fn struct_ty(&mut self, name: &'a [u8], mstart: i64, mcount: i64) -> i64 {
        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);
        let mut off: i64 = 0;
        let mut al: i64 = 4;
        for i in mstart..mstart + mcount {
            let t = self.types[self.members[i as usize].ty as usize];
            off = round_up(off, t.align);
            self.members[i as usize].offset = off;
            off += t.size;
            if t.align > al {
                al = t.align;
            }
        }
        self.types[h as usize].name = name;
        self.types[h as usize].mstart = mstart;
        self.types[h as usize].mcount = mcount;
        self.types[h as usize].align = al;
        self.types[h as usize].size = round_up(off, al);
        h
    }

    // The scalar kind of a scalar, vector, matrix or atomic type.
    #[effects(panic, A)]
    pub(crate) fn scalar_of(&self, t: i64) -> u8 { self.types[t as usize].scalar }

    // The component count of a scalar (1) or vector type, else 0.
    #[effects(panic, A)]
    pub(crate) fn width_of(&self, t: i64) -> i64 {
        let k = self.types[t as usize].kind;
        if k == TK_SCALAR {
            1
        } else if k == TK_VECTOR {
            self.types[t as usize].n
        } else {
            0
        }
    }

    // The pointee of a pointer type, else -1.
    #[effects(panic, A)]
    pub(crate) fn pointee(&self, t: i64) -> i64 {
        if self.types[t as usize].kind == TK_POINTER {
            self.types[t as usize].base
        } else {
            -1
        }
    }

    // The type of a component of t when indexed: a vector's scalar, a
    // matrix's column, an array's element; -1 for the others.
    #[effects(panic, A)]
    pub(crate) fn elem_of(&self, t: i64) -> i64 {
        let ty = self.types[t as usize];
        if ty.kind == TK_VECTOR {
            ty.scalar as i64
        } else if ty.kind == TK_MATRIX {
            vec_ty(SK_F32, ty.m)
        } else if ty.kind == TK_ARRAY {
            ty.base
        } else {
            -1
        }
    }

    // How many components indexing t can reach: 0 for a runtime-sized array.
    #[effects(panic, A)]
    pub(crate) fn index_len(&self, t: i64) -> i64 {
        let ty = self.types[t as usize];
        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {
            ty.n
        } else if ty.kind == TK_MATRIX {
            ty.n
        } else {
            -1
        }
    }

    // Whether t is or holds a runtime-sized array.
    #[effects(panic, A)]
    pub(crate) fn is_runtime_sized(&self, t: i64) -> bool {
        let ty = self.types[t as usize];
        if ty.kind == TK_ARRAY {
            return ty.n == 0;
        }
        if ty.kind == TK_STRUCT && ty.mcount > 0 {
            return self.is_runtime_sized(self.members[(ty.mstart + ty.mcount - 1) as usize].ty);
        }
        false
    }

    // Whether t contains an atomic (such types cannot be loaded whole).
    #[effects(panic, A)]
    pub(crate) fn has_atomic(&self, t: i64) -> bool {
        let ty = self.types[t as usize];
        if ty.kind == TK_ATOMIC {
            return true;
        }
        if ty.kind == TK_ARRAY {
            return self.has_atomic(ty.base);
        }
        if ty.kind == TK_STRUCT {
            for i in ty.mstart..ty.mstart + ty.mcount {
                if self.has_atomic(self.members[i as usize].ty) {
                    return true;
                }
            }
        }
        false
    }

    // The type written as WGSL, for messages and the IR dump.
    #[effects(alloc(extern), io, static, sync, panic, diverge, A, B)]
    pub(crate) fn type_name<B: Allocator>(&self, t: i64, b: &mut Vec<u8, B>) {
        if t < 0 {
            b.extend_from_slice(b"void");
            return;
        }
        let ty = self.types[t as usize];
        if ty.kind == TK_SCALAR {
            b.extend_from_slice(scalar_name(ty.scalar));
        } else if ty.kind == TK_VECTOR {
            write(b, "vec{}<{}>", ty.n, str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();
        } else if ty.kind == TK_MATRIX {
            write(b, "mat{}x{}<f32>", ty.n, ty.m).unwrap();
        } else if ty.kind == TK_ARRAY {
            b.extend_from_slice(b"array<");
            self.type_name(ty.base, b);
            if ty.n > 0 {
                write(b, ", {}", ty.n).unwrap();
            }
            b.push(b'>');
        } else if ty.kind == TK_STRUCT {
            b.extend_from_slice(ty.name);
        } else if ty.kind == TK_ATOMIC {
            write(b, "atomic<{}>", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();
        } else if ty.kind == TK_POINTER {
            write(b, "ptr<{}, ", str::from_utf8(space_name(ty.space)).unwrap()).unwrap();
            self.type_name(ty.base, b);
            if ty.space == SP_STORAGE {
                b.extend_from_slice((if ty.access == ACC_RW { b", read_write" }
                    else { b", read" }));
            }
            b.push(b'>');
        } else if ty.kind == TK_TEXTURE {
            if ty.n == TEX_2D {
                write(b, "texture_2d<{}>", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();
            } else if ty.n == TEX_2D_ARRAY {
                write(b, "texture_2d_array<{}>", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();
            } else if ty.n == TEX_DEPTH_2D {
                b.extend_from_slice(b"texture_depth_2d");
            } else {
                write(b, "texture_storage_2d<{}, write>",
                    str::from_utf8(format_name(ty.m)).unwrap()).unwrap();
            }
        } else if ty.n == 1 {
            b.extend_from_slice(b"sampler_comparison");
        } else {
            b.extend_from_slice(b"sampler");
        }
    }
}

#[effects()]
pub(crate) fn scalar_name(sk: u8) -> &'static [u8] {
    if sk == SK_BOOL {
        b"bool"
    } else if sk == SK_I32 {
        b"i32"
    } else if sk == SK_U32 {
        b"u32"
    } else if sk == SK_F32 {
        b"f32"
    } else if sk == SK_AINT {
        b"abstract-int"
    } else {
        b"abstract-float"
    }
}

#[effects()]
pub(crate) fn space_name(sp: u8) -> &'static [u8] {
    if sp == SP_FUNCTION {
        b"function"
    } else if sp == SP_PRIVATE {
        b"private"
    } else if sp == SP_WORKGROUP {
        b"workgroup"
    } else if sp == SP_UNIFORM {
        b"uniform"
    } else if sp == SP_STORAGE {
        b"storage"
    } else {
        b"handle"
    }
}

#[effects()]
pub(crate) fn format_name(f: i64) -> &'static [u8] {
    if f == FMT_RGBA8UNORM {
        b"rgba8unorm"
    } else if f == FMT_RGBA32FLOAT {
        b"rgba32float"
    } else if f == FMT_R32FLOAT {
        b"r32float"
    } else if f == FMT_R32UINT {
        b"r32uint"
    } else if f == FMT_R32SINT {
        b"r32sint"
    } else if f == FMT_RGBA16FLOAT {
        b"rgba16float"
    } else if f == FMT_RGBA8UINT {
        b"rgba8uint"
    } else if f == FMT_RG32FLOAT {
        b"rg32float"
    } else {
        b"rgba32uint"
    }
}

// ---- Shader compiler implementation, ir: Building functions (0.22) ----

impl<'a, A: Allocator + Copy> Function<'a, A> {
    #[effects(A)]
    pub(crate) fn expr(&mut self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {
        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });
        self.names.push(b"");
        self.exprs.len() as i64 - 1
    }

    #[effects(A)]
    pub(crate) fn stmt(&mut self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {
        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });
        self.stmts.len() as i64 - 1
    }

    // A block of the statements pending[from ..], which are removed from
    // pending.
    #[effects(panic, A)]
    pub(crate) fn block_of(&mut self, pending: &mut Vec<i64, A>, from: i64) -> i64 {
        let start = self.items.len() as i64;
        for i in from..pending.len() as i64 {
            self.items.push(pending[i as usize]);
        }
        let count = pending.len() as i64 - from;
        pending.truncate(from as usize);
        self.blocks.push(Block { start: start, count: count });
        self.blocks.len() as i64 - 1
    }

    #[effects(A)]
    pub(crate) fn empty_block(&mut self) -> i64 {
        self.blocks.push(Block { start: self.items.len() as i64, count: 0 });
        self.blocks.len() as i64 - 1
    }

    #[effects(panic, A)]
    pub(crate) fn arg(&self, i: i64) -> i64 { self.args[i as usize] }

    #[effects(panic, A)]
    pub(crate) fn item(&self, blk: i64, i: i64) -> i64 { self.items[
        (self.blocks[blk as usize].start + i) as usize] }
}

// The byte offsets of function h's parameters in a record holding them
// all, each at its alignment (WGSL's layout); the record's size, rounded
// to 16, is the last element.
#[effects(panic, A)]
pub(crate) fn record_offsets<A: Allocator + Copy>(m: &Module<'_, A>, h: i64, a: A) -> Vec<i64, A> {
    let mut offs: Vec<i64, A> = Vec::new_in(a);
    let mut off: i64 = 0;
    let f = &m.functions[h as usize];
    for k in 0..f.params.len() as i64 {
        let t = m.types[f.params[k as usize].ty as usize];
        off = round_up(off, t.align);
        offs.push(off);
        off += t.size;
    }
    offs.push(round_up(off, 16));
    offs
}

// The bytes a value of type t takes in an array of them (its stride).
#[effects(panic, A)]
pub(crate) fn stride_of<A: Allocator + Copy>(m: &Module<'_, A>, t: i64) -> i64 {
    let ty = m.types[t as usize];
    round_up(ty.size, ty.align)
}

// Statements and expressions that end a block's flow.
#[effects()]
pub(crate) fn is_terminator(op: u8) -> bool {
    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL
}

// The bits of an f32, and back.
#[effects()]
pub(crate) fn f32_bits(f: f32) -> u32 { f.to_bits() }

#[effects()]
pub(crate) fn bits_f32(u: u32) -> f32 { f32::from_bits(u) }

#[effects()]
pub(crate) fn f64_bits(f: f64) -> u64 { f.to_bits() }
