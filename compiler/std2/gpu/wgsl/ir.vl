pub(crate) const MF_ATAN2: i64 = 23;
pub(crate) const MF_SINH: i64 = 24;
pub(crate) const MF_COSH: i64 = 25;
pub(crate) const MF_TANH: i64 = 26;
pub(crate) const MF_MIX: i64 = 27;
