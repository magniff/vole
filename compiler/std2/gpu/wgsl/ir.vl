// EDITION: rust
// ---- Shader compiler implementation, ir (0.22) ----
// The shader IR (docs/design/gpu.md §2.10): what the front end makes
// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is
// plain data: i64 handles into Vecs, one arena per translation.
//
// - Types are module-wide and interned: a handle is equal for equal types.
//   The scalar, vector and matrix types have fixed handles (`vec_ty`,
//   `mat_ty`); the rest are found through `types_map`.
// - A function has an expression arena, a statement arena and blocks
//   (runs of statement handles in `items`). Expressions are evaluated
//   where an `S_EMIT` statement covers them, in order, except the results
//   of calls and atomics (made by their statement) and the leaves
//   (literals, arguments, variables), which have no cost.
// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's
//   kind, set by bounds.vl; a back end never sees `CK_PENDING`.
//
// Moves to compiler/std/gpu/wgsl/ir.vl with C2 (std submodules).

use crate::alloc::Allocator;
use crate::cmp::PartialEq as Eq;
use crate::collections::HashMap;
use crate::hash::Hash;

// ---- Shader compiler implementation, ir: Scalars (0.22) ----

pub(crate) const SK_BOOL: u8 = 0;
pub(crate) const SK_I32: u8 = 1;
pub(crate) const SK_U32: u8 = 2;
pub(crate) const SK_F32: u8 = 3;
// Abstract numbers exist only in the front end (const evaluation).
pub(crate) const SK_AINT: u8 = 4;
pub(crate) const SK_AFLOAT: u8 = 5;

// ---- Shader compiler implementation, ir: Types (0.22) ----

pub(crate) const TK_SCALAR: u8 = 0;
pub(crate) const TK_VECTOR: u8 = 1;
// n columns of m rows of f32
pub(crate) const TK_MATRIX: u8 = 2;
// base: the element; n: the length, 0 when runtime-sized
pub(crate) const TK_ARRAY: u8 = 3;
pub(crate) const TK_STRUCT: u8 = 4;
pub(crate) const TK_ATOMIC: u8 = 5;
// base: the pointee; space, access
pub(crate) const TK_POINTER: u8 = 6;
// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format
pub(crate) const TK_TEXTURE: u8 = 7;
// n: 1 for sampler_comparison
pub(crate) const TK_SAMPLER: u8 = 8;

pub(crate) const TEX_2D: i64 = 0;
pub(crate) const TEX_2D_ARRAY: i64 = 1;
pub(crate) const TEX_DEPTH_2D: i64 = 2;
pub(crate) const TEX_STORAGE_2D: i64 = 3;

// Texel formats of storage textures (TK_TEXTURE.m).
pub(crate) const FMT_RGBA8UNORM: i64 = 0;
pub(crate) const FMT_RGBA32FLOAT: i64 = 1;
pub(crate) const FMT_R32FLOAT: i64 = 2;
pub(crate) const FMT_R32UINT: i64 = 3;
pub(crate) const FMT_R32SINT: i64 = 4;
pub(crate) const FMT_RGBA32UINT: i64 = 5;
pub(crate) const FMT_RGBA16FLOAT: i64 = 6;
pub(crate) const FMT_RGBA8UINT: i64 = 7;
pub(crate) const FMT_RG32FLOAT: i64 = 8;

// Address spaces.
pub(crate) const SP_FUNCTION: u8 = 0;
pub(crate) const SP_PRIVATE: u8 = 1;
pub(crate) const SP_WORKGROUP: u8 = 2;
pub(crate) const SP_UNIFORM: u8 = 3;
pub(crate) const SP_STORAGE: u8 = 4;
// textures and samplers: no address space, the global is the value
pub(crate) const SP_HANDLE: u8 = 5;

// Access modes (bits).
pub(crate) const ACC_READ: u8 = 1;
pub(crate) const ACC_WRITE: u8 = 2;
pub(crate) const ACC_RW: u8 = 3;

#[derive(Clone, Copy)] pub struct Type<'a> {
    pub(crate) kind: u8,
    pub(crate) scalar: u8,
    pub(crate) space: u8,
    pub(crate) access: u8,
    pub(crate) n: i64,
    pub(crate) m: i64,
    pub(crate) base: i64,
    // struct members: members[mstart .. mstart + mcount]
    pub(crate) mstart: i64,
    pub(crate) mcount: i64,
    pub(crate) name: &'a [u8],
    // the WGSL memory layout, in bytes (every type, every address space)
    pub(crate) size: i64,
    pub(crate) align: i64,
    // arrays: the element stride; matrices: the column stride
    pub(crate) stride: i64,
}

// What an entry point's parameter, result or IO struct member is bound to.
pub(crate) const BIND_NONE: u8 = 0;
pub(crate) const BIND_BUILTIN: u8 = 1;
pub(crate) const BIND_LOCATION: u8 = 2;

pub(crate) const INTERP_PERSPECTIVE: u8 = 0;
pub(crate) const INTERP_LINEAR: u8 = 1;
pub(crate) const INTERP_FLAT: u8 = 2;

#[derive(Clone, Copy)] pub struct Binding { pub kind: u8, pub interp: u8, pub value: i64 }

#[effects()]
pub(crate) fn no_binding() -> Binding {
    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }
}

pub(crate) const BI_POSITION: i64 = 0;
pub(crate) const BI_VERTEX_INDEX: i64 = 1;
pub(crate) const BI_INSTANCE_INDEX: i64 = 2;
pub(crate) const BI_FRONT_FACING: i64 = 3;
pub(crate) const BI_FRAG_DEPTH: i64 = 4;
pub(crate) const BI_SAMPLE_INDEX: i64 = 5;
pub(crate) const BI_SAMPLE_MASK: i64 = 6;
pub(crate) const BI_LOCAL_INVOCATION_ID: i64 = 7;
pub(crate) const BI_LOCAL_INVOCATION_INDEX: i64 = 8;
pub(crate) const BI_GLOBAL_INVOCATION_ID: i64 = 9;
pub(crate) const BI_WORKGROUP_ID: i64 = 10;
pub(crate) const BI_NUM_WORKGROUPS: i64 = 11;

#[derive(Clone, Copy)] pub struct StructMember<'a> {
    pub name: &'a [u8], pub ty: i64, pub offset: i64, pub binding: Binding,
}

// ---- Shader compiler implementation, ir: Expressions (0.22) ----

// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)
pub(crate) const E_LITERAL: u8 = 0;
pub(crate) const E_ZERO: u8 = 1;
// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a
// matrix, elements, members
pub(crate) const E_COMPOSE: u8 = 2;
// a: a scalar
pub(crate) const E_SPLAT: u8 = 3;
// a: the vector; b: the components, 2 bits each from bit 0; c: how many
pub(crate) const E_SWIZZLE: u8 = 4;
// a: base (a pointer or a value); b: the index expression; c: CK_*;
// d: the length when the check is a clamp
pub(crate) const E_ACCESS: u8 = 5;
// a: base (a pointer or a value); b: the constant index (a member, or a
// component of a vector, matrix or fixed-size array, checked statically)
pub(crate) const E_ACCESS_INDEX: u8 = 6;
// a: the parameter's index
pub(crate) const E_ARG: u8 = 7;
// a: the global; its type is a pointer (a texture or sampler: the handle)
pub(crate) const E_GLOBAL: u8 = 8;
// a: the local; a pointer<function>
pub(crate) const E_LOCAL: u8 = 9;
// a: the pointer
pub(crate) const E_LOAD: u8 = 10;
// a: UN_*; b: the operand
pub(crate) const E_UNARY: u8 = 11;
// a: OP_*; b, c: the operands
pub(crate) const E_BINARY: u8 = 12;
// a: the condition (bool, or a vector of bool); b: if true; c: if false
pub(crate) const E_SELECT: u8 = 13;
// a: MF_*; b, c: args[b .. b + c]
pub(crate) const E_MATH: u8 = 14;
// a: the operand; the type is the target (value conversion)
pub(crate) const E_CONVERT: u8 = 15;
// a: the operand; the type is the target (bits)
pub(crate) const E_BITCAST: u8 = 16;
// made by S_CALL
pub(crate) const E_CALL_RESULT: u8 = 17;
// made by S_ATOMIC
pub(crate) const E_ATOMIC_RESULT: u8 = 18;
// a: a pointer to a runtime-sized array (or a struct ending in one: b is
// then the member index, else -1)
pub(crate) const E_ARRAY_LENGTH: u8 = 19;
// a: DV_*; b: the operand
pub(crate) const E_DERIVATIVE: u8 = 20;
// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then
// array index, bias/level/depth ref as `aux`): see IMG_*
pub(crate) const E_IMAGE_SAMPLE: u8 = 21;
// a: the texture; c: args (coords, array index, level)
pub(crate) const E_IMAGE_LOAD: u8 = 22;
// a: the texture; b: IQ_*; c: the level expression or -1
pub(crate) const E_IMAGE_QUERY: u8 = 23;
// a: the pointer; made by S_WG_UNIFORM_LOAD
pub(crate) const E_WG_UNIFORM_RESULT: u8 = 24;

// Bounds checks of E_ACCESS.
pub(crate) const CK_PENDING: i64 = 0;
// proven in range: no check
pub(crate) const CK_NONE: i64 = 1;
// fixed length d: index = min(index, d - 1)
pub(crate) const CK_CLAMP: i64 = 2;
// runtime-sized: out of range, a load reads zero and a store is skipped
pub(crate) const CK_RZSW: i64 = 3;

pub(crate) const UN_NEG: i64 = 0;
pub(crate) const UN_NOT: i64 = 1;
pub(crate) const UN_BITNOT: i64 = 2;

pub(crate) const OP_ADD: i64 = 0;
pub(crate) const OP_SUB: i64 = 1;
pub(crate) const OP_MUL: i64 = 2;
pub(crate) const OP_DIV: i64 = 3;
pub(crate) const OP_MOD: i64 = 4;
pub(crate) const OP_EQ: i64 = 5;
pub(crate) const OP_NE: i64 = 6;
pub(crate) const OP_LT: i64 = 7;
pub(crate) const OP_LE: i64 = 8;
pub(crate) const OP_GT: i64 = 9;
pub(crate) const OP_GE: i64 = 10;
// bitwise on integers; logical (both operands evaluated) on bool
pub(crate) const OP_AND: i64 = 11;
pub(crate) const OP_OR: i64 = 12;
pub(crate) const OP_XOR: i64 = 13;
pub(crate) const OP_SHL: i64 = 14;
pub(crate) const OP_SHR: i64 = 15;
// short-circuit forms are lowered to control flow when the right side
// has effects; else they are these, on bool
pub(crate) const OP_LAND: i64 = 16;
pub(crate) const OP_LOR: i64 = 17;

