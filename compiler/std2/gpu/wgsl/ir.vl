// then the array index when the texture is an array, then the kind's
// operand (bias, level, depth reference).
pub(crate) const IMG_SAMPLE: i64 = 0;
pub(crate) const IMG_SAMPLE_BIAS: i64 = 1;
pub(crate) const IMG_SAMPLE_LEVEL: i64 = 2;
