// EDITION: rust
// ---- Shader compiler implementation, entry (0.22) ----
// Entry-point interfaces: what each stage's parameters and result may be
// bound to, and with which types (WGSL §"Entry Point Declaration").

use crate::alloc::Allocator;

use super::front::Front;
use super::ir::{
    BIND_BUILTIN, BIND_NONE, BI_FRAG_DEPTH, BI_FRONT_FACING, BI_GLOBAL_INVOCATION_ID,
    BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS,
    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,
    INTERP_FLAT, SK_BOOL, SK_F32, SK_U32, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, TK_SCALAR,
    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_U32, vec_ty,
};

#[effects()]
pub(crate) fn builtin_name(b: i64) -> &'static [u8] {
    if b == BI_POSITION {
        b"position"
    } else if b == BI_VERTEX_INDEX {
        b"vertex_index"
    } else if b == BI_INSTANCE_INDEX {
        b"instance_index"
    } else if b == BI_FRONT_FACING {
        b"front_facing"
    } else if b == BI_FRAG_DEPTH {
        b"frag_depth"
    } else if b == BI_SAMPLE_INDEX {
        b"sample_index"
    } else if b == BI_SAMPLE_MASK {
        b"sample_mask"
    } else if b == BI_LOCAL_INVOCATION_ID {
        b"local_invocation_id"
    } else if b == BI_LOCAL_INVOCATION_INDEX {
        b"local_invocation_index"
    } else if b == BI_GLOBAL_INVOCATION_ID {
        b"global_invocation_id"
    } else if b == BI_WORKGROUP_ID {
        b"workgroup_id"
    } else {
        b"num_workgroups"
    }
}

// The type a builtin has.
#[effects()]
pub(crate) fn builtin_type(b: i64) -> i64 {
    if b == BI_POSITION {
        vec_ty(SK_F32, 4)
    } else if b == BI_FRONT_FACING {
        T_BOOL
    } else if b == BI_FRAG_DEPTH {
        T_F32
    }
    else if b == BI_LOCAL_INVOCATION_ID || b == BI_GLOBAL_INVOCATION_ID || b == BI_WORKGROUP_ID
        || b == BI_NUM_WORKGROUPS {
        vec_ty(SK_U32, 3)
    } else {
        T_U32
    }
}

// Whether builtin b may be an input (or, `output`, an output) of stage.
fn builtin_allowed(b: i64, stage: u8, output: bool) -> bool {
    if stage == STAGE_COMPUTE {
        return !output && b >= BI_LOCAL_INVOCATION_ID;
    }
    if stage == STAGE_VERTEX {
        if output {
            return b == BI_POSITION;
        }
        return b == BI_VERTEX_INDEX || b == BI_INSTANCE_INDEX;
    }
    if output {
        return b == BI_FRAG_DEPTH || b == BI_SAMPLE_MASK;
    }
    b == BI_POSITION || b == BI_FRONT_FACING || b == BI_SAMPLE_INDEX || b == BI_SAMPLE_MASK
}

struct Seen<A: Allocator> { locs: Vec<i64, A>, builtins: Vec<i64, A>, position: bool }

fn check_binding<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, b: Binding, ty: i64, stage: u8,
    output: bool, what: &[u8], seen: &mut Seen<A>) {
    let at = fr.m.functions[fr.m.entries[(fr.m.entries.len() as i64 - 1) as usize].func as usize].pos;
    if b.kind == BIND_NONE {
        if fr.err(at, b"wgsl.entry") {
            {
                let what = str::from_utf8(what).unwrap();
                write(fr.emsg, "{what} of an entry point needs '@location(N)' or '@builtin(NAME)'").unwrap();
            }
        }
        return;
    }
    if b.kind == BIND_BUILTIN {
        if !builtin_allowed(b.value, stage, output) {
            let io = if output { "output" } else { "input" };
            if fr.err(at, b"wgsl.entry") {
                write(fr.emsg, "'@builtin({})' is not an {io} of a {} shader",
                    str::from_utf8(builtin_name(b.value)).unwrap(),
                    str::from_utf8(stage_name(stage)).unwrap()).unwrap();
            }
            return;
        }
        if builtin_type(b.value) != ty {
            if fr.err(at, b"wgsl.entry") {
                write(fr.emsg, "'@builtin({})' has type ",
                    str::from_utf8(builtin_name(b.value)).unwrap()).unwrap();
                fr.ty_str(builtin_type(b.value));
                fr.emsg.extend_from_slice(b", not ");
                fr.ty_str(ty);
            }
            return;
        }
        for i in 0..seen.builtins.len() as i64 {
            if seen.builtins[i as usize] == b.value {
                if fr.err(at, b"wgsl.entry") {
                    write(fr.emsg, "'@builtin({})' appears twice",
                        str::from_utf8(builtin_name(b.value)).unwrap()).unwrap();
                }
                return;
            }
        }
        seen.builtins.push(b.value);
        if b.value == BI_POSITION {
            seen.position = true;
        }
        return;
    }
    // a location
    if stage == STAGE_COMPUTE {
        if fr.err(at, b"wgsl.entry") {
            fr.emsg.extend_from_slice(b"a compute shader has no '@location' inputs");
        }
        return;
    }
    let t = fr.m.types[ty as usize];
    if (t.kind != TK_SCALAR && t.kind != TK_VECTOR) || t.scalar == SK_BOOL {
        if fr.err(at, b"wgsl.entry") {
            write(fr.emsg, "'@location({})' holds a number or a vector of numbers, not ", b.value).unwrap();
            fr.ty_str(ty);
        }
        return;
    }
    let interpolated = (stage == STAGE_VERTEX && output) || (stage == STAGE_FRAGMENT && !output);
    if interpolated && t.scalar != SK_F32 && b.interp != INTERP_FLAT {
        if fr.err(at, b"wgsl.entry") {
            write(fr.emsg, "'@location({})' is an integer: it needs '@interpolate(flat)'", b.value).unwrap();
        }
        return;
    }
    for i in 0..seen.locs.len() as i64 {
        if seen.locs[i as usize] == b.value {
            if fr.err(at, b"wgsl.entry") {
                write(fr.emsg, "'@location({})' appears twice", b.value).unwrap();
            }
            return;
        }
    }
    seen.locs.push(b.value);
}

#[effects()]
pub(crate) fn stage_name(s: u8) -> &'static [u8] {
    if s == STAGE_VERTEX {
        b"vertex"
    } else if s == STAGE_FRAGMENT {
        b"fragment"
    } else {
        b"compute"
    }
}

// A parameter or result: a bound value, or a struct of bound members.
fn check_io<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, b: Binding, ty: i64, stage: u8,
    output: bool, what: &[u8], seen: &mut Seen<A>) {
    let t = fr.m.types[ty as usize];
    if t.kind == TK_STRUCT && b.kind == BIND_NONE {
        for i in t.mstart..t.mstart + t.mcount {
            let mem = fr.m.members[i as usize];
            if fr.m.types[mem.ty as usize].kind == TK_STRUCT {
                let at = fr.m.functions[
                    fr.m.entries[(fr.m.entries.len() as i64 - 1) as usize].func as usize].pos;
                fr.fail(at, b"wgsl.entry", b"an entry point's IO struct cannot nest structs");
                return;
            }
            check_binding(fr, mem.binding, mem.ty, stage, output, b"a member of an IO struct",
                seen);
        }
        return;
    }
    check_binding(fr, b, ty, stage, output, what, seen);
}

#[effects(panic, A)]
pub(crate) fn check_interface<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, ei: i64) {
    let stage = fr.m.entries[ei as usize].stage;
    let fh = fr.m.entries[ei as usize].func;
    let pos = fr.m.functions[fh as usize].pos;
    let mut ins = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };
    for i in 0..fr.m.functions[fh as usize].params.len() as i64 {
        let b = fr.m.functions[fh as usize].params[i as usize].binding;
        let t = fr.m.functions[fh as usize].params[i as usize].ty;
        check_io(fr, b, t, stage, false, b"a parameter", &mut ins);
    }
    let mut outs = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };
    let result = fr.m.functions[fh as usize].result;
    if result >= 0 {
        if stage == STAGE_COMPUTE {
            fr.fail(pos, b"wgsl.entry", b"a compute shader returns nothing");
            return;
        }
        let rb = fr.m.functions[fh as usize].result_binding;
        check_io(fr, rb, result, stage, true, b"the result", &mut outs);
    }
    if stage == STAGE_VERTEX && !outs.position && !fr.failed {
        fr.fail(pos, b"wgsl.entry", b"a vertex shader returns '@builtin(position)' (a vec4<f32>)");
        fr.help(b"for example: fn vs(...) -> @builtin(position) vec4<f32>");
    }
}
