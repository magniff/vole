// EDITION: rust
// ---- Shader compiler implementation, msl (0.22) ----
// The MSL writer (docs/design/gpu.md §2.10): MSL 3.0 text for Metal's
// run-time compiler, with WGSL's semantics kept where MSL's differ.
//
// - Layout: structs get explicit padding and `packed_` vec3 members, so
//   every struct has WGSL's offsets and size; fixed-size arrays are
//   wrapped in a struct (`_w_arrN { T inner[N]; }`) to be values.
// - No undefined behaviour: signed + - * and negation go through uint;
//   integer / and % through helpers (by zero, MIN / -1); shift amounts are
//   masked; float to int conversions saturate; every index is clamped or,
//   for runtime-sized arrays, guarded against the binding's size from the
//   hidden sizes buffer (`[[buffer(30)]]`).
// - Bindings: buffers take slots 0.. in declaration order, textures and
//   samplers theirs; `reflect` gives the slots.
// - Values: an expression is written where it is used, except loads,
//   results, `let`s and those used more than once, which get a name where
//   they are evaluated (their S_EMIT).

use crate::alloc::Allocator;

use super::ir::{
    ACC_WRITE, AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_SUB,
    AT_XOR, BARRIER_WORKGROUP, BIND_BUILTIN, BIND_LOCATION, BI_FRAG_DEPTH, BI_FRONT_FACING,
    BI_GLOBAL_INVOCATION_ID, BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX,
    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,
    CK_CLAMP, CK_RZSW, E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY,
    E_BITCAST, E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD,
    E_IMAGE_QUERY, E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE,
    E_UNARY, E_WG_UNIFORM_RESULT, E_ZERO, Function, IMG_SAMPLE_BIAS, IMG_SAMPLE_COMPARE,
    IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, INTERP_FLAT, INTERP_LINEAR, IQ_LAYERS, IQ_LEVELS,
    Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LT, OP_MOD, OP_MUL,
    OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32, SK_I32, SK_U32, SP_HANDLE,
    SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX,
    S_ATOMIC, S_BARRIER, S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL,
    S_LOOP, S_RETURN, S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, TEX_2D_ARRAY, TEX_DEPTH_2D,
    TEX_STORAGE_2D, TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT,
    TK_TEXTURE, TK_VECTOR, Type, UN_NEG, UN_NOT, bits_f32,
};

// The names MSL keeps for itself. Every WGSL identifier the front end
// accepts must stay a name of its own in the MSL: Metal's run-time
// compiler sees <metal_stdlib> and <simd/simd.h> in the global namespace
// (macros, typedefs, keywords), and a user function `quad` is a
// redefinition of its `quad` typedef. The writer names Metal's own
// functions and types `metal::...`, so what can collide is exactly this
// table plus the vector type families below (is_reserved; W::escape gives
// such a name a trailing `_`). They were found by trying every identifier
// of the Metal headers (GPUCompiler.framework's include/metal) as a
// function, struct, member, global, local, parameter and entry point.
// reserved_count and reserved_name list them all, and
// tests/gpu/cases/wgsl_reserved_names.vl compiles shaders with each in
// each of those roles through Metal. No entry ends with `_`.
const RESERVED: [&[u8]; 299] = [
    // C++: keywords and alternative tokens
    b"alignas", b"alignof", b"and", b"and_eq", b"asm", b"auto", b"bitand", b"bitor", b"bool",
    b"break", b"case", b"catch", b"char", b"char8_t", b"char16_t", b"char32_t", b"class",
    b"co_await", b"co_return", b"co_yield", b"compl", b"concept", b"const", b"const_cast",
    b"consteval", b"constexpr", b"constinit", b"continue", b"decltype", b"default", b"delete",
    b"do", b"double", b"dynamic_cast", b"else", b"enum", b"explicit", b"export", b"extern",
    b"false", b"final", b"float", b"for", b"friend", b"goto", b"if", b"import", b"inline", b"int",
    b"long", b"module", b"mutable", b"namespace", b"new", b"noexcept", b"not", b"not_eq",
    b"nullptr", b"operator", b"or", b"or_eq", b"override", b"private", b"protected", b"public",
    b"register", b"reinterpret_cast", b"requires", b"return", b"short", b"signed", b"sizeof",
    b"static", b"static_assert", b"static_cast", b"struct", b"switch", b"template", b"this",
    b"thread_local", b"throw", b"true", b"try", b"typedef", b"typeid", b"typename", b"union",
    b"unsigned", b"using", b"virtual", b"void", b"volatile", b"wchar_t", b"while", b"xor",
    b"xor_eq",
    // MSL: keywords, address spaces, namespaces, `main`
    b"main", b"metal", b"simd", b"std", b"kernel", b"vertex", b"fragment", b"device", b"constant",
    b"thread", b"threadgroup", b"threadgroup_imageblock", b"ray_data", b"object_data", b"as_type",
    // the headers' global typedefs outside the vector families
    b"size_t", b"ptrdiff_t", b"nullptr_t", b"max_align_t", b"int8_t", b"uint8_t", b"int16_t",
    b"uint16_t", b"int32_t", b"uint32_t", b"int64_t", b"uint64_t", b"intptr_t", b"uintptr_t",
    b"complex", b"imaginary",
    // the headers' macros (constants and function-like)
    b"BFLT_DECIMAL_DIG", b"BFLT_DIG", b"BFLT_EPSILON", b"BFLT_MANT_DIG", b"BFLT_MAX",
    b"BFLT_MAX_10_EXP", b"BFLT_MAX_EXP", b"BFLT_MIN", b"BFLT_MIN_10_EXP", b"BFLT_MIN_EXP",
    b"BFLT_RADIX", b"CHAR_BIT", b"CHAR_MAX", b"CHAR_MIN", b"DBL_DECIMAL_DIG", b"DBL_DIG",
    b"DBL_EPSILON", b"DBL_MANT_DIG", b"DBL_MAX", b"DBL_MAX_10_EXP", b"DBL_MAX_EXP", b"DBL_MIN",
    b"DBL_MIN_10_EXP", b"DBL_MIN_EXP", b"DBL_RADIX", b"FLT_DECIMAL_DIG", b"FLT_DIG", b"FLT_EPSILON",
    b"FLT_MANT_DIG", b"FLT_MAX", b"FLT_MAX_10_EXP", b"FLT_MAX_EXP", b"FLT_MIN", b"FLT_MIN_10_EXP",
    b"FLT_MIN_EXP", b"FLT_RADIX", b"FP_ILOGB0", b"FP_ILOGBNAN", b"HALF_DECIMAL_DIG", b"HALF_DIG",
    b"HALF_EPSILON", b"HALF_MANT_DIG", b"HALF_MAX", b"HALF_MAX_10_EXP", b"HALF_MAX_EXP",
    b"HALF_MIN", b"HALF_MIN_10_EXP", b"HALF_MIN_EXP", b"HALF_RADIX", b"HAS_INTERFACE",
    b"HAS_INTERFACE_MDI", b"HUGE_VAL", b"HUGE_VALBF", b"HUGE_VALF", b"HUGE_VALH", b"INFINITY",
    b"INT_MAX", b"INT_MIN", b"LLONG_MAX", b"LLONG_MIN", b"LONG_MAX", b"LONG_MIN", b"MAXBFLOAT",
    b"MAXDOUBLE", b"MAXFLOAT", b"MAXHALF", b"METAL_ALIGN", b"METAL_ARG_UNIFORM", b"METAL_ASM",
    b"METAL_CONST", b"METAL_CONST_ARG", b"METAL_DEPRECATED", b"METAL_ENABLE_IF", b"METAL_EXPLICIT",
    b"METAL_FUNC", b"METAL_IMPLICIT", b"METAL_INTERNAL", b"METAL_MAYBE_UNDEF",
    b"METAL_NON_NULL_RETURN", b"METAL_NOTHROW", b"METAL_OS_LOG_FORMAT", b"METAL_PURE",
    b"METAL_UNAVAILABLE", b"METAL_VALID_COMPARE_EXCHANGE_FAILURE_ORDER",
    b"METAL_VALID_COMPARE_EXCHANGE_SUCCESS_ORDER", b"METAL_VALID_EXCHANGE_ORDER",
    b"METAL_VALID_LEVEL_ARG", b"METAL_VALID_LOAD_ORDER", b"METAL_VALID_LOD_ARG",
    b"METAL_VALID_MODIFY_ORDER", b"METAL_VALID_RENDER_TARGET", b"METAL_VALID_STORE_ORDER",
    b"METAL_VALIST_SIZE", b"METAL_VALIST_SIZE_CC", b"METAL_ZERO_ARG", b"M_1_PI", b"M_1_PI_BF",
    b"M_1_PI_F", b"M_1_PI_H", b"M_2_PI", b"M_2_PI_BF", b"M_2_PI_F", b"M_2_PI_H", b"M_2_SQRTPI",
    b"M_2_SQRTPI_BF", b"M_2_SQRTPI_F", b"M_2_SQRTPI_H", b"M_E", b"M_E_BF", b"M_E_F", b"M_E_H",
    b"M_LN10", b"M_LN10_BF", b"M_LN10_F", b"M_LN10_H", b"M_LN2", b"M_LN2_BF", b"M_LN2_F",
    b"M_LN2_H", b"M_LOG10E", b"M_LOG10E_BF", b"M_LOG10E_F", b"M_LOG10E_H", b"M_LOG2E",
    b"M_LOG2E_BF", b"M_LOG2E_F", b"M_LOG2E_H", b"M_PI", b"M_PI_2", b"M_PI_2_BF", b"M_PI_2_F",
    b"M_PI_2_H", b"M_PI_4", b"M_PI_4_BF", b"M_PI_4_F", b"M_PI_4_H", b"M_PI_BF", b"M_PI_F",
    b"M_PI_H", b"M_SQRT1_2", b"M_SQRT1_2_BF", b"M_SQRT1_2_F", b"M_SQRT1_2_H", b"M_SQRT2",
    b"M_SQRT2_BF", b"M_SQRT2_F", b"M_SQRT2_H", b"NAN", b"SCHAR_MAX", b"SCHAR_MIN", b"SHRT_MAX",
    b"SHRT_MIN", b"TARGET_OS_IOS", b"TARGET_OS_IPHONE", b"TARGET_OS_LINUX", b"TARGET_OS_MAC",
    b"TARGET_OS_MACCATALYST", b"TARGET_OS_OSX", b"TARGET_OS_SIMULATOR", b"TARGET_OS_TV",
    b"TARGET_OS_UNIX", b"TARGET_OS_VISION", b"TARGET_OS_WATCH", b"TARGET_OS_WIN32",
    b"TARGET_OS_WINDOWS", b"UCHAR_MAX", b"UINT_MAX", b"ULLONG_MAX", b"ULONG_MAX", b"USHRT_MAX",
    b"assert", b"is_function_constant_defined"];

// The vector, matrix and packed type families, all global typedefs:
// PREFIX BASE [N [xM]] (`float4`, `packed_half3`, `simd_float4x4`,
// `vector_uint2`, `quad8`, `bfloat2`). Any digits count, so a family's
// future sizes are names of it too.
const TYPE_PREFIXES: [&[u8]; 6] = [b"", b"packed_", b"simd_", b"simd_packed_", b"vector_",
    b"matrix_"];
const TYPE_BASES: [&[u8]; 16] = [
    b"bool", b"char", b"uchar", b"short", b"ushort", b"int", b"uint", b"long", b"ulong", b"llong",
    b"ullong", b"half", b"float", b"double", b"quad", b"bfloat"];
// The sizes reserved_names lists for each family (N, and NxM for 2..4).
const TYPE_SIZES: [&[u8]; 15] = [
    b"", b"2", b"3", b"4", b"8", b"16", b"2x2", b"2x3", b"2x4", b"3x2", b"3x3", b"3x4", b"4x2",
    b"4x3", b"4x4"];

const MATH_NAMES: [&[u8]; 39] = [
    b"abs", b"min", b"max", b"clamp", b"sign", b"floor", b"ceil", b"rint", b"fract", b"trunc",
    b"sqrt", b"rsqrt", b"exp", b"exp2", b"log", b"log2", b"pow", b"sin", b"cos", b"tan", b"asin",
    b"acos", b"atan", b"atan2", b"sinh", b"cosh", b"tanh", b"mix", b"step", b"smoothstep", b"fma",
    b"length", b"distance", b"dot", b"cross", b"normalize", b"reflect", b"determinant",
    b"transpose"];

// Where the resources are bound. Per stage (vertex, fragment, compute),
// buffers, textures and samplers each take slots from 0 in (group,
// binding) order over the bindings the stage's entry points use; the
// Metal hal binds what the reflection says. The sizes buffer (the byte
// sizes of the runtime-sized storage buffers, for bounds checks) takes the
// stage's next buffer slot; it has one u32 per runtime-sized storage
// binding of the module, in (group, binding) order.
pub struct Slots<A: Allocator> {
    // slot[stage * globals + g], or -1
    slot: Vec<i64, A>,
    // per global: its index in the sizes buffer, or -1
    size_index: Vec<i64, A>,
    sizes_count: i64,
    // per stage: the sizes buffer's slot, or -1 when the stage needs none
    sizes_slot: [i64; 3],
}

// The globals in (group, binding) order (the others after, as declared).
pub fn binding_order<A: Allocator + Copy>(m: &Module<'_, A>, a: A) -> Vec<i64, A> {
    let mut order: Vec<i64, A> = Vec::new_in(a);
    for g in 0..m.globals.len() as i64 {
        order.push(g);
    }
    // an insertion sort: modules have few bindings
    for i in 1..order.len() as i64 {
        let mut j = i;
        while j > 0 && binding_key(m, order[(j - 1) as usize]) > binding_key(m, order[j as usize]) {
            order.swap(j as usize - 1, j as usize);
            j -= 1;
        }
    }
    order
}

fn binding_key<A: Allocator + Copy>(m: &Module<'_, A>, g: i64) -> i64 {
    let gl = m.globals[g as usize];
    if gl.group < 0 {
        return 9223372036854775807 - (m.globals.len() as i64 - g);
    }
    gl.group * 1048576 + gl.binding
}

pub fn slots<'a,
    A: Allocator + Copy>(m: &'a Module<'_, A>, uses: &'a Vec<Vec<bool, A>, A>, a: A) -> Slots<A> {
    let ng = m.globals.len() as i64;
    let mut s = Slots {
        slot: Vec::from_elem_in(-1i64, (3 * ng as usize), a),
        size_index: Vec::from_elem_in(-1i64, (ng as usize), a),
        sizes_count: 0,
        sizes_slot: [-1, -1, -1],
    };
    let order = binding_order(m, a);
    for k in 0..order.len() as i64 {
        let g = order[k as usize];
        if m.globals[g as usize].space == SP_STORAGE
            && m.is_runtime_sized(m.globals[g as usize].ty) {
            s.size_index[g as usize] = s.sizes_count;
            s.sizes_count += 1;
        }
    }
    for st in 0..3 {
        let mut visible: Vec<bool, A> = Vec::from_elem_in(false, (ng as usize), a);
        for e in 0..m.entries.len() as i64 {
            if m.entries[e as usize].stage as i64 == st {
                let h = m.entries[e as usize].func;
                for g in 0..ng {
                    if uses[h as usize][g as usize] {
                        visible[g as usize] = true;
                    }
                }
            }
        }
        let mut nb: i64 = 0;
        let mut nt: i64 = 0;
        let mut ns: i64 = 0;
        let mut sized = false;
        for k in 0..order.len() as i64 {
            let g = order[k as usize];
            if !visible[g as usize] {
                continue;
            }
            let gl = m.globals[g as usize];
            let kind = m.types[gl.ty as usize].kind;
            if gl.space == SP_UNIFORM || gl.space == SP_STORAGE {
                s.slot[(st * ng + g) as usize] = nb;
                nb += 1;
                if s.size_index[g as usize] >= 0 {
                    sized = true;
                }
            } else if kind == TK_TEXTURE {
                s.slot[(st * ng + g) as usize] = nt;
                nt += 1;
            } else if kind == TK_SAMPLER {
                s.slot[(st * ng + g) as usize] = ns;
                ns += 1;
            }
        }
        if sized {
            s.sizes_slot[st as usize] = nb;
        }
    }
    s
}

// A name the writer made: text in its pool (W.pool).
#[derive(Clone, Copy)]
struct Nm { start: i64, len: i64 }

fn nm<A: Allocator + Copy>(pool: &Vec<u8, A>, n: Nm) -> &[u8] { &pool.as_slice()[
    n.start as usize..(n.start + n.len) as usize] }

// Appends s's bytes. (A Buf<ScopedArena> holds a view, of its arena, so
// the checker takes `dst.push_str(local.as_slice())` into a field as
// keeping a view of `local`; bytes pushed one by one are plain values.)
fn copy_into<A: Allocator + Copy>(dst: &mut Vec<u8, A>, s: &[u8]) {
    for i in 0..s.len() as i64 {
        dst.push(s[i as usize]);
    }
}

struct W<A: Allocator> {
    a: A,
    out: Vec<u8, A>,
    // the text of every name the writer made
    pool: Vec<u8, A>,
    // the types' MSL names, made on first use
    tname: Vec<Nm, A>,
    tdone: Vec<bool, A>,
    types_out: Vec<u8, A>,
    // helpers used
    need_div: bool,
    need_f2i: bool,
    need_sign: bool,
    need_flb: bool,
    need_ftb: bool,
    need_cmpxchg: Vec<Nm, A>,
    sl: Slots<A>,
    // per function: the globals it uses (directly or through calls)
    uses: Vec<Vec<bool, A>, A>,
    fnames: Vec<Nm, A>,
    gnames: Vec<Nm, A>,
    // the function being written
    fh: i64,
    refc: Vec<i64, A>,
    baked: Vec<bool, A>,
    // a name per local, parameter and baked expression of the function
    lnames: Vec<Nm, A>,
    enames: Vec<Nm, A>,
    used: Vec<Nm, A>,
    indent: i64,
    loop_n: i64,
    // entry points: the stage being written (255: a plain function), and
    // its output struct's name
    stage: i64,
    out_name: Nm,
    ret_ty: i64,
    // each type's kind
    kinds: Vec<u8, A>,
    snames: Vec<Nm, A>,
    spans: Vec<i64, A>,
}

// Whether s is a name MSL keeps for itself: in RESERVED or of a type
// family.
pub fn is_reserved(s: &[u8]) -> bool {
    for i in 0..RESERVED.len() {
        if RESERVED[i] == s {
            return true;
        }
    }
    is_type_family(s)
}

// PREFIX BASE, then nothing or digits, optionally `x` and digits.
fn is_type_family(s: &[u8]) -> bool {
    for p in 0..TYPE_PREFIXES.len() {
        let pre = TYPE_PREFIXES[p];
        if s.len() as i64 < pre.len() as i64 || &s[0..pre.len() as i64 as usize] != pre {
            continue;
        }
        let rest = &s[pre.len() as i64 as usize..];
        for b in 0..TYPE_BASES.len() {
            let base = TYPE_BASES[b];
            if rest.len() as i64 >= base.len() as i64 && rest[0..base.len() as i64 as usize] == base
                && is_type_size(&rest[base.len() as i64 as usize..]) {
                return true;
            }
        }
    }
    false
}

fn is_type_size(s: &[u8]) -> bool {
    let mut i: i64 = 0;
    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
        i += 1;
    }
    if i == s.len() as i64 {
        return true;
    }
    if i == 0 || s[i as usize] != b'x' || i + 1 == s.len() as i64 {
        return false;
    }
    i += 1;
    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {
        i += 1;
    }
    i == s.len() as i64
}

// The names of RESERVED and of the type families (with the sizes of
// TYPE_SIZES), by index: what tests/gpu/cases/wgsl_reserved_names.vl
// compiles. reserved_name(i, &out) puts the i-th in out.
pub fn reserved_count() -> i64 {
    (RESERVED.len() + TYPE_PREFIXES.len() * TYPE_BASES.len() * TYPE_SIZES.len()) as i64
}

// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form
// is std's own until 0.27.
pub fn reserved_name<A: Allocator>(i: i64, out: &mut String<A>) {
    let mut b = Vec::<u8, _>::new_in(*out.allocator());
    reserved_name_buf(i, &mut b);
    out.clear();
    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());
    out.push_str(t.as_str());
}

pub(crate) fn reserved_name_buf<A: Allocator>(i: i64, out: &mut Vec<u8, A>) {
    out.clear();
    if i < RESERVED.len() as i64 {
        out.extend_from_slice(RESERVED[i as usize]);
        return;
    }
    let k = i as usize - RESERVED.len();
    let z = k % TYPE_SIZES.len();
    let b = k / TYPE_SIZES.len() % TYPE_BASES.len();
    let p = k / (TYPE_SIZES.len() * TYPE_BASES.len());
    out.extend_from_slice(TYPE_PREFIXES[p]);
    out.extend_from_slice(TYPE_BASES[b]);
    out.extend_from_slice(TYPE_SIZES[z]);
}

impl<A: Allocator + Copy> W<A> {
    fn p(&mut self, s: &[u8]) { self.out.extend_from_slice(s); }

    // A pooled name into the output.
    fn pn(&mut self, n: Nm) { self.out.extend_from_slice(nm(&self.pool, n)); }

    // A type's name into the output.
    fn pty(&mut self, m: &Module<'_, A>, t: i64) {
        let n = self.ty(m, t);
        self.pn(n);
    }

    fn s(&self, n: Nm) -> &[u8] { nm(&self.pool, n) }

    // Text into the pool: a name.
    fn intern(&mut self, s: &[u8]) -> Nm {
        let st = self.pool.len() as i64;
        copy_into(&mut self.pool, s);
        Nm { start: st, len: s.len() as i64 }
    }

    // The pool's text from `st` on, as a name.
    fn since(&self, st: i64) -> Nm { Nm { start: st, len: self.pool.len() as i64 - st } }

    fn line(&mut self) {
        self.out.push(b'\n');
        for _ in 0..self.indent {
            self.out.extend_from_slice(b"    ");
        }
    }

    // A WGSL identifier as an MSL one. A name that is reserved
    // (is_reserved), starts with `_` or ends with `_` gets a trailing `_`,
    // and a `u` in front when it starts with `_` or `u..._` (`_x` is
    // `u_x_`, `u_x_` is `uu_x__`); every other name is itself. So the map
    // is one to one, never gives a reserved name (none ends with `_`) and
    // never one starting with `_` (the writer's own names do).
    fn escape(&mut self, s: &[u8]) -> Nm {
        if s.len() as i64 == 0 {
            return self.intern(b"_w_t");
        }
        let st = self.pool.len() as i64;
        if s[0] != b'_' && s[(s.len() as i64 - 1) as usize] != b'_' && !is_reserved(s) {
            copy_into(&mut self.pool, s);
            return self.since(st);
        }
        let mut i: i64 = 0;
        while i < s.len() as i64 && s[i as usize] == b'u' {
            i += 1;
        }
        if i < s.len() as i64 && s[i as usize] == b'_' {
            self.pool.push(b'u');
        }
        copy_into(&mut self.pool, s);
        self.pool.push(b'_');
        self.since(st)
    }

    fn is_used(&self, n: Nm) -> bool {
        let t = nm(&self.pool, n);
        for i in 0..self.used.len() as i64 {
            if nm(&self.pool, self.used[i as usize]) == t {
                return true;
            }
        }
        false
    }

    // A name unique in the function being written.
    fn unique(&mut self, base: &[u8]) -> Nm {
        let n = self.escape(base);
        if !self.is_used(n) {
            self.used.push(n);
            return n;
        }
        let mut k: i64 = 1;
        loop {
            let st = self.pool.len() as i64;
            let mut i: i64 = 0;
            while i < n.len {
                let c = self.pool.as_slice()[(n.start + i) as usize];
                self.pool.push(c);
                i += 1;
            }
            write(self.pool, "_{k}").unwrap();
            let t = self.since(st);
            if !self.is_used(t) {
                self.used.push(t);
                return t;
            }
            k += 1;
        }
    }

    // ---- Types ----

    fn scalar(sk: u8) -> &'static [u8] {
        if sk == SK_BOOL {
            b"bool"
        } else if sk == SK_I32 {
            b"int"
        } else if sk == SK_U32 {
            b"uint"
        } else {
            b"float"
        }
    }

    // The MSL name of type t (declaring structs and array wrappers once).
    fn ty(&mut self, m: &Module<'_, A>, t: i64) -> Nm {
        if self.tdone[t as usize] {
            return self.tname[t as usize];
        }
        let ty = m.types[t as usize];
        let mut n = Nm { start: 0, len: 0 };
        if ty.kind == TK_SCALAR {
            n = self.intern(W::<A>::scalar(ty.scalar));
        } else if ty.kind == TK_VECTOR {
            let st = self.pool.len() as i64;
            write(self.pool, "metal::{}{}", str::from_utf8(W::<A>::scalar(ty.scalar)).unwrap(),
                ty.n).unwrap();
            n = self.since(st);
        } else if ty.kind == TK_MATRIX {
            let st = self.pool.len() as i64;
            write(self.pool, "metal::float{}x{}", ty.n, ty.m).unwrap();
            n = self.since(st);
        } else if ty.kind == TK_ATOMIC {
            n = self.intern(if ty.scalar == SK_I32 { b"metal::atomic_int" }
                else { b"metal::atomic_uint" });
        } else if ty.kind == TK_ARRAY {
            let el = self.ty(m, ty.base);
            let st = self.pool.len() as i64;
            write(self.pool, "_w_arr{t}").unwrap();
            n = self.since(st);
            if ty.n > 0 {
                write(self.types_out, "struct _w_arr{t} {{\n    {} inner[{}];\n}};\n",
                    str::from_utf8(nm(&self.pool, el)).unwrap(), ty.n).unwrap();
            }
        } else if ty.kind == TK_STRUCT {
            n = self.escape(ty.name);
            self.struct_def(m, t, n);
        } else if ty.kind == TK_TEXTURE {
            let sc = W::<A>::scalar(ty.scalar);
            let st = self.pool.len() as i64;
            if ty.n == TEX_DEPTH_2D {
                self.pool.extend_from_slice(b"metal::depth2d<float, metal::access::sample>");
            } else if ty.n == TEX_2D_ARRAY {
                { let sc = str::from_utf8(sc).unwrap();
                    write(self.pool, "metal::texture2d_array<{sc}, metal::access::sample>").unwrap() };
            } else if ty.n == TEX_STORAGE_2D {
                { let sc = str::from_utf8(sc).unwrap();
                    write(self.pool, "metal::texture2d<{sc}, metal::access::write>").unwrap() };
            } else {
                { let sc = str::from_utf8(sc).unwrap();
                    write(self.pool, "metal::texture2d<{sc}, metal::access::sample>").unwrap() };
            }
            n = self.since(st);
        } else if ty.kind == TK_SAMPLER {
            n = self.intern(b"metal::sampler");
        } else {
            n = self.intern(b"void");
        }
        self.tname[t as usize] = n;
        self.tdone[t as usize] = true;
        n
    }

    // A member's MSL type: vec3 members are packed (12 bytes, as WGSL's).
    fn member_ty(&mut self, m: &Module<'_, A>, t: i64) -> Nm {
        let ty = m.types[t as usize];
        if ty.kind == TK_VECTOR && ty.n == 3 {
            let st = self.pool.len() as i64;
            write(self.pool, "metal::packed_{}3",
                str::from_utf8(W::<A>::scalar(ty.scalar)).unwrap()).unwrap();
            return self.since(st);
        }
        if ty.kind == TK_ARRAY && ty.n == 0 {
            return self.ty(m, ty.base);
        }
        self.ty(m, t)
    }

    fn struct_def(&mut self, m: &Module<'_, A>, t: i64, name: Nm) {
        let ty = m.types[t as usize];
        // member types first: they must be declared before
        for i in ty.mstart..ty.mstart + ty.mcount {
            self.member_ty(m, m.members[i as usize].ty);
        }
        let mut b = Vec::<u8, _>::new_in(self.a);
        write(b, "struct {} {{\n", str::from_utf8(nm(&self.pool, name)).unwrap()).unwrap();
        let mut off: i64 = 0;
        let mut pad: i64 = 0;
        for i in ty.mstart..ty.mstart + ty.mcount {
            let mem = m.members[i as usize];
            if mem.offset > off {
                write(b, "    char _pad{pad}[{}];\n", mem.offset - off).unwrap();
                pad += 1;
            }
            let mt = m.types[mem.ty as usize];
            let mty = self.member_ty(m, mem.ty);
            let mn = self.escape(mem.name);
            if mt.kind == TK_ARRAY && mt.n == 0 {
                write(b, "    {} {}[1];\n", str::from_utf8(nm(&self.pool, mty)).unwrap(),
                    str::from_utf8(nm(&self.pool, mn)).unwrap()).unwrap();
                off = mem.offset + mt.stride;
            } else {
                write(b, "    {} {};\n", str::from_utf8(nm(&self.pool, mty)).unwrap(),
                    str::from_utf8(nm(&self.pool, mn)).unwrap()).unwrap();
                off = mem.offset + mt.size;
            }
        }
        if ty.size > off
            && !(ty.mcount > 0
                && m.is_runtime_sized(m.members[(ty.mstart + ty.mcount - 1) as usize].ty)) {
            write(b, "    char _pad{pad}[{}];\n", ty.size - off).unwrap();
        }
        b.extend_from_slice(b"};\n");
        copy_into(&mut self.types_out, b.as_slice());
    }

    // The padding members before member k of struct t (for aggregate
    // initialization), and after the last.
    fn pads_before(m: &Module<'_, A>, t: i64, k: i64) -> bool {
        let ty = m.types[t as usize];
        let mem = m.members[(ty.mstart + k) as usize];
        if k == 0 {
            return mem.offset > 0;
        }
        let prev = m.members[(ty.mstart + k - 1) as usize];
        mem.offset > prev.offset + m.types[prev.ty as usize].size
    }

    fn space(sp: u8, access: u8) -> &'static [u8] {
        if sp == SP_STORAGE {
            if access & ACC_WRITE != 0 { b"device" } else { b"const device" }
        } else if sp == SP_UNIFORM {
            b"constant"
        } else if sp == SP_WORKGROUP {
            b"threadgroup"
        } else {
            b"thread"
        }
    }
}

// ---- Shader compiler implementation, msl: Analysis (0.22) ----

fn calls_of<A: Allocator + Copy>(f: &Function<'_, A>, list: &mut Vec<i64, A>) {
    for s in 0..f.stmts.len() as i64 {
        if f.stmts[s as usize].op == S_CALL {
            list.push(f.stmts[s as usize].a);
        }
    }
}

// Functions in an order where each comes after those it calls.
pub fn call_order<A: Allocator + Copy>(m: &Module<'_, A>, a: A) -> Vec<i64, A> {
    let n = m.functions.len() as i64;
    let mut state: Vec<u8, A> = Vec::from_elem_in(0u8, (n as usize), a);
    let mut order: Vec<i64, A> = Vec::new_in(a);
    for i in 0..n {
        visit(m, i, &mut state, &mut order, a);
    }
    order
}

fn visit<A: Allocator + Copy>(m: &Module<'_, A>, i: i64, state: &mut Vec<u8, A>,
    order: &mut Vec<i64, A>, a: A) {
    if state[i as usize] != 0 {
        return;
    }
    state[i as usize] = 1;
    let mut cs: Vec<i64, A> = Vec::new_in(a);
    calls_of(&m.functions[i as usize], &mut cs);
    for k in 0..cs.len() as i64 {
        visit(m, cs[k as usize], state, order, a);
    }
    order.push(i);
}

// Which globals each function uses, through its calls too (order: callees first).
pub fn global_uses<A: Allocator + Copy>(m: &Module<'_, A>, order: &Vec<i64, A>, a: A) -> Vec<Vec<bool, A>, A> {
    let ng = m.globals.len() as i64;
    let mut uses: Vec<Vec<bool, A>, A> = Vec::new_in(a);
    for _ in 0..m.functions.len() as i64 {
        uses.push(Vec::from_elem_in(false, (ng as usize), a));
    }
    for oi in 0..order.len() as i64 {
        let h = order[oi as usize];
        let f = &m.functions[h as usize];
        for e in 0..f.exprs.len() as i64 {
            if f.exprs[e as usize].op == E_GLOBAL || f.exprs[e as usize].op == E_ARRAY_LENGTH {
                uses[h as usize][f.exprs[e as usize].a as usize] = true;
            }
        }
        for s in 0..f.stmts.len() as i64 {
            if f.stmts[s as usize].op == S_CALL {
                let callee = f.stmts[s as usize].a;
                for g in 0..ng {
                    if uses[callee as usize][g as usize] {
                        uses[h as usize][g as usize] = true;
                    }
                }
            }
        }
    }
    uses
}

// Whether function h needs the sizes buffer (a runtime-sized array it or a
// callee reads).
fn needs_sizes<A: Allocator + Copy>(w: &W<A>, m: &Module<'_, A>, h: i64) -> bool {
    for g in 0..m.globals.len() as i64 {
        if w.uses[h as usize][g as usize] && w.sl.size_index[g as usize] >= 0 {
            return true;
        }
    }
    false
}

// The module as MSL; the reflection's Metal names and slots too.
pub(crate) fn write_module<A: Allocator + Copy>(m: &Module<'_, A>, a: A, out: &mut Vec<u8, Gpa>,
    refl: &mut api::Reflection<Gpa>) {
    let mut w = new_writer(m, a);
    let order = call_order(m, a);
    w.uses = global_uses(m, &order, a);
    w.sl = slots(m, &w.uses, a);
    for oi in 0..order.len() as i64 {
        let h = order[oi as usize];
        let mut is_entry = false;
        for e in 0..m.entries.len() as i64 {
            if m.entries[e as usize].func == h {
                is_entry = true;
            }
        }
        if !is_entry {
            write_fn(&mut w, m, h);
        }
    }
    for e in 0..m.entries.len() as i64 {
        write_entry(&mut w, m, e);
    }
    let base = out.len() as i64;
    finish(&w, out);
    // where each function starts in the MSL (its 1-based line), for
    // Metal's messages (api::target_error); w.out is the text's end
    let text = out.as_slice();
    let body = text.len() as i64 - w.out.len() as i64;
    refl.lines.clear();
    let mut line: i64 = 1;
    let mut at = base;
    let mut k: i64 = 0;
    while k < w.spans.len() as i64 {
        let to = body + w.spans[k as usize];
        while at < to {
            if text[at as usize] == b'\n' {
                line += 1;
            }
            at += 1;
        }
        // (the function's text starts with an empty line)
        refl.lines.push(api::SourceLine {
            msl_line: line + 1, pos: m.functions[w.spans[(k + 1) as usize] as usize].pos,
        });
        k += 2;
    }
    // the Metal side of the reflection
    for e in 0..refl.entries.len() as i64 {
        refl.entries[e as usize].target_name.clear();
        refl.entries[e as usize].target_name.extend_from_slice(nm(&w.pool,
            w.fnames[m.entries[e as usize].func as usize]));
        refl.entries[e as usize].sizes_slot = w.sl.sizes_slot[
            m.entries[e as usize].stage as i64 as usize];
    }
    let ng = m.globals.len() as i64;
    for b in 0..refl.bindings.len() as i64 {
        let g = refl.bindings[b as usize].global;
        for st in 0..3 {
            refl.bindings[b as usize].slots[st as usize] = w.sl.slot[(st * ng + g) as usize];
        }
    }
}

fn new_writer<'a, A: Allocator + Copy>(m: &'a Module<'_, A>, a: A) -> W<A> {
    let mut w = W {
        a: a,
        out: Vec::<u8, _>::with_capacity_in(16384usize, a),
        tname: Vec::new_in(a),
        tdone: Vec::new_in(a),
        types_out: Vec::<u8, _>::new_in(a),
        need_div: false,
        need_f2i: false,
        need_sign: false,
        need_flb: false,
        need_ftb: false,
        need_cmpxchg: Vec::new_in(a),
        sl: Slots {
            slot: Vec::new_in(a), size_index: Vec::new_in(a), sizes_count: 0,
            sizes_slot: [-1, -1, -1],
        },
        uses: Vec::new_in(a),
        fnames: Vec::new_in(a),
        gnames: Vec::new_in(a),
        fh: -1,
        refc: Vec::new_in(a),
        baked: Vec::new_in(a),
        lnames: Vec::new_in(a),
        enames: Vec::new_in(a),
        used: Vec::new_in(a),
        indent: 0,
        loop_n: 0,
        stage: 255,
        out_name: Nm { start: 0, len: 0 },
        pool: Vec::<u8, _>::with_capacity_in(4096usize, a),
        ret_ty: -1,
        kinds: Vec::new_in(a),
        snames: Vec::new_in(a),
        spans: Vec::new_in(a),
    };
    for t in 0..m.types.len() as i64 {
        w.tname.push(Nm { start: 0, len: 0 });
        w.tdone.push(false);
        w.kinds.push(m.types[t as usize].kind);
    }
    // module-scope names: structs, functions and globals, unique among
    // themselves (escape is one to one, and WGSL names them in one scope)
    for t in 0..m.types.len() as i64 {
        if m.types[t as usize].kind == TK_STRUCT {
            let n = w.escape(m.types[t as usize].name);
            w.used.push(n);
            w.snames.push(n);
        }
    }
    for h in 0..m.functions.len() as i64 {
        let n = w.unique(m.functions[h as usize].name);
        w.fnames.push(n);
    }
    for g in 0..m.globals.len() as i64 {
        let n = w.unique(m.globals[g as usize].name);
        w.gnames.push(n);
    }
    w
}

fn helpers<B: Allocator, A: Allocator + Copy>(w: &W<A>, out: &mut Vec<u8, B>) {
    if w.need_div {
        out.extend_from_slice(b"static inline int _w_div(int a, int b) { return a / metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); }\n");
        out.extend_from_slice(b"static inline uint _w_div(uint a, uint b) { return a / metal::select(b, 1u, b == 0u); }\n");
        out.extend_from_slice(b"static inline int _w_mod(int a, int b) { int c = metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); return a - (a / c) * c; }\n");
        out.extend_from_slice(b"static inline uint _w_mod(uint a, uint b) { return metal::select(a % metal::select(b, 1u, b == 0u), 0u, b == 0u); }\n");
        for n in 2..5 {
            for k in 0..2 {
                let t = if k == 0 { "int" } else { "uint" };
                write(out, "static inline metal::{t}{n} _w_div(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_div(a[i], b[i]); return r; }}\n").unwrap();
                write(out, "static inline metal::{t}{n} _w_mod(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_mod(a[i], b[i]); return r; }}\n").unwrap();
            }
        }
    }
    if w.need_f2i {
        out.extend_from_slice(b"static inline int _w_f2i(float x) { return metal::isnan(x) ? 0 : int(metal::clamp(x, -2147483648.0f, 2147483520.0f)); }\n");
        out.extend_from_slice(b"static inline uint _w_f2u(float x) { return metal::isnan(x) ? 0u : uint(metal::clamp(x, 0.0f, 4294967040.0f)); }\n");
        for n in 2..5 {
            write(out, "static inline metal::int{n} _w_f2i(metal::float{n} x) {{ metal::int{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2i(x[i]); return r; }}\n").unwrap();
            write(out, "static inline metal::uint{n} _w_f2u(metal::float{n} x) {{ metal::uint{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2u(x[i]); return r; }}\n").unwrap();
        }
    }
    if w.need_sign {
        out.extend_from_slice(b"template <typename T> static inline T _w_isign(T x) { return metal::select(metal::select(T(0), T(-1), x < T(0)), T(1), x > T(0)); }\n");
    }
    if w.need_flb {
        out.extend_from_slice(b"static inline uint _w_flb(uint x) { return metal::select(31u - metal::clz(x), 4294967295u, x == 0u); }\n");
        out.extend_from_slice(b"static inline int _w_flb(int x) { uint y = as_type<uint>(metal::select(x, ~x, x < 0)); return as_type<int>(metal::select(31u - metal::clz(y), 4294967295u, y == 0u)); }\n");
        for n in 2..5 {
            for k in 0..2 {
                let t = if k == 0 { "int" } else { "uint" };
                write(out, "static inline metal::{t}{n} _w_flb(metal::{t}{n} x) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_flb(x[i]); return r; }}\n").unwrap();
            }
        }
    }
    if w.need_ftb {
        out.extend_from_slice(b"template <typename T> static inline T _w_ftb(T x) { return metal::select(metal::ctz(x), T(4294967295u), x == T(0)); }\n");
    }
    for i in 0..w.need_cmpxchg.len() as i64 {
        out.extend_from_slice(w.s(w.need_cmpxchg[i as usize]));
    }
}

fn finish<A: Allocator + Copy>(w: &W<A>, out: &mut Vec<u8, Gpa>) {
    out.extend_from_slice(
        b"// Generated by wgslc (MSL 3.0).\n#include <metal_stdlib>\n#include <simd/simd.h>\n\n");
    helpers(w, out);
    out.push(b'\n');
    out.extend_from_slice(w.types_out.as_slice());
    out.extend_from_slice(w.out.as_slice());
}

// ---- Shader compiler implementation, msl: Functions (0.22) ----

fn count_refs<A: Allocator + Copy>(w: &mut W<A>, f: &Function<'_, A>) {
    w.refc.clear();
    w.baked.clear();
    for _ in 0..f.exprs.len() as i64 {
        w.refc.push(0);
        w.baked.push(false);
    }
    for e in 0..f.exprs.len() as i64 {
        let x = f.exprs[e as usize];
        let op = x.op;
        if op == E_ACCESS || op == E_BINARY {
            if op == E_ACCESS {
                w.refc[x.a as usize] += 1;
                w.refc[x.b as usize] += 1;
            } else {
                w.refc[x.b as usize] += 1;
                w.refc[x.c as usize] += 1;
            }
        }
        else if op == E_ACCESS_INDEX || op == E_SPLAT || op == E_SWIZZLE || op == E_LOAD
            || op == E_CONVERT || op == E_BITCAST {
            w.refc[x.a as usize] += 1;
        } else if op == E_UNARY || op == E_DERIVATIVE {
            w.refc[x.b as usize] += 1;
        } else if op == E_SELECT {
            w.refc[x.a as usize] += 1;
            w.refc[x.b as usize] += 1;
            w.refc[x.c as usize] += 1;
        } else if op == E_COMPOSE {
            for k in x.a..x.a + x.b {
                w.refc[f.args[k as usize] as usize] += 1;
            }
        } else if op == E_MATH {
            for k in x.b..x.b + x.c {
                w.refc[f.args[k as usize] as usize] += 1;
            }
        } else if op == E_IMAGE_SAMPLE {
            for k in x.c..x.c + (x.d >> 8) {
                w.refc[f.args[k as usize] as usize] += 1;
            }
        } else if op == E_IMAGE_LOAD {
            for k in x.c..x.c + x.d {
                w.refc[f.args[k as usize] as usize] += 1;
            }
        } else if op == E_IMAGE_QUERY {
            if x.c >= 0 {
                w.refc[x.c as usize] += 1;
            }
        }
    }
    for s in 0..f.stmts.len() as i64 {
        let st = f.stmts[s as usize];
        if st.op == S_IF || st.op == S_SWITCH {
            w.refc[st.a as usize] += 1;
        } else if st.op == S_STORE {
            w.refc[st.a as usize] += 1;
            w.refc[st.b as usize] += 1;
        } else if st.op == S_RETURN && st.a >= 0 {
            w.refc[st.a as usize] += 1;
        } else if st.op == S_LOOP && st.c >= 0 {
            w.refc[st.c as usize] += 1;
        } else if st.op == S_CALL {
            for k in st.b..st.b + st.c {
                w.refc[f.args[k as usize] as usize] += 1;
            }
        } else if st.op == S_ATOMIC {
            if st.c >= 0 {
                w.refc[st.c as usize] += 1;
            }
            if st.e >= 0 {
                w.refc[st.e as usize] += 1;
            }
        } else if st.op == S_IMAGE_STORE {
            w.refc[st.b as usize] += 1;
            w.refc[st.c as usize] += 1;
            if st.d >= 0 {
                w.refc[st.d as usize] += 1;
            }
        }
    }
    for e in 0..f.exprs.len() as i64 {
        let x = f.exprs[e as usize];
        let op = x.op;
        let leaf = op == E_LITERAL || op == E_ARG || op == E_GLOBAL || op == E_LOCAL
            || op == E_CALL_RESULT || op == E_ATOMIC_RESULT || op == E_WG_UNIFORM_RESULT;
        if leaf {
            continue;
        }
        let k = w.kinds[f.exprs[e as usize].ty as usize];
        if k == TK_POINTER {
            continue;
        }
        if op == E_LOAD || op == E_IMAGE_SAMPLE || op == E_IMAGE_LOAD || op == E_DERIVATIVE
            || w.refc[e as usize] > 1 || f.names[e as usize].len() as i64 > 0 {
            w.baked[e as usize] = true;
        }
    }
}

// ---- Shader compiler implementation, msl: Expressions (0.22) ----

impl<A: Allocator + Copy> W<A> {
    fn lit(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        let sk = m.types[x.ty as usize].scalar;
        if sk == SK_BOOL {
            self.p(if x.a != 0 { b"true" } else { b"false" });
        } else if sk == SK_U32 {
            write(self.out, "{}u", x.a).unwrap();
        } else if sk == SK_I32 {
            let v = x.a as u32 as i32 as i64;
            if v == -2147483648 {
                self.p(b"(-2147483647 - 1)");
            } else if v < 0 {
                write(self.out, "({v})").unwrap();
            } else {
                write(self.out, "{v}").unwrap();
            }
        } else {
            let v = bits_f32(x.a as u32);
            let ex = (x.a >> 23) & 255;
            if ex == 255 {
                write(self.out, "as_type<float>({}u)", x.a).unwrap();
                return;
            }
            let mut b = Vec::<u8, _>::new_in(self.a);
            write(b, "{v}").unwrap();
            let s = b.as_slice();
            let mut has_dot = false;
            for i in 0..s.len() as i64 {
                if s[i as usize] == b'.' || s[i as usize] == b'e' || s[i as usize] == b'E'
                    || s[i as usize] == b'n' || s[i as usize] == b'i' {
                    has_dot = true;
                }
            }
            if s[0] == b'-' {
                self.p(b"(");
            }
            self.p(s);
            if !has_dot {
                self.p(b".0");
            }
            self.p(b"f");
            if s[0] == b'-' {
                self.p(b")");
            }
        }
    }

    // e as a value: its name, or its text.
    fn val(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let op = f.exprs[e as usize].op;
        if self.baked[e as usize] || op == E_CALL_RESULT || op == E_ATOMIC_RESULT
            || op == E_WG_UNIFORM_RESULT {
            self.pn(self.enames[e as usize]);
            return;
        }
        if op == E_ARG {
            self.pn(self.enames[e as usize]);
            return;
        }
        self.render(m, f, e);
    }

    // The unsigned type of the same shape as t (i32 -> uint, int3 -> uint3).
    fn utype(&mut self, m: &Module<'_, A>, t: i64) -> Nm {
        let ty = m.types[t as usize];
        if ty.kind == TK_VECTOR {
            let st = self.pool.len() as i64;
            write(self.pool, "metal::uint{}", ty.n).unwrap();
            return self.since(st);
        }
        self.intern(b"uint")
    }

    // The index of an E_ACCESS, clamped when its check says so.
    fn index(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        if x.c == CK_CLAMP {
            self.p(b"metal::min(uint(");
            self.val(m, f, x.b);
            write(self.out, "), {}u)", x.d - 1).unwrap();
        } else {
            self.val(m, f, x.b);
        }
    }

    // A pointer expression as an lvalue.
    fn lval(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        if x.op == E_GLOBAL {
            self.pn(self.gnames[x.a as usize]);
        } else if x.op == E_LOCAL {
            self.pn(self.lnames[x.a as usize]);
        } else if x.op == E_ARG {
            write(self.out, "(*{})",
                str::from_utf8(nm(&self.pool, self.enames[e as usize])).unwrap()).unwrap();
        } else if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {
            let bt = m.types[m.pointee(f.exprs[x.a as usize].ty) as usize];
            self.lval(m, f, x.a);
            self.selector(m, f, e, bt);
        } else {
            self.p(b"/* not a pointer */");
        }
    }

    // `.member`, `[i]` or `.inner[i]` after a base of type bt.
    fn selector(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64, bt: Type<'_>) {
        let x = f.exprs[e as usize];
        if x.op == E_ACCESS_INDEX {
            if bt.kind == TK_STRUCT {
                self.p(b".");
                let n = self.escape(m.members[(bt.mstart + x.b) as usize].name);
                self.pn(n);
            } else if bt.kind == TK_ARRAY && bt.n > 0 {
                write(self.out, ".inner[{}]", x.b).unwrap();
            } else {
                write(self.out, "[{}]", x.b).unwrap();
            }
            return;
        }
        if bt.kind == TK_ARRAY && bt.n > 0 {
            self.p(b".inner");
        }
        self.p(b"[");
        self.index(m, f, e);
        self.p(b"]");
    }

    // Whether e (a pointer, or a member value) is a struct's vec3 member,
    // which MSL holds packed.
    fn is_packed_member(&self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) -> bool {
        let x = f.exprs[e as usize];
        if x.op != E_ACCESS_INDEX {
            return false;
        }
        let bt0 = f.exprs[x.a as usize].ty;
        let bt = if m.types[bt0 as usize].kind == TK_POINTER { m.types[bt0 as usize].base }
            else { bt0 };
        if m.types[bt as usize].kind != TK_STRUCT {
            return false;
        }
        let mt = m.types[m.members[(m.types[bt as usize].mstart + x.b) as usize].ty as usize];
        mt.kind == TK_VECTOR && mt.n == 3
    }

    // The conditions under which the pointer e is in range (runtime-sized
    // arrays); false when there are none.
    fn guards(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64, any: bool) -> bool {
        let x = f.exprs[e as usize];
        let mut a = any;
        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {
            a = self.guards(m, f, x.a, a);
            if x.op == E_ACCESS && x.c == CK_RZSW {
                if a {
                    self.p(b" && ");
                }
                self.p(b"uint(");
                self.val(m, f, x.b);
                self.p(b") < ");
                self.runtime_len(m, f, x.a);
                a = true;
            }
        }
        a
    }

    fn has_guards(&self, f: &Function<'_, A>, e: i64) -> bool {
        let x = f.exprs[e as usize];
        if x.op == E_ACCESS && x.c == CK_RZSW {
            return true;
        }
        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {
            return self.has_guards(f, x.a);
        }
        false
    }

    // The length of the runtime-sized array pointer `base` points to.
    fn runtime_len(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, base: i64) {
        let b = f.exprs[base as usize];
        let mut g: i64 = -1;
        let mut off: i64 = 0;
        if b.op == E_GLOBAL {
            g = b.a;
        } else if b.op == E_ACCESS_INDEX && f.exprs[b.a as usize].op == E_GLOBAL {
            g = f.exprs[b.a as usize].a;
            let st = m.types[m.globals[g as usize].ty as usize];
            off = m.members[(st.mstart + b.b) as usize].offset;
        }
        let stride = m.types[m.pointee(b.ty) as usize].stride;
        self.len_text(g, off, stride);
    }

    fn len_text(&mut self, g: i64, off: i64, stride: i64) {
        if g < 0 {
            self.p(b"0u");
            return;
        }
        let k = self.sl.size_index[g as usize];
        if off == 0 {
            write(self.out, "(_w_sizes[{k}] / {stride}u)").unwrap();
        } else {
            write(self.out, "(_w_sizes[{k}] >= {off}u ? (_w_sizes[{k}] - {off}u) / {stride}u : 0u)").unwrap();
        }
    }

    fn render(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        let op = x.op;
        let t = m.types[x.ty as usize];
        if op == E_LITERAL {
            self.lit(m, f, e);
        } else if op == E_ZERO {
            self.pty(m, x.ty);
            self.p(b" {}");
        } else if op == E_COMPOSE {
            let tn = self.ty(m, x.ty);
            self.pn(tn);
            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {
                self.p(b"(");
            } else if t.kind == TK_ARRAY {
                self.p(b" {{");
            } else {
                self.p(b" {");
            }
            for k in 0..x.b {
                if k > 0 {
                    self.p(b", ");
                }
                if t.kind == TK_STRUCT && W::<A>::pads_before(m, x.ty, k) {
                    self.p(b"{}, ");
                }
                self.val(m, f, f.args[(x.a + k) as usize]);
            }
            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {
                self.p(b")");
            } else if t.kind == TK_ARRAY {
                self.p(b"}}");
            } else {
                self.p(b"}");
            }
        } else if op == E_SPLAT {
            self.pty(m, x.ty);
            self.p(b"(");
            self.val(m, f, x.a);
            self.p(b")");
        } else if op == E_SWIZZLE {
            self.p(b"(");
            self.val(m, f, x.a);
            self.p(b").");
            for k in 0..x.c {
                self.out.push("xyzw"[((x.b >> (2 * k)) & 3) as usize]);
            }
        } else if op == E_ACCESS || op == E_ACCESS_INDEX {
            let bt = m.types[f.exprs[x.a as usize].ty as usize];
            let packed = op == E_ACCESS_INDEX && self.is_packed_member(m, f, e);
            if packed {
                self.pty(m, x.ty);
                self.p(b"(");
            }
            self.p(b"(");
            self.val(m, f, x.a);
            self.p(b")");
            self.selector(m, f, e, bt);
            if packed {
                self.p(b")");
            }
        } else if op == E_LOAD {
            let pe = x.a;
            let g = self.has_guards(f, pe);
            if g {
                self.p(b"(");
                self.guards(m, f, pe, false);
                self.p(b" ? ");
            }
            let packed = self.is_packed_member(m, f, pe);
            if packed {
                self.pty(m, x.ty);
                self.p(b"(");
            }
            self.lval(m, f, pe);
            if packed {
                self.p(b")");
            }
            if g {
                self.p(b" : ");
                self.pty(m, x.ty);
                self.p(b" {})");
            }
        } else if op == E_UNARY {
            let sk = t.scalar;
            if x.a == UN_NEG && sk == SK_I32 {
                let _n1 = self.ty(m, x.ty);
                let _n2 = self.utype(m, x.ty);
                write(self.out, "as_type<{}>(-as_type<{}>(",
                    str::from_utf8(nm(&self.pool, _n1)).unwrap(),
                    str::from_utf8(nm(&self.pool, _n2)).unwrap()).unwrap();
                self.val(m, f, x.b);
                self.p(b"))");
            } else {
                self.p(if x.a == UN_NEG { b"(-" } else if x.a == UN_NOT { b"(!" } else { b"(~" });
                self.val(m, f, x.b);
                self.p(b")");
            }
        } else if op == E_BINARY {
            self.binary(m, f, e);
        } else if op == E_SELECT {
            let ct = m.types[f.exprs[x.a as usize].ty as usize];
            if ct.kind == TK_SCALAR {
                self.p(b"(");
                self.val(m, f, x.a);
                self.p(b" ? ");
                self.val(m, f, x.b);
                self.p(b" : ");
                self.val(m, f, x.c);
                self.p(b")");
            } else {
                self.p(b"metal::select(");
                self.val(m, f, x.c);
                self.p(b", ");
                self.val(m, f, x.b);
                self.p(b", ");
                self.val(m, f, x.a);
                self.p(b")");
            }
        } else if op == E_CONVERT {
            let from = m.types[f.exprs[x.a as usize].ty as usize].scalar;
            if from == SK_F32 && (t.scalar == SK_I32 || t.scalar == SK_U32) {
                self.need_f2i = true;
                self.p(if t.scalar == SK_I32 { b"_w_f2i(" } else { b"_w_f2u(" });
            } else {
                self.pty(m, x.ty);
                self.p(b"(");
            }
            self.val(m, f, x.a);
            self.p(b")");
        } else if op == E_BITCAST {
            let _n3 = self.ty(m, x.ty);
            write(self.out, "as_type<{}>(", str::from_utf8(nm(&self.pool, _n3)).unwrap()).unwrap();
            self.val(m, f, x.a);
            self.p(b")");
        } else if op == E_MATH {
            self.math(m, f, e);
        } else if op == E_ARRAY_LENGTH {
            self.len_text(x.a, x.c, x.d);
        } else if op == E_DERIVATIVE {
            self.p(if x.a == 0 { b"metal::dfdx(" } else if x.a == 1 { b"metal::dfdy(" }
                else { b"metal::fwidth(" });
            self.val(m, f, x.b);
            self.p(b")");
        } else if op == E_IMAGE_SAMPLE {
            self.sample(m, f, e);
        } else if op == E_IMAGE_LOAD {
            self.image_load(m, f, e);
        } else if op == E_IMAGE_QUERY {
            let tex = self.enames_or_global(m, f, x.a);
            if x.b == IQ_LEVELS {
                write(self.out, "{}.get_num_mip_levels()",
                    str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
            } else if x.b == IQ_LAYERS {
                write(self.out, "{}.get_array_size()", str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
            } else {
                let tt = m.types[f.exprs[x.a as usize].ty as usize];
                if x.c >= 0 && tt.n != TEX_STORAGE_2D {
                    write(self.out, "metal::uint2({}.get_width(",
                        str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
                    self.val(m, f, x.c);
                    write(self.out, "), {}.get_height(",
                        str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
                    self.val(m, f, x.c);
                    self.p(b"))");
                } else {
                    write(self.out, "metal::uint2({}.get_width(), {}.get_height())",
                        str::from_utf8(nm(&self.pool, tex)).unwrap(),
                        str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
                }
            }
        } else {
            self.p(b"/* ? */");
        }
    }

    fn enames_or_global(&self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) -> Nm {
        let x = f.exprs[e as usize];
        if x.op == E_GLOBAL {
            return self.gnames[x.a as usize];
        }
        self.enames[e as usize]
    }

    fn binary(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        let op = x.a;
        let lt = m.types[f.exprs[x.b as usize].ty as usize];
        let sk = lt.scalar;
        let int = (sk == SK_I32 || sk == SK_U32) && lt.kind != TK_MATRIX;
        if int && (op == OP_DIV || op == OP_MOD) {
            // a literal divisor other than 0 (and -1 for i32) needs no helper
            let r = f.exprs[x.c as usize];
            let lit_ok = r.op == E_LITERAL && r.a != 0 && !(sk == SK_I32 && r.a == 4294967295);
            if lit_ok && !(sk == SK_I32 && op == OP_MOD) {
                self.p(b"(");
                self.val(m, f, x.b);
                self.p(if op == OP_DIV { b" / " } else { b" % " });
                self.val(m, f, x.c);
                self.p(b")");
                return;
            }
            self.need_div = true;
            self.p(if op == OP_DIV { b"_w_div(" } else { b"_w_mod(" });
            self.val(m, f, x.b);
            self.p(b", ");
            self.val(m, f, x.c);
            self.p(b")");
            return;
        }
        if sk == SK_I32 && (op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_SHL) {
            let tn = self.ty(m, f.exprs[x.b as usize].ty);
            let un = self.utype(m, f.exprs[x.b as usize].ty);
            write(self.out, "as_type<{}>(as_type<{}>(", str::from_utf8(nm(&self.pool, tn)).unwrap(),
                str::from_utf8(nm(&self.pool, un)).unwrap()).unwrap();
            self.val(m, f, x.b);
            self.p(if op == OP_ADD { b") + as_type<" } else if op == OP_SUB { b") - as_type<" }
                else if op == OP_MUL { b") * as_type<" } else { b") << (" });
            if op == OP_SHL {
                self.val(m, f, x.c);
                self.p(b" & 31u))");
            } else {
                write(self.out, "{}>(", str::from_utf8(nm(&self.pool, un)).unwrap()).unwrap();
                self.val(m, f, x.c);
                self.p(b"))");
            }
            return;
        }
        if op == OP_MOD && sk == SK_F32 {
            self.p(b"metal::fmod(");
            self.val(m, f, x.b);
            self.p(b", ");
            self.val(m, f, x.c);
            self.p(b")");
            return;
        }
        self.p(b"(");
        self.val(m, f, x.b);
        let s = if op == OP_ADD {
            b" + "
        } else if op == OP_SUB {
            b" - "
        } else if op == OP_MUL {
            b" * "
        } else if op == OP_DIV {
            b" / "
        } else if op == OP_EQ {
            b" == "
        } else if op == OP_NE {
            b" != "
        } else if op == OP_LT {
            b" < "
        } else if op == OP_LE {
            b" <= "
        } else if op == OP_GT {
            b" > "
        } else if op == OP_GE {
            b" >= "
        } else if op == OP_AND {
            if sk == SK_BOOL && lt.kind == TK_SCALAR { b" && " } else { b" & " }
        } else if op == OP_OR {
            if sk == SK_BOOL && lt.kind == TK_SCALAR { b" || " } else { b" | " }
        } else if op == OP_XOR {
            if sk == SK_BOOL { b" != " } else { b" ^ " }
        } else if op == OP_SHL {
            b" << ("
        } else if op == OP_SHR {
            b" >> ("
        } else if op == OP_LAND {
            b" && "
        } else {
            b" || "
        };
        self.p(s);
        self.val(m, f, x.c);
        if op == OP_SHL || op == OP_SHR {
            self.p(b" & 31u)");
        }
        self.p(b")");
    }

    fn math(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        let fun = x.a;
        let a0 = f.args[x.b as usize];
        let at = m.types[f.exprs[a0 as usize].ty as usize];
        let sk = at.scalar;
        let int = sk == SK_I32 || sk == SK_U32;
        if fun == ir::MF_ABS && sk == SK_I32 {
            // abs(MIN) is MIN: through uint
            let _n4 = self.ty(m, x.ty);
            let _n5 = self.utype(m, x.ty);
            write(self.out, "as_type<{}>(metal::select(as_type<{}>(",
                str::from_utf8(nm(&self.pool, _n4)).unwrap(),
                str::from_utf8(nm(&self.pool, _n5)).unwrap()).unwrap();
            self.val(m, f, a0);
            let _n6 = self.utype(m, x.ty);
            write(self.out, "), -as_type<{}>(", str::from_utf8(nm(&self.pool, _n6)).unwrap()).unwrap();
            self.val(m, f, a0);
            self.p(b"), ");
            self.val(m, f, a0);
            let _n7 = self.ty(m, x.ty);
            write(self.out, " < {}(0)))", str::from_utf8(nm(&self.pool, _n7)).unwrap()).unwrap();
            return;
        }
        if fun == ir::MF_ABS && sk == SK_U32 {
            self.val(m, f, a0);
            return;
        }
        if fun == ir::MF_SIGN && int {
            self.need_sign = true;
            self.p(b"_w_isign(");
            self.val(m, f, a0);
            self.p(b")");
            return;
        }
        if fun == ir::MF_DOT && int {
            // wrapping: as the sum of products, through uint
            let n = at.n;
            write(self.out, "as_type<{}>(", str::from_utf8(W::<A>::scalar(sk)).unwrap()).unwrap();
            for k in 0..n {
                if k > 0 {
                    self.p(b" + ");
                }
                self.p(b"as_type<uint>(");
                self.val(m, f, a0);
                write(self.out, "[{k}]) * as_type<uint>(").unwrap();
                self.val(m, f, f.args[(x.b + 1) as usize]);
                write(self.out, "[{k}])").unwrap();
            }
            self.p(b")");
            return;
        }
        if fun == ir::MF_FIRST_LEADING_BIT {
            self.need_flb = true;
            self.p(b"_w_flb(");
            self.val(m, f, a0);
            self.p(b")");
            return;
        }
        if fun == ir::MF_FIRST_TRAILING_BIT {
            self.need_ftb = true;
            self.p(b"_w_ftb(");
            self.val(m, f, a0);
            self.p(b")");
            return;
        }
        if fun == ir::MF_EXTRACT_BITS || fun == ir::MF_INSERT_BITS {
            // WGSL clamps offset and count; Metal leaves them undefined
            let k: i64 = if fun == ir::MF_EXTRACT_BITS { 1 } else { 2 };
            self.p(if fun == ir::MF_EXTRACT_BITS { b"metal::extract_bits(" }
                else { b"metal::insert_bits(" });
            for i in 0..k {
                self.val(m, f, f.args[(x.b + i) as usize]);
                self.p(b", ");
            }
            self.p(b"metal::min(");
            self.val(m, f, f.args[(x.b + k) as usize]);
            self.p(b", 32u), metal::min(");
            self.val(m, f, f.args[(x.b + k + 1) as usize]);
            self.p(b", 32u - metal::min(");
            self.val(m, f, f.args[(x.b + k) as usize]);
            self.p(b", 32u)))");
            return;
        }
        if fun == ir::MF_DEGREES || fun == ir::MF_RADIANS {
            self.p(b"(");
            self.val(m, f, a0);
            self.p(if fun == ir::MF_DEGREES { b" * 57.2957795131f)" }
                else { b" * 0.0174532925199f)" });
            return;
        }
        if fun == ir::MF_PACK2X16FLOAT {
            self.p(b"as_type<uint>(metal::half2(");
            self.val(m, f, a0);
            self.p(b"))");
            return;
        }
        if fun == ir::MF_UNPACK2X16FLOAT {
            self.p(b"metal::float2(as_type<metal::half2>(");
            self.val(m, f, a0);
            self.p(b"))");
            return;
        }
        let name = if fun < MATH_NAMES.len() as i64 {
            MATH_NAMES[fun as usize]
        } else if fun == ir::MF_COUNT_ONE_BITS {
            b"popcount"
        } else if fun == ir::MF_COUNT_LEADING_ZEROS {
            b"clz"
        } else if fun == ir::MF_COUNT_TRAILING_ZEROS {
            b"ctz"
        } else if fun == ir::MF_REVERSE_BITS {
            b"reverse_bits"
        } else if fun == ir::MF_ALL {
            b"all"
        } else if fun == ir::MF_ANY {
            b"any"
        } else if fun == ir::MF_SATURATE {
            b"saturate"
        } else if fun == ir::MF_ASINH {
            b"asinh"
        } else if fun == ir::MF_ACOSH {
            b"acosh"
        } else if fun == ir::MF_ATANH {
            b"atanh"
        } else if fun == ir::MF_FACE_FORWARD {
            b"faceforward"
        } else if fun == ir::MF_LDEXP {
            b"ldexp"
        } else if fun == ir::MF_PACK4X8UNORM {
            b"pack_float_to_unorm4x8"
        } else if fun == ir::MF_UNPACK4X8UNORM {
            b"unpack_unorm4x8_to_float"
        } else if fun == ir::MF_PACK4X8SNORM {
            b"pack_float_to_snorm4x8"
        } else if fun == ir::MF_UNPACK4X8SNORM {
            b"unpack_snorm4x8_to_float"
        } else if fun == ir::MF_PACK2X16UNORM {
            b"pack_float_to_unorm2x16"
        } else if fun == ir::MF_UNPACK2X16UNORM {
            b"unpack_unorm2x16_to_float"
        } else if fun == ir::MF_PACK2X16SNORM {
            b"pack_float_to_snorm2x16"
        } else {
            b"unpack_snorm2x16_to_float"
        };
        self.p(b"metal::");
        self.p(name);
        self.p(b"(");
        for k in 0..x.c {
            if k > 0 {
                self.p(b", ");
            }
            self.val(m, f, f.args[(x.b + k) as usize]);
        }
        self.p(b")");
    }

    fn sample(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        let kind = x.d & 255;
        let n = x.d >> 8;
        let tt = m.types[f.exprs[x.a as usize].ty as usize];
        let tex = self.enames_or_global(m, f, x.a);
        let smp = self.enames_or_global(m, f, x.b);
        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;
        write(self.out, "{}.{}({}, ", str::from_utf8(nm(&self.pool, tex)).unwrap(),
            if compare { "sample_compare" } else { "sample" },
            str::from_utf8(nm(&self.pool, smp)).unwrap()).unwrap();
        self.val(m, f, f.args[x.c as usize]);
        let mut k: i64 = 1;
        if tt.n == TEX_2D_ARRAY {
            self.p(b", ");
            self.val(m, f, f.args[(x.c + 1) as usize]);
            k = 2;
        }
        if kind == IMG_SAMPLE_BIAS {
            self.p(b", metal::bias(");
            self.val(m, f, f.args[(x.c + k) as usize]);
            self.p(b")");
        } else if kind == IMG_SAMPLE_LEVEL {
            self.p(b", metal::level(");
            self.val(m, f, f.args[(x.c + k) as usize]);
            self.p(b")");
        } else if compare {
            self.p(b", ");
            self.val(m, f, f.args[(x.c + k) as usize]);
            if kind == IMG_SAMPLE_COMPARE_LEVEL {
                self.p(b", metal::level(0)");
            }
        }
        let _ = n;
        self.p(b")");
    }

    // textureLoad: the level, layer and coordinates clamped into range.
    fn image_load(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        let x = f.exprs[e as usize];
        let tt = m.types[f.exprs[x.a as usize].ty as usize];
        let tex = self.enames_or_global(m, f, x.a);
        let arrayed = tt.n == TEX_2D_ARRAY;
        let lvl = f.args[(x.c + x.d - 1) as usize];
        let saved = mem::replace(&mut self.out, Vec::<u8, _>::new_in(self.a));
        self.out.extend_from_slice(b"metal::min(uint(");
        self.val(m, f, lvl);
        write(self.out, "), {}.get_num_mip_levels() - 1u)",
            str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
        let lb = mem::replace(&mut self.out, saved);
        let l = lb.as_slice();
        write(self.out, "{}.read(metal::min(metal::uint2(",
            str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
        self.val(m, f, f.args[x.c as usize]);
        { let l = str::from_utf8(l).unwrap();
            write(self.out, "), metal::uint2({}.get_width({l}) - 1u, {}.get_height({l}) - 1u))",
                str::from_utf8(nm(&self.pool, tex)).unwrap(),
                str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap() };
        if arrayed {
            self.p(b", metal::min(uint(");
            self.val(m, f, f.args[(x.c + 1) as usize]);
            write(self.out, "), {}.get_array_size() - 1u)",
                str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
        }
        { let l = str::from_utf8(l).unwrap(); write(self.out, ", {l})").unwrap() };
    }
}

// ---- Shader compiler implementation, msl: Statements (0.22) ----

impl<A: Allocator + Copy> W<A> {
    fn block(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, blk: i64) {
        let b = f.blocks[blk as usize];
        for i in b.start..b.start + b.count {
            self.stmt(m, f, f.items[i as usize]);
        }
    }

    fn braced(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, blk: i64) {
        self.p(b"{");
        self.indent += 1;
        self.block(m, f, blk);
        self.indent -= 1;
        self.line();
        self.p(b"}");
    }

    fn atomic_fn(fun: i64) -> &'static [u8] {
        if fun == AT_ADD {
            b"metal::atomic_fetch_add_explicit"
        } else if fun == AT_SUB {
            b"metal::atomic_fetch_sub_explicit"
        } else if fun == AT_AND {
            b"metal::atomic_fetch_and_explicit"
        } else if fun == AT_OR {
            b"metal::atomic_fetch_or_explicit"
        } else if fun == AT_XOR {
            b"metal::atomic_fetch_xor_explicit"
        } else if fun == AT_MIN {
            b"metal::atomic_fetch_min_explicit"
        } else if fun == AT_MAX {
            b"metal::atomic_fetch_max_explicit"
        } else if fun == AT_EXCHANGE {
            b"metal::atomic_exchange_explicit"
        } else if fun == AT_LOAD {
            b"metal::atomic_load_explicit"
        } else {
            b"metal::atomic_store_explicit"
        }
    }

    fn stmt(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, s: i64) {
        let st = f.stmts[s as usize];
        let op = st.op;
        if op == S_EMIT {
            for e in st.a..st.b {
                if self.baked[e as usize] {
                    self.line();
                    self.pty(m, f.exprs[e as usize].ty);
                    self.p(b" ");
                    self.pn(self.enames[e as usize]);
                    self.p(b" = ");
                    self.render(m, f, e);
                    self.p(b";");
                }
            }
            return;
        }
        self.line();
        if op == S_STORE {
            let g = self.has_guards(f, st.a);
            if g {
                self.p(b"if (");
                self.guards(m, f, st.a, false);
                self.p(b") { ");
            }
            self.lval(m, f, st.a);
            self.p(b" = ");
            self.val(m, f, st.b);
            self.p(b";");
            if g {
                self.p(b" }");
            }
        } else if op == S_BLOCK {
            self.braced(m, f, st.a);
        } else if op == S_IF {
            self.p(b"if (");
            self.val(m, f, st.a);
            self.p(b") ");
            self.braced(m, f, st.b);
            if f.blocks[st.c as usize].count > 0 {
                self.p(b" else ");
                self.braced(m, f, st.c);
            }
        } else if op == S_SWITCH {
            self.p(b"switch (");
            self.val(m, f, st.a);
            self.p(b") {");
            for k in st.b..st.b + st.c {
                let c = f.cases[k as usize];
                self.line();
                for j in c.vstart..c.vstart + c.vcount {
                    let sel_t = m.types[f.exprs[st.a as usize].ty as usize].scalar;
                    if sel_t == SK_U32 {
                        write(self.out, "case {}u: ", f.vals[j as usize] & 4294967295).unwrap();
                    } else {
                        let v = f.vals[j as usize] as u32 as i32 as i64;
                        if v == -2147483648 {
                            self.p(b"case (-2147483647 - 1): ");
                        } else {
                            write(self.out, "case {v}: ").unwrap();
                        }
                    }
                }
                if c.is_default {
                    self.p(b"default: ");
                }
                self.p(b"{");
                self.indent += 1;
                self.block(m, f, c.body);
                self.line();
                self.p(b"break;");
                self.indent -= 1;
                self.line();
                self.p(b"}");
            }
            self.line();
            self.p(b"}");
        } else if op == S_LOOP {
            let has_cont = f.blocks[st.b as usize].count > 0 || st.c >= 0;
            if !has_cont {
                self.p(b"while (true) ");
                self.braced(m, f, st.a);
                return;
            }
            let li = self.loop_n;
            self.loop_n += 1;
            write(self.out, "bool _w_loop{li} = true;").unwrap();
            self.line();
            self.p(b"while (true) {");
            self.indent += 1;
            self.line();
            write(self.out, "if (!_w_loop{li}) {{").unwrap();
            self.indent += 1;
            self.block(m, f, st.b);
            if st.c >= 0 {
                self.line();
                self.p(b"if (");
                self.val(m, f, st.c);
                self.p(b") { break; }");
            }
            self.indent -= 1;
            self.line();
            self.p(b"}");
            self.line();
            write(self.out, "_w_loop{li} = false;").unwrap();
            self.block(m, f, st.a);
            self.indent -= 1;
            self.line();
            self.p(b"}");
        } else if op == S_BREAK {
            self.p(b"break;");
        } else if op == S_CONTINUE {
            self.p(b"continue;");
        } else if op == S_RETURN {
            self.ret(m, f, st.a);
        } else if op == S_KILL {
            self.p(if self.stage == TEST_KERNEL { b"return;" }
                else { b"metal::discard_fragment();" });
        } else if op == S_BARRIER {
            self.p(if st.a
                == BARRIER_WORKGROUP {
                b"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);"
            } else { b"metal::threadgroup_barrier(metal::mem_flags::mem_device);" });
        } else if op == S_WG_UNIFORM_LOAD {
            self.p(b"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);");
            self.line();
            self.pty(m, f.exprs[st.b as usize].ty);
            write(self.out, " {} = ",
                str::from_utf8(nm(&self.pool, self.enames[st.b as usize])).unwrap()).unwrap();
            self.lval(m, f, st.a);
            self.p(b";");
            self.line();
            self.p(b"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);");
        } else if op == S_CALL {
            if st.d >= 0 {
                self.pty(m, f.exprs[st.d as usize].ty);
                write(self.out, " {} = ",
                    str::from_utf8(nm(&self.pool, self.enames[st.d as usize])).unwrap()).unwrap();
            }
            self.call(m, f, st.a, st.b, st.c);
            self.p(b";");
        } else if op == S_ATOMIC {
            self.atomic(m, f, s);
        } else if op == S_IMAGE_STORE {
            let tex = self.enames_or_global(m, f, st.a);
            self.p(b"if (metal::all(metal::uint2(");
            self.val(m, f, st.b);
            write(self.out, ") < metal::uint2({}.get_width(), {}.get_height()))) {{ {}.write(",
                str::from_utf8(nm(&self.pool, tex)).unwrap(),
                str::from_utf8(nm(&self.pool, tex)).unwrap(),
                str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();
            self.val(m, f, st.c);
            self.p(b", metal::uint2(");
            self.val(m, f, st.b);
            self.p(b")); }");
        }
    }

    fn atomic(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, s: i64) {
        let st = f.stmts[s as usize];
        let g = self.has_guards(f, st.a);
        let pt = m.types[f.exprs[st.a as usize].ty as usize];
        let sk = m.types[pt.base as usize].scalar;
        let tn = W::<A>::scalar(sk);
        let sp = W::<A>::space(pt.space, pt.access);
        if st.b == AT_CMPXCHG {
            let rty = self.ty(m, f.exprs[st.d as usize].ty);
            let mut rb = Vec::<u8, _>::new_in(self.a);
            rb.extend_from_slice(nm(&self.pool, rty));
            let rn = rb.as_slice();
            let hst = self.pool.len() as i64;
            let mut h = Vec::<u8, _>::new_in(self.a);
            { let rn = str::from_utf8(rn).unwrap(); { let sp = str::from_utf8(sp).unwrap(); { let tn = str::from_utf8(tn).unwrap(); write(h, "static inline {rn} _w_cmpxchg({sp} metal::atomic_{tn}* p, {tn} cmp, {tn} v) {{ {tn} old = cmp; bool ok = metal::atomic_compare_exchange_weak_explicit(p, &old, v, metal::memory_order_relaxed, metal::memory_order_relaxed); return {rn} {{old, ok}}; }}\n").unwrap() } } };
            copy_into(&mut self.pool, h.as_slice());
            let hs = self.since(hst);
            let mut have = false;
            for i in 0..self.need_cmpxchg.len() as i64 {
                if nm(&self.pool, self.need_cmpxchg[i as usize]) == nm(&self.pool, hs) {
                    have = true;
                }
            }
            if !have {
                self.need_cmpxchg.push(hs);
            }
            write(self.out, "{} {} = ", str::from_utf8(nm(&self.pool, rty)).unwrap(),
                str::from_utf8(nm(&self.pool, self.enames[st.d as usize])).unwrap()).unwrap();
            if g {
                self.p(b"(");
                self.guards(m, f, st.a, false);
                self.p(b") ? ");
            }
            self.p(b"_w_cmpxchg(&");
            self.lval(m, f, st.a);
            self.p(b", ");
            self.val(m, f, st.e);
            self.p(b", ");
            self.val(m, f, st.c);
            self.p(b")");
            if g {
                write(self.out, " : {} {{}}", str::from_utf8(nm(&self.pool, rty)).unwrap()).unwrap();
            }
            self.p(b";");
            return;
        }
        if st.d >= 0 {
            { let tn = str::from_utf8(tn).unwrap();
                write(self.out, "{tn} {} = ",
                    str::from_utf8(nm(&self.pool, self.enames[st.d as usize])).unwrap()).unwrap() };
        }
        if g {
            if st.d >= 0 {
                self.p(b"(");
                self.guards(m, f, st.a, false);
                self.p(b") ? ");
            } else {
                self.p(b"if (");
                self.guards(m, f, st.a, false);
                self.p(b") ");
            }
        }
        self.p(W::<A>::atomic_fn(st.b));
        self.p(b"(&");
        self.lval(m, f, st.a);
        if st.c >= 0 {
            self.p(b", ");
            self.val(m, f, st.c);
        }
        self.p(b", metal::memory_order_relaxed)");
        if g && st.d >= 0 {
            { let tn = str::from_utf8(tn).unwrap(); write(self.out, " : {tn}(0)").unwrap() };
        }
        self.p(b";");
    }

    fn call(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, callee: i64, start: i64,
        n: i64) {
        self.pn(self.fnames[callee as usize]);
        self.p(b"(");
        let mut first = true;
        for k in start..start + n {
            if !first {
                self.p(b", ");
            }
            first = false;
            let a = f.args[k as usize];
            if m.types[f.exprs[a as usize].ty as usize].kind == TK_POINTER {
                self.p(b"&");
                self.lval(m, f, a);
            } else {
                self.val(m, f, a);
            }
        }
        for g in 0..m.globals.len() as i64 {
            if self.uses[callee as usize][g as usize] {
                if !first {
                    self.p(b", ");
                }
                first = false;
                self.pn(self.gnames[g as usize]);
            }
        }
        if needs_sizes(self, m, callee) {
            if !first {
                self.p(b", ");
            }
            self.p(b"_w_sizes");
        }
        self.p(b")");
    }

    fn ret(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {
        if e < 0 {
            self.p(b"return;");
            return;
        }
        if self.stage == TEST_KERNEL {
            // a test kernel: the result into its output record
            self.p(b"{ _w_out[_w_tid] = ");
            self.val(m, f, e);
            self.p(b"; return; }");
            return;
        }
        if self.stage == 255 || self.stage == STAGE_COMPUTE as i64 {
            self.p(b"return ");
            self.val(m, f, e);
            self.p(b";");
            return;
        }
        // an entry point's result: into its output struct
        let rt = m.types[self.ret_ty as usize];
        self.p(b"{ const auto _w_r = ");
        self.val(m, f, e);
        write(self.out, "; return {} {{ ", str::from_utf8(nm(&self.pool, self.out_name)).unwrap()).unwrap();
        if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {
            for k in 0..rt.mcount {
                if k > 0 {
                    self.p(b", ");
                }
                let _n8 = self.escape(m.members[(rt.mstart + k) as usize].name);
                write(self.out, "_w_r.{}", str::from_utf8(nm(&self.pool, _n8)).unwrap()).unwrap();
            }
        } else {
            self.p(b"_w_r");
        }
        self.p(b" }; }");
    }
}

// ---- Shader compiler implementation, msl: Functions and entry points (0.22) ----

fn start_fn<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, h: i64) {
    let f = &m.functions[h as usize];
    w.fh = h;
    w.used.clear();
    w.loop_n = 0;
    // the module-scope names stay reserved
    for k in 0..w.fnames.len() as i64 {
        let n = w.fnames[k as usize];
        w.used.push(n);
    }
    for k in 0..w.gnames.len() as i64 {
        let n = w.gnames[k as usize];
        w.used.push(n);
    }
    for k in 0..w.snames.len() as i64 {
        let n = w.snames[k as usize];
        w.used.push(n);
    }
    count_refs(w, &f);
    w.enames.clear();
    for e in 0..f.exprs.len() as i64 {
        let x = f.exprs[e as usize];
        if x.op == E_ARG {
            let n = w.unique(f.params[x.a as usize].name);
            w.enames.push(n);
        }
        else if w.baked[e as usize] || x.op == E_CALL_RESULT || x.op == E_ATOMIC_RESULT
            || x.op == E_WG_UNIFORM_RESULT {
            if f.names[e as usize].len() as i64 > 0 {
                let n = w.unique(f.names[e as usize]);
                w.enames.push(n);
            } else {
                let st = w.pool.len() as i64;
                write(w.pool, "_e{e}").unwrap();
                let n = w.since(st);
                w.enames.push(n);
            }
        } else {
            w.enames.push(Nm { start: 0, len: 0 });
        }
    }
    w.lnames.clear();
    for l in 0..f.locals.len() as i64 {
        let n = w.unique(f.locals[l as usize].name);
        w.lnames.push(n);
    }
}

// The parameter list's global part: each global the function uses.
fn global_params<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, h: i64, first: bool) -> bool {
    let mut fst = first;
    for g in 0..m.globals.len() as i64 {
        if !w.uses[h as usize][g as usize] {
            continue;
        }
        if !fst {
            w.p(b", ");
        }
        fst = false;
        let gl = m.globals[g as usize];
        let tk = m.types[gl.ty as usize].kind;
        if gl.space == SP_HANDLE {
            w.pty(m, gl.ty);
            w.p(b" ");
        } else if tk == TK_ARRAY && m.types[gl.ty as usize].n == 0 {
            let _n9 = w.ty(m, m.types[gl.ty as usize].base);
            write(w.out, "{} {}* ", str::from_utf8(W::<A>::space(gl.space, gl.access)).unwrap(),
                str::from_utf8(nm(&w.pool, _n9)).unwrap()).unwrap();
        } else {
            let _n10 = w.ty(m, gl.ty);
            write(w.out, "{} {}& ", str::from_utf8(W::<A>::space(gl.space, gl.access)).unwrap(),
                str::from_utf8(nm(&w.pool, _n10)).unwrap()).unwrap();
        }
        w.pn(w.gnames[g as usize]);
    }
    if needs_sizes(w, m, h) {
        if !fst {
            w.p(b", ");
        }
        fst = false;
        w.p(b"constant uint* _w_sizes");
    }
    fst
}

fn declare_locals<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, f: &Function<'_, A>) {
    for l in 0..f.locals.len() as i64 {
        w.line();
        let _n11 = w.ty(m, f.locals[l as usize].ty);
        write(w.out, "{} {} = {{}};", str::from_utf8(nm(&w.pool, _n11)).unwrap(),
            str::from_utf8(nm(&w.pool, w.lnames[l as usize])).unwrap()).unwrap();
    }
}

fn write_fn<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, h: i64) {
    let f = &m.functions[h as usize];
    start_fn(w, m, h);
    w.spans.push(w.out.len() as i64);
    w.spans.push(h);
    w.stage = 255;
    w.p(b"\n");
    if f.result >= 0 {
        w.pty(m, f.result);
    } else {
        w.p(b"void");
    }
    write(w.out, " {}(", str::from_utf8(nm(&w.pool, w.fnames[h as usize])).unwrap()).unwrap();
    let mut first = true;
    for k in 0..f.params.len() as i64 {
        if !first {
            w.p(b", ");
        }
        first = false;
        let pt = m.types[f.params[k as usize].ty as usize];
        let ae = arg_expr(f, k);
        let pname = if ae >= 0 { w.enames[ae as usize] }
            else { w.unique(f.params[k as usize].name) };
        if pt.kind == TK_POINTER {
            let _n12 = w.ty(m, pt.base);
            write(w.out, "thread {}* {}", str::from_utf8(nm(&w.pool, _n12)).unwrap(),
                str::from_utf8(nm(&w.pool, pname)).unwrap()).unwrap();
        } else {
            let _n13 = w.ty(m, f.params[k as usize].ty);
            write(w.out, "{} {}", str::from_utf8(nm(&w.pool, _n13)).unwrap(),
                str::from_utf8(nm(&w.pool, pname)).unwrap()).unwrap();
        }
    }
    global_params(w, m, h, first);
    w.p(b") {");
    w.indent = 1;
    declare_locals(w, m, &f);
    w.block(m, &f, f.body);
    w.indent = 0;
    w.p(b"\n}\n");
}

fn arg_expr<A: Allocator + Copy>(f: &Function<'_, A>, k: i64) -> i64 {
    for e in 0..f.exprs.len() as i64 {
        if f.exprs[e as usize].op == E_ARG && f.exprs[e as usize].a == k {
            return e;
        }
    }
    -1
}

fn builtin_attr(b: i64) -> &'static [u8] {
    if b == BI_POSITION {
        b"position"
    } else if b == BI_VERTEX_INDEX {
        b"vertex_id"
    } else if b == BI_INSTANCE_INDEX {
        b"instance_id"
    } else if b == BI_FRONT_FACING {
        b"front_facing"
    } else if b == BI_FRAG_DEPTH {
        b"depth(any)"
    } else if b == BI_SAMPLE_INDEX {
        b"sample_id"
    } else if b == BI_SAMPLE_MASK {
        b"sample_mask"
    } else if b == BI_LOCAL_INVOCATION_ID {
        b"thread_position_in_threadgroup"
    } else if b == BI_LOCAL_INVOCATION_INDEX {
        b"thread_index_in_threadgroup"
    } else if b == BI_GLOBAL_INVOCATION_ID {
        b"thread_position_in_grid"
    } else if b == BI_WORKGROUP_ID {
        b"threadgroup_position_in_grid"
    } else {
        b"threadgroups_per_grid"
    }
}

fn interp_attr(b: Binding) -> &'static [u8] {
    if b.interp == INTERP_FLAT {
        b", flat"
    } else if b.interp == INTERP_LINEAR {
        b", center_no_perspective"
    } else {
        b""
    }
}

// One IO value of an entry point: as a stage_in member (`in_struct`) or a
// parameter.
fn io_decl<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, stage: u8, ty: i64, b: Binding,
    name: &[u8], output: bool) {
    w.pty(m, ty);
    { let name = str::from_utf8(name).unwrap(); write(w.out, " {name} [[").unwrap() };
    if b.kind == BIND_BUILTIN {
        w.p(builtin_attr(b.value));
    } else if stage == STAGE_VERTEX && !output {
        write(w.out, "attribute({})", b.value).unwrap();
    } else if stage == STAGE_FRAGMENT && output {
        write(w.out, "color({})", b.value).unwrap();
    } else {
        write(w.out, "user(loc{}){}", b.value, str::from_utf8(interp_attr(b)).unwrap()).unwrap();
    }
    w.p(b"]]");
}

fn uses_workgroup<A: Allocator + Copy>(w: &W<A>, m: &Module<'_, A>, h: i64) -> bool {
    for g in 0..m.globals.len() as i64 {
        if w.uses[h as usize][g as usize] && m.globals[g as usize].space == SP_WORKGROUP {
            return true;
        }
    }
    false
}

// Zeroes a workgroup variable (atomics by atomic stores).
fn zero_workgroup<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, lv: &[u8], t: i64,
    depth: i64) {
    if !m.has_atomic(t) {
        w.line();
        let _n14 = w.ty(m, t);
        { let lv = str::from_utf8(lv).unwrap();
            write(w.out, "{lv} = {} {{}};", str::from_utf8(nm(&w.pool, _n14)).unwrap()).unwrap() };
        return;
    }
    let ty = m.types[t as usize];
    if ty.kind == TK_ATOMIC {
        w.line();
        { let lv = str::from_utf8(lv).unwrap();
            write(w.out, "metal::atomic_store_explicit(&{lv}, 0, metal::memory_order_relaxed);").unwrap() };
    } else if ty.kind == TK_ARRAY {
        w.line();
        write(w.out, "for (uint _w_i{depth} = 0u; _w_i{depth} < {}u; _w_i{depth}++) {{", ty.n).unwrap();
        w.indent += 1;
        let mut b = Vec::<u8, _>::new_in(w.a);
        { let lv = str::from_utf8(lv).unwrap(); write(b, "{lv}.inner[_w_i{depth}]").unwrap() };
        zero_workgroup(w, m, b.as_slice(), ty.base, depth + 1);
        w.indent -= 1;
        w.line();
        w.p(b"}");
    } else if ty.kind == TK_STRUCT {
        for k in ty.mstart..ty.mstart + ty.mcount {
            let mut b = Vec::<u8, _>::new_in(w.a);
            let _n15 = w.escape(m.members[k as usize].name);
            { let lv = str::from_utf8(lv).unwrap();
                write(b, "{lv}.{}", str::from_utf8(nm(&w.pool, _n15)).unwrap()).unwrap() };
            zero_workgroup(w, m, b.as_slice(), m.members[k as usize].ty, depth);
        }
    }
}

fn write_entry<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, ei: i64) {
    let en = m.entries[ei as usize];
    let h = en.func;
    let f = &m.functions[h as usize];
    start_fn(w, m, h);
    w.spans.push(w.out.len() as i64);
    w.spans.push(h);
    w.stage = en.stage as i64;
    w.ret_ty = f.result;
    let ename = w.fnames[h as usize];
    // the stage_in struct: location inputs of vertex and fragment shaders
    let mut in_buf = Vec::<u8, _>::new_in(w.a);
    if en.stage != STAGE_COMPUTE {
        let mut any = false;
        let saved = mem::replace(&mut w.out, Vec::<u8, _>::new_in(w.a));
        for k in 0..f.params.len() as i64 {
            let pt = m.types[f.params[k as usize].ty as usize];
            if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {
                for j in pt.mstart..pt.mstart + pt.mcount {
                    let mem = m.members[j as usize];
                    if mem.binding.kind == BIND_LOCATION
                        || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION
                            && en.stage == STAGE_FRAGMENT) {
                        w.p(b"\n    ");
                        let mut nb = Vec::<u8, _>::new_in(w.a);
                        write(nb, "_w_p{k}_{}", j - pt.mstart).unwrap();
                        io_decl(w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);
                        w.p(b";");
                        any = true;
                    }
                }
            }
            else if f.params[k as usize].binding.kind == BIND_LOCATION
                || (f.params[k as usize].binding.kind == BIND_BUILTIN
                    && f.params[k as usize].binding.value == BI_POSITION
                    && en.stage == STAGE_FRAGMENT) {
                w.p(b"\n    ");
                let mut nb = Vec::<u8, _>::new_in(w.a);
                write(nb, "_w_p{k}").unwrap();
                io_decl(w, m, en.stage, f.params[k as usize].ty, f.params[k as usize].binding,
                    nb.as_slice(), false);
                w.p(b";");
                any = true;
            }
        }
        let sb = mem::replace(&mut w.out, saved);
        if any {
            in_buf.extend_from_slice(nm(&w.pool, ename));
            in_buf.extend_from_slice(b"_Input");
            w.out.extend_from_slice(b"\nstruct ");
            copy_into(&mut w.out, in_buf.as_slice());
            w.out.extend_from_slice(b" {");
            copy_into(&mut w.out, sb.as_slice());
            w.out.extend_from_slice(b"\n};\n");
        }
        // the output struct
        if f.result >= 0 {
            let mut nb = Vec::<u8, _>::new_in(w.a);
            nb.extend_from_slice(nm(&w.pool, ename));
            nb.extend_from_slice(b"_Output");
            w.out_name = w.intern(nb.as_slice());
            write(w.out, "\nstruct {} {{", str::from_utf8(nm(&w.pool, w.out_name)).unwrap()).unwrap();
            let rt = m.types[f.result as usize];
            if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {
                for j in rt.mstart..rt.mstart + rt.mcount {
                    let mem = m.members[j as usize];
                    w.p(b"\n    ");
                    let mut mb = Vec::<u8, _>::new_in(w.a);
                    write(mb, "m{}", j - rt.mstart).unwrap();
                    io_decl(w, m, en.stage, mem.ty, mem.binding, mb.as_slice(), true);
                    w.p(b";");
                }
            } else {
                w.p(b"\n    ");
                io_decl(w, m, en.stage, f.result, f.result_binding, b"m0", true);
                w.p(b";");
            }
            w.p(b"\n};\n");
        }
    }
    let kw = if en.stage == STAGE_COMPUTE { "kernel void" }
        else if en.stage == STAGE_VERTEX { "vertex" } else { "fragment" };
    write(w.out, "\n{kw} ").unwrap();
    if en.stage != STAGE_COMPUTE {
        if f.result >= 0 {
            write(w.out, "{} ", str::from_utf8(nm(&w.pool, w.out_name)).unwrap()).unwrap();
        } else {
            w.p(b"void ");
        }
    }
    write(w.out, "{}(", str::from_utf8(nm(&w.pool, ename)).unwrap()).unwrap();
    let mut first = true;
    if in_buf.len() as i64 > 0 {
        write(w.out, "{} _w_in [[stage_in]]", str::from_utf8(in_buf.as_slice()).unwrap()).unwrap();
        first = false;
    }
    // builtin inputs as parameters
    let mut has_lid = false;
    for k in 0..f.params.len() as i64 {
        let pt = m.types[f.params[k as usize].ty as usize];
        if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {
            for j in pt.mstart..pt.mstart + pt.mcount {
                let mem = m.members[j as usize];
                if mem.binding.kind == BIND_BUILTIN
                    && !(mem.binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {
                    if !first {
                        w.p(b", ");
                    }
                    first = false;
                    let mut nb = Vec::<u8, _>::new_in(w.a);
                    write(nb, "_w_p{k}_{}", j - pt.mstart).unwrap();
                    io_decl(w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);
                    if mem.binding.value == BI_LOCAL_INVOCATION_INDEX {
                        has_lid = true;
                    }
                }
            }
        }
        else if f.params[k as usize].binding.kind == BIND_BUILTIN
            && !(f.params[k as usize].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {
            if !first {
                w.p(b", ");
            }
            first = false;
            let mut nb = Vec::<u8, _>::new_in(w.a);
            write(nb, "_w_p{k}").unwrap();
            io_decl(w, m, en.stage, f.params[k as usize].ty, f.params[k as usize].binding,
                nb.as_slice(), false);
            if f.params[k as usize].binding.value == BI_LOCAL_INVOCATION_INDEX {
                has_lid = true;
            }
        }
    }
    let wg = en.stage == STAGE_COMPUTE && uses_workgroup(w, m, h);
    if wg && !has_lid {
        if !first {
            w.p(b", ");
        }
        first = false;
        w.p(b"uint _w_lindex [[thread_index_in_threadgroup]]");
    }
    // resources
    for g in 0..m.globals.len() as i64 {
        if !w.uses[h as usize][g as usize] {
            continue;
        }
        let gl = m.globals[g as usize];
        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {
            continue;
        }
        if !first {
            w.p(b", ");
        }
        first = false;
        let tk = m.types[gl.ty as usize].kind;
        let slot = w.sl.slot[(en.stage as i64 * m.globals.len() as i64 + g) as usize];
        if gl.space == SP_HANDLE {
            let _n16 = w.ty(m, gl.ty);
            write(w.out, "{} {} [[{}({slot})]]", str::from_utf8(nm(&w.pool, _n16)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap(),
                if tk == TK_TEXTURE { "texture" } else { "sampler" }).unwrap();
        } else if tk == TK_ARRAY && m.types[gl.ty as usize].n == 0 {
            let _n17 = w.ty(m, m.types[gl.ty as usize].base);
            write(w.out, "{} {}* {} [[buffer({slot})]]",
                str::from_utf8(W::<A>::space(gl.space, gl.access)).unwrap(),
                str::from_utf8(nm(&w.pool, _n17)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
        } else {
            let _n18 = w.ty(m, gl.ty);
            write(w.out, "{} {}& {} [[buffer({slot})]]",
                str::from_utf8(W::<A>::space(gl.space, gl.access)).unwrap(),
                str::from_utf8(nm(&w.pool, _n18)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
        }
    }
    if needs_sizes(w, m, h) {
        if !first {
            w.p(b", ");
        }
        write(w.out, "constant uint* _w_sizes [[buffer({})]]",
            w.sl.sizes_slot[en.stage as i64 as usize]).unwrap();
    }
    w.p(b") {");
    w.indent = 1;
    // private and workgroup variables
    for g in 0..m.globals.len() as i64 {
        if !w.uses[h as usize][g as usize] {
            continue;
        }
        let gl = m.globals[g as usize];
        if gl.space == SP_PRIVATE {
            w.line();
            let _n19 = w.ty(m, gl.ty);
            write(w.out, "{} {} = ", str::from_utf8(nm(&w.pool, _n19)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
            if gl.init >= 0 {
                write_const(w, m, gl.init);
            } else {
                let _n20 = w.ty(m, gl.ty);
                write(w.out, "{} {{}}", str::from_utf8(nm(&w.pool, _n20)).unwrap()).unwrap();
            }
            w.p(b";");
        } else if gl.space == SP_WORKGROUP {
            w.line();
            let _n21 = w.ty(m, gl.ty);
            write(w.out, "threadgroup {} {};", str::from_utf8(nm(&w.pool, _n21)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
        }
    }
    if wg {
        let lid = if has_lid { lid_name(w, m, &f) } else { w.intern(b"_w_lindex") };
        w.line();
        write(w.out, "if ({} == 0u) {{", str::from_utf8(nm(&w.pool, lid)).unwrap()).unwrap();
        w.indent += 1;
        for g in 0..m.globals.len() as i64 {
            if w.uses[h as usize][g as usize] && m.globals[g as usize].space == SP_WORKGROUP {
                let mut lb = Vec::<u8, _>::new_in(w.a);
                lb.extend_from_slice(nm(&w.pool, w.gnames[g as usize]));
                zero_workgroup(w, m, lb.as_slice(), m.globals[g as usize].ty, 0);
            }
        }
        w.indent -= 1;
        w.line();
        w.p(b"}");
        w.line();
        w.p(b"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);");
    }
    // the parameters as WGSL sees them
    for k in 0..f.params.len() as i64 {
        let ae = arg_expr(f, k);
        if ae < 0 {
            continue;
        }
        let pt = m.types[f.params[k as usize].ty as usize];
        w.line();
        if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {
            let _n22 = w.ty(m, f.params[k as usize].ty);
            write(w.out, "{} {} = {{}};", str::from_utf8(nm(&w.pool, _n22)).unwrap(),
                str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap()).unwrap();
            for j in pt.mstart..pt.mstart + pt.mcount {
                let mem = m.members[j as usize];
                let from_in = mem.binding.kind == BIND_LOCATION
                    || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION
                        && en.stage == STAGE_FRAGMENT);
                w.line();
                let _n23 = w.escape(mem.name);
                write(w.out, "{}.{} = {}_w_p{k}_{};",
                    str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap(),
                    str::from_utf8(nm(&w.pool, _n23)).unwrap(), if from_in { "_w_in." } else { "" },
                    j - pt.mstart).unwrap();
            }
        } else {
            let from_in = f.params[k as usize].binding.kind == BIND_LOCATION
                || (f.params[k as usize].binding.kind == BIND_BUILTIN
                    && f.params[k as usize].binding.value == BI_POSITION
                    && en.stage == STAGE_FRAGMENT);
            let _n24 = w.ty(m, f.params[k as usize].ty);
            write(w.out, "{} {} = {}_w_p{k};", str::from_utf8(nm(&w.pool, _n24)).unwrap(),
                str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap(),
                if from_in { "_w_in." } else { "" }).unwrap();
        }
    }
    declare_locals(w, m, &f);
    w.block(m, &f, f.body);
    w.indent = 0;
    w.p(b"\n}\n");
    w.stage = 255;
}

fn lid_name<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, f: &Function<'_, A>) -> Nm {
    for k in 0..f.params.len() as i64 {
        let pt = m.types[f.params[k as usize].ty as usize];
        if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {
            for j in pt.mstart..pt.mstart + pt.mcount {
                let mem = m.members[j as usize];
                if mem.binding.kind == BIND_BUILTIN
                    && mem.binding.value == BI_LOCAL_INVOCATION_INDEX {
                    let st = w.pool.len() as i64;
                    write(w.pool, "_w_p{k}_{}", j - pt.mstart).unwrap();
                    return w.since(st);
                }
            }
        }
        else if f.params[k as usize].binding.kind == BIND_BUILTIN
            && f.params[k as usize].binding.value == BI_LOCAL_INVOCATION_INDEX {
            let st = w.pool.len() as i64;
            write(w.pool, "_w_p{k}").unwrap();
            return w.since(st);
        }
    }
    w.intern(b"_w_lindex")
}

// A private global's initializer: an expression of the module's constants.
fn write_const<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, e: i64) {
    let nb: Vec<bool, A> = Vec::from_elem_in(false, m.consts.exprs.len(), w.a);
    let nn: Vec<Nm, A> = Vec::from_elem_in((Nm { start: 0, len: 0 }), m.consts.exprs.len(), w.a);
    let saved_baked = mem::replace(&mut w.baked, nb);
    let saved_names = mem::replace(&mut w.enames, nn);
    w.render(m, &m.consts, e);
    w.baked = saved_baked;
    w.enames = saved_names;
}

// ---- Shader compiler implementation, msl: Test kernels (0.22) ----

// The stage of a test kernel being written.
const TEST_KERNEL: i64 = 254;

// Entry point ei (a vertex or fragment one) as a kernel, `NAME_w_test`:
// invocation i reads its parameters from input record i (their record
// offsets: ir::record_offsets) and writes its result into output record
// i, so its body runs on Metal as the interpreter runs it alone. Its
// slots: buffers from 0 in (group, binding) order, then the input, the
// output and the sizes buffer; textures and samplers from 0.
fn write_test_kernel<A: Allocator + Copy>(w: &mut W<A>, m: &Module<'_, A>, ei: i64) -> [i64; 3] {
    let en = m.entries[ei as usize];
    let h = en.func;
    let f = &m.functions[h as usize];
    start_fn(w, m, h);
    w.stage = TEST_KERNEL;
    w.ret_ty = f.result;
    let ename = w.fnames[h as usize];
    let offs = ir::record_offsets(m, h, w.a);
    // the input record
    let mut rec = Vec::<u8, _>::new_in(w.a);
    rec.extend_from_slice(nm(&w.pool, ename));
    rec.extend_from_slice(b"_w_In");
    let rn = w.intern(rec.as_slice());
    let mut b = Vec::<u8, _>::new_in(w.a);
    b.extend_from_slice(b"struct ");
    b.extend_from_slice(nm(&w.pool, rn));
    b.extend_from_slice(b" {\n");
    let mut off: i64 = 0;
    for k in 0..f.params.len() as i64 {
        if offs[k as usize] > off {
            write(b, "    char _pad{k}[{}];\n", offs[k as usize] - off).unwrap();
        }
        let mt = w.member_ty(m, f.params[k as usize].ty);
        write(b, "    {} p{k};\n", str::from_utf8(nm(&w.pool, mt)).unwrap()).unwrap();
        off = offs[k as usize] + m.types[f.params[k as usize].ty as usize].size;
    }
    let stride = offs[f.params.len() as i64 as usize];
    if stride > off {
        write(b, "    char _padend[{}];\n", stride - off).unwrap();
    }
    b.extend_from_slice(b"};\n");
    copy_into(&mut w.types_out, b.as_slice());
    let rt = if f.result >= 0 { w.ty(m, f.result) } else { w.intern(b"uint") };
    write(w.out, "\nkernel void {}_w_test(uint _w_tid [[threadgroup_position_in_grid]]",
        str::from_utf8(nm(&w.pool, ename)).unwrap()).unwrap();
    let order = binding_order(m, w.a);
    let mut nb: i64 = 0;
    let mut nt: i64 = 0;
    let mut ns: i64 = 0;
    for k in 0..order.len() as i64 {
        let g = order[k as usize];
        if !w.uses[h as usize][g as usize] {
            continue;
        }
        let gl = m.globals[g as usize];
        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {
            continue;
        }
        w.p(b", ");
        let kind = m.types[gl.ty as usize].kind;
        if gl.space == SP_HANDLE {
            let tn = w.ty(m, gl.ty);
            let tex = kind == TK_TEXTURE;
            let slot = if tex { nt } else { ns };
            write(w.out, "{} {} [[{}({slot})]]", str::from_utf8(nm(&w.pool, tn)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap(),
                if tex { "texture" } else { "sampler" }).unwrap();
            if tex {
                nt += 1;
            } else {
                ns += 1;
            }
        } else if kind == TK_ARRAY && m.types[gl.ty as usize].n == 0 {
            let tn = w.ty(m, m.types[gl.ty as usize].base);
            write(w.out, "{} {}* {} [[buffer({nb})]]",
                str::from_utf8(W::<A>::space(gl.space, gl.access)).unwrap(),
                str::from_utf8(nm(&w.pool, tn)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
            nb += 1;
        } else {
            let tn = w.ty(m, gl.ty);
            write(w.out, "{} {}& {} [[buffer({nb})]]",
                str::from_utf8(W::<A>::space(gl.space, gl.access)).unwrap(),
                str::from_utf8(nm(&w.pool, tn)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
            nb += 1;
        }
    }
    write(w.out, ", const device {}* _w_in [[buffer({nb})]], device {}* _w_out [[buffer({})]]",
        str::from_utf8(nm(&w.pool, rn)).unwrap(), str::from_utf8(nm(&w.pool, rt)).unwrap(),
        nb + 1).unwrap();
    let mut sizes: i64 = -1;
    if needs_sizes(w, m, h) {
        sizes = nb + 2;
        write(w.out, ", constant uint* _w_sizes [[buffer({sizes})]]").unwrap();
    }
    w.p(b") {");
    w.indent = 1;
    for g in 0..m.globals.len() as i64 {
        if w.uses[h as usize][g as usize] && m.globals[g as usize].space == SP_PRIVATE {
            let gl = m.globals[g as usize];
            w.line();
            let tn = w.ty(m, gl.ty);
            write(w.out, "{} {} = ", str::from_utf8(nm(&w.pool, tn)).unwrap(),
                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();
            if gl.init >= 0 {
                write_const(w, m, gl.init);
            } else {
                write(w.out, "{} {{}}", str::from_utf8(nm(&w.pool, tn)).unwrap()).unwrap();
            }
            w.p(b";");
        }
    }
    for k in 0..f.params.len() as i64 {
        let ae = arg_expr(f, k);
        if ae < 0 {
            continue;
        }
        w.line();
        let tn = w.ty(m, f.params[k as usize].ty);
        write(w.out, "{} {} = _w_in[_w_tid].p{k};", str::from_utf8(nm(&w.pool, tn)).unwrap(),
            str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap()).unwrap();
    }
    declare_locals(w, m, &f);
    w.block(m, &f, f.body);
    w.indent = 0;
    w.p(b"\n}\n");
    w.stage = 255;
    [nb, nb + 1, sizes]
}

// ---- Shader compiler implementation, msl: Jobs for tests/wgsl/metalrun (0.22) ----

// The MSL text of the module, for a job.
fn module_text<'a, A: Allocator + Copy>(m: &'a Module<'_, A>, a: A, w: &mut W<A>) -> Vec<u8, A> {
    let order = call_order(m, a);
    w.uses = global_uses(m, &order, a);
    w.sl = slots(m, &w.uses, a);
    for oi in 0..order.len() as i64 {
        let h = order[oi as usize];
        let mut is_entry = false;
        for e in 0..m.entries.len() as i64 {
            if m.entries[e as usize].func == h {
                is_entry = true;
            }
        }
        if !is_entry {
            write_fn(w, m, h);
        }
    }
    for e in 0..m.entries.len() as i64 {
        write_entry(w, m, e);
    }
    let mut text = Vec::<u8, _>::new_in(a);
    finish_into(w, &mut text);
    text
}

// A job that only compiles the MSL and finds each entry point.
pub fn metal_compile_job<B: Allocator + Copy, A: Allocator + Copy>(m: &Module<'_, A>, a: A,
    out: &mut String<B>) {
    // (0.26.3: into a String outside std; the Buf form is std's until 0.27)
    let mut b = Vec::<u8, _>::new_in(*out.allocator());
    metal_compile_job_buf(m, a, &mut b);
    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());
    out.push_str(t.as_str());
}

pub(crate) fn metal_compile_job_buf<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A,
    out: &mut Vec<u8, B>) {
    let mut w = new_writer(m, a);
    let text = module_text(m, a, &mut w);
    write(out, "msl {}\n", text.len() as i64).unwrap();
    out.extend_from_slice(text.as_slice());
    out.extend_from_slice(b"\nfunctions");
    for e in 0..m.entries.len() as i64 {
        write(out, " {}",
            str::from_utf8(nm(&w.pool, w.fnames[m.entries[e as usize].func as usize])).unwrap()).unwrap();
    }
    out.push(b'\n');
}

// The MSL of the module, then what metalrun needs: the entry point's
// name, workgroup size, dispatch, and each buffer's slot and words.
// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form
// is std's own until 0.27.
pub fn metal_job<B: Allocator + Copy, A: Allocator + Copy>(m: &Module<'_, A>, a: A, ei: i64,
    job: &job::Job<A>, out: &mut String<B>) {
    let mut b = Vec::<u8, _>::new_in(*out.allocator());
    metal_job_buf(m, a, ei, job, &mut b);
    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());
    out.push_str(t.as_str());
}

pub(crate) fn metal_job_buf<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A, ei: i64,
    job: &job::Job<A>, out: &mut Vec<u8, B>) {
    if job.call_n >= 0 {
        metal_call_job(m, a, ei, job, out);
        return;
    }
    let mut w = new_writer(m, a);
    let text = module_text(m, a, &mut w);
    let en = m.entries[ei as usize];
    write(out, "msl {}\n", text.len() as i64).unwrap();
    out.extend_from_slice(text.as_slice());
    write(out, "\nentry {}\n", str::from_utf8(nm(&w.pool, w.fnames[en.func as usize])).unwrap()).unwrap();
    write(out, "tg {} {} {}\n", en.wg[0], en.wg[1], en.wg[2]).unwrap();
    write(out, "dispatch {} {} {}\n", job.groups[0], job.groups[1], job.groups[2]).unwrap();
    let mut sizes: Vec<i64, A> = Vec::from_elem_in(0i64, (w.sl.sizes_count as usize), a);
    for i in 0..job.buffers.len() as i64 {
        let b = &job.buffers[i as usize];
        let g = job::find_global(m, b.group, b.binding);
        if w.sl.size_index[g as usize] >= 0 {
            sizes[w.sl.size_index[g as usize] as usize] = b.bytes;
        }
        write(out, "buffer {} {} {} {}", b.group, b.binding,
            w.sl.slot[(2 * m.globals.len() as i64 + g) as usize], b.bytes).unwrap();
        for k in 0..b.words.len() as i64 {
            write(out, " {}", b.words[k as usize]).unwrap();
        }
        out.push(b'\n');
    }
    if w.sl.sizes_slot[2] >= 0 {
        write(out, "sizes {} {}", w.sl.sizes_slot[2], sizes.len() as i64).unwrap();
        for k in 0..sizes.len() as i64 {
            write(out, " {}", sizes[k as usize]).unwrap();
        }
        out.push(b'\n');
    }
}

fn finish_into<A: Allocator + Copy>(w: &W<A>, out: &mut Vec<u8, A>) {
    let mut tmp = Vec::<u8, _>::new_in(w.a);
    let _ = tmp;
    // finish writes to a gpa Buf in `write`; here the same text into an arena one
    out.extend_from_slice(
        b"// Generated by wgslc (MSL 3.0).\n#include <metal_stdlib>\n#include <simd/simd.h>\n\n");
    let mut h = Vec::<u8, _>::new_in(w.a);
    helpers(w, &mut h);
    copy_into(out, h.as_slice());
    out.push(b'\n');
    copy_into(out, w.types_out.as_slice());
    copy_into(out, w.out.as_slice());
    tmp = h;
}

// A call job: the module's MSL plus entry ei's test kernel, run once per
// input record (one thread per threadgroup), its resources at the
// kernel's slots.
fn metal_call_job<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A, ei: i64,
    job: &job::Job<A>, out: &mut Vec<u8, B>) {
    let mut w = new_writer(m, a);
    let order = call_order(m, a);
    w.uses = global_uses(m, &order, a);
    w.sl = slots(m, &w.uses, a);
    for oi in 0..order.len() as i64 {
        let h = order[oi as usize];
        let mut is_entry = false;
        for e in 0..m.entries.len() as i64 {
            if m.entries[e as usize].func == h {
                is_entry = true;
            }
        }
        if !is_entry {
            write_fn(&mut w, m, h);
        }
    }
    for e in 0..m.entries.len() as i64 {
        write_entry(&mut w, m, e);
    }
    let io = write_test_kernel(&mut w, m, ei);
    let mut text = Vec::<u8, _>::new_in(a);
    finish_into(&w, &mut text);
    let h = m.entries[ei as usize].func;
    write(out, "msl {}\n", text.len() as i64).unwrap();
    out.extend_from_slice(text.as_slice());
    write(out, "\nentry {}_w_test\ntg 1 1 1\ndispatch {} 1 1\n",
        str::from_utf8(nm(&w.pool, w.fnames[h as usize])).unwrap(), job.call_n).unwrap();
    // the kernel's slots: (group, binding) order over what it uses
    let border = binding_order(m, a);
    let ng = m.globals.len() as i64;
    let mut kslot: Vec<i64, A> = Vec::from_elem_in(-1i64, (ng as usize), a);
    let mut nb: i64 = 0;
    let mut nt: i64 = 0;
    for k in 0..border.len() as i64 {
        let g = border[k as usize];
        if !w.uses[h as usize][g as usize] {
            continue;
        }
        let gl = m.globals[g as usize];
        if gl.space == ir::SP_UNIFORM || gl.space == SP_STORAGE {
            kslot[g as usize] = nb;
            nb += 1;
        } else if m.types[gl.ty as usize].kind == TK_TEXTURE {
            kslot[g as usize] = nt;
            nt += 1;
        }
    }
    let mut sizes: Vec<i64, A> = Vec::from_elem_in(0i64, (w.sl.sizes_count as usize), a);
    for i in 0..job.buffers.len() as i64 {
        let b = &job.buffers[i as usize];
        let g = job::find_global(m, b.group, b.binding);
        if w.sl.size_index[g as usize] >= 0 {
            sizes[w.sl.size_index[g as usize] as usize] = b.bytes;
        }
        write(out, "buffer {} {} {} {}", b.group, b.binding, kslot[g as usize], b.bytes).unwrap();
        for j in 0..b.words.len() as i64 {
            write(out, " {}", b.words[j as usize]).unwrap();
        }
        out.push(b'\n');
    }
    for i in 0..job.textures.len() as i64 {
        let t = &job.textures[i as usize];
        let g = job::find_global(m, t.group, t.binding);
        write(out, "texture {} {} {} {}", kslot[g as usize], str::from_utf8(t.format).unwrap(), t.w,
            t.h).unwrap();
        for j in 0..t.words.len() as i64 {
            write(out, " {}", t.words[j as usize]).unwrap();
        }
        out.push(b'\n');
    }
    let f = &m.functions[h as usize];
    let in_stride = ir::record_offsets(m, h, a)[f.params.len() as i64 as usize];
    let out_stride: i64 = if f.result >= 0 { ir::stride_of(m, f.result) } else { 4 };
    write(out, "buffer -1 0 {} {}", io[0], job.call_n * in_stride).unwrap();
    for j in 0..job.input.len() as i64 {
        write(out, " {}", job.input[j as usize]).unwrap();
    }
    write(out, "\nbuffer -2 0 {} {}\n", io[1], job.call_n * out_stride).unwrap();
    if io[2] >= 0 {
        write(out, "sizes {} {}", io[2], sizes.len() as i64).unwrap();
        for k in 0..sizes.len() as i64 {
            write(out, " {}", sizes[k as usize]).unwrap();
        }
        out.push(b'\n');
    }
}
