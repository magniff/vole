// EDITION: rust
// std::clone: Clone. A container's clone reuses its stored allocator,
// which its type shows (`&Vec<T, Gpa>` may allocate from Gpa through
// clone; plan §2.0), so `#[derive(Clone)]` on a type generic over A needs
// `A: Clone`; `clone_in(a)`, inherent on each container, moves the copy
// to another allocator.

// A copy of the value that owns what it holds (a Vec's elements, cloned).
// std2: changed: takes &self
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]
pub trait Clone: Sized {
    // std2: changed: takes &self (MVS: a let self)
    fn clone(&self) -> Self;

    // `*self = source.clone()`, reusing self's storage where it can.
    fn clone_from(&mut self, source: &Self) {
        *self = source.clone();
    }
}

// The unit value's copy (Rust's core implements Clone for `()` and the
// tuples; Gpa's derived Clone clones its `()` field).
impl Clone for () {
    fn clone(&self) -> () {
        ()
    }
}

// A tuple's copy: each element's (Rust's core has them up to 12 elements;
// here up to 4: the lazy std keeps each impl in every program).
impl<A: Clone> Clone for (A,) {
    fn clone(&self) -> (A,) {
        (self.0.clone(),)
    }
}

impl<A: Clone, B: Clone> Clone for (A, B) {
    fn clone(&self) -> (A, B) {
        (self.0.clone(), self.1.clone())
    }
}

impl<A: Clone, B: Clone, C: Clone> Clone for (A, B, C) {
    fn clone(&self) -> (A, B, C) {
        (self.0.clone(), self.1.clone(), self.2.clone())
    }
}

impl<A: Clone, B: Clone, C: Clone, D: Clone> Clone for (A, B, C, D) {
    fn clone(&self) -> (A, B, C, D) {
        (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone())
    }
}

// A shared reference's copy: the same reference (Rust's core). So an
// allocator given by reference, `A = &ArenaScope<'_, Gpa>`, is Clone.
impl<T: ?Sized> Clone for &T {
    fn clone(&self) -> Self {
        *self
    }
}

// std2: new (char is no `#[builtin_impls]` primitive: written)
impl Clone for char {
    fn clone(&self) -> char {
        *self
    }
}
