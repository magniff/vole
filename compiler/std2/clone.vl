// EDITION: rust
// std::clone: Clone. A container's clone reuses its stored allocator,
// which its type shows (`&Vec<T, Gpa>` may allocate from Gpa through
// clone; plan §2.0), so `#[derive(Clone)]` on a type generic over A needs
// `A: Clone`; `clone_in(a)`, inherent on each container, moves the copy
// to another allocator.

// A copy of the value that owns what it holds (a Vec's elements, cloned).
// std2: changed: takes &self
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]
pub trait Clone: Sized {
    // std2: changed: takes &self (MVS: a let self)
    fn clone(&self) -> Self;

    // `*self = source.clone()`, reusing self's storage where it can.
    fn clone_from(&mut self, source: &Self) {
        *self = source.clone();
    }
}

// The unit value's copy (Rust's core implements Clone for `()` and the
// tuples; Gpa's derived Clone clones its `()` field).
impl Clone for () {
    fn clone(&self) -> () {
        ()
    }
}

// std2: new (char is no `#[builtin_impls]` primitive: written)
impl Clone for char {
    fn clone(&self) -> char {
        *self
    }
}
