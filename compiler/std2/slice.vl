// [T]::chunks's iterator.
pub struct Chunks<'a, T> {
    v: &'a [T],
    size: usize,
}

impl<'a, T> Iterator for Chunks<'a, T> {
    type Item = &'a [T];

    fn next(&mut self) -> Option<&'a [T]> {
        if self.v.is_empty() {
            return Option::None;
        }
        let n = crate::cmp::min(self.size, self.v.len());
        let (head, tail) = self.v.split_at(n);
        self.v = tail;
        Option::Some(head)
    }
}

impl<'a, T> DoubleEndedIterator for Chunks<'a, T> {
    fn next_back(&mut self) -> Option<&'a [T]> {
        crate::panic::todo()
    }
}

impl<'a, T> ExactSizeIterator for Chunks<'a, T> {}

// [T]::chunks_mut's iterator.
pub struct ChunksMut<'a, T> {
    v: &'a mut [T],
    size: usize,
}

impl<'a, T> Iterator for ChunksMut<'a, T> {
    type Item = &'a mut [T];

    fn next(&mut self) -> Option<&'a mut [T]> {
        crate::panic::todo()
    }
}

// [T]::chunks_exact's iterator.
pub struct ChunksExact<'a, T> {
    v: &'a [T],
    rem: &'a [T],
    size: usize,
}

impl<'a, T> ChunksExact<'a, T> {
    // The elements past the last whole chunk.
    pub fn remainder(&self) -> &'a [T] {
        self.rem
    }
}

impl<'a, T> Iterator for ChunksExact<'a, T> {
    type Item = &'a [T];

    fn next(&mut self) -> Option<&'a [T]> {
        if self.v.len() < self.size {
            return Option::None;
        }
        let (head, tail) = self.v.split_at(self.size);
        self.v = tail;
        Option::Some(head)
    }
}

