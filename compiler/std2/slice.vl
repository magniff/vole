// EDITION: rust
// std::slice: the methods of [T], always behind a reference (`&[T]`,
// `&mut [T]`: MVS's views), its iterators and SliceIndex. A Vec and an
// array have them all through Deref and the unsize coercion `&[T; N] ->
// &[T]`. What reads returns references into the slice (`get` is
// `Option<&T>`, `iter` yields `&T`); what sorts in place without
// allocating keeps Rust's name and meaning (`sort_unstable`); the stable
// sorts allocate scratch, so on a slice they take an allocator
// (`sort_in(a)`), while Vec's `sort` uses its own (plan §2). MVS's free
// functions (`reverse(s)`, `binary_search(s, x)`) are methods now.

use crate::alloc::Allocator;
use crate::borrow::ToOwnedIn;
use crate::clone::Clone;
use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::default::Default;
use crate::fmt::{Debug, Formatter};
use crate::hash::{Hash, Hasher};
use crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};
use crate::ops::{
    Bound, Index, IndexMut, Range, RangeBounds, RangeFrom, RangeFull, RangeInclusive, RangeTo,
    RangeToInclusive,
};
use crate::option::Option;
use crate::result::Result;
use crate::vec::Vec;

// std2: new: Rust's slice::from_raw_parts. The n T's from p as a slice.
// UNSAFE: the slice's elements are read through p.
// SAFETY: a contract on the caller: p valid for n initialized T's for 'a.
pub unsafe fn from_raw_parts<'a, T>(p: *const T, n: usize) -> &'a [T] {
    crate::ptr::slice_parts(p, n)
}

// The same, mutable (slice::from_raw_parts_mut).
// UNSAFE: the slice's elements are read and written through p.
// SAFETY: a contract on the caller: p valid for n T's for 'a, and not
// otherwise accessed for 'a.
pub unsafe fn from_raw_parts_mut<'a, T>(p: *mut T, n: usize) -> &'a mut [T] {
    crate::ptr::slice_parts_mut(p, n)
}

impl<T> [T] {
    // The number of elements (built in; MVS's `.len` read).
    pub fn len(&self) -> usize {
        // Built in: the length word of the reference (a view's `len` today).
        self.len
    }

    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    // Element i, or the subslice a range names; None when out of bounds.
    // mvs: [T]::get, Vec::get
    // std2: changed: a reference, through SliceIndex (MVS: a copy of T)
    pub fn get<I: SliceIndex<[T]>>(&self, index: I) -> Option<&I::Output> {
        index.get(self)
    }

    // The same, mutable.
    pub fn get_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> Option<&mut I::Output> {
        index.get_mut(self)
    }

    // get, with no bounds check.
    // UNSAFE: an index out of bounds is undefined.
    // SAFETY: a contract on the caller: index within the slice.
    pub unsafe fn get_unchecked<I: SliceIndex<[T]>>(&self, index: I) -> &I::Output {
        // The checked access: undefined behaviour may do anything, a panic too.
        index.index(self)
    }

    // UNSAFE: an index out of bounds is undefined.
    // SAFETY: a contract on the caller: index within the slice.
    pub unsafe fn get_unchecked_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> &mut I::Output {
        index.index_mut(self)
    }

    // mvs: Vec::first
    // std2: changed: a reference (MVS: a copy, on Vec only)
    pub fn first(&self) -> Option<&T> {
        self.get(0)
    }

    // mvs: Vec::last
    // std2: changed: a reference (MVS: a copy, on Vec only)
    pub fn last(&self) -> Option<&T> {
        if self.is_empty() { Option::None } else { self.get(self.len() - 1) }
    }

    pub fn first_mut(&mut self) -> Option<&mut T> {
        self.get_mut(0)
    }

    pub fn last_mut(&mut self) -> Option<&mut T> {
        let n = self.len();
        if n == 0 { Option::None } else { self.get_mut(n - 1) }
    }

    // The first element and the rest.
    pub fn split_first(&self) -> Option<(&T, &[T])> {
        if self.is_empty() { Option::None } else { Option::Some((&self[0], &self[1..])) }
    }

    // The last element and the rest.
    pub fn split_last(&self) -> Option<(&T, &[T])> {
        let n = self.len();
        if n == 0 { Option::None } else { Option::Some((&self[n - 1], &self[..n - 1])) }
    }

    // [0, mid) and [mid, len); panics when mid > len.
    pub fn split_at(&self, mid: usize) -> (&[T], &[T]) {
        (&self[..mid], &self[mid..])
    }

    // The same, mutable: two disjoint &mut slices.
    pub fn split_at_mut(&mut self, mid: usize) -> (&mut [T], &mut [T]) {
        let n = self.len();
        if mid > n {
            crate::panic::panic("mid > len");
        }
        let p = self.as_mut_ptr();
        // UNSAFE: two &mut slices of one slice: the borrow checker cannot see
        // that they are disjoint.
        // SAFETY: [0, mid) and [mid, n) do not overlap and both lie in the
        // slice (mid <= n, checked above); each lives as long as the &mut self.
        unsafe { (from_raw_parts_mut(p, mid), from_raw_parts_mut(p.add(mid), n - mid)) }
    }

    // The elements, by reference, in order (`.rev()` from the end).
    // mvs: [T]::iter, [T]::iter_ref, Vec::iter, Vec::iter_ref, SliceIter, SliceRefIter
    // std2: changed: yields &T (MVS's iter copied each T; iter_ref is this)
    pub fn iter(&self) -> Iter<'_, T> {
        Iter { v: self }
    }

    // The elements, by &mut.
    pub fn iter_mut(&mut self) -> IterMut<'_, T> {
        IterMut { v: self }
    }

    // Subslices of size elements (the last one shorter); size > 0.
    pub fn chunks(&self, size: usize) -> Chunks<'_, T> {
        crate::panic::assert(size != 0, "chunk size must be non-zero");
        Chunks { v: self, size: size }
    }

    pub fn chunks_mut(&mut self, size: usize) -> ChunksMut<'_, T> {
        crate::panic::assert(size != 0, "chunk size must be non-zero");
        ChunksMut { v: self, size: size }
    }

    // Subslices of exactly size elements; the rest is `remainder()`.
    pub fn chunks_exact(&self, size: usize) -> ChunksExact<'_, T> {
        crate::panic::assert(size != 0, "chunk size must be non-zero");
        let n = self.len() - self.len() % size;
        let (v, rem) = self.split_at(n);
        ChunksExact { v: v, rem: rem, size: size }
    }

    // Every run of size consecutive elements, overlapping.
    pub fn windows(&self, size: usize) -> Windows<'_, T> {
        crate::panic::assert(size != 0, "window size must be non-zero");
        Windows { v: self, size: size }
    }

    // The subslices between the elements pred says true of.
    pub fn split<F: FnMut(&T) -> bool>(&self, pred: F) -> Split<'_, T, F> {
        Split { v: self, pred: pred, finished: false }
    }

    // Exchanges elements i and j; panics when out of bounds.
    // mvs: [T]::swap, Vec::swap, swap_at
    pub fn swap(&mut self, i: usize, j: usize) {
        let n = self.len();
        if i >= n || j >= n {
            crate::panic::panic("index out of bounds");
        }
        if i == j {
            return;
        }
        let (lo, hi) = if i < j { (i, j) } else { (j, i) };
        let (a, b) = self.split_at_mut(hi);
        crate::mem::swap(&mut a[lo], &mut b[0]);
    }

    // Reverses the order in place.
    // mvs: reverse
    pub fn reverse(&mut self) {
        let n = self.len();
        let mut i: usize = 0;
        while i < n / 2 {
            self.swap(i, n - 1 - i);
            i += 1;
        }
    }

    // Rotates left by mid: element mid comes first.
    // mvs: rotate_left
    pub fn rotate_left(&mut self, mid: usize) {
        crate::panic::assert(mid <= self.len(), "mid > len");
        self[..mid].reverse();
        self[mid..].reverse();
        self.reverse();
    }

    // mvs: rotate_right
    pub fn rotate_right(&mut self, k: usize) {
        let n = self.len();
        crate::panic::assert(k <= n, "k > len");
        self.rotate_left(n - k);
    }

    // Every element set by f().
    pub fn fill_with<F: FnMut() -> T>(&mut self, f: F) {
        let mut f = f;
        let mut i: usize = 0;
        while i < self.len() {
            self[i] = f();
            i += 1;
        }
    }

    // Exchanges its elements with other's (the same length, or a panic).
    pub fn swap_with_slice(&mut self, other: &mut [T]) {
        let n = self.len();
        crate::panic::assert(n == other.len(),
            "destination and source slices have different lengths");
        let mut i: usize = 0;
        while i < n {
            crate::mem::swap(&mut self[i], &mut other[i]);
            i += 1;
        }
    }

    // Sorts in place, unstable (equal elements may change order),
    // allocating nothing: ipnsort, as MVS's `sort` (now this name).
    // mvs: sort_unstable, sort, [T]::sort, Vec::sort
    // std2: renamed
    pub fn sort_unstable(&mut self)
        where
            T: Ord,
    {
        self.sort_unstable_by(|a, b| a.cmp(b))
    }

    // mvs: sort_unstable_by
    pub fn sort_unstable_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {
        // A heapsort: in place, O(n log n), no allocation.
        let mut compare = compare;
        let n = self.len();
        let mut start = n / 2;
        while start > 0 {
            start -= 1;
            sift_down(self, start, n, &mut compare);
        }
        let mut end = n;
        while end > 1 {
            end -= 1;
            self.swap(0, end);
            sift_down(self, 0, end, &mut compare);
        }
    }

    // mvs: sort_unstable_by_key
    pub fn sort_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {
        let mut f = f;
        self.sort_unstable_by(|a, b| f(a).cmp(&f(b)))
    }

    // Sorts stable, scratch from a (Rust's `sort` on a slice; on a Vec,
    // `v.sort()` uses the Vec's allocator).
    // mvs: sort_stable_in
    // std2: renamed
    pub fn sort_in<A: Allocator>(&mut self, a: A)
        where
            T: Ord,
    {
        self.sort_by_in(|x, y| x.cmp(y), a)
    }

    // mvs: sort_stable_by_in, sort_stable_less_in
    // std2: renamed
    pub fn sort_by_in<F: FnMut(&T, &T) -> Ordering, A: Allocator>(&mut self, compare: F, a: A) {
        // A stable merge sort of the indices (scratch from a), then the
        // permutation applied in place by swaps: no T is moved through raw memory.
        let n = self.len();
        if n < 2 {
            return;
        }
        let mut compare = compare;
        let mut idx: Vec<usize, A> = Vec::with_capacity_in(2 * n, a);
        let mut i: usize = 0;
        while i < 2 * n {
            idx.push(i % n);
            i += 1;
        }
        let (perm, scratch) = idx.split_at_mut(n);
        let mut width: usize = 1;
        while width < n {
            let mut lo: usize = 0;
            while lo < n {
                let mid = crate::cmp::min(lo + width, n);
                let hi = crate::cmp::min(lo + 2 * width, n);
                let (mut l, mut r, mut k) = (lo, mid, lo);
                while k < hi {
                    let take_left = r >= hi
                        || (l < mid && compare(&self[perm[r]], &self[perm[l]]) != Ordering::Less);
                    if take_left {
                        scratch[k] = perm[l];
                        l += 1;
                    } else {
                        scratch[k] = perm[r];
                        r += 1;
                    }
                    k += 1;
                }
                lo = hi;
            }
            perm.copy_from_slice(scratch);
            width *= 2;
        }
        // perm[k] is the index of the element that goes to k: follow each
        // cycle to its first unplaced index.
        let mut k: usize = 0;
        while k < n {
            let mut j = perm[k];
            while j < k {
                j = perm[j];
            }
            self.swap(k, j);
            k += 1;
        }
    }

    pub fn sort_by_key_in<K: Ord, F: FnMut(&T) -> K, A: Allocator>(&mut self, f: F, a: A) {
        let mut f = f;
        self.sort_by_in(|x, y| f(x).cmp(&f(y)), a)
    }

    // Puts the element that sorted order has at i at i, the smaller ones
    // before and the larger after (unstable, no allocation).
    // mvs: select_nth_unstable
    pub fn select_nth_unstable(&mut self, i: usize) -> (&mut [T], &mut T, &mut [T])
        where
            T: Ord,
    {
        self.select_nth_unstable_by(i, |a, b| a.cmp(b))
    }

    // mvs: select_nth_unstable_by, select_nth_unstable_less
    pub fn select_nth_unstable_by<F: FnMut(&T, &T) -> Ordering>(
        &mut self,
        i: usize,
        compare: F,
    ) -> (&mut [T], &mut T, &mut [T]) {
        crate::panic::assert(i < self.len(), "partition index is out of bounds");
        // Sorting puts every element where sorted order has it (O(n log n),
        // no allocation).
        self.sort_unstable_by(compare);
        let (lo, rest) = self.split_at_mut(i);
        let (mid, hi) = rest.split_at_mut(1);
        (lo, &mut mid[0], hi)
    }

    // mvs: select_nth_unstable_by_key
    pub fn select_nth_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(
        &mut self,
        i: usize,
        f: F,
    ) -> (&mut [T], &mut T, &mut [T]) {
        let mut f = f;
        self.select_nth_unstable_by(i, |a, b| f(a).cmp(&f(b)))
    }

    // In a sorted slice: Ok(where x is) or Err(where it would go).
    // mvs: binary_search
    // std2: changed: Result<usize, usize> (Rust's)
    pub fn binary_search(&self, x: &T) -> Result<usize, usize>
        where
            T: Ord,
    {
        self.binary_search_by(|p| p.cmp(x))
    }

    // mvs: binary_search_by
    pub fn binary_search_by<F: FnMut(&T) -> Ordering>(&self, f: F) -> Result<usize, usize> {
        let mut f = f;
        let mut lo: usize = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            match f(&self[mid]) {
                Ordering::Less => lo = mid + 1,
                Ordering::Greater => hi = mid,
                Ordering::Equal => return Result::Ok(mid),
            }
        }
        Result::Err(lo)
    }

    // mvs: binary_search_by_key
    pub fn binary_search_by_key<B: Ord, F: FnMut(&T) -> B>(&self, b: &B, f: F) -> Result<usize,
        usize> {
        let mut f = f;
        self.binary_search_by(|k| f(k).cmp(b))
    }

    // The first index where pred turns false, for a slice partitioned by it.
    // mvs: partition_point
    pub fn partition_point<P: FnMut(&T) -> bool>(&self, pred: P) -> usize {
        let mut pred = pred;
        let mut lo: usize = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if pred(&self[mid]) {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }

    // Whether it is sorted (each element <= the next).
    pub fn is_sorted(&self) -> bool
        where
            T: PartialOrd,
    {
        let mut i: usize = 1;
        while i < self.len() {
            if !(self[i - 1] <= self[i]) {
                return false;
            }
            i += 1;
        }
        true
    }

    pub fn is_sorted_by_key<K: PartialOrd, F: FnMut(&T) -> K>(&self, f: F) -> bool {
        let mut f = f;
        let n = self.len();
        if n < 2 {
            return true;
        }
        let mut prev = f(&self[0]);
        let mut i: usize = 1;
        while i < n {
            let k = f(&self[i]);
            if !(prev <= k) {
                return false;
            }
            prev = k;
            i += 1;
        }
        true
    }

    // Whether an element equals x.
    // mvs: [T]::contains, Vec::contains
    // std2: changed: takes &T
    pub fn contains(&self, x: &T) -> bool
        where
            T: PartialEq,
    {
        for y in self.iter() {
            if *y == *x {
                return true;
            }
        }
        false
    }

    // std2: changed: takes &[T]
    pub fn starts_with(&self, needle: &[T]) -> bool
        where
            T: PartialEq,
    {
        needle.len() <= self.len() && &self[..needle.len()] == needle
    }

    // std2: changed: takes &[T]
    pub fn ends_with(&self, needle: &[T]) -> bool
        where
            T: PartialEq,
    {
        needle.len() <= self.len() && &self[self.len() - needle.len()..] == needle
    }

    // Copies src's elements in (the same length, or a panic).
    pub fn copy_from_slice(&mut self, src: &[T])
        where
            T: Copy,
    {
        let n = self.len();
        crate::panic::assert(n == src.len(),
            "source slice length does not match destination slice length");
        let mut i: usize = 0;
        while i < n {
            self[i] = src[i];
            i += 1;
        }
    }

    // Copies the elements in src to dest (they may overlap).
    pub fn copy_within<R: crate::ops::RangeBounds<usize>>(&mut self, src: R, dest: usize)
        where
            T: Copy,
    {
        let n = self.len();
        let start = match src.start_bound() {
            Bound::Included(s) => *s,
            Bound::Excluded(s) => *s + 1,
            Bound::Unbounded => 0,
        };
        let end = match src.end_bound() {
            Bound::Included(e) => *e + 1,
            Bound::Excluded(e) => *e,
            Bound::Unbounded => n,
        };
        crate::panic::assert(start <= end && end <= n, "src is out of bounds");
        let count = end - start;
        crate::panic::assert(dest <= n - count, "dest is out of bounds");
        if dest <= start {
            let mut i: usize = 0;
            while i < count {
                self[dest + i] = self[start + i];
                i += 1;
            }
        } else {
            let mut i = count;
            while i > 0 {
                i -= 1;
                self[dest + i] = self[start + i];
            }
        }
    }

    // Clones src's elements in (the same length, or a panic).
    pub fn clone_from_slice(&mut self, src: &[T])
        where
            T: Clone,
    {
        let n = self.len();
        crate::panic::assert(n == src.len(),
            "destination and source slices have different lengths");
        let mut i: usize = 0;
        while i < n {
            self[i] = src[i].clone();
            i += 1;
        }
    }

    // Every element set to a clone of x.
    // mvs: fill
    pub fn fill(&mut self, x: T)
        where
            T: Clone,
    {
        let mut i: usize = 0;
        while i < self.len() {
            self[i] = x.clone();
            i += 1;
        }
    }

    // A Vec of clones of its elements, on a.
    pub fn to_vec_in<A: Allocator>(&self, a: A) -> Vec<T, A>
        where
            T: Clone,
    {
        let mut v: Vec<T, A> = Vec::with_capacity_in(self.len(), a);
        v.extend_from_slice(self);
        v
    }

    // n copies of it, end to end, on a.
    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> Vec<T, A>
        where
            T: Copy,
    {
        let mut v: Vec<T, A> = Vec::with_capacity_in(self.len() * n, a);
        let mut i: usize = 0;
        while i < n {
            v.extend_from_slice(self);
            i += 1;
        }
        v
    }

    pub fn as_ptr(&self) -> *const T {
        // Built in: the data word of the reference (a view's `ptr` today).
        self.ptr
    }

    pub fn as_mut_ptr(&mut self) -> *mut T {
        self.ptr as *mut T
    }
}

// sort_unstable_by's heap: sifts v[i] down within v[..end].
fn sift_down<T, F: FnMut(&T, &T) -> Ordering>(v: &mut [T], i: usize, end: usize, compare: &mut F) {
    let mut root = i;
    loop {
        let mut child = 2 * root + 1;
        if child >= end {
            return;
        }
        if child + 1 < end && compare(&v[child], &v[child + 1]) == Ordering::Less {
            child += 1;
        }
        if compare(&v[root], &v[child]) != Ordering::Less {
            return;
        }
        v.swap(root, child);
        root = child;
    }
}

// What indexes a T (a slice or a str): usize for one element, the ranges
// for a subslice. Sealed: only std implements it. `s[i]` and `s.get(i)`
// go through it, so one `get` takes an index or a range.
pub trait SliceIndex<T: ?Sized> {
    type Output: ?Sized;

    fn get(self, slice: &T) -> Option<&Self::Output>;
    fn get_mut(self, slice: &mut T) -> Option<&mut Self::Output>;
    // Panics when out of bounds.
    fn index(self, slice: &T) -> &Self::Output;
    fn index_mut(self, slice: &mut T) -> &mut Self::Output;
}

impl<T> SliceIndex<[T]> for usize {
    type Output = T;

    fn get(self, slice: &[T]) -> Option<&T> {
        if self < slice.len() {
            let p = slice.as_ptr();
            // UNSAFE: a reference made from the slice's pointer (the primitive
            // under `s[i]`).
            // SAFETY: self < len, so element self is in the slice and initialized;
            // the reference lives as long as the slice's borrow.
            Option::Some(unsafe { &*p.add(self) })
        } else {
            Option::None
        }
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut T> {
        if self < slice.len() {
            let p = slice.as_mut_ptr();
            // UNSAFE: as get's.
            // SAFETY: self < len; the &mut lives as long as the slice's &mut.
            Option::Some(unsafe { &mut *p.add(self) })
        } else {
            Option::None
        }
    }

    fn index(self, slice: &[T]) -> &T {
        let n = slice.len();
        match self.get(slice) {
            Option::Some(x) => x,
            Option::None => crate::panic::panic(
                "index out of bounds: the len is {} but the index is {}", n, self),
        }
    }

    fn index_mut(self, slice: &mut [T]) -> &mut T {
        let n = slice.len();
        match self.get_mut(slice) {
            Option::Some(x) => x,
            Option::None => crate::panic::panic(
                "index out of bounds: the len is {} but the index is {}", n, self),
        }
    }
}

impl<T> SliceIndex<[T]> for Range<usize> {
    type Output = [T];

    fn get(self, slice: &[T]) -> Option<&[T]> {
        if self.start > self.end || self.end > slice.len() {
            return Option::None;
        }
        let p = slice.as_ptr();
        // UNSAFE: a subslice made from the slice's pointer (the primitive under
        // `&s[a..b]`).
        // SAFETY: start <= end <= len, so [start, end) lies in the slice; it
        // lives as long as the slice's borrow.
        Option::Some(unsafe { from_raw_parts(p.add(self.start), self.end - self.start) })
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {
        if self.start > self.end || self.end > slice.len() {
            return Option::None;
        }
        let p = slice.as_mut_ptr();
        // UNSAFE: as get's.
        // SAFETY: start <= end <= len; the &mut lives as long as the slice's &mut.
        Option::Some(unsafe { from_raw_parts_mut(p.add(self.start), self.end - self.start) })
    }

    fn index(self, slice: &[T]) -> &[T] {
        let n = slice.len();
        if self.start > self.end {
            crate::panic::panic("slice index starts at {} but ends at {}", self.start, self.end);
        }
        if self.end > n {
            crate::panic::panic("range end index {} out of range for slice of length {}", self.end,
                n);
        }
        match self.get(slice) {
            Option::Some(s) => s,
            Option::None => crate::panic::unreachable(),
        }
    }

    fn index_mut(self, slice: &mut [T]) -> &mut [T] {
        let n = slice.len();
        if self.start > self.end {
            crate::panic::panic("slice index starts at {} but ends at {}", self.start, self.end);
        }
        if self.end > n {
            crate::panic::panic("range end index {} out of range for slice of length {}", self.end,
                n);
        }
        match self.get_mut(slice) {
            Option::Some(s) => s,
            Option::None => crate::panic::unreachable(),
        }
    }
}

impl<T> SliceIndex<[T]> for RangeInclusive<usize> {
    type Output = [T];

    fn get(self, slice: &[T]) -> Option<&[T]> {
        if *self.end() == usize::MAX {
            return Option::None;
        }
        (*self.start()..*self.end() + 1).get(slice)
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {
        if *self.end() == usize::MAX {
            return Option::None;
        }
        (*self.start()..*self.end() + 1).get_mut(slice)
    }

    fn index(self, slice: &[T]) -> &[T] {
        if *self.end() == usize::MAX {
            crate::panic::panic("attempted to index slice up to maximum usize");
        }
        (*self.start()..*self.end() + 1).index(slice)
    }

    fn index_mut(self, slice: &mut [T]) -> &mut [T] {
        if *self.end() == usize::MAX {
            crate::panic::panic("attempted to index slice up to maximum usize");
        }
        (*self.start()..*self.end() + 1).index_mut(slice)
    }
}

impl<T> SliceIndex<[T]> for RangeFrom<usize> {
    type Output = [T];

    fn get(self, slice: &[T]) -> Option<&[T]> {
        (self.start..slice.len()).get(slice)
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {
        let n = slice.len();
        (self.start..n).get_mut(slice)
    }

    fn index(self, slice: &[T]) -> &[T] {
        (self.start..slice.len()).index(slice)
    }

    fn index_mut(self, slice: &mut [T]) -> &mut [T] {
        let n = slice.len();
        (self.start..n).index_mut(slice)
    }
}

impl<T> SliceIndex<[T]> for RangeTo<usize> {
    type Output = [T];

    fn get(self, slice: &[T]) -> Option<&[T]> {
        (0..self.end).get(slice)
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {
        (0..self.end).get_mut(slice)
    }

    fn index(self, slice: &[T]) -> &[T] {
        (0..self.end).index(slice)
    }

    fn index_mut(self, slice: &mut [T]) -> &mut [T] {
        (0..self.end).index_mut(slice)
    }
}

impl<T> SliceIndex<[T]> for RangeToInclusive<usize> {
    type Output = [T];

    fn get(self, slice: &[T]) -> Option<&[T]> {
        (0..=self.end).get(slice)
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {
        (0..=self.end).get_mut(slice)
    }

    fn index(self, slice: &[T]) -> &[T] {
        (0..=self.end).index(slice)
    }

    fn index_mut(self, slice: &mut [T]) -> &mut [T] {
        (0..=self.end).index_mut(slice)
    }
}

impl<T> SliceIndex<[T]> for RangeFull {
    type Output = [T];

    fn get(self, slice: &[T]) -> Option<&[T]> {
        Option::Some(slice)
    }

    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {
        Option::Some(slice)
    }

    fn index(self, slice: &[T]) -> &[T] {
        slice
    }

    fn index_mut(self, slice: &mut [T]) -> &mut [T] {
        slice
    }
}

// `s[i]` and `&s[a..b]`: built in for slices in 0.27.0; this is the trait's.
impl<T, I: SliceIndex<[T]>> Index<I> for [T] {
    type Output = I::Output;

    fn index(&self, index: I) -> &I::Output {
        index.index(self)
    }
}

impl<T, I: SliceIndex<[T]>> IndexMut<I> for [T] {
    fn index_mut(&mut self, index: I) -> &mut I::Output {
        index.index_mut(self)
    }
}

// Element by element; any two slices whose elements compare.
// mvs: [T]::impl Eq
// std2: changed: PartialEq over any [T] (MVS: Eq for [u8] and structural ==)
impl<T: PartialEq<U>, U> PartialEq<[U]> for [T] {
    fn eq(&self, other: &[U]) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let mut i: usize = 0;
        while i < self.len() {
            if self[i] != other[i] {
                return false;
            }
            i += 1;
        }
        true
    }
}

impl<T: Eq> Eq for [T] {}

// Lexicographic.
impl<T: PartialOrd> PartialOrd for [T] {
    fn partial_cmp(&self, other: &[T]) -> Option<Ordering> {
        let n = crate::cmp::min(self.len(), other.len());
        let mut i: usize = 0;
        while i < n {
            match self[i].partial_cmp(&other[i]) {
                Option::Some(Ordering::Equal) => {}
                c => return c,
            }
            i += 1;
        }
        self.len().partial_cmp(&other.len())
    }
}

// mvs: [T]::impl Ord
// std2: changed: Ord over any [T] (MVS: Ord for [u8])
impl<T: Ord> Ord for [T] {
    fn cmp(&self, other: &[T]) -> Ordering {
        let n = crate::cmp::min(self.len(), other.len());
        let mut i: usize = 0;
        while i < n {
            match self[i].cmp(&other[i]) {
                Ordering::Equal => {}
                c => return c,
            }
            i += 1;
        }
        self.len().cmp(&other.len())
    }
}

// The length, then each element.
// mvs: [T]::impl Hash
// std2: changed: Hash over any [T] (MVS: Hash for [u8])
impl<T: Hash> Hash for [T] {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_usize(self.len());
        Hash::hash_slice(self, state)
    }
}

// `[1, 2, 3]`.
// mvs: [T]::impl Debug
// std2: changed: Debug over any [T] (MVS: Debug for [u8])
impl<T: Debug> Debug for [T] {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.debug_list().entries(self.iter()).finish()
    }
}

// `slice.to_owned_in(a)`: a Vec<T, A> of clones.
impl<T: Clone, A: Allocator> ToOwnedIn<A> for [T] {
    type Owned = Vec<T, A>;

    fn to_owned_in(&self, a: A) -> Vec<T, A> {
        self.to_vec_in(a)
    }
}

// later: impl_for_ref
impl<'a, T> Default for &'a [T] {
    fn default() -> &'a [T] {
        // UNSAFE: an empty slice made from a dangling, aligned pointer (what
        // `&[]` promotes to: no element is ever read).
        // SAFETY: length 0, so no memory is reached; the pointer is non-null
        // and aligned for T, as from_raw_parts asks.
        unsafe { from_raw_parts(crate::ptr::NonNull::<T>::dangling().as_ptr() as *const T, 0) }
    }
}

impl<'a, T> IntoIterator for &'a [T] {
    type Item = &'a T;
    type IntoIter = Iter<'a, T>;

    fn into_iter(self) -> Iter<'a, T> {
        self.iter()
    }
}

impl<'a, T> IntoIterator for &'a mut [T] {
    type Item = &'a mut T;
    type IntoIter = IterMut<'a, T>;

    fn into_iter(self) -> IterMut<'a, T> {
        self.iter_mut()
    }
}

// [T]::iter's iterator: &T's, from either end.
pub struct Iter<'a, T> {
    v: &'a [T],
}

impl<'a, T> Iter<'a, T> {
    // What is left, as a slice.
    pub fn as_slice(&self) -> &'a [T] {
        self.v
    }
}

impl<'a, T> Clone for Iter<'a, T> {
    fn clone(&self) -> Iter<'a, T> {
        Iter { v: self.v }
    }
}

impl<'a, T> Iterator for Iter<'a, T> {
    type Item = &'a T;

    fn next(&mut self) -> Option<&'a T> {
        match self.v.split_first() {
            Option::Some((x, rest)) => {
                self.v = rest;
                Option::Some(x)
            }
            Option::None => Option::None,
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.v.len(), Option::Some(self.v.len()))
    }
}

impl<'a, T> DoubleEndedIterator for Iter<'a, T> {
    fn next_back(&mut self) -> Option<&'a T> {
        match self.v.split_last() {
            Option::Some((x, rest)) => {
                self.v = rest;
                Option::Some(x)
            }
            Option::None => Option::None,
        }
    }
}

impl<'a, T> ExactSizeIterator for Iter<'a, T> {}

// [T]::iter_mut's iterator: &mut T's, from either end.
pub struct IterMut<'a, T> {
    v: &'a mut [T],
}

impl<'a, T> IterMut<'a, T> {
    // What is left, as a &mut slice.
    pub fn into_slice(self) -> &'a mut [T] {
        self.v
    }
}

impl<'a, T> Iterator for IterMut<'a, T> {
    type Item = &'a mut T;

    fn next(&mut self) -> Option<&'a mut T> {
        let v = crate::mem::replace(&mut self.v, &mut []);
        if v.is_empty() {
            return Option::None;
        }
        let (head, rest) = v.split_at_mut(1);
        self.v = rest;
        Option::Some(&mut head[0])
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.v.len(), Option::Some(self.v.len()))
    }
}

impl<'a, T> DoubleEndedIterator for IterMut<'a, T> {
    fn next_back(&mut self) -> Option<&'a mut T> {
        let v = crate::mem::replace(&mut self.v, &mut []);
        let n = v.len();
        if n == 0 {
            return Option::None;
        }
        let (rest, tail) = v.split_at_mut(n - 1);
        self.v = rest;
        Option::Some(&mut tail[0])
    }
}

impl<'a, T> ExactSizeIterator for IterMut<'a, T> {}

// [T]::chunks's iterator.
pub struct Chunks<'a, T> {
    v: &'a [T],
    size: usize,
}

impl<'a, T> Iterator for Chunks<'a, T> {
    type Item = &'a [T];

    fn next(&mut self) -> Option<&'a [T]> {
        if self.v.is_empty() {
            return Option::None;
        }
        let n = crate::cmp::min(self.size, self.v.len());
        let (head, tail) = self.v.split_at(n);
        self.v = tail;
        Option::Some(head)
    }
}

impl<'a, T> DoubleEndedIterator for Chunks<'a, T> {
    fn next_back(&mut self) -> Option<&'a [T]> {
        let n = self.v.len();
        if n == 0 {
            return Option::None;
        }
        let r = n % self.size;
        let last = if r == 0 { self.size } else { r };
        let (head, tail) = self.v.split_at(n - last);
        self.v = head;
        Option::Some(tail)
    }
}

impl<'a, T> ExactSizeIterator for Chunks<'a, T> {}

// [T]::chunks_mut's iterator.
pub struct ChunksMut<'a, T> {
    v: &'a mut [T],
    size: usize,
}

impl<'a, T> Iterator for ChunksMut<'a, T> {
    type Item = &'a mut [T];

    fn next(&mut self) -> Option<&'a mut [T]> {
        let v = crate::mem::replace(&mut self.v, &mut []);
        if v.is_empty() {
            return Option::None;
        }
        let n = crate::cmp::min(self.size, v.len());
        let (head, tail) = v.split_at_mut(n);
        self.v = tail;
        Option::Some(head)
    }
}

// [T]::chunks_exact's iterator.
pub struct ChunksExact<'a, T> {
    v: &'a [T],
    rem: &'a [T],
    size: usize,
}

impl<'a, T> ChunksExact<'a, T> {
    // The elements past the last whole chunk.
    pub fn remainder(&self) -> &'a [T] {
        self.rem
    }
}

impl<'a, T> Iterator for ChunksExact<'a, T> {
    type Item = &'a [T];

    fn next(&mut self) -> Option<&'a [T]> {
        if self.v.len() < self.size {
            return Option::None;
        }
        let (head, tail) = self.v.split_at(self.size);
        self.v = tail;
        Option::Some(head)
    }
}

impl<'a, T> DoubleEndedIterator for ChunksExact<'a, T> {
    fn next_back(&mut self) -> Option<&'a [T]> {
        let n = self.v.len();
        if n < self.size {
            return Option::None;
        }
        let (head, tail) = self.v.split_at(n - self.size);
        self.v = head;
        Option::Some(tail)
    }
}

impl<'a, T> ExactSizeIterator for ChunksExact<'a, T> {}

// [T]::windows's iterator.
pub struct Windows<'a, T> {
    v: &'a [T],
    size: usize,
}

impl<'a, T> Iterator for Windows<'a, T> {
    type Item = &'a [T];

    fn next(&mut self) -> Option<&'a [T]> {
        if self.size > self.v.len() {
            return Option::None;
        }
        let w = &self.v[..self.size];
        self.v = &self.v[1..];
        Option::Some(w)
    }
}

impl<'a, T> DoubleEndedIterator for Windows<'a, T> {
    fn next_back(&mut self) -> Option<&'a [T]> {
        let n = self.v.len();
        if self.size > n {
            return Option::None;
        }
        let w = &self.v[n - self.size..];
        self.v = &self.v[..n - 1];
        Option::Some(w)
    }
}

impl<'a, T> ExactSizeIterator for Windows<'a, T> {}

// [T]::split's iterator.
pub struct Split<'a, T, P> {
    v: &'a [T],
    pred: P,
    finished: bool,
}

impl<'a, T, P: FnMut(&T) -> bool> Iterator for Split<'a, T, P> {
    type Item = &'a [T];

    fn next(&mut self) -> Option<&'a [T]> {
        if self.finished {
            return Option::None;
        }
        let mut i: usize = 0;
        while i < self.v.len() {
            if (self.pred)(&self.v[i]) {
                let head = &self.v[..i];
                self.v = &self.v[i + 1..];
                return Option::Some(head);
            }
            i += 1;
        }
        self.finished = true;
        Option::Some(self.v)
    }
}

impl<'a, T, P: FnMut(&T) -> bool> DoubleEndedIterator for Split<'a, T, P> {
    fn next_back(&mut self) -> Option<&'a [T]> {
        if self.finished {
            return Option::None;
        }
        let mut i = self.v.len();
        while i > 0 {
            i -= 1;
            if (self.pred)(&self.v[i]) {
                let tail = &self.v[i + 1..];
                self.v = &self.v[..i];
                return Option::Some(tail);
            }
        }
        self.finished = true;
        Option::Some(self.v)
    }
}
