// EDITION: rust
// std::env: the program's arguments and environment, Rust's names. The
// arguments are views of argv, valid for the whole program (no
// allocation); a variable's value is copied onto an allocator (`var_in`),
// since the environment can change under a view. argv comes from the
// target's system, std::__sys (std2/rt/sys_macos.vl, sys_linux.vl).
// mvs: std::env

use crate::alloc::Allocator;
use crate::fmt::{Debug, Display, Formatter};
use crate::iter::{DoubleEndedIterator, ExactSizeIterator, Iterator};
use crate::option::Option;
use crate::result::Result;
use crate::string::String;
use crate::vec::Vec;

// The i-th of n C strings at argv, its bytes (without the NUL).
fn arg_bytes(argv: *const *const u8, n: usize, i: usize) -> &'static [u8] {
    if i >= n {
        crate::panic::panic("env: argument index out of bounds");
    }
    // UNSAFE: reads argv[i] and the NUL-ended C string it points to.
    // SAFETY: i < n = argc (checked); argv[0..argc] are crt's (or the
    // /proc copy's) NUL-ended strings, kept for the whole program and
    // never written after main starts.
    unsafe {
        let p = *argv.add(i);
        let mut len: usize = 0;
        while *p.add(len) != 0 {
            len += 1;
        }
        crate::ptr::slice_parts(p, len)
    }
}

// The arguments, the program's name first: `for a in env::args()`,
// `env::args().skip(1)`. One that is not UTF-8 stops the program (as
// Rust's); `args_os()` yields bytes.
// std2: changed: yields &'static str views, not Strings (no allocator)
pub fn args() -> Args {
    let (n, argv) = crate::__sys::args();
    Args { front: 0, back: n, n: n, argv: argv }
}

// The arguments as bytes.
// std2: changed: yields &'static [u8] (Rust: OsString)
pub fn args_os() -> ArgsOs {
    let (n, argv) = crate::__sys::args();
    ArgsOs { front: 0, back: n, n: n, argv: argv }
}

// env::args's iterator.
pub struct Args {
    front: usize,
    back: usize,
    n: usize,
    argv: *const *const u8,
}

fn arg_str(b: &'static [u8]) -> &'static str {
    match crate::str::from_utf8(b) {
        Result::Ok(s) => s,
        Result::Err(_) => crate::panic::panic(
            "env::args: an argument is not UTF-8 (env::args_os yields bytes)"),
    }
}

impl Iterator for Args {
    type Item = &'static str;

    fn next(&mut self) -> Option<&'static str> {
        if self.front >= self.back {
            return Option::None;
        }
        let b = arg_bytes(self.argv, self.n, self.front);
        self.front += 1;
        Option::Some(arg_str(b))
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        let k = self.back - self.front;
        (k, Option::Some(k))
    }
}

impl DoubleEndedIterator for Args {
    fn next_back(&mut self) -> Option<&'static str> {
        if self.front >= self.back {
            return Option::None;
        }
        self.back -= 1;
        Option::Some(arg_str(arg_bytes(self.argv, self.n, self.back)))
    }
}

impl ExactSizeIterator for Args {}

impl Debug for Args {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        let mut l = f.debug_list();
        let mut i = self.front;
        while i < self.back {
            l.entry(&arg_str(arg_bytes(self.argv, self.n, i)));
            i += 1;
        }
        l.finish()
    }
}

// env::args_os's iterator.
pub struct ArgsOs {
    front: usize,
    back: usize,
    n: usize,
    argv: *const *const u8,
}

impl Iterator for ArgsOs {
    type Item = &'static [u8];

    fn next(&mut self) -> Option<&'static [u8]> {
        if self.front >= self.back {
            return Option::None;
        }
        let b = arg_bytes(self.argv, self.n, self.front);
        self.front += 1;
        Option::Some(b)
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        let k = self.back - self.front;
        (k, Option::Some(k))
    }
}

impl DoubleEndedIterator for ArgsOs {
    fn next_back(&mut self) -> Option<&'static [u8]> {
        if self.front >= self.back {
            return Option::None;
        }
        self.back -= 1;
        Option::Some(arg_bytes(self.argv, self.n, self.back))
    }
}

impl ExactSizeIterator for ArgsOs {}

// Why env::var_in failed: the variable is not set, or its value is not
// UTF-8.
// std2: changed: NotUnicode has no payload (Rust: the OsString)
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum VarError {
    NotPresent,
    NotUnicode,
}

impl Display for VarError {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        match self {
            VarError::NotPresent => f.write_str("environment variable not found"),
            VarError::NotUnicode => f.write_str("environment variable was not valid unicode"),
        }
    }
}

// UNSAFE: C. SAFETY: POSIX's prototypes (stdlib.h).
extern "C" {
    #[link_name = "getenv"]
    fn env_c_getenv(name: *const u8) -> *const u8;
    #[link_name = "setenv"]
    fn env_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;
    #[link_name = "unsetenv"]
    fn env_c_unsetenv(name: *const u8) -> i32;
}

// s and a NUL in buf; false when it does not fit or holds a NUL (or, for
// a name, is empty or holds `=`: no variable has such a name).
fn c_string(s: &str, buf: &mut [u8], name: bool) -> bool {
    let b = s.as_bytes();
    if b.len() >= buf.len() || (name && b.len() == 0) {
        return false;
    }
    let mut i: usize = 0;
    while i < b.len() {
        if b[i] == 0 || (name && b[i] == 61) {
            return false;
        }
        buf[i] = b[i];
        i += 1;
    }
    buf[b.len()] = 0;
    true
}

// The value of variable key, as the bytes C's environment holds now.
fn get_bytes(key: &str) -> Option<&'static [u8]> {
    let mut nb = [0u8; 1024];
    if !c_string(key, &mut nb[..], true) {
        return Option::None;
    }
    // UNSAFE: C's getenv, then a view of the C string it returns.
    // SAFETY: nb holds a NUL-ended name; getenv's result is null or a
    // NUL-ended string of the environment, read here before the caller
    // copies it (set_var and remove_var, which may free it, are unsafe
    // and their callers promise no reader meanwhile).
    unsafe {
        let p = env_c_getenv(&nb[0] as *const u8);
        if p.is_null() {
            return Option::None;
        }
        let mut len: usize = 0;
        while *p.add(len) != 0 {
            len += 1;
        }
        Option::Some(crate::ptr::slice_parts(p, len))
    }
}

// The value of variable key, copied into a new String on allocator a
// (Rust's env::var).
// mvs: get_in
// std2: changed: the key is a &str
pub fn var_in<A: Allocator>(key: &str, a: A) -> Result<String<A>, VarError> {
    match get_bytes(key) {
        Option::Some(v) => match crate::str::from_utf8(v) {
            Result::Ok(s) => Result::Ok(String::from_in(s, a)),
            Result::Err(_) => Result::Err(VarError::NotUnicode),
        },
        Option::None => Result::Err(VarError::NotPresent),
    }
}

// The value of variable key, its bytes copied into a new Vec on a.
// std2: changed: the key is a &str, the value a Vec<u8, A> (Rust: OsString)
pub fn var_os_in<A: Allocator>(key: &str, a: A) -> Option<Vec<u8, A>> {
    match get_bytes(key) {
        Option::Some(v) => {
            let mut out: Vec<u8, A> = Vec::with_capacity_in(v.len(), a);
            out.extend_from_slice(v);
            Option::Some(out)
        }
        Option::None => Option::None,
    }
}

// Sets variable key to value (Rust 2024's `unsafe fn`). Panics on a key
// that is empty or holds `=` or a NUL, or a value with a NUL (as Rust's),
// and on a key over 1 KB or a value over 64 KB.
// UNSAFE: changes the environment (C's setenv), which another thread's
// getenv may be reading.
// SAFETY: (the caller's) no other thread reads or writes the environment
// meanwhile, and no value read from it before (a getenv view) is used
// after.
// std2: changed: key and value are &str
pub unsafe fn set_var(key: &str, value: &str) {
    let mut nb = [0u8; 1024];
    let mut vb = [0u8; 65536];
    if !c_string(key, &mut nb[..], true) || !c_string(value, &mut vb[..], false) {
        crate::panic::panic("env::set_var: a key or value that C's environment cannot hold");
    }
    // UNSAFE: C's setenv. SAFETY: two NUL-ended strings; the caller's
    // promise above.
    let _ = unsafe { env_c_setenv(&nb[0] as *const u8, &vb[0] as *const u8, 1) };
}

// Removes variable key (Rust 2024's `unsafe fn`).
// UNSAFE: as set_var: C's unsetenv.
// SAFETY: (the caller's) as set_var.
// std2: changed: the key is a &str
pub unsafe fn remove_var(key: &str) {
    let mut nb = [0u8; 1024];
    if !c_string(key, &mut nb[..], true) {
        crate::panic::panic("env::remove_var: a key that C's environment cannot hold");
    }
    // UNSAFE: C's unsetenv. SAFETY: a NUL-ended string; the caller's
    // promise above.
    let _ = unsafe { env_c_unsetenv(&nb[0] as *const u8) };
}
