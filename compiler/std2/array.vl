// EDITION: rust
// std::array: an array's by-value iterator. Its impls are compiler-provided
// for every length N (`#[array_builtin(N)]`, F15.3) until const generics.

use crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};
use crate::marker::PhantomData;
use crate::mem::ManuallyDrop;
use crate::option::Option;

// `[T; N]::into_iter`'s: the elements by value, each once; the ones not
// yielded are dropped with it.
// (Rust's is IntoIter<T, const N: usize>; const generics, 0.29, make it so)
// std2: changed: IntoIter<T, [T; N]> until const generics (FL13)
pub struct IntoIter<T, Arr> {
    data: ManuallyDrop<Arr>,
    start: usize,
    end: usize,
    marker: PhantomData<T>,
}

#[array_builtin(N)]
impl<T> IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = IntoIter<T, [T; N]>;

    fn into_iter(self) -> IntoIter<T, [T; N]> {
        IntoIter { data: ManuallyDrop::new(self), start: 0, end: N, marker: PhantomData }
    }
}

#[array_builtin(N)]
impl<T> IntoIter<T, [T; N]> {
    // The address of element i.
    fn slot(&mut self, i: usize) -> *mut T {
        let base = &mut *self.data as *mut [T; N] as *mut T;
        // UNSAFE: an offset in the array.
        // SAFETY: i < N (start <= i < end <= N at every call).
        unsafe { base.add(i) }
    }
}

#[array_builtin(N)]
impl<T> Iterator for IntoIter<T, [T; N]> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        if self.start == self.end {
            return Option::None;
        }
        let p = self.slot(self.start);
        self.start += 1;
        // UNSAFE: moves element start out.
        // SAFETY: it was in [start, end), initialized, and start moving
        // past it means it is read once.
        Option::Some(unsafe { crate::ptr::read(p as *const T) })
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.end - self.start, Option::Some(self.end - self.start))
    }
}

#[array_builtin(N)]
impl<T> DoubleEndedIterator for IntoIter<T, [T; N]> {
    fn next_back(&mut self) -> Option<T> {
        if self.start == self.end {
            return Option::None;
        }
        self.end -= 1;
        let p = self.slot(self.end);
        // UNSAFE: moves element end out.
        // SAFETY: it was in [start, end) and, end moving below it, is read once.
        Option::Some(unsafe { crate::ptr::read(p as *const T) })
    }
}

#[array_builtin(N)]
impl<T> ExactSizeIterator for IntoIter<T, [T; N]> {}

#[array_builtin(N)]
impl<T> Drop for IntoIter<T, [T; N]> {
    fn drop(&mut self) {
        while self.start < self.end {
            let p = self.slot(self.start);
            self.start += 1;
            // UNSAFE: drops an element not yielded.
            // SAFETY: [start, end) is initialized, each dropped once (start
            // moved past it first); the array itself is a ManuallyDrop.
            unsafe { crate::ptr::drop_in_place(p) };
        }
    }
}
