// EDITION: rust
// std::fs: files and directories, Rust's. A path is a &str until std2
// has std::path (`fs::metadata(&s)` takes a &String through its deref);
// it reaches C as a NUL-ended copy on the stack, so nothing here allocates
// but what returns a Vec or a String, on the allocator given. A path that
// holds a NUL is InvalidInput, one longer than the system's PATH_MAX the
// OS's ENAMETOOLONG (Rust passes it to the OS, which says the same).
// mvs: std::fs

use crate::alloc::Allocator;
use crate::convert::AsRef;
use crate::io::{Error, ErrorKind, Read, Result, Seek, SeekFrom, Write};
use crate::iter::Iterator;
use crate::ops::Drop;
use crate::option::Option;
use crate::string::String;
use crate::time::SystemTime;
use crate::vec::Vec;

// UNSAFE: the OS's file and directory calls, which take NUL-ended paths
// and buffers as raw pointers.
// SAFETY: POSIX's prototypes (fcntl.h, unistd.h, sys/stat.h, dirent.h,
// stdio.h); open's mode is variadic, as declared. The callers pass a
// CPath's buffer (NUL-ended), a StatBuf's words (larger than either
// system's struct stat) and a DIR * that opendir returned.
extern "C" {
    #[link_name = "open"]
    fn fs_c_open(path: *const u8, flags: i32, ...) -> i32;
    #[link_name = "close"]
    fn fs_c_close(fd: i32) -> i32;
    #[link_name = "lseek"]
    fn fs_c_lseek(fd: i32, off: i64, whence: i32) -> i64;
    #[link_name = "ftruncate"]
    fn fs_c_ftruncate(fd: i32, len: i64) -> i32;
    #[link_name = "fsync"]
    fn fs_c_fsync(fd: i32) -> i32;
    #[link_name = "fchmod"]
    fn fs_c_fchmod(fd: i32, mode: u32) -> i32;
    #[link_name = "fstat"]
    fn fs_c_fstat(fd: i32, buf: *mut u64) -> i32;
    #[link_name = "stat"]
    fn fs_c_stat(path: *const u8, buf: *mut u64) -> i32;
    #[link_name = "lstat"]
    fn fs_c_lstat(path: *const u8, buf: *mut u64) -> i32;
    #[link_name = "mkdir"]
    fn fs_c_mkdir(path: *const u8, mode: u32) -> i32;
    #[link_name = "rmdir"]
    fn fs_c_rmdir(path: *const u8) -> i32;
    #[link_name = "unlink"]
    fn fs_c_unlink(path: *const u8) -> i32;
    #[link_name = "rename"]
    fn fs_c_rename(from: *const u8, to: *const u8) -> i32;
    #[link_name = "opendir"]
    fn fs_c_opendir(path: *const u8) -> *mut u8;
    #[link_name = "readdir"]
    fn fs_c_readdir(dir: *mut u8) -> *const u8;
    #[link_name = "closedir"]
    fn fs_c_closedir(dir: *mut u8) -> i32;
}

const O_RDONLY: i32 = 0;
const O_WRONLY: i32 = 1;
const O_RDWR: i32 = 2;
const S_IFMT: u32 = 0xf000;
const S_IFDIR: u32 = 0x4000;
const S_IFREG: u32 = 0x8000;
const S_IFLNK: u32 = 0xa000;
const DT_DIR: u8 = 4;
const DT_REG: u8 = 8;
const DT_LNK: u8 = 10;
const EINVAL: i32 = 22;

// A path and its NUL, as C takes it.
struct CPath {
    buf: [u8; crate::__sys::PATH_MAX],
}

impl CPath {
    #[effects()]
    fn ptr(&self) -> *const u8 {
        &self.buf[0] as *const u8
    }
}

// path as C takes it: InvalidInput when it holds a NUL, ENAMETOOLONG when
// it does not fit.
#[effects(panic, diverge)]
fn cpath(path: &str) -> Result<CPath> {
    let b = path.as_bytes();
    let mut p = CPath { buf: [0u8; crate::__sys::PATH_MAX] };
    if b.len() >= p.buf.len() {
        return crate::result::Result::Err(Error::from_raw_os_error(crate::__sys::ENAMETOOLONG));
    }
    let mut i: usize = 0;
    while i < b.len() {
        if b[i] == 0 {
            return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,
                "file name contained an unexpected NUL byte"));
        }
        p.buf[i] = b[i];
        i += 1;
    }
    crate::result::Result::Ok(p)
}

// A C call's -1 as the io::Error errno says.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
fn cvt(r: i32) -> Result<()> {
    if r < 0 {
        crate::result::Result::Err(Error::last_os_error())
    } else {
        crate::result::Result::Ok(())
    }
}

#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
fn open_c(path: &str, flags: i32, mode: u32) -> Result<File> {
    let p = cpath(path)?;
    // UNSAFE: C's open. SAFETY: p is NUL-ended and lives past the call;
    // the mode is the variadic int open reads when it creates the file.
    let fd = unsafe { fs_c_open(p.ptr(), flags | crate::__sys::O_CLOEXEC, mode as i32) };
    if fd < 0 {
        return crate::result::Result::Err(Error::last_os_error());
    }
    crate::result::Result::Ok(File { fd: fd })
}

// Room for either system's struct stat (144 bytes on macOS, 128 on Linux).
struct StatBuf {
    words: [u64; 20],
}

#[effects()]
fn metadata_of(b: &StatBuf) -> Metadata {
    let (mode, size, mtime, mtime_nsec) = crate::__sys::stat_fields(&b.words);
    Metadata { mode: mode, size: size, mtime: mtime, mtime_nsec: mtime_nsec }
}

// stat, or lstat (follow false), of the file at path.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
fn stat_at(path: &str, follow: bool) -> Result<Metadata> {
    let p = cpath(path)?;
    let mut b = StatBuf { words: [0u64; 20] };
    // UNSAFE: C's stat and lstat. SAFETY: p is NUL-ended; b.words is 160
    // bytes, 8-aligned, more than either system's struct stat.
    let r = unsafe {
        if follow {
            fs_c_stat(p.ptr(), &mut b.words[0] as *mut u64)
        } else {
            fs_c_lstat(p.ptr(), &mut b.words[0] as *mut u64)
        }
    };
    cvt(r)?;
    crate::result::Result::Ok(metadata_of(&b))
}

// ---- Files ----

// An open file; dropping it closes it.
pub struct File {
    fd: i32,
}

impl Drop for File {
    fn drop(&mut self) {
        // UNSAFE: C's close. SAFETY: fd is this File's own descriptor,
        // closed once (here).
        let _ = unsafe { fs_c_close(self.fd) };
    }
}

impl File {
    // Opens path for reading.
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn open(path: &str) -> Result<File> {
        open_c(path, O_RDONLY, 0x1b6)
    }

    // Opens path for writing: made when it is not there, emptied when it is.
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn create(path: &str) -> Result<File> {
        open_c(path, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC, 0x1b6)
    }

    // Makes path and opens it for reading and writing: AlreadyExists when
    // it is there.
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn create_new(path: &str) -> Result<File> {
        open_c(path, O_RDWR | crate::__sys::O_CREAT | crate::__sys::O_EXCL, 0x1b6)
    }

    // The options to open a file with: `File::options().append(true)`.
    #[effects()]
    pub fn options() -> OpenOptions {
        OpenOptions::new()
    }

    // Its file descriptor.
    // std2: changed: File's own (Rust's: std::os::fd::AsRawFd)
    #[effects()]
    pub fn as_raw_fd(&self) -> i32 {
        self.fd
    }

    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn metadata(&self) -> Result<Metadata> {
        let mut b = StatBuf { words: [0u64; 20] };
        // UNSAFE: C's fstat. SAFETY: b.words as in stat_at.
        cvt(unsafe { fs_c_fstat(self.fd, &mut b.words[0] as *mut u64) })?;
        crate::result::Result::Ok(metadata_of(&b))
    }

    // Its length becomes size (cut, or zeros after).
    // std2: changed: u64 (MVS: i64)
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn set_len(&self, size: u64) -> Result<()> {
        if size > i64::MAX as u64 {
            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));
        }
        // UNSAFE: C's ftruncate. SAFETY: integers only.
        cvt(unsafe { fs_c_ftruncate(self.fd, size as i64) })
    }

    // What the system holds of it, written to the disk.
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn sync_all(&self) -> Result<()> {
        // UNSAFE: C's fsync. SAFETY: an int only.
        cvt(unsafe { fs_c_fsync(self.fd) })
    }
}

// `File { fd: 3 }`.
// std2: changed: the descriptor only (Rust's adds the path and the mode)
impl crate::fmt::Debug for File {
    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {
        f.debug_struct("File").field("fd", &self.fd).finish()
    }
}

impl Read for File {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
        crate::io::sys_read(self.fd, buf)
    }
}

impl Write for File {
    fn write(&mut self, buf: &[u8]) -> Result<usize> {
        crate::io::sys_write(self.fd, buf)
    }

    fn flush(&mut self) -> Result<()> {
        crate::result::Result::Ok(())
    }
}

// A shared File reads and writes too (the OS keeps its position).
impl Read for &File {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
        crate::io::sys_read(self.fd, buf)
    }
}

impl Write for &File {
    fn write(&mut self, buf: &[u8]) -> Result<usize> {
        crate::io::sys_write(self.fd, buf)
    }

    fn flush(&mut self) -> Result<()> {
        crate::result::Result::Ok(())
    }
}

// mvs: File::seek
impl Seek for File {
    fn seek(&mut self, pos: SeekFrom) -> Result<u64> {
        let (off, whence) = match pos {
            SeekFrom::Start(o) => {
                if o > i64::MAX as u64 {
                    return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));
                }
                (o as i64, 0)
            }
            SeekFrom::Current(o) => (o, 1),
            SeekFrom::End(o) => (o, 2),
        };
        // UNSAFE: C's lseek. SAFETY: integers only.
        let r = unsafe { fs_c_lseek(self.fd, off, whence) };
        if r < 0 {
            return crate::result::Result::Err(Error::last_os_error());
        }
        crate::result::Result::Ok(r as u64)
    }
}

// How File::open opens a file, Rust's builder:
// `OpenOptions::new().append(true).create(true).open(p)?`.
#[derive(Clone, Debug)]
pub struct OpenOptions {
    read: bool,
    write: bool,
    append: bool,
    truncate: bool,
    create: bool,
    create_new: bool,
    mode: u32,
}

impl OpenOptions {
    // Every option off (open fails until read, write or append is on).
    #[effects()]
    pub fn new() -> OpenOptions {
        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,
            create_new: false, mode: 0x1b6 }
    }

    // std2: changed: &mut self, as Rust's (MVS: by value)
    #[effects()]
    pub fn read(&mut self, read: bool) -> &mut OpenOptions {
        self.read = read;
        self
    }

    // std2: changed: &mut self, as Rust's (MVS: by value)
    #[effects()]
    pub fn write(&mut self, write: bool) -> &mut OpenOptions {
        self.write = write;
        self
    }

    // Writes go to the end (write is implied).
    // std2: changed: &mut self, as Rust's (MVS: by value)
    #[effects()]
    pub fn append(&mut self, append: bool) -> &mut OpenOptions {
        self.append = append;
        self
    }

    // std2: changed: &mut self, as Rust's (MVS: by value)
    #[effects()]
    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {
        self.truncate = truncate;
        self
    }

    // std2: changed: &mut self, as Rust's (MVS: by value)
    #[effects()]
    pub fn create(&mut self, create: bool) -> &mut OpenOptions {
        self.create = create;
        self
    }

    // std2: changed: &mut self, as Rust's (MVS: by value)
    #[effects()]
    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {
        self.create_new = create_new;
        self
    }

    // The permission bits a file it makes gets (0x1b6 before the umask).
    // std2: changed: OpenOptions' own, a u32 (Rust's:
    // std::os::unix::fs::OpenOptionsExt)
    #[effects()]
    pub fn mode(&mut self, mode: u32) -> &mut OpenOptions {
        self.mode = mode;
        self
    }

    // Opens path with these options: InvalidInput (EINVAL) for none of
    // read, write and append, or a create or truncate without a write, as
    // Rust's.
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn open(&self, path: &str) -> Result<File> {
        let access = if self.append {
            (if self.read { O_RDWR } else { O_WRONLY }) | crate::__sys::O_APPEND
        } else if self.read && self.write {
            O_RDWR
        } else if self.write {
            O_WRONLY
        } else if self.read {
            O_RDONLY
        } else {
            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));
        };
        if !self.write && !self.append && (self.truncate || self.create || self.create_new) {
            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));
        }
        if self.append && self.truncate && !self.create_new {
            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));
        }
        let creation = if self.create_new {
            crate::__sys::O_CREAT | crate::__sys::O_EXCL
        } else {
            (if self.create { crate::__sys::O_CREAT } else { 0 })
                | (if self.truncate { crate::__sys::O_TRUNC } else { 0 })
        };
        open_c(path, access | creation, self.mode)
    }
}

// What stat says of a file.
#[derive(Clone)]
pub struct Metadata {
    mode: u32,
    size: u64,
    mtime: i64,
    mtime_nsec: i64,
}

impl Metadata {
    // The size in bytes.
    #[effects()]
    pub fn len(&self) -> u64 {
        self.size
    }

    #[effects()]
    pub fn file_type(&self) -> FileType {
        FileType { fmt: self.mode & S_IFMT }
    }

    #[effects()]
    pub fn is_dir(&self) -> bool {
        self.mode & S_IFMT == S_IFDIR
    }

    #[effects()]
    pub fn is_file(&self) -> bool {
        self.mode & S_IFMT == S_IFREG
    }

    #[effects()]
    pub fn is_symlink(&self) -> bool {
        self.mode & S_IFMT == S_IFLNK
    }

    #[effects()]
    pub fn permissions(&self) -> Permissions {
        Permissions { mode: self.mode }
    }

    // When it was last written (UNIX_EPOCH for a time before it).
    // mvs: Metadata::modified
    // std2: changed: an io::Result<SystemTime>, as Rust's (MVS: a
    // Duration since the epoch)
    #[effects(panic, diverge)]
    pub fn modified(&self) -> Result<SystemTime> {
        let epoch = crate::time::UNIX_EPOCH;
        if self.mtime < 0 {
            return crate::result::Result::Ok(epoch);
        }
        let d = crate::time::Duration::new(self.mtime as u64, self.mtime_nsec as u32);
        match epoch.checked_add(d) {
            Option::Some(t) => crate::result::Result::Ok(t),
            Option::None => crate::result::Result::Ok(epoch),
        }
    }
}

// `Metadata { file_type: .., len: 6, .. }`.
// std2: changed: the kind and the length (Rust's adds the permissions and
// the times)
impl crate::fmt::Debug for Metadata {
    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {
        f.debug_struct("Metadata").field("file_type", &self.file_type()).field("len", &self.size)
            .finish_non_exhaustive()
    }
}

// A file's kind: a directory, a file, a symbolic link (or another).
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
pub struct FileType {
    fmt: u32,
}

impl FileType {
    #[effects()]
    pub fn is_dir(&self) -> bool {
        self.fmt == S_IFDIR
    }

    #[effects()]
    pub fn is_file(&self) -> bool {
        self.fmt == S_IFREG
    }

    #[effects()]
    pub fn is_symlink(&self) -> bool {
        self.fmt == S_IFLNK
    }
}

// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as
// Rust's.
impl crate::fmt::Debug for FileType {
    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {
        f.debug_struct("FileType").field("is_file", &self.is_file()).field("is_dir", &self.is_dir())
            .field("is_symlink", &self.is_symlink()).finish_non_exhaustive()
    }
}

// A file's permission bits.
#[derive(Clone, PartialEq, Eq)]
pub struct Permissions {
    mode: u32,
}

impl Permissions {
    // Whether no one may write it.
    #[effects()]
    pub fn readonly(&self) -> bool {
        self.mode & 0x92 == 0
    }

    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).
    // mvs: Metadata::mode
    // std2: changed: Permissions' own, st_mode as Rust's (Rust's:
    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)
    #[effects()]
    pub fn mode(&self) -> u32 {
        self.mode
    }
}

// ---- Whole files ----

// The bytes of the file at path, in a new Vec on a.
// std2: changed: an allocator; the path a &str until std::path (Rust's
// fs::read)
#[effects(alloc, io, static, panic, diverge, unsafe, A)]
pub fn read_in<A: Allocator>(path: &str, a: A) -> Result<Vec<u8, A>> {
    let mut f = File::open(path)?;
    let size = match f.metadata() {
        crate::result::Result::Ok(m) => m.len() as usize,
        crate::result::Result::Err(_) => 0,
    };
    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);
    f.read_to_end(&mut v)?;
    crate::result::Result::Ok(v)
}

// The text of the file at path, in a new String on a (InvalidData when it
// is not UTF-8).
// std2: changed: an allocator; the path a &str until std::path (Rust's
// fs::read_to_string)
#[effects(alloc, io, static, panic, diverge, unsafe, A)]
pub fn read_to_string_in<A: Allocator>(path: &str, a: A) -> Result<String<A>> {
    let mut f = File::open(path)?;
    let mut s = String::new_in(a);
    f.read_to_string(&mut s)?;
    crate::result::Result::Ok(s)
}

// The file at path holds contents: made, or emptied first.
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe, C)]
pub fn write<C: AsRef<[u8]>>(path: &str, contents: C) -> Result<()> {
    let mut f = File::create(path)?;
    // (the path call: `contents.as_ref()` where a &[u8] is expected picks
    // a wrong instance of AsRef for &T, 0.27.5's front gap)
    f.write_all(AsRef::<[u8]>::as_ref(&contents))
}

// Copies the file at from to to (made, or emptied), its permission bits
// too: the bytes copied.
// std2: changed: the paths &str until std::path; a u64 (MVS: i64)
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn copy(from: &str, to: &str) -> Result<u64> {
    let mut src = File::open(from)?;
    let m = src.metadata()?;
    if !m.is_file() {
        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,
            "the source path is neither a regular file nor a symlink to a regular file"));
    }
    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,
        m.mode & 0xfff)?;
    // UNSAFE: C's fchmod. SAFETY: integers only.
    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;
    let mut buf = [0u8; 65536];
    let mut total: u64 = 0;
    loop {
        let n = match src.read(&mut buf) {
            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),
            crate::result::Result::Ok(n) => n,
            crate::result::Result::Err(e) => {
                if e.kind() == ErrorKind::Interrupted {
                    continue;
                }
                return crate::result::Result::Err(e);
            }
        };
        dst.write_all(&buf[..n])?;
        total += n as u64;
    }
}

// What stat says of the file at path (through a symbolic link).
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn metadata(path: &str) -> Result<Metadata> {
    stat_at(path, true)
}

// As metadata, of a symbolic link itself.
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn symlink_metadata(path: &str) -> Result<Metadata> {
    stat_at(path, false)
}

// Whether something is at path (through a symbolic link): Ok(false) when
// nothing is, an error when the OS cannot say (Rust's fs::exists).
// std2: changed: an io::Result<bool>, as Rust's (MVS: a bool); the path a
// &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn exists(path: &str) -> Result<bool> {
    match stat_at(path, true) {
        crate::result::Result::Ok(_) => crate::result::Result::Ok(true),
        crate::result::Result::Err(e) => {
            if e.kind() == ErrorKind::NotFound {
                crate::result::Result::Ok(false)
            } else {
                crate::result::Result::Err(e)
            }
        }
    }
}

// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn remove_file(path: &str) -> Result<()> {
    let p = cpath(path)?;
    // UNSAFE: C's unlink. SAFETY: p is NUL-ended.
    cvt(unsafe { fs_c_unlink(p.ptr()) })
}

// Removes the empty directory at path.
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn remove_dir(path: &str) -> Result<()> {
    let p = cpath(path)?;
    // UNSAFE: C's rmdir. SAFETY: p is NUL-ended.
    cvt(unsafe { fs_c_rmdir(p.ptr()) })
}

// std2: changed: the paths &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn rename(from: &str, to: &str) -> Result<()> {
    let a = cpath(from)?;
    let b = cpath(to)?;
    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.
    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })
}

// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn create_dir(path: &str) -> Result<()> {
    let p = cpath(path)?;
    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.
    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })
}

// Whether path is a directory (through a symbolic link).
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
fn is_dir_at(path: &str) -> bool {
    match stat_at(path, true) {
        crate::result::Result::Ok(m) => m.is_dir(),
        crate::result::Result::Err(_) => false,
    }
}

// path's parent as Rust's Path::parent has it: "" for a relative name,
// None for the root (or "").
#[effects(panic, diverge)]
fn parent_of(path: &str) -> Option<&str> {
    let b = path.as_bytes();
    let mut end = b.len();
    while end > 0 && b[end - 1] == 47 {
        end -= 1;
    }
    if end == 0 {
        return Option::None;
    }
    while end > 0 && b[end - 1] != 47 {
        end -= 1;
    }
    if end == 0 {
        return Option::Some(&path[..0]);
    }
    let mut k = end;
    while k > 0 && b[k - 1] == 47 {
        k -= 1;
    }
    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }
}

// Makes the directory at path and those above it that are missing: Ok
// when it is there (Rust's, step for step).
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn create_dir_all(path: &str) -> Result<()> {
    if path.is_empty() {
        return crate::result::Result::Ok(());
    }
    match create_dir(path) {
        crate::result::Result::Ok(()) => return crate::result::Result::Ok(()),
        crate::result::Result::Err(e) => {
            if e.kind() != ErrorKind::NotFound {
                return if is_dir_at(path) {
                    crate::result::Result::Ok(())
                } else {
                    crate::result::Result::Err(e)
                };
            }
        }
    }
    match parent_of(path) {
        Option::Some(p) => create_dir_all(p)?,
        Option::None => {
            return crate::result::Result::Err(Error::other("failed to create whole tree"));
        }
    }
    match create_dir(path) {
        crate::result::Result::Ok(()) => crate::result::Result::Ok(()),
        crate::result::Result::Err(e) => {
            if is_dir_at(path) {
                crate::result::Result::Ok(())
            } else {
                crate::result::Result::Err(e)
            }
        }
    }
}

// Removes the directory at path and all it holds; a symbolic link is
// removed, not followed.
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn remove_dir_all(path: &str) -> Result<()> {
    let m = symlink_metadata(path)?;
    if m.is_symlink() {
        return remove_file(path);
    }
    if !m.is_dir() {
        return crate::result::Result::Err(Error::from_raw_os_error(20));
    }
    remove_tree(path)
}

// Removes the directory at path and everything under it.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
fn remove_tree(path: &str) -> Result<()> {
    let mut dir = read_dir(path)?;
    loop {
        let e = match dir.next() {
            Option::Some(r) => r?,
            Option::None => break,
        };
        if e.file_type()?.is_dir() {
            remove_tree(e.path())?;
        } else {
            remove_file(e.path())?;
        }
    }
    remove_dir(path)
}

// ---- Directories ----

// The entries of the directory at path ("." and ".." left out), in the
// order the file system gives them.
// std2: changed: the path a &str until std::path
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn read_dir(path: &str) -> Result<ReadDir> {
    let p = cpath(path)?;
    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.
    let d = unsafe { fs_c_opendir(p.ptr()) };
    if d.is_null() {
        return crate::result::Result::Err(Error::last_os_error());
    }
    let mut root = [0u8; crate::__sys::PATH_MAX];
    let b = path.as_bytes();
    let mut i: usize = 0;
    while i < b.len() {
        root[i] = b[i];
        i += 1;
    }
    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })
}

// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it
// closes the directory.
pub struct ReadDir {
    dir: *mut u8,
    root: [u8; crate::__sys::PATH_MAX],
    root_len: usize,
}

impl Drop for ReadDir {
    fn drop(&mut self) {
        // UNSAFE: C's closedir. SAFETY: dir is the DIR * opendir returned,
        // non-null (read_dir checks), closed once (here).
        let _ = unsafe { fs_c_closedir(self.dir) };
    }
}

impl Iterator for ReadDir {
    type Item = Result<DirEntry>;

    fn next(&mut self) -> Option<Result<DirEntry>> {
        loop {
            let mut e = DirEntry {
                path: [0u8; crate::__sys::PATH_MAX], len: 0, name_at: 0, kind: 0,
            };
            // UNSAFE: errno cleared, then C's readdir on the DIR *, and its
            // struct dirent read through the pointer readdir returns.
            // SAFETY: errno_location is this thread's errno; dir is open
            // (Drop closes it, after the last next); a non-null entry is a
            // struct dirent of this system (its d_type and d_name at the
            // offsets std::__sys gives), valid until the next readdir of
            // dir, and d_name is NUL-ended within it: its bytes are copied
            // out before this returns.
            let ok = unsafe {
                *crate::__sys::errno_location() = 0;
                let d = fs_c_readdir(self.dir);
                if d.is_null() {
                    let err = *crate::__sys::errno_location();
                    if err == 0 {
                        return Option::None;
                    }
                    return Option::Some(crate::result::Result::Err(Error::from_raw_os_error(err)));
                }
                e.kind = *d.add(crate::__sys::DIRENT_TYPE);
                let name = d.add(crate::__sys::DIRENT_NAME);
                let mut n: usize = 0;
                while *name.add(n) != 0 {
                    n += 1;
                }
                let nm = crate::slice::from_raw_parts(name, n);
                if nm == b"." || nm == b".." {
                    continue;
                }
                e.fill(&self.root[..self.root_len], nm)
            };
            if !ok {
                return Option::Some(crate::result::Result::Err(Error::new(
                    ErrorKind::InvalidData,
                    "a directory entry's name is not UTF-8 or the path is too long")));
            }
            return Option::Some(crate::result::Result::Ok(e));
        }
    }
}

// A directory's entry: its path (the directory's, then its name), kept
// inline, and its kind as the directory says it.
pub struct DirEntry {
    path: [u8; crate::__sys::PATH_MAX],
    len: usize,
    name_at: usize,
    kind: u8,
}

impl DirEntry {
    // root, a "/" unless root ends with one, and name: false when it does
    // not fit or is not UTF-8.
    #[effects(panic, diverge)]
    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {
        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };
        if root.len() + slash + name.len() > self.path.len()
            || crate::str::from_utf8(name).is_err()
            {
            return false;
        }
        self.path[..root.len()].copy_from_slice(root);
        if slash == 1 {
            self.path[root.len()] = 47;
        }
        self.name_at = root.len() + slash;
        self.len = self.name_at + name.len();
        self.path[self.name_at..self.len].copy_from_slice(name);
        true
    }

    #[effects(panic, diverge)]
    fn text(&self, from: usize) -> &str {
        let b = match self.path.get(from..self.len) {
            Option::Some(b) => b,
            Option::None => return "",
        };
        match crate::str::from_utf8(b) {
            crate::result::Result::Ok(s) => s,
            crate::result::Result::Err(_) => "",
        }
    }

    // The directory's path joined with the entry's name.
    // mvs: DirEntry::path_in
    // std2: changed: a &str, a view of the entry, until std::path (Rust's:
    // a PathBuf; MVS: a PathBuf on an allocator)
    #[effects(panic, diverge)]
    pub fn path(&self) -> &str {
        self.text(0)
    }

    // Its name.
    // std2: changed: a &str, a view of the entry, until std::ffi (Rust's:
    // an OsString; a name that is not UTF-8 is read_dir's InvalidData)
    #[effects(panic, diverge)]
    pub fn file_name(&self) -> &str {
        self.text(self.name_at)
    }

    // What lstat says of it.
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn metadata(&self) -> Result<Metadata> {
        stat_at(self.path(), false)
    }

    // Its kind as the directory says it (lstat's when the file system does
    // not say).
    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]
    pub fn file_type(&self) -> Result<FileType> {
        if self.kind == DT_DIR {
            crate::result::Result::Ok(FileType { fmt: S_IFDIR })
        } else if self.kind == DT_REG {
            crate::result::Result::Ok(FileType { fmt: S_IFREG })
        } else if self.kind == DT_LNK {
            crate::result::Result::Ok(FileType { fmt: S_IFLNK })
        } else {
            crate::result::Result::Ok(self.metadata()?.file_type())
        }
    }
}
