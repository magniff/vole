// EDITION: rust
// std::sync::atomic: values that threads read and write at once without a
// data race, and the memory orderings (Rust's; C++20's model). AtomicI64
// and the others are Atomic<T> for their T, an integer, bool or a raw
// pointer: one access of 1 to 8 bytes (the compiler implements the sealed
// AtomicValue, AtomicBitwise and AtomicInteger for exactly those types,
// front/traits.vl: atomic_bound). Integers wrap.
//
//     static HITS: AtomicUsize = AtomicUsize::new(0);
//     HITS.fetch_add(1, Ordering::Relaxed);
// mvs: std::sync::atomic

use crate::cell::UnsafeCell;
use crate::default::Default;
use crate::fmt::{Debug, Formatter};
use crate::result::Result;

// The ordering of an atomic operation (Rust's, without Consume).
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub enum Ordering {
    Relaxed,
    Release,
    Acquire,
    AcqRel,
    SeqCst,
}

// The intrinsics the compiler lowers by name to its atomic instructions
// (middle/lower/atomic.vl, as MVS's std::sync::atomic): `order` is 0
// Relaxed, 1 Acquire, 2 Release, 3 AcqRel, 4 SeqCst, a literal after
// inlining (else SeqCst); their bodies never run.
// UNSAFE: p is read or written atomically through a raw pointer.
// SAFETY: a contract on the caller: p valid and aligned for T, T one the
// AtomicValue bound admits, and *p reached only through atomics.
unsafe fn atomic_load<T>(p: *const T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_swap<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// The old value; *p becomes `new` when it was `expected`.
// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_add<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_and<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_nand<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_or<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_xor<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// (signed or unsigned as T is)
// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_max<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// UNSAFE: as atomic_load. SAFETY: as atomic_load.
unsafe fn atomic_min<T>(p: *mut T, v: T, order: i64) -> T {
    crate::panic::unreachable()
}

// (no pointer, no memory touched)
fn atomic_fence(order: i64) {
    crate::panic::unreachable()
}

fn atomic_compiler_fence(order: i64) {
    crate::panic::unreachable()
}

// The one ordering of a compare-exchange, at least as strong as both.
fn cas_order(success: Ordering, failure: Ordering) -> i64 {
    if failure == Ordering::Release || failure == Ordering::AcqRel {
        crate::panic::panic("there is no such thing as a release failure ordering");
    }
    let s: i64 = match success {
        Ordering::Relaxed => 0,
        Ordering::Acquire => 1,
        Ordering::Release => 2,
        Ordering::AcqRel => 3,
        Ordering::SeqCst => 4,
    };
    if s == 4 || failure == Ordering::SeqCst {
        return 4;
    }
    if failure == Ordering::Acquire && (s == 0 || s == 2) {
        return if s == 0 { 1 } else { 3 };
    }
    s
}

// What an Atomic holds: the integers, bool and the raw pointers (the
// compiler's, sealed: Sealed is private).
pub trait AtomicValue: Copy + PartialEq {
    fn sealed_value(self) -> Sealed;
}

// The integers and bool: fetch_and, fetch_or, fetch_xor, fetch_nand.
pub trait AtomicBitwise {
    fn sealed_bitwise(self) -> Sealed;
}

// The integers: fetch_add, fetch_sub, fetch_max, fetch_min.
pub trait AtomicInteger {
    fn sealed_integer(self) -> Sealed;
}

pub struct Sealed {}

// A T that threads share: read and written only through its methods.
// std2: new: Rust's AtomicI64, AtomicBool, .. are its aliases
pub struct Atomic<T: AtomicValue> {
    v: UnsafeCell<T>,
}

pub type AtomicI8 = Atomic<i8>;
pub type AtomicI16 = Atomic<i16>;
pub type AtomicI32 = Atomic<i32>;
pub type AtomicI64 = Atomic<i64>;
pub type AtomicIsize = Atomic<isize>;
pub type AtomicU8 = Atomic<u8>;
pub type AtomicU16 = Atomic<u16>;
pub type AtomicU32 = Atomic<u32>;
pub type AtomicU64 = Atomic<u64>;
pub type AtomicUsize = Atomic<usize>;
pub type AtomicBool = Atomic<bool>;
pub type AtomicPtr<T> = Atomic<*mut T>;

// UNSAFE: an Atomic holds an UnsafeCell, which is not Sync: stated, as
// Rust's atomics state it.
// SAFETY: every access of v is atomic (its methods), so sharing an Atomic
// between threads races on nothing; T is Copy, with no drop.
unsafe impl<T: AtomicValue> Sync for Atomic<T> {}
// UNSAFE: stated with Sync, as Rust's.
// SAFETY: T is an integer, bool or a raw pointer, moved as its bits.
unsafe impl<T: AtomicValue> Send for Atomic<T> {}

// Each `unsafe` below: an intrinsic on self.v.get(), valid and aligned for
// T, which is reached only through them (an Atomic is not Copy).
impl<T: AtomicValue> Atomic<T> {
    #[effects(T)]
    pub fn new(v: T) -> Atomic<T> {
        Atomic { v: UnsafeCell::new(v) }
    }

    // The value, when nothing else can reach the atomic.
    #[effects(unsafe, T)]
    pub fn into_inner(self) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe { atomic_load(self.v.get() as *const T, 0) }
    }

    // The value, through the unique borrow (no atomic needed).
    #[effects(T)]
    pub fn get_mut(&mut self) -> &mut T {
        self.v.get_mut()
    }

    // The value's address (an access through it must not race with the
    // atomic ones).
    #[effects()]
    pub fn as_ptr(&self) -> *mut T {
        self.v.get()
    }

    // Panics on Release and AcqRel, as Rust's.
    #[effects(io, panic, diverge, unsafe, T)]
    pub fn load(&self, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_load(self.v.get() as *const T, 0),
                Ordering::Acquire => atomic_load(self.v.get() as *const T, 1),
                Ordering::SeqCst => atomic_load(self.v.get() as *const T, 4),
                Ordering::Release => crate::panic::panic(
                    "there is no such thing as a release load"),
                Ordering::AcqRel => crate::panic::panic(
                    "there is no such thing as an acquire-release load"),
            }
        }
    }

    // Panics on Acquire and AcqRel, as Rust's.
    #[effects(io, panic, diverge, unsafe, T)]
    pub fn store(&self, v: T, order: Ordering) {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_store(self.v.get(), v, 0),
                Ordering::Release => atomic_store(self.v.get(), v, 2),
                Ordering::SeqCst => atomic_store(self.v.get(), v, 4),
                Ordering::Acquire => crate::panic::panic(
                    "there is no such thing as an acquire store"),
                Ordering::AcqRel => crate::panic::panic(
                    "there is no such thing as an acquire-release store"),
            }
        }
    }

    // Stores v; the old value.
    #[effects(unsafe, T)]
    pub fn swap(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_swap(self.v.get(), v, 0),
                Ordering::Acquire => atomic_swap(self.v.get(), v, 1),
                Ordering::Release => atomic_swap(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_swap(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_swap(self.v.get(), v, 4),
            }
        }
    }

    // Ok(the old value) when it was `current` (and is now `new`), else
    // Err(the value found).
    #[effects(io, panic, diverge, unsafe, T)]
    pub fn compare_exchange(&self, current: T, new: T, success: Ordering, failure: Ordering)
        -> Result<T, T> {
        let order = cas_order(success, failure);
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        let old = unsafe {
            if order == 0 {
                atomic_cas(self.v.get(), current, new, 0)
            } else if order == 1 {
                atomic_cas(self.v.get(), current, new, 1)
            } else if order == 2 {
                atomic_cas(self.v.get(), current, new, 2)
            } else if order == 3 {
                atomic_cas(self.v.get(), current, new, 3)
            } else {
                atomic_cas(self.v.get(), current, new, 4)
            }
        };
        if old == current { Result::Ok(old) } else { Result::Err(old) }
    }

    // compare_exchange (it never fails spuriously here).
    #[effects(T)]
    pub fn compare_exchange_weak(&self, current: T, new: T, success: Ordering, failure: Ordering)
        -> Result<T, T> {
        self.compare_exchange(current, new, success, failure)
    }
}

// The arithmetic: the integers only (it wraps).
impl<T: AtomicValue + AtomicInteger> Atomic<T> {
    // Adds v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_add(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_add(self.v.get(), v, 0),
                Ordering::Acquire => atomic_add(self.v.get(), v, 1),
                Ordering::Release => atomic_add(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_add(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_add(self.v.get(), v, 4),
            }
        }
    }

    // Subtracts v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_sub(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_sub(self.v.get(), v, 0),
                Ordering::Acquire => atomic_sub(self.v.get(), v, 1),
                Ordering::Release => atomic_sub(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_sub(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_sub(self.v.get(), v, 4),
            }
        }
    }

    // The larger of the value and v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_max(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_max(self.v.get(), v, 0),
                Ordering::Acquire => atomic_max(self.v.get(), v, 1),
                Ordering::Release => atomic_max(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_max(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_max(self.v.get(), v, 4),
            }
        }
    }

    // The smaller of the value and v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_min(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_min(self.v.get(), v, 0),
                Ordering::Acquire => atomic_min(self.v.get(), v, 1),
                Ordering::Release => atomic_min(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_min(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_min(self.v.get(), v, 4),
            }
        }
    }
}

// The bitwise operations: the integers and bool.
impl<T: AtomicValue + AtomicBitwise> Atomic<T> {
    // The value & v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_and(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_and(self.v.get(), v, 0),
                Ordering::Acquire => atomic_and(self.v.get(), v, 1),
                Ordering::Release => atomic_and(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_and(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_and(self.v.get(), v, 4),
            }
        }
    }

    // !(the value & v); the old value.
    #[effects(unsafe, T)]
    pub fn fetch_nand(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_nand(self.v.get(), v, 0),
                Ordering::Acquire => atomic_nand(self.v.get(), v, 1),
                Ordering::Release => atomic_nand(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_nand(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_nand(self.v.get(), v, 4),
            }
        }
    }

    // The value | v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_or(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_or(self.v.get(), v, 0),
                Ordering::Acquire => atomic_or(self.v.get(), v, 1),
                Ordering::Release => atomic_or(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_or(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_or(self.v.get(), v, 4),
            }
        }
    }

    // The value ^ v; the old value.
    #[effects(unsafe, T)]
    pub fn fetch_xor(&self, v: T, order: Ordering) -> T {
        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.
        unsafe {
            match order {
                Ordering::Relaxed => atomic_xor(self.v.get(), v, 0),
                Ordering::Acquire => atomic_xor(self.v.get(), v, 1),
                Ordering::Release => atomic_xor(self.v.get(), v, 2),
                Ordering::AcqRel => atomic_xor(self.v.get(), v, 3),
                Ordering::SeqCst => atomic_xor(self.v.get(), v, 4),
            }
        }
    }
}

impl<T: AtomicValue + Default> Default for Atomic<T> {
    fn default() -> Atomic<T> {
        Atomic::new(T::default())
    }
}

// The value, read Relaxed (as Rust's).
impl<T: AtomicValue + Debug> Debug for Atomic<T> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        Debug::fmt(&self.load(Ordering::Relaxed), f)
    }
}

// A memory fence: Acquire, Release, AcqRel or SeqCst; panics on Relaxed,
// as Rust's.
#[effects(io, sync, panic, diverge)]
pub fn fence(order: Ordering) {
    match order {
        Ordering::Acquire => atomic_fence(1),
        Ordering::Release => atomic_fence(2),
        Ordering::AcqRel => atomic_fence(3),
        Ordering::SeqCst => atomic_fence(4),
        Ordering::Relaxed => crate::panic::panic("there is no such thing as a relaxed fence"),
    }
}

// A fence for the compiler only (no instruction): memory accesses are not
// moved across it. Panics on Relaxed, as Rust's.
#[effects(io, sync, panic, diverge)]
pub fn compiler_fence(order: Ordering) {
    match order {
        Ordering::Acquire => atomic_compiler_fence(1),
        Ordering::Release => atomic_compiler_fence(2),
        Ordering::AcqRel => atomic_compiler_fence(3),
        Ordering::SeqCst => atomic_compiler_fence(4),
        Ordering::Relaxed => crate::panic::panic(
            "there is no such thing as a relaxed compiler fence"),
    }
}
