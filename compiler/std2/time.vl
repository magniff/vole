// EDITION: rust
// std::time: Duration, Instant and SystemTime, Rust's shape (0.27.5). A
// Duration is whole seconds and the nanoseconds under one second; its
// arithmetic is checked (`checked_*` give None, `saturating_*` stop at
// zero and the largest Duration, the operators panic, as Rust's do).
// Instant reads the monotonic clock, SystemTime the wall clock, both
// through C's clock_gettime (the clock's id is the target's: std::__sys).
// mvs: std::time

use crate::fmt::{Debug, Display, Formatter};
use crate::ops::{Add, AddAssign, Div, DivAssign, Mul, MulAssign, Sub, SubAssign};
use crate::option::Option;
use crate::result::Result;

const NANOS_PER_SEC: u32 = 1000000000;
const NANOS_PER_MILLI: u32 = 1000000;
const NANOS_PER_MICRO: u32 = 1000;

// A span of time, Rust's std::time::Duration.
// std2: changed: no ZERO, MAX, SECOND.. constants (a constant of a struct
// type waits for const evaluation): `Duration::from_secs(0)`, `new(..)`
// mvs: Duration
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Duration {
    secs: u64,
    nanos: u32,
}

impl Duration {
    // secs seconds and nanos nanoseconds; nanos past a second carry into
    // the seconds (panics when the seconds overflow).
    #[effects(panic, diverge)]
    pub fn new(secs: u64, nanos: u32) -> Duration {
        if nanos < NANOS_PER_SEC {
            return Duration { secs: secs, nanos: nanos };
        }
        let extra = (nanos / NANOS_PER_SEC) as u64;
        match secs.checked_add(extra) {
            Option::Some(s) => Duration { secs: s, nanos: nanos % NANOS_PER_SEC },
            Option::None => crate::panic::panic("overflow in Duration::new"),
        }
    }

    #[effects()]
    pub fn from_secs(secs: u64) -> Duration {
        Duration { secs: secs, nanos: 0 }
    }

    #[effects()]
    pub fn from_millis(millis: u64) -> Duration {
        Duration { secs: millis / 1000, nanos: ((millis % 1000) as u32) * NANOS_PER_MILLI }
    }

    #[effects()]
    pub fn from_micros(micros: u64) -> Duration {
        Duration { secs: micros / 1000000, nanos: ((micros % 1000000) as u32) * NANOS_PER_MICRO }
    }

    #[effects()]
    pub fn from_nanos(nanos: u64) -> Duration {
        Duration { secs: nanos / 1000000000, nanos: (nanos % 1000000000) as u32 }
    }

    // secs seconds, a float: panics when it is negative, not finite or too
    // large, as Rust's does; rounded to the nearest nanosecond.
    #[effects(panic, diverge)]
    pub fn from_secs_f64(secs: f64) -> Duration {
        match Duration::try_from_secs_f64(secs) {
            Result::Ok(d) => d,
            Result::Err(_) => crate::panic::panic(
                "cannot convert float seconds to Duration: value is negative, not finite or overflowing"),
        }
    }

    #[effects(panic, diverge)]
    pub fn from_secs_f32(secs: f32) -> Duration {
        Duration::from_secs_f64(secs as f64)
    }

    // from_secs_f64's value, or the error where it panics.
    #[effects()]
    pub fn try_from_secs_f64(secs: f64) -> Result<Duration, TryFromFloatSecsError> {
        if !(secs >= 0.0) || secs >= 18446744073709551616.0 {
            return Result::Err(TryFromFloatSecsError { negative: secs < 0.0 });
        }
        let whole = secs as u64;
        let frac = secs - whole as f64;
        let mut nanos = (frac * 1000000000.0 + 0.5) as u64;
        let mut s = whole;
        if nanos >= 1000000000 {
            nanos -= 1000000000;
            match s.checked_add(1) {
                Option::Some(t) => s = t,
                Option::None => return Result::Err(TryFromFloatSecsError { negative: false }),
            }
        }
        Result::Ok(Duration { secs: s, nanos: nanos as u32 })
    }

    #[effects()]
    pub fn try_from_secs_f32(secs: f32) -> Result<Duration, TryFromFloatSecsError> {
        Duration::try_from_secs_f64(secs as f64)
    }

    #[effects()]
    pub fn is_zero(&self) -> bool {
        self.secs == 0 && self.nanos == 0
    }

    #[effects()]
    pub fn as_secs(&self) -> u64 {
        self.secs
    }

    #[effects()]
    pub fn subsec_millis(&self) -> u32 {
        self.nanos / NANOS_PER_MILLI
    }

    #[effects()]
    pub fn subsec_micros(&self) -> u32 {
        self.nanos / NANOS_PER_MICRO
    }

    #[effects()]
    pub fn subsec_nanos(&self) -> u32 {
        self.nanos
    }

    // std2: changed: u64, saturating (Rust's is u128)
    #[effects()]
    pub fn as_millis(&self) -> u64 {
        self.secs.saturating_mul(1000).saturating_add((self.nanos / NANOS_PER_MILLI) as u64)
    }

    // std2: changed: u64, saturating (Rust's is u128)
    #[effects()]
    pub fn as_micros(&self) -> u64 {
        self.secs.saturating_mul(1000000).saturating_add((self.nanos / NANOS_PER_MICRO) as u64)
    }

    // std2: changed: u64, saturating (Rust's is u128)
    #[effects()]
    pub fn as_nanos(&self) -> u64 {
        self.secs.saturating_mul(1000000000).saturating_add(self.nanos as u64)
    }

    #[effects()]
    pub fn as_secs_f64(&self) -> f64 {
        self.secs as f64 + self.nanos as f64 / 1000000000.0
    }

    #[effects()]
    pub fn as_secs_f32(&self) -> f32 {
        self.as_secs_f64() as f32
    }

    #[effects()]
    pub fn as_millis_f64(&self) -> f64 {
        self.secs as f64 * 1000.0 + self.nanos as f64 / 1000000.0
    }

    #[effects()]
    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {
        let mut secs = match self.secs.checked_add(rhs.secs) {
            Option::Some(s) => s,
            Option::None => return Option::None,
        };
        let mut nanos = self.nanos + rhs.nanos;
        if nanos >= NANOS_PER_SEC {
            nanos -= NANOS_PER_SEC;
            secs = match secs.checked_add(1) {
                Option::Some(s) => s,
                Option::None => return Option::None,
            };
        }
        Option::Some(Duration { secs: secs, nanos: nanos })
    }

    #[effects()]
    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {
        let mut secs = match self.secs.checked_sub(rhs.secs) {
            Option::Some(s) => s,
            Option::None => return Option::None,
        };
        let nanos = if self.nanos >= rhs.nanos {
            self.nanos - rhs.nanos
        } else {
            secs = match secs.checked_sub(1) {
                Option::Some(s) => s,
                Option::None => return Option::None,
            };
            self.nanos + NANOS_PER_SEC - rhs.nanos
        };
        Option::Some(Duration { secs: secs, nanos: nanos })
    }

    #[effects()]
    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {
        let total = self.nanos as u64 * rhs as u64;
        let extra = total / NANOS_PER_SEC as u64;
        let nanos = (total % NANOS_PER_SEC as u64) as u32;
        match self.secs.checked_mul(rhs as u64) {
            Option::Some(s) => match s.checked_add(extra) {
                Option::Some(secs) => Option::Some(Duration { secs: secs, nanos: nanos }),
                Option::None => Option::None,
            },
            Option::None => Option::None,
        }
    }

    #[effects()]
    pub fn checked_div(self, rhs: u32) -> Option<Duration> {
        if rhs == 0 {
            return Option::None;
        }
        let secs = self.secs / rhs as u64;
        let carry = self.secs - secs * rhs as u64;
        let extra = carry * NANOS_PER_SEC as u64 / rhs as u64;
        let nanos = self.nanos / rhs + extra as u32;
        Option::Some(Duration::new(secs, nanos))
    }

    #[effects()]
    pub fn saturating_add(self, rhs: Duration) -> Duration {
        match self.checked_add(rhs) {
            Option::Some(d) => d,
            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },
        }
    }

    #[effects()]
    pub fn saturating_sub(self, rhs: Duration) -> Duration {
        match self.checked_sub(rhs) {
            Option::Some(d) => d,
            Option::None => Duration { secs: 0, nanos: 0 },
        }
    }

    #[effects()]
    pub fn saturating_mul(self, rhs: u32) -> Duration {
        match self.checked_mul(rhs) {
            Option::Some(d) => d,
            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },
        }
    }

    #[effects()]
    pub fn abs_diff(self, other: Duration) -> Duration {
        if self >= other {
            self.saturating_sub(other)
        } else {
            other.saturating_sub(self)
        }
    }

    #[effects(panic, diverge)]
    pub fn mul_f64(self, rhs: f64) -> Duration {
        Duration::from_secs_f64(rhs * self.as_secs_f64())
    }

    #[effects(panic, diverge)]
    pub fn div_f64(self, rhs: f64) -> Duration {
        Duration::from_secs_f64(self.as_secs_f64() / rhs)
    }

    #[effects()]
    pub fn div_duration_f64(self, rhs: Duration) -> f64 {
        self.as_secs_f64() / rhs.as_secs_f64()
    }
}

impl Add for Duration {
    type Output = Duration;
    #[effects(panic, diverge)]
    fn add(self, rhs: Duration) -> Duration {
        match self.checked_add(rhs) {
            Option::Some(d) => d,
            Option::None => crate::panic::panic("overflow when adding durations"),
        }
    }
}

impl AddAssign for Duration {
    #[effects(panic, diverge)]
    fn add_assign(&mut self, rhs: Duration) {
        *self = *self + rhs;
    }
}

impl Sub for Duration {
    type Output = Duration;
    #[effects(panic, diverge)]
    fn sub(self, rhs: Duration) -> Duration {
        match self.checked_sub(rhs) {
            Option::Some(d) => d,
            Option::None => crate::panic::panic("overflow when subtracting durations"),
        }
    }
}

impl SubAssign for Duration {
    #[effects(panic, diverge)]
    fn sub_assign(&mut self, rhs: Duration) {
        *self = *self - rhs;
    }
}

// mvs: Duration::mul_u32
impl Mul<u32> for Duration {
    type Output = Duration;
    #[effects(panic, diverge)]
    fn mul(self, rhs: u32) -> Duration {
        match self.checked_mul(rhs) {
            Option::Some(d) => d,
            Option::None => crate::panic::panic("overflow when multiplying duration by scalar"),
        }
    }
}

impl MulAssign<u32> for Duration {
    #[effects(panic, diverge)]
    fn mul_assign(&mut self, rhs: u32) {
        *self = *self * rhs;
    }
}

// mvs: Duration::div_u32
impl Div<u32> for Duration {
    type Output = Duration;
    #[effects(panic, diverge)]
    fn div(self, rhs: u32) -> Duration {
        match self.checked_div(rhs) {
            Option::Some(d) => d,
            Option::None => crate::panic::panic(
                "divide by zero error when dividing duration by scalar"),
        }
    }
}

impl DivAssign<u32> for Duration {
    #[effects(panic, diverge)]
    fn div_assign(&mut self, rhs: u32) {
        *self = *self / rhs;
    }
}

// Rust's form: `1.5s`, `100ms`, `2.000001ms`, `7µs`, `9ns`, the
// fraction's trailing zeros dropped (or `{:.N?}` digits, rounded half
// up), padded to the width.
impl Debug for Duration {
    #[effects(unsafe)]
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        if self.secs > 0 {
            fmt_decimal(f, self.secs, self.nanos, NANOS_PER_SEC / 10, "s")
        } else if self.nanos >= NANOS_PER_MILLI {
            fmt_decimal(f, (self.nanos / NANOS_PER_MILLI) as u64, self.nanos % NANOS_PER_MILLI,
                NANOS_PER_MILLI / 10, "ms")
        } else if self.nanos >= NANOS_PER_MICRO {
            fmt_decimal(f, (self.nanos / NANOS_PER_MICRO) as u64, self.nanos % NANOS_PER_MICRO,
                NANOS_PER_MICRO / 10, "µs")
        } else {
            fmt_decimal(f, self.nanos as u64, 0, 1, "ns")
        }
    }
}

// integer.fraction then suffix: fraction's digits from divisor down, at
// most the precision's (9 without one, its trailing zeros dropped).
#[effects(unsafe)]
fn fmt_decimal(f: &mut Formatter<'_>, integer: u64, fraction: u32, divisor: u32, suffix: &str)
    -> crate::fmt::Result {
    let mut digits = [b'0'; 9];
    let wanted = match f.precision() {
        Option::Some(p) => if p < 9 { p } else { 9 },
        Option::None => 9,
    };
    let mut frac = fraction;
    let mut div = divisor;
    let mut pos: usize = 0;
    while frac > 0 && pos < wanted && div > 0 {
        digits[pos] = b'0' + (frac / div) as u8;
        frac = frac % div;
        div = div / 10;
        pos += 1;
    }
    let mut int_part = integer;
    // (rounding half up what is left)
    if frac > 0 && div > 0 && frac >= div * 5 {
        let mut carry = true;
        let mut k = pos;
        while carry && k > 0 {
            k -= 1;
            if digits[k] == b'9' {
                digits[k] = b'0';
            } else {
                digits[k] += 1;
                carry = false;
            }
        }
        if carry {
            int_part = int_part.saturating_add(1);
        }
    }
    let shown = match f.precision() {
        Option::Some(p) => if p < 9 { p } else { 9 },
        Option::None => pos,
    };
    let mut out = [0u8; 48];
    let mut n: usize = 0;
    let mut int_digits = [0u8; 20];
    let mut m: usize = 0;
    let mut v = int_part;
    if v == 0 {
        int_digits[0] = b'0';
        m = 1;
    }
    while v > 0 {
        int_digits[m] = b'0' + (v % 10) as u8;
        v = v / 10;
        m += 1;
    }
    while m > 0 {
        m -= 1;
        out[n] = int_digits[m];
        n += 1;
    }
    if shown > 0 {
        out[n] = b'.';
        n += 1;
        for k in 0..shown {
            out[n] = digits[k];
            n += 1;
        }
    }
    for b in suffix.as_bytes() {
        out[n] = *b;
        n += 1;
    }
    // UNSAFE: the bytes written above are ASCII digits, '.', and suffix's
    // UTF-8 bytes copied whole.
    // SAFETY: each is a whole UTF-8 sequence, so out[..n] is UTF-8.
    let text = unsafe { crate::str::from_utf8_unchecked(&out[..n]) };
    // (the width pads it, left-aligned by default, as Rust's; the
    // precision was the fraction's, so not Formatter::pad, which would cut
    // the text to it)
    let chars = text.chars().count();
    let w = match f.width() {
        Option::Some(w) => w,
        Option::None => 0,
    };
    if w <= chars {
        return f.write_str(text);
    }
    let gap = w - chars;
    let (before, after): (usize, usize) = match f.align() {
        Option::Some(crate::fmt::Alignment::Right) => (gap, 0),
        Option::Some(crate::fmt::Alignment::Center) => (gap / 2, gap - gap / 2),
        _ => (0, gap),
    };
    let fill = f.fill();
    for _ in 0..before {
        f.write_char(fill)?;
    }
    f.write_str(text)?;
    for _ in 0..after {
        f.write_char(fill)?;
    }
    crate::fmt::Result::Ok(())
}

// Duration::try_from_secs_f64's error: the float was negative, not finite
// or too large.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct TryFromFloatSecsError {
    negative: bool,
}

impl Display for TryFromFloatSecsError {
    #[effects()]
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        if self.negative {
            f.write_str("cannot convert float seconds to Duration: value is negative")
        } else {
            f.write_str("cannot convert float seconds to Duration: value is either too big or NaN")
        }
    }
}

// UNSAFE: C. SAFETY: time.h's prototype (struct timespec, two 64-bit
// fields on the 64-bit targets, is an [i64; 2]).
extern "C" {
    #[link_name = "clock_gettime"]
    fn c_clock_gettime(clock: i32, tp: *mut i64) -> i32;
}

// Clock clock's now, a Duration since its start.
#[effects(io, static, unsafe)]
fn clock_now(clock: i32) -> Duration {
    let mut ts = [0i64; 2];
    // UNSAFE: C's clock_gettime.
    // SAFETY: ts is a writable timespec (two i64s); clock is a valid id
    // (the target's, std::__sys), so the call cannot fail.
    unsafe {
        c_clock_gettime(clock, &mut ts[0] as *mut i64);
    }
    Duration { secs: ts[0] as u64, nanos: ts[1] as u32 }
}

// A reading of the monotonic clock, Rust's std::time::Instant: only its
// differences mean anything.
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct Instant {
    t: Duration,
}

impl Instant {
    // mvs: monotonic_now
    #[effects(io, static, unsafe)]
    pub fn now() -> Instant {
        Instant { t: clock_now(crate::__sys::CLOCK_MONOTONIC) }
    }

    // The time since earlier (zero when earlier is later, as Rust's).
    #[effects()]
    pub fn duration_since(&self, earlier: Instant) -> Duration {
        self.t.saturating_sub(earlier.t)
    }

    #[effects()]
    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {
        self.t.checked_sub(earlier.t)
    }

    #[effects()]
    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {
        self.t.saturating_sub(earlier.t)
    }

    #[effects(io, static, unsafe)]
    pub fn elapsed(&self) -> Duration {
        Instant::now().duration_since(*self)
    }

    #[effects()]
    pub fn checked_add(&self, d: Duration) -> Option<Instant> {
        match self.t.checked_add(d) {
            Option::Some(t) => Option::Some(Instant { t: t }),
            Option::None => Option::None,
        }
    }

    #[effects()]
    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {
        match self.t.checked_sub(d) {
            Option::Some(t) => Option::Some(Instant { t: t }),
            Option::None => Option::None,
        }
    }
}

impl Add<Duration> for Instant {
    type Output = Instant;
    #[effects(panic, diverge)]
    fn add(self, d: Duration) -> Instant {
        Instant { t: self.t + d }
    }
}

impl AddAssign<Duration> for Instant {
    #[effects(panic, diverge)]
    fn add_assign(&mut self, d: Duration) {
        self.t = self.t + d;
    }
}

impl Sub<Duration> for Instant {
    type Output = Instant;
    #[effects(panic, diverge)]
    fn sub(self, d: Duration) -> Instant {
        Instant { t: self.t - d }
    }
}

impl SubAssign<Duration> for Instant {
    #[effects(panic, diverge)]
    fn sub_assign(&mut self, d: Duration) {
        self.t = self.t - d;
    }
}

impl Sub<Instant> for Instant {
    type Output = Duration;
    #[effects()]
    fn sub(self, earlier: Instant) -> Duration {
        self.duration_since(earlier)
    }
}

impl Debug for Instant {
    #[effects()]
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.debug_struct("Instant").field("tv_sec", &self.t.secs).field("tv_nsec", &self.t.nanos)
            .finish()
    }
}

// A reading of the wall clock, Rust's std::time::SystemTime: the time
// since UNIX_EPOCH (not before it here).
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct SystemTime {
    t: Duration,
}

// 1970-01-01 00:00:00 UTC.
// std2: changed: a static (Rust's is a constant: a constant of a struct
// type waits for const evaluation)
pub static UNIX_EPOCH: SystemTime = SystemTime { t: Duration { secs: 0, nanos: 0 } };

impl SystemTime {
    // mvs: clock_now
    #[effects(io, static, unsafe)]
    pub fn now() -> SystemTime {
        SystemTime { t: clock_now(0) }
    }

    // The time since earlier, or how much later earlier is.
    #[effects()]
    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {
        match self.t.checked_sub(earlier.t) {
            Option::Some(d) => Result::Ok(d),
            Option::None => Result::Err(SystemTimeError(earlier.t - self.t)),
        }
    }

    #[effects(io, static, unsafe)]
    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {
        SystemTime::now().duration_since(*self)
    }

    #[effects()]
    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {
        match self.t.checked_add(d) {
            Option::Some(t) => Option::Some(SystemTime { t: t }),
            Option::None => Option::None,
        }
    }

    #[effects()]
    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {
        match self.t.checked_sub(d) {
            Option::Some(t) => Option::Some(SystemTime { t: t }),
            Option::None => Option::None,
        }
    }
}

impl Add<Duration> for SystemTime {
    type Output = SystemTime;
    #[effects(panic, diverge)]
    fn add(self, d: Duration) -> SystemTime {
        SystemTime { t: self.t + d }
    }
}

impl AddAssign<Duration> for SystemTime {
    #[effects(panic, diverge)]
    fn add_assign(&mut self, d: Duration) {
        self.t = self.t + d;
    }
}

impl Sub<Duration> for SystemTime {
    type Output = SystemTime;
    #[effects(panic, diverge)]
    fn sub(self, d: Duration) -> SystemTime {
        SystemTime { t: self.t - d }
    }
}

impl SubAssign<Duration> for SystemTime {
    #[effects(panic, diverge)]
    fn sub_assign(&mut self, d: Duration) {
        self.t = self.t - d;
    }
}

impl Debug for SystemTime {
    #[effects()]
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.debug_struct("SystemTime").field("tv_sec", &self.t.secs).field("tv_nsec", &self.t.nanos)
            .finish()
    }
}

// SystemTime::duration_since's error: how much later the other time is.
#[derive(Clone, Copy, Debug)]
pub struct SystemTimeError(Duration);

impl SystemTimeError {
    #[effects()]
    pub fn duration(&self) -> Duration {
        self.0
    }
}

impl Display for SystemTimeError {
    #[effects()]
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("second time provided was later than self")
    }
}
