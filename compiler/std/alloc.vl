// std::alloc: Allocator, Layout, Gpa, and the arenas (plan §2, §2.1,
// §9.1). Allocation is a capability: a function allocates only through an
// allocator reachable from its parameters, a type that holds one has it
// among its parameters (`Vec<T, A>`, `Parser<'s, A>`), and nothing makes
// one from nothing: Gpa has no public constructor (main receives it),
// every arena is made from a parent allocator or over memory it is lent,
// and a static's type may not hold an allocator (the compiler's
// AllocFree marker). Allocators compose as Zig's do: an Arena over a
// FixedBuf allocates no heap at all, an arena over an arena frees per
// request, a scope gives back what it took while older containers stay.
// AnyAlloc<'a> erases an allocator's type (no dyn: a struct of function
// pointers), so a library taking `a: AnyAlloc<'_>` is compiled once.

use crate::cell::Cell;
use crate::clone::Clone;
use crate::convert::From;
use crate::fmt::{Debug, Display, Formatter};
use crate::iter::IntoIterator;
use crate::marker::{Copy, PhantomData};
use crate::ops::Drop;
use crate::ptr::NonNull;
use crate::result::Result;

// A block's size and alignment (a power of two), in bytes.
#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
pub struct Layout {
    size: usize,
    align: usize,
}

impl Layout {
    // A T's layout.
    #[effects()]
    pub fn new<T>() -> Layout {
        Layout { size: crate::mem::size_of::<T>(), align: crate::mem::align_of::<T>() }
    }

    // n T's; LayoutError when the size overflows.
    #[effects(T)]
    pub fn array<T>(n: usize) -> Result<Layout, LayoutError> {
        match crate::mem::size_of::<T>().checked_mul(n) {
            crate::option::Option::Some(size) => Layout::from_size_align(size,
                crate::mem::align_of::<T>()),
            crate::option::Option::None => Result::Err(LayoutError {}),
        }
    }

    // LayoutError when align is not a power of two or size overflows
    // when rounded up to it.
    #[effects()]
    pub fn from_size_align(size: usize, align: usize) -> Result<Layout, LayoutError> {
        if align == 0 || align & (align - 1) != 0 {
            return Result::Err(LayoutError {});
        }
        // Rust's bound: rounded up to align, the size fits in an isize.
        if size > (isize::MAX as usize) - (align - 1) {
            return Result::Err(LayoutError {});
        }
        Result::Ok(Layout { size: size, align: align })
    }

    #[effects()]
    pub fn size(&self) -> usize {
        self.size
    }

    #[effects()]
    pub fn align(&self) -> usize {
        self.align
    }
}

// A layout that cannot be.
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct LayoutError;

// An allocator out of memory (or over its limit).
// mvs: AllocError, AllocError::impl Debug
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct AllocError;

// mvs: AllocError::impl Display
impl Display for AllocError {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("memory allocation failed")
    }
}

// Why try_reserve failed: the capacity overflowed, or the allocator.
// (Rust has it at std::collections: re-exported there)
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum TryReserveError {
    CapacityOverflow,
    AllocError { layout: Layout },
}

// What gives out blocks of memory: Rust's allocator_api shape, `&self`
// (so `&'a Arena<P>` is one, through the impl for &A), with a thin
// pointer (`NonNull<u8>`, not `NonNull<[u8]>`: no fat raw pointers) and
// FREES. An `unsafe trait`: every impl is `unsafe impl` with a SAFETY
// comment naming where its memory comes from (plan §2.0 rule 1).
// std2: changed: Rust's shape over &self and a Layout (MVS: try_alloc,
// try_resize, free over *Self and i64 sizes)
// UNSAFE: an impl promises its blocks are valid, aligned and its own,
// which no type checks.
// SAFETY: each impl states where its memory comes from (rule 1).
pub unsafe trait Allocator {
    // Whether deallocate gives memory back. False for the arenas and
    // FixedBuf, whose memory comes back all at once; a container on such
    // an allocator needs dropping only if its elements do (plan §9.1:
    // `needs_drop::<Vec<T, A>>() == needs_drop::<T>()` when !A::FREES).
    const FREES: bool = true;

    // A block for layout, or AllocError.
    // mvs: Allocator::try_alloc, Allocator::alloc
    // std2: changed: a Layout, a Result (MVS: a size and align, null or a panic)
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError>;

    // The same, its bytes zero.
    fn allocate_zeroed(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let p = self.allocate(layout)?;
        let b = p.as_ptr();
        let mut i: usize = 0;
        while i < layout.size() {
            // UNSAFE: the block is zeroed through its raw pointer.
            // SAFETY: allocate gave a block of layout.size() bytes; i is in it.
            unsafe {
                *b.add(i) = 0;
            }
            i += 1;
        }
        Result::Ok(p)
    }

    // Gives a block back.
    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, as Rust's Allocator::deallocate.
    // mvs: Allocator::free
    // std2: changed: a NonNull and a Layout (MVS: free(p, size, align))
    // (0.28.0: MVS's Allocator::free's list, `global` spelled `static`)
    #[effects(alloc, static, panic, diverge, unsafe)]
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout);

    // The block made larger (moved if it must), its contents kept.
    // UNSAFE: p must be a block of this allocator's, with layout old;
    // new.size() >= old.size().
    // SAFETY: a contract on the caller, as Rust's Allocator::grow.
    // mvs: Allocator::try_resize, Allocator::resize
    // std2: changed: two Layouts, a Result
    unsafe fn grow(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let q = self.allocate(new)?;
        // UNSAFE: the old block's bytes copied into the new one, the old
        // given back.
        // SAFETY: the caller's contract: p is this allocator's block with
        // layout old, and new.size() >= old.size(), so old.size() bytes fit
        // in q, a fresh block that does not overlap p.
        unsafe {
            crate::ptr::copy_nonoverlapping(p.as_ptr() as *const u8, q.as_ptr(), old.size());
            self.deallocate(p, old);
        }
        Result::Ok(q)
    }

    // grow, the new bytes zero.
    // UNSAFE: as grow.
    // SAFETY: a contract on the caller, as grow's.
    unsafe fn grow_zeroed(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let q = self.allocate_zeroed(new)?;
        // UNSAFE: as grow, over a zeroed block.
        // SAFETY: as grow's: old.size() bytes fit in q, which is fresh; the
        // bytes after them stay zero.
        unsafe {
            crate::ptr::copy_nonoverlapping(p.as_ptr() as *const u8, q.as_ptr(), old.size());
            self.deallocate(p, old);
        }
        Result::Ok(q)
    }

    // The block made smaller.
    // UNSAFE: p must be a block of this allocator's, with layout old;
    // new.size() <= old.size().
    // SAFETY: a contract on the caller, as Rust's Allocator::shrink.
    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        let q = self.allocate(new)?;
        // UNSAFE: the first new.size() bytes copied into a smaller block, the
        // old given back.
        // SAFETY: the caller's contract: p is this allocator's block with
        // layout old and new.size() <= old.size(); q is fresh and holds
        // new.size() bytes.
        unsafe {
            crate::ptr::copy_nonoverlapping(p.as_ptr() as *const u8, q.as_ptr(), new.size());
            self.deallocate(p, old);
        }
        Result::Ok(q)
    }

    // The allocator borrowed (a container on `&A` instead of moving A in).
    fn by_ref(&self) -> &Self
        where
            Self: Sized,
    {
        self
    }

    // The allocator with its type erased: an AnyAlloc of it (plan §2.1).
    fn erase(&self) -> AnyAlloc<'_>
        where
            Self: Sized,
    {
        AnyAlloc::new(self)
    }
}

// A reference to an allocator is one: containers hold `&'a Arena<P>`.
// UNSAFE: an Allocator impl.
// SAFETY: every block comes from *self, the referenced allocator, and goes
// back to it; FREES is its FREES.
unsafe impl<A: Allocator + ?Sized> Allocator for &A {
    const FREES: bool = A::FREES;

    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        (**self).allocate(layout)
    }

    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, the trait's own for deallocate.
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {
        // UNSAFE: deallocate's own contract.
        // SAFETY: passed through: the caller's p and layout are A's.
        unsafe { (**self).deallocate(p, layout) }
    }
}

// The general-purpose heap (C's malloc): zero-sized and Copy, with no
// public constructor. The runtime makes one and `main` receives it
// (`fn main(gpa: Gpa)`), so a function can allocate from it only when
// it is handed one (plan §2.0 rule 1). With --check-alloc it is the
// checking allocator (leaks, double frees, use after free).
#[derive(Clone, Copy)]
pub struct Gpa {
    sealed: (),
}

impl Gpa {
    // Blocks given out and not freed yet (with --check-alloc; else 0).
    // std2: changed: usize
    #[effects(static, sync, diverge)]
    pub fn live_blocks(&self) -> usize {
        // (Z5: std::__gpa is the compiler's tail: rt/gpa.vl, or with
        // --check-alloc the checking allocator, rt/alloc_check.vl)
        crate::__gpa::live_blocks()
    }

    // Whether every block was freed (with --check-alloc, which lists the
    // live ones on stderr; else true).
    #[effects(static, sync, panic, diverge)]
    pub fn check_leaks(&self) -> bool {
        crate::__gpa::check_leaks()
    }
}

// UNSAFE: an Allocator impl over C's heap (or the checking allocator's
// pages).
// SAFETY: blocks come from std::__gpa (malloc, posix_memalign above 16;
// with --check-alloc, pages of their own) and go back to it; FREES true.
unsafe impl Allocator for Gpa {
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        crate::__gpa::allocate(layout)
    }

    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, the trait's own for deallocate.
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {
        // UNSAFE: deallocate's own contract.
        // SAFETY: passed through: the caller's p and layout are this Gpa's.
        unsafe { crate::__gpa::deallocate(p, layout) }
    }
}

// ---- Arenas ----

// A chunk's header: the previous chunk (0 for the first) and the chunk's
// size in bytes, two words at its start; the bump region follows.
const CHUNK_HEADER: usize = 16;
// The smallest chunk an arena takes from its parent.
const CHUNK_MIN: usize = 4096;
// Every chunk's alignment (the header's, and malloc's).
const CHUNK_ALIGN: usize = 16;

// x rounded up to align, a power of two.
fn round_up(x: usize, align: usize) -> usize {
    (x + align - 1) / align * align
}

// Out of memory where the API has no Result: Rust's handle_alloc_error.
fn out_of_memory() -> ! {
    let msg: &str = "memory allocation failed";
    crate::panic::panic(msg)
}

// The chunk list and bump pointer of an arena or a scope: chunk is the
// newest chunk (null before the first), at and end the addresses its
// free room spans. Cells: Allocator::allocate takes &self.
struct Chunks {
    chunk: Cell<*mut u8>,
    at: Cell<usize>,
    end: Cell<usize>,
    used: Cell<usize>,
    allocated: Cell<usize>,
}

impl Chunks {
    fn new() -> Chunks {
        Chunks {
            chunk: Cell::new(crate::ptr::null_mut()),
            at: Cell::new(0),
            end: Cell::new(0),
            used: Cell::new(0),
            allocated: Cell::new(0),
        }
    }

    // A new chunk from parent with room for bytes, made the newest.
    fn add<P: Allocator>(&self, parent: &P, bytes: usize) -> Result<(), AllocError> {
        let size = round_up(crate::cmp::max(CHUNK_MIN, bytes + CHUNK_HEADER), CHUNK_ALIGN);
        let p = parent.allocate(Layout { size: size, align: CHUNK_ALIGN })?.as_ptr();
        let h = p as *mut usize;
        // UNSAFE: the header is written through the chunk's raw pointer.
        // SAFETY: p is a fresh block of size >= CHUNK_HEADER bytes, aligned
        // to 16, so its first two words are in it and aligned.
        unsafe {
            *h = self.chunk.get() as usize;
            *h.add(1) = size;
        }
        self.chunk.set(p);
        self.at.set(p as usize + CHUNK_HEADER);
        self.end.set(p as usize + size);
        self.allocated.set(self.allocated.get() + size);
        Result::Ok(())
    }

    // A block for layout, bumped from the newest chunk (a new one when it
    // has no room).
    fn bump<P: Allocator>(&self, parent: &P, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let start = round_up(self.at.get(), layout.align());
        if self.chunk.get().is_null() || start + layout.size() > self.end.get() {
            self.add(parent, layout.size() + layout.align())?;
            return self.bump(parent, layout);
        }
        self.at.set(start + layout.size());
        self.used.set(self.used.get() + layout.size());
        // UNSAFE: an address made a pointer (an integer-to-pointer cast).
        // SAFETY: start..start + size is inside the newest chunk, a block of
        // the parent's that this list owns.
        match NonNull::new(unsafe { start as *mut u8 }) {
            crate::option::Option::Some(p) => Result::Ok(p),
            crate::option::Option::None => Result::Err(AllocError {}),
        }
    }

    // Every chunk but the oldest given back to parent, the oldest's room
    // made free; with keep_first false, every chunk given back.
    fn release<P: Allocator>(&self, parent: &P, keep_first: bool) {
        let mut p = self.chunk.get();
        while !p.is_null() {
            let h = p as *mut usize;
            // UNSAFE: the header is read through the chunk's raw pointer.
            // SAFETY: every chunk on the list was made by add, which wrote
            // its header; it has not been given back yet.
            let (prev, size) = unsafe { (*h as *mut u8, *h.add(1)) };
            // (a first chunk made for one large block goes back too: reset
            // keeps a standard chunk's room, not a burst's)
            if keep_first && prev.is_null() && size <= CHUNK_MIN {
                self.chunk.set(p);
                self.at.set(p as usize + CHUNK_HEADER);
                self.end.set(p as usize + size);
                self.used.set(0);
                self.allocated.set(size);
                return;
            }
            if let crate::option::Option::Some(nn) = NonNull::new(p) {
                // UNSAFE: the chunk goes back to the allocator it came from.
                // SAFETY: add allocated it from parent with this layout, and
                // nothing borrows it: the caller holds the arena or scope by
                // &mut or is dropping it.
                unsafe { parent.deallocate(nn, Layout { size: size, align: CHUNK_ALIGN }) };
            }
            p = prev;
        }
        self.chunk.set(crate::ptr::null_mut());
        self.at.set(0);
        self.end.set(0);
        self.used.set(0);
        self.allocated.set(0);
    }
}

// x moved into a fresh block of a (the arenas' alloc).
fn alloc_in<T, A: Allocator>(a: &A, x: T) -> &mut T {
    let p = match a.allocate(Layout::new::<T>()) {
        Result::Ok(p) => p.as_ptr() as *mut T,
        Result::Err(_) => out_of_memory(),
    };
    // UNSAFE: x is moved into the block through a raw pointer.
    // SAFETY: p is a fresh block of T's layout from a, valid for as long as
    // a is borrowed (an arena's blocks live until it is reset or dropped).
    unsafe {
        crate::ptr::write(p, x);
        &mut *p
    }
}

// A copy of s in a fresh block of a.
fn alloc_slice_copy_in<'a, T: Copy, A: Allocator>(a: &'a A, s: &[T]) -> &'a mut [T] {
    let n = s.len();
    let layout = match Layout::array::<T>(n) {
        Result::Ok(l) => l,
        Result::Err(_) => out_of_memory(),
    };
    let p = match a.allocate(layout) {
        Result::Ok(p) => p.as_ptr() as *mut T,
        Result::Err(_) => out_of_memory(),
    };
    // UNSAFE: s is copied into the block, which is then lent as a slice.
    // SAFETY: the block holds n T's and is fresh, so it does not overlap s;
    // T is Copy, so the copies are values of their own.
    unsafe {
        crate::ptr::copy_nonoverlapping(s.as_ptr(), p, n);
        crate::slice::from_raw_parts_mut(p, n)
    }
}

// A copy of s in a fresh block of a.
fn alloc_str_in<'a, A: Allocator>(a: &'a A, s: &str) -> &'a mut str {
    let bytes = alloc_slice_copy_in(a, s.as_bytes());
    // UNSAFE: a &mut [u8] cast to a &mut str.
    // SAFETY: the bytes are a copy of a str's, so UTF-8.
    unsafe { &mut *(bytes as *mut [u8] as *mut str) }
}

// A bump allocator over chunks taken from its parent P (Zig's
// ArenaAllocator.init(child)): allocation is a pointer bump, and nothing
// is freed one block at a time. Containers allocate through
// `&'a Arena<P>`, which ties them to the arena; `reset(&mut self)` gives
// every chunk's room back for reuse, safe because the exclusive borrow
// proves nothing in the arena is live; dropping the arena gives the
// chunks back to P. Its bump pointer is a Cell: Allocator::allocate takes
// &self (plan §2.1).
// mvs: Arena
// std2: changed: generic over its parent P, which it owns (MVS: a copyable handle over a Gpa)
pub struct Arena<P: Allocator> {
    parent: P,
    chunks: Chunks,
}

// UNSAFE: an arena's chunks are raw pointers in Cells: stated (AT2).
// SAFETY: an Arena owns its chunks and its parent allocator, and every
// block it hands out is freed with it: moving it moves all of them (P:
// Send).
unsafe impl<P: Allocator + Send> Send for Arena<P> {}
// An arena allocates through `&self` with no lock: never Sync, so `&Arena`
// is neither Send nor Sync (a thread allocates from its own arena).
impl<P: Allocator> !Sync for Arena<P> {}

impl<P: Allocator> Arena<P> {
    // An empty arena over parent; its first chunk comes with its first
    // allocation.
    // std2: changed: any parent P (MVS: a Gpa)
    #[effects()]
    pub fn new_in(parent: P) -> Arena<P> {
        Arena { parent: parent, chunks: Chunks::new() }
    }

    // An arena whose first chunk holds bytes.
    // std2: changed: usize, any parent P
    #[effects(panic, P)]
    pub fn with_capacity_in(bytes: usize, parent: P) -> Arena<P> {
        let a = Arena::new_in(parent);
        if a.chunks.add(&a.parent, bytes).is_err() {
            out_of_memory();
        }
        a
    }

    // The bytes given out since it was made or reset.
    // std2: changed: usize
    #[effects()]
    pub fn used(&self) -> usize {
        self.chunks.used.get()
    }

    // The bytes it holds from its parent, used or not.
    // mvs: Arena::chunk_bytes
    // std2: renamed
    #[effects()]
    pub fn allocated_bytes(&self) -> usize {
        self.chunks.allocated.get()
    }

    #[effects()]
    pub fn parent(&self) -> &P {
        &self.parent
    }

    // Every chunk's room back for reuse (the first chunk kept when it is
    // a standard one, the others given back to P). Safe: `&mut self` proves no container, &T or &str
    // in the arena is live.
    // std2: changed: safe, &mut self (MVS: unsafe, through a raw pointer)
    #[effects(P)]
    pub fn reset(&mut self) {
        self.chunks.release(&self.parent, true)
    }

    // x moved into the arena; a &mut to it for as long as the arena is
    // borrowed. T must have no drop glue (`needs_drop::<T>()` false,
    // checked at compile time): the arena never runs drops. A T holding a
    // Vec on this arena qualifies (FREES false: plan §9.1); for drops, a
    // TypedArena.
    #[effects(P, T)]
    pub fn alloc<T>(&self, x: T) -> &mut T {
        alloc_in(self, x)
    }

    // A copy of s in the arena.
    #[effects(P, T)]
    pub fn alloc_slice_copy<T: Copy>(&self, s: &[T]) -> &mut [T] {
        alloc_slice_copy_in(self, s)
    }

    // n values f(0), f(1), ... in the arena (no drop glue, as alloc).
    #[effects(panic, unsafe, P, T, F)]
    pub fn alloc_slice_fill_with<T, F: FnMut(usize) -> T>(&self, n: usize, f: F) -> &mut [T] {
        let mut f = f;
        let layout = match Layout::array::<T>(n) {
            Result::Ok(l) => l,
            Result::Err(_) => out_of_memory(),
        };
        let p = match self.allocate(layout) {
            Result::Ok(p) => p.as_ptr() as *mut T,
            Result::Err(_) => out_of_memory(),
        };
        let mut i: usize = 0;
        while i < n {
            // UNSAFE: each value is written into the block through a raw
            // pointer (a raw store: nothing was there to drop).
            // SAFETY: the block holds n T's and i < n.
            unsafe {
                crate::ptr::write(p.add(i), f(i));
            }
            i += 1;
        }
        // UNSAFE: the block lent as a slice.
        // SAFETY: its n T's are written above; the block lives as long as
        // the arena's borrow.
        unsafe { crate::slice::from_raw_parts_mut(p, n) }
    }

    // A copy of s in the arena.
    #[effects(P)]
    pub fn alloc_str(&self, s: &str) -> &mut str {
        alloc_str_in(self, s)
    }

    // Runs f with a scope of the arena: what f allocates in the scope is
    // given back when f returns, while containers made before stay live
    // (the scratch checkpoint). The scope's region is late-bound, so
    // nothing allocated in it can leave f (`#[scoped]` is no longer
    // needed); R cannot name it.
    // std2: changed: FnOnce(&ArenaScope<'_, P>) (MVS: FnMut(ScopedArena))
    #[effects(P, R, F)]
    pub fn scope<R, F: FnOnce(&ArenaScope<'_, P>) -> R>(&self, f: F) -> R {
        let s = ArenaScope { home: self, chunks: Chunks::new(), region: PhantomData {} };
        f(&s)
    }
}

// UNSAFE: an Allocator impl over the arena's chunks.
// SAFETY: blocks are bumped from chunks taken from P and live until the
// arena is reset (which needs &mut, so no block is borrowed) or dropped;
// deallocate does nothing (FREES false).
// mvs: Arena::impl Allocator
unsafe impl<P: Allocator> Allocator for Arena<P> {
    const FREES: bool = false;

    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        self.chunks.bump(&self.parent, layout)
    }

    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, the trait's own for deallocate.
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}
}

// Gives every chunk back to P (MVS's free_all).
impl<P: Allocator> Drop for Arena<P> {
    fn drop(&mut self) {
        self.chunks.release(&self.parent, false)
    }
}

// A scope of an arena (Arena::scope) or of any parent (arena_scope): an
// allocator whose blocks are all given back when the scope ends. 's is
// the scope's region, invariant, so a container on `&'s ArenaScope<'s,
// P>` cannot outlive it. Its chunks come from the arena's parent.
// mvs: ScopedArena
// std2: renamed
pub struct ArenaScope<'s, P: Allocator> {
    home: &'s Arena<P>,
    chunks: Chunks,
    region: PhantomData<Cell<&'s ()>>,
}

impl<'s, P: Allocator> ArenaScope<'s, P> {
    // The bytes given out in this scope.
    // mvs: ScopedArena::used
    // std2: changed: usize
    #[effects()]
    pub fn used(&self) -> usize {
        self.chunks.used.get()
    }

    // As Arena::alloc, in the scope.
    #[effects(P, T)]
    pub fn alloc<T>(&self, x: T) -> &mut T {
        alloc_in(self, x)
    }

    #[effects(P, T)]
    pub fn alloc_slice_copy<T: Copy>(&self, s: &[T]) -> &mut [T] {
        alloc_slice_copy_in(self, s)
    }

    #[effects(P)]
    pub fn alloc_str(&self, s: &str) -> &mut str {
        alloc_str_in(self, s)
    }

    // A scope inside this one.
    // mvs: ScopedArena::scope
    // std2: changed: FnOnce(&ArenaScope<'_, P>)
    #[effects(P, R, F)]
    pub fn scope<R, F: FnOnce(&ArenaScope<'_, P>) -> R>(&self, f: F) -> R {
        let s = ArenaScope { home: self.home, chunks: Chunks::new(), region: PhantomData {} };
        f(&s)
    }
}

// UNSAFE: an Allocator impl over the scope's chunks.
// SAFETY: blocks are bumped from chunks the scope took from its arena's
// parent; they are given back when the scope ends, and the scope's region
// keeps every block's borrow inside it; FREES false.
// mvs: ScopedArena::impl Allocator
unsafe impl<'s, P: Allocator> Allocator for ArenaScope<'s, P> {
    const FREES: bool = false;

    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        self.chunks.bump(&self.home.parent, layout)
    }

    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, the trait's own for deallocate.
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}
}

impl<'s, P: Allocator> Drop for ArenaScope<'s, P> {
    fn drop(&mut self) {
        self.chunks.release(&self.home.parent, false)
    }
}

// Runs f with a scope over parent (an arena made for the call): what f
// allocates is freed when it returns. Over any allocator, a Gpa as much
// as an arena or a FixedBuf.
// std2: changed: any parent, by reference; FnOnce(&ArenaScope<'_, &P>) (MVS: a Gpa, FnMut(ScopedArena))
#[effects(P, R, F)]
pub fn arena_scope<'p, P: Allocator, R,
    F: FnOnce(&ArenaScope<'_, &'p P>) -> R>(parent: &'p P, f: F) -> R {
    let arena = Arena::new_in(parent);
    arena.scope(f)
}

// An arena of T's that runs their drops at its own drop: for T's with
// drop glue (Arena::alloc refuses those). Its chunks come from P; each
// begins with a header of three words (the previous chunk, its capacity
// in T's, how many it holds), the T's after it.
pub struct TypedArena<T, P: Allocator> {
    parent: P,
    chunks: Cell<*mut u8>,
    at: Cell<*mut T>,
    end: Cell<*mut T>,
    len: Cell<usize>,
    marker: PhantomData<T>,
}

// UNSAFE: a typed arena's chunks are raw pointers in Cells: stated (AT2).
// SAFETY: it owns its values and its parent allocator, as an Arena does
// (T: Send, P: Send).
unsafe impl<T: Send, P: Allocator + Send> Send for TypedArena<T, P> {}
// It allocates through `&self` with no lock: never Sync.
impl<T, P: Allocator> !Sync for TypedArena<T, P> {}

impl<T, P: Allocator> TypedArena<T, P> {
    #[effects(T, P)]
    pub fn new_in(parent: P) -> TypedArena<T, P> {
        TypedArena {
            parent: parent,
            chunks: Cell::new(crate::ptr::null_mut()),
            at: Cell::new(crate::ptr::null_mut()),
            end: Cell::new(crate::ptr::null_mut()),
            len: Cell::new(0),
            marker: PhantomData {},
        }
    }

    // Where a chunk's T's begin, past its header.
    fn items_offset() -> usize {
        round_up(3 * crate::mem::size_of::<usize>(), crate::mem::align_of::<T>())
    }

    fn chunk_layout(cap: usize) -> Layout {
        let size = TypedArena::<T, P>::items_offset() + cap * crate::mem::size_of::<T>();
        Layout { size: size, align: crate::cmp::max(crate::mem::align_of::<T>(), CHUNK_ALIGN) }
    }

    // A new chunk with room for at least n T's, made the current one.
    fn add_chunk(&self, n: usize) {
        let per = crate::cmp::max(1, CHUNK_MIN / crate::cmp::max(1, crate::mem::size_of::<T>()));
        let cap = crate::cmp::max(n, per);
        let p = match self.parent.allocate(TypedArena::<T, P>::chunk_layout(cap)) {
            Result::Ok(p) => p.as_ptr(),
            Result::Err(_) => out_of_memory(),
        };
        let h = p as *mut usize;
        // UNSAFE: the header is written through the chunk's raw pointer.
        // SAFETY: the chunk is fresh and at least three words long, aligned
        // to 16.
        unsafe {
            *h = self.chunks.get() as usize;
            *h.add(1) = cap;
            *h.add(2) = 0;
        }
        self.chunks.set(p);
        let items = p as usize + TypedArena::<T, P>::items_offset();
        // UNSAFE: addresses made pointers (integer-to-pointer casts).
        // SAFETY: both are inside the chunk just allocated (its end at most
        // one past it).
        unsafe {
            self.at.set(items as *mut T);
            self.end.set((items + cap * crate::mem::size_of::<T>()) as *mut T);
        }
    }

    // n T's more in the current chunk's count.
    fn count(&self, n: usize) {
        let h = self.chunks.get() as *mut usize;
        // UNSAFE: the current chunk's header is updated in place.
        // SAFETY: add_chunk made the current chunk and wrote its header.
        unsafe {
            *h.add(2) = *h.add(2) + n;
        }
        self.len.set(self.len.get() + n);
    }

    // Room for n T's side by side in the current chunk: its first.
    fn room(&self, n: usize) -> *mut T {
        let size = crate::mem::size_of::<T>();
        if self.chunks.get().is_null()
            || (self.end.get() as usize) - (self.at.get() as usize) < n * size
            {
            self.add_chunk(n);
        }
        let p = self.at.get();
        // UNSAFE: an address made a pointer (an integer-to-pointer cast).
        // SAFETY: p + n T's is at most the current chunk's end (checked
        // above, or a new chunk with room for n).
        unsafe {
            self.at.set((p as usize + n * size) as *mut T);
        }
        p
    }

    // x moved in; a &mut to it for as long as the arena is borrowed.
    #[effects(unsafe, T, P)]
    pub fn alloc(&self, x: T) -> &mut T {
        let p = self.room(1);
        // UNSAFE: x is moved into the chunk through a raw pointer.
        // SAFETY: room gave a slot for one T in a chunk the arena owns; the
        // count makes the arena's drop drop it, once.
        unsafe {
            crate::ptr::write(p, x);
            self.count(1);
            &mut *p
        }
    }

    // The items moved in, side by side.
    #[effects(unsafe, T, P, I)]
    pub fn alloc_extend<I: IntoIterator<Item = T>>(&self, iter: I) -> &mut [T] {
        let mut items = crate::vec::Vec::new_in(&self.parent);
        for x in iter {
            items.push(x);
        }
        let n = items.len();
        let p = self.room(n);
        // UNSAFE: the items are moved from the Vec's buffer into the chunk
        // bit for bit, and the Vec forgets them.
        // SAFETY: room gave n slots in a chunk the arena owns, which does not
        // overlap the Vec's buffer; set_len(0) leaves the Vec owning only
        // its buffer, so each item is dropped once, by the arena.
        unsafe {
            crate::ptr::copy_nonoverlapping(items.as_ptr(), p, n);
            items.set_len(0);
            self.count(n);
            crate::slice::from_raw_parts_mut(p, n)
        }
    }

    // How many T's it holds.
    #[effects()]
    pub fn len(&self) -> usize {
        self.len.get()
    }
}

// Drops every T, then gives the chunks back to P.
impl<T, P: Allocator> Drop for TypedArena<T, P> {
    fn drop(&mut self) {
        let size = crate::mem::size_of::<T>();
        let mut c = self.chunks.get();
        while !c.is_null() {
            let h = c as *mut usize;
            // UNSAFE: the chunk's header and T's are read through raw
            // pointers, each T moved out and dropped, then the chunk given
            // back.
            // SAFETY: add_chunk made every chunk on the list from parent with
            // chunk_layout(cap) and wrote its header; its first `count` T's
            // were written by alloc or alloc_extend and are dropped here
            // once; no &mut to them outlives the arena's borrow.
            unsafe {
                let (prev, cap, count) = (*h as *mut u8, *h.add(1), *h.add(2));
                let items = c as usize + TypedArena::<T, P>::items_offset();
                let mut i: usize = 0;
                while i < count {
                    crate::mem::drop(crate::ptr::read((items + i * size) as *const T));
                    i += 1;
                }
                if let crate::option::Option::Some(nn) = NonNull::new(c) {
                    self.parent.deallocate(nn, TypedArena::<T, P>::chunk_layout(cap));
                }
                c = prev;
            }
        }
    }
}

// A bump allocator over memory it is lent (`FixedBuf::new(&mut buf)`, buf
// a local array): no heap at all; out of room is an AllocError. Its
// counters are Cells (allocate takes &self). An arena over one
// (`Arena<&FixedBuf<'b>>`) allocates on the stack.
// mvs: FixedBuf
// std2: changed: a region 'b, the lent memory's (MVS: #[views(mem)])
pub struct FixedBuf<'b> {
    start: *mut u8,
    len: usize,
    at: Cell<usize>,
    mem: PhantomData<&'b mut [u8]>,
}

// UNSAFE: the buffer is a raw pointer: stated (AT2).
// SAFETY: a FixedBuf is the exclusive borrow `&'b mut [u8]` of its bytes
// (its PhantomData), which is Send.
unsafe impl<'b> Send for FixedBuf<'b> {}
// It allocates through `&self` (a Cell) with no lock: never Sync.
impl<'b> !Sync for FixedBuf<'b> {}

impl<'b> FixedBuf<'b> {
    // An allocator over mem, for as long as mem is lent.
    // std2: changed: takes &'b mut [u8]
    #[effects()]
    pub fn new(mem: &'b mut [u8]) -> FixedBuf<'b> {
        FixedBuf { start: mem.as_mut_ptr(), len: mem.len(), at: Cell::new(0), mem: PhantomData {} }
    }

    // The bytes given out since it was made or reset.
    // std2: changed: usize
    #[effects()]
    pub fn used(&self) -> usize {
        self.at.get()
    }

    // The bytes it can give out in all.
    #[effects()]
    pub fn capacity(&self) -> usize {
        self.len
    }

    // All its room back. Safe: `&mut self` proves no block is borrowed.
    // std2: changed: safe, &mut self (MVS: unsafe, through a raw pointer)
    #[effects()]
    pub fn reset(&mut self) {
        self.at.set(0)
    }
}

// UNSAFE: an Allocator impl over lent memory.
// SAFETY: blocks are bumped from mem, which outlives 'b and every
// borrow of the FixedBuf; deallocate does nothing (FREES false).
// mvs: FixedBuf::impl Allocator
unsafe impl<'b> Allocator for FixedBuf<'b> {
    const FREES: bool = false;

    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        let base = self.start as usize;
        let start = round_up(base + self.at.get(), layout.align()) - base;
        if start + layout.size() > self.len {
            return Result::Err(AllocError {});
        }
        self.at.set(start + layout.size());
        // UNSAFE: an address made a pointer (an integer-to-pointer cast).
        // SAFETY: base + start .. + size is inside the lent memory (checked
        // just above), which outlives 'b.
        match NonNull::new(unsafe { (base + start) as *mut u8 }) {
            crate::option::Option::Some(p) => Result::Ok(p),
            crate::option::Option::None => Result::Err(AllocError {}),
        }
    }

    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, the trait's own for deallocate.
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}
}

// Any allocator, its type erased: a data pointer and the allocator's
// functions, Copy, five words. Made from any &'a A (`a.erase()`,
// `AnyAlloc::new(&a)`); itself an Allocator, so `Vec<T, AnyAlloc<'a>>`
// and a library taking `a: AnyAlloc<'_>` are compiled once for every
// allocator (decision 9; Device<AnyAlloc<'a>>, decision 17). FREES is
// true: it cannot know what it erased.
pub struct AnyAlloc<'a> {
    data: *const u8,
    allocate_fn: fn(*const u8, Layout) -> Result<NonNull<u8>, AllocError>,
    // UNSAFE: the erased allocator's deallocate, unsafe as the trait's.
    // SAFETY: called only from AnyAlloc's own deallocate, with its contract.
    deallocate_fn: unsafe fn(*const u8, NonNull<u8>, Layout),
    // UNSAFE: the erased allocator's grow, unsafe as the trait's.
    // SAFETY: called only from AnyAlloc's own grow, with its contract.
    grow_fn: unsafe fn(*const u8, NonNull<u8>, Layout, Layout) -> Result<NonNull<u8>, AllocError>,
    // UNSAFE: the erased allocator's shrink, unsafe as the trait's.
    // SAFETY: called only from AnyAlloc's own shrink, with its contract.
    shrink_fn: unsafe fn(*const u8, NonNull<u8>, Layout, Layout) -> Result<NonNull<u8>, AllocError>,
    marker: PhantomData<&'a ()>,
}

impl<'a> AnyAlloc<'a> {
    // a, erased: valid for as long as a is borrowed.
    #[effects(unsafe)]
    pub fn new<A: Allocator>(a: &'a A) -> AnyAlloc<'a> {
        AnyAlloc {
            data: a as *const A as *const u8,
            allocate_fn: any_allocate::<A>,
            deallocate_fn: any_deallocate::<A>,
            grow_fn: any_grow::<A>,
            shrink_fn: any_shrink::<A>,
            marker: PhantomData {},
        }
    }
}

impl<'a> Clone for AnyAlloc<'a> {
    fn clone(&self) -> AnyAlloc<'a> {
        *self
    }
}

impl<'a> Copy for AnyAlloc<'a> {}

impl<'a, A: Allocator> From<&'a A> for AnyAlloc<'a> {
    fn from(a: &'a A) -> AnyAlloc<'a> {
        AnyAlloc::new(a)
    }
}

// UNSAFE: an Allocator impl through the erased functions.
// SAFETY: each call goes to the erased allocator's own function with its
// data pointer, valid for 'a; that allocator's impl is sound by its own
// SAFETY comment.
// AnyAlloc::new's functions for an A: data is the &'a A it erased.
fn any_allocate<A: Allocator>(data: *const u8, layout: Layout) -> Result<NonNull<u8>, AllocError> {
    // UNSAFE: the allocator is read back through the erased pointer.
    // SAFETY: data is the `&'a A` AnyAlloc::new took, cast; AnyAlloc<'a>
    // keeps that shared borrow alive.
    let a = unsafe { &*(data as *const A) };
    a.allocate(layout)
}

// UNSAFE: the erased allocator's deallocate, with its contract.
// SAFETY: as any_allocate's data; the caller's p and layout are A's.
unsafe fn any_deallocate<A: Allocator>(data: *const u8, p: NonNull<u8>, layout: Layout) {
    // UNSAFE: the allocator read back, and its deallocate.
    // SAFETY: as above.
    unsafe { (*(data as *const A)).deallocate(p, layout) }
}

// UNSAFE: the erased allocator's grow, with its contract.
// SAFETY: as any_deallocate's.
unsafe fn any_grow<A: Allocator>(data: *const u8, p: NonNull<u8>, old: Layout,
    new: Layout) -> Result<NonNull<u8>, AllocError> {
    // UNSAFE: the allocator read back, and its grow.
    // SAFETY: as above.
    unsafe { (*(data as *const A)).grow(p, old, new) }
}

// UNSAFE: the erased allocator's shrink, with its contract.
// SAFETY: as any_deallocate's.
unsafe fn any_shrink<A: Allocator>(data: *const u8, p: NonNull<u8>, old: Layout,
    new: Layout) -> Result<NonNull<u8>, AllocError> {
    // UNSAFE: the allocator read back, and its shrink.
    // SAFETY: as above.
    unsafe { (*(data as *const A)).shrink(p, old, new) }
}

// UNSAFE: Allocator is an unsafe trait: a block it gives stays valid
// until it is given back.
// SAFETY: every method passes through to the erased allocator, which
// is an Allocator itself.
unsafe impl<'a> Allocator for AnyAlloc<'a> {
    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {
        (self.allocate_fn)(self.data, layout)
    }

    // UNSAFE: p must be a block of this allocator's, with this layout.
    // SAFETY: a contract on the caller, the trait's own for deallocate.
    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {
        // UNSAFE: the erased allocator's deallocate.
        // SAFETY: passed through: the caller's p and layout are its.
        unsafe { (self.deallocate_fn)(self.data, p, layout) }
    }

    // UNSAFE: p must be a block of this allocator's, with layout old;
    // new.size() >= old.size().
    // SAFETY: a contract on the caller, the trait's own for grow.
    unsafe fn grow(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        // UNSAFE: the erased allocator's grow.
        // SAFETY: passed through, as deallocate.
        unsafe { (self.grow_fn)(self.data, p, old, new) }
    }

    // UNSAFE: p must be a block of this allocator's, with layout old;
    // new.size() <= old.size().
    // SAFETY: a contract on the caller, the trait's own for shrink.
    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,
        AllocError> {
        // UNSAFE: the erased allocator's shrink.
        // SAFETY: passed through, as deallocate.
        unsafe { (self.shrink_fn)(self.data, p, old, new) }
    }
}

impl<'a> Debug for AnyAlloc<'a> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("AnyAlloc")
    }
}
