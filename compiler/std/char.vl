// std::char: the methods of char, a Unicode scalar value (0..=0x10FFFF
// less the surrogates), and the functions that make one. The rust front's
// char type comes in 0.27.2 (`syntax.later: char`); MVS had none (a code
// point was a u32, `'x'` a u8), and in the rust edition `'x'` is a char
// and `b'x'` a u8.

use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::convert::TryFrom;
use crate::default::Default;
use crate::fmt::{Debug, Display, Formatter};
use crate::hash::{Hash, Hasher};
use crate::iter::Iterator;
use crate::option::Option;
use crate::result::Result;

impl char {
    // The largest char, '\u{10FFFF}'.
    pub const MAX: char = '\u{10FFFF}';

    // U+FFFD, what bad UTF-8 decodes to.
    pub const REPLACEMENT_CHARACTER: char = '\u{FFFD}';

    // i as a char, when it is a scalar value.
    #[effects()]
    pub fn from_u32(i: u32) -> Option<char> {
        // the surrogates (U+D800..=U+DFFF) and past U+10FFFF are no chars
        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) {
            Option::None
        } else {
            Option::Some(from_u32_unchecked(i))
        }
    }

    // The digit d in radix (2..=36), as a char: from_digit(7, 10) is '7'.
    #[effects(panic)]
    pub fn from_digit(d: u32, radix: u32) -> Option<char>
        requires radix <= 36
    {
        if radix > 36 {
            crate::panic::panic("from_digit: radix is too high (maximum 36)");
        }
        if d >= radix {
            Option::None
        } else if d < 10 {
            Option::Some(('0' as u8 + d as u8) as char)
        } else {
            Option::Some(('a' as u8 + (d - 10) as u8) as char)
        }
    }

    // Its value as a digit in radix: '7'.to_digit(10) is Some(7).
    #[effects(panic)]
    pub fn to_digit(self, radix: u32) -> Option<u32> {
        if radix < 2 || radix > 36 {
            crate::panic::panic(
                "to_digit: invalid radix -- radix must be in the range 2 to 36 inclusive");
        }
        let c = self as u32;
        // `| 0x20` folds ASCII upper case onto lower case
        let l = c | 0x20;
        let d = if c >= 0x30 && c <= 0x39 {
            c - 0x30
        } else if l >= 0x61 && l <= 0x7A {
            l - 0x61 + 10
        } else {
            return Option::None;
        };
        if d < radix { Option::Some(d) } else { Option::None }
    }

    #[effects(panic)]
    pub fn is_digit(self, radix: u32) -> bool {
        self.to_digit(radix).is_some()
    }

    #[effects(panic)]
    pub fn is_alphabetic(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return self.is_ascii_alphabetic();
        }
        crate::unicode::is_alphabetic(c)
    }

    #[effects(panic)]
    pub fn is_numeric(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return self.is_ascii_digit();
        }
        crate::unicode::is_numeric(c)
    }

    #[effects(panic)]
    pub fn is_alphanumeric(self) -> bool {
        self.is_alphabetic() || self.is_numeric()
    }

    #[effects(panic)]
    pub fn is_whitespace(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c == 0x20 || (c >= 0x9 && c <= 0xD);
        }
        // (Unicode's White_Space outside ASCII, all of it: nineteen code
        // points, the same since Unicode 6.3; std::unicode's tables are
        // read only by a program that names them, and `{:?}` of a str
        // asks this of every char)
        c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028
            || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000
    }

    #[effects(panic)]
    pub fn is_uppercase(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return self.is_ascii_uppercase();
        }
        crate::unicode::is_uppercase(c)
    }

    #[effects(panic)]
    pub fn is_lowercase(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return self.is_ascii_lowercase();
        }
        crate::unicode::is_lowercase(c)
    }

    #[effects()]
    pub fn is_control(self) -> bool {
        // general category Cc
        let c = self as u32;
        c < 0x20 || (c >= 0x7F && c <= 0x9F)
    }

    #[effects()]
    pub fn is_ascii(&self) -> bool {
        (*self as u32) < 0x80
    }

    #[effects()]
    pub fn is_ascii_alphabetic(&self) -> bool {
        self.is_ascii_uppercase() || self.is_ascii_lowercase()
    }

    #[effects()]
    pub fn is_ascii_uppercase(&self) -> bool {
        *self >= 'A' && *self <= 'Z'
    }

    #[effects()]
    pub fn is_ascii_lowercase(&self) -> bool {
        *self >= 'a' && *self <= 'z'
    }

    #[effects()]
    pub fn is_ascii_digit(&self) -> bool {
        *self >= '0' && *self <= '9'
    }

    #[effects()]
    pub fn is_ascii_hexdigit(&self) -> bool {
        self.is_ascii_digit() || (*self >= 'a' && *self <= 'f') || (*self >= 'A' && *self <= 'F')
    }

    #[effects()]
    pub fn is_ascii_alphanumeric(&self) -> bool {
        self.is_ascii_alphabetic() || self.is_ascii_digit()
    }

    #[effects()]
    pub fn is_ascii_whitespace(&self) -> bool {
        *self == ' ' || *self == '\t' || *self == '\n' || *self == '\r' || *self == '\x0C'
    }

    #[effects()]
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self >= '!' && *self <= '/') || (*self >= ':' && *self <= '@')
            || (*self >= '[' && *self <= '`') || (*self >= '{' && *self <= '~')
    }

    #[effects()]
    pub fn to_ascii_uppercase(&self) -> char {
        if self.is_ascii_lowercase() { ((*self as u8) - 32) as char } else { *self }
    }

    #[effects()]
    pub fn to_ascii_lowercase(&self) -> char {
        if self.is_ascii_uppercase() { ((*self as u8) + 32) as char } else { *self }
    }

    #[effects()]
    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }

    // Its upper case: one char or more ('ß' gives "SS").
    #[effects(panic, diverge)]
    pub fn to_uppercase(self) -> ToUppercase {
        let c = self as u32;
        if c < 0x80 {
            return ToUppercase { chars: [self.to_ascii_uppercase(), '\0', '\0'], at: 0, len: 1 };
        }
        let (chars, len) = case_chars(crate::unicode::to_upper(c));
        ToUppercase { chars: chars, at: 0, len: len }
    }

    // Its lower case: one char or more ('İ' gives "i\u{307}").
    #[effects(panic, diverge)]
    pub fn to_lowercase(self) -> ToLowercase {
        let c = self as u32;
        if c < 0x80 {
            return ToLowercase { chars: [self.to_ascii_lowercase(), '\0', '\0'], at: 0, len: 1 };
        }
        let (chars, len) = case_chars(crate::unicode::to_lower(c));
        ToLowercase { chars: chars, at: 0, len: len }
    }

    // The bytes of its UTF-8, 1 to 4.
    #[effects()]
    pub fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80 {
            1
        } else if c < 0x800 {
            2
        } else if c < 0x10000 {
            3
        } else {
            4
        }
    }

    // Its UTF-8 written into buf (which must hold len_utf8 bytes), as a str.
    #[effects(panic)]
    pub fn encode_utf8(self, buf: &mut [u8]) -> &mut str {
        let c = self as u32;
        let n = self.len_utf8();
        if buf.len() < n {
            crate::panic::panic("encode_utf8: the buffer is too small");
        }
        if n == 1 {
            buf[0] = c as u8;
        } else if n == 2 {
            buf[0] = (0xC0 | (c >> 6)) as u8;
            buf[1] = (0x80 | (c & 0x3F)) as u8;
        } else if n == 3 {
            buf[0] = (0xE0 | (c >> 12)) as u8;
            buf[1] = (0x80 | ((c >> 6) & 0x3F)) as u8;
            buf[2] = (0x80 | (c & 0x3F)) as u8;
        } else {
            buf[0] = (0xF0 | (c >> 18)) as u8;
            buf[1] = (0x80 | ((c >> 12) & 0x3F)) as u8;
            buf[2] = (0x80 | ((c >> 6) & 0x3F)) as u8;
            buf[3] = (0x80 | (c & 0x3F)) as u8;
        }
        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's
        // str::from_utf8_unchecked_mut).
        // SAFETY: buf[..n] holds one char's UTF-8, just written, and a str
        // is laid out as a [u8].
        unsafe { &mut *(&mut buf[..n] as *mut [u8] as *mut str) }
    }

    // Its width in terminal columns: vole's (str::width's, for one char).
    #[effects()]
    pub fn width(self) -> usize {
        // Without the Unicode tables (MVS's std::unicode::char_width): a
        // control and the combining marks and format chars are 0 wide,
        // the East Asian wide blocks and the emoji 2, the rest 1.
        let c = self as u32;
        if c < 0x7F {
            return if c >= 0x20 { 1 } else { 0 };
        }
        if self.is_control() || is_zero_width(c) {
            0
        } else if is_wide(c) {
            2
        } else {
            1
        }
    }
}

// A char's upper case, one char or more.
#[derive(Clone, Debug)]
pub struct ToUppercase {
    chars: [char; 3],
    at: usize,
    len: usize,
}

impl Iterator for ToUppercase {
    type Item = char;

    fn next(&mut self) -> Option<char> {
        if self.at == self.len {
            return Option::None;
        }
        self.at += 1;
        Option::Some(self.chars[self.at - 1])
    }
}

// A char's lower case, one char or more.
#[derive(Clone, Debug)]
pub struct ToLowercase {
    chars: [char; 3],
    at: usize,
    len: usize,
}

impl Iterator for ToLowercase {
    type Item = char;

    fn next(&mut self) -> Option<char> {
        if self.at == self.len {
            return Option::None;
        }
        self.at += 1;
        Option::Some(self.chars[self.at - 1])
    }
}

// i as a char, when it is a scalar value (char::from_u32).
#[effects()]
pub fn from_u32(i: u32) -> Option<char> {
    char::from_u32(i)
}

// The digit d in radix as a char (char::from_digit).
#[effects(panic)]
pub fn from_digit(d: u32, radix: u32) -> Option<char>
    requires radix <= 36
{
    char::from_digit(d, radix)
}

// Why a u32 is not a char.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct CharTryFromError(());

impl Display for CharTryFromError {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("converted integer out of range for `char`")
    }
}

// The comparisons of chars: their scalar values' (char is no
// `#[builtin_impls]` primitive: written, as Clone and Copy are).
impl PartialEq for char {
    fn eq(&self, other: &char) -> bool {
        (*self as u32) == (*other as u32)
    }
}

impl Eq for char {}

impl PartialOrd for char {
    fn partial_cmp(&self, other: &char) -> Option<Ordering> {
        Option::Some((*self as u32).cmp(&(*other as u32)))
    }
}

impl Ord for char {
    fn cmp(&self, other: &char) -> Ordering {
        (*self as u32).cmp(&(*other as u32))
    }
}

// As its scalar value, a u32 (Rust's).
impl Hash for char {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write_u32(*self as u32)
    }
}

// '\0'.
impl Default for char {
    fn default() -> char {
        '\0'
    }
}

// `{c}`: the char itself, padded as a str.
impl Display for char {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        let mut b = [0u8; 4];
        f.pad(self.encode_utf8(&mut b))
    }
}

// `{c:?}`: the char quoted, with Rust's escapes for the quote, the
// backslash and the control characters.
impl Debug for char {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("'")?;
        let c = *self;
        if c == '\'' {
            f.write_str("\\'")?;
        } else if c == '\\' {
            f.write_str("\\\\")?;
        } else if c == '\n' {
            f.write_str("\\n")?;
        } else if c == '\r' {
            f.write_str("\\r")?;
        } else if c == '\t' {
            f.write_str("\\t")?;
        } else if c == '\0' {
            f.write_str("\\0")?;
        } else if c.is_control() || is_zero_width(c as u32) || (c.is_whitespace() && c != ' ') {
            // (a control, a combining mark, a format char or white space but
            // ' ' as Rust's escape_debug shows it: a grapheme extender and
            // the unprintable)
            f.write_str("\\u{")?;
            crate::fmt::LowerHex::fmt(&(c as u32), f)?;
            f.write_str("}")?;
        } else {
            f.write_char(c)?;
        }
        f.write_str("'")
    }
}

// `char::try_from(i)`: from_u32, with an error for what is no char.
impl TryFrom<u32> for char {
    type Error = CharTryFromError;

    fn try_from(i: u32) -> Result<char, CharTryFromError> {
        match char::from_u32(i) {
            Option::Some(c) => Result::Ok(c),
            Option::None => Result::Err(CharTryFromError(())),
        }
    }
}

// i as a char, i a scalar value (Rust's char::from_u32_unchecked).
fn from_u32_unchecked(i: u32) -> char {
    // UNSAFE: a u32's bits read as a char (Rust's transmute).
    // SAFETY: every caller passes a scalar value (from_u32 checks it; the
    // case maps give one), and a char is laid out as a u32.
    unsafe { *(&i as *const u32 as *const char) }
}

// A case table's mapping (1 to 3 code points, the rest 0) as chars and
// their count.
fn case_chars(m: [u32; 3]) -> ([char; 3], usize) {
    let len: usize = if m[1] == 0 { 1 } else if m[2] == 0 { 2 } else { 3 };
    ([from_u32_unchecked(m[0]), from_u32_unchecked(m[1]), from_u32_unchecked(m[2])], len)
}

// The combining marks and the format chars: no column of their own.
fn is_zero_width(c: u32) -> bool {
    (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5BD)
        || (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F)
        || (c >= 0x900 && c <= 0x902) || c == 0x93C || (c >= 0x941 && c <= 0x948) || c == 0x94D
        || (c >= 0x1AB0 && c <= 0x1AFF) || (c >= 0x1DC0 && c <= 0x1DFF)
        || (c >= 0x200B && c <= 0x200F) || (c >= 0x202A && c <= 0x202E)
        || (c >= 0x2060 && c <= 0x2064) || (c >= 0x20D0 && c <= 0x20FF)
        || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || c == 0xFEFF
        || (c >= 0xE0000 && c <= 0xE0FFF)
}

// East Asian Wide and Fullwidth, and the emoji blocks.
fn is_wide(c: u32) -> bool {
    (c >= 0x1100 && c <= 0x115F) || (c >= 0x231A && c <= 0x231B) || (c >= 0x2E80 && c <= 0x303E)
        || (c >= 0x3041 && c <= 0x33FF) || (c >= 0x3400 && c <= 0x4DBF)
        || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xA000 && c <= 0xA4CF)
        || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF)
        || (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFF60)
        || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F)
        || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD)
}
