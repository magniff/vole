// std::gpu::timing (0.25.4): GPU timestamps (below).

use std::gpu::{
    Buffer, BufferUsage, Commands, ComputePass, Device, Encoder, PassDesc, Queue, RenderPass,
    out_of_memory,
};
use std::gpu::hal::metal as backend;

type N = backend::Metal;

// ---- GPU: timestamps (0.25.4) ----

// std::gpu::timing (0.25.4): GPU timestamps, on WebGPU's timestamp-query.
// A QuerySet holds timestamps (`dev.query_set(n)`); a timed pass writes
// two of them, when its work begins and ends on the GPU
// (`enc.compute_pass_timed(set, 0, 1, |pass| ...)`, `render_pass_timed`);
// `enc.resolve_query_set` copies them, u64 each, into a buffer made with
// BufferUsage::QUERY_RESOLVE; `queue.timestamp_period()` is a tick in ns.
//
// On Metal a timed pass is a command buffer of its own, and its
// timestamps are that command buffer's GPUStartTime and GPUEndTime (the
// host clock, in ns: the period is 1). Metal gives them once the work has
// completed, so a submission with timed passes returns when their work
// has finished, and a resolve in it waits for the passes before it.

/// The most timestamps a query set holds (WebGPU's limit).
pub const MAX_QUERIES: i64 = 4096;

/// Timestamps (`Device::query_set`): `count` of them, written by timed
/// passes and copied out by `Encoder::resolve_query_set`.
pub struct QuerySet {
    pub raw: backend::Buffer,
    pub count: i64,
}

impl QuerySet {
    pub fn count(self) -> i64 {
        self.count
    }
}

/// A command buffer an encoder ended early: the one before a timed pass,
/// the timed pass, or the one before a resolve. `resolve`: the
/// timestamps before it are written before it is submitted.
pub struct Seg {
    pub cb: backend::CommandBuffer,
    pub resolve: bool,
}

/// A timestamp a timed pass writes: its set (a handle), its index, the
/// segment of the pass, and which end of it.
pub struct Stamp {
    pub set: backend::Buffer,
    pub index: i64,
    pub seg: i64,
    pub end: bool,
}

impl Device {
    /// A set of count timestamps (1 to 4096), zero until a timed pass
    /// writes them.
    pub fn query_set(self, count: i64) -> QuerySet
        requires self.caps.timestamps
        else "gpu.unsupported: this device has no GPU timestamps (dev.caps().timestamps)"
        requires count >= 1 && count <= MAX_QUERIES
        else f"gpu.limits: a query set of {count} timestamps; a set holds 1 to 4096"
        {
        match N::create_buffer(self.raw, count * 8, "") {
            Some(b) => QuerySet { raw: b, count: count },
            None => out_of_memory("query set"),
        }
    }
}

impl Queue {
    /// The ns of a timestamp's tick (WebGPU's getTimestampPeriod): 1 on
    /// Metal, whose timestamps are ns already.
    pub fn timestamp_period(self) -> f64 {
        1.0
    }
}

impl Encoder {
    /// A compute pass that writes timestamp `begin` of set when its work
    /// begins on the GPU and `end` when it ends (-1: not that one).
    pub fn compute_pass_timed<F: FnMut(inout ComputePass)>(inout self, set: QuerySet, begin: i64,
        end: i64, f: sink F)
        requires self.caps.timestamps
        else "gpu.unsupported: this device has no GPU timestamps (dev.caps().timestamps)"
        requires begin >= -1 && begin < set.count && end >= -1 && end < set.count
        else f"gpu.range: a timed pass's indices are -1 (none) or 0 to {set.count - 1}, the set's; these are {begin} and {end}"
        {
        self.split(false);
        self.compute_pass(f);
        self.timed(set, begin, end);
    }

    /// A render pass that writes timestamp `begin` of set when its work
    /// begins on the GPU and `end` when it ends (-1: not that one).
    pub fn render_pass_timed<F: FnMut(inout RenderPass)>(inout self, desc: PassDesc,
        set: QuerySet, begin: i64, end: i64, f: sink F)
        requires self.caps.timestamps
        else "gpu.unsupported: this device has no GPU timestamps (dev.caps().timestamps)"
        requires begin >= -1 && begin < set.count && end >= -1 && end < set.count
        else f"gpu.range: a timed pass's indices are -1 (none) or 0 to {set.count - 1}, the set's; these are {begin} and {end}"
        {
        self.split(false);
        self.render_pass(desc, f);
        self.timed(set, begin, end);
    }

    /// Copies timestamps first..first + count of set into dst at offset,
    /// a u64 each (ticks: `queue.timestamp_period()` ns). Those of timed
    /// passes submitted before or recorded before it have their values;
    /// one never written is 0.
    pub fn resolve_query_set(inout self, set: QuerySet, first: i64, count: i64, dst: Buffer,
        offset: i64)
        requires first >= 0 && count >= 0 && first + count <= set.count
        else f"gpu.range: timestamps {first}..{first + count} of a set of {set.count}"
        requires dst.usage & BufferUsage::QUERY_RESOLVE != 0
        else f"gpu.usage: resolve_query_set's buffer ({dst.size} bytes) was made without BufferUsage::QUERY_RESOLVE: add it where that buffer is made (QUERY_RESOLVE | COPY_SRC, then copy it into a MAP_READ one to read)"
        requires offset % 256 == 0
        else f"gpu.align: resolve_query_set's offset {offset} is not a multiple of 256"
        requires offset >= 0 && offset + count * 8 <= dst.size
        else f"gpu.range: {count} timestamps at {offset} reach past the buffer's {dst.size} bytes"
        requires !dst.mapped
        else f"gpu.state: resolve_query_set's buffer ({dst.size} bytes) is mapped: unmap it first"
        {
        if count == 0 { return; }
        self.split(true);
        self.uses(dst);
        N::copy_buffer(&self.raw, set.raw, first * 8, dst.raw, offset, count * 8);
    }

    // Ends the command buffer recorded so far (a segment) and starts
    // another; `resolve`: the new one resolves timestamps.
    fn split(inout self, resolve: bool) {
        let cb = std::replace(&self.raw, N::begin(self.dev));
        self.segs.push(Seg { cb: cb, resolve: self.resolve_next });
        self.resolve_next = resolve;
    }

    // The pass just recorded writes set's begin and end.
    fn timed(inout self, set: QuerySet, begin: i64, end: i64) {
        self.split(false);
        let seg = self.segs.len() - 1;
        if begin >= 0 {
            self.stamps.push(Stamp {
                set: N::buffer_handle(set.raw), index: begin, seg: seg, end: false,
            });
        }
        if end >= 0 {
            self.stamps.push(Stamp {
                set: N::buffer_handle(set.raw), index: end, seg: seg, end: true,
            });
        }
    }
}

/// Submits commands an encoder split (timed passes, resolves): the
/// segments in order, the timestamps written into their sets before a
/// resolve after them is submitted, and all of them before it returns.
pub fn submit_segments(q: inout backend::Queue, c: inout Commands) {
    var written: i64 = 0;
    for k in 0..c.segs.len() {
        if c.segs[k].resolve {
            written = write_stamps(&q, &c, k, written);
        }
        N::submit_timed(&q, &c.segs[k].cb);
    }
    if c.resolve_next {
        written = write_stamps(&q, &c, c.segs.len(), written);
    }
    N::submit(&q, &c.raw);
    write_stamps(&q, &c, c.segs.len(), written);
}

// Writes the timestamps from the `from`-th on of the segments before
// `upto` into their sets, once their work has finished; how many are
// written in all.
fn write_stamps(q: inout backend::Queue, c: inout Commands, upto: i64, from: i64) -> i64 {
    var i = from;
    while i < c.stamps.len() && c.stamps[i].seg < upto {
        let seg = c.stamps[i].seg;
        let t = match N::gpu_times(&c.segs[seg].cb) {
            Some((begin, end)) => if c.stamps[i].end { end } else { begin },
            None => 0u64,
        };
        var b = [0u8; 8];
        for j in 0..8 {
            b[j] = (t >> (8 * j) as u64) as u8;
        }
        N::write_buffer(&q, c.stamps[i].set, c.stamps[i].index * 8, b[..]);
        i += 1;
    }
    i
}
