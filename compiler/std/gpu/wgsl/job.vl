// ---- Shader compiler implementation, job (0.22) ----
// Jobs: a compute dispatch with its buffers, run by the interpreter
// (`wgslc run`) or turned into the input of tests/wgsl/metalrun
// (`wgslc metal-job`), whose output has the same form, so the two compare
// as text. A job file:
//
//   entry NAME                  the entry point (default: the first compute one)
//   dispatch X Y Z              workgroups
//   buffer G B BYTES [random SEED | WORD...]   a binding's size and contents
//
// Words are decimal or 0x hex; missing words are zero. The output is each
// buffer, in the job's order: `buffer G B`, then its words in hex.

use crate::alloc::Allocator;

use super::ir::{Module, STAGE_COMPUTE, V};

pub struct JobBuffer<A: Allocator> {
    pub group: i64, pub binding: i64, pub bytes: i64, pub words: Vec<u32, A>,
}

// A texture: its format (`rgba8unorm`, `r8unorm`, `rgba32float`,
// `rgba32uint`) and texels as words (rgba8unorm: one a texel; r8unorm:
// four texels a word; the 32-bit formats: four words a texel).
pub struct JobTexture<'a, A: Allocator> {
    pub group: i64, pub binding: i64, pub format: &'a [u8], pub w: i64, pub h: i64,
    pub words: Vec<u32, A>,
}

// call_n >= 0: a call job (`call ENTRY N`): the entry runs once per input
// record (`input BYTES ...`), its results printed as `buffer -2 0`.
pub struct Job<'a, A: Allocator> {
    pub entry: &'a [u8], pub groups: [i64; 3], pub buffers: Vec<JobBuffer<A>, A>, pub call_n: i64,
    pub input: Vec<u32, A>,
    pub textures: Vec<JobTexture<'a, A>, A>,
}

fn xorshift(s: &mut u32) -> u32 {
    let mut x = *s;
    x = x ^ (x << 13);
    x = x ^ (x >> 17);
    x = x ^ (x << 5);
    *s = x;
    x
}

// A job word: decimal, 0x hex, or a float with a point (its f32 bits).
fn parse_word(t: &[u8]) -> Option<u32> {
    for i in 0..t.len() as i64 {
        if t[i as usize] == b'.' {
            let s = match str::from_utf8(t) {
                Ok(s) => s,
                Err(_) => return None,
            };
            return match s.parse::<f64>() {
                Ok(v) => Some(ir::f32_bits(v as f32)),
                Err(_) => None,
            };
        }
    }
    if t.len() as i64 > 2 && t[0] == b'0' && (t[1] == b'x' || t[1] == b'X') {
        let mut v: u64 = 0;
        for i in 2..t.len() as i64 {
            let c = t[i as usize];
            let d = if c >= b'0' && c <= b'9' { c - b'0' }
                else if c >= b'a' && c <= b'f' { c - b'a' + 10 }
                else if c >= b'A' && c <= b'F' { c - b'A' + 10 } else { return None; };
            v = v * 16 + d as u64;
        }
        return Some(v as u32);
    }
    match int_of(t) {
        Some(v) => Some(v as u32),
        None => None,
    }
}

// The decimal integer t is (a sign, digits), or None.
fn int_of(t: &[u8]) -> Option<i64> {
    match str::from_utf8(t) {
        Ok(s) => s.parse::<i64>().ok(),
        Err(_) => None,
    }
}

// The runs of non-whitespace of a line, as views of it.
fn words_in<'a, A: Allocator + Copy>(line: &'a [u8], a: A) -> Vec<&'a [u8], A> {
    let mut words: Vec<&'a [u8], A> = Vec::new_in(a);
    let mut i: usize = 0;
    while i < line.len() {
        if line[i] == b' ' || line[i] == b'\t' || line[i] == b'\r' || line[i] == b'\n' {
            i += 1;
            continue;
        }
        let st = i;
        while i < line.len()
            && !(line[i] == b' ' || line[i] == b'\t' || line[i] == b'\r' || line[i] == b'\n') {
            i += 1;
        }
        words.push(&line[st..i]);
    }
    words
}

// words[from ..]: `random SEED` or the words themselves.
fn fill_words<B: Allocator, A: Allocator + Copy>(v: &mut Vec<u32, A>, words: &Vec<&[u8], A>,
    from: i64, err: &mut Vec<u8, B>) -> bool {
    if words.len() as i64 >= from + 2 && words[from as usize] == b"random" {
        let mut s = parse_word(words[(from + 1) as usize]).unwrap_or(1u32);
        if s == 0 {
            s = 1;
        }
        for k in 0..v.len() as i64 {
            v[k as usize] = xorshift(&mut s);
        }
        return true;
    }
    for k in from..words.len() as i64 {
        if k - from >= v.len() as i64 {
            break;
        }
        match parse_word(words[k as usize]) {
            Some(x) => v[(k - from) as usize] = x,
            None => {
                err.extend_from_slice(b"not a word: '");
                err.extend_from_slice(words[k as usize]);
                err.push(b'\'');
                return false;
            }
        }
    }
    true
}

// A job texture's texels as the interpreter holds them: four words each,
// f32 bits for the unorm and float formats (unorm: n / 255).
pub fn texels<A: Allocator + Copy>(t: &JobTexture<'_, A>, a: A) -> Vec<u32, A> {
    let n = t.w * t.h;
    let mut v: Vec<u32, A> = Vec::from_elem_in(0u32, (4 * n as usize), a);
    for i in 0..n {
        if t.format == b"rgba8unorm" {
            let x = t.words[i as usize];
            for c in 0..4 {
                let b = (x >> (8 * c) as u32) & 255;
                v[(4 * i + c) as usize] = ir::f32_bits(b as f32 / 255.0);
            }
        } else if t.format == b"r8unorm" {
            let b = (t.words[(i / 4) as usize] >> (8 * (i % 4)) as u32) & 255;
            v[(4 * i) as usize] = ir::f32_bits(b as f32 / 255.0);
            v[(4 * i + 3) as usize] = ir::f32_bits(1.0);
        } else {
            for c in 0..4 {
                v[(4 * i + c) as usize] = t.words[(4 * i + c) as usize];
            }
        }
    }
    v
}

// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form
// is std's own until 0.27.
pub fn parse_job<'a, B: Allocator + Copy, A: Allocator + Copy>(text: &'a [u8], a: A,
    err: &mut String<B>) -> Option<Job<'a, A>> {
    let mut b = Vec::<u8, _>::new_in(*err.allocator());
    let job = parse_job_buf(text, a, &mut b);
    let t = String::from_utf8_lossy_in(b.as_slice(), *err.allocator());
    err.push_str(t.as_str());
    job
}

pub(crate) fn parse_job_buf<'a, B: Allocator, A: Allocator + Copy>(text: &'a [u8], a: A,
    err: &mut Vec<u8, B>) -> Option<Job<'a, A>> {
    let mut job = Job {
        entry: b"", groups: [1i64, 1, 1], buffers: Vec::new_in(a), call_n: -1,
        input: Vec::new_in(a),
        textures: Vec::new_in(a),
    };
    let mut at: usize = 0;
    while at < text.len() {
        let mut end = at;
        while end < text.len() && text[end] != b'\n' {
            end += 1;
        }
        let line = &text[at..end];
        at = if end < text.len() { end + 1 } else { end };
        let words = words_in(line, a);
        if words.len() as i64 == 0 || words[0][0] == b'#' {
            continue;
        }
        let kw = words[0];
        if kw == b"entry" && words.len() as i64 == 2 {
            job.entry = words[1];
        } else if kw == b"dispatch" && words.len() as i64 == 4 {
            for k in 0..3 {
                job.groups[k as usize] = int_of(words[(k + 1) as usize]).unwrap_or(1);
            }
        } else if kw == b"call" && words.len() as i64 == 3 {
            job.entry = words[1];
            job.call_n = int_of(words[2]).unwrap_or(0);
        } else if kw == b"input" && words.len() as i64 >= 2 {
            let bytes = int_of(words[1]).unwrap_or(0);
            job.input = Vec::from_elem_in(0u32, (bytes as usize / 4), a);
            if !fill_words(&mut job.input, &words, 2i64, err) {
                return None;
            }
        } else if kw == b"texture" && words.len() as i64 >= 6 {
            let w = int_of(words[4]).unwrap_or(0);
            let h = int_of(words[5]).unwrap_or(0);
            let fm = words[3];
            let n: i64 = if fm == b"rgba8unorm" { w * h }
                else if fm == b"r8unorm" { (w * h + 3) / 4 }
                else if fm == b"rgba32float" || fm == b"rgba32uint" { 4 * w * h } else { -1 };
            if n < 0 || w <= 0 || h <= 0 {
                err.extend_from_slice(b"a texture is FORMAT W H with a format of rgba8unorm, r8unorm, rgba32float, rgba32uint: ");
                err.extend_from_slice(line);
                return None;
            }
            let mut t = JobTexture {
                group: int_of(words[1]).unwrap_or(0), binding: int_of(words[2]).unwrap_or(0),
                format: fm, w: w, h: h, words: Vec::from_elem_in(0u32, (n as usize), a),
            };
            if !fill_words(&mut t.words, &words, 6i64, err) {
                return None;
            }
            job.textures.push(t);
        } else if kw == b"buffer" && words.len() as i64 >= 4 {
            let bytes = int_of(words[3]).unwrap_or(0);
            if bytes <= 0 || bytes % 4 != 0 {
                err.extend_from_slice(b"a buffer's size is a positive multiple of 4: ");
                err.extend_from_slice(line);
                return None;
            }
            let mut b = JobBuffer {
                group: int_of(words[1]).unwrap_or(0), binding: int_of(words[2]).unwrap_or(0),
                bytes: bytes, words: Vec::from_elem_in(0u32, (bytes as usize / 4), a),
            };
            if words.len() as i64 >= 6 && words[4] == b"random" {
                let mut s = parse_word(words[5]).unwrap_or(1u32);
                if s == 0 {
                    s = 1;
                }
                for k in 0..bytes / 4 {
                    b.words[k as usize] = xorshift(&mut s);
                }
            } else {
                for k in 4..words.len() as i64 {
                    if k - 4 >= bytes / 4 {
                        break;
                    }
                    match parse_word(words[k as usize]) {
                        Some(w) => b.words[(k - 4) as usize] = w,
                        None => {
                            err.extend_from_slice(b"not a word: '");
                            err.extend_from_slice(words[k as usize]);
                            err.push(b'\'');
                            return None;
                        }
                    }
                }
            }
            job.buffers.push(b);
        } else {
            err.extend_from_slice(b"cannot read this job line: ");
            err.extend_from_slice(line);
            return None;
        }
    }
    Some(job)
}

// The entry point a job names (or the first compute one), or -1.
pub fn find_entry<A: Allocator + Copy>(m: &Module<'_, A>, name: &[u8]) -> i64 {
    for e in 0..m.entries.len() as i64 {
        if m.entries[e as usize].stage == STAGE_COMPUTE
            && (name.len() as i64 == 0 || m.entries[e as usize].name == name) {
            return e;
        }
    }
    -1
}

// The entry point of any stage named `name`, or -1.
pub fn find_any_entry<A: Allocator + Copy>(m: &Module<'_, A>, name: &[u8]) -> i64 {
    for e in 0..m.entries.len() as i64 {
        if m.entries[e as usize].name == name {
            return e;
        }
    }
    -1
}

// The global bound at (group, binding), or -1.
pub fn find_global<A: Allocator + Copy>(m: &Module<'_, A>, g: i64, b: i64) -> i64 {
    for i in 0..m.globals.len() as i64 {
        if m.globals[i as usize].group == g && m.globals[i as usize].binding == b {
            return i;
        }
    }
    -1
}

// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form
// is std's own until 0.27.
pub fn print_words<B: Allocator + Copy, A: Allocator + Copy>(group: i64, w: &Vec<u32, A>,
    out: &mut String<B>) {
    let mut b = Vec::<u8, _>::new_in(*out.allocator());
    print_words_buf(group, w, &mut b);
    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());
    out.push_str(t.as_str());
}

pub(crate) fn print_words_buf<B: Allocator, A: Allocator + Copy>(group: i64, w: &Vec<u32, A>,
    out: &mut Vec<u8, B>) {
    write(out, "buffer {group} 0\n").unwrap();
    for k in 0..w.len() as i64 {
        write(out, "{:08x}", w[k as usize]).unwrap();
        out.push((if k % 8 == 7 || k == w.len() as i64 - 1 { b'\n' } else { b' ' }));
    }
}

// Each job buffer's words: words[idx[i]] for the job's i-th buffer.
// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form
// is std's own until 0.27.
pub fn print_buffers<B: Allocator + Copy, A: Allocator + Copy>(job: &Job<'_, A>,
    words: &Vec<Vec<u32, A>, A>, idx: &Vec<i64, A>, out: &mut String<B>) {
    let mut b = Vec::<u8, _>::new_in(*out.allocator());
    print_buffers_buf(job, words, idx, &mut b);
    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());
    out.push_str(t.as_str());
}

pub(crate) fn print_buffers_buf<B: Allocator, A: Allocator + Copy>(job: &Job<'_, A>,
    words: &Vec<Vec<u32, A>, A>, idx: &Vec<i64, A>, out: &mut Vec<u8, B>) {
    for i in 0..job.buffers.len() as i64 {
        let b = &job.buffers[i as usize];
        write(out, "buffer {} {}\n", b.group, b.binding).unwrap();
        let w = &words[idx[i as usize] as usize];
        for k in 0..w.len() as i64 {
            write(out, "{:08x}", w[k as usize]).unwrap();
            out.push((if k % 8 == 7 || k == w.len() as i64 - 1 { b'\n' } else { b' ' }));
        }
    }
}
