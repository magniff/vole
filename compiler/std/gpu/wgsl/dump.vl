// EDITION: rust
// ---- Shader compiler implementation, dump (0.22) ----
// The IR as text: `wgslc ir FILE`, and the front end's golden tests.

use crate::alloc::Allocator;

use super::ir::{
    E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST,
    E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY,
    E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY,
    E_WG_UNIFORM_RESULT, E_ZERO, Function, Module, SK_BOOL, SK_F32, SK_I32, S_ATOMIC, S_BARRIER,
    S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN,
    S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, bits_f32,
};

const UN: [&[u8]; 3] = [b"neg", b"not", b"bitnot"];
const BIN: [&[u8]; 18] = [b"add", b"sub", b"mul", b"div", b"mod", b"eq", b"ne", b"lt", b"le", b"gt",
    b"ge", b"and", b"or", b"xor", b"shl", b"shr", b"land", b"lor"];
const ATOM: [&[u8]; 11] = [b"add", b"sub", b"and", b"or", b"xor", b"min", b"max", b"exchange",
    b"load", b"store", b"cmpxchg"];
const CK: [&[u8]; 4] = [b"pending", b"none", b"clamp", b"rzsw"];

pub(crate) fn dump<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, b: &mut Vec<u8, B>) {
    for t in ir::T_FIXED_COUNT..m.types.len() as i64 {
        let ty = m.types[t as usize];
        if ty.kind == ir::TK_STRUCT {
            write(b, "struct {} (size {}, align {}) {{", str::from_utf8(ty.name).unwrap(), ty.size,
                ty.align).unwrap();
            for i in ty.mstart..ty.mstart + ty.mcount {
                let mem = m.members[i as usize];
                write(b, " {}: ", str::from_utf8(mem.name).unwrap()).unwrap();
                m.type_name(mem.ty, b);
                write(b, " @{};", mem.offset).unwrap();
            }
            b.extend_from_slice(b" }\n");
        }
    }
    for g in 0..m.globals.len() as i64 {
        let gl = m.globals[g as usize];
        write(b, "global {g} {}: {}", str::from_utf8(gl.name).unwrap(),
            str::from_utf8(ir::space_name(gl.space)).unwrap()).unwrap();
        if gl.space == ir::SP_STORAGE {
            b.extend_from_slice(
                (if gl.access == ir::ACC_RW { " read_write" } else { " read" }).as_bytes());
        }
        b.push(b' ');
        m.type_name(gl.ty, b);
        if gl.group >= 0 {
            write(b, " @group({}) @binding({})", gl.group, gl.binding).unwrap();
        }
        if gl.init >= 0 {
            b.extend_from_slice(b" = ");
            expr_text(m, &m.consts, gl.init, b);
        }
        b.push(b'\n');
    }
    for e in 0..m.entries.len() as i64 {
        let en = m.entries[e as usize];
        write(b, "entry {} {} = fn {}", str::from_utf8(entry::stage_name(en.stage)).unwrap(),
            str::from_utf8(en.name).unwrap(), en.func).unwrap();
        if en.stage == ir::STAGE_COMPUTE {
            write(b, " workgroup_size({}, {}, {})", en.wg[0], en.wg[1], en.wg[2]).unwrap();
        }
        b.push(b'\n');
    }
    for i in 0..m.functions.len() as i64 {
        dump_fn(m, i, b);
    }
}

fn binding_text<A: Allocator>(bd: ir::Binding, b: &mut Vec<u8, A>) {
    if bd.kind == ir::BIND_BUILTIN {
        write(b, " @builtin({})", str::from_utf8(entry::builtin_name(bd.value)).unwrap()).unwrap();
    } else if bd.kind == ir::BIND_LOCATION {
        write(b, " @location({})", bd.value).unwrap();
        if bd.interp == ir::INTERP_FLAT {
            b.extend_from_slice(b" @interpolate(flat)");
        }
    }
}

fn dump_fn<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, h: i64, b: &mut Vec<u8, B>) {
    let f = &m.functions[h as usize];
    write(b, "fn {h} {}(", str::from_utf8(f.name).unwrap()).unwrap();
    for i in 0..f.params.len() as i64 {
        if i > 0 {
            b.extend_from_slice(b", ");
        }
        write(b, "{}: ", str::from_utf8(f.params[i as usize].name).unwrap()).unwrap();
        m.type_name(f.params[i as usize].ty, b);
        binding_text(f.params[i as usize].binding, b);
    }
    b.extend_from_slice(b") -> ");
    m.type_name(f.result, b);
    binding_text(f.result_binding, b);
    b.push(b'\n');
    for i in 0..f.locals.len() as i64 {
        write(b, "  local {i} {}: ", str::from_utf8(f.locals[i as usize].name).unwrap()).unwrap();
        m.type_name(f.locals[i as usize].ty, b);
        b.push(b'\n');
    }
    for e in 0..f.exprs.len() as i64 {
        write(b, "  e{e}: ").unwrap();
        m.type_name(f.exprs[e as usize].ty, b);
        b.extend_from_slice(b" = ");
        expr_text(m, &f, e, b);
        if f.names[e as usize].len() as i64 > 0 {
            write(b, "  // {}", str::from_utf8(f.names[e as usize]).unwrap()).unwrap();
        }
        b.push(b'\n');
    }
    if f.body >= 0 {
        block_text(m, &f, f.body, 1i64, b);
    }
}

fn indent<A: Allocator>(n: i64, b: &mut Vec<u8, A>) {
    for _ in 0..n {
        b.extend_from_slice(b"  ");
    }
}

fn block_text<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>, blk: i64,
    depth: i64, b: &mut Vec<u8, B>) {
    let bl = f.blocks[blk as usize];
    for i in bl.start..bl.start + bl.count {
        stmt_text(m, f, f.items[i as usize], depth, b);
    }
}

fn stmt_text<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>, s: i64,
    depth: i64, b: &mut Vec<u8, B>) {
    let st = f.stmts[s as usize];
    indent(depth, b);
    if st.op == S_EMIT {
        write(b, "emit e{}..e{}\n", st.a, st.b).unwrap();
    } else if st.op == S_BLOCK {
        b.extend_from_slice(b"block\n");
        block_text(m, f, st.a, depth + 1, b);
    } else if st.op == S_IF {
        write(b, "if e{}\n", st.a).unwrap();
        block_text(m, f, st.b, depth + 1, b);
        if f.blocks[st.c as usize].count > 0 {
            indent(depth, b);
            b.extend_from_slice(b"else\n");
            block_text(m, f, st.c, depth + 1, b);
        }
    } else if st.op == S_SWITCH {
        write(b, "switch e{}\n", st.a).unwrap();
        for i in st.b..st.b + st.c {
            let c = f.cases[i as usize];
            indent(depth, b);
            b.extend_from_slice(b"case");
            for k in c.vstart..c.vstart + c.vcount {
                write(b, " {}", f.vals[k as usize]).unwrap();
            }
            if c.is_default {
                b.extend_from_slice(b" default");
            }
            b.push(b'\n');
            block_text(m, f, c.body, depth + 1, b);
        }
    } else if st.op == S_LOOP {
        b.extend_from_slice(b"loop\n");
        block_text(m, f, st.a, depth + 1, b);
        if f.blocks[st.b as usize].count > 0 || st.c >= 0 {
            indent(depth, b);
            b.extend_from_slice(b"continuing\n");
            block_text(m, f, st.b, depth + 1, b);
            if st.c >= 0 {
                indent(depth + 1, b);
                write(b, "break if e{}\n", st.c).unwrap();
            }
        }
    } else if st.op == S_BREAK {
        b.extend_from_slice(b"break\n");
    } else if st.op == S_CONTINUE {
        b.extend_from_slice(b"continue\n");
    } else if st.op == S_RETURN {
        if st.a >= 0 {
            write(b, "return e{}\n", st.a).unwrap();
        } else {
            b.extend_from_slice(b"return\n");
        }
    } else if st.op == S_KILL {
        b.extend_from_slice(b"discard\n");
    } else if st.op == S_BARRIER {
        b.extend_from_slice((if st.a == ir::BARRIER_WORKGROUP { "barrier workgroup\n" }
            else { "barrier storage\n" }).as_bytes());
    } else if st.op == S_STORE {
        write(b, "store e{} <- e{}\n", st.a, st.b).unwrap();
    } else if st.op == S_CALL {
        if st.d >= 0 {
            write(b, "e{} = ", st.d).unwrap();
        }
        write(b, "call fn {}(", st.a).unwrap();
        for i in st.b..st.b + st.c {
            if i > st.b {
                b.extend_from_slice(b", ");
            }
            write(b, "e{}", f.args[i as usize]).unwrap();
        }
        b.extend_from_slice(b")\n");
    } else if st.op == S_ATOMIC {
        if st.d >= 0 {
            write(b, "e{} = ", st.d).unwrap();
        }
        write(b, "atomic {} e{}", str::from_utf8(ATOM[st.b as usize]).unwrap(), st.a).unwrap();
        if st.e >= 0 {
            write(b, " cmp e{}", st.e).unwrap();
        }
        if st.c >= 0 {
            write(b, " e{}", st.c).unwrap();
        }
        b.push(b'\n');
    } else if st.op == S_IMAGE_STORE {
        write(b, "image_store e{} at e{} <- e{}\n", st.a, st.b, st.c).unwrap();
    } else if st.op == S_WG_UNIFORM_LOAD {
        write(b, "e{} = workgroup_uniform_load e{}\n", st.b, st.a).unwrap();
    }
}

pub(crate) fn expr_text<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>,
    e: i64, b: &mut Vec<u8, B>) {
    let x = f.exprs[e as usize];
    let op = x.op;
    if op == E_LITERAL {
        let sk = m.types[x.ty as usize].scalar;
        if sk == SK_BOOL {
            b.extend_from_slice((if x.a != 0 { "true" } else { "false" }).as_bytes());
        } else if sk == SK_F32 {
            write(b, "{}", bits_f32(x.a as u32)).unwrap();
        } else if sk == SK_I32 {
            write(b, "{}i", x.a as u32 as i32).unwrap();
        } else {
            write(b, "{}u", x.a).unwrap();
        }
    } else if op == E_ZERO {
        b.extend_from_slice(b"zero");
    } else if op == E_COMPOSE {
        b.extend_from_slice(b"compose(");
        args_text(f, x.a, x.b, b);
        b.push(b')');
    } else if op == E_SPLAT {
        write(b, "splat(e{})", x.a).unwrap();
    } else if op == E_SWIZZLE {
        write(b, "e{}.", x.a).unwrap();
        for i in 0..x.c {
            b.push("xyzw"[((x.b >> (2 * i)) & 3) as usize]);
        }
    } else if op == E_ACCESS {
        write(b, "e{}[e{}] check {}", x.a, x.b, str::from_utf8(CK[x.c as usize]).unwrap()).unwrap();
        if x.c == ir::CK_CLAMP {
            write(b, " {}", x.d).unwrap();
        }
    } else if op == E_ACCESS_INDEX {
        write(b, "e{}.{}", x.a, x.b).unwrap();
    } else if op == E_ARG {
        write(b, "arg {}", x.a).unwrap();
    } else if op == E_GLOBAL {
        write(b, "global {}", x.a).unwrap();
    } else if op == E_LOCAL {
        write(b, "local {}", x.a).unwrap();
    } else if op == E_LOAD {
        write(b, "load e{}", x.a).unwrap();
    } else if op == E_UNARY {
        write(b, "{} e{}", str::from_utf8(UN[x.a as usize]).unwrap(), x.b).unwrap();
    } else if op == E_BINARY {
        write(b, "{} e{} e{}", str::from_utf8(BIN[x.a as usize]).unwrap(), x.b, x.c).unwrap();
    } else if op == E_SELECT {
        write(b, "select e{} ? e{} : e{}", x.a, x.b, x.c).unwrap();
    } else if op == E_MATH {
        b.extend_from_slice(names::PREDECLARED[(names::K_MATH_FIRST + x.a) as usize]);
        b.push(b'(');
        args_text(f, x.b, x.c, b);
        b.push(b')');
    } else if op == E_CONVERT {
        write(b, "convert e{}", x.a).unwrap();
    } else if op == E_BITCAST {
        write(b, "bitcast e{}", x.a).unwrap();
    } else if op == E_CALL_RESULT {
        b.extend_from_slice(b"call result");
    } else if op == E_ATOMIC_RESULT {
        b.extend_from_slice(b"atomic result");
    } else if op == E_WG_UNIFORM_RESULT {
        b.extend_from_slice(b"workgroup uniform load result");
    } else if op == E_ARRAY_LENGTH {
        write(b, "array_length global {} member {} offset {} stride {}", x.a, x.b, x.c, x.d).unwrap();
    } else if op == E_DERIVATIVE {
        write(b, "derivative {} e{}", x.a, x.b).unwrap();
    } else if op == E_IMAGE_SAMPLE {
        write(b, "sample {} e{} e{} (", x.d & 255, x.a, x.b).unwrap();
        args_text(f, x.c, x.d >> 8, b);
        b.push(b')');
    } else if op == E_IMAGE_LOAD {
        write(b, "image_load e{} (", x.a).unwrap();
        args_text(f, x.c, x.d, b);
        b.push(b')');
    } else if op == E_IMAGE_QUERY {
        write(b, "image_query {} e{}", x.b, x.a).unwrap();
        if x.c >= 0 {
            write(b, " level e{}", x.c).unwrap();
        }
    }
}

fn args_text<B: Allocator, A: Allocator + Copy>(f: &Function<'_, A>, start: i64, n: i64,
    b: &mut Vec<u8, B>) {
    for i in start..start + n {
        if i > start {
            b.extend_from_slice(b", ");
        }
        write(b, "e{}", f.args[i as usize]).unwrap();
    }
}
