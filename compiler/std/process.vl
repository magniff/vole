// EDITION: rust
// std::process: running programs, Rust's, through posix_spawnp. A
// Command keeps its program, its arguments and the variables env_remove
// names as NUL-ended copies in Vecs on the allocator it was made with
// (`Command::new_in(p, a)`, Rust's Command::new); argv and envp are built
// on a clone of it when it runs. `output()`'s bytes go in Vecs on clones
// of it too.
// mvs: std::process

use crate::alloc::Allocator;
use crate::clone::Clone;
use crate::convert::AsRef;
use crate::fmt::{Debug, Display, Formatter};
use crate::io::{Error, Read, Result, Write};
use crate::iter::{IntoIterator, Iterator};
use crate::ops::Drop;
use crate::option::Option;
use crate::vec::Vec;

// UNSAFE: posix_spawn and the C library's process, pipe and signal calls,
// which take raw pointers.
// SAFETY: POSIX's prototypes (spawn.h, sys/wait.h, signal.h, unistd.h,
// fcntl.h, poll.h; fcntl and open variadic, as declared); the file
// actions, the attributes and the signal set live in words larger than
// either system's types (SpawnActions, SpawnAttr below).
extern "C" {
    #[link_name = "posix_spawnp"]
    #[effects(io)]
    fn pr_c_spawnp(pid: *mut i32, file: *const u8, actions: *const u64, attr: *const u64,
        argv: *const *const u8, envp: *const *const u8) -> i32;
    #[link_name = "posix_spawn_file_actions_init"]
    #[effects(io)]
    fn pr_c_actions_init(a: *mut u64) -> i32;
    #[link_name = "posix_spawn_file_actions_destroy"]
    #[effects(io)]
    fn pr_c_actions_destroy(a: *mut u64) -> i32;
    #[link_name = "posix_spawn_file_actions_adddup2"]
    #[effects(io)]
    fn pr_c_actions_adddup2(a: *mut u64, fd: i32, to: i32) -> i32;
    #[link_name = "posix_spawnattr_init"]
    #[effects(io)]
    fn pr_c_attr_init(a: *mut u64) -> i32;
    #[link_name = "posix_spawnattr_destroy"]
    #[effects(io)]
    fn pr_c_attr_destroy(a: *mut u64) -> i32;
    #[link_name = "posix_spawnattr_setflags"]
    #[effects(io)]
    fn pr_c_attr_setflags(a: *mut u64, flags: i16) -> i32;
    #[link_name = "posix_spawnattr_setsigdefault"]
    #[effects(io)]
    fn pr_c_attr_setsigdefault(a: *mut u64, set: *const u64) -> i32;
    #[link_name = "sigemptyset"]
    #[effects()]
    fn pr_c_sigemptyset(set: *mut u64) -> i32;
    #[link_name = "sigaddset"]
    #[effects()]
    fn pr_c_sigaddset(set: *mut u64, sig: i32) -> i32;
    #[link_name = "signal"]
    fn pr_c_signal(sig: i32, handler: usize) -> usize;
    #[link_name = "waitpid"]
    #[effects(io)]
    fn pr_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    #[link_name = "kill"]
    #[effects(io)]
    fn pr_c_kill(pid: i32, sig: i32) -> i32;
    #[link_name = "getpid"]
    #[effects(io)]
    fn pr_c_getpid() -> i32;
    #[link_name = "pipe"]
    fn pr_c_pipe(fds: *mut i32) -> i32;
    #[link_name = "fcntl"]
    #[effects(io)]
    fn pr_c_fcntl(fd: i32, cmd: i32, ...) -> i32;
    #[link_name = "open"]
    fn pr_c_open(path: *const u8, flags: i32, ...) -> i32;
    #[link_name = "close"]
    fn pr_c_close(fd: i32) -> i32;
    #[link_name = "poll"]
    #[effects(io)]
    fn pr_c_poll(fds: *mut PollFd, n: u32, timeout: i32) -> i32;
    #[link_name = "exit"]
    fn pr_c_exit(code: i32) -> !;
    #[link_name = "abort"]
    fn pr_c_abort() -> !;
}

const SIGINT: i32 = 2;
const SIGQUIT: i32 = 3;
const SIGKILL: i32 = 9;
const SIG_IGN: usize = 1;
const SIG_ERR: usize = usize::MAX;
const WNOHANG: i32 = 1;
const EINTR: i32 = 4;
const F_SETFD: i32 = 2;
const FD_CLOEXEC: i32 = 1;
const O_RDWR: i32 = 2;
const POLLIN: i16 = 1;
// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.
const SPAWN_SETSIGDEF: i16 = 4;

// struct pollfd, the same on both systems.
#[repr(C)]
struct PollFd {
    fd: i32,
    events: i16,
    revents: i16,
}

// Closes fd, when it is one (-1: none).
fn close_fd(fd: i32) {
    if fd >= 0 {
        // UNSAFE: C's close. SAFETY: an int; each caller closes its own
        // descriptor once.
        let _ = unsafe { pr_c_close(fd) };
    }
}

// A pipe, (read end, write end), both close-on-exec.
fn pipe() -> Result<(i32, i32)> {
    let mut fds = [0i32; 2];
    // UNSAFE: C's pipe and fcntl. SAFETY: fds is a local [i32; 2], which
    // pipe fills; F_SETFD takes an int.
    unsafe {
        if pr_c_pipe(&mut fds[0] as *mut i32) != 0 {
            return crate::result::Result::Err(Error::last_os_error());
        }
        pr_c_fcntl(fds[0], F_SETFD, FD_CLOEXEC);
        pr_c_fcntl(fds[1], F_SETFD, FD_CLOEXEC);
    }
    crate::result::Result::Ok((fds[0], fds[1]))
}

// ---- Stdio ----

// What a child's stdin, stdout or stderr is: this process's (inherit),
// /dev/null (null), or a pipe to this process (piped).
pub struct Stdio {
    kind: u8,
}

const INHERIT: u8 = 0;
const NULL: u8 = 1;
const PIPED: u8 = 2;
// (not set: spawn and status inherit, output pipes stdout and stderr and
// gives stdin /dev/null, as Rust's)
const DEFAULT: u8 = 3;

impl Stdio {
    #[effects()]
    pub fn inherit() -> Stdio {
        Stdio { kind: INHERIT }
    }

    #[effects()]
    pub fn null() -> Stdio {
        Stdio { kind: NULL }
    }

    #[effects()]
    pub fn piped() -> Stdio {
        Stdio { kind: PIPED }
    }
}

// ---- ExitStatus ----

// How a child ended: its exit code, or the signal that ended it (the
// status waitpid gives).
#[derive(Clone, Copy, PartialEq, Eq)]
pub struct ExitStatus {
    status: i32,
}

impl ExitStatus {
    // Whether it exited with 0.
    #[effects()]
    pub fn success(&self) -> bool {
        self.status & 0xffff == 0
    }

    // Its exit code; None when a signal ended it.
    #[effects()]
    pub fn code(&self) -> Option<i32> {
        if self.status & 0x7f == 0 { Option::Some((self.status >> 8) & 0xff) } else { Option::None }
    }

    // The signal that ended it.
    // std2: changed: ExitStatus' own (Rust's: std::os::unix::process::
    // ExitStatusExt)
    #[effects()]
    pub fn signal(&self) -> Option<i32> {
        let s = self.status & 0x7f;
        if s != 0 && s != 0x7f { Option::Some(s) } else { Option::None }
    }
}

// `exit status: 3`, `signal: 9 (SIGKILL)`, as Rust's.
impl Display for ExitStatus {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        match self.code() {
            Option::Some(c) => {
                f.write_str("exit status: ")?;
                Display::fmt(&c, f)
            }
            Option::None => match self.signal() {
                Option::Some(s) => {
                    f.write_str("signal: ")?;
                    Display::fmt(&s, f)?;
                    let name = crate::__sys::signal_name(s);
                    if !name.is_empty() {
                        f.write_str(" (")?;
                        f.write_str(name)?;
                        f.write_str(")")?;
                    }
                    if self.status & 0x80 != 0 {
                        f.write_str(" (core dumped)")?;
                    }
                    crate::result::Result::Ok(())
                }
                Option::None => {
                    f.write_str("unrecognized wait status: ")?;
                    Display::fmt(&self.status, f)
                }
            },
        }
    }
}

// `ExitStatus(unix_wait_status(256))`, as Rust's.
impl Debug for ExitStatus {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("ExitStatus(unix_wait_status(")?;
        Display::fmt(&self.status, f)?;
        f.write_str("))")
    }
}

// What output() gives: how the child ended, and what it wrote.
pub struct Output<A: Allocator> {
    pub status: ExitStatus,
    pub stdout: Vec<u8, A>,
    pub stderr: Vec<u8, A>,
}

// ---- Child ----

// The child's stdin, when it was piped: a writer; dropping it closes it.
pub struct ChildStdin {
    fd: i32,
}

// The child's stdout, when it was piped: a reader.
pub struct ChildStdout {
    fd: i32,
}

// The child's stderr, when it was piped: a reader.
pub struct ChildStderr {
    fd: i32,
}

impl Drop for ChildStdin {
    fn drop(&mut self) {
        close_fd(self.fd);
    }
}

impl Drop for ChildStdout {
    fn drop(&mut self) {
        close_fd(self.fd);
    }
}

impl Drop for ChildStderr {
    fn drop(&mut self) {
        close_fd(self.fd);
    }
}

impl Write for ChildStdin {
    fn write(&mut self, buf: &[u8]) -> Result<usize> {
        crate::io::sys_write(self.fd, buf)
    }

    fn flush(&mut self) -> Result<()> {
        crate::result::Result::Ok(())
    }
}

impl Read for ChildStdout {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
        crate::io::sys_read(self.fd, buf)
    }
}

impl Read for ChildStderr {
    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {
        crate::io::sys_read(self.fd, buf)
    }
}

// A running child, and its piped streams. Dropping it neither waits for
// it nor ends it, as Rust's.
pub struct Child {
    pid: i32,
    status: Option<ExitStatus>,
    pub stdin: Option<ChildStdin>,
    pub stdout: Option<ChildStdout>,
    pub stderr: Option<ChildStderr>,
}

// Waits for pid (again when a signal interrupts): its status.
fn wait_pid(pid: i32) -> Result<i32> {
    loop {
        let mut st: i32 = 0;
        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.
        let r = unsafe { pr_c_waitpid(pid, &mut st as *mut i32, 0) };
        if r >= 0 {
            return crate::result::Result::Ok(st);
        }
        let e = Error::last_os_error();
        if e.raw_os_error() != Option::Some(EINTR) {
            return crate::result::Result::Err(e);
        }
    }
}

impl Child {
    // Its process id.
    // mvs: Child::id
    // std2: changed: a u32, as Rust's (MVS: i32)
    #[effects()]
    pub fn id(&self) -> u32 {
        self.pid as u32
    }

    // Waits for it to end (its stdin closed first, as Rust's).
    #[effects(io, static, diverge)]
    pub fn wait(&mut self) -> Result<ExitStatus> {
        self.stdin = Option::None;
        if let Option::Some(s) = self.status {
            return crate::result::Result::Ok(s);
        }
        let st = ExitStatus { status: wait_pid(self.pid)? };
        self.status = Option::Some(st);
        crate::result::Result::Ok(st)
    }

    // How it ended, when it has: None while it runs.
    #[effects(io, static, unsafe)]
    pub fn try_wait(&mut self) -> Result<Option<ExitStatus>> {
        if let Option::Some(s) = self.status {
            return crate::result::Result::Ok(Option::Some(s));
        }
        let mut st: i32 = 0;
        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.
        let r = unsafe { pr_c_waitpid(self.pid, &mut st as *mut i32, WNOHANG) };
        if r < 0 {
            return crate::result::Result::Err(Error::last_os_error());
        }
        if r == 0 {
            return crate::result::Result::Ok(Option::None);
        }
        let s = ExitStatus { status: st };
        self.status = Option::Some(s);
        crate::result::Result::Ok(Option::Some(s))
    }

    // Sends it SIGKILL (Ok when it has been waited for already, as Rust's).
    #[effects(io, static, unsafe)]
    pub fn kill(&mut self) -> Result<()> {
        if self.status.is_some() {
            return crate::result::Result::Ok(());
        }
        // UNSAFE: C's kill. SAFETY: integers only.
        if unsafe { pr_c_kill(self.pid, SIGKILL) } != 0 {
            return crate::result::Result::Err(Error::last_os_error());
        }
        crate::result::Result::Ok(())
    }
}

// ---- Command ----

// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes
// on macOS, 80 on Linux); dropping it destroys it.
struct SpawnActions {
    words: [u64; 16],
}

impl Drop for SpawnActions {
    fn drop(&mut self) {
        // UNSAFE: C's destroy. SAFETY: initialized by spawn_actions (the
        // only maker), destroyed once (here).
        let _ = unsafe { pr_c_actions_destroy(&mut self.words[0] as *mut u64) };
    }
}

fn spawn_actions() -> Result<SpawnActions> {
    let mut words = [0u64; 16];
    // UNSAFE: C's init. SAFETY: words is 128 bytes, more than either
    // system's type, 8-aligned; it holds no pointer into itself, so it
    // may move.
    let r = unsafe { pr_c_actions_init(&mut words[0] as *mut u64) };
    if r != 0 {
        return crate::result::Result::Err(Error::from_raw_os_error(r));
    }
    crate::result::Result::Ok(SpawnActions { words: words })
}

impl SpawnActions {
    // In the child: `to` becomes a copy of fd.
    fn dup2(&mut self, fd: i32, to: i32) -> Result<()> {
        // UNSAFE: C adds an action. SAFETY: the actions are initialized.
        let r = unsafe { pr_c_actions_adddup2(&mut self.words[0] as *mut u64, fd, to) };
        if r != 0 { crate::result::Result::Err(Error::from_raw_os_error(r)) }
        else { crate::result::Result::Ok(()) }
    }
}

// posix_spawnattr_t, opaque: room for either system's (8 bytes on macOS,
// 336 on Linux); dropping it destroys it.
struct SpawnAttr {
    words: [u64; 48],
}

impl Drop for SpawnAttr {
    fn drop(&mut self) {
        // UNSAFE: C's destroy. SAFETY: initialized by sigdefault_attr (the
        // only maker), destroyed once (here).
        let _ = unsafe { pr_c_attr_destroy(&mut self.words[0] as *mut u64) };
    }
}

// Attributes under which the child starts with SIGINT's and SIGQUIT's
// default actions, whatever this process's are.
fn sigdefault_attr() -> Result<SpawnAttr> {
    let mut words = [0u64; 48];
    // sigset_t: 4 bytes on macOS, 128 on Linux
    let mut set = [0u64; 16];
    // UNSAFE: C initializes the attributes and the set. SAFETY: words
    // (384 bytes) and set (128) are larger than either system's types,
    // 8-aligned, and hold no pointer into themselves.
    unsafe {
        let r = pr_c_attr_init(&mut words[0] as *mut u64);
        if r != 0 {
            return crate::result::Result::Err(Error::from_raw_os_error(r));
        }
        pr_c_sigemptyset(&mut set[0] as *mut u64);
        pr_c_sigaddset(&mut set[0] as *mut u64, SIGINT);
        pr_c_sigaddset(&mut set[0] as *mut u64, SIGQUIT);
        let mut a = SpawnAttr { words: words };
        let r2 = pr_c_attr_setsigdefault(&mut a.words[0] as *mut u64, &set[0] as *const u64);
        if r2 != 0 {
            return crate::result::Result::Err(Error::from_raw_os_error(r2));
        }
        let r3 = pr_c_attr_setflags(&mut a.words[0] as *mut u64, SPAWN_SETSIGDEF);
        if r3 != 0 {
            return crate::result::Result::Err(Error::from_raw_os_error(r3));
        }
        crate::result::Result::Ok(a)
    }
}

// The parent's ends of a spawn's pipes (-1: none), closed on drop.
struct Ends {
    fds: [i32; 7],
}

impl Drop for Ends {
    fn drop(&mut self) {
        let mut i: usize = 0;
        while i < 7 {
            close_fd(self.fds[i]);
            i += 1;
        }
    }
}

impl Ends {
    // fds[i], no longer this one's to close.
    fn take(&mut self, i: usize) -> i32 {
        let fd = self.fds[i];
        self.fds[i] = -1;
        fd
    }
}

// A program to run: its arguments, the variables it does not get, its
// streams. Each method changes it in place and returns it, as Rust's
// (`Command::new_in("ls", a).arg("-l").status()?`).
pub struct Command<A: Allocator> {
    // the program, then each argument, each NUL-ended
    text: Vec<u8, A>,
    argc: usize,
    // env_remove's names, each NUL-ended
    removed: Vec<u8, A>,
    stdin: u8,
    stdout: u8,
    stderr: u8,
    foreground: bool,
    // an argument that held a NUL: spawn's InvalidInput
    bad: bool,
}

impl<A: Allocator + Clone> Command<A> {
    // Runs program: a path, or a name looked up in PATH.
    // mvs: Command::new
    // std2: changed: allocator named (Rust's Command::new)
    #[effects(A)]
    pub fn new_in(program: &str, a: A) -> Command<A> {
        let mut c = Command { text: Vec::new_in(a.clone()), argc: 0, removed: Vec::new_in(a),
            stdin: DEFAULT, stdout: DEFAULT, stderr: DEFAULT, foreground: false, bad: false };
        c.push_text(program);
        c
    }

    fn push_text(&mut self, s: &str) {
        let b = s.as_bytes();
        let mut i: usize = 0;
        while i < b.len() {
            if b[i] == 0 {
                self.bad = true;
            }
            i += 1;
        }
        self.text.extend_from_slice(b);
        self.text.push(0);
        self.argc += 1;
    }

    // Adds an argument.
    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>; MVS: inout)
    #[effects(A)]
    pub fn arg(&mut self, arg: &str) -> &mut Command<A> {
        self.push_text(arg);
        self
    }

    // Adds each of args.
    // std2: changed: &mut self, AsRef<str> (Rust's: AsRef<OsStr>; MVS: a
    // slice)
    #[effects(A, I, S)]
    pub fn args<I: IntoIterator<Item = S>, S: AsRef<str>>(&mut self, args: I) -> &mut Command<A> {
        for s in args {
            // (the path call: AsRef for &T's method call where a &str is
            // expected is 0.27.5's front gap)
            self.push_text(AsRef::<str>::as_ref(&s));
        }
        self
    }

    // The child's environment is this process's without key; each call
    // removes one more.
    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>)
    #[effects(panic, A)]
    pub fn env_remove(&mut self, key: &str) -> &mut Command<A> {
        let b = key.as_bytes();
        let mut i: usize = 0;
        while i < b.len() {
            if b[i] == 0 {
                self.bad = true;
            }
            i += 1;
        }
        self.removed.extend_from_slice(b);
        self.removed.push(0);
        self
    }

    // Runs it as a shell runs a command in the foreground: while status()
    // or output() waits for it, this process ignores SIGINT and SIGQUIT
    // (^C and ^\ at a terminal, which reach both), and the child starts
    // with their default actions (`volec run`).
    // std2: changed: vole's own (MVS's), not Rust's
    #[effects()]
    pub fn foreground(&mut self, on: bool) -> &mut Command<A> {
        self.foreground = on;
        self
    }

    #[effects()]
    pub fn stdin(&mut self, cfg: Stdio) -> &mut Command<A> {
        self.stdin = cfg.kind;
        self
    }

    #[effects()]
    pub fn stdout(&mut self, cfg: Stdio) -> &mut Command<A> {
        self.stdout = cfg.kind;
        self
    }

    #[effects()]
    pub fn stderr(&mut self, cfg: Stdio) -> &mut Command<A> {
        self.stderr = cfg.kind;
        self
    }

    // Starts it, its streams as set (this process's when not).
    // std2: changed: &mut self, as Rust's (MVS: self)
    #[effects(A)]
    pub fn spawn(&mut self) -> Result<Child> {
        self.spawn_with(INHERIT, INHERIT, false)
    }

    // Runs it and waits for it: how it ended.
    // std2: changed: &mut self, as Rust's (MVS: self)
    #[effects(alloc(extern), io, static, panic, diverge, A)]
    pub fn status(&mut self) -> Result<ExitStatus> {
        let fg = self.foreground;
        let mut c = self.spawn_with(INHERIT, INHERIT, fg)?;
        let r = c.wait();
        if fg {
            restore_signals(c.pid);
        }
        r
    }

    // Runs it with stdout and stderr piped to this process and stdin
    // /dev/null (each unless set), and waits: how it ended and what it
    // wrote, in Vecs on clones of the Command's allocator.
    // mvs: Command::output_in
    // std2: changed: on the Command's allocator (Rust's output; MVS: an
    // allocator given)
    #[effects(alloc(extern), io, static, panic, diverge, A)]
    pub fn output(&mut self) -> Result<Output<A>> {
        let fg = self.foreground;
        let mut c = self.spawn_with(NULL, PIPED, fg)?;
        let mut out: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());
        let mut err: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());
        c.stdin = Option::None;
        let a = match c.stdout.take() {
            Option::Some(s) => s.fd_take(),
            Option::None => -1,
        };
        let b = match c.stderr.take() {
            Option::Some(s) => s.fd_take(),
            Option::None => -1,
        };
        let got = drain_two(a, b, &mut out, &mut err);
        close_fd(a);
        close_fd(b);
        let st = c.wait();
        if fg {
            restore_signals(c.pid);
        }
        got?;
        crate::result::Result::Ok(Output { status: st?, stdout: out, stderr: err })
    }

    // Starts it: a stream not set is dflt_in (stdin) or dflt_out (stdout
    // and stderr).
    fn spawn_with(&mut self, dflt_in: u8, dflt_out: u8, fg: bool) -> Result<Child> {
        if self.bad {
            return crate::result::Result::Err(Error::new(crate::io::ErrorKind::InvalidInput,
                "nul byte found in provided data"));
        }
        let kinds = [
            if self.stdin == DEFAULT { dflt_in } else { self.stdin },
            if self.stdout == DEFAULT { dflt_out } else { self.stdout },
            if self.stderr == DEFAULT { dflt_out } else { self.stderr },
        ];
        // ends.fds: [0..3) the parent's ends, [3..6) the child's, [6] /dev/null
        let mut ends = Ends { fds: [-1; 7] };
        let mut acts = spawn_actions()?;
        let mut k: usize = 0;
        while k < 3 {
            if kinds[k] == PIPED {
                let (r, w) = pipe()?;
                if k == 0 {
                    ends.fds[0] = w;
                    ends.fds[3] = r;
                } else {
                    ends.fds[k] = r;
                    ends.fds[3 + k] = w;
                }
                acts.dup2(ends.fds[3 + k], k as i32)?;
            } else if kinds[k] == NULL {
                if ends.fds[6] < 0 {
                    // UNSAFE: C's open. SAFETY: a NUL-ended literal.
                    let fd = unsafe { pr_c_open(b"/dev/null\0".as_ptr(), O_RDWR) };
                    if fd < 0 {
                        return crate::result::Result::Err(Error::last_os_error());
                    }
                    // UNSAFE: C's fcntl. SAFETY: an int.
                    unsafe { pr_c_fcntl(fd, F_SETFD, FD_CLOEXEC) };
                    ends.fds[6] = fd;
                }
                acts.dup2(ends.fds[6], k as i32)?;
            }
            k += 1;
        }
        let attr = if fg { Option::Some(sigdefault_attr()?) } else { Option::None };
        let a = self.text.allocator().clone();
        // argv: a pointer to each NUL-ended string of text, then null
        let mut argv: Vec<*const u8, A> = Vec::with_capacity_in(self.argc + 1, a.clone());
        let base = self.text.as_ptr();
        let mut at: usize = 0;
        while at < self.text.len() {
            // UNSAFE: a pointer into text. SAFETY: at < text.len(): in
            // bounds; text is not changed while argv is used.
            argv.push(unsafe { base.add(at) });
            while self.text[at] != 0 {
                at += 1;
            }
            at += 1;
        }
        argv.push(crate::ptr::null());
        let envp = self.envp(a);
        if fg {
            ignore_signals();
        }
        let mut pid: i32 = 0;
        let attr_p: *const u64 = match &attr {
            Option::Some(t) => &t.words[0] as *const u64,
            Option::None => crate::ptr::null(),
        };
        // UNSAFE: C's posix_spawnp.
        // SAFETY: argv's pointers are text's NUL-ended strings, then null;
        // envp is null (this process's environ) or environ's strings, then
        // null; acts is initialized, attr_p null or an initialized attr;
        // all live past the call.
        let r = unsafe {
            pr_c_spawnp(&mut pid as *mut i32, argv[0], &acts.words[0] as *const u64, attr_p,
                argv.as_ptr(),
                if envp.is_empty() { crate::__sys::environ() } else { envp.as_ptr() })
        };
        if r != 0 {
            if fg {
                restore_signals(0);
            }
            return crate::result::Result::Err(Error::from_raw_os_error(r));
        }
        let stdin = if ends.fds[0] >= 0 { Option::Some(ChildStdin { fd: ends.take(0) }) }
            else { Option::None };
        let stdout = if ends.fds[1] >= 0 { Option::Some(ChildStdout { fd: ends.take(1) }) }
            else { Option::None };
        let stderr = if ends.fds[2] >= 0 { Option::Some(ChildStderr { fd: ends.take(2) }) }
            else { Option::None };
        crate::result::Result::Ok(Child { pid: pid, status: Option::None, stdin: stdin,
            stdout: stdout, stderr: stderr })
    }

    // The child's environment when env_remove named a variable: environ's
    // strings but those, then null; empty (environ itself) when it named
    // none.
    fn envp(&self, a: A) -> Vec<*const u8, A> {
        let mut out: Vec<*const u8, A> = Vec::new_in(a);
        if self.removed.is_empty() {
            return out;
        }
        let env = crate::__sys::environ();
        let mut i: usize = 0;
        loop {
            // UNSAFE: environ's i-th pointer and its string.
            // SAFETY: environ is null-ended; i stops at its null; each
            // string is NUL-ended and is not changed while this runs
            // (std2's set_var is unsafe for that reason).
            let e = unsafe { *env.add(i) };
            if e.is_null() {
                break;
            }
            let mut keep = true;
            let mut s: usize = 0;
            while s < self.removed.len() {
                let mut n: usize = 0;
                while self.removed[s + n] != 0 {
                    n += 1;
                }
                // UNSAFE: e's bytes, each read before its NUL.
                // SAFETY: the loop stops at e's NUL or at the name's end.
                let same = unsafe {
                    let mut j: usize = 0;
                    while j < n && *e.add(j) != 0 && *e.add(j) == self.removed[s + j] {
                        j += 1;
                    }
                    j == n && *e.add(n) == 61
                };
                if same {
                    keep = false;
                }
                s += n + 1;
            }
            if keep {
                out.push(e);
            }
            i += 1;
        }
        out.push(crate::ptr::null());
        out
    }
}

impl ChildStdout {
    fn fd_take(self) -> i32 {
        let fd = self.fd;
        crate::mem::forget(self);
        fd
    }
}

impl ChildStderr {
    fn fd_take(self) -> i32 {
        let fd = self.fd;
        crate::mem::forget(self);
        fd
    }
}

// SIGINT's and SIGQUIT's dispositions while a foreground child runs.
static mut SIG_WAS: [usize; 2] = [0, 0];

fn ignore_signals() {
    // UNSAFE: C's signal, and the static the old dispositions go in.
    // SAFETY: SIG_IGN is a disposition, not code; SIG_WAS is written here
    // and read by restore_signals, on the thread that runs the Command
    // (a foreground Command is run by one thread at a time: volec run).
    unsafe {
        SIG_WAS[0] = pr_c_signal(SIGINT, SIG_IGN);
        SIG_WAS[1] = pr_c_signal(SIGQUIT, SIG_IGN);
    }
}

fn restore_signals(_pid: i32) {
    // UNSAFE: C's signal with the dispositions ignore_signals saved.
    // SAFETY: each is what signal returned (SIG_DFL, SIG_IGN or a handler
    // of this process, still loaded); SIG_ERR means nothing was changed.
    unsafe {
        if SIG_WAS[0] != SIG_ERR {
            pr_c_signal(SIGINT, SIG_WAS[0]);
        }
        if SIG_WAS[1] != SIG_ERR {
            pr_c_signal(SIGQUIT, SIG_WAS[1]);
        }
    }
}

// Reads the pipes a and b (-1: none) to their ends, into va and vb (poll:
// neither child stream blocks the other).
fn drain_two<A: Allocator>(a: i32, b: i32, va: &mut Vec<u8, A>, vb: &mut Vec<u8, A>) -> Result<()> {
    let mut open_a = a >= 0;
    let mut open_b = b >= 0;
    let mut buf = [0u8; 8192];
    while open_a || open_b {
        let mut fds = [
            PollFd { fd: if open_a { a } else { -1 }, events: POLLIN, revents: 0 },
            PollFd { fd: if open_b { b } else { -1 }, events: POLLIN, revents: 0 },
        ];
        // UNSAFE: C's poll. SAFETY: fds is a local array of 2 pollfds.
        if unsafe { pr_c_poll(&mut fds[0] as *mut PollFd, 2, -1) } < 0 {
            let e = Error::last_os_error();
            if e.raw_os_error() == Option::Some(EINTR) {
                continue;
            }
            return crate::result::Result::Err(e);
        }
        if open_a && fds[0].revents != 0 {
            let n = crate::io::sys_read(a, &mut buf)?;
            va.extend_from_slice(&buf[..n]);
            open_a = n > 0;
        }
        if open_b && fds[1].revents != 0 {
            let n = crate::io::sys_read(b, &mut buf)?;
            vb.extend_from_slice(&buf[..n]);
            open_b = n > 0;
        }
    }
    crate::result::Result::Ok(())
}

// Ends this process with code (Rust's: no destructors run).
#[effects(io, diverge, unsafe)]
pub fn exit(code: i32) -> ! {
    // UNSAFE: C's exit. SAFETY: an int; it does not return.
    unsafe { pr_c_exit(code) }
}

// Ends this process abnormally (SIGABRT).
#[effects(io, diverge, unsafe)]
pub fn abort() -> ! {
    // UNSAFE: C's abort. SAFETY: no arguments; it does not return.
    unsafe { pr_c_abort() }
}

// This process's id.
// std2: changed: a u32, as Rust's (MVS: i32)
#[effects(io, unsafe)]
pub fn id() -> u32 {
    // UNSAFE: C's getpid. SAFETY: no arguments.
    unsafe { pr_c_getpid() as u32 }
}
