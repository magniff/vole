// std::process (0.20, docs/design/collections-text-io.md §2.6.3, task
// B6): running programs, with Rust's names, through posix_spawnp
// (std::sys). A Command keeps its program and its first 32 arguments as
// views, inline, and builds argv on the stack when it runs, so
// `Command::new(p)` allocates nothing; (0.25.5) more arguments, more than
// 4 KB of them, and `env_remove`'s names are kept in Vecs on C's
// allocator (Gpa), which the Command frees when it is dropped.
// `output_in(gpa)` puts what the child writes in Vecs on gpa. `c.arg(x)`
// changes c in place (Rust's `&mut Command`): `let mut c =
// Command::new("ls"); c.arg("-l"); let out = c.output_in(gpa)?;`.

use std::{Allocator, Display, Fmt, Gpa, Option, Vec};
use std::io::error::{ErrorKind, Result, __io_error, __os_error};
use std::sys::{
    SYS_EINTR, SYS_O_RDWR, SYS_POLLIN, SYS_SIGINT, SYS_SIGQUIT, SysPollFd, SysSpawnActions,
    SysSpawnAttr, sys_close, sys_env_at, sys_env_count, sys_exit_code, sys_exit_signal, sys_kill,
    sys_open, sys_pipe, sys_poll, sys_read, sys_signal_ignore, sys_signal_restore,
    sys_spawn_actions, sys_spawn_attr, sys_spawn_sigdefault, sys_waitpid,
};

// ---- Processes (0.20) ----

const MAX_ARGS: i64 = 32;
const ARG_TEXT: i64 = 4096;

// What a child's stdin, stdout or stderr is: this process's (inherit),
// /dev/null (null), or a pipe to this process (piped: output_in's).
#[derive(Eq, Debug, Clone)]
pub enum Stdio { Inherit, Null, Piped }

impl Stdio {
    pub fn inherit() -> Stdio { Stdio::Inherit }
    pub fn null() -> Stdio { Stdio::Null }
    pub fn piped() -> Stdio { Stdio::Piped }
}

// A program to run, its arguments, its environment and its streams.
// (0.25.5: owned, as it holds Vecs; a Command moves, as Rust's does not
// copy.)
pub struct Command {
    prog: [u8],
    args: [[u8]; 32],
    count: i64,
    // (the arguments after the first 32)
    more: Vec<[u8], Gpa>,
    // (env_remove's names)
    removed: Vec<[u8], Gpa>,
    stdin: Stdio,
    stdout: Stdio,
    stderr: Stdio,
    foreground: bool,
}

// How a child ended: its exit code, or the signal that ended it.
#[derive(Eq, Debug, Clone)]
pub struct ExitStatus { status: i32 }

impl ExitStatus {
    // Whether it exited with 0.
    pub fn success(self) -> bool {
        match sys_exit_code(self.status) {
            Option::Some(c) => c == 0,
            Option::None => false,
        }
    }

    // Its exit code (None when a signal ended it).
    pub fn code(self) -> Option<i32> {
        sys_exit_code(self.status)
    }

    // The signal that ended it.
    pub fn signal(self) -> Option<i32> {
        sys_exit_signal(self.status)
    }
}

impl Display for ExitStatus {
    fn fmt(self, f: inout Fmt) {
        match sys_exit_code(self.status) {
            Option::Some(c) => {
                f.str("exit status: ");
                f.int(c as i64);
            }
            Option::None => {
                f.str("signal: ");
                f.int(self.status as i64 & 0x7f);
            }
        }
    }
}

// What output_in returns: how the child ended, and what it wrote.
pub struct Output<A: Allocator> {
    pub status: ExitStatus, pub stdout: Vec<u8, A>, pub stderr: Vec<u8, A>,
}

// A running child: wait for it (dropping it does not).
pub struct Child { pid: i32, done: bool, status: i32 }

impl Child {
    pub fn id(self) -> i32 {
        self.pid
    }

    // Waits for it to end.
    pub fn wait(inout self) -> Result<ExitStatus> {
        if self.done {
            return Ok(ExitStatus { status: self.status });
        }
        let st = wait_pid(self.pid)?;
        self.done = true;
        self.status = st;
        Ok(ExitStatus { status: st })
    }

    // How it ended, if it has: None while it runs.
    pub fn try_wait(inout self) -> Result<Option<ExitStatus>> {
        if self.done {
            return Ok(Option::Some(ExitStatus { status: self.status }));
        }
        match sys_waitpid(self.pid, true) {
            Ok((p, st)) => {
                if p == 0 {
                    return Ok(Option::None);
                }
                self.done = true;
                self.status = st;
                Ok(Option::Some(ExitStatus { status: st }))
            }
            Err(e) => Err(__os_error(e)),
        }
    }

    // Sends it SIGKILL.
    pub fn kill(inout self) -> Result<()> {
        match sys_kill(self.pid, 9) {
            Ok(_) => Ok(()),
            Err(e) => Err(__os_error(e)),
        }
    }
}

// Waits for pid (again when a signal interrupts): its status.
fn wait_pid(pid: i32) -> Result<i32> {
    loop {
        match sys_waitpid(pid, false) {
            Ok((_, st)) => return Ok(st),
            Err(e) => {
                if e != SYS_EINTR {
                    return Err(__os_error(e));
                }
            }
        }
    }
}

// The NUL-ended copies of a command's program and arguments, and argv.
struct Argv { text: [u8; 4096], ptrs: [*u8; 34] }

impl Command {
    // Runs prog: a path, or a name looked up in PATH.
    pub fn new(prog: [u8]) -> Command {
        Command {
            prog: prog, args: [""; 32], count: 0, more: Vec::new_in(Gpa { _private: () }),
            removed: Vec::new_in(Gpa { _private: () }), stdin: Stdio::Inherit,
            stdout: Stdio::Inherit,
            stderr: Stdio::Inherit, foreground: false,
        }
    }

    // Adds an argument (0.25.5: any number of them).
    pub fn arg(inout self, a: [u8]) {
        if self.count < MAX_ARGS {
            self.args[self.count] = a;
            self.count += 1;
        } else {
            self.more.push(a);
        }
    }

    // (0.25.5) The child's environment is this process's without the
    // variable `name` (Rust's env_remove); each call removes one more.
    pub fn env_remove(inout self, name: [u8]) {
        self.removed.push(name);
    }

    // (0.25.5) Runs it as a shell runs a command in the foreground: while
    // status() or output_in() waits for it, this process ignores SIGINT
    // and SIGQUIT (^C and ^\ at a terminal, which reach both), and the
    // child starts with their default actions, so ^C ends the child and
    // this process sees how it ended (`volec run`). Not for spawn(): its
    // caller decides when to wait.
    pub fn foreground(inout self, on: bool) {
        self.foreground = on;
    }

    // Adds each of list.
    pub fn args(inout self, list: [[u8]]) {
        for a in list {
            self.arg(a);
        }
    }

    pub fn stdin(inout self, s: Stdio) {
        self.stdin = s;
    }

    pub fn stdout(inout self, s: Stdio) {
        self.stdout = s;
    }

    pub fn stderr(inout self, s: Stdio) {
        self.stderr = s;
    }

    // argv's length: the program's name and the arguments.
    fn argc(self) -> i64 {
        1 + self.count + self.more.len() as i64
    }

    // argv's k-th string (0: the program's name).
    fn arg_at(self, k: i64) -> [u8] {
        if k == 0 {
            self.prog
        } else if k <= MAX_ARGS {
            self.args[k - 1]
        } else {
            self.more[k - 1 - MAX_ARGS]
        }
    }

    // The bytes argv's strings take, their NULs included.
    fn argv_bytes(self) -> i64 {
        var n = 0;
        for k in 0..self.argc() {
            n += self.arg_at(k).len as i64 + 1;
        }
        n
    }

    // argv for C, its strings in text and its pointers in ptrs (both of
    // the room argc and argv_bytes ask): InvalidInput when one holds a NUL.
    fn build_argv(self, text: inout [u8], ptrs: inout [*u8]) -> Result<()> {
        var at = 0;
        let n = self.argc();
        for k in 0..n {
            let s = self.arg_at(k);
            for i in 0..s.len as i64 {
                if s[i] == 0 {
                    return Err(__io_error(ErrorKind::InvalidInput, "an argument holds a NUL"));
                }
                text[at + i] = s[i];
            }
            text[at + s.len as i64] = 0;
            at += s.len as i64 + 1;
        }
        // (the pointers once text is written: text is the caller's, and
        // lives as long as ptrs does)
        at = 0;
        for k in 0..n {
            ptrs[k] = text[at..at + 1].ptr;
            at += self.arg_at(k).len as i64 + 1;
        }
        ptrs[n] = 0 as *u8;
        Ok(())
    }

    // The child's environment for C when env_remove named a variable:
    // this process's variables but those, as pointers to their C strings,
    // ending with a null one; empty (this process's environment) when it
    // named none.
    fn envp(self) -> Vec<*u8, Gpa> {
        var out: Vec<*u8, Gpa> = Vec::new_in(Gpa { _private: () });
        if self.removed.len() as i64 == 0 {
            return out;
        }
        for i in 0..sys_env_count() {
            let e = sys_env_at(i);
            var keep = true;
            for name in self.removed.as_slice() {
                if e.len as i64 > name.len as i64 && e[name.len as i64] == '='
                    && e[0..name.len as i64] == name {
                    keep = false;
                }
            }
            if keep {
                // (environ's string: NUL-ended, sys_env_at's view starts it)
                out.push(e.ptr);
            }
        }
        out.push(0 as *u8);
        out
    }

    // Starts it with the streams as set (piped ones are not supported
    // here: output_in pipes stdout and stderr).
    pub fn spawn(self) -> Result<Child> {
        var acts = os(sys_spawn_actions())?;
        var null: i32 = -1;
        let r = self.spawn_with(&acts, &null, -1, -1);
        acts.free();
        if null >= 0 {
            let _ = sys_close(null);
        }
        let pid = r?;
        Ok(Child { pid: pid, done: false, status: 0 })
    }

    // Runs it, waits for it: how it ended.
    pub fn status(self) -> Result<ExitStatus> {
        if self.foreground {
            let int_was = sys_signal_ignore(SYS_SIGINT);
            let quit_was = sys_signal_ignore(SYS_SIGQUIT);
            let r = self.status_now();
            sys_signal_restore(int_was);
            sys_signal_restore(quit_was);
            return r;
        }
        self.status_now()
    }

    fn status_now(self) -> Result<ExitStatus> {
        var c = self.spawn()?;
        c.wait()
    }

    // Runs it with stdout and stderr piped to this process (stdin
    // inherited), and waits: how it ended and what it wrote, in Vecs on a.
    pub fn output_in<A: Allocator>(self, a: sink A) -> Result<Output<A>> {
        if self.foreground {
            let int_was = sys_signal_ignore(SYS_SIGINT);
            let quit_was = sys_signal_ignore(SYS_SIGQUIT);
            let r = self.output_now(a);
            sys_signal_restore(int_was);
            sys_signal_restore(quit_was);
            return r;
        }
        self.output_now(a)
    }

    fn output_now<A: Allocator>(self, a: sink A) -> Result<Output<A>> {
        let (out_r, out_w) = os(sys_pipe())?;
        let (err_r, err_w) = match sys_pipe() {
            Ok(p) => p,
            Err(e) => {
                let _ = sys_close(out_r);
                let _ = sys_close(out_w);
                return Err(__os_error(e));
            }
        };
        var acts = os(sys_spawn_actions())?;
        var null: i32 = -1;
        let r = self.spawn_with(&acts, &null, out_w, err_w);
        acts.free();
        let _ = sys_close(out_w);
        let _ = sys_close(err_w);
        if null >= 0 {
            let _ = sys_close(null);
        }
        let pid = match r {
            Ok(p) => p,
            Err(e) => {
                let _ = sys_close(out_r);
                let _ = sys_close(err_r);
                return Err(e);
            }
        };
        var stdout: Vec<u8, A> = Vec::new_in(a);
        var stderr: Vec<u8, A> = Vec::new_in(a);
        let got = drain_two(out_r, err_r, &stdout, &stderr);
        let _ = sys_close(out_r);
        let _ = sys_close(err_r);
        let st = wait_pid(pid)?;
        got?;
        Ok(Output { status: ExitStatus { status: st }, stdout: stdout, stderr: stderr })
    }

    // Spawns it with the file actions for its streams in acts (out_w,
    // err_w: pipes for stdout and stderr, or -1); /dev/null, when one is
    // Null, opened into *null.
    fn spawn_with(self, acts: inout SysSpawnActions, null: inout i32, out_w: i32,
        err_w: i32) -> Result<i32> {
        let wants_null = self.stdin == Stdio::Null || self.stdout == Stdio::Null
            || self.stderr == Stdio::Null;
        if wants_null {
            let fd = os(sys_open("/dev/null", SYS_O_RDWR, 0))?;
            null = fd;
        }
        let nfd = null;
        if self.stdin == Stdio::Null {
            os(acts.dup2(nfd, 0))?;
        }
        if out_w >= 0 {
            os(acts.dup2(out_w, 1))?;
        } else if self.stdout == Stdio::Null {
            os(acts.dup2(nfd, 1))?;
        }
        if err_w >= 0 {
            os(acts.dup2(err_w, 2))?;
        } else if self.stderr == Stdio::Null {
            os(acts.dup2(nfd, 2))?;
        }
        // (the child's default SIGINT and SIGQUIT, which a foreground
        // Command's waiter ignores)
        var attr: SysSpawnAttr = os(sys_spawn_sigdefault([SYS_SIGINT, SYS_SIGQUIT][..]))?;
        let envp = self.envp();
        let n = self.argc();
        let bytes = self.argv_bytes();
        if n < MAX_ARGS + 2 && bytes <= ARG_TEXT {
            var argv = Argv { text: [0; 4096], ptrs: [0 as *u8; 34] };
            self.build_argv(&argv.text[..], &argv.ptrs[..])?;
            // UNSAFE: sys_spawn reads C strings. SAFETY: build_argv made
            // argv's strings NUL-ended and its pointers null-ended (prog is
            // ptrs[0]); envp is empty or environ's strings, null-ended
            // (envp); acts and attr are live.
            let r = unsafe {
                sys_spawn_attr(argv.ptrs[0], argv.ptrs[..n + 1], envp.as_slice(), &acts, &attr)
            };
            return os(r);
        }
        // (0.25.5: more than 32 arguments or 4 KB of them: on the heap)
        var text: Vec<u8, Gpa> = Vec::filled_in(bytes as usize, 0u8, Gpa { _private: () });
        var ptrs: Vec<*u8, Gpa> = Vec::with_capacity_in(n as usize + 1, Gpa { _private: () });
        for _ in 0..n + 1 {
            ptrs.push(0 as *u8);
        }
        self.build_argv(text.as_mut_slice(), ptrs.as_mut_slice())?;
        // UNSAFE: as above. SAFETY: as above; text and ptrs live to the call's end.
        let r = unsafe { sys_spawn_attr(ptrs[0], ptrs.as_slice(), envp.as_slice(), &acts, &attr) };
        os(r)
    }
}

// The Result of a sys call, its errno an io::Error.
#[inline]
fn os<T>(r: sink std::Result<T, i32>) -> Result<T> {
    match r {
        Ok(v) => Ok(v),
        Err(e) => Err(__os_error(e)),
    }
}

// Reads the pipes a and b to their ends, into va and vb (poll: neither
// child stream blocks the other).
fn drain_two<A: Allocator>(a: i32, b: i32, va: inout Vec<u8, A>, vb: inout Vec<u8, A>)
    -> Result<()> {
    var open_a = true;
    var open_b = true;
    while open_a || open_b {
        var fds: [SysPollFd; 2] = [
            SysPollFd { fd: if open_a { a } else { -1 }, events: SYS_POLLIN, revents: 0 },
            SysPollFd { fd: if open_b { b } else { -1 }, events: SYS_POLLIN, revents: 0 },
        ];
        match sys_poll(&fds[..], -1) {
            Ok(_) => {}
            Err(e) => {
                if e == SYS_EINTR {
                    continue;
                }
                return Err(__os_error(e));
            }
        }
        if open_a && fds[0].revents != 0 {
            open_a = read_some(a, &va)?;
        }
        if open_b && fds[1].revents != 0 {
            open_b = read_some(b, &vb)?;
        }
    }
    Ok(())
}

// Reads what fd has into v: false at its end.
fn read_some<A: Allocator>(fd: i32, v: inout Vec<u8, A>) -> Result<bool> {
    if v.cap - v.len < 4096 {
        v.reserve(if v.cap < 8192 { 8192 } else { v.cap as usize });
    }
    // (v's room: its capacity past its length)
    // UNSAFE: a slice of the Vec's raw room. SAFETY: ptr[len..cap] is v's
    // room (Vec's invariant), bytes; len counts only what read wrote.
    let room = unsafe { v.ptr[v.len..v.cap] };
    match sys_read(fd, &room) {
        Ok(n) => {
            v.len += n;
            Ok(n > 0)
        }
        Err(e) => if e == SYS_EINTR { Ok(true) } else { Err(__os_error(e)) },
    }
}

// Ends this process with code (Rust's `std::process::exit`); what print
// buffered is written out first.
pub fn exit(code: i32) -> ! {
    std::fmt::__flush_print();
    // UNSAFE: C's exit. SAFETY: it takes an int and does not return.
    unsafe { std::exit(code) }
}

// This process's id.
pub fn id() -> i32 {
    std::sys::sys_getpid()
}
