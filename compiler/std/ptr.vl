// std::ptr: NonNull and the raw-pointer functions std's bodies use. A raw
// pointer is `*const T` or `*mut T` (plan §5); reading or writing through
// one is unsafe, and its SAFETY comment says why it is sound.

use crate::clone::Clone;
use crate::cmp::{Eq, PartialEq};
use crate::marker::PhantomData;
use crate::option::Option;

// A *mut T that is never null: what a container keeps (Option<NonNull<T>>
// is one word). Covariant in T, as Rust's.
// mvs: NonNull
// std2: changed: a struct over *const T (MVS: a distinct *T with an invariant)
pub struct NonNull<T: ?Sized> {
    pointer: *const T,
}

impl<T> NonNull<T> {
    // p as a NonNull; None when it is null.
    // std2: changed: takes *mut T
    #[effects()]
    pub fn new(p: *mut T) -> Option<NonNull<T>> {
        if p.is_null() { Option::None } else { Option::Some(NonNull { pointer: p as *const T }) }
    }

    // A pointer that is not null and is aligned, for a zero-sized T or an
    // empty container: it is never read.
    #[effects(unsafe)]
    pub fn dangling() -> NonNull<T> {
        NonNull { pointer: crate::mem::align_of::<T>() as *const T }
    }

    // The pointer.
    // std2: changed: returns *mut T
    #[effects()]
    pub fn as_ptr(self) -> *mut T {
        self.pointer as *mut T
    }

    // The value it points at, as a reference. The caller says the pointer
    // is valid and aligned, the value initialized, and nothing writes it
    // for 'a.
    #[effects(unsafe)]
    // UNSAFE: the caller vouches for the pointer's target and its lifetime.
    // SAFETY: a contract on the caller, as Rust's NonNull::as_ref.
    pub unsafe fn as_ref<'a>(&self) -> &'a T {
        &*self.pointer
    }

    // The same, mutable: nothing else reads or writes it for 'a.
    #[effects(unsafe)]
    // UNSAFE: the caller vouches for the pointer's target and its lifetime.
    // SAFETY: a contract on the caller, as Rust's NonNull::as_mut.
    pub unsafe fn as_mut<'a>(&mut self) -> &'a mut T {
        &mut *(self.pointer as *mut T)
    }

    // A pointer to a U at the same address.
    #[effects()]
    pub fn cast<U>(self) -> NonNull<U> {
        NonNull { pointer: self.pointer as *const U }
    }

    // The pointer count elements on (inside one allocation).
    #[effects(unsafe)]
    // UNSAFE: an offset out of the allocation is undefined.
    // SAFETY: a contract on the caller, as Rust's NonNull::add.
    pub unsafe fn add(self, count: usize) -> NonNull<T> {
        // Built in (Rust's ptr::add): vole's raw-pointer arithmetic, `&p[i]`.
        NonNull { pointer: &self.pointer[count] as *const T }
    }
}

impl<T: ?Sized> Clone for NonNull<T> {
    fn clone(&self) -> NonNull<T> {
        *self
    }
}

impl<T: ?Sized> Copy for NonNull<T> {}

impl<T: ?Sized> PartialEq for NonNull<T> {
    fn eq(&self, other: &NonNull<T>) -> bool {
        self.pointer == other.pointer
    }
}

impl<T: ?Sized> Eq for NonNull<T> {}

// A null *const T.
#[effects()]
pub fn null<T>() -> *const T {
    0 as *const T
}

// A null *mut T.
#[effects()]
pub fn null_mut<T>() -> *mut T {
    0 as *mut T
}

// The T at src, moved out bit for bit (src is left as it was: the caller
// makes sure only one of the two is dropped).
#[inline]
#[effects(unsafe)]
// UNSAFE: reads through a raw pointer.
// SAFETY: a contract on the caller: src valid, aligned, initialized.
pub unsafe fn read<T>(src: *const T) -> T {
    // Built in: a raw read moves the bits out and drops nothing.
    src[0]
}

// Moves value into dst without dropping what was there.
#[inline]
#[effects(unsafe)]
// UNSAFE: writes through a raw pointer.
// SAFETY: a contract on the caller: dst valid and aligned.
pub unsafe fn write<T>(dst: *mut T, value: T) {
    // Built in: a raw store writes the bits and drops nothing.
    dst[0] = value;
}

// UNSAFE: C's block routines, over raw memory.
// SAFETY: the prototypes are string.h's; each call below says why its
// ranges are valid.
extern "C" {
    #[link_name = "memcpy"]
    fn ptr_c_memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;
    #[link_name = "memmove"]
    fn ptr_c_memmove(d: *mut u8, s: *const u8, n: usize) -> *mut u8;
    #[link_name = "memset"]
    fn ptr_c_memset(d: *mut u8, c: i32, n: usize) -> *mut u8;
    #[link_name = "memcmp"]
    fn ptr_c_memcmp(a: *const u8, b: *const u8, n: usize) -> i32;
    #[link_name = "memchr"]
    fn ptr_c_memchr(s: *const u8, c: i32, n: usize) -> *const u8;
}

// (0.29) From this many elements on a copy is C's (one call, the bytes
// moved as words and vectors); below it, the loop: a call costs more
// than moving one to three elements (mem::swap's one, a sort's).
const BLOCK_MIN: usize = 4;

// count T's from src to dst; the two may overlap (memmove).
#[effects(diverge, unsafe)]
// UNSAFE: reads and writes through raw pointers.
// SAFETY: a contract on the caller: both ranges valid and aligned.
pub unsafe fn copy<T>(src: *const T, dst: *mut T, count: usize) {
    let size = crate::mem::size_of::<T>();
    if size == 0 {
        // (a zero-sized T has no bytes to move, and its pointers are
        // dangling: C is given none of them)
        return;
    }
    if count >= BLOCK_MIN {
        // The caller's two ranges are count T's each, count * size bytes;
        // memmove allows their overlap.
        ptr_c_memmove(dst as *mut u8, src as *const u8, count * size);
        return;
    }
    // Forward when dst is below src, backward otherwise: overlap is safe.
    if (dst as *const T as usize) <= (src as usize) {
        let mut i: usize = 0;
        while i < count {
            dst[i] = src[i];
            i += 1;
        }
    } else {
        let mut i = count;
        while i > 0 {
            i -= 1;
            dst[i] = src[i];
        }
    }
}

// count T's from src to dst, which do not overlap (memcpy).
#[effects(diverge, unsafe)]
// UNSAFE: reads and writes through raw pointers.
// SAFETY: a contract on the caller: both ranges valid, aligned, disjoint.
pub unsafe fn copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {
    let size = crate::mem::size_of::<T>();
    if size == 0 {
        // (as copy: nothing to move, and no dangling pointer given to C)
        return;
    }
    if count >= BLOCK_MIN {
        // The caller's two ranges are count T's each, count * size bytes,
        // and disjoint, as memcpy asks.
        ptr_c_memcpy(dst as *mut u8, src as *const u8, count * size);
        return;
    }
    let mut i: usize = 0;
    while i < count {
        dst[i] = src[i];
        i += 1;
    }
}

// (0.29) count copies of *x written from dst on, as a block: a byte-sized
// T by memset; a larger one written a few times, then what is filled
// copied onto what is not, twice as much each time (a handful of memcpy
// calls for any count). The bits of *x are duplicated, nothing is cloned
// or dropped: for a Copy T (mem::is_copy), as Vec::resize and [T]::fill
// use it.
#[effects(diverge, unsafe)]
// UNSAFE: writes through a raw pointer.
// SAFETY: a contract on the caller: dst valid and aligned for count T's,
// which x is no part of; a T that may be duplicated bit for bit.
pub(crate) unsafe fn fill_copies<T>(dst: *mut T, count: usize, x: &T) {
    let size = crate::mem::size_of::<T>();
    if size == 0 {
        // (nothing to write)
        return;
    }
    let src = x as *const T;
    if size == 1 {
        // x is one readable byte (a reference to a T of size 1); dst has
        // count writable bytes (the caller's).
        ptr_c_memset(dst as *mut u8, (src as *const u8)[0] as i32, count);
        return;
    }
    let head = if count < 8 { count } else { 8 };
    let mut i: usize = 0;
    while i < head {
        dst[i] = src[0];
        i += 1;
    }
    while i < count {
        // [0, i) is filled; the next k <= i elements, [i, i + k), are
        // inside the caller's range (k <= count - i) and past [0, k).
        let k = if count - i < i { count - i } else { i };
        ptr_c_memcpy(dst.add(i) as *mut u8, dst as *const u8, k * size);
        i += k;
    }
}

// (0.29) Whether the n bytes at a and at b are the same (memcmp).
#[effects(unsafe)]
// UNSAFE: reads through raw pointers.
// SAFETY: a contract on the caller: n readable bytes at each.
pub(crate) unsafe fn bytes_equal(a: *const u8, b: *const u8, n: usize) -> bool {
    ptr_c_memcmp(a, b, n) == 0
}

// (0.29) The index of the first byte x among the n at p (memchr).
#[effects(unsafe)]
// UNSAFE: reads through a raw pointer.
// SAFETY: a contract on the caller: n readable bytes at p.
pub(crate) unsafe fn byte_index(p: *const u8, n: usize, x: u8) -> Option<usize> {
    // memchr returns null or the address of one of the n bytes: at or
    // above p, below p + n.
    let q = ptr_c_memchr(p, x as i32, n);
    if q.is_null() { Option::None } else { Option::Some((q as usize) - (p as usize)) }
}

// Runs the drop of the value at p, in place.
#[effects(unsafe, T)]
// UNSAFE: drops through a raw pointer.
// SAFETY: a contract on the caller: p valid, its value initialized and
// not used again.
pub unsafe fn drop_in_place<T: ?Sized>(p: *mut T) {
    // The value moved out and dropped here.
    crate::mem::drop(read(p as *const T));
}

// Whether two pointers have the same address.
#[effects()]
pub fn eq<T: ?Sized>(a: *const T, b: *const T) -> bool {
    a == b
}

// std2: new: Rust's raw-pointer methods. vole's `*const T` and `*mut T`
// are one type (front-rust.md FR4), so one impl has them all.
impl<T> *const T {
    // Whether the pointer is null.
    #[effects()]
    pub fn is_null(self) -> bool {
        (self as usize) == 0
    }

    // The pointer count T's on (pointer arithmetic, Rust's `add`).
    #[effects(unsafe)]
    // UNSAFE: the result must stay in (or one past) the same allocation.
    // SAFETY: a contract on the caller, as Rust's.
    pub unsafe fn add(self, count: usize) -> *mut T {
        ((self as usize) + count * crate::mem::size_of::<T>()) as *mut T
    }

    // The pointer count T's back.
    // UNSAFE: as add.
    // SAFETY: a contract on the caller, as Rust's.
    #[effects(unsafe)]
    pub unsafe fn sub(self, count: usize) -> *mut T {
        ((self as usize) - count * crate::mem::size_of::<T>()) as *mut T
    }

    // The pointer count T's on, or back for a negative count.
    // UNSAFE: as add.
    // SAFETY: a contract on the caller, as Rust's.
    #[effects(unsafe, T)]
    pub unsafe fn offset(self, count: isize) -> *mut T {
        if count >= 0 { self.add(count as usize) } else { self.sub((0 - count) as usize) }
    }

    // The T it points to, moved out bit for bit (ptr::read).
    #[effects(unsafe, T)]
    // UNSAFE: reads through a raw pointer.
    // SAFETY: a contract on the caller: valid, aligned, initialized.
    pub unsafe fn read(self) -> T {
        read(self)
    }

    // value stored where it points, the old value not dropped (ptr::write).
    // UNSAFE: writes through a raw pointer.
    // SAFETY: a contract on the caller: valid and aligned.
    #[effects(unsafe, T)]
    pub unsafe fn write(self, value: T) {
        write(self as *mut T, value)
    }

    // The same address as a pointer to U.
    #[effects()]
    pub fn cast<U>(self) -> *mut U {
        self as *mut U
    }
}

// The n T's from p, as a slice: what slice::from_raw_parts makes. The raw
// slicing (MVS's) is legal in this module only (front-rust.md F30.3).
#[effects(unsafe)]
// UNSAFE: the slice's elements are read through p.
// SAFETY: a contract on the caller: p valid for n initialized T's for 'a.
pub(crate) unsafe fn slice_parts<'a, T>(p: *const T, n: usize) -> &'a [T] {
    &p[0..n]
}

// The same, mutable: slice::from_raw_parts_mut.
#[effects(unsafe)]
// UNSAFE: the slice's elements are read and written through p.
// SAFETY: a contract on the caller: p valid for n T's for 'a, and not
// otherwise accessed for 'a.
pub(crate) unsafe fn slice_parts_mut<'a, T>(p: *mut T, n: usize) -> &'a mut [T] {
    &mut p[0..n]
}
