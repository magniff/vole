// std::window's Objective-C layer: a minimal stand-in for std::objc
// (docs/design/gpu.md §2.9, 0.22) until it lands. Everything here is replaced then: the message shapes by
// objcgen's generated, runtime-checked wrappers (tables appkit.objc and
// quartzcore.objc, owned by W1), `Id` by `Id<T>`/`Ref<T>`, the pool
// functions by `objc::pool`, the class functions by `ClassBuilder`.
//
// One typed declaration per selector shape (`#[link_name =
// "objc_msgSend"]`): on arm64 objc_msgSend is a trampoline that keeps
// every argument register and x8, so a call through a declaration whose
// C types match the method's is exactly the call clang emits. The shapes
// are named by their result and arguments: p a pointer (an object, a
// selector, a C string), v void, u u64, i i64, h u16, b BOOL, d f64,
// r a rect (4 f64, an HFA in v0-v3), z a size and t a point (2 f64), g
// an NSRange (2 u64 in x0/x1), c a clear colour (4 f64), m an MTLRegion
// (48 bytes, passed by reference).
//
// Every caller is `unsafe`: a shape used with a selector whose types it
// does not match is undefined behaviour. The callers are cocoa.vl and
// voltty's renderer (its copy), each call with the selector's documented
// types, listed in tables/*.objc and checked against the runtime.

// ---- The Objective-C layer (0.23) ----

#[derive(Clone, Copy)] #[repr(C)]
pub struct Point {
    pub x: f64,
    pub y: f64,
}

#[derive(Clone, Copy)] #[repr(C)]
pub struct Size {
    pub w: f64,
    pub h: f64,
}

#[derive(Clone, Copy)] #[repr(C)]
pub struct Rect {
    pub x: f64,
    pub y: f64,
    pub w: f64,
    pub h: f64,
}

#[derive(Clone, Copy)] #[repr(C)]
pub struct Range {
    pub loc: u64,
    pub len: u64,
}

// The method-description pair protocol_getMethodDescription returns
// (16 bytes, in x0/x1).
#[derive(Clone, Copy)] #[repr(C)]
pub struct MethodDesc {
    pub name: *mut u8,
    pub types: *mut u8,
}

// NSNotFound, the location of an empty NSRange.
pub const NOT_FOUND: u64 = 0x7fffffffffffffff;

// UNSAFE: the Objective-C runtime's C functions, and objc_msgSend once per message shape.
// SAFETY: the runtime functions' prototypes are objc/runtime.h's; each msg_ shape is the C
// prototype of the selectors that use it (tables/*.objc lists them, checked against the
// runtime's encodings), so a call through it is the call clang emits (see above).
#[link(lib = "objc")]
pub extern "C" {
    #[effects(io)]
    fn objc_getClass(name: *mut u8) -> *mut u8;
    #[effects(io)]
    fn objc_getProtocol(name: *mut u8) -> *mut u8;
    #[effects(io)]
    fn sel_registerName(name: *mut u8) -> *mut u8;
    #[effects(io)]
    fn objc_allocateClassPair(superclass: *mut u8, name: *mut u8, extra: u64) -> *mut u8;
    #[effects(io)]
    fn objc_registerClassPair(cls: *mut u8);
    #[effects(io)]
    fn class_addProtocol(cls: *mut u8, protocol: *mut u8) -> bool;
    #[effects(io)]
    fn class_addIvar(cls: *mut u8, name: *mut u8, size: u64, align_log2: u8, types: *mut u8) -> bool;
    #[effects(io)]
    fn class_getInstanceVariable(cls: *mut u8, name: *mut u8) -> *mut u8;
    #[effects(io)]
    fn class_getInstanceMethod(cls: *mut u8, sel: *mut u8) -> *mut u8;
    #[effects(io)]
    fn method_getTypeEncoding(m: *mut u8) -> *mut u8;
    #[effects(io)]
    fn ivar_getOffset(ivar: *mut u8) -> i64;
    #[effects(io)]
    fn protocol_getMethodDescription(p: *mut u8, sel: *mut u8, required: bool, instance: bool) -> MethodDesc;
    #[effects(io)]
    fn objc_autoreleasePoolPush() -> *mut u8;
    #[effects(io)]
    fn objc_autoreleasePoolPop(pool: *mut u8);
    #[effects(io)]
    fn objc_retain(o: *mut u8) -> *mut u8;
    #[effects(io)]
    fn objc_release(o: *mut u8);

    #[link_name = "objc_msgSend"]
    fn msg_p(o: *mut u8, s: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_p(o: *mut u8, s: *mut u8, a: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_ppp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8, c: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_u(o: *mut u8, s: *mut u8, a: u64) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_uu(o: *mut u8, s: *mut u8, a: u64, b: u64) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_d(o: *mut u8, s: *mut u8, a: f64) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_r(o: *mut u8, s: *mut u8, a: Rect) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_ruub(o: *mut u8, s: *mut u8, a: Rect, b: u64, c: u64, d: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_rupp(o: *mut u8, s: *mut u8, a: Rect, b: u64, c: *mut u8, d: *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_uppb(o: *mut u8, s: *mut u8, a: u64, b: *mut u8, c: *mut u8, d: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_uuub(o: *mut u8, s: *mut u8, a: u64, b: u64, c: u64, d: bool) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_ppP(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8, err: *mut *mut u8) -> *mut u8;
    #[link_name = "objc_msgSend"]
    fn msg_p_pP(o: *mut u8, s: *mut u8, a: *mut u8, err: *mut *mut u8) -> *mut u8;
    // otherEventWithType:location:modifierFlags:timestamp:windowNumber:
    // context:subtype:data1:data2:
    #[link_name = "objc_msgSend"]
    fn msg_p_utudipsii(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,
        ctx: *mut u8, sub: i16, d1: i64, d2: i64) -> *mut u8;
    // keyEventWithType:location:modifierFlags:timestamp:windowNumber:
    // context:characters:charactersIgnoringModifiers:isARepeat:keyCode:
    #[link_name = "objc_msgSend"]
    fn msg_p_utudipppbh(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,
        ctx: *mut u8, chars: *mut u8, plain: *mut u8, repeat: bool, code: u16) -> *mut u8;
    // mouseEventWithType:location:modifierFlags:timestamp:windowNumber:
    // context:eventNumber:clickCount:pressure:
    #[link_name = "objc_msgSend"]
    fn msg_p_utudipiif(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,
        ctx: *mut u8, num: i64, clicks: i64, pressure: f32) -> *mut u8;

    #[link_name = "objc_msgSend"]
    fn msg_v(o: *mut u8, s: *mut u8);
    #[link_name = "objc_msgSend"]
    fn msg_v_p(o: *mut u8, s: *mut u8, a: *mut u8);
    #[link_name = "objc_msgSend"]
    fn msg_v_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8);
    #[link_name = "objc_msgSend"]
    fn msg_v_pb(o: *mut u8, s: *mut u8, a: *mut u8, b: bool);
    #[link_name = "objc_msgSend"]
    fn msg_v_b(o: *mut u8, s: *mut u8, a: bool);
    #[link_name = "objc_msgSend"]
    fn msg_v_u(o: *mut u8, s: *mut u8, a: u64);
    #[link_name = "objc_msgSend"]
    fn msg_v_d(o: *mut u8, s: *mut u8, a: f64);
    #[link_name = "objc_msgSend"]
    fn msg_v_z(o: *mut u8, s: *mut u8, a: Size);
    #[link_name = "objc_msgSend"]
    fn msg_v_rp(o: *mut u8, s: *mut u8, a: Rect, b: *mut u8);
    #[link_name = "objc_msgSend"]
    fn msg_v_pu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64);
    #[link_name = "objc_msgSend"]
    fn msg_v_puu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64, c: u64);
    #[link_name = "objc_msgSend"]
    fn msg_v_uuuu(o: *mut u8, s: *mut u8, a: u64, b: u64, c: u64, d: u64);
    #[link_name = "objc_msgSend"]
    fn msg_v_c(o: *mut u8, s: *mut u8, a: ClearColor);
    #[link_name = "objc_msgSend"]
    fn msg_v_mupu(o: *mut u8, s: *mut u8, a: MtlRegion, b: u64, c: *mut u8, d: u64);
    #[link_name = "objc_msgSend"]
    fn msg_v_pumu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64, c: MtlRegion, d: u64);
    #[link_name = "objc_msgSend"]
    fn msg_v_pg(o: *mut u8, s: *mut u8, a: *mut u8, b: Range);
    #[link_name = "objc_msgSend"]
    fn msg_v_pgg(o: *mut u8, s: *mut u8, a: *mut u8, b: Range, c: Range);

    #[link_name = "objc_msgSend"]
    fn msg_u(o: *mut u8, s: *mut u8) -> u64;
    #[link_name = "objc_msgSend"]
    fn msg_u_u(o: *mut u8, s: *mut u8, a: u64) -> u64;
    #[link_name = "objc_msgSend"]
    fn msg_i(o: *mut u8, s: *mut u8) -> i64;
    #[link_name = "objc_msgSend"]
    fn msg_h(o: *mut u8, s: *mut u8) -> u16;
    #[link_name = "objc_msgSend"]
    fn msg_h_u(o: *mut u8, s: *mut u8, a: u64) -> u16;
    #[link_name = "objc_msgSend"]
    fn msg_b(o: *mut u8, s: *mut u8) -> bool;
    #[link_name = "objc_msgSend"]
    fn msg_b_p(o: *mut u8, s: *mut u8, a: *mut u8) -> bool;
    #[link_name = "objc_msgSend"]
    fn msg_b_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8) -> bool;
    #[link_name = "objc_msgSend"]
    fn msg_b_i(o: *mut u8, s: *mut u8, a: i64) -> bool;
    #[link_name = "objc_msgSend"]
    fn msg_d(o: *mut u8, s: *mut u8) -> f64;
    #[link_name = "objc_msgSend"]
    fn msg_t(o: *mut u8, s: *mut u8) -> Point;
    #[link_name = "objc_msgSend"]
    fn msg_r(o: *mut u8, s: *mut u8) -> Rect;
    #[link_name = "objc_msgSend"]
    fn msg_r_r(o: *mut u8, s: *mut u8, a: Rect) -> Rect;
    #[link_name = "objc_msgSend"]
    fn msg_r_rp(o: *mut u8, s: *mut u8, a: Rect, b: *mut u8) -> Rect;
    #[link_name = "objc_msgSend"]
    fn msg_g(o: *mut u8, s: *mut u8) -> Range;
    #[link_name = "objc_msgSend"]
    fn msg_r_gP(o: *mut u8, s: *mut u8, a: Range, b: *mut Range) -> Rect;
    #[link_name = "objc_msgSend"]
    fn msg_t_tp(o: *mut u8, s: *mut u8, a: Point, b: *mut u8) -> Point;
    #[link_name = "objc_msgSend"]
    fn msg_v_gP(o: *mut u8, s: *mut u8, a: Range, b: *mut Range);
}

// UNSAFE: the C library's strlen.
// SAFETY: string.h's prototype.
pub extern "C" {
    #[effects()]
    fn strlen(s: *mut u8) -> u64;
}

// MTLClearColor: four doubles, an HFA passed in v0-v3.
#[derive(Clone, Copy)] #[repr(C)]
pub struct ClearColor {
    pub r: f64,
    pub g: f64,
    pub b: f64,
    pub a: f64,
}

// MTLRegion: an origin and a size of three u64 each (48 bytes: passed
// by reference to a copy, as AAPCS64 says for large aggregates).
#[derive(Clone, Copy)] #[repr(C)]
pub struct MtlRegion {
    pub x: u64,
    pub y: u64,
    pub z: u64,
    pub w: u64,
    pub h: u64,
    pub d: u64,
}

// A class by name; null when the runtime has none (its framework is not
// loaded).
pub fn class(name: *mut u8) -> *mut u8 {
    // UNSAFE: objc_getClass reads a C string up to its NUL.
    // SAFETY: objc_getClass reads a NUL-terminated name; every caller (std::window's own
    // code: this module is private to it) passes a c"..." literal.
    unsafe { objc_getClass(name) }
}

// A selector by name (registered on first use).
pub fn sel(name: *mut u8) -> *mut u8 {
    // UNSAFE: sel_registerName reads a C string up to its NUL.
    // SAFETY: as `class`: a NUL-terminated literal from std::window's own code.
    unsafe { sel_registerName(name) }
}

// The text of a C string as a slice, valid while the string is (for an
// NSString's UTF8String: until the autorelease pool around it is
// popped).
// UNSAFE: p is a C string, read up to its NUL, whose life no type states.
// SAFETY: the caller's: p is null or NUL-terminated and outlives the view.
pub unsafe fn cstr(p: *mut u8) -> &'static [u8] {
    if p == 0 as *mut u8 {
        return b"";
    }
    crate::slice::from_raw_parts(p.add((0) as usize), (strlen(p) as i64 - (0)) as usize)
}

// The type encoding of an instance method `name` of class `cls` (or of
// its superclasses), or of the protocol `proto`'s method: the encoding a
// method added to a subclass must have. Null when neither has it.
pub fn method_types(cls: *mut u8, proto: *mut u8, name: *mut u8) -> *mut u8 {
    let s = sel(name);
    // UNSAFE: the runtime's metadata queries are C calls on raw class and protocol pointers.
    // SAFETY: the runtime's metadata queries take a class (or null), a
    // protocol (or null) and a selector; they return null or a pointer
    // into the runtime's own (immortal) metadata.
    unsafe {
        if cls != 0 as *mut u8 {
            let m = class_getInstanceMethod(cls, s);
            if m != 0 as *mut u8 {
                return method_getTypeEncoding(m);
            }
        }
        if proto != 0 as *mut u8 {
            let d = protocol_getMethodDescription(proto, s, true, true);
            if d.types != 0 as *mut u8 {
                return d.types;
            }
            let o = protocol_getMethodDescription(proto, s, false, true);
            return o.types;
        }
    }
    0 as *mut u8
}

// An autoreleased NSString with the bytes of `s` (UTF-8). Valid until
// the enclosing autorelease pool is popped; `retain` keeps it longer.
pub fn nsstring(s: &[u8]) -> *mut u8 {
    // UNSAFE: messages sent by objc_msgSend, C calls the compiler cannot check.
    // SAFETY: -[NSString initWithBytes:length:encoding:] reads exactly
    // `len` bytes at `ptr`; `s` is a live slice. NSUTF8StringEncoding is
    // 4. alloc/init returns +1, balanced by autorelease.
    unsafe {
        let a = msg_p(class(c"NSString"), sel(c"alloc"));
        let o = msg_p_puu(a, sel(c"initWithBytes:length:encoding:"), s.ptr, s.len() as u64, 4);
        msg_p(o, sel(c"autorelease"))
    }
}

// UNSAFE: objc_msgSend for initWithBytes:length:encoding:.
// SAFETY: its C prototype: (id, SEL, const void *, NSUInteger, NSStringEncoding) -> id.
pub extern "C" {
    #[link_name = "objc_msgSend"]
    fn msg_p_puu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64, c: u64) -> *mut u8;
}

// The UTF-8 bytes of an NSString (or NSAttributedString's string), a
// view valid until the current autorelease pool is popped.
pub fn nsstring_bytes(o: *mut u8) -> &'static [u8] {
    if o == 0 as *mut u8 {
        return b"";
    }
    // UNSAFE: a message to a raw object pointer, and its C string viewed.
    // SAFETY: `o` is an NSString (callers pass the results of methods
    // typed NSString); UTF8String returns an inner pointer that lives as
    // long as the pool the caller is inside.
    unsafe {
        let p = msg_p(o, sel(c"UTF8String"));
        cstr(p)
    }
}

pub fn retain(o: *mut u8) -> *mut u8 {
    // UNSAFE: objc_retain is a C call on a raw object pointer.
    // SAFETY: objc_retain takes any live object or nil; std::window's callers pass ones they
    // hold.
    unsafe { objc_retain(o) }
}

pub fn release(o: *mut u8) {
    // UNSAFE: objc_release is a C call on a raw object pointer.
    // SAFETY: callers release only what they retained (or got at +1).
    unsafe { objc_release(o); }
}

pub fn pool_push() -> *mut u8 {
    // UNSAFE: the runtime's pool push, a C call.
    // SAFETY: push and pop are paired by every caller, on the main thread.
    unsafe { objc_autoreleasePoolPush() }
}

pub fn pool_pop(p: *mut u8) {
    // UNSAFE: the runtime's pool pop, a C call.
    // SAFETY: `p` is the token of the matching push.
    unsafe { objc_autoreleasePoolPop(p); }
}
