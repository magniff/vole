// std::math (0.25.2.1): float math in vole, no C and no unsafe
// (docs/design/math.md): the trait Float (`x.sqrt()`), functions over it,
// the f64 constants. The algorithms' sources: "Math: bits, rounding".

use std::num::{f32_from_bits, f32_to_bits, f64_from_bits, f64_to_bits};

// ---- Math: the Float trait (0.25.2.1) ----

// The math of f32 and f64, as methods: `x.sqrt()`, `x.sin()`,
// `a.min(b)`. Rust's names and semantics (std's f64 methods).
pub trait Float {
    // |x|.
    #[pure]
    fn abs(self) -> Self;
    // 1.0 for +0.0 and positive numbers, -1.0 for -0.0 and negative
    // ones, NaN for NaN.
    #[pure]
    fn signum(self) -> Self;
    // |self| with the sign of `sign`.
    #[pure]
    fn copysign(self, sign: Self) -> Self;
    #[pure]
    fn is_nan(self) -> bool;
    // Neither infinite nor NaN.
    #[pure]
    fn is_finite(self) -> bool;
    #[pure]
    fn is_infinite(self) -> bool;
    // The sign bit is clear (+0.0, +inf and positive NaNs too).
    #[pure]
    fn is_sign_positive(self) -> bool;
    #[pure]
    fn is_sign_negative(self) -> bool;
    // The largest integer <= self.
    #[pure]
    fn floor(self) -> Self;
    // The smallest integer >= self.
    #[pure]
    fn ceil(self) -> Self;
    // The nearest integer, half-way cases away from zero.
    #[pure]
    fn round(self) -> Self;
    // The nearest integer, half-way cases to the even one.
    #[pure]
    fn round_ties_even(self) -> Self;
    // The integer part: rounded toward zero.
    #[pure]
    fn trunc(self) -> Self;
    // self - self.trunc().
    #[pure]
    fn fract(self) -> Self;
    // The smaller; the other one when one is NaN.
    #[pure]
    fn min(self, other: Self) -> Self;
    // The larger; the other one when one is NaN.
    #[pure]
    fn max(self, other: Self) -> Self;
    // self restricted to lo..=hi (lo when below, hi when above; NaN
    // stays NaN). Unlike Rust's it does not panic when lo > hi: hi wins.
    #[pure]
    fn clamp(self, lo: Self, hi: Self) -> Self;
    // 1 / self.
    #[pure]
    fn recip(self) -> Self;
    // Degrees to radians.
    #[pure]
    fn to_radians(self) -> Self;
    // Radians to degrees.
    #[pure]
    fn to_degrees(self) -> Self;
    // The square root, correctly rounded; NaN below -0.0.
    #[pure]
    fn sqrt(self) -> Self;
    // The cube root.
    #[pure]
    fn cbrt(self) -> Self;
    // sqrt(self^2 + other^2) without overflow or underflow on the way.
    #[pure]
    fn hypot(self, other: Self) -> Self;
    // The sine (radians).
    #[pure]
    fn sin(self) -> Self;
    // The cosine (radians).
    #[pure]
    fn cos(self) -> Self;
    // The tangent (radians).
    #[pure]
    fn tan(self) -> Self;
    // (sin, cos), with one argument reduction.
    #[pure]
    fn sin_cos(self) -> (Self, Self);
    // The arcsine, in [-pi/2, pi/2]; NaN outside [-1, 1].
    #[pure]
    fn asin(self) -> Self;
    // The arccosine, in [0, pi]; NaN outside [-1, 1].
    #[pure]
    fn acos(self) -> Self;
    // The arctangent, in [-pi/2, pi/2].
    #[pure]
    fn atan(self) -> Self;
    // The angle of the point (other, self): self is y, other is x, the
    // result in [-pi, pi] (C's atan2(y, x), Rust's y.atan2(x)).
    #[pure]
    fn atan2(self, other: Self) -> Self;
    // e^self.
    #[pure]
    fn exp(self) -> Self;
    // 2^self.
    #[pure]
    fn exp2(self) -> Self;
    // The natural logarithm; -inf at 0, NaN below 0.
    #[pure]
    fn ln(self) -> Self;
    #[pure]
    fn log2(self) -> Self;
    #[pure]
    fn log10(self) -> Self;
    // The logarithm to the base `base`: self.ln() / base.ln().
    #[pure]
    fn log(self, base: Self) -> Self;
    // self^n, C's pow (exact for exact cases: 2^10, 9^0.5).
    #[pure]
    fn powf(self, n: Self) -> Self;
    // self^n by repeated squaring (Rust's powi: fast, not correctly
    // rounded; a negative n is 1 / self^-n).
    #[pure]
    fn powi(self, n: i32) -> Self;
}

impl Float for f64 {
    fn abs(self) -> f64 { f64_from_bits(f64_to_bits(self) & 0x7fffffffffffffff) }
    fn signum(self) -> f64 { if self != self { self } else { copysign64(1.0, self) } }
    fn copysign(self, sign: f64) -> f64 { copysign64(self, sign) }
    fn is_nan(self) -> bool { self != self }
    fn is_finite(self) -> bool { f64_to_bits(self) & 0x7fffffffffffffff < 0x7ff0000000000000 }
    fn is_infinite(self) -> bool { f64_to_bits(self) & 0x7fffffffffffffff == 0x7ff0000000000000 }
    fn is_sign_positive(self) -> bool { f64_to_bits(self) >> 63 == 0 }
    fn is_sign_negative(self) -> bool { f64_to_bits(self) >> 63 != 0 }
    fn floor(self) -> f64 { floor64(self) }
    fn ceil(self) -> f64 { ceil64(self) }
    fn round(self) -> f64 { round64(self) }
    fn round_ties_even(self) -> f64 { round_even64(self) }
    fn trunc(self) -> f64 { trunc64(self) }
    fn fract(self) -> f64 { self - trunc64(self) }
    fn min(self, other: f64) -> f64 { min64(self, other) }
    fn max(self, other: f64) -> f64 { max64(self, other) }
    fn clamp(self, lo: f64, hi: f64) -> f64 { clamp64(self, lo, hi) }
    fn recip(self) -> f64 { 1.0 / self }
    fn to_radians(self) -> f64 { self * (f64::consts::PI / 180.0) }
    fn to_degrees(self) -> f64 { self * (180.0 / f64::consts::PI) }
    fn sqrt(self) -> f64 { sqrt64(self) }
    fn cbrt(self) -> f64 { cbrt64(self) }
    fn hypot(self, other: f64) -> f64 { hypot64(self, other) }
    fn sin(self) -> f64 { sin64(self) }
    fn cos(self) -> f64 { cos64(self) }
    fn tan(self) -> f64 { tan64(self) }
    fn sin_cos(self) -> (f64, f64) { sin_cos64(self) }
    fn asin(self) -> f64 { asin64(self) }
    fn acos(self) -> f64 { acos64(self) }
    fn atan(self) -> f64 { atan64(self) }
    fn atan2(self, other: f64) -> f64 { atan2_64(self, other) }
    fn exp(self) -> f64 { exp64(self) }
    fn exp2(self) -> f64 { exp2_64(self) }
    fn ln(self) -> f64 { ln64(self) }
    fn log2(self) -> f64 { log2_64(self) }
    fn log10(self) -> f64 { log10_64(self) }
    fn log(self, base: f64) -> f64 { ln64(self) / ln64(base) }
    fn powf(self, n: f64) -> f64 { pow64(self, n) }
    fn powi(self, n: i32) -> f64 { powi64(self, n) }
}

impl Float for f32 {
    fn abs(self) -> f32 { f32_from_bits(f32_to_bits(self) & 0x7fffffff) }

    fn signum(self) -> f32 {
        if self != self { self } else { f32_from_bits(f32_to_bits(self) & 0x80000000 | 0x3f800000) }
    }

    fn copysign(self, sign: f32) -> f32 {
        f32_from_bits(f32_to_bits(self) & 0x7fffffff | f32_to_bits(sign) & 0x80000000)
    }

    fn is_nan(self) -> bool { self != self }
    fn is_finite(self) -> bool { f32_to_bits(self) & 0x7fffffff < 0x7f800000 }
    fn is_infinite(self) -> bool { f32_to_bits(self) & 0x7fffffff == 0x7f800000 }
    fn is_sign_positive(self) -> bool { f32_to_bits(self) >> 31 == 0 }
    fn is_sign_negative(self) -> bool { f32_to_bits(self) >> 31 != 0 }
    // (exact in f64, and the integer is an f32 again)
    fn floor(self) -> f32 { floor64(self as f64) as f32 }
    fn ceil(self) -> f32 { ceil64(self as f64) as f32 }
    fn round(self) -> f32 { round64(self as f64) as f32 }
    fn round_ties_even(self) -> f32 { round_even64(self as f64) as f32 }
    fn trunc(self) -> f32 { trunc64(self as f64) as f32 }
    fn fract(self) -> f32 { self - trunc64(self as f64) as f32 }
    fn min(self, other: f32) -> f32 { min64(self as f64, other as f64) as f32 }
    fn max(self, other: f32) -> f32 { max64(self as f64, other as f64) as f32 }

    fn clamp(self, lo: f32, hi: f32) -> f32 {
        var r = self;
        if r < lo {
            r = lo;
        }
        if r > hi {
            r = hi;
        }
        r
    }

    fn recip(self) -> f32 { 1.0 / self }
    fn to_radians(self) -> f32 { self * (f32::consts::PI / 180.0) }
    // (Rust's constant: 180 / pi rounded once, not f32's pi divided)
    fn to_degrees(self) -> f32 { self * 57.2957795130823208767981548141051703 }
    // (f64's sqrt rounded to f32 is f32's correctly rounded sqrt: 53 >= 2 * 24 + 2)
    fn sqrt(self) -> f32 { sqrt64(self as f64) as f32 }
    fn cbrt(self) -> f32 { cbrt64(self as f64) as f32 }

    // (in f64: the squares exact, no overflow)
    fn hypot(self, other: f32) -> f32 {
        let a = self as f64;
        let b = other as f64;
        if a.is_infinite() || b.is_infinite() {
            return f32::INFINITY;
        }
        sqrt64(a * a + b * b) as f32
    }

    fn sin(self) -> f32 { sin64(self as f64) as f32 }
    fn cos(self) -> f32 { cos64(self as f64) as f32 }
    fn tan(self) -> f32 { tan64(self as f64) as f32 }

    fn sin_cos(self) -> (f32, f32) {
        let (s, c) = sin_cos64(self as f64);
        (s as f32, c as f32)
    }

    fn asin(self) -> f32 { asin64(self as f64) as f32 }
    fn acos(self) -> f32 { acos64(self as f64) as f32 }
    fn atan(self) -> f32 { atan64(self as f64) as f32 }
    fn atan2(self, other: f32) -> f32 { atan2_64(self as f64, other as f64) as f32 }
    fn exp(self) -> f32 { exp64(self as f64) as f32 }
    fn exp2(self) -> f32 { exp2_64(self as f64) as f32 }
    fn ln(self) -> f32 { ln64(self as f64) as f32 }
    fn log2(self) -> f32 { log2_64(self as f64) as f32 }
    fn log10(self) -> f32 { log10_64(self as f64) as f32 }
    fn log(self, base: f32) -> f32 { (ln64(self as f64) / ln64(base as f64)) as f32 }
    fn powf(self, n: f32) -> f32 { pow64(self as f64, n as f64) as f32 }
    fn powi(self, n: i32) -> f32 { powi64(self as f64, n) as f32 }
}

// ---- Math: functions (0.25.2.1) ----

// The methods as functions, for f32 and f64 alike: `math::sqrt(2.0)`.

pub fn abs<T: Float>(x: T) -> T { x.abs() }
pub fn signum<T: Float>(x: T) -> T { x.signum() }
pub fn copysign<T: Float>(x: T, sign: T) -> T { x.copysign(sign) }
pub fn is_nan<T: Float>(x: T) -> bool { x.is_nan() }
pub fn is_finite<T: Float>(x: T) -> bool { x.is_finite() }
pub fn is_infinite<T: Float>(x: T) -> bool { x.is_infinite() }
pub fn floor<T: Float>(x: T) -> T { x.floor() }
pub fn ceil<T: Float>(x: T) -> T { x.ceil() }
pub fn round<T: Float>(x: T) -> T { x.round() }
pub fn round_ties_even<T: Float>(x: T) -> T { x.round_ties_even() }
pub fn trunc<T: Float>(x: T) -> T { x.trunc() }
pub fn fract<T: Float>(x: T) -> T { x.fract() }
pub fn min<T: Float>(a: T, b: T) -> T { a.min(b) }
pub fn max<T: Float>(a: T, b: T) -> T { a.max(b) }
pub fn clamp<T: Float>(x: T, lo: T, hi: T) -> T { x.clamp(lo, hi) }
pub fn to_radians<T: Float>(x: T) -> T { x.to_radians() }
pub fn to_degrees<T: Float>(x: T) -> T { x.to_degrees() }
pub fn sqrt<T: Float>(x: T) -> T { x.sqrt() }
pub fn cbrt<T: Float>(x: T) -> T { x.cbrt() }
pub fn hypot<T: Float>(x: T, y: T) -> T { x.hypot(y) }
pub fn sin<T: Float>(x: T) -> T { x.sin() }
pub fn cos<T: Float>(x: T) -> T { x.cos() }
pub fn tan<T: Float>(x: T) -> T { x.tan() }
pub fn sin_cos<T: Float>(x: T) -> (T, T) { x.sin_cos() }
pub fn asin<T: Float>(x: T) -> T { x.asin() }
pub fn acos<T: Float>(x: T) -> T { x.acos() }
pub fn atan<T: Float>(x: T) -> T { x.atan() }
// C's atan2(y, x): the angle of the point (x, y).
pub fn atan2<T: Float>(y: T, x: T) -> T { y.atan2(x) }
pub fn exp<T: Float>(x: T) -> T { x.exp() }
pub fn exp2<T: Float>(x: T) -> T { x.exp2() }
pub fn ln<T: Float>(x: T) -> T { x.ln() }
pub fn log2<T: Float>(x: T) -> T { x.log2() }
pub fn log10<T: Float>(x: T) -> T { x.log10() }
// C's pow.
pub fn pow<T: Float>(x: T, y: T) -> T { x.powf(y) }
pub fn powf<T: Float>(x: T, y: T) -> T { x.powf(y) }
pub fn powi<T: Float>(x: T, n: i32) -> T { x.powi(n) }

// ---- Math: constants (0.25.2.1) ----

// f64's, for a `use` (f32's: `f32::consts::PI`).
pub const PI: f64 = f64::consts::PI;
pub const TAU: f64 = f64::consts::TAU;
pub const E: f64 = f64::consts::E;
pub const SQRT_2: f64 = f64::consts::SQRT_2;
pub const LN_2: f64 = f64::consts::LN_2;
pub const LN_10: f64 = f64::consts::LN_10;
pub const FRAC_PI_2: f64 = f64::consts::FRAC_PI_2;
pub const FRAC_PI_4: f64 = f64::consts::FRAC_PI_4;
pub const FRAC_1_SQRT_2: f64 = f64::consts::FRAC_1_SQRT_2;
pub const LOG2_E: f64 = f64::consts::LOG2_E;
pub const LOG10_E: f64 = f64::consts::LOG10_E;

// ---- Math: bits, rounding, min and max (0.25.2.1) ----

// The methods of f32 and f64 (`x.sqrt()`, `y.atan2(x)`), Rust's names and
// semantics, are the trait Float's; `math::sqrt(x)` and the others are
// functions over it. The constants are the compiler's (`f64::EPSILON`,
// `f64::consts::PI`, as `i64::MAX`).
//
// The f64 algorithms are FreeBSD msun's and musl's (fdlibm), as the Rust
// libm crate has them; their notice:
//
//   Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
//   Developed at SunSoft, a Sun Microsystems, Inc. business.
//   Permission to use, copy, modify, and distribute this software is
//   freely granted, provided that this notice is preserved.
//
// f32's are f64's, rounded once. sqrt is correctly rounded (exact
// integer check); the others are within a few ulp of the true value
// (tests/run/math_vs_libm measures them against the system's libm).

// The high and low 32 bits of x (fdlibm's GET_HIGH_WORD, GET_LOW_WORD).
#[inline]
fn hi_word(x: f64) -> u32 { (f64_to_bits(x) >> 32) as u32 }

#[inline]
fn lo_word(x: f64) -> u32 { f64_to_bits(x) as u32 }

// x with its low 32 bits l (SET_LOW_WORD).
#[inline]
fn with_lo_word(x: f64, l: u32) -> f64 {
    f64_from_bits(f64_to_bits(x) & 0xffffffff00000000 | l as u64)
}

// The f64 of the words h, l (INSERT_WORDS).
#[inline]
fn from_words(h: u32, l: u32) -> f64 { f64_from_bits((h as u64) << 32 | l as u64) }

// 2^k for a normal exponent, -1022 <= k <= 1023.
#[inline]
fn pow2(k: i64) -> f64 { f64_from_bits(((k + 1023) as u64) << 52) }

#[inline]
fn copysign64(x: f64, s: f64) -> f64 {
    f64_from_bits(f64_to_bits(x) & 0x7fffffffffffffff | f64_to_bits(s) & 0x8000000000000000)
}

// x * 2^n, rounded once (musl's scalbn: the subnormal range is reached
// in one last multiplication).
fn scalbn(x: f64, n0: i32) -> f64 {
    var n = n0;
    var y = x;
    if n > 1023 {
        y *= pow2(1023);
        n -= 1023;
        if n > 1023 {
            y *= pow2(1023);
            n -= 1023;
            if n > 1023 {
                n = 1023;
            }
        }
    } else if n < -1022 {
        // (x * 2^-969 first: the last product's n then < -53, so that
        // it rounds once into the subnormals)
        y *= pow2(-1022) * pow2(53);
        n += 1022 - 53;
        if n < -1022 {
            y *= pow2(-1022) * pow2(53);
            n += 1022 - 53;
            if n < -1022 {
                n = -1022;
            }
        }
    }
    y * pow2(n as i64)
}

// x rounded toward zero: its fraction bits cleared.
fn trunc64(x: f64) -> f64 {
    let u = f64_to_bits(x);
    let e = ((u >> 52) & 0x7ff) as i64 - 1023;
    if e >= 52 {
        // (an integer, an infinity or NaN)
        return x;
    }
    if e < 0 {
        return f64_from_bits(u & 0x8000000000000000);
    }
    let m: u64 = 0x000fffffffffffff >> e as u64;
    f64_from_bits(u & ~m)
}

fn floor64(x: f64) -> f64 {
    let t = trunc64(x);
    // (exact: below 2^52 an integer minus 1 is one)
    if x < t { t - 1.0 } else { t }
}

fn ceil64(x: f64) -> f64 {
    let t = trunc64(x);
    if x > t { t + 1.0 } else { t }
}

// Half-way cases away from zero; x - trunc(x) is exact.
fn round64(x: f64) -> f64 {
    let t = trunc64(x);
    let d = x - t;
    if d >= 0.5 { t + 1.0 } else if d <= -0.5 { t - 1.0 } else { t }
}

fn round_even64(x: f64) -> f64 {
    let t = trunc64(x);
    let d = x - t;
    // (t odd: t / 2 has a fraction; exact)
    let odd = t * 0.5 != trunc64(t * 0.5);
    if d > 0.5 || d == 0.5 && odd {
        t + 1.0
    } else if d < -0.5 || d == -0.5 && odd {
        t - 1.0
    } else {
        t
    }
}

// musl's fmin and fmax: NaN loses; -0.0 < +0.0.
fn min64(x: f64, y: f64) -> f64 {
    if x != x {
        return y;
    }
    if y != y {
        return x;
    }
    if f64_to_bits(x) >> 63 != f64_to_bits(y) >> 63 {
        return if f64_to_bits(x) >> 63 != 0 { x } else { y };
    }
    if x < y { x } else { y }
}

fn max64(x: f64, y: f64) -> f64 {
    if x != x {
        return y;
    }
    if y != y {
        return x;
    }
    if f64_to_bits(x) >> 63 != f64_to_bits(y) >> 63 {
        return if f64_to_bits(x) >> 63 != 0 { y } else { x };
    }
    if x < y { y } else { x }
}

fn clamp64(x: f64, lo: f64, hi: f64) -> f64 {
    var r = x;
    if r < lo {
        r = lo;
    }
    if r > hi {
        r = hi;
    }
    r
}

// x^n by squaring (compiler-rt's __powidf2, Rust's powi).
fn powi64(x: f64, n: i32) -> f64 {
    var a = x;
    var b = n as i64;
    let recip = b < 0;
    var r = 1.0;
    loop {
        if b & 1 != 0 {
            r *= a;
        }
        b /= 2;
        if b == 0 {
            break;
        }
        a *= a;
    }
    if recip { 1.0 / r } else { r }
}

// ---- Math: roots (0.25.2.1) ----

// The square root, correctly rounded. x = t * 2^(e - p) with t in
// [1, 4) and e - p even; sqrt(x) = sqrt(t) * 2^((e - p) / 2), and
// sqrt(t) * 2^52 rounded is the integer s with (s - 1/2)^2 < M < (s +
// 1/2)^2, M = t * 2^104 (an integer: the significand shifted). The
// estimate of s is f64's Newton iteration for 1/sqrt(t) (no division)
// times t; the exact integer check moves it to the nearest, so the
// rounding is exact whatever the estimate's last bits.
fn sqrt64(x: f64) -> f64 {
    var u = f64_to_bits(x);
    if u >= 0x7ff0000000000000 {
        // +inf, NaN, or negative
        if u == 0x7ff0000000000000 || u == 0x8000000000000000 || x != x {
            return x;
        }
        return f64::NAN;
    }
    if u == 0 {
        return x;
    }
    var scale: i64 = 0;
    if u < 0x0010000000000000 {
        // a subnormal: times 2^108 (exact), the root times 2^-54
        u = f64_to_bits(x * pow2(108));
        scale = -54;
    }
    let e = (u >> 52) as i64 - 1023;
    let mant = u & 0x000fffffffffffff | 0x0010000000000000;
    let p = e & 1;
    let t = f64_from_bits(u & 0x000fffffffffffff | ((1023 + p) as u64) << 52);
    // 1/sqrt(t): the bit estimate (3.4% off), then four Newton steps
    // (y * (1.5 - t/2 * y^2): 2e-3, 5e-6, 3e-11, then f64's rounding)
    var y = f64_from_bits(0x5fe6eb50c7b537a9 - (f64_to_bits(t) >> 1));
    let half = 0.5 * t;
    y = y * (1.5 - half * y * y);
    y = y * (1.5 - half * y * y);
    y = y * (1.5 - half * y * y);
    y = y * (1.5 - half * y * y);
    var s = (t * y * pow2(52)) as u64;
    // R = M - s^2, exact in 64 bits (|R| < 2^60: s is within a few units
    // of sqrt(M), M < 2^106); s is the nearest iff -s < R <= s
    var r = (mant << (52 + p) as u64) as i64 - (s * s) as i64;
    while r > s as i64 {
        r -= 2 * s as i64 + 1;
        s += 1;
    }
    while r <= -(s as i64) {
        r += 2 * s as i64 - 1;
        s -= 1;
    }
    let k = ((e - p) >> 1) + scale;
    f64_from_bits(((k + 1023) as u64) << 52 | s - 0x0010000000000000)
}

// The cube root (fdlibm's s_cbrt, musl's cbrt before 2023): an estimate
// from the exponent / 3, a polynomial to 23 bits, rounded to 21 bits,
// then one step of Newton's method to 53 (error < 0.667 ulp).
const CBRT_B1: u32 = 715094163; // (1023 - 1023/3 - 0.03306235651) * 2^20
const CBRT_B2: u32 = 696219795; // (1023 - 1023/3 - 54/3 - 0.03306235651) * 2^20
const CBRT_P0: f64 = 1.87595182427177009643; // 0x3ffe03e6, 0x0f61e692
const CBRT_P1: f64 = -1.88497979543377169875; // 0xbffe28e0, 0x92f02420
const CBRT_P2: f64 = 1.621429720105354466140; // 0x3ff9f160, 0x4a49d6c2
const CBRT_P3: f64 = -0.758397934778766047437; // 0xbfe844cb, 0xbee751d9
const CBRT_P4: f64 = 0.145996192886612446982; // 0x3fc2b000, 0xd4e4edd7

fn cbrt64(x: f64) -> f64 {
    var u = f64_to_bits(x);
    var hx = (u >> 32) as u32 & 0x7fffffff;
    if hx >= 0x7ff00000 {
        // NaN, inf
        return x + x;
    }
    if hx < 0x00100000 {
        // zero or subnormal
        u = f64_to_bits(x * pow2(54));
        hx = (u >> 32) as u32 & 0x7fffffff;
        if hx == 0 {
            return x;
        }
        hx = hx / 3 + CBRT_B2;
    } else {
        hx = hx / 3 + CBRT_B1;
    }
    u &= 0x8000000000000000;
    u |= (hx as u64) << 32;
    var t = f64_from_bits(u);
    // 1/cbrt(x) to 23 bits: |1/cbrt(x) - p(x)| < 2^-23.5
    var r = t * t * (t / x);
    t = t * (CBRT_P0 + r * (CBRT_P1 + r * CBRT_P2) + r * r * r * (CBRT_P3 + r * CBRT_P4));
    // t rounded away from zero to 21 bits: t*t exact below
    u = f64_to_bits(t);
    u = u + 0x80000000 & 0xffffffffc0000000;
    t = f64_from_bits(u);
    let s = t * t;
    r = x / s;
    let w = t + t;
    r = (r - t) / (w + r);
    t + t * r
}

// sqrt(x^2 + y^2) (musl's hypot): the squares exact as hi + lo
// (Dekker's split, no fma), scaled by 2^+-700 out of overflow and
// underflow.
fn hypot_sq(x: f64) -> (f64, f64) {
    // 2^27 + 1
    let xc = x * 134217729.0;
    let xh = x - xc + xc;
    let xl = x - xh;
    let hi = x * x;
    let lo = xh * xh - hi + 2.0 * xh * xl + xl * xl;
    (hi, lo)
}

fn hypot64(x0: f64, y0: f64) -> f64 {
    var ux = f64_to_bits(x0) & 0x7fffffffffffffff;
    var uy = f64_to_bits(y0) & 0x7fffffffffffffff;
    if ux < uy {
        let ut = ux;
        ux = uy;
        uy = ut;
    }
    let ex = (ux >> 52) as i64;
    let ey = (uy >> 52) as i64;
    var x = f64_from_bits(ux);
    var y = f64_from_bits(uy);
    // (hypot(inf, NaN) is inf)
    if ey == 0x7ff {
        return y;
    }
    if ex == 0x7ff || uy == 0 {
        return x;
    }
    if ex - ey > 64 {
        return x + y;
    }
    var z = 1.0;
    if ex > 0x3ff + 510 {
        z = pow2(700);
        x *= pow2(-700);
        y *= pow2(-700);
    } else if ey < 0x3ff - 450 {
        z = pow2(-700);
        x *= pow2(700);
        y *= pow2(700);
    }
    let (hx, lx) = hypot_sq(x);
    let (hy, ly) = hypot_sq(y);
    z * sqrt64(ly + lx + hy + hx)
}

// ---- Math: trigonometric kernels (0.25.2.1) ----

// fdlibm's __kernel_sin, __kernel_cos, __kernel_tan on [-pi/4, pi/4],
// x + y the reduced argument (y the tail).
const S1: f64 = -1.66666666666666324348e-01; // 0xBFC55555, 0x55555549
const S2: f64 = 8.33333333332248946124e-03; // 0x3F811111, 0x1110F8A6
const S3: f64 = -1.98412698298579493134e-04; // 0xBF2A01A0, 0x19C161D5
const S4: f64 = 2.75573137070700676789e-06; // 0x3EC71DE3, 0x57B1FE7D
const S5: f64 = -2.50507602534068634195e-08; // 0xBE5AE5E6, 0x8A2B9CEB
const S6: f64 = 1.58969099521155010221e-10; // 0x3DE5D93A, 0x5ACFD57C

fn k_sin(x: f64, y: f64, iy: i32) -> f64 {
    let z = x * x;
    let w = z * z;
    let r = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6);
    let v = z * x;
    if iy == 0 { x + v * (S1 + z * r) } else { x - (z * (0.5 * y - v * r) - y - v * S1) }
}

const C1: f64 = 4.16666666666666019037e-02; // 0x3FA55555, 0x5555554C
const C2: f64 = -1.38888888888741095749e-03; // 0xBF56C16C, 0x16C15177
const C3: f64 = 2.48015872894767294178e-05; // 0x3EFA01A0, 0x19CB1590
const C4: f64 = -2.75573143513906633035e-07; // 0xBE927E4F, 0x809C52AD
const C5: f64 = 2.08757232129817482790e-09; // 0x3E21EE9E, 0xBDB4B1C4
const C6: f64 = -1.13596475577881948265e-11; // 0xBDA8FAE9, 0xBE8838D4

fn k_cos(x: f64, y: f64) -> f64 {
    let z = x * x;
    let w = z * z;
    let r = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6));
    let hz = 0.5 * z;
    let w1 = 1.0 - hz;
    w1 + (1.0 - w1 - hz + (z * r - x * y))
}

static TAN_T: [f64; 13] = [
    3.33333333333334091986e-01, // 3FD55555, 55555563
    1.33333333333201242699e-01, // 3FC11111, 1110FE7A
    5.39682539762260521377e-02, // 3FABA1BA, 1BB341FE
    2.18694882948595424599e-02, // 3F9664F4, 8406D637
    8.86323982359930005737e-03, // 3F8226E3, E96E8493
    3.59207910759131235356e-03, // 3F6D6D22, C9560328
    1.45620945432529025516e-03, // 3F57DBC8, FEE08315
    5.88041240820264096874e-04, // 3F4344D8, F2F26501
    2.46463134818469906812e-04, // 3F3026F7, 1A8D1068
    7.81794442939557092300e-05, // 3F147E88, A03792A6
    7.14072491382608190305e-05, // 3F12B80F, 32F0A7E9
    -1.85586374855275456654e-05, // BEF375CB, DB605373
    2.59073051863633712884e-05, // 3EFB2A70, 74BF7AD4
];
const PIO4: f64 = 7.85398163397448278999e-01; // 3FE921FB, 54442D18
const PIO4_LO: f64 = 3.06161699786838301793e-17; // 3C81A626, 33145C07

// tan(x + y), or -1/tan(x + y) when odd is 1.
fn k_tan(x0: f64, y0: f64, odd: i32) -> f64 {
    var x = x0;
    var y = y0;
    let hx = hi_word(x);
    // |x| >= 0.6744: tan(pi/4 - x) instead
    let big = hx & 0x7fffffff >= 0x3FE59428;
    if big {
        if hx >> 31 != 0 {
            x = -x;
            y = -y;
        }
        x = PIO4 - x + (PIO4_LO - y);
        y = 0.0;
    }
    let z = x * x;
    let w = z * z;
    let t = TAN_T;
    var r = t[1] + w * (t[3] + w * (t[5] + w * (t[7] + w * (t[9] + w * t[11]))));
    let v = z * (t[2] + w * (t[4] + w * (t[6] + w * (t[8] + w * (t[10] + w * t[12])))));
    let s = z * x;
    r = y + z * (s * (r + v) + y) + s * t[0];
    let w1 = x + r;
    if big {
        let sg = 1.0 - 2.0 * odd as f64;
        let v1 = sg - 2.0 * (x + (r - w1 * w1 / (w1 + sg)));
        return if hx >> 31 != 0 { -v1 } else { v1 };
    }
    if odd == 0 {
        return w1;
    }
    // -1/(x + r), accurately: w0 + v = r + x, a0 = -1/w to 20 bits
    let w0 = with_lo_word(w1, 0);
    let v2 = r - (w0 - x);
    let a = -1.0 / w1;
    let a0 = with_lo_word(a, 0);
    a0 + a * (1.0 + a0 * w0 + a0 * v2)
}

// ---- Math: argument reduction (0.25.2.1) ----

// x - n * pi/2 as y0 + y1 with |y0 + y1| <= pi/4 (fdlibm's
// __ieee754_rem_pio2, musl's version): Cody-Waite with pi/2 in three
// pieces of 33 bits (each product exact) for |x| < 2^20 * pi/2, else
// Payne-Hanek (rem_pio2_large). Returns (n, y0, y1).
const TO_INT: f64 = 6755399441055744.0; // 1.5 / EPSILON
const INV_PIO2: f64 = 6.36619772367581382433e-01; // 0x3FE45F30, 0x6DC9C883
const PIO2_1: f64 = 1.57079632673412561417e+00; // 0x3FF921FB, 0x54400000
const PIO2_1T: f64 = 6.07710050650619224932e-11; // 0x3DD0B461, 0x1A626331
const PIO2_2: f64 = 6.07710050630396597660e-11; // 0x3DD0B461, 0x1A600000
const PIO2_2T: f64 = 2.02226624879595063154e-21; // 0x3BA3198A, 0x2E037073
const PIO2_3: f64 = 2.02226624871116645580e-21; // 0x3BA3198A, 0x2E000000
const PIO2_3T: f64 = 8.47842766036889956997e-32; // 0x397B839A, 0x252049C1

fn rem_pio2_medium(x: f64, ix: u32) -> (i32, f64, f64) {
    // rint(x / (pi/2)), round to nearest
    let f_n = x * INV_PIO2 + TO_INT - TO_INT;
    let n = f_n as i32;
    var r = x - f_n * PIO2_1;
    // first round, good to 85 bits
    var w = f_n * PIO2_1T;
    var y0 = r - w;
    let ex = (ix >> 20) as i32;
    var ey = (hi_word(y0) >> 20) as i32 & 0x7ff;
    if ex - ey > 16 {
        // second round, good to 118 bits
        var t = r;
        w = f_n * PIO2_2;
        r = t - w;
        w = f_n * PIO2_2T - (t - r - w);
        y0 = r - w;
        ey = (hi_word(y0) >> 20) as i32 & 0x7ff;
        if ex - ey > 49 {
            // third round, good to 151 bits: every case
            t = r;
            w = f_n * PIO2_3;
            r = t - w;
            w = f_n * PIO2_3T - (t - r - w);
            y0 = r - w;
        }
    }
    let y1 = r - y0 - w;
    (n, y0, y1)
}

// x - k * pi/2 for k = 1..4 and |x| near k * pi/2's interval (one
// round, good to 85 bits).
fn rem_pio2_k(x: f64, k: i32, neg: bool) -> (i32, f64, f64) {
    let kf = k as f64;
    if !neg {
        let z = x - kf * PIO2_1;
        let y0 = z - kf * PIO2_1T;
        (k, y0, z - y0 - kf * PIO2_1T)
    } else {
        let z = x + kf * PIO2_1;
        let y0 = z + kf * PIO2_1T;
        (-k, y0, z - y0 + kf * PIO2_1T)
    }
}

fn rem_pio2(x: f64) -> (i32, f64, f64) {
    let neg = f64_to_bits(x) >> 63 != 0;
    let ix = hi_word(x) & 0x7fffffff;
    if ix <= 0x400f6a7a {
        // |x| ~<= 5pi/4
        if ix & 0xfffff == 0x921fb {
            // |x| ~= pi/2 or 2pi/2: cancellation, the medium case
            return rem_pio2_medium(x, ix);
        }
        // |x| ~<= 3pi/4: 1, else 2
        return rem_pio2_k(x, if ix <= 0x4002d97c { 1 } else { 2 }, neg);
    }
    if ix <= 0x401c463b {
        // |x| ~<= 9pi/4
        if ix <= 0x4015fdbc {
            // |x| ~<= 7pi/4
            if ix == 0x4012d97c {
                // |x| ~= 3pi/2
                return rem_pio2_medium(x, ix);
            }
            return rem_pio2_k(x, 3, neg);
        }
        if ix == 0x401921fb {
            // |x| ~= 4pi/2
            return rem_pio2_medium(x, ix);
        }
        return rem_pio2_k(x, 4, neg);
    }
    if ix < 0x413921fb {
        // |x| ~< 2^20 * pi/2
        return rem_pio2_medium(x, ix);
    }
    if ix >= 0x7ff00000 {
        // inf or NaN
        let y = x - x;
        return (0, y, y);
    }
    // z = |x| scaled to [2^23, 2^24), cut into three 24-bit pieces
    var u = f64_to_bits(x) & 0x000fffffffffffff;
    u |= (0x3ff + 23) << 52;
    var z = f64_from_bits(u);
    var tx: [f64; 3] = [0.0; 3];
    tx[0] = (z as i32) as f64;
    z = (z - tx[0]) * 16777216.0;
    tx[1] = (z as i32) as f64;
    z = (z - tx[1]) * 16777216.0;
    tx[2] = z;
    // (the zero pieces at the end left out; the first is not zero)
    var nx: i64 = 3;
    while nx > 1 && tx[nx - 1] == 0.0 {
        nx -= 1;
    }
    let (n, y0, y1) = rem_pio2_large(tx, nx, (ix >> 20) as i32 - (0x3ff + 23));
    if neg { (-n, -y0, -y1) } else { (n, y0, y1) }
}

// 2/pi's bits, 24 to an entry (fdlibm's ipio2, enough for every f64).
static IPIO2: [i32; 66] = [
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163,
    0xABDEBB, 0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C,
    0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292,
    0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA,
    0x73A8C9, 0x60E27B, 0xC08C6B,
];

// pi/2 in pieces of 24 bits.
static PIO2_PIECES: [f64; 8] = [
    1.57079625129699707031e+00, // 0x3FF921FB, 0x40000000
    7.54978941586159635335e-08, // 0x3E74442D, 0x00000000
    5.39030252995776476554e-15, // 0x3CF84698, 0x80000000
    3.28200341580791294123e-22, // 0x3B78CC51, 0x60000000
    1.27065575308067607349e-29, // 0x39F01B83, 0x80000000
    1.22933308981111328932e-36, // 0x387A2520, 0x40000000
    2.73370053816464559624e-44, // 0x36E38222, 0x80000000
    2.16741683877804819444e-51, // 0x3569F31D, 0x00000000
];

// fdlibm's __kernel_rem_pio2 for f64 (prec 1: the result as y0 + y1):
// x = (tx[0] + tx[1] 2^-24 + tx[2] 2^-48) * 2^e0, the product with 2/pi's
// bits from where they matter, in 24-bit pieces, the integer part mod 8
// and the fraction times pi/2. Returns (n mod 8, y0, y1).
fn rem_pio2_large(tx: [f64; 3], nx: i64, e0: i32) -> (i32, f64, f64) {
    let two24 = 16777216.0;
    let twon24 = 5.9604644775390625e-08;
    let ipio2 = IPIO2;
    let pio2 = PIO2_PIECES;
    // jk + 1 terms of the product (prec 1: 4)
    let jk: i64 = 4;
    let jp: i64 = 4;
    let jx = nx - 1;
    var jv = ((e0 - 3) / 24) as i64;
    if jv < 0 {
        jv = 0;
    }
    var q0: i32 = e0 - 24 * (jv as i32 + 1);
    var f: [f64; 20] = [0.0; 20];
    var fq: [f64; 20] = [0.0; 20];
    var q: [f64; 20] = [0.0; 20];
    var iq: [i32; 20] = [0; 20];
    // f[0..=jx + jk]: ipio2[jv - jx..]
    var j = jv - jx;
    for i in 0..jx + jk + 1 {
        f[i] = if j < 0 { 0.0 } else { ipio2[j] as f64 };
        j += 1;
    }
    // q[0..=jk]
    for i in 0..jk + 1 {
        var fw = 0.0;
        for k in 0..jx + 1 {
            fw += tx[k] * f[jx + i - k];
        }
        q[i] = fw;
    }
    var jz = jk;
    var z = 0.0;
    var n: i32 = 0;
    var ih: i32 = 0;
    loop {
        // q[] into 24-bit pieces iq[], lowest first
        z = q[jz];
        var i: i64 = 0;
        var k = jz;
        while k > 0 {
            let fw = ((twon24 * z) as i32) as f64;
            iq[i] = (z - two24 * fw) as i32;
            z = q[k - 1] + fw;
            i += 1;
            k -= 1;
        }
        // n: the integer part mod 8
        z = scalbn(z, q0);
        z -= 8.0 * floor64(z * 0.125);
        n = z as i32;
        z -= n as f64;
        ih = 0;
        if q0 > 0 {
            // iq[jz - 1] holds n's last bits
            let b = iq[jz - 1] >> (24 - q0);
            n += b;
            iq[jz - 1] -= b << (24 - q0);
            ih = iq[jz - 1] >> (23 - q0);
        } else if q0 == 0 {
            ih = iq[jz - 1] >> 23;
        } else if z >= 0.5 {
            ih = 2;
        }
        if ih > 0 {
            // the fraction > 0.5: 1 - it, n + 1
            n += 1;
            var carry: i32 = 0;
            for m in 0..jz {
                let v = iq[m];
                if carry == 0 {
                    if v != 0 {
                        carry = 1;
                        iq[m] = 0x1000000 - v;
                    }
                } else {
                    iq[m] = 0xffffff - v;
                }
            }
            if q0 == 1 {
                iq[jz - 1] &= 0x7fffff;
            } else if q0 == 2 {
                iq[jz - 1] &= 0x3fffff;
            }
            if ih == 2 {
                z = 1.0 - z;
                if carry != 0 {
                    z -= scalbn(1.0, q0);
                }
            }
        }
        // all zero: more of 2/pi's bits needed
        if z == 0.0 {
            var all: i32 = 0;
            var m = jz - 1;
            while m >= jk {
                all |= iq[m];
                m -= 1;
            }
            if all == 0 {
                var more: i64 = 1;
                while iq[jk - more] == 0 {
                    more += 1;
                }
                for ii in jz + 1..jz + more + 1 {
                    f[jx + ii] = ipio2[jv + ii] as f64;
                    var fw = 0.0;
                    for kk in 0..jx + 1 {
                        fw += tx[kk] * f[jx + ii - kk];
                    }
                    q[ii] = fw;
                }
                jz += more;
                continue;
            }
        }
        break;
    }
    // the zero pieces at the end left out
    if z == 0.0 {
        jz -= 1;
        q0 -= 24;
        while iq[jz] == 0 {
            jz -= 1;
            q0 -= 24;
        }
    } else {
        // z cut into 24-bit pieces if needed
        z = scalbn(z, -q0);
        if z >= two24 {
            let fw = ((twon24 * z) as i32) as f64;
            iq[jz] = (z - two24 * fw) as i32;
            jz += 1;
            q0 += 24;
            iq[jz] = fw as i32;
        } else {
            iq[jz] = z as i32;
        }
    }
    // the pieces as f64s
    var fw = scalbn(1.0, q0);
    var i = jz;
    while i >= 0 {
        q[i] = fw * (iq[i] as f64);
        fw *= twon24;
        i -= 1;
    }
    // fq = pio2[0..=jp] * q[jz..=0]
    i = jz;
    while i >= 0 {
        var s = 0.0;
        var k: i64 = 0;
        while k <= jp && k <= jz - i {
            s += pio2[k] * q[i + k];
            k += 1;
        }
        fq[jz - i] = s;
        i -= 1;
    }
    // fq summed into y0 + y1
    var s = 0.0;
    i = jz;
    while i >= 0 {
        s += fq[i];
        i -= 1;
    }
    let y0 = if ih == 0 { s } else { -s };
    s = fq[0] - s;
    for m in 1..jz + 1 {
        s += fq[m];
    }
    let y1 = if ih == 0 { s } else { -s };
    (n & 7, y0, y1)
}

// ---- Math: sin, cos, tan (0.25.2.1) ----

// fdlibm's s_sin, s_cos, s_tan, musl's sincos: the kernels on the
// argument reduced by rem_pio2, by its quadrant.
fn sin64(x: f64) -> f64 {
    let ix = hi_word(x) & 0x7fffffff;
    if ix <= 0x3fe921fb {
        // |x| ~< pi/4
        if ix < 0x3e500000 {
            // |x| < 2^-26: sin(x) is x
            return x;
        }
        return k_sin(x, 0.0, 0);
    }
    if ix >= 0x7ff00000 {
        // inf or NaN
        return x - x;
    }
    let (n, y0, y1) = rem_pio2(x);
    match n & 3 {
        0 => k_sin(y0, y1, 1),
        1 => k_cos(y0, y1),
        2 => -k_sin(y0, y1, 1),
        _ => -k_cos(y0, y1),
    }
}

fn cos64(x: f64) -> f64 {
    let ix = hi_word(x) & 0x7fffffff;
    if ix <= 0x3fe921fb {
        if ix < 0x3e46a09e {
            // |x| < 2^-27 * sqrt(2): cos(x) is 1
            return 1.0;
        }
        return k_cos(x, 0.0);
    }
    if ix >= 0x7ff00000 {
        return x - x;
    }
    let (n, y0, y1) = rem_pio2(x);
    match n & 3 {
        0 => k_cos(y0, y1),
        1 => -k_sin(y0, y1, 1),
        2 => -k_cos(y0, y1),
        _ => k_sin(y0, y1, 1),
    }
}

fn tan64(x: f64) -> f64 {
    let ix = hi_word(x) & 0x7fffffff;
    if ix <= 0x3fe921fb {
        if ix < 0x3e400000 {
            // |x| < 2^-27
            return x;
        }
        return k_tan(x, 0.0, 0);
    }
    if ix >= 0x7ff00000 {
        return x - x;
    }
    let (n, y0, y1) = rem_pio2(x);
    k_tan(y0, y1, n & 1)
}

fn sin_cos64(x: f64) -> (f64, f64) {
    let ix = hi_word(x) & 0x7fffffff;
    if ix <= 0x3fe921fb {
        if ix < 0x3e46a09e {
            return (x, 1.0);
        }
        return (k_sin(x, 0.0, 0), k_cos(x, 0.0));
    }
    if ix >= 0x7ff00000 {
        let y = x - x;
        return (y, y);
    }
    let (n, y0, y1) = rem_pio2(x);
    let s = k_sin(y0, y1, 1);
    let c = k_cos(y0, y1);
    match n & 3 {
        0 => (s, c),
        1 => (c, -s),
        2 => (-s, -c),
        _ => (-c, s),
    }
}

// ---- Math: inverse trigonometric functions (0.25.2.1) ----

// fdlibm's e_asin, e_acos: a rational approximation R(x^2) of
// (asin(x) - x) / x^3 on [0, 0.5], and asin(x) = pi/2 - 2 asin(sqrt((1 -
// x) / 2)) above.
const PIO2_HI: f64 = 1.57079632679489655800e+00; // 0x3FF921FB, 0x54442D18
const PIO2_LO: f64 = 6.12323399573676603587e-17; // 0x3C91A626, 0x33145C07
const P_S0: f64 = 1.66666666666666657415e-01; // 0x3FC55555, 0x55555555
const P_S1: f64 = -3.25565818622400915405e-01; // 0xBFD4D612, 0x03EB6F7D
const P_S2: f64 = 2.01212532134862925881e-01; // 0x3FC9C155, 0x0E884455
const P_S3: f64 = -4.00555345006794114027e-02; // 0xBFA48228, 0xB5688F3B
const P_S4: f64 = 7.91534994289814532176e-04; // 0x3F49EFE0, 0x7501B288
const P_S5: f64 = 3.47933107596021167570e-05; // 0x3F023DE1, 0x0DFDF709
const Q_S1: f64 = -2.40339491173441421878e+00; // 0xC0033A27, 0x1C8A2D4B
const Q_S2: f64 = 2.02094576023350569471e+00; // 0x40002AE5, 0x9C598AC8
const Q_S3: f64 = -6.88283971605453293030e-01; // 0xBFE6066C, 0x1B8D0159
const Q_S4: f64 = 7.70381505559019352791e-02; // 0x3FB3B8C5, 0xB12E9282

fn asin_r(z: f64) -> f64 {
    let p = z * (P_S0 + z * (P_S1 + z * (P_S2 + z * (P_S3 + z * (P_S4 + z * P_S5)))));
    let q = 1.0 + z * (Q_S1 + z * (Q_S2 + z * (Q_S3 + z * Q_S4)));
    p / q
}

fn asin64(x: f64) -> f64 {
    let hx = hi_word(x);
    let ix = hx & 0x7fffffff;
    if ix >= 0x3ff00000 {
        // |x| >= 1 or NaN
        if ix - 0x3ff00000 | lo_word(x) == 0 {
            // asin(+-1) = +-pi/2
            return x * PIO2_HI + pow2(-120);
        }
        if x != x {
            return x;
        }
        return f64::NAN;
    }
    if ix < 0x3fe00000 {
        // |x| < 0.5
        if ix < 0x3e500000 && ix >= 0x00100000 {
            // |x| < 2^-26
            return x;
        }
        return x + x * asin_r(x * x);
    }
    // 1 > |x| >= 0.5
    let z = (1.0 - x.abs()) * 0.5;
    let s = sqrt64(z);
    let r = asin_r(z);
    var y = 0.0;
    if ix >= 0x3fef3333 {
        // |x| > 0.975
        y = PIO2_HI - (2.0 * (s + s * r) - PIO2_LO);
    } else {
        // f + c = sqrt(z)
        let f = with_lo_word(s, 0);
        let c = (z - f * f) / (s + f);
        y = 0.5 * PIO2_HI - (2.0 * s * r - (PIO2_LO - 2.0 * c) - (0.5 * PIO2_HI - 2.0 * f));
    }
    if hx >> 31 != 0 { -y } else { y }
}

fn acos64(x: f64) -> f64 {
    let hx = hi_word(x);
    let ix = hx & 0x7fffffff;
    if ix >= 0x3ff00000 {
        if ix - 0x3ff00000 | lo_word(x) == 0 {
            // acos(1) = 0, acos(-1) = pi
            if hx >> 31 != 0 {
                return 2.0 * PIO2_HI + pow2(-120);
            }
            return 0.0;
        }
        if x != x {
            return x;
        }
        return f64::NAN;
    }
    if ix < 0x3fe00000 {
        // |x| < 0.5
        if ix <= 0x3c600000 {
            // |x| < 2^-57
            return PIO2_HI + pow2(-120);
        }
        return PIO2_HI - (x - (PIO2_LO - x * asin_r(x * x)));
    }
    if hx >> 31 != 0 {
        // x < -0.5
        let z = (1.0 + x) * 0.5;
        let s = sqrt64(z);
        let w = asin_r(z) * s - PIO2_LO;
        return 2.0 * (PIO2_HI - (s + w));
    }
    // x > 0.5
    let z = (1.0 - x) * 0.5;
    let s = sqrt64(z);
    let df = with_lo_word(s, 0);
    let c = (z - df * df) / (s + df);
    let w = asin_r(z) * s + c;
    2.0 * (df + w)
}

// fdlibm's s_atan: x reduced to [0, 7/16] around atan(0.5), atan(1),
// atan(1.5) or atan(inf), then a polynomial of 11 terms.
static ATAN_HI: [f64; 4] = [
    4.63647609000806093515e-01, // atan(0.5)hi 0x3FDDAC67, 0x0561BB4F
    7.85398163397448278999e-01, // atan(1.0)hi 0x3FE921FB, 0x54442D18
    9.82793723247329054082e-01, // atan(1.5)hi 0x3FEF730B, 0xD281F69B
    1.57079632679489655800e+00, // atan(inf)hi 0x3FF921FB, 0x54442D18
];
static ATAN_LO: [f64; 4] = [
    2.26987774529616870924e-17, // atan(0.5)lo 0x3C7A2B7F, 0x222F65E2
    3.06161699786838301793e-17, // atan(1.0)lo 0x3C81A626, 0x33145C07
    1.39033110312309984516e-17, // atan(1.5)lo 0x3C700788, 0x7AF0CBBD
    6.12323399573676603587e-17, // atan(inf)lo 0x3C91A626, 0x33145C07
];
static ATAN_T: [f64; 11] = [
    3.33333333333329318027e-01, // 0x3FD55555, 0x5555550D
    -1.99999999998764832476e-01, // 0xBFC99999, 0x9998EBC4
    1.42857142725034663711e-01, // 0x3FC24924, 0x920083FF
    -1.11111104054623557880e-01, // 0xBFBC71C6, 0xFE231671
    9.09088713343650656196e-02, // 0x3FB745CD, 0xC54C206E
    -7.69187620504482999495e-02, // 0xBFB3B0F2, 0xAF749A6D
    6.66107313738753120669e-02, // 0x3FB10D66, 0xA0D03D51
    -5.83357013379057348645e-02, // 0xBFADDE2D, 0x52DEFD9A
    4.97687799461593236017e-02, // 0x3FA97B4B, 0x24760DEB
    -3.65315727442169155270e-02, // 0xBFA2B444, 0x2C6A6C2F
    1.62858201153657823623e-02, // 0x3F90AD3A, 0xE322DA11
];

fn atan64(x0: f64) -> f64 {
    var x = x0;
    let hx = hi_word(x);
    let neg = hx >> 31 != 0;
    let ix = hx & 0x7fffffff;
    if ix >= 0x44100000 {
        // |x| >= 2^66, or NaN
        if x != x {
            return x;
        }
        let z = ATAN_HI[3] + pow2(-120);
        return if neg { -z } else { z };
    }
    var id: i64 = -1;
    if ix < 0x3fdc0000 {
        // |x| < 0.4375
        if ix < 0x3e400000 {
            // |x| < 2^-27
            return x;
        }
    } else {
        x = x.abs();
        if ix < 0x3ff30000 {
            // |x| < 1.1875
            if ix < 0x3fe60000 {
                // 7/16 <= |x| < 11/16
                id = 0;
                x = (2.0 * x - 1.0) / (2.0 + x);
            } else {
                // 11/16 <= |x| < 19/16
                id = 1;
                x = (x - 1.0) / (x + 1.0);
            }
        } else if ix < 0x40038000 {
            // |x| < 2.4375
            id = 2;
            x = (x - 1.5) / (1.0 + 1.5 * x);
        } else {
            // 2.4375 <= |x| < 2^66
            id = 3;
            x = -1.0 / x;
        }
    }
    let at = ATAN_T;
    let z = x * x;
    let w = z * z;
    // the odd and the even terms
    let s1 = z * (at[0] + w * (at[2] + w * (at[4] + w * (at[6] + w * (at[8] + w * at[10])))));
    let s2 = w * (at[1] + w * (at[3] + w * (at[5] + w * (at[7] + w * at[9]))));
    if id < 0 {
        return x - x * (s1 + s2);
    }
    let r = ATAN_HI[id] - (x * (s1 + s2) - ATAN_LO[id] - x);
    if neg { -r } else { r }
}

const PI_LO: f64 = 1.2246467991473531772e-16; // 0x3CA1A626, 0x33145C07

// fdlibm's e_atan2: atan(|y/x|), placed in its quadrant; the special
// values of C99's Annex F.
fn atan2_64(y: f64, x: f64) -> f64 {
    let pi = f64::consts::PI;
    if x != x || y != y {
        return x + y;
    }
    var ix = hi_word(x);
    let lx = lo_word(x);
    var iy = hi_word(y);
    let ly = lo_word(y);
    if ix - 0x3ff00000 | lx == 0 {
        // x = 1.0
        return atan64(y);
    }
    // 2 * sign(x) + sign(y)
    let m = iy >> 31 & 1 | ix >> 30 & 2;
    ix &= 0x7fffffff;
    iy &= 0x7fffffff;
    if iy | ly == 0 {
        // y = +-0
        return if m <= 1 { y } else if m == 2 { pi } else { -pi };
    }
    if ix | lx == 0 {
        // x = +-0
        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 };
    }
    if ix == 0x7ff00000 {
        // x = +-inf
        if iy == 0x7ff00000 {
            return if m == 0 {
                pi / 4.0
            } else if m == 1 {
                -pi / 4.0
            } else if m == 2 {
                3.0 * pi / 4.0
            } else {
                -3.0 * pi / 4.0
            };
        }
        return if m == 0 { 0.0 } else if m == 1 { -0.0 } else if m == 2 { pi } else { -pi };
    }
    if ix + (64 << 20) < iy || iy == 0x7ff00000 {
        // |y/x| > 2^64
        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 };
    }
    // atan(|y/x|) without a spurious underflow
    let z = if m & 2 != 0 && iy + (64 << 20) < ix { 0.0 } else { atan64((y / x).abs()) };
    if m == 0 {
        z
    } else if m == 1 {
        -z
    } else if m == 2 {
        pi - (z - PI_LO)
    } else {
        z - PI_LO - pi
    }
}

// ---- Math: exp and log (0.25.2.1) ----

// fdlibm's e_exp: x = k ln2 + r, |r| <= ln2 / 2 (ln2 in two pieces, k *
// ln2hi exact), e^r from a Remez polynomial of r^2, times 2^k.
const LN2_HI: f64 = 6.93147180369123816490e-01; // 0x3fe62e42, 0xfee00000
const LN2_LO: f64 = 1.90821492927058770002e-10; // 0x3dea39ef, 0x35793c76
const INV_LN2: f64 = 1.44269504088896338700e+00; // 0x3ff71547, 0x652b82fe
const EXP_P1: f64 = 1.66666666666666019037e-01; // 0x3FC55555, 0x5555553E
const EXP_P2: f64 = -2.77777777770155933842e-03; // 0xBF66C16C, 0x16BEBD93
const EXP_P3: f64 = 6.61375632143793436117e-05; // 0x3F11566A, 0xAF25DE2C
const EXP_P4: f64 = -1.65339022054652515390e-06; // 0xBEBBBD41, 0xC5D26BF1
const EXP_P5: f64 = 4.13813679705723846039e-08; // 0x3E663769, 0x72BEA4D0

fn exp64(x0: f64) -> f64 {
    var x = x0;
    var hx = hi_word(x);
    let sign = (hx >> 31) as i32;
    hx &= 0x7fffffff;
    if hx >= 0x4086232b {
        // |x| >= 708.39, or NaN
        if x != x {
            return x;
        }
        if x > 709.782712893383973096 {
            // overflow
            return x * pow2(1023);
        }
        if x < -745.13321910194110842 {
            // underflow
            return 0.0;
        }
    }
    var k: i32 = 0;
    var hi = 0.0;
    var lo = 0.0;
    if hx > 0x3fd62e42 {
        // |x| > ln2 / 2
        if hx >= 0x3ff0a2b2 {
            // |x| >= 1.5 ln2
            k = (INV_LN2 * x + if sign != 0 { -0.5 } else { 0.5 }) as i32;
        } else {
            k = 1 - sign - sign;
        }
        hi = x - k as f64 * LN2_HI;
        lo = k as f64 * LN2_LO;
        x = hi - lo;
    } else if hx > 0x3e300000 {
        // |x| > 2^-28
        hi = x;
    } else {
        return 1.0 + x;
    }
    let xx = x * x;
    let c = x - xx * (EXP_P1 + xx * (EXP_P2 + xx * (EXP_P3 + xx * (EXP_P4 + xx * EXP_P5))));
    let y = 1.0 + (x * c / (2.0 - c) - lo + hi);
    if k == 0 { y } else { scalbn(y, k) }
}

// 2^x = 2^k * e^(r ln2), k the nearest integer, r = x - k (exact).
fn exp2_64(x: f64) -> f64 {
    if x != x {
        return x;
    }
    if x >= 1024.0 {
        return f64::INFINITY;
    }
    if x < -1080.0 {
        return 0.0;
    }
    let k = round64(x);
    let r = x - k;
    if r == 0.0 {
        return scalbn(1.0, k as i32);
    }
    scalbn(exp64(r * f64::consts::LN_2), k as i32)
}

// fdlibm's e_log: x = 2^k (1 + f), sqrt(2)/2 < 1 + f < sqrt(2); log(1 +
// f) = f - f^2/2 + s(f^2/2 + R(s^2)), s = f / (2 + f), R a Remez
// polynomial; plus k ln2 in two pieces.
const LG1: f64 = 6.666666666666735130e-01; // 3FE55555 55555593
const LG2: f64 = 3.999999999940941908e-01; // 3FD99999 9997FA04
const LG3: f64 = 2.857142874366239149e-01; // 3FD24924 94229359
const LG4: f64 = 2.222219843214978396e-01; // 3FCC71C5 1D8E78AF
const LG5: f64 = 1.818357216161805012e-01; // 3FC74664 96CB03DE
const LG6: f64 = 1.531383769920937332e-01; // 3FC39A09 D078C69F
const LG7: f64 = 1.479819860511658591e-01; // 3FC2F112 DF3E5244

// The reduction of log, log2 and log10: (k, f, hfsq, s, R), or
// (special, the result) for 0, negatives, inf, NaN and 1. x = 2^k (1 +
// f).
fn log_reduce(x0: f64) -> (bool, f64, i32, f64, f64, f64) {
    var x = x0;
    var ui = f64_to_bits(x);
    var hx = (ui >> 32) as u32;
    var k: i32 = 0;
    if hx < 0x00100000 || hx >> 31 != 0 {
        if ui << 1 == 0 {
            // log(+-0) = -inf
            return (true, f64::NEG_INFINITY, 0, 0.0, 0.0, 0.0);
        }
        if hx >> 31 != 0 {
            // log(-x) = NaN
            return (true, if x != x { x } else { f64::NAN }, 0, 0.0, 0.0, 0.0);
        }
        // a subnormal: scaled up
        k -= 54;
        x *= pow2(54);
        ui = f64_to_bits(x);
        hx = (ui >> 32) as u32;
    } else if hx >= 0x7ff00000 {
        return (true, x, 0, 0.0, 0.0, 0.0);
    } else if hx == 0x3ff00000 && ui << 32 == 0 {
        return (true, 0.0, 0, 0.0, 0.0, 0.0);
    }
    // x into [sqrt(2)/2, sqrt(2)]
    hx += 0x3ff00000 - 0x3fe6a09e;
    k += (hx >> 20) as i32 - 0x3ff;
    hx = (hx & 0x000fffff) + 0x3fe6a09e;
    ui = (hx as u64) << 32 | ui & 0xffffffff;
    x = f64_from_bits(ui);
    let f = x - 1.0;
    let hfsq = 0.5 * f * f;
    let s = f / (2.0 + f);
    let z = s * s;
    let w = z * z;
    let t1 = w * (LG2 + w * (LG4 + w * LG6));
    let t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)));
    (false, f, k, hfsq, s, t2 + t1)
}

fn ln64(x: f64) -> f64 {
    let (special, f, k, hfsq, s, r) = log_reduce(x);
    if special {
        return f;
    }
    let dk = k as f64;
    s * (hfsq + r) + dk * LN2_LO - hfsq + f + dk * LN2_HI
}

// e_log2 (FreeBSD): log(1 + f) as hi + lo, hi with 32 bits, times
// 1/ln2 in two pieces, plus k.
const IVLN2HI: f64 = 1.44269504072144627571e+00; // 0x3ff71547, 0x65200000
const IVLN2LO: f64 = 1.67517131648865118353e-10; // 0x3de705fc, 0x2eefa200

fn log2_64(x: f64) -> f64 {
    let (special, f, k, hfsq, s, r) = log_reduce(x);
    if special {
        return f;
    }
    let hi = f64_from_bits(f64_to_bits(f - hfsq) & 0xffffffff00000000);
    let lo = f - hi - hfsq + s * (hfsq + r);
    var val_hi = hi * IVLN2HI;
    var val_lo = (lo + hi) * IVLN2LO + lo * IVLN2HI;
    let y = k as f64;
    let w = y + val_hi;
    val_lo += y - w + val_hi;
    val_hi = w;
    val_lo + val_hi
}

// e_log10 (FreeBSD): as log2, times 1/ln10, plus k log10(2) in two
// pieces.
const IVLN10HI: f64 = 4.34294481878168880939e-01; // 0x3fdbcb7b, 0x15200000
const IVLN10LO: f64 = 2.50829467116452752298e-11; // 0x3dbb9438, 0xca9aadd5
const LOG10_2HI: f64 = 3.01029995663611771306e-01; // 0x3FD34413, 0x509F6000
const LOG10_2LO: f64 = 3.69423907715893078616e-13; // 0x3D59FEF3, 0x11F12B36

fn log10_64(x: f64) -> f64 {
    let (special, f, k, hfsq, s, r) = log_reduce(x);
    if special {
        return f;
    }
    let hi = f64_from_bits(f64_to_bits(f - hfsq) & 0xffffffff00000000);
    let lo = f - hi - hfsq + s * (hfsq + r);
    var val_hi = hi * IVLN10HI;
    let dk = k as f64;
    let y = dk * LOG10_2HI;
    var val_lo = dk * LOG10_2LO + (lo + hi) * IVLN10LO + lo * IVLN10HI;
    let w = y + val_hi;
    val_lo += y - w + val_hi;
    val_hi = w;
    val_lo + val_hi
}

// ---- Math: pow (0.25.2.1) ----

// fdlibm's e_pow: log2(x) as t1 + t2 to about 64 bits, times y as y1 +
// y2, then 2^(the product) as 2^n * e^(r ln2); the special values of
// C99's Annex F (pow(x, 0) = 1 even for NaN, pow(1, y) = 1, (-x)^odd).
const POW_BP: [f64; 2] = [1.0, 1.5];
const POW_DP_H: [f64; 2] = [0.0, 5.84962487220764160156e-01]; // 0x3fe2b803_40000000
const POW_DP_L: [f64; 2] = [0.0, 1.35003920212974897128e-08]; // 0x3E4CFDEB, 0x43CFD006
const TWO53: f64 = 9007199254740992.0;
const HUGE: f64 = 1.0e300;
const TINY: f64 = 1.0e-300;
const POW_L1: f64 = 5.99999999999994648725e-01; // 0x3fe33333_33333303
const POW_L2: f64 = 4.28571428578550184252e-01; // 0x3fdb6db6_db6fabff
const POW_L3: f64 = 3.33333329818377432918e-01; // 0x3fd55555_518f264d
const POW_L4: f64 = 2.72728123808534006489e-01; // 0x3fd17460_a91d4101
const POW_L5: f64 = 2.30660745775561754067e-01; // 0x3fcd864a_93c9db65
const POW_L6: f64 = 2.06975017800338417784e-01; // 0x3fca7e28_4a454eef
const POW_LG2: f64 = 6.93147180559945286227e-01; // 0x3fe62e42_fefa39ef
const POW_LG2_H: f64 = 6.93147182464599609375e-01; // 0x3fe62e43_00000000
const POW_LG2_L: f64 = -1.90465429995776804525e-09; // 0xbe205c61_0ca86c39
const POW_OVT: f64 = 8.0085662595372944372e-017; // -(1024 - log2(ovfl + .5ulp))
const POW_CP: f64 = 9.61796693925975554329e-01; // 0x3feec709_dc3a03fd = 2/(3ln2)
const POW_CP_H: f64 = 9.61796700954437255859e-01; // 0x3feec709_e0000000 = (float)cp
const POW_CP_L: f64 = -7.02846165095275826516e-09; // 0xbe3e2fe0_145b01f5 = tail of cp_h
const POW_IVLN2: f64 = 1.44269504088896338700e+00; // 0x3ff71547_652b82fe = 1/ln2
const POW_IVLN2_H: f64 = 1.44269502162933349609e+00; // 0x3ff71547_60000000 = 24b 1/ln2
const POW_IVLN2_L: f64 = 1.92596299112661746887e-08; // 0x3e54ae0b_f85ddf44 = 1/ln2 tail

fn pow64(x: f64, y: f64) -> f64 {
    let hx = hi_word(x) as i32;
    let lx = lo_word(x);
    let hy = hi_word(y) as i32;
    let ly = lo_word(y);
    var ix = hx & 0x7fffffff;
    let iy = hy & 0x7fffffff;
    // x^0 = 1, even for NaN
    if iy as u32 | ly == 0 {
        return 1.0;
    }
    // 1^y = 1, even for NaN
    if hx == 0x3ff00000 && lx == 0 {
        return 1.0;
    }
    // NaN if either is
    if ix > 0x7ff00000 || ix == 0x7ff00000 && lx != 0 || iy > 0x7ff00000
        || iy == 0x7ff00000 && ly != 0 {
        return x + y;
    }
    // for x < 0: 0 when y is not an integer, 1 when an odd one, 2 when
    // an even one
    var yisint: i32 = 0;
    if hx < 0 {
        if iy >= 0x43400000 {
            yisint = 2;
        } else if iy >= 0x3ff00000 {
            let k = (iy >> 20) - 0x3ff;
            if k > 20 {
                let j = (ly >> (52 - k) as u32) as i32;
                if j << (52 - k) == ly as i32 {
                    yisint = 2 - (j & 1);
                }
            } else if ly == 0 {
                let j = iy >> (20 - k);
                if j << (20 - k) == iy {
                    yisint = 2 - (j & 1);
                }
            }
        }
    }
    if ly == 0 {
        // y is +-inf, +-1, 2, 0.5
        if iy == 0x7ff00000 {
            return if ix - 0x3ff00000 | lx as i32 == 0 {
                // (-1)^+-inf = 1
                1.0
            } else if ix >= 0x3ff00000 {
                // (|x| > 1)^+-inf = inf, 0
                if hy >= 0 { y } else { 0.0 }
            } else if hy >= 0 {
                // (|x| < 1)^+-inf = 0, inf
                0.0
            } else {
                -y
            };
        }
        if iy == 0x3ff00000 {
            return if hy >= 0 { x } else { 1.0 / x };
        }
        if hy == 0x40000000 {
            return x * x;
        }
        if hy == 0x3fe00000 && hx >= 0 {
            // x^0.5 for x >= +0
            return sqrt64(x);
        }
    }
    var ax = x.abs();
    if lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000) {
        // x is +-0, +-inf, +-1
        var z = ax;
        if hy < 0 {
            z = 1.0 / z;
        }
        if hx < 0 {
            if ix - 0x3ff00000 | yisint == 0 {
                // (-1)^non-integer
                z = f64::NAN;
            } else if yisint == 1 {
                z = -z;
            }
        }
        return z;
    }
    var sn = 1.0;
    if hx < 0 {
        if yisint == 0 {
            // (x < 0)^non-integer
            return f64::NAN;
        }
        if yisint == 1 {
            sn = -1.0;
        }
    }
    var t1 = 0.0;
    var t2 = 0.0;
    if iy > 0x41e00000 {
        // |y| > 2^31
        if iy > 0x43f00000 {
            // |y| > 2^64: overflow or underflow
            if ix <= 0x3fefffff {
                return if hy < 0 { HUGE * HUGE } else { TINY * TINY };
            }
            if ix >= 0x3ff00000 {
                return if hy > 0 { HUGE * HUGE } else { TINY * TINY };
            }
        }
        // over/underflow when x is not near 1
        if ix < 0x3fefffff {
            return if hy < 0 { sn * HUGE * HUGE } else { sn * TINY * TINY };
        }
        if ix > 0x3ff00000 {
            return if hy > 0 { sn * HUGE * HUGE } else { sn * TINY * TINY };
        }
        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4
        let t = ax - 1.0;
        let w = t * t * (0.5 - t * (0.3333333333333333333333 - t * 0.25));
        let u = POW_IVLN2_H * t;
        let v = t * POW_IVLN2_L - w * POW_IVLN2;
        t1 = with_lo_word(u + v, 0);
        t2 = v - (t1 - u);
    } else {
        var n: i32 = 0;
        if ix < 0x00100000 {
            // a subnormal
            ax *= TWO53;
            n -= 53;
            ix = hi_word(ax) as i32;
        }
        n += (ix >> 20) - 0x3ff;
        let j = ix & 0x000fffff;
        // the interval
        ix = j | 0x3ff00000;
        var k: i64 = 0;
        if j <= 0x3988E {
            // |x| < sqrt(3/2)
            k = 0;
        } else if j < 0xBB67A {
            // |x| < sqrt(3)
            k = 1;
        } else {
            k = 0;
            n += 1;
            ix -= 0x00100000;
        }
        ax = from_words(ix as u32, lo_word(ax));
        // ss = s_h + s_l = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)
        let bp = POW_BP[k];
        let u = ax - bp;
        let v = 1.0 / (ax + bp);
        let ss = u * v;
        let s_h = with_lo_word(ss, 0);
        // t_h = ax + bp[k], high
        let t_h = from_words((ix as u32 >> 1 | 0x20000000) + 0x00080000 + ((k as u32) << 18), 0);
        let t_l = ax - (t_h - bp);
        let s_l = v * (u - s_h * t_h - s_h * t_l);
        // log(ax)
        let s2 = ss * ss;
        var r = s2 * s2 * (POW_L1 + s2 * (POW_L2 + s2 * (POW_L3 + s2 * (POW_L4 + s2 * (POW_L5
            + s2 * POW_L6)))));
        r += s_l * (s_h + ss);
        let s2h = s_h * s_h;
        let t_h2 = with_lo_word(3.0 + s2h + r, 0);
        let t_l2 = r - (t_h2 - 3.0 - s2h);
        // u + v = ss * (1 + ...)
        let u2 = s_h * t_h2;
        let v2 = s_l * t_h2 + t_l2 * ss;
        // 2/(3 log2) * (ss + ...)
        let p_h = with_lo_word(u2 + v2, 0);
        let p_l = v2 - (p_h - u2);
        let z_h = POW_CP_H * p_h;
        let z_l = POW_CP_L * p_h + p_l * POW_CP + POW_DP_L[k];
        // log2(ax) = (ss + ..) * 2/(3 log2) = n + dp_h + z_h + z_l
        let t = n as f64;
        t1 = with_lo_word(z_h + z_l + POW_DP_H[k] + t, 0);
        t2 = z_l - (t1 - t - POW_DP_H[k] - z_h);
    }
    // (y1 + y2) * (t1 + t2), y split
    let y1 = with_lo_word(y, 0);
    let p_l = (y - y1) * t1 + y * t2;
    var p_h = y1 * t1;
    let z = p_l + p_h;
    var j = hi_word(z) as i32;
    let i = lo_word(z) as i32;
    if j >= 0x40900000 {
        // z >= 1024
        if j - 0x40900000 | i != 0 {
            return sn * HUGE * HUGE;
        }
        if p_l + POW_OVT > z - p_h {
            return sn * HUGE * HUGE;
        }
    } else if j & 0x7fffffff >= 0x4090cc00 {
        // z <= -1075
        if (j as u32 - 0xc090cc00) | i as u32 != 0 {
            return sn * TINY * TINY;
        }
        if p_l <= z - p_h {
            return sn * TINY * TINY;
        }
    }
    // 2^(p_h + p_l)
    let ia = j & 0x7fffffff;
    var k = (ia >> 20) - 0x3ff;
    var n: i32 = 0;
    if ia > 0x3fe00000 {
        // |z| > 0.5: n = [z + 0.5]
        n = j + (0x00100000 >> (k + 1));
        k = ((n & 0x7fffffff) >> 20) - 0x3ff;
        let t = from_words((n & ~(0x000fffff >> k)) as u32, 0);
        n = (n & 0x000fffff | 0x00100000) >> (20 - k);
        if j < 0 {
            n = -n;
        }
        p_h -= t;
    }
    let t = with_lo_word(p_l + p_h, 0);
    let u = t * POW_LG2_H;
    let v = (p_l - (t - p_h)) * POW_LG2 + t * POW_LG2_L;
    var zz = u + v;
    let w = v - (zz - u);
    let tt = zz * zz;
    let tt1 = zz - tt * (EXP_P1 + tt * (EXP_P2 + tt * (EXP_P3 + tt * (EXP_P4 + tt * EXP_P5))));
    let r = zz * tt1 / (tt1 - 2.0) - (w + zz * w);
    zz = 1.0 - (r - zz);
    j = hi_word(zz) as i32;
    j += n << 20;
    if j >> 20 <= 0 {
        // a subnormal result
        zz = scalbn(zz, n);
    } else {
        zz = from_words(j as u32, lo_word(zz));
    }
    sn * zz
}
