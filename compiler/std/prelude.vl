// The prelude: what every rust-edition module sees without a `use`.
// Rust's own list (std::prelude::rust_2024), less what vole has not got
// (`ToString`, `FromIterator` and `ToOwned` become their `_In` forms,
// there are no macros) and with vole's: `Gpa`, `DefaultIn`, and the
// format functions, which are functions whose format literal the
// compiler checks (`println("{x}")`; plan §3). `Send`, `Sync`, `Sized`,
// `AllocFree` and the `Fn` traits are the compiler's and need no `use`.
// `HashMap` is not in it, as in Rust: `use std::collections::HashMap;`.

pub use crate::alloc::Gpa;
pub use crate::borrow::ToOwnedIn;
pub use crate::boxed::Box;
pub use crate::clone::Clone;
pub use crate::cmp::{Eq, Ord, PartialEq, PartialOrd};
pub use crate::convert::{AsMut, AsRef, From, Into, TryFrom, TryInto};
pub use crate::default::{Default, DefaultIn};
pub use crate::fmt::{eprint, eprintln, format_args, format_in, print, println, write, writeln};
pub use crate::iter::{
    DoubleEndedIterator, ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator,
};
pub use crate::marker::Copy;
pub use crate::mem::drop;
pub use crate::ops::Drop;
pub use crate::option::Option;
pub use crate::option::Option::{None, Some};
pub use crate::panic::{
    assert, assert_eq, assert_ne, debug_assert, panic, todo, unimplemented, unreachable,
};
pub use crate::result::Result;
pub use crate::result::Result::{Err, Ok};
pub use crate::string::{String, ToStringIn};
pub use crate::vec::Vec;
