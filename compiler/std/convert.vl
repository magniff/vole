impl TryFrom<u64> for isize {
    type Error = TryFromIntError;

    fn try_from(x: u64) -> Result<isize, TryFromIntError> {
        if x > 9223372036854775807 { Result::Err(TryFromIntError {}) }
        else { Result::Ok(x as isize) }
    }
}

impl TryFrom<usize> for isize {
    type Error = TryFromIntError;

    fn try_from(x: usize) -> Result<isize, TryFromIntError> {
        if x > 9223372036854775807 { Result::Err(TryFromIntError {}) }
        else { Result::Ok(x as isize) }
