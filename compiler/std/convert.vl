impl TryFrom<isize> for i8 {
    type Error = TryFromIntError;

    fn try_from(x: isize) -> Result<i8, TryFromIntError> {
        if x < 0 - 128 || x > 127 { Result::Err(TryFromIntError {}) } else { Result::Ok(x as i8) }
    }
}

impl TryFrom<isize> for i16 {
    type Error = TryFromIntError;

    fn try_from(x: isize) -> Result<i16, TryFromIntError> {
