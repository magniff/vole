// std::convert: From, Into, TryFrom, TryInto, AsRef, AsMut, Infallible.
// `?` converts an error through From only (plan §3). A conversion that
// allocates is not From: `String::from_in(s, a)`, not `String::from(s)`.

use crate::result::Result;

// A conversion that cannot fail: `i64::from(3u8)`, `Some(x)` from x.
pub trait From<T>: Sized {
    fn from(value: T) -> Self;
}

// From's other side: `let n: i64 = b.into();`. Implement From, not Into.
pub trait Into<T>: Sized {
    fn into(self) -> T;
}

// later: blanket_impl
impl<T, U: From<T>> Into<U> for T {
    fn into(self) -> U {
        U::from(self)
    }
}

// A conversion that may fail: `u8::try_from(300i64)` is an Err.
pub trait TryFrom<T>: Sized {
    type Error;

    fn try_from(value: T) -> Result<Self, Self::Error>;
}

// TryFrom's other side.
pub trait TryInto<T>: Sized {
    type Error;

    fn try_into(self) -> Result<T, Self::Error>;
}

// later: blanket_impl
impl<T, U: TryFrom<T>> TryInto<U> for T {
    type Error = U::Error;

    fn try_into(self) -> Result<U, U::Error> {
        U::try_from(self)
    }
}

// A cheap view as &T: `fn open<P: AsRef<str>>(p: P)` takes a &str, a
// String<A> or a &String<A>.
pub trait AsRef<T: ?Sized> {
    fn as_ref(&self) -> &T;
}

// A cheap view as &mut T.
pub trait AsMut<T: ?Sized> {
    fn as_mut(&mut self) -> &mut T;
}

// A reference views as what it refers to does (Rust's `impl AsRef<U> for
// &T`): `open("x")` with `P: AsRef<str>`, P = &str (Z9.1c, 0.27.4).
impl<T: ?Sized + AsRef<U>, U: ?Sized> AsRef<U> for &T {
    fn as_ref(&self) -> &U {
        AsRef::as_ref(*self)
    }
}

impl<T: ?Sized + AsRef<U>, U: ?Sized> AsRef<U> for &mut T {
    fn as_ref(&self) -> &U {
        AsRef::as_ref(&**self)
    }
}

impl<T: ?Sized + AsMut<U>, U: ?Sized> AsMut<U> for &mut T {
    fn as_mut(&mut self) -> &mut U {
        AsMut::as_mut(*self)
    }
}

// The error of a conversion that cannot fail: it has no value.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum Infallible {}

// The error of a narrowing integer conversion (`u8::try_from(300)`): which
// side of the type's range the value was on (Rust's, and its Debug).
// MVS's TryFromIntError, kept.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct TryFromIntError(crate::str::IntErrorKind);

// (for std's integer conversions, compiler/std/intconv.vl: the value was
// below the type's smallest, or above its largest)
#[effects()]
pub(crate) fn int_range_error(below: bool) -> TryFromIntError {
    TryFromIntError(if below { crate::str::IntErrorKind::NegOverflow }
        else { crate::str::IntErrorKind::PosOverflow })
}

impl crate::fmt::Display for TryFromIntError {
    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {
        f.write_str("out of range integral type conversion attempted")
    }
}

// `?` on a conversion that cannot fail, in a function that returns the
// error of one that can (Rust's).
impl From<Infallible> for TryFromIntError {
    fn from(x: Infallible) -> TryFromIntError {
        match x {}
    }
}
