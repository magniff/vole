    }
}

impl TryFrom<isize> for u8 {
    type Error = TryFromIntError;

    fn try_from(x: isize) -> Result<u8, TryFromIntError> {
        if x < 0 || x > 255 { Result::Err(TryFromIntError {}) } else { Result::Ok(x as u8) }
    }
}

impl TryFrom<isize> for u16 {
    type Error = TryFromIntError;

    fn try_from(x: isize) -> Result<u16, TryFromIntError> {
        if x < 0 || x > 65535 { Result::Err(TryFromIntError {}) } else { Result::Ok(x as u16) }
    }
}

impl TryFrom<isize> for u32 {
    type Error = TryFromIntError;

    fn try_from(x: isize) -> Result<u32, TryFromIntError> {
