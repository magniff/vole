// std::convert: From and Into (0.20: from flat/convert.vl).

// `AppError::from(e)`; what `?` converts an error with.
pub trait From<T> { fn from(x: T) -> Self; }

// Implement From, not Into.
pub trait Into<T> { fn into(self) -> T; }

// (0.26.2) Rust's fallible conversion. std implements it between usize or
// isize and the other integer types where `as` could lose the value (and
// between usize and u64, isize and i64, which `as` converts too):
// `usize::try_from(n)?`, `u32::try_from(len)`. TryFromIntError when the
// value does not fit.
pub trait TryFrom<T> {
    type Error;
    fn try_from(x: T) -> Result<Self, Self::Error>;
}

// The value does not fit the target type (Rust's TryFromIntError).
#[derive(Eq, Debug, Clone)]
pub struct TryFromIntError {}

impl std::Display for TryFromIntError {
    fn fmt(self, f: inout std::Fmt) {
        f.str("out of range integral type conversion attempted");
    }
}

impl TryFrom<i8> for usize {
    type Error = TryFromIntError;

    fn try_from(x: i8) -> Result<usize, TryFromIntError> {
        if x < 0 { Result::Err(TryFromIntError {}) } else { Result::Ok(x as usize) }
    }
}

impl TryFrom<i16> for usize {
    type Error = TryFromIntError;

    fn try_from(x: i16) -> Result<usize, TryFromIntError> {
        if x < 0 { Result::Err(TryFromIntError {}) } else { Result::Ok(x as usize) }
    }
}

impl TryFrom<i32> for usize {
    type Error = TryFromIntError;

    fn try_from(x: i32) -> Result<usize, TryFromIntError> {
