// ---- The target's system (0.20) ----

// The end of std's text (front/stdalloc.vl, std_sys_source): what differs
// between the targets' C libraries, for sys/unix.vl. sys/linux.vl has
// the same items, in the same order, and the same length to the byte
// (embed.sh checks it), so that std's index holds for every target; the
// numbers are written as 8 hex digits for that.
// (macOS's values: <sys/fcntl.h>, <sys/errno.h>, <time.h>, <sys/ttycom.h>,
// <sys/signal.h>; errno is the int that __error() points to, C.)

// 0: macOS, 1: Linux.
pub const TARGET_OS: i64 = 0x00000000;

pub const SYS_O_CREAT: i32 = 0x00000200;
pub const SYS_O_TRUNC: i32 = 0x00000400;
pub const SYS_O_APPEND: i32 = 0x00000008;
pub const SYS_O_EXCL: i32 = 0x00000800;
pub const SYS_O_NONBLOCK: i32 = 0x00000004;
pub const SYS_O_CLOEXEC: i32 = 0x01000000;
pub const SYS_O_NOCTTY: i32 = 0x00020000;
pub const SYS_O_DIRECTORY: i32 = 0x00100000;

pub const SYS_EAGAIN: i32 = 0x00000023;
pub const SYS_ENOTEMPTY: i32 = 0x00000042;
pub const SYS_ETIMEDOUT: i32 = 0x0000003c;
pub const SYS_ENOSYS: i32 = 0x0000004e;
pub const SYS_ENOTSUP: i32 = 0x0000002d;
pub const SYS_ENAMETOOLONG: i32 = 0x0000003f;
pub const SYS_ELOOP: i32 = 0x0000003e;

pub const SYS_CLOCK_MONOTONIC: i32 = 0x00000006;
pub const SYS_PATH_MAX: i64 = 0x00000400;
pub const SYS_SIGCHLD: i32 = 0x00000014;
pub const SYS_TIOCSWINSZ: u64 = 0x80087467;
pub const SYS_TIOCGWINSZ: u64 = 0x40087468;
pub const SYS_TIOCSCTTY: u64 = 0x20007461;

// UNSAFE: errno's address, from the C library.
// SAFETY: __error takes nothing and returns this thread's errno, an int
// valid for the thread's life.
extern "C" {
    #[link_name = "__error"]
    #[effects(global)]
    fn sys_errno_location() -> *i32;
}

// (0.25.4) C's message for an errno, into a buffer of the caller's.
// UNSAFE: a C library call that writes through a raw pointer.
// SAFETY: XSI strerror_r(int, char *, size_t), string.h; it writes at most
// n bytes, its NUL included (sys_strerror_into passes a local buffer).
extern "C" {
    #[link_name = "strerror_r"]
    #[effects(global)]
    fn sys_c_strerror_r(e: i32, buf: *u8, n: u64) -> i32;
}

// (0.21) Waiting on a 32-bit word (std::sync's locks): __ulock_wait with
// UL_COMPARE_AND_WAIT | ULF_NO_ERRNO, __ulock_wake (ULF_WAKE_ALL for all).
pub const SYS_SC_NPROCESSORS_ONLN: i32 = 0x0000003a;

// UNSAFE: libSystem's __ulock_wait and __ulock_wake, which take a raw
// address.
// SAFETY: the prototypes are xnu's (bsd/sys/ulock.h); the kernel only
// compares the u32 at addr (wait), or wakes its waiters.
extern "C" {
    #[link_name = "__ulock_wait"]
    #[effects(sync)]
    fn sys_c_ulock_wait(op: u32, addr: *u8, value: u64, timeout_us: u32) -> i32;
    #[link_name = "__ulock_wake"]
    #[effects(sync)]
    fn sys_c_ulock_wake(op: u32, addr: *u8, value: u64) -> i32;
}

// Sleeps while *addr is `expected`, or until woken (spuriously too).
// UNSAFE: the kernel reads *addr through a raw pointer.
// SAFETY: (the caller's obligation) addr points to a live, 4-aligned u32
// (one of std::sync's atomic words), live until the wait returns.
pub unsafe fn sys_futex_wait(addr: *u32, expected: u32) {
    sys_c_ulock_wait(0x01000001, addr as *u8, expected as u64, 0);
}

// Wakes one thread sleeping on addr, or all.
// UNSAFE: the kernel is given a raw address.
// SAFETY: (the caller's obligation) addr points to a live u32 that threads
// may wait on; a wake reads nothing through it.
pub unsafe fn sys_futex_wake(addr: *u32, all: bool) {
    sys_c_ulock_wake(if all { 0x01000101 } else { 0x01000001 }, addr as *u8, 0);
}

// (0.20) The program's arguments (std::env::args): argc, and argv, its C
// strings. macOS: crt's own, which _NSGetArgc and _NSGetArgv point to.
pub fn sys_args() -> (i64, **u8) {
    // UNSAFE: reads crt's argc and argv through the raw pointers libSystem
    // gives.
    // SAFETY: _NSGetArgc and _NSGetArgv point to crt's argc and argv, set
    // before main and valid for the process's life.
    unsafe { (*sys_argc_location() as i64, *sys_argv_location()) }
}

// UNSAFE: libSystem's _NSGetArgc and _NSGetArgv, which return raw
// pointers.
// SAFETY: the prototypes are crt_externs.h's; they take nothing.
extern "C" {
    #[link_name = "_NSGetArgc"]
    #[effects(global)]
    fn sys_argc_location() -> *i32;
    #[link_name = "_NSGetArgv"]
    #[effects(global)]
    fn sys_argv_location() -> ***u8;
}
// (padding: the two systems' files are the same length)
