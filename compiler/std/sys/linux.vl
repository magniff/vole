// ---- The target's system (0.20) ----

// The end of std's text (front/stdalloc.vl, std_sys_source): what differs
// between the targets' C libraries, for sys/unix.vl. sys/macos.vl has
// the same items, in the same order, and the same length to the byte
// (embed.sh checks it), so that std's index holds for every target; the
// numbers are written as 8 hex digits for that.
// (Linux's values, aarch64 glibc: <fcntl.h>, <errno.h>, <time.h>, ioctls
// <asm/ioctls.h>, <signal.h>; errno: __errno_location().)

// 0: macOS, 1: Linux.
pub const TARGET_OS: i64 = 0x00000001;

pub const SYS_O_CREAT: i32 = 0x00000040;
pub const SYS_O_TRUNC: i32 = 0x00000200;
pub const SYS_O_APPEND: i32 = 0x00000400;
pub const SYS_O_EXCL: i32 = 0x00000080;
pub const SYS_O_NONBLOCK: i32 = 0x00000800;
pub const SYS_O_CLOEXEC: i32 = 0x00080000;
pub const SYS_O_NOCTTY: i32 = 0x00000100;
pub const SYS_O_DIRECTORY: i32 = 0x00004000;

pub const SYS_EAGAIN: i32 = 0x0000000b;
pub const SYS_ENOTEMPTY: i32 = 0x00000027;
pub const SYS_ETIMEDOUT: i32 = 0x0000006e;
pub const SYS_ENOSYS: i32 = 0x00000026;
pub const SYS_ENOTSUP: i32 = 0x0000005f;
pub const SYS_ENAMETOOLONG: i32 = 0x00000024;
pub const SYS_ELOOP: i32 = 0x00000028;

pub const SYS_CLOCK_MONOTONIC: i32 = 0x00000001;
pub const SYS_PATH_MAX: i64 = 0x00001000;
pub const SYS_SIGCHLD: i32 = 0x00000011;
pub const SYS_TIOCSWINSZ: u64 = 0x00005414;
pub const SYS_TIOCGWINSZ: u64 = 0x00005413;
pub const SYS_TIOCSCTTY: u64 = 0x0000540e;

// UNSAFE: C. SAFETY: this thread's errno's address, valid for its life.
extern "C" {
    #[link_name = "__errno_location"]
    #[effects(global)]
    fn sys_errno_location() -> *i32;
}

// (0.25.4) XSI strerror_r (glibc's __xpg_strerror_r): C's message for an
// errno, into the caller's n bytes, its NUL included. UNSAFE: C. SAFETY:
// string.h's prototype.
extern "C" {
    #[link_name = "__xpg_strerror_r"]
    #[effects(global)]
    fn sys_c_strerror_r(e: i32, buf: *u8, n: u64) -> i32;
}

// (0.21) Waiting on a 32-bit word (std::sync's locks): the futex system
// call (98 on aarch64), FUTEX_WAIT_PRIVATE and FUTEX_WAKE_PRIVATE.
// (x86-64's number is 202: x86-64 is compiled, not run, in 0.21.0.)
//-----------------------------------------------------
pub const SYS_SC_NPROCESSORS_ONLN: i32 = 0x00000054;

// UNSAFE: C. SAFETY: syscall(long, ...): seven words, in registers on
// aarch64 as for the variadic call.
extern "C" {
    #[link_name = "syscall"]
    #[effects(sync)]
    fn sys_c_futex(n: i64, addr: *u32, op: i64, val: i64, t: *u8, a: i64, b: i64) -> i64;
}

// Sleeps while *addr is `expected`, or until woken (spuriously too).
// UNSAFE: a raw address. SAFETY: the caller's: a live, 4-aligned u32.
pub unsafe fn sys_futex_wait(addr: *u32, expected: u32) {
    sys_c_futex(98, addr, 128, expected as i64, 0 as *u8, 0, 0);
}

// Wakes one thread sleeping on addr, or all.
// UNSAFE: a raw address. SAFETY: the caller's: a live u32 (nothing read).
pub unsafe fn sys_futex_wake(addr: *u32, all: bool) {
    sys_c_futex(98, addr, 129, if all { 2147483647 } else { 1 }, 0 as *u8, 0, 0);
}

// (0.20) The program's arguments (std::env::args): argc, and argv, its C
// strings. Linux: /proc/self/cmdline, read once (up to 128 KB and 4096
// arguments) into std's statics, its NULs ending each argument.
// (0.25: through libc's open, read and close declared here, not
// std::sys's: std's one index is made from sys/macos.vl, whose sys_args
// names nothing of std::sys, so env::args alone did not load it.)
static var SYS_ARG_TEXT: [u8; 131072] = [0; 131072];
static var SYS_ARG_PTRS: [*u8; 4097] = [0 as *u8; 4097];
static var SYS_ARG_COUNT: i64 = -1;

// UNSAFE: C. SAFETY: POSIX's prototypes (open variadic, as declared).
extern "C" {
    #[link_name = "open"]
    #[effects(io)]
    fn sys_c_args_open(path: *u8, flags: i32, ...) -> i32;
    #[link_name = "read"]
    #[effects(io)]
    fn sys_c_args_read(fd: i32, buf: *u8, n: u64) -> i64;
    #[link_name = "close"]
    #[effects(io)]
    fn sys_c_args_close(fd: i32) -> i32;
}

pub fn sys_args() -> (i64, **u8) {
    if SYS_ARG_COUNT < 0 {
        SYS_ARG_COUNT = 0;
        var len = 0;
        // UNSAFE: C. SAFETY: a NUL-ended literal path.
        let fd = unsafe { sys_c_args_open(c"/proc/self/cmdline", 0) };
        if fd >= 0 {
            loop {
                let room = (131071 - len) as u64;
                // UNSAFE: C writes. SAFETY: room bytes at [len] (checked) fit
                // the static, its last byte kept 0.
                let n = unsafe { sys_c_args_read(fd, &SYS_ARG_TEXT[len] as *u8, room) };
                if n <= 0 {
                    break;
                }
                len += n;
            }
            // UNSAFE: C. SAFETY: an int.
            let _ = unsafe { sys_c_args_close(fd) };
        }
        var start = 0;
        for i in 0..len {
            if SYS_ARG_TEXT[i] == 0 && SYS_ARG_COUNT < 4096 {
                SYS_ARG_PTRS[SYS_ARG_COUNT] = &SYS_ARG_TEXT[start] as *u8;
                SYS_ARG_COUNT += 1;
                start = i + 1;
            }
        }
    }
    (SYS_ARG_COUNT, &SYS_ARG_PTRS[0] as **u8)
}
// (padding: the two systems' files are the same length)
