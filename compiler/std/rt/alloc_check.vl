// Gpa's implementation with --check-alloc (Z5): the checking allocator,
// MVS's (compiler/std/alloc_check.vl) in std2's spellings. Not a module of
// std2's tree: compiler/std/embed.sh --edition rust embeds it as
// std2_check_gpa_source, and the compiler's tail (front/stdalloc.vl:
// std2_tail) puts it in `std::__gpa` with --check-alloc, after
// CHECK_ALLOC_OS (0 macOS, 1 Linux); `std::CHECK_ALLOC_SITE` is the static
// the compiled program stores each allocating call's site in
// (middle/checkalloc.vl).
//
// Every block gets pages of its own, at the cursor of a large reservation
// of address space with no access: a block's pages are made readable and
// writable when it is allocated, and are given back with no access when
// it is freed, never to be handed out again (every grow moves: the
// Allocator's default grow). A later access to a freed block faults, and
// the fault handler names the block, where it was allocated and where
// freed. Frees are checked: double, invalid and wrong-size frees stop the
// program (exit 101); the blocks left at exit are listed on stderr (the
// exit status is unchanged). Block numbers count every allocation from 1,
// the same each run: VOLE_ALLOC_TRAP=N raises SIGTRAP when block N is
// allocated, for a debugger. Arenas over a Gpa take their chunks here.

use crate::alloc::{AllocError, Layout};
use crate::option::Option;
use crate::ptr::NonNull;
use crate::result::Result;

// UNSAFE: the system's memory maps, signals and exit, and C's realloc and
// memcpy for the table and the moves.
// SAFETY: the prototypes are sys/mman.h's, signal.h's, stdlib.h's,
// string.h's and unistd.h's; each call below says why its arguments are
// valid.
extern "C" {
    // (0.28.0, as MVS's: its messages and stops are the allocator's misuse,
    // the effect `alloc`: not io, which an allocator may not do)
    #[link_name = "mmap"]
    #[effects(alloc(extern), static)]
    fn check_c_mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, offset: i64)
        -> *mut u8;
    #[link_name = "mprotect"]
    #[effects(alloc(extern), static)]
    fn check_c_mprotect(addr: *mut u8, len: usize, prot: i32) -> i32;
    #[link_name = "getpagesize"]
    #[effects(static)]
    fn check_c_getpagesize() -> i32;
    #[link_name = "getenv"]
    #[effects(static)]
    fn check_c_getenv(name: *const u8) -> *const u8;
    #[link_name = "raise"]
    #[effects(static)]
    fn check_c_raise(sig: i32) -> i32;
    #[link_name = "atexit"]
    #[effects(static)]
    fn check_c_atexit(f: extern "C" fn()) -> i32;
    #[link_name = "sigaction"]
    #[effects(static)]
    fn check_c_sigaction(sig: i32, act: *const CheckSigaction, old: *mut CheckSigaction) -> i32;
    #[link_name = "write"]
    #[effects(static)]
    fn check_c_write(fd: i32, data: *const u8, count: usize) -> isize;
    #[link_name = "realloc"]
    #[effects(alloc(extern))]
    fn check_c_realloc(p: *mut u8, size: usize) -> *mut u8;
    #[link_name = "_exit"]
    #[effects(diverge)]
    fn check_c_exit(code: i32) -> !;
}

// std's atomic intrinsics (the lowering makes ATOMIC instructions of a std
// function named so; middle/lower/atomic.vl): the lock's.
// UNSAFE: a raw pointer. SAFETY: p is valid and aligned (CHECK_LOCK's,
// CHECK_OWNER's).
unsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {
    crate::panic::unreachable("an intrinsic")
}

// UNSAFE: a raw pointer. SAFETY: as atomic_cas.
unsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {
    crate::panic::unreachable("an intrinsic")
}

// UNSAFE: a raw pointer. SAFETY: as atomic_cas.
unsafe fn atomic_load<T>(p: *const T, order: i64) -> T {
    crate::panic::unreachable("an intrinsic")
}

// Threads: each entry below holds this lock (0 free, 1 taken), so the
// tables are never changed by two threads at once. The fault handler takes
// nothing (it stops the program). CHECK_ALLOC_SITE is stored by the program
// without it: under threads a block may name another thread's call.
static mut CHECK_LOCK: u32 = 0;
// The thread holding CHECK_LOCK (0: none): --check-unsafe checks the
// allocator's own raw accesses too, through check_alloc_access, inside an
// entry that holds the lock, so the lock is taken again by no one.
static mut CHECK_OWNER: u64 = 0;

// UNSAFE: C. SAFETY: pthread.h's prototype (pthread_t as u64).
extern "C" {
    #[link_name = "pthread_self"]
    #[effects()]
    fn check_thread_self() -> u64;
}

// Takes CHECK_LOCK unless this thread holds it: whether it did.
fn check_lock() -> bool {
    // UNSAFE: C, and the lock's and the owner's words, through the atomic
    // intrinsics.
    // SAFETY: pthread_self takes nothing; CHECK_LOCK and CHECK_OWNER are
    // statics, valid and aligned, only ever accessed atomically. The owner
    // is this thread only when this thread stored it, under the lock.
    unsafe {
        let me = check_thread_self();
        let o: *mut u64 = &raw mut CHECK_OWNER;
        if atomic_load(o, 0) == me {
            return false;
        }
        let p: *mut u32 = &raw mut CHECK_LOCK;
        while atomic_cas(p, 0, 1, 1) != 0 {}
        atomic_store(o, me, 0);
        true
    }
}

// Lets CHECK_LOCK go when check_lock took it.
fn check_unlock(took: bool) {
    if !took {
        return;
    }
    // UNSAFE: as check_lock. SAFETY: as check_lock's.
    unsafe {
        let o: *mut u64 = &raw mut CHECK_OWNER;
        atomic_store(o, 0, 0);
        let p: *mut u32 = &raw mut CHECK_LOCK;
        atomic_store(p, 0, 2);
    }
}

// A block: its pages [start, start + span), its size, its state, and where
// it was allocated and freed.
struct CheckBlock {
    start: usize,
    size: usize,
    span: usize,
    state: usize,
    alloc_site: *const u8,
    free_site: *const u8,
}

const CHECK_LIVE_BLOCK: usize = 1;
const CHECK_FREED: usize = 2;

// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).
static mut CHECK_BLOCKS: *mut CheckBlock = 0 as *mut CheckBlock;
static mut CHECK_COUNT: usize = 0;
static mut CHECK_CAP: usize = 0;
// The live blocks.
static mut CHECK_LIVE: usize = 0;
// The reservations of address space (regions): their bounds and their
// first block; a region's blocks follow each other, so the blocks are
// sorted by address within one. The cursor is in the last region.
const CHECK_MAX_REGIONS: usize = 256;
static mut CHECK_REGION_START: [usize; 256] = [0; 256];
static mut CHECK_REGION_END: [usize; 256] = [0; 256];
static mut CHECK_REGION_FIRST: [usize; 256] = [0; 256];
static mut CHECK_REGIONS: usize = 0;
static mut CHECK_CURSOR: usize = 0;
// The page size, 0 until the first allocation.
static mut CHECK_PAGE: usize = 0;
// VOLE_ALLOC_TRAP; VOLE_ALLOC_MAX_LIVE (the map limit's message when this
// many blocks are live); 0 when unset.
static mut CHECK_TRAP: usize = 0;
static mut CHECK_MAX_LIVE: usize = 0;
// The changes to the blocks (allocations and frees), and their count when
// check_leaks listed the leaks (the exit's list is left out then).
static mut CHECK_CHANGES: usize = 0;
static mut CHECK_LISTED: usize = 0;
static mut CHECK_EVER_LISTED: bool = false;

const CHECK_REGION_BYTES: usize = 68719476736;
const CHECK_PROT_NONE: i32 = 0;
const CHECK_PROT_RW: i32 = 3;
const CHECK_MAP_FIXED: i32 = 16;

// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).
fn check_map_flags() -> i32 {
    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE
    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }
}

fn check_sigbus() -> i32 {
    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }
}

// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,
// or (glibc) a 128-byte mask and the flags.
#[repr(C)]
struct CheckSigaction {
    handler: extern "C" fn(i32, *mut u8, *mut u8),
    words: [u64; 19],
}

fn check_sigaction() -> CheckSigaction {
    let mut a = CheckSigaction { handler: check_fault, words: [0; 19] };
    if CHECK_ALLOC_OS == 1 {
        // SA_SIGINFO | SA_RESETHAND
        a.words[16] = 4 | 2147483648;
    } else {
        a.words[0] = (64 | 4) << 32;
    }
    a
}

// The offset of si_addr in siginfo_t.
fn check_si_addr() -> usize {
    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }
}

// A message, written to stderr at once.
struct CheckMsg {
    len: usize,
    bytes: [u8; 2048],
}

impl CheckMsg {
    fn new() -> CheckMsg {
        CheckMsg { len: 0, bytes: [0; 2048] }
    }

    fn byte(&mut self, b: u8) {
        if self.len < 2048 {
            self.bytes[self.len] = b;
            self.len += 1;
        }
    }

    fn text(&mut self, s: &str) {
        let b = s.as_bytes();
        let mut i: usize = 0;
        while i < b.len() {
            self.byte(b[i]);
            i += 1;
        }
    }

    // UNSAFE: s must be a C string.
    // SAFETY: a contract on the caller: every site is a string literal's.
    unsafe fn cstr(&mut self, s: *const u8) {
        let mut n: usize = 0;
        // UNSAFE: the string's bytes, to its 0.
        // SAFETY: the caller's contract: s is a C string.
        unsafe {
            while *s.add(n) != 0 {
                self.byte(*s.add(n));
                n += 1;
            }
        }
    }

    fn int(&mut self, v: usize) {
        if v >= 10 {
            self.int(v / 10);
        }
        self.byte(b'0' + (v % 10) as u8);
    }

    fn hex(&mut self, v: usize) {
        self.text("0x");
        let digits = "0123456789abcdef".as_bytes();
        let mut started = false;
        let mut k: usize = 0;
        while k < 16 {
            let d = (v >> ((15 - k) * 4)) & 15;
            if d != 0 || started || k == 15 {
                started = true;
                self.byte(digits[d]);
            }
            k += 1;
        }
    }

    fn site(&mut self, s: *const u8) {
        if s.is_null() {
            self.text("an unknown place");
        } else {
            // UNSAFE: a site, stored by the compiled program.
            // SAFETY: every site is a string literal's C string.
            unsafe { self.cstr(s) }
        }
    }

    fn out(&mut self) {
        self.byte(b'\n');
        // UNSAFE: write(2) of the message's bytes.
        // SAFETY: bytes holds len initialized bytes.
        unsafe {
            check_c_write(2, &self.bytes[0] as *const u8, self.len);
        }
    }
}

// Stops the program with message m (exit 101, without the leaks' list).
fn check_stop(m: &mut CheckMsg) -> ! {
    m.out();
    // UNSAFE: _exit. SAFETY: it takes any code.
    unsafe { check_c_exit(101) }
}

// Block b, read from the table.
// UNSAFE: b < CHECK_COUNT.
// SAFETY: a contract on the caller; the table holds CHECK_COUNT blocks.
unsafe fn check_block(b: usize) -> *mut CheckBlock {
    // UNSAFE: an offset into the table. SAFETY: the caller's: b is in it.
    unsafe { CHECK_BLOCKS.add(b) }
}

// `block #N (48 bytes), allocated at X[, freed at Y]`.
// UNSAFE: b < CHECK_COUNT. SAFETY: a contract on the caller.
unsafe fn check_describe(m: &mut CheckMsg, b: usize) {
    // UNSAFE: block b. SAFETY: the caller's: b is in the table.
    unsafe {
        let k = check_block(b);
        m.text("block #");
        m.int(b + 1);
        m.text(" (");
        m.int((*k).size);
        m.text(if (*k).size == 1 { " byte)" } else { " bytes)" });
        m.text(", allocated at ");
        m.site((*k).alloc_site);
        if (*k).state != CHECK_LIVE_BLOCK {
            m.text(", freed at ");
            m.site((*k).free_site);
        }
    }
}

// The decimal number in environment variable `name` (a C string; 0 when
// unset or none).
fn check_env_int(name: &str) -> usize {
    // UNSAFE: getenv of a C string; its result read to its 0.
    // SAFETY: name ends in a 0 (the callers' literals); getenv's result is
    // null or a C string.
    unsafe {
        let s = check_c_getenv(name.as_ptr());
        if s.is_null() {
            return 0;
        }
        let mut v: usize = 0;
        let mut i: usize = 0;
        while *s.add(i) >= b'0' && *s.add(i) <= b'9' {
            v = v * 10 + (*s.add(i) - b'0') as usize;
            i += 1;
        }
        v
    }
}

// The first allocation: the page size, the fault handlers, the leaks' list
// at exit, the environment.
fn check_init() {
    // UNSAFE: the system's calls, and the checker's statics (under the lock).
    // SAFETY: a is a valid sigaction for both signals; check_at_exit takes
    // nothing.
    unsafe {
        CHECK_PAGE = check_c_getpagesize() as usize;
        let a = check_sigaction();
        check_c_sigaction(11, &a, crate::ptr::null_mut());
        check_c_sigaction(check_sigbus(), &a, crate::ptr::null_mut());
        check_c_atexit(check_at_exit);
        CHECK_TRAP = check_env_int("VOLE_ALLOC_TRAP\0");
        CHECK_MAX_LIVE = check_env_int("VOLE_ALLOC_MAX_LIVE\0");
    }
}

// The system refused to change a block's pages: on Linux, the limit of
// memory maps (each run of live blocks between freed ones is a map).
fn check_map_limit() -> ! {
    let mut m = CheckMsg::new();
    m.text("check-alloc: out of memory maps at block #");
    // UNSAFE: the checker's statics. SAFETY: under the lock.
    unsafe {
        m.int(CHECK_COUNT + 1);
        m.text(", with ");
        m.int(CHECK_LIVE);
    }
    m.text(" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)");
    m.text("\ntry: sudo sysctl vm.max_map_count=1048576");
    check_stop(&mut m)
}

// A new region of at least `bytes`, or false.
fn check_reserve(bytes: usize) -> bool {
    // UNSAFE: mmap of address space with no access; the checker's statics.
    // SAFETY: a fresh mapping (no address asked for); under the lock.
    unsafe {
        if CHECK_REGIONS == CHECK_MAX_REGIONS {
            return false;
        }
        let mut size = CHECK_REGION_BYTES;
        while size < bytes {
            size = size * 2;
        }
        loop {
            let p = check_c_mmap(crate::ptr::null_mut(), size, CHECK_PROT_NONE, check_map_flags(),
                -1, 0);
            if p as isize != -1 {
                let r = CHECK_REGIONS;
                CHECK_REGION_START[r] = p as usize;
                CHECK_REGION_END[r] = p as usize + size;
                CHECK_REGION_FIRST[r] = CHECK_COUNT;
                CHECK_REGIONS += 1;
                CHECK_CURSOR = p as usize;
                return true;
            }
            // (less address space: smaller reservations)
            if size / 2 < bytes || size <= 1073741824 {
                return false;
            }
            size = size / 2;
        }
    }
}

// A new block of size bytes (> 0) on pages of its own, or null when out of
// memory.
fn check_new_block(size: usize) -> *mut u8 {
    // UNSAFE: the pages made readable and writable; the table grown with
    // realloc and written; the checker's statics.
    // SAFETY: [cursor, cursor + span) is in the last region, never handed
    // out before; the table has room for the new block; under the lock.
    unsafe {
        if CHECK_PAGE == 0 {
            check_init();
        }
        if size > 4611686018427387904 {
            return crate::ptr::null_mut();
        }
        let page = CHECK_PAGE;
        let span = (size + page - 1) / page * page;
        if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {
            if !check_reserve(span) {
                return crate::ptr::null_mut();
            }
        }
        if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {
            check_map_limit();
        }
        let p = CHECK_CURSOR as *mut u8;
        if check_c_mprotect(p, span, CHECK_PROT_RW) != 0 {
            if CHECK_ALLOC_OS == 1 {
                check_map_limit();
            }
            return crate::ptr::null_mut();
        }
        CHECK_CURSOR += span;
        if CHECK_COUNT == CHECK_CAP {
            CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };
            CHECK_BLOCKS = check_c_realloc(CHECK_BLOCKS as *mut u8,
                CHECK_CAP * crate::mem::size_of::<CheckBlock>()) as *mut CheckBlock;
        }
        *CHECK_BLOCKS.add(CHECK_COUNT) = CheckBlock {
            start: p as usize,
            size: size,
            span: span,
            state: CHECK_LIVE_BLOCK,
            alloc_site: crate::CHECK_ALLOC_SITE,
            free_site: crate::ptr::null(),
        };
        CHECK_COUNT += 1;
        CHECK_CHANGES += 1;
        CHECK_LIVE += 1;
        if CHECK_COUNT == CHECK_TRAP {
            let mut m = CheckMsg::new();
            m.text("check-alloc: ");
            check_describe(&mut m, CHECK_COUNT - 1);
            m.text(" (VOLE_ALLOC_TRAP): SIGTRAP");
            m.out();
            check_c_raise(5);
        }
        p
    }
}

// Block b's pages given back, with no access, never used again.
// UNSAFE: b < CHECK_COUNT, a live block. SAFETY: a contract on the caller.
unsafe fn check_drop_block(b: usize) {
    // UNSAFE: the block's pages mapped again with no access; its entry.
    // SAFETY: the caller's: b is a live block, whose pages are its own.
    unsafe {
        let k = check_block(b);
        let p = (*k).start as *mut u8;
        let span = (*k).span;
        let flags = check_map_flags() | CHECK_MAP_FIXED;
        if check_c_mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {
            if CHECK_ALLOC_OS == 1 {
                check_map_limit();
            }
            // (the pages keep their contents, but no access)
            check_c_mprotect(p, span, CHECK_PROT_NONE);
        }
        CHECK_LIVE -= 1;
        (*k).state = CHECK_FREED;
        (*k).free_site = crate::CHECK_ALLOC_SITE;
        CHECK_CHANGES += 1;
    }
}

// Where address a is: Some(block) whose pages hold it, None outside the
// reservations; `inside` true when it is in one (and no block holds it).
fn check_find(a: usize, inside: &mut bool) -> Option<usize> {
    // UNSAFE: the checker's statics and table. SAFETY: under the lock (or
    // in the fault handler, which stops the program); blocks below
    // CHECK_COUNT.
    unsafe {
        *inside = false;
        let mut r: usize = 0;
        while r < CHECK_REGIONS {
            if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {
                *inside = true;
                let first = CHECK_REGION_FIRST[r];
                let mut lo = first;
                let mut hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }
                    else { CHECK_COUNT };
                // the last block starting at or before a
                while lo < hi {
                    let mid = (lo + hi) / 2;
                    if (*check_block(mid)).start <= a {
                        lo = mid + 1;
                    } else {
                        hi = mid;
                    }
                }
                if lo > first {
                    let b = lo - 1;
                    let k = check_block(b);
                    if a < (*k).start + (*k).span {
                        return Option::Some(b);
                    }
                }
                return Option::None;
            }
            r += 1;
        }
        Option::None
    }
}

// The live block p of `size` bytes, being freed: its index, or the program
// stops.
fn check_owned(p: usize, size: usize) -> usize {
    let mut inside = false;
    let found = check_find(p, &mut inside);
    let mut m = CheckMsg::new();
    // UNSAFE: the checker's statics and table. SAFETY: under the lock; b
    // from check_find, below CHECK_COUNT.
    unsafe {
        let b = match found {
            Option::Some(b) => b,
            Option::None => {
                m.text("invalid free at ");
                m.site(crate::CHECK_ALLOC_SITE);
                m.text(": ");
                m.hex(p);
                m.text(" is not a block of Gpa");
                check_stop(&mut m)
            }
        };
        let k = check_block(b);
        if (*k).start != p {
            m.text("invalid free at ");
            m.site(crate::CHECK_ALLOC_SITE);
            m.text(": ");
            m.hex(p);
            m.text(" is ");
            m.int(p - (*k).start);
            m.text(" bytes into ");
            check_describe(&mut m, b);
            check_stop(&mut m);
        }
        if (*k).state != CHECK_LIVE_BLOCK {
            m.text("double free: ");
            check_describe(&mut m, b);
            m.text(", freed again at ");
            m.site(crate::CHECK_ALLOC_SITE);
            check_stop(&mut m);
        }
        if (*k).size != size {
            m.text("wrong-size free: ");
            check_describe(&mut m, b);
            m.text(", freed as ");
            m.int(size);
            m.text(if size == 1 { " byte at " } else { " bytes at " });
            m.site(crate::CHECK_ALLOC_SITE);
            check_stop(&mut m);
        }
        b
    }
}

// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the
// last one) is reported; any other fault happens again with the default
// action (SA_RESETHAND), as without --check-alloc.
extern "C" fn check_fault(sig: i32, info: *mut u8, context: *mut u8) {
    // UNSAFE: siginfo_t's si_addr read through the kernel's pointer.
    // SAFETY: info is the siginfo_t the kernel passes an SA_SIGINFO
    // handler; si_addr is a word at check_si_addr().
    let a = unsafe { *(info.add(check_si_addr()) as *const usize) };
    let mut inside = false;
    let found = check_find(a, &mut inside);
    if !inside {
        return;
    }
    let mut m = CheckMsg::new();
    match found {
        Option::Some(b) => {
            m.text("use after free: ");
            // UNSAFE: block b. SAFETY: from check_find, below CHECK_COUNT.
            unsafe { check_describe(&mut m, b) }
        }
        Option::None => {
            m.text("access outside every block: ");
            m.hex(a);
            m.text(" (memory the checking allocator never handed out)");
        }
    }
    check_stop(&mut m);
}

// The live blocks, listed (at most 20).
fn check_list_leaks() {
    // UNSAFE: the checker's statics and table. SAFETY: under the lock;
    // blocks below CHECK_COUNT.
    unsafe {
        CHECK_LISTED = CHECK_CHANGES;
        CHECK_EVER_LISTED = true;
        if CHECK_LIVE == 0 {
            return;
        }
        let mut bytes: usize = 0;
        let mut b: usize = 0;
        while b < CHECK_COUNT {
            if (*check_block(b)).state == CHECK_LIVE_BLOCK {
                bytes += (*check_block(b)).size;
            }
            b += 1;
        }
        let mut m = CheckMsg::new();
        m.text("check-alloc: ");
        m.int(CHECK_LIVE);
        m.text(if CHECK_LIVE == 1 { " block" } else { " blocks" });
        m.text(" of Gpa not freed (");
        m.int(bytes);
        m.text(" bytes):");
        m.out();
        let mut shown: usize = 0;
        b = 0;
        while b < CHECK_COUNT {
            if (*check_block(b)).state == CHECK_LIVE_BLOCK {
                if shown == 20 {
                    let mut more = CheckMsg::new();
                    more.text("  and ");
                    more.int(CHECK_LIVE - shown);
                    more.text(" more");
                    more.out();
                    return;
                }
                let mut line = CheckMsg::new();
                line.text("  ");
                check_describe(&mut line, b);
                line.out();
                shown += 1;
            }
            b += 1;
        }
    }
}

// At exit: the leaks, unless check_leaks listed them and nothing changed
// since.
extern "C" fn check_at_exit() {
    let took = check_lock();
    // UNSAFE: the checker's statics. SAFETY: under the lock.
    unsafe {
        if !CHECK_EVER_LISTED || CHECK_LISTED != CHECK_CHANGES {
            check_list_leaks();
        }
    }
    check_unlock(took);
}

// A block for layout on pages of its own (page-aligned: any alignment up
// to a page), or a dangling aligned pointer for size 0.
pub fn allocate(layout: Layout) -> Result<NonNull<u8>, AllocError> {
    let p = if layout.size() == 0 {
        // UNSAFE: an address made a pointer (an integer-to-pointer cast).
        // SAFETY: it is never read or written: a zero-size block.
        unsafe { layout.align() as *mut u8 }
    } else {
        let took = check_lock();
        let q = check_new_block(layout.size());
        check_unlock(took);
        q
    };
    match NonNull::new(p) {
        Option::Some(p) => Result::Ok(p),
        Option::None => Result::Err(AllocError {}),
    }
}

// Block p (of layout) given back: checked against the table first (a
// double, invalid or wrong-size free stops the program).
// UNSAFE: p must be a block allocate gave, with this layout.
// SAFETY: a contract on the caller (Allocator::deallocate's), and checked.
pub unsafe fn deallocate(p: NonNull<u8>, layout: Layout) {
    let took = check_lock();
    let a = p.as_ptr() as usize;
    let mut inside = false;
    if layout.size() == 0 && !check_find(a, &mut inside).is_some() {
        check_unlock(took);
        return;
    }
    let b = check_owned(a, layout.size());
    // UNSAFE: block b given back. SAFETY: check_owned found it live.
    unsafe { check_drop_block(b) }
    check_unlock(took);
}

// The blocks allocated and not freed.
pub fn live_blocks() -> usize {
    let took = check_lock();
    // UNSAFE: the checker's statics. SAFETY: under the lock.
    let n = unsafe { CHECK_LIVE };
    check_unlock(took);
    n
}

// Whether no block is left allocated (the live ones listed on stderr).
pub fn check_leaks() -> bool {
    let took = check_lock();
    check_list_leaks();
    // UNSAFE: the checker's statics. SAFETY: under the lock.
    let none = unsafe { CHECK_LIVE == 0 };
    check_unlock(took);
    none
}

// (0.28.0, std::test) The blocks allocated so far: a mark for
// check_alloc_leaks_since.
#[effects(io, static, panic, diverge, unsafe)]
pub fn check_alloc_mark() -> usize {
    let took = check_lock();
    // UNSAFE: the checker's statics. SAFETY: under the lock.
    let n = unsafe { CHECK_COUNT };
    check_unlock(took);
    n
}

// The blocks allocated from `mark` on and not freed, listed as at exit
// (the first line names them a case's): a property's case, or a fuzz run,
// leaks them (std::test); their count.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub fn check_alloc_leaks_since(mark: usize) -> usize {
    let took = check_lock();
    let mut live: usize = 0;
    // UNSAFE: the checker's statics and table. SAFETY: under the lock;
    // blocks below CHECK_COUNT.
    unsafe {
        let mut bytes: usize = 0;
        let mut b = mark;
        while b < CHECK_COUNT {
            if (*check_block(b)).state == CHECK_LIVE_BLOCK {
                live += 1;
                bytes += (*check_block(b)).size;
            }
            b += 1;
        }
        if live > 0 {
            let mut m = CheckMsg::new();
            m.text("check-alloc: ");
            m.int(live);
            m.text(if live == 1 { " block" } else { " blocks" });
            m.text(" of Gpa not freed by the case (");
            m.int(bytes);
            m.text(" bytes):");
            m.out();
            let mut shown: usize = 0;
            b = mark;
            while b < CHECK_COUNT {
                if (*check_block(b)).state == CHECK_LIVE_BLOCK && shown < 20 {
                    let mut line = CheckMsg::new();
                    line.text("  ");
                    check_describe(&mut line, b);
                    line.out();
                    shown += 1;
                }
                b += 1;
            }
            CHECK_LISTED = CHECK_CHANGES;
        }
    }
    check_unlock(took);
    live
}

// (--check-unsafe with --check-alloc) The access of size bytes at p:
// false when p is no memory of the checking allocator, true when it is in
// bounds of a live block; else the program stops.
// UNSAFE: site must be null or a C string.
// SAFETY: a contract on the caller: the checking mode's runtime passes
// the site literal the compiler wrote.
#[effects(alloc(extern), io, static, panic, diverge, unsafe)]
pub unsafe fn check_alloc_access(p: u64, size: u64, site: *const u8) -> bool {
    let took = check_lock();
    let mut inside = false;
    let found = check_find(p as usize, &mut inside);
    if !inside {
        check_unlock(took);
        return false;
    }
    let mut m = CheckMsg::new();
    // UNSAFE: block b of the table. SAFETY: under the lock; b from
    // check_find, below CHECK_COUNT.
    unsafe {
        match found {
            Option::Some(b) => {
                let k = check_block(b);
                if (*k).state == CHECK_LIVE_BLOCK {
                    if p as usize + size as usize <= (*k).start + (*k).size {
                        check_unlock(took);
                        return true;
                    }
                    m.text("unsafe access out of bounds: ");
                } else {
                    m.text("unsafe access after free: ");
                }
                m.int(size as usize);
                m.text(if size == 1 { " byte at " } else { " bytes at " });
                m.text("offset ");
                m.int(p as usize - (*k).start);
                m.text(" of ");
                check_describe(&mut m, b);
            }
            Option::None => {
                m.text("unsafe access outside every block: ");
                m.int(size as usize);
                m.text(if size == 1 { " byte at " } else { " bytes at " });
                m.hex(p as usize);
            }
        }
    }
    m.text("\n --> ");
    m.site(site);
    check_stop(&mut m)
}
