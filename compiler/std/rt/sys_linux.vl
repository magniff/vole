// The target's system for std2 (Linux): rt/sys_macos.vl's functions, as
// the C library here has them (front/stdalloc.vl: std2_tail).
//
// Two Linux targets read this file: aarch64-linux and x86_64-linux. A
// number here is both's (the kernel's generic ABI, glibc's common
// headers) unless its line says whose it is; one that differs is chosen
// by x86_64() below. Checked against both (0.28.0): the futex system
// call's number (differs), O_DIRECTORY (differs: see it), struct stat's
// st_mode (differs); the same on both: O_CREAT, O_TRUNC, O_APPEND, O_EXCL,
// O_CLOEXEC, O_NONBLOCK, O_NOCTTY, MAP_ANON, MAP_NORESERVE,
// CLOCK_MONOTONIC, the errno values, the signal numbers (1 to 31),
// TIOCSWINSZ, TIOCGWINSZ, TIOCSCTTY, PATH_MAX, struct dirent's offsets,
// struct stat's st_size (48) and st_mtim (88).

// Whether the build is for x86_64 (a constant: sse2 is that target's
// baseline, and no feature of aarch64).
#[effects()]
fn x86_64() -> bool {
    crate::arch::has("sse2")
}

// /proc/self/cmdline, read once into these: its NULs end each argument.
static mut SYS_ARG_TEXT: [u8; 131072] = [0; 131072];
static mut SYS_ARG_PTRS: [usize; 4097] = [0; 4097];
static mut SYS_ARG_COUNT: i64 = -1;

// UNSAFE: C. SAFETY: POSIX's prototypes (open variadic, as declared).
extern "C" {
    #[link_name = "open"]
    fn sys_c_open(path: *const u8, flags: i32, ...) -> i32;
    #[link_name = "read"]
    fn sys_c_read(fd: i32, buf: *mut u8, n: usize) -> isize;
    #[link_name = "close"]
    fn sys_c_close(fd: i32) -> i32;
    #[link_name = "environ"]
    static mut sys_c_environ: *const *const u8;
}

// The program's arguments: argc, and argv, NUL-ended C strings valid for
// the whole program. Linux: /proc/self/cmdline, read once (up to 128 KB
// and 4096 arguments) into the statics above.
#[effects(io, static, panic, diverge, unsafe)]
pub fn args() -> (usize, *const *const u8) {
    // UNSAFE: the statics, written once on the first call.
    // SAFETY: the first call happens on the main thread before any other
    // reads them (std::env::args is called from main's thread first, as
    // MVS's sys_args assumes); reads stay in the arrays' bounds (checked).
    unsafe {
        if SYS_ARG_COUNT < 0 {
            SYS_ARG_COUNT = 0;
            let mut len: usize = 0;
            let fd = sys_c_open("/proc/self/cmdline\0".as_ptr(), 0);
            if fd >= 0 {
                loop {
                    let room = 131071 - len;
                    let p: *mut u8 = (&raw mut SYS_ARG_TEXT) as *mut u8;
                    let n = sys_c_read(fd, p.add(len), room);
                    if n <= 0 {
                        break;
                    }
                    len += n as usize;
                }
                let _ = sys_c_close(fd);
            }
            let base: *const u8 = (&raw const SYS_ARG_TEXT) as *const u8;
            let mut start: usize = 0;
            let mut i: usize = 0;
            while i < len {
                if *base.add(i) == 0 && SYS_ARG_COUNT < 4096 {
                    SYS_ARG_PTRS[SYS_ARG_COUNT as usize] = base.add(start) as usize;
                    SYS_ARG_COUNT += 1;
                    start = i + 1;
                }
                i += 1;
            }
        }
        let q: *const usize = (&raw const SYS_ARG_PTRS) as *const usize;
        (SYS_ARG_COUNT as usize, q as *const *const u8)
    }
}

// C's environment: a null-ended array of NUL-ended `NAME=value` strings,
// as it is now (setenv may replace it). Linux: the C library's environ.
#[effects(static, unsafe)]
pub fn environ() -> *const *const u8 {
    // UNSAFE: reads the C library's static environ.
    // SAFETY: set before main; a read of a pointer-sized static (a
    // concurrent setenv is excluded by set_var's contract).
    unsafe { sys_c_environ }
}

// C's CLOCK_MONOTONIC, std::time::Instant's clock.
pub const CLOCK_MONOTONIC: i32 = 1;

// (0.27.6) The system: 0 macOS, 1 Linux, as MVS's std::TARGET_OS
// (std::TARGET_OS, std2_tail).
pub const TARGET_OS: i64 = 1;

// (0.27.6) mmap's flags, <sys/mman.h>'s: an anonymous mapping, and one
// that reserves no swap (base's sources' region,
// docs/design/src-buffer.md).
pub const MAP_ANON: i32 = 0x20;
pub const MAP_NORESERVE: i32 = 0x4000;

// std::fs's numbers (<bits/fcntl-linux.h> on aarch64, <errno.h>,
// <linux/limits.h>).
pub const O_CREAT: i32 = 0x40;
pub const O_TRUNC: i32 = 0x200;
pub const O_APPEND: i32 = 0x400;
pub const O_EXCL: i32 = 0x80;
pub const O_CLOEXEC: i32 = 0x80000;
pub const ENAMETOOLONG: i32 = 36;
pub const PATH_MAX: usize = 4096;
// struct dirent: d_type's offset, d_name's (glibc).
pub const DIRENT_TYPE: usize = 18;
pub const DIRENT_NAME: usize = 19;

// UNSAFE: C. SAFETY: errno.h's prototype: this thread's errno's address.
extern "C" {
    #[link_name = "__errno_location"]
    fn sys_c_errno_location() -> *mut i32;
}

// This thread's errno, for a call that says "failed" only through it
// (readdir).
#[effects(static, unsafe)]
pub fn errno_location() -> *mut i32 {
    // UNSAFE: C. SAFETY: __errno_location takes nothing and returns a
    // valid pointer.
    unsafe { sys_c_errno_location() }
}

// What std::fs reads of a struct stat (glibc: st_mode a u32 at byte 16 on
// aarch64, at byte 24 on x86_64, where st_nlink is a u64 before it; on
// both st_size at 48, st_mtim at 88), from the words stat wrote:
// (st_mode, st_size, mtime's seconds, its nanoseconds).
#[effects()]
pub fn stat_fields(w: &[u64; 20]) -> (u32, u64, i64, i64) {
    let mode = if x86_64() { w[3] } else { w[2] };
    ((mode & 0xffffffff) as u32, w[6], w[11] as i64, w[12] as i64)
}

// A signal's name, as std::process's ExitStatus prints it (<bits/signum-generic.h>);
// "" for a number this system does not name.
#[effects()]
pub fn signal_name(sig: i32) -> &'static str {
    match sig {
        1 => "SIGHUP",
        2 => "SIGINT",
        3 => "SIGQUIT",
        4 => "SIGILL",
        5 => "SIGTRAP",
        6 => "SIGABRT",
        7 => "SIGBUS",
        8 => "SIGFPE",
        9 => "SIGKILL",
        10 => "SIGUSR1",
        11 => "SIGSEGV",
        12 => "SIGUSR2",
        13 => "SIGPIPE",
        14 => "SIGALRM",
        15 => "SIGTERM",
        16 => "SIGSTKFLT",
        17 => "SIGCHLD",
        18 => "SIGCONT",
        19 => "SIGSTOP",
        20 => "SIGTSTP",
        21 => "SIGTTIN",
        22 => "SIGTTOU",
        23 => "SIGURG",
        24 => "SIGXCPU",
        25 => "SIGXFSZ",
        26 => "SIGVTALRM",
        27 => "SIGPROF",
        28 => "SIGWINCH",
        29 => "SIGIO",
        30 => "SIGPWR",
        31 => "SIGSYS",
        _ => "",
    }
}

// (0.28.0) std::sys's numbers, as MVS's std::sys had them (its SYS_*
// constants): <fcntl.h>, <errno.h>, <signal.h>, <asm-generic/ioctls.h>.
pub const O_NONBLOCK: i32 = 0x800;
pub const O_NOCTTY: i32 = 0x100;
// (0o40000, 0x4000, on aarch64; 0o200000, 0x10000, on x86_64. X86_64 is 1
// there and 0 on aarch64: a constant cannot call x86_64(), so the
// compiler writes it before this file, front/stdalloc.vl: std2_tail. std
// itself does not use it, std::sys gives it to programs as
// SYS_O_DIRECTORY)
pub const O_DIRECTORY: i32 = 0x4000 + X86_64 * 0xc000;
pub const EAGAIN: i32 = 11;
pub const ENOTEMPTY: i32 = 39;
pub const ETIMEDOUT: i32 = 110;
pub const ENOSYS: i32 = 38;
pub const ENOTSUP: i32 = 95;
pub const ELOOP: i32 = 40;
pub const SIGCHLD: i32 = 17;
pub const TIOCSWINSZ: u64 = 0x5414;
pub const TIOCGWINSZ: u64 = 0x5413;
pub const TIOCSCTTY: u64 = 0x540e;

// UNSAFE: C. SAFETY: string.h's prototype of the XSI strerror_r
// (__xpg_strerror_r): it writes at most n bytes, its NUL included, at buf.
extern "C" {
    #[link_name = "__xpg_strerror_r"]
    #[effects()]
    fn sys_c_strerror_r(e: i32, buf: *mut u8, n: usize) -> i32;
}

// C's message for errno e, into buf (NUL-ended, cut to fit): 0, or an
// errno (std::sys::sys_strerror_into calls it).
// UNSAFE: C writes through a raw pointer.
// SAFETY: (the caller's) buf points to n writable bytes.
pub unsafe fn strerror_r(e: i32, buf: *mut u8, n: usize) -> i32 {
    sys_c_strerror_r(e, buf, n)
}

// Waiting on a 32-bit word (std::sync's locks): the futex system call,
// FUTEX_WAIT_PRIVATE (128) and FUTEX_WAKE_PRIVATE (129), the same on both
// targets. The call's number is not: 98 on aarch64 (the kernel's generic
// table, asm-generic/unistd.h), 202 on x86_64 (syscall_64.tbl).
#[effects()]
fn futex_number() -> i64 {
    if x86_64() { 202 } else { 98 }
}

// UNSAFE: C. SAFETY: syscall(long, ...): seven words, in registers as for
// the variadic call. Its list is the futex call's (the checker does not
// know `syscall`): it waits or wakes, as macOS's __ulock_wait and
// __ulock_wake; no memory, no io.
extern "C" {
    #[link_name = "syscall"]
    #[effects(sync)]
    fn sys_c_futex(n: i64, addr: *mut u32, op: i64, val: i64, t: *const u8, a: i64, b: i64) -> i64;
}

// Sleeps while *addr is `expected`, or until woken (spuriously too).
// UNSAFE: the system reads a raw address.
// SAFETY: (the caller's) addr is a live, 4-aligned u32.
pub unsafe fn futex_wait(addr: *mut u32, expected: u32) {
    sys_c_futex(futex_number(), addr, 128, expected as i64, 0 as *const u8, 0, 0);
}

// Wakes one thread sleeping on addr, or all.
// UNSAFE: the system takes a raw address.
// SAFETY: (the caller's) addr is a live u32 (nothing is read through it).
pub unsafe fn futex_wake(addr: *mut u32, all: bool) {
    sys_c_futex(futex_number(), addr, 129, if all { 2147483647 } else { 1 }, 0 as *const u8, 0, 0);
}
