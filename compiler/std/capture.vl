// std::capture (0.25.4): a request to write the next frame presented to
// a file, which std::window's scripted event loop makes (its `shot FILE`
// command) and std::gpu serves (Frame::present). It is a module of its
// own because std::window and std::gpu are each read only by the programs
// that name them (compiler/std/index.awk): neither can name the other. A
// program reaches it as std::gpu::capture_next_frame.

// The file the next presented frame goes to (LEN < 0: none asked for).
static var PATH: [u8; 1024] = [0u8; 1024];
static var LEN: i64 = -1;

/// The next frame presented (std::gpu's `Frame::present`) is also written
/// to path, a binary PPM. A new request replaces one not yet served;
/// false (and nothing is asked) when path is longer than 1024 bytes.
pub fn capture_next_frame(path: [u8]) -> bool {
    if path.len() > 1024 {
        return false;
    }
    for i in 0..path.len() {
        PATH[i] = path[i];
    }
    LEN = path.len();
    true
}

/// A capture is asked for, and no frame was presented since.
pub fn capture_pending() -> bool {
    LEN >= 0
}

/// Forgets the capture asked for, if any.
pub fn capture_cancel() {
    LEN = -1;
}

/// The file asked for, appended to out, and the request forgotten; false
/// when none was asked for.
pub fn take_capture<A: Allocator>(out: inout Buf<A>) -> bool {
    if LEN < 0 {
        return false;
    }
    for i in 0..LEN {
        out.push(PATH[i]);
    }
    LEN = -1;
    true
}
