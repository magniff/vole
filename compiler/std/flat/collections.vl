// compiler/std/embed.sh appends this file to std.vl and the others
// (0.18.1): the same module, `std`. Its sections are lazy: loaded when a
// program names what they define.

// ---- Heaps (0.18.1) ----

// A priority queue, a binary heap in a Vec: `push` in O(log n), `pop`
// takes the largest element first (Rust's BinaryHeap, a max-heap), `peek`
// reads it. For the smallest first (Dijkstra, a timer queue) use
// `MinHeap`, the same API: no `Reverse` wrapper. `BinaryHeap::new_in(gpa)`,
// `with_capacity_in(n, gpa)`, `from_vec(v)`; dropped with its elements.
pub struct BinaryHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }

// A priority queue whose `pop` takes the smallest element first: a
// min-heap, with BinaryHeap's API (`MinHeap::new_in(gpa)`, `push`, `pop`,
// `peek`). Rust spells it `BinaryHeap<Reverse<T>>`.
pub struct MinHeap<T: Ord, A: Allocator = Gpa> { data: Vec<T, A> }

// Which of two elements a heap keeps nearer the root: the larger
// (BinaryHeap) or the smaller (MinHeap). Unsafe: a and b point to
// elements.
trait HeapOrder {
    // UNSAFE: compares the elements behind two raw pointers into a heap's block.
    // SAFETY: the caller's: a and b point to initialized elements (or x, a local), readable
    // for the call.
    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool;
}

struct HeapMax {}

struct HeapMin {}

impl HeapOrder for HeapMax {
    // UNSAFE: reads *a and *b, raw pointers.
    // SAFETY: the caller's (HeapOrder::above): both point to initialized elements.
    #[inline]
    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {
        *a > *b
    }
}

impl HeapOrder for HeapMin {
    // UNSAFE: reads *a and *b, raw pointers.
    // SAFETY: the caller's (HeapOrder::above): both point to initialized elements.
    #[inline]
    unsafe fn above<T: Ord>(a: *T, b: *T) -> bool {
        *a < *b
    }
}

// Puts x in the hole at p[pos], or nearer p[start] while it is above the
// hole's parent: each step one move, not a swap; where it ends. (The
// index at least halves each round: 64 rounds at most.) Unsafe: p has
// pos + 1 elements at least; p[pos] holds nothing (its bits are x's or a
// moved element's).
// UNSAFE: moves elements through a raw pointer to the heap's block (one move a level, a hot path:
// a safe swap per level is twice the moves).
// SAFETY: the caller's, as above; parent < i <= pos, so every access is in p[start..pos + 1];
// each move fills the hole and opens one at the parent, and x fills the last.
unsafe fn heap_hole_up<T: Ord, O: HeapOrder>(p: *T, start: i64, pos: i64, x: sink T) -> i64 {
    var i = pos;
    for _ in 0..64 {
        if i <= start {
            break;
        }
        let parent = (i - 1) >> 1;
        if !O::above(&x, &p[parent]) {
            break;
        }
        p[i] = p[parent];
        i = parent;
    }
    p[i] = x;
    i
}

// Moves p[pos] down until no child of it, in p[..end], is above it,
// through a hole. Unsafe: p has `end` elements.
// UNSAFE: moves elements through a raw pointer to the heap's block (through a hole, hot).
// SAFETY: the caller's: p has end initialized elements and pos < end; the children read are
// < end (child <= end - 2 for the pair, == end - 1 for the last), and x, read out of p[pos],
// is written back exactly once, into the final hole.
unsafe fn heap_sift_down<T: Ord, O: HeapOrder>(p: *T, pos: i64, end: i64) {
    let x = p[pos];
    var i = pos;
    var child = 2 * i + 1;
    for _ in 0..64 {
        if child > end - 2 {
            break;
        }
        if !O::above(&p[child], &p[child + 1]) {
            child += 1;
        }
        if !O::above(&p[child], &x) {
            p[i] = x;
            return;
        }
        p[i] = p[child];
        i = child;
        child = 2 * i + 1;
    }
    if child == end - 1 && O::above(&p[child], &x) {
        p[i] = p[child];
        i = child;
    }
    p[i] = x;
}

// `pop`'s sift: x, for the hole at the root, goes down to a leaf along
// the path of the children above their siblings (one comparison a level),
// then up to its place: fewer comparisons than heap_sift_down, as x, the
// last leaf, usually belongs near the bottom. Unsafe: p has `end`
// elements, at least one; p[0] holds nothing.
// UNSAFE: moves elements through a raw pointer to the heap's block (hot: pop).
// SAFETY: the caller's, as above; children read are < end; heap_hole_up's needs hold: the hole
// at i < end, and p[0..i] initialized.
unsafe fn heap_hole_down_to_bottom<T: Ord, O: HeapOrder>(p: *T, end: i64, x: sink T) {
    var i = 0;
    var child = 1;
    for _ in 0..64 {
        if child > end - 2 {
            break;
        }
        // (the larger child without a branch: random data mispredicts one)
        child += (!O::above(&p[child], &p[child + 1])) as i64;
        p[i] = p[child];
        i = child;
        child = 2 * i + 1;
    }
    if child == end - 1 {
        p[i] = p[child];
        i = child;
    }
    heap_hole_up::<T, O>(p, 0, i, x);
}

// Makes p[..n] a heap, in O(n). Unsafe: p has n elements.
// UNSAFE: heap_sift_down's raw pointer.
// SAFETY: the caller's: p has n initialized elements; each sift starts at an index < n / 2 < n.
unsafe fn heap_build<T: Ord, O: HeapOrder>(p: *T, n: i64) {
    for k in 0..n / 2 {
        heap_sift_down::<T, O>(p, n / 2 - 1 - k, n);
    }
}

// Adds x to the heap in v.
#[inline]
#[stores(x)]
fn heap_push<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>, x: sink T) {
    v.reserve(1);
    let n = v.len;
    // UNSAFE: heap_hole_up works in the Vec's raw block.
    // SAFETY: reserve(1) made n < cap, so p[n] is room (the hole); p[0..n] are the heap's
    // initialized elements; len counts the new one after.
    unsafe {
        heap_hole_up::<T, O>(v.ptr, 0, n, x);
    }
    v.len = n + 1;
}

// Takes the root of the heap in v out.
#[inline]
fn heap_pop<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>) -> Option<T> {
    if v.len == 0 {
        return None;
    }
    v.len -= 1;
    // UNSAFE: the last and the top element are moved out of the Vec's raw block.
    // SAFETY: the old len was n + 1 > 0, so p[n] and p[0] are initialized; len is n now, so
    // last moves out once, and p[0], taken as top, is the hole heap_hole_down_to_bottom fills.
    unsafe {
        let p = v.ptr;
        let n = v.len;
        let last = p[n];
        if n == 0 {
            return Some(last);
        }
        let top = p[0];
        heap_hole_down_to_bottom::<T, O>(p, n, last);
        Some(top)
    }
}

// The heap in v sorted in place: the root's end of the order last.
fn heap_sort_vec<T: Ord, O: HeapOrder, A: Allocator>(v: inout Vec<T, A>) {
    // UNSAFE: swaps and sifts in the Vec's raw block.
    // SAFETY: p has n initialized elements (v is a heap); 0 < end < n for each swap and sift.
    unsafe {
        let p = v.ptr;
        let n = v.len;
        for k in 1..n {
            let end = n - k;
            swap_raw::<T>(p, 0, end);
            heap_sift_down::<T, O>(p, 0, end);
        }
    }
}

impl<T: Ord, A: Allocator> BinaryHeap<T, A> {
    // An empty heap on allocator a.
    pub fn new_in(a: sink A) -> BinaryHeap<T, A> {
        BinaryHeap { data: Vec::new_in(a) }
    }

    // An empty heap on allocator a with room for cap elements.
    pub fn with_capacity_in(cap: usize, a: sink A) -> BinaryHeap<T, A> {
        BinaryHeap { data: Vec::with_capacity_in(cap, a) }
    }

    // A heap of v's elements, in O(n), on v's memory: Rust's
    // `BinaryHeap::from(v)`.
    pub fn from_vec(v: sink Vec<T, A>) -> BinaryHeap<T, A> {
        var data = v;
        // UNSAFE: heap_build works in the Vec's raw block.
        // SAFETY: data owns len initialized elements at ptr (Vec's invariant).
        unsafe {
            heap_build::<T, HeapMax>(data.ptr, data.len);
        }
        BinaryHeap { data: data }
    }

    pub fn len(self) -> usize {
        self.data.len as usize
    }

    pub fn is_empty(self) -> bool {
        self.data.len == 0
    }

    // Adds x, in O(log n).
    #[stores(x)]
    pub fn push(inout self, x: sink T) {
        heap_push::<T, HeapMax, A>(&self.data, x);
    }

    // Takes the largest element out (None when empty), in O(log n).
    pub fn pop(inout self) -> Option<T> {
        heap_pop::<T, HeapMax, A>(&self.data)
    }

    // The largest element, which stays (`pop` takes it), as Vec's `last`.
    pub fn peek(self) -> Option<T> {
        if self.data.len == 0 { None } else { Some(self.data.get(0)) }
    }

    // Drops the elements; the room stays.
    pub fn clear(inout self) {
        self.data.clear();
    }

    pub fn capacity(self) -> usize {
        self.data.cap as usize
    }

    // Room for `extra` more elements.
    pub fn reserve(inout self, extra: usize) {
        self.data.reserve(extra);
    }

    // Its allocator: a copy of the handle.
    pub fn allocator(self) -> A {
        self.data.alloc
    }

    // Its elements in heap order (the largest first, the rest in no
    // useful order), a view.
    #[views(self)]
    pub fn as_slice(self) -> [T] {
        self.data.as_slice()
    }

    // Its elements in a Vec, in heap order, on the same memory.
    pub fn into_vec(sink self) -> Vec<T, A> {
        self.data
    }

    // Its elements in a Vec, smallest first, on the same memory: a
    // heapsort, in O(n log n).
    pub fn into_sorted_vec(sink self) -> Vec<T, A> {
        var v = self.data;
        heap_sort_vec::<T, HeapMax, A>(&v);
        v
    }
}

impl<T: Ord, A: Allocator + Ambient> BinaryHeap<T, A> {
    #[ambient("BinaryHeap::new_in(gpa)")]
    pub fn new() -> BinaryHeap<T, A> {
        BinaryHeap::new_in(A::ambient())
    }

    #[ambient("BinaryHeap::with_capacity_in(cap, gpa)")]
    pub fn with_capacity(cap: usize) -> BinaryHeap<T, A> {
        BinaryHeap::with_capacity_in(cap, A::ambient())
    }
}

impl<T: Ord, A: Allocator> MinHeap<T, A> {
    // An empty heap on allocator a.
    pub fn new_in(a: sink A) -> MinHeap<T, A> {
        MinHeap { data: Vec::new_in(a) }
    }

    // An empty heap on allocator a with room for cap elements.
    pub fn with_capacity_in(cap: usize, a: sink A) -> MinHeap<T, A> {
        MinHeap { data: Vec::with_capacity_in(cap, a) }
    }

    // A heap of v's elements, in O(n), on v's memory.
    pub fn from_vec(v: sink Vec<T, A>) -> MinHeap<T, A> {
        var data = v;
        // UNSAFE: heap_build works in the Vec's raw block.
        // SAFETY: data owns len initialized elements at ptr (Vec's invariant).
        unsafe {
            heap_build::<T, HeapMin>(data.ptr, data.len);
        }
        MinHeap { data: data }
    }

    pub fn len(self) -> usize {
        self.data.len as usize
    }

    pub fn is_empty(self) -> bool {
        self.data.len == 0
    }

    // Adds x, in O(log n).
    #[stores(x)]
    pub fn push(inout self, x: sink T) {
        heap_push::<T, HeapMin, A>(&self.data, x);
    }

    // Takes the smallest element out (None when empty), in O(log n).
    pub fn pop(inout self) -> Option<T> {
        heap_pop::<T, HeapMin, A>(&self.data)
    }

    // The smallest element, which stays (`pop` takes it), as Vec's `last`.
    pub fn peek(self) -> Option<T> {
        if self.data.len == 0 { None } else { Some(self.data.get(0)) }
    }

    // Drops the elements; the room stays.
    pub fn clear(inout self) {
        self.data.clear();
    }

    pub fn capacity(self) -> usize {
        self.data.cap as usize
    }

    // Room for `extra` more elements.
    pub fn reserve(inout self, extra: usize) {
        self.data.reserve(extra);
    }

    // Its allocator: a copy of the handle.
    pub fn allocator(self) -> A {
        self.data.alloc
    }

    // Its elements in heap order (the smallest first, the rest in no
    // useful order), a view.
    #[views(self)]
    pub fn as_slice(self) -> [T] {
        self.data.as_slice()
    }

    // Its elements in a Vec, in heap order, on the same memory.
    pub fn into_vec(sink self) -> Vec<T, A> {
        self.data
    }

    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same
    // memory, in O(n log n).
    pub fn into_sorted_vec(sink self) -> Vec<T, A> {
        var v = self.data;
        heap_sort_vec::<T, HeapMin, A>(&v);
        let s = v.as_mut_slice();
        for k in 0..s.len as i64 / 2 {
            swap_at::<T>(s, k as usize, s.len - 1 - k as usize);
        }
        v
    }
}

impl<T: Ord, A: Allocator + Ambient> MinHeap<T, A> {
    #[ambient("MinHeap::new_in(gpa)")]
    pub fn new() -> MinHeap<T, A> {
        MinHeap::new_in(A::ambient())
    }

    #[ambient("MinHeap::with_capacity_in(cap, gpa)")]
    pub fn with_capacity(cap: usize) -> MinHeap<T, A> {
        MinHeap::with_capacity_in(cap, A::ambient())
    }
}

// ---- More of Vec and Range (0.18.1) ----
//
// Vec's first, retain, contains and sort_by_key, a slice's contains,
// Range's rev.

impl<T, A: Allocator> Vec<T, A> {
    // The first element, if there is one (as `last`).
    pub fn first(self) -> Option<T> {
        if self.len == 0 { None } else { Some(self.get(0)) }
    }

    // Keeps the elements f is true of, in their order, and drops the
    // others (Rust's `retain`): in place, O(n), f called once per element.
    pub fn retain<F: FnMut(let T) -> bool>(inout self, f: F) {
        var g = f;
        let n = self.len;
        let p = self.ptr;
        var kept = 0;
        // UNSAFE: elements compacted in place through the Vec's raw block (O(n) moves, no copy).
        // SAFETY: i < n = len, initialized; kept <= i, so a move goes down into a moved-out or
        // dropped slot; each element is kept once or dropped once, and len becomes kept (f
        // cannot reach the Vec: self is inout; a panic ends the process, no unwinding).
        unsafe {
            for i in 0..n {
                if g(*(&p[i])) {
                    if kept != i {
                        p[kept] = p[i];
                    }
                    kept += 1;
                } else if needs_drop::<T>() {
                    drop(p[i]);
                }
            }
        }
        self.len = kept;
    }

    // Sorts it in place by the key f gives each element, smallest first,
    // keeping equal keys in their order, as Rust's `sort_by_key`:
    // sort_stable_by_in with the Vec's own allocator for its buffer. f
    // runs twice per comparison: make it cheap (a field, a tuple of
    // fields).
    pub fn sort_by_key<K: Ord, F: FnMut(let T) -> K>(inout self, f: F) {
        var g = f;
        let a = self.alloc;
        sort_stable_by_in(self.as_mut_slice(), |x: T, y: T| {
            let kx = g(x);
            let ky = g(y);
            cmp_of(kx, ky)
        }, a);
    }
}

impl<T: Eq>[T] {
    // Whether x is one of its elements (Rust's `s.contains(&x)`; x by
    // value, as HashMap's keys): a linear search.
    pub fn contains(self: [T], x: sink T) -> bool {
        for i in 0..self.len as i64 {
            if self[i] == x {
                return true;
            }
        }
        false
    }

    // (0.25.5) Whether its first elements are p's (Rust's
    // `s.starts_with(&p)`; any slice starts with an empty one):
    // `line.starts_with("# ")` of a `[u8]`.
    pub fn starts_with(self: [T], p: [T]) -> bool {
        self.len as i64 >= p.len as i64 && self[0..p.len as i64] == p
    }

    // (0.25.5) Whether its last elements are p's: `name.ends_with(".vl")`.
    pub fn ends_with(self: [T], p: [T]) -> bool {
        self.len as i64 >= p.len as i64
            && self[self.len as i64 - p.len as i64..self.len as i64] == p
    }
}

impl<T: Eq, A: Allocator> Vec<T, A> {
    // Whether x is one of its elements: `v.contains(x)`.
    pub fn contains(self, x: sink T) -> bool {
        self.as_slice().contains(x)
    }
}

impl<T> Range<T> {
    // Its items from the last down: `for i in (0..n).rev()` is n - 1,
    // n - 2, ..., 0.
    #[inline]
    pub fn rev(sink self) -> RevRange<T> {
        RevRange { start: self.start, end: self.end }
    }
}

// `(a..b).rev()`: end - 1, end - 2, ..., down to start.
pub struct RevRange<T> { pub start: T, pub end: T }

impl<T> Iterator for RevRange<T> {
    type Item = T;

    #[inline]
    fn next(inout self) -> Option<T> {
        if self.start < self.end {
            let x = self.end - 1 as T;
            self.end = x;
            Some(x)
        } else {
            None
        }
    }

    #[inline]
    fn exact_len(self) -> i64 {
        if self.start < self.end { (self.end - self.start) as i64 } else { 0 }
    }

    #[inline]
    fn at(inout self, k: i64) -> T {
        self.end - (k + 1) as T
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink T) -> B>(sink self, init: sink B, f: F) -> B {
        var g = f;
        var acc = init;
        let n = self.exact_len();
        for k in 0..n {
            acc = g(acc, self.end - (k + 1) as T);
        }
        acc
    }
}

impl<T> RangeInclusive<T> {
    // (0.25) Its items from the last down: `for i in (1..=n).rev()` is n,
    // n - 1, ..., 1.
    #[inline]
    pub fn rev(sink self) -> RevRangeInclusive<T> {
        RevRangeInclusive { start: self.start, end: self.end, done: self.done }
    }
}

// `(a..=b).rev()`: end, end - 1, ..., down to start; `done` once `next`
// gave start.
pub struct RevRangeInclusive<T> { pub start: T, pub end: T, pub done: bool }

impl<T> Iterator for RevRangeInclusive<T> {
    type Item = T;

    #[inline]
    fn next(inout self) -> Option<T> {
        if self.done || self.start > self.end {
            return None;
        }
        let x = self.end;
        if x == self.start {
            self.done = true;
        } else {
            self.end = x - 1 as T;
        }
        Some(x)
    }

    #[inline]
    fn exact_len(self) -> i64 {
        if self.done || self.start > self.end { 0 } else { (self.end - self.start) as i64 + 1 }
    }

    #[inline]
    fn at(inout self, k: i64) -> T {
        self.end - k as T
    }

    #[inline]
    fn fold<B, F: FnMut(sink B, sink T) -> B>(self, init: sink B, f: F) -> B {
        var g = f;
        var acc = init;
        let n = self.exact_len();
        for k in 0..n {
            acc = g(acc, self.end - k as T);
        }
        acc
    }
}
