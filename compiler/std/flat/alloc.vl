// ---- Allocation (0.16) ----

// Memory comes from allocators: a type implementing Allocator. Containers
// carry theirs as a type parameter (`Vec<T, A: Allocator = Gpa>`), so an
// allocation is a call std can see, and effects name it (`alloc(Gpa)`).
// Allocation is explicit: nothing allocates without being given an
// allocator, `Vec::new_in(a)`, `collect_in(a)`, `format_in(x, a)`. Gpa,
// the general-purpose allocator (C's malloc), is the type parameters'
// default, and a program has one when its main takes it (`gpa: Gpa`, its
// parameter), passed down as a parameter.
//
// Sizes and alignments are in bytes; an alignment is a power of two from 1
// to 4096. Running out of memory, or misusing an allocator, stops the
// program (exit 101): part of the effect `alloc`, not `panic`. A size
// above ALLOC_LIMIT (2^62 bytes) is out of memory.

pub trait Allocator {
    // size bytes aligned to align, null when out of memory; size 0: aligned,
    // non-null, unreadable.
    #[effects(alloc, global, panic, diverge, unsafe)]
    fn try_alloc(self: *Self, size: i64, align: i64) -> *u8;
    // p (old_size bytes, from this allocator) as new_size bytes, the first
    // min(old_size, new_size) kept; may move; null: p is left as it was.
    // UNSAFE: a raw block (no type records its origin). SAFETY: the caller's: p is a live
    // block of this allocator of old_size and align; after a non-null result, only it is used.
    #[effects(alloc, global, panic, diverge, unsafe)]
    unsafe fn try_resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8;
    // Gives back p (size bytes, from this allocator).
    // UNSAFE: a raw block. SAFETY: the caller's: p is a live block of this allocator of size
    // and align (or null with 0, ignored), freed once, not used after.
    #[effects(alloc, global, panic, diverge, unsafe)]
    unsafe fn free(self: *Self, p: *u8, size: i64, align: i64);

    // try_alloc, stopping the program when out of memory.
    #[inline]
    fn alloc(self: *Self, size: i64, align: i64) -> *u8 {
        let p = self.try_alloc(size, align);
        if p == 0 as *u8 {
            out_of_memory();
        }
        p
    }

    // try_resize, stopping the program when out of memory.
    // UNSAFE: a raw block. SAFETY: the caller's, as try_resize's.
    #[inline]
    unsafe fn resize(self: *Self, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        let q = self.try_resize(p, old_size, new_size, align);
        if q == 0 as *u8 {
            out_of_memory();
        }
        q
    }
}

// What the try_ functions of containers return when out of memory
// (`v.try_push(x)`, `v.try_reserve(n)`).
pub enum AllocError { OutOfMemory }

impl Display for AllocError {
    fn fmt(self, f: inout Fmt) {
        f.str("out of memory");
    }
}

impl Debug for AllocError {
    fn fmt_debug(self, f: inout Fmt) {
        f.str("OutOfMemory");
    }
}

// The largest allocation: 2^62 bytes (a size above it is out of memory).
pub const ALLOC_LIMIT: i64 = 4611686018427387904;

// Stops the program: an allocator is out of memory.
#[cold]
fn out_of_memory() -> ! {
    // UNSAFE: a C string. SAFETY: a c"" literal.
    unsafe { panic(c"out of memory") }
}

// n elements of `size` bytes, in bytes; -1 when n is negative or that is
// above ALLOC_LIMIT.
#[inline]
fn alloc_bytes(n: i64, size: i64) -> i64 {
    if n < 0 || size > 0 && n > ALLOC_LIMIT / size {
        return -1;
    }
    n * size
}

// The capacity a container grows to from cap for at least need elements:
// twice cap (4 at least), or need when that is more.
#[inline]
fn grown_cap(cap: i64, need: i64) -> i64 {
    let twice = if cap == 0 { 4 } else if cap < ALLOC_LIMIT / 2 { cap * 2 } else { ALLOC_LIMIT };
    if twice < need { need } else { twice }
}

// ---- Gpa ----

// The general-purpose allocator: C's malloc, realloc and free (its
// implementation follows std's source: gpa.vl, or the checking one of
// --check-alloc). Zero-sized, copied freely: a Vec<T> on it is three
// words. Its one field is private (0.26: zero-sized, Rust's `_private:
// ()`), so only std makes one, and outside std the runtime's entry,
// main's parameter `gpa: Gpa`; a static cannot hold one (no constant
// makes one), so a program keeps its containers in main and passes them
// down.
pub struct Gpa { _private: () }

// ---- Arenas (0.16) ----

// An arena: allocations bump a pointer through chunks taken from Gpa, and
// are given back all at once: when a scope ends (`a.scope(|s| ...)`,
// `arena_scope(gpa, |s| ...)`), or by `reset` and `free_all` (unsafe: what
// was allocated must not be used after). A request above 32 KB gets a
// chunk of its own; the last block grows and shrinks in place; `free`
// gives back the last block, and a chunk of its own. A handle: copies
// share the arena. `Arena::none()`, a constant (for statics), has no
// memory: allocating from it stops the program.
//
// (--check-alloc, CHECK_ALLOC: each block is on pages of its own from the
// checking Gpa, its owner the arena's state; the bump keeps the
// accounting, so `used` and exhaustion are as without; a block given back
// (free, a move, a reset, a scope's end, free_all) loses its pages.)
pub struct Arena { s: *ArenaState }

// A chunk of an arena's memory, from Gpa: this header, then its bytes (the
// first chunk's start with the arena's state).
struct ArenaChunk { next: *ArenaChunk, size: i64 }

// A block of its own (a request above ARENA_LARGE): this header, at
// arena_large_head(align) bytes before the block, in a list both ways.
struct ArenaLarge { next: *ArenaLarge, prev: *ArenaLarge, size: i64, align: i64 }

// The state of an arena, in its first chunk, or of a scope, on the stack
// of the scope's function. Addresses are i64s; ptr..limit is where the
// next block goes (limit is 0 while the arena is lent to a scope).
struct ArenaState {
    ptr: i64,
    limit: i64,
    // the current chunk, its first byte and its end
    chunk: *ArenaChunk,
    start: i64,
    end: i64,
    // the last block (it grows in place), -1: none
    last: i64,
    // the bytes used in the chunks before the current one
    before: i64,
    lent: bool,
    // the arena's own state (itself for an Arena; for a scope, its arena's)
    root: *ArenaState,
    // a scope's: the arena's blocks of their own when it started
    large_mark: *ArenaLarge,
    // the root's: its chunks, its blocks of their own, the bytes of these,
    // the bytes taken from Gpa, the size of the next chunk
    first: *ArenaChunk,
    large: *ArenaLarge,
    large_bytes: i64,
    chunk_bytes: i64,
    next_size: i64,
    // a scope's, with --check-alloc: the checking Gpa's blocks when it
    // started (check_alloc_mark)
    check_mark: i64,
}

// Requests above this get a chunk of their own.
const ARENA_LARGE: i64 = 32768;
// The first chunk's bytes (Arena::new_in), the first next chunk's (a
// request up to ARENA_LARGE, aligned, fits in any), the largest.
const ARENA_FIRST: i64 = 8192;
const ARENA_NEXT: i64 = 65536;
const ARENA_MAX_CHUNK: i64 = 4194304;
const ARENA_CHUNK_HEAD: i64 = 16;
const ARENA_ALIGN_MAX: i64 = 4096;

// A block's bytes from state s: the bump (an Arena's and a ScopedArena's
// try_alloc), inlined where they are called; the rest (a new chunk, a
// block of its own, Arena::none(), a lent arena) out of line and cold.
#[inline]
fn arena_alloc(s: *ArenaState, size: i64, align: i64) -> *u8 {
    // UNSAFE: the arena's state is reached through a raw pointer, the bump through addresses.
    // SAFETY: module-private: every caller passes the s of a sealed Arena or ScopedArena, null
    // (checked) or a live ArenaState; a block p..e is returned only when it lies in s.ptr..
    // s.limit, the unused rest of the current chunk (limit 0 while lent: never fits).
    unsafe {
        if s != 0 as *ArenaState {
            let p = (s.ptr + align - 1) & -align;
            let e = p + size;
            if (size as u64) <= (ARENA_LARGE as u64) && p >= s.ptr && e <= s.limit {
                s.ptr = e;
                s.last = p;
                if CHECK_ALLOC {
                    // (the block's own pages; the bump keeps the count)
                    return check_alloc_block(s.root as u64, size, align);
                }
                return p as *u8;
            }
        }
        arena_alloc_slow(s, size, align)
    }
}

// Whether align is an alignment: a power of two from 1 to 4096.
fn arena_align_ok(align: i64) -> bool {
    align >= 1 && align <= ARENA_ALIGN_MAX && (align & (align - 1)) == 0
}

// arena_alloc when the bump does not fit: a block of its own, or the next
// chunk (a new one when there is none).
// UNSAFE: s is a raw pointer to the arena's state.
// SAFETY: the caller's (arena_alloc's): s is null or a live ArenaState; arena_usable stops
// the program for null or a lent one; a new chunk is linked into s.root's list.
#[cold]
#[inline(never)]
unsafe fn arena_alloc_slow(s: *ArenaState, size: i64, align: i64) -> *u8 {
    arena_usable(s);
    if size < 0 || size > ALLOC_LIMIT || !arena_align_ok(align) {
        return 0 as *u8;
    }
    if size > ARENA_LARGE {
        return arena_large_alloc(s.root, size, align);
    }
    var c = s.chunk.next;
    if c == 0 as *ArenaChunk {
        c = arena_new_chunk(s.root, s.chunk);
        if c == 0 as *ArenaChunk {
            return 0 as *u8;
        }
    }
    s.before += s.ptr - s.start;
    s.chunk = c;
    s.start = c as i64 + ARENA_CHUNK_HEAD;
    s.end = c as i64 + c.size;
    s.limit = s.end;
    s.ptr = s.start;
    s.last = -1;
    // (a request up to ARENA_LARGE, aligned, fits in any next chunk)
    arena_alloc(s, size, align)
}

// Stops the program unless s is an arena that can allocate: not
// Arena::none(), not lent to a scope.
// UNSAFE: reads s.lent through a raw pointer; std::panic takes a C string.
// SAFETY: the caller's: s is null (checked first) or a live ArenaState; the messages are c""
// literals.
unsafe fn arena_usable(s: *ArenaState) {
    if s == 0 as *ArenaState {
        panic(c"the arena has no memory: it is Arena::none()");
    }
    if s.lent {
        panic(c"the arena is lent to a scope: allocate from the scope's arena");
    }
}

// A new chunk from Gpa, after chunk `after` in root's list; null when out
// of memory.
// UNSAFE: writes a new chunk's header and two ArenaStates' fields through raw pointers.
// SAFETY: the caller's: root and after are live (root an arena's own state, after a chunk of
// it); c is checked non-null and is size >= 16 bytes from Gpa, 16-aligned, room for its header.
unsafe fn arena_new_chunk(root: *ArenaState, after: *ArenaChunk) -> *ArenaChunk {
    let size = root.next_size;
    let g = Gpa { _private: () };
    let c = g.try_alloc(size, 16) as *ArenaChunk;
    if c == 0 as *ArenaChunk {
        return c;
    }
    c.size = size;
    c.next = after.next;
    after.next = c;
    root.chunk_bytes += size;
    if size < ARENA_MAX_CHUNK {
        root.next_size = size * 2;
    }
    c
}

// The bytes of a block of its own before it: its header, or the
// alignment when that is more.
fn arena_large_head(align: i64) -> i64 {
    if align > 32 { align } else { 32 }
}

// A block of its own of size bytes from Gpa, at the front of root's list.
// UNSAFE: writes the block's ArenaLarge header, before the block, through raw pointers.
// SAFETY: the caller's: root is a live arena state; c is checked non-null, head + size bytes
// aligned to max(align, 16); head >= 32, so the 32-byte header at p - 32 lies inside c.
unsafe fn arena_large_alloc(root: *ArenaState, size: i64, align: i64) -> *u8 {
    let head = arena_large_head(align);
    let g = Gpa { _private: () };
    let c = g.try_alloc(head + size, if align > 16 { align } else { 16 });
    if c == 0 as *u8 {
        return c;
    }
    let p = &c[head];
    let h = (&p[-32]) as *ArenaLarge;
    h.size = size;
    h.align = align;
    h.prev = 0 as *ArenaLarge;
    h.next = root.large;
    if root.large != 0 as *ArenaLarge {
        root.large.prev = h;
    }
    root.large = h;
    root.large_bytes += size;
    root.chunk_bytes += head + size;
    p
}

// Gives back block p, of its own, of root.
// UNSAFE: reads and unlinks the header at p - 32, and frees through Gpa, by raw pointers.
// SAFETY: the caller's: p is a live block of its own of root (arena_large_alloc's), so its
// header is at p - 32 and its Gpa block at p - head with the size and alignment it records.
unsafe fn arena_large_free(root: *ArenaState, p: *u8) {
    let h = (&p[-32]) as *ArenaLarge;
    let head = arena_large_head(h.align);
    if h.prev == 0 as *ArenaLarge {
        root.large = h.next;
    } else {
        h.prev.next = h.next;
    }
    if h.next != 0 as *ArenaLarge {
        h.next.prev = h.prev;
    }
    root.large_bytes -= h.size;
    root.chunk_bytes -= head + h.size;
    let g = Gpa { _private: () };
    g.free(&p[-head], head + h.size, if h.align > 16 { h.align } else { 16 });
}

// Gives back the blocks of their own of root down to `mark` (the list's
// front when a scope started), or all of them.
// UNSAFE: walks root's list of blocks through raw pointers.
// SAFETY: the caller's: root is live and mark is null or a node of its list; the list is
// LIFO (new blocks at the front), so freeing from the front reaches mark or the end.
unsafe fn arena_large_free_to(root: *ArenaState, mark: *ArenaLarge) {
    for _ in 0..ALLOC_LIMIT {
        let h = root.large;
        if h == mark {
            return;
        }
        arena_large_free(root, &(h as *u8)[32]);
    }
}

// An Arena's or a ScopedArena's try_resize: the last block in place, a
// block of its own with Gpa's resize, else moved.
// UNSAFE: s and p are raw pointers to the arena's state and a block of it.
// SAFETY: the caller's (try_resize's): s is null or live, p a live block of it of old_size;
// in place only when p is the last block and p + new_size stays within the chunk's limit.
#[inline]
unsafe fn arena_resize(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)
    -> *u8 {
    if CHECK_ALLOC {
        return arena_resize_checked(s, p, old_size, new_size, align);
    }
    if s != 0 as *ArenaState && p as i64 == s.last && (new_size as u64) <= (ARENA_LARGE as u64)
        && old_size <= ARENA_LARGE && p as i64 + new_size <= s.limit {
        s.ptr = p as i64 + new_size;
        return p;
    }
    arena_resize_slow(s, p, old_size, new_size, align)
}

// UNSAFE: relinks a block of its own's header and copies blocks, by raw pointers and memcpy.
// SAFETY: the caller's, as arena_resize; a block of its own is moved whole by Gpa's resize and
// its neighbours repointed at the new header; else min(old, new) bytes are copied into a new,
// distinct block before the old one is freed.
#[cold]
#[inline(never)]
unsafe fn arena_resize_slow(s: *ArenaState, p: *u8, old_size: i64, new_size: i64, align: i64)
    -> *u8 {
    arena_usable(s);
    if new_size < 0 || new_size > ALLOC_LIMIT || !arena_align_ok(align) {
        return 0 as *u8;
    }
    if old_size > ARENA_LARGE && new_size > ARENA_LARGE {
        // (a block of its own stays one: resized by Gpa, relinked)
        let root = s.root;
        let h = (&p[-32]) as *ArenaLarge;
        let head = arena_large_head(align);
        let g = Gpa { _private: () };
        let c = g.try_resize(&p[-head], head + old_size, head + new_size,
            if align > 16 { align } else { 16 });
        if c == 0 as *u8 {
            return c;
        }
        let q = &c[head];
        let k = (&q[-32]) as *ArenaLarge;
        if k.prev == 0 as *ArenaLarge {
            root.large = k;
        } else {
            k.prev.next = k;
        }
        if k.next != 0 as *ArenaLarge {
            k.next.prev = k;
        }
        k.size = new_size;
        root.large_bytes += new_size - old_size;
        root.chunk_bytes += new_size - old_size;
        return q;
    }
    let q = arena_alloc(s, new_size, align);
    if q == 0 as *u8 {
        return q;
    }
    let n = if old_size < new_size { old_size } else { new_size };
    if n > 0 {
        memcpy(q, p, n as u64);
    }
    arena_free(s, p, old_size);
    q
}

// arena_resize with --check-alloc: the last block (the last live one of
// the arena, as the bump's `last`) grows in place in the count and moves
// to pages of its new size; any other as without.
// UNSAFE: the state's fields by raw pointer; the checking Gpa's moves.
// SAFETY: the caller's, as arena_resize; the in-place case needs p to be the owner's last live
// block (check_alloc_is_last) and the new end within the limit.
#[cold]
#[inline(never)]
unsafe fn arena_resize_checked(s: *ArenaState, p: *u8, old_size: i64, new_size: i64,
    align: i64) -> *u8 {
    if s != 0 as *ArenaState && s.last != -1 && (new_size as u64) <= (ARENA_LARGE as u64)
        && old_size <= ARENA_LARGE && s.last + new_size <= s.limit
        && check_alloc_is_last(s.root as u64, p) {
        let q = check_alloc_moved(s.root as u64, p, old_size, new_size, align);
        if q != 0 as *u8 {
            s.ptr = s.last + new_size;
        }
        return q;
    }
    arena_resize_slow(s, p, old_size, new_size, align)
}

// An Arena's or a ScopedArena's free: the last block goes back to the
// bump, a block of its own to Gpa; any other waits for the arena's end.
// Nothing while the arena is lent to a scope.
// UNSAFE: s and p are raw pointers to the arena's state and a block of it.
// SAFETY: the caller's (free's): s is null or live (checked), p a live block of size bytes of
// it; only the last block moves the bump back, so no other live block is reused.
#[inline]
unsafe fn arena_free(s: *ArenaState, p: *u8, size: i64) {
    if s == 0 as *ArenaState || s.lent {
        return;
    }
    if size > ARENA_LARGE {
        arena_large_free(s.root, p);
    } else if CHECK_ALLOC {
        // (the last live block of the arena is the bump's last; the block's
        // pages go)
        if s.last != -1 && check_alloc_is_last(s.root as u64, p) {
            s.ptr = s.last;
            s.last = -1;
        }
        check_alloc_moved(s.root as u64, p, size, 0, 1);
    } else if p as i64 == s.last {
        s.ptr = s.last;
        s.last = -1;
    }
}

// The bytes allocated from state s (blocks of their own included).
// UNSAFE: reads the state through a raw pointer.
// SAFETY: the caller's: s and its root are live ArenaStates.
unsafe fn arena_used(s: *ArenaState) -> i64 {
    s.before + s.ptr - s.start + s.root.large_bytes
}

impl Allocator for Arena {
    #[inline]
    fn try_alloc(self: *Arena, size: i64, align: i64) -> *u8 {
        // UNSAFE: the trait's self is a raw *Arena.
        // SAFETY: self is the address of the Arena the call was made on (a method call's);
        // its s is null or its state (sealed: only Arena's functions make one).
        unsafe { arena_alloc(self.s, size, align) }
    }

    // UNSAFE: the trait's: p is a raw block (Allocator::try_resize).
    // SAFETY: the caller's, as Allocator::try_resize; self.s as in try_alloc.
    #[inline]
    unsafe fn try_resize(self: *Arena, p: *u8, old_size: i64, new_size: i64, align: i64) -> *u8 {
        arena_resize(self.s, p, old_size, new_size, align)
    }

    // UNSAFE: the trait's: p is a raw block (Allocator::free).
    // SAFETY: the caller's, as Allocator::free; self.s as in try_alloc.
    #[inline]
    unsafe fn free(self: *Arena, p: *u8, size: i64, align: i64) {
        arena_free(self.s, p, size);
    }
}

impl Arena {
    // A new arena, its chunks from gpa: the first of 8 KB, the next
    // ones twice as large each up to 4 MB.
    pub fn new_in(gpa: Gpa) -> Arena {
        Arena::with_capacity_in(ARENA_FIRST, gpa)
    }

    // A new arena with room for `bytes` in its first chunk.
    pub fn with_capacity_in(bytes: i64, gpa: Gpa) -> Arena {
        let head = ARENA_CHUNK_HEAD + size_of(ArenaState);
        let room = if bytes < 0 { 0 } else { bytes };
        if room > ALLOC_LIMIT - head {
            out_of_memory();
        }
        let size = head + room;
        // UNSAFE: the first chunk's header and the arena's state are written through raw
        // pointers into memory from Gpa.
        // SAFETY: gpa.alloc returns size bytes (or stops the program), 16-aligned; the header is
        // its first 16 bytes and the ArenaState the next size_of(ArenaState), all inside; every
        // field is written before the Arena is returned.
        unsafe {
            let c = gpa.alloc(size, 16) as *ArenaChunk;
            c.next = 0 as *ArenaChunk;
            c.size = size;
            let s = (c as i64 + ARENA_CHUNK_HEAD) as *ArenaState;
            s.start = c as i64 + head;
            s.ptr = s.start;
            s.end = c as i64 + size;
            s.limit = s.end;
            s.chunk = c;
            s.last = -1;
            s.before = 0;
            s.lent = false;
            s.root = s;
            s.large_mark = 0 as *ArenaLarge;
            s.first = c;
            s.large = 0 as *ArenaLarge;
            s.large_bytes = 0;
            s.chunk_bytes = size;
            s.next_size = ARENA_NEXT;
            s.check_mark = 0;
            Arena { s: s }
        }
    }

    // An arena that has no memory, a constant (for statics: `static var
    // V: Vec<i64, Arena> = Vec::new_in(Arena::none());`, set up in main
    // with `Arena::new_in(gpa)`). Allocating from it stops the program.
    pub fn none() -> Arena {
        Arena { s: 0 as *ArenaState }
    }

    // The bytes allocated from the arena since it was made or reset.
    pub fn used(self) -> i64 {
        if self.s == 0 as *ArenaState {
            return 0;
        }
        // UNSAFE: arena_used reads the state through a raw pointer.
        // SAFETY: s is non-null here, so it is this arena's live state (sealed; free_all, which
        // frees it, is unsafe and makes the handle none).
        unsafe { arena_used(self.s) }
    }

    // The bytes the arena holds from Gpa: its chunks and blocks.
    pub fn chunk_bytes(self) -> i64 {
        if self.s == 0 as *ArenaState {
            return 0;
        }
        // UNSAFE: reads the state through a raw pointer.
        // SAFETY: as used: a non-null s is this arena's live state.
        unsafe { self.s.chunk_bytes }
    }

    // Everything allocated from the arena is given back; its chunks are
    // kept (blocks of their own go back to Gpa). Unsafe: what was
    // allocated must not be used after.
    // UNSAFE: every block allocated from the arena becomes free memory, which no type tracks.
    // SAFETY: the caller's: nothing allocated from this arena (or a copy of the handle) is used
    // after; the state is reset to the first chunk, which this arena owns.
    pub unsafe fn reset(self: *Arena) {
        let s = self.s;
        if s == 0 as *ArenaState {
            return;
        }
        arena_usable(s);
        arena_large_free_to(s, 0 as *ArenaLarge);
        if CHECK_ALLOC {
            check_alloc_release(s as u64, 0);
        }
        let c = s.first;
        s.chunk = c;
        s.start = c as i64 + ARENA_CHUNK_HEAD + size_of(ArenaState);
        s.ptr = s.start;
        s.end = c as i64 + c.size;
        s.limit = s.end;
        s.last = -1;
        s.before = 0;
    }

    // The arena's memory, chunks included, given back to Gpa; this handle
    // becomes Arena::none(). Unsafe: nothing allocated from it, and no
    // copy of the handle, may be used after.
    // UNSAFE: the arena's chunks go back to Gpa while copies of the handle and its blocks may
    // still point into them.
    // SAFETY: the caller's: neither a block of it nor a copy of the handle is used after; this
    // handle becomes none; each chunk is freed once, with the size it was allocated with.
    pub unsafe fn free_all(self: *Arena) {
        let s = self.s;
        if s == 0 as *ArenaState {
            return;
        }
        arena_usable(s);
        arena_large_free_to(s, 0 as *ArenaLarge);
        if CHECK_ALLOC {
            check_alloc_release(s as u64, 0);
        }
        let g = Gpa { _private: () };
        var c = s.first.next;
        for _ in 0..ALLOC_LIMIT {
            if c == 0 as *ArenaChunk {
                break;
            }
            let next = c.next;
            g.free(c as *u8, c.size, 16);
            c = next;
        }
        let first = s.first;
        g.free(first as *u8, first.size, 16);
        self.s = 0 as *ArenaState;
    }

    // f with a scope of this arena: what f allocates from the ScopedArena
    // it is given is given back when f returns. The arena is lent
    // meanwhile: allocating from it stops the program. Nothing on the
    // ScopedArena can leave f (#[scoped]).
    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self, f: F) -> R {
        arena_scope_of(self.s, f)
    }
}

// An arena lent to a scope (arena_scope, Arena::scope): what is allocated
// from it is given back when the scope ends, so nothing holding it can
// leave the scope (#[scoped]: not returned, not captured by another
// scope, not in a static).
#[scoped]
pub struct ScopedArena { s: *ArenaState, mark: i64 }

impl Allocator for ScopedArena {
    #[inline]
    fn try_alloc(self: *ScopedArena, size: i64, align: i64) -> *u8 {
        // UNSAFE: the trait's self is a raw *ScopedArena.
        // SAFETY: self is the address of the handle the call was made on; its s is the scope's
        // state on arena_scope_of's frame, live: #[scoped] keeps the handle inside the scope.
        unsafe { arena_alloc(self.s, size, align) }
    }

    // UNSAFE: the trait's: p is a raw block (Allocator::try_resize).
    // SAFETY: the caller's, as Allocator::try_resize; self.s as in try_alloc.
    #[inline]
    unsafe fn try_resize(self: *ScopedArena, p: *u8, old_size: i64, new_size: i64, align: i64)
        -> *u8 {
        arena_resize(self.s, p, old_size, new_size, align)
    }

    // UNSAFE: the trait's: p is a raw block (Allocator::free).
    // SAFETY: the caller's, as Allocator::free; self.s as in try_alloc.
    #[inline]
    unsafe fn free(self: *ScopedArena, p: *u8, size: i64, align: i64) {
        arena_free(self.s, p, size);
    }
}

impl ScopedArena {
    // The bytes allocated from this scope.
    pub fn used(self) -> i64 {
        // UNSAFE: arena_used reads the state through a raw pointer.
        // SAFETY: s is the scope's live state (#[scoped] keeps the handle inside the scope).
        unsafe { arena_used(self.s) - self.mark }
    }

    // f with a scope of this one (lent meanwhile), as Arena::scope.
    pub fn scope<R, F: FnMut(ScopedArena) -> R>(self, f: F) -> R {
        arena_scope_of(self.s, f)
    }
}

// f with a new arena, its chunks from gpa, given back when f returns.
pub fn arena_scope<R, F: FnMut(ScopedArena) -> R>(gpa: Gpa, f: F) -> R {
    var a = Arena::new_in(gpa);
    // (arena_scope_of, not a.scope: the scoped check of a function passed
    // by name is at the call of arena_scope, once)
    // UNSAFE: free_all gives the arena's memory back while pointers into it could remain.
    // SAFETY: a is this function's own arena, never copied out; f's blocks are on the
    // ScopedArena, which #[scoped] keeps from leaving f, so nothing of a is used after.
    unsafe {
        let r = arena_scope_of(a.s, f);
        a.free_all();
        r
    }
}

// f with a scope of the arena of state p: the scope's state starts where
// p's is, p is lent (its limit 0) until f returns, then p's blocks of
// their own made meanwhile go back.
fn arena_scope_of<R, F: FnMut(ScopedArena) -> R>(p: *ArenaState, f: F) -> R {
    var st = ArenaState {
        ptr: 0, limit: 0, chunk: 0 as *ArenaChunk, start: 0, end: 0, last: -1, before: 0,
        lent: false, root: 0 as *ArenaState, large_mark: 0 as *ArenaLarge,
        first: 0 as *ArenaChunk, large: 0 as *ArenaLarge, large_bytes: 0, chunk_bytes: 0,
        next_size: 0, check_mark: 0,
    };
    // UNSAFE: arena_lend writes both states through raw pointers.
    // SAFETY: module-private: p is the state of a sealed Arena or ScopedArena (arena_lend stops
    // the program for none or a lent one); &st is this frame's local, outliving the scope.
    let mark = unsafe { arena_lend(p, &st) };
    let site = if CHECK_ALLOC { check_alloc_site() } else { 0 as *u8 };
    var g = f;
    let r = g(ScopedArena { s: &st, mark: mark });
    // UNSAFE: arena_unlend writes both states and frees the scope's blocks of their own.
    // SAFETY: p and &st are as arena_lend had them; f has returned and its ScopedArena cannot
    // outlive it (#[scoped]), so no block of the scope is used after.
    unsafe {
        if CHECK_ALLOC {
            check_alloc_set_site(site);
        }
        arena_unlend(p, &st);
    }
    r
}

// Lends the arena of state p to a scope of state st: st starts at p's
// position, p is locked. Returns the bytes used at the start.
// UNSAFE: copies and writes ArenaState fields through raw pointers.
// SAFETY: the caller's: p is null or a live state (arena_usable stops the program for null or
// lent) and st a live, writable state.
unsafe fn arena_lend(p: *ArenaState, st: *ArenaState) -> i64 {
    arena_usable(p);
    st.ptr = p.ptr;
    st.limit = p.limit;
    st.chunk = p.chunk;
    st.start = p.start;
    st.end = p.end;
    st.before = p.before;
    st.root = p.root;
    st.large_mark = p.root.large;
    if CHECK_ALLOC {
        st.check_mark = check_alloc_mark();
    }
    p.lent = true;
    p.limit = 0;
    arena_used(st)
}

// The scope of state st is over: its blocks of their own go back, and p,
// where it was, is no longer lent (st's chunks are p's next ones).
// UNSAFE: writes both states and frees blocks of their own through raw pointers.
// SAFETY: the caller's: p and st are the states arena_lend joined, and nothing allocated in
// the scope is used after.
unsafe fn arena_unlend(p: *ArenaState, st: *ArenaState) {
    arena_large_free_to(p.root, st.large_mark);
    if CHECK_ALLOC {
        // (the scope's blocks, and its scopes': p was locked meanwhile)
        check_alloc_release(p.root as u64, st.check_mark);
    }
    st.lent = true;
    st.limit = 0;
    p.lent = false;
    p.limit = p.end;
}

// ---- FixedBuf (0.16) ----

// An allocator in a fixed buffer of bytes: `FixedBuf::new(&mem[..])` over an
// array or a Vec's elements. Blocks bump through it; when it is full,
// try_alloc is null (out of memory). Its first 16 bytes (from the first one
// aligned to 8) hold the bytes used and the last block, so copies of the
// handle share them. (0.25) mem is lent to it inout (`FixedBuf::new(&mem[..])`)
// and it views mem (`mem`), so while it, a copy of it or a container on it
// is live, mem is not written or dropped another way (own.conflict), and it
// cannot outlive mem. (A handle is copied into each container, so it holds
// a view, not the inout access itself, which would make it move-only.)
pub struct FixedBuf { base: *u8, cap: i64, mem: [u8] }

const FIXED_HEAD: i64 = 16;

impl Allocator for FixedBuf {
    #[inline]
    fn try_alloc(self: *FixedBuf, size: i64, align: i64) -> *u8 {
        // UNSAFE: the trait's self is a raw *FixedBuf.
        // SAFETY: self is the address of the handle the call was made on.
        if unsafe { self.cap } == 0 || !arena_align_ok(align) {
            return 0 as *u8;
        }
        // UNSAFE: the bump's two counters live in mem's first bytes, reached by raw pointer.
        // SAFETY: cap != 0, so `new` put base 16 bytes after an 8-aligned address inside mem and
        // h[0..2] are those bytes; a block is returned only when p + size <= base + cap, the end
        // of mem, which the handle's view keeps alive and unaliased (#[views(mem)]).
        unsafe {
            let h = (&self.base[-FIXED_HEAD]) as *i64;
            let b = self.base as i64;
            let p = (b + h[0] + align - 1) & -align;
            if size < 0 || size > ALLOC_LIMIT || p + size > b + self.cap {
                return 0 as *u8;
            }
            h[0] = p + size - b;
            h[1] = p;
            if CHECK_ALLOC {
                // (the block's own pages; the bump keeps the count)
                return check_alloc_block(self.base as u64, size, align);
            }
            p as *u8
        }
    }

    // UNSAFE: the trait's: p is a raw block (Allocator::try_resize); the counters by raw pointer.
    // SAFETY: the caller's, as Allocator::try_resize; h as in try_alloc; in place only for the
    // last block when its new end is within mem; else min(old, new) bytes copied to a new block,
    // which never overlaps p (the bump only moves forward past it).
    #[inline]
    unsafe fn try_resize(self: *FixedBuf, p: *u8, old_size: i64, new_size: i64, align: i64)
        -> *u8 {
        if self.cap == 0 || new_size < 0 || new_size > ALLOC_LIMIT {
            return 0 as *u8;
        }
        let h = (&self.base[-FIXED_HEAD]) as *i64;
        let b = self.base as i64;
        if CHECK_ALLOC {
            // (h[1] is the last block's place in the count; the block moves
            // to pages of its new size)
            let owner = self.base as u64;
            if h[1] != -1 && h[1] + new_size <= b + self.cap && check_alloc_is_last(owner, p) {
                let q = check_alloc_moved(owner, p, old_size, new_size, align);
                if q != 0 as *u8 {
                    h[0] = h[1] + new_size - b;
                }
                return q;
            }
            let q = self.try_alloc(new_size, align);
            if q == 0 as *u8 {
                return q;
            }
            let n = if old_size < new_size { old_size } else { new_size };
            if n > 0 {
                memcpy(q, p, n as u64);
            }
            check_alloc_moved(owner, p, old_size, 0, align);
            return q;
        }
        if p as i64 == h[1] && p as i64 + new_size <= b + self.cap {
            h[0] = p as i64 + new_size - b;
            return p;
        }
        let q = self.try_alloc(new_size, align);
        if q == 0 as *u8 {
            return q;
        }
        let n = if old_size < new_size { old_size } else { new_size };
        if n > 0 {
            memcpy(q, p, n as u64);
        }
        q
    }

    // UNSAFE: the trait's: p is a raw block (Allocator::free); the counters by raw pointer.
    // SAFETY: the caller's, as Allocator::free; h as in try_alloc; only the last block moves
    // the bump back.
    #[inline]
    unsafe fn free(self: *FixedBuf, p: *u8, size: i64, align: i64) {
        if self.cap == 0 {
            return;
        }
        let h = (&self.base[-FIXED_HEAD]) as *i64;
        if CHECK_ALLOC {
            let owner = self.base as u64;
            if h[1] != -1 && check_alloc_is_last(owner, p) {
                h[0] = h[1] - self.base as i64;
                h[1] = -1;
            }
            check_alloc_moved(owner, p, size, 0, align);
            return;
        }
        if p as i64 == h[1] {
            h[0] = p as i64 - self.base as i64;
            h[1] = -1;
        }
    }
}

impl FixedBuf {
    // An allocator in mem (its first 16 bytes, from the first one aligned
    // to 8, are its own; a smaller mem has no room).
    // (0.25: mem inout, held by the allocator: it writes there)
    #[views(mem)]
    pub fn new(mem: inout [u8]) -> FixedBuf {
        let at = mem.ptr as i64;
        let skip = ((at + 7) & -8) - at + FIXED_HEAD;
        if mem.len <= skip {
            return FixedBuf { base: 0 as *u8, cap: 0, mem: mem };
        }
        // UNSAFE: the counters are written into mem's first bytes through a raw pointer.
        // SAFETY: mem.len > skip (checked), so base = mem.ptr + skip is inside mem and
        // base - 16 = mem.ptr + (8-alignment padding) holds two aligned i64s within mem.
        unsafe {
            let base = &mem.ptr[skip];
            let h = (&base[-FIXED_HEAD]) as *i64;
            h[0] = 0;
            h[1] = -1;
            FixedBuf { base: base, cap: mem.len - skip, mem: mem }
        }
    }

    // The bytes allocated from it.
    pub fn used(self) -> i64 {
        if self.cap == 0 {
            return 0;
        }
        // UNSAFE: the counter is in mem's first bytes, reached by raw pointer.
        // SAFETY: cap != 0, so base - 16 is the 8-aligned counters `new` wrote inside mem.
        unsafe { ((&self.base[-FIXED_HEAD]) as *i64)[0] }
    }

    // Its bytes, for allocating from it again. Unsafe: what was allocated
    // must not be used after.
    // UNSAFE: every block allocated from it becomes free memory, which no type tracks.
    // SAFETY: the caller's: nothing allocated from this FixedBuf (or a copy) is used after; the
    // counters are written where `new` put them.
    pub unsafe fn reset(self: *FixedBuf) {
        if self.cap != 0 {
            let h = (&self.base[-FIXED_HEAD]) as *i64;
            h[0] = 0;
            h[1] = -1;
            if CHECK_ALLOC {
                check_alloc_release(self.base as u64, 0);
            }
        }
    }
}

// ---- The ambient Gpa of 0.15 (0.16, until the corpus is migrated) ----

// std's ambient constructors of 0.15 (`Vec::new()`, `collect()`...),
// errors outside std, take their Gpa here, until `fix --only alloc016`
// migrates the corpus (front/ambient.vl): not `pub`, it goes with them.
trait Ambient { fn ambient() -> Self; }

impl Ambient for Gpa {
    #[ambient("a 'gpa: Gpa' parameter, from main's")]
    #[inline]
    fn ambient() -> Gpa { Gpa { _private: () } }
}

// ---- Panic and unreachable, the prelude's (0.17) ----

// The prelude's `panic(message)`: prints `message` on stderr and exits
// with 101, as a failed check does; safe (the message is a slice, not the
// C string of `std::panic`). (0.25) `at` is the call's `FILE:LINE:COL`,
// which the compiler gives a call in the program (front/contracts/
// desugar.vl: panic_site), printed first as a failed check prints it.
pub fn panic_str(message: [u8], at: [u8] = "") -> ! {
    // UNSAFE: write(2) and exit(3) are C calls.
    // SAFETY: each write passes a slice's pointer and its own length (or a c"" literal and its
    // length), readable for the call; exit never returns.
    unsafe {
        if at.len > 0 {
            panic_write(2, at.ptr, at.len as u64);
            panic_write(2, c": ", 2);
        }
        panic_write(2, message.ptr, message.len as u64);
        panic_write(2, c"\n", 1);
        panic_exit(101)
    }
}

// The prelude's `unreachable()`: a place the program never reaches;
// reached, it prints "FILE:LINE:COL: entered unreachable code" and exits
// with 101 (`at` as panic_str's).
pub fn unreachable(at: [u8] = "") -> ! {
    panic_str("entered unreachable code", at)
}

// (0.18) The prelude's `assert(c)`: `c` must hold; when it does not, the
// program prints `FILE:LINE:COL: assertion failed: 'c'` with the values
// of c's operands and exits with 101. `assert(c, "message")` prints the
// message instead of c. The compiler makes each call a check.
pub fn assert(ok: bool, message: [u8] = "") {
    if !ok {
        panic_str(message)
    }
}

// (0.18) The prelude's `assert_eq(a, b)`: `assert(a == b)`, which reports
// both values.
pub fn assert_eq<T: Eq>(a: sink T, b: sink T) {
    if !(a == b) {
        unreachable()
    }
}

// (0.18) The prelude's `assert_ne(a, b)`: `assert(a != b)`.
pub fn assert_ne<T: Eq>(a: sink T, b: sink T) {
    if a == b {
        unreachable()
    }
}

// (0.18) The prelude's `debug_assert(c)`: `assert(c)` in test builds
// (`volec test`, --debug-contracts); nothing (c is not evaluated) in
// others.
pub fn debug_assert(ok: bool, message: [u8] = "") {
    if !ok {
        panic_str(message)
    }
}
