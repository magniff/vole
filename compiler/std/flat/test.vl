// ---- Testing (0.18) ----

// What `#[property]` tests and `#[fuzz]` targets draw their values from,
// and the runtime of a test build (docs/design/contracts-verification.md
// §2.6, §2.7, 0.18 T2). `volec test` builds the program with
// `--test-build`: the compiler (front/tests) writes a `main` that runs the
// test its arguments name, and a generator for each property's
// parameters, built from their types (an `impl Arbitrary` where there is
// one). A value is drawn from a choice sequence of u64s, and smaller
// choices make simpler values (0: 0, false, empty, None, the first
// variant): a failing case is shrunk by shortening and lowering its
// sequence, then replaying it. Generators take `&mut Gen` (0.17).

// A type's own generator, used in place of the structural one.
pub trait Arbitrary {
    fn arbitrary(g: inout Gen) -> Self;
}

pub struct Gen {
    choices: [u64], count: i64, at: i64, size: i64, gpa: Gpa, depth: i64,
    showing: bool, report: i32, raw: bool,
}

impl Gen {
    // An integer: 0, -1, 1, -2, 2, ... as the choice grows (the edges,
    // i64::MIN and i64::MAX, are the largest choices).
    pub fn int(inout self) -> i64 {
        let c = self.draw();
        ((c >> 1) as i64) ^ -((c & 1) as i64)
    }

    // An integer in lo..=hi (lo first).
    pub fn int_in(inout self, lo: i64, hi: i64) -> i64 {
        let c = self.draw();
        if hi <= lo {
            return lo;
        }
        let span = (hi - lo) as u64 + 1;
        if span == 0 {
            return lo + c as i64;
        }
        lo + (c % span) as i64
    }

    // One of 0..n.
    pub fn choose(inout self, n: i64) -> i64 {
        let c = self.draw();
        if n <= 1 { 0 } else { (c % n as u64) as i64 }
    }

    pub fn bool(inout self) -> bool {
        self.draw() % 2 == 1
    }

    // The size this case may grow to (it grows with the case number).
    pub fn size(inout self) -> i64 {
        self.size
    }

    // A text byte: letters and digits first, then spaces, punctuation,
    // newlines and the rest.
    pub fn text_byte(inout self) -> u8 {
        let c = self.draw();
        let common = "abcdefghijklmnopqrstuvwxyz0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ\n.,-_:;()+*/=";
        if c < 200 {
            return common[(c % common.len as u64) as i64];
        }
        (c % 256) as u8
    }
}

// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap: a missing
// file is written (a new snapshot, the test passes), a different one
// fails with its first differing line; `volec test --accept` writes
// the current text.
pub fn assert_snapshot<T: Debug>(x: T) {
    let gpa = Gpa { _private: () };
    TEST_SNAP_COUNT += 1;
    var text = format_in("{x:?}", gpa);
    text.push('\n');
    var path = Buf::new_in(gpa);
    var shown = Buf::new_in(gpa);
    if TEST_SNAPSHOTS_SET {
        path.push_str(TEST_SNAPSHOTS);
        path.push('/');
    } else {
        path.push_str("tests/");
    }
    shown.push_str("tests/");
    path.push_str("snapshots");
    // (the tests directory, then its snapshots/; 0o755, an existing one kept)
    let at = path.len() as i64 - 10;
    let _ = std::sys::sys_mkdir(path.as_slice()[0..at], 493);
    let _ = std::sys::sys_mkdir(path.as_slice(), 493);
    var file = Buf::new_in(gpa);
    file.push_str("/");
    let module = TEST_MODULE;
    var i = 0;
    while i < module.len as i64 {
        if module[i] == ':' {
            file.push_str("__");
            i += 2;
        } else {
            file.push(module[i]);
            i += 1;
        }
    }
    if module.len as i64 > 0 {
        file.push_str("__");
    }
    file.push_str(TEST_NAME);
    file.push_str("__");
    file.push_int(TEST_SNAP_COUNT);
    file.push_str(".snap");
    path.push_str(file.as_slice());
    shown.push_str("snapshots");
    shown.push_str(file.as_slice());
    var old = Buf::new_in(gpa);
    let had = test_read_file(path.as_slice(), &old);
    if had && old.as_slice() == text.as_slice() {
    } else if !had || TEST_ACCEPT {
        if !test_write_file(path.as_slice(), text.as_slice()) {
            eprintln("snapshot {}: cannot write {}", shown.as_slice(), path.as_slice());
            test_c_exit(101);
        }
        println(
            "vole-test: snapshot {} {}", if had { "accepted" } else { "new" }, shown.as_slice());
    } else {
        var k = 0;
        while test_line(old.as_slice(), k) == test_line(text.as_slice(), k) {
            k += 1;
        }
        eprintln(
            "snapshot differs: {} line {}: '{}' expected, got '{}'", shown.as_slice(), k + 1,
            test_line(old.as_slice(), k), test_line(text.as_slice(), k));
        test_c_exit(101);
    }
    text.free();
    path.free();
    shown.free();
    file.free();
    old.free();
}

// ---- The test runtime's implementation (0.18) ----

// A test build's main (front/tests makes it) runs one test: a #[test]
// in the process, a property's cases each in a child process; the
// generators of the types a property takes; snapshots' files.

// (0.25.4) The rest of the system calls go through std::sys's safe
// functions.
// UNSAFE: C functions std::sys has no safe form of: fork, atexit, _exit.
// SAFETY: the prototypes are unistd.h's and stdlib.h's; each call says why it is sound.
extern "C" {
    #[effects(io)]
    fn fork() -> i32;
    #[link_name = "atexit"]
    #[effects(io)]
    fn test_atexit(f: extern "C" fn()) -> i32;
    #[link_name = "_exit"]
    #[effects(io, diverge)]
    fn test_exit_now(code: i32) -> !;
}

impl Gen {
    // The next choice: 0 past the end of the sequence (the simplest).
    pub fn draw(inout self) -> u64 {
        let k = self.at;
        self.at += 1;
        if k >= self.count {
            return 0;
        }
        self.choices[k]
    }

    // Whether a collection of `len` elements gets one more.
    pub fn more(inout self, len: i64) -> bool {
        if len >= self.size || self.depth > 4 {
            return false;
        }
        self.draw() % 4 != 0
    }

    // How deep a recursive type's generator is.
    pub fn depth(inout self) -> i64 {
        self.depth
    }

    // The allocator generated containers use.
    pub fn gpa(inout self) -> Gpa {
        self.gpa
    }

    // Whether this run is the replay of a failure (its inputs printed).
    pub fn showing(inout self) -> bool {
        self.showing
    }

    // The choices used so far, told to the runner (the generators are
    // done; the property runs next).
    pub fn generated(inout self) {
        if self.report >= 0 {
            let used = test_i64_bytes(self.at);
            let _ = std::sys::sys_write(self.report, used[..]);
            let _ = std::sys::sys_close(self.report);
            self.report = -1;
        }
    }

    // A recursive type's generator goes one level down (shallower values
    // past a depth).
    pub fn enter(inout self) {
        self.depth += 1;
    }

    pub fn leave(inout self) {
        self.depth -= 1;
    }
}

// The generator of T: its `impl Arbitrary` (std's for the numbers and
// bool, the compiler's for a test's structs and enums).
pub fn arbitrary_of<T: Arbitrary>(g: inout Gen) -> T {
    T::arbitrary(&g)
}

pub fn gen_vec<T, F: Fn(inout Gen) -> T>(g: inout Gen, f: F) -> Vec<T> {
    var v: Vec<T> = Vec::new_in(g.gpa);
    g.enter();
    while g.more(v.len() as i64) {
        v.push(f(&g));
    }
    g.leave();
    v
}

pub fn gen_option<T, F: Fn(inout Gen) -> T>(g: inout Gen, f: F) -> Option<T> {
    if g.draw() % 2 == 0 { Option::None } else { Option::Some(f(&g)) }
}

pub fn gen_result<T, E, F: Fn(inout Gen) -> T,
    G: Fn(inout Gen) -> E>(g: inout Gen, f: F, e: G) -> Result<T, E> {
    if g.draw() % 2 == 0 { Result::Ok(f(&g)) } else { Result::Err(e(&g)) }
}

pub fn gen_text(g: inout Gen) -> Vec<u8> {
    var v: Vec<u8> = Vec::new_in(g.gpa);
    while g.more(v.len() as i64) {
        v.push(g.text_byte());
    }
    v
}

pub fn gen_buf(g: inout Gen) -> Buf {
    var b = Buf::new_in(g.gpa);
    while g.more(b.len() as i64) {
        b.push(g.text_byte());
    }
    b
}

pub fn gen_f64(g: inout Gen) -> f64 {
    let c = g.draw();
    if c < 6 {
        let edges = [0.0, 1.0, -1.0, -0.0, 1.0 / 0.0, -1.0 / 0.0];
        return edges[c as i64];
    }
    let n = ((c >> 1) as i64) ^ -((c & 1) as i64);
    (n as f64) / 8.0
}

impl Arbitrary for i64 {
    fn arbitrary(g: inout Gen) -> i64 { g.int() }
}

impl Arbitrary for i32 {
    fn arbitrary(g: inout Gen) -> i32 { g.int() as i32 }
}

impl Arbitrary for i16 {
    fn arbitrary(g: inout Gen) -> i16 { g.int() as i16 }
}

impl Arbitrary for i8 {
    fn arbitrary(g: inout Gen) -> i8 { g.int() as i8 }
}

impl Arbitrary for u64 {
    fn arbitrary(g: inout Gen) -> u64 { g.draw() }
}

impl Arbitrary for usize {
    fn arbitrary(g: inout Gen) -> usize { g.draw() as usize }
}

impl Arbitrary for isize {
    fn arbitrary(g: inout Gen) -> isize { g.int() as isize }
}

impl Arbitrary for u32 {
    fn arbitrary(g: inout Gen) -> u32 { g.draw() as u32 }
}

impl Arbitrary for u16 {
    fn arbitrary(g: inout Gen) -> u16 { g.draw() as u16 }
}

impl Arbitrary for u8 {
    fn arbitrary(g: inout Gen) -> u8 { g.draw() as u8 }
}

impl Arbitrary for bool {
    fn arbitrary(g: inout Gen) -> bool { g.bool() }
}

impl Arbitrary for f64 {
    fn arbitrary(g: inout Gen) -> f64 { gen_f64(&g) }
}

// What `volec test` passes to a test binary: `--vole-test NAME`
// (else `--vole-list`), `--cases N`, `--seed S`, `--snapshots DIR`,
// `--accept`.
static var TEST_CASES: i64 = 100;
static var TEST_SEED: u64 = 0;
static var TEST_SEED_SET: bool = false;
// (0.25.4: the arguments are views of argv's strings, which live as long
// as the process)
static var TEST_SNAPSHOTS: [u8] = "";
static var TEST_SNAPSHOTS_SET: bool = false;
static var TEST_ACCEPT: bool = false;
static var TEST_MODULE: [u8] = "";
static var TEST_NAME: [u8] = "";
static var TEST_SNAP_COUNT: i64 = 0;
// (fuzzing, std/fuzz.vl) `--fuzz-time S`, `--fuzz-dir DIR`, `--replay
// FILE` (repeated); whether the choices are an input's bytes.
static var TEST_FUZZ_TIME: i64 = 0;
static var TEST_FUZZ_DIR: [u8] = "";
static var TEST_FUZZ_DIR_SET: bool = false;
static var TEST_REPLAY: [[u8]; 256] = [""; 256];
static var TEST_REPLAYS: i64 = 0;
static var TEST_RAW: bool = false;

// The exit status of a property case whose `requires` failed (discarded).
const TEST_DISCARD: i32 = 77;

// i64 <-> its 8 bytes (little-endian), for what a case reports on its pipe.
fn test_i64_bytes(x: i64) -> [u8; 8] {
    var b: [u8; 8] = [0; 8];
    for k in 0..8 {
        b[k] = ((x >> (8 * k)) & 255) as u8;
    }
    b
}

fn test_bytes_i64(b: [u8; 8]) -> i64 {
    var x: i64 = 0;
    for k in 0..8 {
        x = x | ((b[k] as i64) << (8 * k));
    }
    x
}

fn test_number(s: [u8]) -> u64 {
    var n: u64 = 0;
    var i = 0;
    var base: u64 = 10;
    if s.len as i64 > 2 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X') {
        base = 16;
        i = 2;
    }
    while i < s.len as i64 {
        let c = s[i];
        let d = if c >= '0' && c <= '9' { (c - '0') as u64 }
            else if c >= 'a' && c <= 'f' { (c - 'a') as u64 + 10 }
            else if c >= 'A' && c <= 'F' { (c - 'A') as u64 + 10 }
            else { 99 };
        if d >= base {
            break;
        }
        n = n * base + d;
        i += 1;
    }
    n
}

// A test binary's arguments (std::env::args_os: 0.25.5, safe; before,
// main's argc and argv): the test to run (empty: list them). The views it
// keeps in statics are argv's, which live as long as the process.
pub fn test_args() -> [u8] {
    var name: [u8] = "";
    var args = std::env::args_os();
    let _ = args.next();
    var next = args.next();
    loop {
        let a = match next {
            Some(x) => x,
            None => break,
        };
        let after = args.next();
        let has_value = after.is_some();
        let value = after.unwrap_or("");
        // (whether the flag took `value`)
        var took = has_value;
        if a == "--vole-test" && has_value {
            name = value;
        } else if a == "--cases" && has_value {
            TEST_CASES = test_number(value) as i64;
        } else if a == "--seed" && has_value {
            TEST_SEED = test_number(value);
            TEST_SEED_SET = true;
        } else if a == "--snapshots" && has_value {
            TEST_SNAPSHOTS = value;
            TEST_SNAPSHOTS_SET = true;
        } else if a == "--fuzz-time" && has_value {
            TEST_FUZZ_TIME = test_number(value) as i64;
        } else if a == "--fuzz-dir" && has_value {
            TEST_FUZZ_DIR = value;
            TEST_FUZZ_DIR_SET = true;
        } else if a == "--replay" && has_value {
            if TEST_REPLAYS < 256 {
                TEST_REPLAY[TEST_REPLAYS] = value;
                TEST_REPLAYS += 1;
            }
        } else {
            if a == "--accept" {
                TEST_ACCEPT = true;
            }
            took = false;
        }
        next = if took { args.next() } else { after };
    }
    name
}

// A test of module `module` (its path, `a::tests`) starts.
pub fn test_begin(module: [u8], name: [u8], gpa: Gpa) {
    TEST_MODULE = module;
    TEST_NAME = name;
    TEST_SNAP_COUNT = 0;
    // (an allocation first: --check-alloc's handler at exit is then
    // registered before test_at_exit, which runs before it)
    var first: Vec<u8> = Vec::new_in(gpa);
    first.push(0);
    first.free();
    test_running();
}

// A test that ends the process (a failed check) ends it at once: the
// leaks it leaves are not listed after its failure (exit 101).
static var TEST_RUNNING: bool = false;
static var TEST_HANDLER: bool = false;

static var TEST_EXIT_CODE: i32 = 101;

// C's exit: the atexit handlers run (test_at_exit, --check-alloc's), as a
// test's end has always been; std::process::exit would first write out
// print's buffer.
fn test_c_exit(code: i32) -> ! {
    // UNSAFE: C's exit, a C call.
    // SAFETY: any int is a valid status (the low 8 bits are kept); it does not return.
    unsafe { exit(code) }
}

// C's _exit: the process ends at once, no atexit handler, no flush.
fn test_quit(code: i32) -> ! {
    // UNSAFE: C's _exit, a C call.
    // SAFETY: any int is a valid status; it does not return and touches no vole state.
    unsafe { test_exit_now(code) }
}

extern "C" fn test_at_exit() {
    if TEST_RUNNING {
        test_quit(TEST_EXIT_CODE);
    }
}

// This process ends with `code`, before --check-alloc lists what it
// leaves allocated (a runner's, not the test's).
fn test_exit(code: i32) -> ! {
    test_running();
    TEST_EXIT_CODE = code;
    test_c_exit(code)
}

fn test_running() {
    if !TEST_HANDLER {
        // UNSAFE: C's atexit, a C call taking a function pointer.
        // SAFETY: test_at_exit is an `extern "C" fn()` that lives as long as the program;
        // TEST_HANDLER registers it once (atexit's limit is 32 or more).
        unsafe { test_atexit(test_at_exit) };
        TEST_HANDLER = true;
    }
    TEST_RUNNING = true;
}

// A #[test] returned.
pub fn test_done() {
    TEST_RUNNING = false;
}

// A test left blocks allocated (with --check-alloc, which test builds
// use; they are listed): it fails.
pub fn test_leaked() -> ! {
    test_c_exit(101)
}

// A `#[test]` that returned Err(e): the error, exit 101.
pub fn test_err<E: Debug>(e: sink E) -> ! {
    eprintln("test returned Err({e:?})");
    test_c_exit(101)
}

pub fn test_unknown(name: [u8]) -> i32 {
    eprintln("no test '{name}' in this program (--vole-list lists them)");
    2
}

// A property case whose `requires` does not hold: not a failure.
pub fn test_discard() -> ! {
    test_quit(TEST_DISCARD)
}

// The line that begins an input's value, when a failure is replayed.
pub fn test_input(name: [u8]) {
    print("vole-test: input {name} = ");
}

pub fn test_input_end() {
    println("");
}

// The choices of a case (splitmix64 from the state): mostly small, some
// edges, some anything.
fn test_next(state: inout u64) -> u64 {
    state = state + 0x9e3779b97f4a7c15;
    var z = state;
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
    z ^ (z >> 31)
}

fn test_choice(state: inout u64, size: i64) -> u64 {
    let r = test_next(&state);
    let pick = r % 20;
    if pick == 0 {
        // (the edges: i64::MIN, i64::MAX, u64::MAX, a byte's)
        let e = test_next(&state) % 5;
        return if e == 0 { 0xffffffffffffffff } else if e == 1 { 0xfffffffffffffffe }
            else if e == 2 { 255 } else if e == 3 { 256 } else { 0x8000000000000000 };
    }
    if pick < 3 {
        return test_next(&state);
    }
    test_next(&state) % (2 * size as u64 + 4)
}

fn test_seed_of(name: [u8]) -> u64 {
    if TEST_SEED_SET {
        return TEST_SEED;
    }
    var h: u64 = 14695981039346656037;
    for i in 0..name.len as i64 {
        h = (h ^ name[i] as u64) * 1099511628211;
    }
    h
}

struct CaseRun { status: i32, used: i64 }

// Runs one case in a child process: its exit status (0 passed,
// TEST_DISCARD discarded, else failed) and the choices it used.
fn test_case<F: Fn(inout Gen)>(f: F, gpa: Gpa, choices: Vec<u64>, size: i64, quiet: bool) -> CaseRun {
    let (rd, wr) = test_pipe();
    let pid = test_fork();
    if pid == 0 {
        let _ = std::sys::sys_close(rd);
        if quiet {
            test_quiet();
        }
        test_running();
        let s = choices.as_slice();
        var g = Gen {
            choices: s, count: s.len as i64, at: 0, size: size, gpa: gpa, depth: 0,
            showing: !quiet, report: wr, raw: TEST_RAW,
        };
        // (0.18 with 0.17's drops: the case's values are dropped by now, so
        // a block it allocated and left is a leak; --check-alloc)
        let mark = check_alloc_mark();
        f(&g);
        if check_alloc_leaks_since(mark) > 0 {
            test_quit(101);
        }
        test_quit(0);
    }
    let _ = std::sys::sys_close(wr);
    let used = test_read_i64(rd);
    let _ = std::sys::sys_close(rd);
    CaseRun { status: test_wait(pid), used: if used >= 0 { used } else { choices.len() as i64 } }
}

// A pipe, (read end, write end); none stops the runner (exit 2).
fn test_pipe() -> (i32, i32) {
    match std::sys::sys_pipe() {
        Ok(p) => p,
        Err(_) => {
            eprintln("vole-test: cannot make a pipe");
            test_c_exit(2)
        }
    }
}

// fork(2): 0 in the child, the child's pid in the parent.
fn test_fork() -> i32 {
    // UNSAFE: fork is a C call std::sys has no safe form of: the child is a copy of this process.
    // SAFETY: the runner forks from its one thread (a property's cases run one at a time, the
    // runner starts no thread), so the child's copy of every lock and buffer is consistent; the
    // child runs one case and ends with _exit (test_quit), never returning into the runner.
    unsafe { fork() }
}

// A case's stdout and stderr to /dev/null.
fn test_quiet() {
    match std::sys::sys_open("/dev/null", std::sys::SYS_O_WRONLY, 0) {
        Ok(null) => {
            let _ = std::sys::sys_dup2(null, 1);
            let _ = std::sys::sys_dup2(null, 2);
        }
        Err(_) => {}
    }
}

// The 8 bytes of an i64 a child reports on fd; -1 when it reports nothing.
fn test_read_i64(fd: i32) -> i64 {
    var b: [u8; 8] = [0; 8];
    match std::sys::sys_read(fd, &b[..]) {
        Ok(n) => if n == 8 { test_bytes_i64(b) } else { -1 },
        Err(_) => -1,
    }
}

// Waits for child pid: its exit code, 128 + the signal that ended it.
fn test_wait(pid: i32) -> i32 {
    let s = match std::sys::sys_waitpid(pid, false) {
        Ok((_, st)) => st as i64,
        Err(_) => 0,
    };
    if (s & 127) == 0 { ((s >> 8) & 255) as i32 } else { 128 + (s & 127) as i32 }
}

fn test_fails(r: CaseRun) -> bool {
    r.status != 0 && r.status != TEST_DISCARD
}

// Candidate `c` replaces `best` when it fails too (cut to what it used).
fn test_try<F: Fn(inout Gen)>(f: F, gpa: Gpa, best: inout Vec<u64>, c: Vec<u64>, size: i64,
    steps: inout i64) -> bool {
    let r = test_case(f, gpa, c, size, true);
    if !test_fails(r) {
        return false;
    }
    steps = steps + 1;
    best.clear();
    let n = if r.used < c.len() as i64 { r.used } else { c.len() as i64 };
    for i in 0..n {
        best.push(c.get(i as usize));
    }
    true
}

// The failing choices `best` made smaller: chunks deleted, choices set to
// zero, halved, lowered by one, neighbours put in order; to a fixpoint (or
// 2000 candidates).
fn test_shrink<F: Fn(inout Gen)>(f: F, gpa: Gpa, best: inout Vec<u64>, size: i64) -> i64 {
    var steps = 0;
    var tries = 0;
    var c: Vec<u64> = Vec::new_in(gpa);
    var changed = true;
    while changed && tries < 2000 {
        changed = false;
        for k in [8, 4, 2, 1] {
            var i = best.len() as i64 - k;
            while i >= 0 && tries < 2000 {
                c.clear();
                for j in 0..best.len() as i64 {
                    if j < i || j >= i + k {
                        c.push(best.get(j as usize));
                    }
                }
                tries += 1;
                if test_try(f, gpa, &best, c, size, &steps) {
                    changed = true;
                }
                i -= 1;
                if i > best.len() as i64 - k {
                    i = best.len() as i64 - k;
                }
            }
        }
        var i = 0;
        while i < best.len() as i64 && tries < 2000 {
            // lowered: to 0, else the smallest that still fails, by halves
            var lo: u64 = 0;
            var first = true;
            while i < best.len() as i64 && best.get(i as usize) > lo && tries < 2000 {
                let v = best.get(i as usize);
                let w = if first { 0 } else { lo + (v - lo) / 2 };
                first = false;
                c.clear();
                for j in 0..best.len() as i64 {
                    c.push(if j == i { w } else { best.get(j as usize) });
                }
                tries += 1;
                if test_try(f, gpa, &best, c, size, &steps) {
                    changed = true;
                } else if w == lo {
                    lo = w + 1;
                } else {
                    lo = w;
                }
            }
            if i + 1 < best.len() as i64 && best.get(i as usize) > best.get((i + 1) as usize) {
                c.clear();
                for j in 0..best.len() as i64 {
                    c.push(if j == i { best.get((i + 1) as usize) }
                        else if j == i + 1 { best.get(i as usize) } else { best.get(j as usize) });
                }
                tries += 1;
                if test_try(f, gpa, &best, c, size, &steps) {
                    changed = true;
                }
            }
            i += 1;
        }
    }
    c.free();
    steps
}

// A property: TEST_CASES cases (the first all zeros: the simplest
// values), each in a child process; the first failure is shrunk, then
// replayed with its inputs printed; exit 1. `vole-test:` lines on
// stdout tell `volec test` the case and the steps.
pub fn run_property<F: Fn(inout Gen)>(gpa: Gpa, name: [u8], f: F) {
    // (the cases run in children; this process ends normally)
    test_done();
    let seed = test_seed_of(name);
    let cases = if TEST_CASES > 0 { TEST_CASES } else { 1 };
    var state = seed;
    var choices: Vec<u64> = Vec::new_in(gpa);
    var discarded = 0;
    for case in 0..cases {
        // (sizes grow over 100 cases, whatever --cases: -O0 runs the first
        // 20 of -O2's)
        let size = 1 + (if case < 100 { case } else { 99 }) * 30 / 100;
        choices.clear();
        if case > 0 {
            for _ in 0..512 {
                choices.push(test_choice(&state, size));
            }
        }
        let r = test_case(f, gpa, choices, size, true);
        if r.status == TEST_DISCARD {
            discarded += 1;
            continue;
        }
        if r.status != 0 {
            choices.truncate(if r.used < choices.len() as i64 { r.used as usize }
                else { choices.len() });
            let steps = test_shrink(f, gpa, &choices, size);
            println(
                "vole-test: property case {} of {cases}, shrunk in {steps} {}, seed {seed:x}",
                case + 1, if steps == 1 { "step" } else { "steps" });
            test_case(f, gpa, choices, size, false);
            test_exit(1);
        }
    }
    if discarded * 10 > cases * 9 {
        println("vole-test: discarded {discarded} of {cases}");
        eprintln(
            "the generator rarely satisfies the requires: {discarded} of {cases} cases discarded (write an impl Arbitrary for the parameter's type)");
        test_exit(1);
    }
    choices.free();
}

// (snapshots)

// The bytes of the file at path appended to b; false when it cannot be
// opened.
fn test_read_file(path: [u8], b: inout Buf) -> bool {
    let fd = match std::sys::sys_open(path, std::sys::SYS_O_RDONLY, 0) {
        Ok(fd) => fd,
        Err(_) => return false,
    };
    var chunk = [0 as u8; 4096];
    loop {
        let n = match std::sys::sys_read(fd, &chunk[..]) {
            Ok(n) => n,
            Err(_) => 0,
        };
        if n <= 0 {
            break;
        }
        b.push_str(chunk[0..n]);
    }
    let _ = std::sys::sys_close(fd);
    true
}

// text as the file at path (made, or emptied first; 0o644); false when it
// cannot be.
fn test_write_file(path: [u8], text: [u8]) -> bool {
    let flags = std::sys::SYS_O_WRONLY | std::sys::SYS_O_CREAT | std::sys::SYS_O_TRUNC;
    let fd = match std::sys::sys_open(path, flags, 420) {
        Ok(fd) => fd,
        Err(_) => return false,
    };
    let _ = std::sys::sys_write(fd, text);
    let _ = std::sys::sys_close(fd);
    true
}

// The line `k` (from 0) of s, and whether there is one.
fn test_line(s: [u8], k: i64) -> [u8] {
    var at = 0;
    var line = 0;
    while at <= s.len as i64 {
        var e = at;
        while e < s.len as i64 && s[e] != '\n' {
            e += 1;
        }
        if line == k {
            return s[at..e];
        }
        line += 1;
        at = e + 1;
    }
    ""
}
