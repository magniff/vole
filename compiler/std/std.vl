// (0.27.5) The bodies of std::arch's bits.* intrinsics, which the
// compiler writes as `{ super::count_ones(x) }` (arch/virtual.vl), as MVS's
// std has them at its root: u64's methods, as an i64. Not Rust's API.
#[effects(diverge)]
pub(crate) fn count_ones(x: u64) -> i64 {
    x.count_ones() as i64
}

#[effects(diverge)]
pub(crate) fn leading_zeros(x: u64) -> i64 {
    x.leading_zeros() as i64
}

#[effects(diverge)]
pub(crate) fn trailing_zeros(x: u64) -> i64 {
    x.trailing_zeros() as i64
}

// (0.18's, for the rust edition) A contract or assertion check, which the
// compiler makes (from a `requires` or `ensures` clause, `assert`,
// `assert_eq`, ...): both back ends branch to the run-time failure when
// `ok` is false, whose line the compiler writes from `check`
// (front/contracts/checks.vl) and `site` (the position it blames); a, b,
// c: the values of the holes of a format literal message, evaluated only
// when `ok` is false. Not called by programs.
// mvs: contract_check
#[effects(panic)]
pub fn contract_check(ok: bool, site: i64, check: i64, a: i64, b: i64, c: i64) {
    if !ok {
        crate::panic::panic("contract check failed");
    }
}

// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}`
// on stderr, then exit status 1, as Rust's (the compiler calls it:
// front/convert/try_main.vl).
// mvs: main_error
#[effects(io, static, panic, diverge, E)]
pub fn main_error<E: crate::fmt::Debug>(e: E) -> i32 {
    crate::fmt::eprintln("Error: {e:?}");
    1
}

// ---- Run-time CPU features (0.19; std2 0.28.0) ----

// std::arch::detect's word (docs/design/arch.md §2.5): bit b is set when
// the running CPU has feature b (the compiler's numbering: FT_* in
// compiler/src/arch/features.vl), bit 63 once the word is filled. A
// detect the build cannot fold loads it and tests one bit
// (back/isel/arch.vl; gen0/gen/arch.vl at -O0). Its sources follow, one
// group per system, at std's root, where the compiler names the target's
// (arch_init_* and arch_word_*, front/modules/stdsections.vl); each init
// takes the build's features, which it need not ask the system about.
//
// Why there is no data race:
// - A program with `main` fills the word once, as the first thing main
//   does, while it is the only thread: every later read, on any thread,
//   comes after that write, and nothing writes it again.
// - Code entered from C with no vole `main` (a library) fills it at its
//   first detect (arch_word_*): two threads may both find 0 and both fill
//   it. Each computes the same value from what the CPU and the system
//   report, and stores it with a relaxed atomic store; a reader sees 0,
//   and fills the word itself, or the whole word.
// - VOLE_ARCH_DISABLE (comma-separated feature names, or `all`) only
//   clears bits, so no setting of it makes a missing instruction run: it
//   makes detect take the fallback paths, for testing them.
static ARCH_FEATURES: crate::sync::atomic::AtomicU64 = crate::sync::atomic::AtomicU64::new(0);

fn arch_bit(b: u64) -> u64 {
    1u64 << b
}

// The word from what the system reports: VOLE_ARCH_DISABLE's features
// cleared (`a64`: unqualified names are AArch64's), then those whose
// requirements are gone, stored once.
fn arch_store(found: u64, a64: bool) -> u64 {
    let w = arch_consistent(found & !arch_disabled(a64)) | 0x8000000000000000;
    ARCH_FEATURES.store(w, crate::sync::atomic::Ordering::Relaxed);
    w
}

// w without the features whose requirements it lacks (sha3 without sha2,
// avx2 without avx), in the order of the implications, so that code under
// `detect("sha3")` never runs where the sha2 it may use is missing.
fn arch_consistent(w: u64) -> u64 {
    // (feature, what it needs) pairs: neon fp; crc aarch64; aes sha2
    // dotprod rdm fp16 i8mm bf16 neon; sha3 sha2; sse2 .. sse4.2 the one
    // before; avx sse4.2; avx2 and fma avx
    let pairs: [u64; 36] = [
        0, 1, 2, 15, 3, 0, 4, 0, 6, 0, 7, 0, 9, 0, 10, 0, 11, 0, 5, 4, 17, 16, 18, 17, 19, 18,
        20, 19, 21, 20, 29, 21, 30, 29, 31, 29,
    ];
    let mut out = w;
    let mut k = 0;
    while k < 36 {
        if (out & arch_bit(pairs[k])) != 0 && (out & arch_bit(pairs[k + 1])) == 0 {
            out &= !arch_bit(pairs[k]);
        }
        k += 2;
    }
    out
}

fn arch_same(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    for i in 0..a.len() {
        if a[i] != b[i] {
            return false;
        }
    }
    true
}

// The bits VOLE_ARCH_DISABLE names: features (`aarch64.aes`,
// `x86_64.aes` qualified), `all` every one.
fn arch_disabled(a64: bool) -> u64 {
    // (std::env's var would bring its allocation and text into every
    // program that asks detect: C's environment, read in place)
    let name: &[u8] = b"VOLE_ARCH_DISABLE=";
    let mut s: &[u8] = b"";
    let mut found = false;
    let env = crate::__sys::environ();
    let mut k: usize = 0;
    while !found {
        // UNSAFE: C's environment, an array of C strings, through raw pointers.
        // SAFETY: environ() is the null-ended array of NUL-ended strings
        // the C library keeps: k stops at its null entry, and each
        // string is read up to its NUL; nothing changes the environment
        // meanwhile (s does not outlive this call).
        unsafe {
            let p = *env.add(k);
            if p.is_null() {
                break;
            }
            let mut n: usize = 0;
            while *p.add(n) != 0 {
                n += 1;
            }
            let entry = crate::slice::from_raw_parts(p, n);
            if n >= name.len() && arch_same(&entry[..name.len()], name) {
                s = &entry[name.len()..];
                found = true;
            }
        }
        k += 1;
    }
    if !found {
        return 0;
    }
    let mut out: u64 = 0;
    let mut i = 0;
    while i <= s.len() {
        let mut j = i;
        while j < s.len() && s[j] != b',' {
            j += 1;
        }
        out |= arch_named(&s[i..j], a64);
        i = j + 1;
    }
    out
}

fn arch_named(name: &[u8], a64: bool) -> u64 {
    if arch_same(name, b"all") {
        return 0x7fffffffffffffff;
    }
    let a64_names: [&[u8]; 12] = [b"neon", b"fp", b"crc", b"aes", b"sha2", b"sha3", b"dotprod",
        b"rdm", b"lse", b"fp16", b"i8mm", b"bf16"];
    let x86_names: [&[u8]; 16] = [b"sse", b"sse2", b"sse3", b"ssse3", b"sse4.1", b"sse4.2",
        b"popcnt", b"lzcnt", b"bmi1", b"bmi2", b"pclmulqdq", b"aes", b"sha", b"avx", b"avx2",
        b"fma"];
    let mut n = name;
    let mut on_a64 = a64;
    if n.len() > 8 && arch_same(&n[0..8], b"aarch64.") {
        n = &n[8..];
        on_a64 = true;
    } else if n.len() > 7 && arch_same(&n[0..7], b"x86_64.") {
        n = &n[7..];
        on_a64 = false;
    }
    if on_a64 {
        if arch_same(n, b"asimd") {
            return 1;
        }
        for k in 0..12 {
            if arch_same(n, a64_names[k]) {
                return arch_bit(k as u64);
            }
        }
    } else {
        for k in 0..16 {
            if arch_same(n, x86_names[k]) {
                return arch_bit(16 + k as u64);
            }
        }
    }
    0
}

// AArch64 macOS: sysctl's hw.optional.arm.FEAT_*, only for the features
// the build does not assume (a default build, apple-m1, asks for two).

// UNSAFE: the system's sysctlbyname, a C function.
// SAFETY: the prototype is sys/sysctl.h's (size_t as usize).
extern "C" {
    #[link_name = "sysctlbyname"]
    #[effects(io)]
    fn arch_sysctlbyname(name: *const u8, old: *mut u8, len: *mut usize, new: *const u8,
        newlen: usize) -> i32;
}

// Whether sysctl `name` (an int) is 1.
fn arch_sysctl(name: *const u8) -> bool {
    let mut value: [u32; 2] = [0; 2];
    let mut len: usize = 8;
    // UNSAFE: sysctlbyname is a C call with raw pointers.
    // SAFETY: private: name is one of arch_init_macos's NUL-terminated c""
    // names; value is 8 writable bytes and len says 8, so the kernel
    // writes at most that; no new value.
    let r = unsafe {
        arch_sysctlbyname(name, value.as_mut_ptr() as *mut u8, &mut len as *mut usize,
            crate::ptr::null(), 0)
    };
    r == 0 && value[0] == 1
}

// Fills the word (`known`: the build's features): before main, or at a
// library's first detect.
fn arch_init_macos(known: u64) -> u64 {
    let mut found: u64 = known | arch_bit(15) | arch_bit(0) | arch_bit(1);
    // (bit, then the sysctls that must all be 1)
    let names: [*const u8; 12] = [
        c"hw.optional.arm.FEAT_CRC32", c"hw.optional.arm.FEAT_AES", c"hw.optional.arm.FEAT_PMULL",
        c"hw.optional.arm.FEAT_SHA256", c"hw.optional.arm.FEAT_SHA3",
        c"hw.optional.arm.FEAT_SHA512", c"hw.optional.arm.FEAT_DotProd",
        c"hw.optional.arm.FEAT_RDM", c"hw.optional.arm.FEAT_LSE", c"hw.optional.arm.FEAT_FP16",
        c"hw.optional.arm.FEAT_I8MM", c"hw.optional.arm.FEAT_BF16",
    ];
    // (feature, its first name, how many)
    let tests: [usize; 30] = [2, 0, 1, 3, 1, 2, 4, 3, 1, 5, 4, 2, 6, 6, 1, 7, 7, 1, 8, 8, 1, 9,
        9, 1, 10, 10, 1, 11, 11, 1];
    let mut k = 0;
    while k < 30 {
        if (found & arch_bit(tests[k] as u64)) == 0 {
            let mut all = true;
            for j in 0..tests[k + 2] {
                if !arch_sysctl(names[tests[k + 1] + j]) {
                    all = false;
                }
            }
            if all {
                found |= arch_bit(tests[k] as u64);
            }
        }
        k += 3;
    }
    arch_store(found, true)
}

// The word, filled at the first call (a library: no main filled it).
fn arch_word_macos() -> u64 {
    let w = ARCH_FEATURES.load(crate::sync::atomic::Ordering::Relaxed);
    if w != 0 { w } else { arch_init_macos(0) }
}

// AArch64 Linux: getauxval's AT_HWCAP and AT_HWCAP2.

// UNSAFE: the C library's getauxval.
// SAFETY: the prototype is sys/auxv.h's (unsigned long as u64).
extern "C" {
    #[link_name = "getauxval"]
    #[effects(io)]
    fn arch_getauxval(kind: u64) -> u64;
}

// Fills the word (`known`: the build's features): before main, or at a
// library's first detect.
fn arch_init_linux(known: u64) -> u64 {
    // UNSAFE: getauxval is a C call.
    // SAFETY: values only: AT_HWCAP (16) and AT_HWCAP2 (26); an unknown
    // kind returns 0.
    let cap = unsafe { arch_getauxval(16) };
    // UNSAFE: as cap's.
    // SAFETY: as cap's.
    let cap2 = unsafe { arch_getauxval(26) };
    // (HWCAP bits, all needed, then the feature: fp, asimd, crc32, aes and
    // pmull, sha1 and sha2, sha3 and sha512, asimddp, asimdrdm, atomics,
    // fphp and asimdhp)
    let tests: [u64; 20] = [0x1, 1, 0x2, 0, 0x80, 2, 0x18, 3, 0x60, 4, 0x220000, 5, 0x100000, 6,
        0x1000, 7, 0x100, 8, 0x600, 9];
    let mut found: u64 = known | arch_bit(15);
    let mut k = 0;
    while k < 20 {
        if (cap & tests[k]) == tests[k] {
            found |= arch_bit(tests[k + 1]);
        }
        k += 2;
    }
    // (HWCAP2: i8mm, bf16)
    if (cap2 & 0x2000) != 0 {
        found |= arch_bit(10);
    }
    if (cap2 & 0x4000) != 0 {
        found |= arch_bit(11);
    }
    arch_store(found, true)
}

// The word, filled at the first call (a library: no main filled it).
fn arch_word_linux() -> u64 {
    let w = ARCH_FEATURES.load(crate::sync::atomic::Ordering::Relaxed);
    if w != 0 { w } else { arch_init_linux(0) }
}

// x86-64, either system: cpuid, and xgetbv for whether the system saves
// the ymm registers (else no avx family: its state would be lost).

// UNSAFE: the compiler's run-time helpers around the cpuid and xgetbv
// instructions.
// SAFETY: back/isel/arch.vl's emit_arch_runtime defines them with these C
// signatures.
extern "C" {
    #[link_name = "vole_arch_cpuid"]
    fn arch_cpuid(leaf: u32, sub: u32, out: *mut u32);
    #[link_name = "vole_arch_xgetbv"]
    fn arch_xgetbv(index: u32) -> u64;
}

// Fills the word (`known`: the build's features): before main, or at a
// library's first detect.
fn arch_init_x86(known: u64) -> u64 {
    let mut r: [u32; 4] = [0; 4];
    // UNSAFE: the cpuid helper writes through a raw pointer.
    // SAFETY: r is four u32s, where it writes eax, ebx, ecx, edx; leaf 0
    // always exists.
    unsafe { arch_cpuid(0, 0, r.as_mut_ptr()); }
    let max = r[0];
    // UNSAFE: as above.
    // SAFETY: r is four u32s; leaf 1 exists on every x86-64.
    unsafe { arch_cpuid(1, 0, r.as_mut_ptr()); }
    let c1 = r[2];
    let d1 = r[3];
    let mut w: u64 = known | arch_bit(32);
    // (register: 2 ecx, 3 edx; its bit; the feature: sse, sse2, sse3,
    // ssse3, sse4.1, sse4.2, popcnt, pclmulqdq, aes)
    let tests: [u32; 27] = [3, 25, 16, 3, 26, 17, 2, 0, 18, 2, 9, 19, 2, 19, 20, 2, 20, 21, 2,
        23, 22, 2, 1, 26, 2, 25, 27];
    let mut k = 0;
    while k < 27 {
        let reg = if tests[k] == 2 { c1 } else { d1 };
        if (reg & (1u32 << tests[k + 1])) != 0 {
            w |= arch_bit(tests[k + 2] as u64);
        }
        k += 3;
    }
    // osxsave, then XCR0: the system saves xmm and ymm
    // UNSAFE: the xgetbv helper, a C call.
    // SAFETY: called only when OSXSAVE (ecx bit 27) is set (&& short-
    // circuits), so xgetbv is enabled and XCR0 (index 0) readable.
    let ymm = (c1 & 0x8000000) != 0 && (unsafe { arch_xgetbv(0) } & 6) == 6;
    if ymm && (c1 & 0x10000000) != 0 {
        w |= arch_bit(29);
        if (c1 & 0x1000) != 0 {
            w |= arch_bit(31);
        }
    }
    if max >= 7 {
        // UNSAFE: the cpuid helper writes through a raw pointer.
        // SAFETY: r is four u32s; leaf 7 is at most max (checked).
        unsafe { arch_cpuid(7, 0, r.as_mut_ptr()); }
        let b7 = r[1];
        if (b7 & 0x8) != 0 {
            w |= arch_bit(24);
        }
        if (b7 & 0x100) != 0 {
            w |= arch_bit(25);
        }
        if (b7 & 0x20000000) != 0 {
            w |= arch_bit(28);
        }
        if ymm && (b7 & 0x20) != 0 {
            w |= arch_bit(30);
        }
    }
    // UNSAFE: the cpuid helper writes through a raw pointer.
    // SAFETY: r is four u32s; leaf 0x80000000 always answers with the
    // largest extended leaf.
    unsafe { arch_cpuid(0x80000000, 0, r.as_mut_ptr()); }
    if r[0] >= 0x80000001 {
        // UNSAFE: as above.
        // SAFETY: r is four u32s; the leaf is at most the largest (checked).
        unsafe { arch_cpuid(0x80000001, 0, r.as_mut_ptr()); }
        if (r[2] & 0x20) != 0 {
            w |= arch_bit(23);
        }
    }
    arch_store(w, false)
}

// The word, filled at the first call (a library: no main filled it).
fn arch_word_x86() -> u64 {
    let w = ARCH_FEATURES.load(crate::sync::atomic::Ordering::Relaxed);
    if w != 0 { w } else { arch_init_x86(0) }
}

// (0.28.0) --coverage's counters: the compiler (middle/coverage.vl) makes
// each block of the program count in COVERAGE_MAP[k % 65536] as it runs
// (std::test::coverage reads them). Not for programs to name.
pub static mut COVERAGE_MAP: [u8; 65536] = [0; 65536];
