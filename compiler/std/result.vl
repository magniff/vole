// std::result: Result<T, E>, Rust's API. `Ok` and `Err` are in the
// prelude; `?` returns the Err early, converted through From (plan §3).
// One change from MVS beyond the receivers: `unwrap` needs `E: Debug`
// and shows the error (into the panic's fixed buffer); an E that is not
// Debug unwraps as `.ok().unwrap()` (the rewrite table says so).

use crate::clone::Clone;
use crate::default::Default;
use crate::fmt::Debug;
use crate::iter::IntoIterator;
use crate::ops::Deref;
use crate::option::Option;
use crate::result::Result::{Err, Ok};

// A value or an error.
// mvs: Result, Result::impl Clone, Result::impl Debug
#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    #[effects()]
    pub fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    #[effects(F)]
    pub fn is_ok_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {
        match self {
            Ok(x) => f(x),
            Err(_) => false,
        }
    }

    #[effects(T, E)]
    pub fn is_err(&self) -> bool {
        !self.is_ok()
    }

    #[effects(F)]
    pub fn is_err_and<F: FnOnce(E) -> bool>(self, f: F) -> bool {
        match self {
            Ok(_) => false,
            Err(e) => f(e),
        }
    }

    // The value as Some, the error dropped.
    #[effects(T, E)]
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(x) => Option::Some(x),
            Err(_) => Option::None,
        }
    }

    #[effects(T, E)]
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => Option::None,
            Err(e) => Option::Some(e),
        }
    }

    // A Result of references into self.
    #[effects()]
    pub fn as_ref(&self) -> Result<&T, &E> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(e),
        }
    }

    #[effects()]
    pub fn as_mut(&mut self) -> Result<&mut T, &mut E> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(e),
        }
    }

    #[effects(T)]
    pub fn as_deref(&self) -> Result<&T::Target, &E>
        where
            T: Deref,
    {
        match self {
            Ok(x) => Ok(x.deref()),
            Err(e) => Err(e),
        }
    }

    // std: changed: FnOnce (MVS: Fn(sink T))
    #[effects(F)]
    pub fn map<U, F: FnOnce(T) -> U>(self, op: F) -> Result<U, E> {
        match self {
            Ok(x) => Ok(op(x)),
            Err(e) => Err(e),
        }
    }

    #[effects(F)]
    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {
        match self {
            Ok(x) => f(x),
            Err(_) => default,
        }
    }

    #[effects(D, F)]
    pub fn map_or_else<U, D: FnOnce(E) -> U, F: FnOnce(T) -> U>(self, default: D, f: F) -> U {
        match self {
            Ok(x) => f(x),
            Err(e) => default(e),
        }
    }

    // std: changed: FnOnce (MVS: Fn(sink E))
    #[effects(O, T, E, F2)]
    pub fn map_err<F2, O: FnOnce(E) -> F2>(self, op: O) -> Result<T, F2> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(op(e)),
        }
    }

    #[effects(F)]
    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Result<T, E> {
        if let Ok(x) = &self {
            f(x);
        }
        self
    }

    #[effects(F)]
    pub fn inspect_err<F: FnOnce(&E)>(self, f: F) -> Result<T, E> {
        if let Err(e) = &self {
            f(e);
        }
        self
    }

    // An iterator over the value: one item, or none for an Err.
    #[effects(T, E)]
    pub fn iter(&self) -> crate::option::IntoIter<&T> {
        self.as_ref().ok().into_iter()
    }

    // The value; panics with msg and the error when Err.
    // later: format_fns
    #[effects(T, E)]
    pub fn expect(self, msg: &str) -> T
        where
            E: Debug,
    {
        self.__expect_at(msg, "")
    }

    // expect, called by a program: `at` is the call's `FILE:LINE:COL: `,
    // which the compiler writes (front/contracts/desugar.vl place_call), so
    // that the panic names the caller and shows the error. Not called by
    // programs; so are the three `_at` below.
    #[effects(panic)]
    pub fn __expect_at(self, msg: &str, at: &str) -> T
        where
            E: Debug,
    {
        match self {
            Ok(x) => x,
            Err(e) => crate::panic::panic("{at}{msg}: {e:?}"),
        }
    }

    // The value; panics with the error when Err.
    // std: changed: needs E: Debug and shows it
    // later: format_fns
    #[effects(T, E)]
    pub fn unwrap(self) -> T
        where
            E: Debug,
    {
        self.__unwrap_at("")
    }

    #[effects(panic)]
    pub fn __unwrap_at(self, at: &str) -> T
        where
            E: Debug,
    {
        match self {
            Ok(x) => x,
            Err(e) => crate::panic::panic("{at}called `Result::unwrap()` on an `Err` value: {e:?}"),
        }
    }

    #[effects(T)]
    pub fn unwrap_or_default(self) -> T
        where
            T: Default,
    {
        match self {
            Ok(x) => x,
            Err(_) => T::default(),
        }
    }

    // later: format_fns
    #[effects(T, E)]
    pub fn expect_err(self, msg: &str) -> E
        where
            T: Debug,
    {
        self.__expect_err_at(msg, "")
    }

    #[effects(panic)]
    pub fn __expect_err_at(self, msg: &str, at: &str) -> E
        where
            T: Debug,
    {
        match self {
            Ok(x) => crate::panic::panic("{at}{msg}: {x:?}"),
            Err(e) => e,
        }
    }

    // later: format_fns
    #[effects(T, E)]
    pub fn unwrap_err(self) -> E
        where
            T: Debug,
    {
        self.__unwrap_err_at("")
    }

    #[effects(panic)]
    pub fn __unwrap_err_at(self, at: &str) -> E
        where
            T: Debug,
    {
        match self {
            Ok(x) => crate::panic::panic(
                "{at}called `Result::unwrap_err()` on an `Ok` value: {x:?}"),
            Err(e) => e,
        }
    }

    #[effects(T, E, U)]
    pub fn and<U>(self, res: Result<U, E>) -> Result<U, E> {
        match self {
            Ok(_) => res,
            Err(e) => Err(e),
        }
    }

    #[effects(F, T, E, U)]
    pub fn and_then<U, F: FnOnce(T) -> Result<U, E>>(self, op: F) -> Result<U, E> {
        match self {
            Ok(x) => op(x),
            Err(e) => Err(e),
        }
    }

    #[effects(T, E, F2)]
    pub fn or<F2>(self, res: Result<T, F2>) -> Result<T, F2> {
        match self {
            Ok(x) => Ok(x),
            Err(_) => res,
        }
    }

    #[effects(O)]
    pub fn or_else<F2, O: FnOnce(E) -> Result<T, F2>>(self, op: O) -> Result<T, F2> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => op(e),
        }
    }

    #[effects(T, E)]
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(x) => x,
            Err(_) => default,
        }
    }

    // std: changed: FnOnce (MVS: Fn(sink E))
    #[effects(F)]
    pub fn unwrap_or_else<F: FnOnce(E) -> T>(self, op: F) -> T {
        match self {
            Ok(x) => x,
            Err(e) => op(e),
        }
    }

    #[effects(panic, unsafe)]
    // UNSAFE: an Err here is undefined.
    // SAFETY: a contract on the caller: self is Ok.
    pub unsafe fn unwrap_unchecked(self) -> T {
        match self {
            Ok(x) => x,
            Err(_) => crate::panic::unreachable("unwrap_unchecked on Err"),
        }
    }
}

// later: impl_on_instance
impl<T: Copy, E> Result<&T, E> {
    #[effects()]
    pub fn copied(self) -> Result<T, E> {
        match self {
            Ok(&x) => Ok(x),
            Err(e) => Err(e),
        }
    }
}

// later: impl_on_instance
impl<T: Clone, E> Result<&T, E> {
    #[effects(T)]
    pub fn cloned(self) -> Result<T, E> {
        match self {
            Ok(x) => Ok(x.clone()),
            Err(e) => Err(e),
        }
    }
}

// later: impl_on_instance
impl<T, E> Result<Option<T>, E> {
    // Ok(Some(x)) to Some(Ok(x)), and so on.
    #[effects()]
    pub fn transpose(self) -> Option<Result<T, E>> {
        match self {
            Ok(Option::Some(x)) => Option::Some(Ok(x)),
            Ok(Option::None) => Option::None,
            Err(e) => Option::Some(Err(e)),
        }
    }
}

impl<T, E> IntoIterator for Result<T, E> {
    type Item = T;
    type IntoIter = crate::option::IntoIter<T>;

    fn into_iter(self) -> crate::option::IntoIter<T> {
        self.ok().into_iter()
    }
}
