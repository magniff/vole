// EDITION: rust
// The iterator adapters: each a named struct that Iterator's method of
// the same name returns (no impl Trait in return position: plan §6), its
// fields private, its constructor std's own.

use crate::clone::Clone;
use crate::cmp::PartialEq;
use crate::iter::{DoubleEndedIterator, ExactSizeIterator, FusedIterator, IntoIterator, Iterator};
use crate::option::Option;

// Iterator::map's: f of each item.
// mvs: Map
#[derive(Clone)]
pub struct Map<I, F> {
    iter: I,
    f: F,
}

impl<I, F> Map<I, F> {
    pub(crate) fn new(iter: I, f: F) -> Map<I, F> {
        Map { iter: iter, f: f }
    }
}

// mvs: Map::impl Iterator
impl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for Map<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        self.iter.next().map(&mut self.f)
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

impl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> B> DoubleEndedIterator for Map<I, F> {
    fn next_back(&mut self) -> Option<B> {
        self.iter.next_back().map(&mut self.f)
    }
}

impl<B, I: ExactSizeIterator, F: FnMut(I::Item) -> B> ExactSizeIterator for Map<I, F> {}

// Iterator::filter's: the items the predicate says true of.
// mvs: Filter
#[derive(Clone)]
pub struct Filter<I, P> {
    iter: I,
    predicate: P,
}

impl<I, P> Filter<I, P> {
    pub(crate) fn new(iter: I, predicate: P) -> Filter<I, P> {
        Filter { iter: iter, predicate: predicate }
    }
}

// mvs: Filter::impl Iterator
// std2: changed: the predicate takes &I::Item
impl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for Filter<I, P> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        self.iter.find(&mut self.predicate)
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (0, self.iter.size_hint().1)
    }
}

impl<I: DoubleEndedIterator, P: FnMut(&I::Item) -> bool> DoubleEndedIterator for Filter<I, P> {
    fn next_back(&mut self) -> Option<I::Item> {
        self.iter.rfind(&mut self.predicate)
    }
}

// Iterator::filter_map's.
#[derive(Clone)]
pub struct FilterMap<I, F> {
    iter: I,
    f: F,
}

impl<I, F> FilterMap<I, F> {
    pub(crate) fn new(iter: I, f: F) -> FilterMap<I, F> {
        FilterMap { iter: iter, f: f }
    }
}

impl<B, I: Iterator, F: FnMut(I::Item) -> Option<B>> Iterator for FilterMap<I, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        self.iter.find_map(&mut self.f)
    }
}

impl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> Option<B>> DoubleEndedIterator for FilterMap<I,
    F> {
    fn next_back(&mut self) -> Option<B> {
        while let Option::Some(x) = self.iter.next_back() {
            if let Option::Some(y) = (self.f)(x) {
                return Option::Some(y);
            }
        }
        Option::None
    }
}

// Iterator::enumerate's: (index, item).
// mvs: Enumerate
#[derive(Clone)]
pub struct Enumerate<I> {
    iter: I,
    count: usize,
}

impl<I> Enumerate<I> {
    pub(crate) fn new(iter: I) -> Enumerate<I> {
        Enumerate { iter: iter, count: 0 }
    }
}

// mvs: Enumerate::impl Iterator
// std2: changed: the index is usize
impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (usize, I::Item);

    fn next(&mut self) -> Option<(usize, I::Item)> {
        let x = self.iter.next()?;
        let i = self.count;
        self.count += 1;
        Option::Some((i, x))
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

impl<I: ExactSizeIterator + DoubleEndedIterator> DoubleEndedIterator for Enumerate<I> {
    fn next_back(&mut self) -> Option<(usize, I::Item)> {
        let x = self.iter.next_back()?;
        Option::Some((self.count + self.iter.len(), x))
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {}

// Iterator::zip's: pairs, until either ends.
// mvs: Zip
#[derive(Clone)]
pub struct Zip<A, B> {
    a: A,
    b: B,
}

impl<A, B> Zip<A, B> {
    pub(crate) fn new(a: A, b: B) -> Zip<A, B> {
        Zip { a: a, b: b }
    }
}

// mvs: Zip::impl Iterator
impl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {
    type Item = (A::Item, B::Item);

    fn next(&mut self) -> Option<(A::Item, B::Item)> {
        let x = self.a.next()?;
        let y = self.b.next()?;
        Option::Some((x, y))
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        let (alo, ahi) = self.a.size_hint();
        let (blo, bhi) = self.b.size_hint();
        let hi = match (ahi, bhi) {
            (Option::Some(x), Option::Some(y)) => Option::Some(crate::cmp::min(x, y)),
            (Option::Some(x), Option::None) => Option::Some(x),
            (Option::None, Option::Some(y)) => Option::Some(y),
            (Option::None, Option::None) => Option::None,
        };
        (crate::cmp::min(alo, blo), hi)
    }
}

impl<A: ExactSizeIterator, B: ExactSizeIterator> ExactSizeIterator for Zip<A, B> {}

// Iterator::chain's: one, then the other.
#[derive(Clone)]
pub struct Chain<A, B> {
    a: Option<A>,
    b: Option<B>,
}

impl<A, B> Chain<A, B> {
    pub(crate) fn new(a: A, b: B) -> Chain<A, B> {
        Chain { a: Option::Some(a), b: Option::Some(b) }
    }
}

impl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {
    type Item = A::Item;

    fn next(&mut self) -> Option<A::Item> {
        if let Option::Some(a) = &mut self.a {
            match a.next() {
                Option::Some(x) => return Option::Some(x),
                Option::None => self.a = Option::None,
            }
        }
        match &mut self.b {
            Option::Some(b) => b.next(),
            Option::None => Option::None,
        }
    }
}

impl<A: DoubleEndedIterator,
    B: DoubleEndedIterator<Item = A::Item>> DoubleEndedIterator for Chain<A, B> {
    fn next_back(&mut self) -> Option<A::Item> {
        if let Option::Some(b) = &mut self.b {
            match b.next_back() {
                Option::Some(x) => return Option::Some(x),
                Option::None => self.b = Option::None,
            }
        }
        match &mut self.a {
            Option::Some(a) => a.next_back(),
            Option::None => Option::None,
        }
    }
}

// Iterator::take's: the first n items.
// mvs: Take
#[derive(Clone)]
pub struct Take<I> {
    iter: I,
    n: usize,
}

impl<I> Take<I> {
    pub(crate) fn new(iter: I, n: usize) -> Take<I> {
        Take { iter: iter, n: n }
    }
}

// mvs: Take::impl Iterator
impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.n == 0 {
            return Option::None;
        }
        self.n -= 1;
        self.iter.next()
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        if self.n == 0 {
            return (0, Option::Some(0));
        }
        let (lo, hi) = self.iter.size_hint();
        let hi = match hi {
            Option::Some(x) => crate::cmp::min(x, self.n),
            Option::None => self.n,
        };
        (crate::cmp::min(lo, self.n), Option::Some(hi))
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {}

// Iterator::skip's: all but the first n.
#[derive(Clone)]
pub struct Skip<I> {
    iter: I,
    n: usize,
}

impl<I> Skip<I> {
    pub(crate) fn new(iter: I, n: usize) -> Skip<I> {
        Skip { iter: iter, n: n }
    }
}

impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.n > 0 {
            let n = self.n;
            self.n = 0;
            return self.iter.nth(n);
        }
        self.iter.next()
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        let (lo, hi) = self.iter.size_hint();
        let lo = lo.saturating_sub(self.n);
        let hi = match hi {
            Option::Some(x) => Option::Some(x.saturating_sub(self.n)),
            Option::None => Option::None,
        };
        (lo, hi)
    }
}

impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        // the first n are skipped, so the back ends where they begin
        if self.len() > 0 { self.iter.next_back() } else { Option::None }
    }
}

impl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {}

// Iterator::take_while's.
#[derive(Clone)]
pub struct TakeWhile<I, P> {
    iter: I,
    flag: bool,
    predicate: P,
}

impl<I, P> TakeWhile<I, P> {
    pub(crate) fn new(iter: I, predicate: P) -> TakeWhile<I, P> {
        TakeWhile { iter: iter, flag: false, predicate: predicate }
    }
}

impl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for TakeWhile<I, P> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.flag {
            return Option::None;
        }
        let x = self.iter.next()?;
        if (self.predicate)(&x) {
            Option::Some(x)
        } else {
            self.flag = true;
            Option::None
        }
    }
}

// Iterator::skip_while's.
#[derive(Clone)]
pub struct SkipWhile<I, P> {
    iter: I,
    flag: bool,
    predicate: P,
}

impl<I, P> SkipWhile<I, P> {
    pub(crate) fn new(iter: I, predicate: P) -> SkipWhile<I, P> {
        SkipWhile { iter: iter, flag: false, predicate: predicate }
    }
}

impl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for SkipWhile<I, P> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        loop {
            let x = self.iter.next()?;
            if self.flag || !(self.predicate)(&x) {
                self.flag = true;
                return Option::Some(x);
            }
        }
    }
}

// Iterator::map_while's.
#[derive(Clone)]
pub struct MapWhile<I, P> {
    iter: I,
    predicate: P,
}

impl<I, P> MapWhile<I, P> {
    pub(crate) fn new(iter: I, predicate: P) -> MapWhile<I, P> {
        MapWhile { iter: iter, predicate: predicate }
    }
}

impl<B, I: Iterator, P: FnMut(I::Item) -> Option<B>> Iterator for MapWhile<I, P> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        let x = self.iter.next()?;
        (self.predicate)(x)
    }
}

// Iterator::step_by's.
#[derive(Clone)]
pub struct StepBy<I> {
    iter: I,
    step: usize,
    first_take: bool,
}

impl<I> StepBy<I> {
    pub(crate) fn new(iter: I, step: usize) -> StepBy<I> {
        if step == 0 {
            crate::panic::panic("step_by: step is 0");
        }
        StepBy { iter: iter, step: step - 1, first_take: true }
    }
}

impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.first_take {
            self.first_take = false;
            self.iter.next()
        } else {
            self.iter.nth(self.step)
        }
    }
}

// Iterator::peekable's: peek at the next item without taking it.
pub struct Peekable<I: Iterator> {
    iter: I,
    peeked: Option<Option<I::Item>>,
}

impl<I: Iterator> Peekable<I> {
    pub(crate) fn new(iter: I) -> Peekable<I> {
        Peekable { iter: iter, peeked: Option::None }
    }

    // The next item, still to come.
    #[effects(panic, diverge)]
    pub fn peek(&mut self) -> Option<&I::Item> {
        let iter = &mut self.iter;
        self.peeked.get_or_insert_with(|| iter.next()).as_ref()
    }

    #[effects(panic, diverge)]
    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {
        let iter = &mut self.iter;
        self.peeked.get_or_insert_with(|| iter.next()).as_mut()
    }

    // The next item, when func says true of it.
    #[effects(I, F)]
    pub fn next_if<F: FnOnce(&I::Item) -> bool>(&mut self, func: F) -> Option<I::Item> {
        let next = match self.peeked.take() {
            Option::Some(v) => v,
            Option::None => self.iter.next(),
        };
        match next {
            Option::Some(x) => {
                if func(&x) {
                    return Option::Some(x);
                }
                // not taken: it stays the next one
                self.peeked = Option::Some(Option::Some(x));
                Option::None
            }
            Option::None => {
                self.peeked = Option::Some(Option::None);
                Option::None
            }
        }
    }

    // The next item, when it equals expected.
    #[effects(I, T)]
    pub fn next_if_eq<T: ?Sized>(&mut self, expected: &T) -> Option<I::Item>
        where
            I::Item: PartialEq<T>,
    {
        self.next_if(|x| *x == *expected)
    }
}

impl<I: Iterator> Iterator for Peekable<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        match self.peeked.take() {
            Option::Some(v) => v,
            Option::None => self.iter.next(),
        }
    }
}

// Iterator::rev's: from the end.
#[derive(Clone)]
pub struct Rev<I> {
    iter: I,
}

impl<I> Rev<I> {
    pub(crate) fn new(iter: I) -> Rev<I> {
        Rev { iter: iter }
    }
}

impl<I: DoubleEndedIterator> Iterator for Rev<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        self.iter.next_back()
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        self.iter.next()
    }
}

impl<I: DoubleEndedIterator + ExactSizeIterator> ExactSizeIterator for Rev<I> {}

// Iterator::copied's: copies of the &T items.
#[derive(Clone)]
pub struct Copied<I> {
    iter: I,
}

impl<I> Copied<I> {
    pub(crate) fn new(iter: I) -> Copied<I> {
        Copied { iter: iter }
    }
}

impl<'a, T: Copy + 'a, I: Iterator<Item = &'a T>> Iterator for Copied<I> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        self.iter.next().copied()
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

impl<'a, T: Copy + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Copied<I> {
    fn next_back(&mut self) -> Option<T> {
        self.iter.next_back().copied()
    }
}

impl<'a, T: Copy + 'a, I: ExactSizeIterator<Item = &'a T>> ExactSizeIterator for Copied<I> {}

// Iterator::cloned's: clones of the &T items.
#[derive(Clone)]
pub struct Cloned<I> {
    iter: I,
}

impl<I> Cloned<I> {
    pub(crate) fn new(iter: I) -> Cloned<I> {
        Cloned { iter: iter }
    }
}

impl<'a, T: Clone + 'a, I: Iterator<Item = &'a T>> Iterator for Cloned<I> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        self.iter.next().cloned()
    }
}

impl<'a, T: Clone + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Cloned<I> {
    fn next_back(&mut self) -> Option<T> {
        self.iter.next_back().cloned()
    }
}

// Iterator::flatten's: the items of each item.
pub struct Flatten<I: Iterator>
    where
        I::Item: IntoIterator,
{
    iter: Fuse<I>,
    front: Option<<I::Item as IntoIterator>::IntoIter>,
    back: Option<<I::Item as IntoIterator>::IntoIter>,
}

impl<I: Iterator> Flatten<I>
    where
        I::Item: IntoIterator,
{
    pub(crate) fn new(iter: I) -> Flatten<I> {
        Flatten { iter: Fuse::new(iter), front: Option::None, back: Option::None }
    }
}

impl<I: Iterator> Iterator for Flatten<I>
    where
        I::Item: IntoIterator,
{
    type Item = <I::Item as IntoIterator>::Item;

    fn next(&mut self) -> Option<<I::Item as IntoIterator>::Item> {
        loop {
            if let Option::Some(inner) = &mut self.front {
                if let Option::Some(x) = inner.next() {
                    return Option::Some(x);
                }
                self.front = Option::None;
            }
            match self.iter.next() {
                Option::Some(inner) => self.front = Option::Some(inner.into_iter()),
                Option::None => {
                    return match &mut self.back {
                        Option::Some(b) => b.next(),
                        Option::None => Option::None,
                    };
                }
            }
        }
    }
}

// Iterator::flat_map's: the items of each f(item).
pub struct FlatMap<I, U: IntoIterator, F> {
    iter: Map<I, F>,
    front: Option<U::IntoIter>,
    back: Option<U::IntoIter>,
}

impl<I, U: IntoIterator, F> FlatMap<I, U, F> {
    pub(crate) fn new(iter: I, f: F) -> FlatMap<I, U, F> {
        FlatMap { iter: Map::new(iter, f), front: Option::None, back: Option::None }
    }
}

impl<I: Iterator, U: IntoIterator, F: FnMut(I::Item) -> U> Iterator for FlatMap<I, U, F> {
    type Item = U::Item;

    fn next(&mut self) -> Option<U::Item> {
        loop {
            if let Option::Some(inner) = &mut self.front {
                if let Option::Some(x) = inner.next() {
                    return Option::Some(x);
                }
                self.front = Option::None;
            }
            match self.iter.next() {
                Option::Some(u) => self.front = Option::Some(u.into_iter()),
                Option::None => {
                    return match &mut self.back {
                        Option::Some(b) => b.next(),
                        Option::None => Option::None,
                    };
                }
            }
        }
    }
}

// Iterator::fuse's: None for ever after the first None.
#[derive(Clone)]
pub struct Fuse<I> {
    iter: Option<I>,
}

impl<I> Fuse<I> {
    pub(crate) fn new(iter: I) -> Fuse<I> {
        Fuse { iter: Option::Some(iter) }
    }
}

impl<I: Iterator> Iterator for Fuse<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        match &mut self.iter {
            Option::Some(it) => match it.next() {
                Option::Some(x) => Option::Some(x),
                Option::None => {
                    self.iter = Option::None;
                    Option::None
                }
            },
            Option::None => Option::None,
        }
    }
}

impl<I: Iterator> FusedIterator for Fuse<I> {}

// Iterator::inspect's.
#[derive(Clone)]
pub struct Inspect<I, F> {
    iter: I,
    f: F,
}

impl<I, F> Inspect<I, F> {
    pub(crate) fn new(iter: I, f: F) -> Inspect<I, F> {
        Inspect { iter: iter, f: f }
    }
}

impl<I: Iterator, F: FnMut(&I::Item)> Iterator for Inspect<I, F> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        let x = self.iter.next()?;
        (self.f)(&x);
        Option::Some(x)
    }
}

// Iterator::scan's.
#[derive(Clone)]
pub struct Scan<I, St, F> {
    iter: I,
    f: F,
    state: St,
}

impl<I, St, F> Scan<I, St, F> {
    pub(crate) fn new(iter: I, state: St, f: F) -> Scan<I, St, F> {
        Scan { iter: iter, f: f, state: state }
    }
}

impl<B, I: Iterator, St, F: FnMut(&mut St, I::Item) -> Option<B>> Iterator for Scan<I, St, F> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        let x = self.iter.next()?;
        (self.f)(&mut self.state, x)
    }
}

// Iterator::cycle's: again and again.
#[derive(Clone)]
pub struct Cycle<I> {
    orig: I,
    iter: I,
}

impl<I: Clone> Cycle<I> {
    pub(crate) fn new(iter: I) -> Cycle<I> {
        Cycle { orig: iter.clone(), iter: iter }
    }
}

impl<I: Clone + Iterator> Iterator for Cycle<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        match self.iter.next() {
            Option::None => {
                self.iter = self.orig.clone();
                self.iter.next()
            }
            y => y,
        }
    }

    // Empty, or without end (Rust's).
    fn size_hint(&self) -> (usize, Option<usize>) {
        match self.orig.size_hint() {
            (0, Option::Some(0)) => (0, Option::Some(0)),
            (0, _) => (0, Option::None),
            _ => (usize::MAX, Option::None),
        }
    }
}
