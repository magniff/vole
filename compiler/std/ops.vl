// std::ops: the operator traits (0.20: from std.vl).

// ---- Traits (0.9) ----

// The operators: `a + b` on a type implementing Add is `a.add(b)`, and so
// on; `-a` is `a.neg()`; `a == b` is `a.eq(&b)` (an impl wins over the
// structural ==); `a < b` is `a.cmp(&b) < 0`. Numbers implement them all
// without impl blocks, every type with == implements Eq, and numbers,
// pointers and fieldless enums Ord.
pub trait Add { fn add(self, other: Self) -> Self; }
pub trait Sub { fn sub(self, other: Self) -> Self; }
pub trait Mul { fn mul(self, other: Self) -> Self; }
pub trait Div { fn div(self, other: Self) -> Self; }
pub trait Neg { fn neg(self) -> Self; }

// (0.27.0) The rust edition's `*x`, `x.f`, `x.m()` and `c[i]` through
// these (front/check/rust.vl).
pub trait Deref {
    type Target;
    fn deref(self) -> let Self::Target;
}

// (its Target is Deref's)
pub trait DerefMut {
    fn deref_mut(inout self) -> inout Self::Target;
}

pub trait Index<I> {
    type Output;
    fn index(self, i: I) -> let Self::Output;
}

pub trait IndexMut<I> {
    fn index_mut(inout self, i: I) -> inout Self::Output;
}
