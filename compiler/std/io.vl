// std::io: reading stdin (0.20: from flat/io.vl); (0.20, B6) io::Error
// and io::Result, Read, Write, BufReader, BufWriter and the standard
// streams (io/error.vl, io/buffered.vl).

pub mod error;
pub mod buffered;

use std::{Allocator, Buf, IoError, malloc, read};

pub use buffered::{
    BufRead, BufReader, BufWriter, Lines, Read, Stderr, Stdin, Stdout, Write, stderr, stdin, stdout,
    writeln,
};
pub use error::{Error, ErrorKind, Result};

// `read_line` and `read_stdin` share one buffer: they can be mixed, but
// not with C's stdio reading (getchar, scanf, fgets), which has its own.
// The buffer is C memory taken at the first read, not a static array: a
// static [u8; 65536] is 64 KiB of data in every program's object.
static var STDIN_BUF: *u8 = 0 as *u8;
static var STDIN_POS: i64 = 0;
static var STDIN_LEN: i64 = 0;
const STDIN_BLOCK: i64 = 65536;

// Bytes in STDIN_BUF[STDIN_POS..STDIN_LEN], read if there were none: 1;
// 0 at the end of input, -1 when reading failed.
fn stdin_fill() -> i64 {
    if STDIN_POS < STDIN_LEN {
        return 1;
    }
    if STDIN_BUF == 0 as *u8 {
        // UNSAFE: C's allocator. SAFETY: null is checked below.
        STDIN_BUF = unsafe { malloc(STDIN_BLOCK as u64) };
        if STDIN_BUF == 0 as *u8 {
            return -1;
        }
    }
    // UNSAFE: C's read writes through a raw pointer.
    // SAFETY: at most STDIN_BLOCK bytes into STDIN_BUF, which has as many.
    let n = unsafe { read(0, STDIN_BUF, STDIN_BLOCK as u64) };
    STDIN_POS = 0;
    STDIN_LEN = if n > 0 { n } else { 0 };
    if n > 0 { 1 } else if n == 0 { 0 } else { -1 }
}

// The bytes read and not yet taken, STDIN_BUF[STDIN_POS..STDIN_LEN].
fn stdin_left() -> [u8] {
    if STDIN_POS >= STDIN_LEN {
        return ""[..0];
    }
    // UNSAFE: a slice of C memory through a raw pointer.
    // SAFETY: POS < LEN here, so stdin_fill set STDIN_BUF (non-null, of
    // STDIN_BLOCK bytes) and read LEN <= STDIN_BLOCK bytes into it.
    unsafe { STDIN_BUF[STDIN_POS..STDIN_LEN] }
}

// The next line of stdin into `line` (emptied first; 0.16: a Buf on any
// allocator, which it grows), without its '\n'; Ok(false) at the end of
// input.
pub fn read_line<A: Allocator>(line: inout Buf<A>) -> std::Result<bool, IoError> {
    line.clear();
    var any = false;
    loop {
        let filled = stdin_fill();
        if filled < 0 {
            return std::Result::Err(IoError::Read);
        }
        if filled == 0 {
            break;
        }
        any = true;
        let block = stdin_left();
        for i in 0..block.len {
            if block[i] == '\n' {
                line.push_str(block[..i]);
                STDIN_POS += i + 1;
                return std::Result::Ok(true);
            }
        }
        line.push_str(block);
        STDIN_POS = STDIN_LEN;
    }
    std::Result::Ok(any)
}

// All of stdin that is left, in a new Buf on allocator a (the caller
// frees it). It shares a buffer with read_line, not with C's getchar or
// scanf.
pub fn read_stdin_in<A: Allocator>(a: sink A) -> std::Result<Buf<A>, IoError> {
    var b: Buf<A> = Buf::new_in(a);
    if STDIN_POS < STDIN_LEN {
        b.push_str(stdin_left());
        STDIN_POS = STDIN_LEN;
    }
    loop {
        b.bytes.reserve(STDIN_BLOCK);
        let room = b.bytes.cap - b.bytes.len;
        // UNSAFE: C's read writes into the Vec's room through a raw pointer.
        // SAFETY: after reserve, ptr[len..cap] is room (Vec's invariant):
        // read writes at most room bytes there; len counts them after.
        let n = unsafe { read(0, &b.bytes.ptr[b.bytes.len], room as u64) };
        if n == 0 {
            return std::Result::Ok(b);
        }
        if n < 0 {
            b.free();
            return std::Result::Err(IoError::Read);
        }
        b.bytes.len += n;
    }
}

// (0.20) Reads up to buf.len bytes of stdin into buf, what read_line has
// buffered first: how many (0 at the end), -1 when reading failed
// (std::io::Stdin).
pub fn __stdin_read(buf: inout [u8]) -> i64 {
    if STDIN_POS < STDIN_LEN {
        let block = stdin_left();
        let n = if block.len < buf.len { block.len } else { buf.len };
        for i in 0..n {
            buf[i] = block[i];
        }
        STDIN_POS += n;
        return n;
    }
    // UNSAFE: C's read writes through a raw pointer.
    // SAFETY: buf is the caller's inout slice: at most buf.len bytes.
    let n = unsafe { read(0, buf.ptr, buf.len as u64) };
    if n < 0 { -1 } else { n }
}
