// std: new: Rust's integer methods' home (std::num).

// The integers' inherent methods (front-rust.md F15.4): `x.wrapping_add(y)`,
// `x.checked_mul(y)` (an Option), `x.overflowing_sub(y)` (the wrapped
// value and whether it overflowed), `x.saturating_sub(y)`, the bit counts
// and the rotations, for i8 .. usize, with no `use`. The compiler makes
// `impl i8 { .. }` .. `impl usize { .. }` from its list (front/builtin_impls)
// as this module's items, at the attribute below; this module's
// arithmetic never checks overflow, whatever --overflow-checks says
// (front/modules: std_wraps), so `self + rhs` in them is Rust's
// wrapping_add. `/` and `%` by zero panic here too, as Rust's
// wrapping_div does.
pub mod wrapping {
    // The high 64 bits of the 128-bit product a * b (vole has no u128):
    // four 32-bit products, none of which overflows. The overflowing_mul
    // of the 64-bit integers reads it.
    #[builtin_methods(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]
    #[effects()]
    pub fn mul_hi(a: u64, b: u64) -> u64 {
        let m: u64 = 0xffffffff;
        let (a0, a1) = (a & m, a >> 32);
        let (b0, b1) = (b & m, b >> 32);
        let p00 = a0 * b0;
        let p01 = a0 * b1;
        let p10 = a1 * b0;
        let p11 = a1 * b1;
        let mid = (p00 >> 32) + (p01 & m) + (p10 & m);
        p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
    }
}

// (0.28.0) A byte as an ASCII character: Rust's u8 methods, as char's.
impl u8 {
    #[effects()]
    pub fn is_ascii(&self) -> bool {
        *self < 0x80
    }

    #[effects()]
    pub fn is_ascii_alphabetic(&self) -> bool {
        self.is_ascii_uppercase() || self.is_ascii_lowercase()
    }

    #[effects()]
    pub fn is_ascii_uppercase(&self) -> bool {
        *self >= b'A' && *self <= b'Z'
    }

    #[effects()]
    pub fn is_ascii_lowercase(&self) -> bool {
        *self >= b'a' && *self <= b'z'
    }

    #[effects()]
    pub fn is_ascii_digit(&self) -> bool {
        *self >= b'0' && *self <= b'9'
    }

    #[effects()]
    pub fn is_ascii_hexdigit(&self) -> bool {
        self.is_ascii_digit() || (*self >= b'a' && *self <= b'f')
            || (*self >= b'A' && *self <= b'F')
    }

    #[effects()]
    pub fn is_ascii_alphanumeric(&self) -> bool {
        self.is_ascii_alphabetic() || self.is_ascii_digit()
    }

    // A space, tab, line feed, form feed or carriage return (not the
    // vertical tab: Rust's, WhatWG's).
    #[effects()]
    pub fn is_ascii_whitespace(&self) -> bool {
        *self == b' ' || *self == b'\t' || *self == b'\n' || *self == b'\r' || *self == 0x0C
    }

    #[effects()]
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self >= b'!' && *self <= b'/') || (*self >= b':' && *self <= b'@')
            || (*self >= b'[' && *self <= b'`') || (*self >= b'{' && *self <= b'~')
    }

    // A printable character but the space: `!` to `~`.
    #[effects()]
    pub fn is_ascii_graphic(&self) -> bool {
        *self >= b'!' && *self <= b'~'
    }

    #[effects()]
    pub fn is_ascii_control(&self) -> bool {
        *self < 0x20 || *self == 0x7F
    }

    #[effects()]
    pub fn to_ascii_uppercase(&self) -> u8 {
        if self.is_ascii_lowercase() { *self - 32 } else { *self }
    }

    #[effects()]
    pub fn to_ascii_lowercase(&self) -> u8 {
        if self.is_ascii_uppercase() { *self + 32 } else { *self }
    }

    #[effects()]
    pub fn eq_ignore_ascii_case(&self, other: &u8) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }

    #[effects()]
    pub fn make_ascii_uppercase(&mut self) {
        *self = self.to_ascii_uppercase();
    }

    #[effects()]
    pub fn make_ascii_lowercase(&mut self) {
        *self = self.to_ascii_lowercase();
    }
}

impl u64 {
    // self * rhs + carry, in full: its low 64 bits and its high 64 bits
    // (Rust's; the high half of a 64x64 product is `a.carrying_mul(b, 0).1`).
    #[effects()]
    pub fn carrying_mul(self, rhs: u64, carry: u64) -> (u64, u64) {
        let lo = self.wrapping_mul(rhs);
        let sum = lo.wrapping_add(carry);
        let hi = crate::num::wrapping::mul_hi(self, rhs);
        (sum, if sum < lo { hi.wrapping_add(1) } else { hi })
    }
}

// The errors of parsing and converting numbers, at Rust's paths
// (std::num::ParseIntError, IntErrorKind, ParseFloatError,
// TryFromIntError): they are defined beside the code that makes them.
pub use crate::convert::TryFromIntError;
// (Wrapping<T>: with the integers' conversions, std-intconv.py)
pub use crate::intconv::Wrapping;
pub use crate::str::{IntErrorKind, ParseFloatError, ParseIntError};
