// std::str: the methods of str, UTF-8 text, always behind a reference
// (`&str`: MVS's `str` view), its iterators, Pattern, FromStr and
// from_utf8. A String has them all through Deref. What reads returns
// views of the text (`trim`, `split`, `strip_prefix`); what allocates
// takes an allocator, Rust's name with `_in` (`to_uppercase_in(a)`,
// `replace_in(from, to, a)`: plan §2). Indices are byte offsets, usize.
// The text's code points are `char`s (0.27.2: the rust front's char
// type; MVS had none and used u32).

use crate::alloc::Allocator;
use crate::borrow::ToOwnedIn;
use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::convert::AsRef;
use crate::default::Default;
use crate::fmt::{Debug, Display, Formatter};
use crate::hash::{Hash, Hasher};
use crate::iter::{DoubleEndedIterator, Iterator};
use crate::ops::{Index, Range, RangeFrom, RangeFull, RangeInclusive, RangeTo, RangeToInclusive};
use crate::option::Option;
use crate::option::Option::{None, Some};
use crate::result::Result;
use crate::result::Result::{Err, Ok};
use crate::slice::SliceIndex;
use crate::string::String;

// (std::str::lossy_next and ascii_printable_prefix_len, where the old std
// had them: std::unicode's, called from here: std::unicode is read only
// by a program, or a function it reaches, that names `unicode`)

// The code point at v[*pos] (pos is less than v's length), and pos moved
// past it; a broken sequence reads as U+FFFD and is skipped whole.
#[inline]
#[effects(panic)]
pub fn lossy_next(v: &[u8], pos: &mut usize) -> u32 {
    crate::unicode::lossy_next(v, pos)
}

// The length of v's longest prefix of printable ASCII, 0x20 to 0x7E.
#[inline]
#[effects(panic)]
pub fn ascii_printable_prefix_len(v: &[u8]) -> usize {
    crate::unicode::ascii_printable_prefix_len(v)
}

impl str {
    // bytes as a str when they are UTF-8 (Rust 1.87's inherent form;
    // `std::str::from_utf8` too).
    // std: changed: &[u8] to &str
    #[effects(panic, diverge)]
    pub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {
        from_utf8(v)
    }

    #[effects(unsafe)]
    // UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.
    // SAFETY: a contract on the caller: v is UTF-8.
    pub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {
        // UNSAFE: the free function's contract, passed on.
        // SAFETY: the caller's: v is UTF-8.
        unsafe { from_utf8_unchecked(v) }
    }

    // Its length in bytes.
    #[effects()]
    pub fn len(&self) -> usize {
        self.as_bytes().len()
    }

    #[effects()]
    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    #[effects()]
    pub fn as_bytes(&self) -> &[u8] {
        // A &str is a &[u8] that promises UTF-8, the same fat pointer (built
        // in: Rust's core casts the pointer, `&*(self as *const str as
        // *const [u8])`).
        self as &[u8]
    }

    // The same bytes, writable as a str (an ASCII case change in place).
    #[effects()]
    pub fn as_ptr(&self) -> *const u8 {
        self.as_bytes().as_ptr()
    }

    // Whether byte i starts a code point (or is the end).
    #[effects(panic)]
    pub fn is_char_boundary(&self, i: usize) -> bool {
        if i == 0 {
            return true;
        }
        let b = self.as_bytes();
        if i < b.len() {
            // not a continuation byte (10xx_xxxx)
            b[i] & 0xC0 != 0x80
        } else {
            i == b.len()
        }
    }

    // The closest byte index at or below i that starts a code point: i
    // itself when it does, len() when i is past the end (Rust's).
    #[effects(panic)]
    pub fn floor_char_boundary(&self, i: usize) -> usize {
        if i >= self.len() {
            return self.len();
        }
        let mut k = i;
        // (a code point has at most three continuation bytes, and byte 0
        // starts one)
        for _ in 0..3 {
            if self.is_char_boundary(k) {
                break;
            }
            k -= 1;
        }
        k
    }

    // The closest byte index at or above i that starts a code point, or
    // len() (when i is past the end too).
    #[effects(panic)]
    pub fn ceil_char_boundary(&self, i: usize) -> usize {
        if i >= self.len() {
            return self.len();
        }
        let mut k = i;
        for _ in 0..3 {
            if self.is_char_boundary(k) {
                break;
            }
            k += 1;
        }
        k
    }

    #[effects()]
    pub fn is_ascii(&self) -> bool {
        for b in self.as_bytes() {
            if *b >= 0x80 {
                return false;
            }
        }
        true
    }

    // The subslice a byte range names; None when out of bounds or not on
    // char boundaries.
    #[effects(I)]
    pub fn get<I: SliceIndex<str>>(&self, i: I) -> Option<&I::Output> {
        i.get(self)
    }

    // [0, mid) and [mid, len); panics when mid is not a char boundary.
    #[effects(panic)]
    pub fn split_at(&self, mid: usize) -> (&str, &str) {
        (&self[..mid], &self[mid..])
    }

    // Its code points.
    // std: changed: yields char (MVS: u32)
    #[effects()]
    pub fn chars(&self) -> Chars<'_> {
        Chars { rest: self }
    }

    // Its code points with their byte offsets.
    // std: changed: yields (usize, char) (MVS: (i64, u32))
    #[effects()]
    pub fn char_indices(&self) -> CharIndices<'_> {
        CharIndices { front: 0, chars: self.chars() }
    }

    // Its bytes.
    // std: changed: a Bytes<'_> of u8 (MVS: a SliceIter<u8>)
    #[effects()]
    pub fn bytes(&self) -> Bytes<'_> {
        Bytes { inner: self.as_bytes().iter() }
    }

    // Its lines, without their "\n" or "\r\n"; a last empty line is not one.
    #[effects()]
    pub fn lines(&self) -> Lines<'_> {
        Lines { rest: self }
    }

    // The pieces between the matches of p.
    #[effects(P)]
    pub fn split<P: Pattern>(&self, p: P) -> Split<'_, P> {
        Split::new(self, p, true)
    }

    // The same, from the end.
    #[effects(P)]
    pub fn rsplit<P: Pattern>(&self, p: P) -> RSplit<'_, P> {
        RSplit { inner: Split::new(self, p, true) }
    }

    // At most n pieces: the last holds the rest.
    // std: changed: n is usize
    #[effects(P)]
    pub fn splitn<P: Pattern>(&self, n: usize, p: P) -> SplitN<'_, P> {
        SplitN { inner: Split::new(self, p, true), count: n }
    }

    #[effects(P)]
    pub fn rsplitn<P: Pattern>(&self, n: usize, p: P) -> RSplitN<'_, P> {
        RSplitN { inner: Split::new(self, p, true), count: n }
    }

    // split, without an empty last piece ("a,b," gives "a" and "b").
    #[effects(P)]
    pub fn split_terminator<P: Pattern>(&self, p: P) -> SplitTerminator<'_, P> {
        SplitTerminator { inner: Split::new(self, p, false) }
    }

    // split, each piece with the match that ends it.
    #[effects(P)]
    pub fn split_inclusive<P: Pattern>(&self, p: P) -> SplitInclusive<'_, P> {
        SplitInclusive { inner: Split::new(self, p, false) }
    }

    // The pieces between runs of Unicode white space.
    #[effects()]
    pub fn split_whitespace(&self) -> SplitWhitespace<'_> {
        SplitWhitespace { rest: self }
    }

    // The pieces between runs of ASCII white space.
    #[effects()]
    pub fn split_ascii_whitespace(&self) -> SplitAsciiWhitespace<'_> {
        SplitAsciiWhitespace { rest: self }
    }

    // Before and after the first match of p.
    #[effects(panic, diverge, P)]
    pub fn split_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {
        let mut p = p;
        match p.next_match(self, 0) {
            Some((a, b)) => Some((&self[..a], &self[b..])),
            None => None,
        }
    }

    // Before and after the last match of p.
    #[effects(panic, P)]
    pub fn rsplit_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {
        let mut p = p;
        match p.next_match_back(self, self.len()) {
            Some((a, b)) => Some((&self[..a], &self[b..])),
            None => None,
        }
    }

    // The matches of p.
    #[effects()]
    pub fn matches<P: Pattern>(&self, p: P) -> Matches<'_, P> {
        Matches { hay: self, at: 0, pat: p }
    }

    // The matches of p with their byte offsets.
    #[effects()]
    pub fn match_indices<P: Pattern>(&self, p: P) -> MatchIndices<'_, P> {
        MatchIndices { hay: self, at: 0, pat: p }
    }

    // The byte offset of the first match of p.
    #[effects(panic, diverge, P)]
    pub fn find<P: Pattern>(&self, p: P) -> Option<usize> {
        let mut p = p;
        match p.next_match(self, 0) {
            Some((a, _)) => Some(a),
            None => None,
        }
    }

    // The byte offset of the last match of p.
    #[effects(panic, diverge, P)]
    pub fn rfind<P: Pattern>(&self, p: P) -> Option<usize> {
        let mut p = p;
        match p.next_match_back(self, self.len()) {
            Some((a, _)) => Some(a),
            None => None,
        }
    }

    #[effects(P)]
    pub fn contains<P: Pattern>(&self, p: P) -> bool {
        self.find(p).is_some()
    }

    #[effects(panic, diverge, P)]
    pub fn starts_with<P: Pattern>(&self, p: P) -> bool {
        let mut p = p;
        match p.next_match(self, 0) {
            Some((a, _)) => a == 0,
            None => false,
        }
    }

    #[effects(panic, diverge, P)]
    pub fn ends_with<P: Pattern>(&self, p: P) -> bool {
        let mut p = p;
        match p.next_match_back(self, self.len()) {
            Some((_, b)) => b == self.len(),
            None => false,
        }
    }

    // The rest after p, when it starts with p.
    #[effects(panic, diverge, P)]
    pub fn strip_prefix<P: Pattern>(&self, p: P) -> Option<&str> {
        let mut p = p;
        match p.next_match(self, 0) {
            Some((0, b)) => Some(&self[b..]),
            _ => None,
        }
    }

    #[effects(panic, diverge, P)]
    pub fn strip_suffix<P: Pattern>(&self, p: P) -> Option<&str> {
        let mut p = p;
        match p.next_match_back(self, self.len()) {
            Some((a, b)) if b == self.len() => Some(&self[..a]),
            _ => None,
        }
    }

    // Without leading and trailing Unicode white space.
    #[effects(panic, diverge)]
    pub fn trim(&self) -> &str {
        self.trim_start().trim_end()
    }

    #[effects(panic, diverge)]
    pub fn trim_start(&self) -> &str {
        let mut it = self.char_indices();
        loop {
            match it.next() {
                Some((i, c)) => {
                    if !c.is_whitespace() {
                        return &self[i..];
                    }
                }
                None => return "",
            }
        }
    }

    #[effects(panic, diverge)]
    pub fn trim_end(&self) -> &str {
        let mut it = self.char_indices();
        loop {
            match it.next_back() {
                Some((i, c)) => {
                    if !c.is_whitespace() {
                        return &self[..i + c.len_utf8()];
                    }
                }
                None => return "",
            }
        }
    }

    // Without leading and trailing ASCII white space.
    #[effects(panic, diverge)]
    pub fn trim_ascii(&self) -> &str {
        let b = self.as_bytes();
        let mut i: usize = 0;
        let mut j: usize = b.len();
        while i < j && is_ascii_space(b[i]) {
            i += 1;
        }
        while j > i && is_ascii_space(b[j - 1]) {
            j -= 1;
        }
        &self[i..j]
    }

    // Without the leading and trailing matches of p.
    #[effects(panic, diverge, P)]
    pub fn trim_matches<P: Pattern>(&self, p: P) -> &str {
        let mut p = p;
        let mut i: usize = 0;
        let mut j: usize = self.len();
        loop {
            match p.next_match(self, i) {
                Some((a, b)) if a == i && b > a => i = b,
                _ => break,
            }
        }
        loop {
            match p.next_match_back(self, j) {
                Some((a, b)) if b == j && a < b && a >= i => j = a,
                _ => break,
            }
        }
        &self[i..j]
    }

    #[effects(panic, diverge, P)]
    pub fn trim_start_matches<P: Pattern>(&self, p: P) -> &str {
        let mut p = p;
        let mut i: usize = 0;
        loop {
            match p.next_match(self, i) {
                Some((a, b)) if a == i && b > a => i = b,
                _ => break,
            }
        }
        &self[i..]
    }

    #[effects(panic, diverge, P)]
    pub fn trim_end_matches<P: Pattern>(&self, p: P) -> &str {
        let mut p = p;
        let mut j: usize = self.len();
        loop {
            match p.next_match_back(self, j) {
                Some((a, b)) if b == j && a < b => j = a,
                _ => break,
            }
        }
        &self[..j]
    }

    #[effects(panic)]
    pub fn eq_ignore_ascii_case(&self, other: &str) -> bool {
        let a = self.as_bytes();
        let b = other.as_bytes();
        if a.len() != b.len() {
            return false;
        }
        let mut i: usize = 0;
        while i < a.len() {
            if ascii_lower(a[i]) != ascii_lower(b[i]) {
                return false;
            }
            i += 1;
        }
        true
    }

    // Its ASCII letters made lower case, in place.
    #[effects(panic, diverge, unsafe)]
    pub fn make_ascii_lowercase(&mut self) {
        // UNSAFE: the bytes of a &mut str, written.
        // SAFETY: an ASCII case change maps ASCII bytes to ASCII bytes and leaves
        // the others, so the text stays UTF-8.
        let b = unsafe { bytes_mut(self) };
        let mut i: usize = 0;
        while i < b.len() {
            b[i] = ascii_lower(b[i]);
            i += 1;
        }
    }

    #[effects(panic, diverge, unsafe)]
    pub fn make_ascii_uppercase(&mut self) {
        // UNSAFE: the bytes of a &mut str, written.
        // SAFETY: an ASCII case change maps ASCII bytes to ASCII bytes and leaves
        // the others, so the text stays UTF-8.
        let b = unsafe { bytes_mut(self) };
        let mut i: usize = 0;
        while i < b.len() {
            b[i] = ascii_upper(b[i]);
            i += 1;
        }
    }

    // The text as a T (`"42".parse::<i64>()`): numbers, bool, char.
    #[effects(F)]
    pub fn parse<F: FromStr>(&self) -> Result<F, F::Err> {
        F::from_str(self)
    }

    // Its width in terminal columns (East Asian wide as 2, combining as 0):
    // vole's, kept from MVS.
    // std: changed: usize
    #[effects(panic, diverge)]
    pub fn width(&self) -> usize {
        let mut n: usize = 0;
        let mut it = self.graphemes(true);
        while let Some(g) = it.next() {
            n += cluster_width(g, false);
        }
        n
    }

    // width, with East Asian ambiguous characters as 2.
    // std: changed: usize
    #[effects(panic, diverge)]
    pub fn width_cjk(&self) -> usize {
        let mut n: usize = 0;
        let mut it = self.graphemes(true);
        while let Some(g) = it.next() {
            n += cluster_width(g, true);
        }
        n
    }

    // Its grapheme clusters (UAX #29; extended or legacy): vole's.
    #[effects()]
    pub fn graphemes(&self, extended: bool) -> Graphemes<'_> {
        Graphemes { rest: self, extended: extended }
    }

    // A String of it, on a.
    #[effects(A)]
    pub fn to_string_in<A: Allocator>(&self, a: A) -> String<A> {
        String::from_in(self, a)
    }

    #[effects(A)]
    pub fn to_owned_in<A: Allocator>(&self, a: A) -> String<A> {
        String::from_in(self, a)
    }

    #[effects(panic, diverge, A)]
    pub fn to_lowercase_in<A: Allocator>(&self, a: A) -> String<A> {
        // Each char maps alone, but a capital sigma at a word's end, which
        // is final sigma, as Rust's (Unicode's Final_Sigma context).
        let mut s = String::with_capacity_in(self.len(), a);
        let mut it = self.char_indices();
        while let Some((i, c)) = it.next() {
            if c == '\u{3A3}' {
                let fin = cased_before(&self[..i]) && !cased_after(&self[i + 2..]);
                s.push(if fin { '\u{3C2}' } else { '\u{3C3}' });
                continue;
            }
            let mut m = c.to_lowercase();
            while let Some(l) = m.next() {
                s.push(l);
            }
        }
        s
    }

    #[effects(panic, diverge, A)]
    pub fn to_uppercase_in<A: Allocator>(&self, a: A) -> String<A> {
        let mut s = String::with_capacity_in(self.len(), a);
        let mut it = self.chars();
        while let Some(c) = it.next() {
            let mut m = c.to_uppercase();
            while let Some(u) = m.next() {
                s.push(u);
            }
        }
        s
    }

    #[effects(panic, diverge, A)]
    pub fn to_ascii_lowercase_in<A: Allocator>(&self, a: A) -> String<A> {
        let mut s = String::from_in(self, a);
        s.as_mut_str().make_ascii_lowercase();
        s
    }

    #[effects(panic, diverge, A)]
    pub fn to_ascii_uppercase_in<A: Allocator>(&self, a: A) -> String<A> {
        let mut s = String::from_in(self, a);
        s.as_mut_str().make_ascii_uppercase();
        s
    }

    // A copy with every match of from replaced by to.
    #[effects(panic, diverge, P, A)]
    pub fn replace_in<P: Pattern, A: Allocator>(&self, from: P, to: &str, a: A) -> String<A> {
        let mut result = String::new_in(a);
        let mut last: usize = 0;
        let mut it = self.match_indices(from);
        while let Some((start, part)) = it.next() {
            result.push_str(&self[last..start]);
            result.push_str(to);
            last = start + part.len();
        }
        result.push_str(&self[last..]);
        result
    }

    // The same, the first n matches.
    // std: changed: n is usize
    #[effects(panic, diverge, P, A)]
    pub fn replacen_in<P: Pattern,
        A: Allocator>(&self, from: P, to: &str, n: usize, a: A) -> String<A> {
        let mut result = String::with_capacity_in(32, a);
        let mut last: usize = 0;
        let mut left = n;
        let mut it = self.match_indices(from);
        while let Some((start, part)) = it.next() {
            if left == 0 {
                break;
            }
            left -= 1;
            result.push_str(&self[last..start]);
            result.push_str(to);
            last = start + part.len();
        }
        result.push_str(&self[last..]);
        result
    }

    // n copies end to end.
    #[effects(A)]
    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> String<A> {
        let mut s = String::with_capacity_in(self.len() * n, a);
        let mut i: usize = 0;
        while i < n {
            s.push_str(self);
            i += 1;
        }
        s
    }
}

// v as a str when it is UTF-8.
// mvs: validate_utf8
// std: changed: returns the &str
#[effects(panic, diverge, unsafe)]
pub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {
    let n = v.len();
    // (the ASCII start of v a block at a time: text that is all ASCII is
    // checked three times faster; after the first byte that is not, byte
    // by byte: trying blocks again inside the loop cost mixed text a
    // quarter of its speed)
    let mut i: usize = ascii_blocks(v, 0);
    while i < n {
        let b = v[i];
        if b < 0x80 {
            i += 1;
            continue;
        }
        // the sequence's length, and the range its second byte must be in
        // (no overlong forms, no surrogates, nothing over U+10FFFF)
        let (w, lo, hi): (usize, u8, u8) = if b >= 0xC2 && b <= 0xDF {
            (2, 0x80, 0xBF)
        } else if b == 0xE0 {
            (3, 0xA0, 0xBF)
        } else if b == 0xED {
            (3, 0x80, 0x9F)
        } else if b >= 0xE1 && b <= 0xEF {
            (3, 0x80, 0xBF)
        } else if b == 0xF0 {
            (4, 0x90, 0xBF)
        } else if b >= 0xF1 && b <= 0xF3 {
            (4, 0x80, 0xBF)
        } else if b == 0xF4 {
            (4, 0x80, 0x8F)
        } else {
            return Err(Utf8Error { valid_up_to: i, error_len: Some(1) });
        };
        let mut k: usize = 1;
        while k < w {
            if i + k >= n {
                return Err(Utf8Error { valid_up_to: i, error_len: None });
            }
            let c = v[i + k];
            let ok = if k == 1 { c >= lo && c <= hi } else { c & 0xC0 == 0x80 };
            if !ok {
                return Err(Utf8Error { valid_up_to: i, error_len: Some(k as u8) });
            }
            k += 1;
        }
        i += w;
    }
    // UNSAFE: the checked bytes as a str.
    // SAFETY: every sequence of v was checked to be UTF-8 above.
    Ok(unsafe { from_utf8_unchecked(v) })
}

// Where the blocks of sixteen ASCII bytes of v from `from` on end: the
// index after the last block none of whose bytes has its high bit
// (from_utf8's fast path).
fn ascii_blocks(v: &[u8], from: usize) -> usize {
    let n = v.len();
    let mut i = from;
    while i + 16 <= n {
        let c = &v[i..i + 16];
        let m = c[0] | c[1] | c[2] | c[3] | c[4] | c[5] | c[6] | c[7] | c[8] | c[9] | c[10] | c[11]
            | c[12] | c[13] | c[14] | c[15];
        if m >= 0x80 {
            break;
        }
        i += 16;
    }
    i
}

#[effects(unsafe)]
// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.
// SAFETY: a contract on the caller: v is UTF-8.
pub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {
    // A &[u8] that is UTF-8 is a &str: the same fat pointer (built in).
    // UNSAFE: a pointer cast between [u8] and str, which Rust's core makes too.
    // SAFETY: str and [u8] have the same layout; the caller promises UTF-8.
    unsafe { &*(v as *const [u8] as *const str) }
}

// Why bytes are not UTF-8.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub struct Utf8Error {
    valid_up_to: usize,
    error_len: Option<u8>,
}

impl Utf8Error {
    // The length of the valid prefix.
    // std: changed: usize
    #[effects()]
    pub fn valid_up_to(&self) -> usize {
        self.valid_up_to
    }

    // The length of the bad sequence; None when the input ends inside one.
    // std: changed: Option<usize>
    #[effects()]
    pub fn error_len(&self) -> Option<usize> {
        self.error_len.map(|n| n as usize)
    }
}

impl Display for Utf8Error {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        match self.error_len {
            Some(n) => {
                if let Err(e) = f.write_str("invalid utf-8 sequence of ") {
                    return Err(e);
                }
                if let Err(e) = f.write_fmt(n) {
                    return Err(e);
                }
                if let Err(e) = f.write_str(" bytes from index ") {
                    return Err(e);
                }
                f.write_fmt(self.valid_up_to)
            }
            None => {
                if let Err(e) = f.write_str("incomplete utf-8 byte sequence from index ") {
                    return Err(e);
                }
                f.write_fmt(self.valid_up_to)
            }
        }
    }
}

// What can be parsed from text: `s.parse::<T>()`, `T::from_str(s)`.
#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]
pub trait FromStr: Sized {
    type Err;

    fn from_str(s: &str) -> Result<Self, Self::Err>;
}

// Why an integer did not parse.
// mvs: ParseIntError
// std: changed: a struct with kind() (MVS: an enum)
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct ParseIntError {
    kind: IntErrorKind,
}

// What was wrong with an integer's text.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum IntErrorKind {
    Empty,
    InvalidDigit,
    PosOverflow,
    NegOverflow,
    // (Rust's, for its NonZero types: no integer here parses to it)
    Zero,
}

impl ParseIntError {
    #[effects()]
    pub fn kind(&self) -> &IntErrorKind {
        &self.kind
    }
}

// (for std's from_str_radix, compiler/std/intconv.vl)
#[effects()]
pub(crate) fn int_error(kind: IntErrorKind) -> ParseIntError {
    ParseIntError { kind: kind }
}

// Rust's texts.
impl Display for ParseIntError {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str(match self.kind {
            IntErrorKind::Empty => "cannot parse integer from empty string",
            IntErrorKind::InvalidDigit => "invalid digit found in string",
            IntErrorKind::PosOverflow => "number too large to fit in target type",
            IntErrorKind::NegOverflow => "number too small to fit in target type",
            IntErrorKind::Zero => "number would be zero for non-zero type",
        })
    }
}

// Why a float did not parse.
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct ParseFloatError {
    empty: bool,
}

impl Display for ParseFloatError {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str(if self.empty { "cannot parse float from empty string" }
            else { "invalid float literal" })
    }
}

// Why a bool did not parse (only "true" and "false" do).
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct ParseBoolError;

impl Display for ParseBoolError {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("provided string was not `true` or `false`")
    }
}

// What a str method searches for: a char, a &str, a &String, a &[char]
// (any of them) or a closure on a char. Sealed: std's impls only; its
// methods are std's own shape (Rust's Pattern is unstable).
// std: changed: char, &str, &[char], FnMut(char) (MVS: str, u8, u32)
pub trait Pattern: Sized {
    // The byte range of the first match in hay at or after start.
    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)>;
    // The byte range of the last match in hay before end.
    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)>;
}

impl Pattern for char {
    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {
        let mut buf = [0u8; 4];
        let mut s: &str = self.encode_utf8(&mut buf);
        s.next_match(hay, start)
    }

    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {
        let mut buf = [0u8; 4];
        let mut s: &str = self.encode_utf8(&mut buf);
        s.next_match_back(hay, end)
    }
}

// mvs: str::impl Pattern
impl<'b> Pattern for &'b str {
    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {
        let h = hay.as_bytes();
        let n = self.len();
        if start > h.len() || n > h.len() {
            return None;
        }
        if n == 0 {
            // the empty pattern matches at every char boundary
            let mut i = start;
            while !hay.is_char_boundary(i) {
                i += 1;
            }
            return Some((i, i));
        }
        let needle = self.as_bytes();
        let mut i = start;
        while i + n <= h.len() {
            if h[i] == needle[0] && &h[i..i + n] == needle {
                return Some((i, i + n));
            }
            i += 1;
        }
        None
    }

    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {
        let h = hay.as_bytes();
        let n = self.len();
        if end > h.len() || n > end {
            return None;
        }
        if n == 0 {
            let mut i = end;
            while !hay.is_char_boundary(i) {
                i -= 1;
            }
            return Some((i, i));
        }
        let needle = self.as_bytes();
        let mut i = end - n + 1;
        while i > 0 {
            i -= 1;
            if h[i] == needle[0] && &h[i..i + n] == needle {
                return Some((i, i + n));
            }
        }
        None
    }
}

impl<'b, A: Allocator> Pattern for &'b String<A> {
    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {
        self.as_str().next_match(hay, start)
    }

    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {
        self.as_str().next_match_back(hay, end)
    }
}

impl<'b> Pattern for &'b [char] {
    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {
        if start > hay.len() {
            return None;
        }
        let mut it = hay[start..].char_indices();
        loop {
            match it.next() {
                Some((i, c)) => {
                    if self.contains(&c) {
                        return Some((start + i, start + i + c.len_utf8()));
                    }
                }
                None => return None,
            }
        }
    }

    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {
        if end > hay.len() {
            return None;
        }
        let mut it = hay[..end].char_indices();
        loop {
            match it.next_back() {
                Some((i, c)) => {
                    if self.contains(&c) {
                        return Some((i, i + c.len_utf8()));
                    }
                }
                None => return None,
            }
        }
    }
}

// later: blanket_impl
impl<F: FnMut(char) -> bool> Pattern for F {
    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {
        if start > hay.len() {
            return None;
        }
        let mut it = hay[start..].char_indices();
        loop {
            match it.next() {
                Some((i, c)) => {
                    if (self)(c) {
                        return Some((start + i, start + i + c.len_utf8()));
                    }
                }
                None => return None,
            }
        }
    }

    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {
        if end > hay.len() {
            return None;
        }
        let mut it = hay[..end].char_indices();
        loop {
            match it.next_back() {
                Some((i, c)) => {
                    if (self)(c) {
                        return Some((i, i + c.len_utf8()));
                    }
                }
                None => return None,
            }
        }
    }
}

// `&s[a..b]` and `s.get(a..b)`: byte ranges on char boundaries.
impl SliceIndex<str> for Range<usize> {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        if self.start <= self.end && s.is_char_boundary(self.start)
            && s.is_char_boundary(self.end) {
            // UNSAFE: a subslice of UTF-8 bytes, as a str.
            // SAFETY: both ends are char boundaries, so the bytes are UTF-8.
            Some(unsafe { from_utf8_unchecked(&s.as_bytes()[self.start..self.end]) })
        } else {
            None
        }
    }

    fn get_mut(self, s: &mut str) -> Option<&mut str> {
        if self.start <= self.end && s.is_char_boundary(self.start)
            && s.is_char_boundary(self.end) {
            // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.
            // SAFETY: both ends are char boundaries, so the bytes are UTF-8, and
            // the result keeps them so (str's methods write only UTF-8).
            unsafe {
                let b = bytes_mut(s);
                Some(str_mut(&mut b[self.start..self.end]))
            }
        } else {
            None
        }
    }

    fn index(self, s: &str) -> &str {
        let (a, b) = (self.start, self.end);
        match self.get(s) {
            Some(r) => r,
            None => slice_error_fail(s, a, b),
        }
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        let (a, b) = (self.start, self.end);
        if !(a <= b && s.is_char_boundary(a) && s.is_char_boundary(b)) {
            slice_error_fail(s, a, b);
        }
        // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.
        // SAFETY: both ends were checked to be char boundaries above.
        unsafe {
            let bytes = bytes_mut(s);
            str_mut(&mut bytes[a..b])
        }
    }
}

impl SliceIndex<str> for RangeInclusive<usize> {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        // end < len, so end + 1 cannot overflow
        if *self.end() >= s.len() {
            None
        } else {
            (*self.start()..*self.end() + 1).get(s)
        }
    }

    fn get_mut(self, s: &mut str) -> Option<&mut str> {
        if *self.end() >= s.len() {
            None
        } else {
            (*self.start()..*self.end() + 1).get_mut(s)
        }
    }

    fn index(self, s: &str) -> &str {
        if *self.end() >= s.len() {
            slice_error_fail(s, *self.start(), *self.end() + 1)
        } else {
            (*self.start()..*self.end() + 1).index(s)
        }
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        if *self.end() >= s.len() {
            slice_error_fail(s, *self.start(), *self.end() + 1)
        } else {
            (*self.start()..*self.end() + 1).index_mut(s)
        }
    }
}

impl SliceIndex<str> for RangeFrom<usize> {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        (self.start..s.len()).get(s)
    }

    fn get_mut(self, s: &mut str) -> Option<&mut str> {
        let n = s.len();
        (self.start..n).get_mut(s)
    }

    fn index(self, s: &str) -> &str {
        (self.start..s.len()).index(s)
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        let n = s.len();
        (self.start..n).index_mut(s)
    }
}

impl SliceIndex<str> for RangeTo<usize> {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        (0..self.end).get(s)
    }

    fn get_mut(self, s: &mut str) -> Option<&mut str> {
        (0..self.end).get_mut(s)
    }

    fn index(self, s: &str) -> &str {
        (0..self.end).index(s)
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        (0..self.end).index_mut(s)
    }
}

impl SliceIndex<str> for RangeToInclusive<usize> {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        (0..=self.end).get(s)
    }

    fn get_mut(self, s: &mut str) -> Option<&mut str> {
        (0..=self.end).get_mut(s)
    }

    fn index(self, s: &str) -> &str {
        (0..=self.end).index(s)
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        (0..=self.end).index_mut(s)
    }
}

impl SliceIndex<str> for RangeFull {
    type Output = str;

    fn get(self, s: &str) -> Option<&str> {
        Option::Some(s)
    }

    fn get_mut(self, s: &mut str) -> Option<&mut str> {
        Option::Some(s)
    }

    fn index(self, s: &str) -> &str {
        s
    }

    fn index_mut(self, s: &mut str) -> &mut str {
        s
    }
}

impl<I: SliceIndex<str>> Index<I> for str {
    type Output = I::Output;

    fn index(&self, index: I) -> &I::Output {
        index.index(self)
    }
}

// Byte for byte.
impl PartialEq for str {
    fn eq(&self, other: &str) -> bool {
        self.as_bytes() == other.as_bytes()
    }
}

impl Eq for str {}

// By bytes, which is by code points.
impl PartialOrd for str {
    fn partial_cmp(&self, other: &str) -> Option<Ordering> {
        Option::Some(self.cmp(other))
    }
}

impl Ord for str {
    fn cmp(&self, other: &str) -> Ordering {
        self.as_bytes().cmp(other.as_bytes())
    }
}

// Its bytes and a 0xff, as Rust's (so ("ab", "c") and ("a", "bc") differ).
impl Hash for str {
    fn hash<H: Hasher>(&self, state: &mut H) {
        state.write(self.as_bytes());
        state.write_u8(0xff);
    }
}

impl Display for str {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.pad(self)
    }
}

// Quoted, with escapes: "a\"b".
impl Debug for str {
    // terminates: one pass for each char of self (CharIndices ends).
    #[terminates]
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("\"")?;
        let mut from: usize = 0;
        let mut it = self.char_indices();
        loop {
            match it.next() {
                Some((i, c)) => {
                    let esc = match c {
                        '"' => "\\\"",
                        '\\' => "\\\\",
                        '\n' => "\\n",
                        '\r' => "\\r",
                        '\t' => "\\t",
                        '\0' => "\\0",
                        _ => "",
                    };
                    // controls, white space but ' ' and (as Rust's) grapheme extenders
                    // are escaped
                    let control = c.is_control() || is_extend(c)
                        || (c.is_whitespace() && c != ' ');
                    if esc.len() > 0 || control {
                        f.write_str(&self[from..i])?;
                        if esc.len() > 0 {
                            f.write_str(esc)?;
                        } else {
                            write_unicode_escape(f, c as u32)?;
                        }
                        from = i + c.len_utf8();
                    }
                }
                None => break,
            }
        }
        f.write_str(&self[from..])?;
        f.write_str("\"")
    }
}

// `s.to_owned_in(a)`: a String<A>.
impl<A: Allocator> ToOwnedIn<A> for str {
    type Owned = String<A>;

    fn to_owned_in(&self, a: A) -> String<A> {
        String::from_in(self, a)
    }
}

impl AsRef<str> for str {
    fn as_ref(&self) -> &str {
        self
    }
}

impl AsRef<[u8]> for str {
    fn as_ref(&self) -> &[u8] {
        self.as_bytes()
    }
}

// later: impl_for_ref
impl<'a> Default for &'a str {
    fn default() -> &'a str {
        ""
    }
}

// ---- The iterators ----

// str::chars's iterator; `.rev()` from the end.
// mvs: Chars, RevChars, CodePoints
#[derive(Clone)]
pub struct Chars<'a> {
    rest: &'a str,
}

impl<'a> Chars<'a> {
    // What is left.
    #[effects()]
    pub fn as_str(&self) -> &'a str {
        self.rest
    }
}

impl<'a> Iterator for Chars<'a> {
    type Item = char;

    fn next(&mut self) -> Option<char> {
        if self.rest.is_empty() {
            return None;
        }
        let (c, n) = decode_first(self.rest.as_bytes());
        self.rest = &self.rest[n..];
        Some(c)
    }

    // (the chars left are the bytes that start one: every byte but the
    // continuation bytes, 0b10xxxxxx; nothing is decoded)
    fn count(self) -> usize {
        let b = self.rest.as_bytes();
        let mut n: usize = 0;
        for x in b.iter() {
            n += ((*x & 0xC0) != 0x80) as usize;
        }
        n
    }
}

impl<'a> DoubleEndedIterator for Chars<'a> {
    fn next_back(&mut self) -> Option<char> {
        if self.rest.is_empty() {
            return None;
        }
        let (c, n) = decode_last(self.rest.as_bytes());
        self.rest = &self.rest[..self.rest.len() - n];
        Some(c)
    }
}

// str::char_indices's iterator.
#[derive(Clone)]
pub struct CharIndices<'a> {
    front: usize,
    chars: Chars<'a>,
}

impl<'a> CharIndices<'a> {
    // The byte offset of the next char (the length at the end).
    #[effects()]
    pub fn offset(&self) -> usize {
        self.front
    }
}

impl<'a> Iterator for CharIndices<'a> {
    type Item = (usize, char);

    fn next(&mut self) -> Option<(usize, char)> {
        let before = self.chars.rest.len();
        match self.chars.next() {
            Some(c) => {
                let i = self.front;
                self.front += before - self.chars.rest.len();
                Some((i, c))
            }
            None => None,
        }
    }
}

impl<'a> DoubleEndedIterator for CharIndices<'a> {
    fn next_back(&mut self) -> Option<(usize, char)> {
        match self.chars.next_back() {
            Some(c) => Some((self.front + self.chars.rest.len(), c)),
            None => None,
        }
    }
}

// str::bytes's iterator.
#[derive(Clone)]
pub struct Bytes<'a> {
    inner: crate::slice::Iter<'a, u8>,
}

impl<'a> Iterator for Bytes<'a> {
    type Item = u8;

    fn next(&mut self) -> Option<u8> {
        self.inner.next().copied()
    }
}

impl<'a> DoubleEndedIterator for Bytes<'a> {
    fn next_back(&mut self) -> Option<u8> {
        self.inner.next_back().copied()
    }
}

// str::lines's iterator.
#[derive(Clone)]
pub struct Lines<'a> {
    rest: &'a str,
}

impl<'a> Iterator for Lines<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.rest.is_empty() {
            return None;
        }
        let s = self.rest;
        let line = match find_byte(s.as_bytes(), 0x0A) {
            Some(i) => {
                self.rest = &s[i + 1..];
                &s[..i]
            }
            None => {
                self.rest = "";
                s
            }
        };
        Some(strip_cr(line))
    }
}

impl<'a> DoubleEndedIterator for Lines<'a> {
    fn next_back(&mut self) -> Option<&'a str> {
        if self.rest.is_empty() {
            return None;
        }
        let s = self.rest;
        // the last line's own "\n" is not a line break before an empty line
        let b = s.as_bytes();
        let cut = if b[b.len() - 1] == 0x0A { s.len() - 1 } else { s.len() };
        let body: &str = &s[..cut];
        let line = match rfind_byte(body.as_bytes(), 0x0A) {
            Some(i) => {
                self.rest = &s[..i + 1];
                &body[i + 1..]
            }
            None => {
                self.rest = "";
                body
            }
        };
        Some(strip_cr(line))
    }
}

// str::split's iterator: the pieces of hay[start..end] between the
// matches; front and back are where the next search from either end
// starts (None: no more matches that way).
pub struct Split<'a, P> {
    hay: &'a str,
    start: usize,
    end: usize,
    front: Option<usize>,
    back: Option<usize>,
    pat: P,
    trailing: bool,
    done: bool,
}

impl<'a, P: Pattern> Split<'a, P> {
    fn new(hay: &'a str, pat: P, trailing: bool) -> Split<'a, P> {
        Split {
            hay: hay,
            start: 0,
            end: hay.len(),
            front: Some(0),
            back: Some(hay.len()),
            pat: pat,
            trailing: trailing,
            done: false,
        }
    }

    // The last piece, once (none when it is empty and trailing is false).
    fn get_end(&mut self) -> Option<&'a str> {
        if self.done {
            return None;
        }
        self.done = true;
        if self.trailing || self.end > self.start {
            Some(&self.hay[self.start..self.end])
        } else {
            None
        }
    }
}

impl<'a, P: Pattern> Iterator for Split<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.done {
            return None;
        }
        let m = match self.front {
            Some(at) => self.pat.next_match(self.hay, at),
            None => None,
        };
        match m {
            Some((a, b)) if b <= self.end => {
                let piece = &self.hay[self.start..a];
                self.start = b;
                self.front = after_match(self.hay, a, b);
                Some(piece)
            }
            _ => self.get_end(),
        }
    }
}

impl<'a, P: Pattern> DoubleEndedIterator for Split<'a, P> {
    fn next_back(&mut self) -> Option<&'a str> {
        if self.done {
            return None;
        }
        if !self.trailing {
            // split_terminator: an empty last piece is not one
            self.trailing = true;
            match self.next_back() {
                Some(piece) if !piece.is_empty() => return Some(piece),
                _ => {
                    if self.done {
                        return None;
                    }
                }
            }
        }
        let m = match self.back {
            Some(at) => self.pat.next_match_back(self.hay, at),
            None => None,
        };
        match m {
            Some((a, b)) if a >= self.start => {
                let piece = &self.hay[b..self.end];
                self.end = a;
                self.back = before_match(self.hay, a, b);
                Some(piece)
            }
            _ => {
                self.done = true;
                Some(&self.hay[self.start..self.end])
            }
        }
    }
}

// str::rsplit's iterator.
pub struct RSplit<'a, P> {
    inner: Split<'a, P>,
}

impl<'a, P: Pattern> Iterator for RSplit<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        self.inner.next_back()
    }
}

// str::splitn's iterator.
pub struct SplitN<'a, P> {
    inner: Split<'a, P>,
    count: usize,
}

impl<'a, P: Pattern> Iterator for SplitN<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        match self.count {
            0 => None,
            1 => {
                self.count = 0;
                self.inner.get_end()
            }
            _ => {
                self.count -= 1;
                self.inner.next()
            }
        }
    }
}

// str::rsplitn's iterator.
pub struct RSplitN<'a, P> {
    inner: Split<'a, P>,
    count: usize,
}

impl<'a, P: Pattern> Iterator for RSplitN<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        match self.count {
            0 => None,
            1 => {
                self.count = 0;
                self.inner.get_end()
            }
            _ => {
                self.count -= 1;
                self.inner.next_back()
            }
        }
    }
}

// str::split_terminator's iterator.
pub struct SplitTerminator<'a, P> {
    inner: Split<'a, P>,
}

impl<'a, P: Pattern> Iterator for SplitTerminator<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        self.inner.next()
    }
}

// str::split_inclusive's iterator.
pub struct SplitInclusive<'a, P> {
    inner: Split<'a, P>,
}

impl<'a, P: Pattern> Iterator for SplitInclusive<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.inner.done {
            return None;
        }
        let m = match self.inner.front {
            Some(at) => self.inner.pat.next_match(self.inner.hay, at),
            None => None,
        };
        match m {
            Some((a, b)) if b <= self.inner.end => {
                let piece = &self.inner.hay[self.inner.start..b];
                self.inner.start = b;
                self.inner.front = after_match(self.inner.hay, a, b);
                Some(piece)
            }
            _ => self.inner.get_end(),
        }
    }
}

// str::split_whitespace's iterator.
#[derive(Clone)]
pub struct SplitWhitespace<'a> {
    rest: &'a str,
}

impl<'a> Iterator for SplitWhitespace<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        let s = self.rest.trim_start();
        if s.is_empty() {
            self.rest = s;
            return None;
        }
        let mut it = s.char_indices();
        loop {
            match it.next() {
                Some((i, c)) => {
                    if c.is_whitespace() {
                        self.rest = &s[i..];
                        return Some(&s[..i]);
                    }
                }
                None => {
                    self.rest = "";
                    return Some(s);
                }
            }
        }
    }
}

impl<'a> DoubleEndedIterator for SplitWhitespace<'a> {
    fn next_back(&mut self) -> Option<&'a str> {
        let s = self.rest.trim_end();
        if s.is_empty() {
            self.rest = s;
            return None;
        }
        let mut it = s.char_indices();
        loop {
            match it.next_back() {
                Some((i, c)) => {
                    if c.is_whitespace() {
                        let j = i + c.len_utf8();
                        self.rest = &s[..i];
                        return Some(&s[j..]);
                    }
                }
                None => {
                    self.rest = "";
                    return Some(s);
                }
            }
        }
    }
}

// str::split_ascii_whitespace's iterator.
#[derive(Clone)]
pub struct SplitAsciiWhitespace<'a> {
    rest: &'a str,
}

impl<'a> Iterator for SplitAsciiWhitespace<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        let b = self.rest.as_bytes();
        let mut i: usize = 0;
        while i < b.len() && is_ascii_space(b[i]) {
            i += 1;
        }
        if i == b.len() {
            self.rest = "";
            return None;
        }
        let mut j = i;
        while j < b.len() && !is_ascii_space(b[j]) {
            j += 1;
        }
        let s = self.rest;
        self.rest = &s[j..];
        Some(&s[i..j])
    }
}

// str::matches's iterator (at: where the next search starts; past the
// end when done).
pub struct Matches<'a, P> {
    hay: &'a str,
    at: usize,
    pat: P,
}

impl<'a, P: Pattern> Iterator for Matches<'a, P> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.at > self.hay.len() {
            return None;
        }
        match self.pat.next_match(self.hay, self.at) {
            Some((a, b)) => {
                self.at = match after_match(self.hay, a, b) {
                    Some(n) => n,
                    None => self.hay.len() + 1,
                };
                Some(&self.hay[a..b])
            }
            None => {
                self.at = self.hay.len() + 1;
                None
            }
        }
    }
}

// str::match_indices's iterator.
pub struct MatchIndices<'a, P> {
    hay: &'a str,
    at: usize,
    pat: P,
}

impl<'a, P: Pattern> Iterator for MatchIndices<'a, P> {
    type Item = (usize, &'a str);

    fn next(&mut self) -> Option<(usize, &'a str)> {
        if self.at > self.hay.len() {
            return None;
        }
        match self.pat.next_match(self.hay, self.at) {
            Some((a, b)) => {
                self.at = match after_match(self.hay, a, b) {
                    Some(n) => n,
                    None => self.hay.len() + 1,
                };
                Some((a, &self.hay[a..b]))
            }
            None => {
                self.at = self.hay.len() + 1;
                None
            }
        }
    }
}

// str::graphemes's iterator: vole's.
// mvs: StrGraphemes
// std: renamed
pub struct Graphemes<'a> {
    rest: &'a str,
    extended: bool,
}

// ---- The helpers ----

// The first code point of b (UTF-8, not empty) and its length.
fn decode_first(b: &[u8]) -> (char, usize) {
    let x = b[0] as u32;
    let (n, init): (usize, u32) = if x < 0x80 {
        (1, x)
    } else if x < 0xE0 {
        (2, x & 0x1F)
    } else if x < 0xF0 {
        (3, x & 0x0F)
    } else {
        (4, x & 0x07)
    };
    let mut cp = init;
    let mut k: usize = 1;
    while k < n {
        cp = (cp << 6) | (b[k] as u32 & 0x3F);
        k += 1;
    }
    (to_char(cp), n)
}

// The last code point of b (UTF-8, not empty) and its length.
fn decode_last(b: &[u8]) -> (char, usize) {
    let mut i = b.len() - 1;
    while i > 0 && b[i] & 0xC0 == 0x80 {
        i -= 1;
    }
    let (c, _) = decode_first(&b[i..]);
    (c, b.len() - i)
}

fn to_char(cp: u32) -> char {
    match char::from_u32(cp) {
        Some(c) => c,
        None => '\u{FFFD}',
    }
}

// Where the search after the match a..b starts: b, or past the next char
// for an empty match (so it is not found again); None past the end.
fn after_match(hay: &str, a: usize, b: usize) -> Option<usize> {
    if a < b {
        Some(b)
    } else if b < hay.len() {
        let (_, n) = decode_first(&hay.as_bytes()[b..]);
        Some(b + n)
    } else {
        None
    }
}

// The same, searching backwards: a, or before the previous char.
fn before_match(hay: &str, a: usize, b: usize) -> Option<usize> {
    if a < b {
        Some(a)
    } else if a > 0 {
        let (_, n) = decode_last(&hay.as_bytes()[..a]);
        Some(a - n)
    } else {
        None
    }
}

// Where x first (last) is in b: a line's end.
fn find_byte(b: &[u8], x: u8) -> Option<usize> {
    let mut i: usize = 0;
    while i < b.len() {
        if b[i] == x {
            return Some(i);
        }
        i += 1;
    }
    None
}

fn rfind_byte(b: &[u8], x: u8) -> Option<usize> {
    let mut i = b.len();
    while i > 0 {
        i -= 1;
        if b[i] == x {
            return Some(i);
        }
    }
    None
}

// A line without its "\r" (of a "\r\n").
fn strip_cr(line: &str) -> &str {
    let n = line.len();
    let cut = if n > 0 && line.as_bytes()[n - 1] == 0x0D { n - 1 } else { n };
    &line[..cut]
}

// Rust's u8::is_ascii_whitespace: space, \t, \n, \x0C, \r.
fn is_ascii_space(b: u8) -> bool {
    b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0C || b == 0x0D
}

fn ascii_lower(b: u8) -> u8 {
    if b >= 0x41 && b <= 0x5A { b + 32 } else { b }
}

fn ascii_upper(b: u8) -> u8 {
    if b >= 0x61 && b <= 0x7A { b - 32 } else { b }
}

// A &mut str's bytes (Rust's str::as_bytes_mut).
// UNSAFE: the bytes can be written with what is not UTF-8.
// SAFETY: a contract on the caller: what it writes keeps s UTF-8.
unsafe fn bytes_mut(s: &mut str) -> &mut [u8] {
    // UNSAFE: the str's bytes through its fat pointer, as Rust's core.
    // SAFETY: the pointer and length are s's own, and s is borrowed mutably
    // for the result's life, so nothing else reaches the bytes.
    unsafe { &mut *(s as *mut str as *mut [u8]) }
}

// UTF-8 bytes as a &mut str (Rust's str::from_utf8_unchecked_mut).
// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.
// SAFETY: a contract on the caller: b is UTF-8.
unsafe fn str_mut(b: &mut [u8]) -> &mut str {
    // UNSAFE: a pointer cast between [u8] and str.
    // SAFETY: the same layout; the caller promises UTF-8.
    unsafe { &mut *(b as *mut [u8] as *mut str) }
}

// `&s[a..b]` out of bounds or off a char boundary: Rust's messages, without
// the text (str's Display in a panic's format waits for format_fns).
fn slice_error_fail(s: &str, a: usize, b: usize) -> ! {
    if a > s.len() {
        crate::panic::panic("byte index {} is out of bounds of a str of {} bytes", a, s.len())
    } else if b > s.len() {
        crate::panic::panic("byte index {} is out of bounds of a str of {} bytes", b, s.len())
    } else if a > b {
        crate::panic::panic("begin <= end ({} <= {}) when slicing a str", a, b)
    } else if !s.is_char_boundary(a) {
        crate::panic::panic("byte index {} is not a char boundary", a)
    } else {
        crate::panic::panic("byte index {} is not a char boundary", b)
    }
}

// `\u{1b}`: Debug's escape of a control char, in lower-case hex.
// terminates: x, a u32, loses four bits each pass: eight passes at most.
#[terminates]
fn write_unicode_escape(f: &mut Formatter<'_>, cp: u32) -> crate::fmt::Result {
    // `\u{`, the hex digits, `}`, written from the end back
    let mut buf = [0u8; 11];
    let mut n: usize = 11;
    n -= 1;
    buf[n] = 0x7D;
    let mut x = cp;
    loop {
        let d = (x & 0xF) as u8;
        n -= 1;
        buf[n] = if d < 10 { 0x30 + d } else { 0x57 + d };
        x = x >> 4;
        if x == 0 {
            break;
        }
    }
    n -= 3;
    buf[n] = 0x5C;
    buf[n + 1] = 0x75;
    buf[n + 2] = 0x7B;
    match from_utf8(&buf[n..]) {
        Ok(s) => f.write_str(s),
        Err(_) => Ok(()),
    }
}

// The grapheme properties the clusters need (UAX #29), from the code
// point ranges std has without the Unicode tables (MVS's std::unicode).
fn is_control(cp: u32) -> bool {
    cp < 0x20 || (cp >= 0x7F && cp < 0xA0) || cp == 0x2028 || cp == 0x2029
}

fn is_regional(cp: u32) -> bool {
    cp >= 0x1F1E6 && cp <= 0x1F1FF
}

fn is_extend(c: char) -> bool {
    let cp = c as u32;
    (cp >= 0x300 && cp <= 0x36F)
        || (cp >= 0x1AB0 && cp <= 0x1AFF)
        || (cp >= 0x1DC0 && cp <= 0x1DFF)
        || (cp >= 0x20D0 && cp <= 0x20FF)
        || (cp >= 0xFE00 && cp <= 0xFE0F)
        || (cp >= 0xFE20 && cp <= 0xFE2F)
        || (cp >= 0x1F3FB && cp <= 0x1F3FF)
        || (cp >= 0xE0020 && cp <= 0xE007F)
        || (cp >= 0x300 && !is_control(cp) && c.width() == 0 && cp != 0x200D)
}

// SpacingMark: the common Indic vowel signs.
fn is_spacing_mark(cp: u32) -> bool {
    cp == 0x903 || cp == 0x93B || (cp >= 0x93E && cp <= 0x940) || (cp >= 0x949 && cp <= 0x94C)
        || cp == 0x94E || cp == 0x94F || cp == 0x982 || cp == 0x983
        || (cp >= 0x9BF && cp <= 0x9C0) || (cp >= 0xBBF && cp <= 0xBC0)
}

// East Asian Ambiguous: the main blocks (Latin-1's symbols, Greek,
// Cyrillic, box drawing, the circled and geometric forms, private use).
fn is_ambiguous(cp: u32) -> bool {
    cp == 0xA1 || cp == 0xA4 || cp == 0xA7 || cp == 0xA8 || cp == 0xAA || cp == 0xAD || cp == 0xAE
        || (cp >= 0xB0 && cp <= 0xB4) || (cp >= 0xB6 && cp <= 0xBA) || (cp >= 0xBC && cp <= 0xBF)
        || cp == 0xC6 || cp == 0xD0 || cp == 0xD7 || cp == 0xD8 || (cp >= 0xDE && cp <= 0xE1)
        || cp == 0xE6 || (cp >= 0xE8 && cp <= 0xEA) || cp == 0xEC || cp == 0xED || cp == 0xF0
        || cp == 0xF2 || cp == 0xF3 || (cp >= 0xF7 && cp <= 0xFA) || cp == 0xFC || cp == 0xFE
        || (cp >= 0x391 && cp <= 0x3A9) || (cp >= 0x3B1 && cp <= 0x3C9) || cp == 0x401
        || (cp >= 0x410 && cp <= 0x44F) || cp == 0x451 || (cp >= 0x2010 && cp <= 0x2027)
        || (cp >= 0x2460 && cp <= 0x24FF) || (cp >= 0x2500 && cp <= 0x257F)
        || (cp >= 0x25A0 && cp <= 0x25FF) || (cp >= 0xE000 && cp <= 0xF8FF) || cp == 0xFFFD
}

// A cluster's columns: its first char's, 2 with an emoji presentation
// selector (U+FE0F), or with cjk an ambiguous one.
fn cluster_width(g: &str, cjk: bool) -> usize {
    let (c, _) = decode_first(g.as_bytes());
    let w = c.width();
    // U+FE0F is EF B8 8F in UTF-8
    let b = g.as_bytes();
    let mut vs16 = false;
    let mut i: usize = 0;
    while i + 2 < b.len() {
        if b[i] == 0xEF && b[i + 1] == 0xB8 && b[i + 2] == 0x8F {
            vs16 = true;
        }
        i += 1;
    }
    if w == 1 && (vs16 || (cjk && is_ambiguous(c as u32))) {
        2
    } else {
        w
    }
}

impl<'a> Iterator for Graphemes<'a> {
    type Item = &'a str;

    fn next(&mut self) -> Option<&'a str> {
        if self.rest.is_empty() {
            return None;
        }
        let s = self.rest;
        let b = s.as_bytes();
        let (first, n0) = decode_first(b);
        let mut prev = first as u32;
        let mut end = n0;
        // regional indicators pair up (GB12, GB13)
        let mut ri: usize = if is_regional(prev) { 1 } else { 0 };
        while end < b.len() {
            let (c, n) = decode_first(&b[end..]);
            let cp = c as u32;
            // GB3: CR LF stays together; GB4, GB5: a control breaks
            let join = if prev == 0x0D && cp == 0x0A {
                true
            } else if is_control(prev) || is_control(cp) {
                false
            } else if is_extend(c) || cp == 0x200D {
                // GB9: Extend and ZWJ
                true
            } else if self.extended && is_spacing_mark(cp) {
                // GB9a
                true
            } else if prev == 0x200D && c.width() == 2 {
                // GB11: ZWJ then a pictograph (wide as an approximation)
                true
            } else if is_regional(cp) && ri % 2 == 1 {
                true
            } else {
                false
            };
            if !join {
                break;
            }
            if is_regional(cp) {
                ri += 1;
            }
            prev = cp;
            end += n;
        }
        self.rest = &s[end..];
        Some(&s[..end])
    }
}

// Unicode's Cased, approximately: Lowercase or Uppercase (the titlecase
// letters, Lt, are left out).
fn is_cased(c: char) -> bool {
    c.is_lowercase() || c.is_uppercase()
}

// Unicode's Case_Ignorable, approximately: the apostrophes, the word
// punctuation Unicode lists (`.`, `:`, `^`, `` ` ``, U+00AD, U+00B7) and
// the combining diacritical marks.
fn is_case_ignorable(c: char) -> bool {
    let u = c as u32;
    c == '\'' || c == '.' || c == ':' || c == '^' || c == '`' || u == 0xAD || u == 0xB7
        || u == 0x2019 || (u >= 0x300 && u <= 0x36F)
}

// Whether the last char of s that is not case-ignorable is cased (Final_Sigma's
// "before").
fn cased_before(s: &str) -> bool {
    let mut it = s.chars();
    while let Some(c) = it.next_back() {
        if !is_case_ignorable(c) {
            return is_cased(c);
        }
    }
    false
}

// Whether the first char of s that is not case-ignorable is cased.
fn cased_after(s: &str) -> bool {
    let mut it = s.chars();
    while let Some(c) = it.next() {
        if !is_case_ignorable(c) {
            return is_cased(c);
        }
    }
    false
}
