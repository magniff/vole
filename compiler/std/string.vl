// std::string: String<A>, owned UTF-8 text on A's heap, and ToStringIn.
// `String::new_in(a)`, `String::from_in("x", a)`, `"x".to_string_in(a)`;
// no `String::from(s)` and no `From<&str>` (it would allocate with no
// allocator in the call: plan §2). A String has str's methods through
// Deref; its own are the ones that change it, and they allocate from its
// A only. MVS's Buf<A> (a byte buffer) is gone: a Vec<u8, A>, or a String.
// `write(&mut s, "{x}")` (fmt::Write) is MVS's `s.push_fmt("{x}")`.

use crate::alloc::{Allocator, TryReserveError};
use crate::borrow::{Borrow, BorrowMut};
use crate::clone::Clone;
use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::convert::{AsMut, AsRef};
use crate::default::DefaultIn;
use crate::fmt::{Debug, Display, Formatter, Write};
use crate::hash::{Hash, Hasher};
use crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};
use crate::ops::{Add, AddAssign, Bound, Deref, DerefMut, Index, IndexMut, RangeBounds};
use crate::option::Option;
use crate::result::Result;
use crate::slice::SliceIndex;
use crate::str::{Chars, Utf8Error};
use crate::vec::Vec;

// UTF-8 text that owns its bytes, on A.
pub struct String<A: Allocator> {
    vec: Vec<u8, A>,
}

impl<A: Allocator> String<A> {
    // An empty String on a; it allocates at its first push.
    #[effects(A)]
    pub fn new_in(a: A) -> String<A> {
        String { vec: Vec::new_in(a) }
    }

    #[effects(A)]
    pub fn with_capacity_in(cap: usize, a: A) -> String<A> {
        String { vec: Vec::with_capacity_in(cap, a) }
    }

    // A copy of s on a.
    // std: changed: takes &str
    #[effects(A)]
    pub fn from_in(s: &str, a: A) -> String<A> {
        let mut out = String::with_capacity_in(s.len(), a);
        out.push_str(s);
        out
    }

    // v as a String when it is UTF-8; the error gives v back.
    // std: changed: the error is FromUtf8Error<A>, which holds v (MVS: Utf8Error)
    #[effects(panic, diverge, A)]
    pub fn from_utf8(v: Vec<u8, A>) -> Result<String<A>, FromUtf8Error<A>> {
        match crate::str::from_utf8(v.as_slice()) {
            Result::Ok(_) => Result::Ok(String { vec: v }),
            Result::Err(e) => Result::Err(FromUtf8Error { bytes: v, error: e }),
        }
    }

    #[effects(unsafe)]
    // UNSAFE: bytes that are not UTF-8 make a String whose str methods are undefined.
    // SAFETY: a contract on the caller: v is UTF-8.
    pub unsafe fn from_utf8_unchecked(v: Vec<u8, A>) -> String<A> {
        String { vec: v }
    }

    // v as text on a, each bad sequence U+FFFD (Rust's from_utf8_lossy,
    // which returns a Cow).
    // std: changed: takes &[u8]
    #[effects(panic, diverge, unsafe, A)]
    pub fn from_utf8_lossy_in(v: &[u8], a: A) -> String<A> {
        let mut out = String::with_capacity_in(v.len(), a);
        let mut rest = v;
        loop {
            match crate::str::from_utf8(rest) {
                Result::Ok(s) => {
                    out.push_str(s);
                    return out;
                }
                Result::Err(e) => {
                    let good = e.valid_up_to();
                    // UNSAFE: from_utf8 checked these bytes already; the
                    // checked conversion would check them again.
                    // SAFETY: valid_up_to says the first good bytes of rest
                    // are UTF-8.
                    out.push_str(unsafe { crate::str::from_utf8_unchecked(&rest[..good]) });
                    out.push_str("\u{FFFD}");
                    let bad = match e.error_len() {
                        Option::Some(n) => n,
                        Option::None => rest.len() - good,
                    };
                    rest = &rest[good + bad..];
                }
            }
        }
    }

    // Its length in bytes.
    #[effects(A)]
    pub fn len(&self) -> usize {
        self.vec.len()
    }

    #[effects(A)]
    pub fn is_empty(&self) -> bool {
        self.vec.is_empty()
    }

    #[effects(A)]
    pub fn capacity(&self) -> usize {
        self.vec.capacity()
    }

    // std: changed: returns &A (MVS: a copy of A)
    #[effects(A)]
    pub fn allocator(&self) -> &A {
        self.vec.allocator()
    }

    #[effects(A)]
    pub fn reserve(&mut self, extra: usize) {
        self.vec.reserve(extra)
    }

    #[effects(A)]
    pub fn reserve_exact(&mut self, extra: usize) {
        self.vec.reserve_exact(extra)
    }

    #[effects(A)]
    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {
        self.vec.try_reserve(extra)
    }

    #[effects(A)]
    pub fn shrink_to_fit(&mut self) {
        self.vec.shrink_to_fit()
    }

    // Empties it; the capacity stays.
    #[effects(panic, A)]
    pub fn clear(&mut self)
        ensures self.len() == 0
    {
        self.vec.clear()
    }

    #[effects(unsafe, A)]
    pub fn as_str(&self) -> &str {
        // UNSAFE: the bytes are not checked again.
        // SAFETY: a String's bytes are UTF-8 (every method that writes them
        // keeps them so; as_mut_vec's caller promises it).
        unsafe { crate::str::from_utf8_unchecked(self.vec.as_slice()) }
    }

    #[effects(A)]
    pub fn as_mut_str(&mut self) -> &mut str {
        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's
        // str::from_utf8_unchecked_mut).
        // SAFETY: a String's bytes are UTF-8, and a str is laid out as a
        // [u8]; the &mut str's writes keep them UTF-8 (str's contract).
        unsafe { &mut *(self.vec.as_mut_slice() as *mut [u8] as *mut str) }
    }

    // mvs: String::as_bytes, String::as_slice
    #[effects(A)]
    pub fn as_bytes(&self) -> &[u8] {
        self.vec.as_slice()
    }

    // Its bytes as a &mut Vec.
    #[effects(unsafe)]
    // UNSAFE: writing bytes that are not UTF-8 breaks the String.
    // SAFETY: a contract on the caller: the bytes stay UTF-8.
    pub unsafe fn as_mut_vec(&mut self) -> &mut Vec<u8, A> {
        &mut self.vec
    }

    // Its bytes, the String consumed.
    #[effects()]
    pub fn into_bytes(self) -> Vec<u8, A> {
        self.vec
    }

    // Appends c's UTF-8.
    // std: changed: takes a char (MVS: a u32 code point)
    #[effects(panic, A)]
    pub fn push(&mut self, c: char)
        ensures self.len() > old(self.len())
    {
        if c.len_utf8() == 1 {
            self.vec.push(c as u8);
        } else {
            let mut buf = [0u8; 4];
            self.push_str(c.encode_utf8(&mut buf));
        }
    }

    #[effects(A)]
    pub fn push_str(&mut self, s: &str) {
        self.vec.extend_from_slice(s.as_bytes())
    }

    // The last char, removed.
    // std: changed: Option<char> (MVS: Option<u32>)
    #[effects(panic, diverge, A)]
    pub fn pop(&mut self) -> Option<char> {
        let c = self.as_str().chars().next_back()?;
        let n = self.len() - c.len_utf8();
        self.vec.truncate(n);
        Option::Some(c)
    }

    // Keeps the first n bytes; panics when n is not a char boundary.
    #[effects(panic, A)]
    pub fn truncate(&mut self, n: usize)
        requires n >= self.len() || self.as_str().is_char_boundary(n)
    {
        if n <= self.len() {
            crate::panic::assert(self.is_char_boundary(n), "String::truncate: not a char boundary");
            self.vec.truncate(n);
        }
    }

    // Inserts c at byte i (a char boundary).
    // std: changed: takes a char
    #[effects(panic, A)]
    pub fn insert(&mut self, i: usize, c: char)
        requires self.as_str().is_char_boundary(i)
    {
        crate::panic::assert(self.is_char_boundary(i), "String::insert: not a char boundary");
        let mut buf = [0u8; 4];
        let s = c.encode_utf8(&mut buf);
        self.insert_bytes(i, s.as_bytes());
    }

    #[effects(panic, A)]
    pub fn insert_str(&mut self, i: usize, s: &str)
        requires self.as_str().is_char_boundary(i)
    {
        crate::panic::assert(self.is_char_boundary(i), "String::insert_str: not a char boundary");
        self.insert_bytes(i, s.as_bytes());
    }

    // Removes the char at byte i.
    // std: changed: returns a char
    #[effects(panic, A)]
    pub fn remove(&mut self, i: usize) -> char {
        let c = match self.as_str()[i..].chars().next() {
            Option::Some(c) => c,
            Option::None => {
                let msg: &str = "cannot remove a char from the end of a string";
                crate::panic::panic(msg)
            }
        };
        self.vec.drain(i..i + c.len_utf8());
        c
    }

    // Keeps the chars f says true of.
    // std: changed: FnMut(char) (MVS: FnMut(u32))
    #[effects(panic, diverge, unsafe, A, F)]
    pub fn retain<F: FnMut(char) -> bool>(&mut self, f: F) {
        let mut f = f;
        let len = self.len();
        let mut r: usize = 0;
        let mut w: usize = 0;
        while r < len {
            // UNSAFE: the bytes from r on are read as text while the ones
            // before are being moved down.
            // SAFETY: w <= r, so the bytes from r on are untouched: the
            // String's own, UTF-8, and r is a char boundary in them.
            let rest = unsafe { crate::str::from_utf8_unchecked(&self.vec.as_slice()[r..]) };
            let c = match rest.chars().next() {
                Option::Some(c) => c,
                Option::None => break,
            };
            let n = c.len_utf8();
            if f(c) {
                self.vec.copy_within(r..r + n, w);
                w += n;
            }
            r += n;
        }
        self.vec.truncate(w);
    }

    // The chars in range, removed and yielded by the iterator.
    #[effects(panic, unsafe, A, R)]
    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, A> {
        let (start, end) = range_of(&range, self.len());
        crate::panic::assert(self.is_char_boundary(start),
            "String::drain: start is not a char boundary");
        crate::panic::assert(self.is_char_boundary(end),
            "String::drain: end is not a char boundary");
        let p = self.vec.as_ptr();
        // UNSAFE: the iterator reads the drained text while the Drain holds
        // the String (removed at its drop), as Rust's Drain.
        // SAFETY: start..end is within the String and on char boundaries,
        // so the bytes are UTF-8; the Drain borrows the String mutably for
        // '_, so nothing else changes them before its drop.
        let text = unsafe { crate::str::from_utf8_unchecked(
            crate::slice::from_raw_parts(p.add(start), end - start)) };
        Drain { string: self as *mut String<A>, start: start, end: end, iter: text.chars() }
    }

    // The text from byte at on, as a new String on a clone of A.
    #[effects(panic, A)]
    pub fn split_off(&mut self, at: usize) -> String<A>
        where
            A: Clone,
            requires self.as_str().is_char_boundary(at)
    {
        crate::panic::assert(self.is_char_boundary(at), "String::split_off: not a char boundary");
        String { vec: self.vec.split_off(at) }
    }

    // Replaces the bytes in range with s.
    #[effects(panic, A, R)]
    pub fn replace_range<R: RangeBounds<usize>>(&mut self, range: R, s: &str) {
        let (start, end) = range_of(&range, self.len());
        crate::panic::assert(self.is_char_boundary(start),
            "String::replace_range: start is not a char boundary");
        crate::panic::assert(self.is_char_boundary(end),
            "String::replace_range: end is not a char boundary");
        self.vec.drain(start..end);
        self.insert_bytes(start, s.as_bytes());
    }

    // Appends a copy of its own bytes in src.
    #[effects(A, R)]
    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {
        self.vec.extend_from_within(src)
    }

    // bytes put in at byte i, the ones after it moved up (insert's and
    // replace_range's; the caller checks that i is a char boundary).
    fn insert_bytes(&mut self, i: usize, bytes: &[u8]) {
        let n = bytes.len();
        self.vec.extend_from_slice(bytes);
        self.vec.as_mut_slice()[i..].rotate_right(n);
    }

    // A copy on another allocator.
    #[effects(A, B)]
    pub fn clone_in<B: Allocator>(&self, b: B) -> String<B> {
        String::from_in(self.as_str(), b)
    }

    // The text, never freed.
    #[effects(A)]
    pub fn leak<'a>(self) -> &'a mut str
        where
            A: 'a,
    {
        let bytes = self.vec.leak();
        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's
        // str::from_utf8_unchecked_mut).
        // SAFETY: a String's bytes are UTF-8, and a str is laid out as a [u8].
        unsafe { &mut *(bytes as *mut [u8] as *mut str) }
    }

    // Moves the String out, leaving an empty one on a clone of its allocator.
    #[effects(A)]
    pub fn take(&mut self) -> String<A>
        where
            A: Clone,
    {
        String { vec: self.vec.take() }
    }
}

impl<A: Allocator> Deref for String<A> {
    type Target = str;

    fn deref(&self) -> &str {
        self.as_str()
    }
}

impl<A: Allocator> DerefMut for String<A> {
    fn deref_mut(&mut self) -> &mut str {
        self.as_mut_str()
    }
}

impl<I: SliceIndex<str>, A: Allocator> Index<I> for String<A> {
    type Output = I::Output;

    fn index(&self, index: I) -> &I::Output {
        index.index(self.as_str())
    }
}

impl<I: SliceIndex<str>, A: Allocator> IndexMut<I> for String<A> {
    fn index_mut(&mut self, index: I) -> &mut I::Output {
        index.index_mut(self.as_mut_str())
    }
}

// A copy on the same allocator (a clone of it).
// std: changed: needs A: Clone
impl<A: Allocator + Clone> Clone for String<A> {
    fn clone(&self) -> String<A> {
        String { vec: self.vec.clone() }
    }
}

// mvs: String::impl Eq
// std: changed: PartialEq with any String<B>, str and &str
impl<A: Allocator, B: Allocator> PartialEq<String<B>> for String<A> {
    fn eq(&self, other: &String<B>) -> bool {
        self.as_str() == other.as_str()
    }
}

impl<A: Allocator> PartialEq<str> for String<A> {
    fn eq(&self, other: &str) -> bool {
        self.as_str() == other
    }
}

impl<'a, A: Allocator> PartialEq<&'a str> for String<A> {
    fn eq(&self, other: &&'a str) -> bool {
        self.as_str() == *other
    }
}

impl<A: Allocator> Eq for String<A> {}

impl<A: Allocator> PartialOrd for String<A> {
    fn partial_cmp(&self, other: &String<A>) -> Option<Ordering> {
        Option::Some(self.cmp(other))
    }
}

// mvs: String::impl Ord
impl<A: Allocator> Ord for String<A> {
    fn cmp(&self, other: &String<A>) -> Ordering {
        self.as_str().cmp(other.as_str())
    }
}

// As its str: the same for any A, so a HashMap<String<A>, V, A2> is
// looked up by a &str (Borrow<str>).
// mvs: String::impl Hash
impl<A: Allocator> Hash for String<A> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_str().hash(state)
    }
}

// mvs: String::impl Display
impl<A: Allocator> Display for String<A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        Display::fmt(self.as_str(), f)
    }
}

// mvs: String::impl Debug
impl<A: Allocator> Debug for String<A> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        Debug::fmt(self.as_str(), f)
    }
}

// `write(&mut s, "{x}")`: never fails (it grows from A).
// mvs: String::push_fmt, Buf::push_fmt
impl<A: Allocator> Write for String<A> {
    fn write_str(&mut self, s: &str) -> crate::fmt::Result {
        self.push_str(s);
        Result::Ok(())
    }
}

impl<A: Allocator> Borrow<str> for String<A> {
    fn borrow(&self) -> &str {
        self.as_str()
    }
}

impl<A: Allocator> BorrowMut<str> for String<A> {
    fn borrow_mut(&mut self) -> &mut str {
        self.as_mut_str()
    }
}

impl<A: Allocator> AsRef<str> for String<A> {
    fn as_ref(&self) -> &str {
        self.as_str()
    }
}

impl<A: Allocator> AsRef<[u8]> for String<A> {
    fn as_ref(&self) -> &[u8] {
        self.as_bytes()
    }
}

impl<A: Allocator> AsMut<str> for String<A> {
    fn as_mut(&mut self) -> &mut str {
        self.as_mut_str()
    }
}

// `s + "x"`: s, grown from its own A.
impl<'b, A: Allocator> Add<&'b str> for String<A> {
    type Output = String<A>;

    fn add(self, other: &'b str) -> String<A> {
        let mut s = self;
        s.push_str(other);
        s
    }
}

// `s += "x"`.
impl<'b, A: Allocator> AddAssign<&'b str> for String<A> {
    fn add_assign(&mut self, other: &'b str) {
        self.push_str(other)
    }
}

impl<A: Allocator> Extend<char> for String<A> {
    fn extend<I: IntoIterator<Item = char>>(&mut self, iter: I) {
        for c in iter {
            self.push(c);
        }
    }
}

impl<'b, A: Allocator> Extend<&'b str> for String<A> {
    fn extend<I: IntoIterator<Item = &'b str>>(&mut self, iter: I) {
        for s in iter {
            self.push_str(s);
        }
    }
}

// `chars.collect_in(a)` into a String.
impl<A: Allocator> FromIteratorIn<char, A> for String<A> {
    fn from_iter_in<I: IntoIterator<Item = char>>(iter: I, a: A) -> String<A> {
        let mut s = String::new_in(a);
        s.extend(iter);
        s
    }
}

impl<'b, A: Allocator> FromIteratorIn<&'b str, A> for String<A> {
    fn from_iter_in<I: IntoIterator<Item = &'b str>>(iter: I, a: A) -> String<A> {
        let mut s = String::new_in(a);
        s.extend(iter);
        s
    }
}

impl<A: Allocator> DefaultIn<A> for String<A> {
    fn default_in(a: A) -> String<A> {
        String::new_in(a)
    }
}

// Why bytes are not a String: the error, and the bytes back.
#[derive(Debug)]
pub struct FromUtf8Error<A: Allocator> {
    bytes: Vec<u8, A>,
    error: Utf8Error,
}

impl<A: Allocator> FromUtf8Error<A> {
    #[effects(A)]
    pub fn as_bytes(&self) -> &[u8] {
        self.bytes.as_slice()
    }

    #[effects()]
    pub fn into_bytes(self) -> Vec<u8, A> {
        self.bytes
    }

    #[effects()]
    pub fn utf8_error(&self) -> Utf8Error {
        self.error
    }
}

// The start and end a range names in 0..len; panics when it is not in
// it or ends before it starts.
fn range_of<R: RangeBounds<usize>>(range: &R, len: usize) -> (usize, usize) {
    let start = match range.start_bound() {
        Bound::Included(s) => *s,
        Bound::Excluded(s) => *s + 1,
        Bound::Unbounded => 0,
    };
    let end = match range.end_bound() {
        Bound::Included(e) => *e + 1,
        Bound::Excluded(e) => *e,
        Bound::Unbounded => len,
    };
    crate::panic::assert(start <= end && end <= len, "String: range out of bounds");
    (start, end)
}

// String::drain's iterator: the removed chars.
pub struct Drain<'a, A: Allocator> {
    string: *mut String<A>,
    start: usize,
    end: usize,
    iter: Chars<'a>,
}

// UNSAFE: Drain reaches its String through a raw pointer: stated, as Rust's.
// SAFETY: it is the exclusive borrow of the String for 'a; its bytes are
// plain data, so it is Send and Sync as `&'a mut String<A>` is.
unsafe impl<'a, A: Allocator + Send> Send for Drain<'a, A> {}
// UNSAFE: as Send's, above.
// SAFETY: `&Drain` reads only the drained bytes.
unsafe impl<'a, A: Allocator + Sync> Sync for Drain<'a, A> {}

impl<'a, A: Allocator> Iterator for Drain<'a, A> {
    type Item = char;

    fn next(&mut self) -> Option<char> {
        self.iter.next()
    }
}

impl<'a, A: Allocator> DoubleEndedIterator for Drain<'a, A> {
    fn next_back(&mut self) -> Option<char> {
        self.iter.next_back()
    }
}

impl<'a, A: Allocator> crate::ops::Drop for Drain<'a, A> {
    fn drop(&mut self) {
        // UNSAFE: the String is reached through the pointer drain took.
        // SAFETY: the Drain borrowed the String mutably for its life, so the
        // pointer is valid and nothing else uses the String; start..end was
        // checked against its length and char boundaries at drain.
        unsafe {
            (*self.string).vec.drain(self.start..self.end);
        }
    }
}

// What can be written as text, written into a new String on a: Rust's
// ToString with the allocator named. Every Display type has it
// (`x.to_string_in(gpa)`, `format_args("{a}-{b}").to_string_in(gpa)`).
pub trait ToStringIn<A: Allocator> {
    fn to_string_in(&self, a: A) -> String<A>;
}

// later: blanket_impl
impl<T: Display + ?Sized, A: Allocator> ToStringIn<A> for T {
    fn to_string_in(&self, a: A) -> String<A> {
        let mut s = String::new_in(a);
        let _ = s.write_fmt(self);
        s
    }
}
