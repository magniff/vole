// std::cell: memory that changes through a shared reference (0.26.1).

use std::Default;

// ---- Cells: UnsafeCell (0.26.1) ----

// Rust's UnsafeCell and Cell, under mutable value semantics (docs/grammar.md,
// "Interior mutability").
//
// A cell is owned (move-only, as Rust's Cell is not Copy) and has no drop
// of its own: `let d = c` moves it, `needs_drop::<Cell<i64>>()` is false.
// Being owned makes a `let` parameter, and `let self`, of a cell a shared
// reference to the caller's place, so a write through it reaches the
// caller's value:
//
//     fn bump(c: Cell<i64>) { c.set(c.get() + 1); }
//     let c = Cell::new(1);
//     bump(c);                     // c.get() == 2
//
// A type that holds an UnsafeCell by value is not `Freeze` (the compiler's
// auto trait, std::Freeze): the optimizer keeps no fact about it across a
// call, an immutable static of it lives in writable data, and it is not
// Sync (an immutable `static` of it is sync.static). A copy of a cell
// would be another cell: where the compiler would make one (std's copying
// getters, `v.get(i)`) it is own.interior_copy instead.

// The one source of a writable pointer from a shared reference: `get`
// gives the value's address. Writing through it is the caller's business
// (an `unsafe` dereference), as is that no write races with another
// thread's access (UnsafeCell is not Sync).
pub struct UnsafeCell<T> { value: T }

impl<T> UnsafeCell<T> {
    #[inline]
    pub fn new(v: sink T) -> UnsafeCell<T> { UnsafeCell { value: v } }

    // The value's address: the caller's place, `self` being a reference.
    #[inline]
    pub fn get(self) -> *T { &self.value as *T }

    // The value, when nothing else can reach the cell.
    #[inline]
    pub fn into_inner(sink self) -> T {
        let c = self;
        c.value
    }
}

// ---- Cells: Cell (0.26.1) ----

// A value changed through a shared reference, one thread at a time (Cell
// is Send when T is, never Sync). `get` copies the value out (T: Copy);
// `set`, `replace`, `take` and `swap` move values in and out, so no
// reference into the cell is ever made.
pub struct Cell<T> { value: UnsafeCell<T> }

// Each `unsafe` below reads or writes *self.value.get(), the cell's own
// value: valid and aligned for T, reached by no reference (only values move
// in and out), and by one thread (Cell is not Sync).
impl<T> Cell<T> {
    #[inline]
    pub fn new(v: sink T) -> Cell<T> { Cell { value: UnsafeCell::new(v) } }

    // Puts v in, dropping the old value.
    #[inline]
    pub fn set(self, v: sink T) {
        let old = self.replace(v);
        drop(old);
    }

    // Puts v in; the old value.
    #[inline]
    pub fn replace(self, v: sink T) -> T {
        let p = self.value.get();
        // UNSAFE: a raw move out of and into the cell (an assignment would drop).
        // SAFETY: see impl; the old value moves out and v in, neither dropped nor doubled.
        unsafe {
            let old = *p;
            *p = v;
            old
        }
    }

    // The value, when nothing else can reach the cell.
    #[inline]
    pub fn into_inner(sink self) -> T {
        let c = self;
        c.value.into_inner()
    }

    // The value's address (a write through it is the caller's business).
    #[inline]
    pub fn as_ptr(self) -> *T { self.value.get() }

    // Exchanges the values of two cells; nothing when they are one cell.
    pub fn swap(self, other: Cell<T>) {
        let a = self.value.get();
        let b = other.value.get();
        if a == b {
            return;
        }
        // UNSAFE: raw moves between the two cells (an assignment would drop).
        // SAFETY: see impl; a != b, so the two values are distinct and each ends
        // in exactly one cell.
        unsafe {
            let t = *a;
            *a = *b;
            *b = t;
        }
    }
}

impl<T: Copy> Cell<T> {
    // A copy of the value.
    #[inline]
    pub fn get(self) -> T {
        // UNSAFE: a read of the cell's value. SAFETY: see impl; T is Copy.
        unsafe { *self.value.get() }
    }

    // Puts f(the value) in.
    #[inline]
    pub fn update<F: Fn(T) -> T>(self, f: F) {
        let v = f(self.get());
        self.set(v);
    }
}

impl<T: Default> Cell<T> {
    // The value, leaving T's empty value.
    #[inline]
    pub fn take(self) -> T { self.replace(T::default()) }
}

// A new cell with a copy of the value.
impl<T: Copy> Clone for Cell<T> {
    fn clone(self) -> Cell<T> { Cell::new(self.get()) }
}

impl<T: Default> Default for Cell<T> {
    fn default() -> Cell<T> { Cell::new(T::default()) }
}

impl<T: Debug + Copy> Debug for Cell<T> {
    fn fmt_debug(self, f: inout Fmt) {
        f.str("Cell { value: ");
        f.debug(self.get());
        f.str(" }");
    }
}

impl<T: Eq + Copy> Eq for Cell<T> {
    fn eq(self, other: Cell<T>) -> bool { self.get().eq(other.get()) }
}

impl<T: Ord + Copy> Ord for Cell<T> {
    fn cmp(self, other: Cell<T>) -> i64 { self.get().cmp(other.get()) }
}
