// std::cell: Cell and UnsafeCell, Rust's API. A Cell is written through a
// shared reference (`&self`): it is how an Arena bumps its pointer behind
// the `&'a Arena<P>` every container holds (plan §2.1). Neither is Sync.
// RefCell and its guards wait for 0.29 (plan §6, the cuts).

use crate::clone::Clone;
use crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};
use crate::default::Default;
use crate::fmt::{Debug, Formatter};
use crate::option::Option;

// The one way to write through a & in safe code's types: what Cell, the
// allocators' counters and Atomic are made of. `get` gives a raw pointer;
// writing through it while a & to the value is live is undefined.
#[repr(transparent)]
pub struct UnsafeCell<T: ?Sized> {
    value: T,
}

impl<T> UnsafeCell<T> {
    #[effects()]
    pub fn new(value: T) -> UnsafeCell<T> {
        UnsafeCell { value: value }
    }

    #[effects()]
    pub fn into_inner(self) -> T {
        self.value
    }
}

impl<T: ?Sized> UnsafeCell<T> {
    // A pointer to the value, writable through a &self.
    // std2: changed: returns *mut T
    #[effects()]
    pub fn get(&self) -> *mut T {
        &self.value as *const T as *mut T
    }

    // The value, through an exclusive borrow: no unsafe needed.
    #[effects()]
    pub fn get_mut(&mut self) -> &mut T {
        &mut self.value
    }
}

// A value set and read through a &: by copy (`get`, T: Copy) or by moving
// it in and out (`set`, `replace`, `take`); never a reference into it.
#[repr(transparent)]
pub struct Cell<T: ?Sized> {
    value: UnsafeCell<T>,
}

// A Cell changes through `&self`, with no synchronization: never Sync
// (its UnsafeCell says the same; stated, as Rust's). Send when T is.
impl<T: ?Sized> !Sync for Cell<T> {}

impl<T> Cell<T> {
    #[effects(T)]
    pub fn new(value: T) -> Cell<T> {
        Cell { value: UnsafeCell::new(value) }
    }

    // Stores v (the old value is dropped).
    #[effects(T)]
    pub fn set(&self, v: T) {
        drop(self.replace(v));
    }

    // Exchanges the values of two cells.
    // std2: changed: takes &Cell<T>
    #[effects(unsafe, T)]
    pub fn swap(&self, other: &Cell<T>) {
        if crate::ptr::eq(self as *const Cell<T>, other as *const Cell<T>) {
            return;
        }
        // UNSAFE: writes both cells' values through their UnsafeCells.
        // SAFETY: a Cell never hands out a reference into its value, and it
        // is not Sync: no other access to either value is live during the
        // swap, and the two are distinct (checked above).
        unsafe { crate::mem::swap(&mut *self.value.get(), &mut *other.value.get()) }
    }

    // Stores v and returns the old value.
    #[effects(unsafe, T)]
    pub fn replace(&self, v: T) -> T {
        // UNSAFE: writes the value through the UnsafeCell.
        // SAFETY: a Cell never hands out a reference into its value, and it
        // is not Sync: this is the one access to it.
        crate::mem::replace(unsafe { &mut *self.value.get() }, v)
    }

    #[effects(T)]
    pub fn into_inner(self) -> T {
        self.value.into_inner()
    }
}

impl<T: Copy> Cell<T> {
    // A copy of the value.
    #[effects(unsafe, T)]
    pub fn get(&self) -> T {
        // UNSAFE: a read of the value through the UnsafeCell.
        // SAFETY: no &mut to the value exists (a Cell makes none); T is Copy.
        unsafe { *self.value.get() }
    }

    // Stores f(old value) (`c.update(|n| n + 1)`).
    // std2: changed: FnOnce, returns nothing (Rust 1.88)
    #[effects(T, F)]
    pub fn update<F: FnOnce(T) -> T>(&self, f: F) {
        self.set(f(self.get()));
    }
}

impl<T: ?Sized> Cell<T> {
    // A pointer to the value.
    // std2: changed: returns *mut T
    #[effects(T)]
    pub fn as_ptr(&self) -> *mut T {
        self.value.get()
    }

    // The value, through an exclusive borrow.
    #[effects(T)]
    pub fn get_mut(&mut self) -> &mut T {
        self.value.get_mut()
    }
}

impl<T: Default> Cell<T> {
    // Moves the value out, leaving its Default.
    #[effects(T)]
    pub fn take(&self) -> T {
        self.replace(T::default())
    }
}

impl<T: Copy> Clone for Cell<T> {
    fn clone(&self) -> Cell<T> {
        Cell::new(self.get())
    }
}

impl<T: Default> Default for Cell<T> {
    fn default() -> Cell<T> {
        Cell::new(T::default())
    }
}

impl<T: PartialEq + Copy> PartialEq for Cell<T> {
    fn eq(&self, other: &Cell<T>) -> bool {
        self.get() == other.get()
    }
}

impl<T: Eq + Copy> Eq for Cell<T> {}

impl<T: PartialOrd + Copy> PartialOrd for Cell<T> {
    fn partial_cmp(&self, other: &Cell<T>) -> Option<Ordering> {
        self.get().partial_cmp(&other.get())
    }
}

impl<T: Ord + Copy> Ord for Cell<T> {
    fn cmp(&self, other: &Cell<T>) -> Ordering {
        self.get().cmp(&other.get())
    }
}

impl<T: Debug + Copy> Debug for Cell<T> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.debug_struct("Cell").field("value", &self.get()).finish()
    }
}

impl<T> From<T> for Cell<T> {
    fn from(value: T) -> Cell<T> {
        Cell::new(value)
    }
}
