// std::sync::mpsc: channels between threads (0.21).

use std::{
    Clone, Debug, Display, Fmt, Option, Result, Vec, out_of_memory, sys_futex_wait, sys_futex_wake,
};
use std::sync::RawLock;
use std::sync::atomic::{AtomicU32, Ordering};

// ---- Channels (0.21) ----

// A channel (docs/design/concurrency.md §2.7): values sent through any of
// its Senders come out of its Receiver in the order they were sent. Rust's
// signatures: `send` fails (giving the value back) when the receiver is
// gone, `recv` fails when every sender is gone and nothing is left. The
// queue is two Vecs from the allocator given (an inbox the senders push
// to, an outbox the receiver pops, refilled from the inbox reversed); the
// shared state is a lock, counts and a word the receiver sleeps on (the
// number of sends and sender drops so far), from C's allocator.
//
//     let (tx, rx) = mpsc::channel_in(gpa);
//     tx.send(7).unwrap();
//     let x = rx.recv().unwrap();

struct Chan<T> {
    lock: RawLock,
    inbox: Vec<T>,
    outbox: Vec<T>,
    senders: AtomicU32,
    receiving: AtomicU32,
    // Bumped (release) by each send and each last sender's drop.
    seq: AtomicU32,
    // The Senders and the Receiver alive: the last one frees the channel.
    refs: AtomicU32,
}

// UNSAFE: C's allocator, which deals in raw pointers.
// SAFETY: malloc's and free's prototypes (stdlib.h); the shared state is
// allocated once (channel_in) and freed once, by the last end let go
// (chan_release).
extern "C" {
    #[link_name = "malloc"]
    fn chan_c_malloc(n: u64) -> *u8;
    #[link_name = "free"]
    fn chan_c_free(p: *u8);
}

// The sending end; clone it for more senders.
#[sealed]
pub struct Sender<T> { c: *Chan<T> }

// The receiving end.
#[sealed]
pub struct Receiver<T> { c: *Chan<T> }

// send's error: the receiver is gone; the value comes back.
pub struct SendError<T> { value: T }

impl<T> SendError<T> {
    // The value that was not sent.
    pub fn into_inner(sink self) -> T {
        let e = self;
        e.value
    }
}

impl<T> Debug for SendError<T> {
    fn fmt_debug(self, f: inout Fmt) {
        f.str("SendError(..)");
    }
}

impl<T> Display for SendError<T> {
    fn fmt(self, f: inout Fmt) {
        f.str("sending on a channel whose receiver is gone");
    }
}

// recv's error: every sender is gone and the channel is empty.
pub struct RecvError {}

impl Debug for RecvError {
    fn fmt_debug(self, f: inout Fmt) {
        f.str("RecvError");
    }
}

impl Display for RecvError {
    fn fmt(self, f: inout Fmt) {
        f.str("receiving on a channel whose senders are gone");
    }
}

// A channel; its two ends. The queue grows from gpa.
pub fn channel_in<T>(gpa: Gpa) -> (Sender<T>, Receiver<T>) {
    // UNSAFE: the shared state is C memory, written through a raw pointer.
    // SAFETY: malloc's result is checked non-null and has room for a
    // Chan<T> (malloc's alignment, 16, is at least Chan's, 8: it holds words and Vecs, not a T); `*c = ...`
    // writes it without dropping what was there (raw writes never drop);
    // refs is 2, one for each end returned.
    unsafe {
        let c = chan_c_malloc(size_of(Chan<T>) as u64) as *Chan<T>;
        if c == 0 as *Chan<T> {
            out_of_memory();
        }
        *c = Chan {
            lock: RawLock::new(), inbox: Vec::new_in(gpa), outbox: Vec::new_in(gpa),
            senders: AtomicU32::new(1), receiving: AtomicU32::new(1), seq: AtomicU32::new(0),
            refs: AtomicU32::new(2),
        };
        (Sender { c: c }, Receiver { c: c })
    }
}

// One end let go: the last one drops what is left and frees the channel.
// UNSAFE: reads and frees the shared state through its raw pointer.
// SAFETY: (the caller's obligation) c is the live channel of an end that
// holds one of its refs and gives it up here, once; the last one (refs
// reaching 0, AcqRel: every other end's accesses come before) moves the
// state out, frees the memory and drops the state.
unsafe fn chan_release<T>(c: *Chan<T>) {
    if (*c).refs.fetch_sub(1, Ordering::AcqRel) == 1 {
        let gone = *c;
        chan_c_free(c as *u8);
        drop(gone);
    }
}

impl<T> Sender<T> {
    // Sends x; Err(x back) when the receiver is gone.
    pub fn send(self, x: sink T) -> Result<(), SendError<T>> {
        // UNSAFE: the shared state through the Sender's raw pointer.
        // SAFETY: a Sender holds one of the channel's refs, so c is live;
        // the queue is touched only under its lock; the futex wakes on the
        // live seq word.
        unsafe {
            let c = self.c;
            (*c).lock.lock();
            if (*c).receiving.load(Ordering::Relaxed) == 0 {
                (*c).lock.unlock();
                return Err(SendError { value: x });
            }
            (*c).inbox.push(x);
            (*c).lock.unlock();
            (*c).seq.fetch_add(1, Ordering::Release);
            sys_futex_wake((*c).seq.as_ptr(), false);
            Ok(())
        }
    }
}

impl<T> Clone for Sender<T> {
    fn clone(self) -> Sender<T> {
        // UNSAFE: the shared state through the Sender's raw pointer.
        // SAFETY: self holds a ref, so c is live; the new Sender gets its
        // own ref (and counts as a sender) before it exists.
        unsafe {
            (*self.c).senders.fetch_add(1, Ordering::Relaxed);
            (*self.c).refs.fetch_add(1, Ordering::Relaxed);
        }
        Sender { c: self.c }
    }
}

impl<T> Drop for Sender<T> {
    fn drop(inout self) {
        // UNSAFE: the shared state through the Sender's raw pointer.
        // SAFETY: this Sender's ref keeps c live until chan_release, its
        // last use, gives the ref up (once: a Sender is dropped once).
        unsafe {
            let c = self.c;
            if (*c).senders.fetch_sub(1, Ordering::AcqRel) == 1 {
                // (the last one: a waiting receiver learns it)
                (*c).lock.lock();
                (*c).seq.fetch_add(1, Ordering::Release);
                (*c).lock.unlock();
                sys_futex_wake((*c).seq.as_ptr(), true);
            }
            chan_release(c);
        }
    }
}

impl<T> Receiver<T> {
    // The next value, waiting for one; Err when every sender is gone and
    // nothing is left.
    pub fn recv(self) -> Result<T, RecvError> {
        // UNSAFE: the shared state through the Receiver's raw pointer.
        // SAFETY: a Receiver holds one of the channel's refs, so c is live;
        // chan_pop runs under the lock; the futex waits on the live seq
        // word.
        unsafe {
            let c = self.c;
            loop {
                (*c).lock.lock();
                match chan_pop(c) {
                    Some(x) => {
                        (*c).lock.unlock();
                        return Ok(x);
                    }
                    None => {}
                }
                if (*c).senders.load(Ordering::Acquire) == 0 {
                    (*c).lock.unlock();
                    return Err(RecvError {});
                }
                let seen = (*c).seq.load(Ordering::Acquire);
                (*c).lock.unlock();
                sys_futex_wait((*c).seq.as_ptr(), seen);
            }
        }
    }

    // The next value if there is one now.
    pub fn try_recv(self) -> Option<T> {
        // UNSAFE: as recv.
        // SAFETY: as recv: c is live, chan_pop runs under the lock.
        unsafe {
            let c = self.c;
            (*c).lock.lock();
            let x = chan_pop(c);
            (*c).lock.unlock();
            x
        }
    }

    // The values, until every sender is gone: `for x in rx.iter()`.
    // (0.25.4) The iterator holds a ref of its own: it may outlive the
    // Receiver.
    pub fn iter(self) -> RecvIter<T> {
        // UNSAFE: the shared state through the Receiver's raw pointer.
        // SAFETY: self holds a ref, so c is live; the iterator gets its own
        // ref before it exists, given up by its Drop.
        unsafe { (*self.c).refs.fetch_add(1, Ordering::Relaxed); }
        RecvIter { c: self.c }
    }
}

// The next value of the queue (the lock held).
// UNSAFE: the queue through the channel's raw pointer.
// SAFETY: (the caller's obligation) c is live and the caller holds its
// lock, so no other thread touches the queue.
unsafe fn chan_pop<T>(c: *Chan<T>) -> Option<T> {
    if (*c).outbox.is_empty() {
        loop {
            match (*c).inbox.pop() {
                Some(x) => (*c).outbox.push(x),
                None => break,
            }
        }
    }
    (*c).outbox.pop()
}

impl<T> Drop for Receiver<T> {
    fn drop(inout self) {
        // UNSAFE: the shared state through the Receiver's raw pointer.
        // SAFETY: this Receiver's ref keeps c live until chan_release gives
        // it up (once).
        unsafe {
            let c = self.c;
            (*c).lock.lock();
            (*c).receiving.store(0, Ordering::Relaxed);
            (*c).lock.unlock();
            chan_release(c);
        }
    }
}

// Receiver::iter's iterator: recv until it fails. It holds one of the
// channel's refs (0.25.4), so it moves and is never copied.
#[sealed]
pub struct RecvIter<T> { c: *Chan<T> }

impl<T> Drop for RecvIter<T> {
    fn drop(inout self) {
        // UNSAFE: gives the iterator's ref up through its raw pointer.
        // SAFETY: the ref iter took keeps c live until here; an iterator is
        // dropped once.
        unsafe { chan_release(self.c); }
    }
}

impl<T> Iterator for RecvIter<T> {
    type Item = T;

    fn next(inout self) -> Option<T> {
        let r = Receiver { c: self.c };
        let x = r.recv();
        std::forget(r);
        match x {
            Ok(v) => Some(v),
            Err(_) => None,
        }
    }
}
