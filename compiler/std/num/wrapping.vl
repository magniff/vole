// ---- Integer arithmetic: the traits (0.26.3) ----

// Every integer type's `/`, `%` and pow wrapping, and its `+ - *`, unary
// `-`, shifts, `/`, `%` and pow checked (None when Rust's operator would
// panic), overflowing (the wrapped value, and whether it overflowed) and
// saturating (at the type's bounds).
pub trait IntOverflow {
    fn wrapping_div(self, rhs: Self) -> Self;
    fn wrapping_rem(self, rhs: Self) -> Self;
    fn wrapping_pow(self, exp: u32) -> Self;
    fn checked_add(self, rhs: Self) -> Option<Self>;
    fn checked_sub(self, rhs: Self) -> Option<Self>;
    fn checked_mul(self, rhs: Self) -> Option<Self>;
    fn checked_neg(self) -> Option<Self>;
    fn checked_shl(self, rhs: u32) -> Option<Self>;
    fn checked_shr(self, rhs: u32) -> Option<Self>;
    fn checked_div(self, rhs: Self) -> Option<Self>;
    fn checked_rem(self, rhs: Self) -> Option<Self>;
    fn checked_pow(self, exp: u32) -> Option<Self>;
    fn overflowing_add(self, rhs: Self) -> (Self, bool);
    fn overflowing_sub(self, rhs: Self) -> (Self, bool);
    fn overflowing_mul(self, rhs: Self) -> (Self, bool);
    fn overflowing_neg(self) -> (Self, bool);
    fn overflowing_shl(self, rhs: u32) -> (Self, bool);
    fn overflowing_shr(self, rhs: u32) -> (Self, bool);
    fn overflowing_div(self, rhs: Self) -> (Self, bool);
    fn overflowing_rem(self, rhs: Self) -> (Self, bool);
    fn overflowing_pow(self, exp: u32) -> (Self, bool);
    fn saturating_add(self, rhs: Self) -> Self;
    fn saturating_sub(self, rhs: Self) -> Self;
    fn saturating_mul(self, rhs: Self) -> Self;
    fn saturating_div(self, rhs: Self) -> Self;
    fn saturating_pow(self, exp: u32) -> Self;
}

// The signed types' too: |x| and -x wrapping, checked, overflowing or
// saturating.
pub trait SignedOverflow {
    fn wrapping_abs(self) -> Self;
    fn checked_abs(self) -> Option<Self>;
    fn overflowing_abs(self) -> (Self, bool);
    fn saturating_abs(self) -> Self;
    fn saturating_neg(self) -> Self;
}

// ---- Integer arithmetic: i8 (0.26.3) ----

impl IntOverflow for i8 {
    fn wrapping_div(self, rhs: i8) -> i8 {
        if rhs == -1 { 0 - self } else { self / rhs }
    }

    fn wrapping_rem(self, rhs: i8) -> i8 {
        if rhs == -1 { 0 } else { self % rhs }
    }

    fn wrapping_pow(self, exp: u32) -> i8 {
        var base = self;
        var e = exp;
        var out: i8 = 1;
        while e > 0 {
            if e & 1 != 0 {
                out = out * base;
            }
            e = e >> 1;
            if e > 0 {
                base = base * base;
            }
        }
        out
    }

    fn checked_add(self, rhs: i8) -> Option<i8> {
        let (r, o) = self.overflowing_add(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_sub(self, rhs: i8) -> Option<i8> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_mul(self, rhs: i8) -> Option<i8> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_neg(self) -> Option<i8> {
        let (r, o) = self.overflowing_neg();
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_shl(self, rhs: u32) -> Option<i8> {
        if rhs > 7 { Option::None } else { Option::Some(self << rhs) }
    }

    fn checked_shr(self, rhs: u32) -> Option<i8> {
        if rhs > 7 { Option::None } else { Option::Some(self >> rhs) }
    }

    fn checked_div(self, rhs: i8) -> Option<i8> {
        if rhs == 0 || self == i8::MIN && rhs == -1 { Option::None }
        else { Option::Some(self / rhs) }
    }

    fn checked_rem(self, rhs: i8) -> Option<i8> {
        if rhs == 0 || self == i8::MIN && rhs == -1 { Option::None }
        else { Option::Some(self % rhs) }
    }

    fn checked_pow(self, exp: u32) -> Option<i8> {
        let (r, o) = self.overflowing_pow(exp);
        if o { Option::None } else { Option::Some(r) }
    }

    fn overflowing_add(self, rhs: i8) -> (i8, bool) {
        let w = self as i64 + rhs as i64;
        let r = w as i8;
        (r, r as i64 != w)
    }

    fn overflowing_sub(self, rhs: i8) -> (i8, bool) {
        let w = self as i64 - rhs as i64;
        let r = w as i8;
        (r, r as i64 != w)
    }

    fn overflowing_mul(self, rhs: i8) -> (i8, bool) {
        let w = self as i64 * rhs as i64;
        let r = w as i8;
        (r, r as i64 != w)
    }

    fn overflowing_neg(self) -> (i8, bool) {
        (0 - self, self == i8::MIN)
    }

    fn overflowing_shl(self, rhs: u32) -> (i8, bool) {
        (self << (rhs & 7), rhs > 7)
    }

    fn overflowing_shr(self, rhs: u32) -> (i8, bool) {
        (self >> (rhs & 7), rhs > 7)
    }

    fn overflowing_div(self, rhs: i8) -> (i8, bool) {
        if self == i8::MIN && rhs == -1 { (self, true) } else { (self / rhs, false) }
    }

    fn overflowing_rem(self, rhs: i8) -> (i8, bool) {
        if self == i8::MIN && rhs == -1 { (0, true) } else { (self % rhs, false) }
    }

    fn overflowing_pow(self, exp: u32) -> (i8, bool) {
        var ovf = false;
        var base = self;
        var e = exp;
        var out: i8 = 1;
        while e > 0 {
            if e & 1 != 0 {
                let (r, o) = out.overflowing_mul(base);
                out = r;
                ovf = ovf || o;
            }
            e = e >> 1;
            if e > 0 {
                let (r, o) = base.overflowing_mul(base);
                base = r;
                ovf = ovf || o;
            }
        }
        (out, ovf)
    }

    fn saturating_add(self, rhs: i8) -> i8 {
        let (r, o) = self.overflowing_add(rhs);
        if !o { r } else if rhs < 0 { i8::MIN } else { i8::MAX }
    }

    fn saturating_sub(self, rhs: i8) -> i8 {
        let (r, o) = self.overflowing_sub(rhs);
        if !o { r } else if rhs > 0 { i8::MIN } else { i8::MAX }
    }

    fn saturating_mul(self, rhs: i8) -> i8 {
        let (r, o) = self.overflowing_mul(rhs);
        if !o { r } else if (self < 0) != (rhs < 0) { i8::MIN } else { i8::MAX }
    }

    fn saturating_div(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 { i8::MAX } else { self / rhs }
    }

    fn saturating_pow(self, exp: u32) -> i8 {
        let (r, o) = self.overflowing_pow(exp);
        if !o { r } else if self < 0 && exp % 2 == 1 { i8::MIN } else { i8::MAX }
    }
}

impl SignedOverflow for i8 {
    fn wrapping_abs(self) -> i8 {
        if self < 0 { 0 - self } else { self }
    }

    fn checked_abs(self) -> Option<i8> {
        if self == i8::MIN { Option::None } else { Option::Some(self.wrapping_abs()) }
    }

    fn overflowing_abs(self) -> (i8, bool) {
        (self.wrapping_abs(), self == i8::MIN)
    }

    fn saturating_abs(self) -> i8 {
        if self == i8::MIN { i8::MAX } else { self.wrapping_abs() }
    }

    fn saturating_neg(self) -> i8 {
        if self == i8::MIN { i8::MAX } else { 0 - self }
    }
}

