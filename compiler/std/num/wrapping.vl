// ---- Integer arithmetic: u32 (0.26.3) ----

impl IntOverflow for u32 {
    fn wrapping_div(self, rhs: u32) -> u32 {
        self / rhs
    }

    fn wrapping_rem(self, rhs: u32) -> u32 {
        self % rhs
    }

    fn wrapping_pow(self, exp: u32) -> u32 {
        var base = self;
        var e = exp;
        var out: u32 = 1;
        while e > 0 {
            if e & 1 != 0 {
                out = out * base;
            }
            e = e >> 1;
            if e > 0 {
                base = base * base;
            }
        }
        out
    }

    fn checked_add(self, rhs: u32) -> Option<u32> {
        let (r, o) = self.overflowing_add(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_sub(self, rhs: u32) -> Option<u32> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_mul(self, rhs: u32) -> Option<u32> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_neg(self) -> Option<u32> {
        let (r, o) = self.overflowing_neg();
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_shl(self, rhs: u32) -> Option<u32> {
        if rhs > 31 { Option::None } else { Option::Some(self << rhs) }
    }

    fn checked_shr(self, rhs: u32) -> Option<u32> {
        if rhs > 31 { Option::None } else { Option::Some(self >> rhs) }
    }

    fn checked_div(self, rhs: u32) -> Option<u32> {
        if rhs == 0 { Option::None } else { Option::Some(self / rhs) }
    }

    fn checked_rem(self, rhs: u32) -> Option<u32> {
        if rhs == 0 { Option::None } else { Option::Some(self % rhs) }
    }

    fn checked_pow(self, exp: u32) -> Option<u32> {
        let (r, o) = self.overflowing_pow(exp);
        if o { Option::None } else { Option::Some(r) }
    }

    fn overflowing_add(self, rhs: u32) -> (u32, bool) {
        let w = self as u64 + rhs as u64;
        let r = w as u32;
        (r, r as u64 != w)
    }

    fn overflowing_sub(self, rhs: u32) -> (u32, bool) {
        let w = self as u64 - rhs as u64;
        let r = w as u32;
        (r, r as u64 != w)
    }

    fn overflowing_mul(self, rhs: u32) -> (u32, bool) {
        let w = self as u64 * rhs as u64;
        let r = w as u32;
        (r, r as u64 != w)
    }

    fn overflowing_neg(self) -> (u32, bool) {
        (0 - self, self != 0)
    }

    fn overflowing_shl(self, rhs: u32) -> (u32, bool) {
        (self << (rhs & 31), rhs > 31)
    }

    fn overflowing_shr(self, rhs: u32) -> (u32, bool) {
        (self >> (rhs & 31), rhs > 31)
    }

    fn overflowing_div(self, rhs: u32) -> (u32, bool) {
        (self / rhs, false)
    }

    fn overflowing_rem(self, rhs: u32) -> (u32, bool) {
        (self % rhs, false)
    }

    fn overflowing_pow(self, exp: u32) -> (u32, bool) {
        var ovf = false;
        var base = self;
        var e = exp;
        var out: u32 = 1;
        while e > 0 {
            if e & 1 != 0 {
                let (r, o) = out.overflowing_mul(base);
                out = r;
                ovf = ovf || o;
            }
            e = e >> 1;
            if e > 0 {
                let (r, o) = base.overflowing_mul(base);
                base = r;
                ovf = ovf || o;
            }
        }
        (out, ovf)
    }

    fn saturating_add(self, rhs: u32) -> u32 {
        let (r, o) = self.overflowing_add(rhs);
        if o { u32::MAX } else { r }
    }

    fn saturating_sub(self, rhs: u32) -> u32 {
        let (r, o) = self.overflowing_sub(rhs);
        if o { 0 } else { r }
    }

    fn saturating_mul(self, rhs: u32) -> u32 {
        let (r, o) = self.overflowing_mul(rhs);
        if o { u32::MAX } else { r }
    }

    fn saturating_div(self, rhs: u32) -> u32 {
        self / rhs
    }

    fn saturating_pow(self, exp: u32) -> u32 {
        let (r, o) = self.overflowing_pow(exp);
        if o { u32::MAX } else { r }
    }
}

// ---- Integer arithmetic: u64 (0.26.3) ----

impl IntOverflow for u64 {
    fn wrapping_div(self, rhs: u64) -> u64 {
        self / rhs
    }

    fn wrapping_rem(self, rhs: u64) -> u64 {
        self % rhs
    }

    fn wrapping_pow(self, exp: u32) -> u64 {
        var base = self;
        var e = exp;
        var out: u64 = 1;
        while e > 0 {
            if e & 1 != 0 {
                out = out * base;
            }
            e = e >> 1;
            if e > 0 {
                base = base * base;
            }
        }
        out
    }

    fn checked_add(self, rhs: u64) -> Option<u64> {
        let (r, o) = self.overflowing_add(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_sub(self, rhs: u64) -> Option<u64> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_mul(self, rhs: u64) -> Option<u64> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_neg(self) -> Option<u64> {
        let (r, o) = self.overflowing_neg();
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_shl(self, rhs: u32) -> Option<u64> {
        if rhs > 63 { Option::None } else { Option::Some(self << rhs) }
    }

    fn checked_shr(self, rhs: u32) -> Option<u64> {
        if rhs > 63 { Option::None } else { Option::Some(self >> rhs) }
    }

    fn checked_div(self, rhs: u64) -> Option<u64> {
        if rhs == 0 { Option::None } else { Option::Some(self / rhs) }
    }

    fn checked_rem(self, rhs: u64) -> Option<u64> {
        if rhs == 0 { Option::None } else { Option::Some(self % rhs) }
    }

    fn checked_pow(self, exp: u32) -> Option<u64> {
        let (r, o) = self.overflowing_pow(exp);
        if o { Option::None } else { Option::Some(r) }
    }

    fn overflowing_add(self, rhs: u64) -> (u64, bool) {
        let r = self + rhs;
        (r, r < self)
    }

    fn overflowing_sub(self, rhs: u64) -> (u64, bool) {
        (self - rhs, self < rhs)
    }

    fn overflowing_mul(self, rhs: u64) -> (u64, bool) {
        (self * rhs, mul_hi(self as u64, rhs as u64) != 0)
    }

    fn overflowing_neg(self) -> (u64, bool) {
        (0 - self, self != 0)
    }

    fn overflowing_shl(self, rhs: u32) -> (u64, bool) {
        (self << (rhs & 63), rhs > 63)
    }

    fn overflowing_shr(self, rhs: u32) -> (u64, bool) {
        (self >> (rhs & 63), rhs > 63)
    }

    fn overflowing_div(self, rhs: u64) -> (u64, bool) {
        (self / rhs, false)
    }

    fn overflowing_rem(self, rhs: u64) -> (u64, bool) {
        (self % rhs, false)
    }

    fn overflowing_pow(self, exp: u32) -> (u64, bool) {
        var ovf = false;
        var base = self;
        var e = exp;
        var out: u64 = 1;
        while e > 0 {
            if e & 1 != 0 {
                let (r, o) = out.overflowing_mul(base);
                out = r;
                ovf = ovf || o;
            }
            e = e >> 1;
            if e > 0 {
                let (r, o) = base.overflowing_mul(base);
                base = r;
                ovf = ovf || o;
            }
        }
        (out, ovf)
    }

    fn saturating_add(self, rhs: u64) -> u64 {
        let (r, o) = self.overflowing_add(rhs);
        if o { u64::MAX } else { r }
    }

    fn saturating_sub(self, rhs: u64) -> u64 {
        let (r, o) = self.overflowing_sub(rhs);
        if o { 0 } else { r }
    }

    fn saturating_mul(self, rhs: u64) -> u64 {
        let (r, o) = self.overflowing_mul(rhs);
        if o { u64::MAX } else { r }
    }

    fn saturating_div(self, rhs: u64) -> u64 {
        self / rhs
    }

    fn saturating_pow(self, exp: u32) -> u64 {
        let (r, o) = self.overflowing_pow(exp);
        if o { u64::MAX } else { r }
    }
}

// ---- Integer arithmetic: usize (0.26.3) ----

impl IntOverflow for usize {
    fn wrapping_div(self, rhs: usize) -> usize {
        self / rhs
    }

    fn wrapping_rem(self, rhs: usize) -> usize {
        self % rhs
    }

    fn wrapping_pow(self, exp: u32) -> usize {
        var base = self;
        var e = exp;
        var out: usize = 1;
        while e > 0 {
            if e & 1 != 0 {
                out = out * base;
            }
            e = e >> 1;
            if e > 0 {
                base = base * base;
            }
        }
        out
    }

    fn checked_add(self, rhs: usize) -> Option<usize> {
        let (r, o) = self.overflowing_add(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_sub(self, rhs: usize) -> Option<usize> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_mul(self, rhs: usize) -> Option<usize> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_neg(self) -> Option<usize> {
        let (r, o) = self.overflowing_neg();
        if o { Option::None } else { Option::Some(r) }
    }

    fn checked_shl(self, rhs: u32) -> Option<usize> {
        if rhs > 63 { Option::None } else { Option::Some(self << rhs) }
    }

    fn checked_shr(self, rhs: u32) -> Option<usize> {
        if rhs > 63 { Option::None } else { Option::Some(self >> rhs) }
    }

    fn checked_div(self, rhs: usize) -> Option<usize> {
        if rhs == 0 { Option::None } else { Option::Some(self / rhs) }
    }

    fn checked_rem(self, rhs: usize) -> Option<usize> {
        if rhs == 0 { Option::None } else { Option::Some(self % rhs) }
    }

    fn checked_pow(self, exp: u32) -> Option<usize> {
        let (r, o) = self.overflowing_pow(exp);
        if o { Option::None } else { Option::Some(r) }
    }

    fn overflowing_add(self, rhs: usize) -> (usize, bool) {
        let r = self + rhs;
        (r, r < self)
    }

    fn overflowing_sub(self, rhs: usize) -> (usize, bool) {
        (self - rhs, self < rhs)
    }

    fn overflowing_mul(self, rhs: usize) -> (usize, bool) {
        (self * rhs, mul_hi(self as u64, rhs as u64) != 0)
    }

    fn overflowing_neg(self) -> (usize, bool) {
        (0 - self, self != 0)
    }

    fn overflowing_shl(self, rhs: u32) -> (usize, bool) {
        (self << (rhs & 63), rhs > 63)
    }

    fn overflowing_shr(self, rhs: u32) -> (usize, bool) {
        (self >> (rhs & 63), rhs > 63)
    }

    fn overflowing_div(self, rhs: usize) -> (usize, bool) {
        (self / rhs, false)
    }

    fn overflowing_rem(self, rhs: usize) -> (usize, bool) {
        (self % rhs, false)
    }

    fn overflowing_pow(self, exp: u32) -> (usize, bool) {
        var ovf = false;
        var base = self;
        var e = exp;
        var out: usize = 1;
        while e > 0 {
            if e & 1 != 0 {
                let (r, o) = out.overflowing_mul(base);
                out = r;
                ovf = ovf || o;
            }
            e = e >> 1;
            if e > 0 {
                let (r, o) = base.overflowing_mul(base);
                base = r;
                ovf = ovf || o;
            }
        }
        (out, ovf)
    }

    fn saturating_add(self, rhs: usize) -> usize {
        let (r, o) = self.overflowing_add(rhs);
        if o { usize::MAX } else { r }
    }

    fn saturating_sub(self, rhs: usize) -> usize {
        let (r, o) = self.overflowing_sub(rhs);
        if o { 0 } else { r }
    }

    fn saturating_mul(self, rhs: usize) -> usize {
        let (r, o) = self.overflowing_mul(rhs);
        if o { usize::MAX } else { r }
    }

    fn saturating_div(self, rhs: usize) -> usize {
        self / rhs
    }

    fn saturating_pow(self, exp: u32) -> usize {
        let (r, o) = self.overflowing_pow(exp);
