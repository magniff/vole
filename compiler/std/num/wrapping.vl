// std::num::wrapping (0.26.3): made by tools/intops/gen.py.

use std::num::mul_hi;

// ---- Integer arithmetic: wrapping (0.26.3) ----

// (decision 6) Rust's integer arithmetic that does not check, as each
// integer type's methods: `x.wrapping_add(y)`, `x.checked_mul(y)` (an
// Option), `x.overflowing_sub(y)` (the wrapped value and whether it
// overflowed), `x.saturating_add(y)`, with no `use`. This module's
// arithmetic never checks overflow (places/build.vl: std_wraps), whatever
// --overflow-checks says: `self + rhs` here is Rust's wrapping_add. `/`
// and `%` by zero panic here too, as Rust's wrapping_div does. Edit the
// generator, not this file.
//
// The wrapping `+ - *`, unary `-` and shifts (by a u32 amount): a section
// of their own, small and needing nothing, since std's hashes and PRNGs
// call them (index.awk: the rest is lazy).
pub trait IntWrapping {
    fn wrapping_add(self, rhs: Self) -> Self;
    fn wrapping_sub(self, rhs: Self) -> Self;
    fn wrapping_mul(self, rhs: Self) -> Self;
    fn wrapping_neg(self) -> Self;
    fn wrapping_shl(self, rhs: u32) -> Self;
    fn wrapping_shr(self, rhs: u32) -> Self;
}

impl IntWrapping for i8 {
    fn wrapping_add(self, rhs: i8) -> i8 {
        self + rhs
    }

    fn wrapping_sub(self, rhs: i8) -> i8 {
        self - rhs
    }

    fn wrapping_mul(self, rhs: i8) -> i8 {
        self * rhs
    }

    fn wrapping_neg(self) -> i8 {
        0 - self
    }

    fn wrapping_shl(self, rhs: u32) -> i8 {
        self << (rhs & 7)
    }

    fn wrapping_shr(self, rhs: u32) -> i8 {
        self >> (rhs & 7)
    }
}

