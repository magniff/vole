// EDITION: rust
// std::mem: moving values in and out of places, and the sizes of types.
// size_of, align_of and needs_drop are evaluated by the compiler; the
// others are plain functions over `&mut T`.

use crate::default::Default;

// Exchanges the values of two places (MVS: two inout parameters).
// std2: changed: takes &mut T twice
#[effects(unsafe, T)]
pub fn swap<T>(a: &mut T, b: &mut T) {
    // UNSAFE: raw moves (an assignment would drop the old value).
    // SAFETY: a and b are two live &mut, so valid, aligned and distinct;
    // each value is read once and ends in exactly one place.
    unsafe {
        let pa = a as *mut T;
        let pb = b as *mut T;
        let t = crate::ptr::read(pa as *const T);
        crate::ptr::copy_nonoverlapping(pb as *const T, pa, 1);
        crate::ptr::write(pb, t);
    }
}

// Moves src into dest and returns dest's old value.
// std2: changed: takes &mut T
#[effects(unsafe, T)]
pub fn replace<T>(dest: &mut T, src: T) -> T {
    // UNSAFE: a raw move out and in (an assignment would drop the old value).
    // SAFETY: dest is a live &mut: valid and aligned; its old value is
    // read once, returned, and overwritten without a drop.
    unsafe {
        let p = dest as *mut T;
        let old = crate::ptr::read(p as *const T);
        crate::ptr::write(p, src);
        old
    }
}

// Moves dest's value out, leaving its Default (`take(&mut v)` on an
// allocator-free type; a Vec has no Default, and Vec::take, inherent,
// leaves an empty Vec on a clone of its allocator).
// std2: changed: takes &mut T
#[effects(T)]
pub fn take<T: Default>(dest: &mut T) -> T {
    replace(dest, T::default())
}

// Ends x's life here: its Drop runs now, not at the end of its scope.
#[effects(T)]
pub fn drop<T>(x: T) {}

// Ends x's life without running its Drop: what it owns is leaked (unless
// something else frees it). Safe, as in Rust: a leak is not undefined.
#[effects()]
pub fn forget<T>(x: T) {
    // Built in: the compiler keeps std's `forget`'s parameter undropped
    // (MVS's forget is the same empty body).
}

// The size of a T in bytes, padding included (built in).
#[effects()]
pub fn size_of<T>() -> usize {
    size_of(T) as usize
}

// The alignment of a T in bytes (built in).
#[effects()]
pub fn align_of<T>() -> usize {
    align_of(T) as usize
}

// The size of the value x refers to (for str and [T], from its length).
#[effects()]
pub fn size_of_val<T: ?Sized>(x: &T) -> usize {
    size_of(T) as usize
}

// Whether dropping a T runs code: a Drop impl, or a part with one. For a
// container on an allocator that does not free (Allocator::FREES false:
// an arena, a FixedBuf), only its elements count (plan §9.1): an arena's
// `alloc(x)` takes a T for which this is false (built in).
#[effects()]
pub fn needs_drop<T: ?Sized>() -> bool {
    // Built in: the compiler folds the call to its constant (MVS's body
    // is the same `false`).
    false
}

// A T whose drop does not run unless asked (`ManuallyDrop::drop`), as
// Rust's: a union over the T, whose field a union never drops (F19.7).
// std2: changed: a union (Rust's is a struct the compiler knows)
pub union ManuallyDrop<T> {
    value: T,
}

impl<T> ManuallyDrop<T> {
    // value, kept from being dropped.
    #[effects()]
    pub fn new(value: T) -> ManuallyDrop<T> {
        ManuallyDrop { value: value }
    }

    // The value back, its drop the caller's again.
    #[effects(unsafe)]
    pub fn into_inner(slot: ManuallyDrop<T>) -> T {
        // UNSAFE: a union's field read out.
        // SAFETY: value is its one field, written by new; the read moves
        // the union, so the value has one owner.
        unsafe { slot.value }
    }

    // Moves the value out, leaving slot's bits as they are.
    #[effects(unsafe, T)]
    // UNSAFE: the value leaves a slot that still holds its bits.
    // SAFETY: a contract on the caller: slot is not used again (read,
    // taken or dropped) unless a value is written back.
    pub unsafe fn take(slot: &mut ManuallyDrop<T>) -> T {
        crate::ptr::read(&slot.value as *const T)
    }

    // Runs the value's drop in place.
    #[effects(unsafe, T)]
    // UNSAFE: drops a value the slot still holds the bits of.
    // SAFETY: a contract on the caller: slot is not used again (read,
    // taken or dropped) unless a value is written back.
    pub unsafe fn drop(slot: &mut ManuallyDrop<T>) {
        crate::ptr::drop_in_place(&mut slot.value as *mut T)
    }
}

impl<T> crate::ops::Deref for ManuallyDrop<T> {
    type Target = T;

    fn deref(&self) -> &T {
        // UNSAFE: a union's field read by reference.
        // SAFETY: value is the one field, written by new.
        unsafe { &self.value }
    }
}

impl<T> crate::ops::DerefMut for ManuallyDrop<T> {
    fn deref_mut(&mut self) -> &mut T {
        // UNSAFE: a union's field borrowed mutably.
        // SAFETY: value is the one field, written by new.
        unsafe { &mut self.value }
    }
}

// Zero bytes, 8-aligned, that zeroed reads a value from.
static ZEROS: [u64; 512] = [0; 512];

// A T whose bytes are all zero, as Rust's (for C's structs, filled by the
// call they are passed to). vole's limits: a T of at most 4096 bytes and
// an alignment of at most 8 (it is read from a static of zeros); a larger
// one panics.
// UNSAFE: all-zero bytes are not a value of every type (a reference, a
// Box, an enum without a zero variant).
// SAFETY: (the caller's) all-zero bytes are a valid T, as Rust's zeroed
// asks.
#[effects(panic, diverge, unsafe, T)]
pub unsafe fn zeroed<T>() -> T {
    if size_of::<T>() > 4096 || align_of::<T>() > 8 {
        crate::panic::panic(
            "std::mem::zeroed: the type is larger than 4096 bytes or aligned over 8");
    }
    crate::ptr::read(ZEROS.as_ptr() as *const T)
}
