// std::cli (0.24, docs/design/cli.md, guide cli): a command-line parser,
// clap's builder without derive (the overview: below the first banner).
// The rust edition's (0.27.5): names, help and the words parsed are
// `&'a str` views, so Arg, Command, Matches and CliError carry the
// lifetime of the text they were given; counts and widths are usize and
// a short form is a char, as clap's (indices_of's are i64s, as MVS's).
// mvs: std::cli

use crate::alloc::Allocator;
use crate::clone::Clone;
use crate::fmt::{Debug, Display, Formatter};
use crate::iter::Iterator;
use crate::option::Option;
use crate::result::Result;
use crate::str::FromStr;
use crate::string::String;
use crate::vec::Vec;

// ---- Arguments and commands (0.24) ----

// A Command lists its arguments (flags, options with a value,
// positionals) and subcommands; `cmd.parse(args)`
// gives the Matches, or a CliError that `cmd.exit(e)` prints with the
// usage line (exit code 2; 0 for --help and --version).
//
//     let cmd = Command::new_in("grep", gpa).version("1.0")
//         .arg(Arg::flag("count").short('c').help("count the matches"))
//         .arg(Arg::option("max").short('m').value_name("N").default("0"))
//         .arg(Arg::positional("pattern").required())
//         .arg(Arg::positional("file").multiple());
//     let m = cmd.parse_or_exit(env::args());
//     let n = m.get_as::<i64>("max").unwrap_or(0);
//
// Accepted: `-v`, `-vvv` (m.count), `-abc` (a cluster of short flags;
// an option in it takes the rest, `-ofile`), `-o FILE`, `--out FILE`,
// `--out=FILE`, `--` (everything after it is positional), `-` (a
// positional). An option takes the next argument as its value even when
// it starts with '-' (`--n -5`). An option given twice keeps both values
// (m.values; m.get: the last). A positional takes one value, or every one
// left with `.multiple()`. A subcommand's name ends its parent's
// arguments; its own follow.
//
// (0.25.2) Clap's too: `.global()` (an argument the subcommands accept),
// `.alias(s)` and `.hide()` (of an Arg and of a Command), `.num_values(n)`
// (`--overlay PATH COPY`), `.default_missing(s)` (`--stats`,
// `--stats=x`), `.allow_hyphen_values()` (a positional `-> bool`),
// `.last()` (the words after `--`), `.conflicts_with(name)` and
// `Command::subcommand_required()`.
//
// Parsing is pure but for its allocation: the definition is on the Gpa
// given to Command::new_in, the Matches on the Gpa or on the allocator
// given to parse_in (an arena: `arena_scope(gpa, |a| { let m =
// cmd.parse_in(args, a)?; .. })`). Help and error text are built in a
// scoped arena when cmd.exit prints them. Only exit and parse_or_exit do
// io.

const FLAG: i64 = 0;
const OPTION: i64 = 1;
const POSITIONAL: i64 = 2;

// One argument of a command: a flag (`-v`, `--verbose`), an option with a
// value (`-o FILE`, `--out FILE`, `--out=FILE`) or a positional, made by
// Arg::flag, Arg::option or Arg::positional; each method returns the
// changed Arg. Its name is what Matches asks for (`m.flag("verbose")`);
// a flag's or option's long form is its name unless `.long(..)`.
#[derive(Clone, Copy)]
pub struct Arg<'a> {
    name: &'a str,
    kind: i64,
    short: char,
    long: &'a str,
    help: &'a str,
    value_name: &'a str,
    default: &'a str,
    has_default: bool,
    required: bool,
    multiple: bool,
    // (0.25) the values it takes, `fast|slow` ("": any)
    choices: &'a str,
    cmd: i64,
    // (0.25.2) accepted by the subcommands too; its other long names; not
    // in the help; how many values an option takes; the value of an
    // option given without one; values starting with '-'; a positional
    // after `--`; the arguments it cannot be given with
    global: bool,
    aliases: Names<'a>,
    hidden: bool,
    num_values: i64,
    missing: &'a str,
    has_missing: bool,
    hyphen: bool,
    last: bool,
    conflicts: Names<'a>,
}

// (0.25.2) Up to 4 names (aliases, conflicts), each one or several
// separated by '|': a plain value of views, no allocation.
#[derive(Clone, Copy)]
struct Names<'a> {
    a: &'a str,
    b: &'a str,
    c: &'a str,
    d: &'a str,
    n: i64,
}

impl<'a> Names<'a> {
    fn none() -> Names<'a> {
        Names { a: "", b: "", c: "", d: "", n: 0 }
    }

    fn put(&mut self, s: &'a str) {
        if self.n == 0 {
            self.a = s;
        } else if self.n == 1 {
            self.b = s;
        } else if self.n == 2 {
            self.c = s;
        } else if self.n == 3 {
            self.d = s;
        } else {
            crate::panic::panic("std::cli: at most 4 alias or conflicts_with calls per Arg or Command (one may list several: \"a|b\")");
        }
        self.n += 1;
    }

    fn name_at(self, i: i64) -> &'a str {
        if i == 0 { self.a } else if i == 1 { self.b } else if i == 2 { self.c } else { self.d }
    }

    // Whether word is one of them.
    fn has(self, word: &str) -> bool {
        for i in 0..self.n {
            for w in self.name_at(i).split('|') {
                if w == word {
                    return true;
                }
            }
        }
        false
    }

    // The distance from word to the nearest of them (64: none).
    fn nearest(self, word: &str) -> i64 {
        let mut bd: i64 = 64;
        for i in 0..self.n {
            for w in self.name_at(i).split('|') {
                let d = distance(word, w);
                if d < bd {
                    bd = d;
                }
            }
        }
        bd
    }
}

impl<'a> Arg<'a> {
    fn make(name: &'a str, kind: i64) -> Arg<'a> {
        let mut long: &'a str = name;
        if kind == POSITIONAL {
            long = "";
        }
        Arg {
            name: name, kind: kind, short: '\0', long: long, help: "", value_name: "",
            default: "", has_default: false, required: false, multiple: false, choices: "",
            cmd: 0, global: false, aliases: Names::none(), hidden: false, num_values: 1,
            missing: "", has_missing: false, hyphen: false, last: false,
            conflicts: Names::none(),
        }
    }

    // A flag, `--NAME` (and `.short('x')`): m.flag(name), m.count(name).
    #[effects()]
    pub fn flag(name: &'a str) -> Arg<'a> {
        Arg::make(name, FLAG)
    }

    // An option with a value, `--NAME VALUE` or `--NAME=VALUE`: m.get(name).
    #[effects()]
    pub fn option(name: &'a str) -> Arg<'a> {
        Arg::make(name, OPTION)
    }

    // A positional argument, in the order of the command's `.arg` calls.
    #[effects()]
    pub fn positional(name: &'a str) -> Arg<'a> {
        Arg::make(name, POSITIONAL)
    }

    // Its one-letter form, `-c`.
    // std: changed: a char, as clap's (MVS: a byte)
    #[effects()]
    pub fn short(mut self, c: char) -> Arg<'a> {
        self.short = c;
        self
    }

    // Its long form, `--s`, instead of its name (`""`: none).
    #[effects()]
    pub fn long(mut self, s: &'a str) -> Arg<'a> {
        self.long = s;
        self
    }

    // Its line in the help.
    #[effects()]
    pub fn help(mut self, s: &'a str) -> Arg<'a> {
        self.help = s;
        self
    }

    // The name of an option's value in the help, `--out <FILE>` (the name
    // in capitals by default).
    #[effects()]
    pub fn value_name(mut self, s: &'a str) -> Arg<'a> {
        self.value_name = s;
        self
    }

    // The value when it is not given (m.get gives it; m.flag stays false).
    #[effects()]
    pub fn default(mut self, s: &'a str) -> Arg<'a> {
        self.default = s;
        self.has_default = true;
        self
    }

    // An error when it is not given.
    #[effects()]
    pub fn required(mut self) -> Arg<'a> {
        self.required = true;
        self
    }

    // A positional that takes every value left (m.values).
    #[effects()]
    pub fn multiple(mut self) -> Arg<'a> {
        self.multiple = true;
        self
    }

    // (0.25) The values it takes, `"fast|slow"`: another is an InvalidValue
    // error (`try: --mode <fast|slow>`); the help shows them.
    #[effects()]
    pub fn choices(mut self, s: &'a str) -> Arg<'a> {
        self.choices = s;
        self
    }

    // (0.25.2) A flag or option of a command that its subcommands accept
    // too, at any depth, before or after their names (`prog --root D sub`,
    // `prog sub --root D`); every level's Matches reads it.
    #[effects()]
    pub fn global(mut self) -> Arg<'a> {
        self.global = true;
        self
    }

    // (0.25.2) Another long name, `--s` (called again: more; `"a|b"`: two);
    // not in the help; the did-you-mean suggests the Arg's own.
    #[effects(panic)]
    pub fn alias(mut self, s: &'a str) -> Arg<'a> {
        self.aliases.put(s);
        self
    }

    // (0.25.2) Accepted, but not in the help (a deprecated spelling).
    #[effects()]
    pub fn hide(mut self) -> Arg<'a> {
        self.hidden = true;
        self
    }

    // (0.25.2) An option taking n values, `--overlay PATH COPY`: m.values
    // gives them in order, n more each time it is given; fewer is a
    // MissingValue error. Their names in the help: `.value_name("PATH
    // COPY")`.
    // std: changed: a usize (MVS: i64)
    #[effects()]
    pub fn num_values(mut self, n: usize) -> Arg<'a> {
        self.num_values = if n < 1 { 1 } else { n as i64 };
        self
    }

    // (0.25.2) An option whose value is optional: `--stats` alone gives s,
    // `--stats=x` (or `-s=x`) gives x; only the `=` form gives it one.
    #[effects()]
    pub fn default_missing(mut self, s: &'a str) -> Arg<'a> {
        self.missing = s;
        self.has_missing = true;
        self
    }

    // (0.25.2) Its values may start with '-': a positional so marked takes
    // a word starting with '-' that is no option of the command (`grep
    // '-> bool'`). (An option takes its next argument as its value
    // anyway.)
    #[effects()]
    pub fn allow_hyphen_values(mut self) -> Arg<'a> {
        self.hyphen = true;
        self
    }

    // (0.25.2) A positional that takes only the words after `--`: `probe
    // FILE:LINE EXPR... -- ARGS...` (EXPR multiple, ARGS multiple and
    // last).
    #[effects()]
    pub fn last(mut self) -> Arg<'a> {
        self.last = true;
        self
    }

    // (0.25.2) Given together with the argument named name (either way
    // round) is an ArgumentConflict error. Called again: more names.
    #[effects(panic)]
    pub fn conflicts_with(mut self, name: &'a str) -> Arg<'a> {
        self.conflicts.put(name);
        self
    }

    // Whether it is called word on the command line (`--word`).
    fn long_is(self, word: &str) -> bool {
        self.kind != POSITIONAL && (self.long.len() as i64 > 0 && self.long == word
            || self.aliases.has(word))
    }
}

// Whether v is one of choices (`fast|slow`; "": any).
fn chosen(v: &str, choices: &str) -> bool {
    if choices.len() as i64 == 0 {
        return true;
    }
    for c in choices.split('|') {
        if c == v {
            return true;
        }
    }
    false
}

// A command of the tree: its subcommands are those whose parent it is.
#[derive(Clone, Copy)]
struct Cmd<'a> {
    name: &'a str,
    about: &'a str,
    version: &'a str,
    parent: i64,
    // (0.25.2) its other names; not in the help; no subcommand an error
    aliases: Names<'a>,
    hidden: bool,
    sub_required: bool,
}

// A program's command line: its name, arguments and subcommands. The
// tree is kept flat, every command in `cmds` (the first is this one) and
// every argument in `args` with its command's index.
pub struct Command<'a, CA: Allocator> {
    cmds: Vec<Cmd<'a>, CA>,
    args: Vec<Arg<'a>, CA>,
    width: i64,
    // (0.25: any allocator, an arena too; before, the Gpa)
    alloc: CA,
}

impl<'a, CA: Allocator + Clone> Command<'a, CA> {
    // A command named name, its definition on allocator a (the Gpa, or an
    // arena: 0.25).
    #[effects(CA)]
    pub fn new_in(name: &'a str, a: CA) -> Command<'a, CA> {
        let mut cmds: Vec<Cmd<'a>, CA> = Vec::new_in(a.clone());
        cmds.push(Cmd {
            name: name, about: "", version: "", parent: -1, aliases: Names::none(),
            hidden: false, sub_required: false,
        });
        Command { cmds: cmds, args: Vec::new_in(a.clone()), width: 80, alloc: a }
    }

    // The help's line under the name.
    #[effects(panic, CA)]
    pub fn about(mut self, s: &'a str) -> Command<'a, CA> {
        self.cmds[0].about = s;
        self
    }

    // Its version: `--version` (and `-V`) print `NAME VERSION`.
    #[effects(panic, CA)]
    pub fn version(mut self, s: &'a str) -> Command<'a, CA> {
        self.cmds[0].version = s;
        self
    }

    // The help's width in columns (80).
    // std: changed: a usize (MVS: i64)
    #[effects()]
    pub fn width(mut self, n: usize) -> Command<'a, CA> {
        self.width = n as i64;
        self
    }

    // (0.25.2) Another name of this subcommand (called again: more;
    // `"a|b"`: two); m.subcommand() gives its own name.
    #[effects(panic, CA)]
    pub fn alias(mut self, s: &'a str) -> Command<'a, CA> {
        self.cmds[0].aliases.put(s);
        self
    }

    // (0.25.2) A subcommand accepted, but not in its parent's help.
    #[effects(panic, CA)]
    pub fn hide(mut self) -> Command<'a, CA> {
        self.cmds[0].hidden = true;
        self
    }

    // (0.25.2) No subcommand given is a MissingSubcommand error (its try:
    // line names them).
    #[effects(panic, CA)]
    pub fn subcommand_required(mut self) -> Command<'a, CA> {
        self.cmds[0].sub_required = true;
        self
    }

    // Adds an argument.
    #[effects(CA)]
    pub fn arg(mut self, a: Arg<'a>) -> Command<'a, CA> {
        let mut x = a;
        x.cmd = 0;
        self.args.push(x);
        self
    }

    // Adds a subcommand: `prog NAME ...`, m.subcommand().
    #[effects(panic, CA)]
    pub fn subcommand(mut self, sub: Command<'a, CA>) -> Command<'a, CA> {
        let base = self.cmds.len() as i64;
        for i in 0..sub.cmds.len() as i64 {
            let mut c = sub.cmds[i as usize];
            c.parent = if c.parent < 0 { 0 } else { c.parent + base };
            self.cmds.push(c);
        }
        for i in 0..sub.args.len() as i64 {
            let mut a = sub.args[i as usize];
            a.cmd = a.cmd + base;
            self.args.push(a);
        }
        self
    }

    // The subcommand of c named name, or -1.
    fn sub_named(&self, c: i64, name: &str) -> i64 {
        for i in 1..self.cmds.len() as i64 {
            if self.cmds[i as usize].parent == c
                && (self.cmds[i as usize].name == name || self.cmds[i as usize].aliases.has(name)) {
                return i;
            }
        }
        -1
    }

    // (0.25.2) Whether argument a is one of command c's: its own, or a
    // global one of c's parent, grandparent...
    fn of_cmd(&self, a: Arg<'a>, c: i64) -> bool {
        if a.cmd == c {
            return true;
        }
        if !a.global || a.kind == POSITIONAL {
            return false;
        }
        let mut p = self.cmds[c as usize].parent;
        while p >= 0 {
            if p == a.cmd {
                return true;
            }
            p = self.cmds[p as usize].parent;
        }
        false
    }

    // The command of Matches level `level`.
    fn cmds_of<A: Allocator + Clone>(&self, level: i64, m: &Matches<'a, A>) -> i64 {
        m.cmds[level as usize]
    }

    fn has_subs(&self, c: i64) -> bool {
        for i in 1..self.cmds.len() as i64 {
            if self.cmds[i as usize].parent == c {
                return true;
            }
        }
        false
    }
}

// ---- Parsing (0.24) ----

// What went wrong, or what was asked instead of a run: --help and
// --version are CliErrors too, whose exit code is 0.
#[derive(Clone, Copy, PartialEq, Eq, Debug)]
pub enum CliErrorKind {
    Help,
    Version,
    UnknownOption,
    UnknownCommand,
    UnexpectedArgument,
    MissingValue,
    FlagValue,
    MissingRequired,
    InvalidValue,
    // (0.25) a program's own: CliError::custom
    Custom,
    // (0.25.2) no subcommand given to a Command::subcommand_required
    MissingSubcommand,
    // (0.25.2) two arguments given that Arg::conflicts_with keeps apart
    ArgumentConflict,
}

// An error of parse (or Matches::get_as): Display gives its two lines,
// `error: ...` and `try: ...`; cmd.exit(e) prints them with the usage line
// (or the help, the version) and exits with e.exit_code().
#[derive(Clone, Copy)]
pub struct CliError<'a> {
    pub kind: CliErrorKind,
    // the argument as given ('--outt', '-vx', the bad value)
    pub text: &'a str,
    // the command it is about (cmd.render_in prints its usage)
    cmd: i64,
    // an unknown short option inside a cluster (`-x` of `-vx`)
    short: char,
    // the argument it is about
    arg: Arg<'a>,
    // did you mean: a long option (`--` before it) or a command
    hint: &'a str,
    hint_long: bool,
    // (0.25.2) ArgumentConflict: the other argument as given (`other_short`:
    // a letter of a cluster)
    other: &'a str,
    other_short: char,
}

impl<'a> CliError<'a> {
    fn new(kind: CliErrorKind, cmd: i64, text: &'a str) -> CliError<'a> {
        CliError {
            kind: kind, text: text, cmd: cmd, short: '\0', arg: Arg::make("", FLAG), hint: "",
            hint_long: false, other: "", other_short: '\0',
        }
    }

    fn of(kind: CliErrorKind, cmd: i64, text: &'a str, a: Arg<'a>) -> CliError<'a> {
        let mut e = CliError::new(kind, cmd, text);
        e.arg = a;
        e
    }

    // (0.25) A program's own error, in std::cli's form: `error: MESSAGE`,
    // `try: TRY` (none when ""), then the usage line (cmd.exit(e), exit
    // code 2): `CliError::custom("-b and -t together", "-b FILE")`.
    #[effects()]
    pub fn custom(message: &'a str, try_line: &'a str) -> CliError<'a> {
        let mut e = CliError::new(CliErrorKind::Custom, 0, message);
        e.hint = try_line;
        e
    }

    // (0.25) The unknown letter of a cluster (`x` of `-vx`), else 0.
    // std: changed: a char ('\0': none; MVS: a byte, 0)
    #[effects()]
    pub fn letter(self) -> char {
        self.short
    }

    // 0 for --help and --version, else 2 (a usage error, as clap's).
    #[effects()]
    pub fn exit_code(self) -> i32 {
        match self.kind {
            CliErrorKind::Help => 0,
            CliErrorKind::Version => 0,
            _ => 2,
        }
    }
}

// How an argument is written: `--out <FILE>`, `-o <FILE>`, `--verbose`,
// `<input>`, `<file>...`.
#[derive(Clone, Copy)]
struct Spell<'a> {
    a: Arg<'a>,
}

impl Display for Spell<'_> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        let a = self.a;
        if a.kind == POSITIONAL {
            f.write_char('<')?;
            // (0.25: its value_name, when it has one)
            f.write_str((if a.value_name.len() as i64 > 0 { a.value_name } else { a.name }))?;
            f.write_char('>')?;
            if a.multiple {
                f.write_str("...")?;
            }
            return Ok(());
        }
        if a.long.len() as i64 > 0 {
            f.write_str("--")?;
            f.write_str(a.long)?;
        } else {
            f.write_char('-')?;
            f.write_char(a.short as char)?;
        }
        if a.kind == OPTION {
            // (0.25.2) an optional value: `--stats[=<STATS>]`
            f.write_str((if a.has_missing { "[=" } else { " " }))?;
            write(f, "{}", (ValueName { a: a }))?;
            if a.has_missing {
                f.write_char(']')?;
            }
        }
        Ok(())
    }
}

// `<FILE>`: an option's value name, or its name in capitals.
#[derive(Clone, Copy)]
struct ValueName<'a> {
    a: Arg<'a>,
}

impl Display for ValueName<'_> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        if self.a.num_values > 1 {
            // (0.25.2) `<PATH> <COPY>`: value_name's words (the last
            // repeated), else the name n times
            let mut k: i64 = 0;
            let mut last: &str = "";
            for w in self.a.value_name.split(' ') {
                if w.len() as i64 > 0 && k < self.a.num_values {
                    if k > 0 {
                        f.write_char(' ')?;
                    }
                    f.write_char('<')?;
                    f.write_str(w)?;
                    f.write_char('>')?;
                    last = w;
                    k += 1;
                }
            }
            while k < self.a.num_values {
                if k > 0 {
                    f.write_char(' ')?;
                }
                if last.len() as i64 > 0 {
                    f.write_char('<')?;
                    f.write_str(last)?;
                    f.write_char('>')?;
                } else {
                    let mut one = self.a;
                    one.num_values = 1;
                    write(f, "{}", (ValueName { a: one }))?;
                }
                k += 1;
            }
            return Ok(());
        }
        f.write_char('<')?;
        if self.a.value_name.len() as i64 > 0 {
            f.write_str(self.a.value_name)?;
        } else if self.a.choices.len() as i64 > 0 {
            f.write_str(self.a.choices)?;
        } else {
            for c in self.a.name.bytes() {
                f.write_char((if c >= b'a' && c <= b'z' { c - 32 } else if c == b'-' { b'_' }
                    else { c }) as char)?;
            }
        }
        f.write_char('>')?;
        Ok(())
    }
}

// std: changed: Debug, which `unwrap` needs (MVS's Result had no bound):
// the kind and the argument as given, `CliError { kind: UnknownOption,
// text: "--outt" }`.
impl Debug for CliError<'_> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        f.write_str("CliError { kind: ")?;
        Debug::fmt(&self.kind, f)?;
        f.write_str(", text: ")?;
        Debug::fmt(self.text, f)?;
        f.write_str(" }")
    }
}

impl Display for CliError<'_> {
    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {
        let sp = Spell { a: self.arg };
        match self.kind {
            CliErrorKind::Help => f.write_str("help requested: cmd.exit(e) prints it")?,
            CliErrorKind::Version => f.write_str("version requested: cmd.exit(e) prints it")?,
            CliErrorKind::UnknownOption => {
                f.write_str("error: unknown option '")?;
                if self.short != '\0' {
                    f.write_char('-')?;
                    f.write_char(self.short)?;
                    if self.text.len() as i64 > 2 {
                        f.write_str("' in '")?;
                        f.write_str(self.text)?;
                    }
                } else {
                    f.write_str(self.text)?;
                }
                f.write_str("'\ntry: ")?;
                if self.hint.len() as i64 > 0 {
                    if self.hint_long {
                        f.write_str("--")?;
                    }
                    f.write_str(self.hint)?;
                } else {
                    f.write_str("--help")?;
                }
            }
            CliErrorKind::UnknownCommand => {
                f.write_str("error: unknown command '")?;
                f.write_str(self.text)?;
                f.write_str("'\ntry: ")?;
                f.write_str((if self.hint.len() as i64 > 0 { self.hint } else { "--help" }))?;
            }
            CliErrorKind::UnexpectedArgument => {
                f.write_str("error: unexpected argument '")?;
                f.write_str(self.text)?;
                f.write_str("'\ntry: --help")?;
            }
            CliErrorKind::MissingValue => {
                f.write_str("error: option '")?;
                if self.short != '\0' {
                    f.write_char('-')?;
                    f.write_char(self.short)?;
                } else {
                    f.write_str(self.text)?;
                }
                f.write_str("' needs a value\ntry: ")?;
                write(f, "{}", sp)?;
            }
            CliErrorKind::FlagValue => {
                f.write_str("error: flag '")?;
                write(f, "{}", sp)?;
                f.write_str("' takes no value\ntry: ")?;
                write(f, "{}", sp)?;
            }
            CliErrorKind::MissingRequired => {
                f.write_str((if self.arg.kind == POSITIONAL { "error: missing argument '" }
                    else { "error: missing option '" }))?;
                write(f, "{}", sp)?;
                f.write_str("'\ntry: ")?;
                write(f, "{}", sp)?;
            }
            CliErrorKind::MissingSubcommand => {
                // (cmd.render_in names the subcommands)
                f.write_str("error: missing command for '")?;
                f.write_str(self.text)?;
                f.write_str("'\ntry: --help")?;
            }
            CliErrorKind::ArgumentConflict => {
                f.write_str("error: '")?;
                written(f, self.text, self.short)?;
                f.write_str("' cannot be used with '")?;
                written(f, self.other, self.other_short)?;
                f.write_str("'\ntry: drop '")?;
                written(f, self.text, self.short)?;
                f.write_str("' (or '")?;
                written(f, self.other, self.other_short)?;
                f.write_str("')")?;
            }
            CliErrorKind::Custom => {
                f.write_str("error: ")?;
                f.write_str(self.text)?;
                if self.hint.len() as i64 > 0 {
                    f.write_str("\ntry: ")?;
                    f.write_str(self.hint)?;
                }
            }
            CliErrorKind::InvalidValue => {
                f.write_str("error: invalid value '")?;
                f.write_str(self.text)?;
                f.write_str("' for '")?;
                write(f, "{}", sp)?;
                f.write_str("'\ntry: ")?;
                write(f, "{}", sp)?;
            }
        }
        Ok(())
    }
}

// An argument as given: `-c` (short, a letter of a cluster), else text.
fn written(f: &mut Formatter<'_>, text: &str, short: char) -> crate::fmt::Result {
    if short != '\0' {
        f.write_char('-')?;
        f.write_char(short)
    } else {
        f.write_str(text)
    }
}

// The edit distance of a and b: insertions, deletions, substitutions and
// swaps of two neighbours (`--nmae` is 1 from `--name`); 64 beyond 63
// bytes.
fn distance(a: &str, b: &str) -> i64 {
    let a = a.as_bytes();
    let b = b.as_bytes();
    if a.len() as i64 > 63 || b.len() as i64 > 63 {
        return 64;
    }
    let mut prev2: [i64; 64] = [0i64; 64];
    let mut prev: [i64; 64] = [0i64; 64];
    let mut cur: [i64; 64] = [0i64; 64];
    for j in 0..b.len() as i64 + 1 {
        prev[j as usize] = j;
    }
    for i in 1..a.len() as i64 + 1 {
        cur[0] = i;
        for j in 1..b.len() as i64 + 1 {
            let mut best = prev[(j - 1) as usize] + if a[(i - 1) as usize]
                == b[(j - 1) as usize] { 0 } else { 1 };
            if prev[j as usize] + 1 < best {
                best = prev[j as usize] + 1;
            }
            if cur[(j - 1) as usize] + 1 < best {
                best = cur[(j - 1) as usize] + 1;
            }
            if i > 1 && j > 1 && a[(i - 1) as usize] == b[(j - 2) as usize]
                && a[(i - 2) as usize] == b[(j - 1) as usize]
                && prev2[(j - 2) as usize] + 1 < best {
                best = prev2[(j - 2) as usize] + 1;
            }
            cur[j as usize] = best;
        }
        for j in 0..b.len() as i64 + 1 {
            prev2[j as usize] = prev[j as usize];
            prev[j as usize] = cur[j as usize];
        }
    }
    prev[b.len() as i64 as usize]
}

// Whether a candidate at distance d from word is worth suggesting.
fn near(d: i64, word: &str) -> bool {
    let most: i64 = if word.len() as i64 / 3 > 1 { word.len() as i64 / 3 } else { 1 };
    d <= most
}

impl<'a, CA: Allocator + Clone> Command<'a, CA> {
    // The long option of c nearest to word (its own name, when an alias
    // is the nearest), or "".
    fn near_long(&self, c: i64, word: &str) -> &'a str {
        let mut best: &'a str = "";
        let mut bd: i64 = 64;
        for i in 0..self.args.len() as i64 {
            let a = self.args[i as usize];
            if self.of_cmd(a, c) && a.kind != POSITIONAL && !a.hidden && a.long.len() as i64 > 0 {
                let mut d = distance(word, a.long);
                let da = a.aliases.nearest(word);
                if da < d {
                    d = da;
                }
                if d < bd {
                    bd = d;
                    best = a.long;
                }
            }
        }
        let builtin: [&str; 2] = ["help", "version"];
        for k in 0..2 {
            if k == 1 && self.cmds[c as usize].version.len() as i64 == 0 {
                continue;
            }
            let d = distance(word, builtin[k as usize]);
            if d < bd {
                bd = d;
                best = builtin[k as usize];
            }
        }
        if near(bd, word) { best } else { "" }
    }

    // The subcommand of c nearest to word (by its name or an alias): its
    // name, or "".
    fn near_sub(&self, c: i64, word: &str) -> &'a str {
        let mut best: &'a str = "";
        let mut bd: i64 = 64;
        for i in 1..self.cmds.len() as i64 {
            if self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden {
                let mut d = distance(word, self.cmds[i as usize].name);
                let da = self.cmds[i as usize].aliases.nearest(word);
                if da < d {
                    d = da;
                }
                if d < bd {
                    bd = d;
                    best = self.cmds[i as usize].name;
                }
            }
        }
        if near(bd, word) { best } else { "" }
    }

    // The argument of c with long form (or alias) name, or -1: c's own
    // first, then the global ones of the commands above it.
    fn find_long(&self, c: i64, name: &str) -> i64 {
        for i in 0..self.args.len() as i64 {
            if self.args[i as usize].cmd == c && self.args[i as usize].long_is(name) {
                return i;
            }
        }
        for i in 0..self.args.len() as i64 {
            let a = self.args[i as usize];
            if a.cmd != c && a.long_is(name) && self.of_cmd(a, c) {
                return i;
            }
        }
        -1
    }

    // The argument of c with short form ch, or -1 (as find_long).
    fn find_short(&self, c: i64, ch: char) -> i64 {
        for i in 0..self.args.len() as i64 {
            let a = self.args[i as usize];
            if a.cmd == c && a.kind != POSITIONAL && a.short != '\0' && a.short == ch {
                return i;
            }
        }
        for i in 0..self.args.len() as i64 {
            let a = self.args[i as usize];
            if a.cmd != c && a.kind != POSITIONAL && a.short != '\0' && a.short == ch
                && self.of_cmd(a, c) {
                return i;
            }
        }
        -1
    }

    // (0.25.2) Whether tok, starting with '-', is an option of c: `--name`
    // (`--name=v`) or `-x...` whose first letter is one (`-h`, `--help`,
    // `-V`, `--version` too).
    fn known(&self, c: i64, tok: &str) -> bool {
        let b = tok.as_bytes();
        let versioned = self.cmds[c as usize].version.len() as i64 > 0;
        if b[1] == b'-' {
            let body = tok.strip_prefix("--").unwrap();
            let name = match body.split_once('=') {
                Option::Some((n, _)) => n,
                Option::None => body,
            };
            return self.find_long(c, name) >= 0 || name == "help"
                || (name == "version" && versioned);
        }
        self.find_short(c, b[1] as char) >= 0 || tok == "-h" || (tok == "-V" && versioned)
    }

    // Parses args (the program's name first, as env::args() gives them),
    // the Matches on the command's allocator.
    #[effects(CA, I)]
    pub fn parse<I: Iterator<Item = &'a str>>(&self, args: I) -> Result<Matches<'a, CA>,
        CliError<'a>> {
        self.parse_in(args, self.alloc.clone())
    }

    // Parses args, the Matches on allocator a.
    #[effects(panic, diverge, CA, I, A)]
    pub fn parse_in<I: Iterator<Item = &'a str>, A: Allocator + Clone>(&self, args: I, a: A)
        -> Result<Matches<'a, A>, CliError<'a>> {
        let mut it = args;
        let _ = it.next();
        let mut m: Matches<'a, A> = Matches {
            slots: Vec::new_in(a.clone()), marks: Vec::new_in(a.clone()),
            texts: Vec::new_in(a.clone()), names: Vec::new_in(a.clone()),
            cmds: Vec::new_in(a.clone()), indices: Vec::new_in(a), level: 0,
        };
        // the index of tok among the arguments (the program's name: 0)
        let mut at: i64 = 0;
        let mut cur: i64 = 0;
        m.enter(self, 0i64);
        let mut npos: i64 = 0;
        let mut dashdash = false;
        // the slot an option waits for values in, how many more (0.25.2:
        // num_values), and how it was written
        let mut pending: i64 = -1;
        let mut pending_left: i64 = 0;
        let mut pending_text: &'a str = "";
        let mut pending_short: char = '\0';
        // a required argument missing: reported at the end, so that a
        // later --help still prints the help
        let mut late = CliError::new(CliErrorKind::Help, 0, "");
        let mut has_late = false;
        loop {
            let tok = match it.next() {
                Option::Some(t) => t,
                Option::None => break,
            };
            at += 1;
            if pending >= 0 {
                m.push(pending, tok, at);
                pending_left -= 1;
                if pending_left == 0 {
                    pending = -1;
                }
                continue;
            }
            let b = tok.as_bytes();
            let mut word = dashdash || b.len() as i64 < 2 || b[0] != b'-';
            if !word && tok != "--" {
                // (0.25.2) a positional that takes values starting with '-'
                let s = m.positional(npos);
                word = s >= 0 && m.slots[s as usize].arg.hyphen && !self.known(cur, tok);
            }
            if word {
                // a positional, or a subcommand's name
                if !dashdash {
                    let sub = self.sub_named(cur, tok);
                    if sub >= 0 {
                        match m.finish(cur) {
                            Err(e) => if !has_late {
                                late = e;
                                has_late = true;
                            },
                            Ok(_) => {}
                        }
                        cur = sub;
                        m.enter(self, sub);
                        npos = 0;
                        continue;
                    }
                }
                let mut s = m.positional(npos);
                if dashdash {
                    // (0.25.2) the words after `--` go to a `last` positional
                    let l = m.last_positional();
                    if l >= 0 {
                        s = if m.slots[l as usize].arg.multiple
                            || m.slots[l as usize].count == 0 { l } else { -1 };
                    }
                }
                if s >= 0 {
                    m.given(s, tok, '\0', at);
                    m.push(s, tok, at);
                    if !m.slots[s as usize].arg.multiple {
                        npos += 1;
                    }
                    continue;
                }
                if self.has_subs(cur) {
                    let mut e = CliError::new(CliErrorKind::UnknownCommand, cur, tok);
                    e.hint = self.near_sub(cur, tok);
                    return Err(e);
                }
                return Err(CliError::new(CliErrorKind::UnexpectedArgument, cur, tok));
            }
            if tok == "--" {
                dashdash = true;
                continue;
            }
            if b[1] == b'-' {
                // --name, --name=value
                let body = tok.strip_prefix("--").unwrap();
                let mut name = body;
                let mut value: &str = "";
                let mut has_value = false;
                match body.split_once('=') {
                    Option::Some((n, v)) => {
                        name = n;
                        value = v;
                        has_value = true;
                    }
                    Option::None => {}
                }
                let shown = if has_value { tok.split_once('=').unwrap().0 } else { tok };
                let i = self.find_long(cur, name);
                if i < 0 {
                    if name == "help" {
                        return Err(CliError::new(CliErrorKind::Help, cur, tok));
                    }
                    if name == "version" && self.cmds[cur as usize].version.len() as i64 > 0 {
                        return Err(CliError::new(CliErrorKind::Version, cur, tok));
                    }
                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, shown);
                    e.hint = self.near_long(cur, name);
                    e.hint_long = true;
                    return Err(e);
                }
                let s = m.slot_of(i);
                let x = self.args[i as usize];
                m.given(s, shown, '\0', at);
                if x.kind == FLAG {
                    if has_value {
                        return Err(CliError::of(CliErrorKind::FlagValue, cur, tok, x));
                    }
                    m.flag_at(s, at);
                } else if has_value {
                    m.push(s, value, at);
                    if x.num_values > 1 {
                        pending = s;
                        pending_left = x.num_values - 1;
                        pending_text = shown;
                        pending_short = '\0';
                    }
                } else if x.has_missing {
                    m.push(s, x.missing, at);
                } else {
                    pending = s;
                    pending_left = x.num_values;
                    pending_text = tok;
                    pending_short = '\0';
                }
                continue;
            }
            // -abc: short flags, the last may be an option (-ofile, -o file)
            let mut j: i64 = 1;
            while j < b.len() as i64 {
                let ch = b[j as usize] as char;
                let i = self.find_short(cur, ch);
                if i < 0 {
                    if ch == 'h' {
                        return Err(CliError::new(CliErrorKind::Help, cur, tok));
                    }
                    if ch == 'V' && self.cmds[cur as usize].version.len() as i64 > 0 {
                        return Err(CliError::new(CliErrorKind::Version, cur, tok));
                    }
                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, tok);
                    e.short = ch;
                    // `-verbose` for `--verbose`
                    if b.len() as i64 > 2 {
                        let word = tok.strip_prefix("-").unwrap();
                        if self.find_long(cur, word) >= 0 {
                            e.hint = self.args[self.find_long(cur, word) as usize].long;
                        } else {
                            e.hint = self.near_long(cur, word);
                        }
                        e.hint_long = e.hint.len() as i64 > 0;
                    }
                    return Err(e);
                }
                let s = m.slot_of(i);
                let x = self.args[i as usize];
                m.given(s, tok, ch, at);
                if x.kind == FLAG {
                    m.flag_at(s, at);
                    j += 1;
                    continue;
                }
                // (after an ASCII byte: UTF-8)
                let mut rest = crate::str::from_utf8(&b[(j + 1) as usize..]).unwrap_or("");
                let mut eq = false;
                match rest.strip_prefix("=") {
                    Option::Some(r) => {
                        rest = r;
                        eq = true;
                    }
                    Option::None => {}
                }
                if x.has_missing && !eq {
                    // (0.25.2) an optional value: only `-s=x` gives one
                    m.push(s, x.missing, at);
                    j += 1;
                    continue;
                }
                if rest.len() as i64 > 0 || eq {
                    m.push(s, rest, at);
                    if x.num_values > 1 {
                        pending = s;
                        pending_left = x.num_values - 1;
                        pending_text = tok;
                        pending_short = ch;
                    }
                } else {
                    pending = s;
                    pending_left = x.num_values;
                    pending_text = tok;
                    pending_short = ch;
                }
                break;
            }
        }
        if pending >= 0 {
            let mut e = CliError::of(CliErrorKind::MissingValue, cur, pending_text,
                m.slots[pending as usize].arg);
            e.short = pending_short;
            return Err(e);
        }
        if has_late {
            return Err(late);
        }
        if self.cmds[cur as usize].sub_required {
            return Err(CliError::new(CliErrorKind::MissingSubcommand, cur,
                self.cmds[cur as usize].name));
        }
        m.finish(cur)?;
        m.finish_globals(cur)?;
        m.conflicts()?;
        m.group();
        // (0.25) the values of arguments with choices
        for s in 0..m.slots.len() as i64 {
            let sl = m.slots[s as usize];
            for k in sl.start..sl.start + sl.len {
                if !chosen(m.texts[k as usize], sl.arg.choices) {
                    return Err(CliError::of(CliErrorKind::InvalidValue, self.cmds_of(sl.level, &m),
                        m.texts[k as usize], sl.arg));
                }
            }
        }
        Ok(m)
    }
}

// ---- Matches (0.24) ----

// An argument of a matched command: how many times it was given, and
// (after parse) where its values are in Matches.texts.
#[derive(Clone, Copy)]
struct Slot<'a> {
    level: i64,
    index: i64,
    arg: Arg<'a>,
    count: i64,
    start: i64,
    len: i64,
    // (0.25) where its occurrences are in Matches.marks, after parse
    pstart: i64,
    plen: i64,
    // (0.25.2) how it was last given (`--text`, or the letter of `-bt`) and
    // where: for an ArgumentConflict
    wtext: &'a str,
    wshort: char,
    wat: i64,
}

// A global argument, of its command and the subcommands below.
fn is_global(a: Arg<'_>) -> bool {
    a.global && a.kind != POSITIONAL
}

// What parse found: for the command and each subcommand on the line (a
// level each), every argument's count and values. `m.subcommand()` gives
// the next level's Matches.
pub struct Matches<'a, A: Allocator> {
    slots: Vec<Slot<'a>, A>,
    // (0.25) while parsing, a pair for each value or flag given: its slot
    // (-1 - slot: a flag, no value) and its index among the arguments (-1:
    // a default); after, those indices by slot (Slot.pstart)
    marks: Vec<i64, A>,
    // the values (after parse: by slot, Slot.start)
    texts: Vec<&'a str, A>,
    // each level's command: its name and index
    names: Vec<&'a str, A>,
    cmds: Vec<i64, A>,
    // (after parse) each slot's indices among the arguments (Slot.pstart)
    indices: Vec<i64, A>,
    level: i64,
}

impl<'a, A: Allocator + Clone> Matches<'a, A> {
    // A new level for command c: a slot for each of its arguments.
    fn enter<CA: Allocator + Clone>(&mut self, cmd: &Command<'a, CA>, c: i64) {
        self.level = self.names.len() as i64;
        self.names.push(cmd.cmds[c as usize].name);
        self.cmds.push(c);
        for i in 0..cmd.args.len() as i64 {
            if cmd.args[i as usize].cmd == c {
                self.slots.push(Slot {
                    level: self.level, index: i, arg: cmd.args[i as usize], count: 0, start: 0,
                    len: 0,
                    pstart: 0, plen: 0, wtext: "", wshort: '\0', wat: 0,
                });
            }
        }
    }

    // The slot of argument i (on its command's level: a global argument's
    // is above the last).
    fn slot_of(&self, i: i64) -> i64 {
        for s in 0..self.slots.len() as i64 {
            if self.slots[s as usize].index == i {
                return s;
            }
        }
        -1
    }

    // The slot of the k-th positional of the last level (not counting a
    // `last` one), or -1.
    fn positional(&self, k: i64) -> i64 {
        let mut n: i64 = 0;
        for s in 0..self.slots.len() as i64 {
            let sl = self.slots[s as usize];
            if sl.level == self.level && sl.arg.kind == POSITIONAL && !sl.arg.last {
                if n == k {
                    return s;
                }
                n += 1;
            }
        }
        -1
    }

    // (0.25.2) The slot of the last level's `last` positional, or -1.
    fn last_positional(&self) -> i64 {
        for s in 0..self.slots.len() as i64 {
            let sl = self.slots[s as usize];
            if sl.level == self.level && sl.arg.kind == POSITIONAL && sl.arg.last {
                return s;
            }
        }
        -1
    }

    // (0.25.2) Slot s given as text (short: the letter of a cluster) at
    // argument index at.
    fn given(&mut self, s: i64, text: &'a str, short: char, at: i64) {
        self.slots[s as usize].wtext = text;
        self.slots[s as usize].wshort = short;
        self.slots[s as usize].wat = at;
    }

    // A value of slot s, at argument index at.
    fn push(&mut self, s: i64, text: &'a str, at: i64) {
        self.slots[s as usize].count += 1;
        self.marks.push(s);
        self.marks.push(at);
        self.texts.push(text);
    }

    // A flag of slot s given, at argument index at.
    fn flag_at(&mut self, s: i64, at: i64) {
        self.slots[s as usize].count += 1;
        self.marks.push(-1 - s);
        self.marks.push(at);
    }

    // Slot s not given: its default, or an error when it is required.
    fn absent(&mut self, s: i64, c: i64) -> Result<(), CliError<'a>> {
        let sl = self.slots[s as usize];
        if sl.arg.has_default {
            self.marks.push(s);
            self.marks.push(-1);
            self.texts.push(sl.arg.default);
        } else if sl.arg.required {
            return Err(CliError::of(CliErrorKind::MissingRequired, c, "", sl.arg));
        }
        Ok(())
    }

    // The end of command c's arguments: the defaults, the required ones
    // (a global argument's at the end, finish_globals).
    fn finish(&mut self, c: i64) -> Result<(), CliError<'a>> {
        for s in 0..self.slots.len() as i64 {
            let sl = self.slots[s as usize];
            if sl.level != self.level || sl.count > 0 || is_global(sl.arg) {
                continue;
            }
            self.absent(s, c)?;
        }
        Ok(())
    }

    // (0.25.2) The global arguments not given, on any level (an error is
    // about c, the last command).
    fn finish_globals(&mut self, c: i64) -> Result<(), CliError<'a>> {
        for s in 0..self.slots.len() as i64 {
            let sl = self.slots[s as usize];
            if sl.count == 0 && is_global(sl.arg) {
                self.absent(s, c)?;
            }
        }
        Ok(())
    }

    // (0.25.2) Two arguments given that conflicts_with keeps apart: an
    // error naming both as given, the later first.
    fn conflicts(&self) -> Result<(), CliError<'a>> {
        for s in 0..self.slots.len() as i64 {
            let sl = self.slots[s as usize];
            if sl.count == 0 {
                continue;
            }
            for k in 0..sl.arg.conflicts.n {
                for name in sl.arg.conflicts.name_at(k).split('|') {
                    let o = self.find_at(sl.level, name);
                    if o < 0 {
                        crate::panic::panic(
                            "std::cli: conflicts_with: no argument by that name in this command");
                    }
                    if self.slots[o as usize].count == 0 || o == s {
                        continue;
                    }
                    let mut p = s;
                    let mut q = o;
                    if self.slots[o as usize].wat > sl.wat {
                        p = o;
                        q = s;
                    }
                    let mut e = CliError::of(CliErrorKind::ArgumentConflict,
                        self.cmds[sl.level as usize], self.slots[p as usize].wtext,
                        self.slots[p as usize].arg);
                    e.short = self.slots[p as usize].wshort;
                    e.other = self.slots[q as usize].wtext;
                    e.other_short = self.slots[q as usize].wshort;
                    return Err(e);
                }
            }
        }
        Ok(())
    }

    // Each slot's values together, in the order given, and their indices
    // among the arguments; the first level current.
    fn group(&mut self) {
        let n = self.marks.len() as i64 / 2;
        let mut out: Vec<&'a str, A> = Vec::with_capacity_in(self.texts.len(),
            self.texts.allocator().clone());
        for s in 0..self.slots.len() as i64 {
            self.slots[s as usize].start = out.len() as i64;
            let mut t: i64 = 0;
            for k in 0..n {
                let o = self.marks[(2 * k) as usize];
                if o >= 0 {
                    if o == s {
                        out.push(self.texts[t as usize]);
                    }
                    t += 1;
                }
            }
            self.slots[s as usize].len = out.len() as i64 - self.slots[s as usize].start;
        }
        self.texts = out;
        // the indices by slot
        for s in 0..self.slots.len() as i64 {
            self.slots[s as usize].pstart = self.indices.len() as i64;
            for k in 0..n {
                let o = self.marks[(2 * k) as usize];
                let at = self.marks[(2 * k + 1) as usize];
                if at >= 0 && (o == s || o == -1 - s) {
                    self.indices.push(at);
                }
            }
            self.slots[s as usize].plen = self.indices.len() as i64 - self.slots[s as usize].pstart;
        }
        self.level = 0;
    }

    // The slot of the argument named name on level level (or a global one
    // of a level above), or -1.
    fn find_at(&self, level: i64, name: &str) -> i64 {
        for s in 0..self.slots.len() as i64 {
            if self.slots[s as usize].level == level && self.slots[s as usize].arg.name == name {
                return s;
            }
        }
        let mut l = level - 1;
        while l >= 0 {
            for s in 0..self.slots.len() as i64 {
                let sl = self.slots[s as usize];
                if sl.level == l && is_global(sl.arg) && sl.arg.name == name {
                    return s;
                }
            }
            l -= 1;
        }
        -1
    }

    // The slot of the argument named name on this level (or a global one
    // of a command above, 0.25.2).
    fn find(&self, name: &str) -> i64 {
        let s = self.find_at(self.level, name);
        if s >= 0 {
            return s;
        }
        crate::panic::panic("std::cli: Matches: no argument by that name in this command (an Arg's name, not its long or short form)");
    }

    // (0.25.3) Whether the argument named name is a flag (no value: get,
    // get_as and values refuse it, cli.kind); an unknown name is not
    // (find reports it).
    fn is_flag(&self, name: &str) -> bool {
        let s = self.find_at(self.level, name);
        s >= 0 && self.slots[s as usize].arg.kind == FLAG
    }

    // Whether the argument was given (a default does not count).
    #[effects(panic, A)]
    pub fn flag(&self, name: &str) -> bool {
        self.slots[self.find(name) as usize].count > 0
    }

    // How many times it was given: `-vvv` is 3.
    // std: changed: a usize (MVS: i64)
    #[effects(panic, A)]
    pub fn count(&self, name: &str) -> usize {
        self.slots[self.find(name) as usize].count as usize
    }

    // Its value (the last one given), else its default.
    #[effects(panic, A)]
    pub fn get(&self, name: &str) -> Option<&'a str>
        requires !self.is_flag(name)
        else "cli.kind: m.get(NAME) of a flag, which has no value (it would always be None): read a flag with m.flag(NAME)"
        {
        let sl = self.slots[self.find(name) as usize];
        if sl.len == 0 {
            return Option::None;
        }
        Option::Some(self.texts[(sl.start + sl.len - 1) as usize])
    }

    // Every value given, in order (or its default).
    #[effects(panic, A)]
    pub fn values(&self, name: &str) -> &[&'a str]
        requires !self.is_flag(name)
        else "cli.kind: m.values(NAME) of a flag, which has no value (it would always be empty): read a flag with m.flag(NAME), m.count(NAME)"
        {
        let sl = self.slots[self.find(name) as usize];
        &self.texts.as_slice()[sl.start as usize..(sl.start + sl.len) as usize]
    }

    // (0.25) Where it was given: the index among the arguments (the
    // program's name is 0) of each value, in order, or of each time a flag
    // was given; a default has none. Clap's `indices_of`: the order of
    // different arguments' values (`-l m x.o -l z`), which `values` does
    // not keep. (0.27.5) i64s, as MVS's: a program compares them with
    // its own word indices, and a translation row cannot convert a
    // slice's elements.
    #[effects(panic, A)]
    pub fn indices_of(&self, name: &str) -> &[i64] {
        let sl = self.slots[self.find(name) as usize];
        &self.indices.as_slice()[sl.pstart as usize..(sl.pstart + sl.plen) as usize]
    }

    // Its value parsed as a T (`m.get_as::<i64>("n")`): an InvalidValue
    // error naming the argument when it does not parse, MissingRequired
    // when it has no value (give it a default, or make it required).
    #[effects(panic, A, T)]
    pub fn get_as<T: FromStr>(&self, name: &str) -> Result<T, CliError<'a>>
        requires !self.is_flag(name)
        else "cli.kind: m.get_as(NAME) of a flag, which has no value: read a flag with m.flag(NAME)"
        {
        let sl = self.slots[self.find(name) as usize];
        let c = self.cmds[self.level as usize];
        if sl.len == 0 {
            return Err(CliError::of(CliErrorKind::MissingRequired, c, "", sl.arg));
        }
        let text = self.texts[(sl.start + sl.len - 1) as usize];
        match T::from_str(text) {
            Ok(v) => Ok(v),
            Err(_) => Err(CliError::of(CliErrorKind::InvalidValue, c, text, sl.arg)),
        }
    }

    // The subcommand given, its name, or None.
    #[effects(panic, A)]
    pub fn subcommand_name(&self) -> Option<&'a str> {
        if self.level + 1 < self.names.len() as i64 {
            return Option::Some(self.names[(self.level + 1) as usize]);
        }
        Option::None
    }

    // The subcommand given: its name and its Matches (a copy), or None.
    #[effects(panic, A)]
    pub fn subcommand(&self) -> Option<(&'a str, Matches<'a, A>)> {
        if self.level + 1 >= self.names.len() as i64 {
            return Option::None;
        }
        let sub = Matches {
            slots: self.slots.clone(), marks: self.marks.clone(), texts: self.texts.clone(),
            names: self.names.clone(), cmds: self.cmds.clone(), indices: self.indices.clone(),
            level: self.level + 1,
        };
        Option::Some((self.names[(self.level + 1) as usize], sub))
    }
}

// ---- Help and errors (0.24) ----

// Writes text from column col (already there) to width, breaking at
// spaces; later lines start at column indent.
fn wrap<A: Allocator>(out: &mut String<A>, text: &str, col: i64, indent: i64, width: i64) {
    let mut at = col;
    let mut first = true;
    for w in text.split(' ') {
        if w.len() as i64 == 0 {
            continue;
        }
        if !first {
            if at + 1 + w.len() as i64 > width && at > indent {
                out.push('\n');
                for _ in 0..indent {
                    out.push(' ');
                }
                at = indent;
            } else {
                out.push(' ');
                at += 1;
            }
        }
        out.push_str(w);
        at += w.len() as i64;
        first = false;
    }
}

impl<'a, CA: Allocator + Clone> Command<'a, CA> {
    // `git remote add`: the names from the root to c.
    fn path_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {
        let p = self.cmds[c as usize].parent;
        if p >= 0 {
            self.path_into(p, out);
            out.push(' ');
        }
        out.push_str(self.cmds[c as usize].name);
    }

    // `usage: prog [options] --out <FILE> <input> [file]... [command]`
    fn usage_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {
        out.push_str("usage: ");
        self.path_into(c, out);
        out.push_str(" [options]");
        for i in 0..self.args.len() as i64 {
            let a = self.args[i as usize];
            if self.of_cmd(a, c) && a.kind == OPTION && a.required && !a.hidden {
                out.push(' ');
                write(out, "{}", Spell { a: a }).unwrap();
            }
        }
        for i in 0..self.args.len() as i64 {
            let a = self.args[i as usize];
            if a.cmd == c && a.kind == POSITIONAL && !a.hidden {
                out.push(' ');
                if a.last {
                    // (0.25.2) `[-- args]...`, `-- <args>...`
                    if !a.required {
                        out.push('[');
                    }
                    out.push_str("-- ");
                    if a.required {
                        write(out, "{}", Spell { a: a }).unwrap();
                    } else {
                        out.push_str(if a.value_name.len() as i64 > 0 { a.value_name }
                            else { a.name });
                        out.push(']');
                        if a.multiple {
                            out.push_str("...");
                        }
                    }
                } else if a.required {
                    write(out, "{}", Spell { a: a }).unwrap();
                } else {
                    out.push('[');
                    out.push_str(if a.value_name.len() as i64 > 0 { a.value_name } else { a.name });
                    out.push(']');
                    if a.multiple {
                        out.push_str("...");
                    }
                }
            }
        }
        if self.has_subs(c) {
            out.push_str(if self.cmds[c as usize].sub_required { " <command>" }
                else { " [command]" });
        }
    }

    // (0.25.2) A visible subcommand of c.
    fn shown_sub(&self, i: i64, c: i64) -> bool {
        self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden
    }

    fn has_shown_subs(&self, c: i64) -> bool {
        for i in 1..self.cmds.len() as i64 {
            if self.shown_sub(i, c) {
                return true;
            }
        }
        false
    }

    // (0.25.2) A MissingSubcommand's try: line, `prog remote <add|rm>`
    // (one: `prog remote add`; many: `prog remote --help`).
    fn try_sub_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {
        self.path_into(c, out);
        out.push(' ');
        let mut n: i64 = 0;
        let mut len: i64 = 0;
        for i in 1..self.cmds.len() as i64 {
            if self.shown_sub(i, c) {
                n += 1;
                len += self.cmds[i as usize].name.len() as i64 + 1;
            }
        }
        if n == 0 || len > 48 {
            out.push_str("--help");
            return;
        }
        if n > 1 {
            out.push('<');
        }
        let mut first = true;
        for i in 1..self.cmds.len() as i64 {
            if self.shown_sub(i, c) {
                if !first {
                    out.push('|');
                }
                out.push_str(self.cmds[i as usize].name);
                first = false;
            }
        }
        if n > 1 {
            out.push('>');
        }
    }

    // An argument's left column: `-o, --out <FILE>`, `    --tag`, `<input>`.
    fn left_into<A: Allocator>(&self, a: Arg<'a>, out: &mut String<A>) {
        if a.kind == POSITIONAL {
            write(out, "{}", Spell { a: a }).unwrap();
            return;
        }
        if a.short != '\0' {
            out.push('-');
            out.push(a.short);
            if a.long.len() as i64 > 0 {
                out.push_str(", ");
            }
        } else {
            out.push_str("    ");
        }
        if a.long.len() as i64 > 0 {
            out.push_str("--");
            out.push_str(a.long);
        }
        if a.kind == OPTION {
            out.push_str(if a.has_missing { "[=" } else { " " });
            write(out, "{}", ValueName { a: a }).unwrap();
            if a.has_missing {
                out.push(']');
            }
        }
    }

    // The rest of a table's line begun at out[start..] (its left column
    // written): its help at column col.
    fn row_end<A: Allocator>(&self, out: &mut String<A>, start: i64, help: &str, default: &str,
        has_default: bool, col: i64) {
        let mut at = out.len() as i64 - start;
        if help.len() as i64 > 0 || has_default {
            if at + 2 > col {
                out.push('\n');
                at = 0;
            }
            while at < col {
                out.push(' ');
                at += 1;
            }
            wrap(out, help, col, col, self.width);
            if has_default {
                if help.len() as i64 > 0 {
                    out.push(' ');
                }
                out.push_str("[default: ");
                out.push_str(default);
                out.push(']');
            }
        }
        out.push('\n');
    }

    // A table's line: name, then its help at column col.
    fn row<A: Allocator>(&self, out: &mut String<A>, name: &str, help: &str, col: i64) {
        let start = out.len() as i64;
        out.push_str("  ");
        out.push_str(name);
        self.row_end(out, start, help, "", false, col);
    }

    // An argument's line of a table.
    fn arg_row<A: Allocator>(&self, out: &mut String<A>, x: Arg<'a>, col: i64) {
        let start = out.len() as i64;
        out.push_str("  ");
        self.left_into(x, out);
        self.row_end(out, start, x.help, x.default, x.has_default, col);
    }

    // The help of command c.
    fn help_into<A: Allocator + Clone>(&self, c: i64, out: &mut String<A>, a: A) {
        let cmd = self.cmds[c as usize];
        self.path_into(c, out);
        if cmd.version.len() as i64 > 0 {
            out.push(' ');
            out.push_str(cmd.version);
        }
        out.push('\n');
        if cmd.about.len() as i64 > 0 {
            wrap(out, cmd.about, 0i64, 0i64, self.width);
            out.push('\n');
        }
        out.push('\n');
        self.usage_into(c, out);
        out.push('\n');
        // the left column's width: the widest entry, at most 24
        let mut left = String::new_in(a);
        let mut widest: i64 = 13;
        for i in 0..self.args.len() as i64 {
            if self.of_cmd(self.args[i as usize], c) && !self.args[i as usize].hidden {
                left.clear();
                self.left_into(self.args[i as usize], &mut left);
                if left.len() as i64 > widest && left.len() as i64 <= 24 {
                    widest = left.len() as i64;
                }
            }
        }
        for i in 1..self.cmds.len() as i64 {
            if self.shown_sub(i, c) && self.cmds[i as usize].name.len() as i64 > widest
                && self.cmds[i as usize].name.len() as i64 <= 24 {
                widest = self.cmds[i as usize].name.len() as i64;
            }
        }
        let col = 2 + widest + 2;
        let mut any = false;
        for i in 0..self.args.len() as i64 {
            let x = self.args[i as usize];
            if x.cmd == c && x.kind == POSITIONAL && !x.hidden {
                if !any {
                    out.push_str("\narguments:\n");
                    any = true;
                }
                self.arg_row(out, x, col);
            }
        }
        out.push_str("\noptions:\n");
        let mut own_help = false;
        let mut own_version = false;
        for i in 0..self.args.len() as i64 {
            let x = self.args[i as usize];
            if self.of_cmd(x, c) && x.kind != POSITIONAL && !x.hidden {
                self.arg_row(out, x, col);
                if x.long == "help" || x.short == 'h' {
                    own_help = true;
                }
                if x.long == "version" || x.short == 'V' {
                    own_version = true;
                }
            }
        }
        if !own_help {
            self.row(out, "-h, --help", "print this help", col);
        }
        if !own_version && cmd.version.len() as i64 > 0 {
            self.row(out, "-V, --version", "print the version", col);
        }
        if self.has_shown_subs(c) {
            out.push_str("\ncommands:\n");
            for i in 1..self.cmds.len() as i64 {
                if self.shown_sub(i, c) {
                    self.row(out, self.cmds[i as usize].name, self.cmds[i as usize].about, col);
                }
            }
        }
    }

    // The help, on allocator a.
    #[effects(CA, A)]
    pub fn help_in<A: Allocator + Clone>(&self, a: A) -> String<A> {
        let mut out = String::new_in(a.clone());
        self.help_into(0i64, &mut out, a);
        out
    }

    // What cmd.exit(e) prints, on allocator a: the help or the version
    // line, or e's two lines and the usage line.
    #[effects(panic, diverge, CA, A)]
    pub fn render_in<A: Allocator + Clone>(&self, e: CliError<'a>, a: A) -> String<A> {
        let mut out = String::new_in(a.clone());
        match e.kind {
            CliErrorKind::Help => self.help_into(e.cmd, &mut out, a),
            CliErrorKind::Version => {
                self.path_into(e.cmd, &mut out);
                out.push(' ');
                out.push_str(self.cmds[e.cmd as usize].version);
                out.push('\n');
            }
            CliErrorKind::MissingSubcommand => {
                out.push_str("error: missing command for '");
                self.path_into(e.cmd, &mut out);
                out.push_str("'\ntry: ");
                self.try_sub_into(e.cmd, &mut out);
                out.push('\n');
                self.usage_into(e.cmd, &mut out);
                out.push('\n');
            }
            _ => {
                write(&mut out, "{}", e).unwrap();
                out.push('\n');
                self.usage_into(e.cmd, &mut out);
                out.push('\n');
            }
        }
        out
    }

    // Prints what e asks (the help and the version to stdout, an error
    // to stderr) and ends the program with e.exit_code().
    #[effects(io, static, panic, diverge, CA)]
    pub fn exit(&self, e: CliError<'a>) -> ! {
        let code = e.exit_code();
        let text = self.render_in(e, self.alloc.clone());
        if code == 0 {
            crate::fmt::print(text.as_str());
        } else {
            crate::fmt::eprint(text.as_str());
        }
        crate::process::exit(code)
    }

    // parse, and on an error (or --help, --version) cmd.exit(e).
    #[effects(CA, I)]
    pub fn parse_or_exit<I: Iterator<Item = &'a str>>(&self, args: I) -> Matches<'a, CA> {
        match self.parse(args) {
            Ok(m) => m,
            Err(e) => self.exit(e),
        }
    }
}
