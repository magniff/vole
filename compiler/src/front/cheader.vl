// `--emit-header`: a C header for the C side of a program. It declares
// what C can use: the `extern "C" fn` definitions, the `extern "C"`
// statics, and the #[repr(C)] (and integer-repr) types they and their
// fields need, in an order C accepts, with include guards. Types of
// default layout appear only behind pointers, as incomplete structs.
// Declarations imported from C headers are not repeated.

use crate::base::{
    buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, buf_write_file, get_bufs, intern_c,
    strlen, sym_text, table_of,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_str};
use crate::front::ast::{NodeKind, REPR_C, REPR_INT, REPR_PACKED, REPR_UNION, child};
use crate::front::check::name_error;
use crate::front::distinct::{enum_niche, niche_full_variant};
use crate::front::lexer::{is_alpha, is_digit};
use crate::front::modules::{module_of, qualify};
use crate::front::types::{
    TY_BOOL, TY_F32, TY_F64, TY_I16, TY_I32, TY_I64, TY_I8, TY_ISIZE, TY_NEVER, TY_U16, TY_U32,
    TY_U64, TY_U8, TY_UNIT, TY_USIZE, compute_layout, enum_type, enum_variant, err_type, fn_param,
    get_enums, struct_field, struct_type, type_align, type_elem, type_size, variant_field,
};
use crate::front::types::TyKind::{Array, Enum, Fn, Ptr, Struct};

fn h(s: *mut u8, pcx: &Ctx<Comp>) {
    buf_str(pcx.hb, s);
}

fn h_sym(sym: i64, pcx: &Ctx<Comp>) {
    buf_bytes(pcx.hb, sym_text(sym, pcx));
}

fn is_c_keyword(sym: i64, pcx: &mut Ctx<Comp>) -> bool {
    let names: [*mut u8; 44] = [c"auto", c"break", c"case", c"char", c"const", c"continue",
        c"default", c"do", c"double", c"else", c"enum", c"extern", c"float", c"for", c"goto", c"if",
        c"inline", c"int", c"long", c"register", c"restrict", c"return", c"short", c"signed",
        c"sizeof", c"static", c"struct", c"switch", c"typedef", c"union", c"unsigned", c"void",
        c"volatile", c"while", c"_Bool", c"_Complex", c"_Imaginary", c"_Alignas", c"_Alignof",
        c"_Atomic", c"_Noreturn", c"_Static_assert", c"_Thread_local", c"bool"];
    for i in 0..44 {
        if sym == intern_c(names[i as usize], pcx) {
            return true;
        }
    }
    false
}

// A name the header uses: an error if C cannot spell it.
fn h_name(sym: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    if is_c_keyword(sym, pcx) {
        name_error(pos, c"'", sym,
            c"' is a C keyword: it cannot be a name in a C header (--emit-header)", pcx);
    }
    h_sym(sym, pcx);
}

// The C spelling of a declaration of `name` (a C string, may be empty)
// with vole type t: `int32_t x`, `uint8_t *p`, `int32_t a[4]`,
// `void (*f)(int32_t)`.
fn h_decl(t: i64, name: *mut u8, pos: i64, pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_str(b, name);
    h_decl_into(t, b, pos, pcx);
}

// `inner` is the declarator so far (a buffer).
fn h_decl_into(t: i64, inner: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let kind = pcx.types[t as usize].kind;
        // (0.18: the null niche, `Option<NonNull<T>>`, is C's nullable `T *`)
        if kind == Enum && enum_niche(pcx.types[t as usize].a, pcx) {
            h_decl_into(variant_field(niche_full_variant(pcx.types[t as usize].a, pcx), 0, pcx),
                inner, pos, pcx);
            return;
        }
        if kind == Ptr {
            let pointee = pcx.types[t as usize].a;
            let b = buf_new();
            let pk = pcx.types[pointee as usize].kind;
            if pk == Array || pk == Fn {
                buf_str(b, c"(*");
                buf_bytes(b, buf_slice(inner));
                buf_str(b, c")");
            } else {
                buf_byte(b, b'*');
                buf_bytes(b, buf_slice(inner));
            }
            if pointee == TY_UNIT {
                h(c"void ", pcx);
                buf_bytes(pcx.hb, buf_slice(b));
                return;
            }
            h_decl_into(pointee, b, pos, pcx);
            return;
        }
        if kind == Array {
            let b = buf_new();
            buf_bytes(b, buf_slice(inner));
            buf_byte(b, b'[');
            buf_int(b, pcx.types[t as usize].b);
            buf_byte(b, b']');
            h_decl_into(pcx.types[t as usize].a, b, pos, pcx);
            return;
        }
        if kind == Fn {
            // A function pointer: R (*inner)(params).
            let b = buf_new();
            buf_str(b, c"(*");
            buf_bytes(b, buf_slice(inner));
            buf_str(b, c")(");
            if pcx.types[t as usize].count == 0 {
                buf_str(b, c"void");
            }
            let saved = pcx.hb;
            for i in 0..pcx.types[t as usize].count {
                if i > 0 {
                    buf_str(b, c", ");
                }
                pcx.hb = b;
                h_decl(type_elem(t, i, pcx), c"", pos, pcx);
                pcx.hb = saved;
            }
            buf_byte(b, b')');
            let ret = pcx.types[t as usize].a;
            if ret == TY_UNIT || ret == TY_NEVER {
                h(c"void ", pcx);
                buf_bytes(pcx.hb, buf_slice(b));
                return;
            }
            h_decl_into(ret, b, pos, pcx);
            return;
        }
        h_base(t, pos, pcx);
        if (*get_bufs().add(inner as usize)).len > 0 {
            h(c" ", pcx);
            buf_bytes(pcx.hb, buf_slice(inner));
        }
    }
}

// A type that is not a pointer, an array or a function pointer.
fn h_base(t: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if t == TY_I8 { h(c"int8_t", pcx); return; }
        if t == TY_I16 { h(c"int16_t", pcx); return; }
        if t == TY_I32 { h(c"int32_t", pcx); return; }
        if t == TY_I64 { h(c"int64_t", pcx); return; }
        if t == TY_U8 { h(c"uint8_t", pcx); return; }
        if t == TY_U16 { h(c"uint16_t", pcx); return; }
        if t == TY_U32 { h(c"uint32_t", pcx); return; }
        if t == TY_U64 { h(c"uint64_t", pcx); return; }
        if t == TY_USIZE { h(c"size_t", pcx); return; }
        if t == TY_ISIZE { h(c"ptrdiff_t", pcx); return; }
        if t == TY_F32 { h(c"float", pcx); return; }
        if t == TY_F64 { h(c"double", pcx); return; }
        if t == TY_BOOL { h(c"bool", pcx); return; }
        if t == TY_UNIT || t == TY_NEVER { h(c"void", pcx); return; }
        let kind = pcx.types[t as usize].kind;
        if kind == Struct {
            let s = pcx.types[t as usize].a;
            h_name(pcx.structs[s as usize].name, pos, pcx);
            return;
        }
        if kind == Enum {
            h_name((*get_enums().add(pcx.types[t as usize].a as usize)).name, pos, pcx);
            return;
        }
        err_begin(pos, pcx);
        err_str(c"type '", pcx);
        err_type(t, pcx);
        err_str(c"' has no C spelling (--emit-header)", pcx);
        err_end(pcx);
    }
}

// Writes the definitions types t needs by value, then t's (for structs
// and enums of C layout).
fn h_need(t: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let kind = pcx.types[t as usize].kind;
    if kind == Array {
        h_need(pcx.types[t as usize].a, pos, pcx);
    } else if kind == Ptr {
        h_forward(pcx.types[t as usize].a, pcx);
    } else if kind == Fn {
        for i in 0..pcx.types[t as usize].count {
            h_need(type_elem(t, i, pcx), pos, pcx);
        }
        h_need(pcx.types[t as usize].a, pos, pcx);
    } else if kind == Struct {
        h_struct(pcx.types[t as usize].a, pcx);
    } else if kind == Enum && enum_niche(pcx.types[t as usize].a, pcx) {
        h_need(variant_field(niche_full_variant(pcx.types[t as usize].a, pcx), 0, pcx), pos, pcx);
    } else if kind == Enum {
        h_enum(pcx.types[t as usize].a, pcx);
    }
}

// A type behind a pointer: an incomplete struct when C does not get its
// definition.
fn h_forward(t: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let kind = pcx.types[t as usize].kind;
        if kind == Struct {
            let s = pcx.types[t as usize].a;
            if (pcx.structs[s as usize].repr & REPR_C) != 0 {
                h_struct(s, pcx);
                return;
            }
            if (pcx.h_forward[s as usize]) == 0 {
                (pcx.h_forward[s as usize]) = 1;
                h(c"/* ", pcx);
                h_sym(pcx.structs[s as usize].name, pcx);
                h(c": a vole type, not visible to C. */\ntypedef struct ", pcx);
                h_name(pcx.structs[s as usize].name,
                    pcx.nodes[pcx.structs[s as usize].node as usize].start, pcx);
                h(c" ", pcx);
                h_sym(pcx.structs[s as usize].name, pcx);
                h(c";\n\n", pcx);
            }
        } else if kind == Enum {
            let e = pcx.types[t as usize].a;
            if ((*get_enums().add(e as usize)).repr & (REPR_C | REPR_INT)) != 0 {
                h_enum(e, pcx);
            }
        } else if kind == Ptr {
            h_forward(pcx.types[t as usize].a, pcx);
        } else if kind == Array {
            h_forward(pcx.types[t as usize].a, pcx);
        } else if kind == Fn {
            h_need(t, 0, pcx);
        }
    }
}

fn h_struct(s: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if (pcx.h_struct_state[s as usize]) != 0 {
            return;
        }
        (pcx.h_struct_state[s as usize]) = 1;
        let node = pcx.structs[s as usize].node;
        let pos = pcx.nodes[node as usize].start;
        let t = struct_type(s, pcx);
        compute_layout(t, pcx);
        let is_union0 = (pcx.structs[s as usize].repr & REPR_UNION) != 0;
        h(if is_union0 { c"typedef union " } else { c"typedef struct " }, pcx);
        h_name(pcx.structs[s as usize].name, pos, pcx);
        h(c" ", pcx);
        h_sym(pcx.structs[s as usize].name, pcx);
        h(c";\n", pcx);
        // Its fields' types first.
        for i in 0..pcx.structs[s as usize].field_count {
            h_need((*struct_field(s, i, pcx)).ty, pos, pcx);
        }
        let repr = pcx.structs[s as usize].repr;
        let is_union = (repr & REPR_UNION) != 0;
        // packed(N), N > 1: GCC's #pragma pack(N).
        let pack_n = (repr & REPR_PACKED) != 0 && pcx.structs[s as usize].align > 1;
        if pack_n {
            h(c"#pragma pack(push, ", pcx);
            buf_int(pcx.hb, pcx.structs[s as usize].align);
            h(c")\n", pcx);
        }
        h(if is_union { c"union " } else { c"struct " }, pcx);
        if (repr & REPR_PACKED) != 0 && !pack_n {
            h(c"__attribute__((packed)) ", pcx);
        }
        h_name(pcx.structs[s as usize].name, pos, pcx);
        h(c" {\n", pcx);
        for i in 0..pcx.structs[s as usize].field_count {
            let f = struct_field(s, i, pcx);
            h(c"    ", pcx);
            let name = buf_new();
            buf_bytes(name, sym_text((*f).name, pcx));
            if is_c_keyword((*f).name, pcx) {
                name_error(pos, c"field '", (*f).name,
                    c"' is a C keyword: it cannot be a name in a C header (--emit-header)", pcx);
            }
            let saved = pcx.hb;
            pcx.hb = buf_new();
            h_decl_into((*f).ty, name, pos, pcx);
            let text = pcx.hb;
            pcx.hb = saved;
            buf_bytes(pcx.hb, buf_slice(text));
            h(c";\n", pcx);
        }
        h(c"}", pcx);
        if (repr & REPR_PACKED) == 0 && pcx.structs[s as usize].align > 0 {
            h(c" __attribute__((aligned(", pcx);
            buf_int(pcx.hb, pcx.structs[s as usize].align);
            h(c")))", pcx);
        }
        h(c";\n", pcx);
        if pack_n {
            h(c"#pragma pack(pop)\n", pcx);
        }
        h(c"_Static_assert(sizeof(", pcx);
        h_sym(pcx.structs[s as usize].name, pcx);
        h(c") == ", pcx);
        buf_int(pcx.hb, type_size(t, pcx));
        h(c" && _Alignof(", pcx);
        h_sym(pcx.structs[s as usize].name, pcx);
        h(c") == ", pcx);
        buf_int(pcx.hb, type_align(t, pcx));
        h(c", \"the layout of ", pcx);
        h_sym(pcx.structs[s as usize].name, pcx);
        h(c" in vole\");\n\n", pcx);
        (pcx.h_struct_state[s as usize]) = 2;
    }
}

// The C names of enum e's variants: E_V.
fn h_variant_name(e: i64, v: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        h_name((*get_enums().add(e as usize)).name, pos, pcx);
        h(c"_", pcx);
        h_sym(pcx.variants[v as usize].name, pcx);
    }
}

fn h_enum(e: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if (pcx.h_enum_state[e as usize]) != 0 {
            return;
        }
        (pcx.h_enum_state[e as usize]) = 1;
        let pos = pcx.nodes[(*get_enums().add(e as usize)).node as usize].start;
        let is_c = ((*get_enums().add(e as usize)).repr & REPR_C) != 0;
        for i in 0..(*get_enums().add(e as usize)).variant_count {
            let v = enum_variant(e, i);
            for k in 0..pcx.variants[v as usize].field_count {
                h_need(variant_field(v, k, pcx), pos, pcx);
            }
        }
        // The discriminants: an enum of constants.
        h(c"enum {", pcx);
        for i in 0..(*get_enums().add(e as usize)).variant_count {
            let v = enum_variant(e, i);
            h(if i > 0 { c", " } else { c" " }, pcx);
            h_variant_name(e, v, pos, pcx);
            if (*get_enums().add(e as usize)).has_fields {
                h(c"_TAG", pcx);
            }
            h(c" = ", pcx);
            buf_int(pcx.hb, pcx.variants[v as usize].discr);
        }
        h(c" };\n", pcx);
        let tag = (*get_enums().add(e as usize)).tag;
        if !(*get_enums().add(e as usize)).has_fields {
            // A fieldless enum is its tag's integer type.
            h(c"typedef ", pcx);
            h_base(tag, pos, pcx);
            h(c" ", pcx);
            h_name((*get_enums().add(e as usize)).name, pos, pcx);
            h(c";\n\n", pcx);
            (pcx.h_enum_state[e as usize]) = 2;
            return;
        }
        if is_c {
            // RFC 2195: the tag, then a union of one struct per variant.
            h(c"typedef struct ", pcx);
            h_name((*get_enums().add(e as usize)).name, pos, pcx);
            h(c" {\n    ", pcx);
            h_base(tag, pos, pcx);
            h(c" tag;\n    union {\n", pcx);
            for i in 0..(*get_enums().add(e as usize)).variant_count {
                let v = enum_variant(e, i);
                if pcx.variants[v as usize].field_count == 0 {
                    continue;
                }
                h(c"        struct {", pcx);
                for k in 0..pcx.variants[v as usize].field_count {
                    h(c" ", pcx);
                    h_field_decl(variant_field(v, k, pcx), k, pos, pcx);
                    h(c";", pcx);
                }
                h(c" } ", pcx);
                h_sym(pcx.variants[v as usize].name, pcx);
                h(c";\n", pcx);
            }
            h(c"    } u;\n} ", pcx);
        } else {
            // An integer tag with fields: a union of structs that start with
            // the tag.
            h(c"typedef union ", pcx);
            h_name((*get_enums().add(e as usize)).name, pos, pcx);
            h(c" {\n    ", pcx);
            h_base(tag, pos, pcx);
            h(c" tag;\n", pcx);
            for i in 0..(*get_enums().add(e as usize)).variant_count {
                let v = enum_variant(e, i);
                h(c"    struct { ", pcx);
                h_base(tag, pos, pcx);
                h(c" tag;", pcx);
                for k in 0..pcx.variants[v as usize].field_count {
                    h(c" ", pcx);
                    h_field_decl(variant_field(v, k, pcx), k, pos, pcx);
                    h(c";", pcx);
                }
                h(c" } ", pcx);
                h_sym(pcx.variants[v as usize].name, pcx);
                h(c";\n", pcx);
            }
            h(c"} ", pcx);
        }
        h_sym((*get_enums().add(e as usize)).name, pcx);
        h(c";\n_Static_assert(sizeof(", pcx);
        h_sym((*get_enums().add(e as usize)).name, pcx);
        h(c") == ", pcx);
        buf_int(pcx.hb, type_size(enum_type(e, pcx), pcx));
        h(c", \"the layout of ", pcx);
        h_sym((*get_enums().add(e as usize)).name, pcx);
        h(c" in vole\");\n\n", pcx);
        (pcx.h_enum_state[e as usize]) = 2;
    }
}

// Field k of a variant: `T _k`.
fn h_field_decl(t: i64, k: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_byte(b, b'_');
    buf_int(b, k);
    h_decl_into(t, b, pos, pcx);
}

pub fn emit_c_header(program: i64, output: *mut u8, pcx: &mut Ctx<Comp>) {
    unsafe {
        pcx.hb = buf_new();
        let all = pcx.hb;
        table_of(&mut pcx.h_struct_state, pcx.structs.len() as i64 + 1, 0);
        table_of(&mut pcx.h_forward, pcx.structs.len() as i64 + 1, 0);
        table_of(&mut pcx.h_enum_state, pcx.enum_count + 1, 0);
        // Types, then declarations, written to separate buffers.
        let decls = buf_new();
        for i in 0..pcx.nodes[program as usize].count {
            let item = child(program, i, pcx);
            let pos = pcx.nodes[item as usize].start;
            if pcx.imported_start >= 0 && pos >= pcx.imported_start {
                continue;
            }
            let kind = pcx.nodes[item as usize].kind;
            if kind == NodeKind::Fn && pcx.nodes[item as usize].y == 1 {
                let f = pcx.nodes[item as usize].x - 1;
                pcx.hb = all;
                for k in 0..pcx.fns[f as usize].param_count {
                    h_need(fn_param(f, k, pcx), pos, pcx);
                }
                h_need(pcx.fns[f as usize].ret, pos, pcx);
                pcx.hb = decls;
                if pcx.fns[f as usize].ret == TY_NEVER {
                    h(c"_Noreturn ", pcx);
                }
                let b = buf_new();
                buf_bytes(b, sym_text(pcx.fns[f as usize].name, pcx));
                if is_c_keyword(pcx.fns[f as usize].name, pcx) {
                    h_name(pcx.fns[f as usize].name, pos, pcx);
                }
                buf_byte(b, b'(');
                if pcx.fns[f as usize].param_count == 0 {
                    buf_str(b, c"void");
                }
                let saved = pcx.hb;
                for k in 0..pcx.fns[f as usize].param_count {
                    if k > 0 {
                        buf_str(b, c", ");
                    }
                    let param = child(item, k, pcx);
                    let pname = pcx.nodes[param as usize].a;
                    pcx.hb = b;
                    let n = buf_new();
                    if pname != pcx.underscore && !is_c_keyword(pname, pcx) {
                        buf_bytes(n, sym_text(pname, pcx));
                    }
                    h_decl_into(fn_param(f, k, pcx), n, pos, pcx);
                    pcx.hb = saved;
                }
                buf_byte(b, b')');
                let ret = pcx.fns[f as usize].ret;
                if ret == TY_UNIT || ret == TY_NEVER {
                    h(c"void ", pcx);
                    buf_bytes(pcx.hb, buf_slice(b));
                } else {
                    h_decl_into(ret, b, pos, pcx);
                }
                h(c";\n", pcx);
            } else if kind == NodeKind::Static && pcx.nodes[item as usize].y == 2 {
                let st = (pcx.sym_static[pcx.nodes[item as usize].a as usize]) - 1;
                let t = pcx.statics[st as usize].ty;
                pcx.hb = all;
                h_need(t, pos, pcx);
                pcx.hb = decls;
                h(c"extern ", pcx);
                if !pcx.statics[st as usize].mutable {
                    h(c"const ", pcx);
                }
                let n = buf_new();
                buf_bytes(n, sym_text(pcx.nodes[item as usize].a, pcx));
                if is_c_keyword(pcx.nodes[item as usize].a, pcx) {
                    h_name(pcx.nodes[item as usize].a, pos, pcx);
                }
                h_decl_into(t, n, pos, pcx);
                h(c";\n", pcx);
            } else if kind == NodeKind::Struct && (pcx.nodes[item as usize].c & REPR_C) != 0 {
                pcx.hb = all;
                h_struct(
                    ({
                        let at_ix = qualify(module_of(item, pcx), pcx.nodes[item as usize].a, pcx) as usize;
                        pcx.sym_struct[at_ix]
                    }) - 1,
                    pcx);
            }
            else if kind == NodeKind::Enum
                && (pcx.nodes[item as usize].c & (REPR_C | REPR_INT)) != 0 {
                pcx.hb = all;
                h_enum(({
                    let at_ix = qualify(module_of(item, pcx), pcx.nodes[item as usize].a, pcx) as usize;
                    pcx.sym_enum[at_ix]
                }) - 1,
                    pcx);
            }
        }
        let out = buf_new();
        let guard = buf_new();
        let base = path_basename(output);
        for i in 0..strlen(base) as i64 {
            let c = (*base.add(i as usize));
            if is_alpha(c) || is_digit(c) {
                buf_byte(guard, if c >= b'a' && c <= b'z' { c - 32 } else { c });
            } else {
                buf_byte(guard, b'_');
            }
        }
        buf_str(guard, c"_INCLUDED");
        buf_str(out,
            c"/* Generated by volec --emit-header: the C view of a vole program. */\n#ifndef ");
        buf_bytes(out, buf_slice(guard));
        buf_str(out, c"\n#define ");
        buf_bytes(out, buf_slice(guard));
        buf_str(out, c"\n\n#include <stdbool.h>\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n");
        buf_bytes(out, buf_slice(all));
        buf_bytes(out, buf_slice(decls));
        buf_str(out, c"\n#ifdef __cplusplus\n}\n#endif\n\n#endif\n");
        buf_write_file(out, output);
    }
}

fn path_basename(path: *mut u8) -> *mut u8 {
    unsafe {
        let n = strlen(path) as i64;
        let mut i = n - 1;
        while i >= 0 && (*path.add(i as usize)) != b'/' {
            i -= 1;
        }
        path.add((i + 1) as usize)
    }
}
