// std read from its files (0.17). In the vole repository, an edit of a
// std item (`volec edit patch std::trim`, `edit insert --after
// Vec::push`) loads std from compiler/std/*.vl, the files embed.sh joins
// into the text built into the compiler: each one a source file of the
// module `std` under its own path, so that its items are edited, checked
// and reported where they are written (tools/edit/stdedit.vl). The rest
// of the time std is the built-in text (stdsrc.vl).
//
// (0.20) std is a tree of modules: the root's files are std_tree_file's,
// and their `mod NAME;` lines are std::NAME, in compiler/std/NAME.vl (or
// NAME/mod.vl), loaded as any program's modules are (front/modules:
// module_candidate). In the built-in text they follow the root's files as
// `mod NAME { }` (embed.sh); std_files says where each file's text is.

use crate::base::{
    IntVec, add_source, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_bufs, get_src,
    read_file, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::front::stdalloc::{get_check_alloc_linux, get_check_alloc_mode};
use crate::front::stdsrc::{std_files, std_source, std_sys_len, std_sys_source};
use crate::tools::proc::{buf_cstr, read_file_if};

// Std's k-th root file in embed.sh's order (ROOT_FILES; then Gpa's
// implementation, the checking one with --check-alloc), without its
// `.vl`; 0 past the last. (0.20: std.vl, then the files of the one
// module std was, in flat/; add_std_tree skips those that are gone.)
pub fn std_tree_file(k: i64) -> *mut u8 {
    if k == 0 { c"std" }
    else if k == 1 { c"flat/iter" }
    else if k == 2 { c"flat/io" }
    else if k == 3 { c"flat/fmt" }
    else if k == 4 { c"flat/convert" }
    else if k == 5 { c"flat/clone" }
    else if k == 6 { c"flat/alloc" }
    else if k == 7 { c"flat/values" }
    // (0.18: the lazy sections of tests and non-null pointers)
    else if k == 8 { c"flat/test" }
    else if k == 9 { c"flat/nonnull" }
    // (0.18 T3: the fuzzer's lazy section)
    else if k == 10 { c"flat/fuzz" }
    // (0.18.1: the heaps and more of Vec, lazy sections)
    else if k == 11 { c"flat/collections" }
    // (0.19: std::arch's run-time detection, lazy sections)
    else if k == 12 { c"flat/arch" }
    else if k == 13 { if get_check_alloc_mode() { c"alloc_check" } else { c"gpa" } }
    else { 0 as *mut u8 }
}

// The path of std's k-th file in dir: DIR/NAME.vl.
pub fn std_file_path(dir: *mut u8, k: i64) -> *mut u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        buf_byte(b, b'/');
        buf_str(b, std_tree_file(k));
        buf_str(b, c".vl");
        buf_byte(b, 0);
        (*get_bufs().add(b as usize)).data
    }
}

// DIR/NAME as a C string.
pub fn tree_path(dir: *mut u8, name: *mut u8) -> *mut u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        buf_byte(b, b'/');
        buf_str(b, name);
        buf_byte(b, 0);
        (*get_bufs().add(b as usize)).data
    }
}

// Whether dir holds std's files (its std.vl and embed.sh).
pub fn is_std_tree(dir: *mut u8, pcx: &Ctx<Comp>) -> bool {
    file_exists(tree_path(dir, c"std.vl"), pcx) && file_exists(tree_path(dir, c"embed.sh"), pcx)
}

pub fn std_tree_env(gpa: Gpa, pcx: &mut Ctx<Comp>) {
    match std::env::var_in("VOLE_STD_TREE", gpa) {
        Ok(d) => {
            let b = buf_new();
            buf_bytes(b, d.as_bytes());
            pcx.std_tree_env = buf_cstr(b);
        }
        Err(_) => {}
    }
    // RULE: Z1.1 (0.27.2: std2 is a rust program's std; VOLE_STD2=0 reads
    // MVS's instead, for the cases written against it until they migrate:
    // gone by the release)
    pcx.std2 = true;
    // (VOLE_STD2_NORERUN=1: a lazy build's errors as they are, not made
    // again whole: the twin's, lazy against eager)
    match std::env::var_in("VOLE_STD2_NORERUN", gpa) {
        Ok(_) => crate::front::modules::std2lazy::set_norerun(true),
        Err(_) => {}
    }
    // (0.27.3) VOLE_STD2_EAGER=1: std2 read whole (front/modules/std2lazy.vl)
    match std::env::var_in("VOLE_STD2_EAGER", gpa) {
        Ok(v) => crate::front::modules::std2lazy::set_eager(v.as_bytes() == b"1"),
        Err(_) => {}
    }
    // RULE: Z5.2 (0.27.5) VOLE_STD2_INDEX=0: std2 lexed whole, not by its
    // index; VOLE_STD2_DUMP=FILE: the tokens kept written there (the test)
    match std::env::var_in("VOLE_STD2_INDEX", gpa) {
        Ok(v) => crate::front::modules::std2lazy::set_index_off(v.as_bytes() == b"0"),
        Err(_) => {}
    }
    match std::env::var_in("VOLE_STD2_DUMP", gpa) {
        Ok(v) => {
            let b = buf_new();
            buf_bytes(b, v.as_bytes());
            crate::front::modules::std2lazy::set_dump(buf_cstr(b));
        }
        Err(_) => {}
    }
    match std::env::var_in("VOLE_STD2", gpa) {
        Ok(v) => {
            pcx.std2 = v.as_bytes() != b"0";
        }
        Err(_) => {}
    }
}

// The directory of std's files: compiler/std in the current directory or
// one of the three above it; 0 when there is none (std is the compiler's).
pub fn find_std_tree(pcx: &Ctx<Comp>) -> *mut u8 {
    if pcx.std_tree_env != 0 as *mut u8 && is_std_tree(pcx.std_tree_env, pcx) {
        return pcx.std_tree_env;
    }
    let ups = [c"compiler/std", c"../compiler/std", c"../../compiler/std",
        c"../../../compiler/std"];
    for k in 0..4 {
        if is_std_tree(ups[k as usize], pcx) {
            return ups[k as usize];
        }
    }
    0 as *mut u8
}

// (0.25.5) The target's system file under std's tree: sys/linux.vl or
// sys/macos.vl (std_alloc_tail's std_sys_source is its built-in text).
fn sys_file() -> *mut u8 {
    if get_check_alloc_linux() { c"sys/linux.vl" } else { c"sys/macos.vl" }
}

// Std's files from STD_TREE (an edit's copies in their place: OVERLAY),
// then std::CHECK_ALLOC as std_alloc_tail writes it, as sources of module
// m: the first one's file; *start, *end: the text's bytes in SRC.
pub fn add_std_tree(m: i64, start: &mut i64, end: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    let first = pcx.files.len() as i64;
    let mut k: i64 = 0;
    while std_tree_file(k) != 0 as *mut u8 {
        let text = buf_new();
        let path = std_file_path(pcx.std_tree, k);
        if k > 0 && !file_exists(path, pcx) {
            k += 1;
            continue;
        }
        read_file(path, text, pcx);
        let s = add_source(path, text, pcx);
        if k == 0 {
            *start = s;
        }
        { let at_ix = (pcx.files.len() as i64 - 1) as usize; pcx.files[at_ix].module = m };
        k += 1;
    }
    let tail = buf_new();
    if get_check_alloc_mode() {
        buf_str(tail, c"pub const CHECK_ALLOC: bool = true;\n");
        buf_str(tail, if get_check_alloc_linux() { c"const CHECK_ALLOC_OS: i64 = 1;\n" }
            else { c"const CHECK_ALLOC_OS: i64 = 0;\n" });
    } else {
        buf_str(tail, c"pub const CHECK_ALLOC: bool = false;\n");
    }
    // (0.20) the target's system, as std_alloc_tail; (0.25.5) from its
    // file when the tree has it, so that an item added there is seen
    // before the compiler is rebuilt (the check hook's false
    // `std::sys_c_strerror_r` errors of 0.25.4)
    let sys = tree_path(pcx.std_tree, sys_file());
    let sys_text = buf_new();
    let own = read_file_if(sys, sys_text);
    if !own {
        std_sys_source(tail, get_check_alloc_linux());
    }
    add_source(c"<std>", tail, pcx);
    { let at_ix = (pcx.files.len() as i64 - 1) as usize; pcx.files[at_ix].module = m };
    if own {
        add_source(sys, sys_text, pcx);
        { let at_ix = (pcx.files.len() as i64 - 1) as usize; pcx.files[at_ix].module = m };
    }
    *end = pcx.files[(pcx.files.len() as i64 - 1) as usize].end;
    first
}

// ---- (0.17) Positions in std's built-in text, in std's files ----

// Whether position pos, in file f, is in std's built-in text and std's
// files (find_std_tree) hold that text: then *path is the file holding it,
// *line its line there (the tools print `compiler/std/io.vl:102`, not
// `<std>:2075`, in the vole repository).
pub fn std_file_line(f: i64, pos: i64, path: *mut *mut u8, line: &mut i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if pcx.std_tree != 0 as *mut u8 || !streq(pcx.files[f as usize].path, c"<std>") {
            return false;
        }
        if pcx.map_state == 0 {
            pcx.map_state = if map_std_files(f, pcx) { 1 } else { 2 };
        }
        let off = pos - pcx.files[f as usize].start;
        if pcx.map_state != 1 || off < 0
            || off >= (*pcx.map_start.data.add(pcx.map_path.count as usize)) {
            return false;
        }
        let mut k: i64 = 0;
        while k + 1 < pcx.map_path.count && (*pcx.map_start.data.add((k + 1) as usize)) <= off {
            k += 1;
        }
        if off >= (*pcx.map_end.data.add(k as usize)) {
            // (a module's banner or brace, in no file)
            return false;
        }
        let mut n: i64 = 1;
        for i in pcx.files[f as usize].start + (*pcx.map_start.data.add(k as usize))..pos {
            if get_src()[i as usize] == b'\n' {
                n += 1;
            }
        }
        *path = (*pcx.map_path.data.add(k as usize)) as *mut u8;
        *line = n;
        true
    }
}

// MAP_START, MAP_END and MAP_PATH for std's text in file f; false when
// std's files are not there or are not that text.
fn map_std_files(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        let dir = find_std_tree(pcx);
        if dir == 0 as *mut u8 {
            return false;
        }
        let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        built_files(&mut starts, &mut names);
        // (then Gpa's implementation, std_alloc_tail's)
        let mut last: i64 = 0;
        while std_tree_file(last + 1) != 0 as *mut u8 {
            last += 1;
        }
        for k in 0..names.count + 1 {
            let path = if k
                < names.count { tree_path(dir, (*names.data.add(k as usize)) as *mut u8) }
                else { std_file_path(dir, last) };
            let text = buf_new();
            if !read_file_if(path, text) {
                return false;
            }
            let t = buf_slice(text);
            let off = (*starts.data.add(k as usize));
            let at = pcx.files[f as usize].start + off;
            if off + t.len() as i64 > pcx.files[f as usize].end - pcx.files[f as usize].start
                || &get_src()[at as usize..(at + t.len() as i64) as usize] != t {
                return false;
            }
            pcx.map_start.push(off);
            pcx.map_end.push(off + t.len() as i64);
            pcx.map_path.push(path as i64);
        }
        // (0.25.3) then the target's system, std's text's end (std_alloc_tail):
        // sys/linux.vl or sys/macos.vl, when it is that text
        let sys = tree_path(dir, sys_file());
        let text = buf_new();
        if read_file_if(sys, text) {
            let t = buf_slice(text);
            let size = pcx.files[f as usize].end - pcx.files[f as usize].start;
            let off = size - t.len() as i64;
            if off >= (*pcx.map_end.data.add(names.count as usize))
                && get_src()[
                    (pcx.files[f as usize].start + off) as usize..pcx.files[f as usize].end as usize] == t {
                pcx.map_start.push(off);
                pcx.map_end.push(size);
                pcx.map_path.push(sys as i64);
            }
        }
        pcx.map_start.push((*pcx.map_end.data.add((pcx.map_path.count - 1) as usize)));
        true
    }
}

// (0.20) std's files in the built-in text (stdsrc.vl: std_files): where
// each starts, then where the last module ends, into starts; their paths
// under compiler/std (C strings) into names.
pub fn built_files(starts: &mut IntVec, names: &mut IntVec) {
    let b = buf_new();
    std_files(b);
    files_table(b, starts, names);
}

// (0.28.0) The same of std2's built-in text (stdsrc_rust.vl: std2_files):
// the paths under compiler/std2.
pub fn built_files_std2(starts: &mut IntVec, names: &mut IntVec) {
    let b = buf_new();
    crate::front::stdsrc_rust::std2_files(b);
    files_table(b, starts, names);
}

// embed.sh's table of files in buffer b, `START PATH` a line, then the
// end alone, into starts and names.
fn files_table(b: i64, starts: &mut IntVec, names: &mut IntVec) {
    // UNSAFE: a name's buffer is given out as a C string.
    // SAFETY: the buffer is NUL-terminated just above, and buffers live
    // for the process.
    unsafe {
        let t = buf_slice(b);
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut v: i64 = 0;
            while i < t.len() as i64 && t[i as usize] >= b'0' && t[i as usize] <= b'9' {
                v = v * 10 + (t[i as usize] - b'0') as i64;
                i += 1;
            }
            starts.push(v);
            if i < t.len() as i64 && t[i as usize] == b' ' {
                i += 1;
                let name = buf_new();
                while i < t.len() as i64 && t[i as usize] != b'\n' {
                    buf_byte(name, t[i as usize]);
                    i += 1;
                }
                buf_byte(name, 0);
                names.push((*get_bufs().add(name as usize)).data as i64);
            }
            i += 1;
        }
    }
}

// Whether std's files in dir are not the text built into this compiler
// (std edited since it was built): `volec check` then checks with them
// (tools/edit/cli.vl: run_check).
pub fn std_files_differ(dir: *mut u8) -> bool {
    unsafe {
        let built = buf_new();
        std_source(built);
        let b = buf_slice(built);
        let mut starts = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut names = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        built_files(&mut starts, &mut names);
        for k in 0..names.count {
            let text = buf_new();
            if !read_file_if(tree_path(dir, (*names.data.add(k as usize)) as *mut u8), text) {
                return true;
            }
            let t = buf_slice(text);
            let off = (*starts.data.add(k as usize));
            // (a file's text, then the next one's or a module's banner)
            if off + t.len() as i64 >= b.len() as i64
                || &b[off as usize..(off + t.len() as i64) as usize] != t
                || off + t.len() as i64 != (*starts.data.add((k + 1) as usize))
                && b[(off + t.len() as i64) as usize] != b'/' {
                return true;
            }
        }
        // (then Gpa's implementation and std::CHECK_ALLOC, std_alloc_tail's)
        let mut last: i64 = 0;
        while std_tree_file(last + 1) != 0 as *mut u8 {
            last += 1;
        }
        let gpa = buf_new();
        if !read_file_if(std_file_path(dir, last), gpa) {
            return true;
        }
        let g = buf_slice(gpa);
        let end = (*starts.data.add(names.count as usize));
        let alloc_line = "pub const CHECK_ALLOC: bool = false;\n".len() as i64;
        if end + g.len() as i64 > b.len() as i64
            || &b[end as usize..(end + g.len() as i64) as usize] != g
            || b.len() as i64 - end - g.len() as i64 != alloc_line + std_sys_len() {
            return true;
        }
        // (0.25.5) then the target's system, sys/linux.vl or sys/macos.vl
        // (add_std_tree reads it from the tree too)
        let sys = buf_new();
        read_file_if(tree_path(dir, sys_file()), sys)
            && b[(end + g.len() as i64 + alloc_line) as usize..] != buf_slice(sys)
    }
}

// (0.27.2) std2's text as `embed.sh --edition rust` assembles it, from
// the files of the tree's compiler/std2 (std_tree's sibling): its root
// std.vl, then each `mod NAME;` of a file as `mod NAME { .. }` after that
// file's text, its own modules nested, under embed.sh's banners. False
// when the tree has no std2 (the built-in text is read). RULE: Z4.2
pub fn std2_tree_text(out: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.std_tree == 0 as *mut u8 {
        return false;
    }
    let dir = tree_path(pcx.std_tree, c"../std2");
    if !file_exists(tree_path(dir, c"std.vl"), pcx) {
        return false;
    }
    std2_walk(out, dir, b"std", b"", b"std", pcx)
}

// The text of module `path` (std, std::a): its file (`file`, relative to
// dir, without `.vl`), then its modules, whose files are under `nested`
// (relative, with its `/`, or empty); false when a file is missing.
fn std2_walk(out: i64, dir: *mut u8, path: &[u8], nested: &[u8], file: &[u8], pcx: &Ctx<Comp>) -> bool {
    let text = buf_new();
    if !read_file_if(rel_path(dir, file, b".vl"), text) {
        return false;
    }
    buf_bytes(out, buf_slice(text));
    let t = buf_slice(text);
    let n = t.len() as i64;
    let mut i: i64 = 0;
    while i < n {
        let mut e = i;
        while e < n && t[e as usize] != b'\n' {
            e += 1;
        }
        // (`mod NAME;` or `pub mod NAME;` at a line's start, embed.sh's sed)
        let mut j = i;
        let public = e - j >= 4 && t[j as usize..(j + 4) as usize] == b"pub ";
        if public {
            j += 4;
        }
        if e - j >= 4 && t[j as usize..(j + 4) as usize] == b"mod " {
            j += 4;
            let s = j;
            while j < e
                && (t[j as usize] == b'_' || t[j as usize] >= b'a' && t[j as usize] <= b'z'
                    || t[j as usize] >= b'A' && t[j as usize] <= b'Z'
                    || j > s && t[j as usize] >= b'0' && t[j as usize] <= b'9') {
                j += 1;
            }
            if j > s && j < e && t[j as usize] == b';' {
                let name = &t[s as usize..j as usize];
                if !std2_module(out, dir, path, nested, name, public, pcx) {
                    return false;
                }
            }
        }
        i = e + 1;
    }
    true
}

// Module `path::name`'s text, as embed.sh writes it: its banner, `mod
// name {`, its files (NESTED/name.vl or NESTED/name/mod.vl), `}`.
fn std2_module(out: i64, dir: *mut u8, path: &[u8], nested: &[u8], name: &[u8], public: bool,
    pcx: &Ctx<Comp>) -> bool {
    let fb = buf_new();
    buf_bytes(fb, nested);
    buf_bytes(fb, name);
    let flat = buf_new();
    buf_bytes(flat, buf_slice(fb));
    if !file_exists(rel_path(dir, buf_slice(fb), b".vl"), pcx) {
        buf_str(fb, c"/mod");
    }
    let sub = buf_new();
    buf_bytes(sub, path);
    buf_str(sub, c"::");
    buf_bytes(sub, name);
    let inner = buf_new();
    buf_bytes(inner, buf_slice(flat));
    buf_byte(inner, b'/');
    buf_str(out, c"// ---- mod ");
    buf_bytes(out, buf_slice(sub));
    buf_str(out, c" ----\n");
    if public {
        buf_str(out, c"pub ");
    }
    buf_str(out, c"mod ");
    buf_bytes(out, name);
    buf_str(out, c" {\n");
    if !std2_walk(out, dir, buf_slice(sub), buf_slice(inner), buf_slice(fb), pcx) {
        return false;
    }
    buf_str(out, c"// ---- end mod ");
    buf_bytes(out, buf_slice(sub));
    buf_str(out, c" ----\n}\n");
    true
}

// DIR/REL followed by ext, as a C string.
fn rel_path(dir: *mut u8, rel: &[u8], ext: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    buf_byte(b, b'/');
    buf_bytes(b, rel);
    buf_bytes(b, ext);
    buf_cstr(b)
}
