// std read from its files (0.17). In the vole repository std's files
// (compiler/std/*.vl, with compiler/std/embed.sh) can stand in for the
// text built into the compiler (stdsrc_rust.vl): `volec check` reads them
// when they are not that text (std edited since the compiler was built),
// and a query reads them always, as embed.sh joins them: one text, `<std>`,
// whose positions the tools print in the files (std_file_line).
//
// (0.20) std is a tree of modules: the root is std.vl, and a file's `mod
// NAME;` lines are its modules, in NAME.vl (or NAME/mod.vl) under the
// file's own directory. In the text they follow their parent's file as
// `mod NAME { }` (embed.sh).

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_bufs, get_src, streq,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cpp::directives::file_exists;
use crate::tools::proc::{buf_cstr, read_file_if};

// DIR/NAME as a C string.
pub fn tree_path(dir: *mut u8, name: *mut u8) -> *mut u8 {
    unsafe {
        let b = buf_new();
        buf_str(b, dir);
        buf_byte(b, b'/');
        buf_str(b, name);
        buf_byte(b, 0);
        (*get_bufs().add(b as usize)).data
    }
}

// Whether dir holds std's files (its std.vl and embed.sh).
pub fn is_std_tree(dir: *mut u8, pcx: &Ctx<Comp>) -> bool {
    file_exists(tree_path(dir, c"std.vl"), pcx) && file_exists(tree_path(dir, c"embed.sh"), pcx)
}

pub fn std_tree_env(gpa: Gpa, pcx: &mut Ctx<Comp>) {
    match std::env::var_in("VOLE_STD_TREE", gpa) {
        Ok(d) => {
            let b = buf_new();
            buf_bytes(b, d.as_bytes());
            pcx.std_tree_env = buf_cstr(b);
        }
        Err(_) => {}
    }
    // (VOLE_STD2_NORERUN=1: a lazy build's errors as they are, not made
    // again whole: the twin's, lazy against eager)
    match std::env::var_in("VOLE_STD2_NORERUN", gpa) {
        Ok(_) => crate::front::modules::std2lazy::set_norerun(true),
        Err(_) => {}
    }
    // (0.27.3) VOLE_STD2_EAGER=1: std2 read whole (front/modules/std2lazy.vl)
    match std::env::var_in("VOLE_STD2_EAGER", gpa) {
        Ok(v) => crate::front::modules::std2lazy::set_eager(v.as_bytes() == b"1"),
        Err(_) => {}
    }
    // RULE: Z5.2 (0.27.5) VOLE_STD2_INDEX=0: std2 lexed whole, not by its
    // index; VOLE_STD2_DUMP=FILE: the tokens kept written there (the test)
    match std::env::var_in("VOLE_STD2_INDEX", gpa) {
        Ok(v) => crate::front::modules::std2lazy::set_index_off(v.as_bytes() == b"0"),
        Err(_) => {}
    }
    match std::env::var_in("VOLE_STD2_DUMP", gpa) {
        Ok(v) => {
            let b = buf_new();
            buf_bytes(b, v.as_bytes());
            crate::front::modules::std2lazy::set_dump(buf_cstr(b));
        }
        Err(_) => {}
    }
}

// Std's directory: compiler/std in the current directory or one of the
// three above it; 0 when there is none (std is the compiler's).
pub fn find_std_tree(pcx: &Ctx<Comp>) -> *mut u8 {
    // ($VOLE_STD_TREE=none: std is the compiler's, wherever the run is:
    // the tests' transcripts)
    if pcx.std_tree_env != 0 as *mut u8 && streq(pcx.std_tree_env, c"none") {
        return 0 as *mut u8;
    }
    if pcx.std_tree_env != 0 as *mut u8 && is_std_tree(pcx.std_tree_env, pcx) {
        return pcx.std_tree_env;
    }
    let ups = [c"compiler/std", c"../compiler/std", c"../../compiler/std",
        c"../../../compiler/std"];
    for k in 0..4 {
        if is_std_tree(ups[k as usize], pcx) {
            return ups[k as usize];
        }
    }
    0 as *mut u8
}

// ---- (0.17) Positions in std's built-in text, in std's files ----

// Whether position pos, in file f, is in std's text and std's files
// (find_std_tree) hold that text: then *path is the file holding it,
// *line its line there (the tools print `compiler/std/io.vl:102`, not
// `<std>:2075`, in the vole repository).
pub fn std_file_line(f: i64, pos: i64, path: *mut *mut u8, line: &mut i64, pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if !streq(pcx.files[f as usize].path, c"<std>") {
            return false;
        }
        if pcx.map_state == 0 {
            pcx.map_state = if map_std_files(f, pcx) { 1 } else { 2 };
        }
        let off = pos - pcx.files[f as usize].start;
        if pcx.map_state != 1 || off < 0
            || off >= (pcx.map_start[pcx.map_path.len() as i64 as usize]) {
            return false;
        }
        let mut k: i64 = 0;
        while k + 1 < pcx.map_path.len() as i64 && (pcx.map_start[(k + 1) as usize]) <= off {
            k += 1;
        }
        if off >= (pcx.map_end[k as usize]) {
            // (a module's banner or brace, in no file)
            return false;
        }
        let mut n: i64 = 1;
        for i in pcx.files[f as usize].start + (pcx.map_start[k as usize])..pos {
            if get_src()[i as usize] == b'\n' {
                n += 1;
            }
        }
        *path = (pcx.map_path[k as usize]) as *mut u8;
        *line = n;
        true
    }
}

// (0.28.0) The line in std's text (the `<std>` file, through *f) of line
// `line` of std's file `file` (`compiler/std/str.vl`, as the tools print
// it), or -1 when std's files are not that text or none is `file`.
pub fn std_text_line(file: &[u8], line: i64, f: &mut i64, pcx: &mut Ctx<Comp>) -> i64 {
    let sf = pcx.std_file;
    if sf < 0 || !streq(pcx.files[sf as usize].path, c"<std>") {
        return -1;
    }
    if pcx.map_state == 0 {
        pcx.map_state = if map_std_files(sf, pcx) { 1 } else { 2 };
    }
    if pcx.map_state != 1 {
        return -1;
    }
    for k in 0..pcx.map_path.len() as i64 {
        let p = crate::base::cstr((pcx.map_path[k as usize]) as *mut u8);
        let n = p.len();
        let m = file.len();
        let same = n == m && p == file
            || n > m && p[n - m..] == file && p[n - m - 1] == b'/'
            || m > n && file[m - n..] == p && file[m - n - 1] == b'/';
        if !same {
            continue;
        }
        let start = pcx.files[sf as usize].start;
        let mut at: i64 = 1;
        for i in start..start + (pcx.map_start[k as usize]) {
            if get_src()[i as usize] == b'\n' {
                at += 1;
            }
        }
        *f = sf;
        return at + line - 1;
    }
    -1
}

// MAP_START, MAP_END and MAP_PATH for std's text in file f; false when
// std's files are not there or are not that text (as embed.sh joins them:
// the text's start, before the compiler's tail).
fn map_std_files(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    let dir = find_std_tree(pcx);
    if dir == 0 as *mut u8 {
        return false;
    }
    let text = buf_new();
    let mut map = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    if !std2_walk(text, dir, b"std", b"", b"std", &mut map, pcx) {
        return false;
    }
    let t = buf_slice(text);
    let at = pcx.files[f as usize].start;
    if t.len() as i64 > pcx.files[f as usize].end - at || map.len() as i64 == 0
        || &get_src()[at as usize..(at + t.len() as i64) as usize] != t {
        return false;
    }
    let mut k: i64 = 0;
    while k < map.len() as i64 {
        pcx.map_start.push(map.get(k));
        pcx.map_end.push(map.get(k + 1));
        pcx.map_path.push(map.get(k + 2));
        k += 3;
    }
    pcx.map_start.push(t.len() as i64);
    true
}

// (0.28.0) std's files in the built-in text (stdsrc_rust.vl: std2_files):
// where each starts, then where the last module ends, into starts; their
// paths under compiler/std (C strings) into names.
pub fn built_files_std2(starts: &mut Vec<i64, Comp>, names: &mut Vec<i64, Comp>) {
    let b = buf_new();
    crate::front::stdsrc_rust::std2_files(b);
    files_table(b, starts, names);
}

// embed.sh's table of files in buffer b, `START PATH` a line, then the
// end alone, into starts and names.
fn files_table(b: i64, starts: &mut Vec<i64, Comp>, names: &mut Vec<i64, Comp>) {
    // UNSAFE: a name's buffer is given out as a C string.
    // SAFETY: the buffer is NUL-terminated just above, and buffers live
    // for the process.
    unsafe {
        let t = buf_slice(b);
        let mut i: i64 = 0;
        while i < t.len() as i64 {
            let mut v: i64 = 0;
            while i < t.len() as i64 && t[i as usize] >= b'0' && t[i as usize] <= b'9' {
                v = v * 10 + (t[i as usize] - b'0') as i64;
                i += 1;
            }
            starts.push(v);
            if i < t.len() as i64 && t[i as usize] == b' ' {
                i += 1;
                let name = buf_new();
                while i < t.len() as i64 && t[i as usize] != b'\n' {
                    buf_byte(name, t[i as usize]);
                    i += 1;
                }
                buf_byte(name, 0);
                names.push((*get_bufs().add(name as usize)).data as i64);
            }
            i += 1;
        }
    }
}

// Whether std's files, for std's directory dir, are not the text built
// into this compiler (std edited since it was built): `volec check` then
// checks with them (tools/edit/cli.vl: run_check).
pub fn std_files_differ(dir: *mut u8, pcx: &Ctx<Comp>) -> bool {
    let text = buf_new();
    let mut map = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    if !std2_walk(text, dir, b"std", b"", b"std", &mut map, pcx) {
        return false;
    }
    let built = buf_new();
    crate::front::stdsrc_rust::std2_source(built);
    if buf_slice(text) != buf_slice(built) {
        return true;
    }
    // (the tail's files, front/stdalloc.vl: std2_tail reads them too)
    let gpa = buf_new();
    let own_gpa = buf_new();
    crate::front::stdsrc_rust::std2_gpa_source(gpa);
    if read_file_if(tree_path(dir, c"rt/gpa.vl"), own_gpa) && buf_slice(gpa) != buf_slice(own_gpa) {
        return true;
    }
    let linux = crate::front::stdalloc::get_check_alloc_linux();
    let sys = buf_new();
    let own_sys = buf_new();
    crate::front::stdsrc_rust::std2_sys_source(sys, linux);
    read_file_if(tree_path(dir, if linux { c"rt/sys_linux.vl" } else { c"rt/sys_macos.vl" }),
        own_sys)
        && buf_slice(sys) != buf_slice(own_sys)
}

// (0.27.2) std2's text as embed.sh assembles it, from the files of the
// tree's compiler/std (std_tree): its root
// std.vl, then each `mod NAME;` of a file as `mod NAME { .. }` after that
// file's text, its own modules nested, under embed.sh's banners. False
// when the tree has no std2 (the built-in text is read). RULE: Z4.2
pub fn std2_tree_text(out: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.std_tree == 0 as *mut u8 {
        return false;
    }
    let dir = pcx.std_tree;
    if !file_exists(tree_path(dir, c"std.vl"), pcx) {
        return false;
    }
    let mut map = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    std2_walk(out, dir, b"std", b"", b"std", &mut map, pcx)
}

// The text of module `path` (std, std::a): its file (`file`, relative to
// dir, without `.vl`), then its modules, whose files are under `nested`
// (relative, with its `/`, or empty); false when a file is missing. Into
// map, for each file: where its text starts in out, where it ends, its
// path (a C string).
fn std2_walk(out: i64, dir: *mut u8, path: &[u8], nested: &[u8], file: &[u8], map: &mut IntVec,
    pcx: &Ctx<Comp>) -> bool {
    let text = buf_new();
    let name = rel_path(dir, file, b".vl");
    if !read_file_if(name, text) {
        return false;
    }
    map.push(buf_slice(out).len() as i64);
    buf_bytes(out, buf_slice(text));
    map.push(buf_slice(out).len() as i64);
    map.push(name as i64);
    let t = buf_slice(text);
    let n = t.len() as i64;
    let mut i: i64 = 0;
    while i < n {
        let mut e = i;
        while e < n && t[e as usize] != b'\n' {
            e += 1;
        }
        // (`mod NAME;` or `pub mod NAME;` at a line's start, embed.sh's sed)
        let mut j = i;
        let public = e - j >= 4 && t[j as usize..(j + 4) as usize] == b"pub ";
        if public {
            j += 4;
        }
        if e - j >= 4 && t[j as usize..(j + 4) as usize] == b"mod " {
            j += 4;
            let s = j;
            while j < e
                && (t[j as usize] == b'_' || t[j as usize] >= b'a' && t[j as usize] <= b'z'
                    || t[j as usize] >= b'A' && t[j as usize] <= b'Z'
                    || j > s && t[j as usize] >= b'0' && t[j as usize] <= b'9') {
                j += 1;
            }
            if j > s && j < e && t[j as usize] == b';' {
                let name = &t[s as usize..j as usize];
                if !std2_module(out, dir, path, nested, name, public, map, pcx) {
                    return false;
                }
            }
        }
        i = e + 1;
    }
    true
}

// Module `path::name`'s text, as embed.sh writes it: its banner, `mod
// name {`, its files (NESTED/name.vl or NESTED/name/mod.vl), `}`.
fn std2_module(out: i64, dir: *mut u8, path: &[u8], nested: &[u8], name: &[u8], public: bool,
    map: &mut IntVec, pcx: &Ctx<Comp>) -> bool {
    let fb = buf_new();
    buf_bytes(fb, nested);
    buf_bytes(fb, name);
    let flat = buf_new();
    buf_bytes(flat, buf_slice(fb));
    if !file_exists(rel_path(dir, buf_slice(fb), b".vl"), pcx) {
        buf_str(fb, c"/mod");
    }
    let sub = buf_new();
    buf_bytes(sub, path);
    buf_str(sub, c"::");
    buf_bytes(sub, name);
    let inner = buf_new();
    buf_bytes(inner, buf_slice(flat));
    buf_byte(inner, b'/');
    buf_str(out, c"// ---- mod ");
    buf_bytes(out, buf_slice(sub));
    buf_str(out, c" ----\n");
    if public {
        buf_str(out, c"pub ");
    }
    buf_str(out, c"mod ");
    buf_bytes(out, name);
    buf_str(out, c" {\n");
    if !std2_walk(out, dir, buf_slice(sub), buf_slice(inner), buf_slice(fb), map, pcx) {
        return false;
    }
    buf_str(out, c"// ---- end mod ");
    buf_bytes(out, buf_slice(sub));
    buf_str(out, c" ----\n}\n");
    true
}

// DIR/REL followed by ext, as a C string.
fn rel_path(dir: *mut u8, rel: &[u8], ext: &[u8]) -> *mut u8 {
    let b = buf_new();
    buf_str(b, dir);
    buf_byte(b, b'/');
    buf_bytes(b, rel);
    buf_bytes(b, ext);
    buf_cstr(b)
}
