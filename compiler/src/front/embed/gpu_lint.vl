// The check-time forms of GPU diagnostics 2, 3, 4 and 6 (0.26.2, plan
// §10.2): what one function's text makes certain about std::gpu's calls,
// after the checker, in a program that has an `embed wgsl` block.
//
// One rule: a value is followed only when a `let` (or a `var` never
// assigned) binds it, its name bound once in the function, to
//   - `dev.shader_wgsl(K.src)` (a shader of block K's module),
//   - `dev.compute_pipeline(s, ..)` or `dev.render_pipeline(..)` of such a
//     shader (a pipeline of K),
//   - `p.bind_layout(G)` with G a literal (group G of K),
//   - `dev.buffer(n, U)` or `dev.buffer_init(b, U)` with U a constant
//     (`BufferUsage::A | BufferUsage::B`: its usage);
// and a `dev.bind_group(l, [gpu::bind(B, b), ..][..])` is read only when
// its entries are an array literal. Nothing that came from elsewhere (a
// parameter, a field, a call of another function) is followed, so nothing
// is reported that the text does not make certain. std::gpu's functions
// are known by their resolved FNS entries.
//
//   gpu.entry   `compute_pipeline(s, "mian")`, `RenderDesc::new(s, "vs",
//               "fs", ..)`: an entry name that is no entry point of the
//               stage in K's module; the fix, K's field
//   gpu.layout  an entry of a bind group for K's group G that K's module
//               does not declare, or of another kind (a buffer for a
//               texture, a uniform buffer for storage)
//   gpu.usage   a buffer of constant usage used where it needs a flag its
//               usage lacks; the try: the usage with the flag
//   gpu.unwritten (a warning) a buffer bound at a uniform binding that no
//               write_buffer, map_write or copy in the function writes,
//               and that is never passed elsewhere or stored
//
// A module's bindings come from the scan of its text (wgsl.vl: BIND_),
// never from std::gpu::wgsl's reflection (which reaches the writers).

use crate::base::{
    buf_byte, buf_bytes, buf_int, buf_new, buf_slice, get_src, intern, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_file_line, err_begin, err_end_soft, err_fix, err_fmt, err_help, err_try_tool,
    report_warning,
};
use crate::front::ast::{NodeKind, child};
use crate::front::check::names::near_to;
use crate::front::embed::ctx::EmbedCx;
use crate::front::embed::wgsl::{
    BK_SAMPLER, BK_STORAGE, BK_STORAGE_RW, BK_TEXTURE, BK_UNIFORM, STAGE_COMPUTE, STAGE_FRAGMENT,
    STAGE_VERTEX,
};
use crate::front::lexer::{Tok, str_at};
use crate::front::modules::{child_module, is_within};
use crate::front::types::TyKind;

// The calls the lint knows (GF_), by their functions.
const GF_NONE: i64 = 0;
const GF_SHADER_WGSL: i64 = 1;
const GF_COMPUTE_PIPELINE: i64 = 2;
const GF_RENDER_PIPELINE: i64 = 3;
const GF_RENDER_DESC: i64 = 4;
const GF_DEPTH_ONLY: i64 = 5;
const GF_BIND_LAYOUT: i64 = 6;
const GF_BUFFER: i64 = 7;
const GF_BUFFER_INIT: i64 = 8;
const GF_BIND_GROUP: i64 = 9;
const GF_BIND: i64 = 10;
const GF_BIND_RANGE: i64 = 11;
const GF_BIND_TEXTURE: i64 = 12;
const GF_BIND_SAMPLER: i64 = 13;
const GF_WRITE_BUFFER: i64 = 14;
const GF_MAP_READ: i64 = 15;
const GF_MAP_WRITE: i64 = 16;
const GF_COPY_BUFFER: i64 = 17;
const GF_SET_VERTEX: i64 = 18;
const GF_SET_INDEX: i64 = 19;
const GF_SIZE: i64 = 20;
// A contract's check of another call (`f$pre`): its arguments are that
// call's.
const GF_PRE: i64 = 21;

// BufferUsage's flags (std::gpu::types), by name.
const U_MAP_READ: i64 = 1;
const U_MAP_WRITE: i64 = 2;
const U_COPY_SRC: i64 = 4;
const U_COPY_DST: i64 = 8;
const U_INDEX: i64 = 16;
const U_VERTEX: i64 = 32;
const U_UNIFORM: i64 = 64;
const U_STORAGE: i64 = 128;

// What a followed name holds (L_KIND).
const LK_SHADER: i64 = 1;
const LK_PIPELINE: i64 = 2;
const LK_LAYOUT: i64 = 3;
const LK_BUFFER: i64 = 4;
const LK_DESC: i64 = 5;

// (check_program, after the checker) Every function of the program's own
// (not std's) linted, when the program has a block.
pub fn gpu_lint(wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    if pcx.block_node.len() as i64 == 0 || pcx.std_module < 0 {
        return;
    }
    wcx.gpu_module = child_module(pcx.std_module, intern_c(c"gpu", pcx), pcx);
    if wcx.gpu_module < 0 {
        return;
    }
    wcx.sym_src = intern_c(c"src", pcx);
    wcx.sym_buffer_usage = intern_c(c"BufferUsage", pcx);
    for i in 0..pcx.nodes[pcx.program as usize].count {
        let f = child(pcx.program, i, pcx);
        if pcx.nodes[f as usize].kind == NodeKind::Fn && pcx.nodes[f as usize].c > 0
            && !is_within(crate::front::modules::module_of(f, pcx), pcx.std_module, pcx) {
            lint_fn(f, wcx, pcx);
        }
    }
}

fn lint_fn(f: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    wcx.l_name.clear();
    wcx.l_kind.clear();
    wcx.l_block.clear();
    wcx.l_entry.clear();
    wcx.l_group.clear();
    wcx.l_usage.clear();
    wcx.l_usage_node.clear();
    wcx.l_pos.clear();
    wcx.l_written.clear();
    wcx.l_escaped.clear();
    wcx.l_uniform.clear();
    wcx.l_uniform_bind.clear();
    wcx.bound.clear();
    wcx.assigned.clear();
    wcx.temps.clear();
    for k in 0..pcx.nodes[f as usize].count {
        count_name(&mut wcx.bound, pcx.nodes[child(f, k, pcx) as usize].a);
    }
    // the names' bindings and assignments, then the followed lets in
    // order (a let's value may name an earlier one), then the uses
    walk(pcx.nodes[f as usize].c, 0, wcx, pcx);
    walk(pcx.nodes[f as usize].c, 1, wcx, pcx);
    walk(pcx.nodes[f as usize].c, 2, wcx, pcx);
    for l in 0..wcx.l_name.len() as i64 {
        if wcx.l_kind[l as usize] == LK_BUFFER && wcx.l_uniform[l as usize] != 0
            && wcx.l_written[l as usize] == 0
            && wcx.l_escaped[l as usize] == 0 && wcx.l_usage[l as usize] >= 0 {
            unwritten(l, wcx, pcx);
        }
    }
}

// ---- The walk: phase 0 counts, 1 follows the lets, 2 reads the uses ----

fn walk(n: i64, phase: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    if n <= 0 {
        return;
    }
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Ident {
        if phase == 2 {
            use_of(n, wcx, pcx);
        }
        return;
    }
    if k == NodeKind::Let {
        if is_temp_let(n, pcx) {
            // (its value is read where the temporary is: strip, use_of)
            if phase != 2 {
                walk(pcx.nodes[n as usize].c, phase, wcx, pcx);
            }
            return;
        }
        if phase == 0 {
            count_pattern(pcx.nodes[n as usize].a, wcx, pcx);
        } else if phase == 1 {
            let mark = wcx.temps.len() as i64;
            follow_let(n, wcx, pcx);
            wcx.temps.truncate(mark as usize);
        }
        walk(pcx.nodes[n as usize].c, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Assign {
        let t = pcx.nodes[n as usize].b;
        if phase == 0 && pcx.nodes[t as usize].kind == NodeKind::Ident {
            count_name(&mut wcx.assigned, pcx.nodes[t as usize].a);
        }
        if phase == 2 && pcx.nodes[t as usize].kind == NodeKind::Ident {
            escape(pcx.nodes[t as usize].a, wcx);
        } else {
            walk(t, phase, wcx, pcx);
        }
        walk(pcx.nodes[n as usize].c, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Call {
        if phase == 2 && lint_call(n, wcx, pcx) {
            return;
        }
        walk_list(n, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Block {
        let mark = wcx.temps.len() as i64;
        push_temps(n, wcx, pcx);
        walk_list(n, phase, wcx, pcx);
        walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
        wcx.temps.truncate(mark as usize);
        return;
    }
    if k == NodeKind::Tuple || k == NodeKind::Array || k == NodeKind::Interp
        || k == NodeKind::VariantLit {
        walk_list(n, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::StructLit {
        for i in 0..pcx.nodes[n as usize].count {
            walk(pcx.nodes[child(n, i, pcx) as usize].b, phase, wcx, pcx);
        }
        return;
    }
    if k == NodeKind::Match {
        walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
        for i in 0..pcx.nodes[n as usize].count {
            let arm = child(n, i, pcx);
            if phase == 0 {
                count_pattern(pcx.nodes[arm as usize].a, wcx, pcx);
            }
            walk(pcx.nodes[arm as usize].b, phase, wcx, pcx);
            walk(pcx.nodes[arm as usize].c, phase, wcx, pcx);
        }
        return;
    }
    if k == NodeKind::For {
        if phase == 0 {
            count_pattern(pcx.nodes[n as usize].b, wcx, pcx);
        }
        walk(pcx.nodes[n as usize].c, phase, wcx, pcx);
        walk(pcx.nodes[n as usize].d, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Closure {
        for i in 0..pcx.nodes[n as usize].count {
            if phase == 0 {
                count_name(&mut wcx.bound, pcx.nodes[child(n, i, pcx) as usize].a);
            }
        }
        walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::FieldAccess || k == NodeKind::TupleField || k == NodeKind::Cast
        || k == NodeKind::Return || k == NodeKind::Try || k == NodeKind::ExprStmt
        || k == NodeKind::Defer {
        walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Binary || k == NodeKind::If || k == NodeKind::While {
        if k == NodeKind::If {
            walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
        }
        walk(pcx.nodes[n as usize].b, phase, wcx, pcx);
        walk(pcx.nodes[n as usize].c, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Unary || k == NodeKind::Loop || k == NodeKind::Break {
        walk(pcx.nodes[n as usize].b, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::Index || k == NodeKind::Range || k == NodeKind::Repeat {
        walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
        walk(pcx.nodes[n as usize].b, phase, wcx, pcx);
        return;
    }
    if k == NodeKind::InterpHole {
        walk(pcx.nodes[n as usize].a, phase, wcx, pcx);
    }
}

fn walk_list(n: i64, phase: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        walk(child(n, i, pcx), phase, wcx, pcx);
    }
}

fn count_name(v: &mut Vec<i64, Comp>, name: i64) {
    let mut i: usize = 0;
    while i < v.len() {
        if v[i] == name {
            v[i + 1] += 1;
            return;
        }
        i += 2;
    }
    v.push(name);
    v.push(1);
}

fn name_count(v: &Vec<i64, Comp>, name: i64) -> i64 {
    let mut i: usize = 0;
    while i < v.len() {
        if v[i] == name {
            return v[i + 1];
        }
        i += 2;
    }
    0
}

// The names a pattern binds, counted.
fn count_pattern(p: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) {
    if p <= 0 {
        return;
    }
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::PatBind {
        count_name(&mut wcx.bound, pcx.nodes[p as usize].a);
    } else if k == NodeKind::PatTuple || k == NodeKind::PatVariant || k == NodeKind::PatOr {
        for i in 0..pcx.nodes[p as usize].count {
            count_pattern(child(p, i, pcx), wcx, pcx);
        }
    }
}

// ---- Following the lets ----

// The followed name `name`'s index, or -1.
fn local(name: i64, wcx: &EmbedCx<Comp>) -> i64 {
    for l in 0..wcx.l_name.len() as i64 {
        if wcx.l_name[l as usize] == name {
            return l;
        }
    }
    -1
}

// The value expression n stands for: under `?`, the synthetic `&`/`*` the
// checker puts on a receiver, a block's tail (a contract's check is a
// block around the call; its temporaries come into scope) and a
// temporary's value.
fn strip(n0: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let mut n = n0;
    loop {
        let k = pcx.nodes[n as usize].kind;
        if k == NodeKind::Try {
            n = pcx.nodes[n as usize].a;
        }
        else if k == NodeKind::Unary
            && (pcx.nodes[n as usize].op == Tok::Amp || pcx.nodes[n as usize].op == Tok::Star) {
            n = pcx.nodes[n as usize].b;
        } else if k == NodeKind::Block && pcx.nodes[n as usize].a > 0 {
            push_temps(n, wcx, pcx);
            n = pcx.nodes[n as usize].a;
        } else if k == NodeKind::Ident && temp_value(pcx.nodes[n as usize].a, wcx) > 0
            && temp_value(pcx.nodes[n as usize].a, wcx) != n {
            n = temp_value(pcx.nodes[n as usize].a, wcx);
        } else {
            return n;
        }
    }
}

// Whether `let` n binds one of the checker's temporaries (`?a1`, the own
// pass's `__own_tv`).
fn is_temp_let(n: i64, pcx: &Ctx<Comp>) -> bool {
    let p = pcx.nodes[n as usize].a;
    if pcx.nodes[p as usize].kind != NodeKind::PatBind {
        return false;
    }
    let t = sym_text(pcx.nodes[p as usize].a, pcx);
    t.len() > 1 && (t[0] == b'?' || (t[0] == b'_' && t[1] == b'_'))
}

// Block n's temporaries into scope, and those of the blocks that are
// their values (the own pass's `__own_tv` in a contract's argument).
fn push_temps(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        let st = child(n, i, pcx);
        if pcx.nodes[st as usize].kind == NodeKind::Let && is_temp_let(st, pcx) {
            wcx.temps.push(pcx.nodes[pcx.nodes[st as usize].a as usize].a);
            wcx.temps.push(pcx.nodes[st as usize].c);
            let mut v = pcx.nodes[st as usize].c;
            while pcx.nodes[v as usize].kind == NodeKind::Try {
                v = pcx.nodes[v as usize].a;
            }
            if pcx.nodes[v as usize].kind == NodeKind::Block {
                push_temps(v, wcx, pcx);
            }
        }
    }
}

// The value of temporary `name` in scope (the innermost), or 0.
fn temp_value(name: i64, wcx: &EmbedCx<Comp>) -> i64 {
    let i = temp_index(name, wcx);
    if i >= 0 { wcx.temps[(i + 1) as usize] } else { 0 }
}

// The index in TEMPS of temporary `name` in scope (the innermost), or -1.
fn temp_index(name: i64, wcx: &EmbedCx<Comp>) -> i64 {
    let mut i = wcx.temps.len() as i64 - 2;
    while i >= 0 {
        if wcx.temps[i as usize] == name {
            return i;
        }
        i -= 2;
    }
    -1
}

// The followed name expression n (stripped) is, or -1.
fn local_of(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let s = strip(n, wcx, pcx);
    if pcx.nodes[s as usize].kind == NodeKind::Ident { local(pcx.nodes[s as usize].a, wcx) }
    else { -1 }
}

// The `let` n: its name followed when its value is one the lint knows.
fn follow_let(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    let p = pcx.nodes[n as usize].a;
    if pcx.nodes[p as usize].kind != NodeKind::PatBind {
        return;
    }
    let name = pcx.nodes[p as usize].a;
    if name_count(&wcx.bound, name) != 1 || name_count(&wcx.assigned, name) != 0 {
        return;
    }
    let v = strip(pcx.nodes[n as usize].c, wcx, pcx);
    if pcx.nodes[v as usize].kind != NodeKind::Call {
        return;
    }
    let g = gpu_fn(v, wcx, pcx);
    let mut kind: i64 = 0;
    let mut block: i64 = -1;
    let mut entry: i64 = 0;
    let mut group: i64 = -1;
    let mut usage: i64 = -1;
    let mut usage_node: i64 = 0;
    if g == GF_SHADER_WGSL {
        block = shader_block(v, wcx, pcx);
        kind = LK_SHADER;
    } else if g == GF_COMPUTE_PIPELINE && pcx.nodes[v as usize].count >= 3 {
        block = shader_of(child(v, 1, pcx), wcx, pcx);
        entry = entry_sym(child(v, 2, pcx), wcx, pcx);
        kind = LK_PIPELINE;
    } else if g == GF_RENDER_PIPELINE && pcx.nodes[v as usize].count >= 2 {
        block = desc_block(child(v, 1, pcx), wcx, pcx);
        kind = LK_PIPELINE;
    } else if g == GF_RENDER_DESC || g == GF_DEPTH_ONLY {
        block = shader_of(child(v, 0, pcx), wcx, pcx);
        kind = LK_DESC;
        if pcx.nodes[v as usize].count >= 2 {
            entry = entry_sym(child(v, 1, pcx), wcx, pcx);
        }
    } else if g == GF_BIND_LAYOUT && pcx.nodes[v as usize].count >= 2 {
        let pl = local_of(child(v, 0, pcx), wcx, pcx);
        let gn = child(v, 1, pcx);
        if pl >= 0 && wcx.l_kind[pl as usize] == LK_PIPELINE
            && pcx.nodes[gn as usize].kind == NodeKind::Int {
            block = wcx.l_block[pl as usize];
            entry = wcx.l_entry[pl as usize];
            group = pcx.nodes[gn as usize].a;
            kind = LK_LAYOUT;
        }
    } else if (g == GF_BUFFER || g == GF_BUFFER_INIT) && pcx.nodes[v as usize].count >= 3 {
        usage_node = child(v, 2, pcx);
        usage = usage_of(usage_node, wcx, pcx);
        kind = LK_BUFFER;
    }
    if kind == 0 || (kind != LK_BUFFER && block < 0) {
        return;
    }
    wcx.l_name.push(name);
    wcx.l_kind.push(kind);
    wcx.l_block.push(block);
    wcx.l_entry.push(entry);
    wcx.l_group.push(group);
    wcx.l_usage.push(usage);
    wcx.l_usage_node.push(usage_node);
    wcx.l_pos.push(pcx.nodes[p as usize].start);
    // (a buffer_init's bytes are its contents: written)
    wcx.l_written.push(if g == GF_BUFFER_INIT { 1 } else { 0 });
    wcx.l_escaped.push(0);
    wcx.l_uniform.push(0);
    wcx.l_uniform_bind.push(-1);
}

// The block of `dev.shader_wgsl(K.src)` (call v), or -1.
fn shader_block(v: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[v as usize].count < 2 {
        return -1;
    }
    let a = strip(child(v, 1, pcx), wcx, pcx);
    if pcx.nodes[a as usize].kind != NodeKind::FieldAccess
        || pcx.nodes[a as usize].b != wcx.sym_src {
        return -1;
    }
    block_of_type(pcx.nodes[pcx.nodes[a as usize].a as usize].ty, pcx)
}

// The block whose made struct type t is, or -1.
fn block_of_type(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if t <= 0 {
        return -1;
    }
    let node = struct_node_of(t, pcx);
    for b in 0..pcx.block_struct.len() as i64 {
        if pcx.block_struct[b as usize] == node {
            return b;
        }
    }
    -1
}

// The block of shader expression n: a followed shader, or a
// `dev.shader_wgsl(K.src)` in place; -1.
fn shader_of(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let l = local_of(n, wcx, pcx);
    if l >= 0 {
        return if wcx.l_kind[l as usize] == LK_SHADER { wcx.l_block[l as usize] } else { -1 };
    }
    let s = strip(n, wcx, pcx);
    if pcx.nodes[s as usize].kind == NodeKind::Call
        && gpu_fn(s, wcx, pcx) == GF_SHADER_WGSL { shader_block(s, wcx, pcx) }
    else { -1 }
}

// The block of a RenderDesc expression: a followed one, or
// `RenderDesc::new(s, ..)` in place; -1.
fn desc_block(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let l = local_of(n, wcx, pcx);
    if l >= 0 {
        return if wcx.l_kind[l as usize] == LK_DESC { wcx.l_block[l as usize] } else { -1 };
    }
    let s = strip(n, wcx, pcx);
    let g = if pcx.nodes[s as usize].kind == NodeKind::Call { gpu_fn(s, wcx, pcx) }
        else { GF_NONE };
    if (g == GF_RENDER_DESC || g == GF_DEPTH_ONLY) && pcx.nodes[s as usize].count >= 1 {
        shader_of(child(s, 0, pcx), wcx, pcx)
    } else {
        -1
    }
}

// The entry point an entry argument names: `K.main`'s field, or a string
// literal's text (a symbol); 0 when neither.
fn entry_sym(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let s = strip(n, wcx, pcx);
    if pcx.nodes[s as usize].kind == NodeKind::FieldAccess {
        return pcx.nodes[s as usize].b;
    }
    if pcx.nodes[s as usize].kind == NodeKind::Str {
        return intern(str_at(pcx.nodes[s as usize].a, pcx), pcx);
    }
    0
}

// The usage expression's value: BufferUsage's flags or'ed, or -1 when it
// is not that constant.
fn usage_of(n0: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let n = strip(n0, wcx, pcx);
    let k = pcx.nodes[n as usize].kind;
    if k == NodeKind::Binary && pcx.nodes[n as usize].op == Tok::Pipe {
        let a = usage_of(pcx.nodes[n as usize].b, wcx, pcx);
        let b = usage_of(pcx.nodes[n as usize].c, wcx, pcx);
        return if a < 0 || b < 0 { -1 } else { a | b };
    }
    if k == NodeKind::Int {
        return pcx.nodes[n as usize].a;
    }
    if k == NodeKind::Path && pcx.nodes[n as usize].a == wcx.sym_buffer_usage {
        return flag_named(sym_text(pcx.nodes[n as usize].b, pcx));
    }
    // (the checker's: `std::gpu::types::BufferUsage::COPY_DST`)
    if k == NodeKind::Ident {
        let t = sym_text(pcx.nodes[n as usize].a, pcx);
        let tail = "BufferUsage::";
        let mut i = t.len() as i64;
        while i > 0 && t[(i - 1) as usize] != b':' {
            i -= 1;
        }
        if i >= tail.len() as i64
            && t[(i - tail.len() as i64) as usize..i as usize] == tail.as_bytes() {
            return flag_named(&t[i as usize..]);
        }
    }
    -1
}

fn flag_named(name: &[u8]) -> i64 {
    if name == b"MAP_READ" { U_MAP_READ } else if name == b"MAP_WRITE" { U_MAP_WRITE }
    else if name == b"COPY_SRC" { U_COPY_SRC } else if name == b"COPY_DST" { U_COPY_DST }
    else if name == b"INDEX" { U_INDEX } else if name == b"VERTEX" { U_VERTEX }
    else if name == b"UNIFORM" { U_UNIFORM } else if name == b"STORAGE" { U_STORAGE }
    else if name == b"INDIRECT" { 256 } else if name == b"QUERY_RESOLVE" { 512 } else { -1 }
}

fn flag_text(bit: i64) -> &'static [u8] {
    if bit == U_MAP_READ { b"MAP_READ" } else if bit == U_MAP_WRITE { b"MAP_WRITE" }
    else if bit == U_COPY_SRC { b"COPY_SRC" } else if bit == U_COPY_DST { b"COPY_DST" }
    else if bit == U_INDEX { b"INDEX" } else if bit == U_VERTEX { b"VERTEX" }
    else if bit == U_UNIFORM { b"UNIFORM" } else if bit == U_STORAGE { b"STORAGE" }
    else if bit == 256 { b"INDIRECT" } else { b"QUERY_RESOLVE" }
}

// ---- std::gpu's functions ----

// Which of std::gpu's functions call n is (GF_), by its resolved function.
fn gpu_fn(n: i64, wcx: &EmbedCx<Comp>, pcx: &Ctx<Comp>) -> i64 {
    let x = pcx.nodes[n as usize].x;
    if x <= 0 {
        return GF_NONE;
    }
    let (module, fn_sym) = fn_facts(x, pcx);
    if !is_within(module, wcx.gpu_module, pcx) {
        return GF_NONE;
    }
    let sym = sym_text(fn_sym, pcx);
    // the last two segments of `std.gpu.Device.shader_wgsl`
    let mut e = sym.len() as i64;
    let mut i = e;
    while i > 0 && sym[(i - 1) as usize] != b'.' && sym[(i - 1) as usize] != b':' {
        i -= 1;
    }
    let name = &sym[i as usize..e as usize];
    if name.len() > 4 && name[(name.len() as i64 - 4) as usize..] == b"$pre" {
        return GF_PRE;
    }
    let mut j = i;
    while j > 0 && (sym[(j - 1) as usize] == b'.' || sym[(j - 1) as usize] == b':') {
        j -= 1;
    }
    // (0.26.3: an instance's owner, `std.gpu.Device.GN7std.Gpa.buffer`
    // for `Device<Gpa>::buffer`: its name, before its first type
    // arguments, `.GN` and their length)
    let mut g: i64 = 0;
    while g + 4 <= j {
        if sym[g as usize] == b'.' && sym[(g + 1) as usize] == b'G' && sym[(g + 2) as usize] == b'N'
            && sym[(g + 3) as usize] >= b'0' && sym[(g + 3) as usize] <= b'9' {
            j = g;
            break;
        }
        g += 1;
    }
    let mut h = j;
    while h > 0 && sym[(h - 1) as usize] != b'.' && sym[(h - 1) as usize] != b':' {
        h -= 1;
    }
    let owner = &sym[h as usize..j as usize];
    if owner == b"Device" {
        return if name == b"shader_wgsl" { GF_SHADER_WGSL }
            else if name == b"compute_pipeline" { GF_COMPUTE_PIPELINE }
            else if name == b"render_pipeline" { GF_RENDER_PIPELINE }
            else if name == b"buffer" { GF_BUFFER }
            else if name == b"buffer_init" { GF_BUFFER_INIT }
            else if name == b"bind_group" { GF_BIND_GROUP } else { GF_NONE };
    }
    if owner == b"RenderDesc" {
        return if name == b"new" { GF_RENDER_DESC } else if name == b"depth_only" { GF_DEPTH_ONLY }
            else { GF_NONE };
    }
    if owner == b"ComputePipeline" || owner == b"RenderPipeline" {
        return if name == b"bind_layout" { GF_BIND_LAYOUT } else { GF_NONE };
    }
    if owner == b"Queue" {
        return if name == b"write_buffer" { GF_WRITE_BUFFER } else { GF_NONE };
    }
    if owner == b"Buffer" {
        return if name == b"map_read" || name == b"map_read_copy_in" { GF_MAP_READ }
            else if name == b"map_write" { GF_MAP_WRITE } else if name == b"size" { GF_SIZE }
            else { GF_NONE };
    }
    if owner == b"Encoder" {
        return if name == b"copy_buffer" { GF_COPY_BUFFER } else { GF_NONE };
    }
    if owner == b"RenderPass" {
        return if name == b"set_vertex_buffer" { GF_SET_VERTEX }
            else if name == b"set_index_buffer" { GF_SET_INDEX } else { GF_NONE };
    }
    if name == b"bind" { GF_BIND } else if name == b"bind_range" { GF_BIND_RANGE }
    else if name == b"bind_texture" { GF_BIND_TEXTURE } else if name == b"bind_sampler" {
        GF_BIND_SAMPLER } else { GF_NONE }
}

// The module and symbol of the function a call's x names (x - 1; its
// template, for an instance).
fn fn_facts(x: i64, pcx: &Ctx<Comp>) -> (i64, i64) {
    let f0 = x - 1;
    let f = if pcx.fns[f0 as usize].tmpl > 0 { pcx.fns[f0 as usize].tmpl - 1 } else { f0 };
    (pcx.fns[f as usize].module, pcx.fns[f as usize].name)
}

// The node of struct type t's struct, or -1 when t is no struct type.
fn struct_node_of(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind
        == TyKind::Struct { pcx.structs[pcx.types[t as usize].a as usize].node } else { -1 }
}

// ---- The uses ----

// A use of a followed name the lint does not know: it escapes (a
// temporary: what its value uses).
fn use_of(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    let i = temp_index(pcx.nodes[n as usize].a, wcx);
    if i >= 0 {
        // (hidden while its value is walked: a temporary of a nested
        // contract can be named as the one it reads, `let ?a1 = f(?a1)`)
        wcx.temps[i as usize] = 0;
        walk(wcx.temps[(i + 1) as usize], 2, wcx, pcx);
        wcx.temps[i as usize] = pcx.nodes[n as usize].a;
        return;
    }
    // (a use the compiler made at the binding itself, its drop: no use)
    let l = local(pcx.nodes[n as usize].a, wcx);
    if l >= 0 && pcx.nodes[n as usize].start == wcx.l_pos[l as usize] {
        return;
    }
    escape(pcx.nodes[n as usize].a, wcx);
}

fn escape(name: i64, wcx: &mut EmbedCx<Comp>) {
    let l = local(name, wcx);
    if l >= 0 {
        wcx.l_escaped[l as usize] = 1;
    }
}

// Call n, linted: true when its arguments were read here (the walk does
// not go into them again).
fn lint_call(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let g = gpu_fn(n, wcx, pcx);
    if g == GF_NONE || g == GF_SHADER_WGSL || g == GF_BUFFER || g == GF_BUFFER_INIT
        || g == GF_RENDER_PIPELINE {
        return false;
    }
    if g == GF_COMPUTE_PIPELINE && pcx.nodes[n as usize].count >= 3 {
        let b = shader_of(child(n, 1, pcx), wcx, pcx);
        entry_literal(b, child(n, 2, pcx), STAGE_COMPUTE, wcx, pcx);
        return false;
    }
    if (g == GF_RENDER_DESC || g == GF_DEPTH_ONLY) && pcx.nodes[n as usize].count >= 2 {
        let b = shader_of(child(n, 0, pcx), wcx, pcx);
        entry_literal(b, child(n, 1, pcx), STAGE_VERTEX, wcx, pcx);
        if g == GF_RENDER_DESC && pcx.nodes[n as usize].count >= 3 {
            entry_literal(b, child(n, 2, pcx), STAGE_FRAGMENT, wcx, pcx);
        }
        return false;
    }
    if g == GF_BIND_GROUP && pcx.nodes[n as usize].count >= 3 {
        return bind_group(n, wcx, pcx);
    }
    // the buffer argument of a call that needs a flag, and writes
    let mut buf: i64 = -1;
    let mut need: i64 = 0;
    let mut what: &[u8] = b"";
    let mut writes = false;
    if g == GF_WRITE_BUFFER && pcx.nodes[n as usize].count >= 2 {
        buf = 1;
        need = U_COPY_DST;
        what = b"written by write_buffer";
        writes = true;
    } else if (g == GF_MAP_READ || g == GF_MAP_WRITE) && pcx.nodes[n as usize].count >= 1 {
        buf = 0;
        need = if g == GF_MAP_READ { U_MAP_READ } else { U_MAP_WRITE };
        what = if g == GF_MAP_READ { b"mapped for reading" } else { b"mapped for writing" };
        writes = g == GF_MAP_WRITE;
    } else if g == GF_SET_VERTEX && pcx.nodes[n as usize].count >= 3 {
        buf = 2;
        need = U_VERTEX;
        what = b"set as a vertex buffer";
    } else if g == GF_SET_INDEX && pcx.nodes[n as usize].count >= 2 {
        buf = 1;
        need = U_INDEX;
        what = b"set as an index buffer";
    } else if g == GF_SIZE || g == GF_PRE {
        return true;
    } else if g == GF_COPY_BUFFER && pcx.nodes[n as usize].count >= 4 {
        need_flag(child(n, 1, pcx), U_COPY_SRC, b"copied from", wcx, pcx);
        need_flag(child(n, 3, pcx), U_COPY_DST, b"copied into", wcx, pcx);
        let dst = local_of(child(n, 3, pcx), wcx, pcx);
        if dst >= 0 {
            wcx.l_written[dst as usize] = 1;
        }
        walk(child(n, 0, pcx), 2, wcx, pcx);
        for i in 4..pcx.nodes[n as usize].count {
            walk(child(n, i, pcx), 2, wcx, pcx);
        }
        return true;
    }
    if buf < 0 {
        return false;
    }
    need_flag(child(n, buf, pcx), need, what, wcx, pcx);
    let l = local_of(child(n, buf, pcx), wcx, pcx);
    if l >= 0 && writes {
        wcx.l_written[l as usize] = 1;
    }
    for i in 0..pcx.nodes[n as usize].count {
        if i != buf {
            walk(child(n, i, pcx), 2, wcx, pcx);
        }
    }
    true
}

// Buffer expression a, used where it needs flag `need` (`what` it is
// used as): gpu.usage when its usage is a constant without it.
fn need_flag(a: i64, need: i64, what: &[u8], wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    let l = local_of(a, wcx, pcx);
    if l < 0 || wcx.l_kind[l as usize] != LK_BUFFER || wcx.l_usage[l as usize] < 0
        || (wcx.l_usage[l as usize] & need) != 0 {
        return;
    }
    usage_error(a, l, need, what, b"", wcx, pcx);
}

// gpu.usage at a, of followed buffer l, which lacks flag `need`.
fn usage_error(a: i64, l: i64, need: i64, what: &[u8], extra: &[u8], wcx: &mut EmbedCx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"gpu.usage";
    err_begin(pcx.nodes[a as usize].start, pcx);
    let m = buf_new();
    buf_bytes(m, b"buffer '");
    buf_bytes(m, sym_text(wcx.l_name[l as usize], pcx));
    buf_bytes(m, b"' (usage ");
    usage_text(m, wcx.l_usage[l as usize]);
    buf_bytes(m, b", created ");
    buf_file_line(m, wcx.l_pos[l as usize], pcx);
    buf_bytes(m, b") ");
    buf_bytes(m, what);
    buf_bytes(m, extra);
    buf_bytes(m, b", which needs ");
    buf_bytes(m, flag_text(need));
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    err_help(c"a buffer's usage is fixed when it is made (dev.buffer(size, usage)): every use needs its flag", pcx);
    // the try: the usage with the flag
    let u = wcx.l_usage_node[l as usize];
    let old = &get_src()[pcx.nodes[u as usize].start as usize..pcx.nodes[u as usize].end as usize];
    if !has_newline(old) && !has_quote(old) {
        let prefix = flag_prefix(u, wcx, pcx);
        let t = buf_new();
        buf_bytes(t, b"edit patch ");
        buf_file_line(t, pcx.nodes[u as usize].start, pcx);
        buf_bytes(t, b" --old '");
        buf_bytes(t, old);
        buf_bytes(t, b"' --new '");
        buf_bytes(t, prefix);
        buf_bytes(t, flag_text(need));
        buf_bytes(t, b" | ");
        buf_bytes(t, old);
        buf_byte(t, b'\'');
        err_try_tool(buf_slice(t), false, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

fn has_newline(s: &[u8]) -> bool {
    for &c in s {
        if c == b'\n' {
            return true;
        }
    }
    false
}

fn has_quote(s: &[u8]) -> bool {
    for &c in s {
        if c == b'\'' {
            return true;
        }
    }
    false
}

// The spelling of BufferUsage's path in usage expression u (`BufferUsage::`,
// `gpu::BufferUsage::`): its first flag's text before the flag's name.
fn flag_prefix(u0: i64, wcx: &mut EmbedCx<Comp>, pcx: &Ctx<Comp>) -> &'static [u8] {
    let mut u = strip(u0, wcx, pcx);
    while pcx.nodes[u as usize].kind == NodeKind::Binary {
        u = strip(pcx.nodes[u as usize].b, wcx, pcx);
    }
    if pcx.nodes[u as usize].kind == NodeKind::Path
        || pcx.nodes[u as usize].kind == NodeKind::Ident {
        let t = &get_src()[
            pcx.nodes[u as usize].start as usize..pcx.nodes[u as usize].end as usize];
        let mut i = t.len() as i64;
        while i > 0 && t[(i - 1) as usize] != b':' {
            i -= 1;
        }
        if i > 0 {
            return &t[0..i as usize];
        }
    }
    b"BufferUsage::"
}

// Usage bits as `A | B` into m.
fn usage_text(m: i64, u: i64) {
    let mut first = true;
    let mut bit: i64 = 1;
    while bit <= 512 {
        if (u & bit) != 0 {
            if !first {
                buf_bytes(m, b" | ");
            }
            buf_bytes(m, flag_text(bit));
            first = false;
        }
        bit = bit << 1;
    }
    if first {
        buf_byte(m, b'0');
    }
}

// ---- gpu.entry: an entry point named by a string literal ----

// Entry argument a of a pipeline of block b's module, of `stage`: a string
// literal that is no entry point of that stage is gpu.entry, fixed by the
// block's field.
fn entry_literal(b: i64, a0: i64, stage: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    let a = strip(a0, wcx, pcx);
    if b < 0 || pcx.nodes[a as usize].kind != NodeKind::Str {
        return;
    }
    let name = intern(str_at(pcx.nodes[a as usize].a, pcx), pcx);
    let first = pcx.block_first[b as usize];
    let end = if b + 1 < pcx.block_first.len() as i64 { pcx.block_first[(b + 1) as usize] }
        else { pcx.entry_sym.len() as i64 };
    for k in first..end {
        if pcx.entry_sym[k as usize] == name && pcx.entry_stage[k as usize] == stage {
            return;
        }
    }
    let e = pcx.block_node[b as usize];
    let saved = pcx.err_kind;
    pcx.err_kind = c"gpu.entry";
    err_begin(pcx.nodes[a as usize].start, pcx);
    let m = buf_new();
    buf_bytes(m, b"the block '");
    buf_bytes(m, sym_text(pcx.nodes[e as usize].a, pcx));
    buf_bytes(m, b"' has no ");
    buf_bytes(m, stage_attr(stage));
    buf_bytes(m, b" fn '");
    buf_bytes(m, sym_text(name, pcx));
    buf_bytes(m, b"'");
    if end == first {
        buf_bytes(m, b"; it has no entry points");
    } else {
        buf_bytes(m, b"; its entry points: ");
        for k in first..end {
            if k > first {
                buf_bytes(m, b", ");
            }
            buf_bytes(m, sym_text(pcx.entry_sym[k as usize], pcx));
            buf_bytes(m, stage_name(pcx.entry_stage[k as usize]));
        }
    }
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    let mut near = near_to(name);
    let mut only: i64 = -1;
    let mut count: i64 = 0;
    for k in first..end {
        if pcx.entry_stage[k as usize] == stage {
            near.offer(pcx.entry_sym[k as usize], pcx);
            only = k;
            count += 1;
        }
    }
    let best = near.best;
    let fix: i64 = if best > 0 { best } else if count == 1 { pcx.entry_sym[only as usize] }
        else { 0 };
    if fix > 0 {
        let f = buf_new();
        buf_bytes(f, sym_text(pcx.nodes[e as usize].a, pcx));
        buf_byte(f, b'.');
        buf_bytes(f, sym_text(fix, pcx));
        err_fix(pcx.nodes[a as usize].start, pcx.nodes[a as usize].end, buf_slice(f), pcx);
        let h = buf_new();
        buf_bytes(h, b"the block's field names its entry point: ");
        buf_bytes(h, buf_slice(f));
        buf_byte(h, 0);
        err_help(buf_slice(h).ptr, pcx);
    } else {
        err_help(
            c"name an entry point by the block's field (`K.main`): a field that is none is an error", pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

fn stage_attr(stage: i64) -> &'static [u8] {
    if stage == STAGE_COMPUTE { b"@compute" } else if stage == STAGE_VERTEX { b"@vertex" }
    else { b"@fragment" }
}

fn stage_name(stage: i64) -> &'static [u8] {
    if stage == STAGE_COMPUTE { b" (compute)" } else if stage == STAGE_VERTEX { b" (vertex)" }
    else { b" (fragment)" }
}

// ---- Bind groups: gpu.layout, gpu.usage, and what gpu.unwritten needs ----

// `dev.bind_group(l, entries)` (call n): its entries read when l is a
// followed layout (or `p.bind_layout(G)` in place) and they are an array
// literal. True when its arguments were read here.
fn bind_group(n: i64, wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let la = strip(child(n, 1, pcx), wcx, pcx);
    let mut b: i64 = -1;
    let mut group: i64 = -1;
    let mut entry: i64 = 0;
    let l = local_of(la, wcx, pcx);
    if l >= 0 && wcx.l_kind[l as usize] == LK_LAYOUT {
        b = wcx.l_block[l as usize];
        group = wcx.l_group[l as usize];
        entry = wcx.l_entry[l as usize];
    }
    else if pcx.nodes[la as usize].kind == NodeKind::Call && gpu_fn(la, wcx, pcx) == GF_BIND_LAYOUT
        && pcx.nodes[la as usize].count >= 2 {
        let pl = local_of(child(la, 0, pcx), wcx, pcx);
        let gn = strip(child(la, 1, pcx), wcx, pcx);
        if pl >= 0 && wcx.l_kind[pl as usize] == LK_PIPELINE
            && pcx.nodes[gn as usize].kind == NodeKind::Int {
            b = wcx.l_block[pl as usize];
            group = pcx.nodes[gn as usize].a;
            entry = wcx.l_entry[pl as usize];
        }
    }
    let mut arr = strip(child(n, 2, pcx), wcx, pcx);
    if pcx.nodes[arr as usize].kind == NodeKind::Index
        && pcx.nodes[pcx.nodes[arr as usize].b as usize].kind == NodeKind::Range {
        arr = strip(pcx.nodes[arr as usize].a, wcx, pcx);
    }
    if b < 0 || pcx.nodes[arr as usize].kind != NodeKind::Array {
        return false;
    }
    walk(child(n, 0, pcx), 2, wcx, pcx);
    walk(la, 2, wcx, pcx);
    for i in 0..pcx.nodes[arr as usize].count {
        let en = strip(child(arr, i, pcx), wcx, pcx);
        let g = if pcx.nodes[en as usize].kind == NodeKind::Call { gpu_fn(en, wcx, pcx) }
            else { GF_NONE };
        if g != GF_BIND && g != GF_BIND_RANGE && g != GF_BIND_TEXTURE && g != GF_BIND_SAMPLER
            || pcx.nodes[en as usize].count < 2 {
            walk(en, 2, wcx, pcx);
            continue;
        }
        bind_entry(b, group, entry, en, g, wcx, pcx);
        for k in 2..pcx.nodes[en as usize].count {
            walk(child(en, k, pcx), 2, wcx, pcx);
        }
    }
    true
}

// Entry en (a gpu::bind* call g) of a bind group for group `group` of
// block b's module (its pipeline's entry point `entry`).
fn bind_entry(b: i64, group: i64, entry: i64, en: i64, g: i64, wcx: &mut EmbedCx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let bn = strip(child(en, 0, pcx), wcx, pcx);
    let res = child(en, 1, pcx);
    let l = local_of(res, wcx, pcx);
    if pcx.nodes[bn as usize].kind != NodeKind::Int {
        if l >= 0 {
            wcx.l_escaped[l as usize] = 1;
        }
        return;
    }
    let binding = pcx.nodes[bn as usize].a;
    let mut d: i64 = -1;
    for i in 0..wcx.bind_block.len() as i64 {
        if wcx.bind_block[i as usize] == b && wcx.bind_g[i as usize] == group
            && wcx.bind_b[i as usize] == binding {
            d = i;
        }
    }
    if d < 0 {
        layout_error(b, group, entry, en, -1, b"", wcx, pcx);
        if l >= 0 {
            wcx.l_escaped[l as usize] = 1;
        }
        return;
    }
    let kind = wcx.bind_kind[d as usize];
    let is_buffer = g == GF_BIND || g == GF_BIND_RANGE;
    let wants_buffer = kind == BK_UNIFORM || kind == BK_STORAGE || kind == BK_STORAGE_RW;
    if is_buffer != wants_buffer || (g == GF_BIND_SAMPLER) != (kind == BK_SAMPLER) {
        layout_error(b, group, entry, en, d,
            if g == GF_BIND_TEXTURE { b"a texture view" } else if g == GF_BIND_SAMPLER {
                b"a sampler" } else { b"a buffer" }, wcx, pcx);
        if l >= 0 {
            wcx.l_escaped[l as usize] = 1;
        }
        return;
    }
    if l < 0 || wcx.l_kind[l as usize] != LK_BUFFER {
        return;
    }
    let usage = wcx.l_usage[l as usize];
    // (a uniform binding of a buffer made for storage: gpu.layout, below,
    // and not gpu.unwritten too)
    if kind == BK_UNIFORM && (usage < 0 || (usage & U_UNIFORM) != 0 || (usage & U_STORAGE) == 0) {
        wcx.l_uniform[l as usize] = en;
        wcx.l_uniform_bind[l as usize] = d;
    }
    if usage < 0 {
        return;
    }
    let need = if kind == BK_UNIFORM { U_UNIFORM } else { U_STORAGE };
    let other = if kind == BK_UNIFORM { U_STORAGE } else { U_UNIFORM };
    if (usage & need) != 0 {
        return;
    }
    if (usage & other) != 0 {
        let t = buf_new();
        buf_bytes(t, if other == U_STORAGE { b"storage buffer '" } else { b"uniform buffer '" });
        buf_bytes(t, sym_text(wcx.l_name[l as usize], pcx));
        buf_byte(t, b'\'');
        layout_error(b, group, entry, en, d, buf_slice(t), wcx, pcx);
        return;
    }
    let w = buf_new();
    buf_bytes(w, b" at @binding(");
    buf_int(w, binding);
    buf_bytes(w, b") ");
    buf_bytes(w, bind_kind_text(kind));
    buf_bytes(w, b" '");
    buf_bytes(w, sym_text(wcx.bind_name[d as usize], pcx));
    buf_byte(w, b'\'');
    usage_error(res, l, need, b"bound", buf_slice(w), wcx, pcx);
}

fn bind_kind_text(kind: i64) -> &'static [u8] {
    if kind == BK_UNIFORM { b"uniform" } else if kind == BK_STORAGE { b"storage, read" }
    else if kind == BK_STORAGE_RW { b"storage, read_write" } else if kind == BK_TEXTURE {
        b"texture" } else if kind == BK_SAMPLER { b"sampler" } else { b"storage texture" }
}

// gpu.layout at bind entry en: binding d of block b's group `group` (-1:
// none) and what the entry is (`is`, "" when d is none).
fn layout_error(b: i64, group: i64, entry: i64, en: i64, d: i64, is: &[u8], wcx: &mut EmbedCx<Comp>,
    pcx: &mut Ctx<Comp>) {
    let e = pcx.block_node[b as usize];
    let binding = pcx.nodes[strip(child(en, 0, pcx), wcx, pcx) as usize].a;
    let saved = pcx.err_kind;
    pcx.err_kind = c"gpu.layout";
    err_begin(pcx.nodes[en as usize].start, pcx);
    let m = buf_new();
    buf_bytes(m, b"bind group ");
    buf_int(m, group);
    buf_bytes(m, b" of '");
    buf_bytes(m, sym_text(pcx.nodes[e as usize].a, pcx));
    if entry > 0 {
        buf_byte(m, b'.');
        buf_bytes(m, sym_text(entry, pcx));
    }
    buf_bytes(m, b"' (");
    buf_file_line(m, pcx.nodes[e as usize].start, pcx);
    buf_bytes(m, b") ");
    if d < 0 {
        buf_bytes(m, b"has no @binding(");
        buf_int(m, binding);
        buf_bytes(m, b")");
        let mut any = false;
        for i in 0..wcx.bind_block.len() as i64 {
            if wcx.bind_block[i as usize] == b && wcx.bind_g[i as usize] == group {
                buf_bytes(m, if any { b", " } else { b"; its bindings: " });
                bind_text(m, i, wcx, pcx);
                any = true;
            }
        }
        if !any {
            buf_bytes(m, b"; the group has no bindings");
        }
    } else {
        buf_bytes(m, b"wants ");
        bind_text(m, d, wcx, pcx);
        buf_bytes(m, b", but entry ");
        buf_int(m, binding);
        buf_bytes(m, b" is ");
        buf_bytes(m, is);
    }
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    err_help(c"a bind group's entries are the bindings the shader declares for its group, each of its kind: gpu::bind for a uniform or storage buffer, gpu::bind_texture for a texture, gpu::bind_sampler for a sampler", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// `@binding(B) uniform 'params'` of binding i.
fn bind_text(m: i64, i: i64, wcx: &EmbedCx<Comp>, pcx: &Ctx<Comp>) {
    buf_bytes(m, b"@binding(");
    buf_int(m, wcx.bind_b[i as usize]);
    buf_bytes(m, b") ");
    buf_bytes(m, bind_kind_text(wcx.bind_kind[i as usize]));
    buf_bytes(m, b" '");
    buf_bytes(m, sym_text(wcx.bind_name[i as usize], pcx));
    buf_byte(m, b'\'');
}

// gpu.unwritten (a warning) of followed buffer l.
fn unwritten(l: i64, wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    let en = wcx.l_uniform[l as usize];
    let d = wcx.l_uniform_bind[l as usize];
    let m = buf_new();
    buf_bytes(m, b"buffer '");
    buf_bytes(m, sym_text(wcx.l_name[l as usize], pcx));
    buf_bytes(m, b"' (");
    buf_file_line(m, wcx.l_pos[l as usize], pcx);
    buf_bytes(m, b") is bound at uniform '");
    buf_bytes(m, sym_text(wcx.bind_name[d as usize], pcx));
    buf_bytes(m, b"' (");
    buf_file_line(m, wcx.bind_pos[d as usize], pcx);
    buf_bytes(m, b"), but no write_buffer, map_write or copy into it is in this function");
    buf_byte(m, 0);
    let h = buf_new();
    buf_bytes(h, b"a new buffer holds zeros, no value: write it before the first submit that reads it, `queue.write_buffer(");
    buf_bytes(h, sym_text(wcx.l_name[l as usize], pcx));
    buf_bytes(h, b", 0, bytes)`, or make it with its bytes (`dev.buffer_init`)");
    buf_byte(h, 0);
    report_warning(pcx.nodes[en as usize].start, 0, c"gpu.unwritten", buf_slice(m).ptr,
        buf_slice(h).ptr, pcx);
}
