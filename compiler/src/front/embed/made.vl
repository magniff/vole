// The WGSL the compiler writes for a block (0.26.2, plan §10.1 item 3):
// the `const`s and `#[repr(wgsl)]` structs a `with` list names, so that
// one definition serves host and shader. A const of i32, u32, f32 or bool
// (or an array of them) with a literal value becomes `const W: u32 = 64u;`
// (an f32 written as it reads back, `0.1f`); a `#[repr(wgsl)]` struct its
// WGSL `struct`, its nested structs first, once each. Its layout is
// WGSL's (front::types::compute_layout under REPR_WGSL): `[f32; 3]` is a
// `vec3<f32>`, aligned to 16, so host and shader cannot disagree.
//
// A field WGSL cannot share (`bool`, `usize`, `i64`, a pointer, `Vec`, a
// reference, a tuple, an enum) is gpu.repr, naming it, with the fix when
// there is one (`u32` for a `bool`). Every `#[repr(wgsl)]` struct of the
// program is checked so (check_repr_structs), named in a `with` or not.

use crate::base::{IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fix, err_fmt, err_help};
use crate::front::ast::{NodeKind, REPR_WGSL, child};
use crate::front::embed::ctx::EmbedCx;
use crate::front::embed::parts::{item_named, path_module};
use crate::front::modules::module_of;

// Every `#[repr(wgsl)]` struct's fields checked (gpu.repr).
pub fn check_repr_structs(wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    wcx.bad_structs.clear();
    for i in 0..pcx.nodes[pcx.program as usize].count {
        let s = child(pcx.program, i, pcx);
        if pcx.nodes[s as usize].kind != NodeKind::Struct
            || (pcx.nodes[s as usize].c & REPR_WGSL) == 0 {
            continue;
        }
        let mut ok = true;
        let mut deps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let scratch = buf_new();
        for k in 0..pcx.nodes[s as usize].count {
            let f = child(s, k, pcx);
            if !wgsl_type(pcx.nodes[f as usize].b, s, f, scratch, &mut deps, true, wcx, pcx) {
                ok = false;
            }
        }
        if pcx.nodes[s as usize].count == 0 {
            repr_error(s, s, -1, b"has no fields: WGSL has no empty struct", b"", b"", pcx);
            ok = false;
        }
        if !ok {
            wcx.bad_structs.push(s);
        }
    }
}

// Whether struct s is one gpu.repr refused.
pub fn is_bad_struct(s: i64, wcx: &EmbedCx<Comp>) -> bool {
    for i in 0..wcx.bad_structs.len() as i64 {
        if wcx.bad_structs[i as usize] == s {
            return true;
        }
    }
    false
}

// Item (a Const or a struct) into `out`, after the structs its fields
// name, each once.
pub fn add_made(item: i64, out: &mut IntVec, wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    for i in 0..out.len() as i64 {
        if out.get(i) == item {
            return;
        }
    }
    if pcx.nodes[item as usize].kind == NodeKind::Struct {
        let mut deps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let scratch = buf_new();
        for k in 0..pcx.nodes[item as usize].count {
            let f = child(item, k, pcx);
            wgsl_type(pcx.nodes[f as usize].b, item, f, scratch, &mut deps, false, wcx, pcx);
        }
        for i in 0..deps.len() as i64 {
            add_made(deps.get(i), out, wcx, pcx);
        }
    }
    out.push(item);
}

// The WGSL of item (a Const or a `#[repr(wgsl)]` struct) into buffer b.
pub fn write_made(item: i64, b: i64, wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut deps = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    if pcx.nodes[item as usize].kind == NodeKind::Struct {
        buf_bytes(b, b"struct ");
        buf_bytes(b, sym_text(pcx.nodes[item as usize].a, pcx));
        buf_bytes(b, b" {\n");
        for k in 0..pcx.nodes[item as usize].count {
            let f = child(item, k, pcx);
            buf_bytes(b, b"    ");
            buf_bytes(b, sym_text(pcx.nodes[f as usize].a, pcx));
            buf_bytes(b, b": ");
            wgsl_type(pcx.nodes[f as usize].b, item, f, b, &mut deps, false, wcx, pcx);
            buf_bytes(b, b",\n");
        }
        buf_bytes(b, b"}\n");
        return;
    }
    buf_bytes(b, b"const ");
    buf_bytes(b, sym_text(pcx.nodes[item as usize].a, pcx));
    buf_bytes(b, b": ");
    let t = pcx.nodes[item as usize].b;
    wgsl_type(t, item, -1, b, &mut deps, false, wcx, pcx);
    buf_bytes(b, b" = ");
    write_value(pcx.nodes[item as usize].c, t, b, pcx);
    buf_bytes(b, b";\n");
}

// The scalar a type node names: 1 i32, 2 u32, 3 f32, 4 bool, 0 none.
fn scalar_of(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[t as usize].kind != NodeKind::TyName || pcx.nodes[t as usize].count > 0
        || pcx.nodes[t as usize].g != 0 {
        return 0;
    }
    let name = sym_text(pcx.nodes[t as usize].a, pcx);
    if name == b"i32" { 1 } else if name == b"u32" { 2 } else if name == b"f32" { 3 }
    else if name == b"bool" { 4 } else { 0 }
}

fn scalar_text(k: i64) -> &'static [u8] {
    if k == 1 { b"i32" } else if k == 2 { b"u32" } else if k == 3 { b"f32" } else { b"bool" }
}

// The literal length of array type node t, or -1.
fn array_len(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let n = pcx.nodes[t as usize].b;
    if n > 0 && pcx.nodes[n as usize].kind == NodeKind::Int { pcx.nodes[n as usize].a } else { -1 }
}

// The WGSL type of vole type node t into buffer b: field f of struct (or
// const) `owner` (f -1: the const's own type). A nested `#[repr(wgsl)]`
// struct goes into deps. False when WGSL cannot share it: gpu.repr when
// `report`.
fn wgsl_type(t: i64, owner: i64, f: i64, b: i64, deps: &mut IntVec, report: bool,
    wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    let k = pcx.nodes[t as usize].kind;
    let sc = scalar_of(t, pcx);
    if sc == 4 && f >= 0 {
        if report {
            repr_error(owner, f, t, b"is a bool, and WGSL's bool is not host-shareable",
                b"a bool's size is not WGSL's: write it as a u32 (0 or 1)", b"u32", pcx);
        }
        return false;
    }
    if sc != 0 {
        buf_bytes(b, scalar_text(sc));
        return true;
    }
    if k == NodeKind::TyArray {
        let n = array_len(t, pcx);
        if n < 0 {
            if report {
                repr_error(owner, f, t, b"is an array whose length is no integer literal",
                    b"write the length as a number: the WGSL is written before the program's consts are evaluated", b"", pcx);
            }
            return false;
        }
        let e = pcx.nodes[t as usize].a;
        let es = scalar_of(e, pcx);
        if es >= 1 && es <= 3 && n >= 2 && n <= 4 && f >= 0 {
            // [f32; 3]: vec3<f32>
            buf_bytes(b, b"vec");
            buf_int(b, n);
            buf_byte(b, b'<');
            buf_bytes(b, scalar_text(es));
            buf_byte(b, b'>');
            return true;
        }
        if pcx.nodes[e as usize].kind == NodeKind::TyArray
            && scalar_of(pcx.nodes[e as usize].a, pcx) != 0
            && array_len(e, pcx) == 3 {
            if report {
                repr_error(owner, f, t,
                    b"is an array of 3-element arrays: WGSL's array<vec3<_>, N> has a stride of 16, the host's of 12",
                    b"make the element a 4-element array", b"", pcx);
            }
            return false;
        }
        buf_bytes(b, b"array<");
        if !wgsl_type(e, owner, f, b, deps, report, wcx, pcx) {
            return false;
        }
        buf_bytes(b, b", ");
        buf_int(b, n);
        buf_byte(b, b'>');
        return true;
    }
    if k == NodeKind::TyName && pcx.nodes[t as usize].g == 0 && f >= 0 {
        let name = sym_text(pcx.nodes[t as usize].a, pcx);
        let fix = if name == b"usize" || name == b"u64" || name == b"u8" || name == b"u16" { "u32" }
            else if name == b"i64" || name == b"isize" || name == b"i8" || name == b"i16" { "i32" }
            else if name == b"f64" { "f32" } else { "" };
        if fix.len() > 0 && pcx.nodes[t as usize].count == 0 {
            if report {
                repr_error(owner, f, t, b"is no WGSL scalar: WGSL shares i32, u32 and f32",
                    b"write it as the WGSL scalar it fits", fix.as_bytes(), pcx);
            }
            return false;
        }
        let m = path_module(module_of(owner, pcx), t, false, wcx, pcx);
        let s: i64 = if m >= 0 { item_named(m, pcx.nodes[t as usize].a, wcx, pcx) } else { -1 };
        if s >= 0 && pcx.nodes[s as usize].kind == NodeKind::Struct
            && (pcx.nodes[s as usize].c & REPR_WGSL) != 0 {
            buf_bytes(b, sym_text(pcx.nodes[s as usize].a, pcx));
            deps.push(s);
            return true;
        }
        if s >= 0 && pcx.nodes[s as usize].kind == NodeKind::Struct {
            if report {
                repr_error(owner, f, t, b"is a struct without #[repr(wgsl)]",
                    b"put #[repr(wgsl)] on it, so that its layout is WGSL's too", b"", pcx);
            }
            return false;
        }
    }
    if report {
        repr_error(owner, f, t,
            b"is not host-shareable: a #[repr(wgsl)] struct holds i32, u32, f32, [T; 2|3|4] (vectors), arrays and #[repr(wgsl)] structs",
            b"no pointer, reference, Vec, slice, tuple, enum, bool or 64-bit number: they have no WGSL layout",
            b"", pcx);
    }
    false
}

// gpu.repr at field f of struct s (or the struct itself, f == s), its type
// node t: `S.f (T) <what>`, the help, and the fix (t's text replaced) when
// there is one.
fn repr_error(s: i64, f: i64, t: i64, what: &[u8], help: &[u8], fix: &[u8], pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"gpu.repr";
    let m = buf_new();
    buf_bytes(m, sym_text(pcx.nodes[s as usize].a, pcx));
    if f != s && f >= 0 {
        buf_byte(m, b'.');
        buf_bytes(m, sym_text(pcx.nodes[f as usize].a, pcx));
    }
    if t >= 0 {
        buf_bytes(m, b" (");
        buf_bytes(m,
            &get_src()[pcx.nodes[t as usize].start as usize..pcx.nodes[t as usize].end as usize]);
        buf_byte(m, b')');
    }
    buf_byte(m, b' ');
    buf_bytes(m, what);
    err_begin(if f >= 0 { pcx.nodes[f as usize].start } else { pcx.nodes[s as usize].start }, pcx);
    err_fmt(str::from_utf8(buf_slice(m)).unwrap(), pcx);
    if help.len() > 0 {
        let h = buf_new();
        buf_bytes(h, help);
        buf_byte(h, 0);
        err_help(buf_slice(h).ptr, pcx);
    }
    if fix.len() > 0 && t >= 0 {
        err_fix(pcx.nodes[t as usize].start, pcx.nodes[t as usize].end, fix, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// ---- consts ----

// Whether const c (named at `path`) can be written in WGSL: a scalar or
// an array of them, a literal value; else embed.with.
pub fn const_ok(c: i64, path: i64, pcx: &mut Ctx<Comp>) -> bool {
    let t = pcx.nodes[c as usize].b;
    let mut ok = scalar_of(t, pcx) != 0;
    if pcx.nodes[t as usize].kind == NodeKind::TyArray {
        ok = scalar_of(pcx.nodes[t as usize].a, pcx) != 0 && array_len(t, pcx) >= 0;
    }
    ok = ok && literal_ok(pcx.nodes[c as usize].c, t, pcx);
    if !ok {
        let saved = pcx.err_kind;
        pcx.err_kind = c"embed.with";
        err_begin(pcx.nodes[path as usize].start, pcx);
        err_fmt(format_args("the const '{}' cannot be written in WGSL: a shared const is an i32, u32, f32 or bool, or an array of them, with a literal value", str::from_utf8(sym_text(pcx.nodes[c as usize].a, pcx)).unwrap()), pcx);
        err_help(c"write its value as a literal (`pub const W: u32 = 64;`): the WGSL is written before the program's consts are evaluated", pcx);
        err_end_soft(pcx);
        pcx.err_kind = saved;
    }
    ok
}

// Whether expression v is a literal of type node t: a number, `-` one, a
// bool, or an array (`[a, b]`, `[a; n]`) of them for an array type.
fn literal_ok(v: i64, t: i64, pcx: &Ctx<Comp>) -> bool {
    if v <= 0 {
        return false;
    }
    let k = pcx.nodes[v as usize].kind;
    if pcx.nodes[t as usize].kind == NodeKind::TyArray {
        if k == NodeKind::Array {
            for i in 0..pcx.nodes[v as usize].count {
                if !literal_ok(child(v, i, pcx), pcx.nodes[t as usize].a, pcx) {
                    return false;
                }
            }
            return pcx.nodes[v as usize].count == array_len(t, pcx);
        }
        return k == NodeKind::Repeat
            && literal_ok(pcx.nodes[v as usize].a, pcx.nodes[t as usize].a, pcx);
    }
    let sc = scalar_of(t, pcx);
    if sc == 4 {
        return k == NodeKind::Bool;
    }
    if k == NodeKind::Unary && pcx.nodes[v as usize].op == crate::front::lexer::Tok::Minus {
        return sc != 2 && literal_ok(pcx.nodes[v as usize].b, t, pcx);
    }
    if k == NodeKind::Float {
        // (an f32 WGSL can write: finite)
        let x = f64::from_bits((pcx.nodes[v as usize].a as u64)) as f32;
        return sc == 3 && x == x && x - x == 0.0;
    }
    k == NodeKind::Int
}

// Literal v (literal_ok's) of type node t, in WGSL, into buffer b.
fn write_value(v: i64, t: i64, b: i64, pcx: &Ctx<Comp>) {
    let k = pcx.nodes[v as usize].kind;
    if pcx.nodes[t as usize].kind == NodeKind::TyArray {
        let e = pcx.nodes[t as usize].a;
        let n = array_len(t, pcx);
        buf_bytes(b, b"array<");
        buf_bytes(b, scalar_text(scalar_of(e, pcx)));
        buf_bytes(b, b", ");
        buf_int(b, n);
        buf_bytes(b, b">(");
        for i in 0..n {
            if i > 0 {
                buf_bytes(b, b", ");
            }
            write_value(if k == NodeKind::Array { child(v, i, pcx) }
                else { pcx.nodes[v as usize].a }, e, b,
                pcx);
        }
        buf_byte(b, b')');
        return;
    }
    let sc = scalar_of(t, pcx);
    if k == NodeKind::Bool {
        buf_bytes(b, if pcx.nodes[v as usize].a != 0 { b"true" } else { b"false" });
    } else if k == NodeKind::Unary {
        buf_byte(b, b'-');
        write_value(pcx.nodes[v as usize].b, t, b, pcx);
    } else if sc == 3 {
        let x = if k == NodeKind::Float { f64::from_bits((pcx.nodes[v as usize].a as u64)) as f32 }
            else { pcx.nodes[v as usize].a as f32 };
        let s = buf_new();
        crate::base::buf_fmt(s, format_args("{x}"));
        buf_bytes(b, buf_slice(s));
        buf_byte(b, b'f');
    } else {
        buf_int(b, pcx.nodes[v as usize].a);
        buf_byte(b, if sc == 1 { b'i' } else { b'u' });
    }
}
