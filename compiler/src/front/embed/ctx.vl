// (0.26.4, statics P3) The embedded WGSL's check state, made by check_program and passed
// down as `wcx` (tools/statics/front-embed.group): what were its statics,
// the comment above a field naming the static it was.

use std::alloc::Allocator;

use crate::base::comp::Comp;

pub struct EmbedCx<A: Allocator> {
    // (front::embed::gpu_lint::ASSIGNED)
    pub assigned: Vec<i64, A>,
    // Each name's bindings and assignments in the function (pairs: name,
    // count), for the "bound once, never assigned" rule.
    // (front::embed::gpu_lint::BOUND)
    pub bound: Vec<i64, A>,
    // (front::embed::gpu_lint::GPU_MODULE)
    pub gpu_module: i64,
    // (front::embed::gpu_lint::L_BLOCK)
    pub l_block: Vec<i64, A>,
    // (front::embed::gpu_lint::L_ENTRY)
    pub l_entry: Vec<i64, A>,
    // (front::embed::gpu_lint::L_ESCAPED)
    pub l_escaped: Vec<i64, A>,
    // (front::embed::gpu_lint::L_GROUP)
    pub l_group: Vec<i64, A>,
    // (front::embed::gpu_lint::L_KIND)
    pub l_kind: Vec<i64, A>,
    // The followed names of the function being linted: the name, what it
    // holds, its block (an index of BLOCK_NODE), the pipeline's entry point
    // (a symbol; 0: none), the layout's group, the buffer's usage (-1: not
    // constant) and its usage expression, the `let`'s position, whether it
    // is written, whether it escapes, and the bind entry that binds it at a
    // uniform binding (its node; 0: none) with that binding (a BIND_ index).
    // (front::embed::gpu_lint::L_NAME)
    pub l_name: Vec<i64, A>,
    // (front::embed::gpu_lint::L_POS)
    pub l_pos: Vec<i64, A>,
    // (front::embed::gpu_lint::L_UNIFORM)
    pub l_uniform: Vec<i64, A>,
    // (front::embed::gpu_lint::L_UNIFORM_BIND)
    pub l_uniform_bind: Vec<i64, A>,
    // (front::embed::gpu_lint::L_USAGE)
    pub l_usage: Vec<i64, A>,
    // (front::embed::gpu_lint::L_USAGE_NODE)
    pub l_usage_node: Vec<i64, A>,
    // (front::embed::gpu_lint::L_WRITTEN)
    pub l_written: Vec<i64, A>,
    // (front::embed::gpu_lint::SYM_BUFFER_USAGE)
    pub sym_buffer_usage: i64,
    // (front::embed::gpu_lint::SYM_SRC)
    pub sym_src: i64,
    // The checker's temporaries in scope (the blocks being walked): a
    // contract's check binds a call's arguments to `?aN` lets in a block
    // around the call. Name and value, in pairs.
    // (front::embed::gpu_lint::TEMPS)
    pub temps: Vec<i64, A>,
    // The `#[repr(wgsl)]` structs whose fields WGSL cannot share all of
    // (gpu.repr said so): no WGSL is written for them.
    // (front::embed::made::BAD_STRUCTS)
    pub bad_structs: Vec<i64, A>,
    // (front::embed::parts::SYM_CRATE)
    pub sym_crate: i64,
    // (front::embed::parts::SYM_SELF)
    pub sym_self: i64,
    // (front::embed::parts::SYM_SUPER)
    pub sym_super: i64,
    // (front::embed::parts::SYM_WGSL)
    pub sym_wgsl: i64,
    // (front::embed::parts::WITH_ITEM)
    pub with_item: Vec<i64, A>,
    // (front::embed::wgsl::BIND_B)
    pub bind_b: Vec<i64, A>,
    // The bindings of every module: its block (an index of BLOCK_NODE), group,
    // binding, kind (BK_), name (a symbol) and position in SRC.
    // (front::embed::wgsl::BIND_BLOCK)
    pub bind_block: Vec<i64, A>,
    // (front::embed::wgsl::BIND_G)
    pub bind_g: Vec<i64, A>,
    // (front::embed::wgsl::BIND_KIND)
    pub bind_kind: Vec<i64, A>,
    // (front::embed::wgsl::BIND_NAME)
    pub bind_name: Vec<i64, A>,
    // (front::embed::wgsl::BIND_POS)
    pub bind_pos: Vec<i64, A>,
    // (front::embed::wgsl::ENTRY_POS)
    pub entry_pos: Vec<i64, A>,
    // The first error of the block being checked: its code, position,
    // message and help (buffers).
    // (front::embed::wgsl::FAIL_CODE)
    pub fail_code: i64,
    // (front::embed::wgsl::FAIL_HELP)
    pub fail_help: i64,
    // (front::embed::wgsl::FAIL_MSG)
    pub fail_msg: i64,
    // (front::embed::wgsl::FAIL_POS)
    pub fail_pos: i64,
    // (front::embed::wgsl::PIECE_LEN)
    pub piece_len: Vec<i64, A>,
    // (0.26.2) The module being checked, in pieces: for each, its offset in
    // the module's text, its start in SRC (-1: none, its node's `from`
    // string), its length and its block's node. Made again for each module.
    // (front::embed::wgsl::PIECE_MOD)
    pub piece_mod: Vec<i64, A>,
    // (front::embed::wgsl::PIECE_NODE)
    pub piece_node: Vec<i64, A>,
    // (front::embed::wgsl::PIECE_SRC)
    pub piece_src: Vec<i64, A>,
    // The errors reported so far, their positions in SRC: a part's error is
    // reported once, not once for each module that includes it.
    // (front::embed::wgsl::REPORTED)
    pub reported: Vec<i64, A>,
}

// A new context: every field at its static's first value.
pub fn embed_cx_new() -> EmbedCx<Comp> {
    EmbedCx {
        assigned: Vec::new_in(Comp {}),
        bound: Vec::new_in(Comp {}),
        gpu_module: -1,
        l_block: Vec::new_in(Comp {}),
        l_entry: Vec::new_in(Comp {}),
        l_escaped: Vec::new_in(Comp {}),
        l_group: Vec::new_in(Comp {}),
        l_kind: Vec::new_in(Comp {}),
        l_name: Vec::new_in(Comp {}),
        l_pos: Vec::new_in(Comp {}),
        l_uniform: Vec::new_in(Comp {}),
        l_uniform_bind: Vec::new_in(Comp {}),
        l_usage: Vec::new_in(Comp {}),
        l_usage_node: Vec::new_in(Comp {}),
        l_written: Vec::new_in(Comp {}),
        sym_buffer_usage: 0,
        sym_src: 0,
        temps: Vec::new_in(Comp {}),
        bad_structs: Vec::new_in(Comp {}),
        sym_crate: 0,
        sym_self: 0,
        sym_super: 0,
        sym_wgsl: 0,
        with_item: Vec::new_in(Comp {}),
        bind_b: Vec::new_in(Comp {}),
        bind_block: Vec::new_in(Comp {}),
        bind_g: Vec::new_in(Comp {}),
        bind_kind: Vec::new_in(Comp {}),
        bind_name: Vec::new_in(Comp {}),
        bind_pos: Vec::new_in(Comp {}),
        entry_pos: Vec::new_in(Comp {}),
        fail_code: -1,
        fail_help: -1,
        fail_msg: -1,
        fail_pos: 0,
        piece_len: Vec::new_in(Comp {}),
        piece_mod: Vec::new_in(Comp {}),
        piece_node: Vec::new_in(Comp {}),
        piece_src: Vec::new_in(Comp {}),
        reported: Vec::new_in(Comp {}),
    }
}

// Owned (a Drop of its own, which does nothing), so that a let
// parameter lends the context instead of copying it.
impl<A: Allocator> Drop for EmbedCx<A> {
    fn drop(&mut self) {}
}
