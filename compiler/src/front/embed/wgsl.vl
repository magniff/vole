// Embedded WGSL blocks (0.26.0): what `embed wgsl K { .. }` (or `from
// "x.wgsl";`) means. The block is an item that makes two things: a struct
// type the compiler names `embed wgsl K` (source cannot name it in 0.26),
// its fields `pub` and `[u8]`: `src`, the block's text, and one per entry
// point (`@compute`/`@vertex`/`@fragment fn X`) holding its name, `"X"`;
// and an immutable `static K` of that type. So `dev.shader_wgsl(K.src)?`
// and `dev.compute_pipeline(s, K.main)` take it as std::gpu is. The entry
// points come from a scan of the text's tokens (comments skipped), so the
// type exists before the declarations are collected; the field `step` is
// at the WGSL `fn step`, `src` at the `{`.

use std::{Arena, Gpa};
use std::gpu::wgsl::uniformity;
use std::gpu::wgsl::front::new_front;

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_clear, buf_int, buf_new, buf_slice, intern, intern_c, sym_name,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_file_line, err_begin, err_end_soft, err_fix, err_fmt, err_help, err_str, err_sym,
};
use crate::front::ast::{NodeKind, child, list_begin, list_end, list_push, new_node};
use crate::front::check::names::near_to;
use crate::front::embed::append_block_file;
use crate::front::embed::ctx::EmbedCx;
use crate::front::embed::made::write_made;
use crate::front::embed::parts::{
    file_line_text, is_part, module_items, module_order, resolve_parts, users_of,
};
use crate::front::lexer::{Tok, add_string, keyword_of_sym, str_at};
use crate::front::lexer::embedded::comment_end;
use crate::front::parser::items::ITEM_PUBLIC;

// The entry points' stages, as the scan finds them.
pub const STAGE_COMPUTE: i64 = 1;
pub const STAGE_VERTEX: i64 = 2;
pub const STAGE_FRAGMENT: i64 = 3;

// The program's blocks made into their structs and statics, appended to
// the program (before collect_phase, next to expand_derives). (0.26.2)
// First the parts (parts.vl) and the files of the file form (each a
// SOURCE_WGSL file of the program), so that every block's text has its
// place in SRC before any module is put together.
pub fn expand_embeds(wcx: inout EmbedCx, pcx: inout Ctx<Comp>) {
    pcx.block_node.count = 0;
    pcx.block_struct.count = 0;
    pcx.block_first.count = 0;
    pcx.entry_sym.count = 0;
    pcx.entry_stage.count = 0;
    wcx.entry_pos.count = 0;
    wcx.reported.count = 0;
    wcx.bind_block.count = 0;
    wcx.bind_g.count = 0;
    wcx.bind_b.count = 0;
    wcx.bind_kind.count = 0;
    wcx.bind_name.count = 0;
    wcx.bind_pos.count = 0;
    resolve_parts(&wcx, &pcx);
    if pcx.blocks.count == 0 {
        return;
    }
    for b in 0..pcx.blocks.count {
        let e = pcx.blocks.get(b);
        if pcx.nodes[e].d < 0 {
            pcx.nodes[e].g = append_block_file(pcx.nodes[e].h, str_at(pcx.nodes[e].x), &pcx);
        }
    }
    var made = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    for b in 0..pcx.blocks.count {
        make_items(b, &made, &wcx, &pcx);
    }
    let all = list_begin(pcx);
    for i in 0..pcx.nodes[pcx.program].count {
        list_push(child(pcx.program, i, pcx), &pcx);
    }
    for i in 0..made.count {
        list_push(made.get(i), &pcx);
    }
    list_end(pcx.program, all, &pcx);
}

// Block b's struct and static, into `made`. A block that is no part gets
// its module (its parts' texts, then its own: module_order), scanned for
// entry points and checked; a part only its own text's entry points.
fn make_items(b: i64, made: inout IntVec, wcx: inout EmbedCx, pcx: inout Ctx<Comp>) {
    let e = pcx.blocks.get(b);
    let first = pcx.entry_sym.count;
    var src_id = pcx.nodes[e].c;
    wcx.piece_mod.count = 0;
    wcx.piece_src.count = 0;
    wcx.piece_len.count = 0;
    wcx.piece_node.count = 0;
    if is_part(b, pcx) {
        scan_block(e, first, &wcx, &pcx);
    } else {
        var order = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        module_order(b, &order, pcx);
        var items = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let shared_ok = module_items(order, &items, wcx, &pcx);
        let bfirst = wcx.bind_block.count;
        if order.count == 1 && items.count == 0 {
            add_piece(0, e, &wcx, pcx);
            scan_block(e, first, &wcx, &pcx);
            scan_bindings(e, b, &wcx, pcx);
            if !duplicate_bindings(b, bfirst, wcx, &pcx) {
                check_block(e, str_at(pcx.nodes[e].c), &wcx, &pcx);
            }
        } else {
            let m = buf_new();
            // (0.26.2) the WGSL of the consts and structs it names, first
            for i in 0..items.count {
                let at = buf_slice(m).len as i64;
                write_made(items.get(i), m, wcx, &pcx);
                wcx.piece_mod.push(at);
                wcx.piece_src.push(-1);
                wcx.piece_len.push(buf_slice(m).len as i64 - at);
                wcx.piece_node.push(items.get(i));
            }
            for i in 0..order.count {
                let p = pcx.blocks.get(order.get(i));
                add_piece(buf_slice(m).len as i64, p, &wcx, pcx);
                buf_bytes(m, str_at(pcx.nodes[p].c));
                buf_byte(m, '\n');
                scan_block(p, first, &wcx, &pcx);
                scan_bindings(p, b, &wcx, pcx);
            }
            src_id = add_string(buf_slice(m));
            if shared_ok && !duplicate_bindings(b, bfirst, wcx, &pcx) {
                check_block(e, buf_slice(m), &wcx, &pcx);
            }
        }
    }
    let open = if pcx.nodes[e].d >= 0 { pcx.nodes[e].d - 1 } else { pcx.nodes[e].h };
    let name = pcx.nodes[e].a;
    let at = pcx.nodes[e].y;
    let public = (pcx.nodes[e].p & ITEM_PUBLIC) != 0;
    let ty_sym = intern(embed_type_name(name));
    // the struct: `src`, then the entry points
    let s = new_node(NodeKind::Struct, at, pcx.nodes[e].end, &pcx);
    pcx.nodes[s].a = ty_sym;
    let mark = list_begin(pcx);
    list_push(field(intern_c(c"src"), open, &pcx), &pcx);
    for k in first..pcx.entry_sym.count {
        list_push(field(pcx.entry_sym.get(k), wcx.entry_pos.get(k), &pcx), &pcx);
    }
    list_end(s, mark, &pcx);
    // the static: `static K: embed wgsl K = embed wgsl K { src: "..", main: "main" }`
    let st = new_node(NodeKind::Static, at, pcx.nodes[e].end, &pcx);
    pcx.nodes[st].a = name;
    pcx.nodes[st].b = ty_name(ty_sym, at, &pcx);
    let lit = new_node(NodeKind::StructLit, at, pcx.nodes[e].end, &pcx);
    pcx.nodes[lit].a = ty_sym;
    let inits = list_begin(pcx);
    list_push(init(intern_c(c"src"), src_id, open, &pcx), &pcx);
    for k in first..pcx.entry_sym.count {
        let id = add_string(sym_text(pcx.entry_sym.get(k)));
        list_push(init(pcx.entry_sym.get(k), id, wcx.entry_pos.get(k), &pcx), &pcx);
    }
    list_end(lit, inits, &pcx);
    pcx.nodes[st].c = lit;
    if public {
        pcx.nodes[s].p |= ITEM_PUBLIC;
        pcx.nodes[st].p |= ITEM_PUBLIC;
    }
    pcx.block_node.push(e);
    pcx.block_struct.push(s);
    pcx.block_first.push(first);
    made.push(s);
    made.push(st);
}

// The start in SRC of block e's text: the block's own, or its file's (-1:
// the file could not be read).
fn text_start(e: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.nodes[e].d >= 0 { pcx.nodes[e].d } else { pcx.nodes[e].g }
}

// Block e's text at module offset `at`, a piece of the module.
fn add_piece(at: i64, e: i64, wcx: inout EmbedCx, pcx: Ctx<Comp>) {
    wcx.piece_mod.push(at);
    wcx.piece_src.push(text_start(e, pcx));
    wcx.piece_len.push(str_at(pcx.nodes[e].c).len as i64);
    wcx.piece_node.push(e);
}

// The entry points of block e's text, into the ENTRY_ lists of the block
// whose first is `first`.
fn scan_block(e: i64, first: i64, wcx: inout EmbedCx, pcx: inout Ctx<Comp>) {
    let at = text_start(e, pcx);
    scan_entries(str_at(pcx.nodes[e].c), at, if at >= 0 { at } else { pcx.nodes[e].h }, first, &wcx,
        &pcx);
}

// The made type's name, `embed wgsl K`.
pub fn embed_type_name(name: i64) -> [u8] {
    let b = buf_new();
    buf_bytes(b, "embed wgsl ");
    buf_bytes(b, sym_text(name));
    buf_slice(b)
}

// A `pub` field `name: [u8]` at pos.
fn field(name: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let f = new_node(NodeKind::Field, pos, pos + sym_text(name).len as i64, &pcx);
    pcx.nodes[f].a = name;
    pcx.nodes[f].p |= ITEM_PUBLIC;
    let t = new_node(NodeKind::TySlice, pos, pos, &pcx);
    pcx.nodes[t].a = ty_name(intern_c(c"u8"), pos, &pcx);
    pcx.nodes[f].b = t;
    f
}

fn ty_name(sym: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let t = new_node(NodeKind::TyName, pos, pos, &pcx);
    pcx.nodes[t].a = sym;
    t
}

// `name: "<string id>"`, a field's initializer at pos.
fn init(name: i64, id: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    let v = new_node(NodeKind::Str, pos, pos, &pcx);
    pcx.nodes[v].a = id;
    let f = new_node(NodeKind::FieldInit, pos, pos, &pcx);
    pcx.nodes[f].a = name;
    pcx.nodes[f].b = v;
    f
}

// The entry points of WGSL `text` into the ENTRY_ lists: an `@compute`,
// `@vertex` or `@fragment` attribute, then `fn NAME`; comments skipped.
// Positions are `base` + the offset in text when `at` >= 0, else `base`
// (the file form: the `from` string's). An entry named `src` (the text's
// field) or a vole keyword is embed.name, and makes no field; one named
// twice makes one (WGSL's check reports it).
fn scan_entries(text: [u8], at: i64, base: i64, first: i64, wcx: inout EmbedCx,
    pcx: inout Ctx<Comp>) {
    let compute = intern_c(c"compute");
    let vertex = intern_c(c"vertex");
    let fragment = intern_c(c"fragment");
    let fn_sym = intern_c(c"fn");
    var stage = 0;
    var after_fn = false;
    var after_at = false;
    var p = 0;
    while p < text.len as i64 {
        let c = text[p];
        if c == '/' && p + 1 < text.len as i64 && (text[p + 1] == '/' || text[p + 1] == '*') {
            p = comment_end(text, p);
            continue;
        }
        if ident_start(c) {
            var q = p + 1;
            while q < text.len as i64
                && (ident_start(text[q]) || (text[q] >= '0' && text[q] <= '9')) {
                q += 1;
            }
            let sym = intern(text[p..q]);
            if after_at {
                if sym == compute {
                    stage = STAGE_COMPUTE;
                } else if sym == vertex {
                    stage = STAGE_VERTEX;
                } else if sym == fragment {
                    stage = STAGE_FRAGMENT;
                }
            } else if after_fn {
                if stage != 0 {
                    add_entry(sym, stage, if at >= 0 { at + p } else { base }, first, &wcx, &pcx);
                }
                stage = 0;
                after_fn = false;
            } else if sym == fn_sym {
                after_fn = true;
            }
            after_at = false;
            p = q;
            continue;
        }
        if c >= '0' && c <= '9' {
            while p < text.len as i64 && (ident_start(text[p]) || (text[p] >= '0' && text[p] <= '9')
                || text[p] == '.') {
                p += 1;
            }
            after_at = false;
            continue;
        }
        if c == '@' {
            after_at = true;
        } else if c == ';' || c == '{' || c == '}' {
            stage = 0;
            after_fn = false;
            after_at = false;
        } else if c != ' ' && c != '\t' && c != '\n' && c != '\r' {
            after_at = false;
        }
        p += 1;
    }
}

fn ident_start(c: u8) -> bool {
    (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

// ---- (0.26.2) A module's bindings, from a scan of its text ----
//
// `@group(G) @binding(B) var<uniform> NAME: T` (either attribute first;
// `var<storage, read>`, `var<storage, read_write>`, `var NAME:
// texture_..`, `var NAME: sampler`), comments skipped: for gpu_lint.vl's
// diagnostics and wgsl.binding across parts, never from std::gpu::wgsl's
// reflection.

pub const BK_UNIFORM: i64 = 1;
pub const BK_STORAGE: i64 = 2;
pub const BK_STORAGE_RW: i64 = 3;
pub const BK_TEXTURE: i64 = 4;
pub const BK_SAMPLER: i64 = 5;
pub const BK_STORAGE_TEXTURE: i64 = 6;

// The bindings of block e's text (at `at` in SRC; -1: none), into the
// BIND_ lists for module b.
fn scan_bindings(e: i64, b: i64, wcx: inout EmbedCx, pcx: Ctx<Comp>) {
    let text = str_at(pcx.nodes[e].c);
    let at = if pcx.nodes[e].d >= 0 { pcx.nodes[e].d } else { pcx.nodes[e].g };
    if at < 0 {
        return;
    }
    var p = 0;
    while p < text.len as i64 {
        let c = text[p];
        if c == '/' && p + 1 < text.len as i64 && (text[p + 1] == '/' || text[p + 1] == '*') {
            p = comment_end(text, p);
            continue;
        }
        if c != '@' {
            p += 1;
            continue;
        }
        // the attributes, then `var`
        let start = p;
        var group = -1;
        var binding = -1;
        var q = p;
        while q < text.len as i64 && text[q] == '@' {
            let (word, w_end) = word_at(text, q + 1);
            q = skip_space(text, w_end);
            var value = -1;
            if q < text.len as i64 && text[q] == '(' {
                let v0 = skip_space(text, q + 1);
                var v = v0;
                value = 0;
                while v < text.len as i64 && text[v] >= '0' && text[v] <= '9' {
                    value = value * 10 + (text[v] - '0') as i64;
                    v += 1;
                }
                if v == v0 {
                    value = -1;
                }
                while q < text.len as i64 && text[q] != ')' {
                    q += 1;
                }
                q = skip_space(text, q + 1);
            }
            if word == "group" {
                group = value;
            } else if word == "binding" {
                binding = value;
            }
        }
        let (kw, kw_end) = word_at(text, q);
        if group < 0 || binding < 0 || kw != "var" {
            p = if q > start { q } else { start + 1 };
            continue;
        }
        q = skip_space(text, kw_end);
        var space: [u8] = "";
        var access: [u8] = "";
        if q < text.len as i64 && text[q] == '<' {
            let (s, s_end) = word_at(text, skip_space(text, q + 1));
            space = s;
            q = skip_space(text, s_end);
            if q < text.len as i64 && text[q] == ',' {
                let (a, a_end) = word_at(text, skip_space(text, q + 1));
                access = a;
                q = a_end;
            }
            while q < text.len as i64 && text[q] != '>' {
                q += 1;
            }
            q = skip_space(text, q + 1);
        }
        let (name, n_end) = word_at(text, q);
        q = skip_space(text, n_end);
        var ty: [u8] = "";
        if q < text.len as i64 && text[q] == ':' {
            let (t, _t_end) = word_at(text, skip_space(text, q + 1));
            ty = t;
        }
        let kind = if space == "uniform" { BK_UNIFORM } else if space == "storage" {
            if access == "read_write" { BK_STORAGE_RW } else { BK_STORAGE } }
            else if ty == "sampler" || ty == "sampler_comparison" { BK_SAMPLER }
            else if ty.len > 16 && ty[0..16] == "texture_storage_" { BK_STORAGE_TEXTURE }
            else { BK_TEXTURE };
        if name.len > 0 {
            wcx.bind_block.push(b);
            wcx.bind_g.push(group);
            wcx.bind_b.push(binding);
            wcx.bind_kind.push(kind);
            wcx.bind_name.push(intern(name));
            wcx.bind_pos.push(at + start);
        }
        p = q;
    }
}

// The identifier at text[p] (empty when none) and its end.
fn word_at(text: [u8], p: i64) -> ([u8], i64) {
    var q = p;
    while q < text.len as i64 && (ident_start(text[q]) || (text[q] >= '0' && text[q] <= '9')) {
        q += 1;
    }
    (text[p..q], q)
}

fn skip_space(text: [u8], p0: i64) -> i64 {
    var p = p0;
    while p < text.len as i64
        && (text[p] == ' ' || text[p] == '\t' || text[p] == '\n' || text[p] == '\r') {
        p += 1;
    }
    p
}

// (wgsl.binding across parts) Two bindings of module b at one group and
// binding, from `first` of the BIND_ lists: reported at the second, naming
// the first's block and line; true when there was one.
fn duplicate_bindings(b: i64, first: i64, wcx: EmbedCx, pcx: inout Ctx<Comp>) -> bool {
    for j in first..wcx.bind_block.count {
        for i in first..j {
            if wcx.bind_g.get(i) == wcx.bind_g.get(j) && wcx.bind_b.get(i) == wcx.bind_b.get(j) {
                duplicate_error(b, i, j, wcx, &pcx);
                return true;
            }
        }
    }
    false
}

fn duplicate_error(b: i64, i: i64, j: i64, wcx: EmbedCx, pcx: inout Ctx<Comp>) {
    // the block whose text holds the first
    let holder = piece_node_at(wcx.bind_pos.get(i), wcx);
    let saved = pcx.err_kind;
    pcx.err_kind = c"wgsl.binding";
    err_begin(wcx.bind_pos.get(j), &pcx);
    let m = buf_new();
    buf_bytes(m, "@group(");
    buf_int(m, wcx.bind_g.get(j));
    buf_bytes(m, ") @binding(");
    buf_int(m, wcx.bind_b.get(j));
    buf_bytes(m, ") is already '");
    buf_bytes(m, sym_text(wcx.bind_name.get(i)));
    buf_bytes(m, "' (");
    if holder > 0 {
        buf_bytes(m, sym_text(pcx.nodes[holder].a));
        buf_bytes(m, ", ");
    }
    buf_file_line(m, wcx.bind_pos.get(i), &pcx);
    buf_bytes(m, ")");
    err_fmt(buf_slice(m), pcx);
    let h = buf_new();
    buf_bytes(h, "two resources of one module at one group and binding: give each its own, or put them in different modules; the module of '");
    buf_bytes(h, sym_text(pcx.nodes[pcx.blocks.get(b)].a));
    buf_bytes(h, "' is the text of its parts (`with`) and its own");
    buf_byte(h, 0);
    err_help(buf_slice(h).ptr, pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// The block whose piece of the module being made holds SRC position pos
// (its Embed node), or 0.
fn piece_node_at(pos: i64, wcx: EmbedCx) -> i64 {
    for k in 0..wcx.piece_src.count {
        let at = wcx.piece_src.get(k);
        if at >= 0 && pos >= at && pos < at + wcx.piece_len.get(k) {
            return wcx.piece_node.get(k);
        }
    }
    0
}

// Entry `sym` at pos (stage), unless it is no field's name (embed.name)
// or the block has it already (from `first`).
fn add_entry(sym: i64, stage: i64, pos: i64, first: i64, wcx: inout EmbedCx, pcx: inout Ctx<Comp>) {
    for k in first..pcx.entry_sym.count {
        if pcx.entry_sym.get(k) == sym {
            return;
        }
    }
    if sym == intern_c(c"src") || keyword_of_sym(sym, pcx) != Tok::Eof {
        let saved = pcx.err_kind;
        pcx.err_kind = c"embed.name";
        err_begin(pos, &pcx);
        err_str(c"the entry point '", pcx);
        err_sym(sym, pcx);
        if sym == intern_c(c"src") {
            err_str(c"' would be the block's field 'src', its text", pcx);
        } else {
            err_str(c"' is a keyword of vole: no field can have its name", pcx);
        }
        err_help(c"an embedded block's fields are 'src' and one per entry point, named as it is: rename the entry point", pcx);
        err_end_soft(&pcx);
        pcx.err_kind = saved;
        return;
    }
    pcx.entry_sym.push(sym);
    pcx.entry_stage.push(stage);
    wcx.entry_pos.push(pos);
}

// ---- The check: std::gpu::wgsl's front end, at check time ----
//
// Every block's text goes through std::gpu::wgsl's checking half, as
// `translate` does before it writes anything: `new_front`, `module`, then
// `uniformity::check`, on an arena given back when the block is done.
// Never `translate`: it names the writers (msl, spirv, dump), which every
// check of a program would then compile. The front stops at its first
// error, so a block has at most one: reported at its position in the
// block's text (the block form), or at the `from` string with the file's
// `x.wgsl:L:C:` first (the file form).

// The arena the checks allocate from (main's gpa: wgsl_init).
static var WGSL_ARENA: Arena = Arena::none();

// (main) The checks' arena, from gpa.
pub fn wgsl_init(gpa: Gpa) {
    WGSL_ARENA = Arena::with_capacity_in(0, gpa);
}

// Block e's text checked: its first error reported.
fn check_block(e: i64, text: [u8], wcx: inout EmbedCx, pcx: inout Ctx<Comp>) {
    if wcx.fail_code < 0 {
        wcx.fail_code = buf_new();
        wcx.fail_msg = buf_new();
        wcx.fail_help = buf_new();
    }
    let failed = WGSL_ARENA.scope(|a| -> bool {
        var fr = new_front(text, a);
        fr.module();
        if !fr.failed {
            uniformity::check(fr);
        }
        if fr.failed {
            wcx.fail_pos = fr.err_pos;
            buf_clear(wcx.fail_code);
            buf_bytes(wcx.fail_code, fr.err_code);
            buf_clear(wcx.fail_msg);
            buf_bytes(wcx.fail_msg, fr.emsg.as_slice());
            buf_clear(wcx.fail_help);
            buf_bytes(wcx.fail_help, fr.ehelp.as_slice());
        }
        fr.failed
    });
    if failed {
        report(e, text, &wcx, &pcx);
    }
}

// The error FAIL_ holds, of block e's module (text): at its position in
// the piece it is in (0.26.2: a part's text, the block's own, or its
// file's, a file of the program: `x.wgsl:L:C`), once.
fn report(e: i64, text: [u8], wcx: inout EmbedCx, pcx: inout Ctx<Comp>) {
    let pos = if wcx.fail_pos < 0 { 0 } else if wcx.fail_pos > text.len as i64 { text.len as i64 }
        else { wcx.fail_pos };
    var at = pcx.nodes[e].h;
    var made = -1;
    if wcx.piece_mod.count > 0 {
        var k = 0;
        while k + 1 < wcx.piece_mod.count && wcx.piece_mod.get(k + 1) <= pos {
            k += 1;
        }
        let off = pos - wcx.piece_mod.get(k);
        let len = wcx.piece_len.get(k);
        let node = wcx.piece_node.get(k);
        if wcx.piece_src.get(k) >= 0 {
            at = wcx.piece_src.get(k) + (if off > len { len } else { off });
        } else if pcx.nodes[node].kind == NodeKind::Embed {
            at = pcx.nodes[node].h;
        } else {
            // (0.26.2: the WGSL written for a const or a struct: at its
            // declaration)
            at = pcx.nodes[node].start;
            made = node;
        }
    }
    for i in 0..wcx.reported.count {
        if wcx.reported.get(i) == at {
            return;
        }
    }
    wcx.reported.push(at);
    let saved = pcx.err_kind;
    pcx.err_kind = sym_name(intern(buf_slice(wcx.fail_code)));
    err_begin(at, &pcx);
    err_fmt(buf_slice(wcx.fail_msg), pcx);
    if made >= 0 {
        err_fmt(format_args(" (in the WGSL made for '{}')", sym_text(pcx.nodes[made].a)), pcx);
    }
    if buf_slice(wcx.fail_help).len > 0 {
        let h = buf_new();
        buf_bytes(h, buf_slice(wcx.fail_help));
        buf_byte(h, 0);
        err_help(buf_slice(h).ptr, pcx);
    }
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// ---- gpu.entry: a block's entry point that is not there ----

// (synth_field) Field `name` of a struct (its node `node`) that has none,
// at node n: when the struct is a block's type, gpu.entry, naming the block's entry points (the
// nearest as the fix), and true; else false (the struct's own error).
pub fn entry_error(n: i64, node: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    var b = -1;
    for i in 0..pcx.block_struct.count {
        if pcx.block_struct.get(i) == node {
            b = i;
        }
    }
    if b < 0 {
        return false;
    }
    let e = pcx.block_node.get(b);
    let first = pcx.block_first.get(b);
    let end = if b + 1 < pcx.block_first.count { pcx.block_first.get(b + 1) }
        else { pcx.entry_sym.count };
    let saved = pcx.err_kind;
    pcx.err_kind = c"gpu.entry";
    err_begin(pcx.nodes[n].start, &pcx);
    err_str(c"the block '", pcx);
    err_sym(pcx.nodes[e].a, pcx);
    err_str(c"' has no entry point '", pcx);
    err_sym(name, pcx);
    if end == first {
        err_str(c"'; it has no entry points (`@compute`, `@vertex` or `@fragment fn`)", pcx);
    } else {
        err_str(c"'; its entry points: ", pcx);
        for k in first..end {
            if k > first {
                err_str(c", ", pcx);
            }
            err_sym(pcx.entry_sym.get(k), pcx);
            let stage = pcx.entry_stage.get(k);
            err_str(if stage == STAGE_COMPUTE { c" (compute)" } else if stage == STAGE_VERTEX {
                c" (vertex)" } else { c" (fragment)" }, pcx);
        }
    }
    var near = near_to(name);
    for k in first..end {
        near.offer(pcx.entry_sym.get(k), &pcx);
    }
    near.help(&pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
    true
}

// ---- embed.part_use: a part's own `.src` or entry field (0.26.2) ----

// (synth_field) Field `name` of a struct (its node `node`) at node n: when
// the struct is a part's type, embed.part_use, naming the fields of the
// blocks that include it (the first as the fix), and true; else false.
pub fn part_use_error(n: i64, node: i64, name: i64, pcx: inout Ctx<Comp>) -> bool {
    var b = -1;
    for i in 0..pcx.block_struct.count {
        if pcx.block_struct.get(i) == node {
            b = i;
        }
    }
    if !is_part(b, pcx) {
        return false;
    }
    let e = pcx.block_node.get(b);
    var users = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    let named_at = users_of(b, &users, pcx);
    let part = sym_text(pcx.nodes[e].a);
    let saved = pcx.err_kind;
    pcx.err_kind = c"embed.part_use";
    err_begin(pcx.nodes[n].start, &pcx);
    err_fmt(
        format_args("'{part}' is a part (named in 'with' at {}): it has no module of its own, so '{part}.{}' is no value", file_line_text(named_at, &pcx), sym_text(name)), pcx);
    let h = buf_new();
    if users.count == 0 {
        buf_bytes(h, "no block that is no part includes it");
    } else {
        buf_bytes(h, "the modules that include it: ");
        for i in 0..users.count {
            if i > 0 {
                buf_bytes(h, ", ");
            }
            buf_bytes(h, sym_text(pcx.nodes[pcx.blocks.get(users.get(i))].a));
            buf_byte(h, '.');
            buf_bytes(h, sym_text(name));
        }
    }
    buf_byte(h, 0);
    err_help(buf_slice(h).ptr, pcx);
    // the fix: the first user's field, when the part is named by its name
    let base = pcx.nodes[n].a;
    if users.count > 0 && pcx.nodes[base].kind == NodeKind::Ident
        && pcx.nodes[base].a == pcx.nodes[e].a {
        err_fix(pcx.nodes[base].start, pcx.nodes[base].end,
            sym_text(pcx.nodes[pcx.blocks.get(users.get(0))].a), &pcx);
    }
    err_end_soft(&pcx);
    pcx.err_kind = saved;
    true
}
