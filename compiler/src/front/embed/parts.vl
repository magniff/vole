// Shader parts (0.26.2, decision 19): `embed wgsl K with A, b::B { .. }`.
// The names in a `with` list are paths from the block's module (`A`,
// `shaders::A`, `crate::gpu::A`, `super::A`; a `use` does not bring one
// in): blocks, whose text comes before K's own in K's module, and (step 4)
// `const`s and `#[repr(wgsl)]` structs, whose WGSL the compiler writes. A
// block named in any `with` is a part: checked only inside the modules that
// include it, its entry points the fields of each block that includes it,
// its own `.src` and entry fields no values (embed.part_use, wgsl.vl). A
// name that is none of these is embed.with; parts that include themselves,
// embed.cycle.
//
// resolve_parts runs first in expand_embeds, before any block's struct is
// made: BLOCKS lists the program's wgsl blocks, and module_order gives a
// block's module, its parts depth-first, each once, then itself.

use crate::base::{buf_bytes, buf_copy, buf_done, buf_new, buf_ptr, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_file_line, err_begin, err_end_soft, err_fmt, err_help};
use crate::front::ast::{NodeKind, REPR_WGSL, child};
use crate::front::embed::ctx::EmbedCx;
use crate::front::embed::made::{add_made, check_repr_structs, const_ok, is_bad_struct};
use crate::front::modules::{child_module, is_within, module_of};
use crate::front::parser::items::ITEM_PUBLIC;

// The program's blocks into BLOCKS, their `with` lists resolved, the parts
// marked, a cycle broken (embed.cycle).
pub fn resolve_parts(wcx: &mut EmbedCx<Comp>, pcx: &mut Ctx<Comp>) {
    pcx.blocks.clear();
    pcx.with_first.clear();
    pcx.with_count.clear();
    pcx.is_part.clear();
    pcx.with_block.clear();
    wcx.with_item.clear();
    pcx.with_path.clear();
    if wcx.sym_wgsl == 0 {
        wcx.sym_wgsl = intern_c(c"wgsl", pcx);
        wcx.sym_crate = intern_c(c"crate", pcx);
        wcx.sym_super = intern_c(c"super", pcx);
        wcx.sym_self = intern_c(c"self", pcx);
    }
    let mut any_with = false;
    let mut any_repr = false;
    for i in 0..pcx.nodes[pcx.program as usize].count {
        let item = child(pcx.program, i, pcx);
        if pcx.nodes[item as usize].kind == NodeKind::Embed
            && pcx.nodes[item as usize].b == wcx.sym_wgsl {
            pcx.blocks.push(item);
            pcx.is_part.push(0);
            any_with = any_with || pcx.nodes[item as usize].count > 0;
        }
        else if pcx.nodes[item as usize].kind == NodeKind::Struct
            && (pcx.nodes[item as usize].c & REPR_WGSL) != 0 {
            any_repr = true;
        }
    }
    if any_repr {
        check_repr_structs(wcx, pcx);
    }
    if !any_with {
        for b in 0..pcx.blocks.len() as i64 {
            pcx.with_first.push(0);
            pcx.with_count.push(0);
        }
        return;
    }
    for b in 0..pcx.blocks.len() as i64 {
        let e = pcx.blocks[b as usize];
        pcx.with_first.push(pcx.with_block.len() as i64);
        pcx.with_count.push(pcx.nodes[e as usize].count);
        for k in 0..pcx.nodes[e as usize].count {
            let path = child(e, k, pcx);
            let item = resolve_with(e, path, wcx, pcx);
            let named: i64 = if item >= 0
                && pcx.nodes[item as usize].kind == NodeKind::Embed { block_of(item, pcx) }
                else { -1 };
            pcx.with_block.push(named);
            wcx.with_item.push(if named < 0 && item >= 0 { item } else { 0 });
            pcx.with_path.push(path);
            if named >= 0 {
                pcx.is_part[named as usize] = 1;
            }
        }
    }
    // the cycles, each reported once and broken where it closes
    let mut state: Vec<i64, Comp> = Vec::new_in(Comp {});
    for b in 0..pcx.blocks.len() as i64 {
        state.push(0);
    }
    let mut stack: Vec<i64, Comp> = Vec::new_in(Comp {});
    for b in 0..pcx.blocks.len() as i64 {
        if state[b as usize] == 0 {
            find_cycles(b, &mut state, &mut stack, pcx);
        }
    }
}

// The depth-first walk from block b: state 1 while its parts are walked,
// 2 after; a `with` entry that reaches a block in state 1 closes a cycle.
fn find_cycles(b: i64, state: &mut Vec<i64, Comp>, stack: &mut Vec<i64, Comp>, pcx: &mut Ctx<Comp>) {
    state[b as usize] = 1;
    stack.push(b);
    let first = pcx.with_first[b as usize];
    for k in first..first + pcx.with_count[b as usize] {
        let p = pcx.with_block[k as usize];
        if p < 0 {
            continue;
        }
        if state[p as usize] == 1 {
            cycle_error(k, p, &*stack, pcx);
            pcx.with_block[k as usize] = -1;
        } else if state[p as usize] == 0 {
            find_cycles(p, state, stack, pcx);
        }
    }
    stack.pop();
    state[b as usize] = 2;
}

// embed.cycle at `with` entry k, which names block p, a block of the walk
// (stack) that has not come back yet.
fn cycle_error(k: i64, p: i64, stack: &[i64], pcx: &mut Ctx<Comp>) {
    let m = buf_new();
    buf_bytes(m, b"the parts of '");
    buf_bytes(m, sym_text(pcx.nodes[pcx.blocks[p as usize] as usize].a, pcx));
    buf_bytes(m, b"' include it again: ");
    let mut from: i64 = 0;
    for i in 0..stack.len() as i64 {
        if stack[i as usize] == p {
            from = i;
        }
    }
    for i in from..stack.len() as i64 {
        buf_bytes(m, sym_text(pcx.nodes[pcx.blocks[stack[i as usize] as usize] as usize].a, pcx));
        buf_bytes(m, b" with ");
    }
    buf_bytes(m, sym_text(pcx.nodes[pcx.blocks[p as usize] as usize].a, pcx));
    let saved = pcx.err_kind;
    pcx.err_kind = c"embed.cycle";
    err_begin(pcx.nodes[pcx.with_path[k as usize] as usize].start, pcx);
    err_fmt(str::from_utf8(&buf_copy(m)).unwrap(), pcx);
    err_help(c"a module's text is its parts' texts, then its own: a part cannot include the block that includes it; move what both need into a part of its own", pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// The item `path` (a TyName) names from block e's module: an Embed node,
// a Const or a `#[repr(wgsl)]` Struct (made.vl writes their WGSL), or -1
// after embed.with.
fn resolve_with(e: i64, path: i64, wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let from = module_of(e, pcx);
    let m = path_module(from, path, true, wcx, pcx);
    if m < 0 {
        return -1;
    }
    let name = pcx.nodes[path as usize].a;
    let item = item_named(m, name, wcx, pcx);
    if item < 0 {
        with_error(path, pcx.nodes[path as usize].start, format_args("no `embed wgsl` block, const or #[repr(wgsl)] struct '{}' in this module", str::from_utf8(sym_text(name, pcx)).unwrap()), b"`with` names an item by its path from this block's module (`with shaders::COMMON`); a `use` does not bring one in", pcx);
        return -1;
    }
    let k = pcx.nodes[item as usize].kind;
    if k != NodeKind::Embed && k != NodeKind::Const && k != NodeKind::Struct {
        with_error(path, pcx.nodes[path as usize].start,
            format_args("'{}' is {}, not an `embed wgsl` block, a const or a #[repr(wgsl)] struct",
                str::from_utf8(sym_text(name, pcx)).unwrap(),
                str::from_utf8(item_kind_text(k)).unwrap()),
            b"`with` names embedded blocks, whose text comes before this block's own, and the consts and #[repr(wgsl)] structs whose WGSL the compiler writes", pcx);
        return -1;
    }
    if k == NodeKind::Struct && (pcx.nodes[item as usize].c & REPR_WGSL) == 0 {
        with_error(path, pcx.nodes[path as usize].start,
            format_args("the struct '{}' is no #[repr(wgsl)] struct: its layout is not WGSL's",
                str::from_utf8(sym_text(name, pcx)).unwrap()),
            b"put #[repr(wgsl)] on it: its fields are then laid out as WGSL's, and the block gets its WGSL `struct`", pcx);
        return -1;
    }
    if (pcx.nodes[item as usize].p & ITEM_PUBLIC) == 0 && !is_within(from, m, pcx) {
        with_error(path, pcx.nodes[path as usize].start,
            format_args("'{}' is private to its module",
                str::from_utf8(sym_text(name, pcx)).unwrap()),
            b"an item named from another module is `pub`", pcx);
        return -1;
    }
    if k == NodeKind::Struct && !is_within(from, m, pcx) {
        for i in 0..pcx.nodes[item as usize].count {
            let f = child(item, i, pcx);
            if (pcx.nodes[f as usize].p & ITEM_PUBLIC) == 0 {
                with_error(path, pcx.nodes[path as usize].start,
                    format_args("the field '{}.{}' is private to its module",
                        str::from_utf8(sym_text(pcx.nodes[item as usize].a, pcx)).unwrap(),
                        str::from_utf8(sym_text(pcx.nodes[f as usize].a, pcx)).unwrap()),
                    b"the WGSL struct a block is given has every field: a struct named from another module has `pub` fields", pcx);
                return -1;
            }
        }
    }
    if k == NodeKind::Const && !const_ok(item, path, pcx) {
        return -1;
    }
    item
}

// The module `path`'s segments before its name lead to from module
// `from` (`a::b::X`: a::b; `crate::`, `super::`, `self::`), or -1 (after
// embed.with when `report`).
pub fn path_module(from: i64, path: i64, report: bool, wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut m = from;
    for k in 0..pcx.nodes[path as usize].count {
        let seg = child(path, k, pcx);
        let s = pcx.nodes[seg as usize].a;
        if s == wcx.sym_crate {
            m = 0;
        } else if s == wcx.sym_super {
            m = module_parent(m, pcx);
        } else if s != wcx.sym_self {
            m = child_module(m, s, pcx);
        }
        if m < 0 {
            if report {
                with_error(path, pcx.nodes[seg as usize].start, format_args("no module '{}' here", str::from_utf8(sym_text(s, pcx)).unwrap()), b"a `with` path starts at the block's module (`shaders::COMMON`), or at `crate::` or `super::`", pcx);
            }
            return -1;
        }
    }
    m
}

// The item named `name` in module m: the first block, const or struct of
// that name, else the first other item, else -1.
pub fn item_named(m: i64, name: i64, wcx: &EmbedCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let mut other: i64 = -1;
    for i in 0..pcx.nodes[pcx.program as usize].count {
        let item = child(pcx.program, i, pcx);
        if pcx.nodes[item as usize].a != name || !is_named_item(pcx.nodes[item as usize].kind)
            || module_of(item, pcx) != m {
            continue;
        }
        let k = pcx.nodes[item as usize].kind;
        if (k == NodeKind::Embed && pcx.nodes[item as usize].b == wcx.sym_wgsl)
            || k == NodeKind::Const
            || k == NodeKind::Struct {
            return item;
        }
        if other < 0 {
            other = item;
        }
    }
    other
}

// Whether an item of this kind has a name `with` could mean.
fn is_named_item(k: NodeKind) -> bool {
    k == NodeKind::Embed || k == NodeKind::Const || k == NodeKind::Struct || k == NodeKind::Static
        || k == NodeKind::Fn || k == NodeKind::Enum || k == NodeKind::TypeAlias
}

fn item_kind_text(k: NodeKind) -> &'static [u8] {
    if k == NodeKind::Const { b"a const" } else if k == NodeKind::Struct { b"a struct" }
    else if k == NodeKind::Static { b"a static" } else if k == NodeKind::Fn { b"a function" }
    else if k == NodeKind::Enum { b"an enum" } else { b"a type" }
}

// embed.with at pos, of the `with` entry `path`.
fn with_error<T: std::fmt::Display>(path: i64, pos: i64, message: T, help: &[u8],
    pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = c"embed.with";
    err_begin(if pos >= 0 { pos } else { pcx.nodes[path as usize].start }, pcx);
    err_fmt(message, pcx);
    let h = buf_new();
    buf_bytes(h, help);
    crate::base::buf_byte(h, 0);
    err_help(buf_ptr(h), pcx);
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// The parent of module m (-1: the root has none).
fn module_parent(m: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.modules[m as usize].parent
}

// Block b's index in BLOCKS for Embed node e, or -1.
pub fn block_of(e: i64, pcx: &Ctx<Comp>) -> i64 {
    for b in 0..pcx.blocks.len() as i64 {
        if pcx.blocks[b as usize] == e {
            return b;
        }
    }
    -1
}

// Whether block b is a part (named in some `with`).
pub fn is_part(b: i64, pcx: &Ctx<Comp>) -> bool {
    b >= 0 && b < pcx.is_part.len() as i64 && pcx.is_part[b as usize] != 0
}

// Block b's module: its parts depth-first, each once, then b, into out
// (indexes of BLOCKS).
pub fn module_order(b: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    out.clear();
    add_in_order(b, out, pcx);
}

fn add_in_order(b: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) {
    for i in 0..out.len() as i64 {
        if out[i as usize] == b {
            return;
        }
    }
    let first = pcx.with_first[b as usize];
    for k in first..first + pcx.with_count[b as usize] {
        let p = pcx.with_block[k as usize];
        if p >= 0 {
            add_in_order(p, out, pcx);
        }
    }
    out.push(b);
}

// The consts and `#[repr(wgsl)]` structs block b's module names (through
// any of its blocks' `with`), the structs' nested structs first, each
// once, into out; `order` is its module_order. False when one is a
// struct gpu.repr refused (the module is then not checked).
pub fn module_items(order: &[i64], out: &mut Vec<i64, Comp>, wcx: &EmbedCx<Comp>,
    pcx: &mut Ctx<Comp>) -> bool {
    out.clear();
    let mut ok = true;
    for i in 0..order.len() as i64 {
        let b = order[i as usize];
        let first = pcx.with_first[b as usize];
        for k in first..first + pcx.with_count[b as usize] {
            let item = wcx.with_item[k as usize];
            if item > 0 {
                add_made(item, out, wcx, pcx);
            }
        }
    }
    for i in 0..out.len() as i64 {
        if is_bad_struct(out[i as usize], wcx) {
            ok = false;
        }
    }
    ok
}

// (embed.part_use) The blocks that include part b directly or through
// other parts and are no parts themselves, into out; the position of the
// first `with` entry that names b.
pub fn users_of(b: i64, out: &mut Vec<i64, Comp>, pcx: &Ctx<Comp>) -> i64 {
    out.clear();
    let mut at: i64 = -1;
    let mut order: Vec<i64, Comp> = Vec::new_in(Comp {});
    for u in 0..pcx.blocks.len() as i64 {
        let first = pcx.with_first[u as usize];
        for k in first..first + pcx.with_count[u as usize] {
            if pcx.with_block[k as usize] == b && at < 0 {
                at = pcx.nodes[pcx.with_path[k as usize] as usize].start;
            }
        }
        if is_part(u, pcx) || u == b {
            continue;
        }
        module_order(u, &mut order, pcx);
        for i in 0..order.len() as i64 {
            if order[i as usize] == b {
                out.push(u);
            }
        }
    }
    at
}

// `FILE:LINE` of pos, a new buffer's text.
pub fn file_line_text(pos: i64, pcx: &mut Ctx<Comp>) -> &'static [u8] {
    let b = buf_new();
    buf_file_line(b, pos, pcx);
    buf_done(b)
}
