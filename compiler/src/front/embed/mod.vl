// Compile-time embedding (0.25.3; 0.26.0: embedded blocks, `embed wgsl
// K { .. }` and `embed wgsl K from "x.wgsl";`, their file read here too,
// their meaning in wgsl.vl): `include_str("shader.wgsl")` and
// `include_bytes("font.bin")` are a file's contents as a string literal
// (front::parser::exprs::parse_include makes the Str node), read when the
// program is parsed. The path is relative to the directory of the file
// that holds the call. include_str's file must be UTF-8 (embed.utf8) and
// is a literal where a `str` or a `[u8]` goes; include_bytes' is a `[u8]`
// (its node's b is 1). A file that cannot be read is embed.missing.
//
// The files are the program's inputs: EMBEDS lists them, for the tools'
// cache (tools::query::cache: a cached answer holds while each has the
// text it had); the code cache sees their bytes in the IR's strings.

// (0.26.0) `embed wgsl K { .. }`: its struct, static and check
pub mod ctx;
pub mod wgsl;
// (0.26.2) `embed wgsl K with A, B { .. }`: shader parts
pub mod parts;
// (0.26.2) the WGSL of shared consts and `#[repr(wgsl)]` structs
pub mod made;
// (0.26.2) diagnostics 2, 3, 4 and 6 at check time, after the checker
pub mod gpu_lint;

use crate::base::{
    SOURCE_WGSL, add_source, buf_byte, buf_bytes, buf_int, buf_new, buf_ptr, buf_slice,
    buf_truncate, buf_zeros, cstr, fclose, fopen, fread, overlay_of,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_fix, err_fmt, err_help};
use crate::front::check::distinct::utf8_error_at;
use crate::front::contracts::sites::file_of_pos;
use crate::front::cpp::directives::path_dir;
use crate::front::lexer::{add_string, str_at};
use crate::front::modules::module_at;

// The path of `rel`, named in the file holding position `pos`: relative
// to that file's directory (as given, without a leading `./`), or
// absolute: a buffer holding it and a NUL (`.ptr` is a C string; its
// text: buf_path).
pub fn embed_path(pos: i64, rel: &[u8], pcx: &Ctx<Comp>) -> i64 {
    let out = buf_new();
    if rel.len() == 0 || rel[0] != b'/' {
        let dir = plain(cstr(path_dir(file_path(pos, pcx).ptr)));
        if !(dir.len() == 1 && dir[0] == b'.') {
            buf_bytes(out, dir);
            buf_byte(out, b'/');
        }
    }
    buf_bytes(out, rel);
    buf_byte(out, 0);
    out
}

// The path in buffer b (embed_path's), without its NUL.
pub fn buf_path(b: i64) -> &'static [u8] {
    let all = buf_slice(b);
    &all[0..(all.len() as i64 - 1) as usize]
}

// The path of the file holding position `pos`, as it was named (a NUL
// after it).
fn file_path(pos: i64, pcx: &Ctx<Comp>) -> &[u8] {
    cstr(pcx.files[file_of_pos(pos, pcx) as usize].path)
}

// A path without its leading `./`s (a module's file is named so).
fn plain(path: &[u8]) -> &[u8] {
    let mut p = path;
    while p.len() > 2 && p[0] == b'.' && p[1] == b'/' {
        p = &p[2..p.len()];
    }
    p
}

// The bytes of file `path` (followed by a NUL) into buffer `out`; false
// when it cannot be opened.
pub fn read_embedded(path: &[u8], out: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: the file is read through C's stdio (fopen, fread, fclose),
    // into the buffer's own storage.
    // SAFETY: path.ptr is NUL-terminated (embed_path, the tools' cache
    // writes its paths so); each fread writes at most 65536 bytes after
    // the buffer's length, which buf_reserve has made room for, and the
    // file is closed once.
    unsafe {
        let file = fopen(overlay_of(path.ptr, pcx), c"rb");
        if file == 0 as *mut u8 {
            return false;
        }
        loop {
            let at = buf_zeros(out, 65536);
            let got = fread(buf_ptr(out).add(at as usize), 1, 65536, file);
            buf_truncate(out, at + got as i64);
            if got == 0 {
                break;
            }
        }
        fclose(file);
        true
    }
}

// The string id of the file `rel` names for the call SRC[start..end)
// (`include_bytes` when `bytes`, else `include_str`): its contents, or ""
// after an error.
pub fn embed_file(start: i64, end: i64, rel: &[u8], bytes: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let head = buf_new();
    buf_fmt_call(head, if bytes { b"include_bytes" } else { b"include_str" }, rel);
    read_file(start, end, rel, bytes, buf_slice(head), b"the call", pcx)
}

// (0.26.0) The string id of the file of `embed LANG NAME from "rel";`, the
// string at `start` (`head` is the item's text up to it, `embed wgsl K
// from`): the file's text, UTF-8, or "" after an error.
pub fn embed_block_file(start: i64, rel: &[u8], head: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let h = buf_new();
    buf_bytes(h, head);
    buf_bytes(h, b" \"");
    buf_bytes(h, rel);
    buf_bytes(h, b"\"");
    read_file(start, start, rel, false, buf_slice(h), b"the block", pcx)
}

// (0.26.2, expand_embeds) The file of the block `embed LANG K from "rel";`
// whose `from` string is at `at`, appended to SRC as a FILES entry of kind
// SOURCE_WGSL (once per path, after every vole file): its start in SRC, or
// -1 when it could not be read (embed.missing, embed.utf8 said so).
pub fn append_block_file(at: i64, rel: &[u8], pcx: &mut Ctx<Comp>) -> i64 {
    let path_buf = embed_path(at, rel, pcx);
    let path = buf_path(path_buf);
    for f in 0..pcx.files.len() {
        if pcx.files[f].kind == SOURCE_WGSL && cstr(pcx.files[f].path) == path {
            return pcx.files[f].start;
        }
    }
    let mut k = pcx.embeds.len() as i64 - 2;
    while k >= 0 {
        if buf_path(pcx.embeds[k as usize]) == path {
            let id = pcx.embeds[(k + 1) as usize];
            if id < 0 {
                return -1;
            }
            let text = buf_new();
            buf_bytes(text, str_at(id, pcx));
            let start = add_source(buf_slice(path_buf).ptr, text, pcx: pcx, kind: SOURCE_WGSL);
            // (its module: the block's, as module_at gives it for the code
            // at its positions)
            let last = pcx.files.len() as i64 - 1;
            pcx.files[last as usize].module = module_at(at, pcx);
            return start;
        }
        k -= 2;
    }
    -1
}

// The file `rel` names at SRC[start..end), `head` the text that names it
// in messages (`include_str("x")`), `holder` what holds it: its string id.
fn read_file(start: i64, end: i64, rel: &[u8], bytes: bool, head: &[u8], holder: &[u8],
    pcx: &mut Ctx<Comp>) -> i64 {
    let path_buf = embed_path(start, rel, pcx);
    let path = buf_path(path_buf);
    let text = buf_new();
    if !read_embedded(path, text, pcx) {
        note_embed(path_buf, -1, pcx);
        let m = buf_new();
        buf_bytes(m, head);
        buf_bytes(m, b": cannot read ");
        buf_bytes(m, path);
        let h = buf_new();
        buf_bytes(h, b"the path is relative to the directory of ");
        buf_bytes(h, plain(file_path(start, pcx)));
        buf_bytes(h, b", the file that holds ");
        buf_bytes(h, holder);
        embed_error(c"embed.missing", start, buf_slice(m), buf_slice(h), -1, b"", pcx);
        return add_string(b"", pcx);
    }
    let content = buf_slice(text);
    let at: i64 = if bytes { -1 } else { utf8_error_at(content) };
    if at >= 0 {
        note_embed(path_buf, -1, pcx);
        let m = buf_new();
        buf_bytes(m, head);
        buf_bytes(m, b": ");
        buf_bytes(m, path);
        buf_bytes(m, b" is not UTF-8 (at byte ");
        buf_int(m, at);
        buf_bytes(m, b")");
        if end > start {
            // the fix: include_bytes, the same path
            let call = buf_new();
            buf_fmt_call(call, b"include_bytes", rel);
            embed_error(c"embed.utf8", start, buf_slice(m),
                b"include_str's text is a str, UTF-8; include_bytes gives any file's bytes, a [u8]",
                end, buf_slice(call), pcx);
        } else {
            embed_error(c"embed.utf8", start, buf_slice(m),
                b"an embedded block's text is UTF-8: convert the file", -1, b"", pcx);
        }
        return add_string(b"", pcx);
    }
    let id = add_string(content, pcx);
    note_embed(path_buf, id, pcx);
    id
}

// An embedded file: its path (embed_path's buffer) and string id.
fn note_embed(path: i64, id: i64, pcx: &mut Ctx<Comp>) {
    pcx.embeds.push(path);
    pcx.embeds.push(id);
}

// `what("rel")`, into buffer b.
fn buf_fmt_call(b: i64, what: &[u8], rel: &[u8]) {
    buf_bytes(b, what);
    buf_bytes(b, b"(\"");
    buf_bytes(b, rel);
    buf_bytes(b, b"\")");
}

// A coded error of embedding at `pos`, soft (parsing goes on); its fix
// replaces SRC[pos..fix_end) with `fix` when fix_end > pos.
fn embed_error(code: *mut u8, pos: i64, message: &[u8], help: &[u8], fix_end: i64, fix: &[u8],
    pcx: &mut Ctx<Comp>) {
    let saved = pcx.err_kind;
    pcx.err_kind = code;
    err_begin(pos, pcx);
    err_fmt(str::from_utf8(message).unwrap(), pcx);
    let h = buf_new();
    buf_bytes(h, help);
    buf_byte(h, 0);
    err_help(buf_slice(h).ptr, pcx);
    if fix_end > pos {
        err_fix(pos, fix_end, fix, pcx);
    }
    err_end_soft(pcx);
    pcx.err_kind = saved;
}

// The embedded files, for the tools' cache: how many, the path of the
// k-th (NUL-terminated).
pub fn embed_count(pcx: &Ctx<Comp>) -> i64 {
    pcx.embeds.len() as i64 / 2
}

pub fn embed_path_at(k: i64, pcx: &Ctx<Comp>) -> &[u8] {
    buf_path(pcx.embeds[(2 * k) as usize])
}
