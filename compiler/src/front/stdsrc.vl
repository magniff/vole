// Generated by compiler/std/embed.sh from std's files (do not
// edit): the standard library's source, its units' index, its
// files and its line marks.

use crate::base::buf_str;

pub fn std_source(out: i64) {
    buf_str(out, c"// The standard library (0.27; the one std from 0.28.0): Rust's API. In\n// 0.27.0 it was a spec for the rust edition: every item's signature in\n// its final form and its doc, the bodies to come; 0.27.2 wrote them,\n// Rust's, and built this tree into the compiler (compiler/std/embed.sh);\n// 0.27.3's translator rewrote the old edition's programs against it, and\n// 0.28.0 deleted the old std.\n//\n// It is a redesign, not a port of compiler/std (docs/design/rust-surface-plan.md,\n// §2, §3, §6):\n// - `v.get(i)` is `Option<&T>`, iterators yield `&T` and `iter_mut` `&mut T`;\n//   maps have `entry`, and `Option` has `take`, `as_ref` and `as_mut`;\n// - allocation is a capability: there is no default allocator, a\n//   container names its allocator type `A`, every allocation outside a\n//   container's own operations takes an allocator value, last (`_in`), and\n//   `Clone` reuses the stored allocator while `clone_in(a)` moves to another;\n// - every iterator has a named type: std needs no `impl Trait` in return\n//   position;\n// - std's paths are Rust's (std::vec::Vec, std::collections::HashMap,\n//   std::alloc::Arena), and the prelude is Rust's with vole's additions.\n//\n// Each item's line in compiler/std/checklist.tsv (tools/std-checklist.py)\n// says whether it is kept from MVS's std, renamed, changed or new, which\n// MVS items are gone and into what, the features it needs, and the\n// gate-1 test that covers it. Markers in an item's comment feed it:\n// `// later: NAME` (a feature the rust front reports as\n// `syntax.later: NAME (0.27.N)`), `// mvs: PATH` (the MVS item it\n// replaces, when its name or place differs), `// std: renamed` and\n// `// std: changed: WHY`.\n//\n// Two kinds of item are the compiler's, as MVS's are: an item over\n// `[T; N]` for every N, `#[array_builtin(N)]` (until const generics), and\n// a trait's impls for the primitive types, `#[builtin_impls(i8, ...,\n");
    buf_str(out, c"// bool)]` on the trait (each type listed gets `impl Trait for P`; char's\n// come with the char feature). Both wait for 0.27.2 (array_builtin,\n// primitive_builtin), and the checklist gives each trait's builtin impls\n// a line.\n\npub mod prelude;\n\npub mod marker;\npub mod ops;\npub mod cmp;\npub mod clone;\npub mod default;\npub mod convert;\npub mod borrow;\npub mod mem;\npub mod ptr;\npub mod cell;\npub mod panic;\n\npub mod option;\npub mod result;\n\npub mod alloc;\npub mod boxed;\npub mod vec;\npub mod slice;\npub mod array;\npub mod str;\npub mod char;\npub mod num;\nmod intconv;\npub mod string;\npub mod hash;\npub mod collections;\n\npub mod iter;\npub mod fmt;\nmod flt;\nmod fmath;\npub mod unicode;\npub mod io;\npub mod fs;\npub mod path;\npub mod random;\npub mod sys;\npub mod capture;\npub mod env;\npub mod cli;\npub mod process;\npub mod thread;\npub mod time;\npub mod sync;\npub mod gpu;\n// (0.28.0) vole's: the Objective-C runtime (macOS), for std::window and\n// std::gpu's Metal layer\npub mod objc;\n// (0.28.0) vole's: windows and input (macOS: Cocoa), and the scripted\n// event loop for tests without a display\npub mod window;\n// (0.28.0) vole's: properties, fuzz targets, snapshots and the test\n// runtime (`volec test`)\npub mod test;\n\n// (0.27.5) The bodies of std::arch's bits.* intrinsics, which the\n// compiler writes as `{ super::count_ones(x) }` (arch/virtual.vl), as MVS's\n// std has them at its root: u64's methods, as an i64. Not Rust's API.\n#[effects(diverge)]\npub(crate) fn count_ones(x: u64) -> i64 {\n    x.count_ones() as i64\n}\n\n#[effects(diverge)]\npub(crate) fn leading_zeros(x: u64) -> i64 {\n    x.leading_zeros() as i64\n}\n\n#[effects(diverge)]\npub(crate) fn trailing_zeros(x: u64) -> i64 {\n    x.trailing_zeros() as i64\n}\n\n// (0.18's, for the rust edition) A contract or assertion check, which the\n// compiler makes (from a `requires` or `ensures` clause, `assert`,\n");
    buf_str(out, c"// `assert_eq`, ...): both back ends branch to the run-time failure when\n// `ok` is false, whose line the compiler writes from `check`\n// (front/contracts/checks.vl) and `site` (the position it blames); a, b,\n// c: the values of the holes of a format literal message, evaluated only\n// when `ok` is false. Not called by programs.\n// mvs: contract_check\n#[effects(panic)]\npub fn contract_check(ok: bool, site: i64, check: i64, a: i64, b: i64, c: i64) {\n    if !ok {\n        crate::panic::panic(\"contract check failed\");\n    }\n}\n\n// What a `main` returning `Result<(), E>` does with an Err: `Error: {e:?}`\n// on stderr, then exit status 1, as Rust's (the compiler calls it:\n// front/convert/try_main.vl).\n// mvs: main_error\n#[effects(io, static, panic, diverge, E)]\npub fn main_error<E: crate::fmt::Debug>(e: E) -> i32 {\n    crate::fmt::eprintln(\"Error: {e:?}\");\n    1\n}\n\n// ---- Run-time CPU features (0.19; std 0.28.0) ----\n\n// std::arch::detect's word (docs/design/arch.md §2.5): bit b is set when\n// the running CPU has feature b (the compiler's numbering: FT_* in\n// compiler/src/arch/features.vl), bit 63 once the word is filled. A\n// detect the build cannot fold loads it and tests one bit\n// (back/isel/arch.vl; gen0/gen/arch.vl at -O0). Its sources follow, one\n// group per system, at std's root, where the compiler names the target's\n// (arch_init_* and arch_word_*, front/modules/stdsections.vl); each init\n// takes the build's features, which it need not ask the system about.\n//\n// Why there is no data race:\n// - A program with `main` fills the word once, as the first thing main\n//   does, while it is the only thread: every later read, on any thread,\n//   comes after that write, and nothing writes it again.\n// - Code entered from C with no vole `main` (a library) fills it at its\n//   first detect (arch_word_*): two threads may both find 0 and both fill\n//   it. Each computes the same value from what the CPU and the system\n");
    buf_str(out, c"//   report, and stores it with a relaxed atomic store; a reader sees 0,\n//   and fills the word itself, or the whole word.\n// - VOLE_ARCH_DISABLE (comma-separated feature names, or `all`) only\n//   clears bits, so no setting of it makes a missing instruction run: it\n//   makes detect take the fallback paths, for testing them.\nstatic ARCH_FEATURES: crate::sync::atomic::AtomicU64 = crate::sync::atomic::AtomicU64::new(0);\n\nfn arch_bit(b: u64) -> u64 {\n    1u64 << b\n}\n\n// The word from what the system reports: VOLE_ARCH_DISABLE's features\n// cleared (`a64`: unqualified names are AArch64's), then those whose\n// requirements are gone, stored once.\nfn arch_store(found: u64, a64: bool) -> u64 {\n    let w = arch_consistent(found & !arch_disabled(a64)) | 0x8000000000000000;\n    ARCH_FEATURES.store(w, crate::sync::atomic::Ordering::Relaxed);\n    w\n}\n\n// w without the features whose requirements it lacks (sha3 without sha2,\n// avx2 without avx), in the order of the implications, so that code under\n// `detect(\"sha3\")` never runs where the sha2 it may use is missing.\nfn arch_consistent(w: u64) -> u64 {\n    // (feature, what it needs) pairs: neon fp; crc aarch64; aes sha2\n    // dotprod rdm fp16 i8mm bf16 neon; sha3 sha2; sse2 .. sse4.2 the one\n    // before; avx sse4.2; avx2 and fma avx\n    let pairs: [u64; 36] = [\n        0, 1, 2, 15, 3, 0, 4, 0, 6, 0, 7, 0, 9, 0, 10, 0, 11, 0, 5, 4, 17, 16, 18, 17, 19, 18,\n        20, 19, 21, 20, 29, 21, 30, 29, 31, 29,\n    ];\n    let mut out = w;\n    let mut k = 0;\n    while k < 36 {\n        if (out & arch_bit(pairs[k])) != 0 && (out & arch_bit(pairs[k + 1])) == 0 {\n            out &= !arch_bit(pairs[k]);\n        }\n        k += 2;\n    }\n    out\n}\n\nfn arch_same(a: &[u8], b: &[u8]) -> bool {\n    if a.len() != b.len() {\n        return false;\n    }\n    for i in 0..a.len() {\n        if a[i] != b[i] {\n            return false;\n        }\n    }\n    true\n}\n\n");
    buf_str(out, c"// The bits VOLE_ARCH_DISABLE names: features (`aarch64.aes`,\n// `x86_64.aes` qualified), `all` every one.\nfn arch_disabled(a64: bool) -> u64 {\n    // (std::env's var would bring its allocation and text into every\n    // program that asks detect: C's environment, read in place)\n    let name: &[u8] = b\"VOLE_ARCH_DISABLE=\";\n    let mut s: &[u8] = b\"\";\n    let mut found = false;\n    let env = crate::__sys::environ();\n    let mut k: usize = 0;\n    while !found {\n        // UNSAFE: C's environment, an array of C strings, through raw pointers.\n        // SAFETY: environ() is the null-ended array of NUL-ended strings\n        // the C library keeps: k stops at its null entry, and each\n        // string is read up to its NUL; nothing changes the environment\n        // meanwhile (s does not outlive this call).\n        unsafe {\n            let p = *env.add(k);\n            if p.is_null() {\n                break;\n            }\n            let mut n: usize = 0;\n            while *p.add(n) != 0 {\n                n += 1;\n            }\n            let entry = crate::slice::from_raw_parts(p, n);\n            if n >= name.len() && arch_same(&entry[..name.len()], name) {\n                s = &entry[name.len()..];\n                found = true;\n            }\n        }\n        k += 1;\n    }\n    if !found {\n        return 0;\n    }\n    let mut out: u64 = 0;\n    let mut i = 0;\n    while i <= s.len() {\n        let mut j = i;\n        while j < s.len() && s[j] != b',' {\n            j += 1;\n        }\n        out |= arch_named(&s[i..j], a64);\n        i = j + 1;\n    }\n    out\n}\n\nfn arch_named(name: &[u8], a64: bool) -> u64 {\n    if arch_same(name, b\"all\") {\n        return 0x7fffffffffffffff;\n    }\n    let a64_names: [&[u8]; 12] = [b\"neon\", b\"fp\", b\"crc\", b\"aes\", b\"sha2\", b\"sha3\", b\"dotprod\",\n        b\"rdm\", b\"lse\", b\"fp16\", b\"i8mm\", b\"bf16\"];\n");
    buf_str(out, c"    let x86_names: [&[u8]; 16] = [b\"sse\", b\"sse2\", b\"sse3\", b\"ssse3\", b\"sse4.1\", b\"sse4.2\",\n        b\"popcnt\", b\"lzcnt\", b\"bmi1\", b\"bmi2\", b\"pclmulqdq\", b\"aes\", b\"sha\", b\"avx\", b\"avx2\",\n        b\"fma\"];\n    let mut n = name;\n    let mut on_a64 = a64;\n    if n.len() > 8 && arch_same(&n[0..8], b\"aarch64.\") {\n        n = &n[8..];\n        on_a64 = true;\n    } else if n.len() > 7 && arch_same(&n[0..7], b\"x86_64.\") {\n        n = &n[7..];\n        on_a64 = false;\n    }\n    if on_a64 {\n        if arch_same(n, b\"asimd\") {\n            return 1;\n        }\n        for k in 0..12 {\n            if arch_same(n, a64_names[k]) {\n                return arch_bit(k as u64);\n            }\n        }\n    } else {\n        for k in 0..16 {\n            if arch_same(n, x86_names[k]) {\n                return arch_bit(16 + k as u64);\n            }\n        }\n    }\n    0\n}\n\n// AArch64 macOS: sysctl's hw.optional.arm.FEAT_*, only for the features\n// the build does not assume (a default build, apple-m1, asks for two).\n\n// UNSAFE: the system's sysctlbyname, a C function.\n// SAFETY: the prototype is sys/sysctl.h's (size_t as usize).\nextern \"C\" {\n    #[link_name = \"sysctlbyname\"]\n    #[effects(io)]\n    fn arch_sysctlbyname(name: *const u8, old: *mut u8, len: *mut usize, new: *const u8,\n        newlen: usize) -> i32;\n}\n\n// Whether sysctl `name` (an int) is 1.\nfn arch_sysctl(name: *const u8) -> bool {\n    let mut value: [u32; 2] = [0; 2];\n    let mut len: usize = 8;\n    // UNSAFE: sysctlbyname is a C call with raw pointers.\n    // SAFETY: private: name is one of arch_init_macos's NUL-terminated c\"\"\n    // names; value is 8 writable bytes and len says 8, so the kernel\n    // writes at most that; no new value.\n    let r = unsafe {\n        arch_sysctlbyname(name, value.as_mut_ptr() as *mut u8, &mut len as *mut usize,\n            crate::ptr::null(), 0)\n    };\n    r == 0 && value[0] == 1\n}\n\n");
    buf_str(out, c"// Fills the word (`known`: the build's features): before main, or at a\n// library's first detect.\nfn arch_init_macos(known: u64) -> u64 {\n    let mut found: u64 = known | arch_bit(15) | arch_bit(0) | arch_bit(1);\n    // (bit, then the sysctls that must all be 1)\n    let names: [*const u8; 12] = [\n        c\"hw.optional.arm.FEAT_CRC32\", c\"hw.optional.arm.FEAT_AES\", c\"hw.optional.arm.FEAT_PMULL\",\n        c\"hw.optional.arm.FEAT_SHA256\", c\"hw.optional.arm.FEAT_SHA3\",\n        c\"hw.optional.arm.FEAT_SHA512\", c\"hw.optional.arm.FEAT_DotProd\",\n        c\"hw.optional.arm.FEAT_RDM\", c\"hw.optional.arm.FEAT_LSE\", c\"hw.optional.arm.FEAT_FP16\",\n        c\"hw.optional.arm.FEAT_I8MM\", c\"hw.optional.arm.FEAT_BF16\",\n    ];\n    // (feature, its first name, how many)\n    let tests: [usize; 30] = [2, 0, 1, 3, 1, 2, 4, 3, 1, 5, 4, 2, 6, 6, 1, 7, 7, 1, 8, 8, 1, 9,\n        9, 1, 10, 10, 1, 11, 11, 1];\n    let mut k = 0;\n    while k < 30 {\n        if (found & arch_bit(tests[k] as u64)) == 0 {\n            let mut all = true;\n            for j in 0..tests[k + 2] {\n                if !arch_sysctl(names[tests[k + 1] + j]) {\n                    all = false;\n                }\n            }\n            if all {\n                found |= arch_bit(tests[k] as u64);\n            }\n        }\n        k += 3;\n    }\n    arch_store(found, true)\n}\n\n// The word, filled at the first call (a library: no main filled it).\nfn arch_word_macos() -> u64 {\n    let w = ARCH_FEATURES.load(crate::sync::atomic::Ordering::Relaxed);\n    if w != 0 { w } else { arch_init_macos(0) }\n}\n\n// AArch64 Linux: getauxval's AT_HWCAP and AT_HWCAP2.\n\n// UNSAFE: the C library's getauxval.\n// SAFETY: the prototype is sys/auxv.h's (unsigned long as u64).\nextern \"C\" {\n    #[link_name = \"getauxval\"]\n    #[effects(io)]\n    fn arch_getauxval(kind: u64) -> u64;\n}\n\n// Fills the word (`known`: the build's features): before main, or at a\n// library's first detect.\n");
    buf_str(out, c"fn arch_init_linux(known: u64) -> u64 {\n    // UNSAFE: getauxval is a C call.\n    // SAFETY: values only: AT_HWCAP (16) and AT_HWCAP2 (26); an unknown\n    // kind returns 0.\n    let cap = unsafe { arch_getauxval(16) };\n    // UNSAFE: as cap's.\n    // SAFETY: as cap's.\n    let cap2 = unsafe { arch_getauxval(26) };\n    // (HWCAP bits, all needed, then the feature: fp, asimd, crc32, aes and\n    // pmull, sha1 and sha2, sha3 and sha512, asimddp, asimdrdm, atomics,\n    // fphp and asimdhp)\n    let tests: [u64; 20] = [0x1, 1, 0x2, 0, 0x80, 2, 0x18, 3, 0x60, 4, 0x220000, 5, 0x100000, 6,\n        0x1000, 7, 0x100, 8, 0x600, 9];\n    let mut found: u64 = known | arch_bit(15);\n    let mut k = 0;\n    while k < 20 {\n        if (cap & tests[k]) == tests[k] {\n            found |= arch_bit(tests[k + 1]);\n        }\n        k += 2;\n    }\n    // (HWCAP2: i8mm, bf16)\n    if (cap2 & 0x2000) != 0 {\n        found |= arch_bit(10);\n    }\n    if (cap2 & 0x4000) != 0 {\n        found |= arch_bit(11);\n    }\n    arch_store(found, true)\n}\n\n// The word, filled at the first call (a library: no main filled it).\nfn arch_word_linux() -> u64 {\n    let w = ARCH_FEATURES.load(crate::sync::atomic::Ordering::Relaxed);\n    if w != 0 { w } else { arch_init_linux(0) }\n}\n\n// x86-64, either system: cpuid, and xgetbv for whether the system saves\n// the ymm registers (else no avx family: its state would be lost).\n\n// UNSAFE: the compiler's run-time helpers around the cpuid and xgetbv\n// instructions.\n// SAFETY: back/isel/arch.vl's emit_arch_runtime defines them with these C\n// signatures.\nextern \"C\" {\n    #[link_name = \"vole_arch_cpuid\"]\n    fn arch_cpuid(leaf: u32, sub: u32, out: *mut u32);\n    #[link_name = \"vole_arch_xgetbv\"]\n    fn arch_xgetbv(index: u32) -> u64;\n}\n\n// Fills the word (`known`: the build's features): before main, or at a\n// library's first detect.\nfn arch_init_x86(known: u64) -> u64 {\n    let mut r: [u32; 4] = [0; 4];\n");
    buf_str(out, c"    // UNSAFE: the cpuid helper writes through a raw pointer.\n    // SAFETY: r is four u32s, where it writes eax, ebx, ecx, edx; leaf 0\n    // always exists.\n    unsafe { arch_cpuid(0, 0, r.as_mut_ptr()); }\n    let max = r[0];\n    // UNSAFE: as above.\n    // SAFETY: r is four u32s; leaf 1 exists on every x86-64.\n    unsafe { arch_cpuid(1, 0, r.as_mut_ptr()); }\n    let c1 = r[2];\n    let d1 = r[3];\n    let mut w: u64 = known | arch_bit(32);\n    // (register: 2 ecx, 3 edx; its bit; the feature: sse, sse2, sse3,\n    // ssse3, sse4.1, sse4.2, popcnt, pclmulqdq, aes)\n    let tests: [u32; 27] = [3, 25, 16, 3, 26, 17, 2, 0, 18, 2, 9, 19, 2, 19, 20, 2, 20, 21, 2,\n        23, 22, 2, 1, 26, 2, 25, 27];\n    let mut k = 0;\n    while k < 27 {\n        let reg = if tests[k] == 2 { c1 } else { d1 };\n        if (reg & (1u32 << tests[k + 1])) != 0 {\n            w |= arch_bit(tests[k + 2] as u64);\n        }\n        k += 3;\n    }\n    // osxsave, then XCR0: the system saves xmm and ymm\n    // UNSAFE: the xgetbv helper, a C call.\n    // SAFETY: called only when OSXSAVE (ecx bit 27) is set (&& short-\n    // circuits), so xgetbv is enabled and XCR0 (index 0) readable.\n    let ymm = (c1 & 0x8000000) != 0 && (unsafe { arch_xgetbv(0) } & 6) == 6;\n    if ymm && (c1 & 0x10000000) != 0 {\n        w |= arch_bit(29);\n        if (c1 & 0x1000) != 0 {\n            w |= arch_bit(31);\n        }\n    }\n    if max >= 7 {\n        // UNSAFE: the cpuid helper writes through a raw pointer.\n        // SAFETY: r is four u32s; leaf 7 is at most max (checked).\n        unsafe { arch_cpuid(7, 0, r.as_mut_ptr()); }\n        let b7 = r[1];\n        if (b7 & 0x8) != 0 {\n            w |= arch_bit(24);\n        }\n        if (b7 & 0x100) != 0 {\n            w |= arch_bit(25);\n        }\n        if (b7 & 0x20000000) != 0 {\n            w |= arch_bit(28);\n        }\n        if ymm && (b7 & 0x20) != 0 {\n            w |= arch_bit(30);\n        }\n    }\n");
    buf_str(out, c"    // UNSAFE: the cpuid helper writes through a raw pointer.\n    // SAFETY: r is four u32s; leaf 0x80000000 always answers with the\n    // largest extended leaf.\n    unsafe { arch_cpuid(0x80000000, 0, r.as_mut_ptr()); }\n    if r[0] >= 0x80000001 {\n        // UNSAFE: as above.\n        // SAFETY: r is four u32s; the leaf is at most the largest (checked).\n        unsafe { arch_cpuid(0x80000001, 0, r.as_mut_ptr()); }\n        if (r[2] & 0x20) != 0 {\n            w |= arch_bit(23);\n        }\n    }\n    arch_store(w, false)\n}\n\n// The word, filled at the first call (a library: no main filled it).\nfn arch_word_x86() -> u64 {\n    let w = ARCH_FEATURES.load(crate::sync::atomic::Ordering::Relaxed);\n    if w != 0 { w } else { arch_init_x86(0) }\n}\n\n// (0.28.0) --coverage's counters: the compiler (middle/coverage.vl) makes\n// each block of the program count in COVERAGE_MAP[k % 65536] as it runs\n// (std::test::coverage reads them). Not for programs to name.\npub static mut COVERAGE_MAP: [u8; 65536] = [0; 65536];\n// ---- mod std::prelude ----\npub mod prelude {\n// The prelude: what every rust-edition module sees without a `use`.\n// Rust's own list (std::prelude::rust_2024), less what vole has not got\n// (`ToString`, `FromIterator` and `ToOwned` become their `_In` forms,\n// there are no macros) and with vole's: `Gpa`, `FixedState` (0.29.0: a\n// map's hasher is written in its type, as its allocator), `DefaultIn`,\n// and the format functions, which are functions whose format literal the\n// compiler checks (`println(\"{x}\")`; plan §3). `Send`, `Sync`, `Sized`,\n// `AllocFree` and the `Fn` traits are the compiler's and need no `use`.\n// `HashMap` is not in it, as in Rust: `use std::collections::HashMap;`.\n\npub use crate::alloc::Gpa;\npub use crate::borrow::ToOwnedIn;\npub use crate::boxed::Box;\npub use crate::clone::Clone;\npub use crate::cmp::{Eq, Ord, PartialEq, PartialOrd};\npub use crate::convert::{AsMut, AsRef, From, Into, TryFrom, TryInto};\n");
    buf_str(out, c"pub use crate::default::{Default, DefaultIn};\npub use crate::fmt::{eprint, eprintln, format_args, format_in, print, println, write, writeln};\npub use crate::hash::FixedState;\npub use crate::iter::{\n    DoubleEndedIterator, ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator,\n};\npub use crate::marker::Copy;\npub use crate::mem::drop;\npub use crate::ops::Drop;\npub use crate::option::Option;\npub use crate::option::Option::{None, Some};\npub use crate::panic::{\n    assert, assert_eq, assert_ne, debug_assert, panic, todo, unimplemented, unreachable,\n};\npub use crate::result::Result;\npub use crate::result::Result::{Err, Ok};\npub use crate::string::{String, ToStringIn};\npub use crate::vec::Vec;\n// ---- end mod std::prelude ----\n}\n// ---- mod std::marker ----\npub mod marker {\n// std::marker: Copy and PhantomData. Send, Sync, Sized, Freeze and\n// AllocFree (\"holds no allocator\", plan §2.0 rule 1: what a static's type\n// must be) are the compiler's structural markers: they are not declared\n// here, they need no `use`, and as bounds (`T: Send`) they wait for\n// `syntax.later: auto_trait`. MVS's `Freeze` and `AllocFree`, traits\n// with a sealed method, are gone into them (gone.tsv).\n\nuse crate::clone::Clone;\n\n// A type whose values are copied by a move: its bits are the value, and\n// the source stays usable. Every part must be Copy, and Clone must agree\n// (`#[derive(Clone, Copy)]`). Integers, floats, bool, char, `&T`, raw\n// pointers and Gpa are Copy; `&mut T` and anything with a Drop are not.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Copy: Clone {}\n\n// std: new\nimpl Copy for () {}\n\n// std: new\nimpl Copy for char {}\n\n// A zero-sized field that makes a type act as if it held a T: for a\n// type's variance and drop check (`PhantomData<&'a T>` ties a raw\n// pointer's struct to 'a; plan §4). Built in: it has no field, and\n// `PhantomData` is its one value.\n");
    buf_str(out, c"pub struct PhantomData<T: ?Sized>;\n\n// std: new\n// (a marker has no bits: it is copied whatever T is, as Rust's; a struct\n// that holds one and derives Copy is Copy)\nimpl<T: ?Sized> Clone for PhantomData<T> {\n    #[inline]\n    fn clone(&self) -> PhantomData<T> { PhantomData }\n}\n\n// std: new\nimpl<T: ?Sized> Copy for PhantomData<T> {}\n// ---- end mod std::marker ----\n}\n// ---- mod std::ops ----\npub mod ops {\n// std::ops: the operator traits, Deref and DerefMut, Index and IndexMut,\n// Drop, and the ranges (`a..b` and the rest; MVS had Range and\n// RangeInclusive in std::iter). Fn, FnMut and FnOnce are the compiler's.\n// The arithmetic on numbers is built in; the traits are for other types\n// (a vector, a matrix, a String's `+`).\n\nuse crate::cmp::PartialOrd;\nuse crate::fmt::{Debug, Formatter};\n\n// `*x`, and method calls through it: `v.len()` on a Box<Vec<T, A>, A>\n// finds Vec's method, `s.trim()` on a String finds str's (autoderef).\npub trait Deref {\n    type Target: ?Sized;\n\n    fn deref(&self) -> &Self::Target;\n}\n\n// `*x = v` and `&mut *x`, and `&mut self` methods through autoderef.\npub trait DerefMut: Deref {\n    fn deref_mut(&mut self) -> &mut Self::Target;\n}\n\n// `c[i]` as a place that is read: `*c.index(i)`. Vec, slices and arrays\n// are indexed by the compiler (by usize and by ranges); a user type\n// implements Index. Out of bounds panics, as `c.index` says.\npub trait Index<Idx: ?Sized> {\n    type Output: ?Sized;\n\n    fn index(&self, index: Idx) -> &Self::Output;\n}\n\n// `c[i] = v` and `&mut c[i]`.\npub trait IndexMut<Idx: ?Sized>: Index<Idx> {\n    fn index_mut(&mut self, index: Idx) -> &mut Self::Output;\n}\n\n// What runs when a value goes out of scope (not on a panic: decision 18).\n// `drop` cannot be called by hand: `std::mem::drop(x)` ends x early.\npub trait Drop {\n    fn drop(&mut self);\n}\n\n// `a + b`. MVS's Add (`fn add(self, other: Self) -> Self`) becomes\n");
    buf_str(out, c"// Rust's, with a right-hand type and an Output (so `String + &str`).\n// std: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Add<Rhs = Self> {\n    type Output;\n\n    fn add(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a - b`.\n// std: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Sub<Rhs = Self> {\n    type Output;\n\n    fn sub(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a * b`.\n// std: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Mul<Rhs = Self> {\n    type Output;\n\n    fn mul(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a / b`.\n// std: changed: Rust's shape, Rhs and Output\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Div<Rhs = Self> {\n    type Output;\n\n    fn div(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a % b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Rem<Rhs = Self> {\n    type Output;\n\n    fn rem(self, rhs: Rhs) -> Self::Output;\n}\n\n// `-a`.\n// std: changed: Rust's shape, an Output\n#[builtin_impls(i8, i16, i32, i64, isize, f32, f64)]\npub trait Neg {\n    type Output;\n\n    fn neg(self) -> Self::Output;\n}\n\n// `!a`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Not {\n    type Output;\n\n    fn not(self) -> Self::Output;\n}\n\n// `a & b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitAnd<Rhs = Self> {\n    type Output;\n\n    fn bitand(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a | b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitOr<Rhs = Self> {\n    type Output;\n\n    fn bitor(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a ^ b`.\n");
    buf_str(out, c"#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitXor<Rhs = Self> {\n    type Output;\n\n    fn bitxor(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a << b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Shl<Rhs = Self> {\n    type Output;\n\n    fn shl(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a >> b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Shr<Rhs = Self> {\n    type Output;\n\n    fn shr(self, rhs: Rhs) -> Self::Output;\n}\n\n// `a += b` (String's `s += \"x\"` grows s from its own allocator).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait AddAssign<Rhs = Self> {\n    fn add_assign(&mut self, rhs: Rhs);\n}\n\n// `a -= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait SubAssign<Rhs = Self> {\n    fn sub_assign(&mut self, rhs: Rhs);\n}\n\n// `a *= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait MulAssign<Rhs = Self> {\n    fn mul_assign(&mut self, rhs: Rhs);\n}\n\n// `a /= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait DivAssign<Rhs = Self> {\n    fn div_assign(&mut self, rhs: Rhs);\n}\n\n// `a %= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait RemAssign<Rhs = Self> {\n    fn rem_assign(&mut self, rhs: Rhs);\n}\n\n// `a &= b`, `a |= b`, `a ^= b`, `a <<= b`, `a >>= b`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitAndAssign<Rhs = Self> {\n    fn bitand_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitOrAssign<Rhs = Self> {\n    fn bitor_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait BitXorAssign<Rhs = Self> {\n");
    buf_str(out, c"    fn bitxor_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait ShlAssign<Rhs = Self> {\n    fn shl_assign(&mut self, rhs: Rhs);\n}\n\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait ShrAssign<Rhs = Self> {\n    fn shr_assign(&mut self, rhs: Rhs);\n}\n\n// ---- Ranges ----\n\n// `start..end`: start included, end not. An iterator over integers and\n// chars (std::iter's Step); a slice index (`&v[1..3]`).\n#[derive(Clone, PartialEq, Eq, Hash)]\npub struct Range<Idx> {\n    pub start: Idx,\n    pub end: Idx,\n}\n\nimpl<Idx: PartialOrd<Idx>> Range<Idx> {\n    // Whether start <= item < end.\n    #[effects()]\n    pub fn contains<U>(&self, item: &U) -> bool\n        where\n            Idx: PartialOrd<U>,\n            U: ?Sized + PartialOrd<Idx>,\n    {\n        *item >= self.start && *item < self.end\n    }\n\n    // Whether it holds nothing: !(start < end).\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        !(self.start < self.end)\n    }\n}\n\n// `start..=end`: both ends included. Its fields are private, as Rust's: it\n// remembers whether it is exhausted, so that `0..=u8::MAX` ends.\n#[derive(Clone, PartialEq, Eq, Hash)]\npub struct RangeInclusive<Idx> {\n    start: Idx,\n    end: Idx,\n    exhausted: bool,\n}\n\nimpl<Idx> RangeInclusive<Idx> {\n    // `start..=end`.\n    #[effects()]\n    pub fn new(start: Idx, end: Idx) -> RangeInclusive<Idx> {\n        RangeInclusive { start: start, end: end, exhausted: false }\n    }\n\n    #[effects()]\n    pub fn start(&self) -> &Idx {\n        &self.start\n    }\n\n    #[effects()]\n    pub fn end(&self) -> &Idx {\n        &self.end\n    }\n\n    // (start, end).\n    #[effects()]\n    pub fn into_inner(self) -> (Idx, Idx) {\n        (self.start, self.end)\n    }\n}\n\nimpl<Idx: PartialOrd<Idx>> RangeInclusive<Idx> {\n    // Whether start <= item <= end.\n    #[effects()]\n");
    buf_str(out, c"    pub fn contains<U>(&self, item: &U) -> bool\n        where\n            Idx: PartialOrd<U>,\n            U: ?Sized + PartialOrd<Idx>,\n    {\n        *item >= self.start && *item <= self.end\n    }\n\n    // Whether it holds nothing: exhausted, or end < start.\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.exhausted || !(self.start <= self.end)\n    }\n}\n\n// `start..`: from start on (a slice's tail, `&s[3..]`).\n#[derive(Clone, PartialEq, Eq, Hash)]\npub struct RangeFrom<Idx> {\n    pub start: Idx,\n}\n\n// `..end`: up to end, not included.\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct RangeTo<Idx> {\n    pub end: Idx,\n}\n\n// `..=end`: up to end, included.\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct RangeToInclusive<Idx> {\n    pub end: Idx,\n}\n\n// `..`: everything (`&v[..]`).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct RangeFull;\n\n// One end of a range, as RangeBounds gives it.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum Bound<T> {\n    Included(T),\n    Excluded(T),\n    Unbounded,\n}\n\n// Any range, for what takes one (`v.drain(1..)`, `s.replace_range(..3, \"x\")`).\npub trait RangeBounds<T: ?Sized> {\n    fn start_bound(&self) -> Bound<&T>;\n    fn end_bound(&self) -> Bound<&T>;\n\n    // Whether item is in the range.\n    fn contains<U>(&self, item: &U) -> bool\n        where\n            T: PartialOrd<U>,\n            U: ?Sized + PartialOrd<T>,\n    {\n        (match self.start_bound() {\n            Bound::Included(s) => *s <= *item,\n            Bound::Excluded(s) => *s < *item,\n            Bound::Unbounded => true,\n        }) && (match self.end_bound() {\n            Bound::Included(e) => *item <= *e,\n            Bound::Excluded(e) => *item < *e,\n            Bound::Unbounded => true,\n        })\n    }\n}\n\nimpl<T> RangeBounds<T> for Range<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.start)\n    }\n\n");
    buf_str(out, c"    fn end_bound(&self) -> Bound<&T> {\n        Bound::Excluded(&self.end)\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeInclusive<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.start)\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        if self.exhausted { Bound::Excluded(&self.end) } else { Bound::Included(&self.end) }\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeFrom<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.start)\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeTo<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Excluded(&self.end)\n    }\n}\n\nimpl<T> RangeBounds<T> for RangeToInclusive<T> {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Included(&self.end)\n    }\n}\n\nimpl<T: ?Sized> RangeBounds<T> for RangeFull {\n    fn start_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n\n    fn end_bound(&self) -> Bound<&T> {\n        Bound::Unbounded\n    }\n}\n\n// The ranges show as Rust's do: `1..4`, `1..=4`, `1..`, `..4`, `..=4`,\n// `..` (an exhausted RangeInclusive adds ` (exhausted)`).\nimpl<Idx: Debug> Debug for Range<Idx> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Debug::fmt(&self.start, f)?;\n        f.write_str(\"..\")?;\n        crate::fmt::Debug::fmt(&self.end, f)\n    }\n}\n\nimpl<Idx: Debug> Debug for RangeInclusive<Idx> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Debug::fmt(&self.start, f)?;\n        f.write_str(\"..=\")?;\n        crate::fmt::Debug::fmt(&self.end, f)?;\n        if self.exhausted {\n            f.write_str(\" (exhausted)\")?;\n        }\n        crate::result::Result::Ok(())\n    }\n}\n\n");
    buf_str(out, c"impl<Idx: Debug> Debug for RangeFrom<Idx> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Debug::fmt(&self.start, f)?;\n        f.write_str(\"..\")\n    }\n}\n\nimpl<Idx: Debug> Debug for RangeTo<Idx> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"..\")?;\n        crate::fmt::Debug::fmt(&self.end, f)\n    }\n}\n\nimpl<Idx: Debug> Debug for RangeToInclusive<Idx> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"..=\")?;\n        crate::fmt::Debug::fmt(&self.end, f)\n    }\n}\n\nimpl Debug for RangeFull {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"..\")\n    }\n}\n// ---- end mod std::ops ----\n}\n// ---- mod std::cmp ----\npub mod cmp {\n// std::cmp: PartialEq, Eq, PartialOrd, Ord and Ordering, Rust's shape.\n// MVS's Eq (`eq(self, other: Self)`) and Ord (`cmp` returning an i64: <0,\n// 0, >0) are gone into them: `==` is PartialEq::eq on two references, `<`\n// is PartialOrd's, and floats are PartialOrd but not Ord (NaN). The\n// numbers', bool's, char's and pointers' impls are built in; derive makes\n// the others (`#[derive(PartialEq, Eq, PartialOrd, Ord)]`, field by field).\n\nuse crate::option::Option;\n\n// `==` and `!=`. Not necessarily an equivalence (f64's NaN != NaN).\n// mvs: Eq\n// std: changed: Rust's PartialEq, over references, with a right-hand type\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait PartialEq<Rhs: ?Sized = Self> {\n    // mvs: Eq::eq\n    // std: changed: takes &self and &Rhs\n    // (0.28.0: #[pure], as MVS's Eq::eq: an impl is checked against it)\n    #[pure]\n    fn eq(&self, other: &Rhs) -> bool;\n\n    fn ne(&self, other: &Rhs) -> bool {\n        !self.eq(other)\n    }\n}\n\n// PartialEq that is an equivalence: every value equals itself. HashMap's\n// keys need it.\n");
    buf_str(out, c"// std: changed: a marker over PartialEq (MVS's Eq had the method)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Eq: PartialEq<Self> {}\n\n// The result of a comparison.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]\npub enum Ordering {\n    Less,\n    Equal,\n    Greater,\n}\n\nimpl Ordering {\n    #[effects()]\n    pub fn is_eq(self) -> bool {\n        match self {\n            Ordering::Equal => true,\n            _ => false,\n        }\n    }\n\n    #[effects()]\n    pub fn is_ne(self) -> bool {\n        !self.is_eq()\n    }\n\n    #[effects()]\n    pub fn is_lt(self) -> bool {\n        match self {\n            Ordering::Less => true,\n            _ => false,\n        }\n    }\n\n    #[effects()]\n    pub fn is_gt(self) -> bool {\n        match self {\n            Ordering::Greater => true,\n            _ => false,\n        }\n    }\n\n    #[effects()]\n    pub fn is_le(self) -> bool {\n        !self.is_gt()\n    }\n\n    #[effects()]\n    pub fn is_ge(self) -> bool {\n        !self.is_lt()\n    }\n\n    // Less for Greater and the other way round (`b.cmp(a)` from `a.cmp(b)`).\n    #[effects()]\n    pub fn reverse(self) -> Ordering {\n        match self {\n            Ordering::Less => Ordering::Greater,\n            Ordering::Equal => Ordering::Equal,\n            Ordering::Greater => Ordering::Less,\n        }\n    }\n\n    // self, or other when self is Equal: comparing by several keys,\n    // `a.x.cmp(&b.x).then(a.y.cmp(&b.y))`.\n    #[effects()]\n    pub fn then(self, other: Ordering) -> Ordering {\n        match self {\n            Ordering::Equal => other,\n            _ => self,\n        }\n    }\n\n    // `then`, with the second comparison made only when needed.\n    #[effects(F)]\n    pub fn then_with<F: FnOnce() -> Ordering>(self, f: F) -> Ordering {\n        match self {\n            Ordering::Equal => f(),\n            _ => self,\n        }\n    }\n}\n\n");
    buf_str(out, c"// `<`, `<=`, `>` and `>=`; None when the two are not comparable (NaN).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait PartialOrd<Rhs: ?Sized = Self>: PartialEq<Rhs> {\n    fn partial_cmp(&self, other: &Rhs) -> Option<Ordering>;\n\n    fn lt(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) => true,\n            _ => false,\n        }\n    }\n\n    fn le(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    fn gt(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) => true,\n            _ => false,\n        }\n    }\n\n    fn ge(&self, other: &Rhs) -> bool {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n}\n\n// A total order: what sorting, BinaryHeap and BTreeMap need.\n// std: changed: Rust's Ord, cmp returns an Ordering (MVS: an i64)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Ord: Eq + PartialOrd<Self> {\n    // std: changed: takes &self and &Self, returns an Ordering\n    // (0.28.0: #[pure], as MVS's Ord::cmp)\n    #[pure]\n    fn cmp(&self, other: &Self) -> Ordering;\n\n    fn max(self, other: Self) -> Self\n        where\n            Self: Sized,\n    {\n        if other.cmp(&self).is_lt() { self } else { other }\n    }\n\n    fn min(self, other: Self) -> Self\n        where\n            Self: Sized,\n    {\n        if other.cmp(&self).is_lt() { other } else { self }\n    }\n\n    // self within [min, max]; panics when min > max.\n    // mvs: clamp\n    // std: changed: a method of Ord (MVS: the free function std::clamp)\n    fn clamp(self, min: Self, max: Self) -> Self\n");
    buf_str(out, c"        where\n            Self: Sized,\n    {\n        if min.cmp(&max).is_gt() {\n            crate::panic::panic(\"clamp: min > max\");\n        }\n        if self.cmp(&min).is_lt() {\n            min\n        } else if self.cmp(&max).is_gt() {\n            max\n        } else {\n            self\n        }\n    }\n}\n\n// The smaller of two; a when they are equal.\n#[effects(T)]\npub fn min<T: Ord>(a: T, b: T) -> T {\n    a.min(b)\n}\n\n// The larger of two; b when they are equal.\n#[effects(panic, T)]\npub fn max<T: Ord>(a: T, b: T) -> T {\n    a.max(b)\n}\n\n// The smaller by a key (`min_by_key(a, b, |p| p.len())`).\n#[effects(T, K, F)]\npub fn min_by_key<T, K: Ord, F: FnMut(&T) -> K>(a: T, b: T, f: F) -> T {\n    let mut f = f;\n    if f(&b).cmp(&f(&a)).is_lt() { b } else { a }\n}\n\n// The larger by a key.\n#[effects(T, K, F)]\npub fn max_by_key<T, K: Ord, F: FnMut(&T) -> K>(a: T, b: T, f: F) -> T {\n    let mut f = f;\n    if f(&b).cmp(&f(&a)).is_lt() { a } else { b }\n}\n\n// T's order turned round: `v.sort_by_key(|x| Reverse(x.score))`.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug, Default)]\npub struct Reverse<T>(pub T);\n\nimpl<T: PartialOrd> PartialOrd for Reverse<T> {\n    fn partial_cmp(&self, other: &Reverse<T>) -> Option<Ordering> {\n        other.0.partial_cmp(&self.0)\n    }\n}\n\nimpl<T: Ord> Ord for Reverse<T> {\n    fn cmp(&self, other: &Reverse<T>) -> Ordering {\n        other.0.cmp(&self.0)\n    }\n}\n\n// Tuples compare as Rust's do, field by field, left to right: equal\n// when every field is, ordered by the first field that differs.\n// The unit: one value, equal to itself.\nimpl PartialEq for () {\n    fn eq(&self, other: &()) -> bool {\n        true\n    }\n}\n\nimpl Eq for () {}\n\nimpl PartialOrd for () {\n    fn partial_cmp(&self, other: &()) -> Option<Ordering> {\n        Option::Some(Ordering::Equal)\n    }\n}\n\nimpl Ord for () {\n    fn cmp(&self, other: &()) -> Ordering {\n        Ordering::Equal\n    }\n}\n\n");
    buf_str(out, c"impl<A: PartialEq> PartialEq for (A,) {\n    fn eq(&self, other: &(A,)) -> bool {\n        self.0 == other.0\n    }\n}\n\nimpl<A: Eq> Eq for (A,) {}\n\nimpl<A: PartialOrd> PartialOrd for (A,) {\n    fn partial_cmp(&self, other: &(A,)) -> Option<Ordering> {\n        self.0.partial_cmp(&other.0)\n    }\n}\n\nimpl<A: Ord> Ord for (A,) {\n    fn cmp(&self, other: &(A,)) -> Ordering {\n        self.0.cmp(&other.0)\n    }\n}\n\nimpl<A: PartialEq, B: PartialEq> PartialEq for (A, B) {\n    fn eq(&self, other: &(A, B)) -> bool {\n        self.0 == other.0 && self.1 == other.1\n    }\n}\n\nimpl<A: Eq, B: Eq> Eq for (A, B) {}\n\nimpl<A: PartialOrd, B: PartialOrd> PartialOrd for (A, B) {\n    fn partial_cmp(&self, other: &(A, B)) -> Option<Ordering> {\n        match self.0.partial_cmp(&other.0) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        self.1.partial_cmp(&other.1)\n    }\n}\n\nimpl<A: Ord, B: Ord> Ord for (A, B) {\n    fn cmp(&self, other: &(A, B)) -> Ordering {\n        match self.0.cmp(&other.0) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        self.1.cmp(&other.1)\n    }\n}\n\nimpl<A: PartialEq, B: PartialEq, C: PartialEq> PartialEq for (A, B, C) {\n    fn eq(&self, other: &(A, B, C)) -> bool {\n        self.0 == other.0 && self.1 == other.1 && self.2 == other.2\n    }\n}\n\nimpl<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {}\n\nimpl<A: PartialOrd, B: PartialOrd, C: PartialOrd> PartialOrd for (A, B, C) {\n    fn partial_cmp(&self, other: &(A, B, C)) -> Option<Ordering> {\n        match self.0.partial_cmp(&other.0) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.1.partial_cmp(&other.1) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        self.2.partial_cmp(&other.2)\n    }\n}\n\nimpl<A: Ord, B: Ord, C: Ord> Ord for (A, B, C) {\n    fn cmp(&self, other: &(A, B, C)) -> Ordering {\n");
    buf_str(out, c"        match self.0.cmp(&other.0) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.1.cmp(&other.1) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        self.2.cmp(&other.2)\n    }\n}\n\nimpl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq> PartialEq for (A, B, C, D) {\n    fn eq(&self, other: &(A, B, C, D)) -> bool {\n        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3\n    }\n}\n\nimpl<A: Eq, B: Eq, C: Eq, D: Eq> Eq for (A, B, C, D) {}\n\nimpl<A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd> PartialOrd for (A, B, C, D) {\n    fn partial_cmp(&self, other: &(A, B, C, D)) -> Option<Ordering> {\n        match self.0.partial_cmp(&other.0) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.1.partial_cmp(&other.1) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.2.partial_cmp(&other.2) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        self.3.partial_cmp(&other.3)\n    }\n}\n\nimpl<A: Ord, B: Ord, C: Ord, D: Ord> Ord for (A, B, C, D) {\n    fn cmp(&self, other: &(A, B, C, D)) -> Ordering {\n        match self.0.cmp(&other.0) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.1.cmp(&other.1) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.2.cmp(&other.2) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        self.3.cmp(&other.3)\n    }\n}\n\nimpl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq, E: PartialEq> PartialEq for (A, B, C,\n    D, E) {\n    fn eq(&self, other: &(A, B, C, D, E)) -> bool {\n        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3\n            && self.4 == other.4\n    }\n}\n\n");
    buf_str(out, c"impl<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq> Eq for (A, B, C, D, E) {}\n\nimpl<A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd, E: PartialOrd> PartialOrd for (A,\n    B, C, D, E) {\n    fn partial_cmp(&self, other: &(A, B, C, D, E)) -> Option<Ordering> {\n        match self.0.partial_cmp(&other.0) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.1.partial_cmp(&other.1) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.2.partial_cmp(&other.2) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.3.partial_cmp(&other.3) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        self.4.partial_cmp(&other.4)\n    }\n}\n\nimpl<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord> Ord for (A, B, C, D, E) {\n    fn cmp(&self, other: &(A, B, C, D, E)) -> Ordering {\n        match self.0.cmp(&other.0) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.1.cmp(&other.1) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.2.cmp(&other.2) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.3.cmp(&other.3) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        self.4.cmp(&other.4)\n    }\n}\n\nimpl<A: PartialEq, B: PartialEq, C: PartialEq, D: PartialEq, E: PartialEq,\n    F: PartialEq> PartialEq for (A, B, C, D, E, F) {\n    fn eq(&self, other: &(A, B, C, D, E, F)) -> bool {\n        self.0 == other.0 && self.1 == other.1 && self.2 == other.2 && self.3 == other.3\n            && self.4 == other.4 && self.5 == other.5\n    }\n}\n\nimpl<A: Eq, B: Eq, C: Eq, D: Eq, E: Eq, F: Eq> Eq for (A, B, C, D, E, F) {}\n\nimpl<A: PartialOrd, B: PartialOrd, C: PartialOrd, D: PartialOrd, E: PartialOrd,\n");
    buf_str(out, c"    F: PartialOrd> PartialOrd for (A, B, C, D, E, F) {\n    fn partial_cmp(&self, other: &(A, B, C, D, E, F)) -> Option<Ordering> {\n        match self.0.partial_cmp(&other.0) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.1.partial_cmp(&other.1) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.2.partial_cmp(&other.2) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.3.partial_cmp(&other.3) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        match self.4.partial_cmp(&other.4) {\n            Option::Some(Ordering::Equal) => {}\n            c => return c,\n        }\n        self.5.partial_cmp(&other.5)\n    }\n}\n\nimpl<A: Ord, B: Ord, C: Ord, D: Ord, E: Ord, F: Ord> Ord for (A, B, C, D, E, F) {\n    fn cmp(&self, other: &(A, B, C, D, E, F)) -> Ordering {\n        match self.0.cmp(&other.0) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.1.cmp(&other.1) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.2.cmp(&other.2) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.3.cmp(&other.3) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        match self.4.cmp(&other.4) {\n            Ordering::Equal => {}\n            c => return c,\n        }\n        self.5.cmp(&other.5)\n    }\n}\n\n// References compare as what they point to (Rust's `impl PartialEq<&B>\n// for &A`): `&a == &b`, and an iterator of references' eq and ne.\nimpl<'a, 'b, A: ?Sized + PartialEq<B>, B: ?Sized> PartialEq<&'b B> for &'a A {\n    fn eq(&self, other: &&'b B) -> bool {\n        PartialEq::eq(*self, *other)\n    }\n}\n\nimpl<'a, 'b, A: ?Sized + PartialOrd<B>, B: ?Sized> PartialOrd<&'b B> for &'a A {\n");
    buf_str(out, c"    fn partial_cmp(&self, other: &&'b B) -> Option<Ordering> {\n        PartialOrd::partial_cmp(*self, *other)\n    }\n}\n\n// (Z9.1c, 0.27.4) and order as it does: `max(\"a\", \"b\")`, a sort of `&str`s.\nimpl<'a, A: ?Sized + Eq> Eq for &'a A {}\n\nimpl<'a, A: ?Sized + Ord> Ord for &'a A {\n    fn cmp(&self, other: &Self) -> Ordering {\n        Ord::cmp(*self, *other)\n    }\n}\n// ---- end mod std::cmp ----\n}\n// ---- mod std::clone ----\npub mod clone {\n// std::clone: Clone. A container's clone reuses its stored allocator,\n// which its type shows (`&Vec<T, Gpa>` may allocate from Gpa through\n// clone; plan §2.0), so `#[derive(Clone)]` on a type generic over A needs\n// `A: Clone`; `clone_in(a)`, inherent on each container, moves the copy\n// to another allocator.\n\n// A copy of the value that owns what it holds (a Vec's elements, cloned).\n// std: changed: takes &self\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Clone: Sized {\n    // std: changed: takes &self (MVS: a let self)\n    fn clone(&self) -> Self;\n\n    // `*self = source.clone()`, reusing self's storage where it can.\n    fn clone_from(&mut self, source: &Self) {\n        *self = source.clone();\n    }\n}\n\n// The unit value's copy (Rust's core implements Clone for `()` and the\n// tuples; Gpa's derived Clone clones its `()` field).\nimpl Clone for () {\n    fn clone(&self) -> () {\n        ()\n    }\n}\n\n// A tuple's copy: each element's (Rust's core has them up to 12 elements;\n// here up to 4: the lazy std keeps each impl in every program).\nimpl<A: Clone> Clone for (A,) {\n    fn clone(&self) -> (A,) {\n        (self.0.clone(),)\n    }\n}\n\nimpl<A: Clone, B: Clone> Clone for (A, B) {\n    fn clone(&self) -> (A, B) {\n        (self.0.clone(), self.1.clone())\n    }\n}\n\nimpl<A: Clone, B: Clone, C: Clone> Clone for (A, B, C) {\n    fn clone(&self) -> (A, B, C) {\n        (self.0.clone(), self.1.clone(), self.2.clone())\n    }\n}\n\n");
    buf_str(out, c"impl<A: Clone, B: Clone, C: Clone, D: Clone> Clone for (A, B, C, D) {\n    fn clone(&self) -> (A, B, C, D) {\n        (self.0.clone(), self.1.clone(), self.2.clone(), self.3.clone())\n    }\n}\n\n// A shared reference's copy: the same reference (Rust's core). So an\n// allocator given by reference, `A = &ArenaScope<'_, Gpa>`, is Clone.\nimpl<T: ?Sized> Clone for &T {\n    fn clone(&self) -> Self {\n        *self\n    }\n}\n\n// std: new (char is no `#[builtin_impls]` primitive: written)\nimpl Clone for char {\n    fn clone(&self) -> char {\n        *self\n    }\n}\n// ---- end mod std::clone ----\n}\n// ---- mod std::default ----\npub mod default {\n// std::default: Default, for types that hold no allocator, and\n// DefaultIn<A>, for the ones that do (plan §3). Vec, String and HashMap\n// are never Default (there is no ambient allocator); a blanket impl makes\n// every Default type DefaultIn<A> for any A, which is coherent under\n// Rust's rules exactly because the containers have no Default impl\n// (checked with rustc 1.98). So `map.entry(k).or_default()` makes a 0, a\n// None or an empty Vec on a clone of the map's allocator alike.\n\nuse crate::alloc::Allocator;\n\n// A type's natural empty or zero value: 0, false, None, \"\", (), an empty\n// struct of Defaults (`#[derive(Default)]`).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Default: Sized {\n    fn default() -> Self;\n}\n\n// A type's empty value, made with an allocator: `Vec::new_in(a)`,\n// `String::new_in(a)`, or Default's for a type that holds none\n// (`#[derive(DefaultIn)]` for a struct of DefaultIn fields).\npub trait DefaultIn<A>: Sized {\n    fn default_in(a: A) -> Self;\n}\n\n// later: blanket_impl\nimpl<T: Default, A> DefaultIn<A> for T {\n    fn default_in(a: A) -> T {\n        T::default()\n    }\n}\n// ---- end mod std::default ----\n}\n// ---- mod std::convert ----\npub mod convert {\n");
    buf_str(out, c"// std::convert: From, Into, TryFrom, TryInto, AsRef, AsMut, Infallible.\n// `?` converts an error through From only (plan §3). A conversion that\n// allocates is not From: `String::from_in(s, a)`, not `String::from(s)`.\n\nuse crate::result::Result;\n\n// A conversion that cannot fail: `i64::from(3u8)`, `Some(x)` from x.\npub trait From<T>: Sized {\n    fn from(value: T) -> Self;\n}\n\n// From's other side: `let n: i64 = b.into();`. Implement From, not Into.\npub trait Into<T>: Sized {\n    fn into(self) -> T;\n}\n\n// later: blanket_impl\nimpl<T, U: From<T>> Into<U> for T {\n    fn into(self) -> U {\n        U::from(self)\n    }\n}\n\n// A conversion that may fail: `u8::try_from(300i64)` is an Err.\npub trait TryFrom<T>: Sized {\n    type Error;\n\n    fn try_from(value: T) -> Result<Self, Self::Error>;\n}\n\n// TryFrom's other side.\npub trait TryInto<T>: Sized {\n    type Error;\n\n    fn try_into(self) -> Result<T, Self::Error>;\n}\n\n// later: blanket_impl\nimpl<T, U: TryFrom<T>> TryInto<U> for T {\n    type Error = U::Error;\n\n    fn try_into(self) -> Result<U, U::Error> {\n        U::try_from(self)\n    }\n}\n\n// A cheap view as &T: `fn open<P: AsRef<str>>(p: P)` takes a &str, a\n// String<A> or a &String<A>.\npub trait AsRef<T: ?Sized> {\n    fn as_ref(&self) -> &T;\n}\n\n// A cheap view as &mut T.\npub trait AsMut<T: ?Sized> {\n    fn as_mut(&mut self) -> &mut T;\n}\n\n// A reference views as what it refers to does (Rust's `impl AsRef<U> for\n// &T`): `open(\"x\")` with `P: AsRef<str>`, P = &str (Z9.1c, 0.27.4).\nimpl<T: ?Sized + AsRef<U>, U: ?Sized> AsRef<U> for &T {\n    fn as_ref(&self) -> &U {\n        AsRef::as_ref(*self)\n    }\n}\n\nimpl<T: ?Sized + AsRef<U>, U: ?Sized> AsRef<U> for &mut T {\n    fn as_ref(&self) -> &U {\n        AsRef::as_ref(&**self)\n    }\n}\n\nimpl<T: ?Sized + AsMut<U>, U: ?Sized> AsMut<U> for &mut T {\n    fn as_mut(&mut self) -> &mut U {\n        AsMut::as_mut(*self)\n    }\n}\n\n");
    buf_str(out, c"// The error of a conversion that cannot fail: it has no value.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Infallible {}\n\n// The error of a narrowing integer conversion (`u8::try_from(300)`): which\n// side of the type's range the value was on (Rust's, and its Debug).\n// MVS's TryFromIntError, kept.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct TryFromIntError(crate::str::IntErrorKind);\n\n// (for std's integer conversions, compiler/std/intconv.vl: the value was\n// below the type's smallest, or above its largest)\n#[effects()]\npub(crate) fn int_range_error(below: bool) -> TryFromIntError {\n    TryFromIntError(if below { crate::str::IntErrorKind::NegOverflow }\n        else { crate::str::IntErrorKind::PosOverflow })\n}\n\nimpl crate::fmt::Display for TryFromIntError {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"out of range integral type conversion attempted\")\n    }\n}\n\n// `?` on a conversion that cannot fail, in a function that returns the\n// error of one that can (Rust's).\nimpl From<Infallible> for TryFromIntError {\n    fn from(x: Infallible) -> TryFromIntError {\n        match x {}\n    }\n}\n// ---- end mod std::convert ----\n}\n// ---- mod std::borrow ----\npub mod borrow {\n// std::borrow: Borrow, BorrowMut and ToOwnedIn<A>. Borrow is what lets a\n// HashMap<String<A>, V, A> be looked up by a &str: `String<A>:\n// Borrow<str>`, with the same Hash and Eq (Hash must not depend on A).\n// Cow<'a, B, A> waits for 0.29 (plan §3; it needs ToOwnedIn's Owned to\n// carry A through a type).\n\nuse crate::alloc::Allocator;\n\n// A view of self as a &Borrowed that hashes and compares as self does.\npub trait Borrow<Borrowed: ?Sized> {\n    fn borrow(&self) -> &Borrowed;\n}\n\n// The same, mutable.\npub trait BorrowMut<Borrowed: ?Sized>: Borrow<Borrowed> {\n    fn borrow_mut(&mut self) -> &mut Borrowed;\n}\n\n");
    buf_str(out, c"// Every T is a view of itself (a HashMap<i64, V, A> looked up by &i64).\n// later: blanket_impl\nimpl<T: ?Sized> Borrow<T> for T {\n    fn borrow(&self) -> &T {\n        self\n    }\n}\n\n// later: blanket_impl\nimpl<T: ?Sized> BorrowMut<T> for T {\n    fn borrow_mut(&mut self) -> &mut T {\n        self\n    }\n}\n\n// A reference is a view of what it refers to (Rust's `impl Borrow<T> for\n// &T`): a HashMap<&str, V, A> looked up by a &str (Z9.1c, 0.27.4).\nimpl<T: ?Sized> Borrow<T> for &T {\n    fn borrow(&self) -> &T {\n        *self\n    }\n}\n\nimpl<T: ?Sized> Borrow<T> for &mut T {\n    fn borrow(&self) -> &T {\n        &**self\n    }\n}\n\n// Rust's ToOwned, with the allocator named: an owned copy of a view, on a.\n// `\"x\".to_owned_in(gpa)` is a String<Gpa>, `[1, 2][..].to_owned_in(gpa)` a\n// Vec<i64, Gpa>; a Clone type's owned form is a clone (a's unused).\npub trait ToOwnedIn<A: Allocator> {\n    type Owned;\n\n    fn to_owned_in(&self, a: A) -> Self::Owned;\n}\n// ---- end mod std::borrow ----\n}\n// ---- mod std::mem ----\npub mod mem {\n// std::mem: moving values in and out of places, and the sizes of types.\n// size_of, align_of and needs_drop are evaluated by the compiler; the\n// others are plain functions over `&mut T`.\n\nuse crate::default::Default;\n\n// Exchanges the values of two places (MVS: two inout parameters).\n// std: changed: takes &mut T twice\n#[effects(unsafe, T)]\npub fn swap<T>(a: &mut T, b: &mut T) {\n    // UNSAFE: raw moves (an assignment would drop the old value).\n    // SAFETY: a and b are two live &mut, so valid, aligned and distinct;\n    // each value is read once and ends in exactly one place.\n    unsafe {\n        let pa = a as *mut T;\n        let pb = b as *mut T;\n        let t = crate::ptr::read(pa as *const T);\n        // (0.29: a read and a write, not ptr::copy_nonoverlapping of one\n        // element, which is a call and its tests of the count in a build\n        // that does not inline: a sort's swaps at -O0)\n");
    buf_str(out, c"        crate::ptr::write(pa, crate::ptr::read(pb as *const T));\n        crate::ptr::write(pb, t);\n    }\n}\n\n// Moves src into dest and returns dest's old value.\n// std: changed: takes &mut T\n#[effects(unsafe, T)]\npub fn replace<T>(dest: &mut T, src: T) -> T {\n    // UNSAFE: a raw move out and in (an assignment would drop the old value).\n    // SAFETY: dest is a live &mut: valid and aligned; its old value is\n    // read once, returned, and overwritten without a drop.\n    unsafe {\n        let p = dest as *mut T;\n        let old = crate::ptr::read(p as *const T);\n        crate::ptr::write(p, src);\n        old\n    }\n}\n\n// Moves dest's value out, leaving its Default (`take(&mut v)` on an\n// allocator-free type; a Vec has no Default, and Vec::take, inherent,\n// leaves an empty Vec on a clone of its allocator).\n// std: changed: takes &mut T\n#[effects(T)]\npub fn take<T: Default>(dest: &mut T) -> T {\n    replace(dest, T::default())\n}\n\n// Ends x's life here: its Drop runs now, not at the end of its scope.\n#[effects(T)]\npub fn drop<T>(x: T) {}\n\n// Ends x's life without running its Drop: what it owns is leaked (unless\n// something else frees it). Safe, as in Rust: a leak is not undefined.\n#[effects()]\npub fn forget<T>(x: T) {\n    // Built in: the compiler keeps std's `forget`'s parameter undropped\n    // (MVS's forget is the same empty body).\n}\n\n// The size of a T in bytes, padding included (built in).\n#[effects()]\npub fn size_of<T>() -> usize {\n    size_of(T) as usize\n}\n\n// The alignment of a T in bytes (built in).\n#[effects()]\npub fn align_of<T>() -> usize {\n    align_of(T) as usize\n}\n\n// The size of the value x refers to (for str and [T], from its length).\n#[effects()]\npub fn size_of_val<T: ?Sized>(x: &T) -> usize {\n    size_of(T) as usize\n}\n\n// Whether dropping a T runs code: a Drop impl, or a part with one. For a\n// container on an allocator that does not free (Allocator::FREES false:\n");
    buf_str(out, c"// an arena, a FixedBuf), only its elements count (plan §9.1): an arena's\n// `alloc(x)` takes a T for which this is false (built in).\n#[effects()]\npub fn needs_drop<T: ?Sized>() -> bool {\n    // Built in: the compiler folds the call to its constant (MVS's body\n    // is the same `false`).\n    false\n}\n\n// (0.29) Whether T is Copy, so that a clone of a T is a copy of its\n// bytes: what lets one body of `Vec::extend_from_slice`, `resize`, `fill`\n// and `clone_from_slice` (declared for `T: Clone`) copy a block for the\n// Copy types and clone element by element for the others; vole has no\n// specialization, Rust's way to the same. Built in, as needs_drop: a\n// compiler that does not know it reads the `false` below, and std takes\n// the element-by-element path, which is right for every type.\n#[effects()]\npub(crate) fn is_copy<T>() -> bool {\n    // Built in: the compiler folds the call to its constant.\n    false\n}\n\n// (0.29) Whether `==` between a T and a U is the equality of their bytes:\n// T and U the same integer type, bool or char (not a float: 0.0 == -0.0\n// and NaN != NaN; not a struct: padding, and its own PartialEq). A\n// slice's `==` over such elements is one block compare. Built in, as\n// is_copy.\n#[effects()]\npub(crate) fn is_bytewise_eq<T, U>() -> bool {\n    // Built in: the compiler folds the call to its constant.\n    false\n}\n\n// A T whose drop does not run unless asked (`ManuallyDrop::drop`), as\n// Rust's: a union over the T, whose field a union never drops (F19.7).\n// std: changed: a union (Rust's is a struct the compiler knows)\npub union ManuallyDrop<T> {\n    value: T,\n}\n\nimpl<T> ManuallyDrop<T> {\n    // value, kept from being dropped.\n    #[effects()]\n    pub fn new(value: T) -> ManuallyDrop<T> {\n        ManuallyDrop { value: value }\n    }\n\n    // The value back, its drop the caller's again.\n    #[effects(unsafe)]\n    pub fn into_inner(slot: ManuallyDrop<T>) -> T {\n");
    buf_str(out, c"        // UNSAFE: a union's field read out.\n        // SAFETY: value is its one field, written by new; the read moves\n        // the union, so the value has one owner.\n        unsafe { slot.value }\n    }\n\n    // Moves the value out, leaving slot's bits as they are.\n    #[effects(unsafe, T)]\n    // UNSAFE: the value leaves a slot that still holds its bits.\n    // SAFETY: a contract on the caller: slot is not used again (read,\n    // taken or dropped) unless a value is written back.\n    pub unsafe fn take(slot: &mut ManuallyDrop<T>) -> T {\n        crate::ptr::read(&slot.value as *const T)\n    }\n\n    // Runs the value's drop in place.\n    #[effects(unsafe, T)]\n    // UNSAFE: drops a value the slot still holds the bits of.\n    // SAFETY: a contract on the caller: slot is not used again (read,\n    // taken or dropped) unless a value is written back.\n    pub unsafe fn drop(slot: &mut ManuallyDrop<T>) {\n        crate::ptr::drop_in_place(&mut slot.value as *mut T)\n    }\n}\n\nimpl<T> crate::ops::Deref for ManuallyDrop<T> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        // (a union's field borrowed, which reads nothing: value is the one\n        // field, written by new)\n        &self.value\n    }\n}\n\nimpl<T> crate::ops::DerefMut for ManuallyDrop<T> {\n    fn deref_mut(&mut self) -> &mut T {\n        // (a union's field borrowed mutably: value is the one field, written\n        // by new)\n        &mut self.value\n    }\n}\n\n// Zero bytes, 8-aligned, that zeroed reads a value from.\nstatic ZEROS: [u64; 512] = [0; 512];\n\n// A T whose bytes are all zero, as Rust's (for C's structs, filled by the\n// call they are passed to). vole's limits: a T of at most 4096 bytes and\n// an alignment of at most 8 (it is read from a static of zeros); a larger\n// one panics.\n// UNSAFE: all-zero bytes are not a value of every type (a reference, a\n// Box, an enum without a zero variant).\n");
    buf_str(out, c"// SAFETY: (the caller's) all-zero bytes are a valid T, as Rust's zeroed\n// asks.\n#[effects(panic, diverge, unsafe, T)]\npub unsafe fn zeroed<T>() -> T {\n    if size_of::<T>() > 4096 || align_of::<T>() > 8 {\n        crate::panic::panic(\n            \"std::mem::zeroed: the type is larger than 4096 bytes or aligned over 8\");\n    }\n    crate::ptr::read(ZEROS.as_ptr() as *const T)\n}\n// ---- end mod std::mem ----\n}\n// ---- mod std::ptr ----\npub mod ptr {\n// std::ptr: NonNull and the raw-pointer functions std's bodies use. A raw\n// pointer is `*const T` or `*mut T` (plan §5); reading or writing through\n// one is unsafe, and its SAFETY comment says why it is sound.\n\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\n\n// A *mut T that is never null: what a container keeps (Option<NonNull<T>>\n// is one word). Covariant in T, as Rust's.\n// mvs: NonNull\n// std: changed: a struct over *const T (MVS: a distinct *T with an invariant)\npub struct NonNull<T: ?Sized> {\n    pointer: *const T,\n}\n\nimpl<T> NonNull<T> {\n    // p as a NonNull; None when it is null.\n    // std: changed: takes *mut T\n    #[effects()]\n    pub fn new(p: *mut T) -> Option<NonNull<T>> {\n        if p.is_null() { Option::None } else { Option::Some(NonNull { pointer: p as *const T }) }\n    }\n\n    // A pointer that is not null and is aligned, for a zero-sized T or an\n    // empty container: it is never read.\n    #[effects(unsafe)]\n    pub fn dangling() -> NonNull<T> {\n        NonNull { pointer: crate::mem::align_of::<T>() as *const T }\n    }\n\n    // The pointer.\n    // std: changed: returns *mut T\n    #[effects()]\n    pub fn as_ptr(self) -> *mut T {\n        self.pointer as *mut T\n    }\n\n    // The value it points at, as a reference. The caller says the pointer\n    // is valid and aligned, the value initialized, and nothing writes it\n    // for 'a.\n    #[effects(unsafe)]\n");
    buf_str(out, c"    // UNSAFE: the caller vouches for the pointer's target and its lifetime.\n    // SAFETY: a contract on the caller, as Rust's NonNull::as_ref.\n    pub unsafe fn as_ref<'a>(&self) -> &'a T {\n        &*self.pointer\n    }\n\n    // The same, mutable: nothing else reads or writes it for 'a.\n    #[effects(unsafe)]\n    // UNSAFE: the caller vouches for the pointer's target and its lifetime.\n    // SAFETY: a contract on the caller, as Rust's NonNull::as_mut.\n    pub unsafe fn as_mut<'a>(&mut self) -> &'a mut T {\n        &mut *(self.pointer as *mut T)\n    }\n\n    // A pointer to a U at the same address.\n    #[effects()]\n    pub fn cast<U>(self) -> NonNull<U> {\n        NonNull { pointer: self.pointer as *const U }\n    }\n\n    // The pointer count elements on (inside one allocation).\n    #[effects(unsafe)]\n    // UNSAFE: an offset out of the allocation is undefined.\n    // SAFETY: a contract on the caller, as Rust's NonNull::add.\n    pub unsafe fn add(self, count: usize) -> NonNull<T> {\n        // Built in (Rust's ptr::add): vole's raw-pointer arithmetic, `&p[i]`.\n        NonNull { pointer: &self.pointer[count] as *const T }\n    }\n}\n\nimpl<T: ?Sized> Clone for NonNull<T> {\n    fn clone(&self) -> NonNull<T> {\n        *self\n    }\n}\n\nimpl<T: ?Sized> Copy for NonNull<T> {}\n\nimpl<T: ?Sized> PartialEq for NonNull<T> {\n    fn eq(&self, other: &NonNull<T>) -> bool {\n        self.pointer == other.pointer\n    }\n}\n\nimpl<T: ?Sized> Eq for NonNull<T> {}\n\n// A null *const T.\n#[effects()]\npub fn null<T>() -> *const T {\n    0 as *const T\n}\n\n// A null *mut T.\n#[effects()]\npub fn null_mut<T>() -> *mut T {\n    0 as *mut T\n}\n\n// The T at src, moved out bit for bit (src is left as it was: the caller\n// makes sure only one of the two is dropped).\n#[inline]\n#[effects(unsafe)]\n// UNSAFE: reads through a raw pointer.\n// SAFETY: a contract on the caller: src valid, aligned, initialized.\npub unsafe fn read<T>(src: *const T) -> T {\n");
    buf_str(out, c"    // Built in: a raw read moves the bits out and drops nothing.\n    src[0]\n}\n\n// Moves value into dst without dropping what was there.\n#[inline]\n#[effects(unsafe)]\n// UNSAFE: writes through a raw pointer.\n// SAFETY: a contract on the caller: dst valid and aligned.\npub unsafe fn write<T>(dst: *mut T, value: T) {\n    // Built in: a raw store writes the bits and drops nothing.\n    dst[0] = value;\n}\n\n// UNSAFE: C's block routines, over raw memory.\n// SAFETY: the prototypes are string.h's; each call below says why its\n// ranges are valid.\nextern \"C\" {\n    #[link_name = \"memcpy\"]\n    fn ptr_c_memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;\n    #[link_name = \"memmove\"]\n    fn ptr_c_memmove(d: *mut u8, s: *const u8, n: usize) -> *mut u8;\n    #[link_name = \"memset\"]\n    fn ptr_c_memset(d: *mut u8, c: i32, n: usize) -> *mut u8;\n    #[link_name = \"memcmp\"]\n    fn ptr_c_memcmp(a: *const u8, b: *const u8, n: usize) -> i32;\n    #[link_name = \"memchr\"]\n    fn ptr_c_memchr(s: *const u8, c: i32, n: usize) -> *const u8;\n}\n\n// (0.29) From this many elements on a copy is C's (one call, the bytes\n// moved as words and vectors); below it, the loop: a call costs more\n// than moving one to three elements (mem::swap's one, a sort's).\nconst BLOCK_MIN: usize = 4;\n\n// count T's from src to dst; the two may overlap (memmove).\n#[effects(unsafe)]\n// UNSAFE: reads and writes through raw pointers.\n// SAFETY: a contract on the caller: both ranges valid and aligned.\npub unsafe fn copy<T>(src: *const T, dst: *mut T, count: usize) {\n    let size = crate::mem::size_of::<T>();\n    if size == 0 {\n        // (a zero-sized T has no bytes to move, and its pointers are\n        // dangling: C is given none of them)\n        return;\n    }\n    if count >= BLOCK_MIN {\n        // The caller's two ranges are count T's each, count * size bytes;\n        // memmove allows their overlap.\n");
    buf_str(out, c"        ptr_c_memmove(dst as *mut u8, src as *const u8, count * size);\n        return;\n    }\n    // Forward when dst is below src, backward otherwise: overlap is safe.\n    // (0.29: counted loops, which end: a copy is no reason for `diverge`\n    // in what calls it, a String's push_str and every format among them)\n    if (dst as *const T as usize) <= (src as usize) {\n        for i in 0..count {\n            dst[i] = src[i];\n        }\n    } else {\n        for k in 0..count {\n            let i = count - 1 - k;\n            dst[i] = src[i];\n        }\n    }\n}\n\n// count T's from src to dst, which do not overlap (memcpy).\n#[effects(unsafe)]\n// UNSAFE: reads and writes through raw pointers.\n// SAFETY: a contract on the caller: both ranges valid, aligned, disjoint.\npub unsafe fn copy_nonoverlapping<T>(src: *const T, dst: *mut T, count: usize) {\n    let size = crate::mem::size_of::<T>();\n    if size == 0 {\n        // (as copy: nothing to move, and no dangling pointer given to C)\n        return;\n    }\n    if count >= BLOCK_MIN {\n        // The caller's two ranges are count T's each, count * size bytes,\n        // and disjoint, as memcpy asks.\n        ptr_c_memcpy(dst as *mut u8, src as *const u8, count * size);\n        return;\n    }\n    for i in 0..count {\n        dst[i] = src[i];\n    }\n}\n\n// (0.29) count copies of *x written from dst on, as a block: a byte-sized\n// T by memset; a larger one written a few times, then what is filled\n// copied onto what is not, twice as much each time (a handful of memcpy\n// calls for any count). The bits of *x are duplicated, nothing is cloned\n// or dropped: for a Copy T (mem::is_copy), as Vec::resize and [T]::fill\n// use it.\n#[effects(unsafe)]\n// UNSAFE: writes through a raw pointer.\n// SAFETY: a contract on the caller: dst valid and aligned for count T's,\n// which x is no part of; a T that may be duplicated bit for bit.\npub(crate) unsafe fn fill_copies<T>(dst: *mut T, count: usize, x: &T) {\n");
    buf_str(out, c"    let size = crate::mem::size_of::<T>();\n    if size == 0 {\n        // (nothing to write)\n        return;\n    }\n    let src = x as *const T;\n    if size == 1 {\n        // x is one readable byte (a reference to a T of size 1); dst has\n        // count writable bytes (the caller's).\n        ptr_c_memset(dst as *mut u8, (src as *const u8)[0] as i32, count);\n        return;\n    }\n    let head = if count < 8 { count } else { 8 };\n    for i in 0..head {\n        dst[i] = src[0];\n    }\n    let mut i = head;\n    // What is filled doubles each time, from 8 elements: 64 rounds reach\n    // any count a usize holds (a counted loop: it ends, and says so).\n    for _ in 0..64 {\n        if i >= count {\n            break;\n        }\n        // [0, i) is filled; the next k <= i elements, [i, i + k), are\n        // inside the caller's range (k <= count - i) and past [0, k).\n        let k = if count - i < i { count - i } else { i };\n        ptr_c_memcpy(dst.add(i) as *mut u8, dst as *const u8, k * size);\n        i += k;\n    }\n}\n\n// (0.29) Whether the n bytes at a and at b are the same (memcmp).\n#[effects(unsafe)]\n// UNSAFE: reads through raw pointers.\n// SAFETY: a contract on the caller: n readable bytes at each.\npub(crate) unsafe fn bytes_equal(a: *const u8, b: *const u8, n: usize) -> bool {\n    ptr_c_memcmp(a, b, n) == 0\n}\n\n// (0.29) The index of the first byte x among the n at p (memchr).\n#[effects(unsafe)]\n// UNSAFE: reads through a raw pointer.\n// SAFETY: a contract on the caller: n readable bytes at p.\npub(crate) unsafe fn byte_index(p: *const u8, n: usize, x: u8) -> Option<usize> {\n    // memchr returns null or the address of one of the n bytes: at or\n    // above p, below p + n.\n    let q = ptr_c_memchr(p, x as i32, n);\n    if q.is_null() { Option::None } else { Option::Some((q as usize) - (p as usize)) }\n}\n\n// Runs the drop of the value at p, in place.\n#[effects(unsafe, T)]\n// UNSAFE: drops through a raw pointer.\n");
    buf_str(out, c"// SAFETY: a contract on the caller: p valid, its value initialized and\n// not used again.\npub unsafe fn drop_in_place<T: ?Sized>(p: *mut T) {\n    // The value moved out and dropped here.\n    crate::mem::drop(read(p as *const T));\n}\n\n// Whether two pointers have the same address.\n#[effects()]\npub fn eq<T: ?Sized>(a: *const T, b: *const T) -> bool {\n    a == b\n}\n\n// std: new: Rust's raw-pointer methods. `*const T` and `*mut T` are two\n// types (0.29, front-rust.md F30.5), each with its impl, as in Rust: the\n// arithmetic of each gives its own kind, `write` is `*mut T`'s only, and\n// `cast_mut` and `cast_const` go from one to the other. A `*mut T`\n// receiver also takes a method that only `*const T` has.\nimpl<T> *const T {\n    // Whether the pointer is null.\n    #[effects()]\n    pub fn is_null(self) -> bool {\n        (self as usize) == 0\n    }\n\n    // The pointer count T's on (pointer arithmetic, Rust's `add`).\n    #[effects(unsafe)]\n    // UNSAFE: the result must stay in (or one past) the same allocation.\n    // SAFETY: a contract on the caller, as Rust's.\n    pub unsafe fn add(self, count: usize) -> *const T {\n        ((self as usize) + count * crate::mem::size_of::<T>()) as *const T\n    }\n\n    // The pointer count T's back.\n    // UNSAFE: as add.\n    // SAFETY: a contract on the caller, as Rust's.\n    #[effects(unsafe)]\n    pub unsafe fn sub(self, count: usize) -> *const T {\n        ((self as usize) - count * crate::mem::size_of::<T>()) as *const T\n    }\n\n    // The pointer count T's on, or back for a negative count.\n    // UNSAFE: as add.\n    // SAFETY: a contract on the caller, as Rust's.\n    #[effects(unsafe, T)]\n    pub unsafe fn offset(self, count: isize) -> *const T {\n        if count >= 0 { self.add(count as usize) } else { self.sub((0 - count) as usize) }\n    }\n\n    // The T it points to, moved out bit for bit (ptr::read).\n    #[effects(unsafe, T)]\n    // UNSAFE: reads through a raw pointer.\n");
    buf_str(out, c"    // SAFETY: a contract on the caller: valid, aligned, initialized.\n    pub unsafe fn read(self) -> T {\n        read(self)\n    }\n\n    // The same address as a pointer to U.\n    #[effects()]\n    pub fn cast<U>(self) -> *const U {\n        self as *const U\n    }\n\n    // The same pointer as a `*mut T` (Rust's `cast_mut`): writing through\n    // it is the caller's to justify.\n    #[effects()]\n    pub fn cast_mut(self) -> *mut T {\n        self as *mut T\n    }\n}\n\nimpl<T> *mut T {\n    // Whether the pointer is null.\n    #[effects()]\n    pub fn is_null(self) -> bool {\n        (self as usize) == 0\n    }\n\n    // The pointer count T's on (pointer arithmetic, Rust's `add`).\n    #[effects(unsafe)]\n    // UNSAFE: the result must stay in (or one past) the same allocation.\n    // SAFETY: a contract on the caller, as Rust's.\n    pub unsafe fn add(self, count: usize) -> *mut T {\n        ((self as usize) + count * crate::mem::size_of::<T>()) as *mut T\n    }\n\n    // The pointer count T's back.\n    // UNSAFE: as add.\n    // SAFETY: a contract on the caller, as Rust's.\n    #[effects(unsafe)]\n    pub unsafe fn sub(self, count: usize) -> *mut T {\n        ((self as usize) - count * crate::mem::size_of::<T>()) as *mut T\n    }\n\n    // The pointer count T's on, or back for a negative count.\n    // UNSAFE: as add.\n    // SAFETY: a contract on the caller, as Rust's.\n    #[effects(unsafe, T)]\n    pub unsafe fn offset(self, count: isize) -> *mut T {\n        if count >= 0 { self.add(count as usize) } else { self.sub((0 - count) as usize) }\n    }\n\n    // The T it points to, moved out bit for bit (ptr::read).\n    #[effects(unsafe, T)]\n    // UNSAFE: reads through a raw pointer.\n    // SAFETY: a contract on the caller: valid, aligned, initialized.\n    pub unsafe fn read(self) -> T {\n        read(self as *const T)\n    }\n\n    // value stored where it points, the old value not dropped (ptr::write).\n    // UNSAFE: writes through a raw pointer.\n");
    buf_str(out, c"    // SAFETY: a contract on the caller: valid and aligned.\n    #[effects(unsafe, T)]\n    pub unsafe fn write(self, value: T) {\n        write(self, value)\n    }\n\n    // The same address as a pointer to U.\n    #[effects()]\n    pub fn cast<U>(self) -> *mut U {\n        self as *mut U\n    }\n\n    // The same pointer as a `*const T` (Rust's `cast_const`).\n    #[effects()]\n    pub fn cast_const(self) -> *const T {\n        self as *const T\n    }\n}\n\n// The n T's from p, as a slice: what slice::from_raw_parts makes. The raw\n// slicing (MVS's) is legal in this module only (front-rust.md F30.3).\n#[effects(unsafe)]\n// UNSAFE: the slice's elements are read through p.\n// SAFETY: a contract on the caller: p valid for n initialized T's for 'a.\npub(crate) unsafe fn slice_parts<'a, T>(p: *const T, n: usize) -> &'a [T] {\n    &p[0..n]\n}\n\n// The same, mutable: slice::from_raw_parts_mut.\n#[effects(unsafe)]\n// UNSAFE: the slice's elements are read and written through p.\n// SAFETY: a contract on the caller: p valid for n T's for 'a, and not\n// otherwise accessed for 'a.\npub(crate) unsafe fn slice_parts_mut<'a, T>(p: *mut T, n: usize) -> &'a mut [T] {\n    &mut p[0..n]\n}\n// ---- end mod std::ptr ----\n}\n// ---- mod std::cell ----\npub mod cell {\n// std::cell: Cell and UnsafeCell, Rust's API. A Cell is written through a\n// shared reference (`&self`): it is how an Arena bumps its pointer behind\n// the `&'a Arena<P>` every container holds (plan §2.1). Neither is Sync.\n// RefCell and its guards wait for 0.29 (plan §6, the cuts).\n\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::option::Option;\n\n// The one way to write through a & in safe code's types: what Cell, the\n// allocators' counters and Atomic are made of. `get` gives a raw pointer;\n// writing through it while a & to the value is live is undefined.\n#[repr(transparent)]\n");
    buf_str(out, c"pub struct UnsafeCell<T: ?Sized> {\n    value: T,\n}\n\nimpl<T> UnsafeCell<T> {\n    #[effects()]\n    pub fn new(value: T) -> UnsafeCell<T> {\n        UnsafeCell { value: value }\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> T {\n        self.value\n    }\n}\n\nimpl<T: ?Sized> UnsafeCell<T> {\n    // A pointer to the value, writable through a &self.\n    // std: changed: returns *mut T\n    #[effects()]\n    pub fn get(&self) -> *mut T {\n        &self.value as *const T as *mut T\n    }\n\n    // The value, through an exclusive borrow: no unsafe needed.\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut T {\n        &mut self.value\n    }\n}\n\n// A value set and read through a &: by copy (`get`, T: Copy) or by moving\n// it in and out (`set`, `replace`, `take`); never a reference into it.\n#[repr(transparent)]\npub struct Cell<T: ?Sized> {\n    value: UnsafeCell<T>,\n}\n\n// A Cell changes through `&self`, with no synchronization: never Sync\n// (its UnsafeCell says the same; stated, as Rust's). Send when T is.\nimpl<T: ?Sized> !Sync for Cell<T> {}\n\nimpl<T> Cell<T> {\n    #[effects(T)]\n    pub fn new(value: T) -> Cell<T> {\n        Cell { value: UnsafeCell::new(value) }\n    }\n\n    // Stores v (the old value is dropped).\n    #[effects(T)]\n    pub fn set(&self, v: T) {\n        drop(self.replace(v));\n    }\n\n    // Exchanges the values of two cells.\n    // std: changed: takes &Cell<T>\n    #[effects(unsafe, T)]\n    pub fn swap(&self, other: &Cell<T>) {\n        if crate::ptr::eq(self as *const Cell<T>, other as *const Cell<T>) {\n            return;\n        }\n        // UNSAFE: writes both cells' values through their UnsafeCells.\n        // SAFETY: a Cell never hands out a reference into its value, and it\n        // is not Sync: no other access to either value is live during the\n        // swap, and the two are distinct (checked above).\n        unsafe { crate::mem::swap(&mut *self.value.get(), &mut *other.value.get()) }\n    }\n\n");
    buf_str(out, c"    // Stores v and returns the old value.\n    #[effects(unsafe, T)]\n    pub fn replace(&self, v: T) -> T {\n        // UNSAFE: writes the value through the UnsafeCell.\n        // SAFETY: a Cell never hands out a reference into its value, and it\n        // is not Sync: this is the one access to it.\n        crate::mem::replace(unsafe { &mut *self.value.get() }, v)\n    }\n\n    #[effects(T)]\n    pub fn into_inner(self) -> T {\n        self.value.into_inner()\n    }\n}\n\nimpl<T: Copy> Cell<T> {\n    // A copy of the value.\n    #[effects(unsafe, T)]\n    pub fn get(&self) -> T {\n        // UNSAFE: a read of the value through the UnsafeCell.\n        // SAFETY: no &mut to the value exists (a Cell makes none); T is Copy.\n        unsafe { *self.value.get() }\n    }\n\n    // Stores f(old value) (`c.update(|n| n + 1)`).\n    // std: changed: FnOnce, returns nothing (Rust 1.88)\n    #[effects(T, F)]\n    pub fn update<F: FnOnce(T) -> T>(&self, f: F) {\n        self.set(f(self.get()));\n    }\n}\n\nimpl<T: ?Sized> Cell<T> {\n    // A pointer to the value.\n    // std: changed: returns *mut T\n    #[effects(T)]\n    pub fn as_ptr(&self) -> *mut T {\n        self.value.get()\n    }\n\n    // The value, through an exclusive borrow.\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> &mut T {\n        self.value.get_mut()\n    }\n}\n\nimpl<T: Default> Cell<T> {\n    // Moves the value out, leaving its Default.\n    #[effects(T)]\n    pub fn take(&self) -> T {\n        self.replace(T::default())\n    }\n}\n\nimpl<T: Copy> Clone for Cell<T> {\n    fn clone(&self) -> Cell<T> {\n        Cell::new(self.get())\n    }\n}\n\nimpl<T: Default> Default for Cell<T> {\n    fn default() -> Cell<T> {\n        Cell::new(T::default())\n    }\n}\n\nimpl<T: PartialEq + Copy> PartialEq for Cell<T> {\n    fn eq(&self, other: &Cell<T>) -> bool {\n        self.get() == other.get()\n    }\n}\n\nimpl<T: Eq + Copy> Eq for Cell<T> {}\n\nimpl<T: PartialOrd + Copy> PartialOrd for Cell<T> {\n");
    buf_str(out, c"    fn partial_cmp(&self, other: &Cell<T>) -> Option<Ordering> {\n        self.get().partial_cmp(&other.get())\n    }\n}\n\nimpl<T: Ord + Copy> Ord for Cell<T> {\n    fn cmp(&self, other: &Cell<T>) -> Ordering {\n        self.get().cmp(&other.get())\n    }\n}\n\nimpl<T: Debug + Copy> Debug for Cell<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Cell\").field(\"value\", &self.get()).finish()\n    }\n}\n\nimpl<T> From<T> for Cell<T> {\n    fn from(value: T) -> Cell<T> {\n        Cell::new(value)\n    }\n}\n// ---- end mod std::cell ----\n}\n// ---- mod std::panic ----\npub mod panic {\n// std::panic: panic, assert and the other functions Rust spells as\n// macros (vole has none: plan §3). A panic formats its message into a\n// fixed buffer, truncating it, so it never allocates and is callable\n// from #[no_alloc] code; it then exits with 101, with no unwinding\n// (decisions 5 and 18). A message is a format literal (`panic(\"bad\n// {x}\")`): the compiler checks it and builds its Display value\n// (`syntax.later: format_fns`); the default parameters are std's own.\n\nuse crate::cmp::PartialEq;\nuse crate::fmt::{Debug, Display, Formatter, Write};\nuse crate::result::Result;\n\n// UNSAFE: write(2) and exit(3), the way out: the message goes to stderr\n// and the program ends with 101, as MVS's panic_str.\n// SAFETY: write is passed a buffer's pointer and its own length; exit\n// takes a code and does not return.\n// (0.28.0, as MVS's: their effect is `panic`, not the io of writing a\n// message and exiting; docs/design/effects-allocation.md §2.2)\nextern \"C\" {\n    #[link_name = \"write\"]\n    #[effects(panic)]\n    fn panic_write(fd: i32, buf: *const u8, n: usize) -> isize;\n    #[link_name = \"exit\"]\n    #[effects(panic)]\n    fn panic_exit(code: i32) -> !;\n}\n\n// The bytes a panic's message is formatted into: fixed, so a panic never\n// allocates; a longer message is cut at a char boundary.\n");
    buf_str(out, c"const PANIC_BUF: usize = 1024;\n\nstruct PanicBuf {\n    buf: [u8; 1024],\n    len: usize,\n}\n\nimpl Write for PanicBuf {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        let mut n = s.len();\n        if n > PANIC_BUF - self.len {\n            n = PANIC_BUF - self.len;\n            while n > 0 && !s.is_char_boundary(n) {\n                n -= 1;\n            }\n        }\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < n {\n            self.buf[self.len + i] = b[i];\n            i += 1;\n        }\n        self.len += n;\n        Result::Ok(())\n    }\n}\n\nimpl PanicBuf {\n    fn new() -> PanicBuf {\n        PanicBuf { buf: [0; 1024], len: 0 }\n    }\n\n    // The message, a newline, and exit 101.\n    fn emit(&self) -> ! {\n        // UNSAFE: the extern write above.\n        // SAFETY: buf is valid for len bytes (len <= PANIC_BUF); the\n        // newline literal for one.\n        unsafe {\n            panic_write(2, &self.buf[0] as *const u8, self.len);\n            panic_write(2, \"\\n\".as_ptr(), 1);\n        }\n        panic_note();\n        // UNSAFE: the extern exit above.\n        // SAFETY: it takes a status and does not return.\n        unsafe { panic_exit(101) }\n    }\n}\n\n// The lines after a failure's message: none. In a program built with\n// --trace the compiler makes this call one of its trace runtime's, which\n// prints the calls that led to the failure (compiler/src/middle/trace.vl).\n// mvs: panic_note\nfn panic_note() {}\n\n// left and right as Rust's assert_eq and assert_ne show them, then the\n// way out.\nfn assert_failed<T: Debug>(op: &str, a: &T, b: &T, msg: &str) -> ! {\n    let mut w = PanicBuf::new();\n    let head: &str = \"assertion `left \";\n    let _ = w.write_str(head);\n    let _ = w.write_str(op);\n    let tail: &str = \" right` failed\";\n    let _ = w.write_str(tail);\n    if msg.len() > 0 {\n        let sep: &str = \": \";\n        let _ = w.write_str(sep);\n");
    buf_str(out, c"        let _ = w.write_str(msg);\n    }\n    let left: &str = \"\\n  left: \";\n    let _ = w.write_str(left);\n    {\n        let mut f = Formatter::new(&mut w);\n        let _ = crate::fmt::Debug::fmt(a, &mut f);\n    }\n    let right: &str = \"\\n right: \";\n    let _ = w.write_str(right);\n    {\n        let mut f = Formatter::new(&mut w);\n        let _ = crate::fmt::Debug::fmt(b, &mut f);\n    }\n    w.emit()\n}\n\n// Ends the program with msg on stderr, the caller's place and exit 101.\n// MVS's panic (a C string, unsafe) and panic_str are gone into it.\n// mvs: panic_str, panic\n// std: renamed\n// later: format_fns\n#[effects(panic, diverge, M)]\npub fn panic<M: Display>(msg: M) -> ! {\n    let mut w = PanicBuf::new();\n    {\n        let mut f = Formatter::new(&mut w);\n        let _ = crate::fmt::Display::fmt(&msg, &mut f);\n    }\n    w.emit()\n}\n\n// Panics when ok is false, with msg.\n// later: format_fns\n#[effects(panic)]\npub fn assert(ok: bool, msg: &str) {\n    if !ok {\n        if msg.len() == 0 {\n            let m: &str = \"assertion failed\";\n            panic(m);\n        }\n        panic(msg);\n    }\n}\n\n// `assert(ok, \"..{}..\", ..)`, a message with holes: formatted only when\n// ok is false, after `at`, the call's `FILE:LINE:COL`. The compiler makes\n// the call (front/check/format.vl: panic_call), not programs.\n#[effects(panic, diverge, M)]\npub fn __assert_fmt<M: Display>(ok: bool, msg: M, at: &str) {\n    if !ok {\n        let mut w = PanicBuf::new();\n        if at.len() > 0 {\n            let _ = w.write_str(at);\n            let sep: &str = \": \";\n            let _ = w.write_str(sep);\n        }\n        {\n            let mut f = Formatter::new(&mut w);\n            let _ = crate::fmt::Display::fmt(&msg, &mut f);\n        }\n        w.emit();\n    }\n}\n\n// `a == b` must hold, as `assert(a == b)`: the compiler makes the call that\n// check (front/contracts/desugar.vl), which compares the two in place\n");
    buf_str(out, c"// (neither is moved, as with Rust's macro) and reports the condition and\n// both values after the call's FILE:LINE:COL.\n// later: format_fns\n#[effects(panic, T)]\npub fn assert_eq<T: PartialEq + Debug>(a: T, b: T, msg: &str) {\n    if !(a == b) {\n        let op: &str = \"==\";\n        assert_failed(op, &a, &b, msg);\n    }\n}\n\n// `a != b` must hold, as `assert(a != b)` (see assert_eq).\n// later: format_fns\n#[effects(panic)]\npub fn assert_ne<T: PartialEq + Debug>(a: T, b: T, msg: &str) {\n    if a == b {\n        let op: &str = \"!=\";\n        assert_failed(op, &a, &b, msg);\n    }\n}\n\n// assert, only in debug builds (-O0, or with debug assertions).\n// later: format_fns\n// (The compiler drops the call outside test builds, as MVS's.)\n#[effects(panic)]\npub fn debug_assert(ok: bool, msg: &str) {\n    if !ok {\n        if msg.len() == 0 {\n            let m: &str = \"assertion failed\";\n            panic(m);\n        }\n        panic(msg);\n    }\n}\n\n// Code that cannot be reached: panics if it is, with Rust's text,\n// \"internal error: entered unreachable code\" (and `: msg`), after `at`,\n// the call's `FILE:LINE:COL`, which the compiler gives a call in the\n// program (front/contracts/desugar.vl: panic_site).\n// std: changed: a format literal for its message\n// later: format_fns\n#[effects(panic)]\npub fn unreachable(msg: &str, at: &str) -> ! {\n    if at.len() == 0 {\n        if msg.len() == 0 {\n            let m: &str = \"internal error: entered unreachable code\";\n            panic(m);\n        }\n        panic(\"internal error: entered unreachable code: {msg}\");\n    }\n    if msg.len() == 0 {\n        panic(\"{at}: internal error: entered unreachable code\");\n    }\n    panic(\"{at}: internal error: entered unreachable code: {msg}\")\n}\n\n// Code not written yet: panics with \"not yet implemented\". The spec\n// tree's bodies are this. Until format_fns the message is a &str: a\n// type parameter is not fixed by its default argument.\n");
    buf_str(out, c"// later: format_fns\n#[effects(panic)]\npub fn todo(msg: &str) -> ! {\n    let m: &str = \"not yet implemented\";\n    panic(m)\n}\n\n// Code that will not be written: panics with \"not implemented\".\n// later: format_fns\n#[effects(panic)]\npub fn unimplemented(msg: &str) -> ! {\n    let m: &str = \"not implemented\";\n    panic(m)\n}\n// ---- end mod std::panic ----\n}\n// ---- mod std::option ----\npub mod option {\n// std::option: Option<T>, Rust's API. `Some` and `None` are in the\n// prelude. What MVS's Option had is kept, with Rust's receivers; what\n// references make possible is new: `as_ref` and `as_mut` (an Option of a\n// reference into self), `take`, `insert` and `get_or_insert` (a &mut T\n// into self), and `copied` and `cloned` on an Option<&T>.\n\nuse crate::clone::Clone;\nuse crate::default::Default;\nuse crate::iter::{IntoIterator, Iterator};\nuse crate::ops::{Deref, DerefMut};\nuse crate::option::Option::{None, Some};\nuse crate::result::Result;\n\n// A value or nothing.\n// mvs: Option, Option::impl Clone, Option::impl Debug\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]\npub enum Option<T> {\n    None,\n    Some(T),\n}\n\nimpl<T> Option<T> {\n    #[effects()]\n    pub fn is_some(&self) -> bool {\n        match self {\n            Some(_) => true,\n            None => false,\n        }\n    }\n\n    // Some and f(the value).\n    // std: changed: FnOnce(T) -> bool (Rust's)\n    #[effects(F)]\n    pub fn is_some_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {\n        match self {\n            Some(x) => f(x),\n            None => false,\n        }\n    }\n\n    #[effects(T)]\n    pub fn is_none(&self) -> bool {\n        !self.is_some()\n    }\n\n    // None, or f(the value).\n    #[effects(F)]\n    pub fn is_none_or<F: FnOnce(T) -> bool>(self, f: F) -> bool {\n        match self {\n            Some(x) => f(x),\n            None => true,\n        }\n    }\n\n");
    buf_str(out, c"    // An Option of a reference to the value: look without moving it out\n    // (`if let Some(n) = opt.as_ref()`).\n    #[effects()]\n    pub fn as_ref(&self) -> Option<&T> {\n        match self {\n            Some(x) => Some(x),\n            None => None,\n        }\n    }\n\n    // An Option of a &mut to the value: change it in place.\n    #[effects()]\n    pub fn as_mut(&mut self) -> Option<&mut T> {\n        match self {\n            Some(x) => Some(x),\n            None => None,\n        }\n    }\n\n    // The value; panics with msg when None.\n    // later: format_fns\n    #[effects(T)]\n    pub fn expect(self, msg: &str) -> T {\n        self.__expect_at(msg, \"\")\n    }\n\n    // expect, called by a program: `at` is the call's `FILE:LINE:COL: `\n    // (see Result::__expect_at). Not called by programs.\n    #[effects(panic)]\n    pub fn __expect_at(self, msg: &str, at: &str) -> T {\n        match self {\n            Some(x) => x,\n            None => crate::panic::panic(\"{at}{msg}\"),\n        }\n    }\n\n    // The value; panics when None.\n    #[effects(panic, T)]\n    pub fn unwrap(self) -> T\n        requires self.is_some()\n        else \"called `Option::unwrap()` on a `None` value\"\n        {\n        match self {\n            Some(x) => x,\n            None => crate::panic::panic(\"called `Option::unwrap()` on a `None` value\"),\n        }\n    }\n\n    #[effects(T)]\n    pub fn unwrap_or(self, default: T) -> T {\n        match self {\n            Some(x) => x,\n            None => default,\n        }\n    }\n\n    // std: changed: FnOnce (MVS: Fn)\n    #[effects(F)]\n    pub fn unwrap_or_else<F: FnOnce() -> T>(self, f: F) -> T {\n        match self {\n            Some(x) => x,\n            None => f(),\n        }\n    }\n\n    // The value, or T's Default.\n    #[effects(T)]\n    pub fn unwrap_or_default(self) -> T\n        where\n            T: Default,\n    {\n        match self {\n            Some(x) => x,\n            None => T::default(),\n");
    buf_str(out, c"        }\n    }\n\n    // The value, with no check.\n    #[effects(panic, unsafe)]\n    // UNSAFE: None here is undefined.\n    // SAFETY: a contract on the caller: self is Some.\n    pub unsafe fn unwrap_unchecked(self) -> T {\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(\"unwrap_unchecked on None\"),\n        }\n    }\n\n    // std: changed: FnOnce (MVS: Fn(sink T))\n    #[effects(F, T, U)]\n    pub fn map<U, F: FnOnce(T) -> U>(self, f: F) -> Option<U> {\n        match self {\n            Some(x) => Some(f(x)),\n            None => None,\n        }\n    }\n\n    // Calls f on a reference to the value, then gives self back.\n    #[effects(F)]\n    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Option<T> {\n        if let Some(x) = &self {\n            f(x);\n        }\n        self\n    }\n\n    #[effects(F)]\n    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {\n        match self {\n            Some(x) => f(x),\n            None => default,\n        }\n    }\n\n    #[effects(D, F)]\n    pub fn map_or_else<U, D: FnOnce() -> U, F: FnOnce(T) -> U>(self, default: D, f: F) -> U {\n        match self {\n            Some(x) => f(x),\n            None => default(),\n        }\n    }\n\n    #[effects(T, E)]\n    pub fn ok_or<E>(self, err: E) -> Result<T, E> {\n        match self {\n            Some(x) => Result::Ok(x),\n            None => Result::Err(err),\n        }\n    }\n\n    #[effects(F)]\n    pub fn ok_or_else<E, F: FnOnce() -> E>(self, err: F) -> Result<T, E> {\n        match self {\n            Some(x) => Result::Ok(x),\n            None => Result::Err(err()),\n        }\n    }\n\n    // An Option of the Deref target (`Option<String<A>>` to `Option<&str>`).\n    #[effects(T)]\n    pub fn as_deref(&self) -> Option<&T::Target>\n        where\n            T: Deref,\n    {\n        match self {\n            Some(x) => Some(x.deref()),\n            None => None,\n        }\n    }\n\n    #[effects(T)]\n");
    buf_str(out, c"    pub fn as_deref_mut(&mut self) -> Option<&mut T::Target>\n        where\n            T: DerefMut,\n    {\n        match self {\n            Some(x) => Some(x.deref_mut()),\n            None => None,\n        }\n    }\n\n    // An iterator over the value: one item or none.\n    #[effects(T)]\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { inner: self.as_ref() }\n    }\n\n    #[effects(T)]\n    pub fn iter_mut(&mut self) -> IterMut<'_, T> {\n        IterMut { inner: self.as_mut() }\n    }\n\n    // None if self is None, else optb.\n    #[effects(T, U)]\n    pub fn and<U>(self, optb: Option<U>) -> Option<U> {\n        match self {\n            Some(_) => optb,\n            None => None,\n        }\n    }\n\n    // std: changed: FnOnce (MVS: Fn(sink T))\n    #[effects(F, T, U)]\n    pub fn and_then<U, F: FnOnce(T) -> Option<U>>(self, f: F) -> Option<U> {\n        match self {\n            Some(x) => f(x),\n            None => None,\n        }\n    }\n\n    // Some only when predicate holds for the value.\n    #[effects(P)]\n    pub fn filter<P: FnOnce(&T) -> bool>(self, predicate: P) -> Option<T> {\n        if let Some(x) = self {\n            if predicate(&x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n\n    #[effects(T)]\n    pub fn or(self, optb: Option<T>) -> Option<T> {\n        match self {\n            Some(x) => Some(x),\n            None => optb,\n        }\n    }\n\n    #[effects(F)]\n    pub fn or_else<F: FnOnce() -> Option<T>>(self, f: F) -> Option<T> {\n        match self {\n            Some(x) => Some(x),\n            None => f(),\n        }\n    }\n\n    // Some when exactly one of the two is.\n    #[effects(T)]\n    pub fn xor(self, optb: Option<T>) -> Option<T> {\n        match (self, optb) {\n            (Some(a), None) => Some(a),\n            (None, Some(b)) => Some(b),\n            _ => None,\n        }\n    }\n\n    // Stores value and returns a &mut to it.\n    #[effects(panic)]\n");
    buf_str(out, c"    pub fn insert(&mut self, value: T) -> &mut T {\n        *self = Some(value);\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(),\n        }\n    }\n\n    // The value, after storing value if self was None.\n    #[effects(panic, T)]\n    pub fn get_or_insert(&mut self, value: T) -> &mut T {\n        if self.is_none() {\n            *self = Some(value);\n        }\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(),\n        }\n    }\n\n    #[effects(panic, T, F)]\n    pub fn get_or_insert_with<F: FnOnce() -> T>(&mut self, f: F) -> &mut T {\n        if self.is_none() {\n            *self = Some(f());\n        }\n        match self {\n            Some(x) => x,\n            None => crate::panic::unreachable(),\n        }\n    }\n\n    // Moves the value out, leaving None.\n    #[effects(T)]\n    pub fn take(&mut self) -> Option<T> {\n        crate::mem::replace(self, None)\n    }\n\n    // take, when predicate holds for the value.\n    #[effects(T, P)]\n    pub fn take_if<P: FnOnce(&mut T) -> bool>(&mut self, predicate: P) -> Option<T> {\n        let hit = match self.as_mut() {\n            Some(x) => predicate(x),\n            None => false,\n        };\n        if hit { self.take() } else { None }\n    }\n\n    // Stores value, returning the old one.\n    #[effects(T)]\n    pub fn replace(&mut self, value: T) -> Option<T> {\n        crate::mem::replace(self, Some(value))\n    }\n\n    // Some((a, b)) when both are Some.\n    #[effects(T, U)]\n    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {\n        match (self, other) {\n            (Some(a), Some(b)) => Some((a, b)),\n            _ => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T, U> Option<(T, U)> {\n    #[effects()]\n    pub fn unzip(self) -> (Option<T>, Option<U>) {\n        match self {\n            Some((a, b)) => (Some(a), Some(b)),\n            None => (None, None),\n        }\n");
    buf_str(out, c"    }\n}\n\n// later: impl_on_instance\nimpl<T: Copy> Option<&T> {\n    // An Option of a copy of the value (`v.get(i).copied()`).\n    #[effects()]\n    pub fn copied(self) -> Option<T> {\n        match self {\n            Some(&x) => Some(x),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Clone> Option<&T> {\n    #[effects(T)]\n    pub fn cloned(self) -> Option<T> {\n        match self {\n            Some(x) => Some(x.clone()),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Copy> Option<&mut T> {\n    #[effects()]\n    pub fn copied(self) -> Option<T> {\n        match self {\n            Some(&mut x) => Some(x),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Clone> Option<&mut T> {\n    #[effects(T)]\n    pub fn cloned(self) -> Option<T> {\n        match self {\n            Some(x) => Some(x.clone()),\n            None => None,\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T, E> Option<Result<T, E>> {\n    // Some(Ok(x)) to Ok(Some(x)), and so on.\n    #[effects()]\n    pub fn transpose(self) -> Result<Option<T>, E> {\n        match self {\n            Some(Result::Ok(x)) => Result::Ok(Some(x)),\n            Some(Result::Err(e)) => Result::Err(e),\n            None => Result::Ok(None),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T> Option<Option<T>> {\n    #[effects()]\n    pub fn flatten(self) -> Option<T> {\n        match self {\n            Some(x) => x,\n            None => None,\n        }\n    }\n}\n\nimpl<T> Default for Option<T> {\n    fn default() -> Option<T> {\n        None\n    }\n}\n\nimpl<T> From<T> for Option<T> {\n    fn from(value: T) -> Option<T> {\n        Some(value)\n    }\n}\n\n// The iterator of a &Option<T>: its value, once.\npub struct Iter<'a, T> {\n    inner: Option<&'a T>,\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n");
    buf_str(out, c"        self.inner.take()\n    }\n}\n\n// The iterator of a &mut Option<T>.\npub struct IterMut<'a, T> {\n    inner: Option<&'a mut T>,\n}\n\nimpl<'a, T> Iterator for IterMut<'a, T> {\n    type Item = &'a mut T;\n\n    fn next(&mut self) -> Option<&'a mut T> {\n        self.inner.take()\n    }\n}\n\n// The iterator of an Option<T>, by value.\npub struct IntoIter<T> {\n    inner: Option<T>,\n}\n\nimpl<T> Iterator for IntoIter<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.take()\n    }\n}\n\nimpl<T> IntoIterator for Option<T> {\n    type Item = T;\n    type IntoIter = IntoIter<T>;\n\n    fn into_iter(self) -> IntoIter<T> {\n        IntoIter { inner: self }\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a Option<T> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a mut Option<T> {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n// ---- end mod std::option ----\n}\n// ---- mod std::result ----\npub mod result {\n// std::result: Result<T, E>, Rust's API. `Ok` and `Err` are in the\n// prelude; `?` returns the Err early, converted through From (plan §3).\n// One change from MVS beyond the receivers: `unwrap` needs `E: Debug`\n// and shows the error (into the panic's fixed buffer); an E that is not\n// Debug unwraps as `.ok().unwrap()` (the rewrite table says so).\n\nuse crate::clone::Clone;\nuse crate::default::Default;\nuse crate::fmt::Debug;\nuse crate::iter::IntoIterator;\nuse crate::ops::Deref;\nuse crate::option::Option;\nuse crate::result::Result::{Err, Ok};\n\n// A value or an error.\n// mvs: Result, Result::impl Clone, Result::impl Debug\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]\npub enum Result<T, E> {\n    Ok(T),\n    Err(E),\n}\n\nimpl<T, E> Result<T, E> {\n    #[effects()]\n");
    buf_str(out, c"    pub fn is_ok(&self) -> bool {\n        match self {\n            Ok(_) => true,\n            Err(_) => false,\n        }\n    }\n\n    #[effects(F)]\n    pub fn is_ok_and<F: FnOnce(T) -> bool>(self, f: F) -> bool {\n        match self {\n            Ok(x) => f(x),\n            Err(_) => false,\n        }\n    }\n\n    #[effects(T, E)]\n    pub fn is_err(&self) -> bool {\n        !self.is_ok()\n    }\n\n    #[effects(F)]\n    pub fn is_err_and<F: FnOnce(E) -> bool>(self, f: F) -> bool {\n        match self {\n            Ok(_) => false,\n            Err(e) => f(e),\n        }\n    }\n\n    // The value as Some, the error dropped.\n    #[effects(T, E)]\n    pub fn ok(self) -> Option<T> {\n        match self {\n            Ok(x) => Option::Some(x),\n            Err(_) => Option::None,\n        }\n    }\n\n    #[effects(T, E)]\n    pub fn err(self) -> Option<E> {\n        match self {\n            Ok(_) => Option::None,\n            Err(e) => Option::Some(e),\n        }\n    }\n\n    // A Result of references into self.\n    #[effects()]\n    pub fn as_ref(&self) -> Result<&T, &E> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    #[effects()]\n    pub fn as_mut(&mut self) -> Result<&mut T, &mut E> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    #[effects(T)]\n    pub fn as_deref(&self) -> Result<&T::Target, &E>\n        where\n            T: Deref,\n    {\n        match self {\n            Ok(x) => Ok(x.deref()),\n            Err(e) => Err(e),\n        }\n    }\n\n    // std: changed: FnOnce (MVS: Fn(sink T))\n    #[effects(F)]\n    pub fn map<U, F: FnOnce(T) -> U>(self, op: F) -> Result<U, E> {\n        match self {\n            Ok(x) => Ok(op(x)),\n            Err(e) => Err(e),\n        }\n    }\n\n    #[effects(F)]\n    pub fn map_or<U, F: FnOnce(T) -> U>(self, default: U, f: F) -> U {\n        match self {\n            Ok(x) => f(x),\n");
    buf_str(out, c"            Err(_) => default,\n        }\n    }\n\n    #[effects(D, F)]\n    pub fn map_or_else<U, D: FnOnce(E) -> U, F: FnOnce(T) -> U>(self, default: D, f: F) -> U {\n        match self {\n            Ok(x) => f(x),\n            Err(e) => default(e),\n        }\n    }\n\n    // std: changed: FnOnce (MVS: Fn(sink E))\n    #[effects(O, T, E, F2)]\n    pub fn map_err<F2, O: FnOnce(E) -> F2>(self, op: O) -> Result<T, F2> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(op(e)),\n        }\n    }\n\n    #[effects(F)]\n    pub fn inspect<F: FnOnce(&T)>(self, f: F) -> Result<T, E> {\n        if let Ok(x) = &self {\n            f(x);\n        }\n        self\n    }\n\n    #[effects(F)]\n    pub fn inspect_err<F: FnOnce(&E)>(self, f: F) -> Result<T, E> {\n        if let Err(e) = &self {\n            f(e);\n        }\n        self\n    }\n\n    // An iterator over the value: one item, or none for an Err.\n    #[effects(T, E)]\n    pub fn iter(&self) -> crate::option::IntoIter<&T> {\n        self.as_ref().ok().into_iter()\n    }\n\n    // The value; panics with msg and the error when Err.\n    // later: format_fns\n    #[effects(T, E)]\n    pub fn expect(self, msg: &str) -> T\n        where\n            E: Debug,\n    {\n        self.__expect_at(msg, \"\")\n    }\n\n    // expect, called by a program: `at` is the call's `FILE:LINE:COL: `,\n    // which the compiler writes (front/contracts/desugar.vl place_call), so\n    // that the panic names the caller and shows the error. Not called by\n    // programs; so are the three `_at` below.\n    #[effects(panic)]\n    pub fn __expect_at(self, msg: &str, at: &str) -> T\n        where\n            E: Debug,\n    {\n        match self {\n            Ok(x) => x,\n            Err(e) => crate::panic::panic(\"{at}{msg}: {e:?}\"),\n        }\n    }\n\n    // The value; panics with the error when Err.\n    // std: changed: needs E: Debug and shows it\n    // later: format_fns\n    #[effects(T, E)]\n");
    buf_str(out, c"    pub fn unwrap(self) -> T\n        where\n            E: Debug,\n    {\n        self.__unwrap_at(\"\")\n    }\n\n    #[effects(panic)]\n    pub fn __unwrap_at(self, at: &str) -> T\n        where\n            E: Debug,\n    {\n        match self {\n            Ok(x) => x,\n            Err(e) => crate::panic::panic(\"{at}called `Result::unwrap()` on an `Err` value: {e:?}\"),\n        }\n    }\n\n    #[effects(T)]\n    pub fn unwrap_or_default(self) -> T\n        where\n            T: Default,\n    {\n        match self {\n            Ok(x) => x,\n            Err(_) => T::default(),\n        }\n    }\n\n    // later: format_fns\n    #[effects(T, E)]\n    pub fn expect_err(self, msg: &str) -> E\n        where\n            T: Debug,\n    {\n        self.__expect_err_at(msg, \"\")\n    }\n\n    #[effects(panic)]\n    pub fn __expect_err_at(self, msg: &str, at: &str) -> E\n        where\n            T: Debug,\n    {\n        match self {\n            Ok(x) => crate::panic::panic(\"{at}{msg}: {x:?}\"),\n            Err(e) => e,\n        }\n    }\n\n    // later: format_fns\n    #[effects(T, E)]\n    pub fn unwrap_err(self) -> E\n        where\n            T: Debug,\n    {\n        self.__unwrap_err_at(\"\")\n    }\n\n    #[effects(panic)]\n    pub fn __unwrap_err_at(self, at: &str) -> E\n        where\n            T: Debug,\n    {\n        match self {\n            Ok(x) => crate::panic::panic(\n                \"{at}called `Result::unwrap_err()` on an `Ok` value: {x:?}\"),\n            Err(e) => e,\n        }\n    }\n\n    #[effects(T, E, U)]\n    pub fn and<U>(self, res: Result<U, E>) -> Result<U, E> {\n        match self {\n            Ok(_) => res,\n            Err(e) => Err(e),\n        }\n    }\n\n    #[effects(F, T, E, U)]\n    pub fn and_then<U, F: FnOnce(T) -> Result<U, E>>(self, op: F) -> Result<U, E> {\n        match self {\n            Ok(x) => op(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    #[effects(T, E, F2)]\n");
    buf_str(out, c"    pub fn or<F2>(self, res: Result<T, F2>) -> Result<T, F2> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(_) => res,\n        }\n    }\n\n    #[effects(O)]\n    pub fn or_else<F2, O: FnOnce(E) -> Result<T, F2>>(self, op: O) -> Result<T, F2> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => op(e),\n        }\n    }\n\n    #[effects(T, E)]\n    pub fn unwrap_or(self, default: T) -> T {\n        match self {\n            Ok(x) => x,\n            Err(_) => default,\n        }\n    }\n\n    // std: changed: FnOnce (MVS: Fn(sink E))\n    #[effects(F)]\n    pub fn unwrap_or_else<F: FnOnce(E) -> T>(self, op: F) -> T {\n        match self {\n            Ok(x) => x,\n            Err(e) => op(e),\n        }\n    }\n\n    #[effects(panic, unsafe)]\n    // UNSAFE: an Err here is undefined.\n    // SAFETY: a contract on the caller: self is Ok.\n    pub unsafe fn unwrap_unchecked(self) -> T {\n        match self {\n            Ok(x) => x,\n            Err(_) => crate::panic::unreachable(\"unwrap_unchecked on Err\"),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Copy, E> Result<&T, E> {\n    #[effects()]\n    pub fn copied(self) -> Result<T, E> {\n        match self {\n            Ok(&x) => Ok(x),\n            Err(e) => Err(e),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T: Clone, E> Result<&T, E> {\n    #[effects(T)]\n    pub fn cloned(self) -> Result<T, E> {\n        match self {\n            Ok(x) => Ok(x.clone()),\n            Err(e) => Err(e),\n        }\n    }\n}\n\n// later: impl_on_instance\nimpl<T, E> Result<Option<T>, E> {\n    // Ok(Some(x)) to Some(Ok(x)), and so on.\n    #[effects()]\n    pub fn transpose(self) -> Option<Result<T, E>> {\n        match self {\n            Ok(Option::Some(x)) => Option::Some(Ok(x)),\n            Ok(Option::None) => Option::None,\n            Err(e) => Option::Some(Err(e)),\n        }\n    }\n}\n\nimpl<T, E> IntoIterator for Result<T, E> {\n    type Item = T;\n");
    buf_str(out, c"    type IntoIter = crate::option::IntoIter<T>;\n\n    fn into_iter(self) -> crate::option::IntoIter<T> {\n        self.ok().into_iter()\n    }\n}\n// ---- end mod std::result ----\n}\n// ---- mod std::alloc ----\npub mod alloc {\n// std::alloc: Allocator, Layout, Gpa, and the arenas (plan §2, §2.1,\n// §9.1). Allocation is a capability: a function allocates only through an\n// allocator reachable from its parameters, a type that holds one has it\n// among its parameters (`Vec<T, A>`, `Parser<'s, A>`), and nothing makes\n// one from nothing: Gpa has no public constructor (main receives it),\n// every arena is made from a parent allocator or over memory it is lent,\n// and a static's type may not hold an allocator (the compiler's\n// AllocFree marker). Allocators compose as Zig's do: an Arena over a\n// FixedBuf allocates no heap at all, an arena over an arena frees per\n// request, a scope gives back what it took while older containers stay.\n// AnyAlloc<'a> erases an allocator's type (no dyn: a struct of function\n// pointers), so a library taking `a: AnyAlloc<'_>` is compiled once.\n\nuse crate::cell::Cell;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::IntoIterator;\nuse crate::marker::{Copy, PhantomData};\nuse crate::ops::Drop;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// A block's size and alignment (a power of two), in bytes.\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub struct Layout {\n    size: usize,\n    align: usize,\n}\n\nimpl Layout {\n    // A T's layout.\n    #[effects()]\n    pub fn new<T>() -> Layout {\n        Layout { size: crate::mem::size_of::<T>(), align: crate::mem::align_of::<T>() }\n    }\n\n    // n T's; LayoutError when the size overflows.\n    #[effects(T)]\n    pub fn array<T>(n: usize) -> Result<Layout, LayoutError> {\n        match crate::mem::size_of::<T>().checked_mul(n) {\n");
    buf_str(out, c"            crate::option::Option::Some(size) => Layout::from_size_align(size,\n                crate::mem::align_of::<T>()),\n            crate::option::Option::None => Result::Err(LayoutError {}),\n        }\n    }\n\n    // LayoutError when align is not a power of two or size overflows\n    // when rounded up to it.\n    #[effects()]\n    pub fn from_size_align(size: usize, align: usize) -> Result<Layout, LayoutError> {\n        if align == 0 || align & (align - 1) != 0 {\n            return Result::Err(LayoutError {});\n        }\n        // Rust's bound: rounded up to align, the size fits in an isize.\n        if size > (isize::MAX as usize) - (align - 1) {\n            return Result::Err(LayoutError {});\n        }\n        Result::Ok(Layout { size: size, align: align })\n    }\n\n    #[effects()]\n    pub fn size(&self) -> usize {\n        self.size\n    }\n\n    #[effects()]\n    pub fn align(&self) -> usize {\n        self.align\n    }\n}\n\n// A layout that cannot be.\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct LayoutError;\n\n// An allocator out of memory (or over its limit).\n// mvs: AllocError, AllocError::impl Debug\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct AllocError;\n\n// mvs: AllocError::impl Display\nimpl Display for AllocError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"memory allocation failed\")\n    }\n}\n\n// Why try_reserve failed: the capacity overflowed, or the allocator.\n// (Rust has it at std::collections: re-exported there)\n#[derive(Clone, PartialEq, Eq, Debug)]\npub enum TryReserveError {\n    CapacityOverflow,\n    AllocError { layout: Layout },\n}\n\n// What gives out blocks of memory: Rust's allocator_api shape, `&self`\n// (so `&'a Arena<P>` is one, through the impl for &A), with a thin\n// pointer (`NonNull<u8>`, not `NonNull<[u8]>`: no fat raw pointers) and\n// FREES. An `unsafe trait`: every impl is `unsafe impl` with a SAFETY\n");
    buf_str(out, c"// comment naming where its memory comes from (plan §2.0 rule 1).\n// std: changed: Rust's shape over &self and a Layout (MVS: try_alloc,\n// try_resize, free over *Self and i64 sizes)\n// UNSAFE: an impl promises its blocks are valid, aligned and its own,\n// which no type checks.\n// SAFETY: each impl states where its memory comes from (rule 1).\npub unsafe trait Allocator {\n    // Whether deallocate gives memory back. False for the arenas and\n    // FixedBuf, whose memory comes back all at once; a container on such\n    // an allocator needs dropping only if its elements do (plan §9.1:\n    // `needs_drop::<Vec<T, A>>() == needs_drop::<T>()` when !A::FREES).\n    const FREES: bool = true;\n\n    // A block for layout, or AllocError.\n    // mvs: Allocator::try_alloc, Allocator::alloc\n    // std: changed: a Layout, a Result (MVS: a size and align, null or a panic)\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError>;\n\n    // The same, its bytes zero.\n    fn allocate_zeroed(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        let p = self.allocate(layout)?;\n        let b = p.as_ptr();\n        let mut i: usize = 0;\n        while i < layout.size() {\n            // UNSAFE: the block is zeroed through its raw pointer.\n            // SAFETY: allocate gave a block of layout.size() bytes; i is in it.\n            unsafe {\n                *b.add(i) = 0;\n            }\n            i += 1;\n        }\n        Result::Ok(p)\n    }\n\n    // Gives a block back.\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, as Rust's Allocator::deallocate.\n    // mvs: Allocator::free\n    // std: changed: a NonNull and a Layout (MVS: free(p, size, align))\n    // (0.28.0: MVS's Allocator::free's list, `global` spelled `static`)\n    #[effects(alloc, static, panic, diverge, unsafe)]\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout);\n\n");
    buf_str(out, c"    // The block made larger (moved if it must), its contents kept.\n    // UNSAFE: p must be a block of this allocator's, with layout old;\n    // new.size() >= old.size().\n    // SAFETY: a contract on the caller, as Rust's Allocator::grow.\n    // mvs: Allocator::try_resize, Allocator::resize\n    // std: changed: two Layouts, a Result\n    unsafe fn grow(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        let q = self.allocate(new)?;\n        // UNSAFE: the old block's bytes copied into the new one, the old\n        // given back.\n        // SAFETY: the caller's contract: p is this allocator's block with\n        // layout old, and new.size() >= old.size(), so old.size() bytes fit\n        // in q, a fresh block that does not overlap p.\n        unsafe {\n            crate::ptr::copy_nonoverlapping(p.as_ptr() as *const u8, q.as_ptr(), old.size());\n            self.deallocate(p, old);\n        }\n        Result::Ok(q)\n    }\n\n    // grow, the new bytes zero.\n    // UNSAFE: as grow.\n    // SAFETY: a contract on the caller, as grow's.\n    unsafe fn grow_zeroed(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        let q = self.allocate_zeroed(new)?;\n        // UNSAFE: as grow, over a zeroed block.\n        // SAFETY: as grow's: old.size() bytes fit in q, which is fresh; the\n        // bytes after them stay zero.\n        unsafe {\n            crate::ptr::copy_nonoverlapping(p.as_ptr() as *const u8, q.as_ptr(), old.size());\n            self.deallocate(p, old);\n        }\n        Result::Ok(q)\n    }\n\n    // The block made smaller.\n    // UNSAFE: p must be a block of this allocator's, with layout old;\n    // new.size() <= old.size().\n    // SAFETY: a contract on the caller, as Rust's Allocator::shrink.\n    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n");
    buf_str(out, c"        let q = self.allocate(new)?;\n        // UNSAFE: the first new.size() bytes copied into a smaller block, the\n        // old given back.\n        // SAFETY: the caller's contract: p is this allocator's block with\n        // layout old and new.size() <= old.size(); q is fresh and holds\n        // new.size() bytes.\n        unsafe {\n            crate::ptr::copy_nonoverlapping(p.as_ptr() as *const u8, q.as_ptr(), new.size());\n            self.deallocate(p, old);\n        }\n        Result::Ok(q)\n    }\n\n    // The allocator borrowed (a container on `&A` instead of moving A in).\n    fn by_ref(&self) -> &Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n\n    // The allocator with its type erased: an AnyAlloc of it (plan §2.1).\n    fn erase(&self) -> AnyAlloc<'_>\n        where\n            Self: Sized,\n    {\n        AnyAlloc::new(self)\n    }\n}\n\n// A reference to an allocator is one: containers hold `&'a Arena<P>`.\n// UNSAFE: an Allocator impl.\n// SAFETY: every block comes from *self, the referenced allocator, and goes\n// back to it; FREES is its FREES.\nunsafe impl<A: Allocator + ?Sized> Allocator for &A {\n    const FREES: bool = A::FREES;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        (**self).allocate(layout)\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, the trait's own for deallocate.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        // UNSAFE: deallocate's own contract.\n        // SAFETY: passed through: the caller's p and layout are A's.\n        unsafe { (**self).deallocate(p, layout) }\n    }\n}\n\n// The general-purpose heap (C's malloc): zero-sized and Copy, with no\n// public constructor. The runtime makes one and `main` receives it\n// (`fn main(gpa: Gpa)`), so a function can allocate from it only when\n");
    buf_str(out, c"// it is handed one (plan §2.0 rule 1). With --check-alloc it is the\n// checking allocator (leaks, double frees, use after free).\n#[derive(Clone, Copy)]\npub struct Gpa {\n    sealed: (),\n}\n\nimpl Gpa {\n    // Blocks given out and not freed yet (with --check-alloc; else 0).\n    // std: changed: usize\n    #[effects(static, sync, diverge)]\n    pub fn live_blocks(&self) -> usize {\n        // (Z5: std::__gpa is the compiler's tail: rt/gpa.vl, or with\n        // --check-alloc the checking allocator, rt/alloc_check.vl)\n        crate::__gpa::live_blocks()\n    }\n\n    // Whether every block was freed (with --check-alloc, which lists the\n    // live ones on stderr; else true).\n    #[effects(static, sync, panic, diverge)]\n    pub fn check_leaks(&self) -> bool {\n        crate::__gpa::check_leaks()\n    }\n}\n\n// UNSAFE: an Allocator impl over C's heap (or the checking allocator's\n// pages).\n// SAFETY: blocks come from std::__gpa (malloc, posix_memalign above 16;\n// with --check-alloc, pages of their own) and go back to it; FREES true.\nunsafe impl Allocator for Gpa {\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        crate::__gpa::allocate(layout)\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, the trait's own for deallocate.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        // UNSAFE: deallocate's own contract.\n        // SAFETY: passed through: the caller's p and layout are this Gpa's.\n        unsafe { crate::__gpa::deallocate(p, layout) }\n    }\n}\n\n// ---- Arenas ----\n\n// A chunk's header: the previous chunk (0 for the first) and the chunk's\n// size in bytes, two words at its start; the bump region follows.\nconst CHUNK_HEADER: usize = 16;\n// The smallest chunk an arena takes from its parent.\nconst CHUNK_MIN: usize = 4096;\n// Every chunk's alignment (the header's, and malloc's).\n");
    buf_str(out, c"const CHUNK_ALIGN: usize = 16;\n\n// x rounded up to align, a power of two.\nfn round_up(x: usize, align: usize) -> usize {\n    (x + align - 1) / align * align\n}\n\n// Out of memory where the API has no Result: Rust's handle_alloc_error.\nfn out_of_memory() -> ! {\n    let msg: &str = \"memory allocation failed\";\n    crate::panic::panic(msg)\n}\n\n// The chunk list and bump pointer of an arena or a scope: chunk is the\n// newest chunk (null before the first), at and end the addresses its\n// free room spans. Cells: Allocator::allocate takes &self.\nstruct Chunks {\n    chunk: Cell<*mut u8>,\n    at: Cell<usize>,\n    end: Cell<usize>,\n    used: Cell<usize>,\n    allocated: Cell<usize>,\n}\n\nimpl Chunks {\n    fn new() -> Chunks {\n        Chunks {\n            chunk: Cell::new(crate::ptr::null_mut()),\n            at: Cell::new(0),\n            end: Cell::new(0),\n            used: Cell::new(0),\n            allocated: Cell::new(0),\n        }\n    }\n\n    // A new chunk from parent with room for bytes, made the newest.\n    // (0.30: cold, out of line: `bump` without it is small enough to be\n    // inlined where an arena allocates, as bench/arena_trees.c's\n    // arena_alloc is with its refill)\n    #[cold]\n    fn add<P: Allocator>(&self, parent: &P, bytes: usize) -> Result<(), AllocError> {\n        let size = round_up(crate::cmp::max(CHUNK_MIN, bytes + CHUNK_HEADER), CHUNK_ALIGN);\n        let p = parent.allocate(Layout { size: size, align: CHUNK_ALIGN })?.as_ptr();\n        let h = p as *mut usize;\n        // UNSAFE: the header is written through the chunk's raw pointer.\n        // SAFETY: p is a fresh block of size >= CHUNK_HEADER bytes, aligned\n        // to 16, so its first two words are in it and aligned.\n        unsafe {\n            *h = self.chunk.get() as usize;\n            *h.add(1) = size;\n        }\n        self.chunk.set(p);\n        self.at.set(p as usize + CHUNK_HEADER);\n        self.end.set(p as usize + size);\n");
    buf_str(out, c"        self.allocated.set(self.allocated.get() + size);\n        Result::Ok(())\n    }\n\n    // A block for layout, bumped from the newest chunk (a new one when it\n    // has no room).\n    fn bump<P: Allocator>(&self, parent: &P, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        let start = round_up(self.at.get(), layout.align());\n        if self.chunk.get().is_null() || start + layout.size() > self.end.get() {\n            self.add(parent, layout.size() + layout.align())?;\n            return self.bump(parent, layout);\n        }\n        self.at.set(start + layout.size());\n        self.used.set(self.used.get() + layout.size());\n        // (an address made a pointer: start..start + size is inside the\n        // newest chunk, a block of the parent's that this list owns)\n        match NonNull::new(start as *mut u8) {\n            crate::option::Option::Some(p) => Result::Ok(p),\n            crate::option::Option::None => Result::Err(AllocError {}),\n        }\n    }\n\n    // Every chunk but the oldest given back to parent, the oldest's room\n    // made free; with keep_first false, every chunk given back.\n    fn release<P: Allocator>(&self, parent: &P, keep_first: bool) {\n        let mut p = self.chunk.get();\n        while !p.is_null() {\n            let h = p as *mut usize;\n            // UNSAFE: the header is read through the chunk's raw pointer.\n            // SAFETY: every chunk on the list was made by add, which wrote\n            // its header; it has not been given back yet.\n            let (prev, size) = unsafe { (*h as *mut u8, *h.add(1)) };\n            // (a first chunk made for one large block goes back too: reset\n            // keeps a standard chunk's room, not a burst's)\n            if keep_first && prev.is_null() && size <= CHUNK_MIN {\n                self.chunk.set(p);\n                self.at.set(p as usize + CHUNK_HEADER);\n                self.end.set(p as usize + size);\n                self.used.set(0);\n");
    buf_str(out, c"                self.allocated.set(size);\n                return;\n            }\n            if let crate::option::Option::Some(nn) = NonNull::new(p) {\n                // UNSAFE: the chunk goes back to the allocator it came from.\n                // SAFETY: add allocated it from parent with this layout, and\n                // nothing borrows it: the caller holds the arena or scope by\n                // &mut or is dropping it.\n                unsafe { parent.deallocate(nn, Layout { size: size, align: CHUNK_ALIGN }) };\n            }\n            p = prev;\n        }\n        self.chunk.set(crate::ptr::null_mut());\n        self.at.set(0);\n        self.end.set(0);\n        self.used.set(0);\n        self.allocated.set(0);\n    }\n}\n\n// x moved into a fresh block of a (the arenas' alloc).\nfn alloc_in<T, A: Allocator>(a: &A, x: T) -> &mut T {\n    let p = match a.allocate(Layout::new::<T>()) {\n        Result::Ok(p) => p.as_ptr() as *mut T,\n        Result::Err(_) => out_of_memory(),\n    };\n    // UNSAFE: x is moved into the block through a raw pointer.\n    // SAFETY: p is a fresh block of T's layout from a, valid for as long as\n    // a is borrowed (an arena's blocks live until it is reset or dropped).\n    unsafe {\n        crate::ptr::write(p, x);\n        &mut *p\n    }\n}\n\n// A copy of s in a fresh block of a.\nfn alloc_slice_copy_in<'a, T: Copy, A: Allocator>(a: &'a A, s: &[T]) -> &'a mut [T] {\n    let n = s.len();\n    let layout = match Layout::array::<T>(n) {\n        Result::Ok(l) => l,\n        Result::Err(_) => out_of_memory(),\n    };\n    let p = match a.allocate(layout) {\n        Result::Ok(p) => p.as_ptr() as *mut T,\n        Result::Err(_) => out_of_memory(),\n    };\n    // UNSAFE: s is copied into the block, which is then lent as a slice.\n    // SAFETY: the block holds n T's and is fresh, so it does not overlap s;\n    // T is Copy, so the copies are values of their own.\n    unsafe {\n");
    buf_str(out, c"        crate::ptr::copy_nonoverlapping(s.as_ptr(), p, n);\n        crate::slice::from_raw_parts_mut(p, n)\n    }\n}\n\n// A copy of s in a fresh block of a.\nfn alloc_str_in<'a, A: Allocator>(a: &'a A, s: &str) -> &'a mut str {\n    let bytes = alloc_slice_copy_in(a, s.as_bytes());\n    // UNSAFE: a &mut [u8] cast to a &mut str.\n    // SAFETY: the bytes are a copy of a str's, so UTF-8.\n    unsafe { &mut *(bytes as *mut [u8] as *mut str) }\n}\n\n// A bump allocator over chunks taken from its parent P (Zig's\n// ArenaAllocator.init(child)): allocation is a pointer bump, and nothing\n// is freed one block at a time. Containers allocate through\n// `&'a Arena<P>`, which ties them to the arena; `reset(&mut self)` gives\n// every chunk's room back for reuse, safe because the exclusive borrow\n// proves nothing in the arena is live; dropping the arena gives the\n// chunks back to P. Its bump pointer is a Cell: Allocator::allocate takes\n// &self (plan §2.1).\n// mvs: Arena\n// std: changed: generic over its parent P, which it owns (MVS: a copyable handle over a Gpa)\npub struct Arena<P: Allocator> {\n    parent: P,\n    chunks: Chunks,\n}\n\n// UNSAFE: an arena's chunks are raw pointers in Cells: stated (AT2).\n// SAFETY: an Arena owns its chunks and its parent allocator, and every\n// block it hands out is freed with it: moving it moves all of them (P:\n// Send).\nunsafe impl<P: Allocator + Send> Send for Arena<P> {}\n// An arena allocates through `&self` with no lock: never Sync, so `&Arena`\n// is neither Send nor Sync (a thread allocates from its own arena).\nimpl<P: Allocator> !Sync for Arena<P> {}\n\nimpl<P: Allocator> Arena<P> {\n    // An empty arena over parent; its first chunk comes with its first\n    // allocation.\n    // std: changed: any parent P (MVS: a Gpa)\n    #[effects()]\n    pub fn new_in(parent: P) -> Arena<P> {\n        Arena { parent: parent, chunks: Chunks::new() }\n    }\n\n    // An arena whose first chunk holds bytes.\n");
    buf_str(out, c"    // std: changed: usize, any parent P\n    #[effects(panic, P)]\n    pub fn with_capacity_in(bytes: usize, parent: P) -> Arena<P> {\n        let a = Arena::new_in(parent);\n        if a.chunks.add(&a.parent, bytes).is_err() {\n            out_of_memory();\n        }\n        a\n    }\n\n    // The bytes given out since it was made or reset.\n    // std: changed: usize\n    #[effects()]\n    pub fn used(&self) -> usize {\n        self.chunks.used.get()\n    }\n\n    // The bytes it holds from its parent, used or not.\n    // mvs: Arena::chunk_bytes\n    // std: renamed\n    #[effects()]\n    pub fn allocated_bytes(&self) -> usize {\n        self.chunks.allocated.get()\n    }\n\n    #[effects()]\n    pub fn parent(&self) -> &P {\n        &self.parent\n    }\n\n    // Every chunk's room back for reuse (the first chunk kept when it is\n    // a standard one, the others given back to P). Safe: `&mut self` proves no container, &T or &str\n    // in the arena is live.\n    // std: changed: safe, &mut self (MVS: unsafe, through a raw pointer)\n    #[effects(P)]\n    pub fn reset(&mut self) {\n        self.chunks.release(&self.parent, true)\n    }\n\n    // x moved into the arena; a &mut to it for as long as the arena is\n    // borrowed. T must have no drop glue (`needs_drop::<T>()` false,\n    // checked at compile time): the arena never runs drops. A T holding a\n    // Vec on this arena qualifies (FREES false: plan §9.1); for drops, a\n    // TypedArena.\n    #[effects(P, T)]\n    pub fn alloc<T>(&self, x: T) -> &mut T {\n        alloc_in(self, x)\n    }\n\n    // A copy of s in the arena.\n    #[effects(P, T)]\n    pub fn alloc_slice_copy<T: Copy>(&self, s: &[T]) -> &mut [T] {\n        alloc_slice_copy_in(self, s)\n    }\n\n    // n values f(0), f(1), ... in the arena (no drop glue, as alloc).\n    #[effects(panic, unsafe, P, T, F)]\n    pub fn alloc_slice_fill_with<T, F: FnMut(usize) -> T>(&self, n: usize, f: F) -> &mut [T] {\n        let mut f = f;\n");
    buf_str(out, c"        let layout = match Layout::array::<T>(n) {\n            Result::Ok(l) => l,\n            Result::Err(_) => out_of_memory(),\n        };\n        let p = match self.allocate(layout) {\n            Result::Ok(p) => p.as_ptr() as *mut T,\n            Result::Err(_) => out_of_memory(),\n        };\n        let mut i: usize = 0;\n        while i < n {\n            // UNSAFE: each value is written into the block through a raw\n            // pointer (a raw store: nothing was there to drop).\n            // SAFETY: the block holds n T's and i < n.\n            unsafe {\n                crate::ptr::write(p.add(i), f(i));\n            }\n            i += 1;\n        }\n        // UNSAFE: the block lent as a slice.\n        // SAFETY: its n T's are written above; the block lives as long as\n        // the arena's borrow.\n        unsafe { crate::slice::from_raw_parts_mut(p, n) }\n    }\n\n    // A copy of s in the arena.\n    #[effects(P)]\n    pub fn alloc_str(&self, s: &str) -> &mut str {\n        alloc_str_in(self, s)\n    }\n\n    // Runs f with a scope of the arena: what f allocates in the scope is\n    // given back when f returns, while containers made before stay live\n    // (the scratch checkpoint). The scope's region is late-bound, so\n    // nothing allocated in it can leave f (`#[scoped]` is no longer\n    // needed); R cannot name it.\n    // std: changed: FnOnce(&ArenaScope<'_, P>) (MVS: FnMut(ScopedArena))\n    #[effects(P, R, F)]\n    pub fn scope<R, F: FnOnce(&ArenaScope<'_, P>) -> R>(&self, f: F) -> R {\n        let s = ArenaScope { home: self, chunks: Chunks::new(), region: PhantomData {} };\n        f(&s)\n    }\n}\n\n// UNSAFE: an Allocator impl over the arena's chunks.\n// SAFETY: blocks are bumped from chunks taken from P and live until the\n// arena is reset (which needs &mut, so no block is borrowed) or dropped;\n// deallocate does nothing (FREES false).\n// mvs: Arena::impl Allocator\nunsafe impl<P: Allocator> Allocator for Arena<P> {\n");
    buf_str(out, c"    const FREES: bool = false;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        self.chunks.bump(&self.parent, layout)\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, the trait's own for deallocate.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}\n}\n\n// Gives every chunk back to P (MVS's free_all).\nimpl<P: Allocator> Drop for Arena<P> {\n    fn drop(&mut self) {\n        self.chunks.release(&self.parent, false)\n    }\n}\n\n// A scope of an arena (Arena::scope) or of any parent (arena_scope): an\n// allocator whose blocks are all given back when the scope ends. 's is\n// the scope's region, invariant, so a container on `&'s ArenaScope<'s,\n// P>` cannot outlive it. Its chunks come from the arena's parent.\n// mvs: ScopedArena\n// std: renamed\npub struct ArenaScope<'s, P: Allocator> {\n    home: &'s Arena<P>,\n    chunks: Chunks,\n    region: PhantomData<Cell<&'s ()>>,\n}\n\nimpl<'s, P: Allocator> ArenaScope<'s, P> {\n    // The bytes given out in this scope.\n    // mvs: ScopedArena::used\n    // std: changed: usize\n    #[effects()]\n    pub fn used(&self) -> usize {\n        self.chunks.used.get()\n    }\n\n    // As Arena::alloc, in the scope.\n    #[effects(P, T)]\n    pub fn alloc<T>(&self, x: T) -> &mut T {\n        alloc_in(self, x)\n    }\n\n    #[effects(P, T)]\n    pub fn alloc_slice_copy<T: Copy>(&self, s: &[T]) -> &mut [T] {\n        alloc_slice_copy_in(self, s)\n    }\n\n    #[effects(P)]\n    pub fn alloc_str(&self, s: &str) -> &mut str {\n        alloc_str_in(self, s)\n    }\n\n    // A scope inside this one.\n    // mvs: ScopedArena::scope\n    // std: changed: FnOnce(&ArenaScope<'_, P>)\n    #[effects(P, R, F)]\n    pub fn scope<R, F: FnOnce(&ArenaScope<'_, P>) -> R>(&self, f: F) -> R {\n        let s = ArenaScope { home: self.home, chunks: Chunks::new(), region: PhantomData {} };\n        f(&s)\n    }\n}\n\n");
    buf_str(out, c"// UNSAFE: an Allocator impl over the scope's chunks.\n// SAFETY: blocks are bumped from chunks the scope took from its arena's\n// parent; they are given back when the scope ends, and the scope's region\n// keeps every block's borrow inside it; FREES false.\n// mvs: ScopedArena::impl Allocator\nunsafe impl<'s, P: Allocator> Allocator for ArenaScope<'s, P> {\n    const FREES: bool = false;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        self.chunks.bump(&self.home.parent, layout)\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, the trait's own for deallocate.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}\n}\n\nimpl<'s, P: Allocator> Drop for ArenaScope<'s, P> {\n    fn drop(&mut self) {\n        self.chunks.release(&self.home.parent, false)\n    }\n}\n\n// Runs f with a scope over parent (an arena made for the call): what f\n// allocates is freed when it returns. Over any allocator, a Gpa as much\n// as an arena or a FixedBuf.\n// std: changed: any parent, by reference; FnOnce(&ArenaScope<'_, &P>) (MVS: a Gpa, FnMut(ScopedArena))\n#[effects(P, R, F)]\npub fn arena_scope<'p, P: Allocator, R,\n    F: FnOnce(&ArenaScope<'_, &'p P>) -> R>(parent: &'p P, f: F) -> R {\n    let arena = Arena::new_in(parent);\n    arena.scope(f)\n}\n\n// An arena of T's that runs their drops at its own drop: for T's with\n// drop glue (Arena::alloc refuses those). Its chunks come from P; each\n// begins with a header of three words (the previous chunk, its capacity\n// in T's, how many it holds), the T's after it.\npub struct TypedArena<T, P: Allocator> {\n    parent: P,\n    chunks: Cell<*mut u8>,\n    at: Cell<*mut T>,\n    end: Cell<*mut T>,\n    len: Cell<usize>,\n    marker: PhantomData<T>,\n}\n\n// UNSAFE: a typed arena's chunks are raw pointers in Cells: stated (AT2).\n// SAFETY: it owns its values and its parent allocator, as an Arena does\n");
    buf_str(out, c"// (T: Send, P: Send).\nunsafe impl<T: Send, P: Allocator + Send> Send for TypedArena<T, P> {}\n// It allocates through `&self` with no lock: never Sync.\nimpl<T, P: Allocator> !Sync for TypedArena<T, P> {}\n\nimpl<T, P: Allocator> TypedArena<T, P> {\n    #[effects(T, P)]\n    pub fn new_in(parent: P) -> TypedArena<T, P> {\n        TypedArena {\n            parent: parent,\n            chunks: Cell::new(crate::ptr::null_mut()),\n            at: Cell::new(crate::ptr::null_mut()),\n            end: Cell::new(crate::ptr::null_mut()),\n            len: Cell::new(0),\n            marker: PhantomData {},\n        }\n    }\n\n    // Where a chunk's T's begin, past its header.\n    fn items_offset() -> usize {\n        round_up(3 * crate::mem::size_of::<usize>(), crate::mem::align_of::<T>())\n    }\n\n    fn chunk_layout(cap: usize) -> Layout {\n        let size = TypedArena::<T, P>::items_offset() + cap * crate::mem::size_of::<T>();\n        Layout { size: size, align: crate::cmp::max(crate::mem::align_of::<T>(), CHUNK_ALIGN) }\n    }\n\n    // A new chunk with room for at least n T's, made the current one.\n    fn add_chunk(&self, n: usize) {\n        let per = crate::cmp::max(1, CHUNK_MIN / crate::cmp::max(1, crate::mem::size_of::<T>()));\n        let cap = crate::cmp::max(n, per);\n        let p = match self.parent.allocate(TypedArena::<T, P>::chunk_layout(cap)) {\n            Result::Ok(p) => p.as_ptr(),\n            Result::Err(_) => out_of_memory(),\n        };\n        let h = p as *mut usize;\n        // UNSAFE: the header is written through the chunk's raw pointer.\n        // SAFETY: the chunk is fresh and at least three words long, aligned\n        // to 16.\n        unsafe {\n            *h = self.chunks.get() as usize;\n            *h.add(1) = cap;\n            *h.add(2) = 0;\n        }\n        self.chunks.set(p);\n        let items = p as usize + TypedArena::<T, P>::items_offset();\n        // (addresses made pointers: both are inside the chunk just\n");
    buf_str(out, c"        // allocated, its end at most one past it)\n        self.at.set(items as *mut T);\n        self.end.set((items + cap * crate::mem::size_of::<T>()) as *mut T);\n    }\n\n    // n T's more in the current chunk's count.\n    fn count(&self, n: usize) {\n        let h = self.chunks.get() as *mut usize;\n        // UNSAFE: the current chunk's header is updated in place.\n        // SAFETY: add_chunk made the current chunk and wrote its header.\n        unsafe {\n            *h.add(2) = *h.add(2) + n;\n        }\n        self.len.set(self.len.get() + n);\n    }\n\n    // Room for n T's side by side in the current chunk: its first.\n    fn room(&self, n: usize) -> *mut T {\n        let size = crate::mem::size_of::<T>();\n        if self.chunks.get().is_null()\n            || (self.end.get() as usize) - (self.at.get() as usize) < n * size\n            {\n            self.add_chunk(n);\n        }\n        let p = self.at.get();\n        // (an address made a pointer: p + n T's is at most the current\n        // chunk's end, checked above, or a new chunk with room for n)\n        self.at.set((p as usize + n * size) as *mut T);\n        p\n    }\n\n    // x moved in; a &mut to it for as long as the arena is borrowed.\n    #[effects(unsafe, T, P)]\n    pub fn alloc(&self, x: T) -> &mut T {\n        let p = self.room(1);\n        // UNSAFE: x is moved into the chunk through a raw pointer.\n        // SAFETY: room gave a slot for one T in a chunk the arena owns; the\n        // count makes the arena's drop drop it, once.\n        unsafe {\n            crate::ptr::write(p, x);\n            self.count(1);\n            &mut *p\n        }\n    }\n\n    // The items moved in, side by side.\n    #[effects(unsafe, T, P, I)]\n    pub fn alloc_extend<I: IntoIterator<Item = T>>(&self, iter: I) -> &mut [T] {\n        let mut items = crate::vec::Vec::new_in(&self.parent);\n        for x in iter {\n            items.push(x);\n        }\n        let n = items.len();\n");
    buf_str(out, c"        let p = self.room(n);\n        // UNSAFE: the items are moved from the Vec's buffer into the chunk\n        // bit for bit, and the Vec forgets them.\n        // SAFETY: room gave n slots in a chunk the arena owns, which does not\n        // overlap the Vec's buffer; set_len(0) leaves the Vec owning only\n        // its buffer, so each item is dropped once, by the arena.\n        unsafe {\n            crate::ptr::copy_nonoverlapping(items.as_ptr(), p, n);\n            items.set_len(0);\n            self.count(n);\n            crate::slice::from_raw_parts_mut(p, n)\n        }\n    }\n\n    // How many T's it holds.\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.len.get()\n    }\n}\n\n// Drops every T, then gives the chunks back to P.\nimpl<T, P: Allocator> Drop for TypedArena<T, P> {\n    fn drop(&mut self) {\n        let size = crate::mem::size_of::<T>();\n        let mut c = self.chunks.get();\n        while !c.is_null() {\n            let h = c as *mut usize;\n            // UNSAFE: the chunk's header and T's are read through raw\n            // pointers, each T moved out and dropped, then the chunk given\n            // back.\n            // SAFETY: add_chunk made every chunk on the list from parent with\n            // chunk_layout(cap) and wrote its header; its first `count` T's\n            // were written by alloc or alloc_extend and are dropped here\n            // once; no &mut to them outlives the arena's borrow.\n            unsafe {\n                let (prev, cap, count) = (*h as *mut u8, *h.add(1), *h.add(2));\n                let items = c as usize + TypedArena::<T, P>::items_offset();\n                let mut i: usize = 0;\n                while i < count {\n                    crate::mem::drop(crate::ptr::read((items + i * size) as *const T));\n                    i += 1;\n                }\n                if let crate::option::Option::Some(nn) = NonNull::new(c) {\n");
    buf_str(out, c"                    self.parent.deallocate(nn, TypedArena::<T, P>::chunk_layout(cap));\n                }\n                c = prev;\n            }\n        }\n    }\n}\n\n// A bump allocator over memory it is lent (`FixedBuf::new(&mut buf)`, buf\n// a local array): no heap at all; out of room is an AllocError. Its\n// counters are Cells (allocate takes &self). An arena over one\n// (`Arena<&FixedBuf<'b>>`) allocates on the stack.\n// mvs: FixedBuf\n// std: changed: a region 'b, the lent memory's (MVS: #[views(mem)])\npub struct FixedBuf<'b> {\n    start: *mut u8,\n    len: usize,\n    at: Cell<usize>,\n    mem: PhantomData<&'b mut [u8]>,\n}\n\n// UNSAFE: the buffer is a raw pointer: stated (AT2).\n// SAFETY: a FixedBuf is the exclusive borrow `&'b mut [u8]` of its bytes\n// (its PhantomData), which is Send.\nunsafe impl<'b> Send for FixedBuf<'b> {}\n// It allocates through `&self` (a Cell) with no lock: never Sync.\nimpl<'b> !Sync for FixedBuf<'b> {}\n\nimpl<'b> FixedBuf<'b> {\n    // An allocator over mem, for as long as mem is lent.\n    // std: changed: takes &'b mut [u8]\n    #[effects()]\n    pub fn new(mem: &'b mut [u8]) -> FixedBuf<'b> {\n        FixedBuf { start: mem.as_mut_ptr(), len: mem.len(), at: Cell::new(0), mem: PhantomData {} }\n    }\n\n    // The bytes given out since it was made or reset.\n    // std: changed: usize\n    #[effects()]\n    pub fn used(&self) -> usize {\n        self.at.get()\n    }\n\n    // The bytes it can give out in all.\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        self.len\n    }\n\n    // All its room back. Safe: `&mut self` proves no block is borrowed.\n    // std: changed: safe, &mut self (MVS: unsafe, through a raw pointer)\n    #[effects()]\n    pub fn reset(&mut self) {\n        self.at.set(0)\n    }\n}\n\n// UNSAFE: an Allocator impl over lent memory.\n// SAFETY: blocks are bumped from mem, which outlives 'b and every\n// borrow of the FixedBuf; deallocate does nothing (FREES false).\n");
    buf_str(out, c"// mvs: FixedBuf::impl Allocator\nunsafe impl<'b> Allocator for FixedBuf<'b> {\n    const FREES: bool = false;\n\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        let base = self.start as usize;\n        let start = round_up(base + self.at.get(), layout.align()) - base;\n        if start + layout.size() > self.len {\n            return Result::Err(AllocError {});\n        }\n        self.at.set(start + layout.size());\n        // (an address made a pointer: base + start .. + size is inside the\n        // lent memory, checked just above, which outlives 'b)\n        match NonNull::new((base + start) as *mut u8) {\n            crate::option::Option::Some(p) => Result::Ok(p),\n            crate::option::Option::None => Result::Err(AllocError {}),\n        }\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, the trait's own for deallocate.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {}\n}\n\n// Any allocator, its type erased: a data pointer and the allocator's\n// functions, Copy, five words. Made from any &'a A (`a.erase()`,\n// `AnyAlloc::new(&a)`); itself an Allocator, so `Vec<T, AnyAlloc<'a>>`\n// and a library taking `a: AnyAlloc<'_>` are compiled once for every\n// allocator (decision 9; Device<AnyAlloc<'a>>, decision 17). FREES is\n// true: it cannot know what it erased.\npub struct AnyAlloc<'a> {\n    data: *const u8,\n    allocate_fn: fn(*const u8, Layout) -> Result<NonNull<u8>, AllocError>,\n    // UNSAFE: the erased allocator's deallocate, unsafe as the trait's.\n    // SAFETY: called only from AnyAlloc's own deallocate, with its contract.\n    deallocate_fn: unsafe fn(*const u8, NonNull<u8>, Layout),\n    // UNSAFE: the erased allocator's grow, unsafe as the trait's.\n    // SAFETY: called only from AnyAlloc's own grow, with its contract.\n");
    buf_str(out, c"    grow_fn: unsafe fn(*const u8, NonNull<u8>, Layout, Layout) -> Result<NonNull<u8>, AllocError>,\n    // UNSAFE: the erased allocator's shrink, unsafe as the trait's.\n    // SAFETY: called only from AnyAlloc's own shrink, with its contract.\n    shrink_fn: unsafe fn(*const u8, NonNull<u8>, Layout, Layout) -> Result<NonNull<u8>, AllocError>,\n    marker: PhantomData<&'a ()>,\n}\n\nimpl<'a> AnyAlloc<'a> {\n    // a, erased: valid for as long as a is borrowed.\n    #[effects(unsafe)]\n    pub fn new<A: Allocator>(a: &'a A) -> AnyAlloc<'a> {\n        AnyAlloc {\n            data: a as *const A as *const u8,\n            allocate_fn: any_allocate::<A>,\n            deallocate_fn: any_deallocate::<A>,\n            grow_fn: any_grow::<A>,\n            shrink_fn: any_shrink::<A>,\n            marker: PhantomData {},\n        }\n    }\n}\n\nimpl<'a> Clone for AnyAlloc<'a> {\n    fn clone(&self) -> AnyAlloc<'a> {\n        *self\n    }\n}\n\nimpl<'a> Copy for AnyAlloc<'a> {}\n\nimpl<'a, A: Allocator> From<&'a A> for AnyAlloc<'a> {\n    fn from(a: &'a A) -> AnyAlloc<'a> {\n        AnyAlloc::new(a)\n    }\n}\n\n// UNSAFE: an Allocator impl through the erased functions.\n// SAFETY: each call goes to the erased allocator's own function with its\n// data pointer, valid for 'a; that allocator's impl is sound by its own\n// SAFETY comment.\n// AnyAlloc::new's functions for an A: data is the &'a A it erased.\nfn any_allocate<A: Allocator>(data: *const u8, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n    // UNSAFE: the allocator is read back through the erased pointer.\n    // SAFETY: data is the `&'a A` AnyAlloc::new took, cast; AnyAlloc<'a>\n    // keeps that shared borrow alive.\n    let a = unsafe { &*(data as *const A) };\n    a.allocate(layout)\n}\n\n// UNSAFE: the erased allocator's deallocate, with its contract.\n// SAFETY: as any_allocate's data; the caller's p and layout are A's.\n");
    buf_str(out, c"unsafe fn any_deallocate<A: Allocator>(data: *const u8, p: NonNull<u8>, layout: Layout) {\n    // UNSAFE: the allocator read back, and its deallocate.\n    // SAFETY: as above.\n    unsafe { (*(data as *const A)).deallocate(p, layout) }\n}\n\n// UNSAFE: the erased allocator's grow, with its contract.\n// SAFETY: as any_deallocate's.\nunsafe fn any_grow<A: Allocator>(data: *const u8, p: NonNull<u8>, old: Layout,\n    new: Layout) -> Result<NonNull<u8>, AllocError> {\n    // UNSAFE: the allocator read back, and its grow.\n    // SAFETY: as above.\n    unsafe { (*(data as *const A)).grow(p, old, new) }\n}\n\n// UNSAFE: the erased allocator's shrink, with its contract.\n// SAFETY: as any_deallocate's.\nunsafe fn any_shrink<A: Allocator>(data: *const u8, p: NonNull<u8>, old: Layout,\n    new: Layout) -> Result<NonNull<u8>, AllocError> {\n    // UNSAFE: the allocator read back, and its shrink.\n    // SAFETY: as above.\n    unsafe { (*(data as *const A)).shrink(p, old, new) }\n}\n\n// UNSAFE: Allocator is an unsafe trait: a block it gives stays valid\n// until it is given back.\n// SAFETY: every method passes through to the erased allocator, which\n// is an Allocator itself.\nunsafe impl<'a> Allocator for AnyAlloc<'a> {\n    fn allocate(&self, layout: Layout) -> Result<NonNull<u8>, AllocError> {\n        (self.allocate_fn)(self.data, layout)\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with this layout.\n    // SAFETY: a contract on the caller, the trait's own for deallocate.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        // UNSAFE: the erased allocator's deallocate.\n        // SAFETY: passed through: the caller's p and layout are its.\n        unsafe { (self.deallocate_fn)(self.data, p, layout) }\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with layout old;\n    // new.size() >= old.size().\n    // SAFETY: a contract on the caller, the trait's own for grow.\n");
    buf_str(out, c"    unsafe fn grow(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        // UNSAFE: the erased allocator's grow.\n        // SAFETY: passed through, as deallocate.\n        unsafe { (self.grow_fn)(self.data, p, old, new) }\n    }\n\n    // UNSAFE: p must be a block of this allocator's, with layout old;\n    // new.size() <= old.size().\n    // SAFETY: a contract on the caller, the trait's own for shrink.\n    unsafe fn shrink(&self, p: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<u8>,\n        AllocError> {\n        // UNSAFE: the erased allocator's shrink.\n        // SAFETY: passed through, as deallocate.\n        unsafe { (self.shrink_fn)(self.data, p, old, new) }\n    }\n}\n\nimpl<'a> Debug for AnyAlloc<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"AnyAlloc\")\n    }\n}\n// ---- end mod std::alloc ----\n}\n// ---- mod std::boxed ----\npub mod boxed {\n// std::boxed: Box<T, A>, one value on the heap of A (MVS had none: a\n// recursive type took a Vec or raw pointers). `Box::new_in(x, a)`,\n// allocator last as nightly's allocator_api (plan §0); there is no\n// `Box::new`, as there is no default allocator. A is always written\n// (`Box<Node, Gpa>`, `Box<Node, &'a Arena<Gpa>>`). Box<[T], A> and\n// Box<str, A> wait for unsized boxes (0.29, with user DSTs).\n\nuse crate::alloc::{AllocError, Allocator, Layout};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::ops::{Deref, DerefMut, Drop};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// A T on A's heap, freed (and dropped) when the Box is.\npub struct Box<T, A: Allocator> {\n    ptr: NonNull<T>,\n    alloc: A,\n}\n\n");
    buf_str(out, c"// UNSAFE: the box's pointer is a NonNull (neither Send nor Sync): stated, as\n// Rust's.\n// SAFETY: a Box owns its T and its allocator and reaches them only through\n// itself, as a Vec of one.\nunsafe impl<T: Send, A: Allocator + Send> Send for Box<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Box` reads its T through `&T` and its allocator through `&A`.\nunsafe impl<T: Sync, A: Allocator + Sync> Sync for Box<T, A> {}\n\nimpl<T, A: Allocator> Box<T, A> {\n    // x moved to a block of a; out of memory panics.\n    #[effects(panic, T, A)]\n    pub fn new_in(x: T, a: A) -> Box<T, A> {\n        match Box::try_new_in(x, a) {\n            Result::Ok(b) => b,\n            Result::Err(_) => out_of_memory(),\n        }\n    }\n\n    // The same, with AllocError instead of a panic.\n    #[effects(alloc(A), unsafe, T, A)]\n    pub fn try_new_in(x: T, a: A) -> Result<Box<T, A>, AllocError> {\n        let ptr: NonNull<T> = if crate::mem::size_of::<T>() == 0 {\n            NonNull::dangling()\n        } else {\n            match a.allocate(Layout::new::<T>()) {\n                Result::Ok(p) => p.cast::<T>(),\n                Result::Err(e) => return Result::Err(e),\n            }\n        };\n        // UNSAFE: x is moved into the block through a raw pointer.\n        // SAFETY: ptr is a fresh block of T's layout from a (or, for a\n        // zero-sized T, a dangling aligned pointer, which a write of no\n        // bytes may use).\n        unsafe { crate::ptr::write(ptr.as_ptr(), x) };\n        Result::Ok(Box { ptr: ptr, alloc: a })\n    }\n\n    // The value, moved out; the block is freed. (`*b` moves out of a Box\n    // in Rust; vole spells it into_inner.)\n    #[effects(unsafe, T, A)]\n    pub fn into_inner(b: Box<T, A>) -> T {\n        let (p, a) = Box::into_raw_with_allocator(b);\n        // UNSAFE: the value is moved out and the block given back.\n        // SAFETY: p and a come from a Box: p holds an initialized T in a\n");
    buf_str(out, c"        // block a gave for T's layout (none for a zero-sized T), and the Box\n        // is gone, so neither is used again.\n        unsafe {\n            let x = crate::ptr::read(p as *const T);\n            free_block(p, &a);\n            x\n        }\n    }\n\n    // The allocator the Box frees into.\n    #[effects()]\n    pub fn allocator(b: &Box<T, A>) -> &A {\n        &b.alloc\n    }\n\n    // A copy of the value on b.\n    #[effects(T, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> Box<T, B>\n        where\n            T: Clone,\n    {\n        Box::new_in(self.deref().clone(), b)\n    }\n\n    // The value, never freed: a &mut that lives as long as A's memory.\n    #[effects(unsafe, T, A)]\n    pub fn leak<'a>(b: Box<T, A>) -> &'a mut T\n        where\n            A: 'a,\n    {\n        // UNSAFE: the block is never freed, so the &mut can outlive the Box.\n        // SAFETY: p holds an initialized T; A: 'a keeps its memory for 'a,\n        // and the Box is forgotten, so nothing else reaches the value.\n        unsafe { &mut *Box::into_raw(b) }\n    }\n\n    // The block's pointer, the Box forgotten: from_raw_in takes it back.\n    #[effects(T, A)]\n    pub fn into_raw(b: Box<T, A>) -> *mut T {\n        let (p, a) = Box::into_raw_with_allocator(b);\n        // Rust's into_raw leaves the allocator undropped too.\n        crate::mem::forget(a);\n        p\n    }\n\n    // The pointer and the allocator, the Box forgotten.\n    #[effects(unsafe, T, A)]\n    pub fn into_raw_with_allocator(b: Box<T, A>) -> (*mut T, A) {\n        let p = b.ptr.as_ptr();\n        // UNSAFE: the allocator is moved out of the Box bit for bit.\n        // SAFETY: the Box is forgotten right after, so the allocator is\n        // dropped once, by the caller, and the value is not dropped.\n        let a = unsafe { crate::ptr::read(&b.alloc as *const A) };\n        crate::mem::forget(b);\n        (p, a)\n    }\n\n");
    buf_str(out, c"    // A Box again, from into_raw's pointer and the allocator it came from.\n    #[effects(panic, unsafe, T)]\n    // UNSAFE: p must come from a Box<T, A> on an allocator equal to a.\n    // SAFETY: a contract on the caller, as Rust's Box::from_raw_in.\n    pub unsafe fn from_raw_in(p: *mut T, a: A) -> Box<T, A> {\n        match NonNull::new(p) {\n            Option::Some(ptr) => Box { ptr: ptr, alloc: a },\n            Option::None => crate::panic::unreachable(),\n        }\n    }\n}\n\n// Gives p's block back to a (a zero-sized T has none).\n// UNSAFE: deallocates a block through the allocator.\n// SAFETY: a contract on the caller: p is a Box's block from a, its value\n// moved out or dropped.\nunsafe fn free_block<T, A: Allocator>(p: *mut T, a: &A) {\n    if crate::mem::size_of::<T>() != 0 {\n        match NonNull::new(p as *mut u8) {\n            Option::Some(q) => a.deallocate(q, Layout::new::<T>()),\n            Option::None => {}\n        }\n    }\n}\n\n// Out of memory where the API has no Result: Rust's handle_alloc_error.\nfn out_of_memory() -> ! {\n    let msg: &str = \"memory allocation failed\";\n    crate::panic::panic(msg)\n}\n\nimpl<T, A: Allocator> Deref for Box<T, A> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        // UNSAFE: the Box's block, read through its pointer.\n        // SAFETY: ptr holds an initialized T for the Box's life, and &self\n        // borrows the Box, so no &mut reaches it meanwhile.\n        unsafe { self.ptr.as_ref() }\n    }\n}\n\nimpl<T, A: Allocator> DerefMut for Box<T, A> {\n    fn deref_mut(&mut self) -> &mut T {\n        // UNSAFE: the Box's block, written through its pointer.\n        // SAFETY: ptr holds an initialized T for the Box's life, and &mut\n        // self is the one access to it.\n        unsafe { self.ptr.as_mut() }\n    }\n}\n\nimpl<T, A: Allocator> Drop for Box<T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: drops the value and gives the block back.\n");
    buf_str(out, c"        // SAFETY: ptr holds an initialized T in a block alloc gave for\n        // T's layout (none for a zero-sized T); the Box is dropped once.\n        unsafe {\n            crate::ptr::drop_in_place(self.ptr.as_ptr());\n            free_block(self.ptr.as_ptr(), &self.alloc);\n        }\n    }\n}\n\n// A Box on the same allocator (a clone of it).\nimpl<T: Clone, A: Allocator + Clone> Clone for Box<T, A> {\n    fn clone(&self) -> Box<T, A> {\n        self.clone_in(self.alloc.clone())\n    }\n}\n\nimpl<T: PartialEq, A: Allocator> PartialEq for Box<T, A> {\n    fn eq(&self, other: &Box<T, A>) -> bool {\n        self.deref() == other.deref()\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for Box<T, A> {}\n\nimpl<T: PartialOrd, A: Allocator> PartialOrd for Box<T, A> {\n    fn partial_cmp(&self, other: &Box<T, A>) -> crate::option::Option<Ordering> {\n        self.deref().partial_cmp(other.deref())\n    }\n}\n\nimpl<T: Ord, A: Allocator> Ord for Box<T, A> {\n    fn cmp(&self, other: &Box<T, A>) -> Ordering {\n        self.deref().cmp(other.deref())\n    }\n}\n\nimpl<T: Hash, A: Allocator> Hash for Box<T, A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.deref().hash(state)\n    }\n}\n\nimpl<T: Debug, A: Allocator> Debug for Box<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let v: &T = self.deref();\n        crate::fmt::Debug::fmt(v, f)\n    }\n}\n\nimpl<T: Display, A: Allocator> Display for Box<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let v: &T = self.deref();\n        crate::fmt::Display::fmt(v, f)\n    }\n}\n\nimpl<T, A: Allocator> AsRef<T> for Box<T, A> {\n    fn as_ref(&self) -> &T {\n        self.deref()\n    }\n}\n\nimpl<T, A: Allocator> AsMut<T> for Box<T, A> {\n    fn as_mut(&mut self) -> &mut T {\n        self.deref_mut()\n    }\n}\n\nimpl<T, A: Allocator> Borrow<T> for Box<T, A> {\n    fn borrow(&self) -> &T {\n        self.deref()\n    }\n}\n\n");
    buf_str(out, c"impl<T, A: Allocator> BorrowMut<T> for Box<T, A> {\n    fn borrow_mut(&mut self) -> &mut T {\n        self.deref_mut()\n    }\n}\n// ---- end mod std::boxed ----\n}\n// ---- mod std::vec ----\npub mod vec {\n// std::vec: Vec<T, A>, a growable array on A's heap. A is always written\n// (`Vec<u8, Gpa>`, `Vec<Tok<'s>, &'a Arena<Gpa>>`: plan §2.0 rule 2);\n// `Vec::new_in(a)`, `Vec::with_capacity_in(n, a)`, `Vec::from_in([..], a)`.\n// What a Vec shares with every slice (get, first, iter, sort_unstable,\n// contains, ...) is [T]'s, reached through Deref: `v.get(i)` is\n// `Option<&T>`, `v.iter()` yields `&T`. Vec's own methods are the ones\n// that change its length or its storage, and allocate from its A only:\n// push, extend, clone and the stable sorts.\n\nuse crate::alloc::{Allocator, Layout, TryReserveError};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::default::DefaultIn;\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{\n    DoubleEndedIterator, ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator,\n};\nuse crate::marker::PhantomData;\nuse crate::ops::{Bound, Deref, DerefMut, Drop, Index, IndexMut, RangeBounds};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\nuse crate::slice::{Iter, IterMut, SliceIndex};\n\n// A contiguous, growable array of T on A. Its elements are dropped and its\n// block freed when it is.\npub struct Vec<T, A: Allocator> {\n    ptr: NonNull<T>,\n    cap: usize,\n    len: usize,\n    alloc: A,\n}\n\n// UNSAFE: Vec holds its buffer through a NonNull, which is neither Send nor\n// Sync, so its auto traits are stated (AT2), as Rust's.\n// SAFETY: the Vec owns its elements and its allocator, and reaches them only\n// through itself: sending it sends T's and A's (T: Send, A: Send), sharing\n");
    buf_str(out, c"// it shares `&T`s and `&A` (T: Sync, A: Sync).\nunsafe impl<T: Send, A: Allocator + Send> Send for Vec<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Vec` reads its elements and allocator through `&T` and `&A`.\nunsafe impl<T: Sync, A: Allocator + Sync> Sync for Vec<T, A> {}\n\nimpl<T, A: Allocator> Vec<T, A> {\n    // An empty Vec on a; it allocates at its first push.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> Vec<T, A> {\n        // A zero-sized T never allocates: its capacity is unbounded.\n        let cap = if crate::mem::size_of::<T>() == 0 { usize::MAX } else { 0 };\n        Vec { ptr: NonNull::dangling(), cap: cap, len: 0, alloc: a }\n    }\n\n    // An empty Vec on a with room for cap elements.\n    #[effects(panic, T, A)]\n    pub fn with_capacity_in(cap: usize, a: A) -> Vec<T, A>\n        ensures result.capacity() >= cap\n    {\n        let mut v: Vec<T, A> = Vec::new_in(a);\n        v.reserve_exact(cap);\n        v\n    }\n\n    // A Vec of the array's elements, moved, on a (`Vec::from_in([1, 2, 3],\n    // gpa)`, Rust's `vec![1, 2, 3]`). Compiler-provided for every length N\n    // until const generics (plan §6): `#[array_builtin(N)]` names the\n    // length, and the compiler makes the item for each N a program uses.\n    #[array_builtin(N)]\n    #[effects(unsafe, T, A)]\n    pub fn from_in(items: [T; N], a: A) -> Vec<T, A> {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(N, a);\n        let p = items.as_ptr();\n        for i in 0..N {\n            // UNSAFE: each element moved out of the array by value: the\n            // front's `for x in items` over an array of non-Copy elements\n            // reads them by reference until moves out of an index are\n            // tracked (front-rust.md F22.1).\n            // SAFETY: i < N, so p.add(i) is inside items, and each element\n            // is read once; forget(items) below keeps the array from\n            // dropping what moved.\n            v.push(unsafe { p.add(i).read() });\n");
    buf_str(out, c"        }\n        crate::mem::forget(items);\n        v\n    }\n\n    // A Vec of its parts: a pointer from a Vec on an allocator equal to a,\n    // its length and its capacity.\n    #[effects(panic, unsafe, T)]\n    // UNSAFE: the parts must be a Vec's, as Rust's from_raw_parts_in.\n    // SAFETY: a contract on the caller: ptr allocated by a for cap T's,\n    // the first len initialized.\n    pub unsafe fn from_raw_parts_in(ptr: *mut T, len: usize, cap: usize, a: A) -> Vec<T, A> {\n        match NonNull::new(ptr) {\n            Option::Some(p) => Vec { ptr: p, cap: cap, len: len, alloc: a },\n            Option::None => crate::panic::panic(\"Vec::from_raw_parts_in: a null pointer\"),\n        }\n    }\n\n    // Element i's address (i <= cap: in the block or one past it).\n    fn slot(&self, i: usize) -> *mut T {\n        // UNSAFE: pointer arithmetic on the block.\n        // SAFETY: every caller has i <= cap, so the address is inside the\n        // block or one past its end; nothing is read here.\n        unsafe { self.ptr.add(i).as_ptr() }\n    }\n\n    // The block's layout (cap T's; T not zero-sized, cap > 0).\n    fn layout(&self) -> Layout {\n        match Layout::array::<T>(self.cap) {\n            Result::Ok(l) => l,\n            Result::Err(_) => crate::panic::unreachable(),\n        }\n    }\n\n    // Makes the block hold new_cap T's (new_cap > cap).\n    fn grow_to(&mut self, new_cap: usize) -> Result<(), TryReserveError> {\n        if crate::mem::size_of::<T>() == 0 {\n            // Its capacity is usize::MAX already: only an overflow comes here.\n            return Result::Err(TryReserveError::CapacityOverflow);\n        }\n        let new_layout = match Layout::array::<T>(new_cap) {\n            Result::Ok(l) => l,\n            Result::Err(_) => return Result::Err(TryReserveError::CapacityOverflow),\n        };\n        let got = if self.cap == 0 {\n            self.alloc.allocate(new_layout)\n        } else {\n");
    buf_str(out, c"            // UNSAFE: grows A's block.\n            // SAFETY: ptr is the block A gave for layout() (cap > 0, T not\n            // zero-sized) and new_layout is larger with the same alignment.\n            unsafe { self.alloc.grow(self.ptr.cast::<u8>(), self.layout(), new_layout) }\n        };\n        match got {\n            Result::Ok(p) => {\n                self.ptr = p.cast::<T>();\n                self.cap = new_cap;\n                Result::Ok(())\n            }\n            Result::Err(_) => Result::Err(TryReserveError::AllocError { layout: new_layout }),\n        }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.len\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.len == 0\n    }\n\n    // How many elements fit before it reallocates.\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        self.cap\n    }\n\n    // The allocator it grows into.\n    // std: changed: returns &A (MVS: a copy of A)\n    #[effects()]\n    pub fn allocator(&self) -> &A {\n        &self.alloc\n    }\n\n    // Room for extra more elements (at least: it may take more).\n    #[effects(panic, T, A)]\n    pub fn reserve(&mut self, extra: usize)\n        ensures self.capacity() >= self.len() + extra\n    {\n        if let Result::Err(e) = self.try_reserve(extra) {\n            capacity_error(e);\n        }\n    }\n\n    // Room for exactly extra more.\n    #[effects(panic, T, A)]\n    pub fn reserve_exact(&mut self, extra: usize) {\n        if self.cap - self.len >= extra {\n            return;\n        }\n        if extra > usize::MAX - self.len {\n            capacity_error(TryReserveError::CapacityOverflow);\n        }\n        if let Result::Err(e) = self.grow_to(self.len + extra) {\n            capacity_error(e);\n        }\n    }\n\n    // reserve, with the error instead of a panic.\n    // std: changed: takes usize, returns TryReserveError (MVS: i64, AllocError)\n    #[effects(T, A)]\n");
    buf_str(out, c"    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {\n        if self.cap - self.len >= extra {\n            return Result::Ok(());\n        }\n        if extra > usize::MAX - self.len {\n            return Result::Err(TryReserveError::CapacityOverflow);\n        }\n        // Amortized: at least double, at least 4.\n        let doubled = if self.cap > usize::MAX / 2 { usize::MAX } else { self.cap * 2 };\n        let new_cap = crate::cmp::max(crate::cmp::max(self.len + extra, doubled), 4);\n        self.grow_to(new_cap)\n    }\n\n    // Gives back the room beyond its length.\n    #[effects(T, A)]\n    pub fn shrink_to_fit(&mut self) {\n        self.shrink_to(0)\n    }\n\n    // Gives back the room beyond max(its length, min_capacity).\n    #[effects(alloc(A), panic, unsafe, T, A)]\n    pub fn shrink_to(&mut self, min_capacity: usize) {\n        let target = crate::cmp::max(self.len, min_capacity);\n        if self.cap <= target || crate::mem::size_of::<T>() == 0 {\n            return;\n        }\n        let old = self.layout();\n        if target == 0 {\n            // UNSAFE: gives the block back to A.\n            // SAFETY: cap > 0 and T is not zero-sized, so ptr is the block A\n            // gave for old; it is not used again (ptr is reset below).\n            unsafe { self.alloc.deallocate(self.ptr.cast::<u8>(), old) };\n            self.ptr = NonNull::dangling();\n            self.cap = 0;\n            return;\n        }\n        let new_layout = match Layout::array::<T>(target) {\n            Result::Ok(l) => l,\n            Result::Err(_) => crate::panic::unreachable(),\n        };\n        // UNSAFE: shrinks A's block.\n        // SAFETY: ptr is the block A gave for old, and new_layout is smaller\n        // (target < cap) with the same alignment; the first len elements fit.\n        match unsafe { self.alloc.shrink(self.ptr.cast::<u8>(), old, new_layout) } {\n            Result::Ok(p) => {\n");
    buf_str(out, c"                self.ptr = p.cast::<T>();\n                self.cap = target;\n            }\n            Result::Err(_) => capacity_error(TryReserveError::AllocError { layout: new_layout }),\n        }\n    }\n\n    // Appends x, growing from A when it is full. (0.28.0) Inline, and its\n    // clauses `debug` (checked by volec test): a push is a compare, one\n    // copy of x into its slot and an increment, the growth out of line.\n    // Its `ensures` made it a call of push$body, out of line, at every\n    // push (about 7% of the rust-edition compiler's check of itself).\n    #[inline]\n    #[effects(T, A)]\n    pub fn push(&mut self, x: T)\n        debug ensures self.len() == old(self.len()) + 1\n        debug ensures self.len() <= self.capacity()\n    {\n        if self.len == self.cap {\n            self.grow_one();\n        }\n        self.put(x);\n    }\n\n    // x written to slot len, counted (len < cap).\n    #[inline]\n    fn put(&mut self, x: T) {\n        // UNSAFE: writes past the initialized part.\n        // SAFETY: its one caller, push, made len < cap, so slot len is room in\n        // the block; len counts it right after.\n        unsafe { crate::ptr::write(self.slot(self.len), x) };\n        self.len += 1;\n    }\n\n    // Room for one more: push's growth, out of line.\n    #[inline(never)]\n    fn grow_one(&mut self) {\n        self.reserve(1);\n    }\n\n    // The last element, moved out; None when empty.\n    #[effects(panic, T, A)]\n    pub fn pop(&mut self) -> Option<T>\n        ensures self.len() <= old(self.len())\n    {\n        if self.len == 0 {\n            return Option::None;\n        }\n        self.len -= 1;\n        // UNSAFE: moves the last element out.\n        // SAFETY: slot len was initialized and is no longer counted, so it is\n        // read once.\n        Option::Some(unsafe { crate::ptr::read(self.slot(self.len)) })\n    }\n\n    // Inserts x at i, moving the ones after it up; panics when i > len.\n");
    buf_str(out, c"    #[effects(panic, T, A)]\n    pub fn insert(&mut self, i: usize, x: T)\n        requires i <= self.len()\n        ensures self.len() == old(self.len()) + 1\n    {\n        let n = self.len;\n        if i > n {\n            crate::panic::panic(\"insertion index (is {}) should be <= len (is {})\", i, n);\n        }\n        if n == self.cap {\n            self.reserve(1);\n        }\n        // UNSAFE: moves [i, n) up one and writes x at i.\n        // SAFETY: n < cap, so [i + 1, n + 1) is in the block; ptr::copy allows\n        // the overlap; slot i is then written once and len counts it.\n        unsafe {\n            let p = self.slot(i);\n            crate::ptr::copy(p, self.slot(i + 1), n - i);\n            crate::ptr::write(p, x);\n        }\n        self.len = n + 1;\n    }\n\n    // Removes element i, moving the ones after it down; panics when out of\n    // bounds.\n    #[effects(panic, T, A)]\n    pub fn remove(&mut self, i: usize) -> T\n        requires i < self.len()\n        ensures self.len() + 1 == old(self.len())\n    {\n        let n = self.len;\n        if i >= n {\n            crate::panic::panic(\"removal index (is {}) should be < len (is {})\", i, n);\n        }\n        // UNSAFE: moves element i out and [i + 1, n) down one.\n        // SAFETY: i < n: slot i is initialized and read once; the moved range is\n        // initialized; len then drops the duplicated last slot.\n        unsafe {\n            let p = self.slot(i);\n            let x = crate::ptr::read(p);\n            crate::ptr::copy(self.slot(i + 1), p, n - i - 1);\n            self.len = n - 1;\n            x\n        }\n    }\n\n    // Removes element i, putting the last one in its place: O(1), the\n    // order not kept.\n    #[effects(panic, unsafe, T, A)]\n    pub fn swap_remove(&mut self, i: usize) -> T\n        requires i < self.len()\n    {\n        let n = self.len;\n        if i >= n {\n");
    buf_str(out, c"            crate::panic::panic(\"swap_remove index (is {}) should be < len (is {})\", i, n);\n        }\n        // UNSAFE: moves element i out and the last element into its slot.\n        // SAFETY: i < n: both slots are initialized; the last is no longer\n        // counted, so each value is owned once (i == n - 1 copies onto itself).\n        unsafe {\n            let x = crate::ptr::read(self.slot(i));\n            crate::ptr::copy(self.slot(n - 1), self.slot(i), 1);\n            self.len = n - 1;\n            x\n        }\n    }\n\n    // Keeps the first n elements, dropping the rest.\n    #[effects(panic, T, A)]\n    pub fn truncate(&mut self, n: usize)\n        ensures self.len() <= n\n    {\n        let old = self.len;\n        if n >= old {\n            return;\n        }\n        self.len = n;\n        // (0.29: nothing to run for elements without drop glue; at -O0 the\n        // loop below was a read per element of a Vec<u8> cleared)\n        if !crate::mem::needs_drop::<T>() {\n            return;\n        }\n        let mut i = n;\n        while i < old {\n            // UNSAFE: drops the elements past the new length.\n            // SAFETY: [n, old) was initialized and is no longer counted: each is\n            // read (and dropped) once.\n            crate::mem::drop(unsafe { crate::ptr::read(self.slot(i)) });\n            i += 1;\n        }\n    }\n\n    // Drops every element; the capacity stays.\n    #[effects(panic, T, A)]\n    pub fn clear(&mut self)\n        ensures self.len() == 0\n    {\n        self.truncate(0)\n    }\n\n    // Its elements as a slice (`&v[..]`, or Deref).\n    #[effects(unsafe, T, A)]\n    pub fn as_slice(&self) -> &[T] {\n        let p = self.ptr.as_ptr();\n        // UNSAFE: a slice of the block.\n        // SAFETY: the first len elements are initialized; the slice borrows self.\n        unsafe { crate::slice::from_raw_parts(p, self.len) }\n    }\n\n    // std: changed: returns &mut [T] (MVS: an inout view)\n");
    buf_str(out, c"    #[effects(unsafe, T, A)]\n    pub fn as_mut_slice(&mut self) -> &mut [T] {\n        let p = self.ptr.as_ptr();\n        // UNSAFE: a &mut slice of the block.\n        // SAFETY: the first len elements are initialized; the slice borrows self\n        // mutably, so nothing else reaches them.\n        unsafe { crate::slice::from_raw_parts_mut(p, self.len) }\n    }\n\n    #[effects(T)]\n    pub fn as_ptr(&self) -> *const T {\n        self.ptr.as_ptr() as *const T\n    }\n\n    #[effects(T)]\n    pub fn as_mut_ptr(&mut self) -> *mut T {\n        self.ptr.as_ptr()\n    }\n\n    // Sets its length, nothing dropped or initialized.\n    #[effects(unsafe)]\n    // UNSAFE: the first n elements must be initialized and n <= capacity.\n    // SAFETY: a contract on the caller, as Rust's set_len.\n    pub unsafe fn set_len(&mut self, n: usize) {\n        self.len = n;\n    }\n\n    // Keeps the elements f says true of, in order.\n    // std: changed: FnMut(&T) (MVS: a let T)\n    #[effects(T, A)]\n    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        self.retain_mut(|x| f(&*x))\n    }\n\n    // retain, with each element given as &mut.\n    #[effects(panic, diverge, T, A, F)]\n    pub fn retain_mut<F: FnMut(&mut T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        let n = self.len;\n        let mut kept: usize = 0;\n        let mut i: usize = 0;\n        while i < n {\n            if f(&mut self.as_mut_slice()[i]) {\n                if kept != i {\n                    self.as_mut_slice().swap(kept, i);\n                }\n                kept += 1;\n            }\n            i += 1;\n        }\n        self.truncate(kept);\n    }\n\n    // Removes consecutive elements with the same key (f's), keeping the first.\n    // mvs: dedup_by_key\n    // std: changed: Vec's method (MVS: a free function over a slice)\n    #[effects(T, A, K)]\n    pub fn dedup_by_key<K: PartialEq, F: FnMut(&mut T) -> K>(&mut self, key: F) {\n");
    buf_str(out, c"        let mut key = key;\n        self.dedup_by(|a, b| key(a) == key(b))\n    }\n\n    // Removes consecutive elements that same_bucket(a, b) says are equal.\n    // mvs: dedup_by\n    // std: changed: Vec's method (MVS: a free function over a slice)\n    #[effects(panic, T, A, F)]\n    pub fn dedup_by<F: FnMut(&mut T, &mut T) -> bool>(&mut self, same_bucket: F) {\n        let mut same = same_bucket;\n        let n = self.len;\n        if n < 2 {\n            return;\n        }\n        // [0, w) is kept; element r is compared with the last kept one.\n        let mut w: usize = 1;\n        let mut r: usize = 1;\n        while r < n {\n            let (head, tail) = self.as_mut_slice().split_at_mut(r);\n            if !same(&mut tail[0], &mut head[w - 1]) {\n                if w != r {\n                    self.as_mut_slice().swap(w, r);\n                }\n                w += 1;\n            }\n            r += 1;\n        }\n        self.truncate(w);\n    }\n\n    // Moves every element of other to its end, leaving other empty.\n    #[effects(unsafe, T, A)]\n    pub fn append(&mut self, other: &mut Vec<T, A>) {\n        let m = other.len;\n        self.reserve(m);\n        // UNSAFE: moves other's elements to the end of self's block.\n        // SAFETY: reserve made room for m more; the two blocks are distinct\n        // (&mut self and &mut other); other's length is set to 0 so each value\n        // is owned once.\n        unsafe { crate::ptr::copy_nonoverlapping(other.slot(0), self.slot(self.len), m) };\n        self.len += m;\n        other.len = 0;\n    }\n\n    // The elements in range, removed and yielded by the iterator; the\n    // rest closes up when it is dropped.\n    #[effects(panic, T, A, R)]\n    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, T, A> {\n        let n = self.len;\n        let (start, end) = range_of(&range, n);\n        // While the Drain lives the Vec holds [0, start); its drop moves the\n");
    buf_str(out, c"        // tail [end, n) down.\n        self.len = start;\n        let vec = match NonNull::new(self as *mut Vec<T, A>) {\n            Option::Some(p) => p,\n            Option::None => crate::panic::unreachable(),\n        };\n        Drain {\n            vec: vec, start: start, end: end, tail: end, tail_len: n - end, marker: PhantomData,\n        }\n    }\n\n    // The elements from at on, as a new Vec on a clone of A.\n    #[effects(panic, unsafe, T, A)]\n    pub fn split_off(&mut self, at: usize) -> Vec<T, A>\n        where\n            A: Clone,\n            requires at <= self.len()\n    {\n        let n = self.len;\n        if at > n {\n            crate::panic::panic(\"`at` split index (is {}) should be <= len (is {})\", at, n);\n        }\n        let mut other: Vec<T, A> = Vec::with_capacity_in(n - at, self.alloc.clone());\n        // UNSAFE: moves [at, n) into other's block.\n        // SAFETY: other has room for n - at; the blocks are distinct; self's\n        // length drops to at, so each value is owned once.\n        unsafe { crate::ptr::copy_nonoverlapping(self.slot(at), other.slot(0), n - at) };\n        other.len = n - at;\n        self.len = at;\n        other\n    }\n\n    // Its length made n: new elements are f()'s.\n    #[effects(diverge, T, A, F)]\n    pub fn resize_with<F: FnMut() -> T>(&mut self, n: usize, f: F) {\n        let mut f = f;\n        if n <= self.len {\n            self.truncate(n);\n            return;\n        }\n        self.reserve(n - self.len);\n        // (0.29: each f() written to its slot: the room is reserved, so\n        // push's growth test per element is not asked)\n        while self.len < n {\n            self.put(f());\n        }\n    }\n\n    // The elements, never freed: a &mut slice that lives as long as A's memory.\n    #[effects(unsafe, T, A)]\n    pub fn leak<'a>(self) -> &'a mut [T]\n        where\n            A: 'a,\n    {\n        let p = self.ptr.as_ptr();\n        let n = self.len;\n");
    buf_str(out, c"        crate::mem::forget(self);\n        // UNSAFE: a &mut slice of a block nothing frees.\n        // SAFETY: the Vec is forgotten, so the block and its first n\n        // initialized elements stay as long as A's memory ('a); only this\n        // slice reaches them.\n        unsafe { crate::slice::from_raw_parts_mut(p, n) }\n    }\n\n    // Moves the Vec out, leaving an empty one on a clone of its allocator\n    // (vole's: a Vec has no Default, so `mem::take` does not apply).\n    // std: changed: needs A: Clone\n    #[effects(T, A)]\n    pub fn take(&mut self) -> Vec<T, A>\n        where\n            A: Clone,\n    {\n        let a = self.alloc.clone();\n        crate::mem::replace(self, Vec::new_in(a))\n    }\n\n    // Sorts it, stable (equal elements keep their order), with scratch from\n    // its own A: Rust's `sort`. MVS's sort was unstable: it is\n    // `sort_unstable` now ([T]'s, allocates nothing).\n    // std: changed: stable, scratch from A (MVS: unstable)\n    #[effects(T, A)]\n    pub fn sort(&mut self)\n        where\n            T: Ord,\n    {\n        self.sort_by(|a, b| a.cmp(b))\n    }\n\n    // sort, by a comparison.\n    // mvs: Vec::sort_by, [T]::sort_by, sort_by\n    // std: changed: stable, an Ordering (MVS: unstable, an i64)\n    #[effects(unsafe, T, A, F)]\n    pub fn sort_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {\n        let p = self.ptr.as_ptr();\n        // UNSAFE: the elements as a &mut slice while the allocator is borrowed\n        // for the scratch: two disjoint parts of self the checker sees as one.\n        // SAFETY: the slice covers the initialized elements only and the sort\n        // does not touch self.alloc but through &A.\n        let s = unsafe { crate::slice::from_raw_parts_mut(p, self.len) };\n        s.sort_by_in(compare, &self.alloc)\n    }\n\n    // sort, by a key.\n    // std: changed: stable, FnMut(&T) (MVS: unstable, a let T)\n    #[effects(T, A, K)]\n");
    buf_str(out, c"    pub fn sort_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {\n        let mut f = f;\n        self.sort_by(|a, b| f(a).cmp(&f(b)))\n    }\n}\n\nimpl<T: Clone, A: Allocator> Vec<T, A> {\n    // A Vec of n clones of x on a (Rust's `vec![x; n]`, its order).\n    // mvs: Vec::filled_in\n    // std: renamed\n    #[effects(T, A)]\n    pub fn from_elem_in(x: T, n: usize, a: A) -> Vec<T, A> {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(n, a);\n        v.resize(n, x);\n        v\n    }\n\n    // Appends clones of s's elements. (0.29) Inline: for a Copy T what is\n    // left at the call is a test of the room, one block copy and the new\n    // length (the compiler's assembler appends every instruction word and\n    // every line so).\n    #[inline]\n    #[effects(panic, unsafe, T, A)]\n    pub fn extend_from_slice(&mut self, s: &[T]) {\n        if !crate::mem::is_copy::<T>() {\n            self.extend_clones(s);\n            return;\n        }\n        let n = s.len();\n        if self.cap - self.len < n {\n            self.reserve(n);\n        }\n        // UNSAFE: s's elements copied as one block past the Vec's length,\n        // which then counts them. A push per element (a clone, a growth\n        // test and a bounds check each) was a third of the compiler's\n        // assembler at -O0 (measured, 0.29).\n        // SAFETY: there is room for n more (tested, or reserved), so [len,\n        // len + n) is inside the block; s is a shared borrow beside &mut\n        // self, so it is no part of this Vec; T is Copy (is_copy), so its\n        // bits are its clone and nothing is owned twice.\n        unsafe { crate::ptr::copy_nonoverlapping(s.as_ptr(), self.slot(self.len), n) };\n        self.len += n;\n    }\n\n    // extend_from_slice for a T that is not Copy: a clone of each, pushed.\n    fn extend_clones(&mut self, s: &[T]) {\n        self.reserve(s.len());\n        let mut i: usize = 0;\n        while i < s.len() {\n            self.push(s[i].clone());\n");
    buf_str(out, c"            i += 1;\n        }\n    }\n\n    // Appends clones of the elements in src (its own elements).\n    #[effects(panic, unsafe, T, A, R)]\n    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {\n        let (start, end) = range_of(&src, self.len);\n        self.reserve(end - start);\n        if crate::mem::is_copy::<T>() {\n            // UNSAFE: its own elements [start, end) copied as one block past\n            // its length.\n            // SAFETY: reserve made room for end - start more (the pointers\n            // are read after it); the source is below len (range_of) and\n            // the destination starts at len, so they are disjoint; T is\n            // Copy (is_copy): its bits are its clone.\n            unsafe {\n                crate::ptr::copy_nonoverlapping(self.slot(start) as *const T, self.slot(self.len),\n                    end - start)\n            };\n            self.len += end - start;\n            return;\n        }\n        let mut i = start;\n        while i < end {\n            let x = self.as_slice()[i].clone();\n            self.push(x);\n            i += 1;\n        }\n    }\n\n    // Its length made n: new elements are clones of x.\n    #[effects(diverge, unsafe, T, A)]\n    pub fn resize(&mut self, n: usize, x: T) {\n        if n <= self.len {\n            self.truncate(n);\n            return;\n        }\n        self.reserve(n - self.len);\n        if crate::mem::is_copy::<T>() {\n            // UNSAFE: the new elements written as one block fill. A push\n            // per element was about 14 instructions each (measured, 0.29:\n            // the compiler's per-function tables).\n            // SAFETY: reserve made room for n - len more, so [len, n) is\n            // inside the block; x is a local, no part of it; T is Copy\n            // (is_copy), so its bits may be duplicated; len then counts\n            // only what was written.\n");
    buf_str(out, c"            unsafe { crate::ptr::fill_copies(self.slot(self.len), n - self.len, &x) };\n            self.len = n;\n            return;\n        }\n        while self.len + 1 < n {\n            self.push(x.clone());\n        }\n        self.push(x);\n    }\n\n    // A copy on another allocator.\n    #[effects(T, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> Vec<T, B> {\n        let mut v: Vec<T, B> = Vec::with_capacity_in(self.len, b);\n        v.extend_from_slice(self.as_slice());\n        v\n    }\n}\n\nimpl<T: PartialEq, A: Allocator> Vec<T, A> {\n    // Removes consecutive equal elements, keeping the first.\n    // mvs: dedup\n    // std: changed: Vec's method (MVS: a free function over a slice)\n    #[effects(T, A)]\n    pub fn dedup(&mut self) {\n        self.dedup_by(|a, b| *a == *b)\n    }\n}\n\nimpl<T, A: Allocator> Drop for Vec<T, A> {\n    fn drop(&mut self) {\n        self.truncate(0);\n        if self.cap != 0 && crate::mem::size_of::<T>() != 0 {\n            // UNSAFE: gives the block back to A.\n            // SAFETY: cap > 0 and T is not zero-sized: ptr is the block A gave\n            // for layout(); the elements are dropped already.\n            unsafe { self.alloc.deallocate(self.ptr.cast::<u8>(), self.layout()) };\n        }\n    }\n}\n\nimpl<T, A: Allocator> Deref for Vec<T, A> {\n    type Target = [T];\n\n    fn deref(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> DerefMut for Vec<T, A> {\n    fn deref_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\n// `v[i]` and `&v[a..b]`: built in for Vec in 0.27.0; this is the trait's.\nimpl<T, I: SliceIndex<[T]>, A: Allocator> Index<I> for Vec<T, A> {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self.as_slice())\n    }\n}\n\nimpl<T, I: SliceIndex<[T]>, A: Allocator> IndexMut<I> for Vec<T, A> {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n");
    buf_str(out, c"        index.index_mut(self.as_mut_slice())\n    }\n}\n\n// A copy on the same allocator (a clone of it): plan §2.0, `Clone`\n// reuses the stored allocator.\n// std: changed: needs A: Clone\nimpl<T: Clone, A: Allocator + Clone> Clone for Vec<T, A> {\n    fn clone(&self) -> Vec<T, A> {\n        self.clone_in(self.alloc.clone())\n    }\n}\n\n// mvs: Vec::impl Eq\n// std: changed: PartialEq against any Vec<U, B>\nimpl<T: PartialEq<U>, U, A: Allocator, B: Allocator> PartialEq<Vec<U, B>> for Vec<T, A> {\n    fn eq(&self, other: &Vec<U, B>) -> bool {\n        self.as_slice() == other.as_slice()\n    }\n}\n\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U]> for Vec<T, A> {\n    fn eq(&self, other: &[U]) -> bool {\n        self.as_slice() == other\n    }\n}\n\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<&[U]> for Vec<T, A> {\n    fn eq(&self, other: &&[U]) -> bool {\n        self.as_slice() == *other\n    }\n}\n\n// Compiler-provided for every N (array_builtin, as from_in).\n#[array_builtin(N)]\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U; N]> for Vec<T, A> {\n    fn eq(&self, other: &[U; N]) -> bool {\n        self.as_slice() == &(*other)[..]\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for Vec<T, A> {}\n\nimpl<T: PartialOrd, A: Allocator> PartialOrd for Vec<T, A> {\n    fn partial_cmp(&self, other: &Vec<T, A>) -> Option<Ordering> {\n        self.as_slice().partial_cmp(other.as_slice())\n    }\n}\n\nimpl<T: Ord, A: Allocator> Ord for Vec<T, A> {\n    fn cmp(&self, other: &Vec<T, A>) -> Ordering {\n        self.as_slice().cmp(other.as_slice())\n    }\n}\n\n// The elements' hashes, as the slice's: the same for any A.\nimpl<T: Hash, A: Allocator> Hash for Vec<T, A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.as_slice().hash(state)\n    }\n}\n\n// `[1, 2, 3]`.\nimpl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let s: &[T] = self.as_slice();\n");
    buf_str(out, c"        crate::fmt::Debug::fmt(s, f)\n    }\n}\n\nimpl<T, A: Allocator> AsRef<[T]> for Vec<T, A> {\n    fn as_ref(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> AsMut<[T]> for Vec<T, A> {\n    fn as_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\nimpl<T, A: Allocator> Borrow<[T]> for Vec<T, A> {\n    fn borrow(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> BorrowMut<[T]> for Vec<T, A> {\n    fn borrow_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\n// An empty Vec on a (`map.entry(k).or_default()` for Vec values).\nimpl<T, A: Allocator> DefaultIn<A> for Vec<T, A> {\n    fn default_in(a: A) -> Vec<T, A> {\n        Vec::new_in(a)\n    }\n}\n\nimpl<T, A: Allocator> Extend<T> for Vec<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n        }\n    }\n}\n\nimpl<'a, T: Copy + 'a, A: Allocator> Extend<&'a T> for Vec<T, A> {\n    fn extend<I: IntoIterator<Item = &'a T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(*x);\n        }\n    }\n}\n\n// `iter.collect_in(a)` into a Vec.\nimpl<T, A: Allocator> FromIteratorIn<T, A> for Vec<T, A> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Vec<T, A> {\n        let mut v: Vec<T, A> = Vec::new_in(a);\n        v.extend(iter);\n        v\n    }\n}\n\n// `for x in v`: the elements, moved out.\nimpl<T, A: Allocator> IntoIterator for Vec<T, A> {\n    type Item = T;\n    type IntoIter = IntoIter<T, A>;\n\n    fn into_iter(self) -> IntoIter<T, A> {\n        let v = self;\n        let buf = v.ptr;\n        let cap = v.cap;\n        let len = v.len;\n        // UNSAFE: moves the allocator out of a value whose Drop is not run.\n        // SAFETY: v is forgotten right after, so the allocator is owned once\n        // (by the IntoIter), as are the block and the elements.\n");
    buf_str(out, c"        let alloc = unsafe { crate::ptr::read(&v.alloc as *const A) };\n        crate::mem::forget(v);\n        IntoIter { buf: buf, cap: cap, start: 0, end: len, alloc: alloc }\n    }\n}\n\n// `for x in &v`: &T's.\nimpl<'a, T, A: Allocator> IntoIterator for &'a Vec<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\n// `for x in &mut v`: &mut T's.\nimpl<'a, T, A: Allocator> IntoIterator for &'a mut Vec<T, A> {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n\n// reserve's failure: a panic, as Rust's (vole has no abort hook).\nfn capacity_error(e: TryReserveError) -> ! {\n    match e {\n        TryReserveError::CapacityOverflow => crate::panic::panic(\"capacity overflow\"),\n        TryReserveError::AllocError { layout } => {\n            crate::panic::panic(\"memory allocation of {} bytes failed\", layout.size())\n        }\n    }\n}\n\n// A RangeBounds as [start, end) within 0..n; panics when it is not.\nfn range_of<R: RangeBounds<usize>>(r: &R, n: usize) -> (usize, usize) {\n    let start = match r.start_bound() {\n        Bound::Included(s) => *s,\n        Bound::Excluded(s) => *s + 1,\n        Bound::Unbounded => 0,\n    };\n    let end = match r.end_bound() {\n        Bound::Included(e) => *e + 1,\n        Bound::Excluded(e) => *e,\n        Bound::Unbounded => n,\n    };\n    if start > end {\n        crate::panic::panic(\"slice index starts at {} but ends at {}\", start, end);\n    }\n    if end > n {\n        crate::panic::panic(\"range end index {} out of range for slice of length {}\", end, n);\n    }\n    (start, end)\n}\n\n// A Vec's elements, by value; what is left is dropped with it.\npub struct IntoIter<T, A: Allocator> {\n    buf: NonNull<T>,\n    cap: usize,\n    start: usize,\n    end: usize,\n    alloc: A,\n}\n\n");
    buf_str(out, c"// UNSAFE: the buffer is a NonNull (neither Send nor Sync): stated, as Rust's.\n// SAFETY: IntoIter owns the elements left and the allocator, as a Vec does.\nunsafe impl<T: Send, A: Allocator + Send> Send for IntoIter<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&IntoIter` reads the elements left through `&T` only.\nunsafe impl<T: Sync, A: Allocator + Sync> Sync for IntoIter<T, A> {}\n\nimpl<T, A: Allocator> IntoIter<T, A> {\n    // What is left, as a slice.\n    #[effects(unsafe, T)]\n    pub fn as_slice(&self) -> &[T] {\n        let p = self.buf.as_ptr();\n        // UNSAFE: a slice of the block.\n        // SAFETY: [start, end) is the initialized part not yet yielded.\n        unsafe { crate::slice::from_raw_parts(p.add(self.start), self.end - self.start) }\n    }\n}\n\nimpl<T, A: Allocator> Iterator for IntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        // UNSAFE: moves element start out.\n        // SAFETY: start < end: it is initialized and, start moving past it, read once.\n        let x = unsafe { crate::ptr::read(self.buf.add(self.start).as_ptr()) };\n        self.start += 1;\n        Option::Some(x)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.end - self.start, Option::Some(self.end - self.start))\n    }\n}\n\nimpl<T, A: Allocator> DoubleEndedIterator for IntoIter<T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        self.end -= 1;\n        // UNSAFE: moves element end out.\n        // SAFETY: it was in [start, end) and, end moving below it, is read once.\n        Option::Some(unsafe { crate::ptr::read(self.buf.add(self.end).as_ptr()) })\n    }\n}\n\nimpl<T, A: Allocator> ExactSizeIterator for IntoIter<T, A> {}\n\nimpl<T, A: Allocator> Drop for IntoIter<T, A> {\n    fn drop(&mut self) {\n");
    buf_str(out, c"        while self.start < self.end {\n            // UNSAFE: drops the elements not yielded.\n            // SAFETY: [start, end) is initialized and each is read once.\n            crate::mem::drop(unsafe { crate::ptr::read(self.buf.add(self.start).as_ptr()) });\n            self.start += 1;\n        }\n        if self.cap != 0 && crate::mem::size_of::<T>() != 0 {\n            let layout = match Layout::array::<T>(self.cap) {\n                Result::Ok(l) => l,\n                Result::Err(_) => crate::panic::unreachable(),\n            };\n            // UNSAFE: gives the Vec's block back to its allocator.\n            // SAFETY: buf is the block the allocator gave for cap T's; no element\n            // is left in it.\n            unsafe { self.alloc.deallocate(self.buf.cast::<u8>(), layout) };\n        }\n    }\n}\n\n// Vec::drain's iterator: the removed elements; the Vec closes up when it\n// is dropped.\npub struct Drain<'a, T, A: Allocator> {\n    vec: NonNull<Vec<T, A>>,\n    start: usize,\n    end: usize,\n    tail: usize,\n    tail_len: usize,\n    marker: PhantomData<&'a mut Vec<T, A>>,\n}\n\n// UNSAFE: Drain reaches its Vec through a NonNull: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the Vec for 'a (its PhantomData of\n// `&'a mut Vec`): Send and Sync as that `&mut Vec<T, A>` is.\nunsafe impl<'a, T: Send, A: Allocator + Send> Send for Drain<'a, T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Drain` reads the drained elements through `&T` only.\nunsafe impl<'a, T: Sync, A: Allocator + Sync> Sync for Drain<'a, T, A> {}\n\nimpl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        // UNSAFE: the Vec reached through the Drain's pointer; element start\n        // moved out.\n        // SAFETY: the Drain holds the Vec's &mut for 'a; [start, end) is\n");
    buf_str(out, c"        // initialized, past the Vec's length, and read once.\n        let x = unsafe { crate::ptr::read(self.vec.as_mut().slot(self.start)) };\n        self.start += 1;\n        Option::Some(x)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = self.end - self.start;\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T, A: Allocator> DoubleEndedIterator for Drain<'a, T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        self.end -= 1;\n        // UNSAFE: as next's.\n        // SAFETY: as next's, for element end.\n        Option::Some(unsafe { crate::ptr::read(self.vec.as_mut().slot(self.end)) })\n    }\n}\n\nimpl<'a, T, A: Allocator> ExactSizeIterator for Drain<'a, T, A> {}\n\nimpl<'a, T, A: Allocator> Drop for Drain<'a, T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: the Vec reached through the Drain's pointer.\n        // SAFETY: the Drain holds the Vec's &mut for 'a.\n        let v = unsafe { self.vec.as_mut() };\n        while self.start < self.end {\n            // UNSAFE: drops the drained elements not yielded.\n            // SAFETY: [start, end) is initialized and each is read once.\n            crate::mem::drop(unsafe { crate::ptr::read(v.slot(self.start)) });\n            self.start += 1;\n        }\n        let len = v.len;\n        if self.tail_len > 0 && self.tail != len {\n            // UNSAFE: moves the tail down to the Vec's length.\n            // SAFETY: [tail, tail + tail_len) is initialized and inside the\n            // block; ptr::copy allows the overlap; len then counts it.\n            unsafe { crate::ptr::copy(v.slot(self.tail), v.slot(len), self.tail_len) };\n        }\n        v.len = len + self.tail_len;\n    }\n}\n// ---- end mod std::vec ----\n}\n// ---- mod std::slice ----\npub mod slice {\n// std::slice: the methods of [T], always behind a reference (`&[T]`,\n");
    buf_str(out, c"// `&mut [T]`: MVS's views), its iterators and SliceIndex. A Vec and an\n// array have them all through Deref and the unsize coercion `&[T; N] ->\n// &[T]`. What reads returns references into the slice (`get` is\n// `Option<&T>`, `iter` yields `&T`); what sorts in place without\n// allocating keeps Rust's name and meaning (`sort_unstable`); the stable\n// sorts allocate scratch, so on a slice they take an allocator\n// (`sort_in(a)`), while Vec's `sort` uses its own (plan §2). MVS's free\n// functions (`reverse(s)`, `binary_search(s, x)`) are methods now.\n\nuse crate::alloc::Allocator;\nuse crate::borrow::ToOwnedIn;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::AsRef;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};\nuse crate::ops::{\n    Bound, Index, IndexMut, Range, RangeBounds, RangeFrom, RangeFull, RangeInclusive, RangeTo,\n    RangeToInclusive,\n};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::vec::Vec;\n\n// std: new: Rust's slice::from_raw_parts. The n T's from p as a slice.\n#[effects(unsafe, T)]\n// UNSAFE: the slice's elements are read through p.\n// SAFETY: a contract on the caller: p valid for n initialized T's for 'a.\npub unsafe fn from_raw_parts<'a, T>(p: *const T, n: usize) -> &'a [T] {\n    crate::ptr::slice_parts(p, n)\n}\n\n// An empty `&'a mut [T]` that borrows nothing: what IterMut and ChunksMut\n// leave in their field while they split it (Rust promotes `&mut []` to\n// 'static; a temporary here would be a local's borrow).\nfn empty_mut<'a, T>() -> &'a mut [T] {\n    let p: crate::ptr::NonNull<T> = crate::ptr::NonNull::dangling();\n    // UNSAFE: a slice made from a raw pointer.\n    // SAFETY: it has no elements, so nothing is read or written through\n    // it; the pointer is non-null and aligned (NonNull::dangling).\n");
    buf_str(out, c"    unsafe { from_raw_parts_mut(p.as_ptr(), 0) }\n}\n\n// The same, mutable (slice::from_raw_parts_mut).\n#[effects(unsafe, T)]\n// UNSAFE: the slice's elements are read and written through p.\n// SAFETY: a contract on the caller: p valid for n T's for 'a, and not\n// otherwise accessed for 'a.\npub unsafe fn from_raw_parts_mut<'a, T>(p: *mut T, n: usize) -> &'a mut [T] {\n    crate::ptr::slice_parts_mut(p, n)\n}\n\nimpl<T> [T] {\n    // The number of elements (built in; MVS's `.len` read).\n    #[effects()]\n    pub fn len(&self) -> usize {\n        // Built in: the length word of the reference (a view's `len` today).\n        self.len\n    }\n\n    #[effects(T)]\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    // Element i, or the subslice a range names; None when out of bounds.\n    // mvs: [T]::get, Vec::get\n    // std: changed: a reference, through SliceIndex (MVS: a copy of T)\n    #[effects(T, I)]\n    pub fn get<I: SliceIndex<[T]>>(&self, index: I) -> Option<&I::Output> {\n        index.get(self)\n    }\n\n    // The same, mutable.\n    #[effects(T, I)]\n    pub fn get_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> Option<&mut I::Output> {\n        index.get_mut(self)\n    }\n\n    // get, with no bounds check.\n    #[effects(unsafe, T, I)]\n    // UNSAFE: an index out of bounds is undefined.\n    // SAFETY: a contract on the caller: index within the slice.\n    pub unsafe fn get_unchecked<I: SliceIndex<[T]>>(&self, index: I) -> &I::Output {\n        // The checked access: undefined behaviour may do anything, a panic too.\n        index.index(self)\n    }\n\n    #[effects(unsafe, T, I)]\n    // UNSAFE: an index out of bounds is undefined.\n    // SAFETY: a contract on the caller: index within the slice.\n    pub unsafe fn get_unchecked_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self)\n    }\n\n    // mvs: Vec::first\n    // std: changed: a reference (MVS: a copy, on Vec only)\n");
    buf_str(out, c"    #[effects(T)]\n    pub fn first(&self) -> Option<&T> {\n        self.get(0)\n    }\n\n    // mvs: Vec::last\n    // std: changed: a reference (MVS: a copy, on Vec only)\n    #[effects(T)]\n    pub fn last(&self) -> Option<&T> {\n        if self.is_empty() { Option::None } else { self.get(self.len() - 1) }\n    }\n\n    #[effects(T)]\n    pub fn first_mut(&mut self) -> Option<&mut T> {\n        self.get_mut(0)\n    }\n\n    #[effects(T)]\n    pub fn last_mut(&mut self) -> Option<&mut T> {\n        let n = self.len();\n        if n == 0 { Option::None } else { self.get_mut(n - 1) }\n    }\n\n    // The first element and the rest.\n    // (0.28.0: no `panic`: the indices are in bounds where the slice is\n    // not empty, effects E2.1; a slice's iterator is this)\n    #[effects(T)]\n    pub fn split_first(&self) -> Option<(&T, &[T])> {\n        if self.is_empty() { Option::None } else { Option::Some((&self[0], &self[1..])) }\n    }\n\n    // The last element and the rest.\n    // (0.28.0: no `panic`, as split_first: `s[s.len() - 1]` and `s[..s.len()\n    // - 1]` are in bounds where the slice is not empty, effects E2.1)\n    #[effects(T)]\n    pub fn split_last(&self) -> Option<(&T, &[T])> {\n        if self.is_empty() {\n            Option::None\n        } else {\n            Option::Some((&self[self.len() - 1], &self[..self.len() - 1]))\n        }\n    }\n\n    // [0, mid) and [mid, len); panics when mid > len.\n    #[effects(panic)]\n    pub fn split_at(&self, mid: usize) -> (&[T], &[T])\n        requires mid <= self.len()\n    {\n        (&self[..mid], &self[mid..])\n    }\n\n    // The same, mutable: two disjoint &mut slices.\n    #[effects(panic, unsafe, T)]\n    pub fn split_at_mut(&mut self, mid: usize) -> (&mut [T], &mut [T])\n        requires mid <= self.len()\n    {\n        let n = self.len();\n        if mid > n {\n            crate::panic::panic(\"mid > len\");\n        }\n        let p = self.as_mut_ptr();\n");
    buf_str(out, c"        // UNSAFE: two &mut slices of one slice: the borrow checker cannot see\n        // that they are disjoint.\n        // SAFETY: [0, mid) and [mid, n) do not overlap and both lie in the\n        // slice (mid <= n, checked above); each lives as long as the &mut self.\n        unsafe { (from_raw_parts_mut(p, mid), from_raw_parts_mut(p.add(mid), n - mid)) }\n    }\n\n    // The elements, by reference, in order (`.rev()` from the end).\n    // mvs: [T]::iter, [T]::iter_ref, Vec::iter, Vec::iter_ref, SliceIter, SliceRefIter\n    // std: changed: yields &T (MVS's iter copied each T; iter_ref is this)\n    #[effects()]\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { v: self }\n    }\n\n    // The elements, by &mut.\n    #[effects()]\n    pub fn iter_mut(&mut self) -> IterMut<'_, T> {\n        IterMut { v: self }\n    }\n\n    // Subslices of size elements (the last one shorter); size > 0.\n    #[effects(panic)]\n    pub fn chunks(&self, size: usize) -> Chunks<'_, T>\n        requires size != 0\n    {\n        crate::panic::assert(size != 0, \"chunk size must be non-zero\");\n        Chunks { v: self, size: size }\n    }\n\n    #[effects(panic)]\n    pub fn chunks_mut(&mut self, size: usize) -> ChunksMut<'_, T>\n        requires size != 0\n    {\n        crate::panic::assert(size != 0, \"chunk size must be non-zero\");\n        ChunksMut { v: self, size: size }\n    }\n\n    // Subslices of exactly size elements; the rest is `remainder()`.\n    #[effects(panic, T)]\n    pub fn chunks_exact(&self, size: usize) -> ChunksExact<'_, T>\n        requires size != 0\n    {\n        crate::panic::assert(size != 0, \"chunk size must be non-zero\");\n        let n = self.len() - self.len() % size;\n        let (v, rem) = self.split_at(n);\n        ChunksExact { v: v, rem: rem, size: size }\n    }\n\n    // Every run of size consecutive elements, overlapping.\n    #[effects(panic)]\n    pub fn windows(&self, size: usize) -> Windows<'_, T>\n        requires size != 0\n");
    buf_str(out, c"    {\n        crate::panic::assert(size != 0, \"window size must be non-zero\");\n        Windows { v: self, size: size }\n    }\n\n    // The subslices between the elements pred says true of.\n    #[effects()]\n    pub fn split<F: FnMut(&T) -> bool>(&self, pred: F) -> Split<'_, T, F> {\n        Split { v: self, pred: pred, finished: false }\n    }\n\n    // Exchanges elements i and j; panics when out of bounds.\n    // mvs: [T]::swap, Vec::swap, swap_at\n    #[effects(panic, T)]\n    pub fn swap(&mut self, i: usize, j: usize)\n        requires i < self.len() && j < self.len()\n    {\n        let n = self.len();\n        if i >= n || j >= n {\n            crate::panic::panic(\"index out of bounds\");\n        }\n        if i == j {\n            return;\n        }\n        let (lo, hi) = if i < j { (i, j) } else { (j, i) };\n        let (a, b) = self.split_at_mut(hi);\n        crate::mem::swap(&mut a[lo], &mut b[0]);\n    }\n\n    // Reverses the order in place.\n    // mvs: reverse\n    #[effects(diverge, T)]\n    pub fn reverse(&mut self) {\n        let n = self.len();\n        let mut i: usize = 0;\n        while i < n / 2 {\n            self.swap(i, n - 1 - i);\n            i += 1;\n        }\n    }\n\n    // Rotates left by mid: element mid comes first.\n    // mvs: rotate_left\n    #[effects(panic, T)]\n    pub fn rotate_left(&mut self, mid: usize) {\n        crate::panic::assert(mid <= self.len(), \"mid > len\");\n        self[..mid].reverse();\n        self[mid..].reverse();\n        self.reverse();\n    }\n\n    // mvs: rotate_right\n    #[effects(panic, T)]\n    pub fn rotate_right(&mut self, k: usize) {\n        let n = self.len();\n        crate::panic::assert(k <= n, \"k > len\");\n        self.rotate_left(n - k);\n    }\n\n    // Every element set by f().\n    #[effects(panic, diverge, T, F)]\n    pub fn fill_with<F: FnMut() -> T>(&mut self, f: F) {\n        let mut f = f;\n        let mut i: usize = 0;\n        while i < self.len() {\n");
    buf_str(out, c"            self[i] = f();\n            i += 1;\n        }\n    }\n\n    // Exchanges its elements with other's (the same length, or a panic).\n    #[effects(panic, diverge, T)]\n    pub fn swap_with_slice(&mut self, other: &mut [T])\n        requires self.len() == other.len()\n    {\n        let n = self.len();\n        crate::panic::assert(n == other.len(),\n            \"destination and source slices have different lengths\");\n        let mut i: usize = 0;\n        while i < n {\n            crate::mem::swap(&mut self[i], &mut other[i]);\n            i += 1;\n        }\n    }\n\n    // Sorts in place, unstable (equal elements may change order),\n    // allocating nothing: ipnsort, as MVS's `sort` (now this name).\n    // mvs: sort_unstable, sort, [T]::sort, Vec::sort\n    // std: renamed\n    #[effects(T)]\n    pub fn sort_unstable(&mut self)\n        where\n            T: Ord,\n    {\n        self.sort_unstable_by(|a, b| a.cmp(b))\n    }\n\n    // mvs: sort_unstable_by\n    #[effects(diverge, T, F)]\n    pub fn sort_unstable_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {\n        // An introsort: in place, O(n log n), no allocation. Quicksort\n        // around the median of three, insertion sort for runs of up to\n        // 24, heapsort below 2 log2(n) levels of partitions.\n        let mut compare = compare;\n        let mut depth: usize = 0;\n        let mut m = self.len();\n        while m > 1 {\n            m /= 2;\n            depth += 2;\n        }\n        quicksort(self, depth, &mut compare);\n    }\n\n    // mvs: sort_unstable_by_key\n    #[effects(T, K)]\n    pub fn sort_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {\n        let mut f = f;\n        self.sort_unstable_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    // Sorts stable, scratch from a (Rust's `sort` on a slice; on a Vec,\n    // `v.sort()` uses the Vec's allocator).\n    // mvs: sort_stable_in\n    // std: renamed\n    #[effects(T, A)]\n");
    buf_str(out, c"    pub fn sort_in<A: Allocator>(&mut self, a: A)\n        where\n            T: Ord,\n    {\n        self.sort_by_in(|x, y| x.cmp(y), a)\n    }\n\n    // mvs: sort_stable_by_in, sort_stable_less_in\n    // std: renamed\n    #[effects(panic, diverge, T, F, A)]\n    pub fn sort_by_in<F: FnMut(&T, &T) -> Ordering, A: Allocator>(&mut self, compare: F, a: A) {\n        // A stable merge sort of the indices (scratch from a), then the\n        // permutation applied in place by swaps: no T is moved through raw memory.\n        let n = self.len();\n        if n < 2 {\n            return;\n        }\n        let mut compare = compare;\n        let mut idx: Vec<usize, A> = Vec::with_capacity_in(2 * n, a);\n        let mut i: usize = 0;\n        while i < 2 * n {\n            idx.push(i % n);\n            i += 1;\n        }\n        let (perm, scratch) = idx.split_at_mut(n);\n        let mut width: usize = 1;\n        while width < n {\n            let mut lo: usize = 0;\n            while lo < n {\n                let mid = crate::cmp::min(lo + width, n);\n                let hi = crate::cmp::min(lo + 2 * width, n);\n                let (mut l, mut r, mut k) = (lo, mid, lo);\n                while k < hi {\n                    let take_left = r >= hi\n                        || (l < mid && compare(&self[perm[r]], &self[perm[l]]) != Ordering::Less);\n                    if take_left {\n                        scratch[k] = perm[l];\n                        l += 1;\n                    } else {\n                        scratch[k] = perm[r];\n                        r += 1;\n                    }\n                    k += 1;\n                }\n                lo = hi;\n            }\n            perm.copy_from_slice(scratch);\n            width *= 2;\n        }\n        // perm[k] is the index of the element that goes to k: follow each\n        // cycle to its first unplaced index.\n        let mut k: usize = 0;\n        while k < n {\n            let mut j = perm[k];\n");
    buf_str(out, c"            while j < k {\n                j = perm[j];\n            }\n            self.swap(k, j);\n            k += 1;\n        }\n    }\n\n    #[effects(T, K, A)]\n    pub fn sort_by_key_in<K: Ord, F: FnMut(&T) -> K, A: Allocator>(&mut self, f: F, a: A) {\n        let mut f = f;\n        self.sort_by_in(|x, y| f(x).cmp(&f(y)), a)\n    }\n\n    // Puts the element that sorted order has at i at i, the smaller ones\n    // before and the larger after (unstable, no allocation).\n    // mvs: select_nth_unstable\n    #[effects(T)]\n    pub fn select_nth_unstable(&mut self, i: usize) -> (&mut [T], &mut T, &mut [T])\n        where\n            T: Ord,\n            requires i < self.len()\n    {\n        self.select_nth_unstable_by(i, |a, b| a.cmp(b))\n    }\n\n    // mvs: select_nth_unstable_by, select_nth_unstable_less\n    #[effects(panic, T, F)]\n    pub fn select_nth_unstable_by<F: FnMut(&T, &T) -> Ordering>(\n        &mut self,\n        i: usize,\n        compare: F,\n    ) -> (&mut [T], &mut T, &mut [T]) {\n        crate::panic::assert(i < self.len(), \"partition index is out of bounds\");\n        // Sorting puts every element where sorted order has it (O(n log n),\n        // no allocation).\n        self.sort_unstable_by(compare);\n        let (lo, rest) = self.split_at_mut(i);\n        let (mid, hi) = rest.split_at_mut(1);\n        (lo, &mut mid[0], hi)\n    }\n\n    // mvs: select_nth_unstable_by_key\n    #[effects(T, K)]\n    pub fn select_nth_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(\n        &mut self,\n        i: usize,\n        f: F,\n    ) -> (&mut [T], &mut T, &mut [T]) {\n        let mut f = f;\n        self.select_nth_unstable_by(i, |a, b| f(a).cmp(&f(b)))\n    }\n\n    // In a sorted slice: Ok(where x is) or Err(where it would go).\n    // mvs: binary_search\n    // std: changed: Result<usize, usize> (Rust's)\n    #[effects(T)]\n    pub fn binary_search(&self, x: &T) -> Result<usize, usize>\n        where\n            T: Ord,\n    {\n");
    buf_str(out, c"        self.binary_search_by(|p| p.cmp(x))\n    }\n\n    // mvs: binary_search_by\n    #[effects(panic, diverge, T, F)]\n    pub fn binary_search_by<F: FnMut(&T) -> Ordering>(&self, f: F) -> Result<usize, usize> {\n        let mut f = f;\n        let mut lo: usize = 0;\n        let mut hi = self.len();\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            match f(&self[mid]) {\n                Ordering::Less => lo = mid + 1,\n                Ordering::Greater => hi = mid,\n                Ordering::Equal => return Result::Ok(mid),\n            }\n        }\n        Result::Err(lo)\n    }\n\n    // mvs: binary_search_by_key\n    #[effects(T, B)]\n    pub fn binary_search_by_key<B: Ord, F: FnMut(&T) -> B>(&self, b: &B, f: F) -> Result<usize,\n        usize> {\n        let mut f = f;\n        self.binary_search_by(|k| f(k).cmp(b))\n    }\n\n    // The first index where pred turns false, for a slice partitioned by it.\n    // mvs: partition_point\n    #[effects(panic, diverge, T, P)]\n    pub fn partition_point<P: FnMut(&T) -> bool>(&self, pred: P) -> usize {\n        let mut pred = pred;\n        let mut lo: usize = 0;\n        let mut hi = self.len();\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            if pred(&self[mid]) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        lo\n    }\n\n    // Whether it is sorted (each element <= the next).\n    #[effects(panic, T)]\n    pub fn is_sorted(&self) -> bool\n        where\n            T: PartialOrd,\n    {\n        let mut i: usize = 1;\n        while i < self.len() {\n            if !(self[i - 1] <= self[i]) {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n\n    #[effects(panic, T, K, F)]\n    pub fn is_sorted_by_key<K: PartialOrd, F: FnMut(&T) -> K>(&self, f: F) -> bool {\n        let mut f = f;\n        let n = self.len();\n        if n < 2 {\n");
    buf_str(out, c"            return true;\n        }\n        let mut prev = f(&self[0]);\n        let mut i: usize = 1;\n        while i < n {\n            let k = f(&self[i]);\n            if !(prev <= k) {\n                return false;\n            }\n            prev = k;\n            i += 1;\n        }\n        true\n    }\n\n    // Whether an element equals x.\n    // mvs: [T]::contains, Vec::contains\n    // std: changed: takes &T\n    #[effects(unsafe, T)]\n    pub fn contains(&self, x: &T) -> bool\n        where\n            T: PartialEq,\n    {\n        if crate::mem::is_bytewise_eq::<T, T>() && crate::mem::size_of::<T>() == 1 {\n            // UNSAFE: the slice read as its bytes, searched by memchr (a\n            // loop over the elements is a compare and a bounds check each).\n            // SAFETY: T is u8, i8 or bool (is_bytewise_eq, one byte), so the\n            // slice is len() readable bytes, x one byte, and equality is\n            // the byte's.\n            return unsafe {\n                let b = crate::ptr::read(x as *const T as *const u8);\n                crate::ptr::byte_index(self.as_ptr() as *const u8, self.len(), b).is_some()\n            };\n        }\n        for y in self.iter() {\n            if *y == *x {\n                return true;\n            }\n        }\n        false\n    }\n\n    // std: changed: takes &[T]\n    #[effects(panic, T)]\n    pub fn starts_with(&self, needle: &[T]) -> bool\n        where\n            T: PartialEq,\n    {\n        needle.len() <= self.len() && &self[..needle.len()] == needle\n    }\n\n    // std: changed: takes &[T]\n    #[effects(panic, T)]\n    pub fn ends_with(&self, needle: &[T]) -> bool\n        where\n            T: PartialEq,\n    {\n        needle.len() <= self.len() && &self[self.len() - needle.len()..] == needle\n    }\n\n    // Copies src's elements in (the same length, or a panic).\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn copy_from_slice(&mut self, src: &[T])\n        where\n");
    buf_str(out, c"            T: Copy,\n            requires self.len() == src.len()\n    {\n        let n = self.len();\n        crate::panic::assert(n == src.len(),\n            \"source slice length does not match destination slice length\");\n        // UNSAFE: the elements copied as one block (an assignment and two\n        // bounds checks each otherwise).\n        // SAFETY: both slices have n elements (asserted above); src is a\n        // shared borrow beside &mut self, so the two do not overlap (the\n        // borrow rules: no safe code has both); T is Copy, so its bits are\n        // the value and the old elements have nothing to drop.\n        unsafe { crate::ptr::copy_nonoverlapping(src.as_ptr(), self.as_mut_ptr(), n) };\n    }\n\n    // Copies the elements in src to dest (they may overlap).\n    #[effects(panic, diverge, unsafe, T, R)]\n    pub fn copy_within<R: crate::ops::RangeBounds<usize>>(&mut self, src: R, dest: usize)\n        where\n            T: Copy,\n    {\n        let n = self.len();\n        let start = match src.start_bound() {\n            Bound::Included(s) => *s,\n            Bound::Excluded(s) => *s + 1,\n            Bound::Unbounded => 0,\n        };\n        let end = match src.end_bound() {\n            Bound::Included(e) => *e + 1,\n            Bound::Excluded(e) => *e,\n            Bound::Unbounded => n,\n        };\n        crate::panic::assert(start <= end && end <= n, \"src is out of bounds\");\n        let count = end - start;\n        crate::panic::assert(dest <= n - count, \"dest is out of bounds\");\n        let p = self.as_mut_ptr();\n        // UNSAFE: the elements moved as one block within the slice.\n        // SAFETY: [start, start + count) and [dest, dest + count) are both\n        // inside the slice (asserted above); ptr::copy allows their\n        // overlap; T is Copy: the overwritten elements have nothing to drop.\n        unsafe { crate::ptr::copy(p.add(start) as *const T, p.add(dest), count) };\n    }\n\n");
    buf_str(out, c"    // Clones src's elements in (the same length, or a panic).\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn clone_from_slice(&mut self, src: &[T])\n        where\n            T: Clone,\n            requires self.len() == src.len()\n    {\n        let n = self.len();\n        crate::panic::assert(n == src.len(),\n            \"destination and source slices have different lengths\");\n        if crate::mem::is_copy::<T>() {\n            // UNSAFE: as copy_from_slice's block copy.\n            // SAFETY: both slices have n elements (asserted above) and do\n            // not overlap (&mut self beside a shared borrow); T is Copy\n            // (is_copy): its bits are its clone, and the old elements have\n            // nothing to drop.\n            unsafe { crate::ptr::copy_nonoverlapping(src.as_ptr(), self.as_mut_ptr(), n) };\n            return;\n        }\n        let mut i: usize = 0;\n        while i < n {\n            self[i] = src[i].clone();\n            i += 1;\n        }\n    }\n\n    // Every element set to a clone of x.\n    // mvs: fill\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn fill(&mut self, x: T)\n        where\n            T: Clone,\n    {\n        if crate::mem::is_copy::<T>() {\n            let n = self.len();\n            // UNSAFE: the slice written as one block fill (a clone, an\n            // assignment and a bounds check per element otherwise).\n            // SAFETY: the slice is n writable T's; x is a local, no part of\n            // it; T is Copy (is_copy): its bits may be duplicated, and the\n            // old elements have nothing to drop.\n            unsafe { crate::ptr::fill_copies(self.as_mut_ptr(), n, &x) };\n            return;\n        }\n        // (0.29: x itself is the last element, as Rust's: a clone fewer)\n        let n = self.len();\n        if n == 0 {\n            return;\n        }\n        let mut i: usize = 0;\n        while i + 1 < n {\n            self[i] = x.clone();\n            i += 1;\n");
    buf_str(out, c"        }\n        self[n - 1] = x;\n    }\n\n    // A Vec of clones of its elements, on a.\n    #[effects(T, A)]\n    pub fn to_vec_in<A: Allocator>(&self, a: A) -> Vec<T, A>\n        where\n            T: Clone,\n    {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(self.len(), a);\n        v.extend_from_slice(self);\n        v\n    }\n\n    // n copies of it, end to end, on a.\n    #[effects(T, A)]\n    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> Vec<T, A>\n        where\n            T: Copy,\n    {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(self.len() * n, a);\n        let mut i: usize = 0;\n        while i < n {\n            v.extend_from_slice(self);\n            i += 1;\n        }\n        v\n    }\n\n    #[effects()]\n    pub fn as_ptr(&self) -> *const T {\n        // Built in: the data word of the reference (a view's `ptr` today).\n        self.ptr\n    }\n\n    #[effects()]\n    pub fn as_mut_ptr(&mut self) -> *mut T {\n        self.ptr as *mut T\n    }\n}\n\n// (0.29) What only a slice of bytes has.\nimpl [u8] {\n    // The index of the first byte equal to x, or None: C's memchr (the\n    // memchr crate's `memchr(x, s)`, bstr's `find_byte`). The search a\n    // loop or `iter().position(..)` writes costs a compare and a bounds\n    // check per byte; this reads the bytes as words. str's `find`,\n    // `split` and `lines` search with it.\n    #[effects(unsafe)]\n    pub fn find_byte(&self, x: u8) -> Option<usize> {\n        // UNSAFE: C's memchr over the slice's bytes.\n        // SAFETY: the slice is len() readable bytes; byte_index reads no\n        // more and returns an index below len().\n        unsafe { crate::ptr::byte_index(self.as_ptr(), self.len(), x) }\n    }\n}\n\n// sort_unstable_by's quicksort of v, with `depth` levels of partitions\n// left before it is a heapsort.\nfn quicksort<T, F: FnMut(&T, &T) -> Ordering>(v: &mut [T], depth: usize, compare: &mut F) {\n    let n = v.len();\n    if n <= 24 {\n");
    buf_str(out, c"        // Insertion sort.\n        for i in 1..n {\n            let mut k = i;\n            while k > 0 && compare(&v[k], &v[k - 1]) == Ordering::Less {\n                v.swap(k, k - 1);\n                k -= 1;\n            }\n        }\n        return;\n    }\n    if depth == 0 {\n        // Heapsort.\n        let mut start = n / 2;\n        while start > 0 {\n            start -= 1;\n            sift_down(v, start, compare);\n        }\n        let mut end = n;\n        while end > 1 {\n            end -= 1;\n            v.swap(0, end);\n            sift_down(&mut v[..end], 0, compare);\n        }\n        return;\n    }\n    // The median of the first, the middle and the last element, to v[0].\n    let mid = n / 2;\n    if compare(&v[mid], &v[0]) == Ordering::Less {\n        v.swap(mid, 0);\n    }\n    if compare(&v[n - 1], &v[0]) == Ordering::Less {\n        v.swap(n - 1, 0);\n    }\n    if compare(&v[n - 1], &v[mid]) == Ordering::Less {\n        v.swap(n - 1, mid);\n    }\n    v.swap(0, mid);\n    // v[1..i] is not above the pivot v[0], v[j + 1..] not below it.\n    let mut i: usize = 1;\n    let mut j = n - 1;\n    loop {\n        while i <= j && compare(&v[i], &v[0]) == Ordering::Less {\n            i += 1;\n        }\n        while i <= j && compare(&v[0], &v[j]) == Ordering::Less {\n            j -= 1;\n        }\n        if i >= j {\n            break;\n        }\n        v.swap(i, j);\n        i += 1;\n        j -= 1;\n    }\n    v.swap(0, j);\n    let (left, rest) = v.split_at_mut(j);\n    quicksort(left, depth - 1, compare);\n    quicksort(&mut rest[1..], depth - 1, compare);\n}\n\n// The heapsort's heap: sifts v[i] down within v.\nfn sift_down<T, F: FnMut(&T, &T) -> Ordering>(v: &mut [T], i: usize, compare: &mut F) {\n    let end = v.len();\n    let mut root = i;\n    loop {\n        let mut child = 2 * root + 1;\n        if child >= end {\n            return;\n        }\n");
    buf_str(out, c"        if child + 1 < end && compare(&v[child], &v[child + 1]) == Ordering::Less {\n            child += 1;\n        }\n        if compare(&v[root], &v[child]) != Ordering::Less {\n            return;\n        }\n        v.swap(root, child);\n        root = child;\n    }\n}\n\n// What indexes a T (a slice or a str): usize for one element, the ranges\n// for a subslice. Sealed: only std implements it. `s[i]` and `s.get(i)`\n// go through it, so one `get` takes an index or a range.\npub trait SliceIndex<T: ?Sized> {\n    type Output: ?Sized;\n\n    fn get(self, slice: &T) -> Option<&Self::Output>;\n    fn get_mut(self, slice: &mut T) -> Option<&mut Self::Output>;\n    // Panics when out of bounds.\n    fn index(self, slice: &T) -> &Self::Output;\n    fn index_mut(self, slice: &mut T) -> &mut Self::Output;\n}\n\nimpl<T> SliceIndex<[T]> for usize {\n    type Output = T;\n\n    fn get(self, slice: &[T]) -> Option<&T> {\n        if self < slice.len() {\n            let p = slice.as_ptr();\n            // UNSAFE: a reference made from the slice's pointer (the primitive\n            // under `s[i]`).\n            // SAFETY: self < len, so element self is in the slice and initialized;\n            // the reference lives as long as the slice's borrow.\n            Option::Some(unsafe { &*p.add(self) })\n        } else {\n            Option::None\n        }\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut T> {\n        if self < slice.len() {\n            let p = slice.as_mut_ptr();\n            // UNSAFE: as get's.\n            // SAFETY: self < len; the &mut lives as long as the slice's &mut.\n            Option::Some(unsafe { &mut *p.add(self) })\n        } else {\n            Option::None\n        }\n    }\n\n    fn index(self, slice: &[T]) -> &T {\n        let n = slice.len();\n        match self.get(slice) {\n            Option::Some(x) => x,\n            Option::None => crate::panic::panic(\n");
    buf_str(out, c"                \"index out of bounds: the len is {} but the index is {}\", n, self),\n        }\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut T {\n        let n = slice.len();\n        match self.get_mut(slice) {\n            Option::Some(x) => x,\n            Option::None => crate::panic::panic(\n                \"index out of bounds: the len is {} but the index is {}\", n, self),\n        }\n    }\n}\n\nimpl<T> SliceIndex<[T]> for Range<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        if self.start > self.end || self.end > slice.len() {\n            return Option::None;\n        }\n        let p = slice.as_ptr();\n        // UNSAFE: a subslice made from the slice's pointer (the primitive under\n        // `&s[a..b]`).\n        // SAFETY: start <= end <= len, so [start, end) lies in the slice; it\n        // lives as long as the slice's borrow.\n        Option::Some(unsafe { from_raw_parts(p.add(self.start), self.end - self.start) })\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        if self.start > self.end || self.end > slice.len() {\n            return Option::None;\n        }\n        let p = slice.as_mut_ptr();\n        // UNSAFE: as get's.\n        // SAFETY: start <= end <= len; the &mut lives as long as the slice's &mut.\n        Option::Some(unsafe { from_raw_parts_mut(p.add(self.start), self.end - self.start) })\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        let n = slice.len();\n        if self.start > self.end {\n            crate::panic::panic(\"slice index starts at {} but ends at {}\", self.start, self.end);\n        }\n        if self.end > n {\n            crate::panic::panic(\"range end index {} out of range for slice of length {}\", self.end,\n                n);\n        }\n        match self.get(slice) {\n            Option::Some(s) => s,\n            Option::None => crate::panic::unreachable(),\n        }\n    }\n\n");
    buf_str(out, c"    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        let n = slice.len();\n        if self.start > self.end {\n            crate::panic::panic(\"slice index starts at {} but ends at {}\", self.start, self.end);\n        }\n        if self.end > n {\n            crate::panic::panic(\"range end index {} out of range for slice of length {}\", self.end,\n                n);\n        }\n        match self.get_mut(slice) {\n            Option::Some(s) => s,\n            Option::None => crate::panic::unreachable(),\n        }\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeInclusive<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        if *self.end() == usize::MAX {\n            return Option::None;\n        }\n        (*self.start()..*self.end() + 1).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        if *self.end() == usize::MAX {\n            return Option::None;\n        }\n        (*self.start()..*self.end() + 1).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        if *self.end() == usize::MAX {\n            crate::panic::panic(\"attempted to index slice up to maximum usize\");\n        }\n        (*self.start()..*self.end() + 1).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        if *self.end() == usize::MAX {\n            crate::panic::panic(\"attempted to index slice up to maximum usize\");\n        }\n        (*self.start()..*self.end() + 1).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeFrom<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (self.start..slice.len()).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        let n = slice.len();\n        (self.start..n).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (self.start..slice.len()).index(slice)\n    }\n\n");
    buf_str(out, c"    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        let n = slice.len();\n        (self.start..n).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeTo<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (0..self.end).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        (0..self.end).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (0..self.end).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        (0..self.end).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeToInclusive<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (0..=self.end).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        (0..=self.end).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (0..=self.end).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        (0..=self.end).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeFull {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        Option::Some(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        Option::Some(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        slice\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        slice\n    }\n}\n\n// `s[i]` and `&s[a..b]`: built in for slices in 0.27.0; this is the trait's.\nimpl<T, I: SliceIndex<[T]>> Index<I> for [T] {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\nimpl<T, I: SliceIndex<[T]>> IndexMut<I> for [T] {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self)\n    }\n}\n\n// Element by element; any two slices whose elements compare.\n// mvs: [T]::impl Eq\n");
    buf_str(out, c"// std: changed: PartialEq over any [T] (MVS: Eq for [u8] and structural ==)\nimpl<T: PartialEq<U>, U> PartialEq<[U]> for [T] {\n    fn eq(&self, other: &[U]) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        if crate::mem::is_bytewise_eq::<T, U>() {\n            // UNSAFE: the two slices compared as blocks of bytes (memcmp): a\n            // compare and two bounds checks per element otherwise (the\n            // compiler's assembler compares every line with its memo, every\n            // name with its symbol's). For slices of a few bytes the call\n            // costs about 22 instructions more than the loop did, where\n            // this is inlined into a loop that had no call (measured:\n            // bench/std/hash_str's keys of 1 to 4 bytes in the table's\n            // probe, 4.6% of the run). Tried and no better there: the\n            // loop kept below 16 bytes (4.1%), this function inline or\n            // never inline, the compare out of line, cold or called last\n            // (6.9% to 8.2%).\n            // SAFETY: T and U are one integer type or bool (is_bytewise_eq):\n            // no padding, and equal values are equal bytes; both slices\n            // have len() elements (tested above), so len() * size_of::<T>()\n            // readable bytes each.\n            return unsafe {\n                crate::ptr::bytes_equal(self.as_ptr() as *const u8, other.as_ptr() as *const u8,\n                    self.len() * crate::mem::size_of::<T>())\n            };\n        }\n        let mut i: usize = 0;\n        while i < self.len() {\n            if self[i] != other[i] {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n}\n\nimpl<T: Eq> Eq for [T] {}\n\n// Lexicographic.\nimpl<T: PartialOrd> PartialOrd for [T] {\n    fn partial_cmp(&self, other: &[T]) -> Option<Ordering> {\n        let n = crate::cmp::min(self.len(), other.len());\n");
    buf_str(out, c"        let mut i: usize = 0;\n        while i < n {\n            match self[i].partial_cmp(&other[i]) {\n                Option::Some(Ordering::Equal) => {}\n                c => return c,\n            }\n            i += 1;\n        }\n        self.len().partial_cmp(&other.len())\n    }\n}\n\n// mvs: [T]::impl Ord\n// std: changed: Ord over any [T] (MVS: Ord for [u8])\nimpl<T: Ord> Ord for [T] {\n    fn cmp(&self, other: &[T]) -> Ordering {\n        let n = crate::cmp::min(self.len(), other.len());\n        let mut i: usize = 0;\n        while i < n {\n            match self[i].cmp(&other[i]) {\n                Ordering::Equal => {}\n                c => return c,\n            }\n            i += 1;\n        }\n        self.len().cmp(&other.len())\n    }\n}\n\n// The length, then each element.\n// mvs: [T]::impl Hash\n// std: changed: Hash over any [T] (MVS: Hash for [u8])\nimpl<T: Hash> Hash for [T] {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_usize(self.len());\n        Hash::hash_slice(self, state)\n    }\n}\n\n// `[1, 2, 3]`.\n// mvs: [T]::impl Debug\n// std: changed: Debug over any [T] (MVS: Debug for [u8])\nimpl<T: Debug> Debug for [T] {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_list().entries(self.iter()).finish()\n    }\n}\n\n// `[1, 2]`: an array's Debug is its slice's. Compiler-provided for every\n// N (array_builtin, as Vec::from_in).\n#[array_builtin(N)]\nimpl<T: Debug> Debug for [T; N] {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&(*self)[..], f)\n    }\n}\n\n// An array's clone: each element's (plan §6's built-in array impls, by\n// `#[array_builtin]` until const generics).\n#[array_builtin(N)]\nimpl<T: Clone> Clone for [T; N] {\n    fn clone(&self) -> [T; N] {\n        // UNSAFE: the array is made from a bitwise copy of self whose every\n        // element is then overwritten, without a drop, by its clone: safe\n");
    buf_str(out, c"        // Rust has no array of N clones before const generics.\n        // SAFETY: out is N initialized T's, each slot written once with\n        // ptr::write (the bitwise copies are never dropped: no slot keeps\n        // one); a panicking clone ends the program (std's panic does not\n        // unwind), so no half-made out is dropped.\n        unsafe {\n            let mut out: [T; N] = crate::ptr::read(self as *const [T; N]);\n            let p = &mut out as *mut [T; N] as *mut T;\n            for i in 0..N {\n                crate::ptr::write(p.add(i), (*self)[i].clone());\n            }\n            out\n        }\n    }\n}\n\n// Arrays compare and hash as their slices.\n#[array_builtin(N)]\nimpl<T: PartialEq<U>, U> PartialEq<[U; N]> for [T; N] {\n    fn eq(&self, other: &[U; N]) -> bool {\n        (*self)[..] == (*other)[..]\n    }\n}\n\n#[array_builtin(N)]\nimpl<T: Eq> Eq for [T; N] {}\n\n#[array_builtin(N)]\nimpl<T: PartialOrd> PartialOrd for [T; N] {\n    fn partial_cmp(&self, other: &[T; N]) -> Option<Ordering> {\n        (*self)[..].partial_cmp(&(*other)[..])\n    }\n}\n\n#[array_builtin(N)]\nimpl<T: Ord> Ord for [T; N] {\n    fn cmp(&self, other: &[T; N]) -> Ordering {\n        (*self)[..].cmp(&(*other)[..])\n    }\n}\n\n#[array_builtin(N)]\nimpl<T: Hash> Hash for [T; N] {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (*self)[..].hash(state)\n    }\n}\n\n// `for x in &arr`, `for x in &mut arr`: the slice's iterators.\n#[array_builtin(N)]\nimpl<'a, T> IntoIterator for &'a [T; N] {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        (*self)[..].iter()\n    }\n}\n\n#[array_builtin(N)]\nimpl<'a, T> IntoIterator for &'a mut [T; N] {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        (*self)[..].iter_mut()\n    }\n}\n\n// A slice, and an array, view as a slice (`fs::write(p, b\"..\")`: C is\n// &[u8; N], an AsRef<[u8]>).\n");
    buf_str(out, c"impl<T> AsRef<[T]> for [T] {\n    fn as_ref(&self) -> &[T] {\n        self\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> AsRef<[T]> for [T; N] {\n    fn as_ref(&self) -> &[T] {\n        &(*self)[..]\n    }\n}\n\n// `slice.to_owned_in(a)`: a Vec<T, A> of clones.\nimpl<T: Clone, A: Allocator> ToOwnedIn<A> for [T] {\n    type Owned = Vec<T, A>;\n\n    fn to_owned_in(&self, a: A) -> Vec<T, A> {\n        self.to_vec_in(a)\n    }\n}\n\n// later: impl_for_ref\nimpl<'a, T> Default for &'a [T] {\n    fn default() -> &'a [T] {\n        // UNSAFE: an empty slice made from a dangling, aligned pointer (what\n        // `&[]` promotes to: no element is ever read).\n        // SAFETY: length 0, so no memory is reached; the pointer is non-null\n        // and aligned for T, as from_raw_parts asks.\n        unsafe { from_raw_parts(crate::ptr::NonNull::<T>::dangling().as_ptr() as *const T, 0) }\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a [T] {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a mut [T] {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n\n// [T]::iter's iterator: &T's, from either end.\npub struct Iter<'a, T> {\n    v: &'a [T],\n}\n\nimpl<'a, T> Iter<'a, T> {\n    // What is left, as a slice.\n    #[effects()]\n    pub fn as_slice(&self) -> &'a [T] {\n        self.v\n    }\n}\n\nimpl<'a, T> Clone for Iter<'a, T> {\n    fn clone(&self) -> Iter<'a, T> {\n        Iter { v: self.v }\n    }\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.v.split_first() {\n            Option::Some((x, rest)) => {\n                self.v = rest;\n                Option::Some(x)\n            }\n            Option::None => Option::None,\n        }\n    }\n\n");
    buf_str(out, c"    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.v.len(), Option::Some(self.v.len()))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Iter<'a, T> {\n    fn next_back(&mut self) -> Option<&'a T> {\n        match self.v.split_last() {\n            Option::Some((x, rest)) => {\n                self.v = rest;\n                Option::Some(x)\n            }\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Iter<'a, T> {}\n\n// [T]::iter_mut's iterator: &mut T's, from either end.\npub struct IterMut<'a, T> {\n    v: &'a mut [T],\n}\n\nimpl<'a, T> IterMut<'a, T> {\n    // What is left, as a &mut slice.\n    #[effects()]\n    pub fn into_slice(self) -> &'a mut [T] {\n        self.v\n    }\n}\n\nimpl<'a, T> Iterator for IterMut<'a, T> {\n    type Item = &'a mut T;\n\n    fn next(&mut self) -> Option<&'a mut T> {\n        let v = crate::mem::replace(&mut self.v, empty_mut());\n        if v.is_empty() {\n            return Option::None;\n        }\n        let (head, rest) = v.split_at_mut(1);\n        self.v = rest;\n        Option::Some(&mut head[0])\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.v.len(), Option::Some(self.v.len()))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for IterMut<'a, T> {\n    fn next_back(&mut self) -> Option<&'a mut T> {\n        let v = crate::mem::replace(&mut self.v, empty_mut());\n        let n = v.len();\n        if n == 0 {\n            return Option::None;\n        }\n        let (rest, tail) = v.split_at_mut(n - 1);\n        self.v = rest;\n        Option::Some(&mut tail[0])\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for IterMut<'a, T> {}\n\n// [T]::chunks's iterator.\npub struct Chunks<'a, T> {\n    v: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for Chunks<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.v.is_empty() {\n            return Option::None;\n        }\n");
    buf_str(out, c"        let n = crate::cmp::min(self.size, self.v.len());\n        let (head, tail) = self.v.split_at(n);\n        self.v = tail;\n        Option::Some(head)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = if self.v.is_empty() { 0 } else { (self.v.len() + self.size - 1) / self.size };\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Chunks<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        let n = self.v.len();\n        if n == 0 {\n            return Option::None;\n        }\n        let r = n % self.size;\n        let last = if r == 0 { self.size } else { r };\n        let (head, tail) = self.v.split_at(n - last);\n        self.v = head;\n        Option::Some(tail)\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Chunks<'a, T> {}\n\n// [T]::chunks_mut's iterator.\npub struct ChunksMut<'a, T> {\n    v: &'a mut [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for ChunksMut<'a, T> {\n    type Item = &'a mut [T];\n\n    fn next(&mut self) -> Option<&'a mut [T]> {\n        let v = crate::mem::replace(&mut self.v, empty_mut());\n        if v.is_empty() {\n            return Option::None;\n        }\n        let n = crate::cmp::min(self.size, v.len());\n        let (head, tail) = v.split_at_mut(n);\n        self.v = tail;\n        Option::Some(head)\n    }\n}\n\n// [T]::chunks_exact's iterator.\npub struct ChunksExact<'a, T> {\n    v: &'a [T],\n    rem: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> ChunksExact<'a, T> {\n    // The elements past the last whole chunk.\n    #[effects()]\n    pub fn remainder(&self) -> &'a [T] {\n        self.rem\n    }\n}\n\nimpl<'a, T> Iterator for ChunksExact<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.v.len() < self.size {\n            return Option::None;\n        }\n        let (head, tail) = self.v.split_at(self.size);\n        self.v = tail;\n        Option::Some(head)\n    }\n\n");
    buf_str(out, c"    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = self.v.len() / self.size;\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for ChunksExact<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        let n = self.v.len();\n        if n < self.size {\n            return Option::None;\n        }\n        let (head, tail) = self.v.split_at(n - self.size);\n        self.v = head;\n        Option::Some(tail)\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for ChunksExact<'a, T> {}\n\n// [T]::windows's iterator.\npub struct Windows<'a, T> {\n    v: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for Windows<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.size > self.v.len() {\n            return Option::None;\n        }\n        let w = &self.v[..self.size];\n        self.v = &self.v[1..];\n        Option::Some(w)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = if self.size > self.v.len() { 0 } else { self.v.len() - self.size + 1 };\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Windows<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        let n = self.v.len();\n        if self.size > n {\n            return Option::None;\n        }\n        let w = &self.v[n - self.size..];\n        self.v = &self.v[..n - 1];\n        Option::Some(w)\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Windows<'a, T> {}\n\n// [T]::split's iterator.\npub struct Split<'a, T, P> {\n    v: &'a [T],\n    pred: P,\n    finished: bool,\n}\n\nimpl<'a, T, P: FnMut(&T) -> bool> Iterator for Split<'a, T, P> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.finished {\n            return Option::None;\n        }\n        let mut i: usize = 0;\n        while i < self.v.len() {\n            if (self.pred)(&self.v[i]) {\n                let head = &self.v[..i];\n");
    buf_str(out, c"                self.v = &self.v[i + 1..];\n                return Option::Some(head);\n            }\n            i += 1;\n        }\n        self.finished = true;\n        Option::Some(self.v)\n    }\n}\n\nimpl<'a, T, P: FnMut(&T) -> bool> DoubleEndedIterator for Split<'a, T, P> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        if self.finished {\n            return Option::None;\n        }\n        let mut i = self.v.len();\n        while i > 0 {\n            i -= 1;\n            if (self.pred)(&self.v[i]) {\n                let tail = &self.v[i + 1..];\n                self.v = &self.v[..i];\n                return Option::Some(tail);\n            }\n        }\n        self.finished = true;\n        Option::Some(self.v)\n    }\n}\n// ---- end mod std::slice ----\n}\n// ---- mod std::array ----\npub mod array {\n// std::array: an array's by-value iterator. Its impls are compiler-provided\n// for every length N (`#[array_builtin(N)]`, F15.3) until const generics.\n\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};\nuse crate::marker::PhantomData;\nuse crate::mem::ManuallyDrop;\nuse crate::option::Option;\n\n// `[T; N]::into_iter`'s: the elements by value, each once; the ones not\n// yielded are dropped with it.\n// (Rust's is IntoIter<T, const N: usize>; const generics, 0.29, make it so)\n// std: changed: IntoIter<T, [T; N]> until const generics (FL13)\npub struct IntoIter<T, Arr> {\n    data: ManuallyDrop<Arr>,\n    start: usize,\n    end: usize,\n    marker: PhantomData<T>,\n}\n\n#[array_builtin(N)]\nimpl<T> IntoIterator for [T; N] {\n    type Item = T;\n    type IntoIter = IntoIter<T, [T; N]>;\n\n    fn into_iter(self) -> IntoIter<T, [T; N]> {\n        IntoIter { data: ManuallyDrop::new(self), start: 0, end: N, marker: PhantomData }\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> IntoIter<T, [T; N]> {\n    // The address of element i.\n    fn slot(&mut self, i: usize) -> *mut T {\n");
    buf_str(out, c"        let base = &mut *self.data as *mut [T; N] as *mut T;\n        // UNSAFE: an offset in the array.\n        // SAFETY: i < N (start <= i < end <= N at every call).\n        unsafe { base.add(i) }\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> Iterator for IntoIter<T, [T; N]> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        let p = self.slot(self.start);\n        self.start += 1;\n        // UNSAFE: moves element start out.\n        // SAFETY: it was in [start, end), initialized, and start moving\n        // past it means it is read once.\n        Option::Some(unsafe { crate::ptr::read(p as *const T) })\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.end - self.start, Option::Some(self.end - self.start))\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> DoubleEndedIterator for IntoIter<T, [T; N]> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        self.end -= 1;\n        let p = self.slot(self.end);\n        // UNSAFE: moves element end out.\n        // SAFETY: it was in [start, end) and, end moving below it, is read once.\n        Option::Some(unsafe { crate::ptr::read(p as *const T) })\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> ExactSizeIterator for IntoIter<T, [T; N]> {}\n\n#[array_builtin(N)]\nimpl<T> Drop for IntoIter<T, [T; N]> {\n    fn drop(&mut self) {\n        while self.start < self.end {\n            let p = self.slot(self.start);\n            self.start += 1;\n            // UNSAFE: drops an element not yielded.\n            // SAFETY: [start, end) is initialized, each dropped once (start\n            // moved past it first); the array itself is a ManuallyDrop.\n            unsafe { crate::ptr::drop_in_place(p) };\n        }\n    }\n}\n// ---- end mod std::array ----\n}\n// ---- mod std::str ----\npub mod str {\n");
    buf_str(out, c"// std::str: the methods of str, UTF-8 text, always behind a reference\n// (`&str`: MVS's `str` view), its iterators, Pattern, FromStr and\n// from_utf8. A String has them all through Deref. What reads returns\n// views of the text (`trim`, `split`, `strip_prefix`); what allocates\n// takes an allocator, Rust's name with `_in` (`to_uppercase_in(a)`,\n// `replace_in(from, to, a)`: plan §2). Indices are byte offsets, usize.\n// The text's code points are `char`s (0.27.2: the rust front's char\n// type; MVS had none and used u32).\n\nuse crate::alloc::Allocator;\nuse crate::borrow::ToOwnedIn;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::AsRef;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, Iterator};\nuse crate::ops::{Index, Range, RangeFrom, RangeFull, RangeInclusive, RangeTo, RangeToInclusive};\nuse crate::option::Option;\nuse crate::option::Option::{None, Some};\nuse crate::result::Result;\nuse crate::result::Result::{Err, Ok};\nuse crate::slice::SliceIndex;\nuse crate::string::String;\n\n// (std::str::lossy_next and ascii_printable_prefix_len, where the old std\n// had them: std::unicode's, called from here: std::unicode is read only\n// by a program, or a function it reaches, that names `unicode`)\n\n// The code point at v[*pos] (pos is less than v's length), and pos moved\n// past it; a broken sequence reads as U+FFFD and is skipped whole.\n#[inline]\n#[effects(panic)]\npub fn lossy_next(v: &[u8], pos: &mut usize) -> u32 {\n    crate::unicode::lossy_next(v, pos)\n}\n\n// The length of v's longest prefix of printable ASCII, 0x20 to 0x7E.\n#[inline]\n#[effects(panic)]\npub fn ascii_printable_prefix_len(v: &[u8]) -> usize {\n    crate::unicode::ascii_printable_prefix_len(v)\n}\n\nimpl str {\n    // bytes as a str when they are UTF-8 (Rust 1.87's inherent form;\n    // `std::str::from_utf8` too).\n");
    buf_str(out, c"    // std: changed: &[u8] to &str\n    #[effects(panic, diverge)]\n    pub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {\n        from_utf8(v)\n    }\n\n    #[effects(unsafe)]\n    // UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {\n        // UNSAFE: the free function's contract, passed on.\n        // SAFETY: the caller's: v is UTF-8.\n        unsafe { from_utf8_unchecked(v) }\n    }\n\n    // Its length in bytes.\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.as_bytes().len()\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    #[effects()]\n    pub fn as_bytes(&self) -> &[u8] {\n        // A &str is a &[u8] that promises UTF-8, the same fat pointer (built\n        // in: Rust's core casts the pointer, `&*(self as *const str as\n        // *const [u8])`).\n        self as &[u8]\n    }\n\n    // The same bytes, writable as a str (an ASCII case change in place).\n    #[effects()]\n    pub fn as_ptr(&self) -> *const u8 {\n        self.as_bytes().as_ptr()\n    }\n\n    // Whether byte i starts a code point (or is the end).\n    #[effects(panic)]\n    pub fn is_char_boundary(&self, i: usize) -> bool {\n        if i == 0 {\n            return true;\n        }\n        let b = self.as_bytes();\n        if i < b.len() {\n            // not a continuation byte (10xx_xxxx)\n            b[i] & 0xC0 != 0x80\n        } else {\n            i == b.len()\n        }\n    }\n\n    // The closest byte index at or below i that starts a code point: i\n    // itself when it does, len() when i is past the end (Rust's).\n    #[effects(panic)]\n    pub fn floor_char_boundary(&self, i: usize) -> usize {\n        if i >= self.len() {\n            return self.len();\n        }\n        let mut k = i;\n        // (a code point has at most three continuation bytes, and byte 0\n");
    buf_str(out, c"        // starts one)\n        for _ in 0..3 {\n            if self.is_char_boundary(k) {\n                break;\n            }\n            k -= 1;\n        }\n        k\n    }\n\n    // The closest byte index at or above i that starts a code point, or\n    // len() (when i is past the end too).\n    #[effects(panic)]\n    pub fn ceil_char_boundary(&self, i: usize) -> usize {\n        if i >= self.len() {\n            return self.len();\n        }\n        let mut k = i;\n        for _ in 0..3 {\n            if self.is_char_boundary(k) {\n                break;\n            }\n            k += 1;\n        }\n        k\n    }\n\n    #[effects()]\n    pub fn is_ascii(&self) -> bool {\n        for b in self.as_bytes() {\n            if *b >= 0x80 {\n                return false;\n            }\n        }\n        true\n    }\n\n    // The subslice a byte range names; None when out of bounds or not on\n    // char boundaries.\n    #[effects(I)]\n    pub fn get<I: SliceIndex<str>>(&self, i: I) -> Option<&I::Output> {\n        i.get(self)\n    }\n\n    // [0, mid) and [mid, len); panics when mid is not a char boundary.\n    #[effects(panic)]\n    pub fn split_at(&self, mid: usize) -> (&str, &str) {\n        (&self[..mid], &self[mid..])\n    }\n\n    // Its code points.\n    // std: changed: yields char (MVS: u32)\n    #[effects()]\n    pub fn chars(&self) -> Chars<'_> {\n        Chars { rest: self }\n    }\n\n    // Its code points with their byte offsets.\n    // std: changed: yields (usize, char) (MVS: (i64, u32))\n    #[effects()]\n    pub fn char_indices(&self) -> CharIndices<'_> {\n        CharIndices { front: 0, chars: self.chars() }\n    }\n\n    // Its bytes.\n    // std: changed: a Bytes<'_> of u8 (MVS: a SliceIter<u8>)\n    #[effects()]\n    pub fn bytes(&self) -> Bytes<'_> {\n        Bytes { inner: self.as_bytes().iter() }\n    }\n\n    // Its lines, without their \"\\n\" or \"\\r\\n\"; a last empty line is not one.\n    #[effects()]\n");
    buf_str(out, c"    pub fn lines(&self) -> Lines<'_> {\n        Lines { rest: self }\n    }\n\n    // The pieces between the matches of p.\n    #[effects(P)]\n    pub fn split<P: Pattern>(&self, p: P) -> Split<'_, P> {\n        Split::new(self, p, true)\n    }\n\n    // The same, from the end.\n    #[effects(P)]\n    pub fn rsplit<P: Pattern>(&self, p: P) -> RSplit<'_, P> {\n        RSplit { inner: Split::new(self, p, true) }\n    }\n\n    // At most n pieces: the last holds the rest.\n    // std: changed: n is usize\n    #[effects(P)]\n    pub fn splitn<P: Pattern>(&self, n: usize, p: P) -> SplitN<'_, P> {\n        SplitN { inner: Split::new(self, p, true), count: n }\n    }\n\n    #[effects(P)]\n    pub fn rsplitn<P: Pattern>(&self, n: usize, p: P) -> RSplitN<'_, P> {\n        RSplitN { inner: Split::new(self, p, true), count: n }\n    }\n\n    // split, without an empty last piece (\"a,b,\" gives \"a\" and \"b\").\n    #[effects(P)]\n    pub fn split_terminator<P: Pattern>(&self, p: P) -> SplitTerminator<'_, P> {\n        SplitTerminator { inner: Split::new(self, p, false) }\n    }\n\n    // split, each piece with the match that ends it.\n    #[effects(P)]\n    pub fn split_inclusive<P: Pattern>(&self, p: P) -> SplitInclusive<'_, P> {\n        SplitInclusive { inner: Split::new(self, p, false) }\n    }\n\n    // The pieces between runs of Unicode white space.\n    #[effects()]\n    pub fn split_whitespace(&self) -> SplitWhitespace<'_> {\n        SplitWhitespace { rest: self }\n    }\n\n    // The pieces between runs of ASCII white space.\n    #[effects()]\n    pub fn split_ascii_whitespace(&self) -> SplitAsciiWhitespace<'_> {\n        SplitAsciiWhitespace { rest: self }\n    }\n\n    // Before and after the first match of p.\n    #[effects(panic, diverge, P)]\n    pub fn split_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((a, b)) => Some((&self[..a], &self[b..])),\n");
    buf_str(out, c"            None => None,\n        }\n    }\n\n    // Before and after the last match of p.\n    #[effects(panic, P)]\n    pub fn rsplit_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((a, b)) => Some((&self[..a], &self[b..])),\n            None => None,\n        }\n    }\n\n    // The matches of p.\n    #[effects()]\n    pub fn matches<P: Pattern>(&self, p: P) -> Matches<'_, P> {\n        Matches { hay: self, at: 0, pat: p }\n    }\n\n    // The matches of p with their byte offsets.\n    #[effects()]\n    pub fn match_indices<P: Pattern>(&self, p: P) -> MatchIndices<'_, P> {\n        MatchIndices { hay: self, at: 0, pat: p }\n    }\n\n    // The byte offset of the first match of p.\n    #[effects(panic, diverge, P)]\n    pub fn find<P: Pattern>(&self, p: P) -> Option<usize> {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((a, _)) => Some(a),\n            None => None,\n        }\n    }\n\n    // The byte offset of the last match of p.\n    #[effects(panic, diverge, P)]\n    pub fn rfind<P: Pattern>(&self, p: P) -> Option<usize> {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((a, _)) => Some(a),\n            None => None,\n        }\n    }\n\n    #[effects(P)]\n    pub fn contains<P: Pattern>(&self, p: P) -> bool {\n        self.find(p).is_some()\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn starts_with<P: Pattern>(&self, p: P) -> bool {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((a, _)) => a == 0,\n            None => false,\n        }\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn ends_with<P: Pattern>(&self, p: P) -> bool {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((_, b)) => b == self.len(),\n            None => false,\n        }\n    }\n\n");
    buf_str(out, c"    // The rest after p, when it starts with p.\n    #[effects(panic, diverge, P)]\n    pub fn strip_prefix<P: Pattern>(&self, p: P) -> Option<&str> {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((0, b)) => Some(&self[b..]),\n            _ => None,\n        }\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn strip_suffix<P: Pattern>(&self, p: P) -> Option<&str> {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((a, b)) if b == self.len() => Some(&self[..a]),\n            _ => None,\n        }\n    }\n\n    // Without leading and trailing Unicode white space.\n    #[effects(panic, diverge)]\n    pub fn trim(&self) -> &str {\n        self.trim_start().trim_end()\n    }\n\n    #[effects(panic, diverge)]\n    pub fn trim_start(&self) -> &str {\n        let mut it = self.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if !c.is_whitespace() {\n                        return &self[i..];\n                    }\n                }\n                None => return \"\",\n            }\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn trim_end(&self) -> &str {\n        let mut it = self.char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if !c.is_whitespace() {\n                        return &self[..i + c.len_utf8()];\n                    }\n                }\n                None => return \"\",\n            }\n        }\n    }\n\n    // Without leading and trailing ASCII white space.\n    #[effects(panic, diverge)]\n    pub fn trim_ascii(&self) -> &str {\n        let b = self.as_bytes();\n        let mut i: usize = 0;\n        let mut j: usize = b.len();\n        while i < j && is_ascii_space(b[i]) {\n            i += 1;\n        }\n        while j > i && is_ascii_space(b[j - 1]) {\n            j -= 1;\n        }\n        &self[i..j]\n");
    buf_str(out, c"    }\n\n    // Without the leading and trailing matches of p.\n    #[effects(panic, diverge, P)]\n    pub fn trim_matches<P: Pattern>(&self, p: P) -> &str {\n        let mut p = p;\n        let mut i: usize = 0;\n        let mut j: usize = self.len();\n        loop {\n            match p.next_match(self, i) {\n                Some((a, b)) if a == i && b > a => i = b,\n                _ => break,\n            }\n        }\n        loop {\n            match p.next_match_back(self, j) {\n                Some((a, b)) if b == j && a < b && a >= i => j = a,\n                _ => break,\n            }\n        }\n        &self[i..j]\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn trim_start_matches<P: Pattern>(&self, p: P) -> &str {\n        let mut p = p;\n        let mut i: usize = 0;\n        loop {\n            match p.next_match(self, i) {\n                Some((a, b)) if a == i && b > a => i = b,\n                _ => break,\n            }\n        }\n        &self[i..]\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn trim_end_matches<P: Pattern>(&self, p: P) -> &str {\n        let mut p = p;\n        let mut j: usize = self.len();\n        loop {\n            match p.next_match_back(self, j) {\n                Some((a, b)) if b == j && a < b => j = a,\n                _ => break,\n            }\n        }\n        &self[..j]\n    }\n\n    #[effects(panic)]\n    pub fn eq_ignore_ascii_case(&self, other: &str) -> bool {\n        let a = self.as_bytes();\n        let b = other.as_bytes();\n        if a.len() != b.len() {\n            return false;\n        }\n        let mut i: usize = 0;\n        while i < a.len() {\n            if ascii_lower(a[i]) != ascii_lower(b[i]) {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n\n    // Its ASCII letters made lower case, in place.\n    #[effects(panic, diverge, unsafe)]\n    pub fn make_ascii_lowercase(&mut self) {\n");
    buf_str(out, c"        // UNSAFE: the bytes of a &mut str, written.\n        // SAFETY: an ASCII case change maps ASCII bytes to ASCII bytes and leaves\n        // the others, so the text stays UTF-8.\n        let b = unsafe { bytes_mut(self) };\n        let mut i: usize = 0;\n        while i < b.len() {\n            b[i] = ascii_lower(b[i]);\n            i += 1;\n        }\n    }\n\n    #[effects(panic, diverge, unsafe)]\n    pub fn make_ascii_uppercase(&mut self) {\n        // UNSAFE: the bytes of a &mut str, written.\n        // SAFETY: an ASCII case change maps ASCII bytes to ASCII bytes and leaves\n        // the others, so the text stays UTF-8.\n        let b = unsafe { bytes_mut(self) };\n        let mut i: usize = 0;\n        while i < b.len() {\n            b[i] = ascii_upper(b[i]);\n            i += 1;\n        }\n    }\n\n    // The text as a T (`\"42\".parse::<i64>()`): numbers, bool, char.\n    #[effects(F)]\n    pub fn parse<F: FromStr>(&self) -> Result<F, F::Err> {\n        F::from_str(self)\n    }\n\n    // Its width in terminal columns (East Asian wide as 2, combining as 0):\n    // vole's, kept from MVS.\n    // std: changed: usize\n    #[effects(panic, diverge)]\n    pub fn width(&self) -> usize {\n        let mut n: usize = 0;\n        let mut it = self.graphemes(true);\n        while let Some(g) = it.next() {\n            n += cluster_width(g, false);\n        }\n        n\n    }\n\n    // width, with East Asian ambiguous characters as 2.\n    // std: changed: usize\n    #[effects(panic, diverge)]\n    pub fn width_cjk(&self) -> usize {\n        let mut n: usize = 0;\n        let mut it = self.graphemes(true);\n        while let Some(g) = it.next() {\n            n += cluster_width(g, true);\n        }\n        n\n    }\n\n    // Its grapheme clusters (UAX #29; extended or legacy): vole's.\n    #[effects()]\n    pub fn graphemes(&self, extended: bool) -> Graphemes<'_> {\n        Graphemes { rest: self, extended: extended }\n    }\n\n");
    buf_str(out, c"    // A String of it, on a.\n    #[effects(A)]\n    pub fn to_string_in<A: Allocator>(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    #[effects(A)]\n    pub fn to_owned_in<A: Allocator>(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_lowercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        // Each char maps alone, but a capital sigma at a word's end, which\n        // is final sigma, as Rust's (Unicode's Final_Sigma context).\n        let mut s = String::with_capacity_in(self.len(), a);\n        let mut it = self.char_indices();\n        while let Some((i, c)) = it.next() {\n            if c == '\\u{3A3}' {\n                let fin = cased_before(&self[..i]) && !cased_after(&self[i + 2..]);\n                s.push(if fin { '\\u{3C2}' } else { '\\u{3C3}' });\n                continue;\n            }\n            let mut m = c.to_lowercase();\n            while let Some(l) = m.next() {\n                s.push(l);\n            }\n        }\n        s\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_uppercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        let mut s = String::with_capacity_in(self.len(), a);\n        let mut it = self.chars();\n        while let Some(c) = it.next() {\n            let mut m = c.to_uppercase();\n            while let Some(u) = m.next() {\n                s.push(u);\n            }\n        }\n        s\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_ascii_lowercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        let mut s = String::from_in(self, a);\n        s.as_mut_str().make_ascii_lowercase();\n        s\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_ascii_uppercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        let mut s = String::from_in(self, a);\n        s.as_mut_str().make_ascii_uppercase();\n        s\n    }\n\n    // A copy with every match of from replaced by to.\n");
    buf_str(out, c"    #[effects(panic, diverge, P, A)]\n    pub fn replace_in<P: Pattern, A: Allocator>(&self, from: P, to: &str, a: A) -> String<A> {\n        let mut result = String::new_in(a);\n        let mut last: usize = 0;\n        let mut it = self.match_indices(from);\n        while let Some((start, part)) = it.next() {\n            result.push_str(&self[last..start]);\n            result.push_str(to);\n            last = start + part.len();\n        }\n        result.push_str(&self[last..]);\n        result\n    }\n\n    // The same, the first n matches.\n    // std: changed: n is usize\n    #[effects(panic, diverge, P, A)]\n    pub fn replacen_in<P: Pattern,\n        A: Allocator>(&self, from: P, to: &str, n: usize, a: A) -> String<A> {\n        let mut result = String::with_capacity_in(32, a);\n        let mut last: usize = 0;\n        let mut left = n;\n        let mut it = self.match_indices(from);\n        while let Some((start, part)) = it.next() {\n            if left == 0 {\n                break;\n            }\n            left -= 1;\n            result.push_str(&self[last..start]);\n            result.push_str(to);\n            last = start + part.len();\n        }\n        result.push_str(&self[last..]);\n        result\n    }\n\n    // n copies end to end.\n    #[effects(A)]\n    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> String<A> {\n        let mut s = String::with_capacity_in(self.len() * n, a);\n        let mut i: usize = 0;\n        while i < n {\n            s.push_str(self);\n            i += 1;\n        }\n        s\n    }\n}\n\n// v as a str when it is UTF-8.\n// mvs: validate_utf8\n// std: changed: returns the &str\n#[effects(panic, diverge, unsafe)]\npub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {\n    let n = v.len();\n    let mut i: usize = 0;\n    // (a v of sixteen bytes or more by blocks of sixteen: its ASCII\n    // start; then, after its first sequences byte by byte when there are\n");
    buf_str(out, c"    // not three bytes behind for the blocks to look back at, the blocks,\n    // up to v's end, its last sequence or the block with an error; the\n    // bytes left, and a short v, byte by byte)\n    let mut until = n;\n    if n >= 16 {\n        i = utf8_ascii_blocks(v);\n        if i < n {\n            until = if i < 3 { 3 } else { i };\n        }\n    }\n    loop {\n        while i < until {\n            let b = v[i];\n            if b < 0x80 {\n                i += 1;\n                continue;\n            }\n            // the sequence's length, and the range its second byte must be\n            // in (no overlong forms, no surrogates, nothing over U+10FFFF)\n            let (w, lo, hi): (usize, u8, u8) = if b >= 0xC2 && b <= 0xDF {\n                (2, 0x80, 0xBF)\n            } else if b == 0xE0 {\n                (3, 0xA0, 0xBF)\n            } else if b == 0xED {\n                (3, 0x80, 0x9F)\n            } else if b >= 0xE1 && b <= 0xEF {\n                (3, 0x80, 0xBF)\n            } else if b == 0xF0 {\n                (4, 0x90, 0xBF)\n            } else if b >= 0xF1 && b <= 0xF3 {\n                (4, 0x80, 0xBF)\n            } else if b == 0xF4 {\n                (4, 0x80, 0x8F)\n            } else {\n                return Err(Utf8Error { valid_up_to: i, error_len: Some(1) });\n            };\n            let mut k: usize = 1;\n            while k < w {\n                if i + k >= n {\n                    return Err(Utf8Error { valid_up_to: i, error_len: None });\n                }\n                let c = v[i + k];\n                let ok = if k == 1 { c >= lo && c <= hi } else { c & 0xC0 == 0x80 };\n                if !ok {\n                    return Err(Utf8Error { valid_up_to: i, error_len: Some(k as u8) });\n                }\n                k += 1;\n            }\n            i += w;\n        }\n        if until == n {\n            break;\n        }\n        i = utf8_valid_blocks(v, i);\n        until = n;\n    }\n");
    buf_str(out, c"    // UNSAFE: the checked bytes as a str.\n    // SAFETY: every sequence of v was checked to be UTF-8: by the blocks,\n    // and from where they stopped by the byte loop.\n    Ok(unsafe { from_utf8_unchecked(v) })\n}\n\n// ---- UTF-8 validation by blocks (0.30) ----\n//\n// Sixteen bytes a step, with the vector types' compares (NEON, SSE2): a\n// byte breaks UTF-8 when it is a continuation byte where the three bytes\n// before it ask for none, or is none where they ask for one; when it is\n// the second byte of an overlong form, a surrogate or a value past\n// U+10FFFF (the lead bytes E0, ED, F0, F4 each narrow their second\n// byte's range); or when it is a byte no sequence has (C0, C1, F5..FF).\n// A block of four vectors with no high bit is ASCII, and only ends what\n// the bytes before it began. The blocks say whether a byte is wrong, not\n// which or why: from_utf8's byte loop finds the error and makes the\n// Utf8Error, from the start of the sequence, and is what the blocks are\n// tested against (tests/run/std_str_from_utf8_blocks.vl).\n\n// The constants of utf8_block_errors, a register each.\nstruct Utf8Consts {\n    cont_max: v16i8,\n    c0: v16u8,\n    x80: v16u8,\n    e0: v16u8,\n    f0: v16u8,\n    a0: v16u8,\n    x90: v16u8,\n    ed: v16u8,\n    f4: v16u8,\n    f5: v16u8,\n    fe: v16u8,\n}\n\n// The errors of the sixteen bytes cur = w[at + 3..at + 19], given the\n// three before them: a lane is not 0 where its byte breaks UTF-8.\n#[inline]\nfn utf8_block_errors(w: &[u8], at: i64, cur: v16u8, k: &Utf8Consts) -> v16u8 {\n    let p1 = v16u8::load(w, at + 2);\n    let p2 = v16u8::load(w, at + 1);\n    let p3 = v16u8::load(w, at);\n    // (a continuation byte, 0x80..0xBF, is below -64 as an i8)\n    let is_cont = v16u8::from_bits(v16i8::from_bits(cur) < k.cont_max);\n    let must = (p1 >= k.c0) | (p2 >= k.e0) | (p3 >= k.f0);\n    // (after E0 a byte below A0 is overlong, after ED one from A0 on is a\n");
    buf_str(out, c"    // surrogate; after F0 one below 90 is overlong, after F4 one from 90\n    // on is past U+10FFFF: the lead byte that makes cur wrong)\n    let special = (p1 == (cur < k.a0).select(k.e0, k.ed))\n        | (p1 == (cur < k.x90).select(k.f0, k.f4));\n    let no_lead = (cur >= k.f5) | ((cur & k.fe) == k.c0);\n    (must ^ is_cont) | special | no_lead\n}\n\n// Whether a lane of e is not 0.\n#[inline]\nfn any_lane(e: v16u8) -> bool {\n    let w = v2u64::from_bits(e);\n    (w.lane(0) | w.lane(1)) != 0\n}\n\n// The length of v's ASCII start, by blocks: v's length when v is ASCII\n// (its last block is its last sixteen bytes), else the blocks of sixteen\n// before the first byte with its high bit. v has sixteen bytes or more.\nfn utf8_ascii_blocks(v: &[u8]) -> usize {\n    let n = v.len();\n    let high = v16u8::splat(0x80);\n    let mut i: usize = 0;\n    while i + 64 <= n {\n        let w = &v[i..i + 64];\n        let m = v16u8::load(w, 0) | v16u8::load(w, 16) | v16u8::load(w, 32) | v16u8::load(w, 48);\n        if any_lane(m & high) {\n            break;\n        }\n        i += 64;\n    }\n    while i + 16 <= n {\n        let w = &v[i..i + 16];\n        if any_lane(v16u8::load(w, 0) & high) {\n            return i;\n        }\n        i += 16;\n    }\n    if i < n && n >= 16 {\n        let w = &v[n - 16..n];\n        if !any_lane(v16u8::load(w, 0) & high) {\n            i = n;\n        }\n    }\n    i\n}\n\n// Given that v[..from] is UTF-8 (from a char boundary, 3 or more, in a\n// v of 19 bytes or more): a char boundary at or after `from` that v is\n// UTF-8 up to. It is v's length or the start of its last sequence when v\n// is UTF-8, else less than 67 bytes before the first error.\nfn utf8_valid_blocks(v: &[u8], from: usize) -> usize {\n    let n = v.len();\n    if from < 3 || from > n || n < 19 {\n        return from;\n    }\n    let k = Utf8Consts {\n        cont_max: v16i8::splat(-64),\n        c0: v16u8::splat(0xC0),\n        x80: v16u8::splat(0x80),\n");
    buf_str(out, c"        e0: v16u8::splat(0xE0),\n        f0: v16u8::splat(0xF0),\n        a0: v16u8::splat(0xA0),\n        x90: v16u8::splat(0x90),\n        ed: v16u8::splat(0xED),\n        f4: v16u8::splat(0xF4),\n        f5: v16u8::splat(0xF5),\n        fe: v16u8::splat(0xFE),\n    };\n    // Every byte before v[j + 3] is checked. A window of the blocks and\n    // the three bytes before them is taken once a step: the loads are at\n    // constant places in it, with no check each.\n    let mut j: usize = from - 3;\n    // (whether v[j..j + 3] ask for nothing more: no sequence is open there)\n    let mut closed = true;\n    while j + 67 <= n {\n        let w = &v[j..j + 67];\n        let a = v16u8::load(w, 3);\n        let b = v16u8::load(w, 19);\n        let c = v16u8::load(w, 35);\n        let d = v16u8::load(w, 51);\n        if !any_lane((a | b | c | d) & k.x80) {\n            // (ASCII: wrong only after a sequence that is not ended)\n            if !closed {\n                if w[2] >= 0xC0 || w[1] >= 0xE0 || w[0] >= 0xF0 {\n                    return utf8_sequence_start(v, j, from);\n                }\n                closed = true;\n            }\n        } else {\n            closed = false;\n            let e = utf8_block_errors(w, 0, a, &k) | utf8_block_errors(w, 16, b, &k)\n                | utf8_block_errors(w, 32, c, &k) | utf8_block_errors(w, 48, d, &k);\n            if any_lane(e) {\n                return utf8_sequence_start(v, j, from);\n            }\n        }\n        j += 64;\n    }\n    // (the blocks left, one at a time; the last one is v's last sixteen\n    // bytes, over bytes already checked: the byte loop is left v's last\n    // sequence only)\n    while j + 3 < n {\n        if j + 19 > n {\n            j = n - 19;\n        }\n        let w = &v[j..j + 19];\n        let a = v16u8::load(w, 3);\n        if closed && !any_lane(a & k.x80) {\n            j += 16;\n            continue;\n        }\n        if any_lane(utf8_block_errors(w, 0, a, &k)) {\n");
    buf_str(out, c"            break;\n        }\n        closed = false;\n        j += 16;\n    }\n    // (every byte checked, and the last three end what they began: all of v)\n    if j + 3 == n && v[n - 1] < 0xC0 && v[n - 2] < 0xE0 && v[n - 3] < 0xF0 {\n        return n;\n    }\n    utf8_sequence_start(v, j, from)\n}\n\n// With every byte before v[j + 3] checked: the start of the sequence\n// v[j] is in (it may go on past the checked bytes), at most three\n// continuation bytes back and not before `from`.\nfn utf8_sequence_start(v: &[u8], j: usize, from: usize) -> usize {\n    let mut e = j;\n    let mut t = 0;\n    while e > from && t < 3 && v[e] & 0xC0 == 0x80 {\n        e -= 1;\n        t += 1;\n    }\n    if e < from { from } else { e }\n}\n\n#[effects(unsafe)]\n// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n// SAFETY: a contract on the caller: v is UTF-8.\npub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {\n    // A &[u8] that is UTF-8 is a &str: the same fat pointer (built in).\n    // UNSAFE: a pointer cast between [u8] and str, which Rust's core makes too.\n    // SAFETY: str and [u8] have the same layout; the caller promises UTF-8.\n    unsafe { &*(v as *const [u8] as *const str) }\n}\n\n// Why bytes are not UTF-8.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct Utf8Error {\n    valid_up_to: usize,\n    error_len: Option<u8>,\n}\n\nimpl Utf8Error {\n    // The length of the valid prefix.\n    // std: changed: usize\n    #[effects()]\n    pub fn valid_up_to(&self) -> usize {\n        self.valid_up_to\n    }\n\n    // The length of the bad sequence; None when the input ends inside one.\n    // std: changed: Option<usize>\n    #[effects()]\n    pub fn error_len(&self) -> Option<usize> {\n        self.error_len.map(|n| n as usize)\n    }\n}\n\nimpl Display for Utf8Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.error_len {\n            Some(n) => {\n");
    buf_str(out, c"                if let Err(e) = f.write_str(\"invalid utf-8 sequence of \") {\n                    return Err(e);\n                }\n                if let Err(e) = f.write_fmt(n) {\n                    return Err(e);\n                }\n                if let Err(e) = f.write_str(\" bytes from index \") {\n                    return Err(e);\n                }\n                f.write_fmt(self.valid_up_to)\n            }\n            None => {\n                if let Err(e) = f.write_str(\"incomplete utf-8 byte sequence from index \") {\n                    return Err(e);\n                }\n                f.write_fmt(self.valid_up_to)\n            }\n        }\n    }\n}\n\n// What can be parsed from text: `s.parse::<T>()`, `T::from_str(s)`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait FromStr: Sized {\n    type Err;\n\n    fn from_str(s: &str) -> Result<Self, Self::Err>;\n}\n\n// Why an integer did not parse.\n// mvs: ParseIntError\n// std: changed: a struct with kind() (MVS: an enum)\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseIntError {\n    kind: IntErrorKind,\n}\n\n// What was wrong with an integer's text.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum IntErrorKind {\n    Empty,\n    InvalidDigit,\n    PosOverflow,\n    NegOverflow,\n    // (Rust's, for its NonZero types: no integer here parses to it)\n    Zero,\n}\n\nimpl ParseIntError {\n    #[effects()]\n    pub fn kind(&self) -> &IntErrorKind {\n        &self.kind\n    }\n}\n\n// (for std's from_str_radix, compiler/std/intconv.vl)\n#[effects()]\npub(crate) fn int_error(kind: IntErrorKind) -> ParseIntError {\n    ParseIntError { kind: kind }\n}\n\n// Rust's texts.\nimpl Display for ParseIntError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(match self.kind {\n            IntErrorKind::Empty => \"cannot parse integer from empty string\",\n");
    buf_str(out, c"            IntErrorKind::InvalidDigit => \"invalid digit found in string\",\n            IntErrorKind::PosOverflow => \"number too large to fit in target type\",\n            IntErrorKind::NegOverflow => \"number too small to fit in target type\",\n            IntErrorKind::Zero => \"number would be zero for non-zero type\",\n        })\n    }\n}\n\n// Why a float did not parse.\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseFloatError {\n    empty: bool,\n}\n\nimpl Display for ParseFloatError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(if self.empty { \"cannot parse float from empty string\" }\n            else { \"invalid float literal\" })\n    }\n}\n\n// Why a bool did not parse (only \"true\" and \"false\" do).\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseBoolError;\n\nimpl Display for ParseBoolError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"provided string was not `true` or `false`\")\n    }\n}\n\n// What a str method searches for: a char, a &str, a &String, a &[char]\n// (any of them) or a closure on a char. Sealed: std's impls only; its\n// methods are std's own shape (Rust's Pattern is unstable).\n// std: changed: char, &str, &[char], FnMut(char) (MVS: str, u8, u32)\npub trait Pattern: Sized {\n    // The byte range of the first match in hay at or after start.\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)>;\n    // The byte range of the last match in hay before end.\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)>;\n}\n\nimpl Pattern for char {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n");
    buf_str(out, c"        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match_back(hay, end)\n    }\n}\n\n// mvs: str::impl Pattern\nimpl<'b> Pattern for &'b str {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if start > h.len() || n > h.len() {\n            return None;\n        }\n        if n == 0 {\n            // the empty pattern matches at every char boundary\n            let mut i = start;\n            while !hay.is_char_boundary(i) {\n                i += 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = start;\n        // (0.29) The needle's first byte found by the bytes' block search\n        // among the places that leave room for the rest, then the rest\n        // compared as a block: a one-byte needle (a char of ASCII, \"\\n\") is\n        // the search alone.\n        let last = h.len() - n + 1;\n        while i < last {\n            match h[i..last].find_byte(needle[0]) {\n                Some(k) => i += k,\n                None => return None,\n            }\n            if n == 1 || &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n            i += 1;\n        }\n        None\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if end > h.len() || n > end {\n            return None;\n        }\n        if n == 0 {\n            let mut i = end;\n            while !hay.is_char_boundary(i) {\n                i -= 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = end - n + 1;\n        while i > 0 {\n            i -= 1;\n            if h[i] == needle[0] && &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n        }\n        None\n");
    buf_str(out, c"    }\n}\n\nimpl<'b, A: Allocator> Pattern for &'b String<A> {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        self.as_str().next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        self.as_str().next_match_back(hay, end)\n    }\n}\n\nimpl<'b> Pattern for &'b [char] {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        if start > hay.len() {\n            return None;\n        }\n        let mut it = hay[start..].char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if self.contains(&c) {\n                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if self.contains(&c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n}\n\n// later: blanket_impl\nimpl<F: FnMut(char) -> bool> Pattern for F {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        if start > hay.len() {\n            return None;\n        }\n        let mut it = hay[start..].char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n\n");
    buf_str(out, c"    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n}\n\n// `&s[a..b]` and `s.get(a..b)`: byte ranges on char boundaries.\nimpl SliceIndex<str> for Range<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of UTF-8 bytes, as a str.\n            // SAFETY: both ends are char boundaries, so the bytes are UTF-8.\n            Some(unsafe { from_utf8_unchecked(&s.as_bytes()[self.start..self.end]) })\n        } else {\n            None\n        }\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.\n            // SAFETY: both ends are char boundaries, so the bytes are UTF-8, and\n            // the result keeps them so (str's methods write only UTF-8).\n            unsafe {\n                let b = bytes_mut(s);\n                Some(str_mut(&mut b[self.start..self.end]))\n            }\n        } else {\n            None\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        let (a, b) = (self.start, self.end);\n        match self.get(s) {\n            Some(r) => r,\n            None => slice_error_fail(s, a, b),\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        let (a, b) = (self.start, self.end);\n");
    buf_str(out, c"        if !(a <= b && s.is_char_boundary(a) && s.is_char_boundary(b)) {\n            slice_error_fail(s, a, b);\n        }\n        // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.\n        // SAFETY: both ends were checked to be char boundaries above.\n        unsafe {\n            let bytes = bytes_mut(s);\n            str_mut(&mut bytes[a..b])\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeInclusive<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        // end < len, so end + 1 cannot overflow\n        if *self.end() >= s.len() {\n            None\n        } else {\n            (*self.start()..*self.end() + 1).get(s)\n        }\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        if *self.end() >= s.len() {\n            None\n        } else {\n            (*self.start()..*self.end() + 1).get_mut(s)\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index(s)\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index_mut(s)\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeFrom<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (self.start..s.len()).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        let n = s.len();\n        (self.start..n).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (self.start..s.len()).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        let n = s.len();\n        (self.start..n).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeTo<usize> {\n    type Output = str;\n\n");
    buf_str(out, c"    fn get(self, s: &str) -> Option<&str> {\n        (0..self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeToInclusive<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (0..=self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..=self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..=self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..=self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeFull {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        Option::Some(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        Option::Some(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        s\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        s\n    }\n}\n\nimpl<I: SliceIndex<str>> Index<I> for str {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\n// Byte for byte.\nimpl PartialEq for str {\n    fn eq(&self, other: &str) -> bool {\n        self.as_bytes() == other.as_bytes()\n    }\n}\n\nimpl Eq for str {}\n\n// By bytes, which is by code points.\nimpl PartialOrd for str {\n    fn partial_cmp(&self, other: &str) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\nimpl Ord for str {\n    fn cmp(&self, other: &str) -> Ordering {\n        self.as_bytes().cmp(other.as_bytes())\n    }\n}\n\n// Its bytes and a 0xff, as Rust's (so (\"ab\", \"c\") and (\"a\", \"bc\") differ).\nimpl Hash for str {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write(self.as_bytes());\n");
    buf_str(out, c"        state.write_u8(0xff);\n    }\n}\n\nimpl Display for str {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.pad(self)\n    }\n}\n\n// Quoted, with escapes: \"a\\\"b\".\nimpl Debug for str {\n    // terminates: one pass for each char of self (CharIndices ends).\n    #[terminates]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"\\\"\")?;\n        let mut from: usize = 0;\n        let mut it = self.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    let esc = match c {\n                        '\"' => \"\\\\\\\"\",\n                        '\\\\' => \"\\\\\\\\\",\n                        '\\n' => \"\\\\n\",\n                        '\\r' => \"\\\\r\",\n                        '\\t' => \"\\\\t\",\n                        '\\0' => \"\\\\0\",\n                        _ => \"\",\n                    };\n                    // controls, white space but ' ' and (as Rust's) grapheme extenders\n                    // are escaped\n                    let control = c.is_control() || is_extend(c)\n                        || (c.is_whitespace() && c != ' ');\n                    if esc.len() > 0 || control {\n                        f.write_str(&self[from..i])?;\n                        if esc.len() > 0 {\n                            f.write_str(esc)?;\n                        } else {\n                            write_unicode_escape(f, c as u32)?;\n                        }\n                        from = i + c.len_utf8();\n                    }\n                }\n                None => break,\n            }\n        }\n        f.write_str(&self[from..])?;\n        f.write_str(\"\\\"\")\n    }\n}\n\n// `s.to_owned_in(a)`: a String<A>.\nimpl<A: Allocator> ToOwnedIn<A> for str {\n    type Owned = String<A>;\n\n    fn to_owned_in(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n}\n\nimpl AsRef<str> for str {\n");
    buf_str(out, c"    fn as_ref(&self) -> &str {\n        self\n    }\n}\n\nimpl AsRef<[u8]> for str {\n    fn as_ref(&self) -> &[u8] {\n        self.as_bytes()\n    }\n}\n\n// later: impl_for_ref\nimpl<'a> Default for &'a str {\n    fn default() -> &'a str {\n        \"\"\n    }\n}\n\n// ---- The iterators ----\n\n// str::chars's iterator; `.rev()` from the end.\n// mvs: Chars, RevChars, CodePoints\n#[derive(Clone)]\npub struct Chars<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Chars<'a> {\n    // What is left.\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.rest\n    }\n}\n\nimpl<'a> Iterator for Chars<'a> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        let b = self.rest.as_bytes();\n        // (written as b[0]'s own check, which then is not made twice)\n        if !(0 < b.len()) {\n            return None;\n        }\n        // (an ASCII byte is its char: nothing is decoded)\n        let x = b[0];\n        if x < 0x80 {\n            self.rest = &self.rest[1..];\n            return Some(x as char);\n        }\n        let (c, n) = decode_wide(x as u32, b);\n        self.rest = &self.rest[n..];\n        Some(c)\n    }\n\n    // (the chars left are the bytes that start one: every byte but the\n    // continuation bytes, 0b10xxxxxx; nothing is decoded)\n    fn count(self) -> usize {\n        let b = self.rest.as_bytes();\n        // (a short text here, in line: the formatter counts the chars of\n        // every sign and padded piece, of no byte or a few, and the\n        // blocks below cost each of those calls twenty instructions)\n        if b.len() < 32 {\n            let mut n: usize = 0;\n            for k in 0..b.len() {\n                if b[k] & 0xC0 != 0x80 {\n                    n += 1;\n                }\n            }\n            return n;\n        }\n        // (a call in tail position: no frame for the short text above)\n        count_chars_by_blocks(b)\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Chars<'a> {\n");
    buf_str(out, c"    fn next_back(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_last(self.rest.as_bytes());\n        self.rest = &self.rest[..self.rest.len() - n];\n        Some(c)\n    }\n}\n\n// str::char_indices's iterator.\n#[derive(Clone)]\npub struct CharIndices<'a> {\n    front: usize,\n    chars: Chars<'a>,\n}\n\nimpl<'a> CharIndices<'a> {\n    // The byte offset of the next char (the length at the end).\n    #[effects()]\n    pub fn offset(&self) -> usize {\n        self.front\n    }\n}\n\nimpl<'a> Iterator for CharIndices<'a> {\n    type Item = (usize, char);\n\n    fn next(&mut self) -> Option<(usize, char)> {\n        let before = self.chars.rest.len();\n        match self.chars.next() {\n            Some(c) => {\n                let i = self.front;\n                self.front += before - self.chars.rest.len();\n                Some((i, c))\n            }\n            None => None,\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for CharIndices<'a> {\n    fn next_back(&mut self) -> Option<(usize, char)> {\n        match self.chars.next_back() {\n            Some(c) => Some((self.front + self.chars.rest.len(), c)),\n            None => None,\n        }\n    }\n}\n\n// str::bytes's iterator.\n#[derive(Clone)]\npub struct Bytes<'a> {\n    inner: crate::slice::Iter<'a, u8>,\n}\n\nimpl<'a> Iterator for Bytes<'a> {\n    type Item = u8;\n\n    fn next(&mut self) -> Option<u8> {\n        self.inner.next().copied()\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Bytes<'a> {\n    fn next_back(&mut self) -> Option<u8> {\n        self.inner.next_back().copied()\n    }\n}\n\n// str::lines's iterator.\n#[derive(Clone)]\npub struct Lines<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for Lines<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n");
    buf_str(out, c"        let line = match s.as_bytes().find_byte(0x0A) {\n            Some(i) => {\n                self.rest = &s[i + 1..];\n                &s[..i]\n            }\n            None => {\n                self.rest = \"\";\n                s\n            }\n        };\n        Some(strip_cr(line))\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Lines<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        // the last line's own \"\\n\" is not a line break before an empty line\n        let b = s.as_bytes();\n        let cut = if b[b.len() - 1] == 0x0A { s.len() - 1 } else { s.len() };\n        let body: &str = &s[..cut];\n        let line = match rfind_byte(body.as_bytes(), 0x0A) {\n            Some(i) => {\n                self.rest = &s[..i + 1];\n                &body[i + 1..]\n            }\n            None => {\n                self.rest = \"\";\n                body\n            }\n        };\n        Some(strip_cr(line))\n    }\n}\n\n// str::split's iterator: the pieces of hay[start..end] between the\n// matches; front and back are where the next search from either end\n// starts (None: no more matches that way).\npub struct Split<'a, P> {\n    hay: &'a str,\n    start: usize,\n    end: usize,\n    front: Option<usize>,\n    back: Option<usize>,\n    pat: P,\n    trailing: bool,\n    done: bool,\n}\n\nimpl<'a, P: Pattern> Split<'a, P> {\n    fn new(hay: &'a str, pat: P, trailing: bool) -> Split<'a, P> {\n        Split {\n            hay: hay,\n            start: 0,\n            end: hay.len(),\n            front: Some(0),\n            back: Some(hay.len()),\n            pat: pat,\n            trailing: trailing,\n            done: false,\n        }\n    }\n\n    // The last piece, once (none when it is empty and trailing is false).\n    fn get_end(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n");
    buf_str(out, c"        self.done = true;\n        if self.trailing || self.end > self.start {\n            Some(&self.hay[self.start..self.end])\n        } else {\n            None\n        }\n    }\n}\n\nimpl<'a, P: Pattern> Iterator for Split<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        let m = match self.front {\n            Some(at) => self.pat.next_match(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if b <= self.end => {\n                let piece = &self.hay[self.start..a];\n                self.start = b;\n                self.front = after_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => self.get_end(),\n        }\n    }\n}\n\nimpl<'a, P: Pattern> DoubleEndedIterator for Split<'a, P> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        if !self.trailing {\n            // split_terminator: an empty last piece is not one\n            self.trailing = true;\n            match self.next_back() {\n                Some(piece) if !piece.is_empty() => return Some(piece),\n                _ => {\n                    if self.done {\n                        return None;\n                    }\n                }\n            }\n        }\n        let m = match self.back {\n            Some(at) => self.pat.next_match_back(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if a >= self.start => {\n                let piece = &self.hay[b..self.end];\n                self.end = a;\n                self.back = before_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => {\n                self.done = true;\n                Some(&self.hay[self.start..self.end])\n            }\n        }\n    }\n}\n\n// str::rsplit's iterator.\npub struct RSplit<'a, P> {\n");
    buf_str(out, c"    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplit<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next_back()\n    }\n}\n\n// str::splitn's iterator.\npub struct SplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next()\n            }\n        }\n    }\n}\n\n// str::rsplitn's iterator.\npub struct RSplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next_back()\n            }\n        }\n    }\n}\n\n// str::split_terminator's iterator.\npub struct SplitTerminator<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitTerminator<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next()\n    }\n}\n\n// str::split_inclusive's iterator.\npub struct SplitInclusive<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitInclusive<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.inner.done {\n            return None;\n        }\n        let m = match self.inner.front {\n            Some(at) => self.inner.pat.next_match(self.inner.hay, at),\n            None => None,\n        };\n        match m {\n");
    buf_str(out, c"            Some((a, b)) if b <= self.inner.end => {\n                let piece = &self.inner.hay[self.inner.start..b];\n                self.inner.start = b;\n                self.inner.front = after_match(self.inner.hay, a, b);\n                Some(piece)\n            }\n            _ => self.inner.get_end(),\n        }\n    }\n}\n\n// str::split_whitespace's iterator.\n#[derive(Clone)]\npub struct SplitWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_start();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        self.rest = &s[i..];\n                        return Some(&s[..i]);\n                    }\n                }\n                None => {\n                    self.rest = \"\";\n                    return Some(s);\n                }\n            }\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for SplitWhitespace<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_end();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        let j = i + c.len_utf8();\n                        self.rest = &s[..i];\n                        return Some(&s[j..]);\n                    }\n                }\n                None => {\n                    self.rest = \"\";\n                    return Some(s);\n                }\n            }\n        }\n    }\n}\n\n// str::split_ascii_whitespace's iterator.\n#[derive(Clone)]\n");
    buf_str(out, c"pub struct SplitAsciiWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitAsciiWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let b = self.rest.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() && is_ascii_space(b[i]) {\n            i += 1;\n        }\n        if i == b.len() {\n            self.rest = \"\";\n            return None;\n        }\n        let mut j = i;\n        while j < b.len() && !is_ascii_space(b[j]) {\n            j += 1;\n        }\n        let s = self.rest;\n        self.rest = &s[j..];\n        Some(&s[i..j])\n    }\n}\n\n// str::matches's iterator (at: where the next search starts; past the\n// end when done).\npub struct Matches<'a, P> {\n    hay: &'a str,\n    at: usize,\n    pat: P,\n}\n\nimpl<'a, P: Pattern> Iterator for Matches<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.at > self.hay.len() {\n            return None;\n        }\n        match self.pat.next_match(self.hay, self.at) {\n            Some((a, b)) => {\n                self.at = match after_match(self.hay, a, b) {\n                    Some(n) => n,\n                    None => self.hay.len() + 1,\n                };\n                Some(&self.hay[a..b])\n            }\n            None => {\n                self.at = self.hay.len() + 1;\n                None\n            }\n        }\n    }\n}\n\n// str::match_indices's iterator.\npub struct MatchIndices<'a, P> {\n    hay: &'a str,\n    at: usize,\n    pat: P,\n}\n\nimpl<'a, P: Pattern> Iterator for MatchIndices<'a, P> {\n    type Item = (usize, &'a str);\n\n    fn next(&mut self) -> Option<(usize, &'a str)> {\n        if self.at > self.hay.len() {\n            return None;\n        }\n        match self.pat.next_match(self.hay, self.at) {\n            Some((a, b)) => {\n                self.at = match after_match(self.hay, a, b) {\n                    Some(n) => n,\n");
    buf_str(out, c"                    None => self.hay.len() + 1,\n                };\n                Some((a, &self.hay[a..b]))\n            }\n            None => {\n                self.at = self.hay.len() + 1;\n                None\n            }\n        }\n    }\n}\n\n// str::graphemes's iterator: vole's.\n// mvs: StrGraphemes\n// std: renamed\npub struct Graphemes<'a> {\n    rest: &'a str,\n    extended: bool,\n}\n\n// ---- The helpers ----\n\n// The number of chars of UTF-8 b: its bytes but the continuation bytes\n// (0x80..0xBF). Written for the\n// vectorizer, with no check that could stop it (Chars::count has no\n// effect): 224 bytes at a time, taken by `get`, are counted in a byte\n// (the loop's values are then all bytes: sixteen a step, and 224 is 7\n// steps of two vectors, with none left over), and the counts are added\n// up. A count of the whole text in a usize is not vectorized (elements\n// of two widths), nor is `(x & 0xC0 == 0x80) as u8` (a compare's value\n// has no vector form; the `if` has): 6 to 10 instructions a byte. Not\n// inlined: Chars::count, with its loop for a short text, stays small.\n#[inline(never)]\nfn count_chars_by_blocks(b: &[u8]) -> usize {\n    let n = b.len();\n    let mut conts: usize = 0;\n    for k in 0..n / 224 + 1 {\n        let end = if k * 224 + 224 < n { k * 224 + 224 } else { n };\n        match b.get(k * 224..end) {\n            Some(w) => {\n                let mut c: u8 = 0;\n                for j in 0..w.len() {\n                    if w[j] & 0xC0 == 0x80 {\n                        c += 1;\n                    }\n                }\n                conts += c as usize;\n            }\n            None => {}\n        }\n    }\n    n - conts\n}\n\n// The first code point of b (UTF-8, not empty) and its length.\nfn decode_first(b: &[u8]) -> (char, usize) {\n    let x = b[0];\n    if x < 0x80 {\n        return (x as char, 1);\n    }\n    decode_wide(x as u32, b)\n}\n\n");
    buf_str(out, c"// The code point of the sequence b starts with and its length, given its\n// first byte x, which is not ASCII. Not inlined: Chars::next with it\n// inside is too large to inline into the loop that calls it, and its\n// ASCII step then costs a call. Each form in a line (a loop over the\n// continuation bytes was unrolled by four), under one test of the length.\n#[inline(never)]\nfn decode_wide(x: u32, b: &[u8]) -> (char, usize) {\n    let n = b.len();\n    if x < 0xE0 {\n        if 1 < n {\n            let cp = (x & 0x1F) << 6 | (b[1] as u32 & 0x3F);\n            return (crate::char::from_u32_bmp_lossy(cp), 2);\n        }\n    } else if x < 0xF0 {\n        if 2 < n {\n            let cp = (x & 0x0F) << 12 | (b[1] as u32 & 0x3F) << 6 | (b[2] as u32 & 0x3F);\n            return (crate::char::from_u32_bmp_lossy(cp), 3);\n        }\n    } else if 3 < n {\n        let cp = (x & 0x07) << 18 | (b[1] as u32 & 0x3F) << 12 | (b[2] as u32 & 0x3F) << 6\n            | (b[3] as u32 & 0x3F);\n        return (to_char(cp), 4);\n    }\n    // (cut short: no str is)\n    ('\\u{FFFD}', n)\n}\n\n// The last code point of b (UTF-8, not empty) and its length.\nfn decode_last(b: &[u8]) -> (char, usize) {\n    let mut i = b.len() - 1;\n    while i > 0 && b[i] & 0xC0 == 0x80 {\n        i -= 1;\n    }\n    let (c, _) = decode_first(&b[i..]);\n    (c, b.len() - i)\n}\n\nfn to_char(cp: u32) -> char {\n    match char::from_u32(cp) {\n        Some(c) => c,\n        None => '\\u{FFFD}',\n    }\n}\n\n// Where the search after the match a..b starts: b, or past the next char\n// for an empty match (so it is not found again); None past the end.\nfn after_match(hay: &str, a: usize, b: usize) -> Option<usize> {\n    if a < b {\n        Some(b)\n    } else if b < hay.len() {\n        let (_, n) = decode_first(&hay.as_bytes()[b..]);\n        Some(b + n)\n    } else {\n        None\n    }\n}\n\n// The same, searching backwards: a, or before the previous char.\n");
    buf_str(out, c"fn before_match(hay: &str, a: usize, b: usize) -> Option<usize> {\n    if a < b {\n        Some(a)\n    } else if a > 0 {\n        let (_, n) = decode_last(&hay.as_bytes()[..a]);\n        Some(a - n)\n    } else {\n        None\n    }\n}\n\n// Where x last is in b: a line's end from the back (the first is\n// [u8]::find_byte, the block search, from 0.29).\nfn rfind_byte(b: &[u8], x: u8) -> Option<usize> {\n    let mut i = b.len();\n    while i > 0 {\n        i -= 1;\n        if b[i] == x {\n            return Some(i);\n        }\n    }\n    None\n}\n\n// A line without its \"\\r\" (of a \"\\r\\n\").\nfn strip_cr(line: &str) -> &str {\n    let n = line.len();\n    let cut = if n > 0 && line.as_bytes()[n - 1] == 0x0D { n - 1 } else { n };\n    &line[..cut]\n}\n\n// Rust's u8::is_ascii_whitespace: space, \\t, \\n, \\x0C, \\r.\nfn is_ascii_space(b: u8) -> bool {\n    b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0C || b == 0x0D\n}\n\nfn ascii_lower(b: u8) -> u8 {\n    if b >= 0x41 && b <= 0x5A { b + 32 } else { b }\n}\n\nfn ascii_upper(b: u8) -> u8 {\n    if b >= 0x61 && b <= 0x7A { b - 32 } else { b }\n}\n\n// A &mut str's bytes (Rust's str::as_bytes_mut).\n// UNSAFE: the bytes can be written with what is not UTF-8.\n// SAFETY: a contract on the caller: what it writes keeps s UTF-8.\nunsafe fn bytes_mut(s: &mut str) -> &mut [u8] {\n    // UNSAFE: the str's bytes through its fat pointer, as Rust's core.\n    // SAFETY: the pointer and length are s's own, and s is borrowed mutably\n    // for the result's life, so nothing else reaches the bytes.\n    unsafe { &mut *(s as *mut str as *mut [u8]) }\n}\n\n// UTF-8 bytes as a &mut str (Rust's str::from_utf8_unchecked_mut).\n// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n// SAFETY: a contract on the caller: b is UTF-8.\nunsafe fn str_mut(b: &mut [u8]) -> &mut str {\n    // UNSAFE: a pointer cast between [u8] and str.\n    // SAFETY: the same layout; the caller promises UTF-8.\n");
    buf_str(out, c"    unsafe { &mut *(b as *mut [u8] as *mut str) }\n}\n\n// `&s[a..b]` out of bounds or off a char boundary: Rust's messages, without\n// the text (str's Display in a panic's format waits for format_fns).\nfn slice_error_fail(s: &str, a: usize, b: usize) -> ! {\n    if a > s.len() {\n        crate::panic::panic(\"byte index {} is out of bounds of a str of {} bytes\", a, s.len())\n    } else if b > s.len() {\n        crate::panic::panic(\"byte index {} is out of bounds of a str of {} bytes\", b, s.len())\n    } else if a > b {\n        crate::panic::panic(\"begin <= end ({} <= {}) when slicing a str\", a, b)\n    } else if !s.is_char_boundary(a) {\n        crate::panic::panic(\"byte index {} is not a char boundary\", a)\n    } else {\n        crate::panic::panic(\"byte index {} is not a char boundary\", b)\n    }\n}\n\n// `\\u{1b}`: Debug's escape of a control char, in lower-case hex.\n// terminates: x, a u32, loses four bits each pass: eight passes at most.\n#[terminates]\nfn write_unicode_escape(f: &mut Formatter<'_>, cp: u32) -> crate::fmt::Result {\n    // `\\u{`, the hex digits, `}`, written from the end back\n    let mut buf = [0u8; 11];\n    let mut n: usize = 11;\n    n -= 1;\n    buf[n] = 0x7D;\n    let mut x = cp;\n    loop {\n        let d = (x & 0xF) as u8;\n        n -= 1;\n        buf[n] = if d < 10 { 0x30 + d } else { 0x57 + d };\n        x = x >> 4;\n        if x == 0 {\n            break;\n        }\n    }\n    n -= 3;\n    buf[n] = 0x5C;\n    buf[n + 1] = 0x75;\n    buf[n + 2] = 0x7B;\n    match from_utf8(&buf[n..]) {\n        Ok(s) => f.write_str(s),\n        Err(_) => Ok(()),\n    }\n}\n\n// The grapheme properties the clusters need (UAX #29), from the code\n// point ranges std has without the Unicode tables (MVS's std::unicode).\nfn is_control(cp: u32) -> bool {\n    cp < 0x20 || (cp >= 0x7F && cp < 0xA0) || cp == 0x2028 || cp == 0x2029\n}\n\nfn is_regional(cp: u32) -> bool {\n    cp >= 0x1F1E6 && cp <= 0x1F1FF\n}\n\n");
    buf_str(out, c"fn is_extend(c: char) -> bool {\n    let cp = c as u32;\n    (cp >= 0x300 && cp <= 0x36F)\n        || (cp >= 0x1AB0 && cp <= 0x1AFF)\n        || (cp >= 0x1DC0 && cp <= 0x1DFF)\n        || (cp >= 0x20D0 && cp <= 0x20FF)\n        || (cp >= 0xFE00 && cp <= 0xFE0F)\n        || (cp >= 0xFE20 && cp <= 0xFE2F)\n        || (cp >= 0x1F3FB && cp <= 0x1F3FF)\n        || (cp >= 0xE0020 && cp <= 0xE007F)\n        || (cp >= 0x300 && !is_control(cp) && c.width() == 0 && cp != 0x200D)\n}\n\n// SpacingMark: the common Indic vowel signs.\nfn is_spacing_mark(cp: u32) -> bool {\n    cp == 0x903 || cp == 0x93B || (cp >= 0x93E && cp <= 0x940) || (cp >= 0x949 && cp <= 0x94C)\n        || cp == 0x94E || cp == 0x94F || cp == 0x982 || cp == 0x983\n        || (cp >= 0x9BF && cp <= 0x9C0) || (cp >= 0xBBF && cp <= 0xBC0)\n}\n\n// East Asian Ambiguous: the main blocks (Latin-1's symbols, Greek,\n// Cyrillic, box drawing, the circled and geometric forms, private use).\nfn is_ambiguous(cp: u32) -> bool {\n    cp == 0xA1 || cp == 0xA4 || cp == 0xA7 || cp == 0xA8 || cp == 0xAA || cp == 0xAD || cp == 0xAE\n        || (cp >= 0xB0 && cp <= 0xB4) || (cp >= 0xB6 && cp <= 0xBA) || (cp >= 0xBC && cp <= 0xBF)\n        || cp == 0xC6 || cp == 0xD0 || cp == 0xD7 || cp == 0xD8 || (cp >= 0xDE && cp <= 0xE1)\n        || cp == 0xE6 || (cp >= 0xE8 && cp <= 0xEA) || cp == 0xEC || cp == 0xED || cp == 0xF0\n        || cp == 0xF2 || cp == 0xF3 || (cp >= 0xF7 && cp <= 0xFA) || cp == 0xFC || cp == 0xFE\n        || (cp >= 0x391 && cp <= 0x3A9) || (cp >= 0x3B1 && cp <= 0x3C9) || cp == 0x401\n        || (cp >= 0x410 && cp <= 0x44F) || cp == 0x451 || (cp >= 0x2010 && cp <= 0x2027)\n        || (cp >= 0x2460 && cp <= 0x24FF) || (cp >= 0x2500 && cp <= 0x257F)\n        || (cp >= 0x25A0 && cp <= 0x25FF) || (cp >= 0xE000 && cp <= 0xF8FF) || cp == 0xFFFD\n}\n\n// A cluster's columns: its first char's, 2 with an emoji presentation\n// selector (U+FE0F), or with cjk an ambiguous one.\nfn cluster_width(g: &str, cjk: bool) -> usize {\n");
    buf_str(out, c"    let (c, _) = decode_first(g.as_bytes());\n    let w = c.width();\n    // U+FE0F is EF B8 8F in UTF-8\n    let b = g.as_bytes();\n    let mut vs16 = false;\n    let mut i: usize = 0;\n    while i + 2 < b.len() {\n        if b[i] == 0xEF && b[i + 1] == 0xB8 && b[i + 2] == 0x8F {\n            vs16 = true;\n        }\n        i += 1;\n    }\n    if w == 1 && (vs16 || (cjk && is_ambiguous(c as u32))) {\n        2\n    } else {\n        w\n    }\n}\n\nimpl<'a> Iterator for Graphemes<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        let b = s.as_bytes();\n        let (first, n0) = decode_first(b);\n        let mut prev = first as u32;\n        let mut end = n0;\n        // regional indicators pair up (GB12, GB13)\n        let mut ri: usize = if is_regional(prev) { 1 } else { 0 };\n        while end < b.len() {\n            let (c, n) = decode_first(&b[end..]);\n            let cp = c as u32;\n            // GB3: CR LF stays together; GB4, GB5: a control breaks\n            let join = if prev == 0x0D && cp == 0x0A {\n                true\n            } else if is_control(prev) || is_control(cp) {\n                false\n            } else if is_extend(c) || cp == 0x200D {\n                // GB9: Extend and ZWJ\n                true\n            } else if self.extended && is_spacing_mark(cp) {\n                // GB9a\n                true\n            } else if prev == 0x200D && c.width() == 2 {\n                // GB11: ZWJ then a pictograph (wide as an approximation)\n                true\n            } else if is_regional(cp) && ri % 2 == 1 {\n                true\n            } else {\n                false\n            };\n            if !join {\n                break;\n            }\n            if is_regional(cp) {\n                ri += 1;\n            }\n            prev = cp;\n            end += n;\n        }\n");
    buf_str(out, c"        self.rest = &s[end..];\n        Some(&s[..end])\n    }\n}\n\n// Unicode's Cased, approximately: Lowercase or Uppercase (the titlecase\n// letters, Lt, are left out).\nfn is_cased(c: char) -> bool {\n    c.is_lowercase() || c.is_uppercase()\n}\n\n// Unicode's Case_Ignorable, approximately: the apostrophes, the word\n// punctuation Unicode lists (`.`, `:`, `^`, `` ` ``, U+00AD, U+00B7) and\n// the combining diacritical marks.\nfn is_case_ignorable(c: char) -> bool {\n    let u = c as u32;\n    c == '\\'' || c == '.' || c == ':' || c == '^' || c == '`' || u == 0xAD || u == 0xB7\n        || u == 0x2019 || (u >= 0x300 && u <= 0x36F)\n}\n\n// Whether the last char of s that is not case-ignorable is cased (Final_Sigma's\n// \"before\").\nfn cased_before(s: &str) -> bool {\n    let mut it = s.chars();\n    while let Some(c) = it.next_back() {\n        if !is_case_ignorable(c) {\n            return is_cased(c);\n        }\n    }\n    false\n}\n\n// Whether the first char of s that is not case-ignorable is cased.\nfn cased_after(s: &str) -> bool {\n    let mut it = s.chars();\n    while let Some(c) = it.next() {\n        if !is_case_ignorable(c) {\n            return is_cased(c);\n        }\n    }\n    false\n}\n// ---- end mod std::str ----\n}\n// ---- mod std::char ----\npub mod char {\n// std::char: the methods of char, a Unicode scalar value (0..=0x10FFFF\n// less the surrogates), and the functions that make one. The rust front's\n// char type comes in 0.27.2 (`syntax.later: char`); MVS had none (a code\n// point was a u32, `'x'` a u8), and in the rust edition `'x'` is a char\n// and `b'x'` a u8.\n\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::TryFrom;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::result::Result;\n\nimpl char {\n    // The largest char, '\\u{10FFFF}'.\n");
    buf_str(out, c"    pub const MAX: char = '\\u{10FFFF}';\n\n    // U+FFFD, what bad UTF-8 decodes to.\n    pub const REPLACEMENT_CHARACTER: char = '\\u{FFFD}';\n\n    // i as a char, when it is a scalar value.\n    #[effects()]\n    pub fn from_u32(i: u32) -> Option<char> {\n        // the surrogates (U+D800..=U+DFFF) and past U+10FFFF are no chars\n        // (three compares: the one-compare form, `(i ^ 0xD800) - 0x800`\n        // wrapped, is larger as the compiler counts it, and Formatter's\n        // __spec, which calls this twice a hole, was no longer inlined)\n        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) {\n            Option::None\n        } else {\n            Option::Some(from_u32_unchecked(i))\n        }\n    }\n\n    // The digit d in radix (2..=36), as a char: from_digit(7, 10) is '7'.\n    #[effects(panic)]\n    pub fn from_digit(d: u32, radix: u32) -> Option<char>\n        requires radix <= 36\n    {\n        if radix > 36 {\n            crate::panic::panic(\"from_digit: radix is too high (maximum 36)\");\n        }\n        if d >= radix {\n            Option::None\n        } else if d < 10 {\n            Option::Some(('0' as u8 + d as u8) as char)\n        } else {\n            Option::Some(('a' as u8 + (d - 10) as u8) as char)\n        }\n    }\n\n    // Its value as a digit in radix: '7'.to_digit(10) is Some(7).\n    #[effects(panic)]\n    pub fn to_digit(self, radix: u32) -> Option<u32> {\n        if radix < 2 || radix > 36 {\n            crate::panic::panic(\n                \"to_digit: invalid radix -- radix must be in the range 2 to 36 inclusive\");\n        }\n        let c = self as u32;\n        // `| 0x20` folds ASCII upper case onto lower case\n        let l = c | 0x20;\n        let d = if c >= 0x30 && c <= 0x39 {\n            c - 0x30\n        } else if l >= 0x61 && l <= 0x7A {\n            l - 0x61 + 10\n        } else {\n            return Option::None;\n        };\n        if d < radix { Option::Some(d) } else { Option::None }\n    }\n\n");
