    buf_str(out, c"// std: changed: a sized view `Path<'a>`, Rust's `&'a Path` (no unsized\n// newtypes yet); MVS: a distinct [u8]\n#[derive(Clone, Copy)]\npub struct Path<'a> {\n    s: &'a str,\n}\n\n// What `strip_prefix` fails with: the base is not a prefix.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct StripPrefixError {}\n\nimpl Display for StripPrefixError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"prefix not found\")\n    }\n}\n\n// The byte range of the file name in s (its last Normal component): it\n// ends where the trailing '/'s and \".\" components start.\nfn file_name_range(s: &str) -> Option<(usize, usize)> {\n    let n = match Path::new(s).file_name() {\n        Option::Some(n) => n.len(),\n        Option::None => return Option::None,\n    };\n    let b = s.as_bytes();\n    let mut hi = b.len();\n    loop {\n        if hi > 0 && b[hi - 1] == b'/' {\n            hi -= 1;\n        } else if hi > 0 && b[hi - 1] == b'.' && (hi == 1 || b[hi - 2] == b'/') {\n            hi -= 1;\n        } else {\n            break;\n        }\n    }\n    Option::Some((hi - n, hi))\n}\n\n// A file name split at its last '.': (stem, extension); \"..\" and a name\n// whose only '.' leads (\".bashrc\") have no extension.\nfn split_dot(name: &str) -> (&str, Option<&str>) {\n    if name == \"..\" {\n        return (name, Option::None);\n    }\n    match name.rfind('.') {\n        Option::Some(0) => (name, Option::None),\n        Option::Some(k) => (&name[0..k], Option::Some(&name[k + 1..])),\n        Option::None => (name, Option::None),\n    }\n}\n\nimpl<'a> Path<'a> {\n    // The path of the text s: `Path::new(\"a/b.txt\")`.\n    // std: changed: a Path<'a> of a &'a str (Rust: &Path of an AsRef<OsStr>)\n    #[effects()]\n    pub fn new(s: &'a str) -> Path<'a> {\n        Path { s: s }\n    }\n\n    // Its text.\n    // std: changed: Rust's as_os_str, a &str\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.s\n    }\n\n");
