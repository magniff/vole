    buf_str(out, c"    b\"atomicLoad\",\n    b\"atomicStore\",\n    b\"atomicAdd\",\n    b\"atomicSub\",\n    b\"atomicMax\",\n    b\"atomicMin\",\n    b\"atomicAnd\",\n    b\"atomicOr\",\n    b\"atomicXor\",\n    b\"atomicExchange\",\n    b\"atomicCompareExchangeWeak\",\n    b\"workgroupBarrier\",\n    b\"storageBarrier\",\n    b\"workgroupUniformLoad\",\n    b\"dpdx\",\n    b\"dpdy\",\n    b\"fwidth\",\n    b\"dpdxCoarse\",\n    b\"dpdyCoarse\",\n    b\"fwidthCoarse\",\n    b\"dpdxFine\",\n    b\"dpdyFine\",\n    b\"fwidthFine\",\n    b\"textureSample\",\n    b\"textureSampleBias\",\n    b\"textureSampleLevel\",\n    b\"textureSampleCompare\",\n    b\"textureSampleCompareLevel\",\n    b\"textureLoad\",\n    b\"textureStore\",\n    b\"textureDimensions\",\n    b\"textureNumLevels\",\n    b\"textureNumLayers\",\n    // storage texel formats added in 0.25.2.2 (K_RGBA16FLOAT..)\n    b\"rgba16float\",\n    b\"rgba8uint\",\n    b\"rg32float\",\n];\n\n// keywords\npub(crate) const K_FN: i64 = 0;\npub(crate) const K_LET: i64 = 1;\npub(crate) const K_VAR: i64 = 2;\npub(crate) const K_CONST: i64 = 3;\npub(crate) const K_STRUCT: i64 = 4;\npub(crate) const K_RETURN: i64 = 5;\npub(crate) const K_IF: i64 = 6;\npub(crate) const K_ELSE: i64 = 7;\npub(crate) const K_FOR: i64 = 8;\npub(crate) const K_WHILE: i64 = 9;\npub(crate) const K_LOOP: i64 = 10;\npub(crate) const K_BREAK: i64 = 11;\npub(crate) const K_CONTINUE: i64 = 12;\npub(crate) const K_CONTINUING: i64 = 13;\npub(crate) const K_SWITCH: i64 = 14;\npub(crate) const K_CASE: i64 = 15;\npub(crate) const K_DEFAULT: i64 = 16;\npub(crate) const K_DISCARD: i64 = 17;\npub(crate) const K_TRUE: i64 = 18;\npub(crate) const K_FALSE: i64 = 19;\npub(crate) const K_ALIAS: i64 = 20;\npub(crate) const K_OVERRIDE: i64 = 21;\npub(crate) const K_ENABLE: i64 = 22;\npub(crate) const K_REQUIRES: i64 = 23;\npub(crate) const K_DIAGNOSTIC: i64 = 24;\npub(crate) const K_CONST_ASSERT: i64 = 25;\npub(crate) const K_FALLTHROUGH: i64 = 26;\n// types\n");
