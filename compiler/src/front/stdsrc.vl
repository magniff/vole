    buf_str(out, c"        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std: changed: a &str, a view of the entry (Rust's: a PathBuf; MVS:\n    // a PathBuf on an allocator; path_in could make one on an allocator)\n    #[effects(panic, diverge)]\n    pub fn path(&self) -> &str {\n        self.text(0)\n    }\n\n    // Its name.\n    // std: changed: a &str, a view of the entry, until std::ffi (Rust's:\n    // an OsString; a name that is not UTF-8 is read_dir's InvalidData)\n    #[effects(panic, diverge)]\n    pub fn file_name(&self) -> &str {\n        self.text(self.name_at)\n    }\n\n    // What lstat says of it.\n    #[effects(io, static, panic, diverge)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        stat_at(self.path(), false)\n    }\n\n    // Its kind as the directory says it (lstat's when the file system does\n    // not say).\n    #[effects(io, static, panic, diverge)]\n    pub fn file_type(&self) -> Result<FileType> {\n        if self.kind == DT_DIR {\n            crate::result::Result::Ok(FileTyp