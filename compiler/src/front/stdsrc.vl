    buf_str(out, c"    #[effects(S, A)]\n    pub fn with_file_name_in<S: AsRef<str>, A: Allocator>(&self, name: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_file_name(name);\n        out\n    }\n\n    // The path with its extension replaced by ext, on allocator a.\n    // std: changed: an allocator (Rust: with_extension)\n    #[effects(S, A)]\n    pub fn with_extension_in<S: AsRef<str>, A: Allocator>(&self, ext: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_extension(ext);\n        out\n    }\n\n    // What stat says of the file at the path.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::metadata(self.s)\n    }\n\n    // What lstat says of it.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn symlink_metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::symlink_metadata(self.s)\n    }\n\n    // Whether something is there (stat succeeds).\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn exists(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(_) => true,\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_dir(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(m) => m.is_dir(),\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_file(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(m) => m.is_file(),\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_symlink(&self) -> bool {\n        match crate::fs::symlink_metadata(self.s) {\n            Result::Ok(m) => m.is