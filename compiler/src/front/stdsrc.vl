_SIGN: i64 = 135;\n");
    buf_str(out, c"pub(crate) const K_FLOOR: i64 = 136;\npub(crate) const K_CEIL: i64 = 137;\npub(crate) const K_ROUND: i64 = 138;\npub(crate) const K_FRACT: i64 = 139;\npub(crate) const K_TRUNC: i64 = 140;\npub(crate) const K_SQRT: i64 = 141;\npub(crate) const K_INVERSE_SQRT: i64 = 142;\npub(crate) const K_EXP: i64 = 143;\npub(crate) const K_EXP2: i64 = 144;\npub(crate) const K_LOG: i64 = 145;\npub(crate) const K_LOG2: i64 = 146;\npub(crate) const K_POW: i64 = 147;\npub(crate) const K_SIN: i64 = 148;\npub(crate) const K_COS: i64 = 149;\npub(crate) const K_TAN: i64 = 150;\npub(crate) const K_ASIN: i64 = 151;\npub(crate) const K_ACOS: i64 = 152;\npub(crate) const K_ATAN: i64 = 153;\npub(crate) const K_ATAN2: i64 = 154;\npub(crate) const K_SINH: i64 = 155;\npub(crate) const K_COSH: i64 = 156;\npub(crate) const K_TANH: i64 = 157;\npub(crate) const K_MIX: i64 = 158;\npub(crate) const K_STEP: i64 = 159;\npub(crate) const K_SMOOTHSTEP: i64 = 160;\npub(crate) const K_FMA: i64 = 161;\npub(crate) const K_LENGTH: i64 = 162;\npub(crate) const K_DISTANCE: i64 = 163;\npub(crate) const K_DOT: i64 = 164;\npub(crate) const K_CROSS: i64 = 165;\npub(crate) const K_NORMALIZE: i64 = 166;\npub(crate) const K_REFLECT: i64 = 167;\npub(crate) const K_DETERMINANT: i64 = 168;\npub(crate) const K_TRANSPOSE: i64 = 169;\npub(crate) const K_COUNT_ONE_BITS: i64 = 170;\npub(crate) const K_COUNT_LEADING_ZEROS: i64 = 171;\npub(crate) const K_COUNT_TRAILING_ZEROS: i64 = 172;\npub(crate) const K_FIRST_LEADING_BIT: i64 = 173;\npub(crate) const K_FIRST_TRAILING_BIT: i64 = 174;\npub(crate) const K_REVERSE_BITS: i64 = 175;\npub(crate) const K_EXTRACT_BITS: i64 = 176;\npub(crate) const K_INSERT_BITS: i64 = 177;\npub(crate) const K_ALL: i64 = 178;\npub(crate) const K_ANY: i64 = 179;\npub(crate) const K_DEGREES: i64 = 180;\npub(crate) const K_RADIANS: i64 = 181;\npub(crate) const K_SATURATE: i64 = 182;\npub(crate) const K_PACK4X8UNORM: i64 = 183;\npub(crate) const K_UNPACK4X8UNORM: i64 = 184;\n");
    buf_str(out, c"pub(crate) const K_PACK2X16FLOAT: i64 = 185;\npub(crate) const K_UNPACK2X16FLOAT: i64 = 186;\npub(crate) const K_ASINH: i64 = 187;\npub(crate) const K_ACOSH: i64 = 188;\npub(crate) const K_ATANH: i64 = 189;\npub(crate) const K_FACE_FORWARD: i64 = 190;\npub(crate) const K_LDEXP: i64 = 191;\npub(crate) const K_PACK4X8SNORM: i64 = 192;\npub(crate) const K_UNPACK4X8SNORM: i64 = 193;\npub(crate) const K_PACK2X16UNORM: i64 = 194;\npub(crate) const K_UNPACK2X16UNORM: i64 = 195;\npub(crate) const K_PACK2X16SNORM: i64 = 196;\npub(crate) const K_UNPACK2X16SNORM: i64 = 197;\npub(crate) const K_MATH_FIRST: i64 = 131;\npub(crate) const K_MATH_LAST: i64 = 197;\n// other builtins\npub(crate) const K_SELECT: i64 = 198;\npub(crate) const K_ARRAY_LENGTH: i64 = 199;\npub(crate) const K_BITCAST: i64 = 200;\npub(crate) const K_ATOMIC_LOAD: i64 = 201;\npub(crate) const K_ATOMIC_STORE: i64 = 202;\npub(crate) const K_ATOMIC_ADD: i64 = 203;\npub(crate) const K_ATOMIC_SUB: i64 = 204;\npub(crate) const K_ATOMIC_MAX: i64 = 205;\npub(crate) const K_ATOMIC_MIN: i64 = 206;\npub(crate) const K_ATOMIC_AND: i64 = 207;\npub(crate) const K_ATOMIC_OR: i64 = 208;\npub(crate) const K_ATOMIC_XOR: i64 = 209;\npub(crate) const K_ATOMIC_EXCHANGE: i64 = 210;\npub(crate) const K_ATOMIC_COMPARE_EXCHANGE_WEAK: i64 = 211;\npub(crate) const K_WORKGROUP_BARRIER: i64 = 212;\npub(crate) const K_STORAGE_BARRIER: i64 = 213;\npub(crate) const K_WORKGROUP_UNIFORM_LOAD: i64 = 214;\npub(crate) const K_DPDX: i64 = 215;\npub(crate) const K_DPDY: i64 = 216;\npub(crate) const K_FWIDTH: i64 = 217;\npub(crate) const K_DPDX_COARSE: i64 = 218;\npub(crate) const K_DPDY_COARSE: i64 = 219;\npub(crate) const K_FWIDTH_COARSE: i64 = 220;\npub(crate) const K_DPDX_FINE: i64 = 221;\npub(crate) const K_DPDY_FINE: i64 = 222;\npub(crate) const K_FWIDTH_FINE: i64 = 223;\npub(crate) const K_TEXTURE_SAMPLE: i64 = 224;\npub(crate) const K_TEXTURE_SAMPLE_BIAS: i64 = 225;\npub(crate) const K_TEXTURE_SAMPLE_LEVEL: i64 = 226;\n");
    buf_str(out, c"pub(crate) const K_TEXTURE_SAMPLE_COMPARE: i64 = 227;\npub(crate) const K_TEXTURE_SAMPLE_COMPARE_LEVEL: i64 = 228;\npub(crate) const K_TEXTURE_LOAD: i64 = 229;\npub(crate) const K_TEXTURE_STORE: i64 = 230;\npub(crate) const K_TEXTURE_DIMENSIONS: i64 = 231;\npub(crate) const K_TEXTURE_NUM_LEVELS: i64 = 232;\npub(crate) const K_TEXTURE_NUM_LAYERS: i64 = 233;\n// storage texel formats after the first six (0.25.2.2): FMT_RGBA16FLOAT +\n// (K - K_RGBA16FLOAT)\npub(crate) const K_RGBA16FLOAT: i64 = 234;\npub(crate) const K_RGBA8UINT: i64 = 235;\npub(crate) const K_RG32FLOAT: i64 = 236;\npub(crate) const K_COUNT: i64 = 237;\n// ---- end mod std::gpu::wgsl::names ----\n}\n// ---- mod std::gpu::wgsl::lex ----\nmod lex {\n// ---- Shader compiler implementation, lex (0.22) ----\n// The WGSL lexer: the whole source becomes arrays of tokens (kind, start,\n// end, and for an identifier its symbol). Identifiers are interned: the\n// predeclared names (names.vl) have fixed symbols, so the parser\n// compares integers. Comments (`//`, nesting `/* */`) and blanks are\n// skipped.\n\nuse crate::alloc::Allocator;\nuse crate::collections::HashMap;\nuse crate::hash::FixedState;\n\nuse super::names::PREDECLARED;\n\npub(crate) const T_EOF: u8 = 0;\npub(crate) const T_IDENT: u8 = 1;\n// an integer literal: its text is start .. end, the suffix included\npub(crate) const T_INT: u8 = 2;\npub(crate) const T_FLOAT: u8 = 3;\npub(crate) const T_LPAREN: u8 = 4;\npub(crate) const T_RPAREN: u8 = 5;\npub(crate) const T_LBRACE: u8 = 6;\npub(crate) const T_RBRACE: u8 = 7;\npub(crate) const T_LBRACKET: u8 = 8;\npub(crate) const T_RBRACKET: u8 = 9;\npub(crate) const T_COMMA: u8 = 10;\npub(crate) const T_SEMI: u8 = 11;\npub(crate) const T_COLON: u8 = 12;\npub(crate) const T_DOT: u8 = 13;\npub(crate) const T_AT: u8 = 14;\npub(crate) const T_ARROW: u8 = 15;\npub(crate) const T_EQ: u8 = 16;\npub(crate) const T_EQEQ: u8 = 17;\npub(crate) const T_NE: u8 = 18;\npub(crate) const T_LT: u8 = 19;\n");
    buf_str(out, c"pub(crate) const T_LE: u8 = 20;\npub(crate) const T_GT: u8 = 21;\npub(crate) const T_GE: u8 = 22;\npub(crate) const T_PLUS: u8 = 23;\npub(crate) const T_MINUS: u8 = 24;\npub(crate) const T_STAR: u8 = 25;\npub(crate) const T_SLASH: u8 = 26;\npub(crate) const T_PERCENT: u8 = 27;\npub(crate) const T_AMP: u8 = 28;\npub(crate) const T_PIPE: u8 = 29;\npub(crate) const T_CARET: u8 = 30;\npub(crate) const T_TILDE: u8 = 31;\npub(crate) const T_BANG: u8 = 32;\npub(crate) const T_ANDAND: u8 = 33;\npub(crate) const T_OROR: u8 = 34;\npub(crate) const T_SHL: u8 = 35;\npub(crate) const T_SHR: u8 = 36;\npub(crate) const T_PLUSEQ: u8 = 37;\npub(crate) const T_MINUSEQ: u8 = 38;\npub(crate) const T_STAREQ: u8 = 39;\npub(crate) const T_SLASHEQ: u8 = 40;\npub(crate) const T_PERCENTEQ: u8 = 41;\npub(crate) const T_AMPEQ: u8 = 42;\npub(crate) const T_PIPEEQ: u8 = 43;\npub(crate) const T_CARETEQ: u8 = 44;\npub(crate) const T_SHLEQ: u8 = 45;\npub(crate) const T_SHREQ: u8 = 46;\npub(crate) const T_PLUSPLUS: u8 = 47;\npub(crate) const T_MINUSMINUS: u8 = 48;\npub(crate) const T_UNDERSCORE: u8 = 49;\n// a byte that starts no token\npub(crate) const T_BAD: u8 = 50;\n\npub(crate) struct Tokens<'a, A: Allocator> {\n    pub(crate) kinds: Vec<u8, A>,\n    pub(crate) starts: Vec<i64, A>,\n    pub(crate) ends: Vec<i64, A>,\n    // the symbol of an identifier, else -1\n    pub(crate) syms: Vec<i64, A>,\n    // symbol -> its text\n    pub(crate) names: Vec<&'a [u8], A>,\n    // (the path spelled: std::collections is read once a unit names it)\n    intern: crate::collections::HashMap<&'a [u8], i64, A, FixedState>,\n    // a comment that is not closed: its start, else -1\n    pub(crate) open_comment: i64,\n}\n\nfn is_ident_start(c: u8) -> bool {\n    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_'\n}\n\nfn is_ident_char(c: u8) -> bool { is_ident_start(c) || (c >= b'0' && c <= b'9') }\n\nfn is_hex(c: u8) -> bool {\n");
    buf_str(out, c"    (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')\n}\n\nfn is_dec(c: u8) -> bool { c >= b'0' && c <= b'9' }\n\nimpl<'a, A: Allocator + Copy> Tokens<'a, A> {\n    #[effects(A)]\n    pub(crate) fn sym(&mut self, s: &'a [u8]) -> i64 {\n        if let Some(h) = self.intern.get(&s).copied() {\n            return h;\n        }\n        let h = self.names.len() as i64;\n        self.names.push(s);\n        self.intern.insert(s, h);\n        h\n    }\n\n    fn push_token(&mut self, k: u8, s: i64, e: i64, sym: i64) {\n        self.kinds.push(k);\n        self.starts.push(s);\n        self.ends.push(e);\n        self.syms.push(sym);\n    }\n}\n\n// The length of the number at src[i ..], and whether it is a float.\nfn number_len(src: &[u8], i: i64) -> (i64, bool) {\n    let n = src.len() as i64;\n    let mut j = i;\n    let mut float = false;\n    if src[j as usize] == b'0' && j + 1 < n\n        && (src[(j + 1) as usize] == b'x' || src[(j + 1) as usize] == b'X') {\n        j += 2;\n        while j < n && is_hex(src[j as usize]) {\n            j += 1;\n        }\n        if j < n && src[j as usize] == b'.' {\n            float = true;\n            j += 1;\n            while j < n && is_hex(src[j as usize]) {\n                j += 1;\n            }\n        }\n        if j < n && (src[j as usize] == b'p' || src[j as usize] == b'P') {\n            float = true;\n            j += 1;\n            if j < n && (src[j as usize] == b'+' || src[j as usize] == b'-') {\n                j += 1;\n            }\n            while j < n && is_dec(src[j as usize]) {\n                j += 1;\n            }\n        }\n        if j < n && (src[j as usize] == b'f' || src[j as usize] == b'h') && float {\n            j += 1;\n        } else if j < n && (src[j as usize] == b'i' || src[j as usize] == b'u') && !float {\n            j += 1;\n        }\n        return (j - i, float);\n    }\n    while j < n && is_dec(src[j as usize]) {\n        j += 1;\n    }\n");
    buf_str(out, c"    if j < n && src[j as usize] == b'.' && !(j + 1 < n && src[(j + 1) as usize] == b'.') {\n        float = true;\n        j += 1;\n        while j < n && is_dec(src[j as usize]) {\n            j += 1;\n        }\n    }\n    if j < n && (src[j as usize] == b'e' || src[j as usize] == b'E') {\n        let mut k = j + 1;\n        if k < n && (src[k as usize] == b'+' || src[k as usize] == b'-') {\n            k += 1;\n        }\n        if k < n && is_dec(src[k as usize]) {\n            float = true;\n            j = k;\n            while j < n && is_dec(src[j as usize]) {\n                j += 1;\n            }\n        }\n    }\n    if j < n && (src[j as usize] == b'f' || src[j as usize] == b'h') {\n        float = true;\n        j += 1;\n    } else if j < n && (src[j as usize] == b'i' || src[j as usize] == b'u') && !float {\n        j += 1;\n    }\n    (j - i, float)\n}\n\n#[effects(panic, diverge, A)]\npub(crate) fn lex<'a, A: Allocator + Copy>(src: &'a [u8], a: A) -> Tokens<'a, A> {\n    let mut t = Tokens {\n        kinds: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        starts: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        ends: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        syms: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        names: Vec::with_capacity_in(512usize, a),\n        intern: HashMap::with_capacity_in(512usize, a),\n        open_comment: -1,\n    };\n    for i in 0..PREDECLARED.len() {\n        t.sym(PREDECLARED[i]);\n    }\n    let n = src.len() as i64;\n    let mut i: i64 = 0;\n    while i < n {\n        let c = src[i as usize];\n        if c == b' ' || c == b'\\n' || c == b'\\t' || c == b'\\r' || c == 11 || c == 12 {\n            i += 1;\n            continue;\n        }\n        if c == b'/' && i + 1 < n && src[(i + 1) as usize] == b'/' {\n            while i < n && src[i as usize] != b'\\n' {\n                i += 1;\n            }\n            continue;\n        }\n");
    buf_str(out, c"        if c == b'/' && i + 1 < n && src[(i + 1) as usize] == b'*' {\n            let start = i;\n            let mut depth: i64 = 1;\n            i += 2;\n            while i < n && depth > 0 {\n                if src[i as usize] == b'/' && i + 1 < n && src[(i + 1) as usize] == b'*' {\n                    depth += 1;\n                    i += 2;\n                } else if src[i as usize] == b'*' && i + 1 < n && src[(i + 1) as usize] == b'/' {\n                    depth -= 1;\n                    i += 2;\n                } else {\n                    i += 1;\n                }\n            }\n            if depth > 0 {\n                t.open_comment = start;\n            }\n            continue;\n        }\n        if is_ident_start(c) {\n            let s = i;\n            while i < n && is_ident_char(src[i as usize]) {\n                i += 1;\n            }\n            if i - s == 1 && c == b'_' {\n                t.push_token(T_UNDERSCORE, s, i, -1);\n            } else {\n                let sym = t.sym(&src[s as usize..i as usize]);\n                t.push_token(T_IDENT, s, i, sym);\n            }\n            continue;\n        }\n        if is_dec(c) || (c == b'.' && i + 1 < n && is_dec(src[(i + 1) as usize])) {\n            let (len, float) = number_len(src, i);\n            t.push_token(if float { T_FLOAT } else { T_INT }, i, i + len, -1);\n            i += len;\n            continue;\n        }\n        let c1 = if i + 1 < n { src[(i + 1) as usize] } else { 0 };\n        let c2 = if i + 2 < n { src[(i + 2) as usize] } else { 0 };\n        let mut k = T_BAD;\n        let mut len: i64 = 1;\n        if c == b'(' {\n            k = T_LPAREN;\n        } else if c == b')' {\n            k = T_RPAREN;\n        } else if c == b'{' {\n            k = T_LBRACE;\n        } else if c == b'}' {\n            k = T_RBRACE;\n        } else if c == b'[' {\n            k = T_LBRACKET;\n        } else if c == b']' {\n            k = T_RBRACKET;\n");
    buf_str(out, c"        } else if c == b',' {\n            k = T_COMMA;\n        } else if c == b';' {\n            k = T_SEMI;\n        } else if c == b':' {\n            k = T_COLON;\n        } else if c == b'.' {\n            k = T_DOT;\n        } else if c == b'@' {\n            k = T_AT;\n        } else if c == b'~' {\n            k = T_TILDE;\n        } else if c == b'=' {\n            if c1 == b'=' {\n                k = T_EQEQ;\n                len = 2;\n            } else {\n                k = T_EQ;\n            }\n        } else if c == b'!' {\n            if c1 == b'=' {\n                k = T_NE;\n                len = 2;\n            } else {\n                k = T_BANG;\n            }\n        } else if c == b'<' {\n            if c1 == b'<' && c2 == b'=' {\n                k = T_SHLEQ;\n                len = 3;\n            } else if c1 == b'<' {\n                k = T_SHL;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_LE;\n                len = 2;\n            } else {\n                k = T_LT;\n            }\n        } else if c == b'>' {\n            if c1 == b'>' && c2 == b'=' {\n                k = T_SHREQ;\n                len = 3;\n            } else if c1 == b'>' {\n                k = T_SHR;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_GE;\n                len = 2;\n            } else {\n                k = T_GT;\n            }\n        } else if c == b'+' {\n            if c1 == b'+' {\n                k = T_PLUSPLUS;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_PLUSEQ;\n                len = 2;\n            } else {\n                k = T_PLUS;\n            }\n        } else if c == b'-' {\n            if c1 == b'>' {\n                k = T_ARROW;\n                len = 2;\n            } else if c1 == b'-' {\n                k = T_MINUSMINUS;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_MINUSEQ;\n");
    buf_str(out, c"                len = 2;\n            } else {\n                k = T_MINUS;\n            }\n        } else if c == b'*' {\n            if c1 == b'=' {\n                k = T_STAREQ;\n                len = 2;\n            } else {\n                k = T_STAR;\n            }\n        } else if c == b'/' {\n            if c1 == b'=' {\n                k = T_SLASHEQ;\n                len = 2;\n            } else {\n                k = T_SLASH;\n            }\n        } else if c == b'%' {\n            if c1 == b'=' {\n                k = T_PERCENTEQ;\n                len = 2;\n            } else {\n                k = T_PERCENT;\n            }\n        } else if c == b'&' {\n            if c1 == b'&' {\n                k = T_ANDAND;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_AMPEQ;\n                len = 2;\n            } else {\n                k = T_AMP;\n            }\n        } else if c == b'|' {\n            if c1 == b'|' {\n                k = T_OROR;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_PIPEEQ;\n                len = 2;\n            } else {\n                k = T_PIPE;\n            }\n        } else if c == b'^' {\n            if c1 == b'=' {\n                k = T_CARETEQ;\n                len = 2;\n            } else {\n                k = T_CARET;\n            }\n        }\n        t.push_token(k, i, i + len, -1);\n        i += len;\n    }\n    t.push_token(T_EOF, n, n, -1);\n    t\n}\n\n// How a token is written, for messages.\n#[effects()]\npub(crate) fn token_text(k: u8) -> &'static [u8] {\n    if k == T_EOF {\n        b\"the end of the file\"\n    } else if k == T_IDENT {\n        b\"an identifier\"\n    } else if k == T_INT || k == T_FLOAT {\n        b\"a number\"\n    } else if k == T_LPAREN {\n        b\"'('\"\n    } else if k == T_RPAREN {\n        b\"')'\"\n    } else if k == T_LBRACE {\n        b\"'{'\"\n    } else if k == T_RBRACE {\n        b\"'}'\"\n");
    buf_str(out, c"    } else if k == T_LBRACKET {\n        b\"'['\"\n    } else if k == T_RBRACKET {\n        b\"']'\"\n    } else if k == T_COMMA {\n        b\"','\"\n    } else if k == T_SEMI {\n        b\"';'\"\n    } else if k == T_COLON {\n        b\"':'\"\n    } else if k == T_DOT {\n        b\"'.'\"\n    } else if k == T_AT {\n        b\"'@'\"\n    } else if k == T_ARROW {\n        b\"'->'\"\n    } else if k == T_EQ {\n        b\"'='\"\n    } else if k == T_LT {\n        b\"'<'\"\n    } else if k == T_GT {\n        b\"'>'\"\n    } else if k == T_UNDERSCORE {\n        b\"'_'\"\n    } else if k == T_BAD {\n        b\"a character WGSL does not use\"\n    } else {\n        b\"an operator\"\n    }\n}\n// ---- end mod std::gpu::wgsl::lex ----\n}\n// ---- mod std::gpu::wgsl::front ----\npub mod front {\n// ---- Shader compiler implementation, front (0.22) ----\n// The WGSL front end: parsing, name resolution and type checking in one\n// pass from tokens to IR (docs/design/gpu.md §2.10), with no syntax tree\n// in between.\n//\n// - A skim finds the module-scope declarations (any order is allowed);\n//   types, constants and function signatures are resolved on demand from\n//   their tokens, function bodies in source order.\n// - Expressions are lowered as they are parsed: a `Val` is an IR\n//   expression, a reference (a pointer the Load Rule reads), or a\n//   constant (abstract numbers included) not yet in the IR.\n// - The first error stops the translation: it is recorded, and from then\n//   on every token reads as the end of the file, so the parse unwinds.\n\nuse crate::mem;\nuse crate::alloc::Allocator;\n\nuse super::{entry, ir, lex, names};\nuse super::ir::{\n    ACC_READ, ACC_RW, ACC_WRITE, BIND_BUILTIN, BIND_LOCATION, Binding, E_ARG, E_CALL_RESULT,\n    E_GLOBAL, E_LOCAL, Entry, Function, Global, INTERP_FLAT, INTERP_LINEAR, INTERP_PERSPECTIVE,\n    Local, Module, Param, SK_BOOL, SK_F32, SK_I32, SK_U32, SP_FUNCTION, SP_HANDLE, SP_PRIVATE,\n");
    buf_str(out, c"    SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, S_BLOCK,\n    S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_KILL, S_LOOP, S_RETURN, S_STORE, S_SWITCH,\n    StructMember, TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT,\n    TK_TEXTURE, TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, new_function, no_binding,\n};\nuse super::lex::{\n    T_ARROW, T_AT, T_COLON, T_COMMA, T_EOF, T_EQ, T_GT, T_IDENT, T_LBRACE, T_LBRACKET, T_LPAREN,\n    T_LT, T_MINUSMINUS, T_PLUSPLUS, T_RBRACE, T_RBRACKET, T_RPAREN, T_SEMI, T_SHR, T_UNDERSCORE,\n    Tokens, token_text,\n};\nuse super::names::{\n    K_ALIAS, K_ALIGN, K_BINDING, K_BREAK, K_BUILTIN, K_CASE, K_CENTER, K_CENTROID, K_COMPUTE,\n    K_CONST, K_CONST_ASSERT, K_CONTINUE, K_CONTINUING, K_DEFAULT, K_DIAGNOSTIC, K_DISCARD, K_ELSE,\n    K_ENABLE, K_FLAT, K_FN, K_FOR, K_FRAGMENT, K_GROUP, K_ID, K_IF, K_INTERPOLATE, K_INVARIANT,\n    K_LET, K_LINEAR, K_LOCATION, K_LOOP, K_MUST_USE, K_OVERRIDE, K_PERSPECTIVE, K_REQUIRES,\n    K_RETURN, K_SAMPLE, K_SIZE, K_STRUCT, K_SWITCH, K_VAR, K_VERTEX, K_WHILE, K_WORKGROUP_SIZE,\n};\n\n// ---- Shader compiler implementation, front: Values (0.22) ----\n\n// an IR expression's value\npub(crate) const VK_VALUE: u8 = 0;\n// a reference: `e` is a pointer, read by the Load Rule where a value is needed\npub(crate) const VK_REF: u8 = 1;\n// a constant scalar not yet in the IR: iv (bool, integers) or fv (floats);\n// sk may be abstract; ty is its type, -1 when abstract\npub(crate) const VK_CONST: u8 = 2;\n// a module-scope or local name that is a type (in a constructor call)\npub(crate) const VK_TYPE: u8 = 3;\n// no value (a call of a function without a result)\npub(crate) const VK_VOID: u8 = 4;\n\n#[derive(Clone, Copy)] pub struct Val {\n    pub k: u8, pub sk: u8, pub e: i64, pub ty: i64, pub iv: i64, pub fv: f64,\n}\n\n#[effects()]\npub(crate) fn val(e: i64, ty: i64) -> Val {\n    Val { k: VK_VALUE, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 }\n}\n\n");
    buf_str(out, c"#[effects()]\npub(crate) fn cint(sk: u8, ty: i64, v: i64) -> Val {\n    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: v, fv: 0.0 }\n}\n\n#[effects()]\npub(crate) fn cfloat(sk: u8, ty: i64, v: f64) -> Val {\n    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: 0, fv: v }\n}\n\n// ---- Shader compiler implementation, front: Declarations (0.22) ----\n\npub(crate) const D_FN: u8 = 0;\npub(crate) const D_STRUCT: u8 = 1;\npub(crate) const D_VAR: u8 = 2;\npub(crate) const D_CONST: u8 = 3;\npub(crate) const D_ALIAS: u8 = 4;\n\npub(crate) const DS_TODO: u8 = 0;\npub(crate) const DS_BUSY: u8 = 1;\npub(crate) const DS_DONE: u8 = 2;\n\n// tok: the token after the attributes (the keyword); attr: the first\n// attribute's token; h: the type, global or function once resolved; cv:\n// a constant's value once known (scalars)\n#[derive(Clone, Copy)] pub struct Decl {\n    pub(crate) kind: u8, state: u8, sym: i64, tok: i64, attr: i64, pub h: i64, pub cv: Val,\n    pub(crate) has_cv: bool,\n}\n\n// A name in a function's scopes.\n#[derive(Clone, Copy)] pub struct ScopeEntry { pub sym: i64, pub v: Val, mutable: bool }\n\n#[derive(Clone, Copy)] pub struct Attrs {\n    stage: i64,\n    wg: [i64; 3],\n    group: i64,\n    binding: i64,\n    loc: i64,\n    builtin: i64,\n    interp: i64,\n    pos: i64,\n}\n\npub struct Front<'a, A: Allocator> {\n    pub(crate) src: &'a [u8],\n    pub(crate) tk: Tokens<'a, A>,\n    pub(crate) p: i64,\n    pub m: Module<'a, A>,\n    pub(crate) a: A,\n    pub failed: bool,\n    pub err_code: &'static [u8],\n    pub err_pos: i64,\n    pub emsg: Vec<u8, A>,\n    pub ehelp: Vec<u8, A>,\n    pub(crate) decls: Vec<Decl, A>,\n    // symbol -> its declaration, or -1\n    pub(crate) decl_of: Vec<i64, A>,\n    // the function being lowered\n    pub(crate) f: Function<'a, A>,\n    pub(crate) fh: i64,\n    pub(crate) pending: Vec<i64, A>,\n    emit_start: i64,\n    pub(crate) scopes: Vec<ScopeEntry, A>,\n    pub(crate) scope_floor: i64,\n");
    buf_str(out, c"    // global -> its E_GLOBAL in f, or -1\n    gexpr: Vec<i64, A>,\n    loop_depth: i64,\n    switch_depth: i64,\n    in_continuing: bool,\n    // the start of each loop's body scope (for `continuing`'s check)\n    // the stage of the entry point being lowered (255: a plain function)\n    pub(crate) stage: i64,\n    // the compare-exchange result types: [i32's, u32's], -1 until made\n    pub(crate) cmpxchg_ty: [i64; 2],\n    pub(crate) tmp: Vec<u8, A>,\n    // the expected type of the expression being parsed (for inferred\n    // constructors of abstract numbers), or -1\n    pub(crate) hint: i64,\n    // the token after the last call's `)`, and whether a statement was one\n    pub(crate) last_call_end: i64,\n    pub(crate) last_was_call: bool,\n    // call arguments being parsed, with their positions; lowered ones\n    pub(crate) astack: Vec<Val, A>,\n    pub(crate) apos: Vec<i64, A>,\n    pub(crate) estack: Vec<i64, A>,\n}\n\n#[effects(A)]\npub fn new_front<'a, A: Allocator + Copy>(src: &'a [u8], a: A) -> Front<'a, A> {\n    let tk = lex::lex(src, a);\n    Front {\n        src: src,\n        tk: tk,\n        p: 0,\n        m: Module::new(a),\n        a: a,\n        failed: false,\n        err_code: b\"\",\n        err_pos: 0,\n        emsg: Vec::new_in(a),\n        ehelp: Vec::new_in(a),\n        decls: Vec::new_in(a),\n        decl_of: Vec::new_in(a),\n        f: new_function(b\"\", a),\n        fh: -1,\n        pending: Vec::new_in(a),\n        emit_start: 0,\n        scopes: Vec::new_in(a),\n        scope_floor: 0,\n        gexpr: Vec::new_in(a),\n        loop_depth: 0,\n        switch_depth: 0,\n        in_continuing: false,\n        stage: 255,\n        cmpxchg_ty: [-1, -1],\n        tmp: Vec::new_in(a),\n        hint: -1,\n        last_call_end: -1,\n        last_was_call: false,\n        astack: Vec::new_in(a),\n        apos: Vec::new_in(a),\n        estack: Vec::new_in(a),\n    }\n}\n\nimpl<'a, A: Allocator + Copy> Front<'a, A> {\n    // ---- Errors ----\n\n");
    buf_str(out, c"    // Records an error at byte `pos` with `code`; true when it is the\n    // first (the caller then writes the message into emsg).\n    #[effects()]\n    pub(crate) fn err(&mut self, pos: i64, code: &'static [u8]) -> bool {\n        if self.failed {\n            return false;\n        }\n        self.failed = true;\n        self.err_code = code;\n        self.err_pos = pos;\n        true\n    }\n\n    #[effects(A)]\n    pub(crate) fn fail(&mut self, pos: i64, code: &'static [u8], msg: &[u8]) {\n        if self.err(pos, code) {\n            self.emsg.extend_from_slice(msg);\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn help(&mut self, h: &[u8]) {\n        if self.ehelp.len() as i64 == 0 {\n            self.ehelp.extend_from_slice(h);\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn ty_str(&mut self, t: i64) {\n        self.m.type_name(t, &mut self.emsg);\n    }\n\n    // The type of a value as WGSL writes it, into emsg.\n    #[effects(A)]\n    pub(crate) fn val_str(&mut self, v: Val) {\n        if v.k == VK_CONST && v.ty < 0 {\n            self.emsg.extend_from_slice(ir::scalar_name(v.sk));\n        } else if v.k == VK_REF {\n            self.emsg.extend_from_slice(b\"ref to \");\n            self.ty_str(self.m.pointee(v.ty));\n        } else if v.k == VK_VOID {\n            self.emsg.extend_from_slice(b\"nothing (a call without a result)\");\n        } else {\n            self.ty_str(v.ty);\n        }\n    }\n\n    // ---- Tokens ----\n\n    #[effects(panic, A)]\n    pub(crate) fn kind(&self) -> u8 {\n        if self.failed {\n            T_EOF\n        } else {\n            self.tk.kinds[self.p as usize]\n        }\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn kind_at(&self, i: i64) -> u8 {\n        if self.failed || i >= self.tk.kinds.len() as i64 {\n            T_EOF\n        } else {\n            self.tk.kinds[i as usize]\n        }\n    }\n\n    pub(crate) fn sym(&self) -> i64 {\n        if self.failed {\n            -1\n");
    buf_str(out, c"        } else {\n            self.tk.syms[self.p as usize]\n        }\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn pos(&self) -> i64 { self.tk.starts[self.p as usize] }\n\n    #[effects(panic, A)]\n    pub(crate) fn text(&self, i: i64) -> &'a [u8] { &self.src[\n        self.tk.starts[i as usize] as usize..self.tk.ends[i as usize] as usize] }\n\n    #[effects(panic, A)]\n    pub(crate) fn is_kw(&self, k: i64) -> bool {\n        self.kind() == T_IDENT && self.tk.syms[self.p as usize] == k\n    }\n\n    #[effects(A)]\n    pub(crate) fn eat(&mut self, k: u8) -> bool {\n        if self.kind() == k {\n            self.p += 1;\n            true\n        } else {\n            false\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn eat_kw(&mut self, k: i64) -> bool {\n        if self.is_kw(k) {\n            self.p += 1;\n            true\n        } else {\n            false\n        }\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn expect(&mut self, k: u8) {\n        if self.kind() == k {\n            self.p += 1;\n            return;\n        }\n        if self.failed {\n            return;\n        }\n        let got = self.kind();\n        if self.err(self.pos(), b\"wgsl.syntax\") {\n            write(self.emsg, \"expected {}, got \", str::from_utf8(token_text(k)).unwrap()).unwrap();\n            if got == T_IDENT {\n                write(self.emsg, \"'{}'\", str::from_utf8(self.text(self.p)).unwrap()).unwrap();\n            } else {\n                self.emsg.extend_from_slice(token_text(got));\n            }\n        }\n    }\n\n    // `>` closing a template list; a `>>` token gives one `>` and leaves one.\n    #[effects(panic, A)]\n    pub(crate) fn expect_gt(&mut self) {\n        if self.kind() == T_SHR {\n            self.tk.kinds[self.p as usize] = T_GT;\n            self.tk.starts[self.p as usize] += 1;\n            return;\n        }\n        self.expect(T_GT);\n    }\n\n    #[effects(panic, A)]\n");
    buf_str(out, c"    pub(crate) fn ident(&mut self) -> i64 {\n        if self.kind() == T_IDENT {\n            let s = self.tk.syms[self.p as usize];\n            self.p += 1;\n            return s;\n        }\n        self.expect(T_IDENT);\n        -1\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn name_of(&self, sym: i64) -> &'a [u8] {\n        if sym < 0 {\n            b\"_\"\n        } else {\n            self.tk.names[sym as usize]\n        }\n    }\n\n    // ---- Statements of the function being built ----\n\n    #[effects(A)]\n    pub(crate) fn flush(&mut self) {\n        let n = self.f.exprs.len() as i64;\n        if n > self.emit_start {\n            let s = self.f.stmt(S_EMIT, self.emit_start, n, 0, 0);\n            self.pending.push(s);\n            self.emit_start = n;\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn push_stmt(&mut self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n        self.flush();\n        let s = self.f.stmt(op, a, b, c, d);\n        self.pending.push(s);\n        s\n    }\n\n    // An expression made outside every emit range (a call's result).\n    #[effects(A)]\n    pub(crate) fn unemitted(&mut self, op: u8, ty: i64) -> i64 {\n        self.flush();\n        let e = self.f.expr(op, ty, 0, 0, 0);\n        self.emit_start = self.f.exprs.len() as i64;\n        e\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn global_expr(&mut self, g: i64) -> i64 {\n        if self.gexpr[g as usize] >= 0 {\n            return self.gexpr[g as usize];\n        }\n        let gl = self.m.globals[g as usize];\n        let ty = if gl.space == SP_HANDLE { gl.ty }\n            else { self.m.ptr_ty(gl.ty, gl.space, gl.access) };\n        let e = self.f.expr(E_GLOBAL, ty, g, 0, 0);\n        self.gexpr[g as usize] = e;\n        e\n    }\n\n    // ---- The module ----\n\n    // Finds every module-scope declaration, without resolving any.\n    fn skim(&mut self) {\n        for _ in 0..self.tk.names.len() as i64 {\n            self.decl_of.push(-1);\n");
    buf_str(out, c"        }\n        while self.kind() != T_EOF {\n            let attr = self.p;\n            self.skip_attrs();\n            let tok = self.p;\n            if self.is_kw(K_ENABLE) || self.is_kw(K_REQUIRES) || self.is_kw(K_DIAGNOSTIC) {\n                let at = self.pos();\n                if self.is_kw(K_DIAGNOSTIC) {\n                    self.skip_to_semi();\n                    continue;\n                }\n                self.p += 1;\n                let what = self.text(self.p);\n                if self.err(at, b\"wgsl.unsupported\") {\n                    {\n                        let what = str::from_utf8(what).unwrap();\n                        write(self.emsg,\n                            \"'{what}' is not in the WGSL subset of this release (no extensions)\").unwrap();\n                    }\n                    self.help(b\"remove the directive; f16 and the other extensions come later\");\n                }\n                return;\n            }\n            if self.is_kw(K_CONST_ASSERT) {\n                self.fail(self.pos(), b\"wgsl.unsupported\",\n                    b\"'const_assert' is not in the WGSL subset of this release\");\n                return;\n            }\n            if self.is_kw(K_OVERRIDE) {\n                self.fail(self.pos(), b\"wgsl.unsupported\",\n                    b\"'override' constants are not in the WGSL subset of this release\");\n                self.help(b\"use a 'const', or a uniform buffer\");\n                return;\n            }\n            if self.eat(T_SEMI) {\n                continue;\n            }\n            let mut kind = D_FN;\n            if self.is_kw(K_FN) {\n                kind = D_FN;\n            } else if self.is_kw(K_STRUCT) {\n                kind = D_STRUCT;\n            } else if self.is_kw(K_VAR) {\n                kind = D_VAR;\n            } else if self.is_kw(K_CONST) {\n                kind = D_CONST;\n            } else if self.is_kw(K_ALIAS) {\n                kind = D_ALIAS;\n");
    buf_str(out, c"            } else {\n                if self.kind() == T_IDENT && self.text(self.p) == b\"let\" {\n                    self.fail(self.pos(), b\"wgsl.syntax\", b\"'let' is not allowed at module scope\");\n                    self.help(b\"use 'const' for a module-scope constant\");\n                    return;\n                }\n                if self.err(self.pos(), b\"wgsl.syntax\") {\n                    self.emsg.extend_from_slice(\n                        b\"expected a declaration ('fn', 'struct', 'var', 'const', 'alias'), got \");\n                    if self.kind() == T_IDENT {\n                        write(self.emsg, \"'{}'\", str::from_utf8(self.text(self.p)).unwrap()).unwrap();\n                    } else {\n                        self.emsg.extend_from_slice(token_text(self.kind()));\n                    }\n                }\n                return;\n            }\n            self.p += 1;\n            if kind == D_VAR && self.kind() == T_LT {\n                self.skip_template();\n            }\n            let at = self.pos();\n            let sym = self.ident();\n            if sym >= 0 {\n                if self.decl_of[sym as usize] >= 0 {\n                    if self.err(at, b\"wgsl.redefined\") {\n                        write(self.emsg, \"'{}' is declared twice at module scope\",\n                            str::from_utf8(self.name_of(sym)).unwrap()).unwrap();\n                    }\n                    return;\n                }\n                self.decl_of[sym as usize] = self.decls.len() as i64;\n            }\n            self.decls.push(Decl {\n                kind: kind, state: DS_TODO, sym: sym, tok: tok, attr: attr, h: -1,\n                cv: cint(0, -1, 0), has_cv: false,\n            });\n            if kind == D_FN {\n                while self.kind() != T_LBRACE && self.kind() != T_EOF {\n                    self.p += 1;\n                }\n                self.skip_balanced();\n            } else if kind == D_STRUCT {\n");
    buf_str(out, c"                self.skip_balanced();\n                self.eat(T_SEMI);\n            } else {\n                self.skip_to_semi();\n            }\n        }\n    }\n\n    fn skip_attrs(&mut self) {\n        while self.kind() == T_AT {\n            self.p += 1;\n            self.ident();\n            if self.kind() == T_LPAREN {\n                self.skip_balanced();\n            }\n        }\n    }\n\n    // Skips a bracketed group from its opening token.\n    fn skip_balanced(&mut self) {\n        let mut depth: i64 = 0;\n        loop {\n            let k = self.kind();\n            if k == T_EOF {\n                return;\n            }\n            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n                depth += 1;\n            } else if k == T_RPAREN || k == T_RBRACE || k == T_RBRACKET {\n                depth -= 1;\n            }\n            self.p += 1;\n            if depth <= 0 {\n                return;\n            }\n        }\n    }\n\n    fn skip_template(&mut self) {\n        let mut depth: i64 = 0;\n        loop {\n            let k = self.kind();\n            if k == T_EOF {\n                return;\n            }\n            if k == T_LT {\n                depth += 1;\n            } else if k == T_GT {\n                depth -= 1;\n            } else if k == T_SHR {\n                depth -= 2;\n            }\n            self.p += 1;\n            if depth <= 0 {\n                return;\n            }\n        }\n    }\n\n    fn skip_to_semi(&mut self) {\n        while self.kind() != T_SEMI && self.kind() != T_EOF {\n            let k = self.kind();\n            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n                self.skip_balanced();\n            } else {\n                self.p += 1;\n            }\n        }\n        self.eat(T_SEMI);\n    }\n\n    // Resolves the whole module: types, globals, signatures, then bodies.\n    #[effects(panic, diverge, A)]\n    pub fn module(&mut self) {\n");
    buf_str(out, c"        if self.tk.open_comment >= 0 {\n            self.fail(self.tk.open_comment, b\"wgsl.syntax\", b\"this block comment is not closed\");\n            return;\n        }\n        for i in 0..self.tk.kinds.len() as i64 {\n            if self.tk.kinds[i as usize] == lex::T_BAD {\n                self.p = i;\n                if self.err(self.pos(), b\"wgsl.syntax\") {\n                    write(self.emsg, \"unexpected character '{}'\",\n                        str::from_utf8(self.text(i)).unwrap()).unwrap();\n                }\n                return;\n            }\n        }\n        self.skim();\n        if self.failed {\n            return;\n        }\n        // function handles, in declaration order\n        for i in 0..self.decls.len() as i64 {\n            if self.decls[i as usize].kind == D_FN {\n                self.decls[i as usize].h = self.m.functions.len() as i64;\n                let f = new_function(self.name_of(self.decls[i as usize].sym), self.a);\n                self.m.functions.push(f);\n            }\n        }\n        self.f = mem::replace(&mut self.m.consts, new_function(b\"\", self.a));\n        for i in 0..self.decls.len() as i64 {\n            let k = self.decls[i as usize].kind;\n            if k == D_STRUCT || k == D_ALIAS {\n                self.resolve_type_decl(i);\n            } else if k == D_VAR {\n                self.resolve_global(i);\n            } else if k == D_CONST {\n                self.const_value(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        self.m.consts = mem::replace(&mut self.f, new_function(b\"\", self.a));\n        for i in 0..self.decls.len() as i64 {\n            if self.decls[i as usize].kind == D_FN {\n                self.signature(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        for i in 0..self.decls.len() as i64 {\n            if self.decls[i as usize].kind == D_FN {\n");
    buf_str(out, c"                self.lower_fn(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        self.check_calls();\n    }\n\n    // ---- Attributes ----\n\n    fn const_int_arg(&mut self) -> i64 {\n        let at = self.pos();\n        let v = self.parse_expr();\n        if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n            self.fail(at, b\"wgsl.type\", b\"expected a constant integer\");\n            return 0;\n        }\n        v.iv\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn parse_attrs(&mut self) -> Attrs {\n        let mut at = Attrs {\n            stage: -1, wg: [0i64, 0, 0], group: -1, binding: -1, loc: -1, builtin: -1, interp: -1,\n            pos: self.pos(),\n        };\n        while self.kind() == T_AT {\n            self.p += 1;\n            let apos = self.pos();\n            let s = self.ident();\n            if s == K_VERTEX {\n                at.stage = STAGE_VERTEX as i64;\n            } else if s == K_FRAGMENT {\n                at.stage = STAGE_FRAGMENT as i64;\n            } else if s == K_COMPUTE {\n                at.stage = STAGE_COMPUTE as i64;\n            } else if s == K_WORKGROUP_SIZE {\n                self.expect(T_LPAREN);\n                at.wg = [1i64, 1, 1];\n                let mut i: i64 = 0;\n                while i < 3 && self.kind() != T_RPAREN && self.kind() != T_EOF {\n                    let p = self.pos();\n                    let n = self.const_int_arg();\n                    if n < 1 || n > 1024 {\n                        self.fail(p, b\"wgsl.attr\", b\"a workgroup size is 1 to 1024\");\n                    }\n                    at.wg[i as usize] = n;\n                    i += 1;\n                    if !self.eat(T_COMMA) {\n                        break;\n                    }\n                }\n                self.expect(T_RPAREN);\n                if at.wg[0] * at.wg[1] * at.wg[2] > 1024 {\n");
    buf_str(out, c"                    self.fail(apos, b\"wgsl.attr\", b\"a workgroup has at most 1024 invocations\");\n                }\n            } else if s == K_GROUP || s == K_BINDING || s == K_LOCATION {\n                self.expect(T_LPAREN);\n                let p = self.pos();\n                let n = self.const_int_arg();\n                self.eat(T_COMMA);\n                self.expect(T_RPAREN);\n                if n < 0 {\n                    self.fail(p, b\"wgsl.attr\", b\"expected a non-negative integer\");\n                }\n                if s == K_GROUP {\n                    at.group = n;\n                } else if s == K_BINDING {\n                    at.binding = n;\n                } else {\n                    at.loc = n;\n                }\n            } else if s == K_BUILTIN {\n                self.expect(T_LPAREN);\n                let bp = self.pos();\n                let b = self.ident();\n                self.eat(T_COMMA);\n                self.expect(T_RPAREN);\n                if b >= names::K_POSITION && b <= names::K_NUM_WORKGROUPS {\n                    at.builtin = b - names::K_POSITION;\n                } else if self.err(bp, b\"wgsl.attr\") {\n                    write(self.emsg, \"unknown builtin value '{}'\",\n                        str::from_utf8(self.name_of(b)).unwrap()).unwrap();\n                }\n            } else if s == K_INTERPOLATE {\n                self.expect(T_LPAREN);\n                let ip = self.pos();\n                let k = self.ident();\n                if k == K_FLAT {\n                    at.interp = INTERP_FLAT as i64;\n                } else if k == K_LINEAR {\n                    at.interp = INTERP_LINEAR as i64;\n                } else if k == K_PERSPECTIVE {\n                    at.interp = INTERP_PERSPECTIVE as i64;\n                } else {\n                    self.fail(ip, b\"wgsl.attr\", b\"expected 'flat', 'linear' or 'perspective'\");\n                }\n");
    buf_str(out, c"                if self.eat(T_COMMA) && self.kind() == T_IDENT {\n                    let smp = self.ident();\n                    if smp != K_CENTER {\n                        if smp == K_CENTROID || smp == K_SAMPLE {\n                            self.fail(ip, b\"wgsl.unsupported\",\n                                b\"only 'center' sampling is in the WGSL subset of this release\");\n                        }\n                    }\n                    self.eat(T_COMMA);\n                }\n                self.expect(T_RPAREN);\n            } else if s == K_MUST_USE {\n            } else if s == K_INVARIANT || s == K_ALIGN || s == K_SIZE || s == K_ID {\n                if self.err(apos, b\"wgsl.unsupported\") {\n                    write(self.emsg, \"'@{}' is not in the WGSL subset of this release\",\n                        str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                }\n            } else if self.err(apos, b\"wgsl.attr\") {\n                write(self.emsg, \"unknown attribute '@{}'\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n        }\n        at\n    }\n\n    fn binding_of(&self, at: Attrs) -> Binding {\n        if at.builtin >= 0 {\n            return Binding { kind: BIND_BUILTIN, interp: INTERP_PERSPECTIVE, value: at.builtin };\n        }\n        if at.loc >= 0 {\n            let ip = if at.interp >= 0 { at.interp as u8 } else { INTERP_PERSPECTIVE };\n            return Binding { kind: BIND_LOCATION, interp: ip, value: at.loc };\n        }\n        no_binding()\n    }\n\n    // ---- Types ----\n\n    fn resolve_type_decl(&mut self, d: i64) -> i64 {\n        let dd = self.decls[d as usize];\n        if dd.state == DS_DONE {\n            return dd.h;\n        }\n        if dd.state == DS_BUSY {\n            self.p = dd.tok;\n            if self.err(self.pos(), b\"wgsl.cycle\") {\n                write(self.emsg, \"'{}' refers to itself\",\n");
    buf_str(out, c"                    str::from_utf8(self.name_of(dd.sym)).unwrap()).unwrap();\n            }\n            return T_I32;\n        }\n        self.decls[d as usize].state = DS_BUSY;\n        let saved = self.p;\n        self.p = dd.tok + 2;\n        let mut h = T_I32;\n        if dd.kind == D_ALIAS {\n            self.expect(T_EQ);\n            h = self.parse_type();\n            self.eat(T_SEMI);\n        } else {\n            h = self.struct_body(dd.sym);\n        }\n        self.p = saved;\n        self.decls[d as usize].state = DS_DONE;\n        self.decls[d as usize].h = h;\n        h\n    }\n\n    fn struct_body(&mut self, sym: i64) -> i64 {\n        self.expect(T_LBRACE);\n        let mut list: Vec<StructMember<'a>, A> = Vec::new_in(self.a);\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            let at = self.parse_attrs();\n            let mpos = self.pos();\n            let ms = self.ident();\n            self.expect(T_COLON);\n            let tpos = self.pos();\n            let ty = self.parse_type();\n            for i in 0..list.len() as i64 {\n                if list[i as usize].name == self.name_of(ms) {\n                    if self.err(mpos, b\"wgsl.redefined\") {\n                        write(self.emsg, \"member '{}' is declared twice\",\n                            str::from_utf8(self.name_of(ms)).unwrap()).unwrap();\n                    }\n                }\n            }\n            if self.m.is_runtime_sized(ty) && self.kind() != T_RBRACE\n                && !(self.kind() == T_COMMA && self.kind_at(self.p + 1) == T_RBRACE) {\n                self.fail(tpos, b\"wgsl.type\",\n                    b\"a runtime-sized array must be the last member of a struct\");\n            }\n            if !self.storable(ty) {\n                if self.err(tpos, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"a struct member cannot have type \");\n                    self.ty_str(ty);\n                }\n            }\n");
    buf_str(out, c"            list.push(StructMember {\n                name: self.name_of(ms), ty: ty, offset: 0, binding: self.binding_of(at),\n            });\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RBRACE);\n        if list.len() as i64 == 0 {\n            self.fail(self.pos(), b\"wgsl.type\", b\"a struct has at least one member\");\n        }\n        let start = self.m.members.len() as i64;\n        for i in 0..list.len() as i64 {\n            self.m.members.push(list[i as usize]);\n        }\n        self.m.struct_ty(self.name_of(sym), start, list.len() as i64)\n    }\n\n    // Whether values of t can live in memory (not pointers, textures, samplers).\n    #[effects(panic, A)]\n    pub(crate) fn storable(&self, t: i64) -> bool {\n        let k = self.m.types[t as usize].kind;\n        k != TK_POINTER && k != TK_TEXTURE && k != TK_SAMPLER\n    }\n\n    // An optional `<T>` after vecN / matCxR: T, else -1.\n    fn template_scalar(&mut self) -> i64 {\n        if self.kind() != T_LT {\n            return -1;\n        }\n        self.p += 1;\n        let t = self.parse_type();\n        self.expect_gt();\n        t\n    }\n\n    // Whether the identifier at the cursor starts a type (for `T(...)`\n    // constructors and template lists in expressions).\n    #[effects(panic, A)]\n    pub(crate) fn is_type_name(&self, s: i64) -> bool {\n        if s >= names::K_BOOL && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n            return true;\n        }\n        if s >= 0 && self.decl_of[s as usize] >= 0 {\n            let k = self.decls[self.decl_of[s as usize] as usize].kind;\n            return k == D_STRUCT || k == D_ALIAS;\n        }\n        false\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn parse_type(&mut self) -> i64 {\n        let at = self.pos();\n        if self.kind() != T_IDENT {\n            self.expect(T_IDENT);\n            return T_I32;\n        }\n");
    buf_str(out, c"        let s = self.tk.syms[self.p as usize];\n        self.p += 1;\n        if s == names::K_BOOL {\n            return T_BOOL;\n        }\n        if s == names::K_I32 {\n            return T_I32;\n        }\n        if s == names::K_U32 {\n            return T_U32;\n        }\n        if s == names::K_F32 {\n            return T_F32;\n        }\n        if s == names::K_F16 || (s >= names::K_VEC2H && s <= names::K_VEC4H) {\n            self.fail(at, b\"wgsl.unsupported\", b\"'f16' is not in the WGSL subset of this release\");\n            self.help(b\"use f32\");\n            return T_F32;\n        }\n        if s >= names::K_VEC2 && s <= names::K_VEC4 {\n            let n = s - names::K_VEC2 + 2;\n            if self.kind() != T_LT {\n                self.fail(at, b\"wgsl.type\",\n                    b\"a vector type needs its component type, as in 'vec3<f32>' or 'vec3f'\");\n                return T_F32;\n            }\n            let c = self.template_scalar();\n            let k = self.m.types[c as usize].kind;\n            if k != TK_SCALAR {\n                self.fail(at, b\"wgsl.type\", b\"a vector's components are bool, i32, u32 or f32\");\n                return T_F32;\n            }\n            return ir::vec_ty(self.m.types[c as usize].scalar, n);\n        }\n        if s >= names::K_VEC2I && s <= names::K_VEC4F {\n            let i = s - names::K_VEC2I;\n            let sk = if i < 3 { SK_I32 } else if i < 6 { SK_U32 } else { SK_F32 };\n            return ir::vec_ty(sk, i % 3 + 2);\n        }\n        if s >= names::K_MAT2X2 && s <= names::K_MAT4X4F {\n            let i = (s - names::K_MAT2X2) % 9;\n            if s <= names::K_MAT4X4 {\n                if self.kind() != T_LT {\n                    self.fail(at, b\"wgsl.type\",\n                        b\"a matrix type needs its component type, as in 'mat4x4<f32>' or 'mat4x4f'\");\n                    return T_F32;\n                }\n                let c = self.template_scalar();\n");
    buf_str(out, c"                if c != T_F32 {\n                    self.fail(at, b\"wgsl.type\",\n                        b\"matrices have f32 components in the WGSL subset of this release\");\n                }\n            }\n            return ir::mat_ty(i / 3 + 2, i % 3 + 2);\n        }\n        if s == names::K_ARRAY {\n            if self.kind() != T_LT {\n                self.fail(at, b\"wgsl.type\",\n                    b\"an array type needs its element type, as in 'array<f32, 4>'\");\n                return T_I32;\n            }\n            self.p += 1;\n            let ep = self.pos();\n            let el = self.parse_type();\n            let mut n: i64 = 0;\n            if self.eat(T_COMMA) {\n                let np = self.pos();\n                let saved_f = self.save_scope_floor();\n                let v = self.parse_shift();\n                self.scope_floor = saved_f;\n                if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n                    self.fail(np, b\"wgsl.type\", b\"an array's length is a constant integer\");\n                    self.help(\n                        b\"a runtime-sized array is written 'array<T>' and lives in a storage buffer\");\n                } else if v.iv < 1 {\n                    self.fail(np, b\"wgsl.type\", b\"an array's length is at least 1\");\n                } else {\n                    n = v.iv;\n                }\n            }\n            self.expect_gt();\n            if self.m.is_runtime_sized(el) {\n                self.fail(ep, b\"wgsl.type\", b\"an array's element cannot be runtime-sized\");\n            }\n            if !self.storable(el) {\n                self.fail(ep, b\"wgsl.type\",\n                    b\"an array's element cannot be a pointer, texture or sampler\");\n            }\n            return self.m.array_ty(el, n);\n        }\n        if s == names::K_ATOMIC {\n            self.expect(T_LT);\n            let c = self.parse_type();\n");
    buf_str(out, c"            self.expect_gt();\n            if c != T_I32 && c != T_U32 {\n                self.fail(at, b\"wgsl.type\", b\"an atomic holds an i32 or a u32\");\n                return self.m.atomic_ty(SK_U32);\n            }\n            return self.m.atomic_ty(self.m.types[c as usize].scalar);\n        }\n        if s == names::K_PTR {\n            self.expect(T_LT);\n            let sp = self.address_space();\n            self.expect(T_COMMA);\n            let t = self.parse_type();\n            let mut acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n            if self.eat(T_COMMA) {\n                acc = self.access_mode();\n            }\n            self.expect_gt();\n            if sp != SP_FUNCTION && sp != SP_PRIVATE {\n                // pointers to other spaces are values only (lets), never parameters\n            }\n            return self.m.ptr_ty(t, sp, acc);\n        }\n        if s == names::K_SAMPLER {\n            return self.m.intern(TK_SAMPLER, 0, 0, 0, -1, 0, 0);\n        }\n        if s == names::K_SAMPLER_COMPARISON {\n            return self.m.intern(TK_SAMPLER, 0, 1, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_2D || s == names::K_TEXTURE_2D_ARRAY {\n            self.expect(T_LT);\n            let c = self.parse_type();\n            self.expect_gt();\n            if c != T_F32 && c != T_I32 && c != T_U32 {\n                self.fail(at, b\"wgsl.type\", b\"a texture's sampled type is f32, i32 or u32\");\n            }\n            let dim = if s == names::K_TEXTURE_2D { ir::TEX_2D } else { ir::TEX_2D_ARRAY };\n            return self.m.intern(TK_TEXTURE, self.m.types[c as usize].scalar, dim, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_DEPTH_2D {\n            return self.m.intern(TK_TEXTURE, SK_F32, ir::TEX_DEPTH_2D, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_STORAGE_2D {\n            self.expect(T_LT);\n            let fp = self.pos();\n            let f = self.ident();\n");
    buf_str(out, c"            let mut fmt: i64 = 0;\n            if f >= names::K_RGBA8UNORM && f <= names::K_RGBA32UINT {\n                fmt = f - names::K_RGBA8UNORM;\n            } else if f >= names::K_RGBA16FLOAT && f <= names::K_RG32FLOAT {\n                fmt = ir::FMT_RGBA16FLOAT + (f - names::K_RGBA16FLOAT);\n            } else {\n                // (gpu::Format::is_storable says the same formats)\n                self.fail(fp, b\"wgsl.unsupported\", b\"storage textures in this release are rgba8unorm, rgba8uint, rgba16float, rgba32float, rgba32uint, rg32float, r32float, r32uint or r32sint\");\n            }\n            self.expect(T_COMMA);\n            let ap = self.pos();\n            let acc = self.access_mode();\n            if acc != ACC_WRITE {\n                self.fail(ap, b\"wgsl.unsupported\",\n                    b\"storage textures are write-only in this release\");\n            }\n            self.expect_gt();\n            let sk = if fmt == ir::FMT_R32UINT || fmt == ir::FMT_RGBA32UINT\n                || fmt == ir::FMT_RGBA8UINT {\n                SK_U32\n            } else if fmt == ir::FMT_R32SINT {\n                SK_I32\n            } else {\n                SK_F32\n            };\n            return self.m.intern(TK_TEXTURE, sk, ir::TEX_STORAGE_2D, fmt, -1, 0, ACC_WRITE);\n        }\n        if s >= names::K_TEXTURE_1D && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n            if self.err(at, b\"wgsl.unsupported\") {\n                write(self.emsg, \"'{}' is not in the WGSL subset of this release\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                self.help(b\"2D textures are: texture_2d, texture_2d_array, texture_depth_2d, texture_storage_2d\");\n            }\n            return T_F32;\n        }\n        if self.decl_of[s as usize] >= 0 {\n            let d = self.decl_of[s as usize];\n            let k = self.decls[d as usize].kind;\n            if k == D_STRUCT || k == D_ALIAS {\n");
    buf_str(out, c"                return self.resolve_type_decl(d);\n            }\n            if self.err(at, b\"wgsl.type\") {\n                write(self.emsg, \"'{}' is not a type\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n            return T_I32;\n        }\n        if self.err(at, b\"wgsl.name\") {\n            write(self.emsg, \"unknown type '{}'\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            self.help(b\"the types are bool, i32, u32, f32, vecN<T>, matCxR<f32>, array<T, N>, atomic<T>, structs\");\n        }\n        T_I32\n    }\n\n    fn address_space(&mut self) -> u8 {\n        let at = self.pos();\n        let s = self.ident();\n        if s == names::K_FUNCTION {\n            SP_FUNCTION\n        } else if s == names::K_PRIVATE {\n            SP_PRIVATE\n        } else if s == names::K_WORKGROUP {\n            SP_WORKGROUP\n        } else if s == names::K_UNIFORM {\n            SP_UNIFORM\n        } else if s == names::K_STORAGE {\n            SP_STORAGE\n        } else {\n            if self.err(at, b\"wgsl.syntax\") {\n                write(self.emsg, \"unknown address space '{}'\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                self.help(b\"the address spaces are function, private, workgroup, uniform, storage\");\n            }\n            SP_PRIVATE\n        }\n    }\n\n    fn access_mode(&mut self) -> u8 {\n        let at = self.pos();\n        let s = self.ident();\n        if s == names::K_READ {\n            ACC_READ\n        } else if s == names::K_WRITE {\n            ACC_WRITE\n        } else if s == names::K_READ_WRITE {\n            ACC_RW\n        } else {\n            if self.err(at, b\"wgsl.syntax\") {\n                write(self.emsg, \"unknown access mode '{}'\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n            ACC_READ\n        }\n    }\n\n    // ---- Globals and constants ----\n\n");
    buf_str(out, c"    fn resolve_global(&mut self, d: i64) {\n        let dd = self.decls[d as usize];\n        let saved = self.p;\n        self.p = dd.attr;\n        let at = self.parse_attrs();\n        self.p = dd.tok + 1;\n        let mut sp = SP_HANDLE;\n        let mut acc = ACC_READ;\n        let mut explicit_space = false;\n        if self.eat(T_LT) {\n            explicit_space = true;\n            sp = self.address_space();\n            acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n            if self.eat(T_COMMA) {\n                let ap = self.pos();\n                acc = self.access_mode();\n                if sp != SP_STORAGE {\n                    self.fail(ap, b\"wgsl.type\", b\"only storage variables have an access mode\");\n                }\n                if acc == ACC_WRITE {\n                    self.fail(ap, b\"wgsl.type\", b\"storage variables are 'read' or 'read_write'\");\n                }\n            }\n            self.expect_gt();\n        }\n        let npos = self.pos();\n        self.ident();\n        let mut ty = T_I32;\n        let mut have_ty = false;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n            have_ty = true;\n        }\n        let mut init: i64 = -1;\n        if self.eat(T_EQ) {\n            let ip = self.pos();\n            if sp != SP_PRIVATE {\n                self.fail(ip, b\"wgsl.type\",\n                    b\"only 'var<private>' may have an initializer at module scope\");\n            }\n            let v = self.parse_expr_hint(if have_ty { ty } else { -1 });\n            if !have_ty {\n                ty = self.concrete_type_of(v);\n                have_ty = true;\n            }\n            init = self.materialize(v, ty, ip);\n            if !self.is_const_expr(init) {\n                self.fail(ip, b\"wgsl.type\",\n                    b\"a module-scope initializer must be a constant expression\");\n            }\n        }\n        self.eat(T_SEMI);\n");
    buf_str(out, c"        if !have_ty {\n            self.fail(npos, b\"wgsl.type\", b\"a module-scope 'var' needs a type\");\n        }\n        let tk = self.m.types[ty as usize].kind;\n        if !explicit_space {\n            if tk != TK_TEXTURE && tk != TK_SAMPLER {\n                self.fail(npos, b\"wgsl.type\", b\"a module-scope 'var' needs an address space, as in 'var<private>' or 'var<storage, read_write>'\");\n            }\n        } else if tk == TK_TEXTURE || tk == TK_SAMPLER {\n            self.fail(npos, b\"wgsl.type\", b\"a texture or sampler is declared without an address space: 'var t: texture_2d<f32>;'\");\n        }\n        if sp == SP_UNIFORM || sp == SP_STORAGE || sp == SP_HANDLE {\n            if at.group < 0 || at.binding < 0 {\n                self.fail(npos, b\"wgsl.binding\", b\"a resource needs '@group(G) @binding(B)'\");\n            }\n        } else if at.group >= 0 || at.binding >= 0 {\n            self.fail(npos, b\"wgsl.binding\",\n                b\"only uniform, storage, texture and sampler variables have a group and binding\");\n        }\n        if sp == SP_UNIFORM && self.m.is_runtime_sized(ty) {\n            self.fail(npos, b\"wgsl.type\", b\"a uniform buffer cannot hold a runtime-sized array\");\n        }\n        if sp != SP_STORAGE && self.m.is_runtime_sized(ty) {\n            self.fail(npos, b\"wgsl.type\", b\"a runtime-sized array lives only in a storage buffer\");\n        }\n        if self.m.has_atomic(ty) && sp != SP_STORAGE && sp != SP_WORKGROUP {\n            self.fail(npos, b\"wgsl.type\", b\"atomics live in storage or workgroup memory\");\n        }\n        if self.m.has_atomic(ty) && sp == SP_STORAGE && acc != ACC_RW {\n            self.fail(npos, b\"wgsl.type\", b\"atomics need 'var<storage, read_write>'\");\n        }\n        if (sp == SP_UNIFORM || sp == SP_STORAGE) && !self.host_shareable(ty) {\n            self.fail(npos, b\"wgsl.type\",\n                b\"a buffer's type cannot hold bool, pointers or textures\");\n");
    buf_str(out, c"        }\n        if sp == SP_UNIFORM {\n            self.check_uniform_layout(ty, npos);\n        }\n        for i in 0..self.m.globals.len() as i64 {\n            let o = self.m.globals[i as usize];\n            if o.group >= 0 && o.group == at.group && o.binding == at.binding {\n                if self.err(npos, b\"wgsl.binding\") {\n                    write(self.emsg, \"@group({}) @binding({}) is also '{}': two variables of one module never share a binding, even when different entry points use them\", at.group, at.binding, str::from_utf8(o.name).unwrap()).unwrap();\n                    self.help(b\"give each kernel its own module (one dev.shader_wgsl each; the shared declarations can be a common prefix of their texts), or give the variables distinct bindings\");\n                }\n            }\n        }\n        let g = Global {\n            name: self.name_of(dd.sym),\n            space: sp,\n            access: acc,\n            ty: ty,\n            group: at.group,\n            binding: at.binding,\n            init: init,\n            pos: npos,\n        };\n        self.m.globals.push(g);\n        self.decls[d as usize].h = self.m.globals.len() as i64 - 1;\n        self.decls[d as usize].state = DS_DONE;\n        self.p = saved;\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn host_shareable(&self, t: i64) -> bool {\n        let ty = self.m.types[t as usize];\n        if ty.kind == TK_SCALAR || ty.kind == TK_VECTOR {\n            return ty.scalar != SK_BOOL;\n        }\n        if ty.kind == TK_MATRIX || ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.host_shareable(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if !self.host_shareable(self.m.members[i as usize].ty) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        false\n    }\n\n");
    buf_str(out, c"    // The uniform address space's extra rules: array strides and struct\n    // alignments are multiples of 16.\n    fn check_uniform_layout(&mut self, t: i64, pos: i64) {\n        let ty = self.m.types[t as usize];\n        if ty.kind == TK_ARRAY {\n            if ty.stride % 16 != 0 {\n                if self.err(pos, b\"wgsl.layout\") {\n                    self.emsg.extend_from_slice(\n                        b\"in a uniform buffer an array's stride is a multiple of 16; \");\n                    self.ty_str(t);\n                    write(self.emsg, \" has {}\", ty.stride).unwrap();\n                    self.help(b\"use vec4 elements, or a storage buffer\");\n                }\n            }\n            self.check_uniform_layout(ty.base, pos);\n        } else if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                let mt = self.m.members[i as usize].ty;\n                let mk = self.m.types[mt as usize].kind;\n                if mk == TK_STRUCT && i > ty.mstart {\n                    let prev = self.m.members[(i - 1) as usize];\n                    let prev_end = prev.offset + self.m.types[prev.ty as usize].size;\n                    if self.m.members[i as usize].offset - prev_end < 0\n                        || self.m.members[i as usize].offset % 16 != 0 {\n                        if self.err(pos, b\"wgsl.layout\") {\n                            write(self.emsg, \"in a uniform buffer the struct member '{}' must start at a multiple of 16\", str::from_utf8(self.m.members[i as usize].name).unwrap()).unwrap();\n                        }\n                    }\n                }\n                self.check_uniform_layout(mt, pos);\n            }\n        }\n    }\n\n    // A constant's value, evaluated once when it is a scalar; composites\n    // are re-made at each use, in the using function.\n    #[effects(panic, diverge, A)]\n    pub(crate) fn const_value(&mut self, d: i64) -> Val {\n");
    buf_str(out, c"        let dd = self.decls[d as usize];\n        if dd.has_cv {\n            return dd.cv;\n        }\n        if dd.state == DS_BUSY {\n            self.p = dd.tok;\n            if self.err(self.pos(), b\"wgsl.cycle\") {\n                write(self.emsg, \"'{}' refers to itself\",\n                    str::from_utf8(self.name_of(dd.sym)).unwrap()).unwrap();\n            }\n            return cint(ir::SK_AINT, -1, 0);\n        }\n        self.decls[d as usize].state = DS_BUSY;\n        let saved = self.p;\n        let saved_floor = self.save_scope_floor();\n        self.p = dd.tok + 2;\n        let mut ty: i64 = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        self.expect(T_EQ);\n        let ip = self.pos();\n        let mut v = self.parse_expr_hint(ty);\n        if ty >= 0 {\n            v = self.convert_to(v, ty, ip);\n        }\n        if v.k == VK_REF {\n            self.fail(ip, b\"wgsl.type\", b\"a 'const' is a constant expression; this reads memory\");\n        } else if v.k == VK_VALUE && !self.is_const_expr(v.e) {\n            self.fail(ip, b\"wgsl.type\", b\"a 'const' is a constant expression\");\n        }\n        self.scope_floor = saved_floor;\n        self.p = saved;\n        self.decls[d as usize].state = DS_DONE;\n        if v.k == VK_CONST {\n            self.decls[d as usize].cv = v;\n            self.decls[d as usize].has_cv = true;\n        }\n        v\n    }\n\n    // Lookups see only module-scope names until the floor is restored.\n    #[effects(A)]\n    pub(crate) fn save_scope_floor(&mut self) -> i64 {\n        let s = self.scope_floor;\n        self.scope_floor = self.scopes.len() as i64;\n        s\n    }\n\n    // Whether e is made of literals, zero values and compositions only.\n    #[effects(panic, A)]\n    pub(crate) fn is_const_expr(&self, e: i64) -> bool {\n        if e < 0 {\n            return true;\n        }\n        let x = self.f.exprs[e as usize];\n");
    buf_str(out, c"        if x.op == ir::E_LITERAL || x.op == ir::E_ZERO {\n            return true;\n        }\n        if x.op == ir::E_COMPOSE {\n            for i in x.a..x.a + x.b {\n                if !self.is_const_expr(self.f.args[i as usize]) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        if x.op == ir::E_SPLAT {\n            return self.is_const_expr(x.a);\n        }\n        false\n    }\n\n    // ---- Functions ----\n\n    fn signature(&mut self, d: i64) {\n        let dd = self.decls[d as usize];\n        let h = dd.h;\n        let saved = self.p;\n        self.p = dd.tok + 2;\n        self.expect(T_LPAREN);\n        let mut params: Vec<Param<'a>, A> = Vec::new_in(self.a);\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let at = self.parse_attrs();\n            let ppos = self.pos();\n            let ps = self.ident();\n            self.expect(T_COLON);\n            let tp = self.pos();\n            let ty = self.parse_type();\n            let tk = self.m.types[ty as usize].kind;\n            if tk == TK_POINTER {\n                let sp = self.m.types[ty as usize].space;\n                if sp != SP_FUNCTION && sp != SP_PRIVATE {\n                    self.fail(tp, b\"wgsl.unsupported\", b\"pointer parameters are 'ptr<function, T>' or 'ptr<private, T>' in this release\");\n                }\n            } else if self.m.is_runtime_sized(ty) || self.m.has_atomic(ty) {\n                self.fail(tp, b\"wgsl.type\",\n                    b\"a parameter cannot hold a runtime-sized array or an atomic\");\n            }\n            for i in 0..params.len() as i64 {\n                if params[i as usize].name == self.name_of(ps) {\n                    if self.err(ppos, b\"wgsl.redefined\") {\n                        write(self.emsg, \"parameter '{}' is declared twice\",\n                            str::from_utf8(self.name_of(ps)).unwrap()).unwrap();\n                    }\n");
    buf_str(out, c"                }\n            }\n            params.push(Param { name: self.name_of(ps), ty: ty, binding: self.binding_of(at) });\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        let mut result: i64 = -1;\n        let mut rb = no_binding();\n        if self.eat(T_ARROW) {\n            let at = self.parse_attrs();\n            let rp = self.pos();\n            result = self.parse_type();\n            rb = self.binding_of(at);\n            if !self.storable(result) || self.m.is_runtime_sized(result)\n                || self.m.has_atomic(result) {\n                self.fail(rp, b\"wgsl.type\", b\"a function cannot return a pointer, texture, sampler, atomic or runtime-sized array\");\n            }\n        }\n        self.m.functions[h as usize].params = params;\n        self.m.functions[h as usize].result = result;\n        self.m.functions[h as usize].result_binding = rb;\n        self.m.functions[h as usize].pos = self.tk.starts[(dd.tok + 1) as usize];\n        // entry point?\n        self.p = dd.attr;\n        let at = self.parse_attrs();\n        if at.stage >= 0 {\n            if at.stage == STAGE_COMPUTE as i64 && at.wg[0] == 0 {\n                self.fail(self.tk.starts[(dd.tok + 1) as usize], b\"wgsl.entry\",\n                    b\"a compute entry point needs '@workgroup_size(X, Y, Z)'\");\n                self.help(b\"for example '@compute @workgroup_size(64)'\");\n            }\n            let wg = if at.stage == STAGE_COMPUTE as i64 { at.wg } else { [0i64, 0, 0] };\n            self.m.entries.push(Entry {\n                stage: at.stage as u8, name: self.name_of(dd.sym), func: h, wg: wg,\n                early_depth: false,\n            });\n            entry::check_interface(self, self.m.entries.len() as i64 - 1);\n        } else if at.wg[0] != 0 {\n            self.fail(at.pos, b\"wgsl.attr\",\n                b\"'@workgroup_size' belongs to a '@compute' entry point\");\n");
    buf_str(out, c"        }\n        self.p = saved;\n    }\n\n    fn lower_fn(&mut self, d: i64) {\n        let dd = self.decls[d as usize];\n        let h = dd.h;\n        self.fh = h;\n        self.f = mem::replace(&mut self.m.functions[h as usize], new_function(b\"\", self.a));\n        self.stage = 255;\n        for i in 0..self.m.entries.len() as i64 {\n            if self.m.entries[i as usize].func == h {\n                self.stage = self.m.entries[i as usize].stage as i64;\n            }\n        }\n        self.gexpr.clear();\n        for _ in 0..self.m.globals.len() as i64 {\n            self.gexpr.push(-1);\n        }\n        self.scopes.clear();\n        self.scope_floor = 0;\n        self.pending.clear();\n        self.emit_start = 0;\n        self.loop_depth = 0;\n        self.switch_depth = 0;\n        self.in_continuing = false;\n        // the parameters\n        self.p = dd.tok + 2;\n        self.expect(T_LPAREN);\n        let mut i: i64 = 0;\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            self.parse_attrs();\n            let ps = self.ident();\n            self.expect(T_COLON);\n            self.parse_type();\n            let ty = self.f.params[i as usize].ty;\n            let e = self.f.expr(E_ARG, ty, i, 0, 0);\n            self.f.names[e as usize] = self.name_of(ps);\n            self.scopes.push(ScopeEntry { sym: ps, v: val(e, ty), mutable: false });\n            i += 1;\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        if self.eat(T_ARROW) {\n            self.parse_attrs();\n            self.parse_type();\n        }\n        let bpos = self.pos();\n        self.expect(T_LBRACE);\n        let base = self.pending.len() as i64;\n        self.statements();\n        let end = self.pos();\n        self.expect(T_RBRACE);\n        self.flush();\n        if self.f.result >= 0 && !self.block_returns(base) {\n            if self.err(end, b\"wgsl.return\") {\n");
    buf_str(out, c"                write(self.emsg, \"function '{}' can reach its end without returning a value\",\n                    str::from_utf8(self.f.name).unwrap()).unwrap();\n                self.help(b\"end it with a 'return'\");\n            }\n        }\n        let _ = bpos;\n        self.f.body = self.f.block_of(&mut self.pending, base);\n        self.m.functions[h as usize] = mem::replace(&mut self.f, new_function(b\"\", self.a));\n    }\n\n    // Whether the statements pending[from ..] always return (or discard).\n    fn block_returns(&self, from: i64) -> bool {\n        for i in from..self.pending.len() as i64 {\n            if self.stmt_returns(self.pending[i as usize]) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn list_returns(&self, blk: i64) -> bool {\n        let b = self.f.blocks[blk as usize];\n        for i in b.start..b.start + b.count {\n            if self.stmt_returns(self.f.items[i as usize]) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn stmt_returns(&self, s: i64) -> bool {\n        let st = self.f.stmts[s as usize];\n        if st.op == S_RETURN || st.op == S_KILL {\n            return true;\n        }\n        if st.op == S_BLOCK {\n            return self.list_returns(st.a);\n        }\n        if st.op == S_IF {\n            return self.list_returns(st.b) && self.list_returns(st.c);\n        }\n        if st.op == S_SWITCH {\n            for i in st.b..st.b + st.c {\n                if !self.list_returns(self.f.cases[i as usize].body) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        if st.op == S_LOOP {\n            // a loop without a break of its own never ends but by returning\n            return !self.has_break(st.a, 0) && !self.has_break(st.b, 0) && st.c < 0;\n        }\n        false\n    }\n\n    fn has_break(&self, blk: i64, depth: i64) -> bool {\n");
    buf_str(out, c"        let b = self.f.blocks[blk as usize];\n        for i in b.start..b.start + b.count {\n            let st = self.f.stmts[self.f.items[i as usize] as usize];\n            if st.op == S_BREAK && depth == 0 {\n                return true;\n            }\n            if st.op == S_BLOCK && self.has_break(st.a, depth) {\n                return true;\n            }\n            if st.op == S_IF && (self.has_break(st.b, depth) || self.has_break(st.c, depth)) {\n                return true;\n            }\n            if st.op == S_SWITCH {\n                for k in st.b..st.b + st.c {\n                    if self.has_break(self.f.cases[k as usize].body, depth + 1) {\n                        return true;\n                    }\n                }\n            }\n            if st.op == S_LOOP\n                && (self.has_break(st.a, depth + 1) || self.has_break(st.b, depth + 1)) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // No recursion: WGSL's call graph is acyclic.\n    fn check_calls(&mut self) {\n        let n = self.m.functions.len() as i64;\n        let mut state: Vec<u8, A> = Vec::from_elem_in(0u8, (n as usize), self.a);\n        for i in 0..n {\n            if !self.visit_calls(i, &mut state) {\n                return;\n            }\n        }\n        for e in 0..self.m.entries.len() as i64 {\n            let fh = self.m.entries[e as usize].func;\n            for i in 0..n {\n                for s in 0..self.m.functions[i as usize].stmts.len() as i64 {\n                    let st = self.m.functions[i as usize].stmts[s as usize];\n                    if st.op == S_CALL && st.a == fh {\n                        let pos = self.m.functions[i as usize].pos;\n                        if self.err(pos, b\"wgsl.call\") {\n                            self.emsg.push(b'\\'');\n                            self.emsg.extend_from_slice(self.m.functions[i as usize].name);\n");
    buf_str(out, c"                            self.emsg.extend_from_slice(b\"' calls the entry point '\");\n                            self.emsg.extend_from_slice(self.m.entries[e as usize].name);\n                            self.emsg.push(b'\\'');\n                        }\n                        return;\n                    }\n                }\n            }\n        }\n    }\n\n    fn visit_calls(&mut self, i: i64, state: &mut Vec<u8, A>) -> bool {\n        if state[i as usize] == 2 {\n            return true;\n        }\n        if state[i as usize] == 1 {\n            let pos = self.m.functions[i as usize].pos;\n            if self.err(pos, b\"wgsl.recursion\") {\n                self.emsg.push(b'\\'');\n                self.emsg.extend_from_slice(self.m.functions[i as usize].name);\n                self.emsg.extend_from_slice(b\"' calls itself, directly or through other functions\");\n                self.help(b\"WGSL has no recursion: write it as a loop\");\n            }\n            return false;\n        }\n        state[i as usize] = 1;\n        for s in 0..self.m.functions[i as usize].stmts.len() as i64 {\n            let st = self.m.functions[i as usize].stmts[s as usize];\n            if st.op == S_CALL {\n                if !self.visit_calls(st.a, state) {\n                    return false;\n                }\n            }\n        }\n        state[i as usize] = 2;\n        true\n    }\n\n    // ---- Statements ----\n\n    fn lookup(&self, sym: i64) -> i64 {\n        let mut i = self.scopes.len() as i64 - 1;\n        while i >= self.scope_floor {\n            if self.scopes[i as usize].sym == sym {\n                return i;\n            }\n            i -= 1;\n        }\n        -1\n    }\n\n    fn statements(&mut self) {\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            if self.in_continuing_end() {\n                return;\n            }\n            self.statement();\n        }\n    }\n\n");
    buf_str(out, c"    // In a loop body, `continuing` ends the body.\n    fn in_continuing_end(&self) -> bool { self.is_kw(K_CONTINUING) && self.loop_depth > 0 }\n\n    // A `{ ... }` block with a scope of its own: its block handle.\n    fn compound(&mut self) -> i64 {\n        self.flush();\n        let base = self.pending.len() as i64;\n        let scope = self.scopes.len() as i64;\n        self.expect(T_LBRACE);\n        self.statements_plain();\n        self.expect(T_RBRACE);\n        self.flush();\n        self.scopes.truncate(scope as usize);\n        self.f.block_of(&mut self.pending, base)\n    }\n\n    fn statements_plain(&mut self) {\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            self.statement();\n        }\n    }\n\n    fn statement(&mut self) {\n        let at = self.pos();\n        let k = self.kind();\n        if k == T_SEMI {\n            self.p += 1;\n            return;\n        }\n        if k == T_LBRACE {\n            let b = self.compound();\n            self.push_stmt(S_BLOCK, b, 0, 0, 0);\n            return;\n        }\n        if k == T_AT {\n            self.fail(at, b\"wgsl.unsupported\",\n                b\"attributes on statements are not in the WGSL subset of this release\");\n            return;\n        }\n        if k == T_IDENT {\n            let s = self.tk.syms[self.p as usize];\n            if s == K_LET || s == K_CONST {\n                self.p += 1;\n                self.let_decl(s == K_CONST);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_VAR {\n                self.p += 1;\n                self.var_decl();\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_IF {\n                self.p += 1;\n                self.if_stmt();\n                return;\n            }\n            if s == K_RETURN {\n                self.p += 1;\n                self.return_stmt(at);\n                self.expect(T_SEMI);\n");
    buf_str(out, c"                return;\n            }\n            if s == K_LOOP {\n                self.p += 1;\n                self.loop_stmt();\n                return;\n            }\n            if s == K_FOR {\n                self.p += 1;\n                self.for_stmt();\n                return;\n            }\n            if s == K_WHILE {\n                self.p += 1;\n                self.while_stmt();\n                return;\n            }\n            if s == K_SWITCH {\n                self.p += 1;\n                self.switch_stmt(at);\n                return;\n            }\n            if s == K_BREAK {\n                self.p += 1;\n                if self.is_kw(K_IF) {\n                    self.fail(at, b\"wgsl.syntax\",\n                        b\"'break if' is the last statement of a 'continuing' block\");\n                    return;\n                }\n                if self.loop_depth == 0 && self.switch_depth == 0 {\n                    self.fail(at, b\"wgsl.syntax\", b\"'break' outside a loop or switch\");\n                } else if self.in_continuing && self.switch_depth == 0 {\n                    self.fail(at, b\"wgsl.syntax\",\n                        b\"'break' in 'continuing'; end it with 'break if COND;'\");\n                }\n                self.push_stmt(S_BREAK, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_CONTINUE {\n                self.p += 1;\n                if self.loop_depth == 0 {\n                    self.fail(at, b\"wgsl.syntax\", b\"'continue' outside a loop\");\n                } else if self.in_continuing {\n                    self.fail(at, b\"wgsl.syntax\", b\"'continue' in a 'continuing' block\");\n                }\n                self.push_stmt(S_CONTINUE, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_DISCARD {\n                self.p += 1;\n");
    buf_str(out, c"                if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n                    self.fail(at, b\"wgsl.stage\", b\"'discard' is only for fragment shaders\");\n                }\n                self.push_stmt(S_KILL, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_CONST_ASSERT {\n                self.fail(at, b\"wgsl.unsupported\",\n                    b\"'const_assert' is not in the WGSL subset of this release\");\n                return;\n            }\n            if s == K_CONTINUING {\n                self.fail(at, b\"wgsl.syntax\", b\"'continuing' belongs at the end of a 'loop'\");\n                return;\n            }\n            if s == K_ELSE {\n                self.fail(at, b\"wgsl.syntax\", b\"'else' without 'if'\");\n                return;\n            }\n            if s == K_CASE || s == K_DEFAULT {\n                self.fail(at, b\"wgsl.syntax\", b\"'case' outside a 'switch'\");\n                return;\n            }\n        }\n        self.simple_stmt();\n        self.expect(T_SEMI);\n    }\n\n    // An assignment, increment, call or phony assignment (no `;`).\n    fn simple_stmt(&mut self) {\n        let at = self.pos();\n        if self.kind() == T_UNDERSCORE {\n            self.p += 1;\n            self.expect(T_EQ);\n            let v = self.parse_expr();\n            if v.k == VK_VOID {\n                self.fail(at, b\"wgsl.type\", b\"a function without a result has no value to assign\");\n            }\n            let _ = self.value(v, at);\n            return;\n        }\n        let start_exprs = self.f.exprs.len() as i64;\n        let start_stmts = self.pending.len() as i64;\n        let lhs = self.parse_unary_for_stmt();\n        let k = self.kind();\n        if k == T_EQ {\n            self.p += 1;\n            let rp = self.pos();\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr as usize].ty);\n");
    buf_str(out, c"            let rhs = self.parse_expr_hint(pointee);\n            let e = self.materialize(rhs, pointee, rp);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        if k >= lex::T_PLUSEQ && k <= lex::T_SHREQ {\n            self.p += 1;\n            let op = compound_op(k);\n            let rp = self.pos();\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr as usize].ty);\n            let cur = self.value(Val {\n                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr as usize].ty, iv: 0, fv: 0.0,\n            }, at);\n            let rhs = self.parse_expr();\n            let r = self.binary(op, cur, rhs, rp);\n            let e = self.materialize(r, pointee, rp);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        if k == T_PLUSPLUS || k == T_MINUSMINUS {\n            self.p += 1;\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr as usize].ty);\n            if pointee != T_I32 && pointee != T_U32 {\n                self.fail(at, b\"wgsl.type\", b\"'++' and '--' apply to i32 and u32 variables\");\n                return;\n            }\n            let cur = self.value(Val {\n                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr as usize].ty, iv: 0, fv: 0.0,\n            }, at);\n            let one = cint(ir::SK_AINT, -1, 1);\n            let r = self.binary(if k == T_PLUSPLUS { ir::OP_ADD } else { ir::OP_SUB }, cur, one,\n                at);\n            let e = self.materialize(r, pointee, at);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        // a call statement: its result, if any, is dropped\n        let _ = start_exprs;\n        let _ = start_stmts;\n        if !self.last_was_call {\n            if self.err(at, b\"wgsl.syntax\") {\n                self.emsg.extend_from_slice(\n");
    buf_str(out, c"                    b\"expected a statement: an assignment, a call, 'let', 'var', 'if', 'for', ...\");\n            }\n        }\n    }\n\n    // The pointer an assignment writes through.\n    fn lhs_ptr(&mut self, lhs: Val, at: i64) -> i64 {\n        if lhs.k != VK_REF {\n            if self.err(at, b\"wgsl.assign\") {\n                self.emsg.extend_from_slice(\n                    b\"cannot assign to this: it is a value, not a variable\");\n                self.help(\n                    b\"assign to a 'var' (a 'let' is immutable), a member or element of one, or '*p'\");\n            }\n            return self.dummy_ptr();\n        }\n        let pt = self.m.types[lhs.ty as usize];\n        if pt.access & ACC_WRITE == 0 {\n            if self.err(at, b\"wgsl.access\") {\n                write(self.emsg, \"cannot write to a read-only {} variable\",\n                    str::from_utf8(ir::space_name(pt.space)).unwrap()).unwrap();\n                if pt.space == SP_STORAGE {\n                    self.help(b\"declare it 'var<storage, read_write>'\");\n                }\n            }\n        }\n        if self.m.has_atomic(pt.base) {\n            self.fail(at, b\"wgsl.type\", b\"an atomic is written with atomicStore\");\n        }\n        lhs.e\n    }\n\n    #[effects(A)]\n    pub(crate) fn dummy_ptr(&mut self) -> i64 {\n        let ty = self.m.ptr_ty(T_I32, SP_FUNCTION, ACC_RW);\n        self.f.expr(ir::E_ZERO, ty, 0, 0, 0)\n    }\n\n    fn let_decl(&mut self, is_const: bool) {\n        let npos = self.pos();\n        let s = self.ident();\n        let mut ty: i64 = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        self.expect(T_EQ);\n        let ip = self.pos();\n        if is_const {\n            let mut v = self.parse_expr_hint(ty);\n            if ty >= 0 {\n                v = self.convert_to(v, ty, ip);\n            }\n            if v.k == VK_REF || (v.k == VK_VALUE && !self.is_const_expr(v.e)) {\n");
    buf_str(out, c"                self.fail(ip, b\"wgsl.type\", b\"a 'const' is a constant expression\");\n            }\n            self.scopes.push(ScopeEntry { sym: s, v: v, mutable: false });\n            return;\n        }\n        let v = self.parse_expr_hint(ty);\n        if v.k == VK_VOID {\n            self.fail(ip, b\"wgsl.type\", b\"this call has no result to bind\");\n            return;\n        }\n        let t = if ty >= 0 { ty } else { self.concrete_type_of(v) };\n        if self.m.has_atomic(t) || self.m.is_runtime_sized(t) {\n            self.fail(ip, b\"wgsl.type\", b\"a 'let' cannot hold an atomic or a runtime-sized array\");\n        }\n        let e = self.materialize(v, t, ip);\n        let _ = npos;\n        let eop = self.f.exprs[e as usize].op;\n        if self.f.names[e as usize].len() as i64 == 0 && eop != E_ARG && eop != E_LOCAL\n            && eop != E_GLOBAL {\n            self.f.names[e as usize] = self.name_of(s);\n        }\n        self.scopes.push(ScopeEntry { sym: s, v: val(e, t), mutable: false });\n    }\n\n    fn var_decl(&mut self) {\n        if self.kind() == T_LT {\n            let ap = self.pos();\n            self.p += 1;\n            let sp = self.address_space();\n            self.expect_gt();\n            if sp != SP_FUNCTION {\n                self.fail(ap, b\"wgsl.type\",\n                    b\"a variable in a function is 'var' or 'var<function>'\");\n            }\n        }\n        let npos = self.pos();\n        let s = self.ident();\n        let mut ty: i64 = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        let mut init: i64 = -1;\n        if self.eat(T_EQ) {\n            let ip = self.pos();\n            let v = self.parse_expr_hint(ty);\n            if v.k == VK_VOID {\n                self.fail(ip, b\"wgsl.type\", b\"this call has no result\");\n                return;\n            }\n            if ty < 0 {\n                ty = self.concrete_type_of(v);\n            }\n");
    buf_str(out, c"            init = self.materialize(v, ty, ip);\n        }\n        if ty < 0 {\n            self.fail(npos, b\"wgsl.type\", b\"a 'var' needs a type or an initializer\");\n            return;\n        }\n        if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n            if self.err(npos, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"a function variable cannot have type \");\n                self.ty_str(ty);\n            }\n            return;\n        }\n        let l = self.f.locals.len() as i64;\n        self.f.locals.push(Local { name: self.name_of(s), ty: ty });\n        let pty = self.m.ptr_ty(ty, SP_FUNCTION, ACC_RW);\n        let e = self.f.expr(E_LOCAL, pty, l, 0, 0);\n        if init >= 0 {\n            self.push_stmt(S_STORE, e, init, 0, 0);\n        } else {\n            // a variable is zero each time its declaration runs\n            let z = self.f.expr(ir::E_ZERO, ty, 0, 0, 0);\n            self.push_stmt(S_STORE, e, z, 0, 0);\n        }\n        self.scopes.push(ScopeEntry {\n            sym: s, v: Val { k: VK_REF, sk: 0, e: e, ty: pty, iv: 0, fv: 0.0 }, mutable: true,\n        });\n    }\n\n    fn condition(&mut self) -> i64 {\n        let at = self.pos();\n        let v = self.parse_expr();\n        if self.concrete_type_of(v) != T_BOOL {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"a condition is a bool, not \");\n                self.val_str(v);\n            }\n            return self.f.expr(ir::E_LITERAL, T_BOOL, 0, 0, 0);\n        }\n        self.materialize(v, T_BOOL, at)\n    }\n\n    fn if_stmt(&mut self) {\n        let c = self.condition();\n        self.flush();\n        let then_b = self.compound();\n        let mut else_b: i64 = -1;\n        if self.eat_kw(K_ELSE) {\n            if self.eat_kw(K_IF) {\n                let base = self.pending.len() as i64;\n                self.if_stmt();\n                self.flush();\n");
    buf_str(out, c"                else_b = self.f.block_of(&mut self.pending, base);\n            } else {\n                else_b = self.compound();\n            }\n        } else {\n            else_b = self.f.empty_block();\n        }\n        self.push_stmt(S_IF, c, then_b, else_b, 0);\n    }\n\n    fn return_stmt(&mut self, at: i64) {\n        let rt = self.f.result;\n        if self.kind() == T_SEMI {\n            if rt >= 0 {\n                if self.err(at, b\"wgsl.return\") {\n                    self.emsg.extend_from_slice(b\"this function returns \");\n                    self.ty_str(rt);\n                    self.emsg.extend_from_slice(b\": 'return' needs a value\");\n                }\n            }\n            self.push_stmt(S_RETURN, -1, 0, 0, 0);\n            return;\n        }\n        let vp = self.pos();\n        let v = self.parse_expr_hint(rt);\n        if rt < 0 {\n            self.fail(vp, b\"wgsl.return\", b\"this function has no result: 'return;'\");\n            return;\n        }\n        let e = self.materialize(v, rt, vp);\n        self.push_stmt(S_RETURN, e, 0, 0, 0);\n    }\n\n    // The body of a loop (from its `{`), then `continuing` and `break if`.\n    fn loop_stmt(&mut self) {\n        self.flush();\n        let base = self.pending.len() as i64;\n        let scope = self.scopes.len() as i64;\n        self.expect(T_LBRACE);\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        self.statements();\n        self.flush();\n        let body = self.f.block_of(&mut self.pending, base);\n        let mut cont: i64 = -1;\n        let mut break_if: i64 = -1;\n        if self.eat_kw(K_CONTINUING) {\n            // the continuing block sees the body's names\n            let cbase = self.pending.len() as i64;\n            let saved_cont = self.in_continuing;\n            self.in_continuing = true;\n            self.expect(T_LBRACE);\n");
    buf_str(out, c"            while self.kind() != T_RBRACE && self.kind() != T_EOF {\n                if self.is_kw(K_BREAK) && self.kind_at(self.p + 1) == T_IDENT\n                    && self.tk.syms[(self.p + 1) as usize] == K_IF {\n                    self.p += 2;\n                    break_if = self.condition();\n                    self.expect(T_SEMI);\n                    if self.kind() != T_RBRACE {\n                        self.fail(self.pos(), b\"wgsl.syntax\",\n                            b\"'break if' is the last statement of 'continuing'\");\n                    }\n                    break;\n                }\n                self.statement();\n            }\n            self.expect(T_RBRACE);\n            self.flush();\n            self.in_continuing = saved_cont;\n            cont = self.f.block_of(&mut self.pending, cbase);\n        } else {\n            cont = self.f.empty_block();\n        }\n        self.expect(T_RBRACE);\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        self.scopes.truncate(scope as usize);\n        self.push_stmt(S_LOOP, body, cont, break_if, 0);\n    }\n\n    // `if !cond { break; }` at the head of a loop body.\n    fn break_unless(&mut self, c: i64) {\n        self.flush();\n        let then_b = self.f.empty_block();\n        let base = self.pending.len() as i64;\n        let s = self.f.stmt(S_BREAK, 0, 0, 0, 0);\n        self.pending.push(s);\n        let else_b = self.f.block_of(&mut self.pending, base);\n        self.push_stmt(S_IF, c, then_b, else_b, 0);\n    }\n\n    fn for_stmt(&mut self) {\n        self.expect(T_LPAREN);\n        self.flush();\n        let outer = self.pending.len() as i64;\n        let scope = self.scopes.len() as i64;\n        // init\n        if self.kind() != T_SEMI {\n            if self.is_kw(K_VAR) {\n                self.p += 1;\n                self.var_decl();\n            } else if self.is_kw(K_LET) || self.is_kw(K_CONST) {\n                let c = self.is_kw(K_CONST);\n");
    buf_str(out, c"                self.p += 1;\n                self.let_decl(c);\n            } else {\n                self.simple_stmt();\n            }\n        }\n        self.expect(T_SEMI);\n        self.flush();\n        // the loop: its body starts with the condition\n        let base = self.pending.len() as i64;\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        if self.kind() != T_SEMI {\n            let c = self.condition();\n            self.break_unless(c);\n        }\n        self.expect(T_SEMI);\n        // the update is parsed after the body, so remember where it is\n        let upd = self.p;\n        let mut depth: i64 = 0;\n        while self.kind() != T_EOF {\n            let k = self.kind();\n            if k == T_LPAREN {\n                depth += 1;\n            } else if k == T_RPAREN {\n                if depth == 0 {\n                    break;\n                }\n                depth -= 1;\n            }\n            self.p += 1;\n        }\n        self.expect(T_RPAREN);\n        let b = self.compound();\n        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n        self.flush();\n        let body = self.f.block_of(&mut self.pending, base);\n        let after = self.p;\n        self.p = upd;\n        let cbase = self.pending.len() as i64;\n        let saved_cont = self.in_continuing;\n        self.in_continuing = true;\n        if self.kind() != T_RPAREN {\n            self.simple_stmt();\n        }\n        self.in_continuing = saved_cont;\n        self.flush();\n        let cont = self.f.block_of(&mut self.pending, cbase);\n        self.p = after;\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        self.push_stmt(S_LOOP, body, cont, -1, 0);\n        self.flush();\n        self.scopes.truncate(scope as usize);\n        let blk = self.f.block_of(&mut self.pending, outer);\n        self.push_stmt(S_BLOCK, blk, 0, 0, 0);\n    }\n\n    fn while_stmt(&mut self) {\n");
    buf_str(out, c"        self.flush();\n        let base = self.pending.len() as i64;\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        let c = self.condition();\n        self.break_unless(c);\n        let b = self.compound();\n        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n        self.flush();\n        let body = self.f.block_of(&mut self.pending, base);\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        let cont = self.f.empty_block();\n        self.push_stmt(S_LOOP, body, cont, -1, 0);\n    }\n\n    fn switch_stmt(&mut self, at: i64) {\n        let sp = self.pos();\n        let sel = self.parse_expr();\n        let st = self.concrete_type_of(sel);\n        if st != T_I32 && st != T_U32 {\n            if self.err(sp, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"a switch selector is an i32 or a u32, not \");\n                self.val_str(sel);\n            }\n            return;\n        }\n        let se = self.materialize(sel, st, sp);\n        self.flush();\n        self.expect(T_LBRACE);\n        let mut clauses: Vec<ir::Case, A> = Vec::new_in(self.a);\n        let mut seen: Vec<i64, A> = Vec::new_in(self.a);\n        let mut defaults: i64 = 0;\n        self.switch_depth += 1;\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            let cp = self.pos();\n            let mut is_default = false;\n            let vstart = self.f.vals.len() as i64;\n            if self.eat_kw(K_DEFAULT) {\n                is_default = true;\n            } else if self.eat_kw(K_CASE) {\n                while self.kind() != T_LBRACE && self.kind() != T_COLON && self.kind() != T_EOF {\n                    if self.eat_kw(K_DEFAULT) {\n                        is_default = true;\n                    } else {\n                        let vp = self.pos();\n                        let v = self.parse_expr();\n                        let c = self.convert_to(v, st, vp);\n");
    buf_str(out, c"                        if c.k != VK_CONST {\n                            self.fail(vp, b\"wgsl.type\", b\"a case selector is a constant\");\n                        }\n                        for i in 0..seen.len() as i64 {\n                            if seen[i as usize] == c.iv {\n                                if self.err(vp, b\"wgsl.switch\") {\n                                    write(self.emsg, \"case {} appears twice\", c.iv).unwrap();\n                                }\n                            }\n                        }\n                        seen.push(c.iv);\n                        self.f.vals.push(c.iv);\n                    }\n                    if !self.eat(T_COMMA) {\n                        break;\n                    }\n                }\n            } else {\n                if self.err(cp, b\"wgsl.syntax\") {\n                    self.emsg.extend_from_slice(b\"expected 'case' or 'default' in a switch\");\n                }\n                return;\n            }\n            if is_default {\n                defaults += 1;\n                if defaults > 1 {\n                    self.fail(cp, b\"wgsl.switch\", b\"a switch has one 'default'\");\n                }\n            }\n            self.eat(T_COLON);\n            let body = self.compound();\n            clauses.push(ir::Case {\n                vstart: vstart, vcount: self.f.vals.len() as i64 - vstart, is_default: is_default,\n                body: body,\n            });\n        }\n        self.switch_depth -= 1;\n        self.expect(T_RBRACE);\n        if defaults == 0 {\n            self.fail(at, b\"wgsl.switch\", b\"a switch needs a 'default' clause\");\n            self.help(b\"add 'default: {}'\");\n        }\n        let cstart = self.f.cases.len() as i64;\n        for i in 0..clauses.len() as i64 {\n            self.f.cases.push(clauses[i as usize]);\n        }\n        self.push_stmt(S_SWITCH, se, cstart, clauses.len() as i64, 0);\n    }\n\n");
    buf_str(out, c"    // A call as a statement: S_CALL is pushed by the call's lowering.\n    #[effects(panic, A)]\n    pub(crate) fn call_stmt(&mut self, fh: i64, args_start: i64, n: i64) -> Val {\n        let rt = if fh == self.fh { self.f.result } else { self.m.functions[fh as usize].result };\n        if rt < 0 {\n            self.push_stmt(S_CALL, fh, args_start, n, -1);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let r = self.unemitted(E_CALL_RESULT, rt);\n        self.push_stmt(S_CALL, fh, args_start, n, r);\n        val(r, rt)\n    }\n}\n\nfn compound_op(k: u8) -> i64 {\n    if k == lex::T_PLUSEQ {\n        ir::OP_ADD\n    } else if k == lex::T_MINUSEQ {\n        ir::OP_SUB\n    } else if k == lex::T_STAREQ {\n        ir::OP_MUL\n    } else if k == lex::T_SLASHEQ {\n        ir::OP_DIV\n    } else if k == lex::T_PERCENTEQ {\n        ir::OP_MOD\n    } else if k == lex::T_AMPEQ {\n        ir::OP_AND\n    } else if k == lex::T_PIPEEQ {\n        ir::OP_OR\n    } else if k == lex::T_CARETEQ {\n        ir::OP_XOR\n    } else if k == lex::T_SHLEQ {\n        ir::OP_SHL\n    } else {\n        ir::OP_SHR\n    }\n}\n// ---- end mod std::gpu::wgsl::front ----\n}\n// ---- mod std::gpu::wgsl::expr ----\nmod expr {\n// ---- Shader compiler implementation, expr (0.22) ----\n// Expressions: WGSL's grammar, the Load Rule, abstract numbers and their\n// conversions, constant folding, operators and their types, indexing and\n// member access. Calls and constructors are in builtins.vl.\n\nuse crate::alloc::Allocator;\n\nuse super::{front, ir, lex};\nuse super::front::{Front, VK_CONST, VK_REF, VK_TYPE, VK_VALUE, VK_VOID, Val, cfloat, cint, val};\nuse super::ir::{\n    E_ACCESS, E_ACCESS_INDEX, E_BINARY, E_LITERAL, E_LOAD, E_SPLAT, E_SWIZZLE, E_UNARY, E_ZERO,\n    OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LOR, OP_LT, OP_MOD, OP_MUL,\n");
    buf_str(out, c"    OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32, SK_I32,\n    SK_U32, SP_FUNCTION, S_IF, S_STORE, TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SCALAR, TK_STRUCT,\n    TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, UN_BITNOT, UN_NEG, UN_NOT, f32_bits, mat_ty, vec_ty,\n};\nuse super::lex::{\n    T_AMP, T_ANDAND, T_BANG, T_CARET, T_DOT, T_EQEQ, T_FLOAT, T_GE, T_GT, T_IDENT, T_INT,\n    T_LBRACKET, T_LE, T_LPAREN, T_LT, T_MINUS, T_NE, T_OROR, T_PERCENT, T_PIPE, T_PLUS, T_RBRACKET,\n    T_RPAREN, T_SHL, T_SHR, T_SLASH, T_STAR, T_TILDE,\n};\nuse super::names::{K_FALSE, K_TRUE};\n\nconst I32_MIN: i64 = -2147483648;\nconst I32_MAX: i64 = 2147483647;\nconst U32_MAX: i64 = 4294967295;\nconst F32_MAX: f64 = 340282346638528859811704183484516925440.0;\n\nimpl<'a, A: Allocator + Copy> Front<'a, A> {\n    #[effects(A)]\n    pub(crate) fn parse_expr(&mut self) -> Val { self.parse_expr_hint(-1) }\n\n    // An expression; `hint` (a type or -1) is the type the context\n    // expects, which an inferred constructor of abstract numbers takes.\n    #[effects(diverge, A)]\n    pub(crate) fn parse_expr_hint(&mut self, hint: i64) -> Val {\n        let saved = self.hint;\n        self.hint = hint;\n        let at = self.pos();\n        let l = self.parse_relational();\n        let k = self.kind();\n        if k != T_ANDAND && k != T_OROR {\n            self.hint = saved;\n            return l;\n        }\n        let mut acc = l;\n        while self.kind() == k {\n            let op_at = self.pos();\n            self.p += 1;\n            acc = self.short_circuit(k == T_ANDAND, acc, op_at);\n        }\n        let k2 = self.kind();\n        if k2 == T_ANDAND || k2 == T_OROR {\n            self.fail(self.pos(), b\"wgsl.syntax\", b\"mixing '&&' and '||' needs parentheses\");\n        }\n        let _ = at;\n        self.hint = saved;\n        acc\n    }\n\n    // `l && r` or `l || r`: r is evaluated only when needed. Without\n");
    buf_str(out, c"    // effects in r this is a plain operator; else it is an `if` writing a\n    // temporary variable.\n    fn short_circuit(&mut self, and: bool, l: Val, at: i64) -> Val {\n        let lc = self.concrete_type_of(l);\n        if lc != T_BOOL {\n            self.bad_operands(if and { b\"&&\" } else { b\"||\" }, l, l, at);\n            return cint(SK_BOOL, T_BOOL, 0);\n        }\n        if l.k == VK_CONST {\n            // a constant left side decides\n            let r = self.parse_relational();\n            if self.concrete_type_of(r) != T_BOOL {\n                self.bad_operands(if and { b\"&&\" } else { b\"||\" }, l, r, at);\n                return l;\n            }\n            if and && l.iv == 0 {\n                return l;\n            }\n            if !and && l.iv != 0 {\n                return l;\n            }\n            return self.value(r, at);\n        }\n        let le = self.materialize(l, T_BOOL, at);\n        self.flush();\n        let before = self.pending.len() as i64;\n        let rp = self.pos();\n        let r = self.parse_relational();\n        if self.concrete_type_of(r) != T_BOOL {\n            self.bad_operands(if and { b\"&&\" } else { b\"||\" }, l, r, at);\n            return l;\n        }\n        let re = self.materialize(r, T_BOOL, rp);\n        if self.pending.len() as i64 == before {\n            let e = self.f.expr(E_BINARY, T_BOOL, if and { OP_LAND } else { OP_LOR }, le, re);\n            return val(e, T_BOOL);\n        }\n        // r made statements (calls): t = l; if (l == and) { r's statements; t = r }\n        self.flush();\n        let lt = self.f.locals.len() as i64;\n        self.f.locals.push(ir::Local { name: b\"\", ty: T_BOOL });\n        let pty = self.m.ptr_ty(T_BOOL, SP_FUNCTION, ir::ACC_RW);\n        let tv = self.f.expr(ir::E_LOCAL, pty, lt, 0, 0);\n        let st = self.f.stmt(S_STORE, tv, re, 0, 0);\n        self.pending.push(st);\n        let inner = self.f.block_of(&mut self.pending, before);\n");
    buf_str(out, c"        let empty = self.f.empty_block();\n        let st0 = self.f.stmt(S_STORE, tv, le, 0, 0);\n        self.pending.push(st0);\n        if and {\n            self.push_stmt(S_IF, le, inner, empty, 0);\n        } else {\n            self.push_stmt(S_IF, le, empty, inner, 0);\n        }\n        let e = self.f.expr(E_LOAD, T_BOOL, tv, 0, 0);\n        val(e, T_BOOL)\n    }\n\n    fn parse_relational(&mut self) -> Val {\n        let l = self.parse_shift();\n        let k = self.kind();\n        let mut op: i64 = -1;\n        if k == T_LT {\n            op = OP_LT;\n        } else if k == T_LE {\n            op = OP_LE;\n        } else if k == T_GT {\n            op = OP_GT;\n        } else if k == T_GE {\n            op = OP_GE;\n        } else if k == T_EQEQ {\n            op = OP_EQ;\n        } else if k == T_NE {\n            op = OP_NE;\n        }\n        if op < 0 {\n            return l;\n        }\n        let at = self.pos();\n        self.p += 1;\n        let r = self.parse_shift();\n        let v = self.binary(op, l, r, at);\n        let k2 = self.kind();\n        if k2 == T_LT || k2 == T_LE || k2 == T_GT || k2 == T_GE || k2 == T_EQEQ || k2 == T_NE {\n            self.fail(self.pos(), b\"wgsl.syntax\", b\"comparisons do not chain: 'a < b && b < c'\");\n        }\n        v\n    }\n\n    // A shift, a bitwise expression, or an additive one.\n    #[effects(diverge, A)]\n    pub(crate) fn parse_shift(&mut self) -> Val {\n        let u = self.parse_unary();\n        let k = self.kind();\n        if k == T_SHL || k == T_SHR {\n            let at = self.pos();\n            self.p += 1;\n            let r = self.parse_unary();\n            return self.binary(if k == T_SHL { OP_SHL } else { OP_SHR }, u, r, at);\n        }\n        if k == T_AMP || k == T_PIPE || k == T_CARET {\n            let op = if k == T_AMP { OP_AND } else if k == T_PIPE { OP_OR } else { OP_XOR };\n            let mut acc = u;\n            while self.kind() == k {\n");
    buf_str(out, c"                let at = self.pos();\n                self.p += 1;\n                let r = self.parse_unary();\n                acc = self.binary(op, acc, r, at);\n            }\n            let k2 = self.kind();\n            if k2 == T_AMP || k2 == T_PIPE || k2 == T_CARET || k2 == T_PLUS || k2 == T_MINUS\n                || k2 == T_STAR || k2 == T_SLASH || k2 == T_PERCENT {\n                self.fail(self.pos(), b\"wgsl.syntax\",\n                    b\"mixing bitwise operators with other operators needs parentheses\");\n            }\n            return acc;\n        }\n        let mut l = self.parse_mult_from(u);\n        while self.kind() == T_PLUS || self.kind() == T_MINUS {\n            let op = if self.kind() == T_PLUS { OP_ADD } else { OP_SUB };\n            let at = self.pos();\n            self.p += 1;\n            let r0 = self.parse_unary();\n            let r = self.parse_mult_from(r0);\n            l = self.binary(op, l, r, at);\n        }\n        let k3 = self.kind();\n        if k3 == T_AMP || k3 == T_PIPE || k3 == T_CARET || k3 == T_SHL || k3 == T_SHR {\n            self.fail(self.pos(), b\"wgsl.syntax\",\n                b\"mixing bitwise or shift operators with arithmetic needs parentheses\");\n        }\n        l\n    }\n\n    fn parse_mult_from(&mut self, u: Val) -> Val {\n        let mut l = u;\n        loop {\n            let k = self.kind();\n            let op = if k == T_STAR {\n                OP_MUL\n            } else if k == T_SLASH {\n                OP_DIV\n            } else if k == T_PERCENT {\n                OP_MOD\n            } else {\n                return l;\n            };\n            let at = self.pos();\n            self.p += 1;\n            let r = self.parse_unary();\n            l = self.binary(op, l, r, at);\n        }\n    }\n\n    // A statement's left side or call: a unary expression; remembers\n    // whether it ended in a user call.\n    #[effects(A)]\n    pub(crate) fn parse_unary_for_stmt(&mut self) -> Val {\n");
    buf_str(out, c"        self.last_call_end = -1;\n        let v = self.parse_unary();\n        if self.last_call_end != self.p {\n            self.last_was_call = false;\n        } else {\n            self.last_was_call = true;\n        }\n        v\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn parse_unary(&mut self) -> Val {\n        let at = self.pos();\n        let k = self.kind();\n        if k == T_MINUS {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_NEG, v, at);\n        }\n        if k == T_BANG {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_NOT, v, at);\n        }\n        if k == T_TILDE {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_BITNOT, v, at);\n        }\n        if k == T_STAR {\n            self.p += 1;\n            let v = self.parse_unary();\n            let pv = self.value(v, at);\n            if pv.k != VK_VALUE || self.m.types[pv.ty as usize].kind != TK_POINTER {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'*' dereferences a pointer, not \");\n                    self.val_str(v);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            return Val { k: VK_REF, sk: 0, e: pv.e, ty: pv.ty, iv: 0, fv: 0.0 };\n        }\n        if k == T_AMP {\n            self.p += 1;\n            let v = self.parse_unary();\n            if v.k != VK_REF {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'&' takes the address of a variable (or a member or element of one), not of \");\n                    self.val_str(v);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.m.types[self.f.exprs[v.e as usize].ty as usize].kind == TK_POINTER\n                && self.f.exprs[v.e as usize].op == ir::E_ACCESS_INDEX\n");
    buf_str(out, c"                && self.is_vector_component(v.e) {\n                self.fail(at, b\"wgsl.type\", b\"cannot take the address of a vector component\");\n            }\n            return val(v.e, v.ty);\n        }\n        let p = self.parse_primary();\n        self.parse_postfix(p)\n    }\n\n    fn is_vector_component(&self, e: i64) -> bool {\n        let base = self.f.exprs[e as usize].a;\n        let bt = self.m.pointee(self.f.exprs[base as usize].ty);\n        bt >= 0 && self.m.types[bt as usize].kind == TK_VECTOR\n    }\n\n    fn parse_postfix(&mut self, v0: Val) -> Val {\n        let mut v = v0;\n        loop {\n            let k = self.kind();\n            if k == T_LBRACKET {\n                let at = self.pos();\n                self.p += 1;\n                let ip = self.pos();\n                let i = self.parse_expr();\n                self.expect(T_RBRACKET);\n                v = self.index(v, i, at, ip);\n            } else if k == T_DOT {\n                self.p += 1;\n                let at = self.pos();\n                if self.kind() != T_IDENT {\n                    self.expect(T_IDENT);\n                    return v;\n                }\n                let name = self.text(self.p);\n                self.p += 1;\n                v = self.member(v, name, at);\n            } else {\n                return v;\n            }\n        }\n    }\n\n    // ---- Primaries ----\n\n    fn parse_primary(&mut self) -> Val {\n        let at = self.pos();\n        let k = self.kind();\n        let hint = self.hint;\n        self.hint = -1;\n        if k == T_INT {\n            return self.int_literal(self.p);\n        }\n        if k == T_FLOAT {\n            return self.float_literal(self.p);\n        }\n        if k == T_LPAREN {\n            self.p += 1;\n            let v = self.parse_expr_hint(hint);\n            self.expect(T_RPAREN);\n            return v;\n        }\n        if k != T_IDENT {\n            if self.err(at, b\"wgsl.syntax\") {\n");
    buf_str(out, c"                self.emsg.extend_from_slice(b\"expected an expression, got \");\n                self.emsg.extend_from_slice(lex::token_text(k));\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let s = self.tk.syms[self.p as usize];\n        if s == K_TRUE || s == K_FALSE {\n            self.p += 1;\n            return cint(SK_BOOL, T_BOOL, if s == K_TRUE { 1 } else { 0 });\n        }\n        // local names\n        let li = self.lookup_name(s);\n        if li >= 0 {\n            self.p += 1;\n            let ent = self.scopes[li as usize];\n            if self.kind() == T_LPAREN {\n                if self.err(at, b\"wgsl.call\") {\n                    write(self.emsg, \"'{}' is a value, not a function\",\n                        str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                }\n            }\n            return ent.v;\n        }\n        // module-scope names\n        if self.decl_of[s as usize] >= 0 {\n            let d = self.decl_of[s as usize];\n            let kind = self.decls[d as usize].kind;\n            if kind == front::D_CONST {\n                self.p += 1;\n                if self.decls[d as usize].has_cv {\n                    return self.decls[d as usize].cv;\n                }\n                let saved = self.p;\n                let v = self.const_value(d);\n                self.p = saved;\n                return v;\n            }\n            if kind == front::D_VAR {\n                self.p += 1;\n                let g = self.decls[d as usize].h;\n                if g < 0 {\n                    // a global used by another module-scope declaration\n                    if self.err(at, b\"wgsl.name\") {\n                        write(self.emsg,\n                            \"'{}' is a variable; a module-scope declaration cannot use it\",\n                            str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                    }\n                    return cint(SK_AINT, -1, 0);\n");
    buf_str(out, c"                }\n                if self.fh < 0 {\n                    if self.err(at, b\"wgsl.type\") {\n                        write(self.emsg, \"'{}' is a variable; a constant expression cannot read it\",\n                            str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                let e = self.global_expr(g);\n                let ty = self.f.exprs[e as usize].ty;\n                if self.m.globals[g as usize].space == ir::SP_HANDLE {\n                    return val(e, ty);\n                }\n                return Val { k: VK_REF, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 };\n            }\n            if kind == front::D_FN {\n                self.p += 1;\n                if self.kind() != T_LPAREN {\n                    if self.err(at, b\"wgsl.type\") {\n                        write(self.emsg, \"'{}' is a function: call it, '{}(...)'\",\n                            str::from_utf8(self.name_of(s)).unwrap(),\n                            str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                return self.user_call(self.decls[d as usize].h, at);\n            }\n            // a struct or alias: a constructor\n            let ty = self.parse_type();\n            return self.construct(ty, at);\n        }\n        self.builtin_primary(s, at, hint)\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn lookup_name(&self, s: i64) -> i64 {\n        let mut i = self.scopes.len() as i64 - 1;\n        while i >= self.scope_floor {\n            if self.scopes[i as usize].sym == s {\n                return i;\n            }\n            i -= 1;\n        }\n        -1\n    }\n\n    // ---- Literals ----\n\n    fn int_literal(&mut self, t: i64) -> Val {\n        let s = self.text(t);\n        let at = self.pos();\n        self.p += 1;\n");
    buf_str(out, c"        let mut end = s.len() as i64;\n        let last = s[(end - 1) as usize];\n        let mut sk = SK_AINT;\n        if last == b'i' {\n            sk = SK_I32;\n            end -= 1;\n        } else if last == b'u' {\n            sk = SK_U32;\n            end -= 1;\n        }\n        let mut v: i64 = 0;\n        let mut overflow = false;\n        if end > 2 && s[0] == b'0' && (s[1] == b'x' || s[1] == b'X') {\n            for i in 2..end {\n                let c = s[i as usize];\n                let d = if c >= b'0' && c <= b'9' { c - b'0' }\n                    else if c >= b'a' && c <= b'f' { c - b'a' + 10 } else { c - b'A' + 10 };\n                if v > 576460752303423487 {\n                    overflow = true;\n                }\n                v = v * 16 + d as i64;\n            }\n        } else {\n            if end > 1 && s[0] == b'0' {\n                self.fail(at, b\"wgsl.syntax\", b\"a decimal integer does not start with 0\");\n                return cint(SK_AINT, -1, 0);\n            }\n            for i in 0..end {\n                let d = (s[i as usize] - b'0') as i64;\n                if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {\n                    overflow = true;\n                }\n                v = v * 10 + d;\n            }\n        }\n        if overflow {\n            self.fail(at, b\"wgsl.const\", b\"this integer does not fit in 64 bits\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if sk == SK_I32 && v > I32_MAX {\n            self.fail(at, b\"wgsl.const\", b\"this i32 literal is above 2147483647\");\n            self.help(b\"negate a smaller literal, or use an abstract integer: -2147483648\");\n            return cint(SK_I32, T_I32, 0);\n        }\n        if sk == SK_U32 && v > U32_MAX {\n            self.fail(at, b\"wgsl.const\", b\"this u32 literal is above 4294967295\");\n            return cint(SK_U32, T_U32, 0);\n        }\n");
    buf_str(out, c"        let ty: i64 = if sk == SK_I32 { T_I32 } else if sk == SK_U32 { T_U32 } else { -1 };\n        cint(sk, ty, v)\n    }\n\n    fn float_literal(&mut self, t: i64) -> Val {\n        let s = self.text(t);\n        let at = self.pos();\n        self.p += 1;\n        let mut end = s.len() as i64;\n        let mut sk = SK_AFLOAT;\n        let last = s[(end - 1) as usize];\n        let hex = s.len() as i64 > 2 && s[0] == b'0' && (s[1] == b'x' || s[1] == b'X');\n        if last == b'h' {\n            self.fail(at, b\"wgsl.unsupported\",\n                b\"'f16' literals are not in the WGSL subset of this release\");\n            return cfloat(SK_F32, T_F32, 0.0);\n        }\n        if last == b'f' && !hex {\n            sk = SK_F32;\n            end -= 1;\n        } else if last == b'f' && hex && s.len() as i64 > 2 {\n            // hex floats end in f only after an exponent\n            let mut has_p = false;\n            for i in 0..s.len() as i64 {\n                if s[i as usize] == b'p' || s[i as usize] == b'P' {\n                    has_p = true;\n                }\n            }\n            if has_p {\n                sk = SK_F32;\n                end -= 1;\n            }\n        }\n        let v = if hex { hex_float(&s[0..end as usize]) }\n            else {\n                str::from_utf8(&s[0..end as usize])\n                    .ok()\n                    .and_then(|t| t.parse::<f64>().ok())\n                    .unwrap_or(0.0)\n            };\n        if sk == SK_F32 {\n            let f = v as f32;\n            if f as f64 > F32_MAX || -(f as f64) > F32_MAX {\n                self.fail(at, b\"wgsl.const\", b\"this f32 literal is out of range\");\n            }\n            return cfloat(SK_F32, T_F32, f as f64);\n        }\n        cfloat(SK_AFLOAT, -1, v)\n    }\n\n    // ---- The Load Rule and conversions ----\n\n    // A value: a reference is read (E_LOAD).\n    #[effects(A)]\n    pub(crate) fn value(&mut self, v: Val, at: i64) -> Val {\n");
    buf_str(out, c"        if v.k == VK_REF {\n            let t = self.m.pointee(v.ty);\n            if self.m.has_atomic(t) {\n                self.fail(at, b\"wgsl.type\", b\"an atomic is read with atomicLoad\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.m.is_runtime_sized(t) {\n                self.fail(at, b\"wgsl.type\",\n                    b\"a runtime-sized array cannot be read whole; index it\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let e = self.f.expr(E_LOAD, t, v.e, 0, 0);\n            return val(e, t);\n        }\n        if v.k == VK_VOID {\n            self.fail(at, b\"wgsl.type\", b\"this call has no result to use\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if v.k == VK_TYPE {\n            self.fail(at, b\"wgsl.type\", b\"a type is not a value\");\n            return cint(SK_AINT, -1, 0);\n        }\n        v\n    }\n\n    // The type v has once concrete (abstract ints become i32, floats f32).\n    #[effects(A)]\n    pub(crate) fn concrete_type_of(&self, v: Val) -> i64 {\n        if v.k == VK_CONST {\n            if v.ty >= 0 {\n                return v.ty;\n            }\n            return if v.sk == SK_AFLOAT { T_F32 } else { T_I32 };\n        }\n        if v.k == VK_REF {\n            return self.m.pointee(v.ty);\n        }\n        if v.k == VK_VOID || v.e < 0 && v.ty < 0 {\n            return T_I32;\n        }\n        v.ty\n    }\n\n    // v as type ty: abstract constants convert, references load; any\n    // other difference is an error.\n    #[effects(panic, A)]\n    pub(crate) fn convert_to(&mut self, v0: Val, ty: i64, at: i64) -> Val {\n        let v = self.value(v0, at);\n        if self.failed {\n            return if v.k == VK_CONST { v } else { self.dummy(ty) };\n        }\n        if v.k == VK_CONST {\n            if v.ty == ty {\n                return v;\n            }\n            let t = self.m.types[ty as usize];\n");
    buf_str(out, c"            if v.ty < 0 && t.kind == TK_SCALAR {\n                return self.const_cast(v, t.scalar, at, false);\n            }\n            self.mismatch(ty, v, at);\n            return v;\n        }\n        if v.ty != ty {\n            self.mismatch(ty, v, at);\n        }\n        v\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn mismatch(&mut self, want: i64, got: Val, at: i64) {\n        if self.err(at, b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"expected \");\n            self.ty_str(want);\n            self.emsg.extend_from_slice(b\", got \");\n            self.val_str(got);\n            let gt = self.concrete_type_of(got);\n            if gt >= 0 && self.m.types[gt as usize].kind == TK_SCALAR\n                && self.m.types[want as usize].kind == TK_SCALAR {\n                self.tmp.clear();\n                self.m.type_name(want, &mut self.tmp);\n                write(self.ehelp, \"convert it: {}(...)\",\n                    str::from_utf8(self.tmp.as_slice()).unwrap()).unwrap();\n            }\n        }\n    }\n\n    // A dummy value of type ty, after an error.\n    #[effects(A)]\n    pub(crate) fn dummy(&mut self, ty: i64) -> Val {\n        let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n        val(e, ty)\n    }\n\n    // v as an IR expression of type ty.\n    #[effects(A)]\n    pub(crate) fn materialize(&mut self, v0: Val, ty: i64, at: i64) -> i64 {\n        let v = self.convert_to(v0, ty, at);\n        if self.failed {\n            return self.f.expr(E_ZERO, ty, 0, 0, 0);\n        }\n        if v.k == VK_CONST {\n            return self.literal(v, ty);\n        }\n        v.e\n    }\n\n    // v (a value of any concrete type) as an IR expression, its type\n    // concrete.\n    pub(crate) fn emit_val(&mut self, v: Val, at: i64) -> i64 {\n        let t = self.concrete_type_of(v);\n        self.materialize(v, t, at)\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn literal(&mut self, v: Val, ty: i64) -> i64 {\n");
    buf_str(out, c"        let sk = self.m.types[ty as usize].scalar;\n        let bits = if sk == SK_F32 { f32_bits(v.fv as f32) as i64 } else { v.iv & 4294967295 };\n        self.f.expr(E_LITERAL, ty, bits, 0, 0)\n    }\n\n    // A constant as scalar kind `to`: an automatic conversion of an\n    // abstract number (`explicit` false), or a value constructor's.\n    #[effects(panic, diverge, A)]\n    pub(crate) fn const_cast(&mut self, v: Val, to: u8, at: i64, explicit: bool) -> Val {\n        let ty = to as i64;\n        let from = v.sk;\n        if from == to {\n            return Val { k: VK_CONST, sk: to, e: -1, ty: ty, iv: v.iv, fv: v.fv };\n        }\n        let is_float = from == SK_F32 || from == SK_AFLOAT;\n        if !explicit {\n            let ok = (from == SK_AINT && (to == SK_I32 || to == SK_U32 || to == SK_F32))\n                || (from == SK_AFLOAT && to == SK_F32);\n            if !ok {\n                if self.err(at, b\"wgsl.type\") {\n                    write(self.emsg, \"expected {}, got {}\",\n                        str::from_utf8(ir::scalar_name(to)).unwrap(),\n                        str::from_utf8(ir::scalar_name(from)).unwrap()).unwrap();\n                    if from == SK_AFLOAT && (to == SK_I32 || to == SK_U32) {\n                        write(self.ehelp, \"convert it: {}(...)\",\n                            str::from_utf8(ir::scalar_name(to)).unwrap()).unwrap();\n                    }\n                }\n                return cint(to, ty, 0);\n            }\n        }\n        if to == SK_BOOL {\n            let nz = if is_float { v.fv != 0.0 } else { v.iv != 0 };\n            return cint(SK_BOOL, T_BOOL, if nz { 1 } else { 0 });\n        }\n        if to == SK_F32 || to == SK_AFLOAT {\n            let x = if is_float { v.fv } else { v.iv as f64 };\n            if to == SK_F32 {\n                if x > F32_MAX || x < -F32_MAX {\n                    self.fail(at, b\"wgsl.const\", b\"this value is out of f32's range\");\n                }\n");
    buf_str(out, c"                return cfloat(SK_F32, T_F32, (x as f32) as f64);\n            }\n            return cfloat(SK_AFLOAT, -1, x);\n        }\n        // to an integer\n        let mut x = v.iv;\n        if is_float {\n            if explicit {\n                // value conversion: truncate, then saturate\n                let f = v.fv;\n                if to == SK_I32 {\n                    x = if f != f { 0 } else if f <= -2147483648.0 { I32_MIN }\n                        else if f >= 2147483520.0 { 2147483520 } else { f as i64 };\n                } else {\n                    x = if f != f { 0 } else if f <= 0.0 { 0 }\n                        else if f >= 4294967040.0 { 4294967040 } else { f as i64 };\n                }\n                return cint(to, ty, x);\n            }\n        }\n        if from == SK_BOOL {\n            return cint(to, ty, x);\n        }\n        if explicit && from != SK_AINT {\n            // between i32 and u32: the bits\n            if to == SK_U32 {\n                x = x & U32_MAX;\n            } else {\n                x = (x & U32_MAX) as i32 as i64;\n            }\n            return cint(to, ty, x);\n        }\n        if to == SK_I32 && (x < I32_MIN || x > I32_MAX) {\n            if self.err(at, b\"wgsl.const\") {\n                write(self.emsg, \"{x} does not fit in an i32\").unwrap();\n            }\n        } else if to == SK_U32 && (x < 0 || x > U32_MAX) {\n            if self.err(at, b\"wgsl.const\") {\n                write(self.emsg, \"{x} does not fit in a u32\").unwrap();\n                if x < 0 {\n                    self.help(b\"a u32 is never negative; use an i32, or bitcast<u32>(...)\");\n                }\n            }\n        }\n        cint(to, ty, x)\n    }\n\n    // ---- Operators ----\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn bad_operands(&mut self, op: &[u8], l: Val, r: Val, at: i64) {\n        if self.err(at, b\"wgsl.type\") {\n            {\n");
    buf_str(out, c"                let op = str::from_utf8(op).unwrap();\n                write(self.emsg, \"'{op}' cannot take \").unwrap();\n            }\n            self.val_str(l);\n            self.emsg.extend_from_slice(b\" and \");\n            self.val_str(r);\n        }\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn unary(&mut self, op: i64, v0: Val, at: i64) -> Val {\n        let v = self.value(v0, at);\n        if self.failed {\n            return v;\n        }\n        let t = self.concrete_type_of(v);\n        let tt = self.m.types[t as usize];\n        let sk = if v.k == VK_CONST { v.sk } else { tt.scalar };\n        let numeric = tt.kind == TK_SCALAR || tt.kind == TK_VECTOR;\n        if op == UN_NEG {\n            if !(numeric || tt.kind == TK_MATRIX) || sk == SK_BOOL || sk == SK_U32 {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'-' cannot take \");\n                    self.val_str(v);\n                    if sk == SK_U32 {\n                        self.help(b\"a u32 is never negative: 0u - x wraps, or use an i32\");\n                    }\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                if sk == SK_AFLOAT || sk == SK_F32 {\n                    return cfloat(sk, v.ty, -v.fv);\n                }\n                if sk == SK_I32 && v.iv == I32_MIN {\n                    self.fail(at, b\"wgsl.const\", b\"-(-2147483648i) does not fit in an i32\");\n                }\n                return cint(sk, v.ty, -v.iv);\n            }\n            if tt.kind == TK_MATRIX {\n                self.fail(at, b\"wgsl.unsupported\",\n                    b\"negating a matrix is not in this release; multiply by -1.0\");\n                return v;\n            }\n        } else if op == UN_NOT {\n            if !numeric || sk != SK_BOOL {\n                if self.err(at, b\"wgsl.type\") {\n");
    buf_str(out, c"                    self.emsg.extend_from_slice(b\"'!' takes a bool, not \");\n                    self.val_str(v);\n                    if sk == SK_I32 || sk == SK_U32 {\n                        self.help(b\"'~' is the bitwise not of an integer\");\n                    }\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                return cint(SK_BOOL, T_BOOL, if v.iv == 0 { 1 } else { 0 });\n            }\n        } else {\n            if !numeric || !(sk == SK_I32 || sk == SK_U32 || sk == SK_AINT) {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'~' takes an integer, not \");\n                    self.val_str(v);\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                let x = !v.iv;\n                return cint(sk, v.ty, if sk == SK_U32 { x & U32_MAX } else { x });\n            }\n        }\n        let e = self.f.expr(E_UNARY, t, op, v.e, 0);\n        val(e, t)\n    }\n\n    #[effects()]\n    pub(crate) fn op_text(&self, op: i64) -> &'static [u8] {\n        if op == OP_ADD {\n            b\"+\"\n        } else if op == OP_SUB {\n            b\"-\"\n        } else if op == OP_MUL {\n            b\"*\"\n        } else if op == OP_DIV {\n            b\"/\"\n        } else if op == OP_MOD {\n            b\"%\"\n        } else if op == OP_EQ {\n            b\"==\"\n        } else if op == OP_NE {\n            b\"!=\"\n        } else if op == OP_LT {\n            b\"<\"\n        } else if op == OP_LE {\n            b\"<=\"\n        } else if op == OP_GT {\n            b\">\"\n        } else if op == OP_GE {\n            b\">=\"\n        } else if op == OP_AND {\n            b\"&\"\n        } else if op == OP_OR {\n            b\"|\"\n        } else if op == OP_XOR {\n            b\"^\"\n        } else if op == OP_SHL {\n            b\"<<\"\n        } else {\n            b\">>\"\n        }\n    }\n\n");
    buf_str(out, c"    // Whether e is a constant (a literal, or a vector of literals) with a\n    // lane of n or more (unsigned).\n    fn const_lanes_at_least(&self, e: i64, n: i64) -> bool {\n        let x = self.f.exprs[e as usize];\n        if x.op == E_LITERAL {\n            return x.a >= n;\n        }\n        if x.op == E_SPLAT {\n            return self.const_lanes_at_least(x.a, n);\n        }\n        if x.op == ir::E_COMPOSE {\n            for i in x.a..x.a + x.b {\n                if self.const_lanes_at_least(self.f.args[i as usize], n) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn binary(&mut self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n        let mut l = self.value(l0, at);\n        let mut r = self.value(r0, at);\n        if self.failed {\n            return l;\n        }\n        if l.k == VK_CONST && r.k == VK_CONST {\n            return self.fold(op, l, r, at);\n        }\n        let shift = op == OP_SHL || op == OP_SHR;\n        // the abstract side takes the other side's scalar\n        if shift {\n            let rt0: i64 = if r.k == VK_CONST { -1 } else { r.ty };\n            if r.k == VK_CONST {\n                if r.ty < 0 || r.sk == SK_U32 {\n                    r = self.const_cast(r, SK_U32, at, false);\n                }\n            }\n            if l.k == VK_CONST && l.ty < 0 {\n                let rk = self.m.types[self.concrete_type_of(r) as usize];\n                let _ = rk;\n                l = self.const_cast(l, SK_I32, at, false);\n            }\n            let _ = rt0;\n        } else if l.k == VK_CONST && l.ty < 0 {\n            let rs = self.m.types[r.ty as usize].scalar;\n            l = self.const_cast(l, rs, at, false);\n        } else if r.k == VK_CONST && r.ty < 0 {\n            let ls = self.m.types[l.ty as usize].scalar;\n            r = self.const_cast(r, ls, at, false);\n        }\n        if self.failed {\n");
    buf_str(out, c"            return l;\n        }\n        let lt = self.concrete_type_of(l);\n        let rt = self.concrete_type_of(r);\n        let a = self.m.types[lt as usize];\n        let b = self.m.types[rt as usize];\n        let ln: i64 = if a.kind == TK_SCALAR { 1 } else if a.kind == TK_VECTOR { a.n } else { 0 };\n        let rn: i64 = if b.kind == TK_SCALAR { 1 } else if b.kind == TK_VECTOR { b.n } else { 0 };\n        // matrices\n        if a.kind == TK_MATRIX || b.kind == TK_MATRIX {\n            return self.matrix_op(op, l, r, lt, rt, at);\n        }\n        if ln == 0 || rn == 0 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let sk = a.scalar;\n        if shift {\n            if (sk != SK_I32 && sk != SK_U32) || b.scalar != SK_U32 || (ln != rn && rn != 1)\n                || (rn != 1 && ln == 1) {\n                if self.err(at, b\"wgsl.type\") {\n                    write(self.emsg, \"'{}' shifts an integer by a u32 (of the same width); got \",\n                        str::from_utf8(self.op_text(op)).unwrap()).unwrap();\n                    self.val_str(l);\n                    self.emsg.extend_from_slice(b\" and \");\n                    self.val_str(r);\n                    if b.scalar == SK_I32 {\n                        self.help(b\"convert the amount: u32(...)\");\n                    }\n                }\n                return l;\n            }\n            let le = self.materialize(l, lt, at);\n            let mut re = self.materialize(r, rt, at);\n            if ln != rn {\n                re = self.f.expr(E_SPLAT, vec_ty(SK_U32, ln), re, 0, 0);\n            }\n            if (r.k == VK_CONST && r.iv >= 32) || self.const_lanes_at_least(re, 32) {\n                self.fail(at, b\"wgsl.const\", b\"a constant shift amount is below 32\");\n            }\n            let e = self.f.expr(E_BINARY, lt, op, le, re);\n            return val(e, lt);\n        }\n        if sk != b.scalar {\n");
    buf_str(out, c"            self.bad_operands(self.op_text(op), l, r, at);\n            if (sk == SK_I32 && b.scalar == SK_U32) || (sk == SK_U32 && b.scalar == SK_I32) {\n                self.help(b\"convert one side: u32(...) or i32(...)\");\n            } else if sk == SK_F32 || b.scalar == SK_F32 {\n                self.help(b\"convert one side: f32(...)\");\n            }\n            return l;\n        }\n        let arith = op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD;\n        let cmp = op >= OP_EQ && op <= OP_GE;\n        let bits = op == OP_AND || op == OP_OR || op == OP_XOR;\n        if ln != rn && !(arith && (ln == 1 || rn == 1)) {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if arith && sk == SK_BOOL {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if bits && sk == SK_F32 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if cmp && sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let n = if ln > rn { ln } else { rn };\n        let vt = vec_ty(sk, n);\n        let mut le = self.materialize(l, lt, at);\n        let mut re = self.materialize(r, rt, at);\n        if ln < n {\n            le = self.f.expr(E_SPLAT, vt, le, 0, 0);\n        }\n        if rn < n {\n            re = self.f.expr(E_SPLAT, vt, re, 0, 0);\n        }\n        let ty = if cmp { vec_ty(SK_BOOL, n) } else { vt };\n        let e = self.f.expr(E_BINARY, ty, op, le, re);\n        val(e, ty)\n    }\n\n    fn matrix_op(&mut self, op: i64, l: Val, r: Val, lt: i64, rt: i64, at: i64) -> Val {\n        let a = self.m.types[lt as usize];\n        let b = self.m.types[rt as usize];\n        let mut ty: i64 = -1;\n        if op == OP_ADD || op == OP_SUB {\n            if lt == rt {\n                ty = lt;\n            }\n");
    buf_str(out, c"        } else if op == OP_MUL {\n            if a.kind == TK_MATRIX && b.kind == TK_SCALAR && b.scalar == SK_F32 {\n                ty = lt;\n            } else if a.kind == TK_SCALAR && a.scalar == SK_F32 && b.kind == TK_MATRIX {\n                ty = rt;\n            }\n            else if a.kind == TK_MATRIX && b.kind == TK_VECTOR && b.scalar == SK_F32 && b.n == a.n {\n                ty = vec_ty(SK_F32, a.m);\n            }\n            else if a.kind == TK_VECTOR && a.scalar == SK_F32 && b.kind == TK_MATRIX && a.n == b.m {\n                ty = vec_ty(SK_F32, b.n);\n            } else if a.kind == TK_MATRIX && b.kind == TK_MATRIX && a.n == b.m {\n                ty = mat_ty(b.n, a.m);\n            }\n        }\n        if ty < 0 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let le = self.materialize(l, lt, at);\n        let re = self.materialize(r, rt, at);\n        let e = self.f.expr(E_BINARY, ty, op, le, re);\n        val(e, ty)\n    }\n\n    // Both sides constant scalars: the result, computed as WGSL's\n    // constant evaluation does (errors where it overflows or divides by\n    // zero).\n    fn fold(&mut self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n        let mut l = l0;\n        let mut r = r0;\n        let shift = op == OP_SHL || op == OP_SHR;\n        // the common kind\n        if shift {\n            if r.sk == SK_AINT {\n                r = self.const_cast(r, SK_U32, at, false);\n            }\n            if r.sk != SK_U32 {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n        } else if l.sk != r.sk {\n            if l.ty < 0 && r.ty < 0 {\n                // abstract int and abstract float: float\n                if l.sk == SK_AINT {\n                    l = cfloat(SK_AFLOAT, -1, l.iv as f64);\n                } else {\n                    r = cfloat(SK_AFLOAT, -1, r.iv as f64);\n                }\n");
    buf_str(out, c"            } else if l.ty < 0 {\n                l = self.const_cast(l, r.sk, at, false);\n            } else if r.ty < 0 {\n                r = self.const_cast(r, l.sk, at, false);\n            } else {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n        }\n        if self.failed {\n            return l;\n        }\n        let sk = l.sk;\n        let ty = l.ty;\n        if op == OP_LAND || op == OP_LOR {\n            let x = if op == OP_LAND { l.iv != 0 && r.iv != 0 } else { l.iv != 0 || r.iv != 0 };\n            return cint(SK_BOOL, T_BOOL, if x { 1 } else { 0 });\n        }\n        if op >= OP_EQ && op <= OP_GE {\n            let mut c: i64 = 0;\n            if sk == SK_F32 || sk == SK_AFLOAT {\n                let x = l.fv;\n                let y = r.fv;\n                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n            } else {\n                if sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n                    self.bad_operands(self.op_text(op), l, r, at);\n                    return l;\n                }\n                let x = l.iv;\n                let y = r.iv;\n                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n            }\n            return cint(SK_BOOL, T_BOOL, c);\n        }\n        if sk == SK_BOOL {\n            if op == OP_AND || op == OP_OR || op == OP_XOR {\n                let x = if op == OP_AND { l.iv & r.iv } else if op == OP_OR { l.iv | r.iv }\n                    else { l.iv ^ r.iv };\n");
    buf_str(out, c"                return cint(SK_BOOL, T_BOOL, x);\n            }\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if sk == SK_F32 || sk == SK_AFLOAT {\n            if op == OP_AND || op == OP_OR || op == OP_XOR || shift {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n            let x = l.fv;\n            let y = r.fv;\n            let mut z = 0.0;\n            if sk == SK_F32 {\n                let a = x as f32;\n                let b = y as f32;\n                let zz = if op == OP_ADD { a + b } else if op == OP_SUB { a - b }\n                    else if op == OP_MUL { a * b } else if op == OP_DIV { a / b }\n                    else { a - b * trunc32(a / b) };\n                z = zz as f64;\n            } else {\n                z = if op == OP_ADD { x + y } else if op == OP_SUB { x - y }\n                    else if op == OP_MUL { x * y } else if op == OP_DIV { x / y }\n                    else { x - y * trunc64(x / y) };\n            }\n            if z != z || z > 1.7976931348623157e308 || z < -1.7976931348623157e308\n                || (sk == SK_F32 && (z > F32_MAX || z < -F32_MAX)) {\n                self.fail(at, b\"wgsl.const\",\n                    b\"this constant expression overflows or is not a number\");\n            }\n            return cfloat(sk, ty, z);\n        }\n        // integers: i32, u32, abstract (i64)\n        let x = l.iv;\n        let y = r.iv;\n        let mut z: i64 = 0;\n        if op == OP_ADD {\n            z = x + y;\n            if sk == SK_AINT && ((x > 0 && y > 0 && z < 0) || (x < 0 && y < 0 && z >= 0)) {\n                self.fail(at, b\"wgsl.const\", b\"this constant overflows 64 bits\");\n            }\n        } else if op == OP_SUB {\n            z = x - y;\n            if sk == SK_AINT && ((x >= 0 && y < 0 && z < 0) || (x < 0 && y > 0 && z >= 0)) {\n");
    buf_str(out, c"                self.fail(at, b\"wgsl.const\", b\"this constant overflows 64 bits\");\n            }\n        } else if op == OP_MUL {\n            z = x * y;\n            if sk == SK_AINT && x != 0\n                && (z / x != y || (x == -1 && y == -9223372036854775807 - 1)) {\n                self.fail(at, b\"wgsl.const\", b\"this constant overflows 64 bits\");\n            }\n        } else if op == OP_DIV || op == OP_MOD {\n            if y == 0 {\n                self.fail(at, b\"wgsl.const\", b\"a constant expression divides by zero\");\n                return l;\n            }\n            z = if op == OP_DIV { x / y } else { x % y };\n        } else if op == OP_AND {\n            z = x & y;\n        } else if op == OP_OR {\n            z = x | y;\n        } else if op == OP_XOR {\n            z = x ^ y;\n        } else if op == OP_SHL || op == OP_SHR {\n            let width: i64 = if sk == SK_AINT { 64 } else { 32 };\n            if y >= width {\n                self.fail(at, b\"wgsl.const\",\n                    b\"a constant shift amount is below the width of the shifted type\");\n                return l;\n            }\n            if op == OP_SHL {\n                z = x << y;\n            } else if sk == SK_U32 {\n                z = (x & U32_MAX) >> y;\n            } else {\n                z = x >> y;\n            }\n        }\n        if sk == SK_I32 {\n            if op == OP_SHL {\n                z = (z & U32_MAX) as i32 as i64;\n            } else if z < I32_MIN || z > I32_MAX {\n                self.fail(at, b\"wgsl.const\", b\"this constant expression overflows an i32\");\n            }\n        } else if sk == SK_U32 {\n            if op == OP_SHL {\n                z = z & U32_MAX;\n            } else if z < 0 || z > U32_MAX {\n                self.fail(at, b\"wgsl.const\", b\"this constant expression overflows a u32\");\n            }\n        }\n        cint(sk, ty, z)\n    }\n\n    // ---- Indexing and members ----\n\n");
    buf_str(out, c"    fn index(&mut self, base: Val, i0: Val, at: i64, ip: i64) -> Val {\n        if self.failed {\n            return base;\n        }\n        let i = self.value(i0, ip);\n        let it = self.concrete_type_of(i);\n        if it != T_I32 && it != T_U32 {\n            if self.err(ip, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"an index is an i32 or a u32, not \");\n                self.val_str(i);\n            }\n            return base;\n        }\n        let is_ref = base.k == VK_REF;\n        let bv = if is_ref { base } else { self.value(base, at) };\n        if bv.k == VK_CONST {\n            self.fail(at, b\"wgsl.type\", b\"a scalar cannot be indexed\");\n            return base;\n        }\n        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n        let t = self.m.types[bt as usize];\n        if t.kind != TK_ARRAY && t.kind != TK_VECTOR && t.kind != TK_MATRIX {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"cannot index \");\n                self.val_str(bv);\n                if t.kind == TK_POINTER {\n                    self.help(b\"dereference the pointer first: (*p)[i]\");\n                }\n            }\n            return base;\n        }\n        let el = self.m.elem_of(bt);\n        let n = self.m.index_len(bt);\n        let rty = if is_ref {\n            let pt = self.m.types[bv.ty as usize];\n            self.m.ptr_ty(el, pt.space, pt.access)\n        } else {\n            el\n        };\n        if i.k == VK_CONST && n > 0 {\n            if i.iv < 0 || i.iv >= n {\n                if self.err(ip, b\"wgsl.index\") {\n                    write(self.emsg, \"index {} is out of range: the length is {n}\", i.iv).unwrap();\n                }\n                return base;\n            }\n            let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i.iv, 0);\n            return Val {\n");
    buf_str(out, c"                k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0,\n            };\n        }\n        let ie = self.materialize(i, it, ip);\n        let e = self.f.expr(E_ACCESS, rty, bv.e, ie, ir::CK_PENDING);\n        Val { k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0 }\n    }\n\n    fn member(&mut self, base: Val, name: &[u8], at: i64) -> Val {\n        if self.failed {\n            return base;\n        }\n        let is_ref = base.k == VK_REF;\n        let bv = if is_ref { base } else { self.value(base, at) };\n        if bv.k == VK_CONST {\n            if self.err(at, b\"wgsl.type\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"a scalar has no member '{name}'\").unwrap();\n                }\n            }\n            return base;\n        }\n        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n        let t = self.m.types[bt as usize];\n        if t.kind == TK_STRUCT {\n            for i in 0..t.mcount {\n                let mem = self.m.members[(t.mstart + i) as usize];\n                if mem.name == name {\n                    let rty = if is_ref {\n                        let pt = self.m.types[bv.ty as usize];\n                        self.m.ptr_ty(mem.ty, pt.space, pt.access)\n                    } else {\n                        mem.ty\n                    };\n                    let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i, 0);\n                    return Val {\n                        k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0,\n                        fv: 0.0,\n                    };\n                }\n            }\n            if self.err(at, b\"wgsl.member\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"'{}' has no member '{name}'\", str::from_utf8(t.name).unwrap()).unwrap();\n");
    buf_str(out, c"                }\n                self.ehelp.extend_from_slice(b\"its members are \");\n                for i in 0..t.mcount {\n                    if i > 0 {\n                        self.ehelp.extend_from_slice(b\", \");\n                    }\n                    self.ehelp.extend_from_slice(self.m.members[(t.mstart + i) as usize].name);\n                }\n            }\n            return base;\n        }\n        if t.kind == TK_VECTOR {\n            let mut pat: i64 = 0;\n            let n = name.len() as i64;\n            let mut set: i64 = -1;\n            if n > 4 {\n                self.fail(at, b\"wgsl.member\", b\"a swizzle has at most 4 components\");\n                return base;\n            }\n            for i in 0..n {\n                let c = name[i as usize];\n                // (written: a destructuring `let` makes no open local, FL6)\n                let (comp, s): (i64, i64) = if c == b'x' {\n                    (0, 0)\n                } else if c == b'y' {\n                    (1, 0)\n                } else if c == b'z' {\n                    (2, 0)\n                } else if c == b'w' {\n                    (3, 0)\n                } else if c == b'r' {\n                    (0, 1)\n                } else if c == b'g' {\n                    (1, 1)\n                } else if c == b'b' {\n                    (2, 1)\n                } else if c == b'a' {\n                    (3, 1)\n                } else {\n                    (-1, -1)\n                };\n                if comp < 0 || comp >= t.n || (set >= 0 && s != set) {\n                    if self.err(at, b\"wgsl.member\") {\n                        {\n                            let name = str::from_utf8(name).unwrap();\n                            write(self.emsg, \"'.{name}' is not a component of a vec{}\", t.n).unwrap();\n                        }\n                        self.help(b\"components are x y z w (or r g b a), not mixed\");\n                    }\n");
    buf_str(out, c"                    return base;\n                }\n                set = s;\n                pat = pat | (comp << (2 * i));\n            }\n            if n == 1 {\n                let rty = if is_ref {\n                    let pt = self.m.types[bv.ty as usize];\n                    self.m.ptr_ty(t.scalar as i64, pt.space, pt.access)\n                } else {\n                    t.scalar as i64\n                };\n                let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, pat, 0);\n                return Val {\n                    k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0,\n                };\n            }\n            let v = self.value(bv, at);\n            let rty = vec_ty(t.scalar, n);\n            let e = self.f.expr(E_SWIZZLE, rty, v.e, pat, n);\n            return val(e, rty);\n        }\n        if self.err(at, b\"wgsl.member\") {\n            {\n                let name = str::from_utf8(name).unwrap();\n                write(self.emsg, \"'.{name}': \").unwrap();\n            }\n            self.val_str(bv);\n            self.emsg.extend_from_slice(b\" has no members\");\n            if t.kind == TK_POINTER {\n                self.help(b\"dereference the pointer first: (*p).member\");\n            }\n        }\n        base\n    }\n}\n\nfn trunc32(x: f32) -> f32 {\n    if x != x || x > 8388608.0 || x < -8388608.0 {\n        return x;\n    }\n    (x as i64) as f32\n}\n\nfn trunc64(x: f64) -> f64 {\n    if x != x || x > 4503599627370496.0 || x < -4503599627370496.0 {\n        return x;\n    }\n    (x as i64) as f64\n}\n\n// A hexadecimal float literal's value, `0x1.8p3` (WGSL's: mantissa digits,\n// an optional point, `p` and a decimal exponent of two), exact while the\n// mantissa fits in 53 bits.\nfn hex_float(s: &[u8]) -> f64 {\n    let mut man: f64 = 0.0;\n    let mut e: i64 = 0;\n    let mut i: i64 = 2;\n    let mut after_point = false;\n");
    buf_str(out, c"    while i < s.len() as i64 && s[i as usize] != b'p' && s[i as usize] != b'P' {\n        let c = s[i as usize];\n        if c == b'.' {\n            after_point = true;\n        } else {\n            let d = if c >= b'0' && c <= b'9' { c - b'0' }\n                else if c >= b'a' && c <= b'f' { c - b'a' + 10 } else { c - b'A' + 10 };\n            man = man * 16.0 + d as f64;\n            if after_point {\n                e -= 4;\n            }\n        }\n        i += 1;\n    }\n    if i < s.len() as i64 {\n        i += 1;\n        let mut neg = false;\n        if i < s.len() as i64 && (s[i as usize] == b'+' || s[i as usize] == b'-') {\n            neg = s[i as usize] == b'-';\n            i += 1;\n        }\n        let mut x: i64 = 0;\n        while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' && x < 100000 {\n            x = x * 10 + (s[i as usize] - b'0') as i64;\n            i += 1;\n        }\n        e += if neg { -x } else { x };\n    }\n    // times 2^e, by exact steps\n    let mut v = man;\n    while e > 0 && v < 1.0e300 {\n        v = v * 2.0;\n        e -= 1;\n    }\n    while e < 0 && v != 0.0 {\n        v = v * 0.5;\n        e += 1;\n    }\n    v\n}\n// ---- end mod std::gpu::wgsl::expr ----\n}\n// ---- mod std::gpu::wgsl::builtins ----\nmod builtins {\n// ---- Shader compiler implementation, builtins (0.22) ----\n// Calls: user functions, value constructors (`vec3<f32>(...)`, `S(...)`,\n// inferred `vec3(...)` and `array(...)`), and WGSL's builtin functions\n// with their overloads.\n\nuse crate::alloc::Allocator;\n\nuse super::{front, ir};\nuse super::front::{Front, VK_CONST, VK_REF, VK_VALUE, VK_VOID, Val, cint, val};\nuse super::ir::{\n    AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE, AT_SUB,\n    AT_XOR, BARRIER_STORAGE, BARRIER_WORKGROUP, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BITCAST,\n    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n");
    buf_str(out, c"    E_MATH, E_SELECT, E_SPLAT, E_WG_UNIFORM_RESULT, E_ZERO, IMG_SAMPLE, IMG_SAMPLE_BIAS,\n    IMG_SAMPLE_COMPARE, IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, IQ_LAYERS, IQ_LEVELS, IQ_SIZE,\n    MF_ALL, MF_ANY, MF_CROSS, MF_DETERMINANT, MF_DISTANCE, MF_DOT, MF_EXTRACT_BITS, MF_INSERT_BITS,\n    MF_LDEXP, MF_LENGTH, MF_TRANSPOSE, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32, SK_I32, SK_U32,\n    SP_STORAGE, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, S_ATOMIC, S_BARRIER, S_IMAGE_STORE,\n    S_WG_UNIFORM_LOAD, StructMember, TEX_2D_ARRAY, TEX_DEPTH_2D, TEX_STORAGE_2D, TK_ARRAY,\n    TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR,\n    T_BOOL, T_F32, T_I32, T_U32, mat_ty, vec_ty,\n};\nuse super::lex::{T_COMMA, T_EOF, T_LPAREN, T_LT, T_RPAREN};\nuse super::names::{\n    K_ARRAY, K_ARRAY_LENGTH, K_ATOMIC_ADD, K_ATOMIC_AND, K_ATOMIC_COMPARE_EXCHANGE_WEAK,\n    K_ATOMIC_EXCHANGE, K_ATOMIC_LOAD, K_ATOMIC_MAX, K_ATOMIC_MIN, K_ATOMIC_OR, K_ATOMIC_STORE,\n    K_ATOMIC_SUB, K_ATOMIC_XOR, K_BITCAST, K_DPDX, K_FWIDTH_FINE, K_MAT2X2, K_MAT4X4, K_MATH_FIRST,\n    K_MATH_LAST, K_SELECT, K_STORAGE_BARRIER, K_TEXTURE_DIMENSIONS, K_TEXTURE_LOAD,\n    K_TEXTURE_NUM_LAYERS, K_TEXTURE_NUM_LEVELS, K_TEXTURE_SAMPLE, K_TEXTURE_SAMPLE_BIAS,\n    K_TEXTURE_SAMPLE_COMPARE, K_TEXTURE_SAMPLE_LEVEL, K_TEXTURE_STORE, K_VEC2, K_VEC4,\n    K_WORKGROUP_BARRIER, K_WORKGROUP_UNIFORM_LOAD,\n};\n\nimpl<'a, A: Allocator + Copy> Front<'a, A> {\n    // The arguments of a call, from its `(`: pushed on astack (positions\n    // on apos); returns their first index. `hint`: each argument's\n    // expected type, or -1.\n    fn args(&mut self, hint: i64) -> i64 {\n        let base = self.astack.len() as i64;\n        self.expect(T_LPAREN);\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let p = self.pos();\n            let v = self.parse_expr_hint(hint);\n            self.apos.push(p);\n            self.astack.push(v);\n");
    buf_str(out, c"            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        self.last_call_end = self.p;\n        base\n    }\n\n    fn drop_args(&mut self, base: i64) {\n        self.astack.truncate(base as usize);\n        self.apos.truncate(base as usize);\n    }\n\n    fn arg_count_error(&mut self, at: i64, name: &[u8], want: &[u8], got: i64) {\n        if self.err(at, b\"wgsl.call\") {\n            {\n                let name = str::from_utf8(name).unwrap();\n                let want = str::from_utf8(want).unwrap();\n                write(self.emsg, \"'{name}' takes {want}, got {got}\").unwrap();\n            }\n        }\n    }\n\n    // ---- User functions ----\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn user_call(&mut self, fh: i64, at: i64) -> Val {\n        // the function being lowered has its signature in self.f\n        let nparams = if fh == self.fh { self.f.params.len() as i64 }\n            else { self.m.functions[fh as usize].params.len() as i64 };\n        let base = self.estack.len() as i64;\n        self.expect(T_LPAREN);\n        let mut n: i64 = 0;\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let ap = self.pos();\n            let hint: i64 = if n < nparams { self.param_ty(fh, n) } else { -1 };\n            let v = self.parse_expr_hint(hint);\n            if n < nparams {\n                let pt = self.param_ty(fh, n);\n                let mut ok = true;\n                if self.m.types[pt as usize].kind == TK_POINTER && v.k == VK_REF {\n                    ok = false;\n                    if self.err(ap, b\"wgsl.type\") {\n                        self.emsg.extend_from_slice(b\"expected a pointer, got a reference\");\n                        self.help(b\"pass its address: &x\");\n                    }\n                }\n                if ok {\n                    let e = self.materialize(v, pt, ap);\n                    self.estack.push(e);\n");
    buf_str(out, c"                }\n            }\n            n += 1;\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        if n != nparams {\n            if self.err(at, b\"wgsl.call\") {\n                self.emsg.push(b'\\'');\n                if fh == self.fh {\n                    self.emsg.extend_from_slice(self.f.name);\n                } else {\n                    self.emsg.extend_from_slice(self.m.functions[fh as usize].name);\n                }\n                write(self.emsg, \"' takes {nparams} argument\").unwrap();\n                if nparams != 1 {\n                    self.emsg.push(b's');\n                }\n                write(self.emsg, \", got {n}\").unwrap();\n            }\n            self.estack.truncate(base as usize);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let start = self.f.args.len() as i64;\n        for i in base..self.estack.len() as i64 {\n            self.f.args.push(self.estack[i as usize]);\n        }\n        self.estack.truncate(base as usize);\n        let r = self.call_stmt(fh, start, n);\n        self.last_call_end = self.p;\n        r\n    }\n\n    fn param_ty(&self, fh: i64, i: i64) -> i64 {\n        if fh == self.fh {\n            self.f.params[i as usize].ty\n        } else {\n            self.m.functions[fh as usize].params[i as usize].ty\n        }\n    }\n\n    // ---- Constructors ----\n\n    // `T(args)` for a known type T, from the `(`.\n    #[effects(panic, A)]\n    pub(crate) fn construct(&mut self, ty: i64, at: i64) -> Val {\n        if self.kind() != T_LPAREN {\n            if self.err(self.pos(), b\"wgsl.syntax\") {\n                self.emsg.extend_from_slice(b\"a type here is a constructor: '\");\n                self.ty_str(ty);\n                self.emsg.extend_from_slice(b\"(...)'\");\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n");
    buf_str(out, c"        let t = self.m.types[ty as usize];\n        let hint: i64 = if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n            t.scalar as i64\n        } else if t.kind == TK_ARRAY {\n            t.base\n        } else {\n            -1\n        };\n        let base = self.args(hint);\n        let n = self.astack.len() as i64 - base;\n        let r = self.construct_from(ty, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn construct_from(&mut self, ty: i64, base: i64, n: i64, at: i64) -> Val {\n        let t = self.m.types[ty as usize];\n        if n == 0 {\n            if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"cannot construct \");\n                    self.ty_str(ty);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            if t.kind == TK_SCALAR {\n                return if t.scalar == SK_F32 { front::cfloat(SK_F32, ty, 0.0) }\n                    else { cint(t.scalar, ty, 0) };\n            }\n            let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n            return val(e, ty);\n        }\n        if t.kind == TK_SCALAR {\n            if n != 1 {\n                self.arg_count_error(at, b\"a scalar constructor\", b\"one argument\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            return self.convert_value(self.astack[base as usize], ty, self.apos[base as usize]);\n        }\n        if t.kind == TK_VECTOR {\n            return self.construct_vector(t.scalar, t.n, base, n, at);\n        }\n        if t.kind == TK_MATRIX {\n            return self.construct_matrix(t.n, t.m, base, n, at);\n        }\n        if t.kind == TK_ARRAY {\n            if t.n == 0 {\n                self.fail(at, b\"wgsl.type\", b\"a runtime-sized array cannot be constructed\");\n                return cint(SK_AINT, -1, 0);\n            }\n");
    buf_str(out, c"            if n != t.n {\n                if self.err(at, b\"wgsl.call\") {\n                    write(self.emsg, \"this array has {} elements, got {n}\", t.n).unwrap();\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            return self.compose_args(ty, t.base, base, n);\n        }\n        if t.kind == TK_STRUCT {\n            if n != t.mcount {\n                if self.err(at, b\"wgsl.call\") {\n                    write(self.emsg, \"'{}' has {} members, got {n} arguments\",\n                        str::from_utf8(t.name).unwrap(), t.mcount).unwrap();\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            let start = self.estack.len() as i64;\n            for i in 0..n {\n                let mt = self.m.members[(t.mstart + i) as usize].ty;\n                let e = self.materialize(self.astack[(base + i) as usize], mt,\n                    self.apos[(base + i) as usize]);\n                self.estack.push(e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if self.err(at, b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"cannot construct \");\n            self.ty_str(ty);\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    fn compose_args(&mut self, ty: i64, el: i64, base: i64, n: i64) -> Val {\n        let start = self.estack.len() as i64;\n        for i in 0..n {\n            let e = self.materialize(self.astack[(base + i) as usize], el,\n                self.apos[(base + i) as usize]);\n            self.estack.push(e);\n        }\n        self.compose_from_estack(ty, start)\n    }\n\n    fn compose_from_estack(&mut self, ty: i64, start: i64) -> Val {\n        let a = self.f.args.len() as i64;\n        for i in start..self.estack.len() as i64 {\n            self.f.args.push(self.estack[i as usize]);\n        }\n        let n = self.estack.len() as i64 - start;\n        self.estack.truncate(start as usize);\n");
    buf_str(out, c"        let e = self.f.expr(E_COMPOSE, ty, a, n, 0);\n        val(e, ty)\n    }\n\n    // A value conversion `T(v)`: scalar to scalar, or vector to vector of\n    // the same width.\n    fn convert_value(&mut self, v0: Val, ty: i64, at: i64) -> Val {\n        let v = self.value(v0, at);\n        let t = self.m.types[ty as usize];\n        if v.k == VK_CONST {\n            if t.kind == TK_SCALAR {\n                return self.const_cast(v, t.scalar, at, true);\n            }\n            return self.convert_to(v, ty, at);\n        }\n        if self.failed {\n            return v;\n        }\n        let vt = self.m.types[v.ty as usize];\n        if v.ty == ty {\n            return v;\n        }\n        let w = self.m.width_of(v.ty);\n        if w == 0 || w != self.m.width_of(ty) {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"cannot convert \");\n                self.val_str(v);\n                self.emsg.extend_from_slice(b\" to \");\n                self.ty_str(ty);\n            }\n            return v;\n        }\n        let _ = vt;\n        let e = self.f.expr(E_CONVERT, ty, v.e, 0, 0);\n        val(e, ty)\n    }\n\n    // The scalar kind of a value's components (abstract kinds included).\n    fn comp_kind(&self, v: Val) -> u8 {\n        if v.k == VK_CONST {\n            return v.sk;\n        }\n        let t = self.concrete_type_of(v);\n        self.m.types[t as usize].scalar\n    }\n\n    // The concrete scalar the arguments base .. base + n share: a\n    // concrete argument's, else (all abstract) the hint's, else f32 when\n    // one is a float, else `dflt`.\n    fn common_scalar(&self, base: i64, n: i64, hint_sk: i64, dflt: u8) -> u8 {\n        let mut any_float = false;\n        for i in base..base + n {\n            let v = self.astack[i as usize];\n            if v.k == VK_CONST && v.ty < 0 {\n                if v.sk == SK_AFLOAT {\n                    any_float = true;\n                }\n");
    buf_str(out, c"                continue;\n            }\n            return self.comp_kind(v);\n        }\n        if hint_sk >= 0 && hint_sk <= 3 {\n            let h = hint_sk as u8;\n            if !(any_float && h != SK_F32) {\n                return h;\n            }\n        }\n        if any_float { SK_F32 } else { dflt }\n    }\n\n    fn construct_vector(&mut self, sk: u8, n: i64, base: i64, count: i64, at: i64) -> Val {\n        let ty = vec_ty(sk, n);\n        if count == 1 {\n            let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n            let w: i64 = if v.k == VK_CONST { 1 } else { self.m.width_of(v.ty) };\n            if w == 1 {\n                let e = self.materialize(v, sk as i64, self.apos[base as usize]);\n                let s = self.f.expr(E_SPLAT, ty, e, 0, 0);\n                return val(s, ty);\n            }\n            if w == n {\n                return self.convert_value(v, ty, self.apos[base as usize]);\n            }\n        }\n        let start = self.estack.len() as i64;\n        let mut total: i64 = 0;\n        for i in base..base + count {\n            let v = self.value(self.astack[i as usize], self.apos[i as usize]);\n            if v.k == VK_CONST {\n                let e = self.materialize(v, sk as i64, self.apos[i as usize]);\n                self.estack.push(e);\n                total += 1;\n                continue;\n            }\n            let vt = self.m.types[v.ty as usize];\n            if vt.kind == TK_SCALAR {\n                let e = self.materialize(v, sk as i64, self.apos[i as usize]);\n                self.estack.push(e);\n                total += 1;\n            } else if vt.kind == TK_VECTOR {\n                let e = self.materialize(v, vec_ty(sk, vt.n), self.apos[i as usize]);\n                self.estack.push(e);\n                total += vt.n;\n            } else {\n                if self.err(self.apos[i as usize], b\"wgsl.type\") {\n");
    buf_str(out, c"                    self.emsg.extend_from_slice(b\"a vector is made of scalars and vectors, not \");\n                    self.val_str(v);\n                }\n                self.estack.truncate(start as usize);\n                return cint(SK_AINT, -1, 0);\n            }\n        }\n        if total != n {\n            if self.err(at, b\"wgsl.call\") {\n                write(self.emsg, \"a vec{n} needs {n} components, got {total}\").unwrap();\n            }\n            self.estack.truncate(start as usize);\n            return cint(SK_AINT, -1, 0);\n        }\n        self.compose_from_estack(ty, start)\n    }\n\n    fn construct_matrix(&mut self, c: i64, r: i64, base: i64, count: i64, at: i64) -> Val {\n        let ty = mat_ty(c, r);\n        let col = vec_ty(SK_F32, r);\n        if count == 1 {\n            let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n            if v.k == VK_VALUE && v.ty == ty {\n                return v;\n            }\n        }\n        let start = self.estack.len() as i64;\n        if count == c {\n            for i in base..base + count {\n                let e = self.materialize(self.astack[i as usize], col, self.apos[i as usize]);\n                self.estack.push(e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if count == c * r {\n            for k in 0..c {\n                let cs = self.estack.len() as i64;\n                for j in 0..r {\n                    let i = base + k * r + j;\n                    let e = self.materialize(self.astack[i as usize], T_F32, self.apos[i as usize]);\n                    self.estack.push(e);\n                }\n                let colv = self.compose_from_estack(col, cs);\n                self.estack.push(colv.e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if self.err(at, b\"wgsl.call\") {\n            write(self.emsg,\n");
    buf_str(out, c"                \"a mat{c}x{r} is made of {c} columns or {} scalars, got {count} arguments\",\n                c * r).unwrap();\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // ---- Builtins ----\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn builtin_primary(&mut self, s: i64, at: i64, hint: i64) -> Val {\n        // inferred constructors\n        if s >= K_VEC2 && s <= K_VEC4 && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let n = s - K_VEC2 + 2;\n            let hs: i64 = if hint >= 0 { self.m.types[hint as usize].scalar as i64 } else { -1 };\n            let hk = if hint >= 0 { self.m.types[hint as usize].kind } else { 255 };\n            let base = self.args(if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 });\n            let cnt = self.astack.len() as i64 - base;\n            let sk = self.common_scalar(base, cnt,\n                if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 }, SK_I32);\n            let r = if cnt == 0 { self.construct_from(vec_ty(sk, n), base, 0, at) }\n                else { self.construct_vector(sk, n, base, cnt, at) };\n            self.drop_args(base);\n            return r;\n        }\n        if s >= K_MAT2X2 && s <= K_MAT4X4 && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let i = s - K_MAT2X2;\n            let base = self.args(T_F32);\n            let cnt = self.astack.len() as i64 - base;\n            let r = if cnt == 0 {\n                self.construct_from(mat_ty(i / 3 + 2, i % 3 + 2), base, 0, at)\n            } else {\n                self.construct_matrix(i / 3 + 2, i % 3 + 2, base, cnt, at)\n            };\n            self.drop_args(base);\n            return r;\n        }\n        if s == K_ARRAY && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let he: i64 = if hint >= 0\n                && self.m.types[hint as usize].kind == TK_ARRAY { self.m.types[hint as usize].base }\n");
    buf_str(out, c"                else { -1 };\n            let base = self.args(he);\n            let cnt = self.astack.len() as i64 - base;\n            if cnt == 0 {\n                self.fail(at, b\"wgsl.call\",\n                    b\"'array()' needs its elements, or a type: 'array<f32, 4>()'\");\n                self.drop_args(base);\n                return cint(SK_AINT, -1, 0);\n            }\n            // the element type: a concrete element's, else the hint's, else the default\n            let mut el: i64 = -1;\n            for i in base..base + cnt {\n                let v = self.astack[i as usize];\n                if !(v.k == VK_CONST && v.ty < 0) {\n                    el = self.concrete_type_of(v);\n                    break;\n                }\n            }\n            if el < 0 {\n                el = if he >= 0 { he } else { self.concrete_type_of(self.astack[base as usize]) };\n            }\n            let ty = self.m.array_ty(el, cnt);\n            let r = self.compose_args(ty, el, base, cnt);\n            self.drop_args(base);\n            return r;\n        }\n        if self.is_type_name(s) {\n            let ty = self.parse_type();\n            return self.construct(ty, at);\n        }\n        self.p += 1;\n        if self.kind() != T_LPAREN {\n            if s == K_BITCAST && self.kind() == T_LT {\n                self.p += 1;\n                let ty = self.parse_type();\n                self.expect_gt();\n                return self.bitcast(ty, at);\n            }\n            if self.err(at, b\"wgsl.name\") {\n                write(self.emsg, \"unknown name '{}'\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        if s >= K_MATH_FIRST && s <= K_MATH_LAST {\n            return self.math(s - K_MATH_FIRST, s, at);\n        }\n        if s == K_SELECT {\n            return self.select(at);\n        }\n        if s == K_ARRAY_LENGTH {\n            return self.array_length(at);\n");
    buf_str(out, c"        }\n        if s >= K_ATOMIC_LOAD && s <= K_ATOMIC_COMPARE_EXCHANGE_WEAK {\n            return self.atomic(s, at);\n        }\n        if s == K_WORKGROUP_BARRIER || s == K_STORAGE_BARRIER {\n            let base = self.args(-1);\n            let n = self.astack.len() as i64 - base;\n            self.drop_args(base);\n            if n != 0 {\n                self.arg_count_error(at, self.name_of(s), b\"no arguments\", n);\n            }\n            if self.stage != STAGE_COMPUTE as i64 && self.stage != 255 {\n                self.fail(at, b\"wgsl.stage\", b\"barriers are for compute shaders\");\n            }\n            self.push_stmt(S_BARRIER,\n                if s == K_WORKGROUP_BARRIER { BARRIER_WORKGROUP } else { BARRIER_STORAGE }, 0, 0,\n                0);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        if s == K_WORKGROUP_UNIFORM_LOAD {\n            let base = self.args(-1);\n            let n = self.astack.len() as i64 - base;\n            if n != 1 {\n                self.drop_args(base);\n                self.arg_count_error(at, b\"workgroupUniformLoad\", b\"one pointer\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let p = self.value(self.astack[base as usize], self.apos[base as usize]);\n            self.drop_args(base);\n            let pt = if p.k == VK_VALUE { self.m.types[p.ty as usize] }\n                else { self.m.types[T_I32 as usize] };\n            if pt.kind != TK_POINTER || pt.space != SP_WORKGROUP || self.m.has_atomic(pt.base) {\n                self.fail(at, b\"wgsl.type\",\n                    b\"workgroupUniformLoad takes a pointer to workgroup memory (not an atomic): &x\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let r = self.unemitted(E_WG_UNIFORM_RESULT, pt.base);\n            self.push_stmt(S_WG_UNIFORM_LOAD, p.e, r, 0, 0);\n            return val(r, pt.base);\n        }\n");
    buf_str(out, c"        if s >= K_DPDX && s <= K_FWIDTH_FINE {\n            let k = (s - K_DPDX) % 3;\n            let base = self.args(-1);\n            let n = self.astack.len() as i64 - base;\n            if n != 1 {\n                self.drop_args(base);\n                self.arg_count_error(at, self.name_of(s), b\"one argument\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n                self.fail(at, b\"wgsl.stage\", b\"derivatives are for fragment shaders\");\n            }\n            let ty = self.float_type(self.astack[base as usize], self.apos[base as usize]);\n            let e0 = self.materialize(self.astack[base as usize], ty, self.apos[base as usize]);\n            self.drop_args(base);\n            let e = self.f.expr(E_DERIVATIVE, ty, k, e0, 0);\n            return val(e, ty);\n        }\n        if s >= K_TEXTURE_SAMPLE && s <= K_TEXTURE_NUM_LAYERS {\n            return self.texture_call(s, at);\n        }\n        if self.err(at, b\"wgsl.name\") {\n            write(self.emsg, \"unknown function '{}'\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // An f32 scalar or vector type for v (abstract numbers become f32).\n    fn float_type(&mut self, v: Val, at: i64) -> i64 {\n        if v.k == VK_CONST && v.ty < 0 {\n            return T_F32;\n        }\n        let t = self.concrete_type_of(v);\n        let tt = self.m.types[t as usize];\n        if (tt.kind != TK_SCALAR && tt.kind != TK_VECTOR) || tt.scalar != SK_F32 {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"expected f32 or vecN<f32>, got \");\n                self.val_str(v);\n                if tt.scalar == SK_I32 || tt.scalar == SK_U32 {\n                    self.help(b\"convert it: f32(...)\");\n                }\n            }\n            return T_F32;\n        }\n        t\n    }\n\n");
    buf_str(out, c"    fn bitcast(&mut self, ty: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        if n != 1 {\n            self.drop_args(base);\n            self.arg_count_error(at, b\"bitcast\", b\"one argument\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let mut v = self.value(self.astack[base as usize], self.apos[base as usize]);\n        let ap = self.apos[base as usize];\n        self.drop_args(base);\n        if v.k == VK_CONST && v.ty < 0 {\n            v = if v.sk == SK_AINT && v.iv > 2147483647 { self.const_cast(v, SK_U32, ap, false) }\n                else {\n                    self.const_cast(v, if v.sk == SK_AINT { SK_I32 } else { SK_F32 }, ap, false)\n                };\n        }\n        let vt = self.concrete_type_of(v);\n        let w = self.m.width_of(vt);\n        let tw = self.m.width_of(ty);\n        if w == 0 || w != tw || self.m.types[vt as usize].scalar == SK_BOOL\n            || self.m.types[ty as usize].scalar == SK_BOOL {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"bitcast converts between 32-bit numbers and vectors of them of one width; got \");\n                self.val_str(v);\n                self.emsg.extend_from_slice(b\" to \");\n                self.ty_str(ty);\n            }\n            return v;\n        }\n        let e0 = self.materialize(v, vt, ap);\n        if vt == ty {\n            return val(e0, ty);\n        }\n        let e = self.f.expr(E_BITCAST, ty, e0, 0, 0);\n        val(e, ty)\n    }\n\n    fn select(&mut self, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        if n != 3 {\n            self.drop_args(base);\n            self.arg_count_error(at, b\"select\", b\"3 arguments (if false, if true, condition)\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let sk = self.common_scalar(base, 2, -1, SK_I32);\n");
    buf_str(out, c"        let mut ty: i64 = -1;\n        for i in base..base + 2 {\n            let v = self.astack[i as usize];\n            if !(v.k == VK_CONST && v.ty < 0) {\n                ty = self.concrete_type_of(v);\n                break;\n            }\n        }\n        if ty < 0 {\n            ty = sk as i64;\n        }\n        let tt = self.m.types[ty as usize];\n        if tt.kind != TK_SCALAR && tt.kind != TK_VECTOR {\n            self.drop_args(base);\n            self.fail(at, b\"wgsl.type\", b\"select chooses between scalars or vectors\");\n            return cint(SK_AINT, -1, 0);\n        }\n        let f = self.materialize(self.astack[base as usize], ty, self.apos[base as usize]);\n        let t = self.materialize(self.astack[(base + 1) as usize], ty,\n            self.apos[(base + 1) as usize]);\n        let cv = self.value(self.astack[(base + 2) as usize], self.apos[(base + 2) as usize]);\n        let ct = self.concrete_type_of(cv);\n        let w = self.m.width_of(ty);\n        if ct != T_BOOL && ct != vec_ty(SK_BOOL, w) {\n            if self.err(self.apos[(base + 2) as usize], b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"select's condition is a bool (or a vector of bool as wide as the values), not \");\n                self.val_str(cv);\n            }\n        }\n        let c = self.materialize(cv, ct, self.apos[(base + 2) as usize]);\n        self.drop_args(base);\n        let e = self.f.expr(E_SELECT, ty, c, t, f);\n        val(e, ty)\n    }\n\n    fn array_length(&mut self, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        if n != 1 {\n            self.drop_args(base);\n            self.arg_count_error(at, b\"arrayLength\", b\"one pointer\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let p = self.astack[base as usize];\n        self.drop_args(base);\n        let ok = p.k == VK_VALUE && self.m.types[p.ty as usize].kind == TK_POINTER\n");
    buf_str(out, c"            && self.m.types[p.ty as usize].space == SP_STORAGE;\n        if ok {\n            let pe = self.f.exprs[p.e as usize];\n            let pointee = self.m.pointee(p.ty);\n            let t = self.m.types[pointee as usize];\n            if t.kind == TK_ARRAY && t.n == 0 {\n                if pe.op == E_GLOBAL {\n                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, pe.a, -1, 0);\n                    self.f.exprs[e as usize].d = t.stride;\n                    return val(e, T_U32);\n                }\n                if pe.op == ir::E_ACCESS_INDEX && self.f.exprs[pe.a as usize].op == E_GLOBAL {\n                    let g = self.f.exprs[pe.a as usize].a;\n                    let st = self.m.types[self.m.globals[g as usize].ty as usize];\n                    let off = self.m.members[(st.mstart + pe.b) as usize].offset;\n                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, g, pe.b, off);\n                    self.f.exprs[e as usize].d = t.stride;\n                    return val(e, T_U32);\n                }\n            }\n        }\n        if self.err(at, b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"arrayLength takes a pointer to a runtime-sized array in a storage buffer: arrayLength(&buf) or arrayLength(&buf.items)\");\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    fn atomic(&mut self, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        let want: i64 = if s == K_ATOMIC_LOAD { 1 }\n            else if s == K_ATOMIC_COMPARE_EXCHANGE_WEAK { 3 } else { 2 };\n        if n != want {\n            self.drop_args(base);\n            if self.err(at, b\"wgsl.call\") {\n                write(self.emsg, \"'{}' takes {want} argument\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                if want != 1 {\n                    self.emsg.push(b's');\n                }\n                write(self.emsg, \", got {n}\").unwrap();\n");
    buf_str(out, c"            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let p = self.astack[base as usize];\n        let pt = if p.k == VK_VALUE && p.ty >= 0 { self.m.types[p.ty as usize] }\n            else { self.m.types[T_I32 as usize] };\n        if pt.kind != TK_POINTER || self.m.types[pt.base as usize].kind != TK_ATOMIC {\n            self.drop_args(base);\n            if self.err(self.apos[base as usize], b\"wgsl.type\") {\n                write(self.emsg, \"'{}' takes a pointer to an atomic, got \",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                self.val_str(p);\n                if p.k == VK_REF {\n                    self.help(b\"pass its address: &x\");\n                }\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let sk = self.m.types[pt.base as usize].scalar;\n        let st = sk as i64;\n        let fun = if s == K_ATOMIC_LOAD {\n            AT_LOAD\n        } else if s == K_ATOMIC_STORE {\n            AT_STORE\n        } else if s == K_ATOMIC_ADD {\n            AT_ADD\n        } else if s == K_ATOMIC_SUB {\n            AT_SUB\n        } else if s == K_ATOMIC_MAX {\n            AT_MAX\n        } else if s == K_ATOMIC_MIN {\n            AT_MIN\n        } else if s == K_ATOMIC_AND {\n            AT_AND\n        } else if s == K_ATOMIC_OR {\n            AT_OR\n        } else if s == K_ATOMIC_XOR {\n            AT_XOR\n        } else if s == K_ATOMIC_EXCHANGE {\n            AT_EXCHANGE\n        } else {\n            AT_CMPXCHG\n        };\n        let mut v: i64 = -1;\n        let mut cmp: i64 = -1;\n        if fun == AT_CMPXCHG {\n            cmp = self.materialize(self.astack[(base + 1) as usize], st,\n                self.apos[(base + 1) as usize]);\n            v = self.materialize(self.astack[(base + 2) as usize], st,\n                self.apos[(base + 2) as usize]);\n        } else if fun != AT_LOAD {\n            v = self.materialize(self.astack[(base + 1) as usize], st,\n");
    buf_str(out, c"                self.apos[(base + 1) as usize]);\n        }\n        self.drop_args(base);\n        if fun == AT_STORE {\n            let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, -1);\n            self.f.stmts[s0 as usize].e = -1;\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let rty = if fun == AT_CMPXCHG { self.cmpxchg_type(sk) } else { st };\n        let r = self.unemitted(E_ATOMIC_RESULT, rty);\n        let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, r);\n        self.f.stmts[s0 as usize].e = cmp;\n        val(r, rty)\n    }\n\n    // __atomic_compare_exchange_result<T>: { old_value: T, exchanged: bool }\n    #[effects(panic, A)]\n    pub(crate) fn cmpxchg_type(&mut self, sk: u8) -> i64 {\n        let i: i64 = if sk == SK_I32 { 0 } else { 1 };\n        if self.cmpxchg_ty[i as usize] >= 0 {\n            return self.cmpxchg_ty[i as usize];\n        }\n        let start = self.m.members.len() as i64;\n        self.m.members.push(StructMember {\n            name: b\"old_value\", ty: sk as i64, offset: 0, binding: ir::no_binding(),\n        });\n        self.m.members.push(StructMember {\n            name: b\"exchanged\", ty: T_BOOL, offset: 0, binding: ir::no_binding(),\n        });\n        let name = if sk == SK_I32 { \"__atomic_compare_exchange_result_i32\" }\n            else { \"__atomic_compare_exchange_result_u32\" };\n        let h = self.m.struct_ty(name.as_bytes(), start, 2);\n        self.cmpxchg_ty[i as usize] = h;\n        h\n    }\n\n    // ---- Math ----\n\n    fn math(&mut self, fun: i64, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        let name = self.name_of(s);\n        let want = math_arity(fun);\n        if n != want {\n            self.drop_args(base);\n            if self.err(at, b\"wgsl.call\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n");
    buf_str(out, c"                    write(self.emsg, \"'{name}' takes {want} argument\").unwrap();\n                }\n                if want != 1 {\n                    self.emsg.push(b's');\n                }\n                write(self.emsg, \", got {n}\").unwrap();\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let r = self.math_typed(fun, name, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn math_fail(&mut self, at: i64, name: &[u8], what: &[u8], base: i64, n: i64) -> Val {\n        if self.err(at, b\"wgsl.type\") {\n            {\n                let name = str::from_utf8(name).unwrap();\n                let what = str::from_utf8(what).unwrap();\n                write(self.emsg, \"'{name}' takes {what}; got \").unwrap();\n            }\n            for i in base..base + n {\n                if i > base {\n                    self.emsg.extend_from_slice(b\", \");\n                }\n                self.val_str(self.astack[i as usize]);\n            }\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // The common type of args[base .. base + n] (abstract ones take the\n    // others' scalar; all abstract: f32 when `float`, else by their kind).\n    fn common_type(&self, base: i64, n: i64, float: bool) -> i64 {\n        for i in base..base + n {\n            let v = self.astack[i as usize];\n            if !(v.k == VK_CONST && v.ty < 0) {\n                return self.concrete_type_of(v);\n            }\n        }\n        let mut any_float = float;\n        for i in base..base + n {\n            if self.astack[i as usize].sk == SK_AFLOAT {\n                any_float = true;\n            }\n        }\n        if any_float { T_F32 } else { T_I32 }\n    }\n\n    fn math_typed(&mut self, fun: i64, name: &[u8], base: i64, n: i64, at: i64) -> Val {\n        let float_only = is_float_fun(fun);\n        if fun == MF_ALL || fun == MF_ANY {\n            let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n");
    buf_str(out, c"            let t = self.concrete_type_of(v);\n            if self.m.types[t as usize].scalar != SK_BOOL || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, b\"a bool or a vector of bool\", base, n);\n            }\n            if t == T_BOOL {\n                return v;\n            }\n            let e0 = self.materialize(v, t, self.apos[base as usize]);\n            return self.math_expr(fun, T_BOOL, [e0, 0, 0, 0], 1);\n        }\n        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n            || fun >= ir::MF_PACK4X8SNORM {\n            return self.packing(fun, name, base, at);\n        }\n        if fun == MF_LDEXP {\n            let t = self.float_type(self.astack[base as usize], self.apos[base as usize]);\n            let w = self.m.width_of(t);\n            let e0 = self.materialize(self.astack[base as usize], t, self.apos[base as usize]);\n            let e1 = self.materialize(self.astack[(base + 1) as usize], vec_ty(SK_I32, w),\n                self.apos[(base + 1) as usize]);\n            return self.math_expr(fun, t, [e0, e1, 0, 0], 2);\n        }\n        if fun == MF_EXTRACT_BITS || fun == MF_INSERT_BITS {\n            let k: i64 = if fun == MF_EXTRACT_BITS { 1 } else { 2 };\n            let t = self.common_type(base, k, false);\n            let sk = self.m.types[t as usize].scalar;\n            if (sk != SK_I32 && sk != SK_U32) || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, b\"i32 or u32 values and u32 offset and count\", base,\n                    n);\n            }\n            let mut es: [i64; 4] = [0i64; 4];\n            for i in 0..k {\n                es[i as usize] = self.materialize(self.astack[(base + i) as usize], t,\n                    self.apos[(base + i) as usize]);\n            }\n            es[k as usize] = self.materialize(self.astack[(base + k) as usize], T_U32,\n                self.apos[(base + k) as usize]);\n");
    buf_str(out, c"            es[(k + 1) as usize] = self.materialize(self.astack[(base + k + 1) as usize], T_U32,\n                self.apos[(base + k + 1) as usize]);\n            return self.math_expr(fun, t, es, k + 2);\n        }\n        if fun == ir::MF_MIX {\n            // mix(a, b, t): t is the same type, or a scalar\n            let t = self.common_type(base, 2, true);\n            if self.m.types[t as usize].scalar != SK_F32 || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, b\"f32 values\", base, n);\n            }\n            let e0 = self.materialize(self.astack[base as usize], t, self.apos[base as usize]);\n            let e1 = self.materialize(self.astack[(base + 1) as usize], t,\n                self.apos[(base + 1) as usize]);\n            let tv = self.value(self.astack[(base + 2) as usize], self.apos[(base + 2) as usize]);\n            let tt = if tv.k == VK_CONST { T_F32 } else { tv.ty };\n            let mut e2 = self.materialize(tv, if tt == T_F32 { T_F32 } else { t },\n                self.apos[(base + 2) as usize]);\n            if tt == T_F32 && t != T_F32 {\n                e2 = self.f.expr(E_SPLAT, t, e2, 0, 0);\n            }\n            return self.math_expr(fun, t, [e0, e1, e2, 0], 3);\n        }\n        let t = self.common_type(base, n, float_only);\n        let tt = self.m.types[t as usize];\n        let sk = tt.scalar;\n        if fun == MF_DETERMINANT || fun == MF_TRANSPOSE {\n            if tt.kind != TK_MATRIX || (fun == MF_DETERMINANT && tt.n != tt.m) {\n                return self.math_fail(at, name,\n                    if fun == MF_DETERMINANT { b\"a square matrix\" } else { b\"a matrix\" }, base, n);\n            }\n            let e0 = self.materialize(self.astack[base as usize], t, self.apos[base as usize]);\n            let rt = if fun == MF_DETERMINANT { T_F32 } else { mat_ty(tt.m, tt.n) };\n            return self.math_expr(fun, rt, [e0, 0, 0, 0], 1);\n        }\n        let w = self.m.width_of(t);\n");
    buf_str(out, c"        if w == 0 || sk == SK_BOOL {\n            return self.math_fail(at, name,\n                if float_only { b\"f32 or vecN<f32>\" } else { b\"numbers or vectors of them\" }, base,\n                n);\n        }\n        if float_only && sk != SK_F32 {\n            let r = self.math_fail(at, name, b\"f32 or vecN<f32>\", base, n);\n            self.help(b\"convert it: f32(...)\");\n            return r;\n        }\n        if is_int_fun(fun) && sk == SK_F32 {\n            return self.math_fail(at, name, b\"i32 or u32 (or vectors of them)\", base, n);\n        }\n        if fun == ir::MF_SIGN && sk == SK_U32 {\n            return self.math_fail(at, name, b\"i32 or f32 (or vectors of them)\", base, n);\n        }\n        let vector_only = fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n            || fun == ir::MF_FACE_FORWARD || fun == MF_DOT || fun == MF_DISTANCE && false;\n        if vector_only && w == 1 {\n            return self.math_fail(at, name, b\"vectors\", base, n);\n        }\n        if fun == MF_CROSS && (w != 3 || sk != SK_F32) {\n            return self.math_fail(at, name, b\"two vec3<f32>\", base, n);\n        }\n        let mut es: [i64; 4] = [0i64; 4];\n        for i in 0..n {\n            es[i as usize] = self.materialize(self.astack[(base + i) as usize], t,\n                self.apos[(base + i) as usize]);\n        }\n        let rt = if fun == MF_LENGTH || fun == MF_DISTANCE || fun == MF_DOT { sk as i64 }\n            else { t };\n        // constants fold when they are scalars of the simple kind\n        self.math_expr(fun, rt, es, n)\n    }\n\n    fn math_expr(&mut self, fun: i64, ty: i64, es: [i64; 4], n: i64) -> Val {\n        let a = self.f.args.len() as i64;\n        for i in 0..n {\n            self.f.args.push(es[i as usize]);\n        }\n        let e = self.f.expr(E_MATH, ty, fun, a, n);\n        val(e, ty)\n    }\n\n    fn packing(&mut self, fun: i64, name: &[u8], base: i64, at: i64) -> Val {\n");
    buf_str(out, c"        let unpack = fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK2X16FLOAT\n            || fun == ir::MF_UNPACK4X8SNORM || fun == ir::MF_UNPACK2X16UNORM\n            || fun == ir::MF_UNPACK2X16SNORM;\n        let four = fun == ir::MF_PACK4X8UNORM || fun == ir::MF_UNPACK4X8UNORM\n            || fun == ir::MF_PACK4X8SNORM || fun == ir::MF_UNPACK4X8SNORM;\n        let vt = vec_ty(SK_F32, if four { 4 } else { 2 });\n        if unpack {\n            let e0 = self.materialize(self.astack[base as usize], T_U32, self.apos[base as usize]);\n            return self.math_expr(fun, vt, [e0, 0, 0, 0], 1);\n        }\n        let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n        if self.concrete_type_of(v) != vt {\n            return self.math_fail(at, name, if four { b\"a vec4<f32>\" } else { b\"a vec2<f32>\" },\n                base, 1);\n        }\n        let e0 = self.materialize(v, vt, self.apos[base as usize]);\n        self.math_expr(fun, T_U32, [e0, 0, 0, 0], 1)\n    }\n\n    // ---- Textures ----\n\n    fn texture_arg(&mut self, i: i64, sampler: bool) -> i64 {\n        let v = self.astack[i as usize];\n        let want = if sampler { TK_SAMPLER } else { TK_TEXTURE };\n        if v.k != VK_VALUE || self.m.types[v.ty as usize].kind != want {\n            if self.err(self.apos[i as usize], b\"wgsl.type\") {\n                self.emsg.extend_from_slice((if sampler { b\"expected a sampler, got \" }\n                    else { b\"expected a texture, got \" }));\n                self.val_str(v);\n            }\n            return -1;\n        }\n        v.e\n    }\n\n    fn texture_call(&mut self, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        let r = self.texture_typed(s, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn texture_typed(&mut self, s: i64, base: i64, n: i64, at: i64) -> Val {\n        let name = self.name_of(s);\n        if n < 1 {\n");
    buf_str(out, c"            self.arg_count_error(at, name, b\"a texture first\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let te = self.texture_arg(base, false);\n        if te < 0 {\n            return cint(SK_AINT, -1, 0);\n        }\n        let tt = self.m.types[self.f.exprs[te as usize].ty as usize];\n        let arrayed = tt.n == TEX_2D_ARRAY;\n        let depth = tt.n == TEX_DEPTH_2D;\n        let storage = tt.n == TEX_STORAGE_2D;\n        let texel = if depth { T_F32 } else { vec_ty(tt.scalar, 4) };\n        if s == K_TEXTURE_DIMENSIONS || s == K_TEXTURE_NUM_LEVELS || s == K_TEXTURE_NUM_LAYERS {\n            if s == K_TEXTURE_NUM_LAYERS && !arrayed {\n                self.fail(at, b\"wgsl.type\", b\"textureNumLayers takes an array texture\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if s == K_TEXTURE_NUM_LEVELS && storage {\n                self.fail(at, b\"wgsl.type\", b\"a storage texture has one level\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let mut lvl: i64 = -1;\n            if s == K_TEXTURE_DIMENSIONS && n == 2 && !storage {\n                let lt = self.int_arg_type(base + 1);\n                lvl = self.materialize(self.astack[(base + 1) as usize], lt,\n                    self.apos[(base + 1) as usize]);\n            } else if n != 1 {\n                self.arg_count_error(at, name, b\"the texture (and for textureDimensions a level)\",\n                    n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let q = if s == K_TEXTURE_DIMENSIONS { IQ_SIZE }\n                else if s == K_TEXTURE_NUM_LEVELS { IQ_LEVELS } else { IQ_LAYERS };\n            let rt = if q == IQ_SIZE { vec_ty(SK_U32, 2) } else { T_U32 };\n            let e = self.f.expr(E_IMAGE_QUERY, rt, te, q, lvl);\n            return val(e, rt);\n        }\n        if s == K_TEXTURE_STORE {\n            if !storage {\n");
    buf_str(out, c"                self.fail(at, b\"wgsl.type\", b\"textureStore writes a texture_storage_2d\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if n != 3 {\n                self.arg_count_error(at, name, b\"3 arguments (texture, coordinates, value)\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let ct = self.coords_type(base + 1);\n            let ce = self.materialize(self.astack[(base + 1) as usize], ct,\n                self.apos[(base + 1) as usize]);\n            let ve = self.materialize(self.astack[(base + 2) as usize], texel,\n                self.apos[(base + 2) as usize]);\n            self.push_stmt(S_IMAGE_STORE, te, ce, ve, -1);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        if s == K_TEXTURE_LOAD {\n            if storage {\n                self.fail(at, b\"wgsl.unsupported\",\n                    b\"storage textures are write-only in this release\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let want: i64 = if arrayed { 4 } else { 3 };\n            if n != want {\n                self.arg_count_error(at, name,\n                    if arrayed { b\"4 arguments (texture, coordinates, layer, level)\" }\n                    else { b\"3 arguments (texture, coordinates, level)\" }, n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let ct = self.coords_type(base + 1);\n            let a = self.f.args.len() as i64;\n            let ce = self.materialize(self.astack[(base + 1) as usize], ct,\n                self.apos[(base + 1) as usize]);\n            let mut extra: [i64; 2] = [0i64; 2];\n            for i in 2..n {\n                let it = self.int_arg_type(base + i);\n                extra[(i - 2) as usize] = self.materialize(self.astack[(base + i) as usize], it,\n                    self.apos[(base + i) as usize]);\n            }\n            let a2 = self.f.args.len() as i64;\n");
    buf_str(out, c"            let _ = a;\n            self.f.args.push(ce);\n            for i in 2..n {\n                self.f.args.push(extra[(i - 2) as usize]);\n            }\n            let e = self.f.expr(E_IMAGE_LOAD, texel, te, 0, a2);\n            self.f.exprs[e as usize].d = n - 1;\n            return val(e, texel);\n        }\n        // the sampling functions\n        if storage {\n            self.fail(at, b\"wgsl.type\", b\"a storage texture cannot be sampled\");\n            return cint(SK_AINT, -1, 0);\n        }\n        let kind = if s == K_TEXTURE_SAMPLE {\n            IMG_SAMPLE\n        } else if s == K_TEXTURE_SAMPLE_BIAS {\n            IMG_SAMPLE_BIAS\n        } else if s == K_TEXTURE_SAMPLE_LEVEL {\n            IMG_SAMPLE_LEVEL\n        } else if s == K_TEXTURE_SAMPLE_COMPARE {\n            IMG_SAMPLE_COMPARE\n        } else {\n            IMG_SAMPLE_COMPARE_LEVEL\n        };\n        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n        if compare != depth && (compare || kind == IMG_SAMPLE_BIAS) {\n            self.fail(at, b\"wgsl.type\",\n                if compare { b\"textureSampleCompare takes a texture_depth_2d\" }\n                else { b\"textureSampleBias takes a texture_2d<f32>\" });\n            return cint(SK_AINT, -1, 0);\n        }\n        if !depth && tt.scalar != SK_F32 {\n            self.fail(at, b\"wgsl.type\",\n                b\"only f32 textures are sampled; use textureLoad for i32 and u32\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if (kind == IMG_SAMPLE || kind == IMG_SAMPLE_BIAS || kind == IMG_SAMPLE_COMPARE)\n            && self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n            if self.err(at, b\"wgsl.stage\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"'{name}' computes derivatives: it is for fragment shaders\").unwrap();\n                }\n");
    buf_str(out, c"                self.help(b\"use textureSampleLevel elsewhere\");\n            }\n        }\n        let has_aux = kind != IMG_SAMPLE;\n        let want: i64 = 3 + (if arrayed { 1 } else { 0 }) + (if has_aux { 1 } else { 0 });\n        if n != want {\n            self.arg_count_error(at, name, b\"a texture, a sampler, coordinates, then a layer for an array texture and the bias, level or depth reference\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let se = self.texture_arg(base + 1, true);\n        if se < 0 {\n            return cint(SK_AINT, -1, 0);\n        }\n        let sm = self.m.types[self.f.exprs[se as usize].ty as usize];\n        if (sm.n == 1) != compare {\n            self.fail(self.apos[(base + 1) as usize], b\"wgsl.type\",\n                if compare { b\"comparisons take a sampler_comparison\" }\n                else { b\"this takes a sampler, not a sampler_comparison\" });\n            return cint(SK_AINT, -1, 0);\n        }\n        let mut es: [i64; 3] = [0i64; 3];\n        es[0] = self.materialize(self.astack[(base + 2) as usize], vec_ty(SK_F32, 2),\n            self.apos[(base + 2) as usize]);\n        let mut k: i64 = 1;\n        if arrayed {\n            let it = self.int_arg_type(base + 3);\n            es[1] = self.materialize(self.astack[(base + 3) as usize], it,\n                self.apos[(base + 3) as usize]);\n            k = 2;\n        }\n        if has_aux {\n            let ai = base + n - 1;\n            let at2 = if kind == IMG_SAMPLE_LEVEL && depth { self.int_arg_type(ai) } else { T_F32 };\n            es[k as usize] = self.materialize(self.astack[ai as usize], at2,\n                self.apos[ai as usize]);\n            k += 1;\n        }\n        let a = self.f.args.len() as i64;\n        for i in 0..k {\n            self.f.args.push(es[i as usize]);\n        }\n        let e = self.f.expr(E_IMAGE_SAMPLE, texel, te, se, a);\n        self.f.exprs[e as usize].d = kind | (k << 8);\n        val(e, texel)\n    }\n");
    buf_str(out, c"\n    // vec2<i32> or vec2<u32>, as the argument has it.\n    fn coords_type(&mut self, i: i64) -> i64 {\n        let v = self.astack[i as usize];\n        let t = self.concrete_type_of(v);\n        if t == vec_ty(SK_U32, 2) || t == vec_ty(SK_I32, 2) {\n            return t;\n        }\n        if self.err(self.apos[i as usize], b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"texel coordinates are a vec2<i32> or vec2<u32>, not \");\n            self.val_str(v);\n        }\n        vec_ty(SK_I32, 2)\n    }\n\n    fn int_arg_type(&mut self, i: i64) -> i64 {\n        let v = self.astack[i as usize];\n        let t = self.concrete_type_of(v);\n        if t == T_U32 || t == T_I32 {\n            return t;\n        }\n        if self.err(self.apos[i as usize], b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"expected an i32 or a u32, got \");\n            self.val_str(v);\n        }\n        T_I32\n    }\n}\n\nfn math_arity(fun: i64) -> i64 {\n    if fun == ir::MF_MIN || fun == ir::MF_MAX || fun == ir::MF_POW || fun == ir::MF_ATAN2\n        || fun == ir::MF_STEP || fun == MF_DISTANCE || fun == MF_DOT || fun == MF_CROSS\n        || fun == ir::MF_REFLECT || fun == MF_LDEXP {\n        2\n    }\n    else if fun == ir::MF_CLAMP || fun == ir::MF_MIX || fun == ir::MF_SMOOTHSTEP\n        || fun == ir::MF_FMA || fun == ir::MF_FACE_FORWARD || fun == MF_EXTRACT_BITS {\n        3\n    } else if fun == MF_INSERT_BITS {\n        4\n    } else {\n        1\n    }\n}\n\nfn is_float_fun(fun: i64) -> bool {\n    (fun >= ir::MF_FLOOR && fun <= ir::MF_FMA) || fun == MF_LENGTH || fun == MF_DISTANCE\n        || fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n        || fun == ir::MF_DEGREES || fun == ir::MF_RADIANS || fun == ir::MF_SATURATE\n        || fun == ir::MF_ASINH || fun == ir::MF_ACOSH || fun == ir::MF_ATANH\n        || fun == ir::MF_FACE_FORWARD\n}\n\n");
    buf_str(out, c"fn is_int_fun(fun: i64) -> bool { fun >= ir::MF_COUNT_ONE_BITS && fun <= MF_INSERT_BITS }\n// ---- end mod std::gpu::wgsl::builtins ----\n}\n// ---- mod std::gpu::wgsl::entry ----\npub mod entry {\n// ---- Shader compiler implementation, entry (0.22) ----\n// Entry-point interfaces: what each stage's parameters and result may be\n// bound to, and with which types (WGSL §\"Entry Point Declaration\").\n\nuse crate::alloc::Allocator;\n\nuse super::front::Front;\nuse super::ir::{\n    BIND_BUILTIN, BIND_NONE, BI_FRAG_DEPTH, BI_FRONT_FACING, BI_GLOBAL_INVOCATION_ID,\n    BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS,\n    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,\n    INTERP_FLAT, SK_BOOL, SK_F32, SK_U32, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, TK_SCALAR,\n    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_U32, vec_ty,\n};\n\n#[effects()]\npub(crate) fn builtin_name(b: i64) -> &'static [u8] {\n    if b == BI_POSITION {\n        b\"position\"\n    } else if b == BI_VERTEX_INDEX {\n        b\"vertex_index\"\n    } else if b == BI_INSTANCE_INDEX {\n        b\"instance_index\"\n    } else if b == BI_FRONT_FACING {\n        b\"front_facing\"\n    } else if b == BI_FRAG_DEPTH {\n        b\"frag_depth\"\n    } else if b == BI_SAMPLE_INDEX {\n        b\"sample_index\"\n    } else if b == BI_SAMPLE_MASK {\n        b\"sample_mask\"\n    } else if b == BI_LOCAL_INVOCATION_ID {\n        b\"local_invocation_id\"\n    } else if b == BI_LOCAL_INVOCATION_INDEX {\n        b\"local_invocation_index\"\n    } else if b == BI_GLOBAL_INVOCATION_ID {\n        b\"global_invocation_id\"\n    } else if b == BI_WORKGROUP_ID {\n        b\"workgroup_id\"\n    } else {\n        b\"num_workgroups\"\n    }\n}\n\n// The type a builtin has.\n#[effects()]\npub(crate) fn builtin_type(b: i64) -> i64 {\n    if b == BI_POSITION {\n        vec_ty(SK_F32, 4)\n    } else if b == BI_FRONT_FACING {\n        T_BOOL\n");
    buf_str(out, c"    } else if b == BI_FRAG_DEPTH {\n        T_F32\n    }\n    else if b == BI_LOCAL_INVOCATION_ID || b == BI_GLOBAL_INVOCATION_ID || b == BI_WORKGROUP_ID\n        || b == BI_NUM_WORKGROUPS {\n        vec_ty(SK_U32, 3)\n    } else {\n        T_U32\n    }\n}\n\n// Whether builtin b may be an input (or, `output`, an output) of stage.\nfn builtin_allowed(b: i64, stage: u8, output: bool) -> bool {\n    if stage == STAGE_COMPUTE {\n        return !output && b >= BI_LOCAL_INVOCATION_ID;\n    }\n    if stage == STAGE_VERTEX {\n        if output {\n            return b == BI_POSITION;\n        }\n        return b == BI_VERTEX_INDEX || b == BI_INSTANCE_INDEX;\n    }\n    if output {\n        return b == BI_FRAG_DEPTH || b == BI_SAMPLE_MASK;\n    }\n    b == BI_POSITION || b == BI_FRONT_FACING || b == BI_SAMPLE_INDEX || b == BI_SAMPLE_MASK\n}\n\nstruct Seen<A: Allocator> { locs: Vec<i64, A>, builtins: Vec<i64, A>, position: bool }\n\nfn check_binding<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, b: Binding, ty: i64, stage: u8,\n    output: bool, what: &[u8], seen: &mut Seen<A>) {\n    let at = fr.m.functions[fr.m.entries[(fr.m.entries.len() as i64 - 1) as usize].func as usize].pos;\n    if b.kind == BIND_NONE {\n        if fr.err(at, b\"wgsl.entry\") {\n            {\n                let what = str::from_utf8(what).unwrap();\n                write(fr.emsg, \"{what} of an entry point needs '@location(N)' or '@builtin(NAME)'\").unwrap();\n            }\n        }\n        return;\n    }\n    if b.kind == BIND_BUILTIN {\n        if !builtin_allowed(b.value, stage, output) {\n            let io = if output { \"output\" } else { \"input\" };\n            if fr.err(at, b\"wgsl.entry\") {\n                write(fr.emsg, \"'@builtin({})' is not an {io} of a {} shader\",\n                    str::from_utf8(builtin_name(b.value)).unwrap(),\n                    str::from_utf8(stage_name(stage)).unwrap()).unwrap();\n            }\n            return;\n        }\n");
    buf_str(out, c"        if builtin_type(b.value) != ty {\n            if fr.err(at, b\"wgsl.entry\") {\n                write(fr.emsg, \"'@builtin({})' has type \",\n                    str::from_utf8(builtin_name(b.value)).unwrap()).unwrap();\n                fr.ty_str(builtin_type(b.value));\n                fr.emsg.extend_from_slice(b\", not \");\n                fr.ty_str(ty);\n            }\n            return;\n        }\n        for i in 0..seen.builtins.len() as i64 {\n            if seen.builtins[i as usize] == b.value {\n                if fr.err(at, b\"wgsl.entry\") {\n                    write(fr.emsg, \"'@builtin({})' appears twice\",\n                        str::from_utf8(builtin_name(b.value)).unwrap()).unwrap();\n                }\n                return;\n            }\n        }\n        seen.builtins.push(b.value);\n        if b.value == BI_POSITION {\n            seen.position = true;\n        }\n        return;\n    }\n    // a location\n    if stage == STAGE_COMPUTE {\n        if fr.err(at, b\"wgsl.entry\") {\n            fr.emsg.extend_from_slice(b\"a compute shader has no '@location' inputs\");\n        }\n        return;\n    }\n    let t = fr.m.types[ty as usize];\n    if (t.kind != TK_SCALAR && t.kind != TK_VECTOR) || t.scalar == SK_BOOL {\n        if fr.err(at, b\"wgsl.entry\") {\n            write(fr.emsg, \"'@location({})' holds a number or a vector of numbers, not \", b.value).unwrap();\n            fr.ty_str(ty);\n        }\n        return;\n    }\n    let interpolated = (stage == STAGE_VERTEX && output) || (stage == STAGE_FRAGMENT && !output);\n    if interpolated && t.scalar != SK_F32 && b.interp != INTERP_FLAT {\n        if fr.err(at, b\"wgsl.entry\") {\n            write(fr.emsg, \"'@location({})' is an integer: it needs '@interpolate(flat)'\", b.value).unwrap();\n        }\n        return;\n    }\n    for i in 0..seen.locs.len() as i64 {\n        if seen.locs[i as usize] == b.value {\n            if fr.err(at, b\"wgsl.entry\") {\n");
    buf_str(out, c"                write(fr.emsg, \"'@location({})' appears twice\", b.value).unwrap();\n            }\n            return;\n        }\n    }\n    seen.locs.push(b.value);\n}\n\n#[effects()]\npub fn stage_name(s: u8) -> &'static [u8] {\n    if s == STAGE_VERTEX {\n        b\"vertex\"\n    } else if s == STAGE_FRAGMENT {\n        b\"fragment\"\n    } else {\n        b\"compute\"\n    }\n}\n\n// A parameter or result: a bound value, or a struct of bound members.\nfn check_io<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, b: Binding, ty: i64, stage: u8,\n    output: bool, what: &[u8], seen: &mut Seen<A>) {\n    let t = fr.m.types[ty as usize];\n    if t.kind == TK_STRUCT && b.kind == BIND_NONE {\n        for i in t.mstart..t.mstart + t.mcount {\n            let mem = fr.m.members[i as usize];\n            if fr.m.types[mem.ty as usize].kind == TK_STRUCT {\n                let at = fr.m.functions[\n                    fr.m.entries[(fr.m.entries.len() as i64 - 1) as usize].func as usize].pos;\n                fr.fail(at, b\"wgsl.entry\", b\"an entry point's IO struct cannot nest structs\");\n                return;\n            }\n            check_binding(fr, mem.binding, mem.ty, stage, output, b\"a member of an IO struct\",\n                seen);\n        }\n        return;\n    }\n    check_binding(fr, b, ty, stage, output, what, seen);\n}\n\n#[effects(panic, A)]\npub(crate) fn check_interface<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, ei: i64) {\n    let stage = fr.m.entries[ei as usize].stage;\n    let fh = fr.m.entries[ei as usize].func;\n    let pos = fr.m.functions[fh as usize].pos;\n    let mut ins = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n    for i in 0..fr.m.functions[fh as usize].params.len() as i64 {\n        let b = fr.m.functions[fh as usize].params[i as usize].binding;\n        let t = fr.m.functions[fh as usize].params[i as usize].ty;\n        check_io(fr, b, t, stage, false, b\"a parameter\", &mut ins);\n");
    buf_str(out, c"    }\n    let mut outs = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n    let result = fr.m.functions[fh as usize].result;\n    if result >= 0 {\n        if stage == STAGE_COMPUTE {\n            fr.fail(pos, b\"wgsl.entry\", b\"a compute shader returns nothing\");\n            return;\n        }\n        let rb = fr.m.functions[fh as usize].result_binding;\n        check_io(fr, rb, result, stage, true, b\"the result\", &mut outs);\n    }\n    if stage == STAGE_VERTEX && !outs.position && !fr.failed {\n        fr.fail(pos, b\"wgsl.entry\", b\"a vertex shader returns '@builtin(position)' (a vec4<f32>)\");\n        fr.help(b\"for example: fn vs(...) -> @builtin(position) vec4<f32>\");\n    }\n}\n// ---- end mod std::gpu::wgsl::entry ----\n}\n// ---- mod std::gpu::wgsl::bounds ----\npub mod bounds {\n// ---- Shader compiler implementation, bounds (0.22) ----\n// Bounds checks (D15: no undefined behaviour in shaders). Every E_ACCESS\n// gets its check: a clamp for vectors, matrices and fixed-size arrays\n// (naga's Restrict), read-zero-skip-write for runtime-sized arrays. A\n// check is dropped only where a dominating comparison proves the index in\n// range: the head of a counted loop, `for (var i = 0u; i < N; i++)`,\n// whose body indexes something of length N or more with `i`.\n\nuse crate::mem;\nuse crate::alloc::Allocator;\n\nuse super::ir::{\n    CK_CLAMP, CK_NONE, CK_PENDING, CK_RZSW, E_ACCESS, E_BINARY, E_LITERAL, E_LOAD, E_LOCAL,\n    Function, Module, OP_LT, S_BLOCK, S_BREAK, S_CALL, S_EMIT, S_IF, S_LOOP, S_STORE, S_SWITCH,\n    TK_ARRAY, TK_POINTER, T_I32, T_U32,\n};\n\n// A fact: local `l` is below `n` (and not negative) while it holds.\n#[derive(Clone, Copy)] struct Fact { local: i64, n: i64 }\n\npub fn insert_checks<A: Allocator + Copy>(m: &mut Module<'_, A>, a: A, prove: bool) {\n    for h in 0..m.functions.len() as i64 {\n        let mut f = mem::replace(&mut m.functions[h as usize], ir::new_function(b\"\", m.a));\n");
    buf_str(out, c"        for e in 0..f.exprs.len() as i64 {\n            let x = f.exprs[e as usize];\n            if x.op != E_ACCESS || x.c != CK_PENDING {\n                continue;\n            }\n            let bt0 = f.exprs[x.a as usize].ty;\n            let bt = if m.types[bt0 as usize].kind == TK_POINTER { m.types[bt0 as usize].base }\n                else { bt0 };\n            let t = m.types[bt as usize];\n            if t.kind == TK_ARRAY && t.n == 0 {\n                f.exprs[e as usize].c = CK_RZSW;\n            } else {\n                f.exprs[e as usize].c = CK_CLAMP;\n                f.exprs[e as usize].d = t.n;\n            }\n        }\n        if prove && f.body >= 0 {\n            let mut facts: Vec<Fact, A> = Vec::new_in(a);\n            { let at_arg2 = f.body; prove_block(m, &mut f, at_arg2, &mut facts) };\n        }\n        m.functions[h as usize] = f;\n    }\n    let mut c = mem::replace(&mut m.consts, ir::new_function(b\"\", m.a));\n    for e in 0..c.exprs.len() as i64 {\n        if c.exprs[e as usize].op == E_ACCESS && c.exprs[e as usize].c == CK_PENDING {\n            c.exprs[e as usize].c = CK_CLAMP;\n            c.exprs[e as usize].d = m.types[c.exprs[c.exprs[e as usize].a as usize].ty as usize].n;\n        }\n    }\n    m.consts = c;\n}\n\n// The local an expression loads, or -1.\nfn loaded_local<A: Allocator + Copy>(f: &Function<'_, A>, e: i64) -> i64 {\n    let x = f.exprs[e as usize];\n    if x.op == E_LOAD && f.exprs[x.a as usize].op == E_LOCAL {\n        return f.exprs[x.a as usize].a;\n    }\n    -1\n}\n\n// Whether the block (or what it calls) may store to local l.\nfn stores_local<A: Allocator + Copy>(f: &Function<'_, A>, blk: i64, l: i64) -> bool {\n    let b = f.blocks[blk as usize];\n    for i in b.start..b.start + b.count {\n        let st = f.stmts[f.items[i as usize] as usize];\n        if st.op == S_STORE {\n            let p = f.exprs[st.a as usize];\n            // a store through any pointer derived from the local\n");
    buf_str(out, c"            if p.op == E_LOCAL && p.a == l {\n                return true;\n            }\n            if p.op != E_LOCAL && reaches_local(f, st.a, l) {\n                return true;\n            }\n        } else if st.op == S_CALL {\n            // a pointer to the local passed to a function\n            for k in st.b..st.b + st.c {\n                if reaches_local(f, f.args[k as usize], l) {\n                    return true;\n                }\n            }\n        } else if st.op == S_BLOCK {\n            if stores_local(f, st.a, l) {\n                return true;\n            }\n        } else if st.op == S_IF {\n            if stores_local(f, st.b, l) || stores_local(f, st.c, l) {\n                return true;\n            }\n        } else if st.op == S_SWITCH {\n            for k in st.b..st.b + st.c {\n                if stores_local(f, f.cases[k as usize].body, l) {\n                    return true;\n                }\n            }\n        } else if st.op == S_LOOP {\n            if stores_local(f, st.a, l) || stores_local(f, st.b, l) {\n                return true;\n            }\n        } else if st.op == ir::S_ATOMIC {\n            if reaches_local(f, st.a, l) {\n                return true;\n            }\n        }\n    }\n    false\n}\n\n// Whether pointer expression e is local l or derived from it.\nfn reaches_local<A: Allocator + Copy>(f: &Function<'_, A>, e: i64, l: i64) -> bool {\n    let x = f.exprs[e as usize];\n    if x.op == E_LOCAL {\n        return x.a == l;\n    }\n    if x.op == E_ACCESS || x.op == ir::E_ACCESS_INDEX {\n        return reaches_local(f, x.a, l);\n    }\n    false\n}\n\n// The facts the head of a loop body establishes: `if (load(l) < N) {}\n// else { break; }`, with l an unsigned local or a signed one that starts\n// at a non-negative value and is only increased (checked by the caller).\nfn head_fact<A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>, body: i64) -> Fact {\n    let b = f.blocks[body as usize];\n");
    buf_str(out, c"    let none = Fact { local: -1, n: 0 };\n    for i in b.start..b.start + b.count {\n        let st = f.stmts[f.items[i as usize] as usize];\n        if st.op == S_EMIT {\n            continue;\n        }\n        if st.op != S_IF {\n            return none;\n        }\n        let then_b = f.blocks[st.b as usize];\n        let else_b = f.blocks[st.c as usize];\n        if then_b.count != 0 || else_b.count != 1\n            || f.stmts[f.items[else_b.start as usize] as usize].op != S_BREAK {\n            return none;\n        }\n        let c = f.exprs[st.a as usize];\n        if c.op != E_BINARY || c.a != OP_LT {\n            return none;\n        }\n        let l = loaded_local(f, c.b);\n        let lim = f.exprs[c.c as usize];\n        if l < 0 || lim.op != E_LITERAL {\n            return none;\n        }\n        let lt = f.locals[l as usize].ty;\n        if lt != T_U32 && lt != T_I32 {\n            return none;\n        }\n        let n = if lt == T_I32 { lim.a as u32 as i32 as i64 } else { lim.a };\n        if n <= 0 {\n            return none;\n        }\n        return Fact { local: l, n: n };\n    }\n    none\n}\n\n// Whether local l (an i32) is never negative at the loop: it was stored a\n// non-negative literal just before the loop, and the loop's continuing\n// block only adds a positive literal to it.\nfn nonneg_counter<A: Allocator + Copy>(f: &Function<'_, A>, items: &Vec<i64, A>, pos: i64, l: i64,\n    cont: i64, n: i64) -> bool {\n    // the statement before the loop (skipping emits) stores a literal\n    let mut k = pos - 1;\n    let mut ok = false;\n    while k >= 0 {\n        let st = f.stmts[items[k as usize] as usize];\n        if st.op == S_EMIT {\n            k -= 1;\n            continue;\n        }\n        if st.op == S_STORE && f.exprs[st.a as usize].op == E_LOCAL\n            && f.exprs[st.a as usize].a == l {\n            let v = f.exprs[st.b as usize];\n            ok = v.op == E_LITERAL && (v.a as u32 as i32) >= 0;\n        }\n");
    buf_str(out, c"        break;\n    }\n    if !ok {\n        return false;\n    }\n    // continuing: only `l = load(l) + positive literal`\n    let cb = f.blocks[cont as usize];\n    for i in cb.start..cb.start + cb.count {\n        let st = f.stmts[f.items[i as usize] as usize];\n        if st.op == S_STORE && reaches_local(f, st.a, l) {\n            let v = f.exprs[st.b as usize];\n            if v.op != E_BINARY || v.a != ir::OP_ADD || loaded_local(f, v.b) != l {\n                return false;\n            }\n            let inc = f.exprs[v.c as usize];\n            // positive, and i + inc cannot wrap past i32's top while i < n\n            if inc.op != E_LITERAL || (inc.a as u32 as i32) <= 0\n                || n + (inc.a as u32 as i32) as i64 > 2147483647 {\n                return false;\n            }\n        } else if st.op != S_EMIT {\n            if st.op == S_CALL || st.op == S_BLOCK || st.op == S_IF || st.op == S_LOOP\n                || st.op == S_SWITCH {\n                if stores_local(f, cont, l) {\n                    return false;\n                }\n            }\n        }\n    }\n    true\n}\n\nfn prove_block<A: Allocator + Copy>(m: &Module<'_, A>, f: &mut Function<'_, A>, blk: i64,\n    facts: &mut Vec<Fact, A>) {\n    let b = f.blocks[blk as usize];\n    // the block's items, so nonneg_counter can look back\n    let mut items: Vec<i64, A> = Vec::new_in(*f.items.allocator());\n    for i in b.start..b.start + b.count {\n        items.push(f.items[i as usize]);\n    }\n    for i in 0..items.len() as i64 {\n        let s = items[i as usize];\n        let st = f.stmts[s as usize];\n        if st.op == S_EMIT {\n            for e in st.a..st.b {\n                prove_expr(m, f, e, facts);\n            }\n        } else if st.op == S_BLOCK {\n            prove_block(m, f, st.a, facts);\n        } else if st.op == S_IF {\n            prove_block(m, f, st.b, facts);\n            prove_block(m, f, st.c, facts);\n        } else if st.op == S_SWITCH {\n");
    buf_str(out, c"            for k in st.b..st.b + st.c {\n                prove_block(m, f, f.cases[k as usize].body, facts);\n            }\n        } else if st.op == S_LOOP {\n            let base = facts.len() as i64;\n            // facts from outside the loop hold inside only when it keeps them\n            let mut kept: i64 = 0;\n            for k in 0..base {\n                if !stores_local(f, st.a, facts[k as usize].local)\n                    && !stores_local(f, st.b, facts[k as usize].local) {\n                    kept += 1;\n                } else {\n                    facts[k as usize].n = -facts[k as usize].n - 1;\n                }\n            }\n            let _ = kept;\n            let fact = head_fact(m, f, st.a);\n            let mut added = false;\n            if fact.local >= 0 && !stores_local(f, st.a, fact.local) {\n                let lt = f.locals[fact.local as usize].ty;\n                if lt == T_U32 || nonneg_counter(f, &items, i, fact.local, st.b, fact.n) {\n                    facts.push(fact);\n                    added = true;\n                }\n            }\n            prove_block(m, f, st.a, facts);\n            if added {\n                facts.truncate(base as usize);\n            }\n            prove_block(m, f, st.b, facts);\n            for k in 0..base {\n                if facts[k as usize].n < 0 {\n                    facts[k as usize].n = -facts[k as usize].n - 1;\n                }\n            }\n        }\n    }\n}\n\nfn prove_expr<A: Allocator + Copy>(m: &Module<'_, A>, f: &mut Function<'_, A>, e: i64,\n    facts: &Vec<Fact, A>) {\n    let x = f.exprs[e as usize];\n    if x.op != E_ACCESS || x.c != CK_CLAMP {\n        return;\n    }\n    let l = loaded_local(f, x.b);\n    if l < 0 {\n        return;\n    }\n    for k in 0..facts.len() as i64 {\n        if facts[k as usize].local == l && facts[k as usize].n > 0 && facts[k as usize].n <= x.d {\n            f.exprs[e as usize].c = CK_NONE;\n            return;\n        }\n    }\n");
    buf_str(out, c"}\n\n// Bench only: every check off (CK_NONE), to measure what checks cost.\npub fn insert_no_checks<A: Allocator + Copy>(m: &mut Module<'_, A>) {\n    for h in 0..m.functions.len() as i64 {\n        let mut f = mem::replace(&mut m.functions[h as usize], ir::new_function(b\"\", m.a));\n        for e in 0..f.exprs.len() as i64 {\n            if f.exprs[e as usize].op == E_ACCESS {\n                f.exprs[e as usize].c = CK_NONE;\n            }\n        }\n        m.functions[h as usize] = f;\n    }\n}\n// ---- end mod std::gpu::wgsl::bounds ----\n}\n// ---- mod std::gpu::wgsl::uniformity ----\npub mod uniformity {\n// ---- Shader compiler implementation, uniformity (0.22) ----\n// The uniformity analysis.\n\nuse crate::alloc::Allocator;\n\nuse super::front::Front;\n\n#[effects()]\npub fn check<A: Allocator + Copy>(fr: &Front<'_, A>) {\n}\n// ---- end mod std::gpu::wgsl::uniformity ----\n}\n// ---- mod std::gpu::wgsl::msl ----\npub mod msl {\n// ---- Shader compiler implementation, msl (0.22) ----\n// The MSL writer (docs/design/gpu.md §2.10): MSL 3.0 text for Metal's\n// run-time compiler, with WGSL's semantics kept where MSL's differ.\n//\n// - Layout: structs get explicit padding and `packed_` vec3 members, so\n//   every struct has WGSL's offsets and size; fixed-size arrays are\n//   wrapped in a struct (`_w_arrN { T inner[N]; }`) to be values.\n// - No undefined behaviour: signed + - * and negation go through uint;\n//   integer / and % through helpers (by zero, MIN / -1); shift amounts are\n//   masked; float to int conversions saturate; every index is clamped or,\n//   for runtime-sized arrays, guarded against the binding's size from the\n//   hidden sizes buffer (`[[buffer(30)]]`).\n// - Bindings: buffers take slots 0.. in declaration order, textures and\n//   samplers theirs; `reflect` gives the slots.\n// - Values: an expression is written where it is used, except loads,\n//   results, `let`s and those used more than once, which get a name where\n");
    buf_str(out, c"//   they are evaluated (their S_EMIT).\n\nuse crate::alloc::Allocator;\n\nuse super::ir::{\n    ACC_WRITE, AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_SUB,\n    AT_XOR, BARRIER_WORKGROUP, BIND_BUILTIN, BIND_LOCATION, BI_FRAG_DEPTH, BI_FRONT_FACING,\n    BI_GLOBAL_INVOCATION_ID, BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX,\n    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,\n    CK_CLAMP, CK_RZSW, E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY,\n    E_BITCAST, E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD,\n    E_IMAGE_QUERY, E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE,\n    E_UNARY, E_WG_UNIFORM_RESULT, E_ZERO, Function, IMG_SAMPLE_BIAS, IMG_SAMPLE_COMPARE,\n    IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, INTERP_FLAT, INTERP_LINEAR, IQ_LAYERS, IQ_LEVELS,\n    Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LT, OP_MOD, OP_MUL,\n    OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32, SK_I32, SK_U32, SP_HANDLE,\n    SP_PRIVATE, SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX,\n    S_ATOMIC, S_BARRIER, S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL,\n    S_LOOP, S_RETURN, S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, TEX_2D_ARRAY, TEX_DEPTH_2D,\n    TEX_STORAGE_2D, TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT,\n    TK_TEXTURE, TK_VECTOR, Type, UN_NEG, UN_NOT, bits_f32,\n};\n\n// The names MSL keeps for itself. Every WGSL identifier the front end\n// accepts must stay a name of its own in the MSL: Metal's run-time\n// compiler sees <metal_stdlib> and <simd/simd.h> in the global namespace\n// (macros, typedefs, keywords), and a user function `quad` is a\n// redefinition of its `quad` typedef. The writer names Metal's own\n");
    buf_str(out, c"// functions and types `metal::...`, so what can collide is exactly this\n// table plus the vector type families below (is_reserved; Wr::escape gives\n// such a name a trailing `_`). They were found by trying every identifier\n// of the Metal headers (GPUCompiler.framework's include/metal) as a\n// function, struct, member, global, local, parameter and entry point.\n// reserved_count and reserved_name list them all, and\n// tests/gpu/cases/wgsl_reserved_names.vl compiles shaders with each in\n// each of those roles through Metal. No entry ends with `_`.\nconst RESERVED: [&[u8]; 299] = [\n    // C++: keywords and alternative tokens\n    b\"alignas\", b\"alignof\", b\"and\", b\"and_eq\", b\"asm\", b\"auto\", b\"bitand\", b\"bitor\", b\"bool\",\n    b\"break\", b\"case\", b\"catch\", b\"char\", b\"char8_t\", b\"char16_t\", b\"char32_t\", b\"class\",\n    b\"co_await\", b\"co_return\", b\"co_yield\", b\"compl\", b\"concept\", b\"const\", b\"const_cast\",\n    b\"consteval\", b\"constexpr\", b\"constinit\", b\"continue\", b\"decltype\", b\"default\", b\"delete\",\n    b\"do\", b\"double\", b\"dynamic_cast\", b\"else\", b\"enum\", b\"explicit\", b\"export\", b\"extern\",\n    b\"false\", b\"final\", b\"float\", b\"for\", b\"friend\", b\"goto\", b\"if\", b\"import\", b\"inline\", b\"int\",\n    b\"long\", b\"module\", b\"mutable\", b\"namespace\", b\"new\", b\"noexcept\", b\"not\", b\"not_eq\",\n    b\"nullptr\", b\"operator\", b\"or\", b\"or_eq\", b\"override\", b\"private\", b\"protected\", b\"public\",\n    b\"register\", b\"reinterpret_cast\", b\"requires\", b\"return\", b\"short\", b\"signed\", b\"sizeof\",\n    b\"static\", b\"static_assert\", b\"static_cast\", b\"struct\", b\"switch\", b\"template\", b\"this\",\n    b\"thread_local\", b\"throw\", b\"true\", b\"try\", b\"typedef\", b\"typeid\", b\"typename\", b\"union\",\n    b\"unsigned\", b\"using\", b\"virtual\", b\"void\", b\"volatile\", b\"wchar_t\", b\"while\", b\"xor\",\n    b\"xor_eq\",\n");
    buf_str(out, c"    // MSL: keywords, address spaces, namespaces, `main`\n    b\"main\", b\"metal\", b\"simd\", b\"std\", b\"kernel\", b\"vertex\", b\"fragment\", b\"device\", b\"constant\",\n    b\"thread\", b\"threadgroup\", b\"threadgroup_imageblock\", b\"ray_data\", b\"object_data\", b\"as_type\",\n    // the headers' global typedefs outside the vector families\n    b\"size_t\", b\"ptrdiff_t\", b\"nullptr_t\", b\"max_align_t\", b\"int8_t\", b\"uint8_t\", b\"int16_t\",\n    b\"uint16_t\", b\"int32_t\", b\"uint32_t\", b\"int64_t\", b\"uint64_t\", b\"intptr_t\", b\"uintptr_t\",\n    b\"complex\", b\"imaginary\",\n    // the headers' macros (constants and function-like)\n    b\"BFLT_DECIMAL_DIG\", b\"BFLT_DIG\", b\"BFLT_EPSILON\", b\"BFLT_MANT_DIG\", b\"BFLT_MAX\",\n    b\"BFLT_MAX_10_EXP\", b\"BFLT_MAX_EXP\", b\"BFLT_MIN\", b\"BFLT_MIN_10_EXP\", b\"BFLT_MIN_EXP\",\n    b\"BFLT_RADIX\", b\"CHAR_BIT\", b\"CHAR_MAX\", b\"CHAR_MIN\", b\"DBL_DECIMAL_DIG\", b\"DBL_DIG\",\n    b\"DBL_EPSILON\", b\"DBL_MANT_DIG\", b\"DBL_MAX\", b\"DBL_MAX_10_EXP\", b\"DBL_MAX_EXP\", b\"DBL_MIN\",\n    b\"DBL_MIN_10_EXP\", b\"DBL_MIN_EXP\", b\"DBL_RADIX\", b\"FLT_DECIMAL_DIG\", b\"FLT_DIG\", b\"FLT_EPSILON\",\n    b\"FLT_MANT_DIG\", b\"FLT_MAX\", b\"FLT_MAX_10_EXP\", b\"FLT_MAX_EXP\", b\"FLT_MIN\", b\"FLT_MIN_10_EXP\",\n    b\"FLT_MIN_EXP\", b\"FLT_RADIX\", b\"FP_ILOGB0\", b\"FP_ILOGBNAN\", b\"HALF_DECIMAL_DIG\", b\"HALF_DIG\",\n    b\"HALF_EPSILON\", b\"HALF_MANT_DIG\", b\"HALF_MAX\", b\"HALF_MAX_10_EXP\", b\"HALF_MAX_EXP\",\n    b\"HALF_MIN\", b\"HALF_MIN_10_EXP\", b\"HALF_MIN_EXP\", b\"HALF_RADIX\", b\"HAS_INTERFACE\",\n    b\"HAS_INTERFACE_MDI\", b\"HUGE_VAL\", b\"HUGE_VALBF\", b\"HUGE_VALF\", b\"HUGE_VALH\", b\"INFINITY\",\n    b\"INT_MAX\", b\"INT_MIN\", b\"LLONG_MAX\", b\"LLONG_MIN\", b\"LONG_MAX\", b\"LONG_MIN\", b\"MAXBFLOAT\",\n    b\"MAXDOUBLE\", b\"MAXFLOAT\", b\"MAXHALF\", b\"METAL_ALIGN\", b\"METAL_ARG_UNIFORM\", b\"METAL_ASM\",\n");
    buf_str(out, c"    b\"METAL_CONST\", b\"METAL_CONST_ARG\", b\"METAL_DEPRECATED\", b\"METAL_ENABLE_IF\", b\"METAL_EXPLICIT\",\n    b\"METAL_FUNC\", b\"METAL_IMPLICIT\", b\"METAL_INTERNAL\", b\"METAL_MAYBE_UNDEF\",\n    b\"METAL_NON_NULL_RETURN\", b\"METAL_NOTHROW\", b\"METAL_OS_LOG_FORMAT\", b\"METAL_PURE\",\n    b\"METAL_UNAVAILABLE\", b\"METAL_VALID_COMPARE_EXCHANGE_FAILURE_ORDER\",\n    b\"METAL_VALID_COMPARE_EXCHANGE_SUCCESS_ORDER\", b\"METAL_VALID_EXCHANGE_ORDER\",\n    b\"METAL_VALID_LEVEL_ARG\", b\"METAL_VALID_LOAD_ORDER\", b\"METAL_VALID_LOD_ARG\",\n    b\"METAL_VALID_MODIFY_ORDER\", b\"METAL_VALID_RENDER_TARGET\", b\"METAL_VALID_STORE_ORDER\",\n    b\"METAL_VALIST_SIZE\", b\"METAL_VALIST_SIZE_CC\", b\"METAL_ZERO_ARG\", b\"M_1_PI\", b\"M_1_PI_BF\",\n    b\"M_1_PI_F\", b\"M_1_PI_H\", b\"M_2_PI\", b\"M_2_PI_BF\", b\"M_2_PI_F\", b\"M_2_PI_H\", b\"M_2_SQRTPI\",\n    b\"M_2_SQRTPI_BF\", b\"M_2_SQRTPI_F\", b\"M_2_SQRTPI_H\", b\"M_E\", b\"M_E_BF\", b\"M_E_F\", b\"M_E_H\",\n    b\"M_LN10\", b\"M_LN10_BF\", b\"M_LN10_F\", b\"M_LN10_H\", b\"M_LN2\", b\"M_LN2_BF\", b\"M_LN2_F\",\n    b\"M_LN2_H\", b\"M_LOG10E\", b\"M_LOG10E_BF\", b\"M_LOG10E_F\", b\"M_LOG10E_H\", b\"M_LOG2E\",\n    b\"M_LOG2E_BF\", b\"M_LOG2E_F\", b\"M_LOG2E_H\", b\"M_PI\", b\"M_PI_2\", b\"M_PI_2_BF\", b\"M_PI_2_F\",\n    b\"M_PI_2_H\", b\"M_PI_4\", b\"M_PI_4_BF\", b\"M_PI_4_F\", b\"M_PI_4_H\", b\"M_PI_BF\", b\"M_PI_F\",\n    b\"M_PI_H\", b\"M_SQRT1_2\", b\"M_SQRT1_2_BF\", b\"M_SQRT1_2_F\", b\"M_SQRT1_2_H\", b\"M_SQRT2\",\n    b\"M_SQRT2_BF\", b\"M_SQRT2_F\", b\"M_SQRT2_H\", b\"NAN\", b\"SCHAR_MAX\", b\"SCHAR_MIN\", b\"SHRT_MAX\",\n    b\"SHRT_MIN\", b\"TARGET_OS_IOS\", b\"TARGET_OS_IPHONE\", b\"TARGET_OS_LINUX\", b\"TARGET_OS_MAC\",\n    b\"TARGET_OS_MACCATALYST\", b\"TARGET_OS_OSX\", b\"TARGET_OS_SIMULATOR\", b\"TARGET_OS_TV\",\n    b\"TARGET_OS_UNIX\", b\"TARGET_OS_VISION\", b\"TARGET_OS_WATCH\", b\"TARGET_OS_WIN32\",\n");
    buf_str(out, c"    b\"TARGET_OS_WINDOWS\", b\"UCHAR_MAX\", b\"UINT_MAX\", b\"ULLONG_MAX\", b\"ULONG_MAX\", b\"USHRT_MAX\",\n    b\"assert\", b\"is_function_constant_defined\"];\n\n// The vector, matrix and packed type families, all global typedefs:\n// PREFIX BASE [N [xM]] (`float4`, `packed_half3`, `simd_float4x4`,\n// `vector_uint2`, `quad8`, `bfloat2`). Any digits count, so a family's\n// future sizes are names of it too.\nconst TYPE_PREFIXES: [&[u8]; 6] = [b\"\", b\"packed_\", b\"simd_\", b\"simd_packed_\", b\"vector_\",\n    b\"matrix_\"];\nconst TYPE_BASES: [&[u8]; 16] = [\n    b\"bool\", b\"char\", b\"uchar\", b\"short\", b\"ushort\", b\"int\", b\"uint\", b\"long\", b\"ulong\", b\"llong\",\n    b\"ullong\", b\"half\", b\"float\", b\"double\", b\"quad\", b\"bfloat\"];\n// The sizes reserved_names lists for each family (N, and NxM for 2..4).\nconst TYPE_SIZES: [&[u8]; 15] = [\n    b\"\", b\"2\", b\"3\", b\"4\", b\"8\", b\"16\", b\"2x2\", b\"2x3\", b\"2x4\", b\"3x2\", b\"3x3\", b\"3x4\", b\"4x2\",\n    b\"4x3\", b\"4x4\"];\n\nconst MATH_NAMES: [&[u8]; 39] = [\n    b\"abs\", b\"min\", b\"max\", b\"clamp\", b\"sign\", b\"floor\", b\"ceil\", b\"rint\", b\"fract\", b\"trunc\",\n    b\"sqrt\", b\"rsqrt\", b\"exp\", b\"exp2\", b\"log\", b\"log2\", b\"pow\", b\"sin\", b\"cos\", b\"tan\", b\"asin\",\n    b\"acos\", b\"atan\", b\"atan2\", b\"sinh\", b\"cosh\", b\"tanh\", b\"mix\", b\"step\", b\"smoothstep\", b\"fma\",\n    b\"length\", b\"distance\", b\"dot\", b\"cross\", b\"normalize\", b\"reflect\", b\"determinant\",\n    b\"transpose\"];\n\n// Where the resources are bound. Per stage (vertex, fragment, compute),\n// buffers, textures and samplers each take slots from 0 in (group,\n// binding) order over the bindings the stage's entry points use; the\n// Metal hal binds what the reflection says. The sizes buffer (the byte\n// sizes of the runtime-sized storage buffers, for bounds checks) takes the\n// stage's next buffer slot; it has one u32 per runtime-sized storage\n");
    buf_str(out, c"// binding of the module, in (group, binding) order.\npub struct Slots<A: Allocator> {\n    // slot[stage * globals + g], or -1\n    slot: Vec<i64, A>,\n    // per global: its index in the sizes buffer, or -1\n    size_index: Vec<i64, A>,\n    sizes_count: i64,\n    // per stage: the sizes buffer's slot, or -1 when the stage needs none\n    sizes_slot: [i64; 3],\n}\n\n// The globals in (group, binding) order (the others after, as declared).\npub fn binding_order<A: Allocator + Copy>(m: &Module<'_, A>, a: A) -> Vec<i64, A> {\n    let mut order: Vec<i64, A> = Vec::new_in(a);\n    for g in 0..m.globals.len() as i64 {\n        order.push(g);\n    }\n    // an insertion sort: modules have few bindings\n    for i in 1..order.len() as i64 {\n        let mut j = i;\n        while j > 0 && binding_key(m, order[(j - 1) as usize]) > binding_key(m, order[j as usize]) {\n            order.swap(j as usize - 1, j as usize);\n            j -= 1;\n        }\n    }\n    order\n}\n\nfn binding_key<A: Allocator + Copy>(m: &Module<'_, A>, g: i64) -> i64 {\n    let gl = m.globals[g as usize];\n    if gl.group < 0 {\n        return 9223372036854775807 - (m.globals.len() as i64 - g);\n    }\n    gl.group * 1048576 + gl.binding\n}\n\npub fn slots<'a,\n    A: Allocator + Copy>(m: &'a Module<'_, A>, uses: &'a Vec<Vec<bool, A>, A>, a: A) -> Slots<A> {\n    let ng = m.globals.len() as i64;\n    let mut s = Slots {\n        slot: Vec::from_elem_in(-1i64, (3 * ng as usize), a),\n        size_index: Vec::from_elem_in(-1i64, (ng as usize), a),\n        sizes_count: 0,\n        sizes_slot: [-1, -1, -1],\n    };\n    let order = binding_order(m, a);\n    for k in 0..order.len() as i64 {\n        let g = order[k as usize];\n        if m.globals[g as usize].space == SP_STORAGE\n            && m.is_runtime_sized(m.globals[g as usize].ty) {\n            s.size_index[g as usize] = s.sizes_count;\n            s.sizes_count += 1;\n        }\n    }\n    for st in 0..3 {\n");
    buf_str(out, c"        let mut visible: Vec<bool, A> = Vec::from_elem_in(false, (ng as usize), a);\n        for e in 0..m.entries.len() as i64 {\n            if m.entries[e as usize].stage as i64 == st {\n                let h = m.entries[e as usize].func;\n                for g in 0..ng {\n                    if uses[h as usize][g as usize] {\n                        visible[g as usize] = true;\n                    }\n                }\n            }\n        }\n        let mut nb: i64 = 0;\n        let mut nt: i64 = 0;\n        let mut ns: i64 = 0;\n        let mut sized = false;\n        for k in 0..order.len() as i64 {\n            let g = order[k as usize];\n            if !visible[g as usize] {\n                continue;\n            }\n            let gl = m.globals[g as usize];\n            let kind = m.types[gl.ty as usize].kind;\n            if gl.space == SP_UNIFORM || gl.space == SP_STORAGE {\n                s.slot[(st * ng + g) as usize] = nb;\n                nb += 1;\n                if s.size_index[g as usize] >= 0 {\n                    sized = true;\n                }\n            } else if kind == TK_TEXTURE {\n                s.slot[(st * ng + g) as usize] = nt;\n                nt += 1;\n            } else if kind == TK_SAMPLER {\n                s.slot[(st * ng + g) as usize] = ns;\n                ns += 1;\n            }\n        }\n        if sized {\n            s.sizes_slot[st as usize] = nb;\n        }\n    }\n    s\n}\n\n// A name the writer made: text in its pool (Wr.pool).\n#[derive(Clone, Copy)]\nstruct Nm { start: i64, len: i64 }\n\nfn nm<A: Allocator + Copy>(pool: &Vec<u8, A>, n: Nm) -> &[u8] { &pool.as_slice()[\n    n.start as usize..(n.start + n.len) as usize] }\n\n// Appends s's bytes. (A Buf<ScopedArena> holds a view, of its arena, so\n// the checker takes `dst.push_str(local.as_slice())` into a field as\n// keeping a view of `local`; bytes pushed one by one are plain values.)\n");
    buf_str(out, c"fn copy_into<A: Allocator + Copy>(dst: &mut Vec<u8, A>, s: &[u8]) {\n    for i in 0..s.len() as i64 {\n        dst.push(s[i as usize]);\n    }\n}\n\nstruct Wr<A: Allocator> {\n    a: A,\n    out: Vec<u8, A>,\n    // the text of every name the writer made\n    pool: Vec<u8, A>,\n    // the types' MSL names, made on first use\n    tname: Vec<Nm, A>,\n    tdone: Vec<bool, A>,\n    types_out: Vec<u8, A>,\n    // helpers used\n    need_div: bool,\n    need_f2i: bool,\n    need_sign: bool,\n    need_flb: bool,\n    need_ftb: bool,\n    need_cmpxchg: Vec<Nm, A>,\n    sl: Slots<A>,\n    // per function: the globals it uses (directly or through calls)\n    uses: Vec<Vec<bool, A>, A>,\n    fnames: Vec<Nm, A>,\n    gnames: Vec<Nm, A>,\n    // the function being written\n    fh: i64,\n    refc: Vec<i64, A>,\n    baked: Vec<bool, A>,\n    // a name per local, parameter and baked expression of the function\n    lnames: Vec<Nm, A>,\n    enames: Vec<Nm, A>,\n    used: Vec<Nm, A>,\n    indent: i64,\n    loop_n: i64,\n    // entry points: the stage being written (255: a plain function), and\n    // its output struct's name\n    stage: i64,\n    out_name: Nm,\n    ret_ty: i64,\n    // each type's kind\n    kinds: Vec<u8, A>,\n    snames: Vec<Nm, A>,\n    spans: Vec<i64, A>,\n}\n\n// Whether s is a name MSL keeps for itself: in RESERVED or of a type\n// family.\npub fn is_reserved(s: &[u8]) -> bool {\n    for i in 0..RESERVED.len() {\n        if RESERVED[i] == s {\n            return true;\n        }\n    }\n    is_type_family(s)\n}\n\n// PREFIX BASE, then nothing or digits, optionally `x` and digits.\nfn is_type_family(s: &[u8]) -> bool {\n    for p in 0..TYPE_PREFIXES.len() {\n        let pre = TYPE_PREFIXES[p];\n        if s.len() as i64 < pre.len() as i64 || &s[0..pre.len() as i64 as usize] != pre {\n            continue;\n        }\n        let rest = &s[pre.len() as i64 as usize..];\n        for b in 0..TYPE_BASES.len() {\n            let base = TYPE_BASES[b];\n");
    buf_str(out, c"            if rest.len() as i64 >= base.len() as i64 && rest[0..base.len() as i64 as usize] == base\n                && is_type_size(&rest[base.len() as i64 as usize..]) {\n                return true;\n            }\n        }\n    }\n    false\n}\n\nfn is_type_size(s: &[u8]) -> bool {\n    let mut i: i64 = 0;\n    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {\n        i += 1;\n    }\n    if i == s.len() as i64 {\n        return true;\n    }\n    if i == 0 || s[i as usize] != b'x' || i + 1 == s.len() as i64 {\n        return false;\n    }\n    i += 1;\n    while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' {\n        i += 1;\n    }\n    i == s.len() as i64\n}\n\n// The names of RESERVED and of the type families (with the sizes of\n// TYPE_SIZES), by index: what tests/gpu/cases/wgsl_reserved_names.vl\n// compiles. reserved_name(i, &out) puts the i-th in out.\npub fn reserved_count() -> i64 {\n    (RESERVED.len() + TYPE_PREFIXES.len() * TYPE_BASES.len() * TYPE_SIZES.len()) as i64\n}\n\n// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form\n// is std's own until 0.27.\npub fn reserved_name<A: Allocator>(i: i64, out: &mut String<A>) {\n    let mut b = Vec::<u8, _>::new_in(*out.allocator());\n    reserved_name_buf(i, &mut b);\n    out.clear();\n    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());\n    out.push_str(t.as_str());\n}\n\npub(crate) fn reserved_name_buf<A: Allocator>(i: i64, out: &mut Vec<u8, A>) {\n    out.clear();\n    if i < RESERVED.len() as i64 {\n        out.extend_from_slice(RESERVED[i as usize]);\n        return;\n    }\n    let k = i as usize - RESERVED.len();\n    let z = k % TYPE_SIZES.len();\n    let b = k / TYPE_SIZES.len() % TYPE_BASES.len();\n    let p = k / (TYPE_SIZES.len() * TYPE_BASES.len());\n    out.extend_from_slice(TYPE_PREFIXES[p]);\n    out.extend_from_slice(TYPE_BASES[b]);\n    out.extend_from_slice(TYPE_SIZES[z]);\n}\n\n");
    buf_str(out, c"impl<A: Allocator + Copy> Wr<A> {\n    fn p(&mut self, s: &[u8]) { self.out.extend_from_slice(s); }\n\n    // A pooled name into the output.\n    fn pn(&mut self, n: Nm) { self.out.extend_from_slice(nm(&self.pool, n)); }\n\n    // A type's name into the output.\n    fn pty(&mut self, m: &Module<'_, A>, t: i64) {\n        let n = self.ty(m, t);\n        self.pn(n);\n    }\n\n    fn s(&self, n: Nm) -> &[u8] { nm(&self.pool, n) }\n\n    // Text into the pool: a name.\n    fn intern(&mut self, s: &[u8]) -> Nm {\n        let st = self.pool.len() as i64;\n        copy_into(&mut self.pool, s);\n        Nm { start: st, len: s.len() as i64 }\n    }\n\n    // The pool's text from `st` on, as a name.\n    fn since(&self, st: i64) -> Nm { Nm { start: st, len: self.pool.len() as i64 - st } }\n\n    fn line(&mut self) {\n        self.out.push(b'\\n');\n        for _ in 0..self.indent {\n            self.out.extend_from_slice(b\"    \");\n        }\n    }\n\n    // A WGSL identifier as an MSL one. A name that is reserved\n    // (is_reserved), starts with `_` or ends with `_` gets a trailing `_`,\n    // and a `u` in front when it starts with `_` or `u..._` (`_x` is\n    // `u_x_`, `u_x_` is `uu_x__`); every other name is itself. So the map\n    // is one to one, never gives a reserved name (none ends with `_`) and\n    // never one starting with `_` (the writer's own names do).\n    fn escape(&mut self, s: &[u8]) -> Nm {\n        if s.len() as i64 == 0 {\n            return self.intern(b\"_w_t\");\n        }\n        let st = self.pool.len() as i64;\n        if s[0] != b'_' && s[(s.len() as i64 - 1) as usize] != b'_' && !is_reserved(s) {\n            copy_into(&mut self.pool, s);\n            return self.since(st);\n        }\n        let mut i: i64 = 0;\n        while i < s.len() as i64 && s[i as usize] == b'u' {\n            i += 1;\n        }\n        if i < s.len() as i64 && s[i as usize] == b'_' {\n            self.pool.push(b'u');\n        }\n");
    buf_str(out, c"        copy_into(&mut self.pool, s);\n        self.pool.push(b'_');\n        self.since(st)\n    }\n\n    fn is_used(&self, n: Nm) -> bool {\n        let t = nm(&self.pool, n);\n        for i in 0..self.used.len() as i64 {\n            if nm(&self.pool, self.used[i as usize]) == t {\n                return true;\n            }\n        }\n        false\n    }\n\n    // A name unique in the function being written.\n    fn unique(&mut self, base: &[u8]) -> Nm {\n        let n = self.escape(base);\n        if !self.is_used(n) {\n            self.used.push(n);\n            return n;\n        }\n        let mut k: i64 = 1;\n        loop {\n            let st = self.pool.len() as i64;\n            let mut i: i64 = 0;\n            while i < n.len {\n                let c = self.pool.as_slice()[(n.start + i) as usize];\n                self.pool.push(c);\n                i += 1;\n            }\n            write(self.pool, \"_{k}\").unwrap();\n            let t = self.since(st);\n            if !self.is_used(t) {\n                self.used.push(t);\n                return t;\n            }\n            k += 1;\n        }\n    }\n\n    // ---- Types ----\n\n    fn scalar(sk: u8) -> &'static [u8] {\n        if sk == SK_BOOL {\n            b\"bool\"\n        } else if sk == SK_I32 {\n            b\"int\"\n        } else if sk == SK_U32 {\n            b\"uint\"\n        } else {\n            b\"float\"\n        }\n    }\n\n    // The MSL name of type t (declaring structs and array wrappers once).\n    fn ty(&mut self, m: &Module<'_, A>, t: i64) -> Nm {\n        if self.tdone[t as usize] {\n            return self.tname[t as usize];\n        }\n        let ty = m.types[t as usize];\n        let mut n = Nm { start: 0, len: 0 };\n        if ty.kind == TK_SCALAR {\n            n = self.intern(Wr::<A>::scalar(ty.scalar));\n        } else if ty.kind == TK_VECTOR {\n            let st = self.pool.len() as i64;\n");
    buf_str(out, c"            write(self.pool, \"metal::{}{}\", str::from_utf8(Wr::<A>::scalar(ty.scalar)).unwrap(),\n                ty.n).unwrap();\n            n = self.since(st);\n        } else if ty.kind == TK_MATRIX {\n            let st = self.pool.len() as i64;\n            write(self.pool, \"metal::float{}x{}\", ty.n, ty.m).unwrap();\n            n = self.since(st);\n        } else if ty.kind == TK_ATOMIC {\n            n = self.intern(if ty.scalar == SK_I32 { b\"metal::atomic_int\" }\n                else { b\"metal::atomic_uint\" });\n        } else if ty.kind == TK_ARRAY {\n            let el = self.ty(m, ty.base);\n            let st = self.pool.len() as i64;\n            write(self.pool, \"_w_arr{t}\").unwrap();\n            n = self.since(st);\n            if ty.n > 0 {\n                write(self.types_out, \"struct _w_arr{t} {{\\n    {} inner[{}];\\n}};\\n\",\n                    str::from_utf8(nm(&self.pool, el)).unwrap(), ty.n).unwrap();\n            }\n        } else if ty.kind == TK_STRUCT {\n            n = self.escape(ty.name);\n            self.struct_def(m, t, n);\n        } else if ty.kind == TK_TEXTURE {\n            let sc = Wr::<A>::scalar(ty.scalar);\n            let st = self.pool.len() as i64;\n            if ty.n == TEX_DEPTH_2D {\n                self.pool.extend_from_slice(b\"metal::depth2d<float, metal::access::sample>\");\n            } else if ty.n == TEX_2D_ARRAY {\n                { let sc = str::from_utf8(sc).unwrap();\n                    write(self.pool, \"metal::texture2d_array<{sc}, metal::access::sample>\").unwrap() };\n            } else if ty.n == TEX_STORAGE_2D {\n                { let sc = str::from_utf8(sc).unwrap();\n                    write(self.pool, \"metal::texture2d<{sc}, metal::access::write>\").unwrap() };\n            } else {\n                { let sc = str::from_utf8(sc).unwrap();\n                    write(self.pool, \"metal::texture2d<{sc}, metal::access::sample>\").unwrap() };\n            }\n");
    buf_str(out, c"            n = self.since(st);\n        } else if ty.kind == TK_SAMPLER {\n            n = self.intern(b\"metal::sampler\");\n        } else {\n            n = self.intern(b\"void\");\n        }\n        self.tname[t as usize] = n;\n        self.tdone[t as usize] = true;\n        n\n    }\n\n    // A member's MSL type: vec3 members are packed (12 bytes, as WGSL's).\n    fn member_ty(&mut self, m: &Module<'_, A>, t: i64) -> Nm {\n        let ty = m.types[t as usize];\n        if ty.kind == TK_VECTOR && ty.n == 3 {\n            let st = self.pool.len() as i64;\n            write(self.pool, \"metal::packed_{}3\",\n                str::from_utf8(Wr::<A>::scalar(ty.scalar)).unwrap()).unwrap();\n            return self.since(st);\n        }\n        if ty.kind == TK_ARRAY && ty.n == 0 {\n            return self.ty(m, ty.base);\n        }\n        self.ty(m, t)\n    }\n\n    fn struct_def(&mut self, m: &Module<'_, A>, t: i64, name: Nm) {\n        let ty = m.types[t as usize];\n        // member types first: they must be declared before\n        for i in ty.mstart..ty.mstart + ty.mcount {\n            self.member_ty(m, m.members[i as usize].ty);\n        }\n        let mut b = Vec::<u8, _>::new_in(self.a);\n        write(b, \"struct {} {{\\n\", str::from_utf8(nm(&self.pool, name)).unwrap()).unwrap();\n        let mut off: i64 = 0;\n        let mut pad: i64 = 0;\n        for i in ty.mstart..ty.mstart + ty.mcount {\n            let mem = m.members[i as usize];\n            if mem.offset > off {\n                write(b, \"    char _pad{pad}[{}];\\n\", mem.offset - off).unwrap();\n                pad += 1;\n            }\n            let mt = m.types[mem.ty as usize];\n            let mty = self.member_ty(m, mem.ty);\n            let mn = self.escape(mem.name);\n            if mt.kind == TK_ARRAY && mt.n == 0 {\n                write(b, \"    {} {}[1];\\n\", str::from_utf8(nm(&self.pool, mty)).unwrap(),\n");
    buf_str(out, c"                    str::from_utf8(nm(&self.pool, mn)).unwrap()).unwrap();\n                off = mem.offset + mt.stride;\n            } else {\n                write(b, \"    {} {};\\n\", str::from_utf8(nm(&self.pool, mty)).unwrap(),\n                    str::from_utf8(nm(&self.pool, mn)).unwrap()).unwrap();\n                off = mem.offset + mt.size;\n            }\n        }\n        if ty.size > off\n            && !(ty.mcount > 0\n                && m.is_runtime_sized(m.members[(ty.mstart + ty.mcount - 1) as usize].ty)) {\n            write(b, \"    char _pad{pad}[{}];\\n\", ty.size - off).unwrap();\n        }\n        b.extend_from_slice(b\"};\\n\");\n        copy_into(&mut self.types_out, b.as_slice());\n    }\n\n    // The padding members before member k of struct t (for aggregate\n    // initialization), and after the last.\n    fn pads_before(m: &Module<'_, A>, t: i64, k: i64) -> bool {\n        let ty = m.types[t as usize];\n        let mem = m.members[(ty.mstart + k) as usize];\n        if k == 0 {\n            return mem.offset > 0;\n        }\n        let prev = m.members[(ty.mstart + k - 1) as usize];\n        mem.offset > prev.offset + m.types[prev.ty as usize].size\n    }\n\n    fn space(sp: u8, access: u8) -> &'static [u8] {\n        if sp == SP_STORAGE {\n            if access & ACC_WRITE != 0 { b\"device\" } else { b\"const device\" }\n        } else if sp == SP_UNIFORM {\n            b\"constant\"\n        } else if sp == SP_WORKGROUP {\n            b\"threadgroup\"\n        } else {\n            b\"thread\"\n        }\n    }\n}\n\n// ---- Shader compiler implementation, msl: Analysis (0.22) ----\n\nfn calls_of<A: Allocator + Copy>(f: &Function<'_, A>, list: &mut Vec<i64, A>) {\n    for s in 0..f.stmts.len() as i64 {\n        if f.stmts[s as usize].op == S_CALL {\n            list.push(f.stmts[s as usize].a);\n        }\n    }\n}\n\n// Functions in an order where each comes after those it calls.\n");
    buf_str(out, c"pub fn call_order<A: Allocator + Copy>(m: &Module<'_, A>, a: A) -> Vec<i64, A> {\n    let n = m.functions.len() as i64;\n    let mut state: Vec<u8, A> = Vec::from_elem_in(0u8, (n as usize), a);\n    let mut order: Vec<i64, A> = Vec::new_in(a);\n    for i in 0..n {\n        visit(m, i, &mut state, &mut order, a);\n    }\n    order\n}\n\nfn visit<A: Allocator + Copy>(m: &Module<'_, A>, i: i64, state: &mut Vec<u8, A>,\n    order: &mut Vec<i64, A>, a: A) {\n    if state[i as usize] != 0 {\n        return;\n    }\n    state[i as usize] = 1;\n    let mut cs: Vec<i64, A> = Vec::new_in(a);\n    calls_of(&m.functions[i as usize], &mut cs);\n    for k in 0..cs.len() as i64 {\n        visit(m, cs[k as usize], state, order, a);\n    }\n    order.push(i);\n}\n\n// Which globals each function uses, through its calls too (order: callees first).\npub fn global_uses<A: Allocator + Copy>(m: &Module<'_, A>, order: &Vec<i64, A>, a: A) -> Vec<Vec<bool, A>, A> {\n    let ng = m.globals.len() as i64;\n    let mut uses: Vec<Vec<bool, A>, A> = Vec::new_in(a);\n    for _ in 0..m.functions.len() as i64 {\n        uses.push(Vec::from_elem_in(false, (ng as usize), a));\n    }\n    for oi in 0..order.len() as i64 {\n        let h = order[oi as usize];\n        let f = &m.functions[h as usize];\n        for e in 0..f.exprs.len() as i64 {\n            if f.exprs[e as usize].op == E_GLOBAL || f.exprs[e as usize].op == E_ARRAY_LENGTH {\n                uses[h as usize][f.exprs[e as usize].a as usize] = true;\n            }\n        }\n        for s in 0..f.stmts.len() as i64 {\n            if f.stmts[s as usize].op == S_CALL {\n                let callee = f.stmts[s as usize].a;\n                for g in 0..ng {\n                    if uses[callee as usize][g as usize] {\n                        uses[h as usize][g as usize] = true;\n                    }\n                }\n            }\n        }\n    }\n    uses\n}\n\n// Whether function h needs the sizes buffer (a runtime-sized array it or a\n");
    buf_str(out, c"// callee reads).\nfn needs_sizes<A: Allocator + Copy>(w: &Wr<A>, m: &Module<'_, A>, h: i64) -> bool {\n    for g in 0..m.globals.len() as i64 {\n        if w.uses[h as usize][g as usize] && w.sl.size_index[g as usize] >= 0 {\n            return true;\n        }\n    }\n    false\n}\n\n// The module as MSL; the reflection's Metal names and slots too.\npub(crate) fn write_module<A: Allocator + Copy>(m: &Module<'_, A>, a: A, out: &mut Vec<u8, Gpa>,\n    refl: &mut api::Reflection<Gpa>) {\n    let mut w = new_writer(m, a);\n    let order = call_order(m, a);\n    w.uses = global_uses(m, &order, a);\n    w.sl = slots(m, &w.uses, a);\n    for oi in 0..order.len() as i64 {\n        let h = order[oi as usize];\n        let mut is_entry = false;\n        for e in 0..m.entries.len() as i64 {\n            if m.entries[e as usize].func == h {\n                is_entry = true;\n            }\n        }\n        if !is_entry {\n            write_fn(&mut w, m, h);\n        }\n    }\n    for e in 0..m.entries.len() as i64 {\n        write_entry(&mut w, m, e);\n    }\n    let base = out.len() as i64;\n    finish(&w, out);\n    // where each function starts in the MSL (its 1-based line), for\n    // Metal's messages (api::target_error); w.out is the text's end\n    let text = out.as_slice();\n    let body = text.len() as i64 - w.out.len() as i64;\n    refl.lines.clear();\n    let mut line: i64 = 1;\n    let mut at = base;\n    let mut k: i64 = 0;\n    while k < w.spans.len() as i64 {\n        let to = body + w.spans[k as usize];\n        while at < to {\n            if text[at as usize] == b'\\n' {\n                line += 1;\n            }\n            at += 1;\n        }\n        // (the function's text starts with an empty line)\n        refl.lines.push(api::SourceLine {\n            msl_line: line + 1, pos: m.functions[w.spans[(k + 1) as usize] as usize].pos,\n        });\n        k += 2;\n    }\n    // the Metal side of the reflection\n    for e in 0..refl.entries.len() as i64 {\n");
    buf_str(out, c"        refl.entries[e as usize].target_name.clear();\n        refl.entries[e as usize].target_name.extend_from_slice(nm(&w.pool,\n            w.fnames[m.entries[e as usize].func as usize]));\n        refl.entries[e as usize].sizes_slot = w.sl.sizes_slot[\n            m.entries[e as usize].stage as i64 as usize];\n    }\n    let ng = m.globals.len() as i64;\n    for b in 0..refl.bindings.len() as i64 {\n        let g = refl.bindings[b as usize].global;\n        for st in 0..3 {\n            refl.bindings[b as usize].slots[st as usize] = w.sl.slot[(st * ng + g) as usize];\n        }\n    }\n}\n\nfn new_writer<'a, A: Allocator + Copy>(m: &'a Module<'_, A>, a: A) -> Wr<A> {\n    let mut w = Wr {\n        a: a,\n        out: Vec::<u8, _>::with_capacity_in(16384usize, a),\n        tname: Vec::new_in(a),\n        tdone: Vec::new_in(a),\n        types_out: Vec::<u8, _>::new_in(a),\n        need_div: false,\n        need_f2i: false,\n        need_sign: false,\n        need_flb: false,\n        need_ftb: false,\n        need_cmpxchg: Vec::new_in(a),\n        sl: Slots {\n            slot: Vec::new_in(a), size_index: Vec::new_in(a), sizes_count: 0,\n            sizes_slot: [-1, -1, -1],\n        },\n        uses: Vec::new_in(a),\n        fnames: Vec::new_in(a),\n        gnames: Vec::new_in(a),\n        fh: -1,\n        refc: Vec::new_in(a),\n        baked: Vec::new_in(a),\n        lnames: Vec::new_in(a),\n        enames: Vec::new_in(a),\n        used: Vec::new_in(a),\n        indent: 0,\n        loop_n: 0,\n        stage: 255,\n        out_name: Nm { start: 0, len: 0 },\n        pool: Vec::<u8, _>::with_capacity_in(4096usize, a),\n        ret_ty: -1,\n        kinds: Vec::new_in(a),\n        snames: Vec::new_in(a),\n        spans: Vec::new_in(a),\n    };\n    for t in 0..m.types.len() as i64 {\n        w.tname.push(Nm { start: 0, len: 0 });\n        w.tdone.push(false);\n        w.kinds.push(m.types[t as usize].kind);\n    }\n");
    buf_str(out, c"    // module-scope names: structs, functions and globals, unique among\n    // themselves (escape is one to one, and WGSL names them in one scope)\n    for t in 0..m.types.len() as i64 {\n        if m.types[t as usize].kind == TK_STRUCT {\n            let n = w.escape(m.types[t as usize].name);\n            w.used.push(n);\n            w.snames.push(n);\n        }\n    }\n    for h in 0..m.functions.len() as i64 {\n        let n = w.unique(m.functions[h as usize].name);\n        w.fnames.push(n);\n    }\n    for g in 0..m.globals.len() as i64 {\n        let n = w.unique(m.globals[g as usize].name);\n        w.gnames.push(n);\n    }\n    w\n}\n\nfn helpers<B: Allocator, A: Allocator + Copy>(w: &Wr<A>, out: &mut Vec<u8, B>) {\n    if w.need_div {\n        out.extend_from_slice(b\"static inline int _w_div(int a, int b) { return a / metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); }\\n\");\n        out.extend_from_slice(b\"static inline uint _w_div(uint a, uint b) { return a / metal::select(b, 1u, b == 0u); }\\n\");\n        out.extend_from_slice(b\"static inline int _w_mod(int a, int b) { int c = metal::select(b, 1, b == 0 || (a == (-2147483647 - 1) && b == -1)); return a - (a / c) * c; }\\n\");\n        out.extend_from_slice(b\"static inline uint _w_mod(uint a, uint b) { return metal::select(a % metal::select(b, 1u, b == 0u), 0u, b == 0u); }\\n\");\n        for n in 2..5 {\n            for k in 0..2 {\n                let t = if k == 0 { \"int\" } else { \"uint\" };\n                write(out, \"static inline metal::{t}{n} _w_div(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_div(a[i], b[i]); return r; }}\\n\").unwrap();\n                write(out, \"static inline metal::{t}{n} _w_mod(metal::{t}{n} a, metal::{t}{n} b) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_mod(a[i], b[i]); return r; }}\\n\").unwrap();\n            }\n        }\n    }\n    if w.need_f2i {\n");
    buf_str(out, c"        out.extend_from_slice(b\"static inline int _w_f2i(float x) { return metal::isnan(x) ? 0 : int(metal::clamp(x, -2147483648.0f, 2147483520.0f)); }\\n\");\n        out.extend_from_slice(b\"static inline uint _w_f2u(float x) { return metal::isnan(x) ? 0u : uint(metal::clamp(x, 0.0f, 4294967040.0f)); }\\n\");\n        for n in 2..5 {\n            write(out, \"static inline metal::int{n} _w_f2i(metal::float{n} x) {{ metal::int{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2i(x[i]); return r; }}\\n\").unwrap();\n            write(out, \"static inline metal::uint{n} _w_f2u(metal::float{n} x) {{ metal::uint{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_f2u(x[i]); return r; }}\\n\").unwrap();\n        }\n    }\n    if w.need_sign {\n        out.extend_from_slice(b\"template <typename T> static inline T _w_isign(T x) { return metal::select(metal::select(T(0), T(-1), x < T(0)), T(1), x > T(0)); }\\n\");\n    }\n    if w.need_flb {\n        out.extend_from_slice(b\"static inline uint _w_flb(uint x) { return metal::select(31u - metal::clz(x), 4294967295u, x == 0u); }\\n\");\n        out.extend_from_slice(b\"static inline int _w_flb(int x) { uint y = as_type<uint>(metal::select(x, ~x, x < 0)); return as_type<int>(metal::select(31u - metal::clz(y), 4294967295u, y == 0u)); }\\n\");\n        for n in 2..5 {\n            for k in 0..2 {\n                let t = if k == 0 { \"int\" } else { \"uint\" };\n                write(out, \"static inline metal::{t}{n} _w_flb(metal::{t}{n} x) {{ metal::{t}{n} r; for (int i = 0; i < {n}; i++) r[i] = _w_flb(x[i]); return r; }}\\n\").unwrap();\n            }\n        }\n    }\n    if w.need_ftb {\n        out.extend_from_slice(b\"template <typename T> static inline T _w_ftb(T x) { return metal::select(metal::ctz(x), T(4294967295u), x == T(0)); }\\n\");\n    }\n    for i in 0..w.need_cmpxchg.len() as i64 {\n        out.extend_from_slice(w.s(w.need_cmpxchg[i as usize]));\n    }\n}\n\n");
    buf_str(out, c"fn finish<A: Allocator + Copy>(w: &Wr<A>, out: &mut Vec<u8, Gpa>) {\n    out.extend_from_slice(\n        b\"// Generated by wgslc (MSL 3.0).\\n#include <metal_stdlib>\\n#include <simd/simd.h>\\n\\n\");\n    helpers(w, out);\n    out.push(b'\\n');\n    out.extend_from_slice(w.types_out.as_slice());\n    out.extend_from_slice(w.out.as_slice());\n}\n\n// ---- Shader compiler implementation, msl: Functions (0.22) ----\n\nfn count_refs<A: Allocator + Copy>(w: &mut Wr<A>, f: &Function<'_, A>) {\n    w.refc.clear();\n    w.baked.clear();\n    for _ in 0..f.exprs.len() as i64 {\n        w.refc.push(0);\n        w.baked.push(false);\n    }\n    for e in 0..f.exprs.len() as i64 {\n        let x = f.exprs[e as usize];\n        let op = x.op;\n        if op == E_ACCESS || op == E_BINARY {\n            if op == E_ACCESS {\n                w.refc[x.a as usize] += 1;\n                w.refc[x.b as usize] += 1;\n            } else {\n                w.refc[x.b as usize] += 1;\n                w.refc[x.c as usize] += 1;\n            }\n        }\n        else if op == E_ACCESS_INDEX || op == E_SPLAT || op == E_SWIZZLE || op == E_LOAD\n            || op == E_CONVERT || op == E_BITCAST {\n            w.refc[x.a as usize] += 1;\n        } else if op == E_UNARY || op == E_DERIVATIVE {\n            w.refc[x.b as usize] += 1;\n        } else if op == E_SELECT {\n            w.refc[x.a as usize] += 1;\n            w.refc[x.b as usize] += 1;\n            w.refc[x.c as usize] += 1;\n        } else if op == E_COMPOSE {\n            for k in x.a..x.a + x.b {\n                w.refc[f.args[k as usize] as usize] += 1;\n            }\n        } else if op == E_MATH {\n            for k in x.b..x.b + x.c {\n                w.refc[f.args[k as usize] as usize] += 1;\n            }\n        } else if op == E_IMAGE_SAMPLE {\n            for k in x.c..x.c + (x.d >> 8) {\n                w.refc[f.args[k as usize] as usize] += 1;\n            }\n        } else if op == E_IMAGE_LOAD {\n");
    buf_str(out, c"            for k in x.c..x.c + x.d {\n                w.refc[f.args[k as usize] as usize] += 1;\n            }\n        } else if op == E_IMAGE_QUERY {\n            if x.c >= 0 {\n                w.refc[x.c as usize] += 1;\n            }\n        }\n    }\n    for s in 0..f.stmts.len() as i64 {\n        let st = f.stmts[s as usize];\n        if st.op == S_IF || st.op == S_SWITCH {\n            w.refc[st.a as usize] += 1;\n        } else if st.op == S_STORE {\n            w.refc[st.a as usize] += 1;\n            w.refc[st.b as usize] += 1;\n        } else if st.op == S_RETURN && st.a >= 0 {\n            w.refc[st.a as usize] += 1;\n        } else if st.op == S_LOOP && st.c >= 0 {\n            w.refc[st.c as usize] += 1;\n        } else if st.op == S_CALL {\n            for k in st.b..st.b + st.c {\n                w.refc[f.args[k as usize] as usize] += 1;\n            }\n        } else if st.op == S_ATOMIC {\n            if st.c >= 0 {\n                w.refc[st.c as usize] += 1;\n            }\n            if st.e >= 0 {\n                w.refc[st.e as usize] += 1;\n            }\n        } else if st.op == S_IMAGE_STORE {\n            w.refc[st.b as usize] += 1;\n            w.refc[st.c as usize] += 1;\n            if st.d >= 0 {\n                w.refc[st.d as usize] += 1;\n            }\n        }\n    }\n    for e in 0..f.exprs.len() as i64 {\n        let x = f.exprs[e as usize];\n        let op = x.op;\n        let leaf = op == E_LITERAL || op == E_ARG || op == E_GLOBAL || op == E_LOCAL\n            || op == E_CALL_RESULT || op == E_ATOMIC_RESULT || op == E_WG_UNIFORM_RESULT;\n        if leaf {\n            continue;\n        }\n        let k = w.kinds[f.exprs[e as usize].ty as usize];\n        if k == TK_POINTER {\n            continue;\n        }\n        if op == E_LOAD || op == E_IMAGE_SAMPLE || op == E_IMAGE_LOAD || op == E_DERIVATIVE\n            || w.refc[e as usize] > 1 || f.names[e as usize].len() as i64 > 0 {\n            w.baked[e as usize] = true;\n");
    buf_str(out, c"        }\n    }\n}\n\n// ---- Shader compiler implementation, msl: Expressions (0.22) ----\n\nimpl<A: Allocator + Copy> Wr<A> {\n    fn lit(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        let sk = m.types[x.ty as usize].scalar;\n        if sk == SK_BOOL {\n            self.p(if x.a != 0 { b\"true\" } else { b\"false\" });\n        } else if sk == SK_U32 {\n            write(self.out, \"{}u\", x.a).unwrap();\n        } else if sk == SK_I32 {\n            let v = x.a as u32 as i32 as i64;\n            if v == -2147483648 {\n                self.p(b\"(-2147483647 - 1)\");\n            } else if v < 0 {\n                write(self.out, \"({v})\").unwrap();\n            } else {\n                write(self.out, \"{v}\").unwrap();\n            }\n        } else {\n            let v = bits_f32(x.a as u32);\n            let ex = (x.a >> 23) & 255;\n            if ex == 255 {\n                write(self.out, \"as_type<float>({}u)\", x.a).unwrap();\n                return;\n            }\n            let mut b = Vec::<u8, _>::new_in(self.a);\n            write(b, \"{v}\").unwrap();\n            let s = b.as_slice();\n            let mut has_dot = false;\n            for i in 0..s.len() as i64 {\n                if s[i as usize] == b'.' || s[i as usize] == b'e' || s[i as usize] == b'E'\n                    || s[i as usize] == b'n' || s[i as usize] == b'i' {\n                    has_dot = true;\n                }\n            }\n            if s[0] == b'-' {\n                self.p(b\"(\");\n            }\n            self.p(s);\n            if !has_dot {\n                self.p(b\".0\");\n            }\n            self.p(b\"f\");\n            if s[0] == b'-' {\n                self.p(b\")\");\n            }\n        }\n    }\n\n    // e as a value: its name, or its text.\n    fn val(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let op = f.exprs[e as usize].op;\n");
    buf_str(out, c"        if self.baked[e as usize] || op == E_CALL_RESULT || op == E_ATOMIC_RESULT\n            || op == E_WG_UNIFORM_RESULT {\n            self.pn(self.enames[e as usize]);\n            return;\n        }\n        if op == E_ARG {\n            self.pn(self.enames[e as usize]);\n            return;\n        }\n        self.render(m, f, e);\n    }\n\n    // The unsigned type of the same shape as t (i32 -> uint, int3 -> uint3).\n    fn utype(&mut self, m: &Module<'_, A>, t: i64) -> Nm {\n        let ty = m.types[t as usize];\n        if ty.kind == TK_VECTOR {\n            let st = self.pool.len() as i64;\n            write(self.pool, \"metal::uint{}\", ty.n).unwrap();\n            return self.since(st);\n        }\n        self.intern(b\"uint\")\n    }\n\n    // The index of an E_ACCESS, clamped when its check says so.\n    fn index(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        if x.c == CK_CLAMP {\n            self.p(b\"metal::min(uint(\");\n            self.val(m, f, x.b);\n            write(self.out, \"), {}u)\", x.d - 1).unwrap();\n        } else {\n            self.val(m, f, x.b);\n        }\n    }\n\n    // A pointer expression as an lvalue.\n    fn lval(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        if x.op == E_GLOBAL {\n            self.pn(self.gnames[x.a as usize]);\n        } else if x.op == E_LOCAL {\n            self.pn(self.lnames[x.a as usize]);\n        } else if x.op == E_ARG {\n            write(self.out, \"(*{})\",\n                str::from_utf8(nm(&self.pool, self.enames[e as usize])).unwrap()).unwrap();\n        } else if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            let bt = m.types[m.pointee(f.exprs[x.a as usize].ty) as usize];\n            self.lval(m, f, x.a);\n            self.selector(m, f, e, bt);\n        } else {\n            self.p(b\"/* not a pointer */\");\n        }\n    }\n\n");
    buf_str(out, c"    // `.member`, `[i]` or `.inner[i]` after a base of type bt.\n    fn selector(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64, bt: Type<'_>) {\n        let x = f.exprs[e as usize];\n        if x.op == E_ACCESS_INDEX {\n            if bt.kind == TK_STRUCT {\n                self.p(b\".\");\n                let n = self.escape(m.members[(bt.mstart + x.b) as usize].name);\n                self.pn(n);\n            } else if bt.kind == TK_ARRAY && bt.n > 0 {\n                write(self.out, \".inner[{}]\", x.b).unwrap();\n            } else {\n                write(self.out, \"[{}]\", x.b).unwrap();\n            }\n            return;\n        }\n        if bt.kind == TK_ARRAY && bt.n > 0 {\n            self.p(b\".inner\");\n        }\n        self.p(b\"[\");\n        self.index(m, f, e);\n        self.p(b\"]\");\n    }\n\n    // Whether e (a pointer, or a member value) is a struct's vec3 member,\n    // which MSL holds packed.\n    fn is_packed_member(&self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) -> bool {\n        let x = f.exprs[e as usize];\n        if x.op != E_ACCESS_INDEX {\n            return false;\n        }\n        let bt0 = f.exprs[x.a as usize].ty;\n        let bt = if m.types[bt0 as usize].kind == TK_POINTER { m.types[bt0 as usize].base }\n            else { bt0 };\n        if m.types[bt as usize].kind != TK_STRUCT {\n            return false;\n        }\n        let mt = m.types[m.members[(m.types[bt as usize].mstart + x.b) as usize].ty as usize];\n        mt.kind == TK_VECTOR && mt.n == 3\n    }\n\n    // The conditions under which the pointer e is in range (runtime-sized\n    // arrays); false when there are none.\n    fn guards(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64, any: bool) -> bool {\n        let x = f.exprs[e as usize];\n        let mut a = any;\n        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            a = self.guards(m, f, x.a, a);\n            if x.op == E_ACCESS && x.c == CK_RZSW {\n");
    buf_str(out, c"                if a {\n                    self.p(b\" && \");\n                }\n                self.p(b\"uint(\");\n                self.val(m, f, x.b);\n                self.p(b\") < \");\n                self.runtime_len(m, f, x.a);\n                a = true;\n            }\n        }\n        a\n    }\n\n    fn has_guards(&self, f: &Function<'_, A>, e: i64) -> bool {\n        let x = f.exprs[e as usize];\n        if x.op == E_ACCESS && x.c == CK_RZSW {\n            return true;\n        }\n        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            return self.has_guards(f, x.a);\n        }\n        false\n    }\n\n    // The length of the runtime-sized array pointer `base` points to.\n    fn runtime_len(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, base: i64) {\n        let b = f.exprs[base as usize];\n        let mut g: i64 = -1;\n        let mut off: i64 = 0;\n        if b.op == E_GLOBAL {\n            g = b.a;\n        } else if b.op == E_ACCESS_INDEX && f.exprs[b.a as usize].op == E_GLOBAL {\n            g = f.exprs[b.a as usize].a;\n            let st = m.types[m.globals[g as usize].ty as usize];\n            off = m.members[(st.mstart + b.b) as usize].offset;\n        }\n        let stride = m.types[m.pointee(b.ty) as usize].stride;\n        self.len_text(g, off, stride);\n    }\n\n    fn len_text(&mut self, g: i64, off: i64, stride: i64) {\n        if g < 0 {\n            self.p(b\"0u\");\n            return;\n        }\n        let k = self.sl.size_index[g as usize];\n        if off == 0 {\n            write(self.out, \"(_w_sizes[{k}] / {stride}u)\").unwrap();\n        } else {\n            write(self.out, \"(_w_sizes[{k}] >= {off}u ? (_w_sizes[{k}] - {off}u) / {stride}u : 0u)\").unwrap();\n        }\n    }\n\n    fn render(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        let op = x.op;\n        let t = m.types[x.ty as usize];\n        if op == E_LITERAL {\n");
    buf_str(out, c"            self.lit(m, f, e);\n        } else if op == E_ZERO {\n            self.pty(m, x.ty);\n            self.p(b\" {}\");\n        } else if op == E_COMPOSE {\n            let tn = self.ty(m, x.ty);\n            self.pn(tn);\n            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n                self.p(b\"(\");\n            } else if t.kind == TK_ARRAY {\n                self.p(b\" {{\");\n            } else {\n                self.p(b\" {\");\n            }\n            for k in 0..x.b {\n                if k > 0 {\n                    self.p(b\", \");\n                }\n                if t.kind == TK_STRUCT && Wr::<A>::pads_before(m, x.ty, k) {\n                    self.p(b\"{}, \");\n                }\n                self.val(m, f, f.args[(x.a + k) as usize]);\n            }\n            if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n                self.p(b\")\");\n            } else if t.kind == TK_ARRAY {\n                self.p(b\"}}\");\n            } else {\n                self.p(b\"}\");\n            }\n        } else if op == E_SPLAT {\n            self.pty(m, x.ty);\n            self.p(b\"(\");\n            self.val(m, f, x.a);\n            self.p(b\")\");\n        } else if op == E_SWIZZLE {\n            self.p(b\"(\");\n            self.val(m, f, x.a);\n            self.p(b\").\");\n            for k in 0..x.c {\n                self.out.push(\"xyzw\"[((x.b >> (2 * k)) & 3) as usize]);\n            }\n        } else if op == E_ACCESS || op == E_ACCESS_INDEX {\n            let bt = m.types[f.exprs[x.a as usize].ty as usize];\n            let packed = op == E_ACCESS_INDEX && self.is_packed_member(m, f, e);\n            if packed {\n                self.pty(m, x.ty);\n                self.p(b\"(\");\n            }\n            self.p(b\"(\");\n            self.val(m, f, x.a);\n            self.p(b\")\");\n            self.selector(m, f, e, bt);\n            if packed {\n                self.p(b\")\");\n            }\n");
    buf_str(out, c"        } else if op == E_LOAD {\n            let pe = x.a;\n            let g = self.has_guards(f, pe);\n            if g {\n                self.p(b\"(\");\n                self.guards(m, f, pe, false);\n                self.p(b\" ? \");\n            }\n            let packed = self.is_packed_member(m, f, pe);\n            if packed {\n                self.pty(m, x.ty);\n                self.p(b\"(\");\n            }\n            self.lval(m, f, pe);\n            if packed {\n                self.p(b\")\");\n            }\n            if g {\n                self.p(b\" : \");\n                self.pty(m, x.ty);\n                self.p(b\" {})\");\n            }\n        } else if op == E_UNARY {\n            let sk = t.scalar;\n            if x.a == UN_NEG && sk == SK_I32 {\n                let _n1 = self.ty(m, x.ty);\n                let _n2 = self.utype(m, x.ty);\n                write(self.out, \"as_type<{}>(-as_type<{}>(\",\n                    str::from_utf8(nm(&self.pool, _n1)).unwrap(),\n                    str::from_utf8(nm(&self.pool, _n2)).unwrap()).unwrap();\n                self.val(m, f, x.b);\n                self.p(b\"))\");\n            } else {\n                self.p(if x.a == UN_NEG { b\"(-\" } else if x.a == UN_NOT { b\"(!\" } else { b\"(~\" });\n                self.val(m, f, x.b);\n                self.p(b\")\");\n            }\n        } else if op == E_BINARY {\n            self.binary(m, f, e);\n        } else if op == E_SELECT {\n            let ct = m.types[f.exprs[x.a as usize].ty as usize];\n            if ct.kind == TK_SCALAR {\n                self.p(b\"(\");\n                self.val(m, f, x.a);\n                self.p(b\" ? \");\n                self.val(m, f, x.b);\n                self.p(b\" : \");\n                self.val(m, f, x.c);\n                self.p(b\")\");\n            } else {\n                self.p(b\"metal::select(\");\n                self.val(m, f, x.c);\n                self.p(b\", \");\n");
    buf_str(out, c"                self.val(m, f, x.b);\n                self.p(b\", \");\n                self.val(m, f, x.a);\n                self.p(b\")\");\n            }\n        } else if op == E_CONVERT {\n            let from = m.types[f.exprs[x.a as usize].ty as usize].scalar;\n            if from == SK_F32 && (t.scalar == SK_I32 || t.scalar == SK_U32) {\n                self.need_f2i = true;\n                self.p(if t.scalar == SK_I32 { b\"_w_f2i(\" } else { b\"_w_f2u(\" });\n            } else {\n                self.pty(m, x.ty);\n                self.p(b\"(\");\n            }\n            self.val(m, f, x.a);\n            self.p(b\")\");\n        } else if op == E_BITCAST {\n            let _n3 = self.ty(m, x.ty);\n            write(self.out, \"as_type<{}>(\", str::from_utf8(nm(&self.pool, _n3)).unwrap()).unwrap();\n            self.val(m, f, x.a);\n            self.p(b\")\");\n        } else if op == E_MATH {\n            self.math(m, f, e);\n        } else if op == E_ARRAY_LENGTH {\n            self.len_text(x.a, x.c, x.d);\n        } else if op == E_DERIVATIVE {\n            self.p(if x.a == 0 { b\"metal::dfdx(\" } else if x.a == 1 { b\"metal::dfdy(\" }\n                else { b\"metal::fwidth(\" });\n            self.val(m, f, x.b);\n            self.p(b\")\");\n        } else if op == E_IMAGE_SAMPLE {\n            self.sample(m, f, e);\n        } else if op == E_IMAGE_LOAD {\n            self.image_load(m, f, e);\n        } else if op == E_IMAGE_QUERY {\n            let tex = self.enames_or_global(m, f, x.a);\n            if x.b == IQ_LEVELS {\n                write(self.out, \"{}.get_num_mip_levels()\",\n                    str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n            } else if x.b == IQ_LAYERS {\n                write(self.out, \"{}.get_array_size()\", str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n            } else {\n                let tt = m.types[f.exprs[x.a as usize].ty as usize];\n");
    buf_str(out, c"                if x.c >= 0 && tt.n != TEX_STORAGE_2D {\n                    write(self.out, \"metal::uint2({}.get_width(\",\n                        str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n                    self.val(m, f, x.c);\n                    write(self.out, \"), {}.get_height(\",\n                        str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n                    self.val(m, f, x.c);\n                    self.p(b\"))\");\n                } else {\n                    write(self.out, \"metal::uint2({}.get_width(), {}.get_height())\",\n                        str::from_utf8(nm(&self.pool, tex)).unwrap(),\n                        str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n                }\n            }\n        } else {\n            self.p(b\"/* ? */\");\n        }\n    }\n\n    fn enames_or_global(&self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) -> Nm {\n        let x = f.exprs[e as usize];\n        if x.op == E_GLOBAL {\n            return self.gnames[x.a as usize];\n        }\n        self.enames[e as usize]\n    }\n\n    fn binary(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        let op = x.a;\n        let lt = m.types[f.exprs[x.b as usize].ty as usize];\n        let sk = lt.scalar;\n        let int = (sk == SK_I32 || sk == SK_U32) && lt.kind != TK_MATRIX;\n        if int && (op == OP_DIV || op == OP_MOD) {\n            // a literal divisor other than 0 (and -1 for i32) needs no helper\n            let r = f.exprs[x.c as usize];\n            let lit_ok = r.op == E_LITERAL && r.a != 0 && !(sk == SK_I32 && r.a == 4294967295);\n            if lit_ok && !(sk == SK_I32 && op == OP_MOD) {\n                self.p(b\"(\");\n                self.val(m, f, x.b);\n                self.p(if op == OP_DIV { b\" / \" } else { b\" % \" });\n                self.val(m, f, x.c);\n                self.p(b\")\");\n                return;\n            }\n");
    buf_str(out, c"            self.need_div = true;\n            self.p(if op == OP_DIV { b\"_w_div(\" } else { b\"_w_mod(\" });\n            self.val(m, f, x.b);\n            self.p(b\", \");\n            self.val(m, f, x.c);\n            self.p(b\")\");\n            return;\n        }\n        if sk == SK_I32 && (op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_SHL) {\n            let tn = self.ty(m, f.exprs[x.b as usize].ty);\n            let un = self.utype(m, f.exprs[x.b as usize].ty);\n            write(self.out, \"as_type<{}>(as_type<{}>(\", str::from_utf8(nm(&self.pool, tn)).unwrap(),\n                str::from_utf8(nm(&self.pool, un)).unwrap()).unwrap();\n            self.val(m, f, x.b);\n            self.p(if op == OP_ADD { b\") + as_type<\" } else if op == OP_SUB { b\") - as_type<\" }\n                else if op == OP_MUL { b\") * as_type<\" } else { b\") << (\" });\n            if op == OP_SHL {\n                self.val(m, f, x.c);\n                self.p(b\" & 31u))\");\n            } else {\n                write(self.out, \"{}>(\", str::from_utf8(nm(&self.pool, un)).unwrap()).unwrap();\n                self.val(m, f, x.c);\n                self.p(b\"))\");\n            }\n            return;\n        }\n        if op == OP_MOD && sk == SK_F32 {\n            self.p(b\"metal::fmod(\");\n            self.val(m, f, x.b);\n            self.p(b\", \");\n            self.val(m, f, x.c);\n            self.p(b\")\");\n            return;\n        }\n        self.p(b\"(\");\n        self.val(m, f, x.b);\n        let s = if op == OP_ADD {\n            b\" + \"\n        } else if op == OP_SUB {\n            b\" - \"\n        } else if op == OP_MUL {\n            b\" * \"\n        } else if op == OP_DIV {\n            b\" / \"\n        } else if op == OP_EQ {\n            b\" == \"\n        } else if op == OP_NE {\n            b\" != \"\n        } else if op == OP_LT {\n            b\" < \"\n        } else if op == OP_LE {\n            b\" <= \"\n");
    buf_str(out, c"        } else if op == OP_GT {\n            b\" > \"\n        } else if op == OP_GE {\n            b\" >= \"\n        } else if op == OP_AND {\n            if sk == SK_BOOL && lt.kind == TK_SCALAR { b\" && \" } else { b\" & \" }\n        } else if op == OP_OR {\n            if sk == SK_BOOL && lt.kind == TK_SCALAR { b\" || \" } else { b\" | \" }\n        } else if op == OP_XOR {\n            if sk == SK_BOOL { b\" != \" } else { b\" ^ \" }\n        } else if op == OP_SHL {\n            b\" << (\"\n        } else if op == OP_SHR {\n            b\" >> (\"\n        } else if op == OP_LAND {\n            b\" && \"\n        } else {\n            b\" || \"\n        };\n        self.p(s);\n        self.val(m, f, x.c);\n        if op == OP_SHL || op == OP_SHR {\n            self.p(b\" & 31u)\");\n        }\n        self.p(b\")\");\n    }\n\n    fn math(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        let fun = x.a;\n        let a0 = f.args[x.b as usize];\n        let at = m.types[f.exprs[a0 as usize].ty as usize];\n        let sk = at.scalar;\n        let int = sk == SK_I32 || sk == SK_U32;\n        if fun == ir::MF_ABS && sk == SK_I32 {\n            // abs(MIN) is MIN: through uint\n            let _n4 = self.ty(m, x.ty);\n            let _n5 = self.utype(m, x.ty);\n            write(self.out, \"as_type<{}>(metal::select(as_type<{}>(\",\n                str::from_utf8(nm(&self.pool, _n4)).unwrap(),\n                str::from_utf8(nm(&self.pool, _n5)).unwrap()).unwrap();\n            self.val(m, f, a0);\n            let _n6 = self.utype(m, x.ty);\n            write(self.out, \"), -as_type<{}>(\", str::from_utf8(nm(&self.pool, _n6)).unwrap()).unwrap();\n            self.val(m, f, a0);\n            self.p(b\"), \");\n            self.val(m, f, a0);\n            let _n7 = self.ty(m, x.ty);\n            write(self.out, \" < {}(0)))\", str::from_utf8(nm(&self.pool, _n7)).unwrap()).unwrap();\n            return;\n");
    buf_str(out, c"        }\n        if fun == ir::MF_ABS && sk == SK_U32 {\n            self.val(m, f, a0);\n            return;\n        }\n        if fun == ir::MF_SIGN && int {\n            self.need_sign = true;\n            self.p(b\"_w_isign(\");\n            self.val(m, f, a0);\n            self.p(b\")\");\n            return;\n        }\n        if fun == ir::MF_DOT && int {\n            // wrapping: as the sum of products, through uint\n            let n = at.n;\n            write(self.out, \"as_type<{}>(\", str::from_utf8(Wr::<A>::scalar(sk)).unwrap()).unwrap();\n            for k in 0..n {\n                if k > 0 {\n                    self.p(b\" + \");\n                }\n                self.p(b\"as_type<uint>(\");\n                self.val(m, f, a0);\n                write(self.out, \"[{k}]) * as_type<uint>(\").unwrap();\n                self.val(m, f, f.args[(x.b + 1) as usize]);\n                write(self.out, \"[{k}])\").unwrap();\n            }\n            self.p(b\")\");\n            return;\n        }\n        if fun == ir::MF_FIRST_LEADING_BIT {\n            self.need_flb = true;\n            self.p(b\"_w_flb(\");\n            self.val(m, f, a0);\n            self.p(b\")\");\n            return;\n        }\n        if fun == ir::MF_FIRST_TRAILING_BIT {\n            self.need_ftb = true;\n            self.p(b\"_w_ftb(\");\n            self.val(m, f, a0);\n            self.p(b\")\");\n            return;\n        }\n        if fun == ir::MF_EXTRACT_BITS || fun == ir::MF_INSERT_BITS {\n            // WGSL clamps offset and count; Metal leaves them undefined\n            let k: i64 = if fun == ir::MF_EXTRACT_BITS { 1 } else { 2 };\n            self.p(if fun == ir::MF_EXTRACT_BITS { b\"metal::extract_bits(\" }\n                else { b\"metal::insert_bits(\" });\n            for i in 0..k {\n                self.val(m, f, f.args[(x.b + i) as usize]);\n                self.p(b\", \");\n            }\n            self.p(b\"metal::min(\");\n");
    buf_str(out, c"            self.val(m, f, f.args[(x.b + k) as usize]);\n            self.p(b\", 32u), metal::min(\");\n            self.val(m, f, f.args[(x.b + k + 1) as usize]);\n            self.p(b\", 32u - metal::min(\");\n            self.val(m, f, f.args[(x.b + k) as usize]);\n            self.p(b\", 32u)))\");\n            return;\n        }\n        if fun == ir::MF_DEGREES || fun == ir::MF_RADIANS {\n            self.p(b\"(\");\n            self.val(m, f, a0);\n            self.p(if fun == ir::MF_DEGREES { b\" * 57.2957795131f)\" }\n                else { b\" * 0.0174532925199f)\" });\n            return;\n        }\n        if fun == ir::MF_PACK2X16FLOAT {\n            self.p(b\"as_type<uint>(metal::half2(\");\n            self.val(m, f, a0);\n            self.p(b\"))\");\n            return;\n        }\n        if fun == ir::MF_UNPACK2X16FLOAT {\n            self.p(b\"metal::float2(as_type<metal::half2>(\");\n            self.val(m, f, a0);\n            self.p(b\"))\");\n            return;\n        }\n        let name = if fun < MATH_NAMES.len() as i64 {\n            MATH_NAMES[fun as usize]\n        } else if fun == ir::MF_COUNT_ONE_BITS {\n            b\"popcount\"\n        } else if fun == ir::MF_COUNT_LEADING_ZEROS {\n            b\"clz\"\n        } else if fun == ir::MF_COUNT_TRAILING_ZEROS {\n            b\"ctz\"\n        } else if fun == ir::MF_REVERSE_BITS {\n            b\"reverse_bits\"\n        } else if fun == ir::MF_ALL {\n            b\"all\"\n        } else if fun == ir::MF_ANY {\n            b\"any\"\n        } else if fun == ir::MF_SATURATE {\n            b\"saturate\"\n        } else if fun == ir::MF_ASINH {\n            b\"asinh\"\n        } else if fun == ir::MF_ACOSH {\n            b\"acosh\"\n        } else if fun == ir::MF_ATANH {\n            b\"atanh\"\n        } else if fun == ir::MF_FACE_FORWARD {\n            b\"faceforward\"\n        } else if fun == ir::MF_LDEXP {\n            b\"ldexp\"\n        } else if fun == ir::MF_PACK4X8UNORM {\n");
    buf_str(out, c"            b\"pack_float_to_unorm4x8\"\n        } else if fun == ir::MF_UNPACK4X8UNORM {\n            b\"unpack_unorm4x8_to_float\"\n        } else if fun == ir::MF_PACK4X8SNORM {\n            b\"pack_float_to_snorm4x8\"\n        } else if fun == ir::MF_UNPACK4X8SNORM {\n            b\"unpack_snorm4x8_to_float\"\n        } else if fun == ir::MF_PACK2X16UNORM {\n            b\"pack_float_to_unorm2x16\"\n        } else if fun == ir::MF_UNPACK2X16UNORM {\n            b\"unpack_unorm2x16_to_float\"\n        } else if fun == ir::MF_PACK2X16SNORM {\n            b\"pack_float_to_snorm2x16\"\n        } else {\n            b\"unpack_snorm2x16_to_float\"\n        };\n        self.p(b\"metal::\");\n        self.p(name);\n        self.p(b\"(\");\n        for k in 0..x.c {\n            if k > 0 {\n                self.p(b\", \");\n            }\n            self.val(m, f, f.args[(x.b + k) as usize]);\n        }\n        self.p(b\")\");\n    }\n\n    fn sample(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        let kind = x.d & 255;\n        let n = x.d >> 8;\n        let tt = m.types[f.exprs[x.a as usize].ty as usize];\n        let tex = self.enames_or_global(m, f, x.a);\n        let smp = self.enames_or_global(m, f, x.b);\n        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n        write(self.out, \"{}.{}({}, \", str::from_utf8(nm(&self.pool, tex)).unwrap(),\n            if compare { \"sample_compare\" } else { \"sample\" },\n            str::from_utf8(nm(&self.pool, smp)).unwrap()).unwrap();\n        self.val(m, f, f.args[x.c as usize]);\n        let mut k: i64 = 1;\n        if tt.n == TEX_2D_ARRAY {\n            self.p(b\", \");\n            self.val(m, f, f.args[(x.c + 1) as usize]);\n            k = 2;\n        }\n        if kind == IMG_SAMPLE_BIAS {\n            self.p(b\", metal::bias(\");\n            self.val(m, f, f.args[(x.c + k) as usize]);\n            self.p(b\")\");\n");
    buf_str(out, c"        } else if kind == IMG_SAMPLE_LEVEL {\n            self.p(b\", metal::level(\");\n            self.val(m, f, f.args[(x.c + k) as usize]);\n            self.p(b\")\");\n        } else if compare {\n            self.p(b\", \");\n            self.val(m, f, f.args[(x.c + k) as usize]);\n            if kind == IMG_SAMPLE_COMPARE_LEVEL {\n                self.p(b\", metal::level(0)\");\n            }\n        }\n        let _ = n;\n        self.p(b\")\");\n    }\n\n    // textureLoad: the level, layer and coordinates clamped into range.\n    fn image_load(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        let x = f.exprs[e as usize];\n        let tt = m.types[f.exprs[x.a as usize].ty as usize];\n        let tex = self.enames_or_global(m, f, x.a);\n        let arrayed = tt.n == TEX_2D_ARRAY;\n        let lvl = f.args[(x.c + x.d - 1) as usize];\n        let saved = mem::replace(&mut self.out, Vec::<u8, _>::new_in(self.a));\n        self.out.extend_from_slice(b\"metal::min(uint(\");\n        self.val(m, f, lvl);\n        write(self.out, \"), {}.get_num_mip_levels() - 1u)\",\n            str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n        let lb = mem::replace(&mut self.out, saved);\n        let l = lb.as_slice();\n        write(self.out, \"{}.read(metal::min(metal::uint2(\",\n            str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n        self.val(m, f, f.args[x.c as usize]);\n        { let l = str::from_utf8(l).unwrap();\n            write(self.out, \"), metal::uint2({}.get_width({l}) - 1u, {}.get_height({l}) - 1u))\",\n                str::from_utf8(nm(&self.pool, tex)).unwrap(),\n                str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap() };\n        if arrayed {\n            self.p(b\", metal::min(uint(\");\n            self.val(m, f, f.args[(x.c + 1) as usize]);\n            write(self.out, \"), {}.get_array_size() - 1u)\",\n                str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n        }\n");
    buf_str(out, c"        { let l = str::from_utf8(l).unwrap(); write(self.out, \", {l})\").unwrap() };\n    }\n}\n\n// ---- Shader compiler implementation, msl: Statements (0.22) ----\n\nimpl<A: Allocator + Copy> Wr<A> {\n    fn block(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, blk: i64) {\n        let b = f.blocks[blk as usize];\n        for i in b.start..b.start + b.count {\n            self.stmt(m, f, f.items[i as usize]);\n        }\n    }\n\n    fn braced(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, blk: i64) {\n        self.p(b\"{\");\n        self.indent += 1;\n        self.block(m, f, blk);\n        self.indent -= 1;\n        self.line();\n        self.p(b\"}\");\n    }\n\n    fn atomic_fn(fun: i64) -> &'static [u8] {\n        if fun == AT_ADD {\n            b\"metal::atomic_fetch_add_explicit\"\n        } else if fun == AT_SUB {\n            b\"metal::atomic_fetch_sub_explicit\"\n        } else if fun == AT_AND {\n            b\"metal::atomic_fetch_and_explicit\"\n        } else if fun == AT_OR {\n            b\"metal::atomic_fetch_or_explicit\"\n        } else if fun == AT_XOR {\n            b\"metal::atomic_fetch_xor_explicit\"\n        } else if fun == AT_MIN {\n            b\"metal::atomic_fetch_min_explicit\"\n        } else if fun == AT_MAX {\n            b\"metal::atomic_fetch_max_explicit\"\n        } else if fun == AT_EXCHANGE {\n            b\"metal::atomic_exchange_explicit\"\n        } else if fun == AT_LOAD {\n            b\"metal::atomic_load_explicit\"\n        } else {\n            b\"metal::atomic_store_explicit\"\n        }\n    }\n\n    fn stmt(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, s: i64) {\n        let st = f.stmts[s as usize];\n        let op = st.op;\n        if op == S_EMIT {\n            for e in st.a..st.b {\n                if self.baked[e as usize] {\n                    self.line();\n                    self.pty(m, f.exprs[e as usize].ty);\n                    self.p(b\" \");\n");
    buf_str(out, c"                    self.pn(self.enames[e as usize]);\n                    self.p(b\" = \");\n                    self.render(m, f, e);\n                    self.p(b\";\");\n                }\n            }\n            return;\n        }\n        self.line();\n        if op == S_STORE {\n            let g = self.has_guards(f, st.a);\n            if g {\n                self.p(b\"if (\");\n                self.guards(m, f, st.a, false);\n                self.p(b\") { \");\n            }\n            self.lval(m, f, st.a);\n            self.p(b\" = \");\n            self.val(m, f, st.b);\n            self.p(b\";\");\n            if g {\n                self.p(b\" }\");\n            }\n        } else if op == S_BLOCK {\n            self.braced(m, f, st.a);\n        } else if op == S_IF {\n            self.p(b\"if (\");\n            self.val(m, f, st.a);\n            self.p(b\") \");\n            self.braced(m, f, st.b);\n            if f.blocks[st.c as usize].count > 0 {\n                self.p(b\" else \");\n                self.braced(m, f, st.c);\n            }\n        } else if op == S_SWITCH {\n            self.p(b\"switch (\");\n            self.val(m, f, st.a);\n            self.p(b\") {\");\n            for k in st.b..st.b + st.c {\n                let c = f.cases[k as usize];\n                self.line();\n                for j in c.vstart..c.vstart + c.vcount {\n                    let sel_t = m.types[f.exprs[st.a as usize].ty as usize].scalar;\n                    if sel_t == SK_U32 {\n                        write(self.out, \"case {}u: \", f.vals[j as usize] & 4294967295).unwrap();\n                    } else {\n                        let v = f.vals[j as usize] as u32 as i32 as i64;\n                        if v == -2147483648 {\n                            self.p(b\"case (-2147483647 - 1): \");\n                        } else {\n                            write(self.out, \"case {v}: \").unwrap();\n                        }\n                    }\n");
    buf_str(out, c"                }\n                if c.is_default {\n                    self.p(b\"default: \");\n                }\n                self.p(b\"{\");\n                self.indent += 1;\n                self.block(m, f, c.body);\n                self.line();\n                self.p(b\"break;\");\n                self.indent -= 1;\n                self.line();\n                self.p(b\"}\");\n            }\n            self.line();\n            self.p(b\"}\");\n        } else if op == S_LOOP {\n            let has_cont = f.blocks[st.b as usize].count > 0 || st.c >= 0;\n            if !has_cont {\n                self.p(b\"while (true) \");\n                self.braced(m, f, st.a);\n                return;\n            }\n            let li = self.loop_n;\n            self.loop_n += 1;\n            write(self.out, \"bool _w_loop{li} = true;\").unwrap();\n            self.line();\n            self.p(b\"while (true) {\");\n            self.indent += 1;\n            self.line();\n            write(self.out, \"if (!_w_loop{li}) {{\").unwrap();\n            self.indent += 1;\n            self.block(m, f, st.b);\n            if st.c >= 0 {\n                self.line();\n                self.p(b\"if (\");\n                self.val(m, f, st.c);\n                self.p(b\") { break; }\");\n            }\n            self.indent -= 1;\n            self.line();\n            self.p(b\"}\");\n            self.line();\n            write(self.out, \"_w_loop{li} = false;\").unwrap();\n            self.block(m, f, st.a);\n            self.indent -= 1;\n            self.line();\n            self.p(b\"}\");\n        } else if op == S_BREAK {\n            self.p(b\"break;\");\n        } else if op == S_CONTINUE {\n            self.p(b\"continue;\");\n        } else if op == S_RETURN {\n            self.ret(m, f, st.a);\n        } else if op == S_KILL {\n            self.p(if self.stage == TEST_KERNEL { b\"return;\" }\n                else { b\"metal::discard_fragment();\" });\n");
    buf_str(out, c"        } else if op == S_BARRIER {\n            self.p(if st.a\n                == BARRIER_WORKGROUP {\n                b\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\"\n            } else { b\"metal::threadgroup_barrier(metal::mem_flags::mem_device);\" });\n        } else if op == S_WG_UNIFORM_LOAD {\n            self.p(b\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n            self.line();\n            self.pty(m, f.exprs[st.b as usize].ty);\n            write(self.out, \" {} = \",\n                str::from_utf8(nm(&self.pool, self.enames[st.b as usize])).unwrap()).unwrap();\n            self.lval(m, f, st.a);\n            self.p(b\";\");\n            self.line();\n            self.p(b\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n        } else if op == S_CALL {\n            if st.d >= 0 {\n                self.pty(m, f.exprs[st.d as usize].ty);\n                write(self.out, \" {} = \",\n                    str::from_utf8(nm(&self.pool, self.enames[st.d as usize])).unwrap()).unwrap();\n            }\n            self.call(m, f, st.a, st.b, st.c);\n            self.p(b\";\");\n        } else if op == S_ATOMIC {\n            self.atomic(m, f, s);\n        } else if op == S_IMAGE_STORE {\n            let tex = self.enames_or_global(m, f, st.a);\n            self.p(b\"if (metal::all(metal::uint2(\");\n            self.val(m, f, st.b);\n            write(self.out, \") < metal::uint2({}.get_width(), {}.get_height()))) {{ {}.write(\",\n                str::from_utf8(nm(&self.pool, tex)).unwrap(),\n                str::from_utf8(nm(&self.pool, tex)).unwrap(),\n                str::from_utf8(nm(&self.pool, tex)).unwrap()).unwrap();\n            self.val(m, f, st.c);\n            self.p(b\", metal::uint2(\");\n            self.val(m, f, st.b);\n            self.p(b\")); }\");\n        }\n    }\n\n    fn atomic(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, s: i64) {\n");
    buf_str(out, c"        let st = f.stmts[s as usize];\n        let g = self.has_guards(f, st.a);\n        let pt = m.types[f.exprs[st.a as usize].ty as usize];\n        let sk = m.types[pt.base as usize].scalar;\n        let tn = Wr::<A>::scalar(sk);\n        let sp = Wr::<A>::space(pt.space, pt.access);\n        if st.b == AT_CMPXCHG {\n            let rty = self.ty(m, f.exprs[st.d as usize].ty);\n            let mut rb = Vec::<u8, _>::new_in(self.a);\n            rb.extend_from_slice(nm(&self.pool, rty));\n            let rn = rb.as_slice();\n            let hst = self.pool.len() as i64;\n            let mut h = Vec::<u8, _>::new_in(self.a);\n            { let rn = str::from_utf8(rn).unwrap(); { let sp = str::from_utf8(sp).unwrap(); { let tn = str::from_utf8(tn).unwrap(); write(h, \"static inline {rn} _w_cmpxchg({sp} metal::atomic_{tn}* p, {tn} cmp, {tn} v) {{ {tn} old = cmp; bool ok = metal::atomic_compare_exchange_weak_explicit(p, &old, v, metal::memory_order_relaxed, metal::memory_order_relaxed); return {rn} {{old, ok}}; }}\\n\").unwrap() } } };\n            copy_into(&mut self.pool, h.as_slice());\n            let hs = self.since(hst);\n            let mut have = false;\n            for i in 0..self.need_cmpxchg.len() as i64 {\n                if nm(&self.pool, self.need_cmpxchg[i as usize]) == nm(&self.pool, hs) {\n                    have = true;\n                }\n            }\n            if !have {\n                self.need_cmpxchg.push(hs);\n            }\n            write(self.out, \"{} {} = \", str::from_utf8(nm(&self.pool, rty)).unwrap(),\n                str::from_utf8(nm(&self.pool, self.enames[st.d as usize])).unwrap()).unwrap();\n            if g {\n                self.p(b\"(\");\n                self.guards(m, f, st.a, false);\n                self.p(b\") ? \");\n            }\n            self.p(b\"_w_cmpxchg(&\");\n            self.lval(m, f, st.a);\n            self.p(b\", \");\n            self.val(m, f, st.e);\n            self.p(b\", \");\n");
    buf_str(out, c"            self.val(m, f, st.c);\n            self.p(b\")\");\n            if g {\n                write(self.out, \" : {} {{}}\", str::from_utf8(nm(&self.pool, rty)).unwrap()).unwrap();\n            }\n            self.p(b\";\");\n            return;\n        }\n        if st.d >= 0 {\n            { let tn = str::from_utf8(tn).unwrap();\n                write(self.out, \"{tn} {} = \",\n                    str::from_utf8(nm(&self.pool, self.enames[st.d as usize])).unwrap()).unwrap() };\n        }\n        if g {\n            if st.d >= 0 {\n                self.p(b\"(\");\n                self.guards(m, f, st.a, false);\n                self.p(b\") ? \");\n            } else {\n                self.p(b\"if (\");\n                self.guards(m, f, st.a, false);\n                self.p(b\") \");\n            }\n        }\n        self.p(Wr::<A>::atomic_fn(st.b));\n        self.p(b\"(&\");\n        self.lval(m, f, st.a);\n        if st.c >= 0 {\n            self.p(b\", \");\n            self.val(m, f, st.c);\n        }\n        self.p(b\", metal::memory_order_relaxed)\");\n        if g && st.d >= 0 {\n            { let tn = str::from_utf8(tn).unwrap(); write(self.out, \" : {tn}(0)\").unwrap() };\n        }\n        self.p(b\";\");\n    }\n\n    fn call(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, callee: i64, start: i64,\n        n: i64) {\n        self.pn(self.fnames[callee as usize]);\n        self.p(b\"(\");\n        let mut first = true;\n        for k in start..start + n {\n            if !first {\n                self.p(b\", \");\n            }\n            first = false;\n            let a = f.args[k as usize];\n            if m.types[f.exprs[a as usize].ty as usize].kind == TK_POINTER {\n                self.p(b\"&\");\n                self.lval(m, f, a);\n            } else {\n                self.val(m, f, a);\n            }\n        }\n        for g in 0..m.globals.len() as i64 {\n            if self.uses[callee as usize][g as usize] {\n");
    buf_str(out, c"                if !first {\n                    self.p(b\", \");\n                }\n                first = false;\n                self.pn(self.gnames[g as usize]);\n            }\n        }\n        if needs_sizes(self, m, callee) {\n            if !first {\n                self.p(b\", \");\n            }\n            self.p(b\"_w_sizes\");\n        }\n        self.p(b\")\");\n    }\n\n    fn ret(&mut self, m: &Module<'_, A>, f: &Function<'_, A>, e: i64) {\n        if e < 0 {\n            self.p(b\"return;\");\n            return;\n        }\n        if self.stage == TEST_KERNEL {\n            // a test kernel: the result into its output record\n            self.p(b\"{ _w_out[_w_tid] = \");\n            self.val(m, f, e);\n            self.p(b\"; return; }\");\n            return;\n        }\n        if self.stage == 255 || self.stage == STAGE_COMPUTE as i64 {\n            self.p(b\"return \");\n            self.val(m, f, e);\n            self.p(b\";\");\n            return;\n        }\n        // an entry point's result: into its output struct\n        let rt = m.types[self.ret_ty as usize];\n        self.p(b\"{ const auto _w_r = \");\n        self.val(m, f, e);\n        write(self.out, \"; return {} {{ \", str::from_utf8(nm(&self.pool, self.out_name)).unwrap()).unwrap();\n        if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {\n            for k in 0..rt.mcount {\n                if k > 0 {\n                    self.p(b\", \");\n                }\n                let _n8 = self.escape(m.members[(rt.mstart + k) as usize].name);\n                write(self.out, \"_w_r.{}\", str::from_utf8(nm(&self.pool, _n8)).unwrap()).unwrap();\n            }\n        } else {\n            self.p(b\"_w_r\");\n        }\n        self.p(b\" }; }\");\n    }\n}\n\n// ---- Shader compiler implementation, msl: Functions and entry points (0.22) ----\n\nfn start_fn<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, h: i64) {\n");
    buf_str(out, c"    let f = &m.functions[h as usize];\n    w.fh = h;\n    w.used.clear();\n    w.loop_n = 0;\n    // the module-scope names stay reserved\n    for k in 0..w.fnames.len() as i64 {\n        let n = w.fnames[k as usize];\n        w.used.push(n);\n    }\n    for k in 0..w.gnames.len() as i64 {\n        let n = w.gnames[k as usize];\n        w.used.push(n);\n    }\n    for k in 0..w.snames.len() as i64 {\n        let n = w.snames[k as usize];\n        w.used.push(n);\n    }\n    count_refs(w, &f);\n    w.enames.clear();\n    for e in 0..f.exprs.len() as i64 {\n        let x = f.exprs[e as usize];\n        if x.op == E_ARG {\n            let n = w.unique(f.params[x.a as usize].name);\n            w.enames.push(n);\n        }\n        else if w.baked[e as usize] || x.op == E_CALL_RESULT || x.op == E_ATOMIC_RESULT\n            || x.op == E_WG_UNIFORM_RESULT {\n            if f.names[e as usize].len() as i64 > 0 {\n                let n = w.unique(f.names[e as usize]);\n                w.enames.push(n);\n            } else {\n                let st = w.pool.len() as i64;\n                write(w.pool, \"_e{e}\").unwrap();\n                let n = w.since(st);\n                w.enames.push(n);\n            }\n        } else {\n            w.enames.push(Nm { start: 0, len: 0 });\n        }\n    }\n    w.lnames.clear();\n    for l in 0..f.locals.len() as i64 {\n        let n = w.unique(f.locals[l as usize].name);\n        w.lnames.push(n);\n    }\n}\n\n// The parameter list's global part: each global the function uses.\nfn global_params<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, h: i64, first: bool) -> bool {\n    let mut fst = first;\n    for g in 0..m.globals.len() as i64 {\n        if !w.uses[h as usize][g as usize] {\n            continue;\n        }\n        if !fst {\n            w.p(b\", \");\n        }\n        fst = false;\n        let gl = m.globals[g as usize];\n        let tk = m.types[gl.ty as usize].kind;\n        if gl.space == SP_HANDLE {\n");
    buf_str(out, c"            w.pty(m, gl.ty);\n            w.p(b\" \");\n        } else if tk == TK_ARRAY && m.types[gl.ty as usize].n == 0 {\n            let _n9 = w.ty(m, m.types[gl.ty as usize].base);\n            write(w.out, \"{} {}* \", str::from_utf8(Wr::<A>::space(gl.space, gl.access)).unwrap(),\n                str::from_utf8(nm(&w.pool, _n9)).unwrap()).unwrap();\n        } else {\n            let _n10 = w.ty(m, gl.ty);\n            write(w.out, \"{} {}& \", str::from_utf8(Wr::<A>::space(gl.space, gl.access)).unwrap(),\n                str::from_utf8(nm(&w.pool, _n10)).unwrap()).unwrap();\n        }\n        w.pn(w.gnames[g as usize]);\n    }\n    if needs_sizes(w, m, h) {\n        if !fst {\n            w.p(b\", \");\n        }\n        fst = false;\n        w.p(b\"constant uint* _w_sizes\");\n    }\n    fst\n}\n\nfn declare_locals<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, f: &Function<'_, A>) {\n    for l in 0..f.locals.len() as i64 {\n        w.line();\n        let _n11 = w.ty(m, f.locals[l as usize].ty);\n        write(w.out, \"{} {} = {{}};\", str::from_utf8(nm(&w.pool, _n11)).unwrap(),\n            str::from_utf8(nm(&w.pool, w.lnames[l as usize])).unwrap()).unwrap();\n    }\n}\n\nfn write_fn<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, h: i64) {\n    let f = &m.functions[h as usize];\n    start_fn(w, m, h);\n    w.spans.push(w.out.len() as i64);\n    w.spans.push(h);\n    w.stage = 255;\n    w.p(b\"\\n\");\n    if f.result >= 0 {\n        w.pty(m, f.result);\n    } else {\n        w.p(b\"void\");\n    }\n    write(w.out, \" {}(\", str::from_utf8(nm(&w.pool, w.fnames[h as usize])).unwrap()).unwrap();\n    let mut first = true;\n    for k in 0..f.params.len() as i64 {\n        if !first {\n            w.p(b\", \");\n        }\n        first = false;\n        let pt = m.types[f.params[k as usize].ty as usize];\n        let ae = arg_expr(f, k);\n        let pname = if ae >= 0 { w.enames[ae as usize] }\n");
    buf_str(out, c"            else { w.unique(f.params[k as usize].name) };\n        if pt.kind == TK_POINTER {\n            let _n12 = w.ty(m, pt.base);\n            write(w.out, \"thread {}* {}\", str::from_utf8(nm(&w.pool, _n12)).unwrap(),\n                str::from_utf8(nm(&w.pool, pname)).unwrap()).unwrap();\n        } else {\n            let _n13 = w.ty(m, f.params[k as usize].ty);\n            write(w.out, \"{} {}\", str::from_utf8(nm(&w.pool, _n13)).unwrap(),\n                str::from_utf8(nm(&w.pool, pname)).unwrap()).unwrap();\n        }\n    }\n    global_params(w, m, h, first);\n    w.p(b\") {\");\n    w.indent = 1;\n    declare_locals(w, m, &f);\n    w.block(m, &f, f.body);\n    w.indent = 0;\n    w.p(b\"\\n}\\n\");\n}\n\nfn arg_expr<A: Allocator + Copy>(f: &Function<'_, A>, k: i64) -> i64 {\n    for e in 0..f.exprs.len() as i64 {\n        if f.exprs[e as usize].op == E_ARG && f.exprs[e as usize].a == k {\n            return e;\n        }\n    }\n    -1\n}\n\nfn builtin_attr(b: i64) -> &'static [u8] {\n    if b == BI_POSITION {\n        b\"position\"\n    } else if b == BI_VERTEX_INDEX {\n        b\"vertex_id\"\n    } else if b == BI_INSTANCE_INDEX {\n        b\"instance_id\"\n    } else if b == BI_FRONT_FACING {\n        b\"front_facing\"\n    } else if b == BI_FRAG_DEPTH {\n        b\"depth(any)\"\n    } else if b == BI_SAMPLE_INDEX {\n        b\"sample_id\"\n    } else if b == BI_SAMPLE_MASK {\n        b\"sample_mask\"\n    } else if b == BI_LOCAL_INVOCATION_ID {\n        b\"thread_position_in_threadgroup\"\n    } else if b == BI_LOCAL_INVOCATION_INDEX {\n        b\"thread_index_in_threadgroup\"\n    } else if b == BI_GLOBAL_INVOCATION_ID {\n        b\"thread_position_in_grid\"\n    } else if b == BI_WORKGROUP_ID {\n        b\"threadgroup_position_in_grid\"\n    } else {\n        b\"threadgroups_per_grid\"\n    }\n}\n\nfn interp_attr(b: Binding) -> &'static [u8] {\n    if b.interp == INTERP_FLAT {\n        b\", flat\"\n    } else if b.interp == INTERP_LINEAR {\n");
    buf_str(out, c"        b\", center_no_perspective\"\n    } else {\n        b\"\"\n    }\n}\n\n// One IO value of an entry point: as a stage_in member (`in_struct`) or a\n// parameter.\nfn io_decl<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, stage: u8, ty: i64, b: Binding,\n    name: &[u8], output: bool) {\n    w.pty(m, ty);\n    { let name = str::from_utf8(name).unwrap(); write(w.out, \" {name} [[\").unwrap() };\n    if b.kind == BIND_BUILTIN {\n        w.p(builtin_attr(b.value));\n    } else if stage == STAGE_VERTEX && !output {\n        write(w.out, \"attribute({})\", b.value).unwrap();\n    } else if stage == STAGE_FRAGMENT && output {\n        write(w.out, \"color({})\", b.value).unwrap();\n    } else {\n        write(w.out, \"user(loc{}){}\", b.value, str::from_utf8(interp_attr(b)).unwrap()).unwrap();\n    }\n    w.p(b\"]]\");\n}\n\nfn uses_workgroup<A: Allocator + Copy>(w: &Wr<A>, m: &Module<'_, A>, h: i64) -> bool {\n    for g in 0..m.globals.len() as i64 {\n        if w.uses[h as usize][g as usize] && m.globals[g as usize].space == SP_WORKGROUP {\n            return true;\n        }\n    }\n    false\n}\n\n// Zeroes a workgroup variable (atomics by atomic stores).\nfn zero_workgroup<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, lv: &[u8], t: i64,\n    depth: i64) {\n    if !m.has_atomic(t) {\n        w.line();\n        let _n14 = w.ty(m, t);\n        { let lv = str::from_utf8(lv).unwrap();\n            write(w.out, \"{lv} = {} {{}};\", str::from_utf8(nm(&w.pool, _n14)).unwrap()).unwrap() };\n        return;\n    }\n    let ty = m.types[t as usize];\n    if ty.kind == TK_ATOMIC {\n        w.line();\n        { let lv = str::from_utf8(lv).unwrap();\n            write(w.out, \"metal::atomic_store_explicit(&{lv}, 0, metal::memory_order_relaxed);\").unwrap() };\n    } else if ty.kind == TK_ARRAY {\n        w.line();\n        write(w.out, \"for (uint _w_i{depth} = 0u; _w_i{depth} < {}u; _w_i{depth}++) {{\", ty.n).unwrap();\n        w.indent += 1;\n");
    buf_str(out, c"        let mut b = Vec::<u8, _>::new_in(w.a);\n        { let lv = str::from_utf8(lv).unwrap(); write(b, \"{lv}.inner[_w_i{depth}]\").unwrap() };\n        zero_workgroup(w, m, b.as_slice(), ty.base, depth + 1);\n        w.indent -= 1;\n        w.line();\n        w.p(b\"}\");\n    } else if ty.kind == TK_STRUCT {\n        for k in ty.mstart..ty.mstart + ty.mcount {\n            let mut b = Vec::<u8, _>::new_in(w.a);\n            let _n15 = w.escape(m.members[k as usize].name);\n            { let lv = str::from_utf8(lv).unwrap();\n                write(b, \"{lv}.{}\", str::from_utf8(nm(&w.pool, _n15)).unwrap()).unwrap() };\n            zero_workgroup(w, m, b.as_slice(), m.members[k as usize].ty, depth);\n        }\n    }\n}\n\nfn write_entry<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, ei: i64) {\n    let en = m.entries[ei as usize];\n    let h = en.func;\n    let f = &m.functions[h as usize];\n    start_fn(w, m, h);\n    w.spans.push(w.out.len() as i64);\n    w.spans.push(h);\n    w.stage = en.stage as i64;\n    w.ret_ty = f.result;\n    let ename = w.fnames[h as usize];\n    // the stage_in struct: location inputs of vertex and fragment shaders\n    let mut in_buf = Vec::<u8, _>::new_in(w.a);\n    if en.stage != STAGE_COMPUTE {\n        let mut any = false;\n        let saved = mem::replace(&mut w.out, Vec::<u8, _>::new_in(w.a));\n        for k in 0..f.params.len() as i64 {\n            let pt = m.types[f.params[k as usize].ty as usize];\n            if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {\n                for j in pt.mstart..pt.mstart + pt.mcount {\n                    let mem = m.members[j as usize];\n                    if mem.binding.kind == BIND_LOCATION\n                        || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION\n                            && en.stage == STAGE_FRAGMENT) {\n                        w.p(b\"\\n    \");\n");
    buf_str(out, c"                        let mut nb = Vec::<u8, _>::new_in(w.a);\n                        write(nb, \"_w_p{k}_{}\", j - pt.mstart).unwrap();\n                        io_decl(w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);\n                        w.p(b\";\");\n                        any = true;\n                    }\n                }\n            }\n            else if f.params[k as usize].binding.kind == BIND_LOCATION\n                || (f.params[k as usize].binding.kind == BIND_BUILTIN\n                    && f.params[k as usize].binding.value == BI_POSITION\n                    && en.stage == STAGE_FRAGMENT) {\n                w.p(b\"\\n    \");\n                let mut nb = Vec::<u8, _>::new_in(w.a);\n                write(nb, \"_w_p{k}\").unwrap();\n                io_decl(w, m, en.stage, f.params[k as usize].ty, f.params[k as usize].binding,\n                    nb.as_slice(), false);\n                w.p(b\";\");\n                any = true;\n            }\n        }\n        let sb = mem::replace(&mut w.out, saved);\n        if any {\n            in_buf.extend_from_slice(nm(&w.pool, ename));\n            in_buf.extend_from_slice(b\"_Input\");\n            w.out.extend_from_slice(b\"\\nstruct \");\n            copy_into(&mut w.out, in_buf.as_slice());\n            w.out.extend_from_slice(b\" {\");\n            copy_into(&mut w.out, sb.as_slice());\n            w.out.extend_from_slice(b\"\\n};\\n\");\n        }\n        // the output struct\n        if f.result >= 0 {\n            let mut nb = Vec::<u8, _>::new_in(w.a);\n            nb.extend_from_slice(nm(&w.pool, ename));\n            nb.extend_from_slice(b\"_Output\");\n            w.out_name = w.intern(nb.as_slice());\n            write(w.out, \"\\nstruct {} {{\", str::from_utf8(nm(&w.pool, w.out_name)).unwrap()).unwrap();\n            let rt = m.types[f.result as usize];\n            if rt.kind == TK_STRUCT && f.result_binding.kind == ir::BIND_NONE {\n");
    buf_str(out, c"                for j in rt.mstart..rt.mstart + rt.mcount {\n                    let mem = m.members[j as usize];\n                    w.p(b\"\\n    \");\n                    let mut mb = Vec::<u8, _>::new_in(w.a);\n                    write(mb, \"m{}\", j - rt.mstart).unwrap();\n                    io_decl(w, m, en.stage, mem.ty, mem.binding, mb.as_slice(), true);\n                    w.p(b\";\");\n                }\n            } else {\n                w.p(b\"\\n    \");\n                io_decl(w, m, en.stage, f.result, f.result_binding, b\"m0\", true);\n                w.p(b\";\");\n            }\n            w.p(b\"\\n};\\n\");\n        }\n    }\n    let kw = if en.stage == STAGE_COMPUTE { \"kernel void\" }\n        else if en.stage == STAGE_VERTEX { \"vertex\" } else { \"fragment\" };\n    write(w.out, \"\\n{kw} \").unwrap();\n    if en.stage != STAGE_COMPUTE {\n        if f.result >= 0 {\n            write(w.out, \"{} \", str::from_utf8(nm(&w.pool, w.out_name)).unwrap()).unwrap();\n        } else {\n            w.p(b\"void \");\n        }\n    }\n    write(w.out, \"{}(\", str::from_utf8(nm(&w.pool, ename)).unwrap()).unwrap();\n    let mut first = true;\n    if in_buf.len() as i64 > 0 {\n        write(w.out, \"{} _w_in [[stage_in]]\", str::from_utf8(in_buf.as_slice()).unwrap()).unwrap();\n        first = false;\n    }\n    // builtin inputs as parameters\n    let mut has_lid = false;\n    for k in 0..f.params.len() as i64 {\n        let pt = m.types[f.params[k as usize].ty as usize];\n        if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {\n            for j in pt.mstart..pt.mstart + pt.mcount {\n                let mem = m.members[j as usize];\n                if mem.binding.kind == BIND_BUILTIN\n                    && !(mem.binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n                    if !first {\n                        w.p(b\", \");\n                    }\n                    first = false;\n");
    buf_str(out, c"                    let mut nb = Vec::<u8, _>::new_in(w.a);\n                    write(nb, \"_w_p{k}_{}\", j - pt.mstart).unwrap();\n                    io_decl(w, m, en.stage, mem.ty, mem.binding, nb.as_slice(), false);\n                    if mem.binding.value == BI_LOCAL_INVOCATION_INDEX {\n                        has_lid = true;\n                    }\n                }\n            }\n        }\n        else if f.params[k as usize].binding.kind == BIND_BUILTIN\n            && !(f.params[k as usize].binding.value == BI_POSITION && en.stage == STAGE_FRAGMENT) {\n            if !first {\n                w.p(b\", \");\n            }\n            first = false;\n            let mut nb = Vec::<u8, _>::new_in(w.a);\n            write(nb, \"_w_p{k}\").unwrap();\n            io_decl(w, m, en.stage, f.params[k as usize].ty, f.params[k as usize].binding,\n                nb.as_slice(), false);\n            if f.params[k as usize].binding.value == BI_LOCAL_INVOCATION_INDEX {\n                has_lid = true;\n            }\n        }\n    }\n    let wg = en.stage == STAGE_COMPUTE && uses_workgroup(w, m, h);\n    if wg && !has_lid {\n        if !first {\n            w.p(b\", \");\n        }\n        first = false;\n        w.p(b\"uint _w_lindex [[thread_index_in_threadgroup]]\");\n    }\n    // resources\n    for g in 0..m.globals.len() as i64 {\n        if !w.uses[h as usize][g as usize] {\n            continue;\n        }\n        let gl = m.globals[g as usize];\n        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {\n            continue;\n        }\n        if !first {\n            w.p(b\", \");\n        }\n        first = false;\n        let tk = m.types[gl.ty as usize].kind;\n        let slot = w.sl.slot[(en.stage as i64 * m.globals.len() as i64 + g) as usize];\n        if gl.space == SP_HANDLE {\n            let _n16 = w.ty(m, gl.ty);\n            write(w.out, \"{} {} [[{}({slot})]]\", str::from_utf8(nm(&w.pool, _n16)).unwrap(),\n");
    buf_str(out, c"                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap(),\n                if tk == TK_TEXTURE { \"texture\" } else { \"sampler\" }).unwrap();\n        } else if tk == TK_ARRAY && m.types[gl.ty as usize].n == 0 {\n            let _n17 = w.ty(m, m.types[gl.ty as usize].base);\n            write(w.out, \"{} {}* {} [[buffer({slot})]]\",\n                str::from_utf8(Wr::<A>::space(gl.space, gl.access)).unwrap(),\n                str::from_utf8(nm(&w.pool, _n17)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n        } else {\n            let _n18 = w.ty(m, gl.ty);\n            write(w.out, \"{} {}& {} [[buffer({slot})]]\",\n                str::from_utf8(Wr::<A>::space(gl.space, gl.access)).unwrap(),\n                str::from_utf8(nm(&w.pool, _n18)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n        }\n    }\n    if needs_sizes(w, m, h) {\n        if !first {\n            w.p(b\", \");\n        }\n        write(w.out, \"constant uint* _w_sizes [[buffer({})]]\",\n            w.sl.sizes_slot[en.stage as i64 as usize]).unwrap();\n    }\n    w.p(b\") {\");\n    w.indent = 1;\n    // private and workgroup variables\n    for g in 0..m.globals.len() as i64 {\n        if !w.uses[h as usize][g as usize] {\n            continue;\n        }\n        let gl = m.globals[g as usize];\n        if gl.space == SP_PRIVATE {\n            w.line();\n            let _n19 = w.ty(m, gl.ty);\n            write(w.out, \"{} {} = \", str::from_utf8(nm(&w.pool, _n19)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n            if gl.init >= 0 {\n                write_const(w, m, gl.init);\n            } else {\n                let _n20 = w.ty(m, gl.ty);\n                write(w.out, \"{} {{}}\", str::from_utf8(nm(&w.pool, _n20)).unwrap()).unwrap();\n            }\n            w.p(b\";\");\n");
    buf_str(out, c"        } else if gl.space == SP_WORKGROUP {\n            w.line();\n            let _n21 = w.ty(m, gl.ty);\n            write(w.out, \"threadgroup {} {};\", str::from_utf8(nm(&w.pool, _n21)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n        }\n    }\n    if wg {\n        let lid = if has_lid { lid_name(w, m, &f) } else { w.intern(b\"_w_lindex\") };\n        w.line();\n        write(w.out, \"if ({} == 0u) {{\", str::from_utf8(nm(&w.pool, lid)).unwrap()).unwrap();\n        w.indent += 1;\n        for g in 0..m.globals.len() as i64 {\n            if w.uses[h as usize][g as usize] && m.globals[g as usize].space == SP_WORKGROUP {\n                let mut lb = Vec::<u8, _>::new_in(w.a);\n                lb.extend_from_slice(nm(&w.pool, w.gnames[g as usize]));\n                zero_workgroup(w, m, lb.as_slice(), m.globals[g as usize].ty, 0);\n            }\n        }\n        w.indent -= 1;\n        w.line();\n        w.p(b\"}\");\n        w.line();\n        w.p(b\"metal::threadgroup_barrier(metal::mem_flags::mem_threadgroup);\");\n    }\n    // the parameters as WGSL sees them\n    for k in 0..f.params.len() as i64 {\n        let ae = arg_expr(f, k);\n        if ae < 0 {\n            continue;\n        }\n        let pt = m.types[f.params[k as usize].ty as usize];\n        w.line();\n        if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {\n            let _n22 = w.ty(m, f.params[k as usize].ty);\n            write(w.out, \"{} {} = {{}};\", str::from_utf8(nm(&w.pool, _n22)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap()).unwrap();\n            for j in pt.mstart..pt.mstart + pt.mcount {\n                let mem = m.members[j as usize];\n                let from_in = mem.binding.kind == BIND_LOCATION\n                    || (mem.binding.kind == BIND_BUILTIN && mem.binding.value == BI_POSITION\n");
    buf_str(out, c"                        && en.stage == STAGE_FRAGMENT);\n                w.line();\n                let _n23 = w.escape(mem.name);\n                write(w.out, \"{}.{} = {}_w_p{k}_{};\",\n                    str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap(),\n                    str::from_utf8(nm(&w.pool, _n23)).unwrap(), if from_in { \"_w_in.\" } else { \"\" },\n                    j - pt.mstart).unwrap();\n            }\n        } else {\n            let from_in = f.params[k as usize].binding.kind == BIND_LOCATION\n                || (f.params[k as usize].binding.kind == BIND_BUILTIN\n                    && f.params[k as usize].binding.value == BI_POSITION\n                    && en.stage == STAGE_FRAGMENT);\n            let _n24 = w.ty(m, f.params[k as usize].ty);\n            write(w.out, \"{} {} = {}_w_p{k};\", str::from_utf8(nm(&w.pool, _n24)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap(),\n                if from_in { \"_w_in.\" } else { \"\" }).unwrap();\n        }\n    }\n    declare_locals(w, m, &f);\n    w.block(m, &f, f.body);\n    w.indent = 0;\n    w.p(b\"\\n}\\n\");\n    w.stage = 255;\n}\n\nfn lid_name<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, f: &Function<'_, A>) -> Nm {\n    for k in 0..f.params.len() as i64 {\n        let pt = m.types[f.params[k as usize].ty as usize];\n        if pt.kind == TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {\n            for j in pt.mstart..pt.mstart + pt.mcount {\n                let mem = m.members[j as usize];\n                if mem.binding.kind == BIND_BUILTIN\n                    && mem.binding.value == BI_LOCAL_INVOCATION_INDEX {\n                    let st = w.pool.len() as i64;\n                    write(w.pool, \"_w_p{k}_{}\", j - pt.mstart).unwrap();\n                    return w.since(st);\n                }\n            }\n        }\n        else if f.params[k as usize].binding.kind == BIND_BUILTIN\n");
    buf_str(out, c"            && f.params[k as usize].binding.value == BI_LOCAL_INVOCATION_INDEX {\n            let st = w.pool.len() as i64;\n            write(w.pool, \"_w_p{k}\").unwrap();\n            return w.since(st);\n        }\n    }\n    w.intern(b\"_w_lindex\")\n}\n\n// A private global's initializer: an expression of the module's constants.\nfn write_const<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, e: i64) {\n    let nb: Vec<bool, A> = Vec::from_elem_in(false, m.consts.exprs.len(), w.a);\n    let nn: Vec<Nm, A> = Vec::from_elem_in((Nm { start: 0, len: 0 }), m.consts.exprs.len(), w.a);\n    let saved_baked = mem::replace(&mut w.baked, nb);\n    let saved_names = mem::replace(&mut w.enames, nn);\n    w.render(m, &m.consts, e);\n    w.baked = saved_baked;\n    w.enames = saved_names;\n}\n\n// ---- Shader compiler implementation, msl: Test kernels (0.22) ----\n\n// The stage of a test kernel being written.\nconst TEST_KERNEL: i64 = 254;\n\n// Entry point ei (a vertex or fragment one) as a kernel, `NAME_w_test`:\n// invocation i reads its parameters from input record i (their record\n// offsets: ir::record_offsets) and writes its result into output record\n// i, so its body runs on Metal as the interpreter runs it alone. Its\n// slots: buffers from 0 in (group, binding) order, then the input, the\n// output and the sizes buffer; textures and samplers from 0.\nfn write_test_kernel<A: Allocator + Copy>(w: &mut Wr<A>, m: &Module<'_, A>, ei: i64) -> [i64; 3] {\n    let en = m.entries[ei as usize];\n    let h = en.func;\n    let f = &m.functions[h as usize];\n    start_fn(w, m, h);\n    w.stage = TEST_KERNEL;\n    w.ret_ty = f.result;\n    let ename = w.fnames[h as usize];\n    let offs = ir::record_offsets(m, h, w.a);\n    // the input record\n    let mut rec = Vec::<u8, _>::new_in(w.a);\n    rec.extend_from_slice(nm(&w.pool, ename));\n    rec.extend_from_slice(b\"_w_In\");\n    let rn = w.intern(rec.as_slice());\n    let mut b = Vec::<u8, _>::new_in(w.a);\n");
    buf_str(out, c"    b.extend_from_slice(b\"struct \");\n    b.extend_from_slice(nm(&w.pool, rn));\n    b.extend_from_slice(b\" {\\n\");\n    let mut off: i64 = 0;\n    for k in 0..f.params.len() as i64 {\n        if offs[k as usize] > off {\n            write(b, \"    char _pad{k}[{}];\\n\", offs[k as usize] - off).unwrap();\n        }\n        let mt = w.member_ty(m, f.params[k as usize].ty);\n        write(b, \"    {} p{k};\\n\", str::from_utf8(nm(&w.pool, mt)).unwrap()).unwrap();\n        off = offs[k as usize] + m.types[f.params[k as usize].ty as usize].size;\n    }\n    let stride = offs[f.params.len() as i64 as usize];\n    if stride > off {\n        write(b, \"    char _padend[{}];\\n\", stride - off).unwrap();\n    }\n    b.extend_from_slice(b\"};\\n\");\n    copy_into(&mut w.types_out, b.as_slice());\n    let rt = if f.result >= 0 { w.ty(m, f.result) } else { w.intern(b\"uint\") };\n    write(w.out, \"\\nkernel void {}_w_test(uint _w_tid [[threadgroup_position_in_grid]]\",\n        str::from_utf8(nm(&w.pool, ename)).unwrap()).unwrap();\n    let order = binding_order(m, w.a);\n    let mut nb: i64 = 0;\n    let mut nt: i64 = 0;\n    let mut ns: i64 = 0;\n    for k in 0..order.len() as i64 {\n        let g = order[k as usize];\n        if !w.uses[h as usize][g as usize] {\n            continue;\n        }\n        let gl = m.globals[g as usize];\n        if gl.space == SP_PRIVATE || gl.space == SP_WORKGROUP {\n            continue;\n        }\n        w.p(b\", \");\n        let kind = m.types[gl.ty as usize].kind;\n        if gl.space == SP_HANDLE {\n            let tn = w.ty(m, gl.ty);\n            let tex = kind == TK_TEXTURE;\n            let slot = if tex { nt } else { ns };\n            write(w.out, \"{} {} [[{}({slot})]]\", str::from_utf8(nm(&w.pool, tn)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap(),\n                if tex { \"texture\" } else { \"sampler\" }).unwrap();\n            if tex {\n                nt += 1;\n");
    buf_str(out, c"            } else {\n                ns += 1;\n            }\n        } else if kind == TK_ARRAY && m.types[gl.ty as usize].n == 0 {\n            let tn = w.ty(m, m.types[gl.ty as usize].base);\n            write(w.out, \"{} {}* {} [[buffer({nb})]]\",\n                str::from_utf8(Wr::<A>::space(gl.space, gl.access)).unwrap(),\n                str::from_utf8(nm(&w.pool, tn)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n            nb += 1;\n        } else {\n            let tn = w.ty(m, gl.ty);\n            write(w.out, \"{} {}& {} [[buffer({nb})]]\",\n                str::from_utf8(Wr::<A>::space(gl.space, gl.access)).unwrap(),\n                str::from_utf8(nm(&w.pool, tn)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n            nb += 1;\n        }\n    }\n    write(w.out, \", const device {}* _w_in [[buffer({nb})]], device {}* _w_out [[buffer({})]]\",\n        str::from_utf8(nm(&w.pool, rn)).unwrap(), str::from_utf8(nm(&w.pool, rt)).unwrap(),\n        nb + 1).unwrap();\n    let mut sizes: i64 = -1;\n    if needs_sizes(w, m, h) {\n        sizes = nb + 2;\n        write(w.out, \", constant uint* _w_sizes [[buffer({sizes})]]\").unwrap();\n    }\n    w.p(b\") {\");\n    w.indent = 1;\n    for g in 0..m.globals.len() as i64 {\n        if w.uses[h as usize][g as usize] && m.globals[g as usize].space == SP_PRIVATE {\n            let gl = m.globals[g as usize];\n            w.line();\n            let tn = w.ty(m, gl.ty);\n            write(w.out, \"{} {} = \", str::from_utf8(nm(&w.pool, tn)).unwrap(),\n                str::from_utf8(nm(&w.pool, w.gnames[g as usize])).unwrap()).unwrap();\n            if gl.init >= 0 {\n                write_const(w, m, gl.init);\n            } else {\n                write(w.out, \"{} {{}}\", str::from_utf8(nm(&w.pool, tn)).unwrap()).unwrap();\n            }\n            w.p(b\";\");\n        }\n    }\n");
    buf_str(out, c"    for k in 0..f.params.len() as i64 {\n        let ae = arg_expr(f, k);\n        if ae < 0 {\n            continue;\n        }\n        w.line();\n        let tn = w.ty(m, f.params[k as usize].ty);\n        write(w.out, \"{} {} = _w_in[_w_tid].p{k};\", str::from_utf8(nm(&w.pool, tn)).unwrap(),\n            str::from_utf8(nm(&w.pool, w.enames[ae as usize])).unwrap()).unwrap();\n    }\n    declare_locals(w, m, &f);\n    w.block(m, &f, f.body);\n    w.indent = 0;\n    w.p(b\"\\n}\\n\");\n    w.stage = 255;\n    [nb, nb + 1, sizes]\n}\n\n// ---- Shader compiler implementation, msl: Jobs for tests/wgsl/metalrun (0.22) ----\n\n// The MSL text of the module, for a job.\nfn module_text<'a, A: Allocator + Copy>(m: &'a Module<'_, A>, a: A, w: &mut Wr<A>) -> Vec<u8, A> {\n    let order = call_order(m, a);\n    w.uses = global_uses(m, &order, a);\n    w.sl = slots(m, &w.uses, a);\n    for oi in 0..order.len() as i64 {\n        let h = order[oi as usize];\n        let mut is_entry = false;\n        for e in 0..m.entries.len() as i64 {\n            if m.entries[e as usize].func == h {\n                is_entry = true;\n            }\n        }\n        if !is_entry {\n            write_fn(w, m, h);\n        }\n    }\n    for e in 0..m.entries.len() as i64 {\n        write_entry(w, m, e);\n    }\n    let mut text = Vec::<u8, _>::new_in(a);\n    finish_into(w, &mut text);\n    text\n}\n\n// A job that only compiles the MSL and finds each entry point.\npub fn metal_compile_job<B: Allocator + Copy, A: Allocator + Copy>(m: &Module<'_, A>, a: A,\n    out: &mut String<B>) {\n    // (0.26.3: into a String outside std; the Buf form is std's until 0.27)\n    let mut b = Vec::<u8, _>::new_in(*out.allocator());\n    metal_compile_job_buf(m, a, &mut b);\n    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());\n    out.push_str(t.as_str());\n}\n\npub(crate) fn metal_compile_job_buf<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A,\n    out: &mut Vec<u8, B>) {\n");
    buf_str(out, c"    let mut w = new_writer(m, a);\n    let text = module_text(m, a, &mut w);\n    write(out, \"msl {}\\n\", text.len() as i64).unwrap();\n    out.extend_from_slice(text.as_slice());\n    out.extend_from_slice(b\"\\nfunctions\");\n    for e in 0..m.entries.len() as i64 {\n        write(out, \" {}\",\n            str::from_utf8(nm(&w.pool, w.fnames[m.entries[e as usize].func as usize])).unwrap()).unwrap();\n    }\n    out.push(b'\\n');\n}\n\n// The MSL of the module, then what metalrun needs: the entry point's\n// name, workgroup size, dispatch, and each buffer's slot and words.\n// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form\n// is std's own until 0.27.\npub fn metal_job<B: Allocator + Copy, A: Allocator + Copy>(m: &Module<'_, A>, a: A, ei: i64,\n    job: &job::Job<A>, out: &mut String<B>) {\n    let mut b = Vec::<u8, _>::new_in(*out.allocator());\n    metal_job_buf(m, a, ei, job, &mut b);\n    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());\n    out.push_str(t.as_str());\n}\n\npub(crate) fn metal_job_buf<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A, ei: i64,\n    job: &job::Job<A>, out: &mut Vec<u8, B>) {\n    if job.call_n >= 0 {\n        metal_call_job(m, a, ei, job, out);\n        return;\n    }\n    let mut w = new_writer(m, a);\n    let text = module_text(m, a, &mut w);\n    let en = m.entries[ei as usize];\n    write(out, \"msl {}\\n\", text.len() as i64).unwrap();\n    out.extend_from_slice(text.as_slice());\n    write(out, \"\\nentry {}\\n\", str::from_utf8(nm(&w.pool, w.fnames[en.func as usize])).unwrap()).unwrap();\n    write(out, \"tg {} {} {}\\n\", en.wg[0], en.wg[1], en.wg[2]).unwrap();\n    write(out, \"dispatch {} {} {}\\n\", job.groups[0], job.groups[1], job.groups[2]).unwrap();\n    let mut sizes: Vec<i64, A> = Vec::from_elem_in(0i64, (w.sl.sizes_count as usize), a);\n    for i in 0..job.buffers.len() as i64 {\n        let b = &job.buffers[i as usize];\n");
    buf_str(out, c"        let g = job::find_global(m, b.group, b.binding);\n        if w.sl.size_index[g as usize] >= 0 {\n            sizes[w.sl.size_index[g as usize] as usize] = b.bytes;\n        }\n        write(out, \"buffer {} {} {} {}\", b.group, b.binding,\n            w.sl.slot[(2 * m.globals.len() as i64 + g) as usize], b.bytes).unwrap();\n        for k in 0..b.words.len() as i64 {\n            write(out, \" {}\", b.words[k as usize]).unwrap();\n        }\n        out.push(b'\\n');\n    }\n    if w.sl.sizes_slot[2] >= 0 {\n        write(out, \"sizes {} {}\", w.sl.sizes_slot[2], sizes.len() as i64).unwrap();\n        for k in 0..sizes.len() as i64 {\n            write(out, \" {}\", sizes[k as usize]).unwrap();\n        }\n        out.push(b'\\n');\n    }\n}\n\nfn finish_into<A: Allocator + Copy>(w: &Wr<A>, out: &mut Vec<u8, A>) {\n    let mut tmp = Vec::<u8, _>::new_in(w.a);\n    let _ = tmp;\n    // finish writes to a gpa Buf in `write`; here the same text into an arena one\n    out.extend_from_slice(\n        b\"// Generated by wgslc (MSL 3.0).\\n#include <metal_stdlib>\\n#include <simd/simd.h>\\n\\n\");\n    let mut h = Vec::<u8, _>::new_in(w.a);\n    helpers(w, &mut h);\n    copy_into(out, h.as_slice());\n    out.push(b'\\n');\n    copy_into(out, w.types_out.as_slice());\n    copy_into(out, w.out.as_slice());\n    tmp = h;\n}\n\n// A call job: the module's MSL plus entry ei's test kernel, run once per\n// input record (one thread per threadgroup), its resources at the\n// kernel's slots.\nfn metal_call_job<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A, ei: i64,\n    job: &job::Job<A>, out: &mut Vec<u8, B>) {\n    let mut w = new_writer(m, a);\n    let order = call_order(m, a);\n    w.uses = global_uses(m, &order, a);\n    w.sl = slots(m, &w.uses, a);\n    for oi in 0..order.len() as i64 {\n        let h = order[oi as usize];\n        let mut is_entry = false;\n        for e in 0..m.entries.len() as i64 {\n            if m.entries[e as usize].func == h {\n");
    buf_str(out, c"                is_entry = true;\n            }\n        }\n        if !is_entry {\n            write_fn(&mut w, m, h);\n        }\n    }\n    for e in 0..m.entries.len() as i64 {\n        write_entry(&mut w, m, e);\n    }\n    let io = write_test_kernel(&mut w, m, ei);\n    let mut text = Vec::<u8, _>::new_in(a);\n    finish_into(&w, &mut text);\n    let h = m.entries[ei as usize].func;\n    write(out, \"msl {}\\n\", text.len() as i64).unwrap();\n    out.extend_from_slice(text.as_slice());\n    write(out, \"\\nentry {}_w_test\\ntg 1 1 1\\ndispatch {} 1 1\\n\",\n        str::from_utf8(nm(&w.pool, w.fnames[h as usize])).unwrap(), job.call_n).unwrap();\n    // the kernel's slots: (group, binding) order over what it uses\n    let border = binding_order(m, a);\n    let ng = m.globals.len() as i64;\n    let mut kslot: Vec<i64, A> = Vec::from_elem_in(-1i64, (ng as usize), a);\n    let mut nb: i64 = 0;\n    let mut nt: i64 = 0;\n    for k in 0..border.len() as i64 {\n        let g = border[k as usize];\n        if !w.uses[h as usize][g as usize] {\n            continue;\n        }\n        let gl = m.globals[g as usize];\n        if gl.space == ir::SP_UNIFORM || gl.space == SP_STORAGE {\n            kslot[g as usize] = nb;\n            nb += 1;\n        } else if m.types[gl.ty as usize].kind == TK_TEXTURE {\n            kslot[g as usize] = nt;\n            nt += 1;\n        }\n    }\n    let mut sizes: Vec<i64, A> = Vec::from_elem_in(0i64, (w.sl.sizes_count as usize), a);\n    for i in 0..job.buffers.len() as i64 {\n        let b = &job.buffers[i as usize];\n        let g = job::find_global(m, b.group, b.binding);\n        if w.sl.size_index[g as usize] >= 0 {\n            sizes[w.sl.size_index[g as usize] as usize] = b.bytes;\n        }\n        write(out, \"buffer {} {} {} {}\", b.group, b.binding, kslot[g as usize], b.bytes).unwrap();\n        for j in 0..b.words.len() as i64 {\n            write(out, \" {}\", b.words[j as usize]).unwrap();\n        }\n");
    buf_str(out, c"        out.push(b'\\n');\n    }\n    for i in 0..job.textures.len() as i64 {\n        let t = &job.textures[i as usize];\n        let g = job::find_global(m, t.group, t.binding);\n        write(out, \"texture {} {} {} {}\", kslot[g as usize], str::from_utf8(t.format).unwrap(), t.w,\n            t.h).unwrap();\n        for j in 0..t.words.len() as i64 {\n            write(out, \" {}\", t.words[j as usize]).unwrap();\n        }\n        out.push(b'\\n');\n    }\n    let f = &m.functions[h as usize];\n    let in_stride = ir::record_offsets(m, h, a)[f.params.len() as i64 as usize];\n    let out_stride: i64 = if f.result >= 0 { ir::stride_of(m, f.result) } else { 4 };\n    write(out, \"buffer -1 0 {} {}\", io[0], job.call_n * in_stride).unwrap();\n    for j in 0..job.input.len() as i64 {\n        write(out, \" {}\", job.input[j as usize]).unwrap();\n    }\n    write(out, \"\\nbuffer -2 0 {} {}\\n\", io[1], job.call_n * out_stride).unwrap();\n    if io[2] >= 0 {\n        write(out, \"sizes {} {}\", io[2], sizes.len() as i64).unwrap();\n        for k in 0..sizes.len() as i64 {\n            write(out, \" {}\", sizes[k as usize]).unwrap();\n        }\n        out.push(b'\\n');\n    }\n}\n// ---- end mod std::gpu::wgsl::msl ----\n}\n// ---- mod std::gpu::wgsl::spirv ----\npub mod spirv {\n// ---- Shader compiler implementation, spirv (0.22) ----\n// The SPIR-V writer (G6).\n\nuse crate::alloc::Allocator;\n\nuse super::ir::Module;\n\n// The module as SPIR-V words, their bytes appended to out (0.26.3: a\n// Vec<u8, A>, bytes; a Buf before).\npub fn write_module<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, a: A,\n    out: &mut Vec<u8, B>) {\n    let _ = a;\n}\n// ---- end mod std::gpu::wgsl::spirv ----\n}\n// ---- mod std::gpu::wgsl::interp ----\npub mod interp {\n// ---- Shader compiler implementation, interp (0.22) ----\n// The CPU interpreter (docs/design/gpu.md §2.10, §4): the third back end\n");
    buf_str(out, c"// over the IR and the oracle of the tests and the shader fuzzer. It runs\n// compute entry points with WGSL's semantics, the checked ones included:\n// wrapping integers, division by zero, shifts modulo 32, clamped indices,\n// runtime-sized arrays that read zero and skip writes out of range.\n//\n// Values are 32-bit words in WGSL's memory layout, everywhere: an\n// expression's value lives in its register (words of the frame), so a\n// load or store is a copy. Each invocation keeps its own call and control\n// stacks, so a workgroup barrier suspends it: the invocations of a\n// workgroup run in turn until each reaches the barrier, then all resume.\n\nuse crate::alloc::Allocator;\n\nuse super::ir::{\n    AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE, AT_SUB,\n    AT_XOR, BIND_BUILTIN, BI_GLOBAL_INVOCATION_ID, BI_LOCAL_INVOCATION_ID,\n    BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS, BI_WORKGROUP_ID, CK_CLAMP, CK_RZSW, E_ACCESS,\n    E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST, E_CALL_RESULT,\n    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n    E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY, E_WG_UNIFORM_RESULT,\n    E_ZERO, Function, Module, OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GT, OP_LAND, OP_LE, OP_LOR, OP_LT,\n    OP_MOD, OP_MUL, OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_BOOL, SK_F32, SK_I32,\n    SP_HANDLE, SP_PRIVATE, SP_WORKGROUP, S_ATOMIC, S_BARRIER, S_BLOCK, S_BREAK, S_CALL, S_CONTINUE,\n    S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN, S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD,\n    TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR,\n    UN_NEG, UN_NOT, bits_f32, f32_bits,\n};\n\n// The C library's f32 math (libm): a C boundary, so each call is in\n// `unsafe`; none has effects (no errno is read).\n");
    buf_str(out, c"// UNSAFE: C functions; std::math has no sinh, cosh, tanh, their inverses, fma or ldexp, and its\n// f32 functions compute in f64 in software, where libm's sqrtf is one instruction.\n// SAFETY: each prototype is math.h's, f32 values in and out, no pointers.\nextern \"C\" {\n    #[effects()]\n    fn acosf(x: f32) -> f32;\n    #[effects()]\n    fn acoshf(x: f32) -> f32;\n    #[effects()]\n    fn asinf(x: f32) -> f32;\n    #[effects()]\n    fn asinhf(x: f32) -> f32;\n    #[effects()]\n    fn atan2f(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn atanf(x: f32) -> f32;\n    #[effects()]\n    fn atanhf(x: f32) -> f32;\n    #[effects()]\n    fn ceilf(x: f32) -> f32;\n    #[effects()]\n    fn cosf(x: f32) -> f32;\n    #[effects()]\n    fn coshf(x: f32) -> f32;\n    #[effects()]\n    fn exp2f(x: f32) -> f32;\n    #[effects()]\n    fn expf(x: f32) -> f32;\n    #[effects()]\n    fn floorf(x: f32) -> f32;\n    #[effects()]\n    fn fmaf(x: f32, y: f32, z: f32) -> f32;\n    #[effects()]\n    fn fmaxf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn fminf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn fmodf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn ldexpf(x: f32, e: i32) -> f32;\n    #[effects()]\n    fn log2f(x: f32) -> f32;\n    #[effects()]\n    fn logf(x: f32) -> f32;\n    #[effects()]\n    fn powf(x: f32, y: f32) -> f32;\n    #[effects()]\n    fn rintf(x: f32) -> f32;\n    #[effects()]\n    fn sinf(x: f32) -> f32;\n    #[effects()]\n    fn sinhf(x: f32) -> f32;\n    #[effects()]\n    fn sqrtf(x: f32) -> f32;\n    #[effects()]\n    fn tanf(x: f32) -> f32;\n    #[effects()]\n    fn tanhf(x: f32) -> f32;\n    #[effects()]\n    fn truncf(x: f32) -> f32;\n}\n\n// Pointer spaces (bits 48..55 of a pointer); bit 56: out of range (RZSW).\nconst PS_FUNC: i64 = 1;\nconst PS_PRIVATE: i64 = 2;\nconst PS_WORKGROUP: i64 = 3;\nconst PS_BUFFER: i64 = 4;\nconst PTR_INVALID: i64 = 72057594037927936;\nconst OFF_MASK: i64 = 4294967295;\n\nconst CT_BLOCK: u8 = 0;\n");
    buf_str(out, c"const CT_BODY: u8 = 1;\nconst CT_CONT: u8 = 2;\nconst CT_SWITCH: u8 = 3;\n\nconst ST_RUN: u8 = 0;\nconst ST_BARRIER: u8 = 1;\nconst ST_DONE: u8 = 2;\n\npub struct FnInfo<A: Allocator> {\n    // each expression's register: a word offset in the frame\n    regs: Vec<i64, A>,\n    // each local's offset in the frame\n    locals: Vec<i64, A>,\n    size: i64,\n    // the E_ARG expression of each parameter, or -1\n    arg_exprs: Vec<i64, A>,\n}\n\n#[derive(Clone, Copy)] struct Frame { func: i64, base: i64, ctl_base: i64, ret: i64 }\n\n// A position in a block; for loops `s` is the S_LOOP statement.\n#[derive(Clone, Copy)] struct Ctl { kind: u8, blk: i64, pos: i64, s: i64 }\n\npub struct Inv<A: Allocator> {\n    mem: Vec<u32, A>,\n    privm: Vec<u32, A>,\n    frames: Vec<Frame, A>,\n    ctl: Vec<Ctl, A>,\n    state: u8,\n    // workgroupUniformLoad's two barriers\n    phase: i64,\n}\n\npub struct Interp<A: Allocator> {\n    a: A,\n    fns: Vec<FnInfo<A>, A>,\n    // per global: its words (buffers), and offsets in private or workgroup memory\n    pub bufs: Vec<Vec<u32, A>, A>,\n    goff: Vec<i64, A>,\n    priv_words: i64,\n    wg_words: i64,\n    priv_init: Vec<u32, A>,\n    wg: Vec<u32, A>,\n    failed: bool,\n    pub err: Vec<u8, A>,\n    steps: i64,\n    max_steps: i64,\n    // builtins of the invocation being started\n    wg_size: [i64; 3],\n    groups: [i64; 3],\n    // per global: a texture's size and texels (4 words each: f32 bits for\n    // float textures, the integers for i32 and u32 ones), once set\n    tex_w: Vec<i64, A>,\n    tex_h: Vec<i64, A>,\n    texels: Vec<Vec<u32, A>, A>,\n}\n\nfn words_of<A: Allocator + Copy>(m: &Module<'_, A>, t: i64) -> i64 {\n    let ty = m.types[t as usize];\n    if ty.kind == TK_POINTER {\n        return 2;\n    }\n    if ty.kind == TK_TEXTURE || ty.kind == TK_SAMPLER {\n        return 1;\n    }\n    ty.size / 4\n}\n\npub fn new_interp<'a, A: Allocator + Copy>(m: &'a Module<'_, A>, a: A) -> Interp<A> {\n    let mut it = Interp {\n");
    buf_str(out, c"        a: a,\n        fns: Vec::new_in(a),\n        bufs: Vec::new_in(a),\n        goff: Vec::new_in(a),\n        priv_words: 0,\n        wg_words: 0,\n        priv_init: Vec::new_in(a),\n        wg: Vec::new_in(a),\n        failed: false,\n        err: Vec::<u8, _>::new_in(a),\n        steps: 0,\n        max_steps: 2000000000,\n        wg_size: [1i64, 1, 1],\n        groups: [1i64, 1, 1],\n        tex_w: Vec::new_in(a),\n        tex_h: Vec::new_in(a),\n        texels: Vec::new_in(a),\n    };\n    for h in 0..m.functions.len() as i64 {\n        let f = &m.functions[h as usize];\n        let mut fi = FnInfo {\n            regs: Vec::with_capacity_in(f.exprs.len(), a), locals: Vec::new_in(a), size: 0,\n            arg_exprs: Vec::from_elem_in(-1i64, f.params.len(), a),\n        };\n        let mut off: i64 = 0;\n        for l in 0..f.locals.len() as i64 {\n            fi.locals.push(off);\n            off += words_of(m, f.locals[l as usize].ty);\n        }\n        for e in 0..f.exprs.len() as i64 {\n            fi.regs.push(off);\n            off += words_of(m, f.exprs[e as usize].ty);\n            if f.exprs[e as usize].op == E_ARG {\n                fi.arg_exprs[f.exprs[e as usize].a as usize] = e;\n            }\n        }\n        fi.size = off;\n        it.fns.push(fi);\n    }\n    for g in 0..m.globals.len() as i64 {\n        let gl = m.globals[g as usize];\n        it.bufs.push(Vec::new_in(a));\n        it.tex_w.push(0);\n        it.tex_h.push(0);\n        it.texels.push(Vec::new_in(a));\n        if gl.space == SP_PRIVATE {\n            it.goff.push(it.priv_words);\n            it.priv_words += words_of(m, gl.ty);\n        } else if gl.space == SP_WORKGROUP {\n            it.goff.push(it.wg_words);\n            it.wg_words += words_of(m, gl.ty);\n        } else {\n            it.goff.push(0);\n        }\n    }\n    // private globals' initial values, from the module's constant expressions\n    for _ in 0..it.priv_words {\n        it.priv_init.push(0u32);\n");
    buf_str(out, c"    }\n    let mut cf = FnInfo {\n        regs: Vec::new_in(a), locals: Vec::new_in(a), size: 0, arg_exprs: Vec::new_in(a),\n    };\n    let mut off: i64 = 0;\n    for e in 0..m.consts.exprs.len() as i64 {\n        cf.regs.push(off);\n        off += words_of(m, m.consts.exprs[e as usize].ty);\n    }\n    cf.size = off;\n    if off > 0 {\n        let mut tmp = Inv {\n            mem: Vec::from_elem_in(0u32, (off as usize), a), privm: Vec::new_in(a),\n            frames: Vec::new_in(a),\n            ctl: Vec::new_in(a), state: ST_RUN, phase: 0,\n        };\n        for g in 0..m.globals.len() as i64 {\n            let gl = m.globals[g as usize];\n            if gl.space == SP_PRIVATE && gl.init >= 0 {\n                const_eval(m, &cf, &mut tmp, gl.init);\n                let w = words_of(m, gl.ty);\n                for k in 0..w {\n                    { let at_ix = (it.goff[g as usize] + k) as usize;\n                        it.priv_init[at_ix] = tmp.mem[(cf.regs[gl.init as usize] + k) as usize] };\n                }\n            }\n        }\n    }\n    it\n}\n\n// Evaluates a constant expression of the module's init function (and its\n// operands) into tmp's registers.\nfn const_eval<A: Allocator + Copy>(m: &Module<'_, A>, cf: &FnInfo<A>, tmp: &mut Inv<A>, e: i64) {\n    let x = m.consts.exprs[e as usize];\n    let dst = cf.regs[e as usize];\n    let w = words_of(m, x.ty);\n    if x.op == E_LITERAL {\n        tmp.mem[dst as usize] = x.a as u32;\n    } else if x.op == E_ZERO {\n        for k in 0..w {\n            tmp.mem[(dst + k) as usize] = 0;\n        }\n    } else if x.op == E_SPLAT {\n        const_eval(m, cf, tmp, x.a);\n        for k in 0..w {\n            tmp.mem[(dst + k) as usize] = tmp.mem[cf.regs[x.a as usize] as usize];\n        }\n    } else if x.op == E_COMPOSE {\n        let t = m.types[x.ty as usize];\n        let mut at: i64 = 0;\n        for i in 0..x.b {\n            let a = m.consts.args[(x.a + i) as usize];\n");
    buf_str(out, c"            const_eval(m, cf, tmp, a);\n            let aw = words_of(m, m.consts.exprs[a as usize].ty);\n            let o = compose_offset(m, t, i, at);\n            for k in 0..aw {\n                tmp.mem[(dst + o + k) as usize] = tmp.mem[(cf.regs[a as usize] + k) as usize];\n            }\n            at += aw;\n        }\n    }\n}\n\n// Where the i-th argument of a composition of type t goes (`at`: the\n// words the earlier arguments filled, for vectors).\nfn compose_offset<A: Allocator + Copy>(m: &Module<'_, A>, t: ir::Type, i: i64, at: i64) -> i64 {\n    if t.kind == TK_VECTOR {\n        at\n    } else if t.kind == TK_MATRIX {\n        i * t.stride / 4\n    } else if t.kind == TK_ARRAY {\n        i * t.stride / 4\n    } else {\n        m.members[(t.mstart + i) as usize].offset / 4\n    }\n}\n\nfn fl(x: u32) -> f32 { bits_f32(x) }\n\nfn ub(x: f32) -> u32 { f32_bits(x) }\n\nfn si(x: u32) -> i64 { x as i32 as i64 }\n\nimpl<A: Allocator + Copy> Interp<A> {\n    pub fn fail(&mut self, msg: &[u8]) {\n        if !self.failed {\n            self.failed = true;\n            self.err.extend_from_slice(msg);\n        }\n    }\n\n    // A buffer's binding: its words (sized to the binding).\n    pub fn set_buffer(&mut self, g: i64, words: &[u32]) {\n        let mut v: Vec<u32, A> = Vec::with_capacity_in(words.len(), self.a);\n        v.extend_from_slice(words);\n        self.bufs[g as usize] = v;\n    }\n\n    // A texture's texels: w x h, 4 words each (see `texels`).\n    pub fn set_texture(&mut self, g: i64, w: i64, h: i64, texels: &[u32]) {\n        self.tex_w[g as usize] = w;\n        self.tex_h[g as usize] = h;\n        let mut v: Vec<u32, A> = Vec::with_capacity_in(texels.len(), self.a);\n        v.extend_from_slice(texels);\n        self.texels[g as usize] = v;\n    }\n\n    // Runs entry point ei once per input record (stride_in bytes each,\n    // its parameters at their record offsets, ir::record_offsets), the\n");
    buf_str(out, c"    // results in `out`, stride_out bytes each. Vertex and fragment entry\n    // points so run alone: their builtins come from the records too.\n    pub fn call(&mut self, m: &Module<'_, A>, ei: i64, input: &[u32], stride_in: i64, n: i64,\n        out: &mut Vec<u32, A>, stride_out: i64) -> bool {\n        let fi = m.entries[ei as usize].func;\n        let size = self.fns[fi as usize].size;\n        let rw: i64 = if m.functions[fi as usize].result\n            >= 0 { words_of(m, m.functions[fi as usize].result) } else { 0 };\n        let offs = ir::record_offsets(m, fi, self.a);\n        self.wg = Vec::from_elem_in(0u32, (self.wg_words as usize), self.a);\n        for _ in 0..n * stride_out / 4 {\n            out.push(0u32);\n        }\n        for i in 0..n {\n            let mut inv = Inv {\n                mem: Vec::from_elem_in(0u32, ((size + rw) as usize), self.a),\n                privm: Vec::from_elem_in(0u32, (self.priv_words as usize), self.a),\n                frames: Vec::new_in(self.a),\n                ctl: Vec::new_in(self.a),\n                state: ST_RUN,\n                phase: 0,\n            };\n            for k in 0..self.priv_words {\n                inv.privm[k as usize] = self.priv_init[k as usize];\n            }\n            let fr = Frame { func: fi, base: 0, ctl_base: 0, ret: size };\n            inv.frames.push(fr);\n            self.enter(m, &mut inv, fr);\n            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: m.functions[fi as usize].body, pos: 0, s: -1 });\n            for k in 0..m.functions[fi as usize].params.len() as i64 {\n                let e = self.fns[fi as usize].arg_exprs[k as usize];\n                if e < 0 {\n                    continue;\n                }\n                let w = words_of(m, m.functions[fi as usize].params[k as usize].ty);\n                let src = i * stride_in / 4 + offs[k as usize] / 4;\n                for j in 0..w {\n                    if src + j < input.len() as i64 {\n");
    buf_str(out, c"                        inv.mem[(self.fns[fi as usize].regs[e as usize] + j) as usize] = input[\n                            (src + j) as usize];\n                    }\n                }\n            }\n            self.run(m, &mut inv);\n            if self.failed {\n                return false;\n            }\n            if inv.state != ST_DONE {\n                self.fail(b\"a barrier in an entry point run alone\");\n                return false;\n            }\n            for j in 0..rw {\n                out[(i * stride_out / 4 + j) as usize] = inv.mem[(size + j) as usize];\n            }\n        }\n        true\n    }\n\n    // ---- Memory ----\n\n    fn read(&self, inv: &Inv<A>, ptr: i64, k: i64) -> u32 {\n        let sp = (ptr >> 48) & 255;\n        let off = (ptr & OFF_MASK) + k;\n        if ptr & PTR_INVALID != 0 {\n            return 0;\n        }\n        if sp == PS_FUNC {\n            inv.mem[off as usize]\n        } else if sp == PS_PRIVATE {\n            inv.privm[off as usize]\n        } else if sp == PS_WORKGROUP {\n            self.wg[off as usize]\n        } else {\n            let b = (ptr >> 32) & 65535;\n            if off >= self.bufs[b as usize].len() as i64 {\n                // a fixed-size part beyond a too-small binding reads zero\n                return 0;\n            }\n            self.bufs[b as usize][off as usize]\n        }\n    }\n\n    fn write(&mut self, inv: &mut Inv<A>, ptr: i64, k: i64, v: u32) {\n        let sp = (ptr >> 48) & 255;\n        let off = (ptr & OFF_MASK) + k;\n        if ptr & PTR_INVALID != 0 {\n            return;\n        }\n        if sp == PS_FUNC {\n            inv.mem[off as usize] = v;\n        } else if sp == PS_PRIVATE {\n            inv.privm[off as usize] = v;\n        } else if sp == PS_WORKGROUP {\n            self.wg[off as usize] = v;\n        } else {\n            let b = (ptr >> 32) & 65535;\n            if off < self.bufs[b as usize].len() as i64 {\n");
    buf_str(out, c"                self.bufs[b as usize][off as usize] = v;\n            }\n        }\n    }\n\n    fn get_ptr(&self, inv: &Inv<A>, addr: i64) -> i64 {\n        (inv.mem[addr as usize] as i64) | ((inv.mem[(addr + 1) as usize] as i64) << 32)\n    }\n\n    fn put_ptr(&self, inv: &mut Inv<A>, addr: i64, p: i64) {\n        inv.mem[addr as usize] = (p & OFF_MASK) as u32;\n        inv.mem[(addr + 1) as usize] = ((p >> 32) & OFF_MASK) as u32;\n    }\n\n    // The length of the runtime-sized array at byte `offset` of global g.\n    fn runtime_len(&self, g: i64, offset: i64, stride: i64) -> i64 {\n        let bytes = self.bufs[g as usize].len() as i64 * 4 - offset;\n        if bytes <= 0 || stride <= 0 {\n            return 0;\n        }\n        bytes / stride\n    }\n\n    // The global a pointer expression starts from, or -1.\n    fn root_global(&self, f: &Function<'_, A>, e: i64) -> i64 {\n        let x = f.exprs[e as usize];\n        if x.op == E_GLOBAL {\n            return x.a;\n        }\n        if x.op == E_ACCESS || x.op == E_ACCESS_INDEX {\n            return self.root_global(f, x.a);\n        }\n        -1\n    }\n\n    // ---- Running a dispatch ----\n\n    // Runs entry point `ei` over groups[0] x groups[1] x groups[2] workgroups.\n    pub fn dispatch(&mut self, m: &Module<'_, A>, ei: i64, groups: [i64; 3]) -> bool {\n        let en = m.entries[ei as usize];\n        let n = en.wg[0] * en.wg[1] * en.wg[2];\n        self.wg_size = en.wg;\n        self.groups = groups;\n        let fi = en.func;\n        let size = self.fns[fi as usize].size;\n        let mut invs: Vec<Inv<A>, A> = Vec::with_capacity_in(n as usize, self.a);\n        for _ in 0..n {\n            invs.push(Inv {\n                mem: Vec::from_elem_in(0u32, (size as usize + 64), self.a),\n                privm: Vec::from_elem_in(0u32, (self.priv_words as usize), self.a),\n                frames: Vec::new_in(self.a),\n                ctl: Vec::new_in(self.a),\n                state: ST_RUN,\n");
    buf_str(out, c"                phase: 0,\n            });\n        }\n        self.wg = Vec::from_elem_in(0u32, (self.wg_words as usize), self.a);\n        for gz in 0..groups[2] {\n            for gy in 0..groups[1] {\n                for gx in 0..groups[0] {\n                    for k in 0..self.wg_words {\n                        self.wg[k as usize] = 0;\n                    }\n                    for li in 0..n {\n                        let lx = li % en.wg[0];\n                        let ly = (li / en.wg[0]) % en.wg[1];\n                        let lz = li / (en.wg[0] * en.wg[1]);\n                        let inv = &mut invs[li as usize];\n                        inv.mem.truncate(0usize);\n                        for _ in 0..size {\n                            inv.mem.push(0u32);\n                        }\n                        for k in 0..self.priv_words {\n                            inv.privm[k as usize] = self.priv_init[k as usize];\n                        }\n                        inv.frames.clear();\n                        inv.ctl.clear();\n                        inv.state = ST_RUN;\n                        inv.phase = 0;\n                        inv.frames.push(Frame { func: fi, base: 0, ctl_base: 0, ret: -1 });\n                        let fr0 = inv.frames[0];\n                        self.enter(m, inv, fr0);\n                        let body = m.functions[fi as usize].body;\n                        inv.ctl.push(Ctl { kind: CT_BLOCK, blk: body, pos: 0, s: -1 });\n                        self.set_builtins(m, inv, fi, [lx, ly, lz], [gx, gy, gz], li);\n                    }\n                    // run the workgroup's invocations, barrier to barrier\n                    loop {\n                        let mut running: i64 = 0;\n                        let mut at_barrier: i64 = 0;\n                        for li in 0..n {\n                            if invs[li as usize].state == ST_DONE {\n                                continue;\n                            }\n");
    buf_str(out, c"                            invs[li as usize].state = ST_RUN;\n                            self.run(m, &mut invs[li as usize]);\n                            if self.failed {\n                                return false;\n                            }\n                            if invs[li as usize].state == ST_BARRIER {\n                                at_barrier += 1;\n                            }\n                            running += 1;\n                        }\n                        if running == 0 {\n                            break;\n                        }\n                        if at_barrier != 0 && at_barrier != running {\n                            self.fail(b\"a barrier was reached by some invocations of a workgroup and not others (non-uniform control flow)\");\n                            return false;\n                        }\n                        if at_barrier == 0 {\n                            break;\n                        }\n                    }\n                }\n            }\n        }\n        true\n    }\n\n    fn set_builtins(&self, m: &Module<'_, A>, inv: &mut Inv<A>, fi: i64, l: [i64; 3],\n        g: [i64; 3], li: i64) {\n        let f = &m.functions[fi as usize];\n        for p in 0..f.params.len() as i64 {\n            let e = self.fns[fi as usize].arg_exprs[p as usize];\n            if e < 0 {\n                continue;\n            }\n            let dst = self.fns[fi as usize].regs[e as usize];\n            let pt = m.types[f.params[p as usize].ty as usize];\n            if pt.kind == TK_STRUCT {\n                for k in 0..pt.mcount {\n                    let mem = m.members[(pt.mstart + k) as usize];\n                    self.put_builtin(inv, mem.binding.value, dst + mem.offset / 4, l, g, li);\n                }\n            } else if f.params[p as usize].binding.kind == BIND_BUILTIN {\n                self.put_builtin(inv, f.params[p as usize].binding.value, dst, l, g, li);\n            }\n        }\n    }\n\n");
    buf_str(out, c"    fn put_builtin(&self, inv: &mut Inv<A>, b: i64, dst: i64, l: [i64; 3], g: [i64; 3],\n        li: i64) {\n        for k in 0..3 {\n            let v = if b == BI_LOCAL_INVOCATION_ID {\n                l[k as usize]\n            } else if b == BI_GLOBAL_INVOCATION_ID {\n                g[k as usize] * self.wg_size[k as usize] + l[k as usize]\n            } else if b == BI_WORKGROUP_ID {\n                g[k as usize]\n            } else if b == BI_NUM_WORKGROUPS {\n                self.groups[k as usize]\n            } else {\n                li\n            };\n            inv.mem[(dst + k) as usize] = v as u32;\n            if b == BI_LOCAL_INVOCATION_INDEX {\n                return;\n            }\n        }\n    }\n\n    // ---- Statements ----\n\n    // Runs an invocation until it ends, reaches a barrier or fails.\n    fn run(&mut self, m: &Module<'_, A>, inv: &mut Inv<A>) {\n        loop {\n            if self.failed {\n                return;\n            }\n            if inv.frames.len() as i64 == 0 {\n                inv.state = ST_DONE;\n                return;\n            }\n            let fr = inv.frames[(inv.frames.len() as i64 - 1) as usize];\n            if inv.ctl.len() as i64 == fr.ctl_base {\n                // the function ran off its end: return nothing\n                self.ret(m, inv, -1);\n                continue;\n            }\n            let ci = inv.ctl.len() as i64 - 1;\n            let c = inv.ctl[ci as usize];\n            let f = &m.functions[fr.func as usize];\n            let blk = f.blocks[c.blk as usize];\n            if c.pos >= blk.count {\n                self.end_block(m, inv, &f, ci);\n                continue;\n            }\n            inv.ctl[ci as usize].pos += 1;\n            let s = f.items[(blk.start + c.pos) as usize];\n            if !self.exec(m, inv, &f, fr, s) {\n                return;\n            }\n        }\n    }\n\n    // The block at ctl[ci] finished.\n");
    buf_str(out, c"    fn end_block(&mut self, m: &Module<'_, A>, inv: &mut Inv<A>,\n        f: &Function<'_, A>, ci: i64) {\n        let c = inv.ctl[ci as usize];\n        if c.kind == CT_BODY {\n            let st = f.stmts[c.s as usize];\n            inv.ctl[ci as usize] = Ctl { kind: CT_CONT, blk: st.b, pos: 0, s: c.s };\n            return;\n        }\n        if c.kind == CT_CONT {\n            let st = f.stmts[c.s as usize];\n            if st.c >= 0 {\n                let fr = inv.frames[(inv.frames.len() as i64 - 1) as usize];\n                if inv.mem[(fr.base + self.fns[fr.func as usize].regs[st.c as usize]) as usize]\n                    != 0 {\n                    inv.ctl.truncate(ci as usize);\n                    return;\n                }\n            }\n            self.steps += 1;\n            if self.steps > self.max_steps {\n                self.fail(b\"the step limit was reached (an endless loop?)\");\n                return;\n            }\n            inv.ctl[ci as usize] = Ctl { kind: CT_BODY, blk: st.a, pos: 0, s: c.s };\n            return;\n        }\n        inv.ctl.truncate(ci as usize);\n    }\n\n    // Returns from the current function with the value at register `src`\n    // of its frame (or none).\n    fn ret(&self, m: &Module<'_, A>, inv: &mut Inv<A>, src_e: i64) {\n        let fr = inv.frames.pop().unwrap();\n        if fr.ret >= 0 && src_e >= 0 {\n            let w = words_of(m, m.functions[fr.func as usize].exprs[src_e as usize].ty);\n            let src = fr.base + self.fns[fr.func as usize].regs[src_e as usize];\n            for k in 0..w {\n                inv.mem[(fr.ret + k) as usize] = inv.mem[(src + k) as usize];\n            }\n        }\n        inv.ctl.truncate(fr.ctl_base as usize);\n        if inv.frames.len() as i64 == 0 {\n            inv.state = ST_DONE;\n        } else {\n            inv.mem.truncate(fr.base as usize);\n        }\n    }\n\n    // Runs statement s; false when the invocation stops (a barrier, the\n");
    buf_str(out, c"    // end, an error).\n    fn exec(&mut self, m: &Module<'_, A>, inv: &mut Inv<A>,\n        f: &Function<'_, A>, fr: Frame, s: i64) -> bool {\n        let st = f.stmts[s as usize];\n        let op = st.op;\n        if op == S_EMIT {\n            for e in st.a..st.b {\n                self.eval_expr(m, inv, f, fr, e);\n            }\n            return !self.failed;\n        }\n        if op == S_STORE {\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func as usize].regs[st.a as usize]);\n            let w = words_of(m, f.exprs[st.b as usize].ty);\n            let src = fr.base + self.fns[fr.func as usize].regs[st.b as usize];\n            for k in 0..w {\n                self.write(inv, p, k, inv.mem[(src + k) as usize]);\n            }\n            return true;\n        }\n        if op == S_BLOCK {\n            inv.ctl.push(Ctl { kind: CT_BLOCK, blk: st.a, pos: 0, s: -1 });\n            return true;\n        }\n        if op == S_IF {\n            let c = inv.mem[(fr.base + self.fns[fr.func as usize].regs[st.a as usize]) as usize];\n            inv.ctl.push(Ctl {\n                kind: CT_BLOCK, blk: if c != 0 { st.b } else { st.c }, pos: 0, s: -1,\n            });\n            return true;\n        }\n        if op == S_LOOP {\n            inv.ctl.push(Ctl { kind: CT_BODY, blk: st.a, pos: 0, s: s });\n            return true;\n        }\n        if op == S_SWITCH {\n            let v = inv.mem[(fr.base + self.fns[fr.func as usize].regs[st.a as usize]) as usize] as i64;\n            let mut body: i64 = -1;\n            for k in st.b..st.b + st.c {\n                let cs = f.cases[k as usize];\n                for j in cs.vstart..cs.vstart + cs.vcount {\n                    if (f.vals[j as usize] & OFF_MASK) == v {\n                        body = cs.body;\n                    }\n                }\n                if cs.is_default && body < 0 {\n                    // remembered, but a later case may still match\n                }\n            }\n");
    buf_str(out, c"            if body < 0 {\n                for k in st.b..st.b + st.c {\n                    if f.cases[k as usize].is_default {\n                        body = f.cases[k as usize].body;\n                    }\n                }\n            }\n            inv.ctl.push(Ctl { kind: CT_SWITCH, blk: body, pos: 0, s: s });\n            return true;\n        }\n        if op == S_BREAK {\n            loop {\n                let c = inv.ctl.pop().unwrap();\n                if c.kind == CT_BODY || c.kind == CT_CONT || c.kind == CT_SWITCH {\n                    return true;\n                }\n            }\n        }\n        if op == S_CONTINUE {\n            loop {\n                let ci = inv.ctl.len() as i64 - 1;\n                let c = inv.ctl[ci as usize];\n                if c.kind == CT_BODY {\n                    let ls = f.stmts[c.s as usize];\n                    inv.ctl[ci as usize] = Ctl { kind: CT_CONT, blk: ls.b, pos: 0, s: c.s };\n                    return true;\n                }\n                inv.ctl.truncate(ci as usize);\n            }\n        }\n        if op == S_RETURN {\n            self.ret(m, inv, st.a);\n            return inv.state != ST_DONE;\n        }\n        if op == S_KILL {\n            inv.frames.clear();\n            inv.ctl.clear();\n            inv.state = ST_DONE;\n            return false;\n        }\n        if op == S_BARRIER {\n            inv.state = ST_BARRIER;\n            return false;\n        }\n        if op == S_WG_UNIFORM_LOAD {\n            if inv.phase == 0 {\n                inv.phase = 1;\n                let ci = inv.ctl.len() as i64 - 1;\n                inv.ctl[ci as usize].pos -= 1;\n                inv.state = ST_BARRIER;\n                return false;\n            }\n            inv.phase = 0;\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func as usize].regs[st.a as usize]);\n            let w = words_of(m, f.exprs[st.b as usize].ty);\n");
    buf_str(out, c"            let dst = fr.base + self.fns[fr.func as usize].regs[st.b as usize];\n            for k in 0..w {\n                inv.mem[(dst + k) as usize] = self.read(inv, p, k);\n            }\n            inv.state = ST_BARRIER;\n            return false;\n        }\n        if op == S_CALL {\n            let callee = st.a;\n            let base = inv.mem.len() as i64;\n            for _ in 0..self.fns[callee as usize].size {\n                inv.mem.push(0u32);\n            }\n            for k in 0..st.c {\n                let ae = f.args[(st.b + k) as usize];\n                let pe = self.fns[callee as usize].arg_exprs[k as usize];\n                if pe < 0 {\n                    continue;\n                }\n                let w = words_of(m, m.functions[callee as usize].params[k as usize].ty);\n                let src = fr.base + self.fns[fr.func as usize].regs[ae as usize];\n                let dst = base + self.fns[callee as usize].regs[pe as usize];\n                for j in 0..w {\n                    inv.mem[(dst + j) as usize] = inv.mem[(src + j) as usize];\n                }\n            }\n            let ret: i64 = if st.d >= 0 { fr.base + self.fns[fr.func as usize].regs[st.d as usize] }\n                else { -1 };\n            let nf = Frame { func: callee, base: base, ctl_base: inv.ctl.len() as i64, ret: ret };\n            inv.frames.push(nf);\n            self.enter(m, inv, nf);\n            inv.ctl.push(Ctl {\n                kind: CT_BLOCK, blk: m.functions[callee as usize].body, pos: 0, s: -1,\n            });\n            if inv.frames.len() as i64 > 64 {\n                self.fail(b\"calls nest too deep\");\n                return false;\n            }\n            return true;\n        }\n        if op == S_ATOMIC {\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func as usize].regs[st.a as usize]);\n            let sk = m.types[m.pointee(f.exprs[st.a as usize].ty) as usize].scalar;\n");
    buf_str(out, c"            let old = self.read(inv, p, 0);\n            let v = if st.c\n                >= 0 { inv.mem[\n                    (fr.base + self.fns[fr.func as usize].regs[st.c as usize]) as usize] }\n                else { 0 };\n            let fun = st.b;\n            let mut new = old;\n            if fun == AT_ADD {\n                new = old + v;\n            } else if fun == AT_SUB {\n                new = old - v;\n            } else if fun == AT_AND {\n                new = old & v;\n            } else if fun == AT_OR {\n                new = old | v;\n            } else if fun == AT_XOR {\n                new = old ^ v;\n            } else if fun == AT_MIN {\n                new = if sk == SK_I32 { if si(v) < si(old) { v } else { old } }\n                    else { if v < old { v } else { old } };\n            } else if fun == AT_MAX {\n                new = if sk == SK_I32 { if si(v) > si(old) { v } else { old } }\n                    else { if v > old { v } else { old } };\n            } else if fun == AT_EXCHANGE || fun == AT_STORE {\n                new = v;\n            } else if fun == AT_CMPXCHG {\n                let cmp = inv.mem[\n                    (fr.base + self.fns[fr.func as usize].regs[st.e as usize]) as usize];\n                if old == cmp {\n                    new = v;\n                }\n            }\n            if fun != AT_LOAD {\n                self.write(inv, p, 0, new);\n            }\n            if st.d >= 0 {\n                let dst = fr.base + self.fns[fr.func as usize].regs[st.d as usize];\n                inv.mem[dst as usize] = old;\n                if fun == AT_CMPXCHG {\n                    let cmp = inv.mem[\n                        (fr.base + self.fns[fr.func as usize].regs[st.e as usize]) as usize];\n                    // exchanged: the member at offset 4\n                    inv.mem[(dst + 1) as usize] = if old == cmp && p & PTR_INVALID == 0 { 1 }\n                        else { 0 };\n                }\n");
    buf_str(out, c"            }\n            return true;\n        }\n        if op == S_IMAGE_STORE {\n            self.fail(b\"textureStore is not run by the interpreter\");\n            return false;\n        }\n        self.fail(b\"unknown statement\");\n        false\n    }\n\n    // A new frame: the registers of its globals and locals hold their\n    // addresses from the start (they are leaves: an S_EMIT may cover one\n    // in a branch the invocation does not take).\n    fn enter(&mut self, m: &Module<'_, A>, inv: &mut Inv<A>, fr: Frame) {\n        let f = &m.functions[fr.func as usize];\n        for e in 0..f.exprs.len() as i64 {\n            let op = f.exprs[e as usize].op;\n            if op == E_GLOBAL || op == E_LOCAL {\n                self.eval_expr(m, inv, &f, fr, e);\n            }\n        }\n    }\n\n    // ---- Expressions ----\n\n    fn eval_expr(&mut self, m: &Module<'_, A>, inv: &mut Inv<A>,\n        f: &Function<'_, A>, fr: Frame, e: i64) {\n        let x = f.exprs[e as usize];\n        let dst = fr.base + self.fns[fr.func as usize].regs[e as usize];\n        let op = x.op;\n        if op == E_LITERAL {\n            inv.mem[dst as usize] = x.a as u32;\n            return;\n        }\n        if op == E_ZERO {\n            let w = words_of(m, x.ty);\n            for k in 0..w {\n                inv.mem[(dst + k) as usize] = 0;\n            }\n            return;\n        }\n        if op == E_ARG || op == E_CALL_RESULT || op == E_ATOMIC_RESULT\n            || op == E_WG_UNIFORM_RESULT {\n            return;\n        }\n        if op == E_GLOBAL {\n            let g = x.a;\n            let gl = m.globals[g as usize];\n            let p = if gl.space == SP_PRIVATE {\n                (PS_PRIVATE << 48) | self.goff[g as usize]\n            } else if gl.space == SP_WORKGROUP {\n                (PS_WORKGROUP << 48) | self.goff[g as usize]\n            } else if gl.space == SP_HANDLE {\n                g\n            } else {\n");
    buf_str(out, c"                (PS_BUFFER << 48) | (g << 32)\n            };\n            if gl.space == SP_HANDLE {\n                inv.mem[dst as usize] = g as u32;\n            } else {\n                self.put_ptr(inv, dst, p);\n            }\n            return;\n        }\n        if op == E_LOCAL {\n            let off = fr.base + self.fns[fr.func as usize].locals[x.a as usize];\n            self.put_ptr(inv, dst, (PS_FUNC << 48) | off);\n            return;\n        }\n        if op == E_LOAD {\n            let p = self.get_ptr(inv, fr.base + self.fns[fr.func as usize].regs[x.a as usize]);\n            let w = words_of(m, x.ty);\n            for k in 0..w {\n                inv.mem[(dst + k) as usize] = self.read(inv, p, k);\n            }\n            return;\n        }\n        if op == E_ACCESS || op == E_ACCESS_INDEX {\n            let bt0 = f.exprs[x.a as usize].ty;\n            let is_ptr = m.types[bt0 as usize].kind == TK_POINTER;\n            let bt = if is_ptr { m.types[bt0 as usize].base } else { bt0 };\n            let t = m.types[bt as usize];\n            let mut idx: i64 = 0;\n            let mut invalid = false;\n            if op == E_ACCESS_INDEX {\n                idx = x.b;\n            } else {\n                let iv = inv.mem[(fr.base + self.fns[fr.func as usize].regs[x.b as usize]) as usize] as i64;\n                idx = iv;\n                if x.c == CK_CLAMP {\n                    if idx > x.d - 1 {\n                        idx = x.d - 1;\n                    }\n                } else if x.c == CK_RZSW {\n                    let g = self.root_global(f, x.a);\n                    let bp = self.get_ptr(inv,\n                        fr.base + self.fns[fr.func as usize].regs[x.a as usize]);\n                    let start = (bp & OFF_MASK) * 4;\n                    let len: i64 = if g >= 0 { self.runtime_len(g, start, t.stride) } else { 0 };\n                    if idx >= len {\n                        invalid = true;\n");
    buf_str(out, c"                        idx = 0;\n                    }\n                } else if x.c == ir::CK_PENDING {\n                    self.fail(b\"an index has no bounds check (internal error)\");\n                    return;\n                }\n                // CK_NONE: proven in range\n            }\n            // the word offset of the component\n            let off = if t.kind == TK_STRUCT {\n                m.members[(t.mstart + idx) as usize].offset / 4\n            } else if t.kind == TK_VECTOR {\n                idx\n            } else {\n                idx * t.stride / 4\n            };\n            if is_ptr {\n                let mut p = self.get_ptr(inv,\n                    fr.base + self.fns[fr.func as usize].regs[x.a as usize]) + off;\n                if invalid {\n                    p = p | PTR_INVALID;\n                }\n                self.put_ptr(inv, dst, p);\n            } else {\n                let w = words_of(m, x.ty);\n                let src = fr.base + self.fns[fr.func as usize].regs[x.a as usize] + off;\n                for k in 0..w {\n                    inv.mem[(dst + k) as usize] = inv.mem[(src + k) as usize];\n                }\n            }\n            return;\n        }\n        if op == E_COMPOSE {\n            let t = m.types[x.ty as usize];\n            let mut at: i64 = 0;\n            for k in 0..x.b {\n                let a = f.args[(x.a + k) as usize];\n                let aw = words_of(m, f.exprs[a as usize].ty);\n                let o = compose_offset(m, t, k, at);\n                let src = fr.base + self.fns[fr.func as usize].regs[a as usize];\n                for j in 0..aw {\n                    inv.mem[(dst + o + j) as usize] = inv.mem[(src + j) as usize];\n                }\n                at += aw;\n            }\n            return;\n        }\n        if op == E_SPLAT {\n            let v = inv.mem[(fr.base + self.fns[fr.func as usize].regs[x.a as usize]) as usize];\n");
    buf_str(out, c"            let n = m.types[x.ty as usize].n;\n            for k in 0..n {\n                inv.mem[(dst + k) as usize] = v;\n            }\n            return;\n        }\n        if op == E_SWIZZLE {\n            let src = fr.base + self.fns[fr.func as usize].regs[x.a as usize];\n            // through a temporary: the source may be read after the first write\n            let mut tmp: [u32; 4] = [0; 4];\n            for k in 0..x.c {\n                tmp[k as usize] = inv.mem[(src + ((x.b >> (2 * k)) & 3)) as usize];\n            }\n            for k in 0..x.c {\n                inv.mem[(dst + k) as usize] = tmp[k as usize];\n            }\n            return;\n        }\n        if op == E_UNARY {\n            let t = m.types[x.ty as usize];\n            let n: i64 = if t.kind == TK_VECTOR { t.n } else { 1 };\n            let src = fr.base + self.fns[fr.func as usize].regs[x.b as usize];\n            for k in 0..n {\n                let v = inv.mem[(src + k) as usize];\n                inv.mem[(dst + k) as usize] = if x.a == UN_NEG {\n                    if t.scalar == SK_F32 { ub(-fl(v)) } else { 0 - v }\n                } else if x.a == UN_NOT {\n                    if v == 0 { 1 } else { 0 }\n                } else {\n                    !v\n                };\n            }\n            return;\n        }\n        if op == E_BINARY {\n            self.binary(m, inv, f, fr, e);\n            return;\n        }\n        if op == E_SELECT {\n            let t = m.types[x.ty as usize];\n            let w = words_of(m, x.ty);\n            let ct = m.types[f.exprs[x.a as usize].ty as usize];\n            let c = fr.base + self.fns[fr.func as usize].regs[x.a as usize];\n            let tsrc = fr.base + self.fns[fr.func as usize].regs[x.b as usize];\n            let fsrc = fr.base + self.fns[fr.func as usize].regs[x.c as usize];\n            for k in 0..w {\n                let ck = if ct.kind == TK_VECTOR { inv.mem[(c + k) as usize] }\n");
    buf_str(out, c"                    else { inv.mem[c as usize] };\n                inv.mem[(dst + k) as usize] = if ck != 0 { inv.mem[(tsrc + k) as usize] }\n                    else { inv.mem[(fsrc + k) as usize] };\n            }\n            let _ = t;\n            return;\n        }\n        if op == E_CONVERT {\n            let t = m.types[x.ty as usize];\n            let from = m.types[f.exprs[x.a as usize].ty as usize].scalar;\n            let n: i64 = if t.kind == TK_VECTOR { t.n } else { 1 };\n            let src = fr.base + self.fns[fr.func as usize].regs[x.a as usize];\n            for k in 0..n {\n                inv.mem[(dst + k) as usize] = convert(inv.mem[(src + k) as usize], from, t.scalar);\n            }\n            return;\n        }\n        if op == E_BITCAST {\n            let w = words_of(m, x.ty);\n            let src = fr.base + self.fns[fr.func as usize].regs[x.a as usize];\n            for k in 0..w {\n                inv.mem[(dst + k) as usize] = inv.mem[(src + k) as usize];\n            }\n            return;\n        }\n        if op == E_MATH {\n            self.math(m, inv, f, fr, e);\n            return;\n        }\n        if op == E_ARRAY_LENGTH {\n            inv.mem[dst as usize] = self.runtime_len(x.a, x.c, x.d) as u32;\n            return;\n        }\n        if op == E_DERIVATIVE {\n            // one invocation alone: its derivatives are zero\n            let w = words_of(m, x.ty);\n            for k in 0..w {\n                inv.mem[(dst + k) as usize] = 0;\n            }\n            return;\n        }\n        if op == E_IMAGE_LOAD || op == E_IMAGE_QUERY {\n            let g = inv.mem[(fr.base + self.fns[fr.func as usize].regs[x.a as usize]) as usize] as i64;\n            let tt = m.types[f.exprs[x.a as usize].ty as usize];\n            if tt.n == ir::TEX_2D_ARRAY {\n                self.fail(b\"array textures are not run by the interpreter\");\n                return;\n            }\n            let w = self.tex_w[g as usize];\n");
    buf_str(out, c"            let h = self.tex_h[g as usize];\n            if op == E_IMAGE_QUERY {\n                if x.b == ir::IQ_SIZE {\n                    inv.mem[dst as usize] = w as u32;\n                    inv.mem[(dst + 1) as usize] = h as u32;\n                } else {\n                    inv.mem[dst as usize] = 1;\n                }\n                return;\n            }\n            // the coordinates clamped (as unsigned) into the one level\n            let c = fr.base + self.fns[fr.func as usize].regs[f.args[x.c as usize] as usize];\n            let mut cx = inv.mem[c as usize] as i64;\n            let mut cy = inv.mem[(c + 1) as usize] as i64;\n            if cx > w - 1 {\n                cx = w - 1;\n            }\n            if cy > h - 1 {\n                cy = h - 1;\n            }\n            if w <= 0 || h <= 0 {\n                self.fail(b\"a texture the job does not set is read\");\n                return;\n            }\n            let t = (cy * w + cx) * 4;\n            let n = words_of(m, x.ty);\n            for k in 0..n {\n                inv.mem[(dst + k) as usize] = self.texels[g as usize][(t + k) as usize];\n            }\n            return;\n        }\n        if op == E_IMAGE_SAMPLE {\n            self.fail(b\"sampling is not run by the interpreter\");\n            return;\n        }\n        self.fail(b\"unknown expression\");\n    }\n\n    fn binary(&self, m: &Module<'_, A>, inv: &mut Inv<A>, f: &Function<'_, A>,\n        fr: Frame, e: i64) {\n        let x = f.exprs[e as usize];\n        let dst = fr.base + self.fns[fr.func as usize].regs[e as usize];\n        let lt = m.types[f.exprs[x.b as usize].ty as usize];\n        let rt = m.types[f.exprs[x.c as usize].ty as usize];\n        let l = fr.base + self.fns[fr.func as usize].regs[x.b as usize];\n        let r = fr.base + self.fns[fr.func as usize].regs[x.c as usize];\n        let op = x.a;\n        if lt.kind == TK_MATRIX || rt.kind == TK_MATRIX {\n");
    buf_str(out, c"            self.matrix_binary(m, inv, op, lt, rt, x.ty, l, r, dst);\n            return;\n        }\n        let n: i64 = if lt.kind == TK_VECTOR { lt.n } else { 1 };\n        let sk = lt.scalar;\n        // the result first in a temporary: dst never overlaps l or r, but stay simple\n        for k in 0..n {\n            let a = inv.mem[(l + k) as usize];\n            let b = inv.mem[(r + k) as usize];\n            inv.mem[(dst + k) as usize] = scalar_binary(op, sk, a, b);\n        }\n    }\n\n    fn matrix_binary(&self, m: &Module<'_, A>, inv: &mut Inv<A>, op: i64,\n        lt: ir::Type, rt: ir::Type, ty: i64, l: i64, r: i64, dst: i64) {\n        let res = m.types[ty as usize];\n        if op == OP_ADD || op == OP_SUB {\n            let cs = lt.stride / 4;\n            for c in 0..lt.n {\n                for k in 0..lt.m {\n                    let a = fl(inv.mem[(l + c * cs + k) as usize]);\n                    let b = fl(inv.mem[(r + c * cs + k) as usize]);\n                    inv.mem[(dst + c * cs + k) as usize] = ub(if op == OP_ADD { a + b }\n                        else { a - b });\n                }\n            }\n            return;\n        }\n        // multiplication\n        if lt.kind == TK_MATRIX && rt.kind == TK_SCALAR {\n            let cs = lt.stride / 4;\n            let s = fl(inv.mem[r as usize]);\n            for c in 0..lt.n {\n                for k in 0..lt.m {\n                    inv.mem[(dst + c * cs + k) as usize] = ub(\n                        fl(inv.mem[(l + c * cs + k) as usize]) * s);\n                }\n            }\n            return;\n        }\n        if lt.kind == TK_SCALAR {\n            let cs = rt.stride / 4;\n            let s = fl(inv.mem[l as usize]);\n            for c in 0..rt.n {\n                for k in 0..rt.m {\n                    inv.mem[(dst + c * cs + k) as usize] = ub(\n                        s * fl(inv.mem[(r + c * cs + k) as usize]));\n                }\n            }\n            return;\n        }\n");
    buf_str(out, c"        if lt.kind == TK_MATRIX && rt.kind == TK_VECTOR {\n            // (C x R) * vecC -> vecR\n            let cs = lt.stride / 4;\n            let mut out: [f32; 4] = [0.0; 4];\n            for k in 0..lt.m {\n                let mut acc: f32 = 0.0;\n                for c in 0..lt.n {\n                    acc = acc + fl(inv.mem[(l + c * cs + k) as usize]) * fl(\n                        inv.mem[(r + c) as usize]);\n                }\n                out[k as usize] = acc;\n            }\n            for k in 0..lt.m {\n                inv.mem[(dst + k) as usize] = ub(out[k as usize]);\n            }\n            return;\n        }\n        if lt.kind == TK_VECTOR {\n            // vecR * (C x R) -> vecC\n            let cs = rt.stride / 4;\n            let mut out: [f32; 4] = [0.0; 4];\n            for c in 0..rt.n {\n                let mut acc: f32 = 0.0;\n                for k in 0..rt.m {\n                    acc = acc + fl(inv.mem[(l + k) as usize]) * fl(\n                        inv.mem[(r + c * cs + k) as usize]);\n                }\n                out[c as usize] = acc;\n            }\n            for c in 0..rt.n {\n                inv.mem[(dst + c) as usize] = ub(out[c as usize]);\n            }\n            return;\n        }\n        // (K x R) * (C x K) -> (C x R)\n        let ls = lt.stride / 4;\n        let rs = rt.stride / 4;\n        let ds = res.stride / 4;\n        let mut out: [f32; 16] = [0.0; 16];\n        for c in 0..rt.n {\n            for k in 0..lt.m {\n                let mut acc: f32 = 0.0;\n                for j in 0..lt.n {\n                    acc = acc + fl(inv.mem[(l + j * ls + k) as usize]) * fl(\n                        inv.mem[(r + c * rs + j) as usize]);\n                }\n                out[(c * 4 + k) as usize] = acc;\n            }\n        }\n        for c in 0..rt.n {\n            for k in 0..lt.m {\n                inv.mem[(dst + c * ds + k) as usize] = ub(out[(c * 4 + k) as usize]);\n            }\n        }\n    }\n\n");
    buf_str(out, c"    fn math(&self, m: &Module<'_, A>, inv: &mut Inv<A>, fx: &Function<'_, A>,\n        fr: Frame, e: i64) {\n        let x = fx.exprs[e as usize];\n        let dst = fr.base + self.fns[fr.func as usize].regs[e as usize];\n        let fun = x.a;\n        let nargs = x.c;\n        let mut a: [i64; 4] = [0i64; 4];\n        for k in 0..nargs {\n            a[k as usize] = fr.base + self.fns[fr.func as usize].regs[\n                fx.args[(x.b + k) as usize] as usize];\n        }\n        let at = m.types[fx.exprs[fx.args[x.b as usize] as usize].ty as usize];\n        let n: i64 = if at.kind == TK_VECTOR { at.n } else { 1 };\n        let sk = at.scalar;\n        if fun == ir::MF_DOT {\n            let mut accf: f32 = 0.0;\n            let mut acci: u32 = 0;\n            for k in 0..n {\n                let p = inv.mem[(a[0] + k) as usize];\n                let q = inv.mem[(a[1] + k) as usize];\n                if sk == SK_F32 {\n                    accf = accf + fl(p) * fl(q);\n                } else {\n                    acci = acci + p * q;\n                }\n            }\n            inv.mem[dst as usize] = if sk == SK_F32 { ub(accf) } else { acci };\n            return;\n        }\n        if fun == ir::MF_LENGTH || fun == ir::MF_DISTANCE || fun == ir::MF_NORMALIZE {\n            let mut acc: f32 = 0.0;\n            for k in 0..n {\n                let mut v = fl(inv.mem[(a[0] + k) as usize]);\n                if fun == ir::MF_DISTANCE {\n                    v = v - fl(inv.mem[(a[1] + k) as usize]);\n                }\n                acc = acc + v * v;\n            }\n            // UNSAFE: libm's sqrtf, a C call (see the extern block).\n            // SAFETY: values only: no pointer, defined for every f32 (NaN for a negative).\n            let len = unsafe { sqrtf(acc) };\n            if fun == ir::MF_NORMALIZE {\n                for k in 0..n {\n                    inv.mem[(dst + k) as usize] = ub(fl(inv.mem[(a[0] + k) as usize]) / len);\n                }\n");
    buf_str(out, c"            } else {\n                inv.mem[dst as usize] = ub(len);\n            }\n            return;\n        }\n        if fun == ir::MF_CROSS {\n            let p = [fl(inv.mem[a[0] as usize]), fl(inv.mem[(a[0] + 1) as usize]),\n                fl(inv.mem[(a[0] + 2) as usize])];\n            let q = [fl(inv.mem[a[1] as usize]), fl(inv.mem[(a[1] + 1) as usize]),\n                fl(inv.mem[(a[1] + 2) as usize])];\n            inv.mem[dst as usize] = ub(p[1] * q[2] - p[2] * q[1]);\n            inv.mem[(dst + 1) as usize] = ub(p[2] * q[0] - p[0] * q[2]);\n            inv.mem[(dst + 2) as usize] = ub(p[0] * q[1] - p[1] * q[0]);\n            return;\n        }\n        if fun == ir::MF_REFLECT || fun == ir::MF_FACE_FORWARD {\n            // reflect(e1, e2) = e1 - 2 * dot(e2, e1) * e2\n            // faceForward(e1, e2, e3) = if dot(e2, e3) < 0 { e1 } else { -e1 }\n            let p = if fun == ir::MF_REFLECT { a[1] } else { a[1] };\n            let q = if fun == ir::MF_REFLECT { a[0] } else { a[2] };\n            let mut d: f32 = 0.0;\n            for k in 0..n {\n                d = d + fl(inv.mem[(p + k) as usize]) * fl(inv.mem[(q + k) as usize]);\n            }\n            for k in 0..n {\n                let e1 = fl(inv.mem[(a[0] + k) as usize]);\n                inv.mem[(dst + k) as usize] = if fun\n                    == ir::MF_REFLECT { ub(e1 - 2.0 * d * fl(inv.mem[(a[1] + k) as usize])) }\n                    else if d < 0.0 { ub(e1) } else { ub(-e1) };\n            }\n            return;\n        }\n        if fun == ir::MF_ALL || fun == ir::MF_ANY {\n            let mut r = if fun == ir::MF_ALL { 1u32 } else { 0u32 };\n            for k in 0..n {\n                let v = inv.mem[(a[0] + k) as usize];\n                if fun == ir::MF_ALL && v == 0 {\n                    r = 0;\n                }\n                if fun == ir::MF_ANY && v != 0 {\n                    r = 1;\n                }\n            }\n            inv.mem[dst as usize] = r;\n");
    buf_str(out, c"            return;\n        }\n        if fun == ir::MF_DETERMINANT || fun == ir::MF_TRANSPOSE {\n            let cs = at.stride / 4;\n            if fun == ir::MF_TRANSPOSE {\n                let rt = m.types[x.ty as usize];\n                let rs = rt.stride / 4;\n                for c in 0..at.n {\n                    for k in 0..at.m {\n                        inv.mem[(dst + k * rs + c) as usize] = inv.mem[\n                            (a[0] + c * cs + k) as usize];\n                    }\n                }\n                return;\n            }\n            let mut mm: [f32; 16] = [0.0; 16];\n            for c in 0..at.n {\n                for k in 0..at.m {\n                    mm[(c * 4 + k) as usize] = fl(inv.mem[(a[0] + c * cs + k) as usize]);\n                }\n            }\n            inv.mem[dst as usize] = ub(determinant(mm, at.n));\n            return;\n        }\n        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n            || fun >= ir::MF_PACK4X8SNORM {\n            self.packing(inv, fun, a[0], dst);\n            return;\n        }\n        // component-wise\n        let mix_scalar = false;\n        let _ = mix_scalar;\n        for k in 0..n {\n            let p = inv.mem[(a[0] + k) as usize];\n            let q = if nargs > 1 { inv.mem[(a[1] + k) as usize] } else { 0 };\n            let r = if nargs > 2 { inv.mem[(a[2] + k) as usize] } else { 0 };\n            let s = if nargs > 3 { inv.mem[(a[3] + k) as usize] } else { 0 };\n            if fun == ir::MF_EXTRACT_BITS {\n                inv.mem[(dst + k) as usize] = extract_bits(p, inv.mem[a[1] as usize],\n                    inv.mem[a[2] as usize], sk == SK_I32);\n                continue;\n            }\n            if fun == ir::MF_INSERT_BITS {\n                inv.mem[(dst + k) as usize] = insert_bits(p, q, inv.mem[a[2] as usize],\n                    inv.mem[a[3] as usize]);\n                continue;\n            }\n            let _ = s;\n");
    buf_str(out, c"            inv.mem[(dst + k) as usize] = component_math(fun, sk, p, q, r);\n        }\n    }\n\n    fn packing(&self, inv: &mut Inv<A>, fun: i64, src: i64, dst: i64) {\n        if fun == ir::MF_PACK4X8UNORM || fun == ir::MF_PACK4X8SNORM {\n            let mut r: u32 = 0;\n            for k in 0..4 {\n                let v = fl(inv.mem[(src + k) as usize]);\n                let q = if fun == ir::MF_PACK4X8UNORM {\n                    (round_even(clampf(v, 0.0, 1.0) * 255.0) as i64) & 255\n                } else {\n                    (round_even(clampf(v, -1.0, 1.0) * 127.0) as i64) & 255\n                };\n                r = r | ((q as u32) << (8 * k) as u32);\n            }\n            inv.mem[dst as usize] = r;\n        } else if fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK4X8SNORM {\n            let v = inv.mem[src as usize];\n            for k in 0..4 {\n                let b = (v >> (8 * k) as u32) & 255;\n                inv.mem[(dst + k) as usize] = if fun == ir::MF_UNPACK4X8UNORM {\n                    ub(b as f32 / 255.0)\n                } else {\n                    let sb = if b >= 128 { b as i64 - 256 } else { b as i64 };\n                    ub(maxf(sb as f32 / 127.0, -1.0))\n                };\n            }\n        } else if fun == ir::MF_PACK2X16UNORM || fun == ir::MF_PACK2X16SNORM {\n            let mut r: u32 = 0;\n            for k in 0..2 {\n                let v = fl(inv.mem[(src + k) as usize]);\n                let q = if fun == ir::MF_PACK2X16UNORM {\n                    (round_even(clampf(v, 0.0, 1.0) * 65535.0) as i64) & 65535\n                } else {\n                    (round_even(clampf(v, -1.0, 1.0) * 32767.0) as i64) & 65535\n                };\n                r = r | ((q as u32) << (16 * k) as u32);\n            }\n            inv.mem[dst as usize] = r;\n        } else if fun == ir::MF_UNPACK2X16UNORM || fun == ir::MF_UNPACK2X16SNORM {\n            let v = inv.mem[src as usize];\n            for k in 0..2 {\n");
    buf_str(out, c"                let b = (v >> (16 * k) as u32) & 65535;\n                inv.mem[(dst + k) as usize] = if fun == ir::MF_UNPACK2X16UNORM {\n                    ub(b as f32 / 65535.0)\n                } else {\n                    let sb = if b >= 32768 { b as i64 - 65536 } else { b as i64 };\n                    ub(maxf(sb as f32 / 32767.0, -1.0))\n                };\n            }\n        } else if fun == ir::MF_PACK2X16FLOAT {\n            let lo = f32_to_f16(fl(inv.mem[src as usize]));\n            let hi = f32_to_f16(fl(inv.mem[(src + 1) as usize]));\n            inv.mem[dst as usize] = lo | (hi << 16);\n        } else {\n            let v = inv.mem[src as usize];\n            inv.mem[dst as usize] = ub(f16_to_f32(v & 65535));\n            inv.mem[(dst + 1) as usize] = ub(f16_to_f32(v >> 16));\n        }\n    }\n}\n\nfn clampf(x: f32, lo: f32, hi: f32) -> f32 { if x < lo { lo } else if x > hi { hi } else { x } }\n\nfn maxf(a: f32, b: f32) -> f32 { if a > b { a } else { b } }\n\nfn round_even(x: f32) -> f32 {\n    // UNSAFE: libm's rintf, a C call (see the extern block).\n    // SAFETY: a value in, a value out, defined for every f32; the default rounding mode, never\n    // changed by vole, makes it round half to even.\n    unsafe { rintf(x) }\n}\n\nfn f32_to_f16(x: f32) -> u32 {\n    let b = ub(x);\n    let sign = (b >> 16) & 32768;\n    let exp = ((b >> 23) & 255) as i64 - 127 + 15;\n    let man = b & 8388607;\n    if ((b >> 23) & 255) == 255 {\n        return sign | 31744 | (if man != 0 { 512 } else { 0 });\n    }\n    if exp >= 31 {\n        return sign | 31744;\n    }\n    if exp <= 0 {\n        if exp < -10 {\n            return sign;\n        }\n        let m2 = man | 8388608;\n        let shift = (14 - exp) as u32;\n        let mut h = m2 >> shift;\n        let rem = m2 & ((1u32 << shift) - 1);\n        let half = 1u32 << (shift - 1);\n        if rem > half || (rem == half && (h & 1) != 0) {\n            h += 1;\n        }\n        return sign | h;\n    }\n");
    buf_str(out, c"    let mut h = sign | ((exp as u32) << 10) | (man >> 13);\n    let rem = man & 8191;\n    if rem > 4096 || (rem == 4096 && (h & 1) != 0) {\n        h += 1;\n    }\n    h\n}\n\nfn f16_to_f32(h: u32) -> f32 {\n    let sign = (h & 32768) << 16;\n    let exp = (h >> 10) & 31;\n    let man = h & 1023;\n    if exp == 0 {\n        let v = man as f32 / 16777216.0;\n        return if sign != 0 { -v } else { v };\n    }\n    if exp == 31 {\n        return fl(sign | 2139095040 | (man << 13));\n    }\n    fl(sign | ((exp + 112) << 23) | (man << 13))\n}\n\nfn determinant(m: [f32; 16], n: i64) -> f32 {\n    if n == 2 {\n        return m[0] * m[5] - m[4] * m[1];\n    }\n    if n == 3 {\n        return m[0] * (m[5] * m[10] - m[9] * m[6]) - m[4] * (m[1] * m[10] - m[9] * m[2]) + m[8] * (\n            m[1] * m[6] - m[5] * m[2]);\n    }\n    let mut det: f32 = 0.0;\n    for c in 0..4 {\n        let mut sub: [f32; 16] = [0.0; 16];\n        let mut sc: i64 = 0;\n        for j in 0..4 {\n            if j == c {\n                continue;\n            }\n            for k in 1..4 {\n                sub[(sc * 4 + k - 1) as usize] = m[(j * 4 + k) as usize];\n            }\n            sc += 1;\n        }\n        let d = determinant(sub, 3);\n        det = if c % 2 == 0 { det + m[(c * 4) as usize] * d }\n            else { det - m[(c * 4) as usize] * d };\n    }\n    det\n}\n\npub fn convert(v: u32, from: u8, to: u8) -> u32 {\n    if from == to {\n        return v;\n    }\n    if to == SK_BOOL {\n        return if from == SK_F32 { if fl(v) != 0.0 { 1 } else { 0 } } else if v != 0 { 1 }\n            else { 0 };\n    }\n    if from == SK_BOOL {\n        return if to == SK_F32 { if v != 0 { ub(1.0) } else { 0 } } else { v };\n    }\n    if to == SK_F32 {\n        return if from == SK_I32 { ub(si(v) as f32) } else { ub(v as i64 as f32) };\n    }\n    if from == SK_F32 {\n        let x = fl(v);\n        if x != x {\n            return 0;\n        }\n        if to == SK_I32 {\n");
    buf_str(out, c"            if x <= -2147483648.0 {\n                return 2147483648;\n            }\n            // WGSL: the nearest value representable in both i32 and f32\n            if x >= 2147483520.0 {\n                return 2147483520;\n            }\n            return (x as i64) as u32;\n        }\n        if x <= 0.0 {\n            return 0;\n        }\n        if x >= 4294967040.0 {\n            return 4294967040;\n        }\n        return (x as i64) as u32;\n    }\n    // i32 <-> u32: the bits\n    v\n}\n\npub fn scalar_binary(op: i64, sk: u8, a: u32, b: u32) -> u32 {\n    if sk == SK_F32 {\n        let x = fl(a);\n        let y = fl(b);\n        if op == OP_ADD {\n            return ub(x + y);\n        }\n        if op == OP_SUB {\n            return ub(x - y);\n        }\n        if op == OP_MUL {\n            return ub(x * y);\n        }\n        if op == OP_DIV {\n            return ub(x / y);\n        }\n        if op == OP_MOD {\n            // WGSL: x - y * trunc(x / y)\n            // UNSAFE: libm's fmodf, a C call (see the extern block).\n            // SAFETY: values only, defined for every pair of f32s (NaN for y == 0).\n            return ub(unsafe { fmodf(x, y) });\n        }\n        let c = if op == OP_EQ { x == y } else if op == OP_NE { x != y }\n            else if op == OP_LT { x < y } else if op == OP_LE { x <= y }\n            else if op == OP_GT { x > y } else { x >= y };\n        return if c { 1 } else { 0 };\n    }\n    if op == OP_ADD {\n        return a + b;\n    }\n    if op == OP_SUB {\n        return a - b;\n    }\n    if op == OP_MUL {\n        return a * b;\n    }\n    if op == OP_DIV {\n        if b == 0 {\n            return a;\n        }\n        if sk == SK_I32 {\n            if a == 2147483648 && b == 4294967295 {\n                return a;\n            }\n            return (si(a) / si(b)) as u32;\n        }\n        return a / b;\n    }\n    if op == OP_MOD {\n        if b == 0 {\n            return 0;\n        }\n");
    buf_str(out, c"        if sk == SK_I32 {\n            if a == 2147483648 && b == 4294967295 {\n                return 0;\n            }\n            return (si(a) % si(b)) as u32;\n        }\n        return a % b;\n    }\n    if op == OP_AND || op == OP_LAND {\n        return a & b;\n    }\n    if op == OP_OR || op == OP_LOR {\n        return a | b;\n    }\n    if op == OP_XOR {\n        return a ^ b;\n    }\n    if op == OP_SHL {\n        return a << (b & 31);\n    }\n    if op == OP_SHR {\n        if sk == SK_I32 {\n            return (si(a) >> (b & 31) as i64) as u32;\n        }\n        return a >> (b & 31);\n    }\n    let c = if sk == SK_I32 {\n        let x = si(a);\n        let y = si(b);\n        if op == OP_EQ { x == y } else if op == OP_NE { x != y } else if op == OP_LT { x < y }\n        else if op == OP_LE { x <= y } else if op == OP_GT { x > y } else { x >= y }\n    } else {\n        if op == OP_EQ { a == b } else if op == OP_NE { a != b } else if op == OP_LT { a < b }\n        else if op == OP_LE { a <= b } else if op == OP_GT { a > b } else { a >= b }\n    };\n    if c { 1 } else { 0 }\n}\n\nfn extract_bits(e: u32, offset: u32, count: u32, signed: bool) -> u32 {\n    let o = if offset > 32 { 32 } else { offset };\n    let c = if count > 32 - o { 32 - o } else { count };\n    if c == 0 {\n        return 0;\n    }\n    let v = if o == 32 { 0 } else { e >> o };\n    if c == 32 {\n        return v;\n    }\n    let mask = (1u32 << c) - 1;\n    let r = v & mask;\n    if signed && (r >> (c - 1)) & 1 != 0 {\n        return r | !mask;\n    }\n    r\n}\n\nfn insert_bits(e: u32, nb: u32, offset: u32, count: u32) -> u32 {\n    let o = if offset > 32 { 32 } else { offset };\n    let c = if count > 32 - o { 32 - o } else { count };\n    if c == 0 {\n        return e;\n    }\n    let mask = if c == 32 { 4294967295u32 } else { ((1u32 << c) - 1) << o };\n    (e & !mask) | ((nb << o) & mask)\n}\n\nfn clz(x: u32) -> u32 {\n    if x == 0 {\n        return 32;\n    }\n");
    buf_str(out, c"    crate::leading_zeros(x as u64) as u32 - 32\n}\n\nfn ctz(x: u32) -> u32 {\n    if x == 0 {\n        return 32;\n    }\n    crate::trailing_zeros(x as u64) as u32\n}\n\npub fn component_math(fun: i64, sk: u8, p: u32, q: u32, r: u32) -> u32 {\n    if sk != SK_F32 {\n        let signed = sk == SK_I32;\n        if fun == ir::MF_ABS {\n            return if signed && si(p) < 0 { 0 - p } else { p };\n        }\n        if fun == ir::MF_MIN {\n            return if (signed && si(q) < si(p)) || (!signed && q < p) { q } else { p };\n        }\n        if fun == ir::MF_MAX {\n            return if (signed && si(q) > si(p)) || (!signed && q > p) { q } else { p };\n        }\n        if fun == ir::MF_CLAMP {\n            let lo = component_math(ir::MF_MAX, sk, p, q, 0);\n            return component_math(ir::MF_MIN, sk, lo, r, 0);\n        }\n        if fun == ir::MF_SIGN {\n            return if si(p) > 0 { 1 } else if si(p) < 0 { 4294967295 } else { 0 };\n        }\n        if fun == ir::MF_COUNT_ONE_BITS {\n            let mut c: u32 = 0;\n            let mut x = p;\n            while x != 0 {\n                c += x & 1;\n                x = x >> 1;\n            }\n            return c;\n        }\n        if fun == ir::MF_COUNT_LEADING_ZEROS {\n            return clz(p);\n        }\n        if fun == ir::MF_COUNT_TRAILING_ZEROS {\n            return ctz(p);\n        }\n        if fun == ir::MF_FIRST_LEADING_BIT {\n            let x = if signed && si(p) < 0 { !p } else { p };\n            if x == 0 {\n                return 4294967295;\n            }\n            return 31 - clz(x);\n        }\n        if fun == ir::MF_FIRST_TRAILING_BIT {\n            if p == 0 {\n                return 4294967295;\n            }\n            return ctz(p);\n        }\n        if fun == ir::MF_REVERSE_BITS {\n            let mut x = p;\n            let mut rr: u32 = 0;\n            for _ in 0..32 {\n                rr = (rr << 1) | (x & 1);\n                x = x >> 1;\n            }\n");
    buf_str(out, c"            return rr;\n        }\n        return 0;\n    }\n    let x = fl(p);\n    let y = fl(q);\n    let z = fl(r);\n    // UNSAFE: the libm calls below are C calls (see the extern block); one block holds them all.\n    // SAFETY: each takes and returns f32 values, no pointer, and is defined for every input\n    // (NaN or an infinity out of a domain error; errno is not read); ldexpf's exponent is an i32.\n    let v: f32 = unsafe {\n        if fun == ir::MF_ABS {\n            if x < 0.0 { -x } else if x == 0.0 { 0.0 } else { x }\n        } else if fun == ir::MF_MIN {\n            fminf(x, y)\n        } else if fun == ir::MF_MAX {\n            fmaxf(x, y)\n        } else if fun == ir::MF_CLAMP {\n            fminf(fmaxf(x, y), z)\n        } else if fun == ir::MF_SIGN {\n            if x > 0.0 { 1.0 } else if x < 0.0 { -1.0 } else { 0.0 }\n        } else if fun == ir::MF_FLOOR {\n            floorf(x)\n        } else if fun == ir::MF_CEIL {\n            ceilf(x)\n        } else if fun == ir::MF_ROUND {\n            rintf(x)\n        } else if fun == ir::MF_FRACT {\n            x - floorf(x)\n        } else if fun == ir::MF_TRUNC {\n            truncf(x)\n        } else if fun == ir::MF_SQRT {\n            sqrtf(x)\n        } else if fun == ir::MF_INVERSE_SQRT {\n            1.0 / sqrtf(x)\n        } else if fun == ir::MF_EXP {\n            expf(x)\n        } else if fun == ir::MF_EXP2 {\n            exp2f(x)\n        } else if fun == ir::MF_LOG {\n            logf(x)\n        } else if fun == ir::MF_LOG2 {\n            log2f(x)\n        } else if fun == ir::MF_POW {\n            powf(x, y)\n        } else if fun == ir::MF_SIN {\n            sinf(x)\n        } else if fun == ir::MF_COS {\n            cosf(x)\n        } else if fun == ir::MF_TAN {\n            tanf(x)\n        } else if fun == ir::MF_ASIN {\n            asinf(x)\n        } else if fun == ir::MF_ACOS {\n            acosf(x)\n        } else if fun == ir::MF_ATAN {\n            atanf(x)\n");
    buf_str(out, c"        } else if fun == ir::MF_ATAN2 {\n            atan2f(x, y)\n        } else if fun == ir::MF_SINH {\n            sinhf(x)\n        } else if fun == ir::MF_COSH {\n            coshf(x)\n        } else if fun == ir::MF_TANH {\n            tanhf(x)\n        } else if fun == ir::MF_ASINH {\n            asinhf(x)\n        } else if fun == ir::MF_ACOSH {\n            acoshf(x)\n        } else if fun == ir::MF_ATANH {\n            atanhf(x)\n        } else if fun == ir::MF_MIX {\n            x * (1.0 - z) + y * z\n        } else if fun == ir::MF_STEP {\n            if y >= x { 1.0 } else { 0.0 }\n        } else if fun == ir::MF_SMOOTHSTEP {\n            let t = clampf((z - x) / (y - x), 0.0, 1.0);\n            t * t * (3.0 - 2.0 * t)\n        } else if fun == ir::MF_FMA {\n            fmaf(x, y, z)\n        } else if fun == ir::MF_DEGREES {\n            x * 57.295779513082322865\n        } else if fun == ir::MF_RADIANS {\n            x * 0.017453292519943295\n        } else if fun == ir::MF_SATURATE {\n            clampf(x, 0.0, 1.0)\n        } else if fun == ir::MF_LDEXP {\n            ldexpf(x, q as i32)\n        } else {\n            0.0\n        }\n    };\n    ub(v)\n}\n// ---- end mod std::gpu::wgsl::interp ----\n}\n// ---- mod std::gpu::wgsl::dump ----\npub mod dump {\n// ---- Shader compiler implementation, dump (0.22) ----\n// The IR as text: `wgslc ir FILE`, and the front end's golden tests.\n\nuse crate::alloc::Allocator;\n\nuse super::ir::{\n    E_ACCESS, E_ACCESS_INDEX, E_ARG, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BINARY, E_BITCAST,\n    E_CALL_RESULT, E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY,\n    E_IMAGE_SAMPLE, E_LITERAL, E_LOAD, E_LOCAL, E_MATH, E_SELECT, E_SPLAT, E_SWIZZLE, E_UNARY,\n    E_WG_UNIFORM_RESULT, E_ZERO, Function, Module, SK_BOOL, SK_F32, SK_I32, S_ATOMIC, S_BARRIER,\n    S_BLOCK, S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_IMAGE_STORE, S_KILL, S_LOOP, S_RETURN,\n");
    buf_str(out, c"    S_STORE, S_SWITCH, S_WG_UNIFORM_LOAD, bits_f32,\n};\n\nconst UN: [&[u8]; 3] = [b\"neg\", b\"not\", b\"bitnot\"];\nconst BIN: [&[u8]; 18] = [b\"add\", b\"sub\", b\"mul\", b\"div\", b\"mod\", b\"eq\", b\"ne\", b\"lt\", b\"le\", b\"gt\",\n    b\"ge\", b\"and\", b\"or\", b\"xor\", b\"shl\", b\"shr\", b\"land\", b\"lor\"];\nconst ATOM: [&[u8]; 11] = [b\"add\", b\"sub\", b\"and\", b\"or\", b\"xor\", b\"min\", b\"max\", b\"exchange\",\n    b\"load\", b\"store\", b\"cmpxchg\"];\nconst CK: [&[u8]; 4] = [b\"pending\", b\"none\", b\"clamp\", b\"rzsw\"];\n\npub(crate) fn dump<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, b: &mut Vec<u8, B>) {\n    for t in ir::T_FIXED_COUNT..m.types.len() as i64 {\n        let ty = m.types[t as usize];\n        if ty.kind == ir::TK_STRUCT {\n            write(b, \"struct {} (size {}, align {}) {{\", str::from_utf8(ty.name).unwrap(), ty.size,\n                ty.align).unwrap();\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                let mem = m.members[i as usize];\n                write(b, \" {}: \", str::from_utf8(mem.name).unwrap()).unwrap();\n                m.type_name(mem.ty, b);\n                write(b, \" @{};\", mem.offset).unwrap();\n            }\n            b.extend_from_slice(b\" }\\n\");\n        }\n    }\n    for g in 0..m.globals.len() as i64 {\n        let gl = m.globals[g as usize];\n        write(b, \"global {g} {}: {}\", str::from_utf8(gl.name).unwrap(),\n            str::from_utf8(ir::space_name(gl.space)).unwrap()).unwrap();\n        if gl.space == ir::SP_STORAGE {\n            b.extend_from_slice(\n                (if gl.access == ir::ACC_RW { \" read_write\" } else { \" read\" }).as_bytes());\n        }\n        b.push(b' ');\n        m.type_name(gl.ty, b);\n        if gl.group >= 0 {\n            write(b, \" @group({}) @binding({})\", gl.group, gl.binding).unwrap();\n        }\n        if gl.init >= 0 {\n            b.extend_from_slice(b\" = \");\n");
    buf_str(out, c"            expr_text(m, &m.consts, gl.init, b);\n        }\n        b.push(b'\\n');\n    }\n    for e in 0..m.entries.len() as i64 {\n        let en = m.entries[e as usize];\n        write(b, \"entry {} {} = fn {}\", str::from_utf8(entry::stage_name(en.stage)).unwrap(),\n            str::from_utf8(en.name).unwrap(), en.func).unwrap();\n        if en.stage == ir::STAGE_COMPUTE {\n            write(b, \" workgroup_size({}, {}, {})\", en.wg[0], en.wg[1], en.wg[2]).unwrap();\n        }\n        b.push(b'\\n');\n    }\n    for i in 0..m.functions.len() as i64 {\n        dump_fn(m, i, b);\n    }\n}\n\nfn binding_text<A: Allocator>(bd: ir::Binding, b: &mut Vec<u8, A>) {\n    if bd.kind == ir::BIND_BUILTIN {\n        write(b, \" @builtin({})\", str::from_utf8(entry::builtin_name(bd.value)).unwrap()).unwrap();\n    } else if bd.kind == ir::BIND_LOCATION {\n        write(b, \" @location({})\", bd.value).unwrap();\n        if bd.interp == ir::INTERP_FLAT {\n            b.extend_from_slice(b\" @interpolate(flat)\");\n        }\n    }\n}\n\nfn dump_fn<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, h: i64, b: &mut Vec<u8, B>) {\n    let f = &m.functions[h as usize];\n    write(b, \"fn {h} {}(\", str::from_utf8(f.name).unwrap()).unwrap();\n    for i in 0..f.params.len() as i64 {\n        if i > 0 {\n            b.extend_from_slice(b\", \");\n        }\n        write(b, \"{}: \", str::from_utf8(f.params[i as usize].name).unwrap()).unwrap();\n        m.type_name(f.params[i as usize].ty, b);\n        binding_text(f.params[i as usize].binding, b);\n    }\n    b.extend_from_slice(b\") -> \");\n    m.type_name(f.result, b);\n    binding_text(f.result_binding, b);\n    b.push(b'\\n');\n    for i in 0..f.locals.len() as i64 {\n        write(b, \"  local {i} {}: \", str::from_utf8(f.locals[i as usize].name).unwrap()).unwrap();\n        m.type_name(f.locals[i as usize].ty, b);\n        b.push(b'\\n');\n    }\n    for e in 0..f.exprs.len() as i64 {\n");
    buf_str(out, c"        write(b, \"  e{e}: \").unwrap();\n        m.type_name(f.exprs[e as usize].ty, b);\n        b.extend_from_slice(b\" = \");\n        expr_text(m, &f, e, b);\n        if f.names[e as usize].len() as i64 > 0 {\n            write(b, \"  // {}\", str::from_utf8(f.names[e as usize]).unwrap()).unwrap();\n        }\n        b.push(b'\\n');\n    }\n    if f.body >= 0 {\n        block_text(m, &f, f.body, 1i64, b);\n    }\n}\n\nfn indent<A: Allocator>(n: i64, b: &mut Vec<u8, A>) {\n    for _ in 0..n {\n        b.extend_from_slice(b\"  \");\n    }\n}\n\nfn block_text<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>, blk: i64,\n    depth: i64, b: &mut Vec<u8, B>) {\n    let bl = f.blocks[blk as usize];\n    for i in bl.start..bl.start + bl.count {\n        stmt_text(m, f, f.items[i as usize], depth, b);\n    }\n}\n\nfn stmt_text<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>, s: i64,\n    depth: i64, b: &mut Vec<u8, B>) {\n    let st = f.stmts[s as usize];\n    indent(depth, b);\n    if st.op == S_EMIT {\n        write(b, \"emit e{}..e{}\\n\", st.a, st.b).unwrap();\n    } else if st.op == S_BLOCK {\n        b.extend_from_slice(b\"block\\n\");\n        block_text(m, f, st.a, depth + 1, b);\n    } else if st.op == S_IF {\n        write(b, \"if e{}\\n\", st.a).unwrap();\n        block_text(m, f, st.b, depth + 1, b);\n        if f.blocks[st.c as usize].count > 0 {\n            indent(depth, b);\n            b.extend_from_slice(b\"else\\n\");\n            block_text(m, f, st.c, depth + 1, b);\n        }\n    } else if st.op == S_SWITCH {\n        write(b, \"switch e{}\\n\", st.a).unwrap();\n        for i in st.b..st.b + st.c {\n            let c = f.cases[i as usize];\n            indent(depth, b);\n            b.extend_from_slice(b\"case\");\n            for k in c.vstart..c.vstart + c.vcount {\n                write(b, \" {}\", f.vals[k as usize]).unwrap();\n            }\n            if c.is_default {\n");
    buf_str(out, c"                b.extend_from_slice(b\" default\");\n            }\n            b.push(b'\\n');\n            block_text(m, f, c.body, depth + 1, b);\n        }\n    } else if st.op == S_LOOP {\n        b.extend_from_slice(b\"loop\\n\");\n        block_text(m, f, st.a, depth + 1, b);\n        if f.blocks[st.b as usize].count > 0 || st.c >= 0 {\n            indent(depth, b);\n            b.extend_from_slice(b\"continuing\\n\");\n            block_text(m, f, st.b, depth + 1, b);\n            if st.c >= 0 {\n                indent(depth + 1, b);\n                write(b, \"break if e{}\\n\", st.c).unwrap();\n            }\n        }\n    } else if st.op == S_BREAK {\n        b.extend_from_slice(b\"break\\n\");\n    } else if st.op == S_CONTINUE {\n        b.extend_from_slice(b\"continue\\n\");\n    } else if st.op == S_RETURN {\n        if st.a >= 0 {\n            write(b, \"return e{}\\n\", st.a).unwrap();\n        } else {\n            b.extend_from_slice(b\"return\\n\");\n        }\n    } else if st.op == S_KILL {\n        b.extend_from_slice(b\"discard\\n\");\n    } else if st.op == S_BARRIER {\n        b.extend_from_slice((if st.a == ir::BARRIER_WORKGROUP { \"barrier workgroup\\n\" }\n            else { \"barrier storage\\n\" }).as_bytes());\n    } else if st.op == S_STORE {\n        write(b, \"store e{} <- e{}\\n\", st.a, st.b).unwrap();\n    } else if st.op == S_CALL {\n        if st.d >= 0 {\n            write(b, \"e{} = \", st.d).unwrap();\n        }\n        write(b, \"call fn {}(\", st.a).unwrap();\n        for i in st.b..st.b + st.c {\n            if i > st.b {\n                b.extend_from_slice(b\", \");\n            }\n            write(b, \"e{}\", f.args[i as usize]).unwrap();\n        }\n        b.extend_from_slice(b\")\\n\");\n    } else if st.op == S_ATOMIC {\n        if st.d >= 0 {\n            write(b, \"e{} = \", st.d).unwrap();\n        }\n        write(b, \"atomic {} e{}\", str::from_utf8(ATOM[st.b as usize]).unwrap(), st.a).unwrap();\n");
    buf_str(out, c"        if st.e >= 0 {\n            write(b, \" cmp e{}\", st.e).unwrap();\n        }\n        if st.c >= 0 {\n            write(b, \" e{}\", st.c).unwrap();\n        }\n        b.push(b'\\n');\n    } else if st.op == S_IMAGE_STORE {\n        write(b, \"image_store e{} at e{} <- e{}\\n\", st.a, st.b, st.c).unwrap();\n    } else if st.op == S_WG_UNIFORM_LOAD {\n        write(b, \"e{} = workgroup_uniform_load e{}\\n\", st.b, st.a).unwrap();\n    }\n}\n\npub(crate) fn expr_text<B: Allocator, A: Allocator + Copy>(m: &Module<'_, A>, f: &Function<'_, A>,\n    e: i64, b: &mut Vec<u8, B>) {\n    let x = f.exprs[e as usize];\n    let op = x.op;\n    if op == E_LITERAL {\n        let sk = m.types[x.ty as usize].scalar;\n        if sk == SK_BOOL {\n            b.extend_from_slice((if x.a != 0 { \"true\" } else { \"false\" }).as_bytes());\n        } else if sk == SK_F32 {\n            write(b, \"{}\", bits_f32(x.a as u32)).unwrap();\n        } else if sk == SK_I32 {\n            write(b, \"{}i\", x.a as u32 as i32).unwrap();\n        } else {\n            write(b, \"{}u\", x.a).unwrap();\n        }\n    } else if op == E_ZERO {\n        b.extend_from_slice(b\"zero\");\n    } else if op == E_COMPOSE {\n        b.extend_from_slice(b\"compose(\");\n        args_text(f, x.a, x.b, b);\n        b.push(b')');\n    } else if op == E_SPLAT {\n        write(b, \"splat(e{})\", x.a).unwrap();\n    } else if op == E_SWIZZLE {\n        write(b, \"e{}.\", x.a).unwrap();\n        for i in 0..x.c {\n            b.push(\"xyzw\"[((x.b >> (2 * i)) & 3) as usize]);\n        }\n    } else if op == E_ACCESS {\n        write(b, \"e{}[e{}] check {}\", x.a, x.b, str::from_utf8(CK[x.c as usize]).unwrap()).unwrap();\n        if x.c == ir::CK_CLAMP {\n            write(b, \" {}\", x.d).unwrap();\n        }\n    } else if op == E_ACCESS_INDEX {\n        write(b, \"e{}.{}\", x.a, x.b).unwrap();\n    } else if op == E_ARG {\n        write(b, \"arg {}\", x.a).unwrap();\n    } else if op == E_GLOBAL {\n");
    buf_str(out, c"        write(b, \"global {}\", x.a).unwrap();\n    } else if op == E_LOCAL {\n        write(b, \"local {}\", x.a).unwrap();\n    } else if op == E_LOAD {\n        write(b, \"load e{}\", x.a).unwrap();\n    } else if op == E_UNARY {\n        write(b, \"{} e{}\", str::from_utf8(UN[x.a as usize]).unwrap(), x.b).unwrap();\n    } else if op == E_BINARY {\n        write(b, \"{} e{} e{}\", str::from_utf8(BIN[x.a as usize]).unwrap(), x.b, x.c).unwrap();\n    } else if op == E_SELECT {\n        write(b, \"select e{} ? e{} : e{}\", x.a, x.b, x.c).unwrap();\n    } else if op == E_MATH {\n        b.extend_from_slice(names::PREDECLARED[(names::K_MATH_FIRST + x.a) as usize]);\n        b.push(b'(');\n        args_text(f, x.b, x.c, b);\n        b.push(b')');\n    } else if op == E_CONVERT {\n        write(b, \"convert e{}\", x.a).unwrap();\n    } else if op == E_BITCAST {\n        write(b, \"bitcast e{}\", x.a).unwrap();\n    } else if op == E_CALL_RESULT {\n        b.extend_from_slice(b\"call result\");\n    } else if op == E_ATOMIC_RESULT {\n        b.extend_from_slice(b\"atomic result\");\n    } else if op == E_WG_UNIFORM_RESULT {\n        b.extend_from_slice(b\"workgroup uniform load result\");\n    } else if op == E_ARRAY_LENGTH {\n        write(b, \"array_length global {} member {} offset {} stride {}\", x.a, x.b, x.c, x.d).unwrap();\n    } else if op == E_DERIVATIVE {\n        write(b, \"derivative {} e{}\", x.a, x.b).unwrap();\n    } else if op == E_IMAGE_SAMPLE {\n        write(b, \"sample {} e{} e{} (\", x.d & 255, x.a, x.b).unwrap();\n        args_text(f, x.c, x.d >> 8, b);\n        b.push(b')');\n    } else if op == E_IMAGE_LOAD {\n        write(b, \"image_load e{} (\", x.a).unwrap();\n        args_text(f, x.c, x.d, b);\n        b.push(b')');\n    } else if op == E_IMAGE_QUERY {\n        write(b, \"image_query {} e{}\", x.b, x.a).unwrap();\n        if x.c >= 0 {\n            write(b, \" level e{}\", x.c).unwrap();\n        }\n    }\n}\n\n");
    buf_str(out, c"fn args_text<B: Allocator, A: Allocator + Copy>(f: &Function<'_, A>, start: i64, n: i64,\n    b: &mut Vec<u8, B>) {\n    for i in start..start + n {\n        if i > start {\n            b.extend_from_slice(b\", \");\n        }\n        write(b, \"e{}\", f.args[i as usize]).unwrap();\n    }\n}\n// ---- end mod std::gpu::wgsl::dump ----\n}\n// ---- mod std::gpu::wgsl::job ----\npub mod job {\n// ---- Shader compiler implementation, job (0.22) ----\n// Jobs: a compute dispatch with its buffers, run by the interpreter\n// (`wgslc run`) or turned into the input of tests/wgsl/metalrun\n// (`wgslc metal-job`), whose output has the same form, so the two compare\n// as text. A job file:\n//\n//   entry NAME                  the entry point (default: the first compute one)\n//   dispatch X Y Z              workgroups\n//   buffer G B BYTES [random SEED | WORD...]   a binding's size and contents\n//\n// Words are decimal or 0x hex; missing words are zero. The output is each\n// buffer, in the job's order: `buffer G B`, then its words in hex.\n\nuse crate::alloc::Allocator;\n\nuse super::ir::{Module, STAGE_COMPUTE, V};\n\npub struct JobBuffer<A: Allocator> {\n    pub group: i64, pub binding: i64, pub bytes: i64, pub words: Vec<u32, A>,\n}\n\n// A texture: its format (`rgba8unorm`, `r8unorm`, `rgba32float`,\n// `rgba32uint`) and texels as words (rgba8unorm: one a texel; r8unorm:\n// four texels a word; the 32-bit formats: four words a texel).\npub struct JobTexture<'a, A: Allocator> {\n    pub group: i64, pub binding: i64, pub format: &'a [u8], pub w: i64, pub h: i64,\n    pub words: Vec<u32, A>,\n}\n\n// call_n >= 0: a call job (`call ENTRY N`): the entry runs once per input\n// record (`input BYTES ...`), its results printed as `buffer -2 0`.\npub struct Job<'a, A: Allocator> {\n    pub entry: &'a [u8], pub groups: [i64; 3], pub buffers: Vec<JobBuffer<A>, A>, pub call_n: i64,\n    pub input: Vec<u32, A>,\n    pub textures: Vec<JobTexture<'a, A>, A>,\n}\n\n");
    buf_str(out, c"fn xorshift(s: &mut u32) -> u32 {\n    let mut x = *s;\n    x = x ^ (x << 13);\n    x = x ^ (x >> 17);\n    x = x ^ (x << 5);\n    *s = x;\n    x\n}\n\n// A job word: decimal, 0x hex, or a float with a point (its f32 bits).\nfn parse_word(t: &[u8]) -> Option<u32> {\n    for i in 0..t.len() as i64 {\n        if t[i as usize] == b'.' {\n            let s = match str::from_utf8(t) {\n                Ok(s) => s,\n                Err(_) => return None,\n            };\n            return match s.parse::<f64>() {\n                Ok(v) => Some(ir::f32_bits(v as f32)),\n                Err(_) => None,\n            };\n        }\n    }\n    if t.len() as i64 > 2 && t[0] == b'0' && (t[1] == b'x' || t[1] == b'X') {\n        let mut v: u64 = 0;\n        for i in 2..t.len() as i64 {\n            let c = t[i as usize];\n            let d = if c >= b'0' && c <= b'9' { c - b'0' }\n                else if c >= b'a' && c <= b'f' { c - b'a' + 10 }\n                else if c >= b'A' && c <= b'F' { c - b'A' + 10 } else { return None; };\n            v = v * 16 + d as u64;\n        }\n        return Some(v as u32);\n    }\n    match int_of(t) {\n        Some(v) => Some(v as u32),\n        None => None,\n    }\n}\n\n// The decimal integer t is (a sign, digits), or None.\nfn int_of(t: &[u8]) -> Option<i64> {\n    match str::from_utf8(t) {\n        Ok(s) => s.parse::<i64>().ok(),\n        Err(_) => None,\n    }\n}\n\n// The runs of non-whitespace of a line, as views of it.\nfn words_in<'a, A: Allocator + Copy>(line: &'a [u8], a: A) -> Vec<&'a [u8], A> {\n    let mut words: Vec<&'a [u8], A> = Vec::new_in(a);\n    let mut i: usize = 0;\n    while i < line.len() {\n        if line[i] == b' ' || line[i] == b'\\t' || line[i] == b'\\r' || line[i] == b'\\n' {\n            i += 1;\n            continue;\n        }\n        let st = i;\n        while i < line.len()\n            && !(line[i] == b' ' || line[i] == b'\\t' || line[i] == b'\\r' || line[i] == b'\\n') {\n            i += 1;\n        }\n");
    buf_str(out, c"        words.push(&line[st..i]);\n    }\n    words\n}\n\n// words[from ..]: `random SEED` or the words themselves.\nfn fill_words<B: Allocator, A: Allocator + Copy>(v: &mut Vec<u32, A>, words: &Vec<&[u8], A>,\n    from: i64, err: &mut Vec<u8, B>) -> bool {\n    if words.len() as i64 >= from + 2 && words[from as usize] == b\"random\" {\n        let mut s = parse_word(words[(from + 1) as usize]).unwrap_or(1u32);\n        if s == 0 {\n            s = 1;\n        }\n        for k in 0..v.len() as i64 {\n            v[k as usize] = xorshift(&mut s);\n        }\n        return true;\n    }\n    for k in from..words.len() as i64 {\n        if k - from >= v.len() as i64 {\n            break;\n        }\n        match parse_word(words[k as usize]) {\n            Some(x) => v[(k - from) as usize] = x,\n            None => {\n                err.extend_from_slice(b\"not a word: '\");\n                err.extend_from_slice(words[k as usize]);\n                err.push(b'\\'');\n                return false;\n            }\n        }\n    }\n    true\n}\n\n// A job texture's texels as the interpreter holds them: four words each,\n// f32 bits for the unorm and float formats (unorm: n / 255).\npub fn texels<A: Allocator + Copy>(t: &JobTexture<'_, A>, a: A) -> Vec<u32, A> {\n    let n = t.w * t.h;\n    let mut v: Vec<u32, A> = Vec::from_elem_in(0u32, (4 * n as usize), a);\n    for i in 0..n {\n        if t.format == b\"rgba8unorm\" {\n            let x = t.words[i as usize];\n            for c in 0..4 {\n                let b = (x >> (8 * c) as u32) & 255;\n                v[(4 * i + c) as usize] = ir::f32_bits(b as f32 / 255.0);\n            }\n        } else if t.format == b\"r8unorm\" {\n            let b = (t.words[(i / 4) as usize] >> (8 * (i % 4)) as u32) & 255;\n            v[(4 * i) as usize] = ir::f32_bits(b as f32 / 255.0);\n            v[(4 * i + 3) as usize] = ir::f32_bits(1.0);\n        } else {\n            for c in 0..4 {\n");
    buf_str(out, c"                v[(4 * i + c) as usize] = t.words[(4 * i + c) as usize];\n            }\n        }\n    }\n    v\n}\n\n// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form\n// is std's own until 0.27.\npub fn parse_job<'a, B: Allocator + Copy, A: Allocator + Copy>(text: &'a [u8], a: A,\n    err: &mut String<B>) -> Option<Job<'a, A>> {\n    let mut b = Vec::<u8, _>::new_in(*err.allocator());\n    let job = parse_job_buf(text, a, &mut b);\n    let t = String::from_utf8_lossy_in(b.as_slice(), *err.allocator());\n    err.push_str(t.as_str());\n    job\n}\n\npub(crate) fn parse_job_buf<'a, B: Allocator, A: Allocator + Copy>(text: &'a [u8], a: A,\n    err: &mut Vec<u8, B>) -> Option<Job<'a, A>> {\n    let mut job = Job {\n        entry: b\"\", groups: [1i64, 1, 1], buffers: Vec::new_in(a), call_n: -1,\n        input: Vec::new_in(a),\n        textures: Vec::new_in(a),\n    };\n    let mut at: usize = 0;\n    while at < text.len() {\n        let mut end = at;\n        while end < text.len() && text[end] != b'\\n' {\n            end += 1;\n        }\n        let line = &text[at..end];\n        at = if end < text.len() { end + 1 } else { end };\n        let words = words_in(line, a);\n        if words.len() as i64 == 0 || words[0][0] == b'#' {\n            continue;\n        }\n        let kw = words[0];\n        if kw == b\"entry\" && words.len() as i64 == 2 {\n            job.entry = words[1];\n        } else if kw == b\"dispatch\" && words.len() as i64 == 4 {\n            for k in 0..3 {\n                job.groups[k as usize] = int_of(words[(k + 1) as usize]).unwrap_or(1);\n            }\n        } else if kw == b\"call\" && words.len() as i64 == 3 {\n            job.entry = words[1];\n            job.call_n = int_of(words[2]).unwrap_or(0);\n        } else if kw == b\"input\" && words.len() as i64 >= 2 {\n            let bytes = int_of(words[1]).unwrap_or(0);\n            job.input = Vec::from_elem_in(0u32, (bytes as usize / 4), a);\n");
    buf_str(out, c"            if !fill_words(&mut job.input, &words, 2i64, err) {\n                return None;\n            }\n        } else if kw == b\"texture\" && words.len() as i64 >= 6 {\n            let w = int_of(words[4]).unwrap_or(0);\n            let h = int_of(words[5]).unwrap_or(0);\n            let fm = words[3];\n            let n: i64 = if fm == b\"rgba8unorm\" { w * h }\n                else if fm == b\"r8unorm\" { (w * h + 3) / 4 }\n                else if fm == b\"rgba32float\" || fm == b\"rgba32uint\" { 4 * w * h } else { -1 };\n            if n < 0 || w <= 0 || h <= 0 {\n                err.extend_from_slice(b\"a texture is FORMAT W H with a format of rgba8unorm, r8unorm, rgba32float, rgba32uint: \");\n                err.extend_from_slice(line);\n                return None;\n            }\n            let mut t = JobTexture {\n                group: int_of(words[1]).unwrap_or(0), binding: int_of(words[2]).unwrap_or(0),\n                format: fm, w: w, h: h, words: Vec::from_elem_in(0u32, (n as usize), a),\n            };\n            if !fill_words(&mut t.words, &words, 6i64, err) {\n                return None;\n            }\n            job.textures.push(t);\n        } else if kw == b\"buffer\" && words.len() as i64 >= 4 {\n            let bytes = int_of(words[3]).unwrap_or(0);\n            if bytes <= 0 || bytes % 4 != 0 {\n                err.extend_from_slice(b\"a buffer's size is a positive multiple of 4: \");\n                err.extend_from_slice(line);\n                return None;\n            }\n            let mut b = JobBuffer {\n                group: int_of(words[1]).unwrap_or(0), binding: int_of(words[2]).unwrap_or(0),\n                bytes: bytes, words: Vec::from_elem_in(0u32, (bytes as usize / 4), a),\n            };\n            if words.len() as i64 >= 6 && words[4] == b\"random\" {\n                let mut s = parse_word(words[5]).unwrap_or(1u32);\n                if s == 0 {\n                    s = 1;\n                }\n");
    buf_str(out, c"                for k in 0..bytes / 4 {\n                    b.words[k as usize] = xorshift(&mut s);\n                }\n            } else {\n                for k in 4..words.len() as i64 {\n                    if k - 4 >= bytes / 4 {\n                        break;\n                    }\n                    match parse_word(words[k as usize]) {\n                        Some(w) => b.words[(k - 4) as usize] = w,\n                        None => {\n                            err.extend_from_slice(b\"not a word: '\");\n                            err.extend_from_slice(words[k as usize]);\n                            err.push(b'\\'');\n                            return None;\n                        }\n                    }\n                }\n            }\n            job.buffers.push(b);\n        } else {\n            err.extend_from_slice(b\"cannot read this job line: \");\n            err.extend_from_slice(line);\n            return None;\n        }\n    }\n    Some(job)\n}\n\n// The entry point a job names (or the first compute one), or -1.\npub fn find_entry<A: Allocator + Copy>(m: &Module<'_, A>, name: &[u8]) -> i64 {\n    for e in 0..m.entries.len() as i64 {\n        if m.entries[e as usize].stage == STAGE_COMPUTE\n            && (name.len() as i64 == 0 || m.entries[e as usize].name == name) {\n            return e;\n        }\n    }\n    -1\n}\n\n// The entry point of any stage named `name`, or -1.\npub fn find_any_entry<A: Allocator + Copy>(m: &Module<'_, A>, name: &[u8]) -> i64 {\n    for e in 0..m.entries.len() as i64 {\n        if m.entries[e as usize].name == name {\n            return e;\n        }\n    }\n    -1\n}\n\n// The global bound at (group, binding), or -1.\npub fn find_global<A: Allocator + Copy>(m: &Module<'_, A>, g: i64, b: i64) -> i64 {\n    for i in 0..m.globals.len() as i64 {\n        if m.globals[i as usize].group == g && m.globals[i as usize].binding == b {\n            return i;\n        }\n    }\n    -1\n}\n\n");
    buf_str(out, c"// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form\n// is std's own until 0.27.\npub fn print_words<B: Allocator + Copy, A: Allocator + Copy>(group: i64, w: &Vec<u32, A>,\n    out: &mut String<B>) {\n    let mut b = Vec::<u8, _>::new_in(*out.allocator());\n    print_words_buf(group, w, &mut b);\n    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());\n    out.push_str(t.as_str());\n}\n\npub(crate) fn print_words_buf<B: Allocator, A: Allocator + Copy>(group: i64, w: &Vec<u32, A>,\n    out: &mut Vec<u8, B>) {\n    write(out, \"buffer {group} 0\\n\").unwrap();\n    for k in 0..w.len() as i64 {\n        write(out, \"{:08x}\", w[k as usize]).unwrap();\n        out.push((if k % 8 == 7 || k == w.len() as i64 - 1 { b'\\n' } else { b' ' }));\n    }\n}\n\n// Each job buffer's words: words[idx[i]] for the job's i-th buffer.\n// (0.26.3) Into a String outside std (Buf being deprecated); the Buf form\n// is std's own until 0.27.\npub fn print_buffers<B: Allocator + Copy, A: Allocator + Copy>(job: &Job<'_, A>,\n    words: &Vec<Vec<u32, A>, A>, idx: &Vec<i64, A>, out: &mut String<B>) {\n    let mut b = Vec::<u8, _>::new_in(*out.allocator());\n    print_buffers_buf(job, words, idx, &mut b);\n    let t = String::from_utf8_lossy_in(b.as_slice(), *out.allocator());\n    out.push_str(t.as_str());\n}\n\npub(crate) fn print_buffers_buf<B: Allocator, A: Allocator + Copy>(job: &Job<'_, A>,\n    words: &Vec<Vec<u32, A>, A>, idx: &Vec<i64, A>, out: &mut Vec<u8, B>) {\n    for i in 0..job.buffers.len() as i64 {\n        let b = &job.buffers[i as usize];\n        write(out, \"buffer {} {}\\n\", b.group, b.binding).unwrap();\n        let w = &words[idx[i as usize] as usize];\n        for k in 0..w.len() as i64 {\n            write(out, \"{:08x}\", w[k as usize]).unwrap();\n            out.push((if k % 8 == 7 || k == w.len() as i64 - 1 { b'\\n' } else { b' ' }));\n        }\n    }\n}\n// ---- end mod std::gpu::wgsl::job ----\n}\n");
    buf_str(out, c"// ---- mod std::gpu::wgsl::api ----\npub mod api {\n// ---- Shader compiler implementation, translate (0.22) ----\n// The translator's entry: WGSL source to an output (the IR as text, MSL,\n// SPIR-V), on an arena of its own (docs/design/gpu.md §2.10: everything a\n// translation allocates is freed when it ends; no io, no globals).\n\nuse crate::alloc::{Allocator, Arena};\n\nuse super::front::new_front;\n\npub const TARGET_CHECK: i64 = 0;\npub const TARGET_IR: i64 = 1;\npub const TARGET_MSL: i64 = 2;\npub const TARGET_SPIRV: i64 = 3;\n\n#[derive(Clone, Copy)] pub struct Options {\n    pub target: i64,\n    // bench only: no bounds checks (the cost of the checks is measured\n    // against this; never shipped)\n    pub no_checks: bool,\n    // drop checks proven unneeded by a dominating loop condition\n    pub prove: bool,\n}\n\npub fn options(target: i64) -> Options { Options { target: target, no_checks: false, prove: true } }\n\n// ---- Shader compiler implementation, translate: Reflection (0.22) ----\n\n// What a binding holds (WebGPU's binding types).\npub const BK_UNIFORM: u8 = 0;\npub const BK_STORAGE: u8 = 1;\npub const BK_READ_ONLY_STORAGE: u8 = 2;\npub const BK_TEXTURE: u8 = 3;\npub const BK_STORAGE_TEXTURE: u8 = 4;\npub const BK_SAMPLER: u8 = 5;\npub const BK_COMPARISON_SAMPLER: u8 = 6;\n\n// One `@group(g) @binding(b)`: its kind, the smallest buffer it accepts\n// (a runtime-sized array counts one element), and, for the target, its\n// slot in each stage (vertex, fragment, compute; -1: not used there).\n#[derive(Clone, Copy)] pub struct BindingInfo {\n    pub group: i64, pub binding: i64, pub kind: u8, pub min_size: i64, pub slots: [i64; 3],\n    pub global: i64,\n}\n\n// An entry point: its WGSL name, its name in the output, its stage\n// (ir::STAGE_*), a compute entry's workgroup size, and the slot of the\n// sizes buffer it needs (-1: none; Metal only).\npub struct EntryInfo<A: Allocator> {\n");
    buf_str(out, c"    pub name: Vec<u8, A>, pub target_name: Vec<u8, A>, pub stage: u8, pub workgroup: [i64; 3],\n    pub sizes_slot: i64,\n}\n\n// A vertex entry's input at @location(n): its scalar (ir::SK_*) and\n// component count, as WebGPU's vertex formats (`float32x3`: f32, 3).\n#[derive(Clone, Copy)] pub struct InputInfo {\n    pub location: i64, pub scalar: u8, pub components: i64,\n}\n\n// Where a function of the output starts (msl_line, 1-based, in the\n// target's text) and the byte offset of its WGSL declaration: what maps\n// a target compiler's message back to the WGSL (target_error).\n#[derive(Clone, Copy)] pub struct SourceLine { pub msl_line: i64, pub pos: i64 }\n\n// A translated module's interface, in (group, binding) order; `sizes`\n// lists the runtime-sized storage bindings (indices into `bindings`) in\n// the order of the sizes buffer; `uses`, the bindings each entry point\n// uses, through its calls too: (entry, binding) pairs of indices into\n// `entries` and `bindings` (a pipeline's layout is its entry points'\n// bindings); `lines`, where each function of the output starts (MSL\n// only).\npub struct Reflection<A: Allocator> {\n    pub entries: Vec<EntryInfo<A>, A>, pub bindings: Vec<BindingInfo, A>,\n    pub inputs: Vec<InputInfo, A>,\n    pub sizes: Vec<i64, A>,\n    pub uses: Vec<[i64; 2], A>, pub lines: Vec<SourceLine, A>,\n}\n\npub fn new_reflection(gpa: Gpa) -> Reflection<Gpa> {\n    Reflection {\n        entries: Vec::new_in(gpa), bindings: Vec::new_in(gpa), inputs: Vec::new_in(gpa),\n        sizes: Vec::new_in(gpa), uses: Vec::new_in(gpa),\n        lines: Vec::new_in(gpa),\n    }\n}\n\n// The target-neutral part of the reflection, from the IR.\npub fn reflect<A: Allocator + Copy>(m: &ir::Module<A>, a: A, refl: &mut Reflection<Gpa>, gpa: Gpa) {\n    refl.entries.clear();\n    refl.bindings.clear();\n    refl.inputs.clear();\n    refl.sizes.clear();\n    refl.uses.clear();\n    refl.lines.clear();\n    for e in 0..m.entries.len() as i64 {\n");
    buf_str(out, c"        let en = m.entries[e as usize];\n        let mut name = Vec::<u8, _>::new_in(gpa);\n        name.extend_from_slice(en.name);\n        refl.entries.push(EntryInfo {\n            name: name, target_name: Vec::<u8, _>::new_in(gpa), stage: en.stage, workgroup: en.wg,\n            sizes_slot: -1,\n        });\n        if en.stage == ir::STAGE_VERTEX {\n            let f = &m.functions[en.func as usize];\n            for k in 0..f.params.len() as i64 {\n                let pt = m.types[f.params[k as usize].ty as usize];\n                if pt.kind == ir::TK_STRUCT && f.params[k as usize].binding.kind == ir::BIND_NONE {\n                    for j in pt.mstart..pt.mstart + pt.mcount {\n                        let mem = m.members[j as usize];\n                        if mem.binding.kind == ir::BIND_LOCATION {\n                            refl.inputs.push(InputInfo {\n                                location: mem.binding.value,\n                                scalar: m.types[mem.ty as usize].scalar,\n                                components: m.width_of(mem.ty),\n                            });\n                        }\n                    }\n                } else if f.params[k as usize].binding.kind == ir::BIND_LOCATION {\n                    refl.inputs.push(InputInfo {\n                        location: f.params[k as usize].binding.value, scalar: pt.scalar,\n                        components: m.width_of(f.params[k as usize].ty),\n                    });\n                }\n            }\n        }\n    }\n    let order = msl::binding_order(m, a);\n    for k in 0..order.len() as i64 {\n        let g = order[k as usize];\n        let gl = m.globals[g as usize];\n        if gl.group < 0 {\n            continue;\n        }\n        let t = m.types[gl.ty as usize];\n        let kind = if gl.space == ir::SP_UNIFORM {\n            BK_UNIFORM\n        } else if gl.space == ir::SP_STORAGE {\n");
    buf_str(out, c"            if gl.access == ir::ACC_RW { BK_STORAGE } else { BK_READ_ONLY_STORAGE }\n        } else if t.kind == ir::TK_TEXTURE {\n            if t.n == ir::TEX_STORAGE_2D { BK_STORAGE_TEXTURE } else { BK_TEXTURE }\n        } else if t.n == 1 {\n            BK_COMPARISON_SAMPLER\n        } else {\n            BK_SAMPLER\n        };\n        let min: i64 = if gl.space == ir::SP_UNIFORM || gl.space == ir::SP_STORAGE { t.size }\n            else { 0 };\n        if gl.space == ir::SP_STORAGE && m.is_runtime_sized(gl.ty) {\n            refl.sizes.push(refl.bindings.len() as i64);\n        }\n        refl.bindings.push(BindingInfo {\n            group: gl.group, binding: gl.binding, kind: kind, min_size: min, slots: [-1, -1, -1],\n            global: g,\n        });\n    }\n    let uses = msl::global_uses(m, &msl::call_order(m, a), a);\n    for e in 0..m.entries.len() as i64 {\n        let h = m.entries[e as usize].func;\n        for b in 0..refl.bindings.len() as i64 {\n            if uses[h as usize][refl.bindings[b as usize].global as usize] {\n                refl.uses.push([e, b]);\n            }\n        }\n    }\n}\n\n// The sizes buffer (Metal; the bounds checks of runtime-sized arrays): an\n// entry point whose `sizes_slot` is >= 0 reads one u32 per binding of\n// `refl.sizes`, in that order, the bytes the buffer bound there exposes\n// (its size minus the binding's offset, or the binding's size when one is\n// given), and the backend gives them with setBytes(words, 4 * len,\n// sizes_slot) before each dispatch or draw, in that entry's stage. `bound`\n// says it for a (group, binding), 0 when nothing is bound. A runtime-sized\n// array then has (bytes - its offset in the binding) / stride elements;\n// past them a load reads zero and a store is skipped.\npub fn sizes_words<F: FnMut(i64, i64) -> i64>(refl: &Reflection<Gpa>, mut bound: F,\n    out: &mut Vec<u32, Gpa>) {\n    let mut f = bound;\n    out.clear();\n    for i in 0..refl.sizes.len() as i64 {\n");
    buf_str(out, c"        let b = refl.bindings[refl.sizes[i as usize] as usize];\n        let n = f(b.group, b.binding);\n        out.push(if n < 0 { 0 } else if n > 4294967295 { 4294967295u32 } else { n as u32 });\n    }\n}\n\n// A shader the translator rejects: its first error.\npub struct ShaderError<A: Allocator> {\n    pub code: &'static [u8], pub pos: i64, pub line: i64, pub col: i64, pub msg: Vec<u8, A>,\n    pub help: Vec<u8, A>,\n}\n\npub fn new_error(gpa: Gpa) -> ShaderError<Gpa> {\n    ShaderError {\n        code: b\"\", pos: 0, line: 0, col: 0, msg: Vec::<u8, _>::new_in(gpa),\n        help: Vec::<u8, _>::new_in(gpa),\n    }\n}\n\n// The 1-based line and column of byte `pos`.\npub fn line_col(src: &[u8], pos: i64) -> (i64, i64) {\n    let mut line: i64 = 1;\n    let mut col: i64 = 1;\n    let end = if pos < src.len() as i64 { pos } else { src.len() as i64 };\n    for i in 0..end {\n        if src[i as usize] == b'\\n' {\n            line += 1;\n            col = 1;\n        } else {\n            col += 1;\n        }\n    }\n    (line, col)\n}\n\n// A target compiler's rejection of the translation of src (Metal's log:\n// `program_source:LINE:COL: error: TEXT` lines) as one line at the WGSL:\n// `LINE:COL: error wgsl.target: ... fn NAME: TEXT (MSL LINE:COL)`, at the\n// declaration of the function whose MSL holds the first error (refl.lines).\n// False, out unchanged, when the log has no error line in a function.\npub fn target_error<A: Allocator>(src: &[u8], refl: &Reflection<Gpa>, log: &[u8],\n    out: &mut String<A>)\n    -> bool {\n    let key = \"program_source:\";\n    let mut i: i64 = 0;\n    while i + key.len() as i64 <= log.len() as i64 {\n        if (i == 0 || log[(i - 1) as usize] == b'\\n')\n            && log[i as usize..(i + key.len() as i64) as usize] == key.as_bytes() {\n            let (ml, a) = number_at(log, i + key.len() as i64);\n            let (mc, b) = number_at(log, a + 1);\n            let tag = \": error: \";\n");
    buf_str(out, c"            if ml > 0 && a < log.len() as i64 && log[a as usize] == b':'\n                && b + tag.len() as i64 <= log.len() as i64\n                && log[b as usize..(b + tag.len() as i64) as usize] == tag.as_bytes() {\n                let mut e = b + tag.len() as i64;\n                while e < log.len() as i64 && log[e as usize] != b'\\n' {\n                    e += 1;\n                }\n                // the last function starting at or before the line\n                let mut pos: i64 = -1;\n                for k in 0..refl.lines.len() as i64 {\n                    if refl.lines[k as usize].msl_line <= ml {\n                        pos = refl.lines[k as usize].pos;\n                    }\n                }\n                if pos < 0 {\n                    return false;\n                }\n                let (l, c) = line_col(src, pos);\n                write(out, \"{l}:{c}: error wgsl.target: Metal rejected the translation of fn \").unwrap();\n                write(out, str::from_utf8(name_at(src, pos)).unwrap()).unwrap();\n                write(out, \": {} (MSL {ml}:{mc})\",\n                    &str::from_utf8(log[(b + tag.len() as i64) as usize..e as usize]).unwrap()).unwrap();\n                return true;\n            }\n        }\n        i += 1;\n    }\n    false\n}\n\n// The decimal number at s[i..] and the index after it (0 and i: none).\nfn number_at(s: &[u8], i: i64) -> (i64, i64) {\n    let mut n: i64 = 0;\n    let mut j = i;\n    while j < s.len() as i64 && s[j as usize] >= b'0' && s[j as usize] <= b'9' && n < 1000000000 {\n        n = n * 10 + (s[j as usize] - b'0') as i64;\n        j += 1;\n    }\n    (n, j)\n}\n\n// The identifier at src[pos..] (a function's position is its name's).\nfn name_at(src: &[u8], pos: i64) -> &[u8] {\n    let i = if pos < src.len() as i64 { pos } else { src.len() as i64 };\n    let mut j = i;\n    while j < src.len() as i64\n");
    buf_str(out, c"        && (src[j as usize] == b'_' || src[j as usize] >= b'a' && src[j as usize] <= b'z'\n            || src[j as usize] >= b'A'\n            && src[j as usize] <= b'Z' || src[j as usize] >= b'0' && src[j as usize] <= b'9') {\n        j += 1;\n    }\n    &src[i as usize..j as usize]\n}\n\npub fn fill_error<A: Allocator + Copy>(fr: &front::Front<A>, err: &mut ShaderError<Gpa>) {\n    err.code = fr.err_code;\n    err.pos = fr.err_pos;\n    let (l, c) = line_col(fr.src, fr.err_pos);\n    err.line = l;\n    err.col = c;\n    err.msg.clear();\n    err.msg.extend_from_slice(fr.emsg.as_slice());\n    err.help.clear();\n    err.help.extend_from_slice(fr.ehelp.as_slice());\n}\n\n// Translates src; the output is appended to `out` (SPIR-V: its words,\n// little-endian). False, with err filled, when the shader is rejected.\n// (0.26.3: the translator writes a Buf until 0.27, translate_buf; outside\n// std its output is bytes, Buf being deprecated.)\npub fn translate(src: &[u8], opts: Options, out: &mut Vec<u8, Gpa>, refl: &mut Reflection<Gpa>,\n    err: &mut ShaderError<Gpa>, gpa: Gpa) -> bool {\n    let mut b = Vec::<u8, _>::new_in(gpa);\n    let ok = translate_buf(src, opts, &mut b, refl, err, gpa);\n    out.extend_from_slice(b.as_slice());\n    ok\n}\n\n// translate, into a Buf (std's own callers until 0.27).\npub(crate) fn translate_buf(src: &[u8], opts: Options, out: &mut Vec<u8, Gpa>,\n    refl: &mut Reflection<Gpa>, err: &mut ShaderError<Gpa>, gpa: Gpa) -> bool {\n    Arena::new_in(gpa).scope(|s| ({ let a = s; {\n        let mut fr = new_front(src, a);\n        fr.module();\n        if !fr.failed {\n            uniformity::check(&fr);\n        }\n        if fr.failed {\n            fill_error(&fr, err);\n            return false;\n        }\n        if !opts.no_checks {\n            bounds::insert_checks(&mut fr.m, a, opts.prove);\n        } else {\n            bounds::insert_no_checks(&mut fr.m);\n        }\n        reflect(&fr.m, a, refl, gpa);\n");
    buf_str(out, c"        if opts.target == TARGET_IR {\n            dump::dump(&fr.m, out);\n        } else if opts.target == TARGET_MSL {\n            msl::write_module(&fr.m, a, out, refl);\n        } else if opts.target == TARGET_SPIRV {\n            spirv::write_module(&fr.m, a, out);\n        }\n        true\n    } }))\n}\n// ---- end mod std::gpu::wgsl::api ----\n}\n// ---- end mod std::gpu::wgsl ----\n}\n// ---- end mod std::gpu ----\n}\n// ---- mod std::objc ----\npub mod objc {\n// std::objc (0.22, docs/design/gpu.md §2.9; the rust edition's, 0.28): the\n// Objective-C runtime for vole programs, on macOS. A program that uses it\n// links libobjc (`#[link]`, below); frameworks are opened at run time\n// (`objc::framework(\"Metal\")`), so no -framework is needed at link.\n//\n// - `Id<T>`: an owned (+1) reference to an object of class or protocol T,\n//   a zero-sized marker type, so that Id<MTLBuffer> and Id<MTLTexture> do\n//   not mix. Dropping it sends release; `clone()` sends retain.\n// - `Ref<'a, T>`: a borrowed (+0) reference, Copy: it cannot outlive the\n//   Id (or the reference) it came from, which 'a is. `retain()` makes it\n//   an Id<T>.\n// - Methods come from tables (compiler/std/objc/tables/*.objc) through\n//   tools/objcgen, which checks every line against the runtime's type\n//   encodings: no objc_msgSend prototype is written by hand.\n// mvs: std::objc\n\npub mod foundation;\n\nuse crate::alloc::Allocator;\nuse crate::marker::PhantomData;\nuse crate::string::String;\nuse crate::sync::atomic::{Atomic, Ordering};\n\nuse foundation::{\n    NSException, NSExceptionMethods, NSObject, NSObjectMethods, NSString, NSStringMethods,\n};\n\n// The Objective-C runtime, linked by a program that calls into it\n// (#[link]: when it uses a symbol of this block); the frameworks are\n// opened at run time.\n// UNSAFE: the Objective-C runtime's C functions; C calls cannot be checked.\n");
    buf_str(out, c"// SAFETY: the prototypes are objc/runtime.h's and objc/objc-internal.h's (id and SEL as *mut u8).\n#[link(lib = \"objc\")]\nextern \"C\" {\n    #[effects(io)]\n    fn objc_retain(o: *mut u8) -> *mut u8;\n    #[effects(io)]\n    fn objc_release(o: *mut u8);\n    #[effects(io)]\n    fn objc_autoreleasePoolPush() -> *mut u8;\n    #[effects(io)]\n    fn objc_autoreleasePoolPop(p: *mut u8);\n    #[effects(io)]\n    fn sel_registerName(name: *const u8) -> *mut u8;\n    #[effects(io)]\n    fn objc_getClass(name: *const u8) -> *mut u8;\n}\n\n// UNSAFE: the C library's string and dynamic-loader functions.\n// SAFETY: the prototypes are string.h's and dlfcn.h's.\nextern \"C\" {\n    #[link_name = \"strlen\"]\n    #[effects()]\n    fn objc_c_strlen(s: *const u8) -> u64;\n    #[link_name = \"dlopen\"]\n    #[effects(io)]\n    fn objc_c_dlopen(path: *const u8, mode: i32) -> *mut u8;\n    #[link_name = \"dlsym\"]\n    #[effects(io)]\n    fn objc_c_dlsym(handle: *mut u8, name: *const u8) -> *mut u8;\n}\n\n// ---- Objective-C objects (0.22) ----\n\n/// Any object (Objective-C's `id`).\npub struct Object {}\n\n/// An owned reference (+1) to an object of class or protocol T.\npub struct Id<T> {\n    pub ptr: *mut u8,\n    of: PhantomData<T>,\n}\n\n/// A borrowed reference (+0) to an object of class or protocol T, valid\n/// for 'a: the life of what keeps the object alive.\npub struct Ref<'a, T> {\n    pub ptr: *mut u8,\n    keep: PhantomData<&'a T>,\n}\n\nimpl<'a, T> Clone for Ref<'a, T> {\n    fn clone(&self) -> Ref<'a, T> {\n        *self\n    }\n}\n\nimpl<'a, T> Copy for Ref<'a, T> {}\n\nimpl<T> Drop for Id<T> {\n    fn drop(&mut self) {\n        let p = self.ptr;\n        self.ptr = 0 as *mut u8;\n        if !p.is_null() {\n            // UNSAFE: objc_release is a C call on a raw object pointer.\n            // SAFETY: p was the +1 reference this Id owned (from_owned's promise, or a retain);\n            // ptr is cleared above, so it is released once.\n");
    buf_str(out, c"            unsafe { objc_release(p); }\n        }\n    }\n}\n\nimpl<T> Id<T> {\n    /// Takes over a +1 reference (a result of the alloc, new, copy or\n    /// mutableCopy families); None for nil. The caller promises that p is\n    /// nil or a +1 reference to an object of T.\n    // UNSAFE: the Id will release p and send it T's messages: no type says p is a +1 object of T.\n    // SAFETY: the caller's: p is nil or a +1 reference, to an object of class or protocol T,\n    // that the caller gives up.\n    pub unsafe fn from_owned(p: *mut u8) -> Option<Id<T>> {\n        if p.is_null() { None } else { Some(Id::<T> { ptr: p, of: PhantomData }) }\n    }\n\n    /// The same, nil kept as a nil Id (messages to nil do nothing and\n    /// return 0; release of nil does nothing).\n    // UNSAFE: as from_owned: the Id will release p and send it T's messages.\n    // SAFETY: the caller's: p is nil or a +1 reference to an object of T, given up.\n    pub unsafe fn from_owned_or_nil(p: *mut u8) -> Id<T> {\n        Id::<T> { ptr: p, of: PhantomData }\n    }\n\n    /// A nil Id.\n    pub fn nil() -> Id<T> {\n        Id::<T> { ptr: 0 as *mut u8, of: PhantomData }\n    }\n\n    /// A borrowed reference to the object, valid while this Id is.\n    pub fn r(&self) -> Ref<'_, T> {\n        Ref::<T> { ptr: self.ptr, keep: PhantomData }\n    }\n\n    pub fn is_nil(&self) -> bool {\n        self.ptr.is_null()\n    }\n\n    /// Gives the +1 reference up without releasing it (to a method of the\n    /// init family, which consumes its receiver).\n    pub fn into_raw(self) -> *mut u8 {\n        let mut me = self;\n        let p = me.ptr;\n        me.ptr = 0 as *mut u8;\n        p\n    }\n\n    /// The object's retain count (for tests: Cocoa's own count, which\n    /// includes the references the frameworks hold).\n    pub fn retain_count(&self) -> u64 {\n        self.r().object().retain_count()\n    }\n\n    /// Reinterprets the reference as one to U. The caller promises that\n");
    buf_str(out, c"    /// the object is of class or protocol U.\n    // UNSAFE: the result is sent U's messages; the runtime's class is not checked.\n    // SAFETY: the caller's: the object is of class or protocol U (or nil).\n    pub unsafe fn cast<U>(self) -> Id<U> {\n        Id::<U> { ptr: self.into_raw(), of: PhantomData }\n    }\n}\n\nimpl<T> Clone for Id<T> {\n    /// Another owned reference to the same object: sends retain.\n    fn clone(&self) -> Id<T> {\n        if !self.ptr.is_null() {\n            // UNSAFE: objc_retain is a C call on a raw object pointer.\n            // SAFETY: self owns a +1 reference, so the object is live; the new Id owns the +1\n            // this retain adds.\n            unsafe { objc_retain(self.ptr); }\n        }\n        Id::<T> { ptr: self.ptr, of: PhantomData }\n    }\n}\n\nimpl<'a, T> Ref<'a, T> {\n    /// A reference to p that lives as long as `keep`, the reference it was\n    /// read from (a method's +0 result is tied to its receiver so). The\n    /// caller promises that p is nil or an object of T, alive while what\n    /// `keep` borrows is.\n    // UNSAFE: makes a reference no type checks.\n    // SAFETY: the caller's: p is nil or an object of T that what keep borrows keeps alive.\n    pub unsafe fn from_raw<K>(p: *mut u8, keep: Ref<'a, K>) -> Ref<'a, T> {\n        let _ = keep;\n        Ref::<T> { ptr: p, keep: PhantomData }\n    }\n\n    /// The same, None for nil.\n    // UNSAFE: as from_raw: makes a reference no type checks.\n    // SAFETY: the caller's, as from_raw: p nil or an object of T kept alive.\n    pub unsafe fn from_raw_opt<K>(p: *mut u8, keep: Ref<'a, K>) -> Option<Ref<'a, T>> {\n        let _ = keep;\n        if p.is_null() { None } else { Some(Ref::<T> { ptr: p, keep: PhantomData }) }\n    }\n\n    /// A reference to an object the process or the current pool keeps\n    /// (a class, an autoreleased result), for any 'a the caller names. The\n    /// caller promises as for from_raw.\n");
    buf_str(out, c"    // UNSAFE: makes a reference to a raw object pointer with no owner to bound its life.\n    // SAFETY: the caller's: p is nil or an object of T that the process (a class) or the\n    // current autorelease pool keeps for as long as the Ref is used.\n    pub unsafe fn from_global(p: *mut u8) -> Ref<'a, T> {\n        Ref::<T> { ptr: p, keep: PhantomData }\n    }\n\n    /// The same, None for nil.\n    // UNSAFE: as from_global: a reference to a raw pointer with no owner to bound its life.\n    // SAFETY: the caller's, as from_global.\n    pub unsafe fn from_global_opt(p: *mut u8) -> Option<Ref<'a, T>> {\n        if p.is_null() { None } else { Some(Ref::<T> { ptr: p, keep: PhantomData }) }\n    }\n\n    /// An owned reference to the object: sends retain.\n    pub fn retain(self) -> Id<T> {\n        if !self.ptr.is_null() {\n            // UNSAFE: objc_retain is a C call on a raw object pointer.\n            // SAFETY: a Ref is nil or a live object (its constructors' promise); the Id returned\n            // owns the +1 this adds.\n            unsafe { objc_retain(self.ptr); }\n        }\n        Id::<T> { ptr: self.ptr, of: PhantomData }\n    }\n\n    pub fn is_nil(self) -> bool {\n        self.ptr.is_null()\n    }\n\n    /// The object as an NSObject (every class here derives from it).\n    pub fn object(self) -> Ref<'a, NSObject> {\n        Ref::<NSObject> { ptr: self.ptr, keep: PhantomData }\n    }\n\n    /// The object as an `id`.\n    pub fn any(self) -> Ref<'a, Object> {\n        Ref::<Object> { ptr: self.ptr, keep: PhantomData }\n    }\n\n    /// Reinterprets the reference as one to U. The caller promises that\n    /// the object is of class or protocol U.\n    // UNSAFE: the result is sent U's messages; the runtime's class is not checked.\n    // SAFETY: the caller's: the object is of class or protocol U (or nil).\n    pub unsafe fn cast<U>(self) -> Ref<'a, U> {\n        Ref::<U> { ptr: self.ptr, keep: PhantomData }\n    }\n}\n\n");
    buf_str(out, c"/// The pointer of an optional reference (nil for None), for the generated\n/// bindings' nullable parameters.\npub fn opt_ptr<T>(r: Option<Ref<'_, T>>) -> *mut u8 {\n    match r {\n        Some(x) => x.ptr,\n        None => 0 as *mut u8,\n    }\n}\n\n// ---- Autorelease pools, selectors, classes, frameworks (0.22) ----\n\n/// Runs f inside an autorelease pool: the objects autoreleased while it\n/// runs are released at its end (closure-scoped push and pop).\npub fn pool<R, F: FnOnce() -> R>(f: F) -> R {\n    // UNSAFE: the runtime's pool push, a C call.\n    // SAFETY: no argument; the pool it returns is popped below, in this frame.\n    let p = unsafe { objc_autoreleasePoolPush() };\n    let r = f();\n    // UNSAFE: the runtime's pool pop, a C call.\n    // SAFETY: p is the pool pushed above; f's own pools were popped before it returned\n    // (pool and Pool pop theirs), so p is the innermost one.\n    unsafe { objc_autoreleasePoolPop(p); }\n    r\n}\n\n/// A pool as a value: popped when dropped (pools nest: drop the inner one\n/// first, as a scope does).\npub struct Pool {\n    p: *mut u8,\n}\n\nimpl Pool {\n    pub fn push() -> Pool {\n        // UNSAFE: the runtime's pool push, a C call.\n        // SAFETY: no argument; the Pool pops it when dropped.\n        let p = unsafe { objc_autoreleasePoolPush() };\n        Pool { p: p }\n    }\n}\n\nimpl Drop for Pool {\n    fn drop(&mut self) {\n        if !self.p.is_null() {\n            // UNSAFE: the runtime's pool pop, a C call.\n            // SAFETY: p came from objc_autoreleasePoolPush and is cleared below, so it is popped\n            // once; Pools are locals dropped in reverse order, which keeps the nesting (popping\n            // an outer pool first pops the inner ones too, and theirs is then a no-op).\n            unsafe { objc_autoreleasePoolPop(self.p); }\n        }\n        self.p = 0 as *mut u8;\n    }\n}\n\n/// The selector for a NUL-terminated name (the generated bindings cache\n");
    buf_str(out, c"/// theirs in statics). The caller passes a NUL-terminated string.\n// UNSAFE: sel_registerName reads name up to its NUL, which no type guarantees (`selector`\n// takes a str and is safe).\n// SAFETY: the caller's: name is a NUL-terminated string, readable for the call.\npub unsafe fn sel(name: *const u8) -> *mut u8 {\n    sel_registerName(name)\n}\n\n/// The class of that name, or nil. The caller passes a NUL-terminated\n/// string.\n// UNSAFE: objc_getClass reads name up to its NUL, which no type guarantees (`class_named`\n// takes a str and is safe).\n// SAFETY: the caller's: name is a NUL-terminated string, readable for the call.\npub unsafe fn class(name: *const u8) -> *mut u8 {\n    objc_getClass(name)\n}\n\n// name, NUL-terminated in buf (true), or false when it does not fit.\nfn c_name(name: &[u8], buf: &mut [u8; 256]) -> bool {\n    if name.len() >= 256 { return false; }\n    for i in 0..name.len() {\n        buf[i] = name[i];\n    }\n    buf[name.len()] = 0;\n    true\n}\n\n/// (0.25.4) The selector for a name, safe: `sel` for a str (the\n/// generated bindings cache theirs in statics). A name of 256 bytes or\n/// more panics.\npub fn selector(name: &str) -> *mut u8 {\n    let mut buf: [u8; 256] = [0; 256];\n    if !c_name(name.as_bytes(), &mut buf) {\n        panic(\"std::objc::selector: a name of 256 bytes or more\");\n    }\n    // UNSAFE: sel_registerName is the Objective-C runtime's C function.\n    // SAFETY: buf holds name NUL-terminated (c_name checked that it fits) and lives across the\n    // call; the runtime copies the name and keeps the selector for the process.\n    unsafe { sel_registerName(buf.as_ptr()) }\n}\n\n/// (0.25.4) The class of that name, or nil, safe: `class` for a str. A\n/// name of 256 bytes or more panics.\npub fn class_named(name: &str) -> *mut u8 {\n    let mut buf: [u8; 256] = [0; 256];\n    if !c_name(name.as_bytes(), &mut buf) {\n        panic(\"std::objc::class_named: a name of 256 bytes or more\");\n    }\n");
    buf_str(out, c"    // UNSAFE: objc_getClass is the Objective-C runtime's C function.\n    // SAFETY: buf holds name NUL-terminated (c_name checked that it fits) and lives across the\n    // call, which only reads it; a class, once registered, lives as long as the process.\n    unsafe { objc_getClass(buf.as_ptr()) }\n}\n\n/// The selector for a name, looked up once and kept in `slot` (a static of\n/// the generated bindings, zero until the first call). Two threads racing\n/// on a slot both store the same selector: the runtime keeps one per name.\npub fn cached_selector(slot: &Atomic<usize>, name: &str) -> *mut u8 {\n    let p = slot.load(Ordering::Relaxed);\n    if p != 0 { return p as *mut u8; }\n    let s = selector(name);\n    slot.store(s as usize, Ordering::Relaxed);\n    s\n}\n\n/// The class of a name (or nil, before its framework is opened: then it\n/// is looked up again at the next call), kept in `slot` as\n/// cached_selector's.\npub fn cached_class(slot: &Atomic<usize>, name: &str) -> *mut u8 {\n    let p = slot.load(Ordering::Relaxed);\n    if p != 0 { return p as *mut u8; }\n    let c = class_named(name);\n    slot.store(c as usize, Ordering::Relaxed);\n    c\n}\n\n/// Opens a system framework (`framework(\"Metal\")`: its classes and\n/// protocols are registered, its C functions reachable through `symbol`);\n/// false when there is none. Opening one twice is cheap.\npub fn framework(name: &str) -> bool {\n    let mut path: [u8; 256] = [0; 256];\n    let name = name.as_bytes();\n    let parts: [&[u8]; 4] = [b\"/System/Library/Frameworks/\", name, b\".framework/\", name];\n    let mut n: usize = 0;\n    for part in parts {\n        for i in 0..part.len() {\n            if n < 255 {\n                path[n] = part[i];\n                n += 1;\n            }\n        }\n    }\n    if n >= 255 { return false; }\n    // UNSAFE: dlopen is a C call taking a C string.\n    // SAFETY: path is a local array, NUL-terminated after n < 255 bytes (checked above), alive\n");
    buf_str(out, c"    // across the call; mode is RTLD_NOW | RTLD_GLOBAL.\n    let h = unsafe { objc_c_dlopen(path.as_ptr(), 2 | 8) };\n    !h.is_null()\n}\n\n/// The address of a C symbol of the process and the frameworks it opened,\n/// or null. The caller passes a NUL-terminated name.\n// UNSAFE: dlsym reads name up to its NUL, which no type guarantees.\n// SAFETY: the caller's: name is a NUL-terminated string; RTLD_DEFAULT is the handle dlfcn.h\n// defines on macOS, ((void *) -2).\npub unsafe fn symbol(name: *const u8) -> *mut u8 {\n    // RTLD_DEFAULT is (void *)-2 on macOS\n    objc_c_dlsym(-2isize as *mut u8, name)\n}\n\n// ---- Strings and exceptions (0.22) ----\n\n/// A new NSString holding a copy of the UTF-8 bytes of s.\npub fn ns_string(s: &str) -> Id<NSString> {\n    let a = NSString::alloc();\n    // UNSAFE: initWithBytes:length:encoding: takes the bytes as a raw pointer.\n    // SAFETY: s's pointer is valid for s.len() bytes, the length passed; NSString copies them\n    // before it returns.\n    let r = unsafe {\n        NSString::init_with_bytes_length_encoding(a, s.as_ptr() as *mut u8, s.len() as u64,\n            foundation::NSUTF8StringEncoding)\n    };\n    match r {\n        Some(x) => x,\n        None => Id::<NSString>::nil(),\n    }\n}\n\n/// The UTF-8 bytes of s (empty for nil): a slice valid while s's owner\n/// and the current autorelease pool are.\npub fn ns_bytes<'a>(s: Ref<'a, NSString>) -> &'a [u8] {\n    if s.is_nil() { return b\"\"; }\n    let p = s.utf8_string();\n    if p.is_null() { return b\"\"; }\n    // UNSAFE: the C string UTF8String returns is a raw pointer, its length strlen's.\n    // SAFETY: p is non-null (checked) and NUL-terminated, owned by s or the current pool, which\n    // outlive the slice as the doc says; strlen reads up to the NUL.\n    unsafe { crate::slice::from_raw_parts(p, objc_c_strlen(p) as usize) }\n}\n\n/// The text of s (empty for nil, and for bytes that are not UTF-8, which\n");
    buf_str(out, c"/// UTF8String does not return): valid as ns_bytes's slice is.\npub fn ns_str<'a>(s: Ref<'a, NSString>) -> &'a str {\n    match str::from_utf8(ns_bytes(s)) {\n        Ok(t) => t,\n        Err(_) => \"\",\n    }\n}\n\n/// Appends the UTF-8 text of s (nothing for nil) to out.\npub fn push_ns_string<A: Allocator>(out: &mut String<A>, s: Ref<'_, NSString>) {\n    out.push_str(ns_str(s));\n}\n\nextern \"C\" fn print_uncaught(e: *mut u8) {\n    // UNSAFE: the runtime hands the exception over as a raw pointer.\n    // SAFETY: the runtime calls this handler with the live NSException being thrown, which\n    // stays alive while the handler runs (the process ends after it).\n    let ex = unsafe { Ref::<NSException>::from_global(e) };\n    let reason = match ex.reason() {\n        Some(r) => ns_str(r),\n        None => \"(no reason)\",\n    };\n    eprintln(\"objc: uncaught exception {}: {reason}\", ns_str(ex.name()));\n}\n\nstatic mut INITIALIZED: bool = false;\n\n/// Opens Foundation and installs a handler that prints an Objective-C\n/// exception's name and reason before the process ends (an exception that\n/// reaches vole frames terminates it: no vole frame has a handler;\n/// a crash, not undefined behaviour). Idempotent.\npub fn init() {\n    // UNSAFE: a static mut read and written.\n    // SAFETY: a bool flag, read and set whole; init is called from the program's main thread\n    // before it uses objc (two racing first calls would both install the same handler).\n    let done = unsafe {\n        let was = INITIALIZED;\n        INITIALIZED = true;\n        was\n    };\n    if done { return; }\n    framework(\"Foundation\");\n    // UNSAFE: symbol takes a C string.\n    // SAFETY: the name is a NUL-terminated c\"\" literal.\n    let f = unsafe { symbol(c\"NSSetUncaughtExceptionHandler\") };\n    if !f.is_null() {\n        // UNSAFE: a symbol's address read as a function pointer (a union field).\n");
    buf_str(out, c"        // SAFETY: NSSetUncaughtExceptionHandler is Foundation's (opened above), declared\n        // `void NSSetUncaughtExceptionHandler(void (*)(NSException *))`, HandlerSetter.f's type.\n        let set = unsafe { HandlerSetter { p: f }.f };\n        // UNSAFE: a call through a C function pointer.\n        // SAFETY: set is that function (above); print_uncaught has the handler's C signature.\n        unsafe { set(print_uncaught); }\n    }\n}\n\n#[repr(C)]\nunion HandlerSetter {\n    p: *mut u8,\n    f: extern \"C\" fn(extern \"C\" fn(*mut u8)),\n}\n// ---- mod std::objc::foundation ----\npub mod foundation {\n// Generated by tools/objcgen from compiler/std/objc/tables/foundation.objc: do not edit.\n// Every prototype below is checked against the Objective-C runtime's\n// type encoding by `objcgen --check`, and every constant and struct\n// against the SDK's headers by `objcgen --c-check` (tests/gpu/run.sh).\n\nuse crate::objc::{Id, Object, Ref, cached_class, cached_selector, opt_ptr};\nuse crate::sync::atomic::Atomic;\n\n// UNSAFE: objc_msgSend, declared per ABI shape. SAFETY: each shape checked\n// against the runtime (objcgen --check), the structs against the SDK (--c-check).\nextern \"C\" {\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_u64(o: *mut u8, s: *mut u8) -> u64;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_p(o: *mut u8, s: *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_p_p_u64_u64(o: *mut u8, s: *mut u8, a0: *mut u8, a1: u64, a2: u64) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_i64(o: *mut u8, s: *mut u8) -> i64;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_p_u64(o: *mut u8, s: *mut u8, a0: u64) -> *mut u8;\n}\n\n// The selectors and classes, looked up on first use.\nstatic SEL_0: Atomic<usize> = Atomic::new(0);\n\n#[effects(io, panic, diverge)]\nfn sel_0() -> *mut u8 {\n");
