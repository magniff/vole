    buf_str(out, c"    cached_selector(&SEL_11, \"count\")\n}\n\nstatic SEL_12: Atomic<usize> = Atomic::new(0);\n\n#[effects(io, panic, diverge)]\nfn sel_12() -> *mut u8 {\n    cached_selector(&SEL_12, \"objectAtIndex:\")\n}\n\nstatic CLASS_0: Atomic<usize> = Atomic::new(0);\n\n#[effects(io, panic, diverge)]\nfn class_0() -> *mut u8 {\n    cached_class(&CLASS_0, \"NSString\")\n}\n\npub const NSUTF8StringEncoding: u64 = 4;\n\n/// The Objective-C class NSObject.\npub struct NSObject {}\n\npub trait NSObjectMethods<'a> {\n    // retainCount\n    fn retain_count(self) -> u64;\n    // description\n    fn description(self) -> Ref<'a, NSString>;\n}\n\nimpl<'a> NSObjectMethods<'a> for Ref<'a, NSObject> {\n    fn retain_count(self) -> u64 {\n        // UNSAFE: -retainCount is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_u64 is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSObject (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_u64(self.ptr, sel_0()) }\n    }\n\n    fn description(self) -> Ref<'a, NSString> {\n        // UNSAFE: -description is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSObject (Ref's invariant), and a\n        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), self) }\n    }\n}\n\nimpl<'a> NSObjectMethods<'a> for Ref<'a, NSString> {\n    fn retain_count(self) -> u64 {\n        // UNSAFE: -retainCount is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_u64 is its C prototype, checked against the runtime