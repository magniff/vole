mut str (Rust's\n");
    buf_str(out, c"        // str::from_utf8_unchecked_mut).\n        // SAFETY: buf[..n] holds one char's UTF-8, just written, and a str\n        // is laid out as a [u8].\n        unsafe { &mut *(&mut buf[..n] as *mut [u8] as *mut str) }\n    }\n\n    // Its width in terminal columns: vole's (str::width's, for one char).\n    #[effects()]\n    pub fn width(self) -> usize {\n        // Without the Unicode tables (MVS's std::unicode::char_width): a\n        // control and the combining marks and format chars are 0 wide,\n        // the East Asian wide blocks and the emoji 2, the rest 1.\n        let c = self as u32;\n        if c < 0x7F {\n            return if c >= 0x20 { 1 } else { 0 };\n        }\n        if self.is_control() || is_zero_width(c) {\n            0\n        } else if is_wide(c) {\n            2\n        } else {\n            1\n        }\n    }\n}\n\n// A char's upper case, one char or more.\n#[derive(Clone, Debug)]\npub struct ToUppercase {\n    chars: [char; 3],\n    at: usize,\n    len: usize,\n}\n\nimpl Iterator for ToUppercase {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.at == self.len {\n            return Option::None;\n        }\n        self.at += 1;\n        Option::Some(self.chars[self.at - 1])\n    }\n}\n\n// A char's lower case, one char or more.\n#[derive(Clone, Debug)]\npub struct ToLowercase {\n    chars: [char; 3],\n    at: usize,\n    len: usize,\n}\n\nimpl Iterator for ToLowercase {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.at == self.len {\n            return Option::None;\n        }\n        self.at += 1;\n        Option::Some(self.chars[self.at - 1])\n    }\n}\n\n// i as a char, when it is a scalar value (char::from_u32).\n#[effects()]\npub fn from_u32(i: u32) -> Option<char> {\n    char::from_u32(i)\n}\n\n// The digit d in radix as a char (char::from_digit).\n#[effects(panic)]\npub fn from_digit(d: u32, radix: u32) -> Option<char>\n    requires 