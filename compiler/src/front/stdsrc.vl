    buf_str(out, c"// launchd daemon), checked before NSApplication is touched.\npub fn has_display() -> bool {\n    // UNSAFE: Core Graphics and Core Foundation C calls.\n    // SAFETY: CGSessionCopyCurrentDictionary returns a +1 dictionary or\n    // null; it is released.\n    unsafe {\n        let d = CGSessionCopyCurrentDictionary();\n        if d == 0 as *mut u8 {\n            return false;\n        }\n        CFRelease(d);\n        true\n    }\n}\n\n// (0.25.2.1) The monotonic clock in nanoseconds (0.28.0: std::time's\n// Instant, the same clock; no extern of this module's own).\nfn now_ns() -> i64 {\n    crate::time::Instant::now().as_nanos() as i64\n}\n\n// (0.25.2.1) Whether the window is not shown (occlusionState lacks\n// NSWindowOcclusionStateVisible, 1 << 1).\n// UNSAFE: an Objective-C message on a raw NSWindow pointer.\n// SAFETY: the caller passes a live NSWindow; occlusionState takes nothing\n// and returns an NSUInteger.\nunsafe fn occluded(win: *mut u8) -> bool {\n    (msg_u(win, sel(c\"occlusionState\")) & 2) == 0\n}\n\n// (0.25.2.1) Why a window's display link gives no frames, for the\n// diagnostic: the display asleep, the screen locked, or the window\n// occluded (`hidden`).\n// UNSAFE: CoreGraphics' C functions and Objective-C messages on the raw\n// CFDictionary and CFBoolean they return.\n// SAFETY: CGSessionCopyCurrentDictionary's result is a +1 dictionary or\n// null, released once after its last use; objectForKey: takes the NSString\n// (autoreleased in the pool popped before the release) and returns a\n// value the dictionary holds, or null, checked before boolValue;\n// CGDisplayIsAsleep takes any display id.\nunsafe fn quiet_reason(hidden: bool) -> &'static [u8] {\n    // Asleep first: a locked screen still shows windows while it is awake.\n    if CGDisplayIsAsleep(CGMainDisplayID()) != 0 {\n        return b\"the display is asleep\";\n    }\n    let d = CGSessionCopyCurrentDictionary();\n    if d != 0 as *mut u8 {\n        let pool = pool_push();\n");
    buf_str(out, c"        // The session dictionary (toll-free bridged to NSDictionary):\n        // its value for this key is a CFBoolean, or absent.\n        let v = msg_p_p(d, sel(c\"objectForKey:\"), nsstring(b\"CGSSessionScreenIsLocked\"));\n        let locked = v != 0 as *mut u8 && msg_b(v, sel(c\"boolValue\"));\n        pool_pop(pool);\n        CFRelease(d);\n        if locked {\n            return b\"the screen is locked\";\n        }\n    }\n    if hidden {\n        return b\"covered, hidden, minimized or on another Space\";\n    }\n    b\"the machine may be too loaded\"\n}\n\npub fn hide_cursor_until_moved() {\n    // UNSAFE: an Objective-C message (objc_msgSend, a C function).\n    // SAFETY: +[NSCursor setHiddenUntilMouseMoves:] takes a BOOL.\n    unsafe { msg_v_b(class(c\"NSCursor\"), sel(c\"setHiddenUntilMouseMoves:\"), true); }\n}\n\nimpl Cocoa<Gpa> {\n    pub fn new_in(gpa: Gpa) -> Result<Cocoa<Gpa>, Error> {\n        if !has_display() {\n            return Err(Error::NoDisplay);\n        }\n        // UNSAFE: AppKit setup through Objective-C messages and the runtime's C\n        // functions, and ST set to a raw pointer to the State.\n        // SAFETY: AppKit setup on the main thread with the documented\n        // selectors and types; ST is set to the State's address, which\n        // stays put (the Vec is never pushed to again) until close.\n        unsafe {\n            if get_st_raw() != 0 as *mut u8 {\n                return Err(Error::Failed(\"one App per process\"));\n            }\n            let pool = pool_push();\n            let app = msg_p(class(c\"NSApplication\"), sel(c\"sharedApplication\"));\n            if app == 0 as *mut u8 {\n                pool_pop(pool);\n                return Err(Error::NoDisplay);\n            }\n            // NSApplicationActivationPolicyRegular.\n            msg_b_i(app, sel(c\"setActivationPolicy:\"), 0);\n            msg_v_b(class(c\"NSWindow\"), sel(c\"setAllowsAutomaticWindowTabbing:\"), false);