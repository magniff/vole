r and the writer.\n");
    buf_str(out, c"#[derive(Debug)]\npub struct IntoInnerError<W> {\n    writer: W,\n    error: Error,\n}\n\nimpl<W> IntoInnerError<W> {\n    #[effects()]\n    pub fn error(&self) -> &Error {\n        &self.error\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> W {\n        self.writer\n    }\n}\n\n// The process's standard input (fd 0), buffered.\npub struct Stdin {\n    fd: i32,\n}\n\n// The process's stdin.\n#[effects()]\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\nimpl Stdin {\n    // A line, its \"\\n\" included, appended to buf; 0 at the end of input.\n    // mvs: read_line\n    // std: changed: Stdin's, returns the bytes read (MVS: a free function, a bool)\n    #[effects(io, static, diverge, unsafe, A)]\n    pub fn read_line<A: Allocator>(&self, buf: &mut String<A>) -> Result<usize> {\n        // A byte at a time up to \"\\n\": Stdin keeps no buffer, so nothing\n        // after the line is taken from fd 0.\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let mut b = [0u8; 1];\n        let mut r: Result<usize> = crate::result::Result::Ok(0);\n        loop {\n            match sys_read(self.fd, &mut b) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(_) => {\n                    v.push(b[0]);\n                    if b[0] == 10 {\n                        break;\n                    }\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        r = crate::result::Result::Err(e);\n                        break;\n                    }\n                }\n            }\n        }\n        // (annotated: an arm's Ok gives no E, FL1)\n        let r: Result<usize> = match r {\n");
    buf_str(out, c"            crate::result::Result::Ok(_) => crate::result::Result::Ok(v.len() - start),\n            crate::result::Result::Err(e) => crate::result::Result::Err(e),\n        };\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a.\n    #[effects(A)]\n    pub fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<BufReader<Stdin>, A> {\n        BufReader::new(self).lines_in(a)\n    }\n}\n\nimpl Read for Stdin {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        sys_read(self.fd, buf)\n    }\n}\n\n// The process's standard output (fd 1): line-buffered on a terminal,\n// block-buffered otherwise, flushed at exit.\npub struct Stdout {\n    fd: i32,\n}\n\n#[effects()]\npub fn stdout() -> Stdout {\n    Stdout { fd: 1 }\n}\n\nimpl Write for Stdout {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        // Written through (no buffer yet: the sys tail's line buffering\n        // comes with the embedded std, 0.27.2's M3).\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        fd_write_all(self.fd, buf)\n    }\n}\n\n// The process's standard error (fd 2), unbuffered.\npub struct Stderr {\n    fd: i32,\n}\n\n#[effects()]\npub fn stderr() -> Stderr {\n    Stderr { fd: 2 }\n}\n\nimpl Write for Stderr {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        fd_write_all(self.fd, buf)\n    }\n}\n\n// Everything r has left, as a String on a (Rust's io::read_to_string).\n// mvs: read_stdin_in\n// std: changed: any reader, a String (MVS: stdin's bytes as a Vec)\n#[effects(R, A)]\npub fn read_to_string_in<R: Read, A: Allocator>(r: R, a: A) -> Result<String<A>> {\n    let mut r = r;\n");
    buf_str(out, c"    let mut s = String::new_in(a);\n    r.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// Everything from r, written to w; how many bytes.\n#[effects(panic, diverge, R, W)]\npub fn copy<R: Read + ?Sized, W: Write + ?Sized>(r: &mut R, w: &mut W) -> Result<u64> {\n    let mut buf = [0u8; 8192];\n    let mut total: u64 = 0;\n    loop {\n        let n = match r.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        w.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// A reader with nothing in it.\n#[effects()]\npub fn empty() -> Empty {\n    Empty {}\n}\n\npub struct Empty {}\n\nimpl Read for Empty {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::result::Result::Ok(0)\n    }\n}\n\n// A writer that drops what it is given.\n#[effects()]\npub fn sink() -> Sink {\n    Sink {}\n}\n\npub struct Sink {}\n\nimpl Write for Sink {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A &mut of a reader or writer is one.\nimpl<R: Read + ?Sized> Read for &mut R {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        (**self).read(buf)\n    }\n}\n\nimpl<W: Write + ?Sized> Write for &mut W {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        (**self).write(buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        (**self).flush()\n    }\n}\n\n// Bytes in memory as a reader (`Read for &[u8]`).\nimpl Read for &[u8] {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n");
    buf_str(out, c"        let n = crate::cmp::min(buf.len(), self.len());\n        let (a, b) = self.split_at(n);\n        buf[..n].copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(n)\n    }\n\n    // All of buf, or UnexpectedEof with buf untouched and the slice used up\n    // (Rust's).\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        if buf.len() > self.len() {\n            *self = &self[self.len()..];\n            return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                \"failed to fill whole buffer\"));\n        }\n        let (a, b) = self.split_at(buf.len());\n        buf.copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(())\n    }\n}\n\n// A Vec<u8, A> as a writer: write grows it from A.\nimpl<A: Allocator> Write for Vec<u8, A> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        self.extend_from_slice(buf);\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n// ---- end mod std::io ----\n}\n// ---- mod std::fs ----\npub mod fs {\n// std::fs: files and directories, Rust's. A path is a `P: AsRef<str>`\n// (Rust's `AsRef<Path>`: a &str, a &String, a std::path::Path or a\n// &PathBuf; 0.28.0, std::path's named divergence); it reaches C as a NUL-ended copy on the stack, so nothing here allocates\n// but what returns a Vec or a String, on the allocator given. A path that\n// holds a NUL is InvalidInput, one longer than the system's PATH_MAX the\n// OS's ENAMETOOLONG (Rust passes it to the OS, which says the same).\n// mvs: std::fs\n\nuse crate::alloc::Allocator;\nuse crate::convert::AsRef;\nuse crate::io::{Error, ErrorKind, Read, Result, Seek, SeekFrom, Write};\nuse crate::iter::Iterator;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::time::SystemTime;\nuse crate::vec::Vec;\n\n");
    buf_str(out, c"// UNSAFE: the OS's file and directory calls, which take NUL-ended paths\n// and buffers as raw pointers.\n// SAFETY: POSIX's prototypes (fcntl.h, unistd.h, sys/stat.h, dirent.h,\n// stdio.h); open's mode is variadic, as declared. The callers pass a\n// CPath's buffer (NUL-ended), a StatBuf's words (larger than either\n// system's struct stat) and a DIR * that opendir returned.\nextern \"C\" {\n    #[link_name = \"open\"]\n    fn fs_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn fs_c_close(fd: i32) -> i32;\n    #[link_name = \"lseek\"]\n    fn fs_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn fs_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    fn fs_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fchmod\"]\n    #[effects(io)]\n    fn fs_c_fchmod(fd: i32, mode: u32) -> i32;\n    #[link_name = \"fstat\"]\n    fn fs_c_fstat(fd: i32, buf: *mut u64) -> i32;\n    #[link_name = \"stat\"]\n    fn fs_c_stat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"lstat\"]\n    #[effects(io)]\n    fn fs_c_lstat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"mkdir\"]\n    fn fs_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    fn fs_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    fn fs_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    fn fs_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"opendir\"]\n    #[effects(io)]\n    fn fs_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    #[effects(io)]\n    fn fs_c_readdir(dir: *mut u8) -> *const u8;\n    #[link_name = \"closedir\"]\n    #[effects(io)]\n    fn fs_c_closedir(dir: *mut u8) -> i32;\n}\n\nconst O_RDONLY: i32 = 0;\nconst O_WRONLY: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst S_IFMT: u32 = 0xf000;\nconst S_IFDIR: u32 = 0x4000;\nconst S_IFREG: u32 = 0x8000;\n");
    buf_str(out, c"const S_IFLNK: u32 = 0xa000;\nconst DT_DIR: u8 = 4;\nconst DT_REG: u8 = 8;\nconst DT_LNK: u8 = 10;\nconst EINVAL: i32 = 22;\n\n// A path and its NUL, as C takes it.\nstruct CPath {\n    buf: [u8; crate::__sys::PATH_MAX],\n}\n\nimpl CPath {\n    fn ptr(&self) -> *const u8 {\n        &self.buf[0] as *const u8\n    }\n}\n\n// path as C takes it: InvalidInput when it holds a NUL, ENAMETOOLONG when\n// it does not fit.\nfn cpath(path: &str) -> Result<CPath> {\n    let b = path.as_bytes();\n    let mut p = CPath { buf: [0u8; crate::__sys::PATH_MAX] };\n    if b.len() >= p.buf.len() {\n        return crate::result::Result::Err(Error::from_raw_os_error(crate::__sys::ENAMETOOLONG));\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 {\n            return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n                \"file name contained an unexpected NUL byte\"));\n        }\n        p.buf[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(p)\n}\n\n// A C call's -1 as the io::Error errno says.\nfn cvt(r: i32) -> Result<()> {\n    if r < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(())\n    }\n}\n\nfn open_c(path: &str, flags: i32, mode: u32) -> Result<File> {\n    let p = cpath(path)?;\n    // UNSAFE: C's open. SAFETY: p is NUL-ended and lives past the call;\n    // the mode is the variadic int open reads when it creates the file.\n    let fd = unsafe { fs_c_open(p.ptr(), flags | crate::__sys::O_CLOEXEC, mode as i32) };\n    if fd < 0 {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    crate::result::Result::Ok(File { fd: fd })\n}\n\n// Room for either system's struct stat (144 bytes on macOS, 128 on Linux).\nstruct StatBuf {\n    words: [u64; 20],\n}\n\nfn metadata_of(b: &StatBuf) -> Metadata {\n    let (mode, size, mtime, mtime_nsec) = crate::__sys::stat_fields(&b.words);\n");
    buf_str(out, c"    Metadata { mode: mode, size: size, mtime: mtime, mtime_nsec: mtime_nsec }\n}\n\n// stat, or lstat (follow false), of the file at path.\nfn stat_at(path: &str, follow: bool) -> Result<Metadata> {\n    let p = cpath(path)?;\n    let mut b = StatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat and lstat. SAFETY: p is NUL-ended; b.words is 160\n    // bytes, 8-aligned, more than either system's struct stat.\n    let r = unsafe {\n        if follow {\n            fs_c_stat(p.ptr(), &mut b.words[0] as *mut u64)\n        } else {\n            fs_c_lstat(p.ptr(), &mut b.words[0] as *mut u64)\n        }\n    };\n    cvt(r)?;\n    crate::result::Result::Ok(metadata_of(&b))\n}\n\n// ---- Files ----\n\n// An open file; dropping it closes it.\npub struct File {\n    fd: i32,\n}\n\nimpl Drop for File {\n    fn drop(&mut self) {\n        // UNSAFE: C's close. SAFETY: fd is this File's own descriptor,\n        // closed once (here).\n        let _ = unsafe { fs_c_close(self.fd) };\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    #[effects(io, static, panic, diverge)]\n    pub fn open<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDONLY, 0x1b6)\n    }\n\n    // Opens path for writing: made when it is not there, emptied when it is.\n    #[effects(io, static, panic, diverge)]\n    pub fn create<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC, 0x1b6)\n    }\n\n    // Makes path and opens it for reading and writing: AlreadyExists when\n    // it is there.\n    #[effects(io, static, panic, diverge)]\n    pub fn create_new<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDWR | crate::__sys::O_CREAT | crate::__sys::O_EXCL, 0x1b6)\n    }\n\n    // The options to open a file with: `File::options().append(true)`.\n    #[effects()]\n");
    buf_str(out, c"    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    // std: changed: File's own (Rust's: std::os::fd::AsRawFd)\n    #[effects()]\n    pub fn as_raw_fd(&self) -> i32 {\n        self.fd\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        let mut b = StatBuf { words: [0u64; 20] };\n        // UNSAFE: C's fstat. SAFETY: b.words as in stat_at.\n        cvt(unsafe { fs_c_fstat(self.fd, &mut b.words[0] as *mut u64) })?;\n        crate::result::Result::Ok(metadata_of(&b))\n    }\n\n    // Its length becomes size (cut, or zeros after).\n    // std: changed: u64 (MVS: i64)\n    #[effects(io, static, unsafe)]\n    pub fn set_len(&self, size: u64) -> Result<()> {\n        if size > i64::MAX as u64 {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        // UNSAFE: C's ftruncate. SAFETY: integers only.\n        cvt(unsafe { fs_c_ftruncate(self.fd, size as i64) })\n    }\n\n    // What the system holds of it, written to the disk.\n    #[effects(io, static, unsafe)]\n    pub fn sync_all(&self) -> Result<()> {\n        // UNSAFE: C's fsync. SAFETY: an int only.\n        cvt(unsafe { fs_c_fsync(self.fd) })\n    }\n}\n\n// `File { fd: 3 }`.\n// std: changed: the descriptor only (Rust's adds the path and the mode)\nimpl crate::fmt::Debug for File {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"File\").field(\"fd\", &self.fd).finish()\n    }\n}\n\nimpl Read for File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Write for File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A shared File reads and writes too (the OS keeps its position).\n");
    buf_str(out, c"impl Read for &File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read((*self).fd, buf)\n    }\n}\n\nimpl Write for &File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write((*self).fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// mvs: File::seek\nimpl Seek for File {\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64> {\n        let (off, whence) = match pos {\n            SeekFrom::Start(o) => {\n                if o > i64::MAX as u64 {\n                    return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n                }\n                (o as i64, 0)\n            }\n            SeekFrom::Current(o) => (o, 1),\n            SeekFrom::End(o) => (o, 2),\n        };\n        // UNSAFE: C's lseek. SAFETY: integers only.\n        let r = unsafe { fs_c_lseek(self.fd, off, whence) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(r as u64)\n    }\n}\n\n// How File::open opens a file, Rust's builder:\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n#[derive(Clone, Debug)]\npub struct OpenOptions {\n    read: bool,\n    write: bool,\n    append: bool,\n    truncate: bool,\n    create: bool,\n    create_new: bool,\n    mode: u32,\n}\n\nimpl OpenOptions {\n    // Every option off (open fails until read, write or append is on).\n    #[effects()]\n    pub fn new() -> OpenOptions {\n        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    // std: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn read(&mut self, read: bool) -> &mut OpenOptions {\n        self.read = read;\n        self\n    }\n\n    // std: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n");
    buf_str(out, c"    pub fn write(&mut self, write: bool) -> &mut OpenOptions {\n        self.write = write;\n        self\n    }\n\n    // Writes go to the end (write is implied).\n    // std: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn append(&mut self, append: bool) -> &mut OpenOptions {\n        self.append = append;\n        self\n    }\n\n    // std: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {\n        self.truncate = truncate;\n        self\n    }\n\n    // std: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create(&mut self, create: bool) -> &mut OpenOptions {\n        self.create = create;\n        self\n    }\n\n    // std: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {\n        self.create_new = create_new;\n        self\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    // std: changed: OpenOptions' own, a u32 (Rust's:\n    // std::os::unix::fs::OpenOptionsExt)\n    #[effects()]\n    pub fn mode(&mut self, mode: u32) -> &mut OpenOptions {\n        self.mode = mode;\n        self\n    }\n\n    // Opens path with these options: InvalidInput (EINVAL) for none of\n    // read, write and append, or a create or truncate without a write, as\n    // Rust's.\n    #[effects(io, static, panic, diverge)]\n    pub fn open<P: AsRef<str>>(&self, path: P) -> Result<File> {\n        let path = path.as_ref();\n        let access = if self.append {\n            (if self.read { O_RDWR } else { O_WRONLY }) | crate::__sys::O_APPEND\n        } else if self.read && self.write {\n            O_RDWR\n        } else if self.write {\n            O_WRONLY\n        } else if self.read {\n            O_RDONLY\n        } else {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        };\n");
    buf_str(out, c"        if !self.write && !self.append && (self.truncate || self.create || self.create_new) {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        if self.append && self.truncate && !self.create_new {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        let creation = if self.create_new {\n            crate::__sys::O_CREAT | crate::__sys::O_EXCL\n        } else {\n            (if self.create { crate::__sys::O_CREAT } else { 0 })\n                | (if self.truncate { crate::__sys::O_TRUNC } else { 0 })\n        };\n        open_c(path, access | creation, self.mode)\n    }\n}\n\n// What stat says of a file.\n#[derive(Clone)]\npub struct Metadata {\n    mode: u32,\n    size: u64,\n    mtime: i64,\n    mtime_nsec: i64,\n}\n\nimpl Metadata {\n    // The size in bytes.\n    #[effects()]\n    pub fn len(&self) -> u64 {\n        self.size\n    }\n\n    #[effects()]\n    pub fn file_type(&self) -> FileType {\n        FileType { fmt: self.mode & S_IFMT }\n    }\n\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.mode & S_IFMT == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.mode & S_IFMT == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.mode & S_IFMT == S_IFLNK\n    }\n\n    #[effects()]\n    pub fn permissions(&self) -> Permissions {\n        Permissions { mode: self.mode }\n    }\n\n    // When it was last written (UNIX_EPOCH for a time before it).\n    // mvs: Metadata::modified\n    // std: changed: an io::Result<SystemTime>, as Rust's (MVS: a\n    // Duration since the epoch)\n    #[effects(panic)]\n    pub fn modified(&self) -> Result<SystemTime> {\n        let epoch = crate::time::UNIX_EPOCH;\n        if self.mtime < 0 {\n            return crate::result::Result::Ok(epoch);\n        }\n        let d = crate::time::Duration::new(self.mtime as u64, self.mtime_nsec as u32);\n");
    buf_str(out, c"        match epoch.checked_add(d) {\n            Option::Some(t) => crate::result::Result::Ok(t),\n            Option::None => crate::result::Result::Ok(epoch),\n        }\n    }\n}\n\n// `Metadata { file_type: .., len: 6, .. }`.\n// std: changed: the kind and the length (Rust's adds the permissions and\n// the times)\nimpl crate::fmt::Debug for Metadata {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Metadata\").field(\"file_type\", &self.file_type()).field(\"len\", &self.size)\n            .finish_non_exhaustive()\n    }\n}\n\n// A file's kind: a directory, a file, a symbolic link (or another).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct FileType {\n    fmt: u32,\n}\n\nimpl FileType {\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.fmt == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.fmt == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.fmt == S_IFLNK\n    }\n}\n\n// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as\n// Rust's.\nimpl crate::fmt::Debug for FileType {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"FileType\").field(\"is_file\", &self.is_file()).field(\"is_dir\", &self.is_dir())\n            .field(\"is_symlink\", &self.is_symlink()).finish_non_exhaustive()\n    }\n}\n\n// A file's permission bits.\n#[derive(Clone, PartialEq, Eq)]\npub struct Permissions {\n    mode: u32,\n}\n\nimpl Permissions {\n    // Whether no one may write it.\n    #[effects()]\n    pub fn readonly(&self) -> bool {\n        self.mode & 0x92 == 0\n    }\n\n    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).\n    // mvs: Metadata::mode\n    // std: changed: Permissions' own, st_mode as Rust's (Rust's:\n    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)\n    #[effects()]\n");
    buf_str(out, c"    pub fn mode(&self) -> u32 {\n        self.mode\n    }\n}\n\n// ---- Whole files ----\n\n// The bytes of the file at path, in a new Vec on a.\n// std: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<Vec<u8, A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let size = match f.metadata() {\n        crate::result::Result::Ok(m) => m.len() as usize,\n        crate::result::Result::Err(_) => 0,\n    };\n    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);\n    f.read_to_end(&mut v)?;\n    crate::result::Result::Ok(v)\n}\n\n// The text of the file at path, in a new String on a (InvalidData when it\n// is not UTF-8).\n// std: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read_to_string)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_to_string_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<String<A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let mut s = String::new_in(a);\n    f.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// The file at path holds contents: made, or emptied first.\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P, C)]\npub fn write<P: AsRef<str>, C: AsRef<[u8]>>(path: P, contents: C) -> Result<()> {\n    let path = path.as_ref();\n    let mut f = File::create(path)?;\n    // (the path call: `contents.as_ref()` where a &[u8] is expected picks\n    // a wrong instance of AsRef for &T, 0.27.5's front gap)\n    f.write_all(AsRef::<[u8]>::as_ref(&contents))\n}\n\n// Copies the file at from to to (made, or emptied), its permission bits\n// too: the bytes copied.\n// std: changed: the paths AsRef<str> (Rust: AsRef<Path>); a u64 (MVS: i64)\n#[effects(io, static, panic, diverge, unsafe, P, Q)]\n");
    buf_str(out, c"pub fn copy<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<u64> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let mut src = File::open(from)?;\n    let m = src.metadata()?;\n    if !m.is_file() {\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n            \"the source path is neither a regular file nor a symlink to a regular file\"));\n    }\n    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,\n        m.mode & 0xfff)?;\n    // UNSAFE: C's fchmod. SAFETY: integers only.\n    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;\n    let mut buf = [0u8; 65536];\n    let mut total: u64 = 0;\n    loop {\n        let n = match src.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        dst.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// What stat says of the file at path (through a symbolic link).\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, true)\n}\n\n// As metadata, of a symbolic link itself.\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn symlink_metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, false)\n}\n\n// Whether something is at path (through a symbolic link): Ok(false) when\n// nothing is, an error when the OS cannot say (Rust's fs::exists).\n// std: changed: an io::Result<bool>, as Rust's (MVS: a bool); the path an\n");
    buf_str(out, c"// AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn exists<P: AsRef<str>>(path: P) -> Result<bool> {\n    let path = path.as_ref();\n    match stat_at(path, true) {\n        crate::result::Result::Ok(_) => crate::result::Result::Ok(true),\n        crate::result::Result::Err(e) => {\n            if e.kind() == ErrorKind::NotFound {\n                crate::result::Result::Ok(false)\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_file<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's unlink. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_unlink(p.ptr()) })\n}\n\n// Removes the empty directory at path.\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's rmdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_rmdir(p.ptr()) })\n}\n\n// std: changed: the paths AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn rename<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<()> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = cpath(from)?;\n    let b = cpath(to)?;\n    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.\n    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })\n}\n\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn create_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })\n}\n\n");
    buf_str(out, c"// Whether path is a directory (through a symbolic link).\nfn is_dir_at(path: &str) -> bool {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(m) => m.is_dir(),\n        crate::result::Result::Err(_) => false,\n    }\n}\n\n// path's parent as Rust's Path::parent has it: \"\" for a relative name,\n// None for the root (or \"\").\nfn parent_of(path: &str) -> Option<&str> {\n    let b = path.as_bytes();\n    let mut end = b.len();\n    while end > 0 && b[end - 1] == 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::None;\n    }\n    while end > 0 && b[end - 1] != 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::Some(&path[..0]);\n    }\n    let mut k = end;\n    while k > 0 && b[k - 1] == 47 {\n        k -= 1;\n    }\n    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }\n}\n\n// Makes the directory at path and those above it that are missing: Ok\n// when it is there (Rust's, step for step).\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, P)]\npub fn create_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    if path.is_empty() {\n        return crate::result::Result::Ok(());\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => return crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if e.kind() != ErrorKind::NotFound {\n                return if is_dir_at(path) {\n                    crate::result::Result::Ok(())\n                } else {\n                    crate::result::Result::Err(e)\n                };\n            }\n        }\n    }\n    match parent_of(path) {\n        Option::Some(p) => create_dir_all(p)?,\n        Option::None => {\n            return crate::result::Result::Err(Error::other(\"failed to create whole tree\"));\n        }\n    }\n    match create_dir(path) {\n");
    buf_str(out, c"        crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if is_dir_at(path) {\n                crate::result::Result::Ok(())\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// Removes the directory at path and all it holds; a symbolic link is\n// removed, not followed.\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P)]\npub fn remove_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let m = symlink_metadata(path)?;\n    if m.is_symlink() {\n        return remove_file(path);\n    }\n    if !m.is_dir() {\n        return crate::result::Result::Err(Error::from_raw_os_error(20));\n    }\n    remove_tree(path)\n}\n\n// Removes the directory at path and everything under it.\nfn remove_tree(path: &str) -> Result<()> {\n    let mut dir = read_dir(path)?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        if e.file_type()?.is_dir() {\n            remove_tree(e.path())?;\n        } else {\n            remove_file(e.path())?;\n        }\n    }\n    remove_dir(path)\n}\n\n// ---- Directories ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\n// std: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn read_dir<P: AsRef<str>>(path: P) -> Result<ReadDir> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.\n    let d = unsafe { fs_c_opendir(p.ptr()) };\n    if d.is_null() {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    let mut root = [0u8; crate::__sys::PATH_MAX];\n    let b = path.as_bytes();\n    let mut i: usize = 0;\n    while i < b.len() {\n");
    buf_str(out, c"        root[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir {\n    dir: *mut u8,\n    root: [u8; crate::__sys::PATH_MAX],\n    root_len: usize,\n}\n\nimpl Drop for ReadDir {\n    fn drop(&mut self) {\n        // UNSAFE: C's closedir. SAFETY: dir is the DIR * opendir returned,\n        // non-null (read_dir checks), closed once (here).\n        let _ = unsafe { fs_c_closedir(self.dir) };\n    }\n}\n\nimpl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(&mut self) -> Option<Result<DirEntry>> {\n        loop {\n            let mut e = DirEntry {\n                path: [0u8; crate::__sys::PATH_MAX], len: 0, name_at: 0, kind: 0,\n            };\n            // UNSAFE: errno cleared, then C's readdir on the DIR *, and its\n            // struct dirent read through the pointer readdir returns.\n            // SAFETY: errno_location is this thread's errno; dir is open\n            // (Drop closes it, after the last next); a non-null entry is a\n            // struct dirent of this system (its d_type and d_name at the\n            // offsets std::__sys gives), valid until the next readdir of\n            // dir, and d_name is NUL-ended within it: its bytes are copied\n            // out before this returns.\n            let ok = unsafe {\n                *crate::__sys::errno_location() = 0;\n                let d = fs_c_readdir(self.dir);\n                if d.is_null() {\n                    let err = *crate::__sys::errno_location();\n                    if err == 0 {\n                        return Option::None;\n                    }\n                    return Option::Some(crate::result::Result::Err(Error::from_raw_os_error(err)));\n                }\n                e.kind = *d.add(crate::__sys::DIRENT_TYPE);\n");
    buf_str(out, c"                let name = d.add(crate::__sys::DIRENT_NAME);\n                let mut n: usize = 0;\n                while *name.add(n) != 0 {\n                    n += 1;\n                }\n                let nm = crate::slice::from_raw_parts(name, n);\n                if nm == b\".\" || nm == b\"..\" {\n                    continue;\n                }\n                e.fill(&self.root[..self.root_len], nm)\n            };\n            if !ok {\n                return Option::Some(crate::result::Result::Err(Error::new(\n                    ErrorKind::InvalidData,\n                    \"a directory entry's name is not UTF-8 or the path is too long\")));\n            }\n            return Option::Some(crate::result::Result::Ok(e));\n        }\n    }\n}\n\n// A directory's entry: its path (the directory's, then its name), kept\n// inline, and its kind as the directory says it.\npub struct DirEntry {\n    path: [u8; crate::__sys::PATH_MAX],\n    len: usize,\n    name_at: usize,\n    kind: u8,\n}\n\nimpl DirEntry {\n    // root, a \"/\" unless root ends with one, and name: false when it does\n    // not fit or is not UTF-8.\n    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {\n        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n");
    buf_str(out, c"        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std: changed: a &str, a view of the entry (Rust's: a PathBuf; MVS:\n    // a PathBuf on an allocator; path_in could make one on an allocator)\n    #[effects(panic, diverge)]\n    pub fn path(&self) -> &str {\n        self.text(0)\n    }\n\n    // Its name.\n    // std: changed: a &str, a view of the entry, until std::ffi (Rust's:\n    // an OsString; a name that is not UTF-8 is read_dir's InvalidData)\n    #[effects(panic, diverge)]\n    pub fn file_name(&self) -> &str {\n        self.text(self.name_at)\n    }\n\n    // What lstat says of it.\n    #[effects(io, static, panic, diverge)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        stat_at(self.path(), false)\n    }\n\n    // Its kind as the directory says it (lstat's when the file system does\n    // not say).\n    #[effects(io, static, panic, diverge)]\n    pub fn file_type(&self) -> Result<FileType> {\n        if self.kind == DT_DIR {\n            crate::result::Result::Ok(FileType { fmt: S_IFDIR })\n        } else if self.kind == DT_REG {\n            crate::result::Result::Ok(FileType { fmt: S_IFREG })\n        } else if self.kind == DT_LNK {\n            crate::result::Result::Ok(FileType { fmt: S_IFLNK })\n        } else {\n            crate::result::Result::Ok(self.metadata()?.file_type())\n        }\n    }\n}\n// ---- end mod std::fs ----\n}\n// ---- mod std::path ----\npub mod path {\n// std::path (0.28.0): Path and PathBuf, Rust's names and meanings over\n// UTF-8 text ('/' between the components, as on Unix).\n//\n// A named divergence from Rust: Rust's `Path` is an unsized newtype over\n// OsStr, reached as `&Path`; the rust edition has no unsized newtypes\n// yet (rust-surface-plan.md, later: \"an unsized newtype\"), so `Path<'a>`\n");
    buf_str(out, c"// is a sized, copyable view of a `&'a str`, written `Path<'_>` (or `Path`\n// with its lifetime elided) where Rust writes `&Path`, and a component is\n// a `&str` where Rust's is an `&OsStr`. `PathBuf<A>` owns its text in a\n// String<A>; it derefs to str, so `fs::metadata(&p)` takes it, and it has\n// Path's methods itself. A path taken as an argument is `P: AsRef<str>`\n// (Rust's `AsRef<Path>`): a &str, a String, a Path or a PathBuf. When the\n// front has unsized newtypes, `Path<'a>` becomes `&'a Path`.\n// mvs: std::path\n\nuse crate::alloc::Allocator;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::{DoubleEndedIterator, Iterator};\nuse crate::ops::Deref;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\n\n// ---- Components ----\n\n// One component of a path: the root, a leading \".\", \"..\", or a name.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Component<'a> {\n    RootDir,\n    CurDir,\n    ParentDir,\n    Normal(&'a str),\n}\n\nimpl<'a> Component<'a> {\n    // Its text: \"/\", \".\", \"..\" or the name.\n    // std: changed: a &str (Rust: as_os_str, an &OsStr)\n    #[effects()]\n    pub fn as_str(self) -> &'a str {\n        match self {\n            Component::RootDir => \"/\",\n            Component::CurDir => \".\",\n            Component::ParentDir => \"..\",\n            Component::Normal(s) => s,\n        }\n    }\n}\n\nimpl<'a> AsRef<str> for Component<'a> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\n// The length of s's prefix component: 1 for the root ('/') or for a\n// leading \".\" (\".\", \"./...\"), else 0.\nfn prefix_len(s: &str) -> usize {\n    let b = s.as_bytes();\n    if b.len() > 0 && b[0] == b'/' {\n        return 1;\n    }\n    if b.len() > 0 && b[0] == b'.' && (b.len() == 1 || b[1] == b'/') {\n        return 1;\n    }\n    0\n}\n\n");
    buf_str(out, c"// `p.components()`: the root or a leading \".\" first, then the names and\n// \"..\"s; empty components and \".\" past the first are left out, as Rust's.\n// Both ends: `next_back` gives the last component.\n#[derive(Clone, Copy)]\npub struct Components<'a> {\n    s: &'a str,\n    // the prefix component (RootDir or CurDir) not yet given\n    pre: bool,\n    // the body not yet given: s[front..back]\n    front: usize,\n    back: usize,\n}\n\nimpl<'a> Components<'a> {\n    fn of(s: &'a str) -> Components<'a> {\n        let n = prefix_len(s);\n        Components { s: s, pre: n > 0, front: n, back: s.len() }\n    }\n\n    fn prefix(&self) -> Component<'a> {\n        if self.s.as_bytes()[0] == b'/' { Component::RootDir } else { Component::CurDir }\n    }\n\n    fn body(c: &'a str) -> Option<Component<'a>> {\n        if c.len() == 0 || c == \".\" {\n            Option::None\n        } else if c == \"..\" {\n            Option::Some(Component::ParentDir)\n        } else {\n            Option::Some(Component::Normal(c))\n        }\n    }\n\n    // What is left, as a path: \"\" when nothing is.\n    #[effects(panic, diverge)]\n    pub fn as_path(&self) -> Path<'a> {\n        let b = self.s.as_bytes();\n        let mut lo = self.front;\n        let mut hi = self.back;\n        // trailing '/'s and \".\" components\n        loop {\n            if hi > lo && b[hi - 1] == b'/' {\n                hi -= 1;\n            } else if hi > lo && b[hi - 1] == b'.' && (hi - 1 == lo || b[hi - 2] == b'/') {\n                hi -= 1;\n            } else {\n                break;\n            }\n        }\n        if self.pre {\n            let n = prefix_len(self.s);\n            return Path { s: &self.s[0..if hi > n { hi } else { n }] };\n        }\n        // leading '/'s and \".\" components\n        loop {\n            if lo < hi && b[lo] == b'/' {\n                lo += 1;\n            } else if lo < hi && b[lo] == b'.' && (lo + 1 == hi || b[lo + 1] == b'/') {\n");
    buf_str(out, c"                lo += 1;\n            } else {\n                break;\n            }\n        }\n        Path { s: &self.s[lo..hi] }\n    }\n}\n\nimpl<'a> Iterator for Components<'a> {\n    type Item = Component<'a>;\n\n    fn next(&mut self) -> Option<Component<'a>> {\n        if self.pre {\n            self.pre = false;\n            return Option::Some(self.prefix());\n        }\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n            let start = self.front;\n            let mut end = start;\n            while end < self.back && b[end] != b'/' {\n                end += 1;\n            }\n            self.front = if end < self.back { end + 1 } else { end };\n            match Components::body(&self.s[start..end]) {\n                Option::Some(c) => return Option::Some(c),\n                Option::None => {}\n            }\n        }\n        Option::None\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Components<'a> {\n    fn next_back(&mut self) -> Option<Component<'a>> {\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n            let end = self.back;\n            let mut start = end;\n            while start > self.front && b[start - 1] != b'/' {\n                start -= 1;\n            }\n            self.back = if start > self.front { start - 1 } else { start };\n            match Components::body(&self.s[start..end]) {\n                Option::Some(c) => return Option::Some(c),\n                Option::None => {}\n            }\n        }\n        if self.pre {\n            self.pre = false;\n            return Option::Some(self.prefix());\n        }\n        Option::None\n    }\n}\n\n// `p.iter()`: the components' texts.\n// (Rust's path::Iter: named apart here, as the lazy std reads items by\n// name and an `Iter` would bring std::path into every program that names\n// a slice's.)\n// std: changed: its name (Rust: path::Iter)\n#[derive(Clone, Copy)]\npub struct PathIter<'a> {\n");
    buf_str(out, c"    inner: Components<'a>,\n}\n\nimpl<'a> PathIter<'a> {\n    // What is left, as a path.\n    #[effects(panic, diverge)]\n    pub fn as_path(&self) -> Path<'a> {\n        self.inner.as_path()\n    }\n}\n\nimpl<'a> Iterator for PathIter<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.inner.next() {\n            Option::Some(c) => Option::Some(c.as_str()),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for PathIter<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        match self.inner.next_back() {\n            Option::Some(c) => Option::Some(c.as_str()),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// `p.ancestors()`: p, its parent, the parent's parent, ...\n#[derive(Clone, Copy)]\npub struct Ancestors<'a> {\n    next: Option<Path<'a>>,\n}\n\nimpl<'a> Iterator for Ancestors<'a> {\n    type Item = Path<'a>;\n\n    fn next(&mut self) -> Option<Path<'a>> {\n        let cur = self.next;\n        match cur {\n            Option::Some(p) => self.next = p.parent(),\n            Option::None => {}\n        }\n        cur\n    }\n}\n\n// ---- Path ----\n\n// A path: a view of its text.\n// std: changed: a sized view `Path<'a>`, Rust's `&'a Path` (no unsized\n// newtypes yet); MVS: a distinct [u8]\n#[derive(Clone, Copy)]\npub struct Path<'a> {\n    s: &'a str,\n}\n\n// What `strip_prefix` fails with: the base is not a prefix.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct StripPrefixError {}\n\nimpl Display for StripPrefixError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"prefix not found\")\n    }\n}\n\n// The byte range of the file name in s (its last Normal component): it\n// ends where the trailing '/'s and \".\" components start.\nfn file_name_range(s: &str) -> Option<(usize, usize)> {\n    let n = match Path::new(s).file_name() {\n        Option::Some(n) => n.len(),\n");
    buf_str(out, c"        Option::None => return Option::None,\n    };\n    let b = s.as_bytes();\n    let mut hi = b.len();\n    loop {\n        if hi > 0 && b[hi - 1] == b'/' {\n            hi -= 1;\n        } else if hi > 0 && b[hi - 1] == b'.' && (hi == 1 || b[hi - 2] == b'/') {\n            hi -= 1;\n        } else {\n            break;\n        }\n    }\n    Option::Some((hi - n, hi))\n}\n\n// A file name split at its last '.': (stem, extension); \"..\" and a name\n// whose only '.' leads (\".bashrc\") have no extension.\nfn split_dot(name: &str) -> (&str, Option<&str>) {\n    if name == \"..\" {\n        return (name, Option::None);\n    }\n    match name.rfind('.') {\n        Option::Some(0) => (name, Option::None),\n        Option::Some(k) => (&name[0..k], Option::Some(&name[k + 1..])),\n        Option::None => (name, Option::None),\n    }\n}\n\nimpl<'a> Path<'a> {\n    // The path of the text s: `Path::new(\"a/b.txt\")`.\n    // std: changed: a Path<'a> of a &'a str (Rust: &Path of an AsRef<OsStr>)\n    #[effects()]\n    pub fn new(s: &'a str) -> Path<'a> {\n        Path { s: s }\n    }\n\n    // Its text.\n    // std: changed: Rust's as_os_str, a &str\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.s\n    }\n\n    // Its text: always Some, a path being UTF-8 here.\n    #[effects()]\n    pub fn to_str(&self) -> Option<&'a str> {\n        Option::Some(self.s)\n    }\n\n    // Its bytes.\n    #[effects()]\n    pub fn as_bytes(&self) -> &'a [u8] {\n        self.s.as_bytes()\n    }\n\n    // What prints it: the path itself, which is Display.\n    // std: changed: a Path (Rust: a path::Display)\n    #[effects()]\n    pub fn display(&self) -> Path<'a> {\n        *self\n    }\n\n    #[effects(panic)]\n    pub fn is_absolute(&self) -> bool {\n        self.has_root()\n    }\n\n    #[effects(panic)]\n    pub fn is_relative(&self) -> bool {\n        !self.has_root()\n    }\n\n    // Whether it starts with '/'.\n    #[effects(panic)]\n");
    buf_str(out, c"    pub fn has_root(&self) -> bool {\n        self.s.len() > 0 && self.s.as_bytes()[0] == b'/'\n    }\n\n    // Its components.\n    #[effects(panic)]\n    pub fn components(&self) -> Components<'a> {\n        Components::of(self.s)\n    }\n\n    // Its components' texts.\n    #[effects(panic)]\n    pub fn iter(&self) -> PathIter<'a> {\n        PathIter { inner: Components::of(self.s) }\n    }\n\n    // It and its parents, up to the root (or \"\").\n    #[effects()]\n    pub fn ancestors(&self) -> Ancestors<'a> {\n        Ancestors { next: Option::Some(*self) }\n    }\n\n    // The path without its last component: None for \"/\" and \"\", \"\" for a\n    // single relative component.\n    #[effects(panic, diverge)]\n    pub fn parent(&self) -> Option<Path<'a>> {\n        let mut c = Components::of(self.s);\n        match c.next_back() {\n            Option::Some(Component::RootDir) => Option::None,\n            Option::Some(_) => Option::Some(c.as_path()),\n            Option::None => Option::None,\n        }\n    }\n\n    // The last component, when it is a name (not \"/\", \".\" or \"..\").\n    // std: changed: a &str (Rust: &OsStr; MVS: a Path)\n    #[effects(panic, diverge)]\n    pub fn file_name(&self) -> Option<&'a str> {\n        match Components::of(self.s).next_back() {\n            Option::Some(Component::Normal(n)) => Option::Some(n),\n            _ => Option::None,\n        }\n    }\n\n    // The file name before its last '.' (all of it when it has none, or\n    // only a leading one).\n    // std: changed: a &str (Rust: &OsStr; MVS: a Path)\n    #[effects(panic, diverge)]\n    pub fn file_stem(&self) -> Option<&'a str> {\n        match self.file_name() {\n            Option::Some(n) => Option::Some(split_dot(n).0),\n            Option::None => Option::None,\n        }\n    }\n\n    // The file name after its last '.' (None for \".bashrc\" or \"a\").\n    // std: changed: a &str (Rust: &OsStr; MVS: a Path)\n    #[effects(panic, diverge)]\n");
    buf_str(out, c"    pub fn extension(&self) -> Option<&'a str> {\n        match self.file_name() {\n            Option::Some(n) => split_dot(n).1,\n            Option::None => Option::None,\n        }\n    }\n\n    // Whether base's components are its first ones.\n    // std: changed: base an AsRef<str> (Rust: AsRef<Path>)\n    #[effects(panic, diverge)]\n    pub fn starts_with<P: AsRef<str>>(&self, base: P) -> bool {\n        let mut mine = Components::of(self.s);\n        let mut theirs = Components::of(base.as_ref());\n        loop {\n            match theirs.next() {\n                Option::None => return true,\n                Option::Some(t) => match mine.next() {\n                    Option::Some(m) => {\n                        if m != t {\n                            return false;\n                        }\n                    }\n                    Option::None => return false,\n                },\n            }\n        }\n    }\n\n    // Whether child's components are its last ones.\n    // std: changed: child an AsRef<str> (Rust: AsRef<Path>)\n    #[effects(panic, diverge)]\n    pub fn ends_with<P: AsRef<str>>(&self, child: P) -> bool {\n        let mut mine = Components::of(self.s);\n        let mut theirs = Components::of(child.as_ref());\n        loop {\n            match theirs.next_back() {\n                Option::None => return true,\n                Option::Some(t) => match mine.next_back() {\n                    Option::Some(m) => {\n                        if m != t {\n                            return false;\n                        }\n                    }\n                    Option::None => return false,\n                },\n            }\n        }\n    }\n\n    // The path after base, when base's components are its first ones.\n    // std: changed: base an AsRef<str> (Rust: AsRef<Path>)\n    #[effects(panic, diverge)]\n    pub fn strip_prefix<P: AsRef<str>>(&self, base: P) -> Result<Path<'a>, StripPrefixError> {\n");
    buf_str(out, c"        let mut mine = Components::of(self.s);\n        let mut theirs = Components::of(base.as_ref());\n        loop {\n            match theirs.next() {\n                Option::None => return Result::Ok(mine.as_path()),\n                Option::Some(t) => match mine.next() {\n                    Option::Some(m) => {\n                        if m != t {\n                            return Result::Err(StripPrefixError {});\n                        }\n                    }\n                    Option::None => return Result::Err(StripPrefixError {}),\n                },\n            }\n        }\n    }\n\n    // The path with p after it, on allocator a (p absolute: p).\n    // std: changed: an allocator (Rust: join)\n    #[effects(P, A)]\n    pub fn join_in<P: AsRef<str>, A: Allocator>(&self, p: P, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.push(p);\n        out\n    }\n\n    // An owned copy, on allocator a.\n    // std: changed: an allocator (Rust: to_path_buf)\n    #[effects(A)]\n    pub fn to_path_buf_in<A: Allocator>(&self, a: A) -> PathBuf<A> {\n        PathBuf::from_in(self.s, a)\n    }\n\n    // The path with its file name replaced by name, on allocator a.\n    // std: changed: an allocator (Rust: with_file_name)\n    #[effects(S, A)]\n    pub fn with_file_name_in<S: AsRef<str>, A: Allocator>(&self, name: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_file_name(name);\n        out\n    }\n\n    // The path with its extension replaced by ext, on allocator a.\n    // std: changed: an allocator (Rust: with_extension)\n    #[effects(S, A)]\n    pub fn with_extension_in<S: AsRef<str>, A: Allocator>(&self, ext: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_extension(ext);\n        out\n    }\n\n    // What stat says of the file at the path.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n");
    buf_str(out, c"    pub fn metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::metadata(self.s)\n    }\n\n    // What lstat says of it.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn symlink_metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::symlink_metadata(self.s)\n    }\n\n    // Whether something is there (stat succeeds).\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn exists(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(_) => true,\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_dir(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(m) => m.is_dir(),\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_file(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(m) => m.is_file(),\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_symlink(&self) -> bool {\n        match crate::fs::symlink_metadata(self.s) {\n            Result::Ok(m) => m.is_symlink(),\n            Result::Err(_) => false,\n        }\n    }\n}\n\nimpl<'a> AsRef<str> for Path<'a> {\n    fn as_ref(&self) -> &str {\n        self.s\n    }\n}\n\n// Two paths are equal when their components are (\"a//b/\" is \"a/b\").\nimpl<'a> PartialEq for Path<'a> {\n    fn eq(&self, other: &Path<'a>) -> bool {\n        let mut x = Components::of(self.s);\n        let mut y = Components::of(other.s);\n        loop {\n            match x.next() {\n                Option::Some(c) => match y.next() {\n                    Option::Some(d) => {\n                        if c != d {\n                            return false;\n                        }\n                    }\n");
    buf_str(out, c"                    Option::None => return false,\n                },\n                Option::None => return y.next().is_none(),\n            }\n        }\n    }\n}\n\nimpl<'a> Eq for Path<'a> {}\n\n// Its text (Rust's `p.display()`).\nimpl<'a> Display for Path<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.s, f)\n    }\n}\n\n// Its text, quoted, as a str's Debug.\nimpl<'a> Debug for Path<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.s, f)\n    }\n}\n\n// ---- PathBuf ----\n\n// An owned path, its text in a String on allocator A.\n// std: changed: its text a String<A> (MVS: a pub Vec<u8, A>)\npub struct PathBuf<A: Allocator> {\n    s: String<A>,\n}\n\nimpl<A: Allocator> PathBuf<A> {\n    // An empty path.\n    // std: changed: an allocator (Rust: new)\n    pub fn new_in(a: A) -> PathBuf<A> {\n        PathBuf { s: String::new_in(a) }\n    }\n\n    // An empty path with room for n bytes.\n    // std: changed: an allocator (Rust: with_capacity)\n    #[effects(A)]\n    pub fn with_capacity_in(n: usize, a: A) -> PathBuf<A> {\n        PathBuf { s: String::with_capacity_in(n, a) }\n    }\n\n    // A path of s's text.\n    // std: changed: a &str (MVS: [u8]); Rust: PathBuf::from\n    #[effects(A)]\n    pub fn from_in(s: &str, a: A) -> PathBuf<A> {\n        PathBuf { s: String::from_in(s, a) }\n    }\n\n    // A path that owns s.\n    #[effects()]\n    pub fn from_string(s: String<A>) -> PathBuf<A> {\n        PathBuf { s: s }\n    }\n\n    // A view of it.\n    #[effects(A)]\n    pub fn as_path(&self) -> Path<'_> {\n        Path { s: self.s.as_str() }\n    }\n\n    // Its text.\n    // std: changed: Rust's as_os_str, a &str\n    #[effects(A)]\n    pub fn as_str(&self) -> &str {\n        self.s.as_str()\n    }\n\n    #[effects(A)]\n    pub fn as_bytes(&self) -> &[u8] {\n        self.s.as_bytes()\n    }\n\n    // Its String.\n");
    buf_str(out, c"    // std: changed: Rust's into_os_string, a String<A>\n    #[effects()]\n    pub fn into_string(self) -> String<A> {\n        self.s\n    }\n\n    #[effects(A)]\n    pub fn capacity(&self) -> usize {\n        self.s.capacity()\n    }\n\n    #[effects(A)]\n    pub fn clear(&mut self) {\n        self.s.clear();\n    }\n\n    // Appends p after a '/' (p absolute: p replaces the path).\n    // std: changed: p an AsRef<str> (Rust: AsRef<Path>; MVS: [u8])\n    #[effects(panic, A)]\n    pub fn push<P: AsRef<str>>(&mut self, p: P) {\n        let t = p.as_ref();\n        if t.len() > 0 && t.as_bytes()[0] == b'/' {\n            self.s.clear();\n        } else if self.s.len() > 0 && self.s.as_bytes()[self.s.len() - 1] != b'/' {\n            self.s.push('/');\n        }\n        self.s.push_str(t);\n    }\n\n    // Removes the last component: false when there is none (the root, or\n    // nothing).\n    #[effects(panic, diverge, A)]\n    pub fn pop(&mut self) -> bool {\n        let n = match self.as_path().parent() {\n            Option::Some(q) => q.as_str().len(),\n            Option::None => return false,\n        };\n        self.s.truncate(n);\n        true\n    }\n\n    // Its file name replaced by name (added when it has none).\n    // std: changed: name an AsRef<str> (Rust: AsRef<OsStr>)\n    #[effects(panic, diverge, A, S)]\n    pub fn set_file_name<S: AsRef<str>>(&mut self, name: S) {\n        if self.as_path().file_name().is_some() {\n            self.pop();\n        }\n        self.push(name);\n    }\n\n    // Its extension replaced by ext (added when it has none; \"\" removes\n    // it): false, and nothing changed, when it has no file name.\n    // std: changed: ext an AsRef<str> (Rust: AsRef<OsStr>; MVS: [u8])\n    #[effects(panic, diverge, A)]\n    pub fn set_extension<S: AsRef<str>>(&mut self, ext: S) -> bool {\n        let (start, end) = match file_name_range(self.s.as_str()) {\n            Option::Some(r) => r,\n            Option::None => return false,\n");
    buf_str(out, c"        };\n        let stem = split_dot(&self.s.as_str()[start..end]).0.len();\n        self.s.truncate(start + stem);\n        let e = ext.as_ref();\n        if e.len() > 0 {\n            self.s.push('.');\n            self.s.push_str(e);\n        }\n        true\n    }\n\n    // Path's methods, through as_path (Rust's PathBuf derefs to Path).\n\n    pub fn is_absolute(&self) -> bool {\n        self.as_path().is_absolute()\n    }\n\n    #[effects(panic, A)]\n    pub fn is_relative(&self) -> bool {\n        self.as_path().is_relative()\n    }\n\n    #[effects(panic, A)]\n    pub fn has_root(&self) -> bool {\n        self.as_path().has_root()\n    }\n\n    #[effects(A)]\n    pub fn to_str(&self) -> Option<&str> {\n        Option::Some(self.s.as_str())\n    }\n\n    #[effects(A)]\n    pub fn display(&self) -> Path<'_> {\n        self.as_path()\n    }\n\n    #[effects(panic, A)]\n    pub fn components(&self) -> Components<'_> {\n        self.as_path().components()\n    }\n\n    #[effects(panic, A)]\n    pub fn iter(&self) -> PathIter<'_> {\n        self.as_path().iter()\n    }\n\n    #[effects(A)]\n    pub fn ancestors(&self) -> Ancestors<'_> {\n        self.as_path().ancestors()\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn parent(&self) -> Option<Path<'_>> {\n        self.as_path().parent()\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn file_name(&self) -> Option<&str> {\n        self.as_path().file_name()\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn file_stem(&self) -> Option<&str> {\n        self.as_path().file_stem()\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn extension(&self) -> Option<&str> {\n        self.as_path().extension()\n    }\n\n    #[effects(A, P)]\n    pub fn starts_with<P: AsRef<str>>(&self, base: P) -> bool {\n        self.as_path().starts_with(base)\n    }\n\n    #[effects(A, P)]\n    pub fn ends_with<P: AsRef<str>>(&self, child: P) -> bool {\n        self.as_path().ends_with(child)\n    }\n\n");
    buf_str(out, c"    #[effects(A, P)]\n    pub fn strip_prefix<P: AsRef<str>>(&self, base: P) -> Result<Path<'_>, StripPrefixError> {\n        self.as_path().strip_prefix(base)\n    }\n\n    #[effects(A, P, B)]\n    pub fn join_in<P: AsRef<str>, B: Allocator>(&self, p: P, b: B) -> PathBuf<B> {\n        self.as_path().join_in(p, b)\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn exists(&self) -> bool {\n        self.as_path().exists()\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn is_dir(&self) -> bool {\n        self.as_path().is_dir()\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn is_file(&self) -> bool {\n        self.as_path().is_file()\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        self.as_path().metadata()\n    }\n}\n\n// Its text: `fs::metadata(&p)`, `p.len()`.\n// std: changed: derefs to str (Rust: to Path)\nimpl<A: Allocator> Deref for PathBuf<A> {\n    type Target = str;\n\n    fn deref(&self) -> &str {\n        self.s.as_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<str> for PathBuf<A> {\n    fn as_ref(&self) -> &str {\n        self.s.as_str()\n    }\n}\n\n// A copy on the same allocator (a clone of it).\nimpl<A: Allocator + Clone> Clone for PathBuf<A> {\n    fn clone(&self) -> PathBuf<A> {\n        PathBuf { s: self.s.clone() }\n    }\n}\n\nimpl<A: Allocator, B: Allocator> PartialEq<PathBuf<B>> for PathBuf<A> {\n    fn eq(&self, other: &PathBuf<B>) -> bool {\n        self.as_path() == other.as_path()\n    }\n}\n\nimpl<A: Allocator> Eq for PathBuf<A> {}\n\nimpl<A: Allocator> Display for PathBuf<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.s.as_str(), f)\n    }\n}\n\nimpl<A: Allocator> Debug for PathBuf<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.s.as_str(), f)\n");
    buf_str(out, c"    }\n}\n// ---- end mod std::path ----\n}\n// ---- mod std::random ----\npub mod random {\n// std::random (0.28.0): a pseudo-random generator, MVS's (0.20), vole's\n// own: Rust's std has none (the rand crates' names are kept).\n//\n// xoshiro256++ (Blackman and Vigna), 32 bytes of state, with rand 0.9's\n// names. Seeding from a number is pure and the same on every target\n// (`Xoshiro256pp::seed_from_u64`: splitmix64, as rand_xoshiro seeds it, so\n// the outputs match that crate's); seeding from the system's entropy is io\n// (`from_entropy`). Ranges use Lemire's nearly divisionless method: no\n// bias, a division only in about 1 of 2^64/n draws.\n// mvs: std::random\n\nuse crate::num::wrapping::mul_hi;\n\n// UNSAFE: the OS's random bytes.\n// SAFETY: getentropy fills the len (at most 256) bytes at buf and returns\n// 0, or -1 with nothing promised of them; its one caller passes a slice's\n// pointer and a length within it and within 256.\nextern \"C\" {\n    #[link_name = \"getentropy\"]\n    #[effects(io)]\n    fn c_getentropy(buf: *mut u8, len: usize) -> i32;\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct Xoshiro256pp {\n    s0: u64,\n    s1: u64,\n    s2: u64,\n    s3: u64,\n}\n\n// One step of splitmix64 on state: the next output.\n#[effects()]\npub fn splitmix64_next(state: &mut u64) -> u64 {\n    *state = state.wrapping_add(0x9e3779b97f4a7c15);\n    let mut z = *state;\n    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n    z ^ (z >> 31)\n}\n\nimpl Xoshiro256pp {\n    // The generator seeded from n through splitmix64 (rand_xoshiro's\n    // seed_from_u64): pure, the same everywhere.\n    #[effects()]\n    pub fn seed_from_u64(n: u64) -> Xoshiro256pp {\n        let mut st = n;\n        let a = splitmix64_next(&mut st);\n        let b = splitmix64_next(&mut st);\n        let c = splitmix64_next(&mut st);\n        let d = splitmix64_next(&mut st);\n");
    buf_str(out, c"        Xoshiro256pp { s0: a, s1: b, s2: c, s3: d }\n    }\n\n    // The generator with this state (not all zero: an all-zero state is\n    // replaced by seed_from_u64(0)'s, as rand_xoshiro does).\n    #[effects()]\n    pub fn from_state(s: [u64; 4]) -> Xoshiro256pp {\n        if s[0] == 0 && s[1] == 0 && s[2] == 0 && s[3] == 0 {\n            return Xoshiro256pp::seed_from_u64(0);\n        }\n        Xoshiro256pp { s0: s[0], s1: s[1], s2: s[2], s3: s[3] }\n    }\n\n    // Its state, for from_state.\n    #[effects()]\n    pub fn state(&self) -> [u64; 4] {\n        [self.s0, self.s1, self.s2, self.s3]\n    }\n\n    // The generator seeded from the system's entropy (getentropy); panics\n    // when the system has none to give.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn from_entropy() -> Xoshiro256pp {\n        let mut b: [u8; 32] = [0; 32];\n        let mut s: [u64; 4] = [0, 0, 0, 0];\n        if !fill_bytes_os(&mut b) {\n            crate::panic::panic(\"from_entropy: the system gave no entropy\");\n        }\n        for i in 0..32 {\n            s[i / 8] |= (b[i] as u64) << ((i % 8) * 8) as u64;\n        }\n        Xoshiro256pp::from_state(s)\n    }\n\n    // The next 64 random bits.\n    #[inline]\n    #[effects()]\n    pub fn next_u64(&mut self) -> u64 {\n        let s0 = self.s0;\n        let s3 = self.s3;\n        let sum = s0.wrapping_add(s3);\n        let result = ((sum << 23) | (sum >> 41)).wrapping_add(s0);\n        let t = self.s1 << 17;\n        let s2 = self.s2 ^ s0;\n        let s3b = s3 ^ self.s1;\n        let s1 = self.s1 ^ s2;\n        let s0b = s0 ^ s3b;\n        self.s0 = s0b;\n        self.s1 = s1;\n        self.s2 = s2 ^ t;\n        self.s3 = (s3b << 45) | (s3b >> 19);\n        result\n    }\n\n    // The next 32 random bits (the high half of next_u64, as rand_xoshiro).\n    #[effects()]\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n");
    buf_str(out, c"    // A uniform u64 in [lo, hi); panics when the range is empty.\n    #[effects(panic)]\n    pub fn random_range_u64(&mut self, lo: u64, hi: u64) -> u64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64(hi - lo)\n    }\n\n    // A uniform i64 in [lo, hi); panics when the range is empty.\n    #[effects(panic)]\n    pub fn random_range_i64(&mut self, lo: i64, hi: i64) -> i64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        let n = (hi as u64).wrapping_sub(lo as u64);\n        (lo as u64).wrapping_add(self.below_u64(n)) as i64\n    }\n\n    // A uniform usize in [lo, hi), for indices; panics when the range is\n    // empty.\n    #[effects(panic)]\n    pub fn random_range_usize(&mut self, lo: usize, hi: usize) -> usize {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64((hi - lo) as u64) as usize\n    }\n\n    // A uniform u64 in [0, n), n > 0: Lemire's method. A draw is rejected\n    // with probability under n / 2^64; after 128 rejections in a row (less\n    // likely than 2^-128) the last one is taken.\n    #[inline]\n    #[effects()]\n    pub fn below_u64(&mut self, n: u64) -> u64 {\n        let mut x = self.next_u64();\n        let mut lo = x.wrapping_mul(n);\n        if lo < n {\n            let t = n.wrapping_neg() % n;\n            for _ in 0..128 {\n                if lo >= t {\n                    break;\n                }\n                x = self.next_u64();\n                lo = x.wrapping_mul(n);\n            }\n        }\n        mul_hi(x, n)\n    }\n\n    // A uniform f64 in [0, 1): 53 random bits.\n    #[effects()]\n    pub fn unit_f64(&mut self) -> f64 {\n        (self.next_u64() >> 11) as f64 * 0.00000000000000011102230246251565\n    }\n\n    // true with probability p (0 <= p <= 1; panics otherwise).\n    #[effects(panic)]\n");
    buf_str(out, c"    pub fn random_bool(&mut self, p: f64) -> bool {\n        if !(p >= 0.0 && p <= 1.0) {\n            crate::panic::panic(\"random_bool: p is not in [0, 1]\");\n        }\n        if p == 1.0 {\n            return true;\n        }\n        // (p * 2^64 < 2^64)\n        let cut = (p * 18446744073709551616.0) as u64;\n        self.next_u64() < cut\n    }\n\n    // Fills buf with random bytes: each next_u64's bytes, least\n    // significant first.\n    // std: changed: buf a &mut [u8]\n    #[effects(panic, diverge)]\n    pub fn fill_bytes(&mut self, buf: &mut [u8]) {\n        let mut i: usize = 0;\n        while i < buf.len() {\n            let mut x = self.next_u64();\n            let mut k = 0;\n            while k < 8 && i < buf.len() {\n                buf[i] = x as u8;\n                x >>= 8;\n                i += 1;\n                k += 1;\n            }\n        }\n    }\n\n    // Moves the generator 2^128 steps ahead (xoshiro's jump): for 2^128\n    // non-overlapping sequences.\n    #[effects()]\n    pub fn jump(&mut self) {\n        let jump: [u64; 4] = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa,\n            0x39abdc4529b1661c];\n        let mut a: u64 = 0;\n        let mut b: u64 = 0;\n        let mut c: u64 = 0;\n        let mut d: u64 = 0;\n        for i in 0..4 {\n            for bit in 0..64 {\n                if (jump[i] & (1u64 << bit as u64)) != 0 {\n                    a ^= self.s0;\n                    b ^= self.s1;\n                    c ^= self.s2;\n                    d ^= self.s3;\n                }\n                self.next_u64();\n            }\n        }\n        self.s0 = a;\n        self.s1 = b;\n        self.s2 = c;\n        self.s3 = d;\n    }\n}\n\n// Shuffles s uniformly (Fisher-Yates, from the end, as rand's shuffle).\n// std: changed: s a &mut [T], rng a &mut Xoshiro256pp\n#[effects(diverge, T)]\npub fn shuffle<T>(s: &mut [T], rng: &mut Xoshiro256pp) {\n    let n = s.len();\n    let mut i = n;\n");
    buf_str(out, c"    while i > 1 {\n        i -= 1;\n        let j = rng.below_u64((i + 1) as u64) as usize;\n        s.swap(i, j);\n    }\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 bytes a\n// call); false when the system fails. Rust's getrandom.\n// std: changed: buf a &mut [u8]\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn fill_bytes_os(buf: &mut [u8]) -> bool {\n    let mut at: usize = 0;\n    while at < buf.len() {\n        let n = if buf.len() - at < 256 { buf.len() - at } else { 256 };\n        let rest = &mut buf[at..at + n];\n        // UNSAFE: the OS writes through a raw pointer.\n        // SAFETY: rest is a live &mut [u8] of n <= 256 bytes, borrowed for\n        // the call; getentropy writes at most n bytes there.\n        if unsafe { c_getentropy(rest.as_mut_ptr(), n) } != 0 {\n            return false;\n        }\n        at += n;\n    }\n    true\n}\n// ---- end mod std::random ----\n}\n// ---- mod std::sys ----\npub mod sys {\n// std::sys (0.20; std 0.28.0): the OS layer, thin bindings of the C\n// library, MVS's std::sys in the rust edition. vole's own: Rust's std::sys\n// is private, and this is the libc crate's level, with the `sys_` names\n// and `Result<T, i32>` errnos MVS's had. std::fs, std::process and\n// std::env are Rust's API over the OS; this is for what they do not\n// cover (terminals, pseudo-terminals, poll, descriptors, signals).\n// mvs: std::sys\n\nuse crate::convert::AsRef;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// The target's numbers (std/rt/sys_macos.vl, sys_linux.vl, which the\n// compiler puts in std::__sys).\npub const SYS_CLOCK_MONOTONIC: i32 = crate::__sys::CLOCK_MONOTONIC;\npub const SYS_EAGAIN: i32 = crate::__sys::EAGAIN;\npub const SYS_ELOOP: i32 = crate::__sys::ELOOP;\npub const SYS_ENAMETOOLONG: i32 = crate::__sys::ENAMETOOLONG;\npub const SYS_ENOSYS: i32 = crate::__sys::ENOSYS;\npub const SYS_ENOTEMPTY: i32 = crate::__sys::ENOTEMPTY;\n");
    buf_str(out, c"pub const SYS_ENOTSUP: i32 = crate::__sys::ENOTSUP;\npub const SYS_ETIMEDOUT: i32 = crate::__sys::ETIMEDOUT;\npub const SYS_O_APPEND: i32 = crate::__sys::O_APPEND;\npub const SYS_O_CLOEXEC: i32 = crate::__sys::O_CLOEXEC;\npub const SYS_O_CREAT: i32 = crate::__sys::O_CREAT;\npub const SYS_O_DIRECTORY: i32 = crate::__sys::O_DIRECTORY;\npub const SYS_O_EXCL: i32 = crate::__sys::O_EXCL;\npub const SYS_O_NOCTTY: i32 = crate::__sys::O_NOCTTY;\npub const SYS_O_NONBLOCK: i32 = crate::__sys::O_NONBLOCK;\npub const SYS_O_TRUNC: i32 = crate::__sys::O_TRUNC;\npub const SYS_SIGCHLD: i32 = crate::__sys::SIGCHLD;\npub const SYS_TIOCGWINSZ: u64 = crate::__sys::TIOCGWINSZ;\npub const SYS_TIOCSCTTY: u64 = crate::__sys::TIOCSCTTY;\npub const SYS_TIOCSWINSZ: u64 = crate::__sys::TIOCSWINSZ;\npub const TARGET_OS: i64 = crate::__sys::TARGET_OS;\npub const SYS_PATH_MAX: i64 = crate::__sys::PATH_MAX as i64;\n\n// ---- Sys: errors (0.20) ----\n\n// The OS layer (0.20, docs/design/collections-text-io.md §2.6.1, task A7):\n// thin bindings of the C library, the same on macOS and Linux; what differs\n// between them (flag and errno values, errno's address) is in the target's\n// std::__sys (std/rt/sys_macos.vl, sys_linux.vl), and a struct whose layout differs\n// is declared once per system (`StatMacos`, `StatLinux`) and chosen by\n// `TARGET_OS`, a constant. Every call's result is a `Result<T, i32>`: the\n// value, or the errno it failed with (`sys_errno_kind` names it). Nothing\n// here retries on EINTR or allocates; paths reach C through a NUL-ended copy\n// in a stack buffer (`sys_cpath`): a path with a NUL in it, or longer than\n// the system's PATH_MAX, fails with EINVAL or ENAMETOOLONG before any call.\n// Every descriptor std opens (`sys_open`, `sys_pipe`, `sys_openpty`) is\n// close-on-exec, so that a spawned program gets only what it is given.\n// Unsafe code: each binding passes C a pointer and a length from a slice it\n");
    buf_str(out, c"// was given, or a pointer to a local or a borrowed struct of the size C\n// writes (the layouts are checked against the headers by tests/run/\n// sys_layout.vl); a slice made from a C string (`sys_cstr_view`) is valid\n// while that string is.\n\n// UNSAFE: C's strlen reads memory up to a NUL through a raw pointer.\n// SAFETY: its prototype is C's (string.h); sys_cstr_view, its one caller,\n// passes a non-null pointer its own caller promises is a NUL-ended string.\nextern \"C\" {\n    #[link_name = \"strlen\"]\n    #[effects()]\n    fn sys_c_strlen(s: *const u8) -> u64;\n}\n\npub const SYS_EPERM: i32 = 1;\npub const SYS_ENOENT: i32 = 2;\npub const SYS_ESRCH: i32 = 3;\npub const SYS_EINTR: i32 = 4;\npub const SYS_EIO: i32 = 5;\npub const SYS_EBADF: i32 = 9;\npub const SYS_ECHILD: i32 = 10;\npub const SYS_ENOMEM: i32 = 12;\npub const SYS_EACCES: i32 = 13;\npub const SYS_EEXIST: i32 = 17;\npub const SYS_EXDEV: i32 = 18;\npub const SYS_ENOTDIR: i32 = 20;\npub const SYS_EISDIR: i32 = 21;\npub const SYS_EINVAL: i32 = 22;\npub const SYS_ENOSPC: i32 = 28;\npub const SYS_EROFS: i32 = 30;\npub const SYS_EPIPE: i32 = 32;\n\n// The kinds of io::Error (§2.6.2) an errno falls into (0.20's\n// io::ErrorKind takes these variants).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum SysErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\n// The errno of the last C call that failed (C's `errno`).\n#[effects(static, unsafe)]\npub fn sys_errno() -> i32 {\n    // UNSAFE: errno is C's thread-local int, reached only through the C\n    // library's pointer to it.\n    // SAFETY: sys_errno_location (__error, __errno_location) returns this\n    // thread's errno, an aligned int valid for the thread's life.\n");
    buf_str(out, c"    unsafe { *crate::__sys::errno_location() }\n}\n\n// Sets errno (to 0 before a call whose only failure report is errno).\n#[effects(static, unsafe)]\npub fn sys_set_errno(e: i32) {\n    // UNSAFE: as sys_errno.\n    // SAFETY: as sys_errno: this thread's errno, which only it writes.\n    unsafe {\n        *crate::__sys::errno_location() = e;\n    }\n}\n\n// The kind of error errno e is, as Rust's std decodes it.\n#[effects()]\npub fn sys_errno_kind(e: i32) -> SysErrorKind {\n    if e == SYS_ENOENT {\n        SysErrorKind::NotFound\n    } else if e == SYS_EPERM || e == SYS_EACCES {\n        SysErrorKind::PermissionDenied\n    } else if e == SYS_EEXIST {\n        SysErrorKind::AlreadyExists\n    } else if e == SYS_EAGAIN {\n        SysErrorKind::WouldBlock\n    } else if e == SYS_EINVAL || e == SYS_ENAMETOOLONG {\n        SysErrorKind::InvalidInput\n    } else if e == SYS_ETIMEDOUT {\n        SysErrorKind::TimedOut\n    } else if e == SYS_EINTR {\n        SysErrorKind::Interrupted\n    } else if e == SYS_EPIPE {\n        SysErrorKind::BrokenPipe\n    } else if e == SYS_ENOTDIR {\n        SysErrorKind::NotADirectory\n    } else if e == SYS_EISDIR {\n        SysErrorKind::IsADirectory\n    } else if e == SYS_ENOTEMPTY {\n        SysErrorKind::DirectoryNotEmpty\n    } else if e == SYS_ENOSYS || e == SYS_ENOTSUP {\n        SysErrorKind::Unsupported\n    } else if e == SYS_ENOMEM {\n        SysErrorKind::OutOfMemory\n    } else {\n        SysErrorKind::Other\n    }\n}\n\n// C's message for errno e (`strerror`) copied into out, cut to its length:\n// the bytes written.\n#[effects(panic, diverge, unsafe)]\npub fn sys_strerror_into(e: i32, out: &mut [u8]) -> i64 {\n    // (0.25.4) strerror_r, not strerror: strerror may keep the message in\n    // one buffer for every thread.\n    let mut buf = [0u8; 256];\n    // UNSAFE: C's strerror_r writes the message through a raw pointer.\n    // SAFETY: buf is a local of 256 bytes and strerror_r is given 255, so\n");
    buf_str(out, c"    // the message and its NUL stay in buf and buf[255] stays 0 (a message\n    // cut short ends with a NUL too; an unknown errno gets C's \"Unknown\n    // error\" text).\n    let _ = unsafe { crate::__sys::strerror_r(e, buf.as_mut_ptr(), 255) };\n    let mut n: i64 = 0;\n    while n < out.len() as i64 && buf[n as usize] != 0 {\n        out[n as usize] = buf[n as usize];\n        n += 1;\n    }\n    n\n}\n\n// The bytes of the NUL-ended C string at p, without the NUL; empty for a\n// null p. The caller promises that p is null or a NUL-ended string, valid\n// while the slice is used.\n#[effects(unsafe)]\n// UNSAFE: makes a slice from a raw C pointer, whose extent only its NUL\n// tells.\n// SAFETY: (the caller's obligation, above) p is null, or a NUL-ended\n// string that outlives the slice; strlen stops at that NUL, so the slice\n// covers readable bytes only.\npub unsafe fn sys_cstr_view<'a>(p: *const u8) -> &'a [u8] {\n    if p.is_null() {\n        return &EMPTY;\n    }\n    crate::slice::from_raw_parts(p, sys_c_strlen(p) as usize)\n}\n\nstatic EMPTY: [u8; 0] = [];\n\n// The result of a C call returning -1 on failure, as a Result.\nfn sys_check(r: i64) -> Result<i64, i32> {\n    if r == -1 {\n        Err(sys_errno())\n    } else {\n        Ok(r)\n    }\n}\n\nfn sys_check_unit(r: i32) -> Result<(), i32> {\n    if r == -1 {\n        Err(sys_errno())\n    } else {\n        Ok(())\n    }\n}\n\n// ---- Sys: paths (0.20) ----\n\n// A path for C: the bytes and a NUL, in a buffer on the caller's stack.\n#[derive(Clone, Copy)] pub struct SysPath {\n    buf: [u8; 4096],\n}\n\n// A SysPath holding path and its NUL: ENAMETOOLONG when path does not fit\n// the system's PATH_MAX (1024 bytes on macOS, 4096 on Linux, the NUL\n// included), EINVAL when it has a NUL in it. Pass `&p.buf as *u8` of the\n// local holding it (`p.buf.as_ptr()`: a method taking self by value would see a copy).\n#[effects(panic)]\npub fn sys_cpath<P: AsRef<[u8]>>(path: P) -> Result<SysPath, i32> {\n");
    buf_str(out, c"    let path = path.as_ref();\n    if path.len() as i64 >= SYS_PATH_MAX {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    let mut p = SysPath { buf: [0u8; 4096] };\n    for i in 0..path.len() as i64 {\n        let b = path[i as usize];\n        if b == 0 {\n            return Err(SYS_EINVAL);\n        }\n        p.buf[i as usize] = b;\n    }\n    Ok(p)\n}\n\nimpl SysPath {\n}\n\n// ---- Sys: files (0.20) ----\n\n// UNSAFE: the C library's file calls (POSIX), which take raw pointers.\n// SAFETY: each prototype is POSIX's (fcntl.h, unistd.h, sys/stat.h,\n// stdio.h's rename); open and fcntl are variadic in C and declared so; the\n// wrappers below pass pointers into buffers they own or borrow, with their\n// true lengths.\nextern \"C\" {\n    #[link_name = \"open\"]\n    #[effects(io)]\n    fn sys_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    #[effects(io)]\n    fn sys_c_close(fd: i32) -> i32;\n    #[link_name = \"read\"]\n    #[effects(io)]\n    fn sys_c_read(fd: i32, buf: *mut u8, n: u64) -> i64;\n    #[link_name = \"write\"]\n    #[effects(io)]\n    fn sys_c_write(fd: i32, buf: *const u8, n: u64) -> i64;\n    #[link_name = \"pread\"]\n    #[effects(io)]\n    fn sys_c_pread(fd: i32, buf: *mut u8, n: u64, off: i64) -> i64;\n    #[link_name = \"pwrite\"]\n    #[effects(io)]\n    fn sys_c_pwrite(fd: i32, buf: *const u8, n: u64, off: i64) -> i64;\n    #[link_name = \"lseek\"]\n    #[effects(io)]\n    fn sys_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn sys_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    #[effects(io)]\n    fn sys_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fstat\"]\n    #[effects(io)]\n    fn sys_c_fstat(fd: i32, st: *mut u8) -> i32;\n    #[link_name = \"stat\"]\n    #[effects(io)]\n    fn sys_c_stat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"lstat\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn sys_c_lstat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"mkdir\"]\n    #[effects(io)]\n    fn sys_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    #[effects(io)]\n    fn sys_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    #[effects(io)]\n    fn sys_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    #[effects(io)]\n    fn sys_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"dup\"]\n    #[effects(io)]\n    fn sys_c_dup(fd: i32) -> i32;\n    #[link_name = \"dup2\"]\n    #[effects(io)]\n    fn sys_c_dup2(fd: i32, to: i32) -> i32;\n    #[link_name = \"pipe\"]\n    #[effects(io)]\n    fn sys_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    #[effects(io)]\n    fn sys_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"isatty\"]\n    #[effects(io)]\n    fn sys_c_isatty(fd: i32) -> i32;\n}\n\npub const SYS_O_RDONLY: i32 = 0;\npub const SYS_O_WRONLY: i32 = 1;\npub const SYS_O_RDWR: i32 = 2;\npub const SYS_SEEK_SET: i32 = 0;\npub const SYS_SEEK_CUR: i32 = 1;\npub const SYS_SEEK_END: i32 = 2;\nconst SYS_F_GETFD: i32 = 1;\nconst SYS_F_SETFD: i32 = 2;\nconst SYS_F_GETFL: i32 = 3;\nconst SYS_F_SETFL: i32 = 4;\nconst SYS_FD_CLOEXEC: i32 = 1;\n\n// Opens path with flags (SYS_O_RDONLY, ..., | SYS_O_CREAT, ...) and, when it\n// creates the file, the permission bits mode (0x1a4: 0644): the descriptor,\n// close-on-exec (SYS_O_CLOEXEC is added).\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_open<P: AsRef<[u8]>>(path: P, flags: i32, mode: i32) -> Result<i32, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's open takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call;\n    // open's third argument is variadic, an int.\n    let r = unsafe { sys_c_open(p.buf.as_ptr(), flags | SYS_O_CLOEXEC, mode) };\n    Ok(sys_check(r as i64)? as i32)\n}\n\n");
    buf_str(out, c"#[effects(io, static, unsafe)]\npub fn sys_close(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (close).\n    // SAFETY: close takes an int and touches no memory of ours (a bad\n    // descriptor is EBADF).\n    sys_check_unit(unsafe { sys_c_close(fd) })\n}\n\n// Reads up to buf.len() bytes into buf: how many (0 at the end).\n#[effects(io, static, unsafe)]\npub fn sys_read(fd: i32, buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's read writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: read writes at most buf.len()\n    // bytes at buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_read(fd, buf.as_mut_ptr(), buf.len() as u64) })\n}\n\n// Writes some of buf: how many bytes.\n#[effects(io, static, unsafe)]\npub fn sys_write<B: AsRef<[u8]>>(fd: i32, buf: B) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: C's write reads through a raw pointer.\n    // SAFETY: buf is a borrowed slice: write reads at most buf.len() bytes at\n    // buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_write(fd, buf.as_ptr(), buf.len() as u64) })\n}\n\n// Reads into buf from offset off, not moving the file's position.\n#[effects(io, static, unsafe)]\npub fn sys_pread(fd: i32, buf: &mut [u8], off: i64) -> Result<i64, i32> {\n    // UNSAFE: as sys_read.\n    // SAFETY: as sys_read: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pread(fd, buf.as_mut_ptr(), buf.len() as u64, off) })\n}\n\n// Writes buf at offset off, not moving the file's position.\n#[effects(io, static, unsafe)]\npub fn sys_pwrite<B: AsRef<[u8]>>(fd: i32, buf: B, off: i64) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: as sys_write.\n    // SAFETY: as sys_write: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pwrite(fd, buf.as_ptr(), buf.len() as u64, off) })\n}\n\n// Moves the position to off from SYS_SEEK_SET, _CUR or _END: the new one.\n#[effects(io, static, unsafe)]\n");
    buf_str(out, c"pub fn sys_lseek(fd: i32, off: i64, whence: i32) -> Result<i64, i32> {\n    // UNSAFE: a C library call (lseek).\n    // SAFETY: lseek takes integers only and touches no memory of ours.\n    sys_check(unsafe { sys_c_lseek(fd, off, whence) })\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_ftruncate(fd: i32, len: i64) -> Result<(), i32> {\n    // UNSAFE: a C library call (ftruncate).\n    // SAFETY: ftruncate takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_ftruncate(fd, len) })\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_fsync(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (fsync).\n    // SAFETY: fsync takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_fsync(fd) })\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_mkdir<P: AsRef<[u8]>>(path: P, mode: i32) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's mkdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_mkdir(p.buf.as_ptr(), mode as u32) })\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_rmdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's rmdir takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_rmdir(p.buf.as_ptr()) })\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_unlink<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's unlink takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_unlink(p.buf.as_ptr()) })\n}\n\n#[effects(io, static, panic, unsafe, P, Q)]\npub fn sys_rename<P: AsRef<[u8]>, Q: AsRef<[u8]>>(from: P, to: Q) -> Result<(), i32> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n");
    buf_str(out, c"    let a = sys_cpath(from)?;\n    let b = sys_cpath(to)?;\n    // UNSAFE: C's rename takes the paths as raw pointers.\n    // SAFETY: a and b hold NUL-ended paths (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_rename(a.buf.as_ptr(), b.buf.as_ptr()) })\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_dup(fd: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup).\n    // SAFETY: dup takes an int and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup(fd) } as i64)? as i32)\n}\n\n// Makes `to` a copy of fd (closing what `to` was); `to` is not\n// close-on-exec.\n#[effects(io, static, unsafe)]\npub fn sys_dup2(fd: i32, to: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup2).\n    // SAFETY: dup2 takes integers only and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup2(fd, to) } as i64)? as i32)\n}\n\n// A pipe: (read end, write end), both close-on-exec.\n#[effects(io, static, unsafe)]\npub fn sys_pipe() -> Result<(i32, i32), i32> {\n    let mut fds: [i32; 2] = [0, 0];\n    // UNSAFE: C's pipe writes through a raw pointer.\n    // SAFETY: fds is a local [i32; 2]: pipe writes two ints there.\n    sys_check_unit(unsafe { sys_c_pipe(fds.as_mut_ptr() as *mut i32) })?;\n    sys_set_cloexec(fds[0], true)?;\n    sys_set_cloexec(fds[1], true)?;\n    Ok((fds[0], fds[1]))\n}\n\n// Sets or clears O_NONBLOCK on fd.\n#[effects(io, static, unsafe)]\npub fn sys_set_nonblocking(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFL takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFL) } as i64)? as i32;\n    let want = if on { fl | SYS_O_NONBLOCK } else { fl & !SYS_O_NONBLOCK };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFL takes an int and touches no memory of ours.\n");
    buf_str(out, c"        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFL, want) })?;\n    }\n    Ok(())\n}\n\n// Sets or clears FD_CLOEXEC on fd.\n#[effects(io, static, unsafe)]\npub fn sys_set_cloexec(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFD takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFD) } as i64)? as i32;\n    let want = if on { fl | SYS_FD_CLOEXEC } else { fl & !SYS_FD_CLOEXEC };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFD takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFD, want) })?;\n    }\n    Ok(())\n}\n\n// Whether fd is a terminal.\n#[effects(io, unsafe)]\npub fn sys_isatty(fd: i32) -> bool {\n    // UNSAFE: a C library call (isatty).\n    // SAFETY: isatty takes an int and touches no memory of ours.\n    unsafe { sys_c_isatty(fd) == 1 }\n}\n\n// ---- Sys: file status (0.20) ----\n\n// What stat tells of a file, the same on every system.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct FileStat {\n    dev: u64,\n    ino: u64,\n    mode: u32,\n    nlink: u64,\n    uid: u32,\n    gid: u32,\n    rdev: u64,\n    pub size: i64,\n    blocks: i64,\n    blksize: i64,\n    atime_sec: i64,\n    atime_nsec: i64,\n    pub mtime_sec: i64,\n    pub mtime_nsec: i64,\n    ctime_sec: i64,\n    ctime_nsec: i64,\n}\n\npub const SYS_S_IFMT: u32 = 0xf000;\npub const SYS_S_IFDIR: u32 = 0x4000;\npub const SYS_S_IFREG: u32 = 0x8000;\npub const SYS_S_IFLNK: u32 = 0xa000;\n\nimpl FileStat {\n    #[effects()]\n    pub fn is_dir(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFLNK\n    }\n\n");
    buf_str(out, c"    // The permission bits (the low 12 bits of mode).\n    #[effects()]\n    pub fn permissions(self) -> u32 {\n        self.mode & 0xfff\n    }\n}\n\n// struct stat on macOS (arm64, 64-bit inodes): 144 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatMacos {\n    pub st_dev: i32,\n    pub st_mode: u16,\n    pub st_nlink: u16,\n    pub st_ino: u64,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: i32,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_birthtime: i64,\n    st_birthtime_nsec: i64,\n    pub st_size: i64,\n    pub st_blocks: i64,\n    pub st_blksize: i32,\n    st_flags: u32,\n    st_gen: u32,\n    st_lspare: i32,\n    st_qspare: [i64; 2],\n}\n\n// struct stat on Linux (aarch64, glibc): 128 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatLinux {\n    pub st_dev: u64,\n    pub st_ino: u64,\n    pub st_mode: u32,\n    pub st_nlink: u32,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: u64,\n    st_pad1: u64,\n    pub st_size: i64,\n    pub st_blksize: i32,\n    st_pad2: i32,\n    pub st_blocks: i64,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_unused: [i32; 2],\n}\n\n// Room for either system's struct stat.\n#[derive(Clone, Copy)] struct SysStatBuf {\n    words: [u64; 20],\n}\n\n// The FileStat in b, filled by a stat call of this system.\nfn sys_stat_decode(b: SysStatBuf) -> FileStat {\n    if TARGET_OS == 1 {\n        // UNSAFE: reads C's struct stat out of b's words, a reinterpretation.\n        // SAFETY: b holds the struct stat of Linux that stat wrote, 128 of\n        // its 160 bytes (the layout is checked against the headers by\n        // tests/run/sys_layout.vl); the words are 8-aligned, as StatLinux\n        // is; StatLinux is integers only, so any bits are a valid one.\n");
    buf_str(out, c"        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatLinux) };\n        FileStat {\n            dev: s.st_dev,\n            ino: s.st_ino,\n            mode: s.st_mode,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    } else {\n        // UNSAFE: as for Linux, above.\n        // SAFETY: as for Linux: macOS's struct stat, 144 of the 160 bytes,\n        // StatMacos integers only.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatMacos) };\n        FileStat {\n            dev: s.st_dev as u32 as u64,\n            ino: s.st_ino,\n            mode: s.st_mode as u32,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev as u32 as u64,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    }\n}\n\n#[effects(io, static, unsafe)]\npub fn sys_fstat(fd: i32) -> Result<FileStat, i32> {\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's fstat writes a struct stat through a raw pointer.\n    // SAFETY: b.words is a local of 160 bytes, more than either system's\n    // struct stat (144 on macOS, 128 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_fstat(fd, b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n");
    buf_str(out, c"// The status of the file at path, following symbolic links.\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_stat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat takes the path and writes a struct stat, through\n    // raw pointers.\n    // SAFETY: p holds a NUL-ended path (sys_cpath); b as in sys_fstat.\n    sys_check_unit(unsafe { sys_c_stat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, of a symbolic link itself.\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_lstat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: as sys_stat (lstat).\n    // SAFETY: as sys_stat.\n    sys_check_unit(unsafe { sys_c_lstat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// ---- Sys: directories (0.20) ----\n\n// UNSAFE: the C library's directory calls, which take and return raw\n// pointers.\n// SAFETY: each prototype is POSIX's (dirent.h, unistd.h); a DIR * is kept\n// opaque in SysDir, and getcwd is given a slice's pointer and length.\nextern \"C\" {\n    #[link_name = \"opendir\"]\n    #[effects(io)]\n    fn sys_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    #[effects(io)]\n    fn sys_c_readdir(dir: *mut u8) -> *mut u8;\n    #[link_name = \"closedir\"]\n    #[effects(io)]\n    fn sys_c_closedir(dir: *mut u8) -> i32;\n    #[link_name = \"getcwd\"]\n    #[effects(io)]\n    fn sys_c_getcwd(buf: *mut u8, n: u64) -> *mut u8;\n    #[link_name = \"chdir\"]\n    #[effects(io)]\n    fn sys_c_chdir(path: *const u8) -> i32;\n}\n\n// struct dirent on macOS: d_name at 21, d_type at 20.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentMacos {\n    pub d_ino: u64,\n");
    buf_str(out, c"    d_seekoff: u64,\n    d_reclen: u16,\n    d_namlen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 1024],\n}\n\n// struct dirent on Linux (glibc): d_name at 19, d_type at 18.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentLinux {\n    pub d_ino: u64,\n    d_off: i64,\n    d_reclen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 256],\n}\n\n// An open directory (C's DIR *); sys_closedir frees it, and (0.25.4) so\n// does dropping it: a SysDir moves, it is not copied (two copies could\n// close one DIR twice, or read one closed).\npub struct SysDir {\n    handle: *mut u8,\n}\n\nimpl Drop for SysDir {\n    fn drop(&mut self) {\n        if !self.handle.is_null() {\n            let _ = sys_closedir(self);\n        }\n    }\n}\n\n// An entry read by sys_readdir_into: its name's length (the name is in the\n// caller's buffer), its kind (SYS_DT_DIR, ...; SYS_DT_UNKNOWN when the file\n// system does not say) and its inode.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysDirEntry {\n    pub name_len: i64,\n    pub kind: u8,\n    ino: u64,\n}\n\npub const SYS_DT_UNKNOWN: u8 = 0;\npub const SYS_DT_FIFO: u8 = 1;\npub const SYS_DT_CHR: u8 = 2;\npub const SYS_DT_DIR: u8 = 4;\npub const SYS_DT_BLK: u8 = 6;\npub const SYS_DT_REG: u8 = 8;\npub const SYS_DT_LNK: u8 = 10;\npub const SYS_DT_SOCK: u8 = 12;\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_opendir<P: AsRef<[u8]>>(path: P) -> Result<SysDir, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's opendir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    let d = unsafe { sys_c_opendir(p.buf.as_ptr()) };\n    if d.is_null() {\n        return Err(sys_errno());\n    }\n    Ok(SysDir { handle: d })\n}\n\n// The next entry of dir, its name copied into name (`.` and `..` included,\n// in the order the file system gives them): None at the end.\n#[effects(io, static, panic, unsafe)]\n");
    buf_str(out, c"pub fn sys_readdir_into(dir: &mut SysDir, name: &mut [u8; 256]) -> Result<Option<SysDirEntry>,\n    i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    sys_set_errno(0);\n    // UNSAFE: C's readdir on the raw DIR *.\n    // SAFETY: handle is the DIR * opendir returned, non-null (checked)\n    // until sys_closedir clears it; a SysDir is never copied (its Drop), so\n    // no other value closes it under this one.\n    let e = unsafe { sys_c_readdir(dir.handle) };\n    if e.is_null() {\n        let err = sys_errno();\n        return if err == 0 { Ok(None) } else { Err(err) };\n    }\n    let mut kind = 0u8;\n    let mut ino = 0u64;\n    let mut nm: &[u8] = &[];\n    // UNSAFE: reads the struct dirent readdir returned, through its raw\n    // pointer, and views its name.\n    // SAFETY: e is non-null (checked): a struct dirent of this system (the\n    // layouts checked by tests/run/sys_layout.vl), valid until the next\n    // readdir of this DIR; d_name is NUL-ended within it, and nm is copied\n    // into name before this returns.\n    unsafe {\n        if TARGET_OS == 1 {\n            let d = e as *const DirentLinux;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        } else {\n            let d = e as *const DirentMacos;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        }\n    }\n    if nm.len() as i64 > 256 {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    for i in 0..nm.len() as i64 {\n        name[i as usize] = nm[i as usize];\n    }\n    Ok(Some(SysDirEntry { name_len: nm.len() as i64, kind: kind, ino: ino }))\n}\n\n// Closes dir (once: its handle is cleared).\n#[effects(io, static, unsafe)]\npub fn sys_closedir(dir: &mut SysDir) -> Result<(), i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    // UNSAFE: C's closedir on the raw DIR *.\n");
    buf_str(out, c"    // SAFETY: the open DIR * (non-null, checked), closed once: handle is\n    // cleared right after.\n    let r = unsafe { sys_c_closedir(dir.handle) };\n    dir.handle = 0 as *mut u8;\n    sys_check_unit(r)\n}\n\n// The working directory's path, into buf: its length (ERANGE when buf is\n// too short).\n#[effects(io, static, panic, unsafe)]\npub fn sys_getcwd_into(buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's getcwd writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: getcwd writes at most buf.len()\n    // bytes, its NUL included.\n    let r = unsafe { sys_c_getcwd(buf.as_mut_ptr(), buf.len() as u64) };\n    if r.is_null() {\n        return Err(sys_errno());\n    }\n    let mut n: i64 = 0;\n    for i in 0..buf.len() as i64 {\n        if buf[i as usize] == 0 {\n            break;\n        }\n        n += 1;\n    }\n    Ok(n)\n}\n\n#[effects(io, static, panic, unsafe, P)]\npub fn sys_chdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's chdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_chdir(p.buf.as_ptr()) })\n}\n\n// ---- Sys: the environment (0.20) ----\n\n// UNSAFE: C's environment: the environ array, and getenv, setenv and\n// unsetenv, which take raw pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, unistd.h); environ is std::__sys's.\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    #[effects(global)]\n    fn sys_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    #[effects(global)]\n    fn sys_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    #[effects(global)]\n    fn sys_c_unsetenv(name: *const u8) -> i32;\n}\n\n// C's `environ`: the NUL-ended strings NAME=VALUE, then a null pointer.\n#[effects(static)]\npub fn sys_environ() -> *const *const u8 {\n");
    buf_str(out, c"    crate::__sys::environ()\n}\n\n// The number of the environment's variables.\n#[effects(static, unsafe)]\npub fn sys_env_count() -> i64 {\n    let e = sys_environ();\n    let mut n: i64 = 0;\n    for i in 0..2147483647 {\n        // UNSAFE: indexes C's environ through its raw pointer.\n        // SAFETY: environ is an array of pointers ended by a null one; the\n        // walk stops at that null (2^31 bounds it), so each e[i] read is in\n        // the array.\n        if unsafe { (*e.add(i as usize)).is_null() } {\n            break;\n        }\n        n += 1;\n    }\n    n\n}\n\n// The environment's i-th variable, `NAME=VALUE` (i < sys_env_count()): a\n// view valid until the environment changes (sys_setenv, sys_unsetenv).\n#[effects(static, panic, unsafe)]\npub fn sys_env_at(i: i64) -> &'static [u8] {\n    if i < 0 || i >= sys_env_count() {\n        panic(\"sys_env_at: index out of bounds\");\n    }\n    // UNSAFE: indexes environ and views a C string, through raw pointers.\n    // SAFETY: 0 <= i < sys_env_count() (checked): environ[i] is a NUL-ended\n    // string, valid until the environment changes, which only the unsafe\n    // sys_setenv and sys_unsetenv do.\n    unsafe { sys_cstr_view((*sys_environ().add(i as usize))) }\n}\n\n// The value of the variable name, a view valid until the environment\n// changes; None when it is not set (or name is not a valid C string).\n#[effects(static, panic, unsafe, P)]\npub fn sys_getenv<P: AsRef<[u8]>>(name: P) -> Option<&'static [u8]> {\n    let name = name.as_ref();\n    let p = match sys_cpath(name) {\n        Ok(p) => p,\n        Err(_) => return None,\n    };\n    // UNSAFE: C's getenv takes the name and returns the value, as raw\n    // pointers.\n    // SAFETY: p holds a NUL-ended name (sys_cpath).\n    let v = unsafe { sys_c_getenv(p.buf.as_ptr()) };\n    if v.is_null() {\n        return None;\n    }\n    // UNSAFE: a view of the C string getenv returned.\n");
    buf_str(out, c"    // SAFETY: v is non-null (checked): a NUL-ended string in the\n    // environment, valid until it changes (only the unsafe sys_setenv and\n    // sys_unsetenv change it).\n    Some(unsafe { sys_cstr_view(v) })\n}\n\n// Sets the variable name to value. Unsafe as in Rust 2024: views of the\n// environment (sys_env_at, sys_getenv) may dangle afterwards, and other\n// threads may be reading it.\n// UNSAFE: changes C's environment, which other code reads through raw\n// pointers.\n// SAFETY: (the caller's obligation) no view of the environment\n// (sys_env_at, sys_getenv) is used after the call, and no other thread\n// reads or changes the environment during it.\n#[effects(static, panic, unsafe, P, Q)]\npub unsafe fn sys_setenv<P: AsRef<[u8]>, Q: AsRef<[u8]>>(name: P, value: Q) -> Result<(), i32> {\n    let name = name.as_ref();\n    let value = value.as_ref();\n    let n = sys_cpath(name)?;\n    let v = sys_cpath(value)?;\n    sys_check_unit(sys_c_setenv(n.buf.as_ptr(), v.buf.as_ptr(), 1))\n}\n\n// Removes the variable name (unsafe as sys_setenv).\n// UNSAFE: as sys_setenv.\n// SAFETY: (the caller's obligation) as sys_setenv.\n#[effects(static, panic, unsafe, P)]\npub unsafe fn sys_unsetenv<P: AsRef<[u8]>>(name: P) -> Result<(), i32> {\n    let name = name.as_ref();\n    let n = sys_cpath(name)?;\n    sys_check_unit(sys_c_unsetenv(n.buf.as_ptr()))\n}\n\n// ---- Sys: processes (0.20) ----\n\n// UNSAFE: posix_spawn and the C library's process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (spawn.h, sys/wait.h, signal.h,\n// unistd.h); the file actions live in SysSpawnActions' words, larger than\n// either system's posix_spawn_file_actions_t.\nextern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    #[effects(io)]\n    fn sys_c_posix_spawnp(pid: *mut i32, file: *const u8, actions: *const u8, attr: *const u8,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n");
    buf_str(out, c"    #[effects(io)]\n    fn sys_c_actions_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    #[effects(io)]\n    fn sys_c_actions_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    #[effects(io)]\n    fn sys_c_actions_adddup2(a: *mut u8, fd: i32, to: i32) -> i32;\n    #[link_name = \"posix_spawn_file_actions_addclose\"]\n    #[effects(io)]\n    fn sys_c_actions_addclose(a: *mut u8, fd: i32) -> i32;\n    #[link_name = \"waitpid\"]\n    #[effects(io)]\n    fn sys_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"kill\"]\n    #[effects(io)]\n    fn sys_c_kill(pid: i32, sig: i32) -> i32;\n    #[link_name = \"getpid\"]\n    #[effects(io)]\n    fn sys_c_getpid() -> i32;\n    // (0.25.5) Spawn attributes and signal dispositions (std::process's\n    // Command::foreground).\n    #[link_name = \"posix_spawnattr_init\"]\n    #[effects(io)]\n    fn sys_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawnattr_destroy\"]\n    #[effects(io)]\n    fn sys_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawnattr_setflags\"]\n    #[effects(io)]\n    fn sys_c_attr_setflags(a: *mut u8, flags: i16) -> i32;\n    #[link_name = \"posix_spawnattr_setsigdefault\"]\n    #[effects(io)]\n    fn sys_c_attr_setsigdefault(a: *mut u8, set: *const u8) -> i32;\n    #[link_name = \"sigemptyset\"]\n    #[effects(io)]\n    fn sys_c_sigemptyset(set: *mut u8) -> i32;\n    #[link_name = \"sigaddset\"]\n    #[effects(io)]\n    fn sys_c_sigaddset(set: *mut u8, sig: i32) -> i32;\n    #[link_name = \"signal\"]\n    #[effects(io)]\n    fn sys_c_signal(sig: i32, handler: *const u8) -> *const u8;\n}\n\npub const SYS_SIGHUP: i32 = 1;\npub const SYS_SIGINT: i32 = 2;\npub const SYS_SIGQUIT: i32 = 3;\npub const SYS_SIGKILL: i32 = 9;\npub const SYS_SIGTERM: i32 = 15;\nconst SYS_WNOHANG: i32 = 1;\n\n// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes\n");
    buf_str(out, c"// on macOS, 80 on Linux). (0.25.4) Dropping it frees it, so it moves and\n// is never copied: two copies could destroy the actions twice.\npub struct SysSpawnActions {\n    words: [u64; 16],\n    live: bool,\n}\n\nimpl Drop for SysSpawnActions {\n    fn drop(&mut self) {\n        self.free();\n    }\n}\n\n// Empty file actions; sys_spawn_actions_free frees them.\n#[effects(io, unsafe)]\npub fn sys_spawn_actions() -> Result<SysSpawnActions, i32> {\n    let mut a = SysSpawnActions { words: [0u64; 16], live: false };\n    // UNSAFE: C initializes the file actions through a raw pointer.\n    // SAFETY: a.words is 128 bytes, more than either system's\n    // posix_spawn_file_actions_t (8 on macOS, 80 on Linux), 8-aligned; the\n    // actions hold no pointer into themselves, so moving them is fine.\n    let r = unsafe { sys_c_actions_init(a.words.as_mut_ptr() as *mut u8) };\n    if r != 0 {\n        return Err(r);\n    }\n    a.live = true;\n    Ok(a)\n}\n\nimpl SysSpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    #[effects(io, unsafe)]\n    pub fn dup2(&mut self, fd: i32, to: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: C adds to the file actions through a raw pointer.\n        // SAFETY: live: initialized by sys_spawn_actions and not destroyed\n        // (a SysSpawnActions is never copied, see its Drop).\n        let r = unsafe { sys_c_actions_adddup2(self.words.as_mut_ptr() as *mut u8, fd, to) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    // In the child: fd is closed.\n    #[effects(io, unsafe)]\n    pub fn close(&mut self, fd: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: as dup2.\n        // SAFETY: as dup2.\n        let r = unsafe { sys_c_actions_addclose(self.words.as_mut_ptr() as *mut u8, fd) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    #[effects(io, unsafe)]\n");
    buf_str(out, c"    pub fn free(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the file actions through a raw pointer.\n            // SAFETY: live (checked): destroyed once, live cleared right\n            // after.\n            unsafe { sys_c_actions_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n// Runs prog (a path, or a name looked up in PATH) with argv (C strings\n// ending with a null pointer; argv[0] is the program's name) and envp\n// (likewise; empty: this process's environment), after the file actions\n// (null: none): the child's pid. EINVAL when argv or a non-empty envp does\n// not end with a null pointer.\n// Unsafe: prog and every pointer before argv's and envp's null must be\n// NUL-ended strings.\n#[effects(io, static, panic, unsafe)]\n// UNSAFE: posix_spawnp reads the program's name, arguments and environment\n// through raw pointers.\n// SAFETY: (the caller's obligation) prog and every pointer before argv's\n// and envp's nulls are NUL-ended strings, and actions is null or points to\n// a SysSpawnActions; the nulls that end argv and envp are checked here.\npub unsafe fn sys_spawn(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions) -> Result<i32, i32> {\n    sys_spawn_attr(prog, argv, envp, actions, 0 as *const SysSpawnAttr)\n}\n\n// (0.25.5) sys_spawn with spawn attributes (null: none).\n#[effects(io, static, panic, unsafe)]\n// UNSAFE: as sys_spawn.\n// SAFETY: (the caller's obligation) as sys_spawn's, and attr is null or\n// points to a SysSpawnAttr.\npub unsafe fn sys_spawn_attr(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions, attr: *const SysSpawnAttr) -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() > 0 && !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n");
    buf_str(out, c"    let env = if envp.len() == 0 { sys_environ() } else { envp.as_ptr() };\n    let acts = if actions.is_null() || !(*actions).live {\n        0 as *const u8\n    } else {\n        (*actions).words.as_ptr() as *const u8\n    };\n    let at = if attr.is_null() || !(*attr).live {\n        0 as *const u8\n    } else {\n        (*attr).words.as_ptr() as *const u8\n    };\n    let mut pid = 0i32;\n    let r = sys_c_posix_spawnp(&mut pid, prog, acts, at, argv.as_ptr(), env);\n    if r != 0 {\n        return Err(r);\n    }\n    Ok(pid)\n}\n\n// (0.25.5) posix_spawnattr_t, opaque: room for either system's (8 bytes on\n// macOS, 336 on Linux). Dropping it frees it, so it moves and is never\n// copied, as SysSpawnActions.\npub struct SysSpawnAttr {\n    words: [u64; 48],\n    live: bool,\n}\n\nimpl Drop for SysSpawnAttr {\n    fn drop(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the attributes through a raw pointer.\n            // SAFETY: live (checked): initialized by sys_spawn_sigdefault,\n            // destroyed once, live cleared right after.\n            unsafe { sys_c_attr_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SYS_SPAWN_SETSIGDEF: i16 = 4;\n\n// (0.25.5) Spawn attributes under which the child starts with the default\n// action of each of sigs, whatever this process's are (a signal it\n// ignores, the child does not).\n#[effects(io, unsafe)]\npub fn sys_spawn_sigdefault(sigs: &[i32]) -> Result<SysSpawnAttr, i32> {\n    let mut a = SysSpawnAttr { words: [0u64; 48], live: false };\n    // sigset_t: 4 bytes on macOS, 128 on Linux\n    let mut set: [u64; 16] = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the signal set through raw\n    // pointers. SAFETY: a.words (384 bytes) and set (128) are larger than\n    // either system's posix_spawnattr_t and sigset_t, 8-aligned; the\n");
    buf_str(out, c"    // attributes hold no pointer into themselves, so moving them is fine.\n    unsafe {\n        let r = sys_c_attr_init(a.words.as_mut_ptr() as *mut u8);\n        if r != 0 {\n            return Err(r);\n        }\n        a.live = true;\n        sys_c_sigemptyset(set.as_mut_ptr() as *mut u8);\n        for &sig in sigs {\n            sys_c_sigaddset(set.as_mut_ptr() as *mut u8, sig);\n        }\n        let r2 = sys_c_attr_setsigdefault(a.words.as_mut_ptr() as *mut u8,\n            set.as_mut_ptr() as *mut u8);\n        if r2 != 0 {\n            return Err(r2);\n        }\n        let r3 = sys_c_attr_setflags(a.words.as_mut_ptr() as *mut u8, SYS_SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return Err(r3);\n        }\n    }\n    Ok(a)\n}\n\n// (0.25.5) A signal's disposition before sys_signal_ignore changed it: only\n// sys_signal_ignore makes one, so sys_signal_restore sets back what C gave.\n#[derive(Clone, Copy)]\npub struct SysSignalWas {\n    sig: i32,\n    handler: *const u8,\n}\n\n// This process ignores sig (SIG_IGN) from now on: what it did before.\n#[effects(io, unsafe)]\npub fn sys_signal_ignore(sig: i32) -> SysSignalWas {\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: SIG_IGN (1 on macOS and Linux) is a disposition, not code; sig\n    // is an int (an invalid one gives SIG_ERR, restored as nothing below).\n    let was = unsafe { sys_c_signal(sig, 1 as *mut u8) };\n    SysSignalWas { sig: sig, handler: was }\n}\n\n// The disposition sys_signal_ignore replaced, set back.\n#[effects(io, unsafe)]\npub fn sys_signal_restore(was: SysSignalWas) {\n    // (SIG_ERR, -1: signal failed, nothing was changed)\n    if was.handler as i64 == -1 {\n        return;\n    }\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: was.handler is what signal returned for was.sig (SysSignalWas\n    // is sealed: only sys_signal_ignore makes one): SIG_DFL, SIG_IGN, or a\n    // handler of this process