    buf_str(out, c"    char::from_digit(d, radix)\n}\n\n// Why a u32 is not a char.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct CharTryFromError(());\n\nimpl Display for CharTryFromError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"converted integer out of range for `char`\")\n    }\n}\n\n// The comparisons of chars: their scalar values' (char is no\n// `#[builtin_impls]` primitive: written, as Clone and Copy are).\nimpl PartialEq for char {\n    fn eq(&self, other: &char) -> bool {\n        (*self as u32) == (*other as u32)\n    }\n}\n\nimpl Eq for char {}\n\nimpl PartialOrd for char {\n    fn partial_cmp(&self, other: &char) -> Option<Ordering> {\n        Option::Some((*self as u32).cmp(&(*other as u32)))\n    }\n}\n\nimpl Ord for char {\n    fn cmp(&self, other: &char) -> Ordering {\n        (*self as u32).cmp(&(*other as u32))\n    }\n}\n\n// As its scalar value, a u32 (Rust's).\nimpl Hash for char {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_u32(*self as u32)\n    }\n}\n\n// '\\0'.\nimpl Default for char {\n    fn default() -> char {\n        '\\0'\n    }\n}\n\n// `{c}`: the char itself, padded as a str.\nimpl Display for char {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let mut b = [0u8; 4];\n        f.pad(self.encode_utf8(&mut b))\n    }\n}\n\n// `{c:?}`: the char quoted, with Rust's escapes for the quote, the\n// backslash and the control characters.\nimpl Debug for char {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"'\")?;\n        let c = *self;\n        if c == '\\'' {\n            f.write_str(\"\\\\'\")?;\n        } else if c == '\\\\' {\n            f.write_str(\"\\\\\\\\\")?;\n        } else if c == '\\n' {\n            f.write_str(\"\\\\n\")?;\n        } else if c == '\\r' {\n            f.write_str(\"\\\\r\")?;\n        } else if c == '\\t' {\n            f.write_str(\"\\\\t\")?;\n");
    buf_str(out, c"        } else if c == '\\0' {\n            f.write_str(\"\\\\0\")?;\n        } else if c.is_control() || is_zero_width(c as u32) || (c.is_whitespace() && c != ' ') {\n            // (a control, a combining mark, a format char or white space but\n            // ' ' as Rust's escape_debug shows it: a grapheme extender and\n            // the unprintable)\n            f.write_str(\"\\\\u{\")?;\n            crate::fmt::LowerHex::fmt(&(c as u32), f)?;\n            f.write_str(\"}\")?;\n        } else {\n            f.write_char(c)?;\n        }\n        f.write_str(\"'\")\n    }\n}\n\n// `char::try_from(i)`: from_u32, with an error for what is no char.\nimpl TryFrom<u32> for char {\n    type Error = CharTryFromError;\n\n    fn try_from(i: u32) -> Result<char, CharTryFromError> {\n        match char::from_u32(i) {\n            Option::Some(c) => Result::Ok(c),\n            Option::None => Result::Err(CharTryFromError(())),\n        }\n    }\n}\n\n// i as a char when it is below 0x10000 and no surrogate, else U+FFFD:\n// what a sequence of two or three bytes of UTF-8 decodes to (std::str).\n// One compare for what is below the surrogates (most text), a mask and\n// two for the rest, where from_u32's test of any u32 is three compares\n// with a wide constant each.\n#[inline]\npub(crate) fn from_u32_bmp_lossy(i: u32) -> char {\n    if i < 0xD800 || (i < 0x10000 && i & 0xF800 != 0xD800) {\n        from_u32_unchecked(i)\n    } else {\n        char::REPLACEMENT_CHARACTER\n    }\n}\n\n// i as a char, i a scalar value (Rust's char::from_u32_unchecked).\nfn from_u32_unchecked(i: u32) -> char {\n    // UNSAFE: a u32's bits read as a char (Rust's transmute).\n    // SAFETY: every caller passes a scalar value (from_u32 checks it; the\n    // case maps give one), and a char is laid out as a u32.\n    unsafe { *(&i as *const u32 as *const char) }\n}\n\n// A case table's mapping (1 to 3 code points, the rest 0) as chars and\n// their count.\n");
    buf_str(out, c"fn case_chars(m: [u32; 3]) -> ([char; 3], usize) {\n    let len: usize = if m[1] == 0 { 1 } else if m[2] == 0 { 2 } else { 3 };\n    ([from_u32_unchecked(m[0]), from_u32_unchecked(m[1]), from_u32_unchecked(m[2])], len)\n}\n\n// The combining marks and the format chars: no column of their own.\nfn is_zero_width(c: u32) -> bool {\n    (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5BD)\n        || (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F)\n        || (c >= 0x900 && c <= 0x902) || c == 0x93C || (c >= 0x941 && c <= 0x948) || c == 0x94D\n        || (c >= 0x1AB0 && c <= 0x1AFF) || (c >= 0x1DC0 && c <= 0x1DFF)\n        || (c >= 0x200B && c <= 0x200F) || (c >= 0x202A && c <= 0x202E)\n        || (c >= 0x2060 && c <= 0x2064) || (c >= 0x20D0 && c <= 0x20FF)\n        || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || c == 0xFEFF\n        || (c >= 0xE0000 && c <= 0xE0FFF)\n}\n\n// East Asian Wide and Fullwidth, and the emoji blocks.\nfn is_wide(c: u32) -> bool {\n    (c >= 0x1100 && c <= 0x115F) || (c >= 0x231A && c <= 0x231B) || (c >= 0x2E80 && c <= 0x303E)\n        || (c >= 0x3041 && c <= 0x33FF) || (c >= 0x3400 && c <= 0x4DBF)\n        || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xA000 && c <= 0xA4CF)\n        || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF)\n        || (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFF60)\n        || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F)\n        || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD)\n}\n// ---- end mod std::char ----\n}\n// ---- mod std::num ----\npub mod num {\n// std: new: Rust's integer methods' home (std::num).\n\n// The integers' inherent methods (front-rust.md F15.4): `x.wrapping_add(y)`,\n// `x.checked_mul(y)` (an Option), `x.overflowing_sub(y)` (the wrapped\n// value and whether it overflowed), `x.saturating_sub(y)`, the bit counts\n");
    buf_str(out, c"// and the rotations, for i8 .. usize, with no `use`. The compiler makes\n// `impl i8 { .. }` .. `impl usize { .. }` from its list (front/builtin_impls)\n// as this module's items, at the attribute below; this module's\n// arithmetic never checks overflow, whatever --overflow-checks says\n// (front/modules: std_wraps), so `self + rhs` in them is Rust's\n// wrapping_add. `/` and `%` by zero panic here too, as Rust's\n// wrapping_div does.\npub mod wrapping {\n    // The high 64 bits of the 128-bit product a * b (vole has no u128):\n    // four 32-bit products, none of which overflows. The overflowing_mul\n    // of the 64-bit integers reads it.\n    #[builtin_methods(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\n    #[effects()]\n    pub fn mul_hi(a: u64, b: u64) -> u64 {\n        let m: u64 = 0xffffffff;\n        let (a0, a1) = (a & m, a >> 32);\n        let (b0, b1) = (b & m, b >> 32);\n        let p00 = a0 * b0;\n        let p01 = a0 * b1;\n        let p10 = a1 * b0;\n        let p11 = a1 * b1;\n        let mid = (p00 >> 32) + (p01 & m) + (p10 & m);\n        p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n    }\n}\n\n// (0.28.0) A byte as an ASCII character: Rust's u8 methods, as char's.\nimpl u8 {\n    #[effects()]\n    pub fn is_ascii(&self) -> bool {\n        *self < 0x80\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphabetic(&self) -> bool {\n        self.is_ascii_uppercase() || self.is_ascii_lowercase()\n    }\n\n    #[effects()]\n    pub fn is_ascii_uppercase(&self) -> bool {\n        *self >= b'A' && *self <= b'Z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_lowercase(&self) -> bool {\n        *self >= b'a' && *self <= b'z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_digit(&self) -> bool {\n        *self >= b'0' && *self <= b'9'\n    }\n\n    #[effects()]\n    pub fn is_ascii_hexdigit(&self) -> bool {\n        self.is_ascii_digit() || (*self >= b'a' && *self <= b'f')\n            || (*self >= b'A' && *self <= b'F')\n    }\n\n");
    buf_str(out, c"    #[effects()]\n    pub fn is_ascii_alphanumeric(&self) -> bool {\n        self.is_ascii_alphabetic() || self.is_ascii_digit()\n    }\n\n    // A space, tab, line feed, form feed or carriage return (not the\n    // vertical tab: Rust's, WhatWG's).\n    #[effects()]\n    pub fn is_ascii_whitespace(&self) -> bool {\n        *self == b' ' || *self == b'\\t' || *self == b'\\n' || *self == b'\\r' || *self == 0x0C\n    }\n\n    #[effects()]\n    pub fn is_ascii_punctuation(&self) -> bool {\n        (*self >= b'!' && *self <= b'/') || (*self >= b':' && *self <= b'@')\n            || (*self >= b'[' && *self <= b'`') || (*self >= b'{' && *self <= b'~')\n    }\n\n    // A printable character but the space: `!` to `~`.\n    #[effects()]\n    pub fn is_ascii_graphic(&self) -> bool {\n        *self >= b'!' && *self <= b'~'\n    }\n\n    #[effects()]\n    pub fn is_ascii_control(&self) -> bool {\n        *self < 0x20 || *self == 0x7F\n    }\n\n    #[effects()]\n    pub fn to_ascii_uppercase(&self) -> u8 {\n        if self.is_ascii_lowercase() { *self - 32 } else { *self }\n    }\n\n    #[effects()]\n    pub fn to_ascii_lowercase(&self) -> u8 {\n        if self.is_ascii_uppercase() { *self + 32 } else { *self }\n    }\n\n    #[effects()]\n    pub fn eq_ignore_ascii_case(&self, other: &u8) -> bool {\n        self.to_ascii_lowercase() == other.to_ascii_lowercase()\n    }\n\n    #[effects()]\n    pub fn make_ascii_uppercase(&mut self) {\n        *self = self.to_ascii_uppercase();\n    }\n\n    #[effects()]\n    pub fn make_ascii_lowercase(&mut self) {\n        *self = self.to_ascii_lowercase();\n    }\n}\n\nimpl u64 {\n    // self * rhs + carry, in full: its low 64 bits and its high 64 bits\n    // (Rust's; the high half of a 64x64 product is `a.carrying_mul(b, 0).1`).\n    #[effects()]\n    pub fn carrying_mul(self, rhs: u64, carry: u64) -> (u64, u64) {\n        let lo = self.wrapping_mul(rhs);\n        let sum = lo.wrapping_add(carry);\n");
    buf_str(out, c"        let hi = crate::num::wrapping::mul_hi(self, rhs);\n        (sum, if sum < lo { hi.wrapping_add(1) } else { hi })\n    }\n}\n\n// The errors of parsing and converting numbers, at Rust's paths\n// (std::num::ParseIntError, IntErrorKind, ParseFloatError,\n// TryFromIntError): they are defined beside the code that makes them.\npub use crate::convert::TryFromIntError;\n// (Wrapping<T>: with the integers' conversions, std-intconv.py)\npub use crate::intconv::Wrapping;\npub use crate::str::{IntErrorKind, ParseFloatError, ParseIntError};\n// ---- end mod std::num ----\n}\n// ---- mod std::intconv ----\nmod intconv {\n// Generated by tools/std-intconv.py (do not edit): the integers' TryFrom\n// impls and from_str_radix, which Rust's std writes with macros.\n//\n// `T::try_from(x)` of an integer x: Ok when x is one of T's values, else\n// Err(TryFromIntError), as Rust's. A conversion that cannot fail (Rust has\n// `From` for it, and Infallible for its TryFrom's error) has the error\n// type TryFromIntError here too, and is always Ok: `{:?}` of a\n// Result<T, Infallible> does not compile yet (its Err arm is refused as\n// unreachable). usize and isize are 64 bits. One generic impl over a\n// private trait of the ten types does it.\n//\n// `T::from_str_radix(s, radix)`: s as a T in radix (2 to 36, else a panic):\n// an optional `+` (or `-`, for a signed type), then digits (`a`-`z` and\n// `A`-`Z` are 10 to 35), nothing else; the errors are `s.parse::<T>()`'s.\n\nuse crate::convert::{TryFrom, TryFromIntError};\nuse crate::result::Result;\nuse crate::str::{IntErrorKind, ParseIntError};\n\n// The value of s in radix, as its 64 bits (two's complement for a negative\n// one): at most `pos` when positive, and, for a signed type, at most `neg`\n// in magnitude when negative.\nfn parse_radix(s: &str, radix: u32, signed: bool, pos: u64, neg: u64) -> Result<u64,\n    ParseIntError> {\n    if radix < 2 || radix > 36 {\n");
    buf_str(out, c"        crate::panic::panic(\"from_str_radix: the radix must lie in the range `[2, 36]`\");\n    }\n    let b = s.as_bytes();\n    if b.len() == 0 {\n        return Result::Err(crate::str::int_error(IntErrorKind::Empty));\n    }\n    let mut i: usize = 0;\n    let mut negative = false;\n    if b[0] == b'+' {\n        i = 1;\n    } else if b[0] == b'-' && signed {\n        negative = true;\n        i = 1;\n    }\n    if i == b.len() {\n        return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));\n    }\n    let limit = if negative { neg } else { pos };\n    let r = radix as u64;\n    let mut acc: u64 = 0;\n    while i < b.len() {\n        let c = b[i];\n        let d: u64 = if c >= b'0' && c <= b'9' {\n            (c - b'0') as u64\n        } else if c >= b'a' && c <= b'z' {\n            (c - b'a') as u64 + 10\n        } else if c >= b'A' && c <= b'Z' {\n            (c - b'A') as u64 + 10\n        } else {\n            36\n        };\n        if d >= r {\n            return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));\n        }\n        // (acc * r + d <= limit, without overflow: d < r <= 36 <= limit)\n        if acc > (limit - d) / r {\n            return Result::Err(crate::str::int_error(if negative { IntErrorKind::NegOverflow }\n                else { IntErrorKind::PosOverflow }));\n        }\n        acc = acc * r + d;\n        i += 1;\n    }\n    Result::Ok(if negative { (!acc).wrapping_add(1) } else { acc })\n}\n\nimpl i8 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i8, ParseIntError> {\n        match parse_radix(src, radix, true, 127, 128) {\n            Result::Ok(v) => Result::Ok(v as i8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i16 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i16, ParseIntError> {\n        match parse_radix(src, radix, true, 32767, 32768) {\n");
    buf_str(out, c"            Result::Ok(v) => Result::Ok(v as i16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i32 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i32, ParseIntError> {\n        match parse_radix(src, radix, true, 2147483647, 2147483648) {\n            Result::Ok(v) => Result::Ok(v as i32),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i64 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i64, ParseIntError> {\n        match parse_radix(src, radix, true, 9223372036854775807, 9223372036854775808) {\n            Result::Ok(v) => Result::Ok(v as i64),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl isize {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<isize, ParseIntError> {\n        match parse_radix(src, radix, true, 9223372036854775807, 9223372036854775808) {\n            Result::Ok(v) => Result::Ok(v as isize),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u8 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u8, ParseIntError> {\n        match parse_radix(src, radix, false, 255, 0) {\n            Result::Ok(v) => Result::Ok(v as u8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u16 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u16, ParseIntError> {\n        match parse_radix(src, radix, false, 65535, 0) {\n            Result::Ok(v) => Result::Ok(v as u16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u32 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u32, ParseIntError> {\n        match parse_radix(src, radix, false, 4294967295, 0) {\n            Result::Ok(v) => Result::Ok(v as u32),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl u64 {\n");
    buf_str(out, c"    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<u64, ParseIntError> {\n        match parse_radix(src, radix, false, 18446744073709551615, 0) {\n            Result::Ok(v) => Result::Ok(v as u64),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl usize {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<usize, ParseIntError> {\n        match parse_radix(src, radix, false, 18446744073709551615, 0) {\n            Result::Ok(v) => Result::Ok(v as usize),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\n// What the one TryFrom impl below reads of an integer type: std's own.\n// (Two one-line methods a type: the lazy std keeps these impls in every\n// program. The type's range comes from its size and whether it is signed.)\npub trait __IntBits: Sized {\n    // The value as 64 bits, sign-extended, and whether the type is signed.\n    fn __int_bits(self) -> (u64, bool);\n    // The value of its width's low bits of v.\n    fn __int_from(v: u64) -> Self;\n}\n\nimpl __IntBits for i8 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i8 { v as i8 }\n}\n\nimpl __IntBits for i16 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i16 { v as i16 }\n}\n\nimpl __IntBits for i32 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i32 { v as i32 }\n}\n\nimpl __IntBits for i64 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i64 { v as i64 }\n}\n\nimpl __IntBits for isize {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> isize { v as isize }\n}\n\nimpl __IntBits for u8 {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> u8 { v as u8 }\n}\n\nimpl __IntBits for u16 {\n");
    buf_str(out, c"    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> u16 { v as u16 }\n}\n\nimpl __IntBits for u32 {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> u32 { v as u32 }\n}\n\nimpl __IntBits for u64 {\n    fn __int_bits(self) -> (u64, bool) { (self, false) }\n    fn __int_from(v: u64) -> u64 { v }\n}\n\nimpl __IntBits for usize {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> usize { v as usize }\n}\n\n// Every pair of integer types (one impl, not a hundred: the lazy std keeps\n// an impl of a trait for a primitive type in every program).\nimpl<S: __IntBits, T: __IntBits> TryFrom<S> for T {\n    type Error = TryFromIntError;\n\n    fn try_from(x: S) -> Result<T, TryFromIntError> {\n        let (v, negative_kind) = x.__int_bits();\n        // (T's range: is it signed? its -1 has the top bit of 64 set)\n        let (_, signed) = T::__int_from(0).__int_bits();\n        let width = 8 * crate::mem::size_of::<T>() as u64;\n        // (its largest value: width - 1 ones when signed, width ones when not)\n        let max: u64 = if signed { (1u64 << (width - 1)) - 1 }\n            else if width == 64 { 0xffffffffffffffff }\n            else { (1u64 << width) - 1 };\n        if negative_kind && (v as i64) < 0 {\n            // (its smallest: -(max + 1) when signed, 0 when not)\n            if !signed || (v as i64) < -(max as i64) - 1 {\n                return Result::Err(crate::convert::int_range_error(true));\n            }\n        } else if v > max {\n            return Result::Err(crate::convert::int_range_error(false));\n        }\n        Result::Ok(T::__int_from(v))\n    }\n}\n\n// std::num::Wrapping<T> (0.28.0), as Rust's: an integer T whose `+`, `-`,\n// `*`, `/`, `%`, unary `-` and shifts wrap at T's width instead of\n// panicking (a shift's count is taken modulo the width; `/` and `%` by zero\n");
    buf_str(out, c"// still panic); `!`, `&`, `|`, `^`; each with its assignment (`+=` takes a\n// Wrapping<T> or a T); Display, Debug and the radix formats are T's; Sum\n// and Product. The arithmetic is done on the value's 64 bits (__IntBits) and\n// cut to T's width: one generic impl an operator, kept only by a program\n// that names Wrapping. Not there: the impls for references (`&a + &b`), the\n// constants MIN, MAX and BITS, to_be, to_le, from_be, from_le. abs, signum,\n// is_positive and is_negative (Rust: signed T only) and is_power_of_two\n// (Rust: unsigned T only) are there for every T.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct Wrapping<T>(pub T);\n\n// T's width in bits, and the mask of its bits in 64.\n#[effects()]\nfn wrap_width<T: __IntBits>() -> (u64, u64) {\n    let width = 8 * crate::mem::size_of::<T>() as u64;\n    (width, if width == 64 { 0xffffffffffffffff } else { (1u64 << width) - 1 })\n}\n\n// T's value as its width's bits, zero-extended.\n#[effects()]\nfn wrap_bits<T: __IntBits>(x: T) -> u64 {\n    let (_, mask) = wrap_width::<T>();\n    x.__int_bits().0 & mask\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Add for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn add(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a.wrapping_add(b)))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Sub for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn sub(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a.wrapping_sub(b)))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Mul for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn mul(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a.wrapping_mul(b)))\n    }\n}\n");
    buf_str(out, c"\nimpl<T: __IntBits + Copy> crate::ops::BitAnd for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn bitand(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a & b))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitOr for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn bitor(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a | b))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitXor for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn bitxor(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a ^ b))\n    }\n}\n\n// (by zero: a panic, as T's)\nimpl<T: __IntBits + Copy> crate::ops::Div for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn div(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let (a, signed) = self.0.__int_bits();\n        let b = rhs.0.__int_bits().0;\n        let q = if signed { (a as i64).wrapping_div(b as i64) as u64 } else { a / b };\n        Wrapping(T::__int_from(q))\n    }\n}\n\n// (by zero: a panic, as T's)\nimpl<T: __IntBits + Copy> crate::ops::Rem for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn rem(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let (a, signed) = self.0.__int_bits();\n        let b = rhs.0.__int_bits().0;\n        let q = if signed { (a as i64).wrapping_rem(b as i64) as u64 } else { a % b };\n        Wrapping(T::__int_from(q))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Shl<usize> for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn shl(self, rhs: usize) -> Wrapping<T> {\n        let (width, _) = wrap_width::<T>();\n        let (a, signed) = self.0.__int_bits();\n        let s = rhs as u64 & (width - 1);\n        Wrapping(T::__int_from(a << s))\n    }\n}\n\n");
    buf_str(out, c"impl<T: __IntBits + Copy> crate::ops::Shr<usize> for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn shr(self, rhs: usize) -> Wrapping<T> {\n        let (width, _) = wrap_width::<T>();\n        let (a, signed) = self.0.__int_bits();\n        let s = rhs as u64 & (width - 1);\n        let q = if signed { ((a as i64) >> (s as i64)) as u64 } else { a >> s };\n        Wrapping(T::__int_from(q))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Neg for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn neg(self) -> Wrapping<T> {\n        Wrapping(T::__int_from(0u64.wrapping_sub(self.0.__int_bits().0)))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Not for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn not(self) -> Wrapping<T> {\n        Wrapping(T::__int_from(!self.0.__int_bits().0))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::AddAssign for Wrapping<T> {\n    fn add_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self + rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::AddAssign<T> for Wrapping<T> {\n    fn add_assign(&mut self, rhs: T) {\n        *self = *self + Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::SubAssign for Wrapping<T> {\n    fn sub_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self - rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::SubAssign<T> for Wrapping<T> {\n    fn sub_assign(&mut self, rhs: T) {\n        *self = *self - Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::MulAssign for Wrapping<T> {\n    fn mul_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self * rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::MulAssign<T> for Wrapping<T> {\n    fn mul_assign(&mut self, rhs: T) {\n        *self = *self * Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::DivAssign for Wrapping<T> {\n    fn div_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self / rhs;\n    }\n}\n\n");
    buf_str(out, c"impl<T: __IntBits + Copy> crate::ops::DivAssign<T> for Wrapping<T> {\n    fn div_assign(&mut self, rhs: T) {\n        *self = *self / Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::RemAssign for Wrapping<T> {\n    fn rem_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self % rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::RemAssign<T> for Wrapping<T> {\n    fn rem_assign(&mut self, rhs: T) {\n        *self = *self % Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitAndAssign for Wrapping<T> {\n    fn bitand_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self & rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitAndAssign<T> for Wrapping<T> {\n    fn bitand_assign(&mut self, rhs: T) {\n        *self = *self & Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitOrAssign for Wrapping<T> {\n    fn bitor_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self | rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitOrAssign<T> for Wrapping<T> {\n    fn bitor_assign(&mut self, rhs: T) {\n        *self = *self | Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitXorAssign for Wrapping<T> {\n    fn bitxor_assign(&mut self, rhs: Wrapping<T>) {\n        *self = *self ^ rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitXorAssign<T> for Wrapping<T> {\n    fn bitxor_assign(&mut self, rhs: T) {\n        *self = *self ^ Wrapping(rhs);\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::ShlAssign<usize> for Wrapping<T> {\n    fn shl_assign(&mut self, rhs: usize) {\n        *self = *self << rhs;\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::ShrAssign<usize> for Wrapping<T> {\n    fn shr_assign(&mut self, rhs: usize) {\n        *self = *self >> rhs;\n    }\n}\n\nimpl<T: crate::fmt::Display> crate::fmt::Display for Wrapping<T> {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Display::fmt(&self.0, f)\n    }\n}\n");
    buf_str(out, c"\nimpl<T: crate::fmt::Debug> crate::fmt::Debug for Wrapping<T> {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Debug::fmt(&self.0, f)\n    }\n}\n\nimpl<T: crate::fmt::Binary> crate::fmt::Binary for Wrapping<T> {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Binary::fmt(&self.0, f)\n    }\n}\n\nimpl<T: crate::fmt::Octal> crate::fmt::Octal for Wrapping<T> {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::Octal::fmt(&self.0, f)\n    }\n}\n\nimpl<T: crate::fmt::LowerHex> crate::fmt::LowerHex for Wrapping<T> {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::LowerHex::fmt(&self.0, f)\n    }\n}\n\nimpl<T: crate::fmt::UpperHex> crate::fmt::UpperHex for Wrapping<T> {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        crate::fmt::UpperHex::fmt(&self.0, f)\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::iter::Sum for Wrapping<T> {\n    fn sum<I: crate::iter::Iterator<Item = Wrapping<T>>>(iter: I) -> Wrapping<T> {\n        let mut acc = Wrapping(T::__int_from(0));\n        for x in iter {\n            acc = acc + x;\n        }\n        acc\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::iter::Product for Wrapping<T> {\n    fn product<I: crate::iter::Iterator<Item = Wrapping<T>>>(iter: I) -> Wrapping<T> {\n        let mut acc = Wrapping(T::__int_from(1));\n        for x in iter {\n            acc = acc * x;\n        }\n        acc\n    }\n}\n\n// (the bit counts are u64's, whose list has `diverge`: its loops)\nimpl<T: __IntBits + Copy> Wrapping<T> {\n    #[effects(diverge)]\n    pub fn count_ones(self) -> u32 {\n        wrap_bits(self.0).count_ones()\n    }\n\n    #[effects(diverge)]\n    pub fn count_zeros(self) -> u32 {\n        let (width, _) = wrap_width::<T>();\n        width as u32 - wrap_bits(self.0).count_ones()\n    }\n\n");
    buf_str(out, c"    #[effects(diverge)]\n    pub fn leading_zeros(self) -> u32 {\n        let (width, _) = wrap_width::<T>();\n        wrap_bits(self.0).leading_zeros() - (64 - width as u32)\n    }\n\n    #[effects(diverge)]\n    pub fn trailing_zeros(self) -> u32 {\n        let (width, _) = wrap_width::<T>();\n        let m = wrap_bits(self.0);\n        if m == 0 { width as u32 } else { m.trailing_zeros() }\n    }\n\n    // The bits turned left by n places (n modulo the width).\n    #[effects()]\n    pub fn rotate_left(self, n: u32) -> Wrapping<T> {\n        let (width, _) = wrap_width::<T>();\n        let m = wrap_bits(self.0);\n        let s = n as u64 % width;\n        Wrapping(T::__int_from(if s == 0 { m } else { (m << s) | (m >> (width - s)) }))\n    }\n\n    #[effects()]\n    pub fn rotate_right(self, n: u32) -> Wrapping<T> {\n        let (width, _) = wrap_width::<T>();\n        let m = wrap_bits(self.0);\n        let s = n as u64 % width;\n        Wrapping(T::__int_from(if s == 0 { m } else { (m >> s) | (m << (width - s)) }))\n    }\n\n    // The bytes in the opposite order.\n    #[effects()]\n    pub fn swap_bytes(self) -> Wrapping<T> {\n        let (width, _) = wrap_width::<T>();\n        let mut m = wrap_bits(self.0);\n        let mut r: u64 = 0;\n        for _ in 0..width / 8 {\n            r = (r << 8) | (m & 0xff);\n            m >>= 8;\n        }\n        Wrapping(T::__int_from(r))\n    }\n\n    // The bits in the opposite order.\n    #[effects()]\n    pub fn reverse_bits(self) -> Wrapping<T> {\n        let (width, _) = wrap_width::<T>();\n        let mut m = wrap_bits(self.0);\n        let mut r: u64 = 0;\n        for _ in 0..width {\n            r = (r << 1) | (m & 1);\n            m >>= 1;\n        }\n        Wrapping(T::__int_from(r))\n    }\n\n    // self to the power exp, wrapping (by squaring).\n    #[effects()]\n    pub fn pow(self, exp: u32) -> Wrapping<T> {\n        let mut base = self.0.__int_bits().0;\n        let mut e = exp;\n");
    buf_str(out, c"        let mut acc: u64 = 1;\n        // (exp's 32 bits, the low one first)\n        for _ in 0..32 {\n            if e == 0 {\n                break;\n            }\n            if (e & 1) == 1 {\n                acc = acc.wrapping_mul(base);\n            }\n            base = base.wrapping_mul(base);\n            e >>= 1;\n        }\n        Wrapping(T::__int_from(acc))\n    }\n\n    #[effects()]\n    pub fn is_power_of_two(self) -> bool {\n        let m = wrap_bits(self.0);\n        m != 0 && (m & (m - 1)) == 0\n    }\n\n    // The absolute value; the smallest value of a signed T stays itself.\n    #[effects()]\n    pub fn abs(self) -> Wrapping<T> {\n        let (a, signed) = self.0.__int_bits();\n        if signed && (a as i64) < 0 { Wrapping(T::__int_from(0u64.wrapping_sub(a))) } else { self }\n    }\n\n    // -1, 0 or 1, as the value is negative, zero or positive.\n    #[effects()]\n    pub fn signum(self) -> Wrapping<T> {\n        let (a, signed) = self.0.__int_bits();\n        Wrapping(T::__int_from(if a == 0 { 0 }\n            else if signed && (a as i64) < 0 { 0xffffffffffffffff }\n            else { 1 }))\n    }\n\n    #[effects()]\n    pub fn is_positive(self) -> bool {\n        let (a, signed) = self.0.__int_bits();\n        a != 0 && !(signed && (a as i64) < 0)\n    }\n\n    #[effects()]\n    pub fn is_negative(self) -> bool {\n        let (a, signed) = self.0.__int_bits();\n        signed && (a as i64) < 0\n    }\n}\n// ---- end mod std::intconv ----\n}\n// ---- mod std::string ----\npub mod string {\n// std::string: String<A>, owned UTF-8 text on A's heap, and ToStringIn.\n// `String::new_in(a)`, `String::from_in(\"x\", a)`, `\"x\".to_string_in(a)`;\n// no `String::from(s)` and no `From<&str>` (it would allocate with no\n// allocator in the call: plan §2). A String has str's methods through\n// Deref; its own are the ones that change it, and they allocate from its\n// A only. MVS's Buf<A> (a byte buffer) is gone: a Vec<u8, A>, or a String.\n");
    buf_str(out, c"// `write(&mut s, \"{x}\")` (fmt::Write) is MVS's `s.push_fmt(\"{x}\")`.\n\nuse crate::alloc::{Allocator, TryReserveError};\nuse crate::borrow::{Borrow, BorrowMut};\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::{AsMut, AsRef};\nuse crate::default::DefaultIn;\nuse crate::fmt::{Debug, Display, Formatter, Write};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::ops::{Add, AddAssign, Bound, Deref, DerefMut, Index, IndexMut, RangeBounds};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::slice::SliceIndex;\nuse crate::str::{Chars, Utf8Error};\nuse crate::vec::Vec;\n\n// UTF-8 text that owns its bytes, on A.\npub struct String<A: Allocator> {\n    vec: Vec<u8, A>,\n}\n\nimpl<A: Allocator> String<A> {\n    // An empty String on a; it allocates at its first push.\n    #[effects(A)]\n    pub fn new_in(a: A) -> String<A> {\n        String { vec: Vec::new_in(a) }\n    }\n\n    #[effects(A)]\n    pub fn with_capacity_in(cap: usize, a: A) -> String<A> {\n        String { vec: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A copy of s on a.\n    // std: changed: takes &str\n    #[effects(A)]\n    pub fn from_in(s: &str, a: A) -> String<A> {\n        let mut out = String::with_capacity_in(s.len(), a);\n        out.push_str(s);\n        out\n    }\n\n    // v as a String when it is UTF-8; the error gives v back.\n    // std: changed: the error is FromUtf8Error<A>, which holds v (MVS: Utf8Error)\n    #[effects(panic, diverge, A)]\n    pub fn from_utf8(v: Vec<u8, A>) -> Result<String<A>, FromUtf8Error<A>> {\n        match crate::str::from_utf8(v.as_slice()) {\n            Result::Ok(_) => Result::Ok(String { vec: v }),\n            Result::Err(e) => Result::Err(FromUtf8Error { bytes: v, error: e }),\n        }\n    }\n\n    #[effects(unsafe)]\n");
    buf_str(out, c"    // UNSAFE: bytes that are not UTF-8 make a String whose str methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: Vec<u8, A>) -> String<A> {\n        String { vec: v }\n    }\n\n    // v as text on a, each bad sequence U+FFFD (Rust's from_utf8_lossy,\n    // which returns a Cow).\n    // std: changed: takes &[u8]\n    #[effects(panic, diverge, unsafe, A)]\n    pub fn from_utf8_lossy_in(v: &[u8], a: A) -> String<A> {\n        let mut out = String::with_capacity_in(v.len(), a);\n        let mut rest = v;\n        loop {\n            match crate::str::from_utf8(rest) {\n                Result::Ok(s) => {\n                    out.push_str(s);\n                    return out;\n                }\n                Result::Err(e) => {\n                    let good = e.valid_up_to();\n                    // UNSAFE: from_utf8 checked these bytes already; the\n                    // checked conversion would check them again.\n                    // SAFETY: valid_up_to says the first good bytes of rest\n                    // are UTF-8.\n                    out.push_str(unsafe { crate::str::from_utf8_unchecked(&rest[..good]) });\n                    out.push_str(\"\\u{FFFD}\");\n                    let bad = match e.error_len() {\n                        Option::Some(n) => n,\n                        Option::None => rest.len() - good,\n                    };\n                    rest = &rest[good + bad..];\n                }\n            }\n        }\n    }\n\n    // Its length in bytes.\n    #[effects(A)]\n    pub fn len(&self) -> usize {\n        self.vec.len()\n    }\n\n    #[effects(A)]\n    pub fn is_empty(&self) -> bool {\n        self.vec.is_empty()\n    }\n\n    #[effects(A)]\n    pub fn capacity(&self) -> usize {\n        self.vec.capacity()\n    }\n\n    // std: changed: returns &A (MVS: a copy of A)\n    #[effects(A)]\n    pub fn allocator(&self) -> &A {\n        self.vec.allocator()\n    }\n\n");
    buf_str(out, c"    #[effects(A)]\n    pub fn reserve(&mut self, extra: usize) {\n        self.vec.reserve(extra)\n    }\n\n    #[effects(A)]\n    pub fn reserve_exact(&mut self, extra: usize) {\n        self.vec.reserve_exact(extra)\n    }\n\n    #[effects(A)]\n    pub fn try_reserve(&mut self, extra: usize) -> Result<(), TryReserveError> {\n        self.vec.try_reserve(extra)\n    }\n\n    #[effects(A)]\n    pub fn shrink_to_fit(&mut self) {\n        self.vec.shrink_to_fit()\n    }\n\n    // Empties it; the capacity stays.\n    #[effects(panic, A)]\n    pub fn clear(&mut self)\n        ensures self.len() == 0\n    {\n        self.vec.clear()\n    }\n\n    #[effects(unsafe, A)]\n    pub fn as_str(&self) -> &str {\n        // UNSAFE: the bytes are not checked again.\n        // SAFETY: a String's bytes are UTF-8 (every method that writes them\n        // keeps them so; as_mut_vec's caller promises it).\n        unsafe { crate::str::from_utf8_unchecked(self.vec.as_slice()) }\n    }\n\n    #[effects(A)]\n    pub fn as_mut_str(&mut self) -> &mut str {\n        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's\n        // str::from_utf8_unchecked_mut).\n        // SAFETY: a String's bytes are UTF-8, and a str is laid out as a\n        // [u8]; the &mut str's writes keep them UTF-8 (str's contract).\n        unsafe { &mut *(self.vec.as_mut_slice() as *mut [u8] as *mut str) }\n    }\n\n    // mvs: String::as_bytes, String::as_slice\n    #[effects(A)]\n    pub fn as_bytes(&self) -> &[u8] {\n        self.vec.as_slice()\n    }\n\n    // Its bytes as a &mut Vec.\n    #[effects(unsafe)]\n    // UNSAFE: writing bytes that are not UTF-8 breaks the String.\n    // SAFETY: a contract on the caller: the bytes stay UTF-8.\n    pub unsafe fn as_mut_vec(&mut self) -> &mut Vec<u8, A> {\n        &mut self.vec\n    }\n\n    // Its bytes, the String consumed.\n    #[effects()]\n    pub fn into_bytes(self) -> Vec<u8, A> {\n        self.vec\n    }\n\n    // Appends c's UTF-8.\n");
    buf_str(out, c"    // std: changed: takes a char (MVS: a u32 code point)\n    #[effects(panic, A)]\n    pub fn push(&mut self, c: char)\n        ensures self.len() > old(self.len())\n    {\n        if c.len_utf8() == 1 {\n            self.vec.push(c as u8);\n        } else {\n            let mut buf = [0u8; 4];\n            self.push_str(c.encode_utf8(&mut buf));\n        }\n    }\n\n    #[effects(A)]\n    pub fn push_str(&mut self, s: &str) {\n        self.vec.extend_from_slice(s.as_bytes())\n    }\n\n    // The last char, removed.\n    // std: changed: Option<char> (MVS: Option<u32>)\n    #[effects(panic, diverge, A)]\n    pub fn pop(&mut self) -> Option<char> {\n        let c = self.as_str().chars().next_back()?;\n        let n = self.len() - c.len_utf8();\n        self.vec.truncate(n);\n        Option::Some(c)\n    }\n\n    // Keeps the first n bytes; panics when n is not a char boundary.\n    #[effects(panic, A)]\n    pub fn truncate(&mut self, n: usize)\n        requires n >= self.len() || self.as_str().is_char_boundary(n)\n    {\n        if n <= self.len() {\n            crate::panic::assert(self.is_char_boundary(n), \"String::truncate: not a char boundary\");\n            self.vec.truncate(n);\n        }\n    }\n\n    // Inserts c at byte i (a char boundary).\n    // std: changed: takes a char\n    #[effects(panic, A)]\n    pub fn insert(&mut self, i: usize, c: char)\n        requires self.as_str().is_char_boundary(i)\n    {\n        crate::panic::assert(self.is_char_boundary(i), \"String::insert: not a char boundary\");\n        let mut buf = [0u8; 4];\n        let s = c.encode_utf8(&mut buf);\n        self.insert_bytes(i, s.as_bytes());\n    }\n\n    #[effects(panic, A)]\n    pub fn insert_str(&mut self, i: usize, s: &str)\n        requires self.as_str().is_char_boundary(i)\n    {\n        crate::panic::assert(self.is_char_boundary(i), \"String::insert_str: not a char boundary\");\n        self.insert_bytes(i, s.as_bytes());\n    }\n\n    // Removes the char at byte i.\n");
    buf_str(out, c"    // std: changed: returns a char\n    #[effects(panic, A)]\n    pub fn remove(&mut self, i: usize) -> char {\n        let c = match self.as_str()[i..].chars().next() {\n            Option::Some(c) => c,\n            Option::None => {\n                let msg: &str = \"cannot remove a char from the end of a string\";\n                crate::panic::panic(msg)\n            }\n        };\n        self.vec.drain(i..i + c.len_utf8());\n        c\n    }\n\n    // Keeps the chars f says true of.\n    // std: changed: FnMut(char) (MVS: FnMut(u32))\n    #[effects(panic, diverge, unsafe, A, F)]\n    pub fn retain<F: FnMut(char) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        let len = self.len();\n        let mut r: usize = 0;\n        let mut w: usize = 0;\n        while r < len {\n            // UNSAFE: the bytes from r on are read as text while the ones\n            // before are being moved down.\n            // SAFETY: w <= r, so the bytes from r on are untouched: the\n            // String's own, UTF-8, and r is a char boundary in them.\n            let rest = unsafe { crate::str::from_utf8_unchecked(&self.vec.as_slice()[r..]) };\n            let c = match rest.chars().next() {\n                Option::Some(c) => c,\n                Option::None => break,\n            };\n            let n = c.len_utf8();\n            if f(c) {\n                self.vec.copy_within(r..r + n, w);\n                w += n;\n            }\n            r += n;\n        }\n        self.vec.truncate(w);\n    }\n\n    // The chars in range, removed and yielded by the iterator.\n    #[effects(panic, unsafe, A, R)]\n    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, A> {\n        let (start, end) = range_of(&range, self.len());\n        crate::panic::assert(self.is_char_boundary(start),\n            \"String::drain: start is not a char boundary\");\n        crate::panic::assert(self.is_char_boundary(end),\n");
    buf_str(out, c"            \"String::drain: end is not a char boundary\");\n        let p = self.vec.as_ptr();\n        // UNSAFE: the iterator reads the drained text while the Drain holds\n        // the String (removed at its drop), as Rust's Drain.\n        // SAFETY: start..end is within the String and on char boundaries,\n        // so the bytes are UTF-8; the Drain borrows the String mutably for\n        // '_, so nothing else changes them before its drop.\n        let text = unsafe { crate::str::from_utf8_unchecked(\n            crate::slice::from_raw_parts(p.add(start), end - start)) };\n        Drain { string: self as *mut String<A>, start: start, end: end, iter: text.chars() }\n    }\n\n    // The text from byte at on, as a new String on a clone of A.\n    #[effects(panic, A)]\n    pub fn split_off(&mut self, at: usize) -> String<A>\n        where\n            A: Clone,\n            requires self.as_str().is_char_boundary(at)\n    {\n        crate::panic::assert(self.is_char_boundary(at), \"String::split_off: not a char boundary\");\n        String { vec: self.vec.split_off(at) }\n    }\n\n    // Replaces the bytes in range with s.\n    #[effects(panic, A, R)]\n    pub fn replace_range<R: RangeBounds<usize>>(&mut self, range: R, s: &str) {\n        let (start, end) = range_of(&range, self.len());\n        crate::panic::assert(self.is_char_boundary(start),\n            \"String::replace_range: start is not a char boundary\");\n        crate::panic::assert(self.is_char_boundary(end),\n            \"String::replace_range: end is not a char boundary\");\n        self.vec.drain(start..end);\n        self.insert_bytes(start, s.as_bytes());\n    }\n\n    // Appends a copy of its own bytes in src.\n    #[effects(A, R)]\n    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {\n        self.vec.extend_from_within(src)\n    }\n\n    // bytes put in at byte i, the ones after it moved up (insert's and\n");
    buf_str(out, c"    // replace_range's; the caller checks that i is a char boundary).\n    fn insert_bytes(&mut self, i: usize, bytes: &[u8]) {\n        let n = bytes.len();\n        self.vec.extend_from_slice(bytes);\n        self.vec.as_mut_slice()[i..].rotate_right(n);\n    }\n\n    // A copy on another allocator.\n    #[effects(A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> String<B> {\n        String::from_in(self.as_str(), b)\n    }\n\n    // The text, never freed.\n    #[effects(A)]\n    pub fn leak<'a>(self) -> &'a mut str\n        where\n            A: 'a,\n    {\n        let bytes = self.vec.leak();\n        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's\n        // str::from_utf8_unchecked_mut).\n        // SAFETY: a String's bytes are UTF-8, and a str is laid out as a [u8].\n        unsafe { &mut *(bytes as *mut [u8] as *mut str) }\n    }\n\n    // Moves the String out, leaving an empty one on a clone of its allocator.\n    #[effects(A)]\n    pub fn take(&mut self) -> String<A>\n        where\n            A: Clone,\n    {\n        String { vec: self.vec.take() }\n    }\n}\n\nimpl<A: Allocator> Deref for String<A> {\n    type Target = str;\n\n    fn deref(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> DerefMut for String<A> {\n    fn deref_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\nimpl<I: SliceIndex<str>, A: Allocator> Index<I> for String<A> {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self.as_str())\n    }\n}\n\nimpl<I: SliceIndex<str>, A: Allocator> IndexMut<I> for String<A> {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self.as_mut_str())\n    }\n}\n\n// A copy on the same allocator (a clone of it).\n// std: changed: needs A: Clone\nimpl<A: Allocator + Clone> Clone for String<A> {\n    fn clone(&self) -> String<A> {\n        String { vec: self.vec.clone() }\n    }\n}\n\n// mvs: String::impl Eq\n");
    buf_str(out, c"// std: changed: PartialEq with any String<B>, str and &str\nimpl<A: Allocator, B: Allocator> PartialEq<String<B>> for String<A> {\n    fn eq(&self, other: &String<B>) -> bool {\n        self.as_str() == other.as_str()\n    }\n}\n\nimpl<A: Allocator> PartialEq<str> for String<A> {\n    fn eq(&self, other: &str) -> bool {\n        self.as_str() == other\n    }\n}\n\nimpl<'a, A: Allocator> PartialEq<&'a str> for String<A> {\n    fn eq(&self, other: &&'a str) -> bool {\n        self.as_str() == *other\n    }\n}\n\nimpl<A: Allocator> Eq for String<A> {}\n\nimpl<A: Allocator> PartialOrd for String<A> {\n    fn partial_cmp(&self, other: &String<A>) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\n// mvs: String::impl Ord\nimpl<A: Allocator> Ord for String<A> {\n    fn cmp(&self, other: &String<A>) -> Ordering {\n        self.as_str().cmp(other.as_str())\n    }\n}\n\n// As its str: the same for any A, so a HashMap<String<A>, V, A2> is\n// looked up by a &str (Borrow<str>).\n// mvs: String::impl Hash\nimpl<A: Allocator> Hash for String<A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.as_str().hash(state)\n    }\n}\n\n// mvs: String::impl Display\nimpl<A: Allocator> Display for String<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.as_str(), f)\n    }\n}\n\n// mvs: String::impl Debug\nimpl<A: Allocator> Debug for String<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.as_str(), f)\n    }\n}\n\n// `write(&mut s, \"{x}\")`: never fails (it grows from A).\n// mvs: String::push_fmt, Buf::push_fmt\nimpl<A: Allocator> Write for String<A> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.push_str(s);\n        Result::Ok(())\n    }\n}\n\nimpl<A: Allocator> Borrow<str> for String<A> {\n    fn borrow(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> BorrowMut<str> for String<A> {\n");
    buf_str(out, c"    fn borrow_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<str> for String<A> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\nimpl<A: Allocator> AsRef<[u8]> for String<A> {\n    fn as_ref(&self) -> &[u8] {\n        self.as_bytes()\n    }\n}\n\nimpl<A: Allocator> AsMut<str> for String<A> {\n    fn as_mut(&mut self) -> &mut str {\n        self.as_mut_str()\n    }\n}\n\n// `s + \"x\"`: s, grown from its own A.\nimpl<'b, A: Allocator> Add<&'b str> for String<A> {\n    type Output = String<A>;\n\n    fn add(self, other: &'b str) -> String<A> {\n        let mut s = self;\n        s.push_str(other);\n        s\n    }\n}\n\n// `s += \"x\"`.\nimpl<'b, A: Allocator> AddAssign<&'b str> for String<A> {\n    fn add_assign(&mut self, other: &'b str) {\n        self.push_str(other)\n    }\n}\n\nimpl<A: Allocator> Extend<char> for String<A> {\n    fn extend<I: IntoIterator<Item = char>>(&mut self, iter: I) {\n        for c in iter {\n            self.push(c);\n        }\n    }\n}\n\nimpl<'b, A: Allocator> Extend<&'b str> for String<A> {\n    fn extend<I: IntoIterator<Item = &'b str>>(&mut self, iter: I) {\n        for s in iter {\n            self.push_str(s);\n        }\n    }\n}\n\n// `chars.collect_in(a)` into a String.\nimpl<A: Allocator> FromIteratorIn<char, A> for String<A> {\n    fn from_iter_in<I: IntoIterator<Item = char>>(iter: I, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<'b, A: Allocator> FromIteratorIn<&'b str, A> for String<A> {\n    fn from_iter_in<I: IntoIterator<Item = &'b str>>(iter: I, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<A: Allocator> DefaultIn<A> for String<A> {\n    fn default_in(a: A) -> String<A> {\n        String::new_in(a)\n    }\n}\n\n// Why bytes are not a String: the error, and the bytes back.\n#[derive(Debug)]\n");
    buf_str(out, c"pub struct FromUtf8Error<A: Allocator> {\n    bytes: Vec<u8, A>,\n    error: Utf8Error,\n}\n\nimpl<A: Allocator> FromUtf8Error<A> {\n    #[effects(A)]\n    pub fn as_bytes(&self) -> &[u8] {\n        self.bytes.as_slice()\n    }\n\n    #[effects()]\n    pub fn into_bytes(self) -> Vec<u8, A> {\n        self.bytes\n    }\n\n    #[effects()]\n    pub fn utf8_error(&self) -> Utf8Error {\n        self.error\n    }\n}\n\n// The start and end a range names in 0..len; panics when it is not in\n// it or ends before it starts.\nfn range_of<R: RangeBounds<usize>>(range: &R, len: usize) -> (usize, usize) {\n    let start = match range.start_bound() {\n        Bound::Included(s) => *s,\n        Bound::Excluded(s) => *s + 1,\n        Bound::Unbounded => 0,\n    };\n    let end = match range.end_bound() {\n        Bound::Included(e) => *e + 1,\n        Bound::Excluded(e) => *e,\n        Bound::Unbounded => len,\n    };\n    crate::panic::assert(start <= end && end <= len, \"String: range out of bounds\");\n    (start, end)\n}\n\n// String::drain's iterator: the removed chars.\npub struct Drain<'a, A: Allocator> {\n    string: *mut String<A>,\n    start: usize,\n    end: usize,\n    iter: Chars<'a>,\n}\n\n// UNSAFE: Drain reaches its String through a raw pointer: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the String for 'a; its bytes are\n// plain data, so it is Send and Sync as `&'a mut String<A>` is.\nunsafe impl<'a, A: Allocator + Send> Send for Drain<'a, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Drain` reads only the drained bytes.\nunsafe impl<'a, A: Allocator + Sync> Sync for Drain<'a, A> {}\n\nimpl<'a, A: Allocator> Iterator for Drain<'a, A> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        self.iter.next()\n    }\n}\n\nimpl<'a, A: Allocator> DoubleEndedIterator for Drain<'a, A> {\n    fn next_back(&mut self) -> Option<char> {\n        self.iter.next_back()\n    }\n}\n\n");
    buf_str(out, c"impl<'a, A: Allocator> crate::ops::Drop for Drain<'a, A> {\n    fn drop(&mut self) {\n        // UNSAFE: the String is reached through the pointer drain took.\n        // SAFETY: the Drain borrowed the String mutably for its life, so the\n        // pointer is valid and nothing else uses the String; start..end was\n        // checked against its length and char boundaries at drain.\n        unsafe {\n            (*self.string).vec.drain(self.start..self.end);\n        }\n    }\n}\n\n// What can be written as text, written into a new String on a: Rust's\n// ToString with the allocator named. Every Display type has it\n// (`x.to_string_in(gpa)`, `format_args(\"{a}-{b}\").to_string_in(gpa)`).\npub trait ToStringIn<A: Allocator> {\n    fn to_string_in(&self, a: A) -> String<A>;\n}\n\n// later: blanket_impl\nimpl<T: Display + ?Sized, A: Allocator> ToStringIn<A> for T {\n    fn to_string_in(&self, a: A) -> String<A> {\n        let mut s = String::new_in(a);\n        let _ = s.write_fmt(self);\n        s\n    }\n}\n// ---- end mod std::string ----\n}\n// ---- mod std::hash ----\npub mod hash {\n// std::hash: Hash, Hasher, BuildHasher, and the hashers. Rust's shape:\n// a type feeds its parts to a Hasher (`x.hash(&mut h)`), and a map's\n// BuildHasher makes the Hasher. MVS's Hash (`hash(self) -> u64`, one\n// fixed function) is gone into it. The default, FixedState, is foldhash\n// with fixed seeds, so a map iterates in the same order in every run and\n// on every target (decision 2); a seeded one goes through\n// `HashMap::with_hasher_in(FixedState::with_seed(s), a)`, and\n// RandomState seeds from the OS: HashDoS is the guide's topic. The\n// numbers', bool's, char's and str's impls are built in or in their\n// modules; `#[derive(Hash)]` makes the others (`syntax.later:\n// rust_derives`).\n\nuse crate::default::Default;\nuse crate::marker::PhantomData;\n\n// A value that can be hashed: equal values (Eq) feed equal input.\n");
    buf_str(out, c"// std: changed: Rust's shape, hash<H: Hasher>(&self, &mut H) (MVS: hash(self) -> u64)\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, bool)]\npub trait Hash {\n    // std: changed: feeds a Hasher (MVS: returned a u64)\n    // (0.28.0: #[pure], as MVS's Hash::hash: an impl is checked against\n    // it. What it writes goes through `state`, a `&mut` parameter, and\n    // what the Hasher's methods do is the Hasher's, E3.4a: a Hasher that\n    // prints what it is fed makes no impl impure.)\n    #[pure]\n    fn hash<H: Hasher>(&self, state: &mut H);\n\n    // Each element of data, in order.\n    fn hash_slice<H: Hasher>(data: &[Self], state: &mut H)\n        where\n            Self: Sized,\n    {\n        for x in data {\n            x.hash(state);\n        }\n    }\n}\n\n// What a Hash feeds; finish gives the hash.\npub trait Hasher {\n    fn finish(&self) -> u64;\n    fn write(&mut self, bytes: &[u8]);\n\n    fn write_u8(&mut self, i: u8) {\n        let b: [u8; 1] = [i];\n        self.write(&b[..])\n    }\n\n    // Its 2 bytes, little-endian (Rust's: native-endian, the same on\n    // every target of vole).\n    fn write_u16(&mut self, i: u16) {\n        let b: [u8; 2] = [i as u8, (i >> 8) as u8];\n        self.write(&b[..])\n    }\n\n    // Its 4 bytes, little-endian.\n    fn write_u32(&mut self, i: u32) {\n        let b: [u8; 4] = [i as u8, (i >> 8) as u8, (i >> 16) as u8, (i >> 24) as u8];\n        self.write(&b[..])\n    }\n\n    // Its 8 bytes, little-endian.\n    fn write_u64(&mut self, i: u64) {\n        let b = le_bytes(i);\n        self.write(&b[..])\n    }\n\n    fn write_usize(&mut self, i: usize) {\n        self.write_u64(i as u64)\n    }\n\n    fn write_i8(&mut self, i: i8) {\n        self.write_u8(i as u8)\n    }\n\n    fn write_i16(&mut self, i: i16) {\n        self.write_u16(i as u16)\n    }\n\n    fn write_i32(&mut self, i: i32) {\n        self.write_u32(i as u32)\n    }\n\n    fn write_i64(&mut self, i: i64) {\n");
    buf_str(out, c"        self.write_u64(i as u64)\n    }\n\n    fn write_isize(&mut self, i: isize) {\n        self.write_usize(i as usize)\n    }\n\n    // A slice's or a str's length, before its elements.\n    fn write_length_prefix(&mut self, len: usize) {\n        self.write_usize(len)\n    }\n}\n\n// What makes a map's Hashers: each one starts from the same state, so\n// equal keys hash equal.\npub trait BuildHasher {\n    type Hasher: Hasher;\n\n    fn build_hasher(&self) -> Self::Hasher;\n\n    // The hash of x with a new Hasher.\n    fn hash_one<T: Hash>(&self, x: T) -> u64 {\n        let mut h = self.build_hasher();\n        x.hash(&mut h);\n        h.finish()\n    }\n}\n\n// A BuildHasher for a Default Hasher type.\npub struct BuildHasherDefault<H> {\n    marker: PhantomData<fn() -> H>,\n}\n\nimpl<H: Default + Hasher> BuildHasher for BuildHasherDefault<H> {\n    type Hasher = H;\n\n    fn build_hasher(&self) -> H {\n        H::default()\n    }\n}\n\nimpl<H> Default for BuildHasherDefault<H> {\n    fn default() -> BuildHasherDefault<H> {\n        BuildHasherDefault { marker: PhantomData {} }\n    }\n}\n\n// x's 8 bytes, little-endian.\nfn le_bytes(x: u64) -> [u8; 8] {\n    [\n        x as u8,\n        (x >> 8) as u8,\n        (x >> 16) as u8,\n        (x >> 24) as u8,\n        (x >> 32) as u8,\n        (x >> 40) as u8,\n        (x >> 48) as u8,\n        (x >> 56) as u8,\n    ]\n}\n\n// The n bytes at b[i..i + n] (n <= 8) as a u64, little-endian.\nfn read_le(b: &[u8], i: usize, n: usize) -> u64 {\n    let mut x: u64 = 0;\n    let mut k: usize = 0;\n    while k < n {\n        x |= (b[i + k] as u64) << (8 * k) as u64;\n        k += 1;\n    }\n    x\n}\n\n// The high 64 bits of the 128-bit product a * b (vole has no u128): four\n// 32-bit products, none of which overflows.\nfn mul_hi(a: u64, b: u64) -> u64 {\n    let m: u64 = 0xffffffff;\n    let (a0, a1) = (a & m, a >> 32);\n    let (b0, b1) = (b & m, b >> 32);\n    let p00 = a0 * b0;\n    let p01 = a0 * b1;\n");
    buf_str(out, c"    let p10 = a1 * b0;\n    let p11 = a1 * b1;\n    let mid = (p00 >> 32) + (p01 & m) + (p10 & m);\n    p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n}\n\n// foldhash's folded multiply: the low and high halves of a * b, xor'ed.\nfn fold_mul(a: u64, b: u64) -> u64 {\n    a.wrapping_mul(b) ^ mul_hi(a, b)\n}\n\nfn rotate_right(x: u64, r: usize) -> u64 {\n    let k = (r & 63) as u64;\n    (x >> k) | (x << ((64 - k) & 63))\n}\n\nfn rotate_left(x: u64, r: u64) -> u64 {\n    (x << r) | (x >> (64 - r))\n}\n\n// foldhash's constants (hexadecimal digits of pi).\nconst FOLD_ARBITRARY3: u64 = 0x082efa98ec4e6c89;\nconst FOLD_ARBITRARY5: u64 = 0xbe5466cf34e90c6c;\n\n// foldhash with fixed seeds: HashMap's and HashSet's default S. The same\n// order in every run and on every target. Bit for bit the foldhash\n// crate's (0.2) fast FixedState.\n#[derive(Clone, Copy, Debug)]\npub struct FixedState {\n    seed: u64,\n}\n\nimpl FixedState {\n    // The fixed seed: foldhash's FixedState::default().\n    #[effects()]\n    pub fn new() -> FixedState {\n        FixedState { seed: FOLD_ARBITRARY3 }\n    }\n\n    // A seed of the program's choosing (a per-process secret against\n    // HashDoS, or a test's): foldhash's FixedState::with_seed.\n    #[effects()]\n    pub fn with_seed(seed: u64) -> FixedState {\n        FixedState { seed: seed ^ FOLD_ARBITRARY3 }\n    }\n}\n\n// mvs: FixedState::build_hasher\nimpl BuildHasher for FixedState {\n    type Hasher = FoldHasher;\n\n    fn build_hasher(&self) -> FoldHasher {\n        FoldHasher::with_seeds(self.seed, FoldSeeds::fixed())\n    }\n}\n\nimpl Default for FixedState {\n    fn default() -> FixedState {\n        FixedState::new()\n    }\n}\n\n// UNSAFE: the OS's random bytes, for RandomState's seeds.\n// SAFETY: getentropy fills the len (at most 256) bytes at buf, and returns\n// 0, or -1 with nothing promised of them. Its one caller passes an\n// array's pointer and length.\nextern \"C\" {\n    #[link_name = \"getentropy\"]\n");
    buf_str(out, c"    #[effects(io)]\n    fn c_getentropy(buf: *mut u8, len: usize) -> i32;\n}\n\n// 8 random bytes from the OS, as a u64.\nfn entropy() -> u64 {\n    let mut b: [u8; 8] = [0; 8];\n    // UNSAFE: the OS's getentropy.\n    // SAFETY: b is a local array of 8 writable bytes, borrowed for the\n    // call; 8 is within getentropy's 256.\n    let r = unsafe { c_getentropy(b.as_mut_ptr(), 8) };\n    if r != 0 {\n        let msg: &str = \"hash: the system gives no random bytes\";\n        crate::panic::panic(msg);\n    }\n    read_le(&b[..], 0, 8)\n}\n\n// foldhash seeded from the OS when it is made: not deterministic, so\n// never a default (decision 2).\n#[derive(Clone, Copy, Debug)]\npub struct RandomState {\n    seed: u64,\n    seeds: FoldSeeds,\n}\n\nimpl RandomState {\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn new() -> RandomState {\n        let seed = entropy();\n        RandomState { seed: seed, seeds: FoldSeeds::from_u64(entropy()) }\n    }\n}\n\n// mvs: RandomState::build_hasher\nimpl BuildHasher for RandomState {\n    type Hasher = FoldHasher;\n\n    fn build_hasher(&self) -> FoldHasher {\n        FoldHasher::with_seeds(self.seed, self.seeds)\n    }\n}\n\n// SipHash-1-3 with fixed keys (Rust's DefaultHasher's function, which is\n// SipHashState::with_keys(0, 0)), for tables that take untrusted keys\n// and want a keyed hash.\n#[derive(Clone, Copy, Debug)]\npub struct SipHashState {\n    k0: u64,\n    k1: u64,\n}\n\nimpl SipHashState {\n    #[effects()]\n    pub fn new() -> SipHashState {\n        SipHashState { k0: 0, k1: 0 }\n    }\n\n    #[effects()]\n    pub fn with_keys(k0: u64, k1: u64) -> SipHashState {\n        SipHashState { k0: k0, k1: k1 }\n    }\n}\n\n// mvs: SipHashState::build_hasher\nimpl BuildHasher for SipHashState {\n    type Hasher = SipHasher13;\n\n    fn build_hasher(&self) -> SipHasher13 {\n        SipHasher13::new_with_keys(self.k0, self.k1)\n    }\n}\n\n");
    buf_str(out, c"// foldhash (Orson Peters'), the default hasher's function: the foldhash\n// crate's (0.2) fast FoldHasher, bit for bit. An integer costs one\n// multiply at finish; integers written in a row share it, 128 bits at a\n// time (the sponge). Bytes are read 8 at a time, 16 to a multiply, with\n// overlapping reads at the ends, after a rotation of the state by their\n// length.\n#[derive(Clone, Debug)]\npub struct FoldHasher {\n    accumulator: u64,\n    // foldhash's 128-bit sponge, as two halves (vole has no u128).\n    sponge_lo: u64,\n    sponge_hi: u64,\n    sponge_len: u8,\n    seeds: FoldSeeds,\n}\n\n// The six seeds foldhash mixes with (its SharedSeed).\n#[derive(Clone, Copy, Debug)]\npub struct FoldSeeds {\n    s0: u64,\n    s1: u64,\n    s2: u64,\n    s3: u64,\n    s4: u64,\n    s5: u64,\n}\n\nimpl FoldSeeds {\n    // foldhash's fixed seeds.\n    #[effects()]\n    pub fn fixed() -> FoldSeeds {\n        FoldSeeds {\n            s0: 0xc0ac29b7c97c50dd,\n            s1: 0x3f84d5b5b5470917,\n            s2: 0x9216d5d98979fb1b,\n            s3: 0xd1310ba698dfb5ac,\n            s4: 0x2ffd72dbd01adfb7,\n            s5: 0xb8e1afed6a267e96,\n        }\n    }\n\n    // The seeds made from one u64 (foldhash's SharedSeed::from_u64).\n    #[effects()]\n    pub fn from_u64(seed: u64) -> FoldSeeds {\n        let a = fold_mix3(seed);\n        let b = fold_mix3(a);\n        let c = fold_mix3(b);\n        let d = fold_mix3(c);\n        let e = fold_mix3(d);\n        let f = fold_mix3(e);\n        // zeros are the multiply's weak point: some bits forced on\n        let ones: u64 = 0x8000000080000001;\n        FoldSeeds {\n            s0: a | ones,\n            s1: b | ones,\n            s2: c | ones,\n            s3: d | ones,\n            s4: e | ones,\n            s5: f | ones,\n        }\n    }\n}\n\nfn fold_mix3(x: u64) -> u64 {\n    fold_mul(fold_mul(fold_mul(x, FOLD_ARBITRARY5), FOLD_ARBITRARY5), FOLD_ARBITRARY5)\n}\n\n");
    buf_str(out, c"// foldhash's hash of 0 to 16 bytes into the accumulator.\nfn fold_bytes_short(b: &[u8], acc: u64, s1: u64) -> u64 {\n    let n = b.len();\n    let mut x = acc;\n    let mut y = s1;\n    if n >= 8 {\n        x ^= read_le(b, 0, 8);\n        y ^= read_le(b, n - 8, 8);\n    } else if n >= 4 {\n        x ^= read_le(b, 0, 4);\n        y ^= read_le(b, n - 4, 4);\n    } else if n > 0 {\n        x ^= b[0] as u64;\n        y ^= ((b[n - 1] as u64) << 8) | b[n / 2] as u64;\n    }\n    fold_mul(x, y)\n}\n\n// foldhash's hash of more than 16 bytes into the accumulator.\nfn fold_bytes_long(bytes: &[u8], acc: u64, seeds: FoldSeeds) -> u64 {\n    let k = seeds.s0;\n    // what is left is bytes[at..]: n bytes from at (a reslice `v = &v[96..]`\n    // would do, once the borrow checker takes it)\n    let mut at: usize = 0;\n    let mut n = bytes.len();\n    let v = bytes;\n    let mut s0 = acc;\n    let mut s1 = acc.wrapping_add(seeds.s1);\n    if n > 128 {\n        let mut s2 = acc.wrapping_add(seeds.s2);\n        let mut s3 = acc.wrapping_add(seeds.s3);\n        if n > 256 {\n            let mut s4 = acc.wrapping_add(seeds.s4);\n            let mut s5 = acc.wrapping_add(seeds.s5);\n            loop {\n                s0 = fold_mul(read_le(v, at, 8) ^ s0, read_le(v, at + 48, 8) ^ k);\n                s1 = fold_mul(read_le(v, at + 8, 8) ^ s1, read_le(v, at + 56, 8) ^ k);\n                s2 = fold_mul(read_le(v, at + 16, 8) ^ s2, read_le(v, at + 64, 8) ^ k);\n                s3 = fold_mul(read_le(v, at + 24, 8) ^ s3, read_le(v, at + 72, 8) ^ k);\n                s4 = fold_mul(read_le(v, at + 32, 8) ^ s4, read_le(v, at + 80, 8) ^ k);\n                s5 = fold_mul(read_le(v, at + 40, 8) ^ s5, read_le(v, at + 88, 8) ^ k);\n                at += 96;\n                n -= 96;\n                if n <= 256 {\n                    break;\n                }\n            }\n            s0 ^= s4;\n            s1 ^= s5;\n        }\n        loop {\n");
    buf_str(out, c"            s0 = fold_mul(read_le(v, at, 8) ^ s0, read_le(v, at + 32, 8) ^ k);\n            s1 = fold_mul(read_le(v, at + 8, 8) ^ s1, read_le(v, at + 40, 8) ^ k);\n            s2 = fold_mul(read_le(v, at + 16, 8) ^ s2, read_le(v, at + 48, 8) ^ k);\n            s3 = fold_mul(read_le(v, at + 24, 8) ^ s3, read_le(v, at + 56, 8) ^ k);\n            at += 64;\n            n -= 64;\n            if n <= 128 {\n                break;\n            }\n        }\n        s0 ^= s2;\n        s1 ^= s3;\n    }\n    let e = at + n;\n    s0 = fold_mul(read_le(v, at, 8) ^ s0, read_le(v, e - 16, 8) ^ k);\n    s1 = fold_mul(read_le(v, at + 8, 8) ^ s1, read_le(v, e - 8, 8) ^ k);\n    if n >= 32 {\n        s0 = fold_mul(read_le(v, at + 16, 8) ^ s0, read_le(v, e - 32, 8) ^ k);\n        s1 = fold_mul(read_le(v, at + 24, 8) ^ s1, read_le(v, e - 24, 8) ^ k);\n        if n >= 64 {\n            s0 = fold_mul(read_le(v, at + 32, 8) ^ s0, read_le(v, e - 48, 8) ^ k);\n            s1 = fold_mul(read_le(v, at + 40, 8) ^ s1, read_le(v, e - 40, 8) ^ k);\n            if n >= 96 {\n                s0 = fold_mul(read_le(v, at + 48, 8) ^ s0, read_le(v, e - 64, 8) ^ k);\n                s1 = fold_mul(read_le(v, at + 56, 8) ^ s1, read_le(v, e - 56, 8) ^ k);\n            }\n        }\n    }\n    s0 ^ s1\n}\n\nimpl FoldHasher {\n    // A hasher with the per-hasher seed and the shared seeds.\n    #[effects()]\n    pub fn with_seeds(seed: u64, seeds: FoldSeeds) -> FoldHasher {\n        FoldHasher { accumulator: seed, sponge_lo: 0, sponge_hi: 0, sponge_len: 0, seeds: seeds }\n    }\n\n    // bits bits of x into the sponge, multiplied in when it is full.\n    fn write_num(&mut self, x: u64, bits: usize) {\n        let len = self.sponge_len as usize;\n        if len + bits > 128 {\n            self.accumulator =\n                fold_mul(self.sponge_lo ^ self.accumulator, self.sponge_hi ^ self.seeds.s0);\n            self.sponge_lo = x;\n            self.sponge_hi = 0;\n            self.sponge_len = bits as u8;\n");
    buf_str(out, c"        } else {\n            if len < 64 {\n                self.sponge_lo |= x << len as u64;\n                if len > 0 && len + bits > 64 {\n                    self.sponge_hi |= x >> (64 - len) as u64;\n                }\n            } else {\n                self.sponge_hi |= x << (len - 64) as u64;\n            }\n            self.sponge_len = (len + bits) as u8;\n        }\n    }\n}\n\n// mvs: FoldHasher::write, FoldHasher::finish, FoldHasher::write_u8, FoldHasher::write_u16, FoldHasher::write_u32, FoldHasher::write_u64, FoldHasher::write_i64\n// std: changed: the Hasher trait's methods (MVS: inherent)\nimpl Hasher for FoldHasher {\n    fn finish(&self) -> u64 {\n        if self.sponge_len > 0 {\n            fold_mul(self.sponge_lo ^ self.accumulator, self.sponge_hi ^ self.seeds.s0)\n        } else {\n            self.accumulator\n        }\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        let acc = rotate_right(self.accumulator, bytes.len());\n        if bytes.len() <= 16 {\n            self.accumulator = fold_bytes_short(bytes, acc, self.seeds.s1);\n        } else {\n            self.accumulator = fold_bytes_long(bytes, acc, self.seeds);\n        }\n    }\n\n    fn write_u8(&mut self, i: u8) {\n        self.write_num(i as u64, 8);\n    }\n\n    fn write_u16(&mut self, i: u16) {\n        self.write_num(i as u64, 16);\n    }\n\n    fn write_u32(&mut self, i: u32) {\n        self.write_num(i as u64, 32);\n    }\n\n    fn write_u64(&mut self, i: u64) {\n        self.write_num(i, 64);\n    }\n\n    fn write_usize(&mut self, i: usize) {\n        self.write_num(i as u64, 64);\n    }\n}\n\n// Rust's std::hash::DefaultHasher: SipHash-1-3 with the keys 0 and 0,\n// the same hash in every run.\n#[derive(Clone, Debug)]\npub struct DefaultHasher(SipHasher13);\n\nimpl DefaultHasher {\n    #[effects()]\n    pub fn new() -> DefaultHasher {\n        DefaultHasher(SipHasher13::new_with_keys(0, 0))\n    }\n}\n\nimpl Default for DefaultHasher {\n");
    buf_str(out, c"    fn default() -> DefaultHasher {\n        DefaultHasher::new()\n    }\n}\n\nimpl Hasher for DefaultHasher {\n    fn finish(&self) -> u64 {\n        self.0.finish()\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        self.0.write(bytes)\n    }\n}\n\n// SipHash-1-3 (Aumasson and Bernstein): Rust's DefaultHasher's function,\n// bit for bit. Bytes and integers are one stream: writing a u64 is\n// writing its 8 bytes, little-endian (the Hasher defaults).\n#[derive(Clone, Debug)]\npub struct SipHasher13 {\n    v0: u64,\n    v1: u64,\n    v2: u64,\n    v3: u64,\n    // the bytes after the last full 8, little-endian, and their count\n    tail: u64,\n    ntail: usize,\n    // all the bytes written\n    length: usize,\n}\n\nimpl SipHasher13 {\n    #[effects()]\n    pub fn new_with_keys(k0: u64, k1: u64) -> SipHasher13 {\n        SipHasher13 {\n            v0: k0 ^ 0x736f6d6570736575,\n            v1: k1 ^ 0x646f72616e646f6d,\n            v2: k0 ^ 0x6c7967656e657261,\n            v3: k1 ^ 0x7465646279746573,\n            tail: 0,\n            ntail: 0,\n            length: 0,\n        }\n    }\n\n    // One SipRound.\n    fn round(&mut self) {\n        self.v0 = self.v0.wrapping_add(self.v1);\n        self.v1 = rotate_left(self.v1, 13);\n        self.v1 ^= self.v0;\n        self.v0 = rotate_left(self.v0, 32);\n        self.v2 = self.v2.wrapping_add(self.v3);\n        self.v3 = rotate_left(self.v3, 16);\n        self.v3 ^= self.v2;\n        self.v0 = self.v0.wrapping_add(self.v3);\n        self.v3 = rotate_left(self.v3, 21);\n        self.v3 ^= self.v0;\n        self.v2 = self.v2.wrapping_add(self.v1);\n        self.v1 = rotate_left(self.v1, 17);\n        self.v1 ^= self.v2;\n        self.v2 = rotate_left(self.v2, 32);\n    }\n\n    // The message word m, compressed in (one round: SipHash-1-3).\n    fn compress(&mut self, m: u64) {\n        self.v3 ^= m;\n        self.round();\n        self.v0 ^= m;\n    }\n}\n\n");
    buf_str(out, c"// mvs: SipHasher13::write, SipHasher13::finish, SipHasher13::write_u8, SipHasher13::write_u16, SipHasher13::write_u32, SipHasher13::write_u64, SipHasher13::write_i64\n// std: changed: the Hasher trait's methods (MVS: inherent)\nimpl Hasher for SipHasher13 {\n    // The hash of what was written (the hasher is unchanged).\n    fn finish(&self) -> u64 {\n        let mut s = self.clone();\n        let b = (((self.length as u64) & 0xff) << 56) | self.tail;\n        s.compress(b);\n        s.v2 ^= 0xff;\n        s.round();\n        s.round();\n        s.round();\n        s.v0 ^ s.v1 ^ s.v2 ^ s.v3\n    }\n\n    fn write(&mut self, bytes: &[u8]) {\n        let n = bytes.len();\n        self.length += n;\n        let mut i: usize = 0;\n        if self.ntail != 0 {\n            let needed = 8 - self.ntail;\n            let take = if n < needed { n } else { needed };\n            self.tail |= read_le(bytes, 0, take) << (8 * self.ntail) as u64;\n            if n < needed {\n                self.ntail += n;\n                return;\n            }\n            let t = self.tail;\n            self.compress(t);\n            self.ntail = 0;\n            i = needed;\n        }\n        while n - i >= 8 {\n            self.compress(read_le(bytes, i, 8));\n            i += 8;\n        }\n        self.tail = read_le(bytes, i, n - i);\n        self.ntail = n - i;\n    }\n}\n\n// A reference hashes as what it refers to.\nimpl<T: Hash + ?Sized> Hash for &T {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (**self).hash(state)\n    }\n}\n\nimpl<T: Hash + ?Sized> Hash for &mut T {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (**self).hash(state)\n    }\n}\n\nimpl Hash for () {\n    fn hash<H: Hasher>(&self, state: &mut H) {}\n}\n\n// A tuple hashes its fields in order, as Rust's.\nimpl<A: Hash> Hash for (A,) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash> Hash for (A, B) {\n");
    buf_str(out, c"    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash> Hash for (A, B, C) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash, D: Hash> Hash for (A, B, C, D) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n        self.3.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash> Hash for (A, B, C, D, E) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n        self.3.hash(state);\n        self.4.hash(state);\n    }\n}\n\nimpl<A: Hash, B: Hash, C: Hash, D: Hash, E: Hash, F: Hash> Hash for (A, B, C, D, E, F) {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.0.hash(state);\n        self.1.hash(state);\n        self.2.hash(state);\n        self.3.hash(state);\n        self.4.hash(state);\n        self.5.hash(state);\n    }\n}\n// ---- end mod std::hash ----\n}\n// ---- mod std::collections ----\npub mod collections {\n// std::collections: HashMap, HashSet, BTreeMap, BTreeSet, BinaryHeap and\n// MinHeap.\n\npub mod binary_heap;\npub mod btree_map;\npub mod hash_map;\npub mod hash_set;\n\npub use binary_heap::{BinaryHeap, MinHeap};\npub use btree_map::{BTreeMap, BTreeSet};\npub use hash_map::HashMap;\npub use hash_set::HashSet;\n\n// (Rust's place for it; it is defined in std::alloc, which every program\n// reads: this module is read only by a program that names `collections`)\npub use crate::alloc::TryReserveError;\n// ---- mod std::collections::binary_heap ----\npub mod binary_heap {\n// std::collections::binary_heap (0.18.1; std 0.28.0): priority queues in\n// a Vec. `BinaryHeap` is Rust's, a max-heap: `pop` takes the largest\n");
    buf_str(out, c"// element first. `MinHeap`, vole's own, has the same API and takes the\n// smallest first (Rust spells it `BinaryHeap<Reverse<T>>`, which works\n// too). `push` and `pop` are O(log n), building one from a Vec O(n).\n// mvs: std::BinaryHeap, std::MinHeap\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::cmp::Ord;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Formatter};\nuse crate::iter::{Extend, IntoIterator, Iterator};\nuse crate::option::Option;\nuse crate::slice::Iter;\nuse crate::vec::Vec;\n\n// (The helpers are named heap_*: the lazy std reads items by name, and a\n// free `push` or `sort` here would be read by every program.)\n\n// Which of two elements a heap keeps nearer the root.\ntrait HeapOrder {\n    fn above<T: Ord>(a: &T, b: &T) -> bool;\n}\n\nstruct HeapMax {}\n\nstruct HeapMin {}\n\nimpl HeapOrder for HeapMax {\n    #[inline]\n    fn above<T: Ord>(a: &T, b: &T) -> bool {\n        *a > *b\n    }\n}\n\nimpl HeapOrder for HeapMin {\n    #[inline]\n    fn above<T: Ord>(a: &T, b: &T) -> bool {\n        *a < *b\n    }\n}\n\n// Moves v[i] towards the root while it is above its parent.\nfn sift_up<T: Ord, O: HeapOrder>(v: &mut [T], i: usize) {\n    let mut i = i;\n    while i > 0 {\n        let parent = (i - 1) / 2;\n        if !O::above(&v[i], &v[parent]) {\n            break;\n        }\n        v.swap(i, parent);\n        i = parent;\n    }\n}\n\n// Moves v[i] down while a child of it in v[..end] is above it.\nfn sift_down<T: Ord, O: HeapOrder>(v: &mut [T], i: usize, end: usize) {\n    let mut i = i;\n    loop {\n        let mut child = 2 * i + 1;\n        if child >= end {\n            break;\n        }\n        if child + 1 < end && O::above(&v[child + 1], &v[child]) {\n            child += 1;\n        }\n        if !O::above(&v[child], &v[i]) {\n            break;\n        }\n        v.swap(i, child);\n        i = child;\n    }\n}\n\n// Makes v a heap, in O(n).\nfn heap_build<T: Ord, O: HeapOrder>(v: &mut [T]) {\n");
    buf_str(out, c"    let n = v.len();\n    let mut k = n / 2;\n    while k > 0 {\n        k -= 1;\n        sift_down::<T, O>(v, k, n);\n    }\n}\n\nfn heap_push<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>, x: T) {\n    v.push(x);\n    let n = v.len();\n    sift_up::<T, O>(v.as_mut_slice(), n - 1);\n}\n\nfn heap_pop<T: Ord, O: HeapOrder, A: Allocator>(v: &mut Vec<T, A>) -> Option<T> {\n    let n = v.len();\n    if n == 0 {\n        return Option::None;\n    }\n    v.as_mut_slice().swap(0, n - 1);\n    let top = v.pop();\n    sift_down::<T, O>(v.as_mut_slice(), 0, n - 1);\n    top\n}\n\n// The heap in v sorted in place: the root's end of the order last.\nfn heap_sort<T: Ord, O: HeapOrder>(v: &mut [T]) {\n    let mut end = v.len();\n    while end > 1 {\n        end -= 1;\n        v.swap(0, end);\n        sift_down::<T, O>(v, 0, end);\n    }\n}\n\n// A max-heap on allocator A.\npub struct BinaryHeap<T: Ord, A: Allocator> {\n    data: Vec<T, A>,\n}\n\n// A min-heap on allocator A, BinaryHeap's API with the order reversed.\n// std: kept: vole's own (Rust: BinaryHeap<Reverse<T>>)\npub struct MinHeap<T: Ord, A: Allocator> {\n    data: Vec<T, A>,\n}\n\nimpl<T: Ord, A: Allocator> BinaryHeap<T, A> {\n    // An empty heap.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::new_in(a) }\n    }\n\n    // An empty heap with room for cap elements.\n    #[effects(T, A)]\n    pub fn with_capacity_in(cap: usize, a: A) -> BinaryHeap<T, A> {\n        BinaryHeap { data: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A heap of v's elements, in O(n), on v's memory (Rust's\n    // `BinaryHeap::from(v)`).\n    #[effects(T, A)]\n    pub fn from_vec(v: Vec<T, A>) -> BinaryHeap<T, A> {\n        let mut data = v;\n        heap_build::<T, HeapMax>(data.as_mut_slice());\n        BinaryHeap { data: data }\n    }\n\n    #[effects(T, A)]\n    pub fn len(&self) -> usize {\n        self.data.len()\n    }\n\n    #[effects(T, A)]\n");
    buf_str(out, c"    pub fn is_empty(&self) -> bool {\n        self.data.len() == 0\n    }\n\n    // Adds x, in O(log n).\n    #[effects(T, A)]\n    pub fn push(&mut self, x: T) {\n        heap_push::<T, HeapMax, A>(&mut self.data, x);\n    }\n\n    // Takes the largest element out (None when empty), in O(log n).\n    #[effects(T, A)]\n    pub fn pop(&mut self) -> Option<T> {\n        heap_pop::<T, HeapMax, A>(&mut self.data)\n    }\n\n    // The largest element, which stays.\n    // std: changed: Option<&T> (MVS: a copy)\n    #[effects(T, A)]\n    pub fn peek(&self) -> Option<&T> {\n        self.data.first()\n    }\n\n    // Drops the elements; the room stays.\n    #[effects(T, A)]\n    pub fn clear(&mut self) {\n        self.data.clear();\n    }\n\n    #[effects(T, A)]\n    pub fn capacity(&self) -> usize {\n        self.data.capacity()\n    }\n\n    // Room for extra more elements.\n    pub fn reserve(&mut self, extra: usize) {\n        self.data.reserve(extra);\n    }\n\n    // Its allocator.\n    // std: changed: a &A (MVS: a copy)\n    pub fn allocator(&self) -> &A {\n        self.data.allocator()\n    }\n\n    // Its elements in heap order (the largest first, the rest in no useful\n    // order).\n    pub fn as_slice(&self) -> &[T] {\n        self.data.as_slice()\n    }\n\n    // Its elements, in heap order.\n    #[effects(T, A)]\n    pub fn iter(&self) -> Iter<'_, T> {\n        self.data.iter()\n    }\n\n    // Its elements in a Vec, in heap order, on the same memory.\n    pub fn into_vec(self) -> Vec<T, A> {\n        self.data\n    }\n\n    // Its elements in a Vec, smallest first, on the same memory: a\n    // heapsort, in O(n log n).\n    #[effects(T, A)]\n    pub fn into_sorted_vec(self) -> Vec<T, A> {\n        let mut v = self.data;\n        heap_sort::<T, HeapMax>(v.as_mut_slice());\n        v\n    }\n\n    // Moves other's elements into it, leaving other empty.\n    #[effects(diverge, T, A)]\n    pub fn append(&mut self, other: &mut BinaryHeap<T, A>) {\n");
    buf_str(out, c"        while let Option::Some(x) = other.data.pop() {\n            self.push(x);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> MinHeap<T, A> {\n    // An empty heap.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> MinHeap<T, A> {\n        MinHeap { data: Vec::new_in(a) }\n    }\n\n    // An empty heap with room for cap elements.\n    pub fn with_capacity_in(cap: usize, a: A) -> MinHeap<T, A> {\n        MinHeap { data: Vec::with_capacity_in(cap, a) }\n    }\n\n    // A heap of v's elements, in O(n), on v's memory.\n    #[effects(T, A)]\n    pub fn from_vec(v: Vec<T, A>) -> MinHeap<T, A> {\n        let mut data = v;\n        heap_build::<T, HeapMin>(data.as_mut_slice());\n        MinHeap { data: data }\n    }\n\n    #[effects(T, A)]\n    pub fn len(&self) -> usize {\n        self.data.len()\n    }\n\n    pub fn is_empty(&self) -> bool {\n        self.data.len() == 0\n    }\n\n    // Adds x, in O(log n).\n    #[effects(T, A)]\n    pub fn push(&mut self, x: T) {\n        heap_push::<T, HeapMin, A>(&mut self.data, x);\n    }\n\n    // Takes the smallest element out (None when empty), in O(log n).\n    #[effects(T, A)]\n    pub fn pop(&mut self) -> Option<T> {\n        heap_pop::<T, HeapMin, A>(&mut self.data)\n    }\n\n    // The smallest element, which stays.\n    // std: changed: Option<&T> (MVS: a copy)\n    #[effects(T, A)]\n    pub fn peek(&self) -> Option<&T> {\n        self.data.first()\n    }\n\n    // Drops the elements; the room stays.\n    pub fn clear(&mut self) {\n        self.data.clear();\n    }\n\n    pub fn capacity(&self) -> usize {\n        self.data.capacity()\n    }\n\n    // Room for extra more elements.\n    pub fn reserve(&mut self, extra: usize) {\n        self.data.reserve(extra);\n    }\n\n    // Its allocator.\n    // std: changed: a &A (MVS: a copy)\n    pub fn allocator(&self) -> &A {\n        self.data.allocator()\n    }\n\n    // Its elements in heap order (the smallest first, the rest in no\n    // useful order).\n");
    buf_str(out, c"    pub fn as_slice(&self) -> &[T] {\n        self.data.as_slice()\n    }\n\n    // Its elements, in heap order.\n    pub fn iter(&self) -> Iter<'_, T> {\n        self.data.iter()\n    }\n\n    // Its elements in a Vec, in heap order, on the same memory.\n    pub fn into_vec(self) -> Vec<T, A> {\n        self.data\n    }\n\n    // Its elements in a Vec, smallest first (as BinaryHeap's), on the same\n    // memory, in O(n log n).\n    #[effects(T, A)]\n    pub fn into_sorted_vec(self) -> Vec<T, A> {\n        let mut v = self.data;\n        heap_sort::<T, HeapMin>(v.as_mut_slice());\n        v.as_mut_slice().reverse();\n        v\n    }\n\n    // Moves other's elements into it, leaving other empty.\n    pub fn append(&mut self, other: &mut MinHeap<T, A>) {\n        while let Option::Some(x) = other.data.pop() {\n            self.push(x);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> From<Vec<T, A>> for BinaryHeap<T, A> {\n    fn from(v: Vec<T, A>) -> BinaryHeap<T, A> {\n        BinaryHeap::from_vec(v)\n    }\n}\n\nimpl<T: Ord, A: Allocator> From<Vec<T, A>> for MinHeap<T, A> {\n    fn from(v: Vec<T, A>) -> MinHeap<T, A> {\n        MinHeap::from_vec(v)\n    }\n}\n\nimpl<T: Ord, A: Allocator> Extend<T> for BinaryHeap<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n        }\n    }\n}\n\nimpl<T: Ord, A: Allocator> Extend<T> for MinHeap<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n        }\n    }\n}\n\n// A copy on the same allocator.\nimpl<T: Ord + Clone, A: Allocator + Clone> Clone for BinaryHeap<T, A> {\n    fn clone(&self) -> BinaryHeap<T, A> {\n        BinaryHeap { data: self.data.clone() }\n    }\n}\n\nimpl<T: Ord + Clone, A: Allocator + Clone> Clone for MinHeap<T, A> {\n    fn clone(&self) -> MinHeap<T, A> {\n        MinHeap { data: self.data.clone() }\n    }\n}\n\n");
    buf_str(out, c"// Its elements in heap order, as a list (Rust's).\nimpl<T: Ord + Debug, A: Allocator> Debug for BinaryHeap<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.data.as_slice(), f)\n    }\n}\n\nimpl<T: Ord + Debug, A: Allocator> Debug for MinHeap<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.data.as_slice(), f)\n    }\n}\n\n// `for x in &heap`: its elements, in heap order.\nimpl<'a, T: Ord, A: Allocator> IntoIterator for &'a BinaryHeap<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.data.iter()\n    }\n}\n\nimpl<'a, T: Ord, A: Allocator> IntoIterator for &'a MinHeap<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.data.iter()\n    }\n}\n// ---- end mod std::collections::binary_heap ----\n}\n// ---- mod std::collections::btree_map ----\npub mod btree_map {\n// std::collections::btree_map (0.15.4; std 0.28.0): `BTreeMap`, a map\n// that keeps its keys sorted, and `BTreeSet` over it. Rust's API with the\n// allocator named: `BTreeMap::new_in(a)`. A B-tree: a node holds 5 to 11\n// keys (the root 1 to 11) in order and, when it is not a leaf, one child\n// more than keys; every leaf is at the same depth. The nodes live in one\n// Vec and name each other by index, so the whole map is safe code and one\n// allocation that grows; a slot is `Option`, None when it is unused.\n// `get`, `insert` and `remove` are O(log n); `iter` and `range` visit the\n// keys in order, from either end.\n//\n// Not Rust's: `range` gives the type `iter` gives (BTreeIter), `entry`'s\n// types are BTreeEntry, BTreeOccupiedEntry and BTreeVacantEntry, and there\n// is no `iter_mut`, `values_mut`, `retain`, `append`, `split_off` or\n// cursor yet; a set has no `union`, `intersection` or `difference` yet.\n");
    buf_str(out, c"// (The names carry `BTree`: the lazy std reads items by name, and an\n// `Iter` or an `Entry` here would be read with HashMap's.)\n// mvs: std::BTreeMap, std::BTreeSet\n\nuse crate::alloc::Allocator;\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::iter::{DoubleEndedIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::ops::{Bound, Index, RangeBounds};\nuse crate::option::Option;\nuse crate::vec::Vec;\n\n// The keys a node holds at most, and at least (but the root).\nconst B_CAP: usize = 11;\nconst B_MIN: usize = 5;\n// No node: an empty map's root, the end of the free list.\nconst B_NONE: u32 = 0xffffffff;\n\n// A node: keys[..len] in order with their values, and, when it is not a\n// leaf, kids[..len + 1], the nodes around them (kids[i]'s keys are less\n// than keys[i], kids[i + 1]'s greater). The slots from len on are None.\nstruct BNode<K, V> {\n    len: usize,\n    leaf: bool,\n    keys: [Option<K>; 11],\n    vals: [Option<V>; 11],\n    kids: [u32; 12],\n}\n\nfn b_node<K, V>(leaf: bool) -> BNode<K, V> {\n    BNode {\n        len: 0,\n        leaf: leaf,\n        keys: [None, None, None, None, None, None, None, None, None, None, None],\n        vals: [None, None, None, None, None, None, None, None, None, None, None],\n        kids: [B_NONE; 12],\n    }\n}\n\n// How a lookup's key compares with a map's: a K itself (BDirect), or the Q\n// that K lends (BBorrowed: a `&str` for String keys). Two types with one\n// method, not K's Borrow alone: a lookup by the key's own type would ask\n// for `K: Borrow<K>`, which the front resolves to `&T: Borrow<T>` for a K\n// that is a reference.\ntrait BCompare<K> {\n    fn order(&self, k: &K) -> Ordering;\n}\n\nstruct BDirect<'a, K> {\n    key: &'a K,\n}\n\nimpl<'a, K: Ord> BCompare<K> for BDirect<'a, K> {\n    #[inline]\n    fn order(&self, k: &K) -> Ordering {\n");
    buf_str(out, c"        self.key.cmp(k)\n    }\n}\n\nstruct BBorrowed<'a, Q: ?Sized> {\n    key: &'a Q,\n}\n\nimpl<'a, K: Borrow<Q>, Q: ?Sized + Ord> BCompare<K> for BBorrowed<'a, Q> {\n    #[inline]\n    fn order(&self, k: &K) -> Ordering {\n        self.key.cmp(<K as Borrow<Q>>::borrow(k))\n    }\n}\n\n// Where key is among node's keys: (i, true) when keys[i] is it, else\n// (i, false) with i the child to look in (the keys before i are less).\n#[inline]\nfn b_find<K, V, C: BCompare<K>>(node: &BNode<K, V>, key: &C) -> (usize, bool) {\n    let mut i = 0;\n    while i < node.len {\n        match &node.keys[i] {\n            Some(k) => match key.order(k) {\n                Ordering::Less => return (i, false),\n                Ordering::Equal => return (i, true),\n                Ordering::Greater => {}\n            },\n            None => {}\n        }\n        i += 1;\n    }\n    (i, false)\n}\n\n// A key's position: the nodes from the root down to its node, and at each\n// the child taken (at the last, the key's index). depth 0 is the end,\n// after the last key.\n#[derive(Clone, Copy)]\nstruct BCursor {\n    depth: usize,\n    node: [u32; 16],\n    at: [u8; 16],\n}\n\nfn b_end() -> BCursor {\n    BCursor { depth: 0, node: [B_NONE; 16], at: [0; 16] }\n}\n\nfn b_same(a: &BCursor, b: &BCursor) -> bool {\n    if a.depth != b.depth {\n        return false;\n    }\n    if a.depth == 0 {\n        return true;\n    }\n    let d = a.depth - 1;\n    a.node[d] == b.node[d] && a.at[d] == b.at[d]\n}\n\n// A map from K to V with its keys in order, on allocator A.\npub struct BTreeMap<K, V, A: Allocator> {\n    nodes: Vec<BNode<K, V>, A>,\n    root: u32,\n    // the first unused slot of nodes; each names the next in its kids[0]\n    free: u32,\n    len: usize,\n}\n\nimpl<K, V, A: Allocator> BTreeMap<K, V, A> {\n    // An empty map on a; allocates at the first insert.\n    #[effects(K, V, A)]\n    pub fn new_in(a: A) -> BTreeMap<K, V, A> {\n");
    buf_str(out, c"        BTreeMap { nodes: Vec::new_in(a), root: B_NONE, free: B_NONE, len: 0 }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.len\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.len == 0\n    }\n\n    #[effects(K, V, A)]\n    pub fn allocator(&self) -> &A {\n        self.nodes.allocator()\n    }\n\n    // Drops every entry; keeps the nodes' memory.\n    #[effects(K, V, A)]\n    pub fn clear(&mut self) {\n        self.nodes.clear();\n        self.root = B_NONE;\n        self.free = B_NONE;\n        self.len = 0;\n    }\n\n    // The entries in the keys' order.\n    #[effects(K, V, A)]\n    pub fn iter(&self) -> BTreeIter<'_, K, V, A> {\n        BTreeIter { map: self, front: self.cursor_first(), back: b_end() }\n    }\n\n    #[effects(K, V, A)]\n    pub fn keys(&self) -> BTreeKeys<'_, K, V, A> {\n        BTreeKeys { inner: self.iter() }\n    }\n\n    #[effects(K, V, A)]\n    pub fn values(&self) -> BTreeValues<'_, K, V, A> {\n        BTreeValues { inner: self.iter() }\n    }\n\n    // The entry with the smallest key.\n    #[effects(K, V, A)]\n    pub fn first_key_value(&self) -> Option<(&K, &V)> {\n        self.iter().next()\n    }\n\n    // The entry with the largest key.\n    #[effects(K, V, A)]\n    pub fn last_key_value(&self) -> Option<(&K, &V)> {\n        self.iter().next_back()\n    }\n\n    fn new_node(&mut self, leaf: bool) -> u32 {\n        if self.free != B_NONE {\n            let n = self.free;\n            let node = &mut self.nodes[n as usize];\n            self.free = node.kids[0];\n            node.leaf = leaf;\n            node.len = 0;\n            return n;\n        }\n        self.nodes.push(b_node(leaf));\n        (self.nodes.len() - 1) as u32\n    }\n\n    // (n's slots are None by now: its entries moved out)\n    fn free_node(&mut self, n: u32) {\n        let node = &mut self.nodes[n as usize];\n        node.kids[0] = self.free;\n        node.len = 0;\n        self.free = n;\n    }\n\n");
    buf_str(out, c"    // The entry at a cursor that is not the end.\n    fn entry_at(&self, c: &BCursor) -> (&K, &V) {\n        let d = c.depth - 1;\n        let node = &self.nodes[c.node[d] as usize];\n        let i = c.at[d] as usize;\n        (node.keys[i].as_ref().unwrap(), node.vals[i].as_ref().unwrap())\n    }\n\n    // The first key's position (the end when the map is empty).\n    fn cursor_first(&self) -> BCursor {\n        let mut c = b_end();\n        let mut n = self.root;\n        let mut d = 0;\n        while n != B_NONE {\n            c.node[d] = n;\n            c.at[d] = 0;\n            d += 1;\n            let node = &self.nodes[n as usize];\n            n = if node.leaf { B_NONE } else { node.kids[0] };\n        }\n        c.depth = d;\n        c\n    }\n\n    // c, which is not the end, moved to the next key (or the end).\n    fn cursor_next(&self, c: &mut BCursor) {\n        let d = c.depth - 1;\n        let node = &self.nodes[c.node[d] as usize];\n        let i = c.at[d] as usize;\n        if !node.leaf {\n            // the smallest key of the child after it\n            c.at[d] = (i + 1) as u8;\n            let mut n = node.kids[i + 1];\n            let mut e = d + 1;\n            while n != B_NONE {\n                c.node[e] = n;\n                c.at[e] = 0;\n                e += 1;\n                let below = &self.nodes[n as usize];\n                n = if below.leaf { B_NONE } else { below.kids[0] };\n            }\n            c.depth = e;\n            return;\n        }\n        if i + 1 < node.len {\n            c.at[d] = (i + 1) as u8;\n            return;\n        }\n        // the key after the child taken, at the nearest node that has one\n        let mut e = d;\n        while e > 0 {\n            e -= 1;\n            if (c.at[e] as usize) < self.nodes[c.node[e] as usize].len {\n                c.depth = e + 1;\n                return;\n            }\n        }\n        c.depth = 0;\n    }\n\n");
    buf_str(out, c"    // c moved to the key before it (from the end: to the last key). The\n    // caller knows there is one.\n    fn cursor_prev(&self, c: &mut BCursor) {\n        let mut n: u32;\n        let mut e: usize;\n        if c.depth == 0 {\n            n = self.root;\n            e = 0;\n        } else {\n            let d = c.depth - 1;\n            let node = &self.nodes[c.node[d] as usize];\n            let i = c.at[d] as usize;\n            if node.leaf {\n                if i > 0 {\n                    c.at[d] = (i - 1) as u8;\n                    return;\n                }\n                let mut up = d;\n                while up > 0 {\n                    up -= 1;\n                    if c.at[up] > 0 {\n                        c.at[up] -= 1;\n                        c.depth = up + 1;\n                        return;\n                    }\n                }\n                c.depth = 0;\n                return;\n            }\n            // the largest key of the child before it\n            n = node.kids[i];\n            e = d + 1;\n        }\n        while n != B_NONE {\n            let below = &self.nodes[n as usize];\n            c.node[e] = n;\n            if below.leaf {\n                c.at[e] = (below.len - 1) as u8;\n                n = B_NONE;\n            } else {\n                c.at[e] = below.len as u8;\n                n = below.kids[below.len];\n            }\n            e += 1;\n        }\n        c.depth = e;\n    }\n\n    // The by-value iterator's step: the entry at c moved out of its node.\n    fn take_at(&mut self, c: &BCursor) -> (K, V) {\n        let d = c.depth - 1;\n        let node = &mut self.nodes[c.node[d] as usize];\n        let i = c.at[d] as usize;\n        (node.keys[i].take().unwrap(), node.vals[i].take().unwrap())\n    }\n}\n\nimpl<K: Ord, V, A: Allocator> BTreeMap<K, V, A> {\n    // The node and index of key, or (B_NONE, 0).\n    fn locate<C: BCompare<K>>(&self, key: &C) -> (u32, usize) {\n        let mut n = self.root;\n");
    buf_str(out, c"        while n != B_NONE {\n            let node = &self.nodes[n as usize];\n            let (i, found) = b_find(node, key);\n            if found {\n                return (n, i);\n            }\n            n = if node.leaf { B_NONE } else { node.kids[i] };\n        }\n        (B_NONE, 0)\n    }\n\n    // The position of the first key that is not less than key (after: that\n    // is greater than key), or the end.\n    fn cursor_seek<C: BCompare<K>>(&self, key: &C, after: bool) -> BCursor {\n        let mut c = b_end();\n        let mut n = self.root;\n        let mut d = 0;\n        while n != B_NONE {\n            let node = &self.nodes[n as usize];\n            let (i, found) = b_find(node, key);\n            let i = if found && after { i + 1 } else { i };\n            c.node[d] = n;\n            c.at[d] = i as u8;\n            d += 1;\n            if found && !after {\n                c.depth = d;\n                return c;\n            }\n            n = if node.leaf { B_NONE } else { node.kids[i] };\n        }\n        // at the leaf, or the nearest node above with a key after the child\n        while d > 0 {\n            if (c.at[d - 1] as usize) < self.nodes[c.node[d - 1] as usize].len {\n                c.depth = d;\n                return c;\n            }\n            d -= 1;\n        }\n        c\n    }\n\n    // The value of key.\n    #[effects(panic, K, V, A, Q)]\n    pub fn get<Q: ?Sized + Ord>(&self, key: &Q) -> Option<&V>\n        where\n            K: Borrow<Q>,\n    {\n        let (n, i) = self.locate(&BBorrowed { key: key });\n        if n == B_NONE {\n            return None;\n        }\n        self.nodes[n as usize].vals[i].as_ref()\n    }\n\n    #[effects(panic, K, V, A, Q)]\n    pub fn get_key_value<Q: ?Sized + Ord>(&self, key: &Q) -> Option<(&K, &V)>\n        where\n            K: Borrow<Q>,\n    {\n        let (n, i) = self.locate(&BBorrowed { key: key });\n        if n == B_NONE {\n            return None;\n        }\n");
    buf_str(out, c"        let node = &self.nodes[n as usize];\n        Some((node.keys[i].as_ref().unwrap(), node.vals[i].as_ref().unwrap()))\n    }\n\n    #[effects(K, V, A, Q)]\n    pub fn contains_key<Q: ?Sized + Ord>(&self, key: &Q) -> bool\n        where\n            K: Borrow<Q>,\n    {\n        self.locate(&BBorrowed { key: key }).0 != B_NONE\n    }\n\n    #[effects(panic, K, V, A, Q)]\n    pub fn get_mut<Q: ?Sized + Ord>(&mut self, key: &Q) -> Option<&mut V>\n        where\n            K: Borrow<Q>,\n    {\n        let (n, i) = self.locate(&BBorrowed { key: key });\n        if n == B_NONE {\n            return None;\n        }\n        self.nodes[n as usize].vals[i].as_mut()\n    }\n\n    // Child i of p, which is full, split in two around its middle key,\n    // which moves up into p (p is not full).\n    fn split_child(&mut self, p: u32, i: usize) {\n        let c = self.nodes[p as usize].kids[i];\n        let leaf = self.nodes[c as usize].leaf;\n        let r = self.new_node(leaf);\n        let mut j = 0;\n        while j < B_MIN {\n            let k = self.nodes[c as usize].keys[j + B_MIN + 1].take();\n            let v = self.nodes[c as usize].vals[j + B_MIN + 1].take();\n            self.nodes[r as usize].keys[j] = k;\n            self.nodes[r as usize].vals[j] = v;\n            j += 1;\n        }\n        if !leaf {\n            j = 0;\n            while j <= B_MIN {\n                let kid = self.nodes[c as usize].kids[j + B_MIN + 1];\n                self.nodes[r as usize].kids[j] = kid;\n                j += 1;\n            }\n        }\n        self.nodes[r as usize].len = B_MIN;\n        let left = &mut self.nodes[c as usize];\n        left.len = B_MIN;\n        let mk = left.keys[B_MIN].take();\n        let mv = left.vals[B_MIN].take();\n        let up = &mut self.nodes[p as usize];\n        j = up.len;\n        while j > i {\n            up.keys[j] = up.keys[j - 1].take();\n            up.vals[j] = up.vals[j - 1].take();\n");
    buf_str(out, c"            up.kids[j + 1] = up.kids[j];\n            j -= 1;\n        }\n        up.keys[i] = mk;\n        up.vals[i] = mv;\n        up.kids[i + 1] = r;\n        up.len += 1;\n    }\n\n    // insert, which also says where the entry is: its node and index.\n    fn insert_at(&mut self, key: K, value: V) -> (u32, usize, Option<V>) {\n        if self.root == B_NONE {\n            let r = self.new_node(true);\n            self.root = r;\n        } else if self.nodes[self.root as usize].len == B_CAP {\n            let r = self.new_node(false);\n            self.nodes[r as usize].kids[0] = self.root;\n            self.root = r;\n            self.split_child(r, 0);\n        }\n        let mut n = self.root;\n        loop {\n            let (i, found) = b_find(&self.nodes[n as usize], &BDirect { key: &key });\n            if found {\n                let old = self.nodes[n as usize].vals[i].replace(value);\n                return (n, i, old);\n            }\n            if self.nodes[n as usize].leaf {\n                let node = &mut self.nodes[n as usize];\n                let mut j = node.len;\n                while j > i {\n                    node.keys[j] = node.keys[j - 1].take();\n                    node.vals[j] = node.vals[j - 1].take();\n                    j -= 1;\n                }\n                node.keys[i] = Some(key);\n                node.vals[i] = Some(value);\n                node.len += 1;\n                self.len += 1;\n                return (n, i, None);\n            }\n            let mut c = self.nodes[n as usize].kids[i];\n            if self.nodes[c as usize].len == B_CAP {\n                // a full child is split on the way down, so that a split\n                // below it has room here\n                self.split_child(n, i);\n                let node = &self.nodes[n as usize];\n                let (at, same) = b_find(node, &BDirect { key: &key });\n                if same {\n");
    buf_str(out, c"                    let old = self.nodes[n as usize].vals[at].replace(value);\n                    return (n, at, old);\n                }\n                c = node.kids[at];\n            }\n            n = c;\n        }\n    }\n\n    // Sets key's value; the value it had.\n    #[effects(unsafe, K, V, A)]\n    pub fn insert(&mut self, key: K, value: V) -> Option<V> {\n        self.insert_at(key, value).2\n    }\n\n    // Children i and i + 1 of p, each with the fewest keys, made one node\n    // (child i) around p's key i, which moves down.\n    fn merge(&mut self, p: u32, i: usize) {\n        let l = self.nodes[p as usize].kids[i];\n        let r = self.nodes[p as usize].kids[i + 1];\n        let up = &mut self.nodes[p as usize];\n        let mk = up.keys[i].take();\n        let mv = up.vals[i].take();\n        let mut j = i;\n        while j + 1 < up.len {\n            up.keys[j] = up.keys[j + 1].take();\n            up.vals[j] = up.vals[j + 1].take();\n            up.kids[j + 1] = up.kids[j + 2];\n            j += 1;\n        }\n        up.len -= 1;\n        let base = self.nodes[l as usize].len;\n        self.nodes[l as usize].keys[base] = mk;\n        self.nodes[l as usize].vals[base] = mv;\n        let count = self.nodes[r as usize].len;\n        j = 0;\n        while j < count {\n            let k = self.nodes[r as usize].keys[j].take();\n            let v = self.nodes[r as usize].vals[j].take();\n            self.nodes[l as usize].keys[base + 1 + j] = k;\n            self.nodes[l as usize].vals[base + 1 + j] = v;\n            j += 1;\n        }\n        if !self.nodes[l as usize].leaf {\n            j = 0;\n            while j <= count {\n                let kid = self.nodes[r as usize].kids[j];\n                self.nodes[l as usize].kids[base + 1 + j] = kid;\n                j += 1;\n            }\n        }\n        self.nodes[l as usize].len = base + 1 + count;\n        self.free_node(r);\n    }\n\n");
    buf_str(out, c"    // Child i of p, which has the fewest keys, given one more: from the\n    // sibling before or after it through p's key between them, or merged\n    // with one. Returns the node that holds the child's keys now.\n    fn fill(&mut self, p: u32, i: usize) -> u32 {\n        let c = self.nodes[p as usize].kids[i];\n        let plen = self.nodes[p as usize].len;\n        if i > 0 && self.nodes[self.nodes[p as usize].kids[i - 1] as usize].len > B_MIN {\n            let l = self.nodes[p as usize].kids[i - 1];\n            // c's entries one to the right, p's key down, l's last key up\n            let node = &mut self.nodes[c as usize];\n            let mut j = node.len;\n            while j > 0 {\n                node.keys[j] = node.keys[j - 1].take();\n                node.vals[j] = node.vals[j - 1].take();\n                j -= 1;\n            }\n            if !node.leaf {\n                j = node.len + 1;\n                while j > 0 {\n                    node.kids[j] = node.kids[j - 1];\n                    j -= 1;\n                }\n            }\n            node.len += 1;\n            let dk = self.nodes[p as usize].keys[i - 1].take();\n            let dv = self.nodes[p as usize].vals[i - 1].take();\n            self.nodes[c as usize].keys[0] = dk;\n            self.nodes[c as usize].vals[0] = dv;\n            let left = &mut self.nodes[l as usize];\n            let last = left.len - 1;\n            let uk = left.keys[last].take();\n            let uv = left.vals[last].take();\n            let kid = left.kids[last + 1];\n            left.len = last;\n            self.nodes[p as usize].keys[i - 1] = uk;\n            self.nodes[p as usize].vals[i - 1] = uv;\n            self.nodes[c as usize].kids[0] = kid;\n            return c;\n        }\n        if i < plen && self.nodes[self.nodes[p as usize].kids[i + 1] as usize].len > B_MIN {\n            let r = self.nodes[p as usize].kids[i + 1];\n");
    buf_str(out, c"            // p's key down to c's end, r's first key up, r's rest one left\n            let dk = self.nodes[p as usize].keys[i].take();\n            let dv = self.nodes[p as usize].vals[i].take();\n            let right = &mut self.nodes[r as usize];\n            let uk = right.keys[0].take();\n            let uv = right.vals[0].take();\n            let kid = right.kids[0];\n            let mut j = 0;\n            while j + 1 < right.len {\n                right.keys[j] = right.keys[j + 1].take();\n                right.vals[j] = right.vals[j + 1].take();\n                j += 1;\n            }\n            if !right.leaf {\n                j = 0;\n                while j < right.len {\n                    right.kids[j] = right.kids[j + 1];\n                    j += 1;\n                }\n            }\n            right.len -= 1;\n            self.nodes[p as usize].keys[i] = uk;\n            self.nodes[p as usize].vals[i] = uv;\n            let node = &mut self.nodes[c as usize];\n            let end = node.len;\n            node.keys[end] = dk;\n            node.vals[end] = dv;\n            node.kids[end + 1] = kid;\n            node.len = end + 1;\n            return c;\n        }\n        if i < plen {\n            self.merge(p, i);\n            return c;\n        }\n        self.merge(p, i - 1);\n        self.nodes[p as usize].kids[i - 1]\n    }\n\n    // The entry i of leaf n taken out. n is the root or has more than the\n    // fewest keys.\n    fn take_leaf(&mut self, n: u32, i: usize) -> (K, V) {\n        let node = &mut self.nodes[n as usize];\n        let k = node.keys[i].take();\n        let v = node.vals[i].take();\n        let mut j = i;\n        while j + 1 < node.len {\n            node.keys[j] = node.keys[j + 1].take();\n            node.vals[j] = node.vals[j + 1].take();\n            j += 1;\n        }\n        node.len -= 1;\n        (k.unwrap(), v.unwrap())\n    }\n\n    // Removes the smallest (largest) entry of the subtree of n, which is\n");
    buf_str(out, c"    // the root or has more than the fewest keys. On the way down each node\n    // entered is first given more than the fewest keys, so that taking one\n    // out never leaves it with too few.\n    fn remove_edge(&mut self, start: u32, largest: bool) -> (K, V) {\n        let mut n = start;\n        loop {\n            let node = &self.nodes[n as usize];\n            if node.leaf {\n                let i = if largest { node.len - 1 } else { 0 };\n                return self.take_leaf(n, i);\n            }\n            let i = if largest { node.len } else { 0 };\n            let c = node.kids[i];\n            n = if self.nodes[c as usize].len <= B_MIN { self.fill(n, i) } else { c };\n        }\n    }\n\n    // Removes key's entry from the subtree of n, as remove_edge goes down.\n    fn remove_below<C: BCompare<K>>(&mut self, start: u32, key: &C) -> Option<(K, V)> {\n        let mut n = start;\n        loop {\n            let node = &self.nodes[n as usize];\n            let (i, found) = b_find(node, key);\n            if node.leaf {\n                if !found {\n                    return None;\n                }\n                return Some(self.take_leaf(n, i));\n            }\n            if found {\n                // a key between two children: the entry before it (the\n                // left child's largest) or after it takes its place, when\n                // that child can give one; else the two become one node\n                // with the key in it, and the search goes on there\n                let l = node.kids[i];\n                let r = node.kids[i + 1];\n                let (rk, rv) = if self.nodes[l as usize].len > B_MIN {\n                    self.remove_edge(l, true)\n                } else if self.nodes[r as usize].len > B_MIN {\n                    self.remove_edge(r, false)\n                } else {\n                    self.merge(n, i);\n                    n = l;\n                    continue;\n                };\n");
    buf_str(out, c"                let node = &mut self.nodes[n as usize];\n                let k = node.keys[i].replace(rk);\n                let v = node.vals[i].replace(rv);\n                return Some((k.unwrap(), v.unwrap()));\n            }\n            let c = node.kids[i];\n            n = if self.nodes[c as usize].len <= B_MIN { self.fill(n, i) } else { c };\n        }\n    }\n\n    // After a removal: an empty root's one child is the root now (one\n    // level less), and an empty leaf root is no root.\n    fn shrink_root(&mut self) {\n        let root = self.root;\n        if self.nodes[root as usize].len == 0 {\n            self.root = if self.nodes[root as usize].leaf {\n                B_NONE\n            } else {\n                self.nodes[root as usize].kids[0]\n            };\n            self.free_node(root);\n        }\n    }\n\n    fn remove_with<C: BCompare<K>>(&mut self, key: &C) -> Option<(K, V)> {\n        if self.root == B_NONE {\n            return None;\n        }\n        let out = self.remove_below(self.root, key);\n        self.shrink_root();\n        if out.is_some() {\n            self.len -= 1;\n        }\n        out\n    }\n\n    fn pop_edge(&mut self, largest: bool) -> Option<(K, V)> {\n        if self.root == B_NONE {\n            return None;\n        }\n        let out = self.remove_edge(self.root, largest);\n        self.shrink_root();\n        self.len -= 1;\n        Some(out)\n    }\n\n    // Removes key; its value.\n    #[effects(K, V, A, Q)]\n    pub fn remove<Q: ?Sized + Ord>(&mut self, key: &Q) -> Option<V>\n        where\n            K: Borrow<Q>,\n    {\n        match self.remove_with(&BBorrowed { key: key }) {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n\n    #[effects(K, V, A, Q)]\n    pub fn remove_entry<Q: ?Sized + Ord>(&mut self, key: &Q) -> Option<(K, V)>\n        where\n            K: Borrow<Q>,\n    {\n        self.remove_with(&BBorrowed { key: key })\n    }\n\n");
    buf_str(out, c"    // Removes the entry with the smallest key.\n    #[effects(K, V, A)]\n    pub fn pop_first(&mut self) -> Option<(K, V)> {\n        self.pop_edge(false)\n    }\n\n    // Removes the entry with the largest key.\n    #[effects(K, V, A)]\n    pub fn pop_last(&mut self) -> Option<(K, V)> {\n        self.pop_edge(true)\n    }\n\n    // The entries whose keys are in `range` (`a..b`, `a..=b`, `a..`, `..b`,\n    // `..`), in order. Panics when the range's start is after its end.\n    // (`m.range(..)` waits for the front: RangeFull's impl is for every T,\n    // and the T of this bound is not found; `iter` is the same entries.)\n    #[effects(panic, K, V, A, R)]\n    pub fn range<R: RangeBounds<K>>(&self, range: R) -> BTreeIter<'_, K, V, A> {\n        let mut lo: Option<&K> = None;\n        let front = match range.start_bound() {\n            Bound::Included(k) => {\n                lo = Some(k);\n                self.cursor_seek(&BDirect { key: k }, false)\n            }\n            Bound::Excluded(k) => {\n                lo = Some(k);\n                self.cursor_seek(&BDirect { key: k }, true)\n            }\n            Bound::Unbounded => self.cursor_first(),\n        };\n        let mut hi: Option<&K> = None;\n        let back = match range.end_bound() {\n            Bound::Included(k) => {\n                hi = Some(k);\n                self.cursor_seek(&BDirect { key: k }, true)\n            }\n            Bound::Excluded(k) => {\n                hi = Some(k);\n                self.cursor_seek(&BDirect { key: k }, false)\n            }\n            Bound::Unbounded => b_end(),\n        };\n        match (lo, hi) {\n            (Some(a), Some(b)) => if *a > *b {\n                crate::panic::panic(\"range start is greater than range end in BTreeMap\");\n            },\n            _ => {}\n        }\n        BTreeIter { map: self, front: front, back: back }\n    }\n\n    // key's place in the map, to read, fill or change in one lookup.\n    #[effects(K, V, A)]\n");
    buf_str(out, c"    pub fn entry(&mut self, key: K) -> BTreeEntry<'_, K, V, A> {\n        let (n, i) = self.locate(&BDirect { key: &key });\n        if n == B_NONE {\n            BTreeEntry::Vacant(BTreeVacantEntry { map: self, key: key })\n        } else {\n            BTreeEntry::Occupied(BTreeOccupiedEntry { map: self, key: key, node: n, at: i })\n        }\n    }\n\n    // A copy on allocator b.\n    #[effects(diverge, K, V, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> BTreeMap<K, V, B>\n        where\n            K: Clone,\n            V: Clone,\n    {\n        let mut m: BTreeMap<K, V, B> = BTreeMap::new_in(b);\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K: Ord + Clone, V: Clone, A: Allocator + Clone> Clone for BTreeMap<K, V, A> {\n    fn clone(&self) -> BTreeMap<K, V, A> {\n        self.clone_in(self.allocator().clone())\n    }\n}\n\n// The same entries.\nimpl<K: PartialEq, V: PartialEq, A: Allocator, B: Allocator> PartialEq<BTreeMap<K, V, B>>\n    for BTreeMap<K, V, A>\n    {\n    fn eq(&self, other: &BTreeMap<K, V, B>) -> bool {\n        if self.len != other.len {\n            return false;\n        }\n        let mut a = self.iter();\n        let mut b = other.iter();\n        loop {\n            match (a.next(), b.next()) {\n                (Some((k, v)), Some((l, w))) => if *k != *l || *v != *w {\n                    return false;\n                },\n                _ => return true,\n            }\n        }\n    }\n}\n\nimpl<K: Eq, V: Eq, A: Allocator> Eq for BTreeMap<K, V, A> {}\n\n// `{k: v, ...}`, in the keys' order.\nimpl<K: Debug, V: Debug, A: Allocator> Debug for BTreeMap<K, V, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_map().entries(self.iter()).finish()\n    }\n}\n\n// `m[&k]`: the value; panics when k is not there.\nimpl<K: Ord + Borrow<Q>, Q: ?Sized + Ord, V, A: Allocator> Index<&Q> for BTreeMap<K, V, A> {\n");
    buf_str(out, c"    type Output = V;\n\n    fn index(&self, key: &Q) -> &V {\n        self.get(key).expect(\"no entry found for key\")\n    }\n}\n\nimpl<K: Ord, V, A: Allocator> Extend<(K, V)> for BTreeMap<K, V, A> {\n    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(k, v);\n        }\n    }\n}\n\n// `pairs.collect_in(a)`.\nimpl<K: Ord, V, A: Allocator> FromIteratorIn<(K, V), A> for BTreeMap<K, V, A> {\n    fn from_iter_in<I: IntoIterator<Item = (K, V)>>(iter: I, a: A) -> BTreeMap<K, V, A> {\n        let mut m: BTreeMap<K, V, A> = BTreeMap::new_in(a);\n        m.extend(iter);\n        m\n    }\n}\n\n// An empty map on a (`entry(k).or_default()` for map values).\nimpl<K, V, A: Allocator> DefaultIn<A> for BTreeMap<K, V, A> {\n    fn default_in(a: A) -> BTreeMap<K, V, A> {\n        BTreeMap::new_in(a)\n    }\n}\n\nimpl<K, V, A: Allocator> IntoIterator for BTreeMap<K, V, A> {\n    type Item = (K, V);\n    type IntoIter = BTreeIntoIter<K, V, A>;\n\n    fn into_iter(self) -> BTreeIntoIter<K, V, A> {\n        let front = self.cursor_first();\n        BTreeIntoIter { map: self, front: front, back: b_end() }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> IntoIterator for &'a BTreeMap<K, V, A> {\n    type Item = (&'a K, &'a V);\n    type IntoIter = BTreeIter<'a, K, V, A>;\n\n    fn into_iter(self) -> BTreeIter<'a, K, V, A> {\n        self.iter()\n    }\n}\n\n// ---- Iterators ----\n\n// The entries from `front` up to `back`, which is not one of them.\npub struct BTreeIter<'a, K, V, A: Allocator> {\n    map: &'a BTreeMap<K, V, A>,\n    front: BCursor,\n    back: BCursor,\n}\n\nimpl<'a, K, V, A: Allocator> Clone for BTreeIter<'a, K, V, A> {\n    fn clone(&self) -> BTreeIter<'a, K, V, A> {\n        BTreeIter { map: self.map, front: self.front, back: self.back }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for BTreeIter<'a, K, V, A> {\n    type Item = (&'a K, &'a V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a V)> {\n");
    buf_str(out, c"        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        let map: &'a BTreeMap<K, V, A> = self.map;\n        let item = map.entry_at(&self.front);\n        map.cursor_next(&mut self.front);\n        Some(item)\n    }\n}\n\nimpl<'a, K, V, A: Allocator> DoubleEndedIterator for BTreeIter<'a, K, V, A> {\n    fn next_back(&mut self) -> Option<(&'a K, &'a V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        let map: &'a BTreeMap<K, V, A> = self.map;\n        map.cursor_prev(&mut self.back);\n        Some(map.entry_at(&self.back))\n    }\n}\n\npub struct BTreeKeys<'a, K, V, A: Allocator> {\n    inner: BTreeIter<'a, K, V, A>,\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for BTreeKeys<'a, K, V, A> {\n    type Item = &'a K;\n\n    fn next(&mut self) -> Option<&'a K> {\n        match self.inner.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> DoubleEndedIterator for BTreeKeys<'a, K, V, A> {\n    fn next_back(&mut self) -> Option<&'a K> {\n        match self.inner.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\npub struct BTreeValues<'a, K, V, A: Allocator> {\n    inner: BTreeIter<'a, K, V, A>,\n}\n\nimpl<'a, K, V, A: Allocator> Iterator for BTreeValues<'a, K, V, A> {\n    type Item = &'a V;\n\n    fn next(&mut self) -> Option<&'a V> {\n        match self.inner.next() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\nimpl<'a, K, V, A: Allocator> DoubleEndedIterator for BTreeValues<'a, K, V, A> {\n    fn next_back(&mut self) -> Option<&'a V> {\n        match self.inner.next_back() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\n// A map's entries by value, in order; what is left is dropped with it.\npub struct BTreeIntoIter<K, V, A: Allocator> {\n    map: BTreeMap<K, V, A>,\n");
    buf_str(out, c"    front: BCursor,\n    back: BCursor,\n}\n\nimpl<K, V, A: Allocator> Iterator for BTreeIntoIter<K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        let item = self.map.take_at(&self.front);\n        self.map.cursor_next(&mut self.front);\n        Some(item)\n    }\n}\n\nimpl<K, V, A: Allocator> DoubleEndedIterator for BTreeIntoIter<K, V, A> {\n    fn next_back(&mut self) -> Option<(K, V)> {\n        if b_same(&self.front, &self.back) {\n            return None;\n        }\n        self.map.cursor_prev(&mut self.back);\n        Some(self.map.take_at(&self.back))\n    }\n}\n\n// ---- Entry ----\n\n// A key's place in a map: Occupied (its entry is there) or Vacant.\npub enum BTreeEntry<'a, K, V, A: Allocator> {\n    Occupied(BTreeOccupiedEntry<'a, K, V, A>),\n    Vacant(BTreeVacantEntry<'a, K, V, A>),\n}\n\nimpl<'a, K: Ord, V, A: Allocator> BTreeEntry<'a, K, V, A> {\n    // The value, set to `default` first when the key was not there.\n    #[effects(K, V, A)]\n    pub fn or_insert(self, default: V) -> &'a mut V {\n        match self {\n            BTreeEntry::Occupied(e) => e.into_mut(),\n            BTreeEntry::Vacant(e) => e.insert(default),\n        }\n    }\n\n    #[effects(K, V, A, F)]\n    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &'a mut V {\n        match self {\n            BTreeEntry::Occupied(e) => e.into_mut(),\n            BTreeEntry::Vacant(e) => e.insert(f()),\n        }\n    }\n\n    #[effects(K, V, A)]\n    pub fn or_default(self) -> &'a mut V\n        where\n            V: Default,\n    {\n        match self {\n            BTreeEntry::Occupied(e) => e.into_mut(),\n            BTreeEntry::Vacant(e) => e.insert(V::default()),\n        }\n    }\n\n    // The entry, its value changed by f when the key is there.\n    #[effects(K, V, A, F)]\n    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> BTreeEntry<'a, K, V, A> {\n");
    buf_str(out, c"        match self {\n            BTreeEntry::Occupied(e) => {\n                let mut e = e;\n                f(e.get_mut());\n                BTreeEntry::Occupied(e)\n            }\n            BTreeEntry::Vacant(e) => BTreeEntry::Vacant(e),\n        }\n    }\n\n    #[effects()]\n    pub fn key(&self) -> &K {\n        match self {\n            BTreeEntry::Occupied(e) => &e.key,\n            BTreeEntry::Vacant(e) => &e.key,\n        }\n    }\n}\n\npub struct BTreeOccupiedEntry<'a, K, V, A: Allocator> {\n    map: &'a mut BTreeMap<K, V, A>,\n    key: K,\n    node: u32,\n    at: usize,\n}\n\nimpl<'a, K: Ord, V, A: Allocator> BTreeOccupiedEntry<'a, K, V, A> {\n    #[effects()]\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    #[effects(panic, K, V, A)]\n    pub fn get(&self) -> &V {\n        self.map.nodes[self.node as usize].vals[self.at].as_ref().unwrap()\n    }\n\n    #[effects(panic, K, V, A)]\n    pub fn get_mut(&mut self) -> &mut V {\n        self.map.nodes[self.node as usize].vals[self.at].as_mut().unwrap()\n    }\n\n    // The value, for as long as the map is borrowed.\n    #[effects(panic, K, V, A)]\n    pub fn into_mut(self) -> &'a mut V {\n        let map = self.map;\n        map.nodes[self.node as usize].vals[self.at].as_mut().unwrap()\n    }\n\n    // Sets the value; the one it had.\n    #[effects(panic, K, V, A)]\n    pub fn insert(&mut self, value: V) -> V {\n        self.map.nodes[self.node as usize].vals[self.at].replace(value).unwrap()\n    }\n\n    // Removes the entry; its value.\n    #[effects(panic, K, V, A)]\n    pub fn remove(self) -> V {\n        self.map.remove_with(&BDirect { key: &self.key }).unwrap().1\n    }\n}\n\npub struct BTreeVacantEntry<'a, K, V, A: Allocator> {\n    map: &'a mut BTreeMap<K, V, A>,\n    key: K,\n}\n\nimpl<'a, K: Ord, V, A: Allocator> BTreeVacantEntry<'a, K, V, A> {\n    #[effects()]\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    #[effects()]\n    pub fn into_key(self) -> K {\n");
    buf_str(out, c"        self.key\n    }\n\n    // Adds the entry; its value, for as long as the map is borrowed.\n    #[effects(panic, K, V, A)]\n    pub fn insert(self, value: V) -> &'a mut V {\n        let map = self.map;\n        let (n, i, _) = map.insert_at(self.key, value);\n        map.nodes[n as usize].vals[i].as_mut().unwrap()\n    }\n}\n\n// ---- BTreeSet ----\n\n// A set of T in order, on allocator A: a BTreeMap with no values.\npub struct BTreeSet<T, A: Allocator> {\n    map: BTreeMap<T, (), A>,\n}\n\nimpl<T, A: Allocator> BTreeSet<T, A> {\n    // An empty set on a; allocates at the first insert.\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> BTreeSet<T, A> {\n        BTreeSet { map: BTreeMap::new_in(a) }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.map.len\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.map.len == 0\n    }\n\n    #[effects(T, A)]\n    pub fn clear(&mut self) {\n        self.map.clear();\n    }\n\n    // The elements in order.\n    #[effects(T, A)]\n    pub fn iter(&self) -> BTreeSetIter<'_, T, A> {\n        BTreeSetIter { inner: self.map.iter() }\n    }\n\n    // The smallest element.\n    #[effects(T, A)]\n    pub fn first(&self) -> Option<&T> {\n        self.iter().next()\n    }\n\n    // The largest element.\n    #[effects(T, A)]\n    pub fn last(&self) -> Option<&T> {\n        self.iter().next_back()\n    }\n}\n\nimpl<T: Ord, A: Allocator> BTreeSet<T, A> {\n    #[effects(T, A, Q)]\n    pub fn contains<Q: ?Sized + Ord>(&self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.contains_key(x)\n    }\n\n    // The set's element equal to x.\n    #[effects(T, A, Q)]\n    pub fn get<Q: ?Sized + Ord>(&self, x: &Q) -> Option<&T>\n        where\n            T: Borrow<Q>,\n    {\n        match self.map.get_key_value(x) {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    // Adds x; false when it was there already.\n");
    buf_str(out, c"    #[effects(T, A)]\n    pub fn insert(&mut self, x: T) -> bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    // Removes x; whether it was there.\n    #[effects(T, A, Q)]\n    pub fn remove<Q: ?Sized + Ord>(&mut self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove_entry(x).is_some()\n    }\n\n    // Removes and returns the element equal to x.\n    #[effects(T, A, Q)]\n    pub fn take<Q: ?Sized + Ord>(&mut self, x: &Q) -> Option<T>\n        where\n            T: Borrow<Q>,\n    {\n        match self.map.remove_entry(x) {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    #[effects(T, A)]\n    pub fn pop_first(&mut self) -> Option<T> {\n        match self.map.pop_first() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    #[effects(T, A)]\n    pub fn pop_last(&mut self) -> Option<T> {\n        match self.map.pop_last() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n\n    // The elements in `range`, in order.\n    #[effects(T, A, R)]\n    pub fn range<R: RangeBounds<T>>(&self, range: R) -> BTreeSetIter<'_, T, A> {\n        BTreeSetIter { inner: self.map.range(range) }\n    }\n\n    // Whether every element of self is in other.\n    #[effects(diverge, T, A, B)]\n    pub fn is_subset<B: Allocator>(&self, other: &BTreeSet<T, B>) -> bool {\n        if self.len() > other.len() {\n            return false;\n        }\n        for x in self.iter() {\n            if !other.contains(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    #[effects(T, A, B)]\n    pub fn is_superset<B: Allocator>(&self, other: &BTreeSet<T, B>) -> bool {\n        other.is_subset(self)\n    }\n\n    // Whether the two have no element in common.\n    #[effects(diverge, T, A, B)]\n    pub fn is_disjoint<B: Allocator>(&self, other: &BTreeSet<T, B>) -> bool {\n        for x in self.iter() {\n");
    buf_str(out, c"            if other.contains(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // A copy on allocator b.\n    #[effects(diverge, T, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> BTreeSet<T, B>\n        where\n            T: Clone,\n    {\n        let mut s: BTreeSet<T, B> = BTreeSet::new_in(b);\n        for x in self.iter() {\n            s.insert(x.clone());\n        }\n        s\n    }\n}\n\nimpl<T: Ord + Clone, A: Allocator + Clone> Clone for BTreeSet<T, A> {\n    fn clone(&self) -> BTreeSet<T, A> {\n        self.clone_in(self.map.allocator().clone())\n    }\n}\n\nimpl<T: PartialEq, A: Allocator, B: Allocator> PartialEq<BTreeSet<T, B>> for BTreeSet<T, A> {\n    fn eq(&self, other: &BTreeSet<T, B>) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        let mut a = self.iter();\n        let mut b = other.iter();\n        loop {\n            match (a.next(), b.next()) {\n                (Some(x), Some(y)) => if *x != *y {\n                    return false;\n                },\n                _ => return true,\n            }\n        }\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for BTreeSet<T, A> {}\n\n// `{a, b, ...}`, in order.\nimpl<T: Debug, A: Allocator> Debug for BTreeSet<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_set().entries(self.iter()).finish()\n    }\n}\n\nimpl<T: Ord, A: Allocator> Extend<T> for BTreeSet<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.insert(x);\n        }\n    }\n}\n\n// `items.collect_in(a)`.\nimpl<T: Ord, A: Allocator> FromIteratorIn<T, A> for BTreeSet<T, A> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> BTreeSet<T, A> {\n        let mut s: BTreeSet<T, A> = BTreeSet::new_in(a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T, A: Allocator> DefaultIn<A> for BTreeSet<T, A> {\n");
    buf_str(out, c"    fn default_in(a: A) -> BTreeSet<T, A> {\n        BTreeSet::new_in(a)\n    }\n}\n\nimpl<T, A: Allocator> IntoIterator for BTreeSet<T, A> {\n    type Item = T;\n    type IntoIter = BTreeSetIntoIter<T, A>;\n\n    fn into_iter(self) -> BTreeSetIntoIter<T, A> {\n        BTreeSetIntoIter { inner: self.map.into_iter() }\n    }\n}\n\nimpl<'a, T, A: Allocator> IntoIterator for &'a BTreeSet<T, A> {\n    type Item = &'a T;\n    type IntoIter = BTreeSetIter<'a, T, A>;\n\n    fn into_iter(self) -> BTreeSetIter<'a, T, A> {\n        self.iter()\n    }\n}\n\npub struct BTreeSetIter<'a, T, A: Allocator> {\n    inner: BTreeIter<'a, T, (), A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for BTreeSetIter<'a, T, A> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.inner.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<'a, T, A: Allocator> DoubleEndedIterator for BTreeSetIter<'a, T, A> {\n    fn next_back(&mut self) -> Option<&'a T> {\n        match self.inner.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\npub struct BTreeSetIntoIter<T, A: Allocator> {\n    inner: BTreeIntoIter<T, (), A>,\n}\n\nimpl<T, A: Allocator> Iterator for BTreeSetIntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        match self.inner.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<T, A: Allocator> DoubleEndedIterator for BTreeSetIntoIter<T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        match self.inner.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n// ---- end mod std::collections::btree_map ----\n}\n// ---- mod std::collections::hash_map ----\npub mod hash_map {\n// std::collections::hash_map: HashMap<K, V, A, S>, Entry, the iterators.\n// hashbrown's Swiss table, as MVS's (its RawTable is internal). A and S,\n");
    buf_str(out, c"// the BuildHasher, are always written (0.29.0: S has no default, as A;\n// hash.default), S last: `HashMap<K, V, Gpa, FixedState>`, FixedState (a\n// fixed seed: decision 2) being what `new_in` and `with_capacity_in`\n// make. Rust's order is <K, V, S, A>: the rustc twin's shim swaps them.\n// Lookups take a reference to anything the key Borrows (`m.get(\"x\")` on\n// String keys). The K: Hash + Eq bound is on the impls, not the struct,\n// as Rust's; S: BuildHasher is on the struct: it is how a type argument\n// left out is known to be the hasher.\n\nuse crate::alloc::{Allocator, Layout, TryReserveError};\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{BuildHasher, FixedState, Hash, Hasher};\nuse crate::iter::{ExactSizeIterator, Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::marker::PhantomData;\nuse crate::ops::Index;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// A map from K to V on A, hashed by S.\n// std: changed: an S, always written; K's bounds moved to the impls\npub struct HashMap<K, V, A: Allocator, S: BuildHasher> {\n    table: RawTable<(K, V), A>,\n    hasher: S,\n}\n\n// The table itself (internal): cap slots of T and a control byte for\n// each, both from alloc; cap is 0 (nothing allocated) or a power of two\n// of at least 8. A control byte is EMPTY, DELETED (a tombstone: a probe\n// goes on past it) or a full slot's h2, the hash's top 7 bits. Probing is\n// linear from the hash's low bits, and at most 7/8 of the slots are used\n// (growth_left counts what is left), so a probe always meets an EMPTY.\nstruct RawTable<T, A: Allocator> {\n    ctrl: crate::ptr::NonNull<u8>,\n    data: crate::ptr::NonNull<T>,\n    cap: usize,\n    items: usize,\n    growth_left: usize,\n    alloc: A,\n    marker: PhantomData<T>,\n}\n\n// UNSAFE: the table's control bytes and slots are NonNulls: stated, as\n");
    buf_str(out, c"// hashbrown's.\n// SAFETY: the table owns its entries and its allocator and reaches them\n// only through itself (HashMap, IntoIter, Drain go through it).\nunsafe impl<T: Send, A: Allocator + Send> Send for RawTable<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&RawTable` reads its entries through `&T` only.\nunsafe impl<T: Sync, A: Allocator + Sync> Sync for RawTable<T, A> {}\n\nconst EMPTY: u8 = 255;\nconst DELETED: u8 = 128;\n\n// A hash's control byte (its top 7 bits) and its first slot.\nfn h2(hash: u64) -> u8 {\n    (hash >> 57) as u8\n}\n\n// The slots a table needs for n entries (0 for none).\nfn buckets_for(n: usize) -> usize {\n    if n == 0 {\n        return 0;\n    }\n    let mut cap: usize = 8;\n    while cap / 8 * 7 < n {\n        cap *= 2;\n    }\n    cap\n}\n\nimpl<T, A: Allocator> RawTable<T, A> {\n    fn new_in(a: A) -> RawTable<T, A> {\n        RawTable {\n            ctrl: crate::ptr::NonNull::dangling(),\n            data: crate::ptr::NonNull::dangling(),\n            cap: 0,\n            items: 0,\n            growth_left: 0,\n            alloc: a,\n            marker: PhantomData,\n        }\n    }\n\n    // A control array (every byte EMPTY) and a slot array of cap from the\n    // allocator; panics when it has no room.\n    fn allocate_arrays(&self, cap: usize) -> (crate::ptr::NonNull<u8>, crate::ptr::NonNull<T>) {\n        let ctrl_layout = match Layout::array::<u8>(cap) {\n            Result::Ok(l) => l,\n            Result::Err(_) => {\n                let msg: &str = \"HashMap: capacity overflow\";\n                crate::panic::panic(msg)\n            }\n        };\n        let data_layout = match Layout::array::<T>(cap) {\n            Result::Ok(l) => l,\n            Result::Err(_) => {\n                let msg: &str = \"HashMap: capacity overflow\";\n                crate::panic::panic(msg)\n            }\n        };\n        let ctrl = match self.alloc.allocate(ctrl_layout) {\n            Result::Ok(p) => p,\n");
    buf_str(out, c"            Result::Err(_) => {\n                let msg: &str = \"HashMap: out of memory\";\n                crate::panic::panic(msg)\n            }\n        };\n        let data = match self.alloc.allocate(data_layout) {\n            Result::Ok(p) => p.cast::<T>(),\n            Result::Err(_) => {\n                let msg: &str = \"HashMap: out of memory\";\n                crate::panic::panic(msg)\n            }\n        };\n        let c = ctrl.as_ptr();\n        let mut i: usize = 0;\n        while i < cap {\n            // UNSAFE: the new control array is written through its pointer.\n            // SAFETY: i < cap, the array's length, and it is ours alone.\n            unsafe {\n                *c.add(i) = EMPTY;\n            }\n            i += 1;\n        }\n        (ctrl, data)\n    }\n\n    // Gives the arrays back (their entries were moved out or dropped).\n    fn free_arrays(&mut self) {\n        let ctrl = crate::mem::replace(&mut self.ctrl, crate::ptr::NonNull::dangling());\n        let data = crate::mem::replace(&mut self.data, crate::ptr::NonNull::dangling());\n        let cap = crate::mem::replace(&mut self.cap, 0);\n        self.items = 0;\n        self.growth_left = 0;\n        self.free_raw(ctrl, data, cap);\n    }\n\n    // Gives back arrays of cap that allocate_arrays made (none when cap is 0).\n    fn free_raw(&self, ctrl: crate::ptr::NonNull<u8>, data: crate::ptr::NonNull<T>, cap: usize) {\n        if cap == 0 {\n            return;\n        }\n        // UNSAFE: the blocks go back to the allocator they came from.\n        // SAFETY: cap > 0, so ctrl and data are blocks alloc gave for these\n        // layouts (allocate_arrays); the caller uses them no more.\n        unsafe {\n            match Layout::array::<u8>(cap) {\n                Result::Ok(l) => self.alloc.deallocate(ctrl, l),\n                Result::Err(_) => {}\n            }\n            match Layout::array::<T>(cap) {\n");
    buf_str(out, c"                Result::Ok(l) => self.alloc.deallocate(data.cast::<u8>(), l),\n                Result::Err(_) => {}\n            }\n        }\n    }\n\n    // Slot i's control byte (i < cap).\n    fn ctrl_at(&self, i: usize) -> u8 {\n        let c = self.ctrl.as_ptr();\n        // UNSAFE: a read of the control array.\n        // SAFETY: callers pass i < cap, the array's length, and every byte\n        // of it was written (allocate_arrays).\n        unsafe { *c.add(i) }\n    }\n\n    fn set_ctrl(&mut self, i: usize, b: u8) {\n        let c = self.ctrl.as_ptr();\n        // UNSAFE: a write of the control array.\n        // SAFETY: callers pass i < cap; &mut self, so nothing else reads it.\n        unsafe {\n            *c.add(i) = b;\n        }\n    }\n\n    fn is_full(&self, i: usize) -> bool {\n        self.ctrl_at(i) < DELETED\n    }\n\n    // Slot i's entry (full).\n    fn slot(&self, i: usize) -> &T {\n        let d = self.data.as_ptr();\n        // UNSAFE: a reference made from the slot array's pointer.\n        // SAFETY: callers pass a full slot i < cap, so it holds an\n        // initialized T; the reference lives as long as &self.\n        unsafe { &*d.add(i) }\n    }\n\n    fn slot_mut(&mut self, i: usize) -> &mut T {\n        let d = self.data.as_ptr();\n        // UNSAFE: a &mut made from the slot array's pointer.\n        // SAFETY: callers pass a full slot i < cap; &mut self makes it the\n        // only reference.\n        unsafe { &mut *d.add(i) }\n    }\n\n    // The first slot from hash's that is EMPTY or DELETED (cap > 0).\n    fn find_insert_slot(&self, hash: u64) -> usize {\n        let mask = self.cap - 1;\n        let mut i = (hash as usize) & mask;\n        // (each slot once at most: a counted loop, no `diverge`. growth_left\n        // keeps a slot that is not full, so the last line is not reached\n        // with a full one.)\n        for _ in 0..self.cap {\n            if !self.is_full(i) {\n                return i;\n            }\n");
    buf_str(out, c"            i = (i + 1) & mask;\n        }\n        i\n    }\n\n    // Puts x in slot i (found by find_insert_slot for hash).\n    fn put(&mut self, i: usize, hash: u64, x: T) {\n        if self.ctrl_at(i) == EMPTY {\n            self.growth_left -= 1;\n        }\n        self.set_ctrl(i, h2(hash));\n        let d = self.data.as_ptr();\n        // UNSAFE: a write into the slot array.\n        // SAFETY: i < cap and slot i is not full, so nothing is overwritten\n        // that would need a drop.\n        unsafe {\n            crate::ptr::write(d.add(i), x);\n        }\n        self.items += 1;\n    }\n\n    // Moves slot i's entry out, leaving a tombstone (full slot i).\n    fn take(&mut self, i: usize) -> T {\n        // An EMPTY after it ends every probe that would pass, so slot i\n        // can be EMPTY again (its room comes back).\n        let next = (i + 1) & (self.cap - 1);\n        if self.ctrl_at(next) == EMPTY {\n            self.set_ctrl(i, EMPTY);\n            self.growth_left += 1;\n        } else {\n            self.set_ctrl(i, DELETED);\n        }\n        self.items -= 1;\n        let d = self.data.as_ptr();\n        // UNSAFE: a move out of the slot array.\n        // SAFETY: slot i was full, and its control byte now says it is not,\n        // so the T is read once and never dropped in place.\n        unsafe { crate::ptr::read(d.add(i)) }\n    }\n\n    // The next full slot at or after i; cap when there is none.\n    fn next_full(&self, i: usize) -> usize {\n        let mut j = i;\n        while j < self.cap && !self.is_full(j) {\n            j += 1;\n        }\n        j\n    }\n\n    // Drops every entry; the arrays stay.\n    fn clear(&mut self) {\n        let mut i: usize = 0;\n        while i < self.cap {\n            if self.is_full(i) {\n                let x = self.take(i);\n                crate::mem::drop(x);\n            }\n            i += 1;\n        }\n        let mut j: usize = 0;\n        while j < self.cap {\n");
    buf_str(out, c"            self.set_ctrl(j, EMPTY);\n            j += 1;\n        }\n        self.items = 0;\n        self.growth_left = self.cap / 8 * 7;\n    }\n}\n\n// A table drops what is left in it and frees its arrays (a map's, an\n// IntoIter's).\nimpl<T, A: Allocator> crate::ops::Drop for RawTable<T, A> {\n    fn drop(&mut self) {\n        self.clear();\n        self.free_arrays();\n    }\n}\n\nimpl<K, V, A: Allocator> HashMap<K, V, A, FixedState> {\n    // An empty map on a, with the fixed-seed hasher; it allocates at its\n    // first insert.\n    #[effects(K, V, A)]\n    pub fn new_in(a: A) -> HashMap<K, V, A, FixedState> {\n        HashMap::with_hasher_in(FixedState::new(), a)\n    }\n\n    // Room for n entries.\n    #[effects(K, V, A)]\n    pub fn with_capacity_in(n: usize, a: A) -> HashMap<K, V, A, FixedState> {\n        HashMap::with_capacity_and_hasher_in(n, FixedState::new(), a)\n    }\n}\n\nimpl<K, V, A: Allocator, S> HashMap<K, V, A, S> {\n    // An empty map on a, hashed by hasher (a seeded FixedState, a RandomState).\n    #[effects(K, V, A)]\n    pub fn with_hasher_in(hasher: S, a: A) -> HashMap<K, V, A, S> {\n        HashMap { table: RawTable::new_in(a), hasher: hasher }\n    }\n\n    #[effects(diverge, K, V, A)]\n    pub fn with_capacity_and_hasher_in(n: usize, hasher: S, a: A) -> HashMap<K, V, A, S> {\n        let mut table: RawTable<(K, V), A> = RawTable::new_in(a);\n        let cap = buckets_for(n);\n        if cap > 0 {\n            let (ctrl, data) = table.allocate_arrays(cap);\n            table.ctrl = ctrl;\n            table.data = data;\n            table.cap = cap;\n            table.growth_left = cap / 8 * 7;\n        }\n        HashMap { table: table, hasher: hasher }\n    }\n\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.table.items\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    // How many entries fit before it grows.\n    #[effects()]\n");
    buf_str(out, c"    pub fn capacity(&self) -> usize {\n        self.table.items + self.table.growth_left\n    }\n\n    #[effects()]\n    pub fn hasher(&self) -> &S {\n        &self.hasher\n    }\n\n    // std: changed: returns &A (MVS: a copy of A)\n    #[effects()]\n    pub fn allocator(&self) -> &A {\n        &self.table.alloc\n    }\n\n    // Its entries, (&K, &V), in table order (the same in every run).\n    // std: changed: yields (&K, &V) (MVS: copies)\n    #[effects(K, V)]\n    pub fn iter(&self) -> Iter<'_, K, V> {\n        Iter {\n            ctrl: self.table.ctrl.as_ptr() as *const u8,\n            data: self.table.data.as_ptr() as *const (K, V),\n            at: 0,\n            left: self.table.items,\n            marker: PhantomData,\n        }\n    }\n\n    // Its entries, (&K, &mut V).\n    #[effects(K, V)]\n    pub fn iter_mut(&mut self) -> IterMut<'_, K, V> {\n        IterMut {\n            ctrl: self.table.ctrl.as_ptr() as *const u8,\n            data: self.table.data.as_ptr(),\n            at: 0,\n            left: self.table.items,\n            marker: PhantomData,\n        }\n    }\n\n    // std: changed: yields &K\n    #[effects(K, V, A, S)]\n    pub fn keys(&self) -> Keys<'_, K, V> {\n        Keys { inner: self.iter() }\n    }\n\n    // std: changed: yields &V\n    #[effects(K, V, A, S)]\n    pub fn values(&self) -> Values<'_, K, V> {\n        Values { inner: self.iter() }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn values_mut(&mut self) -> ValuesMut<'_, K, V> {\n        ValuesMut { inner: self.iter_mut() }\n    }\n\n    // The keys, by value, the map consumed.\n    #[effects(K, V, A, S)]\n    pub fn into_keys(self) -> IntoKeys<K, V, A> {\n        IntoKeys { inner: self.into_iter() }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn into_values(self) -> IntoValues<K, V, A> {\n        IntoValues { inner: self.into_iter() }\n    }\n\n    // Every entry, removed and yielded by the iterator.\n    #[effects()]\n");
    buf_str(out, c"    pub fn drain(&mut self) -> Drain<'_, K, V, A> {\n        Drain { table: &mut self.table as *mut RawTable<(K, V), A>, at: 0, marker: PhantomData }\n    }\n\n    // Keeps the entries f says true of.\n    #[effects(diverge, K, V, A, F)]\n    pub fn retain<F: FnMut(&K, &mut V) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        let mut i: usize = 0;\n        while i < self.table.cap {\n            if self.table.is_full(i) {\n                let keep = {\n                    let e = self.table.slot_mut(i);\n                    f(&e.0, &mut e.1)\n                };\n                if !keep {\n                    let gone = self.table.take(i);\n                    crate::mem::drop(gone);\n                }\n            }\n            i += 1;\n        }\n    }\n\n    // Removes every entry; the capacity stays.\n    #[effects(K, V, A)]\n    pub fn clear(&mut self) {\n        self.table.clear()\n    }\n\n    // Moves the map out, leaving an empty one on clones of its allocator\n    // and hasher (vole's: a map has no Default).\n    #[effects(K, V, A, S)]\n    pub fn take(&mut self) -> HashMap<K, V, A, S>\n        where\n            A: Clone,\n            S: Clone,\n    {\n        let fresh = HashMap::with_hasher_in(self.hasher.clone(), self.table.alloc.clone());\n        crate::mem::replace(self, fresh)\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher> HashMap<K, V, A, S> {\n    // q's hash by the map's hasher.\n    fn hash_of<Q: ?Sized + Hash>(&self, q: &Q) -> u64 {\n        let mut h = self.hasher.build_hasher();\n        q.hash(&mut h);\n        h.finish()\n    }\n\n    // The full slot whose key equals k.\n    fn find<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<usize>\n        where\n            K: Borrow<Q>,\n    {\n        if self.table.cap == 0 {\n            return Option::None;\n        }\n        let hash = self.hash_of(k);\n        let tag = h2(hash);\n        let mask = self.table.cap - 1;\n");
    buf_str(out, c"        let mut i = (hash as usize) & mask;\n        // (a probe sees each slot once at most: a counted loop, no `diverge`.\n        // A table keeps an EMPTY slot, so the probe ends before that.)\n        for _ in 0..self.table.cap {\n            let c = self.table.ctrl_at(i);\n            if c == EMPTY {\n                return Option::None;\n            }\n            if c == tag {\n                let stored: &Q = self.table.slot(i).0.borrow();\n                if *stored == *k {\n                    return Option::Some(i);\n                }\n            }\n            i = (i + 1) & mask;\n        }\n        Option::None\n    }\n\n    // A new table of room for want entries, every entry moved over\n    // (tombstones dropped).\n    fn resize(&mut self, want: usize) {\n        let new_cap = buckets_for(want);\n        let (ctrl, data) = self.table.allocate_arrays(new_cap);\n        let old_ctrl = crate::mem::replace(&mut self.table.ctrl, ctrl);\n        let old_data = crate::mem::replace(&mut self.table.data, data);\n        let old_cap = crate::mem::replace(&mut self.table.cap, new_cap);\n        self.table.items = 0;\n        self.table.growth_left = new_cap / 8 * 7;\n        let oc = old_ctrl.as_ptr();\n        let od = old_data.as_ptr();\n        let mut i: usize = 0;\n        while i < old_cap {\n            // UNSAFE: the old arrays read through their pointers.\n            // SAFETY: i < old_cap, their length; a full slot holds an\n            // initialized entry, read once (the arrays are freed after,\n            // nothing dropped in them).\n            if unsafe { *oc.add(i) } < DELETED {\n                // UNSAFE: the full slot's entry moved out of the old array.\n                // SAFETY: as above: i < old_cap and the slot is full; it is read once.\n                let e = unsafe { crate::ptr::read(od.add(i)) };\n                let hash = self.hash_of(&e.0);\n                let j = self.table.find_insert_slot(hash);\n");
    buf_str(out, c"                self.table.put(j, hash, e);\n            }\n            i += 1;\n        }\n        self.table.free_raw(old_ctrl, old_data, old_cap);\n    }\n\n    // Room for n more entries.\n    // std: changed: n more (MVS: n in all)\n    #[effects(K, V, A, S)]\n    pub fn reserve(&mut self, n: usize) {\n        if n > self.table.growth_left {\n            self.resize(self.table.items + n);\n        }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn try_reserve(&mut self, n: usize) -> Result<(), TryReserveError> {\n        if n > usize::MAX / 2 - self.table.items {\n            return Result::Err(TryReserveError::CapacityOverflow);\n        }\n        self.reserve(n);\n        Result::Ok(())\n    }\n\n    #[effects(diverge, K, V, A, S)]\n    pub fn shrink_to_fit(&mut self) {\n        let items = self.table.items;\n        if buckets_for(items) < self.table.cap {\n            if items == 0 {\n                self.table.free_arrays();\n            } else {\n                self.resize(items);\n            }\n        }\n    }\n\n    // The value for k.\n    // std: changed: takes &Q, returns Option<&V> (MVS: a K and a copy of V)\n    #[effects(K, V, A, S, Q)]\n    pub fn get<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<&V>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => Option::Some(&self.table.slot(i).1),\n            Option::None => Option::None,\n        }\n    }\n\n    // The value for k, mutable.\n    // std: changed: takes &Q, returns Option<&mut V> (MVS: an inout view)\n    #[effects(K, V, A, S, Q)]\n    pub fn get_mut<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<&mut V>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => Option::Some(&mut self.table.slot_mut(i).1),\n            Option::None => Option::None,\n        }\n    }\n\n    // The stored key and its value.\n    #[effects(K, V, A, S, Q)]\n");
    buf_str(out, c"    pub fn get_key_value<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> Option<(&K, &V)>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => {\n                let e = self.table.slot(i);\n                Option::Some((&e.0, &e.1))\n            }\n            Option::None => Option::None,\n        }\n    }\n\n    // mvs: HashMap::contains_key, HashMap::contains\n    // std: changed: takes &Q\n    #[effects(K, V, A, S, Q)]\n    pub fn contains_key<Q: ?Sized + Hash + Eq>(&self, k: &Q) -> bool\n        where\n            K: Borrow<Q>,\n    {\n        self.get(k).is_some()\n    }\n\n    // Stores v for k; the old value, if there was one.\n    #[effects(K, V, A, S)]\n    pub fn insert(&mut self, k: K, v: V) -> Option<V> {\n        if let Option::Some(i) = self.find(&k) {\n            return Option::Some(crate::mem::replace(&mut self.table.slot_mut(i).1, v));\n        }\n        let hash = self.hash_of(&k);\n        if self.table.growth_left == 0 {\n            self.resize(self.table.items + 1);\n        }\n        let i = self.table.find_insert_slot(hash);\n        self.table.put(i, hash, (k, v));\n        Option::None\n    }\n\n    // Removes k's entry; its value.\n    // std: changed: takes &Q\n    #[effects(K, V, A, S, Q)]\n    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<V>\n        where\n            K: Borrow<Q>,\n    {\n        self.remove_entry(k).map(|(_, v)| v)\n    }\n\n    // Removes k's entry; the stored key and its value.\n    #[effects(K, V, A, S, Q)]\n    pub fn remove_entry<Q: ?Sized + Hash + Eq>(&mut self, k: &Q) -> Option<(K, V)>\n        where\n            K: Borrow<Q>,\n    {\n        match self.find(k) {\n            Option::Some(i) => Option::Some(self.table.take(i)),\n            Option::None => Option::None,\n        }\n    }\n\n    // k's place in the map, there or not: `*m.entry(k).or_insert(0) += 1`.\n    // mvs: HashMap::get_or_insert\n");
    buf_str(out, c"    // std: changed: Entry replaces get_or_insert (`entry(k).or_insert(v)`)\n    #[effects(K, V, A, S)]\n    pub fn entry(&mut self, k: K) -> Entry<'_, K, V, A, S> {\n        // Room for one more first, as Rust's: a VacantEntry inserts with no\n        // hasher at hand.\n        self.reserve(1);\n        match self.find(&k) {\n            Option::Some(i) => Entry::Occupied(OccupiedEntry { map: self, bucket: i }),\n            Option::None => {\n                let hash = self.hash_of(&k);\n                Entry::Vacant(VacantEntry { map: self, key: k, hash: hash })\n            }\n        }\n    }\n\n    // A copy on another allocator, with a clone of the hasher.\n    #[effects(K, V, A, S, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> HashMap<K, V, B, S>\n        where\n            K: Clone,\n            V: Clone,\n            S: Clone,\n    {\n        let mut m = HashMap::with_capacity_and_hasher_in(self.len(), self.hasher.clone(), b);\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K, V, A: Allocator, S> crate::ops::Drop for HashMap<K, V, A, S> {\n    fn drop(&mut self) {\n        self.table.clear();\n        self.table.free_arrays();\n    }\n}\n\n// A copy on the same allocator (a clone of it).\n// std: changed: needs A: Clone and S: Clone\nimpl<K: Hash + Eq + Clone, V: Clone, A: Allocator + Clone,\n    S: BuildHasher + Clone> Clone for HashMap<K, V, A, S> {\n    fn clone(&self) -> HashMap<K, V, A, S> {\n        self.clone_in(self.table.alloc.clone())\n    }\n}\n\n// The same entries, in any order.\n// mvs: HashMap::impl Eq\n// std: changed: PartialEq; any two allocators\nimpl<K: Hash + Eq, V: PartialEq, A: Allocator, B: Allocator,\n    S: BuildHasher> PartialEq<HashMap<K, V, B, S>>\n    for HashMap<K, V, A, S>\n    {\n    fn eq(&self, other: &HashMap<K, V, B, S>) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n");
    buf_str(out, c"        self.iter().all(|(k, v)| other.get(k).map_or(false, |w| *v == *w))\n    }\n}\n\nimpl<K: Hash + Eq, V: Eq, A: Allocator, S: BuildHasher> Eq for HashMap<K, V, A, S> {}\n\n// `{k: v, ...}`.\n// mvs: HashMap::impl Debug\nimpl<K: Debug, V: Debug, A: Allocator, S> Debug for HashMap<K, V, A, S> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_map().entries(self.iter()).finish()\n    }\n}\n\n// `m[&k]`: the value; panics when k is not there.\nimpl<K: Hash + Eq + Borrow<Q>, Q: ?Sized + Hash + Eq, V, A: Allocator, S: BuildHasher> Index<&Q>\n    for HashMap<K, V, A, S>\n    {\n    type Output = V;\n\n    fn index(&self, k: &Q) -> &V {\n        self.get(k).expect(\"no entry found for key\")\n    }\n}\n\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher> Extend<(K, V)> for HashMap<K, V, A, S> {\n    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(k, v);\n        }\n    }\n}\n\nimpl<'a, K: Hash + Eq + Copy, V: Copy, A: Allocator,\n    S: BuildHasher> Extend<(&'a K, &'a V)> for HashMap<K, V, A, S> {\n    fn extend<I: IntoIterator<Item = (&'a K, &'a V)>>(&mut self, iter: I) {\n        for (k, v) in iter {\n            self.insert(*k, *v);\n        }\n    }\n}\n\n// `pairs.collect_in(a)` into a map with S's Default.\nimpl<K: Hash + Eq, V, A: Allocator, S: BuildHasher + Default> FromIteratorIn<(K, V),\n    A> for HashMap<K, V, A, S> {\n    fn from_iter_in<I: IntoIterator<Item = (K, V)>>(iter: I, a: A) -> HashMap<K, V, A, S> {\n        let mut m: HashMap<K, V, A, S> = HashMap::with_hasher_in(S::default(), a);\n        m.extend(iter);\n        m\n    }\n}\n\n// An empty map on a (`entry(k).or_default()` for map values).\nimpl<K, V, A: Allocator, S: Default> DefaultIn<A> for HashMap<K, V, A, S> {\n    fn default_in(a: A) -> HashMap<K, V, A, S> {\n        HashMap::with_hasher_in(S::default(), a)\n    }\n}\n\nimpl<K, V, A: Allocator, S> IntoIterator for HashMap<K, V, A, S> {\n");
    buf_str(out, c"    type Item = (K, V);\n    type IntoIter = IntoIter<K, V, A>;\n\n    fn into_iter(self) -> IntoIter<K, V, A> {\n        // HashMap has a Drop, so its table is moved out by hand: read, and\n        // the map forgotten once its hasher is dropped.\n        let me = self;\n        // UNSAFE: the table and the hasher are moved out of a value whose type\n        // implements Drop (Rust's E0509 forbids the plain move).\n        // SAFETY: each field is read once and me is forgotten right after, so\n        // neither is dropped twice and the table's arrays have one owner.\n        let table = unsafe { crate::ptr::read(&me.table as *const RawTable<(K, V), A>) };\n        // UNSAFE: the hasher moved out, as the table above.\n        // SAFETY: read once; me is forgotten right after.\n        let hasher = unsafe { crate::ptr::read(&me.hasher as *const S) };\n        crate::mem::forget(me);\n        crate::mem::drop(hasher);\n        IntoIter { table: table, at: 0 }\n    }\n}\n\nimpl<'a, K, V, A: Allocator, S> IntoIterator for &'a HashMap<K, V, A, S> {\n    type Item = (&'a K, &'a V);\n    type IntoIter = Iter<'a, K, V>;\n\n    fn into_iter(self) -> Iter<'a, K, V> {\n        self.iter()\n    }\n}\n\nimpl<'a, K, V, A: Allocator, S> IntoIterator for &'a mut HashMap<K, V, A, S> {\n    type Item = (&'a K, &'a mut V);\n    type IntoIter = IterMut<'a, K, V>;\n\n    fn into_iter(self) -> IterMut<'a, K, V> {\n        self.iter_mut()\n    }\n}\n\n// ---- Entry ----\n\n// A key's place in a map: Occupied (its entry is there) or Vacant.\npub enum Entry<'a, K, V, A: Allocator, S> {\n    Occupied(OccupiedEntry<'a, K, V, A, S>),\n    Vacant(VacantEntry<'a, K, V, A, S>),\n}\n\nimpl<'a, K: Hash + Eq, V, A: Allocator, S: BuildHasher> Entry<'a, K, V, A, S> {\n    // The value, after inserting default if it was vacant.\n    #[effects(K, V, A, S)]\n    pub fn or_insert(self, default: V) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n");
    buf_str(out, c"            Entry::Vacant(e) => e.insert(default),\n        }\n    }\n\n    // The value, after inserting f() if it was vacant.\n    #[effects(K, V, A, S, F)]\n    pub fn or_insert_with<F: FnOnce() -> V>(self, f: F) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => e.insert(f()),\n        }\n    }\n\n    // The value, after inserting f(&key) if it was vacant.\n    #[effects(K, V, A, S, F)]\n    pub fn or_insert_with_key<F: FnOnce(&K) -> V>(self, f: F) -> &'a mut V {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => {\n                let v = f(e.key());\n                e.insert(v)\n            }\n        }\n    }\n\n    // The value, after inserting V's empty value if it was vacant: a 0, a\n    // None, or an empty Vec on a clone of the map's allocator (DefaultIn).\n    #[effects(K, V, A, S)]\n    pub fn or_default(self) -> &'a mut V\n        where\n            V: DefaultIn<A>,\n            A: Clone,\n    {\n        match self {\n            Entry::Occupied(e) => e.into_mut(),\n            Entry::Vacant(e) => {\n                let v = V::default_in(e.map_allocator().clone());\n                e.insert(v)\n            }\n        }\n    }\n\n    // Calls f on the value if it is there; the entry back.\n    #[effects(K, V, A, S, F)]\n    pub fn and_modify<F: FnOnce(&mut V)>(self, f: F) -> Entry<'a, K, V, A, S> {\n        match self {\n            Entry::Occupied(mut e) => {\n                f(e.get_mut());\n                Entry::Occupied(e)\n            }\n            Entry::Vacant(e) => Entry::Vacant(e),\n        }\n    }\n\n    #[effects(K, V, A, S)]\n    pub fn key(&self) -> &K {\n        match self {\n            Entry::Occupied(e) => e.key(),\n            Entry::Vacant(e) => e.key(),\n        }\n    }\n}\n\n// An entry that is there.\npub struct OccupiedEntry<'a, K, V, A: Allocator, S> {\n    map: &'a mut HashMap<K, V, A, S>,\n");
    buf_str(out, c"    bucket: usize,\n}\n\nimpl<'a, K, V, A: Allocator, S> OccupiedEntry<'a, K, V, A, S> {\n    #[effects(K, V, A)]\n    pub fn key(&self) -> &K {\n        &self.map.table.slot(self.bucket).0\n    }\n\n    #[effects(K, V, A)]\n    pub fn get(&self) -> &V {\n        &self.map.table.slot(self.bucket).1\n    }\n\n    #[effects(K, V, A)]\n    pub fn get_mut(&mut self) -> &mut V {\n        &mut self.map.table.slot_mut(self.bucket).1\n    }\n\n    // The value, as long as the map's borrow.\n    #[effects(K, V, A)]\n    pub fn into_mut(self) -> &'a mut V {\n        let bucket = self.bucket;\n        let map = self.map;\n        &mut map.table.slot_mut(bucket).1\n    }\n\n    // Stores v; the old value.\n    #[effects(K, V, A, S)]\n    pub fn insert(&mut self, v: V) -> V {\n        crate::mem::replace(self.get_mut(), v)\n    }\n\n    // Removes the entry; its value.\n    #[effects(K, V, A, S)]\n    pub fn remove(self) -> V {\n        self.remove_entry().1\n    }\n\n    #[effects(K, V, A)]\n    pub fn remove_entry(self) -> (K, V) {\n        self.map.table.take(self.bucket)\n    }\n}\n\n// A key's place that is empty.\npub struct VacantEntry<'a, K, V, A: Allocator, S> {\n    map: &'a mut HashMap<K, V, A, S>,\n    key: K,\n    hash: u64,\n}\n\nimpl<'a, K, V, A: Allocator, S> VacantEntry<'a, K, V, A, S> {\n    #[effects()]\n    pub fn key(&self) -> &K {\n        &self.key\n    }\n\n    #[effects()]\n    pub fn into_key(self) -> K {\n        self.key\n    }\n\n    // Stores v under the key; a &mut to it, as long as the map's borrow.\n    #[effects(K, V, A)]\n    pub fn insert(self, v: V) -> &'a mut V {\n        let hash = self.hash;\n        let key = self.key;\n        let map = self.map;\n        // entry() reserved the room, so growth_left > 0 here.\n        let i = map.table.find_insert_slot(hash);\n        map.table.put(i, hash, (key, v));\n        &mut map.table.slot_mut(i).1\n    }\n\n    // The map's allocator (or_default's).\n    fn map_allocator(&self) -> &A {\n");
    buf_str(out, c"        self.map.allocator()\n    }\n}\n\n// ---- The iterators ----\n\n// HashMap::iter's iterator.\n// mvs: HashMapIter\n// std: renamed\npub struct Iter<'a, K, V> {\n    ctrl: *const u8,\n    data: *const (K, V),\n    at: usize,\n    left: usize,\n    marker: PhantomData<&'a (K, V)>,\n}\n\n// UNSAFE: Iter walks the table through raw pointers: stated, as Rust's.\n// SAFETY: it is a shared borrow of the entries for 'a (its PhantomData of\n// `&'a (K, V)`): Send and Sync as `&(K, V)` is.\nunsafe impl<'a, K: Sync, V: Sync> Send for Iter<'a, K, V> {}\n// UNSAFE: as Send's, above.\n// SAFETY: as Send's: it hands out only `&K` and `&V`.\nunsafe impl<'a, K: Sync, V: Sync> Sync for Iter<'a, K, V> {}\n\nimpl<'a, K, V> Clone for Iter<'a, K, V> {\n    fn clone(&self) -> Iter<'a, K, V> {\n        Iter { ctrl: self.ctrl, data: self.data, at: self.at, left: self.left, marker: PhantomData }\n    }\n}\n\nimpl<'a, K, V> Iterator for Iter<'a, K, V> {\n    type Item = (&'a K, &'a V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a V)> {\n        while self.left > 0 {\n            let i = self.at;\n            self.at += 1;\n            let c = self.ctrl;\n            let d = self.data;\n            // UNSAFE: the table's arrays read through the iterator's pointers.\n            // SAFETY: left > 0, so a full slot is at or after at, within the\n            // table's cap; the iterator borrows the map for 'a, so the entry\n            // stays where it is.\n            if unsafe { *c.add(i) } < DELETED {\n                self.left -= 1;\n                // UNSAFE: the full slot's entry lent for 'a.\n                // SAFETY: as above: in bounds, full, and the map is borrowed for 'a.\n                let e: &'a (K, V) = unsafe { &*d.add(i) };\n                return Option::Some((&e.0, &e.1));\n            }\n        }\n        Option::None\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.left, Option::Some(self.left))\n    }\n}\n\n");
    buf_str(out, c"impl<'a, K, V> ExactSizeIterator for Iter<'a, K, V> {}\n\n// HashMap::iter_mut's iterator.\npub struct IterMut<'a, K, V> {\n    ctrl: *const u8,\n    data: *mut (K, V),\n    at: usize,\n    left: usize,\n    marker: PhantomData<&'a mut (K, V)>,\n}\n\n// UNSAFE: IterMut walks the table through raw pointers: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the entries for 'a: sending it\n// sends what `&mut (K, V)` would (K: Send, V: Send).\nunsafe impl<'a, K: Send, V: Send> Send for IterMut<'a, K, V> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&IterMut` reads entries through `&K` and `&V` only.\nunsafe impl<'a, K: Sync, V: Sync> Sync for IterMut<'a, K, V> {}\n\nimpl<'a, K, V> Iterator for IterMut<'a, K, V> {\n    type Item = (&'a K, &'a mut V);\n\n    fn next(&mut self) -> Option<(&'a K, &'a mut V)> {\n        while self.left > 0 {\n            let i = self.at;\n            self.at += 1;\n            let c = self.ctrl;\n            let d = self.data;\n            // UNSAFE: the table's arrays read through the iterator's pointers.\n            // SAFETY: left > 0, so a full slot is at or after at, within the\n            // table's cap; the map is borrowed mutably for 'a and each slot is\n            // given out once (at only grows), so the &mut V's do not alias.\n            if unsafe { *c.add(i) } < DELETED {\n                self.left -= 1;\n                // UNSAFE: the full slot's entry lent mutably for 'a.\n                // SAFETY: as above: in bounds, full, each slot given out once.\n                let e: &'a mut (K, V) = unsafe { &mut *d.add(i) };\n                return Option::Some((&e.0, &mut e.1));\n            }\n        }\n        Option::None\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.left, Option::Some(self.left))\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for IterMut<'a, K, V> {}\n\n// HashMap::keys's iterator.\n// mvs: Keys\npub struct Keys<'a, K, V> {\n    inner: Iter<'a, K, V>,\n}\n\n");
    buf_str(out, c"impl<'a, K, V> Iterator for Keys<'a, K, V> {\n    type Item = &'a K;\n\n    fn next(&mut self) -> Option<&'a K> {\n        self.inner.next().map(|(k, _)| k)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Keys<'a, K, V> {}\n\n// HashMap::values's iterator.\n// mvs: Values\npub struct Values<'a, K, V> {\n    inner: Iter<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for Values<'a, K, V> {\n    type Item = &'a V;\n\n    fn next(&mut self) -> Option<&'a V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\nimpl<'a, K, V> ExactSizeIterator for Values<'a, K, V> {}\n\n// HashMap::values_mut's iterator.\npub struct ValuesMut<'a, K, V> {\n    inner: IterMut<'a, K, V>,\n}\n\nimpl<'a, K, V> Iterator for ValuesMut<'a, K, V> {\n    type Item = &'a mut V;\n\n    fn next(&mut self) -> Option<&'a mut V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\n// A map's entries, by value.\npub struct IntoIter<K, V, A: Allocator> {\n    table: RawTable<(K, V), A>,\n    at: usize,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoIter<K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        let i = self.table.next_full(self.at);\n        if i >= self.table.cap {\n            return Option::None;\n        }\n        self.at = i + 1;\n        Option::Some(self.table.take(i))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.table.items, Option::Some(self.table.items))\n    }\n}\n\nimpl<K, V, A: Allocator> ExactSizeIterator for IntoIter<K, V, A> {}\n\n// HashMap::into_keys's iterator.\npub struct IntoKeys<K, V, A: Allocator> {\n    inner: IntoIter<K, V, A>,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoKeys<K, V, A> {\n    type Item = K;\n\n");
    buf_str(out, c"    fn next(&mut self) -> Option<K> {\n        self.inner.next().map(|(k, _)| k)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\n// HashMap::into_values's iterator.\npub struct IntoValues<K, V, A: Allocator> {\n    inner: IntoIter<K, V, A>,\n}\n\nimpl<K, V, A: Allocator> Iterator for IntoValues<K, V, A> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        self.inner.next().map(|(_, v)| v)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.inner.size_hint()\n    }\n}\n\n// HashMap::drain's iterator.\npub struct Drain<'a, K, V, A: Allocator> {\n    table: *mut RawTable<(K, V), A>,\n    at: usize,\n    marker: PhantomData<&'a mut RawTable<(K, V), A>>,\n}\n\n// UNSAFE: Drain reaches its table through a raw pointer: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the table for 'a: Send and Sync as\n// `&'a mut RawTable<(K, V), A>` is.\nunsafe impl<'a, K: Send, V: Send, A: Allocator + Send> Send for Drain<'a, K, V, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Drain` reads entries through `&K` and `&V` only.\nunsafe impl<'a, K: Sync, V: Sync, A: Allocator + Sync> Sync for Drain<'a, K, V, A> {}\n\nimpl<'a, K, V, A: Allocator> Iterator for Drain<'a, K, V, A> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        // UNSAFE: the table reached through the pointer drain took.\n        // SAFETY: the Drain borrows the map mutably for 'a, so the table is\n        // valid and nothing else uses it.\n        let t = unsafe { &mut *self.table };\n        let i = t.next_full(self.at);\n        if i >= t.cap {\n            return Option::None;\n        }\n        self.at = i + 1;\n        Option::Some(t.take(i))\n    }\n}\n\nimpl<'a, K, V, A: Allocator> crate::ops::Drop for Drain<'a, K, V, A> {\n    fn drop(&mut self) {\n        // UNSAFE: the table reached through the pointer drain took.\n");
    buf_str(out, c"        // SAFETY: as in next: the map is borrowed mutably for 'a.\n        let t = unsafe { &mut *self.table };\n        t.clear();\n    }\n}\n// ---- end mod std::collections::hash_map ----\n}\n// ---- mod std::collections::hash_set ----\npub mod hash_set {\n// std::collections::hash_set: HashSet<T, A, S>, a HashMap<T, (), A, S>,\n// and its iterators. As HashMap: A and S always written, S last\n// (`HashSet<T, Gpa, FixedState>`; `new_in` makes a FixedState), lookups by\n// a reference to anything T Borrows.\n\nuse crate::alloc::Allocator;\nuse crate::borrow::Borrow;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::default::{Default, DefaultIn};\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{BuildHasher, FixedState, Hash};\nuse crate::iter::{Extend, FromIteratorIn, IntoIterator, Iterator};\nuse crate::option::Option;\n\nuse super::hash_map::{HashMap, self};\n\n// A set of T on A, hashed by S.\n// std: changed: an S, always written; T's bounds moved to the impls\npub struct HashSet<T, A: Allocator, S: BuildHasher> {\n    map: HashMap<T, (), A, S>,\n}\n\nimpl<T, A: Allocator> HashSet<T, A, FixedState> {\n    #[effects(T, A)]\n    pub fn new_in(a: A) -> HashSet<T, A, FixedState> {\n        HashSet { map: HashMap::new_in(a) }\n    }\n\n    #[effects(T, A)]\n    pub fn with_capacity_in(n: usize, a: A) -> HashSet<T, A, FixedState> {\n        HashSet { map: HashMap::with_capacity_in(n, a) }\n    }\n}\n\nimpl<T, A: Allocator, S> HashSet<T, A, S> {\n    #[effects(T, A, S)]\n    pub fn with_hasher_in(hasher: S, a: A) -> HashSet<T, A, S> {\n        HashSet { map: HashMap::with_hasher_in(hasher, a) }\n    }\n\n    #[effects(T, A, S)]\n    pub fn len(&self) -> usize {\n        self.map.len()\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_empty(&self) -> bool {\n        self.map.is_empty()\n    }\n\n    #[effects(T, A, S)]\n    pub fn capacity(&self) -> usize {\n        self.map.capacity()\n    }\n\n    // std: changed: returns &A\n");
    buf_str(out, c"    #[effects(T, A, S)]\n    pub fn allocator(&self) -> &A {\n        self.map.allocator()\n    }\n\n    #[effects(T, A, S)]\n    pub fn hasher(&self) -> &S {\n        self.map.hasher()\n    }\n\n    // Its elements, by reference.\n    // std: changed: yields &T\n    #[effects(T, A, S)]\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { inner: self.map.keys() }\n    }\n\n    #[effects(T, A, S)]\n    pub fn clear(&mut self) {\n        self.map.clear()\n    }\n\n    // Every element, removed and yielded by the iterator.\n    #[effects(T, A, S)]\n    pub fn drain(&mut self) -> Drain<'_, T, A> {\n        Drain { inner: self.map.drain() }\n    }\n\n    // Keeps the elements f says true of.\n    #[effects(T, A, S)]\n    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        self.map.retain(|k, _| f(k))\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> HashSet<T, A, S> {\n    #[effects(T, A, S)]\n    pub fn reserve(&mut self, n: usize) {\n        self.map.reserve(n)\n    }\n\n    // std: changed: takes &Q\n    #[effects(T, A, S, Q)]\n    pub fn contains<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.contains_key(x)\n    }\n\n    // The stored element equal to x.\n    #[effects(T, A, S, Q)]\n    pub fn get<Q: ?Sized + Hash + Eq>(&self, x: &Q) -> Option<&T>\n        where\n            T: Borrow<Q>,\n    {\n        self.map.get_key_value(x).map(|(k, _)| k)\n    }\n\n    // Adds x; false when it was there already.\n    #[effects(T, A, S)]\n    pub fn insert(&mut self, x: T) -> bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    // Adds x, replacing an equal element; the old one.\n    #[effects(T, A, S)]\n    pub fn replace(&mut self, x: T) -> Option<T> {\n        let old = self.map.remove_entry(&x);\n        self.map.insert(x, ());\n        match old {\n            Option::Some((k, _)) => Option::Some(k),\n            Option::None => Option::None,\n");
    buf_str(out, c"        }\n    }\n\n    // Removes x; whether it was there.\n    // std: changed: takes &Q\n    #[effects(T, A, S, Q)]\n    pub fn remove<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> bool\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove(x).is_some()\n    }\n\n    // Removes and returns the stored element equal to x.\n    #[effects(T, A, S, Q)]\n    pub fn take<Q: ?Sized + Hash + Eq>(&mut self, x: &Q) -> Option<T>\n        where\n            T: Borrow<Q>,\n    {\n        self.map.remove_entry(x).map(|(k, _)| k)\n    }\n\n    // The elements of either, each once.\n    #[effects(T, A, S)]\n    pub fn union<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Union<'a, T, A, S> {\n        Union { a: self.iter(), b: other.iter(), a_set: self }\n    }\n\n    // The elements of both.\n    #[effects(T, A, S)]\n    pub fn intersection<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Intersection<'a, T, A, S> {\n        Intersection { a: self.iter(), other: other }\n    }\n\n    // The elements of self that other has not.\n    #[effects(T, A, S)]\n    pub fn difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> Difference<'a, T, A, S> {\n        Difference { a: self.iter(), other: other }\n    }\n\n    // The elements of one of them only.\n    #[effects(T, A, S)]\n    pub fn symmetric_difference<'a>(&'a self, other: &'a HashSet<T, A, S>) -> SymmetricDifference<'a, T, A, S> {\n        SymmetricDifference { a: self.difference(other), b: other.difference(self) }\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_disjoint(&self, other: &HashSet<T, A, S>) -> bool {\n        self.iter().all(|x| !other.contains(x))\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_subset(&self, other: &HashSet<T, A, S>) -> bool {\n        self.iter().all(|x| other.contains(x))\n    }\n\n    #[effects(T, A, S)]\n    pub fn is_superset(&self, other: &HashSet<T, A, S>) -> bool {\n        other.is_subset(self)\n    }\n}\n\n// std: changed: needs A: Clone and S: Clone\n");
    buf_str(out, c"impl<T: Hash + Eq + Clone, A: Allocator + Clone, S: BuildHasher + Clone> Clone for HashSet<T, A,\n    S> {\n    fn clone(&self) -> HashSet<T, A, S> {\n        HashSet { map: self.map.clone() }\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, B: Allocator,\n    S: BuildHasher> PartialEq<HashSet<T, B, S>> for HashSet<T, A, S> {\n    fn eq(&self, other: &HashSet<T, B, S>) -> bool {\n        self.len() == other.len() && self.iter().all(|x| other.contains(x))\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> Eq for HashSet<T, A, S> {}\n\nimpl<T: Debug, A: Allocator, S> Debug for HashSet<T, A, S> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_set().entries(self.iter()).finish()\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher> Extend<T> for HashSet<T, A, S> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.insert(x);\n        }\n    }\n}\n\nimpl<T: Hash + Eq, A: Allocator, S: BuildHasher + Default> FromIteratorIn<T, A> for HashSet<T, A,\n    S> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> HashSet<T, A, S> {\n        let mut s: HashSet<T, A, S> = HashSet::with_hasher_in(S::default(), a);\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T, A: Allocator, S: Default> DefaultIn<A> for HashSet<T, A, S> {\n    fn default_in(a: A) -> HashSet<T, A, S> {\n        HashSet::with_hasher_in(S::default(), a)\n    }\n}\n\nimpl<T, A: Allocator, S> IntoIterator for HashSet<T, A, S> {\n    type Item = T;\n    type IntoIter = IntoIter<T, A>;\n\n    fn into_iter(self) -> IntoIter<T, A> {\n        IntoIter { inner: self.map.into_keys() }\n    }\n}\n\nimpl<'a, T, A: Allocator, S> IntoIterator for &'a HashSet<T, A, S> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\n// HashSet::iter's iterator.\n// mvs: HashSetIter\n// std: renamed\npub struct Iter<'a, T> {\n");
    buf_str(out, c"    inner: hash_map::Keys<'a, T, ()>,\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        self.inner.next()\n    }\n}\n\n// A set's elements, by value.\npub struct IntoIter<T, A: Allocator> {\n    inner: hash_map::IntoKeys<T, (), A>,\n}\n\nimpl<T, A: Allocator> Iterator for IntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.next()\n    }\n}\n\n// HashSet::drain's iterator.\npub struct Drain<'a, T, A: Allocator> {\n    inner: hash_map::Drain<'a, T, (), A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.inner.next().map(|(k, _)| k)\n    }\n}\n\n// HashSet::union's iterator.\npub struct Union<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    b: Iter<'a, T>,\n    a_set: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Union<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        if let Option::Some(x) = self.a.next() {\n            return Option::Some(x);\n        }\n        while let Option::Some(x) = self.b.next() {\n            if !self.a_set.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::intersection's iterator.\npub struct Intersection<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n    other: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Intersection<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        while let Option::Some(x) = self.a.next() {\n            if self.other.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::difference's iterator.\npub struct Difference<'a, T, A: Allocator, S> {\n    a: Iter<'a, T>,\n");
    buf_str(out, c"    other: &'a HashSet<T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for Difference<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        while let Option::Some(x) = self.a.next() {\n            if !self.other.contains(x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// HashSet::symmetric_difference's iterator.\npub struct SymmetricDifference<'a, T, A: Allocator, S> {\n    a: Difference<'a, T, A, S>,\n    b: Difference<'a, T, A, S>,\n}\n\nimpl<'a, T: Hash + Eq, A: Allocator, S: BuildHasher> Iterator for SymmetricDifference<'a, T, A, S> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.a.next() {\n            Option::Some(x) => Option::Some(x),\n            Option::None => self.b.next(),\n        }\n    }\n}\n// ---- end mod std::collections::hash_set ----\n}\n// ---- end mod std::collections ----\n}\n// ---- mod std::iter ----\npub mod iter {\n// std::iter: Iterator, the traits around it, the adapters and the\n// sources. Rust's shape: an adapter takes self by value and returns a\n// named struct (no `impl Trait` in return position), a closure that only\n// looks takes `&Self::Item` (filter, find, position's FnMut(Self::Item)),\n// and what collects names its allocator: `collect_in(a)` over\n// FromIteratorIn, the result's type given by the context (`let v:\n// Vec<_, Gpa> = it.collect_in(gpa);`) or a turbofish.\n\nmod adapters;\nmod sources;\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::cmp::{Ord, Ordering, PartialEq, PartialOrd};\nuse crate::default::DefaultIn;\nuse crate::ops::{Add, Mul, Range, RangeFrom, RangeInclusive};\nuse crate::option::Option;\n\npub use adapters::{\n    Chain, Cloned, Copied, Cycle, Enumerate, Filter, FilterMap, FlatMap, Flatten, Fuse, Inspect,\n    Map, MapWhile, Peekable, Rev, Scan, Skip, SkipWhile, StepBy, Take, TakeWhile, Zip,\n};\n");
    buf_str(out, c"pub use sources::{\n    Empty, FromFn, Once, Repeat, RepeatN, Successors, empty, from_fn, once, repeat, repeat_n,\n    successors, zip,\n};\n\n// A sequence of Items, one per `next` until None.\npub trait Iterator {\n    type Item;\n\n    fn next(&mut self) -> Option<Self::Item>;\n\n    // (at least, at most) items left; (0, None) when it cannot say.\n    // mvs: Iterator::exact_len\n    // std: changed: Rust's size_hint (MVS: an exact length or -1)\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, Option::None)\n    }\n\n    // The items left, counted by consuming them.\n    fn count(self) -> usize\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut n: usize = 0;\n        while let Option::Some(_) = it.next() {\n            n += 1;\n        }\n        n\n    }\n\n    fn last(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        self.fold(Option::None, |_, x| Option::Some(x))\n    }\n\n    // Item n (from 0), the ones before it consumed.\n    // mvs: Iterator::at\n    // std: changed: Rust's nth, an Option (MVS: at(k), the item or a panic)\n    fn nth(&mut self, n: usize) -> Option<Self::Item> {\n        // (a counted loop: n steps at most, whatever the iterator)\n        for _ in 0..n {\n            self.next()?;\n        }\n        self.next()\n    }\n\n    // Every step-th item, the first included; step > 0.\n    fn step_by(self, step: usize) -> StepBy<Self>\n        where\n            Self: Sized,\n    {\n        StepBy::new(self, step)\n    }\n\n    // Its items, then other's.\n    fn chain<U: IntoIterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U::IntoIter>\n        where\n            Self: Sized,\n    {\n        Chain::new(self, other.into_iter())\n    }\n\n    // Pairs of its items and other's, until either ends.\n    // std: changed: takes any IntoIterator (MVS: an Iterator)\n    fn zip<U: IntoIterator>(self, other: U) -> Zip<Self, U::IntoIter>\n        where\n");
    buf_str(out, c"            Self: Sized,\n    {\n        Zip::new(self, other.into_iter())\n    }\n\n    // f of each item.\n    // std: changed: Rust's FnMut(Self::Item) (MVS: a sink Item)\n    fn map<B, F: FnMut(Self::Item) -> B>(self, f: F) -> Map<Self, F>\n        where\n            Self: Sized,\n    {\n        Map::new(self, f)\n    }\n\n    // Calls f on each item, in order.\n    fn for_each<F: FnMut(Self::Item)>(self, f: F)\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.fold((), |_, x| f(x));\n    }\n\n    // The items predicate says true of.\n    // std: changed: the predicate takes &Self::Item\n    fn filter<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> Filter<Self, P>\n        where\n            Self: Sized,\n    {\n        Filter::new(self, predicate)\n    }\n\n    // The Some values f gives.\n    fn filter_map<B, F: FnMut(Self::Item) -> Option<B>>(self, f: F) -> FilterMap<Self, F>\n        where\n            Self: Sized,\n    {\n        FilterMap::new(self, f)\n    }\n\n    // (index, item) pairs, from 0.\n    fn enumerate(self) -> Enumerate<Self>\n        where\n            Self: Sized,\n    {\n        Enumerate::new(self)\n    }\n\n    // An iterator that can look at its next item without taking it.\n    fn peekable(self) -> Peekable<Self>\n        where\n            Self: Sized,\n    {\n        Peekable::new(self)\n    }\n\n    fn skip_while<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> SkipWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        SkipWhile::new(self, predicate)\n    }\n\n    fn take_while<P: FnMut(&Self::Item) -> bool>(self, predicate: P) -> TakeWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        TakeWhile::new(self, predicate)\n    }\n\n    // f's values until it gives None.\n    fn map_while<B, P: FnMut(Self::Item) -> Option<B>>(self, predicate: P) -> MapWhile<Self, P>\n        where\n            Self: Sized,\n    {\n        MapWhile::new(self, predicate)\n");
    buf_str(out, c"    }\n\n    fn skip(self, n: usize) -> Skip<Self>\n        where\n            Self: Sized,\n    {\n        Skip::new(self, n)\n    }\n\n    // The first n items.\n    fn take(self, n: usize) -> Take<Self>\n        where\n            Self: Sized,\n    {\n        Take::new(self, n)\n    }\n\n    // f's values, f keeping a state across items; None from f ends it.\n    fn scan<St, B,\n        F: FnMut(&mut St, Self::Item) -> Option<B>>(self, initial_state: St, f: F) -> Scan<Self, St,\n        F>\n        where\n            Self: Sized,\n    {\n        Scan::new(self, initial_state, f)\n    }\n\n    // The items of each f(item), in order.\n    fn flat_map<U: IntoIterator, F: FnMut(Self::Item) -> U>(self, f: F) -> FlatMap<Self, U, F>\n        where\n            Self: Sized,\n    {\n        FlatMap::new(self, f)\n    }\n\n    // The items of each item (an iterator of iterators, of Options, of Vecs).\n    fn flatten(self) -> Flatten<Self>\n        where\n            Self: Sized,\n            Self::Item: IntoIterator,\n    {\n        Flatten::new(self)\n    }\n\n    // None for ever once it has given None.\n    fn fuse(self) -> Fuse<Self>\n        where\n            Self: Sized,\n    {\n        Fuse::new(self)\n    }\n\n    // Calls f on a reference to each item as it passes.\n    fn inspect<F: FnMut(&Self::Item)>(self, f: F) -> Inspect<Self, F>\n        where\n            Self: Sized,\n    {\n        Inspect::new(self, f)\n    }\n\n    // The iterator borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n\n    // The items, collected into a B on a (`collect_in::<Vec<_, _>>(gpa)`,\n    // or the result's type from the context).\n    // std: changed: generic in its result B (MVS: always a Vec)\n    // later: return_inference\n    fn collect_in<B: FromIteratorIn<Self::Item, A>, A: Allocator>(self, a: A) -> B\n        where\n            Self: Sized,\n    {\n");
    buf_str(out, c"        B::from_iter_in(self, a)\n    }\n\n    // (the items f says true of, the others), each a B on a clone of a.\n    // later: return_inference\n    fn partition_in<B, F: FnMut(&Self::Item) -> bool, A: Allocator + Clone>(self, f: F, a: A) -> (B,\n        B)\n        where\n            Self: Sized,\n            B: DefaultIn<A> + Extend<Self::Item>,\n    {\n        let mut f = f;\n        let mut yes: B = B::default_in(a.clone());\n        let mut no: B = B::default_in(a);\n        let mut it = self;\n        while let Option::Some(x) = it.next() {\n            if f(&x) {\n                yes.extend(Option::Some(x));\n            } else {\n                no.extend(Option::Some(x));\n            }\n        }\n        (yes, no)\n    }\n\n    // The items' pairs split into two collections on a clone of a.\n    // later: return_inference\n    fn unzip_in<X, Y, FromX, FromY, A: Allocator + Clone>(self, a: A) -> (FromX, FromY)\n        where\n            FromX: DefaultIn<A> + Extend<X>,\n            FromY: DefaultIn<A> + Extend<Y>,\n            Self: Sized + Iterator<Item = (X, Y)>,\n    {\n        let mut xs: FromX = FromX::default_in(a.clone());\n        let mut ys: FromY = FromY::default_in(a);\n        let mut it = self;\n        while let Option::Some((x, y)) = it.next() {\n            xs.extend(Option::Some(x));\n            ys.extend(Option::Some(y));\n        }\n        (xs, ys)\n    }\n\n    // f(f(f(init, a), b), c), for items a, b, c.\n    fn fold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut f = f;\n        let mut acc = init;\n        while let Option::Some(x) = it.next() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    // fold, starting from the first item; None when there is none.\n    fn reduce<F: FnMut(Self::Item, Self::Item) -> Self::Item>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n");
    buf_str(out, c"        let mut it = self;\n        let first = it.next()?;\n        Option::Some(it.fold(first, f))\n    }\n\n    // Whether f is true of every item (true when there is none); stops at\n    // the first false.\n    fn all<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if !f(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // Whether f is true of an item; stops at the first true.\n    fn any<F: FnMut(Self::Item) -> bool>(&mut self, f: F) -> bool {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if f(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // The first item predicate says true of.\n    // std: changed: the predicate takes &Self::Item\n    fn find<P: FnMut(&Self::Item) -> bool>(&mut self, predicate: P) -> Option<Self::Item> {\n        let mut p = predicate;\n        while let Option::Some(x) = self.next() {\n            if p(&x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n\n    // The first Some that f gives.\n    fn find_map<B, F: FnMut(Self::Item) -> Option<B>>(&mut self, f: F) -> Option<B> {\n        let mut f = f;\n        while let Option::Some(x) = self.next() {\n            if let Option::Some(y) = f(x) {\n                return Option::Some(y);\n            }\n        }\n        Option::None\n    }\n\n    // The index of the first item predicate says true of.\n    fn position<P: FnMut(Self::Item) -> bool>(&mut self, predicate: P) -> Option<usize> {\n        let mut p = predicate;\n        let mut i: usize = 0;\n        while let Option::Some(x) = self.next() {\n            if p(x) {\n                return Option::Some(i);\n            }\n            i += 1;\n        }\n        Option::None\n    }\n\n    // The index of the last item predicate says true of, from the end.\n");
    buf_str(out, c"    fn rposition<P: FnMut(Self::Item) -> bool>(&mut self, predicate: P) -> Option<usize>\n        where\n            Self: Sized + ExactSizeIterator + DoubleEndedIterator,\n    {\n        let mut p = predicate;\n        let mut i: usize = self.len();\n        while let Option::Some(x) = self.next_back() {\n            i -= 1;\n            if p(x) {\n                return Option::Some(i);\n            }\n        }\n        Option::None\n    }\n\n    // The largest item; the last of equal ones.\n    // std: changed: Item: Ord, Rust's\n    fn max(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n            Self::Item: Ord,\n    {\n        self.max_by(|a, b| a.cmp(b))\n    }\n\n    // The smallest item; the first of equal ones.\n    // std: changed: Item: Ord, Rust's\n    fn min(self) -> Option<Self::Item>\n        where\n            Self: Sized,\n            Self::Item: Ord,\n    {\n        self.min_by(|a, b| a.cmp(b))\n    }\n\n    fn max_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.max_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    fn max_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, compare: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut c = compare;\n        self.reduce(|a, b| if c(&a, &b).is_gt() { a } else { b })\n    }\n\n    fn min_by_key<B: Ord, F: FnMut(&Self::Item) -> B>(self, f: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut f = f;\n        self.min_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    fn min_by<F: FnMut(&Self::Item, &Self::Item) -> Ordering>(self, compare: F) -> Option<Self::Item>\n        where\n            Self: Sized,\n    {\n        let mut c = compare;\n        self.reduce(|a, b| if c(&b, &a).is_lt() { b } else { a })\n    }\n\n    // Its items from the end.\n    fn rev(self) -> Rev<Self>\n        where\n");
    buf_str(out, c"            Self: Sized + DoubleEndedIterator,\n    {\n        Rev::new(self)\n    }\n\n    // Copies of the items of an iterator of &U (`v.iter().copied()`).\n    // (U and 'b, not Rust's T and 'a: the impl's own parameters, `impl<'a,\n    // T> Iterator for Iter<'a, T>`, are in scope in the default body's\n    // copy, and a name of both would bind the impl's.)\n    fn copied<'b, U: Copy + 'b>(self) -> Copied<Self>\n        where\n            Self: Sized + Iterator<Item = &'b U>,\n    {\n        Copied::new(self)\n    }\n\n    fn cloned<'b, U: Clone + 'b>(self) -> Cloned<Self>\n        where\n            Self: Sized + Iterator<Item = &'b U>,\n    {\n        Cloned::new(self)\n    }\n\n    // Its items again and again (it must be Clone).\n    fn cycle(self) -> Cycle<Self>\n        where\n            Self: Sized + Clone,\n    {\n        Cycle::new(self)\n    }\n\n    // The items' sum (`let s: i64 = v.iter().sum();`).\n    // std: changed: S: Sum<Self::Item> (MVS: the Item itself)\n    // later: return_inference\n    fn sum<S: Sum<Self::Item>>(self) -> S\n        where\n            Self: Sized,\n    {\n        S::sum(self)\n    }\n\n    // later: return_inference\n    fn product<P: Product<Self::Item>>(self) -> P\n        where\n            Self: Sized,\n    {\n        P::product(self)\n    }\n\n    // Lexicographic, item by item.\n    fn cmp<I: IntoIterator<Item = Self::Item>>(self, other: I) -> Ordering\n        where\n            Self::Item: Ord,\n            Self: Sized,\n    {\n        let mut me = self;\n        let mut other = other.into_iter();\n        loop {\n            match (me.next(), other.next()) {\n                (Option::None, Option::None) => return Ordering::Equal,\n                (Option::None, Option::Some(_)) => return Ordering::Less,\n                (Option::Some(_), Option::None) => return Ordering::Greater,\n                (Option::Some(x), Option::Some(y)) => match x.cmp(&y) {\n                    Ordering::Equal => {}\n");
    buf_str(out, c"                    o => return o,\n                },\n            }\n        }\n    }\n\n    fn partial_cmp<I: IntoIterator>(self, other: I) -> Option<Ordering>\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        let mut me = self;\n        let mut other = other.into_iter();\n        loop {\n            match (me.next(), other.next()) {\n                (Option::None, Option::None) => return Option::Some(Ordering::Equal),\n                (Option::None, Option::Some(_)) => return Option::Some(Ordering::Less),\n                (Option::Some(_), Option::None) => return Option::Some(Ordering::Greater),\n                (Option::Some(x), Option::Some(y)) => match x.partial_cmp(&y) {\n                    Option::Some(Ordering::Equal) => {}\n                    o => return o,\n                },\n            }\n        }\n    }\n\n    // Whether the two have equal items, in order.\n    fn eq<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialEq<I::Item>,\n            Self: Sized,\n    {\n        let mut me = self;\n        let mut other = other.into_iter();\n        loop {\n            match (me.next(), other.next()) {\n                (Option::None, Option::None) => return true,\n                (Option::Some(x), Option::Some(y)) => {\n                    if x != y {\n                        return false;\n                    }\n                }\n                _ => return false,\n            }\n        }\n    }\n\n    fn ne<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialEq<I::Item>,\n            Self: Sized,\n    {\n        !self.eq(other)\n    }\n\n    fn lt<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        self.partial_cmp(other) == Option::Some(Ordering::Less)\n    }\n\n    fn le<I: IntoIterator>(self, other: I) -> bool\n        where\n");
    buf_str(out, c"            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Less) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    fn gt<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        self.partial_cmp(other) == Option::Some(Ordering::Greater)\n    }\n\n    fn ge<I: IntoIterator>(self, other: I) -> bool\n        where\n            Self::Item: PartialOrd<I::Item>,\n            Self: Sized,\n    {\n        match self.partial_cmp(other) {\n            Option::Some(Ordering::Greater) | Option::Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    // Whether each item is <= the next.\n    fn is_sorted(self) -> bool\n        where\n            Self: Sized,\n            Self::Item: PartialOrd,\n    {\n        let mut it = self;\n        let mut last = match it.next() {\n            Option::Some(x) => x,\n            Option::None => return true,\n        };\n        while let Option::Some(x) = it.next() {\n            if !(last <= x) {\n                return false;\n            }\n            last = x;\n        }\n        true\n    }\n}\n\n// A mutable borrow of an iterator is one (`it.by_ref().take(3)`).\nimpl<I: Iterator + ?Sized> Iterator for &mut I {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        (**self).next()\n    }\n}\n\n// An iterator that can also give its items from the end.\npub trait DoubleEndedIterator: Iterator {\n    fn next_back(&mut self) -> Option<Self::Item>;\n\n    // Item n from the end.\n    fn nth_back(&mut self, n: usize) -> Option<Self::Item> {\n        let mut n = n;\n        while n > 0 {\n            self.next_back()?;\n            n -= 1;\n        }\n        self.next_back()\n    }\n\n    // fold, from the end.\n");
    buf_str(out, c"    fn rfold<B, F: FnMut(B, Self::Item) -> B>(self, init: B, f: F) -> B\n        where\n            Self: Sized,\n    {\n        let mut it = self;\n        let mut f = f;\n        let mut acc = init;\n        while let Option::Some(x) = it.next_back() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    // find, from the end.\n    fn rfind<P: FnMut(&Self::Item) -> bool>(&mut self, predicate: P) -> Option<Self::Item> {\n        let mut p = predicate;\n        while let Option::Some(x) = self.next_back() {\n            if p(&x) {\n                return Option::Some(x);\n            }\n        }\n        Option::None\n    }\n}\n\n// An iterator that knows how many items are left: size_hint is exact.\npub trait ExactSizeIterator: Iterator {\n    fn len(&self) -> usize {\n        self.size_hint().0\n    }\n\n    fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n}\n\n// An iterator that gives None for ever after its first None.\npub trait FusedIterator: Iterator {}\n\n// What a `for` loop iterates: an iterator itself, a collection by value\n// (its items), by & (references) or by &mut.\npub trait IntoIterator {\n    type Item;\n    type IntoIter: Iterator<Item = Self::Item>;\n\n    fn into_iter(self) -> Self::IntoIter;\n}\n\n// Every iterator is one.\n// later: blanket_impl\nimpl<I: Iterator> IntoIterator for I {\n    type Item = I::Item;\n    type IntoIter = I;\n\n    fn into_iter(self) -> I {\n        self\n    }\n}\n\n// Rust's FromIterator, with the allocator named: what `collect_in(a)`\n// makes (Vec, String, HashMap, HashSet).\n// mvs: Iterator::collect_in\npub trait FromIteratorIn<T, A>: Sized {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Self;\n}\n\n// A collection that items can be added to (`v.extend(it)`); it grows\n// from its own allocator.\npub trait Extend<T> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I);\n}\n\n// What `sum` adds up to: numbers from numbers or from references to them.\n");
    buf_str(out, c"// Built in, for each type P listed: `Sum for P` and `Sum<&'a P> for P`\n// (`iter.fold(0, |a, b| a + b)`, of references `a + *b`).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Sum<A = Self>: Sized {\n    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// What `product` multiplies up to. Built in as Sum is, with 1 and `*`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait Product<A = Self>: Sized {\n    fn product<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// What ranges iterate over: the integers and char. Sealed: std's impls\n// only (built in for each integer type; char's waits for char).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Step: Clone + PartialOrd + Sized {\n    // How many steps from start to end; None when end < start or too many.\n    fn steps_between(start: &Self, end: &Self) -> (usize, Option<usize>);\n    // start + count, None on overflow.\n    fn forward_checked(start: Self, count: usize) -> Option<Self>;\n    // start - count, None on overflow.\n    fn backward_checked(start: Self, count: usize) -> Option<Self>;\n}\n\n// `for i in 0..n`.\n// mvs: Range::impl Iterator\nimpl<A: Step> Iterator for Range<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.start < self.end {\n            let n = Step::forward_checked(self.start.clone(), 1)?;\n            Option::Some(crate::mem::replace(&mut self.start, n))\n        } else {\n            Option::None\n        }\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        // (`A::`: the front reads `Step::steps_between(..)` here as the\n        // return type's)\n        A::steps_between(&self.start, &self.end)\n    }\n}\n\n// `(0..n).rev()`.\nimpl<A: Step> DoubleEndedIterator for Range<A> {\n    fn next_back(&mut self) -> Option<A> {\n        if self.start < self.end {\n");
    buf_str(out, c"            self.end = Step::backward_checked(self.end.clone(), 1)?;\n            Option::Some(self.end.clone())\n        } else {\n            Option::None\n        }\n    }\n}\n\nimpl<A: Step> ExactSizeIterator for Range<A> {}\n\n// `for i in 0..=n`, `(0..=n).rev()`.\n// mvs: RangeInclusive::impl Iterator\nimpl<A: Step> Iterator for RangeInclusive<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        // RangeInclusive's fields are ops's (Rust's are pub(crate)): the\n        // range is remade through its constructor, empty once spent.\n        if self.is_empty() {\n            return Option::None;\n        }\n        let start = self.start().clone();\n        let end = self.end().clone();\n        if start < end {\n            let n = Step::forward_checked(start.clone(), 1)?;\n            *self = RangeInclusive::new(n, end);\n        } else {\n            *self = spent(end);\n        }\n        Option::Some(start)\n    }\n}\n\nimpl<A: Step> DoubleEndedIterator for RangeInclusive<A> {\n    fn next_back(&mut self) -> Option<A> {\n        if self.is_empty() {\n            return Option::None;\n        }\n        let start = self.start().clone();\n        let end = self.end().clone();\n        if start < end {\n            let p = Step::backward_checked(end.clone(), 1)?;\n            *self = RangeInclusive::new(start, p);\n        } else {\n            *self = spent(start);\n        }\n        Option::Some(end)\n    }\n}\n\n// An empty range next to at: what a RangeInclusive becomes when its last\n// item is taken.\nfn spent<A: Step>(at: A) -> RangeInclusive<A> {\n    match Step::forward_checked(at.clone(), 1) {\n        Option::Some(n) => RangeInclusive::new(n, at),\n        Option::None => match Step::backward_checked(at.clone(), 1) {\n            Option::Some(p) => RangeInclusive::new(at, p),\n            // a type of one value: no empty range of it can be made\n            Option::None => RangeInclusive::new(at.clone(), at),\n        },\n    }\n");
    buf_str(out, c"}\n\n// `for i in 0..`: for ever (overflow panics in a debug build).\nimpl<A: Step> Iterator for RangeFrom<A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        let n = Step::forward_checked(self.start.clone(), 1).expect(\"RangeFrom overflowed\");\n        Option::Some(crate::mem::replace(&mut self.start, n))\n    }\n}\n// ---- mod std::iter::adapters ----\nmod adapters {\n// The iterator adapters: each a named struct that Iterator's method of\n// the same name returns (no impl Trait in return position: plan §6), its\n// fields private, its constructor std's own.\n\nuse crate::clone::Clone;\nuse crate::cmp::PartialEq;\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, FusedIterator, IntoIterator, Iterator};\nuse crate::option::Option;\n\n// Iterator::map's: f of each item.\n// mvs: Map\n#[derive(Clone)]\npub struct Map<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> Map<I, F> {\n    pub(crate) fn new(iter: I, f: F) -> Map<I, F> {\n        Map { iter: iter, f: f }\n    }\n}\n\n// mvs: Map::impl Iterator\nimpl<B, I: Iterator, F: FnMut(I::Item) -> B> Iterator for Map<I, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        self.iter.next().map(&mut self.f)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> B> DoubleEndedIterator for Map<I, F> {\n    fn next_back(&mut self) -> Option<B> {\n        self.iter.next_back().map(&mut self.f)\n    }\n}\n\nimpl<B, I: ExactSizeIterator, F: FnMut(I::Item) -> B> ExactSizeIterator for Map<I, F> {}\n\n// Iterator::filter's: the items the predicate says true of.\n// mvs: Filter\n#[derive(Clone)]\npub struct Filter<I, P> {\n    iter: I,\n    predicate: P,\n}\n\nimpl<I, P> Filter<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> Filter<I, P> {\n        Filter { iter: iter, predicate: predicate }\n    }\n}\n\n// mvs: Filter::impl Iterator\n");
    buf_str(out, c"// std: changed: the predicate takes &I::Item\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for Filter<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.find(&mut self.predicate)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, self.iter.size_hint().1)\n    }\n}\n\nimpl<I: DoubleEndedIterator, P: FnMut(&I::Item) -> bool> DoubleEndedIterator for Filter<I, P> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        self.iter.rfind(&mut self.predicate)\n    }\n}\n\n// Iterator::filter_map's.\n#[derive(Clone)]\npub struct FilterMap<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> FilterMap<I, F> {\n    pub(crate) fn new(iter: I, f: F) -> FilterMap<I, F> {\n        FilterMap { iter: iter, f: f }\n    }\n}\n\nimpl<B, I: Iterator, F: FnMut(I::Item) -> Option<B>> Iterator for FilterMap<I, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        self.iter.find_map(&mut self.f)\n    }\n}\n\nimpl<B, I: DoubleEndedIterator, F: FnMut(I::Item) -> Option<B>> DoubleEndedIterator for FilterMap<I,\n    F> {\n    fn next_back(&mut self) -> Option<B> {\n        while let Option::Some(x) = self.iter.next_back() {\n            if let Option::Some(y) = (self.f)(x) {\n                return Option::Some(y);\n            }\n        }\n        Option::None\n    }\n}\n\n// Iterator::enumerate's: (index, item).\n// mvs: Enumerate\n#[derive(Clone)]\npub struct Enumerate<I> {\n    iter: I,\n    count: usize,\n}\n\nimpl<I> Enumerate<I> {\n    pub(crate) fn new(iter: I) -> Enumerate<I> {\n        Enumerate { iter: iter, count: 0 }\n    }\n}\n\n// mvs: Enumerate::impl Iterator\n// std: changed: the index is usize\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (usize, I::Item);\n\n    fn next(&mut self) -> Option<(usize, I::Item)> {\n        let x = self.iter.next()?;\n        let i = self.count;\n        self.count += 1;\n        Option::Some((i, x))\n    }\n\n");
    buf_str(out, c"    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<I: ExactSizeIterator + DoubleEndedIterator> DoubleEndedIterator for Enumerate<I> {\n    fn next_back(&mut self) -> Option<(usize, I::Item)> {\n        let x = self.iter.next_back()?;\n        Option::Some((self.count + self.iter.len(), x))\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {}\n\n// Iterator::zip's: pairs, until either ends.\n// mvs: Zip\n#[derive(Clone)]\npub struct Zip<A, B> {\n    a: A,\n    b: B,\n}\n\nimpl<A, B> Zip<A, B> {\n    pub(crate) fn new(a: A, b: B) -> Zip<A, B> {\n        Zip { a: a, b: b }\n    }\n}\n\n// mvs: Zip::impl Iterator\nimpl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {\n    type Item = (A::Item, B::Item);\n\n    fn next(&mut self) -> Option<(A::Item, B::Item)> {\n        let x = self.a.next()?;\n        let y = self.b.next()?;\n        Option::Some((x, y))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let (alo, ahi) = self.a.size_hint();\n        let (blo, bhi) = self.b.size_hint();\n        let hi = match (ahi, bhi) {\n            (Option::Some(x), Option::Some(y)) => Option::Some(crate::cmp::min(x, y)),\n            (Option::Some(x), Option::None) => Option::Some(x),\n            (Option::None, Option::Some(y)) => Option::Some(y),\n            (Option::None, Option::None) => Option::None,\n        };\n        (crate::cmp::min(alo, blo), hi)\n    }\n}\n\nimpl<A: ExactSizeIterator, B: ExactSizeIterator> ExactSizeIterator for Zip<A, B> {}\n\n// Iterator::chain's: one, then the other.\n#[derive(Clone)]\npub struct Chain<A, B> {\n    a: Option<A>,\n    b: Option<B>,\n}\n\nimpl<A, B> Chain<A, B> {\n    pub(crate) fn new(a: A, b: B) -> Chain<A, B> {\n        Chain { a: Option::Some(a), b: Option::Some(b) }\n    }\n}\n\nimpl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {\n    type Item = A::Item;\n\n    fn next(&mut self) -> Option<A::Item> {\n");
    buf_str(out, c"        if let Option::Some(a) = &mut self.a {\n            match a.next() {\n                Option::Some(x) => return Option::Some(x),\n                Option::None => self.a = Option::None,\n            }\n        }\n        match &mut self.b {\n            Option::Some(b) => b.next(),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<A: DoubleEndedIterator,\n    B: DoubleEndedIterator<Item = A::Item>> DoubleEndedIterator for Chain<A, B> {\n    fn next_back(&mut self) -> Option<A::Item> {\n        if let Option::Some(b) = &mut self.b {\n            match b.next_back() {\n                Option::Some(x) => return Option::Some(x),\n                Option::None => self.b = Option::None,\n            }\n        }\n        match &mut self.a {\n            Option::Some(a) => a.next_back(),\n            Option::None => Option::None,\n        }\n    }\n}\n\n// Iterator::take's: the first n items.\n// mvs: Take\n#[derive(Clone)]\npub struct Take<I> {\n    iter: I,\n    n: usize,\n}\n\nimpl<I> Take<I> {\n    pub(crate) fn new(iter: I, n: usize) -> Take<I> {\n        Take { iter: iter, n: n }\n    }\n}\n\n// mvs: Take::impl Iterator\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n == 0 {\n            return Option::None;\n        }\n        self.n -= 1;\n        self.iter.next()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        if self.n == 0 {\n            return (0, Option::Some(0));\n        }\n        let (lo, hi) = self.iter.size_hint();\n        let hi = match hi {\n            Option::Some(x) => crate::cmp::min(x, self.n),\n            Option::None => self.n,\n        };\n        (crate::cmp::min(lo, self.n), Option::Some(hi))\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {}\n\n// Iterator::skip's: all but the first n.\n#[derive(Clone)]\npub struct Skip<I> {\n    iter: I,\n    n: usize,\n}\n\nimpl<I> Skip<I> {\n");
    buf_str(out, c"    pub(crate) fn new(iter: I, n: usize) -> Skip<I> {\n        Skip { iter: iter, n: n }\n    }\n}\n\nimpl<I: Iterator> Iterator for Skip<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n > 0 {\n            let n = self.n;\n            self.n = 0;\n            return self.iter.nth(n);\n        }\n        self.iter.next()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let (lo, hi) = self.iter.size_hint();\n        let lo = lo.saturating_sub(self.n);\n        let hi = match hi {\n            Option::Some(x) => Option::Some(x.saturating_sub(self.n)),\n            Option::None => Option::None,\n        };\n        (lo, hi)\n    }\n}\n\nimpl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        // the first n are skipped, so the back ends where they begin\n        if self.len() > 0 { self.iter.next_back() } else { Option::None }\n    }\n}\n\nimpl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {}\n\n// Iterator::take_while's.\n#[derive(Clone)]\npub struct TakeWhile<I, P> {\n    iter: I,\n    flag: bool,\n    predicate: P,\n}\n\nimpl<I, P> TakeWhile<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> TakeWhile<I, P> {\n        TakeWhile { iter: iter, flag: false, predicate: predicate }\n    }\n}\n\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for TakeWhile<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.flag {\n            return Option::None;\n        }\n        let x = self.iter.next()?;\n        if (self.predicate)(&x) {\n            Option::Some(x)\n        } else {\n            self.flag = true;\n            Option::None\n        }\n    }\n}\n\n// Iterator::skip_while's.\n#[derive(Clone)]\npub struct SkipWhile<I, P> {\n    iter: I,\n    flag: bool,\n    predicate: P,\n}\n\nimpl<I, P> SkipWhile<I, P> {\n");
    buf_str(out, c"    pub(crate) fn new(iter: I, predicate: P) -> SkipWhile<I, P> {\n        SkipWhile { iter: iter, flag: false, predicate: predicate }\n    }\n}\n\nimpl<I: Iterator, P: FnMut(&I::Item) -> bool> Iterator for SkipWhile<I, P> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        loop {\n            let x = self.iter.next()?;\n            if self.flag || !(self.predicate)(&x) {\n                self.flag = true;\n                return Option::Some(x);\n            }\n        }\n    }\n}\n\n// Iterator::map_while's.\n#[derive(Clone)]\npub struct MapWhile<I, P> {\n    iter: I,\n    predicate: P,\n}\n\nimpl<I, P> MapWhile<I, P> {\n    pub(crate) fn new(iter: I, predicate: P) -> MapWhile<I, P> {\n        MapWhile { iter: iter, predicate: predicate }\n    }\n}\n\nimpl<B, I: Iterator, P: FnMut(I::Item) -> Option<B>> Iterator for MapWhile<I, P> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        let x = self.iter.next()?;\n        (self.predicate)(x)\n    }\n}\n\n// Iterator::step_by's.\n#[derive(Clone)]\npub struct StepBy<I> {\n    iter: I,\n    step: usize,\n    first_take: bool,\n}\n\nimpl<I> StepBy<I> {\n    pub(crate) fn new(iter: I, step: usize) -> StepBy<I> {\n        if step == 0 {\n            crate::panic::panic(\"step_by: step is 0\");\n        }\n        StepBy { iter: iter, step: step - 1, first_take: true }\n    }\n}\n\nimpl<I: Iterator> Iterator for StepBy<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.first_take {\n            self.first_take = false;\n            self.iter.next()\n        } else {\n            self.iter.nth(self.step)\n        }\n    }\n}\n\n// Iterator::peekable's: peek at the next item without taking it.\npub struct Peekable<I: Iterator> {\n    iter: I,\n    peeked: Option<Option<I::Item>>,\n}\n\nimpl<I: Iterator> Peekable<I> {\n    pub(crate) fn new(iter: I) -> Peekable<I> {\n        Peekable { iter: iter, peeked: Option::None }\n    }\n\n");
    buf_str(out, c"    // The next item, still to come.\n    #[effects(panic, diverge)]\n    pub fn peek(&mut self) -> Option<&I::Item> {\n        let iter = &mut self.iter;\n        self.peeked.get_or_insert_with(|| iter.next()).as_ref()\n    }\n\n    #[effects(panic, diverge)]\n    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {\n        let iter = &mut self.iter;\n        self.peeked.get_or_insert_with(|| iter.next()).as_mut()\n    }\n\n    // The next item, when func says true of it.\n    #[effects(I, F)]\n    pub fn next_if<F: FnOnce(&I::Item) -> bool>(&mut self, func: F) -> Option<I::Item> {\n        let next = match self.peeked.take() {\n            Option::Some(v) => v,\n            Option::None => self.iter.next(),\n        };\n        match next {\n            Option::Some(x) => {\n                if func(&x) {\n                    return Option::Some(x);\n                }\n                // not taken: it stays the next one\n                self.peeked = Option::Some(Option::Some(x));\n                Option::None\n            }\n            Option::None => {\n                self.peeked = Option::Some(Option::None);\n                Option::None\n            }\n        }\n    }\n\n    // The next item, when it equals expected.\n    #[effects(I, T)]\n    pub fn next_if_eq<T: ?Sized>(&mut self, expected: &T) -> Option<I::Item>\n        where\n            I::Item: PartialEq<T>,\n    {\n        self.next_if(|x| *x == *expected)\n    }\n}\n\nimpl<I: Iterator> Iterator for Peekable<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match self.peeked.take() {\n            Option::Some(v) => v,\n            Option::None => self.iter.next(),\n        }\n    }\n}\n\n// Iterator::rev's: from the end.\n#[derive(Clone)]\npub struct Rev<I> {\n    iter: I,\n}\n\nimpl<I> Rev<I> {\n    pub(crate) fn new(iter: I) -> Rev<I> {\n        Rev { iter: iter }\n    }\n}\n\nimpl<I: DoubleEndedIterator> Iterator for Rev<I> {\n    type Item = I::Item;\n\n");
    buf_str(out, c"    fn next(&mut self) -> Option<I::Item> {\n        self.iter.next_back()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {\n    fn next_back(&mut self) -> Option<I::Item> {\n        self.iter.next()\n    }\n}\n\nimpl<I: DoubleEndedIterator + ExactSizeIterator> ExactSizeIterator for Rev<I> {}\n\n// Iterator::copied's: copies of the &T items.\n#[derive(Clone)]\npub struct Copied<I> {\n    iter: I,\n}\n\nimpl<I> Copied<I> {\n    pub(crate) fn new(iter: I) -> Copied<I> {\n        Copied { iter: iter }\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: Iterator<Item = &'a T>> Iterator for Copied<I> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.iter.next().copied()\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        self.iter.size_hint()\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Copied<I> {\n    fn next_back(&mut self) -> Option<T> {\n        self.iter.next_back().copied()\n    }\n}\n\nimpl<'a, T: Copy + 'a, I: ExactSizeIterator<Item = &'a T>> ExactSizeIterator for Copied<I> {}\n\n// Iterator::cloned's: clones of the &T items.\n#[derive(Clone)]\npub struct Cloned<I> {\n    iter: I,\n}\n\nimpl<I> Cloned<I> {\n    pub(crate) fn new(iter: I) -> Cloned<I> {\n        Cloned { iter: iter }\n    }\n}\n\nimpl<'a, T: Clone + 'a, I: Iterator<Item = &'a T>> Iterator for Cloned<I> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.iter.next().cloned()\n    }\n}\n\nimpl<'a, T: Clone + 'a, I: DoubleEndedIterator<Item = &'a T>> DoubleEndedIterator for Cloned<I> {\n    fn next_back(&mut self) -> Option<T> {\n        self.iter.next_back().cloned()\n    }\n}\n\n// Iterator::flatten's: the items of each item.\npub struct Flatten<I: Iterator>\n    where\n        I::Item: IntoIterator,\n{\n    iter: Fuse<I>,\n");
    buf_str(out, c"    front: Option<<I::Item as IntoIterator>::IntoIter>,\n    back: Option<<I::Item as IntoIterator>::IntoIter>,\n}\n\nimpl<I: Iterator> Flatten<I>\n    where\n        I::Item: IntoIterator,\n{\n    pub(crate) fn new(iter: I) -> Flatten<I> {\n        Flatten { iter: Fuse::new(iter), front: Option::None, back: Option::None }\n    }\n}\n\nimpl<I: Iterator> Iterator for Flatten<I>\n    where\n        I::Item: IntoIterator,\n{\n    type Item = <I::Item as IntoIterator>::Item;\n\n    fn next(&mut self) -> Option<<I::Item as IntoIterator>::Item> {\n        loop {\n            if let Option::Some(inner) = &mut self.front {\n                if let Option::Some(x) = inner.next() {\n                    return Option::Some(x);\n                }\n                self.front = Option::None;\n            }\n            match self.iter.next() {\n                Option::Some(inner) => self.front = Option::Some(inner.into_iter()),\n                Option::None => {\n                    return match &mut self.back {\n                        Option::Some(b) => b.next(),\n                        Option::None => Option::None,\n                    };\n                }\n            }\n        }\n    }\n}\n\n// Iterator::flat_map's: the items of each f(item).\npub struct FlatMap<I, U: IntoIterator, F> {\n    iter: Map<I, F>,\n    front: Option<U::IntoIter>,\n    back: Option<U::IntoIter>,\n}\n\nimpl<I, U: IntoIterator, F> FlatMap<I, U, F> {\n    pub(crate) fn new(iter: I, f: F) -> FlatMap<I, U, F> {\n        FlatMap { iter: Map::new(iter, f), front: Option::None, back: Option::None }\n    }\n}\n\nimpl<I: Iterator, U: IntoIterator, F: FnMut(I::Item) -> U> Iterator for FlatMap<I, U, F> {\n    type Item = U::Item;\n\n    fn next(&mut self) -> Option<U::Item> {\n        loop {\n            if let Option::Some(inner) = &mut self.front {\n                if let Option::Some(x) = inner.next() {\n                    return Option::Some(x);\n                }\n");
    buf_str(out, c"                self.front = Option::None;\n            }\n            match self.iter.next() {\n                Option::Some(u) => self.front = Option::Some(u.into_iter()),\n                Option::None => {\n                    return match &mut self.back {\n                        Option::Some(b) => b.next(),\n                        Option::None => Option::None,\n                    };\n                }\n            }\n        }\n    }\n}\n\n// Iterator::fuse's: None for ever after the first None.\n#[derive(Clone)]\npub struct Fuse<I> {\n    iter: Option<I>,\n}\n\nimpl<I> Fuse<I> {\n    pub(crate) fn new(iter: I) -> Fuse<I> {\n        Fuse { iter: Option::Some(iter) }\n    }\n}\n\nimpl<I: Iterator> Iterator for Fuse<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match &mut self.iter {\n            Option::Some(it) => match it.next() {\n                Option::Some(x) => Option::Some(x),\n                Option::None => {\n                    self.iter = Option::None;\n                    Option::None\n                }\n            },\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<I: Iterator> FusedIterator for Fuse<I> {}\n\n// Iterator::inspect's.\n#[derive(Clone)]\npub struct Inspect<I, F> {\n    iter: I,\n    f: F,\n}\n\nimpl<I, F> Inspect<I, F> {\n    pub(crate) fn new(iter: I, f: F) -> Inspect<I, F> {\n        Inspect { iter: iter, f: f }\n    }\n}\n\nimpl<I: Iterator, F: FnMut(&I::Item)> Iterator for Inspect<I, F> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        let x = self.iter.next()?;\n        (self.f)(&x);\n        Option::Some(x)\n    }\n}\n\n// Iterator::scan's.\n#[derive(Clone)]\npub struct Scan<I, St, F> {\n    iter: I,\n    f: F,\n    state: St,\n}\n\nimpl<I, St, F> Scan<I, St, F> {\n    pub(crate) fn new(iter: I, state: St, f: F) -> Scan<I, St, F> {\n        Scan { iter: iter, f: f, state: state }\n    }\n}\n\n");
    buf_str(out, c"impl<B, I: Iterator, St, F: FnMut(&mut St, I::Item) -> Option<B>> Iterator for Scan<I, St, F> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        let x = self.iter.next()?;\n        (self.f)(&mut self.state, x)\n    }\n}\n\n// Iterator::cycle's: again and again.\n#[derive(Clone)]\npub struct Cycle<I> {\n    orig: I,\n    iter: I,\n}\n\nimpl<I: Clone> Cycle<I> {\n    pub(crate) fn new(iter: I) -> Cycle<I> {\n        Cycle { orig: iter.clone(), iter: iter }\n    }\n}\n\nimpl<I: Clone + Iterator> Iterator for Cycle<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        match self.iter.next() {\n            Option::None => {\n                self.iter = self.orig.clone();\n                self.iter.next()\n            }\n            y => y,\n        }\n    }\n\n    // Empty, or without end (Rust's).\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        match self.orig.size_hint() {\n            (0, Option::Some(0)) => (0, Option::Some(0)),\n            (0, _) => (0, Option::None),\n            _ => (usize::MAX, Option::None),\n        }\n    }\n}\n// ---- end mod std::iter::adapters ----\n}\n// ---- mod std::iter::sources ----\nmod sources {\n// The iterator sources: iterators made from nothing, one value, a value\n// again and again, or a closure.\n\nuse crate::clone::Clone;\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator, Zip};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\n\n// No items.\n#[effects()]\npub fn empty<T>() -> Empty<T> {\n    Empty { marker: PhantomData }\n}\n\npub struct Empty<T> {\n    marker: PhantomData<T>,\n}\n\nimpl<T> Iterator for Empty<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        Option::None\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (0, Option::Some(0))\n    }\n}\n\nimpl<T> DoubleEndedIterator for Empty<T> {\n    fn next_back(&mut self) -> Option<T> {\n        Option::None\n    }\n");
    buf_str(out, c"}\n\n// One item.\n#[effects()]\npub fn once<T>(value: T) -> Once<T> {\n    Once { value: Option::Some(value) }\n}\n\npub struct Once<T> {\n    value: Option<T>,\n}\n\nimpl<T> Iterator for Once<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        self.value.take()\n    }\n}\n\nimpl<T> DoubleEndedIterator for Once<T> {\n    fn next_back(&mut self) -> Option<T> {\n        self.value.take()\n    }\n}\n\n// Clones of value, for ever (`.take(n)`).\n#[effects()]\npub fn repeat<T: Clone>(value: T) -> Repeat<T> {\n    Repeat { value: value }\n}\n\n#[derive(Clone)]\npub struct Repeat<T> {\n    value: T,\n}\n\nimpl<T: Clone> Iterator for Repeat<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        Option::Some(self.value.clone())\n    }\n}\n\n// n clones of value (the last one the value itself).\n#[effects()]\npub fn repeat_n<T: Clone>(value: T, n: usize) -> RepeatN<T> {\n    RepeatN { value: if n == 0 { Option::None } else { Option::Some(value) }, left: n }\n}\n\n#[derive(Clone)]\npub struct RepeatN<T> {\n    value: Option<T>,\n    left: usize,\n}\n\nimpl<T: Clone> Iterator for RepeatN<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.left == 0 {\n            return Option::None;\n        }\n        self.left -= 1;\n        if self.left == 0 { self.value.take() } else { self.value.clone() }\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.left, Option::Some(self.left))\n    }\n}\n\nimpl<T: Clone> ExactSizeIterator for RepeatN<T> {}\n\n// f's values until it gives None.\n#[effects()]\npub fn from_fn<T, F: FnMut() -> Option<T>>(f: F) -> FromFn<F> {\n    FromFn { f: f }\n}\n\n#[derive(Clone)]\npub struct FromFn<F> {\n    f: F,\n}\n\nimpl<T, F: FnMut() -> Option<T>> Iterator for FromFn<F> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        (self.f)()\n    }\n}\n\n// first, then succ of each item, until succ gives None.\n#[effects()]\n");
    buf_str(out, c"pub fn successors<T, F: FnMut(&T) -> Option<T>>(first: Option<T>, succ: F) -> Successors<T, F> {\n    Successors { next: first, succ: succ }\n}\n\n#[derive(Clone)]\npub struct Successors<T, F> {\n    next: Option<T>,\n    succ: F,\n}\n\nimpl<T, F: FnMut(&T) -> Option<T>> Iterator for Successors<T, F> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let item = self.next.take()?;\n        self.next = (self.succ)(&item);\n        Option::Some(item)\n    }\n}\n\n// The pairs of a's and b's items (`zip(&xs, &ys)`).\n#[effects(A, B)]\npub fn zip<A: IntoIterator, B: IntoIterator>(a: A, b: B) -> Zip<A::IntoIter, B::IntoIter> {\n    a.into_iter().zip(b)\n}\n// ---- end mod std::iter::sources ----\n}\n// ---- end mod std::iter ----\n}\n// ---- mod std::fmt ----\npub mod fmt {\n// std::fmt: Display, Debug, Formatter<'a>, fmt::Write, and the print\n// functions. Rust's shape (`fn fmt(&self, f: &mut Formatter<'_>) ->\n// fmt::Result`), with two differences that come from having no `dyn`\n// (plan §3): a Formatter is one concrete type over an erased sink (a data\n// pointer and a write function, as AnyAlloc erases an allocator), not a\n// `&mut dyn Write`, so a Debug impl is compiled once, not once per sink;\n// and the builders' `field` and `entry` are generic over the value's type\n// instead of taking a `&dyn Debug`. There are no macros: a format literal\n// at a `T: Display` parameter (`println(\"{x} {y:>5}\")`, `format_in(\"{n}\",\n// a)`) is checked by the compiler and made a value that displays it\n// (`syntax.later: format_fns`); `write(w, \"..\")` and `writeln` are the\n// compiler's for `w.write_fmt(\"..\")`, fmt::Write's or io::Write's.\n\nuse crate::alloc::Allocator;\nuse crate::iter::IntoIterator;\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::string::String;\n\n// What fmt returns: Err when the sink failed (a closed pipe), not when\n// the value cannot be shown.\npub type Result = crate::result::Result<(), Error>;\n\n");
    buf_str(out, c"// A sink's failure. It carries nothing: the sink knows why.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Debug, Default)]\npub struct Error;\n\n// How a value shows to a user: `{x}`.\n// std: changed: fmt(&self, &mut Formatter) -> Result (MVS: fmt(self, inout Fmt))\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Display {\n    // std: changed: takes &self and a Formatter, returns a Result\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// How a value shows to a programmer: `{x:?}`, `{x:#?}` (pretty).\n// std: changed: fmt(&self, &mut Formatter) -> Result (MVS: fmt_debug(self, inout Fmt))\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait Debug {\n    // mvs: Debug::fmt_debug\n    // std: renamed\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:x}`: lower-case hexadecimal (integers' impls built in, as each of\n// these traits'; bodies in 0.27.2).\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait LowerHex {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:X}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait UpperHex {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:o}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Octal {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:b}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\npub trait Binary {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:e}`: floats in scientific notation.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait LowerExp {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{x:E}`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64)]\npub trait UpperExp {\n");
    buf_str(out, c"    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// `{p:p}`: a pointer's address.\npub trait Pointer {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result;\n}\n\n// A sink of text: what `write(w, \"..\")` writes into when w is a String\n// (or any type that implements it). Never fails for a String.\npub trait Write {\n    fn write_str(&mut self, s: &str) -> Result;\n\n    fn write_char(&mut self, c: char) -> Result {\n        self.write_str(c.encode_utf8(&mut [0u8; 4]))\n    }\n\n    // x written as its Display shows it (a format literal: the compiler's\n    // `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result {\n        let mut f = Formatter::new(self);\n        crate::fmt::Display::fmt(&x, &mut f)\n    }\n}\n\n// A Formatter is a sink of text too (Rust's `impl Write for Formatter`):\n// `write(f, \"..\")` in a Display impl writes through it.\nimpl<'a> Write for Formatter<'a> {\n    fn write_str(&mut self, s: &str) -> Result {\n        Formatter::write_str(self, s)\n    }\n}\n\n// A reference displays and debugs as what it refers to.\nimpl<T: Display + ?Sized> Display for &T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Display::fmt(&**self, f)\n    }\n}\n\nimpl<T: Debug + ?Sized> Debug for &T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Debug::fmt(&**self, f)\n    }\n}\n\nimpl<T: Display + ?Sized> Display for &mut T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Display::fmt(&**self, f)\n    }\n}\n\nimpl<T: Debug + ?Sized> Debug for &mut T {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        Debug::fmt(&**self, f)\n    }\n}\n\nimpl Debug for () {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        f.pad(\"()\")\n    }\n}\n\n// Tuples debug as Rust's do: `(1, \"a\")`, a one-tuple `(1,)` (core's\n// tuple impls, up to 12 elements).\n// std: new\nimpl<A: Debug> Debug for (A,) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n");
    buf_str(out, c"        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug> Debug for (A, B) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug> Debug for (A, B, C) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug> Debug for (A, B, C, D) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug> Debug for (A, B, C, D, E) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug> Debug for (A, B, C, D, E, F) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug> Debug for (A, B, C, D, E,\n    F, G) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n");
    buf_str(out, c"        t.field(&self.5);\n        t.field(&self.6);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug> Debug for (A,\n    B, C, D, E, F, G, H) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug,\n    I: Debug> Debug for (A, B, C, D, E, F, G, H, I) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug, I: Debug,\n    J: Debug> Debug for (A, B, C, D, E, F, G, H, I, J) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.field(&self.9);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug, I: Debug,\n    J: Debug, K: Debug> Debug for (A, B, C, D, E, F, G, H, I, J, K) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n");
    buf_str(out, c"        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.field(&self.9);\n        t.field(&self.10);\n        t.finish()\n    }\n}\n\nimpl<A: Debug, B: Debug, C: Debug, D: Debug, E: Debug, F: Debug, G: Debug, H: Debug, I: Debug,\n    J: Debug, K: Debug, L: Debug> Debug for (A, B, C, D, E, F, G, H, I, J, K, L) {\n    fn fmt(&self, f: &mut Formatter<'_>) -> Result {\n        let mut t = f.debug_tuple(\"\");\n        t.field(&self.0);\n        t.field(&self.1);\n        t.field(&self.2);\n        t.field(&self.3);\n        t.field(&self.4);\n        t.field(&self.5);\n        t.field(&self.6);\n        t.field(&self.7);\n        t.field(&self.8);\n        t.field(&self.9);\n        t.field(&self.10);\n        t.field(&self.11);\n        t.finish()\n    }\n}\n\n// Where a padded value sits in its width.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Alignment {\n    Left,\n    Right,\n    Center,\n}\n\n// What a value is written into, with its hole's spec ({:>8.3}): the sink\n// erased (no dyn), the width, precision, fill, alignment and flags.\n// Its fill is a char (`syntax.later: char`).\n// mvs: Fmt\n// std: renamed\n// later: char\npub struct Formatter<'a> {\n    out: *mut u8,\n    write: fn(*mut u8, &str) -> Result,\n    width: Option<usize>,\n    precision: Option<usize>,\n    fill: char,\n    align: Option<Alignment>,\n    flags: u32,\n    // a write failed: every later one fails too, so the last write of a\n    // format literal (`write(w, ..)`'s value) reports an earlier error,\n    // as Rust's write! stops at the first\n    failed: bool,\n    marker: PhantomData<&'a mut ()>,\n}\n\nimpl<'a> Formatter<'a> {\n    // A Formatter over any fmt::Write, with an empty spec (what\n    // `write(w, ..)` makes).\n    // What a Formatter writes is its maker's effect (E4.3a): W's write_str.\n    #[effects(W)]\n    pub fn new<W: Write>(w: &'a mut W) -> Formatter<'a> {\n");
    buf_str(out, c"        Formatter {\n            out: w as *mut W as *mut u8,\n            write: write_erased::<W>,\n            width: Option::None,\n            precision: Option::None,\n            fill: ' ',\n            align: Option::None,\n            flags: 0,\n            failed: false,\n            marker: PhantomData {},\n        }\n    }\n\n    // s, as it is (no padding).\n    // mvs: Fmt::str\n    // std: renamed\n    #[effects()]\n    pub fn write_str(&mut self, s: &str) -> Result {\n        if self.failed {\n            return crate::result::Result::Err(Error);\n        }\n        let r = (self.write)(self.out, s);\n        if r.is_err() {\n            self.failed = true;\n        }\n        r\n    }\n\n    // mvs: Fmt::byte\n    // std: renamed\n    #[effects(panic)]\n    pub fn write_char(&mut self, c: char) -> Result {\n        self.write_str(c.encode_utf8(&mut [0u8; 4]))\n    }\n\n    // x as its Display shows it (a format literal inside a Display impl:\n    // `write(f, \"({x}, {y})\")`).\n    // mvs: Fmt::write, Fmt::display, Fmt::debug\n    // std: renamed\n    #[effects(T)]\n    pub fn write_fmt<T: Display>(&mut self, x: T) -> Result {\n        crate::fmt::Display::fmt(&x, self)\n    }\n\n    // s padded to the width with the fill, as the alignment says (Left by\n    // default), and cut to the precision: what str's Display does.\n    #[effects(panic)]\n    pub fn pad(&mut self, s: &str) -> Result {\n        // (0.28.0: a hole with no width and no precision, the most, writes\n        // s as it is; the rest out of line, so that a format literal's\n        // closure holds a write per hole and not pad's every case)\n        if self.width.is_none() && self.precision.is_none() {\n            return self.write_str(s);\n        }\n        self.pad_spec(s)\n    }\n\n    #[inline(never)]\n    fn pad_spec(&mut self, s: &str) -> Result {\n        let s = match self.precision {\n            Option::Some(p) => match s.char_indices().nth(p) {\n");
    buf_str(out, c"                Option::Some((i, _)) => &s[..i],\n                Option::None => s,\n            },\n            Option::None => s,\n        };\n        match self.width {\n            Option::Some(w) => {\n                let n = s.chars().count();\n                if n >= w {\n                    return self.write_str(s);\n                }\n                let (pre, post) = self.padding(w - n, Alignment::Left);\n                self.write_fill(pre)?;\n                self.write_str(s)?;\n                self.write_fill(post)\n            }\n            Option::None => self.write_str(s),\n        }\n    }\n\n    // An integer's digits, padded: the sign, `#`'s prefix, `0`'s zeros.\n    #[effects(panic)]\n    pub fn pad_integral(&mut self, is_nonnegative: bool, prefix: &str, digits: &str) -> Result {\n        let mut width = digits.len();\n        let sign: &str = if !is_nonnegative {\n            \"-\"\n        } else if self.sign_plus() {\n            \"+\"\n        } else {\n            \"\"\n        };\n        width += sign.len();\n        let prefix: &str = if self.alternate() { prefix } else { \"\" };\n        width += prefix.chars().count();\n        let min = match self.width {\n            Option::Some(min) => min,\n            Option::None => 0,\n        };\n        if width >= min {\n            self.write_str(sign)?;\n            self.write_str(prefix)?;\n            return self.write_str(digits);\n        }\n        if self.sign_aware_zero_pad() {\n            // `0`: the zeros go after the sign and the prefix, whatever\n            // the fill and the alignment.\n            self.write_str(sign)?;\n            self.write_str(prefix)?;\n            for _ in 0..min - width {\n                self.write_str(\"0\")?;\n            }\n            return self.write_str(digits);\n        }\n        let (pre, post) = self.padding(min - width, Alignment::Right);\n        self.write_fill(pre)?;\n        self.write_str(sign)?;\n        self.write_str(prefix)?;\n");
    buf_str(out, c"        self.write_str(digits)?;\n        self.write_fill(post)\n    }\n\n    // The hole's spec, which the compiler's lowering of a format literal\n    // sets before the value's fmt and clears after (`{:>8.3}`, `{:#?}`,\n    // `{:+}`, `{:*^9}`): a width and a precision (< 0: none), the fill (a\n    // code point), the alignment (0: none, 1: left, 2: right, 3: center)\n    // and the flags (1 `+`, 4 `#`, 8 `0`). Not Rust's: its macros set\n    // them through format_args's private Arguments.\n    #[effects()]\n    pub fn __spec(&mut self, width: i64, precision: i64, fill: u32, align: i64, flags: u32) {\n        self.width = if width < 0 { Option::None } else { Option::Some(width as usize) };\n        self.precision = if precision < 0 { Option::None }\n            else { Option::Some(precision as usize) };\n        self.fill = match char::from_u32(fill) {\n            Option::Some(c) => c,\n            Option::None => ' ',\n        };\n        self.align = if align == 1 { Option::Some(Alignment::Left) }\n            else if align == 2 { Option::Some(Alignment::Right) }\n            else if align == 3 { Option::Some(Alignment::Center) }\n            else { Option::None };\n        self.flags = flags;\n    }\n\n    // The hole's width ({:8}), its precision ({:.3}), its fill ({:*^8}),\n    // its alignment, its flags.\n    #[effects()]\n    pub fn width(&self) -> Option<usize> {\n        self.width\n    }\n\n    #[effects()]\n    pub fn precision(&self) -> Option<usize> {\n        self.precision\n    }\n\n    #[effects()]\n    pub fn fill(&self) -> char {\n        self.fill\n    }\n\n    #[effects()]\n    pub fn align(&self) -> Option<Alignment> {\n        self.align\n    }\n\n    // `#`: Debug's pretty form, `0x` for hex.\n    #[effects()]\n    pub fn alternate(&self) -> bool {\n        self.flags & 4 != 0\n    }\n\n    // `+`.\n    #[effects()]\n    pub fn sign_plus(&self) -> bool {\n        self.flags & 1 != 0\n    }\n\n    // `-`.\n    #[effects()]\n");
    buf_str(out, c"    pub fn sign_minus(&self) -> bool {\n        self.flags & 2 != 0\n    }\n\n    // `0`.\n    #[effects()]\n    pub fn sign_aware_zero_pad(&self) -> bool {\n        self.flags & 8 != 0\n    }\n\n    // pad's fill: the pad fills before and after a value for this\n    // alignment (default when the hole gives none).\n    fn padding(&self, pad: usize, default: Alignment) -> (usize, usize) {\n        let align = match self.align {\n            Option::Some(a) => a,\n            Option::None => default,\n        };\n        match align {\n            Alignment::Left => (0, pad),\n            Alignment::Right => (pad, 0),\n            Alignment::Center => (pad / 2, (pad + 1) / 2),\n        }\n    }\n\n    // n fill chars.\n    fn write_fill(&mut self, n: usize) -> Result {\n        for _ in 0..n {\n            self.write_char(self.fill)?;\n        }\n        Result::Ok(())\n    }\n\n    // The hole's spec, to give a Formatter over another sink (the pretty\n    // builders' PadAdapter), and taking it.\n    fn spec(&self) -> (Option<usize>, Option<usize>, char, Option<Alignment>, u32) {\n        (self.width, self.precision, self.fill, self.align, self.flags)\n    }\n\n    fn set_spec(&mut self, spec: (Option<usize>, Option<usize>, char, Option<Alignment>, u32)) {\n        let (width, precision, fill, align, flags) = spec;\n        self.width = width;\n        self.precision = precision;\n        self.fill = fill;\n        self.align = align;\n        self.flags = flags;\n    }\n\n    // `Name { a: 1, b: 2 }`, field by field.\n    #[effects()]\n    pub fn debug_struct<'b>(&'b mut self, name: &str) -> DebugStruct<'b, 'a> {\n        let result = self.write_str(name);\n        DebugStruct { fmt: self, result: result, has_fields: false }\n    }\n\n    // `Name(1, 2)`.\n    #[effects()]\n    pub fn debug_tuple<'b>(&'b mut self, name: &str) -> DebugTuple<'b, 'a> {\n        let result = self.write_str(name);\n");
    buf_str(out, c"        DebugTuple { fmt: self, result: result, fields: 0, empty_name: name.is_empty() }\n    }\n\n    // `[1, 2]`.\n    // mvs: debug_list, Fmt::debug_slice\n    // std: changed: a builder (MVS: debug_list(f, s) of a slice)\n    #[effects()]\n    pub fn debug_list<'b>(&'b mut self) -> DebugList<'b, 'a> {\n        let result = self.write_str(\"[\");\n        DebugList { fmt: self, result: result, has_entries: false }\n    }\n\n    // `{1, 2}`.\n    #[effects()]\n    pub fn debug_set<'b>(&'b mut self) -> DebugSet<'b, 'a> {\n        let result = self.write_str(\"{\");\n        DebugSet { fmt: self, result: result, has_entries: false }\n    }\n\n    // `{k: v, ...}`.\n    #[effects()]\n    pub fn debug_map<'b>(&'b mut self) -> DebugMap<'b, 'a> {\n        let result = self.write_str(\"{\");\n        DebugMap { fmt: self, result: result, has_entries: false, has_key: false }\n    }\n}\n\n// Formatter::debug_struct's builder.\npub struct DebugStruct<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_fields: bool,\n}\n\nimpl<'a, 'b> DebugStruct<'a, 'b> {\n    #[effects(T)]\n    pub fn field<T: Debug + ?Sized>(&mut self, name: &str, value: &T) -> &mut DebugStruct<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = if self.fmt.alternate() {\n                write_pretty(self.fmt, if self.has_fields { \"\" } else { \" {\\n\" },\n                    Option::Some(name), value)\n            } else {\n                write_plain(self.fmt, if self.has_fields { \", \" } else { \" { \" },\n                    Option::Some(name), value)\n            };\n        }\n        self.has_fields = true;\n        self\n    }\n\n    // `Name { a: 1, .. }`.\n    #[effects()]\n    pub fn finish_non_exhaustive(&mut self) -> Result {\n        if self.result.is_ok() {\n            self.result = if !self.has_fields {\n                self.fmt.write_str(\" { .. }\")\n            } else if self.fmt.alternate() {\n");
    buf_str(out, c"                self.fmt.write_str(\"    ..\\n}\")\n            } else {\n                self.fmt.write_str(\", .. }\")\n            };\n        }\n        self.result\n    }\n\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() && self.has_fields {\n            self.result = self.fmt.write_str(if self.fmt.alternate() { \"}\" } else { \" }\" });\n        }\n        self.result\n    }\n}\n\n// Formatter::debug_tuple's builder.\npub struct DebugTuple<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    fields: usize,\n    empty_name: bool,\n}\n\nimpl<'a, 'b> DebugTuple<'a, 'b> {\n    #[effects(T)]\n    pub fn field<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugTuple<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = if self.fmt.alternate() {\n                write_pretty(self.fmt, if self.fields > 0 { \"\" } else { \"(\\n\" }, Option::None,\n                    value)\n            } else {\n                write_plain(self.fmt, if self.fields > 0 { \", \" } else { \"(\" }, Option::None, value)\n            };\n        }\n        self.fields += 1;\n        self\n    }\n\n    // `(x,)` for a one-field tuple with no name, as Rust's.\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() && self.fields > 0 {\n            if self.fields == 1 && self.empty_name && !self.fmt.alternate() {\n                self.result = self.fmt.write_str(\",\");\n            }\n            if self.result.is_ok() {\n                self.result = self.fmt.write_str(\")\");\n            }\n        }\n        self.result\n    }\n}\n\n// The entries of a list or a set: `[a, b]`, `{a, b}`; pretty, one a line.\nfn write_entry<T: Debug + ?Sized>(f: &mut Formatter<'_>, has_entries: bool, value: &T) -> Result {\n    if f.alternate() {\n        write_pretty(f, if has_entries { \"\" } else { \"\\n\" }, Option::None, value)\n    } else {\n");
    buf_str(out, c"        write_plain(f, if has_entries { \", \" } else { \"\" }, Option::None, value)\n    }\n}\n\n// Formatter::debug_list's builder.\npub struct DebugList<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugList<'a, 'b> {\n    #[effects(T)]\n    pub fn entry<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugList<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = write_entry(self.fmt, self.has_entries, value);\n        }\n        self.has_entries = true;\n        self\n    }\n\n    #[effects(D, I)]\n    pub fn entries<D: Debug, I: IntoIterator<Item = D>>(&mut self, entries: I) -> &mut DebugList<'a,\n        'b> {\n        for e in entries {\n            self.entry(&e);\n        }\n        self\n    }\n\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() {\n            self.result = self.fmt.write_str(\"]\");\n        }\n        self.result\n    }\n}\n\n// Formatter::debug_set's builder.\npub struct DebugSet<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    result: Result,\n    has_entries: bool,\n}\n\nimpl<'a, 'b> DebugSet<'a, 'b> {\n    #[effects(T)]\n    pub fn entry<T: Debug + ?Sized>(&mut self, value: &T) -> &mut DebugSet<'a, 'b> {\n        if self.result.is_ok() {\n            self.result = write_entry(self.fmt, self.has_entries, value);\n        }\n        self.has_entries = true;\n        self\n    }\n\n    #[effects(diverge, D, I)]\n    pub fn entries<D: Debug, I: IntoIterator<Item = D>>(&mut self, entries: I) -> &mut DebugSet<'a,\n        'b> {\n        for e in entries {\n            self.entry(&e);\n        }\n        self\n    }\n\n    #[effects()]\n    pub fn finish(&mut self) -> Result {\n        if self.result.is_ok() {\n            self.result = self.fmt.write_str(\"}\");\n        }\n        self.result\n    }\n}\n\n// Formatter::debug_map's builder.\npub struct DebugMap<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n");
    buf_str(out, c"    result: Result,\n    has_entries: bool,\n    has_key: bool,\n}\n\nimpl<'a, 'b> DebugMap<'a, 'b> {\n    #[effects(K, V)]\n    pub fn entry<K: Debug + ?Sized,\n        V: Debug + ?Sized>(&mut self, key: &K, value: &V) -> &mut DebugMap<'a, 'b> {\n        self.key(key).value(value)\n    }\n\n    // The key of an entry whose value comes next (`value`); panics when a\n    // key is waiting for its value.\n    #[effects(panic, K)]\n    pub fn key<K: Debug + ?Sized>(&mut self, key: &K) -> &mut DebugMap<'a, 'b> {\n        if self.has_key {\n            let msg: &str = \"attempted to begin a new map entry without completing the previous one\";\n            crate::panic::panic(msg);\n        }\n        if self.result.is_ok() {\n            self.result = write_key(self.fmt, self.has_entries, key);\n        }\n        self.has_key = true;\n        self\n    }\n\n    // The value of the entry `key` began; panics when there is no key.\n    #[effects(panic, V)]\n    pub fn value<V: Debug + ?Sized>(&mut self, value: &V) -> &mut DebugMap<'a, 'b> {\n        if !self.has_key {\n            let msg: &str = \"attempted to format a map value before its key\";\n            crate::panic::panic(msg);\n        }\n        if self.result.is_ok() {\n            self.result = write_value(self.fmt, value);\n        }\n        self.has_key = false;\n        self.has_entries = true;\n        self\n    }\n\n    #[effects(diverge, K, V, I)]\n    pub fn entries<K: Debug, V: Debug,\n        I: IntoIterator<Item = (K, V)>>(&mut self, entries: I) -> &mut DebugMap<'a, 'b> {\n        for (k, v) in entries {\n            self.entry(&k, &v);\n        }\n        self\n    }\n\n    // Panics when a key is waiting for its value.\n    #[effects(panic)]\n    pub fn finish(&mut self) -> Result {\n        if self.has_key {\n            let msg: &str = \"attempted to finish a map with a partial entry\";\n            crate::panic::panic(msg);\n        }\n        if self.result.is_ok() {\n");
    buf_str(out, c"            self.result = self.fmt.write_str(\"}\");\n        }\n        self.result\n    }\n}\n\n// A map's key: `k: `, after a comma or (pretty) on a line of its own.\nfn write_key<K: Debug + ?Sized>(f: &mut Formatter<'_>, has_entries: bool, key: &K) -> Result {\n    if f.alternate() {\n        if !has_entries {\n            f.write_str(\"\\n\")?;\n        }\n        write_padded(f, true, key)?;\n    } else {\n        write_plain(f, if has_entries { \", \" } else { \"\" }, Option::None, key)?;\n    }\n    f.write_str(\": \")\n}\n\n// A map's value, after its key (pretty: ending the line).\nfn write_value<V: Debug + ?Sized>(f: &mut Formatter<'_>, value: &V) -> Result {\n    if f.alternate() {\n        write_padded(f, false, value)?;\n        f.write_str(\",\\n\")\n    } else {\n        crate::fmt::Debug::fmt(value, f)\n    }\n}\n\n// The builders' plain form: prefix, `name: ` when there is a name, and\n// the value's Debug.\nfn write_plain<T: Debug + ?Sized>(f: &mut Formatter<'_>, prefix: &str, name: Option<&str>,\n    value: &T) -> Result {\n    f.write_str(prefix)?;\n    if let Option::Some(n) = name {\n        f.write_str(n)?;\n        f.write_str(\": \")?;\n    }\n    crate::fmt::Debug::fmt(value, f)\n}\n\n// The builders' pretty form (`{:#?}`): open (the first entry's bracket),\n// then `name: value,` on a line of its own, indented one level more than f's.\nfn write_pretty<T: Debug + ?Sized>(f: &mut Formatter<'_>, open: &str, name: Option<&str>, value: &T) -> Result {\n    f.write_str(open)?;\n    let spec = f.spec();\n    let mut pad = PadAdapter { fmt: f, on_newline: true };\n    let mut inner = Formatter::new(&mut pad);\n    inner.set_spec(spec);\n    if let Option::Some(n) = name {\n        inner.write_str(n)?;\n        inner.write_str(\": \")?;\n    }\n    crate::fmt::Debug::fmt(value, &mut inner)?;\n    inner.write_str(\",\\n\")\n}\n\n// value's Debug indented one level more than f's (a map's key, then its\n");
    buf_str(out, c"// value: on_newline is true at a line's start only).\nfn write_padded<T: Debug + ?Sized>(f: &mut Formatter<'_>, on_newline: bool, value: &T) -> Result {\n    let spec = f.spec();\n    let mut pad = PadAdapter { fmt: f, on_newline: on_newline };\n    let mut inner = Formatter::new(&mut pad);\n    inner.set_spec(spec);\n    crate::fmt::Debug::fmt(value, &mut inner)\n}\n\n// A sink that indents every line written through it by four spaces: what\n// the pretty builders write a nested value into.\nstruct PadAdapter<'a, 'b> {\n    fmt: &'a mut Formatter<'b>,\n    on_newline: bool,\n}\n\nimpl<'a, 'b> Write for PadAdapter<'a, 'b> {\n    // terminates: every pass takes a line of at least one byte off rest.\n    #[terminates]\n    fn write_str(&mut self, s: &str) -> Result {\n        let mut rest = s;\n        while !rest.is_empty() {\n            if self.on_newline {\n                self.fmt.write_str(\"    \")?;\n            }\n            let nl: &str = \"\\n\";\n            let n = match rest.find(nl) {\n                Option::Some(i) => i + 1,\n                Option::None => rest.len(),\n            };\n            let (line, tail) = rest.split_at(n);\n            self.on_newline = line.ends_with(nl);\n            self.fmt.write_str(line)?;\n            rest = tail;\n        }\n        Result::Ok(())\n    }\n}\n\n// Formatter::new's write function for a W: out is the &mut W it erased.\nfn write_erased<W: Write>(out: *mut u8, s: &str) -> Result {\n    // UNSAFE: the sink is erased to a data pointer (no dyn: plan §3), so\n    // it is read back through a raw pointer.\n    // SAFETY: out is the `&'a mut W` Formatter::new took, cast; the\n    // Formatter<'a> holding it keeps that borrow alive and is its only\n    // user, so the &mut is valid and unaliased for this call.\n    let w = unsafe { &mut *(out as *mut W) };\n    w.write_str(s)\n}\n\n// ---- The print functions (Rust's macros) ----\n\n// x on stdout (`print(\"{x}\")`); stdout is line-buffered when a terminal.\n");
    buf_str(out, c"// later: format_fns\n#[effects(panic, T)]\npub fn print<T: Display>(x: T) {\n    let mut out = crate::io::stdout();\n    if crate::io::Write::write_fmt(&mut out, x).is_err() {\n        let msg: &str = \"failed printing to stdout\";\n        crate::panic::panic(msg);\n    }\n}\n\n// x and a newline on stdout.\n// later: format_fns\n#[effects(io, static, panic, T)]\npub fn println<T: Display>(x: T) {\n    let mut out = crate::io::stdout();\n    if crate::io::Write::write_fmt(&mut out, x).is_err()\n        || crate::io::Write::write_all(&mut out, \"\\n\".as_bytes()).is_err()\n        {\n        let msg: &str = \"failed printing to stdout\";\n        crate::panic::panic(msg);\n    }\n}\n\n// x on stderr.\n// later: format_fns\n#[effects(panic, T)]\npub fn eprint<T: Display>(x: T) {\n    let mut out = crate::io::stderr();\n    if crate::io::Write::write_fmt(&mut out, x).is_err() {\n        let msg: &str = \"failed printing to stderr\";\n        crate::panic::panic(msg);\n    }\n}\n\n// later: format_fns\n#[effects(io, static, panic, T)]\npub fn eprintln<T: Display>(x: T) {\n    let mut out = crate::io::stderr();\n    if crate::io::Write::write_fmt(&mut out, x).is_err()\n        || crate::io::Write::write_all(&mut out, \"\\n\".as_bytes()).is_err()\n        {\n        let msg: &str = \"failed printing to stderr\";\n        crate::panic::panic(msg);\n    }\n}\n\n// x as a String on a (Rust's `format!`, allocator last: plan §2).\n// std: changed: takes x by value and the allocator\n// later: format_fns\n#[effects(T, A)]\npub fn format_in<T: Display, A: Allocator>(x: T, a: A) -> String<A> {\n    let mut s = String::new_in(a);\n    let _ = s.write_fmt(x);\n    s\n}\n\n// x written into w (Rust's `write!(w, ..)`: `write(f, \"({}, {})\", a, b)`\n// in a Display impl, `write(s, \"{x}\")` into a String): the compiler makes\n// the format literal x's Display value, as print's (F16.1). An io::Write\n// writer comes in 0.27.3 (its write_fmt).\n// later: format_fns\n#[effects(W, T)]\n");
    buf_str(out, c"pub fn write<W: Write + ?Sized, T: Display>(w: &mut W, x: T) -> Result {\n    w.write_fmt(x)\n}\n\n// x and a newline written into w (Rust's `writeln!`).\n// later: format_fns\n#[effects(W, T)]\npub fn writeln<W: Write + ?Sized, T: Display>(w: &mut W, x: T) -> Result {\n    match w.write_fmt(x) {\n        Result::Ok(()) => w.write_str(\"\\n\"),\n        Result::Err(e) => Result::Err(e),\n    }\n}\n\n// A format literal as a value (`format_args(\"{a}-{b}\").to_string_in(gpa)`):\n// the literal's Display value, passed through.\n// later: format_fns\n#[effects()]\npub fn format_args<T: Display>(x: T) -> T {\n    x\n}\n// ---- end mod std::fmt ----\n}\n// ---- mod std::flt ----\nmod flt {\n// std: new: the floats' digits, for their Display, Debug, LowerExp and\n// UpperExp and their FromStr (front-rust.md F15.5; the compiler's builtin\n// impls call these). Exact: a float's value is m * 2^e, and its digits\n// are found with big integers (Steele and White's free format and an exact\n// division, as Rust's flt2dec Dragon fallback), so `{}` gives the shortest\n// digits that read back as the same float, `{:.N}` and `{:.Ne}` round the\n// exact value half to even, and parsing rounds to the nearest float.\n// Not Rust's: no Grisu fast path (a few big-integer steps per digit).\n\nuse crate::fmt::{Alignment, Formatter, Result};\n\n// A big unsigned integer: base 2^32 limbs, least significant first.\n// 160 limbs hold 5120 bits: an f64's exact value scaled by 10^k, and a\n// parse's 781 digits by its power of ten, are less than 4000.\nstruct Big {\n    d: [u32; 160],\n    n: usize,\n}\n\nimpl Big {\n    fn from_u64(v: u64) -> Big {\n        let mut b = Big { d: [0u32; 160], n: 0 };\n        b.d[0] = v as u32;\n        b.d[1] = (v >> 32) as u32;\n        b.n = 2;\n        b.trim();\n        b\n    }\n\n    fn copy(&self) -> Big {\n        let mut b = Big { d: [0u32; 160], n: self.n };\n        let mut i: usize = 0;\n        while i < self.n {\n            b.d[i] = self.d[i];\n");
    buf_str(out, c"            i += 1;\n        }\n        b\n    }\n\n    fn trim(&mut self) {\n        while self.n > 0 && self.d[self.n - 1] == 0 {\n            self.n -= 1;\n        }\n    }\n\n    fn is_zero(&self) -> bool {\n        self.n == 0\n    }\n\n    fn bits(&self) -> usize {\n        if self.n == 0 {\n            return 0;\n        }\n        let mut top = self.d[self.n - 1];\n        let mut b: usize = (self.n - 1) * 32;\n        while top != 0 {\n            b += 1;\n            top = top >> 1;\n        }\n        b\n    }\n\n    fn mul_small(&mut self, m: u32) {\n        let mut carry: u64 = 0;\n        let mut i: usize = 0;\n        while i < self.n {\n            let t = (self.d[i] as u64) * (m as u64) + carry;\n            self.d[i] = t as u32;\n            carry = t >> 32;\n            i += 1;\n        }\n        if carry != 0 {\n            self.d[self.n] = carry as u32;\n            self.n += 1;\n        }\n    }\n\n    fn add_small(&mut self, a: u32) {\n        let mut carry: u64 = a as u64;\n        let mut i: usize = 0;\n        while carry != 0 {\n            if i == self.n {\n                self.d[i] = 0;\n                self.n += 1;\n            }\n            let t = (self.d[i] as u64) + carry;\n            self.d[i] = t as u32;\n            carry = t >> 32;\n            i += 1;\n        }\n    }\n\n    fn mul_pow10(&mut self, k: usize) {\n        let mut k = k;\n        while k >= 9 {\n            self.mul_small(1000000000);\n            k -= 9;\n        }\n        let mut m: u32 = 1;\n        while k > 0 {\n            m = m * 10;\n            k -= 1;\n        }\n        if m != 1 {\n            self.mul_small(m);\n        }\n    }\n\n    fn shl(&mut self, s: usize) {\n        if self.n == 0 || s == 0 {\n            return;\n        }\n        let words = s / 32;\n        let bits = s % 32;\n        let mut i = self.n;\n        // the top limb's spill, then each limb from the top down\n        self.d[self.n + words] = 0;\n        while i > 0 {\n");
    buf_str(out, c"            i -= 1;\n            let v = self.d[i] as u64;\n            let hi = ((v << bits) >> 32) as u32;\n            self.d[i + words + 1] = self.d[i + words + 1] | hi;\n            self.d[i + words] = (v << bits) as u32;\n        }\n        let mut j: usize = 0;\n        while j < words {\n            self.d[j] = 0;\n            j += 1;\n        }\n        self.n = self.n + words + 1;\n        self.trim();\n    }\n\n    fn shr1(&mut self) {\n        let mut i: usize = 0;\n        while i < self.n {\n            let hi: u32 = if i + 1 < self.n { self.d[i + 1] << 31 } else { 0 };\n            self.d[i] = (self.d[i] >> 1) | hi;\n            i += 1;\n        }\n        self.trim();\n    }\n\n    // -1, 0 or 1 as self is less than, equal to or greater than o.\n    fn cmp(&self, o: &Big) -> i32 {\n        if self.n != o.n {\n            return if self.n < o.n { -1 } else { 1 };\n        }\n        let mut i = self.n;\n        while i > 0 {\n            i -= 1;\n            if self.d[i] != o.d[i] {\n                return if self.d[i] < o.d[i] { -1 } else { 1 };\n            }\n        }\n        0\n    }\n\n    fn add(&mut self, o: &Big) {\n        let n = if self.n > o.n { self.n } else { o.n };\n        let mut carry: u64 = 0;\n        let mut i: usize = 0;\n        while i < n {\n            let a: u64 = if i < self.n { self.d[i] as u64 } else { 0 };\n            let b: u64 = if i < o.n { o.d[i] as u64 } else { 0 };\n            let t = a + b + carry;\n            self.d[i] = t as u32;\n            carry = t >> 32;\n            i += 1;\n        }\n        self.n = n;\n        if carry != 0 {\n            self.d[n] = carry as u32;\n            self.n += 1;\n        }\n    }\n\n    // self - o, o not greater than self.\n    fn sub(&mut self, o: &Big) {\n        let mut borrow: u64 = 0;\n        let mut i: usize = 0;\n        while i < self.n {\n            let a = self.d[i] as u64;\n            let b: u64 = (if i < o.n { o.d[i] as u64 } else { 0 }) + borrow;\n");
    buf_str(out, c"            if a >= b {\n                self.d[i] = (a - b) as u32;\n                borrow = 0;\n            } else {\n                self.d[i] = (a + 4294967296 - b) as u32;\n                borrow = 1;\n            }\n            i += 1;\n        }\n        self.trim();\n    }\n\n    // The next digit of r / s, r < 10 s: the quotient, r left the remainder.\n    fn digit(r: &mut Big, s: &Big) -> u8 {\n        let mut d: u8 = 0;\n        while r.cmp(s) >= 0 {\n            r.sub(s);\n            d += 1;\n        }\n        d\n    }\n}\n\n// -1, 0 or 1 as a + b is less than, equal to or greater than c.\nfn cmp_sum(a: &Big, b: &Big, c: &Big) -> i32 {\n    let mut t = a.copy();\n    t.add(b);\n    t.cmp(c)\n}\n\n// A finite, nonzero v's m and e (v = m * 2^e), for an f64 (53 bits, e at\n// least -1074) or an f32 (24 bits, e at least -149), without its bits:\n// scaling by a power of two is exact for a float of this range.\nfn decompose(v: f64, is32: bool) -> (u64, i32) {\n    let two32: f64 = 4294967296.0;\n    let mut x = v;\n    let mut e: i32 = 0;\n    while x >= 9007199254740992.0 * two32 {\n        x = x / two32;\n        e += 32;\n    }\n    while x >= 9007199254740992.0 {\n        x = x / 2.0;\n        e += 1;\n    }\n    while x < 4503599627370496.0 / two32 {\n        x = x * two32;\n        e -= 32;\n    }\n    while x < 4503599627370496.0 {\n        x = x * 2.0;\n        e -= 1;\n    }\n    let mut m = x as u64;\n    // A subnormal's m has the low bits zero that its exponent cannot show.\n    let (bits_down, min_e): (i32, i32) = if is32 { (29, -149) } else { (0, -1074) };\n    let mut te = e + bits_down;\n    if te < min_e {\n        te = min_e;\n    }\n    m = m >> ((te - e) as u64);\n    (m, te)\n}\n\n// A float as digits: d[..n], the value 0.d1d2.. * 10^k.\nstruct Digits {\n    d: [u8; 1200],\n    n: usize,\n    k: i32,\n}\n\n// The bits a float's mantissa has, and its least exponent.\nfn format_params(is32: bool) -> (u64, i32) {\n");
    buf_str(out, c"    if is32 { (24, -149) } else { (53, -1074) }\n}\n\n// r / s scaled into [1/10, 1): the k with value = r / s * 10^k.\nfn scale(r: &mut Big, s: &mut Big, mp: &mut Big, mm: &mut Big, m: u64, e: i32) -> i32 {\n    // an estimate of ceil(log10(value)), then exact fixups\n    let bitlen: i32 = 64 - (m.leading_zeros() as i32) + e;\n    let mut k: i32 = ((bitlen as i64) * 30103 / 100000) as i32;\n    if k > 0 {\n        s.mul_pow10(k as usize);\n    } else if k < 0 {\n        r.mul_pow10((-k) as usize);\n        mp.mul_pow10((-k) as usize);\n        mm.mul_pow10((-k) as usize);\n    }\n    while r.cmp(s) >= 0 {\n        s.mul_small(10);\n        k += 1;\n    }\n    loop {\n        let mut t = r.copy();\n        t.mul_small(10);\n        if t.cmp(s) >= 0 {\n            break;\n        }\n        r.mul_small(10);\n        mp.mul_small(10);\n        mm.mul_small(10);\n        k -= 1;\n    }\n    k\n}\n\n// The shortest digits that read back as m * 2^e (Steele and White's free\n// format, Burger and Dybvig's fixup): a reader rounds half to even, so the\n// interval's ends count when m is even.\nfn shortest(m: u64, e: i32, is32: bool) -> Digits {\n    let (mbits, min_e) = format_params(is32);\n    let hidden: u64 = 1 << (mbits - 1);\n    let lower_close = m == hidden && e > min_e;\n    let mut r = Big::from_u64(m);\n    let mut s = Big::from_u64(1);\n    let mut mp = Big::from_u64(1);\n    let mut mm = Big::from_u64(1);\n    if e >= 0 {\n        r.shl(e as usize);\n        mp.shl(e as usize);\n        mm.shl(e as usize);\n    } else {\n        s.shl((-e) as usize);\n    }\n    // doubled, so the half gaps are whole: r = 2v, the gaps mp and mm\n    r.shl(1);\n    s.shl(1);\n    if lower_close {\n        // the gap below is half the gap above\n        r.shl(1);\n        s.shl(1);\n        mp.shl(1);\n    }\n    let even = m % 2 == 0;\n    let mut out = Digits { d: [0u8; 1200], n: 0, k: 0 };\n    // k: the least with v + gap below 10^k (counted as the reader would)\n");
    buf_str(out, c"    let bitlen: i32 = 64 - (m.leading_zeros() as i32) + e;\n    let est: i32 = ((bitlen as i64) * 30103 / 100000) as i32;\n    if est > 0 {\n        s.mul_pow10(est as usize);\n    } else if est < 0 {\n        r.mul_pow10((-est) as usize);\n        mp.mul_pow10((-est) as usize);\n        mm.mul_pow10((-est) as usize);\n    }\n    let mut k = est;\n    loop {\n        let c = cmp_sum(&r, &mp, &s);\n        if c > 0 || (c == 0 && even) {\n            s.mul_small(10);\n            k += 1;\n        } else {\n            break;\n        }\n    }\n    loop {\n        let mut t = r.copy();\n        t.add(&mp);\n        t.mul_small(10);\n        let c = t.cmp(&s);\n        if c < 0 || (c == 0 && !even) {\n            r.mul_small(10);\n            mp.mul_small(10);\n            mm.mul_small(10);\n            k -= 1;\n        } else {\n            break;\n        }\n    }\n    out.k = k;\n    loop {\n        r.mul_small(10);\n        mp.mul_small(10);\n        mm.mul_small(10);\n        let mut d = Big::digit(&mut r, &s);\n        let c1 = r.cmp(&mm);\n        let low = c1 < 0 || (c1 == 0 && even);\n        let c2 = cmp_sum(&r, &mp, &s);\n        let high = c2 > 0 || (c2 == 0 && even);\n        if low || high {\n            if high && !low {\n                d += 1;\n            } else if low && high {\n                // both ends reach: the nearer digit, the upper one at a tie\n                // (as Rust's flt2dec: `-235497785839029.625` is `..029.63`)\n                let mut t = r.copy();\n                t.shl(1);\n                if t.cmp(&s) >= 0 {\n                    d += 1;\n                }\n            }\n            out.d[out.n] = d;\n            out.n += 1;\n            return out;\n        }\n        out.d[out.n] = d;\n        out.n += 1;\n    }\n}\n\n// The exact digits of m * 2^e, rounded half to even at a place: with\n// `sig`, to `count` significant digits; else to `count` digits after the\n");
    buf_str(out, c"// point. n may be less (the rest are zeros); a rounding up that carries\n// out of the first digit raises k.\nfn exact(m: u64, e: i32, sig: bool, count: i64) -> Digits {\n    let mut r = Big::from_u64(m);\n    let mut s = Big::from_u64(1);\n    if e >= 0 {\n        r.shl(e as usize);\n    } else {\n        s.shl((-e) as usize);\n    }\n    let mut mp = Big::from_u64(0);\n    let mut mm = Big::from_u64(0);\n    let k = scale(&mut r, &mut s, &mut mp, &mut mm, m, e);\n    let mut out = Digits { d: [0u8; 1200], n: 0, k: k };\n    // the digits wanted: value = 0.d1d2.. * 10^k, so the place 10^-count\n    // is digit k + count\n    let want: i64 = if sig { count } else { (k as i64) + count };\n    if want < 0 {\n        // below half of the last place: zero\n        return out;\n    }\n    let mut i: i64 = 0;\n    while i < want && !r.is_zero() && out.n < 1200 {\n        r.mul_small(10);\n        let d = Big::digit(&mut r, &s);\n        out.d[out.n] = d;\n        out.n += 1;\n        i += 1;\n    }\n    if r.is_zero() || i < want {\n        // exact: nothing left to round (or more digits than the value has)\n        return out;\n    }\n    // round on what is left: r / s against a half\n    r.shl(1);\n    let c = r.cmp(&s);\n    let last_odd = out.n > 0 && out.d[out.n - 1] % 2 == 1;\n    if c > 0 || (c == 0 && last_odd) {\n        // up, carrying\n        let mut j = out.n;\n        loop {\n            if j == 0 {\n                // 9.99 up to 10.0: one digit, a place higher\n                out.d[0] = 1;\n                out.n = 1;\n                out.k += 1;\n                break;\n            }\n            j -= 1;\n            if out.d[j] == 9 {\n                out.d[j] = 0;\n                out.n = j;\n            } else {\n                out.d[j] += 1;\n                break;\n            }\n        }\n    }\n    out\n}\n\n// The text of a float: [sign] head zeros tail, padded as the hole says.\nstruct Text {\n    head: [u8; 1400],\n    hn: usize,\n");
    buf_str(out, c"    zeros: usize,\n    tail: [u8; 8],\n    tn: usize,\n}\n\nimpl Text {\n    fn new() -> Text {\n        Text { head: [0u8; 1400], hn: 0, zeros: 0, tail: [0u8; 8], tn: 0 }\n    }\n\n    fn push(&mut self, b: u8) {\n        if self.zeros > 0 {\n            // a digit after counted zeros: write them out first\n            while self.zeros > 0 && self.hn < 1400 {\n                self.head[self.hn] = 48;\n                self.hn += 1;\n                self.zeros -= 1;\n            }\n        }\n        if self.hn < 1400 {\n            self.head[self.hn] = b;\n            self.hn += 1;\n        }\n    }\n\n    fn push_str(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            self.push(b[i]);\n            i += 1;\n        }\n    }\n\n    fn exponent(&mut self, upper: bool, x: i32) {\n        self.tail[0] = if upper { 69 } else { 101 };\n        self.tn = 1;\n        let mut v = x;\n        if v < 0 {\n            self.tail[1] = 45;\n            self.tn = 2;\n            v = -v;\n        }\n        let mut buf = [0u8; 4];\n        let mut i: usize = 4;\n        loop {\n            i -= 1;\n            buf[i] = 48 + (v % 10) as u8;\n            v = v / 10;\n            if v == 0 {\n                break;\n            }\n        }\n        while i < 4 {\n            self.tail[self.tn] = buf[i];\n            self.tn += 1;\n            i += 1;\n        }\n    }\n\n    fn len(&self) -> usize {\n        self.hn + self.zeros + self.tn\n    }\n}\n\nfn write_bytes(f: &mut Formatter<'_>, b: &[u8]) -> Result {\n    match crate::str::from_utf8(b) {\n        crate::result::Result::Ok(s) => f.write_str(s),\n        crate::result::Result::Err(_) => crate::result::Result::Ok(()),\n    }\n}\n\nfn write_fill(f: &mut Formatter<'_>, c: char, n: usize) -> Result {\n    let mut i: usize = 0;\n    while i < n {\n        f.write_char(c)?;\n        i += 1;\n    }\n    crate::result::Result::Ok(())\n}\n\n");
    buf_str(out, c"// sign and t padded to the width: `0` puts zeros after the sign, else the\n// fill goes where the alignment says (right by default), as Rust's\n// pad_formatted_parts.\nfn pad_text(f: &mut Formatter<'_>, sign: &str, t: &Text) -> Result {\n    let len = sign.len() + t.len();\n    let width = match f.width() {\n        crate::option::Option::Some(w) => w,\n        crate::option::Option::None => 0,\n    };\n    if len < width && f.sign_aware_zero_pad() {\n        f.write_str(sign)?;\n        write_fill(f, '0', width - len)?;\n        return write_text(f, t);\n    }\n    let p: usize = if len >= width { 0 } else { width - len };\n    let fill = f.fill();\n    let (pre, post): (usize, usize) = match f.align() {\n        crate::option::Option::Some(Alignment::Left) => (0, p),\n        crate::option::Option::Some(Alignment::Center) => (p / 2, p - p / 2),\n        _ => (p, 0),\n    };\n    write_fill(f, fill, pre)?;\n    f.write_str(sign)?;\n    write_text(f, t)?;\n    write_fill(f, fill, post)\n}\n\nfn write_text(f: &mut Formatter<'_>, t: &Text) -> Result {\n    write_bytes(f, &t.head[..t.hn])?;\n    write_fill(f, '0', t.zeros)?;\n    write_bytes(f, &t.tail[..t.tn])\n}\n\n// digits as a fixed-point number: at least `frac` digits after the point\n// (and exactly `frac` when `exactly`).\nfn fixed(t: &mut Text, d: &Digits, frac: usize, exactly: bool) {\n    let k = d.k as i64;\n    let n = d.n as i64;\n    // the integer part\n    if k <= 0 {\n        t.push(48);\n    } else {\n        let mut i: i64 = 0;\n        while i < k {\n            t.push(if i < n { 48 + d.d[i as usize] } else { 48 });\n            i += 1;\n        }\n    }\n    // the fraction: the digits after the point, then zeros to frac\n    let have: i64 = if n > k { n - k } else { 0 };\n    let shown: i64 = if exactly { frac as i64 } else if have > frac as i64 { have }\n        else { frac as i64 };\n    if shown == 0 {\n        return;\n    }\n    t.push(46);\n    let mut j: i64 = 0;\n    while j < shown {\n");
    buf_str(out, c"        // place j after the point is digit k + j\n        let at = k + j;\n        if at >= n {\n            t.zeros += (shown - j) as usize;\n            return;\n        }\n        t.push(if at < 0 { 48 } else { 48 + d.d[at as usize] });\n        j += 1;\n    }\n}\n\n// digits as d.ddd e x: `frac` digits after the point at least.\nfn scientific(t: &mut Text, d: &Digits, frac: usize, upper: bool) {\n    let n = d.n;\n    t.push(48 + if n > 0 { d.d[0] } else { 0 });\n    let have = if n > 1 { n - 1 } else { 0 };\n    let shown = if have > frac { have } else { frac };\n    if shown > 0 {\n        t.push(46);\n        let mut j: usize = 1;\n        while j < n {\n            t.push(48 + d.d[j]);\n            j += 1;\n        }\n        t.zeros += shown - have;\n    }\n    t.exponent(upper, if n > 0 { d.k - 1 } else { 0 });\n}\n\n// A float as its Display (kind 0), Debug (1), LowerExp (2) or UpperExp (3)\n// writes it; an f32's value comes as the f64 it converts to, exactly.\n// terminates: the loops below it step through a Big's 160 limbs, make one\n// of a Digits' 1200 digits or a Text's 1400 bytes (the arrays' bounds end\n// them), scale by the float's exponent (2200 binary places at most) or\n// write the precision's zeros.\n#[terminates]\n#[effects(panic)]\npub(crate) fn fmt_float(v: f64, is32: bool, kind: u8, f: &mut Formatter<'_>) -> Result {\n    let mut t = Text::new();\n    if v != v {\n        // NaN: no sign, even with `+`\n        t.push_str(\"NaN\");\n        return pad_text(f, \"\", &t);\n    }\n    let neg = v < 0.0 || (v == 0.0 && 1.0 / v < 0.0);\n    let sign: &str = if neg { \"-\" } else if f.sign_plus() { \"+\" } else { \"\" };\n    let a = if neg { -v } else { v };\n    let upper = kind == 3;\n    if a == 1.0 / 0.0 {\n        t.push_str(\"inf\");\n        return pad_text(f, sign, &t);\n    }\n    let prec = f.precision();\n    let exp_form = kind >= 2\n");
    buf_str(out, c"        || (kind == 1 && prec.is_none() && a != 0.0 && (a < 0.0001 || a >= 10000000000000000.0));\n    if a == 0.0 {\n        let p = match prec {\n            crate::option::Option::Some(p) => p,\n            crate::option::Option::None => if kind == 1 && !exp_form { 1 } else { 0 },\n        };\n        let zero = Digits { d: [0u8; 1200], n: 0, k: 1 };\n        if exp_form {\n            scientific(&mut t, &zero, p, upper);\n        } else {\n            fixed(&mut t, &zero, p, true);\n        }\n        return pad_text(f, sign, &t);\n    }\n    let (m, e) = decompose(a, is32);\n    match prec {\n        crate::option::Option::Some(p) => {\n            if exp_form {\n                let d = exact(m, e, true, (p as i64) + 1);\n                scientific(&mut t, &d, p, upper);\n            } else {\n                let d = exact(m, e, false, p as i64);\n                fixed(&mut t, &d, p, true);\n            }\n        }\n        crate::option::Option::None => {\n            let d = shortest(m, e, is32);\n            if exp_form {\n                scientific(&mut t, &d, 0, upper);\n            } else {\n                fixed(&mut t, &d, if kind == 1 { 1 } else { 0 }, false);\n            }\n        }\n    }\n    pad_text(f, sign, &t)\n}\n\n// s as a float, rounded to the nearest (half to even): Rust's grammar, a\n// sign, then `inf`, `infinity` or `nan` in any case, or digits with a\n// point and an exponent (`1.5`, `.5`, `5.`, `1e-3`, `+3.5E+2`). Err(true)\n// when s is empty, Err(false) when it is not a float. An f32's comes as\n// the f64 of its value, exactly.\n#[effects(panic, diverge)]\npub(crate) fn parse_float(s: &str, is32: bool) -> crate::result::Result<f64, bool> {\n    let b = s.as_bytes();\n    let n = b.len();\n    if n == 0 {\n        return crate::result::Result::Err(true);\n    }\n    let mut i: usize = 0;\n    let mut neg = false;\n    if b[0] == 43 || b[0] == 45 {\n        neg = b[0] == 45;\n        i = 1;\n    }\n");
    buf_str(out, c"    let sign: f64 = if neg { -1.0 } else { 1.0 };\n    let rest = &b[i..];\n    if eq_lower(rest, \"inf\") || eq_lower(rest, \"infinity\") {\n        return crate::result::Result::Ok(sign / 0.0);\n    }\n    if eq_lower(rest, \"nan\") {\n        let z: f64 = 0.0;\n        return crate::result::Result::Ok(z / z);\n    }\n    // the digits: at most 780 kept, a dropped nonzero one kept as a 1\n    let mut big = Big::from_u64(0);\n    let mut kept: usize = 0;\n    let mut dropped = false;\n    let mut exp10: i64 = 0;\n    let mut any = false;\n    let mut point = false;\n    while i < n {\n        let c = b[i];\n        if c >= 48 && c <= 57 {\n            any = true;\n            if kept == 0 && c == 48 {\n                // a leading zero: only the place moves\n                if point {\n                    exp10 -= 1;\n                }\n            } else if kept < 780 {\n                big.mul_small(10);\n                big.add_small((c - 48) as u32);\n                kept += 1;\n                if point {\n                    exp10 -= 1;\n                }\n            } else {\n                if c != 48 {\n                    dropped = true;\n                }\n                if !point {\n                    exp10 += 1;\n                }\n            }\n        } else if c == 46 && !point {\n            point = true;\n        } else {\n            break;\n        }\n        i += 1;\n    }\n    if !any {\n        return crate::result::Result::Err(false);\n    }\n    if i < n {\n        if b[i] != 101 && b[i] != 69 {\n            return crate::result::Result::Err(false);\n        }\n        i += 1;\n        let mut eneg = false;\n        if i < n && (b[i] == 43 || b[i] == 45) {\n            eneg = b[i] == 45;\n            i += 1;\n        }\n        if i == n {\n            return crate::result::Result::Err(false);\n        }\n        let mut x: i64 = 0;\n        while i < n {\n            let c = b[i];\n            if c < 48 || c > 57 {\n");
    buf_str(out, c"                return crate::result::Result::Err(false);\n            }\n            if x < 100000000 {\n                x = x * 10 + ((c - 48) as i64);\n            }\n            i += 1;\n        }\n        exp10 += if eneg { -x } else { x };\n    }\n    if dropped {\n        big.mul_small(10);\n        big.add_small(1);\n        kept += 1;\n        exp10 -= 1;\n    }\n    if big.is_zero() {\n        return crate::result::Result::Ok(sign * 0.0);\n    }\n    // the decimal exponent of the first digit: past the ranges, inf or 0\n    let top = exp10 + (kept as i64);\n    if top > 310 {\n        return crate::result::Result::Ok(sign / 0.0);\n    }\n    if top < -326 {\n        return crate::result::Result::Ok(sign * 0.0);\n    }\n    let (mbits, min_e) = format_params(is32);\n    let mbits = mbits as i64;\n    let min_e = min_e as i64;\n    let max_biased: i64 = if is32 { 255 } else { 2047 };\n    let bias: i64 = if is32 { 127 } else { 1023 };\n    // value = num / den\n    let mut num = big;\n    let mut den = Big::from_u64(1);\n    if exp10 >= 0 {\n        num.mul_pow10(exp10 as usize);\n    } else {\n        den.mul_pow10((-exp10) as usize);\n    }\n    // q = floor(value / 2^b), mbits + 2 bits at most\n    let mut b2: i64 = (num.bits() as i64) - (den.bits() as i64) - mbits - 2;\n    if b2 < min_e - 1 {\n        b2 = min_e - 1;\n    }\n    if b2 < 0 {\n        num.shl((-b2) as usize);\n    } else {\n        den.shl(b2 as usize);\n    }\n    let mut q: u64 = 0;\n    let mut t = den.copy();\n    t.shl(57);\n    let mut bit: i64 = 57;\n    while bit >= 0 {\n        if num.cmp(&t) >= 0 {\n            num.sub(&t);\n            q = q | (1u64 << (bit as u64));\n        }\n        t.shr1();\n        bit -= 1;\n    }\n    let mut sticky = !num.is_zero();\n    let limit: u64 = 1u64 << ((mbits + 1) as u64);\n    while q >= limit {\n        sticky = sticky || q % 2 == 1;\n        q = q >> 1;\n        b2 += 1;\n    }\n    let round = q % 2 == 1;\n    let mut m = q >> 1;\n");
    buf_str(out, c"    let mut e = b2 + 1;\n    if round && (sticky || m % 2 == 1) {\n        m += 1;\n        if m == (1u64 << (mbits as u64)) {\n            m = m >> 1;\n            e += 1;\n        }\n    }\n    let hidden: u64 = 1u64 << ((mbits - 1) as u64);\n    if m >= hidden && e + bias + mbits - 1 >= max_biased {\n        return crate::result::Result::Ok(sign / 0.0);\n    }\n    crate::result::Result::Ok(sign * scale2(m as f64, e))\n}\n\n// x * 2^e, exactly: each step's value is m * 2^j between the two, which\n// the float holds.\nfn scale2(x: f64, e: i64) -> f64 {\n    let two32: f64 = 4294967296.0;\n    let mut v = x;\n    let mut e = e;\n    while e >= 32 {\n        v = v * two32;\n        e -= 32;\n    }\n    while e > 0 {\n        v = v * 2.0;\n        e -= 1;\n    }\n    while e <= -32 {\n        v = v / two32;\n        e += 32;\n    }\n    while e < 0 {\n        v = v / 2.0;\n        e += 1;\n    }\n    v\n}\n\n// b equal to the ASCII word w, in any case.\nfn eq_lower(b: &[u8], w: &str) -> bool {\n    let wb = w.as_bytes();\n    if b.len() != wb.len() {\n        return false;\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        let c = b[i];\n        let lc = if c >= 65 && c <= 90 { c + 32 } else { c };\n        if lc != wb[i] {\n            return false;\n        }\n        i += 1;\n    }\n    true\n}\n\n// \"true\" or \"false\", as bool's FromStr reads them.\n#[effects(panic)]\npub(crate) fn parse_bool(s: &str) -> crate::option::Option<bool> {\n    let b = s.as_bytes();\n    if b == \"true\".as_bytes() {\n        crate::option::Option::Some(true)\n    } else if b == \"false\".as_bytes() {\n        crate::option::Option::Some(false)\n    } else {\n        crate::option::Option::None\n    }\n}\n\n// An integer's LowerExp or UpperExp (`{:e}` of 1234 is 1.234e3): its exact\n// digits, rounded half to even to the precision.\n// terminates: a u64's 20 digits at most, then the precision's zeros.\n#[terminates]\n#[effects(panic)]\n");
    buf_str(out, c"pub(crate) fn fmt_int_exp(neg: bool, v: u64, upper: bool, f: &mut Formatter<'_>) -> Result {\n    let mut t = Text::new();\n    let sign: &str = if neg { \"-\" } else if f.sign_plus() { \"+\" } else { \"\" };\n    let p = match f.precision() {\n        crate::option::Option::Some(p) => p,\n        crate::option::Option::None => 0,\n    };\n    if v == 0 {\n        let zero = Digits { d: [0u8; 1200], n: 0, k: 1 };\n        scientific(&mut t, &zero, p, upper);\n        return pad_text(f, sign, &t);\n    }\n    let count: i64 = match f.precision() {\n        crate::option::Option::Some(p) => (p as i64) + 1,\n        crate::option::Option::None => 40,\n    };\n    let d = int_digits(v, count as usize);\n    scientific(&mut t, &d, p, upper);\n    pad_text(f, sign, &t)\n}\n\n// The digits of v > 0, rounded half to even to `count` significant digits\n// (count >= 1), trailing zeros left out: what `exact(v, 0, true, count)`\n// gives, without the big numbers a float needs (a program that prints no\n// float keeps none of them).\nfn int_digits(v: u64, count: usize) -> Digits {\n    let mut out = Digits { d: [0u8; 1200], n: 0, k: 0 };\n    let mut rev = [0u8; 20];\n    let mut n: usize = 0;\n    let mut x = v;\n    while x > 0 {\n        rev[n] = (x % 10) as u8;\n        x /= 10;\n        n += 1;\n    }\n    out.k = n as i32;\n    let mut i: usize = 0;\n    while i < n {\n        out.d[i] = rev[n - 1 - i];\n        i += 1;\n    }\n    out.n = n;\n    if count < n {\n        let mut rest = false;\n        let mut j = count + 1;\n        while j < n {\n            if out.d[j] != 0 {\n                rest = true;\n            }\n            j += 1;\n        }\n        let half = out.d[count];\n        let last_odd = out.d[count - 1] % 2 == 1;\n        out.n = count;\n        if half > 5 || (half == 5 && (rest || last_odd)) {\n            // up, carrying\n            let mut j = out.n;\n            loop {\n                if j == 0 {\n");
    buf_str(out, c"                    // 9.99 up to 10.0: one digit, a place higher\n                    out.d[0] = 1;\n                    out.n = 1;\n                    out.k += 1;\n                    break;\n                }\n                j -= 1;\n                if out.d[j] == 9 {\n                    out.d[j] = 0;\n                    out.n = j;\n                } else {\n                    out.d[j] += 1;\n                    break;\n                }\n            }\n        }\n    }\n    while out.n > 0 && out.d[out.n - 1] == 0 {\n        out.n -= 1;\n    }\n    out\n}\n// ---- end mod std::flt ----\n}\n// ---- mod std::fmath ----\nmod fmath {\n// std's float math (private): the algorithms of MVS's std::math, read by\n// f64's and f32's inherent methods (num.vl): `x.sqrt()`, `x.floor()`,\n// `y.atan2(x)`, Rust's names and semantics. No C and no libm: the same\n// results on every target.\n// mvs: std::math\n\n// v's IEEE 754 bits (f64::to_bits).\n#[effects(unsafe)]\npub(crate) fn f64_to_bits(v: f64) -> u64 {\n    // UNSAFE: an f64's bits read as a u64 (Rust's transmute).\n    // SAFETY: both are 8 bytes with the same alignment, and any bits are\n    // a valid u64; v is a live local.\n    unsafe { *(&v as *const f64 as *const u64) }\n}\n\n// The f64 with these bits (f64::from_bits).\n#[effects(unsafe)]\npub(crate) fn f64_from_bits(u: u64) -> f64 {\n    // UNSAFE: a u64's bits read as an f64 (Rust's transmute).\n    // SAFETY: both are 8 bytes with the same alignment, and any bits are\n    // a valid f64; u is a live local.\n    unsafe { *(&u as *const u64 as *const f64) }\n}\n\n// v's IEEE 754 bits (f32::to_bits).\n#[effects(unsafe)]\npub(crate) fn f32_to_bits(v: f32) -> u32 {\n    // UNSAFE: an f32's bits read as a u32 (Rust's transmute).\n    // SAFETY: both are 4 bytes with the same alignment, and any bits are\n    // a valid u32; v is a live local.\n    unsafe { *(&v as *const f32 as *const u32) }\n}\n\n// The f32 with these bits (f32::from_bits).\n#[effects(unsafe)]\n");
    buf_str(out, c"pub(crate) fn f32_from_bits(u: u32) -> f32 {\n    // UNSAFE: a u32's bits read as an f32 (Rust's transmute).\n    // SAFETY: both are 4 bytes with the same alignment, and any bits are\n    // a valid f32; u is a live local.\n    unsafe { *(&u as *const u32 as *const f32) }\n}\n\n// x's neighbour above (up) or below, as Rust's next_up and next_down: by\n// its bits, which order the numbers of one sign (0.25.5).\nfn next64(x: f64, up: bool) -> f64 {\n    let bits = f64_to_bits(x);\n    let abs = bits & 0x7fffffffffffffff;\n    // (NaN, and the infinity in the direction of the step, stay)\n    if abs > 0x7ff0000000000000\n        || bits == (if up { 0x7ff0000000000000u64 } else { 0xfff0000000000000u64 }) {\n        return x;\n    }\n    if abs == 0 {\n        return f64_from_bits(if up { 1u64 } else { 0x8000000000000001u64 });\n    }\n    // (away from zero when the step goes x's way)\n    let away = (bits == abs) == up;\n    f64_from_bits(if away { bits + 1 } else { bits - 1 })\n}\n\nfn next32(x: f32, up: bool) -> f32 {\n    let bits = f32_to_bits(x);\n    let abs = bits & 0x7fffffff;\n    if abs > 0x7f800000 || bits == (if up { 0x7f800000u32 } else { 0xff800000u32 }) {\n        return x;\n    }\n    if abs == 0 {\n        return f32_from_bits(if up { 1u32 } else { 0x80000001u32 });\n    }\n    let away = (bits == abs) == up;\n    f32_from_bits(if away { bits + 1 } else { bits - 1 })\n}\n\n// ---- Math: bits, rounding, min and max (0.25.2.1) ----\n\n// The methods of f32 and f64 (`x.sqrt()`, `y.atan2(x)`), Rust's names and\n// semantics, are the trait Float's; `math::sqrt(x)` and the others are\n// functions over it. The constants are the compiler's (`f64::EPSILON`,\n// `f64::consts::PI`, as `i64::MAX`).\n//\n// The f64 algorithms are FreeBSD msun's and musl's (fdlibm), as the Rust\n// libm crate has them; their notice:\n//\n//   Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.\n//   Developed at SunSoft, a Sun Microsystems, Inc. business.\n");
    buf_str(out, c"//   Permission to use, copy, modify, and distribute this software is\n//   freely granted, provided that this notice is preserved.\n//\n// f32's are f64's, rounded once. sqrt is correctly rounded (exact\n// integer check); the others are within a few ulp of the true value\n// (tests/run/math_vs_libm measures them against the system's libm).\n\n// The high and low 32 bits of x (fdlibm's GET_HIGH_WORD, GET_LOW_WORD).\n#[inline]\nfn hi_word(x: f64) -> u32 { (f64_to_bits(x) >> 32) as u32 }\n\n#[inline]\nfn lo_word(x: f64) -> u32 { f64_to_bits(x) as u32 }\n\n// x with its low 32 bits l (SET_LOW_WORD).\n#[inline]\nfn with_lo_word(x: f64, l: u32) -> f64 {\n    f64_from_bits(f64_to_bits(x) & 0xffffffff00000000 | l as u64)\n}\n\n// The f64 of the words h, l (INSERT_WORDS).\n#[inline]\nfn from_words(h: u32, l: u32) -> f64 { f64_from_bits((h as u64) << 32 | l as u64) }\n\n// 2^k for a normal exponent, -1022 <= k <= 1023.\n#[inline]\nfn pow2(k: i64) -> f64 { f64_from_bits(((k + 1023) as u64) << 52) }\n\n#[inline]\nfn copysign64(x: f64, s: f64) -> f64 {\n    f64_from_bits(f64_to_bits(x) & 0x7fffffffffffffff | f64_to_bits(s) & 0x8000000000000000)\n}\n\n// x * 2^n, rounded once (musl's scalbn: the subnormal range is reached\n// in one last multiplication).\nfn scalbn(x: f64, n0: i32) -> f64 {\n    let mut n = n0;\n    let mut y = x;\n    if n > 1023 {\n        y *= pow2(1023);\n        n -= 1023;\n        if n > 1023 {\n            y *= pow2(1023);\n            n -= 1023;\n            if n > 1023 {\n                n = 1023;\n            }\n        }\n    } else if n < -1022 {\n        // (x * 2^-969 first: the last product's n then < -53, so that\n        // it rounds once into the subnormals)\n        y *= pow2(-1022) * pow2(53);\n        n += 1022 - 53;\n        if n < -1022 {\n            y *= pow2(-1022) * pow2(53);\n            n += 1022 - 53;\n            if n < -1022 {\n                n = -1022;\n            }\n        }\n    }\n    y * pow2(n as i64)\n}\n\n");
    buf_str(out, c"// x rounded toward zero: its fraction bits cleared.\nfn trunc64(x: f64) -> f64 {\n    let u = f64_to_bits(x);\n    let e = ((u >> 52) & 0x7ff) as i64 - 1023;\n    if e >= 52 {\n        // (an integer, an infinity or NaN)\n        return x;\n    }\n    if e < 0 {\n        return f64_from_bits(u & 0x8000000000000000);\n    }\n    let m: u64 = 0x000fffffffffffff >> e as u64;\n    f64_from_bits(u & !m)\n}\n\nfn floor64(x: f64) -> f64 {\n    let t = trunc64(x);\n    // (exact: below 2^52 an integer minus 1 is one)\n    if x < t { t - 1.0 } else { t }\n}\n\nfn ceil64(x: f64) -> f64 {\n    let t = trunc64(x);\n    if x > t { t + 1.0 } else { t }\n}\n\n// Half-way cases away from zero; x - trunc(x) is exact.\nfn round64(x: f64) -> f64 {\n    let t = trunc64(x);\n    let d = x - t;\n    if d >= 0.5 { t + 1.0 } else if d <= -0.5 { t - 1.0 } else { t }\n}\n\nfn round_even64(x: f64) -> f64 {\n    let t = trunc64(x);\n    let d = x - t;\n    // (t odd: t / 2 has a fraction; exact)\n    let odd = t * 0.5 != trunc64(t * 0.5);\n    if d > 0.5 || d == 0.5 && odd {\n        t + 1.0\n    } else if d < -0.5 || d == -0.5 && odd {\n        t - 1.0\n    } else {\n        t\n    }\n}\n\n// musl's fmin and fmax: NaN loses; -0.0 < +0.0.\nfn min64(x: f64, y: f64) -> f64 {\n    if x != x {\n        return y;\n    }\n    if y != y {\n        return x;\n    }\n    if f64_to_bits(x) >> 63 != f64_to_bits(y) >> 63 {\n        return if f64_to_bits(x) >> 63 != 0 { x } else { y };\n    }\n    if x < y { x } else { y }\n}\n\nfn max64(x: f64, y: f64) -> f64 {\n    if x != x {\n        return y;\n    }\n    if y != y {\n        return x;\n    }\n    if f64_to_bits(x) >> 63 != f64_to_bits(y) >> 63 {\n        return if f64_to_bits(x) >> 63 != 0 { y } else { x };\n    }\n    if x < y { y } else { x }\n}\n\nfn clamp64(x: f64, lo: f64, hi: f64) -> f64 {\n    let mut r = x;\n    if r < lo {\n        r = lo;\n    }\n    if r > hi {\n        r = hi;\n    }\n    r\n}\n\n");
    buf_str(out, c"// x^n by squaring (compiler-rt's __powidf2, Rust's powi).\nfn powi64(x: f64, n: i32) -> f64 {\n    let mut a = x;\n    let mut b = n as i64;\n    let recip = b < 0;\n    let mut r = 1.0;\n    loop {\n        if b & 1 != 0 {\n            r *= a;\n        }\n        b /= 2;\n        if b == 0 {\n            break;\n        }\n        a *= a;\n    }\n    if recip { 1.0 / r } else { r }\n}\n\n// ---- Math: roots (0.25.2.1) ----\n\n// The square root, correctly rounded. x = t * 2^(e - p) with t in\n// [1, 4) and e - p even; sqrt(x) = sqrt(t) * 2^((e - p) / 2), and\n// sqrt(t) * 2^52 rounded is the integer s with (s - 1/2)^2 < M < (s +\n// 1/2)^2, M = t * 2^104 (an integer: the significand shifted). The\n// estimate of s is f64's Newton iteration for 1/sqrt(t) (no division)\n// times t; the exact integer check moves it to the nearest, so the\n// rounding is exact whatever the estimate's last bits.\nfn sqrt64(x: f64) -> f64 {\n    let mut u = f64_to_bits(x);\n    if u >= 0x7ff0000000000000 {\n        // +inf, NaN, or negative\n        if u == 0x7ff0000000000000 || u == 0x8000000000000000 || x != x {\n            return x;\n        }\n        return f64::NAN;\n    }\n    if u == 0 {\n        return x;\n    }\n    let mut scale: i64 = 0;\n    if u < 0x0010000000000000 {\n        // a subnormal: times 2^108 (exact), the root times 2^-54\n        u = f64_to_bits(x * pow2(108));\n        scale = -54;\n    }\n    let e = (u >> 52) as i64 - 1023;\n    let mant = u & 0x000fffffffffffff | 0x0010000000000000;\n    let p = e & 1;\n    let t = f64_from_bits(u & 0x000fffffffffffff | ((1023 + p) as u64) << 52);\n    // 1/sqrt(t): the bit estimate (3.4% off), then four Newton steps\n    // (y * (1.5 - t/2 * y^2): 2e-3, 5e-6, 3e-11, then f64's rounding)\n    let mut y = f64_from_bits(0x5fe6eb50c7b537a9 - (f64_to_bits(t) >> 1));\n    let half = 0.5 * t;\n    y = y * (1.5 - half * y * y);\n    y = y * (1.5 - half * y * y);\n    y = y * (1.5 - half * y * y);\n");
    buf_str(out, c"    y = y * (1.5 - half * y * y);\n    let mut s = (t * y * pow2(52)) as u64;\n    // R = M - s^2, exact in 64 bits (|R| < 2^60: s is within a few units\n    // of sqrt(M), M < 2^106); s is the nearest iff -s < R <= s\n    let mut r = ((mant << (52 + p) as u64) as i64).wrapping_sub(s.wrapping_mul(s) as i64);\n    while r > s as i64 {\n        r -= 2 * s as i64 + 1;\n        s += 1;\n    }\n    while r <= -(s as i64) {\n        r += 2 * s as i64 - 1;\n        s -= 1;\n    }\n    let k = ((e - p) >> 1) + scale;\n    f64_from_bits(((k + 1023) as u64) << 52 | s - 0x0010000000000000)\n}\n\n// The cube root (fdlibm's s_cbrt, musl's cbrt before 2023): an estimate\n// from the exponent / 3, a polynomial to 23 bits, rounded to 21 bits,\n// then one step of Newton's method to 53 (error < 0.667 ulp).\nconst CBRT_B1: u32 = 715094163; // (1023 - 1023/3 - 0.03306235651) * 2^20\nconst CBRT_B2: u32 = 696219795; // (1023 - 1023/3 - 54/3 - 0.03306235651) * 2^20\nconst CBRT_P0: f64 = 1.87595182427177009643; // 0x3ffe03e6, 0x0f61e692\nconst CBRT_P1: f64 = -1.88497979543377169875; // 0xbffe28e0, 0x92f02420\nconst CBRT_P2: f64 = 1.621429720105354466140; // 0x3ff9f160, 0x4a49d6c2\nconst CBRT_P3: f64 = -0.758397934778766047437; // 0xbfe844cb, 0xbee751d9\nconst CBRT_P4: f64 = 0.145996192886612446982; // 0x3fc2b000, 0xd4e4edd7\n\nfn cbrt64(x: f64) -> f64 {\n    let mut u = f64_to_bits(x);\n    let mut hx = (u >> 32) as u32 & 0x7fffffff;\n    if hx >= 0x7ff00000 {\n        // NaN, inf\n        return x + x;\n    }\n    if hx < 0x00100000 {\n        // zero or subnormal\n        u = f64_to_bits(x * pow2(54));\n        hx = (u >> 32) as u32 & 0x7fffffff;\n        if hx == 0 {\n            return x;\n        }\n        hx = hx / 3 + CBRT_B2;\n    } else {\n        hx = hx / 3 + CBRT_B1;\n    }\n    u &= 0x8000000000000000;\n    u |= (hx as u64) << 32;\n    let mut t = f64_from_bits(u);\n    // 1/cbrt(x) to 23 bits: |1/cbrt(x) - p(x)| < 2^-23.5\n    let mut r = t * t * (t / x);\n");
    buf_str(out, c"    t = t * (CBRT_P0 + r * (CBRT_P1 + r * CBRT_P2) + r * r * r * (CBRT_P3 + r * CBRT_P4));\n    // t rounded away from zero to 21 bits: t*t exact below\n    u = f64_to_bits(t);\n    u = u + 0x80000000 & 0xffffffffc0000000;\n    t = f64_from_bits(u);\n    let s = t * t;\n    r = x / s;\n    let w = t + t;\n    r = (r - t) / (w + r);\n    t + t * r\n}\n\n// sqrt(x^2 + y^2) (musl's hypot): the squares exact as hi + lo\n// (Dekker's split, no fma), scaled by 2^+-700 out of overflow and\n// underflow.\nfn hypot_sq(x: f64) -> (f64, f64) {\n    // 2^27 + 1\n    let xc = x * 134217729.0;\n    let xh = x - xc + xc;\n    let xl = x - xh;\n    let hi = x * x;\n    let lo = xh * xh - hi + 2.0 * xh * xl + xl * xl;\n    (hi, lo)\n}\n\nfn hypot64(x0: f64, y0: f64) -> f64 {\n    let mut ux = f64_to_bits(x0) & 0x7fffffffffffffff;\n    let mut uy = f64_to_bits(y0) & 0x7fffffffffffffff;\n    if ux < uy {\n        let ut = ux;\n        ux = uy;\n        uy = ut;\n    }\n    let ex = (ux >> 52) as i64;\n    let ey = (uy >> 52) as i64;\n    let mut x = f64_from_bits(ux);\n    let mut y = f64_from_bits(uy);\n    // (hypot(inf, NaN) is inf)\n    if ey == 0x7ff {\n        return y;\n    }\n    if ex == 0x7ff || uy == 0 {\n        return x;\n    }\n    if ex - ey > 64 {\n        return x + y;\n    }\n    let mut z = 1.0;\n    if ex > 0x3ff + 510 {\n        z = pow2(700);\n        x *= pow2(-700);\n        y *= pow2(-700);\n    } else if ey < 0x3ff - 450 {\n        z = pow2(-700);\n        x *= pow2(700);\n        y *= pow2(700);\n    }\n    let (hx, lx) = hypot_sq(x);\n    let (hy, ly) = hypot_sq(y);\n    z * sqrt64(ly + lx + hy + hx)\n}\n\n// ---- Math: trigonometric kernels (0.25.2.1) ----\n\n// fdlibm's __kernel_sin, __kernel_cos, __kernel_tan on [-pi/4, pi/4],\n// x + y the reduced argument (y the tail).\nconst S1: f64 = -1.66666666666666324348e-01; // 0xBFC55555, 0x55555549\nconst S2: f64 = 8.33333333332248946124e-03; // 0x3F811111, 0x1110F8A6\n");
    buf_str(out, c"const S3: f64 = -1.98412698298579493134e-04; // 0xBF2A01A0, 0x19C161D5\nconst S4: f64 = 2.75573137070700676789e-06; // 0x3EC71DE3, 0x57B1FE7D\nconst S5: f64 = -2.50507602534068634195e-08; // 0xBE5AE5E6, 0x8A2B9CEB\nconst S6: f64 = 1.58969099521155010221e-10; // 0x3DE5D93A, 0x5ACFD57C\n\nfn k_sin(x: f64, y: f64, iy: i32) -> f64 {\n    let z = x * x;\n    let w = z * z;\n    let r = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6);\n    let v = z * x;\n    if iy == 0 { x + v * (S1 + z * r) } else { x - (z * (0.5 * y - v * r) - y - v * S1) }\n}\n\nconst C1: f64 = 4.16666666666666019037e-02; // 0x3FA55555, 0x5555554C\nconst C2: f64 = -1.38888888888741095749e-03; // 0xBF56C16C, 0x16C15177\nconst C3: f64 = 2.48015872894767294178e-05; // 0x3EFA01A0, 0x19CB1590\nconst C4: f64 = -2.75573143513906633035e-07; // 0xBE927E4F, 0x809C52AD\nconst C5: f64 = 2.08757232129817482790e-09; // 0x3E21EE9E, 0xBDB4B1C4\nconst C6: f64 = -1.13596475577881948265e-11; // 0xBDA8FAE9, 0xBE8838D4\n\nfn k_cos(x: f64, y: f64) -> f64 {\n    let z = x * x;\n    let w = z * z;\n    let r = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6));\n    let hz = 0.5 * z;\n    let w1 = 1.0 - hz;\n    w1 + (1.0 - w1 - hz + (z * r - x * y))\n}\n\nstatic TAN_T: [f64; 13] = [\n    3.33333333333334091986e-01, // 3FD55555, 55555563\n    1.33333333333201242699e-01, // 3FC11111, 1110FE7A\n    5.39682539762260521377e-02, // 3FABA1BA, 1BB341FE\n    2.18694882948595424599e-02, // 3F9664F4, 8406D637\n    8.86323982359930005737e-03, // 3F8226E3, E96E8493\n    3.59207910759131235356e-03, // 3F6D6D22, C9560328\n    1.45620945432529025516e-03, // 3F57DBC8, FEE08315\n    5.88041240820264096874e-04, // 3F4344D8, F2F26501\n    2.46463134818469906812e-04, // 3F3026F7, 1A8D1068\n    7.81794442939557092300e-05, // 3F147E88, A03792A6\n    7.14072491382608190305e-05, // 3F12B80F, 32F0A7E9\n    -1.85586374855275456654e-05, // BEF375CB, DB605373\n    2.59073051863633712884e-05, // 3EFB2A70, 74BF7AD4\n];\n");
    buf_str(out, c"const PIO4: f64 = 7.85398163397448278999e-01; // 3FE921FB, 54442D18\nconst PIO4_LO: f64 = 3.06161699786838301793e-17; // 3C81A626, 33145C07\n\n// tan(x + y), or -1/tan(x + y) when odd is 1.\nfn k_tan(x0: f64, y0: f64, odd: i32) -> f64 {\n    let mut x = x0;\n    let mut y = y0;\n    let hx = hi_word(x);\n    // |x| >= 0.6744: tan(pi/4 - x) instead\n    let big = hx & 0x7fffffff >= 0x3FE59428;\n    if big {\n        if hx >> 31 != 0 {\n            x = -x;\n            y = -y;\n        }\n        x = PIO4 - x + (PIO4_LO - y);\n        y = 0.0;\n    }\n    let z = x * x;\n    let w = z * z;\n    let t = TAN_T;\n    let mut r = t[1] + w * (t[3] + w * (t[5] + w * (t[7] + w * (t[9] + w * t[11]))));\n    let v = z * (t[2] + w * (t[4] + w * (t[6] + w * (t[8] + w * (t[10] + w * t[12])))));\n    let s = z * x;\n    r = y + z * (s * (r + v) + y) + s * t[0];\n    let w1 = x + r;\n    if big {\n        let sg = 1.0 - 2.0 * odd as f64;\n        let v1 = sg - 2.0 * (x + (r - w1 * w1 / (w1 + sg)));\n        return if hx >> 31 != 0 { -v1 } else { v1 };\n    }\n    if odd == 0 {\n        return w1;\n    }\n    // -1/(x + r), accurately: w0 + v = r + x, a0 = -1/w to 20 bits\n    let w0 = with_lo_word(w1, 0);\n    let v2 = r - (w0 - x);\n    let a = -1.0 / w1;\n    let a0 = with_lo_word(a, 0);\n    a0 + a * (1.0 + a0 * w0 + a0 * v2)\n}\n\n// ---- Math: argument reduction (0.25.2.1) ----\n\n// x - n * pi/2 as y0 + y1 with |y0 + y1| <= pi/4 (fdlibm's\n// __ieee754_rem_pio2, musl's version): Cody-Waite with pi/2 in three\n// pieces of 33 bits (each product exact) for |x| < 2^20 * pi/2, else\n// Payne-Hanek (rem_pio2_large). Returns (n, y0, y1).\nconst TO_INT: f64 = 6755399441055744.0; // 1.5 / EPSILON\nconst INV_PIO2: f64 = 6.36619772367581382433e-01; // 0x3FE45F30, 0x6DC9C883\nconst PIO2_1: f64 = 1.57079632673412561417e+00; // 0x3FF921FB, 0x54400000\nconst PIO2_1T: f64 = 6.07710050650619224932e-11; // 0x3DD0B461, 0x1A626331\n");
    buf_str(out, c"const PIO2_2: f64 = 6.07710050630396597660e-11; // 0x3DD0B461, 0x1A600000\nconst PIO2_2T: f64 = 2.02226624879595063154e-21; // 0x3BA3198A, 0x2E037073\nconst PIO2_3: f64 = 2.02226624871116645580e-21; // 0x3BA3198A, 0x2E000000\nconst PIO2_3T: f64 = 8.47842766036889956997e-32; // 0x397B839A, 0x252049C1\n\nfn rem_pio2_medium(x: f64, ix: u32) -> (i32, f64, f64) {\n    // rint(x / (pi/2)), round to nearest\n    let f_n = x * INV_PIO2 + TO_INT - TO_INT;\n    let n = f_n as i32;\n    let mut r = x - f_n * PIO2_1;\n    // first round, good to 85 bits\n    let mut w = f_n * PIO2_1T;\n    let mut y0 = r - w;\n    let ex = (ix >> 20) as i32;\n    let mut ey = (hi_word(y0) >> 20) as i32 & 0x7ff;\n    if ex - ey > 16 {\n        // second round, good to 118 bits\n        let mut t = r;\n        w = f_n * PIO2_2;\n        r = t - w;\n        w = f_n * PIO2_2T - (t - r - w);\n        y0 = r - w;\n        ey = (hi_word(y0) >> 20) as i32 & 0x7ff;\n        if ex - ey > 49 {\n            // third round, good to 151 bits: every case\n            t = r;\n            w = f_n * PIO2_3;\n            r = t - w;\n            w = f_n * PIO2_3T - (t - r - w);\n            y0 = r - w;\n        }\n    }\n    let y1 = r - y0 - w;\n    (n, y0, y1)\n}\n\n// x - k * pi/2 for k = 1..4 and |x| near k * pi/2's interval (one\n// round, good to 85 bits).\nfn rem_pio2_k(x: f64, k: i32, neg: bool) -> (i32, f64, f64) {\n    let kf = k as f64;\n    if !neg {\n        let z = x - kf * PIO2_1;\n        let y0 = z - kf * PIO2_1T;\n        (k, y0, z - y0 - kf * PIO2_1T)\n    } else {\n        let z = x + kf * PIO2_1;\n        let y0 = z + kf * PIO2_1T;\n        (-k, y0, z - y0 + kf * PIO2_1T)\n    }\n}\n\nfn rem_pio2(x: f64) -> (i32, f64, f64) {\n    let neg = f64_to_bits(x) >> 63 != 0;\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x400f6a7a {\n        // |x| !<= 5pi/4\n        if ix & 0xfffff == 0x921fb {\n            // |x| != pi/2 or 2pi/2: cancellation, the medium case\n");
    buf_str(out, c"            return rem_pio2_medium(x, ix);\n        }\n        // |x| !<= 3pi/4: 1, else 2\n        return rem_pio2_k(x, if ix <= 0x4002d97c { 1 } else { 2 }, neg);\n    }\n    if ix <= 0x401c463b {\n        // |x| !<= 9pi/4\n        if ix <= 0x4015fdbc {\n            // |x| !<= 7pi/4\n            if ix == 0x4012d97c {\n                // |x| != 3pi/2\n                return rem_pio2_medium(x, ix);\n            }\n            return rem_pio2_k(x, 3, neg);\n        }\n        if ix == 0x401921fb {\n            // |x| != 4pi/2\n            return rem_pio2_medium(x, ix);\n        }\n        return rem_pio2_k(x, 4, neg);\n    }\n    if ix < 0x413921fb {\n        // |x| !< 2^20 * pi/2\n        return rem_pio2_medium(x, ix);\n    }\n    if ix >= 0x7ff00000 {\n        // inf or NaN\n        let y = x - x;\n        return (0, y, y);\n    }\n    // z = |x| scaled to [2^23, 2^24), cut into three 24-bit pieces\n    let mut u = f64_to_bits(x) & 0x000fffffffffffff;\n    u |= (0x3ff + 23) << 52;\n    let mut z = f64_from_bits(u);\n    let mut tx: [f64; 3] = [0.0; 3];\n    tx[0] = (z as i32) as f64;\n    z = (z - tx[0]) * 16777216.0;\n    tx[1] = (z as i32) as f64;\n    z = (z - tx[1]) * 16777216.0;\n    tx[2] = z;\n    // (the zero pieces at the end left out; the first is not zero)\n    let mut nx: i64 = 3;\n    while nx > 1 && tx[(nx - 1) as usize] == 0.0 {\n        nx -= 1;\n    }\n    let (n, y0, y1) = rem_pio2_large(tx, nx, (ix >> 20) as i32 - (0x3ff + 23));\n    if neg { (-n, -y0, -y1) } else { (n, y0, y1) }\n}\n\n// 2/pi's bits, 24 to an entry (fdlibm's ipio2, enough for every f64).\nstatic IPIO2: [i32; 66] = [\n    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62, 0x95993C, 0x439041, 0xFE5163,\n    0xABDEBB, 0xC561B7, 0x246E3A, 0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,\n    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41, 0x3991D6, 0x398353, 0x39F49C,\n");
    buf_str(out, c"    0x845F8B, 0xBDF928, 0x3B1FF8, 0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,\n    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5, 0xF17B3D, 0x0739F7, 0x8A5292,\n    0xEA6BFB, 0x5FB11F, 0x8D5D08, 0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,\n    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880, 0x4D7327, 0x310606, 0x1556CA,\n    0x73A8C9, 0x60E27B, 0xC08C6B,\n];\n\n// pi/2 in pieces of 24 bits.\nstatic PIO2_PIECES: [f64; 8] = [\n    1.57079625129699707031e+00, // 0x3FF921FB, 0x40000000\n    7.54978941586159635335e-08, // 0x3E74442D, 0x00000000\n    5.39030252995776476554e-15, // 0x3CF84698, 0x80000000\n    3.28200341580791294123e-22, // 0x3B78CC51, 0x60000000\n    1.27065575308067607349e-29, // 0x39F01B83, 0x80000000\n    1.22933308981111328932e-36, // 0x387A2520, 0x40000000\n    2.73370053816464559624e-44, // 0x36E38222, 0x80000000\n    2.16741683877804819444e-51, // 0x3569F31D, 0x00000000\n];\n\n// fdlibm's __kernel_rem_pio2 for f64 (prec 1: the result as y0 + y1):\n// x = (tx[0] + tx[1] 2^-24 + tx[2] 2^-48) * 2^e0, the product with 2/pi's\n// bits from where they matter, in 24-bit pieces, the integer part mod 8\n// and the fraction times pi/2. Returns (n mod 8, y0, y1).\nfn rem_pio2_large(tx: [f64; 3], nx: i64, e0: i32) -> (i32, f64, f64) {\n    let two24 = 16777216.0;\n    let twon24 = 5.9604644775390625e-08;\n    let ipio2 = IPIO2;\n    let pio2 = PIO2_PIECES;\n    // jk + 1 terms of the product (prec 1: 4)\n    let jk: i64 = 4;\n    let jp: i64 = 4;\n    let jx = nx - 1;\n    let mut jv = ((e0 - 3) / 24) as i64;\n    if jv < 0 {\n        jv = 0;\n    }\n    let mut q0: i32 = e0 - 24 * (jv as i32 + 1);\n    let mut f: [f64; 20] = [0.0; 20];\n    let mut fq: [f64; 20] = [0.0; 20];\n    let mut q: [f64; 20] = [0.0; 20];\n    let mut iq: [i32; 20] = [0; 20];\n    // f[0..=jx + jk]: ipio2[jv - jx..]\n    let mut j = jv - jx;\n    for i in 0..jx + jk + 1 {\n");
    buf_str(out, c"        f[i as usize] = if j < 0 { 0.0 } else { ipio2[j as usize] as f64 };\n        j += 1;\n    }\n    // q[0..=jk]\n    for i in 0..jk + 1 {\n        let mut fw = 0.0;\n        for k in 0..jx + 1 {\n            fw += tx[k as usize] * f[(jx + i - k) as usize];\n        }\n        q[i as usize] = fw;\n    }\n    let mut jz = jk;\n    let mut z = 0.0;\n    let mut n: i32 = 0;\n    let mut ih: i32 = 0;\n    loop {\n        // q[] into 24-bit pieces iq[], lowest first\n        z = q[jz as usize];\n        let mut i: i64 = 0;\n        let mut k = jz;\n        while k > 0 {\n            let fw = ((twon24 * z) as i32) as f64;\n            iq[i as usize] = (z - two24 * fw) as i32;\n            z = q[(k - 1) as usize] + fw;\n            i += 1;\n            k -= 1;\n        }\n        // n: the integer part mod 8\n        z = scalbn(z, q0);\n        z -= 8.0 * floor64(z * 0.125);\n        n = z as i32;\n        z -= n as f64;\n        ih = 0;\n        if q0 > 0 {\n            // iq[jz - 1] holds n's last bits\n            let b = iq[(jz - 1) as usize] >> (24 - q0);\n            n += b;\n            iq[(jz - 1) as usize] -= b << (24 - q0);\n            ih = iq[(jz - 1) as usize] >> (23 - q0);\n        } else if q0 == 0 {\n            ih = iq[(jz - 1) as usize] >> 23;\n        } else if z >= 0.5 {\n            ih = 2;\n        }\n        if ih > 0 {\n            // the fraction > 0.5: 1 - it, n + 1\n            n += 1;\n            let mut carry: i32 = 0;\n            for m in 0..jz {\n                let v = iq[m as usize];\n                if carry == 0 {\n                    if v != 0 {\n                        carry = 1;\n                        iq[m as usize] = 0x1000000 - v;\n                    }\n                } else {\n                    iq[m as usize] = 0xffffff - v;\n                }\n            }\n            if q0 == 1 {\n                iq[(jz - 1) as usize] &= 0x7fffff;\n            } else if q0 == 2 {\n                iq[(jz - 1) as usize] &= 0x3fffff;\n");
    buf_str(out, c"            }\n            if ih == 2 {\n                z = 1.0 - z;\n                if carry != 0 {\n                    z -= scalbn(1.0, q0);\n                }\n            }\n        }\n        // all zero: more of 2/pi's bits needed\n        if z == 0.0 {\n            let mut all: i32 = 0;\n            let mut m = jz - 1;\n            while m >= jk {\n                all |= iq[m as usize];\n                m -= 1;\n            }\n            if all == 0 {\n                let mut more: i64 = 1;\n                while iq[(jk - more) as usize] == 0 {\n                    more += 1;\n                }\n                for ii in jz + 1..jz + more + 1 {\n                    f[(jx + ii) as usize] = ipio2[(jv + ii) as usize] as f64;\n                    let mut fw = 0.0;\n                    for kk in 0..jx + 1 {\n                        fw += tx[kk as usize] * f[(jx + ii - kk) as usize];\n                    }\n                    q[ii as usize] = fw;\n                }\n                jz += more;\n                continue;\n            }\n        }\n        break;\n    }\n    // the zero pieces at the end left out\n    if z == 0.0 {\n        jz -= 1;\n        q0 -= 24;\n        while iq[jz as usize] == 0 {\n            jz -= 1;\n            q0 -= 24;\n        }\n    } else {\n        // z cut into 24-bit pieces if needed\n        z = scalbn(z, -q0);\n        if z >= two24 {\n            let fw = ((twon24 * z) as i32) as f64;\n            iq[jz as usize] = (z - two24 * fw) as i32;\n            jz += 1;\n            q0 += 24;\n            iq[jz as usize] = fw as i32;\n        } else {\n            iq[jz as usize] = z as i32;\n        }\n    }\n    // the pieces as f64s\n    let mut fw = scalbn(1.0, q0);\n    let mut i = jz;\n    while i >= 0 {\n        q[i as usize] = fw * (iq[i as usize] as f64);\n        fw *= twon24;\n        i -= 1;\n    }\n    // fq = pio2[0..=jp] * q[jz..=0]\n    i = jz;\n    while i >= 0 {\n        let mut s = 0.0;\n");
    buf_str(out, c"        let mut k: i64 = 0;\n        while k <= jp && k <= jz - i {\n            s += pio2[k as usize] * q[(i + k) as usize];\n            k += 1;\n        }\n        fq[(jz - i) as usize] = s;\n        i -= 1;\n    }\n    // fq summed into y0 + y1\n    let mut s = 0.0;\n    i = jz;\n    while i >= 0 {\n        s += fq[i as usize];\n        i -= 1;\n    }\n    let y0 = if ih == 0 { s } else { -s };\n    s = fq[0] - s;\n    for m in 1..jz + 1 {\n        s += fq[m as usize];\n    }\n    let y1 = if ih == 0 { s } else { -s };\n    (n & 7, y0, y1)\n}\n\n// ---- Math: sin, cos, tan (0.25.2.1) ----\n\n// fdlibm's s_sin, s_cos, s_tan, musl's sincos: the kernels on the\n// argument reduced by rem_pio2, by its quadrant.\nfn sin64(x: f64) -> f64 {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        // |x| !< pi/4\n        if ix < 0x3e500000 {\n            // |x| < 2^-26: sin(x) is x\n            return x;\n        }\n        return k_sin(x, 0.0, 0);\n    }\n    if ix >= 0x7ff00000 {\n        // inf or NaN\n        return x - x;\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    match n & 3 {\n        0 => k_sin(y0, y1, 1),\n        1 => k_cos(y0, y1),\n        2 => -k_sin(y0, y1, 1),\n        _ => -k_cos(y0, y1),\n    }\n}\n\nfn cos64(x: f64) -> f64 {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        if ix < 0x3e46a09e {\n            // |x| < 2^-27 * sqrt(2): cos(x) is 1\n            return 1.0;\n        }\n        return k_cos(x, 0.0);\n    }\n    if ix >= 0x7ff00000 {\n        return x - x;\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    match n & 3 {\n        0 => k_cos(y0, y1),\n        1 => -k_sin(y0, y1, 1),\n        2 => -k_cos(y0, y1),\n        _ => k_sin(y0, y1, 1),\n    }\n}\n\nfn tan64(x: f64) -> f64 {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        if ix < 0x3e400000 {\n            // |x| < 2^-27\n            return x;\n        }\n        return k_tan(x, 0.0, 0);\n    }\n");
    buf_str(out, c"    if ix >= 0x7ff00000 {\n        return x - x;\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    k_tan(y0, y1, n & 1)\n}\n\nfn sin_cos64(x: f64) -> (f64, f64) {\n    let ix = hi_word(x) & 0x7fffffff;\n    if ix <= 0x3fe921fb {\n        if ix < 0x3e46a09e {\n            return (x, 1.0);\n        }\n        return (k_sin(x, 0.0, 0), k_cos(x, 0.0));\n    }\n    if ix >= 0x7ff00000 {\n        let y = x - x;\n        return (y, y);\n    }\n    let (n, y0, y1) = rem_pio2(x);\n    let s = k_sin(y0, y1, 1);\n    let c = k_cos(y0, y1);\n    match n & 3 {\n        0 => (s, c),\n        1 => (c, -s),\n        2 => (-s, -c),\n        _ => (-c, s),\n    }\n}\n\n// ---- Math: inverse trigonometric functions (0.25.2.1) ----\n\n// fdlibm's e_asin, e_acos: a rational approximation R(x^2) of\n// (asin(x) - x) / x^3 on [0, 0.5], and asin(x) = pi/2 - 2 asin(sqrt((1 -\n// x) / 2)) above.\nconst PIO2_HI: f64 = 1.57079632679489655800e+00; // 0x3FF921FB, 0x54442D18\nconst PIO2_LO: f64 = 6.12323399573676603587e-17; // 0x3C91A626, 0x33145C07\nconst P_S0: f64 = 1.66666666666666657415e-01; // 0x3FC55555, 0x55555555\nconst P_S1: f64 = -3.25565818622400915405e-01; // 0xBFD4D612, 0x03EB6F7D\nconst P_S2: f64 = 2.01212532134862925881e-01; // 0x3FC9C155, 0x0E884455\nconst P_S3: f64 = -4.00555345006794114027e-02; // 0xBFA48228, 0xB5688F3B\nconst P_S4: f64 = 7.91534994289814532176e-04; // 0x3F49EFE0, 0x7501B288\nconst P_S5: f64 = 3.47933107596021167570e-05; // 0x3F023DE1, 0x0DFDF709\nconst Q_S1: f64 = -2.40339491173441421878e+00; // 0xC0033A27, 0x1C8A2D4B\nconst Q_S2: f64 = 2.02094576023350569471e+00; // 0x40002AE5, 0x9C598AC8\nconst Q_S3: f64 = -6.88283971605453293030e-01; // 0xBFE6066C, 0x1B8D0159\nconst Q_S4: f64 = 7.70381505559019352791e-02; // 0x3FB3B8C5, 0xB12E9282\n\nfn asin_r(z: f64) -> f64 {\n    let p = z * (P_S0 + z * (P_S1 + z * (P_S2 + z * (P_S3 + z * (P_S4 + z * P_S5)))));\n    let q = 1.0 + z * (Q_S1 + z * (Q_S2 + z * (Q_S3 + z * Q_S4)));\n    p / q\n}\n\nfn asin64(x: f64) -> f64 {\n");
    buf_str(out, c"    let hx = hi_word(x);\n    let ix = hx & 0x7fffffff;\n    if ix >= 0x3ff00000 {\n        // |x| >= 1 or NaN\n        if ix - 0x3ff00000 | lo_word(x) == 0 {\n            // asin(+-1) = +-pi/2\n            return x * PIO2_HI + pow2(-120);\n        }\n        if x != x {\n            return x;\n        }\n        return f64::NAN;\n    }\n    if ix < 0x3fe00000 {\n        // |x| < 0.5\n        if ix < 0x3e500000 && ix >= 0x00100000 {\n            // |x| < 2^-26\n            return x;\n        }\n        return x + x * asin_r(x * x);\n    }\n    // 1 > |x| >= 0.5\n    let z = (1.0 - x.abs()) * 0.5;\n    let s = sqrt64(z);\n    let r = asin_r(z);\n    let mut y = 0.0;\n    if ix >= 0x3fef3333 {\n        // |x| > 0.975\n        y = PIO2_HI - (2.0 * (s + s * r) - PIO2_LO);\n    } else {\n        // f + c = sqrt(z)\n        let f = with_lo_word(s, 0);\n        let c = (z - f * f) / (s + f);\n        y = 0.5 * PIO2_HI - (2.0 * s * r - (PIO2_LO - 2.0 * c) - (0.5 * PIO2_HI - 2.0 * f));\n    }\n    if hx >> 31 != 0 { -y } else { y }\n}\n\nfn acos64(x: f64) -> f64 {\n    let hx = hi_word(x);\n    let ix = hx & 0x7fffffff;\n    if ix >= 0x3ff00000 {\n        if ix - 0x3ff00000 | lo_word(x) == 0 {\n            // acos(1) = 0, acos(-1) = pi\n            if hx >> 31 != 0 {\n                return 2.0 * PIO2_HI + pow2(-120);\n            }\n            return 0.0;\n        }\n        if x != x {\n            return x;\n        }\n        return f64::NAN;\n    }\n    if ix < 0x3fe00000 {\n        // |x| < 0.5\n        if ix <= 0x3c600000 {\n            // |x| < 2^-57\n            return PIO2_HI + pow2(-120);\n        }\n        return PIO2_HI - (x - (PIO2_LO - x * asin_r(x * x)));\n    }\n    if hx >> 31 != 0 {\n        // x < -0.5\n        let z = (1.0 + x) * 0.5;\n        let s = sqrt64(z);\n        let w = asin_r(z) * s - PIO2_LO;\n        return 2.0 * (PIO2_HI - (s + w));\n    }\n    // x > 0.5\n    let z = (1.0 - x) * 0.5;\n    let s = sqrt64(z);\n");
    buf_str(out, c"    let df = with_lo_word(s, 0);\n    let c = (z - df * df) / (s + df);\n    let w = asin_r(z) * s + c;\n    2.0 * (df + w)\n}\n\n// fdlibm's s_atan: x reduced to [0, 7/16] around atan(0.5), atan(1),\n// atan(1.5) or atan(inf), then a polynomial of 11 terms.\nstatic ATAN_HI: [f64; 4] = [\n    4.63647609000806093515e-01, // atan(0.5)hi 0x3FDDAC67, 0x0561BB4F\n    7.85398163397448278999e-01, // atan(1.0)hi 0x3FE921FB, 0x54442D18\n    9.82793723247329054082e-01, // atan(1.5)hi 0x3FEF730B, 0xD281F69B\n    1.57079632679489655800e+00, // atan(inf)hi 0x3FF921FB, 0x54442D18\n];\nstatic ATAN_LO: [f64; 4] = [\n    2.26987774529616870924e-17, // atan(0.5)lo 0x3C7A2B7F, 0x222F65E2\n    3.06161699786838301793e-17, // atan(1.0)lo 0x3C81A626, 0x33145C07\n    1.39033110312309984516e-17, // atan(1.5)lo 0x3C700788, 0x7AF0CBBD\n    6.12323399573676603587e-17, // atan(inf)lo 0x3C91A626, 0x33145C07\n];\nstatic ATAN_T: [f64; 11] = [\n    3.33333333333329318027e-01, // 0x3FD55555, 0x5555550D\n    -1.99999999998764832476e-01, // 0xBFC99999, 0x9998EBC4\n    1.42857142725034663711e-01, // 0x3FC24924, 0x920083FF\n    -1.11111104054623557880e-01, // 0xBFBC71C6, 0xFE231671\n    9.09088713343650656196e-02, // 0x3FB745CD, 0xC54C206E\n    -7.69187620504482999495e-02, // 0xBFB3B0F2, 0xAF749A6D\n    6.66107313738753120669e-02, // 0x3FB10D66, 0xA0D03D51\n    -5.83357013379057348645e-02, // 0xBFADDE2D, 0x52DEFD9A\n    4.97687799461593236017e-02, // 0x3FA97B4B, 0x24760DEB\n    -3.65315727442169155270e-02, // 0xBFA2B444, 0x2C6A6C2F\n    1.62858201153657823623e-02, // 0x3F90AD3A, 0xE322DA11\n];\n\nfn atan64(x0: f64) -> f64 {\n    let mut x = x0;\n    let hx = hi_word(x);\n    let neg = hx >> 31 != 0;\n    let ix = hx & 0x7fffffff;\n    if ix >= 0x44100000 {\n        // |x| >= 2^66, or NaN\n        if x != x {\n            return x;\n        }\n        let z = ATAN_HI[3] + pow2(-120);\n        return if neg { -z } else { z };\n    }\n    let mut id: i64 = -1;\n    if ix < 0x3fdc0000 {\n");
    buf_str(out, c"        // |x| < 0.4375\n        if ix < 0x3e400000 {\n            // |x| < 2^-27\n            return x;\n        }\n    } else {\n        x = x.abs();\n        if ix < 0x3ff30000 {\n            // |x| < 1.1875\n            if ix < 0x3fe60000 {\n                // 7/16 <= |x| < 11/16\n                id = 0;\n                x = (2.0 * x - 1.0) / (2.0 + x);\n            } else {\n                // 11/16 <= |x| < 19/16\n                id = 1;\n                x = (x - 1.0) / (x + 1.0);\n            }\n        } else if ix < 0x40038000 {\n            // |x| < 2.4375\n            id = 2;\n            x = (x - 1.5) / (1.0 + 1.5 * x);\n        } else {\n            // 2.4375 <= |x| < 2^66\n            id = 3;\n            x = -1.0 / x;\n        }\n    }\n    let at = ATAN_T;\n    let z = x * x;\n    let w = z * z;\n    // the odd and the even terms\n    let s1 = z * (at[0] + w * (at[2] + w * (at[4] + w * (at[6] + w * (at[8] + w * at[10])))));\n    let s2 = w * (at[1] + w * (at[3] + w * (at[5] + w * (at[7] + w * at[9]))));\n    if id < 0 {\n        return x - x * (s1 + s2);\n    }\n    let r = ATAN_HI[id as usize] - (x * (s1 + s2) - ATAN_LO[id as usize] - x);\n    if neg { -r } else { r }\n}\n\nconst PI_LO: f64 = 1.2246467991473531772e-16; // 0x3CA1A626, 0x33145C07\n\n// fdlibm's e_atan2: atan(|y/x|), placed in its quadrant; the special\n// values of C99's Annex F.\nfn atan2_64(y: f64, x: f64) -> f64 {\n    let pi = f64::consts::PI;\n    if x != x || y != y {\n        return x + y;\n    }\n    let mut ix = hi_word(x);\n    let lx = lo_word(x);\n    let mut iy = hi_word(y);\n    let ly = lo_word(y);\n    if ix.wrapping_sub(0x3ff00000) | lx == 0 {\n        // x = 1.0\n        return atan64(y);\n    }\n    // 2 * sign(x) + sign(y)\n    let m = iy >> 31 & 1 | ix >> 30 & 2;\n    ix &= 0x7fffffff;\n    iy &= 0x7fffffff;\n    if iy | ly == 0 {\n        // y = +-0\n        return if m <= 1 { y } else if m == 2 { pi } else { -pi };\n    }\n    if ix | lx == 0 {\n");
    buf_str(out, c"        // x = +-0\n        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 };\n    }\n    if ix == 0x7ff00000 {\n        // x = +-inf\n        if iy == 0x7ff00000 {\n            return if m == 0 {\n                pi / 4.0\n            } else if m == 1 {\n                -pi / 4.0\n            } else if m == 2 {\n                3.0 * pi / 4.0\n            } else {\n                -3.0 * pi / 4.0\n            };\n        }\n        return if m == 0 { 0.0 } else if m == 1 { -0.0 } else if m == 2 { pi } else { -pi };\n    }\n    if ix + (64 << 20) < iy || iy == 0x7ff00000 {\n        // |y/x| > 2^64\n        return if m & 1 != 0 { -pi / 2.0 } else { pi / 2.0 };\n    }\n    // atan(|y/x|) without a spurious underflow\n    let z = if m & 2 != 0 && iy + (64 << 20) < ix { 0.0 } else { atan64((y / x).abs()) };\n    if m == 0 {\n        z\n    } else if m == 1 {\n        -z\n    } else if m == 2 {\n        pi - (z - PI_LO)\n    } else {\n        z - PI_LO - pi\n    }\n}\n\n// ---- Math: exp and log (0.25.2.1) ----\n\n// fdlibm's e_exp: x = k ln2 + r, |r| <= ln2 / 2 (ln2 in two pieces, k *\n// ln2hi exact), e^r from a Remez polynomial of r^2, times 2^k.\nconst LN2_HI: f64 = 6.93147180369123816490e-01; // 0x3fe62e42, 0xfee00000\nconst LN2_LO: f64 = 1.90821492927058770002e-10; // 0x3dea39ef, 0x35793c76\nconst INV_LN2: f64 = 1.44269504088896338700e+00; // 0x3ff71547, 0x652b82fe\nconst EXP_P1: f64 = 1.66666666666666019037e-01; // 0x3FC55555, 0x5555553E\nconst EXP_P2: f64 = -2.77777777770155933842e-03; // 0xBF66C16C, 0x16BEBD93\nconst EXP_P3: f64 = 6.61375632143793436117e-05; // 0x3F11566A, 0xAF25DE2C\nconst EXP_P4: f64 = -1.65339022054652515390e-06; // 0xBEBBBD41, 0xC5D26BF1\nconst EXP_P5: f64 = 4.13813679705723846039e-08; // 0x3E663769, 0x72BEA4D0\n\nfn exp64(x0: f64) -> f64 {\n    let mut x = x0;\n    let mut hx = hi_word(x);\n    let sign = (hx >> 31) as i32;\n    hx &= 0x7fffffff;\n    if hx >= 0x4086232b {\n        // |x| >= 708.39, or NaN\n        if x != x {\n");
    buf_str(out, c"            return x;\n        }\n        if x > 709.782712893383973096 {\n            // overflow\n            return x * pow2(1023);\n        }\n        if x < -745.13321910194110842 {\n            // underflow\n            return 0.0;\n        }\n    }\n    let mut k: i32 = 0;\n    let mut hi = 0.0;\n    let mut lo = 0.0;\n    if hx > 0x3fd62e42 {\n        // |x| > ln2 / 2\n        if hx >= 0x3ff0a2b2 {\n            // |x| >= 1.5 ln2\n            k = (INV_LN2 * x + if sign != 0 { -0.5 } else { 0.5 }) as i32;\n        } else {\n            k = 1 - sign - sign;\n        }\n        hi = x - k as f64 * LN2_HI;\n        lo = k as f64 * LN2_LO;\n        x = hi - lo;\n    } else if hx > 0x3e300000 {\n        // |x| > 2^-28\n        hi = x;\n    } else {\n        return 1.0 + x;\n    }\n    let xx = x * x;\n    let c = x - xx * (EXP_P1 + xx * (EXP_P2 + xx * (EXP_P3 + xx * (EXP_P4 + xx * EXP_P5))));\n    let y = 1.0 + (x * c / (2.0 - c) - lo + hi);\n    if k == 0 { y } else { scalbn(y, k) }\n}\n\n// 2^x = 2^k * e^(r ln2), k the nearest integer, r = x - k (exact).\nfn exp2_64(x: f64) -> f64 {\n    if x != x {\n        return x;\n    }\n    if x >= 1024.0 {\n        return f64::INFINITY;\n    }\n    if x < -1080.0 {\n        return 0.0;\n    }\n    let k = round64(x);\n    let r = x - k;\n    if r == 0.0 {\n        return scalbn(1.0, k as i32);\n    }\n    scalbn(exp64(r * f64::consts::LN_2), k as i32)\n}\n\n// fdlibm's e_log: x = 2^k (1 + f), sqrt(2)/2 < 1 + f < sqrt(2); log(1 +\n// f) = f - f^2/2 + s(f^2/2 + R(s^2)), s = f / (2 + f), R a Remez\n// polynomial; plus k ln2 in two pieces.\nconst LG1: f64 = 6.666666666666735130e-01; // 3FE55555 55555593\nconst LG2: f64 = 3.999999999940941908e-01; // 3FD99999 9997FA04\nconst LG3: f64 = 2.857142874366239149e-01; // 3FD24924 94229359\nconst LG4: f64 = 2.222219843214978396e-01; // 3FCC71C5 1D8E78AF\nconst LG5: f64 = 1.818357216161805012e-01; // 3FC74664 96CB03DE\nconst LG6: f64 = 1.531383769920937332e-01; // 3FC39A09 D078C69F\n");
    buf_str(out, c"const LG7: f64 = 1.479819860511658591e-01; // 3FC2F112 DF3E5244\n\n// The reduction of log, log2 and log10: (k, f, hfsq, s, R), or\n// (special, the result) for 0, negatives, inf, NaN and 1. x = 2^k (1 +\n// f).\nfn log_reduce(x0: f64) -> (bool, f64, i32, f64, f64, f64) {\n    let mut x = x0;\n    let mut ui = f64_to_bits(x);\n    let mut hx = (ui >> 32) as u32;\n    let mut k: i32 = 0;\n    if hx < 0x00100000 || hx >> 31 != 0 {\n        if ui << 1 == 0 {\n            // log(+-0) = -inf\n            return (true, f64::NEG_INFINITY, 0, 0.0, 0.0, 0.0);\n        }\n        if hx >> 31 != 0 {\n            // log(-x) = NaN\n            return (true, if x != x { x } else { f64::NAN }, 0, 0.0, 0.0, 0.0);\n        }\n        // a subnormal: scaled up\n        k -= 54;\n        x *= pow2(54);\n        ui = f64_to_bits(x);\n        hx = (ui >> 32) as u32;\n    } else if hx >= 0x7ff00000 {\n        return (true, x, 0, 0.0, 0.0, 0.0);\n    } else if hx == 0x3ff00000 && ui << 32 == 0 {\n        return (true, 0.0, 0, 0.0, 0.0, 0.0);\n    }\n    // x into [sqrt(2)/2, sqrt(2)]\n    hx += 0x3ff00000 - 0x3fe6a09e;\n    k += (hx >> 20) as i32 - 0x3ff;\n    hx = (hx & 0x000fffff) + 0x3fe6a09e;\n    ui = (hx as u64) << 32 | ui & 0xffffffff;\n    x = f64_from_bits(ui);\n    let f = x - 1.0;\n    let hfsq = 0.5 * f * f;\n    let s = f / (2.0 + f);\n    let z = s * s;\n    let w = z * z;\n    let t1 = w * (LG2 + w * (LG4 + w * LG6));\n    let t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)));\n    (false, f, k, hfsq, s, t2 + t1)\n}\n\nfn ln64(x: f64) -> f64 {\n    let (special, f, k, hfsq, s, r) = log_reduce(x);\n    if special {\n        return f;\n    }\n    let dk = k as f64;\n    s * (hfsq + r) + dk * LN2_LO - hfsq + f + dk * LN2_HI\n}\n\n// e_log2 (FreeBSD): log(1 + f) as hi + lo, hi with 32 bits, times\n// 1/ln2 in two pieces, plus k.\nconst IVLN2HI: f64 = 1.44269504072144627571e+00; // 0x3ff71547, 0x65200000\nconst IVLN2LO: f64 = 1.67517131648865118353e-10; // 0x3de705fc, 0x2eefa200\n");
    buf_str(out, c"\nfn log2_64(x: f64) -> f64 {\n    let (special, f, k, hfsq, s, r) = log_reduce(x);\n    if special {\n        return f;\n    }\n    let hi = f64_from_bits(f64_to_bits(f - hfsq) & 0xffffffff00000000);\n    let lo = f - hi - hfsq + s * (hfsq + r);\n    let mut val_hi = hi * IVLN2HI;\n    let mut val_lo = (lo + hi) * IVLN2LO + lo * IVLN2HI;\n    let y = k as f64;\n    let w = y + val_hi;\n    val_lo += y - w + val_hi;\n    val_hi = w;\n    val_lo + val_hi\n}\n\n// e_log10 (FreeBSD): as log2, times 1/ln10, plus k log10(2) in two\n// pieces.\nconst IVLN10HI: f64 = 4.34294481878168880939e-01; // 0x3fdbcb7b, 0x15200000\nconst IVLN10LO: f64 = 2.50829467116452752298e-11; // 0x3dbb9438, 0xca9aadd5\nconst LOG10_2HI: f64 = 3.01029995663611771306e-01; // 0x3FD34413, 0x509F6000\nconst LOG10_2LO: f64 = 3.69423907715893078616e-13; // 0x3D59FEF3, 0x11F12B36\n\nfn log10_64(x: f64) -> f64 {\n    let (special, f, k, hfsq, s, r) = log_reduce(x);\n    if special {\n        return f;\n    }\n    let hi = f64_from_bits(f64_to_bits(f - hfsq) & 0xffffffff00000000);\n    let lo = f - hi - hfsq + s * (hfsq + r);\n    let mut val_hi = hi * IVLN10HI;\n    let dk = k as f64;\n    let y = dk * LOG10_2HI;\n    let mut val_lo = dk * LOG10_2LO + (lo + hi) * IVLN10LO + lo * IVLN10HI;\n    let w = y + val_hi;\n    val_lo += y - w + val_hi;\n    val_hi = w;\n    val_lo + val_hi\n}\n\n// ---- Math: pow (0.25.2.1) ----\n\n// fdlibm's e_pow: log2(x) as t1 + t2 to about 64 bits, times y as y1 +\n// y2, then 2^(the product) as 2^n * e^(r ln2); the special values of\n// C99's Annex F (pow(x, 0) = 1 even for NaN, pow(1, y) = 1, (-x)^odd).\nconst POW_BP: [f64; 2] = [1.0, 1.5];\nconst POW_DP_H: [f64; 2] = [0.0, 5.84962487220764160156e-01]; // 0x3fe2b803_40000000\nconst POW_DP_L: [f64; 2] = [0.0, 1.35003920212974897128e-08]; // 0x3E4CFDEB, 0x43CFD006\nconst TWO53: f64 = 9007199254740992.0;\nconst HUGE: f64 = 1.0e300;\nconst TINY: f64 = 1.0e-300;\n");
    buf_str(out, c"const POW_L1: f64 = 5.99999999999994648725e-01; // 0x3fe33333_33333303\nconst POW_L2: f64 = 4.28571428578550184252e-01; // 0x3fdb6db6_db6fabff\nconst POW_L3: f64 = 3.33333329818377432918e-01; // 0x3fd55555_518f264d\nconst POW_L4: f64 = 2.72728123808534006489e-01; // 0x3fd17460_a91d4101\nconst POW_L5: f64 = 2.30660745775561754067e-01; // 0x3fcd864a_93c9db65\nconst POW_L6: f64 = 2.06975017800338417784e-01; // 0x3fca7e28_4a454eef\nconst POW_LG2: f64 = 6.93147180559945286227e-01; // 0x3fe62e42_fefa39ef\nconst POW_LG2_H: f64 = 6.93147182464599609375e-01; // 0x3fe62e43_00000000\nconst POW_LG2_L: f64 = -1.90465429995776804525e-09; // 0xbe205c61_0ca86c39\nconst POW_OVT: f64 = 8.0085662595372944372e-017; // -(1024 - log2(ovfl + .5ulp))\nconst POW_CP: f64 = 9.61796693925975554329e-01; // 0x3feec709_dc3a03fd = 2/(3ln2)\nconst POW_CP_H: f64 = 9.61796700954437255859e-01; // 0x3feec709_e0000000 = (float)cp\nconst POW_CP_L: f64 = -7.02846165095275826516e-09; // 0xbe3e2fe0_145b01f5 = tail of cp_h\nconst POW_IVLN2: f64 = 1.44269504088896338700e+00; // 0x3ff71547_652b82fe = 1/ln2\nconst POW_IVLN2_H: f64 = 1.44269502162933349609e+00; // 0x3ff71547_60000000 = 24b 1/ln2\nconst POW_IVLN2_L: f64 = 1.92596299112661746887e-08; // 0x3e54ae0b_f85ddf44 = 1/ln2 tail\n\nfn pow64(x: f64, y: f64) -> f64 {\n    let hx = hi_word(x) as i32;\n    let lx = lo_word(x);\n    let hy = hi_word(y) as i32;\n    let ly = lo_word(y);\n    let mut ix = hx & 0x7fffffff;\n    let iy = hy & 0x7fffffff;\n    // x^0 = 1, even for NaN\n    if iy as u32 | ly == 0 {\n        return 1.0;\n    }\n    // 1^y = 1, even for NaN\n    if hx == 0x3ff00000 && lx == 0 {\n        return 1.0;\n    }\n    // NaN if either is\n    if ix > 0x7ff00000 || ix == 0x7ff00000 && lx != 0 || iy > 0x7ff00000\n        || iy == 0x7ff00000 && ly != 0 {\n        return x + y;\n    }\n    // for x < 0: 0 when y is not an integer, 1 when an odd one, 2 when\n    // an even one\n    let mut yisint: i32 = 0;\n    if hx < 0 {\n");
    buf_str(out, c"        if iy >= 0x43400000 {\n            yisint = 2;\n        } else if iy >= 0x3ff00000 {\n            let k = (iy >> 20) - 0x3ff;\n            if k > 20 {\n                let j = (ly >> (52 - k) as u32) as i32;\n                if j << (52 - k) == ly as i32 {\n                    yisint = 2 - (j & 1);\n                }\n            } else if ly == 0 {\n                let j = iy >> (20 - k);\n                if j << (20 - k) == iy {\n                    yisint = 2 - (j & 1);\n                }\n            }\n        }\n    }\n    if ly == 0 {\n        // y is +-inf, +-1, 2, 0.5\n        if iy == 0x7ff00000 {\n            return if ix - 0x3ff00000 | lx as i32 == 0 {\n                // (-1)^+-inf = 1\n                1.0\n            } else if ix >= 0x3ff00000 {\n                // (|x| > 1)^+-inf = inf, 0\n                if hy >= 0 { y } else { 0.0 }\n            } else if hy >= 0 {\n                // (|x| < 1)^+-inf = 0, inf\n                0.0\n            } else {\n                -y\n            };\n        }\n        if iy == 0x3ff00000 {\n            return if hy >= 0 { x } else { 1.0 / x };\n        }\n        if hy == 0x40000000 {\n            return x * x;\n        }\n        if hy == 0x3fe00000 && hx >= 0 {\n            // x^0.5 for x >= +0\n            return sqrt64(x);\n        }\n    }\n    let mut ax = x.abs();\n    if lx == 0 && (ix == 0x7ff00000 || ix == 0 || ix == 0x3ff00000) {\n        // x is +-0, +-inf, +-1\n        let mut z = ax;\n        if hy < 0 {\n            z = 1.0 / z;\n        }\n        if hx < 0 {\n            if ix - 0x3ff00000 | yisint == 0 {\n                // (-1)^non-integer\n                z = f64::NAN;\n            } else if yisint == 1 {\n                z = -z;\n            }\n        }\n        return z;\n    }\n    let mut sn = 1.0;\n    if hx < 0 {\n        if yisint == 0 {\n            // (x < 0)^non-integer\n            return f64::NAN;\n        }\n        if yisint == 1 {\n            sn = -1.0;\n        }\n");
    buf_str(out, c"    }\n    let mut t1 = 0.0;\n    let mut t2 = 0.0;\n    if iy > 0x41e00000 {\n        // |y| > 2^31\n        if iy > 0x43f00000 {\n            // |y| > 2^64: overflow or underflow\n            if ix <= 0x3fefffff {\n                return if hy < 0 { HUGE * HUGE } else { TINY * TINY };\n            }\n            if ix >= 0x3ff00000 {\n                return if hy > 0 { HUGE * HUGE } else { TINY * TINY };\n            }\n        }\n        // over/underflow when x is not near 1\n        if ix < 0x3fefffff {\n            return if hy < 0 { sn * HUGE * HUGE } else { sn * TINY * TINY };\n        }\n        if ix > 0x3ff00000 {\n            return if hy > 0 { sn * HUGE * HUGE } else { sn * TINY * TINY };\n        }\n        // |1 - x| <= 2^-20: log(x) by x - x^2/2 + x^3/3 - x^4/4\n        let t = ax - 1.0;\n        let w = t * t * (0.5 - t * (0.3333333333333333333333 - t * 0.25));\n        let u = POW_IVLN2_H * t;\n        let v = t * POW_IVLN2_L - w * POW_IVLN2;\n        t1 = with_lo_word(u + v, 0);\n        t2 = v - (t1 - u);\n    } else {\n        let mut n: i32 = 0;\n        if ix < 0x00100000 {\n            // a subnormal\n            ax *= TWO53;\n            n -= 53;\n            ix = hi_word(ax) as i32;\n        }\n        n += (ix >> 20) - 0x3ff;\n        let j = ix & 0x000fffff;\n        // the interval\n        ix = j | 0x3ff00000;\n        let mut k: i64 = 0;\n        if j <= 0x3988E {\n            // |x| < sqrt(3/2)\n            k = 0;\n        } else if j < 0xBB67A {\n            // |x| < sqrt(3)\n            k = 1;\n        } else {\n            k = 0;\n            n += 1;\n            ix -= 0x00100000;\n        }\n        ax = from_words(ix as u32, lo_word(ax));\n        // ss = s_h + s_l = (x - 1) / (x + 1) or (x - 1.5) / (x + 1.5)\n        let bp = POW_BP[k as usize];\n        let u = ax - bp;\n        let v = 1.0 / (ax + bp);\n        let ss = u * v;\n        let s_h = with_lo_word(ss, 0);\n        // t_h = ax + bp[k], high\n");
    buf_str(out, c"        let t_h = from_words((ix as u32 >> 1 | 0x20000000) + 0x00080000 + ((k as u32) << 18), 0);\n        let t_l = ax - (t_h - bp);\n        let s_l = v * (u - s_h * t_h - s_h * t_l);\n        // log(ax)\n        let s2 = ss * ss;\n        let mut r = s2 * s2 * (POW_L1 + s2 * (POW_L2 + s2 * (POW_L3 + s2 * (POW_L4 + s2 * (POW_L5\n            + s2 * POW_L6)))));\n        r += s_l * (s_h + ss);\n        let s2h = s_h * s_h;\n        let t_h2 = with_lo_word(3.0 + s2h + r, 0);\n        let t_l2 = r - (t_h2 - 3.0 - s2h);\n        // u + v = ss * (1 + ...)\n        let u2 = s_h * t_h2;\n        let v2 = s_l * t_h2 + t_l2 * ss;\n        // 2/(3 log2) * (ss + ...)\n        let p_h = with_lo_word(u2 + v2, 0);\n        let p_l = v2 - (p_h - u2);\n        let z_h = POW_CP_H * p_h;\n        let z_l = POW_CP_L * p_h + p_l * POW_CP + POW_DP_L[k as usize];\n        // log2(ax) = (ss + ..) * 2/(3 log2) = n + dp_h + z_h + z_l\n        let t = n as f64;\n        t1 = with_lo_word(z_h + z_l + POW_DP_H[k as usize] + t, 0);\n        t2 = z_l - (t1 - t - POW_DP_H[k as usize] - z_h);\n    }\n    // (y1 + y2) * (t1 + t2), y split\n    let y1 = with_lo_word(y, 0);\n    let p_l = (y - y1) * t1 + y * t2;\n    let mut p_h = y1 * t1;\n    let z = p_l + p_h;\n    let mut j = hi_word(z) as i32;\n    let i = lo_word(z) as i32;\n    if j >= 0x40900000 {\n        // z >= 1024\n        if j - 0x40900000 | i != 0 {\n            return sn * HUGE * HUGE;\n        }\n        if p_l + POW_OVT > z - p_h {\n            return sn * HUGE * HUGE;\n        }\n    } else if j & 0x7fffffff >= 0x4090cc00 {\n        // z <= -1075\n        if (j as u32 - 0xc090cc00) | i as u32 != 0 {\n            return sn * TINY * TINY;\n        }\n        if p_l <= z - p_h {\n            return sn * TINY * TINY;\n        }\n    }\n    // 2^(p_h + p_l)\n    let ia = j & 0x7fffffff;\n    let mut k = (ia >> 20) - 0x3ff;\n    let mut n: i32 = 0;\n    if ia > 0x3fe00000 {\n        // |z| > 0.5: n = [z + 0.5]\n");
    buf_str(out, c"        n = j + (0x00100000 >> (k + 1));\n        k = ((n & 0x7fffffff) >> 20) - 0x3ff;\n        let t = from_words((n & !(0x000fffff >> k)) as u32, 0);\n        n = (n & 0x000fffff | 0x00100000) >> (20 - k);\n        if j < 0 {\n            n = -n;\n        }\n        p_h -= t;\n    }\n    let t = with_lo_word(p_l + p_h, 0);\n    let u = t * POW_LG2_H;\n    let v = (p_l - (t - p_h)) * POW_LG2 + t * POW_LG2_L;\n    let mut zz = u + v;\n    let w = v - (zz - u);\n    let tt = zz * zz;\n    let tt1 = zz - tt * (EXP_P1 + tt * (EXP_P2 + tt * (EXP_P3 + tt * (EXP_P4 + tt * EXP_P5))));\n    let r = zz * tt1 / (tt1 - 2.0) - (w + zz * w);\n    zz = 1.0 - (r - zz);\n    j = hi_word(zz) as i32;\n    j += n << 20;\n    if j >> 20 <= 0 {\n        // a subnormal result\n        zz = scalbn(zz, n);\n    } else {\n        zz = from_words(j as u32, lo_word(zz));\n    }\n    sn * zz\n}\n\n// f64's inherent methods (Rust's): the bits, the classification, rounding,\n// min and max, and the functions above.\nimpl f64 {\n    // The IEEE 754 bits.\n    #[effects()]\n    pub fn to_bits(self) -> u64 { f64_to_bits(self) }\n    // The f64 with these IEEE 754 bits.\n    #[effects()]\n    pub fn from_bits(v: u64) -> f64 { f64_from_bits(v) }\n    // |self|.\n    #[effects()]\n    pub fn abs(self) -> f64 { f64_from_bits(f64_to_bits(self) & 0x7fffffffffffffff) }\n    // 1.0 for +0.0 and positive numbers, -1.0 for -0.0 and negative ones,\n    // NaN for NaN.\n    #[effects()]\n    pub fn signum(self) -> f64 { if self != self { self } else { copysign64(1.0, self) } }\n    // |self| with the sign of `sign`.\n    #[effects()]\n    pub fn copysign(self, sign: f64) -> f64 { copysign64(self, sign) }\n    #[effects()]\n    pub fn is_nan(self) -> bool { self != self }\n    // Neither infinite nor NaN.\n    #[effects()]\n    pub fn is_finite(self) -> bool { f64_to_bits(self) & 0x7fffffffffffffff < 0x7ff0000000000000 }\n    #[effects()]\n    pub fn is_infinite(self) -> bool {\n");
    buf_str(out, c"        f64_to_bits(self) & 0x7fffffffffffffff == 0x7ff0000000000000\n    }\n    // Neither zero, infinite, subnormal nor NaN.\n    #[effects()]\n    pub fn is_normal(self) -> bool {\n        let e = (f64_to_bits(self) >> 52) & 0x7ff;\n        e != 0 && e != 0x7ff\n    }\n    #[effects()]\n    pub fn is_subnormal(self) -> bool {\n        let b = f64_to_bits(self) & 0x7fffffffffffffff;\n        b != 0 && b < 0x0010000000000000\n    }\n    // The sign bit is clear (+0.0, +inf and positive NaNs too).\n    #[effects()]\n    pub fn is_sign_positive(self) -> bool { f64_to_bits(self) >> 63 == 0 }\n    #[effects()]\n    pub fn is_sign_negative(self) -> bool { f64_to_bits(self) >> 63 != 0 }\n    // The largest integer <= self.\n    #[effects()]\n    pub fn floor(self) -> f64 { floor64(self) }\n    // The smallest integer >= self.\n    #[effects()]\n    pub fn ceil(self) -> f64 { ceil64(self) }\n    // The nearest integer, half-way cases away from zero.\n    #[effects()]\n    pub fn round(self) -> f64 { round64(self) }\n    // The nearest integer, half-way cases to the even one.\n    #[effects()]\n    pub fn round_ties_even(self) -> f64 { round_even64(self) }\n    // The integer part: rounded toward zero.\n    #[effects()]\n    pub fn trunc(self) -> f64 { trunc64(self) }\n    // self - self.trunc().\n    #[effects()]\n    pub fn fract(self) -> f64 { self - trunc64(self) }\n    // The smaller; the other one when one is NaN.\n    #[effects()]\n    pub fn min(self, other: f64) -> f64 { min64(self, other) }\n    // The larger; the other one when one is NaN.\n    #[effects()]\n    pub fn max(self, other: f64) -> f64 { max64(self, other) }\n    // self restricted to min..=max (NaN stays NaN); panics when min > max\n    // or either is NaN, as Rust's.\n    #[effects(panic)]\n    pub fn clamp(self, min: f64, max: f64) -> f64 {\n        if !(min <= max) {\n            crate::panic::panic(\"min > max, or either was NaN\");\n        }\n        let mut r = self;\n        if r < min {\n");
    buf_str(out, c"            r = min;\n        }\n        if r > max {\n            r = max;\n        }\n        r\n    }\n    // 1 / self.\n    #[effects()]\n    pub fn recip(self) -> f64 { 1.0 / self }\n    // Degrees to radians.\n    #[effects()]\n    pub fn to_radians(self) -> f64 { self * (PI64 / 180.0) }\n    // Radians to degrees.\n    #[effects()]\n    pub fn to_degrees(self) -> f64 { self * (180.0 / PI64) }\n    // The square root, correctly rounded; NaN below -0.0.\n    #[effects(diverge)]\n    pub fn sqrt(self) -> f64 { sqrt64(self) }\n    // The cube root.\n    #[effects()]\n    pub fn cbrt(self) -> f64 { cbrt64(self) }\n    // sqrt(self^2 + other^2) without overflow or underflow on the way.\n    #[effects(diverge)]\n    pub fn hypot(self, other: f64) -> f64 { hypot64(self, other) }\n    // The sine (radians).\n    #[effects(panic, diverge)]\n    pub fn sin(self) -> f64 { sin64(self) }\n    // The cosine (radians).\n    #[effects(panic, diverge)]\n    pub fn cos(self) -> f64 { cos64(self) }\n    // The tangent (radians).\n    #[effects(panic, diverge)]\n    pub fn tan(self) -> f64 { tan64(self) }\n    // (sin, cos), with one argument reduction.\n    #[effects(panic, diverge)]\n    pub fn sin_cos(self) -> (f64, f64) { sin_cos64(self) }\n    // The arcsine, in [-pi/2, pi/2]; NaN outside [-1, 1].\n    #[effects(diverge)]\n    pub fn asin(self) -> f64 { asin64(self) }\n    // The arccosine, in [0, pi]; NaN outside [-1, 1].\n    #[effects(diverge)]\n    pub fn acos(self) -> f64 { acos64(self) }\n    // The arctangent, in [-pi/2, pi/2].\n    #[effects(panic)]\n    pub fn atan(self) -> f64 { atan64(self) }\n    // The angle of the point (other, self): self is y, other is x, the\n    // result in [-pi, pi].\n    #[effects(panic)]\n    pub fn atan2(self, other: f64) -> f64 { atan2_64(self, other) }\n    // e^self.\n    #[effects()]\n    pub fn exp(self) -> f64 { exp64(self) }\n    // 2^self.\n    #[effects()]\n    pub fn exp2(self) -> f64 { exp2_64(self) }\n");
    buf_str(out, c"    // The natural logarithm; -inf at 0, NaN below 0.\n    #[effects()]\n    pub fn ln(self) -> f64 { ln64(self) }\n    #[effects()]\n    pub fn log2(self) -> f64 { log2_64(self) }\n    #[effects()]\n    pub fn log10(self) -> f64 { log10_64(self) }\n    // The logarithm to the base `base`: self.ln() / base.ln().\n    #[effects()]\n    pub fn log(self, base: f64) -> f64 { ln64(self) / ln64(base) }\n    // self^n, C's pow (exact for exact cases: 2^10, 9^0.5).\n    #[effects(panic, diverge)]\n    pub fn powf(self, n: f64) -> f64 { pow64(self, n) }\n    // self^n by repeated squaring (a negative n is 1 / self^-n).\n    #[effects(diverge)]\n    pub fn powi(self, n: i32) -> f64 { powi64(self, n) }\n    // The least number greater than self: the smallest positive\n    // subnormal after either zero, +inf after MAX, +inf and NaN unchanged.\n    #[effects()]\n    pub fn next_up(self) -> f64 { next64(self, true) }\n    // The greatest number less than self.\n    #[effects()]\n    pub fn next_down(self) -> f64 { next64(self, false) }\n    // The quotient rounded so that self - rhs * q is the rem_euclid.\n    #[effects()]\n    pub fn div_euclid(self, rhs: f64) -> f64 {\n        let q = trunc64(self / rhs);\n        if self % rhs < 0.0 {\n            return if rhs > 0.0 { q - 1.0 } else { q + 1.0 };\n        }\n        q\n    }\n    // The least nonnegative remainder of self / rhs.\n    #[effects()]\n    pub fn rem_euclid(self, rhs: f64) -> f64 {\n        let r = self % rhs;\n        if r < 0.0 { r + rhs.abs() } else { r }\n    }\n    // IEEE 754's totalOrder: -NaN < -inf < .. < -0.0 < +0.0 < .. < +inf <\n    // +NaN (for `v.sort_by(|a, b| a.total_cmp(b))`).\n    #[effects()]\n    pub fn total_cmp(&self, other: &f64) -> crate::cmp::Ordering {\n        let mut l = f64_to_bits(*self) as i64;\n        let mut r = f64_to_bits(*other) as i64;\n        l ^= (((l >> 63) as u64) >> 1) as i64;\n        r ^= (((r >> 63) as u64) >> 1) as i64;\n        l.cmp(&r)\n    }\n}\n\n");
    buf_str(out, c"// f32's inherent methods (Rust's): as f64's; most are f64's, rounded once\n// (exact in f64 where the result is an integer).\nimpl f32 {\n    // The IEEE 754 bits.\n    #[effects()]\n    pub fn to_bits(self) -> u32 { f32_to_bits(self) }\n    // The f32 with these IEEE 754 bits.\n    #[effects()]\n    pub fn from_bits(v: u32) -> f32 { f32_from_bits(v) }\n    #[effects()]\n    pub fn abs(self) -> f32 { f32_from_bits(f32_to_bits(self) & 0x7fffffff) }\n    #[effects()]\n    pub fn signum(self) -> f32 {\n        if self != self { self } else { f32_from_bits(f32_to_bits(self) & 0x80000000 | 0x3f800000) }\n    }\n    #[effects()]\n    pub fn copysign(self, sign: f32) -> f32 {\n        f32_from_bits(f32_to_bits(self) & 0x7fffffff | f32_to_bits(sign) & 0x80000000)\n    }\n    #[effects()]\n    pub fn is_nan(self) -> bool { self != self }\n    #[effects()]\n    pub fn is_finite(self) -> bool { f32_to_bits(self) & 0x7fffffff < 0x7f800000 }\n    #[effects()]\n    pub fn is_infinite(self) -> bool { f32_to_bits(self) & 0x7fffffff == 0x7f800000 }\n    #[effects()]\n    pub fn is_normal(self) -> bool {\n        let e = (f32_to_bits(self) >> 23) & 0xff;\n        e != 0 && e != 0xff\n    }\n    #[effects()]\n    pub fn is_subnormal(self) -> bool {\n        let b = f32_to_bits(self) & 0x7fffffff;\n        b != 0 && b < 0x00800000\n    }\n    #[effects()]\n    pub fn is_sign_positive(self) -> bool { f32_to_bits(self) >> 31 == 0 }\n    #[effects()]\n    pub fn is_sign_negative(self) -> bool { f32_to_bits(self) >> 31 != 0 }\n    #[effects()]\n    pub fn floor(self) -> f32 { floor64(self as f64) as f32 }\n    #[effects()]\n    pub fn ceil(self) -> f32 { ceil64(self as f64) as f32 }\n    #[effects()]\n    pub fn round(self) -> f32 { round64(self as f64) as f32 }\n    #[effects()]\n    pub fn round_ties_even(self) -> f32 { round_even64(self as f64) as f32 }\n    #[effects()]\n    pub fn trunc(self) -> f32 { trunc64(self as f64) as f32 }\n    #[effects()]\n");
    buf_str(out, c"    pub fn fract(self) -> f32 { self - trunc64(self as f64) as f32 }\n    #[effects()]\n    pub fn min(self, other: f32) -> f32 { min64(self as f64, other as f64) as f32 }\n    #[effects()]\n    pub fn max(self, other: f32) -> f32 { max64(self as f64, other as f64) as f32 }\n    // self restricted to min..=max; panics when min > max or either is\n    // NaN, as Rust's.\n    #[effects(panic)]\n    pub fn clamp(self, min: f32, max: f32) -> f32 {\n        if !(min <= max) {\n            crate::panic::panic(\"min > max, or either was NaN\");\n        }\n        let mut r = self;\n        if r < min {\n            r = min;\n        }\n        if r > max {\n            r = max;\n        }\n        r\n    }\n    #[effects()]\n    pub fn recip(self) -> f32 { 1.0 / self }\n    // (Rust's constants: pi / 180 and 180 / pi rounded once to f32)\n    #[effects()]\n    pub fn to_radians(self) -> f32 { self * 0.017453292519943295769236907684886127 }\n    #[effects()]\n    pub fn to_degrees(self) -> f32 { self * 57.2957795130823208767981548141051703 }\n    // (f64's sqrt rounded to f32 is f32's correctly rounded sqrt: 53 >= 2 * 24 + 2)\n    #[effects(diverge)]\n    pub fn sqrt(self) -> f32 { sqrt64(self as f64) as f32 }\n    #[effects()]\n    pub fn cbrt(self) -> f32 { cbrt64(self as f64) as f32 }\n    // (in f64: the squares exact, no overflow)\n    #[effects(diverge)]\n    pub fn hypot(self, other: f32) -> f32 {\n        let a = self as f64;\n        let b = other as f64;\n        if a.is_infinite() || b.is_infinite() {\n            return f32::INFINITY;\n        }\n        sqrt64(a * a + b * b) as f32\n    }\n    #[effects(panic, diverge)]\n    pub fn sin(self) -> f32 { sin64(self as f64) as f32 }\n    #[effects(panic, diverge)]\n    pub fn cos(self) -> f32 { cos64(self as f64) as f32 }\n    #[effects(panic, diverge)]\n    pub fn tan(self) -> f32 { tan64(self as f64) as f32 }\n    #[effects(panic, diverge)]\n    pub fn sin_cos(self) -> (f32, f32) {\n");
    buf_str(out, c"        let (s, c) = sin_cos64(self as f64);\n        (s as f32, c as f32)\n    }\n    #[effects(diverge)]\n    pub fn asin(self) -> f32 { asin64(self as f64) as f32 }\n    #[effects(diverge)]\n    pub fn acos(self) -> f32 { acos64(self as f64) as f32 }\n    #[effects(panic)]\n    pub fn atan(self) -> f32 { atan64(self as f64) as f32 }\n    #[effects(panic)]\n    pub fn atan2(self, other: f32) -> f32 { atan2_64(self as f64, other as f64) as f32 }\n    #[effects()]\n    pub fn exp(self) -> f32 { exp64(self as f64) as f32 }\n    #[effects()]\n    pub fn exp2(self) -> f32 { exp2_64(self as f64) as f32 }\n    #[effects()]\n    pub fn ln(self) -> f32 { ln64(self as f64) as f32 }\n    #[effects()]\n    pub fn log2(self) -> f32 { log2_64(self as f64) as f32 }\n    #[effects()]\n    pub fn log10(self) -> f32 { log10_64(self as f64) as f32 }\n    #[effects()]\n    pub fn log(self, base: f32) -> f32 { (ln64(self as f64) / ln64(base as f64)) as f32 }\n    #[effects(panic, diverge)]\n    pub fn powf(self, n: f32) -> f32 { pow64(self as f64, n as f64) as f32 }\n    #[effects(diverge)]\n    pub fn powi(self, n: i32) -> f32 { powi64(self as f64, n) as f32 }\n    #[effects()]\n    pub fn next_up(self) -> f32 { next32(self, true) }\n    #[effects()]\n    pub fn next_down(self) -> f32 { next32(self, false) }\n    #[effects()]\n    pub fn div_euclid(self, rhs: f32) -> f32 {\n        let q = trunc64((self / rhs) as f64) as f32;\n        if self % rhs < 0.0 {\n            return if rhs > 0.0 { q - 1.0 } else { q + 1.0 };\n        }\n        q\n    }\n    #[effects()]\n    pub fn rem_euclid(self, rhs: f32) -> f32 {\n        let r = self % rhs;\n        if r < 0.0 { r + rhs.abs() } else { r }\n    }\n    #[effects()]\n    pub fn total_cmp(&self, other: &f32) -> crate::cmp::Ordering {\n        let mut l = f32_to_bits(*self) as i32;\n        let mut r = f32_to_bits(*other) as i32;\n        l ^= (((l >> 31) as u32) >> 1) as i32;\n        r ^= (((r >> 31) as u32) >> 1) as i32;\n");
    buf_str(out, c"        l.cmp(&r)\n    }\n}\n\n// pi, for the conversions above.\nconst PI64: f64 = 3.14159265358979323846264338327950288;\n// ---- end mod std::fmath ----\n}\n// ---- mod std::unicode ----\npub mod unicode {\n// std::unicode (0.20; std 0.28.0). Two parts. Private, for char and str:\n// char's classification (is_alphabetic,\n// is_numeric, is_whitespace, is_lowercase, is_uppercase) and case\n// (to_lowercase, to_uppercase), Unicode 18.0.0's, as MVS's std::unicode\n// has them. The tables are MVS's std/unicode/tables.vl's, generated from\n// the Unicode Character Database (v0.26.2's tools/unicode/gen.vl): do not\n// edit them by hand. Public, vole's own (Rust's std has neither): the\n// properties of a code point, grapheme clusters and display width, below\n// the case tables, for a terminal or an editor (GraphemeState,\n// ClusterWidth, graphemes, str_width, ..).\n// mvs: std::unicode\n\nuse crate::iter::Iterator;\nuse crate::option::Option;\n\n// Every byte of the tables below is written plus TABLE_BIAS (wrapping),\n// so that small numbers are one printable character each: table_byte\n// subtracts it. A table is a string literal read only as its bytes\n// (`as_bytes`), with `\\xHH` escapes above 0x7F (vole's literal is its\n// bytes): the front has no byte-string literal yet.\nconst TABLE_BIAS: u8 = 33;\n\n// Byte i of a table.\nfn table_byte(t: &str, i: usize) -> usize {\n    t.as_bytes()[i].wrapping_sub(TABLE_BIAS) as usize\n}\n\nconst CLASS_ALPHABETIC: u8 = 1;\nconst CLASS_NUMERIC: u8 = 2;\nconst CLASS_WHITE_SPACE: u8 = 4;\nconst CLASS_LOWERCASE: u8 = 8;\nconst CLASS_UPPERCASE: u8 = 16;\n\n// The class bits of code point cp (CLASS_*): a trie of three levels.\nfn classes(cp: u32) -> u8 {\n    let c: usize = if cp > 0x10ffff { 0x10ffff } else { cp as usize };\n    let i1 = c >> CLASSES_SHIFT1;\n    let mid = if CLASSES_WIDE1 {\n        table_byte(CLASSES_S1, 2 * i1) | (table_byte(CLASSES_S1, 2 * i1 + 1) << 8)\n    } else {\n        table_byte(CLASSES_S1, i1)\n");
    buf_str(out, c"    };\n    let i2 = (mid << (CLASSES_SHIFT1 - CLASSES_SHIFT2)) | ((c >> CLASSES_SHIFT2) & CLASSES_MASK2);\n    let leaf = if CLASSES_WIDE2 {\n        table_byte(CLASSES_S2, 2 * i2) | (table_byte(CLASSES_S2, 2 * i2 + 1) << 8)\n    } else {\n        table_byte(CLASSES_S2, i2)\n    };\n    table_byte(CLASSES_LEAVES, (leaf << CLASSES_SHIFT2) | (c & CLASSES_MASK3)) as u8\n}\n\n// Unicode's Alphabetic (char::is_alphabetic).\n#[effects(panic)]\npub(crate) fn is_alphabetic(cp: u32) -> bool {\n    (classes(cp) & CLASS_ALPHABETIC) != 0\n}\n\n// General_Category Nd, Nl or No (char::is_numeric).\n#[effects(panic)]\npub(crate) fn is_numeric(cp: u32) -> bool {\n    (classes(cp) & CLASS_NUMERIC) != 0\n}\n\n// Unicode's White_Space (char::is_whitespace).\n#[effects(panic)]\npub(crate) fn is_whitespace(cp: u32) -> bool {\n    (classes(cp) & CLASS_WHITE_SPACE) != 0\n}\n\n// Unicode's Lowercase (char::is_lowercase).\n#[effects(panic)]\npub(crate) fn is_lowercase(cp: u32) -> bool {\n    (classes(cp) & CLASS_LOWERCASE) != 0\n}\n\n// Unicode's Uppercase (char::is_uppercase).\n#[effects(panic)]\npub(crate) fn is_uppercase(cp: u32) -> bool {\n    (classes(cp) & CLASS_UPPERCASE) != 0\n}\n\n// The 3-byte little-endian number at t[i].\nfn case_u24(t: &str, i: usize) -> u32 {\n    (table_byte(t, i) | (table_byte(t, i + 1) << 8) | (table_byte(t, i + 2) << 16)) as u32\n}\n\n// cp's mapping in a case table of n sorted (cp, mapping) entries, searched\n// by halves: up to 3 code points, the rest 0; cp itself when the table\n// has none.\nfn case_map(table: &str, multi: &str, n: usize, cp: u32) -> [u32; 3] {\n    let mut lo: usize = 0;\n    let mut hi = n;\n    while lo < hi {\n        let mid = (lo + hi) / 2;\n        let k = case_u24(table, mid * 6);\n        if k < cp {\n            lo = mid + 1;\n        } else if k > cp {\n            hi = mid;\n        } else {\n            let m = case_u24(table, mid * 6 + 3);\n            if (m & 0x800000) != 0 {\n");
    buf_str(out, c"                let j = ((m & 0x7fffff) * 9) as usize;\n                return [case_u24(multi, j), case_u24(multi, j + 3), case_u24(multi, j + 6)];\n            }\n            return [m, 0, 0];\n        }\n    }\n    [cp, 0, 0]\n}\n\n// The lowercase of cp, not ASCII: one to three code points, the rest 0\n// (unconditional: `İ` is `i` and U+0307).\n#[effects(panic, diverge)]\npub(crate) fn to_lower(cp: u32) -> [u32; 3] {\n    case_map(LOWER_TABLE, LOWER_MULTI, LOWER_COUNT, cp)\n}\n\n// The uppercase of cp, not ASCII: one to three code points, the rest 0\n// (`ß` is `SS`).\n#[effects(panic, diverge)]\npub(crate) fn to_upper(cp: u32) -> [u32; 3] {\n    case_map(UPPER_TABLE, UPPER_MULTI, UPPER_COUNT, cp)\n}\n\n// ---- The tables ----\n\nconst CLASSES_SHIFT2: usize = 4;\nconst CLASSES_SHIFT1: usize = 9;\nconst CLASSES_MASK2: usize = 31;\nconst CLASSES_MASK3: usize = 15;\nconst CLASSES_WIDE1: bool = false;\nconst CLASSES_WIDE2: bool = true;\nconst CLASSES_S1: &str = \"!\\x22#$%&'()*+,-./01234225678999999\\\n    999999:9999999999999999999999999\\\n    999999999999999999;<=>9999999999\\\n    99999999999?2222222222222222@\\x41\\x42\\x43\\\n    \\x44\\x45\\x46\\x47\\x48\\x49\\x4a\\x4b\\x4c\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x539\\x54\\x55\\x56222\\x5799\\x5899999\\\n    9\\x599\\x5a222222222222\\x5b2229\\x5c\\x5d\\x5e99999999\\\n    999999\\x5f9\\x6022222222222222\\x61\\x62\\x632222\\x642\\\n    222222\\x6522\\x66\\x67\\x68222\\x69\\x6a\\x6b\\x6c\\x6d\\x6e2\\x6f\\x70\\x712222\\x7222\\\n    99999999999999999999999999999999\\\n    99999999999999999999999999999999\\\n    9999999999999999999\\x7399999999\\x74999\\\n    9999999\\x759999999999999\\x769\\x7722229\\x7822\\\n    999999999\\x799999999999999999\\x7a22222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    222222229999999999999999999999\\x7b2\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n");
    buf_str(out, c"    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\";\n");
