// (Z5) Gpa's implementation, std::__gpa (front/stdalloc.vl: std_tail)
pub fn std_gpa_source(out: i64) {
    buf_str(out, c"// Gpa's implementation (Z5): C's malloc. Not a module of std's tree:\n// compiler/std/embed.sh embeds it as std_gpa_source, and\n// the compiler's tail (front/stdalloc.vl: std_tail) puts it in\n// `std::__gpa` unless --check-alloc asks for the checking allocator\n// (rt/alloc_check.vl). alloc.vl's `impl Allocator for Gpa` calls these.\n\nuse crate::alloc::{AllocError, Layout};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// UNSAFE: C's heap, under Gpa.\n// SAFETY: malloc and posix_memalign return a block of at least size bytes\n// (null when out of memory), aligned to 16 or to align; free takes what\n// they returned, once. The functions below keep to that.\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn gpa_c_malloc(size: usize) -> *mut u8;\n    #[link_name = \"posix_memalign\"]\n    fn gpa_c_posix_memalign(out: *mut *mut u8, align: usize, size: usize) -> i32;\n    #[link_name = \"free\"]\n    fn gpa_c_free(p: *mut u8);\n}\n\n// A block for layout: from malloc (posix_memalign above 16), or a\n// dangling aligned pointer for size 0 (Rust's Global).\n#[effects(alloc(extern), unsafe)]\npub fn allocate(layout: Layout) -> Result<NonNull<u8>, AllocError> {\n    if layout.size() == 0 {\n        // (an address made a pointer, never read or written: a zero-size\n        // block)\n        return match NonNull::new(layout.align() as *mut u8) {\n            Option::Some(p) => Result::Ok(p),\n            Option::None => Result::Err(AllocError {}),\n        };\n    }\n    // UNSAFE: C's heap.\n    // SAFETY: malloc and posix_memalign take any size; posix_memalign's\n    // align is a power of two (Layout's) and at least a word (above 16\n    // only), and it writes p only on success.\n    let p = unsafe {\n        if layout.align() <= 16 {\n            gpa_c_malloc(layout.size())\n        } else {\n            let mut out: *mut u8 = crate::ptr::null_mut();\n");
    buf_str(out, c"            if gpa_c_posix_memalign(&mut out, layout.align(), layout.size()) == 0 {\n                out\n            } else {\n                crate::ptr::null_mut()\n            }\n        }\n    };\n    match NonNull::new(p) {\n        Option::Some(p) => Result::Ok(p),\n        Option::None => Result::Err(AllocError {}),\n    }\n}\n\n// Gives block p (of layout) back to C's heap.\n// UNSAFE: p must be a block allocate gave, with this layout, not yet given\n// back.\n// SAFETY: a contract on the caller (Allocator::deallocate's).\n#[effects(alloc(extern), unsafe)]\npub unsafe fn deallocate(p: NonNull<u8>, layout: Layout) {\n    if layout.size() != 0 {\n        // UNSAFE: C's free.\n        // SAFETY: the caller's contract: p came from malloc or\n        // posix_memalign, once.\n        unsafe { gpa_c_free(p.as_ptr()) }\n    }\n}\n\n// Without --check-alloc no block is counted.\n#[effects()]\npub fn live_blocks() -> usize {\n    0\n}\n\n#[effects()]\npub fn check_leaks() -> bool {\n    true\n}\n\n// (0.28.0, std::test) The blocks allocated so far, a mark; the blocks\n// left since a mark (a property's case, a fuzz run): none counted\n// without --check-alloc.\n#[effects()]\npub fn check_alloc_mark() -> usize {\n    0\n}\n\n#[effects()]\npub fn check_alloc_leaks_since(mark: usize) -> usize {\n    0\n}\n");
}

// (Z5) the same with --check-alloc: the checking allocator
pub fn std_check_gpa_source(out: i64) {
    buf_str(out, c"// Gpa's implementation with --check-alloc (Z5): the checking allocator,\n// MVS's (compiler/std/alloc_check.vl) in std's spellings. Not a module of\n// std's tree: compiler/std/embed.sh embeds it as\n// std_check_gpa_source, and the compiler's tail (front/stdalloc.vl:\n// std_tail) puts it in `std::__gpa` with --check-alloc, after\n// CHECK_ALLOC_OS (0 macOS, 1 Linux); `std::CHECK_ALLOC_SITE` is the static\n// the compiled program stores each allocating call's site in\n// (middle/checkalloc.vl).\n//\n// Every block gets pages of its own, at the cursor of a large reservation\n// of address space with no access: a block's pages are made readable and\n// writable when it is allocated, and are given back with no access when\n// it is freed, never to be handed out again (every grow moves: the\n// Allocator's default grow). A later access to a freed block faults, and\n// the fault handler names the block, where it was allocated and where\n// freed. Frees are checked: double, invalid and wrong-size frees stop the\n// program (exit 101); the blocks left at exit are listed on stderr (the\n// exit status is unchanged). Block numbers count every allocation from 1,\n// the same each run: VOLE_ALLOC_TRAP=N raises SIGTRAP when block N is\n// allocated, for a debugger. Arenas over a Gpa take their chunks here.\n\nuse crate::alloc::{AllocError, Layout};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\n\n// UNSAFE: the system's memory maps, signals and exit, and C's realloc and\n// memcpy for the table and the moves.\n// SAFETY: the prototypes are sys/mman.h's, signal.h's, stdlib.h's,\n// string.h's and unistd.h's; each call below says why its arguments are\n// valid.\nextern \"C\" {\n    // (0.28.0, as MVS's: its messages and stops are the allocator's misuse,\n    // the effect `alloc`: not io, which an allocator may not do)\n    #[link_name = \"mmap\"]\n    #[effects(alloc(extern), static)]\n");
    buf_str(out, c"    fn check_c_mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, offset: i64)\n        -> *mut u8;\n    #[link_name = \"mprotect\"]\n    #[effects(alloc(extern), static)]\n    fn check_c_mprotect(addr: *mut u8, len: usize, prot: i32) -> i32;\n    #[link_name = \"getpagesize\"]\n    #[effects(static)]\n    fn check_c_getpagesize() -> i32;\n    #[link_name = \"getenv\"]\n    #[effects(static)]\n    fn check_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"raise\"]\n    #[effects(static)]\n    fn check_c_raise(sig: i32) -> i32;\n    #[link_name = \"atexit\"]\n    #[effects(static)]\n    fn check_c_atexit(f: extern \"C\" fn()) -> i32;\n    #[link_name = \"sigaction\"]\n    #[effects(static)]\n    fn check_c_sigaction(sig: i32, act: *const CheckSigaction, old: *mut CheckSigaction) -> i32;\n    #[link_name = \"write\"]\n    #[effects(static)]\n    fn check_c_write(fd: i32, data: *const u8, count: usize) -> isize;\n    #[link_name = \"realloc\"]\n    #[effects(alloc(extern))]\n    fn check_c_realloc(p: *mut u8, size: usize) -> *mut u8;\n    #[link_name = \"_exit\"]\n    #[effects(diverge)]\n    fn check_c_exit(code: i32) -> !;\n}\n\n// std's atomic intrinsics (the lowering makes ATOMIC instructions of a std\n// function named so; middle/lower/atomic.vl): the lock's.\n// UNSAFE: a raw pointer. SAFETY: p is valid and aligned (CHECK_LOCK's,\n// CHECK_OWNER's).\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable(\"an intrinsic\")\n}\n\n// UNSAFE: a raw pointer. SAFETY: as atomic_cas.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable(\"an intrinsic\")\n}\n\n// UNSAFE: a raw pointer. SAFETY: as atomic_cas.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable(\"an intrinsic\")\n}\n\n// Threads: each entry below holds this lock (0 free, 1 taken), so the\n");
    buf_str(out, c"// tables are never changed by two threads at once. The fault handler takes\n// nothing (it stops the program). CHECK_ALLOC_SITE is stored by the program\n// without it: under threads a block may name another thread's call.\nstatic mut CHECK_LOCK: u32 = 0;\n// The thread holding CHECK_LOCK (0: none): --check-unsafe checks the\n// allocator's own raw accesses too, through check_alloc_access, inside an\n// entry that holds the lock, so the lock is taken again by no one.\nstatic mut CHECK_OWNER: u64 = 0;\n\n// UNSAFE: C. SAFETY: pthread.h's prototype (pthread_t as u64).\nextern \"C\" {\n    #[link_name = \"pthread_self\"]\n    #[effects()]\n    fn check_thread_self() -> u64;\n}\n\n// Takes CHECK_LOCK unless this thread holds it: whether it did.\nfn check_lock() -> bool {\n    // UNSAFE: C, and the lock's and the owner's words, through the atomic\n    // intrinsics.\n    // SAFETY: pthread_self takes nothing; CHECK_LOCK and CHECK_OWNER are\n    // statics, valid and aligned, only ever accessed atomically. The owner\n    // is this thread only when this thread stored it, under the lock.\n    unsafe {\n        let me = check_thread_self();\n        let o: *mut u64 = &raw mut CHECK_OWNER;\n        if atomic_load(o, 0) == me {\n            return false;\n        }\n        let p: *mut u32 = &raw mut CHECK_LOCK;\n        while atomic_cas(p, 0, 1, 1) != 0 {}\n        atomic_store(o, me, 0);\n        true\n    }\n}\n\n// Lets CHECK_LOCK go when check_lock took it.\nfn check_unlock(took: bool) {\n    if !took {\n        return;\n    }\n    // UNSAFE: as check_lock. SAFETY: as check_lock's.\n    unsafe {\n        let o: *mut u64 = &raw mut CHECK_OWNER;\n        atomic_store(o, 0, 0);\n        let p: *mut u32 = &raw mut CHECK_LOCK;\n        atomic_store(p, 0, 2);\n    }\n}\n\n// A block: its pages [start, start + span), its size, its state, and where\n// it was allocated and freed.\nstruct CheckBlock {\n    start: usize,\n    size: usize,\n    span: usize,\n    state: usize,\n");
    buf_str(out, c"    alloc_site: *const u8,\n    free_site: *const u8,\n}\n\nconst CHECK_LIVE_BLOCK: usize = 1;\nconst CHECK_FREED: usize = 2;\n\n// Every block, in the order allocated (block #N is CHECK_BLOCKS[N - 1]).\nstatic mut CHECK_BLOCKS: *mut CheckBlock = 0 as *mut CheckBlock;\nstatic mut CHECK_COUNT: usize = 0;\nstatic mut CHECK_CAP: usize = 0;\n// The live blocks.\nstatic mut CHECK_LIVE: usize = 0;\n// The reservations of address space (regions): their bounds and their\n// first block; a region's blocks follow each other, so the blocks are\n// sorted by address within one. The cursor is in the last region.\nconst CHECK_MAX_REGIONS: usize = 256;\nstatic mut CHECK_REGION_START: [usize; 256] = [0; 256];\nstatic mut CHECK_REGION_END: [usize; 256] = [0; 256];\nstatic mut CHECK_REGION_FIRST: [usize; 256] = [0; 256];\nstatic mut CHECK_REGIONS: usize = 0;\nstatic mut CHECK_CURSOR: usize = 0;\n// The page size, 0 until the first allocation.\nstatic mut CHECK_PAGE: usize = 0;\n// VOLE_ALLOC_TRAP; VOLE_ALLOC_MAX_LIVE (the map limit's message when this\n// many blocks are live); 0 when unset.\nstatic mut CHECK_TRAP: usize = 0;\nstatic mut CHECK_MAX_LIVE: usize = 0;\n// The changes to the blocks (allocations and frees), and their count when\n// check_leaks listed the leaks (the exit's list is left out then).\nstatic mut CHECK_CHANGES: usize = 0;\nstatic mut CHECK_LISTED: usize = 0;\nstatic mut CHECK_EVER_LISTED: bool = false;\n\nconst CHECK_REGION_BYTES: usize = 68719476736;\nconst CHECK_PROT_NONE: i32 = 0;\nconst CHECK_PROT_RW: i32 = 3;\nconst CHECK_MAP_FIXED: i32 = 16;\n\n// The system's constants: macOS (CHECK_ALLOC_OS 0) and Linux (1).\nfn check_map_flags() -> i32 {\n    // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE\n    if CHECK_ALLOC_OS == 1 { 2 | 32 | 16384 } else { 2 | 4096 | 64 }\n}\n\nfn check_sigbus() -> i32 {\n    if CHECK_ALLOC_OS == 1 { 7 } else { 10 }\n}\n\n// struct sigaction: the handler, then (macOS) a 4-byte mask and the flags,\n");
    buf_str(out, c"// or (glibc) a 128-byte mask and the flags.\n#[repr(C)]\nstruct CheckSigaction {\n    handler: extern \"C\" fn(i32, *mut u8, *mut u8),\n    words: [u64; 19],\n}\n\nfn check_sigaction() -> CheckSigaction {\n    let mut a = CheckSigaction { handler: check_fault, words: [0; 19] };\n    if CHECK_ALLOC_OS == 1 {\n        // SA_SIGINFO | SA_RESETHAND\n        a.words[16] = 4 | 2147483648;\n    } else {\n        a.words[0] = (64 | 4) << 32;\n    }\n    a\n}\n\n// The offset of si_addr in siginfo_t.\nfn check_si_addr() -> usize {\n    if CHECK_ALLOC_OS == 1 { 16 } else { 24 }\n}\n\n// A message, written to stderr at once.\nstruct CheckMsg {\n    len: usize,\n    bytes: [u8; 2048],\n}\n\nimpl CheckMsg {\n    fn new() -> CheckMsg {\n        CheckMsg { len: 0, bytes: [0; 2048] }\n    }\n\n    fn byte(&mut self, b: u8) {\n        if self.len < 2048 {\n            self.bytes[self.len] = b;\n            self.len += 1;\n        }\n    }\n\n    fn text(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            self.byte(b[i]);\n            i += 1;\n        }\n    }\n\n    // UNSAFE: s must be a C string.\n    // SAFETY: a contract on the caller: every site is a string literal's.\n    unsafe fn cstr(&mut self, s: *const u8) {\n        let mut n: usize = 0;\n        // UNSAFE: the string's bytes, to its 0.\n        // SAFETY: the caller's contract: s is a C string.\n        unsafe {\n            while *s.add(n) != 0 {\n                self.byte(*s.add(n));\n                n += 1;\n            }\n        }\n    }\n\n    fn int(&mut self, v: usize) {\n        if v >= 10 {\n            self.int(v / 10);\n        }\n        self.byte(b'0' + (v % 10) as u8);\n    }\n\n    fn hex(&mut self, v: usize) {\n        self.text(\"0x\");\n        let digits = \"0123456789abcdef\".as_bytes();\n        let mut started = false;\n        let mut k: usize = 0;\n        while k < 16 {\n            let d = (v >> ((15 - k) * 4)) & 15;\n");
    buf_str(out, c"            if d != 0 || started || k == 15 {\n                started = true;\n                self.byte(digits[d]);\n            }\n            k += 1;\n        }\n    }\n\n    fn site(&mut self, s: *const u8) {\n        if s.is_null() {\n            self.text(\"an unknown place\");\n        } else {\n            // UNSAFE: a site, stored by the compiled program.\n            // SAFETY: every site is a string literal's C string.\n            unsafe { self.cstr(s) }\n        }\n    }\n\n    fn out(&mut self) {\n        self.byte(b'\\n');\n        // UNSAFE: write(2) of the message's bytes.\n        // SAFETY: bytes holds len initialized bytes.\n        unsafe {\n            check_c_write(2, &self.bytes[0] as *const u8, self.len);\n        }\n    }\n}\n\n// Stops the program with message m (exit 101, without the leaks' list).\nfn check_stop(m: &mut CheckMsg) -> ! {\n    m.out();\n    // UNSAFE: _exit. SAFETY: it takes any code.\n    unsafe { check_c_exit(101) }\n}\n\n// Block b, read from the table.\n// UNSAFE: b < CHECK_COUNT.\n// SAFETY: a contract on the caller; the table holds CHECK_COUNT blocks.\nunsafe fn check_block(b: usize) -> *mut CheckBlock {\n    // UNSAFE: an offset into the table. SAFETY: the caller's: b is in it.\n    unsafe { CHECK_BLOCKS.add(b) }\n}\n\n// `block #N (48 bytes), allocated at X[, freed at Y]`.\n// UNSAFE: b < CHECK_COUNT. SAFETY: a contract on the caller.\nunsafe fn check_describe(m: &mut CheckMsg, b: usize) {\n    // UNSAFE: block b. SAFETY: the caller's: b is in the table.\n    unsafe {\n        let k = check_block(b);\n        m.text(\"block #\");\n        m.int(b + 1);\n        m.text(\" (\");\n        m.int((*k).size);\n        m.text(if (*k).size == 1 { \" byte)\" } else { \" bytes)\" });\n        m.text(\", allocated at \");\n        m.site((*k).alloc_site);\n        if (*k).state != CHECK_LIVE_BLOCK {\n            m.text(\", freed at \");\n            m.site((*k).free_site);\n        }\n    }\n}\n\n");
    buf_str(out, c"// The decimal number in environment variable `name` (a C string; 0 when\n// unset or none).\nfn check_env_int(name: &str) -> usize {\n    // UNSAFE: getenv of a C string; its result read to its 0.\n    // SAFETY: name ends in a 0 (the callers' literals); getenv's result is\n    // null or a C string.\n    unsafe {\n        let s = check_c_getenv(name.as_ptr());\n        if s.is_null() {\n            return 0;\n        }\n        let mut v: usize = 0;\n        let mut i: usize = 0;\n        while *s.add(i) >= b'0' && *s.add(i) <= b'9' {\n            v = v * 10 + (*s.add(i) - b'0') as usize;\n            i += 1;\n        }\n        v\n    }\n}\n\n// The first allocation: the page size, the fault handlers, the leaks' list\n// at exit, the environment.\nfn check_init() {\n    // UNSAFE: the system's calls, and the checker's statics (under the lock).\n    // SAFETY: a is a valid sigaction for both signals; check_at_exit takes\n    // nothing.\n    unsafe {\n        CHECK_PAGE = check_c_getpagesize() as usize;\n        let a = check_sigaction();\n        check_c_sigaction(11, &a, crate::ptr::null_mut());\n        check_c_sigaction(check_sigbus(), &a, crate::ptr::null_mut());\n        check_c_atexit(check_at_exit);\n        CHECK_TRAP = check_env_int(\"VOLE_ALLOC_TRAP\\0\");\n        CHECK_MAX_LIVE = check_env_int(\"VOLE_ALLOC_MAX_LIVE\\0\");\n    }\n}\n\n// The system refused to change a block's pages: on Linux, the limit of\n// memory maps (each run of live blocks between freed ones is a map).\nfn check_map_limit() -> ! {\n    let mut m = CheckMsg::new();\n    m.text(\"check-alloc: out of memory maps at block #\");\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    unsafe {\n        m.int(CHECK_COUNT + 1);\n        m.text(\", with \");\n        m.int(CHECK_LIVE);\n    }\n    m.text(\" blocks live: the kernel's vm.max_map_count is reached (every live block has pages of its own)\");\n    m.text(\"\\ntry: sudo sysctl vm.max_map_count=1048576\");\n");
    buf_str(out, c"    check_stop(&mut m)\n}\n\n// A new region of at least `bytes`, or false.\nfn check_reserve(bytes: usize) -> bool {\n    // UNSAFE: mmap of address space with no access; the checker's statics.\n    // SAFETY: a fresh mapping (no address asked for); under the lock.\n    unsafe {\n        if CHECK_REGIONS == CHECK_MAX_REGIONS {\n            return false;\n        }\n        let mut size = CHECK_REGION_BYTES;\n        while size < bytes {\n            size = size * 2;\n        }\n        loop {\n            let p = check_c_mmap(crate::ptr::null_mut(), size, CHECK_PROT_NONE, check_map_flags(),\n                -1, 0);\n            if p as isize != -1 {\n                let r = CHECK_REGIONS;\n                CHECK_REGION_START[r] = p as usize;\n                CHECK_REGION_END[r] = p as usize + size;\n                CHECK_REGION_FIRST[r] = CHECK_COUNT;\n                CHECK_REGIONS += 1;\n                CHECK_CURSOR = p as usize;\n                return true;\n            }\n            // (less address space: smaller reservations)\n            if size / 2 < bytes || size <= 1073741824 {\n                return false;\n            }\n            size = size / 2;\n        }\n    }\n}\n\n// A new block of size bytes (> 0) on pages of its own, or null when out of\n// memory.\nfn check_new_block(size: usize) -> *mut u8 {\n    // UNSAFE: the pages made readable and writable; the table grown with\n    // realloc and written; the checker's statics.\n    // SAFETY: [cursor, cursor + span) is in the last region, never handed\n    // out before; the table has room for the new block; under the lock.\n    unsafe {\n        if CHECK_PAGE == 0 {\n            check_init();\n        }\n        if size > 4611686018427387904 {\n            return crate::ptr::null_mut();\n        }\n        let page = CHECK_PAGE;\n        let span = (size + page - 1) / page * page;\n        if CHECK_REGIONS == 0 || CHECK_CURSOR + span > CHECK_REGION_END[CHECK_REGIONS - 1] {\n");
    buf_str(out, c"            if !check_reserve(span) {\n                return crate::ptr::null_mut();\n            }\n        }\n        if CHECK_MAX_LIVE > 0 && CHECK_LIVE >= CHECK_MAX_LIVE {\n            check_map_limit();\n        }\n        let p = CHECK_CURSOR as *mut u8;\n        if check_c_mprotect(p, span, CHECK_PROT_RW) != 0 {\n            if CHECK_ALLOC_OS == 1 {\n                check_map_limit();\n            }\n            return crate::ptr::null_mut();\n        }\n        CHECK_CURSOR += span;\n        if CHECK_COUNT == CHECK_CAP {\n            CHECK_CAP = if CHECK_CAP == 0 { 1024 } else { CHECK_CAP * 2 };\n            CHECK_BLOCKS = check_c_realloc(CHECK_BLOCKS as *mut u8,\n                CHECK_CAP * crate::mem::size_of::<CheckBlock>()) as *mut CheckBlock;\n        }\n        *CHECK_BLOCKS.add(CHECK_COUNT) = CheckBlock {\n            start: p as usize,\n            size: size,\n            span: span,\n            state: CHECK_LIVE_BLOCK,\n            alloc_site: crate::CHECK_ALLOC_SITE,\n            free_site: crate::ptr::null(),\n        };\n        CHECK_COUNT += 1;\n        CHECK_CHANGES += 1;\n        CHECK_LIVE += 1;\n        if CHECK_COUNT == CHECK_TRAP {\n            let mut m = CheckMsg::new();\n            m.text(\"check-alloc: \");\n            check_describe(&mut m, CHECK_COUNT - 1);\n            m.text(\" (VOLE_ALLOC_TRAP): SIGTRAP\");\n            m.out();\n            check_c_raise(5);\n        }\n        p\n    }\n}\n\n// Block b's pages given back, with no access, never used again.\n// UNSAFE: b < CHECK_COUNT, a live block. SAFETY: a contract on the caller.\nunsafe fn check_drop_block(b: usize) {\n    // UNSAFE: the block's pages mapped again with no access; its entry.\n    // SAFETY: the caller's: b is a live block, whose pages are its own.\n    unsafe {\n        let k = check_block(b);\n        let p = (*k).start as *mut u8;\n        let span = (*k).span;\n        let flags = check_map_flags() | CHECK_MAP_FIXED;\n");
    buf_str(out, c"        if check_c_mmap(p, span, CHECK_PROT_NONE, flags, -1, 0) != p {\n            if CHECK_ALLOC_OS == 1 {\n                check_map_limit();\n            }\n            // (the pages keep their contents, but no access)\n            check_c_mprotect(p, span, CHECK_PROT_NONE);\n        }\n        CHECK_LIVE -= 1;\n        (*k).state = CHECK_FREED;\n        (*k).free_site = crate::CHECK_ALLOC_SITE;\n        CHECK_CHANGES += 1;\n    }\n}\n\n// Where address a is: Some(block) whose pages hold it, None outside the\n// reservations; `inside` true when it is in one (and no block holds it).\nfn check_find(a: usize, inside: &mut bool) -> Option<usize> {\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock (or\n    // in the fault handler, which stops the program); blocks below\n    // CHECK_COUNT.\n    unsafe {\n        *inside = false;\n        let mut r: usize = 0;\n        while r < CHECK_REGIONS {\n            if a >= CHECK_REGION_START[r] && a < CHECK_REGION_END[r] {\n                *inside = true;\n                let first = CHECK_REGION_FIRST[r];\n                let mut lo = first;\n                let mut hi = if r + 1 < CHECK_REGIONS { CHECK_REGION_FIRST[r + 1] }\n                    else { CHECK_COUNT };\n                // the last block starting at or before a\n                while lo < hi {\n                    let mid = (lo + hi) / 2;\n                    if (*check_block(mid)).start <= a {\n                        lo = mid + 1;\n                    } else {\n                        hi = mid;\n                    }\n                }\n                if lo > first {\n                    let b = lo - 1;\n                    let k = check_block(b);\n                    if a < (*k).start + (*k).span {\n                        return Option::Some(b);\n                    }\n                }\n                return Option::None;\n            }\n            r += 1;\n        }\n        Option::None\n    }\n}\n\n");
    buf_str(out, c"// The live block p of `size` bytes, being freed: its index, or the program\n// stops.\nfn check_owned(p: usize, size: usize) -> usize {\n    let mut inside = false;\n    let found = check_find(p, &mut inside);\n    let mut m = CheckMsg::new();\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock; b\n    // from check_find, below CHECK_COUNT.\n    unsafe {\n        let b = match found {\n            Option::Some(b) => b,\n            Option::None => {\n                m.text(\"invalid free at \");\n                m.site(crate::CHECK_ALLOC_SITE);\n                m.text(\": \");\n                m.hex(p);\n                m.text(\" is not a block of Gpa\");\n                check_stop(&mut m)\n            }\n        };\n        let k = check_block(b);\n        if (*k).start != p {\n            m.text(\"invalid free at \");\n            m.site(crate::CHECK_ALLOC_SITE);\n            m.text(\": \");\n            m.hex(p);\n            m.text(\" is \");\n            m.int(p - (*k).start);\n            m.text(\" bytes into \");\n            check_describe(&mut m, b);\n            check_stop(&mut m);\n        }\n        if (*k).state != CHECK_LIVE_BLOCK {\n            m.text(\"double free: \");\n            check_describe(&mut m, b);\n            m.text(\", freed again at \");\n            m.site(crate::CHECK_ALLOC_SITE);\n            check_stop(&mut m);\n        }\n        if (*k).size != size {\n            m.text(\"wrong-size free: \");\n            check_describe(&mut m, b);\n            m.text(\", freed as \");\n            m.int(size);\n            m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n            m.site(crate::CHECK_ALLOC_SITE);\n            check_stop(&mut m);\n        }\n        b\n    }\n}\n\n// SIGSEGV, SIGBUS: an access to a freed block (or to the pages after the\n// last one) is reported; any other fault happens again with the default\n// action (SA_RESETHAND), as without --check-alloc.\n");
    buf_str(out, c"extern \"C\" fn check_fault(sig: i32, info: *mut u8, context: *mut u8) {\n    // UNSAFE: siginfo_t's si_addr read through the kernel's pointer.\n    // SAFETY: info is the siginfo_t the kernel passes an SA_SIGINFO\n    // handler; si_addr is a word at check_si_addr().\n    let a = unsafe { *(info.add(check_si_addr()) as *const usize) };\n    let mut inside = false;\n    let found = check_find(a, &mut inside);\n    if !inside {\n        return;\n    }\n    let mut m = CheckMsg::new();\n    match found {\n        Option::Some(b) => {\n            m.text(\"use after free: \");\n            // UNSAFE: block b. SAFETY: from check_find, below CHECK_COUNT.\n            unsafe { check_describe(&mut m, b) }\n        }\n        Option::None => {\n            m.text(\"access outside every block: \");\n            m.hex(a);\n            m.text(\" (memory the checking allocator never handed out)\");\n        }\n    }\n    check_stop(&mut m);\n}\n\n// The live blocks, listed (at most 20).\nfn check_list_leaks() {\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock;\n    // blocks below CHECK_COUNT.\n    unsafe {\n        CHECK_LISTED = CHECK_CHANGES;\n        CHECK_EVER_LISTED = true;\n        if CHECK_LIVE == 0 {\n            return;\n        }\n        let mut bytes: usize = 0;\n        let mut b: usize = 0;\n        while b < CHECK_COUNT {\n            if (*check_block(b)).state == CHECK_LIVE_BLOCK {\n                bytes += (*check_block(b)).size;\n            }\n            b += 1;\n        }\n        let mut m = CheckMsg::new();\n        m.text(\"check-alloc: \");\n        m.int(CHECK_LIVE);\n        m.text(if CHECK_LIVE == 1 { \" block\" } else { \" blocks\" });\n        m.text(\" of Gpa not freed (\");\n        m.int(bytes);\n        m.text(\" bytes):\");\n        m.out();\n        let mut shown: usize = 0;\n        b = 0;\n        while b < CHECK_COUNT {\n            if (*check_block(b)).state == CHECK_LIVE_BLOCK {\n                if shown == 20 {\n");
    buf_str(out, c"                    let mut more = CheckMsg::new();\n                    more.text(\"  and \");\n                    more.int(CHECK_LIVE - shown);\n                    more.text(\" more\");\n                    more.out();\n                    return;\n                }\n                let mut line = CheckMsg::new();\n                line.text(\"  \");\n                check_describe(&mut line, b);\n                line.out();\n                shown += 1;\n            }\n            b += 1;\n        }\n    }\n}\n\n// At exit: the leaks, unless check_leaks listed them and nothing changed\n// since.\nextern \"C\" fn check_at_exit() {\n    let took = check_lock();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    unsafe {\n        if !CHECK_EVER_LISTED || CHECK_LISTED != CHECK_CHANGES {\n            check_list_leaks();\n        }\n    }\n    check_unlock(took);\n}\n\n// A block for layout on pages of its own (page-aligned: any alignment up\n// to a page), or a dangling aligned pointer for size 0.\npub fn allocate(layout: Layout) -> Result<NonNull<u8>, AllocError> {\n    let p = if layout.size() == 0 {\n        // UNSAFE: an address made a pointer (an integer-to-pointer cast).\n        // SAFETY: it is never read or written: a zero-size block.\n        unsafe { layout.align() as *mut u8 }\n    } else {\n        let took = check_lock();\n        let q = check_new_block(layout.size());\n        check_unlock(took);\n        q\n    };\n    match NonNull::new(p) {\n        Option::Some(p) => Result::Ok(p),\n        Option::None => Result::Err(AllocError {}),\n    }\n}\n\n// Block p (of layout) given back: checked against the table first (a\n// double, invalid or wrong-size free stops the program).\n// UNSAFE: p must be a block allocate gave, with this layout.\n// SAFETY: a contract on the caller (Allocator::deallocate's), and checked.\npub unsafe fn deallocate(p: NonNull<u8>, layout: Layout) {\n    let took = check_lock();\n    let a = p.as_ptr() as usize;\n");
    buf_str(out, c"    let mut inside = false;\n    if layout.size() == 0 && !check_find(a, &mut inside).is_some() {\n        check_unlock(took);\n        return;\n    }\n    let b = check_owned(a, layout.size());\n    // UNSAFE: block b given back. SAFETY: check_owned found it live.\n    unsafe { check_drop_block(b) }\n    check_unlock(took);\n}\n\n// The blocks allocated and not freed.\npub fn live_blocks() -> usize {\n    let took = check_lock();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    let n = unsafe { CHECK_LIVE };\n    check_unlock(took);\n    n\n}\n\n// Whether no block is left allocated (the live ones listed on stderr).\npub fn check_leaks() -> bool {\n    let took = check_lock();\n    check_list_leaks();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    let none = unsafe { CHECK_LIVE == 0 };\n    check_unlock(took);\n    none\n}\n\n// (0.28.0, std::test) The blocks allocated so far: a mark for\n// check_alloc_leaks_since.\n#[effects(io, static, panic, diverge, unsafe)]\npub fn check_alloc_mark() -> usize {\n    let took = check_lock();\n    // UNSAFE: the checker's statics. SAFETY: under the lock.\n    let n = unsafe { CHECK_COUNT };\n    check_unlock(took);\n    n\n}\n\n// The blocks allocated from `mark` on and not freed, listed as at exit\n// (the first line names them a case's): a property's case, or a fuzz run,\n// leaks them (std::test); their count.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn check_alloc_leaks_since(mark: usize) -> usize {\n    let took = check_lock();\n    let mut live: usize = 0;\n    // UNSAFE: the checker's statics and table. SAFETY: under the lock;\n    // blocks below CHECK_COUNT.\n    unsafe {\n        let mut bytes: usize = 0;\n        let mut b = mark;\n        while b < CHECK_COUNT {\n            if (*check_block(b)).state == CHECK_LIVE_BLOCK {\n                live += 1;\n                bytes += (*check_block(b)).size;\n            }\n            b += 1;\n        }\n");
    buf_str(out, c"        if live > 0 {\n            let mut m = CheckMsg::new();\n            m.text(\"check-alloc: \");\n            m.int(live);\n            m.text(if live == 1 { \" block\" } else { \" blocks\" });\n            m.text(\" of Gpa not freed by the case (\");\n            m.int(bytes);\n            m.text(\" bytes):\");\n            m.out();\n            let mut shown: usize = 0;\n            b = mark;\n            while b < CHECK_COUNT {\n                if (*check_block(b)).state == CHECK_LIVE_BLOCK && shown < 20 {\n                    let mut line = CheckMsg::new();\n                    line.text(\"  \");\n                    check_describe(&mut line, b);\n                    line.out();\n                    shown += 1;\n                }\n                b += 1;\n            }\n            CHECK_LISTED = CHECK_CHANGES;\n        }\n    }\n    check_unlock(took);\n    live\n}\n\n// (--check-unsafe with --check-alloc) The access of size bytes at p:\n// false when p is no memory of the checking allocator, true when it is in\n// bounds of a live block; else the program stops.\n// UNSAFE: site must be null or a C string.\n// SAFETY: a contract on the caller: the checking mode's runtime passes\n// the site literal the compiler wrote.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub unsafe fn check_alloc_access(p: u64, size: u64, site: *const u8) -> bool {\n    let took = check_lock();\n    let mut inside = false;\n    let found = check_find(p as usize, &mut inside);\n    if !inside {\n        check_unlock(took);\n        return false;\n    }\n    let mut m = CheckMsg::new();\n    // UNSAFE: block b of the table. SAFETY: under the lock; b from\n    // check_find, below CHECK_COUNT.\n    unsafe {\n        match found {\n            Option::Some(b) => {\n                let k = check_block(b);\n                if (*k).state == CHECK_LIVE_BLOCK {\n                    if p as usize + size as usize <= (*k).start + (*k).size {\n");
    buf_str(out, c"                        check_unlock(took);\n                        return true;\n                    }\n                    m.text(\"unsafe access out of bounds: \");\n                } else {\n                    m.text(\"unsafe access after free: \");\n                }\n                m.int(size as usize);\n                m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n                m.text(\"offset \");\n                m.int(p as usize - (*k).start);\n                m.text(\" of \");\n                check_describe(&mut m, b);\n            }\n            Option::None => {\n                m.text(\"unsafe access outside every block: \");\n                m.int(size as usize);\n                m.text(if size == 1 { \" byte at \" } else { \" bytes at \" });\n                m.hex(p as usize);\n            }\n        }\n    }\n    m.text(\"\\n --> \");\n    m.site(site);\n    check_stop(&mut m)\n}\n");
}

// (0.27.2.1) the target's system, std::__sys (front/stdalloc.vl: std_tail)
pub fn std_sys_source(out: i64, linux: bool) {
    if linux {
        buf_str(out, c"// The target's system for std (Linux): rt/sys_macos.vl's functions, as\n// the C library here has them (front/stdalloc.vl: std_tail).\n//\n// Two Linux targets read this file: aarch64-linux and x86_64-linux. A\n// number here is both's (the kernel's generic ABI, glibc's common\n// headers) unless its line says whose it is; one that differs is chosen\n// by x86_64() below. Checked against both (0.28.0): the futex system\n// call's number (differs), O_DIRECTORY (differs: see it), struct stat's\n// st_mode (differs); the same on both: O_CREAT, O_TRUNC, O_APPEND, O_EXCL,\n// O_CLOEXEC, O_NONBLOCK, O_NOCTTY, MAP_ANON, MAP_NORESERVE,\n// CLOCK_MONOTONIC, the errno values, the signal numbers (1 to 31),\n// TIOCSWINSZ, TIOCGWINSZ, TIOCSCTTY, PATH_MAX, struct dirent's offsets,\n// struct stat's st_size (48) and st_mtim (88).\n\n// Whether the build is for x86_64 (a constant: sse2 is that target's\n// baseline, and no feature of aarch64).\n#[effects()]\nfn x86_64() -> bool {\n    crate::arch::has(\"sse2\")\n}\n\n// /proc/self/cmdline, read once into these: its NULs end each argument.\nstatic mut SYS_ARG_TEXT: [u8; 131072] = [0; 131072];\nstatic mut SYS_ARG_PTRS: [usize; 4097] = [0; 4097];\nstatic mut SYS_ARG_COUNT: i64 = -1;\n\n// UNSAFE: C. SAFETY: POSIX's prototypes (open variadic, as declared).\nextern \"C\" {\n    #[link_name = \"open\"]\n    fn sys_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"read\"]\n    fn sys_c_read(fd: i32, buf: *mut u8, n: usize) -> isize;\n    #[link_name = \"close\"]\n    fn sys_c_close(fd: i32) -> i32;\n    #[link_name = \"environ\"]\n    static mut sys_c_environ: *const *const u8;\n}\n\n// The program's arguments: argc, and argv, NUL-ended C strings valid for\n// the whole program. Linux: /proc/self/cmdline, read once (up to 128 KB\n// and 4096 arguments) into the statics above.\n#[effects(io, static, panic, diverge, unsafe)]\npub fn args() -> (usize, *const *const u8) {\n");
        buf_str(out, c"    // UNSAFE: the statics, written once on the first call.\n    // SAFETY: the first call happens on the main thread before any other\n    // reads them (std::env::args is called from main's thread first, as\n    // MVS's sys_args assumes); reads stay in the arrays' bounds (checked).\n    unsafe {\n        if SYS_ARG_COUNT < 0 {\n            SYS_ARG_COUNT = 0;\n            let mut len: usize = 0;\n            let fd = sys_c_open(\"/proc/self/cmdline\\0\".as_ptr(), 0);\n            if fd >= 0 {\n                loop {\n                    let room = 131071 - len;\n                    let p: *mut u8 = (&raw mut SYS_ARG_TEXT) as *mut u8;\n                    let n = sys_c_read(fd, p.add(len), room);\n                    if n <= 0 {\n                        break;\n                    }\n                    len += n as usize;\n                }\n                let _ = sys_c_close(fd);\n            }\n            let base: *const u8 = (&raw const SYS_ARG_TEXT) as *const u8;\n            let mut start: usize = 0;\n            let mut i: usize = 0;\n            while i < len {\n                if *base.add(i) == 0 && SYS_ARG_COUNT < 4096 {\n                    SYS_ARG_PTRS[SYS_ARG_COUNT as usize] = base.add(start) as usize;\n                    SYS_ARG_COUNT += 1;\n                    start = i + 1;\n                }\n                i += 1;\n            }\n        }\n        let q: *const usize = (&raw const SYS_ARG_PTRS) as *const usize;\n        (SYS_ARG_COUNT as usize, q as *const *const u8)\n    }\n}\n\n// C's environment: a null-ended array of NUL-ended `NAME=value` strings,\n// as it is now (setenv may replace it). Linux: the C library's environ.\n#[effects(static, unsafe)]\npub fn environ() -> *const *const u8 {\n    // UNSAFE: reads the C library's static environ.\n    // SAFETY: set before main; a read of a pointer-sized static (a\n    // concurrent setenv is excluded by set_var's contract).\n    unsafe { sys_c_environ }\n}\n\n");
        buf_str(out, c"// C's CLOCK_MONOTONIC, std::time::Instant's clock.\npub const CLOCK_MONOTONIC: i32 = 1;\n\n// (0.27.6) The system: 0 macOS, 1 Linux, as MVS's std::TARGET_OS\n// (std::TARGET_OS, std_tail).\npub const TARGET_OS: i64 = 1;\n\n// (0.27.6) mmap's flags, <sys/mman.h>'s: an anonymous mapping, and one\n// that reserves no swap (base's sources' region,\n// docs/design/src-buffer.md).\npub const MAP_ANON: i32 = 0x20;\npub const MAP_NORESERVE: i32 = 0x4000;\n\n// std::fs's numbers (<bits/fcntl-linux.h> on aarch64, <errno.h>,\n// <linux/limits.h>).\npub const O_CREAT: i32 = 0x40;\npub const O_TRUNC: i32 = 0x200;\npub const O_APPEND: i32 = 0x400;\npub const O_EXCL: i32 = 0x80;\npub const O_CLOEXEC: i32 = 0x80000;\npub const ENAMETOOLONG: i32 = 36;\npub const PATH_MAX: usize = 4096;\n// struct dirent: d_type's offset, d_name's (glibc).\npub const DIRENT_TYPE: usize = 18;\npub const DIRENT_NAME: usize = 19;\n\n// UNSAFE: C. SAFETY: errno.h's prototype: this thread's errno's address.\nextern \"C\" {\n    #[link_name = \"__errno_location\"]\n    fn sys_c_errno_location() -> *mut i32;\n}\n\n// This thread's errno, for a call that says \"failed\" only through it\n// (readdir).\n#[effects(static, unsafe)]\npub fn errno_location() -> *mut i32 {\n    // UNSAFE: C. SAFETY: __errno_location takes nothing and returns a\n    // valid pointer.\n    unsafe { sys_c_errno_location() }\n}\n\n// What std::fs reads of a struct stat (glibc: st_mode a u32 at byte 16 on\n// aarch64, at byte 24 on x86_64, where st_nlink is a u64 before it; on\n// both st_size at 48, st_mtim at 88), from the words stat wrote:\n// (st_mode, st_size, mtime's seconds, its nanoseconds).\n#[effects()]\npub fn stat_fields(w: &[u64; 20]) -> (u32, u64, i64, i64) {\n    let mode = if x86_64() { w[3] } else { w[2] };\n    ((mode & 0xffffffff) as u32, w[6], w[11] as i64, w[12] as i64)\n}\n\n// A signal's name, as std::process's ExitStatus prints it (<bits/signum-generic.h>);\n// \"\" for a number this system does not name.\n");
        buf_str(out, c"#[effects()]\npub fn signal_name(sig: i32) -> &'static str {\n    match sig {\n        1 => \"SIGHUP\",\n        2 => \"SIGINT\",\n        3 => \"SIGQUIT\",\n        4 => \"SIGILL\",\n        5 => \"SIGTRAP\",\n        6 => \"SIGABRT\",\n        7 => \"SIGBUS\",\n        8 => \"SIGFPE\",\n        9 => \"SIGKILL\",\n        10 => \"SIGUSR1\",\n        11 => \"SIGSEGV\",\n        12 => \"SIGUSR2\",\n        13 => \"SIGPIPE\",\n        14 => \"SIGALRM\",\n        15 => \"SIGTERM\",\n        16 => \"SIGSTKFLT\",\n        17 => \"SIGCHLD\",\n        18 => \"SIGCONT\",\n        19 => \"SIGSTOP\",\n        20 => \"SIGTSTP\",\n        21 => \"SIGTTIN\",\n        22 => \"SIGTTOU\",\n        23 => \"SIGURG\",\n        24 => \"SIGXCPU\",\n        25 => \"SIGXFSZ\",\n        26 => \"SIGVTALRM\",\n        27 => \"SIGPROF\",\n        28 => \"SIGWINCH\",\n        29 => \"SIGIO\",\n        30 => \"SIGPWR\",\n        31 => \"SIGSYS\",\n        _ => \"\",\n    }\n}\n\n// (0.28.0) std::sys's numbers, as MVS's std::sys had them (its SYS_*\n// constants): <fcntl.h>, <errno.h>, <signal.h>, <asm-generic/ioctls.h>.\npub const O_NONBLOCK: i32 = 0x800;\npub const O_NOCTTY: i32 = 0x100;\n// (0o40000, 0x4000, on aarch64; 0o200000, 0x10000, on x86_64. X86_64 is 1\n// there and 0 on aarch64: a constant cannot call x86_64(), so the\n// compiler writes it before this file, front/stdalloc.vl: std_tail. std\n// itself does not use it, std::sys gives it to programs as\n// SYS_O_DIRECTORY)\npub const O_DIRECTORY: i32 = 0x4000 + X86_64 * 0xc000;\npub const EAGAIN: i32 = 11;\npub const ENOTEMPTY: i32 = 39;\npub const ETIMEDOUT: i32 = 110;\npub const ENOSYS: i32 = 38;\npub const ENOTSUP: i32 = 95;\npub const ELOOP: i32 = 40;\npub const SIGCHLD: i32 = 17;\npub const TIOCSWINSZ: u64 = 0x5414;\npub const TIOCGWINSZ: u64 = 0x5413;\npub const TIOCSCTTY: u64 = 0x540e;\n\n// UNSAFE: C. SAFETY: string.h's prototype of the XSI strerror_r\n// (__xpg_strerror_r): it writes at most n bytes, its NUL included, at buf.\n");
        buf_str(out, c"extern \"C\" {\n    #[link_name = \"__xpg_strerror_r\"]\n    #[effects()]\n    fn sys_c_strerror_r(e: i32, buf: *mut u8, n: usize) -> i32;\n}\n\n// C's message for errno e, into buf (NUL-ended, cut to fit): 0, or an\n// errno (std::sys::sys_strerror_into calls it).\n// UNSAFE: C writes through a raw pointer.\n// SAFETY: (the caller's) buf points to n writable bytes.\npub unsafe fn strerror_r(e: i32, buf: *mut u8, n: usize) -> i32 {\n    sys_c_strerror_r(e, buf, n)\n}\n\n// Waiting on a 32-bit word (std::sync's locks): the futex system call,\n// FUTEX_WAIT_PRIVATE (128) and FUTEX_WAKE_PRIVATE (129), the same on both\n// targets. The call's number is not: 98 on aarch64 (the kernel's generic\n// table, asm-generic/unistd.h), 202 on x86_64 (syscall_64.tbl).\n#[effects()]\nfn futex_number() -> i64 {\n    if x86_64() { 202 } else { 98 }\n}\n\n// UNSAFE: C. SAFETY: syscall(long, ...): seven words, in registers as for\n// the variadic call. Its list is the futex call's (the checker does not\n// know `syscall`): it waits or wakes, as macOS's __ulock_wait and\n// __ulock_wake; no memory, no io.\nextern \"C\" {\n    #[link_name = \"syscall\"]\n    #[effects(sync)]\n    fn sys_c_futex(n: i64, addr: *mut u32, op: i64, val: i64, t: *const u8, a: i64, b: i64) -> i64;\n}\n\n// Sleeps while *addr is `expected`, or until woken (spuriously too).\n// UNSAFE: the system reads a raw address.\n// SAFETY: (the caller's) addr is a live, 4-aligned u32.\npub unsafe fn futex_wait(addr: *mut u32, expected: u32) {\n    sys_c_futex(futex_number(), addr, 128, expected as i64, 0 as *const u8, 0, 0);\n}\n\n// Wakes one thread sleeping on addr, or all.\n// UNSAFE: the system takes a raw address.\n// SAFETY: (the caller's) addr is a live u32 (nothing is read through it).\npub unsafe fn futex_wake(addr: *mut u32, all: bool) {\n    sys_c_futex(futex_number(), addr, 129, if all { 2147483647 } else { 1 }, 0 as *const u8, 0, 0);\n}\n");
    } else {
        buf_str(out, c"// The target's system for std (macOS): what differs between the C\n// libraries. Not a module of std's tree: compiler/std/embed.sh\n// embeds it and rt/sys_linux.vl as std_sys_source, and the\n// compiler's tail (front/stdalloc.vl: std_tail) puts the target's in\n// `std::__sys`. std::env calls these.\n\n// UNSAFE: C. SAFETY: crt_externs.h's prototypes.\nextern \"C\" {\n    #[link_name = \"_NSGetArgc\"]\n    fn sys_c_argc() -> *mut i32;\n    #[link_name = \"_NSGetArgv\"]\n    fn sys_c_argv() -> *mut *mut *mut u8;\n    #[link_name = \"_NSGetEnviron\"]\n    fn sys_c_environ() -> *mut *mut *mut u8;\n}\n\n// The program's arguments: argc, and argv, crt's NUL-ended C strings,\n// valid for the whole program. macOS: crt's own, which _NSGetArgc and\n// _NSGetArgv point to.\npub fn args() -> (usize, *const *const u8) {\n    // UNSAFE: reads crt's argc and argv through the pointers it gives.\n    // SAFETY: crt sets both before main and keeps them for the program;\n    // the pointers are to its own statics.\n    unsafe { (*sys_c_argc() as usize, *sys_c_argv() as *const *const u8) }\n}\n\n// C's environment: a null-ended array of NUL-ended `NAME=value` strings,\n// as it is now (setenv may replace it). macOS: crt's, through\n// _NSGetEnviron.\npub fn environ() -> *const *const u8 {\n    // UNSAFE: reads crt's environ through the pointer it gives.\n    // SAFETY: the pointer is to crt's own static, set before main.\n    unsafe { *sys_c_environ() as *const *const u8 }\n}\n\n// C's CLOCK_MONOTONIC, std::time::Instant's clock.\npub const CLOCK_MONOTONIC: i32 = 6;\n\n// (0.27.6) The system: 0 macOS, 1 Linux, as MVS's std::TARGET_OS\n// (std::TARGET_OS, std_tail).\npub const TARGET_OS: i64 = 0;\n\n// (0.27.6) mmap's flags, <sys/mman.h>'s: an anonymous mapping, and one\n// that reserves no swap (base's sources' region,\n// docs/design/src-buffer.md).\npub const MAP_ANON: i32 = 0x1000;\npub const MAP_NORESERVE: i32 = 0x40;\n\n");
        buf_str(out, c"// std::fs's numbers (<sys/fcntl.h>, <sys/errno.h>, <sys/syslimits.h>).\npub const O_CREAT: i32 = 0x200;\npub const O_TRUNC: i32 = 0x400;\npub const O_APPEND: i32 = 0x8;\npub const O_EXCL: i32 = 0x800;\npub const O_CLOEXEC: i32 = 0x1000000;\npub const ENAMETOOLONG: i32 = 63;\npub const PATH_MAX: usize = 1024;\n// struct dirent: d_type's offset, d_name's (<sys/dirent.h>, 64-bit inodes).\npub const DIRENT_TYPE: usize = 20;\npub const DIRENT_NAME: usize = 21;\n\n// UNSAFE: C. SAFETY: errno.h's prototype: this thread's errno's address.\nextern \"C\" {\n    #[link_name = \"__error\"]\n    fn sys_c_error() -> *mut i32;\n}\n\n// This thread's errno, for a call that says \"failed\" only through it\n// (readdir).\npub fn errno_location() -> *mut i32 {\n    // UNSAFE: C. SAFETY: __error takes nothing and returns a valid pointer.\n    unsafe { sys_c_error() }\n}\n\n// What std::fs reads of a struct stat (arm64, 64-bit inodes: st_mode a\n// u16 at byte 4, st_mtimespec at 48, st_size at 96), from the words stat\n// wrote: (st_mode, st_size, mtime's seconds, its nanoseconds).\n#[effects()]\npub fn stat_fields(w: &[u64; 20]) -> (u32, u64, i64, i64) {\n    (((w[0] >> 32) & 0xffff) as u32, w[12], w[6] as i64, w[7] as i64)\n}\n\n// A signal's name, as std::process's ExitStatus prints it (<sys/signal.h>);\n// \"\" for a number this system does not name.\n#[effects()]\npub fn signal_name(sig: i32) -> &'static str {\n    match sig {\n        1 => \"SIGHUP\",\n        2 => \"SIGINT\",\n        3 => \"SIGQUIT\",\n        4 => \"SIGILL\",\n        5 => \"SIGTRAP\",\n        6 => \"SIGABRT\",\n        7 => \"SIGEMT\",\n        8 => \"SIGFPE\",\n        9 => \"SIGKILL\",\n        10 => \"SIGBUS\",\n        11 => \"SIGSEGV\",\n        12 => \"SIGSYS\",\n        13 => \"SIGPIPE\",\n        14 => \"SIGALRM\",\n        15 => \"SIGTERM\",\n        16 => \"SIGURG\",\n        17 => \"SIGSTOP\",\n        18 => \"SIGTSTP\",\n        19 => \"SIGCONT\",\n        20 => \"SIGCHLD\",\n");
        buf_str(out, c"        21 => \"SIGTTIN\",\n        22 => \"SIGTTOU\",\n        23 => \"SIGIO\",\n        24 => \"SIGXCPU\",\n        25 => \"SIGXFSZ\",\n        26 => \"SIGVTALRM\",\n        27 => \"SIGPROF\",\n        28 => \"SIGWINCH\",\n        29 => \"SIGINFO\",\n        30 => \"SIGUSR1\",\n        31 => \"SIGUSR2\",\n        _ => \"\",\n    }\n}\n\n// (0.28.0) std::sys's numbers, as MVS's std::sys had them (its SYS_*\n// constants): <sys/fcntl.h>, <sys/errno.h>, <sys/signal.h>, <sys/ttycom.h>.\npub const O_NONBLOCK: i32 = 0x4;\npub const O_NOCTTY: i32 = 0x20000;\npub const O_DIRECTORY: i32 = 0x100000;\npub const EAGAIN: i32 = 35;\npub const ENOTEMPTY: i32 = 66;\npub const ETIMEDOUT: i32 = 60;\npub const ENOSYS: i32 = 78;\npub const ENOTSUP: i32 = 45;\npub const ELOOP: i32 = 62;\npub const SIGCHLD: i32 = 20;\npub const TIOCSWINSZ: u64 = 0x80087467;\npub const TIOCGWINSZ: u64 = 0x40087468;\npub const TIOCSCTTY: u64 = 0x20007461;\n\n// UNSAFE: C. SAFETY: string.h's prototype of the XSI strerror_r\n// (strerror_r): it writes at most n bytes, its NUL included, at buf.\nextern \"C\" {\n    #[link_name = \"strerror_r\"]\n    fn sys_c_strerror_r(e: i32, buf: *mut u8, n: usize) -> i32;\n}\n\n// C's message for errno e, into buf (NUL-ended, cut to fit): 0, or an\n// errno (std::sys::sys_strerror_into calls it).\n// UNSAFE: C writes through a raw pointer.\n// SAFETY: (the caller's) buf points to n writable bytes.\npub unsafe fn strerror_r(e: i32, buf: *mut u8, n: usize) -> i32 {\n    sys_c_strerror_r(e, buf, n)\n}\n\n// Waiting on a 32-bit word (std::sync's locks): __ulock_wait with\n// UL_COMPARE_AND_WAIT | ULF_NO_ERRNO, __ulock_wake (ULF_WAKE_ALL for all).\n// UNSAFE: C. SAFETY: xnu's prototypes (bsd/sys/ulock.h).\nextern \"C\" {\n    #[link_name = \"__ulock_wait\"]\n    fn sys_c_ulock_wait(op: u32, addr: *mut u8, value: u64, timeout_us: u32) -> i32;\n    #[link_name = \"__ulock_wake\"]\n    fn sys_c_ulock_wake(op: u32, addr: *mut u8, value: u64) -> i32;\n}\n\n");
        buf_str(out, c"// Sleeps while *addr is `expected`, or until woken (spuriously too).\n// UNSAFE: the system reads a raw address.\n// SAFETY: (the caller's) addr is a live, 4-aligned u32.\npub unsafe fn futex_wait(addr: *mut u32, expected: u32) {\n    sys_c_ulock_wait(0x01000001, addr as *mut u8, expected as u64, 0);\n}\n\n// Wakes one thread sleeping on addr, or all.\n// UNSAFE: the system takes a raw address.\n// SAFETY: (the caller's) addr is a live u32 (nothing is read through it).\npub unsafe fn futex_wake(addr: *mut u32, all: bool) {\n    sys_c_ulock_wake(if all { 0x01000101 } else { 0x01000001 }, addr as *mut u8, 0);\n}\n");
    }
}
