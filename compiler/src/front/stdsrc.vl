};\n");
    buf_str(out, c"        BindGroup { items: [empty; 16], count: 0 }\n    }\n\n    fn bind_group_buffer(g: &mut BindGroup, b: Binding, buf: &Buffer, offset: i64, size: i64) {\n        g.items[g.count as usize] = bound(BIND_BUFFER, b, buf.raw.ptr, offset as u64);\n        g.count += 1;\n    }\n\n    fn bind_group_texture(g: &mut BindGroup, b: Binding, v: &TextureView) {\n        g.items[g.count as usize] = bound(BIND_TEXTURE, b, v.raw.ptr, 0);\n        g.count += 1;\n    }\n\n    fn bind_group_sampler(g: &mut BindGroup, b: Binding, s: &Sampler) {\n        g.items[g.count as usize] = bound(BIND_SAMPLER, b, s.raw.ptr, 0);\n        g.count += 1;\n    }\n\n    fn begin(d: &Device) -> CommandBuffer {\n        begin_on(d.queue.r())\n    }\n\n    fn copy_buffer(cb: &mut CommandBuffer, src: &Buffer, src_offset: i64, dst: &Buffer,\n        dst_offset: i64, size: i64) {\n        blit(cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(src.raw.r(),\n            src_offset as u64, dst.raw.r(), dst_offset as u64, size as u64);\n    }\n\n    fn copy_texture_to_buffer(cb: &mut CommandBuffer, src: &Texture, layer: i64, x: i64, y: i64,\n        w: i64, h: i64, dst: &Buffer, offset: i64, bytes_per_row: i64) {\n        blit(cb).copy_texture_to_buffer(src.raw.r(), layer as u64, 0, origin3(x, y, 0),\n            size3(w, h, 1), dst.raw.r(), offset as u64, bytes_per_row as u64,\n            (bytes_per_row * h) as u64);\n    }\n\n    fn copy_buffer_to_texture(cb: &mut CommandBuffer, src: &Buffer, offset: i64, bytes_per_row: i64,\n        dst: &Texture, layer: i64, x: i64, y: i64, w: i64, h: i64) {\n        blit(cb).copy_buffer_to_texture(src.raw.r(), offset as u64, bytes_per_row as u64,\n            (bytes_per_row * h) as u64, size3(w, h, 1), dst.raw.r(), layer as u64, 0,\n            origin3(x, y, 0));\n    }\n\n    fn begin_compute(cb: &mut CommandBuffer) -> ComputeEncoder {\n        end_blit(cb);\n        let raw = cb.cb.r();\n");
    buf_str(out, c"        let e = crate::objc::pool(|| match raw.compute_command_encoder() {\n            Some(e) => e.retain(),\n            None => Id::<MTLComputeCommandEncoder>::nil(),\n        });\n        ComputeEncoder { enc: e, workgroup: size3(1, 1, 1) }\n    }\n\n    fn compute_set_pipeline(e: &mut ComputeEncoder, p: &ComputePipeline) {\n        e.enc.r().set_compute_pipeline_state(p.raw.r());\n        e.workgroup = p.workgroup;\n    }\n\n    fn compute_set_bind_group(e: &mut ComputeEncoder, g: &BindGroup) {\n        let enc = e.enc.r();\n        for i in 0..g.count {\n            apply_compute(enc, g.items[i as usize]);\n        }\n    }\n\n    fn dispatch(e: &mut ComputeEncoder, x: i64, y: i64, z: i64) {\n        e.enc.r().dispatch_threadgroups_threads_per_threadgroup(size3(x, y, z), e.workgroup);\n    }\n\n    fn compute_set_bytes(e: &mut ComputeEncoder, bytes: &[u8], slot: i64) {\n        // UNSAFE: setBytes:length:atIndex: takes the bytes as a raw pointer.\n        // SAFETY: bytes.as_ptr() is valid for bytes.len() bytes, the length passed, for the call;\n        // Metal copies them before it returns.\n        unsafe {\n            e.enc\n                .r()\n                .set_bytes_length_at_index(bytes.as_ptr() as *mut u8, bytes.len() as u64,\n                    slot as u64);\n        }\n    }\n\n    fn end_compute(e: &mut ComputeEncoder) {\n        e.enc.r().end_encoding();\n        e.enc = Id::<MTLComputeCommandEncoder>::nil();\n    }\n\n    fn submit(q: &mut Queue, cb: &mut CommandBuffer) {\n        end_blit(cb);\n        cb.cb.r().commit();\n        q.last = mem::replace(&mut cb.cb, Id::<MTLCommandBuffer>::nil());\n    }\n\n    fn write_buffer(q: &mut Queue, b: &Buffer, offset: i64, data: &[u8]) {\n        if data.len() == 0 { return; }\n        let idle = q.last.is_nil()\n            || q.last.r().status() >= bindings::MTLCommandBufferStatusCompleted;\n        if idle {\n");
    buf_str(out, c"            // UNSAFE: a copy into the MTLBuffer's shared memory, reached by its raw pointer.\n            // SAFETY: Queue::write_buffer requires offset >= 0 and offset + data.len() <= size,\n            // so the range is inside the buffer b.raw keeps; no submitted work is reading it\n            // (idle); data is another allocation, so they do not overlap.\n            unsafe {\n                memcpy(b.ptr.add(offset as usize), data.as_ptr(), data.len() as u64);\n            }\n            return;\n        }\n        // in flight: a staging copy, ordered on the queue\n        let dev = q.q.r().device();\n        // UNSAFE: newBufferWithBytes:length:options: takes the bytes as a raw pointer.\n        // SAFETY: data.as_ptr() is valid for data.len() bytes, the length passed; Metal copies them\n        // into the new buffer before it returns.\n        let staging = match unsafe {\n            dev.new_buffer_with_bytes_length_options(data.as_ptr() as *mut u8, data.len() as u64,\n                bindings::MTLResourceStorageModeShared)\n        } {\n            Some(s) => s,\n            None => return,\n        };\n        let mut cb = begin_on(q.q.r());\n        blit(&mut cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(staging.r(),\n            0, b.raw.r(), offset as u64, data.len() as u64);\n        Metal::submit(q, &mut cb);\n    }\n\n    fn write_texture(q: &mut Queue, t: &Texture, layer: i64, x: i64, y: i64, w: i64, h: i64,\n        data: &[u8], bytes_per_row: i64) {\n        let dev = q.q.r().device();\n        // UNSAFE: newBufferWithBytes:length:options: takes the bytes as a raw pointer.\n        // SAFETY: data.as_ptr() is valid for data.len() bytes, the length passed; Metal copies them;\n        // Queue::write_texture asserted that data covers the region the blit below reads.\n        let staging = match unsafe {\n            dev.new_buffer_with_bytes_length_options(data.as_ptr() as *mut u8, data.len() as u64,\n");
    buf_str(out, c"                bindings::MTLResourceStorageModeShared)\n        } {\n            Some(s) => s,\n            None => return,\n        };\n        let mut cb = begin_on(q.q.r());\n        blit(&mut cb).copy_buffer_to_texture(staging.r(), 0, bytes_per_row as u64,\n            (bytes_per_row * h) as u64, size3(w, h, 1), t.raw.r(), layer as u64, 0,\n            origin3(x, y, 0));\n        Metal::submit(q, &mut cb);\n    }\n\n    fn queue_wait_idle(q: &mut Queue) -> bool {\n        if q.last.is_nil() { return true; }\n        let last = q.last.r();\n        last.wait_until_completed();\n        last.status() == bindings::MTLCommandBufferStatusCompleted\n    }\n\n    // (0.25.4) The command buffer keeps its MTLCommandBuffer (a retain),\n    // whose GPUStartTime and GPUEndTime are the host clock's seconds once\n    // it has completed.\n    fn submit_timed(q: &mut Queue, cb: &mut CommandBuffer) {\n        end_blit(cb);\n        cb.cb.r().commit();\n        q.last = cb.cb.clone();\n    }\n\n    fn gpu_times(cb: &mut CommandBuffer) -> Option<(u64, u64)> {\n        if cb.cb.is_nil() { return None; }\n        let c = cb.cb.r();\n        c.wait_until_completed();\n        if c.status() != bindings::MTLCommandBufferStatusCompleted { return None; }\n        let start = c.gpu_start_time();\n        let end = c.gpu_end_time();\n        if start <= 0.0 || end < start { return None; }\n        Some(((start * 1.0e9) as u64, (end * 1.0e9) as u64))\n    }\n}\n\n// ---- GPU on Metal: hal::Render (0.22) ----\n\nimpl Render<Metal> for Metal {\n    type RenderPipeline = RenderPipeline;\n    type RenderEncoder = RenderEncoder;\n    type PassDesc = PassDesc<'_>;\n    type Surface = Surface;\n    type Frame = Frame;\n\n    fn create_render_pipeline(d: &Device, vs: &Shader, vs_entry: EntryPoint<'_>, fs: &Shader,\n        fs_entry: EntryPoint<'_>, has_fs: bool, state: PipelineState,\n        err: &mut String<Gpa>) -> Option<RenderPipeline> {\n        let vf = match function(vs, vs_entry, err) {\n");
    buf_str(out, c"            Some(f) => f,\n            None => return None,\n        };\n        let mut ff = Id::<MTLFunction>::nil();\n        if has_fs {\n            ff = match function(fs, fs_entry, err) {\n                Some(f) => f,\n                None => return None,\n            };\n        }\n        let pd = MTLRenderPipelineDescriptor::new();\n        let p = pd.r();\n        p.set_vertex_function(Some(vf.r()));\n        if has_fs { p.set_fragment_function(Some(ff.r())); }\n        let colors = p.color_attachments();\n        for i in 0..state.target_count {\n            let t = state.targets[i as usize];\n            let c = colors.object_at_indexed_subscript(i as u64);\n            c.set_pixel_format(pixel_format(t.format));\n            c.set_write_mask(t.write_mask as u64);\n            match t.blend {\n                Some(b) => {\n                    c.set_blending_enabled(true);\n                    c.set_source_rgb_blend_factor(blend_factor(b.color.src));\n                    c.set_destination_rgb_blend_factor(blend_factor(b.color.dst));\n                    c.set_rgb_blend_operation(blend_op(b.color.op));\n                    c.set_source_alpha_blend_factor(blend_factor(b.alpha.src));\n                    c.set_destination_alpha_blend_factor(blend_factor(b.alpha.dst));\n                    c.set_alpha_blend_operation(blend_op(b.alpha.op));\n                }\n                None => c.set_blending_enabled(false),\n            }\n        }\n        let vd = MTLVertexDescriptor::new();\n        if state.buffer_count > 0 {\n            let attrs = vd.r().attributes();\n            let layouts = vd.r().layouts();\n            for i in 0..state.buffer_count {\n                let l = state.buffers[i as usize];\n                let index = vertex_buffer_index(i);\n                let lay = layouts.object_at_indexed_subscript(index);\n                lay.set_stride(l.stride as u64);\n                lay.set_step_function(if l.step\n");
    buf_str(out, c"                    == StepMode::Instance { bindings::MTLVertexStepFunctionPerInstance }\n                    else { bindings::MTLVertexStepFunctionPerVertex });\n                lay.set_step_rate(1);\n                for k in 0..l.count {\n                    let a = l.attributes[k as usize];\n                    let ad = attrs.object_at_indexed_subscript(a.location as u64);\n                    ad.set_format(vertex_format(a.format));\n                    ad.set_offset(a.offset as u64);\n                    ad.set_buffer_index(index);\n                }\n            }\n            p.set_vertex_descriptor(Some(vd.r()));\n        }\n        let mut depth = Id::<MTLDepthStencilState>::nil();\n        match state.depth {\n            Some(ds) => {\n                p.set_depth_attachment_pixel_format(pixel_format(ds.format));\n                let dd = MTLDepthStencilDescriptor::new();\n                dd.r().set_depth_compare_function(compare_function(ds.compare));\n                dd.r().set_depth_write_enabled(ds.write);\n                match d.dev.r().new_depth_stencil_state_with_descriptor(dd.r()) {\n                    Some(s) => { depth = s; }\n                    None => {}\n                }\n            }\n            None => {}\n        }\n        let _pool = crate::objc::Pool::push();\n        let mut e: *mut u8 = 0 as *mut u8;\n        // UNSAFE: the generated wrapper takes an NSError ** out-parameter as a raw pointer.\n        // SAFETY: &e is a writable *u8 slot, a local that outlives the call (as create_shader).\n        match unsafe {\n            d.dev.r().new_render_pipeline_state_with_descriptor_error(p, &raw mut e as *mut u8)\n        } {\n            Some(raw) => {\n                let primitive = match state.topology {\n                    Topology::PointList => bindings::MTLPrimitiveTypePoint,\n                    Topology::LineList => bindings::MTLPrimitiveTypeLine,\n                    Topology::LineStrip => bindings::MTLPrimitiveTypeLineStrip,\n");
    buf_str(out, c"                    Topology::TriangleList => bindings::MTLPrimitiveTypeTriangle,\n                    Topology::TriangleStrip => bindings::MTLPrimitiveTypeTriangleStrip,\n                };\n                let cull = match state.cull {\n                    Cull::None => bindings::MTLCullModeNone,\n                    Cull::Front => bindings::MTLCullModeFront,\n                    Cull::Back => bindings::MTLCullModeBack,\n                };\n                // WebGPU's clip space has y up, as Metal's: counter-clockwise\n                // is the same winding in both\n                let winding = if state.front_face\n                    == FrontFace::Ccw { bindings::MTLWindingCounterClockwise }\n                    else { bindings::MTLWindingClockwise };\n                Some(RenderPipeline {\n                    raw: raw, depth: depth, primitive: primitive, cull: cull, winding: winding,\n                })\n            }\n            None => {\n                // UNSAFE: the raw NSError ** out-value made a Ref, which no type checks.\n                // SAFETY: e is nil or the autoreleased NSError Metal stored, alive until _pool\n                // (a local of this function) drops, after push_error has read it.\n                push_error(err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"Metal rejected the render pipeline\");\n                None\n            }\n        }\n    }\n\n    fn pass_new() -> PassDesc<'static> {\n        PassDesc { raw: MTLRenderPassDescriptor::new() }\n    }\n\n    fn pass_color(p: &mut PassDesc<'_>, i: i64, v: &TextureView, load: Load, clear: Color,\n        store: bool) {\n        let a = p.raw.r().color_attachments().object_at_indexed_subscript(i as u64);\n        a.set_texture(Some(v.raw.r()));\n        a.set_load_action(load_action(load));\n        a.set_clear_color(MTLClearColor {\n            red: clear.r, green: clear.g, blue: clear.b, alpha: clear.a,\n        });\n");
    buf_str(out, c"        a.set_store_action(if store { bindings::MTLStoreActionStore }\n            else { bindings::MTLStoreActionDontCare });\n    }\n\n    fn pass_depth(p: &mut PassDesc<'_>, v: &TextureView, load: Load, clear: f64, store: bool) {\n        let a = p.raw.r().depth_attachment();\n        a.set_texture(Some(v.raw.r()));\n        a.set_load_action(load_action(load));\n        a.set_clear_depth(clear);\n        a.set_store_action(if store { bindings::MTLStoreActionStore }\n            else { bindings::MTLStoreActionDontCare });\n    }\n\n    fn begin_render(cb: &mut CommandBuffer, p: &PassDesc<'_>) -> RenderEncoder {\n        end_blit(cb);\n        let raw = cb.cb.r();\n        let desc = p.raw.r();\n        let e = crate::objc::pool(|| match raw.render_command_encoder_with_descriptor(desc) {\n            Some(e) => e.retain(),\n            None => Id::<MTLRenderCommandEncoder>::nil(),\n        });\n        RenderEncoder {\n            enc: e, primitive: bindings::MTLPrimitiveTypeTriangle, index: Id::<MTLBuffer>::nil(),\n            index_type: 0, index_size: 2, index_offset: 0,\n        }\n    }\n\n    fn render_set_pipeline(e: &mut RenderEncoder, p: &RenderPipeline) {\n        let enc = e.enc.r();\n        enc.set_render_pipeline_state(p.raw.r());\n        enc.set_cull_mode(p.cull);\n        enc.set_front_facing_winding(p.winding);\n        if !p.depth.is_nil() {\n            enc.set_depth_stencil_state(Some(p.depth.r()));\n        }\n        e.primitive = p.primitive;\n    }\n\n    fn render_set_bind_group(e: &mut RenderEncoder, g: &BindGroup) {\n        let enc = e.enc.r();\n        for i in 0..g.count {\n            apply_render(enc, g.items[i as usize]);\n        }\n    }\n\n    fn render_set_bytes(e: &mut RenderEncoder, stage: u32, bytes: &[u8], slot: i64) {\n        let enc = e.enc.r();\n        // UNSAFE: set{Vertex,Fragment}Bytes:length:atIndex: take the bytes as a raw pointer.\n");
    buf_str(out, c"        // SAFETY: bytes.as_ptr() is valid for bytes.len() bytes, the length passed, for the call;\n        // Metal copies them before it returns.\n        unsafe {\n            if stage == ShaderStage::VERTEX {\n                enc.set_vertex_bytes_length_at_index(bytes.as_ptr() as *mut u8, bytes.len() as u64,\n                    slot as u64);\n            } else {\n                enc.set_fragment_bytes_length_at_index(bytes.as_ptr() as *mut u8,\n                    bytes.len() as u64, slot as u64);\n            }\n        }\n    }\n\n    fn render_set_vertex_buffer(e: &mut RenderEncoder, slot: i64, b: &Buffer, offset: i64) {\n        e.enc\n            .r()\n            .set_vertex_buffer_offset_at_index(Some(b.raw.r()), offset as u64,\n                vertex_buffer_index(slot));\n    }\n\n    fn render_set_index_buffer(e: &mut RenderEncoder, b: &Buffer, format: IndexFormat, offset: i64) {\n        e.index = b.raw.clone();\n        e.index_type = if format == IndexFormat::Uint32 { bindings::MTLIndexTypeUInt32 }\n            else { bindings::MTLIndexTypeUInt16 };\n        e.index_size = format.size();\n        e.index_offset = offset;\n    }\n\n    fn render_set_viewport(e: &mut RenderEncoder, x: f32, y: f32, w: f32, h: f32, min_depth: f32,\n        max_depth: f32) {\n        e.enc\n            .r()\n            .set_viewport(MTLViewport {\n                originX: x as f64, originY: y as f64, width: w as f64, height: h as f64,\n                znear: min_depth as f64, zfar: max_depth as f64,\n            });\n    }\n\n    fn render_set_scissor(e: &mut RenderEncoder, x: i64, y: i64, w: i64, h: i64) {\n        e.enc\n            .r()\n            .set_scissor_rect(MTLScissorRect {\n                x: x as u64, y: y as u64, width: w as u64, height: h as u64,\n            });\n    }\n\n    fn render_set_blend_constant(e: &mut RenderEncoder, c: Color) {\n        e.enc\n            .r()\n");
    buf_str(out, c"            .set_blend_color_red_green_blue_alpha(c.r as f32, c.g as f32, c.b as f32, c.a as f32);\n    }\n\n    fn draw(e: &mut RenderEncoder, first_vertex: i64, vertices: i64, first_instance: i64,\n        instances: i64) {\n        e.enc\n            .r()\n            .draw_primitives_vertex_start_vertex_count_instance_count_base_instance(e.primitive,\n                first_vertex as u64, vertices as u64, instances as u64, first_instance as u64);\n    }\n\n    fn draw_indexed(e: &mut RenderEncoder, first_index: i64, indices: i64, base_vertex: i64,\n        first_instance: i64, instances: i64) {\n        let offset = e.index_offset + first_index * e.index_size;\n        e.enc.r().draw_indexed_primitives_index_count_index_type_index_buffer_index_buffer_offset_instance_count_base_vertex_base_instance(e.primitive, indices as u64, e.index_type, e.index.r(), offset as u64, instances as u64, base_vertex, first_instance as u64);\n    }\n\n    fn end_render(e: &mut RenderEncoder) {\n        e.enc.r().end_encoding();\n        e.enc = Id::<MTLRenderCommandEncoder>::nil();\n    }\n\n    fn create_surface(d: &Device, raw: RawSurface) -> Option<Surface> {\n        if !open_frameworks() { return None; }\n        let layer = match raw {\n            // (0.25.4) null: a scripted window's (std::window, VOLE_WINDOW_SCRIPT),\n            // offscreen like Headless\n            RawSurface::MetalLayer(p) if p == 0 as *mut u8 => {\n                crate::objc::pool(|| CAMetalLayer::layer().retain())\n            }\n            RawSurface::MetalLayer(p) => {\n                // UNSAFE: the window library's layer arrives as a raw pointer.\n                // SAFETY: RawSurface::MetalLayer holds the CAMetalLayer std::window made for a\n                // live window (its documented meaning); the retain keeps it from here on.\n                let r = unsafe { Ref::<CAMetalLayer>::from_global(p) };\n                r.retain()\n            }\n");
    buf_str(out, c"            // an unattached layer: its drawables are offscreen\n            RawSurface::Headless => crate::objc::pool(|| CAMetalLayer::layer().retain()),\n        };\n        if layer.is_nil() { return None; }\n        layer.r().set_device(Some(d.dev.r()));\n        Some(Surface { layer: layer })\n    }\n\n    fn configure(s: &mut Surface, d: &Device, width: i64, height: i64, format: Format, vsync: bool) {\n        let l = s.layer.r();\n        l.set_device(Some(d.dev.r()));\n        l.set_pixel_format(pixel_format(format));\n        l.set_drawable_size(CGSize { width: width as f64, height: height as f64 });\n        l.set_framebuffer_only(false);\n        l.set_maximum_drawable_count(3);\n        l.set_display_sync_enabled(vsync);\n    }\n\n    fn next_frame(s: &mut Surface) -> Option<(Frame, Texture)> {\n        let l = s.layer.r();\n        let _pool = crate::objc::Pool::push();\n        match l.next_drawable() {\n            Some(dr) => {\n                let tex = dr.texture().retain();\n                Some((Frame { drawable: dr.retain() }, Texture { raw: tex }))\n            }\n            None => None,\n        }\n    }\n\n    fn present(q: &mut Queue, f: &Frame) {\n        let mut cb = begin_on(q.q.r());\n        // UNSAFE: a cast between protocols, which the table does not relate.\n        // SAFETY: CAMetalDrawable is declared `@protocol CAMetalDrawable <MTLDrawable>`, so\n        // every CAMetalDrawable is an MTLDrawable; f.drawable keeps it alive.\n        let d = unsafe { f.drawable.r().cast::<bindings::MTLDrawable>() };\n        cb.cb.r().present_drawable(d);\n        Metal::submit(q, &mut cb);\n    }\n}\n// ---- mod std::gpu::hal::metal::bindings ----\npub mod bindings {\n// Generated by tools/objcgen from compiler/std/objc/tables/metal.objc: do not edit.\n// Every prototype below is checked against the Objective-C runtime's\n// type encoding by `objcgen --check`, and every constant and struct\n");
