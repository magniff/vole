    buf_str(out, c"        // (objcgen --check); self.ptr is nil or a live NSError (Ref's invariant), and a message\n        // to nil returns zero.\n        unsafe { msg_i64(self.ptr, sel_7()) }\n    }\n\n    fn domain(self) -> Ref<'a, NSString> {\n        // UNSAFE: -domain is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSError (Ref's invariant), and a message\n        // to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot outlive\n        // the receiver that holds it.\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_8()), self) }\n    }\n}\n\n/// The Objective-C class NSException.\npub struct NSException {}\n\npub trait NSExceptionMethods<'a> {\n    // name\n    fn name(self) -> Ref<'a, NSString>;\n    // reason\n    fn reason(self) -> Option<Ref<'a, NSString>>;\n}\n\nimpl<'a> NSExceptionMethods<'a> for Ref<'a, NSException> {\n    fn name(self) -> Ref<'a, NSString> {\n        // UNSAFE: -name is sent by objc_msgSend, a C call whose types the compiler cannot see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSException (Ref's invariant), and a\n        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_9()), self) }\n    }\n\n    fn reason(self) -> Option<Ref<'a, NSString>> {\n        // UNSAFE: -reason is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSException (Ref's invariant), and a\n");
    buf_str(out, c"        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<NSString>::from_raw_opt(msg_p(self.ptr, sel_10()), self) }\n    }\n}\n\n/// The Objective-C class NSArray.\npub struct NSArray {}\n\npub trait NSArrayMethods<'a> {\n    // count\n    fn count(self) -> u64;\n    // objectAtIndex:\n    fn object_at_index(self, index: u64) -> Ref<'a, Object>;\n}\n\nimpl<'a> NSArrayMethods<'a> for Ref<'a, NSArray> {\n    fn count(self) -> u64 {\n        // UNSAFE: -count is sent by objc_msgSend, a C call whose types the compiler cannot see.\n        // SAFETY: msg_u64 is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSArray (Ref's invariant), and a message\n        // to nil returns zero.\n        unsafe { msg_u64(self.ptr, sel_11()) }\n    }\n\n    fn object_at_index(self, index: u64) -> Ref<'a, Object> {\n        // UNSAFE: -objectAtIndex: is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_p_u64 is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSArray (Ref's invariant), and a message\n        // to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot outlive\n        // the receiver that holds it.\n        unsafe { Ref::<Object>::from_raw(msg_p_u64(self.ptr, sel_12(), index), self) }\n    }\n}\n// ---- end mod std::objc::foundation ----\n}\n// ---- end mod std::objc ----\n}\n// ---- mod std::window ----\npub mod window {\n// std::window: windows and input (docs/design/terminal.md §2), winit's\n// objects with a pull-model event loop. 0.23.0 has the Cocoa backend\n// (cocoa.vl); Wayland and X11 come in 0.23.1 beside it, behind the same\n// `Backend` trait. objc.vl is the Objective-C layer the backend calls\n");
    buf_str(out, c"// until std::objc (0.22) replaces it; tables/ lists every method it\n// calls, for objcgen's runtime check. A program that uses std::window\n// links AppKit, QuartzCore, CoreFoundation, CoreGraphics and libobjc\n// (0.25: cocoa.vl's and objc.vl's extern blocks say so, `#[link]`).\n//\n// Events are pulled (D1): `app.wait()` blocks until one is ready,\n// `app.poll()` returns at once, `app.wait_timeout(ms)` waits at most that\n// long. An event is a plain value; nothing allocates per event once the\n// queue has grown to its working size. Frames come on request (D2):\n// `win.request_frame()` asks for one `Event::Frame` at the next display\n// refresh (from a timer when the display cannot show the window, 0.25.2.1),\n// and an idle application wakes up never. A watched file\n// descriptor (D3) delivers `Event::Readable` from inside `wait`, which\n// is how the terminal serves its pty before 0.21's threads.\n//\n// `App` and `Window` release their Cocoa objects when dropped; drop the\n// windows before the App. The live-resize hook is a plain `fn(*u8)` with\n// a context pointer (a closure once callbacks can borrow).\n\n// ---- Windows and input (0.23) ----\n\npub mod cocoa;\npub mod keys;\nmod objc;\nmod script;\n\nuse crate::alloc::Allocator;\nuse crate::string::String;\n\nuse keys::{KeyCode, Logical, Mods};\n\n#[derive(Clone, Copy)]\npub struct WindowId {\n    pub n: i64,\n}\n\nimpl WindowId {\n    pub fn eq(self, o: WindowId) -> bool {\n        self.n == o.n\n    }\n}\n\n// A size in physical pixels, and the scale from logical points (2.0 on\n// a Retina display).\n#[derive(Clone, Copy)]\npub struct Size {\n    pub w: i64,\n    pub h: i64,\n    pub scale: f64,\n}\n\n// A key press, repeat or release. `ime` is true when an input method\n// took the key (composition in progress before or after it): a terminal\n// does not encode it. `text_follows` is true when the key produced text,\n// delivered by the `Event::Text` right after this event (a terminal\n");
    buf_str(out, c"// sends the text, not an encoding of the key, unless it treats Option as\n// Meta).\n#[derive(Clone, Copy)]\npub struct Key {\n    pub win: WindowId,\n    pub code: KeyCode,\n    pub key: Logical,\n    pub mods: Mods,\n    pub pressed: bool,\n    pub repeat: bool,\n    pub ime: bool,\n    pub text_follows: bool,\n}\n\n// Text typed or committed by an input method, its UTF-8 bytes inline\n// (D4): a longer commit arrives as several events, never split inside a\n// character. Its text is `t.bytes[0..t.len as i64]` (0.20: a Text is\n// plain, so a method takes a copy of it and cannot return a view of its\n// bytes).\n#[derive(Clone, Copy)]\npub struct Text {\n    pub win: WindowId,\n    pub len: u8,\n    pub bytes: [u8; 30],\n}\n\n// The input method's composition changed: `app.preedit()` is its text\n// (empty: composition ended), `cursor` a byte offset in it.\n#[derive(Clone, Copy)]\npub struct Preedit {\n    pub win: WindowId,\n    pub len: i64,\n    pub cursor: i64,\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Button {\n    Left,\n    Right,\n    Middle,\n    Other(i64),\n    None,\n}\n\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum MouseAction {\n    Press,\n    Release,\n    Move,\n}\n\n// A mouse button or motion; the position is in physical pixels from the\n// window's content top-left. `clicks` counts a double (2) or triple (3)\n// click on presses.\n#[derive(Clone, Copy)]\npub struct Mouse {\n    pub win: WindowId,\n    pub action: MouseAction,\n    pub button: Button,\n    pub x: f64,\n    pub y: f64,\n    pub mods: Mods,\n    pub clicks: i64,\n}\n\n// Scrolling: `precise` deltas are in physical pixels (a trackpad);\n// otherwise in lines (a wheel). Positive dy scrolls up (content moves\n// down), as AppKit and winit report it.\n#[derive(Clone, Copy)]\npub struct Scroll {\n    pub win: WindowId,\n    pub dx: f64,\n    pub dy: f64,\n    pub precise: bool,\n    pub mods: Mods,\n}\n\n#[derive(Clone, Copy)]\npub enum Event {\n");
    buf_str(out, c"    // A frame asked for by `request_frame`: draw now.\n    Frame(WindowId),\n    Key(Key),\n    Text(Text),\n    Preedit(Preedit),\n    // The content's new size (also its first size, after `window`).\n    Resize(WindowId, Size),\n    Mouse(Mouse),\n    Scroll(Scroll),\n    // The pointer entered (true) or left the window.\n    Cursor(WindowId, bool),\n    Focus(WindowId, bool),\n    // A watched file descriptor is readable.\n    Readable(i32),\n    // The user asked to close the window (it stays open until `close`).\n    Close(WindowId),\n    // The user chose Quit (Command-Q).\n    Quit,\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Error {\n    // No window server (a headless session, ssh).\n    NoDisplay,\n    Failed(&'static str),\n}\n\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum CursorIcon {\n    Arrow,\n    Text,\n    Pointer,\n}\n\n#[derive(Clone, Copy)]\npub struct WindowDesc<'a> {\n    pub title: &'a str,\n    // Logical points.\n    pub w: i64,\n    pub h: i64,\n    pub min_w: i64,\n    pub min_h: i64,\n    pub resizable: bool,\n}\n\nimpl<'a> WindowDesc<'a> {\n    pub fn new(title: &'a str, w: i64, h: i64) -> WindowDesc<'a> {\n        WindowDesc { title: title, w: w, h: h, min_w: 100, min_h: 60, resizable: true }\n    }\n}\n\n// What each backend provides (D6). App and Window call the one the\n// target's OS has, statically.\npub trait Backend {\n    fn open_window(&mut self, desc: WindowDesc<'_>, id: WindowId) -> Result<Window, Error>;\n    fn next_event(&mut self, ms: i64) -> Option<Event>;\n    fn watch(&mut self, fd: i32) -> bool;\n    fn unwatch(&mut self, fd: i32);\n    fn clipboard_get_in<A: Allocator>(&self, a: A) -> Option<String<A>>;\n    fn clipboard_set(&self, text: &str);\n    fn preedit(&self) -> &[u8];\n    fn set_live_resize(&mut self, f: fn(*mut u8), ctx: *mut u8);\n    fn close(&mut self);\n}\n\n// The backend of an App: the window server's, or (0.25.4) a script's\n");
    buf_str(out, c"// (VOLE_WINDOW_SCRIPT, script.vl: testing without a display).\nenum Native<A: Allocator> {\n    Cocoa(cocoa::Cocoa<A>),\n    Script(script::Script<A>),\n}\n\npub struct App<A: Allocator> {\n    b: Native<A>,\n    next_id: i64,\n}\n\nimpl App<Gpa> {\n    // The application: on macOS, NSApplication without a bundle (a\n    // regular app with a Dock icon and a menu with Quit). Err(NoDisplay)\n    // when there is no window server. (0.25.4) With VOLE_WINDOW_SCRIPT\n    // set, no window server is opened and the events come from the\n    // script (script.vl; `guide window#testing-input-without-a-display`).\n    pub fn new_in(gpa: Gpa) -> Result<App<Gpa>, Error> {\n        match script::Script::from_env(gpa) {\n            Some(s) => return Ok(App { b: Native::Script(s), next_id: 1 }),\n            None => {}\n        }\n        match cocoa::Cocoa::new_in(gpa) {\n            Ok(b) => Ok(App { b: Native::Cocoa(b), next_id: 1 }),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn window(&mut self, desc: WindowDesc<'_>) -> Result<Window, Error> {\n        let id = WindowId { n: self.next_id };\n        self.next_id += 1;\n        match &mut self.b {\n            Native::Cocoa(b) => b.open_window(desc, id),\n            Native::Script(s) => {\n                s.open(desc.w, desc.h, id);\n                Ok(Window { id: id, ns: cocoa::NsWindow::none() })\n            }\n        }\n    }\n\n    fn next_event(&mut self, ms: i64) -> Option<Event> {\n        match &mut self.b {\n            Native::Cocoa(b) => b.next_event(ms),\n            Native::Script(s) => s.next_event(ms),\n        }\n    }\n\n    // The next event, waiting as long as it takes.\n    pub fn wait(&mut self) -> Result<Event, Error> {\n        loop {\n            match self.next_event(-1) {\n                Some(e) => return Ok(e),\n                None => {}\n            }\n        }\n    }\n\n    // The next event if one is ready.\n    pub fn poll(&mut self) -> Option<Event> {\n");
    buf_str(out, c"        self.next_event(0)\n    }\n\n    // The next event within `ms` milliseconds.\n    pub fn wait_timeout(&mut self, ms: i64) -> Option<Event> {\n        self.next_event(if ms < 0 { 0 } else { ms })\n    }\n\n    // Delivers `Event::Readable(fd)` whenever `fd` has data, from inside\n    // wait/poll (until `unwatch`). False if the fd cannot be watched (a\n    // scripted App watches none).\n    pub fn watch(&mut self, fd: i32) -> bool {\n        match &mut self.b {\n            Native::Cocoa(b) => b.watch(fd),\n            Native::Script(_) => false,\n        }\n    }\n\n    pub fn unwatch(&mut self, fd: i32) {\n        match &mut self.b {\n            Native::Cocoa(b) => b.unwatch(fd),\n            Native::Script(_) => {}\n        }\n    }\n\n    // The clipboard's text, in a String of `a` (a frame's ScopedArena for a\n    // paste that is sent and forgotten).\n    pub fn clipboard_get_in<A: Allocator>(&self, a: A) -> Option<String<A>> {\n        match &self.b {\n            Native::Cocoa(b) => b.clipboard_get_in(a),\n            Native::Script(_) => None,\n        }\n    }\n\n    pub fn clipboard_set(&self, text: &str) {\n        match &self.b {\n            Native::Cocoa(b) => b.clipboard_set(text),\n            Native::Script(_) => {}\n        }\n    }\n\n    // The input method's current composition (see Event::Preedit), a view\n    // valid until the next event.\n    pub fn preedit(&self) -> &[u8] {\n        match &self.b {\n            Native::Cocoa(b) => b.preedit(),\n            Native::Script(_) => b\"\",\n        }\n    }\n\n    // macOS runs a loop of its own while the user drags a window's edge,\n    // so `wait` does not return until the drag ends. `f(ctx)` is called\n    // for each size change during the drag: it can `poll` (only the\n    // queued events are returned there) and draw. The one callback of the\n    // API (terminal.md §2.1).\n    pub fn on_live_resize(&mut self, f: fn(*mut u8), ctx: *mut u8) {\n        match &mut self.b {\n");
    buf_str(out, c"            Native::Cocoa(b) => b.set_live_resize(f, ctx),\n            Native::Script(_) => {}\n        }\n    }\n}\n\n// The application's state is released with it (its windows should be\n// dropped first: they do not outlive the App).\nimpl Drop for App<Gpa> {\n    fn drop(&mut self) {\n        match &mut self.b {\n            Native::Cocoa(b) => b.close(),\n            Native::Script(_) => {}\n        }\n    }\n}\n\n// A window: its Cocoa objects, retained until it is dropped (or closed).\npub struct Window {\n    pub id: WindowId,\n    pub ns: cocoa::NsWindow,\n}\n\nimpl Window {\n    // One Event::Frame at the next refresh of the window's display.\n    // (0.25.2.1) While the display cannot show the window (the display\n    // asleep, the window covered, hidden or on another Space)\n    // the Frame comes from a timer, 10 a second, and after 3 s stderr\n    // says why once: a loop waiting for frames always gets them.\n    // (0.25.4) In a scripted App (VOLE_WINDOW_SCRIPT) the next `frames`\n    // command answers it at once.\n    pub fn request_frame(&self) {\n        if script::active() {\n            script::request_frame(self.id);\n            return;\n        }\n        self.ns.request_frame();\n    }\n\n    pub fn size(&self) -> Size {\n        if script::active() {\n            return script::size();\n        }\n        self.ns.size()\n    }\n\n    // The CAMetalLayer (on macOS) a GPU surface is made on. Null in a\n    // scripted App: std::gpu makes `RawSurface::MetalLayer` of null a\n    // headless surface.\n    pub fn raw_surface(&self) -> *mut u8 {\n        self.ns.layer\n    }\n\n    pub fn set_title(&self, t: &str) {\n        if script::active() {\n            return;\n        }\n        self.ns.set_title(t);\n    }\n\n    pub fn set_cursor(&self, c: CursorIcon) {\n        if script::active() {\n            return;\n        }\n        self.ns.set_cursor(c);\n    }\n\n    // Hides the pointer until the mouse moves (while typing).\n");
    buf_str(out, c"    pub fn hide_cursor_while_typing(&self) {\n        if script::active() {\n            return;\n        }\n        cocoa::hide_cursor_until_moved();\n    }\n\n    // Where the input method's candidate window goes: the text cursor's\n    // rectangle in physical pixels from the content's top-left.\n    pub fn set_ime_area(&self, x: f64, y: f64, w: f64, h: f64) {\n        if script::active() {\n            return;\n        }\n        self.ns.set_ime_area(x, y, w, h);\n    }\n\n    pub fn set_fullscreen(&self, on: bool) {\n        if script::active() {\n            script::set_fullscreen(on);\n            return;\n        }\n        self.ns.set_fullscreen(on);\n    }\n\n    pub fn is_fullscreen(&self) -> bool {\n        if script::active() {\n            return script::is_fullscreen();\n        }\n        self.ns.is_fullscreen()\n    }\n\n    pub fn focused(&self) -> bool {\n        if script::active() {\n            return script::focused();\n        }\n        self.ns.focused()\n    }\n\n    // Closes the window now (dropping it does the same).\n    pub fn close(&mut self) {\n        if script::active() {\n            script::closed(self.id);\n            return;\n        }\n        self.ns.close();\n    }\n}\n\nimpl Drop for Window {\n    fn drop(&mut self) {\n        self.close();\n    }\n}\n// ---- mod std::window::cocoa ----\npub mod cocoa {\n// The Cocoa backend (terminal.md §2.3, task W1): NSApplication without a\n// bundle or a nib, a runtime NSView subclass with a CAMetalLayer, events\n// drained with nextEventMatchingMask and sendEvent, NSTextInputClient for\n// input methods, CADisplayLink frames, CFFileDescriptor watches.\n//\n// Its message calls go through objc.vl's hand-typed shapes, each with\n// the selector's documented C types, and every one is listed in\n// tables/appkit.objc and tables/quartzcore.objc, which objcgen --check\n// verifies against the runtime; when std::objc lands they are generated\n// from those tables instead.\n//\n");
    buf_str(out, c"// Pitfalls of running AppKit from a plain executable, and what is done\n// about each:\n// - No bundle: the process starts as a background app with no Dock icon\n//   and no menu bar. `setActivationPolicy: Regular` makes it a regular\n//   app; `finishLaunching` must be called since `[NSApp run]` is not;\n//   then `activateIgnoringOtherApps:` (again after the first window is\n//   shown, or a terminal that launched it keeps the focus).\n// - No nib: the menu bar is built by hand (an app menu with Quit, which\n//   targets our own object, so Command-Q is an Event::Quit, not exit()).\n// - No [NSApp run]: events are pulled with\n//   nextEventMatchingMask:untilDate:inMode:dequeue: and dispatched with\n//   sendEvent:, each batch inside an autorelease pool. Run-loop sources\n//   (the display link, watched fds) fire inside nextEventMatchingMask\n//   without an NSEvent, so it would not return: they post an\n//   application-defined NSEvent to wake it, which is dropped.\n// - Key input goes through interpretKeyEvents:, which needs the view to\n//   be the first responder and to implement NSTextInputClient, including\n//   doCommandBySelector: (without it, every Return or arrow beeps).\n// - Command-key releases: NSApplication does not send keyUp: for a key\n//   pressed with Command (a known AppKit quirk); such releases are not\n//   reported.\n// - Live resize runs AppKit's own loop: windowDidResize: calls the one\n//   hook (App::on_live_resize) so the application can draw during the\n//   drag.\n// - Mouse moves need setAcceptsMouseMovedEvents: and a tracking area\n//   (enter and leave too).\n// - The display link (NSView.displayLinkWithTarget:selector:, macOS 14)\n//   runs on the main run loop in common modes: no thread, so no callback\n//   arrives off the main thread before 0.21 (gpu.md §2.11).\n// - A headless session (ssh, no window server) makes NSApplication abort\n//   the process: CGSessionCopyCurrentDictionary is asked first, and\n");
    buf_str(out, c"//   App::new_in returns Err(NoDisplay).\n// - (0.25.2.1) The display link fires only for a window the display\n//   shows: none while the display is asleep (the screen locked, the\n//   person away), nor for a window that is covered, hidden, minimized or\n//   on another Space (occlusionState without Visible). A loop waiting for Frame would\n//   wait forever, so each request is also answered by a timer: at once\n//   10 a second when the window is occluded (FALLBACK_NS), after 3 s of\n//   silence otherwise (QUIET_NS), 60 a second with no display link; and\n//   after 3 s without a display frame one line on stderr says why.\n// - (0.25.2.1) A process started from a background shell is not made\n//   active (macOS 14's cooperative activation ignores\n//   activateIgnoringOtherApps: then): its window opens behind the\n//   active app's. It is ordered front regardless, as winit does (not\n//   made key: the focus stays where it is).\n\n// ---- The Cocoa backend (0.23) ----\n\nuse crate::alloc::Allocator;\n\nuse keys::{\n    first_char, mac_keycode, mac_logical, mac_modifier_down, mac_mods, utf16_to_byte, utf8_cut,\n};\nuse super::{\n    Button, CursorIcon, Error, Event, Key, Mouse, MouseAction, Preedit, Scroll, Size, Text, Window,\n    WindowDesc, WindowId,\n};\nuse super::objc::{\n    NOT_FOUND, Point, Range, Rect, class, class_addIvar, class_addProtocol,\n    class_getInstanceVariable, ivar_getOffset, method_types, msg_b, msg_b_i, msg_b_p, msg_b_pp,\n    msg_d, msg_h, msg_i, msg_p, msg_p_d, msg_p_p, msg_p_pp, msg_p_ppp, msg_p_r, msg_p_rupp,\n    msg_p_ruub, msg_p_uppb, msg_p_utudipsii, msg_r, msg_r_r, msg_r_rp, msg_t, msg_t_tp, msg_u,\n    msg_v, msg_v_b, msg_v_d, msg_v_p, msg_v_pb, msg_v_pp, msg_v_rp, msg_v_u, msg_v_z, nsstring,\n    nsstring_bytes, objc_allocateClassPair, objc_getProtocol, objc_registerClassPair, pool_pop,\n    pool_push, release, retain, sel,\n};\nuse super::objc::Size as NsSize;\n\n");
    buf_str(out, c"// (0.25) What the Cocoa backend links: AppKit and the frameworks under it.\n// UNSAFE: AppKit, Core Graphics and Core Foundation are C (and\n// Objective-C) libraries: their functions and constants have no safe binding.\n// SAFETY: each declaration matches its C prototype in the macOS SDK\n// (CGSession.h, CGDisplayConfiguration.h, CFRunLoop.h, CFFileDescriptor.h,\n// objc/runtime.h's class_addMethod, one IMP type per declaration); the\n// statics are the SDK's constant NSString/CFString globals, only read.\n#[link(framework = \"AppKit\", framework = \"QuartzCore\", framework = \"CoreGraphics\")]\n#[link(framework = \"CoreFoundation\", framework = \"Foundation\")]\nextern \"C\" {\n    static NSDefaultRunLoopMode: *mut u8;\n    static NSRunLoopCommonModes: *mut u8;\n    static NSPasteboardTypeString: *mut u8;\n    static kCFRunLoopDefaultMode: *mut u8;\n    #[effects(io)]\n    fn CGSessionCopyCurrentDictionary() -> *mut u8;\n    #[effects(io)]\n    fn CGMainDisplayID() -> u32;\n    #[effects(io)]\n    fn CGDisplayIsAsleep(display: u32) -> i32;\n    #[effects(io)]\n    fn CFRelease(o: *mut u8);\n    #[effects(io)]\n    fn CFRunLoopGetMain() -> *mut u8;\n    #[effects(io)]\n    fn CFRunLoopAddSource(rl: *mut u8, src: *mut u8, mode: *mut u8);\n    #[effects(io)]\n    fn CFRunLoopRemoveSource(rl: *mut u8, src: *mut u8, mode: *mut u8);\n\n    #[effects(io)]\n    fn CFFileDescriptorCreate(alloc: *mut u8, fd: i32, close_on_invalidate: bool,\n        callout: extern \"C\" fn(*mut u8, u64, *mut u8), ctx: *mut FdContext) -> *mut u8;\n\n    #[effects(io)]\n    fn CFFileDescriptorEnableCallBacks(f: *mut u8, types: u64);\n    #[effects(io)]\n    fn CFFileDescriptorCreateRunLoopSource(alloc: *mut u8, f: *mut u8, order: i64) -> *mut u8;\n    #[effects(io)]\n    fn CFFileDescriptorGetNativeDescriptor(f: *mut u8) -> i32;\n    #[effects(io)]\n    fn CFFileDescriptorInvalidate(f: *mut u8);\n\n    // class_addMethod, once per IMP shape (an `extern \"C\" fn` type does\n");
    buf_str(out, c"    // not cast to another, so each shape has its own declaration).\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8), t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v_p(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8), t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_b(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8) -> bool, t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_b_p(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8) -> bool,\n        t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_g(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8) -> Range, t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_p(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8) -> *mut u8, t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v_pg(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8, Range),\n        t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v_pgg(c: *mut u8, s: *mut u8,\n        imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8, Range, Range), t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_p_gP(c: *mut u8, s: *mut u8,\n        imp: extern \"C\" fn(*mut u8, *mut u8, Range, *mut Range) -> *mut u8, t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_r_gP(c: *mut u8, s: *mut u8,\n        imp: extern \"C\" fn(*mut u8, *mut u8, Range, *mut Range) -> Rect, t: *const u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn add_u_t(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, Point) -> u64,\n        t: *const u8) -> bool;\n}\n\n// CFFileDescriptorContext; the callbacks we do not use are null.\n#[derive(Clone, Copy)] #[repr(C)]\nstruct FdContext {\n    version: i64,\n    info: *mut u8,\n    retain: *mut u8,\n    release: *mut u8,\n    describe: *mut u8,\n}\n\n// NSEventType values.\nconst EV_LEFT_DOWN: u64 = 1;\nconst EV_LEFT_UP: u64 = 2;\nconst EV_RIGHT_DOWN: u64 = 3;\nconst EV_RIGHT_UP: u64 = 4;\nconst EV_MOVED: u64 = 5;\nconst EV_LEFT_DRAGGED: u64 = 6;\nconst EV_RIGHT_DRAGGED: u64 = 7;\nconst EV_APP_DEFINED: u64 = 15;\nconst EV_OTHER_DOWN: u64 = 25;\nconst EV_OTHER_UP: u64 = 26;\nconst EV_OTHER_DRAGGED: u64 = 27;\n\n// data1 of our wake-up NSEvent.\nconst WAKE: i64 = 0x74616368;\n\n// (0.25.2.1) The frame timer (see the pitfalls above): an occluded\n// window's frames come 10 a second, a window without a display link's\n// 60, and a visible window's display link silent for 3 s is answered by\n// the timer too (and the diagnostic printed).\nconst FALLBACK_NS: i64 = 100000000;\nconst NO_LINK_NS: i64 = 16000000;\nconst QUIET_NS: i64 = 3000000000;\n\n// (0.25.2.1) A window's frame request: whether one is pending and since\n// when, since when its display link has been silent while frames were\n// wanted, and whether the last frame came from the timer.\n#[derive(Clone, Copy)] struct Req {\n    id: i64,\n    win: *mut u8,\n    link: *mut u8,\n    pending: bool,\n    since: i64,\n    quiet: i64,\n    slow: bool,\n}\n\n// The view's instance variable \"vole\": the window id, the cursor\n// shape, the input method area (physical pixels).\n#[derive(Clone, Copy)] struct ViewData {\n    id: i64,\n    cursor: i64,\n    ime_x: f64,\n    ime_y: f64,\n    ime_w: f64,\n    ime_h: f64,\n}\n\n#[derive(Clone, Copy)] struct Watch {\n    fd: i32,\n    cf: *mut u8,\n    src: *mut u8,\n    armed: bool,\n}\n\n// What the IMPs and run-loop callbacks reach: one per process (AppKit\n");
    buf_str(out, c"// has one NSApp), on the heap, pointed to by ST while the App lives.\nstruct State<A: Allocator> {\n    q: Vec<Event, A>,\n    head: i64,\n    // The current composition, and whether there is one.\n    preedit: Vec<u8, A>,\n    marked: bool,\n    // Text produced while a keyDown: is interpreted, sent after its Key.\n    in_key: bool,\n    key_text: Vec<u8, A>,\n    // Inside nextEventMatchingMask (a callback must wake it), and\n    // whether a wake-up is already posted.\n    waiting: bool,\n    wake_posted: bool,\n    // The live-resize hook, and whether it is running.\n    hook: Option<fn(*mut u8)>,\n    hook_ctx: *mut u8,\n    in_hook: bool,\n    watches: Vec<Watch, A>,\n    // (0.25.2.1) The windows' frame requests, and whether the no-frame\n    // diagnostic was printed (once per process).\n    reqs: Vec<Req, A>,\n    warned: bool,\n    app: *mut u8,\n    delegate: *mut u8,\n    target: *mut u8,\n    view_class: *mut u8,\n    ivar_off: i64,\n}\n\n// The State of the App (null when there is none). Statics are safe to\n// use on one thread; the pointer is dereferenced in unsafe blocks only.\n// (0.26.3) A static's type holds no allocator (rule 1), so it is the\n// State's address as bytes, cast back by st(): the Objective-C IMPs and C\n// callbacks are given no context of their own to reach it through.\nstatic mut ST_RAW: *mut u8 = 0 as *mut u8;\n\n// The App's State (see ST_RAW, st_live).\nfn st() -> *mut State<Gpa> {\n    get_st_raw() as *mut State<Gpa>\n}\n\npub struct Cocoa<A: Allocator> {\n    // The State's storage (one element: its address is stable).\n    st: Vec<State<A>, A>,\n}\n\n// SAFETY (for every `unsafe { st()... }` below): ST points to the element\n// of the App's `st` Vec from new_in until close, which nulls it; IMPs and\n// callbacks run on the main thread only, inside App calls (sendEvent:,\n// nextEventMatchingMask:, window creation and closing), so the State is\n// live whenever they run and nothing else holds a reference to it then.\n");
    buf_str(out, c"fn st_live() -> bool {\n    get_st_raw() != 0 as *mut u8\n}\n\nfn push(e: Event) {\n    // UNSAFE: the App's State through the raw ST pointer (a static, so the\n    // IMPs, C callbacks, reach it), and post_wake's Objective-C messages.\n    // SAFETY: see st_live.\n    unsafe {\n        if get_st_raw() == 0 as *mut u8 {\n            return;\n        }\n        st().q.push(e);\n        if st().waiting && !st().wake_posted {\n            st().wake_posted = true;\n            post_wake(st().app);\n        }\n    }\n}\n\n// Posts an application-defined event, so nextEventMatchingMask returns.\n// UNSAFE: Objective-C messages through objc_msgSend on a raw pointer.\n// SAFETY: the caller passes the live NSApplication (st().app); the event\n// constructor takes the documented argument types in this order and\n// returns an autoreleased NSEvent, which postEvent:atStart: retains.\nunsafe fn post_wake(app: *mut u8) {\n    let ev = msg_p_utudipsii(class(c\"NSEvent\"),\n        sel(c\"otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2:\"),\n        EV_APP_DEFINED, Point { x: 0.0, y: 0.0 }, 0, 0.0, 0, 0 as *mut u8, 0, WAKE, 0);\n    msg_v_pb(app, sel(c\"postEvent:atStart:\"), ev, false);\n}\n\n// Text events for `s`, cut into pieces of at most 30 bytes at character\n// boundaries.\nfn push_text(win: WindowId, s: &[u8]) {\n    let mut rest = s;\n    while rest.len() as i64 > 0 {\n        let n = utf8_cut(rest, 30);\n        if n == 0 {\n            break;\n        }\n        let mut t = Text { win: win, len: n as u8, bytes: [0; 30] };\n        for i in 0..n {\n            t.bytes[i as usize] = rest[i as usize];\n        }\n        push(Event::Text(t));\n        rest = &rest[n as usize..rest.len() as i64 as usize];\n    }\n}\n\n// The view's data (an instance variable at a known offset).\n// UNSAFE: a pointer into the view object's instance variable, at an offset\n// only the Objective-C runtime knows.\n");
    buf_str(out, c"// SAFETY: the caller passes a live VoleView (make_view_class: the 48-byte,\n// 8-aligned ivar \"vole\" at st().ivar_off) while ST is live; alloc zeroes the\n// object, so the ivar holds a valid ViewData from then on.\nunsafe fn vdata(view: *mut u8) -> *mut ViewData {\n    view.add(st().ivar_off as usize) as *mut ViewData\n}\n\n// UNSAFE: reads through vdata's raw pointer.\n// SAFETY: the caller's obligation is vdata's: a live VoleView, ST live.\nunsafe fn view_id(view: *mut u8) -> WindowId {\n    WindowId { n: vdata(view).id }\n}\n\n// The window's backing scale (2.0 on Retina).\n// UNSAFE: Objective-C messages on a raw NSView pointer.\n// SAFETY: the caller passes a live NSView; window returns its NSWindow (+0)\n// or nil, checked; backingScaleFactor returns a CGFloat (f64).\nunsafe fn scale_of(view: *mut u8) -> f64 {\n    let w = msg_p(view, sel(c\"window\"));\n    if w == 0 as *mut u8 {\n        return 1.0;\n    }\n    msg_d(w, sel(c\"backingScaleFactor\"))\n}\n\n// UNSAFE: Objective-C messages on a raw NSView pointer.\n// SAFETY: the caller passes a live NSView; bounds returns an NSRect by value.\nunsafe fn view_size(view: *mut u8) -> Size {\n    let b = msg_r(view, sel(c\"bounds\"));\n    let s = scale_of(view);\n    Size { w: (b.w * s + 0.5) as i64, h: (b.h * s + 0.5) as i64, scale: s }\n}\n\n// Sets the layer's scale and drawable size to the view's.\n// UNSAFE: Objective-C messages on a raw NSView and its layer.\n// SAFETY: the caller passes a live VoleView; layer returns its layer (+0)\n// or nil, checked; it is the CAMetalLayer open_window set, which takes\n// setContentsScale: (CGFloat) and setDrawableSize: (CGSize).\nunsafe fn sync_layer(view: *mut u8) -> Size {\n    let sz = view_size(view);\n    let layer = msg_p(view, sel(c\"layer\"));\n    if layer != 0 as *mut u8 {\n        msg_v_d(layer, sel(c\"setContentsScale:\"), sz.scale);\n        msg_v_z(layer, sel(c\"setDrawableSize:\"), NsSize { w: sz.w as f64, h: sz.h as f64 });\n    }\n    sz\n}\n\n");
    buf_str(out, c"// ---- the view's methods (IMPs) (0.23) ----\n\nextern \"C\" fn imp_yes(this: *mut u8, cmd: *mut u8) -> bool {\n    true\n}\n\nextern \"C\" fn imp_yes_p(this: *mut u8, cmd: *mut u8, a: *mut u8) -> bool {\n    true\n}\n\nextern \"C\" fn imp_key_down(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view, and the State\n    // through st().\n    // SAFETY: see st_live; `ev` is the NSEvent AppKit passes; the array\n    // is autoreleased in the pool around sendEvent:.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        let repeat = msg_b(ev, sel(c\"isARepeat\"));\n        let c = first_char(nsstring_bytes(msg_p(ev, sel(c\"charactersIgnoringModifiers\"))));\n        let id = view_id(this);\n        let had_marked = st().marked;\n        st().in_key = true;\n        st().key_text.clear();\n        let arr = msg_p_p(class(c\"NSArray\"), sel(c\"arrayWithObject:\"), ev);\n        msg_v_p(this, sel(c\"interpretKeyEvents:\"), arr);\n        st().in_key = false;\n        let text_len = st().key_text.len() as i64;\n        push(Event::Key(Key {\n            win: id,\n            code: code,\n            key: mac_logical(c, code),\n            mods: mac_mods(flags),\n            pressed: true,\n            repeat: repeat,\n            ime: had_marked || st().marked,\n            text_follows: text_len > 0,\n        }));\n        if text_len > 0 {\n            push_text(id, st().key_text.as_slice());\n        }\n    }\n}\n\nextern \"C\" fn imp_key_up(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view, and the State\n    // through st().\n    // SAFETY: see st_live and imp_key_down.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n");
    buf_str(out, c"        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        let c = first_char(nsstring_bytes(msg_p(ev, sel(c\"charactersIgnoringModifiers\"))));\n        push(Event::Key(Key {\n            win: view_id(this),\n            code: code,\n            key: mac_logical(c, code),\n            mods: mac_mods(flags),\n            pressed: false,\n            repeat: false,\n            ime: st().marked,\n            text_follows: false,\n        }));\n    }\n}\n\nextern \"C\" fn imp_flags_changed(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view.\n    // SAFETY: see imp_key_down.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        push(Event::Key(Key {\n            win: view_id(this),\n            code: code,\n            key: mac_logical(0, code),\n            mods: mac_mods(flags),\n            pressed: mac_modifier_down(code, flags),\n            repeat: false,\n            ime: false,\n            text_follows: false,\n        }));\n    }\n}\n\nextern \"C\" fn imp_mouse(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view.\n    // SAFETY: see imp_key_down; convertPoint:fromView: with nil converts\n    // from the window's coordinates.\n    unsafe {\n        let ty = msg_u(ev, sel(c\"type\"));\n        let at = msg_t(ev, sel(c\"locationInWindow\"));\n        let p = msg_t_tp(this, sel(c\"convertPoint:fromView:\"), at, 0 as *mut u8);\n        let s = scale_of(this);\n        let n = msg_i(ev, sel(c\"buttonNumber\"));\n        let action = if ty == EV_LEFT_DOWN || ty == EV_RIGHT_DOWN || ty == EV_OTHER_DOWN {\n            MouseAction::Press\n        } else if ty == EV_LEFT_UP || ty == EV_RIGHT_UP || ty == EV_OTHER_UP {\n            MouseAction::Release\n        } else {\n");
    buf_str(out, c"            MouseAction::Move\n        };\n        let button = if ty == EV_MOVED {\n            Button::None\n        } else if n == 0 {\n            Button::Left\n        } else if n == 1 {\n            Button::Right\n        } else if n == 2 {\n            Button::Middle\n        } else {\n            Button::Other(n)\n        };\n        let clicks: i64 = if ty == EV_MOVED || ty == EV_LEFT_DRAGGED || ty == EV_RIGHT_DRAGGED\n            || ty == EV_OTHER_DRAGGED {\n            0\n        } else {\n            msg_i(ev, sel(c\"clickCount\"))\n        };\n        push(Event::Mouse(Mouse {\n            win: view_id(this),\n            action: action,\n            button: button,\n            x: p.x * s,\n            y: p.y * s,\n            mods: mac_mods(msg_u(ev, sel(c\"modifierFlags\"))),\n            clicks: clicks,\n        }));\n    }\n}\n\nextern \"C\" fn imp_entered(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the view's instance variable through a raw pointer (view_id).\n    // SAFETY: see st_live.\n    unsafe { push(Event::Cursor(view_id(this), true)); }\n}\n\nextern \"C\" fn imp_exited(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the view's instance variable through a raw pointer (view_id).\n    // SAFETY: see st_live.\n    unsafe { push(Event::Cursor(view_id(this), false)); }\n}\n\nextern \"C\" fn imp_scroll(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view.\n    // SAFETY: see imp_key_down.\n    unsafe {\n        let precise = msg_b(ev, sel(c\"hasPreciseScrollingDeltas\"));\n        let s = if precise { scale_of(this) } else { 1.0 };\n        push(Event::Scroll(Scroll {\n            win: view_id(this),\n            dx: msg_d(ev, sel(c\"scrollingDeltaX\")) * s,\n            dy: msg_d(ev, sel(c\"scrollingDeltaY\")) * s,\n");
    buf_str(out, c"            precise: precise,\n            mods: mac_mods(msg_u(ev, sel(c\"modifierFlags\"))),\n        }));\n    }\n}\n\nextern \"C\" fn imp_frame(this: *mut u8, cmd: *mut u8, link: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: an Objective-C message on the raw display link, and the State\n    // through st().\n    // SAFETY: see st_live; `link` is the CADisplayLink that called us.\n    unsafe {\n        msg_v_b(link, sel(c\"setPaused:\"), true);\n        // A request the timer answered already is not answered twice.\n        if st().answered(link) {\n            push(Event::Frame(view_id(this)));\n        }\n    }\n}\n\nextern \"C\" fn imp_reset_cursor_rects(this: *mut u8, cmd: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the view's instance variable through a raw pointer, and AppKit\n    // messages on raw object pointers.\n    // SAFETY: see st_live; the NSCursor class methods return shared\n    // cursors (+0).\n    unsafe {\n        let k = vdata(this).cursor;\n        let c = if k == 1 {\n            msg_p(class(c\"NSCursor\"), sel(c\"IBeamCursor\"))\n        } else if k == 2 {\n            msg_p(class(c\"NSCursor\"), sel(c\"pointingHandCursor\"))\n        } else {\n            msg_p(class(c\"NSCursor\"), sel(c\"arrowCursor\"))\n        };\n        msg_v_rp(this, sel(c\"addCursorRect:cursor:\"), msg_r(this, sel(c\"bounds\")), c);\n    }\n}\n\n// ---- NSTextInputClient (0.23) ----\n\nextern \"C\" fn imp_has_marked(this: *mut u8, cmd: *mut u8) -> bool {\n    // UNSAFE: the App's State through the raw ST pointer.\n    // SAFETY: see st_live.\n    st_live() && unsafe { st().marked }\n}\n\nextern \"C\" fn imp_marked_range(this: *mut u8, cmd: *mut u8) -> Range {\n    // UNSAFE: the App's State through the raw ST pointer.\n    // SAFETY: see st_live.\n    unsafe {\n        if st_live() && st().marked {\n            return Range { loc: 0, len: utf16_len(st().preedit.as_slice()) };\n        }\n    }\n");
    buf_str(out, c"    Range { loc: NOT_FOUND, len: 0 }\n}\n\nextern \"C\" fn imp_selected_range(this: *mut u8, cmd: *mut u8) -> Range {\n    Range { loc: NOT_FOUND, len: 0 }\n}\n\nfn utf16_len(s: &[u8]) -> u64 {\n    let mut n: u64 = 0;\n    for &b in s {\n        if (b & 0xC0) != 0x80 {\n            n += if b >= 0xF0 { 2 } else { 1 };\n        }\n    }\n    n\n}\n\n// The text of an NSString or NSAttributedString argument.\n// UNSAFE: Objective-C messages on a raw object pointer, and the bytes of an\n// NSString whose lifetime the runtime decides.\n// SAFETY: the caller passes the NSString or NSAttributedString an input\n// method gives; the bytes (nsstring_bytes) stay valid until the autorelease\n// pool around the event pops, and every caller copies them before then.\nunsafe fn arg_text(s: *mut u8) -> &'static [u8] {\n    if msg_b_p(s, sel(c\"isKindOfClass:\"), class(c\"NSAttributedString\")) {\n        return nsstring_bytes(msg_p(s, sel(c\"string\")));\n    }\n    nsstring_bytes(s)\n}\n\nextern \"C\" fn imp_set_marked(this: *mut u8, cmd: *mut u8, text: *mut u8, selected: Range,\n    replaced: Range) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw text argument, and the State\n    // through st().\n    // SAFETY: see st_live; `text` is the NSString or NSAttributedString\n    // the input method passes.\n    unsafe {\n        let s = arg_text(text);\n        st().preedit.clear();\n        st().preedit.extend_from_slice(s);\n        st().marked = s.len() as i64 > 0;\n        let cursor = if selected.loc == NOT_FOUND { s.len() as i64 }\n            else { utf16_to_byte(s, selected.loc as i64) };\n        push(Event::Preedit(Preedit { win: view_id(this), len: s.len() as i64, cursor: cursor }));\n    }\n}\n\nextern \"C\" fn imp_unmark(this: *mut u8, cmd: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the State through ST, and Objective-C messages on the raw view\n    // and its input context.\n");
    buf_str(out, c"    // SAFETY: see st_live; discardMarkedText on the view's input context.\n    unsafe {\n        if st().marked {\n            st().marked = false;\n            st().preedit.clear();\n            push(Event::Preedit(Preedit { win: view_id(this), len: 0, cursor: 0 }));\n        }\n        let ic = msg_p(this, sel(c\"inputContext\"));\n        if ic != 0 as *mut u8 {\n            msg_v(ic, sel(c\"discardMarkedText\"));\n        }\n    }\n}\n\nextern \"C\" fn imp_insert_text(this: *mut u8, cmd: *mut u8, text: *mut u8, replaced: Range) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw text argument, and the State\n    // through st().\n    // SAFETY: see imp_set_marked.\n    unsafe {\n        let s = arg_text(text);\n        let id = view_id(this);\n        if st().marked {\n            st().marked = false;\n            st().preedit.clear();\n            push(Event::Preedit(Preedit { win: id, len: 0, cursor: 0 }));\n        }\n        if st().in_key {\n            st().key_text.extend_from_slice(s);\n        } else {\n            push_text(id, s);\n        }\n    }\n}\n\nextern \"C\" fn imp_valid_attributes(this: *mut u8, cmd: *mut u8) -> *mut u8 {\n    // UNSAFE: an Objective-C message (objc_msgSend, a C function).\n    // SAFETY: +[NSArray array] returns an empty, autoreleased array.\n    unsafe { msg_p(class(c\"NSArray\"), sel(c\"array\")) }\n}\n\nextern \"C\" fn imp_attributed_substring(this: *mut u8, cmd: *mut u8, r: Range, actual: *mut Range) -> *mut u8 {\n    0 as *mut u8\n}\n\nextern \"C\" fn imp_char_index(this: *mut u8, cmd: *mut u8, p: Point) -> u64 {\n    NOT_FOUND\n}\n\nextern \"C\" fn imp_first_rect(this: *mut u8, cmd: *mut u8, r: Range, actual: *mut Range) -> Rect {\n    if !st_live() {\n        return Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };\n    }\n    // UNSAFE: the view's instance variable through a raw pointer, and AppKit's\n    // rect conversions on raw object pointers.\n");
    buf_str(out, c"    // SAFETY: see st_live; the conversions take and return rects by value.\n    unsafe {\n        let d = vdata(this);\n        let s = scale_of(this);\n        let local = Rect { x: d.ime_x / s, y: d.ime_y / s, w: d.ime_w / s, h: d.ime_h / s };\n        let inwin = msg_r_rp(this, sel(c\"convertRect:toView:\"), local, 0 as *mut u8);\n        let w = msg_p(this, sel(c\"window\"));\n        if w == 0 as *mut u8 {\n            return inwin;\n        }\n        msg_r_r(w, sel(c\"convertRectToScreen:\"), inwin)\n    }\n}\n\nextern \"C\" fn imp_do_command(this: *mut u8, cmd: *mut u8, selector: *mut u8) {\n    // Nothing: the application reads keys from Event::Key (and the\n    // default would beep).\n}\n\n// ---- the window delegate (0.23) ----\n\n// UNSAFE: Objective-C messages on a raw NSNotification pointer.\n// SAFETY: the caller passes a window notification sent to our delegate: its\n// object is one of our NSWindows, whose contentView is our VoleView (+0,\n// held by the window).\nunsafe fn note_view(note: *mut u8) -> *mut u8 {\n    let w = msg_p(note, sel(c\"object\"));\n    msg_p(w, sel(c\"contentView\"))\n}\n\nextern \"C\" fn imp_should_close(this: *mut u8, cmd: *mut u8, win: *mut u8) -> bool {\n    if !st_live() {\n        return true;\n    }\n    // UNSAFE: an Objective-C message on the raw NSWindow, and the view's\n    // instance variable through a raw pointer.\n    // SAFETY: see st_live; `win` is one of our windows (its content view\n    // is our view).\n    unsafe { push(Event::Close(view_id(msg_p(win, sel(c\"contentView\"))))); }\n    false\n}\n\nextern \"C\" fn imp_did_resize(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on raw object pointers, the State through\n    // ST, and the application's hook called with its raw context.\n    // SAFETY: see st_live; the hook is called with the context it was\n");
    buf_str(out, c"    // registered with (the application's promise: it is valid while the\n    // hook is set).\n    unsafe {\n        let view = note_view(note);\n        let sz = sync_layer(view);\n        push(Event::Resize(view_id(view), sz));\n        let live = msg_b(view, sel(c\"inLiveResize\"));\n        if live && !st().in_hook {\n            match st().hook {\n                Some(f) => {\n                    st().in_hook = true;\n                    f(st().hook_ctx);\n                    st().in_hook = false;\n                }\n                None => {}\n            }\n        }\n    }\n}\n\nextern \"C\" fn imp_did_backing(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw notification (note_view), and the\n    // view's instance variable through a raw pointer.\n    // SAFETY: see st_live.\n    unsafe {\n        let view = note_view(note);\n        let sz = sync_layer(view);\n        push(Event::Resize(view_id(view), sz));\n    }\n}\n\nextern \"C\" fn imp_did_key(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw notification (note_view), and the\n    // view's instance variable through a raw pointer.\n    // SAFETY: see st_live.\n    unsafe { push(Event::Focus(view_id(note_view(note)), true)); }\n}\n\nextern \"C\" fn imp_did_resign(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw notification (note_view), and the\n    // view's instance variable through a raw pointer.\n    // SAFETY: see st_live.\n    unsafe { push(Event::Focus(view_id(note_view(note)), false)); }\n}\n\n// (0.25.2.1) A window was covered, hidden or shown again (or the\n// display went to sleep): next_event looks at the frame requests\n// again, so a pending one is answered by the timer from now on.\n");
    buf_str(out, c"extern \"C\" fn imp_did_occlusion(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the App's State through the ST pointer, and a Cocoa\n    // message (postEvent:atStart:) on raw object pointers.\n    // SAFETY: see st_live; the wake-up event only ends the wait.\n    unsafe {\n        if st().waiting && !st().wake_posted {\n            st().wake_posted = true;\n            post_wake(st().app);\n        }\n    }\n}\n\nextern \"C\" fn imp_quit(this: *mut u8, cmd: *mut u8, sender: *mut u8) {\n    push(Event::Quit);\n}\n\n// ---- watched file descriptors (0.23) ----\n\nextern \"C\" fn fd_ready(f: *mut u8, types: u64, info: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: a Core Foundation C call on the raw CFFileDescriptor, and the\n    // State through st().\n    // SAFETY: see st_live; `f` is one of our CFFileDescriptors.\n    unsafe {\n        let fd = CFFileDescriptorGetNativeDescriptor(f);\n        for i in 0..st().watches.len() as i64 {\n            if st().watches[i as usize].fd == fd {\n                st().watches[i as usize].armed = false;\n            }\n        }\n        push(Event::Readable(fd));\n    }\n}\n\n// ---- classes (0.23) ----\n\n// The encoding of method `name` of the superclass or protocol, or `dflt`.\nfn types(cls: *mut u8, proto: *mut u8, name: *const u8, dflt: *const u8) -> *const u8 {\n    let t = method_types(cls, proto, name);\n    if t == 0 as *mut u8 { dflt } else { t }\n}\n\n// UNSAFE: the Objective-C runtime's class-building C functions, with the\n// IMPs as C function pointers.\n// SAFETY: called on the main thread (new_in); an existing VoleView is\n// reused, so the pair is allocated and registered once; each IMP's C\n// signature matches the type encoding given with it (the superclass's or\n// protocol's own when the runtime has one); the ivar is 48 bytes aligned to\n// 1 << 3, ViewData's size and alignment.\nunsafe fn make_view_class() -> *mut u8 {\n");
    buf_str(out, c"    let existing = class(c\"VoleView\");\n    if existing != 0 as *mut u8 {\n        return existing;\n    }\n    let sup = class(c\"NSView\");\n    let tic = objc_getProtocol(c\"NSTextInputClient\");\n    let c = objc_allocateClassPair(sup, c\"VoleView\", 0);\n    class_addIvar(c, c\"vole\", 48, 3, c\"[6q]\");\n    class_addProtocol(c, tic);\n    add_b(c, sel(c\"acceptsFirstResponder\"), imp_yes,\n        types(sup, 0 as *mut u8, c\"acceptsFirstResponder\", c\"c@:\"));\n    add_b(c, sel(c\"isFlipped\"), imp_yes, types(sup, 0 as *mut u8, c\"isFlipped\", c\"c@:\"));\n    add_b_p(c, sel(c\"acceptsFirstMouse:\"), imp_yes_p,\n        types(sup, 0 as *mut u8, c\"acceptsFirstMouse:\", c\"c@:@\"));\n    let vp = types(sup, 0 as *mut u8, c\"keyDown:\", c\"v@:@\");\n    add_v_p(c, sel(c\"keyDown:\"), imp_key_down, vp);\n    add_v_p(c, sel(c\"keyUp:\"), imp_key_up, vp);\n    add_v_p(c, sel(c\"flagsChanged:\"), imp_flags_changed, vp);\n    add_v_p(c, sel(c\"mouseDown:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseUp:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseDragged:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseMoved:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"rightMouseDown:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"rightMouseUp:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"rightMouseDragged:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"otherMouseDown:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"otherMouseUp:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"otherMouseDragged:\"), imp_mouse, vp);\n    add_v_p(c, sel(c\"mouseEntered:\"), imp_entered, vp);\n    add_v_p(c, sel(c\"mouseExited:\"), imp_exited, vp);\n    add_v_p(c, sel(c\"scrollWheel:\"), imp_scroll, vp);\n    add_v_p(c, sel(c\"voleFrame:\"), imp_frame, c\"v@:@\");\n    add_v(c, sel(c\"resetCursorRects\"), imp_reset_cursor_rects,\n        types(sup, 0 as *mut u8, c\"resetCursorRects\", c\"v@:\"));\n    // NSTextInputClient.\n    add_b(c, sel(c\"hasMarkedText\"), imp_has_marked,\n");
    buf_str(out, c"        types(0 as *mut u8, tic, c\"hasMarkedText\", c\"c@:\"));\n    add_g(c, sel(c\"markedRange\"), imp_marked_range,\n        types(0 as *mut u8, tic, c\"markedRange\", c\"{_NSRange=QQ}@:\"));\n    add_g(c, sel(c\"selectedRange\"), imp_selected_range,\n        types(0 as *mut u8, tic, c\"selectedRange\", c\"{_NSRange=QQ}@:\"));\n    add_v_pgg(c, sel(c\"setMarkedText:selectedRange:replacementRange:\"), imp_set_marked,\n        types(0 as *mut u8, tic, c\"setMarkedText:selectedRange:replacementRange:\",\n            c\"v@:@{_NSRange=QQ}{_NSRange=QQ}\"));\n    add_v(c, sel(c\"unmarkText\"), imp_unmark, types(0 as *mut u8, tic, c\"unmarkText\", c\"v@:\"));\n    add_p(c, sel(c\"validAttributesForMarkedText\"), imp_valid_attributes,\n        types(0 as *mut u8, tic, c\"validAttributesForMarkedText\", c\"@@:\"));\n    add_p_gP(c, sel(c\"attributedSubstringForProposedRange:actualRange:\"), imp_attributed_substring,\n        types(0 as *mut u8, tic, c\"attributedSubstringForProposedRange:actualRange:\",\n            c\"@@:{_NSRange=QQ}^{_NSRange=QQ}\"));\n    add_v_pg(c, sel(c\"insertText:replacementRange:\"), imp_insert_text,\n        types(0 as *mut u8, tic, c\"insertText:replacementRange:\", c\"v@:@{_NSRange=QQ}\"));\n    add_u_t(c, sel(c\"characterIndexForPoint:\"), imp_char_index,\n        types(0 as *mut u8, tic, c\"characterIndexForPoint:\", c\"Q@:{CGPoint=dd}\"));\n    add_r_gP(c, sel(c\"firstRectForCharacterRange:actualRange:\"), imp_first_rect,\n        types(0 as *mut u8, tic, c\"firstRectForCharacterRange:actualRange:\",\n            c\"{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}^{_NSRange=QQ}\"));\n    add_v_p(c, sel(c\"doCommandBySelector:\"), imp_do_command,\n        types(0 as *mut u8, tic, c\"doCommandBySelector:\", c\"v@::\"));\n    objc_registerClassPair(c);\n    c\n}\n\n// UNSAFE: the Objective-C runtime's class-building C functions, with the\n// IMPs as C function pointers.\n// SAFETY: as make_view_class: allocated and registered once, each IMP\n");
    buf_str(out, c"// matching its encoding (v@:@ for a notification or sender, c@:@ for\n// windowShouldClose:).\nunsafe fn make_delegate_class() -> *mut u8 {\n    let existing = class(c\"VoleWindowDelegate\");\n    if existing != 0 as *mut u8 {\n        return existing;\n    }\n    let c = objc_allocateClassPair(class(c\"NSObject\"), c\"VoleWindowDelegate\", 0);\n    let p = objc_getProtocol(c\"NSWindowDelegate\");\n    if p != 0 as *mut u8 {\n        class_addProtocol(c, p);\n    }\n    add_b_p(c, sel(c\"windowShouldClose:\"), imp_should_close, c\"c@:@\");\n    add_v_p(c, sel(c\"windowDidResize:\"), imp_did_resize, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidChangeBackingProperties:\"), imp_did_backing, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidBecomeKey:\"), imp_did_key, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidResignKey:\"), imp_did_resign, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidChangeOcclusionState:\"), imp_did_occlusion, c\"v@:@\");\n    add_v_p(c, sel(c\"voleQuit:\"), imp_quit, c\"v@:@\");\n    objc_registerClassPair(c);\n    c\n}\n\n// The menu bar: an application menu with Quit (Command-Q).\n// UNSAFE: AppKit messages on raw object pointers.\n// SAFETY: `app` is the shared NSApplication and `target` our delegate (it\n// implements voleQuit:); the alloc/init objects are +1, released once after\n// the menu bar holds them (addItem:, setSubmenu:, setMainMenu: retain); the\n// NSStrings are autoreleased in new_in's pool.\nunsafe fn make_menu(app: *mut u8, target: *mut u8) {\n    let bar = msg_p(msg_p(class(c\"NSMenu\"), sel(c\"alloc\")), sel(c\"init\"));\n    let app_item = msg_p(msg_p(class(c\"NSMenuItem\"), sel(c\"alloc\")), sel(c\"init\"));\n    msg_v_p(bar, sel(c\"addItem:\"), app_item);\n    let menu = msg_p(msg_p(class(c\"NSMenu\"), sel(c\"alloc\")), sel(c\"init\"));\n    let quit = msg_p_ppp(msg_p(class(c\"NSMenuItem\"), sel(c\"alloc\")),\n        sel(c\"initWithTitle:action:keyEquivalent:\"), nsstring(b\"Quit\"), sel(c\"voleQuit:\"),\n        nsstring(b\"q\"));\n");
    buf_str(out, c"    msg_v_p(quit, sel(c\"setTarget:\"), target);\n    msg_v_p(menu, sel(c\"addItem:\"), quit);\n    msg_v_p(app_item, sel(c\"setSubmenu:\"), menu);\n    msg_v_p(app, sel(c\"setMainMenu:\"), bar);\n    release(quit);\n    release(menu);\n    release(app_item);\n    release(bar);\n}\n\n// Whether a window server session exists (false under ssh or in a\n// launchd daemon), checked before NSApplication is touched.\npub fn has_display() -> bool {\n    // UNSAFE: Core Graphics and Core Foundation C calls.\n    // SAFETY: CGSessionCopyCurrentDictionary returns a +1 dictionary or\n    // null; it is released.\n    unsafe {\n        let d = CGSessionCopyCurrentDictionary();\n        if d == 0 as *mut u8 {\n            return false;\n        }\n        CFRelease(d);\n        true\n    }\n}\n\n// (0.25.2.1) The monotonic clock in nanoseconds (0.28.0: std::time's\n// Instant, the same clock; no extern of this module's own).\nfn now_ns() -> i64 {\n    crate::time::Instant::now().as_nanos() as i64\n}\n\n// (0.25.2.1) Whether the window is not shown (occlusionState lacks\n// NSWindowOcclusionStateVisible, 1 << 1).\n// UNSAFE: an Objective-C message on a raw NSWindow pointer.\n// SAFETY: the caller passes a live NSWindow; occlusionState takes nothing\n// and returns an NSUInteger.\nunsafe fn occluded(win: *mut u8) -> bool {\n    (msg_u(win, sel(c\"occlusionState\")) & 2) == 0\n}\n\n// (0.25.2.1) Why a window's display link gives no frames, for the\n// diagnostic: the display asleep, the screen locked, or the window\n// occluded (`hidden`).\n// UNSAFE: CoreGraphics' C functions and Objective-C messages on the raw\n// CFDictionary and CFBoolean they return.\n// SAFETY: CGSessionCopyCurrentDictionary's result is a +1 dictionary or\n// null, released once after its last use; objectForKey: takes the NSString\n// (autoreleased in the pool popped before the release) and returns a\n// value the dictionary holds, or null, checked before boolValue;\n// CGDisplayIsAsleep takes any display id.\n");
    buf_str(out, c"unsafe fn quiet_reason(hidden: bool) -> &'static [u8] {\n    // Asleep first: a locked screen still shows windows while it is awake.\n    if CGDisplayIsAsleep(CGMainDisplayID()) != 0 {\n        return b\"the display is asleep\";\n    }\n    let d = CGSessionCopyCurrentDictionary();\n    if d != 0 as *mut u8 {\n        let pool = pool_push();\n        // The session dictionary (toll-free bridged to NSDictionary):\n        // its value for this key is a CFBoolean, or absent.\n        let v = msg_p_p(d, sel(c\"objectForKey:\"), nsstring(b\"CGSSessionScreenIsLocked\"));\n        let locked = v != 0 as *mut u8 && msg_b(v, sel(c\"boolValue\"));\n        pool_pop(pool);\n        CFRelease(d);\n        if locked {\n            return b\"the screen is locked\";\n        }\n    }\n    if hidden {\n        return b\"covered, hidden, minimized or on another Space\";\n    }\n    b\"the machine may be too loaded\"\n}\n\npub fn hide_cursor_until_moved() {\n    // UNSAFE: an Objective-C message (objc_msgSend, a C function).\n    // SAFETY: +[NSCursor setHiddenUntilMouseMoves:] takes a BOOL.\n    unsafe { msg_v_b(class(c\"NSCursor\"), sel(c\"setHiddenUntilMouseMoves:\"), true); }\n}\n\nimpl Cocoa<Gpa> {\n    pub fn new_in(gpa: Gpa) -> Result<Cocoa<Gpa>, Error> {\n        if !has_display() {\n            return Err(Error::NoDisplay);\n        }\n        // UNSAFE: AppKit setup through Objective-C messages and the runtime's C\n        // functions, and ST set to a raw pointer to the State.\n        // SAFETY: AppKit setup on the main thread with the documented\n        // selectors and types; ST is set to the State's address, which\n        // stays put (the Vec is never pushed to again) until close.\n        unsafe {\n            if get_st_raw() != 0 as *mut u8 {\n                return Err(Error::Failed(\"one App per process\"));\n            }\n            let pool = pool_push();\n            let app = msg_p(class(c\"NSApplication\"), sel(c\"sharedApplication\"));\n");
    buf_str(out, c"            if app == 0 as *mut u8 {\n                pool_pop(pool);\n                return Err(Error::NoDisplay);\n            }\n            // NSApplicationActivationPolicyRegular.\n            msg_b_i(app, sel(c\"setActivationPolicy:\"), 0);\n            msg_v_b(class(c\"NSWindow\"), sel(c\"setAllowsAutomaticWindowTabbing:\"), false);\n            let view_class = make_view_class();\n            let dc = make_delegate_class();\n            let delegate = msg_p(msg_p(dc, sel(c\"alloc\")), sel(c\"init\"));\n            make_menu(app, delegate);\n            msg_v(app, sel(c\"finishLaunching\"));\n            msg_v_b(app, sel(c\"activateIgnoringOtherApps:\"), true);\n            let off = ivar_getOffset(class_getInstanceVariable(view_class, c\"vole\"));\n            let mut c = Cocoa { st: Vec::with_capacity_in(1usize, gpa) };\n            c.st.push(State {\n                q: Vec::with_capacity_in(64usize, gpa),\n                head: 0,\n                preedit: Vec::new_in(gpa),\n                marked: false,\n                in_key: false,\n                key_text: Vec::new_in(gpa),\n                waiting: false,\n                wake_posted: false,\n                hook: None,\n                hook_ctx: 0 as *mut u8,\n                in_hook: false,\n                watches: Vec::new_in(gpa),\n                reqs: Vec::new_in(gpa),\n                warned: false,\n                app: app,\n                delegate: delegate,\n                target: delegate,\n                view_class: view_class,\n                ivar_off: off,\n            });\n            set_st_raw(&mut c.st[0] as *mut State<Gpa> as *mut u8);\n            pool_pop(pool);\n            Ok(c)\n        }\n    }\n}\n\nimpl State<Gpa> {\n    fn pop(&mut self) -> Option<Event> {\n        if self.head < self.q.len() as i64 {\n            let e = self.q[self.head as usize];\n            self.head += 1;\n            if self.head == self.q.len() as i64 {\n                self.q.clear();\n");
    buf_str(out, c"                self.head = 0;\n            }\n            return Some(e);\n        }\n        None\n    }\n\n    // The next event within `ms` milliseconds (-1: however long it takes,\n    // 0: only what is ready). (0.25.2.1) The wait ends early when a frame\n    // request is due from the timer (late_frames).\n    fn next_event(&mut self, ms: i64) -> Option<Event> {\n        match self.pop() {\n            Some(e) => return Some(e),\n            None => {}\n        }\n        if self.in_hook {\n            return None;\n        }\n        for i in 0..self.watches.len() as i64 {\n            if !self.watches[i as usize].armed {\n                // UNSAFE: a Core Foundation C call on a raw CFFileDescriptor.\n                // SAFETY: a CFFileDescriptor of ours, live until unwatch.\n                unsafe { CFFileDescriptorEnableCallBacks(self.watches[i as usize].cf, 1); }\n                self.watches[i as usize].armed = true;\n            }\n        }\n        let end: i64 = if ms < 0 { -1 } else { now_ns() + ms * 1000000 };\n        loop {\n            let due = self.late_frames();\n            match self.pop() {\n                Some(e) => return Some(e),\n                None => {}\n            }\n            // Wait until the caller's end or the next request the timer\n            // answers, whichever comes first.\n            let now = now_ns();\n            let mut until = end;\n            if due >= 0 && (until < 0 || due < until) {\n                until = due;\n            }\n            let wait: i64 = if ms == 0 { 0 } else if until < 0 { -1 }\n                else if until > now { until - now } else { 0 };\n            self.pump(wait);\n            match self.pop() {\n                Some(e) => return Some(e),\n                None => {}\n            }\n            if ms == 0 || (end >= 0 && now_ns() >= end) {\n                let _ = self.late_frames();\n                return self.pop();\n            }\n        }\n    }\n\n");
    buf_str(out, c"    // Dispatches the NSEvents that come within `wait` nanoseconds (-1:\n    // until one comes; 0: those ready), stopping at the first that queues\n    // an Event.\n    fn pump(&mut self, wait: i64) {\n        // UNSAFE: AppKit's event loop through Objective-C messages on raw object\n        // pointers.\n        // SAFETY: the event loop's AppKit calls with their documented\n        // types, each batch in an autorelease pool; the date is\n        // autoreleased in the outer pool, which outlives the loop.\n        unsafe {\n            let outer = pool_push();\n            let date = if wait < 0 {\n                msg_p(class(c\"NSDate\"), sel(c\"distantFuture\"))\n            } else if wait == 0 {\n                msg_p(class(c\"NSDate\"), sel(c\"distantPast\"))\n            } else {\n                msg_p_d(class(c\"NSDate\"), sel(c\"dateWithTimeIntervalSinceNow:\"),\n                    wait as f64 / 1000000000.0)\n            };\n            loop {\n                let p = pool_push();\n                self.waiting = wait != 0;\n                let ev = msg_p_uppb(self.app,\n                    sel(c\"nextEventMatchingMask:untilDate:inMode:dequeue:\"), 0xFFFFFFFFFFFFFFFF,\n                    date, NSDefaultRunLoopMode, true);\n                self.waiting = false;\n                if ev == 0 as *mut u8 {\n                    pool_pop(p);\n                    break;\n                }\n                if msg_u(ev, sel(c\"type\")) == EV_APP_DEFINED && msg_i(ev, sel(c\"data1\")) == WAKE {\n                    // Something to look at: an Event queued, or (0.25.2.1)\n                    // a window's occlusion changed (late_frames).\n                    self.wake_posted = false;\n                    pool_pop(p);\n                    break;\n                } else {\n                    msg_v_p(self.app, sel(c\"sendEvent:\"), ev);\n                }\n                pool_pop(p);\n                if self.head < self.q.len() as i64 {\n                    break;\n");
    buf_str(out, c"                }\n            }\n            pool_pop(outer);\n        }\n    }\n\n    // (0.25.2.1) A frame was requested for window `win` (its display link\n    // is running).\n    fn request(&mut self, win: *mut u8) {\n        let now = now_ns();\n        for i in 0..self.reqs.len() as i64 {\n            if self.reqs[i as usize].win == win && !self.reqs[i as usize].pending {\n                self.reqs[i as usize].pending = true;\n                self.reqs[i as usize].since = now;\n                if !self.reqs[i as usize].slow {\n                    self.reqs[i as usize].quiet = now;\n                }\n            }\n        }\n    }\n\n    // (0.25.2.1) The display link `link` fired: whether its window's\n    // request was still pending (true for a link not registered).\n    fn answered(&mut self, link: *mut u8) -> bool {\n        for i in 0..self.reqs.len() as i64 {\n            if self.reqs[i as usize].link == link {\n                let was = self.reqs[i as usize].pending;\n                self.reqs[i as usize].pending = false;\n                self.reqs[i as usize].slow = false;\n                return was;\n            }\n        }\n        true\n    }\n\n    fn forget(&mut self, win: *mut u8) {\n        let mut i: i64 = 0;\n        while i < self.reqs.len() as i64 {\n            if self.reqs[i as usize].win == win {\n                self.reqs.remove(i as usize);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    // (0.25.2.1) Answers the frame requests the display link cannot (see\n    // the pitfalls above): queues their Frames, prints the diagnostic\n    // once, and returns when the next pending one is due (ns, -1: none).\n    fn late_frames(&mut self) -> i64 {\n        let mut next: i64 = -1;\n        if self.reqs.len() as i64 == 0 {\n            return next;\n        }\n        let now = now_ns();\n        for i in 0..self.reqs.len() as i64 {\n            let r = self.reqs[i as usize];\n");
    buf_str(out, c"            if !r.pending {\n                continue;\n            }\n            // UNSAFE: a Cocoa message on the request's raw NSWindow.\n            // SAFETY: `r.win` is a live NSWindow (a request is forgotten\n            // when its window closes); occlusionState returns an\n            // NSUInteger.\n            let hidden = unsafe { occluded(r.win) };\n            let due = if r.link == 0 as *mut u8 {\n                r.since + NO_LINK_NS\n            } else if hidden {\n                r.since + FALLBACK_NS\n            } else if r.quiet + QUIET_NS > r.since + FALLBACK_NS {\n                r.quiet + QUIET_NS\n            } else {\n                r.since + FALLBACK_NS\n            };\n            if due > now {\n                if next < 0 || due < next {\n                    next = due;\n                }\n                continue;\n            }\n            if r.link != 0 as *mut u8 {\n                // UNSAFE: a Core Animation message on the raw display link.\n                // SAFETY: setPaused: on the display link the window\n                // retained (live while the request is registered): it does\n                // not answer this request again.\n                unsafe { msg_v_b(r.link, sel(c\"setPaused:\"), true); }\n                if !self.warned && now - r.quiet >= QUIET_NS {\n                    self.warned = true;\n                    // UNSAFE: quiet_reason's C and Objective-C calls.\n                    // SAFETY: see quiet_reason (it takes no pointer).\n                    let why = unsafe { quiet_reason(hidden) };\n                    if hidden {\n                        eprintln(\n                            \"window: no frame in 3 s: the window is occluded or not shown ({why}); frames come 10 a second until it shows (volec guide window)\", why = str::from_utf8(why).unwrap());\n                    } else {\n                        eprintln(\n");
    buf_str(out, c"                            \"window: no frame in 3 s from the display link ({why}); frames come 10 a second from a timer (volec guide window)\", why = str::from_utf8(why).unwrap());\n                    }\n                }\n            }\n            self.reqs[i as usize].pending = false;\n            self.reqs[i as usize].slow = r.link != 0 as *mut u8;\n            self.q.push(Event::Frame(WindowId { n: r.id }));\n        }\n        next\n    }\n\n    fn watch(&mut self, fd: i32) -> bool {\n        let mut ctx = FdContext {\n            version: 0, info: 0 as *mut u8, retain: 0 as *mut u8, release: 0 as *mut u8,\n            describe: 0 as *mut u8,\n        };\n        // UNSAFE: Core Foundation C calls, given a C callback and a raw pointer to\n        // the context.\n        // SAFETY: CFFileDescriptorCreate copies the context; the source\n        // is added to the main run loop in the default mode (the mode\n        // wait runs it in) and removed by unwatch.\n        unsafe {\n            let cf = CFFileDescriptorCreate(0 as *mut u8, fd, false, fd_ready, &mut ctx);\n            if cf == 0 as *mut u8 {\n                return false;\n            }\n            let src = CFFileDescriptorCreateRunLoopSource(0 as *mut u8, cf, 0);\n            CFRunLoopAddSource(CFRunLoopGetMain(), src, kCFRunLoopDefaultMode);\n            CFFileDescriptorEnableCallBacks(cf, 1);\n            self.watches.push(Watch { fd: fd, cf: cf, src: src, armed: true });\n        }\n        true\n    }\n\n    fn unwatch(&mut self, fd: i32) {\n        let mut i: i64 = 0;\n        while i < self.watches.len() as i64 {\n            let w = self.watches[i as usize];\n            if w.fd == fd {\n                // UNSAFE: Core Foundation C calls on the raw source and descriptor.\n                // SAFETY: the source and descriptor watch made (+1 each).\n                unsafe {\n                    CFRunLoopRemoveSource(CFRunLoopGetMain(), w.src, kCFRunLoopDefaultMode);\n");
    buf_str(out, c"                    CFFileDescriptorInvalidate(w.cf);\n                    CFRelease(w.src);\n                    CFRelease(w.cf);\n                }\n                self.watches.remove(i as usize);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    fn free(&mut self) {\n        while self.watches.len() as i64 > 0 {\n            let fd = self.watches[0].fd;\n            self.unwatch(fd);\n        }\n        // The delegate was made +1 in new_in.\n        release(self.delegate);\n        self.delegate = 0 as *mut u8;\n    }\n}\n\nimpl super::Backend for Cocoa<Gpa> {\n    fn open_window(&mut self, desc: WindowDesc<'_>, id: WindowId) -> Result<Window, Error> {\n        let view_class = self.st[0].view_class;\n        let delegate = self.st[0].delegate;\n        let app = self.st[0].app;\n        // UNSAFE: AppKit and Core Animation through Objective-C messages on raw\n        // object pointers, and the view's instance variable through a raw pointer.\n        // SAFETY: AppKit and Core Animation calls with their documented\n        // types; alloc/init results are +1 and kept in the NsWindow (the\n        // display link and the layer are retained); the view's data is\n        // the ivar this class was given (48 bytes at ivar_off).\n        unsafe {\n            let pool = pool_push();\n            let rect = Rect { x: 0.0, y: 0.0, w: desc.w as f64, h: desc.h as f64 };\n            // Titled | Closable | Miniaturizable | Resizable.\n            let style: u64 = if desc.resizable { 1 | 2 | 4 | 8 } else { 1 | 2 | 4 };\n            let win = msg_p_ruub(msg_p(class(c\"NSWindow\"), sel(c\"alloc\")),\n                sel(c\"initWithContentRect:styleMask:backing:defer:\"), rect, style, 2, false);\n            if win == 0 as *mut u8 {\n                pool_pop(pool);\n                return Err(Error::Failed(\"NSWindow\"));\n            }\n            msg_v_b(win, sel(c\"setReleasedWhenClosed:\"), false);\n");
    buf_str(out, c"            let view = msg_p_r(msg_p(view_class, sel(c\"alloc\")), sel(c\"initWithFrame:\"), rect);\n            let d = vdata(view);\n            d.id = id.n;\n            d.cursor = 1;\n            d.ime_x = 0.0;\n            d.ime_y = 0.0;\n            d.ime_w = 0.0;\n            d.ime_h = 0.0;\n            // A layer-hosting view: the layer is set before wantsLayer.\n            let layer = retain(msg_p(class(c\"CAMetalLayer\"), sel(c\"layer\")));\n            msg_v_p(view, sel(c\"setLayer:\"), layer);\n            msg_v_b(view, sel(c\"setWantsLayer:\"), true);\n            msg_v_p(win, sel(c\"setContentView:\"), view);\n            msg_v_p(win, sel(c\"setDelegate:\"), delegate);\n            msg_v_p(win, sel(c\"setTitle:\"), nsstring(desc.title.as_bytes()));\n            msg_v_b(win, sel(c\"setAcceptsMouseMovedEvents:\"), true);\n            msg_v_z(win, sel(c\"setContentMinSize:\"),\n                NsSize { w: desc.min_w as f64, h: desc.min_h as f64 });\n            // NSWindowCollectionBehaviorFullScreenPrimary.\n            msg_v_u(win, sel(c\"setCollectionBehavior:\"), 1 << 7);\n            // Enter, leave and moves over the visible rect, always.\n            let ta = msg_p_rupp(msg_p(class(c\"NSTrackingArea\"), sel(c\"alloc\")),\n                sel(c\"initWithRect:options:owner:userInfo:\"),\n                Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }, 0x01 | 0x02 | 0x80 | 0x200, view,\n                0 as *mut u8);\n            msg_v_p(view, sel(c\"addTrackingArea:\"), ta);\n            release(ta);\n            msg_v(win, sel(c\"center\"));\n            msg_b_p(win, sel(c\"makeFirstResponder:\"), view);\n            msg_v_p(win, sel(c\"makeKeyAndOrderFront:\"), 0 as *mut u8);\n            msg_v_b(app, sel(c\"activateIgnoringOtherApps:\"), true);\n            // (0.25.2.1) Not made active (launched from a background\n            // shell): the window is shown in front all the same.\n            if !msg_b(app, sel(c\"isActive\")) {\n");
    buf_str(out, c"                msg_v(win, sel(c\"orderFrontRegardless\"));\n            }\n            let sz = sync_layer(view);\n            let mut link = 0 as *mut u8;\n            if msg_b_p(view, sel(c\"respondsToSelector:\"), sel(c\"displayLinkWithTarget:selector:\")) {\n                link = retain(msg_p_pp(view, sel(c\"displayLinkWithTarget:selector:\"), view,\n                    sel(c\"voleFrame:\")));\n                msg_v_b(link, sel(c\"setPaused:\"), true);\n                msg_v_pp(link, sel(c\"addToRunLoop:forMode:\"),\n                    msg_p(class(c\"NSRunLoop\"), sel(c\"mainRunLoop\")), NSRunLoopCommonModes);\n            }\n            pool_pop(pool);\n            self.st[0].reqs.push(Req {\n                id: id.n, win: win, link: link, pending: false, since: 0, quiet: 0, slow: false,\n            });\n            push(Event::Resize(id, sz));\n            Ok(Window { id: id, ns: NsWindow { win: win, view: view, layer: layer, link: link } })\n        }\n    }\n\n    fn next_event(&mut self, ms: i64) -> Option<Event> {\n        self.st[0].next_event(ms)\n    }\n\n    fn watch(&mut self, fd: i32) -> bool {\n        self.st[0].watch(fd)\n    }\n\n    fn unwatch(&mut self, fd: i32) {\n        self.st[0].unwatch(fd);\n    }\n\n    fn clipboard_get_in<A: Allocator>(&self, a: A) -> Option<String<A>> {\n        // UNSAFE: NSPasteboard through Objective-C messages, and the string's bytes\n        // through a raw pointer.\n        // SAFETY: NSPasteboard calls with their types; the string's bytes\n        // are copied before the pool is popped.\n        unsafe {\n            let pool = pool_push();\n            let pb = msg_p(class(c\"NSPasteboard\"), sel(c\"generalPasteboard\"));\n            let s = msg_p_p(pb, sel(c\"stringForType:\"), NSPasteboardTypeString);\n            if s == 0 as *mut u8 {\n                pool_pop(pool);\n                return None;\n            }\n            let mut b = String::new_in(a);\n");
    buf_str(out, c"            // (UTF8String is UTF-8: its bytes are text, pushed as they are: a brace in the\n            // clipboard is no format)\n            match str::from_utf8(nsstring_bytes(s)) {\n                Ok(t) => b.push_str(t),\n                Err(_) => {}\n            }\n            pool_pop(pool);\n            Some(b)\n        }\n    }\n\n    fn clipboard_set(&self, text: &str) {\n        // UNSAFE: NSPasteboard through Objective-C messages.\n        // SAFETY: as clipboard_get_in.\n        unsafe {\n            let pool = pool_push();\n            let pb = msg_p(class(c\"NSPasteboard\"), sel(c\"generalPasteboard\"));\n            msg_i(pb, sel(c\"clearContents\"));\n            msg_b_pp(pb, sel(c\"setString:forType:\"), nsstring(text.as_bytes()),\n                NSPasteboardTypeString);\n            pool_pop(pool);\n        }\n    }\n\n    fn preedit(&self) -> &[u8] {\n        self.st[0].preedit.as_slice()\n    }\n\n    fn set_live_resize(&mut self, f: fn(*mut u8), ctx: *mut u8) {\n        self.st[0].hook = Some(f);\n        self.st[0].hook_ctx = ctx;\n    }\n\n    fn close(&mut self) {\n        // ST no longer points at the State once it is freed.\n        set_st_raw(0 as *mut u8);\n        self.st[0].free();\n    }\n}\n\n// A window's Cocoa objects (each retained once), live from open_window\n// until close, which releases them and nulls every field: each method\n// below checks the pointer it uses, so a closed window's methods do\n// nothing (Objective-C messages to nil are no-ops, the ivar is not\n// touched).\n#[derive(Clone, Copy)] pub struct NsWindow {\n    pub win: *mut u8,\n    pub view: *mut u8,\n    pub layer: *mut u8,\n    pub link: *mut u8,\n}\n\nimpl NsWindow {\n    // (0.25.4) No window: a scripted App's (script.vl), whose methods\n    // Window does not call.\n    pub fn none() -> NsWindow {\n        NsWindow { win: 0 as *mut u8, view: 0 as *mut u8, layer: 0 as *mut u8, link: 0 as *mut u8 }\n    }\n\n    pub fn request_frame(self) {\n");
    buf_str(out, c"        if self.win == 0 as *mut u8 {\n            return;\n        }\n        if self.link != 0 as *mut u8 {\n            // UNSAFE: an Objective-C message on the raw display link.\n            // SAFETY: the display link this window retained, live until\n            // close (which nulls `link`); setPaused: takes a BOOL.\n            unsafe { msg_v_b(self.link, sel(c\"setPaused:\"), false); }\n        }\n        // (0.25.2.1) Noted, for the timer that answers it if the display\n        // link does not (State::late_frames).\n        // UNSAFE: the App's State through the ST pointer (static mut).\n        // SAFETY: see st_live: checked non-null, on the main thread, and\n        // no other reference to the State is live during this call.\n        unsafe {\n            if get_st_raw() != 0 as *mut u8 {\n                st().request(self.win);\n            }\n        }\n    }\n\n    pub fn size(self) -> Size {\n        if self.view == 0 as *mut u8 {\n            return Size { w: 0, h: 0, scale: 1.0 };\n        }\n        // UNSAFE: Objective-C messages on the raw view (view_size).\n        // SAFETY: the view this window retained, live until close (which\n        // nulls `view`, checked above).\n        unsafe { view_size(self.view) }\n    }\n\n    pub fn set_title(self, t: &str) {\n        // UNSAFE: an Objective-C message on the raw NSWindow.\n        // SAFETY: the NSWindow this window retained, or nil once closed (a\n        // message to nil does nothing); setTitle: takes an NSString,\n        // autoreleased in our pool.\n        unsafe {\n            let p = pool_push();\n            msg_v_p(self.win, sel(c\"setTitle:\"), nsstring(t.as_bytes()));\n            pool_pop(p);\n        }\n    }\n\n    pub fn set_cursor(self, c: CursorIcon) {\n        let k = match c {\n            CursorIcon::Arrow => 0,\n            CursorIcon::Text => 1,\n            CursorIcon::Pointer => 2,\n        };\n        if get_st_raw() == 0 as *mut u8 || self.view == 0 as *mut u8 {\n");
    buf_str(out, c"            return;\n        }\n        // UNSAFE: the view's instance variable through a raw pointer, and\n        // an AppKit message on the raw window.\n        // SAFETY: the VoleView this window retained (checked live above),\n        // its ivar as vdata says; the window rebuilds its cursor rects,\n        // calling resetCursorRects.\n        unsafe {\n            vdata(self.view).cursor = k;\n            msg_v_p(self.win, sel(c\"invalidateCursorRectsForView:\"), self.view);\n        }\n    }\n\n    pub fn set_ime_area(self, x: f64, y: f64, w: f64, h: f64) {\n        if get_st_raw() == 0 as *mut u8 || self.view == 0 as *mut u8 {\n            return;\n        }\n        // UNSAFE: the view's instance variable through a raw pointer.\n        // SAFETY: the VoleView this window retained (checked live above),\n        // its ivar as vdata says.\n        unsafe {\n            let d = vdata(self.view);\n            d.ime_x = x;\n            d.ime_y = y;\n            d.ime_w = w;\n            d.ime_h = h;\n        }\n    }\n\n    pub fn is_fullscreen(self) -> bool {\n        // UNSAFE: an Objective-C message on the raw NSWindow.\n        // SAFETY: the NSWindow this window retained, or nil once closed\n        // (the message then returns 0); styleMask returns an\n        // NSWindowStyleMask, FullScreen is 1 << 14.\n        unsafe { (msg_u(self.win, sel(c\"styleMask\")) & (1 << 14)) != 0 }\n    }\n\n    pub fn set_fullscreen(self, on: bool) {\n        if on != self.is_fullscreen() {\n            // UNSAFE: an Objective-C message on the raw NSWindow.\n            // SAFETY: the NSWindow this window retained, or nil once\n            // closed (no-op); toggleFullScreen: takes a sender (nil).\n            unsafe { msg_v_p(self.win, sel(c\"toggleFullScreen:\"), 0 as *mut u8); }\n        }\n    }\n\n    pub fn focused(self) -> bool {\n        // UNSAFE: an Objective-C message on the raw NSWindow.\n        // SAFETY: the NSWindow this window retained, or nil once closed\n");
    buf_str(out, c"        // (the message then returns NO); isKeyWindow returns a BOOL.\n        unsafe { msg_b(self.win, sel(c\"isKeyWindow\")) }\n    }\n\n    pub fn close(&mut self) {\n        // UNSAFE: Objective-C messages on the raw window and display link,\n        // and the State through st().\n        // SAFETY: releases what open_window retained, once (every field is\n        // nulled, and a closed window returns at once), after detaching\n        // the delegate (no callback reaches a closed window) and stopping\n        // the display link.\n        unsafe {\n            if self.win == 0 as *mut u8 {\n                return;\n            }\n            if self.link != 0 as *mut u8 {\n                msg_v(self.link, sel(c\"invalidate\"));\n                release(self.link);\n            }\n            if get_st_raw() != 0 as *mut u8 {\n                st().forget(self.win);\n            }\n            msg_v_p(self.win, sel(c\"setDelegate:\"), 0 as *mut u8);\n            msg_v(self.win, sel(c\"close\"));\n            release(self.view);\n            release(self.layer);\n            release(self.win);\n            self.win = 0 as *mut u8;\n            self.view = 0 as *mut u8;\n            self.layer = 0 as *mut u8;\n            self.link = 0 as *mut u8;\n        }\n    }\n}\n\n// (0.28.0) ST_RAW's accessors: every use of it is one of them.\nfn get_st_raw() -> *mut u8 {\n    // UNSAFE: a static mut read.\n    // SAFETY: the State's address, set by Cocoa::new_in and cleared by close on the main\n    // thread, which the IMPs and callbacks also run on (see st_live); read or written whole, no\n    // reference to the static is kept.\n    unsafe { ST_RAW }\n}\n\nfn set_st_raw(v: *mut u8) {\n    // UNSAFE: a static mut written.\n    // SAFETY: the State's address, set by Cocoa::new_in and cleared by close on the main\n    // thread, which the IMPs and callbacks also run on (see st_live); read or written whole, no\n    // reference to the static is kept.\n    unsafe {\n");
    buf_str(out, c"        ST_RAW = v;\n    }\n}\n// ---- end mod std::window::cocoa ----\n}\n// ---- mod std::window::keys ----\npub mod keys {\n// Keys (terminal.md §2.2): the physical key (`KeyCode`, winit's names,\n// from USB HID usages), the logical key (a named key or the character it\n// produces), and the modifiers with left and right told apart. The macOS\n// tables live here, as pure functions the headless tests check; the\n// Linux backends (xkbcommon) add theirs.\n\n// ---- Keys (0.23) ----\n\n#[derive(Clone, Copy, PartialEq, Eq)] pub enum KeyCode {\n    Unidentified,\n    KeyA,\n    KeyB,\n    KeyC,\n    KeyD,\n    KeyE,\n    KeyF,\n    KeyG,\n    KeyH,\n    KeyI,\n    KeyJ,\n    KeyK,\n    KeyL,\n    KeyM,\n    KeyN,\n    KeyO,\n    KeyP,\n    KeyQ,\n    KeyR,\n    KeyS,\n    KeyT,\n    KeyU,\n    KeyV,\n    KeyW,\n    KeyX,\n    KeyY,\n    KeyZ,\n    Digit0,\n    Digit1,\n    Digit2,\n    Digit3,\n    Digit4,\n    Digit5,\n    Digit6,\n    Digit7,\n    Digit8,\n    Digit9,\n    Minus,\n    Equal,\n    BracketLeft,\n    BracketRight,\n    Backslash,\n    Semicolon,\n    Quote,\n    Backquote,\n    Comma,\n    Period,\n    Slash,\n    IntlBackslash,\n    IntlYen,\n    IntlRo,\n    Enter,\n    Tab,\n    Space,\n    Backspace,\n    Escape,\n    CapsLock,\n    ShiftLeft,\n    ShiftRight,\n    ControlLeft,\n    ControlRight,\n    AltLeft,\n    AltRight,\n    SuperLeft,\n    SuperRight,\n    Fn,\n    F1,\n    F2,\n    F3,\n    F4,\n    F5,\n    F6,\n    F7,\n    F8,\n    F9,\n    F10,\n    F11,\n    F12,\n    F13,\n    F14,\n    F15,\n    F16,\n    F17,\n    F18,\n    F19,\n    F20,\n    Numpad0,\n    Numpad1,\n    Numpad2,\n    Numpad3,\n    Numpad4,\n    Numpad5,\n    Numpad6,\n    Numpad7,\n    Numpad8,\n    Numpad9,\n    NumpadDecimal,\n    NumpadMultiply,\n    NumpadAdd,\n    NumpadSubtract,\n    NumpadDivide,\n    NumpadEnter,\n    NumpadEqual,\n    NumpadComma,\n    NumLock,\n    AudioVolumeUp,\n    AudioVolumeDown,\n    AudioVolumeMute,\n    Insert,\n    Delete,\n");
    buf_str(out, c"    Home,\n    End,\n    PageUp,\n    PageDown,\n    ArrowLeft,\n    ArrowRight,\n    ArrowUp,\n    ArrowDown,\n    ContextMenu,\n    Lang1,\n    Lang2,\n}\n\n// The physical key of a macOS virtual key code (Carbon's kVK_*, the\n// position on an ANSI keyboard whatever the layout).\npub fn mac_keycode(vk: u16) -> KeyCode {\n    match vk {\n        0x00 => KeyCode::KeyA,\n        0x01 => KeyCode::KeyS,\n        0x02 => KeyCode::KeyD,\n        0x03 => KeyCode::KeyF,\n        0x04 => KeyCode::KeyH,\n        0x05 => KeyCode::KeyG,\n        0x06 => KeyCode::KeyZ,\n        0x07 => KeyCode::KeyX,\n        0x08 => KeyCode::KeyC,\n        0x09 => KeyCode::KeyV,\n        0x0A => KeyCode::IntlBackslash,\n        0x0B => KeyCode::KeyB,\n        0x0C => KeyCode::KeyQ,\n        0x0D => KeyCode::KeyW,\n        0x0E => KeyCode::KeyE,\n        0x0F => KeyCode::KeyR,\n        0x10 => KeyCode::KeyY,\n        0x11 => KeyCode::KeyT,\n        0x12 => KeyCode::Digit1,\n        0x13 => KeyCode::Digit2,\n        0x14 => KeyCode::Digit3,\n        0x15 => KeyCode::Digit4,\n        0x16 => KeyCode::Digit6,\n        0x17 => KeyCode::Digit5,\n        0x18 => KeyCode::Equal,\n        0x19 => KeyCode::Digit9,\n        0x1A => KeyCode::Digit7,\n        0x1B => KeyCode::Minus,\n        0x1C => KeyCode::Digit8,\n        0x1D => KeyCode::Digit0,\n        0x1E => KeyCode::BracketRight,\n        0x1F => KeyCode::KeyO,\n        0x20 => KeyCode::KeyU,\n        0x21 => KeyCode::BracketLeft,\n        0x22 => KeyCode::KeyI,\n        0x23 => KeyCode::KeyP,\n        0x24 => KeyCode::Enter,\n        0x25 => KeyCode::KeyL,\n        0x26 => KeyCode::KeyJ,\n        0x27 => KeyCode::Quote,\n        0x28 => KeyCode::KeyK,\n        0x29 => KeyCode::Semicolon,\n        0x2A => KeyCode::Backslash,\n        0x2B => KeyCode::Comma,\n        0x2C => KeyCode::Slash,\n        0x2D => KeyCode::KeyN,\n        0x2E => KeyCode::KeyM,\n        0x2F => KeyCode::Period,\n        0x30 => KeyCode::Tab,\n");
    buf_str(out, c"        0x31 => KeyCode::Space,\n        0x32 => KeyCode::Backquote,\n        0x33 => KeyCode::Backspace,\n        0x35 => KeyCode::Escape,\n        0x36 => KeyCode::SuperRight,\n        0x37 => KeyCode::SuperLeft,\n        0x38 => KeyCode::ShiftLeft,\n        0x39 => KeyCode::CapsLock,\n        0x3A => KeyCode::AltLeft,\n        0x3B => KeyCode::ControlLeft,\n        0x3C => KeyCode::ShiftRight,\n        0x3D => KeyCode::AltRight,\n        0x3E => KeyCode::ControlRight,\n        0x3F => KeyCode::Fn,\n        0x40 => KeyCode::F17,\n        0x41 => KeyCode::NumpadDecimal,\n        0x43 => KeyCode::NumpadMultiply,\n        0x45 => KeyCode::NumpadAdd,\n        0x47 => KeyCode::NumLock,\n        0x48 => KeyCode::AudioVolumeUp,\n        0x49 => KeyCode::AudioVolumeDown,\n        0x4A => KeyCode::AudioVolumeMute,\n        0x4B => KeyCode::NumpadDivide,\n        0x4C => KeyCode::NumpadEnter,\n        0x4E => KeyCode::NumpadSubtract,\n        0x4F => KeyCode::F18,\n        0x50 => KeyCode::F19,\n        0x51 => KeyCode::NumpadEqual,\n        0x52 => KeyCode::Numpad0,\n        0x53 => KeyCode::Numpad1,\n        0x54 => KeyCode::Numpad2,\n        0x55 => KeyCode::Numpad3,\n        0x56 => KeyCode::Numpad4,\n        0x57 => KeyCode::Numpad5,\n        0x58 => KeyCode::Numpad6,\n        0x59 => KeyCode::Numpad7,\n        0x5A => KeyCode::F20,\n        0x5B => KeyCode::Numpad8,\n        0x5C => KeyCode::Numpad9,\n        0x5D => KeyCode::IntlYen,\n        0x5E => KeyCode::IntlRo,\n        0x5F => KeyCode::NumpadComma,\n        0x60 => KeyCode::F5,\n        0x61 => KeyCode::F6,\n        0x62 => KeyCode::F7,\n        0x63 => KeyCode::F3,\n        0x64 => KeyCode::F8,\n        0x65 => KeyCode::F9,\n        0x66 => KeyCode::Lang2,\n        0x67 => KeyCode::F11,\n        0x68 => KeyCode::Lang1,\n        0x69 => KeyCode::F13,\n        0x6A => KeyCode::F16,\n        0x6B => KeyCode::F14,\n        0x6D => KeyCode::F10,\n        0x6E => KeyCode::ContextMenu,\n        0x6F => KeyCode::F12,\n");
    buf_str(out, c"        0x71 => KeyCode::F15,\n        0x72 => KeyCode::Insert,\n        0x73 => KeyCode::Home,\n        0x74 => KeyCode::PageUp,\n        0x75 => KeyCode::Delete,\n        0x76 => KeyCode::F4,\n        0x77 => KeyCode::End,\n        0x78 => KeyCode::F2,\n        0x79 => KeyCode::PageDown,\n        0x7A => KeyCode::F1,\n        0x7B => KeyCode::ArrowLeft,\n        0x7C => KeyCode::ArrowRight,\n        0x7D => KeyCode::ArrowDown,\n        0x7E => KeyCode::ArrowUp,\n        _ => KeyCode::Unidentified,\n    }\n}\n\n// Keys that have a name rather than a character.\n#[derive(Clone, Copy, PartialEq, Eq)] pub enum Named {\n    Enter,\n    Tab,\n    Backspace,\n    Escape,\n    Delete,\n    Insert,\n    Home,\n    End,\n    PageUp,\n    PageDown,\n    ArrowLeft,\n    ArrowRight,\n    ArrowUp,\n    ArrowDown,\n    Shift,\n    Control,\n    Alt,\n    Super,\n    CapsLock,\n    Fn,\n    ContextMenu,\n    Clear,\n}\n\n// The logical key: what the key means in the current layout, without\n// the modifiers' effect (`charactersIgnoringModifiers`): a named key, a\n// function key F1..F35, or a character.\n#[derive(Clone, Copy)] pub enum Logical {\n    Named(Named),\n    F(i64),\n    Char(u32),\n    Unidentified,\n}\n\n// The logical key for the first character macOS reports (its\n// NSFunctionKey private-use range, control characters, or text).\npub fn mac_logical(c: u32, code: KeyCode) -> Logical {\n    // Modifier keys report no character: name them by their key.\n    match code {\n        KeyCode::ShiftLeft => return Logical::Named(Named::Shift),\n        KeyCode::ShiftRight => return Logical::Named(Named::Shift),\n        KeyCode::ControlLeft => return Logical::Named(Named::Control),\n        KeyCode::ControlRight => return Logical::Named(Named::Control),\n        KeyCode::AltLeft => return Logical::Named(Named::Alt),\n        KeyCode::AltRight => return Logical::Named(Named::Alt),\n        KeyCode::SuperLeft => return Logical::Named(Named::Super),\n");
    buf_str(out, c"        KeyCode::SuperRight => return Logical::Named(Named::Super),\n        KeyCode::CapsLock => return Logical::Named(Named::CapsLock),\n        KeyCode::Fn => return Logical::Named(Named::Fn),\n        _ => {}\n    }\n    if c >= 0xF704 && c <= 0xF726 {\n        return Logical::F((c - 0xF704 + 1) as i64);\n    }\n    match c {\n        0 => Logical::Unidentified,\n        0x03 => Logical::Named(Named::Enter),\n        0x0D => Logical::Named(Named::Enter),\n        0x09 => Logical::Named(Named::Tab),\n        0x19 => Logical::Named(Named::Tab),\n        0x08 => Logical::Named(Named::Backspace),\n        0x7F => Logical::Named(Named::Backspace),\n        0x1B => Logical::Named(Named::Escape),\n        0xF700 => Logical::Named(Named::ArrowUp),\n        0xF701 => Logical::Named(Named::ArrowDown),\n        0xF702 => Logical::Named(Named::ArrowLeft),\n        0xF703 => Logical::Named(Named::ArrowRight),\n        0xF727 => Logical::Named(Named::Insert),\n        0xF728 => Logical::Named(Named::Delete),\n        0xF729 => Logical::Named(Named::Home),\n        0xF72B => Logical::Named(Named::End),\n        0xF72C => Logical::Named(Named::PageUp),\n        0xF72D => Logical::Named(Named::PageDown),\n        0xF735 => Logical::Named(Named::ContextMenu),\n        0xF739 => Logical::Named(Named::Clear),\n        0xF746 => Logical::Named(Named::Insert),\n        _ => {\n            if c >= 0xF700 && c < 0xF900 { Logical::Unidentified } else { Logical::Char(c) }\n        }\n    }\n}\n\n// Modifiers: left and right apart, and caps lock.\n#[derive(Clone, Copy)] pub struct Mods {\n    pub bits: u32,\n}\n\npub const SHIFT_L: u32 = 1;\npub const SHIFT_R: u32 = 2;\npub const CTRL_L: u32 = 4;\npub const CTRL_R: u32 = 8;\npub const ALT_L: u32 = 16;\npub const ALT_R: u32 = 32;\npub const SUPER_L: u32 = 64;\npub const SUPER_R: u32 = 128;\npub const CAPS: u32 = 256;\n\nimpl Mods {\n    pub fn none() -> Mods {\n        Mods { bits: 0 }\n    }\n\n    pub fn shift(self) -> bool {\n");
    buf_str(out, c"        (self.bits & (SHIFT_L | SHIFT_R)) != 0\n    }\n\n    pub fn ctrl(self) -> bool {\n        (self.bits & (CTRL_L | CTRL_R)) != 0\n    }\n\n    pub fn alt(self) -> bool {\n        (self.bits & (ALT_L | ALT_R)) != 0\n    }\n\n    pub fn sup(self) -> bool {\n        (self.bits & (SUPER_L | SUPER_R)) != 0\n    }\n\n    pub fn caps(self) -> bool {\n        (self.bits & CAPS) != 0\n    }\n}\n\n// NSEventModifierFlags: device-independent bits, and the device bits\n// (IOKit's NX_DEVICE*KEYMASK) that tell left from right. A flag without\n// either device bit (a synthesized event) counts as the left key.\npub fn mac_mods(flags: u64) -> Mods {\n    let mut b: u32 = 0;\n    if (flags & (1 << 16)) != 0 {\n        b = b | CAPS;\n    }\n    b = b | side(flags, 1 << 17, 0x02, 0x04, SHIFT_L, SHIFT_R);\n    b = b | side(flags, 1 << 18, 0x01, 0x2000, CTRL_L, CTRL_R);\n    b = b | side(flags, 1 << 19, 0x20, 0x40, ALT_L, ALT_R);\n    b = b | side(flags, 1 << 20, 0x08, 0x10, SUPER_L, SUPER_R);\n    Mods { bits: b }\n}\n\nfn side(flags: u64, any: u64, left: u64, right: u64, l: u32, r: u32) -> u32 {\n    if (flags & any) == 0 {\n        return 0;\n    }\n    let mut b: u32 = 0;\n    if (flags & left) != 0 {\n        b = b | l;\n    }\n    if (flags & right) != 0 {\n        b = b | r;\n    }\n    if b == 0 { l } else { b }\n}\n\n// For flagsChanged: whether the modifier key `code` is now down.\npub fn mac_modifier_down(code: KeyCode, flags: u64) -> bool {\n    let m = mac_mods(flags).bits;\n    match code {\n        KeyCode::ShiftLeft => (m & SHIFT_L) != 0,\n        KeyCode::ShiftRight => (m & SHIFT_R) != 0,\n        KeyCode::ControlLeft => (m & CTRL_L) != 0,\n        KeyCode::ControlRight => (m & CTRL_R) != 0,\n        KeyCode::AltLeft => (m & ALT_L) != 0,\n        KeyCode::AltRight => (m & ALT_R) != 0,\n        KeyCode::SuperLeft => (m & SUPER_L) != 0,\n        KeyCode::SuperRight => (m & SUPER_R) != 0,\n        KeyCode::CapsLock => (m & CAPS) != 0,\n");
    buf_str(out, c"        KeyCode::Fn => (flags & (1 << 23)) != 0,\n        _ => false,\n    }\n}\n\n// The first code point of UTF-8 text (0 for none; U+FFFD for a bad\n// sequence).\npub fn first_char(s: &[u8]) -> u32 {\n    if s.len() as i64 == 0 {\n        return 0;\n    }\n    let b = s[0] as u32;\n    if b < 0x80 {\n        return b;\n    }\n    let n: i64 = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 0 };\n    if n == 0 || s.len() as i64 < n {\n        return 0xFFFD;\n    }\n    let mut c = b & (0x7F >> n);\n    for i in 1..n {\n        c = (c << 6) | (s[i as usize] as u32 & 0x3F);\n    }\n    c\n}\n\n// The byte offset in UTF-8 text of a position counted in UTF-16 units\n// (AppKit's ranges count UTF-16 units; the preedit cursor is reported in\n// bytes). Past the end: the text's length.\npub fn utf16_to_byte(s: &[u8], units: i64) -> i64 {\n    let mut i: i64 = 0;\n    let mut u: i64 = 0;\n    while i < s.len() as i64 && u < units {\n        let b = s[i as usize];\n        let n: i64 = if b >= 0xF0 { 4 } else if b >= 0xE0 { 3 } else if b >= 0xC0 { 2 } else { 1 };\n        u += if n == 4 { 2 } else { 1 };\n        i += n;\n    }\n    if i > s.len() as i64 { s.len() as i64 } else { i }\n}\n\n// The end of the longest prefix of `s` that is at most `max` bytes and\n// does not split a UTF-8 sequence (for text events' inline bytes).\npub fn utf8_cut(s: &[u8], max: i64) -> i64 {\n    if s.len() as i64 <= max {\n        return s.len() as i64;\n    }\n    let mut n = max;\n    while n > 0 && (s[n as usize] & 0xC0) == 0x80 {\n        n -= 1;\n    }\n    n\n}\n// ---- end mod std::window::keys ----\n}\n// ---- mod std::window::objc ----\nmod objc {\n// std::window's Objective-C layer: a minimal stand-in for std::objc\n// (docs/design/gpu.md §2.9, 0.22) until it lands. Everything here is replaced then: the message shapes by\n// objcgen's generated, runtime-checked wrappers (tables appkit.objc and\n");
    buf_str(out, c"// quartzcore.objc, owned by W1), `Id` by `Id<T>`/`Ref<T>`, the pool\n// functions by `objc::pool`, the class functions by `ClassBuilder`.\n//\n// One typed declaration per selector shape (`#[link_name =\n// \"objc_msgSend\"]`): on arm64 objc_msgSend is a trampoline that keeps\n// every argument register and x8, so a call through a declaration whose\n// C types match the method's is exactly the call clang emits. The shapes\n// are named by their result and arguments: p a pointer (an object, a\n// selector, a C string), v void, u u64, i i64, h u16, b BOOL, d f64,\n// r a rect (4 f64, an HFA in v0-v3), z a size and t a point (2 f64), g\n// an NSRange (2 u64 in x0/x1), c a clear colour (4 f64), m an MTLRegion\n// (48 bytes, passed by reference).\n//\n// Every caller is `unsafe`: a shape used with a selector whose types it\n// does not match is undefined behaviour. The callers are cocoa.vl and\n// voltty's renderer (its copy), each call with the selector's documented\n// types, listed in tables/*.objc and checked against the runtime.\n\n// ---- The Objective-C layer (0.23) ----\n\n#[derive(Clone, Copy)] #[repr(C)]\npub struct Point {\n    pub x: f64,\n    pub y: f64,\n}\n\n#[derive(Clone, Copy)] #[repr(C)]\npub struct Size {\n    pub w: f64,\n    pub h: f64,\n}\n\n#[derive(Clone, Copy)] #[repr(C)]\npub struct Rect {\n    pub x: f64,\n    pub y: f64,\n    pub w: f64,\n    pub h: f64,\n}\n\n#[derive(Clone, Copy)] #[repr(C)]\npub struct Range {\n    pub loc: u64,\n    pub len: u64,\n}\n\n// The method-description pair protocol_getMethodDescription returns\n// (16 bytes, in x0/x1).\n#[derive(Clone, Copy)] #[repr(C)]\npub struct MethodDesc {\n    pub name: *mut u8,\n    pub types: *mut u8,\n}\n\n// NSNotFound, the location of an empty NSRange.\npub const NOT_FOUND: u64 = 0x7fffffffffffffff;\n\n// UNSAFE: the Objective-C runtime's C functions, and objc_msgSend once per message shape.\n// SAFETY: the runtime functions' prototypes are objc/runtime.h's; each msg_ shape is the C\n");
    buf_str(out, c"// prototype of the selectors that use it (tables/*.objc lists them, checked against the\n// runtime's encodings), so a call through it is the call clang emits (see above).\n#[link(lib = \"objc\")]\npub extern \"C\" {\n    #[effects(io)]\n    fn objc_getClass(name: *const u8) -> *mut u8;\n    #[effects(io)]\n    fn objc_getProtocol(name: *const u8) -> *mut u8;\n    #[effects(io)]\n    fn sel_registerName(name: *const u8) -> *mut u8;\n    #[effects(io)]\n    fn objc_allocateClassPair(superclass: *mut u8, name: *const u8, extra: u64) -> *mut u8;\n    #[effects(io)]\n    fn objc_registerClassPair(cls: *mut u8);\n    #[effects(io)]\n    fn class_addProtocol(cls: *mut u8, protocol: *mut u8) -> bool;\n    #[effects(io)]\n    fn class_addIvar(cls: *mut u8, name: *const u8, size: u64, align_log2: u8, types: *const u8) -> bool;\n    #[effects(io)]\n    fn class_getInstanceVariable(cls: *mut u8, name: *const u8) -> *mut u8;\n    #[effects(io)]\n    fn class_getInstanceMethod(cls: *mut u8, sel: *mut u8) -> *mut u8;\n    #[effects(io)]\n    fn method_getTypeEncoding(m: *mut u8) -> *mut u8;\n    #[effects(io)]\n    fn ivar_getOffset(ivar: *mut u8) -> i64;\n    #[effects(io)]\n    fn protocol_getMethodDescription(p: *mut u8, sel: *mut u8, required: bool, instance: bool) -> MethodDesc;\n    #[effects(io)]\n    fn objc_autoreleasePoolPush() -> *mut u8;\n    #[effects(io)]\n    fn objc_autoreleasePoolPop(pool: *mut u8);\n    #[effects(io)]\n    fn objc_retain(o: *mut u8) -> *mut u8;\n    #[effects(io)]\n    fn objc_release(o: *mut u8);\n\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p(o: *mut u8, s: *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_p(o: *mut u8, s: *mut u8, a: *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_ppp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8, c: *mut u8) -> *mut u8;\n");
    buf_str(out, c"    #[link_name = \"objc_msgSend\"]\n    fn msg_p_u(o: *mut u8, s: *mut u8, a: u64) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_uu(o: *mut u8, s: *mut u8, a: u64, b: u64) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_d(o: *mut u8, s: *mut u8, a: f64) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_r(o: *mut u8, s: *mut u8, a: Rect) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_ruub(o: *mut u8, s: *mut u8, a: Rect, b: u64, c: u64, d: bool) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_rupp(o: *mut u8, s: *mut u8, a: Rect, b: u64, c: *mut u8, d: *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_uppb(o: *mut u8, s: *mut u8, a: u64, b: *mut u8, c: *mut u8, d: bool) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_uuub(o: *mut u8, s: *mut u8, a: u64, b: u64, c: u64, d: bool) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_ppP(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8, err: *mut *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_pP(o: *mut u8, s: *mut u8, a: *mut u8, err: *mut *mut u8) -> *mut u8;\n    // otherEventWithType:location:modifierFlags:timestamp:windowNumber:\n    // context:subtype:data1:data2:\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_utudipsii(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,\n        ctx: *mut u8, sub: i16, d1: i64, d2: i64) -> *mut u8;\n    // keyEventWithType:location:modifierFlags:timestamp:windowNumber:\n    // context:characters:charactersIgnoringModifiers:isARepeat:keyCode:\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_utudipppbh(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,\n        ctx: *mut u8, chars: *mut u8, plain: *mut u8, repeat: bool, code: u16) -> *mut u8;\n    // mouseEventWithType:location:modifierFlags:timestamp:windowNumber:\n    // context:eventNumber:clickCount:pressure:\n");
    buf_str(out, c"    #[link_name = \"objc_msgSend\"]\n    fn msg_p_utudipiif(o: *mut u8, s: *mut u8, ty: u64, at: Point, flags: u64, time: f64, win: i64,\n        ctx: *mut u8, num: i64, clicks: i64, pressure: f32) -> *mut u8;\n\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v(o: *mut u8, s: *mut u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_p(o: *mut u8, s: *mut u8, a: *mut u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pb(o: *mut u8, s: *mut u8, a: *mut u8, b: bool);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_b(o: *mut u8, s: *mut u8, a: bool);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_u(o: *mut u8, s: *mut u8, a: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_d(o: *mut u8, s: *mut u8, a: f64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_z(o: *mut u8, s: *mut u8, a: Size);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_rp(o: *mut u8, s: *mut u8, a: Rect, b: *mut u8);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_puu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64, c: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_uuuu(o: *mut u8, s: *mut u8, a: u64, b: u64, c: u64, d: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_c(o: *mut u8, s: *mut u8, a: ClearColor);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_mupu(o: *mut u8, s: *mut u8, a: MtlRegion, b: u64, c: *mut u8, d: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pumu(o: *mut u8, s: *mut u8, a: *mut u8, b: u64, c: MtlRegion, d: u64);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pg(o: *mut u8, s: *mut u8, a: *mut u8, b: Range);\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_pgg(o: *mut u8, s: *mut u8, a: *mut u8, b: Range, c: Range);\n\n    #[link_name = \"objc_msgSend\"]\n    fn msg_u(o: *mut u8, s: *mut u8) -> u64;\n");
    buf_str(out, c"    #[link_name = \"objc_msgSend\"]\n    fn msg_u_u(o: *mut u8, s: *mut u8, a: u64) -> u64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_i(o: *mut u8, s: *mut u8) -> i64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_h(o: *mut u8, s: *mut u8) -> u16;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_h_u(o: *mut u8, s: *mut u8, a: u64) -> u16;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b(o: *mut u8, s: *mut u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b_p(o: *mut u8, s: *mut u8, a: *mut u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b_pp(o: *mut u8, s: *mut u8, a: *mut u8, b: *mut u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_b_i(o: *mut u8, s: *mut u8, a: i64) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_d(o: *mut u8, s: *mut u8) -> f64;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_t(o: *mut u8, s: *mut u8) -> Point;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r(o: *mut u8, s: *mut u8) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r_r(o: *mut u8, s: *mut u8, a: Rect) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r_rp(o: *mut u8, s: *mut u8, a: Rect, b: *mut u8) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_g(o: *mut u8, s: *mut u8) -> Range;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_r_gP(o: *mut u8, s: *mut u8, a: Range, b: *mut Range) -> Rect;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_t_tp(o: *mut u8, s: *mut u8, a: Point, b: *mut u8) -> Point;\n    #[link_name = \"objc_msgSend\"]\n    fn msg_v_gP(o: *mut u8, s: *mut u8, a: Range, b: *mut Range);\n}\n\n// UNSAFE: the C library's strlen.\n// SAFETY: string.h's prototype.\npub extern \"C\" {\n    #[effects()]\n    fn strlen(s: *mut u8) -> u64;\n}\n\n// MTLClearColor: four doubles, an HFA passed in v0-v3.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct ClearColor {\n    pub r: f64,\n    pub g: f64,\n    pub b: f64,\n    pub a: f64,\n}\n\n");
    buf_str(out, c"// MTLRegion: an origin and a size of three u64 each (48 bytes: passed\n// by reference to a copy, as AAPCS64 says for large aggregates).\n#[derive(Clone, Copy)] #[repr(C)]\npub struct MtlRegion {\n    pub x: u64,\n    pub y: u64,\n    pub z: u64,\n    pub w: u64,\n    pub h: u64,\n    pub d: u64,\n}\n\n// A class by name; null when the runtime has none (its framework is not\n// loaded).\npub fn class(name: *const u8) -> *mut u8 {\n    // UNSAFE: objc_getClass reads a C string up to its NUL.\n    // SAFETY: objc_getClass reads a NUL-terminated name; every caller (std::window's own\n    // code: this module is private to it) passes a c\"...\" literal.\n    unsafe { objc_getClass(name) }\n}\n\n// A selector by name (registered on first use).\npub fn sel(name: *const u8) -> *mut u8 {\n    // UNSAFE: sel_registerName reads a C string up to its NUL.\n    // SAFETY: as `class`: a NUL-terminated literal from std::window's own code.\n    unsafe { sel_registerName(name) }\n}\n\n// The text of a C string as a slice, valid while the string is (for an\n// NSString's UTF8String: until the autorelease pool around it is\n// popped).\n// UNSAFE: p is a C string, read up to its NUL, whose life no type states.\n// SAFETY: the caller's: p is null or NUL-terminated and outlives the view.\npub unsafe fn cstr(p: *mut u8) -> &'static [u8] {\n    if p == 0 as *mut u8 {\n        return b\"\";\n    }\n    crate::slice::from_raw_parts(p.add((0) as usize), (strlen(p) as i64 - (0)) as usize)\n}\n\n// The type encoding of an instance method `name` of class `cls` (or of\n// its superclasses), or of the protocol `proto`'s method: the encoding a\n// method added to a subclass must have. Null when neither has it.\npub fn method_types(cls: *mut u8, proto: *mut u8, name: *const u8) -> *const u8 {\n    let s = sel(name);\n    // UNSAFE: the runtime's metadata queries are C calls on raw class and protocol pointers.\n    // SAFETY: the runtime's metadata queries take a class (or null), a\n");
    buf_str(out, c"    // protocol (or null) and a selector; they return null or a pointer\n    // into the runtime's own (immortal) metadata.\n    unsafe {\n        if cls != 0 as *mut u8 {\n            let m = class_getInstanceMethod(cls, s);\n            if m != 0 as *mut u8 {\n                return method_getTypeEncoding(m);\n            }\n        }\n        if proto != 0 as *mut u8 {\n            let d = protocol_getMethodDescription(proto, s, true, true);\n            if d.types != 0 as *mut u8 {\n                return d.types;\n            }\n            let o = protocol_getMethodDescription(proto, s, false, true);\n            return o.types;\n        }\n    }\n    0 as *mut u8\n}\n\n// An autoreleased NSString with the bytes of `s` (UTF-8). Valid until\n// the enclosing autorelease pool is popped; `retain` keeps it longer.\npub fn nsstring(s: &[u8]) -> *mut u8 {\n    // UNSAFE: messages sent by objc_msgSend, C calls the compiler cannot check.\n    // SAFETY: -[NSString initWithBytes:length:encoding:] reads exactly\n    // `len` bytes at `ptr`; `s` is a live slice. NSUTF8StringEncoding is\n    // 4. alloc/init returns +1, balanced by autorelease.\n    unsafe {\n        let a = msg_p(class(c\"NSString\"), sel(c\"alloc\"));\n        let o = msg_p_puu(a, sel(c\"initWithBytes:length:encoding:\"), s.as_ptr(), s.len() as u64, 4);\n        msg_p(o, sel(c\"autorelease\"))\n    }\n}\n\n// UNSAFE: objc_msgSend for initWithBytes:length:encoding:.\n// SAFETY: its C prototype: (id, SEL, const void *, NSUInteger, NSStringEncoding) -> id.\npub extern \"C\" {\n    #[link_name = \"objc_msgSend\"]\n    fn msg_p_puu(o: *mut u8, s: *mut u8, a: *const u8, b: u64, c: u64) -> *mut u8;\n}\n\n// The UTF-8 bytes of an NSString (or NSAttributedString's string), a\n// view valid until the current autorelease pool is popped.\npub fn nsstring_bytes(o: *mut u8) -> &'static [u8] {\n    if o == 0 as *mut u8 {\n        return b\"\";\n    }\n");
    buf_str(out, c"    // UNSAFE: a message to a raw object pointer, and its C string viewed.\n    // SAFETY: `o` is an NSString (callers pass the results of methods\n    // typed NSString); UTF8String returns an inner pointer that lives as\n    // long as the pool the caller is inside.\n    unsafe {\n        let p = msg_p(o, sel(c\"UTF8String\"));\n        cstr(p)\n    }\n}\n\npub fn retain(o: *mut u8) -> *mut u8 {\n    // UNSAFE: objc_retain is a C call on a raw object pointer.\n    // SAFETY: objc_retain takes any live object or nil; std::window's callers pass ones they\n    // hold.\n    unsafe { objc_retain(o) }\n}\n\npub fn release(o: *mut u8) {\n    // UNSAFE: objc_release is a C call on a raw object pointer.\n    // SAFETY: callers release only what they retained (or got at +1).\n    unsafe { objc_release(o); }\n}\n\npub fn pool_push() -> *mut u8 {\n    // UNSAFE: the runtime's pool push, a C call.\n    // SAFETY: push and pop are paired by every caller, on the main thread.\n    unsafe { objc_autoreleasePoolPush() }\n}\n\npub fn pool_pop(p: *mut u8) {\n    // UNSAFE: the runtime's pool pop, a C call.\n    // SAFETY: `p` is the token of the matching push.\n    unsafe { objc_autoreleasePoolPop(p); }\n}\n// ---- end mod std::window::objc ----\n}\n// ---- mod std::window::script ----\nmod script {\n// std::window::script (0.25.4): the scripted event loop (below).\n\nuse crate::alloc::Allocator;\nuse crate::fmt::Display;\n\nuse super::{Button, Event, Key, Mouse, MouseAction, Scroll, Size, Text, WindowId};\nuse super::keys::{ALT_L, CTRL_L, KeyCode, Logical, Mods, Named, SHIFT_L, SUPER_L};\n\n// ---- Windows: the scripted event loop (0.25.4) ----\n\n// std::window::script (0.25.4): the scripted event loop, for testing a\n// windowed program without a display. When the environment has\n// VOLE_WINDOW_SCRIPT, `App::new_in` opens no window server: the events\n// come from the script, in order, each Frame as soon as the program asks\n");
    buf_str(out, c"// for it, and a window's `raw_surface()` is null, which std::gpu takes\n// for `RawSurface::Headless` (frames offscreen, at the scripted size).\n// The program runs its own event loop, unchanged.\n//\n// The script is VOLE_WINDOW_SCRIPT's value, or the file it names after\n// an `@`; commands are separated by newlines or `;`, `#` starts a\n// comment. Coordinates are physical pixels from the content's top-left.\n//\n//   size 640x480 [2]           the window's size (and scale; default: the\n//                              WindowDesc's, scale 1), before any event\n//   frames N                   up to N Event::Frame, one for each\n//                              request_frame (none asked for: none sent)\n//   key K | keydown K | keyup K\n//                              a key: a character (`a`, `+`, `A` is\n//                              shift+a) or a name (space enter tab\n//                              backspace escape delete insert home end\n//                              pageup pagedown left right up down f1..f20),\n//                              after modifiers (shift+ ctrl+ alt+ cmd+);\n//                              `key` is a press and a release, and a\n//                              printable press is followed by its Text\n//   move X Y                   the pointer moves\n//   press [B] X Y | release [B] X Y | click [B] X Y\n//                              B is left (the default), right or middle;\n//                              a trailing shift, ctrl, alt or cmd holds it\n//   scroll DY [DX]             a wheel, in lines (positive: up)\n//   resize WxH                 Event::Resize to that size\n//   focus on|off               Event::Focus\n//   shot FILE.ppm              the next frame presented (std::gpu) is also\n//                              written to FILE, a PPM\n//   close | quit               Event::Close, Event::Quit\n//\n// When the script ends the program gets Close for each open window, then\n");
    buf_str(out, c"// Quit; a program that still waits for an event after that is stopped\n// (exit 1) with a line saying so.\n\n// What a Window reaches without its App (plain values; the main thread's).\nstatic mut ON: bool = false;\nstatic mut WIDTH: i64 = 0;\nstatic mut HEIGHT: i64 = 0;\nstatic mut SCALE: f64 = 1.0;\n// Bit n: window n asked for a frame (ids 1..63).\nstatic mut REQUESTS: u64 = 0;\n// Bit n: window n was closed.\nstatic mut CLOSED: u64 = 0;\nstatic mut FULLSCREEN: bool = false;\nstatic mut FOCUSED: bool = true;\n\n/// True when this process runs a scripted event loop (VOLE_WINDOW_SCRIPT).\npub fn active() -> bool {\n    get_on()\n}\n\npub fn request_frame(id: WindowId) {\n    if id.n >= 0 && id.n < 64 {\n        set_requests(get_requests() | (1u64 << id.n as u64));\n    }\n}\n\n/// The window was closed (or dropped): no event names it again.\npub fn closed(id: WindowId) {\n    if id.n >= 0 && id.n < 64 {\n        set_closed(get_closed() | (1u64 << id.n as u64));\n        set_requests(get_requests() & !(1u64 << id.n as u64));\n    }\n}\n\nfn open(n: i64) -> bool {\n    n >= 0 && n < 64 && (get_closed() & (1u64 << n as u64)) == 0\n}\n\npub fn size() -> Size {\n    Size { w: get_width(), h: get_height(), scale: get_scale() }\n}\n\npub fn set_fullscreen(on: bool) {\n    set_fullscreen_value(on);\n}\n\npub fn is_fullscreen() -> bool {\n    get_fullscreen_value()\n}\n\npub fn focused() -> bool {\n    get_focused()\n}\n\nenum Step<A: Allocator> {\n    Size(i64, i64, f64),\n    Frames(i64),\n    Key(KeyCode, Logical, Mods, bool, u32),\n    Mouse(MouseAction, Button, f64, f64, Mods),\n    Scroll(f64, f64),\n    Resize(i64, i64),\n    Focus(bool),\n    Shot(String<A>),\n    Close,\n    Quit,\n}\n\n/// The scripted backend: the parsed script and where it is.\npub struct Script<A: Allocator> {\n    steps: Vec<Step<A>, A>,\n    at: i64,\n    q: Vec<Event, A>,\n    head: i64,\n    frames: i64,\n    wins: Vec<i64, A>,\n    // 0: the script runs; 1: Close sent; 2: Quit sent\n");
    buf_str(out, c"    ended: i64,\n    sized: bool,\n}\n\nimpl Script<Gpa> {\n    /// The script of VOLE_WINDOW_SCRIPT, if the variable is set; a script\n    /// that does not parse stops the program (exit 2) with its line.\n    pub fn from_env(gpa: Gpa) -> Option<Script<Gpa>> {\n        let raw = match crate::env::var_os_in(\"VOLE_WINDOW_SCRIPT\", gpa) {\n            Some(v) => v,\n            None => return None,\n        };\n        let mut text: Vec<u8, Gpa> = Vec::new_in(gpa);\n        if raw.len() as i64 > 0 && raw[0] == b'@' {\n            match crate::fs::read_in(\n                str::from_utf8(&raw.as_slice()[1..raw.len() as i64 as usize]).unwrap(), gpa) {\n                Ok(bytes) => text.extend_from_slice(bytes.as_slice()),\n                Err(_) => {\n                    let name = &raw.as_slice()[1..raw.len() as i64 as usize];\n                    fail(0i64, { let name = str::from_utf8(name).unwrap(); format_args(\"cannot read the script file '{name}'\") }, b\"VOLE_WINDOW_SCRIPT=@FILE names a file, relative to the program's directory\");\n                }\n            }\n        } else {\n            text.extend_from_slice(raw.as_slice());\n        }\n        let s = match str::from_utf8(text.as_slice()) {\n            Ok(s) => s,\n            Err(_) => fail(0i64, \"the script is not UTF-8\", b\"write it in UTF-8\"),\n        };\n        let mut steps: Vec<Step<Gpa>, Gpa> = Vec::new_in(gpa);\n        let mut line: i64 = 0;\n        for l in s.lines() {\n            line += 1;\n            let code = match l.split_once('#') {\n                Some((before, _)) => before,\n                None => l,\n            };\n            for cmd in code.split(b';' as char) {\n                let c = cmd.trim();\n                if c.len() as i64 > 0 {\n                    steps.push(command(c, line, gpa));\n                }\n            }\n        }\n        set_on(true);\n        set_width(0);\n        set_height(0);\n        set_scale(1.0);\n        set_requests(0);\n");
    buf_str(out, c"        set_closed(0);\n        Some(Script {\n            steps: steps, at: 0, q: Vec::new_in(gpa), head: 0, frames: 0,\n            wins: Vec::new_in(gpa), ended: 0, sized: false,\n        })\n    }\n\n    /// A window: its size is the script's `size`, or desc's at scale 1.\n    pub fn open(&mut self, w: i64, h: i64, id: WindowId) {\n        if !self.sized {\n            // a leading `size` sets it before the first window\n            if self.at < self.steps.len() as i64 {\n                match &self.steps[self.at as usize] {\n                    Step::Size(sw, sh, sc) => {\n                        set_width(*sw);\n                        set_height(*sh);\n                        set_scale(*sc);\n                        self.at += 1;\n                    }\n                    _ => {\n                        set_width(w);\n                        set_height(h);\n                        set_scale(1.0);\n                    }\n                }\n            } else {\n                set_width(w);\n                set_height(h);\n                set_scale(1.0);\n            }\n            self.sized = true;\n        }\n        self.wins.push(id.n);\n        self.q.push(Event::Resize(id, size()));\n    }\n\n    // The window events go to: the last one opened and not closed.\n    fn win(&self) -> WindowId {\n        let mut i = self.wins.len() as i64 - 1;\n        while i >= 0 {\n            if open(self.wins[i as usize]) {\n                return WindowId { n: self.wins[i as usize] };\n            }\n            i -= 1;\n        }\n        WindowId { n: 0 }\n    }\n\n    // A frame for a window that asked for one, if any did.\n    fn frame(&mut self) -> Option<Event> {\n        for i in 0..self.wins.len() as i64 {\n            let n = self.wins[i as usize];\n            if open(n) && n >= 0 && n < 64 && (get_requests() & (1u64 << n as u64)) != 0 {\n                set_requests(get_requests() & !(1u64 << n as u64));\n");
    buf_str(out, c"                return Some(Event::Frame(WindowId { n: n }));\n            }\n        }\n        None\n    }\n\n    /// The next event: the queued ones, then the script's; `ms` is\n    /// ignored (nothing waits on a clock).\n    pub fn next_event(&mut self, ms: i64) -> Option<Event> {\n        if self.head < self.q.len() as i64 {\n            let e = self.q[self.head as usize];\n            self.head += 1;\n            if self.head == self.q.len() as i64 {\n                self.q.clear();\n                self.head = 0;\n            }\n            return Some(e);\n        }\n        loop {\n            if self.frames > 0 {\n                match self.frame() {\n                    Some(e) => {\n                        self.frames -= 1;\n                        return Some(e);\n                    }\n                    // nothing asked for a frame: the program is idle\n                    None => self.frames = 0,\n                }\n            }\n            if self.at >= self.steps.len() as i64 {\n                return self.end();\n            }\n            let i = self.at;\n            self.at += 1;\n            let w = self.win();\n            match &self.steps[i as usize] {\n                Step::Size(_, _, _) => fail(0i64, \"'size' comes first, before any other command\",\n                    b\"move it to the start of the script\"),\n                Step::Frames(n) => self.frames = *n,\n                Step::Key(code, key, mods, pressed, ch) => {\n                    let text = *pressed && *ch != 0 && !mods.ctrl() && !mods.sup();\n                    if text {\n                        self.q.push(Event::Text(text_of(w, *ch)));\n                    }\n                    return Some(Event::Key(Key {\n                        win: w, code: *code, key: *key, mods: *mods, pressed: *pressed,\n                        repeat: false, ime: false, text_follows: text,\n                    }));\n                }\n");
    buf_str(out, c"                Step::Mouse(action, button, x, y, m) => {\n                    let mut mods = *m;\n                    if (mods.bits & CLICK) != 0 {\n                        mods = Mods { bits: mods.bits & !CLICK };\n                        self.q.push(Event::Mouse(Mouse {\n                            win: w, action: MouseAction::Release, button: *button, x: *x, y: *y,\n                            mods: mods, clicks: 0,\n                        }));\n                    }\n                    let clicks = match action {\n                        MouseAction::Press => 1,\n                        _ => 0,\n                    };\n                    return Some(Event::Mouse(Mouse {\n                        win: w, action: *action, button: *button, x: *x, y: *y, mods: mods,\n                        clicks: clicks,\n                    }));\n                }\n                Step::Scroll(dy, dx) => {\n                    return Some(Event::Scroll(Scroll {\n                        win: w, dx: *dx, dy: *dy, precise: false, mods: Mods::none(),\n                    }));\n                }\n                Step::Resize(rw, rh) => {\n                    set_width(*rw);\n                    set_height(*rh);\n                    return Some(Event::Resize(w, size()));\n                }\n                Step::Focus(on) => {\n                    set_focused(*on);\n                    return Some(Event::Focus(w, *on));\n                }\n                Step::Shot(path) => {\n                    crate::capture::capture_next_frame(path.as_str());\n                }\n                Step::Close => return Some(Event::Close(w)),\n                Step::Quit => return Some(Event::Quit),\n            }\n        }\n    }\n\n    // The script is over: Close for each open window, Quit, then stop.\n    fn end(&mut self) -> Option<Event> {\n        if crate::capture::capture_pending() {\n");
    buf_str(out, c"            eprintln(\"window.script: the script ended with a 'shot' no frame was presented after: put 'frames 1' after it | help: a shot is the next frame presented (Frame::present)\");\n            crate::capture::capture_cancel();\n        }\n        if self.ended == 0 {\n            self.ended = 1;\n            for i in 0..self.wins.len() as i64 {\n                if open(self.wins[i as usize]) {\n                    self.q.push(Event::Close(WindowId { n: self.wins[i as usize] }));\n                }\n            }\n            self.q.push(Event::Quit);\n            return self.next_event(0);\n        }\n        eprintln(\"window.script: the script has ended and the program waits for another event (it was sent Close and Quit) | help: end the event loop on Event::Close or Event::Quit, or end the script with the key that quits\");\n        crate::process::exit(1i32)\n    }\n}\n\nfn text_of(w: WindowId, ch: u32) -> Text {\n    let mut t = Text { win: w, len: 0, bytes: [0u8; 30] };\n    let mut n: i64 = 0;\n    if ch < 0x80 {\n        t.bytes[0] = ch as u8;\n        n = 1;\n    } else if ch < 0x800 {\n        t.bytes[0] = (0xC0 | (ch >> 6)) as u8;\n        t.bytes[1] = (0x80 | (ch & 0x3F)) as u8;\n        n = 2;\n    } else if ch < 0x10000 {\n        t.bytes[0] = (0xE0 | (ch >> 12)) as u8;\n        t.bytes[1] = (0x80 | ((ch >> 6) & 0x3F)) as u8;\n        t.bytes[2] = (0x80 | (ch & 0x3F)) as u8;\n        n = 3;\n    } else {\n        t.bytes[0] = (0xF0 | (ch >> 18)) as u8;\n        t.bytes[1] = (0x80 | ((ch >> 12) & 0x3F)) as u8;\n        t.bytes[2] = (0x80 | ((ch >> 6) & 0x3F)) as u8;\n        t.bytes[3] = (0x80 | (ch & 0x3F)) as u8;\n        n = 4;\n    }\n    t.len = n as u8;\n    t\n}\n\n// Stops the program over the script: line 0 is the script as a whole.\nfn fail<T: Display>(line: i64, what: T, help: &[u8]) -> ! {\n    if line > 0 {\n        eprintln(\"window.script: VOLE_WINDOW_SCRIPT line {line}: {what} | help: {help}\",\n");
    buf_str(out, c"            help = str::from_utf8(help).unwrap());\n    } else {\n        eprintln(\"window.script: VOLE_WINDOW_SCRIPT: {what} | help: {help}\",\n            help = str::from_utf8(help).unwrap());\n    }\n    crate::process::exit(2i32)\n}\n\nfn num(s: &str, line: i64, what: &[u8]) -> f64 {\n    match s.parse::<f64>() {\n        Ok(v) => v,\n        Err(_) => fail(line,\n            { let what = str::from_utf8(what).unwrap();\n                format_args(\"'{s}' is not a number ({what})\") }, b\"write a number: 120, 64.5\"),\n    }\n}\n\nfn whole(s: &str, line: i64, what: &[u8]) -> i64 {\n    match s.parse::<i64>() {\n        Ok(v) => v,\n        Err(_) => fail(line,\n            { let what = str::from_utf8(what).unwrap();\n                format_args(\"'{s}' is not a whole number ({what})\") }, b\"write a whole number: 3\"),\n    }\n}\n\nfn dims(s: &str, line: i64) -> (i64, i64) {\n    match s.split_once('x') {\n        Some((a, b)) => {\n            let w = whole(a, line, b\"a width\");\n            let h = whole(b, line, b\"a height\");\n            if w < 1 || h < 1 {\n                fail(line, format_args(\"'{s}' is not a size\"), b\"write WxH, at least 1x1: 640x480\");\n            }\n            (w, h)\n        }\n        None => fail(line, format_args(\"'{s}' is not a size\"), b\"write WxH: 640x480\"),\n    }\n}\n\nfn mod_bit(s: &str) -> u32 {\n    if s == \"shift\" { return SHIFT_L; }\n    if s == \"ctrl\" { return CTRL_L; }\n    if s == \"alt\" || s == \"option\" { return ALT_L; }\n    if s == \"cmd\" || s == \"super\" { return SUPER_L; }\n    0\n}\n\nfn button_of(s: &str) -> Option<Button> {\n    if s == \"left\" { return Some(Button::Left); }\n    if s == \"right\" { return Some(Button::Right); }\n    if s == \"middle\" { return Some(Button::Middle); }\n    None\n}\n\nfn command(c: &str, line: i64, gpa: Gpa) -> Step<Gpa> {\n    let mut words: Vec<&str, Gpa> = Vec::new_in(gpa);\n    for w in c.split_whitespace() {\n        words.push(w);\n    }\n");
    buf_str(out, c"    let op = words[0];\n    let n = words.len() as i64;\n    if op == \"size\" {\n        if n < 2\n            || n > 3 { fail(line, \"'size' takes WxH and an optional scale\", b\"size 640x480 2\"); }\n        let (w, h) = dims(words[1], line);\n        let scale = if n == 3 { num(words[2], line, b\"a scale\") } else { 1.0 };\n        if scale <= 0.0 { fail(line, \"the scale is positive\", b\"size 640x480 2\"); }\n        return Step::Size(w, h, scale);\n    }\n    if op == \"frames\" {\n        if n != 2 { fail(line, \"'frames' takes a count\", b\"frames 3\"); }\n        return Step::Frames(whole(words[1], line, b\"a count of frames\"));\n    }\n    if op == \"key\" || op == \"keydown\" || op == \"keyup\" {\n        if n\n            != 2 {\n            fail(line, format_args(\"'{op}' takes one key\"),\n                b\"key space, key shift+r, keydown left\");\n        }\n        let step = key_step(words[1], op != \"keyup\", line);\n        return step;\n    }\n    if op == \"move\" || op == \"press\" || op == \"release\" || op == \"click\" {\n        let mut i: i64 = 1;\n        let mut button = Button::Left;\n        if n > 1 {\n            match button_of(words[1]) {\n                Some(b) => {\n                    button = b;\n                    i = 2;\n                }\n                None => {}\n            }\n        }\n        if op == \"move\" { button = Button::None; }\n        if n < i + 2 { fail(line, format_args(\"'{op}' takes X Y\"), b\"press left 120 80\"); }\n        let x = num(words[i as usize], line, b\"X\");\n        let y = num(words[(i + 1) as usize], line, b\"Y\");\n        let mut bits: u32 = 0;\n        for k in i + 2..n {\n            let b = mod_bit(words[k as usize]);\n            if b == 0 {\n                fail(line, format_args(\"'{}' is not a modifier\", words[k as usize]),\n                    b\"shift, ctrl, alt or cmd\");\n            }\n            bits = bits | b;\n        }\n        let mods = Mods { bits: bits };\n");
    buf_str(out, c"        if op == \"move\" { return Step::Mouse(MouseAction::Move, button, x, y, mods); }\n        if op == \"press\" { return Step::Mouse(MouseAction::Press, button, x, y, mods); }\n        if op == \"release\" { return Step::Mouse(MouseAction::Release, button, x, y, mods); }\n        // click: a press now, its release right after (the caller queues it)\n        return Step::Mouse(MouseAction::Press, button, x, y, Mods { bits: bits | CLICK });\n    }\n    if op == \"scroll\" {\n        if n < 2 || n > 3 { fail(line, \"'scroll' takes DY and an optional DX\", b\"scroll 3\"); }\n        let dy = num(words[1], line, b\"DY\");\n        let dx = if n == 3 { num(words[2], line, b\"DX\") } else { 0.0 };\n        return Step::Scroll(dy, dx);\n    }\n    if op == \"resize\" {\n        if n != 2 { fail(line, \"'resize' takes WxH\", b\"resize 800x600\"); }\n        let (w, h) = dims(words[1], line);\n        return Step::Resize(w, h);\n    }\n    if op == \"focus\" {\n        if n != 2 || (words[1] != \"on\" && words[1] != \"off\") {\n            fail(line, \"'focus' takes on or off\", b\"focus off\");\n        }\n        return Step::Focus(words[1] == \"on\");\n    }\n    if op == \"shot\" {\n        if n != 2 { fail(line, \"'shot' takes a file\", b\"shot frame.ppm\"); }\n        let mut path: String<Gpa> = String::new_in(gpa);\n        path.push_str(words[1]);\n        return Step::Shot(path);\n    }\n    if op == \"close\" && n == 1 { return Step::Close; }\n    if op == \"quit\" && n == 1 { return Step::Quit; }\n    fail(line, format_args(\"unknown command '{c}'\"),\n        b\"the commands: size, frames, key, keydown, keyup, move, press, release, click, scroll, resize, focus, shot, close, quit\")\n}\n\n// A bit no modifier uses: marks a `click`'s press (its release follows).\nconst CLICK: u32 = 1u32 << 30;\n\nfn key_step(spec: &str, pressed: bool, line: i64) -> Step<Gpa> {\n    let mut bits: u32 = 0;\n    let mut rest = spec;\n    loop {\n");
    buf_str(out, c"        match rest.split_once('+') {\n            Some((m, after)) => {\n                // `+` alone, or a trailing `+` (ctrl++), is the key itself\n                if m.len() as i64 == 0 || after.len() as i64 == 0 { break; }\n                let b = mod_bit(m);\n                if b == 0 {\n                    fail(line, format_args(\"'{m}' is not a modifier\"),\n                        b\"shift+, ctrl+, alt+ or cmd+ before the key\");\n                }\n                bits = bits | b;\n                rest = after;\n            }\n            None => break,\n        }\n    }\n    if rest.len() as i64 > 1 && rest.ends_with(\"+\")\n        && mod_bit(rest[0..(rest.len() as i64 - 1) as usize]) != 0 {\n        bits = bits | mod_bit(rest[0..(rest.len() as i64 - 1) as usize]);\n        rest = \"+\";\n    }\n    match named(rest) {\n        Some((code, key, ch)) => Step::Key(code, key, Mods { bits: bits }, pressed, ch),\n        None => {\n            let mut it = rest.chars().map(|c| c as u32);\n            let c = match it.next() {\n                Some(c) => c,\n                None => fail(line, \"a key is missing\", b\"key a\"),\n            };\n            if it.next().is_some() {\n                fail(line, format_args(\"unknown key '{rest}'\"),\n                    b\"a character, or space enter tab backspace escape delete insert home end pageup pagedown left right up down f1..f20\");\n            }\n            if c >= b'A' as u32 && c <= b'Z' as u32 {\n                bits = bits | SHIFT_L;\n            }\n            Step::Key(char_code(c), Logical::Char(c), Mods { bits: bits }, pressed, c)\n        }\n    }\n}\n\nfn named(s: &str) -> Option<(KeyCode, Logical, u32)> {\n    if s == \"space\" { return Some((KeyCode::Space, Logical::Char(b' ' as u32), b' ' as u32)); }\n    if s == \"enter\"\n        || s == \"return\" { return Some((KeyCode::Enter, Logical::Named(Named::Enter), 0)); }\n");
    buf_str(out, c"    if s == \"tab\" { return Some((KeyCode::Tab, Logical::Named(Named::Tab), 0)); }\n    if s == \"backspace\" { return Some((KeyCode::Backspace, Logical::Named(Named::Backspace), 0)); }\n    if s == \"escape\"\n        || s == \"esc\" { return Some((KeyCode::Escape, Logical::Named(Named::Escape), 0)); }\n    if s == \"delete\" { return Some((KeyCode::Delete, Logical::Named(Named::Delete), 0)); }\n    if s == \"insert\" { return Some((KeyCode::Insert, Logical::Named(Named::Insert), 0)); }\n    if s == \"home\" { return Some((KeyCode::Home, Logical::Named(Named::Home), 0)); }\n    if s == \"end\" { return Some((KeyCode::End, Logical::Named(Named::End), 0)); }\n    if s == \"pageup\" { return Some((KeyCode::PageUp, Logical::Named(Named::PageUp), 0)); }\n    if s == \"pagedown\" { return Some((KeyCode::PageDown, Logical::Named(Named::PageDown), 0)); }\n    if s == \"left\" { return Some((KeyCode::ArrowLeft, Logical::Named(Named::ArrowLeft), 0)); }\n    if s == \"right\" { return Some((KeyCode::ArrowRight, Logical::Named(Named::ArrowRight), 0)); }\n    if s == \"up\" { return Some((KeyCode::ArrowUp, Logical::Named(Named::ArrowUp), 0)); }\n    if s == \"down\" { return Some((KeyCode::ArrowDown, Logical::Named(Named::ArrowDown), 0)); }\n    if s.len() as i64 >= 2 && s.len() as i64 <= 3 && s.starts_with(\"f\") {\n        match s[1..].parse::<i64>() {\n            Ok(n) => {\n                if n >= 1 && n <= 20 {\n                    return Some((f_code(n), Logical::F(n), 0));\n                }\n            }\n            Err(_) => {}\n        }\n    }\n    None\n}\n\nfn f_code(n: i64) -> KeyCode {\n    match n {\n        1 => KeyCode::F1,\n        2 => KeyCode::F2,\n        3 => KeyCode::F3,\n        4 => KeyCode::F4,\n        5 => KeyCode::F5,\n        6 => KeyCode::F6,\n        7 => KeyCode::F7,\n        8 => KeyCode::F8,\n        9 => KeyCode::F9,\n        10 => KeyCode::F10,\n        11 => KeyCode::F11,\n        12 => KeyCode::F12,\n        13 => KeyCode::F13,\n");
    buf_str(out, c"        14 => KeyCode::F14,\n        15 => KeyCode::F15,\n        16 => KeyCode::F16,\n        17 => KeyCode::F17,\n        18 => KeyCode::F18,\n        19 => KeyCode::F19,\n        _ => KeyCode::F20,\n    }\n}\n\n// The physical key of a character on a US (ANSI) keyboard.\nfn char_code(c: u32) -> KeyCode {\n    let l = if c >= b'A' as u32 && c <= b'Z' as u32 { c + 32 } else { c };\n    // each key's character, then its shifted one\n    match l {\n        0x61 => KeyCode::KeyA,\n        0x62 => KeyCode::KeyB,\n        0x63 => KeyCode::KeyC,\n        0x64 => KeyCode::KeyD,\n        0x65 => KeyCode::KeyE,\n        0x66 => KeyCode::KeyF,\n        0x67 => KeyCode::KeyG,\n        0x68 => KeyCode::KeyH,\n        0x69 => KeyCode::KeyI,\n        0x6A => KeyCode::KeyJ,\n        0x6B => KeyCode::KeyK,\n        0x6C => KeyCode::KeyL,\n        0x6D => KeyCode::KeyM,\n        0x6E => KeyCode::KeyN,\n        0x6F => KeyCode::KeyO,\n        0x70 => KeyCode::KeyP,\n        0x71 => KeyCode::KeyQ,\n        0x72 => KeyCode::KeyR,\n        0x73 => KeyCode::KeyS,\n        0x74 => KeyCode::KeyT,\n        0x75 => KeyCode::KeyU,\n        0x76 => KeyCode::KeyV,\n        0x77 => KeyCode::KeyW,\n        0x78 => KeyCode::KeyX,\n        0x79 => KeyCode::KeyY,\n        0x7A => KeyCode::KeyZ,\n        0x30 | 0x29 => KeyCode::Digit0,\n        0x31 | 0x21 => KeyCode::Digit1,\n        0x32 | 0x40 => KeyCode::Digit2,\n        0x33 | 0x23 => KeyCode::Digit3,\n        0x34 | 0x24 => KeyCode::Digit4,\n        0x35 | 0x25 => KeyCode::Digit5,\n        0x36 | 0x5E => KeyCode::Digit6,\n        0x37 | 0x26 => KeyCode::Digit7,\n        0x38 | 0x2A => KeyCode::Digit8,\n        0x39 | 0x28 => KeyCode::Digit9,\n        0x2D | 0x5F => KeyCode::Minus,\n        0x3D | 0x2B => KeyCode::Equal,\n        0x5B | 0x7B => KeyCode::BracketLeft,\n        0x5D | 0x7D => KeyCode::BracketRight,\n        0x5C | 0x7C => KeyCode::Backslash,\n        0x3B | 0x3A => KeyCode::Semicolon,\n        0x27 | 0x22 => KeyCode::Quote,\n");
    buf_str(out, c"        0x60 | 0x7E => KeyCode::Backquote,\n        0x2C | 0x3C => KeyCode::Comma,\n        0x2E | 0x3E => KeyCode::Period,\n        0x2F | 0x3F => KeyCode::Slash,\n        0x20 => KeyCode::Space,\n        _ => KeyCode::Unidentified,\n    }\n}\n\n// (0.28.0) ON's accessors: every use of it is one of them.\nfn get_on() -> bool {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { ON }\n}\n\nfn set_on(v: bool) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        ON = v;\n    }\n}\n\n// (0.28.0) WIDTH's accessors: every use of it is one of them.\nfn get_width() -> i64 {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { WIDTH }\n}\n\nfn set_width(v: i64) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        WIDTH = v;\n    }\n}\n\n// (0.28.0) HEIGHT's accessors: every use of it is one of them.\nfn get_height() -> i64 {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { HEIGHT }\n}\n\n");
    buf_str(out, c"fn set_height(v: i64) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        HEIGHT = v;\n    }\n}\n\n// (0.28.0) SCALE's accessors: every use of it is one of them.\nfn get_scale() -> f64 {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { SCALE }\n}\n\nfn set_scale(v: f64) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        SCALE = v;\n    }\n}\n\n// (0.28.0) REQUESTS's accessors: every use of it is one of them.\nfn get_requests() -> u64 {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { REQUESTS }\n}\n\nfn set_requests(v: u64) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        REQUESTS = v;\n    }\n}\n\n// (0.28.0) CLOSED's accessors: every use of it is one of them.\nfn get_closed() -> u64 {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n");
    buf_str(out, c"    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { CLOSED }\n}\n\nfn set_closed(v: u64) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        CLOSED = v;\n    }\n}\n\n// (0.28.0) FULLSCREEN's accessors: every use of it is one of them.\nfn get_fullscreen_value() -> bool {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { FULLSCREEN }\n}\n\nfn set_fullscreen_value(v: bool) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        FULLSCREEN = v;\n    }\n}\n\n// (0.28.0) FOCUSED's accessors: every use of it is one of them.\nfn get_focused() -> bool {\n    // UNSAFE: a static mut read.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe { FOCUSED }\n}\n\nfn set_focused(v: bool) {\n    // UNSAFE: a static mut written.\n    // SAFETY: a plain value of the scripted event loop, which the main thread alone reads and\n    // writes (an App and its Windows are the main thread's); read or written whole, no\n    // reference to it is kept.\n    unsafe {\n        FOCUSED = v;\n    }\n}\n// ---- end mod std::window::script ----\n}\n// ---- end mod std::window ----\n}\n");
    buf_str(out, c"// ---- mod std::test ----\npub mod test {\n// std::test: what `#[property]` tests and `#[fuzz]` targets draw their\n// values from, and the runtime of a test build (0.28.0: MVS's\n// compiler/std/flat/test.vl and fuzz.vl in std's spellings). `volec\n// test` builds the program with `--test-build`: the compiler\n// (front/tests) writes a `main` that runs the test its arguments name,\n// and a generator for each property's parameters, built from their types\n// (an `impl Arbitrary` where there is one). A value is drawn from a\n// choice sequence of u64s, and smaller choices make simpler values (0: 0,\n// false, empty, None, the first variant): a failing case is shrunk by\n// shortening and lowering its sequence, then replaying it.\n//\n// A program names Arbitrary, Gen and assert_snapshot; the rest is what\n// the compiler's test code calls (test_begin, run_property, ...). A\n// property's cases each run in a child process (fork), one at a time, on\n// the runner's one thread: the runtime's statics are that thread's.\n// mvs: std::Arbitrary, std::Gen, std::assert_snapshot\n\nuse crate::alloc::{Allocator, Gpa};\nuse crate::fmt::Debug;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// A type's own generator, used in place of the structural one.\npub trait Arbitrary {\n    fn arbitrary(g: &mut Gen<Gpa>) -> Self;\n}\n\n// A case's choices and where it is in them.\n// std: changed: the choices are the Gen's own Vec (MVS: a view)\npub struct Gen<A: Allocator> {\n    choices: Vec<u64, A>,\n    at: usize,\n    size: usize,\n    gpa: A,\n    depth: usize,\n    showing: bool,\n    report: i32,\n    raw: bool,\n}\n\nimpl Gen<Gpa> {\n    // An integer: 0, -1, 1, -2, 2, ... as the choice grows (the edges,\n    // i64::MIN and i64::MAX, are the largest choices).\n    pub fn int(&mut self) -> i64 {\n        let c = self.draw();\n        ((c >> 1) as i64) ^ -((c & 1) as i64)\n    }\n\n");
    buf_str(out, c"    // An integer in lo..=hi (lo first).\n    pub fn int_in(&mut self, lo: i64, hi: i64) -> i64 {\n        let c = self.draw();\n        if hi <= lo {\n            return lo;\n        }\n        let span = (hi - lo) as u64 + 1;\n        if span == 0 {\n            return lo + c as i64;\n        }\n        lo + (c % span) as i64\n    }\n\n    // One of 0..n.\n    // std: changed: usize\n    pub fn choose(&mut self, n: usize) -> usize {\n        let c = self.draw();\n        if n <= 1 { 0 } else { (c % n as u64) as usize }\n    }\n\n    pub fn bool(&mut self) -> bool {\n        self.draw() % 2 == 1\n    }\n\n    // The size this case may grow to (it grows with the case number).\n    // std: changed: usize\n    pub fn size(&mut self) -> usize {\n        self.size\n    }\n\n    // A text byte: letters and digits first, then spaces, punctuation,\n    // newlines and the rest.\n    pub fn text_byte(&mut self) -> u8 {\n        let c = self.draw();\n        let common = \"abcdefghijklmnopqrstuvwxyz0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ\\n.,-_:;()+*/=\"\n            .as_bytes();\n        if c < 200 {\n            return common[(c % common.len() as u64) as usize];\n        }\n        (c % 256) as u8\n    }\n\n    // A text character: text_byte's, ASCII only.\n    pub fn text_char(&mut self) -> char {\n        let b = self.text_byte();\n        if b < 128 { b as char } else { (b'a' + b % 26) as char }\n    }\n\n    // The next choice: 0 past the end of the sequence (the simplest).\n    pub fn draw(&mut self) -> u64 {\n        let k = self.at;\n        self.at += 1;\n        if k >= self.choices.len() {\n            return 0;\n        }\n        self.choices[k]\n    }\n\n    // Whether a collection of `len` elements gets one more.\n    // std: changed: usize\n    pub fn more(&mut self, len: usize) -> bool {\n        if len >= self.size || self.depth > 4 {\n            return false;\n        }\n        self.draw() % 4 != 0\n    }\n\n");
    buf_str(out, c"    // How deep a recursive type's generator is.\n    // std: changed: usize\n    pub fn depth(&mut self) -> usize {\n        self.depth\n    }\n\n    // The allocator generated containers use.\n    pub fn gpa(&mut self) -> Gpa {\n        self.gpa\n    }\n\n    // Whether this run is the replay of a failure (its inputs printed).\n    pub fn showing(&mut self) -> bool {\n        self.showing\n    }\n\n    // The choices used so far, told to the runner (the generators are\n    // done; the property runs next).\n    pub fn generated(&mut self) {\n        if self.report >= 0 {\n            let used = i64_bytes(self.at as i64);\n            let _ = crate::io::sys_write(self.report, &used);\n            close(self.report);\n            self.report = -1;\n        }\n    }\n\n    // A recursive type's generator goes one level down (shallower values\n    // past a depth).\n    pub fn enter(&mut self) {\n        self.depth += 1;\n    }\n\n    pub fn leave(&mut self) {\n        self.depth -= 1;\n    }\n}\n\n// The generator of T: its `impl Arbitrary` (std's for the numbers and\n// bool, the compiler's for a test's structs and enums).\npub fn arbitrary_of<T: Arbitrary>(g: &mut Gen<Gpa>) -> T {\n    T::arbitrary(g)\n}\n\npub fn gen_vec<T, F: Fn(&mut Gen<Gpa>) -> T>(g: &mut Gen<Gpa>, f: F) -> Vec<T, Gpa> {\n    let mut v: Vec<T, Gpa> = Vec::new_in(g.gpa);\n    g.enter();\n    while g.more(v.len()) {\n        v.push(f(g));\n    }\n    g.leave();\n    v\n}\n\npub fn gen_option<T, F: Fn(&mut Gen<Gpa>) -> T>(g: &mut Gen<Gpa>, f: F) -> Option<T> {\n    if g.draw() % 2 == 0 { Option::None } else { Option::Some(f(g)) }\n}\n\npub fn gen_result<T, E, F: Fn(&mut Gen<Gpa>) -> T, G: Fn(&mut Gen<Gpa>) -> E>(g: &mut Gen<Gpa>,\n    f: F, e: G) -> Result<T, E> {\n    if g.draw() % 2 == 0 { Result::Ok(f(g)) } else { Result::Err(e(g)) }\n}\n\n// Text, as bytes.\npub fn gen_text(g: &mut Gen<Gpa>) -> Vec<u8, Gpa> {\n    let mut v: Vec<u8, Gpa> = Vec::new_in(g.gpa);\n    while g.more(v.len()) {\n");
    buf_str(out, c"        v.push(g.text_byte());\n    }\n    v\n}\n\n// Text, as a String (a `&str` or `String` parameter).\npub fn gen_string(g: &mut Gen<Gpa>) -> String<Gpa> {\n    let mut s: String<Gpa> = String::new_in(g.gpa);\n    while g.more(s.len()) {\n        s.push(g.text_char());\n    }\n    s\n}\n\npub fn gen_f64(g: &mut Gen<Gpa>) -> f64 {\n    let c = g.draw();\n    if c < 6 {\n        let edges = [0.0, 1.0, -1.0, -0.0, 1.0 / 0.0, -1.0 / 0.0];\n        return edges[c as usize];\n    }\n    let n = ((c >> 1) as i64) ^ -((c & 1) as i64);\n    (n as f64) / 8.0\n}\n\n// An input's bytes: all of them when the choices are an input's\n// (fuzzing, a saved input), else a generated text of bytes.\npub fn gen_bytes(g: &mut Gen<Gpa>) -> Vec<u8, Gpa> {\n    let mut v: Vec<u8, Gpa> = Vec::new_in(g.gpa);\n    if g.raw {\n        while g.at < g.choices.len() {\n            v.push(g.draw() as u8);\n        }\n        return v;\n    }\n    while g.more(v.len()) {\n        v.push(g.draw() as u8);\n    }\n    v\n}\n\nimpl Arbitrary for i64 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i64 { g.int() }\n}\n\nimpl Arbitrary for i32 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i32 { g.int() as i32 }\n}\n\nimpl Arbitrary for i16 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i16 { g.int() as i16 }\n}\n\nimpl Arbitrary for i8 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i8 { g.int() as i8 }\n}\n\nimpl Arbitrary for u64 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u64 { g.draw() }\n}\n\nimpl Arbitrary for usize {\n    fn arbitrary(g: &mut Gen<Gpa>) -> usize { g.draw() as usize }\n}\n\nimpl Arbitrary for isize {\n    fn arbitrary(g: &mut Gen<Gpa>) -> isize { g.int() as isize }\n}\n\nimpl Arbitrary for u32 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u32 { g.draw() as u32 }\n}\n\nimpl Arbitrary for u16 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u16 { g.draw() as u16 }\n}\n\nimpl Arbitrary for u8 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u8 { g.draw() as u8 }\n}\n\nimpl Arbitrary for bool {\n");
    buf_str(out, c"    fn arbitrary(g: &mut Gen<Gpa>) -> bool { g.bool() }\n}\n\nimpl Arbitrary for f64 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> f64 { gen_f64(g) }\n}\n\nimpl Arbitrary for f32 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> f32 { gen_f64(g) as f32 }\n}\n\nimpl Arbitrary for char {\n    fn arbitrary(g: &mut Gen<Gpa>) -> char { g.text_char() }\n}\n\n// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap: a missing\n// file is written (a new snapshot, the test passes), a different one\n// fails with its first differing line; `volec test --accept` writes\n// the current text.\n// std: changed: the text and the file are read into 64 KiB on the stack\n// (no allocator: a larger one fails)\npub fn assert_snapshot<T: Debug>(x: T) {\n    let mut s = state();\n    s.snap_count += 1;\n    set_state(s);\n    let mut text = Snap::new();\n    let _ = crate::fmt::write(&mut text, \"{x:?}\");\n    text.put(b\"\\n\");\n    let mut path = Short::new();\n    let mut shown = Short::new();\n    if s.snapshots_set {\n        path.put(s.snapshots.as_bytes());\n        path.put(b\"/\");\n    } else {\n        path.put(b\"tests/\");\n    }\n    shown.put(b\"tests/\");\n    // (the tests directory, then its snapshots/; an existing one kept)\n    let _ = crate::fs::create_dir(path.text());\n    path.put(b\"snapshots\");\n    let _ = crate::fs::create_dir(path.text());\n    let mut file = Short::new();\n    file.put(b\"/\");\n    let module = s.module.as_bytes();\n    let mut i: usize = 0;\n    while i < module.len() {\n        if module[i] == b':' {\n            file.put(b\"__\");\n            i += 2;\n        } else {\n            file.put(&module[i..i + 1]);\n            i += 1;\n        }\n    }\n    if module.len() > 0 {\n        file.put(b\"__\");\n    }\n    file.put(s.name.as_bytes());\n    file.put(b\"__\");\n    let n = s.snap_count;\n    let _ = crate::fmt::write(&mut file, \"{n}\");\n    file.put(b\".snap\");\n    path.put(file.bytes());\n    shown.put(b\"snapshots\");\n");
    buf_str(out, c"    shown.put(file.bytes());\n    if text.over || path.over || shown.over {\n        crate::fmt::eprintln(\"snapshot {}: over 64 KiB, or its path over 1 KiB\", shown.text());\n        c_exit(101);\n    }\n    let mut old = Snap::new();\n    let had = old.read(path.text());\n    if had && old.bytes() == text.bytes() {\n    } else if !had || s.accept {\n        if crate::fs::write(path.text(), text.bytes()).is_err() {\n            crate::fmt::eprintln(\"snapshot {}: cannot write {}\", shown.text(), path.text());\n            c_exit(101);\n        }\n        crate::fmt::println(\"vole-test: snapshot {} {}\", if had { \"accepted\" } else { \"new\" },\n            shown.text());\n    } else {\n        let mut k: usize = 0;\n        while line_of(old.bytes(), k) == line_of(text.bytes(), k) {\n            k += 1;\n        }\n        crate::fmt::eprintln(\"snapshot differs: {} line {}: '{}' expected, got '{}'\",\n            shown.text(), k + 1, text_of(line_of(old.bytes(), k)),\n            text_of(line_of(text.bytes(), k)));\n        c_exit(101);\n    }\n}\n\n// A snapshot's text, or a file's: 64 KiB at most (`over` past it).\nstruct Snap {\n    len: usize,\n    over: bool,\n    buf: [u8; 65536],\n}\n\nimpl Snap {\n    fn new() -> Snap {\n        Snap { len: 0, over: false, buf: [0; 65536] }\n    }\n\n    fn put(&mut self, b: &[u8]) {\n        let mut i: usize = 0;\n        while i < b.len() {\n            if self.len == 65536 {\n                self.over = true;\n                return;\n            }\n            self.buf[self.len] = b[i];\n            self.len += 1;\n            i += 1;\n        }\n    }\n\n    fn bytes(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    // The file at path, its first 64 KiB; false when it cannot be opened.\n    fn read(&mut self, path: &str) -> bool {\n        let mut f = match crate::fs::File::open(path) {\n            Result::Ok(f) => f,\n            Result::Err(_) => return false,\n        };\n        loop {\n");
    buf_str(out, c"            if self.len == 65536 {\n                self.over = true;\n                return true;\n            }\n            let at = self.len;\n            match crate::io::Read::read(&mut f, &mut self.buf[at..]) {\n                Result::Ok(0) => return true,\n                Result::Ok(n) => self.len += n,\n                Result::Err(_) => return true,\n            }\n        }\n    }\n}\n\nimpl crate::fmt::Write for Snap {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.put(s.as_bytes());\n        Result::Ok(())\n    }\n}\n\n// A path: 1 KiB at most.\nstruct Short {\n    len: usize,\n    over: bool,\n    buf: [u8; 1024],\n}\n\nimpl Short {\n    fn new() -> Short {\n        Short { len: 0, over: false, buf: [0; 1024] }\n    }\n\n    fn put(&mut self, b: &[u8]) {\n        let mut i: usize = 0;\n        while i < b.len() {\n            if self.len == 1024 {\n                self.over = true;\n                return;\n            }\n            self.buf[self.len] = b[i];\n            self.len += 1;\n            i += 1;\n        }\n    }\n\n    fn bytes(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    fn text(&self) -> &str {\n        text_of(self.bytes())\n    }\n}\n\nimpl crate::fmt::Write for Short {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.put(s.as_bytes());\n        Result::Ok(())\n    }\n}\n\n// ---- The test runtime (the compiler's test code calls these) ----\n\n// UNSAFE: C functions std has no safe form of: fork, pipe, dup2, close,\n// open, waitpid, atexit, _exit.\n// SAFETY: the prototypes are unistd.h's, fcntl.h's, sys/wait.h's and\n// stdlib.h's (open variadic, as declared); each call says why it is\n// sound.\nextern \"C\" {\n    #[link_name = \"fork\"]\n    #[effects(io)]\n    fn test_c_fork() -> i32;\n    #[link_name = \"pipe\"]\n    fn test_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"dup2\"]\n    fn test_c_dup2(fd: i32, to: i32) -> i32;\n");
    buf_str(out, c"    #[link_name = \"close\"]\n    fn test_c_close(fd: i32) -> i32;\n    #[link_name = \"open\"]\n    fn test_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"waitpid\"]\n    #[effects(io)]\n    fn test_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"atexit\"]\n    fn test_c_atexit(f: extern \"C\" fn()) -> i32;\n    #[link_name = \"_exit\"]\n    fn test_c_exit_now(code: i32) -> !;\n}\n\n// What `volec test` passes to a test binary (`--vole-test NAME`, else\n// `--vole-list`; `--cases N`, `--seed S`, `--snapshots DIR`, `--accept`;\n// for fuzzing `--fuzz-time S`, `--fuzz-dir DIR`, `--replay FILE`\n// repeated), and the test being run. The strings are views of argv's,\n// which live as long as the process.\n#[derive(Clone, Copy)]\nstruct TestState {\n    cases: usize,\n    seed: u64,\n    seed_set: bool,\n    snapshots: &'static str,\n    snapshots_set: bool,\n    accept: bool,\n    module: &'static str,\n    name: &'static str,\n    snap_count: usize,\n    fuzz_time: u64,\n    fuzz_dir: &'static str,\n    fuzz_dir_set: bool,\n    replays: usize,\n    // (whether the choices are an input's bytes)\n    raw: bool,\n    // (a test that ends the process, a failed check, ends it at once: the\n    // leaks it leaves are not listed after its failure)\n    running: bool,\n    handler: bool,\n    exit_code: i32,\n    fuzz_words: usize,\n}\n\nstatic mut TEST_STATE: TestState = TestState {\n    cases: 100,\n    seed: 0,\n    seed_set: false,\n    snapshots: \"\",\n    snapshots_set: false,\n    accept: false,\n    module: \"\",\n    name: \"\",\n    snap_count: 0,\n    fuzz_time: 0,\n    fuzz_dir: \"\",\n    fuzz_dir_set: false,\n    replays: 0,\n    raw: false,\n    running: false,\n    handler: false,\n    exit_code: 101,\n    fuzz_words: 0,\n};\nstatic mut TEST_REPLAY: [&'static str; 256] = [\"\"; 256];\n// (the program's text constants a mutation may put in an input: the\n// compiler gives them, front/tests)\n");
    buf_str(out, c"static mut FUZZ_WORDS: [&'static [u8]; 64] = [b\"\"; 64];\n\nfn state() -> TestState {\n    // UNSAFE: a static mut, read by value.\n    // SAFETY: the runtime runs on the runner's one thread (a forked case\n    // has its own copy); nothing borrows the static.\n    unsafe { TEST_STATE }\n}\n\nfn set_state(s: TestState) {\n    // UNSAFE: a static mut, written by value. SAFETY: as state's.\n    unsafe {\n        TEST_STATE = s;\n    }\n}\n\nfn replay(k: usize) -> &'static str {\n    // UNSAFE: a static mut's element, read by value. SAFETY: as state's;\n    // k < 256 is checked by the index.\n    unsafe { TEST_REPLAY[k] }\n}\n\nfn fuzz_word_at(k: usize) -> &'static [u8] {\n    // UNSAFE: a static mut's element, read by value. SAFETY: as state's;\n    // the index is checked.\n    unsafe { FUZZ_WORDS[k] }\n}\n\n// The exit status of a property case whose `requires` failed (discarded).\nconst DISCARD: i32 = 77;\n\n// i64 <-> its 8 bytes (little-endian), for what a case reports on its pipe.\nfn i64_bytes(x: i64) -> [u8; 8] {\n    let mut b: [u8; 8] = [0; 8];\n    let mut k: usize = 0;\n    while k < 8 {\n        b[k] = ((x >> (8 * k)) & 255) as u8;\n        k += 1;\n    }\n    b\n}\n\nfn bytes_i64(b: [u8; 8]) -> i64 {\n    let mut x: i64 = 0;\n    let mut k: usize = 0;\n    while k < 8 {\n        x = x | ((b[k] as i64) << (8 * k));\n        k += 1;\n    }\n    x\n}\n\nfn number(t: &str) -> u64 {\n    let s = t.as_bytes();\n    let mut n: u64 = 0;\n    let mut i: usize = 0;\n    let mut base: u64 = 10;\n    if s.len() > 2 && s[0] == b'0' && (s[1] == b'x' || s[1] == b'X') {\n        base = 16;\n        i = 2;\n    }\n    while i < s.len() {\n        let c = s[i];\n        let d = if c >= b'0' && c <= b'9' { (c - b'0') as u64 }\n            else if c >= b'a' && c <= b'f' { (c - b'a') as u64 + 10 }\n            else if c >= b'A' && c <= b'F' { (c - b'A') as u64 + 10 }\n            else { 99 };\n        if d >= base {\n            break;\n        }\n        n = n * base + d;\n");
    buf_str(out, c"        i += 1;\n    }\n    n\n}\n\n// A test binary's arguments: the test to run (empty: list them).\npub fn test_args() -> &'static str {\n    let mut s = state();\n    let mut name: &'static str = \"\";\n    let mut args = crate::env::args();\n    let _ = args.next();\n    let mut next = args.next();\n    loop {\n        let a = match next {\n            Option::Some(x) => x,\n            Option::None => break,\n        };\n        let after = args.next();\n        let has_value = after.is_some();\n        let value = after.unwrap_or(\"\");\n        // (whether the flag took `value`)\n        let mut took = has_value;\n        if a == \"--vole-test\" && has_value {\n            name = value;\n        } else if a == \"--cases\" && has_value {\n            s.cases = number(value) as usize;\n        } else if a == \"--seed\" && has_value {\n            s.seed = number(value);\n            s.seed_set = true;\n        } else if a == \"--snapshots\" && has_value {\n            s.snapshots = value;\n            s.snapshots_set = true;\n        } else if a == \"--fuzz-time\" && has_value {\n            s.fuzz_time = number(value);\n        } else if a == \"--fuzz-dir\" && has_value {\n            s.fuzz_dir = value;\n            s.fuzz_dir_set = true;\n        } else if a == \"--replay\" && has_value {\n            if s.replays < 256 {\n                // UNSAFE: a static mut's element, written by value. SAFETY:\n                // as state's; s.replays < 256.\n                unsafe {\n                    TEST_REPLAY[s.replays] = value;\n                }\n                s.replays += 1;\n            }\n        } else {\n            if a == \"--accept\" {\n                s.accept = true;\n            }\n            took = false;\n        }\n        next = if took { args.next() } else { after };\n    }\n    set_state(s);\n    name\n}\n\n// A test of module `module` (its path, `a::tests`) starts.\npub fn test_begin(module: &'static str, name: &'static str, gpa: Gpa) {\n");
    buf_str(out, c"    let mut s = state();\n    s.module = module;\n    s.name = name;\n    s.snap_count = 0;\n    set_state(s);\n    // (an allocation first: --check-alloc's handler at exit is then\n    // registered before at_exit, which runs before it)\n    let mut first: Vec<u8, Gpa> = Vec::new_in(gpa);\n    first.push(0);\n    crate::mem::drop(first);\n    running();\n}\n\n// C's exit: the atexit handlers run (at_exit, --check-alloc's), as a\n// test's end has always been.\nfn c_exit(code: i32) -> ! {\n    crate::process::exit(code)\n}\n\n// C's _exit: the process ends at once, no atexit handler.\nfn quit(code: i32) -> ! {\n    // UNSAFE: C's _exit, a C call.\n    // SAFETY: any int is a valid status; it does not return and touches\n    // no vole state.\n    unsafe { test_c_exit_now(code) }\n}\n\nextern \"C\" fn at_exit() {\n    let s = state();\n    if s.running {\n        quit(s.exit_code);\n    }\n}\n\n// This process ends with `code`, before --check-alloc lists what it\n// leaves allocated (a runner's, not the test's).\nfn exit_with(code: i32) -> ! {\n    running();\n    let mut s = state();\n    s.exit_code = code;\n    set_state(s);\n    c_exit(code)\n}\n\nfn running() {\n    let mut s = state();\n    if !s.handler {\n        // UNSAFE: C's atexit, a C call taking a function pointer.\n        // SAFETY: at_exit is an `extern \"C\" fn()` that lives as long as\n        // the program; `handler` registers it once (atexit's limit is 32\n        // or more).\n        unsafe {\n            test_c_atexit(at_exit);\n        }\n        s.handler = true;\n    }\n    s.running = true;\n    set_state(s);\n}\n\n// A #[test] returned.\npub fn test_done() {\n    let mut s = state();\n    s.running = false;\n    set_state(s);\n}\n\n// A test left blocks allocated (with --check-alloc, which test builds\n// use; they are listed): it fails.\npub fn test_leaked() -> ! {\n    c_exit(101)\n}\n\n// A `#[test]` that returned Err(e): the error, exit 101.\npub fn test_err<E: Debug>(e: E) -> ! {\n");
    buf_str(out, c"    crate::fmt::eprintln(\"test returned Err({e:?})\");\n    c_exit(101)\n}\n\npub fn test_unknown(name: &str) -> i32 {\n    crate::fmt::eprintln(\"no test '{name}' in this program (--vole-list lists them)\");\n    2\n}\n\n// A property case whose `requires` does not hold: not a failure.\npub fn test_discard() -> ! {\n    quit(DISCARD)\n}\n\n// The line that begins an input's value, when a failure is replayed.\npub fn test_input(name: &str) {\n    crate::fmt::print(\"vole-test: input {name} = \");\n}\n\npub fn test_input_end() {\n    crate::fmt::println(\"\");\n}\n\n// The choices of a case (splitmix64 from the state): mostly small, some\n// edges, some anything.\nfn next_of(st: &mut u64) -> u64 {\n    *st = st.wrapping_add(0x9e3779b97f4a7c15);\n    let mut z = *st;\n    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n    z ^ (z >> 31)\n}\n\nfn choice(st: &mut u64, size: usize) -> u64 {\n    let r = next_of(st);\n    let pick = r % 20;\n    if pick == 0 {\n        // (the edges: i64::MIN, i64::MAX, u64::MAX, a byte's)\n        let e = next_of(st) % 5;\n        return if e == 0 { 0xffffffffffffffff } else if e == 1 { 0xfffffffffffffffe }\n            else if e == 2 { 255 } else if e == 3 { 256 } else { 0x8000000000000000 };\n    }\n    if pick < 3 {\n        return next_of(st);\n    }\n    next_of(st) % (2 * size as u64 + 4)\n}\n\nfn seed_of(name: &str) -> u64 {\n    let s = state();\n    if s.seed_set {\n        return s.seed;\n    }\n    let b = name.as_bytes();\n    let mut h: u64 = 14695981039346656037;\n    let mut i: usize = 0;\n    while i < b.len() {\n        h = (h ^ b[i] as u64).wrapping_mul(1099511628211);\n        i += 1;\n    }\n    h\n}\n\n#[derive(Clone, Copy)]\nstruct CaseRun {\n    status: i32,\n    used: usize,\n}\n\nfn close(fd: i32) {\n    // UNSAFE: C's close. SAFETY: any int; a bad fd is an error, ignored.\n    unsafe {\n        test_c_close(fd);\n    }\n}\n\n");
    buf_str(out, c"// A pipe, (read end, write end); none stops the runner (exit 2).\nfn pipe() -> (i32, i32) {\n    let mut fds: [i32; 2] = [0, 0];\n    // UNSAFE: C's pipe. SAFETY: fds is two writable i32s.\n    let r = unsafe { test_c_pipe(&mut fds[0] as *mut i32) };\n    if r != 0 {\n        crate::fmt::eprintln(\"vole-test: cannot make a pipe\");\n        c_exit(2);\n    }\n    (fds[0], fds[1])\n}\n\n// fork(2): 0 in the child, the child's pid in the parent.\nfn fork() -> i32 {\n    // UNSAFE: fork is a C call std has no safe form of: the child is a\n    // copy of this process.\n    // SAFETY: the runner forks from its one thread (a property's cases run\n    // one at a time, the runner starts no thread), so the child's copy of\n    // every lock and buffer is consistent; the child runs one case and\n    // ends with _exit (quit), never returning into the runner.\n    unsafe { test_c_fork() }\n}\n\n// A case's stdout and stderr to /dev/null.\nfn quiet() {\n    // UNSAFE: C's open, dup2 and close.\n    // SAFETY: the path is a NUL-ended literal; O_WRONLY is 1 on both\n    // systems; the fds are ints, a bad one an error.\n    unsafe {\n        let null = test_c_open(\"/dev/null\\0\".as_ptr(), 1);\n        if null >= 0 {\n            test_c_dup2(null, 1);\n            test_c_dup2(null, 2);\n            test_c_close(null);\n        }\n    }\n}\n\n// The 8 bytes of an i64 a child reports on fd; -1 when it reports nothing.\nfn read_i64(fd: i32) -> i64 {\n    let mut b: [u8; 8] = [0; 8];\n    match crate::io::sys_read(fd, &mut b) {\n        Result::Ok(n) => if n == 8 { bytes_i64(b) } else { -1 },\n        Result::Err(_) => -1,\n    }\n}\n\n// Waits for child pid: its exit code, 128 + the signal that ended it.\nfn wait(pid: i32) -> i32 {\n    let mut st: i32 = 0;\n    // UNSAFE: C's waitpid. SAFETY: st is a writable i32.\n    let r = unsafe { test_c_waitpid(pid, &mut st as *mut i32, 0) };\n    if r < 0 {\n        return 0;\n    }\n");
    buf_str(out, c"    if (st & 127) == 0 { (st >> 8) & 255 } else { 128 + (st & 127) }\n}\n\nfn fails(r: CaseRun) -> bool {\n    r.status != 0 && r.status != DISCARD\n}\n\n// The case's values are dropped by the time f returns, so a block it\n// allocated and left is a leak (--check-alloc): it fails.\nfn run_case<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>) {\n    let mark = crate::__gpa::check_alloc_mark();\n    f(g);\n    if crate::__gpa::check_alloc_leaks_since(mark) > 0 {\n        quit(101);\n    }\n}\n\nfn copy_of(gpa: Gpa, v: &Vec<u64, Gpa>) -> Vec<u64, Gpa> {\n    let mut c: Vec<u64, Gpa> = Vec::new_in(gpa);\n    c.extend_from_slice(v.as_slice());\n    c\n}\n\n// The runner's Gen, which each case's child takes as its own copy: no\n// allocation for it (a case's block numbers are its own allocations').\nfn runner_gen(gpa: Gpa) -> Gen<Gpa> {\n    Gen {\n        choices: Vec::new_in(gpa), at: 0, size: 0, gpa: gpa, depth: 0, showing: false, report: -1,\n        raw: false,\n    }\n}\n\n// Runs one case in a child process: its exit status (0 passed, DISCARD\n// discarded, else failed) and the choices it used. The choices are g's\n// for the run (swapped in and back).\nfn case<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, choices: &mut Vec<u64, Gpa>, size: usize,\n    quiet_run: bool) -> CaseRun {\n    let n = choices.len();\n    let (rd, wr) = pipe();\n    crate::mem::swap(&mut g.choices, choices);\n    let pid = fork();\n    if pid == 0 {\n        close(rd);\n        if quiet_run {\n            quiet();\n        }\n        running();\n        g.at = 0;\n        g.size = size;\n        g.depth = 0;\n        g.showing = !quiet_run;\n        g.report = wr;\n        g.raw = state().raw;\n        run_case(f, g);\n        quit(0);\n    }\n    crate::mem::swap(&mut g.choices, choices);\n    close(wr);\n    let used = read_i64(rd);\n    close(rd);\n    CaseRun { status: wait(pid), used: if used >= 0 { used as usize } else { n } }\n}\n\n");
    buf_str(out, c"// Candidate `c` replaces `best` when it fails too (cut to what it used).\nfn attempt<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, best: &mut Vec<u64, Gpa>,\n    c: &mut Vec<u64, Gpa>, size: usize, steps: &mut usize) -> bool {\n    let r = case(f, g, c, size, true);\n    if !fails(r) {\n        return false;\n    }\n    *steps += 1;\n    best.clear();\n    let n = if r.used < c.len() { r.used } else { c.len() };\n    let mut i: usize = 0;\n    while i < n {\n        best.push(c[i]);\n        i += 1;\n    }\n    true\n}\n\n// The failing choices `best` made smaller: chunks deleted, choices set to\n// zero, halved, lowered by one, neighbours put in order; to a fixpoint (or\n// 2000 candidates).\nfn shrink<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, best: &mut Vec<u64, Gpa>, size: usize)\n    -> usize {\n    let mut steps: usize = 0;\n    let mut tries: usize = 0;\n    let mut c: Vec<u64, Gpa> = Vec::new_in(g.gpa);\n    let mut changed = true;\n    let chunks: [usize; 4] = [8, 4, 2, 1];\n    while changed && tries < 2000 {\n        changed = false;\n        let mut ki: usize = 0;\n        while ki < 4 {\n            let k = chunks[ki];\n            ki += 1;\n            if best.len() < k {\n                continue;\n            }\n            let mut i = (best.len() - k) as i64;\n            while i >= 0 && tries < 2000 {\n                c.clear();\n                let mut j: usize = 0;\n                while j < best.len() {\n                    if (j as i64) < i || j as i64 >= i + k as i64 {\n                        c.push(best[j]);\n                    }\n                    j += 1;\n                }\n                tries += 1;\n                if attempt(f, g, best, &mut c, size, &mut steps) {\n                    changed = true;\n                }\n                i -= 1;\n                let top = best.len() as i64 - k as i64;\n                if i > top {\n                    i = top;\n                }\n            }\n        }\n");
    buf_str(out, c"        let mut i: usize = 0;\n        while i < best.len() && tries < 2000 {\n            // lowered: to 0, else the smallest that still fails, by halves\n            let mut lo: u64 = 0;\n            let mut first = true;\n            while i < best.len() && best[i] > lo && tries < 2000 {\n                let v = best[i];\n                let w = if first { 0 } else { lo + (v - lo) / 2 };\n                first = false;\n                c.clear();\n                let mut j: usize = 0;\n                while j < best.len() {\n                    c.push(if j == i { w } else { best[j] });\n                    j += 1;\n                }\n                tries += 1;\n                if attempt(f, g, best, &mut c, size, &mut steps) {\n                    changed = true;\n                } else if w == lo {\n                    lo = w + 1;\n                } else {\n                    lo = w;\n                }\n            }\n            if i + 1 < best.len() && best[i] > best[i + 1] {\n                c.clear();\n                let mut j: usize = 0;\n                while j < best.len() {\n                    c.push(if j == i { best[i + 1] } else if j == i + 1 { best[i] }\n                        else { best[j] });\n                    j += 1;\n                }\n                tries += 1;\n                if attempt(f, g, best, &mut c, size, &mut steps) {\n                    changed = true;\n                }\n            }\n            i += 1;\n        }\n    }\n    steps\n}\n\n// A property: the cases (the first all zeros: the simplest values), each\n// in a child process; the first failure is shrunk, then replayed with its\n// inputs printed; exit 1. `vole-test:` lines on stdout tell `volec test`\n// the case and the steps.\npub fn run_property<F: Fn(&mut Gen<Gpa>)>(gpa: Gpa, name: &str, f: F) {\n    property(gpa, name, &f);\n}\n\nfn property<F: Fn(&mut Gen<Gpa>)>(gpa: Gpa, name: &str, f: &F) {\n    // (the cases run in children; this process ends normally)\n");
    buf_str(out, c"    test_done();\n    let seed = seed_of(name);\n    let cases = if state().cases > 0 { state().cases } else { 1 };\n    let mut st = seed;\n    let mut choices: Vec<u64, Gpa> = Vec::new_in(gpa);\n    let mut g = runner_gen(gpa);\n    let mut discarded: usize = 0;\n    let mut n: usize = 0;\n    while n < cases {\n        // (sizes grow over 100 cases, whatever --cases: -O0 runs the first\n        // 20 of -O2's)\n        let size = 1 + (if n < 100 { n } else { 99 }) * 30 / 100;\n        choices.clear();\n        if n > 0 {\n            let mut k: usize = 0;\n            while k < 512 {\n                choices.push(choice(&mut st, size));\n                k += 1;\n            }\n        }\n        let r = case(f, &mut g, &mut choices, size, true);\n        if r.status == DISCARD {\n            discarded += 1;\n            n += 1;\n            continue;\n        }\n        if r.status != 0 {\n            let keep = if r.used < choices.len() { r.used } else { choices.len() };\n            choices.truncate(keep);\n            let steps = shrink(f, &mut g, &mut choices, size);\n            let at = n + 1;\n            let word = if steps == 1 { \"step\" } else { \"steps\" };\n            crate::fmt::println(\n                \"vole-test: property case {at} of {cases}, shrunk in {steps} {word}, seed {seed:x}\");\n            case(f, &mut g, &mut choices, size, false);\n            exit_with(1);\n        }\n        n += 1;\n    }\n    if discarded * 10 > cases * 9 {\n        crate::fmt::println(\"vole-test: discarded {discarded} of {cases}\");\n        crate::fmt::eprintln(\n            \"the generator rarely satisfies the requires: {discarded} of {cases} cases discarded (write an impl Arbitrary for the parameter's type)\");\n        exit_with(1);\n    }\n}\n\n// The line `k` (from 0) of s.\nfn line_of(s: &[u8], k: usize) -> &[u8] {\n    let mut at: usize = 0;\n    let mut line: usize = 0;\n    while at <= s.len() {\n        let mut e = at;\n");
    buf_str(out, c"        while e < s.len() && s[e] != b'\\n' {\n            e += 1;\n        }\n        if line == k {\n            return &s[at..e];\n        }\n        line += 1;\n        at = e + 1;\n    }\n    &s[0..0]\n}\n\nfn text_of(b: &[u8]) -> &str {\n    match crate::str::from_utf8(b) {\n        Result::Ok(s) => s,\n        Result::Err(_) => \"(not UTF-8)\",\n    }\n}\n\n// ---- The fuzzer ----\n\n// `#[fuzz]` functions: a property whose choice sequence is an input's\n// bytes, one choice per byte. `volec fuzz NAME` runs it on inputs it\n// mutates and keeps those that reach new code (--coverage's counters,\n// std::COVERAGE_MAP); `volec test` runs it as a property and on its\n// saved inputs. A `&[u8]` parameter is the input itself (gen_bytes).\n\n// The counters (all zero in a program built without --coverage).\npub fn coverage() -> &'static [u8] {\n    // UNSAFE: the counters' static, viewed.\n    // SAFETY: the program's blocks only ever add to it, on this thread;\n    // the view is read before the next block runs (the coverage anchor\n    // returns it to the fuzzer's caller).\n    unsafe { &*(&raw const crate::COVERAGE_MAP) }\n}\n\nfn coverage_reset() {\n    let mut i: usize = 0;\n    while i < 65536 {\n        // UNSAFE: the counters' static, written by value. SAFETY: on this\n        // thread; i < 65536.\n        unsafe {\n            crate::COVERAGE_MAP[i] = 0;\n        }\n        i += 1;\n    }\n}\n\npub fn fuzz_word(w: &'static [u8]) {\n    let mut s = state();\n    if s.fuzz_words < 64 && w.len() > 0 && w.len() <= 32 {\n        // UNSAFE: a static mut's element, written by value. SAFETY: as\n        // state's; s.fuzz_words < 64.\n        unsafe {\n            FUZZ_WORDS[s.fuzz_words] = w;\n        }\n        s.fuzz_words += 1;\n        set_state(s);\n    }\n}\n\n// A run of one input in a child process: its status, the choices it used,\n// and (when it returned) its coverage, into `cov`.\n");
    buf_str(out, c"fn fuzz_exec<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, input: &mut Vec<u64, Gpa>,\n    cov: &mut [u8]) -> CaseRun {\n    let n = input.len();\n    let (rd, wr) = pipe();\n    let (crd, cwr) = pipe();\n    crate::mem::swap(&mut g.choices, input);\n    let pid = fork();\n    if pid == 0 {\n        close(rd);\n        close(crd);\n        quiet();\n        running();\n        coverage_reset();\n        g.at = 0;\n        g.size = 64;\n        g.depth = 0;\n        g.showing = false;\n        g.report = wr;\n        g.raw = true;\n        run_case(f, g);\n        let _ = crate::io::sys_write(cwr, coverage());\n        quit(0);\n    }\n    crate::mem::swap(&mut g.choices, input);\n    close(wr);\n    close(cwr);\n    let used = read_i64(rd);\n    close(rd);\n    let mut i: usize = 0;\n    while i < 65536 {\n        cov[i] = 0;\n        i += 1;\n    }\n    let mut got: usize = 0;\n    loop {\n        let k = match crate::io::sys_read(crd, &mut cov[got..65536]) {\n            Result::Ok(k) => k,\n            Result::Err(_) => 0,\n        };\n        if k == 0 {\n            break;\n        }\n        got += k;\n        if got >= 65536 {\n            break;\n        }\n    }\n    close(crd);\n    CaseRun { status: wait(pid), used: if used >= 0 { used as usize } else { n } }\n}\n\n// AFL's buckets of a count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128-255.\nfn bucket(c: u8) -> u8 {\n    if c == 0 { 0 } else if c == 1 { 1 } else if c == 2 { 2 } else if c == 3 { 4 }\n    else if c < 8 { 8 } else if c < 16 { 16 } else if c < 32 { 32 } else if c < 128 { 64 }\n    else { 128 }\n}\n\n// Whether `cov` reaches a block (or a block's count) `seen` has not seen;\n// `seen` takes it in.\nfn new_coverage(cov: &[u8], seen: &mut [u8]) -> bool {\n    let mut new = false;\n    let mut i: usize = 0;\n    while i < 65536 {\n        let c = cov[i];\n        if c != 0 {\n            let b = bucket(c);\n            if (b & !seen[i]) != 0 {\n                seen[i] = seen[i] | b;\n");
    buf_str(out, c"                new = true;\n            }\n        }\n        i += 1;\n    }\n    new\n}\n\n// One mutation of `v` (bytes as choices), from the random state; `other`\n// is another input of the corpus (for a splice).\nfn mutate(v: &mut Vec<u64, Gpa>, other: &Vec<u64, Gpa>, st: &mut u64) {\n    let len = v.len();\n    let r = next_of(st);\n    let how = r % 10;\n    let at = if len > 0 { ((r >> 8) % len as u64) as usize } else { 0 };\n    if len == 0 || how == 0 {\n        // a byte inserted\n        let b = next_of(st) % 256;\n        if len >= 4096 {\n            return;\n        }\n        v.insert(at, b);\n    } else if how == 1 {\n        // a bit flipped\n        v[at] = v[at] ^ (1 << (next_of(st) % 8));\n    } else if how == 2 {\n        let interesting: [u64; 10] = [0, 1, 0x7f, 0x80, 0xff, 48, 97, 32, 10, 255];\n        v[at] = interesting[(next_of(st) % 10) as usize];\n    } else if how == 3 {\n        v[at] = next_of(st) % 256;\n    } else if how == 4 {\n        // a run deleted\n        let n = 1 + (next_of(st) % 4) as usize;\n        let mut k: usize = 0;\n        while k < n && at < v.len() {\n            v.remove(at);\n            k += 1;\n        }\n    } else if how == 5 {\n        // a byte changed by a little\n        let d = next_of(st) % 16;\n        v[at] = (v[at] + d + 240) % 256;\n    } else if how == 6 && other.len() > 0 {\n        // a splice: this input's start, the other's end\n        let cut = (next_of(st) % other.len() as u64) as usize;\n        v.truncate(at);\n        let mut i = cut;\n        while i < other.len() {\n            if v.len() < 4096 {\n                v.push(other[i]);\n            }\n            i += 1;\n        }\n    } else if how == 7 && state().fuzz_words > 0 {\n        // a text constant of the program\n        let w = fuzz_word_at((next_of(st) % state().fuzz_words as u64) as usize);\n        let mut i: usize = 0;\n        while i < w.len() {\n            if v.len() < 4096 {\n");
    buf_str(out, c"                v.insert(at + i, w[i] as u64);\n            }\n            i += 1;\n        }\n    } else if how == 8 && len < 4096 {\n        // a run repeated\n        let n = 1 + (next_of(st) % 8) as usize;\n        let mut k: usize = 0;\n        while k < n && at + k < len && v.len() < 4096 {\n            let to = if at + n + k < v.len() { at + n + k } else { v.len() };\n            let x = v[at + k];\n            v.insert(to, x);\n            k += 1;\n        }\n    } else {\n        v[at] = next_of(st) % 256;\n    }\n}\n\nfn fuzz_hash(v: &Vec<u64, Gpa>) -> u64 {\n    let mut h: u64 = 14695981039346656037;\n    let mut i: usize = 0;\n    while i < v.len() {\n        h = (h ^ v[i]).wrapping_mul(1099511628211);\n        i += 1;\n    }\n    h\n}\n\n// Input v saved as DIR/PREFIXHASH (bytes): its path.\nfn fuzz_save(gpa: Gpa, v: &Vec<u64, Gpa>, prefix: &str) -> String<Gpa> {\n    let s = state();\n    let mut path: String<Gpa> = String::new_in(gpa);\n    if s.fuzz_dir_set {\n        path.push_str(s.fuzz_dir);\n        path.push('/');\n    }\n    path.push_str(prefix);\n    let h = fuzz_hash(v);\n    let digits = \"0123456789abcdef\".as_bytes();\n    let mut k: u64 = 0;\n    while k < 16 {\n        path.push(digits[((h >> (60 - 4 * k)) & 15) as usize] as char);\n        k += 1;\n    }\n    let mut bytes: Vec<u8, Gpa> = Vec::new_in(gpa);\n    let mut i: usize = 0;\n    while i < v.len() {\n        bytes.push(v[i] as u8);\n        i += 1;\n    }\n    let _ = crate::fs::write(path.as_str(), bytes.as_slice());\n    path\n}\n\nfn fuzz_load(gpa: Gpa, path: &str, into: &mut Vec<u64, Gpa>) -> bool {\n    into.clear();\n    match crate::fs::read_in(path, gpa) {\n        Result::Ok(b) => {\n            let mut i: usize = 0;\n            while i < b.len() {\n                into.push(b[i] as u64);\n                i += 1;\n            }\n            true\n        }\n        Result::Err(_) => false,\n    }\n}\n\n");
    buf_str(out, c"// A failing input: shrunk, saved, replayed with its inputs printed; exit 1.\nfn fuzz_failed<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, input: &mut Vec<u64, Gpa>,\n    runs: usize) -> ! {\n    let gpa = g.gpa;\n    let mut s = state();\n    s.raw = true;\n    set_state(s);\n    let steps = shrink(f, g, input, 64);\n    let path = fuzz_save(gpa, input, \"crash-\");\n    let word = if steps == 1 { \"step\" } else { \"steps\" };\n    crate::fmt::println(\"vole-test: property after {runs} runs, shrunk in {steps} {word}\");\n    crate::fmt::println(\"vole-test: saved {}\", path.as_str());\n    case(f, g, input, 64, false);\n    exit_with(1)\n}\n\n// A fuzz target: fuzzed for --fuzz-time seconds (volec fuzz), else run\n// on its saved inputs (--replay), then as a property.\npub fn run_fuzz_target<F: Fn(&mut Gen<Gpa>)>(gpa: Gpa, name: &str, f: F) {\n    test_done();\n    let mut g = runner_gen(gpa);\n    let mut input: Vec<u64, Gpa> = Vec::new_in(gpa);\n    let replays = state().replays;\n    if state().fuzz_time == 0 {\n        let mut s = state();\n        s.raw = true;\n        set_state(s);\n        let mut k: usize = 0;\n        while k < replays {\n            let at = replay(k);\n            k += 1;\n            if !fuzz_load(gpa, at, &mut input) {\n                continue;\n            }\n            let r = case(&f, &mut g, &mut input, 64, true);\n            if fails(r) {\n                crate::fmt::println(\"vole-test: property input {at}\");\n                case(&f, &mut g, &mut input, 64, false);\n                exit_with(1);\n            }\n        }\n        let mut s = state();\n        s.raw = false;\n        set_state(s);\n        property(gpa, name, &f);\n        return;\n    }\n    // the corpus: the saved inputs, and the empty one\n    let mut corpus: Vec<Vec<u64, Gpa>, Gpa> = Vec::new_in(gpa);\n    let mut seen: Vec<u8, Gpa> = Vec::new_in(gpa);\n    let mut cov: Vec<u8, Gpa> = Vec::new_in(gpa);\n    let mut i: usize = 0;\n    while i < 65536 {\n");
    buf_str(out, c"        seen.push(0);\n        cov.push(0);\n        i += 1;\n    }\n    corpus.push(Vec::new_in(gpa));\n    let mut k: usize = 0;\n    while k < replays {\n        let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);\n        if fuzz_load(gpa, replay(k), &mut v) {\n            corpus.push(v);\n        }\n        k += 1;\n    }\n    let mut runs: usize = 0;\n    let mut k: usize = 0;\n    while k < corpus.len() {\n        let r = fuzz_exec(&f, &mut g, &mut corpus[k], cov.as_mut_slice());\n        runs += 1;\n        if fails(r) {\n            let mut v = copy_of(gpa, &corpus[k]);\n            fuzz_failed(&f, &mut g, &mut v, runs);\n        }\n        k += 1;\n        new_coverage(cov.as_slice(), seen.as_mut_slice());\n    }\n    let mut st = seed_of(name);\n    let start = crate::time::Instant::now();\n    let limit = state().fuzz_time;\n    let mut kept: usize = 0;\n    let mut child: Vec<u64, Gpa> = Vec::new_in(gpa);\n    while start.elapsed().as_secs() < limit {\n        let p = (next_of(&mut st) % corpus.len() as u64) as usize;\n        let o = (next_of(&mut st) % corpus.len() as u64) as usize;\n        child.clear();\n        child.extend_from_slice(corpus[p].as_slice());\n        let stack = 1 + next_of(&mut st) % 4;\n        let mut m: u64 = 0;\n        while m < stack {\n            mutate(&mut child, &corpus[o], &mut st);\n            m += 1;\n        }\n        let r = fuzz_exec(&f, &mut g, &mut child, cov.as_mut_slice());\n        runs += 1;\n        if fails(r) {\n            fuzz_failed(&f, &mut g, &mut child, runs);\n        }\n        if r.status == 0 && new_coverage(cov.as_slice(), seen.as_mut_slice()) {\n            let keep = copy_of(gpa, &child);\n            let _ = fuzz_save(gpa, &keep, \"corpus-\");\n            corpus.push(keep);\n            kept += 1;\n        }\n    }\n    let size = corpus.len();\n    crate::fmt::println(\"vole-test: fuzz {runs} runs, {kept} inputs kept, {size} in the corpus\");\n    exit_with(0)\n}\n// ---- end mod std::test ----\n");
    buf_str(out, c"}\n");
}

