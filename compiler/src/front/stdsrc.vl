self.back;\n");
    buf_str(out, c"        // trailing '/'s and \".\" components\n        loop {\n            if hi > lo && b[hi - 1] == b'/' {\n                hi -= 1;\n            } else if hi > lo && b[hi - 1] == b'.' && (hi - 1 == lo || b[hi - 2] == b'/') {\n                hi -= 1;\n            } else {\n                break;\n            }\n        }\n        if self.pre {\n            let n = prefix_len(self.s);\n            return Path { s: &self.s[0..if hi > n { hi } else { n }] };\n        }\n        // leading '/'s and \".\" components\n        loop {\n            if lo < hi && b[lo] == b'/' {\n                lo += 1;\n            } else if lo < hi && b[lo] == b'.' && (lo + 1 == hi || b[lo + 1] == b'/') {\n                lo += 1;\n            } else {\n                break;\n            }\n        }\n        Path { s: &self.s[lo..hi] }\n    }\n}\n\nimpl<'a> Iterator for Components<'a> {\n    type Item = Component<'a>;\n\n    fn next(&mut self) -> Option<Component<'a>> {\n        if self.pre {\n            self.pre = false;\n            return Option::Some(self.prefix());\n        }\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n            let start = self.front;\n            let mut end = start;\n            while end < self.back && b[end] != b'/' {\n                end += 1;\n            }\n            self.front = if end < self.back { end + 1 } else { end };\n            match Components::body(&self.s[start..end]) {\n                Option::Some(c) => return Option::Some(c),\n                Option::None => {}\n            }\n        }\n        Option::None\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Components<'a> {\n    fn next_back(&mut self) -> Option<Component<'a>> {\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n            let end = self.back;\n            let mut start = end;\n            while start > self.front && b[start - 1] != b'/' {\n                start -= 1;\n            }\n");
