// Blocks and statements (`let`, `defer`, expression statements, items in
// a block), with the recovery after a syntax error in a statement; and
// the patterns of `let`, `match`, `if let` and `for`.

use crate::base::{_setjmp, alloc_array, free, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{error_at, recover_enter, recover_leave};
use crate::front::ast::{
    ARM_LET_ELSE, ARM_SYNTHETIC, CONV_NEW, FIELD_SHORTHAND, NODE_REF, NODE_REF_MUT, NodeKind,
    PAT_FIELDS, PAT_PARENS, PAT_REST, child, list_begin, list_end, list_push, new_node,
};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{
    Char, Colon, ColonColon, Comma, Const, DotDot, DotDotEq, Enum, Eof, Eq, Extern, False, Float,
    Fn, For, Ident, If, Impl, Import, Int, LBrace, LParen, Let, Loop, Match, Minus, Mut, Pipe,
    RBrace, RParen, Reserved, Semi, Static, Struct, True, Type, Union, Unsafe, Use, While,
};
use crate::front::parser::{
    advance, at, cur, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end,
    reserved_error, skip_statement, syntax_error, tok_kind, with_no_struct,
};
use crate::front::parser::exprs::{make_unary, parse_expr, parse_primary};
use crate::front::parser::types::parse_type;

// ---- Blocks and statements ----

pub fn parse_block(pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let start = cur_start(pcx);
        expect(LBrace, pcx);
        let saved = with_no_struct(false, pcx);
        let block = new_node(NodeKind::Block, start, 0, pcx);
        let mark = list_begin(pcx);
        let mut tail: i64 = 0;
        // (0.28.0: every file's tokens are one list: a block its file's end
        // leaves open ends there, with that error, and not among the next
        // file's items, std's; gap 105)
        let file_end = pcx.files[crate::front::modules::file_of_pos(start, pcx) as usize].end;
        let mut open = false;
        while !at(RBrace, pcx) && !at(Eof, pcx) {
            if pcx.toks[pcx.p as usize].start >= file_end {
                if !pcx.body_failed {
                    syntax_error(c"expected '}'", pcx);
                }
                open = true;
                break;
            }
            if eat(Semi, pcx) {
                continue;
            }
            if is_item_start(cur(pcx)) {
                syntax_error(c"expected '}' (items cannot be nested in blocks)", pcx);
            }
            // A recovery point: after an error, on at the next statement.
            let depth = pcx.recover_depth;
            let stmts = pcx.scratch.count;
            let start = pcx.p;
            let mut stmt: i64 = 0;
            if _setjmp(recover_enter(pcx)) == 0 {
                if tail != 0 {
                    syntax_error(c"expected ';' or '}' after expression", pcx);
                }
                stmt = parse_stmt(pcx);
            } else {
                pcx.scratch.count = stmts;
                pcx.no_struct = false;
                skip_statement(start, pcx);
                pcx.body_failed = true;
            }
            recover_leave(depth, pcx);
            if stmt == 0 {
                continue;
            }
            if pcx.nodes[stmt as usize].kind == NodeKind::ExprStmt
                && pcx.nodes[stmt as usize].b == 2 {
                // A tail expression.
                tail = pcx.nodes[stmt as usize].a;
            } else {
                list_push(stmt, pcx);
            }
        }
        list_end(block, mark, pcx);
        pcx.nodes[block as usize].a = tail;
        if !open {
            expect(RBrace, pcx);
        }
        pcx.no_struct = saved;
        pcx.nodes[block as usize].end = prev_end(pcx);
        block
    }
}

pub fn is_item_start(kind: Tok) -> bool {
    kind == Fn || kind == Extern || kind == Struct || kind == Const
        || kind == Static || kind == Type || kind == Enum || kind == Impl
        || kind == Union || kind == Import || kind == Use
}

// `name:` before `loop`, `while` or `for`.
pub fn at_label(pcx: &Ctx<Comp>) -> bool {
    let after = tok_kind(2, pcx);
    (at(Ident, pcx) || at(Tok::Lifetime, pcx)) && tok_kind(1, pcx) == Colon
        && (after == Loop || after == While || after == For)
}

pub fn at_block_like(pcx: &Ctx<Comp>) -> bool {
    let kind = cur(pcx);
    kind == LBrace || kind == If || kind == Loop || kind == While
        || kind == For || kind == Match || at_label(pcx)
        || (kind == Unsafe && tok_kind(1, pcx) == LBrace)
}

fn expr_stmt(expr: i64, has_semi: i64, start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::ExprStmt, start, prev_end(pcx), pcx);
    pcx.nodes[n as usize].a = expr;
    pcx.nodes[n as usize].b = has_semi;
    n
}

// A statement; an NodeKind::ExprStmt with b == 2 is the block's tail expression.
pub fn parse_stmt(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if at(Let, pcx) {
        return parse_let(pcx);
    }
    if at_block_like(pcx) {
        // Ends at its closing brace; a `;` right after belongs to it.
        let expr = parse_primary(pcx);
        if at(RBrace, pcx) {
            return expr_stmt(expr, 2, start, pcx);
        }
        let has_semi = eat(Semi, pcx);
        return expr_stmt(expr, has_semi as i64, start, pcx);
    }
    let expr = parse_expr(pcx);
    if at(Semi, pcx) {
        advance(pcx);
        return expr_stmt(expr, 1, start, pcx);
    }
    if at(RBrace, pcx) {
        return expr_stmt(expr, 2, start, pcx);
    }
    syntax_error(c"expected ';' or '}' after expression", pcx)
}

fn parse_let(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    // (0.20) `var PAT = e;` (mutable bindings: `let mut`), `inout x = e;`
    // (an exclusive access: `let x = &mut place`), conventions.md §5.2
    let is_var = !at(Let, pcx);
    advance(pcx);
    let n = new_node(NodeKind::Let, start, 0, pcx);
    let mut let_mut = false;
    pcx.nodes[n as usize].a = parse_pattern(pcx);
    if let_mut {
        mark_mutable(pcx.nodes[n as usize].a, pcx);
    }
    if is_var {
        pcx.nodes[n as usize].p |= CONV_NEW;
        mark_mutable(pcx.nodes[n as usize].a, pcx);
    }
    if eat(Colon, pcx) {
        pcx.nodes[n as usize].b = parse_type(pcx);
    }
    if at(Semi, pcx) {
        // (0.27.1: the rust edition's `let x: T;` and `let x;`, deferred
        // initialization: no initializer, c = 0; the borrow checker
        // checks it is assigned before it is read, D8)
        expect(Semi, pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    if at(Semi, pcx) {
        error_at(cur_start(pcx),
            c"'let' without an initializer is not supported; give the binding a value", pcx);
    }
    expect(Eq, pcx);
    pcx.nodes[n as usize].c = parse_expr(pcx);
    // RULE: F27.2 (0.27.6: `let ref x = e;` is `let x = &e;`, `let ref mut
    // x = e;` `let x = &mut e;`, and `let ref x: T = e;` `let x: &T = &e;`:
    // a place is borrowed, not moved into the binding's temporary)
    let pat = pcx.nodes[n as usize].a;
    if pcx.nodes[pat as usize].kind == NodeKind::PatBind && pcx.nodes[pat as usize].c != 0 {
        let mutable = pcx.nodes[pat as usize].c == crate::front::types::REF_MUT;
        pcx.nodes[pat as usize].c = 0;
        let init = pcx.nodes[n as usize].c;
        let amp = crate::front::parser::exprs::make_unary(Tok::Amp, init,
            pcx.nodes[init as usize].start, pcx);
        pcx.nodes[amp as usize].p |= CONV_NEW;
        if mutable {
            pcx.nodes[amp as usize].p |= NODE_REF_MUT;
        }
        pcx.nodes[n as usize].c = amp;
        let ann = pcx.nodes[n as usize].b;
        if ann != 0 {
            let t = new_node(NodeKind::TyPtr, pcx.nodes[ann as usize].start,
                pcx.nodes[ann as usize].end, pcx);
            pcx.nodes[t as usize].a = ann;
            pcx.nodes[t as usize].p |= if mutable { NODE_REF | NODE_REF_MUT } else { NODE_REF };
            pcx.nodes[n as usize].b = t;
        }
    }
    if at(Tok::Else, pcx) {
        let_else(n, pcx);
    }
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// (0.20) The bindings of pattern p made mutable (`var (a, b) = t`).
fn mark_mutable(p: i64, pcx: &mut Ctx<Comp>) {
    if p <= 0 {
        return;
    }
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::PatBind {
        pcx.nodes[p as usize].b = 1;
        return;
    }
    if k == NodeKind::FieldInit {
        mark_mutable(pcx.nodes[p as usize].b, pcx);
        return;
    }
    for i in 0..pcx.nodes[p as usize].count {
        mark_mutable(child(p, i, pcx), pcx);
    }
}

// (0.18.1) `let PAT = e else { .. };` (n, at the `else`): `let (a, b) =
// match e { PAT => (a, b), _ => { .. } };` with PAT's bindings (one: `let
// a`; none: `let _`), the else block an arm that must not end normally
// (ARM_LET_ELSE). A binding is a name that starts with a lower-case
// letter or `_`, as Rust's; the nodes made have no text of their own.
fn let_else(n: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let else_at = cur_start(pcx);
        expect(Tok::Else, pcx);
        if pcx.nodes[n as usize].b != 0 {
            error_at(else_at, c"a type on a 'let ... else' pattern is not supported: give the value its type ('e as T', or a typed 'let' before)", pcx);
        }
        if !at(LBrace, pcx) {
            error_at(cur_start(pcx),
                c"'let ... else' takes a block: 'let Some(x) = e else { return; };'", pcx);
        }
        let block = parse_block(pcx);
        let pat = pcx.nodes[n as usize].a;
        let init = pcx.nodes[n as usize].c;
        let at0 = pcx.nodes[pat as usize].start;
        let mark = list_begin(pcx);
        let_else_bindings(pat, pcx);
        let count = pcx.scratch.count - mark;
        let names = alloc_array::<i64>(count + 1);
        for i in 0..count {
            (*names.add(i as usize)) = (*pcx.scratch.data.add((mark + i) as usize));
        }
        pcx.scratch.count = mark;
        // The value of the matching arm, and the outer pattern.
        let mut value: i64 = 0;
        let mut outer: i64 = 0;
        if count == 0 {
            value = new_node(NodeKind::Unit, at0, at0, pcx);
            outer = new_node(NodeKind::PatWild, at0, at0, pcx);
        } else if count == 1 {
            value = new_node(NodeKind::Ident, at0, at0, pcx);
            pcx.nodes[value as usize].a = pcx.nodes[(*names.add(0)) as usize].a;
            outer = new_node(NodeKind::PatBind, at0, at0, pcx);
            pcx.nodes[outer as usize].a = pcx.nodes[(*names.add(0)) as usize].a;
            pcx.nodes[outer as usize].b = pcx.nodes[(*names.add(0)) as usize].b;
        } else {
            value = new_node(NodeKind::Tuple, at0, at0, pcx);
            outer = new_node(NodeKind::PatTuple, at0, at0, pcx);
            let vm = list_begin(pcx);
            for i in 0..count {
                let id = new_node(NodeKind::Ident, at0, at0, pcx);
                pcx.nodes[id as usize].a = pcx.nodes[(*names.add(i as usize)) as usize].a;
                list_push(id, pcx);
            }
            list_end(value, vm, pcx);
            let pm = list_begin(pcx);
            for i in 0..count {
                let b = new_node(NodeKind::PatBind, at0, at0, pcx);
                pcx.nodes[b as usize].a = pcx.nodes[(*names.add(i as usize)) as usize].a;
                pcx.nodes[b as usize].b = pcx.nodes[(*names.add(i as usize)) as usize].b;
                list_push(b, pcx);
            }
            list_end(outer, pm, pcx);
        }
        free(names as *mut u8);
        let arm = new_node(NodeKind::Arm, pcx.nodes[pat as usize].start,
            pcx.nodes[pat as usize].end, pcx);
        pcx.nodes[arm as usize].a = pat;
        pcx.nodes[arm as usize].c = value;
        let other = new_node(NodeKind::Arm, else_at, pcx.nodes[block as usize].end, pcx);
        pcx.nodes[other as usize].a = new_node(NodeKind::PatWild, else_at, else_at, pcx);
        pcx.nodes[other as usize].c = block;
        pcx.nodes[other as usize].p = ARM_LET_ELSE | ARM_SYNTHETIC;
        let m = new_node(NodeKind::Match, pcx.nodes[init as usize].start,
            pcx.nodes[block as usize].end, pcx);
        pcx.nodes[m as usize].a = init;
        let am = list_begin(pcx);
        list_push(arm, pcx);
        list_push(other, pcx);
        list_end(m, am, pcx);
        pcx.nodes[n as usize].a = outer;
        pcx.nodes[n as usize].c = m;
    }
}

// The bindings of let-else pattern p (PatBind nodes) onto SCRATCH: names
// that start with a lower-case letter or `_` (the others name constants
// and variants).
fn let_else_bindings(p: i64, pcx: &mut Ctx<Comp>) {
    let k = pcx.nodes[p as usize].kind;
    if k == NodeKind::PatBind {
        let t = sym_text(pcx.nodes[p as usize].a, pcx);
        if t.len() > 0 && (t[0] >= b'a' && t[0] <= b'z' || t[0] == b'_') {
            list_push(p, pcx);
        }
        return;
    }
    if k == NodeKind::PatOr {
        if pcx.nodes[p as usize].count > 0 {
            let_else_bindings(child(p, 0, pcx), pcx);
        }
        return;
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant {
        for i in 0..pcx.nodes[p as usize].count {
            let c = child(p, i, pcx);
            let_else_bindings(if pcx.nodes[c as usize].kind
                == NodeKind::FieldInit { pcx.nodes[c as usize].b }
                else { c }, pcx);
        }
    }
}

// ---- Patterns ----

// A pattern: alternatives separated by `|`.
pub fn parse_pattern(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let first = parse_single_pattern(pcx);
    if !at(Pipe, pcx) {
        return first;
    }
    let n = new_node(NodeKind::PatOr, start, 0, pcx);
    let mark = list_begin(pcx);
    list_push(first, pcx);
    while eat(Pipe, pcx) {
        list_push(parse_single_pattern(pcx), pcx);
    }
    list_end(n, mark, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

fn at_literal_pattern(pcx: &Ctx<Comp>) -> bool {
    let kind = cur(pcx);
    kind == Int || kind == Char || kind == True || kind == False
        || (kind == Minus && (tok_kind(1, pcx) == Int || tok_kind(1, pcx) == Float))
        || kind == Float
}

// A literal (or a constant's name) in a pattern: an expression node.
fn parse_pattern_literal(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if at(Minus, pcx) {
        advance(pcx);
        let operand = parse_primary(pcx);
        return make_unary(Minus, operand, start, pcx);
    }
    if at(Ident, pcx) && tok_kind(1, pcx) != ColonColon {
        let n = new_node(NodeKind::Ident, start, 0, pcx);
        pcx.nodes[n as usize].a = expect_ident(pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    parse_primary(pcx)
}

// `lo ..= hi` after the low end has been parsed.
fn parse_range_pattern(start: i64, low: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if at(DotDot, pcx) {
        error_at(cur_start(pcx), c"exclusive range patterns are not supported; use 'a..=b'", pcx);
    }
    expect(DotDotEq, pcx);
    let n = new_node(NodeKind::PatRange, start, 0, pcx);
    pcx.nodes[n as usize].a = low;
    if !(at_literal_pattern(pcx) || at(Ident, pcx)) {
        syntax_error(c"expected the end of the range pattern", pcx);
    }
    pcx.nodes[n as usize].b = parse_pattern_literal(pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

pub fn parse_single_pattern(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if at(Ident, pcx) && pcx.toks[pcx.p as usize].value as i64 == pcx.underscore {
        advance(pcx);
        return new_node(NodeKind::PatWild, start, prev_end(pcx), pcx);
    }
    // (0.27.0) `ref x`, `ref mut x` in the rust edition: a binding by
    // reference (c: REF_SHARED or REF_MUT; front/patterns check_pat)
    if at(Ident, pcx) && (tok_kind(1, pcx) == Ident || tok_kind(1, pcx) == Mut)
        && crate::base::sym_text(pcx.toks[pcx.p as usize].value as i64, pcx) == b"ref" {
        advance(pcx);
        let mutable = eat(Mut, pcx);
        let n = new_node(NodeKind::PatBind, start, 0, pcx);
        pcx.nodes[n as usize].a = expect_binding_name(pcx);
        pcx.nodes[n as usize].c = if mutable { crate::front::types::REF_MUT }
            else { crate::front::types::REF_SHARED };
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    if at(Tok::Amp, pcx) {
        // (0.27.0) `&p`, `&mut p` in the rust edition: p matched against
        // what the reference points to, its bindings by value
        // (front/patterns check_pat, PAT_AMP)
        advance(pcx);
        eat(Mut, pcx);
        let n = parse_single_pattern(pcx);
        pcx.nodes[n as usize].p |= crate::front::ast::PAT_AMP;
        pcx.nodes[n as usize].start = start;
        return n;
    }
    if at(Mut, pcx) {
        // (0.20) `var x` (0.19: `mut x`; in 0.20's spelling conv.rust)
        advance(pcx);
        let n = new_node(NodeKind::PatBind, start, 0, pcx);
        pcx.nodes[n as usize].a = expect_binding_name(pcx);
        pcx.nodes[n as usize].b = 1;
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    if at_literal_pattern(pcx) {
        let low = parse_pattern_literal(pcx);
        if at(DotDotEq, pcx) || at(DotDot, pcx) {
            return parse_range_pattern(start, low, pcx);
        }
        let n = new_node(NodeKind::PatLit, start, prev_end(pcx), pcx);
        pcx.nodes[n as usize].a = low;
        return n;
    }
    if at(Ident, pcx) && tok_kind(1, pcx) == ColonColon {
        return parse_variant_pattern(start, pcx);
    }
    if at(Ident, pcx) && (tok_kind(1, pcx) == DotDotEq || tok_kind(1, pcx) == DotDot) {
        let low = parse_pattern_literal(pcx);
        return parse_range_pattern(start, low, pcx);
    }
    if at(Ident, pcx) && tok_kind(1, pcx) == LParen {
        // `V(p, ...)`: a variant brought into scope by `use` (0.4); its
        // enum is found by the checker (d = 1).
        let n = new_node(NodeKind::PatVariant, start, 0, pcx);
        pcx.nodes[n as usize].b = expect_ident(pcx);
        pcx.nodes[n as usize].d = 1;
        pcx.nodes[n as usize].c = 1;
        pcx.nodes[n as usize].p |= PAT_PARENS;
        expect(LParen, pcx);
        let mark = list_begin(pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_pattern(pcx), pcx);
            if !eat(Comma, pcx) {
                break;
            }
        }
        list_end(n, mark, pcx);
        expect(RParen, pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    if at(Ident, pcx) && tok_kind(1, pcx) == LBrace {
        // `V { a, .. }` (0.17): a variant brought into scope by `use`.
        let n = new_node(NodeKind::PatVariant, start, 0, pcx);
        pcx.nodes[n as usize].b = expect_ident(pcx);
        pcx.nodes[n as usize].d = 1;
        parse_pattern_fields(n, pcx);
        return n;
    }
    if at(Ident, pcx) {
        let n = new_node(NodeKind::PatBind, start, 0, pcx);
        pcx.nodes[n as usize].a = expect_ident(pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    if at(LParen, pcx) {
        return parse_tuple_pattern(start, pcx);
    }
    if at(Reserved, pcx) {
        reserved_error(pcx);
    }
    syntax_error(c"expected a pattern", pcx)
}

// `E::V` or `E::V(p, ...)`; `m::E::V` (0.5): h = a Path of the segments
// before the enum's name.
fn parse_variant_pattern(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::PatVariant, start, 0, pcx);
    let mark = list_begin(pcx);
    let mut name = expect_ident(pcx);
    expect(ColonColon, pcx);
    let mut member = expect_ident(pcx);
    while at(ColonColon, pcx) {
        advance(pcx);
        let seg = new_node(NodeKind::Ident, start, prev_end(pcx), pcx);
        pcx.nodes[seg as usize].a = name;
        list_push(seg, pcx);
        name = member;
        member = expect_ident(pcx);
    }
    if pcx.scratch.count > mark {
        let prefix = new_node(NodeKind::Path, start, prev_end(pcx), pcx);
        list_end(prefix, mark, pcx);
        pcx.nodes[n as usize].h = prefix;
    }
    pcx.nodes[n as usize].a = name;
    pcx.nodes[n as usize].b = member;
    if at(LBrace, pcx) {
        parse_pattern_fields(n, pcx);
    } else if eat(LParen, pcx) {
        pcx.nodes[n as usize].c = 1;
        pcx.nodes[n as usize].p |= PAT_PARENS;
        let mark = list_begin(pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_pattern(pcx), pcx);
            if !eat(Comma, pcx) {
                break;
            }
        }
        list_end(n, mark, pcx);
        expect(RParen, pcx);
    }
    pcx.nodes[n as usize].end = prev_end(pcx);
    if pcx.nodes[n as usize].c == 0 && (at(DotDotEq, pcx) || at(DotDot, pcx)) {
        // `E::A..=E::C` (0.4).
        if at(DotDot, pcx) {
            error_at(cur_start(pcx), c"exclusive range patterns are not supported; use 'a..=b'",
                pcx);
        }
        advance(pcx);
        let r = new_node(NodeKind::PatRange, start, 0, pcx);
        pcx.nodes[r as usize].a = n;
        if at(Ident, pcx) && tok_kind(1, pcx) == ColonColon {
            pcx.nodes[r as usize].b = parse_variant_pattern(cur_start(pcx), pcx);
        } else {
            // (0.17) `i8::MIN..=-1`: a constant's path (made a Path
            // by the checker when the value is an integer)
            if !(at_literal_pattern(pcx) || at(Ident, pcx)) {
                syntax_error(c"expected the end of the range pattern", pcx);
            }
            pcx.nodes[r as usize].b = parse_pattern_literal(pcx);
        }
        pcx.nodes[r as usize].end = prev_end(pcx);
        return r;
    }
    n
}

// (0.17) The fields of a variant's pattern `{ a, b: p, mut c, .. }`, after
// its name: FieldInit nodes in n's list (a: the name, b: the pattern; `a`
// alone binds a), n flagged PAT_FIELDS (and PAT_REST with `..`).
fn parse_pattern_fields(n: i64, pcx: &mut Ctx<Comp>) {
    expect(LBrace, pcx);
    pcx.nodes[n as usize].c = 1;
    pcx.nodes[n as usize].p |= PAT_FIELDS;
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        if at(DotDot, pcx) {
            advance(pcx);
            pcx.nodes[n as usize].p |= PAT_REST;
            if !at(RBrace, pcx) {
                syntax_error(c"expected '}' after '..' (it comes last in a variant's pattern)",
                    pcx);
            }
            break;
        }
        let start = cur_start(pcx);
        let field = new_node(NodeKind::FieldInit, start, 0, pcx);
        // (0.20) `var a` (0.19: `mut a`)
        // (0.27.2) `ref a`, `ref mut a` in the rust edition. RULE: F27.1
        let mut mode: i64 = 0;
        if at(Ident, pcx) && (tok_kind(1, pcx) == Ident || tok_kind(1, pcx) == Mut)
            && crate::base::sym_text(pcx.toks[pcx.p as usize].value as i64, pcx) == b"ref" {
            advance(pcx);
            mode = if eat(Mut, pcx) { crate::front::types::REF_MUT }
                else { crate::front::types::REF_SHARED };
        }
        let mutable = mode == 0 && (eat(Mut, pcx));
        pcx.nodes[field as usize].a = expect_binding_name(pcx);
        if !mutable && mode == 0 && eat(Colon, pcx) {
            pcx.nodes[field as usize].b = parse_pattern(pcx);
        } else {
            // `a` (or `mut a`): `a: a`
            let bind = new_node(NodeKind::PatBind, start, prev_end(pcx), pcx);
            pcx.nodes[bind as usize].a = pcx.nodes[field as usize].a;
            pcx.nodes[bind as usize].b = mutable as i64;
            pcx.nodes[bind as usize].c = mode;
            pcx.nodes[field as usize].b = bind;
            pcx.nodes[field as usize].p |= FIELD_SHORTHAND;
        }
        pcx.nodes[field as usize].end = prev_end(pcx);
        list_push(field, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RBrace, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
}

fn parse_tuple_pattern(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        expect(LParen, pcx);
        let n = new_node(NodeKind::PatTuple, start, 0, pcx);
        let mark = list_begin(pcx);
        let mut trailing_comma = false;
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_pattern(pcx), pcx);
            trailing_comma = eat(Comma, pcx);
            if !trailing_comma {
                break;
            }
        }
        expect(RParen, pcx);
        if pcx.scratch.count - mark == 1 && !trailing_comma {
            let only = (*pcx.scratch.data.add(mark as usize));
            pcx.scratch.count = mark;
            return only;
        }
        list_end(n, mark, pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        n
    }
}
