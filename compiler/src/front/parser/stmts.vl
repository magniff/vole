// Blocks and statements (`let`, `defer`, expression statements, items in
// a block), with the recovery after a syntax error in a statement; and
// the patterns of `let`, `match`, `if let` and `for`.

use crate::base::{SYMS, _setjmp, alloc_array, buf_bytes, buf_new, buf_slice, free};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end_soft, err_help, err_str, error_at, recover_enter, recover_leave,
};
use crate::front::ast::{
    ARM_LET_ELSE, ARM_SYNTHETIC, CONV_INOUT, CONV_NEW, FIELD_SHORTHAND, NODES, NODE_REF,
    NODE_REF_MUT, NodeKind, PAT_FIELDS, PAT_PARENS, PAT_REST, child, list_begin, list_end,
    list_push, new_node,
};
use crate::front::conv::{rust_spelling, strict_at};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{
    Char, Colon, ColonColon, Comma, Const, Defer, DotDot, DotDotEq, Enum, Eof, Eq, Extern, False,
    Float, Fn, For, Ident, If, Impl, Import, Int, LBrace, LParen, Let, Loop, Match, Minus, Mut,
    Pipe, RBrace, RParen, Reserved, Semi, Static, Struct, True, Type, Union, Unsafe, Use, While,
};
use crate::front::parser::{
    advance, at, cur, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end,
    reserved_error, skip_statement, syntax_error, tok_kind, with_no_struct,
};
use crate::front::parser::exprs::{make_unary, parse_expr, parse_primary};
use crate::front::parser::types::parse_type;

// ---- Blocks and statements ----

pub fn parse_block(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let start = cur_start(pcx);
        expect(LBrace, &pcx);
        let saved = with_no_struct(false, &pcx);
        let block = new_node(NodeKind::Block, start, 0);
        let mark = list_begin(pcx);
        var tail = 0;
        while !at(RBrace, pcx) && !at(Eof, pcx) {
            if eat(Semi, &pcx) {
                continue;
            }
            if is_item_start(cur(pcx)) {
                syntax_error(c"expected '}' (items cannot be nested in blocks)", &pcx);
            }
            // A recovery point: after an error, on at the next statement.
            let depth = pcx.recover_depth;
            let stmts = pcx.scratch.count;
            let start = pcx.p;
            var stmt = 0;
            if _setjmp(recover_enter(&pcx)) == 0 {
                if tail != 0 {
                    syntax_error(c"expected ';' or '}' after expression", &pcx);
                }
                stmt = parse_stmt(&pcx);
            } else {
                pcx.scratch.count = stmts;
                pcx.no_struct = false;
                skip_statement(start, &pcx);
                pcx.body_failed = true;
            }
            recover_leave(depth, &pcx);
            if stmt == 0 {
                continue;
            }
            if NODES[stmt].kind == NodeKind::ExprStmt && NODES[stmt].b == 2 {
                // A tail expression.
                tail = NODES[stmt].a;
            } else {
                list_push(stmt, &pcx);
            }
        }
        list_end(block, mark, &pcx);
        NODES[block].a = tail;
        expect(RBrace, &pcx);
        pcx.no_struct = saved;
        NODES[block].end = prev_end(pcx);
        block
    }
}

pub fn is_item_start(kind: Tok) -> bool {
    kind == Fn || kind == Extern || kind == Struct || kind == Const
        || kind == Static || kind == Type || kind == Enum || kind == Impl
        || kind == Union || kind == Import || kind == Use
}

// `name:` before `loop`, `while` or `for`.
pub fn at_label(pcx: Ctx<Comp>) -> bool {
    let after = tok_kind(2, pcx);
    at(Ident, pcx) && tok_kind(1, pcx) == Colon
        && (after == Loop || after == While || after == For)
}

pub fn at_block_like(pcx: Ctx<Comp>) -> bool {
    let kind = cur(pcx);
    kind == LBrace || kind == If || kind == Loop || kind == While
        || kind == For || kind == Match || at_label(pcx)
        || (kind == Unsafe && tok_kind(1, pcx) == LBrace)
}

fn expr_stmt(expr: i64, has_semi: i64, start: i64, pcx: Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::ExprStmt, start, prev_end(pcx));
    NODES[n].a = expr;
    NODES[n].b = has_semi;
    n
}

// A statement; an NodeKind::ExprStmt with b == 2 is the block's tail expression.
pub fn parse_stmt(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if at(Let, pcx) || at_var_binding(pcx) {
        return parse_let(&pcx);
    }
    if at(Defer, pcx) {
        return parse_defer(&pcx);
    }
    if at_block_like(pcx) {
        // Ends at its closing brace; a `;` right after belongs to it.
        let expr = parse_primary(&pcx);
        if at(RBrace, pcx) {
            return expr_stmt(expr, 2, start, pcx);
        }
        let has_semi = eat(Semi, &pcx);
        return expr_stmt(expr, has_semi as i64, start, pcx);
    }
    let expr = parse_expr(&pcx);
    if at(Semi, pcx) {
        advance(&pcx);
        return expr_stmt(expr, 1, start, pcx);
    }
    if at(RBrace, pcx) {
        return expr_stmt(expr, 2, start, pcx);
    }
    syntax_error(c"expected ';' or '}' after expression", &pcx)
}

// `defer expr;` or `defer { ... }`: error syntax.defer (0.26.2; 0.6 to
// 0.26.1 ran it at the block's exit). The keyword stays reserved so that
// the error names it; the statement is parsed as its body, so that the
// rest of the file is read.
fn parse_defer(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let saved = pcx.err_kind;
    pcx.err_kind = c"syntax.defer";
    err_begin(start, &pcx);
    err_str(c"'defer' is removed (0.26.2): Rust has none", pcx);
    err_help(c"a guard whose Drop does it: `struct Closer { fd: i32 } impl Drop for Closer { fn drop(inout self) { close(self.fd); } }`, then `let _closer = Closer { fd };`; a value with a Drop of its own (a Vec, a Buf) needs nothing", pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
    expect(Defer, &pcx);
    if at(LBrace, pcx) {
        let body = parse_block(&pcx);
        eat(Semi, &pcx);
        return expr_stmt(body, 1, start, pcx);
    }
    let body = parse_expr(&pcx);
    expect(Semi, &pcx);
    expr_stmt(body, 1, start, pcx)
}

fn parse_let(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    // (0.20) `var PAT = e;` (mutable bindings: `let mut`), `inout x = e;`
    // (an exclusive access: `let x = &mut place`), conventions.md §5.2
    let is_var = !at(Let, pcx);
    let is_inout = at(Tok::Inout, pcx);
    advance(&pcx);
    let n = new_node(NodeKind::Let, start, 0);
    var let_mut = false;
    if strict_at(start, &pcx) && !is_var && at(Mut, pcx) && tok_kind(1, pcx) == Ident {
        // (`let mut x`: one error, for both words)
        rust_spelling(start, pcx.toks[pcx.p].end, "a mutable binding is 'var x'", "var", &pcx);
        advance(&pcx);
        let_mut = true;
    }
    NODES[n].a = parse_pattern(&pcx);
    if let_mut {
        mark_mutable(NODES[n].a, pcx);
    }
    if is_var {
        NODES[n].p |= CONV_NEW;
        if is_inout {
            NODES[n].p |= CONV_INOUT;
        } else {
            mark_mutable(NODES[n].a, pcx);
        }
    }
    if eat(Colon, &pcx) {
        NODES[n].b = parse_type(&pcx);
        if is_inout && NODES[NODES[n].b].kind != NodeKind::TySlice {
            // `inout x: T = ..`: x designates a T (until T1, `&mut T`)
            let t = new_node(NodeKind::TyPtr, NODES[NODES[n].b].start, NODES[NODES[n].b].end);
            NODES[t].a = NODES[n].b;
            NODES[t].p |= CONV_NEW | NODE_REF | NODE_REF_MUT;
            NODES[n].b = t;
        } else if is_inout {
            NODES[NODES[n].b].p |= CONV_NEW | NODE_REF_MUT;
        }
    }
    if at(Semi, pcx) {
        error_at(cur_start(pcx),
            c"'let' without an initializer is not supported; give the binding a value", &pcx);
    }
    expect(Eq, &pcx);
    NODES[n].c = parse_expr(&pcx);
    if is_inout {
        let c = NODES[n].c;
        if NODES[c].kind == NodeKind::Unary && NODES[c].op == Tok::Amp {
            // `inout x = &place`: the marker lends the place exclusively
            NODES[c].p |= NODE_REF_MUT;
        }
    }
    if at(Tok::Else, pcx) {
        let_else(n, &pcx);
    }
    expect(Semi, &pcx);
    NODES[n].end = prev_end(pcx);
    n
}

// (0.20) The bindings of pattern p made mutable (`var (a, b) = t`).
fn mark_mutable(p: i64, pcx: Ctx<Comp>) {
    if p <= 0 {
        return;
    }
    let k = NODES[p].kind;
    if k == NodeKind::PatBind {
        NODES[p].b = 1;
        return;
    }
    if k == NodeKind::FieldInit {
        mark_mutable(NODES[p].b, pcx);
        return;
    }
    for i in 0..NODES[p].count {
        mark_mutable(child(p, i, pcx), pcx);
    }
}

// (0.20) Whether a statement starts here with `var PAT =` or `inout x =`
// (keywords from 0.21).
fn at_var_binding(pcx: Ctx<Comp>) -> bool {
    at(Tok::Var, pcx) || at(Tok::Inout, pcx)
}

// (0.18.1) `let PAT = e else { .. };` (n, at the `else`): `let (a, b) =
// match e { PAT => (a, b), _ => { .. } };` with PAT's bindings (one: `let
// a`; none: `let _`), the else block an arm that must not end normally
// (ARM_LET_ELSE). A binding is a name that starts with a lower-case
// letter or `_`, as Rust's; the nodes made have no text of their own.
fn let_else(n: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let else_at = cur_start(pcx);
        expect(Tok::Else, &pcx);
        if NODES[n].b != 0 {
            error_at(else_at, c"a type on a 'let ... else' pattern is not supported: give the value its type ('e as T', or a typed 'let' before)", &pcx);
        }
        if !at(LBrace, pcx) {
            error_at(cur_start(pcx),
                c"'let ... else' takes a block: 'let Some(x) = e else { return; };'", &pcx);
        }
        let block = parse_block(&pcx);
        let pat = NODES[n].a;
        let init = NODES[n].c;
        let at0 = NODES[pat].start;
        let mark = list_begin(pcx);
        let_else_bindings(pat, &pcx);
        let count = pcx.scratch.count - mark;
        let names = alloc_array::<i64>(count + 1);
        for i in 0..count {
            names[i] = pcx.scratch.data[mark + i];
        }
        pcx.scratch.count = mark;
        // The value of the matching arm, and the outer pattern.
        var value = 0;
        var outer = 0;
        if count == 0 {
            value = new_node(NodeKind::Unit, at0, at0);
            outer = new_node(NodeKind::PatWild, at0, at0);
        } else if count == 1 {
            value = new_node(NodeKind::Ident, at0, at0);
            NODES[value].a = NODES[names[0]].a;
            outer = new_node(NodeKind::PatBind, at0, at0);
            NODES[outer].a = NODES[names[0]].a;
            NODES[outer].b = NODES[names[0]].b;
        } else {
            value = new_node(NodeKind::Tuple, at0, at0);
            outer = new_node(NodeKind::PatTuple, at0, at0);
            let vm = list_begin(pcx);
            for i in 0..count {
                let id = new_node(NodeKind::Ident, at0, at0);
                NODES[id].a = NODES[names[i]].a;
                list_push(id, &pcx);
            }
            list_end(value, vm, &pcx);
            let pm = list_begin(pcx);
            for i in 0..count {
                let b = new_node(NodeKind::PatBind, at0, at0);
                NODES[b].a = NODES[names[i]].a;
                NODES[b].b = NODES[names[i]].b;
                list_push(b, &pcx);
            }
            list_end(outer, pm, &pcx);
        }
        free(names as *u8);
        let arm = new_node(NodeKind::Arm, NODES[pat].start, NODES[pat].end);
        NODES[arm].a = pat;
        NODES[arm].c = value;
        let other = new_node(NodeKind::Arm, else_at, NODES[block].end);
        NODES[other].a = new_node(NodeKind::PatWild, else_at, else_at);
        NODES[other].c = block;
        NODES[other].p = ARM_LET_ELSE | ARM_SYNTHETIC;
        let m = new_node(NodeKind::Match, NODES[init].start, NODES[block].end);
        NODES[m].a = init;
        let am = list_begin(pcx);
        list_push(arm, &pcx);
        list_push(other, &pcx);
        list_end(m, am, &pcx);
        NODES[n].a = outer;
        NODES[n].c = m;
    }
}

// The bindings of let-else pattern p (PatBind nodes) onto SCRATCH: names
// that start with a lower-case letter or `_` (the others name constants
// and variants).
fn let_else_bindings(p: i64, pcx: inout Ctx<Comp>) {
    let k = NODES[p].kind;
    if k == NodeKind::PatBind {
        let t = SYMS[NODES[p].a].text;
        if t.len > 0 && (t[0] >= 'a' && t[0] <= 'z' || t[0] == '_') {
            list_push(p, &pcx);
        }
        return;
    }
    if k == NodeKind::PatOr {
        if NODES[p].count > 0 {
            let_else_bindings(child(p, 0, pcx), &pcx);
        }
        return;
    }
    if k == NodeKind::PatTuple || k == NodeKind::PatVariant {
        for i in 0..NODES[p].count {
            let c = child(p, i, pcx);
            let_else_bindings(if NODES[c].kind == NodeKind::FieldInit { NODES[c].b }
                else { c }, &pcx);
        }
    }
}

// ---- Patterns ----

// A pattern: alternatives separated by `|`.
pub fn parse_pattern(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let first = parse_single_pattern(&pcx);
    if !at(Pipe, pcx) {
        return first;
    }
    let n = new_node(NodeKind::PatOr, start, 0);
    let mark = list_begin(pcx);
    list_push(first, &pcx);
    while eat(Pipe, &pcx) {
        list_push(parse_single_pattern(&pcx), &pcx);
    }
    list_end(n, mark, &pcx);
    NODES[n].end = prev_end(pcx);
    n
}

fn at_literal_pattern(pcx: Ctx<Comp>) -> bool {
    let kind = cur(pcx);
    kind == Int || kind == Char || kind == True || kind == False
        || (kind == Minus && (tok_kind(1, pcx) == Int || tok_kind(1, pcx) == Float))
        || kind == Float
}

// A literal (or a constant's name) in a pattern: an expression node.
fn parse_pattern_literal(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if at(Minus, pcx) {
        advance(&pcx);
        let operand = parse_primary(&pcx);
        return make_unary(Minus, operand, start);
    }
    if at(Ident, pcx) && tok_kind(1, pcx) != ColonColon {
        let n = new_node(NodeKind::Ident, start, 0);
        NODES[n].a = expect_ident(&pcx);
        NODES[n].end = prev_end(pcx);
        return n;
    }
    parse_primary(&pcx)
}

// `lo ..= hi` after the low end has been parsed.
fn parse_range_pattern(start: i64, low: i64, pcx: inout Ctx<Comp>) -> i64 {
    if at(DotDot, pcx) {
        error_at(cur_start(pcx), c"exclusive range patterns are not supported; use 'a..=b'", &pcx);
    }
    expect(DotDotEq, &pcx);
    let n = new_node(NodeKind::PatRange, start, 0);
    NODES[n].a = low;
    if !(at_literal_pattern(pcx) || at(Ident, pcx)) {
        syntax_error(c"expected the end of the range pattern", &pcx);
    }
    NODES[n].b = parse_pattern_literal(&pcx);
    NODES[n].end = prev_end(pcx);
    n
}

pub fn parse_single_pattern(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if at(Ident, pcx) && pcx.toks[pcx.p].value as i64 == pcx.underscore {
        advance(&pcx);
        return new_node(NodeKind::PatWild, start, prev_end(pcx));
    }
    if at(Tok::Inout, pcx) || at(Tok::Sink, pcx) {
        // (0.21: keywords, no names)
        crate::front::parser::convention_word_error(&pcx);
    }
    if at(Mut, pcx) || at(Tok::Var, pcx) {
        // (0.20) `var x` (0.19: `mut x`; in 0.20's spelling conv.rust)
        if at(Mut, pcx) && strict_at(start, &pcx) {
            mut_binding(start, &pcx);
        }
        advance(&pcx);
        let n = new_node(NodeKind::PatBind, start, 0);
        NODES[n].a = expect_binding_name(&pcx);
        NODES[n].b = 1;
        NODES[n].end = prev_end(pcx);
        return n;
    }
    if at_literal_pattern(pcx) {
        let low = parse_pattern_literal(&pcx);
        if at(DotDotEq, pcx) || at(DotDot, pcx) {
            return parse_range_pattern(start, low, &pcx);
        }
        let n = new_node(NodeKind::PatLit, start, prev_end(pcx));
        NODES[n].a = low;
        return n;
    }
    if at(Ident, pcx) && tok_kind(1, pcx) == ColonColon {
        return parse_variant_pattern(start, &pcx);
    }
    if at(Ident, pcx) && (tok_kind(1, pcx) == DotDotEq || tok_kind(1, pcx) == DotDot) {
        let low = parse_pattern_literal(&pcx);
        return parse_range_pattern(start, low, &pcx);
    }
    if at(Ident, pcx) && tok_kind(1, pcx) == LParen {
        // `V(p, ...)`: a variant brought into scope by `use` (0.4); its
        // enum is found by the checker (d = 1).
        let n = new_node(NodeKind::PatVariant, start, 0);
        NODES[n].b = expect_ident(&pcx);
        NODES[n].d = 1;
        NODES[n].c = 1;
        NODES[n].p |= PAT_PARENS;
        expect(LParen, &pcx);
        let mark = list_begin(pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_pattern(&pcx), &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
        list_end(n, mark, &pcx);
        expect(RParen, &pcx);
        NODES[n].end = prev_end(pcx);
        return n;
    }
    if at(Ident, pcx) && tok_kind(1, pcx) == LBrace {
        // `V { a, .. }` (0.17): a variant brought into scope by `use`.
        let n = new_node(NodeKind::PatVariant, start, 0);
        NODES[n].b = expect_ident(&pcx);
        NODES[n].d = 1;
        parse_pattern_fields(n, &pcx);
        return n;
    }
    if at(Ident, pcx) {
        let n = new_node(NodeKind::PatBind, start, 0);
        NODES[n].a = expect_ident(&pcx);
        NODES[n].end = prev_end(pcx);
        return n;
    }
    if at(LParen, pcx) {
        return parse_tuple_pattern(start, &pcx);
    }
    if at(Reserved, pcx) {
        reserved_error(&pcx);
    }
    syntax_error(c"expected a pattern", &pcx)
}

// `E::V` or `E::V(p, ...)`; `m::E::V` (0.5): h = a Path of the segments
// before the enum's name.
fn parse_variant_pattern(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::PatVariant, start, 0);
    let mark = list_begin(pcx);
    var name = expect_ident(&pcx);
    expect(ColonColon, &pcx);
    var member = expect_ident(&pcx);
    while at(ColonColon, pcx) {
        advance(&pcx);
        let seg = new_node(NodeKind::Ident, start, prev_end(pcx));
        NODES[seg].a = name;
        list_push(seg, &pcx);
        name = member;
        member = expect_ident(&pcx);
    }
    if pcx.scratch.count > mark {
        let prefix = new_node(NodeKind::Path, start, prev_end(pcx));
        list_end(prefix, mark, &pcx);
        NODES[n].h = prefix;
    }
    NODES[n].a = name;
    NODES[n].b = member;
    if at(LBrace, pcx) {
        parse_pattern_fields(n, &pcx);
    } else if eat(LParen, &pcx) {
        NODES[n].c = 1;
        NODES[n].p |= PAT_PARENS;
        let mark = list_begin(pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_pattern(&pcx), &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
        list_end(n, mark, &pcx);
        expect(RParen, &pcx);
    }
    NODES[n].end = prev_end(pcx);
    if NODES[n].c == 0 && (at(DotDotEq, pcx) || at(DotDot, pcx)) {
        // `E::A..=E::C` (0.4).
        if at(DotDot, pcx) {
            error_at(cur_start(pcx), c"exclusive range patterns are not supported; use 'a..=b'",
                &pcx);
        }
        advance(&pcx);
        let r = new_node(NodeKind::PatRange, start, 0);
        NODES[r].a = n;
        if at(Ident, pcx) && tok_kind(1, pcx) == ColonColon {
            NODES[r].b = parse_variant_pattern(cur_start(pcx), &pcx);
        } else {
            // (0.17) `i8::MIN..=-1`: a constant's path (made a Path
            // by the checker when the value is an integer)
            if !(at_literal_pattern(pcx) || at(Ident, pcx)) {
                syntax_error(c"expected the end of the range pattern", &pcx);
            }
            NODES[r].b = parse_pattern_literal(&pcx);
        }
        NODES[r].end = prev_end(pcx);
        return r;
    }
    n
}

// (0.17) The fields of a variant's pattern `{ a, b: p, mut c, .. }`, after
// its name: FieldInit nodes in n's list (a: the name, b: the pattern; `a`
// alone binds a), n flagged PAT_FIELDS (and PAT_REST with `..`).
fn parse_pattern_fields(n: i64, pcx: inout Ctx<Comp>) {
    expect(LBrace, &pcx);
    NODES[n].c = 1;
    NODES[n].p |= PAT_FIELDS;
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        if at(DotDot, pcx) {
            advance(&pcx);
            NODES[n].p |= PAT_REST;
            if !at(RBrace, pcx) {
                syntax_error(c"expected '}' after '..' (it comes last in a variant's pattern)",
                    &pcx);
            }
            break;
        }
        let start = cur_start(pcx);
        let field = new_node(NodeKind::FieldInit, start, 0);
        // (0.20) `var a` (0.19: `mut a`)
        if at(Mut, pcx) && strict_at(start, &pcx) {
            mut_binding(start, &pcx);
        }
        let mutable = eat(Mut, &pcx)
            || eat(Tok::Var, &pcx);
        NODES[field].a = expect_binding_name(&pcx);
        if !mutable && eat(Colon, &pcx) {
            NODES[field].b = parse_pattern(&pcx);
        } else {
            // `a` (or `mut a`): `a: a`
            let bind = new_node(NodeKind::PatBind, start, prev_end(pcx));
            NODES[bind].a = NODES[field].a;
            NODES[bind].b = mutable as i64;
            NODES[field].b = bind;
            NODES[field].p |= FIELD_SHORTHAND;
        }
        NODES[field].end = prev_end(pcx);
        list_push(field, &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    expect(RBrace, &pcx);
    NODES[n].end = prev_end(pcx);
}

// (0.20) conv.rust for `mut x` in a pattern, at `mut`: `var x`.
fn mut_binding(start: i64, pcx: inout Ctx<Comp>) {
    if tok_kind(1, pcx) != Ident {
        return;
    }
    let new = buf_new();
    buf_bytes(new, "var ");
    buf_bytes(new, SYMS[pcx.toks[pcx.p + 1].value as i64].text);
    rust_spelling(start, pcx.toks[pcx.p + 1].end, "a mutable binding is 'var x'", buf_slice(new),
        &pcx);
}

fn parse_tuple_pattern(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        expect(LParen, &pcx);
        let n = new_node(NodeKind::PatTuple, start, 0);
        let mark = list_begin(pcx);
        var trailing_comma = false;
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_pattern(&pcx), &pcx);
            trailing_comma = eat(Comma, &pcx);
            if !trailing_comma {
                break;
            }
        }
        expect(RParen, &pcx);
        if pcx.scratch.count - mark == 1 && !trailing_comma {
            let only = pcx.scratch.data[mark];
            pcx.scratch.count = mark;
            return only;
        }
        list_end(n, mark, &pcx);
        NODES[n].end = prev_end(pcx);
        n
    }
}
