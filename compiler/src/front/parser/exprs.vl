// Expressions: a Pratt parser with the binding powers of docs/grammar.md
// (infix, prefix and postfix operators), the primary expressions
// (literals, paths, struct literals, tuples, arrays) and the expressions
// with blocks: `if`, `if let`, `match` and the loops.

use crate::base::{SRC, buf_bytes, buf_new, buf_slice, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fmt, err_help, err_str, err_sym, err_try_tool, error_at,
};
use crate::front::ast::{
    ARM_NO_ELSE, ARM_SYNTHETIC, BLOCK_UNSAFE, CLOSURE_MOVE, CONV_NEW, CONV_SINK, FIELD_SHORTHAND,
    FMT_BIN, FMT_CHAR, FMT_EXP, FMT_HEX, FMT_LEFT, FMT_RIGHT, FMT_UPPER, FMT_ZERO, NODE_REF_MUT,
    NodeKind, list_begin, list_end, list_push, new_node,
};
use crate::front::check::arch::turbofish_const_error;
use crate::front::conv::{rust_spelling, strict_at};
use crate::front::embed::embed_file;
use crate::front::lexer::{SUF_NONE, Tok, Token, is_digit, str_at};
use crate::front::lexer::Tok::{
    Amp, AmpAmp, AmpEq, Arrow, As, At, Bang, BangEq, Break, CStr, Caret, CaretEq, Char, Colon,
    ColonColon, Comma, Continue, Dot, DotDot, DotDotEq, Else, Eof, Eq, EqEq, False, FatArrow, Float,
    For, Gt, GtEq, Hash, Ident, If, In, Int, LBrace, LBracket, LParen, Let, Loop, Lt, LtEq, Match,
    Minus, MinusEq, Mut, Percent, PercentEq, Pipe, PipeEq, PipePipe, Plus, PlusEq, Question, RBrace,
    RBracket, RParen, Reserved, Return, Semi, Shl, ShlEq, Shr, ShrEq, Slash, SlashEq, Star, StarEq,
    Str, Tilde, True, Unsafe, While,
};
use crate::front::parser::{
    advance, at, at_macro_call, cur, cur_start, eat, expect, expect_binding_name, expect_ident,
    macro_error, prev_end, reserved_error, syntax_error, tok_kind, with_no_struct,
};
use crate::front::parser::stmts::{
    at_block_like, at_label, parse_block, parse_pattern, parse_single_pattern,
};
use crate::front::parser::types::{parse_type, parse_type_args};

const AS_BP: i64 = 24;
const PREFIX_BP: i64 = 25;
const POSTFIX_BP: i64 = 27;

pub fn parse_expr(pcx: inout Ctx<Comp>) -> i64 {
    parse_expr_bp(0, &pcx)
}

fn parse_expr_no_struct(pcx: inout Ctx<Comp>) -> i64 {
    let saved = with_no_struct(true, &pcx);
    let e = parse_expr_bp(0, &pcx);
    pcx.no_struct = saved;
    e
}

// Left and right binding powers of an infix operator token, 0 if none.
pub fn infix_left_bp(kind: Tok) -> i64 {
    match kind {
        Eq | PlusEq | MinusEq | StarEq | SlashEq | PercentEq
            | AmpEq | PipeEq | CaretEq | ShlEq | ShrEq => 2,
        DotDot | DotDotEq => 4,
        PipePipe => 6,
        AmpAmp => 8,
        EqEq | BangEq | Lt | Gt | LtEq | GtEq => 10,
        Pipe => 12,
        Caret => 14,
        Amp => 16,
        Shl | Shr => 18,
        Plus | Minus => 20,
        Star | Slash | Percent => 22,
        _ => 0,
    }
}

pub fn is_comparison(kind: Tok) -> bool {
    infix_left_bp(kind) == 10
}

fn is_assign_op(kind: Tok) -> bool {
    infix_left_bp(kind) == 2
}

fn is_reserved_punct(kind: Tok) -> bool {
    kind == Hash || kind == At
}

// Non-associative level of an operator: 1 comparison, 2 range, 0 none.
fn non_assoc_level(kind: Tok) -> i64 {
    if is_comparison(kind) { return 1; }
    if kind == DotDot || kind == DotDotEq { return 2; }
    0
}

fn parse_expr_bp(min_bp: i64, pcx: inout Ctx<Comp>) -> i64 {
    let lhs = parse_prefix(&pcx);
    parse_infix(lhs, min_bp, &pcx)
}

// Continues an expression whose first operand `first` is parsed.
fn parse_infix(first: i64, min_bp: i64, pcx: inout Ctx<Comp>) -> i64 {
    var lhs = first;
    var built_by = 0;
    loop {
        let kind = cur(pcx);
        if (kind == LParen || kind == LBracket || kind == Dot) && POSTFIX_BP >= min_bp {
            lhs = parse_postfix(lhs, &pcx);
            built_by = 0;
            continue;
        }
        if kind == Question && POSTFIX_BP >= min_bp {
            // `e?` (0.15)
            let n = new_node(NodeKind::Try, pcx.nodes[lhs].start, pcx.toks[pcx.p].end, &pcx);
            pcx.nodes[n].a = lhs;
            advance(&pcx);
            lhs = n;
            built_by = 0;
            continue;
        }
        if kind == As && AS_BP >= min_bp {
            advance(&pcx);
            let n = new_node(NodeKind::Cast, pcx.nodes[lhs].start, 0, &pcx);
            pcx.nodes[n].a = lhs;
            pcx.nodes[n].b = parse_type(&pcx);
            pcx.nodes[n].end = prev_end(pcx);
            lhs = n;
            built_by = 0;
            continue;
        }
        if is_reserved_punct(kind) {
            reserved_error(&pcx);
        }
        let left_bp = infix_left_bp(kind);
        if left_bp == 0 || left_bp < min_bp {
            break;
        }
        let level = non_assoc_level(kind);
        if level != 0 && built_by == level {
            if level == 1 {
                error_at(cur_start(pcx),
                    c"comparison operators cannot be chained; use parentheses", &pcx);
            }
            error_at(cur_start(pcx), c"range operators cannot be chained; use parentheses", &pcx);
        }
        advance(&pcx);
        // Assignment is right-associative; everything else left.
        let right_bp = if left_bp == 2 { 1 } else { left_bp + 1 };
        let rhs = parse_expr_bp(right_bp, &pcx);
        lhs = make_infix(kind, lhs, rhs, &pcx);
        built_by = level;
    }
    lhs
}

fn make_infix(kind: Tok, lhs: i64, rhs: i64, pcx: inout Ctx<Comp>) -> i64 {
    let start = pcx.nodes[lhs].start;
    let end = pcx.nodes[rhs].end;
    if is_assign_op(kind) {
        let n = new_node(NodeKind::Assign, start, end, &pcx);
        pcx.nodes[n].op = kind;
        pcx.nodes[n].b = lhs;
        pcx.nodes[n].c = rhs;
        return n;
    }
    if kind == DotDot || kind == DotDotEq {
        let n = new_node(NodeKind::Range, start, end, &pcx);
        pcx.nodes[n].a = lhs;
        pcx.nodes[n].b = rhs;
        pcx.nodes[n].c = (kind == DotDotEq) as i64;
        return n;
    }
    let n = new_node(NodeKind::Binary, start, end, &pcx);
    pcx.nodes[n].op = kind;
    pcx.nodes[n].b = lhs;
    pcx.nodes[n].c = rhs;
    n
}

fn starts_expr(kind: Tok) -> bool {
    kind == Int || kind == Float || kind == Char || kind == Str || kind == CStr
        || kind == Ident || kind == True || kind == False || kind == LParen
        || kind == LBracket || kind == LBrace || kind == Minus || kind == Bang
        || kind == Tilde || kind == Star || kind == Amp || kind == AmpAmp
        || kind == If || kind == Loop || kind == While || kind == For
        || kind == Return || kind == Break || kind == Continue || kind == Match
        || kind == Unsafe || kind == Pipe || kind == PipePipe || kind == Tok::Move
}

pub fn make_unary(op: Tok, operand: i64, start: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Unary, start, pcx.nodes[operand].end, &pcx);
    pcx.nodes[n].op = op;
    pcx.nodes[n].b = operand;
    n
}

fn parse_prefix(pcx: inout Ctx<Comp>) -> i64 {
    let kind = cur(pcx);
    let start = cur_start(pcx);
    if kind == Minus || kind == Bang || kind == Tilde || kind == Star || kind == Amp {
        advance(&pcx);
        // (0.17) `&mut x`: an exclusive reference (`&x`: a shared one;
        // docs/design/value-semantics.md §2.3)
        let mutable = kind == Amp && eat(Mut, &pcx);
        let operand = parse_expr_bp(PREFIX_BP, &pcx);
        let n = make_unary(kind, operand, start, &pcx);
        if mutable {
            pcx.nodes[n].p |= NODE_REF_MUT;
        }
        if kind == Amp && !crate::front::conv::generated_at(start, &pcx) {
            // (0.20) `&x` is the inout marker (front/conv: inout_marker):
            // in a file read in 0.20's spelling always exclusive; mixed,
            // where an exclusive reference is expected
            pcx.nodes[n].p |= CONV_NEW;
            if strict_at(start, &pcx) {
                if mutable {
                    let new = buf_new();
                    buf_bytes(new, "&");
                    buf_bytes(new, SRC[pcx.nodes[operand].start..pcx.nodes[operand].end]);
                    rust_spelling(start, pcx.nodes[operand].end,
                        "an inout argument (the callee may change it) is marked '&x'",
                        buf_slice(new), &pcx);
                }
                pcx.nodes[n].p |= NODE_REF_MUT;
            }
        }
        return n;
    }
    if kind == AmpAmp {
        // `&&x` is `& &x`.
        advance(&pcx);
        let operand = parse_expr_bp(PREFIX_BP, &pcx);
        let inner = make_unary(Amp, operand, start + 1, &pcx);
        return make_unary(Amp, inner, start, &pcx);
    }
    if kind == Plus {
        error_at(start, c"unary '+' is not supported", &pcx);
    }
    if kind == Return {
        advance(&pcx);
        let n = new_node(NodeKind::Return, start, 0, &pcx);
        pcx.nodes[n].a = parse_jump_value(&pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if kind == Break {
        advance(&pcx);
        let n = new_node(NodeKind::Break, start, 0, &pcx);
        pcx.nodes[n].a = parse_jump_label(&pcx);
        pcx.nodes[n].b = parse_jump_value(&pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if kind == Continue {
        advance(&pcx);
        let n = new_node(NodeKind::Continue, start, 0, &pcx);
        pcx.nodes[n].a = parse_jump_label(&pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if kind == DotDot || kind == DotDotEq {
        error_at(start, c"a range needs a start: write 'a..b'", &pcx);
    }
    if kind == Pipe || kind == PipePipe || kind == Tok::Move
        || kind == Tok::Sink {
        return parse_closure(&pcx);
    }
    parse_primary(&pcx)
}

// A closure (0.14): `move |a, (b, c): (i64, i64)| expr`, `|| -> T { ... }`.
// The body has binding power 0, as in Rust.
fn parse_closure(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let n = new_node(NodeKind::Closure, start, 0, &pcx);
    if at(Tok::Move, pcx) && strict_at(start, &pcx) {
        rust_spelling(start, pcx.toks[pcx.p].end,
            "a closure that takes its captures is 'sink |..|'", "sink", &pcx);
    }
    if eat(Tok::Move, &pcx) {
        pcx.nodes[n].c = CLOSURE_MOVE;
    } else if at(Tok::Sink, pcx) {
        // (0.20) `sink |..|` (conventions.md D19)
        advance(&pcx);
        pcx.nodes[n].c = CLOSURE_MOVE;
        pcx.nodes[n].p |= CONV_NEW | CONV_SINK;
    }
    let mark = list_begin(pcx);
    if !eat(PipePipe, &pcx) {
        expect(Pipe, &pcx);
        while !at(Pipe, pcx) && !at(Eof, pcx) {
            list_push(parse_closure_param(&pcx), &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
        expect(Pipe, &pcx);
    }
    list_end(n, mark, &pcx);
    if eat(Arrow, &pcx) {
        pcx.nodes[n].b = parse_type(&pcx);
        if !at(LBrace, pcx) {
            syntax_error(
                c"expected '{' after a closure's result type: '|x: i64| -> i64 { x + 1 }'", &pcx);
        }
        pcx.nodes[n].a = parse_block(&pcx);
    } else {
        pcx.nodes[n].a = parse_expr_bp(0, &pcx);
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// A closure's parameter: a pattern (no `|` alternatives), then `: type`
// unless it is inferred. A Param node: a=the name (0: a pattern) b=the
// type (0: none) c=mutable d=the pattern (0: a plain name).
fn parse_closure_param(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let n = new_node(NodeKind::Param, start, 0, &pcx);
    let pattern = parse_single_pattern(&pcx);
    if pcx.nodes[pattern].kind == NodeKind::PatBind {
        pcx.nodes[n].a = pcx.nodes[pattern].a;
        pcx.nodes[n].c = pcx.nodes[pattern].b;
    } else {
        pcx.nodes[n].d = pattern;
    }
    if eat(Colon, &pcx) {
        // (0.25.3) `|d: sink D|`: a by-value parameter, as `fn(sink D)`'s
        // (conv::closure_param_type); the closure drops it unless moved
        let by_value = at(Tok::Sink, pcx);
        if by_value {
            advance(&pcx);
        }
        pcx.nodes[n].b = parse_type(&pcx);
        if by_value {
            pcx.nodes[pcx.nodes[n].b].p |= CONV_SINK;
        }
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn parse_jump_value(pcx: inout Ctx<Comp>) -> i64 {
    if starts_expr(cur(pcx)) { parse_expr_bp(0, &pcx) } else { 0 }
}

fn parse_jump_label(pcx: inout Ctx<Comp>) -> i64 {
    // (0.27.0: `break 'outer`, the rust edition's)
    let lifetime = crate::front::parser::rust::ref_lifetime(&pcx);
    if lifetime != 0 {
        return lifetime;
    }
    if at(Colon, pcx) && tok_kind(1, pcx) == Ident {
        advance(&pcx);
        return expect_ident(&pcx);
    }
    0
}

fn parse_postfix(lhs: i64, pcx: inout Ctx<Comp>) -> i64 {
    let start = pcx.nodes[lhs].start;
    if at(LParen, pcx) && pcx.nodes[lhs].kind == NodeKind::Ident && pcx.nodes[lhs].g == 0
        && (pcx.nodes[lhs].a == intern_c(c"size_of", &pcx)
            || pcx.nodes[lhs].a == intern_c(c"align_of", &pcx)) {
        // `size_of(T)`, `align_of(T)` (builtins, 0.5): the argument is a
        // type (`size_of(Node<T>)`).
        advance(&pcx);
        let n = new_node(NodeKind::Call, start, 0, &pcx);
        pcx.nodes[n].a = lhs;
        let mark = list_begin(pcx);
        list_push(parse_type(&pcx), &pcx);
        list_end(n, mark, &pcx);
        expect(RParen, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if eat(LParen, &pcx) {
        let n = new_node(NodeKind::Call, start, 0, &pcx);
        pcx.nodes[n].a = lhs;
        let saved = with_no_struct(false, &pcx);
        parse_expr_list(n, RParen, &pcx);
        pcx.no_struct = saved;
        expect(RParen, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if eat(LBracket, &pcx) {
        let n = new_node(NodeKind::Index, start, 0, &pcx);
        pcx.nodes[n].a = lhs;
        let saved = with_no_struct(false, &pcx);
        pcx.nodes[n].b = parse_index(&pcx);
        pcx.no_struct = saved;
        expect(RBracket, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    expect(Dot, &pcx);
    if at(Ident, pcx) {
        if tok_kind(1, pcx) == LParen
            || (tok_kind(1, pcx) == ColonColon && tok_kind(2, pcx) == Lt) {
            let n = new_node(NodeKind::MethodCall, start, 0, &pcx);
            pcx.nodes[n].a = lhs;
            pcx.nodes[n].b = expect_ident(&pcx);
            if eat(ColonColon, &pcx) {
                pcx.nodes[n].g = parse_type_args(&pcx);
            }
            expect(LParen, &pcx);
            let saved = with_no_struct(false, &pcx);
            parse_expr_list(n, RParen, &pcx);
            pcx.no_struct = saved;
            expect(RParen, &pcx);
            pcx.nodes[n].end = prev_end(pcx);
            return n;
        }
        let n = new_node(NodeKind::FieldAccess, start, 0, &pcx);
        pcx.nodes[n].a = lhs;
        pcx.nodes[n].b = expect_ident(&pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if at(Int, pcx) && pcx.toks[pcx.p].suffix == SUF_NONE {
        let n = new_node(NodeKind::TupleField, start, pcx.toks[pcx.p].end, &pcx);
        pcx.nodes[n].a = lhs;
        pcx.nodes[n].b = pcx.toks[pcx.p].value as i64;
        advance(&pcx);
        return n;
    }
    syntax_error(c"expected field name or index after '.'", &pcx)
}

// The inside of `[...]`: an index, or a range with optional ends
// (`lo..hi`, `lo..`, `..hi`, `..`, `lo..=hi`, `..=hi`) for slicing.
fn parse_index(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    var low = 0;
    if !at(DotDot, pcx) && !at(DotDotEq, pcx) {
        // Stops before a range operator.
        low = parse_expr_bp(5, &pcx);
        if !at(DotDot, pcx) && !at(DotDotEq, pcx) {
            return parse_infix(low, 0, &pcx);
        }
    }
    let inclusive = at(DotDotEq, pcx);
    advance(&pcx);
    let n = new_node(NodeKind::Range, start, 0, &pcx);
    pcx.nodes[n].a = low;
    pcx.nodes[n].c = inclusive as i64;
    if !at(RBracket, pcx) {
        pcx.nodes[n].b = parse_expr_bp(5, &pcx);
    } else if inclusive {
        syntax_error(c"an inclusive range needs an end", &pcx);
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// The arguments of call `n`, `e, e, ...` up to `close` (not consumed), as
// its list; 0.15: then the named ones, `name: e` (NamedArg nodes).
pub fn parse_expr_list(n: i64, close: Tok, pcx: inout Ctx<Comp>) {
    let mark = list_begin(pcx);
    var named = false;
    while !at(close, pcx) && !at(Eof, pcx) {
        // (0.26.2: `name = e`, a format argument, c = 1)
        let format_named = at(Ident, pcx) && tok_kind(1, pcx) == Tok::Eq;
        if at(Ident, pcx) && tok_kind(1, pcx) == Colon || format_named {
            let arg = new_node(NodeKind::NamedArg, cur_start(pcx), 0, &pcx);
            pcx.nodes[arg].a = expect_binding_name(&pcx);
            pcx.nodes[arg].c = if format_named { 1 } else { 0 };
            advance(&pcx);
            pcx.nodes[arg].b = parse_expr(&pcx);
            pcx.nodes[arg].end = prev_end(pcx);
            list_push(arg, &pcx);
            named = true;
        } else {
            let start = cur_start(pcx);
            let arg = parse_expr(&pcx);
            if named {
                error_at(start,
                    c"a positional argument after a named one: the named arguments come last",
                    &pcx);
            }
            list_push(arg, &pcx);
        }
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
}

fn literal_node(kind: NodeKind, start: i64, a: i64, b: i64, pcx: inout Ctx<Comp>) -> i64 {
    advance(&pcx);
    let n = new_node(kind, start, prev_end(pcx), &pcx);
    pcx.nodes[n].a = a;
    pcx.nodes[n].b = b;
    n
}

pub fn parse_primary(pcx: inout Ctx<Comp>) -> i64 {
    let kind = cur(pcx);
    let start = cur_start(pcx);
    let value = pcx.toks[pcx.p].value as i64;
    let suffix = pcx.toks[pcx.p].suffix;
    if kind == Int { return literal_node(NodeKind::Int, start, value, suffix, &pcx); }
    if kind == Float { return literal_node(NodeKind::Float, start, value, suffix, &pcx); }
    // (0.27.2: b 1 a rust-edition `char`, 2 a byte literal, F1.2, F23.2)
    if kind == Char { return literal_node(NodeKind::Char, start, value, suffix, &pcx); }
    if kind == Str { return literal_node(NodeKind::Str, start, value, 0, &pcx); }
    if kind == CStr { return literal_node(NodeKind::CStr, start, value, 0, &pcx); }
    if kind == Tok::FHead { return parse_fstring(&pcx); }
    if kind == True { return literal_node(NodeKind::Bool, start, 1, 0, &pcx); }
    if kind == False { return literal_node(NodeKind::Bool, start, 0, 0, &pcx); }
    if kind == LParen {
        let saved = with_no_struct(false, &pcx);
        let e = parse_paren_expr(&pcx);
        pcx.no_struct = saved;
        return e;
    }
    if kind == LBracket {
        let saved = with_no_struct(false, &pcx);
        let e = parse_array_literal(&pcx);
        pcx.no_struct = saved;
        return e;
    }
    if kind == LBrace { return parse_block(&pcx); }
    if kind == Unsafe {
        // `unsafe { ... }` (0.9): a block of unsafe code.
        advance(&pcx);
        if !at(LBrace, pcx) {
            syntax_error(
                c"expected '{' after 'unsafe' (an unsafe block), or 'unsafe fn' as an item", &pcx);
        }
        let block = parse_block(&pcx);
        pcx.nodes[block].start = start;
        pcx.nodes[block].p |= BLOCK_UNSAFE;
        return block;
    }
    if kind == If { return parse_if(&pcx); }
    if kind == Match { return parse_match(&pcx); }
    if kind == Loop || kind == While || kind == For {
        return parse_loop(0, start, &pcx);
    }
    if kind == Tok::Lifetime && at_label(pcx) {
        // (0.27.0: `'outer: loop`, the rust edition's label)
        let label = crate::front::parser::rust::ref_lifetime(&pcx);
        expect(Colon, &pcx);
        return parse_loop(label, start, &pcx);
    }
    if kind == Ident && at_label(pcx) {
        let label = expect_ident(&pcx);
        expect(Colon, &pcx);
        return parse_loop(label, start, &pcx);
    }
    if kind == Ident && value == pcx.underscore {
        error_at(start, c"'_' can only be used in patterns", &pcx);
    }
    if kind == Ident && include_kind(value, pcx) > 0 && (tok_kind(1, pcx) == LParen
        || tok_kind(1, pcx) == Bang && tok_kind(2, pcx) == LParen) {
        return parse_include(start, include_kind(value, pcx) == 2, &pcx);
    }
    if kind == Ident && at_macro_call(pcx) {
        // (0.18) The bang spellings of the assertions, panic and
        // unreachable: the name, called (`assert!(c)` is `assert(c)`).
        if bang_spelling(value, pcx) && tok_kind(2, pcx) == LParen {
            let n = new_node(NodeKind::Ident, start, pcx.toks[pcx.p].end, &pcx);
            pcx.nodes[n].a = value;
            advance(&pcx);
            advance(&pcx);
            return n;
        }
        macro_error(&pcx);
    }
    if kind == Ident {
        return parse_name_or_struct_literal(&pcx);
    }
    if is_reserved_punct(kind) || kind == Reserved {
        reserved_error(&pcx);
    }
    syntax_error(c"expected expression", &pcx)
}

// (0.25.3) 1 when `name` is include_str, 2 when it is include_bytes, else 0.
fn include_kind(name: i64, pcx: Ctx<Comp>) -> i64 {
    let text = sym_text(name, pcx);
    if text == "include_str" { 1 } else if text == "include_bytes" { 2 } else { 0 }
}

// (0.25.3) `include_str("path")` or `include_bytes("path")` at `start`
// (Rust's `include_str!(..)` too): the file's contents, a Str node
// (front::embed; b=1 for include_bytes: a `[u8]`).
fn parse_include(start: i64, bytes: bool, pcx: inout Ctx<Comp>) -> i64 {
    let name = expect_ident(&pcx);
    eat(Bang, &pcx);
    expect(LParen, &pcx);
    var id = -1;
    if at(Str, pcx) {
        // UNSAFE: the tokens are in TOKS, the lexer's raw array.
        // SAFETY: P is the parser's position, a token the lexer wrote (the
        // last one is Eof, so P < TOK_COUNT), here a Str: its value is a
        // string id.
        let rel = str_at(unsafe { pcx.toks[pcx.p].value } as i64);
        advance(&pcx);
        eat(Comma, &pcx);
        if !at(RParen, pcx) {
            expect(RParen, &pcx);
        }
        // (the call is start..the end of its `)`, one byte)
        id = embed_file(start, cur_start(pcx) + 1, rel, bytes, &pcx);
    } else {
        let saved = pcx.err_kind;
        pcx.err_kind = c"embed.path";
        err_begin(cur_start(pcx), &pcx);
        err_str(c"'", pcx);
        err_sym(name, pcx);
        err_str(c"' takes its file's path as a string literal", pcx);
        err_help(c"the path is read when the program is compiled: `include_str(\"shader.wgsl\")`, relative to this file's directory", pcx);
        err_end_soft(&pcx);
        pcx.err_kind = saved;
        // (the argument read, the call an empty string)
        parse_expr(&pcx);
        eat(Comma, &pcx);
        if !at(RParen, pcx) {
            expect(RParen, &pcx);
        }
        id = crate::front::lexer::add_string("");
    }
    // (the node: the call, from its name to its `)`)
    literal_node(NodeKind::Str, start, id, if bytes { 1 } else { 0 }, &pcx)
}

// (0.18) Whether `name!(..)` is one of the spellings vole accepts for
// its built-ins (design §2.2): assert, assert_eq, assert_ne, debug_assert,
// panic, unreachable. They are not macros: the name is called.
fn bang_spelling(name: i64, pcx: Ctx<Comp>) -> bool {
    let text = sym_text(name, pcx);
    text == "assert" || text == "assert_eq" || text == "assert_ne" || text == "debug_assert"
        || text == "panic" || text == "unreachable"
}

// (0.26.3) The kind and position of token t, one of the tokens written
// (0 <= t < TOK_COUNT).
fn token_at(t: i64, pcx: Ctx<Comp>) -> Token {
    // UNSAFE: TOKS is the lexer's token table, a raw pointer (front/lexer).
    // SAFETY: the callers keep t in 0..TOK_COUNT, the tokens the lexer wrote.
    unsafe { pcx.toks[t] }
}

// (0.26.3) error syntax.fstring, once per file: at its first f-string
// (start, the token P), with how many the file has; the f-string is
// still read, so that the rest of the file is, and `fix --only fstring`
// rewrites it. No state: an f-string after another of its file says
// nothing, so a program read twice (the LSP) has its errors twice.
fn fstring_removed(start: i64, pcx: inout Ctx<Comp>) {
    if pcx.fstrings_read {
        return;
    }
    // (the file's bounds: the last file that starts at or before start)
    var lo = 0;
    var hi = SRC.len() as i64;
    for f in 0..pcx.files.len() {
        if pcx.files[f].start > start {
            hi = pcx.files[f].start;
            break;
        }
        lo = pcx.files[f].start;
    }
    var t = pcx.p - 1;
    while t >= 0 && token_at(t, pcx).start >= lo {
        if token_at(t, pcx).kind == Tok::FHead {
            return;
        }
        t -= 1;
    }
    var count = 0;
    t = pcx.p;
    while t < pcx.toks.len() as i64 && token_at(t, pcx).start < hi {
        if token_at(t, pcx).kind == Tok::FHead {
            count += 1;
        }
        t += 1;
    }
    let saved = pcx.err_kind;
    pcx.err_kind = c"syntax.fstring";
    err_begin(start, &pcx);
    if count > 1 {
        err_fmt(format_args(
            "f-strings are removed (0.26.3): a format string takes the values as arguments ({count} in this file, the first here)"), pcx);
    } else {
        err_str(c"f-strings are removed (0.26.3): a format string takes the values as arguments",
            pcx);
    }
    err_help(c"a name stays in its hole and an expression goes after the literal: `println(\"{n} {}\", v.len())`; elsewhere `format_args(\"..\", args)`", pcx);
    err_try_tool("fix --only fstring --keep-braces", true, pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}

// An f-string (0.15; error syntax.fstring since 0.26.3): an Interp node,
// whose list is its texts (Str nodes, the empty ones left out) and holes
// (InterpHole nodes), in order.
fn parse_fstring(pcx: inout Ctx<Comp>) -> i64 {
    fstring_removed(cur_start(pcx), &pcx);
    let n = new_node(NodeKind::Interp, cur_start(pcx), 0, &pcx);
    let mark = list_begin(pcx);
    fstring_text(&pcx);
    let more = pcx.toks[pcx.p].suffix == 0;
    advance(&pcx);
    if more {
        let saved = with_no_struct(false, &pcx);
        loop {
            let hole = new_node(NodeKind::InterpHole, cur_start(pcx), 0, &pcx);
            pcx.nodes[hole].a = parse_expr(&pcx);
            pcx.nodes[hole].end = prev_end(pcx);
            if !at(Tok::FMid, pcx) && !at(Tok::FTail, pcx) {
                syntax_error(c"expected '}' after the expression of an f-string hole", &pcx);
            }
            parse_spec(hole, pcx.toks[pcx.p].suffix, &pcx);
            list_push(hole, &pcx);
            fstring_text(&pcx);
            let last = at(Tok::FTail, pcx);
            advance(&pcx);
            if last {
                break;
            }
        }
        pcx.no_struct = saved;
    }
    list_end(n, mark, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// The text of the f-string piece at P, a Str node pushed on the list being
// built (none when it is empty).
fn fstring_text(pcx: inout Ctx<Comp>) {
    let id = pcx.toks[pcx.p].value as i64;
    if str_at(id).len > 0 {
        let s = new_node(NodeKind::Str, pcx.toks[pcx.p].start, pcx.toks[pcx.p].end, &pcx);
        pcx.nodes[s].a = id;
        list_push(s, &pcx);
    }
}

// The spec of an f-string hole (0.15), string `spec` (-1: none), into the
// InterpHole's fields: `[<|>][0][width][.precision][?|x|X|b|c]`.
fn parse_spec(hole: i64, spec: i64, pcx: inout Ctx<Comp>) {
    pcx.nodes[hole].c = -1;
    pcx.nodes[hole].d = -1;
    if spec < 0 {
        return;
    }
    let s = str_at(spec);
    let pos = pcx.toks[pcx.p].start + 1;
    var i = 0;
    var flags = 0;
    if i < s.len as i64 && (s[i] == '<' || s[i] == '>') {
        flags |= if s[i] == '<' { FMT_LEFT } else { FMT_RIGHT };
        i += 1;
    }
    if i < s.len as i64 && s[i] == '0' {
        flags |= FMT_ZERO;
        i += 1;
    }
    if i < s.len as i64 && is_digit(s[i]) {
        pcx.nodes[hole].c = 0;
        while i < s.len as i64 && is_digit(s[i]) {
            pcx.nodes[hole].c = pcx.nodes[hole].c * 10 + (s[i] - '0') as i64;
            if pcx.nodes[hole].c > 65535 {
                error_at(pos, c"a format width is at most 65535", &pcx);
            }
            i += 1;
        }
    }
    if i < s.len as i64 && s[i] == '.' {
        i += 1;
        if i >= s.len as i64 || !is_digit(s[i]) {
            error_at(pos, c"expected the precision's digits after '.' in a format spec", &pcx);
        }
        pcx.nodes[hole].d = 0;
        while i < s.len as i64 && is_digit(s[i]) {
            pcx.nodes[hole].d = pcx.nodes[hole].d * 10 + (s[i] - '0') as i64;
            if pcx.nodes[hole].d > 65535 {
                error_at(pos, c"a format precision is at most 65535", &pcx);
            }
            i += 1;
        }
    }
    if i < s.len as i64 {
        let c = s[i];
        if c == '?' {
            pcx.nodes[hole].b = 1;
        } else if c == 'x' {
            flags |= FMT_HEX;
        } else if c == 'X' {
            flags |= FMT_HEX | FMT_UPPER;
        } else if c == 'b' {
            flags |= FMT_BIN;
        } else if c == 'c' {
            flags |= FMT_CHAR;
        } else if c == 'e' {
            flags |= FMT_EXP;
        } else if c == 'E' {
            flags |= FMT_EXP | FMT_UPPER;
        } else {
            i = -1;
        }
        i += 1;
    }
    if i != s.len as i64 {
        err_begin(pos, &pcx);
        err_str(c"invalid format spec ':", pcx);
        buf_bytes(pcx.err, s);
        err_str(c"'", pcx);
        err_help(c"a spec is [<|>][0][width][.precision] then one of ? (Debug), x, X, b, c, e, E: '{x:>8.2}', '{v:?}', '{n:08x}'", pcx);
        err_end(&pcx);
    }
    pcx.nodes[hole].p = flags;
}

// One segment of a path in an expression: a name, with type arguments
// after `::<` (an Ident node, g = the arguments).
fn parse_path_segment(pcx: inout Ctx<Comp>) -> i64 {
    let seg = new_node(NodeKind::Ident, cur_start(pcx), 0, &pcx);
    pcx.nodes[seg].a = expect_ident(&pcx);
    if at(ColonColon, pcx) && tok_kind(1, pcx) == Lt {
        if tok_kind(2, pcx) == Tok::Int {
            // (0.19: `vshrq_n_u8::<3>(v)`, Rust's const generics)
            turbofish_const_error(pcx.p - 1, &pcx);
        }
        advance(&pcx);
        pcx.nodes[seg].g = parse_type_args(&pcx);
    }
    pcx.nodes[seg].end = prev_end(pcx);
    seg
}

// A name (`x`, `max::<i64>`), a path (`T::m`, `a::b::c`), or a struct
// literal (`P { x: 1 }`, `Pair::<i64> { ... }`, `m::P { ... }`).
//
// A path of two segments is a Path node (a, b: the names, g: the first
// one's type arguments, h: the second's); with more, its list holds all
// the segments, and a, b, g, h describe the last two.
fn parse_name_or_struct_literal(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let start = cur_start(pcx);
        let first = parse_path_segment(&pcx);
        let mark = list_begin(pcx);
        list_push(first, &pcx);
        // (0.21) `env::var(..)`: the keyword read as the name after `::`,
        // so that front/conv::env_var_error says what std calls it
        if at(ColonColon, pcx) && tok_kind(1, pcx) == Tok::Var {
            pcx.toks[pcx.p + 1].kind = Ident;
        }
        while at(ColonColon, pcx) && tok_kind(1, pcx) == Ident {
            advance(&pcx);
            list_push(parse_path_segment(&pcx), &pcx);
            if at(ColonColon, pcx) && tok_kind(1, pcx) == Tok::Var {
                pcx.toks[pcx.p + 1].kind = Ident;
            }
        }
        let count = pcx.scratch.count - mark;
        if at(ColonColon, pcx) {
            advance(&pcx);
            syntax_error(c"expected a name after '::'", &pcx);
        }
        let last = pcx.scratch.data[pcx.scratch.count - 1];
        // (0.17) In a condition, `Name { a: ...` is a literal too (no block
        // starts with `a:` but a labelled loop's).
        let in_condition = pcx.no_struct && at(LBrace, pcx) && tok_kind(1, pcx) == Ident
            && tok_kind(2, pcx) == Colon && tok_kind(3, pcx) != Loop && tok_kind(3, pcx) != While
            && tok_kind(3, pcx) != For;
        if (!pcx.no_struct || in_condition) && at(LBrace, pcx) {
            advance(&pcx);
            let n = new_node(NodeKind::StructLit, start, 0, &pcx);
            pcx.nodes[n].a = pcx.nodes[last].a;
            pcx.nodes[n].g = pcx.nodes[last].g;
            if count > 1 {
                // The module path of the struct: h, a Path of the segments
                // before its name.
                let prefix = new_node(NodeKind::Path, start, pcx.nodes[last].start, &pcx);
                pcx.scratch.count -= 1;
                list_end(prefix, mark, &pcx);
                pcx.nodes[n].h = prefix;
            } else {
                pcx.scratch.count = mark;
            }
            let saved = with_no_struct(false, &pcx);
            let inits = list_begin(pcx);
            while !at(RBrace, pcx) && !at(Eof, pcx) {
                let init_start = cur_start(pcx);
                if at(DotDot, pcx) {
                    // (0.25.2.1) Rust's struct update, `S { a: 1, ..s }`
                    err_begin(init_start, &pcx);
                    err_str(c"vole has no struct update ('..base' in a struct literal): a literal names every field", pcx);
                    err_help(c"write each field (`S { a: 1, b: s.b }`), or copy the struct and set what changes: `var t = s; t.a = 1;`", pcx);
                    err_end(&pcx);
                }
                let init = new_node(NodeKind::FieldInit, init_start, 0, &pcx);
                // (0.27.2: a tuple struct's field by its index, `S { 0: x }`,
                // as Rust's and the derives write it, F7.1)
                if at(Int, pcx) && tok_kind(1, pcx) == Colon {
                    let digits = SRC[cur_start(pcx)..pcx.toks[pcx.p].end];
                    pcx.nodes[init].a = intern(digits, &pcx);
                    advance(&pcx);
                } else {
                    pcx.nodes[init].a = expect_binding_name(&pcx);
                }
                if at(Comma, pcx) || at(RBrace, pcx) {
                    // `S { x }` (0.15): `S { x: x }`
                    let value = new_node(NodeKind::Ident, init_start, prev_end(pcx), &pcx);
                    pcx.nodes[value].a = pcx.nodes[init].a;
                    pcx.nodes[init].b = value;
                    pcx.nodes[init].p |= FIELD_SHORTHAND;
                } else {
                    expect(Colon, &pcx);
                    pcx.nodes[init].b = parse_expr(&pcx);
                }
                pcx.nodes[init].end = prev_end(pcx);
                list_push(init, &pcx);
                if !eat(Comma, &pcx) {
                    break;
                }
            }
            list_end(n, inits, &pcx);
            pcx.no_struct = saved;
            expect(RBrace, &pcx);
            pcx.nodes[n].end = prev_end(pcx);
            return n;
        }
        if count == 1 {
            pcx.scratch.count = mark;
            return first;
        }
        let n = new_node(NodeKind::Path, start, prev_end(pcx), &pcx);
        let before = pcx.scratch.data[pcx.scratch.count - 2];
        pcx.nodes[n].a = pcx.nodes[before].a;
        pcx.nodes[n].g = pcx.nodes[before].g;
        pcx.nodes[n].b = pcx.nodes[last].a;
        pcx.nodes[n].h = pcx.nodes[last].g;
        if count == 2 {
            pcx.scratch.count = mark;
        } else {
            list_end(n, mark, &pcx);
        }
        n
    }
}

// `()`, `(e)`, `(e,)` or `(e, e, ...)`
fn parse_paren_expr(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(LParen, &pcx);
    if eat(RParen, &pcx) {
        return new_node(NodeKind::Unit, start, prev_end(pcx), &pcx);
    }
    let first = parse_expr(&pcx);
    if eat(Comma, &pcx) {
        let n = new_node(NodeKind::Tuple, start, 0, &pcx);
        let mark = list_begin(pcx);
        list_push(first, &pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            list_push(parse_expr(&pcx), &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
        list_end(n, mark, &pcx);
        expect(RParen, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    expect(RParen, &pcx);
    pcx.nodes[first].start = start;
    pcx.nodes[first].end = prev_end(pcx);
    first
}

// `[]`, `[e; n]` or `[e, e, ...]`
fn parse_array_literal(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(LBracket, &pcx);
    if eat(RBracket, &pcx) {
        return new_node(NodeKind::Array, start, prev_end(pcx), &pcx);
    }
    let first = parse_expr(&pcx);
    if eat(Semi, &pcx) {
        let n = new_node(NodeKind::Repeat, start, 0, &pcx);
        pcx.nodes[n].a = first;
        pcx.nodes[n].b = parse_expr(&pcx);
        expect(RBracket, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    let n = new_node(NodeKind::Array, start, 0, &pcx);
    let mark = list_begin(pcx);
    list_push(first, &pcx);
    if eat(Comma, &pcx) {
        while !at(RBracket, pcx) && !at(Eof, pcx) {
            list_push(parse_expr(&pcx), &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
    }
    list_end(n, mark, &pcx);
    expect(RBracket, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn parse_if(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(If, &pcx);
    if at(Let, pcx) {
        return parse_if_let(start, &pcx);
    }
    let n = new_node(NodeKind::If, start, 0, &pcx);
    pcx.nodes[n].a = parse_expr_no_struct(&pcx);
    pcx.nodes[n].b = parse_block(&pcx);
    if eat(Else, &pcx) {
        pcx.nodes[n].c = parse_else_part(&pcx);
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// The else part of an `if` (after `else`): a block, or a block holding
// just the inner `if` of an `else if`.
fn parse_else_part(pcx: inout Ctx<Comp>) -> i64 {
    if at(If, pcx) {
        let inner = parse_if(&pcx);
        let block = new_node(NodeKind::Block, pcx.nodes[inner].start, pcx.nodes[inner].end, &pcx);
        pcx.nodes[block].a = inner;
        return block;
    }
    parse_block(&pcx)
}

// A match arm made by the parser: `pattern => body`.
fn synthetic_arm(pattern: i64, body: i64, flags: i64, pcx: inout Ctx<Comp>) -> i64 {
    let arm = new_node(NodeKind::Arm, pcx.nodes[pattern].start, pcx.nodes[body].end, &pcx);
    pcx.nodes[arm].a = pattern;
    pcx.nodes[arm].c = body;
    pcx.nodes[arm].p = flags;
    arm
}

// `if let P = e { A } else { B }` (0.6), after `if`: the match
// `match e { P => { A }, _ => { B } }` (B: an empty block without `else`).
// The bindings of P are in scope in A only; P may be refutable or not.
fn parse_if_let(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    expect(Let, &pcx);
    let pattern = parse_pattern(&pcx);
    expect(Eq, &pcx);
    let n = new_node(NodeKind::Match, start, 0, &pcx);
    pcx.nodes[n].a = parse_expr_no_struct(&pcx);
    let then = parse_block(&pcx);
    var flags = ARM_SYNTHETIC;
    let otherwise = if eat(Else, &pcx) {
        parse_else_part(&pcx)
    } else {
        flags = ARM_SYNTHETIC | ARM_NO_ELSE;
        new_node(NodeKind::Block, prev_end(pcx), prev_end(pcx), &pcx)
    };
    let wild = new_node(NodeKind::PatWild, pcx.nodes[otherwise].start, pcx.nodes[otherwise].start,
        &pcx);
    let mark = list_begin(pcx);
    list_push(synthetic_arm(pattern, then, 0, &pcx), &pcx);
    list_push(synthetic_arm(wild, otherwise, flags, &pcx), &pcx);
    list_end(n, mark, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// `match e { pattern [if guard] => body, ... }`
fn parse_match(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Match, &pcx);
    let n = new_node(NodeKind::Match, start, 0, &pcx);
    pcx.nodes[n].a = parse_expr_no_struct(&pcx);
    expect(LBrace, &pcx);
    let saved = with_no_struct(false, &pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        let arm = new_node(NodeKind::Arm, cur_start(pcx), 0, &pcx);
        pcx.nodes[arm].a = parse_pattern(&pcx);
        if eat(If, &pcx) {
            pcx.nodes[arm].b = parse_expr(&pcx);
        }
        expect(FatArrow, &pcx);
        if at_block_like(pcx) {
            // Ends at its closing brace, like a statement.
            pcx.nodes[arm].c = parse_primary(&pcx);
            eat(Comma, &pcx);
        } else {
            pcx.nodes[arm].c = parse_expr(&pcx);
            if !at(RBrace, pcx) {
                if !at(Comma, pcx) {
                    syntax_error(c"expected ',' or '}' after a match arm", &pcx);
                }
                advance(&pcx);
            }
        }
        pcx.nodes[arm].end = prev_end(pcx);
        list_push(arm, &pcx);
    }
    list_end(n, mark, &pcx);
    pcx.no_struct = saved;
    expect(RBrace, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// `while let P = e { body }` (0.6), after `while`: the loop
// `loop { match e { P => { body }, _ => break } }`, keeping the label.
fn parse_while_let(label: i64, start: i64, pcx: inout Ctx<Comp>) -> i64 {
    expect(Let, &pcx);
    let pattern = parse_pattern(&pcx);
    expect(Eq, &pcx);
    let m = new_node(NodeKind::Match, start, 0, &pcx);
    pcx.nodes[m].a = parse_expr_no_struct(&pcx);
    let body = parse_block(&pcx);
    let brk = new_node(NodeKind::Break, pcx.nodes[body].end, pcx.nodes[body].end, &pcx);
    let wild = new_node(NodeKind::PatWild, pcx.nodes[body].end, pcx.nodes[body].end, &pcx);
    let mark = list_begin(pcx);
    list_push(synthetic_arm(pattern, body, 0, &pcx), &pcx);
    list_push(synthetic_arm(wild, brk, ARM_SYNTHETIC, &pcx), &pcx);
    list_end(m, mark, &pcx);
    pcx.nodes[m].end = prev_end(pcx);
    let block = new_node(NodeKind::Block, start, prev_end(pcx), &pcx);
    pcx.nodes[block].a = m;
    let n = new_node(NodeKind::Loop, start, prev_end(pcx), &pcx);
    pcx.nodes[n].a = label;
    pcx.nodes[n].b = block;
    n
}

fn parse_loop(label: i64, start: i64, pcx: inout Ctx<Comp>) -> i64 {
    if eat(Loop, &pcx) {
        let n = new_node(NodeKind::Loop, start, 0, &pcx);
        pcx.nodes[n].a = label;
        pcx.nodes[n].b = parse_block(&pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if eat(While, &pcx) {
        if at(Let, pcx) {
            return parse_while_let(label, start, &pcx);
        }
        let n = new_node(NodeKind::While, start, 0, &pcx);
        pcx.nodes[n].a = label;
        pcx.nodes[n].b = parse_expr_no_struct(&pcx);
        pcx.nodes[n].c = parse_block(&pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    expect(For, &pcx);
    let n = new_node(NodeKind::For, start, 0, &pcx);
    pcx.nodes[n].a = label;
    pcx.nodes[n].b = parse_pattern(&pcx);
    expect(In, &pcx);
    pcx.nodes[n].c = parse_expr_no_struct(&pcx);
    pcx.nodes[n].d = parse_block(&pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}
