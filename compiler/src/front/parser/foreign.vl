// `extern "C"` items: blocks of C declarations (functions and statics,
// with their link names), functions with the C convention, and statics
// with a C symbol.

use crate::back::objfile::output::add_link_decl;
use crate::base::{IntVec, intern, intern_c, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_at;
use crate::front::ast::{NodeKind, list_push, new_node};
use crate::front::check::name_error;
use crate::front::lexer::str_at;
use crate::front::lexer::Tok::{
    Arrow, Colon, Comma, Eof, Eq, Extern, Fn, Hash, Ident, LBrace, LBracket, LParen, Pub, RBrace,
    RBracket, RParen, Semi, Static, Str,
};
use crate::front::parser::{
    advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end, syntax_error,
    tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::items::{no_param_defaults, parse_function, parse_return_type};
use crate::front::parser::items::attrs::{
    has_effect_decls, parse_effect_attribute, take_effect_decls,
};
use crate::front::parser::items::params::parse_params;
use crate::front::parser::types::parse_type;

// (0.25) At `#[link(...)]`.
pub fn at_link_attribute(pcx: inout Ctx<Comp>) -> bool {
    tok_kind(0, pcx) == Hash && tok_kind(1, pcx) == LBracket && tok_kind(2, pcx) == Ident
        && pcx.toks[pcx.p + 2].value as i64 == intern_c(c"link", &pcx) && tok_kind(3, pcx) == LParen
}

// (0.25) `#[link(...)]`s before an extern block: what the program links
// when it calls into the block (back::objfile::output::add_link_decl), so
// a std module the program does not use links nothing. `framework =
// "Metal"` (macOS's; Linux leaves it out) or `lib = "objc"` (`-lobjc`);
// Rust's `name = "objc"`, with `kind = "framework"` for a framework, too.
// Several in one attribute, separated by commas, and several attributes.
// The block follows; link_block takes them when it is read.
pub fn parse_link_attributes(pcx: inout Ctx<Comp>) {
    let start = cur_start(pcx);
    while at_link_attribute(&pcx) {
        advance(&pcx);
        advance(&pcx);
        advance(&pcx);
        advance(&pcx);
        var name = 0 - 1;
        var framework = false;
        while !at(RParen, pcx) && !at(Eof, pcx) {
            let pos = cur_start(pcx);
            let key = expect_ident(&pcx);
            expect(Eq, &pcx);
            if !at(Str, pcx) {
                syntax_error(c"expected a string: `#[link(framework = \"Metal\")]` or `#[link(lib = \"objc\")]`", &pcx);
            }
            let value = pcx.toks[pcx.p].value as i64;
            advance(&pcx);
            if key == intern_c(c"framework", &pcx) || key == intern_c(c"lib", &pcx) {
                let framework = key == intern_c(c"framework", &pcx);
                pcx.link_pending.push(if framework { 'F' } else { 'l' } as i64);
                pcx.link_pending.push(value);
            } else if key == intern_c(c"name", &pcx) {
                name = value;
            } else if key == intern_c(c"kind", &pcx) {
                let kind = str_at(value);
                if kind == "framework" {
                    framework = true;
                } else if kind != "dylib" && kind != "static" {
                    error_at(pos, c"a link's kind is \"framework\", \"dylib\" or \"static\"", &pcx);
                }
            } else {
                name_error(pos, c"unknown key '", key,
                    c"' in #[link] (expected framework, lib, name or kind)", &pcx);
            }
            if !eat(Comma, &pcx) {
                break;
            }
        }
        expect(RParen, &pcx);
        expect(RBracket, &pcx);
        if name >= 0 {
            pcx.link_pending.push(if framework { 'F' } else { 'l' } as i64);
            pcx.link_pending.push(name);
        }
    }
    if !at(Extern, pcx) && !(at(Pub, pcx) && tok_kind(1, pcx) == Extern) {
        error_at(start,
            c"#[link] goes before an extern block: `#[link(lib = \"objc\")] extern \"C\" { ... }`", &pcx);
    }
}

// (0.25) The block of the `#[link]`s just read was read: its items are
// SCRATCH from `mark`. Each link is the program's when the program calls
// one of its functions or uses one of its statics (by their C symbols);
// a block of none links always.
pub fn link_block(mark: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var syms = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        for i in mark..pcx.scratch.count {
            let item = pcx.scratch.data[i];
            if pcx.nodes[item].kind == NodeKind::ExternFn
                || (pcx.nodes[item].kind == NodeKind::Static && pcx.nodes[item].y == 1) {
                let link = pcx.link_names.get(pcx.nodes[item].a + 1);
                syms.push(
                    sym_name(if link > 0 { link - 1 } else { pcx.nodes[item].a }, pcx) as i64);
            }
        }
        var k = 0;
        while k < pcx.link_pending.count {
            add_link_decl(pcx.link_pending.data[k] as u8, str_at(pcx.link_pending.data[k + 1]),
                &syms, &pcx);
            k += 2;
        }
        pcx.link_pending.count = 0;
    }
}

// After `extern "C"`: a block of C declarations, `extern "C" { fn f(...)
// -> T; static mut x: T; }`; a function with the C convention and an
// unmangled symbol, `extern "C" fn f(...) -> T { ... }`; or a static with
// a C symbol, `extern "C" static mut x: T = v;`. Items are pushed to the
// program's list. (0.2's single declarations, `extern fn f(...) -> T;`,
// were removed in 0.4.)
pub fn parse_extern(pcx: inout Ctx<Comp>) {
    unsafe {
        let start = cur_start(pcx);
        expect(Extern, &pcx);
        if !at(Str, pcx) {
            error_at(start, c_fn_outside_block(), &pcx);
        }
        let abi = pcx.toks[pcx.p].value as i64;
        if !(str_at(abi).len == 1 && str_at(abi).ptr[0] == 'C') {
            error_at(cur_start(pcx), c"unsupported ABI; only \"C\" is supported", &pcx);
        }
        advance(&pcx);
        if eat(LBrace, &pcx) {
            while !at(RBrace, pcx) && !at(Eof, pcx) {
                let link = parse_link_name(&pcx);
                let item = if at(Fn, pcx) {
                    parse_c_function(cur_start(pcx), true, &pcx)
                } else if at(Static, pcx) {
                    parse_c_static(cur_start(pcx), false, &pcx)
                } else {
                    syntax_error(c"expected 'fn', 'static' or '}' in an extern block", &pcx)
                };
                if pcx.nodes[item].kind == NodeKind::Static {
                    if has_effect_decls(pcx) {
                        error_at(pcx.nodes[item].start, c"effect declarations are for functions",
                            &pcx);
                    }
                    take_effect_decls(0, &pcx);
                } else {
                    take_effect_decls(item, &pcx);
                }
                if link >= 0 {
                    if pcx.nodes[item].kind != NodeKind::ExternFn
                        && !(pcx.nodes[item].kind == NodeKind::Static && pcx.nodes[item].y == 1) {
                        error_at(pcx.nodes[item].start,
                            c"#[link_name] is for the functions and statics of an extern block",
                            &pcx);
                    }
                    pcx.link_names.put(pcx.nodes[item].a + 1, link + 1);
                }
                list_push(item, &pcx);
            }
            expect(RBrace, &pcx);
            return;
        }
        if at(Static, pcx) {
            list_push(parse_c_static(start, true, &pcx), &pcx);
            return;
        }
        list_push(parse_c_function(start, false, &pcx), &pcx);
    }
}

fn c_fn_outside_block() -> *u8 {
    c"C functions are declared in an extern block: `extern \"C\" { fn f(...) -> T; }` (the 0.2 form `extern fn f(...) -> T;` was removed in 0.4)"
}

// `#[link_name = "symbol"]` before a declaration in an extern block: the
// C symbol it stands for, when that is not its name. -1: none. (0.16) Also
// effect declarations (`#[effects(io)]`, `#[pure]`, ...), left for
// take_effect_decls.
fn parse_link_name(pcx: inout Ctx<Comp>) -> i64 {
    var sym = -1;
    take_effect_decls(0, &pcx);
    while at(Hash, pcx) {
        advance(&pcx);
        expect(LBracket, &pcx);
        let pos = cur_start(pcx);
        let name = expect_ident(&pcx);
        if parse_effect_attribute(name, pos, &pcx) {
            expect(RBracket, &pcx);
            continue;
        }
        if name != intern_c(c"link_name", &pcx) {
            name_error(pos, c"unknown attribute '", name,
                c"' in an extern block (expected link_name, effects, pure, no_alloc, no_io or no_panic)", &pcx);
        }
        expect(Eq, &pcx);
        if !at(Str, pcx) {
            syntax_error(c"expected the symbol's name as a string", &pcx);
        }
        sym = intern(str_at(pcx.toks[pcx.p].value as i64), &pcx);
        advance(&pcx);
        expect(RBracket, &pcx);
    }
    sym
}

// `fn f(...) -> T;` (a C function, only in an extern block) or `fn
// f(...) -> T { ... }` (one with the C convention, defined here).
fn parse_c_function(start: i64, in_block: bool, pcx: inout Ctx<Comp>) -> i64 {
    if tok_kind(2, pcx) == LParen {
        // Look past the parameters for the body.
        let saved = pcx.p;
        advance(&pcx);
        advance(&pcx);
        var depth = 0;
        while !at(Eof, pcx) {
            if at(LParen, pcx) {
                depth += 1;
            } else if at(RParen, pcx) {
                depth -= 1;
                if depth == 0 {
                    break;
                }
            }
            advance(&pcx);
        }
        advance(&pcx);
        // (the result type is skipped, not parsed: parse_type splits a
        // `>>` in place, which the parse after the rewind would not see)
        if eat(Arrow, &pcx) {
            var nest = 0;
            while !at(Eof, pcx) && !(nest == 0 && (at(LBrace, pcx) || at(Semi, pcx))) {
                if at(LBracket, pcx) || at(LParen, pcx) {
                    nest += 1;
                } else if at(RBracket, pcx) || at(RParen, pcx) {
                    nest -= 1;
                }
                advance(&pcx);
            }
        }
        let has_body = at(LBrace, pcx);
        pcx.p = saved;
        if has_body {
            let f = parse_function(&pcx);
            no_param_defaults(f, c"an extern \"C\" function", &pcx);
            pcx.nodes[f].start = start;
            pcx.nodes[f].y = 1;
            return f;
        }
    }
    if !in_block {
        error_at(start, c_fn_outside_block(), &pcx);
    }
    expect(Fn, &pcx);
    let n = new_node(NodeKind::ExternFn, start, 0, &pcx);
    pcx.nodes[n].a = expect_binding_name(&pcx);
    expect(LParen, &pcx);
    pcx.nodes[n].d = parse_params(n, true, &pcx) as i64;
    no_param_defaults(n, c"an extern function", &pcx);
    expect(RParen, &pcx);
    pcx.nodes[n].b = parse_return_type(&pcx);
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// `static [mut] x: T;` (defined in C) or, when `defines`, also `static
// [mut] x: T = v;` (defined here, with a C symbol).
fn parse_c_static(start: i64, defines: bool, pcx: inout Ctx<Comp>) -> i64 {
    expect(Static, &pcx);
    let n = new_node(NodeKind::Static, start, 0, &pcx);
    pcx.nodes[n].d = crate::front::parser::eat_static_mut(n, &pcx) as i64;
    pcx.nodes[n].a = expect_binding_name(&pcx);
    expect(Colon, &pcx);
    pcx.nodes[n].b = parse_type(&pcx);
    pcx.nodes[n].y = 1;
    if defines && eat(Eq, &pcx) {
        pcx.nodes[n].c = parse_expr(&pcx);
        pcx.nodes[n].y = 2;
    }
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}
