// Parser: tokens to the AST. Items and statements by recursive descent,
// expressions by a Pratt parser with the binding powers of
// docs/grammar.md. After a syntax error the parser goes on at the next
// statement or item (see parse_program and parse_block).
//
// This file: the token cursor, syntax errors, the program's loop with
// its recovery, and fragments; the parts: items (and their attributes),
// foreign (`extern "C"`), types, stmts (blocks, statements, patterns)
// and exprs.

pub mod exprs;
mod stmts;
mod types;
mod foreign;
pub mod items;
// (0.18: requires/ensures, invariant, distinct, test attributes)
pub mod clauses;
// (0.27.0: the rust edition's lifetimes, receivers and raw pointers)
pub mod rust;

use crate::base::{IntVec, _setjmp, buf_bytes, get_src, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_help, err_str, err_sym, err_try, error_at, fail_name, recover_enter,
    recover_leave,
};
use crate::front::ast::{
    CONV_NEW, NodeKind, list_begin, list_end, list_push, new_node, reserve_nodes,
};
use crate::front::check::arch::{detect_macro_error, is_detect_macro};
use crate::front::conv::{rust_spelling, strict_at};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{
    Bang, CStr, Char, Const, Else, Enum, Eof, Float, Fn, Hash, Ident, Impl, Import, Int, LBrace,
    LBracket, LParen, Mod, Mut, Pub, RBrace, RBracket, RParen, Reserved, Semi, Static, Str, Struct,
    Trait, Type, Union, Unsafe, Use,
};
use crate::front::modules::file_of_pos;
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::items::parse_top_item;
use crate::front::parser::stmts::{is_item_start, parse_stmt};

fn tok_kind(offset: i64, pcx: &Ctx<Comp>) -> Tok {
    let i = pcx.p + offset;
    if i >= pcx.toks.len() as i64 { Eof } else { pcx.toks[i as usize].kind }
}

fn cur(pcx: &Ctx<Comp>) -> Tok {
    pcx.toks[pcx.p as usize].kind
}

fn at(kind: Tok, pcx: &Ctx<Comp>) -> bool {
    pcx.toks[pcx.p as usize].kind == kind
}

fn cur_start(pcx: &Ctx<Comp>) -> i64 {
    pcx.toks[pcx.p as usize].start
}

// The end of the previous token.
fn prev_end(pcx: &Ctx<Comp>) -> i64 {
    if pcx.p == 0 { 0 } else { pcx.toks[(pcx.p - 1) as usize].end }
}

fn advance(pcx: &mut Ctx<Comp>) {
    if pcx.toks[pcx.p as usize].kind != Eof {
        pcx.p += 1;
    }
}

fn eat(kind: Tok, pcx: &mut Ctx<Comp>) -> bool {
    if at(kind, pcx) {
        advance(pcx);
        return true;
    }
    false
}

// (0.20) After `static`: `mut` (0.19's spelling; conv.rust in 0.20's) or
// `var` (0.20's, conventions.md D14; CONV_NEW on static n): whether the
// static is mutable.
fn eat_static_mut(n: i64, pcx: &mut Ctx<Comp>) -> bool {
    let start = cur_start(pcx);
    if at(Mut, pcx) {
        if strict_at(start, pcx) {
            rust_spelling(pcx.toks[(pcx.p - 1) as usize].start, pcx.toks[pcx.p as usize].end,
                b"a mutable static is 'static var'", b"static var", pcx);
        }
        advance(pcx);
        return true;
    }
    if at(Tok::Var, pcx) {
        advance(pcx);
        pcx.nodes[n as usize].p |= CONV_NEW;
        return true;
    }
    false
}

fn err_token(i: i64, pcx: &Ctx<Comp>) {
    let kind = pcx.toks[i as usize].kind;
    if kind == Ident || kind == Reserved || kind.is_keyword() {
        err_sym(pcx.toks[i as usize].value as i64, pcx);
    } else if kind == Int || kind == Float || kind == Char {
        buf_bytes(pcx.err,
            &get_src()[pcx.toks[i as usize].start as usize..pcx.toks[i as usize].end as usize]);
    } else if kind == Str || kind == CStr {
        err_str(c"string literal", pcx);
    } else {
        err_str(kind.text(), pcx);
    }
}

// (0.16) A syntax error at a token of another file than the item's: the
// item's file ended inside a bracket, and the parser went on into the
// next file (std's text, another module's). Reported at that bracket, the
// last one the item leaves open in its file, instead of in the next file.
fn unclosed_bracket(pcx: &mut Ctx<Comp>) {
    if pcx.item_start < 0 || pcx.p <= pcx.item_start {
        return;
    }
    let f = file_of_pos(pcx.toks[pcx.item_start as usize].start, pcx);
    if file_of_pos(pcx.toks[pcx.p as usize].start, pcx) == f {
        return;
    }
    let end = pcx.files[f as usize].end;
    let mut k = pcx.p - 1;
    while k > pcx.item_start && pcx.toks[k as usize].start >= end {
        k -= 1;
    }
    let mut depth: i64 = 0;
    let mut open = pcx.item_start;
    while k >= pcx.item_start {
        let kind = pcx.toks[k as usize].kind;
        if kind == RBrace || kind == RParen || kind == RBracket {
            depth += 1;
        } else if kind == LBrace || kind == LParen || kind == LBracket {
            if depth == 0 {
                open = k;
                break;
            }
            depth -= 1;
        }
        k -= 1;
    }
    let kind = pcx.toks[open as usize].kind;
    let close = if kind == LParen { c")" } else if kind == LBracket { c"]" } else { c"}" };
    err_begin(pcx.toks[open as usize].start, pcx);
    err_str(c"unclosed '", pcx);
    err_str(kind.text(), pcx);
    err_str(c"': the file ends before its '", pcx);
    err_str(close, pcx);
    err_str(c"'", pcx);
    err_end(pcx);
}

fn syntax_error(message: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    unclosed_bracket(pcx);
    err_begin(cur_start(pcx), pcx);
    err_str(message, pcx);
    err_str(c", got '", pcx);
    err_token(pcx.p, pcx);
    err_str(c"'", pcx);
    err_end(pcx)
}

fn expect(kind: Tok, pcx: &mut Ctx<Comp>) {
    if !at(kind, pcx) {
        unclosed_bracket(pcx);
        err_begin(cur_start(pcx), pcx);
        err_str(c"expected '", pcx);
        err_str(kind.text(), pcx);
        err_str(c"', got '", pcx);
        err_token(pcx.p, pcx);
        err_str(c"'", pcx);
        if kind == Tok::FatArrow && at(Tok::LBrace, pcx) {
            // (0.17) an arm's block without its arrow, or a guard's
            err_help(c"a match arm is `PATTERN => VALUE,` (a guard: `PATTERN if COND => VALUE,`); a block is the value: `PATTERN => { ... }`", pcx);
            err_try(c"=> {", pcx);
        }
        err_end(pcx);
    }
    advance(pcx);
}

fn reserved_error(pcx: &mut Ctx<Comp>) -> ! {
    err_begin(cur_start(pcx), pcx);
    err_str(c"'", pcx);
    err_token(pcx.p, pcx);
    if at(Reserved, pcx) {
        err_str(c"' is a reserved keyword (reserved for future use)", pcx);
    } else {
        err_str(c"' is reserved for future use", pcx);
    }
    err_end(pcx)
}

// (0.21) `var`, `inout` or `sink` where a name goes: keywords (D27), no
// longer identifiers as in 0.20.
fn convention_word_error(pcx: &mut Ctx<Comp>) -> ! {
    err_begin(cur_start(pcx), pcx);
    err_str(c"'", pcx);
    err_token(pcx.p, pcx);
    err_str(
        c"' is a keyword (`var x = ..`, `x: inout T`, `x: sink T`): a name cannot be spelled so",
        pcx);
    err_help(c"rename it (`var_`, `sink_`, ...); volec 0.20, which reads it as a name, renames it with every use: volec refactor rename FILE:LINE:COL NEW", pcx);
    err_end(pcx)
}

fn expect_ident(pcx: &mut Ctx<Comp>) -> i64 {
    if at(Reserved, pcx) {
        reserved_error(pcx);
    }
    if at(Tok::Var, pcx) || at(Tok::Inout, pcx) || at(Tok::Sink, pcx) {
        convention_word_error(pcx);
    }
    if !at(Ident, pcx) {
        syntax_error(c"expected identifier", pcx);
    }
    let sym = pcx.toks[pcx.p as usize].value as i64;
    advance(pcx);
    sym
}

// ---- Rust habits the parser sees (0.14) ----

// Whether the tokens at the cursor are a Rust macro call: `name!(`,
// `name![`, `name!{`.
pub fn at_macro_call(pcx: &Ctx<Comp>) -> bool {
    if !at(Ident, pcx) || pcx.toks[(pcx.p + 1) as usize].kind != Bang {
        return false;
    }
    let next = pcx.toks[(pcx.p + 2) as usize].kind;
    next == LParen || next == LBracket || next == LBrace
}

// The error for a macro call: vole has none; the help names what
// replaces the common ones.
pub fn macro_error(pcx: &mut Ctx<Comp>) -> ! {
    let name = pcx.toks[pcx.p as usize].value as i64;
    if is_detect_macro(name, pcx) {
        // (0.19: `is_x86_feature_detected!("avx2")`)
        detect_macro_error(pcx.p, pcx);
    }
    err_begin(cur_start(pcx), pcx);
    err_str(c"'", pcx);
    err_sym(name, pcx);
    err_str(c"!' is a macro call: vole has no macros", pcx);
    let text = sym_text(name, pcx);
    if text == b"println" || text == b"print" || text == b"eprintln" || text == b"eprint"
        || text == b"format" || text == b"write" || text == b"writeln" {
        // (0.15: f-strings; 0.26.2: a format literal)
        if !macro_fstring_help(text, pcx) {
            err_help(c"the call without its `!` takes a format string: `println(\"x = {x}, v = {:?}\", v)`, `format_in(\"..\", args, gpa)`, in a Display impl `f.write(\"..\", args)`", pcx);
        }
    } else if text == b"vec" {
        err_help(
            c"an array `[1, 2, 3]`, or `var v: Vec<i64> = Vec::new_in(gpa); v.push(1);`", pcx);
    }
    else if text == b"assert" || text == b"assert_eq" || text == b"assert_ne"
        || text == b"debug_assert" || text == b"panic" || text == b"unreachable" || text == b"todo"
        || text == b"unimplemented" {
        // (0.17: the prelude's panic and unreachable)
        if text == b"panic" || text == b"todo" || text == b"unimplemented" {
            err_help(
                c"call the prelude's `panic(\"message\")`: it prints the message and exits with 101", pcx);
        } else if text == b"unreachable" {
            err_help(
                c"call the prelude's `unreachable()` (or `panic(\"message\")`): it exits with 101", pcx);
        } else {
            err_help(c"`if !(a == b) { panic(\"message\"); }`: the prelude's panic prints the message and exits with 101", pcx);
        }
    } else {
        err_help(c"call a function instead", pcx);
    }
    err_end(pcx)
}

// (0.15; 0.26.2: a format literal) The help of a print or format macro at
// P: the call without its `!`, which takes the same format string and
// arguments (`println!("{} {x:?}", a)`: write `println("{} {x:?}", a)`;
// `format!` is `format_in(.., gpa)`, `write!(f, ..)` `f.write(..)`); false,
// writing nothing, when its arguments are not a string literal then
// expressions.
fn macro_fstring_help(text: &[u8], pcx: &Ctx<Comp>) -> bool {
    let writes = text == b"write" || text == b"writeln";
    let mut i = pcx.p + 2;
    if i >= pcx.toks.len() as i64 || pcx.toks[(pcx.p + 1) as usize].kind != Bang
        || pcx.toks[i as usize].kind != LParen {
        return false;
    }
    i += 1;
    // (write!'s formatter: its first argument)
    let receiver = i;
    if writes {
        while i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Tok::Comma
            && pcx.toks[i as usize].kind != RParen {
            i += 1;
        }
        if i >= pcx.toks.len() as i64 || pcx.toks[i as usize].kind != Tok::Comma {
            return false;
        }
        i += 1;
    }
    if i >= pcx.toks.len() as i64 || pcx.toks[i as usize].kind != Str {
        return false;
    }
    let literal = i;
    let lit = &get_src()[
        pcx.toks[literal as usize].start as usize..pcx.toks[literal as usize].end as usize];
    if lit.len() < 2 || lit[0] != b'"' {
        return false;
    }
    // The call's closing parenthesis.
    let mut depth: i64 = 0;
    while i < pcx.toks.len() as i64 && pcx.toks[i as usize].kind != Eof {
        let k = pcx.toks[i as usize].kind;
        if k == LParen || k == LBracket || k == LBrace {
            depth += 1;
        } else if k == RParen || k == RBracket || k == RBrace {
            if depth == 0 {
                break;
            }
            depth -= 1;
        }
        i += 1;
    }
    if i >= pcx.toks.len() as i64 || pcx.toks[i as usize].kind != RParen {
        return false;
    }
    err_help(c"write `", pcx);
    if writes {
        buf_bytes(pcx.err_help,
            &get_src()[
                pcx.toks[receiver as usize].start as usize..pcx.toks[receiver as usize].end as usize]);
        err_help(c".write(", pcx);
    } else if text == b"format" {
        err_help(c"format_in(", pcx);
    } else {
        buf_bytes(pcx.err_help, text);
        err_help(c"(", pcx);
    }
    // The literal as written but for Rust's `{:#?}`, Debug over several
    // lines (not in this release: `{:?}`), and writeln!'s newline.
    let mut k: i64 = 0;
    while k < lit.len() as i64 {
        if k + 3 < lit.len() as i64 && lit[k as usize] == b':' && lit[(k + 1) as usize] == b'#'
            && lit[(k + 2) as usize] == b'?'
            && lit[(k + 3) as usize] == b'}' {
            err_help(c":?}", pcx);
            k += 4;
            continue;
        }
        if k == lit.len() as i64 - 1 && text == b"writeln" {
            err_help(c"\\n", pcx);
        }
        buf_bytes(pcx.err_help, &lit[k as usize..(k + 1) as usize]);
        k += 1;
    }
    // The arguments as written.
    buf_bytes(pcx.err_help,
        &get_src()[pcx.toks[literal as usize].end as usize..pcx.toks[i as usize].start as usize]);
    if text == b"format" {
        err_help(c", gpa", pcx);
    }
    err_help(c")`", pcx);
    if text == b"format" {
        err_help(c" (a std::Buf: `.as_slice()` views it, `.free()` frees it)", pcx);
    }
    true
}

// A name being declared: an identifier other than `_`.
fn expect_binding_name(pcx: &mut Ctx<Comp>) -> i64 {
    if at(Ident, pcx) && pcx.toks[pcx.p as usize].value as i64 == pcx.underscore {
        error_at(cur_start(pcx), c"'_' cannot be used as a name here", pcx);
    }
    expect_ident(pcx)
}

fn with_no_struct(value: bool, pcx: &mut Ctx<Comp>) -> bool {
    let saved = pcx.no_struct;
    pcx.no_struct = value;
    saved
}

// ---- The program, and going on after errors ----

pub fn parse_program(pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        pcx.underscore = intern_c(c"_", pcx);
        pcx.builtin_traits.count = 0;
        pcx.inherent_consts.count = 0;
        // (0.20) the spelling the files are read in (front/conv)
        crate::front::conv::conv_setup(pcx);
        reserve_nodes(pcx.toks.len() as i64 + pcx.toks.len() as i64 / 4, pcx);
        let program = new_node(NodeKind::None, 0, 0, pcx);
        let mark = list_begin(pcx);
        while !at(Eof, pcx) {
            // A recovery point (see err_end): after an error, the parser goes
            // on at the next item.
            let depth = pcx.recover_depth;
            let items = pcx.scratch.count;
            let start = pcx.p;
            pcx.item_start = pcx.p;
            pcx.body_failed = false;
            if _setjmp(recover_enter(pcx)) == 0 {
                parse_top_item(pcx);
                if pcx.body_failed {
                    // A syntax error in a block outside a function's body (a
                    // constant's initializer...): the item is left out.
                    for i in items..pcx.scratch.count {
                        let kind = pcx.nodes[(*pcx.scratch.data.add(i as usize)) as usize].kind;
                        if kind != NodeKind::Impl && kind != NodeKind::Use {
                            fail_name(pcx.nodes[(*pcx.scratch.data.add(i as usize)) as usize].a,
                                pcx);
                        }
                    }
                    pcx.scratch.count = items;
                }
            } else {
                pcx.scratch.count = items;
                pcx.no_struct = false;
                crate::front::parser::items::params::reset_item_state(pcx);
                skip_to_item(start, pcx);
                fail_names(start, pcx.p, pcx);
            }
            recover_leave(depth, pcx);
        }
        list_end(program, mark, pcx);
        pcx.item_start = -1;
        program
    }
}

// After an error in the item starting at token `start`: on to the next
// token after it that starts an item at the beginning of a line.
fn skip_to_item(start: i64, pcx: &mut Ctx<Comp>) {
    pcx.p = start + 1;
    while !at(Eof, pcx) {
        let pos = pcx.toks[pcx.p as usize].start;
        let line_start = pos == 0 || get_src()[(pos - 1) as usize] == b'\n';
        if line_start && (is_item_start(cur(pcx)) || at(Pub, pcx) || at(Use, pcx) || at(Mod, pcx)
            || at(Import, pcx) || at(Hash, pcx) || at(Impl, pcx) || at(Unsafe, pcx)
            || at(Trait, pcx)) {
            return;
        }
        advance(pcx);
    }
}

// The names the items in tokens start..end (skipped after an error)
// declare, and those a `use` among them imports, are failed names: the
// errors saying they are unknown are not reported (see err_failed_name).
fn fail_names(start: i64, end: i64, pcx: &mut Ctx<Comp>) {
    let mut in_use = false;
    for i in start..end {
        let kind = pcx.toks[i as usize].kind;
        if kind == Use || kind == Import {
            in_use = true;
        } else if kind == Semi {
            in_use = false;
        }
        if i + 1 < end && pcx.toks[(i + 1) as usize].kind == Ident
            && (in_use || kind == Fn || kind == Struct
                || kind == Union || kind == Enum || kind == Const || kind == Static || kind == Type
                || kind == Trait || kind == Mod) {
            fail_name(pcx.toks[(i + 1) as usize].value as i64, pcx);
        }
    }
}

// After an error in the statement starting at token `start`: past its `;`,
// or up to the `}` closing its block.
fn skip_statement(start: i64, pcx: &mut Ctx<Comp>) {
    pcx.p = start;
    // The brackets open in the statement (a `}` also closes the `(` and
    // `[` left open inside its `{`).
    let mut open = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    // (0.28.0: not past the end of the statement's file, gap 105)
    let file_end = if start < pcx.toks.len() as i64 {
        pcx.files[file_of_pos(pcx.toks[start as usize].start, pcx) as usize].end
    } else {
        0
    };
    while !at(Eof, pcx) && pcx.toks[pcx.p as usize].start < file_end {
        let kind = cur(pcx);
        if kind == LBrace || kind == LParen || kind == LBracket {
            open.push(kind as i64);
        } else if kind == RBrace || kind == RParen || kind == RBracket {
            if kind == RBrace {
                while unsafe {
                    open.count > 0 && (*open.data.add((open.count - 1) as usize)) != LBrace as i64
                } {
                    open.count -= 1;
                }
            }
            if open.count == 0 {
                if kind == RBrace {
                    return;
                }
                // (a stray `)` or `]` is part of the statement that failed)
                advance(pcx);
                continue;
            }
            open.count -= 1;
            let depth = open.count;
            if depth == 0 && kind == RBrace && pcx.p > start {
                // A statement ending with a block (`if`, `while`, ...),
                // unless an `else` follows.
                advance(pcx);
                if !at(Else, pcx) {
                    return;
                }
                continue;
            }
        } else if kind == Semi && open.count == 0 {
            advance(pcx);
            return;
        }
        advance(pcx);
    }
}

// ---- Fragments ----

// The expression (`stmts`: the statements, in a Block) of the tokens
// from `first` to the next Eof (0.11: the patterns of `volec
// rewrite`, parsed after the program).
pub fn parse_fragment(first: i64, stmts: bool, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.p = first;
    pcx.no_struct = false;
    if !stmts {
        let n = parse_expr(pcx);
        if !at(Eof, pcx) {
            syntax_error(c"expected the end of the expression", pcx);
        }
        return n;
    }
    let block = new_node(NodeKind::Block, cur_start(pcx), 0, pcx);
    let mark = list_begin(pcx);
    while !at(Eof, pcx) {
        if eat(Semi, pcx) {
            continue;
        }
        list_push(parse_stmt(pcx), pcx);
    }
    list_end(block, mark, pcx);
    pcx.nodes[block as usize].end = prev_end(pcx);
    block
}

// The items of the tokens from `first` to the next Eof, pushed to SCRATCH
// as parse_program pushes them (0.15: the impls `#[derive]` makes, parsed
// while checking; front/derive.vl).
pub fn parse_items_fragment(first: i64, pcx: &mut Ctx<Comp>) {
    pcx.p = first;
    pcx.no_struct = false;
    while !at(Eof, pcx) {
        parse_top_item(pcx);
    }
}
