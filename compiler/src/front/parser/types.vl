// Types: names with type arguments, pointers, slices, arrays, tuples and
// function types; and the type arguments after a name (`Vec<T>`,
// `f::<T>`), splitting the `>` off `>>`.

use crate::base::{SRC, buf_bytes, buf_new, buf_slice, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_at;
use crate::front::ast::{
    CONV_NEW, CONV_SINK, EFFECTS_BOUND, NODE_REF, NODE_REF_MUT, NodeKind, list_begin, list_end,
    list_push, new_node,
};
use crate::front::conv::{conv_error, rust_spelling, strict_at};
use crate::front::lexer::{Tok, str_at};
use crate::front::lexer::Tok::{
    Amp, AmpAmp, Arrow, Bang, ColonColon, Comma, Ellipsis, Eof, Eq, Extern, Fn, Gt, GtEq, Ident,
    LBracket, LParen, Let, Lt, Mut, RBracket, RParen, Reserved, Semi, Shr, ShrEq, Star, Str, Unsafe,
};
use crate::front::parser::{
    advance, at, cur, cur_start, eat, expect, expect_ident, prev_end, reserved_error, syntax_error,
    tok_kind, with_no_struct,
};
use crate::front::parser::exprs::parse_expr;

// `<A, B>` type arguments (after a type's name, or `::` in an
// expression); the `>` of `>>` (and of `>=`, `>>=`) is split off.
pub fn parse_type_args(pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Generics, cur_start(pcx), 0, &pcx);
    expect(Lt, &pcx);
    let mark = list_begin(pcx);
    while !at_gt(pcx) && !at(Eof, pcx) {
        list_push(parse_type(&pcx), &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    if pcx.nodes[n].count == 0 {
        error_at(pcx.nodes[n].start, c"expected a type argument", &pcx);
    }
    expect_gt(&pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn at_gt(pcx: Ctx<Comp>) -> bool {
    at(Gt, pcx) || at(Shr, pcx) || at(GtEq, pcx) || at(ShrEq, pcx)
}

fn expect_gt(pcx: inout Ctx<Comp>) {
    let kind = cur(pcx);
    if kind == Shr || kind == GtEq || kind == ShrEq {
        // Keep the rest of the token: `>`, `=` or `>=`.
        pcx.toks[pcx.p].kind = if kind == Shr { Gt } else if kind == GtEq { Eq } else { GtEq };
        pcx.toks[pcx.p].start += 1;
        return;
    }
    expect(Gt, &pcx);
}

// Whether `name` is a primitive type's name: an integer's, a float's,
// bool.
fn is_primitive_name(name: i64) -> bool {
    is_int_type_name(name) || name == intern_c(c"f64") || name == intern_c(c"f32")
        || name == intern_c(c"bool")
}

// Whether `name` is an integer type's name (for #[repr(u8)] and so on).
pub fn is_int_type_name(name: i64) -> bool {
    let names: [*u8; 8] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64"];
    for i in 0..8 {
        if name == intern_c(names[i]) {
            return true;
        }
    }
    false
}

// ---- Types ----

// A type's name, `T` or `a::b::T` (0.5: a type in a module; the segments
// before the name are the TyName's list; 0.14: also a projection, `I::Item`).
pub fn parse_type_name(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::TyName, start, 0, &pcx);
    pcx.nodes[n].a = expect_ident(&pcx);
    if at(ColonColon, pcx) {
        let mark = list_begin(pcx);
        while eat(ColonColon, &pcx) {
            let seg = new_node(NodeKind::Ident, pcx.nodes[n].start, prev_end(pcx), &pcx);
            pcx.nodes[seg].a = pcx.nodes[n].a;
            list_push(seg, &pcx);
            pcx.nodes[n].a = expect_ident(&pcx);
        }
        list_end(n, mark, &pcx);
    }
    n
}

// A bound of a type parameter (0.9; 0.14: the built-in `Fn(A) -> R` and
// `FnMut(A) -> R`, a TyFn with d = 2 or 3, and a trait's associated-type
// constraints, `Iterator<Item = T>`: AssocType nodes in the holder `h`).
pub fn parse_bound(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let start = cur_start(pcx);
        if !at(Ident, pcx) {
            return parse_type(&pcx);
        }
        // (0.16: `effects(panic)`, an upper bound of the effects of a
        // closure or fn bound to the parameter)
        if tok_kind(1, pcx) == LParen && pcx.toks[pcx.p].value as i64 == intern_c(c"effects") {
            advance(&pcx);
            let n = new_node(NodeKind::EffectSet, start, 0, &pcx);
            pcx.nodes[n].c = EFFECTS_BOUND;
            pcx.effect_bounds.push(n);
            parse_effect_list(n, &pcx);
            return n;
        }
        if tok_kind(1, pcx) == LParen {
            let name = pcx.toks[pcx.p].value as i64;
            let d = if name == intern_c(c"Fn") { 2 }
                else if name == intern_c(c"FnMut") { 3 }
                else { 0 };
            if d != 0 {
                advance(&pcx);
                let n = parse_fn_type_rest(start, &pcx);
                pcx.nodes[n].d = d;
                return n;
            }
        }
        let n = parse_type_name(start, &pcx);
        if at(Lt, pcx) {
            // Type arguments (0.15: `From<U>`) and constraints, `Name = T`
            let lt = cur_start(pcx);
            advance(&pcx);
            let mark = list_begin(pcx);
            while !at_gt(pcx) && !at(Eof, pcx) {
                if at(Ident, pcx) && tok_kind(1, pcx) == Eq {
                    let c = new_node(NodeKind::AssocType, cur_start(pcx), 0, &pcx);
                    pcx.nodes[c].a = expect_ident(&pcx);
                    expect(Eq, &pcx);
                    pcx.nodes[c].b = parse_type(&pcx);
                    pcx.nodes[c].end = prev_end(pcx);
                    list_push(c, &pcx);
                } else {
                    list_push(parse_type(&pcx), &pcx);
                }
                if !eat(Comma, &pcx) {
                    break;
                }
            }
            expect_gt(&pcx);
            let end = pcx.scratch.count;
            if end == mark {
                error_at(lt, c"expected a type argument", &pcx);
            }
            // (the constraints to the holder h, the types to g)
            for pass in 0..2 {
                for i in mark..end {
                    if (pcx.nodes[pcx.scratch.data[i]].kind == NodeKind::AssocType) == (pass == 0) {
                        list_push(pcx.scratch.data[i], &pcx);
                    }
                }
                if pcx.scratch.count > end {
                    let holder = new_node(NodeKind::Generics, lt, prev_end(pcx), &pcx);
                    list_end(holder, end, &pcx);
                    if pass == 0 {
                        pcx.nodes[n].h = holder;
                    } else {
                        pcx.nodes[n].g = holder;
                    }
                }
            }
            pcx.scratch.count = mark;
        }
        pcx.nodes[n].end = prev_end(pcx);
        n
    }
}

// `(alloc(Gpa, extern), io, ...)` after `effects` (0.16), in an attribute
// or a bound: the EffectItem nodes, the list of EffectSet n. The names are
// any identifiers (and `unsafe`); front/effects checks them.
pub fn parse_effect_list(n: i64, pcx: inout Ctx<Comp>) {
    expect(LParen, &pcx);
    let mark = list_begin(pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        let item = new_node(NodeKind::EffectItem, cur_start(pcx), 0, &pcx);
        if eat(Unsafe, &pcx) {
            pcx.nodes[item].a = intern_c(c"unsafe");
        } else {
            pcx.nodes[item].a = expect_ident(&pcx);
        }
        if eat(LParen, &pcx) {
            let imark = list_begin(pcx);
            while !at(RParen, pcx) && !at(Eof, pcx) {
                if eat(Extern, &pcx) {
                    pcx.nodes[item].b = 1;
                } else {
                    list_push(parse_type(&pcx), &pcx);
                }
                if !eat(Comma, &pcx) {
                    break;
                }
            }
            list_end(item, imark, &pcx);
            expect(RParen, &pcx);
        }
        pcx.nodes[item].end = prev_end(pcx);
        list_push(item, &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    expect(RParen, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
}

pub fn parse_type(pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let start = cur_start(pcx);
        let kind = cur(pcx);
        // (0.20) accesses `let T`, `inout T` (conventions.md §6); `sink T`
        // outside a parameter
        if kind == Let || kind == Tok::Inout {
            return parse_access_type(start, kind != Let, &pcx);
        }
        if kind == Tok::Sink {
            advance(&pcx);
            let inner = parse_type(&pcx);
            conv_error(c"conv.sink_type", start, pcx.nodes[inner].start,
                "'sink' is a parameter's convention: a field or a result of type T owns its value already",
                "", "", &pcx);
            return inner;
        }
        if kind == Ident {
            let n = parse_type_name(start, &pcx);
            // (a primitive type takes no type arguments: `x as i64 < n`
            // compares, 0.11)
            if at(Lt, pcx) && !(pcx.nodes[n].list == 0 && is_primitive_name(pcx.nodes[n].a)) {
                pcx.nodes[n].g = parse_type_args(&pcx);
            }
            pcx.nodes[n].end = prev_end(pcx);
            return n;
        }
        if kind == Star {
            advance(&pcx);
            let n = new_node(NodeKind::TyPtr, start, 0, &pcx);
            pcx.nodes[n].a = parse_type(&pcx);
            pcx.nodes[n].end = prev_end(pcx);
            return n;
        }
        if kind == Tok::Impl {
            // (0.26.2) `x: impl Display`
            return crate::front::parser::items::params::parse_impl_type(start, &pcx);
        }
        if kind == Bang {
            advance(&pcx);
            return new_node(NodeKind::TyNever, start, prev_end(pcx), &pcx);
        }
        if kind == LParen {
            return parse_paren_type(start, &pcx);
        }
        if kind == LBracket {
            return parse_array_type(start, &pcx);
        }
        if kind == Fn {
            return parse_fn_type(start, &pcx);
        }
        if kind == Extern {
            advance(&pcx);
            if at(Str, pcx) {
                let abi = pcx.toks[pcx.p].value as i64;
                if !(str_at(abi).len == 1 && str_at(abi).ptr[0] == 'C') {
                    error_at(cur_start(pcx), c"unsupported ABI; only \"C\" is supported", &pcx);
                }
                advance(&pcx);
            }
            let n = parse_fn_type(start, &pcx);
            pcx.nodes[n].d = 1;
            return n;
        }
        if kind == Reserved {
            reserved_error(&pcx);
        }
        if kind == Amp {
            // (0.17) References: `&T`, `&mut T`; `&[T]` is `[T]`, `&mut [T]`
            // the exclusive slice (docs/design/value-semantics.md §2.3).
            // (0.20) `&str` is `str`, std's view of UTF-8 text, as `&[T]` is `[T]`.
            advance(&pcx);
            let mutable = eat(Mut, &pcx);
            let inner = parse_type(&pcx);
            if pcx.nodes[inner].kind == NodeKind::TyName && pcx.nodes[inner].list == 0
                && pcx.nodes[inner].g == 0
                && sym_text(pcx.nodes[inner].a) == "str" {
                pcx.nodes[inner].start = start;
                return inner;
            }
            if pcx.nodes[inner].kind == NodeKind::TySlice {
                if mutable {
                    pcx.nodes[inner].p |= NODE_REF_MUT;
                }
                if strict_at(start, &pcx) {
                    rust_reference_type(start, inner, mutable, &pcx);
                    // (0.25: read as the spelling the error gives, so that
                    // nothing else is reported about it)
                    pcx.nodes[inner].p |= CONV_NEW;
                }
                pcx.nodes[inner].start = start;
                return inner;
            }
            if strict_at(start, &pcx) && pcx.param_type && !mutable {
                // (0.25: a parameter's `&T` is `T`, let)
                rust_reference_type(start, inner, mutable, &pcx);
                return inner;
            }
            let n = new_node(NodeKind::TyPtr, start, prev_end(pcx), &pcx);
            pcx.nodes[n].a = inner;
            pcx.nodes[n].p |= if mutable { NODE_REF | NODE_REF_MUT } else { NODE_REF };
            if strict_at(start, &pcx) {
                rust_reference_type(start, inner, mutable, &pcx);
                pcx.nodes[n].p |= CONV_NEW;
            }
            return n;
        }
        if kind == AmpAmp {
            // `&&T` is `& &T`.
            advance(&pcx);
            let inner = new_node(NodeKind::TyPtr, start + 1, 0, &pcx);
            pcx.nodes[inner].p |= NODE_REF;
            pcx.nodes[inner].a = parse_type(&pcx);
            pcx.nodes[inner].end = prev_end(pcx);
            let n = new_node(NodeKind::TyPtr, start, prev_end(pcx), &pcx);
            pcx.nodes[n].a = inner;
            pcx.nodes[n].p |= NODE_REF;
            if strict_at(start, &pcx) {
                // (0.20: an access to an access is the access)
                rust_reference_type(start, pcx.nodes[inner].a, false, &pcx);
            }
            return n;
        }
        syntax_error(c"expected type", &pcx)
    }
}

// (0.20) `let T` (shared) or `inout T` (exclusive), at `let` / `exclusive`: an
// access, the reference `&T` / `&mut T` flagged CONV_NEW (`inout [T]`: the
// exclusive slice; `let [T]` is `[T]`).
fn parse_access_type(start: i64, exclusive: bool, pcx: inout Ctx<Comp>) -> i64 {
    advance(&pcx);
    let inner = parse_type(&pcx);
    if pcx.nodes[inner].kind == NodeKind::TySlice {
        if exclusive {
            pcx.nodes[inner].p |= NODE_REF_MUT;
        }
        pcx.nodes[inner].p |= CONV_NEW;
        pcx.nodes[inner].start = start;
        return inner;
    }
    let n = new_node(NodeKind::TyPtr, start, prev_end(pcx), &pcx);
    pcx.nodes[n].a = inner;
    pcx.nodes[n].p |= CONV_NEW | if exclusive { NODE_REF | NODE_REF_MUT } else { NODE_REF };
    n
}

// (0.20) conv.rust for Rust's `&T` / `&mut T` at start (inner: T's node):
// in a parameter `T` (let, the default) / `inout T`, elsewhere `let T` /
// `inout T`; `&[T]` is `[T]`, `&mut [T]` `inout [T]`.
fn rust_reference_type(start: i64, inner: i64, mutable: bool, pcx: inout Ctx<Comp>) {
    let text = SRC[pcx.nodes[inner].start..pcx.nodes[inner].end];
    let slice = pcx.nodes[inner].kind == NodeKind::TySlice;
    let new = buf_new();
    if mutable {
        buf_bytes(new, "inout ");
    } else if !pcx.param_type && !slice {
        buf_bytes(new, "let ");
    }
    buf_bytes(new, text);
    let what = if mutable {
        "an exclusive access is 'inout T' (a parameter 'x: inout T', called with '&x')"
    } else if slice {
        "a slice is a read-only view already: '[T]'"
    } else if pcx.param_type {
        "a parameter is read-only by default (let): 'x: T', called with 'x'"
    } else {
        "a shared access is 'let T'"
    };
    rust_spelling(start, pcx.nodes[inner].end, what, buf_slice(new), &pcx);
}

fn parse_paren_type(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    expect(LParen, &pcx);
    if eat(RParen, &pcx) {
        return new_node(NodeKind::TyUnit, start, prev_end(pcx), &pcx);
    }
    let first = parse_type(&pcx);
    if !eat(Comma, &pcx) {
        expect(RParen, &pcx);
        return first;
    }
    let n = new_node(NodeKind::TyTuple, start, 0, &pcx);
    let mark = list_begin(pcx);
    list_push(first, &pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        list_push(parse_type(&pcx), &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    expect(RParen, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn parse_array_type(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    expect(LBracket, &pcx);
    let n = new_node(NodeKind::TyArray, start, 0, &pcx);
    pcx.nodes[n].a = parse_type(&pcx);
    if eat(RBracket, &pcx) {
        pcx.nodes[n].kind = NodeKind::TySlice;
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    expect(Semi, &pcx);
    let saved = with_no_struct(false, &pcx);
    pcx.nodes[n].b = parse_expr(&pcx);
    pcx.no_struct = saved;
    expect(RBracket, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn parse_fn_type(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    expect(Fn, &pcx);
    parse_fn_type_rest(start, &pcx)
}

// `(A, B) -> R` after `fn` (or a bound's `Fn`, 0.14).
fn parse_fn_type_rest(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    expect(LParen, &pcx);
    let n = new_node(NodeKind::TyFn, start, 0, &pcx);
    let mark = list_begin(pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        if at(Ellipsis, pcx) {
            error_at(cur_start(pcx),
                c"function pointer types cannot be variadic; call variadic functions directly",
                &pcx);
        }
        // (0.20) `fn(sink T)`: a by-value parameter (its convention is
        // not a type: the function type is `fn(T)` until T1)
        let by_value = at(Tok::Sink, pcx);
        if by_value {
            advance(&pcx);
        }
        let t = parse_type(&pcx);
        if by_value {
            // (0.22: the convention, on the type's node: conv::fn_type_param)
            pcx.nodes[t].p |= CONV_SINK;
        }
        list_push(t, &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    expect(RParen, &pcx);
    if eat(Arrow, &pcx) {
        pcx.nodes[n].a = parse_type(&pcx);
    } else {
        pcx.nodes[n].a = new_node(NodeKind::TyUnit, prev_end(pcx), prev_end(pcx), &pcx);
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}
