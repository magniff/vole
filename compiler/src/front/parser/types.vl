// Types: names with type arguments, pointers, slices, arrays, tuples and
// function types; and the type arguments after a name (`Vec<T>`,
// `f::<T>`), splitting the `>` off `>>`.

use crate::base::{get_src, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_at;
use crate::front::ast::{
    CONV_NEW, EFFECTS_BOUND, NODE_REF, NODE_REF_MUT, NodeKind, list_begin, list_end, list_push,
    new_node,
};
use crate::front::lexer::{Tok, str_at};
use crate::front::lexer::Tok::{
    Amp, AmpAmp, Arrow, Bang, ColonColon, Comma, Ellipsis, Eof, Eq, Extern, Fn, Gt, GtEq, Ident,
    LBracket, LParen, Let, Lt, Mut, RBracket, RParen, Reserved, Semi, Shr, ShrEq, Star, Str, Unsafe,
};
use crate::front::parser::{
    advance, at, cur, cur_start, eat, expect, expect_ident, prev_end, reserved_error, syntax_error,
    tok_kind, with_no_struct,
};
use crate::front::parser::exprs::parse_expr;

// `<A, B>` type arguments (after a type's name, or `::` in an
// expression); the `>` of `>>` (and of `>=`, `>>=`) is split off.
pub fn parse_type_args(pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Generics, cur_start(pcx), 0, pcx);
    if !crate::front::parser::rust::split_shl(pcx) {
        expect(Lt, pcx);
    }
    let mark = list_begin(pcx);
    let lifetimes = crate::front::parser::rust::lifetimes_begin(pcx);
    while !at_gt(pcx) && !at(Eof, pcx) {
        // (0.27.0: `S<'a, T>`, the rust edition's lifetimes, kept apart)
        if !crate::front::parser::rust::take_lifetime(false, pcx) {
            list_push(parse_type(pcx), pcx);
        }
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    let only_lifetimes = pcx.nodes[n as usize].count == 0
        && pcx.lt_scratch.len() as i64 > lifetimes;
    crate::front::parser::rust::lifetimes_end(lifetimes, pcx);
    if pcx.nodes[n as usize].count == 0 && !only_lifetimes {
        error_at(pcx.nodes[n as usize].start, c"expected a type argument", pcx);
    }
    expect_gt(pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    if only_lifetimes { 0 } else { n }
}

fn at_gt(pcx: &Ctx<Comp>) -> bool {
    at(Gt, pcx) || at(Shr, pcx) || at(GtEq, pcx) || at(ShrEq, pcx)
}

pub fn expect_gt(pcx: &mut Ctx<Comp>) {
    let kind = cur(pcx);
    if kind == Shr || kind == GtEq || kind == ShrEq {
        // Keep the rest of the token: `>`, `=` or `>=`.
        { let at_ix = pcx.p as usize;
            pcx.toks[at_ix].kind = if kind == Shr { Gt } else if kind == GtEq { Eq }
                else { GtEq } };
        { let at_ix = pcx.p as usize; pcx.toks[at_ix].start += 1 };
        return;
    }
    expect(Gt, pcx);
}

// Whether `name` is a primitive type's name: an integer's, a float's,
// bool.
fn is_primitive_name(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    is_int_type_name(name, pcx) || name == intern_c(c"f64", pcx) || name == intern_c(c"f32", pcx)
        || name == intern_c(c"bool", pcx)
}

// Whether `name` is an integer type's name (for #[repr(u8)] and so on).
pub fn is_int_type_name(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    let names: [*mut u8; 8] = [c"i8", c"i16", c"i32", c"i64", c"u8", c"u16", c"u32", c"u64"];
    for i in 0..8 {
        if name == intern_c(names[i as usize], pcx) {
            return true;
        }
    }
    false
}

// ---- Types ----

// A type's name, `T` or `a::b::T` (0.5: a type in a module; the segments
// before the name are the TyName's list; 0.14: also a projection, `I::Item`).
pub fn parse_type_name(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::TyName, start, 0, pcx);
    pcx.nodes[n as usize].a = expect_ident(pcx);
    if at(ColonColon, pcx) {
        let mark = list_begin(pcx);
        while eat(ColonColon, pcx) {
            let seg = new_node(NodeKind::Ident, pcx.nodes[n as usize].start, prev_end(pcx), pcx);
            pcx.nodes[seg as usize].a = pcx.nodes[n as usize].a;
            list_push(seg, pcx);
            pcx.nodes[n as usize].a = expect_ident(pcx);
        }
        list_end(n, mark, pcx);
    }
    n
}

// A bound of a type parameter (0.9; 0.14: the built-in `Fn(A) -> R` and
// `FnMut(A) -> R`, a TyFn with d = 2 or 3, and a trait's associated-type
// constraints, `Iterator<Item = T>`: AssocType nodes in the holder `h`).
pub fn parse_bound(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    if !at(Ident, pcx) {
        return parse_type(pcx);
    }
    // (0.16: `effects(panic)`, an upper bound of the effects of a
    // closure or fn bound to the parameter)
    if tok_kind(1, pcx) == LParen
        && pcx.toks[pcx.p as usize].value as i64 == intern_c(c"effects", pcx) {
        advance(pcx);
        let n = new_node(NodeKind::EffectSet, start, 0, pcx);
        pcx.nodes[n as usize].c = EFFECTS_BOUND;
        pcx.effect_bounds.push(n);
        parse_effect_list(n, pcx);
        return n;
    }
    if tok_kind(1, pcx) == LParen {
        let name = pcx.toks[pcx.p as usize].value as i64;
        let d: i64 = if name == intern_c(c"Fn", pcx) { 2 }
            else if name == intern_c(c"FnMut", pcx) { 3 }
            else if name == intern_c(c"FnOnce", pcx) {
                // RULE: D19.6 (0.27.2: the rust edition's `FnOnce`, d = 4)
                4
            }
            else { 0 };
        if d != 0 {
            advance(pcx);
            let n = parse_fn_type_rest(start, pcx);
            pcx.nodes[n as usize].d = d;
            return n;
        }
    }
    let n = parse_type_name(start, pcx);
    if at(Lt, pcx) {
        // Type arguments (0.15: `From<U>`) and constraints, `Name = T`
        let lt = cur_start(pcx);
        advance(pcx);
        let mark = list_begin(pcx);
        while !at_gt(pcx) && !at(Eof, pcx) {
            if crate::front::parser::rust::skip_lifetime_bound(pcx) {
                // (0.27.0: a trait's lifetime argument, `Tr<'a>`)
            } else if at(Ident, pcx) && tok_kind(1, pcx) == Eq {
                let c = new_node(NodeKind::AssocType, cur_start(pcx), 0, pcx);
                pcx.nodes[c as usize].a = expect_ident(pcx);
                expect(Eq, pcx);
                pcx.nodes[c as usize].b = parse_type(pcx);
                pcx.nodes[c as usize].end = prev_end(pcx);
                list_push(c, pcx);
            } else {
                list_push(parse_type(pcx), pcx);
            }
            if !eat(Comma, pcx) {
                break;
            }
        }
        expect_gt(pcx);
        let end = pcx.scratch.len() as i64;
        if end == mark {
            error_at(lt, c"expected a type argument", pcx);
        }
        // (the constraints to the holder h, the types to g)
        for pass in 0..2 {
            for i in mark..end {
                if (pcx.nodes[(pcx.scratch[i as usize]) as usize].kind
                    == NodeKind::AssocType) == (pass == 0) {
                    list_push((pcx.scratch[i as usize]), pcx);
                }
            }
            if pcx.scratch.len() as i64 > end {
                let holder = new_node(NodeKind::Generics, lt, prev_end(pcx), pcx);
                list_end(holder, end, pcx);
                if pass == 0 {
                    pcx.nodes[n as usize].h = holder;
                } else {
                    pcx.nodes[n as usize].g = holder;
                }
            }
        }
        pcx.scratch.truncate(mark);
    }
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// `(alloc(Gpa, extern), io, ...)` after `effects` (0.16), in an attribute
// or a bound: the EffectItem nodes, the list of EffectSet n. The names are
// any identifiers (and `unsafe`, `static`); front/effects checks them.
pub fn parse_effect_list(n: i64, pcx: &mut Ctx<Comp>) {
    expect(LParen, pcx);
    let mark = list_begin(pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        let item = new_node(NodeKind::EffectItem, cur_start(pcx), 0, pcx);
        if eat(Unsafe, pcx) {
            pcx.nodes[item as usize].a = intern_c(c"unsafe", pcx);
        } else if eat(Tok::Static, pcx) {
            // (0.27.2.1, E1.2: `static`, the new name of `global`)
            pcx.nodes[item as usize].a = intern_c(c"static", pcx);
        } else {
            pcx.nodes[item as usize].a = expect_ident(pcx);
        }
        if eat(LParen, pcx) {
            let imark = list_begin(pcx);
            while !at(RParen, pcx) && !at(Eof, pcx) {
                if eat(Extern, pcx) {
                    pcx.nodes[item as usize].b = 1;
                } else {
                    list_push(parse_type(pcx), pcx);
                }
                if !eat(Comma, pcx) {
                    break;
                }
            }
            list_end(item, imark, pcx);
            expect(RParen, pcx);
        }
        pcx.nodes[item as usize].end = prev_end(pcx);
        list_push(item, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RParen, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
}

pub fn parse_type(pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let start = cur_start(pcx);
        let kind = cur(pcx);
        // (0.20) accesses `let T`, `inout T` (conventions.md §6); `sink T`
        // outside a parameter
        if kind == Let {
            return parse_access_type(start, kind != Let, pcx);
        }
        if kind == Ident {
            let n = parse_type_name(start, pcx);
            // (a primitive type takes no type arguments: `x as i64 < n`
            // compares, 0.11)
            if (at(Lt, pcx) || (at(Tok::Shl, pcx)))
                && !(pcx.nodes[n as usize].list == 0
                    && is_primitive_name(pcx.nodes[n as usize].a, pcx)) {
                pcx.nodes[n as usize].g = parse_type_args(pcx);
                crate::front::parser::rust::bind_lifetimes(n, pcx);
            }
            pcx.nodes[n as usize].end = prev_end(pcx);
            return n;
        }
        if kind == Star {
            advance(pcx);
            // (0.27.0: `*const T`, `*mut T` in the rust edition; both `*T`)
            let raw: i64 = crate::front::parser::rust::raw_pointer_kind(pcx);
            let n = new_node(NodeKind::TyPtr, start, 0, pcx);
            pcx.nodes[n as usize].c = raw;
            pcx.nodes[n as usize].a = parse_type(pcx);
            pcx.nodes[n as usize].end = prev_end(pcx);
            return n;
        }
        if kind == Lt {
            return crate::front::parser::rust::qualified_path(pcx);
        }
        if kind == Tok::Impl {
            // (0.26.2) `x: impl Display`
            return crate::front::parser::items::params::parse_impl_type(start, pcx);
        }
        if kind == Bang {
            advance(pcx);
            return new_node(NodeKind::TyNever, start, prev_end(pcx), pcx);
        }
        if kind == LParen {
            return parse_paren_type(start, pcx);
        }
        if kind == LBracket {
            return parse_array_type(start, pcx);
        }
        if kind == Fn {
            return parse_fn_type(start, pcx);
        }
        // RULE: F19.3 (the rust edition: `unsafe fn(..) -> R` and `unsafe
        // extern "C" fn(..)`, a fn pointer type; the node keeps
        // ITEM_UNSAFE, which resolve_type makes the type's unsafe bit)
        if kind == Unsafe && (tok_kind(1, pcx) == Fn || tok_kind(1, pcx) == Extern) {
            advance(pcx);
            let n = parse_type(pcx);
            pcx.nodes[n as usize].p |= crate::front::ast::ITEM_UNSAFE;
            pcx.nodes[n as usize].start = start;
            return n;
        }
        if kind == Extern {
            advance(pcx);
            if at(Str, pcx) {
                let abi = pcx.toks[pcx.p as usize].value as i64;
                if !(str_at(abi).len() == 1 && (*str_at(abi).ptr.add(0)) == b'C') {
                    error_at(cur_start(pcx), c"unsupported ABI; only \"C\" is supported", pcx);
                }
                advance(pcx);
            }
            let n = parse_fn_type(start, pcx);
            pcx.nodes[n as usize].d = 1;
            return n;
        }
        if kind == Reserved {
            reserved_error(pcx);
        }
        if kind == Amp {
            // (0.17) References: `&T`, `&mut T`; `&[T]` is `[T]`, `&mut [T]`
            // the exclusive slice (docs/design/value-semantics.md §2.3).
            // (0.20) `&str` is `str`, std's view of UTF-8 text, as `&[T]` is `[T]`.
            advance(pcx);
            return parse_ref_rest(start, pcx);
        }
        if kind == AmpAmp {
            // `&&T` is `& &T`. (0.27.1: the rust edition's inner reference is
            // read as after `&`: `&&'a T`, `&&mut T`, `&&str`)
            advance(pcx);
            let inner = parse_ref_rest(start + 1, pcx);
            let n = new_node(NodeKind::TyPtr, start, prev_end(pcx), pcx);
            pcx.nodes[n as usize].a = inner;
            pcx.nodes[n as usize].p |= NODE_REF;
            return n;
        }
        syntax_error(c"expected type", pcx)
    }
}

// After `&` in a type at start (taken): the reference type, `&T`, `&mut
// T`, `&'a T`; `&[T]` is `[T]`, `&str` `str` (0.27.1: also the inner
// reference of `&&T` in the rust edition).
fn parse_ref_rest(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    // (0.27.0: `&'a T`, the rust edition's; the c of the TyPtr or TySlice)
    let lifetime = crate::front::parser::rust::ref_lifetime(pcx);
    let mutable = eat(Mut, pcx);
    let inner = parse_type(pcx);
    // RULE: Z9.1b (0.27.3: `&mut &[u8]`, `&&str`: a reference to a view
    // written as one, a TyPtr, not the view's own `&`)
    let view_ref = (pcx.nodes[inner as usize].kind == NodeKind::TySlice
        || pcx.nodes[inner as usize].kind == NodeKind::TyName
        && sym_text(pcx.nodes[inner as usize].a, pcx) == b"str")
        && get_src()[pcx.nodes[inner as usize].start as usize] == b'&';
    if !view_ref && pcx.nodes[inner as usize].kind == NodeKind::TyName
        && pcx.nodes[inner as usize].list == 0 && pcx.nodes[inner as usize].g == 0
        && sym_text(pcx.nodes[inner as usize].a, pcx) == b"str" {
        pcx.nodes[inner as usize].start = start;
        // (0.27.1: `&'a str`'s lifetime, the c of the TyName: the
        // region slots read it, places::regions)
        pcx.nodes[inner as usize].c = lifetime;
        // RULE: F0.1 (0.27.2: `&mut str` keeps its mutability: the TyName
        // says it, as a TySlice's `&mut [T]` does)
        if mutable {
            pcx.nodes[inner as usize].p |= NODE_REF_MUT;
        }
        return inner;
    }
    if !view_ref && pcx.nodes[inner as usize].kind == NodeKind::TySlice {
        if mutable {
            pcx.nodes[inner as usize].p |= NODE_REF_MUT;
        }
        pcx.nodes[inner as usize].c = lifetime;
        pcx.nodes[inner as usize].start = start;
        return inner;
    }
    let n = new_node(NodeKind::TyPtr, start, prev_end(pcx), pcx);
    pcx.nodes[n as usize].a = inner;
    pcx.nodes[n as usize].c = lifetime;
    pcx.nodes[n as usize].p |= if mutable { NODE_REF | NODE_REF_MUT } else { NODE_REF };
    return n;
}

// (0.20) `let T` (shared) or `inout T` (exclusive), at `let` / `exclusive`: an
// access, the reference `&T` / `&mut T` flagged CONV_NEW (`inout [T]`: the
// exclusive slice; `let [T]` is `[T]`).
fn parse_access_type(start: i64, exclusive: bool, pcx: &mut Ctx<Comp>) -> i64 {
    advance(pcx);
    let inner = parse_type(pcx);
    if pcx.nodes[inner as usize].kind == NodeKind::TySlice {
        if exclusive {
            pcx.nodes[inner as usize].p |= NODE_REF_MUT;
        }
        pcx.nodes[inner as usize].p |= CONV_NEW;
        pcx.nodes[inner as usize].start = start;
        return inner;
    }
    let n = new_node(NodeKind::TyPtr, start, prev_end(pcx), pcx);
    pcx.nodes[n as usize].a = inner;
    pcx.nodes[n as usize].p |= CONV_NEW | if exclusive { NODE_REF | NODE_REF_MUT }
        else { NODE_REF };
    n
}

fn parse_paren_type(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    expect(LParen, pcx);
    if eat(RParen, pcx) {
        return new_node(NodeKind::TyUnit, start, prev_end(pcx), pcx);
    }
    let first = parse_type(pcx);
    if !eat(Comma, pcx) {
        expect(RParen, pcx);
        return first;
    }
    let n = new_node(NodeKind::TyTuple, start, 0, pcx);
    let mark = list_begin(pcx);
    list_push(first, pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        list_push(parse_type(pcx), pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RParen, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

fn parse_array_type(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    expect(LBracket, pcx);
    let n = new_node(NodeKind::TyArray, start, 0, pcx);
    pcx.nodes[n as usize].a = parse_type(pcx);
    if eat(RBracket, pcx) {
        pcx.nodes[n as usize].kind = NodeKind::TySlice;
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    expect(Semi, pcx);
    let saved = with_no_struct(false, pcx);
    pcx.nodes[n as usize].b = parse_expr(pcx);
    pcx.no_struct = saved;
    expect(RBracket, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

fn parse_fn_type(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    expect(Fn, pcx);
    parse_fn_type_rest(start, pcx)
}

// `(A, B) -> R` after `fn` (or a bound's `Fn`, 0.14).
fn parse_fn_type_rest(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    expect(LParen, pcx);
    let n = new_node(NodeKind::TyFn, start, 0, pcx);
    let mark = list_begin(pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        if at(Ellipsis, pcx) {
            error_at(cur_start(pcx),
                c"function pointer types cannot be variadic; call variadic functions directly",
                pcx);
        }
        // (0.20) `fn(sink T)`: a by-value parameter (its convention is
        // not a type: the function type is `fn(T)` until T1)
        let t = parse_type(pcx);
        list_push(t, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RParen, pcx);
    if eat(Arrow, pcx) {
        pcx.nodes[n as usize].a = parse_type(pcx);
    } else {
        pcx.nodes[n as usize].a = new_node(NodeKind::TyUnit, prev_end(pcx), prev_end(pcx), pcx);
    }
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}
