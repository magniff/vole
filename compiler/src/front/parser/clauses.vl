// The syntax of 0.18 (docs/design/contracts-verification.md §2.1-§2.3,
// §2.6-§2.10): `requires`/`ensures` clauses after a signature, an
// `invariant` after a struct or an enum, `type X = distinct T [invariant
// ...]`, and the attributes `#[test]`, `#[property]`, `#[fuzz]` and
// `#[cfg(test)]`. The words are contextual: an identifier is one of them
// only where a clause may stand. What is read goes to front/contracts's
// side tables; the AST's nodes are the ordinary ones (a condition is an
// expression, a message a string or an f-string).

use crate::base::intern_c;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{NodeKind, new_node};
use crate::front::check::format::format_message;
use crate::front::contracts::{
    CLAUSE_DEBUG, CLAUSE_ENSURES, CLAUSE_INVARIANT, CLAUSE_REQUIRES, TEST_CFG, TEST_FN, TEST_FUZZ,
    TEST_PROPERTY, add_clause, add_test_item, mark_distinct,
};
use crate::front::lexer::Tok::{
    ColonColon, Comma, Else, Hash, Ident, LBrace, LBracket, LParen, Lt, RBracket, RParen, Semi,
};
use crate::front::parser::{advance, at, cur_start, eat, expect, syntax_error, tok_kind};
use crate::front::parser::exprs::{parse_expr, parse_expr_list};
use crate::front::parser::items::parse_top_item;
use crate::front::parser::types::parse_type;

// A function's flag while its test attribute is pending (between the
// attribute and take_test_attrs); never left on a node.
pub const FN_TEST_ATTR: i64 = 1 << 48;

fn words(pcx: &mut Ctx<Comp>) {
    if pcx.words_ready {
        return;
    }
    pcx.w_requires = intern_c(c"requires", pcx);
    pcx.w_ensures = intern_c(c"ensures", pcx);
    pcx.w_invariant = intern_c(c"invariant", pcx);
    pcx.w_debug = intern_c(c"debug", pcx);
    pcx.w_distinct = intern_c(c"distinct", pcx);
    pcx.w_test = intern_c(c"test", pcx);
    pcx.w_property = intern_c(c"property", pcx);
    pcx.w_fuzz = intern_c(c"fuzz", pcx);
    pcx.w_cfg = intern_c(c"cfg", pcx);
    pcx.words_ready = true;
}

// Whether the token `offset` ahead is the identifier `word` (a symbol).
fn is_word(offset: i64, word: i64, pcx: &Ctx<Comp>) -> bool {
    tok_kind(offset, pcx) == Ident && (pcx.toks[(pcx.p + offset) as usize].value as i64) == word
}

// An expression where a `{` ends it (a clause before a body).
fn clause_expr(pcx: &mut Ctx<Comp>) -> i64 {
    let saved = pcx.no_struct;
    pcx.no_struct = true;
    let e = parse_expr(pcx);
    pcx.no_struct = saved;
    e
}

// `else "message"` (or an f-string) after a condition: its node, or 0.
// (0.26.2) A plain literal is a format literal, its arguments after it:
// `else "len {}", v.len()` (front/check/format.vl's format_message).
fn clause_message(pcx: &mut Ctx<Comp>) -> i64 {
    if !eat(Else, pcx) {
        return 0;
    }
    let m = clause_expr(pcx);
    let mut args: i64 = 0;
    if !at(Comma, pcx) {
        crate::front::check::format::note_site(m, crate::front::check::format::SITE_FORMAT, pcx);
    }
    if eat(Comma, pcx) {
        let saved = pcx.no_struct;
        pcx.no_struct = true;
        args = new_node(NodeKind::Call, pcx.nodes[m as usize].start, pcx.nodes[m as usize].end, pcx);
        parse_expr_list(args, LBrace, pcx);
        pcx.no_struct = saved;
    }
    if pcx.nodes[m as usize].kind != NodeKind::Str {
        if args != 0 {
            syntax_error(
                c"a message's arguments follow a plain string literal: `else \"len {}\", v.len()`", pcx);
        }
        return m;
    }
    format_message(m, args, pcx)
}

// The clauses after function f's signature: `[debug] requires COND [else
// MESSAGE]`, `[debug] ensures COND [else MESSAGE]`, any number, in order.
pub fn parse_clauses(f: i64, pcx: &mut Ctx<Comp>) {
    if !at(Ident, pcx) {
        return;
    }
    words(pcx);
    loop {
        let pos = cur_start(pcx);
        let mut flags: i64 = 0;
        if is_word(0, pcx.w_debug, pcx)
            && (is_word(1, pcx.w_requires, pcx) || is_word(1, pcx.w_ensures, pcx)) {
            flags = CLAUSE_DEBUG;
            advance(pcx);
        }
        let kind: i64 = if is_word(0, pcx.w_requires, pcx) { CLAUSE_REQUIRES }
            else if is_word(0, pcx.w_ensures, pcx) { CLAUSE_ENSURES } else { 0 };
        if kind == 0 {
            return;
        }
        advance(pcx);
        let cond = clause_expr(pcx);
        let message = clause_message(pcx);
        add_clause(f, kind | flags, cond, message, pos, pcx);
    }
}

// `[debug] invariant COND [else MESSAGE] [;]` after struct or enum `item`'s
// closing brace (or a distinct alias's type).
pub fn parse_type_invariant(item: i64, pcx: &mut Ctx<Comp>) {
    if !at(Ident, pcx) {
        return;
    }
    words(pcx);
    let pos = cur_start(pcx);
    let mut flags: i64 = 0;
    if is_word(0, pcx.w_debug, pcx) && is_word(1, pcx.w_invariant, pcx) {
        flags = CLAUSE_DEBUG;
        advance(pcx);
    } else if !is_word(0, pcx.w_invariant, pcx) {
        return;
    }
    advance(pcx);
    let cond = clause_expr(pcx);
    let message = clause_message(pcx);
    add_clause(item, CLAUSE_INVARIANT | flags, cond, message, pos, pcx);
}

// The type of `type X = ...` (alias node `alias`): `distinct T` marks it,
// and a distinct type may have an invariant before the `;`.
pub fn parse_alias_target(alias: i64, pcx: &mut Ctx<Comp>) -> i64 {
    words(pcx);
    if is_word(0, pcx.w_distinct, pcx) && tok_kind(1, pcx) != Semi && tok_kind(1, pcx) != Lt
        && tok_kind(1, pcx) != ColonColon {
        advance(pcx);
        mark_distinct(alias, pcx);
    }
    let ty = parse_type(pcx);
    parse_type_invariant(alias, pcx);
    ty
}

// After `#[` and the attribute's name: true when it is `test`,
// `property`, `fuzz` or `cfg(test)` (read, and pending for the function
// that follows), false for any other attribute.
pub fn test_attribute(name: i64, pcx: &mut Ctx<Comp>) -> bool {
    words(pcx);
    let kind: i64 = if name == pcx.w_test { TEST_FN } else if name == pcx.w_property { TEST_PROPERTY }
        else if name == pcx.w_fuzz { TEST_FUZZ } else if name == pcx.w_cfg { TEST_CFG } else { 0 };
    if kind == 0 {
        return false;
    }
    if kind == TEST_CFG {
        expect(LParen, pcx);
        if !is_word(0, pcx.w_test, pcx) {
            syntax_error(c"expected 'test': the one cfg vole has is #[cfg(test)]", pcx);
        }
        advance(pcx);
        expect(RParen, pcx);
    }
    if pcx.pending_test == 0 || pcx.pending_test == TEST_CFG {
        pcx.pending_test = kind;
    }
    true
}

// Function f's pending test attribute, recorded; FN_TEST_ATTR cleared.
pub fn take_test_attrs(f: i64, pcx: &mut Ctx<Comp>) {
    if pcx.pending_test != 0 {
        add_test_item(f, pcx.pending_test, pcx);
        pcx.pending_test = 0;
    }
    pcx.nodes[f as usize].p &= ~FN_TEST_ATTR;
}

// At `#[cfg(test)]` (the whole attribute, which parse_top_item takes
// before any other).
pub fn at_cfg_test(pcx: &mut Ctx<Comp>) -> bool {
    words(pcx);
    tok_kind(0, pcx) == Hash && tok_kind(1, pcx) == LBracket && is_word(2, pcx.w_cfg, pcx)
        && tok_kind(3, pcx) == LParen && is_word(4, pcx.w_test, pcx) && tok_kind(5, pcx) == RParen
        && tok_kind(6, pcx) == RBracket
}

// `#[cfg(test)]` and the item after it (a module with its items, a
// function, a struct, ...): each item it pushes to the program's list is
// marked TEST_CFG.
pub fn parse_cfg_test_item(pcx: &mut Ctx<Comp>) {
    unsafe {
        for _ in 0..7 {
            advance(pcx);
        }
        let mark = pcx.scratch.count;
        parse_top_item(pcx);
        for i in mark..pcx.scratch.count {
            add_test_item((*pcx.scratch.data.add(i as usize)), TEST_CFG, pcx);
        }
    }
}
