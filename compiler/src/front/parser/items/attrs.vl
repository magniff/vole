use crate::arch::virtual::in_arch_source;
use crate::base::{intern, intern_c, streq};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::error_at;
use crate::front::ast::{
    EFFECTS_DECL, EFFECTS_NO_ALLOC, EFFECTS_NO_IO, EFFECTS_NO_PANIC, EFFECTS_PURE, FN_COLD,
    FN_EFFECT_DECL, FN_FEATURES, FN_INLINE, FN_INTRINSIC, FN_NO_INLINE, FN_TERMINATES,
    FN_VIEWS_DECL, NodeKind, list_begin, list_end, list_push, new_node,
};
use crate::front::check::name_error;
use crate::front::features::{FA_MULTIVERSION, FA_TARGET_FEATURE, note_feature_attr};
use crate::front::lexer::str_at;
use crate::front::lexer::Tok::{
    Comma, Eof, Eq, Hash, Int, LBracket, LParen, RBracket, RParen, Star, Str,
};
use crate::front::parser::{
    advance, at, cur_start, eat, expect, expect_ident, prev_end, syntax_error,
};
use crate::front::parser::types::parse_effect_list;

// After `#[` and the name `name` (at pos): when it is an effect
// declaration (0.16), parses it as an EffectSet (its arguments, for
// `effects`), adds it to EFFECT_DECLS and returns true.
pub fn parse_effect_attribute(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    let form = if name == intern_c(c"effects", pcx) { EFFECTS_DECL }
        else if name == intern_c(c"pure", pcx) { EFFECTS_PURE }
        else if name == intern_c(c"no_alloc", pcx) { EFFECTS_NO_ALLOC }
        else if name == intern_c(c"no_io", pcx) { EFFECTS_NO_IO }
        else if name == intern_c(c"no_panic", pcx) { EFFECTS_NO_PANIC }
        else { 0 };
    if form == 0 {
        return false;
    }
    let n = new_node(NodeKind::EffectSet, pos, prev_end(pcx), pcx);
    pcx.nodes[n as usize].c = form;
    if form == EFFECTS_DECL {
        parse_effect_list(n, pcx);
    }
    if pcx.effect_decls == 0 {
        pcx.effect_decls = n;
    } else {
        { let at_ix = pcx.effect_decls_last as usize; pcx.nodes[at_ix].b = n };
    }
    pcx.effect_decls_last = n;
    true
}

// After `#[` (at pos) and the name `name`: when it is `deprecated`, parses the
// rest of it up to the `]` and returns true.
pub fn parse_deprecated_attribute(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    if name != intern_c(c"deprecated", pcx) {
        return false;
    }
    let mut note: i64 = -1;
    if eat(Eq, pcx) {
        note = expect_note(pcx);
    } else if eat(LParen, pcx) {
        while !at(RParen, pcx) && !at(Eof, pcx) {
            let key_pos = cur_start(pcx);
            let key = expect_ident(pcx);
            expect(Eq, pcx);
            let text = expect_note(pcx);
            if key == intern_c(c"note", pcx) {
                note = text;
            } else if key != intern_c(c"since", pcx) {
                name_error(key_pos, c"unknown deprecated option '", key,
                    c"' (expected #[deprecated(since = \"1.0\", note = \"use new_fn\")])", pcx);
            }
            if !eat(Comma, pcx) {
                break;
            }
        }
        expect(RParen, pcx);
    }
    if pcx.deprecated_pending == -2 {
        pcx.deprecated_pending_at = pos;
    }
    pcx.deprecated_pending = note;
    true
}

// A #[deprecated]'s string, interned.
fn expect_note(pcx: &mut Ctx<Comp>) -> i64 {
    // UNSAFE: TOKS is the lexer's token table, a raw pointer (front/lexer).
    // SAFETY: P is the parser's current token, below TOK_COUNT (the last is
    // Eof, never a Str); a Str token's value is its string's id.
    unsafe {
        if !at(Str, pcx) {
            syntax_error(c"expected the note as a string: #[deprecated(note = \"use new_fn\")]",
                pcx);
        }
        let s = intern(str_at(pcx.toks[pcx.p as usize].value as i64), pcx);
        advance(pcx);
        s
    }
}

// Gives item node `item` the #[deprecated] parsed before it; with item 0,
// drops it.
pub fn take_deprecated(item: i64, pcx: &mut Ctx<Comp>) {
    if item > 0 && pcx.deprecated_pending != -2 {
        pcx.deprecated.put(pcx.nodes[item as usize].start + 1, pcx.deprecated_pending + 2);
        pcx.deprecated_at.put(pcx.nodes[item as usize].start + 1, pcx.deprecated_pending_at + 1);
        pcx.deprecated_nodes.push(item);
    }
    pcx.deprecated_pending = -2;
}

// The #[deprecated] waiting for its item, taken (a struct's, while its
// fields are parsed); put back by restore_deprecated.
pub fn save_deprecated(pcx: &mut Ctx<Comp>) -> i64 {
    let saved = pcx.deprecated_pending;
    pcx.deprecated_pending = -2;
    saved
}

// (its item's attributes start at `at`)
pub fn restore_deprecated(saved: i64, at: i64, pcx: &mut Ctx<Comp>) {
    pcx.deprecated_pending = saved;
    pcx.deprecated_pending_at = at;
}

// Gives function (or extern) node f the effect declarations parsed before
// it (0.16): its z, and FN_EFFECT_DECL. Called with f = 0, drops them.
// (0.26.3) The #[deprecated] before it too.
pub fn take_effect_decls(f: i64, pcx: &mut Ctx<Comp>) {
    take_deprecated(f, pcx);
    if f != 0 && pcx.effect_decls != 0 {
        pcx.nodes[f as usize].z = pcx.effect_decls;
        pcx.nodes[f as usize].p |= FN_EFFECT_DECL;
    }
    if f != 0 && pcx.views_pending != 0 {
        pcx.views_of.put(f + 1, pcx.views_pending + 1);
    }
    pcx.views_pending = 0;
    pcx.views_pending_last = 0;
    pcx.effect_decls = 0;
    pcx.effect_decls_last = 0;
}

// Whether effect declarations wait for their function (0.16).
pub fn has_effect_decls(pcx: &Ctx<Comp>) -> bool {
    pcx.effect_decls != 0 || pcx.views_pending != 0
}

// (0.17) `#[views(a, *b)]`, `#[stores(c)]` before a function
// (docs/design/value-semantics.md §2.4): the view summary it declares.
// Each is an EffectSet node of form VIEWS_FORM or STORES_FORM whose list is
// EffectItem nodes, a: the parameter's name, b: 1 for `*p`; chained by b.
// take_effect_decls gives them to the function (VIEWS_OF).
pub const VIEWS_FORM: i64 = 7;
pub const STORES_FORM: i64 = 8;

pub fn parse_views_attribute(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> bool {
    let form: i64 = if name == intern_c(c"views", pcx) { VIEWS_FORM }
        else if name == intern_c(c"stores", pcx) { STORES_FORM }
        else { 0 };
    if form == 0 {
        return false;
    }
    let n = new_node(NodeKind::EffectSet, pos, 0, pcx);
    pcx.nodes[n as usize].c = form;
    expect(LParen, pcx);
    let mark = list_begin(pcx);
    while !at(RParen, pcx) && !at(Eof, pcx) {
        let item = new_node(NodeKind::EffectItem, cur_start(pcx), 0, pcx);
        if eat(Star, pcx) {
            pcx.nodes[item as usize].b = 1;
        }
        pcx.nodes[item as usize].a = expect_ident(pcx);
        pcx.nodes[item as usize].end = prev_end(pcx);
        list_push(item, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RParen, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    if pcx.views_pending == 0 {
        pcx.views_pending = n;
    } else {
        { let at_ix = pcx.views_pending_last as usize; pcx.nodes[at_ix].b = n };
    }
    pcx.views_pending_last = n;
    true
}

// The first views/stores declaration of function node f, 0: none.
pub fn views_of(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let v = pcx.views_of.get(f + 1);
    if v == 0 { 0 } else { v - 1 }
}

// (0.28.0) Whether position pos is in std's text (the built-in std, or the
// tree's read in its place) or in the impls the compiler makes for std's
// `#[builtin_impls]` (front/builtin_impls.vl: the last source while it is
// parsed): where std's own attributes are accepted.
fn in_std_source(pos: i64, pcx: &Ctx<Comp>) -> bool {
    let last = pcx.files.len() as i64 - 1;
    if last >= 0 && pos >= pcx.files[last as usize].start && pos < pcx.files[last as usize].end
        && streq(pcx.files[last as usize].path, c"<builtin>") {
        return true;
    }
    if pcx.std_file < 0 || pcx.std_file > last {
        return false;
    }
    pos >= pcx.files[pcx.std_file as usize].start && pos < pcx.files[pcx.std_file as usize].end
}

// `#[inline]`, `#[inline(never)]` or `#[cold]` (0.6) after `#[` and the
// name: its FN_ flag, or 0 when `name` is another attribute. (0.16) An
// effect declaration, `#[effects(...)]`, `#[pure]`, `#[no_alloc]`,
// `#[no_io]` or `#[no_panic]`: FN_EFFECT_DECL, its EffectSet added to
// those take_effect_decls gives the function.
pub fn parse_fn_attribute(name: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    if parse_effect_attribute(name, pos, pcx) {
        return FN_EFFECT_DECL;
    }
    // (0.17: a view summary, front/own/summary.vl)
    if parse_views_attribute(name, pos, pcx) {
        return FN_VIEWS_DECL;
    }
    if name == intern_c(c"cold", pcx) {
        return FN_COLD;
    }
    // RULE: E2.2 (0.28.0) `#[terminates]`, std's own: an unchecked promise
    // that the function ends (front/effects/infer.vl: terminates)
    if name == intern_c(c"terminates", pcx) {
        if !in_std_source(pos, pcx) {
            name_error(pos, c"unknown attribute '", name,
                c"' (#[terminates] is std's own: a promise the compiler does not check; a loop it cannot count is `diverge`)", pcx);
        }
        return FN_TERMINATES;
    }
    // (0.19) std::arch: `#[intrinsic(ID)]` (its virtual declarations
    // only), `#[target_feature(enable = "a,b")]`,
    // `#[multiversion("a", "b,c")]` (front/features)
    if name == intern_c(c"intrinsic", pcx) {
        if !in_arch_source(pos, pcx) {
            name_error(pos, c"unknown attribute '", name,
                c"' (#[intrinsic] is std::arch's own)", pcx);
        }
        expect(LParen, pcx);
        if !at(Int, pcx) {
            syntax_error(c"expected the intrinsic's id", pcx);
        }
        pcx.intrinsic_pending = pcx.toks[pcx.p as usize].value as i64;
        advance(pcx);
        expect(RParen, pcx);
        return FN_INTRINSIC;
    }
    if name == intern_c(c"target_feature", pcx) {
        expect(LParen, pcx);
        let word = expect_ident(pcx);
        if word != intern_c(c"enable", pcx) {
            name_error(pos, c"unknown target_feature option '", word,
                c"' (expected #[target_feature(enable = \"avx2,fma\")])", pcx);
        }
        expect(Eq, pcx);
        if !at(Str, pcx) {
            syntax_error(
                c"expected the features as a string: #[target_feature(enable = \"avx2,fma\")]",
                pcx);
        }
        note_feature_attr(FA_TARGET_FEATURE, pcx.toks[pcx.p as usize].value as i64, pos, pcx);
        advance(pcx);
        expect(RParen, pcx);
        return FN_FEATURES;
    }
    if name == intern_c(c"multiversion", pcx) {
        expect(LParen, pcx);
        while at(Str, pcx) {
            note_feature_attr(FA_MULTIVERSION, pcx.toks[pcx.p as usize].value as i64, pos, pcx);
            advance(pcx);
            if !eat(Comma, pcx) {
                break;
            }
        }
        expect(RParen, pcx);
        return FN_FEATURES;
    }
    if name != intern_c(c"inline", pcx) {
        return 0;
    }
    if eat(LParen, pcx) {
        let arg = expect_ident(pcx);
        if arg != intern_c(c"never", pcx) {
            name_error(pos, c"unknown inline option '", arg,
                c"' (expected #[inline] or #[inline(never)])", pcx);
        }
        expect(RParen, pcx);
        return FN_NO_INLINE;
    }
    FN_INLINE
}

// The function attributes before a function in an impl block (0.6).
pub fn parse_fn_attributes(pcx: &mut Ctx<Comp>) -> i64 {
    let mut flags: i64 = 0;
    let start = cur_start(pcx);
    take_effect_decls(0, pcx);
    while at(Hash, pcx) {
        let pos = cur_start(pcx);
        advance(pcx);
        expect(LBracket, pcx);
        let name = expect_ident(pcx);
        // (0.26.3: #[deprecated], which take_effect_decls gives the function)
        if parse_deprecated_attribute(name, pos, pcx) {
            expect(RBracket, pcx);
            continue;
        }
        let flag = parse_fn_attribute(name, pos, pcx);
        if flag == 0 {
            name_error(pos, c"unknown attribute '", name,
                c"' before a function (expected inline, inline(never), cold, effects, pure, no_alloc, no_io, no_panic, views or stores)", pcx);
        }
        flags |= flag;
        expect(RBracket, pcx);
    }
    check_fn_attributes(flags, start, pcx);
    flags
}

pub fn check_fn_attributes(flags: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    if (flags & FN_INLINE) != 0 && (flags & FN_NO_INLINE) != 0 {
        error_at(pos, c"a function cannot be both #[inline] and #[inline(never)]", pcx);
    }
}
