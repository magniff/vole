use crate::arch::virtual::in_arch_source;
use crate::base::{IntVec, intern, intern_c};
use crate::base::diag::error_at;
use crate::front::ambient::AMBIENT_TRY;
use crate::front::ast::{
    EFFECTS_DECL, EFFECTS_NO_ALLOC, EFFECTS_NO_IO, EFFECTS_NO_PANIC, EFFECTS_PURE, FN_AMBIENT,
    FN_COLD, FN_EFFECT_DECL, FN_FEATURES, FN_INLINE, FN_INTRINSIC, FN_NO_INLINE, FN_VIEWS_DECL,
    NODES, NodeKind, list_begin, list_end, list_push, new_node,
};
use crate::front::check::name_error;
use crate::front::features::{FA_MULTIVERSION, FA_TARGET_FEATURE, note_feature_attr};
use crate::front::lexer::{TOKS, str_at};
use crate::front::lexer::Tok::{
    Comma, Eof, Eq, Hash, Int, LBracket, LParen, RBracket, RParen, Star, Str,
};
use crate::front::parser::{
    P, advance, at, cur_start, eat, expect, expect_ident, prev_end, syntax_error,
};
use crate::front::parser::types::parse_effect_list;
use crate::middle::lower::ssa::HMap;

// The effect declarations parsed before the function being parsed (0.16):
// the first EffectSet and the last (chained by b).
static var EFFECT_DECLS: i64 = 0;
static var EFFECT_DECLS_LAST: i64 = 0;

// (0.19) The id of an #[intrinsic(ID)] before the function being parsed
// (-1: none).
pub static var INTRINSIC_PENDING: i64 = -1;

// The text of an #[ambient("...")] before the function being parsed (-1:
// none).
static var AMBIENT_PENDING: i64 = -1;

// After `#[` and the name `name` (at pos): when it is an effect
// declaration (0.16), parses it as an EffectSet (its arguments, for
// `effects`), adds it to EFFECT_DECLS and returns true.
pub fn parse_effect_attribute(name: i64, pos: i64) -> bool {
    let form = if name == intern_c(c"effects") { EFFECTS_DECL }
        else if name == intern_c(c"pure") { EFFECTS_PURE }
        else if name == intern_c(c"no_alloc") { EFFECTS_NO_ALLOC }
        else if name == intern_c(c"no_io") { EFFECTS_NO_IO }
        else if name == intern_c(c"no_panic") { EFFECTS_NO_PANIC }
        else { 0 };
    if form == 0 {
        return false;
    }
    let n = new_node(NodeKind::EffectSet, pos, prev_end());
    NODES[n].c = form;
    if form == EFFECTS_DECL {
        parse_effect_list(n);
    }
    if EFFECT_DECLS == 0 {
        EFFECT_DECLS = n;
    } else {
        NODES[EFFECT_DECLS_LAST].b = n;
    }
    EFFECT_DECLS_LAST = n;
    true
}

// (0.26.3) Rust's `#[deprecated]`, `#[deprecated = "note"]` and
// `#[deprecated(since = "..", note = "..")]`: the item's start position +
// 1 -> its note's symbol + 2 (1: no note). A use of the item outside std
// is warning item.deprecated (front/check/deprecated.vl). Keyed by the
// start, as AMBIENT_TRY is: a function's copies (instances, a trait's
// defaults) have its start.
pub static var DEPRECATED: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// Item start + 1 -> the start of its first attribute + 1: a use from
// there to the item's end is the item's own (a derived impl's).
pub static var DEPRECATED_AT: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
// The deprecated items' nodes: a use inside one is no use (Rust's rule).
pub static var DEPRECATED_NODES: IntVec = IntVec { data: 0 as *i64, count: 0, cap: 0 };
// The #[deprecated] before the item being parsed: -2 none, -1 one with no
// note, else its note's symbol; and where the item's attributes start.
static var DEPRECATED_PENDING: i64 = -2;
static var DEPRECATED_PENDING_AT: i64 = 0;

// After `#[` (at pos) and the name `name`: when it is `deprecated`, parses the
// rest of it up to the `]` and returns true.
pub fn parse_deprecated_attribute(name: i64, pos: i64) -> bool {
    if name != intern_c(c"deprecated") {
        return false;
    }
    var note = -1;
    if eat(Eq) {
        note = expect_note();
    } else if eat(LParen) {
        while !at(RParen) && !at(Eof) {
            let key_pos = cur_start();
            let key = expect_ident();
            expect(Eq);
            let text = expect_note();
            if key == intern_c(c"note") {
                note = text;
            } else if key != intern_c(c"since") {
                name_error(key_pos, c"unknown deprecated option '", key,
                    c"' (expected #[deprecated(since = \"1.0\", note = \"use new_fn\")])");
            }
            if !eat(Comma) {
                break;
            }
        }
        expect(RParen);
    }
    if DEPRECATED_PENDING == -2 {
        DEPRECATED_PENDING_AT = pos;
    }
    DEPRECATED_PENDING = note;
    true
}

// A #[deprecated]'s string, interned.
fn expect_note() -> i64 {
    // UNSAFE: TOKS is the lexer's token table, a raw pointer (front/lexer).
    // SAFETY: P is the parser's current token, below TOK_COUNT (the last is
    // Eof, never a Str); a Str token's value is its string's id.
    unsafe {
        if !at(Str) {
            syntax_error(c"expected the note as a string: #[deprecated(note = \"use new_fn\")]");
        }
        let s = intern(str_at(TOKS[P].value as i64));
        advance();
        s
    }
}

// Gives item node `item` the #[deprecated] parsed before it; with item 0,
// drops it.
pub fn take_deprecated(item: i64) {
    if item > 0 && DEPRECATED_PENDING != -2 {
        DEPRECATED.put(NODES[item].start + 1, DEPRECATED_PENDING + 2);
        DEPRECATED_AT.put(NODES[item].start + 1, DEPRECATED_PENDING_AT + 1);
        DEPRECATED_NODES.push(item);
    }
    DEPRECATED_PENDING = -2;
}

// The #[deprecated] waiting for its item, taken (a struct's, while its
// fields are parsed); put back by restore_deprecated.
pub fn save_deprecated() -> i64 {
    let saved = DEPRECATED_PENDING;
    DEPRECATED_PENDING = -2;
    saved
}

// (its item's attributes start at `at`)
pub fn restore_deprecated(saved: i64, at: i64) {
    DEPRECATED_PENDING = saved;
    DEPRECATED_PENDING_AT = at;
}

// Gives function (or extern) node f the effect declarations parsed before
// it (0.16): its z, and FN_EFFECT_DECL. Called with f = 0, drops them.
// (0.26.3) The #[deprecated] before it too.
pub fn take_effect_decls(f: i64) {
    take_deprecated(f);
    if f != 0 && EFFECT_DECLS != 0 {
        NODES[f].z = EFFECT_DECLS;
        NODES[f].p |= FN_EFFECT_DECL;
    }
    if f != 0 && AMBIENT_PENDING >= 0 {
        AMBIENT_TRY.put(NODES[f].start + 1, AMBIENT_PENDING + 1);
    }
    if f != 0 && VIEWS_PENDING != 0 {
        VIEWS_OF.put(f + 1, VIEWS_PENDING + 1);
    }
    VIEWS_PENDING = 0;
    VIEWS_PENDING_LAST = 0;
    EFFECT_DECLS = 0;
    EFFECT_DECLS_LAST = 0;
    AMBIENT_PENDING = -1;
}

// Whether effect declarations wait for their function (0.16).
pub fn has_effect_decls() -> bool {
    EFFECT_DECLS != 0 || VIEWS_PENDING != 0
}

// (0.17) `#[views(a, *b)]`, `#[stores(c)]` before a function
// (docs/design/value-semantics.md §2.4): the view summary it declares.
// Each is an EffectSet node of form VIEWS_FORM or STORES_FORM whose list is
// EffectItem nodes, a: the parameter's name, b: 1 for `*p`; chained by b.
// take_effect_decls gives them to the function (VIEWS_OF).
pub const VIEWS_FORM: i64 = 7;
pub const STORES_FORM: i64 = 8;
static var VIEWS_PENDING: i64 = 0;
static var VIEWS_PENDING_LAST: i64 = 0;
// Per function node + 1: its first views/stores node + 1.
pub static var VIEWS_OF: HMap = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };

pub fn parse_views_attribute(name: i64, pos: i64) -> bool {
    let form = if name == intern_c(c"views") { VIEWS_FORM }
        else if name == intern_c(c"stores") { STORES_FORM }
        else { 0 };
    if form == 0 {
        return false;
    }
    let n = new_node(NodeKind::EffectSet, pos, 0);
    NODES[n].c = form;
    expect(LParen);
    let mark = list_begin();
    while !at(RParen) && !at(Eof) {
        let item = new_node(NodeKind::EffectItem, cur_start(), 0);
        if eat(Star) {
            NODES[item].b = 1;
        }
        NODES[item].a = expect_ident();
        NODES[item].end = prev_end();
        list_push(item);
        if !eat(Comma) {
            break;
        }
    }
    list_end(n, mark);
    expect(RParen);
    NODES[n].end = prev_end();
    if VIEWS_PENDING == 0 {
        VIEWS_PENDING = n;
    } else {
        NODES[VIEWS_PENDING_LAST].b = n;
    }
    VIEWS_PENDING_LAST = n;
    true
}

// The first views/stores declaration of function node f, 0: none.
pub fn views_of(f: i64) -> i64 {
    let v = VIEWS_OF.get(f + 1);
    if v == 0 { 0 } else { v - 1 }
}

// `#[inline]`, `#[inline(never)]` or `#[cold]` (0.6) after `#[` and the
// name: its FN_ flag, or 0 when `name` is another attribute. (0.16) An
// effect declaration, `#[effects(...)]`, `#[pure]`, `#[no_alloc]`,
// `#[no_io]` or `#[no_panic]`: FN_EFFECT_DECL, its EffectSet added to
// those take_effect_decls gives the function.
pub fn parse_fn_attribute(name: i64, pos: i64) -> i64 {
    unsafe {
        if parse_effect_attribute(name, pos) {
            return FN_EFFECT_DECL;
        }
        // (0.17: a view summary, front/own/summary.vl)
        if parse_views_attribute(name, pos) {
            return FN_VIEWS_DECL;
        }
        // (0.16: std's `#[ambient("Vec::new_in(gpa)")]`, front/ambient.vl)
        if name == intern_c(c"ambient") {
            expect(LParen);
            if !at(Str) {
                syntax_error(c"expected the text to write instead, as a string");
            }
            AMBIENT_PENDING = intern(str_at(TOKS[P].value as i64));
            advance();
            expect(RParen);
            return FN_AMBIENT;
        }
        if name == intern_c(c"cold") {
            return FN_COLD;
        }
        // (0.19) std::arch: `#[intrinsic(ID)]` (its virtual declarations
        // only), `#[target_feature(enable = "a,b")]`,
        // `#[multiversion("a", "b,c")]` (front/features)
        if name == intern_c(c"intrinsic") {
            if !in_arch_source(pos) {
                name_error(pos, c"unknown attribute '", name,
                    c"' (#[intrinsic] is std::arch's own)");
            }
            expect(LParen);
            if !at(Int) {
                syntax_error(c"expected the intrinsic's id");
            }
            INTRINSIC_PENDING = TOKS[P].value as i64;
            advance();
            expect(RParen);
            return FN_INTRINSIC;
        }
        if name == intern_c(c"target_feature") {
            expect(LParen);
            let word = expect_ident();
            if word != intern_c(c"enable") {
                name_error(pos, c"unknown target_feature option '", word,
                    c"' (expected #[target_feature(enable = \"avx2,fma\")])");
            }
            expect(Eq);
            if !at(Str) {
                syntax_error(
                    c"expected the features as a string: #[target_feature(enable = \"avx2,fma\")]");
            }
            note_feature_attr(FA_TARGET_FEATURE, TOKS[P].value as i64, pos);
            advance();
            expect(RParen);
            return FN_FEATURES;
        }
        if name == intern_c(c"multiversion") {
            expect(LParen);
            while at(Str) {
                note_feature_attr(FA_MULTIVERSION, TOKS[P].value as i64, pos);
                advance();
                if !eat(Comma) {
                    break;
                }
            }
            expect(RParen);
            return FN_FEATURES;
        }
        if name != intern_c(c"inline") {
            return 0;
        }
        if eat(LParen) {
            let arg = expect_ident();
            if arg != intern_c(c"never") {
                name_error(pos, c"unknown inline option '", arg,
                    c"' (expected #[inline] or #[inline(never)])");
            }
            expect(RParen);
            return FN_NO_INLINE;
        }
        FN_INLINE
    }
}

// The function attributes before a function in an impl block (0.6).
pub fn parse_fn_attributes() -> i64 {
    var flags = 0;
    let start = cur_start();
    take_effect_decls(0);
    while at(Hash) {
        let pos = cur_start();
        advance();
        expect(LBracket);
        let name = expect_ident();
        // (0.26.3: #[deprecated], which take_effect_decls gives the function)
        if parse_deprecated_attribute(name, pos) {
            expect(RBracket);
            continue;
        }
        let flag = parse_fn_attribute(name, pos);
        if flag == 0 {
            name_error(pos, c"unknown attribute '", name,
                c"' before a function (expected inline, inline(never), cold, effects, pure, no_alloc, no_io, no_panic, views or stores)");
        }
        flags |= flag;
        expect(RBracket);
    }
    check_fn_attributes(flags, start);
    flags
}

pub fn check_fn_attributes(flags: i64, pos: i64) {
    if (flags & FN_INLINE) != 0 && (flags & FN_NO_INLINE) != 0 {
        error_at(pos, c"a function cannot be both #[inline] and #[inline(never)]");
    }
}
