// A function's parameter list: `self`, the named parameters with their
// defaults, a C function's `...` (split from items).

use crate::base::{
    SRC, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, intern, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    err_begin, err_end, err_end_soft, err_fmt, err_help, err_jump, err_str, error_at,
};
use crate::front::ast::{
    CONV_INOUT, CONV_NEW, CONV_SINK, NODE_IMPLICIT, NODE_REF, NODE_REF_MUT, NodeKind, child,
    list_begin, list_end, list_push, new_node,
};
use crate::front::conv::{conv_error, rust_spelling, starts_type, strict_at, word_at};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{Amp, Colon, Comma, Ellipsis, Eof, Eq, Ident, Mut, RParen};
use crate::front::parser::{
    advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end, tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::types::{parse_bound, parse_type};

// The parameters of `n` up to `)`; whether they end with `...`.
pub fn parse_params(n: i64, allow_ellipsis: bool, pcx: inout Ctx<Comp>) -> bool {
    let mark = list_begin(pcx);
    var variadic = false;
    while !at(RParen, pcx) && !at(Eof, pcx) {
        if at(Ellipsis, pcx) {
            if !allow_ellipsis {
                error_at(cur_start(pcx), c"only extern functions can be variadic", &pcx);
            }
            advance(&pcx);
            variadic = true;
            eat(Comma, &pcx);
            break;
        }
        list_push(parse_param(&pcx), &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    variadic
}

fn parse_param(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    // (0.27.0) the rust edition's receivers: `&self`, `&mut self`, `self`, `mut self`
    if pcx.edition != 0 && crate::front::rust::rust_at(start, &pcx) {
        let r = crate::front::parser::rust::receiver(start, &pcx);
        if r != 0 {
            return r;
        }
    }
    if at(Amp, pcx) {
        self_param_error(c"expected identifier, got '&'", &pcx);
    }
    // (0.20) the receivers `self`, `inout self`, `sink self`
    // (conventions.md §4)
    if at(Ident, pcx) && sym_text(pcx.toks[pcx.p].value as i64, pcx) == "self"
        && (tok_kind(1, pcx) == Comma || tok_kind(1, pcx) == RParen) {
        return self_receiver(start, 0, &pcx);
    }
    if (at(Tok::Inout, pcx) || at(Tok::Sink, pcx)) && tok_kind(1, pcx) == Ident
        && sym_text(pcx.toks[pcx.p + 1].value as i64, pcx) == "self"
        && (tok_kind(2, pcx) == Comma || tok_kind(2, pcx) == RParen) {
        let conv = if at(Tok::Inout, pcx) { CONV_INOUT } else { CONV_SINK };
        advance(&pcx);
        return self_receiver(start, conv, &pcx);
    }
    // (0.25.3, eval 0.25.2.2) the mode before the name, `inout x: T`:
    // read as `x: inout T` (its tokens put in that order), reported
    // below with the exact edit
    let mode_first = (at(Tok::Inout, pcx) || at(Tok::Sink, pcx) || at(Tok::Let, pcx))
        && tok_kind(1, pcx) == Ident && tok_kind(2, pcx) == Colon;
    let mode_tok = pcx.toks[pcx.p];
    if mode_first {
        pcx.toks[pcx.p] = pcx.toks[pcx.p + 1];
        pcx.toks[pcx.p + 1] = pcx.toks[pcx.p + 2];
        pcx.toks[pcx.p + 2] = mode_tok;
    }
    let mutable = eat(Mut, &pcx);
    let n = new_node(NodeKind::Param, start, 0, &pcx);
    pcx.nodes[n].a = if mutable { expect_binding_name(&pcx) } else { expect_ident(&pcx) };
    if !at(Colon, pcx) && sym_text(pcx.nodes[n].a, pcx) == "self" {
        self_param_error(c"expected ':' after 'self'", &pcx);
    }
    expect(Colon, &pcx);
    var is_sink = false;
    if at(Tok::Sink, pcx) {
        advance(&pcx);
        is_sink = true;
    } else if word_at(pcx.p, "set", pcx) && starts_type(tok_kind(1, pcx)) {
        conv_error(c"conv.set", cur_start(pcx), pcx.toks[pcx.p].end,
            "there is no 'set' convention: a function returns what it makes",
            "return the value (a tuple or a struct for several); 'x: inout T' changes a value the caller has", "", &pcx);
        advance(&pcx);
    }
    pcx.param_type = true;
    pcx.nodes[n].b = parse_type(&pcx);
    pcx.param_type = false;
    pcx.nodes[n].c = (mutable || is_sink) as i64;
    if mode_first {
        mode_order_error(start, mode_tok, pcx.nodes[n].a, pcx.nodes[pcx.nodes[n].b].end, &pcx);
    }
    if is_sink {
        pcx.nodes[n].p |= CONV_NEW | CONV_SINK;
    } else {
        mark_param_conv(n, &pcx);
    }
    if mutable && strict_at(start, &pcx) {
        let name = sym_text(pcx.nodes[n].a, pcx);
        let ty = SRC[pcx.nodes[pcx.nodes[n].b].start..pcx.nodes[pcx.nodes[n].b].end];
        let new = buf_new();
        buf_bytes(new, name);
        buf_bytes(new, ": sink ");
        buf_bytes(new, ty);
        rust_spelling(start, pcx.nodes[pcx.nodes[n].b].end,
            "a parameter the callee changes is taken 'sink' (its own copy)", buf_slice(new), &pcx);
    } else if !mutable && !is_sink && strict_at(start, &pcx) && (pcx.nodes[n].p & CONV_NEW) == 0 {
        // (unwritten: let, the default, in a file read in 0.20's spelling)
        pcx.nodes[n].p |= CONV_NEW;
    }
    if eat(Eq, &pcx) {
        // A default (0.15): checked by check_param_defaults
        pcx.nodes[n].h = parse_expr(&pcx);
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// (0.25.3, eval 0.25.2.2) `conv.mode_order`: a parameter's mode written
// before its name (`inout x: i64`, Rust's `mut x` order), SRC[start..end):
// the mode goes after the colon, `x: inout i64`; `let`, the default, is
// left out.
fn mode_order_error(start: i64, mode: crate::front::lexer::Token, name: i64, end: i64,
    pcx: inout Ctx<Comp>) {
    let (text, word) = (SRC[start..end], SRC[mode.start..mode.end]);
    var colon = 0;
    while colon < text.len as i64 && text[colon] != ':' {
        colon += 1;
    }
    var t = colon + 1;
    while t < text.len as i64 && (text[t] == ' ' || text[t] == '\t' || text[t] == '\n') {
        t += 1;
    }
    let new = buf_new();
    buf_bytes(new, crate::base::sym_text(name, pcx));
    buf_bytes(new, ": ");
    if mode.kind != Tok::Let {
        buf_bytes(new, word);
        buf_bytes(new, " ");
    }
    buf_bytes(new, text[t..]);
    let msg = buf_new();
    buf_bytes(msg, "a parameter's mode goes after the colon: '");
    buf_bytes(msg, buf_slice(new));
    buf_bytes(msg, "', not '");
    buf_bytes(msg, text);
    buf_bytes(msg, "'");
    conv_error(c"conv.mode_order", start, end, buf_slice(msg),
        if mode.kind == Tok::Let {
            "let, the default, is not written: 'x: T' reads x; 'x: inout T' changes the caller's (called 'f(&v)'), 'x: sink T' takes it"
        } else {
            "'x: T' reads x (let, the default); 'x: inout T' changes the caller's (called 'f(&v)'), 'x: sink T' takes it"
        }, buf_slice(new), &pcx);
}

// (0.20) A Param written with a convention: its type node is an access
// (`x: let T`, `x: inout T`, CONV_NEW on the TyPtr or TySlice the type
// parser made), so the Param is flagged as such (front/conv: param_conv).
pub fn mark_param_conv(n: i64, pcx: inout Ctx<Comp>) {
    let t = pcx.nodes[n].b;
    if t <= 0 || (pcx.nodes[t].p & CONV_NEW) == 0 {
        return;
    }
    pcx.nodes[n].p |= CONV_NEW;
    if (pcx.nodes[t].p & NODE_REF_MUT) != 0 {
        pcx.nodes[n].p |= CONV_INOUT;
    }
}

// (0.20) `self` (let), `inout self` (conv CONV_INOUT), `sink self`
// (CONV_SINK), at `self`: a Param whose type is `let Self` (until T1, the
// reference `&Self`), `inout Self` (`&mut Self`), or Self, mutable.
fn self_receiver(start: i64, conv: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Param, start, 0, &pcx);
    let name_start = cur_start(pcx);
    pcx.nodes[n].a = expect_ident(&pcx);
    let name = new_node(NodeKind::TyName, name_start, prev_end(pcx), &pcx);
    pcx.nodes[name].a = intern_c(c"Self", &pcx);
    if conv == CONV_SINK {
        pcx.nodes[n].b = name;
        pcx.nodes[n].c = 1;
        pcx.nodes[n].p |= CONV_NEW | CONV_SINK;
    } else {
        let t = new_node(NodeKind::TyPtr, start, prev_end(pcx), &pcx);
        pcx.nodes[t].a = name;
        pcx.nodes[t].p |= CONV_NEW | NODE_REF;
        if conv == CONV_INOUT {
            pcx.nodes[t].p |= NODE_REF_MUT;
            pcx.nodes[n].p |= CONV_INOUT;
        }
        pcx.nodes[n].b = t;
        pcx.nodes[n].p |= CONV_NEW;
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// `&self`, `&mut self`, `self` without a type (0.14): what vole writes.
// (0.15) Rust's `fmt(&self, f: &mut Formatter)`: Display's and Debug's.
fn self_param_error(message: *u8, pcx: inout Ctx<Comp>) -> ! {
    err_begin(cur_start(pcx), &pcx);
    err_str(message, pcx);
    var formatter = false;
    var i = pcx.p;
    while i < pcx.toks.len() as i64 && i < pcx.p + 16 && pcx.toks[i].kind != Tok::RParen {
        if pcx.toks[i].kind == Tok::Ident
            && sym_text(pcx.toks[i].value as i64, pcx) == "Formatter" {
            formatter = true;
        }
        i += 1;
    }
    if formatter {
        err_help(c"Display and Debug in vole: `fn fmt(self, f: inout std::Fmt)` and `fn fmt_debug(self, f: inout std::Fmt)` (0.19: `self: &Self, f: &mut std::Fmt`), with no result; write with `f.write(\"({}, {})\", self.x, self.y)`, `f.str(s)`, `f.debug(&x)`", pcx);
    } else {
        err_help(c"`self` for `&self`, `inout self` for `&mut self`, `sink self` for `self` (0.19: `self: &Self`, `self: &mut Self`, `self: Self`)", pcx);
    }
    err_end(&pcx)
}

// At `impl` in a type.
pub fn parse_impl_type(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    advance(&pcx);
    let bounds = new_node(NodeKind::Generics, cur_start(pcx), 0, &pcx);
    let mark = list_begin(pcx);
    loop {
        if !crate::front::parser::rust::skip_lifetime_bound(&pcx) {
            list_push(parse_bound(&pcx), &pcx);
        }
        if !eat(Tok::Plus, &pcx) {
            break;
        }
    }
    list_end(bounds, mark, &pcx);
    pcx.nodes[bounds].end = prev_end(pcx);
    if pcx.impl_owner == 0 || !pcx.param_type {
        impl_position_error(start, prev_end(pcx), &pcx);
    }
    let param = new_node(NodeKind::TyName, start, prev_end(pcx), &pcx);
    pcx.nodes[param].a = impl_param_name(start, prev_end(pcx), &pcx);
    pcx.nodes[param].h = bounds;
    pcx.nodes[param].p |= NODE_IMPLICIT;
    pcx.impl_hidden.push(param);
    let t = new_node(NodeKind::TyName, start, prev_end(pcx), &pcx);
    pcx.nodes[t].a = pcx.nodes[param].a;
    t
}

// `impl Trait` outside a parameter's type: error type.impl-position.
fn impl_position_error(start: i64, end: i64, pcx: inout Ctx<Comp>) -> ! {
    if pcx.edition != 0 && crate::front::rust::rust_at(start, &pcx) {
        // (0.27.0: `-> impl Trait`, the rust edition's from 0.27.2)
        crate::front::rust::later(start, end, "impl_trait_return", "0.27.2", &pcx);
        err_jump(&pcx);
    }
    let saved = pcx.err_kind;
    pcx.err_kind = c"type.impl-position";
    err_begin(start, &pcx);
    err_fmt(format_args("'{}' is a parameter's type only, in this release", SRC[start..end]), pcx);
    err_help(c"name a type parameter instead, 'fn f<T: Display>() -> T'; 'impl Trait' in a result, a field or a 'let' comes with the rust edition", pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
    err_jump(&pcx)
}

// The hidden parameter's name: `impl ` and its bounds' text with each run
// of blanks one space; `impl Display #2` for the second of the same text.
fn impl_param_name(start: i64, end: i64, pcx: inout Ctx<Comp>) -> i64 {
    let text = SRC[start..end];
    let b = buf_new();
    var blank = false;
    for i in 0..text.len {
        let c = text[i];
        if c == ' ' || c == '\t' || c == '\n' || c == '\r' {
            blank = true;
            continue;
        }
        if blank && buf_slice(b).len > 0 {
            buf_bytes(b, " ");
        }
        blank = false;
        buf_byte(b, c);
    }
    let base = intern(buf_slice(b), &pcx);
    var k = 1;
    loop {
        var sym = base;
        if k > 1 {
            let named = buf_new();
            buf_fmt(named, format_args("{} #{k}", sym_text(base, pcx)));
            sym = intern(buf_slice(named), &pcx);
        }
        var taken = false;
        for i in pcx.impl_mark..pcx.impl_hidden.count {
            if pcx.nodes[pcx.impl_hidden.get(i)].a == sym {
                taken = true;
            }
        }
        if !taken {
            return sym;
        }
        k += 1;
    }
}

// Before function n's parameters: IMPL_OWNER is n (the previous owner is
// returned, for end_impl_params).
pub fn begin_impl_params(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let saved = pcx.impl_owner;
    pcx.impl_owner = n;
    pcx.impl_mark = pcx.impl_hidden.count;
    saved
}

// After them: the hidden parameters met go after the written ones in n's
// generics.
pub fn end_impl_params(n: i64, saved: i64, pcx: inout Ctx<Comp>) {
    pcx.impl_owner = saved;
    if pcx.impl_hidden.count == pcx.impl_mark {
        return;
    }
    let old = pcx.nodes[n].g;
    let first = pcx.impl_hidden.get(pcx.impl_mark);
    let g = new_node(NodeKind::Generics, if old != 0 { pcx.nodes[old].start }
        else { pcx.nodes[first].start },
        if old != 0 { pcx.nodes[old].end } else { pcx.nodes[first].end }, &pcx);
    let mark = list_begin(pcx);
    if old != 0 {
        for i in 0..pcx.nodes[old].count {
            list_push(child(old, i, pcx), &pcx);
        }
        pcx.nodes[g].a = pcx.nodes[old].a;
    }
    for i in pcx.impl_mark..pcx.impl_hidden.count {
        list_push(pcx.impl_hidden.get(i), &pcx);
    }
    list_end(g, mark, &pcx);
    pcx.impl_hidden.count = pcx.impl_mark;
    pcx.nodes[n].g = g;
}

// How many of the type parameters `params` (a Generics node, 0 for none)
// are hidden ones, `impl Trait` (always the last).
pub fn hidden_param_count(params: i64, pcx: Ctx<Comp>) -> i64 {
    var n = 0;
    if params != 0 {
        for i in 0..pcx.nodes[params].count {
            if (pcx.nodes[child(params, i, pcx)].p & NODE_IMPLICIT) != 0 {
                n += 1;
            }
        }
    }
    n
}

// At `where` (a reserved word, read as a keyword after a signature).
pub fn at_where(pcx: Ctx<Comp>) -> bool {
    if !at(Tok::Reserved, pcx) {
        return false;
    }
    // UNSAFE: TOKS is the lexer's raw token array (no safe view of it in the parser)
    // SAFETY: P is a token of the array: the parser stops at its Eof, which is last
    let sym = unsafe { pcx.toks[pcx.p].value } as i64;
    sym_text(sym, pcx) == "where"
}

// After a syntax error, at the next item: no function's parameters or
// impl block are being parsed.
pub fn reset_item_state(pcx: inout Ctx<Comp>) {
    pcx.impl_owner = 0;
    pcx.impl_hidden.count = 0;
    pcx.where_outer = 0;
    pcx.param_type = false;
}

// (0.26.2) `where P: B + C, Q: D` after an item's signature (a function's
// result type, a struct's, enum's or trait's generics, an impl's type):
// each bound joins those of its type parameter in `generics` (or in
// `outer`, an impl's, for one of its functions), as if written inline.
// Any other left side is where.unsupported.
pub fn parse_where(generics: i64, outer: i64, pcx: inout Ctx<Comp>) {
    if !at_where(pcx) {
        return;
    }
    advance(&pcx);
    while at_predicate(pcx) {
        // (0.27.0: `'a: 'b`, the rust edition's)
        if crate::front::parser::rust::skip_lifetime_predicate(&pcx) {
            if !eat(Comma, &pcx) {
                break;
            }
            continue;
        }
        let start = cur_start(pcx);
        let left = parse_type(&pcx);
        let left_end = prev_end(pcx);
        expect(Colon, &pcx);
        let bstart = cur_start(pcx);
        let mark = list_begin(pcx);
        loop {
            if !crate::front::parser::rust::skip_lifetime_bound(&pcx) {
                list_push(parse_bound(&pcx), &pcx);
            }
            if !eat(Tok::Plus, &pcx) {
                break;
            }
        }
        let param = where_param(left, generics, outer, pcx);
        if param == 0 {
            pcx.scratch.count = mark;
            where_unsupported(start, left_end, prev_end(pcx), &pcx);
        } else {
            join_bounds(param, mark, bstart, &pcx);
        }
        if !eat(Comma, &pcx) {
            break;
        }
    }
}

// At a `where` predicate's left side (a type), not at the body, a `;` or
// a contract clause (`requires c`).
fn at_predicate(pcx: Ctx<Comp>) -> bool {
    if at(Ident, pcx) {
        let next = tok_kind(1, pcx);
        return next == Colon || next == Tok::ColonColon || next == Tok::Lt;
    }
    at(Tok::Lifetime, pcx) || at(Tok::LParen, pcx) || at(Tok::LBracket, pcx) || at(Amp, pcx)
        || at(Tok::Star, pcx)
}

// The type parameter `left` names (a TyName of one segment and no type
// arguments), 0 when it is none of them.
fn where_param(left: i64, generics: i64, outer: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.nodes[left].kind != NodeKind::TyName || pcx.nodes[left].count != 0
        || pcx.nodes[left].g != 0 {
        return 0;
    }
    for g in [generics, outer] {
        if g != 0 {
            for i in 0..pcx.nodes[g].count {
                let p = child(g, i, pcx);
                if pcx.nodes[p].a == pcx.nodes[left].a && (pcx.nodes[p].p & NODE_IMPLICIT) == 0 {
                    return p;
                }
            }
        }
    }
    0
}

// The bounds SCRATCH[mark..] after those `param` has (its h).
fn join_bounds(param: i64, mark: i64, pos: i64, pcx: inout Ctx<Comp>) {
    let end = pcx.scratch.count;
    let old = pcx.nodes[param].h;
    if old != 0 {
        for i in 0..pcx.nodes[old].count {
            list_push(child(old, i, pcx), &pcx);
        }
    }
    for i in mark..end {
        list_push(pcx.scratch.get(i), &pcx);
    }
    let count = pcx.scratch.count - end;
    for i in 0..count {
        pcx.scratch.set(mark + i, pcx.scratch.get(end + i));
    }
    pcx.scratch.count = mark + count;
    let n = new_node(NodeKind::Generics, if old != 0 { pcx.nodes[old].start } else { pos }, 0,
        &pcx);
    list_end(n, mark, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    pcx.nodes[param].h = n;
}

// error where.unsupported, soft: the predicate is left out.
fn where_unsupported(start: i64, left_end: i64, end: i64, pcx: inout Ctx<Comp>) {
    if pcx.edition != 0 && crate::front::rust::rust_at(start, &pcx) {
        // (0.27.0: a bound on any type, the rust edition's from 0.27.2)
        crate::front::rust::later(start, end, "where_bound", "0.27.2", &pcx);
        return;
    }
    let saved = pcx.err_kind;
    pcx.err_kind = c"where.unsupported";
    err_begin(start, &pcx);
    err_fmt(
        format_args("'{}': a 'where' bound is on a type parameter of the item, and '{}' is not one",
            SRC[start..end], SRC[start..left_end]), pcx);
    err_help(c"a bound on a type that is not a parameter comes with the rust edition; bound a parameter instead: 'I: Iterator<Item = X>, X: Display'", pcx);
    err_end_soft(&pcx);
    pcx.err_kind = saved;
}
