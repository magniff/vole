// A function's parameter list: `self`, the named parameters with their
// defaults, a C function's `...` (split from items).

use crate::base::{
    buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, get_src, intern, intern_c, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_end_soft, err_help, err_jump, err_str, error_at};
use crate::front::ast::{
    CONV_INOUT, CONV_NEW, CONV_SINK, NODE_IMPLICIT, NODE_REF, NODE_REF_MUT, NodeKind, TY_OPAQUE,
    child, list_begin, list_end, list_push, new_node,
};
use crate::front::conv::{conv_error, starts_type, word_at};
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{Amp, Colon, Comma, Ellipsis, Eof, Eq, Ident, Mut, RParen};
use crate::front::parser::{
    advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end, tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::types::{parse_bound, parse_type};

// The parameters of `n` up to `)`; whether they end with `...`.
pub fn parse_params(n: i64, allow_ellipsis: bool, pcx: &mut Ctx<Comp>) -> bool {
    let mark = list_begin(pcx);
    let mut variadic = false;
    while !at(RParen, pcx) && !at(Eof, pcx) {
        if at(Ellipsis, pcx) {
            if !allow_ellipsis {
                error_at(cur_start(pcx), c"only extern functions can be variadic", pcx);
            }
            advance(pcx);
            variadic = true;
            eat(Comma, pcx);
            break;
        }
        list_push(parse_param(pcx), pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    variadic
}

fn parse_param(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    // (0.27.0) the rust edition's receivers: `&self`, `&mut self`, `self`, `mut self`
    let r = crate::front::parser::rust::receiver(start, pcx);
    if r != 0 {
        return r;
    }
    if at(Amp, pcx) {
        self_param_error(c"expected identifier, got '&'", pcx);
    }
    // (0.20) the receivers `self`, `inout self`, `sink self`
    // (conventions.md §4)
    if at(Ident, pcx) && sym_text(pcx.toks[pcx.p as usize].value as i64, pcx) == b"self"
        && (tok_kind(1, pcx) == Comma || tok_kind(1, pcx) == RParen) {
        return self_receiver(start, 0, pcx);
    }
    // (0.25.3, eval 0.25.2.2) the mode before the name, `inout x: T`:
    // read as `x: inout T` (its tokens put in that order), reported
    // below with the exact edit
    let mode_first = (at(Tok::Let, pcx))
        && tok_kind(1, pcx) == Ident && tok_kind(2, pcx) == Colon;
    let mode_tok = pcx.toks[pcx.p as usize];
    if mode_first {
        { let at_ix = pcx.p as usize; pcx.toks[at_ix] = pcx.toks[(pcx.p + 1) as usize] };
        { let at_ix = (pcx.p + 1) as usize; pcx.toks[at_ix] = pcx.toks[(pcx.p + 2) as usize] };
        { let at_ix = (pcx.p + 2) as usize; pcx.toks[at_ix] = mode_tok };
    }
    let mutable = eat(Mut, pcx);
    let n = new_node(NodeKind::Param, start, 0, pcx);
    pcx.nodes[n as usize].a = if mutable { expect_binding_name(pcx) } else { expect_ident(pcx) };
    if !at(Colon, pcx) && sym_text(pcx.nodes[n as usize].a, pcx) == b"self" {
        self_param_error(c"expected ':' after 'self'", pcx);
    }
    expect(Colon, pcx);
    let mut is_sink = false;
    if word_at(pcx.p, b"set", pcx) && starts_type(tok_kind(1, pcx)) {
        conv_error(c"conv.set", cur_start(pcx), pcx.toks[pcx.p as usize].end,
            b"there is no 'set' parameter: a function returns what it makes",
            b"return the value (a tuple or a struct for several); 'x: &mut T' changes a value the caller has", b"", pcx);
        advance(pcx);
    }
    pcx.param_type = true;
    pcx.nodes[n as usize].b = parse_type(pcx);
    pcx.param_type = false;
    pcx.nodes[n as usize].c = (mutable || is_sink) as i64;
    if mode_first {
        mode_order_error(start, mode_tok, pcx.nodes[n as usize].a,
            pcx.nodes[pcx.nodes[n as usize].b as usize].end, pcx);
    }
    if is_sink {
        pcx.nodes[n as usize].p |= CONV_NEW | CONV_SINK;
    } else {
        mark_param_conv(n, pcx);
    }
    let before_eq = prev_end(pcx);
    let eq_at = pcx.toks[pcx.p as usize].start;
    if eat(Eq, pcx) {
        // A default (0.15): checked by check_param_defaults
        pcx.nodes[n as usize].h = parse_expr(pcx);
        // RULE: F33.1 (0.28.0: the rust edition has no default value: the
        // error, with the fix that removes it; the parameter is read
        // without one, so each call that left it out is named too)
        let saved_kind = pcx.err_kind;
        pcx.err_kind = c"syntax.default-arg";
        crate::base::diag::err_begin(eq_at, pcx);
        crate::base::diag::err_str(
            c"a parameter has no default value; pass it at each call", pcx);
        crate::base::diag::err_help(
            c"remove the `= value` and give the argument where the function is called (a named argument, `f(1, b: 3)`, is still written)",
            pcx);
        crate::base::diag::err_fix(before_eq, prev_end(pcx), &get_src()[0..0], pcx);
        crate::base::diag::err_end_soft(pcx);
        pcx.err_kind = saved_kind;
        pcx.nodes[n as usize].h = 0;
    }
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// (0.25.3, eval 0.25.2.2) `conv.mode_order`: a parameter's mode written
// before its name (`inout x: i64`, Rust's `mut x` order), SRC[start..end):
// the mode goes after the colon, `x: inout i64`; `let`, the default, is
// left out.
fn mode_order_error(start: i64, mode: crate::front::lexer::Token, name: i64, end: i64,
    pcx: &mut Ctx<Comp>) {
    let (text, word) = (&get_src()[start as usize..end as usize],
        &get_src()[mode.start as usize..mode.end as usize]);
    let mut colon: i64 = 0;
    while colon < text.len() as i64 && text[colon as usize] != b':' {
        colon += 1;
    }
    let mut t = colon + 1;
    while t < text.len() as i64
        && (text[t as usize] == b' ' || text[t as usize] == b'\t' || text[t as usize] == b'\n') {
        t += 1;
    }
    let new = buf_new();
    buf_bytes(new, crate::base::sym_text(name, pcx));
    buf_bytes(new, b": ");
    if mode.kind != Tok::Let {
        buf_bytes(new, word);
        buf_bytes(new, b" ");
    }
    buf_bytes(new, &text[t as usize..]);
    let msg = buf_new();
    buf_bytes(msg, b"a parameter is written '");
    buf_bytes(msg, buf_slice(new));
    buf_bytes(msg, b"', not '");
    buf_bytes(msg, text);
    buf_bytes(msg, b"'");
    conv_error(c"conv.mode_order", start, end, buf_slice(msg),
        if mode.kind == Tok::Let {
            b"a parameter has no `let`: 'x: T' takes the value, 'x: &T' borrows it, 'x: &mut T' may change the caller's (called 'f(&mut v)')"
        } else {
            b"'x: T' takes the value, 'x: &T' borrows it, 'x: &mut T' may change the caller's (called 'f(&mut v)')"
        }, buf_slice(new), pcx);
}

// (0.20) A Param written with a convention: its type node is an access
// (`x: let T`, `x: inout T`, CONV_NEW on the TyPtr or TySlice the type
// parser made), so the Param is flagged as such (front/conv: param_conv).
pub fn mark_param_conv(n: i64, pcx: &mut Ctx<Comp>) {
    let t = pcx.nodes[n as usize].b;
    if t <= 0 || (pcx.nodes[t as usize].p & CONV_NEW) == 0 {
        return;
    }
    pcx.nodes[n as usize].p |= CONV_NEW;
    if (pcx.nodes[t as usize].p & NODE_REF_MUT) != 0 {
        pcx.nodes[n as usize].p |= CONV_INOUT;
    }
}

// (0.20) `self` (let), `inout self` (conv CONV_INOUT), `sink self`
// (CONV_SINK), at `self`: a Param whose type is `let Self` (until T1, the
// reference `&Self`), `inout Self` (`&mut Self`), or Self, mutable.
fn self_receiver(start: i64, conv: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Param, start, 0, pcx);
    let name_start = cur_start(pcx);
    pcx.nodes[n as usize].a = expect_ident(pcx);
    let name = new_node(NodeKind::TyName, name_start, prev_end(pcx), pcx);
    pcx.nodes[name as usize].a = intern_c(c"Self", pcx);
    if conv == CONV_SINK {
        pcx.nodes[n as usize].b = name;
        pcx.nodes[n as usize].c = 1;
        pcx.nodes[n as usize].p |= CONV_NEW | CONV_SINK;
    } else {
        let t = new_node(NodeKind::TyPtr, start, prev_end(pcx), pcx);
        pcx.nodes[t as usize].a = name;
        pcx.nodes[t as usize].p |= CONV_NEW | NODE_REF;
        if conv == CONV_INOUT {
            pcx.nodes[t as usize].p |= NODE_REF_MUT;
            pcx.nodes[n as usize].p |= CONV_INOUT;
        }
        pcx.nodes[n as usize].b = t;
        pcx.nodes[n as usize].p |= CONV_NEW;
    }
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// `&self`, `&mut self`, `self` without a type (0.14): what vole writes.
// (0.15) Rust's `fmt(&self, f: &mut Formatter)`: Display's and Debug's.
fn self_param_error(message: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    err_begin(cur_start(pcx), pcx);
    err_str(message, pcx);
    let mut formatter = false;
    let mut i = pcx.p;
    while i < pcx.toks.len() as i64 && i < pcx.p + 16 && pcx.toks[i as usize].kind != Tok::RParen {
        if pcx.toks[i as usize].kind == Tok::Ident
            && sym_text(pcx.toks[i as usize].value as i64, pcx) == b"Formatter" {
            formatter = true;
        }
        i += 1;
    }
    if formatter {
        err_help(c"Display and Debug are Rust's: `fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result`, written with `write(f, \"({}, {})\", self.x, self.y)` or `f.write_str(s)`", pcx);
    } else {
        err_help(c"a receiver is `&self`, `&mut self` or `self` (or typed: `self: &Self`, `self: &mut Self`, `self: Self`), then a comma", pcx);
    }
    err_end(pcx)
}

// `impl` and its bounds `Tr + ..` (a Generics node).
fn impl_bounds(pcx: &mut Ctx<Comp>) -> i64 {
    advance(pcx);
    let bounds = new_node(NodeKind::Generics, cur_start(pcx), 0, pcx);
    let mark = list_begin(pcx);
    loop {
        if !crate::front::parser::rust::skip_lifetime_bound(pcx) {
            list_push(parse_bound(pcx), pcx);
        }
        if !eat(Tok::Plus, pcx) {
            break;
        }
    }
    list_end(bounds, mark, pcx);
    pcx.nodes[bounds as usize].end = prev_end(pcx);
    bounds
}

// RULE: D21.1, D21.4 (0.27.2.1) A function's result type after `->`: `impl
// Tr + ..` at its top in a rust-edition file is the opaque result, a TyName
// with TY_OPAQUE (a = its text, h = the bounds; front/opaque.vl); an `impl`
// anywhere else in it is type.impl-position's (edition.later).
pub fn parse_fn_result(pcx: &mut Ctx<Comp>) -> i64 {
    if !eat(Tok::Arrow, pcx) {
        return 0;
    }
    let start = cur_start(pcx);
    if !(at(Tok::Impl, pcx)) {
        return parse_type(pcx);
    }
    let bounds = impl_bounds(pcx);
    let t = new_node(NodeKind::TyName, start, prev_end(pcx), pcx);
    pcx.nodes[t as usize].a = impl_param_name(start, prev_end(pcx), pcx);
    pcx.nodes[t as usize].h = bounds;
    pcx.nodes[t as usize].p |= TY_OPAQUE;
    t
}

// At `impl` in a type.
pub fn parse_impl_type(start: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let bounds = impl_bounds(pcx);
    if pcx.impl_owner == 0 || !pcx.param_type {
        impl_position_error(start, prev_end(pcx), pcx);
    }
    let param = new_node(NodeKind::TyName, start, prev_end(pcx), pcx);
    pcx.nodes[param as usize].a = impl_param_name(start, prev_end(pcx), pcx);
    pcx.nodes[param as usize].h = bounds;
    pcx.nodes[param as usize].p |= NODE_IMPLICIT;
    pcx.impl_hidden.push(param);
    let t = new_node(NodeKind::TyName, start, prev_end(pcx), pcx);
    pcx.nodes[t as usize].a = pcx.nodes[param as usize].a;
    t
}

// `impl Trait` outside a parameter's type: error type.impl-position.
fn impl_position_error(start: i64, end: i64, pcx: &mut Ctx<Comp>) -> ! {
    // RULE: D21.4 (0.27.2.1: `-> impl Tr` at the top of a function's
    // result is opaque, parse_fn_result; `Option<impl Tr>`, a trait
    // method's, a `let`'s or a field's comes later)
    crate::front::rust::later(start, end, "impl_trait_nested", "0.29", pcx);
    err_jump(pcx)
}

// The hidden parameter's name: `impl ` and its bounds' text with each run
// of blanks one space; `impl Display #2` for the second of the same text.
fn impl_param_name(start: i64, end: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let text = &get_src()[start as usize..end as usize];
    let b = buf_new();
    let mut blank = false;
    for i in 0..text.len() {
        let c = text[i];
        if c == b' ' || c == b'\t' || c == b'\n' || c == b'\r' {
            blank = true;
            continue;
        }
        if blank && buf_slice(b).len() > 0 {
            buf_bytes(b, b" ");
        }
        blank = false;
        buf_byte(b, c);
    }
    let base = intern(buf_slice(b), pcx);
    let mut k: i64 = 1;
    loop {
        let mut sym = base;
        if k > 1 {
            let named = buf_new();
            buf_fmt(named, format_args("{} #{k}", str::from_utf8(sym_text(base, pcx)).unwrap()));
            sym = intern(buf_slice(named), pcx);
        }
        let mut taken = false;
        for i in pcx.impl_mark..pcx.impl_hidden.count {
            if pcx.nodes[pcx.impl_hidden.get(i) as usize].a == sym {
                taken = true;
            }
        }
        if !taken {
            return sym;
        }
        k += 1;
    }
}

// Before function n's parameters: IMPL_OWNER is n (the previous owner is
// returned, for end_impl_params).
pub fn begin_impl_params(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved = pcx.impl_owner;
    pcx.impl_owner = n;
    pcx.impl_mark = pcx.impl_hidden.count;
    saved
}

// After them: the hidden parameters met go after the written ones in n's
// generics.
pub fn end_impl_params(n: i64, saved: i64, pcx: &mut Ctx<Comp>) {
    pcx.impl_owner = saved;
    if pcx.impl_hidden.count == pcx.impl_mark {
        return;
    }
    let old = pcx.nodes[n as usize].g;
    let first = pcx.impl_hidden.get(pcx.impl_mark);
    let g = new_node(NodeKind::Generics, if old != 0 { pcx.nodes[old as usize].start }
        else { pcx.nodes[first as usize].start },
        if old != 0 { pcx.nodes[old as usize].end } else { pcx.nodes[first as usize].end }, pcx);
    let mark = list_begin(pcx);
    if old != 0 {
        for i in 0..pcx.nodes[old as usize].count {
            list_push(child(old, i, pcx), pcx);
        }
        pcx.nodes[g as usize].a = pcx.nodes[old as usize].a;
    }
    for i in pcx.impl_mark..pcx.impl_hidden.count {
        list_push(pcx.impl_hidden.get(i), pcx);
    }
    list_end(g, mark, pcx);
    pcx.impl_hidden.count = pcx.impl_mark;
    pcx.nodes[n as usize].g = g;
}

// How many of the type parameters `params` (a Generics node, 0 for none)
// are hidden ones, `impl Trait` (always the last).
pub fn hidden_param_count(params: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut n: i64 = 0;
    if params != 0 {
        for i in 0..pcx.nodes[params as usize].count {
            if (pcx.nodes[child(params, i, pcx) as usize].p & NODE_IMPLICIT) != 0 {
                n += 1;
            }
        }
    }
    n
}

// At `where` (a reserved word, read as a keyword after a signature).
pub fn at_where(pcx: &Ctx<Comp>) -> bool {
    if !at(Tok::Reserved, pcx) {
        return false;
    }
    let sym = (pcx.toks[pcx.p as usize].value) as i64;
    sym_text(sym, pcx) == b"where"
}

// After a syntax error, at the next item: no function's parameters or
// impl block are being parsed.
pub fn reset_item_state(pcx: &mut Ctx<Comp>) {
    pcx.impl_owner = 0;
    pcx.impl_hidden.count = 0;
    pcx.where_outer = 0;
    pcx.param_type = false;
}

// (0.26.2) `where P: B + C, Q: D` after an item's signature (a function's
// result type, a struct's, enum's or trait's generics, an impl's type):
// each bound joins those of its type parameter in `generics` (or in
// `outer`, an impl's, for one of its functions), as if written inline.
// Any other left side is where.unsupported.
pub fn parse_where(generics: i64, outer: i64, pcx: &mut Ctx<Comp>) {
    pcx.lt_where = 0;
    if !at_where(pcx) {
        return;
    }
    advance(pcx);
    // (0.27.1: the lifetime predicates kept, for the region checker's
    // declared bounds, docs/design/borrowck.md D4.5)
    let lifetimes = crate::front::parser::rust::lifetimes_begin(pcx);
    while at_predicate(pcx) {
        // (0.27.0: `'a: 'b`, the rust edition's)
        if at(Tok::Lifetime, pcx) && tok_kind(1, pcx) == Colon
            && crate::front::parser::rust::take_lifetime(true, pcx) {
            if !eat(Comma, pcx) {
                break;
            }
            continue;
        }
        let start = cur_start(pcx);
        let left = parse_type(pcx);
        let left_end = prev_end(pcx);
        expect(Colon, pcx);
        let bstart = cur_start(pcx);
        let mark = list_begin(pcx);
        let subject = where_param(left, generics, outer, pcx);
        loop {
            if !crate::front::parser::rust::take_outlives_bound(subject, pcx) {
                list_push(parse_bound(pcx), pcx);
            }
            if !eat(Tok::Plus, pcx) {
                break;
            }
        }
        let had = pcx.scratch.count;
        if crate::front::parser::rust::drop_sized(mark, start, pcx) && pcx.scratch.count == mark {
            // (0.27.0: `Self: Sized`, which says nothing)
            // RULE: F12.4 (0.27.6: but a trait function with it is not one
            // of an impl for an unsized Self)
            let owner = pcx.where_owner;
            if had > mark && owner > 0 && pcx.nodes[owner as usize].kind == NodeKind::Fn
                && pcx.nodes[left as usize].kind == NodeKind::TyName
                && pcx.nodes[left as usize].count == 0
                && crate::base::sym_text(pcx.nodes[left as usize].a, pcx) == b"Self" {
                pcx.nodes[owner as usize].p |= crate::front::ast::FN_SELF_SIZED;
            }
            if !eat(Comma, pcx) {
                break;
            }
            continue;
        }
        let param = where_param(left, generics, outer, pcx);
        if param == 0 {
            // RULE: F10.1 (a bound on `Self`, a projection or any other
            // type: a predicate of the item, checked where it is used)
            let h = new_node(NodeKind::Generics, bstart, 0, pcx);
            list_end(h, mark, pcx);
            pcx.nodes[h as usize].end = prev_end(pcx);
            let owner = pcx.where_owner;
            crate::front::traits::wp_push(crate::front::traits::WherePred {
                owner: owner, subject: left, bounds: h,
            }, pcx);
        } else if param == 0 {
            pcx.scratch.count = mark;
            where_unsupported(start, left_end, prev_end(pcx), pcx);
        } else {
            join_bounds(param, mark, bstart, pcx);
        }
        if !eat(Comma, pcx) {
            break;
        }
    }
    crate::front::parser::rust::lifetimes_end(lifetimes, pcx);
    pcx.lt_where = pcx.lt_last;
    pcx.lt_last = 0;
}

// At a `where` predicate's left side (a type), not at the body, a `;` or
// a contract clause (`requires c`).
fn at_predicate(pcx: &Ctx<Comp>) -> bool {
    if at(Ident, pcx) {
        let next = tok_kind(1, pcx);
        return next == Colon || next == Tok::ColonColon || next == Tok::Lt;
    }
    at(Tok::Lifetime, pcx) || at(Tok::LParen, pcx) || at(Tok::LBracket, pcx) || at(Amp, pcx)
        || at(Tok::Star, pcx)
}

// The type parameter `left` names (a TyName of one segment and no type
// arguments), 0 when it is none of them.
fn where_param(left: i64, generics: i64, outer: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[left as usize].kind != NodeKind::TyName || pcx.nodes[left as usize].count != 0
        || pcx.nodes[left as usize].g != 0 {
        return 0;
    }
    for g in [generics, outer] {
        if g != 0 {
            for i in 0..pcx.nodes[g as usize].count {
                let p = child(g, i, pcx);
                if pcx.nodes[p as usize].a == pcx.nodes[left as usize].a
                    && (pcx.nodes[p as usize].p & NODE_IMPLICIT) == 0 {
                    return p;
                }
            }
        }
    }
    0
}

// The bounds SCRATCH[mark..] after those `param` has (its h).
fn join_bounds(param: i64, mark: i64, pos: i64, pcx: &mut Ctx<Comp>) {
    let end = pcx.scratch.count;
    let old = pcx.nodes[param as usize].h;
    if old != 0 {
        for i in 0..pcx.nodes[old as usize].count {
            list_push(child(old, i, pcx), pcx);
        }
    }
    for i in mark..end {
        list_push(pcx.scratch.get(i), pcx);
    }
    let count = pcx.scratch.count - end;
    for i in 0..count {
        pcx.scratch.set(mark + i, pcx.scratch.get(end + i));
    }
    pcx.scratch.count = mark + count;
    let n = new_node(NodeKind::Generics, if old != 0 { pcx.nodes[old as usize].start } else { pos },
        0, pcx);
    list_end(n, mark, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    pcx.nodes[param as usize].h = n;
}

// error where.unsupported, soft: the predicate is left out.
fn where_unsupported(start: i64, left_end: i64, end: i64, pcx: &mut Ctx<Comp>) {
    // (0.27.0: a bound on any type, the rust edition's from 0.27.2)
    crate::front::rust::later(start, end, "where_bound", "0.27.2", pcx);
}
