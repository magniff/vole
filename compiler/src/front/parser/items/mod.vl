// Items: functions, structs, enums, constants, statics, type aliases,
// impl blocks and traits with their generic parameters, `use` and
// `import` lines, and the attributes before an item (`#[repr]`,
// `#[inline]`, `#[cold]`).

pub mod params;
pub mod attrs;
// (0.26.0) `embed wgsl NAME { .. }`
pub mod embed;

use crate::arch::note_intrinsic_node;
use crate::base::{buf_fmt, buf_new, buf_slice, intern, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_tool_command, err_begin, err_end, err_help, err_help_fmt, err_str, error_at,
    report_error_tries,
};
use crate::front::ast::{
    FN_BODY_FAILED, FN_EFFECT_DECL, FN_UNSAFE, ITEM_UNSAFE, NODE_ASSOC_CONST, NodeKind, REPR_C,
    REPR_INT, REPR_PACKED, REPR_UNION, REPR_WGSL, STRUCT_SCOPED, STRUCT_SEALED, child, list_begin,
    list_end, list_push, new_node,
};
use crate::front::check::name_error;
use crate::front::features::take_feature_attrs;
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{
    Arrow, As, Colon, ColonColon, Comma, Const, Enum, Eof, Eq, Extern, Fn, For, Gt, Hash, Impl,
    Import, Int, LBrace, LBracket, LParen, Lt, Mod, Plus, Pub, RBrace, RBracket, RParen, Reserved,
    Semi, Star, Static, Str, Struct, Trait, Type, Union, Unsafe, Use,
};
use crate::front::modules::vis::{note_vis, restricted_at, restriction_end, self_only};
use crate::front::parser::{
    advance, at, cur, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end,
    reserved_error, syntax_error, tok_kind,
};
use crate::front::parser::clauses::{
    FN_TEST_ATTR, at_cfg_test, parse_alias_target, parse_cfg_test_item, parse_clauses,
    parse_type_invariant, take_test_attrs, test_attribute,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::foreign::{
    at_link_attribute, link_block, parse_extern, parse_link_attributes,
};
use crate::front::parser::items::attrs::{
    check_fn_attributes, parse_deprecated_attribute, parse_fn_attribute, parse_fn_attributes,
    restore_deprecated, save_deprecated, take_deprecated, take_effect_decls,
};
use crate::front::parser::items::params::{
    begin_impl_params, end_impl_params, parse_params, parse_where,
};
use crate::front::parser::stmts::parse_block;
use crate::front::parser::types::{is_int_type_name, parse_bound, parse_type};
use crate::front::threadlocal::STATIC_THREAD_LOCAL;
use crate::tools::fix::note_obsolete_attr;

// One item (or the several items of an impl or extern block), pushed to
// the program's list.
pub fn parse_top_item(pcx: &mut Ctx<Comp>) {
    pcx.vis_tok = -1;
    let public = parse_vis(pcx);
    // (0.26.3: `unsafe impl Allocator for T`, `unsafe trait`)
    let mut unsafe_at: i64 = -1;
    if at(Unsafe, pcx) && (tok_kind(1, pcx) == Impl || tok_kind(1, pcx) == Trait) {
        unsafe_at = cur_start(pcx);
        advance(pcx);
    }
    if at(Impl, pcx) {
        // The functions of an impl block are items of the program.
        parse_impl(false, unsafe_at, pcx);
    } else if at(Trait, pcx) {
        let item = parse_trait(pcx);
        if unsafe_at >= 0 {
            pcx.nodes[item as usize].p |= ITEM_UNSAFE;
            pcx.nodes[item as usize].start = unsafe_at;
        }
        mark_public(item, public, pcx);
        list_push(item, pcx);
    } else if at(Extern, pcx) {
        let mark = pcx.scratch.len() as i64;
        parse_extern(pcx);
        for i in mark..pcx.scratch.len() as i64 {
            mark_public((pcx.scratch[i as usize]), public, pcx);
        }
    } else if at(Import, pcx) {
        parse_import(public, pcx);
    } else if at(Use, pcx) {
        parse_use(public, pcx);
    } else if at(Mod, pcx) {
        let start = cur_start(pcx);
        advance(pcx);
        let n = new_node(NodeKind::Mod, start, 0, pcx);
        pcx.nodes[n as usize].a = expect_binding_name(pcx);
        if eat(LBrace, pcx) {
            // `mod name { items }` (0.6): its items are the program's, in
            // the module the loader made for the braces (modules.vl).
            pcx.nodes[n as usize].end = prev_end(pcx);
            mark_public(n, public, pcx);
            list_push(n, pcx);
            while !at(RBrace, pcx) && !at(Eof, pcx) {
                parse_top_item(pcx);
            }
            expect(RBrace, pcx);
            return;
        }
        expect(Semi, pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        mark_public(n, public, pcx);
        list_push(n, pcx);
    } else if at_link_attribute(pcx) {
        // (0.25: what an extern block links, then the block)
        parse_link_attributes(pcx);
        let mark = pcx.scratch.len() as i64;
        parse_top_item(pcx);
        link_block(mark, pcx);
    } else if at_cfg_test(pcx) {
        // (0.18: the item, or a module's items, for tests only)
        parse_cfg_test_item(pcx);
    } else if embed::at_embed_item(pcx) {
        let item = embed::parse_embed(pcx);
        mark_public(item, public, pcx);
        list_push(item, pcx);
    } else if crate::front::parser::rust::take_array_builtin(pcx) {
        // (0.27.2: the item, over its length parameter. RULE: F15.3)
        parse_top_item(pcx);
        pcx.array_len_name = 0;
    } else if crate::front::parser::rust::take_builtin_impls(pcx) {
        // (0.27.0: the trait is parsed and kept; 0.27.2: and recorded
        // for its builtin impls, F15.1)
        let rec = pcx.builtin_traits.len() as i64 - 4;
        parse_top_item(pcx);
        if pcx.scratch.len() as i64 > 0 {
            let item = pcx.scratch[(pcx.scratch.len() as i64 - 1) as usize];
            if pcx.nodes[item as usize].kind == NodeKind::Trait {
                pcx.builtin_traits[rec as usize] = item;
            }
        }
    } else if at(Hash, pcx) {
        let item = parse_attributed_item(public, pcx);
        list_push(item, pcx);
    } else {
        let item = parse_item(pcx);
        mark_public(item, public, pcx);
        list_push(item, pcx);
    }
}

pub const ITEM_PUBLIC: i64 = 1;

fn mark_public(item: i64, public: bool, pcx: &mut Ctx<Comp>) {
    if public {
        pcx.nodes[item as usize].p |= ITEM_PUBLIC;
        // (0.26.2: `pub(crate)`, ..., read by parse_vis)
        if pcx.vis_tok >= 0 {
            note_vis(item, pcx.vis_tok, pcx);
        }
    }
}

// (0.26.2) `pub`, `pub(crate)`, `pub(super)`, `pub(self)`, `pub(in path)`
// at the cursor: whether the item is public (`pub(self)` is private); a
// restriction is left in VIS_TOK for mark_public (-1: plain `pub`). With
// no `pub` here, VIS_TOK is left as it was (`pub #[inline] fn`).
pub fn parse_vis(pcx: &mut Ctx<Comp>) -> bool {
    if !at(Pub, pcx) {
        return false;
    }
    let p = pcx.p;
    advance(pcx);
    if !restricted_at(p, pcx) {
        pcx.vis_tok = -1;
        return true;
    }
    let end = restriction_end(p, pcx);
    while pcx.p < end && !at(Eof, pcx) {
        advance(pcx);
    }
    if self_only(p, pcx) {
        pcx.vis_tok = -1;
        return false;
    }
    pcx.vis_tok = p;
    true
}

fn parse_item(pcx: &mut Ctx<Comp>) -> i64 {
    match cur(pcx) {
        Fn | Unsafe => parse_function(pcx),
        Struct | Union => parse_struct(pcx),
        Const => if crate::front::parser::rust::skip_const_fn(pcx) { parse_function(pcx) }
            else { parse_const_or_static(NodeKind::Const, pcx) },
        Static => parse_const_or_static(NodeKind::Static, pcx),
        Type => parse_type_alias(pcx),
        Enum => parse_enum(pcx),
        Reserved => reserved_error(pcx),
        _ => syntax_error(c"expected an item ('fn', 'extern', 'struct', 'union', 'enum', 'impl', 'const', 'static' or 'type')", pcx),
    }
}

// `impl T { fn ... }`, `impl<T> Vec<T> { ... }` or `impl Vec<i64> { ... }`:
// each function is pushed as an item, marked with the type's name (d) and
// the type (h); the impl's type parameters come first in its own (g).
fn parse_impl(public: bool, unsafe_at: i64, pcx: &mut Ctx<Comp>) {
    let impl_start = if unsafe_at >= 0 { unsafe_at } else { cur_start(pcx) };
    expect(Impl, pcx);
    let params = parse_generic_params(false, pcx);
    // (0.27.0: the impl's lifetimes, bound to each function as -f)
    let impl_lifetimes = pcx.lt_last;
    pcx.lt_last = 0;
    // RULE: AT2 (the rust edition's negative impl, `impl !Send for X {}`)
    let negative = eat(Tok::Bang, pcx);
    let mut self_type = parse_type(pcx);
    // `impl Trait for Type` (0.9): any type.
    let mut trait_name: i64 = 0;
    if eat(For, pcx) {
        trait_name = self_type;
        if pcx.nodes[trait_name as usize].kind != NodeKind::TyName {
            error_at(pcx.nodes[trait_name as usize].start,
                c"expected a trait's name before 'for'", pcx);
        }
        self_type = parse_type(pcx);
        // (0.27.2: an impl for `&T` is a pattern impl, F6.1)
    }
    if negative && trait_name == 0 {
        error_at(impl_start, c"`!` is before a trait: a negative impl is `impl !Send for T {}`",
            pcx);
    }
    if unsafe_at >= 0 && trait_name == 0 {
        error_at(unsafe_at,
            c"an inherent impl is not unsafe: `unsafe impl` is an unsafe trait's impl (`unsafe impl Allocator for T`)", pcx);
    }
    pcx.where_owner = 0;
    parse_where(params, 0, pcx);
    // (0.27.0: an impl the rust edition has from 0.27.2, parsed and
    // dropped with its functions)
    let dropped = crate::front::parser::rust::later_impl(params, self_type, impl_start, pcx);
    let entry = pcx.scratch.len() as i64;
    let saved_outer = pcx.where_outer;
    pcx.where_outer = params;
    let fns = pcx.scratch.len() as i64;
    expect(LBrace, pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        if (at(Const, pcx) && !crate::front::parser::rust::const_fn_at(0, pcx)
            || at(Pub, pcx) && tok_kind(1, pcx) == Const
            && !crate::front::parser::rust::const_fn_at(1, pcx)) {
            // RULE: F3.1 (an inherent impl's constant, `impl char { const
            // MAX .. }`, is recorded with its self type: assoc::
            // inherent_const_value)
            let c = parse_assoc_const(true, pcx);
            if trait_name == 0 {
                if !dropped {
                    pcx.inherent_consts.push(c);
                    pcx.inherent_consts.push(self_type);
                    pcx.inherent_consts.push(params);
                }
                continue;
            }
            list_push(c, pcx);
            continue;
        }
        if at(Type, pcx) {
            if trait_name == 0 {
                error_at(cur_start(pcx), c"associated types are declared in an impl of a trait",
                    pcx);
            }
            list_push(parse_assoc_type(true, pcx), pcx);
            continue;
        }
        // (0.27.2: a function over its length parameter. RULE: F15.3)
        let _ = crate::front::parser::rust::take_array_builtin(pcx);
        let attrs_start = cur_start(pcx);
        let flags = parse_fn_attributes(pcx);
        pcx.vis_tok = -1;
        let item_public = parse_vis(pcx) || public;
        // RULE: F34.1 (`pub const fn` in an impl)
        let _ = crate::front::parser::rust::skip_const_fn(pcx);
        if !at(Fn, pcx) && !(at(Unsafe, pcx) && tok_kind(1, pcx) == Fn) {
            if flags != 0 {
                error_at(attrs_start, c"#[inline] and #[cold] go before a function", pcx);
            }
            syntax_error(if trait_name != 0 { c"expected 'fn', 'type' or '}' in an impl block" }
                else { c"expected 'fn' or '}' in an impl block" }, pcx);
        }
        let before = impl_bounds(params, pcx);
        let f = parse_function(pcx);
        // (0.27.0: a `where` of the function on the impl's parameter is
        // the function's, not every function's of the block)
        let own = take_method_bounds(params, &before, pcx);
        pcx.array_len_name = 0;
        if trait_name != 0 {
            no_param_defaults(f, c"a trait's function", pcx);
        }
        pcx.nodes[f as usize].p |= flags;
        take_effect_decls(f, pcx);
        pcx.nodes[f as usize].d = if pcx.nodes[self_type as usize].kind
            == NodeKind::TyName { pcx.nodes[self_type as usize].a }
            else { pcx.underscore };
        pcx.nodes[f as usize].h = self_type;
        if impl_lifetimes != 0 {
            pcx.lt_last = impl_lifetimes;
            crate::front::parser::rust::bind_lifetimes(-f, pcx);
        }
        if params != 0 {
            pcx.nodes[f as usize].g = merge_generics(params, pcx.nodes[f as usize].g, pcx);
            for i in 0..own.len() as i64 {
                if own[i as usize] != 0 {
                    (pcx.lists[(pcx.nodes[pcx.nodes[f as usize].g as usize].list + i) as usize]) = own[
                        i as usize];
                }
            }
        }
        // (a trait's methods are as visible as the trait)
        mark_public(f, item_public || trait_name != 0, pcx);
        list_push(f, pcx);
    }
    expect(RBrace, pcx);
    pcx.where_outer = saved_outer;
    let assoc = take_assoc_types(fns, impl_start, pcx);
    if trait_name != 0 {
        let n = new_node(NodeKind::Impl, impl_start, prev_end(pcx), pcx);
        pcx.nodes[n as usize].a = trait_name;
        pcx.nodes[n as usize].b = self_type;
        pcx.nodes[n as usize].g = params;
        pcx.nodes[n as usize].c = assoc;
        if unsafe_at >= 0 {
            pcx.nodes[n as usize].p |= ITEM_UNSAFE;
        }
        if negative {
            pcx.nodes[n as usize].p |= crate::front::ast::IMPL_NEGATIVE;
        }
        let end = pcx.scratch.len() as i64;
        let mark = list_begin(pcx);
        for i in fns..end {
            list_push((pcx.scratch[i as usize]), pcx);
        }
        list_end(n, mark, pcx);
        list_push(n, pcx);
    }
    if dropped {
        pcx.scratch.truncate(entry as usize);
    }
}

// `type Name;` in a trait, `type Name = T;` in an impl (0.14): an
// AssocType node.
fn parse_assoc_type(in_impl: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Type, pcx);
    let n = new_node(NodeKind::AssocType, start, 0, pcx);
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    if in_impl {
        expect(Eq, pcx);
        pcx.nodes[n as usize].b = parse_type(pcx);
    } else if at(Eq, pcx) {
        error_at(cur_start(pcx), c"an associated type has no default: write 'type Name;'", pcx);
    } else if at(Colon, pcx) {
        // RULE: F11.1 (`type Item: Bound;`: the bounds, the node's h)
        pcx.nodes[n as usize].h = crate::front::parser::rust::parse_item_bounds(pcx);
    } else if at(Colon, pcx) {
        error_at(cur_start(pcx), c"an associated type has no bounds: write 'type Name;'", pcx);
    }
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// (0.27.2) `[pub] const NAME: T [= v];` in a trait or an impl of the rust
// edition: an associated constant, an AssocType node flagged
// NODE_ASSOC_CONST, b its type, c its value (0: a trait's without a
// default). RULE: F3.1
fn parse_assoc_const(in_impl: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    eat(Pub, pcx);
    expect(Const, pcx);
    let n = new_node(NodeKind::AssocType, start, 0, pcx);
    pcx.nodes[n as usize].p |= NODE_ASSOC_CONST;
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    expect(Colon, pcx);
    pcx.nodes[n as usize].b = parse_type(pcx);
    if eat(Eq, pcx) {
        pcx.nodes[n as usize].c = crate::front::parser::exprs::parse_expr(pcx);
    } else if in_impl {
        error_at(cur_start(pcx),
            c"an impl's associated constant has a value: 'const NAME: T = v;'", pcx);
    }
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// The AssocType nodes among SCRATCH[from..] moved to a holder node (a
// Generics node, 0.14), the others kept in order; 0 when there are none.
fn take_assoc_types(from: i64, pos: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let end = pcx.scratch.len() as i64;
    let mut found = false;
    for i in from..end {
        if pcx.nodes[(pcx.scratch[i as usize]) as usize].kind == NodeKind::AssocType {
            found = true;
        }
    }
    if !found {
        return 0;
    }
    let holder = new_node(NodeKind::Generics, pos, prev_end(pcx), pcx);
    let mark = list_begin(pcx);
    for i in from..end {
        if pcx.nodes[(pcx.scratch[i as usize]) as usize].kind == NodeKind::AssocType {
            list_push((pcx.scratch[i as usize]), pcx);
        }
    }
    list_end(holder, mark, pcx);
    let mut w = from;
    for i in from..end {
        let x = (pcx.scratch[i as usize]);
        if pcx.nodes[x as usize].kind != NodeKind::AssocType {
            (pcx.scratch[w as usize]) = x;
            w += 1;
        }
    }
    pcx.scratch.truncate(w as usize);
    holder
}

// `trait Name { fn m(self: *Self) -> T; fn d(self: *Self) { ... } }` (0.9;
// 0.15: `trait Name<T> { ... }`).
fn parse_trait(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Trait, pcx);
    let n = new_node(NodeKind::Trait, start, 0, pcx);
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    // (0.15: `trait From<T>`)
    pcx.nodes[n as usize].g = parse_generic_params(false, pcx);
    crate::front::parser::rust::bind_lifetimes(n, pcx);
    // RULE: F2.1 (`trait A: B + C`, the rust edition's supertraits: the
    // trait's h, traits::trait_supers)
    pcx.nodes[n as usize].h = crate::front::parser::rust::parse_item_bounds(pcx);
    // RULE: F10.1 (0.27.3: the trait's own predicates, not the last
    // function's: no owner is left from the item before)
    pcx.where_owner = 0;
    parse_where(pcx.nodes[n as usize].g, 0, pcx);
    expect(LBrace, pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        if at(Type, pcx) {
            list_push(parse_assoc_type(false, pcx), pcx);
            continue;
        }
        if (at(Const, pcx) || at(Pub, pcx) && tok_kind(1, pcx) == Const) {
            // RULE: F3.1
            list_push(parse_assoc_const(false, pcx), pcx);
            continue;
        }
        let attrs_start = cur_start(pcx);
        let flags = parse_fn_attributes(pcx);
        if at(Pub, pcx) {
            error_at(cur_start(pcx),
                c"the functions of a trait are as visible as the trait: no 'pub'", pcx);
        }
        if !at(Fn, pcx) && !(at(Unsafe, pcx) && tok_kind(1, pcx) == Fn) {
            if flags != 0 {
                error_at(attrs_start, c"#[inline] and #[cold] go before a function", pcx);
            }
            syntax_error(c"expected 'fn', 'type' or '}' in a trait", pcx);
        }
        let fstart = cur_start(pcx);
        let is_unsafe = eat(Unsafe, pcx);
        expect(Fn, pcx);
        let f = new_node(NodeKind::Fn, fstart, 0, pcx);
        pcx.nodes[f as usize].p |= flags;
        take_effect_decls(f, pcx);
        if is_unsafe {
            pcx.nodes[f as usize].p |= FN_UNSAFE;
        }
        pcx.nodes[f as usize].a = expect_binding_name(pcx);
        pcx.nodes[f as usize].g = parse_generic_params(false, pcx);
        crate::front::parser::rust::bind_lifetimes(f, pcx);
        expect(LParen, pcx);
        let owner = begin_impl_params(f, pcx);
        parse_params(f, false, pcx);
        end_impl_params(f, owner, pcx);
        no_param_defaults(f, c"a trait function", pcx);
        expect(RParen, pcx);
        pcx.nodes[f as usize].b = parse_return_type(pcx);
        pcx.where_owner = f;
        parse_where(pcx.nodes[f as usize].g, pcx.nodes[n as usize].g, pcx);
        // (0.18: requires/ensures)
        parse_clauses(f, pcx);
        if !eat(Semi, pcx) {
            pcx.nodes[f as usize].c = parse_fn_body(f, pcx);
        }
        pcx.nodes[f as usize].end = prev_end(pcx);
        list_push(f, pcx);
    }
    pcx.nodes[n as usize].b = take_assoc_types(mark, start, pcx);
    list_end(n, mark, pcx);
    expect(RBrace, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// (0.27.0) The bounds (h) of each of an impl's parameters `params`.
fn impl_bounds(params: i64, pcx: &Ctx<Comp>) -> Vec<i64, Comp> {
    let mut v: Vec<i64, Comp> = Vec::new_in(Comp {});
    if params != 0 {
        for i in 0..pcx.nodes[params as usize].count {
            v.push(pcx.nodes[child(params, i, pcx) as usize].h);
        }
    }
    v
}

// (0.27.0) After a function of the impl is parsed: an impl parameter its
// `where` bounded (its h no longer `before`'s) gets its bounds back, and
// the function a copy of it with the new ones, which it takes in its
// merged parameters (the copies, 0 for a parameter it left alone).
fn take_method_bounds(params: i64, before: &Vec<i64, Comp>, pcx: &mut Ctx<Comp>) -> Vec<i64, Comp> {
    let mut own: Vec<i64, Comp> = Vec::new_in(Comp {});
    for i in 0..before.len() as i64 {
        let p = child(params, i, pcx);
        if pcx.nodes[p as usize].h == before[i as usize] {
            own.push(0);
            continue;
        }
        let copy = new_node(pcx.nodes[p as usize].kind, pcx.nodes[p as usize].start,
            pcx.nodes[p as usize].end, pcx);
        pcx.nodes[copy as usize] = pcx.nodes[p as usize];
        pcx.nodes[p as usize].h = before[i as usize];
        own.push(copy);
    }
    own
}

// The parameters of an impl block followed by those of one of its
// functions (`a` counts the impl's).
fn merge_generics(outer: i64, own: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Generics, pcx.nodes[outer as usize].start,
        pcx.nodes[outer as usize].end, pcx);
    let mark = list_begin(pcx);
    for i in 0..pcx.nodes[outer as usize].count {
        list_push(child(outer, i, pcx), pcx);
    }
    if own != 0 {
        for i in 0..pcx.nodes[own as usize].count {
            list_push(child(own, i, pcx), pcx);
        }
    }
    list_end(n, mark, pcx);
    pcx.nodes[n as usize].a = pcx.nodes[outer as usize].count;
    n
}

// `<T, U>` after the name of a generic item (0.5); 0 when there is none.
// (0.16) A parameter may have a default, `A: Allocator = Gpa` (its b), in
// a struct or an enum (`defaults`), after those without one.
fn parse_generic_params(defaults: bool, pcx: &mut Ctx<Comp>) -> i64 {
    // RULE: F15.3 (`#[array_builtin(N)]`'s N: the item's last parameter)
    let len_name = pcx.array_len_name;
    pcx.array_len_name = 0;
    if !at(Lt, pcx) {
        if len_name == 0 {
            return 0;
        }
        let n = new_node(NodeKind::Generics, cur_start(pcx), cur_start(pcx), pcx);
        let mark = list_begin(pcx);
        list_push(length_param(len_name, pcx), pcx);
        list_end(n, mark, pcx);
        return n;
    }
    let n = new_node(NodeKind::Generics, cur_start(pcx), 0, pcx);
    advance(pcx);
    let mark = list_begin(pcx);
    let lifetimes = crate::front::parser::rust::lifetimes_begin(pcx);
    while !at(Gt, pcx) && !at(Eof, pcx) {
        // (0.27.0) `'a`, `'a: 'b`: the rust edition's, kept apart
        if crate::front::parser::rust::take_lifetime(true, pcx) {
            if !eat(Comma, pcx) {
                break;
            }
            continue;
        }
        let param = new_node(NodeKind::TyName, cur_start(pcx), 0, pcx);
        pcx.nodes[param as usize].a = expect_binding_name(pcx);
        pcx.nodes[param as usize].end = prev_end(pcx);
        if eat(Colon, pcx) {
            // Bounds (0.9): `T: Hash + Eq`, a Generics node of trait names
            // (0.14: or `Fn(A) -> R`, `Iterator<Item = A>`: parse_bound).
            let bounds = new_node(NodeKind::Generics, cur_start(pcx), 0, pcx);
            let bmark = list_begin(pcx);
            loop {
                if !crate::front::parser::rust::take_outlives_bound(param, pcx) {
                    list_push(parse_bound(pcx), pcx);
                }
                if !eat(Plus, pcx) {
                    break;
                }
            }
            // RULE: F21.1 (the rust edition: `T: Sized` says nothing)
            let _ = crate::front::parser::rust::drop_sized(bmark,
                pcx.nodes[param as usize].start, pcx);
            list_end(bounds, bmark, pcx);
            pcx.nodes[bounds as usize].end = prev_end(pcx);
            pcx.nodes[param as usize].h = bounds;
        }
        if at(Eq, pcx) {
            let eq = cur_start(pcx);
            advance(pcx);
            pcx.nodes[param as usize].b = parse_type(pcx);
        } else if defaults {
            for i in mark..pcx.scratch.len() as i64 {
                if pcx.nodes[(pcx.scratch[i as usize]) as usize].b != 0 {
                    name_error(pcx.nodes[param as usize].start, c"type parameter '",
                        pcx.nodes[param as usize].a,
                        c"' needs a default: those after a parameter with a default have one", pcx);
                }
            }
        }
        for i in mark..pcx.scratch.len() as i64 {
            if pcx.nodes[(pcx.scratch[i as usize]) as usize].a
                == pcx.nodes[param as usize].a {
                name_error(pcx.nodes[param as usize].start, c"duplicate type parameter '",
                    pcx.nodes[param as usize].a, c"'", pcx);
            }
        }
        list_push(param, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    if len_name != 0 {
        list_push(length_param(len_name, pcx), pcx);
    }
    list_end(n, mark, pcx);
    let only_lifetimes = pcx.nodes[n as usize].count == 0
        && pcx.lt_scratch.len() as i64 > lifetimes;
    crate::front::parser::rust::lifetimes_end(lifetimes, pcx);
    if pcx.nodes[n as usize].count == 0 && !only_lifetimes {
        error_at(pcx.nodes[n as usize].start, c"expected a type parameter", pcx);
    }
    expect(Gt, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    if only_lifetimes { 0 } else { n }
}

// RULE: F15.3 The length parameter `name` of an `#[array_builtin(name)]`
// item: a type parameter, bound to `[(); n]` for the length n
// (generics::length_type), at the attribute's position.
fn length_param(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let param = new_node(NodeKind::TyName, cur_start(pcx), cur_start(pcx), pcx);
    pcx.nodes[param as usize].a = name;
    param
}

// `enum E { A, B(T, ...), C { x: T, ... }, D = expr, ... }`
fn parse_enum(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Enum, pcx);
    let n = new_node(NodeKind::Enum, start, 0, pcx);
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    pcx.nodes[n as usize].g = parse_generic_params(true, pcx);
    crate::front::parser::rust::bind_lifetimes(n, pcx);
    // RULE: F10.1 (0.27.3: the enum's, owned by no function)
    pcx.where_owner = 0;
    parse_where(pcx.nodes[n as usize].g, 0, pcx);
    expect(LBrace, pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        // RULE: F17.1 (the rust edition: `#[default]` marks the variant a
        // derived Default makes)
        let mut marked = false;
        if at(Hash, pcx) {
            advance(pcx);
            expect(LBracket, pcx);
            let name = expect_ident(pcx);
            if sym_text(name, pcx) != b"default" {
                error_at(prev_end(pcx), c"a variant takes no attribute but #[default]", pcx);
            }
            expect(RBracket, pcx);
            marked = true;
        }
        let variant = new_node(NodeKind::Variant, cur_start(pcx), 0, pcx);
        if marked {
            pcx.nodes[variant as usize].p |= crate::front::ast::VARIANT_DEFAULT;
        }
        pcx.nodes[variant as usize].a = expect_binding_name(pcx);
        if at(LBrace, pcx) {
            // (0.17) `V { a: A, b: B }`
            parse_variant_fields(variant, pcx);
        } else if eat(LParen, pcx) {
            pcx.nodes[variant as usize].c = 1;
            let types = list_begin(pcx);
            while !at(RParen, pcx) && !at(Eof, pcx) {
                list_push(parse_type(pcx), pcx);
                if !eat(Comma, pcx) {
                    break;
                }
            }
            list_end(variant, types, pcx);
            expect(RParen, pcx);
        }
        if eat(Eq, pcx) {
            pcx.nodes[variant as usize].b = parse_expr(pcx);
        }
        pcx.nodes[variant as usize].end = prev_end(pcx);
        list_push(variant, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RBrace, pcx);
    // (0.18: `invariant COND`)
    parse_type_invariant(n, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// (0.17) The fields of `V { a: A, b: B }`, after the variant's name: the
// variant's list holds the types (as for `V(A, B)`, c = 1), its d a node
// whose list holds a Field node per field (a: the name, b: 0).
fn parse_variant_fields(variant: i64, pcx: &mut Ctx<Comp>) {
    let names = new_node(NodeKind::None, cur_start(pcx), 0, pcx);
    expect(LBrace, pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        let field = new_node(NodeKind::Field, cur_start(pcx), 0, pcx);
        pcx.nodes[field as usize].a = expect_binding_name(pcx);
        pcx.nodes[field as usize].end = prev_end(pcx);
        expect(Colon, pcx);
        // (the type, kept on the stack after its field until the end)
        pcx.nodes[field as usize].c = parse_type(pcx);
        list_push(field, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(names, mark, pcx);
    expect(RBrace, pcx);
    pcx.nodes[names as usize].end = prev_end(pcx);
    let types = list_begin(pcx);
    for i in 0..pcx.nodes[names as usize].count {
        let field = child(names, i, pcx);
        list_push(pcx.nodes[field as usize].c, pcx);
        pcx.nodes[field as usize].c = 0;
    }
    list_end(variant, types, pcx);
    pcx.nodes[variant as usize].c = (pcx.nodes[names as usize].count > 0) as i64;
    pcx.nodes[variant as usize].d = names;
}

pub fn parse_function(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    // `unsafe fn` (0.9).
    let is_unsafe = eat(Unsafe, pcx);
    expect(Fn, pcx);
    let n = new_node(NodeKind::Fn, start, 0, pcx);
    if is_unsafe {
        pcx.nodes[n as usize].p |= FN_UNSAFE;
    }
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    pcx.nodes[n as usize].g = parse_generic_params(false, pcx);
    crate::front::parser::rust::bind_lifetimes(n, pcx);
    expect(LParen, pcx);
    let owner = begin_impl_params(n, pcx);
    parse_params(n, false, pcx);
    end_impl_params(n, owner, pcx);
    expect(RParen, pcx);
    pcx.nodes[n as usize].b = crate::front::parser::items::params::parse_fn_result(pcx);
    // (0.26.2) `where T: Display` (an impl's function: also the impl's
    // parameters, WHERE_OUTER)
    pcx.where_owner = n;
    parse_where(pcx.nodes[n as usize].g, pcx.where_outer, pcx);
    if pcx.lt_where != 0 {
        // (0.27.1: its `where 'a: 'b`, the region checker's, D4.5)
        crate::front::parser::rust::lt_push(crate::front::parser::rust::where_key(n), pcx.lt_where,
            pcx);
        pcx.lt_where = 0;
    }
    // (0.18: requires/ensures, front/parser/clauses.vl)
    parse_clauses(n, pcx);
    // (0.19) A declaration of std::arch's (arch/virtual.vl): `;` for
    // its body.
    if pcx.intrinsic_pending >= 0 {
        note_intrinsic_node(n, pcx.intrinsic_pending, pcx);
        pcx.intrinsic_pending = -1;
        if eat(Semi, pcx) {
            pcx.nodes[n as usize].end = prev_end(pcx);
            return n;
        }
    }
    take_feature_attrs(n, pcx);
    pcx.nodes[n as usize].c = parse_fn_body(n, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

// The body of function n; one with a syntax error is marked so (the
// checker leaves it out).
fn parse_fn_body(n: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let saved = pcx.body_failed;
    pcx.body_failed = false;
    let body = parse_block(pcx);
    if pcx.body_failed {
        pcx.nodes[n as usize].p |= FN_BODY_FAILED;
    }
    pcx.body_failed = saved;
    body
}

// `use a::b::c;`, `use a::b::{c, d as e};`, `use a::b as x;` (0.5; 0.4
// had `use E::{A, B};` for the variants of an enum). `use a::b::*;` and
// `use E::*;` are parsed for --fix-imports, and are an error otherwise
// (0.8). c = a Path node whose list is the segments before the braces (or
// the star), b = 1 for `*`, list = the imported names (Ident nodes: a =
// the name, b = its new name, 0 for none).
fn parse_use(public: bool, pcx: &mut Ctx<Comp>) {
    let start = cur_start(pcx);
    expect(Use, pcx);
    let n = new_node(NodeKind::Use, start, 0, pcx);
    let path = new_node(NodeKind::Path, cur_start(pcx), 0, pcx);
    let segments = list_begin(pcx);
    let mark = list_begin(pcx);
    let mut last: i64 = 0;
    loop {
        let seg = new_node(NodeKind::Ident, cur_start(pcx), 0, pcx);
        pcx.nodes[seg as usize].a = expect_ident(pcx);
        pcx.nodes[seg as usize].end = prev_end(pcx);
        if !eat(ColonColon, pcx) {
            last = seg;
            break;
        }
        list_push(seg, pcx);
        if at(Star, pcx) || at(LBrace, pcx) {
            break;
        }
    }
    list_end(path, segments, pcx);
    pcx.nodes[path as usize].end = prev_end(pcx);
    pcx.nodes[n as usize].c = path;
    let items = list_begin(pcx);
    if last != 0 {
        if eat(As, pcx) {
            pcx.nodes[last as usize].b = expect_binding_name(pcx);
        }
        list_push(last, pcx);
    } else if eat(Star, pcx) {
        pcx.nodes[n as usize].b = 1;
    } else {
        expect(LBrace, pcx);
        while !at(RBrace, pcx) && !at(Eof, pcx) {
            let item = new_node(NodeKind::Ident, cur_start(pcx), 0, pcx);
            pcx.nodes[item as usize].a = expect_ident(pcx);
            if eat(As, pcx) {
                pcx.nodes[item as usize].b = expect_binding_name(pcx);
            }
            pcx.nodes[item as usize].end = prev_end(pcx);
            list_push(item, pcx);
            if !eat(Comma, pcx) {
                break;
            }
        }
        expect(RBrace, pcx);
    }
    list_end(n, items, pcx);
    if pcx.nodes[path as usize].count == 0 && pcx.nodes[n as usize].b == 0 {
        err_begin(start, pcx);
        err_str(c"a use names an item through a path: 'use module::item;'", pcx);
        if last != 0 {
            // (0.25.2.2, eval 0.25.2.1: sph) `use cpu;` for a module of
            // the crate, which needs none
            let t = sym_text(pcx.nodes[last as usize].a, pcx);
            if t == b"std" {
                err_help_fmt(
                    format_args("std is in scope by its name already, with no `use`: `std::f()`; its items by name: `use std::{{f}};`"), pcx);
            } else {
                err_help_fmt(
                    { let t = str::from_utf8(t).unwrap(); format_args("a module of the crate is in scope by its name already, with no `use`: `{t}::f()`; its items by name: `use crate::{t}::{{f}};`") }, pcx);
            }
        }
        err_end(pcx);
    }
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    mark_public(n, public, pcx);
    let _ = mark;
    list_push(n, pcx);
}

// `import "header.h" as c;`: the declarations of a C header become part
// of the program (cimport.vl; the driver reads the imports before
// parsing). They live in a module of their own, which the importing
// module names `c`: `c::printf`. `import "header.h";`, which brought
// them all into scope, is parsed for --fix-imports, and is an error
// otherwise (0.8). A Use node with d = 2 and a = that name (0: none).
fn parse_import(public: bool, pcx: &mut Ctx<Comp>) {
    let start = cur_start(pcx);
    expect(Import, pcx);
    if !at(Str, pcx) {
        syntax_error(c"expected the name of a C header as a string", pcx);
    }
    advance(pcx);
    let n = new_node(NodeKind::Use, start, 0, pcx);
    pcx.nodes[n as usize].d = 2;
    if eat(As, pcx) {
        pcx.nodes[n as usize].a = expect_binding_name(pcx);
    }
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    mark_public(n, public, pcx);
    list_push(n, pcx);
}

// Attributes, then the item: `#[repr(...)]` before a struct, union or
// enum; `#[derive(...)]` (0.15) before a struct or an enum; `#[inline]`, `#[inline(never)]`, `#[cold]` (0.6) before a function.
// `pub` may come before the attributes or (0.6) after them.
fn parse_attributed_item(public: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let mut flags: i64 = 0;
    let mut fn_flags: i64 = 0;
    let mut repr = false;
    let mut align: i64 = 0;
    let mut pack: i64 = 0;
    let mut int_type: i64 = 0;
    let at_start = cur_start(pcx);
    let mut derives: i64 = 0;
    let mut derive_mark: i64 = 0;
    // (0.16: #[sealed], #[scoped])
    let mut struct_flags: i64 = 0;
    // (0.21: #[thread_local])
    let mut thread_local = false;
    let mut deprecated = false;
    take_effect_decls(0, pcx);
    while at(Hash, pcx) {
        let attr_pos = cur_start(pcx);
        advance(pcx);
        expect(LBracket, pcx);
        let name = expect_ident(pcx);
        // (0.26.3: #[deprecated], on any item)
        if parse_deprecated_attribute(name, attr_pos, pcx) {
            deprecated = true;
            expect(RBracket, pcx);
            continue;
        }
        // (0.18: #[test], #[property], #[fuzz], #[cfg(test)])
        if test_attribute(name, pcx) {
            fn_flags |= FN_TEST_ATTR;
            expect(RBracket, pcx);
            continue;
        }
        let fn_flag = parse_fn_attribute(name, attr_pos, pcx);
        if fn_flag != 0 {
            fn_flags |= fn_flag;
            expect(RBracket, pcx);
            continue;
        }
        if name == intern_c(c"derive", pcx) {
            // `#[derive(Eq, Ord, ...)]` (0.15): the traits, TyNames in a
            // holder (several derive attributes add to one)
            if derives == 0 {
                derives = new_node(NodeKind::Generics, attr_pos, 0, pcx);
                derive_mark = list_begin(pcx);
            }
            expect(LParen, pcx);
            while !at(RParen, pcx) && !at(Eof, pcx) {
                list_push(parse_type(pcx), pcx);
                if !eat(Comma, pcx) {
                    break;
                }
            }
            expect(RParen, pcx);
            expect(RBracket, pcx);
            pcx.nodes[derives as usize].end = prev_end(pcx);
            continue;
        }
        if name == intern_c(c"thread_local", pcx) {
            thread_local = true;
            expect(RBracket, pcx);
            continue;
        }
        if name == intern_c(c"sealed", pcx) || name == intern_c(c"scoped", pcx) {
            struct_flags |= if name == intern_c(c"sealed", pcx) { STRUCT_SEALED }
                else { STRUCT_SCOPED };
            expect(RBracket, pcx);
            if name == intern_c(c"sealed", pcx) {
                obsolete_sealed(attr_pos, prev_end(pcx), pcx);
            }
            continue;
        }
        if name != intern_c(c"repr", pcx) {
            name_error(pcx.toks[(pcx.p - 1) as usize].start, c"unknown attribute '", name,
                c"' (expected repr, derive, sealed, scoped, inline, inline(never), cold, effects, pure, no_alloc, no_io, no_panic, views or stores)", pcx);
        }
        repr = true;
        expect(LParen, pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            let pos = cur_start(pcx);
            let arg = expect_ident(pcx);
            if arg == intern_c(c"C", pcx) {
                flags |= REPR_C;
            } else if arg == intern_c(c"packed", pcx) {
                flags |= REPR_PACKED;
                pack = 1;
                if eat(LParen, pcx) {
                    // packed(N): fields aligned to at most N (0.4; GCC's
                    // #pragma pack(N)).
                    if !at(Int, pcx) {
                        syntax_error(c"expected the packing", pcx);
                    }
                    pack = pcx.toks[pcx.p as usize].value as i64;
                    advance(pcx);
                    expect(RParen, pcx);
                    if pack < 1 || pack > 16 || (pack & (pack - 1)) != 0 {
                        error_at(pos, c"packed(N) needs a power of two from 1 to 16", pcx);
                    }
                }
            } else if arg == intern_c(c"align", pcx) {
                expect(LParen, pcx);
                if !at(Int, pcx) {
                    syntax_error(c"expected the alignment", pcx);
                }
                align = pcx.toks[pcx.p as usize].value as i64;
                advance(pcx);
                expect(RParen, pcx);
                if align < 1 || align > 4096 || (align & (align - 1)) != 0 {
                    error_at(pos, c"align(N) needs a power of two from 1 to 4096", pcx);
                }
            } else if arg == intern_c(c"wgsl", pcx) {
                flags |= REPR_WGSL;
            } else if is_int_type_name(arg, pcx) {
                flags |= REPR_INT;
                int_type = arg;
            }
            else if arg == intern_c(c"transparent", pcx) {
                // (0.27.0: the rust edition's; a struct of one field is laid
                // out as the field already)
            } else {
                name_error(pos, c"unknown repr '", arg,
                    c"' (expected C, packed, align(N), wgsl or an integer type)", pcx);
            }
            if !eat(Comma, pcx) {
                break;
            }
        }
        expect(RParen, pcx);
        expect(RBracket, pcx);
    }
    // (0.26.3: the #[deprecated], kept while the item is parsed: a
    // struct's fields, a trait's functions have their own)
    let dep = save_deprecated(pcx);
    if derives != 0 {
        list_end(derives, derive_mark, pcx);
        if pcx.nodes[derives as usize].count == 0 {
            error_at(pcx.nodes[derives as usize].start,
                c"expected the traits to derive: '#[derive(Eq, Ord, Hash, Debug, Clone)]'", pcx);
        }
    }
    let item_public = parse_vis(pcx) || public;
    if derives != 0 && !at(Struct, pcx) && !at(Enum, pcx) {
        error_at(pcx.nodes[derives as usize].start,
            c"#[derive(...)] goes before a struct or an enum", pcx);
    }
    if thread_local {
        if fn_flags != 0 || repr || derives != 0 || struct_flags != 0 {
            error_at(at_start, c"#[thread_local] takes no other attribute", pcx);
        }
        let item = parse_item(pcx);
        if pcx.nodes[item as usize].kind != NodeKind::Static || pcx.nodes[item as usize].d == 0 {
            error_at(at_start, c"#[thread_local] goes before a `static mut`", pcx);
        }
        pcx.nodes[item as usize].p |= STATIC_THREAD_LOCAL;
        restore_deprecated(dep, at_start, pcx);
        take_deprecated(item, pcx);
        mark_public(item, item_public, pcx);
        return item;
    }
    if fn_flags != 0 {
        if repr {
            error_at(at_start, c"#[repr(...)] and function attributes cannot be combined", pcx);
        }
        if struct_flags != 0 {
            error_at(at_start, c"#[sealed] and #[scoped] are for structs, not functions", pcx);
        }
        if !at(Fn, pcx) && !(at(Unsafe, pcx) && tok_kind(1, pcx) == Fn) {
            error_at(at_start, if fn_flags == FN_EFFECT_DECL {
                c"effect declarations go before a function" }
                else { c"#[inline] and #[cold] go before a function" }, pcx);
        }
        check_fn_attributes(fn_flags, at_start, pcx);
        let f = parse_function(pcx);
        pcx.nodes[f as usize].p |= fn_flags;
        restore_deprecated(dep, at_start, pcx);
        take_effect_decls(f, pcx);
        take_test_attrs(f, pcx);
        mark_public(f, item_public, pcx);
        return f;
    }
    if deprecated && !repr && derives == 0 && struct_flags == 0 {
        // (0.26.3: #[deprecated] alone, before any item or a trait)
        let item = if at(Trait, pcx) { parse_trait(pcx) } else { parse_item(pcx) };
        restore_deprecated(dep, at_start, pcx);
        take_deprecated(item, pcx);
        mark_public(item, item_public, pcx);
        return item;
    }
    if struct_flags != 0 && !at(Struct, pcx) {
        error_at(at_start, c"#[sealed] and #[scoped] go before a struct", pcx);
    }
    if !at(Struct, pcx) && !at(Union, pcx) && !at(Enum, pcx) {
        error_at(at_start, c"#[repr(...)] goes before a struct, union or enum", pcx);
    }
    if ((flags & REPR_PACKED) != 0 || align != 0) && (flags & REPR_C) == 0 {
        error_at(at_start, c"packed and align(N) are only for #[repr(C, ...)] types", pcx);
    }
    if (flags & REPR_PACKED) != 0 && align != 0 {
        error_at(at_start, c"a type cannot be both packed and aligned", pcx);
    }
    if (flags & REPR_WGSL) != 0 && ((flags & (REPR_C | REPR_INT)) != 0 || align != 0
        || !(at(Struct, pcx) || (at(Pub, pcx) && tok_kind(1, pcx) == Struct))) {
        error_at(at_start, c"#[repr(wgsl)] goes alone before a struct: its layout is WGSL's", pcx);
    }
    let item = parse_item(pcx);
    pcx.nodes[item as usize].h = derives;
    pcx.nodes[item as usize].c |= struct_flags;
    if pcx.nodes[item as usize].kind == NodeKind::Enum {
        if (flags & REPR_PACKED) != 0 || align != 0 {
            error_at(at_start, c"packed and align(N) are for structs and unions, not enums", pcx);
        }
        pcx.nodes[item as usize].d = int_type;
    } else {
        if (flags & REPR_INT) != 0 {
            error_at(at_start, c"an integer repr is for enums only", pcx);
        }
        // For packed types, `d` is the packing (1 for plain packed).
        pcx.nodes[item as usize].d = if pack != 0 { pack } else { align };
    }
    pcx.nodes[item as usize].c = pcx.nodes[item as usize].c | flags;
    restore_deprecated(dep, at_start, pcx);
    take_deprecated(item, pcx);
    mark_public(item, item_public, pcx);
    item
}

// (0.26.0) `#[sealed]` at SRC[start..end): what it asked for is every
// struct's rule, so it is warned about, and `volec fix --only
// obsolete-attr` deletes it.
fn obsolete_sealed(start: i64, end: i64, pcx: &mut Ctx<Comp>) {
    note_obsolete_attr(start, end, pcx);
    let tries = buf_new();
    buf_tool_command(tries, b"fix --only obsolete-attr", true, pcx);
    report_error_tries(start, 7201, c"attr.obsolete",
        c"'#[sealed]' is the default from 0.26: every field not marked 'pub' is private to its module",
        c"delete it (`volec fix --only obsolete-attr` deletes every one)", buf_slice(tries), true,
        pcx);
}

// Function `f` (a Fn or ExternFn) is one whose parameters cannot have
// defaults (0.15: those of trait functions and extern functions): an
// error at the first one that has one.
pub fn no_param_defaults(f: i64, what: *mut u8, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[f as usize].count {
        let p = child(f, i, pcx);
        if pcx.nodes[p as usize].h != 0 {
            err_begin(pcx.nodes[pcx.nodes[p as usize].h as usize].start, pcx);
            err_str(
                c"a default value is for a parameter of a function or an inherent method, not of ", pcx);
            err_str(what, pcx);
            err_help(c"remove the '= value'; the callers pass the argument", pcx);
            err_end(pcx);
        }
    }
}

pub fn parse_return_type(pcx: &mut Ctx<Comp>) -> i64 {
    if eat(Arrow, pcx) { parse_type(pcx) } else { 0 }
}

fn parse_struct(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let is_union = at(Union, pcx);
    advance(pcx);
    let n = new_node(NodeKind::Struct, start, 0, pcx);
    if is_union {
        pcx.nodes[n as usize].c = REPR_UNION;
    }
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    pcx.nodes[n as usize].g = parse_generic_params(true, pcx);
    crate::front::parser::rust::bind_lifetimes(n, pcx);
    // RULE: F10.1 (0.27.3: the struct's, owned by no function: `struct
    // Flatten<I> where I::Item: IntoIterator` after Cloned's `next_back` made
    // the predicate next_back's)
    pcx.where_owner = 0;
    parse_where(pcx.nodes[n as usize].g, 0, pcx);
    if at(Semi, pcx) {
        // (0.27.0: `struct Unit;`, the rust edition's: no fields)
        advance(pcx);
        let none = list_begin(pcx);
        list_end(n, none, pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    if at(LParen, pcx) {
        // RULE: F7.1 (`struct P<T>(pub T, U);`: fields named 0, 1, ..,
        // each private unless `pub`)
        advance(pcx);
        let mark = list_begin(pcx);
        let mut k: i64 = 0;
        while !at(RParen, pcx) && !at(Eof, pcx) {
            let field_start = cur_start(pcx);
            pcx.vis_tok = -1;
            let public = parse_vis(pcx);
            let field = new_node(NodeKind::Field, field_start, 0, pcx);
            mark_public(field, public, pcx);
            let name = buf_new();
            buf_fmt(name, format_args("{k}"));
            pcx.nodes[field as usize].a = intern(buf_slice(name), pcx);
            pcx.nodes[field as usize].b = parse_type(pcx);
            pcx.nodes[field as usize].end = prev_end(pcx);
            list_push(field, pcx);
            k += 1;
            if !eat(Comma, pcx) {
                break;
            }
        }
        expect(RParen, pcx);
        list_end(n, mark, pcx);
        pcx.where_owner = 0;
        parse_where(pcx.nodes[n as usize].g, 0, pcx);
        expect(Semi, pcx);
        pcx.nodes[n as usize].end = prev_end(pcx);
        return n;
    }
    expect(LBrace, pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        // (0.26.3: `#[deprecated]` before a field, its only attribute)
        take_deprecated(0, pcx);
        while at(Hash, pcx) {
            let attr_pos = cur_start(pcx);
            advance(pcx);
            expect(LBracket, pcx);
            let name = expect_ident(pcx);
            if !parse_deprecated_attribute(name, attr_pos, pcx) {
                name_error(attr_pos, c"unknown attribute '", name,
                    c"' before a field (expected deprecated)", pcx);
            }
            expect(RBracket, pcx);
        }
        let field_start = cur_start(pcx);
        // `pub` (0.5) is allowed: a field is visible wherever its struct is
        // (0.16: of a #[sealed] struct, only the `pub` ones outside its module).
        pcx.vis_tok = -1;
        let public = parse_vis(pcx);
        let field = new_node(NodeKind::Field, field_start, 0, pcx);
        // (0.16: what a #[sealed] struct shows outside its module)
        mark_public(field, public, pcx);
        pcx.nodes[field as usize].a = expect_binding_name(pcx);
        expect(Colon, pcx);
        pcx.nodes[field as usize].b = parse_type(pcx);
        pcx.nodes[field as usize].end = prev_end(pcx);
        take_deprecated(field, pcx);
        list_push(field, pcx);
        if !eat(Comma, pcx) {
            break;
        }
    }
    list_end(n, mark, pcx);
    expect(RBrace, pcx);
    // (0.18: `invariant COND`)
    parse_type_invariant(n, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

fn parse_const_or_static(kind: NodeKind, pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    advance(pcx);
    let n = new_node(kind, start, 0, pcx);
    if kind == NodeKind::Static {
        pcx.nodes[n as usize].d = crate::front::parser::eat_static_mut(n, pcx) as i64;
    }
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    expect(Colon, pcx);
    pcx.nodes[n as usize].b = parse_type(pcx);
    expect(Eq, pcx);
    pcx.nodes[n as usize].c = parse_expr(pcx);
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}

fn parse_type_alias(pcx: &mut Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Type, pcx);
    let n = new_node(NodeKind::TypeAlias, start, 0, pcx);
    pcx.nodes[n as usize].a = expect_binding_name(pcx);
    // `type Pair<T> = (T, T);` (0.6): generic, its parameters in `g`.
    pcx.nodes[n as usize].g = parse_generic_params(false, pcx);
    crate::front::parser::rust::bind_lifetimes(n, pcx);
    expect(Eq, pcx);
    // (0.18: `distinct T`, its invariant)
    pcx.nodes[n as usize].b = parse_alias_target(n, pcx);
    expect(Semi, pcx);
    pcx.nodes[n as usize].end = prev_end(pcx);
    n
}
