// Items: functions, structs, enums, constants, statics, type aliases,
// impl blocks and traits with their generic parameters, `use` and
// `import` lines, and the attributes before an item (`#[repr]`,
// `#[inline]`, `#[cold]`).

pub mod params;
pub mod attrs;
// (0.26.0) `embed wgsl NAME { .. }`
pub mod embed;

use crate::arch::note_intrinsic_node;
use crate::base::{SYMS, buf_new, buf_slice, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    buf_tool_command, err_begin, err_end, err_help, err_help_fmt, err_str, error_at,
    report_error_tries,
};
use crate::front::ast::{
    FN_BODY_FAILED, FN_EFFECT_DECL, FN_UNSAFE, ITEM_UNSAFE, NodeKind, REPR_C, REPR_INT, REPR_PACKED,
    REPR_UNION, REPR_WGSL, STRUCT_SCOPED, STRUCT_SEALED, child, list_begin, list_end, list_push,
    new_node,
};
use crate::front::check::name_error;
use crate::front::features::take_feature_attrs;
use crate::front::lexer::Tok;
use crate::front::lexer::Tok::{
    Arrow, As, Colon, ColonColon, Comma, Const, Enum, Eof, Eq, Extern, Fn, For, Gt, Hash, Impl,
    Import, Int, LBrace, LBracket, LParen, Lt, Mod, Plus, Pub, RBrace, RBracket, RParen, Reserved,
    Semi, Star, Static, Str, Struct, Trait, Type, Union, Unsafe, Use,
};
use crate::front::modules::vis::{note_vis, restricted_at, restriction_end, self_only};
use crate::front::parser::{
    advance, at, cur, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end,
    reserved_error, syntax_error, tok_kind,
};
use crate::front::parser::clauses::{
    FN_TEST_ATTR, at_cfg_test, parse_alias_target, parse_cfg_test_item, parse_clauses,
    parse_type_invariant, take_test_attrs, test_attribute,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::foreign::{
    at_link_attribute, link_block, parse_extern, parse_link_attributes,
};
use crate::front::parser::items::attrs::{
    check_fn_attributes, parse_deprecated_attribute, parse_fn_attribute, parse_fn_attributes,
    restore_deprecated, save_deprecated, take_deprecated, take_effect_decls,
};
use crate::front::parser::items::params::{
    begin_impl_params, end_impl_params, parse_params, parse_where,
};
use crate::front::parser::stmts::parse_block;
use crate::front::parser::types::{is_int_type_name, parse_bound, parse_type};
use crate::front::threadlocal::STATIC_THREAD_LOCAL;
use crate::tools::fix::note_obsolete_attr;

// One item (or the several items of an impl or extern block), pushed to
// the program's list.
pub fn parse_top_item(pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.vis_tok = -1;
        let public = parse_vis(&pcx);
        // (0.26.3: `unsafe impl Allocator for T`, `unsafe trait`)
        var unsafe_at = -1;
        if at(Unsafe, pcx) && (tok_kind(1, pcx) == Impl || tok_kind(1, pcx) == Trait) {
            unsafe_at = cur_start(pcx);
            advance(&pcx);
        }
        if at(Impl, pcx) {
            // The functions of an impl block are items of the program.
            parse_impl(false, unsafe_at, &pcx);
        } else if at(Trait, pcx) {
            let item = parse_trait(&pcx);
            if unsafe_at >= 0 {
                pcx.nodes[item].p |= ITEM_UNSAFE;
                pcx.nodes[item].start = unsafe_at;
            }
            mark_public(item, public, &pcx);
            list_push(item, &pcx);
        } else if at(Extern, pcx) {
            let mark = pcx.scratch.count;
            parse_extern(&pcx);
            for i in mark..pcx.scratch.count {
                mark_public(pcx.scratch.data[i], public, &pcx);
            }
        } else if at(Import, pcx) {
            parse_import(public, &pcx);
        } else if at(Use, pcx) {
            parse_use(public, &pcx);
        } else if at(Mod, pcx) {
            let start = cur_start(pcx);
            advance(&pcx);
            let n = new_node(NodeKind::Mod, start, 0, &pcx);
            pcx.nodes[n].a = expect_binding_name(&pcx);
            if eat(LBrace, &pcx) {
                // `mod name { items }` (0.6): its items are the program's, in
                // the module the loader made for the braces (modules.vl).
                pcx.nodes[n].end = prev_end(pcx);
                mark_public(n, public, &pcx);
                list_push(n, &pcx);
                while !at(RBrace, pcx) && !at(Eof, pcx) {
                    parse_top_item(&pcx);
                }
                expect(RBrace, &pcx);
                return;
            }
            expect(Semi, &pcx);
            pcx.nodes[n].end = prev_end(pcx);
            mark_public(n, public, &pcx);
            list_push(n, &pcx);
        } else if at_link_attribute(pcx) {
            // (0.25: what an extern block links, then the block)
            parse_link_attributes(&pcx);
            let mark = pcx.scratch.count;
            parse_top_item(&pcx);
            link_block(mark, &pcx);
        } else if at_cfg_test(&pcx) {
            // (0.18: the item, or a module's items, for tests only)
            parse_cfg_test_item(&pcx);
        } else if embed::at_embed_item(pcx) {
            let item = embed::parse_embed(&pcx);
            mark_public(item, public, &pcx);
            list_push(item, &pcx);
        } else if crate::front::parser::rust::take_array_builtin(&pcx) {
            // (0.27.0: the item is parsed and dropped)
            let mark = pcx.scratch.count;
            parse_top_item(&pcx);
            pcx.scratch.count = mark;
        } else if at(Hash, pcx) {
            let item = parse_attributed_item(public, &pcx);
            list_push(item, &pcx);
        } else {
            let item = parse_item(&pcx);
            mark_public(item, public, &pcx);
            list_push(item, &pcx);
        }
    }
}

pub const ITEM_PUBLIC: i64 = 1;

fn mark_public(item: i64, public: bool, pcx: inout Ctx<Comp>) {
    if public {
        pcx.nodes[item].p |= ITEM_PUBLIC;
        // (0.26.2: `pub(crate)`, ..., read by parse_vis)
        if pcx.vis_tok >= 0 {
            note_vis(item, pcx.vis_tok, &pcx);
        }
    }
}

// (0.26.2) `pub`, `pub(crate)`, `pub(super)`, `pub(self)`, `pub(in path)`
// at the cursor: whether the item is public (`pub(self)` is private); a
// restriction is left in VIS_TOK for mark_public (-1: plain `pub`). With
// no `pub` here, VIS_TOK is left as it was (`pub #[inline] fn`).
pub fn parse_vis(pcx: inout Ctx<Comp>) -> bool {
    if !at(Pub, pcx) {
        return false;
    }
    let p = pcx.p;
    advance(&pcx);
    if !restricted_at(p, pcx) {
        pcx.vis_tok = -1;
        return true;
    }
    let end = restriction_end(p, pcx);
    while pcx.p < end && !at(Eof, pcx) {
        advance(&pcx);
    }
    if self_only(p, pcx) {
        pcx.vis_tok = -1;
        return false;
    }
    pcx.vis_tok = p;
    true
}

fn parse_item(pcx: inout Ctx<Comp>) -> i64 {
    match cur(pcx) {
        Fn | Unsafe => parse_function(&pcx),
        Struct | Union => parse_struct(&pcx),
        Const => parse_const_or_static(NodeKind::Const, &pcx),
        Static => parse_const_or_static(NodeKind::Static, &pcx),
        Type => parse_type_alias(&pcx),
        Enum => parse_enum(&pcx),
        Reserved => reserved_error(&pcx),
        _ => syntax_error(c"expected an item ('fn', 'extern', 'struct', 'union', 'enum', 'impl', 'const', 'static' or 'type')", &pcx),
    }
}

// `impl T { fn ... }`, `impl<T> Vec<T> { ... }` or `impl Vec<i64> { ... }`:
// each function is pushed as an item, marked with the type's name (d) and
// the type (h); the impl's type parameters come first in its own (g).
fn parse_impl(public: bool, unsafe_at: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let impl_start = if unsafe_at >= 0 { unsafe_at } else { cur_start(pcx) };
        expect(Impl, &pcx);
        let params = parse_generic_params(false, &pcx);
        // (0.27.0: the impl's lifetimes, bound to each function as -f)
        let impl_lifetimes = pcx.lt_last;
        pcx.lt_last = 0;
        var self_type = parse_type(&pcx);
        // `impl Trait for Type` (0.9): any type.
        var trait_name = 0;
        if eat(For, &pcx) {
            trait_name = self_type;
            if pcx.nodes[trait_name].kind != NodeKind::TyName {
                error_at(pcx.nodes[trait_name].start, c"expected a trait's name before 'for'",
                    &pcx);
            }
            self_type = parse_type(&pcx);
            if pcx.nodes[self_type].kind == NodeKind::TyPtr
                && (pcx.nodes[self_type].p & crate::front::ast::NODE_REF) != 0
                && pcx.edition != 0 && crate::front::rust::rust_at(impl_start, &pcx) {
                // (0.27.0: an impl for `&T`, the rust edition's from 0.27.2)
                crate::front::rust::later(pcx.nodes[self_type].start, pcx.nodes[self_type].end,
                    "impl_for_ref", "0.27.2", &pcx);
            }
        } else if pcx.nodes[self_type].kind != NodeKind::TyName
            && !(pcx.nodes[self_type].kind == NodeKind::TySlice && params != 0) {
            error_at(pcx.nodes[self_type].start,
                c"impl blocks are for named types (structs and enums)", &pcx);
        }
        if unsafe_at >= 0 && trait_name == 0 {
            error_at(unsafe_at,
                c"an inherent impl is not unsafe: `unsafe impl` is an unsafe trait's impl (`unsafe impl Allocator for T`)", &pcx);
        }
        parse_where(params, 0, &pcx);
        let saved_outer = pcx.where_outer;
        pcx.where_outer = params;
        let fns = pcx.scratch.count;
        expect(LBrace, &pcx);
        while !at(RBrace, pcx) && !at(Eof, pcx) {
            if at(Type, pcx) {
                if trait_name == 0 {
                    error_at(cur_start(pcx), c"associated types are declared in an impl of a trait",
                        &pcx);
                }
                list_push(parse_assoc_type(true, &pcx), &pcx);
                continue;
            }
            // (0.27.0: a function parsed and dropped)
            let dropped = crate::front::parser::rust::take_array_builtin(&pcx);
            let attrs_start = cur_start(pcx);
            let flags = parse_fn_attributes(&pcx);
            pcx.vis_tok = -1;
            let item_public = parse_vis(&pcx) || public;
            if !at(Fn, pcx) && !(at(Unsafe, pcx) && tok_kind(1, pcx) == Fn) {
                if flags != 0 {
                    error_at(attrs_start, c"#[inline] and #[cold] go before a function", &pcx);
                }
                syntax_error(if trait_name != 0 { c"expected 'fn', 'type' or '}' in an impl block" }
                    else { c"expected 'fn' or '}' in an impl block" }, &pcx);
            }
            let f = parse_function(&pcx);
            if dropped {
                take_effect_decls(f, &pcx);
                continue;
            }
            if trait_name != 0 {
                no_param_defaults(f, c"a trait's function", &pcx);
            }
            pcx.nodes[f].p |= flags;
            take_effect_decls(f, &pcx);
            pcx.nodes[f].d = if pcx.nodes[self_type].kind
                == NodeKind::TyName { pcx.nodes[self_type].a }
                else { pcx.underscore };
            pcx.nodes[f].h = self_type;
            if impl_lifetimes != 0 {
                pcx.lt_last = impl_lifetimes;
                crate::front::parser::rust::bind_lifetimes(-f, &pcx);
            }
            if params != 0 {
                pcx.nodes[f].g = merge_generics(params, pcx.nodes[f].g, &pcx);
            }
            // (a trait's methods are as visible as the trait)
            mark_public(f, item_public || trait_name != 0, &pcx);
            list_push(f, &pcx);
        }
        expect(RBrace, &pcx);
        pcx.where_outer = saved_outer;
        let assoc = take_assoc_types(fns, impl_start, &pcx);
        if trait_name != 0 {
            let n = new_node(NodeKind::Impl, impl_start, prev_end(pcx), &pcx);
            pcx.nodes[n].a = trait_name;
            pcx.nodes[n].b = self_type;
            pcx.nodes[n].g = params;
            pcx.nodes[n].c = assoc;
            if unsafe_at >= 0 {
                pcx.nodes[n].p |= ITEM_UNSAFE;
            }
            let end = pcx.scratch.count;
            let mark = list_begin(pcx);
            for i in fns..end {
                list_push(pcx.scratch.data[i], &pcx);
            }
            list_end(n, mark, &pcx);
            list_push(n, &pcx);
        }
    }
}

// `type Name;` in a trait, `type Name = T;` in an impl (0.14): an
// AssocType node.
fn parse_assoc_type(in_impl: bool, pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Type, &pcx);
    let n = new_node(NodeKind::AssocType, start, 0, &pcx);
    pcx.nodes[n].a = expect_binding_name(&pcx);
    if in_impl {
        expect(Eq, &pcx);
        pcx.nodes[n].b = parse_type(&pcx);
    } else if at(Eq, pcx) {
        error_at(cur_start(pcx), c"an associated type has no default: write 'type Name;'", &pcx);
    } else if crate::front::parser::rust::skip_item_bounds("assoc_bounds", &pcx) {
        // (0.27.0: `type Item: Bound;`, the rust edition's from 0.27.2)
    } else if at(Colon, pcx) {
        error_at(cur_start(pcx), c"an associated type has no bounds: write 'type Name;'", &pcx);
    }
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// The AssocType nodes among SCRATCH[from..] moved to a holder node (a
// Generics node, 0.14), the others kept in order; 0 when there are none.
fn take_assoc_types(from: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let end = pcx.scratch.count;
        var found = false;
        for i in from..end {
            if pcx.nodes[pcx.scratch.data[i]].kind == NodeKind::AssocType {
                found = true;
            }
        }
        if !found {
            return 0;
        }
        let holder = new_node(NodeKind::Generics, pos, prev_end(pcx), &pcx);
        let mark = list_begin(pcx);
        for i in from..end {
            if pcx.nodes[pcx.scratch.data[i]].kind == NodeKind::AssocType {
                list_push(pcx.scratch.data[i], &pcx);
            }
        }
        list_end(holder, mark, &pcx);
        var w = from;
        for i in from..end {
            let x = pcx.scratch.data[i];
            if pcx.nodes[x].kind != NodeKind::AssocType {
                pcx.scratch.data[w] = x;
                w += 1;
            }
        }
        pcx.scratch.count = w;
        holder
    }
}

// `trait Name { fn m(self: *Self) -> T; fn d(self: *Self) { ... } }` (0.9;
// 0.15: `trait Name<T> { ... }`).
fn parse_trait(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Trait, &pcx);
    let n = new_node(NodeKind::Trait, start, 0, &pcx);
    pcx.nodes[n].a = expect_binding_name(&pcx);
    // (0.15: `trait From<T>`)
    pcx.nodes[n].g = parse_generic_params(false, &pcx);
    crate::front::parser::rust::bind_lifetimes(n, &pcx);
    // (0.27.0: `trait A: B`, the rust edition's supertraits, from 0.27.2)
    crate::front::parser::rust::skip_item_bounds("supertrait", &pcx);
    parse_where(pcx.nodes[n].g, 0, &pcx);
    expect(LBrace, &pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        if at(Type, pcx) {
            list_push(parse_assoc_type(false, &pcx), &pcx);
            continue;
        }
        let attrs_start = cur_start(pcx);
        let flags = parse_fn_attributes(&pcx);
        if at(Pub, pcx) {
            error_at(cur_start(pcx),
                c"the functions of a trait are as visible as the trait: no 'pub'", &pcx);
        }
        if !at(Fn, pcx) && !(at(Unsafe, pcx) && tok_kind(1, pcx) == Fn) {
            if flags != 0 {
                error_at(attrs_start, c"#[inline] and #[cold] go before a function", &pcx);
            }
            syntax_error(c"expected 'fn', 'type' or '}' in a trait", &pcx);
        }
        let fstart = cur_start(pcx);
        let is_unsafe = eat(Unsafe, &pcx);
        expect(Fn, &pcx);
        let f = new_node(NodeKind::Fn, fstart, 0, &pcx);
        pcx.nodes[f].p |= flags;
        take_effect_decls(f, &pcx);
        if is_unsafe {
            pcx.nodes[f].p |= FN_UNSAFE;
        }
        pcx.nodes[f].a = expect_binding_name(&pcx);
        pcx.nodes[f].g = parse_generic_params(false, &pcx);
        crate::front::parser::rust::bind_lifetimes(f, &pcx);
        expect(LParen, &pcx);
        let owner = begin_impl_params(f, &pcx);
        parse_params(f, false, &pcx);
        end_impl_params(f, owner, &pcx);
        no_param_defaults(f, c"a trait function", &pcx);
        expect(RParen, &pcx);
        pcx.nodes[f].b = parse_return_type(&pcx);
        parse_where(pcx.nodes[f].g, pcx.nodes[n].g, &pcx);
        // (0.18: requires/ensures)
        parse_clauses(f, &pcx);
        if !eat(Semi, &pcx) {
            pcx.nodes[f].c = parse_fn_body(f, &pcx);
        }
        pcx.nodes[f].end = prev_end(pcx);
        list_push(f, &pcx);
    }
    pcx.nodes[n].b = take_assoc_types(mark, start, &pcx);
    list_end(n, mark, &pcx);
    expect(RBrace, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// The parameters of an impl block followed by those of one of its
// functions (`a` counts the impl's).
fn merge_generics(outer: i64, own: i64, pcx: inout Ctx<Comp>) -> i64 {
    let n = new_node(NodeKind::Generics, pcx.nodes[outer].start, pcx.nodes[outer].end, &pcx);
    let mark = list_begin(pcx);
    for i in 0..pcx.nodes[outer].count {
        list_push(child(outer, i, pcx), &pcx);
    }
    if own != 0 {
        for i in 0..pcx.nodes[own].count {
            list_push(child(own, i, pcx), &pcx);
        }
    }
    list_end(n, mark, &pcx);
    pcx.nodes[n].a = pcx.nodes[outer].count;
    n
}

// `<T, U>` after the name of a generic item (0.5); 0 when there is none.
// (0.16) A parameter may have a default, `A: Allocator = Gpa` (its b), in
// a struct or an enum (`defaults`), after those without one.
fn parse_generic_params(defaults: bool, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if !at(Lt, pcx) {
            return 0;
        }
        let n = new_node(NodeKind::Generics, cur_start(pcx), 0, &pcx);
        advance(&pcx);
        let mark = list_begin(pcx);
        let lifetimes = crate::front::parser::rust::lifetimes_begin(pcx);
        while !at(Gt, pcx) && !at(Eof, pcx) {
            // (0.27.0) `'a`, `'a: 'b`: the rust edition's, kept apart
            if crate::front::parser::rust::take_lifetime(true, &pcx) {
                if !eat(Comma, &pcx) {
                    break;
                }
                continue;
            }
            let param = new_node(NodeKind::TyName, cur_start(pcx), 0, &pcx);
            pcx.nodes[param].a = expect_binding_name(&pcx);
            pcx.nodes[param].end = prev_end(pcx);
            if eat(Colon, &pcx) {
                // Bounds (0.9): `T: Hash + Eq`, a Generics node of trait names
                // (0.14: or `Fn(A) -> R`, `Iterator<Item = A>`: parse_bound).
                let bounds = new_node(NodeKind::Generics, cur_start(pcx), 0, &pcx);
                let bmark = list_begin(pcx);
                loop {
                    if !crate::front::parser::rust::skip_lifetime_bound(&pcx) {
                        list_push(parse_bound(&pcx), &pcx);
                    }
                    if !eat(Plus, &pcx) {
                        break;
                    }
                }
                list_end(bounds, bmark, &pcx);
                pcx.nodes[bounds].end = prev_end(pcx);
                pcx.nodes[param].h = bounds;
            }
            if at(Eq, pcx) {
                let eq = cur_start(pcx);
                advance(&pcx);
                pcx.nodes[param].b = parse_type(&pcx);
                if !defaults && !crate::front::parser::rust::rust_here(&pcx) {
                    error_at(eq, c"only the type parameters of a struct or an enum have defaults",
                        &pcx);
                }
            } else if defaults {
                for i in mark..pcx.scratch.count {
                    if pcx.nodes[pcx.scratch.data[i]].b != 0 {
                        name_error(pcx.nodes[param].start, c"type parameter '", pcx.nodes[param].a,
                            c"' needs a default: those after a parameter with a default have one", &pcx);
                    }
                }
            }
            for i in mark..pcx.scratch.count {
                if pcx.nodes[pcx.scratch.data[i]].a == pcx.nodes[param].a {
                    name_error(pcx.nodes[param].start, c"duplicate type parameter '",
                        pcx.nodes[param].a, c"'", &pcx);
                }
            }
            list_push(param, &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
        list_end(n, mark, &pcx);
        let only_lifetimes = pcx.nodes[n].count == 0 && pcx.lt_scratch.count > lifetimes;
        crate::front::parser::rust::lifetimes_end(lifetimes, &pcx);
        if pcx.nodes[n].count == 0 && !only_lifetimes {
            error_at(pcx.nodes[n].start, c"expected a type parameter", &pcx);
        }
        expect(Gt, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        if only_lifetimes { 0 } else { n }
    }
}

// `enum E { A, B(T, ...), C { x: T, ... }, D = expr, ... }`
fn parse_enum(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Enum, &pcx);
    let n = new_node(NodeKind::Enum, start, 0, &pcx);
    pcx.nodes[n].a = expect_binding_name(&pcx);
    pcx.nodes[n].g = parse_generic_params(true, &pcx);
    crate::front::parser::rust::bind_lifetimes(n, &pcx);
    parse_where(pcx.nodes[n].g, 0, &pcx);
    expect(LBrace, &pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        let variant = new_node(NodeKind::Variant, cur_start(pcx), 0, &pcx);
        pcx.nodes[variant].a = expect_binding_name(&pcx);
        if at(LBrace, pcx) {
            // (0.17) `V { a: A, b: B }`
            parse_variant_fields(variant, &pcx);
        } else if eat(LParen, &pcx) {
            pcx.nodes[variant].c = 1;
            let types = list_begin(pcx);
            while !at(RParen, pcx) && !at(Eof, pcx) {
                list_push(parse_type(&pcx), &pcx);
                if !eat(Comma, &pcx) {
                    break;
                }
            }
            list_end(variant, types, &pcx);
            expect(RParen, &pcx);
        }
        if eat(Eq, &pcx) {
            pcx.nodes[variant].b = parse_expr(&pcx);
        }
        pcx.nodes[variant].end = prev_end(pcx);
        list_push(variant, &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    expect(RBrace, &pcx);
    // (0.18: `invariant COND`)
    parse_type_invariant(n, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// (0.17) The fields of `V { a: A, b: B }`, after the variant's name: the
// variant's list holds the types (as for `V(A, B)`, c = 1), its d a node
// whose list holds a Field node per field (a: the name, b: 0).
fn parse_variant_fields(variant: i64, pcx: inout Ctx<Comp>) {
    let names = new_node(NodeKind::None, cur_start(pcx), 0, &pcx);
    expect(LBrace, &pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        let field = new_node(NodeKind::Field, cur_start(pcx), 0, &pcx);
        pcx.nodes[field].a = expect_binding_name(&pcx);
        pcx.nodes[field].end = prev_end(pcx);
        expect(Colon, &pcx);
        // (the type, kept on the stack after its field until the end)
        pcx.nodes[field].c = parse_type(&pcx);
        list_push(field, &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(names, mark, &pcx);
    expect(RBrace, &pcx);
    pcx.nodes[names].end = prev_end(pcx);
    let types = list_begin(pcx);
    for i in 0..pcx.nodes[names].count {
        let field = child(names, i, pcx);
        list_push(pcx.nodes[field].c, &pcx);
        pcx.nodes[field].c = 0;
    }
    list_end(variant, types, &pcx);
    pcx.nodes[variant].c = (pcx.nodes[names].count > 0) as i64;
    pcx.nodes[variant].d = names;
}

pub fn parse_function(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    // `unsafe fn` (0.9).
    let is_unsafe = eat(Unsafe, &pcx);
    expect(Fn, &pcx);
    let n = new_node(NodeKind::Fn, start, 0, &pcx);
    if is_unsafe {
        pcx.nodes[n].p |= FN_UNSAFE;
    }
    pcx.nodes[n].a = expect_binding_name(&pcx);
    pcx.nodes[n].g = parse_generic_params(false, &pcx);
    crate::front::parser::rust::bind_lifetimes(n, &pcx);
    expect(LParen, &pcx);
    let owner = begin_impl_params(n, &pcx);
    parse_params(n, false, &pcx);
    end_impl_params(n, owner, &pcx);
    expect(RParen, &pcx);
    pcx.nodes[n].b = parse_return_type(&pcx);
    // (0.26.2) `where T: Display` (an impl's function: also the impl's
    // parameters, WHERE_OUTER)
    parse_where(pcx.nodes[n].g, pcx.where_outer, &pcx);
    // (0.18: requires/ensures, front/parser/clauses.vl)
    parse_clauses(n, &pcx);
    // (0.19) A declaration of std::arch's (arch/virtual.vl): `;` for
    // its body.
    if pcx.intrinsic_pending >= 0 {
        note_intrinsic_node(n, pcx.intrinsic_pending, &pcx);
        pcx.intrinsic_pending = -1;
        if eat(Semi, &pcx) {
            pcx.nodes[n].end = prev_end(pcx);
            return n;
        }
    }
    take_feature_attrs(n, &pcx);
    pcx.nodes[n].c = parse_fn_body(n, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// The body of function n; one with a syntax error is marked so (the
// checker leaves it out).
fn parse_fn_body(n: i64, pcx: inout Ctx<Comp>) -> i64 {
    let saved = pcx.body_failed;
    pcx.body_failed = false;
    let body = parse_block(&pcx);
    if pcx.body_failed {
        pcx.nodes[n].p |= FN_BODY_FAILED;
    }
    pcx.body_failed = saved;
    body
}

// `use a::b::c;`, `use a::b::{c, d as e};`, `use a::b as x;` (0.5; 0.4
// had `use E::{A, B};` for the variants of an enum). `use a::b::*;` and
// `use E::*;` are parsed for --fix-imports, and are an error otherwise
// (0.8). c = a Path node whose list is the segments before the braces (or
// the star), b = 1 for `*`, list = the imported names (Ident nodes: a =
// the name, b = its new name, 0 for none).
fn parse_use(public: bool, pcx: inout Ctx<Comp>) {
    let start = cur_start(pcx);
    expect(Use, &pcx);
    let n = new_node(NodeKind::Use, start, 0, &pcx);
    let path = new_node(NodeKind::Path, cur_start(pcx), 0, &pcx);
    let segments = list_begin(pcx);
    let mark = list_begin(pcx);
    var last = 0;
    loop {
        let seg = new_node(NodeKind::Ident, cur_start(pcx), 0, &pcx);
        pcx.nodes[seg].a = expect_ident(&pcx);
        pcx.nodes[seg].end = prev_end(pcx);
        if !eat(ColonColon, &pcx) {
            last = seg;
            break;
        }
        list_push(seg, &pcx);
        if at(Star, pcx) || at(LBrace, pcx) {
            break;
        }
    }
    list_end(path, segments, &pcx);
    pcx.nodes[path].end = prev_end(pcx);
    pcx.nodes[n].c = path;
    let items = list_begin(pcx);
    if last != 0 {
        if eat(As, &pcx) {
            pcx.nodes[last].b = expect_binding_name(&pcx);
        }
        list_push(last, &pcx);
    } else if eat(Star, &pcx) {
        pcx.nodes[n].b = 1;
    } else {
        expect(LBrace, &pcx);
        while !at(RBrace, pcx) && !at(Eof, pcx) {
            let item = new_node(NodeKind::Ident, cur_start(pcx), 0, &pcx);
            pcx.nodes[item].a = expect_ident(&pcx);
            if eat(As, &pcx) {
                pcx.nodes[item].b = expect_binding_name(&pcx);
            }
            pcx.nodes[item].end = prev_end(pcx);
            list_push(item, &pcx);
            if !eat(Comma, &pcx) {
                break;
            }
        }
        expect(RBrace, &pcx);
    }
    list_end(n, items, &pcx);
    if pcx.nodes[path].count == 0 && pcx.nodes[n].b == 0 {
        err_begin(start, &pcx);
        err_str(c"a use names an item through a path: 'use module::item;'", pcx);
        if last != 0 {
            // (0.25.2.2, eval 0.25.2.1: sph) `use cpu;` for a module of
            // the crate, which needs none
            let t = SYMS[pcx.nodes[last].a].text;
            if t == "std" {
                err_help_fmt(
                    format_args("std is in scope by its name already, with no `use`: `std::f()`; its items by name: `use std::{{f}};`"), pcx);
            } else {
                err_help_fmt(
                    format_args("a module of the crate is in scope by its name already, with no `use`: `{t}::f()`; its items by name: `use crate::{t}::{{f}};`"), pcx);
            }
        }
        err_end(&pcx);
    }
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    mark_public(n, public, &pcx);
    let _ = mark;
    list_push(n, &pcx);
}

// `import "header.h" as c;`: the declarations of a C header become part
// of the program (cimport.vl; the driver reads the imports before
// parsing). They live in a module of their own, which the importing
// module names `c`: `c::printf`. `import "header.h";`, which brought
// them all into scope, is parsed for --fix-imports, and is an error
// otherwise (0.8). A Use node with d = 2 and a = that name (0: none).
fn parse_import(public: bool, pcx: inout Ctx<Comp>) {
    let start = cur_start(pcx);
    expect(Import, &pcx);
    if !at(Str, pcx) {
        syntax_error(c"expected the name of a C header as a string", &pcx);
    }
    advance(&pcx);
    let n = new_node(NodeKind::Use, start, 0, &pcx);
    pcx.nodes[n].d = 2;
    if eat(As, &pcx) {
        pcx.nodes[n].a = expect_binding_name(&pcx);
    }
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    mark_public(n, public, &pcx);
    list_push(n, &pcx);
}

// Attributes, then the item: `#[repr(...)]` before a struct, union or
// enum; `#[derive(...)]` (0.15) before a struct or an enum; `#[inline]`, `#[inline(never)]`, `#[cold]` (0.6) before a function.
// `pub` may come before the attributes or (0.6) after them.
fn parse_attributed_item(public: bool, pcx: inout Ctx<Comp>) -> i64 {
    var flags = 0;
    var fn_flags = 0;
    var repr = false;
    var align = 0;
    var pack = 0;
    var int_type = 0;
    let at_start = cur_start(pcx);
    var derives = 0;
    var derive_mark = 0;
    // (0.16: #[sealed], #[scoped])
    var struct_flags = 0;
    // (0.21: #[thread_local])
    var thread_local = false;
    var deprecated = false;
    take_effect_decls(0, &pcx);
    while at(Hash, pcx) {
        let attr_pos = cur_start(pcx);
        advance(&pcx);
        expect(LBracket, &pcx);
        let name = expect_ident(&pcx);
        // (0.26.3: #[deprecated], on any item)
        if parse_deprecated_attribute(name, attr_pos, &pcx) {
            deprecated = true;
            expect(RBracket, &pcx);
            continue;
        }
        // (0.18: #[test], #[property], #[fuzz], #[cfg(test)])
        if test_attribute(name, &pcx) {
            fn_flags |= FN_TEST_ATTR;
            expect(RBracket, &pcx);
            continue;
        }
        let fn_flag = parse_fn_attribute(name, attr_pos, &pcx);
        if fn_flag != 0 {
            fn_flags |= fn_flag;
            expect(RBracket, &pcx);
            continue;
        }
        if name == intern_c(c"derive") {
            // `#[derive(Eq, Ord, ...)]` (0.15): the traits, TyNames in a
            // holder (several derive attributes add to one)
            if derives == 0 {
                derives = new_node(NodeKind::Generics, attr_pos, 0, &pcx);
                derive_mark = list_begin(pcx);
            }
            expect(LParen, &pcx);
            while !at(RParen, pcx) && !at(Eof, pcx) {
                list_push(parse_type(&pcx), &pcx);
                if !eat(Comma, &pcx) {
                    break;
                }
            }
            expect(RParen, &pcx);
            expect(RBracket, &pcx);
            pcx.nodes[derives].end = prev_end(pcx);
            continue;
        }
        if name == intern_c(c"thread_local") {
            thread_local = true;
            expect(RBracket, &pcx);
            continue;
        }
        if name == intern_c(c"sealed") || name == intern_c(c"scoped") {
            struct_flags |= if name == intern_c(c"sealed") { STRUCT_SEALED }
                else { STRUCT_SCOPED };
            expect(RBracket, &pcx);
            if name == intern_c(c"sealed") {
                obsolete_sealed(attr_pos, prev_end(pcx), &pcx);
            }
            continue;
        }
        if name != intern_c(c"repr") {
            name_error(pcx.toks[pcx.p - 1].start, c"unknown attribute '", name,
                c"' (expected repr, derive, sealed, scoped, inline, inline(never), cold, effects, pure, no_alloc, no_io, no_panic, views or stores)", &pcx);
        }
        repr = true;
        expect(LParen, &pcx);
        while !at(RParen, pcx) && !at(Eof, pcx) {
            let pos = cur_start(pcx);
            let arg = expect_ident(&pcx);
            if arg == intern_c(c"C") {
                flags |= REPR_C;
            } else if arg == intern_c(c"packed") {
                flags |= REPR_PACKED;
                pack = 1;
                if eat(LParen, &pcx) {
                    // packed(N): fields aligned to at most N (0.4; GCC's
                    // #pragma pack(N)).
                    if !at(Int, pcx) {
                        syntax_error(c"expected the packing", &pcx);
                    }
                    pack = pcx.toks[pcx.p].value as i64;
                    advance(&pcx);
                    expect(RParen, &pcx);
                    if pack < 1 || pack > 16 || (pack & (pack - 1)) != 0 {
                        error_at(pos, c"packed(N) needs a power of two from 1 to 16", &pcx);
                    }
                }
            } else if arg == intern_c(c"align") {
                expect(LParen, &pcx);
                if !at(Int, pcx) {
                    syntax_error(c"expected the alignment", &pcx);
                }
                align = pcx.toks[pcx.p].value as i64;
                advance(&pcx);
                expect(RParen, &pcx);
                if align < 1 || align > 4096 || (align & (align - 1)) != 0 {
                    error_at(pos, c"align(N) needs a power of two from 1 to 4096", &pcx);
                }
            } else if arg == intern_c(c"wgsl") {
                flags |= REPR_WGSL;
            } else if is_int_type_name(arg) {
                flags |= REPR_INT;
                int_type = arg;
            }
            else if arg == intern_c(c"transparent") && crate::front::parser::rust::rust_here(&pcx) {
                // (0.27.0: the rust edition's; a struct of one field is laid
                // out as the field already)
            } else {
                name_error(pos, c"unknown repr '", arg,
                    c"' (expected C, packed, align(N), wgsl or an integer type)", &pcx);
            }
            if !eat(Comma, &pcx) {
                break;
            }
        }
        expect(RParen, &pcx);
        expect(RBracket, &pcx);
    }
    // (0.26.3: the #[deprecated], kept while the item is parsed: a
    // struct's fields, a trait's functions have their own)
    let dep = save_deprecated(&pcx);
    if derives != 0 {
        list_end(derives, derive_mark, &pcx);
        if pcx.nodes[derives].count == 0 {
            error_at(pcx.nodes[derives].start,
                c"expected the traits to derive: '#[derive(Eq, Ord, Hash, Debug, Clone)]'", &pcx);
        }
    }
    let item_public = parse_vis(&pcx) || public;
    if derives != 0 && !at(Struct, pcx) && !at(Enum, pcx) {
        error_at(pcx.nodes[derives].start, c"#[derive(...)] goes before a struct or an enum", &pcx);
    }
    if thread_local {
        if fn_flags != 0 || repr || derives != 0 || struct_flags != 0 {
            error_at(at_start, c"#[thread_local] takes no other attribute", &pcx);
        }
        let item = parse_item(&pcx);
        if pcx.nodes[item].kind != NodeKind::Static || pcx.nodes[item].d == 0 {
            error_at(at_start, c"#[thread_local] goes before a `static mut`", &pcx);
        }
        pcx.nodes[item].p |= STATIC_THREAD_LOCAL;
        restore_deprecated(dep, at_start, &pcx);
        take_deprecated(item, &pcx);
        mark_public(item, item_public, &pcx);
        return item;
    }
    if fn_flags != 0 {
        if repr {
            error_at(at_start, c"#[repr(...)] and function attributes cannot be combined", &pcx);
        }
        if struct_flags != 0 {
            error_at(at_start, c"#[sealed] and #[scoped] are for structs, not functions", &pcx);
        }
        if !at(Fn, pcx) && !(at(Unsafe, pcx) && tok_kind(1, pcx) == Fn) {
            error_at(at_start, if fn_flags == FN_EFFECT_DECL {
                c"effect declarations go before a function" }
                else { c"#[inline] and #[cold] go before a function" }, &pcx);
        }
        check_fn_attributes(fn_flags, at_start, &pcx);
        let f = parse_function(&pcx);
        pcx.nodes[f].p |= fn_flags;
        restore_deprecated(dep, at_start, &pcx);
        take_effect_decls(f, &pcx);
        take_test_attrs(f, &pcx);
        mark_public(f, item_public, &pcx);
        return f;
    }
    if deprecated && !repr && derives == 0 && struct_flags == 0 {
        // (0.26.3: #[deprecated] alone, before any item or a trait)
        let item = if at(Trait, pcx) { parse_trait(&pcx) } else { parse_item(&pcx) };
        restore_deprecated(dep, at_start, &pcx);
        take_deprecated(item, &pcx);
        mark_public(item, item_public, &pcx);
        return item;
    }
    if struct_flags != 0 && !at(Struct, pcx) {
        error_at(at_start, c"#[sealed] and #[scoped] go before a struct", &pcx);
    }
    if !at(Struct, pcx) && !at(Union, pcx) && !at(Enum, pcx) {
        error_at(at_start, c"#[repr(...)] goes before a struct, union or enum", &pcx);
    }
    if ((flags & REPR_PACKED) != 0 || align != 0) && (flags & REPR_C) == 0 {
        error_at(at_start, c"packed and align(N) are only for #[repr(C, ...)] types", &pcx);
    }
    if (flags & REPR_PACKED) != 0 && align != 0 {
        error_at(at_start, c"a type cannot be both packed and aligned", &pcx);
    }
    if (flags & REPR_WGSL) != 0 && ((flags & (REPR_C | REPR_INT)) != 0 || align != 0
        || !(at(Struct, pcx) || (at(Pub, pcx) && tok_kind(1, pcx) == Struct))) {
        error_at(at_start, c"#[repr(wgsl)] goes alone before a struct: its layout is WGSL's", &pcx);
    }
    let item = parse_item(&pcx);
    pcx.nodes[item].h = derives;
    pcx.nodes[item].c |= struct_flags;
    if pcx.nodes[item].kind == NodeKind::Enum {
        if (flags & REPR_PACKED) != 0 || align != 0 {
            error_at(at_start, c"packed and align(N) are for structs and unions, not enums", &pcx);
        }
        pcx.nodes[item].d = int_type;
    } else {
        if (flags & REPR_INT) != 0 {
            error_at(at_start, c"an integer repr is for enums only", &pcx);
        }
        // For packed types, `d` is the packing (1 for plain packed).
        pcx.nodes[item].d = if pack != 0 { pack } else { align };
    }
    pcx.nodes[item].c = pcx.nodes[item].c | flags;
    restore_deprecated(dep, at_start, &pcx);
    take_deprecated(item, &pcx);
    mark_public(item, item_public, &pcx);
    item
}

// (0.26.0) `#[sealed]` at SRC[start..end): what it asked for is every
// struct's rule, so it is warned about, and `volec fix --only
// obsolete-attr` deletes it.
fn obsolete_sealed(start: i64, end: i64, pcx: inout Ctx<Comp>) {
    note_obsolete_attr(start, end, &pcx);
    let tries = buf_new();
    buf_tool_command(tries, "fix --only obsolete-attr", true, pcx);
    report_error_tries(start, 7201, c"attr.obsolete",
        c"'#[sealed]' is the default from 0.26: every field not marked 'pub' is private to its module",
        c"delete it (`volec fix --only obsolete-attr` deletes every one)", buf_slice(tries), true,
        &pcx);
}

// Function `f` (a Fn or ExternFn) is one whose parameters cannot have
// defaults (0.15: those of trait functions and extern functions): an
// error at the first one that has one.
pub fn no_param_defaults(f: i64, what: *u8, pcx: inout Ctx<Comp>) {
    for i in 0..pcx.nodes[f].count {
        let p = child(f, i, pcx);
        if pcx.nodes[p].h != 0 {
            err_begin(pcx.nodes[pcx.nodes[p].h].start, &pcx);
            err_str(
                c"a default value is for a parameter of a function or an inherent method, not of ", pcx);
            err_str(what, pcx);
            err_help(c"remove the '= value'; the callers pass the argument", pcx);
            err_end(&pcx);
        }
    }
}

pub fn parse_return_type(pcx: inout Ctx<Comp>) -> i64 {
    if eat(Arrow, &pcx) { parse_type(&pcx) } else { 0 }
}

fn parse_struct(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    let is_union = at(Union, pcx);
    advance(&pcx);
    let n = new_node(NodeKind::Struct, start, 0, &pcx);
    if is_union {
        pcx.nodes[n].c = REPR_UNION;
    }
    pcx.nodes[n].a = expect_binding_name(&pcx);
    pcx.nodes[n].g = parse_generic_params(true, &pcx);
    crate::front::parser::rust::bind_lifetimes(n, &pcx);
    parse_where(pcx.nodes[n].g, 0, &pcx);
    if at(Semi, pcx) && crate::front::parser::rust::rust_here(&pcx) {
        // (0.27.0: `struct Unit;`, the rust edition's: no fields)
        advance(&pcx);
        let none = list_begin(pcx);
        list_end(n, none, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    if at(LParen, pcx) && crate::front::parser::rust::rust_here(&pcx) {
        // (0.27.0: `struct P(T, U);`, the rust edition's from 0.27.2)
        let at_paren = cur_start(pcx);
        crate::front::parser::rust::skip_parens(&pcx);
        eat(Semi, &pcx);
        crate::front::rust::later(at_paren, prev_end(pcx), "tuple_struct", "0.27.2", &pcx);
        let none = list_begin(pcx);
        list_end(n, none, &pcx);
        pcx.nodes[n].end = prev_end(pcx);
        return n;
    }
    expect(LBrace, &pcx);
    let mark = list_begin(pcx);
    while !at(RBrace, pcx) && !at(Eof, pcx) {
        // (0.26.3: `#[deprecated]` before a field, its only attribute)
        take_deprecated(0, &pcx);
        while at(Hash, pcx) {
            let attr_pos = cur_start(pcx);
            advance(&pcx);
            expect(LBracket, &pcx);
            let name = expect_ident(&pcx);
            if !parse_deprecated_attribute(name, attr_pos, &pcx) {
                name_error(attr_pos, c"unknown attribute '", name,
                    c"' before a field (expected deprecated)", &pcx);
            }
            expect(RBracket, &pcx);
        }
        let field_start = cur_start(pcx);
        // `pub` (0.5) is allowed: a field is visible wherever its struct is
        // (0.16: of a #[sealed] struct, only the `pub` ones outside its module).
        pcx.vis_tok = -1;
        let public = parse_vis(&pcx);
        let field = new_node(NodeKind::Field, field_start, 0, &pcx);
        // (0.16: what a #[sealed] struct shows outside its module)
        mark_public(field, public, &pcx);
        pcx.nodes[field].a = expect_binding_name(&pcx);
        expect(Colon, &pcx);
        pcx.nodes[field].b = parse_type(&pcx);
        pcx.nodes[field].end = prev_end(pcx);
        take_deprecated(field, &pcx);
        list_push(field, &pcx);
        if !eat(Comma, &pcx) {
            break;
        }
    }
    list_end(n, mark, &pcx);
    expect(RBrace, &pcx);
    // (0.18: `invariant COND`)
    parse_type_invariant(n, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn parse_const_or_static(kind: NodeKind, pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    advance(&pcx);
    let n = new_node(kind, start, 0, &pcx);
    if kind == NodeKind::Static {
        pcx.nodes[n].d = crate::front::parser::eat_static_mut(n, &pcx) as i64;
    }
    pcx.nodes[n].a = expect_binding_name(&pcx);
    expect(Colon, &pcx);
    pcx.nodes[n].b = parse_type(&pcx);
    expect(Eq, &pcx);
    pcx.nodes[n].c = parse_expr(&pcx);
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}

fn parse_type_alias(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    expect(Type, &pcx);
    let n = new_node(NodeKind::TypeAlias, start, 0, &pcx);
    pcx.nodes[n].a = expect_binding_name(&pcx);
    // `type Pair<T> = (T, T);` (0.6): generic, its parameters in `g`.
    pcx.nodes[n].g = parse_generic_params(false, &pcx);
    crate::front::parser::rust::bind_lifetimes(n, &pcx);
    expect(Eq, &pcx);
    // (0.18: `distinct T`, its invariant)
    pcx.nodes[n].b = parse_alias_target(n, &pcx);
    expect(Semi, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    n
}
