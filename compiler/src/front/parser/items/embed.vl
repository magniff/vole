// Embedded blocks (0.26.0), an item: `embed wgsl NAME { WGSL }` or
// `embed wgsl NAME from "x.wgsl";`. `embed`, the language and `from` are
// identifiers (three in a row start no other item); the lexer made the
// block's text one Tok::Embedded token (lexer/embedded.vl). The Embed
// node (front::ast) holds its text; front/embed/wgsl.vl gives it meaning.

use crate::base::{SRC, intern_c};
use crate::base::diag::{ERR_KIND, err_begin, err_end_soft, err_help, err_str, err_sym};
use crate::front::ast::{NODES, NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::embed::embed_block_file;
use crate::front::lexer::{TOKS, Tok, Token, add_string, str_at};
use crate::front::parser::{
    advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end, syntax_error,
    tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::types::parse_type_name;

// Whether an embedded block starts here: `embed`, then two identifiers.
pub fn at_embed_item() -> bool {
    at_word(c"embed") && tok_kind(1) == Tok::Ident && tok_kind(2) == Tok::Ident
}

// Whether the token here is the identifier `word`.
fn at_word(word: *u8) -> bool {
    at(Tok::Ident) && here().value as i64 == intern_c(word)
}

// The token here, the parser's.
fn here() -> Token {
    // UNSAFE: TOKS is the lexer's raw token array.
    // SAFETY: P is the parser's position, a token the lexer wrote (the last
    // one is Eof, so P < TOK_COUNT).
    unsafe { TOKS[crate::front::parser::P] }
}

// The block at `embed`: its Embed node.
pub fn parse_embed() -> i64 {
    let start = cur_start();
    advance();
    let lang_pos = cur_start();
    let lang = expect_ident();
    let name_pos = cur_start();
    let name = expect_binding_name();
    let n = new_node(NodeKind::Embed, start, 0);
    NODES[n].a = name;
    NODES[n].b = lang;
    NODES[n].d = -1;
    NODES[n].y = name_pos;
    if at_word(c"with") {
        // (0.26.2) its parts: paths, `A, b::B`, each a TyName (the
        // segments before the name in its list), the Embed node's list
        advance();
        let mark = list_begin();
        loop {
            list_push(parse_type_name(cur_start()));
            if !eat(Tok::Comma) {
                break;
            }
        }
        list_end(n, mark);
    }
    if lang != intern_c(c"wgsl") {
        let saved = ERR_KIND;
        ERR_KIND = c"embed.language";
        err_begin(lang_pos);
        err_str(c"no embedded language '");
        err_sym(lang);
        err_str(c"': the one language is wgsl");
        err_help(
            c"an embedded block is `embed wgsl NAME { .. }` or `embed wgsl NAME from \"x.wgsl\";`");
        err_end_soft();
        ERR_KIND = saved;
    }
    if eat(Tok::LBrace) {
        var id = -1;
        if at(Tok::Embedded) {
            let t = here();
            NODES[n].d = t.start;
            id = add_string(SRC[t.start..t.end]);
            advance();
        } else {
            id = add_string("");
            NODES[n].d = prev_end();
        }
        NODES[n].c = id;
        expect(Tok::RBrace);
    } else if at_word(c"from") {
        advance();
        if at(Tok::Str) {
            let at_str = cur_start();
            let rel = str_at(here().value as i64);
            NODES[n].h = at_str;
            NODES[n].x = here().value as i64;
            NODES[n].c = embed_block_file(at_str, rel,
                SRC[start..prev_end()]);
            advance();
        } else {
            let saved = ERR_KIND;
            ERR_KIND = c"embed.path";
            err_begin(cur_start());
            err_str(c"'embed ");
            err_sym(lang);
            err_str(c" ");
            err_sym(name);
            err_str(c" from' takes its file's path as a string literal");
            err_help(c"the file is read when the program is compiled: `embed wgsl K from \"shader.wgsl\";`, relative to this file's directory");
            err_end_soft();
            ERR_KIND = saved;
            parse_expr();
            NODES[n].h = start;
            NODES[n].c = add_string("");
        }
        expect(Tok::Semi);
    } else {
        syntax_error(
            c"expected '{' (the block's text), 'from \"path\";' or 'with' and its parts after the block's name");
    }
    NODES[n].end = prev_end();
    n
}
