// Embedded blocks (0.26.0), an item: `embed wgsl NAME { WGSL }` or
// `embed wgsl NAME from "x.wgsl";`. `embed`, the language and `from` are
// identifiers (three in a row start no other item); the lexer made the
// block's text one Tok::Embedded token (lexer/embedded.vl). The Embed
// node (front::ast) holds its text; front/embed/wgsl.vl gives it meaning.

use crate::base::{SRC, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end_soft, err_help, err_str, err_sym};
use crate::front::ast::{NODES, NodeKind, list_begin, list_end, list_push, new_node};
use crate::front::embed::embed_block_file;
use crate::front::lexer::{Tok, Token, add_string, str_at};
use crate::front::parser::{
    advance, at, cur_start, eat, expect, expect_binding_name, expect_ident, prev_end, syntax_error,
    tok_kind,
};
use crate::front::parser::exprs::parse_expr;
use crate::front::parser::types::parse_type_name;

// Whether an embedded block starts here: `embed`, then two identifiers.
pub fn at_embed_item(pcx: Ctx<Comp>) -> bool {
    at_word(c"embed", pcx) && tok_kind(1, pcx) == Tok::Ident && tok_kind(2, pcx) == Tok::Ident
}

// Whether the token here is the identifier `word`.
fn at_word(word: *u8, pcx: Ctx<Comp>) -> bool {
    at(Tok::Ident, pcx) && here(pcx).value as i64 == intern_c(word)
}

// The token here, the parser's.
fn here(pcx: Ctx<Comp>) -> Token {
    // UNSAFE: TOKS is the lexer's raw token array.
    // SAFETY: P is the parser's position, a token the lexer wrote (the last
    // one is Eof, so P < TOK_COUNT).
    unsafe { pcx.toks[pcx.p] }
}

// The block at `embed`: its Embed node.
pub fn parse_embed(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    advance(&pcx);
    let lang_pos = cur_start(pcx);
    let lang = expect_ident(&pcx);
    let name_pos = cur_start(pcx);
    let name = expect_binding_name(&pcx);
    let n = new_node(NodeKind::Embed, start, 0);
    NODES[n].a = name;
    NODES[n].b = lang;
    NODES[n].d = -1;
    NODES[n].y = name_pos;
    if at_word(c"with", pcx) {
        // (0.26.2) its parts: paths, `A, b::B`, each a TyName (the
        // segments before the name in its list), the Embed node's list
        advance(&pcx);
        let mark = list_begin(pcx);
        loop {
            list_push(parse_type_name(cur_start(pcx), &pcx), &pcx);
            if !eat(Tok::Comma, &pcx) {
                break;
            }
        }
        list_end(n, mark, &pcx);
    }
    if lang != intern_c(c"wgsl") {
        let saved = pcx.err_kind;
        pcx.err_kind = c"embed.language";
        err_begin(lang_pos, &pcx);
        err_str(c"no embedded language '", pcx);
        err_sym(lang, pcx);
        err_str(c"': the one language is wgsl", pcx);
        err_help(
            c"an embedded block is `embed wgsl NAME { .. }` or `embed wgsl NAME from \"x.wgsl\";`", pcx);
        err_end_soft(&pcx);
        pcx.err_kind = saved;
    }
    if eat(Tok::LBrace, &pcx) {
        var id = -1;
        if at(Tok::Embedded, pcx) {
            let t = here(pcx);
            NODES[n].d = t.start;
            id = add_string(SRC[t.start..t.end]);
            advance(&pcx);
        } else {
            id = add_string("");
            NODES[n].d = prev_end(pcx);
        }
        NODES[n].c = id;
        expect(Tok::RBrace, &pcx);
    } else if at_word(c"from", pcx) {
        advance(&pcx);
        if at(Tok::Str, pcx) {
            let at_str = cur_start(pcx);
            let rel = str_at(here(pcx).value as i64);
            NODES[n].h = at_str;
            NODES[n].x = here(pcx).value as i64;
            NODES[n].c = embed_block_file(at_str, rel,
                SRC[start..prev_end(pcx)], &pcx);
            advance(&pcx);
        } else {
            let saved = pcx.err_kind;
            pcx.err_kind = c"embed.path";
            err_begin(cur_start(pcx), &pcx);
            err_str(c"'embed ", pcx);
            err_sym(lang, pcx);
            err_str(c" ", pcx);
            err_sym(name, pcx);
            err_str(c" from' takes its file's path as a string literal", pcx);
            err_help(c"the file is read when the program is compiled: `embed wgsl K from \"shader.wgsl\";`, relative to this file's directory", pcx);
            err_end_soft(&pcx);
            pcx.err_kind = saved;
            parse_expr(&pcx);
            NODES[n].h = start;
            NODES[n].c = add_string("");
        }
        expect(Tok::Semi, &pcx);
    } else {
        syntax_error(
            c"expected '{' (the block's text), 'from \"path\";' or 'with' and its parts after the block's name", &pcx);
    }
    NODES[n].end = prev_end(pcx);
    n
}
