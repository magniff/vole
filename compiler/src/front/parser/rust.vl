// (0.27.0) The rust edition's syntax, the parts the MVS parser has no
// form for: lifetimes (`'a` in generics, type arguments, `&'a T`, bounds
// and `where`), the receivers `&self`, `&mut self`, `&'a self`, `mut
// self`, and the raw pointers `*const T` / `*mut T`. The rest of Rust's
// spelling (`&T`, `&mut x`, `let mut`, `mut x: T`, `static mut`, `move ||`,
// `*r`) is what the parser reads in a file that is not strict
// (conv::strict_at is false in the rust edition), with 0.19's meanings,
// which are Rust's.
//
// Lifetimes are erased from the types (front/types interns no region);
// the parser keeps them for the region maps (front/rust/regions): a
// lifetime is a TyName node (a = its symbol; a parameter's `'a: 'b`
// bounds, lifetimes too, in h), the lifetimes of one list in a Generics
// holder, and pcx.lt_items the pairs (node, holder): an item's for its
// generics, a TyName's for its type arguments. A reference's lifetime is
// the c of its TyPtr (0: none written).

use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::ast::{
    NODE_REF, NODE_REF_MUT, NodeKind, list_begin, list_end, list_push, new_node,
};
use crate::front::lexer::Tok;
use crate::front::parser::{advance, at, cur_start, eat, prev_end, tok_kind};

// Whether the parser is at a token of a rust-edition file.
pub fn rust_here(pcx: inout Ctx<Comp>) -> bool {
    pcx.edition != 0 && crate::front::rust::rust_at(cur_start(pcx), &pcx)
}

// The token at the parser is a lifetime: its symbol (0: it is not one).
pub fn lifetime_sym(pcx: Ctx<Comp>) -> i64 {
    if !at(Tok::Lifetime, pcx) {
        return 0;
    }
    // UNSAFE: TOKS is the lexer's raw token array (no safe view of it in the parser)
    // SAFETY: P is a token of the array: the parser stops at its Eof, which is last
    unsafe { pcx.toks[pcx.p].value as i64 }
}

// Before a list that may hold lifetimes: the mark lifetimes_end takes.
pub fn lifetimes_begin(pcx: Ctx<Comp>) -> i64 {
    pcx.lt_scratch.count
}

// At a lifetime in a list (a generic parameter when `param`, with its
// bounds `'a: 'b + 'c`; else a type argument): its node is kept for
// lifetimes_end, and the token taken; false at anything else.
pub fn take_lifetime(param: bool, pcx: inout Ctx<Comp>) -> bool {
    let sym = lifetime_sym(pcx);
    if sym == 0 {
        return false;
    }
    let n = new_node(NodeKind::TyName, cur_start(pcx), 0, &pcx);
    pcx.nodes[n].a = sym;
    advance(&pcx);
    if param && eat(Tok::Colon, &pcx) {
        let bounds = new_node(NodeKind::Generics, cur_start(pcx), 0, &pcx);
        let mark = list_begin(pcx);
        loop {
            let b = lifetime_sym(pcx);
            if b == 0 {
                break;
            }
            let bn = new_node(NodeKind::TyName, cur_start(pcx), 0, &pcx);
            pcx.nodes[bn].a = b;
            advance(&pcx);
            pcx.nodes[bn].end = prev_end(pcx);
            list_push(bn, &pcx);
            if !eat(Tok::Plus, &pcx) {
                break;
            }
        }
        list_end(bounds, mark, &pcx);
        pcx.nodes[bounds].end = prev_end(pcx);
        pcx.nodes[n].h = bounds;
    }
    pcx.nodes[n].end = prev_end(pcx);
    pcx.lt_scratch.push(n);
    true
}

// After the list: the lifetimes taken since mark, as a Generics holder in
// pcx.lt_last (0 when there were none), for bind_lifetimes.
pub fn lifetimes_end(mark: i64, pcx: inout Ctx<Comp>) {
    pcx.lt_last = 0;
    if pcx.lt_scratch.count == mark {
        return;
    }
    let first = pcx.lt_scratch.get(mark);
    let holder = new_node(NodeKind::Generics, pcx.nodes[first].start, prev_end(pcx), &pcx);
    let lmark = list_begin(pcx);
    for i in mark..pcx.lt_scratch.count {
        list_push(pcx.lt_scratch.get(i), &pcx);
    }
    list_end(holder, lmark, &pcx);
    pcx.lt_scratch.count = mark;
    pcx.lt_last = holder;
}

// The lifetimes of the list just parsed (lifetimes_end) are node n's.
pub fn bind_lifetimes(n: i64, pcx: inout Ctx<Comp>) {
    if pcx.lt_last == 0 {
        return;
    }
    lt_push(n, pcx.lt_last, &pcx);
    pcx.lt_last = 0;
}

// (0.27.2.1) Pair (key, value) onto pcx.lt_items, its key's first indexed
// (lifetimes_of); (0.28.0) each pair chained to the next of its key
// (outlives_of: lt_next, lt_key_last).
pub fn lt_push(key: i64, value: i64, pcx: inout Ctx<Comp>) {
    let at = pcx.lt_items.count;
    if key != 0 {
        let last = pcx.lt_key_last.get(key);
        if last == 0 {
            pcx.lt_first.put(key, at + 1);
        } else {
            pcx.lt_next.set((last - 1) / 2, at + 1);
        }
        pcx.lt_key_last.put(key, at + 1);
    }
    pcx.lt_items.push(key);
    pcx.lt_items.push(value);
    pcx.lt_next.push(0);
}

// (0.27.2.1) Node `to` has the lifetimes holder node `from` has (a
// virtual function's copy of a trait's declaration, front/opaque.vl).
pub fn share_lifetimes(from: i64, to: i64, pcx: inout Ctx<Comp>) {
    let h = lifetimes_of(from, pcx);
    if h != 0 {
        lt_push(to, h, &pcx);
    }
}

// The lifetimes holder bound to node n (0: none).
pub fn lifetimes_of(n: i64, pcx: Ctx<Comp>) -> i64 {
    if n != 0 {
        let at = pcx.lt_first.get(n);
        return if at == 0 { 0 } else { pcx.lt_items.get(at) };
    }
    var i = 0;
    while i + 1 < pcx.lt_items.count {
        if pcx.lt_items.get(i) == n {
            return pcx.lt_items.get(i + 1);
        }
        i += 2;
    }
    0
}

// (0.27.1) The key of function node n's `where` lifetime predicates in
// pcx.lt_items (lifetimes_of(where_key(n))): apart from its generics'
// (n) and its impl's (-n).
pub fn where_key(n: i64) -> i64 {
    n + (1 << 40)
}

// At a lifetime bound in a list of bounds (`T: 'a + Clone`): taken
// (0.27.1's outlives facts read it from the source), true.
pub fn skip_lifetime_bound(pcx: inout Ctx<Comp>) -> bool {
    // (and `?Sized`, skip_maybe_bound)
    if at(Tok::Question, pcx) && rust_here(&pcx) {
        return skip_maybe_bound(&pcx);
    }
    if !at(Tok::Lifetime, pcx) {
        return false;
    }
    advance(&pcx);
    true
}

// (0.27.2) The key of type parameter node p's lifetime bounds (`T: 'a`,
// in its generics or a `where`) in pcx.lt_items: an entry per bound, a
// TyName of the lifetime.
pub fn outlives_key(p: i64) -> i64 {
    p + (2 << 40)
}

// At a lifetime bound in type parameter `param`'s list of bounds (`T: 'a +
// Clone`): kept for the region checker (borrowck.md D4.5, D20.6), the
// token taken, true; else skip_lifetime_bound's (`?Sized`; false).
pub fn take_outlives_bound(param: i64, pcx: inout Ctx<Comp>) -> bool {
    let sym = lifetime_sym(pcx);
    if sym == 0 || param == 0 {
        // RULE: F21.1 (0.27.3: `T: ?Sized` recorded on the parameter)
        if param != 0 && at(Tok::Question, pcx) && rust_here(&pcx) {
            pcx.nodes[param].p |= crate::front::ast::TY_MAYBE_UNSIZED;
        }
        return skip_lifetime_bound(&pcx);
    }
    let n = new_node(NodeKind::TyName, cur_start(pcx), 0, &pcx);
    pcx.nodes[n].a = sym;
    advance(&pcx);
    pcx.nodes[n].end = prev_end(pcx);
    lt_push(outlives_key(param), n, &pcx);
    true
}

// The lifetime symbol of type parameter node p's i-th lifetime bound, 0
// past the last (its key's pairs, in order: lt_push's chain).
pub fn outlives_of(p: i64, i: i64, pcx: Ctx<Comp>) -> i64 {
    var j = pcx.lt_first.get(outlives_key(p)) - 1;
    var k = 0;
    while j >= 0 {
        if k == i {
            return pcx.nodes[pcx.lt_items.get(j + 1)].a;
        }
        k += 1;
        j = pcx.lt_next.get(j / 2) - 1;
    }
    0
}

// At a `where` predicate on a lifetime, `'a: 'b + 'c`: taken, true.
pub fn skip_lifetime_predicate(pcx: inout Ctx<Comp>) -> bool {
    if !at(Tok::Lifetime, pcx) || tok_kind(1, pcx) != Tok::Colon {
        return false;
    }
    advance(&pcx);
    advance(&pcx);
    while at(Tok::Lifetime, pcx) {
        advance(&pcx);
        if !eat(Tok::Plus, &pcx) {
            break;
        }
    }
    true
}

// After `&` in a type: its lifetime, taken (0: none written).
pub fn ref_lifetime(pcx: inout Ctx<Comp>) -> i64 {
    let sym = lifetime_sym(pcx);
    if sym != 0 {
        advance(&pcx);
    }
    sym
}

// Whether the token i ahead is the identifier `self`.
fn self_at(i: i64, pcx: Ctx<Comp>) -> bool {
    word_at(i, "self", pcx)
}

// Whether the token i ahead is the identifier `text`.
fn word_at(i: i64, text: str, pcx: Ctx<Comp>) -> bool {
    // UNSAFE: TOKS is the lexer's raw token array (no safe view of it in the parser)
    // SAFETY: tok_kind says the token is an identifier, so P + i is a token
    // of the array (the parser stops at its Eof, which is last)
    unsafe {
        tok_kind(i, pcx) == Tok::Ident
            && crate::base::sym_text(pcx.toks[pcx.p + i].value as i64, pcx) == text
    }
}

// (0.27.0) At `#[array_builtin(N)]` in the rust edition: std2's spelling
// of an item over `[T; N]` for every length N, which the compiler makes for
// each N a program uses until const generics (rust-surface plan, section
// 6). RULE: F15.3 (0.27.2: the attribute is taken and its name kept in
// ARRAY_LEN_NAME, which the item's generic parameters take as a length
// parameter, parse_generic_params; the caller parses the item after it)
pub fn take_array_builtin(pcx: inout Ctx<Comp>) -> bool {
    if !at(Tok::Hash, pcx) || tok_kind(1, pcx) != Tok::LBracket
        || !word_at(2, "array_builtin", pcx) || tok_kind(3, pcx) != Tok::LParen
        || tok_kind(4, pcx) != Tok::Ident || tok_kind(5, pcx) != Tok::RParen
        || tok_kind(6, pcx) != Tok::RBracket || !rust_here(&pcx) {
        return false;
    }
    for i in 0..7 {
        if i == 4 {
            pcx.array_len_name = pcx.toks[pcx.p].value as i64;
        }
        advance(&pcx);
    }
    true
}

// (0.27.0) At `#[builtin_impls(T, ...)]` in the rust edition: std2's
// spelling of a trait whose impls for the primitive types the compiler
// provides, as MVS's are. The attribute is taken and is edition.later
// (primitive_builtin, 0.27.2); true, and the caller parses the trait after
// it and keeps it.
pub fn take_builtin_impls(pcx: inout Ctx<Comp>) -> bool {
    if !at(Tok::Hash, pcx) || tok_kind(1, pcx) != Tok::LBracket
        || !word_at(2, "builtin_impls", pcx) && !word_at(2, "builtin_methods", pcx)
        || tok_kind(3, pcx) != Tok::LParen
        || !rust_here(&pcx) {
        return false;
    }
    let start = cur_start(pcx);
    // (`#[builtin_methods(P, ..)]`, F15.4: the integers' inherent methods,
    // made as the module's items at the attribute; the record's item -1)
    let methods = word_at(2, "builtin_methods", pcx);
    for _ in 0..4 {
        advance(&pcx);
    }
    while !at(Tok::RParen, pcx) && !at(Tok::Eof, pcx) {
        advance(&pcx);
    }
    crate::front::parser::expect(Tok::RParen, &pcx);
    crate::front::parser::expect(Tok::RBracket, &pcx);
    // RULE: F15.1 (the trait parsed next is recorded with the attribute:
    // front::builtin_impls makes its impls)
    pcx.builtin_traits.push(if methods { -1 } else { 0 });
    pcx.builtin_traits.push(start);
    pcx.builtin_traits.push(prev_end(pcx));
    pcx.builtin_traits.push(0);
    true
}

// (0.27.0) At `<T as Trait>::Name` in a type in the rust edition, a
// qualified path. (0.27.2: a TyName flagged NODE_QPATH, `Name` of T's impl
// of Trait, resolved by resolve::resolve_type_name; RULE: F8.1.) A longer
// path, `<T as Tr>::A::B`, is edition.later (qualified_path) and the item
// it is in is left out.
pub fn qualified_path(pcx: inout Ctx<Comp>) -> i64 {
    let start = cur_start(pcx);
    advance(&pcx);
    let self_ty = crate::front::parser::types::parse_type(&pcx);
    crate::front::parser::expect(Tok::As, &pcx);
    let tr = crate::front::parser::types::parse_type(&pcx);
    crate::front::parser::types::expect_gt(&pcx);
    crate::front::parser::expect(Tok::ColonColon, &pcx);
    let n = new_node(NodeKind::TyName, start, 0, &pcx);
    pcx.nodes[n].a = crate::front::parser::expect_ident(&pcx);
    pcx.nodes[n].c = tr;
    pcx.nodes[n].p |= crate::front::ast::NODE_QPATH;
    let mark = list_begin(pcx);
    list_push(self_ty, &pcx);
    list_end(n, mark, &pcx);
    pcx.nodes[n].end = prev_end(pcx);
    if at(Tok::ColonColon, pcx) && tok_kind(1, pcx) == Tok::Ident {
        while at(Tok::ColonColon, pcx) && tok_kind(1, pcx) == Tok::Ident {
            advance(&pcx);
            advance(&pcx);
        }
        crate::front::rust::later(start, prev_end(pcx), "qualified_path", "0.27.2", &pcx);
        crate::base::diag::err_jump(&pcx);
    }
    n
}

// (0.27.0) In the rust edition, a `<<` that opens type arguments whose
// first is a qualified path (`Option<<I as Iterator>::Item>`) is two
// `<`: the token becomes the second.
pub fn split_shl(pcx: inout Ctx<Comp>) -> bool {
    if !at(Tok::Shl, pcx) || !rust_here(&pcx) {
        return false;
    }
    pcx.toks[pcx.p].kind = Tok::Lt;
    pcx.toks[pcx.p].start += 1;
    true
}

// Whether token i ahead ends a parameter.
fn param_end_at(i: i64, pcx: Ctx<Comp>) -> bool {
    tok_kind(i, pcx) == Tok::Comma || tok_kind(i, pcx) == Tok::RParen
}

// At a receiver of the rust edition (`self`, `mut self`, `&self`, `&mut
// self`, `&'a self`, `&'a mut self`): its Param node, the 0.19 shape
// (`self: Self`, `self: &Self`, `self: &mut Self`, by type: no
// convention flags); 0 at any other parameter (nothing taken).
pub fn receiver(start: i64, pcx: inout Ctx<Comp>) -> i64 {
    var k = 0;
    var by_ref = false;
    var mutable = false;
    if at(Tok::Amp, pcx) {
        by_ref = true;
        k = 1;
        if tok_kind(k, pcx) == Tok::Lifetime {
            k += 1;
        }
    }
    if tok_kind(k, pcx) == Tok::Mut {
        mutable = true;
        k += 1;
    }
    if !self_at(k, pcx) || !param_end_at(k + 1, pcx) {
        return 0;
    }
    var lt = 0;
    if by_ref {
        advance(&pcx);
        lt = ref_lifetime(&pcx);
    }
    if mutable {
        advance(&pcx);
    }
    let n = new_node(NodeKind::Param, start, 0, &pcx);
    let name_start = cur_start(pcx);
    // UNSAFE: TOKS is the lexer's raw token array (no safe view of it in the parser)
    // SAFETY: self_at said the token at P is the identifier `self`
    pcx.nodes[n].a = unsafe { pcx.toks[pcx.p].value as i64 };
    advance(&pcx);
    let name = new_node(NodeKind::TyName, name_start, prev_end(pcx), &pcx);
    pcx.nodes[name].a = crate::base::intern_c(c"Self", &pcx);
    if by_ref {
        let t = new_node(NodeKind::TyPtr, start, prev_end(pcx), &pcx);
        pcx.nodes[t].a = name;
        pcx.nodes[t].c = lt;
        pcx.nodes[t].p |= if mutable { NODE_REF | NODE_REF_MUT } else { NODE_REF };
        pcx.nodes[n].b = t;
    } else {
        pcx.nodes[n].b = name;
        pcx.nodes[n].c = mutable as i64;
    }
    pcx.nodes[n].end = prev_end(pcx);
    n
}

// After `*` in a type of the rust edition: `const` or `mut`, taken (a raw
// pointer: both are vole's `*T` in 0.27.0, the write through a `*const`
// is edition.later); its node's c is 1 for `*const`, 2 for `*mut`.
pub fn raw_pointer_kind(pcx: inout Ctx<Comp>) -> i64 {
    if eat(Tok::Const, &pcx) {
        return 1;
    }
    if eat(Tok::Mut, &pcx) {
        return 2;
    }
    crate::base::diag::error_at(cur_start(pcx),
        c"a raw pointer is '*const T' or '*mut T' in the rust edition", &pcx);
    0
}

// (0.27.0) At `:` after a trait's name or an associated type's (`trait
// DerefMut: Deref`, `type IntoIter: Iterator<Item = T>;`), in the rust
// edition: the bounds taken. `?Sized` alone says nothing (accepted); any
// other is edition.later (`feature`, 0.27.2), soft. Whether there was one.
pub fn skip_item_bounds(feature: str, pcx: inout Ctx<Comp>) -> bool {
    if !at(Tok::Colon, pcx) || !rust_here(&pcx) {
        return false;
    }
    let start = cur_start(pcx);
    advance(&pcx);
    var only_sized = true;
    loop {
        if eat(Tok::Question, &pcx) {
            crate::front::parser::types::parse_bound(&pcx);
        } else if !skip_lifetime_bound(&pcx) {
            crate::front::parser::types::parse_bound(&pcx);
            only_sized = false;
        }
        if !eat(Tok::Plus, &pcx) {
            break;
        }
    }
    if !only_sized {
        crate::front::rust::later(start, prev_end(pcx), feature, "0.27.2", &pcx);
    }
    true
}

// (0.27.2) At `:` after a trait's name in the rust edition (`trait A: B +
// C`, `trait Step: Clone + PartialOrd + Sized`): the supertraits, a
// Generics holder of bound nodes (`Sized`, `?Sized` and lifetime bounds
// taken out), or 0 when there are none. RULE: F2.1
pub fn parse_item_bounds(pcx: inout Ctx<Comp>) -> i64 {
    if !at(Tok::Colon, pcx) || !rust_here(&pcx) {
        return 0;
    }
    let start = cur_start(pcx);
    advance(&pcx);
    let mark = list_begin(pcx);
    loop {
        if eat(Tok::Question, &pcx) {
            crate::front::parser::types::parse_bound(&pcx);
        } else if !skip_lifetime_bound(&pcx) {
            list_push(crate::front::parser::types::parse_bound(&pcx), &pcx);
        }
        if !eat(Tok::Plus, &pcx) {
            break;
        }
    }
    drop_sized(mark, start, &pcx);
    let h = new_node(NodeKind::Generics, start, 0, &pcx);
    list_end(h, mark, &pcx);
    pcx.nodes[h].end = prev_end(pcx);
    h
}

// (0.27.0) At `?` in a list of bounds (`T: ?Sized`), in the rust edition:
// taken with its trait (only `str` and `[T]` are unsized: the bound says
// nothing more); true.
pub fn skip_maybe_bound(pcx: inout Ctx<Comp>) -> bool {
    if !at(Tok::Question, pcx) {
        return false;
    }
    advance(&pcx);
    crate::front::parser::types::parse_bound(&pcx);
    true
}

// At `(`: the tokens to its `)`, taken (nested brackets balanced).
pub fn skip_parens(pcx: inout Ctx<Comp>) {
    var depth = 0;
    loop {
        if at(Tok::Eof, pcx) {
            return;
        }
        if at(Tok::LParen, pcx) {
            depth += 1;
        } else if at(Tok::RParen, pcx) {
            depth -= 1;
        }
        advance(&pcx);
        if depth == 0 {
            return;
        }
    }
}

// RULE: F34.1 Whether the token k ahead is the `const` of a rust-edition
// `const fn`, `const unsafe fn` or `const extern "C" fn`.
pub fn const_fn_at(k: i64, pcx: inout Ctx<Comp>) -> bool {
    tok_kind(k, pcx) == Tok::Const
        && (tok_kind(k + 1, pcx) == Tok::Fn
            || tok_kind(k + 1, pcx) == Tok::Unsafe && tok_kind(k + 2, pcx) == Tok::Fn
            || tok_kind(k + 1, pcx) == Tok::Extern)
        && rust_here(&pcx)
}

// RULE: F34.1 At a `const fn`: its `const` taken (a function as any).
// Whether there was one.
pub fn skip_const_fn(pcx: inout Ctx<Comp>) -> bool {
    if !const_fn_at(0, &pcx) {
        return false;
    }
    advance(&pcx);
    true
}

// (0.27.0) At `const NAME: T = v;` (`const NAME: T;`, `pub const`) in a trait or an
// impl, in the rust edition: an associated constant, from 0.27.2; taken
// to its `;` and edition.later (assoc_const). Whether there was one.
pub fn skip_assoc_const(pcx: inout Ctx<Comp>) -> bool {
    let public = at(Tok::Pub, pcx) && tok_kind(1, pcx) == Tok::Const;
    if !at(Tok::Const, pcx) && !public || !rust_here(&pcx) {
        return false;
    }
    let start = cur_start(pcx);
    var depth = 0;
    while !at(Tok::Eof, pcx) && !(depth == 0 && at(Tok::Semi, pcx)) {
        if at(Tok::LParen, pcx) || at(Tok::LBracket, pcx) || at(Tok::LBrace, pcx) {
            depth += 1;
        } else if at(Tok::RParen, pcx) || at(Tok::RBracket, pcx) || at(Tok::RBrace, pcx) {
            depth -= 1;
        }
        advance(&pcx);
    }
    eat(Tok::Semi, &pcx);
    crate::front::rust::later(start, prev_end(pcx), "assoc_const", "0.27.2", &pcx);
    true
}

// (0.27.0) An impl with type parameters `params` for `self_type` at start,
// in the rust edition, that the front cannot express yet: one for `char`
// (F1, 0.27.2 M2). Edition.later and true: the caller drops the impl and
// its functions. (0.27.2: a blanket impl, one on an instance, for `&T`
// or for a slice of any shape is a pattern impl, docs/design/front-rust.md
// F4.1, F5.1, F6.1: collect_impl and impl_template take it.)
pub fn later_impl(params: i64, self_type: i64, start: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.edition == 0 || !crate::front::rust::rust_at(start, &pcx) {
        return false;
    }
    // (0.27.2: `impl char` is an inherent impl on a primitive, F1.5)
    false
}

// (0.27.0) The bounds SCRATCH[mark..] of a `where` predicate, in the rust
// edition: `Sized` taken out (every type is sized but `str` and `[T]`, as
// `?Sized` says nothing either). Whether the predicate is the edition's.
pub fn drop_sized(mark: i64, start: i64, pcx: inout Ctx<Comp>) -> bool {
    if pcx.edition == 0 || !crate::front::rust::rust_at(start, &pcx) {
        return false;
    }
    var to = mark;
    for i in mark..pcx.scratch.count {
        let b = pcx.scratch.get(i);
        let sized = pcx.nodes[b].kind == NodeKind::TyName && pcx.nodes[b].g == 0
            && crate::base::sym_text(pcx.nodes[b].a, pcx) == "Sized";
        if !sized {
            pcx.scratch.set(to, b);
            to += 1;
        }
    }
    pcx.scratch.count = to;
    true
}

// (0.27.0) Whether type node t is written as a reference, `&T`, `&'a mut
// [T]` (a slice's node is a view already: its `&` is in the source only).
pub fn ref_type(t: i64, pcx: Ctx<Comp>) -> bool {
    let k = pcx.nodes[t].kind;
    k == NodeKind::TyPtr && (pcx.nodes[t].p & NODE_REF) != 0
        || k == NodeKind::TySlice && crate::base::SRC[pcx.nodes[t].start] == '&'
}
