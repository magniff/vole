// Effects (0.16): what a checked function (an item, a generic instance, a
// closure) may do, inferred from its body and its callees, and checked
// against what it declares (`#[effects(...)]`, `#[pure]`, `#[no_alloc]`,
// `#[no_io]`, `#[no_panic]`, a bound's `effects(...)`). The design is
// docs/design/effects-allocation.md (§2.1 the effects, §3 the tables).
//
// An effect set is an Effects: `bits` holds EFF_IO ... EFF_ALLOC_EXTERN,
// the raw `panic` and `diverge` the optimizer reads (EFF_RAW_*: before the
// in-bounds and counted-loop masks), and EFF_UNKNOWN (⊤: a body that
// failed to check, or not inferred); `allocs` holds a bit per allocator
// type (ALLOCATORS, interned by allocator_bit), bit 63 (ALLOC_ANY) for
// "any allocator". FN_EFFECTS has one per function (FNS index) once
// infer_effects ran.
//
// Here: the tables, union, subset and the text (`alloc(Gpa, Arena) io
// global panic diverge unsafe`, `none`); infer.vl the inference;
// check.vl the declared bounds; why.vl the chains that explain an
// effect; builtin.vl the effects of C functions.

use crate::base::{buf_bytes, buf_str, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::modules::within_std;
use crate::front::types::{TyKind, buf_type};

pub mod builtin;
pub mod check;
pub mod infer;
pub mod why;

#[derive(Clone, Copy)] pub struct Effects { pub bits: i64, pub allocs: i64 }

pub const EFF_IO: i64 = 1;
pub const EFF_GLOBAL: i64 = 2;
pub const EFF_PANIC: i64 = 4;
pub const EFF_DIVERGE: i64 = 8;
pub const EFF_UNSAFE: i64 = 16;
pub const EFF_ALLOC_EXTERN: i64 = 32;

// (0.21, docs/design/concurrency.md §2.5) tls: a #[thread_local] static
// read, written or its address taken; thread: a thread started; sync: an
// atomic operation, a fence, or blocking on another thread (a lock, a
// wait, a join). `thread` implies `sync`.
pub const EFF_TLS: i64 = 512;
pub const EFF_THREAD: i64 = 1024;
pub const EFF_SYNC: i64 = 2048;

// (0.21, hidden) A `static mut` (or C's global state) reached without the
// synchronization std's printing has: what the shared-static rule keeps off
// other threads (front/threads.vl). Set with `global`, but for std's
// statics that a lock guards (std::fmt's print buffer, std::thread's
// thread-local keys) and C's errno, which is per thread.
pub const EFF_RAW_GLOBAL: i64 = 4096;
// (0.26.1, hidden) A write through a shared reference may happen: a call of
// std::cell::UnsafeCell::get, the one root (infer.vl: node_locals), and
// what calls it. Memory for the optimizer (middle/ipo.vl: effects_attrs);
// refused in a contract condition (contracts::impure) and by `#[pure]`
// (effects/check.vl); `#[no_io]`, `#[no_alloc]` and `#[no_panic]` ignore it.
pub const EFF_INTERIOR: i64 = 8192;
// The bits an effect set shows and compares.
pub const EFF_VISIBLE: i64 = 63 | EFF_TLS | EFF_THREAD | EFF_SYNC;
// `panic` and `diverge` before the masks (for the optimizer: ¬raw diverge
// is WILLRETURN, ¬raw panic NOPANIC).
pub const EFF_RAW_PANIC: i64 = 64;
pub const EFF_RAW_DIVERGE: i64 = 128;
// ⊤ for a body that failed to check (or before inference): it suppresses
// the declared-effect errors of its callers.
pub const EFF_UNKNOWN: i64 = 256;
// In `allocs`: any allocator (also when ALLOCATORS has more than 63).
pub const ALLOC_ANY: i64 = 1 << 63;

pub fn effects_none() -> Effects {
    Effects { bits: 0, allocs: 0 }
}

// Everything (⊤), unknown.
pub fn effects_top() -> Effects {
    Effects {
        bits: EFF_VISIBLE | EFF_RAW_PANIC | EFF_RAW_DIVERGE | EFF_UNKNOWN | EFF_RAW_GLOBAL
            | EFF_INTERIOR,
        allocs: ALLOC_ANY,
    }
}

// The effects of function f (⊤ when not inferred).
pub fn fn_effects(f: i64, pcx: &Ctx<Comp>) -> Effects {
    unsafe {
        if f < 0 || f >= pcx.fn_effects_count {
            return effects_top();
        }
        (*pcx.fn_effects.add(f as usize))
    }
}

// (0.27.2.1, E3.1a) The inferred set I(f): FN_EFFECTS' S(f) but for a
// declared function of the rust edition, whose S(f) is its declaration's.
pub fn inferred_effects(f: i64, pcx: &Ctx<Comp>) -> Effects {
    // UNSAFE: FX_DECL and FX_INFERRED, infer_effects' tables, by index.
    // SAFETY: f is checked against FN_EFFECTS' count, which the tables
    // (made with it, one word per function) have.
    unsafe {
        if f >= 0 && f < pcx.fn_effects_count && pcx.fx_decl != 0 as *mut i64
            && (*pcx.fx_decl.add(f as usize)) != 0 {
            return (*pcx.fx_inferred.add(f as usize));
        }
    }
    fn_effects(f, pcx)
}

// (0.27.2.1, E3.3a) What declared function f's edges made for a listed
// type parameter add to its declaration (none: not declared so).
pub fn declared_through(f: i64, pcx: &Ctx<Comp>) -> Effects {
    // UNSAFE: FX_DECL and FX_DECL_PX, infer_effects' tables, by index.
    // SAFETY: as inferred_effects.
    unsafe {
        if f >= 0 && f < pcx.fn_effects_count && pcx.fx_decl != 0 as *mut i64
            && (*pcx.fx_decl.add(f as usize)) != 0 {
            return (*pcx.fx_decl_px.add(f as usize));
        }
    }
    effects_none()
}

pub fn effects_union(a: Effects, b: Effects) -> Effects {
    Effects { bits: a.bits | b.bits, allocs: a.allocs | b.allocs }
}

// Whether a is within b (the visible bits and the allocators; any
// allocator is within only any).
pub fn effects_subset(a: Effects, b: Effects) -> bool {
    // (0.26.1: and the hidden EFF_INTERIOR, which only #[pure] refuses)
    if (a.bits & (EFF_VISIBLE | EFF_INTERIOR) & (b.bits ^ -1)) != 0 {
        return false;
    }
    if (b.allocs & ALLOC_ANY) != 0 {
        return true;
    }
    (a.allocs & (b.allocs ^ -1)) == 0
}

// The bit of allocator type t in `allocs` (ALLOC_ANY past 63 of them).
pub fn allocator_bit(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    for i in 0..pcx.allocators.len() as i64 {
        if (pcx.allocators[i as usize]) == t {
            return 1 << i;
        }
    }
    if pcx.allocators.len() as i64 >= 63 {
        return ALLOC_ANY;
    }
    pcx.allocators.push(t);
    1 << (pcx.allocators.len() as i64 - 1)
}

// The name of allocator type t, for sorting: a struct's symbol, else -1.
fn allocator_name(t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.types[t as usize].kind
        == TyKind::Struct { pcx.structs[pcx.types[t as usize].a as usize].name } else { -1 }
}

// Whether allocator type a is shown before b: Gpa first, then by name.
fn allocator_before(a: i64, b: i64, pcx: &Ctx<Comp>) -> bool {
    let na = allocator_name(a, pcx);
    let nb = allocator_name(b, pcx);
    if na < 0 || nb < 0 {
        return na >= 0 || na < 0 && nb < 0 && a < b;
    }
    let ta = sym_text(na, pcx);
    let tb = sym_text(nb, pcx);
    if ta == b"Gpa" || tb == b"Gpa" {
        return ta == b"Gpa" && tb != b"Gpa";
    }
    let n = if ta.len() < tb.len() { ta.len() as i64 } else { tb.len() as i64 };
    for i in 0..n {
        if ta[i as usize] != tb[i as usize] {
            return ta[i as usize] < tb[i as usize];
        }
    }
    ta.len() < tb.len()
}

// Appends e as text: `alloc(Gpa, Arena) io static panic diverge unsafe`
// (that order), `alloc` alone for any allocator, `none` for the empty set;
// then ` (unknown)` for ⊤ not inferred.
pub fn effects_text(out: i64, e: Effects, pcx: &Ctx<Comp>) {
    let mut first = true;
    if e.allocs != 0 || (e.bits & EFF_ALLOC_EXTERN) != 0 {
        buf_str(out, c"alloc");
        if (e.allocs & ALLOC_ANY) == 0 {
            buf_str(out, c"(");
            let mut shown: i64 = 0;
            let mut last: i64 = -1;
            // (selection by allocator_before: few allocators)
            loop {
                let mut next: i64 = -1;
                for i in 0..pcx.allocators.len() as i64 {
                    let t = (pcx.allocators[i as usize]);
                    if (e.allocs & (1 << i)) == 0
                        || last >= 0 && !allocator_before(last, t, pcx) {
                        continue;
                    }
                    if next < 0 || allocator_before(t, next, pcx) {
                        next = t;
                    }
                }
                if next < 0 {
                    break;
                }
                if shown > 0 {
                    buf_str(out, c", ");
                }
                buf_type(out, next, pcx);
                shown += 1;
                last = next;
            }
            if (e.bits & EFF_ALLOC_EXTERN) != 0 {
                if shown > 0 {
                    buf_str(out, c", ");
                }
                buf_str(out, c"extern");
            }
            buf_str(out, c")");
        }
        first = false;
    }
    // (0.28.0, E1.2 revised: `static` is shown. A set's text is the
    // list `#[effects(..)]` accepts, every word of it: the check
    // (effects_subset) compares EFF_GLOBAL, so a display without it
    // named a list the check refuses. `interior`, which no list can
    // name and every list allows, stays out.)
    let names: [*mut u8; 8] = [c"io", c"static", c"tls", c"thread", c"sync", c"panic",
        c"diverge", c"unsafe"];
    let bits: [i64; 8] = [EFF_IO, EFF_GLOBAL, EFF_TLS, EFF_THREAD, EFF_SYNC, EFF_PANIC,
        EFF_DIVERGE, EFF_UNSAFE];
    for k in 0..8 {
        if (e.bits & bits[k as usize]) != 0 {
            if !first {
                buf_str(out, c" ");
            }
            buf_str(out, names[k as usize]);
            first = false;
        }
    }
    if first {
        buf_str(out, c"none");
    }
    if (e.bits & EFF_UNKNOWN) != 0 {
        buf_str(out, c" (unknown)");
    }
}

// The effects of every function, for --print-effects: `name: effects`, a
// line each, in FNS order: the program's functions, instances and
// closures (not templates, not std's own).
pub fn print_effects(out: i64, pcx: &Ctx<Comp>) {
    for f in 0..pcx.fns.len() as i64 {
        if pcx.fns[f as usize].generic > 0 || pcx.fns[f as usize].node == 0
            || within_std(pcx.fns[f as usize].module, pcx) || is_shim(f, pcx) {
            continue;
        }
        buf_bytes(out, sym_text(pcx.fns[f as usize].display, pcx));
        buf_str(out, c": ");
        effects_text(out, fn_effects(f, pcx), pcx);
        buf_str(out, c"\n");
    }
}

// (0.27.2, K-I7) Whether f is a drop shim's function: it has no body the
// effects walk, so its set would print as ⊤ `(unknown)`; no edge targets
// it (a drop's go to `Drop::drop` and the fields' drops), so it is left out.
fn is_shim(f: i64, pcx: &Ctx<Comp>) -> bool {
    for id in 0..crate::places::shim::shim_count(pcx) {
        if crate::places::shim::shim_fn(id, pcx) == f {
            return true;
        }
    }
    false
}
