// Why a function has an effect (0.16): the chain from the function down
// to a local source, rebuilt on demand by walking each body again
// (infer.vl's find_step), one line a step:
//   'v.push(x)' at sum.vl:7:9 grows a Vec<i64>
//   'self.reserve(1)' at <std>:131:9 calls 'Vec::reserve'
//   'self.alloc.try_resize(..)' at <std>:167:13 allocates from Gpa (an Allocator method)
// Nothing is stored for it. The declared-effect errors (check.vl) show
// the first step.

use crate::base::{IntVec, buf_byte, buf_bytes, buf_new, buf_slice, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{buf_position, put_short_positions};
use crate::front::ast::{NODE_RAW, NodeKind, child};
use crate::front::check::Res;
use crate::front::contracts::checks::{CHK_ENSURES, CHK_INVARIANT, CHK_REQUIRES};
use crate::front::effects::{
    ALLOC_ANY, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_IO, EFF_PANIC, EFF_SYNC, EFF_THREAD,
    EFF_TLS, EFF_UNKNOWN, EFF_UNSAFE, fn_effects,
};
use crate::front::effects::builtin::c_symbol;
use crate::front::effects::check::buf_fn_name;
use crate::front::effects::infer::{
    E_ALLOC, find_step, has_effect, is_allocator_method, template_of,
};
use crate::front::modules::within_std;
use crate::front::types::{TyKind, buf_type};

// Appends effect (bit, alloc) as a declaration names it: `alloc(Gpa)`,
// `alloc(extern)`, `alloc`, `io`, ...
pub fn effect_name(out: i64, bit: i64, alloc: i64, pcx: &Ctx<Comp>) {
    if bit == 0 {
        buf_str(out, c"alloc");
        if alloc != ALLOC_ANY {
            buf_str(out, c"(");
            buf_allocator(out, alloc, pcx);
            buf_str(out, c")");
        }
        return;
    }
    buf_str(out, if bit == EFF_ALLOC_EXTERN { c"alloc(extern)" } else if bit == EFF_IO { c"io" }
        else if bit == EFF_GLOBAL { c"static" } else if bit == EFF_PANIC { c"panic" }
        else if bit == EFF_DIVERGE { c"diverge" } else if bit == EFF_TLS { c"tls" }
        else if bit == EFF_THREAD { c"thread" } else if bit == EFF_SYNC { c"sync" }
        else if bit == crate::front::effects::EFF_INTERIOR { c"interior" }
        else { c"unsafe" });
}

// Appends the allocator type of allocator bit `alloc`.
fn buf_allocator(out: i64, alloc: i64, pcx: &Ctx<Comp>) {
    for i in 0..pcx.allocators.len() as i64 {
        if alloc == (1 << i) {
            buf_type(out, (pcx.allocators[i as usize]), pcx);
            return;
        }
    }
    buf_str(out, c"any");
}

// Appends what having effect (bit, alloc) does, after "it": `allocates
// from Gpa`, `does io`, ...
pub fn effect_phrase(out: i64, bit: i64, alloc: i64, pcx: &Ctx<Comp>) {
    unsafe { phrase(out, bit, alloc, pcx); }
}

unsafe fn phrase(out: i64, bit: i64, alloc: i64, pcx: &Ctx<Comp>) {
    if bit == 0 {
        if alloc == ALLOC_ANY {
            buf_str(out, c"allocates");
            return;
        }
        buf_str(out, c"allocates from ");
        buf_allocator(out, alloc, pcx);
        return;
    }
    buf_str(out, if bit == EFF_ALLOC_EXTERN { c"allocates from C (malloc)" }
        else if bit == EFF_IO { c"does io" }
        else if bit == EFF_GLOBAL { c"touches a static mut or a C static (static)" }
        else if bit == EFF_PANIC { c"may panic" }
        else if bit == EFF_DIVERGE { c"may not terminate (diverge)" }
        else if bit == EFF_TLS { c"touches a thread-local static (tls)" }
        else if bit == EFF_THREAD { c"starts a thread (thread)" }
        else if bit == EFF_SYNC { c"does an atomic operation or waits for another thread (sync)" }
        else if bit == crate::front::effects::EFF_INTERIOR {
            c"writes through a shared reference (a cell, interior)"
        }
        else { c"has unsafe operations (unsafe)" });
}

// Appends the source text of node n, its first line, shortened.
fn buf_source(out: i64, n: i64, pcx: &Ctx<Comp>) {
    let start = pcx.nodes[n as usize].start;
    let mut end = start;
    if pcx.nodes[n as usize].end <= start {
        // (0.28.0, gap 88: a node with no text of its own, the call of
        // the body a contract wraps: the step was printed as '')
        buf_str(out, c"the body, after its contract");
        return;
    }
    while end < pcx.nodes[n as usize].end && get_src()[end as usize] != b'\n' {
        end += 1;
    }
    if end - start > 48 {
        buf_bytes(out, &get_src()[start as usize..(start + 44) as usize]);
        buf_str(out, c"..");
        return;
    }
    buf_bytes(out, &get_src()[start as usize..end as usize]);
    if end < pcx.nodes[n as usize].end {
        buf_str(out, c" ..");
    }
}

// Appends position pos: `file:line:col` (short) or `file: line L, column
// C` (what diagnostics write, made short by --diagnostics=short).
fn buf_pos(out: i64, pos: i64, short: bool, pcx: &mut Ctx<Comp>) {
    if !short {
        buf_position(out, pos, pcx);
        return;
    }
    let tmp = buf_new();
    buf_position(tmp, pos, pcx);
    put_short_positions(out, buf_slice(tmp));
}

// Whether function f is a std container's method that grows it.
fn grows_container(f: i64, pcx: &Ctx<Comp>) -> bool {
    let base = template_of(f, pcx);
    let t = pcx.fns[f as usize].self_ty;
    if !within_std(pcx.fns[base as usize].module, pcx) || t <= 0
        || pcx.types[t as usize].kind != TyKind::Struct {
        return false;
    }
    let s = pcx.types[t as usize].a;
    let tpl = if pcx.structs[s as usize].tmpl != 0 { pcx.structs[s as usize].tmpl - 1 } else { s };
    let ty = sym_text(pcx.structs[tpl as usize].name, pcx);
    let name = sym_text(pcx.nodes[pcx.fns[base as usize].node as usize].a, pcx);
    (ty == b"Vec" || ty == b"Buf" || ty == b"HashMap")
        && (starts(name, b"push") || starts(name, b"reserve") || starts(name, b"insert")
            || starts(name, b"extend") || starts(name, b"try_push")
            || starts(name, b"try_reserve"))
}

fn starts(s: &[u8], prefix: &[u8]) -> bool {
    s.len() >= prefix.len() && s[0..prefix.len()] == prefix
}

// What local source n (found by find_step for effect bit) is.
fn local_text(out: i64, n: i64, bit: i64, alloc: i64, pcx: &Ctx<Comp>) {
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::Ident && pcx.nodes[n as usize].res == Res::Static {
        buf_str(out, c" is a static's (static)");
    } else if kind == NodeKind::Ident {
        buf_str(out, c" takes an unsafe function as a value");
    } else if kind == NodeKind::Index && (pcx.nodes[n as usize].p & NODE_RAW) != 0 {
        buf_str(out, c" indexes a raw pointer");
    } else if kind == NodeKind::Index {
        let range = pcx.nodes[pcx.nodes[n as usize].b as usize].kind == NodeKind::Range;
        buf_str(out, if range { c" is a checked slicing" } else { c" is a checked index" });
    } else if kind == NodeKind::EnumPanic {
        buf_str(out, c" is a checked conversion to an enum");
    } else if kind == NodeKind::VecOp {
        buf_str(out, c" is a checked vector access");
    } else if kind == NodeKind::While {
        buf_str(out, c" is a 'while' loop");
    } else if kind == NodeKind::Loop {
        buf_str(out, c" is a 'loop'");
    } else if kind == NodeKind::Unary {
        buf_str(out, c" dereferences a raw pointer");
    } else if kind == NodeKind::FieldAccess {
        buf_str(out,
            if (pcx.nodes[n as usize].p & NODE_RAW) != 0 { c" reads through a raw pointer" }
            else { c" reads a field of a union" });
    } else if kind == NodeKind::Cast {
        buf_str(out, c" makes a pointer from an integer");
    }
    else if kind == NodeKind::Call && pcx.nodes[n as usize].x - 1 == pcx.check_fn
        && pcx.check_fn >= 0 {
        // (0.25: an assertion or a clause, a branch to the failure)
        let check: i64 = if pcx.nodes[n as usize].count
            > 2 { pcx.nodes[child(n, 2, pcx) as usize].a } else { -1 };
        let k: i64 = if check >= 0
            && check < pcx.check_kind.len() as i64 { (pcx.check_kind[check as usize]) }
            else { 0 };
        buf_str(out, if k == CHK_REQUIRES { c" is a requires check, which may fail" }
            else if k == CHK_ENSURES { c" is an ensures check, which may fail" }
            else if k == CHK_INVARIANT { c" is an invariant check, which may fail" }
            else { c" is an assertion, which may fail" });
    } else if kind == NodeKind::Call && bit == 0 {
        let f = pcx.nodes[n as usize].x - 1;
        if f >= 0 && is_allocator_method(f, pcx) {
            buf_str(out, c" allocates from ");
            buf_type(out, pcx.fns[f as usize].self_ty, pcx);
            buf_str(out, c" (an Allocator method)");
        } else {
            buf_str(out, c" ");
            effect_phrase(out, bit, alloc, pcx);
        }
    } else if kind == NodeKind::Call {
        let f = pcx.nodes[n as usize].x - 1;
        buf_str(out, if f >= 0 && pcx.fns[f as usize].is_extern { c" calls C" }
            else if f >= 0 { c" calls an unsafe function" }
            else { c" calls through a pointer" });
    } else if bit == EFF_UNSAFE {
        buf_str(out, c" is an unsafe operation");
    }
}

// Appends the first step of why function f has effect (bit, alloc):
// `'SOURCE' at POS what`; returns its node (0: none found). FOUND_CALLEE
// is the graph node it calls (-1: a local source).
pub fn step_text(out: i64, f: i64, bit: i64, alloc: i64, short: bool, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if bit == crate::front::effects::EFF_INTERIOR
            && crate::front::effects::infer::is_cell_root(f, pcx) {
            // (0.26.1: the root, infer.vl: node_locals)
            buf_str(out, c"it is '");
            buf_fn_name(out, f, pcx);
            buf_str(out, c"': its address is written through a shared reference (interior)");
            pcx.found_callee = -1;
            return pcx.fns[f as usize].node;
        }
        find_step(f, bit, alloc, pcx);
        let n = pcx.found_node;
        let callee = pcx.found_callee;
        if n == 0 {
            if (fn_effects(f, pcx).bits & EFF_UNKNOWN) != 0 {
                buf_str(out, c"its body did not check (its effects are unknown)");
            } else {
                buf_str(out, c"(no source found)");
            }
            return 0;
        }
        if n == pcx.fns[f as usize].node {
            buf_str(out, c"it is an 'unsafe fn'");
            return n;
        }
        buf_str(out, c"'");
        buf_source(out, n, pcx);
        buf_str(out, c"' at ");
        buf_pos(out, pcx.nodes[n as usize].start, short, pcx);
        if pcx.nodes[n as usize].kind == NodeKind::Interp && pcx.nodes[n as usize].x > 0 {
            // (0.17: a call of std's println or push_fmt with its f-string
            // written in place, infer.vl's walk_direct: the function called;
            // the next step is the writes')
            buf_str(out, c" calls '");
            buf_fn_name(out, pcx.nodes[n as usize].x - 1, pcx);
            buf_str(out, c"'");
        } else if callee < 0 {
            local_text(out, n, bit, alloc, pcx);
        } else if callee >= pcx.graph_fns {
            let t = (pcx.virtual_type[(callee - pcx.graph_fns) as usize]);
            if t == -2 {
                // (E4.3a: infer.vl's FMT_JOIN)
                buf_str(out,
                    c" writes through a Formatter it did not make (any sink of the program)");
            } else if t < 0 {
                buf_str(out, c" calls C through a pointer (unknown effects)");
            } else {
                buf_str(out, c" calls a '");
                buf_type(out, t, pcx);
                buf_str(out, c"' value (a function of that type whose address is taken)");
            }
        } else if pcx.fns[callee as usize].is_extern {
            buf_str(out, c" calls C's '");
            buf_bytes(out, sym_text(c_symbol(callee, pcx), pcx));
            buf_str(out, c"'");
        }
        else if bit == EFF_DIVERGE
            && (*pcx.component.add(callee as usize)) == (*pcx.component.add(f as usize)) {
            buf_str(out, c" calls '");
            buf_fn_name(out, callee, pcx);
            buf_str(out, c"', which calls back (recursion)");
        } else if (bit == 0 || bit == EFF_ALLOC_EXTERN) && grows_container(callee, pcx) {
            buf_str(out, c" grows a ");
            buf_type(out, pcx.fns[callee as usize].self_ty, pcx);
        } else {
            buf_str(out, c" calls '");
            buf_fn_name(out, callee, pcx);
            buf_str(out, c"'");
        }
        pcx.found_callee = callee;
        n
    }
}

// Appends to out why function f has effect bit `bit` (an EFF_* bit, or 0
// with `alloc` an allocator bit of `allocs`, ALLOC_ANY for any): the
// chain of steps, a line each, down to a local source (or C, or a body
// that did not check).
pub fn explain_effect(f: i64, bit: i64, alloc: i64, out: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut visited = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut cur = f;
        while visited.len() as i64 < 32 {
            visited.push(cur);
            let n = step_text(out, cur, bit, alloc, true, pcx);
            buf_byte(out, b'\n');
            let mut next = pcx.found_callee;
            if n == 0 || next < 0 || pcx.found_kind == E_ALLOC {
                break;
            }
            if next >= pcx.graph_fns {
                // (through a fn value: the first function of that type
                // that has the effect)
                let t = (pcx.virtual_type[(next - pcx.graph_fns) as usize]);
                next = -1;
                let mut i: i64 = 0;
                while t >= 0 && i < pcx.address_taken.len() as i64 {
                    let g = (pcx.address_taken[(i + 1) as usize]);
                    if (pcx.address_taken[i as usize]) == t
                        && has_effect((*pcx.node_fx.add(g as usize)), bit, alloc) {
                        next = g;
                        break;
                    }
                    i += 2;
                }
                if next < 0 {
                    break;
                }
            }
            if pcx.fns[next as usize].is_extern {
                break;
            }
            for k in 0..visited.len() as i64 {
                if (visited[k as usize]) == next {
                    next = -1;
                    break;
                }
            }
            if next < 0 {
                break;
            }
            cur = next;
        }
    }
}
