// The declared effects (0.16; docs/design/effects-allocation.md §2.2,
// §2.8): a function's `#[effects(...)]`, `#[pure]`, `#[no_alloc]`,
// `#[no_io]`, `#[no_panic]` (FnInfo.effect_decl, a chain: several
// intersect), a trait method's (binding every impl, derived ones too),
// and a type parameter's `effects(...)` bound, each an upper bound of the
// inferred set, checked once inference ran. A body whose effects are
// unknown (it failed to check, or calls one that did) is not checked: no
// cascade. On a C function a declaration is trusted (extern_effects).
//
// Their meanings as bounds (decl_bound): `#[pure]` allows panic, diverge
// and unsafe (Koka's pure); `#[no_alloc]`, `#[no_io]`, `#[no_panic]`
// everything but that effect; `#[effects(..)]` exactly the effects
// listed, `alloc` alone any allocator (C's too), `alloc(A, extern)` those.
// Allocator types are resolved where the declaration is (in an instance,
// with its type arguments; a trait method's with the impl's Self).

use crate::base::{buf_bytes, buf_str, get_src, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{
    edit_distance, err_begin, err_end_soft, err_help, err_str, errors_forget, errors_mark,
};
use crate::base::timer::{T_CHECK, T_EFFECTS, timer_now, timer_sub};
use crate::front::ast::{
    EFFECTS_DECL, EFFECTS_NO_ALLOC, EFFECTS_NO_IO, EFFECTS_NO_PANIC, EFFECTS_PURE, NodeKind, child,
};
use crate::front::check::{Try, attempt};
use crate::front::closures::closure_of_type;
use crate::front::effects::{
    ALLOC_ANY, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_INTERIOR, EFF_IO, EFF_PANIC,
    EFF_RAW_DIVERGE, EFF_RAW_GLOBAL, EFF_RAW_PANIC, EFF_SYNC, EFF_THREAD, EFF_TLS, EFF_UNKNOWN,
    EFF_UNSAFE, EFF_VISIBLE, Effects, allocator_bit, effects_none, effects_subset, effects_text,
    fn_effects,
};
use crate::front::effects::builtin::{c_symbol, is_errno_symbol, known_c_effects};
use crate::front::effects::infer::{E_CALL, body_walked, dispatch_of, template_of, through};
use crate::front::effects::why::{effect_name, effect_phrase, step_text};
use crate::front::generics::{env_enter, env_leave};
use crate::front::modules::{module_of, within_std};
use crate::front::traits::{impl_of_fn, implements, std_trait, trait_fn};
use crate::front::types::{TyKind, buf_type};

// The effect names, in display order, and their bits (alloc: 0).
const NAME_COUNT: i64 = 9;

const BOUND_WORDS: i64 = 8;

// The bit of effect name sym (EFF_*; -1 for alloc, 0 unknown).
fn effect_bit(sym: i64, pcx: &Ctx<Comp>) -> i64 {
    let text = sym_text(sym, pcx);
    if text == b"alloc" {
        return -1;
    }
    // (0.27.2.1, E1.2: `static`; `global` its alias through 0.27.x)
    if text == b"io" { EFF_IO } else if text == b"static" || text == b"global" { EFF_GLOBAL }
    else if text == b"panic" { EFF_PANIC } else if text == b"diverge" { EFF_DIVERGE }
    else if text == b"unsafe" { EFF_UNSAFE } else if text == b"tls" { EFF_TLS }
    else if text == b"thread" { EFF_THREAD } else if text == b"sync" { EFF_SYNC } else { 0 }
}

// The intersection of two bounds (any allocator: what the other allows).
fn intersect(a: Effects, b: Effects) -> Effects {
    let allocs = if (a.allocs & ALLOC_ANY) != 0 { b.allocs }
        else if (b.allocs & ALLOC_ANY) != 0 { a.allocs } else { a.allocs & b.allocs };
    Effects { bits: a.bits & b.bits, allocs: allocs }
}

fn everything() -> Effects {
    Effects { bits: EFF_VISIBLE | EFF_INTERIOR, allocs: ALLOC_ANY }
}

// The allocator type node t of a declaration resolved (in the context
// set: CUR_MOD, the type parameters, SELF_TYPE), or TY_ERROR; quiet: an
// error resolving it is not reported.
fn alloc_type(t: i64, quiet: bool, pcx: &mut Ctx<Comp>) -> i64 {
    let mark = errors_mark(pcx);
    let ok = attempt(Try::Type, t, pcx);
    if !ok && quiet {
        errors_forget(mark, pcx);
    }
    if ok { pcx.try_result } else { pcx.ty_error }
}

// The upper bound one EffectSet `set` means (allocator types resolved in
// the context set; quiet as alloc_type).
fn set_bound(set: i64, quiet: bool, pcx: &mut Ctx<Comp>) -> Effects {
    let form = pcx.nodes[set as usize].c;
    if form == EFFECTS_PURE {
        return Effects { bits: EFF_PANIC | EFF_DIVERGE | EFF_UNSAFE, allocs: 0 };
    }
    if form == EFFECTS_NO_ALLOC {
        return Effects { bits: (EFF_VISIBLE | EFF_INTERIOR) & ~EFF_ALLOC_EXTERN, allocs: 0 };
    }
    if form == EFFECTS_NO_IO {
        return Effects { bits: (EFF_VISIBLE | EFF_INTERIOR) & ~EFF_IO, allocs: ALLOC_ANY };
    }
    if form == EFFECTS_NO_PANIC {
        return Effects { bits: (EFF_VISIBLE | EFF_INTERIOR) & ~EFF_PANIC, allocs: ALLOC_ANY };
    }
    // (0.26.1: a list cannot name `interior`, the hidden bit, and allows
    // it; only #[pure] refuses it)
    let mut e = Effects { bits: EFF_INTERIOR, allocs: 0 };
    for i in 0..pcx.nodes[set as usize].count {
        let item = child(set, i, pcx);
        let bit = effect_bit(pcx.nodes[item as usize].a, pcx);
        if bit > 0 {
            e.bits |= bit;
            continue;
        }
        if bit == 0 {
            continue;
        }
        if pcx.nodes[item as usize].count == 0 && pcx.nodes[item as usize].b == 0 {
            e.bits |= EFF_ALLOC_EXTERN;
            e.allocs |= ALLOC_ANY;
            continue;
        }
        if pcx.nodes[item as usize].b != 0 {
            e.bits |= EFF_ALLOC_EXTERN;
        }
        for k in 0..pcx.nodes[item as usize].count {
            let t = alloc_type(child(item, k, pcx), quiet, pcx);
            if t == pcx.ty_error {
                // (reported; or a trait's type the impl cannot name)
                e.allocs |= ALLOC_ANY;
            } else {
                e.allocs |= allocator_bit(t, pcx);
            }
        }
    }
    e
}

// The bound of the declaration chain starting at `set` (see set_bound).
fn chain_bound(set: i64, quiet: bool, pcx: &mut Ctx<Comp>) -> Effects {
    let mut e = everything();
    let mut s = set;
    while s != 0 {
        e = intersect(e, set_bound(s, quiet, pcx));
        s = pcx.nodes[s as usize].b;
    }
    e
}

// (0.27.2.1) The type parameter that EffectItem item names in the context
// set (enter_context), or 0: a parametric item (E3.3a). RULE: E3.3a
fn param_item(item: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[item as usize].count != 0 || pcx.nodes[item as usize].b != 0
        || effect_bit(pcx.nodes[item as usize].a, pcx) != 0 {
        return 0;
    }
    // UNSAFE: TP_NAMES and TP_TYPES, the checker's type-parameter stack, by index.
    // SAFETY: i runs from its top down to TP_BASE, the frame enter_context made.
    unsafe {
        let mut i = pcx.tp_names.count - 1;
        while i >= pcx.tp_base {
            if (*pcx.tp_names.data.add(i as usize)) == pcx.nodes[item as usize].a {
                return (*pcx.tp_types.data.add(i as usize));
            }
            i -= 1;
        }
    }
    0
}

// (0.27.2.1) Before the solve: each declared function of the rust edition
// with a body (an item or an instance) gets its list resolved (FX_DECL_E)
// and its parametric items' types (FX_DECL_TPS), which infer.vl's
// signature_of makes its S(f) once its callees' are known. RULE: E3.1a
pub fn note_declarations(n: i64, pcx: &mut Ctx<Comp>) {
    // UNSAFE: the declaration tables, made here with n + 1 words, by index.
    // SAFETY: f < n; FX_DECL_TPS' words are written at `at`, its own push.
    unsafe {
        pcx.fx_decl = crate::base::alloc_array::<i64>(n + 1);
        pcx.fx_decl_e = crate::base::alloc_array::<Effects>(n + 1);
        pcx.fx_decl_px = crate::base::alloc_array::<Effects>(n + 1);
        pcx.fx_inferred = crate::base::alloc_array::<Effects>(n + 1);
        pcx.fx_decl_tps.count = 0;
        for f in 0..n {
            let decl = pcx.fns[f as usize].effect_decl;
            if decl == 0 || pcx.fns[f as usize].generic > 0 || pcx.fns[f as usize].node == 0
                || pcx.fns[f as usize].is_extern || (*pcx.failed.add(f as usize)) != 0
                || crate::front::effects::infer::error_instance(f, pcx)
                || !crate::places::regions::rust_fn(f, pcx) {
                continue;
            }
            let at = pcx.fx_decl_tps.count;
            (*pcx.fx_decl.add(f as usize)) = at + 1;
            pcx.fx_decl_tps.push(0);
            let saved = enter_context(f, pcx.fns[f as usize].module, pcx);
            (*pcx.fx_decl_e.add(f as usize)) = chain_bound(decl, true, pcx);
            let mut s = decl;
            while s != 0 {
                if pcx.nodes[s as usize].c == EFFECTS_DECL {
                    for i in 0..pcx.nodes[s as usize].count {
                        let t = param_item(child(s, i, pcx), pcx);
                        if t > 0 {
                            pcx.fx_decl_tps.push(t);
                            (*pcx.fx_decl_tps.data.add(at as usize)) += 1;
                        }
                    }
                }
                s = pcx.nodes[s as usize].b;
            }
            leave_context(saved, pcx);
        }
    }
}

// (0.27.2.1) Whether function f (an item or a template) is one `fix --only
// effects` declares and `query items --undeclared` counts: a `pub`
// function or inherent `pub` method of the rust edition with a body; not
// a trait impl's (E3.4: its trait binds it), not a closure, not one the
// compiler made (a derive's, a contract's companion). RULE: E3.6
pub fn declarable(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    let node = pcx.fns[f as usize].node;
    if node <= 0 || pcx.fns[f as usize].tmpl != 0 || pcx.fns[f as usize].is_extern
        || pcx.nodes[node as usize].kind != NodeKind::Fn || pcx.nodes[node as usize].c == 0
        || (pcx.nodes[node as usize].p & crate::front::parser::items::ITEM_PUBLIC) == 0
        || (pcx.nodes[node as usize].p
            & (crate::front::ast::FN_DERIVED | crate::front::ast::FN_CLOSURE))
        != 0 {
        return false;
    }
    let i = impl_of_fn(f, pcx);
    if i >= 0 && pcx.traits_impls[i as usize].tr >= 0 {
        return false;
    }
    // (a trait's default method, made for an impl: its trait's, E3.4)
    let at = pcx.nodes[node as usize].start;
    for tr in 0..pcx.traits.len() as i64 {
        let tn = pcx.traits[tr as usize].node;
        if tn > 0 && at >= pcx.nodes[tn as usize].start && at < pcx.nodes[tn as usize].end {
            return false;
        }
    }
    for &c in sym_text(pcx.fns[f as usize].name, pcx) {
        if c == b'$' {
            return false;
        }
    }
    crate::places::regions::rust_fn(f, pcx)
}

// Sets the context of function f's declarations (its module, its type
// arguments, its Self); what leave_context restores.
fn enter_context(f: i64, module: i64, pcx: &mut Ctx<Comp>) -> i64 {
    pcx.cur_mod = module;
    pcx.self_type = pcx.fns[f as usize].self_ty;
    pcx.self_impl = crate::front::traits::impl_of_fn(f, pcx);
    if pcx.fns[f as usize].tmpl != 0 {
        return env_enter(
            pcx.nodes[pcx.fns[(pcx.fns[f as usize].tmpl - 1) as usize].node as usize].g,
            pcx.fns[f as usize].targs, pcx.fns[f as usize].targ_count, pcx);
    }
    -1
}

fn leave_context(saved: i64, pcx: &mut Ctx<Comp>) {
    if saved >= 0 {
        env_leave(saved, pcx);
    }
    pcx.cur_mod = 0;
    pcx.self_type = 0;
}

// The effects of C function f: its declarations, trusted (a list is the
// set; #[pure] and #[no_*] take from it, or from the default), else the
// builtin table's (EFF_UNKNOWN: unknown C, see infer.vl).
pub fn extern_effects(f: i64, pcx: &mut Ctx<Comp>) -> Effects {
    crate::front::effects::builtin::fill_c_table(pcx);
    let mut e = known_c_effects(c_symbol(f, pcx), pcx);
    let decl = pcx.fns[f as usize].effect_decl;
    if decl == 0 {
        if pcx.edition != 0 && pcx.fns[f as usize].node > 0
            && crate::front::rust::rust_at(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx) {
            // RULE: F19.6 (the rust edition's C function, as below)
            e.bits &= ~EFF_RAW_GLOBAL;
        }
        return e;
    }
    e.bits &= ~EFF_UNKNOWN;
    let saved = enter_context(f, pcx.fns[f as usize].module, pcx);
    let mut listed = false;
    let mut exact = everything();
    let mut limit = everything();
    let mut s = decl;
    while s != 0 {
        if pcx.nodes[s as usize].c == EFFECTS_DECL {
            listed = true;
            exact = intersect(exact, set_bound(s, true, pcx));
        } else {
            limit = intersect(limit, set_bound(s, true, pcx));
        }
        s = pcx.nodes[s as usize].b;
    }
    leave_context(saved, pcx);
    if listed {
        e = exact;
    }
    e = intersect(e, limit);
    e.bits &= ~(EFF_UNSAFE | EFF_INTERIOR);
    if (e.bits & EFF_PANIC) != 0 {
        e.bits |= EFF_RAW_PANIC;
    }
    if (e.bits & EFF_DIVERGE) != 0 {
        e.bits |= EFF_RAW_DIVERGE;
    }
    // (0.21: C's global state, but errno, is not thread-safe)
    // RULE: F19.6 (0.27.4: a C function declared in the rust edition is
    // called only in `unsafe`, the program's to vouch for, as rustc does)
    if (e.bits & EFF_GLOBAL) != 0 && !is_errno_symbol(c_symbol(f, pcx), pcx)
        && !(pcx.edition != 0 && pcx.fns[f as usize].node > 0
            && crate::front::rust::rust_at(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx)) {
        e.bits |= EFF_RAW_GLOBAL;
    }
    e
}

// ---- The checks ----

// Checks every declaration against FN_EFFECTS (after infer_effects).
pub fn check_effects(pcx: &mut Ctx<Comp>) {
    let t = timer_now(pcx);
    unsafe {
        let saved_kind = pcx.err_kind;
        pcx.err_kind = c"effect";
        let allocator = std_trait(c"Allocator", pcx);
        for f in 0..pcx.fns.len() as i64 {
            if pcx.fns[f as usize].tmpl == 0 && pcx.fns[f as usize].node != 0 {
                validate_fn(f, allocator, pcx);
            }
        }
        validate_traits(pcx);
        for f in 0..pcx.fns.len() as i64 {
            // (0.27.2.1: an instance of the error type never runs)
            if !body_walked(f, pcx) || crate::front::effects::infer::error_instance(f, pcx) {
                continue;
            }
            // (E3.1a: what the body does, not its signature)
            let e = crate::front::effects::inferred_effects(f, pcx);
            if (e.bits & EFF_UNKNOWN) != 0 {
                continue;
            }
            let decl = pcx.fns[f as usize].effect_decl;
            if decl != 0 {
                let saved = enter_context(f, pcx.fns[f as usize].module, pcx);
                let bound = crate::front::effects::effects_union(chain_bound(decl, true, pcx),
                    crate::front::effects::declared_through(f, pcx));
                leave_context(saved, pcx);
                if !effects_subset(e, bound) {
                    declared_error(f, e, bound, decl, -1, pcx);
                }
            }
            let i = impl_of_fn(template_of(f, pcx), pcx);
            if i >= 0 && pcx.traits_impls[i as usize].tr >= 0 {
                let tr = pcx.traits_impls[i as usize].tr;
                let tf = trait_fn(tr, pcx.nodes[pcx.fns[f as usize].node as usize].a, pcx);
                if tf != 0 && pcx.nodes[tf as usize].z != 0 && pcx.nodes[tf as usize].z != decl {
                    let saved = enter_context(f, pcx.traits[tr as usize].module, pcx);
                    let mut bound = chain_bound(pcx.nodes[tf as usize].z, true, pcx);
                    // (0.26.1: a trait method's #[pure], `Eq::eq`, binds its
                    // impls but for a cell's read, interior: Cell's Eq reads
                    // its cells; a contract that calls one is still refused,
                    // contracts::impure)
                    bound.bits |= EFF_INTERIOR;
                    leave_context(saved, pcx);
                    if !effects_subset(e, bound) {
                        declared_error(f, e, bound, pcx.nodes[tf as usize].z, tr, pcx);
                    }
                }
            }
        }
        check_noted_bounds(pcx);
        pcx.err_kind = saved_kind;
    }
    timer_sub(T_CHECK, T_EFFECTS, t, pcx);
}

// (0.16) Whether the program outside std declares effects, so that a
// build at -O0 must infer and check them (EFFECTS_WANTED false): a
// function's declaration, a trait method's or an impl of a trait with
// one, an `effects(...)` bound (std's are its own, checked when the
// compiler is tested), a bound met at a call.
pub fn effects_declared(pcx: &mut Ctx<Comp>) -> bool {
    unsafe {
        if pcx.bounds.count > 0 {
            return true;
        }
        for i in 0..pcx.effect_bounds.count {
            if !within_std(module_of((*pcx.effect_bounds.data.add(i as usize)), pcx), pcx) {
                return true;
            }
        }
        for f in 0..pcx.fns.len() as i64 {
            if pcx.fns[f as usize].effect_decl != 0
                && !within_std(pcx.fns[f as usize].module, pcx) {
                return true;
            }
        }
        for tr in 0..pcx.traits.len() as i64 {
            if !within_std(pcx.traits[tr as usize].module, pcx) && trait_declares(tr, pcx) {
                return true;
            }
        }
        for i in 0..pcx.traits_impls.len() as i64 {
            let tr = pcx.traits_impls[i as usize].tr;
            if !within_std(pcx.traits_impls[i as usize].module, pcx) && tr >= 0
                && trait_declares(tr, pcx) {
                return true;
            }
        }
        false
    }
}

// Whether a method of trait tr declares its effects.
fn trait_declares(tr: i64, pcx: &Ctx<Comp>) -> bool {
    let node = pcx.traits[tr as usize].node;
    for i in 0..pcx.nodes[node as usize].count {
        let tf = child(node, i, pcx);
        if pcx.nodes[tf as usize].kind == NodeKind::Fn && pcx.nodes[tf as usize].z != 0 {
            return true;
        }
    }
    false
}

// Validates the declarations of function f (an item or template, not an
// instance) and the `effects(...)` bounds of its type parameters: the
// effect names, allocators given as types (not parameters) that are
// allocators.
fn validate_fn(f: i64, allocator: i64, pcx: &mut Ctx<Comp>) {
    let node = pcx.fns[f as usize].node;
    validate_bounds(node, pcx);
    let mut s = pcx.fns[f as usize].effect_decl;
    while s != 0 {
        validate_names(f, s, pcx);
        validate_allocators(f, node, s, allocator, pcx);
        s = pcx.nodes[s as usize].b;
    }
}

// The `effects(...)` bounds of the type parameters of item node `node`.
fn validate_bounds(node: i64, pcx: &mut Ctx<Comp>) {
    let g = pcx.nodes[node as usize].g;
    if g == 0
        || (pcx.nodes[node as usize].kind != NodeKind::Fn
            && pcx.nodes[node as usize].kind != NodeKind::Struct
            && pcx.nodes[node as usize].kind != NodeKind::Enum) {
        return;
    }
    for i in 0..pcx.nodes[g as usize].count {
        let bounds = pcx.nodes[child(g, i, pcx) as usize].h;
        if bounds == 0 {
            continue;
        }
        for k in 0..pcx.nodes[bounds as usize].count {
            let b = child(bounds, k, pcx);
            if pcx.nodes[b as usize].kind == NodeKind::EffectSet {
                validate_names(-1, b, pcx);
            }
        }
    }
}

// The declarations of the functions of every trait (their names, their
// allocators not parameters).
fn validate_traits(pcx: &mut Ctx<Comp>) {
    for tr in 0..pcx.traits.len() as i64 {
        let node = pcx.traits[tr as usize].node;
        for i in 0..pcx.nodes[node as usize].count {
            let tf = child(node, i, pcx);
            if pcx.nodes[tf as usize].kind != NodeKind::Fn {
                continue;
            }
            validate_bounds(tf, pcx);
            let mut s = pcx.nodes[tf as usize].z;
            while s != 0 {
                validate_names(-1, s, pcx);
                validate_allocators(-1, tf, s, -1, pcx);
                s = pcx.nodes[s as usize].b;
            }
        }
    }
}

// (0.27.2.1) Whether sym names a type parameter of function f or of its
// impl: an item of f's list that is a parametric one (E3.3a).
fn names_type_param(f: i64, sym: i64, pcx: &Ctx<Comp>) -> bool {
    let g = pcx.nodes[pcx.fns[f as usize].node as usize].g;
    if g > 0 {
        for i in 0..pcx.nodes[g as usize].count {
            if pcx.nodes[child(g, i, pcx) as usize].a == sym {
                return true;
            }
        }
    }
    let i = impl_of_fn(f, pcx);
    if i >= 0 {
        let ig = pcx.nodes[pcx.traits_impls[i as usize].node as usize].g;
        if ig > 0 {
            for k in 0..pcx.nodes[ig as usize].count {
                if pcx.nodes[child(ig, k, pcx) as usize].a == sym {
                    return true;
                }
            }
        }
    }
    false
}

// (0.27.2.1) Whether name starts with a capital: a type's, never an
// effect's (a parametric item whose parameter the generics do not show
// here, `T: ?Sized` of an impl for `[T]`, resolves per instance).
fn capitalized(name: &[u8]) -> bool {
    name.len() > 0 && name[0] >= b'A' && name[0] <= b'Z'
}

// The names of EffectSet s's effects are effects; only alloc takes
// allocators.
fn validate_names(f: i64, s: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[s as usize].count {
        let item = child(s, i, pcx);
        let bit = effect_bit(pcx.nodes[item as usize].a, pcx);
        if bit == 0 && f >= 0 && pcx.nodes[item as usize].count == 0
            && pcx.nodes[item as usize].b == 0
            && (names_type_param(f, pcx.nodes[item as usize].a, pcx)
                || capitalized(sym_text(pcx.nodes[item as usize].a, pcx))) {
            // (E3.3a: a parametric item)
            continue;
        }
        if bit == 0 {
            let name = sym_text(pcx.nodes[item as usize].a, pcx);
            err_begin(pcx.nodes[item as usize].start, pcx);
            err_str(c"unknown effect '", pcx);
            buf_bytes(pcx.err, name);
            err_str(c"' (effects: alloc, io, static, panic, diverge, unsafe)", pcx);
            let near = nearest_effect(name);
            if near != 0 as *mut u8 {
                err_help(c"did you mean '", pcx);
                err_help(near, pcx);
                err_help(c"'?", pcx);
            }
            err_end_soft(pcx);
        }
        else if bit > 0 && (pcx.nodes[item as usize].count > 0 || pcx.nodes[item as usize].b != 0) {
            err_begin(pcx.nodes[item as usize].start, pcx);
            err_str(c"only 'alloc' names allocators: '", pcx);
            buf_bytes(pcx.err, sym_text(pcx.nodes[item as usize].a, pcx));
            err_str(c"' takes none", pcx);
            err_end_soft(pcx);
        }
    }
}

// The effect name nearest to `name` (a typo or a longer word), or null.
fn nearest_effect(name: &[u8]) -> *mut u8 {
    let names: [*mut u8; 9] = [c"alloc", c"io", c"static", c"panic", c"diverge", c"unsafe", c"tls",
        c"thread", c"sync"];
    let texts: [&[u8]; 9] = [b"alloc", b"io", b"static", b"panic", b"diverge", b"unsafe", b"tls",
        b"thread", b"sync"];
    let mut best: i64 = -1;
    let mut best_d: i64 = 3;
    for i in 0..NAME_COUNT {
        let t = texts[i as usize];
        let prefix = t.len() >= 2 && name.len() > t.len()
            && name[0..t.len()] == t;
        let d: i64 = if prefix { 1 } else { edit_distance(name, t) };
        if d < best_d {
            best_d = d;
            best = i;
        }
    }
    if best < 0 { 0 as *mut u8 } else { names[best as usize] }
}

// The allocators of EffectSet s (of function f, node `node`; f -1 for a
// trait's) are types, not its parameters, and (when f is not generic)
// allocator types.
fn validate_allocators(f: i64, node: i64, s: i64, allocator: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[s as usize].count {
        let item = child(s, i, pcx);
        if effect_bit(pcx.nodes[item as usize].a, pcx) != -1 {
            continue;
        }
        for k in 0..pcx.nodes[item as usize].count {
            let t = child(item, k, pcx);
            let param = param_named(node, t, pcx);
            if param != 0 {
                err_begin(pcx.nodes[t as usize].start, pcx);
                err_str(c"effects name allocator types: '", pcx);
                buf_bytes(pcx.err, sym_text(pcx.nodes[t as usize].a, pcx));
                err_str(c"' is a parameter", pcx);
                let pt = pcx.nodes[param as usize].b;
                if pt != 0 {
                    let mut ty = pt;
                    if pcx.nodes[ty as usize].kind == NodeKind::TyPtr {
                        ty = pcx.nodes[ty as usize].a;
                    }
                    err_help(c"name its type\n  = try: #[effects(alloc(", pcx);
                    buf_bytes(pcx.err_help,
                        &get_src()[
                            pcx.nodes[ty as usize].start as usize..pcx.nodes[ty as usize].end as usize]);
                    err_help(c"))]", pcx);
                }
                err_end_soft(pcx);
                continue;
            }
            if f < 0 || pcx.fns[f as usize].generic > 0 {
                continue;
            }
            let saved = enter_context(f, pcx.fns[f as usize].module, pcx);
            let ty = alloc_type(t, false, pcx);
            leave_context(saved, pcx);
            if ty != pcx.ty_error && allocator >= 0 && !implements(allocator, ty, pcx) {
                err_begin(pcx.nodes[t as usize].start, pcx);
                err_str(c"'", pcx);
                buf_type(pcx.err, ty, pcx);
                err_str(
                    c"' is not an allocator: effects name allocator types (an 'impl Allocator')",
                    pcx);
                err_help(
                    c"Gpa, Arena, ScopedArena, FixedBuf, or a type parameter 'A: Allocator'",
                    pcx);
                err_end_soft(pcx);
            }
        }
    }
}

// The parameter of function node `node` that type node t (a plain name)
// names, or 0.
fn param_named(node: i64, t: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.nodes[t as usize].kind != NodeKind::TyName || pcx.nodes[t as usize].g != 0
        || pcx.nodes[t as usize].count != 0 {
        return 0;
    }
    for i in 0..pcx.nodes[node as usize].count {
        let p = child(node, i, pcx);
        if pcx.nodes[p as usize].kind == NodeKind::Param
            && pcx.nodes[p as usize].a == pcx.nodes[t as usize].a {
            return p;
        }
    }
    0
}

// The first effect of e that bound does not allow, as (bit, alloc): an
// EFF_* bit, or 0 and an allocator bit (EFF_ALLOC_EXTERN for C's).
fn first_excess(e: Effects, bound: Effects, pcx: &Ctx<Comp>) -> (i64, i64) {
    if (bound.allocs & ALLOC_ANY) == 0 {
        let extra = e.allocs & ~bound.allocs;
        if extra != 0 {
            for i in 0..pcx.allocators.count {
                if (extra & (1 << i)) != 0 {
                    return (0, 1 << i);
                }
            }
            return (0, ALLOC_ANY);
        }
    }
    let bits: [i64; 7] = [EFF_ALLOC_EXTERN, EFF_IO, EFF_GLOBAL, EFF_PANIC, EFF_DIVERGE, EFF_UNSAFE,
        EFF_INTERIOR];
    for k in 0..7 {
        if (e.bits & bits[k as usize]) != 0 && (bound.bits & bits[k as usize]) == 0 {
            return (bits[k as usize], 0);
        }
    }
    (0, 0)
}

// The first declaration of the chain at `set` that does not allow (bit,
// alloc) (quietly resolved in the context set), or `set`.
fn violated_set(set: i64, bit: i64, alloc: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let mut s = set;
    while s != 0 {
        let b = set_bound(s, true, pcx);
        let allowed = if bit != 0 { (b.bits & bit) != 0 }
            else { (b.allocs & ALLOC_ANY) != 0 || (b.allocs & alloc) != 0 };
        if !allowed {
            return s;
        }
        s = pcx.nodes[s as usize].b;
    }
    set
}

// Appends declaration `set` as written: `#[no_alloc]`, `#[effects(io)]`.
pub fn buf_decl(out: i64, set: i64, pcx: &Ctx<Comp>) {
    // (an attribute's span starts at its `#[`, a bound's at `effects`)
    let start = pcx.nodes[set as usize].start;
    if get_src()[start as usize] != b'#' {
        buf_str(out, c"#[");
    }
    buf_bytes(out, &get_src()[start as usize..pcx.nodes[set as usize].end as usize]);
    buf_str(out, c"]");
}

// Appends the name of function f for messages (an instance's template's).
pub fn buf_fn_name(out: i64, f: i64, pcx: &Ctx<Comp>) {
    buf_bytes(out, sym_text(pcx.fns[template_of(f, pcx) as usize].display, pcx));
}

// The error for function f, whose effects e exceed the bound of the
// declaration chain at decl (f's own, or with tr >= 0 its trait's).
fn declared_error(f: i64, e: Effects, bound: Effects, decl: i64, tr: i64, pcx: &mut Ctx<Comp>) {
    let (bit, alloc) = first_excess(e, bound, pcx);
    if bit == 0 && alloc == 0 {
        return;
    }
    let saved = enter_context(f,
        if tr >= 0 { pcx.traits[tr as usize].module } else { pcx.fns[f as usize].module }, pcx);
    let set = violated_set(decl, bit, alloc, pcx);
    leave_context(saved, pcx);
    let saved_inst = pcx.cur_inst;
    pcx.cur_inst = if pcx.fns[f as usize].tmpl != 0 { f } else { -1 };
    err_begin(pcx.nodes[pcx.fns[f as usize].node as usize].start, pcx);
    err_str(c"'", pcx);
    buf_fn_name(pcx.err, f, pcx);
    if tr >= 0 {
        err_str(c"' implements '", pcx);
        buf_bytes(pcx.err, sym_text(pcx.traits[tr as usize].name, pcx));
        err_str(c"::", pcx);
        buf_bytes(pcx.err, sym_text(pcx.nodes[pcx.fns[f as usize].node as usize].a, pcx));
        err_str(c"', which is ", pcx);
    } else {
        err_str(c"' is ", pcx);
    }
    buf_decl(pcx.err, set, pcx);
    err_str(c", but it ", pcx);
    effect_phrase(pcx.err, bit, alloc, pcx);
    err_str(c": ", pcx);
    let source = step_text(pcx.err, f, bit, alloc, false, pcx);
    effect_help(bit, source, pcx);
    err_help(c", or ", pcx);
    if pcx.nodes[set as usize].c == EFFECTS_DECL {
        err_help(c"add '", pcx);
        effect_name(pcx.err_help, bit, alloc, pcx);
        err_help(c"' to ", pcx);
    } else {
        err_help(c"remove ", pcx);
    }
    buf_decl(pcx.err_help, set, pcx);
    if tr >= 0 {
        err_help(c" (the trait's)", pcx);
    }
    err_help(c"\n  = try: volec query effects ", pcx);
    buf_fn_name(pcx.err_help, f, pcx);
    err_help(c" --why ", pcx);
    effect_name(pcx.err_help, bit, alloc, pcx);
    err_end_soft(pcx);
    pcx.cur_inst = saved_inst;
}

// The help for an effect (bit, alloc) a declaration does not allow, whose
// source is node `source` (0: none).
fn effect_help(bit: i64, source: i64, pcx: &Ctx<Comp>) {
    if bit == 0 || bit == EFF_ALLOC_EXTERN {
        err_help(c"allocate in the caller and pass the memory in", pcx);
    } else if bit == EFF_IO {
        err_help(c"return the data and let the caller print it", pcx);
    } else if bit == EFF_GLOBAL {
        err_help(c"pass the state in as a parameter", pcx);
    } else if bit == EFF_PANIC {
        if source != 0 && pcx.nodes[source as usize].kind == NodeKind::Index {
            err_help(c"iterate ('for x in s'), or 's.get(i)' (an Option)", pcx);
        } else {
            err_help(c"return an Option or a Result instead of stopping", pcx);
        }
    } else if bit == EFF_INTERIOR {
        err_help(c"read the cell in the caller and pass the value in", pcx);
    } else if bit == EFF_DIVERGE {
        err_help(c"loop with a counted 'for' (a range, a slice, a Vec)", pcx);
    } else {
        err_help(c"keep the unsafe code out of this function", pcx);
    }
}

// ---- Bounds ----

// Bound `bound` (an EffectSet in the bounds of type parameter `param`, a
// TyName, of generic item `what`) holds for type ty (a closure's or fn's
// type) bound to it at pos: recorded by check_bounds (its type parameters
// bound, so the allocators resolve now), checked by check_effects once
// effects are known.
pub fn note_effect_bound(bound: i64, ty: i64, pos: i64, param: i64, what: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if ty <= 0 || ty == pcx.ty_error {
            return;
        }
        let mut i: i64 = 0;
        while i < pcx.bounds.count {
            if (*pcx.bounds.data.add(i as usize)) == bound
                && (*pcx.bounds.data.add((i + 1) as usize)) == ty
                && (*pcx.bounds.data.add((i + 2) as usize)) == pos {
                return;
            }
            i += BOUND_WORDS;
        }
        let allowed = set_bound(bound, true, pcx);
        pcx.bounds.push(bound);
        pcx.bounds.push(ty);
        pcx.bounds.push(pos);
        pcx.bounds.push(param);
        pcx.bounds.push(what);
        pcx.bounds.push(allowed.bits);
        pcx.bounds.push(allowed.allocs);
        pcx.bounds.push(pcx.cur_inst);
    }
}

// The effects of calling a value of type ty: a closure's, or (a fn type)
// those of the functions of that type whose address is taken; -1 in
// `bits` when unknown.
fn callable_effects(ty: i64, pcx: &mut Ctx<Comp>) -> (Effects, i64) {
    unsafe {
        let c = closure_of_type(ty, pcx);
        if c != 0 {
            let f = pcx.closures[(c - 1) as usize].f;
            return (through(fn_effects(f, pcx), E_CALL, 0, pcx), f);
        }
        if pcx.types[ty as usize].kind == TyKind::Fn {
            let v = dispatch_of(crate::front::types::fn_ty_safe(ty, pcx), pcx);
            if v < 0 || pcx.node_fx == 0 as *mut Effects {
                return (effects_none(), -1);
            }
            return (through((*pcx.node_fx.add(v as usize)), E_CALL, 0, pcx), -1);
        }
        (Effects { bits: EFF_UNKNOWN, allocs: 0 }, -1)
    }
}

fn check_noted_bounds(pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut i: i64 = 0;
        while i < pcx.bounds.count {
            let ty = (*pcx.bounds.data.add((i + 1) as usize));
            let (e, f) = callable_effects(ty, pcx);
            let allowed = Effects {
                bits: (*pcx.bounds.data.add((i + 5) as usize)),
                allocs: (*pcx.bounds.data.add((i + 6) as usize)),
            };
            if (e.bits & EFF_UNKNOWN) == 0 && !effects_subset(e, allowed) {
                bound_error(i, e, allowed, f, pcx);
            }
            i += BOUND_WORDS;
        }
        pcx.bounds.count = 0;
    }
}

// The error for the bound recorded at BOUNDS[i]: the closure (function
// f, or -1 for a fn type) has effects e, beyond `allowed`.
fn bound_error(i: i64, e: Effects, allowed: Effects, f: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let bound = (*pcx.bounds.data.add(i as usize));
        let ty = (*pcx.bounds.data.add((i + 1) as usize));
        let param = (*pcx.bounds.data.add((i + 3) as usize));
        let (bit, alloc) = first_excess(e, allowed, pcx);
        if bit == 0 && alloc == 0 {
            return;
        }
        let saved_inst = pcx.cur_inst;
        pcx.cur_inst = (*pcx.bounds.data.add((i + 7) as usize));
        err_begin((*pcx.bounds.data.add((i + 2) as usize)), pcx);
        err_str(if f >= 0 { c"the closure for '" } else { c"the function for '" }, pcx);
        buf_bytes(pcx.err, sym_text(pcx.nodes[param as usize].a, pcx));
        err_str(c"' of '", pcx);
        buf_bytes(pcx.err, sym_text((*pcx.bounds.data.add((i + 4) as usize)), pcx));
        err_str(c"' ", pcx);
        effect_phrase(pcx.err, bit, alloc, pcx);
        if f >= 0 {
            err_str(c" (", pcx);
            step_text(pcx.err, f, bit, alloc, false, pcx);
            err_str(c")", pcx);
        } else {
            err_str(c" (a '", pcx);
            buf_type(pcx.err, ty, pcx);
            err_str(c"' whose address is taken)", pcx);
        }
        err_str(c"; '", pcx);
        let bounds = pcx.nodes[param as usize].h;
        let last = child(bounds, pcx.nodes[bounds as usize].count - 1, pcx);
        let mut end = pcx.nodes[last as usize].end;
        if end < pcx.nodes[bound as usize].end {
            end = pcx.nodes[bound as usize].end;
        }
        buf_bytes(pcx.err, &get_src()[pcx.nodes[param as usize].start as usize..end as usize]);
        err_str(c"' allows ", pcx);
        effects_text(pcx.err, allowed, pcx);
        err_str(c" only", pcx);
        err_help(c"do only what the bound allows in the closure, or allow '", pcx);
        effect_name(pcx.err_help, bit, alloc, pcx);
        err_help(c"' in the bound", pcx);
        err_end_soft(pcx);
        pcx.cur_inst = saved_inst;
    }
}
