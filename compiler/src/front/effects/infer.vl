// Effect inference (0.16; docs/design/effects-allocation.md §2.1, §3):
// one walk per checked body (its local effects, and its calls as edges of
// a call graph), Tarjan's strongly connected components over that graph,
// and the union of each component's sets, callees first. A separate walk
// after checking, not checker hooks: speculative checking (`attempt`)
// would add effects that are not there. No iteration: within a component
// every member reaches every other, so all have the same set.
//
// The graph's nodes are the functions (FNS indexes: items, instances,
// closures, C functions) and, after them, virtual nodes: one per fn type
// called through a value (closed world: its edges go to every function of
// that type whose address is taken, coerced closures included) and one for
// unknown C (`alloc(extern) io global panic diverge`, and an edge to each
// address-taken `extern "C" fn` of the program: the callbacks C may call).
// An edge is one of:
//   E_CALL   the callee's effects, but not its `unsafe` (a safe function
//            encapsulates its unsafety)
//   E_ALLOC  a call of a method of `impl Allocator for X`: alloc(X) is the
//            call's local effect, and through the edge come only the raw
//            panic and diverge (refills, internal loops and panics are the
//            allocator's business: the encapsulation rule)
//   E_SCOPE  a call of arena_scope, Arena::scope or ScopedArena::scope:
//            the callee's effects without alloc(ScopedArena) (its own
//            arena: #[scoped] keeps it from escaping), with the parent's
//            allocator (SCOPE_ADD): discharge
// A component with a cycle (recursion) also gets `diverge`.
//
// The local effects (walk): a `static mut` (or a C static) read, written
// or its address taken is global; a checked index or slicing (unless in
// bounds: in_bounds), a failed `as E`, a vector load, store or lane is
// panic; `while` and `loop` are diverge (`for` over a range is counted:
// the desugared `for` loops are); an operation that needs unsafe code is
// unsafe. A body that failed to check is ⊤, unknown (no cascade of
// declared-effect errors in its callers).
//
// why.vl walks a body again in search mode (find_step): the first
// local source or call that brings a given effect.

use crate::arch::{intrinsic_effect_bits, intrinsic_of_fn};
use crate::base::{IntVec, alloc_array, intern_c, sym_text};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::timer::{T_CHECK, T_EFFECTS, timer_now, timer_sub};
use crate::front::ast::{
    FN_BODY_FAILED, FN_SIG_FAILED, FN_UNSAFE, NODE_IN_BOUNDS, NODE_RAW, NODE_REF_MUT, NodeKind,
    REPR_UNION, VK_LANE, VK_LOAD, VK_STORE, VK_WITH, child,
};
use crate::front::check::Res;
use crate::front::check::unsafety::{NODE_NO_READ, is_borrow, is_borrow_param};
use crate::front::effects::{
    ALLOC_ANY, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_INTERIOR, EFF_IO, EFF_PANIC,
    EFF_RAW_DIVERGE, EFF_RAW_GLOBAL, EFF_RAW_PANIC, EFF_SYNC, EFF_TLS, EFF_UNKNOWN, EFF_UNSAFE,
    Effects, allocator_bit, effects_none, effects_top, effects_union,
};
use crate::front::effects::builtin::unknown_c_effects;
use crate::front::effects::check::extern_effects;
use crate::front::lexer::Tok;
use crate::front::modules::within_std;
use crate::front::modules::lookup::std_item_key;
use crate::front::threadlocal::is_thread_local;
use crate::front::traits::{impl_of_fn, std_trait};
use crate::front::types::{REF_SHARED, TyKind, struct_type, vec_lanes};
use crate::middle::lower::atomic::atomic_intrinsic;
use crate::middle::lower::ssa::HMap;

// The kinds of edges (above).
pub const E_CALL: i64 = 0;
pub const E_ALLOC: i64 = 1;
pub const E_SCOPE: i64 = 2;

// (0.27.2.1) A drop's edge (drop_edges): a call, for through; E3.3a lets
// what it brings through a declaration of a generic instance (a drop of a
// T's parts, `String<A>`'s Vec, is made for T).
pub const E_DROP: i64 = 3;

const CALL_UNSAFE: i64 = 8;
const BORROW_SHIFT: i64 = 8;
const BORROW_PARAMS: i64 = 48;

const LOOP_SLICE: i64 = 1;
const LOOP_LENGTH: i64 = 2;

// Function f's body failed to check (check_function_recovering): its
// effects are ⊤.
pub fn note_body_failed(f: i64, pcx: &mut Ctx<Comp>) {
    pcx.failed_list.push(f);
}

// The template of instance f (f itself when not an instance).
pub fn template_of(f: i64, pcx: &Ctx<Comp>) -> i64 {
    if pcx.fns[f as usize].tmpl != 0 { pcx.fns[f as usize].tmpl - 1 } else { f }
}

// The type of std's struct `name`, or 0.
pub fn std_struct_type(name: *mut u8, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.std_module < 0 {
            return 0;
        }
        let key = std_item_key(intern_c(name, pcx), pcx);
        let s: i64 = if key < 0 { -1 } else { (*pcx.sym_struct.add(key as usize)) - 1 };
        if s < 0 || pcx.structs[s as usize].generic != 0 { 0 } else { struct_type(s, pcx) }
    }
}

// Whether function f is a method of an `impl Allocator for X` (X its
// self type).
pub fn is_allocator_method(f: i64, pcx: &Ctx<Comp>) -> bool {
    if pcx.infer_allocator_trait < 0 || pcx.fns[f as usize].self_ty == 0 {
        return false;
    }
    let i = impl_of_fn(template_of(f, pcx), pcx);
    i >= 0 && pcx.traits_impls[i as usize].tr == pcx.infer_allocator_trait
}

// (0.27.2.1, E4.4a) Whether a call of allocator method f (a method of an
// `impl Allocator for X`) allocates or frees: not when it is `deallocate`
// of an impl whose `const FREES` is `false` (an arena's, a scope's, a
// FixedBuf's: it gives nothing back), nor of the impl for `&A` whose
// `A::FREES` is. RULE: E4.4a
fn allocates(f: i64, pcx: &mut Ctx<Comp>) -> bool {
    if sym_text(pcx.nodes[pcx.fns[f as usize].node as usize].a, pcx) != b"deallocate" {
        return true;
    }
    impl_frees(impl_of_fn(template_of(f, pcx), pcx), pcx.fns[f as usize].self_ty, 0, pcx)
}

// (0.27.2.1, E4.4a) The `FREES` of impl i (of Allocator, for self_ty): its
// `const FREES` when a literal, the pointee's for `A::FREES` of the impl
// for `&A`, else the trait's default, true.
fn impl_frees(i: i64, self_ty: i64, depth: i64, pcx: &mut Ctx<Comp>) -> bool {
    if i < 0 || depth > 4 {
        return true;
    }
    // (an impl's constants are AssocType nodes flagged NODE_ASSOC_CONST in
    // its holder, the Impl node's c: parse_assoc_const)
    let holder = pcx.nodes[pcx.traits_impls[i as usize].node as usize].c;
    if holder <= 0 {
        return true;
    }
    let name = intern_c(c"FREES", pcx);
    for k in 0..pcx.nodes[holder as usize].count {
        let c = child(holder, k, pcx);
        if pcx.nodes[c as usize].kind != NodeKind::AssocType
            || (pcx.nodes[c as usize].p & crate::front::ast::NODE_ASSOC_CONST) == 0
            || pcx.nodes[c as usize].a != name {
            continue;
        }
        let v = pcx.nodes[c as usize].c;
        if v > 0 && pcx.nodes[v as usize].kind == NodeKind::Bool {
            return pcx.nodes[v as usize].a != 0;
        }
        if self_ty > 0 && pcx.types[self_ty as usize].kind == TyKind::Ptr {
            // (the impl for &A: A's, through one of its methods)
            let inner = pcx.types[self_ty as usize].a;
            for g in 0..pcx.fns.len() as i64 {
                if pcx.fns[g as usize].self_ty == inner && is_allocator_method(g, pcx) {
                    return impl_frees(impl_of_fn(template_of(g, pcx), pcx), inner, depth + 1, pcx);
                }
            }
        }
        return true;
    }
    true
}

// Whether f is a part of std's arenas whose own allocation is the arena's
// business (a scope's end giving the blocks of their own back to Gpa): a
// call of it is masked as an Allocator method's is, and adds no allocator.
fn is_arena_internal(f: i64, pcx: &Ctx<Comp>) -> bool {
    within_std(pcx.fns[f as usize].module, pcx) && pcx.fns[f as usize].self_ty == 0
        && pcx.nodes[pcx.fns[f as usize].node as usize].a == pcx.arena_unlend_sym
}

// The parent allocator type of a call of function f when f is one of std's
// arena scopes (arena_scope: Gpa; Arena::scope: Arena; ScopedArena::scope:
// ScopedArena), else 0.
pub fn scope_parent(f: i64, pcx: &Ctx<Comp>) -> i64 {
    let base = template_of(f, pcx);
    if !within_std(pcx.fns[base as usize].module, pcx) {
        return 0;
    }
    let name = pcx.nodes[pcx.fns[base as usize].node as usize].a;
    let self_ty = pcx.fns[f as usize].self_ty;
    if name == pcx.arena_scope_sym && self_ty == 0 {
        return pcx.infer_gpa_type;
    }
    if name != pcx.scope_sym || self_ty <= 0 || pcx.types[self_ty as usize].kind != TyKind::Struct {
        return 0;
    }
    let s = pcx.structs[pcx.types[self_ty as usize].a as usize].name;
    if s == pcx.arena_sym || s == pcx.scoped_sym { self_ty } else { 0 }
}

// Effects e as seen through an edge of kind `kind` (add: E_SCOPE's parent
// allocator bits).
pub fn through(e: Effects, kind: i64, add: i64, pcx: &mut Ctx<Comp>) -> Effects {
    if kind == E_ALLOC {
        return Effects { bits: e.bits & (EFF_RAW_PANIC | EFF_RAW_DIVERGE), allocs: 0 };
    }
    let mut allocs = e.allocs;
    if kind == E_SCOPE {
        if pcx.scoped_type != 0 && (allocs & ALLOC_ANY) == 0 {
            allocs = allocs & ~allocator_bit(pcx.scoped_type, pcx);
        }
        allocs = allocs | add;
    }
    Effects { bits: e.bits & ~EFF_UNSAFE, allocs: allocs }
}

// Whether e has the effect (bit, alloc): an EFF_* bit, or with bit 0 the
// allocator bit alloc (ALLOC_ANY: any allocation, C's too).
pub fn has_effect(e: Effects, bit: i64, alloc: i64) -> bool {
    if bit != 0 {
        return (e.bits & bit) != 0;
    }
    if alloc == ALLOC_ANY {
        return e.allocs != 0 || (e.bits & EFF_ALLOC_EXTERN) != 0;
    }
    (e.allocs & alloc) != 0 || (e.allocs & ALLOC_ANY) != 0
}

// ---- Inference ----

// Fills FN_EFFECTS, after the bodies and instances are checked (called by
// check_program, before exit_if_errors).
pub fn infer_effects(pcx: &mut Ctx<Comp>) {
    let t = timer_now(pcx);
    unsafe {
        init_walk(pcx);
        let n = pcx.fns.len() as i64;
        pcx.graph_fns = n;
        pcx.failed = alloc_array::<i64>(n + 1);
        for i in 0..pcx.failed_list.count {
            if (*pcx.failed_list.data.add(i as usize)) < n {
                (*pcx.failed.add((*pcx.failed_list.data.add(i as usize)) as usize)) = 1;
            }
        }
        // (a closure of a function that failed is unknown too: its
        // enclosing function is made before it)
        for c in 0..pcx.closures.len() as i64 {
            let e = pcx.closures[c as usize].encl_fn;
            let f = pcx.closures[c as usize].f;
            if e >= 0 && e < n && f >= 0 && f < n && (*pcx.failed.add(e as usize)) != 0 {
                (*pcx.failed.add(f as usize)) = 1;
            }
        }
        pcx.local_fx = alloc_array::<Effects>(n + 1);
        pcx.callee_info = alloc_array::<i64>(n + 1);
        pcx.static_uses.count = 0;
        pcx.static_use_start.count = 0;
        pcx.sa_memo = HMap { keys: 0 as *mut i64, vals: 0 as *mut i64, size: 0, count: 0 };
        pcx.sa_seen = 0 as *mut i64;
        pcx.sa_top = alloc_array::<i64>(n + 1);
        for f in 0..n {
            pcx.edge_start.push(pcx.edges.count);
            pcx.static_use_start.push(pcx.static_uses.count);
            (*pcx.local_fx.add(f as usize)) = node_locals(f, pcx);
        }
        pcx.static_use_start.push(pcx.static_uses.count);
        // The virtual nodes' edges, in the order they were made.
        let addr = pcx.address_taken.count;
        for k in 0..pcx.virtual_type.count {
            pcx.edge_start.push(pcx.edges.count);
            let vt = (*pcx.virtual_type.data.add(k as usize));
            let mut i: i64 = 0;
            while i < addr {
                let t = (*pcx.address_taken.data.add(i as usize));
                let f = (*pcx.address_taken.data.add((i + 1) as usize));
                let callback = vt < 0 && pcx.types[t as usize].kind == TyKind::Fn
                    && crate::front::types::fn_ty_c(t, pcx);
                // (0.27.2.1: an instance of the error type, made in query
                // mode, never runs: its ⊤ would make every fn value's call ⊤)
                if (t == vt || callback) && !error_instance(f, pcx) {
                    push_edge(f, E_CALL, 0, pcx);
                }
                i += 2;
            }
        }
        pcx.graph_size = n + pcx.virtual_type.count;
        pcx.edge_start.push(pcx.edges.count);
        crate::front::effects::check::note_declarations(n, pcx);
        components(pcx);
        pcx.fn_effects = pcx.node_fx;
        pcx.fn_effects_count = n;
    }
    timer_sub(T_CHECK, T_EFFECTS, t, pcx);
}

// (0.25) How function f may access mutable static s by name, in its body
// or in what it calls (fn values, unknown C callbacks and dyn calls
// through their virtual nodes): 0 not at all, bit 1 a read, bit 2 a
// change. An unknown callee (f < 0), or one whose effects are unknown
// (a body not checked), may do anything: 3. own::calls::static_args asks
// it for a static lent to a call.
pub fn static_access(f: i64, s: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        if f < 0 || f >= pcx.graph_fns || pcx.static_use_start.count <= pcx.graph_fns {
            return 3;
        }
        let key = f * 65536 + s + 1;
        let known = pcx.sa_memo.get(key);
        if known != 0 {
            return known - 1;
        }
        if pcx.sa_seen == 0 as *mut i64 {
            pcx.sa_seen = alloc_array::<i64>(pcx.graph_size + 1);
        }
        pcx.sa_stamp += 1;
        let mut how: i64 = 0;
        pcx.sa_stack.count = 0;
        pcx.sa_stack.push(f);
        (*pcx.sa_seen.add(f as usize)) = pcx.sa_stamp;
        while pcx.sa_stack.count > 0 && how != 3 {
            pcx.sa_stack.count -= 1;
            let v = (*pcx.sa_stack.data.add(pcx.sa_stack.count as usize));
            if v < pcx.graph_fns {
                if (*pcx.sa_top.add(v as usize)) != 0 {
                    how = 3;
                    break;
                }
                let mut i = (*pcx.static_use_start.data.add(v as usize));
                while i < (*pcx.static_use_start.data.add((v + 1) as usize)) {
                    if (*pcx.static_uses.data.add(i as usize)) == s {
                        how |= (*pcx.static_uses.data.add((i + 1) as usize));
                    }
                    i += 2;
                }
            }
            for e in (*pcx.edge_start.data.add(v as usize))..(*pcx.edge_start.data.add((v + 1) as usize)) {
                let w = edge_to(e, pcx);
                if ((*pcx.edges.data.add(e as usize)) & 3) != E_ALLOC && w >= 0 && w < pcx.graph_size
                    && (*pcx.sa_seen.add(w as usize)) != pcx.sa_stamp {
                    (*pcx.sa_seen.add(w as usize)) = pcx.sa_stamp;
                    pcx.sa_stack.push(w);
                }
            }
        }
        pcx.sa_memo.put(key, how + 1);
        how
    }
}

fn init_walk(pcx: &mut Ctx<Comp>) {
    pcx.edge_start.count = 0;
    pcx.edges.count = 0;
    pcx.scope_add.clear();
    pcx.virtual_type.count = 0;
    pcx.address_taken.count = 0;
    pcx.infer_dispatch.clear();
    pcx.c_unknown = -1;
    pcx.infer_allocator_trait = std_trait(c"Allocator", pcx);
    pcx.infer_gpa_type = std_struct_type(c"Gpa", pcx);
    pcx.scoped_type = std_struct_type(c"ScopedArena", pcx);
    pcx.arena_sym = intern_c(c"Arena", pcx);
    pcx.scoped_sym = intern_c(c"ScopedArena", pcx);
    pcx.scope_sym = intern_c(c"scope", pcx);
    pcx.arena_scope_sym = intern_c(c"arena_scope", pcx);
    pcx.arena_unlend_sym = intern_c(c"arena_unlend", pcx);
    pcx.len_sym = intern_c(c"len", pcx);
    pcx.search = false;
}

// Whether function f's body is walked: checked, not a template, not
// failed. (A lazy default never used was not checked: its body has no
// type.)
pub fn body_walked(f: i64, pcx: &Ctx<Comp>) -> bool {
    let node = pcx.fns[f as usize].node;
    if node == 0 || pcx.nodes[node as usize].kind != NodeKind::Fn || pcx.fns[f as usize].generic > 0
        || (pcx.nodes[node as usize].p & (FN_SIG_FAILED | FN_BODY_FAILED)) != 0 {
        return false;
    }
    let body = pcx.nodes[node as usize].c;
    body != 0 && pcx.nodes[body as usize].ty != 0
}

// Whether function f's effects are ⊤: a template, a body that failed or
// was not checked, an instance of the error type (query mode).
fn is_top(f: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        if (*pcx.failed.add(f as usize)) != 0 || pcx.fns[f as usize].node == 0 {
            return true;
        }
        if pcx.fns[f as usize].is_extern {
            return false;
        }
        if !body_walked(f, pcx) {
            return true;
        }
        for i in 0..pcx.fns[f as usize].targ_count {
            if (*pcx.tlists.data.add((pcx.fns[f as usize].targs + i) as usize)) == pcx.ty_error {
                return true;
            }
        }
        false
    }
}

// (0.27.2.1) Whether function f is an instance with the error type in a
// type argument (query mode's, never run).
pub fn error_instance(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: TLISTS' words of f's type arguments, by index.
    // SAFETY: f's targs..targs + targ_count are in TLISTS, as the checker made them.
    unsafe {
        for i in 0..pcx.fns[f as usize].targ_count {
            if ty_mentions((*pcx.tlists.data.add((pcx.fns[f as usize].targs + i) as usize)), pcx.ty_error, 0, pcx) {
                return true;
            }
        }
    }
    false
}

// The local effects of function f, its edges pushed.
fn node_locals(f: i64, pcx: &mut Ctx<Comp>) -> Effects {
    unsafe {
        // (0.19: a declaration of std::arch's has its table's effects)
        let intr = intrinsic_of_fn(f, pcx);
        if intr >= 0 && pcx.nodes[pcx.fns[f as usize].node as usize].c == 0 {
            // (a raw:: pointer form, one parameter fewer, is unsafe)
            let raw = pcx.fns[f as usize].param_count < (*pcx.intrs.add(intr as usize)).nparams;
            return Effects { bits: if raw { EFF_UNSAFE } else { intrinsic_effect_bits(intr, pcx) },
                allocs: 0 };
        }
        // (0.21: std's atomic intrinsics synchronize, and their bodies
        // are never compiled; unsafe stays with their callers)
        if atomic_intrinsic(f, pcx) >= 0 {
            return Effects { bits: EFF_SYNC | EFF_UNSAFE, allocs: 0 };
        }
        // (0.21: the lock std's printing holds once threads run is part of
        // its io, as waiting for a pipe is; 0.26.1: its state is an
        // immutable static in a cell, not `global`: printing is `io panic`)
        if is_print_lock(f, pcx) {
            return Effects { bits: EFF_IO | EFF_INTERIOR, allocs: 0 };
        }
        if is_top(f, pcx) {
            // (0.25: static_access, a callee that may do anything)
            if pcx.sa_top != 0 as *mut i64 {
                (*pcx.sa_top.add(f as usize)) = 1;
            }
            return effects_top();
        }
        if pcx.fns[f as usize].is_extern {
            let e = extern_effects(f, pcx);
            if (e.bits & EFF_UNKNOWN) != 0 {
                // (unknown C: its callbacks)
                push_edge(c_unknown_node(pcx), E_CALL, 0, pcx);
                return Effects { bits: e.bits & ~EFF_UNKNOWN, allocs: e.allocs };
            }
            return e;
        }
        pcx.walk_node = f;
        pcx.acc = effects_none();
        if (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 {
            pcx.acc.bits |= EFF_UNSAFE;
        }
        pcx.loops.count = 0;
        walk(pcx.nodes[pcx.fns[f as usize].node as usize].c, pcx);
        if is_cell_root(f, pcx) {
            // (0.26.1: the address UnsafeCell::get gives is written through
            // a shared reference)
            pcx.acc.bits |= EFF_INTERIOR;
        }
        drop_edges(f, pcx);
        pcx.acc
    }
}

// (0.21) Whether f is one of std::fmt's print lock functions
// (print_acquire, print_release and their _held parts; 0.25.5: fmt_guard
// and fmt_unguard, which a Fmt::to_fd takes and gives the lock by, and
// print_threads_started, which takes it for a print a spawn is inside).
fn is_print_lock(f: i64, pcx: &Ctx<Comp>) -> bool {
    if !within_std(pcx.fns[f as usize].module, pcx) {
        return false;
    }
    let text = sym_text(pcx.fns[f as usize].name, pcx);
    text == b"std.fmt.print_acquire" || text == b"std.fmt.print_release"
        || text == b"std.fmt.print_acquire_held" || text == b"std.fmt.print_release_held"
        || text == b"std.fmt.fmt_guard" || text == b"std.fmt.fmt_guard_held"
        || text == b"std.fmt.fmt_unguard" || text == b"std.fmt.fmt_unguard_held"
        || text == b"std.fmt.print_threads_started"
}

// (0.26.1) Whether f is std::cell::UnsafeCell::get (an instance of it):
// the one root of EFF_INTERIOR.
pub fn is_cell_root(f: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: FNS is the checker's raw table of functions (*FnInfo).
    // SAFETY: f and its template are function ids below FN_COUNT.
    unsafe {
        let t = template_of(f, pcx);
        within_std(pcx.fns[t as usize].module, pcx)
            && sym_text(pcx.fns[t as usize].name, pcx) == b"std.cell.UnsafeCell.get"
    }
}

// The virtual node of calls through values of fn type t.
fn dispatch_node(t: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let v = pcx.infer_dispatch.get(t + 1);
    if v != 0 {
        return v - 1;
    }
    let node = pcx.graph_fns + pcx.virtual_type.count;
    pcx.virtual_type.push(t);
    pcx.infer_dispatch.put(t + 1, node + 1);
    node
}

// The virtual node of unknown C.
fn c_unknown_node(pcx: &mut Ctx<Comp>) -> i64 {
    if pcx.c_unknown < 0 {
        pcx.c_unknown = pcx.graph_fns + pcx.virtual_type.count;
        pcx.virtual_type.push(-1);
    }
    pcx.c_unknown
}

// The virtual node of fn type t, or -1 when nothing is called through it.
pub fn dispatch_of(t: i64, pcx: &Ctx<Comp>) -> i64 {
    pcx.infer_dispatch.get(t + 1) - 1
}

fn push_edge(to: i64, kind: i64, add: i64, pcx: &mut Ctx<Comp>) {
    if kind == E_SCOPE {
        pcx.scope_add.put(pcx.edges.count + 1, add);
    }
    pcx.edges.push(to * 4 + kind);
}

// The node edge e goes to, its kind, and what it adds.
fn edge_to(e: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe { (*pcx.edges.data.add(e as usize)) >> 2 }
}

fn edge_through(e: i64, pcx: &mut Ctx<Comp>) -> Effects {
    unsafe {
        let kind = (*pcx.edges.data.add(e as usize)) & 3;
        let add: i64 = if kind == E_SCOPE { pcx.scope_add.get(e + 1) } else { 0 };
        through((*pcx.node_fx.add(((*pcx.edges.data.add(e as usize)) >> 2) as usize)), kind, add, pcx)
    }
}

// (0.27.2.1) Effects fx as seen through edge e (its kind's filter).
fn edge_pass(e: i64, fx: Effects, pcx: &mut Ctx<Comp>) -> Effects {
    // UNSAFE: EDGES' word and SCOPE_ADD, by index.
    // SAFETY: e is an edge of the graph (below EDGES' count).
    unsafe {
        let kind = (*pcx.edges.data.add(e as usize)) & 3;
        let add: i64 = if kind == E_SCOPE { pcx.scope_add.get(e + 1) } else { 0 };
        through(fx, kind, add, pcx)
    }
}

// ---- The walk ----

// What n brings locally: bits and allocators.
fn local(n: i64, bits: i64, allocs: i64, pcx: &mut Ctx<Comp>) {
    let mut b = bits;
    if (b & EFF_PANIC) != 0 {
        b |= EFF_RAW_PANIC;
    }
    if (b & EFF_DIVERGE) != 0 {
        b |= EFF_RAW_DIVERGE;
    }
    if pcx.search {
        if pcx.found_node == 0 && has_effect(Effects { bits: b, allocs: allocs }, pcx.search_bit,
            pcx.search_alloc) {
            pcx.found_node = n;
            pcx.found_callee = -1;
        }
        return;
    }
    pcx.acc.bits |= b;
    pcx.acc.allocs |= allocs;
}

// Call n of graph node `to`, by an edge of kind `kind`.
fn call_edge(n: i64, to: i64, kind: i64, add: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        if pcx.search {
            if pcx.found_node != 0 || to < 0 || to >= pcx.graph_size {
                return;
            }
            let e = through((*pcx.node_fx.add(to as usize)), kind, add, pcx);
            let recursive = pcx.search_bit == EFF_DIVERGE
                && (*pcx.component.add(to as usize)) == (*pcx.component.add(pcx.walk_node as usize));
            if has_effect(e, pcx.search_bit, pcx.search_alloc) || recursive {
                pcx.found_node = n;
                pcx.found_callee = to;
                pcx.found_kind = kind;
            }
            return;
        }
        if pcx.eval {
            // (expr_effects: the callee's effects now; -1: no function of
            // that fn type is reached)
            if to < 0 || to >= pcx.graph_size {
                return;
            }
            let e = through((*pcx.node_fx.add(to as usize)), kind, add, pcx);
            pcx.acc.bits |= e.bits;
            pcx.acc.allocs |= e.allocs;
            return;
        }
        push_edge(to, kind, add, pcx);
    }
}

// (0.26.1) The functions function f's drops call, through their shims:
// the places IR's (places::drop_edge), each as a call by the value it
// drops (0.26.2: the step a why names, `'l' at ... calls 'Loud::drop'`),
// after the body's calls.
fn drop_edges(f: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..crate::places::drop_edge_count(f, pcx) {
        call_edge(crate::places::drop_edge_node(f, i, pcx), crate::places::drop_edge(f, i, pcx),
            E_DROP, 0, pcx);
    }
}

fn walk_list(n: i64, pcx: &mut Ctx<Comp>) {
    for i in 0..pcx.nodes[n as usize].count {
        walk(child(n, i, pcx), pcx);
    }
}

// Walks node n (0: none); a literal or a local brings nothing, and is
// passed over here, without a call (the walk's hottest path).
#[inline]
fn walk(n: i64, pcx: &mut Ctx<Comp>) {
    if n == 0 {
        return;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::Ident && pcx.nodes[n as usize].res == Res::Local || kind == NodeKind::Int
        || kind == NodeKind::CStr || kind == NodeKind::Str || kind == NodeKind::Bool
        || kind == NodeKind::Char {
        return;
    }
    walk_node(n, pcx);
}

fn walk_node(n: i64, pcx: &mut Ctx<Comp>) {
    match { pcx.nodes[n as usize].kind } {
        NodeKind::Ident => walk_ident(n, pcx),
        NodeKind::Assign => {
            // (0.25: its target is changed, static_access)
            pcx.static_write += 1;
            walk(pcx.nodes[n as usize].b, pcx);
            pcx.static_write -= 1;
            walk(pcx.nodes[n as usize].c, pcx);
        }
        NodeKind::Binary | NodeKind::While => {
            if pcx.nodes[n as usize].kind == NodeKind::While && (pcx.nodes[n as usize].p & NODE_IN_BOUNDS) == 0 {
                local(n, EFF_DIVERGE, 0, pcx);
            }
            walk(pcx.nodes[n as usize].b, pcx);
            walk(pcx.nodes[n as usize].c, pcx);
        }
        NodeKind::Unary => {
            if (pcx.nodes[n as usize].p & NODE_RAW) != 0 {
                local(n, EFF_UNSAFE, 0, pcx);
            }
            // (0.25) `&place` exclusive or raw, a receiver too: the
            // place may change (static_access)
            let t = pcx.nodes[n as usize].ty;
            let lends = pcx.nodes[n as usize].op == Tok::Amp && ((pcx.nodes[n as usize].p & NODE_REF_MUT) != 0
                || t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && pcx.types[t as usize].b != REF_SHARED);
            if lends {
                pcx.static_write += 1;
            }
            walk(pcx.nodes[n as usize].b, pcx);
            if lends {
                pcx.static_write -= 1;
            }
        }
        NodeKind::Cast => {
            let operand = pcx.nodes[n as usize].a;
            walk(operand, pcx);
            let from = pcx.nodes[operand as usize].ty;
            if from > 0 && pcx.types[from as usize].kind == TyKind::Prim
                && pcx.types[pcx.nodes[n as usize].ty as usize].kind == TyKind::Ptr
                && !(pcx.nodes[operand as usize].kind == NodeKind::Int && pcx.nodes[operand as usize].a == 0) {
                local(n, EFF_UNSAFE, 0, pcx);
            }
        }
        NodeKind::Call => walk_call(n, pcx),
        NodeKind::MethodCall => {
            walk(pcx.nodes[n as usize].a, pcx);
            walk_list(n, pcx);
        }
        NodeKind::Index => walk_index(n, pcx),
        NodeKind::FieldAccess => {
            if (pcx.nodes[n as usize].p & NODE_RAW) != 0 || reads_union(n, pcx) {
                local(n, EFF_UNSAFE, 0, pcx);
            }
            walk(pcx.nodes[n as usize].a, pcx);
        }
        NodeKind::TupleField | NodeKind::ExprStmt | NodeKind::Return | NodeKind::Defer => {
            walk(pcx.nodes[n as usize].a, pcx);
        }
        NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
            walk_list(n, pcx);
        }
        NodeKind::FieldInit | NodeKind::Break | NodeKind::NamedArg => walk(pcx.nodes[n as usize].b, pcx),
        NodeKind::Repeat | NodeKind::Range => {
            walk(pcx.nodes[n as usize].a, pcx);
            walk(pcx.nodes[n as usize].b, pcx);
        }
        NodeKind::Block => {
            // (its statements' expressions directly: fewer calls)
            for i in 0..pcx.nodes[n as usize].count {
                let s = child(n, i, pcx);
                let k = pcx.nodes[s as usize].kind;
                walk(if k == NodeKind::ExprStmt { pcx.nodes[s as usize].a } else if k == NodeKind::Let {
                    pcx.nodes[s as usize].c
                } else { s }, pcx);
            }
            walk(pcx.nodes[n as usize].a, pcx);
        }
        NodeKind::Let => walk(pcx.nodes[n as usize].c, pcx),
        NodeKind::If => {
            walk(pcx.nodes[n as usize].a, pcx);
            walk(pcx.nodes[n as usize].b, pcx);
            walk(pcx.nodes[n as usize].c, pcx);
        }
        NodeKind::Loop => {
            if (pcx.nodes[n as usize].p & NODE_IN_BOUNDS) == 0 {
                local(n, EFF_DIVERGE, 0, pcx);
            }
            walk(pcx.nodes[n as usize].b, pcx);
        }
        NodeKind::For => walk_for(n, pcx),
        NodeKind::Match => {
            walk(pcx.nodes[n as usize].a, pcx);
            for i in 0..pcx.nodes[n as usize].count {
                let arm = child(n, i, pcx);
                walk(pcx.nodes[arm as usize].b, pcx);
                walk(pcx.nodes[arm as usize].c, pcx);
            }
        }
        NodeKind::EnumPanic => {
            local(n, EFF_PANIC, 0, pcx);
            walk(pcx.nodes[n as usize].a, pcx);
        }
        NodeKind::VecOp => walk_vecop(n, pcx),
        // (0.14: its env, or its function as a value; the body is the
        // closure's function, walked as one)
        NodeKind::Interp if pcx.nodes[n as usize].x > 0 => walk_direct(n, pcx),
        NodeKind::Closure | NodeKind::Try | NodeKind::Interp => walk(pcx.nodes[n as usize].y, pcx),
        _ => {}
    }
}

// (0.17) Call n of std's print, println, eprint, eprintln, format_in or
// Buf::push_fmt with its f-string written in place (an Interp node, x =
// the function + 1; front/check/interp.vl, direct_call): its receiver,
// holes and allocator, then the writes, which a search finds as the call
// (step_text: `'println(f"..")' calls 'std::println'`).
fn walk_direct(n: i64, pcx: &mut Ctx<Comp>) {
    let block = pcx.nodes[n as usize].y;
    for i in 0..pcx.nodes[block as usize].count {
        walk(pcx.nodes[child(block, i, pcx) as usize].c, pcx);
    }
    let found = pcx.found_node;
    walk(pcx.nodes[block as usize].a, pcx);
    if pcx.search && found == 0 && pcx.found_node != 0 {
        pcx.found_node = n;
    }
}

fn walk_ident(n: i64, pcx: &mut Ctx<Comp>) {
    let res = pcx.nodes[n as usize].res;
    if res == Res::Static {
        let s = pcx.nodes[n as usize].y;
        if is_thread_local(s, pcx) {
            local(n, EFF_TLS, 0, pcx);
        } else if s >= 0 && (pcx.statics[s as usize].mutable || pcx.statics[s as usize].linkage != 0) {
            // RULE: F19.6 (a rust-edition use of a `static mut` is unsafe, the
            // program's to vouch for: `global`, not the shared-static rule's
            // raw_global, as rustc lets a thread reach it)
            let vouched = guarded_static(s, pcx) || pcx.edition != 0
                && crate::front::rust::rust_at(pcx.nodes[n as usize].start, pcx);
            local(n, EFF_GLOBAL | (if vouched { 0 } else { EFF_RAW_GLOBAL }), 0, pcx);
            if !pcx.search {
                // (0.25: static_access)
                pcx.static_uses.push(s);
                pcx.static_uses.push(if pcx.static_write > 0 { 2 } else { 1 });
            }
        }
        return;
    }
    if res != Res::Fn {
        return;
    }
    let f = pcx.nodes[n as usize].y;
    if f < 0 {
        return;
    }
    if !pcx.search && !pcx.eval {
        let t = crate::front::types::fn_ty_safe(pcx.nodes[n as usize].ty, pcx);
        pcx.address_taken.push(t);
        pcx.address_taken.push(f);
    }
    if (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 {
        local(n, EFF_UNSAFE, 0, pcx);
    }
}

// (0.21) Whether static s is one of std's statics a lock guards once
// threads run (std::thread's thread-local keys): global, not
// EFF_RAW_GLOBAL. (0.26.1: std::fmt's print state is an immutable static,
// PRINTING, with no effect.)
fn guarded_static(s: i64, pcx: &Ctx<Comp>) -> bool {
    let t = sym_text(pcx.nodes[pcx.statics[s as usize].node as usize].a, pcx);
    t.len() > 11 && t[0..11] == b"std.thread."
}

// Whether field access n reads a field of a union (not an assignment's
// target, not `&u.f`).
fn reads_union(n: i64, pcx: &Ctx<Comp>) -> bool {
    let mut t = pcx.nodes[pcx.nodes[n as usize].a as usize].ty;
    if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr {
        t = pcx.types[t as usize].a;
    }
    t > 0 && pcx.types[t as usize].kind == TyKind::Struct
        && (pcx.structs[pcx.types[t as usize].a as usize].repr & REPR_UNION) != 0
        && (pcx.nodes[n as usize].p & NODE_NO_READ) == 0
}

fn walk_call(n: i64, pcx: &mut Ctx<Comp>) {
    let f = pcx.nodes[n as usize].x - 1;
    if f >= 0 {
        walk_list(n, pcx);
        if f == pcx.check_fn {
            // (an assertion or a clause, lowered in place as a branch
            // to the failure: it may panic unless its condition is
            // true as written, and its body is not called)
            if !proven_true(child(n, 0, pcx), pcx) {
                local(n, EFF_PANIC, 0, pcx);
            }
            return;
        }
        let info = callee_info(f, pcx);
        if (info & CALL_UNSAFE) != 0
            || (info >> BORROW_SHIFT) != 0 && raw_to_borrow(n, f, info, pcx) {
            local(n, EFF_UNSAFE, 0, pcx);
        }
        let kind = (info & 7) - 1;
        if kind == E_ALLOC && pcx.fns[f as usize].self_ty != 0 && allocates(f, pcx) {
            local(n, 0, allocator_bit(pcx.fns[f as usize].self_ty, pcx), pcx);
        }
        call_edge(n, f, kind,
            if kind == E_SCOPE { allocator_bit(scope_parent(f, pcx), pcx) } else { 0 }, pcx);
        return;
    }
    let callee = pcx.nodes[n as usize].a;
    walk(callee, pcx);
    walk_list(n, pcx);
    let t = crate::front::types::fn_ty_safe(pcx.nodes[callee as usize].ty, pcx);
    if t <= 0 || pcx.types[t as usize].kind != TyKind::Fn {
        return;
    }
    if crate::front::types::fn_ty_c(t, pcx) {
        // (an `extern "C" fn` value: C, unknown)
        local(n, EFF_UNSAFE, 0, pcx);
        // RULE: F19.6 (C's global state, not thread-safe, but where the rust
        // edition calls it, in `unsafe`)
        if !(pcx.edition != 0 && crate::front::rust::rust_at(pcx.nodes[n as usize].start, pcx)) {
            local(n, EFF_RAW_GLOBAL, 0, pcx);
        }
        if pcx.eval && pcx.c_unknown < 0 {
            local(n, unknown_c_effects().bits, 0, pcx);
        } else if pcx.search || pcx.eval {
            call_edge(n, pcx.c_unknown, E_CALL, 0, pcx);
        } else {
            call_edge(n, c_unknown_node(pcx), E_CALL, 0, pcx);
        }
        return;
    }
    if pcx.search || pcx.eval {
        call_edge(n, dispatch_of(t, pcx), E_CALL, 0, pcx);
    } else {
        call_edge(n, dispatch_node(t, pcx), E_CALL, 0, pcx);
    }
}

// (0.25) Whether condition n is true as written: `true`, or `!`, `&&` and
// `||` of such, or a comparison of integer literals (an assertion that
// cannot fail does not panic).
pub fn proven_true(n: i64, pcx: &Ctx<Comp>) -> bool {
    const_bool(n, 0, pcx) == 1
}

// The value of condition n as written: 1 true, 0 false, -1 not known.
fn const_bool(n: i64, depth: i64, pcx: &Ctx<Comp>) -> i64 {
    if n <= 0 || depth > 16 {
        return -1;
    }
    let kind = pcx.nodes[n as usize].kind;
    if kind == NodeKind::Bool {
        return if pcx.nodes[n as usize].a != 0 { 1 } else { 0 };
    }
    if kind == NodeKind::Unary && pcx.nodes[n as usize].op == Tok::Bang {
        let v = const_bool(pcx.nodes[n as usize].b, depth + 1, pcx);
        return if v < 0 { -1 } else { 1 - v };
    }
    if kind != NodeKind::Binary {
        return -1;
    }
    let op = pcx.nodes[n as usize].op;
    let l = pcx.nodes[n as usize].b;
    let r = pcx.nodes[n as usize].c;
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        let a = const_bool(l, depth + 1, pcx);
        let b = const_bool(r, depth + 1, pcx);
        if op == Tok::AmpAmp {
            return if a == 0 || b == 0 { 0 } else if a == 1 && b == 1 { 1 } else { -1 };
        }
        return if a == 1 || b == 1 { 1 } else if a == 0 && b == 0 { 0 } else { -1 };
    }
    if pcx.nodes[l as usize].kind != NodeKind::Int || pcx.nodes[r as usize].kind != NodeKind::Int {
        return -1;
    }
    let x = pcx.nodes[l as usize].a;
    let y = pcx.nodes[r as usize].a;
    let mut t = false;
    if op == Tok::EqEq {
        t = x == y;
    } else if op == Tok::BangEq {
        t = x != y;
    } else if op == Tok::Lt {
        t = x < y;
    } else if op == Tok::LtEq {
        t = x <= y;
    } else if op == Tok::Gt {
        t = x > y;
    } else if op == Tok::GtEq {
        t = x >= y;
    } else {
        return -1;
    }
    if t { 1 } else { 0 }
}

// Whether direct call n of f (its callee_info `info`) passes a raw pointer
// to a borrowed parameter (unsafe; a method called through a raw pointer
// is one).
fn raw_to_borrow(n: i64, f: i64, info: i64, pcx: &Ctx<Comp>) -> bool {
    let item = pcx.fns[f as usize].node;
    let count = if pcx.nodes[n as usize].count < pcx.nodes[item as usize].count { pcx.nodes[n as usize].count }
        else { pcx.nodes[item as usize].count };
    let mask = info >> BORROW_SHIFT;
    for i in 0..count {
        let borrowed = if i < BORROW_PARAMS { ((mask >> i) & 1) != 0 }
            else { is_borrow_param(child(item, i, pcx), pcx) };
        if !borrowed {
            continue;
        }
        let arg = child(n, i, pcx);
        let t = pcx.nodes[arg as usize].ty;
        if t > 0 && pcx.types[t as usize].kind == TyKind::Ptr && !is_borrow(arg, pcx) {
            return true;
        }
    }
    false
}

// What a call of function f is, computed at its first call: its edge kind
// + 1 (the low 3 bits), CALL_UNSAFE (C, or an `unsafe fn`), and from
// BORROW_SHIFT on the mask of its borrowed parameters (the first
// BORROW_PARAMS; past them all are, to look at).
fn callee_info(f: i64, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let known = (*pcx.callee_info.add(f as usize));
        if known != 0 {
            return known;
        }
        let kind = if is_allocator_method(f, pcx) || is_arena_internal(f, pcx) { E_ALLOC }
            else if scope_parent(f, pcx) != 0 { E_SCOPE } else { E_CALL };
        let mut info = kind + 1;
        if pcx.fns[f as usize].is_extern || (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 {
            info |= CALL_UNSAFE;
        }
        if !pcx.fns[f as usize].is_extern {
            let item = pcx.fns[f as usize].node;
            for i in 0..pcx.nodes[item as usize].count {
                if i >= BORROW_PARAMS || is_borrow_param(child(item, i, pcx), pcx) {
                    info |= 1 << (BORROW_SHIFT + if i < BORROW_PARAMS { i } else { BORROW_PARAMS });
                }
                if i >= BORROW_PARAMS {
                    break;
                }
            }
        }
        (*pcx.callee_info.add(f as usize)) = info;
        info
    }
}

fn walk_index(n: i64, pcx: &mut Ctx<Comp>) {
    let base = pcx.nodes[n as usize].a;
    let index = pcx.nodes[n as usize].b;
    walk(base, pcx);
    let bt = pcx.nodes[base as usize].ty;
    let raw = bt > 0 && pcx.types[bt as usize].kind == TyKind::Ptr;
    if pcx.nodes[index as usize].kind == NodeKind::Range {
        walk(pcx.nodes[index as usize].a, pcx);
        walk(pcx.nodes[index as usize].b, pcx);
        if raw {
            local(n, EFF_UNSAFE, 0, pcx);
        } else if pcx.nodes[index as usize].a == 0 && pcx.nodes[index as usize].b == 0 {
            // (`s[..]`: the whole)
            pcx.nodes[n as usize].p |= NODE_IN_BOUNDS;
        } else if (pcx.nodes[n as usize].p & NODE_IN_BOUNDS) == 0 {
            local(n, EFF_PANIC, 0, pcx);
        }
        return;
    }
    walk(index, pcx);
    if raw {
        local(n, EFF_UNSAFE, 0, pcx);
        return;
    }
    if (pcx.nodes[n as usize].p & NODE_IN_BOUNDS) != 0 || in_bounds(base, bt, index, pcx) {
        pcx.nodes[n as usize].p |= NODE_IN_BOUNDS;
        return;
    }
    local(n, EFF_PANIC, 0, pcx);
}

// Whether `base[index]` (base of type bt, a slice or an array) is in
// bounds by the syntax: a constant index below an array's length, or the
// variable of a counted loop `for i in 0..s.len` with `s` the same
// immutable slice binding, or `for i in 0..N` with N at most the array's
// length (which is how the `for` desugarings index).
fn in_bounds(base: i64, bt: i64, index: i64, pcx: &Ctx<Comp>) -> bool {
    unsafe {
        let array = bt > 0 && pcx.types[bt as usize].kind == TyKind::Array;
        if pcx.nodes[index as usize].kind == NodeKind::Int {
            return array && pcx.nodes[index as usize].a >= 0 && pcx.nodes[index as usize].a < pcx.types[bt as usize].b;
        }
        if pcx.nodes[index as usize].kind != NodeKind::Ident || pcx.nodes[index as usize].res != Res::Local {
            return false;
        }
        let i = pcx.nodes[index as usize].y;
        let mut k = pcx.loops.count - 3;
        while k >= 0 {
            if (*pcx.loops.data.add(k as usize)) == i {
                let kind = (*pcx.loops.data.add((k + 1) as usize));
                let what = (*pcx.loops.data.add((k + 2) as usize));
                if kind == LOOP_SLICE {
                    return pcx.nodes[base as usize].kind == NodeKind::Ident
                        && pcx.nodes[base as usize].res == Res::Local && pcx.nodes[base as usize].y == what;
                }
                return array && what <= pcx.types[bt as usize].b;
            }
            k -= 3;
        }
        false
    }
}

// `for p in a..b body` (counted): a in-bounds context for the body when
// it is `for i in 0..s.len` or `for i in 0..N`.
fn walk_for(n: i64, pcx: &mut Ctx<Comp>) {
    let range = pcx.nodes[n as usize].c;
    if pcx.nodes[range as usize].kind != NodeKind::Range {
        walk(range, pcx);
        walk(pcx.nodes[n as usize].d, pcx);
        return;
    }
    walk(pcx.nodes[range as usize].a, pcx);
    walk(pcx.nodes[range as usize].b, pcx);
    let mark = pcx.loops.count;
    let pattern = pcx.nodes[n as usize].b;
    let low = pcx.nodes[range as usize].a;
    let high = pcx.nodes[range as usize].b;
    if pcx.nodes[pattern as usize].kind == NodeKind::PatBind && pcx.nodes[pattern as usize].b == 0
        && pcx.nodes[pattern as usize].x >= 0 && low != 0 && pcx.nodes[low as usize].kind == NodeKind::Int
        && pcx.nodes[low as usize].a >= 0 && high != 0 {
        let inclusive = pcx.nodes[range as usize].c != 0;
        if pcx.nodes[high as usize].kind == NodeKind::Int {
            pcx.loops.push(pcx.nodes[pattern as usize].x);
            pcx.loops.push(LOOP_LENGTH);
            pcx.loops.push(pcx.nodes[high as usize].a + inclusive as i64);
        } else if !inclusive && pcx.nodes[high as usize].kind == NodeKind::FieldAccess
            && pcx.nodes[high as usize].b == pcx.len_sym {
            let s = pcx.nodes[high as usize].a;
            if pcx.nodes[s as usize].kind == NodeKind::Ident && pcx.nodes[s as usize].res == Res::Local
                && pcx.nodes[s as usize].y >= 0
                && !pcx.locals[pcx.nodes[s as usize].y as usize].mutable {
                let st = pcx.nodes[s as usize].ty;
                if st > 0 && pcx.types[st as usize].kind == TyKind::Slice {
                    pcx.loops.push(pcx.nodes[pattern as usize].x);
                    pcx.loops.push(LOOP_SLICE);
                    pcx.loops.push(pcx.nodes[s as usize].y);
                }
            }
        }
    }
    walk(pcx.nodes[n as usize].d, pcx);
    pcx.loops.count = mark;
}

fn walk_vecop(n: i64, pcx: &mut Ctx<Comp>) {
    let kind = pcx.nodes[n as usize].x;
    if kind == VK_LOAD || kind == VK_STORE {
        local(n, EFF_PANIC, 0, pcx);
    } else if kind == VK_LANE || kind == VK_WITH {
        let lane = child(n, 0, pcx);
        if !(pcx.nodes[lane as usize].kind == NodeKind::Int && pcx.nodes[lane as usize].a >= 0
            && pcx.nodes[lane as usize].a < vec_lanes(pcx.nodes[n as usize].y, pcx)) {
            local(n, EFF_PANIC, 0, pcx);
        }
    }
    walk(pcx.nodes[n as usize].a, pcx);
    walk_list(n, pcx);
}

// ---- Components ----

// Tarjan's algorithm, iterative, over the graph; each component's effects
// as it completes (its callees' are known then).
fn components(pcx: &mut Ctx<Comp>) {
    unsafe {
        let size = pcx.graph_size;
        pcx.node_fx = alloc_array::<Effects>(size + 1);
        // (0.27.2.1, E3.3a: a rust program's sets split by where they come from)
        if crate::front::known::on_std2(pcx) && !pcx.search && !pcx.eval {
            pcx.fx_fixed = alloc_array::<Effects>(size + 1);
            pcx.fx_dyn = alloc_array::<Effects>(size + 1);
        } else {
            pcx.fx_fixed = 0 as *mut Effects;
            pcx.fx_dyn = 0 as *mut Effects;
        }
        pcx.component = alloc_array::<i64>(size + 1);
        let index = alloc_array::<i64>(size + 1);
        let low = alloc_array::<i64>(size + 1);
        let on_stack = alloc_array::<i64>(size + 1);
        pcx.stack.count = 0;
        let mut calls = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut counter: i64 = 0;
        let mut comp: i64 = 0;
        for root in 0..size {
            if (*index.add(root as usize)) != 0 {
                continue;
            }
            counter += 1;
            (*index.add(root as usize)) = counter;
            (*low.add(root as usize)) = counter;
            pcx.stack.push(root);
            (*on_stack.add(root as usize)) = 1;
            calls.push(root);
            calls.push((*pcx.edge_start.data.add(root as usize)));
            while calls.count > 0 {
                let v = (*calls.data.add((calls.count - 2) as usize));
                let e = (*calls.data.add((calls.count - 1) as usize));
                if e < (*pcx.edge_start.data.add((v + 1) as usize)) {
                    (*calls.data.add((calls.count - 1) as usize)) = e + 1;
                    let w = edge_to(e, pcx);
                    if (*index.add(w as usize)) == 0 {
                        counter += 1;
                        (*index.add(w as usize)) = counter;
                        (*low.add(w as usize)) = counter;
                        pcx.stack.push(w);
                        (*on_stack.add(w as usize)) = 1;
                        calls.push(w);
                        calls.push((*pcx.edge_start.data.add(w as usize)));
                    } else if (*on_stack.add(w as usize)) != 0 && (*index.add(w as usize)) < (*low.add(v as usize)) {
                        (*low.add(v as usize)) = (*index.add(w as usize));
                    }
                    continue;
                }
                calls.count -= 2;
                if calls.count > 0 {
                    let p = (*calls.data.add((calls.count - 2) as usize));
                    if (*low.add(v as usize)) < (*low.add(p as usize)) {
                        (*low.add(p as usize)) = (*low.add(v as usize));
                    }
                }
                if (*low.add(v as usize)) == (*index.add(v as usize)) {
                    let mut first = pcx.stack.count - 1;
                    while (*pcx.stack.data.add(first as usize)) != v {
                        first -= 1;
                    }
                    comp += 1;
                    for k in first..pcx.stack.count {
                        (*on_stack.add((*pcx.stack.data.add(k as usize)) as usize)) = 0;
                        (*pcx.component.add((*pcx.stack.data.add(k as usize)) as usize)) = comp;
                    }
                    component_effects(first, comp, pcx);
                    pcx.stack.count = first;
                }
            }
        }
    }
}

// The local effects of graph node v.
fn local_of(v: i64, pcx: &Ctx<Comp>) -> Effects {
    unsafe {
        if v < pcx.graph_fns {
            return (*pcx.local_fx.add(v as usize));
        }
        // (0.27.4: but the shared-static rule's raw_global, which each call of
        // unknown C adds where it is made, the rust edition's exempt: F19.6)
        if v == pcx.c_unknown {
            let e = unknown_c_effects();
            Effects { bits: e.bits & ~EFF_RAW_GLOBAL, allocs: e.allocs }
        } else { effects_none() }
    }
}

// The effects of component number comp, the nodes of STACK from first
// on. (0.27.2.1, E3.3a: in a rust program also each member's part that
// comes from a fn value's call, FX_DYN, and the rest, FX_FIXED.)
fn component_effects(first: i64, comp: i64, pcx: &mut Ctx<Comp>) {
    unsafe {
        let mut acc = effects_none();
        let track = pcx.fx_fixed != 0 as *mut Effects;
        let mut fixed = effects_none();
        let mut dynamic = effects_none();
        let mut cyclic = pcx.stack.count - first > 1;
        for k in first..pcx.stack.count {
            let m = (*pcx.stack.data.add(k as usize));
            let own = local_of(m, pcx);
            acc.bits |= own.bits & ~EFF_UNSAFE;
            acc.allocs |= own.allocs;
            fixed.bits |= own.bits & ~EFF_UNSAFE;
            fixed.allocs |= own.allocs;
            for e in (*pcx.edge_start.data.add(m as usize))..(*pcx.edge_start.data.add((m + 1) as usize)) {
                let w = edge_to(e, pcx);
                if (*pcx.component.add(w as usize)) == comp {
                    cyclic = true;
                    continue;
                }
                let t = edge_through(e, pcx);
                acc.bits |= t.bits;
                acc.allocs |= t.allocs;
                if track {
                    if dispatch_edge(w, pcx) {
                        dynamic = effects_union(dynamic, t);
                    } else {
                        fixed = effects_union(fixed, edge_pass(e, (*pcx.fx_fixed.add(w as usize)), pcx));
                        dynamic = effects_union(dynamic, edge_pass(e, (*pcx.fx_dyn.add(w as usize)), pcx));
                    }
                }
            }
        }
        if cyclic {
            acc.bits |= EFF_DIVERGE | EFF_RAW_DIVERGE;
            fixed.bits |= EFF_DIVERGE | EFF_RAW_DIVERGE;
        }
        for k in first..pcx.stack.count {
            let m = (*pcx.stack.data.add(k as usize));
            (*pcx.node_fx.add(m as usize)) = Effects { bits: acc.bits | (local_of(m, pcx).bits & EFF_UNSAFE),
                allocs: acc.allocs };
            if track {
                // (the members' locals and the cycle are the fixed part)
                (*pcx.fx_dyn.add(m as usize)) = dynamic;
                (*pcx.fx_fixed.add(m as usize)) = fixed;
            }
        }
        if track && cyclic {
            split_cycle(first, pcx);
        }
        // (0.27.2.1, E3.1a: a declared member gets its signature, after
        // every member has the component's set)
        if pcx.fx_decl != 0 as *mut i64 {
            // (in the unsafe block above: STACK and FX_DECL by index)
            for k in first..pcx.stack.count {
                let m = (*pcx.stack.data.add(k as usize));
                if m < pcx.graph_fns && (*pcx.fx_decl.add(m as usize)) != 0 {
                    signature_of(m, pcx);
                }
            }
        }
    }
}

// (0.27.2.1, E3.3a) A cyclic component's split per member, to a fixed
// point: a member's fixed part is its locals, the cycle's diverge and its
// edges' fixed parts; its fn values' calls (a virtual node, in the cycle
// or not, with all it reaches) and its edges' dynamic parts are dynamic.
// (A cycle through a fn value, Formatter's writer and an adapter's
// write_str, keeps what one writer does out of the others' fixed part.)
fn split_cycle(first: i64, pcx: &mut Ctx<Comp>) {
    // UNSAFE: STACK, NODE_FX, FX_FIXED, FX_DYN and the edges, by index.
    // SAFETY: the members are STACK[first..], graph nodes; the tables have
    // a word per graph node (components made them).
    unsafe {
        for k in first..pcx.stack.count {
            let m = (*pcx.stack.data.add(k as usize));
            let own = local_of(m, pcx);
            (*pcx.fx_fixed.add(m as usize)) = Effects { bits: (own.bits & ~EFF_UNSAFE) | EFF_DIVERGE
                | EFF_RAW_DIVERGE, allocs: own.allocs };
            (*pcx.fx_dyn.add(m as usize)) = effects_none();
        }
        let mut changed = true;
        let mut rounds: i64 = 0;
        while changed && rounds < 64 {
            changed = false;
            rounds += 1;
            for k in first..pcx.stack.count {
                let m = (*pcx.stack.data.add(k as usize));
                let mut fixed = (*pcx.fx_fixed.add(m as usize));
                let mut dynamic = (*pcx.fx_dyn.add(m as usize));
                for e in (*pcx.edge_start.data.add(m as usize))..(*pcx.edge_start.data.add((m + 1) as usize)) {
                    let w = edge_to(e, pcx);
                    if dispatch_edge(w, pcx) {
                        dynamic = effects_union(dynamic, edge_through(e, pcx));
                    } else {
                        fixed = effects_union(fixed, edge_pass(e, (*pcx.fx_fixed.add(w as usize)), pcx));
                        dynamic = effects_union(dynamic, edge_pass(e, (*pcx.fx_dyn.add(w as usize)), pcx));
                    }
                }
                if fixed.bits != (*pcx.fx_fixed.add(m as usize)).bits || fixed.allocs != (*pcx.fx_fixed.add(m as usize)).allocs
                    || dynamic.bits != (*pcx.fx_dyn.add(m as usize)).bits
                    || dynamic.allocs != (*pcx.fx_dyn.add(m as usize)).allocs {
                    changed = true;
                    (*pcx.fx_fixed.add(m as usize)) = fixed;
                    (*pcx.fx_dyn.add(m as usize)) = dynamic;
                }
            }
        }
    }
}

// (0.27.2.1) Declared function m's set, its component's just made, becomes
// its signature S(m): D(m)'s visible bits and allocators (its list; what
// its edges made for a listed type parameter bring, the allocators its
// body names through a listed parameter's type, and every part that comes
// from a fn value's call, E3.3a), I(m)'s hidden bits and unsafe (the
// optimizer's); I(m) is kept for check_effects. RULE: E3.1a
fn signature_of(m: i64, pcx: &mut Ctx<Comp>) {
    // UNSAFE: NODE_FX, the declaration tables and the effect graph's, by index.
    // SAFETY: m < GRAPH_FNS, a declared function (FX_DECL[m] != 0), so
    // FX_DECL_TPS holds its count and types at FX_DECL[m] - 1; FX_FIXED and
    // FX_DYN, when made, have a word per graph node.
    unsafe {
        let i = (*pcx.node_fx.add(m as usize));
        (*pcx.fx_inferred.add(m as usize)) = i;
        if (i.bits & EFF_UNKNOWN) != 0 {
            return;
        }
        let at = (*pcx.fx_decl.add(m as usize)) - 1;
        let track = pcx.fx_fixed != 0 as *mut Effects;
        let mut pf = effects_none();
        let mut pd = effects_none();
        for e in (*pcx.edge_start.data.add(m as usize))..(*pcx.edge_start.data.add((m + 1) as usize)) {
            let w = edge_to(e, pcx);
            let dropped = ((*pcx.edges.data.add(e as usize)) & 3) == E_DROP && (*pcx.fx_decl_tps.data.add(at as usize)) > 0;
            if dispatch_edge(w, pcx) {
                pd = effects_union(pd, edge_through(e, pcx));
            } else if dropped || made_for(w, at, pcx) {
                if track {
                    pf = effects_union(pf, edge_pass(e, (*pcx.fx_fixed.add(w as usize)), pcx));
                    pd = effects_union(pd, edge_pass(e, (*pcx.fx_dyn.add(w as usize)), pcx));
                } else {
                    pf = effects_union(pf, edge_through(e, pcx));
                }
            } else if track {
                pd = effects_union(pd, edge_pass(e, (*pcx.fx_dyn.add(w as usize)), pcx));
            }
        }
        for j in 0..(*pcx.fx_decl_tps.data.add(at as usize)) {
            pf.allocs |= allocs_through((*pcx.local_fx.add(m as usize)).allocs, (*pcx.fx_decl_tps.data.add((at + 1 + j) as usize)),
                pcx);
        }
        (*pcx.fx_decl_px.add(m as usize)) = effects_union(pf, pd);
        let d = (*pcx.fx_decl_e.add(m as usize));
        let hidden = EFF_RAW_PANIC | EFF_RAW_DIVERGE | EFF_RAW_GLOBAL | EFF_INTERIOR | EFF_UNSAFE;
        if track {
            (*pcx.fx_fixed.add(m as usize)) = effects_union(d, pf);
            (*pcx.fx_dyn.add(m as usize)) = pd;
        }
        (*pcx.node_fx.add(m as usize)) = Effects {
            bits: ((d.bits | pf.bits | pd.bits) & crate::front::effects::EFF_VISIBLE & ~EFF_UNSAFE)
                | (i.bits & hidden),
            allocs: d.allocs | pf.allocs | pd.allocs,
        };
    }
}

// (0.27.2.1, E3.3a) Whether graph node w is a fn type's virtual node (not
// unknown C's): what a call through a fn value reaches is the program's
// (closed world, E4.3), as a type argument's instance is, so it passes
// through a declaration.
fn dispatch_edge(w: i64, pcx: &Ctx<Comp>) -> bool {
    w >= pcx.graph_fns && w != pcx.c_unknown
}

// (0.27.2.1, E3.3a) The allocators of `allocs` that type tau mentions (or
// that mention it: `&A` for A): what a body frees or allocates through a
// type argument's parts (a drop of a T = Vec<_, Gpa> frees through Gpa).
fn allocs_through(allocs: i64, tau: i64, pcx: &Ctx<Comp>) -> i64 {
    let mut got: i64 = 0;
    // UNSAFE: ALLOCATORS' words, by index.
    // SAFETY: i < its count.
    unsafe {
        for i in 0..pcx.allocators.count {
            let t = (*pcx.allocators.data.add(i as usize));
            if i < 63 && (allocs & (1 << i)) != 0
                && (ty_mentions(tau, t, 0, pcx) || ty_mentions(t, tau, 0, pcx)) {
                got |= 1 << i;
            }
        }
    }
    got
}

// (0.27.2.1) Whether graph node w is made for a parametric item's type of
// the declaration at FX_DECL_TPS[at] (E3.3a): its self type or a type
// argument mentions it, it is the body of a closure whose type does, or a
// fn type's virtual node whose type does. RULE: E3.3a
fn made_for(w: i64, at: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: FX_DECL_TPS' words, by index.
    // SAFETY: at is a declaration's start in it: its count, then that many
    // types (note_declarations).
    unsafe {
        for j in 0..(*pcx.fx_decl_tps.data.add(at as usize)) {
            if node_made_for(w, (*pcx.fx_decl_tps.data.add((at + 1 + j) as usize)), pcx) {
                return true;
            }
        }
    }
    false
}

// (0.27.2.1, E3.6) What instance (or item) f does itself and through its
// callees not made for one of its type arguments (E3.3a): its local set
// (but the allocators it names through a type argument's parts) and the
// fixed part (FX_FIXED: not from a fn value's call) of what its edges to
// the others bring (diverge when one is in its component), then a word
// with bit j set when an edge is made for type argument j or the body
// names an allocator through it (at most 63). For `fix --only effects`,
// after infer_effects.
pub fn own_effects(f: i64, pcx: &mut Ctx<Comp>) -> (Effects, i64) {
    // UNSAFE: the effect graph's tables (EDGE_START, EDGES, COMPONENT,
    // LOCAL_FX, FX_FIXED) and TLISTS, by index.
    // SAFETY: f is below GRAPH_FNS, so EDGE_START has f + 1; its edges' targets
    // are graph nodes; f's targs..targs + targ_count are in TLISTS.
    unsafe {
        let mut local = (*pcx.local_fx.add(f as usize));
        let mut fx = effects_none();
        let mut params: i64 = 0;
        let track = pcx.fx_fixed != 0 as *mut Effects;
        let count: i64 = if pcx.fns[f as usize].targ_count < 63 { pcx.fns[f as usize].targ_count } else { 63 };
        for e in (*pcx.edge_start.data.add(f as usize))..(*pcx.edge_start.data.add((f + 1) as usize)) {
            let w = edge_to(e, pcx);
            if dispatch_edge(w, pcx) {
                continue;
            }
            let mut mask: i64 = 0;
            for j in 0..count {
                if ((*pcx.edges.data.add(e as usize)) & 3) == E_DROP
                    || node_made_for(w, (*pcx.tlists.data.add((pcx.fns[f as usize].targs + j) as usize)), pcx) {
                    mask |= 1 << j;
                }
            }
            if mask != 0 {
                params |= mask;
                continue;
            }
            if (*pcx.component.add(w as usize)) == (*pcx.component.add(f as usize)) {
                fx.bits |= EFF_DIVERGE | EFF_RAW_DIVERGE;
            }
            let t = if track { edge_pass(e, (*pcx.fx_fixed.add(w as usize)), pcx) } else { edge_through(e, pcx) };
            fx = effects_union(fx, t);
        }
        for j in 0..count {
            let tau = (*pcx.tlists.data.add((pcx.fns[f as usize].targs + j) as usize));
            // (an allocator that is the argument itself stays: alloc(P))
            let mut parts = allocs_through(local.allocs, tau, pcx);
            for i in 0..pcx.allocators.count {
                if i < 63 && (*pcx.allocators.data.add(i as usize)) == tau {
                    parts &= ~(1 << i);
                }
            }
            if parts != 0 {
                params |= 1 << j;
                local.allocs &= ~parts;
            }
        }
        fx.bits |= local.bits;
        fx.allocs |= local.allocs;
        (fx, params)
    }
}

// (0.27.2.1) Whether graph node w is made for type tau (E3.3a).
fn node_made_for(w: i64, tau: i64, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: VIRTUAL_TYPE and TLISTS' words, by index.
    // SAFETY: w is a graph node: a function below GRAPH_FNS, else a virtual
    // node of VIRTUAL_TYPE (checked); a function's targs are in TLISTS.
    unsafe {
        if w >= pcx.graph_fns {
            let k = w - pcx.graph_fns;
            return k < pcx.virtual_type.count && ty_mentions((*pcx.virtual_type.data.add(k as usize)), tau, 0, pcx);
        }
        if ty_mentions(pcx.fns[w as usize].self_ty, tau, 0, pcx) {
            return true;
        }
        for a in 0..pcx.fns[w as usize].targ_count {
            if ty_mentions((*pcx.tlists.data.add((pcx.fns[w as usize].targs + a) as usize)), tau, 0, pcx) {
                return true;
            }
        }
        for c in 0..pcx.closures.len() as i64 {
            // (either way: F bound to `&mut C` calls C's body)
            if pcx.closures[c as usize].f == w && (ty_mentions(pcx.closures[c as usize].ty, tau, 0, pcx)
                || ty_mentions(tau, pcx.closures[c as usize].ty, 0, pcx)) {
                return true;
            }
        }
        false
    }
}

// (0.27.2.1) Whether type t is tau or has it as a part: a pointer's or a
// reference's, an array's, a slice's or a tuple's element, a fn type's
// parameter, a struct's or an enum's type argument (E3.3a's mention).
pub fn ty_mentions(t: i64, tau: i64, depth: i64, pcx: &Ctx<Comp>) -> bool {
    if t <= 0 || depth > 8 {
        return false;
    }
    if t == tau {
        return true;
    }
    let k = pcx.types[t as usize].kind;
    if k == TyKind::Ptr || k == TyKind::Array || k == TyKind::Slice || k == TyKind::Vector {
        return ty_mentions(pcx.types[t as usize].a, tau, depth + 1, pcx);
    }
    // UNSAFE: TLISTS' words and ENUMS, the checker's tables, by index.
    // SAFETY: t is an interned type; its list, its struct's and its enum's
    // type arguments are in TLISTS, as the checker made them.
    unsafe {
        if k == TyKind::Tuple || k == TyKind::Fn {
            for i in 0..pcx.types[t as usize].count {
                if ty_mentions((*pcx.tlists.data.add((pcx.types[t as usize].list + i) as usize)), tau, depth + 1, pcx) {
                    return true;
                }
            }
            return false;
        }
        let mut targs: i64 = 0;
        let mut count: i64 = 0;
        if k == TyKind::Struct {
            targs = pcx.structs[pcx.types[t as usize].a as usize].targs;
            count = pcx.structs[pcx.types[t as usize].a as usize].targ_count;
        } else if k == TyKind::Enum {
            targs = (*crate::front::types::get_enums().add(pcx.types[t as usize].a as usize)).targs;
            count = (*crate::front::types::get_enums().add(pcx.types[t as usize].a as usize)).targ_count;
        }
        for i in 0..count {
            if ty_mentions((*pcx.tlists.data.add((targs + i) as usize)), tau, depth + 1, pcx) {
                return true;
            }
        }
    }
    false
}

// ---- Search (why.vl) ----

// The first call or local source in function f's body that brings the
// effect (bit, alloc) (has_effect's): FOUND_NODE (0: none), FOUND_CALLEE
// (the graph node called, -1 for a local source) and FOUND_KIND.
pub fn find_step(f: i64, bit: i64, alloc: i64, pcx: &mut Ctx<Comp>) {
    pcx.found_node = 0;
    pcx.found_callee = -1;
    pcx.found_kind = 0;
    if f < 0 || f >= pcx.graph_fns || pcx.node_fx == 0 as *mut Effects || !body_walked(f, pcx) {
        return;
    }
    pcx.search = true;
    pcx.search_bit = bit;
    pcx.search_alloc = alloc;
    pcx.walk_node = f;
    pcx.loops.count = 0;
    if bit == EFF_UNSAFE && (pcx.fns[f as usize].attrs & FN_UNSAFE) != 0 {
        pcx.found_node = pcx.fns[f as usize].node;
    }
    walk(pcx.nodes[pcx.fns[f as usize].node as usize].c, pcx);
    drop_edges(f, pcx);
    pcx.search = false;
}

// (0.25) The effects of expression n of a checked body, once inferred
// (FN_EFFECTS): its own and those of the functions it calls, directly or
// through fn values (contracts' conditions, check_contracts); a closure's
// body is its own function, not part of n.
pub fn expr_effects(n: i64, pcx: &mut Ctx<Comp>) -> Effects {
    if n <= 0 || pcx.node_fx == 0 as *mut Effects {
        return effects_top();
    }
    let saved = pcx.acc;
    let mark = pcx.loops.count;
    pcx.acc = effects_none();
    pcx.eval = true;
    walk(n, pcx);
    pcx.eval = false;
    pcx.loops.count = mark;
    let e = pcx.acc;
    pcx.acc = saved;
    e
}
