// Effect inference (0.16; docs/design/effects-allocation.md §2.1, §3):
// one walk per checked body (its local effects, and its calls as edges of
// a call graph), Tarjan's strongly connected components over that graph,
// and the union of each component's sets, callees first. A separate walk
// after checking, not checker hooks: speculative checking (`attempt`)
// would add effects that are not there. No iteration: within a component
// every member reaches every other, so all have the same set.
//
// The graph's nodes are the functions (FNS indexes: items, instances,
// closures, C functions) and, after them, virtual nodes: one per fn type
// called through a value (closed world: its edges go to every function of
// that type whose address is taken, coerced closures included) and one for
// unknown C (`alloc(extern) io global panic diverge`, and an edge to each
// address-taken `extern "C" fn` of the program: the callbacks C may call).
// An edge is one of:
//   E_CALL   the callee's effects, but not its `unsafe` (a safe function
//            encapsulates its unsafety)
//   E_ALLOC  a call of a method of `impl Allocator for X`: alloc(X) is the
//            call's local effect, and through the edge come only the raw
//            panic and diverge (refills, internal loops and panics are the
//            allocator's business: the encapsulation rule)
//   E_SCOPE  a call of arena_scope, Arena::scope or ScopedArena::scope:
//            the callee's effects without alloc(ScopedArena) (its own
//            arena: #[scoped] keeps it from escaping), with the parent's
//            allocator (SCOPE_ADD): discharge
// A component with a cycle (recursion) also gets `diverge`.
//
// The local effects (walk): a `static mut` (or a C static) read, written
// or its address taken is global; a checked index or slicing (unless in
// bounds: in_bounds), a failed `as E`, a vector load, store or lane is
// panic; `while` and `loop` are diverge (`for` over a range is counted:
// the desugared `for` loops are); an operation that needs unsafe code is
// unsafe. A body that failed to check is ⊤, unknown (no cascade of
// declared-effect errors in its callers).
//
// why.vl walks a body again in search mode (find_step): the first
// local source or call that brings a given effect.

use crate::arch::{INTRS, intrinsic_effect_bits, intrinsic_of_fn};
use crate::base::{IntVec, SYMS, alloc_array, intern_c};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::timer::{T_CHECK, T_EFFECTS, timer_now, timer_sub};
use crate::front::ast::{
    FN_BODY_FAILED, FN_SIG_FAILED, FN_UNSAFE, NODES, NODE_IN_BOUNDS, NODE_RAW, NODE_REF_MUT,
    NodeKind, REPR_UNION, VK_LANE, VK_LOAD, VK_STORE, VK_WITH, child,
};
use crate::front::check::{LOCALS, Res};
use crate::front::check::unsafety::{NODE_NO_READ, is_borrow, is_borrow_param};
use crate::front::effects::{
    ALLOC_ANY, EFF_ALLOC_EXTERN, EFF_DIVERGE, EFF_GLOBAL, EFF_INTERIOR, EFF_IO, EFF_PANIC,
    EFF_RAW_DIVERGE, EFF_RAW_GLOBAL, EFF_RAW_PANIC, EFF_SYNC, EFF_TLS, EFF_UNKNOWN, EFF_UNSAFE,
    Effects, FN_EFFECTS, FN_EFFECTS_COUNT, allocator_bit, effects_none, effects_top,
};
use crate::front::effects::builtin::unknown_c_effects;
use crate::front::effects::check::extern_effects;
use crate::front::lexer::Tok;
use crate::front::modules::{STD_MODULE, within_std};
use crate::front::modules::lookup::std_item_key;
use crate::front::threadlocal::is_thread_local;
use crate::front::traits::{impl_of_fn, std_trait};
use crate::front::types::{
    FNS, FN_COUNT, REF_SHARED, STATICS, STRUCTS, TLISTS, TYPES, TY_ERROR, TyKind, struct_type,
    vec_lanes,
};
use crate::middle::lower::atomic::atomic_intrinsic;
use crate::middle::lower::ssa::HMap;

// The kinds of edges (above).
pub const E_CALL: i64 = 0;
pub const E_ALLOC: i64 = 1;
pub const E_SCOPE: i64 = 2;

const CALL_UNSAFE: i64 = 8;
const BORROW_SHIFT: i64 = 8;
const BORROW_PARAMS: i64 = 48;

const LOOP_SLICE: i64 = 1;
const LOOP_LENGTH: i64 = 2;

// Function f's body failed to check (check_function_recovering): its
// effects are ⊤.
pub fn note_body_failed(f: i64, pcx: inout Ctx<Comp>) {
    pcx.failed_list.push(f);
}

// The template of instance f (f itself when not an instance).
pub fn template_of(f: i64) -> i64 {
    unsafe {
        if FNS[f].tmpl != 0 { FNS[f].tmpl - 1 } else { f }
    }
}

// The type of std's struct `name`, or 0.
pub fn std_struct_type(name: *u8, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if STD_MODULE < 0 {
            return 0;
        }
        let key = std_item_key(intern_c(name), &pcx);
        let s = if key < 0 { -1 } else { pcx.sym_struct[key] - 1 };
        if s < 0 || STRUCTS[s].generic != 0 { 0 } else { struct_type(s) }
    }
}

// Whether function f is a method of an `impl Allocator for X` (X its
// self type).
pub fn is_allocator_method(f: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if pcx.infer_allocator_trait < 0 || FNS[f].self_ty == 0 {
            return false;
        }
        let i = impl_of_fn(template_of(f), pcx);
        i >= 0 && pcx.traits_impls[i].tr == pcx.infer_allocator_trait
    }
}

// Whether f is a part of std's arenas whose own allocation is the arena's
// business (a scope's end giving the blocks of their own back to Gpa): a
// call of it is masked as an Allocator method's is, and adds no allocator.
fn is_arena_internal(f: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        within_std(FNS[f].module) && FNS[f].self_ty == 0
            && NODES[FNS[f].node].a == pcx.arena_unlend_sym
    }
}

// The parent allocator type of a call of function f when f is one of std's
// arena scopes (arena_scope: Gpa; Arena::scope: Arena; ScopedArena::scope:
// ScopedArena), else 0.
pub fn scope_parent(f: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        let base = template_of(f);
        if !within_std(FNS[base].module) {
            return 0;
        }
        let name = NODES[FNS[base].node].a;
        let self_ty = FNS[f].self_ty;
        if name == pcx.arena_scope_sym && self_ty == 0 {
            return pcx.infer_gpa_type;
        }
        if name != pcx.scope_sym || self_ty <= 0 || TYPES[self_ty].kind != TyKind::Struct {
            return 0;
        }
        let s = STRUCTS[TYPES[self_ty].a].name;
        if s == pcx.arena_sym || s == pcx.scoped_sym { self_ty } else { 0 }
    }
}

// Effects e as seen through an edge of kind `kind` (add: E_SCOPE's parent
// allocator bits).
pub fn through(e: Effects, kind: i64, add: i64, pcx: inout Ctx<Comp>) -> Effects {
    if kind == E_ALLOC {
        return Effects { bits: e.bits & (EFF_RAW_PANIC | EFF_RAW_DIVERGE), allocs: 0 };
    }
    var allocs = e.allocs;
    if kind == E_SCOPE {
        if pcx.scoped_type != 0 && (allocs & ALLOC_ANY) == 0 {
            allocs = allocs & ~allocator_bit(pcx.scoped_type, &pcx);
        }
        allocs = allocs | add;
    }
    Effects { bits: e.bits & ~EFF_UNSAFE, allocs: allocs }
}

// Whether e has the effect (bit, alloc): an EFF_* bit, or with bit 0 the
// allocator bit alloc (ALLOC_ANY: any allocation, C's too).
pub fn has_effect(e: Effects, bit: i64, alloc: i64) -> bool {
    if bit != 0 {
        return (e.bits & bit) != 0;
    }
    if alloc == ALLOC_ANY {
        return e.allocs != 0 || (e.bits & EFF_ALLOC_EXTERN) != 0;
    }
    (e.allocs & alloc) != 0 || (e.allocs & ALLOC_ANY) != 0
}

// ---- Inference ----

// Fills FN_EFFECTS, after the bodies and instances are checked (called by
// check_program, before exit_if_errors).
pub fn infer_effects(pcx: inout Ctx<Comp>) {
    let t = timer_now();
    unsafe {
        init_walk(&pcx);
        let n = FN_COUNT;
        pcx.graph_fns = n;
        pcx.failed = alloc_array::<i64>(n + 1);
        for i in 0..pcx.failed_list.count {
            if pcx.failed_list.data[i] < n {
                pcx.failed[pcx.failed_list.data[i]] = 1;
            }
        }
        // (a closure of a function that failed is unknown too: its
        // enclosing function is made before it)
        for c in 0..pcx.closures.len() as i64 {
            let e = pcx.closures[c].encl_fn;
            let f = pcx.closures[c].f;
            if e >= 0 && e < n && f >= 0 && f < n && pcx.failed[e] != 0 {
                pcx.failed[f] = 1;
            }
        }
        pcx.local_fx = alloc_array::<Effects>(n + 1);
        pcx.callee_info = alloc_array::<i64>(n + 1);
        pcx.static_uses.count = 0;
        pcx.static_use_start.count = 0;
        pcx.sa_memo = HMap { keys: 0 as *i64, vals: 0 as *i64, size: 0, count: 0 };
        pcx.sa_seen = 0 as *i64;
        pcx.sa_top = alloc_array::<i64>(n + 1);
        for f in 0..n {
            pcx.edge_start.push(pcx.edges.count);
            pcx.static_use_start.push(pcx.static_uses.count);
            pcx.local_fx[f] = node_locals(f, &pcx);
        }
        pcx.static_use_start.push(pcx.static_uses.count);
        // The virtual nodes' edges, in the order they were made.
        let addr = pcx.address_taken.count;
        for k in 0..pcx.virtual_type.count {
            pcx.edge_start.push(pcx.edges.count);
            let vt = pcx.virtual_type.data[k];
            var i = 0;
            while i < addr {
                let t = pcx.address_taken.data[i];
                let f = pcx.address_taken.data[i + 1];
                let callback = vt < 0 && TYPES[t].kind == TyKind::Fn && TYPES[t].b != 0;
                if t == vt || callback {
                    push_edge(f, E_CALL, 0, &pcx);
                }
                i += 2;
            }
        }
        pcx.graph_size = n + pcx.virtual_type.count;
        pcx.edge_start.push(pcx.edges.count);
        components(&pcx);
        FN_EFFECTS = pcx.node_fx;
        FN_EFFECTS_COUNT = n;
    }
    timer_sub(T_CHECK, T_EFFECTS, t);
}

// (0.25) How function f may access mutable static s by name, in its body
// or in what it calls (fn values, unknown C callbacks and dyn calls
// through their virtual nodes): 0 not at all, bit 1 a read, bit 2 a
// change. An unknown callee (f < 0), or one whose effects are unknown
// (a body not checked), may do anything: 3. own::calls::static_args asks
// it for a static lent to a call.
pub fn static_access(f: i64, s: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if f < 0 || f >= pcx.graph_fns || pcx.static_use_start.count <= pcx.graph_fns {
            return 3;
        }
        let key = f * 65536 + s + 1;
        let known = pcx.sa_memo.get(key);
        if known != 0 {
            return known - 1;
        }
        if pcx.sa_seen == 0 as *i64 {
            pcx.sa_seen = alloc_array::<i64>(pcx.graph_size + 1);
        }
        pcx.sa_stamp += 1;
        var how = 0;
        pcx.sa_stack.count = 0;
        pcx.sa_stack.push(f);
        pcx.sa_seen[f] = pcx.sa_stamp;
        while pcx.sa_stack.count > 0 && how != 3 {
            pcx.sa_stack.count -= 1;
            let v = pcx.sa_stack.data[pcx.sa_stack.count];
            if v < pcx.graph_fns {
                if pcx.sa_top[v] != 0 {
                    how = 3;
                    break;
                }
                var i = pcx.static_use_start.data[v];
                while i < pcx.static_use_start.data[v + 1] {
                    if pcx.static_uses.data[i] == s {
                        how |= pcx.static_uses.data[i + 1];
                    }
                    i += 2;
                }
            }
            for e in pcx.edge_start.data[v]..pcx.edge_start.data[v + 1] {
                let w = edge_to(e, pcx);
                if (pcx.edges.data[e] & 3) != E_ALLOC && w >= 0 && w < pcx.graph_size
                    && pcx.sa_seen[w] != pcx.sa_stamp {
                    pcx.sa_seen[w] = pcx.sa_stamp;
                    pcx.sa_stack.push(w);
                }
            }
        }
        pcx.sa_memo.put(key, how + 1);
        how
    }
}

fn init_walk(pcx: inout Ctx<Comp>) {
    pcx.edge_start.count = 0;
    pcx.edges.count = 0;
    pcx.scope_add.clear();
    pcx.virtual_type.count = 0;
    pcx.address_taken.count = 0;
    pcx.infer_dispatch.clear();
    pcx.c_unknown = -1;
    pcx.infer_allocator_trait = std_trait(c"Allocator", &pcx);
    pcx.infer_gpa_type = std_struct_type(c"Gpa", &pcx);
    pcx.scoped_type = std_struct_type(c"ScopedArena", &pcx);
    pcx.arena_sym = intern_c(c"Arena");
    pcx.scoped_sym = intern_c(c"ScopedArena");
    pcx.scope_sym = intern_c(c"scope");
    pcx.arena_scope_sym = intern_c(c"arena_scope");
    pcx.arena_unlend_sym = intern_c(c"arena_unlend");
    pcx.len_sym = intern_c(c"len");
    pcx.search = false;
}

// Whether function f's body is walked: checked, not a template, not
// failed. (A lazy default never used was not checked: its body has no
// type.)
pub fn body_walked(f: i64) -> bool {
    unsafe {
        let node = FNS[f].node;
        if node == 0 || NODES[node].kind != NodeKind::Fn || FNS[f].generic > 0
            || (NODES[node].p & (FN_SIG_FAILED | FN_BODY_FAILED)) != 0 {
            return false;
        }
        let body = NODES[node].c;
        body != 0 && NODES[body].ty != 0
    }
}

// Whether function f's effects are ⊤: a template, a body that failed or
// was not checked, an instance of the error type (query mode).
fn is_top(f: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if pcx.failed[f] != 0 || FNS[f].node == 0 {
            return true;
        }
        if FNS[f].is_extern {
            return false;
        }
        if !body_walked(f) {
            return true;
        }
        for i in 0..FNS[f].targ_count {
            if TLISTS.data[FNS[f].targs + i] == TY_ERROR {
                return true;
            }
        }
        false
    }
}

// The local effects of function f, its edges pushed.
fn node_locals(f: i64, pcx: inout Ctx<Comp>) -> Effects {
    unsafe {
        // (0.19: a declaration of std::arch's has its table's effects)
        let intr = intrinsic_of_fn(f, pcx);
        if intr >= 0 && NODES[FNS[f].node].c == 0 {
            // (a raw:: pointer form, one parameter fewer, is unsafe)
            let raw = FNS[f].param_count < INTRS[intr].nparams;
            return Effects { bits: if raw { EFF_UNSAFE } else { intrinsic_effect_bits(intr) },
                allocs: 0 };
        }
        // (0.21: std's atomic intrinsics synchronize, and their bodies
        // are never compiled; unsafe stays with their callers)
        if atomic_intrinsic(f) >= 0 {
            return Effects { bits: EFF_SYNC | EFF_UNSAFE, allocs: 0 };
        }
        // (0.21: the lock std's printing holds once threads run is part of
        // its io, as waiting for a pipe is; 0.26.1: its state is an
        // immutable static in a cell, not `global`: printing is `io panic`)
        if is_print_lock(f) {
            return Effects { bits: EFF_IO | EFF_INTERIOR, allocs: 0 };
        }
        if is_top(f, pcx) {
            // (0.25: static_access, a callee that may do anything)
            if pcx.sa_top != 0 as *i64 {
                pcx.sa_top[f] = 1;
            }
            return effects_top();
        }
        if FNS[f].is_extern {
            let e = extern_effects(f, &pcx);
            if (e.bits & EFF_UNKNOWN) != 0 {
                // (unknown C: its callbacks)
                push_edge(c_unknown_node(&pcx), E_CALL, 0, &pcx);
                return Effects { bits: e.bits & ~EFF_UNKNOWN, allocs: e.allocs };
            }
            return e;
        }
        pcx.walk_node = f;
        pcx.acc = effects_none();
        if (FNS[f].attrs & FN_UNSAFE) != 0 {
            pcx.acc.bits |= EFF_UNSAFE;
        }
        pcx.loops.count = 0;
        walk(NODES[FNS[f].node].c, &pcx);
        if is_cell_root(f) {
            // (0.26.1: the address UnsafeCell::get gives is written through
            // a shared reference)
            pcx.acc.bits |= EFF_INTERIOR;
        }
        drop_edges(f, &pcx);
        pcx.acc
    }
}

// (0.21) Whether f is one of std::fmt's print lock functions
// (print_acquire, print_release and their _held parts; 0.25.5: fmt_guard
// and fmt_unguard, which a Fmt::to_fd takes and gives the lock by, and
// print_threads_started, which takes it for a print a spawn is inside).
fn is_print_lock(f: i64) -> bool {
    unsafe {
        if !within_std(FNS[f].module) {
            return false;
        }
        let text = SYMS[FNS[f].name].text;
        text == "std.fmt.print_acquire" || text == "std.fmt.print_release"
            || text == "std.fmt.print_acquire_held" || text == "std.fmt.print_release_held"
            || text == "std.fmt.fmt_guard" || text == "std.fmt.fmt_guard_held"
            || text == "std.fmt.fmt_unguard" || text == "std.fmt.fmt_unguard_held"
            || text == "std.fmt.print_threads_started"
    }
}

// (0.26.1) Whether f is std::cell::UnsafeCell::get (an instance of it):
// the one root of EFF_INTERIOR.
pub fn is_cell_root(f: i64) -> bool {
    // UNSAFE: FNS is the checker's raw table of functions (*FnInfo).
    // SAFETY: f and its template are function ids below FN_COUNT.
    unsafe {
        let t = template_of(f);
        within_std(FNS[t].module) && SYMS[FNS[t].name].text == "std.cell.UnsafeCell.get"
    }
}

// The virtual node of calls through values of fn type t.
fn dispatch_node(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let v = pcx.infer_dispatch.get(t + 1);
    if v != 0 {
        return v - 1;
    }
    let node = pcx.graph_fns + pcx.virtual_type.count;
    pcx.virtual_type.push(t);
    pcx.infer_dispatch.put(t + 1, node + 1);
    node
}

// The virtual node of unknown C.
fn c_unknown_node(pcx: inout Ctx<Comp>) -> i64 {
    if pcx.c_unknown < 0 {
        pcx.c_unknown = pcx.graph_fns + pcx.virtual_type.count;
        pcx.virtual_type.push(-1);
    }
    pcx.c_unknown
}

// The virtual node of fn type t, or -1 when nothing is called through it.
pub fn dispatch_of(t: i64, pcx: Ctx<Comp>) -> i64 {
    pcx.infer_dispatch.get(t + 1) - 1
}

fn push_edge(to: i64, kind: i64, add: i64, pcx: inout Ctx<Comp>) {
    if kind == E_SCOPE {
        pcx.scope_add.put(pcx.edges.count + 1, add);
    }
    pcx.edges.push(to * 4 + kind);
}

// The node edge e goes to, its kind, and what it adds.
fn edge_to(e: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe { pcx.edges.data[e] >> 2 }
}

fn edge_through(e: i64, pcx: inout Ctx<Comp>) -> Effects {
    unsafe {
        let kind = pcx.edges.data[e] & 3;
        let add = if kind == E_SCOPE { pcx.scope_add.get(e + 1) } else { 0 };
        through(pcx.node_fx[pcx.edges.data[e] >> 2], kind, add, &pcx)
    }
}

// ---- The walk ----

// What n brings locally: bits and allocators.
fn local(n: i64, bits: i64, allocs: i64, pcx: inout Ctx<Comp>) {
    var b = bits;
    if (b & EFF_PANIC) != 0 {
        b |= EFF_RAW_PANIC;
    }
    if (b & EFF_DIVERGE) != 0 {
        b |= EFF_RAW_DIVERGE;
    }
    if pcx.search {
        if pcx.found_node == 0 && has_effect(Effects { bits: b, allocs: allocs }, pcx.search_bit,
            pcx.search_alloc) {
            pcx.found_node = n;
            pcx.found_callee = -1;
        }
        return;
    }
    pcx.acc.bits |= b;
    pcx.acc.allocs |= allocs;
}

// Call n of graph node `to`, by an edge of kind `kind`.
fn call_edge(n: i64, to: i64, kind: i64, add: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        if pcx.search {
            if pcx.found_node != 0 || to < 0 || to >= pcx.graph_size {
                return;
            }
            let e = through(pcx.node_fx[to], kind, add, &pcx);
            let recursive = pcx.search_bit == EFF_DIVERGE
                && pcx.component[to] == pcx.component[pcx.walk_node];
            if has_effect(e, pcx.search_bit, pcx.search_alloc) || recursive {
                pcx.found_node = n;
                pcx.found_callee = to;
                pcx.found_kind = kind;
            }
            return;
        }
        if pcx.eval {
            // (expr_effects: the callee's effects now; -1: no function of
            // that fn type is reached)
            if to < 0 || to >= pcx.graph_size {
                return;
            }
            let e = through(pcx.node_fx[to], kind, add, &pcx);
            pcx.acc.bits |= e.bits;
            pcx.acc.allocs |= e.allocs;
            return;
        }
        push_edge(to, kind, add, &pcx);
    }
}

// (0.26.1) The functions function f's drops call, through their shims:
// the places IR's (places::drop_edge), each as a call by the value it
// drops (0.26.2: the step a why names, `'l' at ... calls 'Loud::drop'`),
// after the body's calls.
fn drop_edges(f: i64, pcx: inout Ctx<Comp>) {
    for i in 0..crate::places::drop_edge_count(f, pcx) {
        call_edge(crate::places::drop_edge_node(f, i, pcx), crate::places::drop_edge(f, i, pcx),
            E_CALL, 0, &pcx);
    }
}

fn walk_list(n: i64, pcx: inout Ctx<Comp>) {
    for i in 0..NODES[n].count {
        walk(child(n, i, pcx), &pcx);
    }
}

// Walks node n (0: none); a literal or a local brings nothing, and is
// passed over here, without a call (the walk's hottest path).
#[inline]
fn walk(n: i64, pcx: inout Ctx<Comp>) {
    if n == 0 {
        return;
    }
    let kind = NODES[n].kind;
    if kind == NodeKind::Ident && NODES[n].res == Res::Local || kind == NodeKind::Int
        || kind == NodeKind::CStr || kind == NodeKind::Str || kind == NodeKind::Bool
        || kind == NodeKind::Char {
        return;
    }
    walk_node(n, &pcx);
}

fn walk_node(n: i64, pcx: inout Ctx<Comp>) {
    match NODES[n].kind {
        NodeKind::Ident => walk_ident(n, &pcx),
        NodeKind::Assign => {
            // (0.25: its target is changed, static_access)
            pcx.static_write += 1;
            walk(NODES[n].b, &pcx);
            pcx.static_write -= 1;
            walk(NODES[n].c, &pcx);
        }
        NodeKind::Binary | NodeKind::While => {
            if NODES[n].kind == NodeKind::While && (NODES[n].p & NODE_IN_BOUNDS) == 0 {
                local(n, EFF_DIVERGE, 0, &pcx);
            }
            walk(NODES[n].b, &pcx);
            walk(NODES[n].c, &pcx);
        }
        NodeKind::Unary => {
            if (NODES[n].p & NODE_RAW) != 0 {
                local(n, EFF_UNSAFE, 0, &pcx);
            }
            // (0.25) `&place` exclusive or raw, a receiver too: the
            // place may change (static_access)
            let t = NODES[n].ty;
            let lends = NODES[n].op == Tok::Amp && ((NODES[n].p & NODE_REF_MUT) != 0
                || t > 0 && TYPES[t].kind == TyKind::Ptr && TYPES[t].b != REF_SHARED);
            if lends {
                pcx.static_write += 1;
            }
            walk(NODES[n].b, &pcx);
            if lends {
                pcx.static_write -= 1;
            }
        }
        NodeKind::Cast => {
            let operand = NODES[n].a;
            walk(operand, &pcx);
            let from = NODES[operand].ty;
            if from > 0 && TYPES[from].kind == TyKind::Prim
                && TYPES[NODES[n].ty].kind == TyKind::Ptr
                && !(NODES[operand].kind == NodeKind::Int && NODES[operand].a == 0) {
                local(n, EFF_UNSAFE, 0, &pcx);
            }
        }
        NodeKind::Call => walk_call(n, &pcx),
        NodeKind::MethodCall => {
            walk(NODES[n].a, &pcx);
            walk_list(n, &pcx);
        }
        NodeKind::Index => walk_index(n, &pcx),
        NodeKind::FieldAccess => {
            if (NODES[n].p & NODE_RAW) != 0 || reads_union(n) {
                local(n, EFF_UNSAFE, 0, &pcx);
            }
            walk(NODES[n].a, &pcx);
        }
        NodeKind::TupleField | NodeKind::ExprStmt | NodeKind::Return | NodeKind::Defer => {
            walk(NODES[n].a, &pcx);
        }
        NodeKind::Tuple | NodeKind::Array | NodeKind::StructLit | NodeKind::VariantLit => {
            walk_list(n, &pcx);
        }
        NodeKind::FieldInit | NodeKind::Break | NodeKind::NamedArg => walk(NODES[n].b, &pcx),
        NodeKind::Repeat | NodeKind::Range => {
            walk(NODES[n].a, &pcx);
            walk(NODES[n].b, &pcx);
        }
        NodeKind::Block => {
            // (its statements' expressions directly: fewer calls)
            for i in 0..NODES[n].count {
                let s = child(n, i, pcx);
                let k = NODES[s].kind;
                walk(if k == NodeKind::ExprStmt { NODES[s].a } else if k == NodeKind::Let {
                    NODES[s].c
                } else { s }, &pcx);
            }
            walk(NODES[n].a, &pcx);
        }
        NodeKind::Let => walk(NODES[n].c, &pcx),
        NodeKind::If => {
            walk(NODES[n].a, &pcx);
            walk(NODES[n].b, &pcx);
            walk(NODES[n].c, &pcx);
        }
        NodeKind::Loop => {
            if (NODES[n].p & NODE_IN_BOUNDS) == 0 {
                local(n, EFF_DIVERGE, 0, &pcx);
            }
            walk(NODES[n].b, &pcx);
        }
        NodeKind::For => walk_for(n, &pcx),
        NodeKind::Match => {
            walk(NODES[n].a, &pcx);
            for i in 0..NODES[n].count {
                let arm = child(n, i, pcx);
                walk(NODES[arm].b, &pcx);
                walk(NODES[arm].c, &pcx);
            }
        }
        NodeKind::EnumPanic => {
            local(n, EFF_PANIC, 0, &pcx);
            walk(NODES[n].a, &pcx);
        }
        NodeKind::VecOp => walk_vecop(n, &pcx),
        // (0.14: its env, or its function as a value; the body is the
        // closure's function, walked as one)
        NodeKind::Interp if NODES[n].x > 0 => walk_direct(n, &pcx),
        NodeKind::Closure | NodeKind::Try | NodeKind::Interp => walk(NODES[n].y, &pcx),
        _ => {}
    }
}

// (0.17) Call n of std's print, println, eprint, eprintln, format_in or
// Buf::push_fmt with its f-string written in place (an Interp node, x =
// the function + 1; front/check/interp.vl, direct_call): its receiver,
// holes and allocator, then the writes, which a search finds as the call
// (step_text: `'println(f"..")' calls 'std::println'`).
fn walk_direct(n: i64, pcx: inout Ctx<Comp>) {
    let block = NODES[n].y;
    for i in 0..NODES[block].count {
        walk(NODES[child(block, i, pcx)].c, &pcx);
    }
    let found = pcx.found_node;
    walk(NODES[block].a, &pcx);
    if pcx.search && found == 0 && pcx.found_node != 0 {
        pcx.found_node = n;
    }
}

fn walk_ident(n: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let res = NODES[n].res;
        if res == Res::Static {
            let s = NODES[n].y;
            if is_thread_local(s) {
                local(n, EFF_TLS, 0, &pcx);
            } else if s >= 0 && (STATICS[s].mutable || STATICS[s].linkage != 0) {
                local(n, EFF_GLOBAL | (if guarded_static(s) { 0 } else { EFF_RAW_GLOBAL }), 0,
                    &pcx);
                if !pcx.search {
                    // (0.25: static_access)
                    pcx.static_uses.push(s);
                    pcx.static_uses.push(if pcx.static_write > 0 { 2 } else { 1 });
                }
            }
            return;
        }
        if res != Res::Fn {
            return;
        }
        let f = NODES[n].y;
        if f < 0 {
            return;
        }
        if !pcx.search && !pcx.eval {
            pcx.address_taken.push(NODES[n].ty);
            pcx.address_taken.push(f);
        }
        if (FNS[f].attrs & FN_UNSAFE) != 0 {
            local(n, EFF_UNSAFE, 0, &pcx);
        }
    }
}

// (0.21) Whether static s is one of std's statics a lock guards once
// threads run (std::thread's thread-local keys): global, not
// EFF_RAW_GLOBAL. (0.26.1: std::fmt's print state is an immutable static,
// PRINTING, with no effect.)
fn guarded_static(s: i64) -> bool {
    unsafe {
        let t = SYMS[NODES[STATICS[s].node].a].text;
        t.len > 11 && t[0..11] == "std.thread."
    }
}

// Whether field access n reads a field of a union (not an assignment's
// target, not `&u.f`).
fn reads_union(n: i64) -> bool {
    unsafe {
        var t = NODES[NODES[n].a].ty;
        if t > 0 && TYPES[t].kind == TyKind::Ptr {
            t = TYPES[t].a;
        }
        t > 0 && TYPES[t].kind == TyKind::Struct && (STRUCTS[TYPES[t].a].repr & REPR_UNION) != 0
            && (NODES[n].p & NODE_NO_READ) == 0
    }
}

fn walk_call(n: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let f = NODES[n].x - 1;
        if f >= 0 {
            walk_list(n, &pcx);
            if f == pcx.check_fn {
                // (an assertion or a clause, lowered in place as a branch
                // to the failure: it may panic unless its condition is
                // true as written, and its body is not called)
                if !proven_true(child(n, 0, pcx)) {
                    local(n, EFF_PANIC, 0, &pcx);
                }
                return;
            }
            let info = callee_info(f, &pcx);
            if (info & CALL_UNSAFE) != 0
                || (info >> BORROW_SHIFT) != 0 && raw_to_borrow(n, f, info, pcx) {
                local(n, EFF_UNSAFE, 0, &pcx);
            }
            let kind = (info & 7) - 1;
            if kind == E_ALLOC && FNS[f].self_ty != 0 {
                local(n, 0, allocator_bit(FNS[f].self_ty, &pcx), &pcx);
            }
            call_edge(n, f, kind,
                if kind == E_SCOPE { allocator_bit(scope_parent(f, pcx), &pcx) } else { 0 }, &pcx);
            return;
        }
        let callee = NODES[n].a;
        walk(callee, &pcx);
        walk_list(n, &pcx);
        let t = NODES[callee].ty;
        if t <= 0 || TYPES[t].kind != TyKind::Fn {
            return;
        }
        if TYPES[t].b != 0 {
            // (an `extern "C" fn` value: C, unknown)
            local(n, EFF_UNSAFE, 0, &pcx);
            if pcx.eval && pcx.c_unknown < 0 {
                local(n, unknown_c_effects().bits, 0, &pcx);
            } else if pcx.search || pcx.eval {
                call_edge(n, pcx.c_unknown, E_CALL, 0, &pcx);
            } else {
                call_edge(n, c_unknown_node(&pcx), E_CALL, 0, &pcx);
            }
            return;
        }
        if pcx.search || pcx.eval {
            call_edge(n, dispatch_of(t, pcx), E_CALL, 0, &pcx);
        } else {
            call_edge(n, dispatch_node(t, &pcx), E_CALL, 0, &pcx);
        }
    }
}

// (0.25) Whether condition n is true as written: `true`, or `!`, `&&` and
// `||` of such, or a comparison of integer literals (an assertion that
// cannot fail does not panic).
pub fn proven_true(n: i64) -> bool {
    const_bool(n, 0) == 1
}

// The value of condition n as written: 1 true, 0 false, -1 not known.
fn const_bool(n: i64, depth: i64) -> i64 {
    if n <= 0 || depth > 16 {
        return -1;
    }
    let kind = NODES[n].kind;
    if kind == NodeKind::Bool {
        return if NODES[n].a != 0 { 1 } else { 0 };
    }
    if kind == NodeKind::Unary && NODES[n].op == Tok::Bang {
        let v = const_bool(NODES[n].b, depth + 1);
        return if v < 0 { -1 } else { 1 - v };
    }
    if kind != NodeKind::Binary {
        return -1;
    }
    let op = NODES[n].op;
    let l = NODES[n].b;
    let r = NODES[n].c;
    if op == Tok::AmpAmp || op == Tok::PipePipe {
        let a = const_bool(l, depth + 1);
        let b = const_bool(r, depth + 1);
        if op == Tok::AmpAmp {
            return if a == 0 || b == 0 { 0 } else if a == 1 && b == 1 { 1 } else { -1 };
        }
        return if a == 1 || b == 1 { 1 } else if a == 0 && b == 0 { 0 } else { -1 };
    }
    if NODES[l].kind != NodeKind::Int || NODES[r].kind != NodeKind::Int {
        return -1;
    }
    let x = NODES[l].a;
    let y = NODES[r].a;
    var t = false;
    if op == Tok::EqEq {
        t = x == y;
    } else if op == Tok::BangEq {
        t = x != y;
    } else if op == Tok::Lt {
        t = x < y;
    } else if op == Tok::LtEq {
        t = x <= y;
    } else if op == Tok::Gt {
        t = x > y;
    } else if op == Tok::GtEq {
        t = x >= y;
    } else {
        return -1;
    }
    if t { 1 } else { 0 }
}

// Whether direct call n of f (its callee_info `info`) passes a raw pointer
// to a borrowed parameter (unsafe; a method called through a raw pointer
// is one).
fn raw_to_borrow(n: i64, f: i64, info: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let item = FNS[f].node;
        let count = if NODES[n].count < NODES[item].count { NODES[n].count }
            else { NODES[item].count };
        let mask = info >> BORROW_SHIFT;
        for i in 0..count {
            let borrowed = if i < BORROW_PARAMS { ((mask >> i) & 1) != 0 }
                else { is_borrow_param(child(item, i, pcx)) };
            if !borrowed {
                continue;
            }
            let arg = child(n, i, pcx);
            let t = NODES[arg].ty;
            if t > 0 && TYPES[t].kind == TyKind::Ptr && !is_borrow(arg) {
                return true;
            }
        }
        false
    }
}

// What a call of function f is, computed at its first call: its edge kind
// + 1 (the low 3 bits), CALL_UNSAFE (C, or an `unsafe fn`), and from
// BORROW_SHIFT on the mask of its borrowed parameters (the first
// BORROW_PARAMS; past them all are, to look at).
fn callee_info(f: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let known = pcx.callee_info[f];
        if known != 0 {
            return known;
        }
        let kind = if is_allocator_method(f, pcx) || is_arena_internal(f, pcx) { E_ALLOC }
            else if scope_parent(f, pcx) != 0 { E_SCOPE } else { E_CALL };
        var info = kind + 1;
        if FNS[f].is_extern || (FNS[f].attrs & FN_UNSAFE) != 0 {
            info |= CALL_UNSAFE;
        }
        if !FNS[f].is_extern {
            let item = FNS[f].node;
            for i in 0..NODES[item].count {
                if i >= BORROW_PARAMS || is_borrow_param(child(item, i, pcx)) {
                    info |= 1 << (BORROW_SHIFT + if i < BORROW_PARAMS { i } else { BORROW_PARAMS });
                }
                if i >= BORROW_PARAMS {
                    break;
                }
            }
        }
        pcx.callee_info[f] = info;
        info
    }
}

fn walk_index(n: i64, pcx: inout Ctx<Comp>) {
    let base = NODES[n].a;
    let index = NODES[n].b;
    walk(base, &pcx);
    let bt = NODES[base].ty;
    let raw = bt > 0 && TYPES[bt].kind == TyKind::Ptr;
    if NODES[index].kind == NodeKind::Range {
        walk(NODES[index].a, &pcx);
        walk(NODES[index].b, &pcx);
        if raw {
            local(n, EFF_UNSAFE, 0, &pcx);
        } else if NODES[index].a == 0 && NODES[index].b == 0 {
            // (`s[..]`: the whole)
            NODES[n].p |= NODE_IN_BOUNDS;
        } else if (NODES[n].p & NODE_IN_BOUNDS) == 0 {
            local(n, EFF_PANIC, 0, &pcx);
        }
        return;
    }
    walk(index, &pcx);
    if raw {
        local(n, EFF_UNSAFE, 0, &pcx);
        return;
    }
    if (NODES[n].p & NODE_IN_BOUNDS) != 0 || in_bounds(base, bt, index, pcx) {
        NODES[n].p |= NODE_IN_BOUNDS;
        return;
    }
    local(n, EFF_PANIC, 0, &pcx);
}

// Whether `base[index]` (base of type bt, a slice or an array) is in
// bounds by the syntax: a constant index below an array's length, or the
// variable of a counted loop `for i in 0..s.len` with `s` the same
// immutable slice binding, or `for i in 0..N` with N at most the array's
// length (which is how the `for` desugarings index).
fn in_bounds(base: i64, bt: i64, index: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        let array = bt > 0 && TYPES[bt].kind == TyKind::Array;
        if NODES[index].kind == NodeKind::Int {
            return array && NODES[index].a >= 0 && NODES[index].a < TYPES[bt].b;
        }
        if NODES[index].kind != NodeKind::Ident || NODES[index].res != Res::Local {
            return false;
        }
        let i = NODES[index].y;
        var k = pcx.loops.count - 3;
        while k >= 0 {
            if pcx.loops.data[k] == i {
                let kind = pcx.loops.data[k + 1];
                let what = pcx.loops.data[k + 2];
                if kind == LOOP_SLICE {
                    return NODES[base].kind == NodeKind::Ident && NODES[base].res == Res::Local
                        && NODES[base].y == what;
                }
                return array && what <= TYPES[bt].b;
            }
            k -= 3;
        }
        false
    }
}

// `for p in a..b body` (counted): a in-bounds context for the body when
// it is `for i in 0..s.len` or `for i in 0..N`.
fn walk_for(n: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let range = NODES[n].c;
        if NODES[range].kind != NodeKind::Range {
            walk(range, &pcx);
            walk(NODES[n].d, &pcx);
            return;
        }
        walk(NODES[range].a, &pcx);
        walk(NODES[range].b, &pcx);
        let mark = pcx.loops.count;
        let pattern = NODES[n].b;
        let low = NODES[range].a;
        let high = NODES[range].b;
        if NODES[pattern].kind == NodeKind::PatBind && NODES[pattern].b == 0
            && NODES[pattern].x >= 0 && low != 0 && NODES[low].kind == NodeKind::Int
            && NODES[low].a >= 0 && high != 0 {
            let inclusive = NODES[range].c != 0;
            if NODES[high].kind == NodeKind::Int {
                pcx.loops.push(NODES[pattern].x);
                pcx.loops.push(LOOP_LENGTH);
                pcx.loops.push(NODES[high].a + inclusive as i64);
            } else if !inclusive && NODES[high].kind == NodeKind::FieldAccess
                && NODES[high].b == pcx.len_sym {
                let s = NODES[high].a;
                if NODES[s].kind == NodeKind::Ident && NODES[s].res == Res::Local && NODES[s].y >= 0
                    && !LOCALS[NODES[s].y].mutable {
                    let st = NODES[s].ty;
                    if st > 0 && TYPES[st].kind == TyKind::Slice {
                        pcx.loops.push(NODES[pattern].x);
                        pcx.loops.push(LOOP_SLICE);
                        pcx.loops.push(NODES[s].y);
                    }
                }
            }
        }
        walk(NODES[n].d, &pcx);
        pcx.loops.count = mark;
    }
}

fn walk_vecop(n: i64, pcx: inout Ctx<Comp>) {
    let kind = NODES[n].x;
    if kind == VK_LOAD || kind == VK_STORE {
        local(n, EFF_PANIC, 0, &pcx);
    } else if kind == VK_LANE || kind == VK_WITH {
        let lane = child(n, 0, pcx);
        if !(NODES[lane].kind == NodeKind::Int && NODES[lane].a >= 0
            && NODES[lane].a < vec_lanes(NODES[n].y)) {
            local(n, EFF_PANIC, 0, &pcx);
        }
    }
    walk(NODES[n].a, &pcx);
    walk_list(n, &pcx);
}

// ---- Components ----

// Tarjan's algorithm, iterative, over the graph; each component's effects
// as it completes (its callees' are known then).
fn components(pcx: inout Ctx<Comp>) {
    unsafe {
        let size = pcx.graph_size;
        pcx.node_fx = alloc_array::<Effects>(size + 1);
        pcx.component = alloc_array::<i64>(size + 1);
        let index = alloc_array::<i64>(size + 1);
        let low = alloc_array::<i64>(size + 1);
        let on_stack = alloc_array::<i64>(size + 1);
        pcx.stack.count = 0;
        var calls = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var counter = 0;
        var comp = 0;
        for root in 0..size {
            if index[root] != 0 {
                continue;
            }
            counter += 1;
            index[root] = counter;
            low[root] = counter;
            pcx.stack.push(root);
            on_stack[root] = 1;
            calls.push(root);
            calls.push(pcx.edge_start.data[root]);
            while calls.count > 0 {
                let v = calls.data[calls.count - 2];
                let e = calls.data[calls.count - 1];
                if e < pcx.edge_start.data[v + 1] {
                    calls.data[calls.count - 1] = e + 1;
                    let w = edge_to(e, pcx);
                    if index[w] == 0 {
                        counter += 1;
                        index[w] = counter;
                        low[w] = counter;
                        pcx.stack.push(w);
                        on_stack[w] = 1;
                        calls.push(w);
                        calls.push(pcx.edge_start.data[w]);
                    } else if on_stack[w] != 0 && index[w] < low[v] {
                        low[v] = index[w];
                    }
                    continue;
                }
                calls.count -= 2;
                if calls.count > 0 {
                    let p = calls.data[calls.count - 2];
                    if low[v] < low[p] {
                        low[p] = low[v];
                    }
                }
                if low[v] == index[v] {
                    var first = pcx.stack.count - 1;
                    while pcx.stack.data[first] != v {
                        first -= 1;
                    }
                    comp += 1;
                    for k in first..pcx.stack.count {
                        on_stack[pcx.stack.data[k]] = 0;
                        pcx.component[pcx.stack.data[k]] = comp;
                    }
                    component_effects(first, comp, &pcx);
                    pcx.stack.count = first;
                }
            }
        }
    }
}

// The local effects of graph node v.
fn local_of(v: i64, pcx: Ctx<Comp>) -> Effects {
    unsafe {
        if v < pcx.graph_fns {
            return pcx.local_fx[v];
        }
        if v == pcx.c_unknown { unknown_c_effects() } else { effects_none() }
    }
}

// The effects of component number comp, the nodes of STACK from first
// on.
fn component_effects(first: i64, comp: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        var acc = effects_none();
        var cyclic = pcx.stack.count - first > 1;
        for k in first..pcx.stack.count {
            let m = pcx.stack.data[k];
            let own = local_of(m, pcx);
            acc.bits |= own.bits & ~EFF_UNSAFE;
            acc.allocs |= own.allocs;
            for e in pcx.edge_start.data[m]..pcx.edge_start.data[m + 1] {
                let w = edge_to(e, pcx);
                if pcx.component[w] == comp {
                    cyclic = true;
                    continue;
                }
                let t = edge_through(e, &pcx);
                acc.bits |= t.bits;
                acc.allocs |= t.allocs;
            }
        }
        if cyclic {
            acc.bits |= EFF_DIVERGE | EFF_RAW_DIVERGE;
        }
        for k in first..pcx.stack.count {
            let m = pcx.stack.data[k];
            pcx.node_fx[m] = Effects { bits: acc.bits | (local_of(m, pcx).bits & EFF_UNSAFE),
                allocs: acc.allocs };
        }
    }
}

// ---- Search (why.vl) ----

// The first call or local source in function f's body that brings the
// effect (bit, alloc) (has_effect's): FOUND_NODE (0: none), FOUND_CALLEE
// (the graph node called, -1 for a local source) and FOUND_KIND.
pub fn find_step(f: i64, bit: i64, alloc: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        pcx.found_node = 0;
        pcx.found_callee = -1;
        pcx.found_kind = 0;
        if f < 0 || f >= pcx.graph_fns || pcx.node_fx == 0 as *Effects || !body_walked(f) {
            return;
        }
        pcx.search = true;
        pcx.search_bit = bit;
        pcx.search_alloc = alloc;
        pcx.walk_node = f;
        pcx.loops.count = 0;
        if bit == EFF_UNSAFE && (FNS[f].attrs & FN_UNSAFE) != 0 {
            pcx.found_node = FNS[f].node;
        }
        walk(NODES[FNS[f].node].c, &pcx);
        drop_edges(f, &pcx);
        pcx.search = false;
    }
}

// (0.25) The effects of expression n of a checked body, once inferred
// (FN_EFFECTS): its own and those of the functions it calls, directly or
// through fn values (contracts' conditions, check_contracts); a closure's
// body is its own function, not part of n.
pub fn expr_effects(n: i64, pcx: inout Ctx<Comp>) -> Effects {
    if n <= 0 || pcx.node_fx == 0 as *Effects {
        return effects_top();
    }
    let saved = pcx.acc;
    let mark = pcx.loops.count;
    pcx.acc = effects_none();
    pcx.eval = true;
    walk(n, &pcx);
    pcx.eval = false;
    pcx.loops.count = mark;
    let e = pcx.acc;
    pcx.acc = saved;
    e
}
