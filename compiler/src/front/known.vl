// (0.27.2) The compiler-known items of std (docs/design/front-rust.md
// Z3.1): the std items the checker, the builder and the lowerings name.
// MVS's are found by name in its root (`std::NAME`: std_item_key); std2
// keeps them in its modules, so a rust program on std2 finds each through
// this table, by the key the compiler asks with (MVS's name) and std2's
// path. A key with no std2 entry is found by name as in MVS;
// known_items_check (under --verify-places) reports an entry whose item
// std2 does not have. RULE: Z3.1

use crate::base::sym_text;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

// std2's path of compiler-known item `name` (MVS's name for it), after
// `std::`; "" when the table has no entry.
pub fn std2_path(name: [u8]) -> [u8] {
    let n = KNOWN.len() as i64 / 2;
    for i in 0..n {
        if KNOWN[2 * i] == name {
            return KNOWN[2 * i + 1];
        }
    }
    ""
}

// The module of std2 a known item is in, `result` for `Result` (the
// segment a made path `std::result::Result::Err` takes); "" for none.
pub fn std2_module(name: [u8]) -> [u8] {
    let path = std2_path(name);
    var i = 0;
    while i + 1 < path.len() as i64 {
        if path[i] == ':' && path[i + 1] == ':' {
            return path[0..i];
        }
        i += 1;
    }
    ""
}

// Whether the program reads std2 (a rust program on std2).
pub fn on_std2(pcx: Ctx<Comp>) -> bool {
    pcx.std2 && pcx.edition != 0
}

// The item key of known item `name` (a symbol) in std2, or -1.
pub fn std2_key(name: i64, pcx: inout Ctx<Comp>) -> i64 {
    let path = std2_path(sym_text(name, pcx));
    if path.len() == 0 {
        return -1;
    }
    let full = crate::base::buf_new();
    crate::base::buf_bytes(full, "std::");
    crate::base::buf_bytes(full, path);
    let key = crate::base::find_sym(crate::base::buf_slice(full), pcx);
    if key < 0 || crate::front::types::item_node_of(key, pcx) == 0 {
        return -1;
    }
    key
}

// (--verify-places) Each entry of the table that std2 lacks, one line
// each on stderr, and how many entries there are and are found:
// `known items: N/N`.
pub fn known_items_check(pcx: inout Ctx<Comp>) {
    if !on_std2(pcx) {
        return;
    }
    let n = KNOWN.len() as i64 / 2;
    var found = 0;
    for i in 0..n {
        let sym = crate::base::intern(KNOWN[2 * i], &pcx);
        if std2_key(sym, &pcx) >= 0 {
            found += 1;
        } else {
            eprintln(format_args("known item missing in std2: {} (std::{})", KNOWN[2 * i],
                KNOWN[2 * i + 1]));
        }
    }
    eprintln(format_args("known items: {found}/{n}"));
}

// The table: (the compiler's name, std2's path), in Z3.1's groups.
const KNOWN: [[u8]; 136] = [
    // allocation
    "Gpa", "alloc::Gpa", "Allocator", "alloc::Allocator", "AnyAlloc", "alloc::AnyAlloc",
    "Layout", "alloc::Layout", "Box", "boxed::Box",
    // `?`, `if let`, `for`
    "Option", "option::Option", "Result", "result::Result", "Iterator", "iter::Iterator",
    "IntoIterator", "iter::IntoIterator", "DoubleEndedIterator", "iter::DoubleEndedIterator",
    "ExactSizeIterator", "iter::ExactSizeIterator", "Step", "iter::Step", "Sum", "iter::Sum",
    // the `..` forms
    "Range", "ops::Range", "RangeInclusive", "ops::RangeInclusive", "RangeFrom",
    "ops::RangeFrom", "RangeTo", "ops::RangeTo", "RangeFull", "ops::RangeFull",
    "RangeToInclusive", "ops::RangeToInclusive",
    // Deref, Index (F20), Drop
    "Deref", "ops::Deref", "DerefMut", "ops::DerefMut", "Index", "ops::Index", "IndexMut",
    "ops::IndexMut", "Drop", "ops::Drop",
    // the operators (F26)
    "Add", "ops::Add", "Sub", "ops::Sub", "Mul", "ops::Mul", "Div", "ops::Div", "Rem",
    "ops::Rem", "Neg", "ops::Neg", "Not", "ops::Not",
    // (0.27.2: the bit and shift traits, the `op=` ones; F26.1)
    "BitAnd", "ops::BitAnd", "BitOr", "ops::BitOr", "BitXor", "ops::BitXor", "Shl", "ops::Shl",
    "Shr", "ops::Shr", "AddAssign", "ops::AddAssign", "SubAssign", "ops::SubAssign",
    "MulAssign", "ops::MulAssign", "DivAssign", "ops::DivAssign", "RemAssign",
    "ops::RemAssign", "BitAndAssign", "ops::BitAndAssign", "BitOrAssign", "ops::BitOrAssign",
    "BitXorAssign", "ops::BitXorAssign", "ShlAssign", "ops::ShlAssign", "ShrAssign",
    "ops::ShrAssign",
    // the derivable and the conversions
    "Clone", "clone::Clone", "Copy", "marker::Copy", "Eq", "cmp::Eq", "PartialEq",
    "cmp::PartialEq", "Ord", "cmp::Ord", "PartialOrd", "cmp::PartialOrd", "Ordering",
    "cmp::Ordering", "Hash", "hash::Hash", "Hasher", "hash::Hasher", "Default",
    "default::Default", "From", "convert::From", "Into", "convert::Into", "TryFrom",
    "convert::TryFrom",
    // formatting (F16)
    "Display", "fmt::Display", "Debug", "fmt::Debug", "Formatter", "fmt::Formatter",
    // the rest
    "Vec", "vec::Vec", "String", "string::String", "NonNull", "ptr::NonNull", "PhantomData",
    "marker::PhantomData", "UnsafeCell", "cell::UnsafeCell", "Cell", "cell::Cell",
];
