// (0.27.2) The compiler-known items of std (docs/design/front-rust.md
// Z3.1): the std items the checker, the builder and the lowerings name.
// MVS's are found by name in its root (`std::NAME`: std_item_key); std2
// keeps them in its modules, so a rust program on std2 finds each through
// this table, by the key the compiler asks with (MVS's name) and std2's
// path. A key with no std2 entry is found by name as in MVS;
// known_items_check (under --verify-places) reports an entry whose item
// std2 does not have. RULE: Z3.1

use crate::base::sym_text;
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;

// std2's path of compiler-known item `name` (MVS's name for it), after
// `std::`; "" when the table has no entry.
pub fn std2_path(name: &[u8]) -> &[u8] {
    let n = KNOWN.len() as i64 / 2;
    for i in 0..n {
        if KNOWN[(2 * i) as usize] == name {
            return KNOWN[(2 * i + 1) as usize];
        }
    }
    b""
}

// The module of std2 a known item is in, `result` for `Result` (the
// segment a made path `std::result::Result::Err` takes); "" for none.
pub fn std2_module(name: &[u8]) -> &[u8] {
    let path = std2_path(name);
    let mut i: i64 = 0;
    while i + 1 < path.len() as i64 {
        if path[i as usize] == b':' && path[(i + 1) as usize] == b':' {
            return &path[0..i as usize];
        }
        i += 1;
    }
    b""
}

// The item key of known item `name` (a symbol) in std2, or -1.
pub fn std2_key(name: i64, pcx: &mut Ctx<Comp>) -> i64 {
    let path = std2_path(sym_text(name, pcx));
    if path.len() == 0 {
        return -1;
    }
    let full = crate::base::buf_new();
    crate::base::buf_bytes(full, b"std::");
    crate::base::buf_bytes(full, path);
    let key = crate::base::find_sym_buf(full, pcx);
    if key < 0 || crate::front::types::item_node_of(key, pcx) == 0 {
        return -1;
    }
    key
}

// (--verify-places) Each entry of the table that std2 lacks, one line
// each on stderr, and how many entries there are and are found:
// `known items: N/N`.
pub fn known_items_check(pcx: &mut Ctx<Comp>) {
    let n = KNOWN.len() as i64 / 2;
    let mut found: i64 = 0;
    for i in 0..n {
        let sym = crate::base::intern(KNOWN[(2 * i) as usize], pcx);
        if std2_key(sym, pcx) >= 0 {
            found += 1;
        } else {
            eprintln("{}",
                format_args("known item missing in std2: {} (std::{})",
                    str::from_utf8(KNOWN[(2 * i) as usize]).unwrap(),
                    str::from_utf8(KNOWN[(2 * i + 1) as usize]).unwrap()));
        }
    }
    eprintln("{}", format_args("known items: {found}/{n}"));
}

// (0.27.3) The table's compiler names, for std2's lazy read
// (front/modules/std2lazy.vl): how many, and the k-th.
pub fn known_count() -> i64 {
    KNOWN.len() as i64 / 2
}

pub fn known_name(k: i64) -> &'static [u8] {
    KNOWN[(2 * k) as usize]
}

// The table: (the compiler's name, std2's path), in Z3.1's groups.
const KNOWN: [&[u8]; 150] = [
    // allocation
    b"Gpa", b"alloc::Gpa", b"Allocator", b"alloc::Allocator", b"AnyAlloc", b"alloc::AnyAlloc",
    b"Layout", b"alloc::Layout", b"Box", b"boxed::Box",
    // `?`, `if let`, `for`
    b"Option", b"option::Option", b"Result", b"result::Result", b"Iterator", b"iter::Iterator",
    b"IntoIterator", b"iter::IntoIterator", b"DoubleEndedIterator", b"iter::DoubleEndedIterator",
    b"ExactSizeIterator", b"iter::ExactSizeIterator", b"Step", b"iter::Step", b"Sum", b"iter::Sum",
    // the `..` forms
    b"Range", b"ops::Range", b"RangeInclusive", b"ops::RangeInclusive", b"RangeFrom",
    b"ops::RangeFrom", b"RangeTo", b"ops::RangeTo", b"RangeFull", b"ops::RangeFull",
    b"RangeToInclusive", b"ops::RangeToInclusive",
    // Deref, Index (F20), Drop
    b"Deref", b"ops::Deref", b"DerefMut", b"ops::DerefMut", b"Index", b"ops::Index", b"IndexMut",
    b"ops::IndexMut", b"Drop", b"ops::Drop",
    // the operators (F26)
    b"Add", b"ops::Add", b"Sub", b"ops::Sub", b"Mul", b"ops::Mul", b"Div", b"ops::Div", b"Rem",
    b"ops::Rem", b"Neg", b"ops::Neg", b"Not", b"ops::Not",
    // (0.27.2: the bit and shift traits, the `op=` ones; F26.1)
    b"BitAnd", b"ops::BitAnd", b"BitOr", b"ops::BitOr", b"BitXor", b"ops::BitXor", b"Shl",
    b"ops::Shl", b"Shr", b"ops::Shr", b"AddAssign", b"ops::AddAssign", b"SubAssign",
    b"ops::SubAssign", b"MulAssign", b"ops::MulAssign", b"DivAssign", b"ops::DivAssign",
    b"RemAssign", b"ops::RemAssign", b"BitAndAssign", b"ops::BitAndAssign", b"BitOrAssign",
    b"ops::BitOrAssign", b"BitXorAssign", b"ops::BitXorAssign", b"ShlAssign", b"ops::ShlAssign",
    b"ShrAssign", b"ops::ShrAssign",
    // the derivable and the conversions
    b"Clone", b"clone::Clone", b"Copy", b"marker::Copy", b"Eq", b"cmp::Eq", b"PartialEq",
    b"cmp::PartialEq", b"Ord", b"cmp::Ord", b"PartialOrd", b"cmp::PartialOrd", b"Ordering",
    b"cmp::Ordering", b"Hash", b"hash::Hash", b"Hasher", b"hash::Hasher", b"Default",
    b"default::Default", b"From", b"convert::From", b"Into", b"convert::Into", b"TryFrom",
    b"convert::TryFrom",
    // formatting (F16)
    b"Display", b"fmt::Display", b"Debug", b"fmt::Debug", b"Formatter", b"fmt::Formatter",
    // (0.27.2.1: the spec traits, F16.5)
    b"LowerHex", b"fmt::LowerHex", b"UpperHex", b"fmt::UpperHex", b"Octal", b"fmt::Octal",
    b"Binary", b"fmt::Binary", b"LowerExp", b"fmt::LowerExp", b"UpperExp", b"fmt::UpperExp",
    b"Pointer", b"fmt::Pointer",
    // the rest
    b"Vec", b"vec::Vec", b"String", b"string::String", b"NonNull", b"ptr::NonNull", b"PhantomData",
    b"marker::PhantomData", b"UnsafeCell", b"cell::UnsafeCell", b"Cell", b"cell::Cell",
];
