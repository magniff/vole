// Macro expansion: the next macro-expanded token, the arguments of a
// function-like macro, substitution with `#` and `##`, and the expansion
// of a token list on its own (macro arguments, `#if` lines).

use crate::base::{
    BUFS, IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, intern, sym_name,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::ctx::CImportCx;
use crate::front::cpp::{
    c_error2, ctok_copy, ctok_is, ctok_text, hs_add, hs_has, hs_inter, hs_union, macro_of,
    macro_param_index, macro_tok,
};
use crate::front::cpp::CK::{Char, Ident, Num, Punct, Str};
use crate::front::cpp::input::{c_lex, push_back, push_list, raw_next};

// ---- Expansion ----

// The next macro-expanded token.
pub fn cpp_next(ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        loop {
            let t = raw_next(&ccx, &pcx);
            if pcx.ctoks[t].kind != Ident {
                return t;
            }
            let sym = pcx.ctoks[t].text;
            if hs_has(pcx.ctoks[t].hide, sym, ccx) {
                return t;
            }
            if sym == ccx.s_pragma_op {
                // _Pragma("...") is dropped.
                let open = raw_next(&ccx, &pcx);
                if !ctok_is(open, pcx.s_lparen, pcx) {
                    push_back(open, &ccx);
                    return t;
                }
                var depth = 1;
                while depth > 0 {
                    let x = raw_next(&ccx, &pcx);
                    if x == pcx.c_eof {
                        break;
                    }
                    if ctok_is(x, pcx.s_lparen, pcx) {
                        depth += 1;
                    } else if ctok_is(x, pcx.s_rparen, pcx) {
                        depth -= 1;
                    }
                }
                continue;
            }
            if sym == ccx.s_line || sym == ccx.s_counter || sym == ccx.s_file {
                let n = ctok_copy(t, &ccx, &pcx);
                if sym == ccx.s_file {
                    pcx.ctoks[n].kind = Str;
                    let b = buf_new();
                    buf_byte(b, '"');
                    if pcx.ctoks[t].file >= 0 {
                        buf_str(b, pcx.cfiles[pcx.ctoks[t].file].path);
                    }
                    buf_byte(b, '"');
                    pcx.ctoks[n].text = intern(buf_slice(b));
                } else {
                    pcx.ctoks[n].kind = Num;
                    let b = buf_new();
                    if sym == ccx.s_line {
                        buf_int(b, pcx.ctoks[t].line);
                    } else {
                        buf_int(b, ccx.cpp_counter);
                        ccx.cpp_counter += 1;
                    }
                    pcx.ctoks[n].text = intern(buf_slice(b));
                }
                return n;
            }
            let m = macro_of(sym, ccx);
            if m < 0 {
                return t;
            }
            if !pcx.macros[m].func {
                var out = subst(m, 0 as *i64, 0, &ccx, &pcx);
                finish_expansion(&out, t, hs_add(pcx.ctoks[t].hide, sym, &ccx), &ccx, &pcx);
                continue;
            }
            let next = raw_next(&ccx, &pcx);
            if !ctok_is(next, pcx.s_lparen, pcx) {
                push_back(next, &ccx);
                return t;
            }
            var args = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            let rparen = collect_args(m, t, &args, &ccx, &pcx);
            var out = subst(m, args.data, args.count, &ccx, &pcx);
            finish_expansion(&out, t,
                hs_add(hs_inter(pcx.ctoks[t].hide, pcx.ctoks[rparen].hide, &ccx), sym, &ccx), &ccx,
                &pcx);
        }
    }
}

// Gives the expansion of the macro named by `t` its hide set and t's
// leading space, and makes it the next input.
fn finish_expansion(out: inout IntVec, t: i64, hide: i64, ccx: inout CImportCx<Comp>,
    pcx: inout Ctx<Comp>) {
    unsafe {
        for i in 0..out.count {
            let n = ctok_copy(out.data[i], &ccx, &pcx);
            pcx.ctoks[n].hide = hs_union(pcx.ctoks[n].hide, hide, &ccx);
            if i == 0 {
                pcx.ctoks[n].space = pcx.ctoks[t].space;
            }
            out.data[i] = n;
        }
        push_list(out, &ccx);
    }
}

// The arguments of a call of function-like macro m (after its `(`):
// `args` gets, per argument, the start of its tokens in CINTS and their
// count. Returns the closing parenthesis.
fn collect_args(m: i64, name: i64, args: inout IntVec, ccx: inout CImportCx<Comp>,
    pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        var depth = 0;
        var pieces = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var toks = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var arg_start = 0;
        var rparen = 0;
        loop {
            let t = raw_next(&ccx, &pcx);
            if t == pcx.c_eof {
                c_error2(name, c"unterminated call of macro ", ctok_text(name, pcx), &pcx);
            }
            if ctok_is(t, pcx.s_lparen, pcx) {
                depth += 1;
            } else if ctok_is(t, pcx.s_rparen, pcx) {
                if depth == 0 {
                    rparen = t;
                    break;
                }
                depth -= 1;
            } else if depth == 0 && ctok_is(t, ccx.s_comma, pcx) && pcx.ctoks[t].kind == Punct {
                let in_va = pcx.macros[m].variadic
                    && pieces.count / 2 == pcx.macros[m].param_count - 1;
                if !in_va {
                    pieces.push(arg_start);
                    pieces.push(toks.count - arg_start);
                    arg_start = toks.count;
                    continue;
                }
            }
            toks.push(t);
        }
        pieces.push(arg_start);
        pieces.push(toks.count - arg_start);
        var given = pieces.count / 2;
        // `f()` passes one empty argument; it is no argument for a macro
        // without parameters.
        if given == 1 && pcx.macros[m].param_count == 0 && toks.count == 0 {
            given = 0;
        }
        if given < pcx.macros[m].param_count && pcx.macros[m].variadic
            && given == pcx.macros[m].param_count - 1 {
            pieces.push(toks.count);
            pieces.push(0);
            given += 1;
        }
        if given != pcx.macros[m].param_count {
            c_error2(name, c"wrong number of arguments in call of macro ", ctok_text(name, pcx),
                &pcx);
        }
        for i in 0..given {
            let start = pcx.cints.count;
            for k in 0..pieces.data[2 * i + 1] {
                pcx.cints.push(toks.data[pieces.data[2 * i] + k]);
            }
            args.push(start);
            args.push(pieces.data[2 * i + 1]);
        }
        rparen
    }
}

// The tokens of list (start, count) in CINTS, macro-expanded on their own.
pub fn expand_list(start: i64, count: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> IntVec {
    let saved_pending = ccx.cpp_pending;
    let saved_mode = ccx.cpp_list_mode;
    ccx.cpp_pending = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    ccx.cpp_list_mode = true;
    var i = count - 1;
    while i >= 0 {
        unsafe { ccx.cpp_pending.push(pcx.cints.data[start + i]); }
        i -= 1;
    }
    var out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
    loop {
        let t = cpp_next(&ccx, &pcx);
        if t == pcx.c_eof {
            break;
        }
        out.push(t);
    }
    ccx.cpp_pending = saved_pending;
    ccx.cpp_list_mode = saved_mode;
    out
}

// The replacement of macro m, its parameters replaced by the arguments
// (`args`: start and count of each in CINTS), with # and ## applied.
fn subst(m: i64, args: *i64, nargs: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> IntVec {
    unsafe {
        var out = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        let n = pcx.macros[m].body_count;
        var i = 0;
        while i < n {
            let t = macro_tok(m, i, pcx);
            let next = if i + 1 < n { macro_tok(m, i + 1, pcx) } else { -1 };
            // # param: the argument as a string.
            if pcx.macros[m].func && ctok_is(t, ccx.s_hash, pcx) && next >= 0 {
                let p = macro_param_index(m, pcx.ctoks[next].text, pcx);
                if p >= 0 {
                    out.push(stringize(args[2 * p], args[2 * p + 1], t, &ccx, &pcx));
                    i += 2;
                    continue;
                }
            }
            // x ## y
            if ctok_is(t, ccx.s_hashhash, pcx) && next >= 0 {
                let p = macro_param_index(m, pcx.ctoks[next].text, pcx);
                if p >= 0 {
                    let start = args[2 * p];
                    let count = args[2 * p + 1];
                    // GNU: `, ## __VA_ARGS__` drops the comma when there are
                    // no variable arguments, and pastes nothing otherwise.
                    if out.count > 0 && ctok_is(out.data[out.count - 1], ccx.s_comma, pcx)
                        && pcx.ctoks[next].text == ccx.s_va_args {
                        if count == 0 {
                            out.pop();
                        } else {
                            for k in 0..count {
                                out.push(pcx.cints.data[start + k]);
                            }
                        }
                        i += 2;
                        continue;
                    }
                    if count > 0 {
                        if out.count > 0 {
                            out.data[out.count - 1] = paste(out.data[out.count - 1],
                                pcx.cints.data[start], &ccx, &pcx);
                        } else {
                            out.push(pcx.cints.data[start]);
                        }
                        for k in 1..count {
                            out.push(pcx.cints.data[start + k]);
                        }
                    }
                    i += 2;
                    continue;
                }
                if out.count > 0 {
                    out.data[out.count - 1] = paste(out.data[out.count - 1], next, &ccx, &pcx);
                } else {
                    out.push(next);
                }
                i += 2;
                continue;
            }
            let p = if pcx.ctoks[t].kind == Ident { macro_param_index(m, pcx.ctoks[t].text, pcx) }
                else { -1 };
            if p >= 0 {
                let start = args[2 * p];
                let count = args[2 * p + 1];
                if next >= 0 && ctok_is(next, ccx.s_hashhash, pcx) {
                    // The operand of ## is not expanded; an empty one leaves
                    // the other operand.
                    if count == 0 {
                        let after = if i + 2 < n { macro_tok(m, i + 2, pcx) } else { -1 };
                        let q = if after >= 0
                            && pcx.ctoks[after].kind
                            == Ident { macro_param_index(m, pcx.ctoks[after].text, pcx) }
                            else { -1 };
                        if q >= 0 {
                            for k in 0..args[2 * q + 1] {
                                out.push(pcx.cints.data[args[2 * q] + k]);
                            }
                            i += 3;
                        } else {
                            i += 2;
                        }
                        continue;
                    }
                    for k in 0..count {
                        out.push(pcx.cints.data[start + k]);
                    }
                    i += 1;
                    continue;
                }
                let expanded = expand_list(start, count, &ccx, &pcx);
                for k in 0..expanded.count {
                    let x = ctok_copy(expanded.data[k], &ccx, &pcx);
                    if k == 0 {
                        pcx.ctoks[x].space = pcx.ctoks[t].space;
                    }
                    out.push(x);
                }
                i += 1;
                continue;
            }
            out.push(t);
            i += 1;
        }
        out
    }
}

fn stringize(start: i64, count: i64, at: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let b = buf_new();
        buf_byte(b, '"');
        for k in 0..count {
            let t = pcx.cints.data[start + k];
            if k > 0 && pcx.ctoks[t].space {
                buf_byte(b, ' ');
            }
            let text = sym_text(pcx.ctoks[t].text);
            let quoted = pcx.ctoks[t].kind == Str || pcx.ctoks[t].kind == Char;
            for j in 0..text.len {
                let c = text[j];
                if quoted && (c == '"' || c == '\\') {
                    buf_byte(b, '\\');
                }
                buf_byte(b, c);
            }
        }
        buf_byte(b, '"');
        let n = ctok_copy(at, &ccx, &pcx);
        pcx.ctoks[n].kind = Str;
        pcx.ctoks[n].text = intern(buf_slice(b));
        n
    }
}

// The token spelled by a's text followed by b's (a's position).
fn paste(a: i64, b: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let buf = buf_new();
        buf_bytes(buf, sym_text(pcx.ctoks[a].text));
        buf_bytes(buf, sym_text(pcx.ctoks[b].text));
        let first = c_lex(BUFS[buf].data, BUFS[buf].len, pcx.ctoks[a].file, pcx.ctoks[a].line, &ccx,
            &pcx);
        if pcx.ctok_count - first != 1 {
            c_error2(a, c"pasting does not give one token: ", sym_name(intern(buf_slice(buf))),
                &pcx);
        }
        pcx.ctoks[first].space = pcx.ctoks[a].space;
        pcx.ctoks[first].bol = false;
        pcx.ctoks[first].hide = pcx.ctoks[a].hide;
        first
    }
}
