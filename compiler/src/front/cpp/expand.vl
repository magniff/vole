// Macro expansion: the next macro-expanded token, the arguments of a
// function-like macro, substitution with `#` and `##`, and the expansion
// of a token list on its own (macro arguments, `#if` lines).

use crate::base::{
    IntVec, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, get_bufs, intern, sym_name,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::ctx::CImportCx;
use crate::front::cpp::{
    c_error2, ctok_copy, ctok_is, ctok_text, hs_add, hs_has, hs_inter, hs_union, macro_of,
    macro_param_index, macro_tok,
};
use crate::front::cpp::CK::{Char, Ident, Num, Punct, Str};
use crate::front::cpp::input::{c_lex, push_back, push_list, raw_next};

// ---- Expansion ----

// The next macro-expanded token.
pub fn cpp_next(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        loop {
            let t = raw_next(ccx, pcx);
            if (*pcx.ctoks.add(t as usize)).kind != Ident {
                return t;
            }
            let sym = (*pcx.ctoks.add(t as usize)).text;
            if hs_has((*pcx.ctoks.add(t as usize)).hide, sym, ccx) {
                return t;
            }
            if sym == ccx.s_pragma_op {
                // _Pragma("...") is dropped.
                let open = raw_next(ccx, pcx);
                if !ctok_is(open, pcx.s_lparen, pcx) {
                    push_back(open, ccx);
                    return t;
                }
                let mut depth: i64 = 1;
                while depth > 0 {
                    let x = raw_next(ccx, pcx);
                    if x == pcx.c_eof {
                        break;
                    }
                    if ctok_is(x, pcx.s_lparen, pcx) {
                        depth += 1;
                    } else if ctok_is(x, pcx.s_rparen, pcx) {
                        depth -= 1;
                    }
                }
                continue;
            }
            if sym == ccx.s_line || sym == ccx.s_counter || sym == ccx.s_file {
                let n = ctok_copy(t, ccx, pcx);
                if sym == ccx.s_file {
                    (*pcx.ctoks.add(n as usize)).kind = Str;
                    let b = buf_new();
                    buf_byte(b, b'"');
                    if (*pcx.ctoks.add(t as usize)).file >= 0 {
                        buf_str(b, pcx.cfiles[(*pcx.ctoks.add(t as usize)).file as usize].path);
                    }
                    buf_byte(b, b'"');
                    (*pcx.ctoks.add(n as usize)).text = intern(buf_slice(b), pcx);
                } else {
                    (*pcx.ctoks.add(n as usize)).kind = Num;
                    let b = buf_new();
                    if sym == ccx.s_line {
                        buf_int(b, (*pcx.ctoks.add(t as usize)).line);
                    } else {
                        buf_int(b, ccx.cpp_counter);
                        ccx.cpp_counter += 1;
                    }
                    (*pcx.ctoks.add(n as usize)).text = intern(buf_slice(b), pcx);
                }
                return n;
            }
            let m = macro_of(sym, ccx);
            if m < 0 {
                return t;
            }
            if !(*pcx.macros.add(m as usize)).func {
                let mut out = subst(m, 0 as *mut i64, 0, ccx, pcx);
                finish_expansion(&mut out, t, hs_add((*pcx.ctoks.add(t as usize)).hide, sym, ccx),
                    ccx, pcx);
                continue;
            }
            let next = raw_next(ccx, pcx);
            if !ctok_is(next, pcx.s_lparen, pcx) {
                push_back(next, ccx);
                return t;
            }
            let mut args = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
            let rparen = collect_args(m, t, &mut args, ccx, pcx);
            let mut out = subst(m, args.data, args.len() as i64, ccx, pcx);
            finish_expansion(&mut out, t,
                hs_add(hs_inter((*pcx.ctoks.add(t as usize)).hide,
                    (*pcx.ctoks.add(rparen as usize)).hide, ccx), sym, ccx), ccx,
                pcx);
        }
    }
}

// Gives the expansion of the macro named by `t` its hide set and t's
// leading space, and makes it the next input.
fn finish_expansion(out: &mut IntVec, t: i64, hide: i64, ccx: &mut CImportCx<Comp>,
    pcx: &mut Ctx<Comp>) {
    unsafe {
        for i in 0..out.len() as i64 {
            let n = ctok_copy((out[i as usize]), ccx, pcx);
            (*pcx.ctoks.add(n as usize)).hide = hs_union((*pcx.ctoks.add(n as usize)).hide, hide,
                ccx);
            if i == 0 {
                (*pcx.ctoks.add(n as usize)).space = (*pcx.ctoks.add(t as usize)).space;
            }
            (out[i as usize]) = n;
        }
        push_list(*out, ccx);
    }
}

// The arguments of a call of function-like macro m (after its `(`):
// `args` gets, per argument, the start of its tokens in CINTS and their
// count. Returns the closing parenthesis.
fn collect_args(m: i64, name: i64, args: &mut IntVec, ccx: &mut CImportCx<Comp>,
    pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let mut depth: i64 = 0;
        let mut pieces = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut toks = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let mut arg_start: i64 = 0;
        let mut rparen: i64 = 0;
        loop {
            let t = raw_next(ccx, pcx);
            if t == pcx.c_eof {
                c_error2(name, c"unterminated call of macro ", ctok_text(name, pcx), pcx);
            }
            if ctok_is(t, pcx.s_lparen, pcx) {
                depth += 1;
            } else if ctok_is(t, pcx.s_rparen, pcx) {
                if depth == 0 {
                    rparen = t;
                    break;
                }
                depth -= 1;
            }
            else if depth == 0 && ctok_is(t, ccx.s_comma, pcx)
                && (*pcx.ctoks.add(t as usize)).kind == Punct {
                let in_va = (*pcx.macros.add(m as usize)).variadic
                    && pieces.len() as i64 / 2 == (*pcx.macros.add(m as usize)).param_count - 1;
                if !in_va {
                    pieces.push(arg_start);
                    pieces.push(toks.len() as i64 - arg_start);
                    arg_start = toks.len() as i64;
                    continue;
                }
            }
            toks.push(t);
        }
        pieces.push(arg_start);
        pieces.push(toks.len() as i64 - arg_start);
        let mut given = pieces.len() as i64 / 2;
        // `f()` passes one empty argument; it is no argument for a macro
        // without parameters.
        if given == 1 && (*pcx.macros.add(m as usize)).param_count == 0 && toks.len() as i64 == 0 {
            given = 0;
        }
        if given < (*pcx.macros.add(m as usize)).param_count
            && (*pcx.macros.add(m as usize)).variadic
            && given == (*pcx.macros.add(m as usize)).param_count - 1 {
            pieces.push(toks.len() as i64);
            pieces.push(0);
            given += 1;
        }
        if given != (*pcx.macros.add(m as usize)).param_count {
            c_error2(name, c"wrong number of arguments in call of macro ", ctok_text(name, pcx),
                pcx);
        }
        for i in 0..given {
            let start = pcx.cints.len() as i64;
            for k in 0..(pieces[(2 * i + 1) as usize]) {
                pcx.cints.push(
                    (toks[((pieces[(2 * i) as usize]) + k) as usize]));
            }
            args.push(start);
            args.push((pieces[(2 * i + 1) as usize]));
        }
        rparen
    }
}

// The tokens of list (start, count) in CINTS, macro-expanded on their own.
pub fn expand_list(start: i64, count: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> IntVec {
    let saved_pending = ccx.cpp_pending;
    let saved_mode = ccx.cpp_list_mode;
    ccx.cpp_pending = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    ccx.cpp_list_mode = true;
    let mut i = count - 1;
    while i >= 0 {
        ccx.cpp_pending.push((pcx.cints[(start + i) as usize]));
        i -= 1;
    }
    let mut out = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
    loop {
        let t = cpp_next(ccx, pcx);
        if t == pcx.c_eof {
            break;
        }
        out.push(t);
    }
    ccx.cpp_pending = saved_pending;
    ccx.cpp_list_mode = saved_mode;
    out
}

// The replacement of macro m, its parameters replaced by the arguments
// (`args`: start and count of each in CINTS), with # and ## applied.
fn subst(m: i64, args: *mut i64, nargs: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> IntVec {
    unsafe {
        let mut out = IntVec { data: 0 as *mut i64, count: 0, cap: 0 };
        let n = (*pcx.macros.add(m as usize)).body_count;
        let mut i: i64 = 0;
        while i < n {
            let t = macro_tok(m, i, pcx);
            let next: i64 = if i + 1 < n { macro_tok(m, i + 1, pcx) } else { -1 };
            // # param: the argument as a string.
            if (*pcx.macros.add(m as usize)).func && ctok_is(t, ccx.s_hash, pcx) && next >= 0 {
                let p = macro_param_index(m, (*pcx.ctoks.add(next as usize)).text, pcx);
                if p >= 0 {
                    out.push(stringize((*args.add((2 * p) as usize)),
                        (*args.add((2 * p + 1) as usize)), t, ccx, pcx));
                    i += 2;
                    continue;
                }
            }
            // x ## y
            if ctok_is(t, ccx.s_hashhash, pcx) && next >= 0 {
                let p = macro_param_index(m, (*pcx.ctoks.add(next as usize)).text, pcx);
                if p >= 0 {
                    let start = (*args.add((2 * p) as usize));
                    let count = (*args.add((2 * p + 1) as usize));
                    // GNU: `, ## __VA_ARGS__` drops the comma when there are
                    // no variable arguments, and pastes nothing otherwise.
                    if out.len() as i64 > 0
                        && ctok_is((out[(out.len() as i64 - 1) as usize]), ccx.s_comma, pcx)
                        && (*pcx.ctoks.add(next as usize)).text == ccx.s_va_args {
                        if count == 0 {
                            out.pop();
                        } else {
                            for k in 0..count {
                                out.push((pcx.cints[(start + k) as usize]));
                            }
                        }
                        i += 2;
                        continue;
                    }
                    if count > 0 {
                        if out.len() as i64 > 0 {
                            (out[(out.len() as i64 - 1) as usize]) = paste(
                                (out[(out.len() as i64 - 1) as usize]),
                                (pcx.cints[start as usize]), ccx, pcx);
                        } else {
                            out.push((pcx.cints[start as usize]));
                        }
                        for k in 1..count {
                            out.push((pcx.cints[(start + k) as usize]));
                        }
                    }
                    i += 2;
                    continue;
                }
                if out.len() as i64 > 0 {
                    (out[(out.len() as i64 - 1) as usize]) = paste(
                        (out[(out.len() as i64 - 1) as usize]), next, ccx, pcx);
                } else {
                    out.push(next);
                }
                i += 2;
                continue;
            }
            let p: i64 = if (*pcx.ctoks.add(t as usize)).kind
                == Ident { macro_param_index(m, (*pcx.ctoks.add(t as usize)).text, pcx) }
                else { -1 };
            if p >= 0 {
                let start = (*args.add((2 * p) as usize));
                let count = (*args.add((2 * p + 1) as usize));
                if next >= 0 && ctok_is(next, ccx.s_hashhash, pcx) {
                    // The operand of ## is not expanded; an empty one leaves
                    // the other operand.
                    if count == 0 {
                        let after: i64 = if i + 2 < n { macro_tok(m, i + 2, pcx) } else { -1 };
                        let q: i64 = if after >= 0
                            && (*pcx.ctoks.add(after as usize)).kind
                            == Ident {
                            macro_param_index(m, (*pcx.ctoks.add(after as usize)).text, pcx)
                        }
                            else { -1 };
                        if q >= 0 {
                            for k in 0..(*args.add((2 * q + 1) as usize)) {
                                out.push(
                                    (pcx.cints[((*args.add((2 * q) as usize)) + k) as usize]));
                            }
                            i += 3;
                        } else {
                            i += 2;
                        }
                        continue;
                    }
                    for k in 0..count {
                        out.push((pcx.cints[(start + k) as usize]));
                    }
                    i += 1;
                    continue;
                }
                let expanded = expand_list(start, count, ccx, pcx);
                for k in 0..expanded.len() as i64 {
                    let x = ctok_copy((expanded[k as usize]), ccx, pcx);
                    if k == 0 {
                        (*pcx.ctoks.add(x as usize)).space = (*pcx.ctoks.add(t as usize)).space;
                    }
                    out.push(x);
                }
                i += 1;
                continue;
            }
            out.push(t);
            i += 1;
        }
        out
    }
}

fn stringize(start: i64, count: i64, at: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let b = buf_new();
        buf_byte(b, b'"');
        for k in 0..count {
            let t = (pcx.cints[(start + k) as usize]);
            if k > 0 && (*pcx.ctoks.add(t as usize)).space {
                buf_byte(b, b' ');
            }
            let text = sym_text((*pcx.ctoks.add(t as usize)).text, pcx);
            let quoted = (*pcx.ctoks.add(t as usize)).kind == Str
                || (*pcx.ctoks.add(t as usize)).kind == Char;
            for j in 0..text.len() {
                let c = text[j];
                if quoted && (c == b'"' || c == b'\\') {
                    buf_byte(b, b'\\');
                }
                buf_byte(b, c);
            }
        }
        buf_byte(b, b'"');
        let n = ctok_copy(at, ccx, pcx);
        (*pcx.ctoks.add(n as usize)).kind = Str;
        (*pcx.ctoks.add(n as usize)).text = intern(buf_slice(b), pcx);
        n
    }
}

// The token spelled by a's text followed by b's (a's position).
fn paste(a: i64, b: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    unsafe {
        let buf = buf_new();
        buf_bytes(buf, sym_text((*pcx.ctoks.add(a as usize)).text, pcx));
        buf_bytes(buf, sym_text((*pcx.ctoks.add(b as usize)).text, pcx));
        let first = c_lex((*get_bufs().add(buf as usize)).data, (*get_bufs().add(buf as usize)).len,
            (*pcx.ctoks.add(a as usize)).file, (*pcx.ctoks.add(a as usize)).line, ccx, pcx);
        if pcx.ctok_count - first != 1 {
            c_error2(a, c"pasting does not give one token: ",
                sym_name(intern(buf_slice(buf), pcx), pcx), pcx);
        }
        (*pcx.ctoks.add(first as usize)).space = (*pcx.ctoks.add(a as usize)).space;
        (*pcx.ctoks.add(first as usize)).bol = false;
        (*pcx.ctoks.add(first as usize)).hide = (*pcx.ctoks.add(a as usize)).hide;
        first
    }
}
