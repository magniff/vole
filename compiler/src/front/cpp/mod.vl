// C import (1/2): the C preprocessor, for `import "header.h" as c;`.
//
// Headers are read as the target's C compiler reads them: its predefined
// macros and its include search path are asked from the compiler itself
// (`cc -dM -E -v`, see cpp_query_compiler), so a header means to vole
// what it means to C on this machine. The preprocessor follows C11 6.10
// with the GNU extensions system headers rely on: `#include_next`,
// `, ## __VA_ARGS__`, `__has_include`, `#pragma once`. Macro expansion
// uses hide sets (Prosser's algorithm): every token carries the set of
// macros whose expansion produced it, and a macro is not expanded again
// inside its own expansion.
//
// The output is one stream of tokens for the declarations of all the
// imported headers, read by cimport.vl.
//
// This file: C tokens, hide sets, errors in C code, the macro table and
// the well-known symbols; the parts: input (the lexer, include frames),
// expand (macro expansion), directives (`#define`, `#include`, `#if`,
// `#pragma`), eval (constant expressions) and cc (the settings asked
// from the C compiler).

pub mod cc;
pub mod eval;
pub mod directives;
pub mod expand;
pub mod input;

use crate::base::{IntVec, buf_byte, buf_fmt, buf_new, buf_ptr, buf_str, cstr, intern_c, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_end_text, error_at};
use crate::front::cimport::ctx::CImportCx;

use CK::{Char, Eof, Ident, Num, Punct, Str};

// UNSAFE: C's number conversions, for the C preprocessor's and importer's constants: C's own
// rules for a C literal (strtoull's bases, strtof's rounding, snprintf's %g) are what a
// header's value means.
// SAFETY: each declaration is the function's C prototype on the targets vole builds for (64-bit
// macOS and Linux: int is i32, size_t u64, long and long long i64, a pointer 8 bytes); snprintf
// is variadic and takes what its format names; what a call must hold (NUL-terminated input,
// room in the output) is said at the call.
pub extern "C" {
    fn snprintf(buf: *mut u8, size: u64, format: *mut u8, ...) -> i32;
    fn strtoull(s: *mut u8, end: *mut *mut u8, base: i32) -> u64;
    fn strtof(s: *mut u8, end: *mut *mut u8) -> f32;
}

// ---- Tokens ----

#[derive(Clone, Copy, PartialEq, Eq)] pub enum CK { Eof, Ident, Num, Char, Str, Punct }

// `text` is the token's spelling, interned; `space`: whitespace before it;
// `bol`: first on its line; `hide`: its hide set (HS).
#[derive(Clone, Copy)] pub struct CTok {
    pub kind: CK, space: bool, bol: bool, pub text: i64, file: i64, line: i64, hide: i64,
}

fn ctok_new(kind: CK, text: i64, file: i64, line: i64, space: bool, bol: bool,
    ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let t = pcx.ctoks.len() as i64;
    pcx.ctoks.push(CTok { kind, space, bol, text, file, line, hide: 0 });
    t
}

pub fn ctok_copy(t: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let n = ctok_new((pcx.ctoks[t as usize]).kind, (pcx.ctoks[t as usize]).text,
        (pcx.ctoks[t as usize]).file, (pcx.ctoks[t as usize]).line,
        (pcx.ctoks[t as usize]).space, bol: false, ccx: ccx, pcx: pcx);
    (pcx.ctoks[n as usize]).hide = (pcx.ctoks[t as usize]).hide;
    n
}

pub fn ctok_is(t: i64, sym: i64, pcx: &Ctx<Comp>) -> bool {
    (pcx.ctoks[t as usize]).text == sym && (pcx.ctoks[t as usize]).kind != Str
        && (pcx.ctoks[t as usize]).kind != Char
}

pub fn ctok_text(t: i64, pcx: &Ctx<Comp>) -> *mut u8 {
    sym_name((pcx.ctoks[t as usize]).text, pcx)
}

// ---- Hide sets: linked lists of macro names, 0 the empty set ----

#[derive(Clone, Copy)] pub struct HsNode { sym: i64, next: i64 }

fn hs_cons(sym: i64, next: i64, ccx: &mut CImportCx<Comp>) -> i64 {
    ccx.hs.push(HsNode { sym, next });
    ccx.hs.len() as i64 - 1
}

fn hs_has(h: i64, sym: i64, ccx: &CImportCx<Comp>) -> bool {
    let mut p = h;
    while p != 0 {
        if ccx.hs[p as usize].sym == sym {
            return true;
        }
        p = ccx.hs[p as usize].next;
    }
    false
}

fn hs_add(h: i64, sym: i64, ccx: &mut CImportCx<Comp>) -> i64 {
    if hs_has(h, sym, ccx) { h } else { hs_cons(sym, h, ccx) }
}

fn hs_union(a: i64, b: i64, ccx: &mut CImportCx<Comp>) -> i64 {
    let mut r = b;
    let mut p = a;
    while p != 0 {
        r = hs_add(r, ccx.hs[p as usize].sym, ccx);
        p = ccx.hs[p as usize].next;
    }
    r
}

fn hs_inter(a: i64, b: i64, ccx: &mut CImportCx<Comp>) -> i64 {
    let mut r: i64 = 0;
    let mut p = a;
    while p != 0 {
        if hs_has(b, ccx.hs[p as usize].sym, ccx) {
            r = hs_cons(ccx.hs[p as usize].sym, r, ccx);
        }
        p = ccx.hs[p as usize].next;
    }
    r
}

// ---- Errors in C code ----

fn c_error(t: i64, message: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    // An error in the list of imports: at the `import` item.
    if t > 0 && (pcx.ctoks[t as usize]).file == pcx.c_import_file
        && (pcx.ctoks[t as usize]).line - 1 < pcx.c_import_pos.len() as i64 {
        pcx.err_kind = c"C import";
        error_at((pcx.c_import_pos[((pcx.ctoks[t as usize]).line - 1) as usize]),
            message, pcx);
    }
    let out = buf_new();
    buf_fmt(out, format_args("error[C import]: {}", str::from_utf8(cstr(message)).unwrap()));
    if t > 0 && (pcx.ctoks[t as usize]).file >= 0 {
        buf_fmt(out,
            format_args("\n --> {}: line {}",
                str::from_utf8(
                    cstr(pcx.cfiles[(pcx.ctoks[t as usize]).file as usize].path)).unwrap(),
                (pcx.ctoks[t as usize]).line));
    }
    buf_byte(out, b'\n');
    // (reported with the program's errors, at its first `import`)
    err_end_text(if pcx.c_import_pos.len() as i64 > 0 { (pcx.c_import_pos[0]) } else { 0 },
        out, pcx)
}

fn c_error2(t: i64, message: *mut u8, detail: *mut u8, pcx: &mut Ctx<Comp>) -> ! {
    let b = buf_new();
    buf_str(b, message);
    buf_str(b, detail);
    buf_byte(b, 0);
    c_error(t, buf_ptr(b), pcx)
}

// ---- Where the declarations are (0.25.2, for the language server) ----

// What a place is of (the key's kind; the index: a symbol for a function,
// a variable or a typedef; the table's index for the others).
pub const ORIGIN_FUNC: i64 = 1;
pub const ORIGIN_VAR: i64 = 2;
pub const ORIGIN_TYPEDEF: i64 = 3;
pub const ORIGIN_RECORD: i64 = 4;
pub const ORIGIN_ENUM: i64 = 5;
pub const ORIGIN_ENUMERATOR: i64 = 6;
pub const ORIGIN_FIELD: i64 = 7;
pub const ORIGIN_MACRO: i64 = 8;

// Notes where declaration (kind, index) is: the first place stays, unless
// `replace` (a struct's definition after its declaration).
pub fn origin_note(kind: i64, index: i64, tok: i64, first: i64, last: i64, replace: bool,
    ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if !pcx.c_keep_origins || index < 0 {
        return;
    }
    let key = index * 16 + kind;
    let o = ccx.origin_of.get(key + 1) - 1;
    if o >= 0 && !replace {
        return;
    }
    if o >= 0 {
        pcx.c_origins[(o * 3) as usize] = tok;
        pcx.c_origins[(o * 3 + 1) as usize] = first;
        pcx.c_origins[(o * 3 + 2) as usize] = last;
        return;
    }
    ccx.origin_of.put(key + 1, pcx.c_origins.len() as i64 / 3 + 1);
    pcx.c_origins.push(tok);
    pcx.c_origins.push(first);
    pcx.c_origins.push(last);
}

// The place of declaration (kind, index), or -1.
pub fn origin_of(kind: i64, index: i64, ccx: &CImportCx<Comp>) -> i64 {
    if index < 0 { -1 } else { ccx.origin_of.get(index * 16 + kind + 1) - 1 }
}

// Token t's file (-1: none, or no such token), line, text (a symbol),
// and whether a macro's expansion made it (its hide set is not empty).
pub fn ctok_place(t: i64, pcx: &Ctx<Comp>) -> (i64, i64, i64, bool) {
    if t < 0 || t >= pcx.ctoks.len() as i64 {
        return (-1, 0, -1, false);
    }
    let tok = (pcx.ctoks[t as usize]);
    (tok.file, tok.line, tok.text, tok.hide != 0)
}

// Token t's line (0: no such token).
pub fn ctok_line(t: i64, pcx: &Ctx<Comp>) -> i64 {
    let (_, line, _, _) = ctok_place(t, pcx);
    line
}

// The places noted from origin `from` on that have no lines yet get the
// lines of tokens toks[start..end] (a declaration's) in their name's file,
// those not made by a macro's expansion.
pub fn origin_lines(from: i64, toks: IntVec, start: i64, end: i64, pcx: &mut Ctx<Comp>) {
    let mut o = from;
    while o * 3 < pcx.c_origins.len() as i64 {
        let tok = pcx.c_origins[(o * 3) as usize];
        if tok >= 0 && pcx.c_origins[(o * 3 + 1) as usize] == 0 {
            let (file, line, _, _) = ctok_place(tok, pcx);
            let mut first = line;
            let mut last = line;
            for k in start..end {
                let (f, l, _, expanded) = ctok_place(toks.get(k), pcx);
                if f == file && !expanded {
                    if l < first {
                        first = l;
                    }
                    if l > last {
                        last = l;
                    }
                }
            }
            pcx.c_origins[(o * 3 + 1) as usize] = first;
            pcx.c_origins[(o * 3 + 2) as usize] = last;
        }
        o += 1;
    }
}

// ---- Macros ----

// `params`, `body`: lists in CINTS (parameter symbols; token indices).
// `builtin`: predefined by the compiler (not imported as constants).
#[derive(Clone, Copy)] pub struct Macro {
    pub name: i64, pub func: bool, variadic: bool, pub builtin: bool,
    params: i64, param_count: i64, body: i64, pub body_count: i64,
}

pub fn macro_of(sym: i64, ccx: &CImportCx<Comp>) -> i64 {
    ccx.macro_of.get(sym + 1) - 1
}

fn macro_param(m: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    (pcx.cints[((pcx.macros[m as usize]).params + i) as usize])
}

pub fn macro_tok(m: i64, i: i64, pcx: &Ctx<Comp>) -> i64 {
    (pcx.cints[((pcx.macros[m as usize]).body + i) as usize])
}

// The index of `sym` among the parameters of macro m, or -1.
fn macro_param_index(m: i64, sym: i64, pcx: &Ctx<Comp>) -> i64 {
    if !(pcx.macros[m as usize]).func {
        return -1;
    }
    for i in 0..(pcx.macros[m as usize]).param_count {
        if macro_param(m, i, pcx) == sym {
            return i;
        }
    }
    -1
}

// ---- Well-known symbols ----

fn init_cpp_syms(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    ccx.s_hash = intern_c(c"#", pcx);
    ccx.s_hashhash = intern_c(c"##", pcx);
    pcx.s_lparen = intern_c(c"(", pcx);
    pcx.s_rparen = intern_c(c")", pcx);
    ccx.s_comma = intern_c(c",", pcx);
    ccx.s_ellipsis = intern_c(c"...", pcx);
    ccx.s_va_args = intern_c(c"__VA_ARGS__", pcx);
    ccx.s_defined = intern_c(c"defined", pcx);
    ccx.s_lt = intern_c(c"<", pcx);
    ccx.s_gt = intern_c(c">", pcx);
    ccx.s_pragma_op = intern_c(c"_Pragma", pcx);
    ccx.s_has_include = intern_c(c"__has_include", pcx);
    ccx.s_has_include_next = intern_c(c"__has_include_next", pcx);
    ccx.s_line = intern_c(c"__LINE__", pcx);
    ccx.s_file = intern_c(c"__FILE__", pcx);
    ccx.s_counter = intern_c(c"__COUNTER__", pcx);
    ccx.s_one = intern_c(c"1", pcx);
    ccx.s_zero = intern_c(c"0", pcx);
}

// Builtins that `#if` answers (and `defined` says are defined): every
// feature query is answered "no", so headers take their plainest path.
fn is_query_builtin(sym: i64, pcx: &mut Ctx<Comp>) -> bool {
    let names: [*mut u8; 14] = [c"__has_attribute", c"__has_cpp_attribute", c"__has_c_attribute",
        c"__has_builtin", c"__has_feature", c"__has_extension", c"__has_warning",
        c"__has_declspec_attribute", c"__building_module", c"__is_target_arch",
        c"__is_target_vendor", c"__is_target_os", c"__is_target_environment", c"__has_embed"];
    for i in 0..14 {
        if sym == intern_c(names[i as usize], pcx) {
            return true;
        }
    }
    false
}

// ---- Initialization ----

pub fn init_cpp(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    init_cpp_syms(ccx, pcx);
    // Token 0: "no token"; C_EOF: the end of the input.
    ctok_new(Eof, intern_c(c"", pcx), -1, 0, space: false, bol: false, ccx: ccx, pcx: pcx);
    pcx.c_eof = ctok_new(Eof, intern_c(c"", pcx), -1, 0, space: false, bol: true, ccx: ccx,
        pcx: pcx);
    // Hide set 0 is the empty set.
    hs_cons(-1, 0, ccx);
}
