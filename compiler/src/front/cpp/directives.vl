// Preprocessing directives: `#define` and `#undef`, conditional
// inclusion (`#if`, `#ifdef`, `#elif`, `#else`, `#endif`), `#include`
// and `#include_next` with the include search, `#pragma once` and
// `#pragma pack`.

use crate::base::{
    buf_byte, buf_bytes, buf_fmt, buf_int, buf_new, buf_ptr, c_first, c_tail, cstr, intern_buf,
    intern_c, overlay_of, streq, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::ctx::CImportCx;
use crate::front::cpp::{
    Macro, ORIGIN_MACRO, c_error, c_error2, c_ull, ctok_bytes, ctok_copy, ctok_is, ctok_line,
    ctok_place, ctok_text, is_query_builtin, macro_of, origin_note,
};
use crate::front::cpp::CK::{Ident, Num, Str};
use crate::front::cpp::eval::eval_tokens;
use crate::front::cpp::expand::expand_list;
use crate::front::cpp::input::{
    c_load_file, cur_frame, file_peek, file_tok, line_tokens, push_back, push_frame, skip_line,
};

const COND_TAKEN: i64 = 0;
const COND_SEARCH: i64 = 1;
const COND_DONE: i64 = 2;

// ---- Directives ----

pub fn directive(hash: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let t = file_peek(ccx, pcx);
    if t < 0 || (pcx.ctoks[t as usize]).bol {
        return;
    }
    file_tok(ccx, pcx);
    let name = ctok_text(t, pcx);
    if streq(name, c"define") {
        define_macro(ccx, pcx);
    } else if streq(name, c"undef") {
        let (start, count) = line_tokens(ccx, pcx);
        if count > 0 {
            ccx.macro_of.put(
                (pcx.ctoks[(pcx.cints[start as usize]) as usize]).text + 1, 0);
        }
    }
    else if streq(name, c"include") || streq(name, c"include_next") || streq(name, c"import") {
        include(t, streq(name, c"include_next"), ccx, pcx);
    } else if streq(name, c"if") {
        let (start, count) = line_tokens(ccx, pcx);
        begin_cond(eval_if(t, start, count, ccx, pcx), ccx, pcx);
    } else if streq(name, c"ifdef") || streq(name, c"ifndef") {
        let (start, count) = line_tokens(ccx, pcx);
        if count == 0 {
            c_error(t, c"#ifdef without a name", pcx);
        }
        let defined = is_defined(
            (pcx.ctoks[(pcx.cints[start as usize]) as usize]).text, ccx, pcx);
        begin_cond(defined == streq(name, c"ifdef"), ccx, pcx);
    }
    else if streq(name, c"elif") || streq(name, c"elifdef") || streq(name, c"elifndef")
        || streq(name, c"else") {
        // Reached in a taken branch: the rest of the #if is skipped.
        if ccx.cpp_conds.len() as i64 == (ccx.frame_cond[cur_frame(ccx) as usize]) {
            c_error(t, c"#else or #elif without #if", pcx);
        }
        skip_line(ccx, pcx);
        *ccx.cpp_conds.last_mut().unwrap() = COND_DONE;
        skip_branches(ccx, pcx);
    } else if streq(name, c"endif") {
        if ccx.cpp_conds.len() as i64 == (ccx.frame_cond[cur_frame(ccx) as usize]) {
            c_error(t, c"#endif without #if", pcx);
        }
        ccx.cpp_conds.pop().unwrap();
        skip_line(ccx, pcx);
    } else if streq(name, c"error") {
        let b = buf_new();
        let (start, count) = line_tokens(ccx, pcx);
        for k in 0..count {
            if k > 0 {
                buf_byte(b, b' ');
            }
            buf_bytes(b,
                sym_text(
                    (pcx.ctoks[(pcx.cints[(start + k) as usize]) as usize]).text,
                    pcx));
        }
        buf_byte(b, 0);
        c_error2(hash, c"#error ", buf_ptr(b), pcx);
    } else if streq(name, c"pragma") {
        let (start, count) = line_tokens(ccx, pcx);
        if count > 0 && streq(ctok_text((pcx.cints[start as usize]), pcx), c"once") {
            ccx.cpp_once.put(
                intern_c(pcx.cfiles[(pcx.ctoks[hash as usize]).file as usize].path, pcx) + 1,
                1);
        }
        if count > 0 && streq(ctok_text((pcx.cints[start as usize]), pcx), c"pack") {
            pragma_pack(hash, start + 1, count - 1, ccx, pcx);
        }
    } else {
        // #line, #ident, #warning, #sccs, #assert, ...: ignored.
        skip_line(ccx, pcx);
    }
}

fn pragma_pack(at: i64, start: i64, count: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut values: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut push = false;
    let mut pop = false;
    for k in 0..count {
        let t = (pcx.cints[(start + k) as usize]);
        if (pcx.ctoks[t as usize]).kind == Num {
            values.push(c_ull(ctok_bytes(t, pcx), 10).0 as i64);
        }
        else if (pcx.ctoks[t as usize]).kind == Ident
            && streq(ctok_text(t, pcx), c"push") {
            push = true;
        }
        else if (pcx.ctoks[t as usize]).kind == Ident && streq(ctok_text(t, pcx), c"pop") {
            pop = true;
        }
    }
    if push {
        ccx.pack_stack.push(ccx.pack_now);
    }
    if pop {
        ccx.pack_now = if ccx.pack_stack.len() as i64 > 0 { ccx.pack_stack.pop().unwrap() }
            else { 0 };
    }
    if values.len() as i64 > 0 {
        ccx.pack_now = (values[(values.len() as i64 - 1) as usize]);
    } else if !push && !pop {
        ccx.pack_now = 0;
    }
    let marker = ctok_copy(at, ccx, pcx);
    (pcx.ctoks[marker as usize]).kind = Ident;
    (pcx.ctoks[marker as usize]).text = intern_c(c"__vole_pack", pcx);
    let value = ctok_copy(at, ccx, pcx);
    (pcx.ctoks[value as usize]).kind = Num;
    let b = buf_new();
    buf_int(b, ccx.pack_now);
    (pcx.ctoks[value as usize]).text = intern_buf(b, pcx);
    push_back(value, ccx);
    push_back(marker, ccx);
}

pub fn is_defined(sym: i64, ccx: &CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    macro_of(sym, ccx) >= 0 || sym == ccx.s_line || sym == ccx.s_file || sym == ccx.s_counter
        || sym == ccx.s_has_include || sym == ccx.s_has_include_next || is_query_builtin(sym, pcx)
}

fn define_macro(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let name_tok = file_tok(ccx, pcx);
    if name_tok < 0 || (pcx.ctoks[name_tok as usize]).bol
        || (pcx.ctoks[name_tok as usize]).kind != Ident {
        c_error(name_tok, c"#define needs a macro name", pcx);
    }
    let m = pcx.macros.len() as i64;
    let mut mac = Macro {
        name: (pcx.ctoks[name_tok as usize]).text, func: false, variadic: false,
        builtin: ccx.defining_builtins,
        params: 0, param_count: 0, body: 0, body_count: 0,
    };
    if !ccx.defining_builtins {
        origin_note(ORIGIN_MACRO, m, name_tok, ctok_line(name_tok, pcx),
            ctok_line(name_tok, pcx), replace: true, ccx: ccx, pcx: pcx);
    }
    let open = file_peek(ccx, pcx);
    if open >= 0 && !(pcx.ctoks[open as usize]).bol
        && !(pcx.ctoks[open as usize]).space
        && ctok_is(open, pcx.s_lparen, pcx) {
        file_tok(ccx, pcx);
        mac.func = true;
        let mut params: Vec<i64, Comp> = Vec::new_in(Comp {});
        loop {
            let p = file_tok(ccx, pcx);
            if p < 0 || (pcx.ctoks[p as usize]).bol {
                c_error(name_tok, c"unterminated macro parameter list", pcx);
            }
            if ctok_is(p, pcx.s_rparen, pcx) {
                break;
            }
            if ctok_is(p, ccx.s_comma, pcx) {
                continue;
            }
            if ctok_is(p, ccx.s_ellipsis, pcx) {
                mac.variadic = true;
                params.push(ccx.s_va_args);
                continue;
            }
            // GNU named variadic parameter: `args...`.
            let after = file_peek(ccx, pcx);
            if after >= 0 && ctok_is(after, ccx.s_ellipsis, pcx) {
                file_tok(ccx, pcx);
                mac.variadic = true;
            }
            params.push((pcx.ctoks[p as usize]).text);
        }
        mac.params = pcx.cints.len() as i64;
        for i in 0..params.len() as i64 {
            pcx.cints.push((params[i as usize]));
        }
        mac.param_count = params.len() as i64;
    }
    let (start, count) = line_tokens(ccx, pcx);
    mac.body = start;
    mac.body_count = count;
    pcx.macros.push(mac);
    ccx.macro_of.put(mac.name + 1, m + 1);
}

fn begin_cond(taken: bool, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if taken {
        ccx.cpp_conds.push(COND_TAKEN);
    } else {
        ccx.cpp_conds.push(COND_SEARCH);
        skip_branches(ccx, pcx);
    }
}

// Skips the tokens of branches not taken, up to the branch to read (an
// #elif that holds or an #else, in state COND_SEARCH) or the #endif.
fn skip_branches(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let mut depth: i64 = 0;
    loop {
        let t = file_tok(ccx, pcx);
        if t < 0 {
            c_error2(0, c"unterminated #if in ",
                pcx.cfiles[(ccx.frame_file[cur_frame(ccx) as usize]) as usize].path,
                pcx);
        }
        if !((pcx.ctoks[t as usize]).bol && ctok_is(t, ccx.s_hash, pcx)) {
            continue;
        }
        let d = file_peek(ccx, pcx);
        if d < 0 || (pcx.ctoks[d as usize]).bol {
            continue;
        }
        let name = ctok_text(d, pcx);
        if streq(name, c"if") || streq(name, c"ifdef") || streq(name, c"ifndef") {
            depth += 1;
            continue;
        }
        if streq(name, c"endif") {
            if depth > 0 {
                depth -= 1;
                continue;
            }
            file_tok(ccx, pcx);
            skip_line(ccx, pcx);
            ccx.cpp_conds.pop().unwrap();
            return;
        }
        if depth > 0
            || (ccx.cpp_conds[(ccx.cpp_conds.len() as i64 - 1) as usize]) != COND_SEARCH {
            continue;
        }
        if streq(name, c"else") {
            file_tok(ccx, pcx);
            skip_line(ccx, pcx);
            *ccx.cpp_conds.last_mut().unwrap() = COND_TAKEN;
            return;
        }
        if streq(name, c"elif") {
            file_tok(ccx, pcx);
            let (start, count) = line_tokens(ccx, pcx);
            if eval_if(d, start, count, ccx, pcx) {
                *ccx.cpp_conds.last_mut().unwrap() = COND_TAKEN;
                return;
            }
        } else if streq(name, c"elifdef") || streq(name, c"elifndef") {
            file_tok(ccx, pcx);
            let (start, count) = line_tokens(ccx, pcx);
            if count > 0
                && is_defined(
                    (pcx.ctoks[(pcx.cints[start as usize]) as usize]).text, ccx,
                    pcx)
                == streq(name, c"elifdef") {
                *ccx.cpp_conds.last_mut().unwrap() = COND_TAKEN;
                return;
            }
        }
    }
}

// ---- #include ----

pub fn path_join(dir: *const u8, name: *mut u8) -> *mut u8 {
    let b = buf_new();
    buf_fmt(b,
        format_args("{}/{}\0", str::from_utf8(&cstr(dir)).unwrap(),
            str::from_utf8(&cstr(name)).unwrap()));
    buf_ptr(b)
}

// The directory part of a path ("." when it has none).
pub fn path_dir(path: *const u8) -> *const u8 {
    let bytes = cstr(path);
    let name = path_name_at(&bytes);
    if name == 0 {
        return c".";
    }
    if name == 1 {
        return c"/";
    }
    let b = buf_new();
    buf_bytes(b, &bytes[..name - 1]);
    buf_byte(b, 0);
    buf_ptr(b)
}

// Where the last component of path p starts: after its last '/', 0
// when it has none.
pub fn path_name_at(p: &[u8]) -> usize {
    let mut i = p.len();
    while i > 0 && p[i - 1] != b'/' {
        i -= 1;
    }
    i
}

// The last component of C path `path`: the same string, further on.
pub fn path_base(path: *const u8) -> *const u8 {
    c_tail(path, path_name_at(&cstr(path)) as i64)
}

pub fn file_exists(path: *const u8, pcx: &Ctx<Comp>) -> bool {
    // UNSAFE: C's access, which asks whether a file is there; a C call
    // SAFETY: overlay_of returns `path` or the overlay's path for it, a
    // NUL-terminated string as `path` is (the convention of every
    // `*mut u8` the compiler passes as text: base::cstr); access reads
    // it up to its NUL and keeps nothing
    unsafe { access(overlay_of(path, pcx), 0) == 0 }
}

// Where `#include` finds `name`: the path and its directory index
// (-1: not from the search path); path 0 when not found.
fn find_include(name: *mut u8, quoted: bool, next: bool, from_file: i64, pcx: &Ctx<Comp>) -> (
    *mut u8, i64) {
    if c_first(name) == b'/' {
        return (if file_exists(name, pcx) { name } else { 0 as *mut u8 }, -1);
    }
    let mut first: i64 = 0;
    if next && from_file >= 0 && pcx.cfiles[from_file as usize].dir >= 0 {
        first = pcx.cfiles[from_file as usize].dir + 1;
    } else if quoted && from_file >= 0 {
        let p = path_join(path_dir(pcx.cfiles[from_file as usize].path), name);
        if file_exists(p, pcx) {
            return (p, -1);
        }
    }
    for i in first..pcx.cdirs.len() as i64 {
        let p = path_join((pcx.cdirs[i as usize]) as *mut u8, name);
        if file_exists(p, pcx) {
            return (p, i);
        }
    }
    (0 as *mut u8, -1)
}

// The header named by tokens (start, count): `"name"` or `<name>`; also
// whether it was quoted. 0 when the tokens name none.
fn header_name(start: i64, count: i64, ccx: &CImportCx<Comp>, pcx: &Ctx<Comp>) -> (*mut u8, bool) {
    if count == 0 {
        return (0 as *mut u8, false);
    }
    let first = (pcx.cints[start as usize]);
    let b = buf_new();
    if (pcx.ctoks[first as usize]).kind == Str {
        let text = sym_text((pcx.ctoks[first as usize]).text, pcx);
        buf_bytes(b, &text[1..(text.len() as i64 - 1) as usize]);
        buf_byte(b, 0);
        return (buf_ptr(b), true);
    }
    if !ctok_is(first, ccx.s_lt, pcx) {
        return (0 as *mut u8, false);
    }
    for k in 1..count {
        let t = (pcx.cints[(start + k) as usize]);
        if ctok_is(t, ccx.s_gt, pcx) {
            buf_byte(b, 0);
            return (buf_ptr(b), false);
        }
        if (pcx.ctoks[t as usize]).space && k > 1 {
            buf_byte(b, b' ');
        }
        buf_bytes(b, sym_text((pcx.ctoks[t as usize]).text, pcx));
    }
    (0 as *mut u8, false)
}

fn include(at: i64, next: bool, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let (start, count) = line_tokens(ccx, pcx);
    let (mut name, mut quoted) = header_name(start, count, ccx, pcx);
    if name == 0 as *mut u8 {
        let expanded = expand_list(start, count, ccx, pcx);
        let s = pcx.cints.len() as i64;
        for k in 0..expanded.len() as i64 {
            pcx.cints.push((expanded[k as usize]));
        }
        let (n2, q2) = header_name(s, expanded.len() as i64, ccx, pcx);
        name = n2;
        quoted = q2;
    }
    if name == 0 as *mut u8 {
        c_error(at, c"#include expects \"file\" or <file>", pcx);
    }
    let (path, dir) = find_include(name, quoted, next, (pcx.ctoks[at as usize]).file, pcx);
    if path == 0 as *mut u8 {
        c_error2(at, c"header not found: ", name, pcx);
    }
    let (at_file, _, _, _) = ctok_place(at, pcx);
    if at_file == pcx.c_import_file {
        // (0.25.2) an `import` item's header (its line of `<import>`)
        pcx.c_import_paths.push(ctok_line(at, pcx) - 1);
        let path_sym = intern_c(path, pcx);
        pcx.c_import_paths.push(path_sym);
    }
    open_header(path, dir, ccx, pcx);
}

fn open_header(path: *mut u8, dir: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    if ccx.cpp_once.get(intern_c(path, pcx) + 1) != 0 {
        return;
    }
    let f = c_load_file(path, dir, ccx, pcx);
    push_frame(f, ccx, pcx);
}

// ---- #if ----

fn eval_if(at: i64, start: i64, count: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> bool {
    // `defined X` and __has_include(...) are answered before expansion.
    let mut line: Vec<i64, Comp> = Vec::new_in(Comp {});
    let mut k: i64 = 0;
    while k < count {
        let t = (pcx.cints[(start + k) as usize]);
        let sym = (pcx.ctoks[t as usize]).text;
        if (pcx.ctoks[t as usize]).kind == Ident && sym == ccx.s_defined {
            let mut j = k + 1;
            let paren = j < count
                && ctok_is((pcx.cints[(start + j) as usize]), pcx.s_lparen, pcx);
            if paren {
                j += 1;
            }
            if j >= count {
                c_error(t, c"'defined' without a name", pcx);
            }
            let value = is_defined(
                (pcx.ctoks[(pcx.cints[(start + j) as usize]) as usize]).text,
                ccx, pcx);
            j += 1;
            if paren {
                j += 1;
            }
            line.push(number_tok(t, value, ccx, pcx));
            k = j;
            continue;
        }
        if (pcx.ctoks[t as usize]).kind == Ident
            && (sym == ccx.s_has_include || sym == ccx.s_has_include_next) {
            let mut j = k + 2;
            let name_start = start + j;
            while j < count
                && !ctok_is((pcx.cints[(start + j) as usize]), pcx.s_rparen, pcx) {
                j += 1;
            }
            // `<a/b.h>` and `"a.h"` are not macro-expanded here.
            let (name, quoted) = header_name(name_start, start + j - name_start, ccx, pcx);
            let mut found = false;
            if name != 0 as *mut u8 {
                let (path, _) = find_include(name, quoted, sym == ccx.s_has_include_next,
                    (pcx.ctoks[t as usize]).file, pcx);
                found = path != 0 as *mut u8;
            }
            line.push(number_tok(t, found, ccx, pcx));
            k = j + 1;
            continue;
        }
        line.push(t);
        k += 1;
    }
    let s = pcx.cints.len() as i64;
    for i in 0..line.len() as i64 {
        pcx.cints.push((line[i as usize]));
    }
    let expanded = expand_list(s, line.len() as i64, ccx, pcx);
    let (value, _) = eval_tokens(&expanded, at, decl: false, ccx: ccx, pcx: pcx);
    value != 0
}

fn number_tok(at: i64, value: bool, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> i64 {
    let n = ctok_copy(at, ccx, pcx);
    (pcx.ctoks[n as usize]).kind = Num;
    (pcx.ctoks[n as usize]).text = if value { ccx.s_one } else { ccx.s_zero };
    n
}

// UNSAFE: POSIX's access, which says whether an include path names a readable file without
// opening it.
// SAFETY: the declaration is access's C prototype on the targets vole builds for (64-bit macOS
// and Linux: int is i32, size_t u64, long and long long i64, a pointer 8 bytes); a call passes
// a NUL-terminated path.
pub extern "C" {
    fn access(path: *const u8, mode: i32) -> i32;
}
