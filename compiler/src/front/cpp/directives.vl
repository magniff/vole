// Preprocessing directives: `#define` and `#undef`, conditional
// inclusion (`#if`, `#ifdef`, `#elif`, `#else`, `#endif`), `#include`
// and `#include_next` with the include search, `#pragma once` and
// `#pragma pack`.

use crate::base::{
    BUFS, IntVec, buf_byte, buf_bytes, buf_fmt, buf_int, buf_new, buf_slice, cstr, grow, intern,
    intern_c, overlay_of, streq, strlen, sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::ctx::CImportCx;
use crate::front::cpp::{
    Macro, ORIGIN_MACRO, c_error, c_error2, ctok_copy, ctok_is, ctok_line, ctok_place, ctok_text,
    is_query_builtin, macro_of, origin_note, strtoull,
};
use crate::front::cpp::CK::{Ident, Num, Str};
use crate::front::cpp::eval::eval_tokens;
use crate::front::cpp::expand::expand_list;
use crate::front::cpp::input::{
    c_load_file, cur_frame, file_peek, file_tok, line_tokens, push_back, push_frame, skip_line,
};

const COND_TAKEN: i64 = 0;
const COND_SEARCH: i64 = 1;
const COND_DONE: i64 = 2;

// ---- Directives ----

pub fn directive(hash: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let t = file_peek(ccx, pcx);
        if t < 0 || pcx.ctoks[t].bol {
            return;
        }
        file_tok(&ccx, pcx);
        let name = ctok_text(t, pcx);
        if streq(name, c"define") {
            define_macro(&ccx, &pcx);
        } else if streq(name, c"undef") {
            let (start, count) = line_tokens(&ccx, &pcx);
            if count > 0 {
                ccx.macro_of.put(pcx.ctoks[pcx.cints.data[start]].text + 1, 0);
            }
        }
        else if streq(name, c"include") || streq(name, c"include_next") || streq(name, c"import") {
            include(t, streq(name, c"include_next"), &ccx, &pcx);
        } else if streq(name, c"if") {
            let (start, count) = line_tokens(&ccx, &pcx);
            begin_cond(eval_if(t, start, count, &ccx, &pcx), &ccx, &pcx);
        } else if streq(name, c"ifdef") || streq(name, c"ifndef") {
            let (start, count) = line_tokens(&ccx, &pcx);
            if count == 0 {
                c_error(t, c"#ifdef without a name", &pcx);
            }
            let defined = is_defined(pcx.ctoks[pcx.cints.data[start]].text, ccx, &pcx);
            begin_cond(defined == streq(name, c"ifdef"), &ccx, &pcx);
        }
        else if streq(name, c"elif") || streq(name, c"elifdef") || streq(name, c"elifndef")
            || streq(name, c"else") {
            // Reached in a taken branch: the rest of the #if is skipped.
            if ccx.cpp_conds.count == ccx.frame_cond.data[cur_frame(ccx)] {
                c_error(t, c"#else or #elif without #if", &pcx);
            }
            skip_line(&ccx, pcx);
            ccx.cpp_conds.data[ccx.cpp_conds.count - 1] = COND_DONE;
            skip_branches(&ccx, &pcx);
        } else if streq(name, c"endif") {
            if ccx.cpp_conds.count == ccx.frame_cond.data[cur_frame(ccx)] {
                c_error(t, c"#endif without #if", &pcx);
            }
            ccx.cpp_conds.pop();
            skip_line(&ccx, pcx);
        } else if streq(name, c"error") {
            let b = buf_new();
            let (start, count) = line_tokens(&ccx, &pcx);
            for k in 0..count {
                if k > 0 {
                    buf_byte(b, ' ');
                }
                buf_bytes(b, sym_text(pcx.ctoks[pcx.cints.data[start + k]].text, pcx));
            }
            buf_byte(b, 0);
            c_error2(hash, c"#error ", BUFS[b].data, &pcx);
        } else if streq(name, c"pragma") {
            let (start, count) = line_tokens(&ccx, &pcx);
            if count > 0 && streq(ctok_text(pcx.cints.data[start], pcx), c"once") {
                ccx.cpp_once.put(intern_c(pcx.cfiles[pcx.ctoks[hash].file].path, &pcx) + 1, 1);
            }
            if count > 0 && streq(ctok_text(pcx.cints.data[start], pcx), c"pack") {
                pragma_pack(hash, start + 1, count - 1, &ccx, &pcx);
            }
        } else {
            // #line, #ident, #warning, #sccs, #assert, ...: ignored.
            skip_line(&ccx, pcx);
        }
    }
}

fn pragma_pack(at: i64, start: i64, count: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        var values = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var push = false;
        var pop = false;
        for k in 0..count {
            let t = pcx.cints.data[start + k];
            if pcx.ctoks[t].kind == Num {
                var end = 0 as *u8;
                values.push(strtoull(ctok_text(t, pcx), &end, 10) as i64);
            } else if pcx.ctoks[t].kind == Ident && streq(ctok_text(t, pcx), c"push") {
                push = true;
            } else if pcx.ctoks[t].kind == Ident && streq(ctok_text(t, pcx), c"pop") {
                pop = true;
            }
        }
        if push {
            ccx.pack_stack.push(ccx.pack_now);
        }
        if pop {
            ccx.pack_now = if ccx.pack_stack.count > 0 { ccx.pack_stack.pop() } else { 0 };
        }
        if values.count > 0 {
            ccx.pack_now = values.data[values.count - 1];
        } else if !push && !pop {
            ccx.pack_now = 0;
        }
        let marker = ctok_copy(at, &ccx, &pcx);
        pcx.ctoks[marker].kind = Ident;
        pcx.ctoks[marker].text = intern_c(c"__vole_pack", &pcx);
        let value = ctok_copy(at, &ccx, &pcx);
        pcx.ctoks[value].kind = Num;
        let b = buf_new();
        buf_int(b, ccx.pack_now);
        pcx.ctoks[value].text = intern(buf_slice(b), &pcx);
        push_back(value, &ccx);
        push_back(marker, &ccx);
    }
}

pub fn is_defined(sym: i64, ccx: CImportCx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    macro_of(sym, ccx) >= 0 || sym == ccx.s_line || sym == ccx.s_file || sym == ccx.s_counter
        || sym == ccx.s_has_include || sym == ccx.s_has_include_next || is_query_builtin(sym, &pcx)
}

fn define_macro(ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let name_tok = file_tok(&ccx, pcx);
        if name_tok < 0 || pcx.ctoks[name_tok].bol || pcx.ctoks[name_tok].kind != Ident {
            c_error(name_tok, c"#define needs a macro name", &pcx);
        }
        pcx.macros = grow(pcx.macros, pcx.macro_count, &ccx.macro_cap);
        let m = pcx.macro_count;
        pcx.macros[m] = Macro {
            name: pcx.ctoks[name_tok].text, func: false, variadic: false,
            builtin: ccx.defining_builtins,
            params: 0, param_count: 0, body: 0, body_count: 0,
        };
        if !ccx.defining_builtins {
            origin_note(ORIGIN_MACRO, m, name_tok, ctok_line(name_tok, pcx),
                ctok_line(name_tok, pcx), replace: true, ccx: &ccx, pcx: &pcx);
        }
        let open = file_peek(ccx, pcx);
        if open >= 0 && !pcx.ctoks[open].bol && !pcx.ctoks[open].space
            && ctok_is(open, pcx.s_lparen, pcx) {
            file_tok(&ccx, pcx);
            pcx.macros[m].func = true;
            var params = IntVec { data: 0 as *i64, count: 0, cap: 0 };
            loop {
                let p = file_tok(&ccx, pcx);
                if p < 0 || pcx.ctoks[p].bol {
                    c_error(name_tok, c"unterminated macro parameter list", &pcx);
                }
                if ctok_is(p, pcx.s_rparen, pcx) {
                    break;
                }
                if ctok_is(p, ccx.s_comma, pcx) {
                    continue;
                }
                if ctok_is(p, ccx.s_ellipsis, pcx) {
                    pcx.macros[m].variadic = true;
                    params.push(ccx.s_va_args);
                    continue;
                }
                // GNU named variadic parameter: `args...`.
                let after = file_peek(ccx, pcx);
                if after >= 0 && ctok_is(after, ccx.s_ellipsis, pcx) {
                    file_tok(&ccx, pcx);
                    pcx.macros[m].variadic = true;
                }
                params.push(pcx.ctoks[p].text);
            }
            pcx.macros[m].params = pcx.cints.count;
            for i in 0..params.count {
                pcx.cints.push(params.data[i]);
            }
            pcx.macros[m].param_count = params.count;
        }
        let (start, count) = line_tokens(&ccx, &pcx);
        pcx.macros[m].body = start;
        pcx.macros[m].body_count = count;
        pcx.macro_count += 1;
        ccx.macro_of.put(pcx.macros[m].name + 1, m + 1);
    }
}

fn begin_cond(taken: bool, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    if taken {
        ccx.cpp_conds.push(COND_TAKEN);
    } else {
        ccx.cpp_conds.push(COND_SEARCH);
        skip_branches(&ccx, &pcx);
    }
}

// Skips the tokens of branches not taken, up to the branch to read (an
// #elif that holds or an #else, in state COND_SEARCH) or the #endif.
fn skip_branches(ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        var depth = 0;
        loop {
            let t = file_tok(&ccx, pcx);
            if t < 0 {
                c_error2(0, c"unterminated #if in ",
                    pcx.cfiles[ccx.frame_file.data[cur_frame(ccx)]].path, &pcx);
            }
            if !(pcx.ctoks[t].bol && ctok_is(t, ccx.s_hash, pcx)) {
                continue;
            }
            let d = file_peek(ccx, pcx);
            if d < 0 || pcx.ctoks[d].bol {
                continue;
            }
            let name = ctok_text(d, pcx);
            if streq(name, c"if") || streq(name, c"ifdef") || streq(name, c"ifndef") {
                depth += 1;
                continue;
            }
            if streq(name, c"endif") {
                if depth > 0 {
                    depth -= 1;
                    continue;
                }
                file_tok(&ccx, pcx);
                skip_line(&ccx, pcx);
                ccx.cpp_conds.pop();
                return;
            }
            if depth > 0 || ccx.cpp_conds.data[ccx.cpp_conds.count - 1] != COND_SEARCH {
                continue;
            }
            if streq(name, c"else") {
                file_tok(&ccx, pcx);
                skip_line(&ccx, pcx);
                ccx.cpp_conds.data[ccx.cpp_conds.count - 1] = COND_TAKEN;
                return;
            }
            if streq(name, c"elif") {
                file_tok(&ccx, pcx);
                let (start, count) = line_tokens(&ccx, &pcx);
                if eval_if(d, start, count, &ccx, &pcx) {
                    ccx.cpp_conds.data[ccx.cpp_conds.count - 1] = COND_TAKEN;
                    return;
                }
            } else if streq(name, c"elifdef") || streq(name, c"elifndef") {
                file_tok(&ccx, pcx);
                let (start, count) = line_tokens(&ccx, &pcx);
                if count > 0
                    && is_defined(pcx.ctoks[pcx.cints.data[start]].text, ccx, &pcx)
                    == streq(name, c"elifdef") {
                    ccx.cpp_conds.data[ccx.cpp_conds.count - 1] = COND_TAKEN;
                    return;
                }
            }
        }
    }
}

// ---- #include ----

pub fn path_join(dir: *u8, name: *u8) -> *u8 {
    let b = buf_new();
    buf_fmt(b, format_args("{}/{}\0", cstr(dir), cstr(name)));
    unsafe { BUFS[b].data }
}

// The directory part of a path ("." when it has none).
pub fn path_dir(path: *u8) -> *u8 {
    unsafe {
        let n = strlen(path) as i64;
        var i = n - 1;
        while i >= 0 && path[i] != '/' {
            i -= 1;
        }
        if i < 0 {
            return c".";
        }
        if i == 0 {
            return c"/";
        }
        let b = buf_new();
        buf_bytes(b, path[0..i]);
        buf_byte(b, 0);
        BUFS[b].data
    }
}

pub fn file_exists(path: *u8, pcx: Ctx<Comp>) -> bool {
    unsafe { access(overlay_of(path, pcx), 0) == 0 }
}

// Where `#include` finds `name`: the path and its directory index
// (-1: not from the search path); path 0 when not found.
fn find_include(name: *u8, quoted: bool, next: bool, from_file: i64, pcx: Ctx<Comp>) -> (*u8, i64) {
    unsafe {
        if name[0] == '/' {
            return (if file_exists(name, pcx) { name } else { 0 as *u8 }, -1);
        }
        var first = 0;
        if next && from_file >= 0 && pcx.cfiles[from_file].dir >= 0 {
            first = pcx.cfiles[from_file].dir + 1;
        } else if quoted && from_file >= 0 {
            let p = path_join(path_dir(pcx.cfiles[from_file].path), name);
            if file_exists(p, pcx) {
                return (p, -1);
            }
        }
        for i in first..pcx.cdirs.count {
            let p = path_join(pcx.cdirs.data[i] as *u8, name);
            if file_exists(p, pcx) {
                return (p, i);
            }
        }
        (0 as *u8, -1)
    }
}

// The header named by tokens (start, count): `"name"` or `<name>`; also
// whether it was quoted. 0 when the tokens name none.
fn header_name(start: i64, count: i64, ccx: CImportCx<Comp>, pcx: Ctx<Comp>) -> (*u8, bool) {
    unsafe {
        if count == 0 {
            return (0 as *u8, false);
        }
        let first = pcx.cints.data[start];
        let b = buf_new();
        if pcx.ctoks[first].kind == Str {
            let text = sym_text(pcx.ctoks[first].text, pcx);
            buf_bytes(b, text[1..text.len as i64 - 1]);
            buf_byte(b, 0);
            return (BUFS[b].data, true);
        }
        if !ctok_is(first, ccx.s_lt, pcx) {
            return (0 as *u8, false);
        }
        for k in 1..count {
            let t = pcx.cints.data[start + k];
            if ctok_is(t, ccx.s_gt, pcx) {
                buf_byte(b, 0);
                return (BUFS[b].data, false);
            }
            if pcx.ctoks[t].space && k > 1 {
                buf_byte(b, ' ');
            }
            buf_bytes(b, sym_text(pcx.ctoks[t].text, pcx));
        }
        (0 as *u8, false)
    }
}

fn include(at: i64, next: bool, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let (start, count) = line_tokens(&ccx, &pcx);
        let (var name, var quoted) = header_name(start, count, ccx, pcx);
        if name == 0 as *u8 {
            let expanded = expand_list(start, count, &ccx, &pcx);
            let s = pcx.cints.count;
            for k in 0..expanded.count {
                pcx.cints.push(expanded.data[k]);
            }
            let (n2, q2) = header_name(s, expanded.count, ccx, pcx);
            name = n2;
            quoted = q2;
        }
        if name == 0 as *u8 {
            c_error(at, c"#include expects \"file\" or <file>", &pcx);
        }
        let (path, dir) = find_include(name, quoted, next, pcx.ctoks[at].file, pcx);
        if path == 0 as *u8 {
            c_error2(at, c"header not found: ", name, &pcx);
        }
        let (at_file, _, _, _) = ctok_place(at, pcx);
        if at_file == pcx.c_import_file {
            // (0.25.2) an `import` item's header (its line of `<import>`)
            pcx.c_import_paths.push(ctok_line(at, pcx) - 1);
            let path_sym = intern_c(path, &pcx);
            pcx.c_import_paths.push(path_sym);
        }
        open_header(path, dir, &ccx, &pcx);
    }
}

fn open_header(path: *u8, dir: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    if ccx.cpp_once.get(intern_c(path, &pcx) + 1) != 0 {
        return;
    }
    let f = c_load_file(path, dir, &ccx, &pcx);
    push_frame(f, &ccx, &pcx);
}

// ---- #if ----

fn eval_if(at: i64, start: i64, count: i64, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> bool {
    unsafe {
        // `defined X` and __has_include(...) are answered before expansion.
        var line = IntVec { data: 0 as *i64, count: 0, cap: 0 };
        var k = 0;
        while k < count {
            let t = pcx.cints.data[start + k];
            let sym = pcx.ctoks[t].text;
            if pcx.ctoks[t].kind == Ident && sym == ccx.s_defined {
                var j = k + 1;
                let paren = j < count && ctok_is(pcx.cints.data[start + j], pcx.s_lparen, pcx);
                if paren {
                    j += 1;
                }
                if j >= count {
                    c_error(t, c"'defined' without a name", &pcx);
                }
                let value = is_defined(pcx.ctoks[pcx.cints.data[start + j]].text, ccx, &pcx);
                j += 1;
                if paren {
                    j += 1;
                }
                line.push(number_tok(t, value, &ccx, &pcx));
                k = j;
                continue;
            }
            if pcx.ctoks[t].kind == Ident
                && (sym == ccx.s_has_include || sym == ccx.s_has_include_next) {
                var j = k + 2;
                let name_start = start + j;
                while j < count && !ctok_is(pcx.cints.data[start + j], pcx.s_rparen, pcx) {
                    j += 1;
                }
                // `<a/b.h>` and `"a.h"` are not macro-expanded here.
                let (name, quoted) = header_name(name_start, start + j - name_start, ccx, pcx);
                var found = false;
                if name != 0 as *u8 {
                    let (path, _) = find_include(name, quoted, sym == ccx.s_has_include_next,
                        pcx.ctoks[t].file, pcx);
                    found = path != 0 as *u8;
                }
                line.push(number_tok(t, found, &ccx, &pcx));
                k = j + 1;
                continue;
            }
            line.push(t);
            k += 1;
        }
        let s = pcx.cints.count;
        for i in 0..line.count {
            pcx.cints.push(line.data[i]);
        }
        let expanded = expand_list(s, line.count, &ccx, &pcx);
        let (value, _) = eval_tokens(expanded, at, decl: false, ccx: &ccx, pcx: &pcx);
        value != 0
    }
}

fn number_tok(at: i64, value: bool, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) -> i64 {
    let n = ctok_copy(at, &ccx, &pcx);
    unsafe {
        pcx.ctoks[n].kind = Num;
        pcx.ctoks[n].text = if value { ccx.s_one } else { ccx.s_zero };
    }
    n
}

pub extern "C" {
    fn access(path: *u8, mode: i32) -> i32;
}
