// The C preprocessor's constant expressions: the integer expressions of
// `#if` and of the declarations cimport reads (enumerators, array
// sizes), with C's usual arithmetic conversions.

use crate::base::{IntVec, streq, strlen, sym_name};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::{cty_bits, cty_int, cty_signed};
use crate::front::cimport::ctx::CImportCx;
use crate::front::cimport::decls::{cdecl_eval_special, cdecl_ident_value};
use crate::front::cpp::{c_error, ctok_text, is_query_builtin, strtoull};
use crate::front::cpp::CK::{Char, Ident, Num, Punct};
use crate::front::cpp::directives::is_defined;
use crate::front::lexer::is_digit;

// ---- Constant expressions ----
//
// Shared by `#if` (mode false: identifiers are 0, arithmetic is in
// intmax_t/uintmax_t) and the declarations (mode true: enumerators,
// casts, sizeof, C's integer types). A value is (bits, C type); EV_FAIL
// is set when the expression is not an integer constant.

pub fn eval_tokens(list: IntVec, at: i64, decl: bool, ccx: &mut CImportCx<Comp>,
    pcx: &mut Ctx<Comp>) -> (u64, i64) {
    let saved = (ccx.ev_toks, ccx.ev_n, ccx.ev_pos, ccx.ev_at, ccx.ev_decl);
    ccx.ev_toks = list.data;
    ccx.ev_n = list.count;
    ccx.ev_pos = 0;
    ccx.ev_at = at;
    ccx.ev_decl = decl;
    pcx.ev_fail = false;
    let result = ev_cond(ccx, pcx);
    if ccx.ev_pos < ccx.ev_n {
        ev_fail(pcx, ccx);
    }
    let (toks, n, pos, at0, decl0) = saved;
    ccx.ev_toks = toks;
    ccx.ev_n = n;
    ccx.ev_pos = pos;
    ccx.ev_at = at0;
    ccx.ev_decl = decl0;
    if pcx.ev_fail && !decl {
        c_error(at, c"invalid #if expression", pcx);
    }
    result
}

fn ev_fail(pcx: &mut Ctx<Comp>, ccx: &mut CImportCx<Comp>) {
    pcx.ev_fail = true;
    ccx.ev_pos = ccx.ev_n;
}

pub fn ev_peek(pcx: &Ctx<Comp>, ccx: &CImportCx<Comp>) -> i64 {
    if ccx.ev_pos < ccx.ev_n { unsafe { (*ccx.ev_toks.add(ccx.ev_pos as usize)) } }
    else { pcx.c_eof }
}

fn ev_at(text: *mut u8, pcx: &Ctx<Comp>, ccx: &CImportCx<Comp>) -> bool {
    let t = ev_peek(pcx, ccx);
    unsafe {
        t != pcx.c_eof && (*pcx.ctoks.add(t as usize)).kind == Punct
            && streq(ctok_text(t, pcx), text)
    }
}

fn ev_eat(text: *mut u8, pcx: &Ctx<Comp>, ccx: &mut CImportCx<Comp>) -> bool {
    if ev_at(text, pcx, ccx) {
        ccx.ev_pos += 1;
        return true;
    }
    false
}

// The type arithmetic on a and b is done in (C's usual conversions; in
// #if, intmax_t and uintmax_t).
fn ev_common(a: i64, b: i64, ccx: &CImportCx<Comp>) -> i64 {
    let ta = ev_promote(a, ccx);
    let tb = ev_promote(b, ccx);
    let wa = cty_bits(ta, ccx);
    let wb = cty_bits(tb, ccx);
    let wide = if wa > wb { wa } else { wb };
    let unsigned = (cty_bits(ta, ccx) == wide && !cty_signed(ta, ccx))
        || (cty_bits(tb, ccx) == wide && !cty_signed(tb, ccx));
    cty_int(wide, !unsigned, ccx)
}

fn ev_promote(t: i64, ccx: &CImportCx<Comp>) -> i64 {
    if !ccx.ev_decl {
        return cty_int(64, cty_signed(t, ccx), ccx);
    }
    let bits = cty_bits(t, ccx);
    if bits < 32 {
        return cty_int(32, true, ccx);
    }
    cty_int(bits, cty_signed(t, ccx), ccx)
}

// `value` converted to integer type t.
pub fn ev_convert(value: u64, t: i64, ccx: &CImportCx<Comp>) -> u64 {
    let bits = cty_bits(t, ccx);
    if bits >= 64 {
        return value;
    }
    let mask = ((1 as u64) << bits as u64) - 1;
    let v = value & mask;
    if cty_signed(t, ccx) && (v >> (bits - 1) as u64) != 0 {
        return v | !mask;
    }
    v
}

fn ev_cond(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (u64, i64) {
    let (c, ct) = ev_binary(0, ccx, pcx);
    if !ev_eat(c"?", pcx, ccx) {
        return (c, ct);
    }
    let (a, at) = ev_cond(ccx, pcx);
    if !ev_eat(c":", pcx, ccx) {
        ev_fail(pcx, ccx);
        return (0, ct);
    }
    let (b, bt) = ev_cond(ccx, pcx);
    let t = ev_common(at, bt, ccx);
    if c != 0 { (ev_convert(a, t, ccx), t) } else { (ev_convert(b, t, ccx), t) }
}

// Binding powers of the binary operators (0: not one).
fn ev_prec(t: i64, pcx: &Ctx<Comp>) -> i64 {
    unsafe {
        if t == pcx.c_eof || (*pcx.ctoks.add(t as usize)).kind != Punct {
            return 0;
        }
        let s = ctok_text(t, pcx);
        if streq(s, c"||") { return 1; }
        if streq(s, c"&&") { return 2; }
        if streq(s, c"|") { return 3; }
        if streq(s, c"^") { return 4; }
        if streq(s, c"&") { return 5; }
        if streq(s, c"==") || streq(s, c"!=") { return 6; }
        if streq(s, c"<") || streq(s, c">") || streq(s, c"<=") || streq(s, c">=") { return 7; }
        if streq(s, c"<<") || streq(s, c">>") { return 8; }
        if streq(s, c"+") || streq(s, c"-") { return 9; }
        if streq(s, c"*") || streq(s, c"/") || streq(s, c"%") { return 10; }
        0
    }
}

fn ev_binary(min: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (u64, i64) {
    let (mut a, mut at) = ev_unary(ccx, pcx);
    loop {
        let op = ev_peek(pcx, ccx);
        let prec = ev_prec(op, pcx);
        if prec == 0 || prec <= min {
            return (a, at);
        }
        ccx.ev_pos += 1;
        let (b, bt) = ev_binary(prec, ccx, pcx);
        let s = ctok_text(op, pcx);
        let int_t = cty_int(if ccx.ev_decl { 32 } else { 64 }, true, ccx);
        if prec == 1 || prec == 2 {
            let r = if prec == 1 { a != 0 || b != 0 } else { a != 0 && b != 0 };
            a = r as u64;
            at = int_t;
            continue;
        }
        if prec == 8 {
            let t = ev_promote(at, ccx);
            let x = ev_convert(a, t, ccx);
            let n = b & 63;
            a = if streq(s, c"<<") {
                ev_convert(x << n, t, ccx)
            } else if cty_signed(t, ccx) {
                ev_convert(((x as i64) >> n) as u64, t, ccx)
            } else {
                x >> n
            };
            at = t;
            continue;
        }
        let t = ev_common(at, bt, ccx);
        let x = ev_convert(a, t, ccx);
        let y = ev_convert(b, t, ccx);
        let signed = cty_signed(t, ccx);
        if prec == 6 || prec == 7 {
            let r = if streq(s, c"==") { x == y } else if streq(s, c"!=") { x != y }
                else if signed {
                    if streq(s, c"<") { (x as i64) < (y as i64) }
                    else if streq(s, c">") { (x as i64) > (y as i64) }
                    else if streq(s, c"<=") { (x as i64) <= (y as i64) }
                    else { (x as i64) >= (y as i64) }
                } else {
                    if streq(s, c"<") { x < y } else if streq(s, c">") { x > y }
                    else if streq(s, c"<=") { x <= y } else { x >= y }
                };
            a = r as u64;
            at = int_t;
            continue;
        }
        let r = if streq(s, c"|") { x | y } else if streq(s, c"^") { x ^ y }
            else if streq(s, c"&") { x & y } else if streq(s, c"+") { x.wrapping_add(y) }
            else if streq(s, c"-") { x.wrapping_sub(y) }
            else if streq(s, c"*") { x.wrapping_mul(y) }
            else {
                if y == 0 {
                    ev_fail(pcx, ccx);
                    return (0, t);
                }
                if streq(s, c"/") {
                    if signed { (x as i64).wrapping_div(y as i64) as u64 } else { x / y }
                } else {
                    if signed { (x as i64).wrapping_rem(y as i64) as u64 } else { x % y }
                }
            };
        a = ev_convert(r, t, ccx);
        at = t;
    }
}

pub fn ev_unary(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (u64, i64) {
    if ev_eat(c"-", pcx, ccx) {
        let (v, t) = ev_unary(ccx, pcx);
        let p = ev_promote(t, ccx);
        return (ev_convert(v.wrapping_neg(), p, ccx), p);
    }
    if ev_eat(c"+", pcx, ccx) {
        let (v, t) = ev_unary(ccx, pcx);
        return (v, ev_promote(t, ccx));
    }
    if ev_eat(c"~", pcx, ccx) {
        let (v, t) = ev_unary(ccx, pcx);
        let p = ev_promote(t, ccx);
        return (ev_convert(!v, p, ccx), p);
    }
    if ev_eat(c"!", pcx, ccx) {
        let (v, _) = ev_unary(ccx, pcx);
        return ((v == 0) as u64, cty_int(if ccx.ev_decl { 32 } else { 64 }, true, ccx));
    }
    if ccx.ev_decl {
        let (handled, v, t) = cdecl_eval_special(ccx, pcx);
        if handled {
            return (v, t);
        }
    }
    ev_primary(ccx, pcx)
}

fn ev_primary(ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (u64, i64) {
    unsafe {
        let t = ev_peek(pcx, ccx);
        if t == pcx.c_eof {
            ev_fail(pcx, ccx);
            return (0, cty_int(32, true, ccx));
        }
        if ev_eat(c"(", pcx, ccx) {
            let r = ev_cond(ccx, pcx);
            if !ev_eat(c")", pcx, ccx) {
                ev_fail(pcx, ccx);
            }
            return r;
        }
        ccx.ev_pos += 1;
        let kind = (*pcx.ctoks.add(t as usize)).kind;
        if kind == Num {
            return ev_number(t, ccx, pcx);
        }
        if kind == Char {
            return (char_value(t, pcx), cty_int(32, true, ccx));
        }
        if kind == Ident {
            let sym = (*pcx.ctoks.add(t as usize)).text;
            if is_query_builtin(sym, pcx) || sym == ccx.s_has_include
                || sym == ccx.s_has_include_next {
                // Feature queries reached through macros: "no".
                if ev_eat(c"(", pcx, ccx) {
                    let mut depth: i64 = 1;
                    while depth > 0 && ccx.ev_pos < ccx.ev_n {
                        if ev_at(c"(", pcx, ccx) {
                            depth += 1;
                        } else if ev_at(c")", pcx, ccx) {
                            depth -= 1;
                        }
                        ccx.ev_pos += 1;
                    }
                }
                return (0, cty_int(64, true, ccx));
            }
            if !ccx.ev_decl && sym == ccx.s_defined {
                // `defined` made by a macro's expansion (GCC accepts it).
                let paren = ev_eat(c"(", pcx, ccx);
                let name = ev_peek(pcx, ccx);
                ccx.ev_pos += 1;
                if paren {
                    ev_eat(c")", pcx, ccx);
                }
                return (is_defined((*pcx.ctoks.add(name as usize)).text, ccx, pcx) as u64,
                    cty_int(64, true, ccx));
            }
            if !ccx.ev_decl {
                if streq(ctok_text(t, pcx), c"true") {
                    return (1, cty_int(64, true, ccx));
                }
                return (0, cty_int(64, true, ccx));
            }
            let (found, v, vt) = cdecl_ident_value(sym, ccx);
            if found {
                return (v, vt);
            }
        }
        ev_fail(pcx, ccx);
        (0, cty_int(32, true, ccx))
    }
}

// The value and type of an integer literal (C11 6.4.4.1). 0 type: not one.
fn ev_number(t: i64, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) -> (u64, i64) {
    unsafe {
        let text = sym_name((*pcx.ctoks.add(t as usize)).text, pcx);
        let n = strlen(text) as i64;
        let mut end = 0 as *mut u8;
        let mut base: i64 = 10;
        let mut digits = text;
        if n > 1 && (*text.add(0)) == b'0' && ((*text.add(1)) == b'x' || (*text.add(1)) == b'X') {
            base = 16;
        }
        else if n > 1 && (*text.add(0)) == b'0'
            && ((*text.add(1)) == b'b' || (*text.add(1)) == b'B') {
            base = 2;
            digits = text.add(2);
        } else if (*text.add(0)) == b'0' {
            base = 8;
        }
        let value = strtoull(digits, &mut end, base as i32);
        // The suffix: u, l, ll in any case and order.
        let mut unsigned = false;
        let mut longs: i64 = 0;
        let mut p = end;
        while (*p.add(0)) != 0 {
            let c = (*p.add(0));
            if c == b'u' || c == b'U' {
                unsigned = true;
            } else if c == b'l' || c == b'L' {
                longs += 1;
            } else {
                // A float, or an unknown suffix.
                ev_fail(pcx, ccx);
                return (0, 0);
            }
            p = p.add(1);
        }
        if !ccx.ev_decl {
            return (value, cty_int(64, !(unsigned || value > 9223372036854775807), ccx));
        }
        let fits_int = value <= 2147483647;
        let fits_uint = value <= 4294967295;
        let fits_long = value <= 9223372036854775807;
        let ty = if longs == 0 && !unsigned && fits_int { cty_int(32, true, ccx) }
            else if longs == 0 && fits_uint && (unsigned || base != 10) { cty_int(32, false, ccx) }
            else if !unsigned && fits_long { cty_int(64, true, ccx) }
            else { cty_int(64, false, ccx) };
        (value, ty)
    }
}

fn char_value(t: i64, pcx: &Ctx<Comp>) -> u64 {
    unsafe {
        let text = sym_name((*pcx.ctoks.add(t as usize)).text, pcx);
        let mut i: i64 = 0;
        while (*text.add(i as usize)) != b'\'' {
            i += 1;
        }
        i += 1;
        let c = (*text.add(i as usize));
        if c != b'\\' {
            return (c as i8) as i64 as u64;
        }
        let e = (*text.add((i + 1) as usize));
        let v: i64 = if e == b'n' { 10 } else if e == b't' { 9 } else if e == b'r' { 13 }
            else if e == b'0' && !is_digit((*text.add((i + 2) as usize))) { 0 }
            else if e == b'a' { 7 } else if e == b'b' { 8 } else if e == b'f' { 12 }
            else if e == b'v' { 11 }
            else if e == b'x' {
                let mut end = 0 as *mut u8;
                strtoull(text.add((i + 2) as usize), &mut end, 16) as i64
            } else if is_digit(e) {
                let mut end = 0 as *mut u8;
                strtoull(text.add((i + 1) as usize), &mut end, 8) as i64
            } else { e as i64 };
        ((v as u64 as u8) as i8) as i64 as u64
    }
}
