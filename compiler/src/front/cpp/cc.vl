// The C compiler's settings: its predefined macros and its include search
// path, asked from the target's C compiler (`cc -dM -E -v`, or
// $VOLE_CC), so that headers mean what they mean to C on this machine.

use crate::base::{
    buf_byte, buf_bytes, buf_copy, buf_fmt, buf_len, buf_new, buf_ptr, buf_str, cstr, die, die2,
    env_first_byte, env_var, intern_c,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::ctx::CImportCx;
use crate::front::cpp::input::{c_load_text, push_frame, raw_next};

// Runs `command` (a C string) and returns its output (stdout and stderr).
pub fn run_command(command: *mut u8) -> i64 {
    let out = buf_new();
    let mut line: [u8; 4096] = [0u8; 4096];
    // UNSAFE: POSIX's popen and pclose and C's fgets: another program
    // run, and its output read; C calls
    // SAFETY: command is a NUL-terminated string (base::cstr's
    // convention: a literal, or a buffer ended with a NUL byte); the
    // stream popen returns is checked before it is read and closed once,
    // after the last read; fgets writes at most 4096 bytes into `line`,
    // which has that many, and ends them with a NUL, so buf_str reads
    // inside `line`
    unsafe {
        let pipe = popen(command, c"r");
        if pipe == 0 as *mut u8 {
            die2(c"cannot run ", command);
        }
        while fgets(line.as_mut_ptr(), 4096, pipe) != 0 as *mut u8 {
            buf_str(out, line.as_mut_ptr());
        }
        pclose(pipe);
    }
    out
}

// Whether $VOLE_CC names the C compiler for headers (0.9: then it is
// trusted to be one for the target, even when cross-compiling).
pub fn c_compiler_given() -> bool {
    env_first_byte(c"VOLE_CC") != 0
}

// The C compiler for headers: $VOLE_CC, or cc.
fn c_compiler() -> Vec<u8, Comp> {
    if c_compiler_given() { env_var(c"VOLE_CC") } else { cstr(c"cc") }
}

// Asks the target's C compiler for its predefined macros (-dM) and its
// include search path (-v), and defines and records them.
pub fn cpp_query_compiler(target_flags: *mut u8, ccx: &mut CImportCx<Comp>, pcx: &mut Ctx<Comp>) {
    let b = buf_new();
    buf_fmt(b,
        format_args("{}{} -dM -E -v -x c /dev/null 2>&1\0",
            str::from_utf8(&c_compiler()).unwrap(),
            str::from_utf8(&cstr(target_flags)).unwrap()));
    let out = run_command(buf_ptr(b));
    let text = buf_copy(out);
    let n = text.len() as i64;
    // Lines: "#define ..." are macros; between "#include <...> search
    // starts here:" and "End of search list." are directories.
    let defines = buf_new();
    let mut in_dirs = false;
    let mut i: i64 = 0;
    let mut found_dirs = false;
    while i < n {
        let mut j = i;
        while j < n && text[j as usize] != b'\n' {
            j += 1;
        }
        let line = &text[i as usize..j as usize];
        if starts_with(line, b"#define ") {
            buf_fmt(defines,
                { let line = str::from_utf8(line).unwrap(); format_args("{line}\n") });
        } else if starts_with(line, b"#include <...> search starts here:") {
            in_dirs = true;
            found_dirs = true;
        } else if starts_with(line, b"End of search list.") {
            in_dirs = false;
        } else if in_dirs && line.len() > 1 && line[0] == b' ' {
            // " /path" or " /path (framework directory)".
            let mut e = line.len() as i64;
            if ends_with(line, b" (framework directory)") {
                e = 0;
            }
            if e > 0 {
                let d = buf_new();
                buf_bytes(d, &line[1..e as usize]);
                buf_byte(d, 0);
                pcx.cdirs.push(buf_ptr(d) as i64);
            }
        }
        i = j + 1;
    }
    if !found_dirs {
        let msg = buf_new();
        buf_str(msg, c"the C compiler gave no include search path for the target (");
        buf_fmt(msg,
            format_args("{}); its output was:\n{}\0",
                &str::from_utf8(
                    buf_copy(b)[0..(buf_len(b) - 1) as usize]).unwrap(),
                str::from_utf8(&text).unwrap()));
        die(buf_ptr(msg));
    }
    // The predefined macros, as a file of #defines.
    ccx.defining_builtins = true;
    let f = c_load_text(c"<built-in>", defines, ccx, pcx);
    push_frame(f, ccx, pcx);
    loop {
        let t = raw_next(ccx, pcx);
        if t == pcx.c_eof {
            break;
        }
    }
    ccx.defining_builtins = false;
    // Not C syntax vole reads: blocks (`^`).
    ccx.macro_of.put(intern_c(c"__BLOCKS__", pcx) + 1, 0);
}

fn starts_with(s: &[u8], prefix: &[u8]) -> bool {
    s.len() >= prefix.len() && &s[..prefix.len()] == prefix
}

fn ends_with(s: &[u8], suffix: &[u8]) -> bool {
    s.len() >= suffix.len() && &s[s.len() - suffix.len()..] == suffix
}

// UNSAFE: POSIX's popen, pclose and C's fgets: the C importer asks the system's C compiler for
// its include paths and predefined macros by running it.
// SAFETY: each declaration is the function's C prototype on the targets vole builds for (64-bit
// macOS and Linux: int is i32, size_t u64, long and long long i64, a pointer 8 bytes); a FILE*
// is held as an opaque *mut u8 and only passed back; what a call must hold is said at the call.
pub extern "C" {
    fn popen(command: *mut u8, mode: *mut u8) -> *mut u8;
    fn pclose(stream: *mut u8) -> i32;
    fn fgets(buf: *mut u8, size: i32, stream: *mut u8) -> *mut u8;
}
