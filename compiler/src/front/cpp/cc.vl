// The C compiler's settings: its predefined macros and its include search
// path, asked from the target's C compiler (`cc -dM -E -v`, or
// $VOLE_CC), so that headers mean what they mean to C on this machine.

use crate::base::{
    BUFS, alloc_zeroed, buf_byte, buf_bytes, buf_fmt, buf_new, buf_slice, buf_str, cstr, die, die2,
    intern_c, memcmp, strlen,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::front::cimport::ctx::CImportCx;
use crate::front::cpp::input::{c_load_text, push_frame, raw_next};

// Runs `command` and returns its output (stdout and stderr).
pub fn run_command(command: *u8) -> i64 {
    unsafe {
        let out = buf_new();
        let pipe = popen(command, c"r");
        if pipe == 0 as *u8 {
            die2(c"cannot run ", command);
        }
        let line = alloc_zeroed(4096);
        while fgets(line, 4096, pipe) != 0 as *u8 {
            buf_str(out, line);
        }
        pclose(pipe);
        out
    }
}

// Whether $VOLE_CC names the C compiler for headers (0.9: then it is
// trusted to be one for the target, even when cross-compiling).
pub fn c_compiler_given() -> bool {
    unsafe {
        let env = getenv(c"VOLE_CC");
        env != 0 as *u8 && env[0] != 0
    }
}

// The C compiler for headers: $VOLE_CC, or cc.
fn c_compiler() -> *u8 {
    unsafe {
        let env = getenv(c"VOLE_CC");
        if env != 0 as *u8 && env[0] != 0 { env } else { c"cc" }
    }
}

// Asks the target's C compiler for its predefined macros (-dM) and its
// include search path (-v), and defines and records them.
pub fn cpp_query_compiler(target_flags: *u8, ccx: inout CImportCx<Comp>, pcx: inout Ctx<Comp>) {
    unsafe {
        let b = buf_new();
        buf_fmt(b,
            format_args("{}{} -dM -E -v -x c /dev/null 2>&1\0", cstr(c_compiler()),
                cstr(target_flags)));
        let out = run_command(BUFS[b].data);
        buf_byte(out, 0);
        let text = BUFS[out].data;
        let n = BUFS[out].len - 1;
        // Lines: "#define ..." are macros; between "#include <...> search
        // starts here:" and "End of search list." are directories.
        let defines = buf_new();
        var in_dirs = false;
        var i = 0;
        var found_dirs = false;
        while i < n {
            var j = i;
            while j < n && text[j] != '\n' {
                j += 1;
            }
            let line = text[i..j];
            if starts_with(line, c"#define ") {
                buf_fmt(defines, format_args("{line}\n"));
            } else if starts_with(line, c"#include <...> search starts here:") {
                in_dirs = true;
                found_dirs = true;
            } else if starts_with(line, c"End of search list.") {
                in_dirs = false;
            } else if in_dirs && line.len > 1 && line[0] == ' ' {
                // " /path" or " /path (framework directory)".
                var e = line.len as i64;
                if ends_with(line, c" (framework directory)") {
                    e = 0;
                }
                if e > 0 {
                    let d = buf_new();
                    buf_bytes(d, line[1..e]);
                    buf_byte(d, 0);
                    pcx.cdirs.push(BUFS[d].data as i64);
                }
            }
            i = j + 1;
        }
        if !found_dirs {
            let msg = buf_new();
            buf_str(msg, c"the C compiler gave no include search path for the target (");
            buf_fmt(msg,
                format_args("{}); its output was:\n{}\0", buf_slice(b)[0..BUFS[b].len - 1],
                    text[0..n]));
            die(BUFS[msg].data);
        }
        // The predefined macros, as a file of #defines.
        ccx.defining_builtins = true;
        let f = c_load_text(c"<built-in>", defines, &ccx, &pcx);
        push_frame(f, &ccx, &pcx);
        loop {
            let t = raw_next(&ccx, &pcx);
            if t == pcx.c_eof {
                break;
            }
        }
        ccx.defining_builtins = false;
        // Not C syntax vole reads: blocks (`^`).
        ccx.macro_of.put(intern_c(c"__BLOCKS__", &pcx) + 1, 0);
    }
}

fn starts_with(s: [u8], prefix: *u8) -> bool {
    unsafe {
        let n = strlen(prefix);
        s.len as u64 >= n && memcmp(s.ptr, prefix, n) == 0
    }
}

fn ends_with(s: [u8], suffix: *u8) -> bool {
    unsafe {
        let n = strlen(suffix);
        s.len as u64 >= n && memcmp(&s.ptr[s.len as i64 - n as i64], suffix, n) == 0
    }
}

pub extern "C" {
    fn popen(command: *u8, mode: *u8) -> *u8;
    fn pclose(stream: *u8) -> i32;
    fn fgets(buf: *u8, size: i32, stream: *u8) -> *u8;
    fn getenv(name: *u8) -> *u8;
}
