// Generics (0.5): monomorphization, checked at instantiation.
//
// A generic function, struct or enum is a template: it is never checked
// as it is written. Each use with new type arguments makes an instance:
// a struct or enum of its own (fields resolved with the parameters bound
// to the arguments), or a function of its own whose AST is a copy of the
// template's, checked with the parameters bound. The middle end and the
// code generators only ever see instances. Instances are made in the
// order the checker meets them, so their order and names are
// deterministic.
//
// Type arguments are written (`Vec<i64>`, `max::<i64>(...)`,
// `Vec::<u8>::new()`, `Pair::<i64> { ... }`) or inferred: from the types
// of the arguments (or fields), and from the type the context expects.
//
// Symbols: an instance's symbol is its template's, then `.G` and its type
// arguments in a self-delimiting code (mangle_type): `max.Gl` is
// max::<i64>, `Vec.Gl.push` is the method push of Vec<i64>.
//
// Here: the type parameters in scope, names and symbols of instances, and
// the instances of structs and enums; in instantiate.vl: inference and
// the instances of functions.

pub mod instantiate;

use crate::base::{
    alloc_zeroed, buf_byte, buf_bytes, buf_int, buf_new, buf_slice, buf_str, free, intern, intern_c,
    sym_text,
};
use crate::base::comp::Comp;
use crate::base::ctx::Ctx;
use crate::base::diag::{err_begin, err_end, err_int, err_str, err_sym, error_at};
use crate::front::ast::{NodeKind, child};
use crate::front::ast::NodeKind::{Float, Fn, Int, Unary};
use crate::front::check::mismatch_error;
use crate::front::check::args::{check_default_arg, is_default_arg};
use crate::front::check::check_mode::{check_expr, coerce_ref};
use crate::front::check::collect::{
    collect_enum_variants, collect_struct_fields, new_enum, new_struct,
};
use crate::front::check::resolve::{enum_cycle_error, resolve_type, struct_cycle_error};
use crate::front::check::widen::try_widen;
use crate::front::lexer::{SUF_NONE, Tok};
use crate::front::modules::{item_symbol, module_of};
use crate::front::traits::check_bounds;
use crate::front::types::{
    ENUMS, TY_I8, TY_NEVER, TyKind, buf_type, enum_type, fn_param, struct_type, type_elem,
};

// What other modules use of the parts.

// The deepest nesting of instantiations in instantiations, and the largest
// type argument (see type_size); in 0.14 from 64 instances and 12 levels
// of type: iterator chains nest both a level per adapter.
const MAX_INST_DEPTH: i64 = 2000;
const MAX_TYPE_SIZE: i64 = 4096;

// Binds the parameters `params` (a Generics node) to the `count` types at
// TLISTS[targs...]; returns what env_leave restores.
pub fn env_enter(params: i64, targs: i64, count: i64, pcx: inout Ctx<Comp>) -> i64 {
    let saved = pcx.tp_base;
    pcx.tp_base = pcx.tp_names.count;
    for i in 0..count {
        unsafe {
            pcx.tp_names.push(pcx.nodes[child(params, i, pcx)].a);
            pcx.tp_types.push(pcx.tlists.data[targs + i]);
        }
    }
    if params > 0 && count > 0 {
        pcx.tp_scopes.push(pcx.tp_base);
        pcx.tp_scopes.push(params);
    }
    saved
}

pub fn env_leave(saved: i64, pcx: inout Ctx<Comp>) {
    // UNSAFE: IntVec is a raw table (base/comp.vl); every read is.
    // SAFETY: count >= 2 before data[count - 2] is read.
    while pcx.tp_scopes.count >= 2 && unsafe { pcx.tp_scopes.data[pcx.tp_scopes.count - 2] }
    >= pcx.tp_base {
        pcx.tp_scopes.count -= 2;
    }
    pcx.tp_names.count = pcx.tp_base;
    pcx.tp_types.count = pcx.tp_base;
    pcx.tp_base = saved;
}

// (0.27.2) The parameter node (of a Generics node, its bounds in .h) the
// type parameter `name` in scope was bound from by env_enter, or 0. RULE:
// F11.3 (`I::Output` through I's bounds)
pub fn env_param_node(name: i64, pcx: Ctx<Comp>) -> i64 {
    // UNSAFE: IntVec is a raw table (base/comp.vl); every read is.
    // SAFETY: k + 1 < count, and base + j < tp_names.count are checked
    // before each read.
    unsafe {
        var k = pcx.tp_scopes.count - 2;
        while k >= 0 {
            let base = pcx.tp_scopes.data[k];
            let params = pcx.tp_scopes.data[k + 1];
            k -= 2;
            if base != pcx.tp_base {
                continue;
            }
            // (an entry another scope left behind: its names must be these)
            var p = 0;
            for j in 0..pcx.nodes[params].count {
                let c = child(params, j, pcx);
                if base + j >= pcx.tp_names.count || pcx.tp_names.data[base + j] != pcx.nodes[c].a {
                    p = -1;
                    break;
                }
                if pcx.nodes[c].a == name && p == 0 {
                    p = c;
                }
            }
            if p > 0 {
                return p;
            }
        }
        0
    }
}

// The type a type parameter in scope stands for, or 0.
pub fn env_lookup(name: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        for i in pcx.tp_base..pcx.tp_names.count {
            if pcx.tp_names.data[i] == name {
                return pcx.tp_types.data[i];
            }
        }
        0
    }
}

pub fn hint_for(n: i64, pcx: Ctx<Comp>) -> i64 {
    if pcx.hint_node == n { pcx.hint_ty } else { 0 }
}

pub fn mark_synthed(n: i64, pcx: inout Ctx<Comp>) {
    pcx.synthed.put(n + 1, 1);
}

// Checks argument (or field value) `arg` against `ty`; it may have been
// synthesized already, to infer type arguments.
pub fn check_arg(arg: i64, ty: i64, pcx: inout Ctx<Comp>) {
    // (0.15: a default, checked in its function's module)
    if is_default_arg(arg, pcx) {
        check_default_arg(arg, ty, &pcx);
        return;
    }
    if pcx.synthed.get(arg + 1) == 0 {
        check_expr(arg, ty, &pcx);
        return;
    }
    // (0.25.1: `&v` inferred from, given to a let `[T]`: conv.marker_extra,
    // as check_expr says it, then v checked as itself)
    let start = pcx.nodes[arg].start;
    crate::front::conv::extra_marker(arg, ty, &pcx);
    if pcx.nodes[arg].start != start {
        check_expr(arg, ty, &pcx);
        return;
    }
    let actual = pcx.nodes[arg].ty;
    if actual != ty && actual != TY_NEVER {
        // (0.15: a narrower integer)
        if try_widen(arg, actual, ty, &pcx) {
            return;
        }
        // (0.26.3: a let field's value, synthesized to infer a generic
        // struct's parameters, `Desc { s: d.make(gpa)?, n: 1 }`: lent as
        // a temporary of its statement, as check_expr lends it)
        if pcx.types[ty].kind == TyKind::Ptr && pcx.types[ty].b == crate::front::types::REF_SHARED
            && pcx.types[ty].a == actual
            && crate::front::check::check_mode::lendable_value(arg, actual, &pcx) {
            crate::front::check::check_mode::lend_temporary(arg, ty, &pcx);
            return;
        }
        // (0.17: a reference where a pointer or a slice is expected)
        if coerce_ref(arg, actual, ty, &pcx) {
            pcx.nodes[arg].ty = ty;
            return;
        }
        // (0.25.1: a String where its bytes go, `[T]` inferred from it)
        if crate::front::check::check_mode::coerce_text(arg, actual, ty, &pcx) {
            return;
        }
        mismatch_error(arg, ty, actual, &pcx);
    }
}

// (0.25) Argument `arg` of call to function f, its parameter i: checked as
// check_arg does; a value given to a let parameter that borrows
// (`total(make())`, `h.f(mk())`, `gl(make())`, `f(g()?)`) is lent as a
// temporary of the statement (check_mode::LET_ARG). `x?` is checked as
// the value it makes, then lent: checked against the reference, its
// match would lend the binding of its arm, dropped before the call.
pub fn check_call_arg(arg: i64, f: i64, i: i64, pcx: inout Ctx<Comp>) {
    let lets = f >= 0
        && crate::front::conv::fn_param_conv(f, i, pcx) == crate::front::conv::CONV_LET;
    if lets && pcx.nodes[arg].kind == NodeKind::Unary
        && pcx.nodes[arg].op == crate::front::lexer::Tok::Amp
        && (pcx.nodes[arg].p & crate::front::ast::NODE_REF_MUT) == 0
        && crate::front::check::rust::rust_node(arg, &pcx)
        && !crate::front::conv::user_at(pcx.nodes[crate::front::conv::param_node(f, i, pcx)].start,
            &pcx) {
        // (0.27.0, a seam of the rust edition on MVS std: a let parameter
        // of std's takes a place or a value and lends it, `&T` or a copy
        // by T; `&x` given to it, Rust's `v.contains(&x)`, is x lent so)
        pcx.nodes[arg] = pcx.nodes[pcx.nodes[arg].b];
    }
    // (0.27.1: an argument of a rust-edition function, R5 closed)
    let saved = pcx.rust_arg;
    pcx.rust_arg = if f >= 0 && crate::front::check::rust::rust_node(arg, &pcx)
        && crate::places::regions::rust_fn(f, &pcx) { arg } else { 0 };
    check_param_arg(arg, fn_param(f, i, pcx), lets, &pcx);
    pcx.rust_arg = saved;
}

// (0.25.4) Argument `arg` given to a parameter of type `ty`, `lets` when
// the parameter is `let`: check_call_arg's, and a closure's parameters'
// (closures::closure_call), which lend a temporary as a function's do.
pub fn check_param_arg(arg: i64, ty: i64, lets: bool, pcx: inout Ctx<Comp>) {
    if lets && pcx.nodes[arg].kind == NodeKind::Try && pcx.synthed.get(arg + 1) == 0 && ty > 0
        && pcx.types[ty].kind == TyKind::Ptr && pcx.types[ty].b == crate::front::types::REF_SHARED
        && !is_default_arg(arg, pcx) {
        check_expr(arg, pcx.types[ty].a, &pcx);
        if pcx.nodes[arg].ty == pcx.types[ty].a {
            crate::front::check::check_mode::lend_temporary(arg, ty, &pcx);
        }
        return;
    }
    let saved = pcx.let_arg;
    pcx.let_arg = if lets { arg } else { 0 };
    check_arg(arg, ty, &pcx);
    pcx.let_arg = saved;
}

// An integer or float literal without a suffix (maybe negated): its type
// comes from where it goes, so it is looked at last.
fn is_untyped_literal_expr(n: i64, pcx: Ctx<Comp>) -> bool {
    let kind = pcx.nodes[n].kind;
    if kind == Unary && pcx.nodes[n].op == Tok::Minus {
        return is_untyped_literal_expr(pcx.nodes[n].b, pcx);
    }
    // RULE: F18.5 (d) (an open local goes with the literals)
    if kind == NodeKind::Ident && pcx.open_lets.count > 0 {
        return crate::front::check::literals::open_local(n, pcx) >= 0;
    }
    (kind == Int || kind == Float) && pcx.nodes[n].b == SUF_NONE
}

// ---- Names and symbols ----

// `name<A, B>` for messages.
fn generic_display(name: i64, targs: i64, count: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let out = buf_new();
        buf_bytes(out, sym_text(name, pcx));
        // (0.16: `Buf`, every argument its default)
        if count == 0 {
            return intern(buf_slice(out), &pcx);
        }
        buf_byte(out, '<');
        for i in 0..count {
            if i > 0 {
                buf_str(out, c", ");
            }
            buf_type(out, pcx.tlists.data[targs + i], pcx);
        }
        buf_byte(out, '>');
        intern(buf_slice(out), &pcx)
    }
}

// `base.G<code of each argument>` (0.16: base when there is none, every
// argument of a type its default).
fn generic_symbol(base: i64, targs: i64, count: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if count == 0 {
            return base;
        }
        let out = buf_new();
        buf_bytes(out, sym_text(base, pcx));
        buf_str(out, c".G");
        for i in 0..count {
            mangle_type(out, pcx.tlists.data[targs + i], &pcx);
        }
        intern(buf_slice(out), &pcx)
    }
}

// A code for type t, made of letters, digits, `_` and `.`, from which t
// can be read back: primitives by a letter (as in C++'s mangling), then
// P<t> pointer, S<t> slice, A<n>_<t> array, T<n>_<ts> tuple, F<n>_<ts><t>
// (C<n>_... for extern "C"; U before either for `unsafe fn`) function, and N<length><symbol> for a struct
// or an enum.
pub fn mangle_type(out: i64, t: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        let kind = pcx.types[t].kind;
        if kind == TyKind::Prim {
            // (0.26.2: usize y, isize x)
            let codes: [u8; 15] = ['a', 's', 'i', 'l', 'h', 't', 'j', 'm', 'f', 'd', 'b', 'v', 'z',
                'y', 'x'];
            buf_byte(out, codes[t - TY_I8]);
            return;
        }
        match kind {
            TyKind::Ptr => {
                // (0.17: R<t> `&T`, M<t> `&mut T`)
                buf_byte(out,
                    if pcx.types[t].b == 1 { 'R' } else if pcx.types[t].b == 2 { 'M' }
                    else { 'P' });
                mangle_type(out, pcx.types[t].a, &pcx);
            }
            TyKind::Slice => {
                // (0.17: W<t> `&mut [T]`)
                buf_byte(out, if pcx.types[t].b != 0 { 'W' } else { 'S' });
                mangle_type(out, pcx.types[t].a, &pcx);
            }
            TyKind::Array => {
                buf_byte(out, 'A');
                buf_int(out, pcx.types[t].b);
                buf_byte(out, '_');
                mangle_type(out, pcx.types[t].a, &pcx);
            }
            TyKind::Tuple => {
                buf_byte(out, 'T');
                buf_int(out, pcx.types[t].count);
                buf_byte(out, '_');
                for i in 0..pcx.types[t].count {
                    mangle_type(out, type_elem(t, i, pcx), &pcx);
                }
            }
            TyKind::Fn => {
                // (RULE: F19.3: an `unsafe fn` type is another type)
                if crate::front::types::fn_ty_unsafe(t, pcx) {
                    buf_byte(out, 'U');
                }
                buf_byte(out, if crate::front::types::fn_ty_c(t, pcx) { 'C' } else { 'F' });
                buf_int(out, pcx.types[t].count);
                buf_byte(out, '_');
                for i in 0..pcx.types[t].count {
                    mangle_type(out, type_elem(t, i, pcx), &pcx);
                }
                mangle_type(out, pcx.types[t].a, &pcx);
            }
            TyKind::Struct | TyKind::Enum => {
                let sym = if kind == TyKind::Struct { pcx.structs[pcx.types[t].a].sym }
                    else { ENUMS[pcx.types[t].a].sym };
                buf_byte(out, 'N');
                buf_int(out, sym_text(sym, pcx).len as i64);
                buf_bytes(out, sym_text(sym, pcx));
            }
            // (0.18: a distinct type, by its alias's symbol and its arguments)
            TyKind::Distinct => {
                let alias = pcx.types[t].b;
                // RULE: D21.1 (0.27.2.1: an `impl Tr` result, by its node: its
                // name is source text, with blanks)
                if crate::front::opaque::is_opaque(t, pcx) {
                    buf_byte(out, 'Q');
                    buf_int(out, alias);
                    buf_byte(out, '_');
                    return;
                }
                let sym = item_symbol(module_of(alias, &pcx), pcx.nodes[alias].a, &pcx);
                buf_byte(out, 'D');
                buf_int(out, sym_text(sym, pcx).len as i64);
                buf_bytes(out, sym_text(sym, pcx));
                buf_int(out, pcx.types[t].count);
                buf_byte(out, '_');
                for i in 0..pcx.types[t].count {
                    mangle_type(out, type_elem(t, i, pcx), &pcx);
                }
            }
            _ => buf_byte(out, 'x'),
        }
    }
}

// The size of type t as a tree (its nodes, a type argument counted each
// time it appears), up to MAX_TYPE_SIZE + 1, memoized: instantiations whose
// type arguments grow without end are stopped by it, whether they grow
// deeper (`Option<Option<..>>`) or wider (`(x, x)`), while a chain of a
// few hundred iterator adapters, deep but thin, is not (0.14).
fn type_tree_size(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let known = pcx.type_sizes.get(t + 1);
        if known != 0 {
            return known - 1;
        }
        let kind = pcx.types[t].kind;
        var size = 1;
        if kind == TyKind::Ptr || kind == TyKind::Slice || kind == TyKind::Array {
            size += type_tree_size(pcx.types[t].a, &pcx);
        } else if kind == TyKind::Distinct {
            size += type_tree_size(pcx.types[t].a, &pcx);
            for i in 0..pcx.types[t].count {
                size += type_tree_size(type_elem(t, i, pcx), &pcx);
            }
        } else if kind == TyKind::Tuple || kind == TyKind::Fn {
            for i in 0..pcx.types[t].count {
                size += type_tree_size(type_elem(t, i, pcx), &pcx);
            }
            if kind == TyKind::Fn {
                size += type_tree_size(pcx.types[t].a, &pcx);
            }
        } else if kind == TyKind::Struct && pcx.structs[pcx.types[t].a].tmpl != 0 {
            let s = pcx.types[t].a;
            for i in 0..pcx.structs[s].targ_count {
                size += type_tree_size(pcx.tlists.data[pcx.structs[s].targs + i], &pcx);
            }
        } else if kind == TyKind::Enum && ENUMS[pcx.types[t].a].tmpl != 0 {
            let e = pcx.types[t].a;
            for i in 0..ENUMS[e].targ_count {
                size += type_tree_size(pcx.tlists.data[ENUMS[e].targs + i], &pcx);
            }
        }
        if size > MAX_TYPE_SIZE {
            size = MAX_TYPE_SIZE + 1;
        }
        pcx.type_sizes.put(t + 1, size + 1);
        size
    }
}

// The type arguments TSCRATCH[mark..] (popped) as a new TLISTS range.
pub fn take_targs(mark: i64, pcx: inout Ctx<Comp>) -> i64 {
    let targs = pcx.tlists.count;
    for i in mark..pcx.tscratch.count {
        unsafe { pcx.tlists.push(pcx.tscratch.data[i]); }
    }
    pcx.tscratch.count = mark;
    targs
}

fn same_targs(targs: i64, count: i64, mark: i64, pcx: Ctx<Comp>) -> bool {
    if pcx.tscratch.count - mark != count {
        return false;
    }
    for i in 0..count {
        if unsafe { pcx.tlists.data[targs + i] != pcx.tscratch.data[mark + i] } {
            return false;
        }
    }
    true
}

// (0.16) Instances by template and type arguments, for fn_instance,
// struct_instance and enum_instance, which scanned every function, struct
// or enum at each use of a generic one: open addressing, `ids[slot]` = id +
// 1 (0: empty), `hashes[slot]` its key's hash. A lookup returns the lowest
// id that matches, as the scan did.
pub struct InstIndex { pub ids: *i64, pub hashes: *i64, pub size: i64, pub used: i64 }

// The hash of template `tmpl` with the type arguments TSCRATCH[mark..].
pub fn inst_hash(tmpl: i64, mark: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        var h: u64 = 14695981039346656037;
        h = (h ^ tmpl as u64).wrapping_mul(1099511628211);
        for i in mark..pcx.tscratch.count {
            h = (h ^ pcx.tscratch.data[i] as u64).wrapping_mul(1099511628211);
        }
        ((h ^ (h >> 29)) & 0x7fffffffffffffff) as i64
    }
}

// The first slot of hash h's chain, or -1 (nothing indexed).
pub fn inst_first(ix: InstIndex, h: i64) -> i64 {
    unsafe {
        if ix.size == 0 {
            return -1;
        }
        var slot = h & (ix.size - 1);
        while ix.ids[slot] != 0 && ix.hashes[slot] != h {
            slot = (slot + 1) & (ix.size - 1);
        }
        if ix.ids[slot] == 0 { -1 } else { slot }
    }
}

// The next slot of hash h's chain after `slot`, or -1.
pub fn inst_next(ix: InstIndex, h: i64, slot: i64) -> i64 {
    unsafe {
        var s = (slot + 1) & (ix.size - 1);
        while ix.ids[s] != 0 && ix.hashes[s] != h {
            s = (s + 1) & (ix.size - 1);
        }
        if ix.ids[s] == 0 { -1 } else { s }
    }
}

pub fn inst_id(ix: InstIndex, slot: i64) -> i64 {
    unsafe { ix.ids[slot] - 1 }
}

pub fn inst_add(ix: inout InstIndex, id: i64, h: i64) {
    unsafe {
        if (ix.used + 1) * 2 > ix.size {
            let old_ids = ix.ids;
            let old_hashes = ix.hashes;
            let old_size = ix.size;
            let size = if old_size == 0 { 256 } else { old_size * 2 };
            ix.ids = alloc_zeroed(size * 8) as *i64;
            ix.hashes = alloc_zeroed(size * 8) as *i64;
            ix.size = size;
            ix.used = 0;
            for s in 0..old_size {
                if old_ids[s] != 0 {
                    inst_put(&ix, old_ids[s] - 1, old_hashes[s]);
                }
            }
            free(old_ids as *u8);
            free(old_hashes as *u8);
        }
        inst_put(&ix, id, h);
    }
}

fn inst_put(ix: inout InstIndex, id: i64, h: i64) {
    unsafe {
        var slot = h & (ix.size - 1);
        while ix.ids[slot] != 0 {
            slot = (slot + 1) & (ix.size - 1);
        }
        ix.ids[slot] = id + 1;
        ix.hashes[slot] = h;
        ix.used += 1;
    }
}

fn check_targ_depth(mark: i64, pos: i64, pcx: inout Ctx<Comp>) {
    unsafe {
        for i in mark..pcx.tscratch.count {
            if type_tree_size(pcx.tscratch.data[i], &pcx) > MAX_TYPE_SIZE {
                error_at(pos, c"type arguments nested too deeply (does a generic type instantiate itself with ever larger arguments?)", &pcx);
            }
        }
    }
}

pub fn targ_count_error(pos: i64, what: *u8, name: i64, expected: i64, got: i64,
    pcx: inout Ctx<Comp>) -> ! {
    err_begin(pos, &pcx);
    err_str(what, pcx);
    err_str(c" '", pcx);
    err_sym(name, pcx);
    err_str(c"' takes ", pcx);
    err_int(expected, pcx);
    err_str(if expected == 1 { c" type argument" } else { c" type arguments" }, pcx);
    err_str(c", got ", pcx);
    err_int(got, pcx);
    err_end(&pcx)
}

// ---- Default type parameters (0.16) ----

// The default of type parameter k of generic struct or enum `node`
// (declared in `module`), `A: Allocator = Gpa`: its type, resolved where
// the item is declared with the parameters before it bound to the k types
// on top of TSCRATCH (left there); 0 when it has none.
pub fn param_default(node: i64, module: i64, k: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let params = pcx.nodes[node].g;
        let def = pcx.nodes[child(params, k, pcx)].b;
        if def == 0 {
            return 0;
        }
        let saved = pcx.tp_base;
        pcx.tp_base = pcx.tp_names.count;
        for i in 0..k {
            pcx.tp_names.push(pcx.nodes[child(params, i, pcx)].a);
            pcx.tp_types.push(pcx.tscratch.data[pcx.tscratch.count - k + i]);
        }
        let saved_mod = pcx.cur_mod;
        let saved_self = pcx.self_type;
        pcx.cur_mod = module;
        pcx.self_type = 0;
        let t = resolve_type(def, &pcx);
        pcx.cur_mod = saved_mod;
        pcx.self_type = saved_self;
        env_leave(saved, &pcx);
        t
    }
}

// The type arguments TSCRATCH[mark..] of an instance of `node` completed
// with the defaults of the parameters left out (`Vec<i64>` is `Vec<i64,
// Gpa>`), as far as they have defaults.
fn fill_defaults(node: i64, module: i64, mark: i64, pcx: inout Ctx<Comp>) {
    let params = pcx.nodes[node].g;
    var k = pcx.tscratch.count - mark;
    while k < pcx.nodes[params].count {
        let t = param_default(node, module, k, &pcx);
        if t == 0 {
            return;
        }
        pcx.tscratch.push(t);
        k += 1;
    }
}

// How many of the type arguments TLISTS[targs..targs+count] of an instance
// of `node` its name and symbol show: the trailing ones equal to their
// parameters' defaults are left out, so `Vec<i64, Gpa>` is `Vec<i64>` in
// messages and `Vec.Gl` in symbols, as before defaults existed.
pub fn shown_targs(node: i64, module: i64, targs: i64, count: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        let params = pcx.nodes[node].g;
        var shown = count;
        while shown > 0 && pcx.nodes[child(params, shown - 1, pcx)].b != 0 {
            let mark = pcx.tscratch.count;
            for i in 0..shown - 1 {
                pcx.tscratch.push(pcx.tlists.data[targs + i]);
            }
            let t = param_default(node, module, shown - 1, &pcx);
            pcx.tscratch.count = mark;
            if t != pcx.tlists.data[targs + shown - 1] {
                break;
            }
            shown -= 1;
        }
        shown
    }
}

// How many type arguments template `tpl` (encoded as template_of_key's)
// needs at least: its parameters without defaults.
pub fn required_targs(tpl: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if tpl == TPL_SLICE {
            return 1;
        }
        if tpl >= TPL_DISTINCT {
            return pcx.nodes[pcx.nodes[tpl - TPL_DISTINCT].g].count;
        }
        let node = if tpl > 0 { pcx.structs[tpl - 1].node } else { ENUMS[-tpl - 1].node };
        let params = pcx.nodes[node].g;
        var k = 0;
        while k < pcx.nodes[params].count && pcx.nodes[child(params, k, pcx)].b == 0 {
            k += 1;
        }
        k
    }
}

// ---- Instances of structs and enums ----

// The instance of struct template `tpl` with the type arguments
// TSCRATCH[mark..] (popped).
fn struct_instance(tpl: i64, mark: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    // (0.16: the parameters left out take their defaults)
    if pcx.tscratch.count - mark < pcx.structs[tpl].generic {
        fill_defaults(pcx.structs[tpl].node, pcx.structs[tpl].module, mark, &pcx);
    }
    let count = pcx.tscratch.count - mark;
    if count != pcx.structs[tpl].generic
        && !crate::front::check::alloc_rules::missing_allocator(
            pcx.nodes[pcx.structs[tpl].node].g,
            pcx.structs[tpl].generic, mark, pcx.structs[tpl].name, pos, &pcx) {
        targ_count_error(pos, c"struct", pcx.structs[tpl].name, pcx.structs[tpl].generic, count,
            &pcx);
    }
    // (0.26.3: the allocators left out, Gpa after their error)
    let count = pcx.tscratch.count - mark;
    let h = inst_hash(tpl, mark, pcx);
    var found = -1;
    var slot = inst_first(pcx.struct_instances, h);
    while slot >= 0 {
        let s = inst_id(pcx.struct_instances, slot);
        if pcx.structs[s].tmpl == tpl + 1
            && same_targs(pcx.structs[s].targs, pcx.structs[s].targ_count, mark, pcx)
            && (found < 0 || s < found) {
            found = s;
        }
        slot = inst_next(pcx.struct_instances, h, slot);
    }
    if found >= 0 {
        pcx.tscratch.count = mark;
        return struct_type(found, &pcx);
    }
    check_targ_depth(mark, pos, &pcx);
    let targs = take_targs(mark, &pcx);
    let node = pcx.structs[tpl].node;
    check_bounds(pcx.nodes[node].g, targs, count, pcx.structs[tpl].name,
        if pcx.self_bound_pos >= 0 { pcx.self_bound_pos } else { pos }, &pcx);
    let shown = shown_targs(node, pcx.structs[tpl].module, targs, count, &pcx);
    let s = new_struct(node, generic_display(pcx.structs[tpl].name, targs, shown, &pcx),
        generic_symbol(pcx.structs[tpl].sym, targs, shown, &pcx), pcx.structs[tpl].module,
        &pcx);
    pcx.structs[s].tmpl = tpl + 1;
    inst_add(&pcx.struct_instances, s, h);
    pcx.structs[s].targs = targs;
    pcx.structs[s].targ_count = count;
    let saved_mod = pcx.cur_mod;
    let saved_self = pcx.self_type;
    pcx.cur_mod = pcx.structs[s].module;
    pcx.self_type = 0;
    let saved = env_enter(pcx.nodes[node].g, targs, count, &pcx);
    collect_struct_fields(s, &pcx);
    env_leave(saved, &pcx);
    pcx.cur_mod = saved_mod;
    pcx.self_type = saved_self;
    struct_cycle_error(s, pos, &pcx);
    struct_type(s, &pcx)
}

fn enum_instance(tpl: i64, mark: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.tscratch.count - mark < ENUMS[tpl].generic {
            fill_defaults(ENUMS[tpl].node, ENUMS[tpl].module, mark, &pcx);
        }
        let count = pcx.tscratch.count - mark;
        if count != ENUMS[tpl].generic
            && !crate::front::check::alloc_rules::missing_allocator(pcx.nodes[ENUMS[tpl].node].g,
                ENUMS[tpl].generic, mark, ENUMS[tpl].name, pos, &pcx) {
            targ_count_error(pos, c"enum", ENUMS[tpl].name, ENUMS[tpl].generic, count, &pcx);
        }
        // (0.26.3: the allocators left out, Gpa after their error)
        let count = pcx.tscratch.count - mark;
        let h = inst_hash(tpl, mark, pcx);
        var found = -1;
        var slot = inst_first(pcx.enum_instances, h);
        while slot >= 0 {
            let e = inst_id(pcx.enum_instances, slot);
            if ENUMS[e].tmpl == tpl + 1
                && same_targs(ENUMS[e].targs, ENUMS[e].targ_count, mark, pcx)
                && (found < 0 || e < found) {
                found = e;
            }
            slot = inst_next(pcx.enum_instances, h, slot);
        }
        if found >= 0 {
            pcx.tscratch.count = mark;
            return enum_type(found, &pcx);
        }
        check_targ_depth(mark, pos, &pcx);
        let targs = take_targs(mark, &pcx);
        let node = ENUMS[tpl].node;
        check_bounds(pcx.nodes[node].g, targs, count, ENUMS[tpl].name, pos, &pcx);
        let shown = shown_targs(node, ENUMS[tpl].module, targs, count, &pcx);
        let e = new_enum(node, generic_display(ENUMS[tpl].name, targs, shown, &pcx),
            generic_symbol(ENUMS[tpl].sym, targs, shown, &pcx), ENUMS[tpl].module, &pcx);
        ENUMS[e].tmpl = tpl + 1;
        inst_add(&pcx.enum_instances, e, h);
        ENUMS[e].targs = targs;
        ENUMS[e].targ_count = count;
        let saved_mod = pcx.cur_mod;
        let saved_self = pcx.self_type;
        pcx.cur_mod = ENUMS[e].module;
        pcx.self_type = 0;
        let saved = env_enter(pcx.nodes[node].g, targs, count, &pcx);
        collect_enum_variants(e, &pcx);
        env_leave(saved, &pcx);
        pcx.cur_mod = saved_mod;
        pcx.self_type = saved_self;
        enum_cycle_error(e, pos, &pcx);
        enum_type(e, &pcx)
    }
}

// A template named by a type node (a TyName): struct s as s + 1, enum e
// as -(e + 1); 0 for none.
pub const TPL_NONE: i64 = 0;
// (0.14) The slice types, `impl<T> [T]` and `impl<T> Tr for [T]`: a
// template whose argument is the element type.
pub const TPL_SLICE: i64 = 1099511627776;

// (0.18) A generic distinct type's template (`impl<T> NonNull<T>`):
// TPL_DISTINCT + its alias's node.
pub const TPL_DISTINCT: i64 = 2199023255552;

// (0.27.2) A pattern impl of the rust edition (docs/design/front-rust.md
// F0.3, F4.1, F5.1): its header is any type pattern (`impl<T> Tr for &T`,
// `impl<T> SliceIndex<[T]> for usize`, `impl<K, V> HashMap<K, V, Gpa>`),
// matched against a type by instantiate::match_type, which binds the
// impl's parameters; no type is its instance by template.
pub const TPL_PATTERN: i64 = 3298534883328;

pub fn template_of_key(key: i64, pcx: Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.sym_struct[key] != 0 && pcx.structs[pcx.sym_struct[key] - 1].generic > 0 {
            return pcx.sym_struct[key];
        }
        if pcx.sym_enum[key] != 0 && ENUMS[pcx.sym_enum[key] - 1].generic > 0 {
            return -pcx.sym_enum[key];
        }
        TPL_NONE
    }
}

// Whether type t is an instance of template `tpl` (encoded as above).
pub fn instance_of(t: i64, tpl: i64, pcx: Ctx<Comp>) -> bool {
    unsafe {
        if tpl == TPL_SLICE {
            return pcx.types[t].kind == TyKind::Slice;
        }
        // RULE: F0.3 (a pattern impl covers a type by match_type, not by template)
        if tpl == TPL_PATTERN {
            return false;
        }
        if tpl >= TPL_DISTINCT {
            return pcx.types[t].kind == TyKind::Distinct && pcx.types[t].b == tpl - TPL_DISTINCT;
        }
        if tpl > 0 {
            return pcx.types[t].kind == TyKind::Struct && pcx.structs[pcx.types[t].a].tmpl == tpl;
        }
        tpl < 0 && pcx.types[t].kind == TyKind::Enum && ENUMS[pcx.types[t].a].tmpl == -tpl
    }
}

pub fn instance_targs(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if pcx.types[t].kind == TyKind::Slice {
            return slice_targs(t, &pcx);
        }
        if pcx.types[t].kind == TyKind::Distinct {
            return pcx.types[t].list;
        }
        if pcx.types[t].kind == TyKind::Struct { pcx.structs[pcx.types[t].a].targs }
        else { ENUMS[pcx.types[t].a].targs }
    }
}

pub fn template_name(tpl: i64, pcx: inout Ctx<Comp>) -> i64 {
    unsafe {
        if tpl == TPL_SLICE {
            return intern_c(c"[T]", &pcx);
        }
        if tpl >= TPL_DISTINCT {
            return pcx.nodes[tpl - TPL_DISTINCT].a;
        }
        if tpl > 0 { pcx.structs[tpl - 1].name } else { ENUMS[-tpl - 1].name }
    }
}

// (0.25.5) The text of template tpl's name: SYMS read after template_name
// (which may intern `[T]`, growing SYMS), not before.
pub fn template_text(tpl: i64, pcx: inout Ctx<Comp>) -> [u8] {
    let name = template_name(tpl, &pcx);
    sym_text(name, pcx)
}

fn slice_targs(t: i64, pcx: inout Ctx<Comp>) -> i64 {
    let known = pcx.slice_targs.get(t + 1);
    if known != 0 {
        return known - 1;
    }
    let targs = pcx.tlists.count;
    pcx.tlists.push(pcx.types[t].a);
    pcx.slice_targs.put(t + 1, targs + 1);
    targs
}

// The instance of template tpl with TSCRATCH[mark..].
pub fn template_instance(tpl: i64, mark: i64, pos: i64, pcx: inout Ctx<Comp>) -> i64 {
    if tpl > 0 { struct_instance(tpl - 1, mark, pos, &pcx) }
    else { enum_instance(-tpl - 1, mark, pos, &pcx) }
}
