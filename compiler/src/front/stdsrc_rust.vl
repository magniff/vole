    buf_str(out, c"    add_v_p(c, sel(c\"windowDidChangeBackingProperties:\"), imp_did_backing, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidBecomeKey:\"), imp_did_key, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidResignKey:\"), imp_did_resign, c\"v@:@\");\n    add_v_p(c, sel(c\"windowDidChangeOcclusionState:\"), imp_did_occlusion, c\"v@:@\");\n    add_v_p(c, sel(c\"voleQuit:\"), imp_quit, c\"v@:@\");\n    objc_registerClassPair(c);\n    c\n}\n\n// The menu bar: an application menu with Quit (Command-Q).\n// UNSAFE: AppKit messages on raw object pointers.\n// SAFETY: `app` is the shared NSApplication and `target` our delegate (it\n// implements voleQuit:); the alloc/init objects are +1, released once after\n// the menu bar holds them (addItem:, setSubmenu:, setMainMenu: retain); the\n// NSStrings are autoreleased in new_in's pool.\nunsafe fn make_menu(app: *mut u8, target: *mut u8) {\n    let bar = msg_p(msg_p(class(c\"NSMenu\"), sel(c\"alloc\")), sel(c\"init\"));\n    let app_item = msg_p(msg_p(class(c\"NSMenuItem\"), sel(c\"alloc\")), sel(c\"init\"));\n    msg_v_p(bar, sel(c\"addItem:\"), app_item);\n    let menu = msg_p(msg_p(class(c\"NSMenu\"), sel(c\"alloc\")), sel(c\"init\"));\n    let quit = msg_p_ppp(msg_p(class(c\"NSMenuItem\"), sel(c\"alloc\")),\n        sel(c\"initWithTitle:action:keyEquivalent:\"), nsstring(b\"Quit\"), sel(c\"voleQuit:\"),\n        nsstring(b\"q\"));\n    msg_v_p(quit, sel(c\"setTarget:\"), target);\n    msg_v_p(menu, sel(c\"addItem:\"), quit);\n    msg_v_p(app_item, sel(c\"setSubmenu:\"), menu);\n    msg_v_p(app, sel(c\"setMainMenu:\"), bar);\n    release(quit);\n    release(menu);\n    release(app_item);\n    release(bar);\n}\n\n// Whether a window server session exists (false under ssh or in a\n// launchd daemon), checked before NSApplication is touched.\npub fn has_display() -> bool {\n    // UNSAFE: Core Graphics and Core Foundation C calls.\n    // SAFETY: CGSessionCopyCurrentDictionary returns a +1 dictionary or\n    // null; it is released.\n");
    buf_str(out, c"    unsafe {\n        let d = CGSessionCopyCurrentDictionary();\n        if d == 0 as *mut u8 {\n            return false;\n        }\n        CFRelease(d);\n        true\n    }\n}\n\n// (0.25.2.1) The monotonic clock in nanoseconds (0.28.0: std::time's\n// Instant, the same clock; no extern of this module's own).\nfn now_ns() -> i64 {\n    crate::time::Instant::now().as_nanos() as i64\n}\n\n// (0.25.2.1) Whether the window is not shown (occlusionState lacks\n// NSWindowOcclusionStateVisible, 1 << 1).\n// UNSAFE: an Objective-C message on a raw NSWindow pointer.\n// SAFETY: the caller passes a live NSWindow; occlusionState takes nothing\n// and returns an NSUInteger.\nunsafe fn occluded(win: *mut u8) -> bool {\n    (msg_u(win, sel(c\"occlusionState\")) & 2) == 0\n}\n\n// (0.25.2.1) Why a window's display link gives no frames, for the\n// diagnostic: the display asleep, the screen locked, or the window\n// occluded (`hidden`).\n// UNSAFE: CoreGraphics' C functions and Objective-C messages on the raw\n// CFDictionary and CFBoolean they return.\n// SAFETY: CGSessionCopyCurrentDictionary's result is a +1 dictionary or\n// null, released once after its last use; objectForKey: takes the NSString\n// (autoreleased in the pool popped before the release) and returns a\n// value the dictionary holds, or null, checked before boolValue;\n// CGDisplayIsAsleep takes any display id.\nunsafe fn quiet_reason(hidden: bool) -> &'static [u8] {\n    // Asleep first: a locked screen still shows windows while it is awake.\n    if CGDisplayIsAsleep(CGMainDisplayID()) != 0 {\n        return b\"the display is asleep\";\n    }\n    let d = CGSessionCopyCurrentDictionary();\n    if d != 0 as *mut u8 {\n        let pool = pool_push();\n        // The session dictionary (toll-free bridged to NSDictionary):\n        // its value for this key is a CFBoolean, or absent.\n        let v = msg_p_p(d, sel(c\"objectForKey:\"), nsstring(b\"CGSSessionScreenIsLocked\"));\n");
    buf_str(out, c"        let locked = v != 0 as *mut u8 && msg_b(v, sel(c\"boolValue\"));\n        pool_pop(pool);\n        CFRelease(d);\n        if locked {\n            return b\"the screen is locked\";\n        }\n    }\n    if hidden {\n        return b\"covered, hidden, minimized or on another Space\";\n    }\n    b\"the machine may be too loaded\"\n}\n\npub fn hide_cursor_until_moved() {\n    // UNSAFE: an Objective-C message (objc_msgSend, a C function).\n    // SAFETY: +[NSCursor setHiddenUntilMouseMoves:] takes a BOOL.\n    unsafe { msg_v_b(class(c\"NSCursor\"), sel(c\"setHiddenUntilMouseMoves:\"), true); }\n}\n\nimpl Cocoa<Gpa> {\n    pub fn new_in(gpa: Gpa) -> Result<Cocoa<Gpa>, Error> {\n        if !has_display() {\n            return Err(Error::NoDisplay);\n        }\n        // UNSAFE: AppKit setup through Objective-C messages and the runtime's C\n        // functions, and ST set to a raw pointer to the State.\n        // SAFETY: AppKit setup on the main thread with the documented\n        // selectors and types; ST is set to the State's address, which\n        // stays put (the Vec is never pushed to again) until close.\n        unsafe {\n            if get_st_raw() != 0 as *mut u8 {\n                return Err(Error::Failed(\"one App per process\"));\n            }\n            let pool = pool_push();\n            let app = msg_p(class(c\"NSApplication\"), sel(c\"sharedApplication\"));\n            if app == 0 as *mut u8 {\n                pool_pop(pool);\n                return Err(Error::NoDisplay);\n            }\n            // NSApplicationActivationPolicyRegular.\n            msg_b_i(app, sel(c\"setActivationPolicy:\"), 0);\n            msg_v_b(class(c\"NSWindow\"), sel(c\"setAllowsAutomaticWindowTabbing:\"), false);\n            let view_class = make_view_class();\n            let dc = make_delegate_class();\n            let delegate = msg_p(msg_p(dc, sel(c\"alloc\")), sel(c\"init\"));\n            make_menu(app, delegate);\n");
    buf_str(out, c"            msg_v(app, sel(c\"finishLaunching\"));\n            msg_v_b(app, sel(c\"activateIgnoringOtherApps:\"), true);\n            let off = ivar_getOffset(class_getInstanceVariable(view_class, c\"vole\"));\n            let mut c = Cocoa { st: Vec::with_capacity_in(1usize, gpa) };\n            c.st.push(State {\n                q: Vec::with_capacity_in(64usize, gpa),\n                head: 0,\n                preedit: Vec::new_in(gpa),\n                marked: false,\n                in_key: false,\n                key_text: Vec::new_in(gpa),\n                waiting: false,\n                wake_posted: false,\n                hook: None,\n                hook_ctx: 0 as *mut u8,\n                in_hook: false,\n                watches: Vec::new_in(gpa),\n                reqs: Vec::new_in(gpa),\n                warned: false,\n                app: app,\n                delegate: delegate,\n                target: delegate,\n                view_class: view_class,\n                ivar_off: off,\n            });\n            set_st_raw(&mut c.st[0] as *mut State<Gpa> as *mut u8);\n            pool_pop(pool);\n            Ok(c)\n        }\n    }\n}\n\nimpl State<Gpa> {\n    fn pop(&mut self) -> Option<Event> {\n        if self.head < self.q.len() as i64 {\n            let e = self.q[self.head as usize];\n            self.head += 1;\n            if self.head == self.q.len() as i64 {\n                self.q.clear();\n                self.head = 0;\n            }\n            return Some(e);\n        }\n        None\n    }\n\n    // The next event within `ms` milliseconds (-1: however long it takes,\n    // 0: only what is ready). (0.25.2.1) The wait ends early when a frame\n    // request is due from the timer (late_frames).\n    fn next_event(&mut self, ms: i64) -> Option<Event> {\n        match self.pop() {\n            Some(e) => return Some(e),\n            None => {}\n        }\n        if self.in_hook {\n            return None;\n        }\n");
    buf_str(out, c"        for i in 0..self.watches.len() as i64 {\n            if !self.watches[i as usize].armed {\n                // UNSAFE: a Core Foundation C call on a raw CFFileDescriptor.\n                // SAFETY: a CFFileDescriptor of ours, live until unwatch.\n                unsafe { CFFileDescriptorEnableCallBacks(self.watches[i as usize].cf, 1); }\n                self.watches[i as usize].armed = true;\n            }\n        }\n        let end: i64 = if ms < 0 { -1 } else { now_ns() + ms * 1000000 };\n        loop {\n            let due = self.late_frames();\n            match self.pop() {\n                Some(e) => return Some(e),\n                None => {}\n            }\n            // Wait until the caller's end or the next request the timer\n            // answers, whichever comes first.\n            let now = now_ns();\n            let mut until = end;\n            if due >= 0 && (until < 0 || due < until) {\n                until = due;\n            }\n            let wait: i64 = if ms == 0 { 0 } else if until < 0 { -1 }\n                else if until > now { until - now } else { 0 };\n            self.pump(wait);\n            match self.pop() {\n                Some(e) => return Some(e),\n                None => {}\n            }\n            if ms == 0 || (end >= 0 && now_ns() >= end) {\n                let _ = self.late_frames();\n                return self.pop();\n            }\n        }\n    }\n\n    // Dispatches the NSEvents that come within `wait` nanoseconds (-1:\n    // until one comes; 0: those ready), stopping at the first that queues\n    // an Event.\n    fn pump(&mut self, wait: i64) {\n        // UNSAFE: AppKit's event loop through Objective-C messages on raw object\n        // pointers.\n        // SAFETY: the event loop's AppKit calls with their documented\n        // types, each batch in an autorelease pool; the date is\n        // autoreleased in the outer pool, which outlives the loop.\n        unsafe {\n");
    buf_str(out, c"            let outer = pool_push();\n            let date = if wait < 0 {\n                msg_p(class(c\"NSDate\"), sel(c\"distantFuture\"))\n            } else if wait == 0 {\n                msg_p(class(c\"NSDate\"), sel(c\"distantPast\"))\n            } else {\n                msg_p_d(class(c\"NSDate\"), sel(c\"dateWithTimeIntervalSinceNow:\"),\n                    wait as f64 / 1000000000.0)\n            };\n            loop {\n                let p = pool_push();\n                self.waiting = wait != 0;\n                let ev = msg_p_uppb(self.app,\n                    sel(c\"nextEventMatchingMask:untilDate:inMode:dequeue:\"), 0xFFFFFFFFFFFFFFFF,\n                    date, NSDefaultRunLoopMode, true);\n                self.waiting = false;\n                if ev == 0 as *mut u8 {\n                    pool_pop(p);\n                    break;\n                }\n                if msg_u(ev, sel(c\"type\")) == EV_APP_DEFINED && msg_i(ev, sel(c\"data1\")) == WAKE {\n                    // Something to look at: an Event queued, or (0.25.2.1)\n                    // a window's occlusion changed (late_frames).\n                    self.wake_posted = false;\n                    pool_pop(p);\n                    break;\n                } else {\n                    msg_v_p(self.app, sel(c\"sendEvent:\"), ev);\n                }\n                pool_pop(p);\n                if self.head < self.q.len() as i64 {\n                    break;\n                }\n            }\n            pool_pop(outer);\n        }\n    }\n\n    // (0.25.2.1) A frame was requested for window `win` (its display link\n    // is running).\n    fn request(&mut self, win: *mut u8) {\n        let now = now_ns();\n        for i in 0..self.reqs.len() as i64 {\n            if self.reqs[i as usize].win == win && !self.reqs[i as usize].pending {\n                self.reqs[i as usize].pending = true;\n                self.reqs[i as usize].since = now;\n");
    buf_str(out, c"                if !self.reqs[i as usize].slow {\n                    self.reqs[i as usize].quiet = now;\n                }\n            }\n        }\n    }\n\n    // (0.25.2.1) The display link `link` fired: whether its window's\n    // request was still pending (true for a link not registered).\n    fn answered(&mut self, link: *mut u8) -> bool {\n        for i in 0..self.reqs.len() as i64 {\n            if self.reqs[i as usize].link == link {\n                let was = self.reqs[i as usize].pending;\n                self.reqs[i as usize].pending = false;\n                self.reqs[i as usize].slow = false;\n                return was;\n            }\n        }\n        true\n    }\n\n    fn forget(&mut self, win: *mut u8) {\n        let mut i: i64 = 0;\n        while i < self.reqs.len() as i64 {\n            if self.reqs[i as usize].win == win {\n                self.reqs.remove(i as usize);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    // (0.25.2.1) Answers the frame requests the display link cannot (see\n    // the pitfalls above): queues their Frames, prints the diagnostic\n    // once, and returns when the next pending one is due (ns, -1: none).\n    fn late_frames(&mut self) -> i64 {\n        let mut next: i64 = -1;\n        if self.reqs.len() as i64 == 0 {\n            return next;\n        }\n        let now = now_ns();\n        for i in 0..self.reqs.len() as i64 {\n            let r = self.reqs[i as usize];\n            if !r.pending {\n                continue;\n            }\n            // UNSAFE: a Cocoa message on the request's raw NSWindow.\n            // SAFETY: `r.win` is a live NSWindow (a request is forgotten\n            // when its window closes); occlusionState returns an\n            // NSUInteger.\n            let hidden = unsafe { occluded(r.win) };\n            let due = if r.link == 0 as *mut u8 {\n                r.since + NO_LINK_NS\n            } else if hidden {\n");
    buf_str(out, c"                r.since + FALLBACK_NS\n            } else if r.quiet + QUIET_NS > r.since + FALLBACK_NS {\n                r.quiet + QUIET_NS\n            } else {\n                r.since + FALLBACK_NS\n            };\n            if due > now {\n                if next < 0 || due < next {\n                    next = due;\n                }\n                continue;\n            }\n            if r.link != 0 as *mut u8 {\n                // UNSAFE: a Core Animation message on the raw display link.\n                // SAFETY: setPaused: on the display link the window\n                // retained (live while the request is registered): it does\n                // not answer this request again.\n                unsafe { msg_v_b(r.link, sel(c\"setPaused:\"), true); }\n                if !self.warned && now - r.quiet >= QUIET_NS {\n                    self.warned = true;\n                    // UNSAFE: quiet_reason's C and Objective-C calls.\n                    // SAFETY: see quiet_reason (it takes no pointer).\n                    let why = unsafe { quiet_reason(hidden) };\n                    if hidden {\n                        eprintln(\n                            \"window: no frame in 3 s: the window is occluded or not shown ({why}); frames come 10 a second until it shows (volec guide window)\", why = str::from_utf8(why).unwrap());\n                    } else {\n                        eprintln(\n                            \"window: no frame in 3 s from the display link ({why}); frames come 10 a second from a timer (volec guide window)\", why = str::from_utf8(why).unwrap());\n                    }\n                }\n            }\n            self.reqs[i as usize].pending = false;\n            self.reqs[i as usize].slow = r.link != 0 as *mut u8;\n            self.q.push(Event::Frame(WindowId { n: r.id }));\n        }\n        next\n    }\n\n    fn watch(&mut self, fd: i32) -> bool {\n        let mut ctx = FdContext {\n");
    buf_str(out, c"            version: 0, info: 0 as *mut u8, retain: 0 as *mut u8, release: 0 as *mut u8,\n            describe: 0 as *mut u8,\n        };\n        // UNSAFE: Core Foundation C calls, given a C callback and a raw pointer to\n        // the context.\n        // SAFETY: CFFileDescriptorCreate copies the context; the source\n        // is added to the main run loop in the default mode (the mode\n        // wait runs it in) and removed by unwatch.\n        unsafe {\n            let cf = CFFileDescriptorCreate(0 as *mut u8, fd, false, fd_ready, &mut ctx);\n            if cf == 0 as *mut u8 {\n                return false;\n            }\n            let src = CFFileDescriptorCreateRunLoopSource(0 as *mut u8, cf, 0);\n            CFRunLoopAddSource(CFRunLoopGetMain(), src, kCFRunLoopDefaultMode);\n            CFFileDescriptorEnableCallBacks(cf, 1);\n            self.watches.push(Watch { fd: fd, cf: cf, src: src, armed: true });\n        }\n        true\n    }\n\n    fn unwatch(&mut self, fd: i32) {\n        let mut i: i64 = 0;\n        while i < self.watches.len() as i64 {\n            let w = self.watches[i as usize];\n            if w.fd == fd {\n                // UNSAFE: Core Foundation C calls on the raw source and descriptor.\n                // SAFETY: the source and descriptor watch made (+1 each).\n                unsafe {\n                    CFRunLoopRemoveSource(CFRunLoopGetMain(), w.src, kCFRunLoopDefaultMode);\n                    CFFileDescriptorInvalidate(w.cf);\n                    CFRelease(w.src);\n                    CFRelease(w.cf);\n                }\n                self.watches.remove(i as usize);\n            } else {\n                i += 1;\n            }\n        }\n    }\n\n    fn free(&mut self) {\n        while self.watches.len() as i64 > 0 {\n            let fd = self.watches[0].fd;\n            self.unwatch(fd);\n        }\n        // The delegate was made +1 in new_in.\n        release(self.delegate);\n        self.deleg