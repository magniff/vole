    buf_str(out, c"impl<A: Allocator, B: Allocator> PartialEq<PathBuf<B>> for PathBuf<A> {\n    fn eq(&self, other: &PathBuf<B>) -> bool {\n        self.as_path() == other.as_path()\n    }\n}\n\nimpl<A: Allocator> Eq for PathBuf<A> {}\n\nimpl<A: Allocator> Display for PathBuf<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.s.as_str(), f)\n    }\n}\n\nimpl<A: Allocator> Debug for PathBuf<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.s.as_str(), f)\n    }\n}\n// ---- end mod std::path ----\n}\n// ---- mod std::random ----\npub mod random {\n// EDITION: rust\n// std::random (0.28.0): a pseudo-random generator, MVS's (0.20), vole's\n// own: Rust's std has none (the rand crates' names are kept).\n//\n// xoshiro256++ (Blackman and Vigna), 32 bytes of state, with rand 0.9's\n// names. Seeding from a number is pure and the same on every target\n// (`Xoshiro256pp::seed_from_u64`: splitmix64, as rand_xoshiro seeds it, so\n// the outputs match that crate's); seeding from the system's entropy is io\n// (`from_entropy`). Ranges use Lemire's nearly divisionless method: no\n// bias, a division only in about 1 of 2^64/n draws.\n// mvs: std::random\n\nuse crate::num::wrapping::mul_hi;\n\n// UNSAFE: the OS's random bytes.\n// SAFETY: getentropy fills the len (at most 256) bytes at buf and returns\n// 0, or -1 with nothing promised of them; its one caller passes a slice's\n// pointer and a length within it and within 256.\nextern \"C\" {\n    #[link_name = \"getentropy\"]\n    fn c_getentropy(buf: *mut u8, len: usize) -> i32;\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct Xoshiro256pp {\n    s0: u64,\n    s1: u64,\n    s2: u64,\n    s3: u64,\n}\n\n// One step of splitmix64 on state: the next output.\n#[effects()]\npub fn splitmix64_next(state: &mut u64) -> u64 {\n    *state = state.wrapping_add(0x9e3779b97f4a7c15);\n    let mut z = *state;\n");
    buf_str(out, c"    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n    z ^ (z >> 31)\n}\n\nimpl Xoshiro256pp {\n    // The generator seeded from n through splitmix64 (rand_xoshiro's\n    // seed_from_u64): pure, the same everywhere.\n    #[effects()]\n    pub fn seed_from_u64(n: u64) -> Xoshiro256pp {\n        let mut st = n;\n        let a = splitmix64_next(&mut st);\n        let b = splitmix64_next(&mut st);\n        let c = splitmix64_next(&mut st);\n        let d = splitmix64_next(&mut st);\n        Xoshiro256pp { s0: a, s1: b, s2: c, s3: d }\n    }\n\n    // The generator with this state (not all zero: an all-zero state is\n    // replaced by seed_from_u64(0)'s, as rand_xoshiro does).\n    #[effects()]\n    pub fn from_state(s: [u64; 4]) -> Xoshiro256pp {\n        if s[0] == 0 && s[1] == 0 && s[2] == 0 && s[3] == 0 {\n            return Xoshiro256pp::seed_from_u64(0);\n        }\n        Xoshiro256pp { s0: s[0], s1: s[1], s2: s[2], s3: s[3] }\n    }\n\n    // Its state, for from_state.\n    #[effects()]\n    pub fn state(&self) -> [u64; 4] {\n        [self.s0, self.s1, self.s2, self.s3]\n    }\n\n    // The generator seeded from the system's entropy (getentropy); panics\n    // when the system has none to give.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn from_entropy() -> Xoshiro256pp {\n        let mut b: [u8; 32] = [0; 32];\n        let mut s: [u64; 4] = [0, 0, 0, 0];\n        if !fill_bytes_os(&mut b) {\n            crate::panic::panic(\"from_entropy: the system gave no entropy\");\n        }\n        for i in 0..32 {\n            s[i / 8] |= (b[i] as u64) << ((i % 8) * 8) as u64;\n        }\n        Xoshiro256pp::from_state(s)\n    }\n\n    // The next 64 random bits.\n    #[inline]\n    #[effects()]\n    pub fn next_u64(&mut self) -> u64 {\n        let s0 = self.s0;\n        let s3 = self.s3;\n        let sum = s0.wrapping_add(s3);\n");
    buf_str(out, c"        let result = ((sum << 23) | (sum >> 41)).wrapping_add(s0);\n        let t = self.s1 << 17;\n        let s2 = self.s2 ^ s0;\n        let s3b = s3 ^ self.s1;\n        let s1 = self.s1 ^ s2;\n        let s0b = s0 ^ s3b;\n        self.s0 = s0b;\n        self.s1 = s1;\n        self.s2 = s2 ^ t;\n        self.s3 = (s3b << 45) | (s3b >> 19);\n        result\n    }\n\n    // The next 32 random bits (the high half of next_u64, as rand_xoshiro).\n    #[effects()]\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n    // A uniform u64 in [lo, hi); panics when the range is empty.\n    #[effects(io, panic, diverge)]\n    pub fn random_range_u64(&mut self, lo: u64, hi: u64) -> u64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64(hi - lo)\n    }\n\n    // A uniform i64 in [lo, hi); panics when the range is empty.\n    #[effects(io, panic, diverge)]\n    pub fn random_range_i64(&mut self, lo: i64, hi: i64) -> i64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        let n = (hi as u64).wrapping_sub(lo as u64);\n        (lo as u64).wrapping_add(self.below_u64(n)) as i64\n    }\n\n    // A uniform usize in [lo, hi), for indices; panics when the range is\n    // empty.\n    #[effects(io, panic, diverge)]\n    pub fn random_range_usize(&mut self, lo: usize, hi: usize) -> usize {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64((hi - lo) as u64) as usize\n    }\n\n    // A uniform u64 in [0, n), n > 0: Lemire's method. A draw is rejected\n    // with probability under n / 2^64; after 128 rejections in a row (less\n    // likely than 2^-128) the last one is taken.\n    #[inline]\n    #[effects()]\n    pub fn below_u64(&mut self, n: u64) -> u64 {\n        let mut x = self.next_u64();\n        let mut lo = x.wrapping_mul(n);\n");
    buf_str(out, c"        if lo < n {\n            let t = n.wrapping_neg() % n;\n            for _ in 0..128 {\n                if lo >= t {\n                    break;\n                }\n                x = self.next_u64();\n                lo = x.wrapping_mul(n);\n            }\n        }\n        mul_hi(x, n)\n    }\n\n    // A uniform f64 in [0, 1): 53 random bits.\n    #[effects()]\n    pub fn unit_f64(&mut self) -> f64 {\n        (self.next_u64() >> 11) as f64 * 0.00000000000000011102230246251565\n    }\n\n    // true with probability p (0 <= p <= 1; panics otherwise).\n    #[effects(io, panic, diverge)]\n    pub fn random_bool(&mut self, p: f64) -> bool {\n        if !(p >= 0.0 && p <= 1.0) {\n            crate::panic::panic(\"random_bool: p is not in [0, 1]\");\n        }\n        if p == 1.0 {\n            return true;\n        }\n        // (p * 2^64 < 2^64)\n        let cut = (p * 18446744073709551616.0) as u64;\n        self.next_u64() < cut\n    }\n\n    // Fills buf with random bytes: each next_u64's bytes, least\n    // significant first.\n    // std2: changed: buf a &mut [u8]\n    #[effects(panic, diverge)]\n    pub fn fill_bytes(&mut self, buf: &mut [u8]) {\n        let mut i: usize = 0;\n        while i < buf.len() {\n            let mut x = self.next_u64();\n            let mut k = 0;\n            while k < 8 && i < buf.len() {\n                buf[i] = x as u8;\n                x >>= 8;\n                i += 1;\n                k += 1;\n            }\n        }\n    }\n\n    // Moves the generator 2^128 steps ahead (xoshiro's jump): for 2^128\n    // non-overlapping sequences.\n    #[effects()]\n    pub fn jump(&mut self) {\n        let jump: [u64; 4] = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa,\n            0x39abdc4529b1661c];\n        let mut a: u64 = 0;\n        let mut b: u64 = 0;\n        let mut c: u64 = 0;\n        let mut d: u64 = 0;\n        for i in 0..4 {\n            for bit in 0..64 {\n");
    buf_str(out, c"                if (jump[i] & (1u64 << bit as u64)) != 0 {\n                    a ^= self.s0;\n                    b ^= self.s1;\n                    c ^= self.s2;\n                    d ^= self.s3;\n                }\n                self.next_u64();\n            }\n        }\n        self.s0 = a;\n        self.s1 = b;\n        self.s2 = c;\n        self.s3 = d;\n    }\n}\n\n// Shuffles s uniformly (Fisher-Yates, from the end, as rand's shuffle).\n// std2: changed: s a &mut [T], rng a &mut Xoshiro256pp\n#[effects(diverge, T)]\npub fn shuffle<T>(s: &mut [T], rng: &mut Xoshiro256pp) {\n    let n = s.len();\n    let mut i = n;\n    while i > 1 {\n        i -= 1;\n        let j = rng.below_u64((i + 1) as u64) as usize;\n        s.swap(i, j);\n    }\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 bytes a\n// call); false when the system fails. Rust's getrandom.\n// std2: changed: buf a &mut [u8]\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn fill_bytes_os(buf: &mut [u8]) -> bool {\n    let mut at: usize = 0;\n    while at < buf.len() {\n        let n = if buf.len() - at < 256 { buf.len() - at } else { 256 };\n        let rest = &mut buf[at..at + n];\n        // UNSAFE: the OS writes through a raw pointer.\n        // SAFETY: rest is a live &mut [u8] of n <= 256 bytes, borrowed for\n        // the call; getentropy writes at most n bytes there.\n        if unsafe { c_getentropy(rest.as_mut_ptr(), n) } != 0 {\n            return false;\n        }\n        at += n;\n    }\n    true\n}\n// ---- end mod std::random ----\n}\n// ---- mod std::sys ----\npub mod sys {\n// EDITION: rust\n// std::sys (0.20; std2 0.28.0): the OS layer, thin bindings of the C\n// library, MVS's std::sys in the rust edition. vole's own: Rust's std::sys\n// is private, and this is the libc crate's level, with the `sys_` names\n// and `Result<T, i32>` errnos MVS's had. std::fs, std::process and\n");
    buf_str(out, c"// std::env are Rust's API over the OS; this is for what they do not\n// cover (terminals, pseudo-terminals, poll, descriptors, signals).\n// mvs: std::sys\n\nuse crate::convert::AsRef;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// The target's numbers (std2/rt/sys_macos.vl, sys_linux.vl, which the\n// compiler puts in std::__sys).\npub const SYS_CLOCK_MONOTONIC: i32 = crate::__sys::CLOCK_MONOTONIC;\npub const SYS_EAGAIN: i32 = crate::__sys::EAGAIN;\npub const SYS_ELOOP: i32 = crate::__sys::ELOOP;\npub const SYS_ENAMETOOLONG: i32 = crate::__sys::ENAMETOOLONG;\npub const SYS_ENOSYS: i32 = crate::__sys::ENOSYS;\npub const SYS_ENOTEMPTY: i32 = crate::__sys::ENOTEMPTY;\npub const SYS_ENOTSUP: i32 = crate::__sys::ENOTSUP;\npub const SYS_ETIMEDOUT: i32 = crate::__sys::ETIMEDOUT;\npub const SYS_O_APPEND: i32 = crate::__sys::O_APPEND;\npub const SYS_O_CLOEXEC: i32 = crate::__sys::O_CLOEXEC;\npub const SYS_O_CREAT: i32 = crate::__sys::O_CREAT;\npub const SYS_O_DIRECTORY: i32 = crate::__sys::O_DIRECTORY;\npub const SYS_O_EXCL: i32 = crate::__sys::O_EXCL;\npub const SYS_O_NOCTTY: i32 = crate::__sys::O_NOCTTY;\npub const SYS_O_NONBLOCK: i32 = crate::__sys::O_NONBLOCK;\npub const SYS_O_TRUNC: i32 = crate::__sys::O_TRUNC;\npub const SYS_SIGCHLD: i32 = crate::__sys::SIGCHLD;\npub const SYS_TIOCGWINSZ: u64 = crate::__sys::TIOCGWINSZ;\npub const SYS_TIOCSCTTY: u64 = crate::__sys::TIOCSCTTY;\npub const SYS_TIOCSWINSZ: u64 = crate::__sys::TIOCSWINSZ;\npub const TARGET_OS: i64 = crate::__sys::TARGET_OS;\npub const SYS_PATH_MAX: i64 = crate::__sys::PATH_MAX as i64;\n\n// ---- Sys: errors (0.20) ----\n\n// The OS layer (0.20, docs/design/collections-text-io.md §2.6.1, task A7):\n// thin bindings of the C library, the same on macOS and Linux; what differs\n// between them (flag and errno values, errno's address) is in the target's\n// std::__sys (std2/rt/sys_macos.vl, sys_linux.vl), and a struct whose layout differs\n");
    buf_str(out, c"// is declared once per system (`StatMacos`, `StatLinux`) and chosen by\n// `TARGET_OS`, a constant. Every call's result is a `Result<T, i32>`: the\n// value, or the errno it failed with (`sys_errno_kind` names it). Nothing\n// here retries on EINTR or allocates; paths reach C through a NUL-ended copy\n// in a stack buffer (`sys_cpath`): a path with a NUL in it, or longer than\n// the system's PATH_MAX, fails with EINVAL or ENAMETOOLONG before any call.\n// Every descriptor std opens (`sys_open`, `sys_pipe`, `sys_openpty`) is\n// close-on-exec, so that a spawned program gets only what it is given.\n// Unsafe code: each binding passes C a pointer and a length from a slice it\n// was given, or a pointer to a local or a borrowed struct of the size C\n// writes (the layouts are checked against the headers by tests/run/\n// sys_layout.vl); a slice made from a C string (`sys_cstr_view`) is valid\n// while that string is.\n\n// UNSAFE: C's strlen reads memory up to a NUL through a raw pointer.\n// SAFETY: its prototype is C's (string.h); sys_cstr_view, its one caller,\n// passes a non-null pointer its own caller promises is a NUL-ended string.\nextern \"C\" {\n    #[link_name = \"strlen\"]\n    #[effects()]\n    fn sys_c_strlen(s: *const u8) -> u64;\n}\n\npub const SYS_EPERM: i32 = 1;\npub const SYS_ENOENT: i32 = 2;\npub const SYS_ESRCH: i32 = 3;\npub const SYS_EINTR: i32 = 4;\npub const SYS_EIO: i32 = 5;\npub const SYS_EBADF: i32 = 9;\npub const SYS_ECHILD: i32 = 10;\npub const SYS_ENOMEM: i32 = 12;\npub const SYS_EACCES: i32 = 13;\npub const SYS_EEXIST: i32 = 17;\npub const SYS_EXDEV: i32 = 18;\npub const SYS_ENOTDIR: i32 = 20;\npub const SYS_EISDIR: i32 = 21;\npub const SYS_EINVAL: i32 = 22;\npub const SYS_ENOSPC: i32 = 28;\npub const SYS_EROFS: i32 = 30;\npub const SYS_EPIPE: i32 = 32;\n\n// The kinds of io::Error (§2.6.2) an errno falls into (0.20's\n// io::ErrorKind takes these variants).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum SysErrorKind {\n");
    buf_str(out, c"    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\n// The errno of the last C call that failed (C's `errno`).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_errno() -> i32 {\n    // UNSAFE: errno is C's thread-local int, reached only through the C\n    // library's pointer to it.\n    // SAFETY: sys_errno_location (__error, __errno_location) returns this\n    // thread's errno, an aligned int valid for the thread's life.\n    unsafe { *crate::__sys::errno_location() }\n}\n\n// Sets errno (to 0 before a call whose only failure report is errno).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_errno(e: i32) {\n    // UNSAFE: as sys_errno.\n    // SAFETY: as sys_errno: this thread's errno, which only it writes.\n    unsafe {\n        *crate::__sys::errno_location() = e;\n    }\n}\n\n// The kind of error errno e is, as Rust's std decodes it.\n#[effects()]\npub fn sys_errno_kind(e: i32) -> SysErrorKind {\n    if e == SYS_ENOENT {\n        SysErrorKind::NotFound\n    } else if e == SYS_EPERM || e == SYS_EACCES {\n        SysErrorKind::PermissionDenied\n    } else if e == SYS_EEXIST {\n        SysErrorKind::AlreadyExists\n    } else if e == SYS_EAGAIN {\n        SysErrorKind::WouldBlock\n    } else if e == SYS_EINVAL || e == SYS_ENAMETOOLONG {\n        SysErrorKind::InvalidInput\n    } else if e == SYS_ETIMEDOUT {\n        SysErrorKind::TimedOut\n    } else if e == SYS_EINTR {\n        SysErrorKind::Interrupted\n    } else if e == SYS_EPIPE {\n        SysErrorKind::BrokenPipe\n    } else if e == SYS_ENOTDIR {\n        SysErrorKind::NotADirectory\n    } else if e == SYS_EISDIR {\n        SysErrorKind::IsADirectory\n    } else if e == SYS_ENOTEMPTY {\n");
    buf_str(out, c"        SysErrorKind::DirectoryNotEmpty\n    } else if e == SYS_ENOSYS || e == SYS_ENOTSUP {\n        SysErrorKind::Unsupported\n    } else if e == SYS_ENOMEM {\n        SysErrorKind::OutOfMemory\n    } else {\n        SysErrorKind::Other\n    }\n}\n\n// C's message for errno e (`strerror`) copied into out, cut to its length:\n// the bytes written.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_strerror_into(e: i32, out: &mut [u8]) -> i64 {\n    // (0.25.4) strerror_r, not strerror: strerror may keep the message in\n    // one buffer for every thread.\n    let mut buf = [0u8; 256];\n    // UNSAFE: C's strerror_r writes the message through a raw pointer.\n    // SAFETY: buf is a local of 256 bytes and strerror_r is given 255, so\n    // the message and its NUL stay in buf and buf[255] stays 0 (a message\n    // cut short ends with a NUL too; an unknown errno gets C's \"Unknown\n    // error\" text).\n    let _ = unsafe { crate::__sys::strerror_r(e, buf.as_mut_ptr(), 255) };\n    let mut n: i64 = 0;\n    while n < out.len() as i64 && buf[n as usize] != 0 {\n        out[n as usize] = buf[n as usize];\n        n += 1;\n    }\n    n\n}\n\n// The bytes of the NUL-ended C string at p, without the NUL; empty for a\n// null p. The caller promises that p is null or a NUL-ended string, valid\n// while the slice is used.\n#[effects(unsafe)]\n// UNSAFE: makes a slice from a raw C pointer, whose extent only its NUL\n// tells.\n// SAFETY: (the caller's obligation, above) p is null, or a NUL-ended\n// string that outlives the slice; strlen stops at that NUL, so the slice\n// covers readable bytes only.\npub unsafe fn sys_cstr_view<'a>(p: *const u8) -> &'a [u8] {\n    if p.is_null() {\n        return &EMPTY;\n    }\n    crate::slice::from_raw_parts(p, sys_c_strlen(p) as usize)\n}\n\nstatic EMPTY: [u8; 0] = [];\n\n// The result of a C call returning -1 on failure, as a Result.\nfn sys_check(r: i64) -> Result<i64, i32> {\n    if r == -1 {\n");
    buf_str(out, c"        Err(sys_errno())\n    } else {\n        Ok(r)\n    }\n}\n\nfn sys_check_unit(r: i32) -> Result<(), i32> {\n    if r == -1 {\n        Err(sys_errno())\n    } else {\n        Ok(())\n    }\n}\n\n// ---- Sys: paths (0.20) ----\n\n// A path for C: the bytes and a NUL, in a buffer on the caller's stack.\n#[derive(Clone, Copy)] pub struct SysPath {\n    buf: [u8; 4096],\n}\n\n// A SysPath holding path and its NUL: ENAMETOOLONG when path does not fit\n// the system's PATH_MAX (1024 bytes on macOS, 4096 on Linux, the NUL\n// included), EINVAL when it has a NUL in it. Pass `&p.buf as *u8` of the\n// local holding it (`p.buf.as_ptr()`: a method taking self by value would see a copy).\n#[effects(panic)]\npub fn sys_cpath<P: AsRef<[u8]>>(path: P) -> Result<SysPath, i32> {\n    let path = path.as_ref();\n    if path.len() as i64 >= SYS_PATH_MAX {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    let mut p = SysPath { buf: [0u8; 4096] };\n    for i in 0..path.len() as i64 {\n        let b = path[i as usize];\n        if b == 0 {\n            return Err(SYS_EINVAL);\n        }\n        p.buf[i as usize] = b;\n    }\n    Ok(p)\n}\n\nimpl SysPath {\n}\n\n// ---- Sys: files (0.20) ----\n\n// UNSAFE: the C library's file calls (POSIX), which take raw pointers.\n// SAFETY: each prototype is POSIX's (fcntl.h, unistd.h, sys/stat.h,\n// stdio.h's rename); open and fcntl are variadic in C and declared so; the\n// wrappers below pass pointers into buffers they own or borrow, with their\n// true lengths.\nextern \"C\" {\n    #[link_name = \"open\"]\n    #[effects(io)]\n    fn sys_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    #[effects(io)]\n    fn sys_c_close(fd: i32) -> i32;\n    #[link_name = \"read\"]\n    #[effects(io)]\n    fn sys_c_read(fd: i32, buf: *mut u8, n: u64) -> i64;\n    #[link_name = \"write\"]\n    #[effects(io)]\n    fn sys_c_write(fd: i32, buf: *const u8, n: u64) -> i64;\n    #[link_name = \"pread\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn sys_c_pread(fd: i32, buf: *mut u8, n: u64, off: i64) -> i64;\n    #[link_name = \"pwrite\"]\n    #[effects(io)]\n    fn sys_c_pwrite(fd: i32, buf: *const u8, n: u64, off: i64) -> i64;\n    #[link_name = \"lseek\"]\n    #[effects(io)]\n    fn sys_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn sys_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    #[effects(io)]\n    fn sys_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fstat\"]\n    #[effects(io)]\n    fn sys_c_fstat(fd: i32, st: *mut u8) -> i32;\n    #[link_name = \"stat\"]\n    #[effects(io)]\n    fn sys_c_stat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"lstat\"]\n    #[effects(io)]\n    fn sys_c_lstat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"mkdir\"]\n    #[effects(io)]\n    fn sys_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    #[effects(io)]\n    fn sys_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    #[effects(io)]\n    fn sys_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    #[effects(io)]\n    fn sys_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"dup\"]\n    #[effects(io)]\n    fn sys_c_dup(fd: i32) -> i32;\n    #[link_name = \"dup2\"]\n    #[effects(io)]\n    fn sys_c_dup2(fd: i32, to: i32) -> i32;\n    #[link_name = \"pipe\"]\n    #[effects(io)]\n    fn sys_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    #[effects(io)]\n    fn sys_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"isatty\"]\n    #[effects(io)]\n    fn sys_c_isatty(fd: i32) -> i32;\n}\n\npub const SYS_O_RDONLY: i32 = 0;\npub const SYS_O_WRONLY: i32 = 1;\npub const SYS_O_RDWR: i32 = 2;\npub const SYS_SEEK_SET: i32 = 0;\npub const SYS_SEEK_CUR: i32 = 1;\npub const SYS_SEEK_END: i32 = 2;\nconst SYS_F_GETFD: i32 = 1;\nconst SYS_F_SETFD: i32 = 2;\nconst SYS_F_GETFL: i32 = 3;\nconst SYS_F_SETFL: i32 = 4;\n");
    buf_str(out, c"const SYS_FD_CLOEXEC: i32 = 1;\n\n// Opens path with flags (SYS_O_RDONLY, ..., | SYS_O_CREAT, ...) and, when it\n// creates the file, the permission bits mode (0x1a4: 0644): the descriptor,\n// close-on-exec (SYS_O_CLOEXEC is added).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_open<P: AsRef<[u8]>>(path: P, flags: i32, mode: i32) -> Result<i32, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's open takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call;\n    // open's third argument is variadic, an int.\n    let r = unsafe { sys_c_open(p.buf.as_ptr(), flags | SYS_O_CLOEXEC, mode) };\n    Ok(sys_check(r as i64)? as i32)\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_close(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (close).\n    // SAFETY: close takes an int and touches no memory of ours (a bad\n    // descriptor is EBADF).\n    sys_check_unit(unsafe { sys_c_close(fd) })\n}\n\n// Reads up to buf.len() bytes into buf: how many (0 at the end).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_read(fd: i32, buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's read writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: read writes at most buf.len()\n    // bytes at buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_read(fd, buf.as_mut_ptr(), buf.len() as u64) })\n}\n\n// Writes some of buf: how many bytes.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_write<B: AsRef<[u8]>>(fd: i32, buf: B) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: C's write reads through a raw pointer.\n    // SAFETY: buf is a borrowed slice: write reads at most buf.len() bytes at\n    // buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_write(fd, buf.as_ptr(), buf.len() as u64) })\n}\n\n");
    buf_str(out, c"// Reads into buf from offset off, not moving the file's position.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_pread(fd: i32, buf: &mut [u8], off: i64) -> Result<i64, i32> {\n    // UNSAFE: as sys_read.\n    // SAFETY: as sys_read: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pread(fd, buf.as_mut_ptr(), buf.len() as u64, off) })\n}\n\n// Writes buf at offset off, not moving the file's position.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_pwrite<B: AsRef<[u8]>>(fd: i32, buf: B, off: i64) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: as sys_write.\n    // SAFETY: as sys_write: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pwrite(fd, buf.as_ptr(), buf.len() as u64, off) })\n}\n\n// Moves the position to off from SYS_SEEK_SET, _CUR or _END: the new one.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_lseek(fd: i32, off: i64, whence: i32) -> Result<i64, i32> {\n    // UNSAFE: a C library call (lseek).\n    // SAFETY: lseek takes integers only and touches no memory of ours.\n    sys_check(unsafe { sys_c_lseek(fd, off, whence) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_ftruncate(fd: i32, len: i64) -> Result<(), i32> {\n    // UNSAFE: a C library call (ftruncate).\n    // SAFETY: ftruncate takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_ftruncate(fd, len) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_fsync(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (fsync).\n    // SAFETY: fsync takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_fsync(fd) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_mkdir<P: AsRef<[u8]>>(path: P, mode: i32) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n");
    buf_str(out, c"    // UNSAFE: C's mkdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_mkdir(p.buf.as_ptr(), mode as u32) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_rmdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's rmdir takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_rmdir(p.buf.as_ptr()) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_unlink<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's unlink takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_unlink(p.buf.as_ptr()) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P, Q)]\npub fn sys_rename<P: AsRef<[u8]>, Q: AsRef<[u8]>>(from: P, to: Q) -> Result<(), i32> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = sys_cpath(from)?;\n    let b = sys_cpath(to)?;\n    // UNSAFE: C's rename takes the paths as raw pointers.\n    // SAFETY: a and b hold NUL-ended paths (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_rename(a.buf.as_ptr(), b.buf.as_ptr()) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_dup(fd: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup).\n    // SAFETY: dup takes an int and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup(fd) } as i64)? as i32)\n}\n\n// Makes `to` a copy of fd (closing what `to` was); `to` is not\n// close-on-exec.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_dup2(fd: i32, to: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup2).\n    // SAFETY: dup2 takes integers only and touches no memory of ours.\n");
    buf_str(out, c"    Ok(sys_check(unsafe { sys_c_dup2(fd, to) } as i64)? as i32)\n}\n\n// A pipe: (read end, write end), both close-on-exec.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_pipe() -> Result<(i32, i32), i32> {\n    let mut fds: [i32; 2] = [0, 0];\n    // UNSAFE: C's pipe writes through a raw pointer.\n    // SAFETY: fds is a local [i32; 2]: pipe writes two ints there.\n    sys_check_unit(unsafe { sys_c_pipe(fds.as_mut_ptr() as *mut i32) })?;\n    sys_set_cloexec(fds[0], true)?;\n    sys_set_cloexec(fds[1], true)?;\n    Ok((fds[0], fds[1]))\n}\n\n// Sets or clears O_NONBLOCK on fd.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_nonblocking(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFL takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFL) } as i64)? as i32;\n    let want = if on { fl | SYS_O_NONBLOCK } else { fl & ~SYS_O_NONBLOCK };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFL takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFL, want) })?;\n    }\n    Ok(())\n}\n\n// Sets or clears FD_CLOEXEC on fd.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_cloexec(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFD takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFD) } as i64)? as i32;\n    let want = if on { fl | SYS_FD_CLOEXEC } else { fl & ~SYS_FD_CLOEXEC };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFD takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFD, want) })?;\n    }\n    Ok(())\n}\n\n");
    buf_str(out, c"// Whether fd is a terminal.\n#[effects(io, unsafe)]\npub fn sys_isatty(fd: i32) -> bool {\n    // UNSAFE: a C library call (isatty).\n    // SAFETY: isatty takes an int and touches no memory of ours.\n    unsafe { sys_c_isatty(fd) == 1 }\n}\n\n// ---- Sys: file status (0.20) ----\n\n// What stat tells of a file, the same on every system.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct FileStat {\n    dev: u64,\n    ino: u64,\n    mode: u32,\n    nlink: u64,\n    uid: u32,\n    gid: u32,\n    rdev: u64,\n    pub size: i64,\n    blocks: i64,\n    blksize: i64,\n    atime_sec: i64,\n    atime_nsec: i64,\n    pub mtime_sec: i64,\n    pub mtime_nsec: i64,\n    ctime_sec: i64,\n    ctime_nsec: i64,\n}\n\npub const SYS_S_IFMT: u32 = 0xf000;\npub const SYS_S_IFDIR: u32 = 0x4000;\npub const SYS_S_IFREG: u32 = 0x8000;\npub const SYS_S_IFLNK: u32 = 0xa000;\n\nimpl FileStat {\n    #[effects()]\n    pub fn is_dir(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFLNK\n    }\n\n    // The permission bits (the low 12 bits of mode).\n    #[effects()]\n    pub fn permissions(self) -> u32 {\n        self.mode & 0xfff\n    }\n}\n\n// struct stat on macOS (arm64, 64-bit inodes): 144 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatMacos {\n    pub st_dev: i32,\n    pub st_mode: u16,\n    pub st_nlink: u16,\n    pub st_ino: u64,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: i32,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_birthtime: i64,\n    st_birthtime_nsec: i64,\n    pub st_size: i64,\n    pub st_blocks: i64,\n    pub st_blksize: i32,\n    st_flags: u32,\n    st_gen: u32,\n    st_lspare: i32,\n");
    buf_str(out, c"    st_qspare: [i64; 2],\n}\n\n// struct stat on Linux (aarch64, glibc): 128 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatLinux {\n    pub st_dev: u64,\n    pub st_ino: u64,\n    pub st_mode: u32,\n    pub st_nlink: u32,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: u64,\n    st_pad1: u64,\n    pub st_size: i64,\n    pub st_blksize: i32,\n    st_pad2: i32,\n    pub st_blocks: i64,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_unused: [i32; 2],\n}\n\n// Room for either system's struct stat.\n#[derive(Clone, Copy)] struct SysStatBuf {\n    words: [u64; 20],\n}\n\n// The FileStat in b, filled by a stat call of this system.\nfn sys_stat_decode(b: SysStatBuf) -> FileStat {\n    if TARGET_OS == 1 {\n        // UNSAFE: reads C's struct stat out of b's words, a reinterpretation.\n        // SAFETY: b holds the struct stat of Linux that stat wrote, 128 of\n        // its 160 bytes (the layout is checked against the headers by\n        // tests/run/sys_layout.vl); the words are 8-aligned, as StatLinux\n        // is; StatLinux is integers only, so any bits are a valid one.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatLinux) };\n        FileStat {\n            dev: s.st_dev,\n            ino: s.st_ino,\n            mode: s.st_mode,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    } else {\n        // UNSAFE: as for Linux, above.\n");
    buf_str(out, c"        // SAFETY: as for Linux: macOS's struct stat, 144 of the 160 bytes,\n        // StatMacos integers only.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatMacos) };\n        FileStat {\n            dev: s.st_dev as u32 as u64,\n            ino: s.st_ino,\n            mode: s.st_mode as u32,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev as u32 as u64,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_fstat(fd: i32) -> Result<FileStat, i32> {\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's fstat writes a struct stat through a raw pointer.\n    // SAFETY: b.words is a local of 160 bytes, more than either system's\n    // struct stat (144 on macOS, 128 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_fstat(fd, b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, following symbolic links.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_stat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat takes the path and writes a struct stat, through\n    // raw pointers.\n    // SAFETY: p holds a NUL-ended path (sys_cpath); b as in sys_fstat.\n    sys_check_unit(unsafe { sys_c_stat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, of a symbolic link itself.\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_lstat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: as sys_stat (lstat).\n    // SAFETY: as sys_stat.\n    sys_check_unit(unsafe { sys_c_lstat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// ---- Sys: directories (0.20) ----\n\n// UNSAFE: the C library's directory calls, which take and return raw\n// pointers.\n// SAFETY: each prototype is POSIX's (dirent.h, unistd.h); a DIR * is kept\n// opaque in SysDir, and getcwd is given a slice's pointer and length.\nextern \"C\" {\n    #[link_name = \"opendir\"]\n    #[effects(io)]\n    fn sys_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    #[effects(io)]\n    fn sys_c_readdir(dir: *mut u8) -> *mut u8;\n    #[link_name = \"closedir\"]\n    #[effects(io)]\n    fn sys_c_closedir(dir: *mut u8) -> i32;\n    #[link_name = \"getcwd\"]\n    #[effects(io)]\n    fn sys_c_getcwd(buf: *mut u8, n: u64) -> *mut u8;\n    #[link_name = \"chdir\"]\n    #[effects(io)]\n    fn sys_c_chdir(path: *const u8) -> i32;\n}\n\n// struct dirent on macOS: d_name at 21, d_type at 20.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentMacos {\n    pub d_ino: u64,\n    d_seekoff: u64,\n    d_reclen: u16,\n    d_namlen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 1024],\n}\n\n// struct dirent on Linux (glibc): d_name at 19, d_type at 18.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentLinux {\n    pub d_ino: u64,\n    d_off: i64,\n    d_reclen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 256],\n}\n\n// An open directory (C's DIR *); sys_closedir frees it, and (0.25.4) so\n// does dropping it: a SysDir moves, it is not copied (two copies could\n// close one DIR twice, or read one closed).\npub struct SysDir {\n    handle: *mut u8,\n}\n\nimpl Drop for SysDir {\n");
    buf_str(out, c"    fn drop(&mut self) {\n        if !self.handle.is_null() {\n            let _ = sys_closedir(self);\n        }\n    }\n}\n\n// An entry read by sys_readdir_into: its name's length (the name is in the\n// caller's buffer), its kind (SYS_DT_DIR, ...; SYS_DT_UNKNOWN when the file\n// system does not say) and its inode.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysDirEntry {\n    pub name_len: i64,\n    pub kind: u8,\n    ino: u64,\n}\n\npub const SYS_DT_UNKNOWN: u8 = 0;\npub const SYS_DT_FIFO: u8 = 1;\npub const SYS_DT_CHR: u8 = 2;\npub const SYS_DT_DIR: u8 = 4;\npub const SYS_DT_BLK: u8 = 6;\npub const SYS_DT_REG: u8 = 8;\npub const SYS_DT_LNK: u8 = 10;\npub const SYS_DT_SOCK: u8 = 12;\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_opendir<P: AsRef<[u8]>>(path: P) -> Result<SysDir, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's opendir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    let d = unsafe { sys_c_opendir(p.buf.as_ptr()) };\n    if d.is_null() {\n        return Err(sys_errno());\n    }\n    Ok(SysDir { handle: d })\n}\n\n// The next entry of dir, its name copied into name (`.` and `..` included,\n// in the order the file system gives them): None at the end.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_readdir_into(dir: &mut SysDir, name: &mut [u8; 256]) -> Result<Option<SysDirEntry>,\n    i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    sys_set_errno(0);\n    // UNSAFE: C's readdir on the raw DIR *.\n    // SAFETY: handle is the DIR * opendir returned, non-null (checked)\n    // until sys_closedir clears it; a SysDir is never copied (its Drop), so\n    // no other value closes it under this one.\n    let e = unsafe { sys_c_readdir(dir.handle) };\n    if e.is_null() {\n        let err = sys_errno();\n");
    buf_str(out, c"        return if err == 0 { Ok(None) } else { Err(err) };\n    }\n    let mut kind = 0u8;\n    let mut ino = 0u64;\n    let mut nm: &[u8] = &[];\n    // UNSAFE: reads the struct dirent readdir returned, through its raw\n    // pointer, and views its name.\n    // SAFETY: e is non-null (checked): a struct dirent of this system (the\n    // layouts checked by tests/run/sys_layout.vl), valid until the next\n    // readdir of this DIR; d_name is NUL-ended within it, and nm is copied\n    // into name before this returns.\n    unsafe {\n        if TARGET_OS == 1 {\n            let d = e as *const DirentLinux;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        } else {\n            let d = e as *const DirentMacos;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        }\n    }\n    if nm.len() as i64 > 256 {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    for i in 0..nm.len() as i64 {\n        name[i as usize] = nm[i as usize];\n    }\n    Ok(Some(SysDirEntry { name_len: nm.len() as i64, kind: kind, ino: ino }))\n}\n\n// Closes dir (once: its handle is cleared).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_closedir(dir: &mut SysDir) -> Result<(), i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    // UNSAFE: C's closedir on the raw DIR *.\n    // SAFETY: the open DIR * (non-null, checked), closed once: handle is\n    // cleared right after.\n    let r = unsafe { sys_c_closedir(dir.handle) };\n    dir.handle = 0 as *mut u8;\n    sys_check_unit(r)\n}\n\n// The working directory's path, into buf: its length (ERANGE when buf is\n// too short).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_getcwd_into(buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's getcwd writes through a raw pointer.\n");
    buf_str(out, c"    // SAFETY: buf is the caller's &mut slice: getcwd writes at most buf.len()\n    // bytes, its NUL included.\n    let r = unsafe { sys_c_getcwd(buf.as_mut_ptr(), buf.len() as u64) };\n    if r.is_null() {\n        return Err(sys_errno());\n    }\n    let mut n: i64 = 0;\n    for i in 0..buf.len() as i64 {\n        if buf[i as usize] == 0 {\n            break;\n        }\n        n += 1;\n    }\n    Ok(n)\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_chdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's chdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_chdir(p.buf.as_ptr()) })\n}\n\n// ---- Sys: the environment (0.20) ----\n\n// UNSAFE: C's environment: the environ array, and getenv, setenv and\n// unsetenv, which take raw pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, unistd.h); environ is std::__sys's.\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    #[effects(global)]\n    fn sys_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    #[effects(global)]\n    fn sys_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    #[effects(global)]\n    fn sys_c_unsetenv(name: *const u8) -> i32;\n}\n\n// C's `environ`: the NUL-ended strings NAME=VALUE, then a null pointer.\n#[effects(alloc(extern), io, static, panic, diverge)]\npub fn sys_environ() -> *const *const u8 {\n    crate::__sys::environ()\n}\n\n// The number of the environment's variables.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_env_count() -> i64 {\n    let e = sys_environ();\n    let mut n: i64 = 0;\n    for i in 0..2147483647 {\n        // UNSAFE: indexes C's environ through its raw pointer.\n        // SAFETY: environ is an array of pointers ended by a null one; the\n");
    buf_str(out, c"        // walk stops at that null (2^31 bounds it), so each e[i] read is in\n        // the array.\n        if unsafe { (*e.add(i as usize)).is_null() } {\n            break;\n        }\n        n += 1;\n    }\n    n\n}\n\n// The environment's i-th variable, `NAME=VALUE` (i < sys_env_count()): a\n// view valid until the environment changes (sys_setenv, sys_unsetenv).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_env_at(i: i64) -> &'static [u8] {\n    if i < 0 || i >= sys_env_count() {\n        panic(\"sys_env_at: index out of bounds\");\n    }\n    // UNSAFE: indexes environ and views a C string, through raw pointers.\n    // SAFETY: 0 <= i < sys_env_count() (checked): environ[i] is a NUL-ended\n    // string, valid until the environment changes, which only the unsafe\n    // sys_setenv and sys_unsetenv do.\n    unsafe { sys_cstr_view((*sys_environ().add(i as usize))) }\n}\n\n// The value of the variable name, a view valid until the environment\n// changes; None when it is not set (or name is not a valid C string).\n#[effects(static, panic, unsafe)]\npub fn sys_getenv<P: AsRef<[u8]>>(name: P) -> Option<&'static [u8]> {\n    let name = name.as_ref();\n    let p = match sys_cpath(name) {\n        Ok(p) => p,\n        Err(_) => return None,\n    };\n    // UNSAFE: C's getenv takes the name and returns the value, as raw\n    // pointers.\n    // SAFETY: p holds a NUL-ended name (sys_cpath).\n    let v = unsafe { sys_c_getenv(p.buf.as_ptr()) };\n    if v.is_null() {\n        return None;\n    }\n    // UNSAFE: a view of the C string getenv returned.\n    // SAFETY: v is non-null (checked): a NUL-ended string in the\n    // environment, valid until it changes (only the unsafe sys_setenv and\n    // sys_unsetenv change it).\n    Some(unsafe { sys_cstr_view(v) })\n}\n\n// Sets the variable name to value. Unsafe as in Rust 2024: views of the\n// environment (sys_env_at, sys_getenv) may dangle afterwards, and other\n// threads may be reading it.\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: changes C's environment, which other code reads through raw\n// pointers.\n// SAFETY: (the caller's obligation) no view of the environment\n// (sys_env_at, sys_getenv) is used after the call, and no other thread\n// reads or changes the environment during it.\npub unsafe fn sys_setenv<P: AsRef<[u8]>, Q: AsRef<[u8]>>(name: P, value: Q) -> Result<(), i32> {\n    let name = name.as_ref();\n    let value = value.as_ref();\n    let n = sys_cpath(name)?;\n    let v = sys_cpath(value)?;\n    sys_check_unit(sys_c_setenv(n.buf.as_ptr(), v.buf.as_ptr(), 1))\n}\n\n// Removes the variable name (unsafe as sys_setenv).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: as sys_setenv.\n// SAFETY: (the caller's obligation) as sys_setenv.\npub unsafe fn sys_unsetenv<P: AsRef<[u8]>>(name: P) -> Result<(), i32> {\n    let name = name.as_ref();\n    let n = sys_cpath(name)?;\n    sys_check_unit(sys_c_unsetenv(n.buf.as_ptr()))\n}\n\n// ---- Sys: processes (0.20) ----\n\n// UNSAFE: posix_spawn and the C library's process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (spawn.h, sys/wait.h, signal.h,\n// unistd.h); the file actions live in SysSpawnActions' words, larger than\n// either system's posix_spawn_file_actions_t.\nextern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    #[effects(io)]\n    fn sys_c_posix_spawnp(pid: *mut i32, file: *const u8, actions: *const u8, attr: *const u8,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n    #[effects(io)]\n    fn sys_c_actions_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    #[effects(io)]\n    fn sys_c_actions_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    #[effects(io)]\n    fn sys_c_actions_adddup2(a: *mut u8, fd: i32, to: i32) -> i32;\n");
