    buf_str(out, c"    // The byte range of the last match in hay before end.\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)>;\n}\n\nimpl Pattern for char {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match_back(hay, end)\n    }\n}\n\n// mvs: str::impl Pattern\nimpl<'b> Pattern for &'b str {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if start > h.len() || n > h.len() {\n            return None;\n        }\n        if n == 0 {\n            // the empty pattern matches at every char boundary\n            let mut i = start;\n            while !hay.is_char_boundary(i) {\n                i += 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = start;\n        while i + n <= h.len() {\n            if h[i] == needle[0] && &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n            i += 1;\n        }\n        None\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if end > h.len() || n > end {\n            return None;\n        }\n        if n == 0 {\n            let mut i = end;\n            while !hay.is_char_boundary(i) {\n                i -= 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = end - n + 1;\n        while i > 0 {\n            i -= 1;\n");
