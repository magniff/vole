    buf_str(out, c"    add_g(c, sel(c\"selectedRange\"), imp_selected_range,\n        types(0 as *mut u8, tic, c\"selectedRange\", c\"{_NSRange=QQ}@:\"));\n    add_v_pgg(c, sel(c\"setMarkedText:selectedRange:replacementRange:\"), imp_set_marked,\n        types(0 as *mut u8, tic, c\"setMarkedText:selectedRange:replacementRange:\",\n            c\"v@:@{_NSRange=QQ}{_NSRange=QQ}\"));\n    add_v(c, sel(c\"unmarkText\"), imp_unmark, types(0 as *mut u8, tic, c\"unmarkText\", c\"v@:\"));\n    add_p(c, sel(c\"validAttributesForMarkedText\"), imp_valid_attributes,\n        types(0 as *mut u8, tic, c\"validAttributesForMarkedText\", c\"@@:\"));\n    add_p_gP(c, sel(c\"attributedSubstringForProposedRange:actualRange:\"), imp_attributed_substring,\n        types(0 as *mut u8, tic, c\"attributedSubstringForProposedRange:actualRange:\",\n            c\"@@:{_NSRange=QQ}^{_NSRange=QQ}\"));\n    add_v_pg(c, sel(c\"insertText:replacementRange:\"), imp_insert_text,\n        types(0 as *mut u8, tic, c\"insertText:replacementRange:\", c\"v@:@{_NSRange=QQ}\"));\n    add_u_t(c, sel(c\"characterIndexForPoint:\"), imp_char_index,\n        types(0 as *mut u8, tic, c\"characterIndexForPoint:\", c\"Q@:{CGPoint=dd}\"));\n    add_r_gP(c, sel(c\"firstRectForCharacterRange:actualRange:\"), imp_first_rect,\n        types(0 as *mut u8, tic, c\"firstRectForCharacterRange:actualRange:\",\n            c\"{CGRect={CGPoint=dd}{CGSize=dd}}@:{_NSRange=QQ}^{_NSRange=QQ}\"));\n    add_v_p(c, sel(c\"doCommandBySelector:\"), imp_do_command,\n        types(0 as *mut u8, tic, c\"doCommandBySelector:\", c\"v@::\"));\n    objc_registerClassPair(c);\n    c\n}\n\n// UNSAFE: the Objective-C runtime's class-building C functions, with the\n// IMPs as C function pointers.\n// SAFETY: as make_view_class: allocated and registered once, each IMP\n// matching its encoding (v@:@ for a notification or sender, c@:@ for\n// windowShouldClose:).\nunsafe fn make_delegate_class() -> *mut u8 {\n    let existing = class(c\"VoleWindo