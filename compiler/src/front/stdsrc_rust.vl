");
    buf_str(out, c"// std2: changed: the kind and the length (Rust's adds the permissions and\n// the times)\nimpl crate::fmt::Debug for Metadata {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Metadata\").field(\"file_type\", &self.file_type()).field(\"len\", &self.size)\n            .finish_non_exhaustive()\n    }\n}\n\n// A file's kind: a directory, a file, a symbolic link (or another).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct FileType {\n    fmt: u32,\n}\n\nimpl FileType {\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.fmt == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.fmt == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.fmt == S_IFLNK\n    }\n}\n\n// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as\n// Rust's.\nimpl crate::fmt::Debug for FileType {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"FileType\").field(\"is_file\", &self.is_file()).field(\"is_dir\", &self.is_dir())\n            .field(\"is_symlink\", &self.is_symlink()).finish_non_exhaustive()\n    }\n}\n\n// A file's permission bits.\n#[derive(Clone, PartialEq, Eq)]\npub struct Permissions {\n    mode: u32,\n}\n\nimpl Permissions {\n    // Whether no one may write it.\n    #[effects()]\n    pub fn readonly(&self) -> bool {\n        self.mode & 0x92 == 0\n    }\n\n    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).\n    // mvs: Metadata::mode\n    // std2: changed: Permissions' own, st_mode as Rust's (Rust's:\n    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)\n    #[effects()]\n    pub fn mode(&self) -> u32 {\n        self.mode\n    }\n}\n\n// ---- Whole files ----\n\n// The bytes of the file at path, in a new Vec on a.\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read)\n");
    buf_str(out, c"#[effects(io, static, panic, diverge, P, A)]\npub fn read_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<Vec<u8, A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let size = match f.metadata() {\n        crate::result::Result::Ok(m) => m.len() as usize,\n        crate::result::Result::Err(_) => 0,\n    };\n    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);\n    f.read_to_end(&mut v)?;\n    crate::result::Result::Ok(v)\n}\n\n// The text of the file at path, in a new String on a (InvalidData when it\n// is not UTF-8).\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read_to_string)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_to_string_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<String<A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let mut s = String::new_in(a);\n    f.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// The file at path holds contents: made, or emptied first.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P, C)]\npub fn write<P: AsRef<str>, C: AsRef<[u8]>>(path: P, contents: C) -> Result<()> {\n    let path = path.as_ref();\n    let mut f = File::create(path)?;\n    // (the path call: `contents.as_ref()` where a &[u8] is expected picks\n    // a wrong instance of AsRef for &T, 0.27.5's front gap)\n    f.write_all(AsRef::<[u8]>::as_ref(&contents))\n}\n\n// Copies the file at from to to (made, or emptied), its permission bits\n// too: the bytes copied.\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>); a u64 (MVS: i64)\n#[effects(io, static, panic, diverge, unsafe, P, Q)]\npub fn copy<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<u64> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let mut src = File::open(from)?;\n    let m = src.metadata()?;\n    if !m.is_file() {\n");
    buf_str(out, c"        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n            \"the source path is neither a regular file nor a symlink to a regular file\"));\n    }\n    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,\n        m.mode & 0xfff)?;\n    // UNSAFE: C's fchmod. SAFETY: integers only.\n    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;\n    let mut buf = [0u8; 65536];\n    let mut total: u64 = 0;\n    loop {\n        let n = match src.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        dst.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// What stat says of the file at path (through a symbolic link).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, true)\n}\n\n// As metadata, of a symbolic link itself.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn symlink_metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, false)\n}\n\n// Whether something is at path (through a symbolic link): Ok(false) when\n// nothing is, an error when the OS cannot say (Rust's fs::exists).\n// std2: changed: an io::Result<bool>, as Rust's (MVS: a bool); the path an\n// AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn exists<P: AsRef<str>>(path: P) -> Result<bool> {\n    let path = path.as_ref();\n    match stat_at(path, true) {\n");
    buf_str(out, c"        crate::result::Result::Ok(_) => crate::result::Result::Ok(true),\n        crate::result::Result::Err(e) => {\n            if e.kind() == ErrorKind::NotFound {\n                crate::result::Result::Ok(false)\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_file<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's unlink. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_unlink(p.ptr()) })\n}\n\n// Removes the empty directory at path.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's rmdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_rmdir(p.ptr()) })\n}\n\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn rename<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<()> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = cpath(from)?;\n    let b = cpath(to)?;\n    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.\n    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn create_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })\n}\n\n// Whether path is a directory (through a symbolic link).\nfn is_dir_at(path: &str) -> bool {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(m) => m.is_dir(),\n        crate::result::Result::Err(_) => false,\n    }\n}\n\n");
    buf_str(out, c"// path's parent as Rust's Path::parent has it: \"\" for a relative name,\n// None for the root (or \"\").\nfn parent_of(path: &str) -> Option<&str> {\n    let b = path.as_bytes();\n    let mut end = b.len();\n    while end > 0 && b[end - 1] == 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::None;\n    }\n    while end > 0 && b[end - 1] != 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::Some(&path[..0]);\n    }\n    let mut k = end;\n    while k > 0 && b[k - 1] == 47 {\n        k -= 1;\n    }\n    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }\n}\n\n// Makes the directory at path and those above it that are missing: Ok\n// when it is there (Rust's, step for step).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, P)]\npub fn create_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    if path.is_empty() {\n        return crate::result::Result::Ok(());\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => return crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if e.kind() != ErrorKind::NotFound {\n                return if is_dir_at(path) {\n                    crate::result::Result::Ok(())\n                } else {\n                    crate::result::Result::Err(e)\n                };\n            }\n        }\n    }\n    match parent_of(path) {\n        Option::Some(p) => create_dir_all(p)?,\n        Option::None => {\n            return crate::result::Result::Err(Error::other(\"failed to create whole tree\"));\n        }\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if is_dir_at(path) {\n                crate::result::Result::Ok(())\n            } else {\n                crate::result::Result::Err(e)\n");
    buf_str(out, c"            }\n        }\n    }\n}\n\n// Removes the directory at path and all it holds; a symbolic link is\n// removed, not followed.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P)]\npub fn remove_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let m = symlink_metadata(path)?;\n    if m.is_symlink() {\n        return remove_file(path);\n    }\n    if !m.is_dir() {\n        return crate::result::Result::Err(Error::from_raw_os_error(20));\n    }\n    remove_tree(path)\n}\n\n// Removes the directory at path and everything under it.\nfn remove_tree(path: &str) -> Result<()> {\n    let mut dir = read_dir(path)?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        if e.file_type()?.is_dir() {\n            remove_tree(e.path())?;\n        } else {\n            remove_file(e.path())?;\n        }\n    }\n    remove_dir(path)\n}\n\n// ---- Directories ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn read_dir<P: AsRef<str>>(path: P) -> Result<ReadDir> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.\n    let d = unsafe { fs_c_opendir(p.ptr()) };\n    if d.is_null() {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    let mut root = [0u8; crate::__sys::PATH_MAX];\n    let b = path.as_bytes();\n    let mut i: usize = 0;\n    while i < b.len() {\n        root[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir {\n    dir: *mut u8,\n");
