    buf_str(out, c"pub(crate) const K_LOCATION: i64 = 104;\npub(crate) const K_GROUP: i64 = 105;\npub(crate) const K_BINDING: i64 = 106;\npub(crate) const K_INTERPOLATE: i64 = 107;\npub(crate) const K_FLAT: i64 = 108;\npub(crate) const K_LINEAR: i64 = 109;\npub(crate) const K_PERSPECTIVE: i64 = 110;\npub(crate) const K_CENTER: i64 = 111;\npub(crate) const K_CENTROID: i64 = 112;\npub(crate) const K_SAMPLE: i64 = 113;\npub(crate) const K_ALIGN: i64 = 114;\npub(crate) const K_SIZE: i64 = 115;\npub(crate) const K_ID: i64 = 116;\npub(crate) const K_INVARIANT: i64 = 117;\npub(crate) const K_MUST_USE: i64 = 118;\n// builtin values\npub(crate) const K_POSITION: i64 = 119;\npub(crate) const K_VERTEX_INDEX: i64 = 120;\npub(crate) const K_INSTANCE_INDEX: i64 = 121;\npub(crate) const K_FRONT_FACING: i64 = 122;\npub(crate) const K_FRAG_DEPTH: i64 = 123;\npub(crate) const K_SAMPLE_INDEX: i64 = 124;\npub(crate) const K_SAMPLE_MASK: i64 = 125;\npub(crate) const K_LOCAL_INVOCATION_ID: i64 = 126;\npub(crate) const K_LOCAL_INVOCATION_INDEX: i64 = 127;\npub(crate) const K_GLOBAL_INVOCATION_ID: i64 = 128;\npub(crate) const K_WORKGROUP_ID: i64 = 129;\npub(crate) const K_NUM_WORKGROUPS: i64 = 130;\n// math\npub(crate) const K_ABS: i64 = 131;\npub(crate) const K_MIN: i64 = 132;\npub(crate) const K_MAX: i64 = 133;\npub(crate) const K_CLAMP: i64 = 134;\npub(crate) const K_SIGN: i64 = 135;\npub(crate) const K_FLOOR: i64 = 136;\npub(crate) const K_CEIL: i64 = 137;\npub(crate) const K_ROUND: i64 = 138;\npub(crate) const K_FRACT: i64 = 139;\npub(crate) const K_TRUNC: i64 = 140;\npub(crate) const K_SQRT: i64 = 141;\npub(crate) const K_INVERSE_SQRT: i64 = 142;\npub(crate) const K_EXP: i64 = 143;\npub(crate) const K_EXP2: i64 = 144;\npub(crate) const K_LOG: i64 = 145;\npub(crate) const K_LOG2: i64 = 146;\npub(crate) const K_POW: i64 = 147;\npub(crate) const K_SIN: i64 = 148;\npub(crate) const K_COS: i64 = 149;\npub(crate) const K_TAN: i64 = 150;\npub(crate) const K_ASIN: i64 = 151;\n");
    buf_str(out, c"pub(crate) const K_ACOS: i64 = 152;\npub(crate) const K_ATAN: i64 = 153;\npub(crate) const K_ATAN2: i64 = 154;\npub(crate) const K_SINH: i64 = 155;\npub(crate) const K_COSH: i64 = 156;\npub(crate) const K_TANH: i64 = 157;\npub(crate) const K_MIX: i64 = 158;\npub(crate) const K_STEP: i64 = 159;\npub(crate) const K_SMOOTHSTEP: i64 = 160;\npub(crate) const K_FMA: i64 = 161;\npub(crate) const K_LENGTH: i64 = 162;\npub(crate) const K_DISTANCE: i64 = 163;\npub(crate) const K_DOT: i64 = 164;\npub(crate) const K_CROSS: i64 = 165;\npub(crate) const K_NORMALIZE: i64 = 166;\npub(crate) const K_REFLECT: i64 = 167;\npub(crate) const K_DETERMINANT: i64 = 168;\npub(crate) const K_TRANSPOSE: i64 = 169;\npub(crate) const K_COUNT_ONE_BITS: i64 = 170;\npub(crate) const K_COUNT_LEADING_ZEROS: i64 = 171;\npub(crate) const K_COUNT_TRAILING_ZEROS: i64 = 172;\npub(crate) const K_FIRST_LEADING_BIT: i64 = 173;\npub(crate) const K_FIRST_TRAILING_BIT: i64 = 174;\npub(crate) const K_REVERSE_BITS: i64 = 175;\npub(crate) const K_EXTRACT_BITS: i64 = 176;\npub(crate) const K_INSERT_BITS: i64 = 177;\npub(crate) const K_ALL: i64 = 178;\npub(crate) const K_ANY: i64 = 179;\npub(crate) const K_DEGREES: i64 = 180;\npub(crate) const K_RADIANS: i64 = 181;\npub(crate) const K_SATURATE: i64 = 182;\npub(crate) const K_PACK4X8UNORM: i64 = 183;\npub(crate) const K_UNPACK4X8UNORM: i64 = 184;\npub(crate) const K_PACK2X16FLOAT: i64 = 185;\npub(crate) const K_UNPACK2X16FLOAT: i64 = 186;\npub(crate) const K_ASINH: i64 = 187;\npub(crate) const K_ACOSH: i64 = 188;\npub(crate) const K_ATANH: i64 = 189;\npub(crate) const K_FACE_FORWARD: i64 = 190;\npub(crate) const K_LDEXP: i64 = 191;\npub(crate) const K_PACK4X8SNORM: i64 = 192;\npub(crate) const K_UNPACK4X8SNORM: i64 = 193;\npub(crate) const K_PACK2X16UNORM: i64 = 194;\npub(crate) const K_UNPACK2X16UNORM: i64 = 195;\npub(crate) const K_PACK2X16SNORM: i64 = 196;\npub(crate) const K_UNPACK2X16SNORM: i64 = 197;\npub(crate) const K_MATH_FIRST: i64 = 131;\n");
    buf_str(out, c"pub(crate) const K_MATH_LAST: i64 = 197;\n// other builtins\npub(crate) const K_SELECT: i64 = 198;\npub(crate) const K_ARRAY_LENGTH: i64 = 199;\npub(crate) const K_BITCAST: i64 = 200;\npub(crate) const K_ATOMIC_LOAD: i64 = 201;\npub(crate) const K_ATOMIC_STORE: i64 = 202;\npub(crate) const K_ATOMIC_ADD: i64 = 203;\npub(crate) const K_ATOMIC_SUB: i64 = 204;\npub(crate) const K_ATOMIC_MAX: i64 = 205;\npub(crate) const K_ATOMIC_MIN: i64 = 206;\npub(crate) const K_ATOMIC_AND: i64 = 207;\npub(crate) const K_ATOMIC_OR: i64 = 208;\npub(crate) const K_ATOMIC_XOR: i64 = 209;\npub(crate) const K_ATOMIC_EXCHANGE: i64 = 210;\npub(crate) const K_ATOMIC_COMPARE_EXCHANGE_WEAK: i64 = 211;\npub(crate) const K_WORKGROUP_BARRIER: i64 = 212;\npub(crate) const K_STORAGE_BARRIER: i64 = 213;\npub(crate) const K_WORKGROUP_UNIFORM_LOAD: i64 = 214;\npub(crate) const K_DPDX: i64 = 215;\npub(crate) const K_DPDY: i64 = 216;\npub(crate) const K_FWIDTH: i64 = 217;\npub(crate) const K_DPDX_COARSE: i64 = 218;\npub(crate) const K_DPDY_COARSE: i64 = 219;\npub(crate) const K_FWIDTH_COARSE: i64 = 220;\npub(crate) const K_DPDX_FINE: i64 = 221;\npub(crate) const K_DPDY_FINE: i64 = 222;\npub(crate) const K_FWIDTH_FINE: i64 = 223;\npub(crate) const K_TEXTURE_SAMPLE: i64 = 224;\npub(crate) const K_TEXTURE_SAMPLE_BIAS: i64 = 225;\npub(crate) const K_TEXTURE_SAMPLE_LEVEL: i64 = 226;\npub(crate) const K_TEXTURE_SAMPLE_COMPARE: i64 = 227;\npub(crate) const K_TEXTURE_SAMPLE_COMPARE_LEVEL: i64 = 228;\npub(crate) const K_TEXTURE_LOAD: i64 = 229;\npub(crate) const K_TEXTURE_STORE: i64 = 230;\npub(crate) const K_TEXTURE_DIMENSIONS: i64 = 231;\npub(crate) const K_TEXTURE_NUM_LEVELS: i64 = 232;\npub(crate) const K_TEXTURE_NUM_LAYERS: i64 = 233;\n// storage texel formats after the first six (0.25.2.2): FMT_RGBA16FLOAT +\n// (K - K_RGBA16FLOAT)\npub(crate) const K_RGBA16FLOAT: i64 = 234;\npub(crate) const K_RGBA8UINT: i64 = 235;\npub(crate) const K_RG32FLOAT: i64 = 236;\npub(crate) const K_COUNT: i64 = 237;\n");
    buf_str(out, c"// ---- end mod std::gpu::wgsl::names ----\n}\n// ---- mod std::gpu::wgsl::lex ----\nmod lex {\n// EDITION: rust\n// ---- Shader compiler implementation, lex (0.22) ----\n// The WGSL lexer: the whole source becomes arrays of tokens (kind, start,\n// end, and for an identifier its symbol). Identifiers are interned: the\n// predeclared names (names.vl) have fixed symbols, so the parser\n// compares integers. Comments (`//`, nesting `/* */`) and blanks are\n// skipped.\n\nuse crate::alloc::Allocator;\nuse crate::collections::HashMap;\n\nuse super::names::PREDECLARED;\n\npub(crate) const T_EOF: u8 = 0;\npub(crate) const T_IDENT: u8 = 1;\n// an integer literal: its text is start .. end, the suffix included\npub(crate) const T_INT: u8 = 2;\npub(crate) const T_FLOAT: u8 = 3;\npub(crate) const T_LPAREN: u8 = 4;\npub(crate) const T_RPAREN: u8 = 5;\npub(crate) const T_LBRACE: u8 = 6;\npub(crate) const T_RBRACE: u8 = 7;\npub(crate) const T_LBRACKET: u8 = 8;\npub(crate) const T_RBRACKET: u8 = 9;\npub(crate) const T_COMMA: u8 = 10;\npub(crate) const T_SEMI: u8 = 11;\npub(crate) const T_COLON: u8 = 12;\npub(crate) const T_DOT: u8 = 13;\npub(crate) const T_AT: u8 = 14;\npub(crate) const T_ARROW: u8 = 15;\npub(crate) const T_EQ: u8 = 16;\npub(crate) const T_EQEQ: u8 = 17;\npub(crate) const T_NE: u8 = 18;\npub(crate) const T_LT: u8 = 19;\npub(crate) const T_LE: u8 = 20;\npub(crate) const T_GT: u8 = 21;\npub(crate) const T_GE: u8 = 22;\npub(crate) const T_PLUS: u8 = 23;\npub(crate) const T_MINUS: u8 = 24;\npub(crate) const T_STAR: u8 = 25;\npub(crate) const T_SLASH: u8 = 26;\npub(crate) const T_PERCENT: u8 = 27;\npub(crate) const T_AMP: u8 = 28;\npub(crate) const T_PIPE: u8 = 29;\npub(crate) const T_CARET: u8 = 30;\npub(crate) const T_TILDE: u8 = 31;\npub(crate) const T_BANG: u8 = 32;\npub(crate) const T_ANDAND: u8 = 33;\npub(crate) const T_OROR: u8 = 34;\npub(crate) const T_SHL: u8 = 35;\npub(crate) const T_SHR: u8 = 36;\npub(crate) const T_PLUSEQ: u8 = 37;\n");
    buf_str(out, c"pub(crate) const T_MINUSEQ: u8 = 38;\npub(crate) const T_STAREQ: u8 = 39;\npub(crate) const T_SLASHEQ: u8 = 40;\npub(crate) const T_PERCENTEQ: u8 = 41;\npub(crate) const T_AMPEQ: u8 = 42;\npub(crate) const T_PIPEEQ: u8 = 43;\npub(crate) const T_CARETEQ: u8 = 44;\npub(crate) const T_SHLEQ: u8 = 45;\npub(crate) const T_SHREQ: u8 = 46;\npub(crate) const T_PLUSPLUS: u8 = 47;\npub(crate) const T_MINUSMINUS: u8 = 48;\npub(crate) const T_UNDERSCORE: u8 = 49;\n// a byte that starts no token\npub(crate) const T_BAD: u8 = 50;\n\npub(crate) struct Tokens<'a, A: Allocator> {\n    pub(crate) kinds: Vec<u8, A>,\n    pub(crate) starts: Vec<i64, A>,\n    pub(crate) ends: Vec<i64, A>,\n    // the symbol of an identifier, else -1\n    pub(crate) syms: Vec<i64, A>,\n    // symbol -> its text\n    pub(crate) names: Vec<&'a [u8], A>,\n    intern: HashMap<&'a [u8], i64, A>,\n    // a comment that is not closed: its start, else -1\n    pub(crate) open_comment: i64,\n}\n\nfn is_ident_start(c: u8) -> bool {\n    (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_'\n}\n\nfn is_ident_char(c: u8) -> bool { is_ident_start(c) || (c >= b'0' && c <= b'9') }\n\nfn is_hex(c: u8) -> bool {\n    (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')\n}\n\nfn is_dec(c: u8) -> bool { c >= b'0' && c <= b'9' }\n\nimpl<'a, A: Allocator + Copy> Tokens<'a, A> {\n    #[effects(A)]\n    pub(crate) fn sym(&mut self, s: &'a [u8]) -> i64 {\n        if let Some(h) = self.intern.get(&s).copied() {\n            return h;\n        }\n        let h = self.names.len() as i64;\n        self.names.push(s);\n        self.intern.insert(s, h);\n        h\n    }\n\n    fn push_token(&mut self, k: u8, s: i64, e: i64, sym: i64) {\n        self.kinds.push(k);\n        self.starts.push(s);\n        self.ends.push(e);\n        self.syms.push(sym);\n    }\n}\n\n// The length of the number at src[i ..], and whether it is a float.\nfn number_len(src: &[u8], i: i64) -> (i64, bool) {\n");
    buf_str(out, c"    let n = src.len() as i64;\n    let mut j = i;\n    let mut float = false;\n    if src[j as usize] == b'0' && j + 1 < n\n        && (src[(j + 1) as usize] == b'x' || src[(j + 1) as usize] == b'X') {\n        j += 2;\n        while j < n && is_hex(src[j as usize]) {\n            j += 1;\n        }\n        if j < n && src[j as usize] == b'.' {\n            float = true;\n            j += 1;\n            while j < n && is_hex(src[j as usize]) {\n                j += 1;\n            }\n        }\n        if j < n && (src[j as usize] == b'p' || src[j as usize] == b'P') {\n            float = true;\n            j += 1;\n            if j < n && (src[j as usize] == b'+' || src[j as usize] == b'-') {\n                j += 1;\n            }\n            while j < n && is_dec(src[j as usize]) {\n                j += 1;\n            }\n        }\n        if j < n && (src[j as usize] == b'f' || src[j as usize] == b'h') && float {\n            j += 1;\n        } else if j < n && (src[j as usize] == b'i' || src[j as usize] == b'u') && !float {\n            j += 1;\n        }\n        return (j - i, float);\n    }\n    while j < n && is_dec(src[j as usize]) {\n        j += 1;\n    }\n    if j < n && src[j as usize] == b'.' && !(j + 1 < n && src[(j + 1) as usize] == b'.') {\n        float = true;\n        j += 1;\n        while j < n && is_dec(src[j as usize]) {\n            j += 1;\n        }\n    }\n    if j < n && (src[j as usize] == b'e' || src[j as usize] == b'E') {\n        let mut k = j + 1;\n        if k < n && (src[k as usize] == b'+' || src[k as usize] == b'-') {\n            k += 1;\n        }\n        if k < n && is_dec(src[k as usize]) {\n            float = true;\n            j = k;\n            while j < n && is_dec(src[j as usize]) {\n                j += 1;\n            }\n        }\n    }\n    if j < n && (src[j as usize] == b'f' || src[j as usize] == b'h') {\n        float = true;\n        j += 1;\n");
    buf_str(out, c"    } else if j < n && (src[j as usize] == b'i' || src[j as usize] == b'u') && !float {\n        j += 1;\n    }\n    (j - i, float)\n}\n\n#[effects(panic, diverge, A)]\npub(crate) fn lex<'a, A: Allocator + Copy>(src: &'a [u8], a: A) -> Tokens<'a, A> {\n    let mut t = Tokens {\n        kinds: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        starts: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        ends: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        syms: Vec::with_capacity_in(src.len() / 3 + 16, a),\n        names: Vec::with_capacity_in(512usize, a),\n        intern: HashMap::with_capacity_in(512usize, a),\n        open_comment: -1,\n    };\n    for i in 0..PREDECLARED.len() {\n        t.sym(PREDECLARED[i]);\n    }\n    let n = src.len() as i64;\n    let mut i: i64 = 0;\n    while i < n {\n        let c = src[i as usize];\n        if c == b' ' || c == b'\\n' || c == b'\\t' || c == b'\\r' || c == 11 || c == 12 {\n            i += 1;\n            continue;\n        }\n        if c == b'/' && i + 1 < n && src[(i + 1) as usize] == b'/' {\n            while i < n && src[i as usize] != b'\\n' {\n                i += 1;\n            }\n            continue;\n        }\n        if c == b'/' && i + 1 < n && src[(i + 1) as usize] == b'*' {\n            let start = i;\n            let mut depth: i64 = 1;\n            i += 2;\n            while i < n && depth > 0 {\n                if src[i as usize] == b'/' && i + 1 < n && src[(i + 1) as usize] == b'*' {\n                    depth += 1;\n                    i += 2;\n                } else if src[i as usize] == b'*' && i + 1 < n && src[(i + 1) as usize] == b'/' {\n                    depth -= 1;\n                    i += 2;\n                } else {\n                    i += 1;\n                }\n            }\n            if depth > 0 {\n                t.open_comment = start;\n            }\n            continue;\n        }\n        if is_ident_start(c) {\n            let s = i;\n");
    buf_str(out, c"            while i < n && is_ident_char(src[i as usize]) {\n                i += 1;\n            }\n            if i - s == 1 && c == b'_' {\n                t.push_token(T_UNDERSCORE, s, i, -1);\n            } else {\n                let sym = t.sym(&src[s as usize..i as usize]);\n                t.push_token(T_IDENT, s, i, sym);\n            }\n            continue;\n        }\n        if is_dec(c) || (c == b'.' && i + 1 < n && is_dec(src[(i + 1) as usize])) {\n            let (len, float) = number_len(src, i);\n            t.push_token(if float { T_FLOAT } else { T_INT }, i, i + len, -1);\n            i += len;\n            continue;\n        }\n        let c1 = if i + 1 < n { src[(i + 1) as usize] } else { 0 };\n        let c2 = if i + 2 < n { src[(i + 2) as usize] } else { 0 };\n        let mut k = T_BAD;\n        let mut len: i64 = 1;\n        if c == b'(' {\n            k = T_LPAREN;\n        } else if c == b')' {\n            k = T_RPAREN;\n        } else if c == b'{' {\n            k = T_LBRACE;\n        } else if c == b'}' {\n            k = T_RBRACE;\n        } else if c == b'[' {\n            k = T_LBRACKET;\n        } else if c == b']' {\n            k = T_RBRACKET;\n        } else if c == b',' {\n            k = T_COMMA;\n        } else if c == b';' {\n            k = T_SEMI;\n        } else if c == b':' {\n            k = T_COLON;\n        } else if c == b'.' {\n            k = T_DOT;\n        } else if c == b'@' {\n            k = T_AT;\n        } else if c == b'~' {\n            k = T_TILDE;\n        } else if c == b'=' {\n            if c1 == b'=' {\n                k = T_EQEQ;\n                len = 2;\n            } else {\n                k = T_EQ;\n            }\n        } else if c == b'!' {\n            if c1 == b'=' {\n                k = T_NE;\n                len = 2;\n            } else {\n                k = T_BANG;\n            }\n        } else if c == b'<' {\n            if c1 == b'<' && c2 == b'=' {\n                k = T_SHLEQ;\n");
    buf_str(out, c"                len = 3;\n            } else if c1 == b'<' {\n                k = T_SHL;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_LE;\n                len = 2;\n            } else {\n                k = T_LT;\n            }\n        } else if c == b'>' {\n            if c1 == b'>' && c2 == b'=' {\n                k = T_SHREQ;\n                len = 3;\n            } else if c1 == b'>' {\n                k = T_SHR;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_GE;\n                len = 2;\n            } else {\n                k = T_GT;\n            }\n        } else if c == b'+' {\n            if c1 == b'+' {\n                k = T_PLUSPLUS;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_PLUSEQ;\n                len = 2;\n            } else {\n                k = T_PLUS;\n            }\n        } else if c == b'-' {\n            if c1 == b'>' {\n                k = T_ARROW;\n                len = 2;\n            } else if c1 == b'-' {\n                k = T_MINUSMINUS;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_MINUSEQ;\n                len = 2;\n            } else {\n                k = T_MINUS;\n            }\n        } else if c == b'*' {\n            if c1 == b'=' {\n                k = T_STAREQ;\n                len = 2;\n            } else {\n                k = T_STAR;\n            }\n        } else if c == b'/' {\n            if c1 == b'=' {\n                k = T_SLASHEQ;\n                len = 2;\n            } else {\n                k = T_SLASH;\n            }\n        } else if c == b'%' {\n            if c1 == b'=' {\n                k = T_PERCENTEQ;\n                len = 2;\n            } else {\n                k = T_PERCENT;\n            }\n        } else if c == b'&' {\n            if c1 == b'&' {\n                k = T_ANDAND;\n                len = 2;\n");
    buf_str(out, c"            } else if c1 == b'=' {\n                k = T_AMPEQ;\n                len = 2;\n            } else {\n                k = T_AMP;\n            }\n        } else if c == b'|' {\n            if c1 == b'|' {\n                k = T_OROR;\n                len = 2;\n            } else if c1 == b'=' {\n                k = T_PIPEEQ;\n                len = 2;\n            } else {\n                k = T_PIPE;\n            }\n        } else if c == b'^' {\n            if c1 == b'=' {\n                k = T_CARETEQ;\n                len = 2;\n            } else {\n                k = T_CARET;\n            }\n        }\n        t.push_token(k, i, i + len, -1);\n        i += len;\n    }\n    t.push_token(T_EOF, n, n, -1);\n    t\n}\n\n// How a token is written, for messages.\n#[effects()]\npub(crate) fn token_text(k: u8) -> &'static [u8] {\n    if k == T_EOF {\n        b\"the end of the file\"\n    } else if k == T_IDENT {\n        b\"an identifier\"\n    } else if k == T_INT || k == T_FLOAT {\n        b\"a number\"\n    } else if k == T_LPAREN {\n        b\"'('\"\n    } else if k == T_RPAREN {\n        b\"')'\"\n    } else if k == T_LBRACE {\n        b\"'{'\"\n    } else if k == T_RBRACE {\n        b\"'}'\"\n    } else if k == T_LBRACKET {\n        b\"'['\"\n    } else if k == T_RBRACKET {\n        b\"']'\"\n    } else if k == T_COMMA {\n        b\"','\"\n    } else if k == T_SEMI {\n        b\"';'\"\n    } else if k == T_COLON {\n        b\"':'\"\n    } else if k == T_DOT {\n        b\"'.'\"\n    } else if k == T_AT {\n        b\"'@'\"\n    } else if k == T_ARROW {\n        b\"'->'\"\n    } else if k == T_EQ {\n        b\"'='\"\n    } else if k == T_LT {\n        b\"'<'\"\n    } else if k == T_GT {\n        b\"'>'\"\n    } else if k == T_UNDERSCORE {\n        b\"'_'\"\n    } else if k == T_BAD {\n        b\"a character WGSL does not use\"\n    } else {\n        b\"an operator\"\n    }\n}\n// ---- end mod std::gpu::wgsl::lex ----\n}\n");
    buf_str(out, c"// ---- mod std::gpu::wgsl::front ----\npub mod front {\n// EDITION: rust\n// ---- Shader compiler implementation, front (0.22) ----\n// The WGSL front end: parsing, name resolution and type checking in one\n// pass from tokens to IR (docs/design/gpu.md §2.10), with no syntax tree\n// in between.\n//\n// - A skim finds the module-scope declarations (any order is allowed);\n//   types, constants and function signatures are resolved on demand from\n//   their tokens, function bodies in source order.\n// - Expressions are lowered as they are parsed: a `Val` is an IR\n//   expression, a reference (a pointer the Load Rule reads), or a\n//   constant (abstract numbers included) not yet in the IR.\n// - The first error stops the translation: it is recorded, and from then\n//   on every token reads as the end of the file, so the parse unwinds.\n\nuse crate::mem;\nuse crate::alloc::Allocator;\n\nuse super::{entry, ir, lex, names};\nuse super::ir::{\n    ACC_READ, ACC_RW, ACC_WRITE, BIND_BUILTIN, BIND_LOCATION, Binding, E_ARG, E_CALL_RESULT,\n    E_GLOBAL, E_LOCAL, Entry, Function, Global, INTERP_FLAT, INTERP_LINEAR, INTERP_PERSPECTIVE,\n    Local, Module, Param, SK_BOOL, SK_F32, SK_I32, SK_U32, SP_FUNCTION, SP_HANDLE, SP_PRIVATE,\n    SP_STORAGE, SP_UNIFORM, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, S_BLOCK,\n    S_BREAK, S_CALL, S_CONTINUE, S_EMIT, S_IF, S_KILL, S_LOOP, S_RETURN, S_STORE, S_SWITCH,\n    StructMember, TK_ARRAY, TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT,\n    TK_TEXTURE, TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, new_function, no_binding,\n};\nuse super::lex::{\n    T_ARROW, T_AT, T_COLON, T_COMMA, T_EOF, T_EQ, T_GT, T_IDENT, T_LBRACE, T_LBRACKET, T_LPAREN,\n    T_LT, T_MINUSMINUS, T_PLUSPLUS, T_RBRACE, T_RBRACKET, T_RPAREN, T_SEMI, T_SHR, T_UNDERSCORE,\n    Tokens, token_text,\n};\nuse super::names::{\n    K_ALIAS, K_ALIGN, K_BINDING, K_BREAK, K_BUILTIN, K_CASE, K_CENTER, K_CENTROID, K_COMPUTE,\n");
    buf_str(out, c"    K_CONST, K_CONST_ASSERT, K_CONTINUE, K_CONTINUING, K_DEFAULT, K_DIAGNOSTIC, K_DISCARD, K_ELSE,\n    K_ENABLE, K_FLAT, K_FN, K_FOR, K_FRAGMENT, K_GROUP, K_ID, K_IF, K_INTERPOLATE, K_INVARIANT,\n    K_LET, K_LINEAR, K_LOCATION, K_LOOP, K_MUST_USE, K_OVERRIDE, K_PERSPECTIVE, K_REQUIRES,\n    K_RETURN, K_SAMPLE, K_SIZE, K_STRUCT, K_SWITCH, K_VAR, K_VERTEX, K_WHILE, K_WORKGROUP_SIZE,\n};\n\n// ---- Shader compiler implementation, front: Values (0.22) ----\n\n// an IR expression's value\npub(crate) const VK_VALUE: u8 = 0;\n// a reference: `e` is a pointer, read by the Load Rule where a value is needed\npub(crate) const VK_REF: u8 = 1;\n// a constant scalar not yet in the IR: iv (bool, integers) or fv (floats);\n// sk may be abstract; ty is its type, -1 when abstract\npub(crate) const VK_CONST: u8 = 2;\n// a module-scope or local name that is a type (in a constructor call)\npub(crate) const VK_TYPE: u8 = 3;\n// no value (a call of a function without a result)\npub(crate) const VK_VOID: u8 = 4;\n\n#[derive(Clone, Copy)] pub struct Val {\n    pub k: u8, pub sk: u8, pub e: i64, pub ty: i64, pub iv: i64, pub fv: f64,\n}\n\n#[effects()]\npub(crate) fn val(e: i64, ty: i64) -> Val {\n    Val { k: VK_VALUE, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 }\n}\n\n#[effects()]\npub(crate) fn cint(sk: u8, ty: i64, v: i64) -> Val {\n    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: v, fv: 0.0 }\n}\n\n#[effects()]\npub(crate) fn cfloat(sk: u8, ty: i64, v: f64) -> Val {\n    Val { k: VK_CONST, sk: sk, e: -1, ty: ty, iv: 0, fv: v }\n}\n\n// ---- Shader compiler implementation, front: Declarations (0.22) ----\n\npub(crate) const D_FN: u8 = 0;\npub(crate) const D_STRUCT: u8 = 1;\npub(crate) const D_VAR: u8 = 2;\npub(crate) const D_CONST: u8 = 3;\npub(crate) const D_ALIAS: u8 = 4;\n\npub(crate) const DS_TODO: u8 = 0;\npub(crate) const DS_BUSY: u8 = 1;\npub(crate) const DS_DONE: u8 = 2;\n\n// tok: the token after the attributes (the keyword); attr: the first\n");
    buf_str(out, c"// attribute's token; h: the type, global or function once resolved; cv:\n// a constant's value once known (scalars)\n#[derive(Clone, Copy)] pub struct Decl {\n    pub(crate) kind: u8, state: u8, sym: i64, tok: i64, attr: i64, pub h: i64, pub cv: Val,\n    pub(crate) has_cv: bool,\n}\n\n// A name in a function's scopes.\n#[derive(Clone, Copy)] pub struct ScopeEntry { pub sym: i64, pub v: Val, mutable: bool }\n\n#[derive(Clone, Copy)] pub struct Attrs {\n    stage: i64,\n    wg: [i64; 3],\n    group: i64,\n    binding: i64,\n    loc: i64,\n    builtin: i64,\n    interp: i64,\n    pos: i64,\n}\n\npub struct Front<'a, A: Allocator> {\n    pub(crate) src: &'a [u8],\n    pub(crate) tk: Tokens<'a, A>,\n    pub(crate) p: i64,\n    pub(crate) m: Module<'a, A>,\n    pub(crate) a: A,\n    pub failed: bool,\n    pub err_code: &'a [u8],\n    pub err_pos: i64,\n    pub emsg: Vec<u8, A>,\n    pub ehelp: Vec<u8, A>,\n    pub(crate) decls: Vec<Decl, A>,\n    // symbol -> its declaration, or -1\n    pub(crate) decl_of: Vec<i64, A>,\n    // the function being lowered\n    pub(crate) f: Function<'a, A>,\n    pub(crate) fh: i64,\n    pub(crate) pending: Vec<i64, A>,\n    emit_start: i64,\n    pub(crate) scopes: Vec<ScopeEntry, A>,\n    pub(crate) scope_floor: i64,\n    // global -> its E_GLOBAL in f, or -1\n    gexpr: Vec<i64, A>,\n    loop_depth: i64,\n    switch_depth: i64,\n    in_continuing: bool,\n    // the start of each loop's body scope (for `continuing`'s check)\n    // the stage of the entry point being lowered (255: a plain function)\n    pub(crate) stage: i64,\n    // the compare-exchange result types: [i32's, u32's], -1 until made\n    pub(crate) cmpxchg_ty: [i64; 2],\n    pub(crate) tmp: Vec<u8, A>,\n    // the expected type of the expression being parsed (for inferred\n    // constructors of abstract numbers), or -1\n    pub(crate) hint: i64,\n    // the token after the last call's `)`, and whether a statement was one\n    pub(crate) last_call_end: i64,\n");
    buf_str(out, c"    pub(crate) last_was_call: bool,\n    // call arguments being parsed, with their positions; lowered ones\n    pub(crate) astack: Vec<Val, A>,\n    pub(crate) apos: Vec<i64, A>,\n    pub(crate) estack: Vec<i64, A>,\n}\n\n#[effects(A)]\npub fn new_front<'a, A: Allocator + Copy>(src: &'a [u8], a: A) -> Front<'a, A> {\n    let tk = lex::lex(src, a);\n    Front {\n        src: src,\n        tk: tk,\n        p: 0,\n        m: Module::new(a),\n        a: a,\n        failed: false,\n        err_code: b\"\",\n        err_pos: 0,\n        emsg: Vec::new_in(a),\n        ehelp: Vec::new_in(a),\n        decls: Vec::new_in(a),\n        decl_of: Vec::new_in(a),\n        f: new_function(b\"\", a),\n        fh: -1,\n        pending: Vec::new_in(a),\n        emit_start: 0,\n        scopes: Vec::new_in(a),\n        scope_floor: 0,\n        gexpr: Vec::new_in(a),\n        loop_depth: 0,\n        switch_depth: 0,\n        in_continuing: false,\n        stage: 255,\n        cmpxchg_ty: [-1, -1],\n        tmp: Vec::new_in(a),\n        hint: -1,\n        last_call_end: -1,\n        last_was_call: false,\n        astack: Vec::new_in(a),\n        apos: Vec::new_in(a),\n        estack: Vec::new_in(a),\n    }\n}\n\nimpl<'a, A: Allocator + Copy> Front<'a, A> {\n    // ---- Errors ----\n\n    // Records an error at byte `pos` with `code`; true when it is the\n    // first (the caller then writes the message into emsg).\n    #[effects()]\n    pub(crate) fn err(&mut self, pos: i64, code: &'a [u8]) -> bool {\n        if self.failed {\n            return false;\n        }\n        self.failed = true;\n        self.err_code = code;\n        self.err_pos = pos;\n        true\n    }\n\n    #[effects(A)]\n    pub(crate) fn fail(&mut self, pos: i64, code: &'a [u8], msg: &[u8]) {\n        if self.err(pos, code) {\n            self.emsg.extend_from_slice(msg);\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn help(&mut self, h: &[u8]) {\n        if self.ehelp.len() as i64 == 0 {\n");
    buf_str(out, c"            self.ehelp.extend_from_slice(h);\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn ty_str(&mut self, t: i64) {\n        self.m.type_name(t, &mut self.emsg);\n    }\n\n    // The type of a value as WGSL writes it, into emsg.\n    #[effects(A)]\n    pub(crate) fn val_str(&mut self, v: Val) {\n        if v.k == VK_CONST && v.ty < 0 {\n            self.emsg.extend_from_slice(ir::scalar_name(v.sk));\n        } else if v.k == VK_REF {\n            self.emsg.extend_from_slice(b\"ref to \");\n            self.ty_str(self.m.pointee(v.ty));\n        } else if v.k == VK_VOID {\n            self.emsg.extend_from_slice(b\"nothing (a call without a result)\");\n        } else {\n            self.ty_str(v.ty);\n        }\n    }\n\n    // ---- Tokens ----\n\n    #[effects(panic, A)]\n    pub(crate) fn kind(&self) -> u8 {\n        if self.failed {\n            T_EOF\n        } else {\n            self.tk.kinds[self.p as usize]\n        }\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn kind_at(&self, i: i64) -> u8 {\n        if self.failed || i >= self.tk.kinds.len() as i64 {\n            T_EOF\n        } else {\n            self.tk.kinds[i as usize]\n        }\n    }\n\n    pub(crate) fn sym(&self) -> i64 {\n        if self.failed {\n            -1\n        } else {\n            self.tk.syms[self.p as usize]\n        }\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn pos(&self) -> i64 { self.tk.starts[self.p as usize] }\n\n    #[effects(panic, A)]\n    pub(crate) fn text(&self, i: i64) -> &'a [u8] { &self.src[\n        self.tk.starts[i as usize] as usize..self.tk.ends[i as usize] as usize] }\n\n    #[effects(panic, A)]\n    pub(crate) fn is_kw(&self, k: i64) -> bool {\n        self.kind() == T_IDENT && self.tk.syms[self.p as usize] == k\n    }\n\n    #[effects(A)]\n    pub(crate) fn eat(&mut self, k: u8) -> bool {\n        if self.kind() == k {\n            self.p += 1;\n            true\n        } else {\n            false\n        }\n    }\n\n");
    buf_str(out, c"    #[effects(A)]\n    pub(crate) fn eat_kw(&mut self, k: i64) -> bool {\n        if self.is_kw(k) {\n            self.p += 1;\n            true\n        } else {\n            false\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn expect(&mut self, k: u8) {\n        if self.kind() == k {\n            self.p += 1;\n            return;\n        }\n        if self.failed {\n            return;\n        }\n        let got = self.kind();\n        if self.err(self.pos(), b\"wgsl.syntax\") {\n            write(self.emsg, \"expected {}, got \", str::from_utf8(token_text(k)).unwrap()).unwrap();\n            if got == T_IDENT {\n                write(self.emsg, \"'{}'\", str::from_utf8(self.text(self.p)).unwrap()).unwrap();\n            } else {\n                self.emsg.extend_from_slice(token_text(got));\n            }\n        }\n    }\n\n    // `>` closing a template list; a `>>` token gives one `>` and leaves one.\n    #[effects(panic, A)]\n    pub(crate) fn expect_gt(&mut self) {\n        if self.kind() == T_SHR {\n            self.tk.kinds[self.p as usize] = T_GT;\n            self.tk.starts[self.p as usize] += 1;\n            return;\n        }\n        self.expect(T_GT);\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn ident(&mut self) -> i64 {\n        if self.kind() == T_IDENT {\n            let s = self.tk.syms[self.p as usize];\n            self.p += 1;\n            return s;\n        }\n        self.expect(T_IDENT);\n        -1\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn name_of(&self, sym: i64) -> &'a [u8] {\n        if sym < 0 {\n            b\"_\"\n        } else {\n            self.tk.names[sym as usize]\n        }\n    }\n\n    // ---- Statements of the function being built ----\n\n    #[effects(A)]\n    pub(crate) fn flush(&mut self) {\n        let n = self.f.exprs.len() as i64;\n        if n > self.emit_start {\n            let s = self.f.stmt(S_EMIT, self.emit_start, n, 0, 0);\n");
    buf_str(out, c"            self.pending.push(s);\n            self.emit_start = n;\n        }\n    }\n\n    #[effects(A)]\n    pub(crate) fn push_stmt(&mut self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n        self.flush();\n        let s = self.f.stmt(op, a, b, c, d);\n        self.pending.push(s);\n        s\n    }\n\n    // An expression made outside every emit range (a call's result).\n    #[effects(A)]\n    pub(crate) fn unemitted(&mut self, op: u8, ty: i64) -> i64 {\n        self.flush();\n        let e = self.f.expr(op, ty, 0, 0, 0);\n        self.emit_start = self.f.exprs.len() as i64;\n        e\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn global_expr(&mut self, g: i64) -> i64 {\n        if self.gexpr[g as usize] >= 0 {\n            return self.gexpr[g as usize];\n        }\n        let gl = self.m.globals[g as usize];\n        let ty = if gl.space == SP_HANDLE { gl.ty }\n            else { self.m.ptr_ty(gl.ty, gl.space, gl.access) };\n        let e = self.f.expr(E_GLOBAL, ty, g, 0, 0);\n        self.gexpr[g as usize] = e;\n        e\n    }\n\n    // ---- The module ----\n\n    // Finds every module-scope declaration, without resolving any.\n    fn skim(&mut self) {\n        for _ in 0..self.tk.names.len() as i64 {\n            self.decl_of.push(-1);\n        }\n        while self.kind() != T_EOF {\n            let attr = self.p;\n            self.skip_attrs();\n            let tok = self.p;\n            if self.is_kw(K_ENABLE) || self.is_kw(K_REQUIRES) || self.is_kw(K_DIAGNOSTIC) {\n                let at = self.pos();\n                if self.is_kw(K_DIAGNOSTIC) {\n                    self.skip_to_semi();\n                    continue;\n                }\n                self.p += 1;\n                let what = self.text(self.p);\n                if self.err(at, b\"wgsl.unsupported\") {\n                    {\n                        let what = str::from_utf8(what).unwrap();\n                        write(self.emsg,\n");
    buf_str(out, c"                            \"'{what}' is not in the WGSL subset of this release (no extensions)\").unwrap();\n                    }\n                    self.help(b\"remove the directive; f16 and the other extensions come later\");\n                }\n                return;\n            }\n            if self.is_kw(K_CONST_ASSERT) {\n                self.fail(self.pos(), b\"wgsl.unsupported\",\n                    b\"'const_assert' is not in the WGSL subset of this release\");\n                return;\n            }\n            if self.is_kw(K_OVERRIDE) {\n                self.fail(self.pos(), b\"wgsl.unsupported\",\n                    b\"'override' constants are not in the WGSL subset of this release\");\n                self.help(b\"use a 'const', or a uniform buffer\");\n                return;\n            }\n            if self.eat(T_SEMI) {\n                continue;\n            }\n            let mut kind = D_FN;\n            if self.is_kw(K_FN) {\n                kind = D_FN;\n            } else if self.is_kw(K_STRUCT) {\n                kind = D_STRUCT;\n            } else if self.is_kw(K_VAR) {\n                kind = D_VAR;\n            } else if self.is_kw(K_CONST) {\n                kind = D_CONST;\n            } else if self.is_kw(K_ALIAS) {\n                kind = D_ALIAS;\n            } else {\n                if self.kind() == T_IDENT && self.text(self.p) == b\"let\" {\n                    self.fail(self.pos(), b\"wgsl.syntax\", b\"'let' is not allowed at module scope\");\n                    self.help(b\"use 'const' for a module-scope constant\");\n                    return;\n                }\n                if self.err(self.pos(), b\"wgsl.syntax\") {\n                    self.emsg.extend_from_slice(\n                        b\"expected a declaration ('fn', 'struct', 'var', 'const', 'alias'), got \");\n                    if self.kind() == T_IDENT {\n");
    buf_str(out, c"                        write(self.emsg, \"'{}'\", str::from_utf8(self.text(self.p)).unwrap()).unwrap();\n                    } else {\n                        self.emsg.extend_from_slice(token_text(self.kind()));\n                    }\n                }\n                return;\n            }\n            self.p += 1;\n            if kind == D_VAR && self.kind() == T_LT {\n                self.skip_template();\n            }\n            let at = self.pos();\n            let sym = self.ident();\n            if sym >= 0 {\n                if self.decl_of[sym as usize] >= 0 {\n                    if self.err(at, b\"wgsl.redefined\") {\n                        write(self.emsg, \"'{}' is declared twice at module scope\",\n                            str::from_utf8(self.name_of(sym)).unwrap()).unwrap();\n                    }\n                    return;\n                }\n                self.decl_of[sym as usize] = self.decls.len() as i64;\n            }\n            self.decls.push(Decl {\n                kind: kind, state: DS_TODO, sym: sym, tok: tok, attr: attr, h: -1,\n                cv: cint(0, -1, 0), has_cv: false,\n            });\n            if kind == D_FN {\n                while self.kind() != T_LBRACE && self.kind() != T_EOF {\n                    self.p += 1;\n                }\n                self.skip_balanced();\n            } else if kind == D_STRUCT {\n                self.skip_balanced();\n                self.eat(T_SEMI);\n            } else {\n                self.skip_to_semi();\n            }\n        }\n    }\n\n    fn skip_attrs(&mut self) {\n        while self.kind() == T_AT {\n            self.p += 1;\n            self.ident();\n            if self.kind() == T_LPAREN {\n                self.skip_balanced();\n            }\n        }\n    }\n\n    // Skips a bracketed group from its opening token.\n    fn skip_balanced(&mut self) {\n        let mut depth: i64 = 0;\n        loop {\n            let k = self.kind();\n");
    buf_str(out, c"            if k == T_EOF {\n                return;\n            }\n            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n                depth += 1;\n            } else if k == T_RPAREN || k == T_RBRACE || k == T_RBRACKET {\n                depth -= 1;\n            }\n            self.p += 1;\n            if depth <= 0 {\n                return;\n            }\n        }\n    }\n\n    fn skip_template(&mut self) {\n        let mut depth: i64 = 0;\n        loop {\n            let k = self.kind();\n            if k == T_EOF {\n                return;\n            }\n            if k == T_LT {\n                depth += 1;\n            } else if k == T_GT {\n                depth -= 1;\n            } else if k == T_SHR {\n                depth -= 2;\n            }\n            self.p += 1;\n            if depth <= 0 {\n                return;\n            }\n        }\n    }\n\n    fn skip_to_semi(&mut self) {\n        while self.kind() != T_SEMI && self.kind() != T_EOF {\n            let k = self.kind();\n            if k == T_LPAREN || k == T_LBRACE || k == T_LBRACKET {\n                self.skip_balanced();\n            } else {\n                self.p += 1;\n            }\n        }\n        self.eat(T_SEMI);\n    }\n\n    // Resolves the whole module: types, globals, signatures, then bodies.\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub fn module(&mut self) {\n        if self.tk.open_comment >= 0 {\n            self.fail(self.tk.open_comment, b\"wgsl.syntax\", b\"this block comment is not closed\");\n            return;\n        }\n        for i in 0..self.tk.kinds.len() as i64 {\n            if self.tk.kinds[i as usize] == lex::T_BAD {\n                self.p = i;\n                if self.err(self.pos(), b\"wgsl.syntax\") {\n                    write(self.emsg, \"unexpected character '{}'\",\n                        str::from_utf8(self.text(i)).unwrap()).unwrap();\n                }\n                return;\n            }\n");
    buf_str(out, c"        }\n        self.skim();\n        if self.failed {\n            return;\n        }\n        // function handles, in declaration order\n        for i in 0..self.decls.len() as i64 {\n            if self.decls[i as usize].kind == D_FN {\n                self.decls[i as usize].h = self.m.functions.len() as i64;\n                let f = new_function(self.name_of(self.decls[i as usize].sym), self.a);\n                self.m.functions.push(f);\n            }\n        }\n        self.f = mem::replace(&mut self.m.consts, new_function(b\"\", self.a));\n        for i in 0..self.decls.len() as i64 {\n            let k = self.decls[i as usize].kind;\n            if k == D_STRUCT || k == D_ALIAS {\n                self.resolve_type_decl(i);\n            } else if k == D_VAR {\n                self.resolve_global(i);\n            } else if k == D_CONST {\n                self.const_value(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        self.m.consts = mem::replace(&mut self.f, new_function(b\"\", self.a));\n        for i in 0..self.decls.len() as i64 {\n            if self.decls[i as usize].kind == D_FN {\n                self.signature(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        for i in 0..self.decls.len() as i64 {\n            if self.decls[i as usize].kind == D_FN {\n                self.lower_fn(i);\n            }\n            if self.failed {\n                return;\n            }\n        }\n        self.check_calls();\n    }\n\n    // ---- Attributes ----\n\n    fn const_int_arg(&mut self) -> i64 {\n        let at = self.pos();\n        let v = self.parse_expr();\n        if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n            self.fail(at, b\"wgsl.type\", b\"expected a constant integer\");\n            return 0;\n        }\n        v.iv\n    }\n\n");
    buf_str(out, c"    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn parse_attrs(&mut self) -> Attrs {\n        let mut at = Attrs {\n            stage: -1, wg: [0i64, 0, 0], group: -1, binding: -1, loc: -1, builtin: -1, interp: -1,\n            pos: self.pos(),\n        };\n        while self.kind() == T_AT {\n            self.p += 1;\n            let apos = self.pos();\n            let s = self.ident();\n            if s == K_VERTEX {\n                at.stage = STAGE_VERTEX as i64;\n            } else if s == K_FRAGMENT {\n                at.stage = STAGE_FRAGMENT as i64;\n            } else if s == K_COMPUTE {\n                at.stage = STAGE_COMPUTE as i64;\n            } else if s == K_WORKGROUP_SIZE {\n                self.expect(T_LPAREN);\n                at.wg = [1i64, 1, 1];\n                let mut i: i64 = 0;\n                while i < 3 && self.kind() != T_RPAREN && self.kind() != T_EOF {\n                    let p = self.pos();\n                    let n = self.const_int_arg();\n                    if n < 1 || n > 1024 {\n                        self.fail(p, b\"wgsl.attr\", b\"a workgroup size is 1 to 1024\");\n                    }\n                    at.wg[i as usize] = n;\n                    i += 1;\n                    if !self.eat(T_COMMA) {\n                        break;\n                    }\n                }\n                self.expect(T_RPAREN);\n                if at.wg[0] * at.wg[1] * at.wg[2] > 1024 {\n                    self.fail(apos, b\"wgsl.attr\", b\"a workgroup has at most 1024 invocations\");\n                }\n            } else if s == K_GROUP || s == K_BINDING || s == K_LOCATION {\n                self.expect(T_LPAREN);\n                let p = self.pos();\n                let n = self.const_int_arg();\n                self.eat(T_COMMA);\n                self.expect(T_RPAREN);\n                if n < 0 {\n                    self.fail(p, b\"wgsl.attr\", b\"expected a non-negative integer\");\n                }\n");
    buf_str(out, c"                if s == K_GROUP {\n                    at.group = n;\n                } else if s == K_BINDING {\n                    at.binding = n;\n                } else {\n                    at.loc = n;\n                }\n            } else if s == K_BUILTIN {\n                self.expect(T_LPAREN);\n                let bp = self.pos();\n                let b = self.ident();\n                self.eat(T_COMMA);\n                self.expect(T_RPAREN);\n                if b >= names::K_POSITION && b <= names::K_NUM_WORKGROUPS {\n                    at.builtin = b - names::K_POSITION;\n                } else if self.err(bp, b\"wgsl.attr\") {\n                    write(self.emsg, \"unknown builtin value '{}'\",\n                        str::from_utf8(self.name_of(b)).unwrap()).unwrap();\n                }\n            } else if s == K_INTERPOLATE {\n                self.expect(T_LPAREN);\n                let ip = self.pos();\n                let k = self.ident();\n                if k == K_FLAT {\n                    at.interp = INTERP_FLAT as i64;\n                } else if k == K_LINEAR {\n                    at.interp = INTERP_LINEAR as i64;\n                } else if k == K_PERSPECTIVE {\n                    at.interp = INTERP_PERSPECTIVE as i64;\n                } else {\n                    self.fail(ip, b\"wgsl.attr\", b\"expected 'flat', 'linear' or 'perspective'\");\n                }\n                if self.eat(T_COMMA) && self.kind() == T_IDENT {\n                    let smp = self.ident();\n                    if smp != K_CENTER {\n                        if smp == K_CENTROID || smp == K_SAMPLE {\n                            self.fail(ip, b\"wgsl.unsupported\",\n                                b\"only 'center' sampling is in the WGSL subset of this release\");\n                        }\n                    }\n                    self.eat(T_COMMA);\n                }\n                self.expect(T_RPAREN);\n            } else if s == K_MUST_USE {\n");
    buf_str(out, c"            } else if s == K_INVARIANT || s == K_ALIGN || s == K_SIZE || s == K_ID {\n                if self.err(apos, b\"wgsl.unsupported\") {\n                    write(self.emsg, \"'@{}' is not in the WGSL subset of this release\",\n                        str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                }\n            } else if self.err(apos, b\"wgsl.attr\") {\n                write(self.emsg, \"unknown attribute '@{}'\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n        }\n        at\n    }\n\n    fn binding_of(&self, at: Attrs) -> Binding {\n        if at.builtin >= 0 {\n            return Binding { kind: BIND_BUILTIN, interp: INTERP_PERSPECTIVE, value: at.builtin };\n        }\n        if at.loc >= 0 {\n            let ip = if at.interp >= 0 { at.interp as u8 } else { INTERP_PERSPECTIVE };\n            return Binding { kind: BIND_LOCATION, interp: ip, value: at.loc };\n        }\n        no_binding()\n    }\n\n    // ---- Types ----\n\n    fn resolve_type_decl(&mut self, d: i64) -> i64 {\n        let dd = self.decls[d as usize];\n        if dd.state == DS_DONE {\n            return dd.h;\n        }\n        if dd.state == DS_BUSY {\n            self.p = dd.tok;\n            if self.err(self.pos(), b\"wgsl.cycle\") {\n                write(self.emsg, \"'{}' refers to itself\",\n                    str::from_utf8(self.name_of(dd.sym)).unwrap()).unwrap();\n            }\n            return T_I32;\n        }\n        self.decls[d as usize].state = DS_BUSY;\n        let saved = self.p;\n        self.p = dd.tok + 2;\n        let mut h = T_I32;\n        if dd.kind == D_ALIAS {\n            self.expect(T_EQ);\n            h = self.parse_type();\n            self.eat(T_SEMI);\n        } else {\n            h = self.struct_body(dd.sym);\n        }\n        self.p = saved;\n        self.decls[d as usize].state = DS_DONE;\n        self.decls[d as usize].h = h;\n        h\n    }\n\n");
    buf_str(out, c"    fn struct_body(&mut self, sym: i64) -> i64 {\n        self.expect(T_LBRACE);\n        let mut list: Vec<StructMember<'a>, A> = Vec::new_in(self.a);\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            let at = self.parse_attrs();\n            let mpos = self.pos();\n            let ms = self.ident();\n            self.expect(T_COLON);\n            let tpos = self.pos();\n            let ty = self.parse_type();\n            for i in 0..list.len() as i64 {\n                if list[i as usize].name == self.name_of(ms) {\n                    if self.err(mpos, b\"wgsl.redefined\") {\n                        write(self.emsg, \"member '{}' is declared twice\",\n                            str::from_utf8(self.name_of(ms)).unwrap()).unwrap();\n                    }\n                }\n            }\n            if self.m.is_runtime_sized(ty) && self.kind() != T_RBRACE\n                && !(self.kind() == T_COMMA && self.kind_at(self.p + 1) == T_RBRACE) {\n                self.fail(tpos, b\"wgsl.type\",\n                    b\"a runtime-sized array must be the last member of a struct\");\n            }\n            if !self.storable(ty) {\n                if self.err(tpos, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"a struct member cannot have type \");\n                    self.ty_str(ty);\n                }\n            }\n            list.push(StructMember {\n                name: self.name_of(ms), ty: ty, offset: 0, binding: self.binding_of(at),\n            });\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RBRACE);\n        if list.len() as i64 == 0 {\n            self.fail(self.pos(), b\"wgsl.type\", b\"a struct has at least one member\");\n        }\n        let start = self.m.members.len() as i64;\n        for i in 0..list.len() as i64 {\n            self.m.members.push(list[i as usize]);\n        }\n");
    buf_str(out, c"        self.m.struct_ty(self.name_of(sym), start, list.len() as i64)\n    }\n\n    // Whether values of t can live in memory (not pointers, textures, samplers).\n    #[effects(panic, A)]\n    pub(crate) fn storable(&self, t: i64) -> bool {\n        let k = self.m.types[t as usize].kind;\n        k != TK_POINTER && k != TK_TEXTURE && k != TK_SAMPLER\n    }\n\n    // An optional `<T>` after vecN / matCxR: T, else -1.\n    fn template_scalar(&mut self) -> i64 {\n        if self.kind() != T_LT {\n            return -1;\n        }\n        self.p += 1;\n        let t = self.parse_type();\n        self.expect_gt();\n        t\n    }\n\n    // Whether the identifier at the cursor starts a type (for `T(...)`\n    // constructors and template lists in expressions).\n    #[effects(panic, A)]\n    pub(crate) fn is_type_name(&self, s: i64) -> bool {\n        if s >= names::K_BOOL && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n            return true;\n        }\n        if s >= 0 && self.decl_of[s as usize] >= 0 {\n            let k = self.decls[self.decl_of[s as usize] as usize].kind;\n            return k == D_STRUCT || k == D_ALIAS;\n        }\n        false\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn parse_type(&mut self) -> i64 {\n        let at = self.pos();\n        if self.kind() != T_IDENT {\n            self.expect(T_IDENT);\n            return T_I32;\n        }\n        let s = self.tk.syms[self.p as usize];\n        self.p += 1;\n        if s == names::K_BOOL {\n            return T_BOOL;\n        }\n        if s == names::K_I32 {\n            return T_I32;\n        }\n        if s == names::K_U32 {\n            return T_U32;\n        }\n        if s == names::K_F32 {\n            return T_F32;\n        }\n        if s == names::K_F16 || (s >= names::K_VEC2H && s <= names::K_VEC4H) {\n            self.fail(at, b\"wgsl.unsupported\", b\"'f16' is not in the WGSL subset of this release\");\n");
    buf_str(out, c"            self.help(b\"use f32\");\n            return T_F32;\n        }\n        if s >= names::K_VEC2 && s <= names::K_VEC4 {\n            let n = s - names::K_VEC2 + 2;\n            if self.kind() != T_LT {\n                self.fail(at, b\"wgsl.type\",\n                    b\"a vector type needs its component type, as in 'vec3<f32>' or 'vec3f'\");\n                return T_F32;\n            }\n            let c = self.template_scalar();\n            let k = self.m.types[c as usize].kind;\n            if k != TK_SCALAR {\n                self.fail(at, b\"wgsl.type\", b\"a vector's components are bool, i32, u32 or f32\");\n                return T_F32;\n            }\n            return ir::vec_ty(self.m.types[c as usize].scalar, n);\n        }\n        if s >= names::K_VEC2I && s <= names::K_VEC4F {\n            let i = s - names::K_VEC2I;\n            let sk = if i < 3 { SK_I32 } else if i < 6 { SK_U32 } else { SK_F32 };\n            return ir::vec_ty(sk, i % 3 + 2);\n        }\n        if s >= names::K_MAT2X2 && s <= names::K_MAT4X4F {\n            let i = (s - names::K_MAT2X2) % 9;\n            if s <= names::K_MAT4X4 {\n                if self.kind() != T_LT {\n                    self.fail(at, b\"wgsl.type\",\n                        b\"a matrix type needs its component type, as in 'mat4x4<f32>' or 'mat4x4f'\");\n                    return T_F32;\n                }\n                let c = self.template_scalar();\n                if c != T_F32 {\n                    self.fail(at, b\"wgsl.type\",\n                        b\"matrices have f32 components in the WGSL subset of this release\");\n                }\n            }\n            return ir::mat_ty(i / 3 + 2, i % 3 + 2);\n        }\n        if s == names::K_ARRAY {\n            if self.kind() != T_LT {\n                self.fail(at, b\"wgsl.type\",\n                    b\"an array type needs its element type, as in 'array<f32, 4>'\");\n                return T_I32;\n            }\n");
    buf_str(out, c"            self.p += 1;\n            let ep = self.pos();\n            let el = self.parse_type();\n            let mut n: i64 = 0;\n            if self.eat(T_COMMA) {\n                let np = self.pos();\n                let saved_f = self.save_scope_floor();\n                let v = self.parse_shift();\n                self.scope_floor = saved_f;\n                if v.k != VK_CONST || v.sk == SK_F32 || v.sk == ir::SK_AFLOAT || v.sk == SK_BOOL {\n                    self.fail(np, b\"wgsl.type\", b\"an array's length is a constant integer\");\n                    self.help(\n                        b\"a runtime-sized array is written 'array<T>' and lives in a storage buffer\");\n                } else if v.iv < 1 {\n                    self.fail(np, b\"wgsl.type\", b\"an array's length is at least 1\");\n                } else {\n                    n = v.iv;\n                }\n            }\n            self.expect_gt();\n            if self.m.is_runtime_sized(el) {\n                self.fail(ep, b\"wgsl.type\", b\"an array's element cannot be runtime-sized\");\n            }\n            if !self.storable(el) {\n                self.fail(ep, b\"wgsl.type\",\n                    b\"an array's element cannot be a pointer, texture or sampler\");\n            }\n            return self.m.array_ty(el, n);\n        }\n        if s == names::K_ATOMIC {\n            self.expect(T_LT);\n            let c = self.parse_type();\n            self.expect_gt();\n            if c != T_I32 && c != T_U32 {\n                self.fail(at, b\"wgsl.type\", b\"an atomic holds an i32 or a u32\");\n                return self.m.atomic_ty(SK_U32);\n            }\n            return self.m.atomic_ty(self.m.types[c as usize].scalar);\n        }\n        if s == names::K_PTR {\n            self.expect(T_LT);\n            let sp = self.address_space();\n            self.expect(T_COMMA);\n            let t = self.parse_type();\n");
    buf_str(out, c"            let mut acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n            if self.eat(T_COMMA) {\n                acc = self.access_mode();\n            }\n            self.expect_gt();\n            if sp != SP_FUNCTION && sp != SP_PRIVATE {\n                // pointers to other spaces are values only (lets), never parameters\n            }\n            return self.m.ptr_ty(t, sp, acc);\n        }\n        if s == names::K_SAMPLER {\n            return self.m.intern(TK_SAMPLER, 0, 0, 0, -1, 0, 0);\n        }\n        if s == names::K_SAMPLER_COMPARISON {\n            return self.m.intern(TK_SAMPLER, 0, 1, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_2D || s == names::K_TEXTURE_2D_ARRAY {\n            self.expect(T_LT);\n            let c = self.parse_type();\n            self.expect_gt();\n            if c != T_F32 && c != T_I32 && c != T_U32 {\n                self.fail(at, b\"wgsl.type\", b\"a texture's sampled type is f32, i32 or u32\");\n            }\n            let dim = if s == names::K_TEXTURE_2D { ir::TEX_2D } else { ir::TEX_2D_ARRAY };\n            return self.m.intern(TK_TEXTURE, self.m.types[c as usize].scalar, dim, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_DEPTH_2D {\n            return self.m.intern(TK_TEXTURE, SK_F32, ir::TEX_DEPTH_2D, 0, -1, 0, 0);\n        }\n        if s == names::K_TEXTURE_STORAGE_2D {\n            self.expect(T_LT);\n            let fp = self.pos();\n            let f = self.ident();\n            let mut fmt: i64 = 0;\n            if f >= names::K_RGBA8UNORM && f <= names::K_RGBA32UINT {\n                fmt = f - names::K_RGBA8UNORM;\n            } else if f >= names::K_RGBA16FLOAT && f <= names::K_RG32FLOAT {\n                fmt = ir::FMT_RGBA16FLOAT + (f - names::K_RGBA16FLOAT);\n            } else {\n                // (gpu::Format::is_storable says the same formats)\n");
    buf_str(out, c"                self.fail(fp, b\"wgsl.unsupported\", b\"storage textures in this release are rgba8unorm, rgba8uint, rgba16float, rgba32float, rgba32uint, rg32float, r32float, r32uint or r32sint\");\n            }\n            self.expect(T_COMMA);\n            let ap = self.pos();\n            let acc = self.access_mode();\n            if acc != ACC_WRITE {\n                self.fail(ap, b\"wgsl.unsupported\",\n                    b\"storage textures are write-only in this release\");\n            }\n            self.expect_gt();\n            let sk = if fmt == ir::FMT_R32UINT || fmt == ir::FMT_RGBA32UINT\n                || fmt == ir::FMT_RGBA8UINT {\n                SK_U32\n            } else if fmt == ir::FMT_R32SINT {\n                SK_I32\n            } else {\n                SK_F32\n            };\n            return self.m.intern(TK_TEXTURE, sk, ir::TEX_STORAGE_2D, fmt, -1, 0, ACC_WRITE);\n        }\n        if s >= names::K_TEXTURE_1D && s <= names::K_TEXTURE_STORAGE_2D_ARRAY {\n            if self.err(at, b\"wgsl.unsupported\") {\n                write(self.emsg, \"'{}' is not in the WGSL subset of this release\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                self.help(b\"2D textures are: texture_2d, texture_2d_array, texture_depth_2d, texture_storage_2d\");\n            }\n            return T_F32;\n        }\n        if self.decl_of[s as usize] >= 0 {\n            let d = self.decl_of[s as usize];\n            let k = self.decls[d as usize].kind;\n            if k == D_STRUCT || k == D_ALIAS {\n                return self.resolve_type_decl(d);\n            }\n            if self.err(at, b\"wgsl.type\") {\n                write(self.emsg, \"'{}' is not a type\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n            return T_I32;\n        }\n        if self.err(at, b\"wgsl.name\") {\n            write(self.emsg, \"unknown type '{}'\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n");
    buf_str(out, c"            self.help(b\"the types are bool, i32, u32, f32, vecN<T>, matCxR<f32>, array<T, N>, atomic<T>, structs\");\n        }\n        T_I32\n    }\n\n    fn address_space(&mut self) -> u8 {\n        let at = self.pos();\n        let s = self.ident();\n        if s == names::K_FUNCTION {\n            SP_FUNCTION\n        } else if s == names::K_PRIVATE {\n            SP_PRIVATE\n        } else if s == names::K_WORKGROUP {\n            SP_WORKGROUP\n        } else if s == names::K_UNIFORM {\n            SP_UNIFORM\n        } else if s == names::K_STORAGE {\n            SP_STORAGE\n        } else {\n            if self.err(at, b\"wgsl.syntax\") {\n                write(self.emsg, \"unknown address space '{}'\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                self.help(b\"the address spaces are function, private, workgroup, uniform, storage\");\n            }\n            SP_PRIVATE\n        }\n    }\n\n    fn access_mode(&mut self) -> u8 {\n        let at = self.pos();\n        let s = self.ident();\n        if s == names::K_READ {\n            ACC_READ\n        } else if s == names::K_WRITE {\n            ACC_WRITE\n        } else if s == names::K_READ_WRITE {\n            ACC_RW\n        } else {\n            if self.err(at, b\"wgsl.syntax\") {\n                write(self.emsg, \"unknown access mode '{}'\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n            ACC_READ\n        }\n    }\n\n    // ---- Globals and constants ----\n\n    fn resolve_global(&mut self, d: i64) {\n        let dd = self.decls[d as usize];\n        let saved = self.p;\n        self.p = dd.attr;\n        let at = self.parse_attrs();\n        self.p = dd.tok + 1;\n        let mut sp = SP_HANDLE;\n        let mut acc = ACC_READ;\n        let mut explicit_space = false;\n        if self.eat(T_LT) {\n            explicit_space = true;\n            sp = self.address_space();\n");
    buf_str(out, c"            acc = if sp == SP_STORAGE || sp == SP_UNIFORM { ACC_READ } else { ACC_RW };\n            if self.eat(T_COMMA) {\n                let ap = self.pos();\n                acc = self.access_mode();\n                if sp != SP_STORAGE {\n                    self.fail(ap, b\"wgsl.type\", b\"only storage variables have an access mode\");\n                }\n                if acc == ACC_WRITE {\n                    self.fail(ap, b\"wgsl.type\", b\"storage variables are 'read' or 'read_write'\");\n                }\n            }\n            self.expect_gt();\n        }\n        let npos = self.pos();\n        self.ident();\n        let mut ty = T_I32;\n        let mut have_ty = false;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n            have_ty = true;\n        }\n        let mut init: i64 = -1;\n        if self.eat(T_EQ) {\n            let ip = self.pos();\n            if sp != SP_PRIVATE {\n                self.fail(ip, b\"wgsl.type\",\n                    b\"only 'var<private>' may have an initializer at module scope\");\n            }\n            let v = self.parse_expr_hint(if have_ty { ty } else { -1 });\n            if !have_ty {\n                ty = self.concrete_type_of(v);\n                have_ty = true;\n            }\n            init = self.materialize(v, ty, ip);\n            if !self.is_const_expr(init) {\n                self.fail(ip, b\"wgsl.type\",\n                    b\"a module-scope initializer must be a constant expression\");\n            }\n        }\n        self.eat(T_SEMI);\n        if !have_ty {\n            self.fail(npos, b\"wgsl.type\", b\"a module-scope 'var' needs a type\");\n        }\n        let tk = self.m.types[ty as usize].kind;\n        if !explicit_space {\n            if tk != TK_TEXTURE && tk != TK_SAMPLER {\n                self.fail(npos, b\"wgsl.type\", b\"a module-scope 'var' needs an address space, as in 'var<private>' or 'var<storage, read_write>'\");\n            }\n");
    buf_str(out, c"        } else if tk == TK_TEXTURE || tk == TK_SAMPLER {\n            self.fail(npos, b\"wgsl.type\", b\"a texture or sampler is declared without an address space: 'var t: texture_2d<f32>;'\");\n        }\n        if sp == SP_UNIFORM || sp == SP_STORAGE || sp == SP_HANDLE {\n            if at.group < 0 || at.binding < 0 {\n                self.fail(npos, b\"wgsl.binding\", b\"a resource needs '@group(G) @binding(B)'\");\n            }\n        } else if at.group >= 0 || at.binding >= 0 {\n            self.fail(npos, b\"wgsl.binding\",\n                b\"only uniform, storage, texture and sampler variables have a group and binding\");\n        }\n        if sp == SP_UNIFORM && self.m.is_runtime_sized(ty) {\n            self.fail(npos, b\"wgsl.type\", b\"a uniform buffer cannot hold a runtime-sized array\");\n        }\n        if sp != SP_STORAGE && self.m.is_runtime_sized(ty) {\n            self.fail(npos, b\"wgsl.type\", b\"a runtime-sized array lives only in a storage buffer\");\n        }\n        if self.m.has_atomic(ty) && sp != SP_STORAGE && sp != SP_WORKGROUP {\n            self.fail(npos, b\"wgsl.type\", b\"atomics live in storage or workgroup memory\");\n        }\n        if self.m.has_atomic(ty) && sp == SP_STORAGE && acc != ACC_RW {\n            self.fail(npos, b\"wgsl.type\", b\"atomics need 'var<storage, read_write>'\");\n        }\n        if (sp == SP_UNIFORM || sp == SP_STORAGE) && !self.host_shareable(ty) {\n            self.fail(npos, b\"wgsl.type\",\n                b\"a buffer's type cannot hold bool, pointers or textures\");\n        }\n        if sp == SP_UNIFORM {\n            self.check_uniform_layout(ty, npos);\n        }\n        for i in 0..self.m.globals.len() as i64 {\n            let o = self.m.globals[i as usize];\n            if o.group >= 0 && o.group == at.group && o.binding == at.binding {\n                if self.err(npos, b\"wgsl.binding\") {\n");
    buf_str(out, c"                    write(self.emsg, \"@group({}) @binding({}) is also '{}': two variables of one module never share a binding, even when different entry points use them\", at.group, at.binding, str::from_utf8(o.name).unwrap()).unwrap();\n                    self.help(b\"give each kernel its own module (one dev.shader_wgsl each; the shared declarations can be a common prefix of their texts), or give the variables distinct bindings\");\n                }\n            }\n        }\n        let g = Global {\n            name: self.name_of(dd.sym),\n            space: sp,\n            access: acc,\n            ty: ty,\n            group: at.group,\n            binding: at.binding,\n            init: init,\n            pos: npos,\n        };\n        self.m.globals.push(g);\n        self.decls[d as usize].h = self.m.globals.len() as i64 - 1;\n        self.decls[d as usize].state = DS_DONE;\n        self.p = saved;\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn host_shareable(&self, t: i64) -> bool {\n        let ty = self.m.types[t as usize];\n        if ty.kind == TK_SCALAR || ty.kind == TK_VECTOR {\n            return ty.scalar != SK_BOOL;\n        }\n        if ty.kind == TK_MATRIX || ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.host_shareable(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if !self.host_shareable(self.m.members[i as usize].ty) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        false\n    }\n\n    // The uniform address space's extra rules: array strides and struct\n    // alignments are multiples of 16.\n    fn check_uniform_layout(&mut self, t: i64, pos: i64) {\n        let ty = self.m.types[t as usize];\n        if ty.kind == TK_ARRAY {\n            if ty.stride % 16 != 0 {\n");
    buf_str(out, c"                if self.err(pos, b\"wgsl.layout\") {\n                    self.emsg.extend_from_slice(\n                        b\"in a uniform buffer an array's stride is a multiple of 16; \");\n                    self.ty_str(t);\n                    write(self.emsg, \" has {}\", ty.stride).unwrap();\n                    self.help(b\"use vec4 elements, or a storage buffer\");\n                }\n            }\n            self.check_uniform_layout(ty.base, pos);\n        } else if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                let mt = self.m.members[i as usize].ty;\n                let mk = self.m.types[mt as usize].kind;\n                if mk == TK_STRUCT && i > ty.mstart {\n                    let prev = self.m.members[(i - 1) as usize];\n                    let prev_end = prev.offset + self.m.types[prev.ty as usize].size;\n                    if self.m.members[i as usize].offset - prev_end < 0\n                        || self.m.members[i as usize].offset % 16 != 0 {\n                        if self.err(pos, b\"wgsl.layout\") {\n                            write(self.emsg, \"in a uniform buffer the struct member '{}' must start at a multiple of 16\", str::from_utf8(self.m.members[i as usize].name).unwrap()).unwrap();\n                        }\n                    }\n                }\n                self.check_uniform_layout(mt, pos);\n            }\n        }\n    }\n\n    // A constant's value, evaluated once when it is a scalar; composites\n    // are re-made at each use, in the using function.\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn const_value(&mut self, d: i64) -> Val {\n        let dd = self.decls[d as usize];\n        if dd.has_cv {\n            return dd.cv;\n        }\n        if dd.state == DS_BUSY {\n            self.p = dd.tok;\n            if self.err(self.pos(), b\"wgsl.cycle\") {\n                write(self.emsg, \"'{}' refers to itself\",\n");
    buf_str(out, c"                    str::from_utf8(self.name_of(dd.sym)).unwrap()).unwrap();\n            }\n            return cint(ir::SK_AINT, -1, 0);\n        }\n        self.decls[d as usize].state = DS_BUSY;\n        let saved = self.p;\n        let saved_floor = self.save_scope_floor();\n        self.p = dd.tok + 2;\n        let mut ty: i64 = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        self.expect(T_EQ);\n        let ip = self.pos();\n        let mut v = self.parse_expr_hint(ty);\n        if ty >= 0 {\n            v = self.convert_to(v, ty, ip);\n        }\n        if v.k == VK_REF {\n            self.fail(ip, b\"wgsl.type\", b\"a 'const' is a constant expression; this reads memory\");\n        } else if v.k == VK_VALUE && !self.is_const_expr(v.e) {\n            self.fail(ip, b\"wgsl.type\", b\"a 'const' is a constant expression\");\n        }\n        self.scope_floor = saved_floor;\n        self.p = saved;\n        self.decls[d as usize].state = DS_DONE;\n        if v.k == VK_CONST {\n            self.decls[d as usize].cv = v;\n            self.decls[d as usize].has_cv = true;\n        }\n        v\n    }\n\n    // Lookups see only module-scope names until the floor is restored.\n    #[effects(A)]\n    pub(crate) fn save_scope_floor(&mut self) -> i64 {\n        let s = self.scope_floor;\n        self.scope_floor = self.scopes.len() as i64;\n        s\n    }\n\n    // Whether e is made of literals, zero values and compositions only.\n    #[effects(panic, A)]\n    pub(crate) fn is_const_expr(&self, e: i64) -> bool {\n        if e < 0 {\n            return true;\n        }\n        let x = self.f.exprs[e as usize];\n        if x.op == ir::E_LITERAL || x.op == ir::E_ZERO {\n            return true;\n        }\n        if x.op == ir::E_COMPOSE {\n            for i in x.a..x.a + x.b {\n                if !self.is_const_expr(self.f.args[i as usize]) {\n                    return false;\n                }\n            }\n");
    buf_str(out, c"            return true;\n        }\n        if x.op == ir::E_SPLAT {\n            return self.is_const_expr(x.a);\n        }\n        false\n    }\n\n    // ---- Functions ----\n\n    fn signature(&mut self, d: i64) {\n        let dd = self.decls[d as usize];\n        let h = dd.h;\n        let saved = self.p;\n        self.p = dd.tok + 2;\n        self.expect(T_LPAREN);\n        let mut params: Vec<Param<'a>, A> = Vec::new_in(self.a);\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let at = self.parse_attrs();\n            let ppos = self.pos();\n            let ps = self.ident();\n            self.expect(T_COLON);\n            let tp = self.pos();\n            let ty = self.parse_type();\n            let tk = self.m.types[ty as usize].kind;\n            if tk == TK_POINTER {\n                let sp = self.m.types[ty as usize].space;\n                if sp != SP_FUNCTION && sp != SP_PRIVATE {\n                    self.fail(tp, b\"wgsl.unsupported\", b\"pointer parameters are 'ptr<function, T>' or 'ptr<private, T>' in this release\");\n                }\n            } else if self.m.is_runtime_sized(ty) || self.m.has_atomic(ty) {\n                self.fail(tp, b\"wgsl.type\",\n                    b\"a parameter cannot hold a runtime-sized array or an atomic\");\n            }\n            for i in 0..params.len() as i64 {\n                if params[i as usize].name == self.name_of(ps) {\n                    if self.err(ppos, b\"wgsl.redefined\") {\n                        write(self.emsg, \"parameter '{}' is declared twice\",\n                            str::from_utf8(self.name_of(ps)).unwrap()).unwrap();\n                    }\n                }\n            }\n            params.push(Param { name: self.name_of(ps), ty: ty, binding: self.binding_of(at) });\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        let mut result: i64 = -1;\n");
    buf_str(out, c"        let mut rb = no_binding();\n        if self.eat(T_ARROW) {\n            let at = self.parse_attrs();\n            let rp = self.pos();\n            result = self.parse_type();\n            rb = self.binding_of(at);\n            if !self.storable(result) || self.m.is_runtime_sized(result)\n                || self.m.has_atomic(result) {\n                self.fail(rp, b\"wgsl.type\", b\"a function cannot return a pointer, texture, sampler, atomic or runtime-sized array\");\n            }\n        }\n        self.m.functions[h as usize].params = params;\n        self.m.functions[h as usize].result = result;\n        self.m.functions[h as usize].result_binding = rb;\n        self.m.functions[h as usize].pos = self.tk.starts[(dd.tok + 1) as usize];\n        // entry point?\n        self.p = dd.attr;\n        let at = self.parse_attrs();\n        if at.stage >= 0 {\n            if at.stage == STAGE_COMPUTE as i64 && at.wg[0] == 0 {\n                self.fail(self.tk.starts[(dd.tok + 1) as usize], b\"wgsl.entry\",\n                    b\"a compute entry point needs '@workgroup_size(X, Y, Z)'\");\n                self.help(b\"for example '@compute @workgroup_size(64)'\");\n            }\n            let wg = if at.stage == STAGE_COMPUTE as i64 { at.wg } else { [0i64, 0, 0] };\n            self.m.entries.push(Entry {\n                stage: at.stage as u8, name: self.name_of(dd.sym), func: h, wg: wg,\n                early_depth: false,\n            });\n            entry::check_interface(self, self.m.entries.len() as i64 - 1);\n        } else if at.wg[0] != 0 {\n            self.fail(at.pos, b\"wgsl.attr\",\n                b\"'@workgroup_size' belongs to a '@compute' entry point\");\n        }\n        self.p = saved;\n    }\n\n    fn lower_fn(&mut self, d: i64) {\n        let dd = self.decls[d as usize];\n        let h = dd.h;\n        self.fh = h;\n        self.f = mem::replace(&mut self.m.functions[h as usize], new_function(b\"\", self.a));\n");
    buf_str(out, c"        self.stage = 255;\n        for i in 0..self.m.entries.len() as i64 {\n            if self.m.entries[i as usize].func == h {\n                self.stage = self.m.entries[i as usize].stage as i64;\n            }\n        }\n        self.gexpr.clear();\n        for _ in 0..self.m.globals.len() as i64 {\n            self.gexpr.push(-1);\n        }\n        self.scopes.clear();\n        self.scope_floor = 0;\n        self.pending.clear();\n        self.emit_start = 0;\n        self.loop_depth = 0;\n        self.switch_depth = 0;\n        self.in_continuing = false;\n        // the parameters\n        self.p = dd.tok + 2;\n        self.expect(T_LPAREN);\n        let mut i: i64 = 0;\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            self.parse_attrs();\n            let ps = self.ident();\n            self.expect(T_COLON);\n            self.parse_type();\n            let ty = self.f.params[i as usize].ty;\n            let e = self.f.expr(E_ARG, ty, i, 0, 0);\n            self.f.names[e as usize] = self.name_of(ps);\n            self.scopes.push(ScopeEntry { sym: ps, v: val(e, ty), mutable: false });\n            i += 1;\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        if self.eat(T_ARROW) {\n            self.parse_attrs();\n            self.parse_type();\n        }\n        let bpos = self.pos();\n        self.expect(T_LBRACE);\n        let base = self.pending.len() as i64;\n        self.statements();\n        let end = self.pos();\n        self.expect(T_RBRACE);\n        self.flush();\n        if self.f.result >= 0 && !self.block_returns(base) {\n            if self.err(end, b\"wgsl.return\") {\n                write(self.emsg, \"function '{}' can reach its end without returning a value\",\n                    str::from_utf8(self.f.name).unwrap()).unwrap();\n                self.help(b\"end it with a 'return'\");\n            }\n        }\n        let _ = bpos;\n");
    buf_str(out, c"        self.f.body = self.f.block_of(&mut self.pending, base);\n        self.m.functions[h as usize] = mem::replace(&mut self.f, new_function(b\"\", self.a));\n    }\n\n    // Whether the statements pending[from ..] always return (or discard).\n    fn block_returns(&self, from: i64) -> bool {\n        for i in from..self.pending.len() as i64 {\n            if self.stmt_returns(self.pending[i as usize]) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn list_returns(&self, blk: i64) -> bool {\n        let b = self.f.blocks[blk as usize];\n        for i in b.start..b.start + b.count {\n            if self.stmt_returns(self.f.items[i as usize]) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn stmt_returns(&self, s: i64) -> bool {\n        let st = self.f.stmts[s as usize];\n        if st.op == S_RETURN || st.op == S_KILL {\n            return true;\n        }\n        if st.op == S_BLOCK {\n            return self.list_returns(st.a);\n        }\n        if st.op == S_IF {\n            return self.list_returns(st.b) && self.list_returns(st.c);\n        }\n        if st.op == S_SWITCH {\n            for i in st.b..st.b + st.c {\n                if !self.list_returns(self.f.cases[i as usize].body) {\n                    return false;\n                }\n            }\n            return true;\n        }\n        if st.op == S_LOOP {\n            // a loop without a break of its own never ends but by returning\n            return !self.has_break(st.a, 0) && !self.has_break(st.b, 0) && st.c < 0;\n        }\n        false\n    }\n\n    fn has_break(&self, blk: i64, depth: i64) -> bool {\n        let b = self.f.blocks[blk as usize];\n        for i in b.start..b.start + b.count {\n            let st = self.f.stmts[self.f.items[i as usize] as usize];\n            if st.op == S_BREAK && depth == 0 {\n                return true;\n            }\n");
    buf_str(out, c"            if st.op == S_BLOCK && self.has_break(st.a, depth) {\n                return true;\n            }\n            if st.op == S_IF && (self.has_break(st.b, depth) || self.has_break(st.c, depth)) {\n                return true;\n            }\n            if st.op == S_SWITCH {\n                for k in st.b..st.b + st.c {\n                    if self.has_break(self.f.cases[k as usize].body, depth + 1) {\n                        return true;\n                    }\n                }\n            }\n            if st.op == S_LOOP\n                && (self.has_break(st.a, depth + 1) || self.has_break(st.b, depth + 1)) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // No recursion: WGSL's call graph is acyclic.\n    fn check_calls(&mut self) {\n        let n = self.m.functions.len() as i64;\n        let mut state: Vec<u8, A> = Vec::from_elem_in(0u8, (n as usize), self.a);\n        for i in 0..n {\n            if !self.visit_calls(i, &mut state) {\n                return;\n            }\n        }\n        for e in 0..self.m.entries.len() as i64 {\n            let fh = self.m.entries[e as usize].func;\n            for i in 0..n {\n                for s in 0..self.m.functions[i as usize].stmts.len() as i64 {\n                    let st = self.m.functions[i as usize].stmts[s as usize];\n                    if st.op == S_CALL && st.a == fh {\n                        let pos = self.m.functions[i as usize].pos;\n                        if self.err(pos, b\"wgsl.call\") {\n                            self.emsg.push(b'\\'');\n                            self.emsg.extend_from_slice(self.m.functions[i as usize].name);\n                            self.emsg.extend_from_slice(b\"' calls the entry point '\");\n                            self.emsg.extend_from_slice(self.m.entries[e as usize].name);\n                            self.emsg.push(b'\\'');\n                        }\n                        return;\n                    }\n");
    buf_str(out, c"                }\n            }\n        }\n    }\n\n    fn visit_calls(&mut self, i: i64, state: &mut Vec<u8, A>) -> bool {\n        if state[i as usize] == 2 {\n            return true;\n        }\n        if state[i as usize] == 1 {\n            let pos = self.m.functions[i as usize].pos;\n            if self.err(pos, b\"wgsl.recursion\") {\n                self.emsg.push(b'\\'');\n                self.emsg.extend_from_slice(self.m.functions[i as usize].name);\n                self.emsg.extend_from_slice(b\"' calls itself, directly or through other functions\");\n                self.help(b\"WGSL has no recursion: write it as a loop\");\n            }\n            return false;\n        }\n        state[i as usize] = 1;\n        for s in 0..self.m.functions[i as usize].stmts.len() as i64 {\n            let st = self.m.functions[i as usize].stmts[s as usize];\n            if st.op == S_CALL {\n                if !self.visit_calls(st.a, state) {\n                    return false;\n                }\n            }\n        }\n        state[i as usize] = 2;\n        true\n    }\n\n    // ---- Statements ----\n\n    fn lookup(&self, sym: i64) -> i64 {\n        let mut i = self.scopes.len() as i64 - 1;\n        while i >= self.scope_floor {\n            if self.scopes[i as usize].sym == sym {\n                return i;\n            }\n            i -= 1;\n        }\n        -1\n    }\n\n    fn statements(&mut self) {\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            if self.in_continuing_end() {\n                return;\n            }\n            self.statement();\n        }\n    }\n\n    // In a loop body, `continuing` ends the body.\n    fn in_continuing_end(&self) -> bool { self.is_kw(K_CONTINUING) && self.loop_depth > 0 }\n\n    // A `{ ... }` block with a scope of its own: its block handle.\n    fn compound(&mut self) -> i64 {\n        self.flush();\n        let base = self.pending.len() as i64;\n");
    buf_str(out, c"        let scope = self.scopes.len() as i64;\n        self.expect(T_LBRACE);\n        self.statements_plain();\n        self.expect(T_RBRACE);\n        self.flush();\n        self.scopes.truncate(scope as usize);\n        self.f.block_of(&mut self.pending, base)\n    }\n\n    fn statements_plain(&mut self) {\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            self.statement();\n        }\n    }\n\n    fn statement(&mut self) {\n        let at = self.pos();\n        let k = self.kind();\n        if k == T_SEMI {\n            self.p += 1;\n            return;\n        }\n        if k == T_LBRACE {\n            let b = self.compound();\n            self.push_stmt(S_BLOCK, b, 0, 0, 0);\n            return;\n        }\n        if k == T_AT {\n            self.fail(at, b\"wgsl.unsupported\",\n                b\"attributes on statements are not in the WGSL subset of this release\");\n            return;\n        }\n        if k == T_IDENT {\n            let s = self.tk.syms[self.p as usize];\n            if s == K_LET || s == K_CONST {\n                self.p += 1;\n                self.let_decl(s == K_CONST);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_VAR {\n                self.p += 1;\n                self.var_decl();\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_IF {\n                self.p += 1;\n                self.if_stmt();\n                return;\n            }\n            if s == K_RETURN {\n                self.p += 1;\n                self.return_stmt(at);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_LOOP {\n                self.p += 1;\n                self.loop_stmt();\n                return;\n            }\n            if s == K_FOR {\n                self.p += 1;\n                self.for_stmt();\n                return;\n            }\n");
    buf_str(out, c"            if s == K_WHILE {\n                self.p += 1;\n                self.while_stmt();\n                return;\n            }\n            if s == K_SWITCH {\n                self.p += 1;\n                self.switch_stmt(at);\n                return;\n            }\n            if s == K_BREAK {\n                self.p += 1;\n                if self.is_kw(K_IF) {\n                    self.fail(at, b\"wgsl.syntax\",\n                        b\"'break if' is the last statement of a 'continuing' block\");\n                    return;\n                }\n                if self.loop_depth == 0 && self.switch_depth == 0 {\n                    self.fail(at, b\"wgsl.syntax\", b\"'break' outside a loop or switch\");\n                } else if self.in_continuing && self.switch_depth == 0 {\n                    self.fail(at, b\"wgsl.syntax\",\n                        b\"'break' in 'continuing'; end it with 'break if COND;'\");\n                }\n                self.push_stmt(S_BREAK, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_CONTINUE {\n                self.p += 1;\n                if self.loop_depth == 0 {\n                    self.fail(at, b\"wgsl.syntax\", b\"'continue' outside a loop\");\n                } else if self.in_continuing {\n                    self.fail(at, b\"wgsl.syntax\", b\"'continue' in a 'continuing' block\");\n                }\n                self.push_stmt(S_CONTINUE, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n            if s == K_DISCARD {\n                self.p += 1;\n                if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n                    self.fail(at, b\"wgsl.stage\", b\"'discard' is only for fragment shaders\");\n                }\n                self.push_stmt(S_KILL, 0, 0, 0, 0);\n                self.expect(T_SEMI);\n                return;\n            }\n");
    buf_str(out, c"            if s == K_CONST_ASSERT {\n                self.fail(at, b\"wgsl.unsupported\",\n                    b\"'const_assert' is not in the WGSL subset of this release\");\n                return;\n            }\n            if s == K_CONTINUING {\n                self.fail(at, b\"wgsl.syntax\", b\"'continuing' belongs at the end of a 'loop'\");\n                return;\n            }\n            if s == K_ELSE {\n                self.fail(at, b\"wgsl.syntax\", b\"'else' without 'if'\");\n                return;\n            }\n            if s == K_CASE || s == K_DEFAULT {\n                self.fail(at, b\"wgsl.syntax\", b\"'case' outside a 'switch'\");\n                return;\n            }\n        }\n        self.simple_stmt();\n        self.expect(T_SEMI);\n    }\n\n    // An assignment, increment, call or phony assignment (no `;`).\n    fn simple_stmt(&mut self) {\n        let at = self.pos();\n        if self.kind() == T_UNDERSCORE {\n            self.p += 1;\n            self.expect(T_EQ);\n            let v = self.parse_expr();\n            if v.k == VK_VOID {\n                self.fail(at, b\"wgsl.type\", b\"a function without a result has no value to assign\");\n            }\n            let _ = self.value(v, at);\n            return;\n        }\n        let start_exprs = self.f.exprs.len() as i64;\n        let start_stmts = self.pending.len() as i64;\n        let lhs = self.parse_unary_for_stmt();\n        let k = self.kind();\n        if k == T_EQ {\n            self.p += 1;\n            let rp = self.pos();\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr as usize].ty);\n            let rhs = self.parse_expr_hint(pointee);\n            let e = self.materialize(rhs, pointee, rp);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        if k >= lex::T_PLUSEQ && k <= lex::T_SHREQ {\n            self.p += 1;\n            let op = compound_op(k);\n");
    buf_str(out, c"            let rp = self.pos();\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr as usize].ty);\n            let cur = self.value(Val {\n                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr as usize].ty, iv: 0, fv: 0.0,\n            }, at);\n            let rhs = self.parse_expr();\n            let r = self.binary(op, cur, rhs, rp);\n            let e = self.materialize(r, pointee, rp);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        if k == T_PLUSPLUS || k == T_MINUSMINUS {\n            self.p += 1;\n            let ptr = self.lhs_ptr(lhs, at);\n            let pointee = self.m.pointee(self.f.exprs[ptr as usize].ty);\n            if pointee != T_I32 && pointee != T_U32 {\n                self.fail(at, b\"wgsl.type\", b\"'++' and '--' apply to i32 and u32 variables\");\n                return;\n            }\n            let cur = self.value(Val {\n                k: VK_REF, sk: 0, e: ptr, ty: self.f.exprs[ptr as usize].ty, iv: 0, fv: 0.0,\n            }, at);\n            let one = cint(ir::SK_AINT, -1, 1);\n            let r = self.binary(if k == T_PLUSPLUS { ir::OP_ADD } else { ir::OP_SUB }, cur, one,\n                at);\n            let e = self.materialize(r, pointee, at);\n            self.push_stmt(S_STORE, ptr, e, 0, 0);\n            return;\n        }\n        // a call statement: its result, if any, is dropped\n        let _ = start_exprs;\n        let _ = start_stmts;\n        if !self.last_was_call {\n            if self.err(at, b\"wgsl.syntax\") {\n                self.emsg.extend_from_slice(\n                    b\"expected a statement: an assignment, a call, 'let', 'var', 'if', 'for', ...\");\n            }\n        }\n    }\n\n    // The pointer an assignment writes through.\n    fn lhs_ptr(&mut self, lhs: Val, at: i64) -> i64 {\n        if lhs.k != VK_REF {\n            if self.err(at, b\"wgsl.assign\") {\n");
    buf_str(out, c"                self.emsg.extend_from_slice(\n                    b\"cannot assign to this: it is a value, not a variable\");\n                self.help(\n                    b\"assign to a 'var' (a 'let' is immutable), a member or element of one, or '*p'\");\n            }\n            return self.dummy_ptr();\n        }\n        let pt = self.m.types[lhs.ty as usize];\n        if pt.access & ACC_WRITE == 0 {\n            if self.err(at, b\"wgsl.access\") {\n                write(self.emsg, \"cannot write to a read-only {} variable\",\n                    str::from_utf8(ir::space_name(pt.space)).unwrap()).unwrap();\n                if pt.space == SP_STORAGE {\n                    self.help(b\"declare it 'var<storage, read_write>'\");\n                }\n            }\n        }\n        if self.m.has_atomic(pt.base) {\n            self.fail(at, b\"wgsl.type\", b\"an atomic is written with atomicStore\");\n        }\n        lhs.e\n    }\n\n    #[effects(A)]\n    pub(crate) fn dummy_ptr(&mut self) -> i64 {\n        let ty = self.m.ptr_ty(T_I32, SP_FUNCTION, ACC_RW);\n        self.f.expr(ir::E_ZERO, ty, 0, 0, 0)\n    }\n\n    fn let_decl(&mut self, is_const: bool) {\n        let npos = self.pos();\n        let s = self.ident();\n        let mut ty: i64 = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        self.expect(T_EQ);\n        let ip = self.pos();\n        if is_const {\n            let mut v = self.parse_expr_hint(ty);\n            if ty >= 0 {\n                v = self.convert_to(v, ty, ip);\n            }\n            if v.k == VK_REF || (v.k == VK_VALUE && !self.is_const_expr(v.e)) {\n                self.fail(ip, b\"wgsl.type\", b\"a 'const' is a constant expression\");\n            }\n            self.scopes.push(ScopeEntry { sym: s, v: v, mutable: false });\n            return;\n        }\n        let v = self.parse_expr_hint(ty);\n        if v.k == VK_VOID {\n");
    buf_str(out, c"            self.fail(ip, b\"wgsl.type\", b\"this call has no result to bind\");\n            return;\n        }\n        let t = if ty >= 0 { ty } else { self.concrete_type_of(v) };\n        if self.m.has_atomic(t) || self.m.is_runtime_sized(t) {\n            self.fail(ip, b\"wgsl.type\", b\"a 'let' cannot hold an atomic or a runtime-sized array\");\n        }\n        let e = self.materialize(v, t, ip);\n        let _ = npos;\n        let eop = self.f.exprs[e as usize].op;\n        if self.f.names[e as usize].len() as i64 == 0 && eop != E_ARG && eop != E_LOCAL\n            && eop != E_GLOBAL {\n            self.f.names[e as usize] = self.name_of(s);\n        }\n        self.scopes.push(ScopeEntry { sym: s, v: val(e, t), mutable: false });\n    }\n\n    fn var_decl(&mut self) {\n        if self.kind() == T_LT {\n            let ap = self.pos();\n            self.p += 1;\n            let sp = self.address_space();\n            self.expect_gt();\n            if sp != SP_FUNCTION {\n                self.fail(ap, b\"wgsl.type\",\n                    b\"a variable in a function is 'var' or 'var<function>'\");\n            }\n        }\n        let npos = self.pos();\n        let s = self.ident();\n        let mut ty: i64 = -1;\n        if self.eat(T_COLON) {\n            ty = self.parse_type();\n        }\n        let mut init: i64 = -1;\n        if self.eat(T_EQ) {\n            let ip = self.pos();\n            let v = self.parse_expr_hint(ty);\n            if v.k == VK_VOID {\n                self.fail(ip, b\"wgsl.type\", b\"this call has no result\");\n                return;\n            }\n            if ty < 0 {\n                ty = self.concrete_type_of(v);\n            }\n            init = self.materialize(v, ty, ip);\n        }\n        if ty < 0 {\n            self.fail(npos, b\"wgsl.type\", b\"a 'var' needs a type or an initializer\");\n            return;\n        }\n        if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n");
    buf_str(out, c"            if self.err(npos, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"a function variable cannot have type \");\n                self.ty_str(ty);\n            }\n            return;\n        }\n        let l = self.f.locals.len() as i64;\n        self.f.locals.push(Local { name: self.name_of(s), ty: ty });\n        let pty = self.m.ptr_ty(ty, SP_FUNCTION, ACC_RW);\n        let e = self.f.expr(E_LOCAL, pty, l, 0, 0);\n        if init >= 0 {\n            self.push_stmt(S_STORE, e, init, 0, 0);\n        } else {\n            // a variable is zero each time its declaration runs\n            let z = self.f.expr(ir::E_ZERO, ty, 0, 0, 0);\n            self.push_stmt(S_STORE, e, z, 0, 0);\n        }\n        self.scopes.push(ScopeEntry {\n            sym: s, v: Val { k: VK_REF, sk: 0, e: e, ty: pty, iv: 0, fv: 0.0 }, mutable: true,\n        });\n    }\n\n    fn condition(&mut self) -> i64 {\n        let at = self.pos();\n        let v = self.parse_expr();\n        if self.concrete_type_of(v) != T_BOOL {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"a condition is a bool, not \");\n                self.val_str(v);\n            }\n            return self.f.expr(ir::E_LITERAL, T_BOOL, 0, 0, 0);\n        }\n        self.materialize(v, T_BOOL, at)\n    }\n\n    fn if_stmt(&mut self) {\n        let c = self.condition();\n        self.flush();\n        let then_b = self.compound();\n        let mut else_b: i64 = -1;\n        if self.eat_kw(K_ELSE) {\n            if self.eat_kw(K_IF) {\n                let base = self.pending.len() as i64;\n                self.if_stmt();\n                self.flush();\n                else_b = self.f.block_of(&mut self.pending, base);\n            } else {\n                else_b = self.compound();\n            }\n        } else {\n            else_b = self.f.empty_block();\n        }\n        self.push_stmt(S_IF, c, then_b, else_b, 0);\n    }\n\n");
    buf_str(out, c"    fn return_stmt(&mut self, at: i64) {\n        let rt = self.f.result;\n        if self.kind() == T_SEMI {\n            if rt >= 0 {\n                if self.err(at, b\"wgsl.return\") {\n                    self.emsg.extend_from_slice(b\"this function returns \");\n                    self.ty_str(rt);\n                    self.emsg.extend_from_slice(b\": 'return' needs a value\");\n                }\n            }\n            self.push_stmt(S_RETURN, -1, 0, 0, 0);\n            return;\n        }\n        let vp = self.pos();\n        let v = self.parse_expr_hint(rt);\n        if rt < 0 {\n            self.fail(vp, b\"wgsl.return\", b\"this function has no result: 'return;'\");\n            return;\n        }\n        let e = self.materialize(v, rt, vp);\n        self.push_stmt(S_RETURN, e, 0, 0, 0);\n    }\n\n    // The body of a loop (from its `{`), then `continuing` and `break if`.\n    fn loop_stmt(&mut self) {\n        self.flush();\n        let base = self.pending.len() as i64;\n        let scope = self.scopes.len() as i64;\n        self.expect(T_LBRACE);\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        self.statements();\n        self.flush();\n        let body = self.f.block_of(&mut self.pending, base);\n        let mut cont: i64 = -1;\n        let mut break_if: i64 = -1;\n        if self.eat_kw(K_CONTINUING) {\n            // the continuing block sees the body's names\n            let cbase = self.pending.len() as i64;\n            let saved_cont = self.in_continuing;\n            self.in_continuing = true;\n            self.expect(T_LBRACE);\n            while self.kind() != T_RBRACE && self.kind() != T_EOF {\n                if self.is_kw(K_BREAK) && self.kind_at(self.p + 1) == T_IDENT\n                    && self.tk.syms[(self.p + 1) as usize] == K_IF {\n                    self.p += 2;\n                    break_if = self.condition();\n                    self.expect(T_SEMI);\n");
    buf_str(out, c"                    if self.kind() != T_RBRACE {\n                        self.fail(self.pos(), b\"wgsl.syntax\",\n                            b\"'break if' is the last statement of 'continuing'\");\n                    }\n                    break;\n                }\n                self.statement();\n            }\n            self.expect(T_RBRACE);\n            self.flush();\n            self.in_continuing = saved_cont;\n            cont = self.f.block_of(&mut self.pending, cbase);\n        } else {\n            cont = self.f.empty_block();\n        }\n        self.expect(T_RBRACE);\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        self.scopes.truncate(scope as usize);\n        self.push_stmt(S_LOOP, body, cont, break_if, 0);\n    }\n\n    // `if !cond { break; }` at the head of a loop body.\n    fn break_unless(&mut self, c: i64) {\n        self.flush();\n        let then_b = self.f.empty_block();\n        let base = self.pending.len() as i64;\n        let s = self.f.stmt(S_BREAK, 0, 0, 0, 0);\n        self.pending.push(s);\n        let else_b = self.f.block_of(&mut self.pending, base);\n        self.push_stmt(S_IF, c, then_b, else_b, 0);\n    }\n\n    fn for_stmt(&mut self) {\n        self.expect(T_LPAREN);\n        self.flush();\n        let outer = self.pending.len() as i64;\n        let scope = self.scopes.len() as i64;\n        // init\n        if self.kind() != T_SEMI {\n            if self.is_kw(K_VAR) {\n                self.p += 1;\n                self.var_decl();\n            } else if self.is_kw(K_LET) || self.is_kw(K_CONST) {\n                let c = self.is_kw(K_CONST);\n                self.p += 1;\n                self.let_decl(c);\n            } else {\n                self.simple_stmt();\n            }\n        }\n        self.expect(T_SEMI);\n        self.flush();\n        // the loop: its body starts with the condition\n        let base = self.pending.len() as i64;\n        self.loop_depth += 1;\n");
    buf_str(out, c"        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        if self.kind() != T_SEMI {\n            let c = self.condition();\n            self.break_unless(c);\n        }\n        self.expect(T_SEMI);\n        // the update is parsed after the body, so remember where it is\n        let upd = self.p;\n        let mut depth: i64 = 0;\n        while self.kind() != T_EOF {\n            let k = self.kind();\n            if k == T_LPAREN {\n                depth += 1;\n            } else if k == T_RPAREN {\n                if depth == 0 {\n                    break;\n                }\n                depth -= 1;\n            }\n            self.p += 1;\n        }\n        self.expect(T_RPAREN);\n        let b = self.compound();\n        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n        self.flush();\n        let body = self.f.block_of(&mut self.pending, base);\n        let after = self.p;\n        self.p = upd;\n        let cbase = self.pending.len() as i64;\n        let saved_cont = self.in_continuing;\n        self.in_continuing = true;\n        if self.kind() != T_RPAREN {\n            self.simple_stmt();\n        }\n        self.in_continuing = saved_cont;\n        self.flush();\n        let cont = self.f.block_of(&mut self.pending, cbase);\n        self.p = after;\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        self.push_stmt(S_LOOP, body, cont, -1, 0);\n        self.flush();\n        self.scopes.truncate(scope as usize);\n        let blk = self.f.block_of(&mut self.pending, outer);\n        self.push_stmt(S_BLOCK, blk, 0, 0, 0);\n    }\n\n    fn while_stmt(&mut self) {\n        self.flush();\n        let base = self.pending.len() as i64;\n        self.loop_depth += 1;\n        let saved_switch = self.switch_depth;\n        self.switch_depth = 0;\n        let c = self.condition();\n        self.break_unless(c);\n        let b = self.compound();\n        self.push_stmt(S_BLOCK, b, 0, 0, 0);\n");
    buf_str(out, c"        self.flush();\n        let body = self.f.block_of(&mut self.pending, base);\n        self.loop_depth -= 1;\n        self.switch_depth = saved_switch;\n        let cont = self.f.empty_block();\n        self.push_stmt(S_LOOP, body, cont, -1, 0);\n    }\n\n    fn switch_stmt(&mut self, at: i64) {\n        let sp = self.pos();\n        let sel = self.parse_expr();\n        let st = self.concrete_type_of(sel);\n        if st != T_I32 && st != T_U32 {\n            if self.err(sp, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"a switch selector is an i32 or a u32, not \");\n                self.val_str(sel);\n            }\n            return;\n        }\n        let se = self.materialize(sel, st, sp);\n        self.flush();\n        self.expect(T_LBRACE);\n        let mut clauses: Vec<ir::Case, A> = Vec::new_in(self.a);\n        let mut seen: Vec<i64, A> = Vec::new_in(self.a);\n        let mut defaults: i64 = 0;\n        self.switch_depth += 1;\n        while self.kind() != T_RBRACE && self.kind() != T_EOF {\n            let cp = self.pos();\n            let mut is_default = false;\n            let vstart = self.f.vals.len() as i64;\n            if self.eat_kw(K_DEFAULT) {\n                is_default = true;\n            } else if self.eat_kw(K_CASE) {\n                while self.kind() != T_LBRACE && self.kind() != T_COLON && self.kind() != T_EOF {\n                    if self.eat_kw(K_DEFAULT) {\n                        is_default = true;\n                    } else {\n                        let vp = self.pos();\n                        let v = self.parse_expr();\n                        let c = self.convert_to(v, st, vp);\n                        if c.k != VK_CONST {\n                            self.fail(vp, b\"wgsl.type\", b\"a case selector is a constant\");\n                        }\n                        for i in 0..seen.len() as i64 {\n                            if seen[i as usize] == c.iv {\n");
    buf_str(out, c"                                if self.err(vp, b\"wgsl.switch\") {\n                                    write(self.emsg, \"case {} appears twice\", c.iv).unwrap();\n                                }\n                            }\n                        }\n                        seen.push(c.iv);\n                        self.f.vals.push(c.iv);\n                    }\n                    if !self.eat(T_COMMA) {\n                        break;\n                    }\n                }\n            } else {\n                if self.err(cp, b\"wgsl.syntax\") {\n                    self.emsg.extend_from_slice(b\"expected 'case' or 'default' in a switch\");\n                }\n                return;\n            }\n            if is_default {\n                defaults += 1;\n                if defaults > 1 {\n                    self.fail(cp, b\"wgsl.switch\", b\"a switch has one 'default'\");\n                }\n            }\n            self.eat(T_COLON);\n            let body = self.compound();\n            clauses.push(ir::Case {\n                vstart: vstart, vcount: self.f.vals.len() as i64 - vstart, is_default: is_default,\n                body: body,\n            });\n        }\n        self.switch_depth -= 1;\n        self.expect(T_RBRACE);\n        if defaults == 0 {\n            self.fail(at, b\"wgsl.switch\", b\"a switch needs a 'default' clause\");\n            self.help(b\"add 'default: {}'\");\n        }\n        let cstart = self.f.cases.len() as i64;\n        for i in 0..clauses.len() as i64 {\n            self.f.cases.push(clauses[i as usize]);\n        }\n        self.push_stmt(S_SWITCH, se, cstart, clauses.len() as i64, 0);\n    }\n\n    // A call as a statement: S_CALL is pushed by the call's lowering.\n    #[effects(panic, A)]\n    pub(crate) fn call_stmt(&mut self, fh: i64, args_start: i64, n: i64) -> Val {\n        let rt = if fh == self.fh { self.f.result } else { self.m.functions[fh as usize].result };\n        if rt < 0 {\n");
    buf_str(out, c"            self.push_stmt(S_CALL, fh, args_start, n, -1);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let r = self.unemitted(E_CALL_RESULT, rt);\n        self.push_stmt(S_CALL, fh, args_start, n, r);\n        val(r, rt)\n    }\n}\n\nfn compound_op(k: u8) -> i64 {\n    if k == lex::T_PLUSEQ {\n        ir::OP_ADD\n    } else if k == lex::T_MINUSEQ {\n        ir::OP_SUB\n    } else if k == lex::T_STAREQ {\n        ir::OP_MUL\n    } else if k == lex::T_SLASHEQ {\n        ir::OP_DIV\n    } else if k == lex::T_PERCENTEQ {\n        ir::OP_MOD\n    } else if k == lex::T_AMPEQ {\n        ir::OP_AND\n    } else if k == lex::T_PIPEEQ {\n        ir::OP_OR\n    } else if k == lex::T_CARETEQ {\n        ir::OP_XOR\n    } else if k == lex::T_SHLEQ {\n        ir::OP_SHL\n    } else {\n        ir::OP_SHR\n    }\n}\n// ---- end mod std::gpu::wgsl::front ----\n}\n// ---- mod std::gpu::wgsl::expr ----\nmod expr {\n// EDITION: rust\n// ---- Shader compiler implementation, expr (0.22) ----\n// Expressions: WGSL's grammar, the Load Rule, abstract numbers and their\n// conversions, constant folding, operators and their types, indexing and\n// member access. Calls and constructors are in builtins.vl.\n\nuse crate::alloc::Allocator;\n\nuse super::{front, ir, lex};\nuse super::front::{Front, VK_CONST, VK_REF, VK_TYPE, VK_VALUE, VK_VOID, Val, cfloat, cint, val};\nuse super::ir::{\n    E_ACCESS, E_ACCESS_INDEX, E_BINARY, E_LITERAL, E_LOAD, E_SPLAT, E_SWIZZLE, E_UNARY, E_ZERO,\n    OP_ADD, OP_AND, OP_DIV, OP_EQ, OP_GE, OP_GT, OP_LAND, OP_LE, OP_LOR, OP_LT, OP_MOD, OP_MUL,\n    OP_NE, OP_OR, OP_SHL, OP_SHR, OP_SUB, OP_XOR, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32, SK_I32,\n    SK_U32, SP_FUNCTION, S_IF, S_STORE, TK_ARRAY, TK_MATRIX, TK_POINTER, TK_SCALAR, TK_STRUCT,\n    TK_VECTOR, T_BOOL, T_F32, T_I32, T_U32, UN_BITNOT, UN_NEG, UN_NOT, f32_bits, mat_ty, vec_ty,\n};\nuse super::lex::{\n");
    buf_str(out, c"    T_AMP, T_ANDAND, T_BANG, T_CARET, T_DOT, T_EQEQ, T_FLOAT, T_GE, T_GT, T_IDENT, T_INT,\n    T_LBRACKET, T_LE, T_LPAREN, T_LT, T_MINUS, T_NE, T_OROR, T_PERCENT, T_PIPE, T_PLUS, T_RBRACKET,\n    T_RPAREN, T_SHL, T_SHR, T_SLASH, T_STAR, T_TILDE,\n};\nuse super::names::{K_FALSE, K_TRUE};\n\nconst I32_MIN: i64 = -2147483648;\nconst I32_MAX: i64 = 2147483647;\nconst U32_MAX: i64 = 4294967295;\nconst F32_MAX: f64 = 340282346638528859811704183484516925440.0;\n\nimpl<'a, A: Allocator + Copy> Front<'a, A> {\n    #[effects(A)]\n    pub(crate) fn parse_expr(&mut self) -> Val { self.parse_expr_hint(-1) }\n\n    // An expression; `hint` (a type or -1) is the type the context\n    // expects, which an inferred constructor of abstract numbers takes.\n    #[effects(diverge, A)]\n    pub(crate) fn parse_expr_hint(&mut self, hint: i64) -> Val {\n        let saved = self.hint;\n        self.hint = hint;\n        let at = self.pos();\n        let l = self.parse_relational();\n        let k = self.kind();\n        if k != T_ANDAND && k != T_OROR {\n            self.hint = saved;\n            return l;\n        }\n        let mut acc = l;\n        while self.kind() == k {\n            let op_at = self.pos();\n            self.p += 1;\n            acc = self.short_circuit(k == T_ANDAND, acc, op_at);\n        }\n        let k2 = self.kind();\n        if k2 == T_ANDAND || k2 == T_OROR {\n            self.fail(self.pos(), b\"wgsl.syntax\", b\"mixing '&&' and '||' needs parentheses\");\n        }\n        let _ = at;\n        self.hint = saved;\n        acc\n    }\n\n    // `l && r` or `l || r`: r is evaluated only when needed. Without\n    // effects in r this is a plain operator; else it is an `if` writing a\n    // temporary variable.\n    fn short_circuit(&mut self, and: bool, l: Val, at: i64) -> Val {\n        let lc = self.concrete_type_of(l);\n        if lc != T_BOOL {\n            self.bad_operands(if and { b\"&&\" } else { b\"||\" }, l, l, at);\n");
    buf_str(out, c"            return cint(SK_BOOL, T_BOOL, 0);\n        }\n        if l.k == VK_CONST {\n            // a constant left side decides\n            let r = self.parse_relational();\n            if self.concrete_type_of(r) != T_BOOL {\n                self.bad_operands(if and { b\"&&\" } else { b\"||\" }, l, r, at);\n                return l;\n            }\n            if and && l.iv == 0 {\n                return l;\n            }\n            if !and && l.iv != 0 {\n                return l;\n            }\n            return self.value(r, at);\n        }\n        let le = self.materialize(l, T_BOOL, at);\n        self.flush();\n        let before = self.pending.len() as i64;\n        let rp = self.pos();\n        let r = self.parse_relational();\n        if self.concrete_type_of(r) != T_BOOL {\n            self.bad_operands(if and { b\"&&\" } else { b\"||\" }, l, r, at);\n            return l;\n        }\n        let re = self.materialize(r, T_BOOL, rp);\n        if self.pending.len() as i64 == before {\n            let e = self.f.expr(E_BINARY, T_BOOL, if and { OP_LAND } else { OP_LOR }, le, re);\n            return val(e, T_BOOL);\n        }\n        // r made statements (calls): t = l; if (l == and) { r's statements; t = r }\n        self.flush();\n        let lt = self.f.locals.len() as i64;\n        self.f.locals.push(ir::Local { name: b\"\", ty: T_BOOL });\n        let pty = self.m.ptr_ty(T_BOOL, SP_FUNCTION, ir::ACC_RW);\n        let tv = self.f.expr(ir::E_LOCAL, pty, lt, 0, 0);\n        let st = self.f.stmt(S_STORE, tv, re, 0, 0);\n        self.pending.push(st);\n        let inner = self.f.block_of(&mut self.pending, before);\n        let empty = self.f.empty_block();\n        let st0 = self.f.stmt(S_STORE, tv, le, 0, 0);\n        self.pending.push(st0);\n        if and {\n            self.push_stmt(S_IF, le, inner, empty, 0);\n        } else {\n            self.push_stmt(S_IF, le, empty, inner, 0);\n        }\n");
    buf_str(out, c"        let e = self.f.expr(E_LOAD, T_BOOL, tv, 0, 0);\n        val(e, T_BOOL)\n    }\n\n    fn parse_relational(&mut self) -> Val {\n        let l = self.parse_shift();\n        let k = self.kind();\n        let mut op: i64 = -1;\n        if k == T_LT {\n            op = OP_LT;\n        } else if k == T_LE {\n            op = OP_LE;\n        } else if k == T_GT {\n            op = OP_GT;\n        } else if k == T_GE {\n            op = OP_GE;\n        } else if k == T_EQEQ {\n            op = OP_EQ;\n        } else if k == T_NE {\n            op = OP_NE;\n        }\n        if op < 0 {\n            return l;\n        }\n        let at = self.pos();\n        self.p += 1;\n        let r = self.parse_shift();\n        let v = self.binary(op, l, r, at);\n        let k2 = self.kind();\n        if k2 == T_LT || k2 == T_LE || k2 == T_GT || k2 == T_GE || k2 == T_EQEQ || k2 == T_NE {\n            self.fail(self.pos(), b\"wgsl.syntax\", b\"comparisons do not chain: 'a < b && b < c'\");\n        }\n        v\n    }\n\n    // A shift, a bitwise expression, or an additive one.\n    #[effects(diverge, A)]\n    pub(crate) fn parse_shift(&mut self) -> Val {\n        let u = self.parse_unary();\n        let k = self.kind();\n        if k == T_SHL || k == T_SHR {\n            let at = self.pos();\n            self.p += 1;\n            let r = self.parse_unary();\n            return self.binary(if k == T_SHL { OP_SHL } else { OP_SHR }, u, r, at);\n        }\n        if k == T_AMP || k == T_PIPE || k == T_CARET {\n            let op = if k == T_AMP { OP_AND } else if k == T_PIPE { OP_OR } else { OP_XOR };\n            let mut acc = u;\n            while self.kind() == k {\n                let at = self.pos();\n                self.p += 1;\n                let r = self.parse_unary();\n                acc = self.binary(op, acc, r, at);\n            }\n            let k2 = self.kind();\n            if k2 == T_AMP || k2 == T_PIPE || k2 == T_CARET || k2 == T_PLUS || k2 == T_MINUS\n");
    buf_str(out, c"                || k2 == T_STAR || k2 == T_SLASH || k2 == T_PERCENT {\n                self.fail(self.pos(), b\"wgsl.syntax\",\n                    b\"mixing bitwise operators with other operators needs parentheses\");\n            }\n            return acc;\n        }\n        let mut l = self.parse_mult_from(u);\n        while self.kind() == T_PLUS || self.kind() == T_MINUS {\n            let op = if self.kind() == T_PLUS { OP_ADD } else { OP_SUB };\n            let at = self.pos();\n            self.p += 1;\n            let r0 = self.parse_unary();\n            let r = self.parse_mult_from(r0);\n            l = self.binary(op, l, r, at);\n        }\n        let k3 = self.kind();\n        if k3 == T_AMP || k3 == T_PIPE || k3 == T_CARET || k3 == T_SHL || k3 == T_SHR {\n            self.fail(self.pos(), b\"wgsl.syntax\",\n                b\"mixing bitwise or shift operators with arithmetic needs parentheses\");\n        }\n        l\n    }\n\n    fn parse_mult_from(&mut self, u: Val) -> Val {\n        let mut l = u;\n        loop {\n            let k = self.kind();\n            let op = if k == T_STAR {\n                OP_MUL\n            } else if k == T_SLASH {\n                OP_DIV\n            } else if k == T_PERCENT {\n                OP_MOD\n            } else {\n                return l;\n            };\n            let at = self.pos();\n            self.p += 1;\n            let r = self.parse_unary();\n            l = self.binary(op, l, r, at);\n        }\n    }\n\n    // A statement's left side or call: a unary expression; remembers\n    // whether it ended in a user call.\n    #[effects(A)]\n    pub(crate) fn parse_unary_for_stmt(&mut self) -> Val {\n        self.last_call_end = -1;\n        let v = self.parse_unary();\n        if self.last_call_end != self.p {\n            self.last_was_call = false;\n        } else {\n            self.last_was_call = true;\n        }\n        v\n    }\n\n    #[effects(panic, A)]\n");
    buf_str(out, c"    pub(crate) fn parse_unary(&mut self) -> Val {\n        let at = self.pos();\n        let k = self.kind();\n        if k == T_MINUS {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_NEG, v, at);\n        }\n        if k == T_BANG {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_NOT, v, at);\n        }\n        if k == T_TILDE {\n            self.p += 1;\n            let v = self.parse_unary();\n            return self.unary(UN_BITNOT, v, at);\n        }\n        if k == T_STAR {\n            self.p += 1;\n            let v = self.parse_unary();\n            let pv = self.value(v, at);\n            if pv.k != VK_VALUE || self.m.types[pv.ty as usize].kind != TK_POINTER {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'*' dereferences a pointer, not \");\n                    self.val_str(v);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            return Val { k: VK_REF, sk: 0, e: pv.e, ty: pv.ty, iv: 0, fv: 0.0 };\n        }\n        if k == T_AMP {\n            self.p += 1;\n            let v = self.parse_unary();\n            if v.k != VK_REF {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'&' takes the address of a variable (or a member or element of one), not of \");\n                    self.val_str(v);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            if self.m.types[self.f.exprs[v.e as usize].ty as usize].kind == TK_POINTER\n                && self.f.exprs[v.e as usize].op == ir::E_ACCESS_INDEX\n                && self.is_vector_component(v.e) {\n                self.fail(at, b\"wgsl.type\", b\"cannot take the address of a vector component\");\n            }\n            return val(v.e, v.ty);\n        }\n        let p = self.parse_primary();\n");
    buf_str(out, c"        self.parse_postfix(p)\n    }\n\n    fn is_vector_component(&self, e: i64) -> bool {\n        let base = self.f.exprs[e as usize].a;\n        let bt = self.m.pointee(self.f.exprs[base as usize].ty);\n        bt >= 0 && self.m.types[bt as usize].kind == TK_VECTOR\n    }\n\n    fn parse_postfix(&mut self, v0: Val) -> Val {\n        let mut v = v0;\n        loop {\n            let k = self.kind();\n            if k == T_LBRACKET {\n                let at = self.pos();\n                self.p += 1;\n                let ip = self.pos();\n                let i = self.parse_expr();\n                self.expect(T_RBRACKET);\n                v = self.index(v, i, at, ip);\n            } else if k == T_DOT {\n                self.p += 1;\n                let at = self.pos();\n                if self.kind() != T_IDENT {\n                    self.expect(T_IDENT);\n                    return v;\n                }\n                let name = self.text(self.p);\n                self.p += 1;\n                v = self.member(v, name, at);\n            } else {\n                return v;\n            }\n        }\n    }\n\n    // ---- Primaries ----\n\n    fn parse_primary(&mut self) -> Val {\n        let at = self.pos();\n        let k = self.kind();\n        let hint = self.hint;\n        self.hint = -1;\n        if k == T_INT {\n            return self.int_literal(self.p);\n        }\n        if k == T_FLOAT {\n            return self.float_literal(self.p);\n        }\n        if k == T_LPAREN {\n            self.p += 1;\n            let v = self.parse_expr_hint(hint);\n            self.expect(T_RPAREN);\n            return v;\n        }\n        if k != T_IDENT {\n            if self.err(at, b\"wgsl.syntax\") {\n                self.emsg.extend_from_slice(b\"expected an expression, got \");\n                self.emsg.extend_from_slice(lex::token_text(k));\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let s = self.tk.syms[self.p as usize];\n");
    buf_str(out, c"        if s == K_TRUE || s == K_FALSE {\n            self.p += 1;\n            return cint(SK_BOOL, T_BOOL, if s == K_TRUE { 1 } else { 0 });\n        }\n        // local names\n        let li = self.lookup_name(s);\n        if li >= 0 {\n            self.p += 1;\n            let ent = self.scopes[li as usize];\n            if self.kind() == T_LPAREN {\n                if self.err(at, b\"wgsl.call\") {\n                    write(self.emsg, \"'{}' is a value, not a function\",\n                        str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                }\n            }\n            return ent.v;\n        }\n        // module-scope names\n        if self.decl_of[s as usize] >= 0 {\n            let d = self.decl_of[s as usize];\n            let kind = self.decls[d as usize].kind;\n            if kind == front::D_CONST {\n                self.p += 1;\n                if self.decls[d as usize].has_cv {\n                    return self.decls[d as usize].cv;\n                }\n                let saved = self.p;\n                let v = self.const_value(d);\n                self.p = saved;\n                return v;\n            }\n            if kind == front::D_VAR {\n                self.p += 1;\n                let g = self.decls[d as usize].h;\n                if g < 0 {\n                    // a global used by another module-scope declaration\n                    if self.err(at, b\"wgsl.name\") {\n                        write(self.emsg,\n                            \"'{}' is a variable; a module-scope declaration cannot use it\",\n                            str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                if self.fh < 0 {\n                    if self.err(at, b\"wgsl.type\") {\n                        write(self.emsg, \"'{}' is a variable; a constant expression cannot read it\",\n");
    buf_str(out, c"                            str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                let e = self.global_expr(g);\n                let ty = self.f.exprs[e as usize].ty;\n                if self.m.globals[g as usize].space == ir::SP_HANDLE {\n                    return val(e, ty);\n                }\n                return Val { k: VK_REF, sk: 0, e: e, ty: ty, iv: 0, fv: 0.0 };\n            }\n            if kind == front::D_FN {\n                self.p += 1;\n                if self.kind() != T_LPAREN {\n                    if self.err(at, b\"wgsl.type\") {\n                        write(self.emsg, \"'{}' is a function: call it, '{}(...)'\",\n                            str::from_utf8(self.name_of(s)).unwrap(),\n                            str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                    }\n                    return cint(SK_AINT, -1, 0);\n                }\n                return self.user_call(self.decls[d as usize].h, at);\n            }\n            // a struct or alias: a constructor\n            let ty = self.parse_type();\n            return self.construct(ty, at);\n        }\n        self.builtin_primary(s, at, hint)\n    }\n\n    #[effects(panic, diverge, A)]\n    pub(crate) fn lookup_name(&self, s: i64) -> i64 {\n        let mut i = self.scopes.len() as i64 - 1;\n        while i >= self.scope_floor {\n            if self.scopes[i as usize].sym == s {\n                return i;\n            }\n            i -= 1;\n        }\n        -1\n    }\n\n    // ---- Literals ----\n\n    fn int_literal(&mut self, t: i64) -> Val {\n        let s = self.text(t);\n        let at = self.pos();\n        self.p += 1;\n        let mut end = s.len() as i64;\n        let last = s[(end - 1) as usize];\n        let mut sk = SK_AINT;\n        if last == b'i' {\n            sk = SK_I32;\n            end -= 1;\n        } else if last == b'u' {\n");
    buf_str(out, c"            sk = SK_U32;\n            end -= 1;\n        }\n        let mut v: i64 = 0;\n        let mut overflow = false;\n        if end > 2 && s[0] == b'0' && (s[1] == b'x' || s[1] == b'X') {\n            for i in 2..end {\n                let c = s[i as usize];\n                let d = if c >= b'0' && c <= b'9' { c - b'0' }\n                    else if c >= b'a' && c <= b'f' { c - b'a' + 10 } else { c - b'A' + 10 };\n                if v > 576460752303423487 {\n                    overflow = true;\n                }\n                v = v * 16 + d as i64;\n            }\n        } else {\n            if end > 1 && s[0] == b'0' {\n                self.fail(at, b\"wgsl.syntax\", b\"a decimal integer does not start with 0\");\n                return cint(SK_AINT, -1, 0);\n            }\n            for i in 0..end {\n                let d = (s[i as usize] - b'0') as i64;\n                if v > 922337203685477580 || (v == 922337203685477580 && d > 7) {\n                    overflow = true;\n                }\n                v = v * 10 + d;\n            }\n        }\n        if overflow {\n            self.fail(at, b\"wgsl.const\", b\"this integer does not fit in 64 bits\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if sk == SK_I32 && v > I32_MAX {\n            self.fail(at, b\"wgsl.const\", b\"this i32 literal is above 2147483647\");\n            self.help(b\"negate a smaller literal, or use an abstract integer: -2147483648\");\n            return cint(SK_I32, T_I32, 0);\n        }\n        if sk == SK_U32 && v > U32_MAX {\n            self.fail(at, b\"wgsl.const\", b\"this u32 literal is above 4294967295\");\n            return cint(SK_U32, T_U32, 0);\n        }\n        let ty: i64 = if sk == SK_I32 { T_I32 } else if sk == SK_U32 { T_U32 } else { -1 };\n        cint(sk, ty, v)\n    }\n\n    fn float_literal(&mut self, t: i64) -> Val {\n        let s = self.text(t);\n        let at = self.pos();\n        self.p += 1;\n");
    buf_str(out, c"        let mut end = s.len() as i64;\n        let mut sk = SK_AFLOAT;\n        let last = s[(end - 1) as usize];\n        let hex = s.len() as i64 > 2 && s[0] == b'0' && (s[1] == b'x' || s[1] == b'X');\n        if last == b'h' {\n            self.fail(at, b\"wgsl.unsupported\",\n                b\"'f16' literals are not in the WGSL subset of this release\");\n            return cfloat(SK_F32, T_F32, 0.0);\n        }\n        if last == b'f' && !hex {\n            sk = SK_F32;\n            end -= 1;\n        } else if last == b'f' && hex && s.len() as i64 > 2 {\n            // hex floats end in f only after an exponent\n            let mut has_p = false;\n            for i in 0..s.len() as i64 {\n                if s[i as usize] == b'p' || s[i as usize] == b'P' {\n                    has_p = true;\n                }\n            }\n            if has_p {\n                sk = SK_F32;\n                end -= 1;\n            }\n        }\n        let v = if hex { hex_float(&s[0..end as usize]) }\n            else {\n                str::from_utf8(&s[0..end as usize])\n                    .ok()\n                    .and_then(|t| t.parse::<f64>().ok())\n                    .unwrap_or(0.0)\n            };\n        if sk == SK_F32 {\n            let f = v as f32;\n            if f as f64 > F32_MAX || -(f as f64) > F32_MAX {\n                self.fail(at, b\"wgsl.const\", b\"this f32 literal is out of range\");\n            }\n            return cfloat(SK_F32, T_F32, f as f64);\n        }\n        cfloat(SK_AFLOAT, -1, v)\n    }\n\n    // ---- The Load Rule and conversions ----\n\n    // A value: a reference is read (E_LOAD).\n    #[effects(A)]\n    pub(crate) fn value(&mut self, v: Val, at: i64) -> Val {\n        if v.k == VK_REF {\n            let t = self.m.pointee(v.ty);\n            if self.m.has_atomic(t) {\n                self.fail(at, b\"wgsl.type\", b\"an atomic is read with atomicLoad\");\n                return cint(SK_AINT, -1, 0);\n            }\n");
    buf_str(out, c"            if self.m.is_runtime_sized(t) {\n                self.fail(at, b\"wgsl.type\",\n                    b\"a runtime-sized array cannot be read whole; index it\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let e = self.f.expr(E_LOAD, t, v.e, 0, 0);\n            return val(e, t);\n        }\n        if v.k == VK_VOID {\n            self.fail(at, b\"wgsl.type\", b\"this call has no result to use\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if v.k == VK_TYPE {\n            self.fail(at, b\"wgsl.type\", b\"a type is not a value\");\n            return cint(SK_AINT, -1, 0);\n        }\n        v\n    }\n\n    // The type v has once concrete (abstract ints become i32, floats f32).\n    #[effects(A)]\n    pub(crate) fn concrete_type_of(&self, v: Val) -> i64 {\n        if v.k == VK_CONST {\n            if v.ty >= 0 {\n                return v.ty;\n            }\n            return if v.sk == SK_AFLOAT { T_F32 } else { T_I32 };\n        }\n        if v.k == VK_REF {\n            return self.m.pointee(v.ty);\n        }\n        if v.k == VK_VOID || v.e < 0 && v.ty < 0 {\n            return T_I32;\n        }\n        v.ty\n    }\n\n    // v as type ty: abstract constants convert, references load; any\n    // other difference is an error.\n    #[effects(panic, A)]\n    pub(crate) fn convert_to(&mut self, v0: Val, ty: i64, at: i64) -> Val {\n        let v = self.value(v0, at);\n        if self.failed {\n            return if v.k == VK_CONST { v } else { self.dummy(ty) };\n        }\n        if v.k == VK_CONST {\n            if v.ty == ty {\n                return v;\n            }\n            let t = self.m.types[ty as usize];\n            if v.ty < 0 && t.kind == TK_SCALAR {\n                return self.const_cast(v, t.scalar, at, false);\n            }\n            self.mismatch(ty, v, at);\n            return v;\n        }\n        if v.ty != ty {\n            self.mismatch(ty, v, at);\n        }\n        v\n    }\n");
    buf_str(out, c"\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn mismatch(&mut self, want: i64, got: Val, at: i64) {\n        if self.err(at, b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"expected \");\n            self.ty_str(want);\n            self.emsg.extend_from_slice(b\", got \");\n            self.val_str(got);\n            let gt = self.concrete_type_of(got);\n            if gt >= 0 && self.m.types[gt as usize].kind == TK_SCALAR\n                && self.m.types[want as usize].kind == TK_SCALAR {\n                self.tmp.clear();\n                self.m.type_name(want, &mut self.tmp);\n                write(self.ehelp, \"convert it: {}(...)\",\n                    str::from_utf8(self.tmp.as_slice()).unwrap()).unwrap();\n            }\n        }\n    }\n\n    // A dummy value of type ty, after an error.\n    #[effects(A)]\n    pub(crate) fn dummy(&mut self, ty: i64) -> Val {\n        let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n        val(e, ty)\n    }\n\n    // v as an IR expression of type ty.\n    #[effects(A)]\n    pub(crate) fn materialize(&mut self, v0: Val, ty: i64, at: i64) -> i64 {\n        let v = self.convert_to(v0, ty, at);\n        if self.failed {\n            return self.f.expr(E_ZERO, ty, 0, 0, 0);\n        }\n        if v.k == VK_CONST {\n            return self.literal(v, ty);\n        }\n        v.e\n    }\n\n    // v (a value of any concrete type) as an IR expression, its type\n    // concrete.\n    pub(crate) fn emit_val(&mut self, v: Val, at: i64) -> i64 {\n        let t = self.concrete_type_of(v);\n        self.materialize(v, t, at)\n    }\n\n    #[effects(panic, A)]\n    pub(crate) fn literal(&mut self, v: Val, ty: i64) -> i64 {\n        let sk = self.m.types[ty as usize].scalar;\n        let bits = if sk == SK_F32 { f32_bits(v.fv as f32) as i64 } else { v.iv & 4294967295 };\n        self.f.expr(E_LITERAL, ty, bits, 0, 0)\n    }\n\n    // A constant as scalar kind `to`: an automatic conversion of an\n");
    buf_str(out, c"    // abstract number (`explicit` false), or a value constructor's.\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn const_cast(&mut self, v: Val, to: u8, at: i64, explicit: bool) -> Val {\n        let ty = to as i64;\n        let from = v.sk;\n        if from == to {\n            return Val { k: VK_CONST, sk: to, e: -1, ty: ty, iv: v.iv, fv: v.fv };\n        }\n        let is_float = from == SK_F32 || from == SK_AFLOAT;\n        if !explicit {\n            let ok = (from == SK_AINT && (to == SK_I32 || to == SK_U32 || to == SK_F32))\n                || (from == SK_AFLOAT && to == SK_F32);\n            if !ok {\n                if self.err(at, b\"wgsl.type\") {\n                    write(self.emsg, \"expected {}, got {}\",\n                        str::from_utf8(ir::scalar_name(to)).unwrap(),\n                        str::from_utf8(ir::scalar_name(from)).unwrap()).unwrap();\n                    if from == SK_AFLOAT && (to == SK_I32 || to == SK_U32) {\n                        write(self.ehelp, \"convert it: {}(...)\",\n                            str::from_utf8(ir::scalar_name(to)).unwrap()).unwrap();\n                    }\n                }\n                return cint(to, ty, 0);\n            }\n        }\n        if to == SK_BOOL {\n            let nz = if is_float { v.fv != 0.0 } else { v.iv != 0 };\n            return cint(SK_BOOL, T_BOOL, if nz { 1 } else { 0 });\n        }\n        if to == SK_F32 || to == SK_AFLOAT {\n            let x = if is_float { v.fv } else { v.iv as f64 };\n            if to == SK_F32 {\n                if x > F32_MAX || x < -F32_MAX {\n                    self.fail(at, b\"wgsl.const\", b\"this value is out of f32's range\");\n                }\n                return cfloat(SK_F32, T_F32, (x as f32) as f64);\n            }\n            return cfloat(SK_AFLOAT, -1, x);\n        }\n        // to an integer\n        let mut x = v.iv;\n        if is_float {\n            if explicit {\n");
    buf_str(out, c"                // value conversion: truncate, then saturate\n                let f = v.fv;\n                if to == SK_I32 {\n                    x = if f != f { 0 } else if f <= -2147483648.0 { I32_MIN }\n                        else if f >= 2147483520.0 { 2147483520 } else { f as i64 };\n                } else {\n                    x = if f != f { 0 } else if f <= 0.0 { 0 }\n                        else if f >= 4294967040.0 { 4294967040 } else { f as i64 };\n                }\n                return cint(to, ty, x);\n            }\n        }\n        if from == SK_BOOL {\n            return cint(to, ty, x);\n        }\n        if explicit && from != SK_AINT {\n            // between i32 and u32: the bits\n            if to == SK_U32 {\n                x = x & U32_MAX;\n            } else {\n                x = (x & U32_MAX) as i32 as i64;\n            }\n            return cint(to, ty, x);\n        }\n        if to == SK_I32 && (x < I32_MIN || x > I32_MAX) {\n            if self.err(at, b\"wgsl.const\") {\n                write(self.emsg, \"{x} does not fit in an i32\").unwrap();\n            }\n        } else if to == SK_U32 && (x < 0 || x > U32_MAX) {\n            if self.err(at, b\"wgsl.const\") {\n                write(self.emsg, \"{x} does not fit in a u32\").unwrap();\n                if x < 0 {\n                    self.help(b\"a u32 is never negative; use an i32, or bitcast<u32>(...)\");\n                }\n            }\n        }\n        cint(to, ty, x)\n    }\n\n    // ---- Operators ----\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn bad_operands(&mut self, op: &[u8], l: Val, r: Val, at: i64) {\n        if self.err(at, b\"wgsl.type\") {\n            {\n                let op = str::from_utf8(op).unwrap();\n                write(self.emsg, \"'{op}' cannot take \").unwrap();\n            }\n            self.val_str(l);\n            self.emsg.extend_from_slice(b\" and \");\n            self.val_str(r);\n        }\n");
    buf_str(out, c"    }\n\n    #[effects(panic, A)]\n    pub(crate) fn unary(&mut self, op: i64, v0: Val, at: i64) -> Val {\n        let v = self.value(v0, at);\n        if self.failed {\n            return v;\n        }\n        let t = self.concrete_type_of(v);\n        let tt = self.m.types[t as usize];\n        let sk = if v.k == VK_CONST { v.sk } else { tt.scalar };\n        let numeric = tt.kind == TK_SCALAR || tt.kind == TK_VECTOR;\n        if op == UN_NEG {\n            if !(numeric || tt.kind == TK_MATRIX) || sk == SK_BOOL || sk == SK_U32 {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'-' cannot take \");\n                    self.val_str(v);\n                    if sk == SK_U32 {\n                        self.help(b\"a u32 is never negative: 0u - x wraps, or use an i32\");\n                    }\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                if sk == SK_AFLOAT || sk == SK_F32 {\n                    return cfloat(sk, v.ty, -v.fv);\n                }\n                if sk == SK_I32 && v.iv == I32_MIN {\n                    self.fail(at, b\"wgsl.const\", b\"-(-2147483648i) does not fit in an i32\");\n                }\n                return cint(sk, v.ty, -v.iv);\n            }\n            if tt.kind == TK_MATRIX {\n                self.fail(at, b\"wgsl.unsupported\",\n                    b\"negating a matrix is not in this release; multiply by -1.0\");\n                return v;\n            }\n        } else if op == UN_NOT {\n            if !numeric || sk != SK_BOOL {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'!' takes a bool, not \");\n                    self.val_str(v);\n                    if sk == SK_I32 || sk == SK_U32 {\n                        self.help(b\"'~' is the bitwise not of an integer\");\n                    }\n                }\n                return v;\n            }\n");
    buf_str(out, c"            if v.k == VK_CONST {\n                return cint(SK_BOOL, T_BOOL, if v.iv == 0 { 1 } else { 0 });\n            }\n        } else {\n            if !numeric || !(sk == SK_I32 || sk == SK_U32 || sk == SK_AINT) {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"'~' takes an integer, not \");\n                    self.val_str(v);\n                }\n                return v;\n            }\n            if v.k == VK_CONST {\n                let x = ~v.iv;\n                return cint(sk, v.ty, if sk == SK_U32 { x & U32_MAX } else { x });\n            }\n        }\n        let e = self.f.expr(E_UNARY, t, op, v.e, 0);\n        val(e, t)\n    }\n\n    #[effects()]\n    pub(crate) fn op_text(&self, op: i64) -> &'static [u8] {\n        if op == OP_ADD {\n            b\"+\"\n        } else if op == OP_SUB {\n            b\"-\"\n        } else if op == OP_MUL {\n            b\"*\"\n        } else if op == OP_DIV {\n            b\"/\"\n        } else if op == OP_MOD {\n            b\"%\"\n        } else if op == OP_EQ {\n            b\"==\"\n        } else if op == OP_NE {\n            b\"!=\"\n        } else if op == OP_LT {\n            b\"<\"\n        } else if op == OP_LE {\n            b\"<=\"\n        } else if op == OP_GT {\n            b\">\"\n        } else if op == OP_GE {\n            b\">=\"\n        } else if op == OP_AND {\n            b\"&\"\n        } else if op == OP_OR {\n            b\"|\"\n        } else if op == OP_XOR {\n            b\"^\"\n        } else if op == OP_SHL {\n            b\"<<\"\n        } else {\n            b\">>\"\n        }\n    }\n\n    // Whether e is a constant (a literal, or a vector of literals) with a\n    // lane of n or more (unsigned).\n    fn const_lanes_at_least(&self, e: i64, n: i64) -> bool {\n        let x = self.f.exprs[e as usize];\n        if x.op == E_LITERAL {\n            return x.a >= n;\n        }\n        if x.op == E_SPLAT {\n");
    buf_str(out, c"            return self.const_lanes_at_least(x.a, n);\n        }\n        if x.op == ir::E_COMPOSE {\n            for i in x.a..x.a + x.b {\n                if self.const_lanes_at_least(self.f.args[i as usize], n) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn binary(&mut self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n        let mut l = self.value(l0, at);\n        let mut r = self.value(r0, at);\n        if self.failed {\n            return l;\n        }\n        if l.k == VK_CONST && r.k == VK_CONST {\n            return self.fold(op, l, r, at);\n        }\n        let shift = op == OP_SHL || op == OP_SHR;\n        // the abstract side takes the other side's scalar\n        if shift {\n            let rt0: i64 = if r.k == VK_CONST { -1 } else { r.ty };\n            if r.k == VK_CONST {\n                if r.ty < 0 || r.sk == SK_U32 {\n                    r = self.const_cast(r, SK_U32, at, false);\n                }\n            }\n            if l.k == VK_CONST && l.ty < 0 {\n                let rk = self.m.types[self.concrete_type_of(r) as usize];\n                let _ = rk;\n                l = self.const_cast(l, SK_I32, at, false);\n            }\n            let _ = rt0;\n        } else if l.k == VK_CONST && l.ty < 0 {\n            let rs = self.m.types[r.ty as usize].scalar;\n            l = self.const_cast(l, rs, at, false);\n        } else if r.k == VK_CONST && r.ty < 0 {\n            let ls = self.m.types[l.ty as usize].scalar;\n            r = self.const_cast(r, ls, at, false);\n        }\n        if self.failed {\n            return l;\n        }\n        let lt = self.concrete_type_of(l);\n        let rt = self.concrete_type_of(r);\n        let a = self.m.types[lt as usize];\n        let b = self.m.types[rt as usize];\n");
    buf_str(out, c"        let ln: i64 = if a.kind == TK_SCALAR { 1 } else if a.kind == TK_VECTOR { a.n } else { 0 };\n        let rn: i64 = if b.kind == TK_SCALAR { 1 } else if b.kind == TK_VECTOR { b.n } else { 0 };\n        // matrices\n        if a.kind == TK_MATRIX || b.kind == TK_MATRIX {\n            return self.matrix_op(op, l, r, lt, rt, at);\n        }\n        if ln == 0 || rn == 0 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let sk = a.scalar;\n        if shift {\n            if (sk != SK_I32 && sk != SK_U32) || b.scalar != SK_U32 || (ln != rn && rn != 1)\n                || (rn != 1 && ln == 1) {\n                if self.err(at, b\"wgsl.type\") {\n                    write(self.emsg, \"'{}' shifts an integer by a u32 (of the same width); got \",\n                        str::from_utf8(self.op_text(op)).unwrap()).unwrap();\n                    self.val_str(l);\n                    self.emsg.extend_from_slice(b\" and \");\n                    self.val_str(r);\n                    if b.scalar == SK_I32 {\n                        self.help(b\"convert the amount: u32(...)\");\n                    }\n                }\n                return l;\n            }\n            let le = self.materialize(l, lt, at);\n            let mut re = self.materialize(r, rt, at);\n            if ln != rn {\n                re = self.f.expr(E_SPLAT, vec_ty(SK_U32, ln), re, 0, 0);\n            }\n            if (r.k == VK_CONST && r.iv >= 32) || self.const_lanes_at_least(re, 32) {\n                self.fail(at, b\"wgsl.const\", b\"a constant shift amount is below 32\");\n            }\n            let e = self.f.expr(E_BINARY, lt, op, le, re);\n            return val(e, lt);\n        }\n        if sk != b.scalar {\n            self.bad_operands(self.op_text(op), l, r, at);\n            if (sk == SK_I32 && b.scalar == SK_U32) || (sk == SK_U32 && b.scalar == SK_I32) {\n                self.help(b\"convert one side: u32(...) or i32(...)\");\n");
    buf_str(out, c"            } else if sk == SK_F32 || b.scalar == SK_F32 {\n                self.help(b\"convert one side: f32(...)\");\n            }\n            return l;\n        }\n        let arith = op == OP_ADD || op == OP_SUB || op == OP_MUL || op == OP_DIV || op == OP_MOD;\n        let cmp = op >= OP_EQ && op <= OP_GE;\n        let bits = op == OP_AND || op == OP_OR || op == OP_XOR;\n        if ln != rn && !(arith && (ln == 1 || rn == 1)) {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if arith && sk == SK_BOOL {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if bits && sk == SK_F32 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        if cmp && sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let n = if ln > rn { ln } else { rn };\n        let vt = vec_ty(sk, n);\n        let mut le = self.materialize(l, lt, at);\n        let mut re = self.materialize(r, rt, at);\n        if ln < n {\n            le = self.f.expr(E_SPLAT, vt, le, 0, 0);\n        }\n        if rn < n {\n            re = self.f.expr(E_SPLAT, vt, re, 0, 0);\n        }\n        let ty = if cmp { vec_ty(SK_BOOL, n) } else { vt };\n        let e = self.f.expr(E_BINARY, ty, op, le, re);\n        val(e, ty)\n    }\n\n    fn matrix_op(&mut self, op: i64, l: Val, r: Val, lt: i64, rt: i64, at: i64) -> Val {\n        let a = self.m.types[lt as usize];\n        let b = self.m.types[rt as usize];\n        let mut ty: i64 = -1;\n        if op == OP_ADD || op == OP_SUB {\n            if lt == rt {\n                ty = lt;\n            }\n        } else if op == OP_MUL {\n            if a.kind == TK_MATRIX && b.kind == TK_SCALAR && b.scalar == SK_F32 {\n                ty = lt;\n");
    buf_str(out, c"            } else if a.kind == TK_SCALAR && a.scalar == SK_F32 && b.kind == TK_MATRIX {\n                ty = rt;\n            }\n            else if a.kind == TK_MATRIX && b.kind == TK_VECTOR && b.scalar == SK_F32 && b.n == a.n {\n                ty = vec_ty(SK_F32, a.m);\n            }\n            else if a.kind == TK_VECTOR && a.scalar == SK_F32 && b.kind == TK_MATRIX && a.n == b.m {\n                ty = vec_ty(SK_F32, b.n);\n            } else if a.kind == TK_MATRIX && b.kind == TK_MATRIX && a.n == b.m {\n                ty = mat_ty(b.n, a.m);\n            }\n        }\n        if ty < 0 {\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n        let le = self.materialize(l, lt, at);\n        let re = self.materialize(r, rt, at);\n        let e = self.f.expr(E_BINARY, ty, op, le, re);\n        val(e, ty)\n    }\n\n    // Both sides constant scalars: the result, computed as WGSL's\n    // constant evaluation does (errors where it overflows or divides by\n    // zero).\n    fn fold(&mut self, op: i64, l0: Val, r0: Val, at: i64) -> Val {\n        let mut l = l0;\n        let mut r = r0;\n        let shift = op == OP_SHL || op == OP_SHR;\n        // the common kind\n        if shift {\n            if r.sk == SK_AINT {\n                r = self.const_cast(r, SK_U32, at, false);\n            }\n            if r.sk != SK_U32 {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n        } else if l.sk != r.sk {\n            if l.ty < 0 && r.ty < 0 {\n                // abstract int and abstract float: float\n                if l.sk == SK_AINT {\n                    l = cfloat(SK_AFLOAT, -1, l.iv as f64);\n                } else {\n                    r = cfloat(SK_AFLOAT, -1, r.iv as f64);\n                }\n            } else if l.ty < 0 {\n                l = self.const_cast(l, r.sk, at, false);\n            } else if r.ty < 0 {\n");
    buf_str(out, c"                r = self.const_cast(r, l.sk, at, false);\n            } else {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n        }\n        if self.failed {\n            return l;\n        }\n        let sk = l.sk;\n        let ty = l.ty;\n        if op == OP_LAND || op == OP_LOR {\n            let x = if op == OP_LAND { l.iv != 0 && r.iv != 0 } else { l.iv != 0 || r.iv != 0 };\n            return cint(SK_BOOL, T_BOOL, if x { 1 } else { 0 });\n        }\n        if op >= OP_EQ && op <= OP_GE {\n            let mut c: i64 = 0;\n            if sk == SK_F32 || sk == SK_AFLOAT {\n                let x = l.fv;\n                let y = r.fv;\n                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n            } else {\n                if sk == SK_BOOL && op != OP_EQ && op != OP_NE {\n                    self.bad_operands(self.op_text(op), l, r, at);\n                    return l;\n                }\n                let x = l.iv;\n                let y = r.iv;\n                c = if op == OP_EQ { (x == y) as i64 } else if op == OP_NE { (x != y) as i64 }\n                    else if op == OP_LT { (x < y) as i64 } else if op == OP_LE { (x <= y) as i64 }\n                    else if op == OP_GT { (x > y) as i64 } else { (x >= y) as i64 };\n            }\n            return cint(SK_BOOL, T_BOOL, c);\n        }\n        if sk == SK_BOOL {\n            if op == OP_AND || op == OP_OR || op == OP_XOR {\n                let x = if op == OP_AND { l.iv & r.iv } else if op == OP_OR { l.iv | r.iv }\n                    else { l.iv ^ r.iv };\n                return cint(SK_BOOL, T_BOOL, x);\n            }\n            self.bad_operands(self.op_text(op), l, r, at);\n            return l;\n        }\n");
    buf_str(out, c"        if sk == SK_F32 || sk == SK_AFLOAT {\n            if op == OP_AND || op == OP_OR || op == OP_XOR || shift {\n                self.bad_operands(self.op_text(op), l, r, at);\n                return l;\n            }\n            let x = l.fv;\n            let y = r.fv;\n            let mut z = 0.0;\n            if sk == SK_F32 {\n                let a = x as f32;\n                let b = y as f32;\n                let zz = if op == OP_ADD { a + b } else if op == OP_SUB { a - b }\n                    else if op == OP_MUL { a * b } else if op == OP_DIV { a / b }\n                    else { a - b * trunc32(a / b) };\n                z = zz as f64;\n            } else {\n                z = if op == OP_ADD { x + y } else if op == OP_SUB { x - y }\n                    else if op == OP_MUL { x * y } else if op == OP_DIV { x / y }\n                    else { x - y * trunc64(x / y) };\n            }\n            if z != z || z > 1.7976931348623157e308 || z < -1.7976931348623157e308\n                || (sk == SK_F32 && (z > F32_MAX || z < -F32_MAX)) {\n                self.fail(at, b\"wgsl.const\",\n                    b\"this constant expression overflows or is not a number\");\n            }\n            return cfloat(sk, ty, z);\n        }\n        // integers: i32, u32, abstract (i64)\n        let x = l.iv;\n        let y = r.iv;\n        let mut z: i64 = 0;\n        if op == OP_ADD {\n            z = x + y;\n            if sk == SK_AINT && ((x > 0 && y > 0 && z < 0) || (x < 0 && y < 0 && z >= 0)) {\n                self.fail(at, b\"wgsl.const\", b\"this constant overflows 64 bits\");\n            }\n        } else if op == OP_SUB {\n            z = x - y;\n            if sk == SK_AINT && ((x >= 0 && y < 0 && z < 0) || (x < 0 && y > 0 && z >= 0)) {\n                self.fail(at, b\"wgsl.const\", b\"this constant overflows 64 bits\");\n            }\n        } else if op == OP_MUL {\n            z = x * y;\n            if sk == SK_AINT && x != 0\n");
    buf_str(out, c"                && (z / x != y || (x == -1 && y == -9223372036854775807 - 1)) {\n                self.fail(at, b\"wgsl.const\", b\"this constant overflows 64 bits\");\n            }\n        } else if op == OP_DIV || op == OP_MOD {\n            if y == 0 {\n                self.fail(at, b\"wgsl.const\", b\"a constant expression divides by zero\");\n                return l;\n            }\n            z = if op == OP_DIV { x / y } else { x % y };\n        } else if op == OP_AND {\n            z = x & y;\n        } else if op == OP_OR {\n            z = x | y;\n        } else if op == OP_XOR {\n            z = x ^ y;\n        } else if op == OP_SHL || op == OP_SHR {\n            let width: i64 = if sk == SK_AINT { 64 } else { 32 };\n            if y >= width {\n                self.fail(at, b\"wgsl.const\",\n                    b\"a constant shift amount is below the width of the shifted type\");\n                return l;\n            }\n            if op == OP_SHL {\n                z = x << y;\n            } else if sk == SK_U32 {\n                z = (x & U32_MAX) >> y;\n            } else {\n                z = x >> y;\n            }\n        }\n        if sk == SK_I32 {\n            if op == OP_SHL {\n                z = (z & U32_MAX) as i32 as i64;\n            } else if z < I32_MIN || z > I32_MAX {\n                self.fail(at, b\"wgsl.const\", b\"this constant expression overflows an i32\");\n            }\n        } else if sk == SK_U32 {\n            if op == OP_SHL {\n                z = z & U32_MAX;\n            } else if z < 0 || z > U32_MAX {\n                self.fail(at, b\"wgsl.const\", b\"this constant expression overflows a u32\");\n            }\n        }\n        cint(sk, ty, z)\n    }\n\n    // ---- Indexing and members ----\n\n    fn index(&mut self, base: Val, i0: Val, at: i64, ip: i64) -> Val {\n        if self.failed {\n            return base;\n        }\n        let i = self.value(i0, ip);\n        let it = self.concrete_type_of(i);\n");
    buf_str(out, c"        if it != T_I32 && it != T_U32 {\n            if self.err(ip, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"an index is an i32 or a u32, not \");\n                self.val_str(i);\n            }\n            return base;\n        }\n        let is_ref = base.k == VK_REF;\n        let bv = if is_ref { base } else { self.value(base, at) };\n        if bv.k == VK_CONST {\n            self.fail(at, b\"wgsl.type\", b\"a scalar cannot be indexed\");\n            return base;\n        }\n        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n        let t = self.m.types[bt as usize];\n        if t.kind != TK_ARRAY && t.kind != TK_VECTOR && t.kind != TK_MATRIX {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"cannot index \");\n                self.val_str(bv);\n                if t.kind == TK_POINTER {\n                    self.help(b\"dereference the pointer first: (*p)[i]\");\n                }\n            }\n            return base;\n        }\n        let el = self.m.elem_of(bt);\n        let n = self.m.index_len(bt);\n        let rty = if is_ref {\n            let pt = self.m.types[bv.ty as usize];\n            self.m.ptr_ty(el, pt.space, pt.access)\n        } else {\n            el\n        };\n        if i.k == VK_CONST && n > 0 {\n            if i.iv < 0 || i.iv >= n {\n                if self.err(ip, b\"wgsl.index\") {\n                    write(self.emsg, \"index {} is out of range: the length is {n}\", i.iv).unwrap();\n                }\n                return base;\n            }\n            let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i.iv, 0);\n            return Val {\n                k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0,\n            };\n        }\n        let ie = self.materialize(i, it, ip);\n        let e = self.f.expr(E_ACCESS, rty, bv.e, ie, ir::CK_PENDING);\n");
    buf_str(out, c"        Val { k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0 }\n    }\n\n    fn member(&mut self, base: Val, name: &[u8], at: i64) -> Val {\n        if self.failed {\n            return base;\n        }\n        let is_ref = base.k == VK_REF;\n        let bv = if is_ref { base } else { self.value(base, at) };\n        if bv.k == VK_CONST {\n            if self.err(at, b\"wgsl.type\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"a scalar has no member '{name}'\").unwrap();\n                }\n            }\n            return base;\n        }\n        let bt = if is_ref { self.m.pointee(bv.ty) } else { bv.ty };\n        let t = self.m.types[bt as usize];\n        if t.kind == TK_STRUCT {\n            for i in 0..t.mcount {\n                let mem = self.m.members[(t.mstart + i) as usize];\n                if mem.name == name {\n                    let rty = if is_ref {\n                        let pt = self.m.types[bv.ty as usize];\n                        self.m.ptr_ty(mem.ty, pt.space, pt.access)\n                    } else {\n                        mem.ty\n                    };\n                    let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, i, 0);\n                    return Val {\n                        k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0,\n                        fv: 0.0,\n                    };\n                }\n            }\n            if self.err(at, b\"wgsl.member\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"'{}' has no member '{name}'\", str::from_utf8(t.name).unwrap()).unwrap();\n                }\n                self.ehelp.extend_from_slice(b\"its members are \");\n                for i in 0..t.mcount {\n                    if i > 0 {\n                        self.ehelp.extend_from_slice(b\", \");\n");
    buf_str(out, c"                    }\n                    self.ehelp.extend_from_slice(self.m.members[(t.mstart + i) as usize].name);\n                }\n            }\n            return base;\n        }\n        if t.kind == TK_VECTOR {\n            let mut pat: i64 = 0;\n            let n = name.len() as i64;\n            let mut set: i64 = -1;\n            if n > 4 {\n                self.fail(at, b\"wgsl.member\", b\"a swizzle has at most 4 components\");\n                return base;\n            }\n            for i in 0..n {\n                let c = name[i as usize];\n                // (written: a destructuring `let` makes no open local, FL6)\n                let (comp, s): (i64, i64) = if c == b'x' {\n                    (0, 0)\n                } else if c == b'y' {\n                    (1, 0)\n                } else if c == b'z' {\n                    (2, 0)\n                } else if c == b'w' {\n                    (3, 0)\n                } else if c == b'r' {\n                    (0, 1)\n                } else if c == b'g' {\n                    (1, 1)\n                } else if c == b'b' {\n                    (2, 1)\n                } else if c == b'a' {\n                    (3, 1)\n                } else {\n                    (-1, -1)\n                };\n                if comp < 0 || comp >= t.n || (set >= 0 && s != set) {\n                    if self.err(at, b\"wgsl.member\") {\n                        {\n                            let name = str::from_utf8(name).unwrap();\n                            write(self.emsg, \"'.{name}' is not a component of a vec{}\", t.n).unwrap();\n                        }\n                        self.help(b\"components are x y z w (or r g b a), not mixed\");\n                    }\n                    return base;\n                }\n                set = s;\n                pat = pat | (comp << (2 * i));\n            }\n            if n == 1 {\n                let rty = if is_ref {\n");
    buf_str(out, c"                    let pt = self.m.types[bv.ty as usize];\n                    self.m.ptr_ty(t.scalar as i64, pt.space, pt.access)\n                } else {\n                    t.scalar as i64\n                };\n                let e = self.f.expr(E_ACCESS_INDEX, rty, bv.e, pat, 0);\n                return Val {\n                    k: if is_ref { VK_REF } else { VK_VALUE }, sk: 0, e: e, ty: rty, iv: 0, fv: 0.0,\n                };\n            }\n            let v = self.value(bv, at);\n            let rty = vec_ty(t.scalar, n);\n            let e = self.f.expr(E_SWIZZLE, rty, v.e, pat, n);\n            return val(e, rty);\n        }\n        if self.err(at, b\"wgsl.member\") {\n            {\n                let name = str::from_utf8(name).unwrap();\n                write(self.emsg, \"'.{name}': \").unwrap();\n            }\n            self.val_str(bv);\n            self.emsg.extend_from_slice(b\" has no members\");\n            if t.kind == TK_POINTER {\n                self.help(b\"dereference the pointer first: (*p).member\");\n            }\n        }\n        base\n    }\n}\n\nfn trunc32(x: f32) -> f32 {\n    if x != x || x > 8388608.0 || x < -8388608.0 {\n        return x;\n    }\n    (x as i64) as f32\n}\n\nfn trunc64(x: f64) -> f64 {\n    if x != x || x > 4503599627370496.0 || x < -4503599627370496.0 {\n        return x;\n    }\n    (x as i64) as f64\n}\n\n// A hexadecimal float literal's value, `0x1.8p3` (WGSL's: mantissa digits,\n// an optional point, `p` and a decimal exponent of two), exact while the\n// mantissa fits in 53 bits.\nfn hex_float(s: &[u8]) -> f64 {\n    let mut man: f64 = 0.0;\n    let mut e: i64 = 0;\n    let mut i: i64 = 2;\n    let mut after_point = false;\n    while i < s.len() as i64 && s[i as usize] != b'p' && s[i as usize] != b'P' {\n        let c = s[i as usize];\n        if c == b'.' {\n            after_point = true;\n        } else {\n            let d = if c >= b'0' && c <= b'9' { c - b'0' }\n");
    buf_str(out, c"                else if c >= b'a' && c <= b'f' { c - b'a' + 10 } else { c - b'A' + 10 };\n            man = man * 16.0 + d as f64;\n            if after_point {\n                e -= 4;\n            }\n        }\n        i += 1;\n    }\n    if i < s.len() as i64 {\n        i += 1;\n        let mut neg = false;\n        if i < s.len() as i64 && (s[i as usize] == b'+' || s[i as usize] == b'-') {\n            neg = s[i as usize] == b'-';\n            i += 1;\n        }\n        let mut x: i64 = 0;\n        while i < s.len() as i64 && s[i as usize] >= b'0' && s[i as usize] <= b'9' && x < 100000 {\n            x = x * 10 + (s[i as usize] - b'0') as i64;\n            i += 1;\n        }\n        e += if neg { -x } else { x };\n    }\n    // times 2^e, by exact steps\n    let mut v = man;\n    while e > 0 && v < 1.0e300 {\n        v = v * 2.0;\n        e -= 1;\n    }\n    while e < 0 && v != 0.0 {\n        v = v * 0.5;\n        e += 1;\n    }\n    v\n}\n// ---- end mod std::gpu::wgsl::expr ----\n}\n// ---- mod std::gpu::wgsl::builtins ----\nmod builtins {\n// EDITION: rust\n// ---- Shader compiler implementation, builtins (0.22) ----\n// Calls: user functions, value constructors (`vec3<f32>(...)`, `S(...)`,\n// inferred `vec3(...)` and `array(...)`), and WGSL's builtin functions\n// with their overloads.\n\nuse crate::alloc::Allocator;\n\nuse super::{front, ir};\nuse super::front::{Front, VK_CONST, VK_REF, VK_VALUE, VK_VOID, Val, cint, val};\nuse super::ir::{\n    AT_ADD, AT_AND, AT_CMPXCHG, AT_EXCHANGE, AT_LOAD, AT_MAX, AT_MIN, AT_OR, AT_STORE, AT_SUB,\n    AT_XOR, BARRIER_STORAGE, BARRIER_WORKGROUP, E_ARRAY_LENGTH, E_ATOMIC_RESULT, E_BITCAST,\n    E_COMPOSE, E_CONVERT, E_DERIVATIVE, E_GLOBAL, E_IMAGE_LOAD, E_IMAGE_QUERY, E_IMAGE_SAMPLE,\n    E_MATH, E_SELECT, E_SPLAT, E_WG_UNIFORM_RESULT, E_ZERO, IMG_SAMPLE, IMG_SAMPLE_BIAS,\n    IMG_SAMPLE_COMPARE, IMG_SAMPLE_COMPARE_LEVEL, IMG_SAMPLE_LEVEL, IQ_LAYERS, IQ_LEVELS, IQ_SIZE,\n");
    buf_str(out, c"    MF_ALL, MF_ANY, MF_CROSS, MF_DETERMINANT, MF_DISTANCE, MF_DOT, MF_EXTRACT_BITS, MF_INSERT_BITS,\n    MF_LDEXP, MF_LENGTH, MF_TRANSPOSE, SK_AFLOAT, SK_AINT, SK_BOOL, SK_F32, SK_I32, SK_U32,\n    SP_STORAGE, SP_WORKGROUP, STAGE_COMPUTE, STAGE_FRAGMENT, S_ATOMIC, S_BARRIER, S_IMAGE_STORE,\n    S_WG_UNIFORM_LOAD, StructMember, TEX_2D_ARRAY, TEX_DEPTH_2D, TEX_STORAGE_2D, TK_ARRAY,\n    TK_ATOMIC, TK_MATRIX, TK_POINTER, TK_SAMPLER, TK_SCALAR, TK_STRUCT, TK_TEXTURE, TK_VECTOR,\n    T_BOOL, T_F32, T_I32, T_U32, mat_ty, vec_ty,\n};\nuse super::lex::{T_COMMA, T_EOF, T_LPAREN, T_LT, T_RPAREN};\nuse super::names::{\n    K_ARRAY, K_ARRAY_LENGTH, K_ATOMIC_ADD, K_ATOMIC_AND, K_ATOMIC_COMPARE_EXCHANGE_WEAK,\n    K_ATOMIC_EXCHANGE, K_ATOMIC_LOAD, K_ATOMIC_MAX, K_ATOMIC_MIN, K_ATOMIC_OR, K_ATOMIC_STORE,\n    K_ATOMIC_SUB, K_ATOMIC_XOR, K_BITCAST, K_DPDX, K_FWIDTH_FINE, K_MAT2X2, K_MAT4X4, K_MATH_FIRST,\n    K_MATH_LAST, K_SELECT, K_STORAGE_BARRIER, K_TEXTURE_DIMENSIONS, K_TEXTURE_LOAD,\n    K_TEXTURE_NUM_LAYERS, K_TEXTURE_NUM_LEVELS, K_TEXTURE_SAMPLE, K_TEXTURE_SAMPLE_BIAS,\n    K_TEXTURE_SAMPLE_COMPARE, K_TEXTURE_SAMPLE_LEVEL, K_TEXTURE_STORE, K_VEC2, K_VEC4,\n    K_WORKGROUP_BARRIER, K_WORKGROUP_UNIFORM_LOAD,\n};\n\nimpl<'a, A: Allocator + Copy> Front<'a, A> {\n    // The arguments of a call, from its `(`: pushed on astack (positions\n    // on apos); returns their first index. `hint`: each argument's\n    // expected type, or -1.\n    fn args(&mut self, hint: i64) -> i64 {\n        let base = self.astack.len() as i64;\n        self.expect(T_LPAREN);\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let p = self.pos();\n            let v = self.parse_expr_hint(hint);\n            self.apos.push(p);\n            self.astack.push(v);\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        self.last_call_end = self.p;\n        base\n    }\n\n    fn drop_args(&mut self, base: i64) {\n");
    buf_str(out, c"        self.astack.truncate(base as usize);\n        self.apos.truncate(base as usize);\n    }\n\n    fn arg_count_error(&mut self, at: i64, name: &[u8], want: &[u8], got: i64) {\n        if self.err(at, b\"wgsl.call\") {\n            {\n                let name = str::from_utf8(name).unwrap();\n                let want = str::from_utf8(want).unwrap();\n                write(self.emsg, \"'{name}' takes {want}, got {got}\").unwrap();\n            }\n        }\n    }\n\n    // ---- User functions ----\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn user_call(&mut self, fh: i64, at: i64) -> Val {\n        // the function being lowered has its signature in self.f\n        let nparams = if fh == self.fh { self.f.params.len() as i64 }\n            else { self.m.functions[fh as usize].params.len() as i64 };\n        let base = self.estack.len() as i64;\n        self.expect(T_LPAREN);\n        let mut n: i64 = 0;\n        while self.kind() != T_RPAREN && self.kind() != T_EOF {\n            let ap = self.pos();\n            let hint: i64 = if n < nparams { self.param_ty(fh, n) } else { -1 };\n            let v = self.parse_expr_hint(hint);\n            if n < nparams {\n                let pt = self.param_ty(fh, n);\n                let mut ok = true;\n                if self.m.types[pt as usize].kind == TK_POINTER && v.k == VK_REF {\n                    ok = false;\n                    if self.err(ap, b\"wgsl.type\") {\n                        self.emsg.extend_from_slice(b\"expected a pointer, got a reference\");\n                        self.help(b\"pass its address: &x\");\n                    }\n                }\n                if ok {\n                    let e = self.materialize(v, pt, ap);\n                    self.estack.push(e);\n                }\n            }\n            n += 1;\n            if !self.eat(T_COMMA) {\n                break;\n            }\n        }\n        self.expect(T_RPAREN);\n        if n != nparams {\n");
    buf_str(out, c"            if self.err(at, b\"wgsl.call\") {\n                self.emsg.push(b'\\'');\n                if fh == self.fh {\n                    self.emsg.extend_from_slice(self.f.name);\n                } else {\n                    self.emsg.extend_from_slice(self.m.functions[fh as usize].name);\n                }\n                write(self.emsg, \"' takes {nparams} argument\").unwrap();\n                if nparams != 1 {\n                    self.emsg.push(b's');\n                }\n                write(self.emsg, \", got {n}\").unwrap();\n            }\n            self.estack.truncate(base as usize);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let start = self.f.args.len() as i64;\n        for i in base..self.estack.len() as i64 {\n            self.f.args.push(self.estack[i as usize]);\n        }\n        self.estack.truncate(base as usize);\n        let r = self.call_stmt(fh, start, n);\n        self.last_call_end = self.p;\n        r\n    }\n\n    fn param_ty(&self, fh: i64, i: i64) -> i64 {\n        if fh == self.fh {\n            self.f.params[i as usize].ty\n        } else {\n            self.m.functions[fh as usize].params[i as usize].ty\n        }\n    }\n\n    // ---- Constructors ----\n\n    // `T(args)` for a known type T, from the `(`.\n    #[effects(panic, A)]\n    pub(crate) fn construct(&mut self, ty: i64, at: i64) -> Val {\n        if self.kind() != T_LPAREN {\n            if self.err(self.pos(), b\"wgsl.syntax\") {\n                self.emsg.extend_from_slice(b\"a type here is a constructor: '\");\n                self.ty_str(ty);\n                self.emsg.extend_from_slice(b\"(...)'\");\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let t = self.m.types[ty as usize];\n        let hint: i64 = if t.kind == TK_VECTOR || t.kind == TK_MATRIX {\n            t.scalar as i64\n        } else if t.kind == TK_ARRAY {\n            t.base\n        } else {\n            -1\n");
    buf_str(out, c"        };\n        let base = self.args(hint);\n        let n = self.astack.len() as i64 - base;\n        let r = self.construct_from(ty, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn construct_from(&mut self, ty: i64, base: i64, n: i64, at: i64) -> Val {\n        let t = self.m.types[ty as usize];\n        if n == 0 {\n            if !self.storable(ty) || self.m.has_atomic(ty) || self.m.is_runtime_sized(ty) {\n                if self.err(at, b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"cannot construct \");\n                    self.ty_str(ty);\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            if t.kind == TK_SCALAR {\n                return if t.scalar == SK_F32 { front::cfloat(SK_F32, ty, 0.0) }\n                    else { cint(t.scalar, ty, 0) };\n            }\n            let e = self.f.expr(E_ZERO, ty, 0, 0, 0);\n            return val(e, ty);\n        }\n        if t.kind == TK_SCALAR {\n            if n != 1 {\n                self.arg_count_error(at, b\"a scalar constructor\", b\"one argument\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            return self.convert_value(self.astack[base as usize], ty, self.apos[base as usize]);\n        }\n        if t.kind == TK_VECTOR {\n            return self.construct_vector(t.scalar, t.n, base, n, at);\n        }\n        if t.kind == TK_MATRIX {\n            return self.construct_matrix(t.n, t.m, base, n, at);\n        }\n        if t.kind == TK_ARRAY {\n            if t.n == 0 {\n                self.fail(at, b\"wgsl.type\", b\"a runtime-sized array cannot be constructed\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if n != t.n {\n                if self.err(at, b\"wgsl.call\") {\n                    write(self.emsg, \"this array has {} elements, got {n}\", t.n).unwrap();\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n");
    buf_str(out, c"            return self.compose_args(ty, t.base, base, n);\n        }\n        if t.kind == TK_STRUCT {\n            if n != t.mcount {\n                if self.err(at, b\"wgsl.call\") {\n                    write(self.emsg, \"'{}' has {} members, got {n} arguments\",\n                        str::from_utf8(t.name).unwrap(), t.mcount).unwrap();\n                }\n                return cint(SK_AINT, -1, 0);\n            }\n            let start = self.estack.len() as i64;\n            for i in 0..n {\n                let mt = self.m.members[(t.mstart + i) as usize].ty;\n                let e = self.materialize(self.astack[(base + i) as usize], mt,\n                    self.apos[(base + i) as usize]);\n                self.estack.push(e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if self.err(at, b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"cannot construct \");\n            self.ty_str(ty);\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    fn compose_args(&mut self, ty: i64, el: i64, base: i64, n: i64) -> Val {\n        let start = self.estack.len() as i64;\n        for i in 0..n {\n            let e = self.materialize(self.astack[(base + i) as usize], el,\n                self.apos[(base + i) as usize]);\n            self.estack.push(e);\n        }\n        self.compose_from_estack(ty, start)\n    }\n\n    fn compose_from_estack(&mut self, ty: i64, start: i64) -> Val {\n        let a = self.f.args.len() as i64;\n        for i in start..self.estack.len() as i64 {\n            self.f.args.push(self.estack[i as usize]);\n        }\n        let n = self.estack.len() as i64 - start;\n        self.estack.truncate(start as usize);\n        let e = self.f.expr(E_COMPOSE, ty, a, n, 0);\n        val(e, ty)\n    }\n\n    // A value conversion `T(v)`: scalar to scalar, or vector to vector of\n    // the same width.\n    fn convert_value(&mut self, v0: Val, ty: i64, at: i64) -> Val {\n");
    buf_str(out, c"        let v = self.value(v0, at);\n        let t = self.m.types[ty as usize];\n        if v.k == VK_CONST {\n            if t.kind == TK_SCALAR {\n                return self.const_cast(v, t.scalar, at, true);\n            }\n            return self.convert_to(v, ty, at);\n        }\n        if self.failed {\n            return v;\n        }\n        let vt = self.m.types[v.ty as usize];\n        if v.ty == ty {\n            return v;\n        }\n        let w = self.m.width_of(v.ty);\n        if w == 0 || w != self.m.width_of(ty) {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"cannot convert \");\n                self.val_str(v);\n                self.emsg.extend_from_slice(b\" to \");\n                self.ty_str(ty);\n            }\n            return v;\n        }\n        let _ = vt;\n        let e = self.f.expr(E_CONVERT, ty, v.e, 0, 0);\n        val(e, ty)\n    }\n\n    // The scalar kind of a value's components (abstract kinds included).\n    fn comp_kind(&self, v: Val) -> u8 {\n        if v.k == VK_CONST {\n            return v.sk;\n        }\n        let t = self.concrete_type_of(v);\n        self.m.types[t as usize].scalar\n    }\n\n    // The concrete scalar the arguments base .. base + n share: a\n    // concrete argument's, else (all abstract) the hint's, else f32 when\n    // one is a float, else `dflt`.\n    fn common_scalar(&self, base: i64, n: i64, hint_sk: i64, dflt: u8) -> u8 {\n        let mut any_float = false;\n        for i in base..base + n {\n            let v = self.astack[i as usize];\n            if v.k == VK_CONST && v.ty < 0 {\n                if v.sk == SK_AFLOAT {\n                    any_float = true;\n                }\n                continue;\n            }\n            return self.comp_kind(v);\n        }\n        if hint_sk >= 0 && hint_sk <= 3 {\n            let h = hint_sk as u8;\n            if !(any_float && h != SK_F32) {\n                return h;\n            }\n");
    buf_str(out, c"        }\n        if any_float { SK_F32 } else { dflt }\n    }\n\n    fn construct_vector(&mut self, sk: u8, n: i64, base: i64, count: i64, at: i64) -> Val {\n        let ty = vec_ty(sk, n);\n        if count == 1 {\n            let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n            let w: i64 = if v.k == VK_CONST { 1 } else { self.m.width_of(v.ty) };\n            if w == 1 {\n                let e = self.materialize(v, sk as i64, self.apos[base as usize]);\n                let s = self.f.expr(E_SPLAT, ty, e, 0, 0);\n                return val(s, ty);\n            }\n            if w == n {\n                return self.convert_value(v, ty, self.apos[base as usize]);\n            }\n        }\n        let start = self.estack.len() as i64;\n        let mut total: i64 = 0;\n        for i in base..base + count {\n            let v = self.value(self.astack[i as usize], self.apos[i as usize]);\n            if v.k == VK_CONST {\n                let e = self.materialize(v, sk as i64, self.apos[i as usize]);\n                self.estack.push(e);\n                total += 1;\n                continue;\n            }\n            let vt = self.m.types[v.ty as usize];\n            if vt.kind == TK_SCALAR {\n                let e = self.materialize(v, sk as i64, self.apos[i as usize]);\n                self.estack.push(e);\n                total += 1;\n            } else if vt.kind == TK_VECTOR {\n                let e = self.materialize(v, vec_ty(sk, vt.n), self.apos[i as usize]);\n                self.estack.push(e);\n                total += vt.n;\n            } else {\n                if self.err(self.apos[i as usize], b\"wgsl.type\") {\n                    self.emsg.extend_from_slice(b\"a vector is made of scalars and vectors, not \");\n                    self.val_str(v);\n                }\n                self.estack.truncate(start as usize);\n                return cint(SK_AINT, -1, 0);\n            }\n        }\n        if total != n {\n");
    buf_str(out, c"            if self.err(at, b\"wgsl.call\") {\n                write(self.emsg, \"a vec{n} needs {n} components, got {total}\").unwrap();\n            }\n            self.estack.truncate(start as usize);\n            return cint(SK_AINT, -1, 0);\n        }\n        self.compose_from_estack(ty, start)\n    }\n\n    fn construct_matrix(&mut self, c: i64, r: i64, base: i64, count: i64, at: i64) -> Val {\n        let ty = mat_ty(c, r);\n        let col = vec_ty(SK_F32, r);\n        if count == 1 {\n            let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n            if v.k == VK_VALUE && v.ty == ty {\n                return v;\n            }\n        }\n        let start = self.estack.len() as i64;\n        if count == c {\n            for i in base..base + count {\n                let e = self.materialize(self.astack[i as usize], col, self.apos[i as usize]);\n                self.estack.push(e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if count == c * r {\n            for k in 0..c {\n                let cs = self.estack.len() as i64;\n                for j in 0..r {\n                    let i = base + k * r + j;\n                    let e = self.materialize(self.astack[i as usize], T_F32, self.apos[i as usize]);\n                    self.estack.push(e);\n                }\n                let colv = self.compose_from_estack(col, cs);\n                self.estack.push(colv.e);\n            }\n            return self.compose_from_estack(ty, start);\n        }\n        if self.err(at, b\"wgsl.call\") {\n            write(self.emsg,\n                \"a mat{c}x{r} is made of {c} columns or {} scalars, got {count} arguments\",\n                c * r).unwrap();\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // ---- Builtins ----\n\n    #[effects(alloc(extern), io, static, panic, diverge, A)]\n    pub(crate) fn builtin_primary(&mut self, s: i64, at: i64, hint: i64) -> Val {\n");
    buf_str(out, c"        // inferred constructors\n        if s >= K_VEC2 && s <= K_VEC4 && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let n = s - K_VEC2 + 2;\n            let hs: i64 = if hint >= 0 { self.m.types[hint as usize].scalar as i64 } else { -1 };\n            let hk = if hint >= 0 { self.m.types[hint as usize].kind } else { 255 };\n            let base = self.args(if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 });\n            let cnt = self.astack.len() as i64 - base;\n            let sk = self.common_scalar(base, cnt,\n                if hk == TK_VECTOR || hk == TK_SCALAR { hs } else { -1 }, SK_I32);\n            let r = if cnt == 0 { self.construct_from(vec_ty(sk, n), base, 0, at) }\n                else { self.construct_vector(sk, n, base, cnt, at) };\n            self.drop_args(base);\n            return r;\n        }\n        if s >= K_MAT2X2 && s <= K_MAT4X4 && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let i = s - K_MAT2X2;\n            let base = self.args(T_F32);\n            let cnt = self.astack.len() as i64 - base;\n            let r = if cnt == 0 {\n                self.construct_from(mat_ty(i / 3 + 2, i % 3 + 2), base, 0, at)\n            } else {\n                self.construct_matrix(i / 3 + 2, i % 3 + 2, base, cnt, at)\n            };\n            self.drop_args(base);\n            return r;\n        }\n        if s == K_ARRAY && self.kind_at(self.p + 1) == T_LPAREN {\n            self.p += 1;\n            let he: i64 = if hint >= 0\n                && self.m.types[hint as usize].kind == TK_ARRAY { self.m.types[hint as usize].base }\n                else { -1 };\n            let base = self.args(he);\n            let cnt = self.astack.len() as i64 - base;\n            if cnt == 0 {\n                self.fail(at, b\"wgsl.call\",\n                    b\"'array()' needs its elements, or a type: 'array<f32, 4>()'\");\n                self.drop_args(base);\n");
    buf_str(out, c"                return cint(SK_AINT, -1, 0);\n            }\n            // the element type: a concrete element's, else the hint's, else the default\n            let mut el: i64 = -1;\n            for i in base..base + cnt {\n                let v = self.astack[i as usize];\n                if !(v.k == VK_CONST && v.ty < 0) {\n                    el = self.concrete_type_of(v);\n                    break;\n                }\n            }\n            if el < 0 {\n                el = if he >= 0 { he } else { self.concrete_type_of(self.astack[base as usize]) };\n            }\n            let ty = self.m.array_ty(el, cnt);\n            let r = self.compose_args(ty, el, base, cnt);\n            self.drop_args(base);\n            return r;\n        }\n        if self.is_type_name(s) {\n            let ty = self.parse_type();\n            return self.construct(ty, at);\n        }\n        self.p += 1;\n        if self.kind() != T_LPAREN {\n            if s == K_BITCAST && self.kind() == T_LT {\n                self.p += 1;\n                let ty = self.parse_type();\n                self.expect_gt();\n                return self.bitcast(ty, at);\n            }\n            if self.err(at, b\"wgsl.name\") {\n                write(self.emsg, \"unknown name '{}'\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        if s >= K_MATH_FIRST && s <= K_MATH_LAST {\n            return self.math(s - K_MATH_FIRST, s, at);\n        }\n        if s == K_SELECT {\n            return self.select(at);\n        }\n        if s == K_ARRAY_LENGTH {\n            return self.array_length(at);\n        }\n        if s >= K_ATOMIC_LOAD && s <= K_ATOMIC_COMPARE_EXCHANGE_WEAK {\n            return self.atomic(s, at);\n        }\n        if s == K_WORKGROUP_BARRIER || s == K_STORAGE_BARRIER {\n            let base = self.args(-1);\n            let n = self.astack.len() as i64 - base;\n            self.drop_args(base);\n");
    buf_str(out, c"            if n != 0 {\n                self.arg_count_error(at, self.name_of(s), b\"no arguments\", n);\n            }\n            if self.stage != STAGE_COMPUTE as i64 && self.stage != 255 {\n                self.fail(at, b\"wgsl.stage\", b\"barriers are for compute shaders\");\n            }\n            self.push_stmt(S_BARRIER,\n                if s == K_WORKGROUP_BARRIER { BARRIER_WORKGROUP } else { BARRIER_STORAGE }, 0, 0,\n                0);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        if s == K_WORKGROUP_UNIFORM_LOAD {\n            let base = self.args(-1);\n            let n = self.astack.len() as i64 - base;\n            if n != 1 {\n                self.drop_args(base);\n                self.arg_count_error(at, b\"workgroupUniformLoad\", b\"one pointer\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let p = self.value(self.astack[base as usize], self.apos[base as usize]);\n            self.drop_args(base);\n            let pt = if p.k == VK_VALUE { self.m.types[p.ty as usize] }\n                else { self.m.types[T_I32 as usize] };\n            if pt.kind != TK_POINTER || pt.space != SP_WORKGROUP || self.m.has_atomic(pt.base) {\n                self.fail(at, b\"wgsl.type\",\n                    b\"workgroupUniformLoad takes a pointer to workgroup memory (not an atomic): &x\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let r = self.unemitted(E_WG_UNIFORM_RESULT, pt.base);\n            self.push_stmt(S_WG_UNIFORM_LOAD, p.e, r, 0, 0);\n            return val(r, pt.base);\n        }\n        if s >= K_DPDX && s <= K_FWIDTH_FINE {\n            let k = (s - K_DPDX) % 3;\n            let base = self.args(-1);\n            let n = self.astack.len() as i64 - base;\n            if n != 1 {\n                self.drop_args(base);\n                self.arg_count_error(at, self.name_of(s), b\"one argument\", n);\n");
    buf_str(out, c"                return cint(SK_AINT, -1, 0);\n            }\n            if self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n                self.fail(at, b\"wgsl.stage\", b\"derivatives are for fragment shaders\");\n            }\n            let ty = self.float_type(self.astack[base as usize], self.apos[base as usize]);\n            let e0 = self.materialize(self.astack[base as usize], ty, self.apos[base as usize]);\n            self.drop_args(base);\n            let e = self.f.expr(E_DERIVATIVE, ty, k, e0, 0);\n            return val(e, ty);\n        }\n        if s >= K_TEXTURE_SAMPLE && s <= K_TEXTURE_NUM_LAYERS {\n            return self.texture_call(s, at);\n        }\n        if self.err(at, b\"wgsl.name\") {\n            write(self.emsg, \"unknown function '{}'\", str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // An f32 scalar or vector type for v (abstract numbers become f32).\n    fn float_type(&mut self, v: Val, at: i64) -> i64 {\n        if v.k == VK_CONST && v.ty < 0 {\n            return T_F32;\n        }\n        let t = self.concrete_type_of(v);\n        let tt = self.m.types[t as usize];\n        if (tt.kind != TK_SCALAR && tt.kind != TK_VECTOR) || tt.scalar != SK_F32 {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"expected f32 or vecN<f32>, got \");\n                self.val_str(v);\n                if tt.scalar == SK_I32 || tt.scalar == SK_U32 {\n                    self.help(b\"convert it: f32(...)\");\n                }\n            }\n            return T_F32;\n        }\n        t\n    }\n\n    fn bitcast(&mut self, ty: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        if n != 1 {\n            self.drop_args(base);\n            self.arg_count_error(at, b\"bitcast\", b\"one argument\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n");
    buf_str(out, c"        let mut v = self.value(self.astack[base as usize], self.apos[base as usize]);\n        let ap = self.apos[base as usize];\n        self.drop_args(base);\n        if v.k == VK_CONST && v.ty < 0 {\n            v = if v.sk == SK_AINT && v.iv > 2147483647 { self.const_cast(v, SK_U32, ap, false) }\n                else {\n                    self.const_cast(v, if v.sk == SK_AINT { SK_I32 } else { SK_F32 }, ap, false)\n                };\n        }\n        let vt = self.concrete_type_of(v);\n        let w = self.m.width_of(vt);\n        let tw = self.m.width_of(ty);\n        if w == 0 || w != tw || self.m.types[vt as usize].scalar == SK_BOOL\n            || self.m.types[ty as usize].scalar == SK_BOOL {\n            if self.err(at, b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"bitcast converts between 32-bit numbers and vectors of them of one width; got \");\n                self.val_str(v);\n                self.emsg.extend_from_slice(b\" to \");\n                self.ty_str(ty);\n            }\n            return v;\n        }\n        let e0 = self.materialize(v, vt, ap);\n        if vt == ty {\n            return val(e0, ty);\n        }\n        let e = self.f.expr(E_BITCAST, ty, e0, 0, 0);\n        val(e, ty)\n    }\n\n    fn select(&mut self, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        if n != 3 {\n            self.drop_args(base);\n            self.arg_count_error(at, b\"select\", b\"3 arguments (if false, if true, condition)\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let sk = self.common_scalar(base, 2, -1, SK_I32);\n        let mut ty: i64 = -1;\n        for i in base..base + 2 {\n            let v = self.astack[i as usize];\n            if !(v.k == VK_CONST && v.ty < 0) {\n                ty = self.concrete_type_of(v);\n                break;\n            }\n        }\n        if ty < 0 {\n            ty = sk as i64;\n        }\n");
    buf_str(out, c"        let tt = self.m.types[ty as usize];\n        if tt.kind != TK_SCALAR && tt.kind != TK_VECTOR {\n            self.drop_args(base);\n            self.fail(at, b\"wgsl.type\", b\"select chooses between scalars or vectors\");\n            return cint(SK_AINT, -1, 0);\n        }\n        let f = self.materialize(self.astack[base as usize], ty, self.apos[base as usize]);\n        let t = self.materialize(self.astack[(base + 1) as usize], ty,\n            self.apos[(base + 1) as usize]);\n        let cv = self.value(self.astack[(base + 2) as usize], self.apos[(base + 2) as usize]);\n        let ct = self.concrete_type_of(cv);\n        let w = self.m.width_of(ty);\n        if ct != T_BOOL && ct != vec_ty(SK_BOOL, w) {\n            if self.err(self.apos[(base + 2) as usize], b\"wgsl.type\") {\n                self.emsg.extend_from_slice(b\"select's condition is a bool (or a vector of bool as wide as the values), not \");\n                self.val_str(cv);\n            }\n        }\n        let c = self.materialize(cv, ct, self.apos[(base + 2) as usize]);\n        self.drop_args(base);\n        let e = self.f.expr(E_SELECT, ty, c, t, f);\n        val(e, ty)\n    }\n\n    fn array_length(&mut self, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        if n != 1 {\n            self.drop_args(base);\n            self.arg_count_error(at, b\"arrayLength\", b\"one pointer\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let p = self.astack[base as usize];\n        self.drop_args(base);\n        let ok = p.k == VK_VALUE && self.m.types[p.ty as usize].kind == TK_POINTER\n            && self.m.types[p.ty as usize].space == SP_STORAGE;\n        if ok {\n            let pe = self.f.exprs[p.e as usize];\n            let pointee = self.m.pointee(p.ty);\n            let t = self.m.types[pointee as usize];\n            if t.kind == TK_ARRAY && t.n == 0 {\n                if pe.op == E_GLOBAL {\n");
    buf_str(out, c"                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, pe.a, -1, 0);\n                    self.f.exprs[e as usize].d = t.stride;\n                    return val(e, T_U32);\n                }\n                if pe.op == ir::E_ACCESS_INDEX && self.f.exprs[pe.a as usize].op == E_GLOBAL {\n                    let g = self.f.exprs[pe.a as usize].a;\n                    let st = self.m.types[self.m.globals[g as usize].ty as usize];\n                    let off = self.m.members[(st.mstart + pe.b) as usize].offset;\n                    let e = self.f.expr(E_ARRAY_LENGTH, T_U32, g, pe.b, off);\n                    self.f.exprs[e as usize].d = t.stride;\n                    return val(e, T_U32);\n                }\n            }\n        }\n        if self.err(at, b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"arrayLength takes a pointer to a runtime-sized array in a storage buffer: arrayLength(&buf) or arrayLength(&buf.items)\");\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    fn atomic(&mut self, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        let want: i64 = if s == K_ATOMIC_LOAD { 1 }\n            else if s == K_ATOMIC_COMPARE_EXCHANGE_WEAK { 3 } else { 2 };\n        if n != want {\n            self.drop_args(base);\n            if self.err(at, b\"wgsl.call\") {\n                write(self.emsg, \"'{}' takes {want} argument\",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                if want != 1 {\n                    self.emsg.push(b's');\n                }\n                write(self.emsg, \", got {n}\").unwrap();\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let p = self.astack[base as usize];\n        let pt = if p.k == VK_VALUE && p.ty >= 0 { self.m.types[p.ty as usize] }\n            else { self.m.types[T_I32 as usize] };\n");
    buf_str(out, c"        if pt.kind != TK_POINTER || self.m.types[pt.base as usize].kind != TK_ATOMIC {\n            self.drop_args(base);\n            if self.err(self.apos[base as usize], b\"wgsl.type\") {\n                write(self.emsg, \"'{}' takes a pointer to an atomic, got \",\n                    str::from_utf8(self.name_of(s)).unwrap()).unwrap();\n                self.val_str(p);\n                if p.k == VK_REF {\n                    self.help(b\"pass its address: &x\");\n                }\n            }\n            return cint(SK_AINT, -1, 0);\n        }\n        let sk = self.m.types[pt.base as usize].scalar;\n        let st = sk as i64;\n        let fun = if s == K_ATOMIC_LOAD {\n            AT_LOAD\n        } else if s == K_ATOMIC_STORE {\n            AT_STORE\n        } else if s == K_ATOMIC_ADD {\n            AT_ADD\n        } else if s == K_ATOMIC_SUB {\n            AT_SUB\n        } else if s == K_ATOMIC_MAX {\n            AT_MAX\n        } else if s == K_ATOMIC_MIN {\n            AT_MIN\n        } else if s == K_ATOMIC_AND {\n            AT_AND\n        } else if s == K_ATOMIC_OR {\n            AT_OR\n        } else if s == K_ATOMIC_XOR {\n            AT_XOR\n        } else if s == K_ATOMIC_EXCHANGE {\n            AT_EXCHANGE\n        } else {\n            AT_CMPXCHG\n        };\n        let mut v: i64 = -1;\n        let mut cmp: i64 = -1;\n        if fun == AT_CMPXCHG {\n            cmp = self.materialize(self.astack[(base + 1) as usize], st,\n                self.apos[(base + 1) as usize]);\n            v = self.materialize(self.astack[(base + 2) as usize], st,\n                self.apos[(base + 2) as usize]);\n        } else if fun != AT_LOAD {\n            v = self.materialize(self.astack[(base + 1) as usize], st,\n                self.apos[(base + 1) as usize]);\n        }\n        self.drop_args(base);\n        if fun == AT_STORE {\n            let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, -1);\n            self.f.stmts[s0 as usize].e = -1;\n");
    buf_str(out, c"            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        let rty = if fun == AT_CMPXCHG { self.cmpxchg_type(sk) } else { st };\n        let r = self.unemitted(E_ATOMIC_RESULT, rty);\n        let s0 = self.push_stmt(S_ATOMIC, p.e, fun, v, r);\n        self.f.stmts[s0 as usize].e = cmp;\n        val(r, rty)\n    }\n\n    // __atomic_compare_exchange_result<T>: { old_value: T, exchanged: bool }\n    #[effects(panic, A)]\n    pub(crate) fn cmpxchg_type(&mut self, sk: u8) -> i64 {\n        let i: i64 = if sk == SK_I32 { 0 } else { 1 };\n        if self.cmpxchg_ty[i as usize] >= 0 {\n            return self.cmpxchg_ty[i as usize];\n        }\n        let start = self.m.members.len() as i64;\n        self.m.members.push(StructMember {\n            name: b\"old_value\", ty: sk as i64, offset: 0, binding: ir::no_binding(),\n        });\n        self.m.members.push(StructMember {\n            name: b\"exchanged\", ty: T_BOOL, offset: 0, binding: ir::no_binding(),\n        });\n        let name = if sk == SK_I32 { \"__atomic_compare_exchange_result_i32\" }\n            else { \"__atomic_compare_exchange_result_u32\" };\n        let h = self.m.struct_ty(name.as_bytes(), start, 2);\n        self.cmpxchg_ty[i as usize] = h;\n        h\n    }\n\n    // ---- Math ----\n\n    fn math(&mut self, fun: i64, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        let name = self.name_of(s);\n        let want = math_arity(fun);\n        if n != want {\n            self.drop_args(base);\n            if self.err(at, b\"wgsl.call\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"'{name}' takes {want} argument\").unwrap();\n                }\n                if want != 1 {\n                    self.emsg.push(b's');\n                }\n                write(self.emsg, \", got {n}\").unwrap();\n            }\n");
    buf_str(out, c"            return cint(SK_AINT, -1, 0);\n        }\n        let r = self.math_typed(fun, name, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn math_fail(&mut self, at: i64, name: &[u8], what: &[u8], base: i64, n: i64) -> Val {\n        if self.err(at, b\"wgsl.type\") {\n            {\n                let name = str::from_utf8(name).unwrap();\n                let what = str::from_utf8(what).unwrap();\n                write(self.emsg, \"'{name}' takes {what}; got \").unwrap();\n            }\n            for i in base..base + n {\n                if i > base {\n                    self.emsg.extend_from_slice(b\", \");\n                }\n                self.val_str(self.astack[i as usize]);\n            }\n        }\n        cint(SK_AINT, -1, 0)\n    }\n\n    // The common type of args[base .. base + n] (abstract ones take the\n    // others' scalar; all abstract: f32 when `float`, else by their kind).\n    fn common_type(&self, base: i64, n: i64, float: bool) -> i64 {\n        for i in base..base + n {\n            let v = self.astack[i as usize];\n            if !(v.k == VK_CONST && v.ty < 0) {\n                return self.concrete_type_of(v);\n            }\n        }\n        let mut any_float = float;\n        for i in base..base + n {\n            if self.astack[i as usize].sk == SK_AFLOAT {\n                any_float = true;\n            }\n        }\n        if any_float { T_F32 } else { T_I32 }\n    }\n\n    fn math_typed(&mut self, fun: i64, name: &[u8], base: i64, n: i64, at: i64) -> Val {\n        let float_only = is_float_fun(fun);\n        if fun == MF_ALL || fun == MF_ANY {\n            let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n            let t = self.concrete_type_of(v);\n            if self.m.types[t as usize].scalar != SK_BOOL || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, b\"a bool or a vector of bool\", base, n);\n            }\n            if t == T_BOOL {\n");
    buf_str(out, c"                return v;\n            }\n            let e0 = self.materialize(v, t, self.apos[base as usize]);\n            return self.math_expr(fun, T_BOOL, [e0, 0, 0, 0], 1);\n        }\n        if fun >= ir::MF_PACK4X8UNORM && fun <= ir::MF_UNPACK2X16FLOAT\n            || fun >= ir::MF_PACK4X8SNORM {\n            return self.packing(fun, name, base, at);\n        }\n        if fun == MF_LDEXP {\n            let t = self.float_type(self.astack[base as usize], self.apos[base as usize]);\n            let w = self.m.width_of(t);\n            let e0 = self.materialize(self.astack[base as usize], t, self.apos[base as usize]);\n            let e1 = self.materialize(self.astack[(base + 1) as usize], vec_ty(SK_I32, w),\n                self.apos[(base + 1) as usize]);\n            return self.math_expr(fun, t, [e0, e1, 0, 0], 2);\n        }\n        if fun == MF_EXTRACT_BITS || fun == MF_INSERT_BITS {\n            let k: i64 = if fun == MF_EXTRACT_BITS { 1 } else { 2 };\n            let t = self.common_type(base, k, false);\n            let sk = self.m.types[t as usize].scalar;\n            if (sk != SK_I32 && sk != SK_U32) || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, b\"i32 or u32 values and u32 offset and count\", base,\n                    n);\n            }\n            let mut es: [i64; 4] = [0i64; 4];\n            for i in 0..k {\n                es[i as usize] = self.materialize(self.astack[(base + i) as usize], t,\n                    self.apos[(base + i) as usize]);\n            }\n            es[k as usize] = self.materialize(self.astack[(base + k) as usize], T_U32,\n                self.apos[(base + k) as usize]);\n            es[(k + 1) as usize] = self.materialize(self.astack[(base + k + 1) as usize], T_U32,\n                self.apos[(base + k + 1) as usize]);\n            return self.math_expr(fun, t, es, k + 2);\n        }\n        if fun == ir::MF_MIX {\n            // mix(a, b, t): t is the same type, or a scalar\n");
    buf_str(out, c"            let t = self.common_type(base, 2, true);\n            if self.m.types[t as usize].scalar != SK_F32 || self.m.width_of(t) == 0 {\n                return self.math_fail(at, name, b\"f32 values\", base, n);\n            }\n            let e0 = self.materialize(self.astack[base as usize], t, self.apos[base as usize]);\n            let e1 = self.materialize(self.astack[(base + 1) as usize], t,\n                self.apos[(base + 1) as usize]);\n            let tv = self.value(self.astack[(base + 2) as usize], self.apos[(base + 2) as usize]);\n            let tt = if tv.k == VK_CONST { T_F32 } else { tv.ty };\n            let mut e2 = self.materialize(tv, if tt == T_F32 { T_F32 } else { t },\n                self.apos[(base + 2) as usize]);\n            if tt == T_F32 && t != T_F32 {\n                e2 = self.f.expr(E_SPLAT, t, e2, 0, 0);\n            }\n            return self.math_expr(fun, t, [e0, e1, e2, 0], 3);\n        }\n        let t = self.common_type(base, n, float_only);\n        let tt = self.m.types[t as usize];\n        let sk = tt.scalar;\n        if fun == MF_DETERMINANT || fun == MF_TRANSPOSE {\n            if tt.kind != TK_MATRIX || (fun == MF_DETERMINANT && tt.n != tt.m) {\n                return self.math_fail(at, name,\n                    if fun == MF_DETERMINANT { b\"a square matrix\" } else { b\"a matrix\" }, base, n);\n            }\n            let e0 = self.materialize(self.astack[base as usize], t, self.apos[base as usize]);\n            let rt = if fun == MF_DETERMINANT { T_F32 } else { mat_ty(tt.m, tt.n) };\n            return self.math_expr(fun, rt, [e0, 0, 0, 0], 1);\n        }\n        let w = self.m.width_of(t);\n        if w == 0 || sk == SK_BOOL {\n            return self.math_fail(at, name,\n                if float_only { b\"f32 or vecN<f32>\" } else { b\"numbers or vectors of them\" }, base,\n                n);\n        }\n        if float_only && sk != SK_F32 {\n");
    buf_str(out, c"            let r = self.math_fail(at, name, b\"f32 or vecN<f32>\", base, n);\n            self.help(b\"convert it: f32(...)\");\n            return r;\n        }\n        if is_int_fun(fun) && sk == SK_F32 {\n            return self.math_fail(at, name, b\"i32 or u32 (or vectors of them)\", base, n);\n        }\n        if fun == ir::MF_SIGN && sk == SK_U32 {\n            return self.math_fail(at, name, b\"i32 or f32 (or vectors of them)\", base, n);\n        }\n        let vector_only = fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n            || fun == ir::MF_FACE_FORWARD || fun == MF_DOT || fun == MF_DISTANCE && false;\n        if vector_only && w == 1 {\n            return self.math_fail(at, name, b\"vectors\", base, n);\n        }\n        if fun == MF_CROSS && (w != 3 || sk != SK_F32) {\n            return self.math_fail(at, name, b\"two vec3<f32>\", base, n);\n        }\n        let mut es: [i64; 4] = [0i64; 4];\n        for i in 0..n {\n            es[i as usize] = self.materialize(self.astack[(base + i) as usize], t,\n                self.apos[(base + i) as usize]);\n        }\n        let rt = if fun == MF_LENGTH || fun == MF_DISTANCE || fun == MF_DOT { sk as i64 }\n            else { t };\n        // constants fold when they are scalars of the simple kind\n        self.math_expr(fun, rt, es, n)\n    }\n\n    fn math_expr(&mut self, fun: i64, ty: i64, es: [i64; 4], n: i64) -> Val {\n        let a = self.f.args.len() as i64;\n        for i in 0..n {\n            self.f.args.push(es[i as usize]);\n        }\n        let e = self.f.expr(E_MATH, ty, fun, a, n);\n        val(e, ty)\n    }\n\n    fn packing(&mut self, fun: i64, name: &[u8], base: i64, at: i64) -> Val {\n        let unpack = fun == ir::MF_UNPACK4X8UNORM || fun == ir::MF_UNPACK2X16FLOAT\n            || fun == ir::MF_UNPACK4X8SNORM || fun == ir::MF_UNPACK2X16UNORM\n            || fun == ir::MF_UNPACK2X16SNORM;\n");
    buf_str(out, c"        let four = fun == ir::MF_PACK4X8UNORM || fun == ir::MF_UNPACK4X8UNORM\n            || fun == ir::MF_PACK4X8SNORM || fun == ir::MF_UNPACK4X8SNORM;\n        let vt = vec_ty(SK_F32, if four { 4 } else { 2 });\n        if unpack {\n            let e0 = self.materialize(self.astack[base as usize], T_U32, self.apos[base as usize]);\n            return self.math_expr(fun, vt, [e0, 0, 0, 0], 1);\n        }\n        let v = self.value(self.astack[base as usize], self.apos[base as usize]);\n        if self.concrete_type_of(v) != vt {\n            return self.math_fail(at, name, if four { b\"a vec4<f32>\" } else { b\"a vec2<f32>\" },\n                base, 1);\n        }\n        let e0 = self.materialize(v, vt, self.apos[base as usize]);\n        self.math_expr(fun, T_U32, [e0, 0, 0, 0], 1)\n    }\n\n    // ---- Textures ----\n\n    fn texture_arg(&mut self, i: i64, sampler: bool) -> i64 {\n        let v = self.astack[i as usize];\n        let want = if sampler { TK_SAMPLER } else { TK_TEXTURE };\n        if v.k != VK_VALUE || self.m.types[v.ty as usize].kind != want {\n            if self.err(self.apos[i as usize], b\"wgsl.type\") {\n                self.emsg.extend_from_slice((if sampler { b\"expected a sampler, got \" }\n                    else { b\"expected a texture, got \" }));\n                self.val_str(v);\n            }\n            return -1;\n        }\n        v.e\n    }\n\n    fn texture_call(&mut self, s: i64, at: i64) -> Val {\n        let base = self.args(-1);\n        let n = self.astack.len() as i64 - base;\n        let r = self.texture_typed(s, base, n, at);\n        self.drop_args(base);\n        r\n    }\n\n    fn texture_typed(&mut self, s: i64, base: i64, n: i64, at: i64) -> Val {\n        let name = self.name_of(s);\n        if n < 1 {\n            self.arg_count_error(at, name, b\"a texture first\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let te = self.texture_arg(base, false);\n        if te < 0 {\n");
    buf_str(out, c"            return cint(SK_AINT, -1, 0);\n        }\n        let tt = self.m.types[self.f.exprs[te as usize].ty as usize];\n        let arrayed = tt.n == TEX_2D_ARRAY;\n        let depth = tt.n == TEX_DEPTH_2D;\n        let storage = tt.n == TEX_STORAGE_2D;\n        let texel = if depth { T_F32 } else { vec_ty(tt.scalar, 4) };\n        if s == K_TEXTURE_DIMENSIONS || s == K_TEXTURE_NUM_LEVELS || s == K_TEXTURE_NUM_LAYERS {\n            if s == K_TEXTURE_NUM_LAYERS && !arrayed {\n                self.fail(at, b\"wgsl.type\", b\"textureNumLayers takes an array texture\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if s == K_TEXTURE_NUM_LEVELS && storage {\n                self.fail(at, b\"wgsl.type\", b\"a storage texture has one level\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let mut lvl: i64 = -1;\n            if s == K_TEXTURE_DIMENSIONS && n == 2 && !storage {\n                let lt = self.int_arg_type(base + 1);\n                lvl = self.materialize(self.astack[(base + 1) as usize], lt,\n                    self.apos[(base + 1) as usize]);\n            } else if n != 1 {\n                self.arg_count_error(at, name, b\"the texture (and for textureDimensions a level)\",\n                    n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let q = if s == K_TEXTURE_DIMENSIONS { IQ_SIZE }\n                else if s == K_TEXTURE_NUM_LEVELS { IQ_LEVELS } else { IQ_LAYERS };\n            let rt = if q == IQ_SIZE { vec_ty(SK_U32, 2) } else { T_U32 };\n            let e = self.f.expr(E_IMAGE_QUERY, rt, te, q, lvl);\n            return val(e, rt);\n        }\n        if s == K_TEXTURE_STORE {\n            if !storage {\n                self.fail(at, b\"wgsl.type\", b\"textureStore writes a texture_storage_2d\");\n                return cint(SK_AINT, -1, 0);\n            }\n            if n != 3 {\n");
    buf_str(out, c"                self.arg_count_error(at, name, b\"3 arguments (texture, coordinates, value)\", n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let ct = self.coords_type(base + 1);\n            let ce = self.materialize(self.astack[(base + 1) as usize], ct,\n                self.apos[(base + 1) as usize]);\n            let ve = self.materialize(self.astack[(base + 2) as usize], texel,\n                self.apos[(base + 2) as usize]);\n            self.push_stmt(S_IMAGE_STORE, te, ce, ve, -1);\n            return Val { k: VK_VOID, sk: 0, e: -1, ty: -1, iv: 0, fv: 0.0 };\n        }\n        if s == K_TEXTURE_LOAD {\n            if storage {\n                self.fail(at, b\"wgsl.unsupported\",\n                    b\"storage textures are write-only in this release\");\n                return cint(SK_AINT, -1, 0);\n            }\n            let want: i64 = if arrayed { 4 } else { 3 };\n            if n != want {\n                self.arg_count_error(at, name,\n                    if arrayed { b\"4 arguments (texture, coordinates, layer, level)\" }\n                    else { b\"3 arguments (texture, coordinates, level)\" }, n);\n                return cint(SK_AINT, -1, 0);\n            }\n            let ct = self.coords_type(base + 1);\n            let a = self.f.args.len() as i64;\n            let ce = self.materialize(self.astack[(base + 1) as usize], ct,\n                self.apos[(base + 1) as usize]);\n            let mut extra: [i64; 2] = [0i64; 2];\n            for i in 2..n {\n                let it = self.int_arg_type(base + i);\n                extra[(i - 2) as usize] = self.materialize(self.astack[(base + i) as usize], it,\n                    self.apos[(base + i) as usize]);\n            }\n            let a2 = self.f.args.len() as i64;\n            let _ = a;\n            self.f.args.push(ce);\n            for i in 2..n {\n                self.f.args.push(extra[(i - 2) as usize]);\n            }\n");
    buf_str(out, c"            let e = self.f.expr(E_IMAGE_LOAD, texel, te, 0, a2);\n            self.f.exprs[e as usize].d = n - 1;\n            return val(e, texel);\n        }\n        // the sampling functions\n        if storage {\n            self.fail(at, b\"wgsl.type\", b\"a storage texture cannot be sampled\");\n            return cint(SK_AINT, -1, 0);\n        }\n        let kind = if s == K_TEXTURE_SAMPLE {\n            IMG_SAMPLE\n        } else if s == K_TEXTURE_SAMPLE_BIAS {\n            IMG_SAMPLE_BIAS\n        } else if s == K_TEXTURE_SAMPLE_LEVEL {\n            IMG_SAMPLE_LEVEL\n        } else if s == K_TEXTURE_SAMPLE_COMPARE {\n            IMG_SAMPLE_COMPARE\n        } else {\n            IMG_SAMPLE_COMPARE_LEVEL\n        };\n        let compare = kind == IMG_SAMPLE_COMPARE || kind == IMG_SAMPLE_COMPARE_LEVEL;\n        if compare != depth && (compare || kind == IMG_SAMPLE_BIAS) {\n            self.fail(at, b\"wgsl.type\",\n                if compare { b\"textureSampleCompare takes a texture_depth_2d\" }\n                else { b\"textureSampleBias takes a texture_2d<f32>\" });\n            return cint(SK_AINT, -1, 0);\n        }\n        if !depth && tt.scalar != SK_F32 {\n            self.fail(at, b\"wgsl.type\",\n                b\"only f32 textures are sampled; use textureLoad for i32 and u32\");\n            return cint(SK_AINT, -1, 0);\n        }\n        if (kind == IMG_SAMPLE || kind == IMG_SAMPLE_BIAS || kind == IMG_SAMPLE_COMPARE)\n            && self.stage != STAGE_FRAGMENT as i64 && self.stage != 255 {\n            if self.err(at, b\"wgsl.stage\") {\n                {\n                    let name = str::from_utf8(name).unwrap();\n                    write(self.emsg, \"'{name}' computes derivatives: it is for fragment shaders\").unwrap();\n                }\n                self.help(b\"use textureSampleLevel elsewhere\");\n            }\n        }\n        let has_aux = kind != IMG_SAMPLE;\n");
    buf_str(out, c"        let want: i64 = 3 + (if arrayed { 1 } else { 0 }) + (if has_aux { 1 } else { 0 });\n        if n != want {\n            self.arg_count_error(at, name, b\"a texture, a sampler, coordinates, then a layer for an array texture and the bias, level or depth reference\", n);\n            return cint(SK_AINT, -1, 0);\n        }\n        let se = self.texture_arg(base + 1, true);\n        if se < 0 {\n            return cint(SK_AINT, -1, 0);\n        }\n        let sm = self.m.types[self.f.exprs[se as usize].ty as usize];\n        if (sm.n == 1) != compare {\n            self.fail(self.apos[(base + 1) as usize], b\"wgsl.type\",\n                if compare { b\"comparisons take a sampler_comparison\" }\n                else { b\"this takes a sampler, not a sampler_comparison\" });\n            return cint(SK_AINT, -1, 0);\n        }\n        let mut es: [i64; 3] = [0i64; 3];\n        es[0] = self.materialize(self.astack[(base + 2) as usize], vec_ty(SK_F32, 2),\n            self.apos[(base + 2) as usize]);\n        let mut k: i64 = 1;\n        if arrayed {\n            let it = self.int_arg_type(base + 3);\n            es[1] = self.materialize(self.astack[(base + 3) as usize], it,\n                self.apos[(base + 3) as usize]);\n            k = 2;\n        }\n        if has_aux {\n            let ai = base + n - 1;\n            let at2 = if kind == IMG_SAMPLE_LEVEL && depth { self.int_arg_type(ai) } else { T_F32 };\n            es[k as usize] = self.materialize(self.astack[ai as usize], at2,\n                self.apos[ai as usize]);\n            k += 1;\n        }\n        let a = self.f.args.len() as i64;\n        for i in 0..k {\n            self.f.args.push(es[i as usize]);\n        }\n        let e = self.f.expr(E_IMAGE_SAMPLE, texel, te, se, a);\n        self.f.exprs[e as usize].d = kind | (k << 8);\n        val(e, texel)\n    }\n\n    // vec2<i32> or vec2<u32>, as the argument has it.\n    fn coords_type(&mut self, i: i64) -> i64 {\n");
    buf_str(out, c"        let v = self.astack[i as usize];\n        let t = self.concrete_type_of(v);\n        if t == vec_ty(SK_U32, 2) || t == vec_ty(SK_I32, 2) {\n            return t;\n        }\n        if self.err(self.apos[i as usize], b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"texel coordinates are a vec2<i32> or vec2<u32>, not \");\n            self.val_str(v);\n        }\n        vec_ty(SK_I32, 2)\n    }\n\n    fn int_arg_type(&mut self, i: i64) -> i64 {\n        let v = self.astack[i as usize];\n        let t = self.concrete_type_of(v);\n        if t == T_U32 || t == T_I32 {\n            return t;\n        }\n        if self.err(self.apos[i as usize], b\"wgsl.type\") {\n            self.emsg.extend_from_slice(b\"expected an i32 or a u32, got \");\n            self.val_str(v);\n        }\n        T_I32\n    }\n}\n\nfn math_arity(fun: i64) -> i64 {\n    if fun == ir::MF_MIN || fun == ir::MF_MAX || fun == ir::MF_POW || fun == ir::MF_ATAN2\n        || fun == ir::MF_STEP || fun == MF_DISTANCE || fun == MF_DOT || fun == MF_CROSS\n        || fun == ir::MF_REFLECT || fun == MF_LDEXP {\n        2\n    }\n    else if fun == ir::MF_CLAMP || fun == ir::MF_MIX || fun == ir::MF_SMOOTHSTEP\n        || fun == ir::MF_FMA || fun == ir::MF_FACE_FORWARD || fun == MF_EXTRACT_BITS {\n        3\n    } else if fun == MF_INSERT_BITS {\n        4\n    } else {\n        1\n    }\n}\n\nfn is_float_fun(fun: i64) -> bool {\n    (fun >= ir::MF_FLOOR && fun <= ir::MF_FMA) || fun == MF_LENGTH || fun == MF_DISTANCE\n        || fun == MF_CROSS || fun == ir::MF_NORMALIZE || fun == ir::MF_REFLECT\n        || fun == ir::MF_DEGREES || fun == ir::MF_RADIANS || fun == ir::MF_SATURATE\n        || fun == ir::MF_ASINH || fun == ir::MF_ACOSH || fun == ir::MF_ATANH\n        || fun == ir::MF_FACE_FORWARD\n}\n\nfn is_int_fun(fun: i64) -> bool { fun >= ir::MF_COUNT_ONE_BITS && fun <= MF_INSERT_BITS }\n// ---- end mod std::gpu::wgsl::builtins ----\n}\n// ---- mod std::gpu::wgsl::entry ----\nmod entry {\n");
    buf_str(out, c"// EDITION: rust\n// ---- Shader compiler implementation, entry (0.22) ----\n// Entry-point interfaces: what each stage's parameters and result may be\n// bound to, and with which types (WGSL §\"Entry Point Declaration\").\n\nuse crate::alloc::Allocator;\n\nuse super::front::Front;\nuse super::ir::{\n    BIND_BUILTIN, BIND_NONE, BI_FRAG_DEPTH, BI_FRONT_FACING, BI_GLOBAL_INVOCATION_ID,\n    BI_INSTANCE_INDEX, BI_LOCAL_INVOCATION_ID, BI_LOCAL_INVOCATION_INDEX, BI_NUM_WORKGROUPS,\n    BI_POSITION, BI_SAMPLE_INDEX, BI_SAMPLE_MASK, BI_VERTEX_INDEX, BI_WORKGROUP_ID, Binding,\n    INTERP_FLAT, SK_BOOL, SK_F32, SK_U32, STAGE_COMPUTE, STAGE_FRAGMENT, STAGE_VERTEX, TK_SCALAR,\n    TK_STRUCT, TK_VECTOR, T_BOOL, T_F32, T_U32, vec_ty,\n};\n\n#[effects()]\npub(crate) fn builtin_name(b: i64) -> &'static [u8] {\n    if b == BI_POSITION {\n        b\"position\"\n    } else if b == BI_VERTEX_INDEX {\n        b\"vertex_index\"\n    } else if b == BI_INSTANCE_INDEX {\n        b\"instance_index\"\n    } else if b == BI_FRONT_FACING {\n        b\"front_facing\"\n    } else if b == BI_FRAG_DEPTH {\n        b\"frag_depth\"\n    } else if b == BI_SAMPLE_INDEX {\n        b\"sample_index\"\n    } else if b == BI_SAMPLE_MASK {\n        b\"sample_mask\"\n    } else if b == BI_LOCAL_INVOCATION_ID {\n        b\"local_invocation_id\"\n    } else if b == BI_LOCAL_INVOCATION_INDEX {\n        b\"local_invocation_index\"\n    } else if b == BI_GLOBAL_INVOCATION_ID {\n        b\"global_invocation_id\"\n    } else if b == BI_WORKGROUP_ID {\n        b\"workgroup_id\"\n    } else {\n        b\"num_workgroups\"\n    }\n}\n\n// The type a builtin has.\n#[effects()]\npub(crate) fn builtin_type(b: i64) -> i64 {\n    if b == BI_POSITION {\n        vec_ty(SK_F32, 4)\n    } else if b == BI_FRONT_FACING {\n        T_BOOL\n    } else if b == BI_FRAG_DEPTH {\n        T_F32\n    }\n    else if b == BI_LOCAL_INVOCATION_ID || b == BI_GLOBAL_INVOCATION_ID || b == BI_WORKGROUP_ID\n        || b == BI_NUM_WORKGROUPS {\n");
    buf_str(out, c"        vec_ty(SK_U32, 3)\n    } else {\n        T_U32\n    }\n}\n\n// Whether builtin b may be an input (or, `output`, an output) of stage.\nfn builtin_allowed(b: i64, stage: u8, output: bool) -> bool {\n    if stage == STAGE_COMPUTE {\n        return !output && b >= BI_LOCAL_INVOCATION_ID;\n    }\n    if stage == STAGE_VERTEX {\n        if output {\n            return b == BI_POSITION;\n        }\n        return b == BI_VERTEX_INDEX || b == BI_INSTANCE_INDEX;\n    }\n    if output {\n        return b == BI_FRAG_DEPTH || b == BI_SAMPLE_MASK;\n    }\n    b == BI_POSITION || b == BI_FRONT_FACING || b == BI_SAMPLE_INDEX || b == BI_SAMPLE_MASK\n}\n\nstruct Seen<A: Allocator> { locs: Vec<i64, A>, builtins: Vec<i64, A>, position: bool }\n\nfn check_binding<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, b: Binding, ty: i64, stage: u8,\n    output: bool, what: &[u8], seen: &mut Seen<A>) {\n    let at = fr.m.functions[fr.m.entries[(fr.m.entries.len() as i64 - 1) as usize].func as usize].pos;\n    if b.kind == BIND_NONE {\n        if fr.err(at, b\"wgsl.entry\") {\n            {\n                let what = str::from_utf8(what).unwrap();\n                write(fr.emsg, \"{what} of an entry point needs '@location(N)' or '@builtin(NAME)'\").unwrap();\n            }\n        }\n        return;\n    }\n    if b.kind == BIND_BUILTIN {\n        if !builtin_allowed(b.value, stage, output) {\n            let io = if output { \"output\" } else { \"input\" };\n            if fr.err(at, b\"wgsl.entry\") {\n                write(fr.emsg, \"'@builtin({})' is not an {io} of a {} shader\",\n                    str::from_utf8(builtin_name(b.value)).unwrap(),\n                    str::from_utf8(stage_name(stage)).unwrap()).unwrap();\n            }\n            return;\n        }\n        if builtin_type(b.value) != ty {\n            if fr.err(at, b\"wgsl.entry\") {\n                write(fr.emsg, \"'@builtin({})' has type \",\n");
    buf_str(out, c"                    str::from_utf8(builtin_name(b.value)).unwrap()).unwrap();\n                fr.ty_str(builtin_type(b.value));\n                fr.emsg.extend_from_slice(b\", not \");\n                fr.ty_str(ty);\n            }\n            return;\n        }\n        for i in 0..seen.builtins.len() as i64 {\n            if seen.builtins[i as usize] == b.value {\n                if fr.err(at, b\"wgsl.entry\") {\n                    write(fr.emsg, \"'@builtin({})' appears twice\",\n                        str::from_utf8(builtin_name(b.value)).unwrap()).unwrap();\n                }\n                return;\n            }\n        }\n        seen.builtins.push(b.value);\n        if b.value == BI_POSITION {\n            seen.position = true;\n        }\n        return;\n    }\n    // a location\n    if stage == STAGE_COMPUTE {\n        if fr.err(at, b\"wgsl.entry\") {\n            fr.emsg.extend_from_slice(b\"a compute shader has no '@location' inputs\");\n        }\n        return;\n    }\n    let t = fr.m.types[ty as usize];\n    if (t.kind != TK_SCALAR && t.kind != TK_VECTOR) || t.scalar == SK_BOOL {\n        if fr.err(at, b\"wgsl.entry\") {\n            write(fr.emsg, \"'@location({})' holds a number or a vector of numbers, not \", b.value).unwrap();\n            fr.ty_str(ty);\n        }\n        return;\n    }\n    let interpolated = (stage == STAGE_VERTEX && output) || (stage == STAGE_FRAGMENT && !output);\n    if interpolated && t.scalar != SK_F32 && b.interp != INTERP_FLAT {\n        if fr.err(at, b\"wgsl.entry\") {\n            write(fr.emsg, \"'@location({})' is an integer: it needs '@interpolate(flat)'\", b.value).unwrap();\n        }\n        return;\n    }\n    for i in 0..seen.locs.len() as i64 {\n        if seen.locs[i as usize] == b.value {\n            if fr.err(at, b\"wgsl.entry\") {\n                write(fr.emsg, \"'@location({})' appears twice\", b.value).unwrap();\n            }\n            return;\n        }\n    }\n");
    buf_str(out, c"    seen.locs.push(b.value);\n}\n\n#[effects()]\npub(crate) fn stage_name(s: u8) -> &'static [u8] {\n    if s == STAGE_VERTEX {\n        b\"vertex\"\n    } else if s == STAGE_FRAGMENT {\n        b\"fragment\"\n    } else {\n        b\"compute\"\n    }\n}\n\n// A parameter or result: a bound value, or a struct of bound members.\nfn check_io<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, b: Binding, ty: i64, stage: u8,\n    output: bool, what: &[u8], seen: &mut Seen<A>) {\n    let t = fr.m.types[ty as usize];\n    if t.kind == TK_STRUCT && b.kind == BIND_NONE {\n        for i in t.mstart..t.mstart + t.mcount {\n            let mem = fr.m.members[i as usize];\n            if fr.m.types[mem.ty as usize].kind == TK_STRUCT {\n                let at = fr.m.functions[\n                    fr.m.entries[(fr.m.entries.len() as i64 - 1) as usize].func as usize].pos;\n                fr.fail(at, b\"wgsl.entry\", b\"an entry point's IO struct cannot nest structs\");\n                return;\n            }\n            check_binding(fr, mem.binding, mem.ty, stage, output, b\"a member of an IO struct\",\n                seen);\n        }\n        return;\n    }\n    check_binding(fr, b, ty, stage, output, what, seen);\n}\n\n#[effects(panic, A)]\npub(crate) fn check_interface<'a, A: Allocator + Copy>(fr: &mut Front<'a, A>, ei: i64) {\n    let stage = fr.m.entries[ei as usize].stage;\n    let fh = fr.m.entries[ei as usize].func;\n    let pos = fr.m.functions[fh as usize].pos;\n    let mut ins = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n    for i in 0..fr.m.functions[fh as usize].params.len() as i64 {\n        let b = fr.m.functions[fh as usize].params[i as usize].binding;\n        let t = fr.m.functions[fh as usize].params[i as usize].ty;\n        check_io(fr, b, t, stage, false, b\"a parameter\", &mut ins);\n    }\n    let mut outs = Seen { locs: Vec::new_in(fr.a), builtins: Vec::new_in(fr.a), position: false };\n");
    buf_str(out, c"    let result = fr.m.functions[fh as usize].result;\n    if result >= 0 {\n        if stage == STAGE_COMPUTE {\n            fr.fail(pos, b\"wgsl.entry\", b\"a compute shader returns nothing\");\n            return;\n        }\n        let rb = fr.m.functions[fh as usize].result_binding;\n        check_io(fr, rb, result, stage, true, b\"the result\", &mut outs);\n    }\n    if stage == STAGE_VERTEX && !outs.position && !fr.failed {\n        fr.fail(pos, b\"wgsl.entry\", b\"a vertex shader returns '@builtin(position)' (a vec4<f32>)\");\n        fr.help(b\"for example: fn vs(...) -> @builtin(position) vec4<f32>\");\n    }\n}\n// ---- end mod std::gpu::wgsl::entry ----\n}\n// ---- mod std::gpu::wgsl::uniformity ----\npub mod uniformity {\n// EDITION: rust\n// ---- Shader compiler implementation, uniformity (0.22) ----\n// The uniformity analysis.\n\nuse crate::alloc::Allocator;\n\nuse super::front::Front;\n\n#[effects()]\npub fn check<A: Allocator + Copy>(fr: &Front<'_, A>) {\n}\n// ---- end mod std::gpu::wgsl::uniformity ----\n}\n// ---- end mod std::gpu::wgsl ----\n}\n// ---- end mod std::gpu ----\n}\n// ---- mod std::test ----\npub mod test {\n// EDITION: rust\n// std::test: what `#[property]` tests and `#[fuzz]` targets draw their\n// values from, and the runtime of a test build (0.28.0: MVS's\n// compiler/std/flat/test.vl and fuzz.vl in std2's spellings). `volec\n// test` builds the program with `--test-build`: the compiler\n// (front/tests) writes a `main` that runs the test its arguments name,\n// and a generator for each property's parameters, built from their types\n// (an `impl Arbitrary` where there is one). A value is drawn from a\n// choice sequence of u64s, and smaller choices make simpler values (0: 0,\n// false, empty, None, the first variant): a failing case is shrunk by\n// shortening and lowering its sequence, then replaying it.\n//\n// A program names Arbitrary, Gen and assert_snapshot; the rest is what\n");
    buf_str(out, c"// the compiler's test code calls (test_begin, run_property, ...). A\n// property's cases each run in a child process (fork), one at a time, on\n// the runner's one thread: the runtime's statics are that thread's.\n// mvs: std::Arbitrary, std::Gen, std::assert_snapshot\n\nuse crate::alloc::{Allocator, Gpa};\nuse crate::fmt::Debug;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// A type's own generator, used in place of the structural one.\npub trait Arbitrary {\n    fn arbitrary(g: &mut Gen<Gpa>) -> Self;\n}\n\n// A case's choices and where it is in them.\n// std2: changed: the choices are the Gen's own Vec (MVS: a view)\npub struct Gen<A: Allocator> {\n    choices: Vec<u64, A>,\n    at: usize,\n    size: usize,\n    gpa: A,\n    depth: usize,\n    showing: bool,\n    report: i32,\n    raw: bool,\n}\n\nimpl Gen<Gpa> {\n    // An integer: 0, -1, 1, -2, 2, ... as the choice grows (the edges,\n    // i64::MIN and i64::MAX, are the largest choices).\n    pub fn int(&mut self) -> i64 {\n        let c = self.draw();\n        ((c >> 1) as i64) ^ -((c & 1) as i64)\n    }\n\n    // An integer in lo..=hi (lo first).\n    pub fn int_in(&mut self, lo: i64, hi: i64) -> i64 {\n        let c = self.draw();\n        if hi <= lo {\n            return lo;\n        }\n        let span = (hi - lo) as u64 + 1;\n        if span == 0 {\n            return lo + c as i64;\n        }\n        lo + (c % span) as i64\n    }\n\n    // One of 0..n.\n    // std2: changed: usize\n    pub fn choose(&mut self, n: usize) -> usize {\n        let c = self.draw();\n        if n <= 1 { 0 } else { (c % n as u64) as usize }\n    }\n\n    pub fn bool(&mut self) -> bool {\n        self.draw() % 2 == 1\n    }\n\n    // The size this case may grow to (it grows with the case number).\n    // std2: changed: usize\n    pub fn size(&mut self) -> usize {\n        self.size\n    }\n\n    // A text byte: letters and digits first, then spaces, punctuation,\n");
    buf_str(out, c"    // newlines and the rest.\n    pub fn text_byte(&mut self) -> u8 {\n        let c = self.draw();\n        let common = \"abcdefghijklmnopqrstuvwxyz0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ\\n.,-_:;()+*/=\"\n            .as_bytes();\n        if c < 200 {\n            return common[(c % common.len() as u64) as usize];\n        }\n        (c % 256) as u8\n    }\n\n    // A text character: text_byte's, ASCII only.\n    pub fn text_char(&mut self) -> char {\n        let b = self.text_byte();\n        if b < 128 { b as char } else { (b'a' + b % 26) as char }\n    }\n\n    // The next choice: 0 past the end of the sequence (the simplest).\n    pub fn draw(&mut self) -> u64 {\n        let k = self.at;\n        self.at += 1;\n        if k >= self.choices.len() {\n            return 0;\n        }\n        self.choices[k]\n    }\n\n    // Whether a collection of `len` elements gets one more.\n    // std2: changed: usize\n    pub fn more(&mut self, len: usize) -> bool {\n        if len >= self.size || self.depth > 4 {\n            return false;\n        }\n        self.draw() % 4 != 0\n    }\n\n    // How deep a recursive type's generator is.\n    // std2: changed: usize\n    pub fn depth(&mut self) -> usize {\n        self.depth\n    }\n\n    // The allocator generated containers use.\n    pub fn gpa(&mut self) -> Gpa {\n        self.gpa\n    }\n\n    // Whether this run is the replay of a failure (its inputs printed).\n    pub fn showing(&mut self) -> bool {\n        self.showing\n    }\n\n    // The choices used so far, told to the runner (the generators are\n    // done; the property runs next).\n    pub fn generated(&mut self) {\n        if self.report >= 0 {\n            let used = i64_bytes(self.at as i64);\n            let _ = crate::io::sys_write(self.report, &used);\n            close(self.report);\n            self.report = -1;\n        }\n    }\n\n    // A recursive type's generator goes one level down (shallower values\n    // past a depth).\n");
    buf_str(out, c"    pub fn enter(&mut self) {\n        self.depth += 1;\n    }\n\n    pub fn leave(&mut self) {\n        self.depth -= 1;\n    }\n}\n\n// The generator of T: its `impl Arbitrary` (std's for the numbers and\n// bool, the compiler's for a test's structs and enums).\npub fn arbitrary_of<T: Arbitrary>(g: &mut Gen<Gpa>) -> T {\n    T::arbitrary(g)\n}\n\npub fn gen_vec<T, F: Fn(&mut Gen<Gpa>) -> T>(g: &mut Gen<Gpa>, f: F) -> Vec<T, Gpa> {\n    let mut v: Vec<T, Gpa> = Vec::new_in(g.gpa);\n    g.enter();\n    while g.more(v.len()) {\n        v.push(f(g));\n    }\n    g.leave();\n    v\n}\n\npub fn gen_option<T, F: Fn(&mut Gen<Gpa>) -> T>(g: &mut Gen<Gpa>, f: F) -> Option<T> {\n    if g.draw() % 2 == 0 { Option::None } else { Option::Some(f(g)) }\n}\n\npub fn gen_result<T, E, F: Fn(&mut Gen<Gpa>) -> T, G: Fn(&mut Gen<Gpa>) -> E>(g: &mut Gen<Gpa>,\n    f: F, e: G) -> Result<T, E> {\n    if g.draw() % 2 == 0 { Result::Ok(f(g)) } else { Result::Err(e(g)) }\n}\n\n// Text, as bytes.\npub fn gen_text(g: &mut Gen<Gpa>) -> Vec<u8, Gpa> {\n    let mut v: Vec<u8, Gpa> = Vec::new_in(g.gpa);\n    while g.more(v.len()) {\n        v.push(g.text_byte());\n    }\n    v\n}\n\n// Text, as a String (a `&str` or `String` parameter).\npub fn gen_string(g: &mut Gen<Gpa>) -> String<Gpa> {\n    let mut s: String<Gpa> = String::new_in(g.gpa);\n    while g.more(s.len()) {\n        s.push(g.text_char());\n    }\n    s\n}\n\npub fn gen_f64(g: &mut Gen<Gpa>) -> f64 {\n    let c = g.draw();\n    if c < 6 {\n        let edges = [0.0, 1.0, -1.0, -0.0, 1.0 / 0.0, -1.0 / 0.0];\n        return edges[c as usize];\n    }\n    let n = ((c >> 1) as i64) ^ -((c & 1) as i64);\n    (n as f64) / 8.0\n}\n\n// An input's bytes: all of them when the choices are an input's\n// (fuzzing, a saved input), else a generated text of bytes.\npub fn gen_bytes(g: &mut Gen<Gpa>) -> Vec<u8, Gpa> {\n    let mut v: Vec<u8, Gpa> = Vec::new_in(g.gpa);\n    if g.raw {\n        while g.at < g.choices.len() {\n");
    buf_str(out, c"            v.push(g.draw() as u8);\n        }\n        return v;\n    }\n    while g.more(v.len()) {\n        v.push(g.draw() as u8);\n    }\n    v\n}\n\nimpl Arbitrary for i64 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i64 { g.int() }\n}\n\nimpl Arbitrary for i32 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i32 { g.int() as i32 }\n}\n\nimpl Arbitrary for i16 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i16 { g.int() as i16 }\n}\n\nimpl Arbitrary for i8 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> i8 { g.int() as i8 }\n}\n\nimpl Arbitrary for u64 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u64 { g.draw() }\n}\n\nimpl Arbitrary for usize {\n    fn arbitrary(g: &mut Gen<Gpa>) -> usize { g.draw() as usize }\n}\n\nimpl Arbitrary for isize {\n    fn arbitrary(g: &mut Gen<Gpa>) -> isize { g.int() as isize }\n}\n\nimpl Arbitrary for u32 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u32 { g.draw() as u32 }\n}\n\nimpl Arbitrary for u16 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u16 { g.draw() as u16 }\n}\n\nimpl Arbitrary for u8 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> u8 { g.draw() as u8 }\n}\n\nimpl Arbitrary for bool {\n    fn arbitrary(g: &mut Gen<Gpa>) -> bool { g.bool() }\n}\n\nimpl Arbitrary for f64 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> f64 { gen_f64(g) }\n}\n\nimpl Arbitrary for f32 {\n    fn arbitrary(g: &mut Gen<Gpa>) -> f32 { gen_f64(g) as f32 }\n}\n\nimpl Arbitrary for char {\n    fn arbitrary(g: &mut Gen<Gpa>) -> char { g.text_char() }\n}\n\n// x's `{:?}` text against tests/snapshots/MODULE__TEST__N.snap: a missing\n// file is written (a new snapshot, the test passes), a different one\n// fails with its first differing line; `volec test --accept` writes\n// the current text.\n// std2: changed: the text and the file are read into 64 KiB on the stack\n// (no allocator: a larger one fails)\npub fn assert_snapshot<T: Debug>(x: T) {\n    let mut s = state();\n    s.snap_count += 1;\n    set_state(s);\n    let mut text = Snap::new();\n    let _ = crate::fmt::write(&mut text, \"{x:?}\");\n");
    buf_str(out, c"    text.put(b\"\\n\");\n    let mut path = Short::new();\n    let mut shown = Short::new();\n    if s.snapshots_set {\n        path.put(s.snapshots.as_bytes());\n        path.put(b\"/\");\n    } else {\n        path.put(b\"tests/\");\n    }\n    shown.put(b\"tests/\");\n    // (the tests directory, then its snapshots/; an existing one kept)\n    let _ = crate::fs::create_dir(path.text());\n    path.put(b\"snapshots\");\n    let _ = crate::fs::create_dir(path.text());\n    let mut file = Short::new();\n    file.put(b\"/\");\n    let module = s.module.as_bytes();\n    let mut i: usize = 0;\n    while i < module.len() {\n        if module[i] == b':' {\n            file.put(b\"__\");\n            i += 2;\n        } else {\n            file.put(&module[i..i + 1]);\n            i += 1;\n        }\n    }\n    if module.len() > 0 {\n        file.put(b\"__\");\n    }\n    file.put(s.name.as_bytes());\n    file.put(b\"__\");\n    let n = s.snap_count;\n    let _ = crate::fmt::write(&mut file, \"{n}\");\n    file.put(b\".snap\");\n    path.put(file.bytes());\n    shown.put(b\"snapshots\");\n    shown.put(file.bytes());\n    if text.over || path.over || shown.over {\n        crate::fmt::eprintln(\"snapshot {}: over 64 KiB, or its path over 1 KiB\", shown.text());\n        c_exit(101);\n    }\n    let mut old = Snap::new();\n    let had = old.read(path.text());\n    if had && old.bytes() == text.bytes() {\n    } else if !had || s.accept {\n        if crate::fs::write(path.text(), text.bytes()).is_err() {\n            crate::fmt::eprintln(\"snapshot {}: cannot write {}\", shown.text(), path.text());\n            c_exit(101);\n        }\n        crate::fmt::println(\"vole-test: snapshot {} {}\", if had { \"accepted\" } else { \"new\" },\n            shown.text());\n    } else {\n        let mut k: usize = 0;\n        while line_of(old.bytes(), k) == line_of(text.bytes(), k) {\n            k += 1;\n        }\n");
    buf_str(out, c"        crate::fmt::eprintln(\"snapshot differs: {} line {}: '{}' expected, got '{}'\",\n            shown.text(), k + 1, text_of(line_of(old.bytes(), k)),\n            text_of(line_of(text.bytes(), k)));\n        c_exit(101);\n    }\n}\n\n// A snapshot's text, or a file's: 64 KiB at most (`over` past it).\nstruct Snap {\n    len: usize,\n    over: bool,\n    buf: [u8; 65536],\n}\n\nimpl Snap {\n    fn new() -> Snap {\n        Snap { len: 0, over: false, buf: [0; 65536] }\n    }\n\n    fn put(&mut self, b: &[u8]) {\n        let mut i: usize = 0;\n        while i < b.len() {\n            if self.len == 65536 {\n                self.over = true;\n                return;\n            }\n            self.buf[self.len] = b[i];\n            self.len += 1;\n            i += 1;\n        }\n    }\n\n    fn bytes(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    // The file at path, its first 64 KiB; false when it cannot be opened.\n    fn read(&mut self, path: &str) -> bool {\n        let mut f = match crate::fs::File::open(path) {\n            Result::Ok(f) => f,\n            Result::Err(_) => return false,\n        };\n        loop {\n            if self.len == 65536 {\n                self.over = true;\n                return true;\n            }\n            let at = self.len;\n            match crate::io::Read::read(&mut f, &mut self.buf[at..]) {\n                Result::Ok(0) => return true,\n                Result::Ok(n) => self.len += n,\n                Result::Err(_) => return true,\n            }\n        }\n    }\n}\n\nimpl crate::fmt::Write for Snap {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.put(s.as_bytes());\n        Result::Ok(())\n    }\n}\n\n// A path: 1 KiB at most.\nstruct Short {\n    len: usize,\n    over: bool,\n    buf: [u8; 1024],\n}\n\nimpl Short {\n    fn new() -> Short {\n        Short { len: 0, over: false, buf: [0; 1024] }\n    }\n\n    fn put(&mut self, b: &[u8]) {\n        let mut i: usize = 0;\n");
    buf_str(out, c"        while i < b.len() {\n            if self.len == 1024 {\n                self.over = true;\n                return;\n            }\n            self.buf[self.len] = b[i];\n            self.len += 1;\n            i += 1;\n        }\n    }\n\n    fn bytes(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    fn text(&self) -> &str {\n        text_of(self.bytes())\n    }\n}\n\nimpl crate::fmt::Write for Short {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        self.put(s.as_bytes());\n        Result::Ok(())\n    }\n}\n\n// ---- The test runtime (the compiler's test code calls these) ----\n\n// UNSAFE: C functions std has no safe form of: fork, pipe, dup2, close,\n// open, waitpid, atexit, _exit.\n// SAFETY: the prototypes are unistd.h's, fcntl.h's, sys/wait.h's and\n// stdlib.h's (open variadic, as declared); each call says why it is\n// sound.\nextern \"C\" {\n    #[link_name = \"fork\"]\n    fn test_c_fork() -> i32;\n    #[link_name = \"pipe\"]\n    fn test_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"dup2\"]\n    fn test_c_dup2(fd: i32, to: i32) -> i32;\n    #[link_name = \"close\"]\n    fn test_c_close(fd: i32) -> i32;\n    #[link_name = \"open\"]\n    fn test_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"waitpid\"]\n    fn test_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"atexit\"]\n    fn test_c_atexit(f: extern \"C\" fn()) -> i32;\n    #[link_name = \"_exit\"]\n    fn test_c_exit_now(code: i32) -> !;\n}\n\n// What `volec test` passes to a test binary (`--vole-test NAME`, else\n// `--vole-list`; `--cases N`, `--seed S`, `--snapshots DIR`, `--accept`;\n// for fuzzing `--fuzz-time S`, `--fuzz-dir DIR`, `--replay FILE`\n// repeated), and the test being run. The strings are views of argv's,\n// which live as long as the process.\n#[derive(Clone, Copy)]\nstruct TestState {\n    cases: usize,\n    seed: u64,\n    seed_set: bool,\n    snapshots: &'static str,\n");
    buf_str(out, c"    snapshots_set: bool,\n    accept: bool,\n    module: &'static str,\n    name: &'static str,\n    snap_count: usize,\n    fuzz_time: u64,\n    fuzz_dir: &'static str,\n    fuzz_dir_set: bool,\n    replays: usize,\n    // (whether the choices are an input's bytes)\n    raw: bool,\n    // (a test that ends the process, a failed check, ends it at once: the\n    // leaks it leaves are not listed after its failure)\n    running: bool,\n    handler: bool,\n    exit_code: i32,\n    fuzz_words: usize,\n}\n\nstatic mut TEST_STATE: TestState = TestState {\n    cases: 100,\n    seed: 0,\n    seed_set: false,\n    snapshots: \"\",\n    snapshots_set: false,\n    accept: false,\n    module: \"\",\n    name: \"\",\n    snap_count: 0,\n    fuzz_time: 0,\n    fuzz_dir: \"\",\n    fuzz_dir_set: false,\n    replays: 0,\n    raw: false,\n    running: false,\n    handler: false,\n    exit_code: 101,\n    fuzz_words: 0,\n};\nstatic mut TEST_REPLAY: [&'static str; 256] = [\"\"; 256];\n// (the program's text constants a mutation may put in an input: the\n// compiler gives them, front/tests)\nstatic mut FUZZ_WORDS: [&'static [u8]; 64] = [b\"\"; 64];\n\nfn state() -> TestState {\n    // UNSAFE: a static mut, read by value.\n    // SAFETY: the runtime runs on the runner's one thread (a forked case\n    // has its own copy); nothing borrows the static.\n    unsafe { TEST_STATE }\n}\n\nfn set_state(s: TestState) {\n    // UNSAFE: a static mut, written by value. SAFETY: as state's.\n    unsafe {\n        TEST_STATE = s;\n    }\n}\n\nfn replay(k: usize) -> &'static str {\n    // UNSAFE: a static mut's element, read by value. SAFETY: as state's;\n    // k < 256 is checked by the index.\n    unsafe { TEST_REPLAY[k] }\n}\n\nfn fuzz_word_at(k: usize) -> &'static [u8] {\n    // UNSAFE: a static mut's element, read by value. SAFETY: as state's;\n    // the index is checked.\n    unsafe { FUZZ_WORDS[k] }\n}\n\n// The exit status of a property case whose `requires` failed (discarded).\n");
    buf_str(out, c"const DISCARD: i32 = 77;\n\n// i64 <-> its 8 bytes (little-endian), for what a case reports on its pipe.\nfn i64_bytes(x: i64) -> [u8; 8] {\n    let mut b: [u8; 8] = [0; 8];\n    let mut k: usize = 0;\n    while k < 8 {\n        b[k] = ((x >> (8 * k)) & 255) as u8;\n        k += 1;\n    }\n    b\n}\n\nfn bytes_i64(b: [u8; 8]) -> i64 {\n    let mut x: i64 = 0;\n    let mut k: usize = 0;\n    while k < 8 {\n        x = x | ((b[k] as i64) << (8 * k));\n        k += 1;\n    }\n    x\n}\n\nfn number(t: &str) -> u64 {\n    let s = t.as_bytes();\n    let mut n: u64 = 0;\n    let mut i: usize = 0;\n    let mut base: u64 = 10;\n    if s.len() > 2 && s[0] == b'0' && (s[1] == b'x' || s[1] == b'X') {\n        base = 16;\n        i = 2;\n    }\n    while i < s.len() {\n        let c = s[i];\n        let d = if c >= b'0' && c <= b'9' { (c - b'0') as u64 }\n            else if c >= b'a' && c <= b'f' { (c - b'a') as u64 + 10 }\n            else if c >= b'A' && c <= b'F' { (c - b'A') as u64 + 10 }\n            else { 99 };\n        if d >= base {\n            break;\n        }\n        n = n * base + d;\n        i += 1;\n    }\n    n\n}\n\n// A test binary's arguments: the test to run (empty: list them).\npub fn test_args() -> &'static str {\n    let mut s = state();\n    let mut name: &'static str = \"\";\n    let mut args = crate::env::args();\n    let _ = args.next();\n    let mut next = args.next();\n    loop {\n        let a = match next {\n            Option::Some(x) => x,\n            Option::None => break,\n        };\n        let after = args.next();\n        let has_value = after.is_some();\n        let value = after.unwrap_or(\"\");\n        // (whether the flag took `value`)\n        let mut took = has_value;\n        if a == \"--vole-test\" && has_value {\n            name = value;\n        } else if a == \"--cases\" && has_value {\n            s.cases = number(value) as usize;\n        } else if a == \"--seed\" && has_value {\n            s.seed = number(value);\n");
    buf_str(out, c"            s.seed_set = true;\n        } else if a == \"--snapshots\" && has_value {\n            s.snapshots = value;\n            s.snapshots_set = true;\n        } else if a == \"--fuzz-time\" && has_value {\n            s.fuzz_time = number(value);\n        } else if a == \"--fuzz-dir\" && has_value {\n            s.fuzz_dir = value;\n            s.fuzz_dir_set = true;\n        } else if a == \"--replay\" && has_value {\n            if s.replays < 256 {\n                // UNSAFE: a static mut's element, written by value. SAFETY:\n                // as state's; s.replays < 256.\n                unsafe {\n                    TEST_REPLAY[s.replays] = value;\n                }\n                s.replays += 1;\n            }\n        } else {\n            if a == \"--accept\" {\n                s.accept = true;\n            }\n            took = false;\n        }\n        next = if took { args.next() } else { after };\n    }\n    set_state(s);\n    name\n}\n\n// A test of module `module` (its path, `a::tests`) starts.\npub fn test_begin(module: &'static str, name: &'static str, gpa: Gpa) {\n    let mut s = state();\n    s.module = module;\n    s.name = name;\n    s.snap_count = 0;\n    set_state(s);\n    // (an allocation first: --check-alloc's handler at exit is then\n    // registered before at_exit, which runs before it)\n    let mut first: Vec<u8, Gpa> = Vec::new_in(gpa);\n    first.push(0);\n    crate::mem::drop(first);\n    running();\n}\n\n// C's exit: the atexit handlers run (at_exit, --check-alloc's), as a\n// test's end has always been.\nfn c_exit(code: i32) -> ! {\n    crate::process::exit(code)\n}\n\n// C's _exit: the process ends at once, no atexit handler.\nfn quit(code: i32) -> ! {\n    // UNSAFE: C's _exit, a C call.\n    // SAFETY: any int is a valid status; it does not return and touches\n    // no vole state.\n    unsafe { test_c_exit_now(code) }\n}\n\nextern \"C\" fn at_exit() {\n    let s = state();\n    if s.running {\n");
    buf_str(out, c"        quit(s.exit_code);\n    }\n}\n\n// This process ends with `code`, before --check-alloc lists what it\n// leaves allocated (a runner's, not the test's).\nfn exit_with(code: i32) -> ! {\n    running();\n    let mut s = state();\n    s.exit_code = code;\n    set_state(s);\n    c_exit(code)\n}\n\nfn running() {\n    let mut s = state();\n    if !s.handler {\n        // UNSAFE: C's atexit, a C call taking a function pointer.\n        // SAFETY: at_exit is an `extern \"C\" fn()` that lives as long as\n        // the program; `handler` registers it once (atexit's limit is 32\n        // or more).\n        unsafe {\n            test_c_atexit(at_exit);\n        }\n        s.handler = true;\n    }\n    s.running = true;\n    set_state(s);\n}\n\n// A #[test] returned.\npub fn test_done() {\n    let mut s = state();\n    s.running = false;\n    set_state(s);\n}\n\n// A test left blocks allocated (with --check-alloc, which test builds\n// use; they are listed): it fails.\npub fn test_leaked() -> ! {\n    c_exit(101)\n}\n\n// A `#[test]` that returned Err(e): the error, exit 101.\npub fn test_err<E: Debug>(e: E) -> ! {\n    crate::fmt::eprintln(\"test returned Err({e:?})\");\n    c_exit(101)\n}\n\npub fn test_unknown(name: &str) -> i32 {\n    crate::fmt::eprintln(\"no test '{name}' in this program (--vole-list lists them)\");\n    2\n}\n\n// A property case whose `requires` does not hold: not a failure.\npub fn test_discard() -> ! {\n    quit(DISCARD)\n}\n\n// The line that begins an input's value, when a failure is replayed.\npub fn test_input(name: &str) {\n    crate::fmt::print(\"vole-test: input {name} = \");\n}\n\npub fn test_input_end() {\n    crate::fmt::println(\"\");\n}\n\n// The choices of a case (splitmix64 from the state): mostly small, some\n// edges, some anything.\nfn next_of(st: &mut u64) -> u64 {\n    *st = st.wrapping_add(0x9e3779b97f4a7c15);\n    let mut z = *st;\n    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n");
    buf_str(out, c"    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n    z ^ (z >> 31)\n}\n\nfn choice(st: &mut u64, size: usize) -> u64 {\n    let r = next_of(st);\n    let pick = r % 20;\n    if pick == 0 {\n        // (the edges: i64::MIN, i64::MAX, u64::MAX, a byte's)\n        let e = next_of(st) % 5;\n        return if e == 0 { 0xffffffffffffffff } else if e == 1 { 0xfffffffffffffffe }\n            else if e == 2 { 255 } else if e == 3 { 256 } else { 0x8000000000000000 };\n    }\n    if pick < 3 {\n        return next_of(st);\n    }\n    next_of(st) % (2 * size as u64 + 4)\n}\n\nfn seed_of(name: &str) -> u64 {\n    let s = state();\n    if s.seed_set {\n        return s.seed;\n    }\n    let b = name.as_bytes();\n    let mut h: u64 = 14695981039346656037;\n    let mut i: usize = 0;\n    while i < b.len() {\n        h = (h ^ b[i] as u64).wrapping_mul(1099511628211);\n        i += 1;\n    }\n    h\n}\n\n#[derive(Clone, Copy)]\nstruct CaseRun {\n    status: i32,\n    used: usize,\n}\n\nfn close(fd: i32) {\n    // UNSAFE: C's close. SAFETY: any int; a bad fd is an error, ignored.\n    unsafe {\n        test_c_close(fd);\n    }\n}\n\n// A pipe, (read end, write end); none stops the runner (exit 2).\nfn pipe() -> (i32, i32) {\n    let mut fds: [i32; 2] = [0, 0];\n    // UNSAFE: C's pipe. SAFETY: fds is two writable i32s.\n    let r = unsafe { test_c_pipe(&mut fds[0] as *mut i32) };\n    if r != 0 {\n        crate::fmt::eprintln(\"vole-test: cannot make a pipe\");\n        c_exit(2);\n    }\n    (fds[0], fds[1])\n}\n\n// fork(2): 0 in the child, the child's pid in the parent.\nfn fork() -> i32 {\n    // UNSAFE: fork is a C call std has no safe form of: the child is a\n    // copy of this process.\n    // SAFETY: the runner forks from its one thread (a property's cases run\n    // one at a time, the runner starts no thread), so the child's copy of\n    // every lock and buffer is consistent; the child runs one case and\n");
    buf_str(out, c"    // ends with _exit (quit), never returning into the runner.\n    unsafe { test_c_fork() }\n}\n\n// A case's stdout and stderr to /dev/null.\nfn quiet() {\n    // UNSAFE: C's open, dup2 and close.\n    // SAFETY: the path is a NUL-ended literal; O_WRONLY is 1 on both\n    // systems; the fds are ints, a bad one an error.\n    unsafe {\n        let null = test_c_open(\"/dev/null\\0\".as_ptr(), 1);\n        if null >= 0 {\n            test_c_dup2(null, 1);\n            test_c_dup2(null, 2);\n            test_c_close(null);\n        }\n    }\n}\n\n// The 8 bytes of an i64 a child reports on fd; -1 when it reports nothing.\nfn read_i64(fd: i32) -> i64 {\n    let mut b: [u8; 8] = [0; 8];\n    match crate::io::sys_read(fd, &mut b) {\n        Result::Ok(n) => if n == 8 { bytes_i64(b) } else { -1 },\n        Result::Err(_) => -1,\n    }\n}\n\n// Waits for child pid: its exit code, 128 + the signal that ended it.\nfn wait(pid: i32) -> i32 {\n    let mut st: i32 = 0;\n    // UNSAFE: C's waitpid. SAFETY: st is a writable i32.\n    let r = unsafe { test_c_waitpid(pid, &mut st as *mut i32, 0) };\n    if r < 0 {\n        return 0;\n    }\n    if (st & 127) == 0 { (st >> 8) & 255 } else { 128 + (st & 127) }\n}\n\nfn fails(r: CaseRun) -> bool {\n    r.status != 0 && r.status != DISCARD\n}\n\n// The case's values are dropped by the time f returns, so a block it\n// allocated and left is a leak (--check-alloc): it fails.\nfn run_case<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>) {\n    let mark = crate::__gpa::check_alloc_mark();\n    f(g);\n    if crate::__gpa::check_alloc_leaks_since(mark) > 0 {\n        quit(101);\n    }\n}\n\nfn copy_of(gpa: Gpa, v: &Vec<u64, Gpa>) -> Vec<u64, Gpa> {\n    let mut c: Vec<u64, Gpa> = Vec::new_in(gpa);\n    c.extend_from_slice(v.as_slice());\n    c\n}\n\n// The runner's Gen, which each case's child takes as its own copy: no\n// allocation for it (a case's block numbers are its own allocations').\nfn runner_gen(gpa: Gpa) -> Gen<Gpa> {\n    Gen {\n");
    buf_str(out, c"        choices: Vec::new_in(gpa), at: 0, size: 0, gpa: gpa, depth: 0, showing: false, report: -1,\n        raw: false,\n    }\n}\n\n// Runs one case in a child process: its exit status (0 passed, DISCARD\n// discarded, else failed) and the choices it used. The choices are g's\n// for the run (swapped in and back).\nfn case<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, choices: &mut Vec<u64, Gpa>, size: usize,\n    quiet_run: bool) -> CaseRun {\n    let n = choices.len();\n    let (rd, wr) = pipe();\n    crate::mem::swap(&mut g.choices, choices);\n    let pid = fork();\n    if pid == 0 {\n        close(rd);\n        if quiet_run {\n            quiet();\n        }\n        running();\n        g.at = 0;\n        g.size = size;\n        g.depth = 0;\n        g.showing = !quiet_run;\n        g.report = wr;\n        g.raw = state().raw;\n        run_case(f, g);\n        quit(0);\n    }\n    crate::mem::swap(&mut g.choices, choices);\n    close(wr);\n    let used = read_i64(rd);\n    close(rd);\n    CaseRun { status: wait(pid), used: if used >= 0 { used as usize } else { n } }\n}\n\n// Candidate `c` replaces `best` when it fails too (cut to what it used).\nfn attempt<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, best: &mut Vec<u64, Gpa>,\n    c: &mut Vec<u64, Gpa>, size: usize, steps: &mut usize) -> bool {\n    let r = case(f, g, c, size, true);\n    if !fails(r) {\n        return false;\n    }\n    *steps += 1;\n    best.clear();\n    let n = if r.used < c.len() { r.used } else { c.len() };\n    let mut i: usize = 0;\n    while i < n {\n        best.push(c[i]);\n        i += 1;\n    }\n    true\n}\n\n// The failing choices `best` made smaller: chunks deleted, choices set to\n// zero, halved, lowered by one, neighbours put in order; to a fixpoint (or\n// 2000 candidates).\nfn shrink<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, best: &mut Vec<u64, Gpa>, size: usize)\n    -> usize {\n    let mut steps: usize = 0;\n    let mut tries: usize = 0;\n");
    buf_str(out, c"    let mut c: Vec<u64, Gpa> = Vec::new_in(g.gpa);\n    let mut changed = true;\n    let chunks: [usize; 4] = [8, 4, 2, 1];\n    while changed && tries < 2000 {\n        changed = false;\n        let mut ki: usize = 0;\n        while ki < 4 {\n            let k = chunks[ki];\n            ki += 1;\n            if best.len() < k {\n                continue;\n            }\n            let mut i = (best.len() - k) as i64;\n            while i >= 0 && tries < 2000 {\n                c.clear();\n                let mut j: usize = 0;\n                while j < best.len() {\n                    if (j as i64) < i || j as i64 >= i + k as i64 {\n                        c.push(best[j]);\n                    }\n                    j += 1;\n                }\n                tries += 1;\n                if attempt(f, g, best, &mut c, size, &mut steps) {\n                    changed = true;\n                }\n                i -= 1;\n                let top = best.len() as i64 - k as i64;\n                if i > top {\n                    i = top;\n                }\n            }\n        }\n        let mut i: usize = 0;\n        while i < best.len() && tries < 2000 {\n            // lowered: to 0, else the smallest that still fails, by halves\n            let mut lo: u64 = 0;\n            let mut first = true;\n            while i < best.len() && best[i] > lo && tries < 2000 {\n                let v = best[i];\n                let w = if first { 0 } else { lo + (v - lo) / 2 };\n                first = false;\n                c.clear();\n                let mut j: usize = 0;\n                while j < best.len() {\n                    c.push(if j == i { w } else { best[j] });\n                    j += 1;\n                }\n                tries += 1;\n                if attempt(f, g, best, &mut c, size, &mut steps) {\n                    changed = true;\n                } else if w == lo {\n                    lo = w + 1;\n                } else {\n                    lo = w;\n");
    buf_str(out, c"                }\n            }\n            if i + 1 < best.len() && best[i] > best[i + 1] {\n                c.clear();\n                let mut j: usize = 0;\n                while j < best.len() {\n                    c.push(if j == i { best[i + 1] } else if j == i + 1 { best[i] }\n                        else { best[j] });\n                    j += 1;\n                }\n                tries += 1;\n                if attempt(f, g, best, &mut c, size, &mut steps) {\n                    changed = true;\n                }\n            }\n            i += 1;\n        }\n    }\n    steps\n}\n\n// A property: the cases (the first all zeros: the simplest values), each\n// in a child process; the first failure is shrunk, then replayed with its\n// inputs printed; exit 1. `vole-test:` lines on stdout tell `volec test`\n// the case and the steps.\npub fn run_property<F: Fn(&mut Gen<Gpa>)>(gpa: Gpa, name: &str, f: F) {\n    property(gpa, name, &f);\n}\n\nfn property<F: Fn(&mut Gen<Gpa>)>(gpa: Gpa, name: &str, f: &F) {\n    // (the cases run in children; this process ends normally)\n    test_done();\n    let seed = seed_of(name);\n    let cases = if state().cases > 0 { state().cases } else { 1 };\n    let mut st = seed;\n    let mut choices: Vec<u64, Gpa> = Vec::new_in(gpa);\n    let mut g = runner_gen(gpa);\n    let mut discarded: usize = 0;\n    let mut n: usize = 0;\n    while n < cases {\n        // (sizes grow over 100 cases, whatever --cases: -O0 runs the first\n        // 20 of -O2's)\n        let size = 1 + (if n < 100 { n } else { 99 }) * 30 / 100;\n        choices.clear();\n        if n > 0 {\n            let mut k: usize = 0;\n            while k < 512 {\n                choices.push(choice(&mut st, size));\n                k += 1;\n            }\n        }\n        let r = case(f, &mut g, &mut choices, size, true);\n        if r.status == DISCARD {\n            discarded += 1;\n            n += 1;\n            continue;\n        }\n        if r.status != 0 {\n");
    buf_str(out, c"            let keep = if r.used < choices.len() { r.used } else { choices.len() };\n            choices.truncate(keep);\n            let steps = shrink(f, &mut g, &mut choices, size);\n            let at = n + 1;\n            let word = if steps == 1 { \"step\" } else { \"steps\" };\n            crate::fmt::println(\n                \"vole-test: property case {at} of {cases}, shrunk in {steps} {word}, seed {seed:x}\");\n            case(f, &mut g, &mut choices, size, false);\n            exit_with(1);\n        }\n        n += 1;\n    }\n    if discarded * 10 > cases * 9 {\n        crate::fmt::println(\"vole-test: discarded {discarded} of {cases}\");\n        crate::fmt::eprintln(\n            \"the generator rarely satisfies the requires: {discarded} of {cases} cases discarded (write an impl Arbitrary for the parameter's type)\");\n        exit_with(1);\n    }\n}\n\n// The line `k` (from 0) of s.\nfn line_of(s: &[u8], k: usize) -> &[u8] {\n    let mut at: usize = 0;\n    let mut line: usize = 0;\n    while at <= s.len() {\n        let mut e = at;\n        while e < s.len() && s[e] != b'\\n' {\n            e += 1;\n        }\n        if line == k {\n            return &s[at..e];\n        }\n        line += 1;\n        at = e + 1;\n    }\n    &s[0..0]\n}\n\nfn text_of(b: &[u8]) -> &str {\n    match crate::str::from_utf8(b) {\n        Result::Ok(s) => s,\n        Result::Err(_) => \"(not UTF-8)\",\n    }\n}\n\n// ---- The fuzzer ----\n\n// `#[fuzz]` functions: a property whose choice sequence is an input's\n// bytes, one choice per byte. `volec fuzz NAME` runs it on inputs it\n// mutates and keeps those that reach new code (--coverage's counters,\n// std::COVERAGE_MAP); `volec test` runs it as a property and on its\n// saved inputs. A `&[u8]` parameter is the input itself (gen_bytes).\n\n// The counters (all zero in a program built without --coverage).\npub fn coverage() -> &'static [u8] {\n    // UNSAFE: the counters' static, viewed.\n");
    buf_str(out, c"    // SAFETY: the program's blocks only ever add to it, on this thread;\n    // the view is read before the next block runs (the coverage anchor\n    // returns it to the fuzzer's caller).\n    unsafe { &*(&raw const crate::COVERAGE_MAP) }\n}\n\nfn coverage_reset() {\n    let mut i: usize = 0;\n    while i < 65536 {\n        // UNSAFE: the counters' static, written by value. SAFETY: on this\n        // thread; i < 65536.\n        unsafe {\n            crate::COVERAGE_MAP[i] = 0;\n        }\n        i += 1;\n    }\n}\n\npub fn fuzz_word(w: &'static [u8]) {\n    let mut s = state();\n    if s.fuzz_words < 64 && w.len() > 0 && w.len() <= 32 {\n        // UNSAFE: a static mut's element, written by value. SAFETY: as\n        // state's; s.fuzz_words < 64.\n        unsafe {\n            FUZZ_WORDS[s.fuzz_words] = w;\n        }\n        s.fuzz_words += 1;\n        set_state(s);\n    }\n}\n\n// A run of one input in a child process: its status, the choices it used,\n// and (when it returned) its coverage, into `cov`.\nfn fuzz_exec<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, input: &mut Vec<u64, Gpa>,\n    cov: &mut [u8]) -> CaseRun {\n    let n = input.len();\n    let (rd, wr) = pipe();\n    let (crd, cwr) = pipe();\n    crate::mem::swap(&mut g.choices, input);\n    let pid = fork();\n    if pid == 0 {\n        close(rd);\n        close(crd);\n        quiet();\n        running();\n        coverage_reset();\n        g.at = 0;\n        g.size = 64;\n        g.depth = 0;\n        g.showing = false;\n        g.report = wr;\n        g.raw = true;\n        run_case(f, g);\n        let _ = crate::io::sys_write(cwr, coverage());\n        quit(0);\n    }\n    crate::mem::swap(&mut g.choices, input);\n    close(wr);\n    close(cwr);\n    let used = read_i64(rd);\n    close(rd);\n    let mut i: usize = 0;\n    while i < 65536 {\n        cov[i] = 0;\n        i += 1;\n    }\n    let mut got: usize = 0;\n    loop {\n");
    buf_str(out, c"        let k = match crate::io::sys_read(crd, &mut cov[got..65536]) {\n            Result::Ok(k) => k,\n            Result::Err(_) => 0,\n        };\n        if k == 0 {\n            break;\n        }\n        got += k;\n        if got >= 65536 {\n            break;\n        }\n    }\n    close(crd);\n    CaseRun { status: wait(pid), used: if used >= 0 { used as usize } else { n } }\n}\n\n// AFL's buckets of a count: 1, 2, 3, 4-7, 8-15, 16-31, 32-127, 128-255.\nfn bucket(c: u8) -> u8 {\n    if c == 0 { 0 } else if c == 1 { 1 } else if c == 2 { 2 } else if c == 3 { 4 }\n    else if c < 8 { 8 } else if c < 16 { 16 } else if c < 32 { 32 } else if c < 128 { 64 }\n    else { 128 }\n}\n\n// Whether `cov` reaches a block (or a block's count) `seen` has not seen;\n// `seen` takes it in.\nfn new_coverage(cov: &[u8], seen: &mut [u8]) -> bool {\n    let mut new = false;\n    let mut i: usize = 0;\n    while i < 65536 {\n        let c = cov[i];\n        if c != 0 {\n            let b = bucket(c);\n            if (b & !seen[i]) != 0 {\n                seen[i] = seen[i] | b;\n                new = true;\n            }\n        }\n        i += 1;\n    }\n    new\n}\n\n// One mutation of `v` (bytes as choices), from the random state; `other`\n// is another input of the corpus (for a splice).\nfn mutate(v: &mut Vec<u64, Gpa>, other: &Vec<u64, Gpa>, st: &mut u64) {\n    let len = v.len();\n    let r = next_of(st);\n    let how = r % 10;\n    let at = if len > 0 { ((r >> 8) % len as u64) as usize } else { 0 };\n    if len == 0 || how == 0 {\n        // a byte inserted\n        let b = next_of(st) % 256;\n        if len >= 4096 {\n            return;\n        }\n        v.insert(at, b);\n    } else if how == 1 {\n        // a bit flipped\n        v[at] = v[at] ^ (1 << (next_of(st) % 8));\n    } else if how == 2 {\n        let interesting: [u64; 10] = [0, 1, 0x7f, 0x80, 0xff, 48, 97, 32, 10, 255];\n        v[at] = interesting[(next_of(st) % 10) as usize];\n    } else if how == 3 {\n");
    buf_str(out, c"        v[at] = next_of(st) % 256;\n    } else if how == 4 {\n        // a run deleted\n        let n = 1 + (next_of(st) % 4) as usize;\n        let mut k: usize = 0;\n        while k < n && at < v.len() {\n            v.remove(at);\n            k += 1;\n        }\n    } else if how == 5 {\n        // a byte changed by a little\n        let d = next_of(st) % 16;\n        v[at] = (v[at] + d + 240) % 256;\n    } else if how == 6 && other.len() > 0 {\n        // a splice: this input's start, the other's end\n        let cut = (next_of(st) % other.len() as u64) as usize;\n        v.truncate(at);\n        let mut i = cut;\n        while i < other.len() {\n            if v.len() < 4096 {\n                v.push(other[i]);\n            }\n            i += 1;\n        }\n    } else if how == 7 && state().fuzz_words > 0 {\n        // a text constant of the program\n        let w = fuzz_word_at((next_of(st) % state().fuzz_words as u64) as usize);\n        let mut i: usize = 0;\n        while i < w.len() {\n            if v.len() < 4096 {\n                v.insert(at + i, w[i] as u64);\n            }\n            i += 1;\n        }\n    } else if how == 8 && len < 4096 {\n        // a run repeated\n        let n = 1 + (next_of(st) % 8) as usize;\n        let mut k: usize = 0;\n        while k < n && at + k < len && v.len() < 4096 {\n            let to = if at + n + k < v.len() { at + n + k } else { v.len() };\n            let x = v[at + k];\n            v.insert(to, x);\n            k += 1;\n        }\n    } else {\n        v[at] = next_of(st) % 256;\n    }\n}\n\nfn fuzz_hash(v: &Vec<u64, Gpa>) -> u64 {\n    let mut h: u64 = 14695981039346656037;\n    let mut i: usize = 0;\n    while i < v.len() {\n        h = (h ^ v[i]).wrapping_mul(1099511628211);\n        i += 1;\n    }\n    h\n}\n\n// Input v saved as DIR/PREFIXHASH (bytes): its path.\nfn fuzz_save(gpa: Gpa, v: &Vec<u64, Gpa>, prefix: &str) -> String<Gpa> {\n    let s = state();\n");
    buf_str(out, c"    let mut path: String<Gpa> = String::new_in(gpa);\n    if s.fuzz_dir_set {\n        path.push_str(s.fuzz_dir);\n        path.push('/');\n    }\n    path.push_str(prefix);\n    let h = fuzz_hash(v);\n    let digits = \"0123456789abcdef\".as_bytes();\n    let mut k: u64 = 0;\n    while k < 16 {\n        path.push(digits[((h >> (60 - 4 * k)) & 15) as usize] as char);\n        k += 1;\n    }\n    let mut bytes: Vec<u8, Gpa> = Vec::new_in(gpa);\n    let mut i: usize = 0;\n    while i < v.len() {\n        bytes.push(v[i] as u8);\n        i += 1;\n    }\n    let _ = crate::fs::write(path.as_str(), bytes.as_slice());\n    path\n}\n\nfn fuzz_load(gpa: Gpa, path: &str, into: &mut Vec<u64, Gpa>) -> bool {\n    into.clear();\n    match crate::fs::read_in(path, gpa) {\n        Result::Ok(b) => {\n            let mut i: usize = 0;\n            while i < b.len() {\n                into.push(b[i] as u64);\n                i += 1;\n            }\n            true\n        }\n        Result::Err(_) => false,\n    }\n}\n\n// A failing input: shrunk, saved, replayed with its inputs printed; exit 1.\nfn fuzz_failed<F: Fn(&mut Gen<Gpa>)>(f: &F, g: &mut Gen<Gpa>, input: &mut Vec<u64, Gpa>,\n    runs: usize) -> ! {\n    let gpa = g.gpa;\n    let mut s = state();\n    s.raw = true;\n    set_state(s);\n    let steps = shrink(f, g, input, 64);\n    let path = fuzz_save(gpa, input, \"crash-\");\n    let word = if steps == 1 { \"step\" } else { \"steps\" };\n    crate::fmt::println(\"vole-test: property after {runs} runs, shrunk in {steps} {word}\");\n    crate::fmt::println(\"vole-test: saved {}\", path.as_str());\n    case(f, g, input, 64, false);\n    exit_with(1)\n}\n\n// A fuzz target: fuzzed for --fuzz-time seconds (volec fuzz), else run\n// on its saved inputs (--replay), then as a property.\npub fn run_fuzz_target<F: Fn(&mut Gen<Gpa>)>(gpa: Gpa, name: &str, f: F) {\n    test_done();\n    let mut g = runner_gen(gpa);\n    let mut input: Vec<u64, Gpa> = Vec::new_in(gpa);\n");
    buf_str(out, c"    let replays = state().replays;\n    if state().fuzz_time == 0 {\n        let mut s = state();\n        s.raw = true;\n        set_state(s);\n        let mut k: usize = 0;\n        while k < replays {\n            let at = replay(k);\n            k += 1;\n            if !fuzz_load(gpa, at, &mut input) {\n                continue;\n            }\n            let r = case(&f, &mut g, &mut input, 64, true);\n            if fails(r) {\n                crate::fmt::println(\"vole-test: property input {at}\");\n                case(&f, &mut g, &mut input, 64, false);\n                exit_with(1);\n            }\n        }\n        let mut s = state();\n        s.raw = false;\n        set_state(s);\n        property(gpa, name, &f);\n        return;\n    }\n    // the corpus: the saved inputs, and the empty one\n    let mut corpus: Vec<Vec<u64, Gpa>, Gpa> = Vec::new_in(gpa);\n    let mut seen: Vec<u8, Gpa> = Vec::new_in(gpa);\n    let mut cov: Vec<u8, Gpa> = Vec::new_in(gpa);\n    let mut i: usize = 0;\n    while i < 65536 {\n        seen.push(0);\n        cov.push(0);\n        i += 1;\n    }\n    corpus.push(Vec::new_in(gpa));\n    let mut k: usize = 0;\n    while k < replays {\n        let mut v: Vec<u64, Gpa> = Vec::new_in(gpa);\n        if fuzz_load(gpa, replay(k), &mut v) {\n            corpus.push(v);\n        }\n        k += 1;\n    }\n    let mut runs: usize = 0;\n    let mut k: usize = 0;\n    while k < corpus.len() {\n        let r = fuzz_exec(&f, &mut g, &mut corpus[k], cov.as_mut_slice());\n        runs += 1;\n        if fails(r) {\n            let mut v = copy_of(gpa, &corpus[k]);\n            fuzz_failed(&f, &mut g, &mut v, runs);\n        }\n        k += 1;\n        new_coverage(cov.as_slice(), seen.as_mut_slice());\n    }\n    let mut st = seed_of(name);\n    let start = crate::time::Instant::now();\n    let limit = state().fuzz_time;\n    let mut kept: usize = 0;\n    let mut child: Vec<u64, Gpa> = Vec::new_in(gpa);\n");
    buf_str(out, c"    while start.elapsed().as_secs() < limit {\n        let p = (next_of(&mut st) % corpus.len() as u64) as usize;\n        let o = (next_of(&mut st) % corpus.len() as u64) as usize;\n        child.clear();\n        child.extend_from_slice(corpus[p].as_slice());\n        let stack = 1 + next_of(&mut st) % 4;\n        let mut m: u64 = 0;\n        while m < stack {\n            mutate(&mut child, &corpus[o], &mut st);\n            m += 1;\n        }\n        let r = fuzz_exec(&f, &mut g, &mut child, cov.as_mut_slice());\n        runs += 1;\n        if fails(r) {\n            fuzz_failed(&f, &mut g, &mut child, runs);\n        }\n        if r.status == 0 && new_coverage(cov.as_slice(), seen.as_mut_slice()) {\n            let keep = copy_of(gpa, &child);\n            let _ = fuzz_save(gpa, &keep, \"corpus-\");\n            corpus.push(keep);\n            kept += 1;\n        }\n    }\n    let size = corpus.len();\n    crate::fmt::println(\"vole-test: fuzz {runs} runs, {kept} inputs kept, {size} in the corpus\");\n    exit_with(0)\n}\n// ---- end mod std::test ----\n}\n");
}

// (0.27.5, Z5.2) std2's units, for a build that lexes only those it
// reaches (front/modules/std2lazy.vl: index_command writes it)
pub fn std2_units(out: i64) {
    buf_str(out, c"std2-text 534323438\nstd2-units 1 1176809 3188 4174 216 13\ncount_ones effects diverge crate x u64 i64 leading_zeros trailing_zeros contract_check io panic ok bool site check\na b c COVERAGE_MAP u8 Copy builtin_impls i8 i16 i32 isize u16 u32 usize f32 f64\nClone char PhantomData T Sized Deref Target deref self Self DerefMut deref_mut Index Idx Output index\nIndexMut index_mut Drop drop Add Rhs add rhs Sub sub Mul mul Div div Rem rem\nNeg neg Not not BitAnd bitand BitOr bitor BitXor bitxor Shl shl Shr shr AddAssign add_assign\nSubAssign sub_assign MulAssign mul_assign DivAssign div_assign RemAssign rem_assign BitAndAssign bitand_assign BitOrAssign bitor_assign BitXorAssign bitxor_assign ShlAssign shl_assign\nShrAssign shr_assign Range derive PartialEq Eq Hash start end PartialOrd contains U item is_empty RangeInclusive exhausted\nnew into_inner RangeFrom RangeTo RangeToInclusive RangeFull Bound Debug Included Excluded Unbounded RangeBounds start_bound end_bound s e\nfmt f Formatter Result write_str result Ok eq other ne Ordering Ord Less Equal Greater is_eq\n_ is_ne is_lt is_gt is_le is_ge reverse then then_with F FnOnce partial_cmp Option lt Some le\ngt ge cmp max min clamp min_by_key K FnMut max_by_key Reverse Default A B C D\nE clone clone_from source default DefaultIn default_in From from value Into into TryFrom Error try_from TryInto\ntry_into AsRef as_ref AsMut as_mut Infallible TryFromIntError Borrow Borrowed borrow BorrowMut borrow_mut ToOwnedIn Allocator Owned to_owned_in\nswap pa pb t ptr read copy_nonoverlapping write replace dest src p old take forget size_of\nalign_of size_of_val needs_drop ManuallyDrop slot drop_in_place ops NonNull pointer is_null None dangling mem as_ptr cast count\nnull null_mut inline dst copy i offset slice_parts n slice_parts_mut UnsafeCell repr transparent get get_mut Cell\nSync set v update debug_struct field finish link_name panic_write fd buf panic_exit code PANIC_BUF PanicBuf len\n");
    buf_str(out, c"Write str is_char_boundary as_bytes emit assert_failed op msg w head tail sep left right M Display\nassert assert_eq assert_ne debug_assert unreachable todo m unimplemented is_some is_some_and is_none is_none_or expect requires unwrap unwrap_or\nunwrap_or_else unwrap_or_default unwrap_unchecked map inspect map_or map_or_else ok_or err Err ok_or_else as_deref as_deref_mut iter Iter inner\niter_mut IterMut and optb and_then filter P predicate or or_else xor insert get_or_insert get_or_insert_with take_if hit\nzip unzip copied cloned transpose flatten Iterator Item next IntoIter IntoIterator into_iter is_ok is_ok_and is_err is_err_and\nmap_err O F2 inspect_err option expect_err unwrap_err res Layout size align array LayoutError checked_mul from_size_align MAX\nAllocError TryReserveError CapacityOverflow layout FREES allocate allocate_zeroed deallocate grow q grow_zeroed shrink by_ref erase AnyAlloc Gpa\nsealed live_blocks alloc __gpa check_leaks CHUNK_HEADER CHUNK_MIN CHUNK_ALIGN round_up out_of_memory Chunks chunk at used allocated parent\nbytes h bump release keep_first prev nn alloc_in alloc_slice_copy_in l slice from_raw_parts_mut alloc_str_in Arena chunks Send\nnew_in with_capacity_in allocated_bytes reset alloc_slice_copy alloc_slice_fill_with alloc_str scope R ArenaScope home region arena_scope arena TypedArena marker\nitems_offset chunk_layout cap add_chunk per items room alloc_extend I vec Vec push set_len FixedBuf as_mut_ptr capacity\nbase data allocate_fn deallocate_fn grow_fn shrink_fn any_allocate any_deallocate any_grow any_shrink Box try_new_in into_raw_with_allocator free_block allocator clone_in\nleak into_raw from_raw_in hash H Hasher state ensures reserve_exact from_in array_builtin N from_raw_parts_in grow_to new_cap new_layout\ngot reserve extra try_reserve capacity_error doubled shrink_to_fit shrink_to min_capacity target debug grow_one put never pop remove\n");
