    if !st_live() {\n");
    buf_str(out, c"        return;\n    }\n    // UNSAFE: a Core Foundation C call on the raw CFFileDescriptor, and the\n    // State through st().\n    // SAFETY: see st_live; `f` is one of our CFFileDescriptors.\n    unsafe {\n        let fd = CFFileDescriptorGetNativeDescriptor(f);\n        for i in 0..st().watches.len() as i64 {\n            if st().watches[i as usize].fd == fd {\n                st().watches[i as usize].armed = false;\n            }\n        }\n        push(Event::Readable(fd));\n    }\n}\n\n// ---- classes (0.23) ----\n\n// The encoding of method `name` of the superclass or protocol, or `dflt`.\nfn types(cls: *mut u8, proto: *mut u8, name: *mut u8, dflt: *mut u8) -> *mut u8 {\n    let t = method_types(cls, proto, name);\n    if t == 0 as *mut u8 { dflt } else { t }\n}\n\n// UNSAFE: the Objective-C runtime's class-building C functions, with the\n// IMPs as C function pointers.\n// SAFETY: called on the main thread (new_in); an existing VoleView is\n// reused, so the pair is allocated and registered once; each IMP's C\n// signature matches the type encoding given with it (the superclass's or\n// protocol's own when the runtime has one); the ivar is 48 bytes aligned to\n// 1 << 3, ViewData's size and alignment.\nunsafe fn make_view_class() -> *mut u8 {\n    let existing = class(c\"VoleView\");\n    if existing != 0 as *mut u8 {\n        return existing;\n    }\n    let sup = class(c\"NSView\");\n    let tic = objc_getProtocol(c\"NSTextInputClient\");\n    let c = objc_allocateClassPair(sup, c\"VoleView\", 0);\n    class_addIvar(c, c\"vole\", 48, 3, c\"[6q]\");\n    class_addProtocol(c, tic);\n    add_b(c, sel(c\"acceptsFirstResponder\"), imp_yes,\n        types(sup, 0 as *mut u8, c\"acceptsFirstResponder\", c\"c@:\"));\n    add_b(c, sel(c\"isFlipped\"), imp_yes, types(sup, 0 as *mut u8, c\"isFlipped\", c\"c@:\"));\n    add_b_p(c, sel(c\"acceptsFirstMouse:\"), imp_yes_p,\n        types(sup, 0 as *mut u8, c\"acceptsFirstMouse:\", c\"c@:@\"));\n");
