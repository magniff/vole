    buf_str(out, c"    #[effects(unsafe, T, A)]\n    pub fn as_mut_slice(&mut self) -> &mut [T] {\n        let p = self.ptr.as_ptr();\n        // UNSAFE: a &mut slice of the block.\n        // SAFETY: the first len elements are initialized; the slice borrows self\n        // mutably, so nothing else reaches them.\n        unsafe { crate::slice::from_raw_parts_mut(p, self.len) }\n    }\n\n    #[effects(T)]\n    pub fn as_ptr(&self) -> *const T {\n        self.ptr.as_ptr() as *const T\n    }\n\n    #[effects(T)]\n    pub fn as_mut_ptr(&mut self) -> *mut T {\n        self.ptr.as_ptr()\n    }\n\n    // Sets its length, nothing dropped or initialized.\n    #[effects(unsafe)]\n    // UNSAFE: the first n elements must be initialized and n <= capacity.\n    // SAFETY: a contract on the caller, as Rust's set_len.\n    pub unsafe fn set_len(&mut self, n: usize) {\n        self.len = n;\n    }\n\n    // Keeps the elements f says true of, in order.\n    // std2: changed: FnMut(&T) (MVS: a let T)\n    #[effects(T, A)]\n    pub fn retain<F: FnMut(&T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        self.retain_mut(|x| f(&*x))\n    }\n\n    // retain, with each element given as &mut.\n    #[effects(panic, diverge, T, A, F)]\n    pub fn retain_mut<F: FnMut(&mut T) -> bool>(&mut self, f: F) {\n        let mut f = f;\n        let n = self.len;\n        let mut kept: usize = 0;\n        let mut i: usize = 0;\n        while i < n {\n            if f(&mut self.as_mut_slice()[i]) {\n                if kept != i {\n                    self.as_mut_slice().swap(kept, i);\n                }\n                kept += 1;\n            }\n            i += 1;\n        }\n        self.truncate(kept);\n    }\n\n    // Removes consecutive elements with the same key (f's), keeping the first.\n    // mvs: dedup_by_key\n    // std2: changed: Vec's method (MVS: a free function over a slice)\n    #[effects(T, A, K)]\n    pub fn dedup_by_key<K: PartialEq, F: FnMut(&mut T) -> K>(&mut self, key: F) {\n");
    buf_str(out, c"        let mut key = key;\n        self.dedup_by(|a, b| key(a) == key(b))\n    }\n\n    // Removes consecutive elements that same_bucket(a, b) says are equal.\n    // mvs: dedup_by\n    // std2: changed: Vec's method (MVS: a free function over a slice)\n    #[effects(panic, T, A, F)]\n    pub fn dedup_by<F: FnMut(&mut T, &mut T) -> bool>(&mut self, same_bucket: F) {\n        let mut same = same_bucket;\n        let n = self.len;\n        if n < 2 {\n            return;\n        }\n        // [0, w) is kept; element r is compared with the last kept one.\n        let mut w: usize = 1;\n        let mut r: usize = 1;\n        while r < n {\n            let (head, tail) = self.as_mut_slice().split_at_mut(r);\n            if !same(&mut tail[0], &mut head[w - 1]) {\n                if w != r {\n                    self.as_mut_slice().swap(w, r);\n                }\n                w += 1;\n            }\n            r += 1;\n        }\n        self.truncate(w);\n    }\n\n    // Moves every element of other to its end, leaving other empty.\n    #[effects(unsafe, T, A)]\n    pub fn append(&mut self, other: &mut Vec<T, A>) {\n        let m = other.len;\n        self.reserve(m);\n        // UNSAFE: moves other's elements to the end of self's block.\n        // SAFETY: reserve made room for m more; the two blocks are distinct\n        // (&mut self and &mut other); other's length is set to 0 so each value\n        // is owned once.\n        unsafe { crate::ptr::copy_nonoverlapping(other.slot(0), self.slot(self.len), m) };\n        self.len += m;\n        other.len = 0;\n    }\n\n    // The elements in range, removed and yielded by the iterator; the\n    // rest closes up when it is dropped.\n    #[effects(panic, T, A, R)]\n    pub fn drain<R: RangeBounds<usize>>(&mut self, range: R) -> Drain<'_, T, A> {\n        let n = self.len;\n        let (start, end) = range_of(&range, n);\n        // While the Drain lives the Vec holds [0, start); its drop moves the\n");
    buf_str(out, c"        // tail [end, n) down.\n        self.len = start;\n        let vec = match NonNull::new(self as *mut Vec<T, A>) {\n            Option::Some(p) => p,\n            Option::None => crate::panic::unreachable(),\n        };\n        Drain {\n            vec: vec, start: start, end: end, tail: end, tail_len: n - end, marker: PhantomData,\n        }\n    }\n\n    // The elements from at on, as a new Vec on a clone of A.\n    #[effects(panic, unsafe, T, A)]\n    pub fn split_off(&mut self, at: usize) -> Vec<T, A>\n        where\n            A: Clone,\n            requires at <= self.len()\n    {\n        let n = self.len;\n        if at > n {\n            crate::panic::panic(\"`at` split index (is {}) should be <= len (is {})\", at, n);\n        }\n        let mut other: Vec<T, A> = Vec::with_capacity_in(n - at, self.alloc.clone());\n        // UNSAFE: moves [at, n) into other's block.\n        // SAFETY: other has room for n - at; the blocks are distinct; self's\n        // length drops to at, so each value is owned once.\n        unsafe { crate::ptr::copy_nonoverlapping(self.slot(at), other.slot(0), n - at) };\n        other.len = n - at;\n        self.len = at;\n        other\n    }\n\n    // Its length made n: new elements are f()'s.\n    #[effects(diverge, T, A, F)]\n    pub fn resize_with<F: FnMut() -> T>(&mut self, n: usize, f: F) {\n        let mut f = f;\n        if n <= self.len {\n            self.truncate(n);\n            return;\n        }\n        self.reserve(n - self.len);\n        // (0.29: each f() written to its slot: the room is reserved, so\n        // push's growth test per element is not asked)\n        while self.len < n {\n            self.put(f());\n        }\n    }\n\n    // The elements, never freed: a &mut slice that lives as long as A's memory.\n    #[effects(unsafe, T, A)]\n    pub fn leak<'a>(self) -> &'a mut [T]\n        where\n            A: 'a,\n    {\n        let p = self.ptr.as_ptr();\n        let n = self.len;\n");
    buf_str(out, c"        crate::mem::forget(self);\n        // UNSAFE: a &mut slice of a block nothing frees.\n        // SAFETY: the Vec is forgotten, so the block and its first n\n        // initialized elements stay as long as A's memory ('a); only this\n        // slice reaches them.\n        unsafe { crate::slice::from_raw_parts_mut(p, n) }\n    }\n\n    // Moves the Vec out, leaving an empty one on a clone of its allocator\n    // (vole's: a Vec has no Default, so `mem::take` does not apply).\n    // std2: changed: needs A: Clone\n    #[effects(T, A)]\n    pub fn take(&mut self) -> Vec<T, A>\n        where\n            A: Clone,\n    {\n        let a = self.alloc.clone();\n        crate::mem::replace(self, Vec::new_in(a))\n    }\n\n    // Sorts it, stable (equal elements keep their order), with scratch from\n    // its own A: Rust's `sort`. MVS's sort was unstable: it is\n    // `sort_unstable` now ([T]'s, allocates nothing).\n    // std2: changed: stable, scratch from A (MVS: unstable)\n    #[effects(T, A)]\n    pub fn sort(&mut self)\n        where\n            T: Ord,\n    {\n        self.sort_by(|a, b| a.cmp(b))\n    }\n\n    // sort, by a comparison.\n    // mvs: Vec::sort_by, [T]::sort_by, sort_by\n    // std2: changed: stable, an Ordering (MVS: unstable, an i64)\n    #[effects(unsafe, T, A, F)]\n    pub fn sort_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {\n        let p = self.ptr.as_ptr();\n        // UNSAFE: the elements as a &mut slice while the allocator is borrowed\n        // for the scratch: two disjoint parts of self the checker sees as one.\n        // SAFETY: the slice covers the initialized elements only and the sort\n        // does not touch self.alloc but through &A.\n        let s = unsafe { crate::slice::from_raw_parts_mut(p, self.len) };\n        s.sort_by_in(compare, &self.alloc)\n    }\n\n    // sort, by a key.\n    // std2: changed: stable, FnMut(&T) (MVS: unstable, a let T)\n    #[effects(T, A, K)]\n");
    buf_str(out, c"    pub fn sort_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {\n        let mut f = f;\n        self.sort_by(|a, b| f(a).cmp(&f(b)))\n    }\n}\n\nimpl<T: Clone, A: Allocator> Vec<T, A> {\n    // A Vec of n clones of x on a (Rust's `vec![x; n]`, its order).\n    // mvs: Vec::filled_in\n    // std2: renamed\n    #[effects(T, A)]\n    pub fn from_elem_in(x: T, n: usize, a: A) -> Vec<T, A> {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(n, a);\n        v.resize(n, x);\n        v\n    }\n\n    // Appends clones of s's elements. (0.29) Inline: for a Copy T what is\n    // left at the call is a test of the room, one block copy and the new\n    // length (the compiler's assembler appends every instruction word and\n    // every line so).\n    #[inline]\n    #[effects(panic, unsafe, T, A)]\n    pub fn extend_from_slice(&mut self, s: &[T]) {\n        if !crate::mem::is_copy::<T>() {\n            self.extend_clones(s);\n            return;\n        }\n        let n = s.len();\n        if self.cap - self.len < n {\n            self.reserve(n);\n        }\n        // UNSAFE: s's elements copied as one block past the Vec's length,\n        // which then counts them. A push per element (a clone, a growth\n        // test and a bounds check each) was a third of the compiler's\n        // assembler at -O0 (measured, 0.29).\n        // SAFETY: there is room for n more (tested, or reserved), so [len,\n        // len + n) is inside the block; s is a shared borrow beside &mut\n        // self, so it is no part of this Vec; T is Copy (is_copy), so its\n        // bits are its clone and nothing is owned twice.\n        unsafe { crate::ptr::copy_nonoverlapping(s.as_ptr(), self.slot(self.len), n) };\n        self.len += n;\n    }\n\n    // extend_from_slice for a T that is not Copy: a clone of each, pushed.\n    fn extend_clones(&mut self, s: &[T]) {\n        self.reserve(s.len());\n        let mut i: usize = 0;\n        while i < s.len() {\n");
    buf_str(out, c"            self.push(s[i].clone());\n            i += 1;\n        }\n    }\n\n    // Appends clones of the elements in src (its own elements).\n    #[effects(panic, unsafe, T, A, R)]\n    pub fn extend_from_within<R: RangeBounds<usize>>(&mut self, src: R) {\n        let (start, end) = range_of(&src, self.len);\n        self.reserve(end - start);\n        if crate::mem::is_copy::<T>() {\n            // UNSAFE: its own elements [start, end) copied as one block past\n            // its length.\n            // SAFETY: reserve made room for end - start more (the pointers\n            // are read after it); the source is below len (range_of) and\n            // the destination starts at len, so they are disjoint; T is\n            // Copy (is_copy): its bits are its clone.\n            unsafe {\n                crate::ptr::copy_nonoverlapping(self.slot(start) as *const T, self.slot(self.len),\n                    end - start)\n            };\n            self.len += end - start;\n            return;\n        }\n        let mut i = start;\n        while i < end {\n            let x = self.as_slice()[i].clone();\n            self.push(x);\n            i += 1;\n        }\n    }\n\n    // Its length made n: new elements are clones of x.\n    #[effects(diverge, unsafe, T, A)]\n    pub fn resize(&mut self, n: usize, x: T) {\n        if n <= self.len {\n            self.truncate(n);\n            return;\n        }\n        self.reserve(n - self.len);\n        if crate::mem::is_copy::<T>() {\n            // UNSAFE: the new elements written as one block fill. A push\n            // per element was about 14 instructions each (measured, 0.29:\n            // the compiler's per-function tables).\n            // SAFETY: reserve made room for n - len more, so [len, n) is\n            // inside the block; x is a local, no part of it; T is Copy\n            // (is_copy), so its bits may be duplicated; len then counts\n            // only what was written.\n");
    buf_str(out, c"            unsafe { crate::ptr::fill_copies(self.slot(self.len), n - self.len, &x) };\n            self.len = n;\n            return;\n        }\n        while self.len + 1 < n {\n            self.push(x.clone());\n        }\n        self.push(x);\n    }\n\n    // A copy on another allocator.\n    #[effects(T, A, B)]\n    pub fn clone_in<B: Allocator>(&self, b: B) -> Vec<T, B> {\n        let mut v: Vec<T, B> = Vec::with_capacity_in(self.len, b);\n        v.extend_from_slice(self.as_slice());\n        v\n    }\n}\n\nimpl<T: PartialEq, A: Allocator> Vec<T, A> {\n    // Removes consecutive equal elements, keeping the first.\n    // mvs: dedup\n    // std2: changed: Vec's method (MVS: a free function over a slice)\n    #[effects(T, A)]\n    pub fn dedup(&mut self) {\n        self.dedup_by(|a, b| *a == *b)\n    }\n}\n\nimpl<T, A: Allocator> Drop for Vec<T, A> {\n    fn drop(&mut self) {\n        self.truncate(0);\n        if self.cap != 0 && crate::mem::size_of::<T>() != 0 {\n            // UNSAFE: gives the block back to A.\n            // SAFETY: cap > 0 and T is not zero-sized: ptr is the block A gave\n            // for layout(); the elements are dropped already.\n            unsafe { self.alloc.deallocate(self.ptr.cast::<u8>(), self.layout()) };\n        }\n    }\n}\n\nimpl<T, A: Allocator> Deref for Vec<T, A> {\n    type Target = [T];\n\n    fn deref(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> DerefMut for Vec<T, A> {\n    fn deref_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\n// `v[i]` and `&v[a..b]`: built in for Vec in 0.27.0; this is the trait's.\nimpl<T, I: SliceIndex<[T]>, A: Allocator> Index<I> for Vec<T, A> {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self.as_slice())\n    }\n}\n\nimpl<T, I: SliceIndex<[T]>, A: Allocator> IndexMut<I> for Vec<T, A> {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n");
    buf_str(out, c"        index.index_mut(self.as_mut_slice())\n    }\n}\n\n// A copy on the same allocator (a clone of it): plan §2.0, `Clone`\n// reuses the stored allocator.\n// std2: changed: needs A: Clone\nimpl<T: Clone, A: Allocator + Clone> Clone for Vec<T, A> {\n    fn clone(&self) -> Vec<T, A> {\n        self.clone_in(self.alloc.clone())\n    }\n}\n\n// mvs: Vec::impl Eq\n// std2: changed: PartialEq against any Vec<U, B>\nimpl<T: PartialEq<U>, U, A: Allocator, B: Allocator> PartialEq<Vec<U, B>> for Vec<T, A> {\n    fn eq(&self, other: &Vec<U, B>) -> bool {\n        self.as_slice() == other.as_slice()\n    }\n}\n\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U]> for Vec<T, A> {\n    fn eq(&self, other: &[U]) -> bool {\n        self.as_slice() == other\n    }\n}\n\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<&[U]> for Vec<T, A> {\n    fn eq(&self, other: &&[U]) -> bool {\n        self.as_slice() == *other\n    }\n}\n\n// Compiler-provided for every N (array_builtin, as from_in).\n#[array_builtin(N)]\nimpl<T: PartialEq<U>, U, A: Allocator> PartialEq<[U; N]> for Vec<T, A> {\n    fn eq(&self, other: &[U; N]) -> bool {\n        self.as_slice() == &(*other)[..]\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for Vec<T, A> {}\n\nimpl<T: PartialOrd, A: Allocator> PartialOrd for Vec<T, A> {\n    fn partial_cmp(&self, other: &Vec<T, A>) -> Option<Ordering> {\n        self.as_slice().partial_cmp(other.as_slice())\n    }\n}\n\nimpl<T: Ord, A: Allocator> Ord for Vec<T, A> {\n    fn cmp(&self, other: &Vec<T, A>) -> Ordering {\n        self.as_slice().cmp(other.as_slice())\n    }\n}\n\n// The elements' hashes, as the slice's: the same for any A.\nimpl<T: Hash, A: Allocator> Hash for Vec<T, A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.as_slice().hash(state)\n    }\n}\n\n// `[1, 2, 3]`.\nimpl<T: Debug, A: Allocator> Debug for Vec<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let s: &[T] = self.as_slice();\n");
    buf_str(out, c"        crate::fmt::Debug::fmt(s, f)\n    }\n}\n\nimpl<T, A: Allocator> AsRef<[T]> for Vec<T, A> {\n    fn as_ref(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> AsMut<[T]> for Vec<T, A> {\n    fn as_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\nimpl<T, A: Allocator> Borrow<[T]> for Vec<T, A> {\n    fn borrow(&self) -> &[T] {\n        self.as_slice()\n    }\n}\n\nimpl<T, A: Allocator> BorrowMut<[T]> for Vec<T, A> {\n    fn borrow_mut(&mut self) -> &mut [T] {\n        self.as_mut_slice()\n    }\n}\n\n// An empty Vec on a (`map.entry(k).or_default()` for Vec values).\nimpl<T, A: Allocator> DefaultIn<A> for Vec<T, A> {\n    fn default_in(a: A) -> Vec<T, A> {\n        Vec::new_in(a)\n    }\n}\n\nimpl<T, A: Allocator> Extend<T> for Vec<T, A> {\n    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(x);\n        }\n    }\n}\n\nimpl<'a, T: Copy + 'a, A: Allocator> Extend<&'a T> for Vec<T, A> {\n    fn extend<I: IntoIterator<Item = &'a T>>(&mut self, iter: I) {\n        for x in iter {\n            self.push(*x);\n        }\n    }\n}\n\n// `iter.collect_in(a)` into a Vec.\nimpl<T, A: Allocator> FromIteratorIn<T, A> for Vec<T, A> {\n    fn from_iter_in<I: IntoIterator<Item = T>>(iter: I, a: A) -> Vec<T, A> {\n        let mut v: Vec<T, A> = Vec::new_in(a);\n        v.extend(iter);\n        v\n    }\n}\n\n// `for x in v`: the elements, moved out.\nimpl<T, A: Allocator> IntoIterator for Vec<T, A> {\n    type Item = T;\n    type IntoIter = IntoIter<T, A>;\n\n    fn into_iter(self) -> IntoIter<T, A> {\n        let v = self;\n        let buf = v.ptr;\n        let cap = v.cap;\n        let len = v.len;\n        // UNSAFE: moves the allocator out of a value whose Drop is not run.\n        // SAFETY: v is forgotten right after, so the allocator is owned once\n        // (by the IntoIter), as are the block and the elements.\n");
    buf_str(out, c"        let alloc = unsafe { crate::ptr::read(&v.alloc as *const A) };\n        crate::mem::forget(v);\n        IntoIter { buf: buf, cap: cap, start: 0, end: len, alloc: alloc }\n    }\n}\n\n// `for x in &v`: &T's.\nimpl<'a, T, A: Allocator> IntoIterator for &'a Vec<T, A> {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\n// `for x in &mut v`: &mut T's.\nimpl<'a, T, A: Allocator> IntoIterator for &'a mut Vec<T, A> {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n\n// reserve's failure: a panic, as Rust's (vole has no abort hook).\nfn capacity_error(e: TryReserveError) -> ! {\n    match e {\n        TryReserveError::CapacityOverflow => crate::panic::panic(\"capacity overflow\"),\n        TryReserveError::AllocError { layout } => {\n            crate::panic::panic(\"memory allocation of {} bytes failed\", layout.size())\n        }\n    }\n}\n\n// A RangeBounds as [start, end) within 0..n; panics when it is not.\nfn range_of<R: RangeBounds<usize>>(r: &R, n: usize) -> (usize, usize) {\n    let start = match r.start_bound() {\n        Bound::Included(s) => *s,\n        Bound::Excluded(s) => *s + 1,\n        Bound::Unbounded => 0,\n    };\n    let end = match r.end_bound() {\n        Bound::Included(e) => *e + 1,\n        Bound::Excluded(e) => *e,\n        Bound::Unbounded => n,\n    };\n    if start > end {\n        crate::panic::panic(\"slice index starts at {} but ends at {}\", start, end);\n    }\n    if end > n {\n        crate::panic::panic(\"range end index {} out of range for slice of length {}\", end, n);\n    }\n    (start, end)\n}\n\n// A Vec's elements, by value; what is left is dropped with it.\npub struct IntoIter<T, A: Allocator> {\n    buf: NonNull<T>,\n    cap: usize,\n    start: usize,\n    end: usize,\n    alloc: A,\n}\n\n");
    buf_str(out, c"// UNSAFE: the buffer is a NonNull (neither Send nor Sync): stated, as Rust's.\n// SAFETY: IntoIter owns the elements left and the allocator, as a Vec does.\nunsafe impl<T: Send, A: Allocator + Send> Send for IntoIter<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&IntoIter` reads the elements left through `&T` only.\nunsafe impl<T: Sync, A: Allocator + Sync> Sync for IntoIter<T, A> {}\n\nimpl<T, A: Allocator> IntoIter<T, A> {\n    // What is left, as a slice.\n    #[effects(unsafe, T)]\n    pub fn as_slice(&self) -> &[T] {\n        let p = self.buf.as_ptr();\n        // UNSAFE: a slice of the block.\n        // SAFETY: [start, end) is the initialized part not yet yielded.\n        unsafe { crate::slice::from_raw_parts(p.add(self.start), self.end - self.start) }\n    }\n}\n\nimpl<T, A: Allocator> Iterator for IntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        // UNSAFE: moves element start out.\n        // SAFETY: start < end: it is initialized and, start moving past it, read once.\n        let x = unsafe { crate::ptr::read(self.buf.add(self.start).as_ptr()) };\n        self.start += 1;\n        Option::Some(x)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.end - self.start, Option::Some(self.end - self.start))\n    }\n}\n\nimpl<T, A: Allocator> DoubleEndedIterator for IntoIter<T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        self.end -= 1;\n        // UNSAFE: moves element end out.\n        // SAFETY: it was in [start, end) and, end moving below it, is read once.\n        Option::Some(unsafe { crate::ptr::read(self.buf.add(self.end).as_ptr()) })\n    }\n}\n\nimpl<T, A: Allocator> ExactSizeIterator for IntoIter<T, A> {}\n\nimpl<T, A: Allocator> Drop for IntoIter<T, A> {\n    fn drop(&mut self) {\n");
    buf_str(out, c"        while self.start < self.end {\n            // UNSAFE: drops the elements not yielded.\n            // SAFETY: [start, end) is initialized and each is read once.\n            crate::mem::drop(unsafe { crate::ptr::read(self.buf.add(self.start).as_ptr()) });\n            self.start += 1;\n        }\n        if self.cap != 0 && crate::mem::size_of::<T>() != 0 {\n            let layout = match Layout::array::<T>(self.cap) {\n                Result::Ok(l) => l,\n                Result::Err(_) => crate::panic::unreachable(),\n            };\n            // UNSAFE: gives the Vec's block back to its allocator.\n            // SAFETY: buf is the block the allocator gave for cap T's; no element\n            // is left in it.\n            unsafe { self.alloc.deallocate(self.buf.cast::<u8>(), layout) };\n        }\n    }\n}\n\n// Vec::drain's iterator: the removed elements; the Vec closes up when it\n// is dropped.\npub struct Drain<'a, T, A: Allocator> {\n    vec: NonNull<Vec<T, A>>,\n    start: usize,\n    end: usize,\n    tail: usize,\n    tail_len: usize,\n    marker: PhantomData<&'a mut Vec<T, A>>,\n}\n\n// UNSAFE: Drain reaches its Vec through a NonNull: stated, as Rust's.\n// SAFETY: it is the exclusive borrow of the Vec for 'a (its PhantomData of\n// `&'a mut Vec`): Send and Sync as that `&mut Vec<T, A>` is.\nunsafe impl<'a, T: Send, A: Allocator + Send> Send for Drain<'a, T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Drain` reads the drained elements through `&T` only.\nunsafe impl<'a, T: Sync, A: Allocator + Sync> Sync for Drain<'a, T, A> {}\n\nimpl<'a, T, A: Allocator> Iterator for Drain<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        // UNSAFE: the Vec reached through the Drain's pointer; element start\n        // moved out.\n        // SAFETY: the Drain holds the Vec's &mut for 'a; [start, end) is\n");
    buf_str(out, c"        // initialized, past the Vec's length, and read once.\n        let x = unsafe { crate::ptr::read(self.vec.as_mut().slot(self.start)) };\n        self.start += 1;\n        Option::Some(x)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = self.end - self.start;\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T, A: Allocator> DoubleEndedIterator for Drain<'a, T, A> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        self.end -= 1;\n        // UNSAFE: as next's.\n        // SAFETY: as next's, for element end.\n        Option::Some(unsafe { crate::ptr::read(self.vec.as_mut().slot(self.end)) })\n    }\n}\n\nimpl<'a, T, A: Allocator> ExactSizeIterator for Drain<'a, T, A> {}\n\nimpl<'a, T, A: Allocator> Drop for Drain<'a, T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: the Vec reached through the Drain's pointer.\n        // SAFETY: the Drain holds the Vec's &mut for 'a.\n        let v = unsafe { self.vec.as_mut() };\n        while self.start < self.end {\n            // UNSAFE: drops the drained elements not yielded.\n            // SAFETY: [start, end) is initialized and each is read once.\n            crate::mem::drop(unsafe { crate::ptr::read(v.slot(self.start)) });\n            self.start += 1;\n        }\n        let len = v.len;\n        if self.tail_len > 0 && self.tail != len {\n            // UNSAFE: moves the tail down to the Vec's length.\n            // SAFETY: [tail, tail + tail_len) is initialized and inside the\n            // block; ptr::copy allows the overlap; len then counts it.\n            unsafe { crate::ptr::copy(v.slot(self.tail), v.slot(len), self.tail_len) };\n        }\n        v.len = len + self.tail_len;\n    }\n}\n// ---- end mod std::vec ----\n}\n// ---- mod std::slice ----\npub mod slice {\n// std::slice: the methods of [T], always behind a reference (`&[T]`,\n");
    buf_str(out, c"// `&mut [T]`: MVS's views), its iterators and SliceIndex. A Vec and an\n// array have them all through Deref and the unsize coercion `&[T; N] ->\n// &[T]`. What reads returns references into the slice (`get` is\n// `Option<&T>`, `iter` yields `&T`); what sorts in place without\n// allocating keeps Rust's name and meaning (`sort_unstable`); the stable\n// sorts allocate scratch, so on a slice they take an allocator\n// (`sort_in(a)`), while Vec's `sort` uses its own (plan §2). MVS's free\n// functions (`reverse(s)`, `binary_search(s, x)`) are methods now.\n\nuse crate::alloc::Allocator;\nuse crate::borrow::ToOwnedIn;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::AsRef;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};\nuse crate::ops::{\n    Bound, Index, IndexMut, Range, RangeBounds, RangeFrom, RangeFull, RangeInclusive, RangeTo,\n    RangeToInclusive,\n};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::vec::Vec;\n\n// std2: new: Rust's slice::from_raw_parts. The n T's from p as a slice.\n#[effects(unsafe, T)]\n// UNSAFE: the slice's elements are read through p.\n// SAFETY: a contract on the caller: p valid for n initialized T's for 'a.\npub unsafe fn from_raw_parts<'a, T>(p: *const T, n: usize) -> &'a [T] {\n    crate::ptr::slice_parts(p, n)\n}\n\n// An empty `&'a mut [T]` that borrows nothing: what IterMut and ChunksMut\n// leave in their field while they split it (Rust promotes `&mut []` to\n// 'static; a temporary here would be a local's borrow).\nfn empty_mut<'a, T>() -> &'a mut [T] {\n    let p: crate::ptr::NonNull<T> = crate::ptr::NonNull::dangling();\n    // UNSAFE: a slice made from a raw pointer.\n    // SAFETY: it has no elements, so nothing is read or written through\n    // it; the pointer is non-null and aligned (NonNull::dangling).\n");
    buf_str(out, c"    unsafe { from_raw_parts_mut(p.as_ptr(), 0) }\n}\n\n// The same, mutable (slice::from_raw_parts_mut).\n#[effects(unsafe, T)]\n// UNSAFE: the slice's elements are read and written through p.\n// SAFETY: a contract on the caller: p valid for n T's for 'a, and not\n// otherwise accessed for 'a.\npub unsafe fn from_raw_parts_mut<'a, T>(p: *mut T, n: usize) -> &'a mut [T] {\n    crate::ptr::slice_parts_mut(p, n)\n}\n\nimpl<T> [T] {\n    // The number of elements (built in; MVS's `.len` read).\n    #[effects()]\n    pub fn len(&self) -> usize {\n        // Built in: the length word of the reference (a view's `len` today).\n        self.len\n    }\n\n    #[effects(T)]\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    // Element i, or the subslice a range names; None when out of bounds.\n    // mvs: [T]::get, Vec::get\n    // std2: changed: a reference, through SliceIndex (MVS: a copy of T)\n    #[effects(T, I)]\n    pub fn get<I: SliceIndex<[T]>>(&self, index: I) -> Option<&I::Output> {\n        index.get(self)\n    }\n\n    // The same, mutable.\n    #[effects(T, I)]\n    pub fn get_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> Option<&mut I::Output> {\n        index.get_mut(self)\n    }\n\n    // get, with no bounds check.\n    #[effects(unsafe, T, I)]\n    // UNSAFE: an index out of bounds is undefined.\n    // SAFETY: a contract on the caller: index within the slice.\n    pub unsafe fn get_unchecked<I: SliceIndex<[T]>>(&self, index: I) -> &I::Output {\n        // The checked access: undefined behaviour may do anything, a panic too.\n        index.index(self)\n    }\n\n    #[effects(unsafe, T, I)]\n    // UNSAFE: an index out of bounds is undefined.\n    // SAFETY: a contract on the caller: index within the slice.\n    pub unsafe fn get_unchecked_mut<I: SliceIndex<[T]>>(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self)\n    }\n\n    // mvs: Vec::first\n    // std2: changed: a reference (MVS: a copy, on Vec only)\n");
    buf_str(out, c"    #[effects(T)]\n    pub fn first(&self) -> Option<&T> {\n        self.get(0)\n    }\n\n    // mvs: Vec::last\n    // std2: changed: a reference (MVS: a copy, on Vec only)\n    #[effects(T)]\n    pub fn last(&self) -> Option<&T> {\n        if self.is_empty() { Option::None } else { self.get(self.len() - 1) }\n    }\n\n    #[effects(T)]\n    pub fn first_mut(&mut self) -> Option<&mut T> {\n        self.get_mut(0)\n    }\n\n    #[effects(T)]\n    pub fn last_mut(&mut self) -> Option<&mut T> {\n        let n = self.len();\n        if n == 0 { Option::None } else { self.get_mut(n - 1) }\n    }\n\n    // The first element and the rest.\n    // (0.28.0: no `panic`: the indices are in bounds where the slice is\n    // not empty, effects E2.1; a slice's iterator is this)\n    #[effects(T)]\n    pub fn split_first(&self) -> Option<(&T, &[T])> {\n        if self.is_empty() { Option::None } else { Option::Some((&self[0], &self[1..])) }\n    }\n\n    // The last element and the rest.\n    // (0.28.0: no `panic`, as split_first: `s[s.len() - 1]` and `s[..s.len()\n    // - 1]` are in bounds where the slice is not empty, effects E2.1)\n    #[effects(T)]\n    pub fn split_last(&self) -> Option<(&T, &[T])> {\n        if self.is_empty() {\n            Option::None\n        } else {\n            Option::Some((&self[self.len() - 1], &self[..self.len() - 1]))\n        }\n    }\n\n    // [0, mid) and [mid, len); panics when mid > len.\n    #[effects(panic)]\n    pub fn split_at(&self, mid: usize) -> (&[T], &[T])\n        requires mid <= self.len()\n    {\n        (&self[..mid], &self[mid..])\n    }\n\n    // The same, mutable: two disjoint &mut slices.\n    #[effects(panic, unsafe, T)]\n    pub fn split_at_mut(&mut self, mid: usize) -> (&mut [T], &mut [T])\n        requires mid <= self.len()\n    {\n        let n = self.len();\n        if mid > n {\n            crate::panic::panic(\"mid > len\");\n        }\n        let p = self.as_mut_ptr();\n");
    buf_str(out, c"        // UNSAFE: two &mut slices of one slice: the borrow checker cannot see\n        // that they are disjoint.\n        // SAFETY: [0, mid) and [mid, n) do not overlap and both lie in the\n        // slice (mid <= n, checked above); each lives as long as the &mut self.\n        unsafe { (from_raw_parts_mut(p, mid), from_raw_parts_mut(p.add(mid), n - mid)) }\n    }\n\n    // The elements, by reference, in order (`.rev()` from the end).\n    // mvs: [T]::iter, [T]::iter_ref, Vec::iter, Vec::iter_ref, SliceIter, SliceRefIter\n    // std2: changed: yields &T (MVS's iter copied each T; iter_ref is this)\n    #[effects()]\n    pub fn iter(&self) -> Iter<'_, T> {\n        Iter { v: self }\n    }\n\n    // The elements, by &mut.\n    #[effects()]\n    pub fn iter_mut(&mut self) -> IterMut<'_, T> {\n        IterMut { v: self }\n    }\n\n    // Subslices of size elements (the last one shorter); size > 0.\n    #[effects(panic)]\n    pub fn chunks(&self, size: usize) -> Chunks<'_, T>\n        requires size != 0\n    {\n        crate::panic::assert(size != 0, \"chunk size must be non-zero\");\n        Chunks { v: self, size: size }\n    }\n\n    #[effects(panic)]\n    pub fn chunks_mut(&mut self, size: usize) -> ChunksMut<'_, T>\n        requires size != 0\n    {\n        crate::panic::assert(size != 0, \"chunk size must be non-zero\");\n        ChunksMut { v: self, size: size }\n    }\n\n    // Subslices of exactly size elements; the rest is `remainder()`.\n    #[effects(panic, T)]\n    pub fn chunks_exact(&self, size: usize) -> ChunksExact<'_, T>\n        requires size != 0\n    {\n        crate::panic::assert(size != 0, \"chunk size must be non-zero\");\n        let n = self.len() - self.len() % size;\n        let (v, rem) = self.split_at(n);\n        ChunksExact { v: v, rem: rem, size: size }\n    }\n\n    // Every run of size consecutive elements, overlapping.\n    #[effects(panic)]\n    pub fn windows(&self, size: usize) -> Windows<'_, T>\n        requires size != 0\n");
    buf_str(out, c"    {\n        crate::panic::assert(size != 0, \"window size must be non-zero\");\n        Windows { v: self, size: size }\n    }\n\n    // The subslices between the elements pred says true of.\n    #[effects()]\n    pub fn split<F: FnMut(&T) -> bool>(&self, pred: F) -> Split<'_, T, F> {\n        Split { v: self, pred: pred, finished: false }\n    }\n\n    // Exchanges elements i and j; panics when out of bounds.\n    // mvs: [T]::swap, Vec::swap, swap_at\n    #[effects(panic, T)]\n    pub fn swap(&mut self, i: usize, j: usize)\n        requires i < self.len() && j < self.len()\n    {\n        let n = self.len();\n        if i >= n || j >= n {\n            crate::panic::panic(\"index out of bounds\");\n        }\n        if i == j {\n            return;\n        }\n        let (lo, hi) = if i < j { (i, j) } else { (j, i) };\n        let (a, b) = self.split_at_mut(hi);\n        crate::mem::swap(&mut a[lo], &mut b[0]);\n    }\n\n    // Reverses the order in place.\n    // mvs: reverse\n    #[effects(diverge, T)]\n    pub fn reverse(&mut self) {\n        let n = self.len();\n        let mut i: usize = 0;\n        while i < n / 2 {\n            self.swap(i, n - 1 - i);\n            i += 1;\n        }\n    }\n\n    // Rotates left by mid: element mid comes first.\n    // mvs: rotate_left\n    #[effects(panic, T)]\n    pub fn rotate_left(&mut self, mid: usize) {\n        crate::panic::assert(mid <= self.len(), \"mid > len\");\n        self[..mid].reverse();\n        self[mid..].reverse();\n        self.reverse();\n    }\n\n    // mvs: rotate_right\n    #[effects(panic, T)]\n    pub fn rotate_right(&mut self, k: usize) {\n        let n = self.len();\n        crate::panic::assert(k <= n, \"k > len\");\n        self.rotate_left(n - k);\n    }\n\n    // Every element set by f().\n    #[effects(panic, diverge, T, F)]\n    pub fn fill_with<F: FnMut() -> T>(&mut self, f: F) {\n        let mut f = f;\n        let mut i: usize = 0;\n        while i < self.len() {\n");
    buf_str(out, c"            self[i] = f();\n            i += 1;\n        }\n    }\n\n    // Exchanges its elements with other's (the same length, or a panic).\n    #[effects(panic, diverge, T)]\n    pub fn swap_with_slice(&mut self, other: &mut [T])\n        requires self.len() == other.len()\n    {\n        let n = self.len();\n        crate::panic::assert(n == other.len(),\n            \"destination and source slices have different lengths\");\n        let mut i: usize = 0;\n        while i < n {\n            crate::mem::swap(&mut self[i], &mut other[i]);\n            i += 1;\n        }\n    }\n\n    // Sorts in place, unstable (equal elements may change order),\n    // allocating nothing: ipnsort, as MVS's `sort` (now this name).\n    // mvs: sort_unstable, sort, [T]::sort, Vec::sort\n    // std2: renamed\n    #[effects(T)]\n    pub fn sort_unstable(&mut self)\n        where\n            T: Ord,\n    {\n        self.sort_unstable_by(|a, b| a.cmp(b))\n    }\n\n    // mvs: sort_unstable_by\n    #[effects(diverge, T, F)]\n    pub fn sort_unstable_by<F: FnMut(&T, &T) -> Ordering>(&mut self, compare: F) {\n        // A heapsort: in place, O(n log n), no allocation.\n        let mut compare = compare;\n        let n = self.len();\n        let mut start = n / 2;\n        while start > 0 {\n            start -= 1;\n            sift_down(self, start, n, &mut compare);\n        }\n        let mut end = n;\n        while end > 1 {\n            end -= 1;\n            self.swap(0, end);\n            sift_down(self, 0, end, &mut compare);\n        }\n    }\n\n    // mvs: sort_unstable_by_key\n    #[effects(T, K)]\n    pub fn sort_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(&mut self, f: F) {\n        let mut f = f;\n        self.sort_unstable_by(|a, b| f(a).cmp(&f(b)))\n    }\n\n    // Sorts stable, scratch from a (Rust's `sort` on a slice; on a Vec,\n    // `v.sort()` uses the Vec's allocator).\n    // mvs: sort_stable_in\n    // std2: renamed\n    #[effects(T, A)]\n");
    buf_str(out, c"    pub fn sort_in<A: Allocator>(&mut self, a: A)\n        where\n            T: Ord,\n    {\n        self.sort_by_in(|x, y| x.cmp(y), a)\n    }\n\n    // mvs: sort_stable_by_in, sort_stable_less_in\n    // std2: renamed\n    #[effects(panic, diverge, T, F, A)]\n    pub fn sort_by_in<F: FnMut(&T, &T) -> Ordering, A: Allocator>(&mut self, compare: F, a: A) {\n        // A stable merge sort of the indices (scratch from a), then the\n        // permutation applied in place by swaps: no T is moved through raw memory.\n        let n = self.len();\n        if n < 2 {\n            return;\n        }\n        let mut compare = compare;\n        let mut idx: Vec<usize, A> = Vec::with_capacity_in(2 * n, a);\n        let mut i: usize = 0;\n        while i < 2 * n {\n            idx.push(i % n);\n            i += 1;\n        }\n        let (perm, scratch) = idx.split_at_mut(n);\n        let mut width: usize = 1;\n        while width < n {\n            let mut lo: usize = 0;\n            while lo < n {\n                let mid = crate::cmp::min(lo + width, n);\n                let hi = crate::cmp::min(lo + 2 * width, n);\n                let (mut l, mut r, mut k) = (lo, mid, lo);\n                while k < hi {\n                    let take_left = r >= hi\n                        || (l < mid && compare(&self[perm[r]], &self[perm[l]]) != Ordering::Less);\n                    if take_left {\n                        scratch[k] = perm[l];\n                        l += 1;\n                    } else {\n                        scratch[k] = perm[r];\n                        r += 1;\n                    }\n                    k += 1;\n                }\n                lo = hi;\n            }\n            perm.copy_from_slice(scratch);\n            width *= 2;\n        }\n        // perm[k] is the index of the element that goes to k: follow each\n        // cycle to its first unplaced index.\n        let mut k: usize = 0;\n        while k < n {\n            let mut j = perm[k];\n");
    buf_str(out, c"            while j < k {\n                j = perm[j];\n            }\n            self.swap(k, j);\n            k += 1;\n        }\n    }\n\n    #[effects(T, K, A)]\n    pub fn sort_by_key_in<K: Ord, F: FnMut(&T) -> K, A: Allocator>(&mut self, f: F, a: A) {\n        let mut f = f;\n        self.sort_by_in(|x, y| f(x).cmp(&f(y)), a)\n    }\n\n    // Puts the element that sorted order has at i at i, the smaller ones\n    // before and the larger after (unstable, no allocation).\n    // mvs: select_nth_unstable\n    #[effects(T)]\n    pub fn select_nth_unstable(&mut self, i: usize) -> (&mut [T], &mut T, &mut [T])\n        where\n            T: Ord,\n            requires i < self.len()\n    {\n        self.select_nth_unstable_by(i, |a, b| a.cmp(b))\n    }\n\n    // mvs: select_nth_unstable_by, select_nth_unstable_less\n    #[effects(panic, T, F)]\n    pub fn select_nth_unstable_by<F: FnMut(&T, &T) -> Ordering>(\n        &mut self,\n        i: usize,\n        compare: F,\n    ) -> (&mut [T], &mut T, &mut [T]) {\n        crate::panic::assert(i < self.len(), \"partition index is out of bounds\");\n        // Sorting puts every element where sorted order has it (O(n log n),\n        // no allocation).\n        self.sort_unstable_by(compare);\n        let (lo, rest) = self.split_at_mut(i);\n        let (mid, hi) = rest.split_at_mut(1);\n        (lo, &mut mid[0], hi)\n    }\n\n    // mvs: select_nth_unstable_by_key\n    #[effects(T, K)]\n    pub fn select_nth_unstable_by_key<K: Ord, F: FnMut(&T) -> K>(\n        &mut self,\n        i: usize,\n        f: F,\n    ) -> (&mut [T], &mut T, &mut [T]) {\n        let mut f = f;\n        self.select_nth_unstable_by(i, |a, b| f(a).cmp(&f(b)))\n    }\n\n    // In a sorted slice: Ok(where x is) or Err(where it would go).\n    // mvs: binary_search\n    // std2: changed: Result<usize, usize> (Rust's)\n    #[effects(T)]\n    pub fn binary_search(&self, x: &T) -> Result<usize, usize>\n        where\n            T: Ord,\n    {\n");
    buf_str(out, c"        self.binary_search_by(|p| p.cmp(x))\n    }\n\n    // mvs: binary_search_by\n    #[effects(panic, diverge, T, F)]\n    pub fn binary_search_by<F: FnMut(&T) -> Ordering>(&self, f: F) -> Result<usize, usize> {\n        let mut f = f;\n        let mut lo: usize = 0;\n        let mut hi = self.len();\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            match f(&self[mid]) {\n                Ordering::Less => lo = mid + 1,\n                Ordering::Greater => hi = mid,\n                Ordering::Equal => return Result::Ok(mid),\n            }\n        }\n        Result::Err(lo)\n    }\n\n    // mvs: binary_search_by_key\n    #[effects(T, B)]\n    pub fn binary_search_by_key<B: Ord, F: FnMut(&T) -> B>(&self, b: &B, f: F) -> Result<usize,\n        usize> {\n        let mut f = f;\n        self.binary_search_by(|k| f(k).cmp(b))\n    }\n\n    // The first index where pred turns false, for a slice partitioned by it.\n    // mvs: partition_point\n    #[effects(panic, diverge, T, P)]\n    pub fn partition_point<P: FnMut(&T) -> bool>(&self, pred: P) -> usize {\n        let mut pred = pred;\n        let mut lo: usize = 0;\n        let mut hi = self.len();\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            if pred(&self[mid]) {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n        lo\n    }\n\n    // Whether it is sorted (each element <= the next).\n    #[effects(panic, T)]\n    pub fn is_sorted(&self) -> bool\n        where\n            T: PartialOrd,\n    {\n        let mut i: usize = 1;\n        while i < self.len() {\n            if !(self[i - 1] <= self[i]) {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n\n    #[effects(panic, T, K, F)]\n    pub fn is_sorted_by_key<K: PartialOrd, F: FnMut(&T) -> K>(&self, f: F) -> bool {\n        let mut f = f;\n        let n = self.len();\n        if n < 2 {\n");
    buf_str(out, c"            return true;\n        }\n        let mut prev = f(&self[0]);\n        let mut i: usize = 1;\n        while i < n {\n            let k = f(&self[i]);\n            if !(prev <= k) {\n                return false;\n            }\n            prev = k;\n            i += 1;\n        }\n        true\n    }\n\n    // Whether an element equals x.\n    // mvs: [T]::contains, Vec::contains\n    // std2: changed: takes &T\n    #[effects(unsafe, T)]\n    pub fn contains(&self, x: &T) -> bool\n        where\n            T: PartialEq,\n    {\n        if crate::mem::is_bytewise_eq::<T, T>() && crate::mem::size_of::<T>() == 1 {\n            // UNSAFE: the slice read as its bytes, searched by memchr (a\n            // loop over the elements is a compare and a bounds check each).\n            // SAFETY: T is u8, i8 or bool (is_bytewise_eq, one byte), so the\n            // slice is len() readable bytes, x one byte, and equality is\n            // the byte's.\n            return unsafe {\n                let b = crate::ptr::read(x as *const T as *const u8);\n                crate::ptr::byte_index(self.as_ptr() as *const u8, self.len(), b).is_some()\n            };\n        }\n        for y in self.iter() {\n            if *y == *x {\n                return true;\n            }\n        }\n        false\n    }\n\n    // std2: changed: takes &[T]\n    #[effects(panic, T)]\n    pub fn starts_with(&self, needle: &[T]) -> bool\n        where\n            T: PartialEq,\n    {\n        needle.len() <= self.len() && &self[..needle.len()] == needle\n    }\n\n    // std2: changed: takes &[T]\n    #[effects(panic, T)]\n    pub fn ends_with(&self, needle: &[T]) -> bool\n        where\n            T: PartialEq,\n    {\n        needle.len() <= self.len() && &self[self.len() - needle.len()..] == needle\n    }\n\n    // Copies src's elements in (the same length, or a panic).\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn copy_from_slice(&mut self, src: &[T])\n        where\n");
    buf_str(out, c"            T: Copy,\n            requires self.len() == src.len()\n    {\n        let n = self.len();\n        crate::panic::assert(n == src.len(),\n            \"source slice length does not match destination slice length\");\n        // UNSAFE: the elements copied as one block (an assignment and two\n        // bounds checks each otherwise).\n        // SAFETY: both slices have n elements (asserted above); src is a\n        // shared borrow beside &mut self, so the two do not overlap (the\n        // borrow rules: no safe code has both); T is Copy, so its bits are\n        // the value and the old elements have nothing to drop.\n        unsafe { crate::ptr::copy_nonoverlapping(src.as_ptr(), self.as_mut_ptr(), n) };\n    }\n\n    // Copies the elements in src to dest (they may overlap).\n    #[effects(panic, diverge, unsafe, T, R)]\n    pub fn copy_within<R: crate::ops::RangeBounds<usize>>(&mut self, src: R, dest: usize)\n        where\n            T: Copy,\n    {\n        let n = self.len();\n        let start = match src.start_bound() {\n            Bound::Included(s) => *s,\n            Bound::Excluded(s) => *s + 1,\n            Bound::Unbounded => 0,\n        };\n        let end = match src.end_bound() {\n            Bound::Included(e) => *e + 1,\n            Bound::Excluded(e) => *e,\n            Bound::Unbounded => n,\n        };\n        crate::panic::assert(start <= end && end <= n, \"src is out of bounds\");\n        let count = end - start;\n        crate::panic::assert(dest <= n - count, \"dest is out of bounds\");\n        let p = self.as_mut_ptr();\n        // UNSAFE: the elements moved as one block within the slice.\n        // SAFETY: [start, start + count) and [dest, dest + count) are both\n        // inside the slice (asserted above); ptr::copy allows their\n        // overlap; T is Copy: the overwritten elements have nothing to drop.\n        unsafe { crate::ptr::copy(p.add(start) as *const T, p.add(dest), count) };\n    }\n\n");
    buf_str(out, c"    // Clones src's elements in (the same length, or a panic).\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn clone_from_slice(&mut self, src: &[T])\n        where\n            T: Clone,\n            requires self.len() == src.len()\n    {\n        let n = self.len();\n        crate::panic::assert(n == src.len(),\n            \"destination and source slices have different lengths\");\n        if crate::mem::is_copy::<T>() {\n            // UNSAFE: as copy_from_slice's block copy.\n            // SAFETY: both slices have n elements (asserted above) and do\n            // not overlap (&mut self beside a shared borrow); T is Copy\n            // (is_copy): its bits are its clone, and the old elements have\n            // nothing to drop.\n            unsafe { crate::ptr::copy_nonoverlapping(src.as_ptr(), self.as_mut_ptr(), n) };\n            return;\n        }\n        let mut i: usize = 0;\n        while i < n {\n            self[i] = src[i].clone();\n            i += 1;\n        }\n    }\n\n    // Every element set to a clone of x.\n    // mvs: fill\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn fill(&mut self, x: T)\n        where\n            T: Clone,\n    {\n        if crate::mem::is_copy::<T>() {\n            let n = self.len();\n            // UNSAFE: the slice written as one block fill (a clone, an\n            // assignment and a bounds check per element otherwise).\n            // SAFETY: the slice is n writable T's; x is a local, no part of\n            // it; T is Copy (is_copy): its bits may be duplicated, and the\n            // old elements have nothing to drop.\n            unsafe { crate::ptr::fill_copies(self.as_mut_ptr(), n, &x) };\n            return;\n        }\n        // (0.29: x itself is the last element, as Rust's: a clone fewer)\n        let n = self.len();\n        if n == 0 {\n            return;\n        }\n        let mut i: usize = 0;\n        while i + 1 < n {\n            self[i] = x.clone();\n            i += 1;\n");
    buf_str(out, c"        }\n        self[n - 1] = x;\n    }\n\n    // A Vec of clones of its elements, on a.\n    #[effects(T, A)]\n    pub fn to_vec_in<A: Allocator>(&self, a: A) -> Vec<T, A>\n        where\n            T: Clone,\n    {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(self.len(), a);\n        v.extend_from_slice(self);\n        v\n    }\n\n    // n copies of it, end to end, on a.\n    #[effects(T, A)]\n    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> Vec<T, A>\n        where\n            T: Copy,\n    {\n        let mut v: Vec<T, A> = Vec::with_capacity_in(self.len() * n, a);\n        let mut i: usize = 0;\n        while i < n {\n            v.extend_from_slice(self);\n            i += 1;\n        }\n        v\n    }\n\n    #[effects()]\n    pub fn as_ptr(&self) -> *const T {\n        // Built in: the data word of the reference (a view's `ptr` today).\n        self.ptr\n    }\n\n    #[effects()]\n    pub fn as_mut_ptr(&mut self) -> *mut T {\n        self.ptr as *mut T\n    }\n}\n\n// (0.29) What only a slice of bytes has.\nimpl [u8] {\n    // The index of the first byte equal to x, or None: C's memchr (the\n    // memchr crate's `memchr(x, s)`, bstr's `find_byte`). The search a\n    // loop or `iter().position(..)` writes costs a compare and a bounds\n    // check per byte; this reads the bytes as words. str's `find`,\n    // `split` and `lines` search with it.\n    #[effects(unsafe)]\n    pub fn find_byte(&self, x: u8) -> Option<usize> {\n        // UNSAFE: C's memchr over the slice's bytes.\n        // SAFETY: the slice is len() readable bytes; byte_index reads no\n        // more and returns an index below len().\n        unsafe { crate::ptr::byte_index(self.as_ptr(), self.len(), x) }\n    }\n}\n\n// sort_unstable_by's heap: sifts v[i] down within v[..end].\nfn sift_down<T, F: FnMut(&T, &T) -> Ordering>(v: &mut [T], i: usize, end: usize, compare: &mut F) {\n    let mut root = i;\n    loop {\n        let mut child = 2 * root + 1;\n");
    buf_str(out, c"        if child >= end {\n            return;\n        }\n        if child + 1 < end && compare(&v[child], &v[child + 1]) == Ordering::Less {\n            child += 1;\n        }\n        if compare(&v[root], &v[child]) != Ordering::Less {\n            return;\n        }\n        v.swap(root, child);\n        root = child;\n    }\n}\n\n// What indexes a T (a slice or a str): usize for one element, the ranges\n// for a subslice. Sealed: only std implements it. `s[i]` and `s.get(i)`\n// go through it, so one `get` takes an index or a range.\npub trait SliceIndex<T: ?Sized> {\n    type Output: ?Sized;\n\n    fn get(self, slice: &T) -> Option<&Self::Output>;\n    fn get_mut(self, slice: &mut T) -> Option<&mut Self::Output>;\n    // Panics when out of bounds.\n    fn index(self, slice: &T) -> &Self::Output;\n    fn index_mut(self, slice: &mut T) -> &mut Self::Output;\n}\n\nimpl<T> SliceIndex<[T]> for usize {\n    type Output = T;\n\n    fn get(self, slice: &[T]) -> Option<&T> {\n        if self < slice.len() {\n            let p = slice.as_ptr();\n            // UNSAFE: a reference made from the slice's pointer (the primitive\n            // under `s[i]`).\n            // SAFETY: self < len, so element self is in the slice and initialized;\n            // the reference lives as long as the slice's borrow.\n            Option::Some(unsafe { &*p.add(self) })\n        } else {\n            Option::None\n        }\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut T> {\n        if self < slice.len() {\n            let p = slice.as_mut_ptr();\n            // UNSAFE: as get's.\n            // SAFETY: self < len; the &mut lives as long as the slice's &mut.\n            Option::Some(unsafe { &mut *p.add(self) })\n        } else {\n            Option::None\n        }\n    }\n\n    fn index(self, slice: &[T]) -> &T {\n        let n = slice.len();\n        match self.get(slice) {\n            Option::Some(x) => x,\n            Option::None => crate::panic::panic(\n");
    buf_str(out, c"                \"index out of bounds: the len is {} but the index is {}\", n, self),\n        }\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut T {\n        let n = slice.len();\n        match self.get_mut(slice) {\n            Option::Some(x) => x,\n            Option::None => crate::panic::panic(\n                \"index out of bounds: the len is {} but the index is {}\", n, self),\n        }\n    }\n}\n\nimpl<T> SliceIndex<[T]> for Range<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        if self.start > self.end || self.end > slice.len() {\n            return Option::None;\n        }\n        let p = slice.as_ptr();\n        // UNSAFE: a subslice made from the slice's pointer (the primitive under\n        // `&s[a..b]`).\n        // SAFETY: start <= end <= len, so [start, end) lies in the slice; it\n        // lives as long as the slice's borrow.\n        Option::Some(unsafe { from_raw_parts(p.add(self.start), self.end - self.start) })\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        if self.start > self.end || self.end > slice.len() {\n            return Option::None;\n        }\n        let p = slice.as_mut_ptr();\n        // UNSAFE: as get's.\n        // SAFETY: start <= end <= len; the &mut lives as long as the slice's &mut.\n        Option::Some(unsafe { from_raw_parts_mut(p.add(self.start), self.end - self.start) })\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        let n = slice.len();\n        if self.start > self.end {\n            crate::panic::panic(\"slice index starts at {} but ends at {}\", self.start, self.end);\n        }\n        if self.end > n {\n            crate::panic::panic(\"range end index {} out of range for slice of length {}\", self.end,\n                n);\n        }\n        match self.get(slice) {\n            Option::Some(s) => s,\n            Option::None => crate::panic::unreachable(),\n        }\n    }\n\n");
    buf_str(out, c"    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        let n = slice.len();\n        if self.start > self.end {\n            crate::panic::panic(\"slice index starts at {} but ends at {}\", self.start, self.end);\n        }\n        if self.end > n {\n            crate::panic::panic(\"range end index {} out of range for slice of length {}\", self.end,\n                n);\n        }\n        match self.get_mut(slice) {\n            Option::Some(s) => s,\n            Option::None => crate::panic::unreachable(),\n        }\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeInclusive<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        if *self.end() == usize::MAX {\n            return Option::None;\n        }\n        (*self.start()..*self.end() + 1).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        if *self.end() == usize::MAX {\n            return Option::None;\n        }\n        (*self.start()..*self.end() + 1).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        if *self.end() == usize::MAX {\n            crate::panic::panic(\"attempted to index slice up to maximum usize\");\n        }\n        (*self.start()..*self.end() + 1).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        if *self.end() == usize::MAX {\n            crate::panic::panic(\"attempted to index slice up to maximum usize\");\n        }\n        (*self.start()..*self.end() + 1).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeFrom<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (self.start..slice.len()).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        let n = slice.len();\n        (self.start..n).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (self.start..slice.len()).index(slice)\n    }\n\n");
    buf_str(out, c"    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        let n = slice.len();\n        (self.start..n).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeTo<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (0..self.end).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        (0..self.end).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (0..self.end).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        (0..self.end).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeToInclusive<usize> {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        (0..=self.end).get(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        (0..=self.end).get_mut(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        (0..=self.end).index(slice)\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        (0..=self.end).index_mut(slice)\n    }\n}\n\nimpl<T> SliceIndex<[T]> for RangeFull {\n    type Output = [T];\n\n    fn get(self, slice: &[T]) -> Option<&[T]> {\n        Option::Some(slice)\n    }\n\n    fn get_mut(self, slice: &mut [T]) -> Option<&mut [T]> {\n        Option::Some(slice)\n    }\n\n    fn index(self, slice: &[T]) -> &[T] {\n        slice\n    }\n\n    fn index_mut(self, slice: &mut [T]) -> &mut [T] {\n        slice\n    }\n}\n\n// `s[i]` and `&s[a..b]`: built in for slices in 0.27.0; this is the trait's.\nimpl<T, I: SliceIndex<[T]>> Index<I> for [T] {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\nimpl<T, I: SliceIndex<[T]>> IndexMut<I> for [T] {\n    fn index_mut(&mut self, index: I) -> &mut I::Output {\n        index.index_mut(self)\n    }\n}\n\n// Element by element; any two slices whose elements compare.\n// mvs: [T]::impl Eq\n");
    buf_str(out, c"// std2: changed: PartialEq over any [T] (MVS: Eq for [u8] and structural ==)\nimpl<T: PartialEq<U>, U> PartialEq<[U]> for [T] {\n    fn eq(&self, other: &[U]) -> bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        if crate::mem::is_bytewise_eq::<T, U>() {\n            // UNSAFE: the two slices compared as blocks of bytes (memcmp): a\n            // compare and two bounds checks per element otherwise (the\n            // compiler's assembler compares every line with its memo, every\n            // name with its symbol's). For slices of a few bytes the call\n            // costs about 22 instructions more than the loop did, where\n            // this is inlined into a loop that had no call (measured:\n            // bench/std/hash_str's keys of 1 to 4 bytes in the table's\n            // probe, 4.6% of the run). Tried and no better there: the\n            // loop kept below 16 bytes (4.1%), this function inline or\n            // never inline, the compare out of line, cold or called last\n            // (6.9% to 8.2%).\n            // SAFETY: T and U are one integer type or bool (is_bytewise_eq):\n            // no padding, and equal values are equal bytes; both slices\n            // have len() elements (tested above), so len() * size_of::<T>()\n            // readable bytes each.\n            return unsafe {\n                crate::ptr::bytes_equal(self.as_ptr() as *const u8, other.as_ptr() as *const u8,\n                    self.len() * crate::mem::size_of::<T>())\n            };\n        }\n        let mut i: usize = 0;\n        while i < self.len() {\n            if self[i] != other[i] {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n}\n\nimpl<T: Eq> Eq for [T] {}\n\n// Lexicographic.\nimpl<T: PartialOrd> PartialOrd for [T] {\n    fn partial_cmp(&self, other: &[T]) -> Option<Ordering> {\n        let n = crate::cmp::min(self.len(), other.len());\n");
    buf_str(out, c"        let mut i: usize = 0;\n        while i < n {\n            match self[i].partial_cmp(&other[i]) {\n                Option::Some(Ordering::Equal) => {}\n                c => return c,\n            }\n            i += 1;\n        }\n        self.len().partial_cmp(&other.len())\n    }\n}\n\n// mvs: [T]::impl Ord\n// std2: changed: Ord over any [T] (MVS: Ord for [u8])\nimpl<T: Ord> Ord for [T] {\n    fn cmp(&self, other: &[T]) -> Ordering {\n        let n = crate::cmp::min(self.len(), other.len());\n        let mut i: usize = 0;\n        while i < n {\n            match self[i].cmp(&other[i]) {\n                Ordering::Equal => {}\n                c => return c,\n            }\n            i += 1;\n        }\n        self.len().cmp(&other.len())\n    }\n}\n\n// The length, then each element.\n// mvs: [T]::impl Hash\n// std2: changed: Hash over any [T] (MVS: Hash for [u8])\nimpl<T: Hash> Hash for [T] {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_usize(self.len());\n        Hash::hash_slice(self, state)\n    }\n}\n\n// `[1, 2, 3]`.\n// mvs: [T]::impl Debug\n// std2: changed: Debug over any [T] (MVS: Debug for [u8])\nimpl<T: Debug> Debug for [T] {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_list().entries(self.iter()).finish()\n    }\n}\n\n// `[1, 2]`: an array's Debug is its slice's. Compiler-provided for every\n// N (array_builtin, as Vec::from_in).\n#[array_builtin(N)]\nimpl<T: Debug> Debug for [T; N] {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&(*self)[..], f)\n    }\n}\n\n// An array's clone: each element's (plan §6's built-in array impls, by\n// `#[array_builtin]` until const generics).\n#[array_builtin(N)]\nimpl<T: Clone> Clone for [T; N] {\n    fn clone(&self) -> [T; N] {\n        // UNSAFE: the array is made from a bitwise copy of self whose every\n        // element is then overwritten, without a drop, by its clone: safe\n");
    buf_str(out, c"        // Rust has no array of N clones before const generics.\n        // SAFETY: out is N initialized T's, each slot written once with\n        // ptr::write (the bitwise copies are never dropped: no slot keeps\n        // one); a panicking clone ends the program (std2's panic does not\n        // unwind), so no half-made out is dropped.\n        unsafe {\n            let mut out: [T; N] = crate::ptr::read(self as *const [T; N]);\n            let p = &mut out as *mut [T; N] as *mut T;\n            for i in 0..N {\n                crate::ptr::write(p.add(i), (*self)[i].clone());\n            }\n            out\n        }\n    }\n}\n\n// Arrays compare and hash as their slices.\n#[array_builtin(N)]\nimpl<T: PartialEq<U>, U> PartialEq<[U; N]> for [T; N] {\n    fn eq(&self, other: &[U; N]) -> bool {\n        (*self)[..] == (*other)[..]\n    }\n}\n\n#[array_builtin(N)]\nimpl<T: Eq> Eq for [T; N] {}\n\n#[array_builtin(N)]\nimpl<T: PartialOrd> PartialOrd for [T; N] {\n    fn partial_cmp(&self, other: &[T; N]) -> Option<Ordering> {\n        (*self)[..].partial_cmp(&(*other)[..])\n    }\n}\n\n#[array_builtin(N)]\nimpl<T: Ord> Ord for [T; N] {\n    fn cmp(&self, other: &[T; N]) -> Ordering {\n        (*self)[..].cmp(&(*other)[..])\n    }\n}\n\n#[array_builtin(N)]\nimpl<T: Hash> Hash for [T; N] {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        (*self)[..].hash(state)\n    }\n}\n\n// `for x in &arr`, `for x in &mut arr`: the slice's iterators.\n#[array_builtin(N)]\nimpl<'a, T> IntoIterator for &'a [T; N] {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        (*self)[..].iter()\n    }\n}\n\n#[array_builtin(N)]\nimpl<'a, T> IntoIterator for &'a mut [T; N] {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        (*self)[..].iter_mut()\n    }\n}\n\n// A slice, and an array, view as a slice (`fs::write(p, b\"..\")`: C is\n// &[u8; N], an AsRef<[u8]>).\n");
    buf_str(out, c"impl<T> AsRef<[T]> for [T] {\n    fn as_ref(&self) -> &[T] {\n        self\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> AsRef<[T]> for [T; N] {\n    fn as_ref(&self) -> &[T] {\n        &(*self)[..]\n    }\n}\n\n// `slice.to_owned_in(a)`: a Vec<T, A> of clones.\nimpl<T: Clone, A: Allocator> ToOwnedIn<A> for [T] {\n    type Owned = Vec<T, A>;\n\n    fn to_owned_in(&self, a: A) -> Vec<T, A> {\n        self.to_vec_in(a)\n    }\n}\n\n// later: impl_for_ref\nimpl<'a, T> Default for &'a [T] {\n    fn default() -> &'a [T] {\n        // UNSAFE: an empty slice made from a dangling, aligned pointer (what\n        // `&[]` promotes to: no element is ever read).\n        // SAFETY: length 0, so no memory is reached; the pointer is non-null\n        // and aligned for T, as from_raw_parts asks.\n        unsafe { from_raw_parts(crate::ptr::NonNull::<T>::dangling().as_ptr() as *const T, 0) }\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a [T] {\n    type Item = &'a T;\n    type IntoIter = Iter<'a, T>;\n\n    fn into_iter(self) -> Iter<'a, T> {\n        self.iter()\n    }\n}\n\nimpl<'a, T> IntoIterator for &'a mut [T] {\n    type Item = &'a mut T;\n    type IntoIter = IterMut<'a, T>;\n\n    fn into_iter(self) -> IterMut<'a, T> {\n        self.iter_mut()\n    }\n}\n\n// [T]::iter's iterator: &T's, from either end.\npub struct Iter<'a, T> {\n    v: &'a [T],\n}\n\nimpl<'a, T> Iter<'a, T> {\n    // What is left, as a slice.\n    #[effects()]\n    pub fn as_slice(&self) -> &'a [T] {\n        self.v\n    }\n}\n\nimpl<'a, T> Clone for Iter<'a, T> {\n    fn clone(&self) -> Iter<'a, T> {\n        Iter { v: self.v }\n    }\n}\n\nimpl<'a, T> Iterator for Iter<'a, T> {\n    type Item = &'a T;\n\n    fn next(&mut self) -> Option<&'a T> {\n        match self.v.split_first() {\n            Option::Some((x, rest)) => {\n                self.v = rest;\n                Option::Some(x)\n            }\n            Option::None => Option::None,\n        }\n    }\n\n");
    buf_str(out, c"    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.v.len(), Option::Some(self.v.len()))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Iter<'a, T> {\n    fn next_back(&mut self) -> Option<&'a T> {\n        match self.v.split_last() {\n            Option::Some((x, rest)) => {\n                self.v = rest;\n                Option::Some(x)\n            }\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Iter<'a, T> {}\n\n// [T]::iter_mut's iterator: &mut T's, from either end.\npub struct IterMut<'a, T> {\n    v: &'a mut [T],\n}\n\nimpl<'a, T> IterMut<'a, T> {\n    // What is left, as a &mut slice.\n    #[effects()]\n    pub fn into_slice(self) -> &'a mut [T] {\n        self.v\n    }\n}\n\nimpl<'a, T> Iterator for IterMut<'a, T> {\n    type Item = &'a mut T;\n\n    fn next(&mut self) -> Option<&'a mut T> {\n        let v = crate::mem::replace(&mut self.v, empty_mut());\n        if v.is_empty() {\n            return Option::None;\n        }\n        let (head, rest) = v.split_at_mut(1);\n        self.v = rest;\n        Option::Some(&mut head[0])\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.v.len(), Option::Some(self.v.len()))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for IterMut<'a, T> {\n    fn next_back(&mut self) -> Option<&'a mut T> {\n        let v = crate::mem::replace(&mut self.v, empty_mut());\n        let n = v.len();\n        if n == 0 {\n            return Option::None;\n        }\n        let (rest, tail) = v.split_at_mut(n - 1);\n        self.v = rest;\n        Option::Some(&mut tail[0])\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for IterMut<'a, T> {}\n\n// [T]::chunks's iterator.\npub struct Chunks<'a, T> {\n    v: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for Chunks<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.v.is_empty() {\n            return Option::None;\n        }\n");
    buf_str(out, c"        let n = crate::cmp::min(self.size, self.v.len());\n        let (head, tail) = self.v.split_at(n);\n        self.v = tail;\n        Option::Some(head)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = if self.v.is_empty() { 0 } else { (self.v.len() + self.size - 1) / self.size };\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Chunks<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        let n = self.v.len();\n        if n == 0 {\n            return Option::None;\n        }\n        let r = n % self.size;\n        let last = if r == 0 { self.size } else { r };\n        let (head, tail) = self.v.split_at(n - last);\n        self.v = head;\n        Option::Some(tail)\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Chunks<'a, T> {}\n\n// [T]::chunks_mut's iterator.\npub struct ChunksMut<'a, T> {\n    v: &'a mut [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for ChunksMut<'a, T> {\n    type Item = &'a mut [T];\n\n    fn next(&mut self) -> Option<&'a mut [T]> {\n        let v = crate::mem::replace(&mut self.v, empty_mut());\n        if v.is_empty() {\n            return Option::None;\n        }\n        let n = crate::cmp::min(self.size, v.len());\n        let (head, tail) = v.split_at_mut(n);\n        self.v = tail;\n        Option::Some(head)\n    }\n}\n\n// [T]::chunks_exact's iterator.\npub struct ChunksExact<'a, T> {\n    v: &'a [T],\n    rem: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> ChunksExact<'a, T> {\n    // The elements past the last whole chunk.\n    #[effects()]\n    pub fn remainder(&self) -> &'a [T] {\n        self.rem\n    }\n}\n\nimpl<'a, T> Iterator for ChunksExact<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.v.len() < self.size {\n            return Option::None;\n        }\n        let (head, tail) = self.v.split_at(self.size);\n        self.v = tail;\n        Option::Some(head)\n    }\n\n");
    buf_str(out, c"    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = self.v.len() / self.size;\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for ChunksExact<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        let n = self.v.len();\n        if n < self.size {\n            return Option::None;\n        }\n        let (head, tail) = self.v.split_at(n - self.size);\n        self.v = head;\n        Option::Some(tail)\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for ChunksExact<'a, T> {}\n\n// [T]::windows's iterator.\npub struct Windows<'a, T> {\n    v: &'a [T],\n    size: usize,\n}\n\nimpl<'a, T> Iterator for Windows<'a, T> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.size > self.v.len() {\n            return Option::None;\n        }\n        let w = &self.v[..self.size];\n        self.v = &self.v[1..];\n        Option::Some(w)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let n = if self.size > self.v.len() { 0 } else { self.v.len() - self.size + 1 };\n        (n, Option::Some(n))\n    }\n}\n\nimpl<'a, T> DoubleEndedIterator for Windows<'a, T> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        let n = self.v.len();\n        if self.size > n {\n            return Option::None;\n        }\n        let w = &self.v[n - self.size..];\n        self.v = &self.v[..n - 1];\n        Option::Some(w)\n    }\n}\n\nimpl<'a, T> ExactSizeIterator for Windows<'a, T> {}\n\n// [T]::split's iterator.\npub struct Split<'a, T, P> {\n    v: &'a [T],\n    pred: P,\n    finished: bool,\n}\n\nimpl<'a, T, P: FnMut(&T) -> bool> Iterator for Split<'a, T, P> {\n    type Item = &'a [T];\n\n    fn next(&mut self) -> Option<&'a [T]> {\n        if self.finished {\n            return Option::None;\n        }\n        let mut i: usize = 0;\n        while i < self.v.len() {\n            if (self.pred)(&self.v[i]) {\n                let head = &self.v[..i];\n");
    buf_str(out, c"                self.v = &self.v[i + 1..];\n                return Option::Some(head);\n            }\n            i += 1;\n        }\n        self.finished = true;\n        Option::Some(self.v)\n    }\n}\n\nimpl<'a, T, P: FnMut(&T) -> bool> DoubleEndedIterator for Split<'a, T, P> {\n    fn next_back(&mut self) -> Option<&'a [T]> {\n        if self.finished {\n            return Option::None;\n        }\n        let mut i = self.v.len();\n        while i > 0 {\n            i -= 1;\n            if (self.pred)(&self.v[i]) {\n                let tail = &self.v[i + 1..];\n                self.v = &self.v[..i];\n                return Option::Some(tail);\n            }\n        }\n        self.finished = true;\n        Option::Some(self.v)\n    }\n}\n// ---- end mod std::slice ----\n}\n// ---- mod std::array ----\npub mod array {\n// std::array: an array's by-value iterator. Its impls are compiler-provided\n// for every length N (`#[array_builtin(N)]`, F15.3) until const generics.\n\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, IntoIterator, Iterator};\nuse crate::marker::PhantomData;\nuse crate::mem::ManuallyDrop;\nuse crate::option::Option;\n\n// `[T; N]::into_iter`'s: the elements by value, each once; the ones not\n// yielded are dropped with it.\n// (Rust's is IntoIter<T, const N: usize>; const generics, 0.29, make it so)\n// std2: changed: IntoIter<T, [T; N]> until const generics (FL13)\npub struct IntoIter<T, Arr> {\n    data: ManuallyDrop<Arr>,\n    start: usize,\n    end: usize,\n    marker: PhantomData<T>,\n}\n\n#[array_builtin(N)]\nimpl<T> IntoIterator for [T; N] {\n    type Item = T;\n    type IntoIter = IntoIter<T, [T; N]>;\n\n    fn into_iter(self) -> IntoIter<T, [T; N]> {\n        IntoIter { data: ManuallyDrop::new(self), start: 0, end: N, marker: PhantomData }\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> IntoIter<T, [T; N]> {\n    // The address of element i.\n    fn slot(&mut self, i: usize) -> *mut T {\n");
    buf_str(out, c"        let base = &mut *self.data as *mut [T; N] as *mut T;\n        // UNSAFE: an offset in the array.\n        // SAFETY: i < N (start <= i < end <= N at every call).\n        unsafe { base.add(i) }\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> Iterator for IntoIter<T, [T; N]> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        let p = self.slot(self.start);\n        self.start += 1;\n        // UNSAFE: moves element start out.\n        // SAFETY: it was in [start, end), initialized, and start moving\n        // past it means it is read once.\n        Option::Some(unsafe { crate::ptr::read(p as *const T) })\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        (self.end - self.start, Option::Some(self.end - self.start))\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> DoubleEndedIterator for IntoIter<T, [T; N]> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.start == self.end {\n            return Option::None;\n        }\n        self.end -= 1;\n        let p = self.slot(self.end);\n        // UNSAFE: moves element end out.\n        // SAFETY: it was in [start, end) and, end moving below it, is read once.\n        Option::Some(unsafe { crate::ptr::read(p as *const T) })\n    }\n}\n\n#[array_builtin(N)]\nimpl<T> ExactSizeIterator for IntoIter<T, [T; N]> {}\n\n#[array_builtin(N)]\nimpl<T> Drop for IntoIter<T, [T; N]> {\n    fn drop(&mut self) {\n        while self.start < self.end {\n            let p = self.slot(self.start);\n            self.start += 1;\n            // UNSAFE: drops an element not yielded.\n            // SAFETY: [start, end) is initialized, each dropped once (start\n            // moved past it first); the array itself is a ManuallyDrop.\n            unsafe { crate::ptr::drop_in_place(p) };\n        }\n    }\n}\n// ---- end mod std::array ----\n}\n// ---- mod std::str ----\npub mod str {\n");
    buf_str(out, c"// std::str: the methods of str, UTF-8 text, always behind a reference\n// (`&str`: MVS's `str` view), its iterators, Pattern, FromStr and\n// from_utf8. A String has them all through Deref. What reads returns\n// views of the text (`trim`, `split`, `strip_prefix`); what allocates\n// takes an allocator, Rust's name with `_in` (`to_uppercase_in(a)`,\n// `replace_in(from, to, a)`: plan §2). Indices are byte offsets, usize.\n// The text's code points are `char`s (0.27.2: the rust front's char\n// type; MVS had none and used u32).\n\nuse crate::alloc::Allocator;\nuse crate::borrow::ToOwnedIn;\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::AsRef;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::{DoubleEndedIterator, Iterator};\nuse crate::ops::{Index, Range, RangeFrom, RangeFull, RangeInclusive, RangeTo, RangeToInclusive};\nuse crate::option::Option;\nuse crate::option::Option::{None, Some};\nuse crate::result::Result;\nuse crate::result::Result::{Err, Ok};\nuse crate::slice::SliceIndex;\nuse crate::string::String;\n\n// (std::str::lossy_next and ascii_printable_prefix_len, where the old std\n// had them: std::unicode's, called from here: std::unicode is read only\n// by a program, or a function it reaches, that names `unicode`)\n\n// The code point at v[*pos] (pos is less than v's length), and pos moved\n// past it; a broken sequence reads as U+FFFD and is skipped whole.\n#[inline]\n#[effects(panic)]\npub fn lossy_next(v: &[u8], pos: &mut usize) -> u32 {\n    crate::unicode::lossy_next(v, pos)\n}\n\n// The length of v's longest prefix of printable ASCII, 0x20 to 0x7E.\n#[inline]\n#[effects(panic)]\npub fn ascii_printable_prefix_len(v: &[u8]) -> usize {\n    crate::unicode::ascii_printable_prefix_len(v)\n}\n\nimpl str {\n    // bytes as a str when they are UTF-8 (Rust 1.87's inherent form;\n    // `std::str::from_utf8` too).\n");
    buf_str(out, c"    // std2: changed: &[u8] to &str\n    #[effects(panic, diverge)]\n    pub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {\n        from_utf8(v)\n    }\n\n    #[effects(unsafe)]\n    // UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n    // SAFETY: a contract on the caller: v is UTF-8.\n    pub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {\n        // UNSAFE: the free function's contract, passed on.\n        // SAFETY: the caller's: v is UTF-8.\n        unsafe { from_utf8_unchecked(v) }\n    }\n\n    // Its length in bytes.\n    #[effects()]\n    pub fn len(&self) -> usize {\n        self.as_bytes().len()\n    }\n\n    #[effects()]\n    pub fn is_empty(&self) -> bool {\n        self.len() == 0\n    }\n\n    #[effects()]\n    pub fn as_bytes(&self) -> &[u8] {\n        // A &str is a &[u8] that promises UTF-8, the same fat pointer (built\n        // in: Rust's core casts the pointer, `&*(self as *const str as\n        // *const [u8])`).\n        self as &[u8]\n    }\n\n    // The same bytes, writable as a str (an ASCII case change in place).\n    #[effects()]\n    pub fn as_ptr(&self) -> *const u8 {\n        self.as_bytes().as_ptr()\n    }\n\n    // Whether byte i starts a code point (or is the end).\n    #[effects(panic)]\n    pub fn is_char_boundary(&self, i: usize) -> bool {\n        if i == 0 {\n            return true;\n        }\n        let b = self.as_bytes();\n        if i < b.len() {\n            // not a continuation byte (10xx_xxxx)\n            b[i] & 0xC0 != 0x80\n        } else {\n            i == b.len()\n        }\n    }\n\n    // The closest byte index at or below i that starts a code point: i\n    // itself when it does, len() when i is past the end (Rust's).\n    #[effects(panic)]\n    pub fn floor_char_boundary(&self, i: usize) -> usize {\n        if i >= self.len() {\n            return self.len();\n        }\n        let mut k = i;\n        // (a code point has at most three continuation bytes, and byte 0\n");
    buf_str(out, c"        // starts one)\n        for _ in 0..3 {\n            if self.is_char_boundary(k) {\n                break;\n            }\n            k -= 1;\n        }\n        k\n    }\n\n    // The closest byte index at or above i that starts a code point, or\n    // len() (when i is past the end too).\n    #[effects(panic)]\n    pub fn ceil_char_boundary(&self, i: usize) -> usize {\n        if i >= self.len() {\n            return self.len();\n        }\n        let mut k = i;\n        for _ in 0..3 {\n            if self.is_char_boundary(k) {\n                break;\n            }\n            k += 1;\n        }\n        k\n    }\n\n    #[effects()]\n    pub fn is_ascii(&self) -> bool {\n        for b in self.as_bytes() {\n            if *b >= 0x80 {\n                return false;\n            }\n        }\n        true\n    }\n\n    // The subslice a byte range names; None when out of bounds or not on\n    // char boundaries.\n    #[effects(I)]\n    pub fn get<I: SliceIndex<str>>(&self, i: I) -> Option<&I::Output> {\n        i.get(self)\n    }\n\n    // [0, mid) and [mid, len); panics when mid is not a char boundary.\n    #[effects(panic)]\n    pub fn split_at(&self, mid: usize) -> (&str, &str) {\n        (&self[..mid], &self[mid..])\n    }\n\n    // Its code points.\n    // std2: changed: yields char (MVS: u32)\n    #[effects()]\n    pub fn chars(&self) -> Chars<'_> {\n        Chars { rest: self }\n    }\n\n    // Its code points with their byte offsets.\n    // std2: changed: yields (usize, char) (MVS: (i64, u32))\n    #[effects()]\n    pub fn char_indices(&self) -> CharIndices<'_> {\n        CharIndices { front: 0, chars: self.chars() }\n    }\n\n    // Its bytes.\n    // std2: changed: a Bytes<'_> of u8 (MVS: a SliceIter<u8>)\n    #[effects()]\n    pub fn bytes(&self) -> Bytes<'_> {\n        Bytes { inner: self.as_bytes().iter() }\n    }\n\n    // Its lines, without their \"\\n\" or \"\\r\\n\"; a last empty line is not one.\n    #[effects()]\n");
    buf_str(out, c"    pub fn lines(&self) -> Lines<'_> {\n        Lines { rest: self }\n    }\n\n    // The pieces between the matches of p.\n    #[effects(P)]\n    pub fn split<P: Pattern>(&self, p: P) -> Split<'_, P> {\n        Split::new(self, p, true)\n    }\n\n    // The same, from the end.\n    #[effects(P)]\n    pub fn rsplit<P: Pattern>(&self, p: P) -> RSplit<'_, P> {\n        RSplit { inner: Split::new(self, p, true) }\n    }\n\n    // At most n pieces: the last holds the rest.\n    // std2: changed: n is usize\n    #[effects(P)]\n    pub fn splitn<P: Pattern>(&self, n: usize, p: P) -> SplitN<'_, P> {\n        SplitN { inner: Split::new(self, p, true), count: n }\n    }\n\n    #[effects(P)]\n    pub fn rsplitn<P: Pattern>(&self, n: usize, p: P) -> RSplitN<'_, P> {\n        RSplitN { inner: Split::new(self, p, true), count: n }\n    }\n\n    // split, without an empty last piece (\"a,b,\" gives \"a\" and \"b\").\n    #[effects(P)]\n    pub fn split_terminator<P: Pattern>(&self, p: P) -> SplitTerminator<'_, P> {\n        SplitTerminator { inner: Split::new(self, p, false) }\n    }\n\n    // split, each piece with the match that ends it.\n    #[effects(P)]\n    pub fn split_inclusive<P: Pattern>(&self, p: P) -> SplitInclusive<'_, P> {\n        SplitInclusive { inner: Split::new(self, p, false) }\n    }\n\n    // The pieces between runs of Unicode white space.\n    #[effects()]\n    pub fn split_whitespace(&self) -> SplitWhitespace<'_> {\n        SplitWhitespace { rest: self }\n    }\n\n    // The pieces between runs of ASCII white space.\n    #[effects()]\n    pub fn split_ascii_whitespace(&self) -> SplitAsciiWhitespace<'_> {\n        SplitAsciiWhitespace { rest: self }\n    }\n\n    // Before and after the first match of p.\n    #[effects(panic, diverge, P)]\n    pub fn split_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((a, b)) => Some((&self[..a], &self[b..])),\n");
    buf_str(out, c"            None => None,\n        }\n    }\n\n    // Before and after the last match of p.\n    #[effects(panic, P)]\n    pub fn rsplit_once<P: Pattern>(&self, p: P) -> Option<(&str, &str)> {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((a, b)) => Some((&self[..a], &self[b..])),\n            None => None,\n        }\n    }\n\n    // The matches of p.\n    #[effects()]\n    pub fn matches<P: Pattern>(&self, p: P) -> Matches<'_, P> {\n        Matches { hay: self, at: 0, pat: p }\n    }\n\n    // The matches of p with their byte offsets.\n    #[effects()]\n    pub fn match_indices<P: Pattern>(&self, p: P) -> MatchIndices<'_, P> {\n        MatchIndices { hay: self, at: 0, pat: p }\n    }\n\n    // The byte offset of the first match of p.\n    #[effects(panic, diverge, P)]\n    pub fn find<P: Pattern>(&self, p: P) -> Option<usize> {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((a, _)) => Some(a),\n            None => None,\n        }\n    }\n\n    // The byte offset of the last match of p.\n    #[effects(panic, diverge, P)]\n    pub fn rfind<P: Pattern>(&self, p: P) -> Option<usize> {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((a, _)) => Some(a),\n            None => None,\n        }\n    }\n\n    #[effects(P)]\n    pub fn contains<P: Pattern>(&self, p: P) -> bool {\n        self.find(p).is_some()\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn starts_with<P: Pattern>(&self, p: P) -> bool {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((a, _)) => a == 0,\n            None => false,\n        }\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn ends_with<P: Pattern>(&self, p: P) -> bool {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((_, b)) => b == self.len(),\n            None => false,\n        }\n    }\n\n");
    buf_str(out, c"    // The rest after p, when it starts with p.\n    #[effects(panic, diverge, P)]\n    pub fn strip_prefix<P: Pattern>(&self, p: P) -> Option<&str> {\n        let mut p = p;\n        match p.next_match(self, 0) {\n            Some((0, b)) => Some(&self[b..]),\n            _ => None,\n        }\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn strip_suffix<P: Pattern>(&self, p: P) -> Option<&str> {\n        let mut p = p;\n        match p.next_match_back(self, self.len()) {\n            Some((a, b)) if b == self.len() => Some(&self[..a]),\n            _ => None,\n        }\n    }\n\n    // Without leading and trailing Unicode white space.\n    #[effects(panic, diverge)]\n    pub fn trim(&self) -> &str {\n        self.trim_start().trim_end()\n    }\n\n    #[effects(panic, diverge)]\n    pub fn trim_start(&self) -> &str {\n        let mut it = self.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if !c.is_whitespace() {\n                        return &self[i..];\n                    }\n                }\n                None => return \"\",\n            }\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn trim_end(&self) -> &str {\n        let mut it = self.char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if !c.is_whitespace() {\n                        return &self[..i + c.len_utf8()];\n                    }\n                }\n                None => return \"\",\n            }\n        }\n    }\n\n    // Without leading and trailing ASCII white space.\n    #[effects(panic, diverge)]\n    pub fn trim_ascii(&self) -> &str {\n        let b = self.as_bytes();\n        let mut i: usize = 0;\n        let mut j: usize = b.len();\n        while i < j && is_ascii_space(b[i]) {\n            i += 1;\n        }\n        while j > i && is_ascii_space(b[j - 1]) {\n            j -= 1;\n        }\n        &self[i..j]\n");
    buf_str(out, c"    }\n\n    // Without the leading and trailing matches of p.\n    #[effects(panic, diverge, P)]\n    pub fn trim_matches<P: Pattern>(&self, p: P) -> &str {\n        let mut p = p;\n        let mut i: usize = 0;\n        let mut j: usize = self.len();\n        loop {\n            match p.next_match(self, i) {\n                Some((a, b)) if a == i && b > a => i = b,\n                _ => break,\n            }\n        }\n        loop {\n            match p.next_match_back(self, j) {\n                Some((a, b)) if b == j && a < b && a >= i => j = a,\n                _ => break,\n            }\n        }\n        &self[i..j]\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn trim_start_matches<P: Pattern>(&self, p: P) -> &str {\n        let mut p = p;\n        let mut i: usize = 0;\n        loop {\n            match p.next_match(self, i) {\n                Some((a, b)) if a == i && b > a => i = b,\n                _ => break,\n            }\n        }\n        &self[i..]\n    }\n\n    #[effects(panic, diverge, P)]\n    pub fn trim_end_matches<P: Pattern>(&self, p: P) -> &str {\n        let mut p = p;\n        let mut j: usize = self.len();\n        loop {\n            match p.next_match_back(self, j) {\n                Some((a, b)) if b == j && a < b => j = a,\n                _ => break,\n            }\n        }\n        &self[..j]\n    }\n\n    #[effects(panic)]\n    pub fn eq_ignore_ascii_case(&self, other: &str) -> bool {\n        let a = self.as_bytes();\n        let b = other.as_bytes();\n        if a.len() != b.len() {\n            return false;\n        }\n        let mut i: usize = 0;\n        while i < a.len() {\n            if ascii_lower(a[i]) != ascii_lower(b[i]) {\n                return false;\n            }\n            i += 1;\n        }\n        true\n    }\n\n    // Its ASCII letters made lower case, in place.\n    #[effects(panic, diverge, unsafe)]\n    pub fn make_ascii_lowercase(&mut self) {\n");
    buf_str(out, c"        // UNSAFE: the bytes of a &mut str, written.\n        // SAFETY: an ASCII case change maps ASCII bytes to ASCII bytes and leaves\n        // the others, so the text stays UTF-8.\n        let b = unsafe { bytes_mut(self) };\n        let mut i: usize = 0;\n        while i < b.len() {\n            b[i] = ascii_lower(b[i]);\n            i += 1;\n        }\n    }\n\n    #[effects(panic, diverge, unsafe)]\n    pub fn make_ascii_uppercase(&mut self) {\n        // UNSAFE: the bytes of a &mut str, written.\n        // SAFETY: an ASCII case change maps ASCII bytes to ASCII bytes and leaves\n        // the others, so the text stays UTF-8.\n        let b = unsafe { bytes_mut(self) };\n        let mut i: usize = 0;\n        while i < b.len() {\n            b[i] = ascii_upper(b[i]);\n            i += 1;\n        }\n    }\n\n    // The text as a T (`\"42\".parse::<i64>()`): numbers, bool, char.\n    #[effects(F)]\n    pub fn parse<F: FromStr>(&self) -> Result<F, F::Err> {\n        F::from_str(self)\n    }\n\n    // Its width in terminal columns (East Asian wide as 2, combining as 0):\n    // vole's, kept from MVS.\n    // std2: changed: usize\n    #[effects(panic, diverge)]\n    pub fn width(&self) -> usize {\n        let mut n: usize = 0;\n        let mut it = self.graphemes(true);\n        while let Some(g) = it.next() {\n            n += cluster_width(g, false);\n        }\n        n\n    }\n\n    // width, with East Asian ambiguous characters as 2.\n    // std2: changed: usize\n    #[effects(panic, diverge)]\n    pub fn width_cjk(&self) -> usize {\n        let mut n: usize = 0;\n        let mut it = self.graphemes(true);\n        while let Some(g) = it.next() {\n            n += cluster_width(g, true);\n        }\n        n\n    }\n\n    // Its grapheme clusters (UAX #29; extended or legacy): vole's.\n    #[effects()]\n    pub fn graphemes(&self, extended: bool) -> Graphemes<'_> {\n        Graphemes { rest: self, extended: extended }\n    }\n\n");
    buf_str(out, c"    // A String of it, on a.\n    #[effects(A)]\n    pub fn to_string_in<A: Allocator>(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    #[effects(A)]\n    pub fn to_owned_in<A: Allocator>(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_lowercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        // Each char maps alone, but a capital sigma at a word's end, which\n        // is final sigma, as Rust's (Unicode's Final_Sigma context).\n        let mut s = String::with_capacity_in(self.len(), a);\n        let mut it = self.char_indices();\n        while let Some((i, c)) = it.next() {\n            if c == '\\u{3A3}' {\n                let fin = cased_before(&self[..i]) && !cased_after(&self[i + 2..]);\n                s.push(if fin { '\\u{3C2}' } else { '\\u{3C3}' });\n                continue;\n            }\n            let mut m = c.to_lowercase();\n            while let Some(l) = m.next() {\n                s.push(l);\n            }\n        }\n        s\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_uppercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        let mut s = String::with_capacity_in(self.len(), a);\n        let mut it = self.chars();\n        while let Some(c) = it.next() {\n            let mut m = c.to_uppercase();\n            while let Some(u) = m.next() {\n                s.push(u);\n            }\n        }\n        s\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_ascii_lowercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        let mut s = String::from_in(self, a);\n        s.as_mut_str().make_ascii_lowercase();\n        s\n    }\n\n    #[effects(panic, diverge, A)]\n    pub fn to_ascii_uppercase_in<A: Allocator>(&self, a: A) -> String<A> {\n        let mut s = String::from_in(self, a);\n        s.as_mut_str().make_ascii_uppercase();\n        s\n    }\n\n    // A copy with every match of from replaced by to.\n");
    buf_str(out, c"    #[effects(panic, diverge, P, A)]\n    pub fn replace_in<P: Pattern, A: Allocator>(&self, from: P, to: &str, a: A) -> String<A> {\n        let mut result = String::new_in(a);\n        let mut last: usize = 0;\n        let mut it = self.match_indices(from);\n        while let Some((start, part)) = it.next() {\n            result.push_str(&self[last..start]);\n            result.push_str(to);\n            last = start + part.len();\n        }\n        result.push_str(&self[last..]);\n        result\n    }\n\n    // The same, the first n matches.\n    // std2: changed: n is usize\n    #[effects(panic, diverge, P, A)]\n    pub fn replacen_in<P: Pattern,\n        A: Allocator>(&self, from: P, to: &str, n: usize, a: A) -> String<A> {\n        let mut result = String::with_capacity_in(32, a);\n        let mut last: usize = 0;\n        let mut left = n;\n        let mut it = self.match_indices(from);\n        while let Some((start, part)) = it.next() {\n            if left == 0 {\n                break;\n            }\n            left -= 1;\n            result.push_str(&self[last..start]);\n            result.push_str(to);\n            last = start + part.len();\n        }\n        result.push_str(&self[last..]);\n        result\n    }\n\n    // n copies end to end.\n    #[effects(A)]\n    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> String<A> {\n        let mut s = String::with_capacity_in(self.len() * n, a);\n        let mut i: usize = 0;\n        while i < n {\n            s.push_str(self);\n            i += 1;\n        }\n        s\n    }\n}\n\n// v as a str when it is UTF-8.\n// mvs: validate_utf8\n// std2: changed: returns the &str\n#[effects(panic, diverge, unsafe)]\npub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {\n    let n = v.len();\n    // (the ASCII start of v a block at a time: text that is all ASCII is\n    // checked three times faster; after the first byte that is not, byte\n");
    buf_str(out, c"    // by byte: trying blocks again inside the loop cost mixed text a\n    // quarter of its speed)\n    let mut i: usize = ascii_blocks(v, 0);\n    while i < n {\n        let b = v[i];\n        if b < 0x80 {\n            i += 1;\n            continue;\n        }\n        // the sequence's length, and the range its second byte must be in\n        // (no overlong forms, no surrogates, nothing over U+10FFFF)\n        let (w, lo, hi): (usize, u8, u8) = if b >= 0xC2 && b <= 0xDF {\n            (2, 0x80, 0xBF)\n        } else if b == 0xE0 {\n            (3, 0xA0, 0xBF)\n        } else if b == 0xED {\n            (3, 0x80, 0x9F)\n        } else if b >= 0xE1 && b <= 0xEF {\n            (3, 0x80, 0xBF)\n        } else if b == 0xF0 {\n            (4, 0x90, 0xBF)\n        } else if b >= 0xF1 && b <= 0xF3 {\n            (4, 0x80, 0xBF)\n        } else if b == 0xF4 {\n            (4, 0x80, 0x8F)\n        } else {\n            return Err(Utf8Error { valid_up_to: i, error_len: Some(1) });\n        };\n        let mut k: usize = 1;\n        while k < w {\n            if i + k >= n {\n                return Err(Utf8Error { valid_up_to: i, error_len: None });\n            }\n            let c = v[i + k];\n            let ok = if k == 1 { c >= lo && c <= hi } else { c & 0xC0 == 0x80 };\n            if !ok {\n                return Err(Utf8Error { valid_up_to: i, error_len: Some(k as u8) });\n            }\n            k += 1;\n        }\n        i += w;\n    }\n    // UNSAFE: the checked bytes as a str.\n    // SAFETY: every sequence of v was checked to be UTF-8 above.\n    Ok(unsafe { from_utf8_unchecked(v) })\n}\n\n// Where the blocks of sixteen ASCII bytes of v from `from` on end: the\n// index after the last block none of whose bytes has its high bit\n// (from_utf8's fast path).\nfn ascii_blocks(v: &[u8], from: usize) -> usize {\n    let n = v.len();\n    let mut i = from;\n    while i + 16 <= n {\n        let c = &v[i..i + 16];\n");
    buf_str(out, c"        let m = c[0] | c[1] | c[2] | c[3] | c[4] | c[5] | c[6] | c[7] | c[8] | c[9] | c[10] | c[11]\n            | c[12] | c[13] | c[14] | c[15];\n        if m >= 0x80 {\n            break;\n        }\n        i += 16;\n    }\n    i\n}\n\n#[effects(unsafe)]\n// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n// SAFETY: a contract on the caller: v is UTF-8.\npub unsafe fn from_utf8_unchecked(v: &[u8]) -> &str {\n    // A &[u8] that is UTF-8 is a &str: the same fat pointer (built in).\n    // UNSAFE: a pointer cast between [u8] and str, which Rust's core makes too.\n    // SAFETY: str and [u8] have the same layout; the caller promises UTF-8.\n    unsafe { &*(v as *const [u8] as *const str) }\n}\n\n// Why bytes are not UTF-8.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct Utf8Error {\n    valid_up_to: usize,\n    error_len: Option<u8>,\n}\n\nimpl Utf8Error {\n    // The length of the valid prefix.\n    // std2: changed: usize\n    #[effects()]\n    pub fn valid_up_to(&self) -> usize {\n        self.valid_up_to\n    }\n\n    // The length of the bad sequence; None when the input ends inside one.\n    // std2: changed: Option<usize>\n    #[effects()]\n    pub fn error_len(&self) -> Option<usize> {\n        self.error_len.map(|n| n as usize)\n    }\n}\n\nimpl Display for Utf8Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.error_len {\n            Some(n) => {\n                if let Err(e) = f.write_str(\"invalid utf-8 sequence of \") {\n                    return Err(e);\n                }\n                if let Err(e) = f.write_fmt(n) {\n                    return Err(e);\n                }\n                if let Err(e) = f.write_str(\" bytes from index \") {\n                    return Err(e);\n                }\n                f.write_fmt(self.valid_up_to)\n            }\n            None => {\n");
    buf_str(out, c"                if let Err(e) = f.write_str(\"incomplete utf-8 byte sequence from index \") {\n                    return Err(e);\n                }\n                f.write_fmt(self.valid_up_to)\n            }\n        }\n    }\n}\n\n// What can be parsed from text: `s.parse::<T>()`, `T::from_str(s)`.\n#[builtin_impls(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize, f32, f64, bool)]\npub trait FromStr: Sized {\n    type Err;\n\n    fn from_str(s: &str) -> Result<Self, Self::Err>;\n}\n\n// Why an integer did not parse.\n// mvs: ParseIntError\n// std2: changed: a struct with kind() (MVS: an enum)\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseIntError {\n    kind: IntErrorKind,\n}\n\n// What was wrong with an integer's text.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum IntErrorKind {\n    Empty,\n    InvalidDigit,\n    PosOverflow,\n    NegOverflow,\n    // (Rust's, for its NonZero types: no integer here parses to it)\n    Zero,\n}\n\nimpl ParseIntError {\n    #[effects()]\n    pub fn kind(&self) -> &IntErrorKind {\n        &self.kind\n    }\n}\n\n// (for std's from_str_radix, compiler/std/intconv.vl)\n#[effects()]\npub(crate) fn int_error(kind: IntErrorKind) -> ParseIntError {\n    ParseIntError { kind: kind }\n}\n\n// Rust's texts.\nimpl Display for ParseIntError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(match self.kind {\n            IntErrorKind::Empty => \"cannot parse integer from empty string\",\n            IntErrorKind::InvalidDigit => \"invalid digit found in string\",\n            IntErrorKind::PosOverflow => \"number too large to fit in target type\",\n            IntErrorKind::NegOverflow => \"number too small to fit in target type\",\n            IntErrorKind::Zero => \"number would be zero for non-zero type\",\n        })\n    }\n}\n\n// Why a float did not parse.\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseFloatError {\n    empty: bool,\n}\n\n");
    buf_str(out, c"impl Display for ParseFloatError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(if self.empty { \"cannot parse float from empty string\" }\n            else { \"invalid float literal\" })\n    }\n}\n\n// Why a bool did not parse (only \"true\" and \"false\" do).\n#[derive(Clone, PartialEq, Eq, Debug)]\npub struct ParseBoolError;\n\nimpl Display for ParseBoolError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"provided string was not `true` or `false`\")\n    }\n}\n\n// What a str method searches for: a char, a &str, a &String, a &[char]\n// (any of them) or a closure on a char. Sealed: std's impls only; its\n// methods are std's own shape (Rust's Pattern is unstable).\n// std2: changed: char, &str, &[char], FnMut(char) (MVS: str, u8, u32)\npub trait Pattern: Sized {\n    // The byte range of the first match in hay at or after start.\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)>;\n    // The byte range of the last match in hay before end.\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)>;\n}\n\nimpl Pattern for char {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let mut buf = [0u8; 4];\n        let mut s: &str = self.encode_utf8(&mut buf);\n        s.next_match_back(hay, end)\n    }\n}\n\n// mvs: str::impl Pattern\nimpl<'b> Pattern for &'b str {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if start > h.len() || n > h.len() {\n            return None;\n        }\n        if n == 0 {\n            // the empty pattern matches at every char boundary\n");
    buf_str(out, c"            let mut i = start;\n            while !hay.is_char_boundary(i) {\n                i += 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = start;\n        // (0.29) The needle's first byte found by the bytes' block search\n        // among the places that leave room for the rest, then the rest\n        // compared as a block: a one-byte needle (a char of ASCII, \"\\n\") is\n        // the search alone.\n        let last = h.len() - n + 1;\n        while i < last {\n            match h[i..last].find_byte(needle[0]) {\n                Some(k) => i += k,\n                None => return None,\n            }\n            if n == 1 || &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n            i += 1;\n        }\n        None\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        let h = hay.as_bytes();\n        let n = self.len();\n        if end > h.len() || n > end {\n            return None;\n        }\n        if n == 0 {\n            let mut i = end;\n            while !hay.is_char_boundary(i) {\n                i -= 1;\n            }\n            return Some((i, i));\n        }\n        let needle = self.as_bytes();\n        let mut i = end - n + 1;\n        while i > 0 {\n            i -= 1;\n            if h[i] == needle[0] && &h[i..i + n] == needle {\n                return Some((i, i + n));\n            }\n        }\n        None\n    }\n}\n\nimpl<'b, A: Allocator> Pattern for &'b String<A> {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        self.as_str().next_match(hay, start)\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        self.as_str().next_match_back(hay, end)\n    }\n}\n\nimpl<'b> Pattern for &'b [char] {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n");
    buf_str(out, c"        if start > hay.len() {\n            return None;\n        }\n        let mut it = hay[start..].char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if self.contains(&c) {\n                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if self.contains(&c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n}\n\n// later: blanket_impl\nimpl<F: FnMut(char) -> bool> Pattern for F {\n    fn next_match(&mut self, hay: &str, start: usize) -> Option<(usize, usize)> {\n        if start > hay.len() {\n            return None;\n        }\n        let mut it = hay[start..].char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n");
    buf_str(out, c"            }\n        }\n    }\n}\n\n// `&s[a..b]` and `s.get(a..b)`: byte ranges on char boundaries.\nimpl SliceIndex<str> for Range<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of UTF-8 bytes, as a str.\n            // SAFETY: both ends are char boundaries, so the bytes are UTF-8.\n            Some(unsafe { from_utf8_unchecked(&s.as_bytes()[self.start..self.end]) })\n        } else {\n            None\n        }\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.\n            // SAFETY: both ends are char boundaries, so the bytes are UTF-8, and\n            // the result keeps them so (str's methods write only UTF-8).\n            unsafe {\n                let b = bytes_mut(s);\n                Some(str_mut(&mut b[self.start..self.end]))\n            }\n        } else {\n            None\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        let (a, b) = (self.start, self.end);\n        match self.get(s) {\n            Some(r) => r,\n            None => slice_error_fail(s, a, b),\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        let (a, b) = (self.start, self.end);\n        if !(a <= b && s.is_char_boundary(a) && s.is_char_boundary(b)) {\n            slice_error_fail(s, a, b);\n        }\n        // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.\n        // SAFETY: both ends were checked to be char boundaries above.\n        unsafe {\n            let bytes = bytes_mut(s);\n            str_mut(&mut bytes[a..b])\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeInclusive<usize> {\n    type Output = str;\n\n");
    buf_str(out, c"    fn get(self, s: &str) -> Option<&str> {\n        // end < len, so end + 1 cannot overflow\n        if *self.end() >= s.len() {\n            None\n        } else {\n            (*self.start()..*self.end() + 1).get(s)\n        }\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        if *self.end() >= s.len() {\n            None\n        } else {\n            (*self.start()..*self.end() + 1).get_mut(s)\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index(s)\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index_mut(s)\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeFrom<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (self.start..s.len()).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        let n = s.len();\n        (self.start..n).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (self.start..s.len()).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        let n = s.len();\n        (self.start..n).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeTo<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (0..self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeToInclusive<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n");
    buf_str(out, c"        (0..=self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..=self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..=self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..=self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeFull {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        Option::Some(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        Option::Some(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        s\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        s\n    }\n}\n\nimpl<I: SliceIndex<str>> Index<I> for str {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\n// Byte for byte.\nimpl PartialEq for str {\n    fn eq(&self, other: &str) -> bool {\n        self.as_bytes() == other.as_bytes()\n    }\n}\n\nimpl Eq for str {}\n\n// By bytes, which is by code points.\nimpl PartialOrd for str {\n    fn partial_cmp(&self, other: &str) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\nimpl Ord for str {\n    fn cmp(&self, other: &str) -> Ordering {\n        self.as_bytes().cmp(other.as_bytes())\n    }\n}\n\n// Its bytes and a 0xff, as Rust's (so (\"ab\", \"c\") and (\"a\", \"bc\") differ).\nimpl Hash for str {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write(self.as_bytes());\n        state.write_u8(0xff);\n    }\n}\n\nimpl Display for str {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.pad(self)\n    }\n}\n\n// Quoted, with escapes: \"a\\\"b\".\nimpl Debug for str {\n    // terminates: one pass for each char of self (CharIndices ends).\n    #[terminates]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"\\\"\")?;\n        let mut from: usize = 0;\n");
    buf_str(out, c"        let mut it = self.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    let esc = match c {\n                        '\"' => \"\\\\\\\"\",\n                        '\\\\' => \"\\\\\\\\\",\n                        '\\n' => \"\\\\n\",\n                        '\\r' => \"\\\\r\",\n                        '\\t' => \"\\\\t\",\n                        '\\0' => \"\\\\0\",\n                        _ => \"\",\n                    };\n                    // controls, white space but ' ' and (as Rust's) grapheme extenders\n                    // are escaped\n                    let control = c.is_control() || is_extend(c)\n                        || (c.is_whitespace() && c != ' ');\n                    if esc.len() > 0 || control {\n                        f.write_str(&self[from..i])?;\n                        if esc.len() > 0 {\n                            f.write_str(esc)?;\n                        } else {\n                            write_unicode_escape(f, c as u32)?;\n                        }\n                        from = i + c.len_utf8();\n                    }\n                }\n                None => break,\n            }\n        }\n        f.write_str(&self[from..])?;\n        f.write_str(\"\\\"\")\n    }\n}\n\n// `s.to_owned_in(a)`: a String<A>.\nimpl<A: Allocator> ToOwnedIn<A> for str {\n    type Owned = String<A>;\n\n    fn to_owned_in(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n}\n\nimpl AsRef<str> for str {\n    fn as_ref(&self) -> &str {\n        self\n    }\n}\n\nimpl AsRef<[u8]> for str {\n    fn as_ref(&self) -> &[u8] {\n        self.as_bytes()\n    }\n}\n\n// later: impl_for_ref\nimpl<'a> Default for &'a str {\n    fn default() -> &'a str {\n        \"\"\n    }\n}\n\n// ---- The iterators ----\n\n// str::chars's iterator; `.rev()` from the end.\n// mvs: Chars, RevChars, CodePoints\n#[derive(Clone)]\npub struct Chars<'a> {\n    rest: &'a str,\n}\n\n");
    buf_str(out, c"impl<'a> Chars<'a> {\n    // What is left.\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.rest\n    }\n}\n\nimpl<'a> Iterator for Chars<'a> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_first(self.rest.as_bytes());\n        self.rest = &self.rest[n..];\n        Some(c)\n    }\n\n    // (the chars left are the bytes that start one: every byte but the\n    // continuation bytes, 0b10xxxxxx; nothing is decoded)\n    fn count(self) -> usize {\n        let b = self.rest.as_bytes();\n        let mut n: usize = 0;\n        for x in b.iter() {\n            n += ((*x & 0xC0) != 0x80) as usize;\n        }\n        n\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Chars<'a> {\n    fn next_back(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_last(self.rest.as_bytes());\n        self.rest = &self.rest[..self.rest.len() - n];\n        Some(c)\n    }\n}\n\n// str::char_indices's iterator.\n#[derive(Clone)]\npub struct CharIndices<'a> {\n    front: usize,\n    chars: Chars<'a>,\n}\n\nimpl<'a> CharIndices<'a> {\n    // The byte offset of the next char (the length at the end).\n    #[effects()]\n    pub fn offset(&self) -> usize {\n        self.front\n    }\n}\n\nimpl<'a> Iterator for CharIndices<'a> {\n    type Item = (usize, char);\n\n    fn next(&mut self) -> Option<(usize, char)> {\n        let before = self.chars.rest.len();\n        match self.chars.next() {\n            Some(c) => {\n                let i = self.front;\n                self.front += before - self.chars.rest.len();\n                Some((i, c))\n            }\n            None => None,\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for CharIndices<'a> {\n    fn next_back(&mut self) -> Option<(usize, char)> {\n        match self.chars.next_back() {\n");
    buf_str(out, c"            Some(c) => Some((self.front + self.chars.rest.len(), c)),\n            None => None,\n        }\n    }\n}\n\n// str::bytes's iterator.\n#[derive(Clone)]\npub struct Bytes<'a> {\n    inner: crate::slice::Iter<'a, u8>,\n}\n\nimpl<'a> Iterator for Bytes<'a> {\n    type Item = u8;\n\n    fn next(&mut self) -> Option<u8> {\n        self.inner.next().copied()\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Bytes<'a> {\n    fn next_back(&mut self) -> Option<u8> {\n        self.inner.next_back().copied()\n    }\n}\n\n// str::lines's iterator.\n#[derive(Clone)]\npub struct Lines<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for Lines<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        let line = match s.as_bytes().find_byte(0x0A) {\n            Some(i) => {\n                self.rest = &s[i + 1..];\n                &s[..i]\n            }\n            None => {\n                self.rest = \"\";\n                s\n            }\n        };\n        Some(strip_cr(line))\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Lines<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        // the last line's own \"\\n\" is not a line break before an empty line\n        let b = s.as_bytes();\n        let cut = if b[b.len() - 1] == 0x0A { s.len() - 1 } else { s.len() };\n        let body: &str = &s[..cut];\n        let line = match rfind_byte(body.as_bytes(), 0x0A) {\n            Some(i) => {\n                self.rest = &s[..i + 1];\n                &body[i + 1..]\n            }\n            None => {\n                self.rest = \"\";\n                body\n            }\n        };\n        Some(strip_cr(line))\n    }\n}\n\n// str::split's iterator: the pieces of hay[start..end] between the\n");
    buf_str(out, c"// matches; front and back are where the next search from either end\n// starts (None: no more matches that way).\npub struct Split<'a, P> {\n    hay: &'a str,\n    start: usize,\n    end: usize,\n    front: Option<usize>,\n    back: Option<usize>,\n    pat: P,\n    trailing: bool,\n    done: bool,\n}\n\nimpl<'a, P: Pattern> Split<'a, P> {\n    fn new(hay: &'a str, pat: P, trailing: bool) -> Split<'a, P> {\n        Split {\n            hay: hay,\n            start: 0,\n            end: hay.len(),\n            front: Some(0),\n            back: Some(hay.len()),\n            pat: pat,\n            trailing: trailing,\n            done: false,\n        }\n    }\n\n    // The last piece, once (none when it is empty and trailing is false).\n    fn get_end(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        self.done = true;\n        if self.trailing || self.end > self.start {\n            Some(&self.hay[self.start..self.end])\n        } else {\n            None\n        }\n    }\n}\n\nimpl<'a, P: Pattern> Iterator for Split<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        let m = match self.front {\n            Some(at) => self.pat.next_match(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if b <= self.end => {\n                let piece = &self.hay[self.start..a];\n                self.start = b;\n                self.front = after_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => self.get_end(),\n        }\n    }\n}\n\nimpl<'a, P: Pattern> DoubleEndedIterator for Split<'a, P> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        if self.done {\n            return None;\n        }\n        if !self.trailing {\n            // split_terminator: an empty last piece is not one\n            self.trailing = true;\n");
    buf_str(out, c"            match self.next_back() {\n                Some(piece) if !piece.is_empty() => return Some(piece),\n                _ => {\n                    if self.done {\n                        return None;\n                    }\n                }\n            }\n        }\n        let m = match self.back {\n            Some(at) => self.pat.next_match_back(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if a >= self.start => {\n                let piece = &self.hay[b..self.end];\n                self.end = a;\n                self.back = before_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => {\n                self.done = true;\n                Some(&self.hay[self.start..self.end])\n            }\n        }\n    }\n}\n\n// str::rsplit's iterator.\npub struct RSplit<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplit<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next_back()\n    }\n}\n\n// str::splitn's iterator.\npub struct SplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next()\n            }\n        }\n    }\n}\n\n// str::rsplitn's iterator.\npub struct RSplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n");
    buf_str(out, c"                self.count -= 1;\n                self.inner.next_back()\n            }\n        }\n    }\n}\n\n// str::split_terminator's iterator.\npub struct SplitTerminator<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitTerminator<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next()\n    }\n}\n\n// str::split_inclusive's iterator.\npub struct SplitInclusive<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitInclusive<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.inner.done {\n            return None;\n        }\n        let m = match self.inner.front {\n            Some(at) => self.inner.pat.next_match(self.inner.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if b <= self.inner.end => {\n                let piece = &self.inner.hay[self.inner.start..b];\n                self.inner.start = b;\n                self.inner.front = after_match(self.inner.hay, a, b);\n                Some(piece)\n            }\n            _ => self.inner.get_end(),\n        }\n    }\n}\n\n// str::split_whitespace's iterator.\n#[derive(Clone)]\npub struct SplitWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_start();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        self.rest = &s[i..];\n                        return Some(&s[..i]);\n                    }\n                }\n                None => {\n                    self.rest = \"\";\n                    return Some(s);\n                }\n");
    buf_str(out, c"            }\n        }\n    }\n}\n\nimpl<'a> DoubleEndedIterator for SplitWhitespace<'a> {\n    fn next_back(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_end();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        let j = i + c.len_utf8();\n                        self.rest = &s[..i];\n                        return Some(&s[j..]);\n                    }\n                }\n                None => {\n                    self.rest = \"\";\n                    return Some(s);\n                }\n            }\n        }\n    }\n}\n\n// str::split_ascii_whitespace's iterator.\n#[derive(Clone)]\npub struct SplitAsciiWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitAsciiWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let b = self.rest.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() && is_ascii_space(b[i]) {\n            i += 1;\n        }\n        if i == b.len() {\n            self.rest = \"\";\n            return None;\n        }\n        let mut j = i;\n        while j < b.len() && !is_ascii_space(b[j]) {\n            j += 1;\n        }\n        let s = self.rest;\n        self.rest = &s[j..];\n        Some(&s[i..j])\n    }\n}\n\n// str::matches's iterator (at: where the next search starts; past the\n// end when done).\npub struct Matches<'a, P> {\n    hay: &'a str,\n    at: usize,\n    pat: P,\n}\n\nimpl<'a, P: Pattern> Iterator for Matches<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.at > self.hay.len() {\n            return None;\n        }\n        match self.pat.next_match(self.hay, self.at) {\n            Some((a, b)) => {\n");
    buf_str(out, c"                self.at = match after_match(self.hay, a, b) {\n                    Some(n) => n,\n                    None => self.hay.len() + 1,\n                };\n                Some(&self.hay[a..b])\n            }\n            None => {\n                self.at = self.hay.len() + 1;\n                None\n            }\n        }\n    }\n}\n\n// str::match_indices's iterator.\npub struct MatchIndices<'a, P> {\n    hay: &'a str,\n    at: usize,\n    pat: P,\n}\n\nimpl<'a, P: Pattern> Iterator for MatchIndices<'a, P> {\n    type Item = (usize, &'a str);\n\n    fn next(&mut self) -> Option<(usize, &'a str)> {\n        if self.at > self.hay.len() {\n            return None;\n        }\n        match self.pat.next_match(self.hay, self.at) {\n            Some((a, b)) => {\n                self.at = match after_match(self.hay, a, b) {\n                    Some(n) => n,\n                    None => self.hay.len() + 1,\n                };\n                Some((a, &self.hay[a..b]))\n            }\n            None => {\n                self.at = self.hay.len() + 1;\n                None\n            }\n        }\n    }\n}\n\n// str::graphemes's iterator: vole's.\n// mvs: StrGraphemes\n// std2: renamed\npub struct Graphemes<'a> {\n    rest: &'a str,\n    extended: bool,\n}\n\n// ---- The helpers ----\n\n// The first code point of b (UTF-8, not empty) and its length.\nfn decode_first(b: &[u8]) -> (char, usize) {\n    let x = b[0] as u32;\n    let (n, init): (usize, u32) = if x < 0x80 {\n        (1, x)\n    } else if x < 0xE0 {\n        (2, x & 0x1F)\n    } else if x < 0xF0 {\n        (3, x & 0x0F)\n    } else {\n        (4, x & 0x07)\n    };\n    let mut cp = init;\n    let mut k: usize = 1;\n    while k < n {\n        cp = (cp << 6) | (b[k] as u32 & 0x3F);\n        k += 1;\n    }\n    (to_char(cp), n)\n}\n\n// The last code point of b (UTF-8, not empty) and its length.\nfn decode_last(b: &[u8]) -> (char, usize) {\n    let mut i = b.len() - 1;\n");
    buf_str(out, c"    while i > 0 && b[i] & 0xC0 == 0x80 {\n        i -= 1;\n    }\n    let (c, _) = decode_first(&b[i..]);\n    (c, b.len() - i)\n}\n\nfn to_char(cp: u32) -> char {\n    match char::from_u32(cp) {\n        Some(c) => c,\n        None => '\\u{FFFD}',\n    }\n}\n\n// Where the search after the match a..b starts: b, or past the next char\n// for an empty match (so it is not found again); None past the end.\nfn after_match(hay: &str, a: usize, b: usize) -> Option<usize> {\n    if a < b {\n        Some(b)\n    } else if b < hay.len() {\n        let (_, n) = decode_first(&hay.as_bytes()[b..]);\n        Some(b + n)\n    } else {\n        None\n    }\n}\n\n// The same, searching backwards: a, or before the previous char.\nfn before_match(hay: &str, a: usize, b: usize) -> Option<usize> {\n    if a < b {\n        Some(a)\n    } else if a > 0 {\n        let (_, n) = decode_last(&hay.as_bytes()[..a]);\n        Some(a - n)\n    } else {\n        None\n    }\n}\n\n// Where x last is in b: a line's end from the back (the first is\n// [u8]::find_byte, the block search, from 0.29).\nfn rfind_byte(b: &[u8], x: u8) -> Option<usize> {\n    let mut i = b.len();\n    while i > 0 {\n        i -= 1;\n        if b[i] == x {\n            return Some(i);\n        }\n    }\n    None\n}\n\n// A line without its \"\\r\" (of a \"\\r\\n\").\nfn strip_cr(line: &str) -> &str {\n    let n = line.len();\n    let cut = if n > 0 && line.as_bytes()[n - 1] == 0x0D { n - 1 } else { n };\n    &line[..cut]\n}\n\n// Rust's u8::is_ascii_whitespace: space, \\t, \\n, \\x0C, \\r.\nfn is_ascii_space(b: u8) -> bool {\n    b == 0x20 || b == 0x09 || b == 0x0A || b == 0x0C || b == 0x0D\n}\n\nfn ascii_lower(b: u8) -> u8 {\n    if b >= 0x41 && b <= 0x5A { b + 32 } else { b }\n}\n\nfn ascii_upper(b: u8) -> u8 {\n    if b >= 0x61 && b <= 0x7A { b - 32 } else { b }\n}\n\n// A &mut str's bytes (Rust's str::as_bytes_mut).\n// UNSAFE: the bytes can be written with what is not UTF-8.\n");
    buf_str(out, c"// SAFETY: a contract on the caller: what it writes keeps s UTF-8.\nunsafe fn bytes_mut(s: &mut str) -> &mut [u8] {\n    // UNSAFE: the str's bytes through its fat pointer, as Rust's core.\n    // SAFETY: the pointer and length are s's own, and s is borrowed mutably\n    // for the result's life, so nothing else reaches the bytes.\n    unsafe { &mut *(s as *mut str as *mut [u8]) }\n}\n\n// UTF-8 bytes as a &mut str (Rust's str::from_utf8_unchecked_mut).\n// UNSAFE: bytes that are not UTF-8 make a str whose methods are undefined.\n// SAFETY: a contract on the caller: b is UTF-8.\nunsafe fn str_mut(b: &mut [u8]) -> &mut str {\n    // UNSAFE: a pointer cast between [u8] and str.\n    // SAFETY: the same layout; the caller promises UTF-8.\n    unsafe { &mut *(b as *mut [u8] as *mut str) }\n}\n\n// `&s[a..b]` out of bounds or off a char boundary: Rust's messages, without\n// the text (str's Display in a panic's format waits for format_fns).\nfn slice_error_fail(s: &str, a: usize, b: usize) -> ! {\n    if a > s.len() {\n        crate::panic::panic(\"byte index {} is out of bounds of a str of {} bytes\", a, s.len())\n    } else if b > s.len() {\n        crate::panic::panic(\"byte index {} is out of bounds of a str of {} bytes\", b, s.len())\n    } else if a > b {\n        crate::panic::panic(\"begin <= end ({} <= {}) when slicing a str\", a, b)\n    } else if !s.is_char_boundary(a) {\n        crate::panic::panic(\"byte index {} is not a char boundary\", a)\n    } else {\n        crate::panic::panic(\"byte index {} is not a char boundary\", b)\n    }\n}\n\n// `\\u{1b}`: Debug's escape of a control char, in lower-case hex.\n// terminates: x, a u32, loses four bits each pass: eight passes at most.\n#[terminates]\nfn write_unicode_escape(f: &mut Formatter<'_>, cp: u32) -> crate::fmt::Result {\n    // `\\u{`, the hex digits, `}`, written from the end back\n    let mut buf = [0u8; 11];\n    let mut n: usize = 11;\n    n -= 1;\n    buf[n] = 0x7D;\n    let mut x = cp;\n    loop {\n");
    buf_str(out, c"        let d = (x & 0xF) as u8;\n        n -= 1;\n        buf[n] = if d < 10 { 0x30 + d } else { 0x57 + d };\n        x = x >> 4;\n        if x == 0 {\n            break;\n        }\n    }\n    n -= 3;\n    buf[n] = 0x5C;\n    buf[n + 1] = 0x75;\n    buf[n + 2] = 0x7B;\n    match from_utf8(&buf[n..]) {\n        Ok(s) => f.write_str(s),\n        Err(_) => Ok(()),\n    }\n}\n\n// The grapheme properties the clusters need (UAX #29), from the code\n// point ranges std2 has without the Unicode tables (MVS's std::unicode).\nfn is_control(cp: u32) -> bool {\n    cp < 0x20 || (cp >= 0x7F && cp < 0xA0) || cp == 0x2028 || cp == 0x2029\n}\n\nfn is_regional(cp: u32) -> bool {\n    cp >= 0x1F1E6 && cp <= 0x1F1FF\n}\n\nfn is_extend(c: char) -> bool {\n    let cp = c as u32;\n    (cp >= 0x300 && cp <= 0x36F)\n        || (cp >= 0x1AB0 && cp <= 0x1AFF)\n        || (cp >= 0x1DC0 && cp <= 0x1DFF)\n        || (cp >= 0x20D0 && cp <= 0x20FF)\n        || (cp >= 0xFE00 && cp <= 0xFE0F)\n        || (cp >= 0xFE20 && cp <= 0xFE2F)\n        || (cp >= 0x1F3FB && cp <= 0x1F3FF)\n        || (cp >= 0xE0020 && cp <= 0xE007F)\n        || (cp >= 0x300 && !is_control(cp) && c.width() == 0 && cp != 0x200D)\n}\n\n// SpacingMark: the common Indic vowel signs.\nfn is_spacing_mark(cp: u32) -> bool {\n    cp == 0x903 || cp == 0x93B || (cp >= 0x93E && cp <= 0x940) || (cp >= 0x949 && cp <= 0x94C)\n        || cp == 0x94E || cp == 0x94F || cp == 0x982 || cp == 0x983\n        || (cp >= 0x9BF && cp <= 0x9C0) || (cp >= 0xBBF && cp <= 0xBC0)\n}\n\n// East Asian Ambiguous: the main blocks (Latin-1's symbols, Greek,\n// Cyrillic, box drawing, the circled and geometric forms, private use).\nfn is_ambiguous(cp: u32) -> bool {\n    cp == 0xA1 || cp == 0xA4 || cp == 0xA7 || cp == 0xA8 || cp == 0xAA || cp == 0xAD || cp == 0xAE\n        || (cp >= 0xB0 && cp <= 0xB4) || (cp >= 0xB6 && cp <= 0xBA) || (cp >= 0xBC && cp <= 0xBF)\n        || cp == 0xC6 || cp == 0xD0 || cp == 0xD7 || cp == 0xD8 || (cp >= 0xDE && cp <= 0xE1)\n");
    buf_str(out, c"        || cp == 0xE6 || (cp >= 0xE8 && cp <= 0xEA) || cp == 0xEC || cp == 0xED || cp == 0xF0\n        || cp == 0xF2 || cp == 0xF3 || (cp >= 0xF7 && cp <= 0xFA) || cp == 0xFC || cp == 0xFE\n        || (cp >= 0x391 && cp <= 0x3A9) || (cp >= 0x3B1 && cp <= 0x3C9) || cp == 0x401\n        || (cp >= 0x410 && cp <= 0x44F) || cp == 0x451 || (cp >= 0x2010 && cp <= 0x2027)\n        || (cp >= 0x2460 && cp <= 0x24FF) || (cp >= 0x2500 && cp <= 0x257F)\n        || (cp >= 0x25A0 && cp <= 0x25FF) || (cp >= 0xE000 && cp <= 0xF8FF) || cp == 0xFFFD\n}\n\n// A cluster's columns: its first char's, 2 with an emoji presentation\n// selector (U+FE0F), or with cjk an ambiguous one.\nfn cluster_width(g: &str, cjk: bool) -> usize {\n    let (c, _) = decode_first(g.as_bytes());\n    let w = c.width();\n    // U+FE0F is EF B8 8F in UTF-8\n    let b = g.as_bytes();\n    let mut vs16 = false;\n    let mut i: usize = 0;\n    while i + 2 < b.len() {\n        if b[i] == 0xEF && b[i + 1] == 0xB8 && b[i + 2] == 0x8F {\n            vs16 = true;\n        }\n        i += 1;\n    }\n    if w == 1 && (vs16 || (cjk && is_ambiguous(c as u32))) {\n        2\n    } else {\n        w\n    }\n}\n\nimpl<'a> Iterator for Graphemes<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let s = self.rest;\n        let b = s.as_bytes();\n        let (first, n0) = decode_first(b);\n        let mut prev = first as u32;\n        let mut end = n0;\n        // regional indicators pair up (GB12, GB13)\n        let mut ri: usize = if is_regional(prev) { 1 } else { 0 };\n        while end < b.len() {\n            let (c, n) = decode_first(&b[end..]);\n            let cp = c as u32;\n            // GB3: CR LF stays together; GB4, GB5: a control breaks\n            let join = if prev == 0x0D && cp == 0x0A {\n                true\n            } else if is_control(prev) || is_control(cp) {\n                false\n");
    buf_str(out, c"            } else if is_extend(c) || cp == 0x200D {\n                // GB9: Extend and ZWJ\n                true\n            } else if self.extended && is_spacing_mark(cp) {\n                // GB9a\n                true\n            } else if prev == 0x200D && c.width() == 2 {\n                // GB11: ZWJ then a pictograph (wide as an approximation)\n                true\n            } else if is_regional(cp) && ri % 2 == 1 {\n                true\n            } else {\n                false\n            };\n            if !join {\n                break;\n            }\n            if is_regional(cp) {\n                ri += 1;\n            }\n            prev = cp;\n            end += n;\n        }\n        self.rest = &s[end..];\n        Some(&s[..end])\n    }\n}\n\n// Unicode's Cased, approximately: Lowercase or Uppercase (the titlecase\n// letters, Lt, are left out).\nfn is_cased(c: char) -> bool {\n    c.is_lowercase() || c.is_uppercase()\n}\n\n// Unicode's Case_Ignorable, approximately: the apostrophes, the word\n// punctuation Unicode lists (`.`, `:`, `^`, `` ` ``, U+00AD, U+00B7) and\n// the combining diacritical marks.\nfn is_case_ignorable(c: char) -> bool {\n    let u = c as u32;\n    c == '\\'' || c == '.' || c == ':' || c == '^' || c == '`' || u == 0xAD || u == 0xB7\n        || u == 0x2019 || (u >= 0x300 && u <= 0x36F)\n}\n\n// Whether the last char of s that is not case-ignorable is cased (Final_Sigma's\n// \"before\").\nfn cased_before(s: &str) -> bool {\n    let mut it = s.chars();\n    while let Some(c) = it.next_back() {\n        if !is_case_ignorable(c) {\n            return is_cased(c);\n        }\n    }\n    false\n}\n\n// Whether the first char of s that is not case-ignorable is cased.\nfn cased_after(s: &str) -> bool {\n    let mut it = s.chars();\n    while let Some(c) = it.next() {\n        if !is_case_ignorable(c) {\n            return is_cased(c);\n        }\n    }\n    false\n}\n// ---- end mod std::str ----\n}\n");
    buf_str(out, c"// ---- mod std::char ----\npub mod char {\n// std::char: the methods of char, a Unicode scalar value (0..=0x10FFFF\n// less the surrogates), and the functions that make one. The rust front's\n// char type comes in 0.27.2 (`edition.later: char`); MVS had none (a code\n// point was a u32, `'x'` a u8), and in the rust edition `'x'` is a char\n// and `b'x'` a u8.\n\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::TryFrom;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::result::Result;\n\nimpl char {\n    // The largest char, '\\u{10FFFF}'.\n    pub const MAX: char = '\\u{10FFFF}';\n\n    // U+FFFD, what bad UTF-8 decodes to.\n    pub const REPLACEMENT_CHARACTER: char = '\\u{FFFD}';\n\n    // i as a char, when it is a scalar value.\n    #[effects()]\n    pub fn from_u32(i: u32) -> Option<char> {\n        // the surrogates (U+D800..=U+DFFF) and past U+10FFFF are no chars\n        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) {\n            Option::None\n        } else {\n            Option::Some(from_u32_unchecked(i))\n        }\n    }\n\n    // The digit d in radix (2..=36), as a char: from_digit(7, 10) is '7'.\n    #[effects(panic)]\n    pub fn from_digit(d: u32, radix: u32) -> Option<char>\n        requires radix <= 36\n    {\n        if radix > 36 {\n            crate::panic::panic(\"from_digit: radix is too high (maximum 36)\");\n        }\n        if d >= radix {\n            Option::None\n        } else if d < 10 {\n            Option::Some(('0' as u8 + d as u8) as char)\n        } else {\n            Option::Some(('a' as u8 + (d - 10) as u8) as char)\n        }\n    }\n\n    // Its value as a digit in radix: '7'.to_digit(10) is Some(7).\n    #[effects(panic)]\n    pub fn to_digit(self, radix: u32) -> Option<u32> {\n        if radix < 2 || radix > 36 {\n            crate::panic::panic(\n");
    buf_str(out, c"                \"to_digit: invalid radix -- radix must be in the range 2 to 36 inclusive\");\n        }\n        let c = self as u32;\n        // `| 0x20` folds ASCII upper case onto lower case\n        let l = c | 0x20;\n        let d = if c >= 0x30 && c <= 0x39 {\n            c - 0x30\n        } else if l >= 0x61 && l <= 0x7A {\n            l - 0x61 + 10\n        } else {\n            return Option::None;\n        };\n        if d < radix { Option::Some(d) } else { Option::None }\n    }\n\n    #[effects(panic)]\n    pub fn is_digit(self, radix: u32) -> bool {\n        self.to_digit(radix).is_some()\n    }\n\n    #[effects(panic)]\n    pub fn is_alphabetic(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_alphabetic();\n        }\n        crate::unicode::is_alphabetic(c)\n    }\n\n    #[effects(panic)]\n    pub fn is_numeric(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_digit();\n        }\n        crate::unicode::is_numeric(c)\n    }\n\n    #[effects(panic)]\n    pub fn is_alphanumeric(self) -> bool {\n        self.is_alphabetic() || self.is_numeric()\n    }\n\n    #[effects(panic)]\n    pub fn is_whitespace(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return c == 0x20 || (c >= 0x9 && c <= 0xD);\n        }\n        // (Unicode's White_Space outside ASCII, all of it: nineteen code\n        // points, the same since Unicode 6.3; std::unicode's tables are\n        // read only by a program that names them, and `{:?}` of a str\n        // asks this of every char)\n        c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028\n            || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000\n    }\n\n    #[effects(panic)]\n    pub fn is_uppercase(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_uppercase();\n        }\n");
    buf_str(out, c"        crate::unicode::is_uppercase(c)\n    }\n\n    #[effects(panic)]\n    pub fn is_lowercase(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_lowercase();\n        }\n        crate::unicode::is_lowercase(c)\n    }\n\n    #[effects()]\n    pub fn is_control(self) -> bool {\n        // general category Cc\n        let c = self as u32;\n        c < 0x20 || (c >= 0x7F && c <= 0x9F)\n    }\n\n    #[effects()]\n    pub fn is_ascii(&self) -> bool {\n        (*self as u32) < 0x80\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphabetic(&self) -> bool {\n        self.is_ascii_uppercase() || self.is_ascii_lowercase()\n    }\n\n    #[effects()]\n    pub fn is_ascii_uppercase(&self) -> bool {\n        *self >= 'A' && *self <= 'Z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_lowercase(&self) -> bool {\n        *self >= 'a' && *self <= 'z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_digit(&self) -> bool {\n        *self >= '0' && *self <= '9'\n    }\n\n    #[effects()]\n    pub fn is_ascii_hexdigit(&self) -> bool {\n        self.is_ascii_digit() || (*self >= 'a' && *self <= 'f') || (*self >= 'A' && *self <= 'F')\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphanumeric(&self) -> bool {\n        self.is_ascii_alphabetic() || self.is_ascii_digit()\n    }\n\n    #[effects()]\n    pub fn is_ascii_whitespace(&self) -> bool {\n        *self == ' ' || *self == '\\t' || *self == '\\n' || *self == '\\r' || *self == '\\x0C'\n    }\n\n    #[effects()]\n    pub fn is_ascii_punctuation(&self) -> bool {\n        (*self >= '!' && *self <= '/') || (*self >= ':' && *self <= '@')\n            || (*self >= '[' && *self <= '`') || (*self >= '{' && *self <= '~')\n    }\n\n    #[effects()]\n    pub fn to_ascii_uppercase(&self) -> char {\n        if self.is_ascii_lowercase() { ((*self as u8) - 32) as char } else { *self }\n    }\n\n    #[effects()]\n    pub fn to_ascii_lowercase(&self) -> char {\n");
    buf_str(out, c"        if self.is_ascii_uppercase() { ((*self as u8) + 32) as char } else { *self }\n    }\n\n    #[effects()]\n    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {\n        self.to_ascii_lowercase() == other.to_ascii_lowercase()\n    }\n\n    // Its upper case: one char or more ('ß' gives \"SS\").\n    #[effects(panic, diverge)]\n    pub fn to_uppercase(self) -> ToUppercase {\n        let c = self as u32;\n        if c < 0x80 {\n            return ToUppercase { chars: [self.to_ascii_uppercase(), '\\0', '\\0'], at: 0, len: 1 };\n        }\n        let (chars, len) = case_chars(crate::unicode::to_upper(c));\n        ToUppercase { chars: chars, at: 0, len: len }\n    }\n\n    // Its lower case: one char or more ('İ' gives \"i\\u{307}\").\n    #[effects(panic, diverge)]\n    pub fn to_lowercase(self) -> ToLowercase {\n        let c = self as u32;\n        if c < 0x80 {\n            return ToLowercase { chars: [self.to_ascii_lowercase(), '\\0', '\\0'], at: 0, len: 1 };\n        }\n        let (chars, len) = case_chars(crate::unicode::to_lower(c));\n        ToLowercase { chars: chars, at: 0, len: len }\n    }\n\n    // The bytes of its UTF-8, 1 to 4.\n    #[effects()]\n    pub fn len_utf8(self) -> usize {\n        let c = self as u32;\n        if c < 0x80 {\n            1\n        } else if c < 0x800 {\n            2\n        } else if c < 0x10000 {\n            3\n        } else {\n            4\n        }\n    }\n\n    // Its UTF-8 written into buf (which must hold len_utf8 bytes), as a str.\n    #[effects(panic)]\n    pub fn encode_utf8(self, buf: &mut [u8]) -> &mut str {\n        let c = self as u32;\n        let n = self.len_utf8();\n        if buf.len() < n {\n            crate::panic::panic(\"encode_utf8: the buffer is too small\");\n        }\n        if n == 1 {\n            buf[0] = c as u8;\n        } else if n == 2 {\n            buf[0] = (0xC0 | (c >> 6)) as u8;\n            buf[1] = (0x80 | (c & 0x3F)) as u8;\n        } else if n == 3 {\n");
    buf_str(out, c"            buf[0] = (0xE0 | (c >> 12)) as u8;\n            buf[1] = (0x80 | ((c >> 6) & 0x3F)) as u8;\n            buf[2] = (0x80 | (c & 0x3F)) as u8;\n        } else {\n            buf[0] = (0xF0 | (c >> 18)) as u8;\n            buf[1] = (0x80 | ((c >> 12) & 0x3F)) as u8;\n            buf[2] = (0x80 | ((c >> 6) & 0x3F)) as u8;\n            buf[3] = (0x80 | (c & 0x3F)) as u8;\n        }\n        // UNSAFE: a &mut [u8] cast to a &mut str (Rust's\n        // str::from_utf8_unchecked_mut).\n        // SAFETY: buf[..n] holds one char's UTF-8, just written, and a str\n        // is laid out as a [u8].\n        unsafe { &mut *(&mut buf[..n] as *mut [u8] as *mut str) }\n    }\n\n    // Its width in terminal columns: vole's (str::width's, for one char).\n    #[effects()]\n    pub fn width(self) -> usize {\n        // Without the Unicode tables (MVS's std::unicode::char_width): a\n        // control and the combining marks and format chars are 0 wide,\n        // the East Asian wide blocks and the emoji 2, the rest 1.\n        let c = self as u32;\n        if c < 0x7F {\n            return if c >= 0x20 { 1 } else { 0 };\n        }\n        if self.is_control() || is_zero_width(c) {\n            0\n        } else if is_wide(c) {\n            2\n        } else {\n            1\n        }\n    }\n}\n\n// A char's upper case, one char or more.\n#[derive(Clone, Debug)]\npub struct ToUppercase {\n    chars: [char; 3],\n    at: usize,\n    len: usize,\n}\n\nimpl Iterator for ToUppercase {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.at == self.len {\n            return Option::None;\n        }\n        self.at += 1;\n        Option::Some(self.chars[self.at - 1])\n    }\n}\n\n// A char's lower case, one char or more.\n#[derive(Clone, Debug)]\npub struct ToLowercase {\n    chars: [char; 3],\n    at: usize,\n    len: usize,\n}\n\nimpl Iterator for ToLowercase {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n");
    buf_str(out, c"        if self.at == self.len {\n            return Option::None;\n        }\n        self.at += 1;\n        Option::Some(self.chars[self.at - 1])\n    }\n}\n\n// i as a char, when it is a scalar value (char::from_u32).\n#[effects()]\npub fn from_u32(i: u32) -> Option<char> {\n    char::from_u32(i)\n}\n\n// The digit d in radix as a char (char::from_digit).\n#[effects(panic)]\npub fn from_digit(d: u32, radix: u32) -> Option<char>\n    requires radix <= 36\n{\n    char::from_digit(d, radix)\n}\n\n// Why a u32 is not a char.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct CharTryFromError(());\n\nimpl Display for CharTryFromError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"converted integer out of range for `char`\")\n    }\n}\n\n// The comparisons of chars: their scalar values' (char is no\n// `#[builtin_impls]` primitive: written, as Clone and Copy are).\nimpl PartialEq for char {\n    fn eq(&self, other: &char) -> bool {\n        (*self as u32) == (*other as u32)\n    }\n}\n\nimpl Eq for char {}\n\nimpl PartialOrd for char {\n    fn partial_cmp(&self, other: &char) -> Option<Ordering> {\n        Option::Some((*self as u32).cmp(&(*other as u32)))\n    }\n}\n\nimpl Ord for char {\n    fn cmp(&self, other: &char) -> Ordering {\n        (*self as u32).cmp(&(*other as u32))\n    }\n}\n\n// As its scalar value, a u32 (Rust's).\nimpl Hash for char {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_u32(*self as u32)\n    }\n}\n\n// '\\0'.\nimpl Default for char {\n    fn default() -> char {\n        '\\0'\n    }\n}\n\n// `{c}`: the char itself, padded as a str.\nimpl Display for char {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let mut b = [0u8; 4];\n        f.pad(self.encode_utf8(&mut b))\n    }\n}\n\n// `{c:?}`: the char quoted, with Rust's escapes for the quote, the\n// backslash and the control characters.\nimpl Debug for char {\n");
    buf_str(out, c"    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"'\")?;\n        let c = *self;\n        if c == '\\'' {\n            f.write_str(\"\\\\'\")?;\n        } else if c == '\\\\' {\n            f.write_str(\"\\\\\\\\\")?;\n        } else if c == '\\n' {\n            f.write_str(\"\\\\n\")?;\n        } else if c == '\\r' {\n            f.write_str(\"\\\\r\")?;\n        } else if c == '\\t' {\n            f.write_str(\"\\\\t\")?;\n        } else if c == '\\0' {\n            f.write_str(\"\\\\0\")?;\n        } else if c.is_control() || is_zero_width(c as u32) || (c.is_whitespace() && c != ' ') {\n            // (a control, a combining mark, a format char or white space but\n            // ' ' as Rust's escape_debug shows it: a grapheme extender and\n            // the unprintable)\n            f.write_str(\"\\\\u{\")?;\n            crate::fmt::LowerHex::fmt(&(c as u32), f)?;\n            f.write_str(\"}\")?;\n        } else {\n            f.write_char(c)?;\n        }\n        f.write_str(\"'\")\n    }\n}\n\n// `char::try_from(i)`: from_u32, with an error for what is no char.\nimpl TryFrom<u32> for char {\n    type Error = CharTryFromError;\n\n    fn try_from(i: u32) -> Result<char, CharTryFromError> {\n        match char::from_u32(i) {\n            Option::Some(c) => Result::Ok(c),\n            Option::None => Result::Err(CharTryFromError(())),\n        }\n    }\n}\n\n// i as a char, i a scalar value (Rust's char::from_u32_unchecked).\nfn from_u32_unchecked(i: u32) -> char {\n    // UNSAFE: a u32's bits read as a char (Rust's transmute).\n    // SAFETY: every caller passes a scalar value (from_u32 checks it; the\n    // case maps give one), and a char is laid out as a u32.\n    unsafe { *(&i as *const u32 as *const char) }\n}\n\n// A case table's mapping (1 to 3 code points, the rest 0) as chars and\n// their count.\nfn case_chars(m: [u32; 3]) -> ([char; 3], usize) {\n");
    buf_str(out, c"    let len: usize = if m[1] == 0 { 1 } else if m[2] == 0 { 2 } else { 3 };\n    ([from_u32_unchecked(m[0]), from_u32_unchecked(m[1]), from_u32_unchecked(m[2])], len)\n}\n\n// The combining marks and the format chars: no column of their own.\nfn is_zero_width(c: u32) -> bool {\n    (c >= 0x300 && c <= 0x36F) || (c >= 0x483 && c <= 0x489) || (c >= 0x591 && c <= 0x5BD)\n        || (c >= 0x610 && c <= 0x61A) || (c >= 0x64B && c <= 0x65F)\n        || (c >= 0x900 && c <= 0x902) || c == 0x93C || (c >= 0x941 && c <= 0x948) || c == 0x94D\n        || (c >= 0x1AB0 && c <= 0x1AFF) || (c >= 0x1DC0 && c <= 0x1DFF)\n        || (c >= 0x200B && c <= 0x200F) || (c >= 0x202A && c <= 0x202E)\n        || (c >= 0x2060 && c <= 0x2064) || (c >= 0x20D0 && c <= 0x20FF)\n        || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) || c == 0xFEFF\n        || (c >= 0xE0000 && c <= 0xE0FFF)\n}\n\n// East Asian Wide and Fullwidth, and the emoji blocks.\nfn is_wide(c: u32) -> bool {\n    (c >= 0x1100 && c <= 0x115F) || (c >= 0x231A && c <= 0x231B) || (c >= 0x2E80 && c <= 0x303E)\n        || (c >= 0x3041 && c <= 0x33FF) || (c >= 0x3400 && c <= 0x4DBF)\n        || (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xA000 && c <= 0xA4CF)\n        || (c >= 0xAC00 && c <= 0xD7A3) || (c >= 0xF900 && c <= 0xFAFF)\n        || (c >= 0xFE30 && c <= 0xFE4F) || (c >= 0xFF00 && c <= 0xFF60)\n        || (c >= 0xFFE0 && c <= 0xFFE6) || (c >= 0x1F300 && c <= 0x1F64F)\n        || (c >= 0x1F900 && c <= 0x1F9FF) || (c >= 0x20000 && c <= 0x3FFFD)\n}\n// ---- end mod std::char ----\n}\n// ---- mod std::num ----\npub mod num {\n// std2: new: Rust's integer methods' home (std::num).\n\n// The integers' inherent methods (front-rust.md F15.4): `x.wrapping_add(y)`,\n// `x.checked_mul(y)` (an Option), `x.overflowing_sub(y)` (the wrapped\n// value and whether it overflowed), `x.saturating_sub(y)`, the bit counts\n// and the rotations, for i8 .. usize, with no `use`. The compiler makes\n");
    buf_str(out, c"// `impl i8 { .. }` .. `impl usize { .. }` from its list (front/builtin_impls)\n// as this module's items, at the attribute below; this module's\n// arithmetic never checks overflow, whatever --overflow-checks says\n// (front/modules: std_wraps), so `self + rhs` in them is Rust's\n// wrapping_add. `/` and `%` by zero panic here too, as Rust's\n// wrapping_div does.\npub mod wrapping {\n    // The high 64 bits of the 128-bit product a * b (vole has no u128):\n    // four 32-bit products, none of which overflows. The overflowing_mul\n    // of the 64-bit integers reads it.\n    #[builtin_methods(i8, i16, i32, i64, isize, u8, u16, u32, u64, usize)]\n    #[effects()]\n    pub fn mul_hi(a: u64, b: u64) -> u64 {\n        let m: u64 = 0xffffffff;\n        let (a0, a1) = (a & m, a >> 32);\n        let (b0, b1) = (b & m, b >> 32);\n        let p00 = a0 * b0;\n        let p01 = a0 * b1;\n        let p10 = a1 * b0;\n        let p11 = a1 * b1;\n        let mid = (p00 >> 32) + (p01 & m) + (p10 & m);\n        p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)\n    }\n}\n\n// (0.28.0) A byte as an ASCII character: Rust's u8 methods, as char's.\nimpl u8 {\n    #[effects()]\n    pub fn is_ascii(&self) -> bool {\n        *self < 0x80\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphabetic(&self) -> bool {\n        self.is_ascii_uppercase() || self.is_ascii_lowercase()\n    }\n\n    #[effects()]\n    pub fn is_ascii_uppercase(&self) -> bool {\n        *self >= b'A' && *self <= b'Z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_lowercase(&self) -> bool {\n        *self >= b'a' && *self <= b'z'\n    }\n\n    #[effects()]\n    pub fn is_ascii_digit(&self) -> bool {\n        *self >= b'0' && *self <= b'9'\n    }\n\n    #[effects()]\n    pub fn is_ascii_hexdigit(&self) -> bool {\n        self.is_ascii_digit() || (*self >= b'a' && *self <= b'f')\n            || (*self >= b'A' && *self <= b'F')\n    }\n\n    #[effects()]\n    pub fn is_ascii_alphanumeric(&self) -> bool {\n");
    buf_str(out, c"        self.is_ascii_alphabetic() || self.is_ascii_digit()\n    }\n\n    // A space, tab, line feed, form feed or carriage return (not the\n    // vertical tab: Rust's, WhatWG's).\n    #[effects()]\n    pub fn is_ascii_whitespace(&self) -> bool {\n        *self == b' ' || *self == b'\\t' || *self == b'\\n' || *self == b'\\r' || *self == 0x0C\n    }\n\n    #[effects()]\n    pub fn is_ascii_punctuation(&self) -> bool {\n        (*self >= b'!' && *self <= b'/') || (*self >= b':' && *self <= b'@')\n            || (*self >= b'[' && *self <= b'`') || (*self >= b'{' && *self <= b'~')\n    }\n\n    // A printable character but the space: `!` to `~`.\n    #[effects()]\n    pub fn is_ascii_graphic(&self) -> bool {\n        *self >= b'!' && *self <= b'~'\n    }\n\n    #[effects()]\n    pub fn is_ascii_control(&self) -> bool {\n        *self < 0x20 || *self == 0x7F\n    }\n\n    #[effects()]\n    pub fn to_ascii_uppercase(&self) -> u8 {\n        if self.is_ascii_lowercase() { *self - 32 } else { *self }\n    }\n\n    #[effects()]\n    pub fn to_ascii_lowercase(&self) -> u8 {\n        if self.is_ascii_uppercase() { *self + 32 } else { *self }\n    }\n\n    #[effects()]\n    pub fn eq_ignore_ascii_case(&self, other: &u8) -> bool {\n        self.to_ascii_lowercase() == other.to_ascii_lowercase()\n    }\n\n    #[effects()]\n    pub fn make_ascii_uppercase(&mut self) {\n        *self = self.to_ascii_uppercase();\n    }\n\n    #[effects()]\n    pub fn make_ascii_lowercase(&mut self) {\n        *self = self.to_ascii_lowercase();\n    }\n}\n\nimpl u64 {\n    // self * rhs + carry, in full: its low 64 bits and its high 64 bits\n    // (Rust's; the high half of a 64x64 product is `a.carrying_mul(b, 0).1`).\n    #[effects()]\n    pub fn carrying_mul(self, rhs: u64, carry: u64) -> (u64, u64) {\n        let lo = self.wrapping_mul(rhs);\n        let sum = lo.wrapping_add(carry);\n        let hi = crate::num::wrapping::mul_hi(self, rhs);\n");
    buf_str(out, c"        (sum, if sum < lo { hi.wrapping_add(1) } else { hi })\n    }\n}\n\n// The errors of parsing and converting numbers, at Rust's paths\n// (std::num::ParseIntError, IntErrorKind, ParseFloatError,\n// TryFromIntError): they are defined beside the code that makes them.\npub use crate::convert::TryFromIntError;\n// (Wrapping<T>: with the integers' conversions, std2-intconv.py)\npub use crate::intconv::Wrapping;\npub use crate::str::{IntErrorKind, ParseFloatError, ParseIntError};\n// ---- end mod std::num ----\n}\n// ---- mod std::intconv ----\nmod intconv {\n// Generated by tools/std2-intconv.py (do not edit): the integers' TryFrom\n// impls and from_str_radix, which Rust's std writes with macros.\n//\n// `T::try_from(x)` of an integer x: Ok when x is one of T's values, else\n// Err(TryFromIntError), as Rust's. A conversion that cannot fail (Rust has\n// `From` for it, and Infallible for its TryFrom's error) has the error\n// type TryFromIntError here too, and is always Ok: `{:?}` of a\n// Result<T, Infallible> does not compile yet (its Err arm is refused as\n// unreachable). usize and isize are 64 bits. One generic impl over a\n// private trait of the ten types does it.\n//\n// `T::from_str_radix(s, radix)`: s as a T in radix (2 to 36, else a panic):\n// an optional `+` (or `-`, for a signed type), then digits (`a`-`z` and\n// `A`-`Z` are 10 to 35), nothing else; the errors are `s.parse::<T>()`'s.\n\nuse crate::convert::{TryFrom, TryFromIntError};\nuse crate::result::Result;\nuse crate::str::{IntErrorKind, ParseIntError};\n\n// The value of s in radix, as its 64 bits (two's complement for a negative\n// one): at most `pos` when positive, and, for a signed type, at most `neg`\n// in magnitude when negative.\nfn parse_radix(s: &str, radix: u32, signed: bool, pos: u64, neg: u64) -> Result<u64,\n    ParseIntError> {\n    if radix < 2 || radix > 36 {\n        crate::panic::panic(\"from_str_radix: the radix must lie in the range `[2, 36]`\");\n    }\n");
    buf_str(out, c"    let b = s.as_bytes();\n    if b.len() == 0 {\n        return Result::Err(crate::str::int_error(IntErrorKind::Empty));\n    }\n    let mut i: usize = 0;\n    let mut negative = false;\n    if b[0] == b'+' {\n        i = 1;\n    } else if b[0] == b'-' && signed {\n        negative = true;\n        i = 1;\n    }\n    if i == b.len() {\n        return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));\n    }\n    let limit = if negative { neg } else { pos };\n    let r = radix as u64;\n    let mut acc: u64 = 0;\n    while i < b.len() {\n        let c = b[i];\n        let d: u64 = if c >= b'0' && c <= b'9' {\n            (c - b'0') as u64\n        } else if c >= b'a' && c <= b'z' {\n            (c - b'a') as u64 + 10\n        } else if c >= b'A' && c <= b'Z' {\n            (c - b'A') as u64 + 10\n        } else {\n            36\n        };\n        if d >= r {\n            return Result::Err(crate::str::int_error(IntErrorKind::InvalidDigit));\n        }\n        // (acc * r + d <= limit, without overflow: d < r <= 36 <= limit)\n        if acc > (limit - d) / r {\n            return Result::Err(crate::str::int_error(if negative { IntErrorKind::NegOverflow }\n                else { IntErrorKind::PosOverflow }));\n        }\n        acc = acc * r + d;\n        i += 1;\n    }\n    Result::Ok(if negative { (!acc).wrapping_add(1) } else { acc })\n}\n\nimpl i8 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i8, ParseIntError> {\n        match parse_radix(src, radix, true, 127, 128) {\n            Result::Ok(v) => Result::Ok(v as i8),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i16 {\n    #[effects(panic)]\n    pub fn from_str_radix(src: &str, radix: u32) -> Result<i16, ParseIntError> {\n        match parse_radix(src, radix, true, 32767, 32768) {\n            Result::Ok(v) => Result::Ok(v as i16),\n            Result::Err(e) => Result::Err(e),\n        }\n    }\n}\n\nimpl i3