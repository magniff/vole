    buf_str(out, c"use crate::string::String;\n\n// ---- Components ----\n\n// One component of a path: the root, a leading \".\", \"..\", or a name.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Component<'a> {\n    RootDir,\n    CurDir,\n    ParentDir,\n    Normal(&'a str),\n}\n\nimpl<'a> Component<'a> {\n    // Its text: \"/\", \".\", \"..\" or the name.\n    // std2: changed: a &str (Rust: as_os_str, an &OsStr)\n    #[effects()]\n    pub fn as_str(self) -> &'a str {\n        match self {\n            Component::RootDir => \"/\",\n            Component::CurDir => \".\",\n            Component::ParentDir => \"..\",\n            Component::Normal(s) => s,\n        }\n    }\n}\n\nimpl<'a> AsRef<str> for Component<'a> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\n// The length of s's prefix component: 1 for the root ('/') or for a\n// leading \".\" (\".\", \"./...\"), else 0.\nfn prefix_len(s: &str) -> usize {\n    let b = s.as_bytes();\n    if b.len() > 0 && b[0] == b'/' {\n        return 1;\n    }\n    if b.len() > 0 && b[0] == b'.' && (b.len() == 1 || b[1] == b'/') {\n        return 1;\n    }\n    0\n}\n\n// `p.components()`: the root or a leading \".\" first, then the names and\n// \"..\"s; empty components and \".\" past the first are left out, as Rust's.\n// Both ends: `next_back` gives the last component.\n#[derive(Clone, Copy)]\npub struct Components<'a> {\n    s: &'a str,\n    // the prefix component (RootDir or CurDir) not yet given\n    pre: bool,\n    // the body not yet given: s[front..back]\n    front: usize,\n    back: usize,\n}\n\nimpl<'a> Components<'a> {\n    fn of(s: &'a str) -> Components<'a> {\n        let n = prefix_len(s);\n        Components { s: s, pre: n > 0, front: n, back: s.len() }\n    }\n\n    fn prefix(&self) -> Component<'a> {\n        if self.s.as_bytes()[0] == b'/' { Component::RootDir } else { Component::CurDir }\n    }\n\n    fn body(c: &'a str) -> Option<Component<'a>> {\n        if c.len() == 0 || c == \".\" {\n");
