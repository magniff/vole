    buf_str(out, c"impl<B: BufRead, A: Allocator + Clone> Iterator for Lines<B, A> {\n    type Item = Result<String<A>>;\n\n    fn next(&mut self) -> Option<Result<String<A>>> {\n        let mut s = String::new_in(self.alloc.clone());\n        match self.buf.read_line(&mut s) {\n            crate::result::Result::Ok(0) => Option::None,\n            crate::result::Result::Ok(_) => {\n                let nl: &str = \"\\n\";\n                let cr: &str = \"\\r\";\n                if s.ends_with(nl) {\n                    s.pop();\n                    if s.ends_with(cr) {\n                        s.pop();\n                    }\n                }\n                Option::Some(crate::result::Result::Ok(s))\n            }\n            crate::result::Result::Err(e) => Option::Some(crate::result::Result::Err(e)),\n        }\n    }\n}\n\n// A Read with a buffer of its own (8 KiB, inline: no allocation).\npub struct BufReader<R> {\n    inner: R,\n    buf: [u8; 8192],\n    pos: usize,\n    filled: usize,\n}\n\nimpl<R: Read> BufReader<R> {\n    #[effects()]\n    pub fn new(inner: R) -> BufReader<R> {\n        BufReader { inner: inner, buf: [0; 8192], pos: 0, filled: 0 }\n    }\n}\n\nimpl<R> BufReader<R> {\n    #[effects()]\n    pub fn get_ref(&self) -> &R {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut R {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not read yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[self.pos..self.filled]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The reader, the buffered bytes dropped.\n    #[effects()]\n    pub fn into_inner(self) -> R {\n        self.inner\n    }\n}\n\nimpl<R: Read> Read for BufReader<R> {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        // A read as large as the buffer, with nothing buffered, skips it.\n        if self.pos == self.filled && buf.len() >= 8192 {\n");
