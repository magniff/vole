    buf_str(out, c"// Two paths are equal when their components are (\"a//b/\" is \"a/b\").\nimpl<'a> PartialEq for Path<'a> {\n    fn eq(&self, other: &Path<'a>) -> bool {\n        let mut x = Components::of(self.s);\n        let mut y = Components::of(other.s);\n        loop {\n            match x.next() {\n                Option::Some(c) => match y.next() {\n                    Option::Some(d) => {\n                        if c != d {\n                            return false;\n                        }\n                    }\n                    Option::None => return false,\n                },\n                Option::None => return y.next().is_none(),\n            }\n        }\n    }\n}\n\nimpl<'a> Eq for Path<'a> {}\n\n// Its text (Rust's `p.display()`).\nimpl<'a> Display for Path<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.s, f)\n    }\n}\n\n// Its text, quoted, as a str's Debug.\nimpl<'a> Debug for Path<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.s, f)\n    }\n}\n\n// ---- PathBuf ----\n\n// An owned path, its text in a String on allocator A.\n// std2: changed: its text a String<A> (MVS: a pub Vec<u8, A>)\npub struct PathBuf<A: Allocator> {\n    s: String<A>,\n}\n\nimpl<A: Allocator> PathBuf<A> {\n    // An empty path.\n    // std2: changed: an allocator (Rust: new)\n    pub fn new_in(a: A) -> PathBuf<A> {\n        PathBuf { s: String::new_in(a) }\n    }\n\n    // An empty path with room for n bytes.\n    // std2: changed: an allocator (Rust: with_capacity)\n    #[effects(A)]\n    pub fn with_capacity_in(n: usize, a: A) -> PathBuf<A> {\n        PathBuf { s: String::with_capacity_in(n, a) }\n    }\n\n    // A path of s's text.\n    // std2: changed: a &str (MVS: [u8]); Rust: PathBuf::from\n    #[effects(A)]\n    pub fn from_in(s: &str, a: A) -> PathBuf<A> {\n        PathBuf { s: String::from_in(s, a) }\n    }\n\n    // A path that owns s.\n    #[effects()]\n");
