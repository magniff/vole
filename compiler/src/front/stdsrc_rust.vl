);
    buf_str(out, c"// backslash and the control characters.\nimpl Debug for char {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"'\")?;\n        let c = *self;\n        if c == '\\'' {\n            f.write_str(\"\\\\'\")?;\n        } else if c == '\\\\' {\n            f.write_str(\"\\\\\\\\\")?;\n        } else if c == '\\n' {\n            f.write_str(\"\\\\n\")?;\n        } else if c == '\\r' {\n            f.write_str(\"\\\\r\")?;\n        } else if c == '\\t' {\n            f.write_str(\"\\\\t\")?;\n        } else if c == '\\0' {\n            f.write_str(\"\\\\0\")?;\n        } else if c.is_control() || is_zero_width(c as u32) || (c.is_whitespace() && c != ' ') {\n            // (a control, a combining mark, a format char or white space but\n            // ' ' as Rust's escape_debug shows it: a grapheme extender and\n            // the unprintable)\n            f.write_str(\"\\\\u{\")?;\n            crate::fmt::LowerHex::fmt(&(c as u32), f)?;\n            f.write_str(\"}\")?;\n        } else {\n            f.write_char(c)?;\n        }\n        f.write_str(\"'\")\n    }\n}\n\n// `char::try_from(i)`: from_u32, with an error for what is no char.\nimpl TryFrom<u32> for char {\n    type Error = CharTryFromError;\n\n    fn try_from(i: u32) -> Result<char, CharTryFromError> {\n        match char::from_u32(i) {\n            Option::Some(c) => Result::Ok(c),\n            Option::None => Result::Err(CharTryFromError(())),\n        }\n    }\n}\n\n// i as a char, i a scalar value (Rust's char::from_u32_unchecked).\nfn from_u32_unchecked(i: u32) -> char {\n    // UNSAFE: a u32's bits read as a char (Rust's transmute).\n    // SAFETY: every caller passes a scalar value (from_u32 checks it; the\n    // case maps give one), and a char is laid out as a u32.\n    unsafe { *(&i as *const u32 as *const char) }\n}\n\n// A case table's mapping (1 to 3 code points, the rest 0) as chars and\n// their count.\nfn case_chars(m: [u32; 3]) -> ([char