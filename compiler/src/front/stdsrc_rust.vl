    buf_str(out, c"                        return Some((start + i, start + i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n\n    fn next_match_back(&mut self, hay: &str, end: usize) -> Option<(usize, usize)> {\n        if end > hay.len() {\n            return None;\n        }\n        let mut it = hay[..end].char_indices();\n        loop {\n            match it.next_back() {\n                Some((i, c)) => {\n                    if (self)(c) {\n                        return Some((i, i + c.len_utf8()));\n                    }\n                }\n                None => return None,\n            }\n        }\n    }\n}\n\n// `&s[a..b]` and `s.get(a..b)`: byte ranges on char boundaries.\nimpl SliceIndex<str> for Range<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of UTF-8 bytes, as a str.\n            // SAFETY: both ends are char boundaries, so the bytes are UTF-8.\n            Some(unsafe { from_utf8_unchecked(&s.as_bytes()[self.start..self.end]) })\n        } else {\n            None\n        }\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        if self.start <= self.end && s.is_char_boundary(self.start)\n            && s.is_char_boundary(self.end) {\n            // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.\n            // SAFETY: both ends are char boundaries, so the bytes are UTF-8, and\n            // the result keeps them so (str's methods write only UTF-8).\n            unsafe {\n                let b = bytes_mut(s);\n                Some(str_mut(&mut b[self.start..self.end]))\n            }\n        } else {\n            None\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        let (a, b) = (self.start, self.end);\n        match self.get(s) {\n");
    buf_str(out, c"            Some(r) => r,\n            None => slice_error_fail(s, a, b),\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        let (a, b) = (self.start, self.end);\n        if !(a <= b && s.is_char_boundary(a) && s.is_char_boundary(b)) {\n            slice_error_fail(s, a, b);\n        }\n        // UNSAFE: a subslice of a &mut str's bytes, as a &mut str.\n        // SAFETY: both ends were checked to be char boundaries above.\n        unsafe {\n            let bytes = bytes_mut(s);\n            str_mut(&mut bytes[a..b])\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeInclusive<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        // end < len, so end + 1 cannot overflow\n        if *self.end() >= s.len() {\n            None\n        } else {\n            (*self.start()..*self.end() + 1).get(s)\n        }\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        if *self.end() >= s.len() {\n            None\n        } else {\n            (*self.start()..*self.end() + 1).get_mut(s)\n        }\n    }\n\n    fn index(self, s: &str) -> &str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index(s)\n        }\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        if *self.end() >= s.len() {\n            slice_error_fail(s, *self.start(), *self.end() + 1)\n        } else {\n            (*self.start()..*self.end() + 1).index_mut(s)\n        }\n    }\n}\n\nimpl SliceIndex<str> for RangeFrom<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (self.start..s.len()).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        let n = s.len();\n        (self.start..n).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (self.start..s.len()).index(s)\n    }\n\n");
    buf_str(out, c"    fn index_mut(self, s: &mut str) -> &mut str {\n        let n = s.len();\n        (self.start..n).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeTo<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (0..self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeToInclusive<usize> {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        (0..=self.end).get(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        (0..=self.end).get_mut(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        (0..=self.end).index(s)\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        (0..=self.end).index_mut(s)\n    }\n}\n\nimpl SliceIndex<str> for RangeFull {\n    type Output = str;\n\n    fn get(self, s: &str) -> Option<&str> {\n        Option::Some(s)\n    }\n\n    fn get_mut(self, s: &mut str) -> Option<&mut str> {\n        Option::Some(s)\n    }\n\n    fn index(self, s: &str) -> &str {\n        s\n    }\n\n    fn index_mut(self, s: &mut str) -> &mut str {\n        s\n    }\n}\n\nimpl<I: SliceIndex<str>> Index<I> for str {\n    type Output = I::Output;\n\n    fn index(&self, index: I) -> &I::Output {\n        index.index(self)\n    }\n}\n\n// Byte for byte.\nimpl PartialEq for str {\n    fn eq(&self, other: &str) -> bool {\n        self.as_bytes() == other.as_bytes()\n    }\n}\n\nimpl Eq for str {}\n\n// By bytes, which is by code points.\nimpl PartialOrd for str {\n    fn partial_cmp(&self, other: &str) -> Option<Ordering> {\n        Option::Some(self.cmp(other))\n    }\n}\n\nimpl Ord for str {\n    fn cmp(&self, other: &str) -> Ordering {\n        self.as_bytes().cmp(other.as_