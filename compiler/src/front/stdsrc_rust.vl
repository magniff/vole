    buf_str(out, c"alloc_slice_copy alloc_slice_fill_with alloc_str scope R ArenaScope home region arena_scope arena TypedArena marker items_offset chunk_layout add_chunk per\nitems room alloc_extend I vec Vec push set_len FixedBuf capacity base data allocate_fn deallocate_fn grow_fn shrink_fn\nany_allocate any_deallocate any_grow any_shrink Box try_new_in into_raw_with_allocator free_block allocator clone_in leak into_raw from_raw_in hash H Hasher\nstate ensures reserve_exact from_in array_builtin N from_raw_parts_in grow_to new_cap new_layout got reserve extra try_reserve capacity_error doubled\nshrink_to_fit shrink_to min_capacity target debug grow_one put never pop remove swap_remove truncate clear as_slice as_mut_slice retain\nretain_mut kept dedup_by_key key dedup_by same_bucket same split_at_mut append drain range Drain range_of tail_len split_off resize_with\nsort sort_by compare sort_by_in sort_by_key from_elem_in resize extend_from_slice extend_from_within dedup SliceIndex Extend extend FromIteratorIn from_iter_in size_hint\nDoubleEndedIterator next_back ExactSizeIterator empty_mut get_unchecked get_unchecked_mut first last first_mut last_mut split_first split_last split_at mid chunks_mut ChunksMut\nchunks_exact ChunksExact windows Windows split pred Split finished lo hi rotate_left rotate_right fill_with swap_with_slice sort_unstable sort_unstable_by\nsift_down sort_unstable_by_key sort_in y idx perm scratch width take_left copy_from_slice sort_by_key_in select_nth_unstable select_nth_unstable_by rest select_nth_unstable_by_key binary_search\nbinary_search_by binary_search_by_key partition_point is_sorted is_sorted_by_key starts_with needle ends_with copy_within clone_from_slice fill to_vec_in repeat_in root child write_usize\nhash_slice debug_list entries into_slice remainder Arr from_utf8 Utf8Error from_utf8_unchecked is_ascii chars Chars char_indices CharIndices front Bytes\n");
