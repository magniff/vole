    buf_str(out, c"    error: Error,\n}\n\nimpl<W> IntoInnerError<W> {\n    #[effects()]\n    pub fn error(&self) -> &Error {\n        &self.error\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> W {\n        self.writer\n    }\n}\n\n// The process's standard input (fd 0), buffered.\npub struct Stdin {\n    fd: i32,\n}\n\n// The process's stdin.\n#[effects()]\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\nimpl Stdin {\n    // A line, its \"\\n\" included, appended to buf; 0 at the end of input.\n    // mvs: read_line\n    // std2: changed: Stdin's, returns the bytes read (MVS: a free function, a bool)\n    #[effects(io, static, diverge, unsafe, A)]\n    pub fn read_line<A: Allocator>(&self, buf: &mut String<A>) -> Result<usize> {\n        // A byte at a time up to \"\\n\": Stdin keeps no buffer, so nothing\n        // after the line is taken from fd 0.\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let mut b = [0u8; 1];\n        let mut r: Result<usize> = crate::result::Result::Ok(0);\n        loop {\n            match sys_read(self.fd, &mut b) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(_) => {\n                    v.push(b[0]);\n                    if b[0] == 10 {\n                        break;\n                    }\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        r = crate::result::Result::Err(e);\n                        break;\n                    }\n                }\n            }\n        }\n        // (annotated: an arm's Ok gives no E, FL1)\n        let r: Result<usize> = match r {\n            crate::result::Result::Ok(_) => crate::result::Result::Ok(v.len() - start),\n");
