    buf_str(out, c"base data allocate_fn deallocate_fn grow_fn shrink_fn any_allocate any_deallocate any_grow any_shrink Box try_new_in into_raw_with_allocator free_block allocator clone_in\nleak into_raw from_raw_in hash H Hasher state ensures reserve_exact from_in array_builtin N from_raw_parts_in grow_to new_cap new_layout\ngot reserve extra try_reserve capacity_error doubled shrink_to_fit shrink_to min_capacity target debug grow_one put never pop remove\nswap_remove truncate clear as_slice as_mut_slice retain retain_mut kept dedup_by_key key dedup_by same_bucket same split_at_mut append drain\nrange Drain range_of tail_len split_off resize_with sort sort_by compare sort_by_in sort_by_key from_elem_in resize extend_from_slice extend_from_within dedup\nSliceIndex Extend extend FromIteratorIn from_iter_in size_hint DoubleEndedIterator next_back ExactSizeIterator empty_mut get_unchecked get_unchecked_mut first last first_mut last_mut\nsplit_first split_last split_at mid chunks_mut ChunksMut chunks_exact ChunksExact windows Windows split pred Split finished lo hi\nrotate_left rotate_right fill_with swap_with_slice sort_unstable sort_unstable_by sift_down sort_unstable_by_key sort_in y idx perm scratch width take_left copy_from_slice\nsort_by_key_in select_nth_unstable select_nth_unstable_by rest select_nth_unstable_by_key binary_search binary_search_by binary_search_by_key partition_point is_sorted is_sorted_by_key starts_with needle ends_with copy_within clone_from_slice\nfill to_vec_in repeat_in root child write_usize hash_slice debug_list entries into_slice remainder Arr from_utf8 Utf8Error from_utf8_unchecked is_ascii\nchars Chars char_indices CharIndices front Bytes lines Lines Pattern rsplit RSplit splitn SplitN rsplitn RSplitN split_terminator\nSplitTerminator split_inclusive SplitInclusive split_whitespace SplitWhitespace split_ascii_whitespace SplitAsciiWhitespace split_once next_match rsplit_once next_match_back matches Matches hay pat match_indices\n");
