    buf_str(out, c"            }\n            left -= 1;\n            result.push_str(&self[last..start]);\n            result.push_str(to);\n            last = start + part.len();\n        }\n        result.push_str(&self[last..]);\n        result\n    }\n\n    // n copies end to end.\n    #[effects(diverge, A)]\n    pub fn repeat_in<A: Allocator>(&self, n: usize, a: A) -> String<A> {\n        let mut s = String::with_capacity_in(self.len() * n, a);\n        let mut i: usize = 0;\n        while i < n {\n            s.push_str(self);\n            i += 1;\n        }\n        s\n    }\n}\n\n// v as a str when it is UTF-8.\n// mvs: validate_utf8\n// std2: changed: returns the &str\n#[effects(panic, diverge, unsafe)]\npub fn from_utf8(v: &[u8]) -> Result<&str, Utf8Error> {\n    let n = v.len();\n    let mut i: usize = 0;\n    while i < n {\n        let b = v[i];\n        if b < 0x80 {\n            i += 1;\n            continue;\n        }\n        // the sequence's length, and the range its second byte must be in\n        // (no overlong forms, no surrogates, nothing over U+10FFFF)\n        let (w, lo, hi): (usize, u8, u8) = if b >= 0xC2 && b <= 0xDF {\n            (2, 0x80, 0xBF)\n        } else if b == 0xE0 {\n            (3, 0xA0, 0xBF)\n        } else if b == 0xED {\n            (3, 0x80, 0x9F)\n        } else if b >= 0xE1 && b <= 0xEF {\n            (3, 0x80, 0xBF)\n        } else if b == 0xF0 {\n            (4, 0x90, 0xBF)\n        } else if b >= 0xF1 && b <= 0xF3 {\n            (4, 0x80, 0xBF)\n        } else if b == 0xF4 {\n            (4, 0x80, 0x8F)\n        } else {\n            return Err(Utf8Error { valid_up_to: i, error_len: Some(1) });\n        };\n        let mut k: usize = 1;\n        while k < w {\n            if i + k >= n {\n                return Err(Utf8Error { valid_up_to: i, error_len: None });\n            }\n            let c = v[i + k];\n            let ok = if k == 1 { c >= lo && c <= hi } else { c & 0xC0 == 0x80 };\n            if !ok {\n");
