    buf_str(out, c"    // bytes, 8-aligned, more than either system's struct stat.\n    let r = unsafe {\n        if follow {\n            fs_c_stat(p.ptr(), &mut b.words[0] as *mut u64)\n        } else {\n            fs_c_lstat(p.ptr(), &mut b.words[0] as *mut u64)\n        }\n    };\n    cvt(r)?;\n    crate::result::Result::Ok(metadata_of(&b))\n}\n\n// ---- Files ----\n\n// An open file; dropping it closes it.\npub struct File {\n    fd: i32,\n}\n\nimpl Drop for File {\n    fn drop(&mut self) {\n        // UNSAFE: C's close. SAFETY: fd is this File's own descriptor,\n        // closed once (here).\n        let _ = unsafe { fs_c_close(self.fd) };\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    #[effects(io, static, panic, diverge)]\n    pub fn open<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDONLY, 0x1b6)\n    }\n\n    // Opens path for writing: made when it is not there, emptied when it is.\n    #[effects(io, static, panic, diverge)]\n    pub fn create<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC, 0x1b6)\n    }\n\n    // Makes path and opens it for reading and writing: AlreadyExists when\n    // it is there.\n    #[effects(io, static, panic, diverge)]\n    pub fn create_new<P: AsRef<str>>(path: P) -> Result<File> {\n        let path = path.as_ref();\n        open_c(path, O_RDWR | crate::__sys::O_CREAT | crate::__sys::O_EXCL, 0x1b6)\n    }\n\n    // The options to open a file with: `File::options().append(true)`.\n    #[effects()]\n    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    // std2: changed: File's own (Rust's: std::os::fd::AsRawFd)\n    #[effects()]\n    pub fn as_raw_fd(&self) -> i32 {\n        self.fd\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n");
