n");
    buf_str(out, c"    let mut path: [u8; 256] = [0; 256];\n    let name = name.as_bytes();\n    let parts: [&[u8]; 4] = [b\"/System/Library/Frameworks/\", name, b\".framework/\", name];\n    let mut n: usize = 0;\n    for part in parts {\n        for i in 0..part.len() {\n            if n < 255 {\n                path[n] = part[i];\n                n += 1;\n            }\n        }\n    }\n    if n >= 255 { return false; }\n    // UNSAFE: dlopen is a C call taking a C string.\n    // SAFETY: path is a local array, NUL-terminated after n < 255 bytes (checked above), alive\n    // across the call; mode is RTLD_NOW | RTLD_GLOBAL.\n    let h = unsafe { objc_c_dlopen(path.as_ptr(), 2 | 8) };\n    !h.is_null()\n}\n\n/// The address of a C symbol of the process and the frameworks it opened,\n/// or null. The caller passes a NUL-terminated name.\n// UNSAFE: dlsym reads name up to its NUL, which no type guarantees.\n// SAFETY: the caller's: name is a NUL-terminated string; RTLD_DEFAULT is the handle dlfcn.h\n// defines on macOS, ((void *) -2).\npub unsafe fn symbol(name: *const u8) -> *mut u8 {\n    // RTLD_DEFAULT is (void *)-2 on macOS\n    objc_c_dlsym(-2isize as *mut u8, name)\n}\n\n// ---- Strings and exceptions (0.22) ----\n\n/// A new NSString holding a copy of the UTF-8 bytes of s.\npub fn ns_string(s: &str) -> Id<NSString> {\n    let a = NSString::alloc();\n    // UNSAFE: initWithBytes:length:encoding: takes the bytes as a raw pointer.\n    // SAFETY: s's pointer is valid for s.len() bytes, the length passed; NSString copies them\n    // before it returns.\n    let r = unsafe {\n        NSString::init_with_bytes_length_encoding(a, s.as_ptr(), s.len() as u64,\n            foundation::NSUTF8StringEncoding)\n    };\n    match r {\n        Some(x) => x,\n        None => Id::<NSString>::nil(),\n    }\n}\n\n/// The UTF-8 bytes of s (empty for nil): a slice valid while s's owner\n/// and the current autorelease pool are.\npub fn ns_bytes<'a>(s: Ref<'a, NSString>) -> &'a [