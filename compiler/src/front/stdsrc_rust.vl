    buf_str(out, c"        let mut read: usize = 0;\n        loop {\n            let (done, used) = {\n                let available = match self.fill_buf() {\n                    crate::result::Result::Ok(b) => b,\n                    crate::result::Result::Err(e) => {\n                        if e.kind() == ErrorKind::Interrupted {\n                            continue;\n                        }\n                        return crate::result::Result::Err(e);\n                    }\n                };\n                let mut i: usize = 0;\n                while i < available.len() && available[i] != delim {\n                    i += 1;\n                }\n                if i < available.len() {\n                    buf.extend_from_slice(&available[..i + 1]);\n                    (true, i + 1)\n                } else {\n                    buf.extend_from_slice(available);\n                    (false, available.len())\n                }\n            };\n            self.consume(used);\n            read += used;\n            if done || used == 0 {\n                return crate::result::Result::Ok(read);\n            }\n        }\n    }\n\n    // A line, its \"\\n\" included, appended to buf; 0 at the end.\n    // mvs: BufReader::read_line, read_line\n    // std2: changed: BufRead's, a usize (MVS: a free function's bool, BufReader's i64)\n    fn read_line<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let r = self.read_until(10, v);\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a, without its \"\\n\".\n    // mvs: BufReader::lines_in\n    fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<Self, A>\n        where\n            Self: Sized,\n    {\n");
    buf_str(out, c"        Lines { buf: self, alloc: a }\n    }\n}\n\n// BufRead::lines_in's iterator: each line a String<A>, or an error.\n// mvs: Lines\npub struct Lines<B, A: Allocator> {\n    buf: B,\n    alloc: A,\n}\n\n// mvs: Lines::impl Iterator\nimpl<B: BufRead, A: Allocator + Clone> Iterator for Lines<B, A> {\n    type Item = Result<String<A>>;\n\n    fn next(&mut self) -> Option<Result<String<A>>> {\n        let mut s = String::new_in(self.alloc.clone());\n        match self.buf.read_line(&mut s) {\n            crate::result::Result::Ok(0) => Option::None,\n            crate::result::Result::Ok(_) => {\n                let nl: &str = \"\\n\";\n                let cr: &str = \"\\r\";\n                if s.ends_with(nl) {\n                    s.pop();\n                    if s.ends_with(cr) {\n                        s.pop();\n                    }\n                }\n                Option::Some(crate::result::Result::Ok(s))\n            }\n            crate::result::Result::Err(e) => Option::Some(crate::result::Result::Err(e)),\n        }\n    }\n}\n\n// A Read with a buffer of its own (8 KiB, inline: no allocation).\npub struct BufReader<R> {\n    inner: R,\n    buf: [u8; 8192],\n    pos: usize,\n    filled: usize,\n}\n\nimpl<R: Read> BufReader<R> {\n    #[effects()]\n    pub fn new(inner: R) -> BufReader<R> {\n        BufReader { inner: inner, buf: [0; 8192], pos: 0, filled: 0 }\n    }\n}\n\nimpl<R> BufReader<R> {\n    #[effects()]\n    pub fn get_ref(&self) -> &R {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut R {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not read yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[self.pos..self.filled]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The reader, the buffered bytes dropped.\n    #[effects()]\n    pub fn into_inner(self) -> R {\n        self.inner\n    }\n}\n\n");
    buf_str(out, c"impl<R: Read> Read for BufReader<R> {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        // A read as large as the buffer, with nothing buffered, skips it.\n        if self.pos == self.filled && buf.len() >= 8192 {\n            return self.inner.read(buf);\n        }\n        let n = {\n            let rem = self.fill_buf()?;\n            let n = crate::cmp::min(rem.len(), buf.len());\n            buf[..n].copy_from_slice(&rem[..n]);\n            n\n        };\n        self.consume(n);\n        crate::result::Result::Ok(n)\n    }\n}\n\nimpl<R: Read> BufRead for BufReader<R> {\n    fn fill_buf(&mut self) -> Result<&[u8]> {\n        if self.pos >= self.filled {\n            let n = self.inner.read(&mut self.buf)?;\n            self.filled = n;\n            self.pos = 0;\n        }\n        crate::result::Result::Ok(&self.buf[self.pos..self.filled])\n    }\n\n    fn consume(&mut self, n: usize) {\n        self.pos = crate::cmp::min(self.pos + n, self.filled);\n    }\n}\n\n// A Write with a buffer of its own (8 KiB, inline), flushed when full,\n// on flush and when dropped.\npub struct BufWriter<W: Write> {\n    inner: W,\n    buf: [u8; 8192],\n    len: usize,\n}\n\nimpl<W: Write> BufWriter<W> {\n    #[effects()]\n    pub fn new(inner: W) -> BufWriter<W> {\n        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n    }\n\n    #[effects()]\n    pub fn get_ref(&self) -> &W {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut W {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not written yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The writer, after a flush; the error and the BufWriter if it failed.\n    // std2: changed: a Result (Rust's)\n    #[effects(unsafe, W)]\n    pub fn into_inner(self) -> crate::result::Result<W, IntoInnerError<BufWriter<W>>> {\n");
    buf_str(out, c"        let mut me = self;\n        match me.flush_buf() {\n            crate::result::Result::Err(e) => {\n                crate::result::Result::Err(IntoInnerError { writer: me, error: e })\n            }\n            crate::result::Result::Ok(()) => {\n                // UNSAFE: the writer is moved out of a type with a Drop,\n                // which is then forgotten (Rust's into_inner does the same).\n                // SAFETY: me is forgotten right after, so its inner is not\n                // dropped twice, and its buffer is empty (flushed): its drop\n                // would only flush nothing.\n                let inner = unsafe { crate::ptr::read(&me.inner) };\n                crate::mem::forget(me);\n                crate::result::Result::Ok(inner)\n            }\n        }\n    }\n}\n\nimpl<W: Write> BufWriter<W> {\n    // The buffer written out to the inner writer, then emptied.\n    fn flush_buf(&mut self) -> Result<()> {\n        let n = self.len;\n        self.inner.write_all(&self.buf[..n])?;\n        self.len = 0;\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl<W: Write> Write for BufWriter<W> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        if self.len + buf.len() > 8192 {\n            self.flush_buf()?;\n        }\n        if buf.len() >= 8192 {\n            return self.inner.write(buf);\n        }\n        let n = buf.len();\n        self.buf[self.len..self.len + n].copy_from_slice(buf);\n        self.len += n;\n        crate::result::Result::Ok(n)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        self.flush_buf()?;\n        self.inner.flush()\n    }\n}\n\nimpl<W: Write> crate::ops::Drop for BufWriter<W> {\n    fn drop(&mut self) {\n        let _ = self.flush();\n    }\n}\n\n// `BufWriter { writer: .., buffer: 3/8192 }`, as Rust's.\nimpl<W: Write + Debug> Debug for BufWriter<W> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"BufWriter\")\n");
    buf_str(out, c"            .field(\"writer\", &self.inner)\n            .field(\"buffer\", &Filled { len: self.len, cap: 8192 })\n            .finish()\n    }\n}\n\n// A buffer's fill as `len/cap`.\nstruct Filled {\n    len: usize,\n    cap: usize,\n}\n\nimpl Debug for Filled {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.len, f)?;\n        f.write_str(\"/\")?;\n        Debug::fmt(&self.cap, f)\n    }\n}\n\n// BufWriter::into_inner's error: the flush's error and the writer.\n#[derive(Debug)]\npub struct IntoInnerError<W> {\n    writer: W,\n    error: Error,\n}\n\nimpl<W> IntoInnerError<W> {\n    #[effects()]\n    pub fn error(&self) -> &Error {\n        &self.error\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> W {\n        self.writer\n    }\n}\n\n// The process's standard input (fd 0), buffered.\npub struct Stdin {\n    fd: i32,\n}\n\n// The process's stdin.\n#[effects()]\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\nimpl Stdin {\n    // A line, its \"\\n\" included, appended to buf; 0 at the end of input.\n    // mvs: read_line\n    // std2: changed: Stdin's, returns the bytes read (MVS: a free function, a bool)\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    pub fn read_line<A: Allocator>(&self, buf: &mut String<A>) -> Result<usize> {\n        // A byte at a time up to \"\\n\": Stdin keeps no buffer, so nothing\n        // after the line is taken from fd 0.\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let mut b = [0u8; 1];\n        let mut r: Result<usize> = crate::result::Result::Ok(0);\n        loop {\n            match sys_read(self.fd, &mut b) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(_) => {\n");
