    buf_str(out, c"impl<A: Allocator> AsRef<str> for PathBuf<A> {\n    fn as_ref(&self) -> &str {\n        self.s.as_str()\n    }\n}\n\n// A copy on the same allocator (a clone of it).\nimpl<A: Allocator + Clone> Clone for PathBuf<A> {\n    fn clone(&self) -> PathBuf<A> {\n        PathBuf { s: self.s.clone() }\n    }\n}\n\nimpl<A: Allocator, B: Allocator> PartialEq<PathBuf<B>> for PathBuf<A> {\n    fn eq(&self, other: &PathBuf<B>) -> bool {\n        self.as_path() == other.as_path()\n    }\n}\n\nimpl<A: Allocator> Eq for PathBuf<A> {}\n\nimpl<A: Allocator> Display for PathBuf<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.s.as_str(), f)\n    }\n}\n\nimpl<A: Allocator> Debug for PathBuf<A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.s.as_str(), f)\n    }\n}\n// ---- end mod std::path ----\n}\n// ---- mod std::random ----\npub mod random {\n// EDITION: rust\n// std::random (0.28.0): a pseudo-random generator, MVS's (0.20), vole's\n// own: Rust's std has none (the rand crates' names are kept).\n//\n// xoshiro256++ (Blackman and Vigna), 32 bytes of state, with rand 0.9's\n// names. Seeding from a number is pure and the same on every target\n// (`Xoshiro256pp::seed_from_u64`: splitmix64, as rand_xoshiro seeds it, so\n// the outputs match that crate's); seeding from the system's entropy is io\n// (`from_entropy`). Ranges use Lemire's nearly divisionless method: no\n// bias, a division only in about 1 of 2^64/n draws.\n// mvs: std::random\n\nuse crate::num::wrapping::mul_hi;\n\n// UNSAFE: the OS's random bytes.\n// SAFETY: getentropy fills the len (at most 256) bytes at buf and returns\n// 0, or -1 with nothing promised of them; its one caller passes a slice's\n// pointer and a length within it and within 256.\nextern \"C\" {\n    #[link_name = \"getentropy\"]\n    fn c_getentropy(buf: *mut u8, len: usize) -> i32;\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct Xoshiro256pp {\n");
    buf_str(out, c"    s0: u64,\n    s1: u64,\n    s2: u64,\n    s3: u64,\n}\n\n// One step of splitmix64 on state: the next output.\n#[effects()]\npub fn splitmix64_next(state: &mut u64) -> u64 {\n    *state = state.wrapping_add(0x9e3779b97f4a7c15);\n    let mut z = *state;\n    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9);\n    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111eb);\n    z ^ (z >> 31)\n}\n\nimpl Xoshiro256pp {\n    // The generator seeded from n through splitmix64 (rand_xoshiro's\n    // seed_from_u64): pure, the same everywhere.\n    #[effects()]\n    pub fn seed_from_u64(n: u64) -> Xoshiro256pp {\n        let mut st = n;\n        let a = splitmix64_next(&mut st);\n        let b = splitmix64_next(&mut st);\n        let c = splitmix64_next(&mut st);\n        let d = splitmix64_next(&mut st);\n        Xoshiro256pp { s0: a, s1: b, s2: c, s3: d }\n    }\n\n    // The generator with this state (not all zero: an all-zero state is\n    // replaced by seed_from_u64(0)'s, as rand_xoshiro does).\n    #[effects()]\n    pub fn from_state(s: [u64; 4]) -> Xoshiro256pp {\n        if s[0] == 0 && s[1] == 0 && s[2] == 0 && s[3] == 0 {\n            return Xoshiro256pp::seed_from_u64(0);\n        }\n        Xoshiro256pp { s0: s[0], s1: s[1], s2: s[2], s3: s[3] }\n    }\n\n    // Its state, for from_state.\n    #[effects()]\n    pub fn state(&self) -> [u64; 4] {\n        [self.s0, self.s1, self.s2, self.s3]\n    }\n\n    // The generator seeded from the system's entropy (getentropy); panics\n    // when the system has none to give.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn from_entropy() -> Xoshiro256pp {\n        let mut b: [u8; 32] = [0; 32];\n        let mut s: [u64; 4] = [0, 0, 0, 0];\n        if !fill_bytes_os(&mut b) {\n            crate::panic::panic(\"from_entropy: the system gave no entropy\");\n        }\n        for i in 0..32 {\n            s[i / 8] |= (b[i] as u64) << ((i % 8) * 8) as u64;\n        }\n        Xoshiro256pp::from_state(s)\n");
    buf_str(out, c"    }\n\n    // The next 64 random bits.\n    #[inline]\n    #[effects()]\n    pub fn next_u64(&mut self) -> u64 {\n        let s0 = self.s0;\n        let s3 = self.s3;\n        let sum = s0.wrapping_add(s3);\n        let result = ((sum << 23) | (sum >> 41)).wrapping_add(s0);\n        let t = self.s1 << 17;\n        let s2 = self.s2 ^ s0;\n        let s3b = s3 ^ self.s1;\n        let s1 = self.s1 ^ s2;\n        let s0b = s0 ^ s3b;\n        self.s0 = s0b;\n        self.s1 = s1;\n        self.s2 = s2 ^ t;\n        self.s3 = (s3b << 45) | (s3b >> 19);\n        result\n    }\n\n    // The next 32 random bits (the high half of next_u64, as rand_xoshiro).\n    #[effects()]\n    pub fn next_u32(&mut self) -> u32 {\n        (self.next_u64() >> 32) as u32\n    }\n\n    // A uniform u64 in [lo, hi); panics when the range is empty.\n    #[effects(io, panic, diverge)]\n    pub fn random_range_u64(&mut self, lo: u64, hi: u64) -> u64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64(hi - lo)\n    }\n\n    // A uniform i64 in [lo, hi); panics when the range is empty.\n    #[effects(io, panic, diverge)]\n    pub fn random_range_i64(&mut self, lo: i64, hi: i64) -> i64 {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        let n = (hi as u64).wrapping_sub(lo as u64);\n        (lo as u64).wrapping_add(self.below_u64(n)) as i64\n    }\n\n    // A uniform usize in [lo, hi), for indices; panics when the range is\n    // empty.\n    #[effects(io, panic, diverge)]\n    pub fn random_range_usize(&mut self, lo: usize, hi: usize) -> usize {\n        if lo >= hi {\n            crate::panic::panic(\"cannot sample empty range\");\n        }\n        lo + self.below_u64((hi - lo) as u64) as usize\n    }\n\n    // A uniform u64 in [0, n), n > 0: Lemire's method. A draw is rejected\n    // with probability under n / 2^64; after 128 rejections in a row (less\n");
    buf_str(out, c"    // likely than 2^-128) the last one is taken.\n    #[inline]\n    #[effects()]\n    pub fn below_u64(&mut self, n: u64) -> u64 {\n        let mut x = self.next_u64();\n        let mut lo = x.wrapping_mul(n);\n        if lo < n {\n            let t = n.wrapping_neg() % n;\n            for _ in 0..128 {\n                if lo >= t {\n                    break;\n                }\n                x = self.next_u64();\n                lo = x.wrapping_mul(n);\n            }\n        }\n        mul_hi(x, n)\n    }\n\n    // A uniform f64 in [0, 1): 53 random bits.\n    #[effects()]\n    pub fn unit_f64(&mut self) -> f64 {\n        (self.next_u64() >> 11) as f64 * 0.00000000000000011102230246251565\n    }\n\n    // true with probability p (0 <= p <= 1; panics otherwise).\n    #[effects(io, panic, diverge)]\n    pub fn random_bool(&mut self, p: f64) -> bool {\n        if !(p >= 0.0 && p <= 1.0) {\n            crate::panic::panic(\"random_bool: p is not in [0, 1]\");\n        }\n        if p == 1.0 {\n            return true;\n        }\n        // (p * 2^64 < 2^64)\n        let cut = (p * 18446744073709551616.0) as u64;\n        self.next_u64() < cut\n    }\n\n    // Fills buf with random bytes: each next_u64's bytes, least\n    // significant first.\n    // std2: changed: buf a &mut [u8]\n    #[effects(panic, diverge)]\n    pub fn fill_bytes(&mut self, buf: &mut [u8]) {\n        let mut i: usize = 0;\n        while i < buf.len() {\n            let mut x = self.next_u64();\n            let mut k = 0;\n            while k < 8 && i < buf.len() {\n                buf[i] = x as u8;\n                x >>= 8;\n                i += 1;\n                k += 1;\n            }\n        }\n    }\n\n    // Moves the generator 2^128 steps ahead (xoshiro's jump): for 2^128\n    // non-overlapping sequences.\n    #[effects()]\n    pub fn jump(&mut self) {\n        let jump: [u64; 4] = [0x180ec6d33cfd0aba, 0xd5a61266f0c9392c, 0xa9582618e03fc9aa,\n            0x39abdc4529b1661c];\n");
    buf_str(out, c"        let mut a: u64 = 0;\n        let mut b: u64 = 0;\n        let mut c: u64 = 0;\n        let mut d: u64 = 0;\n        for i in 0..4 {\n            for bit in 0..64 {\n                if (jump[i] & (1u64 << bit as u64)) != 0 {\n                    a ^= self.s0;\n                    b ^= self.s1;\n                    c ^= self.s2;\n                    d ^= self.s3;\n                }\n                self.next_u64();\n            }\n        }\n        self.s0 = a;\n        self.s1 = b;\n        self.s2 = c;\n        self.s3 = d;\n    }\n}\n\n// Shuffles s uniformly (Fisher-Yates, from the end, as rand's shuffle).\n// std2: changed: s a &mut [T], rng a &mut Xoshiro256pp\n#[effects(diverge, T)]\npub fn shuffle<T>(s: &mut [T], rng: &mut Xoshiro256pp) {\n    let n = s.len();\n    let mut i = n;\n    while i > 1 {\n        i -= 1;\n        let j = rng.below_u64((i + 1) as u64) as usize;\n        s.swap(i, j);\n    }\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 bytes a\n// call); false when the system fails. Rust's getrandom.\n// std2: changed: buf a &mut [u8]\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn fill_bytes_os(buf: &mut [u8]) -> bool {\n    let mut at: usize = 0;\n    while at < buf.len() {\n        let n = if buf.len() - at < 256 { buf.len() - at } else { 256 };\n        let rest = &mut buf[at..at + n];\n        // UNSAFE: the OS writes through a raw pointer.\n        // SAFETY: rest is a live &mut [u8] of n <= 256 bytes, borrowed for\n        // the call; getentropy writes at most n bytes there.\n        if unsafe { c_getentropy(rest.as_mut_ptr(), n) } != 0 {\n            return false;\n        }\n        at += n;\n    }\n    true\n}\n// ---- end mod std::random ----\n}\n// ---- mod std::sys ----\npub mod sys {\n// EDITION: rust\n// std::sys (0.20; std2 0.28.0): the OS layer, thin bindings of the C\n// library, MVS's std::sys in the rust edition. vole's own: Rust's std::sys\n");
    buf_str(out, c"// is private, and this is the libc crate's level, with the `sys_` names\n// and `Result<T, i32>` errnos MVS's had. std::fs, std::process and\n// std::env are Rust's API over the OS; this is for what they do not\n// cover (terminals, pseudo-terminals, poll, descriptors, signals).\n// mvs: std::sys\n\nuse crate::convert::AsRef;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::result::Result;\n\n// The target's numbers (std2/rt/sys_macos.vl, sys_linux.vl, which the\n// compiler puts in std::__sys).\npub const SYS_CLOCK_MONOTONIC: i32 = crate::__sys::CLOCK_MONOTONIC;\npub const SYS_EAGAIN: i32 = crate::__sys::EAGAIN;\npub const SYS_ELOOP: i32 = crate::__sys::ELOOP;\npub const SYS_ENAMETOOLONG: i32 = crate::__sys::ENAMETOOLONG;\npub const SYS_ENOSYS: i32 = crate::__sys::ENOSYS;\npub const SYS_ENOTEMPTY: i32 = crate::__sys::ENOTEMPTY;\npub const SYS_ENOTSUP: i32 = crate::__sys::ENOTSUP;\npub const SYS_ETIMEDOUT: i32 = crate::__sys::ETIMEDOUT;\npub const SYS_O_APPEND: i32 = crate::__sys::O_APPEND;\npub const SYS_O_CLOEXEC: i32 = crate::__sys::O_CLOEXEC;\npub const SYS_O_CREAT: i32 = crate::__sys::O_CREAT;\npub const SYS_O_DIRECTORY: i32 = crate::__sys::O_DIRECTORY;\npub const SYS_O_EXCL: i32 = crate::__sys::O_EXCL;\npub const SYS_O_NOCTTY: i32 = crate::__sys::O_NOCTTY;\npub const SYS_O_NONBLOCK: i32 = crate::__sys::O_NONBLOCK;\npub const SYS_O_TRUNC: i32 = crate::__sys::O_TRUNC;\npub const SYS_SIGCHLD: i32 = crate::__sys::SIGCHLD;\npub const SYS_TIOCGWINSZ: u64 = crate::__sys::TIOCGWINSZ;\npub const SYS_TIOCSCTTY: u64 = crate::__sys::TIOCSCTTY;\npub const SYS_TIOCSWINSZ: u64 = crate::__sys::TIOCSWINSZ;\npub const TARGET_OS: i64 = crate::__sys::TARGET_OS;\npub const SYS_PATH_MAX: i64 = crate::__sys::PATH_MAX as i64;\n\n// ---- Sys: errors (0.20) ----\n\n// The OS layer (0.20, docs/design/collections-text-io.md §2.6.1, task A7):\n// thin bindings of the C library, the same on macOS and Linux; what differs\n");
    buf_str(out, c"// between them (flag and errno values, errno's address) is in the target's\n// std::__sys (std2/rt/sys_macos.vl, sys_linux.vl), and a struct whose layout differs\n// is declared once per system (`StatMacos`, `StatLinux`) and chosen by\n// `TARGET_OS`, a constant. Every call's result is a `Result<T, i32>`: the\n// value, or the errno it failed with (`sys_errno_kind` names it). Nothing\n// here retries on EINTR or allocates; paths reach C through a NUL-ended copy\n// in a stack buffer (`sys_cpath`): a path with a NUL in it, or longer than\n// the system's PATH_MAX, fails with EINVAL or ENAMETOOLONG before any call.\n// Every descriptor std opens (`sys_open`, `sys_pipe`, `sys_openpty`) is\n// close-on-exec, so that a spawned program gets only what it is given.\n// Unsafe code: each binding passes C a pointer and a length from a slice it\n// was given, or a pointer to a local or a borrowed struct of the size C\n// writes (the layouts are checked against the headers by tests/run/\n// sys_layout.vl); a slice made from a C string (`sys_cstr_view`) is valid\n// while that string is.\n\n// UNSAFE: C's strlen reads memory up to a NUL through a raw pointer.\n// SAFETY: its prototype is C's (string.h); sys_cstr_view, its one caller,\n// passes a non-null pointer its own caller promises is a NUL-ended string.\nextern \"C\" {\n    #[link_name = \"strlen\"]\n    #[effects()]\n    fn sys_c_strlen(s: *const u8) -> u64;\n}\n\npub const SYS_EPERM: i32 = 1;\npub const SYS_ENOENT: i32 = 2;\npub const SYS_ESRCH: i32 = 3;\npub const SYS_EINTR: i32 = 4;\npub const SYS_EIO: i32 = 5;\npub const SYS_EBADF: i32 = 9;\npub const SYS_ECHILD: i32 = 10;\npub const SYS_ENOMEM: i32 = 12;\npub const SYS_EACCES: i32 = 13;\npub const SYS_EEXIST: i32 = 17;\npub const SYS_EXDEV: i32 = 18;\npub const SYS_ENOTDIR: i32 = 20;\npub const SYS_EISDIR: i32 = 21;\npub const SYS_EINVAL: i32 = 22;\npub const SYS_ENOSPC: i32 = 28;\npub const SYS_EROFS: i32 = 30;\npub const SYS_EPIPE: i32 = 32;\n\n");
    buf_str(out, c"// The kinds of io::Error (§2.6.2) an errno falls into (0.20's\n// io::ErrorKind takes these variants).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum SysErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\n// The errno of the last C call that failed (C's `errno`).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_errno() -> i32 {\n    // UNSAFE: errno is C's thread-local int, reached only through the C\n    // library's pointer to it.\n    // SAFETY: sys_errno_location (__error, __errno_location) returns this\n    // thread's errno, an aligned int valid for the thread's life.\n    unsafe { *crate::__sys::errno_location() }\n}\n\n// Sets errno (to 0 before a call whose only failure report is errno).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_errno(e: i32) {\n    // UNSAFE: as sys_errno.\n    // SAFETY: as sys_errno: this thread's errno, which only it writes.\n    unsafe {\n        *crate::__sys::errno_location() = e;\n    }\n}\n\n// The kind of error errno e is, as Rust's std decodes it.\n#[effects()]\npub fn sys_errno_kind(e: i32) -> SysErrorKind {\n    if e == SYS_ENOENT {\n        SysErrorKind::NotFound\n    } else if e == SYS_EPERM || e == SYS_EACCES {\n        SysErrorKind::PermissionDenied\n    } else if e == SYS_EEXIST {\n        SysErrorKind::AlreadyExists\n    } else if e == SYS_EAGAIN {\n        SysErrorKind::WouldBlock\n    } else if e == SYS_EINVAL || e == SYS_ENAMETOOLONG {\n        SysErrorKind::InvalidInput\n    } else if e == SYS_ETIMEDOUT {\n        SysErrorKind::TimedOut\n    } else if e == SYS_EINTR {\n        SysErrorKind::Interrupted\n    } else if e == SYS_EPIPE {\n        SysErrorKind::BrokenPipe\n");
    buf_str(out, c"    } else if e == SYS_ENOTDIR {\n        SysErrorKind::NotADirectory\n    } else if e == SYS_EISDIR {\n        SysErrorKind::IsADirectory\n    } else if e == SYS_ENOTEMPTY {\n        SysErrorKind::DirectoryNotEmpty\n    } else if e == SYS_ENOSYS || e == SYS_ENOTSUP {\n        SysErrorKind::Unsupported\n    } else if e == SYS_ENOMEM {\n        SysErrorKind::OutOfMemory\n    } else {\n        SysErrorKind::Other\n    }\n}\n\n// C's message for errno e (`strerror`) copied into out, cut to its length:\n// the bytes written.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_strerror_into(e: i32, out: &mut [u8]) -> i64 {\n    // (0.25.4) strerror_r, not strerror: strerror may keep the message in\n    // one buffer for every thread.\n    let mut buf = [0u8; 256];\n    // UNSAFE: C's strerror_r writes the message through a raw pointer.\n    // SAFETY: buf is a local of 256 bytes and strerror_r is given 255, so\n    // the message and its NUL stay in buf and buf[255] stays 0 (a message\n    // cut short ends with a NUL too; an unknown errno gets C's \"Unknown\n    // error\" text).\n    let _ = unsafe { crate::__sys::strerror_r(e, buf.as_mut_ptr(), 255) };\n    let mut n: i64 = 0;\n    while n < out.len() as i64 && buf[n as usize] != 0 {\n        out[n as usize] = buf[n as usize];\n        n += 1;\n    }\n    n\n}\n\n// The bytes of the NUL-ended C string at p, without the NUL; empty for a\n// null p. The caller promises that p is null or a NUL-ended string, valid\n// while the slice is used.\n#[effects(unsafe)]\n// UNSAFE: makes a slice from a raw C pointer, whose extent only its NUL\n// tells.\n// SAFETY: (the caller's obligation, above) p is null, or a NUL-ended\n// string that outlives the slice; strlen stops at that NUL, so the slice\n// covers readable bytes only.\npub unsafe fn sys_cstr_view<'a>(p: *const u8) -> &'a [u8] {\n    if p.is_null() {\n        return &EMPTY;\n    }\n    crate::slice::from_raw_parts(p, sys_c_strlen(p) as usize)\n}\n\n");
    buf_str(out, c"static EMPTY: [u8; 0] = [];\n\n// The result of a C call returning -1 on failure, as a Result.\nfn sys_check(r: i64) -> Result<i64, i32> {\n    if r == -1 {\n        Err(sys_errno())\n    } else {\n        Ok(r)\n    }\n}\n\nfn sys_check_unit(r: i32) -> Result<(), i32> {\n    if r == -1 {\n        Err(sys_errno())\n    } else {\n        Ok(())\n    }\n}\n\n// ---- Sys: paths (0.20) ----\n\n// A path for C: the bytes and a NUL, in a buffer on the caller's stack.\n#[derive(Clone, Copy)] pub struct SysPath {\n    buf: [u8; 4096],\n}\n\n// A SysPath holding path and its NUL: ENAMETOOLONG when path does not fit\n// the system's PATH_MAX (1024 bytes on macOS, 4096 on Linux, the NUL\n// included), EINVAL when it has a NUL in it. Pass `&p.buf as *u8` of the\n// local holding it (`p.buf.as_ptr()`: a method taking self by value would see a copy).\n#[effects(panic)]\npub fn sys_cpath<P: AsRef<[u8]>>(path: P) -> Result<SysPath, i32> {\n    let path = path.as_ref();\n    if path.len() as i64 >= SYS_PATH_MAX {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    let mut p = SysPath { buf: [0u8; 4096] };\n    for i in 0..path.len() as i64 {\n        let b = path[i as usize];\n        if b == 0 {\n            return Err(SYS_EINVAL);\n        }\n        p.buf[i as usize] = b;\n    }\n    Ok(p)\n}\n\nimpl SysPath {\n}\n\n// ---- Sys: files (0.20) ----\n\n// UNSAFE: the C library's file calls (POSIX), which take raw pointers.\n// SAFETY: each prototype is POSIX's (fcntl.h, unistd.h, sys/stat.h,\n// stdio.h's rename); open and fcntl are variadic in C and declared so; the\n// wrappers below pass pointers into buffers they own or borrow, with their\n// true lengths.\nextern \"C\" {\n    #[link_name = \"open\"]\n    #[effects(io)]\n    fn sys_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    #[effects(io)]\n    fn sys_c_close(fd: i32) -> i32;\n    #[link_name = \"read\"]\n    #[effects(io)]\n    fn sys_c_read(fd: i32, buf: *mut u8, n: u64) -> i64;\n");
    buf_str(out, c"    #[link_name = \"write\"]\n    #[effects(io)]\n    fn sys_c_write(fd: i32, buf: *const u8, n: u64) -> i64;\n    #[link_name = \"pread\"]\n    #[effects(io)]\n    fn sys_c_pread(fd: i32, buf: *mut u8, n: u64, off: i64) -> i64;\n    #[link_name = \"pwrite\"]\n    #[effects(io)]\n    fn sys_c_pwrite(fd: i32, buf: *const u8, n: u64, off: i64) -> i64;\n    #[link_name = \"lseek\"]\n    #[effects(io)]\n    fn sys_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    #[effects(io)]\n    fn sys_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    #[effects(io)]\n    fn sys_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fstat\"]\n    #[effects(io)]\n    fn sys_c_fstat(fd: i32, st: *mut u8) -> i32;\n    #[link_name = \"stat\"]\n    #[effects(io)]\n    fn sys_c_stat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"lstat\"]\n    #[effects(io)]\n    fn sys_c_lstat(path: *const u8, st: *mut u8) -> i32;\n    #[link_name = \"mkdir\"]\n    #[effects(io)]\n    fn sys_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    #[effects(io)]\n    fn sys_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    #[effects(io)]\n    fn sys_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    #[effects(io)]\n    fn sys_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"dup\"]\n    #[effects(io)]\n    fn sys_c_dup(fd: i32) -> i32;\n    #[link_name = \"dup2\"]\n    #[effects(io)]\n    fn sys_c_dup2(fd: i32, to: i32) -> i32;\n    #[link_name = \"pipe\"]\n    #[effects(io)]\n    fn sys_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    #[effects(io)]\n    fn sys_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"isatty\"]\n    #[effects(io)]\n    fn sys_c_isatty(fd: i32) -> i32;\n}\n\npub const SYS_O_RDONLY: i32 = 0;\npub const SYS_O_WRONLY: i32 = 1;\npub const SYS_O_RDWR: i32 = 2;\npub const SYS_SEEK_SET: i32 = 0;\n");
    buf_str(out, c"pub const SYS_SEEK_CUR: i32 = 1;\npub const SYS_SEEK_END: i32 = 2;\nconst SYS_F_GETFD: i32 = 1;\nconst SYS_F_SETFD: i32 = 2;\nconst SYS_F_GETFL: i32 = 3;\nconst SYS_F_SETFL: i32 = 4;\nconst SYS_FD_CLOEXEC: i32 = 1;\n\n// Opens path with flags (SYS_O_RDONLY, ..., | SYS_O_CREAT, ...) and, when it\n// creates the file, the permission bits mode (0x1a4: 0644): the descriptor,\n// close-on-exec (SYS_O_CLOEXEC is added).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_open<P: AsRef<[u8]>>(path: P, flags: i32, mode: i32) -> Result<i32, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's open takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call;\n    // open's third argument is variadic, an int.\n    let r = unsafe { sys_c_open(p.buf.as_ptr(), flags | SYS_O_CLOEXEC, mode) };\n    Ok(sys_check(r as i64)? as i32)\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_close(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (close).\n    // SAFETY: close takes an int and touches no memory of ours (a bad\n    // descriptor is EBADF).\n    sys_check_unit(unsafe { sys_c_close(fd) })\n}\n\n// Reads up to buf.len() bytes into buf: how many (0 at the end).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_read(fd: i32, buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's read writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: read writes at most buf.len()\n    // bytes at buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_read(fd, buf.as_mut_ptr(), buf.len() as u64) })\n}\n\n// Writes some of buf: how many bytes.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_write<B: AsRef<[u8]>>(fd: i32, buf: B) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: C's write reads through a raw pointer.\n");
    buf_str(out, c"    // SAFETY: buf is a borrowed slice: write reads at most buf.len() bytes at\n    // buf.as_ptr(), all within it.\n    sys_check(unsafe { sys_c_write(fd, buf.as_ptr(), buf.len() as u64) })\n}\n\n// Reads into buf from offset off, not moving the file's position.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_pread(fd: i32, buf: &mut [u8], off: i64) -> Result<i64, i32> {\n    // UNSAFE: as sys_read.\n    // SAFETY: as sys_read: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pread(fd, buf.as_mut_ptr(), buf.len() as u64, off) })\n}\n\n// Writes buf at offset off, not moving the file's position.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_pwrite<B: AsRef<[u8]>>(fd: i32, buf: B, off: i64) -> Result<i64, i32> {\n    let buf = buf.as_ref();\n    // UNSAFE: as sys_write.\n    // SAFETY: as sys_write: at most buf.len() bytes, within buf.\n    sys_check(unsafe { sys_c_pwrite(fd, buf.as_ptr(), buf.len() as u64, off) })\n}\n\n// Moves the position to off from SYS_SEEK_SET, _CUR or _END: the new one.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_lseek(fd: i32, off: i64, whence: i32) -> Result<i64, i32> {\n    // UNSAFE: a C library call (lseek).\n    // SAFETY: lseek takes integers only and touches no memory of ours.\n    sys_check(unsafe { sys_c_lseek(fd, off, whence) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_ftruncate(fd: i32, len: i64) -> Result<(), i32> {\n    // UNSAFE: a C library call (ftruncate).\n    // SAFETY: ftruncate takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_ftruncate(fd, len) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_fsync(fd: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (fsync).\n    // SAFETY: fsync takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_fsync(fd) })\n}\n\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_mkdir<P: AsRef<[u8]>>(path: P, mode: i32) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's mkdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_mkdir(p.buf.as_ptr(), mode as u32) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_rmdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's rmdir takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_rmdir(p.buf.as_ptr()) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_unlink<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's unlink takes the path as a raw pointer.\n    // SAFETY: as sys_mkdir.\n    sys_check_unit(unsafe { sys_c_unlink(p.buf.as_ptr()) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P, Q)]\npub fn sys_rename<P: AsRef<[u8]>, Q: AsRef<[u8]>>(from: P, to: Q) -> Result<(), i32> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = sys_cpath(from)?;\n    let b = sys_cpath(to)?;\n    // UNSAFE: C's rename takes the paths as raw pointers.\n    // SAFETY: a and b hold NUL-ended paths (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_rename(a.buf.as_ptr(), b.buf.as_ptr()) })\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_dup(fd: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup).\n    // SAFETY: dup takes an int and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup(fd) } as i64)? as i32)\n}\n\n// Makes `to` a copy of fd (closing what `to` was); `to` is not\n// close-on-exec.\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_dup2(fd: i32, to: i32) -> Result<i32, i32> {\n    // UNSAFE: a C library call (dup2).\n    // SAFETY: dup2 takes integers only and touches no memory of ours.\n    Ok(sys_check(unsafe { sys_c_dup2(fd, to) } as i64)? as i32)\n}\n\n// A pipe: (read end, write end), both close-on-exec.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_pipe() -> Result<(i32, i32), i32> {\n    let mut fds: [i32; 2] = [0, 0];\n    // UNSAFE: C's pipe writes through a raw pointer.\n    // SAFETY: fds is a local [i32; 2]: pipe writes two ints there.\n    sys_check_unit(unsafe { sys_c_pipe(fds.as_mut_ptr() as *mut i32) })?;\n    sys_set_cloexec(fds[0], true)?;\n    sys_set_cloexec(fds[1], true)?;\n    Ok((fds[0], fds[1]))\n}\n\n// Sets or clears O_NONBLOCK on fd.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_nonblocking(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFL takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFL) } as i64)? as i32;\n    let want = if on { fl | SYS_O_NONBLOCK } else { fl & ~SYS_O_NONBLOCK };\n    if want != fl {\n        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFL takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFL, want) })?;\n    }\n    Ok(())\n}\n\n// Sets or clears FD_CLOEXEC on fd.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_cloexec(fd: i32, on: bool) -> Result<(), i32> {\n    // UNSAFE: a C library call (fcntl, variadic).\n    // SAFETY: F_GETFD takes no third argument and touches no memory of ours.\n    let fl = sys_check(unsafe { sys_c_fcntl(fd, SYS_F_GETFD) } as i64)? as i32;\n    let want = if on { fl | SYS_FD_CLOEXEC } else { fl & ~SYS_FD_CLOEXEC };\n    if want != fl {\n");
    buf_str(out, c"        // UNSAFE: a C library call (fcntl, variadic).\n        // SAFETY: F_SETFD takes an int and touches no memory of ours.\n        sys_check_unit(unsafe { sys_c_fcntl(fd, SYS_F_SETFD, want) })?;\n    }\n    Ok(())\n}\n\n// Whether fd is a terminal.\n#[effects(io, unsafe)]\npub fn sys_isatty(fd: i32) -> bool {\n    // UNSAFE: a C library call (isatty).\n    // SAFETY: isatty takes an int and touches no memory of ours.\n    unsafe { sys_c_isatty(fd) == 1 }\n}\n\n// ---- Sys: file status (0.20) ----\n\n// What stat tells of a file, the same on every system.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct FileStat {\n    dev: u64,\n    ino: u64,\n    mode: u32,\n    nlink: u64,\n    uid: u32,\n    gid: u32,\n    rdev: u64,\n    pub size: i64,\n    blocks: i64,\n    blksize: i64,\n    atime_sec: i64,\n    atime_nsec: i64,\n    pub mtime_sec: i64,\n    pub mtime_nsec: i64,\n    ctime_sec: i64,\n    ctime_nsec: i64,\n}\n\npub const SYS_S_IFMT: u32 = 0xf000;\npub const SYS_S_IFDIR: u32 = 0x4000;\npub const SYS_S_IFREG: u32 = 0x8000;\npub const SYS_S_IFLNK: u32 = 0xa000;\n\nimpl FileStat {\n    #[effects()]\n    pub fn is_dir(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(self) -> bool {\n        (self.mode & SYS_S_IFMT) == SYS_S_IFLNK\n    }\n\n    // The permission bits (the low 12 bits of mode).\n    #[effects()]\n    pub fn permissions(self) -> u32 {\n        self.mode & 0xfff\n    }\n}\n\n// struct stat on macOS (arm64, 64-bit inodes): 144 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatMacos {\n    pub st_dev: i32,\n    pub st_mode: u16,\n    pub st_nlink: u16,\n    pub st_ino: u64,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: i32,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n");
    buf_str(out, c"    st_ctime_nsec: i64,\n    st_birthtime: i64,\n    st_birthtime_nsec: i64,\n    pub st_size: i64,\n    pub st_blocks: i64,\n    pub st_blksize: i32,\n    st_flags: u32,\n    st_gen: u32,\n    st_lspare: i32,\n    st_qspare: [i64; 2],\n}\n\n// struct stat on Linux (aarch64, glibc): 128 bytes.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct StatLinux {\n    pub st_dev: u64,\n    pub st_ino: u64,\n    pub st_mode: u32,\n    pub st_nlink: u32,\n    pub st_uid: u32,\n    pub st_gid: u32,\n    pub st_rdev: u64,\n    st_pad1: u64,\n    pub st_size: i64,\n    pub st_blksize: i32,\n    st_pad2: i32,\n    pub st_blocks: i64,\n    pub st_atime: i64,\n    st_atime_nsec: i64,\n    pub st_mtime: i64,\n    st_mtime_nsec: i64,\n    pub st_ctime: i64,\n    st_ctime_nsec: i64,\n    st_unused: [i32; 2],\n}\n\n// Room for either system's struct stat.\n#[derive(Clone, Copy)] struct SysStatBuf {\n    words: [u64; 20],\n}\n\n// The FileStat in b, filled by a stat call of this system.\nfn sys_stat_decode(b: SysStatBuf) -> FileStat {\n    if TARGET_OS == 1 {\n        // UNSAFE: reads C's struct stat out of b's words, a reinterpretation.\n        // SAFETY: b holds the struct stat of Linux that stat wrote, 128 of\n        // its 160 bytes (the layout is checked against the headers by\n        // tests/run/sys_layout.vl); the words are 8-aligned, as StatLinux\n        // is; StatLinux is integers only, so any bits are a valid one.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatLinux) };\n        FileStat {\n            dev: s.st_dev,\n            ino: s.st_ino,\n            mode: s.st_mode,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n");
    buf_str(out, c"            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    } else {\n        // UNSAFE: as for Linux, above.\n        // SAFETY: as for Linux: macOS's struct stat, 144 of the 160 bytes,\n        // StatMacos integers only.\n        let s = unsafe { *(b.words.as_mut_ptr() as *mut StatMacos) };\n        FileStat {\n            dev: s.st_dev as u32 as u64,\n            ino: s.st_ino,\n            mode: s.st_mode as u32,\n            nlink: s.st_nlink as u64,\n            uid: s.st_uid,\n            gid: s.st_gid,\n            rdev: s.st_rdev as u32 as u64,\n            size: s.st_size,\n            blocks: s.st_blocks,\n            blksize: s.st_blksize as i64,\n            atime_sec: s.st_atime,\n            atime_nsec: s.st_atime_nsec,\n            mtime_sec: s.st_mtime,\n            mtime_nsec: s.st_mtime_nsec,\n            ctime_sec: s.st_ctime,\n            ctime_nsec: s.st_ctime_nsec,\n        }\n    }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_fstat(fd: i32) -> Result<FileStat, i32> {\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's fstat writes a struct stat through a raw pointer.\n    // SAFETY: b.words is a local of 160 bytes, more than either system's\n    // struct stat (144 on macOS, 128 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_fstat(fd, b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, following symbolic links.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_stat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat takes the path and writes a struct stat, through\n    // raw pointers.\n    // SAFETY: p holds a NUL-ended path (sys_cpath); b as in sys_fstat.\n");
    buf_str(out, c"    sys_check_unit(unsafe { sys_c_stat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// The status of the file at path, of a symbolic link itself.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_lstat<P: AsRef<[u8]>>(path: P) -> Result<FileStat, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    let mut b = SysStatBuf { words: [0u64; 20] };\n    // UNSAFE: as sys_stat (lstat).\n    // SAFETY: as sys_stat.\n    sys_check_unit(unsafe { sys_c_lstat(p.buf.as_ptr(), b.words.as_mut_ptr() as *mut u8) })?;\n    Ok(sys_stat_decode(b))\n}\n\n// ---- Sys: directories (0.20) ----\n\n// UNSAFE: the C library's directory calls, which take and return raw\n// pointers.\n// SAFETY: each prototype is POSIX's (dirent.h, unistd.h); a DIR * is kept\n// opaque in SysDir, and getcwd is given a slice's pointer and length.\nextern \"C\" {\n    #[link_name = \"opendir\"]\n    #[effects(io)]\n    fn sys_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    #[effects(io)]\n    fn sys_c_readdir(dir: *mut u8) -> *mut u8;\n    #[link_name = \"closedir\"]\n    #[effects(io)]\n    fn sys_c_closedir(dir: *mut u8) -> i32;\n    #[link_name = \"getcwd\"]\n    #[effects(io)]\n    fn sys_c_getcwd(buf: *mut u8, n: u64) -> *mut u8;\n    #[link_name = \"chdir\"]\n    #[effects(io)]\n    fn sys_c_chdir(path: *const u8) -> i32;\n}\n\n// struct dirent on macOS: d_name at 21, d_type at 20.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentMacos {\n    pub d_ino: u64,\n    d_seekoff: u64,\n    d_reclen: u16,\n    d_namlen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 1024],\n}\n\n// struct dirent on Linux (glibc): d_name at 19, d_type at 18.\n#[derive(Clone, Copy)] #[repr(C)]\npub struct DirentLinux {\n    pub d_ino: u64,\n    d_off: i64,\n    d_reclen: u16,\n    pub d_type: u8,\n    pub d_name: [u8; 256],\n}\n\n// An open directory (C's DIR *); sys_closedir frees it, and (0.25.4) so\n");
    buf_str(out, c"// does dropping it: a SysDir moves, it is not copied (two copies could\n// close one DIR twice, or read one closed).\npub struct SysDir {\n    handle: *mut u8,\n}\n\nimpl Drop for SysDir {\n    fn drop(&mut self) {\n        if !self.handle.is_null() {\n            let _ = sys_closedir(self);\n        }\n    }\n}\n\n// An entry read by sys_readdir_into: its name's length (the name is in the\n// caller's buffer), its kind (SYS_DT_DIR, ...; SYS_DT_UNKNOWN when the file\n// system does not say) and its inode.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysDirEntry {\n    pub name_len: i64,\n    pub kind: u8,\n    ino: u64,\n}\n\npub const SYS_DT_UNKNOWN: u8 = 0;\npub const SYS_DT_FIFO: u8 = 1;\npub const SYS_DT_CHR: u8 = 2;\npub const SYS_DT_DIR: u8 = 4;\npub const SYS_DT_BLK: u8 = 6;\npub const SYS_DT_REG: u8 = 8;\npub const SYS_DT_LNK: u8 = 10;\npub const SYS_DT_SOCK: u8 = 12;\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_opendir<P: AsRef<[u8]>>(path: P) -> Result<SysDir, i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's opendir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    let d = unsafe { sys_c_opendir(p.buf.as_ptr()) };\n    if d.is_null() {\n        return Err(sys_errno());\n    }\n    Ok(SysDir { handle: d })\n}\n\n// The next entry of dir, its name copied into name (`.` and `..` included,\n// in the order the file system gives them): None at the end.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_readdir_into(dir: &mut SysDir, name: &mut [u8; 256]) -> Result<Option<SysDirEntry>,\n    i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    sys_set_errno(0);\n    // UNSAFE: C's readdir on the raw DIR *.\n    // SAFETY: handle is the DIR * opendir returned, non-null (checked)\n    // until sys_closedir clears it; a SysDir is never copied (its Drop), so\n");
    buf_str(out, c"    // no other value closes it under this one.\n    let e = unsafe { sys_c_readdir(dir.handle) };\n    if e.is_null() {\n        let err = sys_errno();\n        return if err == 0 { Ok(None) } else { Err(err) };\n    }\n    let mut kind = 0u8;\n    let mut ino = 0u64;\n    let mut nm: &[u8] = &[];\n    // UNSAFE: reads the struct dirent readdir returned, through its raw\n    // pointer, and views its name.\n    // SAFETY: e is non-null (checked): a struct dirent of this system (the\n    // layouts checked by tests/run/sys_layout.vl), valid until the next\n    // readdir of this DIR; d_name is NUL-ended within it, and nm is copied\n    // into name before this returns.\n    unsafe {\n        if TARGET_OS == 1 {\n            let d = e as *const DirentLinux;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        } else {\n            let d = e as *const DirentMacos;\n            kind = (*d).d_type;\n            ino = (*d).d_ino;\n            nm = sys_cstr_view((*d).d_name.as_ptr());\n        }\n    }\n    if nm.len() as i64 > 256 {\n        return Err(SYS_ENAMETOOLONG);\n    }\n    for i in 0..nm.len() as i64 {\n        name[i as usize] = nm[i as usize];\n    }\n    Ok(Some(SysDirEntry { name_len: nm.len() as i64, kind: kind, ino: ino }))\n}\n\n// Closes dir (once: its handle is cleared).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_closedir(dir: &mut SysDir) -> Result<(), i32> {\n    if dir.handle.is_null() {\n        return Err(SYS_EBADF);\n    }\n    // UNSAFE: C's closedir on the raw DIR *.\n    // SAFETY: the open DIR * (non-null, checked), closed once: handle is\n    // cleared right after.\n    let r = unsafe { sys_c_closedir(dir.handle) };\n    dir.handle = 0 as *mut u8;\n    sys_check_unit(r)\n}\n\n// The working directory's path, into buf: its length (ERANGE when buf is\n// too short).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n");
    buf_str(out, c"pub fn sys_getcwd_into(buf: &mut [u8]) -> Result<i64, i32> {\n    // UNSAFE: C's getcwd writes through a raw pointer.\n    // SAFETY: buf is the caller's &mut slice: getcwd writes at most buf.len()\n    // bytes, its NUL included.\n    let r = unsafe { sys_c_getcwd(buf.as_mut_ptr(), buf.len() as u64) };\n    if r.is_null() {\n        return Err(sys_errno());\n    }\n    let mut n: i64 = 0;\n    for i in 0..buf.len() as i64 {\n        if buf[i as usize] == 0 {\n            break;\n        }\n        n += 1;\n    }\n    Ok(n)\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, P)]\npub fn sys_chdir<P: AsRef<[u8]>>(path: P) -> Result<(), i32> {\n    let path = path.as_ref();\n    let p = sys_cpath(path)?;\n    // UNSAFE: C's chdir takes the path as a raw pointer.\n    // SAFETY: p holds a NUL-ended path (sys_cpath), live past the call.\n    sys_check_unit(unsafe { sys_c_chdir(p.buf.as_ptr()) })\n}\n\n// ---- Sys: the environment (0.20) ----\n\n// UNSAFE: C's environment: the environ array, and getenv, setenv and\n// unsetenv, which take raw pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, unistd.h); environ is std::__sys's.\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    #[effects(global)]\n    fn sys_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    #[effects(global)]\n    fn sys_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    #[effects(global)]\n    fn sys_c_unsetenv(name: *const u8) -> i32;\n}\n\n// C's `environ`: the NUL-ended strings NAME=VALUE, then a null pointer.\n#[effects(alloc(extern), io, static, panic, diverge)]\npub fn sys_environ() -> *const *const u8 {\n    crate::__sys::environ()\n}\n\n// The number of the environment's variables.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_env_count() -> i64 {\n    let e = sys_environ();\n    let mut n: i64 = 0;\n    for i in 0..2147483647 {\n");
    buf_str(out, c"        // UNSAFE: indexes C's environ through its raw pointer.\n        // SAFETY: environ is an array of pointers ended by a null one; the\n        // walk stops at that null (2^31 bounds it), so each e[i] read is in\n        // the array.\n        if unsafe { (*e.add(i as usize)).is_null() } {\n            break;\n        }\n        n += 1;\n    }\n    n\n}\n\n// The environment's i-th variable, `NAME=VALUE` (i < sys_env_count()): a\n// view valid until the environment changes (sys_setenv, sys_unsetenv).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_env_at(i: i64) -> &'static [u8] {\n    if i < 0 || i >= sys_env_count() {\n        panic(\"sys_env_at: index out of bounds\");\n    }\n    // UNSAFE: indexes environ and views a C string, through raw pointers.\n    // SAFETY: 0 <= i < sys_env_count() (checked): environ[i] is a NUL-ended\n    // string, valid until the environment changes, which only the unsafe\n    // sys_setenv and sys_unsetenv do.\n    unsafe { sys_cstr_view((*sys_environ().add(i as usize))) }\n}\n\n// The value of the variable name, a view valid until the environment\n// changes; None when it is not set (or name is not a valid C string).\n#[effects(static, panic, unsafe)]\npub fn sys_getenv<P: AsRef<[u8]>>(name: P) -> Option<&'static [u8]> {\n    let name = name.as_ref();\n    let p = match sys_cpath(name) {\n        Ok(p) => p,\n        Err(_) => return None,\n    };\n    // UNSAFE: C's getenv takes the name and returns the value, as raw\n    // pointers.\n    // SAFETY: p holds a NUL-ended name (sys_cpath).\n    let v = unsafe { sys_c_getenv(p.buf.as_ptr()) };\n    if v.is_null() {\n        return None;\n    }\n    // UNSAFE: a view of the C string getenv returned.\n    // SAFETY: v is non-null (checked): a NUL-ended string in the\n    // environment, valid until it changes (only the unsafe sys_setenv and\n    // sys_unsetenv change it).\n    Some(unsafe { sys_cstr_view(v) })\n}\n\n");
    buf_str(out, c"// Sets the variable name to value. Unsafe as in Rust 2024: views of the\n// environment (sys_env_at, sys_getenv) may dangle afterwards, and other\n// threads may be reading it.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: changes C's environment, which other code reads through raw\n// pointers.\n// SAFETY: (the caller's obligation) no view of the environment\n// (sys_env_at, sys_getenv) is used after the call, and no other thread\n// reads or changes the environment during it.\npub unsafe fn sys_setenv<P: AsRef<[u8]>, Q: AsRef<[u8]>>(name: P, value: Q) -> Result<(), i32> {\n    let name = name.as_ref();\n    let value = value.as_ref();\n    let n = sys_cpath(name)?;\n    let v = sys_cpath(value)?;\n    sys_check_unit(sys_c_setenv(n.buf.as_ptr(), v.buf.as_ptr(), 1))\n}\n\n// Removes the variable name (unsafe as sys_setenv).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: as sys_setenv.\n// SAFETY: (the caller's obligation) as sys_setenv.\npub unsafe fn sys_unsetenv<P: AsRef<[u8]>>(name: P) -> Result<(), i32> {\n    let name = name.as_ref();\n    let n = sys_cpath(name)?;\n    sys_check_unit(sys_c_unsetenv(n.buf.as_ptr()))\n}\n\n// ---- Sys: processes (0.20) ----\n\n// UNSAFE: posix_spawn and the C library's process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (spawn.h, sys/wait.h, signal.h,\n// unistd.h); the file actions live in SysSpawnActions' words, larger than\n// either system's posix_spawn_file_actions_t.\nextern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    #[effects(io)]\n    fn sys_c_posix_spawnp(pid: *mut i32, file: *const u8, actions: *const u8, attr: *const u8,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n    #[effects(io)]\n    fn sys_c_actions_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn sys_c_actions_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    #[effects(io)]\n    fn sys_c_actions_adddup2(a: *mut u8, fd: i32, to: i32) -> i32;\n    #[link_name = \"posix_spawn_file_actions_addclose\"]\n    #[effects(io)]\n    fn sys_c_actions_addclose(a: *mut u8, fd: i32) -> i32;\n    #[link_name = \"waitpid\"]\n    #[effects(io)]\n    fn sys_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"kill\"]\n    #[effects(io)]\n    fn sys_c_kill(pid: i32, sig: i32) -> i32;\n    #[link_name = \"getpid\"]\n    #[effects(io)]\n    fn sys_c_getpid() -> i32;\n    // (0.25.5) Spawn attributes and signal dispositions (std::process's\n    // Command::foreground).\n    #[link_name = \"posix_spawnattr_init\"]\n    #[effects(io)]\n    fn sys_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawnattr_destroy\"]\n    #[effects(io)]\n    fn sys_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"posix_spawnattr_setflags\"]\n    #[effects(io)]\n    fn sys_c_attr_setflags(a: *mut u8, flags: i16) -> i32;\n    #[link_name = \"posix_spawnattr_setsigdefault\"]\n    #[effects(io)]\n    fn sys_c_attr_setsigdefault(a: *mut u8, set: *const u8) -> i32;\n    #[link_name = \"sigemptyset\"]\n    #[effects(io)]\n    fn sys_c_sigemptyset(set: *mut u8) -> i32;\n    #[link_name = \"sigaddset\"]\n    #[effects(io)]\n    fn sys_c_sigaddset(set: *mut u8, sig: i32) -> i32;\n    #[link_name = \"signal\"]\n    #[effects(io)]\n    fn sys_c_signal(sig: i32, handler: *const u8) -> *const u8;\n}\n\npub const SYS_SIGHUP: i32 = 1;\npub const SYS_SIGINT: i32 = 2;\npub const SYS_SIGQUIT: i32 = 3;\npub const SYS_SIGKILL: i32 = 9;\npub const SYS_SIGTERM: i32 = 15;\nconst SYS_WNOHANG: i32 = 1;\n\n// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes\n// on macOS, 80 on Linux). (0.25.4) Dropping it frees it, so it moves and\n// is never copied: two copies could destroy the actions twice.\n");
    buf_str(out, c"pub struct SysSpawnActions {\n    words: [u64; 16],\n    live: bool,\n}\n\nimpl Drop for SysSpawnActions {\n    fn drop(&mut self) {\n        self.free();\n    }\n}\n\n// Empty file actions; sys_spawn_actions_free frees them.\n#[effects(io, unsafe)]\npub fn sys_spawn_actions() -> Result<SysSpawnActions, i32> {\n    let mut a = SysSpawnActions { words: [0u64; 16], live: false };\n    // UNSAFE: C initializes the file actions through a raw pointer.\n    // SAFETY: a.words is 128 bytes, more than either system's\n    // posix_spawn_file_actions_t (8 on macOS, 80 on Linux), 8-aligned; the\n    // actions hold no pointer into themselves, so moving them is fine.\n    let r = unsafe { sys_c_actions_init(a.words.as_mut_ptr() as *mut u8) };\n    if r != 0 {\n        return Err(r);\n    }\n    a.live = true;\n    Ok(a)\n}\n\nimpl SysSpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    #[effects(io, unsafe)]\n    pub fn dup2(&mut self, fd: i32, to: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: C adds to the file actions through a raw pointer.\n        // SAFETY: live: initialized by sys_spawn_actions and not destroyed\n        // (a SysSpawnActions is never copied, see its Drop).\n        let r = unsafe { sys_c_actions_adddup2(self.words.as_mut_ptr() as *mut u8, fd, to) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    // In the child: fd is closed.\n    #[effects(io, unsafe)]\n    pub fn close(&mut self, fd: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: as dup2.\n        // SAFETY: as dup2.\n        let r = unsafe { sys_c_actions_addclose(self.words.as_mut_ptr() as *mut u8, fd) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    #[effects(io, unsafe)]\n    pub fn free(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the file actions through a raw pointer.\n");
    buf_str(out, c"            // SAFETY: live (checked): destroyed once, live cleared right\n            // after.\n            unsafe { sys_c_actions_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n// Runs prog (a path, or a name looked up in PATH) with argv (C strings\n// ending with a null pointer; argv[0] is the program's name) and envp\n// (likewise; empty: this process's environment), after the file actions\n// (null: none): the child's pid. EINVAL when argv or a non-empty envp does\n// not end with a null pointer.\n// Unsafe: prog and every pointer before argv's and envp's null must be\n// NUL-ended strings.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: posix_spawnp reads the program's name, arguments and environment\n// through raw pointers.\n// SAFETY: (the caller's obligation) prog and every pointer before argv's\n// and envp's nulls are NUL-ended strings, and actions is null or points to\n// a SysSpawnActions; the nulls that end argv and envp are checked here.\npub unsafe fn sys_spawn(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions) -> Result<i32, i32> {\n    sys_spawn_attr(prog, argv, envp, actions, 0 as *const SysSpawnAttr)\n}\n\n// (0.25.5) sys_spawn with spawn attributes (null: none).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: as sys_spawn.\n// SAFETY: (the caller's obligation) as sys_spawn's, and attr is null or\n// points to a SysSpawnAttr.\npub unsafe fn sys_spawn_attr(prog: *const u8, argv: &[*const u8], envp: &[*const u8],\n    actions: *const SysSpawnActions, attr: *const SysSpawnAttr) -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() > 0 && !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    let env = if envp.len() == 0 { sys_environ() } else { envp.as_ptr() };\n");
    buf_str(out, c"    let acts = if actions.is_null() || !(*actions).live {\n        0 as *const u8\n    } else {\n        (*actions).words.as_ptr() as *const u8\n    };\n    let at = if attr.is_null() || !(*attr).live {\n        0 as *const u8\n    } else {\n        (*attr).words.as_ptr() as *const u8\n    };\n    let mut pid = 0i32;\n    let r = sys_c_posix_spawnp(&mut pid, prog, acts, at, argv.as_ptr(), env);\n    if r != 0 {\n        return Err(r);\n    }\n    Ok(pid)\n}\n\n// (0.25.5) posix_spawnattr_t, opaque: room for either system's (8 bytes on\n// macOS, 336 on Linux). Dropping it frees it, so it moves and is never\n// copied, as SysSpawnActions.\npub struct SysSpawnAttr {\n    words: [u64; 48],\n    live: bool,\n}\n\nimpl Drop for SysSpawnAttr {\n    fn drop(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the attributes through a raw pointer.\n            // SAFETY: live (checked): initialized by sys_spawn_sigdefault,\n            // destroyed once, live cleared right after.\n            unsafe { sys_c_attr_destroy(self.words.as_mut_ptr() as *mut u8); }\n            self.live = false;\n        }\n    }\n}\n\n// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SYS_SPAWN_SETSIGDEF: i16 = 4;\n\n// (0.25.5) Spawn attributes under which the child starts with the default\n// action of each of sigs, whatever this process's are (a signal it\n// ignores, the child does not).\n#[effects(io, panic, diverge, unsafe)]\npub fn sys_spawn_sigdefault(sigs: &[i32]) -> Result<SysSpawnAttr, i32> {\n    let mut a = SysSpawnAttr { words: [0u64; 48], live: false };\n    // sigset_t: 4 bytes on macOS, 128 on Linux\n    let mut set: [u64; 16] = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the signal set through raw\n    // pointers. SAFETY: a.words (384 bytes) and set (128) are larger than\n    // either system's posix_spawnattr_t and sigset_t, 8-aligned; the\n    // attributes hold no pointer into themselves, so moving them is fine.\n    unsafe {\n");
    buf_str(out, c"        let r = sys_c_attr_init(a.words.as_mut_ptr() as *mut u8);\n        if r != 0 {\n            return Err(r);\n        }\n        a.live = true;\n        sys_c_sigemptyset(set.as_mut_ptr() as *mut u8);\n        for &sig in sigs {\n            sys_c_sigaddset(set.as_mut_ptr() as *mut u8, sig);\n        }\n        let r2 = sys_c_attr_setsigdefault(a.words.as_mut_ptr() as *mut u8,\n            set.as_mut_ptr() as *mut u8);\n        if r2 != 0 {\n            return Err(r2);\n        }\n        let r3 = sys_c_attr_setflags(a.words.as_mut_ptr() as *mut u8, SYS_SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return Err(r3);\n        }\n    }\n    Ok(a)\n}\n\n// (0.25.5) A signal's disposition before sys_signal_ignore changed it: only\n// sys_signal_ignore makes one, so sys_signal_restore sets back what C gave.\n#[derive(Clone, Copy)]\npub struct SysSignalWas {\n    sig: i32,\n    handler: *const u8,\n}\n\n// This process ignores sig (SIG_IGN) from now on: what it did before.\n#[effects(io, unsafe)]\npub fn sys_signal_ignore(sig: i32) -> SysSignalWas {\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: SIG_IGN (1 on macOS and Linux) is a disposition, not code; sig\n    // is an int (an invalid one gives SIG_ERR, restored as nothing below).\n    let was = unsafe { sys_c_signal(sig, 1 as *mut u8) };\n    SysSignalWas { sig: sig, handler: was }\n}\n\n// The disposition sys_signal_ignore replaced, set back.\n#[effects(io, unsafe)]\npub fn sys_signal_restore(was: SysSignalWas) {\n    // (SIG_ERR, -1: signal failed, nothing was changed)\n    if was.handler as i64 == -1 {\n        return;\n    }\n    // UNSAFE: C's signal, with a handler as a raw pointer.\n    // SAFETY: was.handler is what signal returned for was.sig (SysSignalWas\n    // is sealed: only sys_signal_ignore makes one): SIG_DFL, SIG_IGN, or a\n    // handler of this process, still loaded.\n    unsafe { sys_c_signal(was.sig, was.handler); }\n}\n\n");
    buf_str(out, c"// Waits for the child pid (-1: any child) to end, or with nohang only\n// looks: (its pid, its status; sys_exit_code and sys_exit_signal read it),\n// or (0, 0) when nohang and it is still running.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_waitpid(pid: i32, nohang: bool) -> Result<(i32, i32), i32> {\n    let mut status = 0i32;\n    // UNSAFE: C's waitpid writes the status through a raw pointer.\n    // SAFETY: status is a local i32.\n    let r = unsafe { sys_c_waitpid(pid, &mut status, if nohang { SYS_WNOHANG } else { 0 }) };\n    if r == -1 {\n        return Err(sys_errno());\n    }\n    Ok((r, status))\n}\n\n// The exit code of a wait status, when the process exited.\n#[effects()]\npub fn sys_exit_code(status: i32) -> Option<i32> {\n    if (status & 0x7f) == 0 { Some((status >> 8) & 0xff) } else { None }\n}\n\n// The signal that ended the process, when one did.\n#[effects()]\npub fn sys_exit_signal(status: i32) -> Option<i32> {\n    let s = status & 0x7f;\n    if s != 0 && s != 0x7f { Some(s) } else { None }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_kill(pid: i32, sig: i32) -> Result<(), i32> {\n    // UNSAFE: a C library call (kill).\n    // SAFETY: kill takes integers only and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_kill(pid, sig) })\n}\n\n#[effects(io, unsafe)]\npub fn sys_getpid() -> i32 {\n    // UNSAFE: a C library call (getpid).\n    // SAFETY: getpid takes nothing and touches no memory of ours.\n    unsafe { sys_c_getpid() }\n}\n\n// ---- Sys: terminals (0.20) ----\n\n// UNSAFE: the C library's terminal and process calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's (stdlib.h, sys/ioctl.h, termios.h,\n// unistd.h, poll.h); ioctl is variadic in C and declared so; a struct\n// termios is kept in SysTermios' words, larger than either system's.\nextern \"C\" {\n    #[link_name = \"posix_openpt\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn sys_c_posix_openpt(flags: i32) -> i32;\n    #[link_name = \"grantpt\"]\n    #[effects(io)]\n    fn sys_c_grantpt(fd: i32) -> i32;\n    #[link_name = \"unlockpt\"]\n    #[effects(io)]\n    fn sys_c_unlockpt(fd: i32) -> i32;\n    #[link_name = \"ptsname_r\"]\n    #[effects(io)]\n    fn sys_c_ptsname_r(fd: i32, buf: *mut u8, n: u64) -> i32;\n    #[link_name = \"ioctl\"]\n    #[effects(io)]\n    fn sys_c_ioctl(fd: i32, req: u64, ...) -> i32;\n    #[link_name = \"tcgetattr\"]\n    #[effects(io)]\n    fn sys_c_tcgetattr(fd: i32, t: *mut u8) -> i32;\n    #[link_name = \"tcsetattr\"]\n    #[effects(io)]\n    fn sys_c_tcsetattr(fd: i32, when: i32, t: *const u8) -> i32;\n    #[link_name = \"cfmakeraw\"]\n    #[effects()]\n    fn sys_c_cfmakeraw(t: *mut u8);\n    #[link_name = \"fork\"]\n    #[effects(io)]\n    fn sys_c_fork() -> i32;\n    #[link_name = \"setsid\"]\n    #[effects(io)]\n    fn sys_c_setsid() -> i32;\n    #[link_name = \"execve\"]\n    #[effects(io)]\n    fn sys_c_execve(path: *const u8, argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"_exit\"]\n    #[effects(io, diverge)]\n    fn sys_c_exit_now(code: i32) -> !;\n    #[link_name = \"poll\"]\n    #[effects(io)]\n    fn sys_c_poll(fds: *mut SysPollFd, n: u64, timeout: i32) -> i32;\n}\n\n// A terminal's size (struct winsize, the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysWinsize {\n    pub ws_row: u16,\n    pub ws_col: u16,\n    pub ws_xpixel: u16,\n    pub ws_ypixel: u16,\n}\n\n// struct termios, opaque: room for either system's (72 bytes on macOS, 60\n// on Linux); sys_make_raw is the one change std makes to it.\n#[derive(Clone, Copy)] pub struct SysTermios {\n    words: [u64; 16],\n}\n\n// struct pollfd (the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysPollFd {\n    pub fd: i32,\n    pub events: i16,\n    pub revents: i16,\n}\n\npub const SYS_POLLIN: i16 = 1;\n");
    buf_str(out, c"pub const SYS_POLLPRI: i16 = 2;\npub const SYS_POLLOUT: i16 = 4;\npub const SYS_POLLERR: i16 = 8;\npub const SYS_POLLHUP: i16 = 16;\npub const SYS_POLLNVAL: i16 = 32;\n\n// A new pseudo-terminal of the given size: (its controller, the terminal),\n// both close-on-exec. The controller is the program's end (what it reads\n// is the child's output); the terminal becomes the child's stdin, stdout\n// and stderr (sys_fork_exec_pty), and the caller closes its copy then.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_openpty(size: SysWinsize) -> Result<(i32, i32), i32> {\n    // UNSAFE: a C library call (posix_openpt).\n    // SAFETY: posix_openpt takes an int and touches no memory of ours.\n    let m = sys_check(unsafe { sys_c_posix_openpt(SYS_O_RDWR | SYS_O_NOCTTY) } as i64)? as i32;\n    match sys_openpty_side(m, size) {\n        Ok(s) => Ok((m, s)),\n        Err(e) => {\n            // UNSAFE: a C library call (close).\n            // SAFETY: close takes an int: the controller opened above.\n            unsafe { sys_c_close(m); }\n            Err(e)\n        }\n    }\n}\n\nfn sys_openpty_side(m: i32, size: SysWinsize) -> Result<i32, i32> {\n    sys_set_cloexec(m, true)?;\n    // UNSAFE: a C library call (grantpt).\n    // SAFETY: grantpt takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_grantpt(m) })?;\n    // UNSAFE: a C library call (unlockpt).\n    // SAFETY: unlockpt takes an int and touches no memory of ours.\n    sys_check_unit(unsafe { sys_c_unlockpt(m) })?;\n    // (0.25.4) ptsname_r, not ptsname: ptsname keeps the path in one\n    // buffer for every thread.\n    let mut nb = [0u8; 1024];\n    // UNSAFE: C's ptsname_r writes the terminal's path through a raw\n    // pointer.\n    // SAFETY: nb is a local of 1024 bytes and ptsname_r is given 1023, so\n    // the path and its NUL stay in nb and nb[1023] stays 0.\n    let r = unsafe { sys_c_ptsname_r(m, nb.as_mut_ptr() as *mut u8, 1023) };\n");
    buf_str(out, c"    let mut n: i64 = 0;\n    while r == 0 && nb[n as usize] != 0 {\n        n += 1;\n    }\n    if n == 0 {\n        return Err(sys_errno());\n    }\n    let s = sys_open(&nb[0..n as usize], SYS_O_RDWR | SYS_O_NOCTTY, 0)?;\n    match sys_set_winsize(m, size) {\n        Ok(()) => Ok(s),\n        Err(e) => {\n            // UNSAFE: a C library call (close).\n            // SAFETY: close takes an int: the terminal opened above.\n            unsafe { sys_c_close(s); }\n            Err(e)\n        }\n    }\n}\n\n// Starts path (a full path: no PATH lookup) with argv and envp (C strings\n// ending with a null pointer, built before the call) in a new session\n// whose controlling terminal is tty, the terminal end of sys_openpty, as\n// its stdin, stdout and stderr: the child's pid. Between fork and execve\n// the child calls only async-signal-safe functions (setsid, ioctl, dup2,\n// close, execve, _exit) and allocates nothing; when execve fails it exits\n// with 127.\n// Unsafe: path and every pointer before argv's and envp's nulls must be\n// NUL-ended strings.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: fork and execve, given raw pointers to the program's path,\n// arguments and environment.\n// SAFETY: (the caller's obligation) path and every pointer before argv's\n// and envp's nulls are NUL-ended strings (the nulls are checked here);\n// between fork and execve the child calls only async-signal-safe\n// functions, on integers and those pointers, and allocates nothing.\npub unsafe fn sys_fork_exec_pty(tty: i32, path: *const u8, argv: &[*const u8], envp: &[*const u8])\n    -> Result<i32, i32> {\n    if argv.len() == 0 || !argv[argv.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    if envp.len() == 0 || !envp[envp.len() - 1].is_null() {\n        return Err(SYS_EINVAL);\n    }\n    let av = argv.as_ptr();\n    let ev = envp.as_ptr();\n    let pid = sys_c_fork();\n    if pid == -1 {\n        return Err(sys_errno());\n    }\n");
    buf_str(out, c"    if pid == 0 {\n        // The child.\n        sys_c_setsid();\n        sys_c_ioctl(tty, SYS_TIOCSCTTY, 0);\n        sys_c_dup2(tty, 0);\n        sys_c_dup2(tty, 1);\n        sys_c_dup2(tty, 2);\n        if tty > 2 {\n            sys_c_close(tty);\n        }\n        sys_c_execve(path, av, ev);\n        sys_c_exit_now(127);\n    }\n    Ok(pid)\n}\n\n// Sets the size of the terminal fd (TIOCSWINSZ; on a controller, the\n// child gets SIGWINCH).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_set_winsize(fd: i32, size: SysWinsize) -> Result<(), i32> {\n    let ws = size;\n    // UNSAFE: C's ioctl (variadic) reads a struct winsize through a raw\n    // pointer.\n    // SAFETY: ws is a local SysWinsize, C's struct winsize (#[repr(C)]).\n    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCSWINSZ, &raw const ws as *mut u8) })\n}\n\n// The size of the terminal fd (TIOCGWINSZ).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_get_winsize(fd: i32) -> Result<SysWinsize, i32> {\n    let mut ws = SysWinsize { ws_row: 0, ws_col: 0, ws_xpixel: 0, ws_ypixel: 0 };\n    // UNSAFE: C's ioctl (variadic) writes a struct winsize through a raw\n    // pointer.\n    // SAFETY: ws is a local SysWinsize, C's struct winsize (#[repr(C)]).\n    sys_check_unit(unsafe { sys_c_ioctl(fd, SYS_TIOCGWINSZ, &raw mut ws as *mut u8) })?;\n    Ok(ws)\n}\n\n// The terminal fd's settings.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_tcgetattr(fd: i32) -> Result<SysTermios, i32> {\n    let mut t = SysTermios { words: [0u64; 16] };\n    // UNSAFE: C's tcgetattr writes a struct termios through a raw pointer.\n    // SAFETY: t.words is a local of 128 bytes, more than either system's\n    // struct termios (72 on macOS, 60 on Linux), 8-aligned.\n    sys_check_unit(unsafe { sys_c_tcgetattr(fd, t.words.as_mut_ptr() as *mut u8) })?;\n    Ok(t)\n}\n\n// Sets the terminal fd's settings, now (TCSANOW).\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_tcsetattr(fd: i32, t: SysTermios) -> Result<(), i32> {\n    // UNSAFE: C's tcsetattr reads a struct termios through a raw pointer.\n    // SAFETY: t.words, 128 bytes, holds the struct termios tcgetattr wrote\n    // (perhaps changed by sys_make_raw); tcsetattr only reads it.\n    sys_check_unit(unsafe { sys_c_tcsetattr(fd, 0, t.words.as_mut_ptr() as *mut u8) })\n}\n\n// Raw mode (cfmakeraw): no echo, no line editing, no signals from keys, no\n// output processing, 8-bit characters.\n#[effects(unsafe)]\npub fn sys_make_raw(t: &mut SysTermios) {\n    // UNSAFE: C's cfmakeraw changes a struct termios through a raw pointer.\n    // SAFETY: t is the caller's &mut SysTermios: its 128 bytes of words\n    // hold the struct termios, more than either system's.\n    unsafe { sys_c_cfmakeraw(t.words.as_mut_ptr() as *mut u8); }\n}\n\n// Waits until one of fds is ready or timeout_ms passes (-1: no limit):\n// how many have revents set. (0.25.4) fds is &mut: poll writes their\n// revents.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_poll(fds: &mut [SysPollFd], timeout_ms: i32) -> Result<i64, i32> {\n    // UNSAFE: C's poll reads and writes the pollfds through a raw pointer.\n    // SAFETY: fds is the caller's &mut slice of SysPollFd (C's struct\n    // pollfd, #[repr(C)]): poll touches fds.len() of them at fds.as_ptr().\n    sys_check(unsafe { sys_c_poll(fds.as_mut_ptr(), fds.len() as u64, timeout_ms) } as i64)\n}\n\n// ---- Sys: clocks and entropy (0.20) ----\n\n// UNSAFE: the C library's clock and entropy calls, which take raw\n// pointers.\n// SAFETY: the prototypes are POSIX's and the systems' (time.h; getentropy:\n// unistd.h on Linux, sys/random.h on macOS); a struct timespec is\n// SysTimespec, #[repr(C)].\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    #[effects(io)]\n    fn sys_c_clock_gettime(clock: i32, ts: *mut SysTimespec) -> i32;\n");
    buf_str(out, c"    #[link_name = \"nanosleep\"]\n    #[effects(io)]\n    fn sys_c_nanosleep(req: *const SysTimespec, rem: *mut SysTimespec) -> i32;\n    #[link_name = \"getentropy\"]\n    #[effects(io)]\n    fn sys_c_getentropy(buf: *mut u8, n: u64) -> i32;\n}\n\n// struct timespec (the same on both systems).\n#[repr(C)]\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SysTimespec {\n    pub tv_sec: i64,\n    pub tv_nsec: i64,\n}\n\npub const SYS_CLOCK_REALTIME: i32 = 0;\n\n// The time of clock (SYS_CLOCK_REALTIME, SYS_CLOCK_MONOTONIC): (seconds,\n// nanoseconds).\n#[effects(io, unsafe)]\npub fn sys_clock_gettime(clock: i32) -> (i64, i64) {\n    let mut ts = SysTimespec { tv_sec: 0, tv_nsec: 0 };\n    // UNSAFE: C's clock_gettime writes a struct timespec through a raw\n    // pointer.\n    // SAFETY: ts is a local SysTimespec; it fails only for a clock the\n    // system does not have, which reads as 0.\n    unsafe { sys_c_clock_gettime(clock, &mut ts); }\n    (ts.tv_sec, ts.tv_nsec)\n}\n\n// Sleeps for secs seconds and nanos nanoseconds (nanos < 10^9); when a\n// signal interrupts it, Err(EINTR) with the time left in *left.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_nanosleep(secs: i64, nanos: i64, left: &mut SysTimespec) -> Result<(), i32> {\n    let req = SysTimespec { tv_sec: secs, tv_nsec: nanos };\n    // UNSAFE: C's nanosleep reads and writes struct timespecs through raw\n    // pointers.\n    // SAFETY: req is a local, left the caller's &mut SysTimespec.\n    sys_check_unit(unsafe { sys_c_nanosleep(&req, left) })\n}\n\n// Fills buf with random bytes from the system (getentropy, 256 at a time).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sys_getentropy(buf: &mut [u8]) -> Result<(), i32> {\n    let mut at: i64 = 0;\n    for _ in 0..(buf.len() as i64 + 255) / 256 {\n        let n: i64 = if buf.len() as i64 - at < 256 { buf.len() as i64 - at } else { 256 };\n");
    buf_str(out, c"        // UNSAFE: C's getentropy writes through a raw pointer.\n        // SAFETY: n <= 256 bytes at buf[at..at + n].as_mut_ptr(), a subslice of buf\n        // (bounds-checked).\n        let r = unsafe {\n            sys_c_getentropy(buf[at as usize..(at + n) as usize].as_mut_ptr(), n as u64)\n        };\n        if r != 0 {\n            return Err(sys_errno());\n        }\n        at += n;\n    }\n    Ok(())\n}\n// ---- end mod std::sys ----\n}\n// ---- mod std::capture ----\npub mod capture {\n// EDITION: rust\n// std::capture (0.25.4; std2 0.28.0): a request to write the next frame\n// presented to a file, which std::window's scripted event loop makes (its\n// `shot FILE` command) and std::gpu serves (Frame::present). It is a\n// module of its own so that neither of those needs the other. A program\n// reaches it as std::gpu::capture_next_frame. vole's own: Rust's std has\n// no windows.\n//\n// The request is a static, so any thread may make or serve one: a spin\n// lock (an AtomicBool) guards the path's bytes and length, which are only\n// read or written while it is held.\n// mvs: std::capture\n\nuse crate::alloc::Allocator;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::sync::atomic::{AtomicBool, Ordering};\n\n// The longest path a request takes, in bytes.\npub const MAX_PATH: usize = 1024;\n\n// Held while PATH and LEN are read or written.\nstatic LOCK: AtomicBool = AtomicBool::new(false);\n// The file the next presented frame goes to (LEN < 0: none asked for).\nstatic mut PATH: [u8; 1024] = [0; 1024];\nstatic mut LEN: i64 = -1;\n\nfn lock() {\n    while LOCK.compare_exchange_weak(false, true, Ordering::Acquire, Ordering::Relaxed).is_err() {}\n}\n\nfn unlock() {\n    LOCK.store(false, Ordering::Release);\n}\n\n// The next frame presented (std::gpu's `Frame::present`) is also written\n// to path, a binary PPM. A new request replaces one not yet served; false\n// (and nothing is asked) when path is longer than MAX_PATH bytes.\n");
    buf_str(out, c"// std2: changed: path a &str (MVS: [u8])\n#[effects(io, static, sync, panic, diverge)]\npub fn capture_next_frame(path: &str) -> bool {\n    let b = path.as_bytes();\n    if b.len() > MAX_PATH {\n        return false;\n    }\n    lock();\n    // UNSAFE: writes the static mut request.\n    // SAFETY: the lock is held, so no other thread reads or writes PATH or\n    // LEN; i < b.len() <= 1024, PATH's length; no reference to either is\n    // made (place writes only).\n    unsafe {\n        for i in 0..b.len() {\n            PATH[i] = b[i];\n        }\n        LEN = b.len() as i64;\n    }\n    unlock();\n    true\n}\n\n// A capture is asked for, and no frame was presented since.\n#[effects(io, static, sync, panic, diverge)]\npub fn capture_pending() -> bool {\n    lock();\n    // UNSAFE: reads the static mut LEN.\n    // SAFETY: the lock is held: no thread writes LEN meanwhile; a copy of\n    // the value, no reference.\n    let pending = unsafe { LEN >= 0 };\n    unlock();\n    pending\n}\n\n// Forgets the capture asked for, if any.\n#[effects(io, static, sync, panic, diverge)]\npub fn capture_cancel() {\n    lock();\n    // UNSAFE: writes the static mut LEN.\n    // SAFETY: the lock is held: no other thread reads or writes it.\n    unsafe {\n        LEN = -1;\n    }\n    unlock();\n}\n\n// The file asked for, appended to out, and the request forgotten; false\n// (out unchanged) when none was asked for.\n// std2: changed: out a &mut String<A>\n#[effects(io, static, sync, panic, diverge, A)]\npub fn take_capture<A: Allocator>(out: &mut String<A>) -> bool {\n    lock();\n    // UNSAFE: reads and clears the static mut request.\n    // SAFETY: the lock is held: no other thread reads or writes PATH or\n    // LEN; both are copied out by value (no reference to a static mut).\n    let (bytes, len) = unsafe {\n        let r = (PATH, LEN);\n        LEN = -1;\n        r\n    };\n    unlock();\n    if len < 0 {\n        return false;\n    }\n");
    buf_str(out, c"    // (the bytes were a &str's: capture_next_frame's argument)\n    match crate::str::from_utf8(&bytes[0..len as usize]) {\n        Result::Ok(s) => out.push_str(s),\n        Result::Err(_) => crate::panic::unreachable(),\n    }\n    true\n}\n// ---- end mod std::capture ----\n}\n// ---- mod std::env ----\npub mod env {\n// EDITION: rust\n// std::env: the program's arguments and environment, Rust's names. The\n// arguments are views of argv, valid for the whole program (no\n// allocation); a variable's value is copied onto an allocator (`var_in`),\n// since the environment can change under a view. argv comes from the\n// target's system, std::__sys (std2/rt/sys_macos.vl, sys_linux.vl).\n// mvs: std::env\n\nuse crate::alloc::Allocator;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::{DoubleEndedIterator, ExactSizeIterator, Iterator};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// The i-th of n C strings at argv, its bytes (without the NUL).\nfn arg_bytes(argv: *const *const u8, n: usize, i: usize) -> &'static [u8] {\n    if i >= n {\n        crate::panic::panic(\"env: argument index out of bounds\");\n    }\n    // UNSAFE: reads argv[i] and the NUL-ended C string it points to.\n    // SAFETY: i < n = argc (checked); argv[0..argc] are crt's (or the\n    // /proc copy's) NUL-ended strings, kept for the whole program and\n    // never written after main starts.\n    unsafe {\n        let p = *argv.add(i);\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        crate::ptr::slice_parts(p, len)\n    }\n}\n\n// The arguments, the program's name first: `for a in env::args()`,\n// `env::args().skip(1)`. One that is not UTF-8 stops the program (as\n// Rust's); `args_os()` yields bytes.\n// std2: changed: yields &'static str views, not Strings (no allocator)\n#[effects(alloc(extern), io, static, sync, panic, diverge)]\npub fn args() -> Args {\n");
    buf_str(out, c"    let (n, argv) = crate::__sys::args();\n    Args { front: 0, back: n, n: n, argv: argv }\n}\n\n// The arguments as bytes.\n// std2: changed: yields &'static [u8] (Rust: OsString)\n#[effects(alloc(extern), io, static, sync, panic, diverge)]\npub fn args_os() -> ArgsOs {\n    let (n, argv) = crate::__sys::args();\n    ArgsOs { front: 0, back: n, n: n, argv: argv }\n}\n\n// env::args's iterator.\npub struct Args {\n    front: usize,\n    back: usize,\n    n: usize,\n    argv: *const *const u8,\n}\n\nfn arg_str(b: &'static [u8]) -> &'static str {\n    match crate::str::from_utf8(b) {\n        Result::Ok(s) => s,\n        Result::Err(_) => crate::panic::panic(\n            \"env::args: an argument is not UTF-8 (env::args_os yields bytes)\"),\n    }\n}\n\nimpl Iterator for Args {\n    type Item = &'static str;\n\n    fn next(&mut self) -> Option<&'static str> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.front);\n        self.front += 1;\n        Option::Some(arg_str(b))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let k = self.back - self.front;\n        (k, Option::Some(k))\n    }\n}\n\nimpl DoubleEndedIterator for Args {\n    fn next_back(&mut self) -> Option<&'static str> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        self.back -= 1;\n        Option::Some(arg_str(arg_bytes(self.argv, self.n, self.back)))\n    }\n}\n\nimpl ExactSizeIterator for Args {}\n\nimpl Debug for Args {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let mut l = f.debug_list();\n        let mut i = self.front;\n        while i < self.back {\n            l.entry(&arg_str(arg_bytes(self.argv, self.n, i)));\n            i += 1;\n        }\n        l.finish()\n    }\n}\n\n// env::args_os's iterator.\npub struct ArgsOs {\n    front: usize,\n    back: usize,\n    n: usize,\n    argv: *const *const u8,\n}\n\n");
    buf_str(out, c"impl Iterator for ArgsOs {\n    type Item = &'static [u8];\n\n    fn next(&mut self) -> Option<&'static [u8]> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.front);\n        self.front += 1;\n        Option::Some(b)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let k = self.back - self.front;\n        (k, Option::Some(k))\n    }\n}\n\nimpl DoubleEndedIterator for ArgsOs {\n    fn next_back(&mut self) -> Option<&'static [u8]> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        self.back -= 1;\n        Option::Some(arg_bytes(self.argv, self.n, self.back))\n    }\n}\n\nimpl ExactSizeIterator for ArgsOs {}\n\n// Why env::var_in failed: the variable is not set, or its value is not\n// UTF-8.\n// std2: changed: NotUnicode has no payload (Rust: the OsString)\n#[derive(Clone, PartialEq, Eq, Debug)]\npub enum VarError {\n    NotPresent,\n    NotUnicode,\n}\n\nimpl Display for VarError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self {\n            VarError::NotPresent => f.write_str(\"environment variable not found\"),\n            VarError::NotUnicode => f.write_str(\"environment variable was not valid unicode\"),\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: POSIX's prototypes (stdlib.h).\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    fn env_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    fn env_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    fn env_c_unsetenv(name: *const u8) -> i32;\n    #[link_name = \"getcwd\"]\n    fn env_c_getcwd(buf: *mut u8, size: usize) -> *mut u8;\n    #[link_name = \"chdir\"]\n    fn env_c_chdir(path: *const u8) -> i32;\n}\n\n// s and a NUL in buf; false when it does not fit or holds a NUL (or, for\n// a name, is empty or holds `=`: no variable has such a name).\n");
    buf_str(out, c"fn c_string(s: &str, buf: &mut [u8], name: bool) -> bool {\n    let b = s.as_bytes();\n    if b.len() >= buf.len() || (name && b.len() == 0) {\n        return false;\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 || (name && b[i] == 61) {\n            return false;\n        }\n        buf[i] = b[i];\n        i += 1;\n    }\n    buf[b.len()] = 0;\n    true\n}\n\n// The value of variable key, as the bytes C's environment holds now.\nfn get_bytes(key: &str) -> Option<&'static [u8]> {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        return Option::None;\n    }\n    // UNSAFE: C's getenv, then a view of the C string it returns.\n    // SAFETY: nb holds a NUL-ended name; getenv's result is null or a\n    // NUL-ended string of the environment, read here before the caller\n    // copies it (set_var and remove_var, which may free it, are unsafe\n    // and their callers promise no reader meanwhile).\n    unsafe {\n        let p = env_c_getenv(&nb[0] as *const u8);\n        if p.is_null() {\n            return Option::None;\n        }\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The value of variable key, copied into a new String on allocator a\n// (Rust's env::var).\n// mvs: get_in\n// std2: changed: the key is a &str\n#[effects(static, panic, diverge, A)]\npub fn var_in<A: Allocator>(key: &str, a: A) -> Result<String<A>, VarError> {\n    match get_bytes(key) {\n        Option::Some(v) => match crate::str::from_utf8(v) {\n            Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n            Result::Err(_) => Result::Err(VarError::NotUnicode),\n        },\n        Option::None => Result::Err(VarError::NotPresent),\n    }\n}\n\n// The value of variable key, its bytes copied into a new Vec on a.\n// std2: changed: the key is a &str, the value a Vec<u8, A> (Rust: OsString)\n");
    buf_str(out, c"#[effects(static, panic, diverge, A)]\npub fn var_os_in<A: Allocator>(key: &str, a: A) -> Option<Vec<u8, A>> {\n    match get_bytes(key) {\n        Option::Some(v) => {\n            let mut out: Vec<u8, A> = Vec::with_capacity_in(v.len(), a);\n            out.extend_from_slice(v);\n            Option::Some(out)\n        }\n        Option::None => Option::None,\n    }\n}\n\n// Sets variable key to value (Rust 2024's `unsafe fn`). Panics on a key\n// that is empty or holds `=` or a NUL, or a value with a NUL (as Rust's),\n// and on a key over 1 KB or a value over 64 KB.\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\n// UNSAFE: changes the environment (C's setenv), which another thread's\n// getenv may be reading.\n// SAFETY: (the caller's) no other thread reads or writes the environment\n// meanwhile, and no value read from it before (a getenv view) is used\n// after.\n// std2: changed: key and value are &str\npub unsafe fn set_var(key: &str, value: &str) {\n    let mut nb = [0u8; 1024];\n    let mut vb = [0u8; 65536];\n    if !c_string(key, &mut nb[..], true) || !c_string(value, &mut vb[..], false) {\n        crate::panic::panic(\"env::set_var: a key or value that C's environment cannot hold\");\n    }\n    // UNSAFE: C's setenv. SAFETY: two NUL-ended strings; the caller's\n    // promise above.\n    let _ = unsafe { env_c_setenv(&nb[0] as *const u8, &vb[0] as *const u8, 1) };\n}\n\n// Removes variable key (Rust 2024's `unsafe fn`).\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\n// UNSAFE: as set_var: C's unsetenv.\n// SAFETY: (the caller's) as set_var.\n// std2: changed: the key is a &str\npub unsafe fn remove_var(key: &str) {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        crate::panic::panic(\"env::remove_var: a key that C's environment cannot hold\");\n    }\n    // UNSAFE: C's unsetenv. SAFETY: a NUL-ended string; the caller's\n    // promise above.\n");
    buf_str(out, c"    let _ = unsafe { env_c_unsetenv(&nb[0] as *const u8) };\n}\n\n// Every variable, (name, value), each copied into a String on allocator a\n// as the iterator reaches it (Rust's env::vars). A name or value that is\n// not UTF-8 stops the program, as Rust's; an entry without `=` is left\n// out.\n// std2: changed: takes an allocator\n#[effects()]\npub fn vars_in<A: Allocator + Clone>(a: A) -> Vars<A> {\n    Vars { at: 0, a: a }\n}\n\n// env::vars_in's iterator: environ's entries from index at. set_var and\n// remove_var, which change environ, are unsafe: their callers promise no\n// iterator meanwhile.\npub struct Vars<A: Allocator> {\n    at: usize,\n    a: A,\n}\n\nimpl<A: Allocator + Clone> Iterator for Vars<A> {\n    type Item = (String<A>, String<A>);\n\n    fn next(&mut self) -> Option<(String<A>, String<A>)> {\n        loop {\n            let kv = match env_entry(self.at) {\n                Option::Some(kv) => kv,\n                Option::None => return Option::None,\n            };\n            self.at += 1;\n            // (from index 1: a name may start with `=`, as Rust's parse)\n            let mut eq: usize = 1;\n            while eq < kv.len() && kv[eq] != 61 {\n                eq += 1;\n            }\n            if eq >= kv.len() {\n                continue;\n            }\n            let (k, v) = match (crate::str::from_utf8(&kv[..eq]),\n                crate::str::from_utf8(&kv[eq + 1..])) {\n                (Result::Ok(k), Result::Ok(v)) => (k, v),\n                _ => crate::panic::panic(\"env::vars_in: a variable is not valid unicode\"),\n            };\n            return Option::Some((String::from_in(k, self.a.clone()),\n                String::from_in(v, self.a.clone())));\n        }\n    }\n}\n\n// The i-th entry of C's environment, `NAME=value`, as its bytes; None\n// past the last.\nfn env_entry(i: usize) -> Option<&'static [u8]> {\n    let env = crate::__sys::environ();\n");
    buf_str(out, c"    // UNSAFE: reads environ[0..=i] and the NUL-ended C string at i.\n    // SAFETY: environ is a null-ended array of NUL-ended strings; the\n    // entries before i were read non-null (the loop stops at the null),\n    // and nothing changes it meanwhile (set_var and remove_var are unsafe:\n    // their callers' promise).\n    unsafe {\n        let mut k: usize = 0;\n        while k < i {\n            if (*env.add(k)).is_null() {\n                return Option::None;\n            }\n            k += 1;\n        }\n        let p = *env.add(i);\n        if p.is_null() {\n            return Option::None;\n        }\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The current working directory, copied into a new String on allocator a\n// (Rust's env::current_dir). Up to 4 KB.\n// std2: changed: a String<A> on an allocator (Rust: a PathBuf)\n// mvs: current_dir_in\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe, A)]\npub fn current_dir_in<A: Allocator>(a: A) -> crate::io::Result<String<A>> {\n    let mut buf = [0u8; 4096];\n    // UNSAFE: C's getcwd into buf. SAFETY: buf holds 4096 bytes, the size\n    // given; getcwd writes a NUL-ended path within them or fails (null).\n    let p = unsafe { env_c_getcwd(&mut buf[0] as *mut u8, 4096) };\n    if p.is_null() {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    let mut n: usize = 0;\n    while n < buf.len() && buf[n] != 0 {\n        n += 1;\n    }\n    match crate::str::from_utf8(&buf[..n]) {\n        Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n        Result::Err(_) => Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidData,\n            \"the current directory is not UTF-8\")),\n    }\n}\n\n// Makes path the working directory (Rust's env::set_current_dir).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n");
    buf_str(out, c"#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn set_current_dir<P: crate::convert::AsRef<str>>(path: P) -> crate::io::Result<()> {\n    let path = path.as_ref();\n    let mut pb = [0u8; 4096];\n    if !c_string(path, &mut pb[..], false) {\n        return Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidInput,\n            \"a path that C cannot hold\"));\n    }\n    // UNSAFE: C's chdir. SAFETY: pb holds a NUL-ended path.\n    if unsafe { env_c_chdir(&pb[0] as *const u8) } != 0 {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    Result::Ok(())\n}\n// ---- end mod std::env ----\n}\n// ---- mod std::cli ----\npub mod cli {\n// EDITION: rust\n// std::cli (0.24, docs/design/cli.md, guide cli): a command-line parser,\n// clap's builder without derive (the overview: below the first banner).\n// The rust edition's (0.27.5): names, help and the words parsed are\n// `&'a str` views, so Arg, Command, Matches and CliError carry the\n// lifetime of the text they were given; counts and widths are usize and\n// a short form is a char, as clap's (indices_of's are i64s, as MVS's).\n// mvs: std::cli\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::str::FromStr;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// ---- Arguments and commands (0.24) ----\n\n// A Command lists its arguments (flags, options with a value,\n// positionals) and subcommands; `cmd.parse(args)`\n// gives the Matches, or a CliError that `cmd.exit(e)` prints with the\n// usage line (exit code 2; 0 for --help and --version).\n//\n//     let cmd = Command::new_in(\"grep\", gpa).version(\"1.0\")\n//         .arg(Arg::flag(\"count\").short('c').help(\"count the matches\"))\n//         .arg(Arg::option(\"max\").short('m').value_name(\"N\").default(\"0\"))\n");
    buf_str(out, c"//         .arg(Arg::positional(\"pattern\").required())\n//         .arg(Arg::positional(\"file\").multiple());\n//     let m = cmd.parse_or_exit(env::args());\n//     let n = m.get_as::<i64>(\"max\").unwrap_or(0);\n//\n// Accepted: `-v`, `-vvv` (m.count), `-abc` (a cluster of short flags;\n// an option in it takes the rest, `-ofile`), `-o FILE`, `--out FILE`,\n// `--out=FILE`, `--` (everything after it is positional), `-` (a\n// positional). An option takes the next argument as its value even when\n// it starts with '-' (`--n -5`). An option given twice keeps both values\n// (m.values; m.get: the last). A positional takes one value, or every one\n// left with `.multiple()`. A subcommand's name ends its parent's\n// arguments; its own follow.\n//\n// (0.25.2) Clap's too: `.global()` (an argument the subcommands accept),\n// `.alias(s)` and `.hide()` (of an Arg and of a Command), `.num_values(n)`\n// (`--overlay PATH COPY`), `.default_missing(s)` (`--stats`,\n// `--stats=x`), `.allow_hyphen_values()` (a positional `-> bool`),\n// `.last()` (the words after `--`), `.conflicts_with(name)` and\n// `Command::subcommand_required()`.\n//\n// Parsing is pure but for its allocation: the definition is on the Gpa\n// given to Command::new_in, the Matches on the Gpa or on the allocator\n// given to parse_in (an arena: `arena_scope(gpa, |a| { let m =\n// cmd.parse_in(args, a)?; .. })`). Help and error text are built in a\n// scoped arena when cmd.exit prints them. Only exit and parse_or_exit do\n// io.\n\nconst FLAG: i64 = 0;\nconst OPTION: i64 = 1;\nconst POSITIONAL: i64 = 2;\n\n// One argument of a command: a flag (`-v`, `--verbose`), an option with a\n// value (`-o FILE`, `--out FILE`, `--out=FILE`) or a positional, made by\n// Arg::flag, Arg::option or Arg::positional; each method returns the\n// changed Arg. Its name is what Matches asks for (`m.flag(\"verbose\")`);\n// a flag's or option's long form is its name unless `.long(..)`.\n#[derive(Clone, Copy)]\n");
    buf_str(out, c"pub struct Arg<'a> {\n    name: &'a str,\n    kind: i64,\n    short: char,\n    long: &'a str,\n    help: &'a str,\n    value_name: &'a str,\n    default: &'a str,\n    has_default: bool,\n    required: bool,\n    multiple: bool,\n    // (0.25) the values it takes, `fast|slow` (\"\": any)\n    choices: &'a str,\n    cmd: i64,\n    // (0.25.2) accepted by the subcommands too; its other long names; not\n    // in the help; how many values an option takes; the value of an\n    // option given without one; values starting with '-'; a positional\n    // after `--`; the arguments it cannot be given with\n    global: bool,\n    aliases: Names<'a>,\n    hidden: bool,\n    num_values: i64,\n    missing: &'a str,\n    has_missing: bool,\n    hyphen: bool,\n    last: bool,\n    conflicts: Names<'a>,\n}\n\n// (0.25.2) Up to 4 names (aliases, conflicts), each one or several\n// separated by '|': a plain value of views, no allocation.\n#[derive(Clone, Copy)]\nstruct Names<'a> {\n    a: &'a str,\n    b: &'a str,\n    c: &'a str,\n    d: &'a str,\n    n: i64,\n}\n\nimpl<'a> Names<'a> {\n    fn none() -> Names<'a> {\n        Names { a: \"\", b: \"\", c: \"\", d: \"\", n: 0 }\n    }\n\n    fn put(&mut self, s: &'a str) {\n        if self.n == 0 {\n            self.a = s;\n        } else if self.n == 1 {\n            self.b = s;\n        } else if self.n == 2 {\n            self.c = s;\n        } else if self.n == 3 {\n            self.d = s;\n        } else {\n            crate::panic::panic(\"std::cli: at most 4 alias or conflicts_with calls per Arg or Command (one may list several: \\\"a|b\\\")\");\n        }\n        self.n += 1;\n    }\n\n    fn name_at(self, i: i64) -> &'a str {\n        if i == 0 { self.a } else if i == 1 { self.b } else if i == 2 { self.c } else { self.d }\n    }\n\n    // Whether word is one of them.\n    fn has(self, word: &str) -> bool {\n        for i in 0..self.n {\n            for w in self.name_at(i).split('|') {\n                if w == word {\n");
    buf_str(out, c"                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The distance from word to the nearest of them (64: none).\n    fn nearest(self, word: &str) -> i64 {\n        let mut bd: i64 = 64;\n        for i in 0..self.n {\n            for w in self.name_at(i).split('|') {\n                let d = distance(word, w);\n                if d < bd {\n                    bd = d;\n                }\n            }\n        }\n        bd\n    }\n}\n\nimpl<'a> Arg<'a> {\n    fn make(name: &'a str, kind: i64) -> Arg<'a> {\n        let mut long: &'a str = name;\n        if kind == POSITIONAL {\n            long = \"\";\n        }\n        Arg {\n            name: name, kind: kind, short: '\\0', long: long, help: \"\", value_name: \"\",\n            default: \"\", has_default: false, required: false, multiple: false, choices: \"\",\n            cmd: 0, global: false, aliases: Names::none(), hidden: false, num_values: 1,\n            missing: \"\", has_missing: false, hyphen: false, last: false,\n            conflicts: Names::none(),\n        }\n    }\n\n    // A flag, `--NAME` (and `.short('x')`): m.flag(name), m.count(name).\n    #[effects()]\n    pub fn flag(name: &'a str) -> Arg<'a> {\n        Arg::make(name, FLAG)\n    }\n\n    // An option with a value, `--NAME VALUE` or `--NAME=VALUE`: m.get(name).\n    #[effects()]\n    pub fn option(name: &'a str) -> Arg<'a> {\n        Arg::make(name, OPTION)\n    }\n\n    // A positional argument, in the order of the command's `.arg` calls.\n    #[effects()]\n    pub fn positional(name: &'a str) -> Arg<'a> {\n        Arg::make(name, POSITIONAL)\n    }\n\n    // Its one-letter form, `-c`.\n    // std2: changed: a char, as clap's (MVS: a byte)\n    #[effects()]\n    pub fn short(mut self, c: char) -> Arg<'a> {\n        self.short = c;\n        self\n    }\n\n    // Its long form, `--s`, instead of its name (`\"\"`: none).\n    #[effects()]\n    pub fn long(mut self, s: &'a str) -> Arg<'a> {\n");
    buf_str(out, c"        self.long = s;\n        self\n    }\n\n    // Its line in the help.\n    #[effects()]\n    pub fn help(mut self, s: &'a str) -> Arg<'a> {\n        self.help = s;\n        self\n    }\n\n    // The name of an option's value in the help, `--out <FILE>` (the name\n    // in capitals by default).\n    #[effects()]\n    pub fn value_name(mut self, s: &'a str) -> Arg<'a> {\n        self.value_name = s;\n        self\n    }\n\n    // The value when it is not given (m.get gives it; m.flag stays false).\n    #[effects()]\n    pub fn default(mut self, s: &'a str) -> Arg<'a> {\n        self.default = s;\n        self.has_default = true;\n        self\n    }\n\n    // An error when it is not given.\n    #[effects()]\n    pub fn required(mut self) -> Arg<'a> {\n        self.required = true;\n        self\n    }\n\n    // A positional that takes every value left (m.values).\n    #[effects()]\n    pub fn multiple(mut self) -> Arg<'a> {\n        self.multiple = true;\n        self\n    }\n\n    // (0.25) The values it takes, `\"fast|slow\"`: another is an InvalidValue\n    // error (`try: --mode <fast|slow>`); the help shows them.\n    #[effects()]\n    pub fn choices(mut self, s: &'a str) -> Arg<'a> {\n        self.choices = s;\n        self\n    }\n\n    // (0.25.2) A flag or option of a command that its subcommands accept\n    // too, at any depth, before or after their names (`prog --root D sub`,\n    // `prog sub --root D`); every level's Matches reads it.\n    #[effects()]\n    pub fn global(mut self) -> Arg<'a> {\n        self.global = true;\n        self\n    }\n\n    // (0.25.2) Another long name, `--s` (called again: more; `\"a|b\"`: two);\n    // not in the help; the did-you-mean suggests the Arg's own.\n    #[effects(panic, diverge)]\n    pub fn alias(mut self, s: &'a str) -> Arg<'a> {\n        self.aliases.put(s);\n        self\n    }\n\n    // (0.25.2) Accepted, but not in the help (a deprecated spelling).\n    #[effects()]\n");
    buf_str(out, c"    pub fn hide(mut self) -> Arg<'a> {\n        self.hidden = true;\n        self\n    }\n\n    // (0.25.2) An option taking n values, `--overlay PATH COPY`: m.values\n    // gives them in order, n more each time it is given; fewer is a\n    // MissingValue error. Their names in the help: `.value_name(\"PATH\n    // COPY\")`.\n    // std2: changed: a usize (MVS: i64)\n    #[effects()]\n    pub fn num_values(mut self, n: usize) -> Arg<'a> {\n        self.num_values = if n < 1 { 1 } else { n as i64 };\n        self\n    }\n\n    // (0.25.2) An option whose value is optional: `--stats` alone gives s,\n    // `--stats=x` (or `-s=x`) gives x; only the `=` form gives it one.\n    #[effects()]\n    pub fn default_missing(mut self, s: &'a str) -> Arg<'a> {\n        self.missing = s;\n        self.has_missing = true;\n        self\n    }\n\n    // (0.25.2) Its values may start with '-': a positional so marked takes\n    // a word starting with '-' that is no option of the command (`grep\n    // '-> bool'`). (An option takes its next argument as its value\n    // anyway.)\n    #[effects()]\n    pub fn allow_hyphen_values(mut self) -> Arg<'a> {\n        self.hyphen = true;\n        self\n    }\n\n    // (0.25.2) A positional that takes only the words after `--`: `probe\n    // FILE:LINE EXPR... -- ARGS...` (EXPR multiple, ARGS multiple and\n    // last).\n    #[effects()]\n    pub fn last(mut self) -> Arg<'a> {\n        self.last = true;\n        self\n    }\n\n    // (0.25.2) Given together with the argument named name (either way\n    // round) is an ArgumentConflict error. Called again: more names.\n    #[effects(panic, diverge)]\n    pub fn conflicts_with(mut self, name: &'a str) -> Arg<'a> {\n        self.conflicts.put(name);\n        self\n    }\n\n    // Whether it is called word on the command line (`--word`).\n    fn long_is(self, word: &str) -> bool {\n        self.kind != POSITIONAL && (self.long.len() as i64 > 0 && self.long == word\n");
    buf_str(out, c"            || self.aliases.has(word))\n    }\n}\n\n// Whether v is one of choices (`fast|slow`; \"\": any).\nfn chosen(v: &str, choices: &str) -> bool {\n    if choices.len() as i64 == 0 {\n        return true;\n    }\n    for c in choices.split('|') {\n        if c == v {\n            return true;\n        }\n    }\n    false\n}\n\n// A command of the tree: its subcommands are those whose parent it is.\n#[derive(Clone, Copy)]\nstruct Cmd<'a> {\n    name: &'a str,\n    about: &'a str,\n    version: &'a str,\n    parent: i64,\n    // (0.25.2) its other names; not in the help; no subcommand an error\n    aliases: Names<'a>,\n    hidden: bool,\n    sub_required: bool,\n}\n\n// A program's command line: its name, arguments and subcommands. The\n// tree is kept flat, every command in `cmds` (the first is this one) and\n// every argument in `args` with its command's index.\npub struct Command<'a, CA: Allocator> {\n    cmds: Vec<Cmd<'a>, CA>,\n    args: Vec<Arg<'a>, CA>,\n    width: i64,\n    // (0.25: any allocator, an arena too; before, the Gpa)\n    alloc: CA,\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // A command named name, its definition on allocator a (the Gpa, or an\n    // arena: 0.25).\n    #[effects(CA)]\n    pub fn new_in(name: &'a str, a: CA) -> Command<'a, CA> {\n        let mut cmds: Vec<Cmd<'a>, CA> = Vec::new_in(a.clone());\n        cmds.push(Cmd {\n            name: name, about: \"\", version: \"\", parent: -1, aliases: Names::none(),\n            hidden: false, sub_required: false,\n        });\n        Command { cmds: cmds, args: Vec::new_in(a.clone()), width: 80, alloc: a }\n    }\n\n    // The help's line under the name.\n    #[effects(panic, CA)]\n    pub fn about(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].about = s;\n        self\n    }\n\n    // Its version: `--version` (and `-V`) print `NAME VERSION`.\n    #[effects(panic, CA)]\n    pub fn version(mut self, s: &'a str) -> Command<'a, CA> {\n");
    buf_str(out, c"        self.cmds[0].version = s;\n        self\n    }\n\n    // The help's width in columns (80).\n    // std2: changed: a usize (MVS: i64)\n    #[effects()]\n    pub fn width(mut self, n: usize) -> Command<'a, CA> {\n        self.width = n as i64;\n        self\n    }\n\n    // (0.25.2) Another name of this subcommand (called again: more;\n    // `\"a|b\"`: two); m.subcommand() gives its own name.\n    #[effects(panic, diverge, CA)]\n    pub fn alias(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].aliases.put(s);\n        self\n    }\n\n    // (0.25.2) A subcommand accepted, but not in its parent's help.\n    #[effects(panic, CA)]\n    pub fn hide(mut self) -> Command<'a, CA> {\n        self.cmds[0].hidden = true;\n        self\n    }\n\n    // (0.25.2) No subcommand given is a MissingSubcommand error (its try:\n    // line names them).\n    #[effects(panic, CA)]\n    pub fn subcommand_required(mut self) -> Command<'a, CA> {\n        self.cmds[0].sub_required = true;\n        self\n    }\n\n    // Adds an argument.\n    #[effects(CA)]\n    pub fn arg(mut self, a: Arg<'a>) -> Command<'a, CA> {\n        let mut x = a;\n        x.cmd = 0;\n        self.args.push(x);\n        self\n    }\n\n    // Adds a subcommand: `prog NAME ...`, m.subcommand().\n    #[effects(panic, CA)]\n    pub fn subcommand(mut self, sub: Command<'a, CA>) -> Command<'a, CA> {\n        let base = self.cmds.len() as i64;\n        for i in 0..sub.cmds.len() as i64 {\n            let mut c = sub.cmds[i as usize];\n            c.parent = if c.parent < 0 { 0 } else { c.parent + base };\n            self.cmds.push(c);\n        }\n        for i in 0..sub.args.len() as i64 {\n            let mut a = sub.args[i as usize];\n            a.cmd = a.cmd + base;\n            self.args.push(a);\n        }\n        self\n    }\n\n    // The subcommand of c named name, or -1.\n    fn sub_named(&self, c: i64, name: &str) -> i64 {\n        for i in 1..self.cmds.len() as i64 {\n");
    buf_str(out, c"            if self.cmds[i as usize].parent == c\n                && (self.cmds[i as usize].name == name || self.cmds[i as usize].aliases.has(name)) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Whether argument a is one of command c's: its own, or a\n    // global one of c's parent, grandparent...\n    fn of_cmd(&self, a: Arg<'a>, c: i64) -> bool {\n        if a.cmd == c {\n            return true;\n        }\n        if !a.global || a.kind == POSITIONAL {\n            return false;\n        }\n        let mut p = self.cmds[c as usize].parent;\n        while p >= 0 {\n            if p == a.cmd {\n                return true;\n            }\n            p = self.cmds[p as usize].parent;\n        }\n        false\n    }\n\n    // The command of Matches level `level`.\n    fn cmds_of<A: Allocator + Clone>(&self, level: i64, m: &Matches<'a, A>) -> i64 {\n        m.cmds[level as usize]\n    }\n\n    fn has_subs(&self, c: i64) -> bool {\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c {\n                return true;\n            }\n        }\n        false\n    }\n}\n\n// ---- Parsing (0.24) ----\n\n// What went wrong, or what was asked instead of a run: --help and\n// --version are CliErrors too, whose exit code is 0.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum CliErrorKind {\n    Help,\n    Version,\n    UnknownOption,\n    UnknownCommand,\n    UnexpectedArgument,\n    MissingValue,\n    FlagValue,\n    MissingRequired,\n    InvalidValue,\n    // (0.25) a program's own: CliError::custom\n    Custom,\n    // (0.25.2) no subcommand given to a Command::subcommand_required\n    MissingSubcommand,\n    // (0.25.2) two arguments given that Arg::conflicts_with keeps apart\n    ArgumentConflict,\n}\n\n// An error of parse (or Matches::get_as): Display gives its two lines,\n// `error: ...` and `try: ...`; cmd.exit(e) prints them with the usage line\n");
    buf_str(out, c"// (or the help, the version) and exits with e.exit_code().\n#[derive(Clone, Copy)]\npub struct CliError<'a> {\n    pub kind: CliErrorKind,\n    // the argument as given ('--outt', '-vx', the bad value)\n    pub text: &'a str,\n    // the command it is about (cmd.render_in prints its usage)\n    cmd: i64,\n    // an unknown short option inside a cluster (`-x` of `-vx`)\n    short: char,\n    // the argument it is about\n    arg: Arg<'a>,\n    // did you mean: a long option (`--` before it) or a command\n    hint: &'a str,\n    hint_long: bool,\n    // (0.25.2) ArgumentConflict: the other argument as given (`other_short`:\n    // a letter of a cluster)\n    other: &'a str,\n    other_short: char,\n}\n\nimpl<'a> CliError<'a> {\n    fn new(kind: CliErrorKind, cmd: i64, text: &'a str) -> CliError<'a> {\n        CliError {\n            kind: kind, text: text, cmd: cmd, short: '\\0', arg: Arg::make(\"\", FLAG), hint: \"\",\n            hint_long: false, other: \"\", other_short: '\\0',\n        }\n    }\n\n    fn of(kind: CliErrorKind, cmd: i64, text: &'a str, a: Arg<'a>) -> CliError<'a> {\n        let mut e = CliError::new(kind, cmd, text);\n        e.arg = a;\n        e\n    }\n\n    // (0.25) A program's own error, in std::cli's form: `error: MESSAGE`,\n    // `try: TRY` (none when \"\"), then the usage line (cmd.exit(e), exit\n    // code 2): `CliError::custom(\"-b and -t together\", \"-b FILE\")`.\n    #[effects()]\n    pub fn custom(message: &'a str, try_line: &'a str) -> CliError<'a> {\n        let mut e = CliError::new(CliErrorKind::Custom, 0, message);\n        e.hint = try_line;\n        e\n    }\n\n    // (0.25) The unknown letter of a cluster (`x` of `-vx`), else 0.\n    // std2: changed: a char ('\\0': none; MVS: a byte, 0)\n    #[effects()]\n    pub fn letter(self) -> char {\n        self.short\n    }\n\n    // 0 for --help and --version, else 2 (a usage error, as clap's).\n    #[effects()]\n    pub fn exit_code(self) -> i32 {\n        match self.kind {\n");
    buf_str(out, c"            CliErrorKind::Help => 0,\n            CliErrorKind::Version => 0,\n            _ => 2,\n        }\n    }\n}\n\n// How an argument is written: `--out <FILE>`, `-o <FILE>`, `--verbose`,\n// `<input>`, `<file>...`.\n#[derive(Clone, Copy)]\nstruct Spell<'a> {\n    a: Arg<'a>,\n}\n\nimpl Display for Spell<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let a = self.a;\n        if a.kind == POSITIONAL {\n            f.write_char('<')?;\n            // (0.25: its value_name, when it has one)\n            f.write_str((if a.value_name.len() as i64 > 0 { a.value_name } else { a.name }))?;\n            f.write_char('>')?;\n            if a.multiple {\n                f.write_str(\"...\")?;\n            }\n            return Ok(());\n        }\n        if a.long.len() as i64 > 0 {\n            f.write_str(\"--\")?;\n            f.write_str(a.long)?;\n        } else {\n            f.write_char('-')?;\n            f.write_char(a.short as char)?;\n        }\n        if a.kind == OPTION {\n            // (0.25.2) an optional value: `--stats[=<STATS>]`\n            f.write_str((if a.has_missing { \"[=\" } else { \" \" }))?;\n            write(f, \"{}\", (ValueName { a: a }))?;\n            if a.has_missing {\n                f.write_char(']')?;\n            }\n        }\n        Ok(())\n    }\n}\n\n// `<FILE>`: an option's value name, or its name in capitals.\n#[derive(Clone, Copy)]\nstruct ValueName<'a> {\n    a: Arg<'a>,\n}\n\nimpl Display for ValueName<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.a.num_values > 1 {\n            // (0.25.2) `<PATH> <COPY>`: value_name's words (the last\n            // repeated), else the name n times\n            let mut k: i64 = 0;\n            let mut last: &str = \"\";\n            for w in self.a.value_name.split(' ') {\n                if w.len() as i64 > 0 && k < self.a.num_values {\n                    if k > 0 {\n");
    buf_str(out, c"                        f.write_char(' ')?;\n                    }\n                    f.write_char('<')?;\n                    f.write_str(w)?;\n                    f.write_char('>')?;\n                    last = w;\n                    k += 1;\n                }\n            }\n            while k < self.a.num_values {\n                if k > 0 {\n                    f.write_char(' ')?;\n                }\n                if last.len() as i64 > 0 {\n                    f.write_char('<')?;\n                    f.write_str(last)?;\n                    f.write_char('>')?;\n                } else {\n                    let mut one = self.a;\n                    one.num_values = 1;\n                    write(f, \"{}\", (ValueName { a: one }))?;\n                }\n                k += 1;\n            }\n            return Ok(());\n        }\n        f.write_char('<')?;\n        if self.a.value_name.len() as i64 > 0 {\n            f.write_str(self.a.value_name)?;\n        } else if self.a.choices.len() as i64 > 0 {\n            f.write_str(self.a.choices)?;\n        } else {\n            for c in self.a.name.bytes() {\n                f.write_char((if c >= b'a' && c <= b'z' { c - 32 } else if c == b'-' { b'_' }\n                    else { c }) as char)?;\n            }\n        }\n        f.write_char('>')?;\n        Ok(())\n    }\n}\n\n// std2: changed: Debug, which `unwrap` needs (MVS's Result had no bound):\n// the kind and the argument as given, `CliError { kind: UnknownOption,\n// text: \"--outt\" }`.\nimpl Debug for CliError<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"CliError { kind: \")?;\n        Debug::fmt(&self.kind, f)?;\n        f.write_str(\", text: \")?;\n        Debug::fmt(self.text, f)?;\n        f.write_str(\" }\")\n    }\n}\n\nimpl Display for CliError<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let sp = Spell { a: self.arg };\n        match self.kind {\n");
    buf_str(out, c"            CliErrorKind::Help => f.write_str(\"help requested: cmd.exit(e) prints it\")?,\n            CliErrorKind::Version => f.write_str(\"version requested: cmd.exit(e) prints it\")?,\n            CliErrorKind::UnknownOption => {\n                f.write_str(\"error: unknown option '\")?;\n                if self.short != '\\0' {\n                    f.write_char('-')?;\n                    f.write_char(self.short)?;\n                    if self.text.len() as i64 > 2 {\n                        f.write_str(\"' in '\")?;\n                        f.write_str(self.text)?;\n                    }\n                } else {\n                    f.write_str(self.text)?;\n                }\n                f.write_str(\"'\\ntry: \")?;\n                if self.hint.len() as i64 > 0 {\n                    if self.hint_long {\n                        f.write_str(\"--\")?;\n                    }\n                    f.write_str(self.hint)?;\n                } else {\n                    f.write_str(\"--help\")?;\n                }\n            }\n            CliErrorKind::UnknownCommand => {\n                f.write_str(\"error: unknown command '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: \")?;\n                f.write_str((if self.hint.len() as i64 > 0 { self.hint } else { \"--help\" }))?;\n            }\n            CliErrorKind::UnexpectedArgument => {\n                f.write_str(\"error: unexpected argument '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: --help\")?;\n            }\n            CliErrorKind::MissingValue => {\n                f.write_str(\"error: option '\")?;\n                if self.short != '\\0' {\n                    f.write_char('-')?;\n                    f.write_char(self.short)?;\n                } else {\n                    f.write_str(self.text)?;\n                }\n                f.write_str(\"' needs a value\\ntry: \")?;\n");
    buf_str(out, c"                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::FlagValue => {\n                f.write_str(\"error: flag '\")?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"' takes no value\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::MissingRequired => {\n                f.write_str((if self.arg.kind == POSITIONAL { \"error: missing argument '\" }\n                    else { \"error: missing option '\" }))?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"'\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::MissingSubcommand => {\n                // (cmd.render_in names the subcommands)\n                f.write_str(\"error: missing command for '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: --help\")?;\n            }\n            CliErrorKind::ArgumentConflict => {\n                f.write_str(\"error: '\")?;\n                written(f, self.text, self.short)?;\n                f.write_str(\"' cannot be used with '\")?;\n                written(f, self.other, self.other_short)?;\n                f.write_str(\"'\\ntry: drop '\")?;\n                written(f, self.text, self.short)?;\n                f.write_str(\"' (or '\")?;\n                written(f, self.other, self.other_short)?;\n                f.write_str(\"')\")?;\n            }\n            CliErrorKind::Custom => {\n                f.write_str(\"error: \")?;\n                f.write_str(self.text)?;\n                if self.hint.len() as i64 > 0 {\n                    f.write_str(\"\\ntry: \")?;\n                    f.write_str(self.hint)?;\n                }\n            }\n            CliErrorKind::InvalidValue => {\n                f.write_str(\"error: invalid value '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"' for '\")?;\n                write(f, \"{}\", sp)?;\n");
    buf_str(out, c"                f.write_str(\"'\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n        }\n        Ok(())\n    }\n}\n\n// An argument as given: `-c` (short, a letter of a cluster), else text.\nfn written(f: &mut Formatter<'_>, text: &str, short: char) -> crate::fmt::Result {\n    if short != '\\0' {\n        f.write_char('-')?;\n        f.write_char(short)\n    } else {\n        f.write_str(text)\n    }\n}\n\n// The edit distance of a and b: insertions, deletions, substitutions and\n// swaps of two neighbours (`--nmae` is 1 from `--name`); 64 beyond 63\n// bytes.\nfn distance(a: &str, b: &str) -> i64 {\n    let a = a.as_bytes();\n    let b = b.as_bytes();\n    if a.len() as i64 > 63 || b.len() as i64 > 63 {\n        return 64;\n    }\n    let mut prev2: [i64; 64] = [0i64; 64];\n    let mut prev: [i64; 64] = [0i64; 64];\n    let mut cur: [i64; 64] = [0i64; 64];\n    for j in 0..b.len() as i64 + 1 {\n        prev[j as usize] = j;\n    }\n    for i in 1..a.len() as i64 + 1 {\n        cur[0] = i;\n        for j in 1..b.len() as i64 + 1 {\n            let mut best = prev[(j - 1) as usize] + if a[(i - 1) as usize]\n                == b[(j - 1) as usize] { 0 } else { 1 };\n            if prev[j as usize] + 1 < best {\n                best = prev[j as usize] + 1;\n            }\n            if cur[(j - 1) as usize] + 1 < best {\n                best = cur[(j - 1) as usize] + 1;\n            }\n            if i > 1 && j > 1 && a[(i - 1) as usize] == b[(j - 2) as usize]\n                && a[(i - 2) as usize] == b[(j - 1) as usize]\n                && prev2[(j - 2) as usize] + 1 < best {\n                best = prev2[(j - 2) as usize] + 1;\n            }\n            cur[j as usize] = best;\n        }\n        for j in 0..b.len() as i64 + 1 {\n            prev2[j as usize] = prev[j as usize];\n            prev[j as usize] = cur[j as usize];\n        }\n    }\n    prev[b.len() as i64 as usize]\n}\n\n");
    buf_str(out, c"// Whether a candidate at distance d from word is worth suggesting.\nfn near(d: i64, word: &str) -> bool {\n    let most: i64 = if word.len() as i64 / 3 > 1 { word.len() as i64 / 3 } else { 1 };\n    d <= most\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // The long option of c nearest to word (its own name, when an alias\n    // is the nearest), or \"\".\n    fn near_long(&self, c: i64, word: &str) -> &'a str {\n        let mut best: &'a str = \"\";\n        let mut bd: i64 = 64;\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if self.of_cmd(a, c) && a.kind != POSITIONAL && !a.hidden && a.long.len() as i64 > 0 {\n                let mut d = distance(word, a.long);\n                let da = a.aliases.nearest(word);\n                if da < d {\n                    d = da;\n                }\n                if d < bd {\n                    bd = d;\n                    best = a.long;\n                }\n            }\n        }\n        let builtin: [&str; 2] = [\"help\", \"version\"];\n        for k in 0..2 {\n            if k == 1 && self.cmds[c as usize].version.len() as i64 == 0 {\n                continue;\n            }\n            let d = distance(word, builtin[k as usize]);\n            if d < bd {\n                bd = d;\n                best = builtin[k as usize];\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The subcommand of c nearest to word (by its name or an alias): its\n    // name, or \"\".\n    fn near_sub(&self, c: i64, word: &str) -> &'a str {\n        let mut best: &'a str = \"\";\n        let mut bd: i64 = 64;\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden {\n                let mut d = distance(word, self.cmds[i as usize].name);\n                let da = self.cmds[i as usize].aliases.nearest(word);\n                if da < d {\n");
    buf_str(out, c"                    d = da;\n                }\n                if d < bd {\n                    bd = d;\n                    best = self.cmds[i as usize].name;\n                }\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The argument of c with long form (or alias) name, or -1: c's own\n    // first, then the global ones of the commands above it.\n    fn find_long(&self, c: i64, name: &str) -> i64 {\n        for i in 0..self.args.len() as i64 {\n            if self.args[i as usize].cmd == c && self.args[i as usize].long_is(name) {\n                return i;\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd != c && a.long_is(name) && self.of_cmd(a, c) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // The argument of c with short form ch, or -1 (as find_long).\n    fn find_short(&self, c: i64, ch: char) -> i64 {\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd == c && a.kind != POSITIONAL && a.short != '\\0' && a.short == ch {\n                return i;\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd != c && a.kind != POSITIONAL && a.short != '\\0' && a.short == ch\n                && self.of_cmd(a, c) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Whether tok, starting with '-', is an option of c: `--name`\n    // (`--name=v`) or `-x...` whose first letter is one (`-h`, `--help`,\n    // `-V`, `--version` too).\n    fn known(&self, c: i64, tok: &str) -> bool {\n        let b = tok.as_bytes();\n        let versioned = self.cmds[c as usize].version.len() as i64 > 0;\n        if b[1] == b'-' {\n            let body = tok.strip_prefix(\"--\").unwrap();\n            let name = match body.split_once('=') {\n");
    buf_str(out, c"                Option::Some((n, _)) => n,\n                Option::None => body,\n            };\n            return self.find_long(c, name) >= 0 || name == \"help\"\n                || (name == \"version\" && versioned);\n        }\n        self.find_short(c, b[1] as char) >= 0 || tok == \"-h\" || (tok == \"-V\" && versioned)\n    }\n\n    // Parses args (the program's name first, as env::args() gives them),\n    // the Matches on the command's allocator.\n    #[effects(CA, I)]\n    pub fn parse<I: Iterator<Item = &'a str>>(&self, args: I) -> Result<Matches<'a, CA>,\n        CliError<'a>> {\n        self.parse_in(args, self.alloc.clone())\n    }\n\n    // Parses args, the Matches on allocator a.\n    #[effects(panic, diverge, CA, I, A)]\n    pub fn parse_in<I: Iterator<Item = &'a str>, A: Allocator + Clone>(&self, args: I, a: A)\n        -> Result<Matches<'a, A>, CliError<'a>> {\n        let mut it = args;\n        let _ = it.next();\n        let mut m: Matches<'a, A> = Matches {\n            slots: Vec::new_in(a.clone()), marks: Vec::new_in(a.clone()),\n            texts: Vec::new_in(a.clone()), names: Vec::new_in(a.clone()),\n            cmds: Vec::new_in(a.clone()), indices: Vec::new_in(a), level: 0,\n        };\n        // the index of tok among the arguments (the program's name: 0)\n        let mut at: i64 = 0;\n        let mut cur: i64 = 0;\n        m.enter(self, 0i64);\n        let mut npos: i64 = 0;\n        let mut dashdash = false;\n        // the slot an option waits for values in, how many more (0.25.2:\n        // num_values), and how it was written\n        let mut pending: i64 = -1;\n        let mut pending_left: i64 = 0;\n        let mut pending_text: &'a str = \"\";\n        let mut pending_short: char = '\\0';\n        // a required argument missing: reported at the end, so that a\n        // later --help still prints the help\n        let mut late = CliError::new(CliErrorKind::Help, 0, \"\");\n        let mut has_late = false;\n        loop {\n");
    buf_str(out, c"            let tok = match it.next() {\n                Option::Some(t) => t,\n                Option::None => break,\n            };\n            at += 1;\n            if pending >= 0 {\n                m.push(pending, tok, at);\n                pending_left -= 1;\n                if pending_left == 0 {\n                    pending = -1;\n                }\n                continue;\n            }\n            let b = tok.as_bytes();\n            let mut word = dashdash || b.len() as i64 < 2 || b[0] != b'-';\n            if !word && tok != \"--\" {\n                // (0.25.2) a positional that takes values starting with '-'\n                let s = m.positional(npos);\n                word = s >= 0 && m.slots[s as usize].arg.hyphen && !self.known(cur, tok);\n            }\n            if word {\n                // a positional, or a subcommand's name\n                if !dashdash {\n                    let sub = self.sub_named(cur, tok);\n                    if sub >= 0 {\n                        match m.finish(cur) {\n                            Err(e) => if !has_late {\n                                late = e;\n                                has_late = true;\n                            },\n                            Ok(_) => {}\n                        }\n                        cur = sub;\n                        m.enter(self, sub);\n                        npos = 0;\n                        continue;\n                    }\n                }\n                let mut s = m.positional(npos);\n                if dashdash {\n                    // (0.25.2) the words after `--` go to a `last` positional\n                    let l = m.last_positional();\n                    if l >= 0 {\n                        s = if m.slots[l as usize].arg.multiple\n                            || m.slots[l as usize].count == 0 { l } else { -1 };\n                    }\n                }\n                if s >= 0 {\n                    m.given(s, tok, '\\0', at);\n");
    buf_str(out, c"                    m.push(s, tok, at);\n                    if !m.slots[s as usize].arg.multiple {\n                        npos += 1;\n                    }\n                    continue;\n                }\n                if self.has_subs(cur) {\n                    let mut e = CliError::new(CliErrorKind::UnknownCommand, cur, tok);\n                    e.hint = self.near_sub(cur, tok);\n                    return Err(e);\n                }\n                return Err(CliError::new(CliErrorKind::UnexpectedArgument, cur, tok));\n            }\n            if tok == \"--\" {\n                dashdash = true;\n                continue;\n            }\n            if b[1] == b'-' {\n                // --name, --name=value\n                let body = tok.strip_prefix(\"--\").unwrap();\n                let mut name = body;\n                let mut value: &str = \"\";\n                let mut has_value = false;\n                match body.split_once('=') {\n                    Option::Some((n, v)) => {\n                        name = n;\n                        value = v;\n                        has_value = true;\n                    }\n                    Option::None => {}\n                }\n                let shown = if has_value { tok.split_once('=').unwrap().0 } else { tok };\n                let i = self.find_long(cur, name);\n                if i < 0 {\n                    if name == \"help\" {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if name == \"version\" && self.cmds[cur as usize].version.len() as i64 > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, shown);\n                    e.hint = self.near_long(cur, name);\n                    e.hint_long = true;\n                    return Err(e);\n                }\n");
    buf_str(out, c"                let s = m.slot_of(i);\n                let x = self.args[i as usize];\n                m.given(s, shown, '\\0', at);\n                if x.kind == FLAG {\n                    if has_value {\n                        return Err(CliError::of(CliErrorKind::FlagValue, cur, tok, x));\n                    }\n                    m.flag_at(s, at);\n                } else if has_value {\n                    m.push(s, value, at);\n                    if x.num_values > 1 {\n                        pending = s;\n                        pending_left = x.num_values - 1;\n                        pending_text = shown;\n                        pending_short = '\\0';\n                    }\n                } else if x.has_missing {\n                    m.push(s, x.missing, at);\n                } else {\n                    pending = s;\n                    pending_left = x.num_values;\n                    pending_text = tok;\n                    pending_short = '\\0';\n                }\n                continue;\n            }\n            // -abc: short flags, the last may be an option (-ofile, -o file)\n            let mut j: i64 = 1;\n            while j < b.len() as i64 {\n                let ch = b[j as usize] as char;\n                let i = self.find_short(cur, ch);\n                if i < 0 {\n                    if ch == 'h' {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if ch == 'V' && self.cmds[cur as usize].version.len() as i64 > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, tok);\n                    e.short = ch;\n                    // `-verbose` for `--verbose`\n                    if b.len() as i64 > 2 {\n                        let word = tok.strip_prefix(\"-\").unwrap();\n");
    buf_str(out, c"                        if self.find_long(cur, word) >= 0 {\n                            e.hint = self.args[self.find_long(cur, word) as usize].long;\n                        } else {\n                            e.hint = self.near_long(cur, word);\n                        }\n                        e.hint_long = e.hint.len() as i64 > 0;\n                    }\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                let x = self.args[i as usize];\n                m.given(s, tok, ch, at);\n                if x.kind == FLAG {\n                    m.flag_at(s, at);\n                    j += 1;\n                    continue;\n                }\n                // (after an ASCII byte: UTF-8)\n                let mut rest = crate::str::from_utf8(&b[(j + 1) as usize..]).unwrap_or(\"\");\n                let mut eq = false;\n                match rest.strip_prefix(\"=\") {\n                    Option::Some(r) => {\n                        rest = r;\n                        eq = true;\n                    }\n                    Option::None => {}\n                }\n                if x.has_missing && !eq {\n                    // (0.25.2) an optional value: only `-s=x` gives one\n                    m.push(s, x.missing, at);\n                    j += 1;\n                    continue;\n                }\n                if rest.len() as i64 > 0 || eq {\n                    m.push(s, rest, at);\n                    if x.num_values > 1 {\n                        pending = s;\n                        pending_left = x.num_values - 1;\n                        pending_text = tok;\n                        pending_short = ch;\n                    }\n                } else {\n                    pending = s;\n                    pending_left = x.num_values;\n                    pending_text = tok;\n                    pending_short = ch;\n                }\n                break;\n            }\n        }\n");
    buf_str(out, c"        if pending >= 0 {\n            let mut e = CliError::of(CliErrorKind::MissingValue, cur, pending_text,\n                m.slots[pending as usize].arg);\n            e.short = pending_short;\n            return Err(e);\n        }\n        if has_late {\n            return Err(late);\n        }\n        if self.cmds[cur as usize].sub_required {\n            return Err(CliError::new(CliErrorKind::MissingSubcommand, cur,\n                self.cmds[cur as usize].name));\n        }\n        m.finish(cur)?;\n        m.finish_globals(cur)?;\n        m.conflicts()?;\n        m.group();\n        // (0.25) the values of arguments with choices\n        for s in 0..m.slots.len() as i64 {\n            let sl = m.slots[s as usize];\n            for k in sl.start..sl.start + sl.len {\n                if !chosen(m.texts[k as usize], sl.arg.choices) {\n                    return Err(CliError::of(CliErrorKind::InvalidValue, self.cmds_of(sl.level, &m),\n                        m.texts[k as usize], sl.arg));\n                }\n            }\n        }\n        Ok(m)\n    }\n}\n\n// ---- Matches (0.24) ----\n\n// An argument of a matched command: how many times it was given, and\n// (after parse) where its values are in Matches.texts.\n#[derive(Clone, Copy)]\nstruct Slot<'a> {\n    level: i64,\n    index: i64,\n    arg: Arg<'a>,\n    count: i64,\n    start: i64,\n    len: i64,\n    // (0.25) where its occurrences are in Matches.marks, after parse\n    pstart: i64,\n    plen: i64,\n    // (0.25.2) how it was last given (`--text`, or the letter of `-bt`) and\n    // where: for an ArgumentConflict\n    wtext: &'a str,\n    wshort: char,\n    wat: i64,\n}\n\n// A global argument, of its command and the subcommands below.\nfn is_global(a: Arg<'_>) -> bool {\n    a.global && a.kind != POSITIONAL\n}\n\n// What parse found: for the command and each subcommand on the line (a\n// level each), every argument's count and values. `m.subcommand()` gives\n// the next level's Matches.\n");
    buf_str(out, c"pub struct Matches<'a, A: Allocator> {\n    slots: Vec<Slot<'a>, A>,\n    // (0.25) while parsing, a pair for each value or flag given: its slot\n    // (-1 - slot: a flag, no value) and its index among the arguments (-1:\n    // a default); after, those indices by slot (Slot.pstart)\n    marks: Vec<i64, A>,\n    // the values (after parse: by slot, Slot.start)\n    texts: Vec<&'a str, A>,\n    // each level's command: its name and index\n    names: Vec<&'a str, A>,\n    cmds: Vec<i64, A>,\n    // (after parse) each slot's indices among the arguments (Slot.pstart)\n    indices: Vec<i64, A>,\n    level: i64,\n}\n\nimpl<'a, A: Allocator + Clone> Matches<'a, A> {\n    // A new level for command c: a slot for each of its arguments.\n    fn enter<CA: Allocator + Clone>(&mut self, cmd: &Command<'a, CA>, c: i64) {\n        self.level = self.names.len() as i64;\n        self.names.push(cmd.cmds[c as usize].name);\n        self.cmds.push(c);\n        for i in 0..cmd.args.len() as i64 {\n            if cmd.args[i as usize].cmd == c {\n                self.slots.push(Slot {\n                    level: self.level, index: i, arg: cmd.args[i as usize], count: 0, start: 0,\n                    len: 0,\n                    pstart: 0, plen: 0, wtext: \"\", wshort: '\\0', wat: 0,\n                });\n            }\n        }\n    }\n\n    // The slot of argument i (on its command's level: a global argument's\n    // is above the last).\n    fn slot_of(&self, i: i64) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            if self.slots[s as usize].index == i {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // The slot of the k-th positional of the last level (not counting a\n    // `last` one), or -1.\n    fn positional(&self, k: i64) -> i64 {\n        let mut n: i64 = 0;\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n");
    buf_str(out, c"            if sl.level == self.level && sl.arg.kind == POSITIONAL && !sl.arg.last {\n                if n == k {\n                    return s;\n                }\n                n += 1;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) The slot of the last level's `last` positional, or -1.\n    fn last_positional(&self) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level == self.level && sl.arg.kind == POSITIONAL && sl.arg.last {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Slot s given as text (short: the letter of a cluster) at\n    // argument index at.\n    fn given(&mut self, s: i64, text: &'a str, short: char, at: i64) {\n        self.slots[s as usize].wtext = text;\n        self.slots[s as usize].wshort = short;\n        self.slots[s as usize].wat = at;\n    }\n\n    // A value of slot s, at argument index at.\n    fn push(&mut self, s: i64, text: &'a str, at: i64) {\n        self.slots[s as usize].count += 1;\n        self.marks.push(s);\n        self.marks.push(at);\n        self.texts.push(text);\n    }\n\n    // A flag of slot s given, at argument index at.\n    fn flag_at(&mut self, s: i64, at: i64) {\n        self.slots[s as usize].count += 1;\n        self.marks.push(-1 - s);\n        self.marks.push(at);\n    }\n\n    // Slot s not given: its default, or an error when it is required.\n    fn absent(&mut self, s: i64, c: i64) -> Result<(), CliError<'a>> {\n        let sl = self.slots[s as usize];\n        if sl.arg.has_default {\n            self.marks.push(s);\n            self.marks.push(-1);\n            self.texts.push(sl.arg.default);\n        } else if sl.arg.required {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        Ok(())\n    }\n\n    // The end of command c's arguments: the defaults, the required ones\n");
    buf_str(out, c"    // (a global argument's at the end, finish_globals).\n    fn finish(&mut self, c: i64) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level != self.level || sl.count > 0 || is_global(sl.arg) {\n                continue;\n            }\n            self.absent(s, c)?;\n        }\n        Ok(())\n    }\n\n    // (0.25.2) The global arguments not given, on any level (an error is\n    // about c, the last command).\n    fn finish_globals(&mut self, c: i64) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.count == 0 && is_global(sl.arg) {\n                self.absent(s, c)?;\n            }\n        }\n        Ok(())\n    }\n\n    // (0.25.2) Two arguments given that conflicts_with keeps apart: an\n    // error naming both as given, the later first.\n    fn conflicts(&self) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.count == 0 {\n                continue;\n            }\n            for k in 0..sl.arg.conflicts.n {\n                for name in sl.arg.conflicts.name_at(k).split('|') {\n                    let o = self.find_at(sl.level, name);\n                    if o < 0 {\n                        crate::panic::panic(\n                            \"std::cli: conflicts_with: no argument by that name in this command\");\n                    }\n                    if self.slots[o as usize].count == 0 || o == s {\n                        continue;\n                    }\n                    let mut p = s;\n                    let mut q = o;\n                    if self.slots[o as usize].wat > sl.wat {\n                        p = o;\n                        q = s;\n                    }\n                    let mut e = CliError::of(CliErrorKind::ArgumentConflict,\n");
    buf_str(out, c"                        self.cmds[sl.level as usize], self.slots[p as usize].wtext,\n                        self.slots[p as usize].arg);\n                    e.short = self.slots[p as usize].wshort;\n                    e.other = self.slots[q as usize].wtext;\n                    e.other_short = self.slots[q as usize].wshort;\n                    return Err(e);\n                }\n            }\n        }\n        Ok(())\n    }\n\n    // Each slot's values together, in the order given, and their indices\n    // among the arguments; the first level current.\n    fn group(&mut self) {\n        let n = self.marks.len() as i64 / 2;\n        let mut out: Vec<&'a str, A> = Vec::with_capacity_in(self.texts.len(),\n            self.texts.allocator().clone());\n        for s in 0..self.slots.len() as i64 {\n            self.slots[s as usize].start = out.len() as i64;\n            let mut t: i64 = 0;\n            for k in 0..n {\n                let o = self.marks[(2 * k) as usize];\n                if o >= 0 {\n                    if o == s {\n                        out.push(self.texts[t as usize]);\n                    }\n                    t += 1;\n                }\n            }\n            self.slots[s as usize].len = out.len() as i64 - self.slots[s as usize].start;\n        }\n        self.texts = out;\n        // the indices by slot\n        for s in 0..self.slots.len() as i64 {\n            self.slots[s as usize].pstart = self.indices.len() as i64;\n            for k in 0..n {\n                let o = self.marks[(2 * k) as usize];\n                let at = self.marks[(2 * k + 1) as usize];\n                if at >= 0 && (o == s || o == -1 - s) {\n                    self.indices.push(at);\n                }\n            }\n            self.slots[s as usize].plen = self.indices.len() as i64 - self.slots[s as usize].pstart;\n        }\n        self.level = 0;\n    }\n\n    // The slot of the argument named name on level level (or a global one\n");
    buf_str(out, c"    // of a level above), or -1.\n    fn find_at(&self, level: i64, name: &str) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            if self.slots[s as usize].level == level && self.slots[s as usize].arg.name == name {\n                return s;\n            }\n        }\n        let mut l = level - 1;\n        while l >= 0 {\n            for s in 0..self.slots.len() as i64 {\n                let sl = self.slots[s as usize];\n                if sl.level == l && is_global(sl.arg) && sl.arg.name == name {\n                    return s;\n                }\n            }\n            l -= 1;\n        }\n        -1\n    }\n\n    // The slot of the argument named name on this level (or a global one\n    // of a command above, 0.25.2).\n    fn find(&self, name: &str) -> i64 {\n        let s = self.find_at(self.level, name);\n        if s >= 0 {\n            return s;\n        }\n        crate::panic::panic(\"std::cli: Matches: no argument by that name in this command (an Arg's name, not its long or short form)\");\n    }\n\n    // (0.25.3) Whether the argument named name is a flag (no value: get,\n    // get_as and values refuse it, cli.kind); an unknown name is not\n    // (find reports it).\n    fn is_flag(&self, name: &str) -> bool {\n        let s = self.find_at(self.level, name);\n        s >= 0 && self.slots[s as usize].arg.kind == FLAG\n    }\n\n    // Whether the argument was given (a default does not count).\n    #[effects(panic, A)]\n    pub fn flag(&self, name: &str) -> bool {\n        self.slots[self.find(name) as usize].count > 0\n    }\n\n    // How many times it was given: `-vvv` is 3.\n    // std2: changed: a usize (MVS: i64)\n    #[effects(panic, A)]\n    pub fn count(&self, name: &str) -> usize {\n        self.slots[self.find(name) as usize].count as usize\n    }\n\n    // Its value (the last one given), else its default.\n    #[effects(panic, A)]\n    pub fn get(&self, name: &str) -> Option<&'a str>\n        requires !self.is_flag(name)\n");
    buf_str(out, c"        else \"cli.kind: m.get(NAME) of a flag, which has no value (it would always be None): read a flag with m.flag(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        if sl.len == 0 {\n            return Option::None;\n        }\n        Option::Some(self.texts[(sl.start + sl.len - 1) as usize])\n    }\n\n    // Every value given, in order (or its default).\n    #[effects(panic, A)]\n    pub fn values(&self, name: &str) -> &[&'a str]\n        requires !self.is_flag(name)\n        else \"cli.kind: m.values(NAME) of a flag, which has no value (it would always be empty): read a flag with m.flag(NAME), m.count(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        &self.texts.as_slice()[sl.start as usize..(sl.start + sl.len) as usize]\n    }\n\n    // (0.25) Where it was given: the index among the arguments (the\n    // program's name is 0) of each value, in order, or of each time a flag\n    // was given; a default has none. Clap's `indices_of`: the order of\n    // different arguments' values (`-l m x.o -l z`), which `values` does\n    // not keep. (0.27.5) i64s, as MVS's: a program compares them with\n    // its own word indices, and a translation row cannot convert a\n    // slice's elements.\n    #[effects(panic, A)]\n    pub fn indices_of(&self, name: &str) -> &[i64] {\n        let sl = self.slots[self.find(name) as usize];\n        &self.indices.as_slice()[sl.pstart as usize..(sl.pstart + sl.plen) as usize]\n    }\n\n    // Its value parsed as a T (`m.get_as::<i64>(\"n\")`): an InvalidValue\n    // error naming the argument when it does not parse, MissingRequired\n    // when it has no value (give it a default, or make it required).\n    #[effects(panic, A, T)]\n    pub fn get_as<T: FromStr>(&self, name: &str) -> Result<T, CliError<'a>>\n        requires !self.is_flag(name)\n        else \"cli.kind: m.get_as(NAME) of a flag, which has no value: read a flag with m.flag(NAME)\"\n        {\n");
    buf_str(out, c"        let sl = self.slots[self.find(name) as usize];\n        let c = self.cmds[self.level as usize];\n        if sl.len == 0 {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        let text = self.texts[(sl.start + sl.len - 1) as usize];\n        match T::from_str(text) {\n            Ok(v) => Ok(v),\n            Err(_) => Err(CliError::of(CliErrorKind::InvalidValue, c, text, sl.arg)),\n        }\n    }\n\n    // The subcommand given, its name, or None.\n    #[effects(panic, A)]\n    pub fn subcommand_name(&self) -> Option<&'a str> {\n        if self.level + 1 < self.names.len() as i64 {\n            return Option::Some(self.names[(self.level + 1) as usize]);\n        }\n        Option::None\n    }\n\n    // The subcommand given: its name and its Matches (a copy), or None.\n    #[effects(panic, A)]\n    pub fn subcommand(&self) -> Option<(&'a str, Matches<'a, A>)> {\n        if self.level + 1 >= self.names.len() as i64 {\n            return Option::None;\n        }\n        let sub = Matches {\n            slots: self.slots.clone(), marks: self.marks.clone(), texts: self.texts.clone(),\n            names: self.names.clone(), cmds: self.cmds.clone(), indices: self.indices.clone(),\n            level: self.level + 1,\n        };\n        Option::Some((self.names[(self.level + 1) as usize], sub))\n    }\n}\n\n// ---- Help and errors (0.24) ----\n\n// Writes text from column col (already there) to width, breaking at\n// spaces; later lines start at column indent.\nfn wrap<A: Allocator>(out: &mut String<A>, text: &str, col: i64, indent: i64, width: i64) {\n    let mut at = col;\n    let mut first = true;\n    for w in text.split(' ') {\n        if w.len() as i64 == 0 {\n            continue;\n        }\n        if !first {\n            if at + 1 + w.len() as i64 > width && at > indent {\n                out.push('\\n');\n                for _ in 0..indent {\n                    out.push(' ');\n                }\n");
    buf_str(out, c"                at = indent;\n            } else {\n                out.push(' ');\n                at += 1;\n            }\n        }\n        out.push_str(w);\n        at += w.len() as i64;\n        first = false;\n    }\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // `git remote add`: the names from the root to c.\n    fn path_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        let p = self.cmds[c as usize].parent;\n        if p >= 0 {\n            self.path_into(p, out);\n            out.push(' ');\n        }\n        out.push_str(self.cmds[c as usize].name);\n    }\n\n    // `usage: prog [options] --out <FILE> <input> [file]... [command]`\n    fn usage_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        out.push_str(\"usage: \");\n        self.path_into(c, out);\n        out.push_str(\" [options]\");\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if self.of_cmd(a, c) && a.kind == OPTION && a.required && !a.hidden {\n                out.push(' ');\n                write(out, \"{}\", Spell { a: a }).unwrap();\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd == c && a.kind == POSITIONAL && !a.hidden {\n                out.push(' ');\n                if a.last {\n                    // (0.25.2) `[-- args]...`, `-- <args>...`\n                    if !a.required {\n                        out.push('[');\n                    }\n                    out.push_str(\"-- \");\n                    if a.required {\n                        write(out, \"{}\", Spell { a: a }).unwrap();\n                    } else {\n                        out.push_str(if a.value_name.len() as i64 > 0 { a.value_name }\n                            else { a.name });\n                        out.push(']');\n                        if a.multiple {\n                            out.push_str(\"...\");\n");
    buf_str(out, c"                        }\n                    }\n                } else if a.required {\n                    write(out, \"{}\", Spell { a: a }).unwrap();\n                } else {\n                    out.push('[');\n                    out.push_str(if a.value_name.len() as i64 > 0 { a.value_name } else { a.name });\n                    out.push(']');\n                    if a.multiple {\n                        out.push_str(\"...\");\n                    }\n                }\n            }\n        }\n        if self.has_subs(c) {\n            out.push_str(if self.cmds[c as usize].sub_required { \" <command>\" }\n                else { \" [command]\" });\n        }\n    }\n\n    // (0.25.2) A visible subcommand of c.\n    fn shown_sub(&self, i: i64, c: i64) -> bool {\n        self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden\n    }\n\n    fn has_shown_subs(&self, c: i64) -> bool {\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // (0.25.2) A MissingSubcommand's try: line, `prog remote <add|rm>`\n    // (one: `prog remote add`; many: `prog remote --help`).\n    fn try_sub_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        self.path_into(c, out);\n        out.push(' ');\n        let mut n: i64 = 0;\n        let mut len: i64 = 0;\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                n += 1;\n                len += self.cmds[i as usize].name.len() as i64 + 1;\n            }\n        }\n        if n == 0 || len > 48 {\n            out.push_str(\"--help\");\n            return;\n        }\n        if n > 1 {\n            out.push('<');\n        }\n        let mut first = true;\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                if !first {\n                    out.push('|');\n                }\n");
    buf_str(out, c"                out.push_str(self.cmds[i as usize].name);\n                first = false;\n            }\n        }\n        if n > 1 {\n            out.push('>');\n        }\n    }\n\n    // An argument's left column: `-o, --out <FILE>`, `    --tag`, `<input>`.\n    fn left_into<A: Allocator>(&self, a: Arg<'a>, out: &mut String<A>) {\n        if a.kind == POSITIONAL {\n            write(out, \"{}\", Spell { a: a }).unwrap();\n            return;\n        }\n        if a.short != '\\0' {\n            out.push('-');\n            out.push(a.short);\n            if a.long.len() as i64 > 0 {\n                out.push_str(\", \");\n            }\n        } else {\n            out.push_str(\"    \");\n        }\n        if a.long.len() as i64 > 0 {\n            out.push_str(\"--\");\n            out.push_str(a.long);\n        }\n        if a.kind == OPTION {\n            out.push_str(if a.has_missing { \"[=\" } else { \" \" });\n            write(out, \"{}\", ValueName { a: a }).unwrap();\n            if a.has_missing {\n                out.push(']');\n            }\n        }\n    }\n\n    // The rest of a table's line begun at out[start..] (its left column\n    // written): its help at column col.\n    fn row_end<A: Allocator>(&self, out: &mut String<A>, start: i64, help: &str, default: &str,\n        has_default: bool, col: i64) {\n        let mut at = out.len() as i64 - start;\n        if help.len() as i64 > 0 || has_default {\n            if at + 2 > col {\n                out.push('\\n');\n                at = 0;\n            }\n            while at < col {\n                out.push(' ');\n                at += 1;\n            }\n            wrap(out, help, col, col, self.width);\n            if has_default {\n                if help.len() as i64 > 0 {\n                    out.push(' ');\n                }\n                out.push_str(\"[default: \");\n                out.push_str(default);\n                out.push(']');\n            }\n        }\n");
    buf_str(out, c"        out.push('\\n');\n    }\n\n    // A table's line: name, then its help at column col.\n    fn row<A: Allocator>(&self, out: &mut String<A>, name: &str, help: &str, col: i64) {\n        let start = out.len() as i64;\n        out.push_str(\"  \");\n        out.push_str(name);\n        self.row_end(out, start, help, \"\", false, col);\n    }\n\n    // An argument's line of a table.\n    fn arg_row<A: Allocator>(&self, out: &mut String<A>, x: Arg<'a>, col: i64) {\n        let start = out.len() as i64;\n        out.push_str(\"  \");\n        self.left_into(x, out);\n        self.row_end(out, start, x.help, x.default, x.has_default, col);\n    }\n\n    // The help of command c.\n    fn help_into<A: Allocator + Clone>(&self, c: i64, out: &mut String<A>, a: A) {\n        let cmd = self.cmds[c as usize];\n        self.path_into(c, out);\n        if cmd.version.len() as i64 > 0 {\n            out.push(' ');\n            out.push_str(cmd.version);\n        }\n        out.push('\\n');\n        if cmd.about.len() as i64 > 0 {\n            wrap(out, cmd.about, 0i64, 0i64, self.width);\n            out.push('\\n');\n        }\n        out.push('\\n');\n        self.usage_into(c, out);\n        out.push('\\n');\n        // the left column's width: the widest entry, at most 24\n        let mut left = String::new_in(a);\n        let mut widest: i64 = 13;\n        for i in 0..self.args.len() as i64 {\n            if self.of_cmd(self.args[i as usize], c) && !self.args[i as usize].hidden {\n                left.clear();\n                self.left_into(self.args[i as usize], &mut left);\n                if left.len() as i64 > widest && left.len() as i64 <= 24 {\n                    widest = left.len() as i64;\n                }\n            }\n        }\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) && self.cmds[i as usize].name.len() as i64 > widest\n                && self.cmds[i as usize].name.len() as i64 <= 24 {\n");
    buf_str(out, c"                widest = self.cmds[i as usize].name.len() as i64;\n            }\n        }\n        let col = 2 + widest + 2;\n        let mut any = false;\n        for i in 0..self.args.len() as i64 {\n            let x = self.args[i as usize];\n            if x.cmd == c && x.kind == POSITIONAL && !x.hidden {\n                if !any {\n                    out.push_str(\"\\narguments:\\n\");\n                    any = true;\n                }\n                self.arg_row(out, x, col);\n            }\n        }\n        out.push_str(\"\\noptions:\\n\");\n        let mut own_help = false;\n        let mut own_version = false;\n        for i in 0..self.args.len() as i64 {\n            let x = self.args[i as usize];\n            if self.of_cmd(x, c) && x.kind != POSITIONAL && !x.hidden {\n                self.arg_row(out, x, col);\n                if x.long == \"help\" || x.short == 'h' {\n                    own_help = true;\n                }\n                if x.long == \"version\" || x.short == 'V' {\n                    own_version = true;\n                }\n            }\n        }\n        if !own_help {\n            self.row(out, \"-h, --help\", \"print this help\", col);\n        }\n        if !own_version && cmd.version.len() as i64 > 0 {\n            self.row(out, \"-V, --version\", \"print the version\", col);\n        }\n        if self.has_shown_subs(c) {\n            out.push_str(\"\\ncommands:\\n\");\n            for i in 1..self.cmds.len() as i64 {\n                if self.shown_sub(i, c) {\n                    self.row(out, self.cmds[i as usize].name, self.cmds[i as usize].about, col);\n                }\n            }\n        }\n    }\n\n    // The help, on allocator a.\n    #[effects(CA, A)]\n    pub fn help_in<A: Allocator + Clone>(&self, a: A) -> String<A> {\n        let mut out = String::new_in(a.clone());\n        self.help_into(0i64, &mut out, a);\n        out\n    }\n\n");
    buf_str(out, c"    // What cmd.exit(e) prints, on allocator a: the help or the version\n    // line, or e's two lines and the usage line.\n    #[effects(io, panic, diverge, CA, A)]\n    pub fn render_in<A: Allocator + Clone>(&self, e: CliError<'a>, a: A) -> String<A> {\n        let mut out = String::new_in(a.clone());\n        match e.kind {\n            CliErrorKind::Help => self.help_into(e.cmd, &mut out, a),\n            CliErrorKind::Version => {\n                self.path_into(e.cmd, &mut out);\n                out.push(' ');\n                out.push_str(self.cmds[e.cmd as usize].version);\n                out.push('\\n');\n            }\n            CliErrorKind::MissingSubcommand => {\n                out.push_str(\"error: missing command for '\");\n                self.path_into(e.cmd, &mut out);\n                out.push_str(\"'\\ntry: \");\n                self.try_sub_into(e.cmd, &mut out);\n                out.push('\\n');\n                self.usage_into(e.cmd, &mut out);\n                out.push('\\n');\n            }\n            _ => {\n                write(&mut out, \"{}\", e).unwrap();\n                out.push('\\n');\n                self.usage_into(e.cmd, &mut out);\n                out.push('\\n');\n            }\n        }\n        out\n    }\n\n    // Prints what e asks (the help and the version to stdout, an error\n    // to stderr) and ends the program with e.exit_code().\n    #[effects(io, panic, diverge, CA)]\n    pub fn exit(&self, e: CliError<'a>) -> ! {\n        let code = e.exit_code();\n        let text = self.render_in(e, self.alloc.clone());\n        if code == 0 {\n            crate::fmt::print(text.as_str());\n        } else {\n            crate::fmt::eprint(text.as_str());\n        }\n        crate::process::exit(code)\n    }\n\n    // parse, and on an error (or --help, --version) cmd.exit(e).\n    #[effects(CA, I)]\n    pub fn parse_or_exit<I: Iterator<Item = &'a str>>(&self, args: I) -> Matches<'a, CA> {\n        match self.parse(args) {\n");
    buf_str(out, c"            Ok(m) => m,\n            Err(e) => self.exit(e),\n        }\n    }\n}\n// ---- end mod std::cli ----\n}\n// ---- mod std::process ----\npub mod process {\n// EDITION: rust\n// std::process: running programs, Rust's, through posix_spawnp. A\n// Command keeps its program, its arguments and the variables env_remove\n// names as NUL-ended copies in Vecs on the allocator it was made with\n// (`Command::new_in(p, a)`, Rust's Command::new); argv and envp are built\n// on a clone of it when it runs. `output()`'s bytes go in Vecs on clones\n// of it too.\n// mvs: std::process\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::io::{Error, Read, Result, Write};\nuse crate::iter::{IntoIterator, Iterator};\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::vec::Vec;\n\n// UNSAFE: posix_spawn and the C library's process, pipe and signal calls,\n// which take raw pointers.\n// SAFETY: POSIX's prototypes (spawn.h, sys/wait.h, signal.h, unistd.h,\n// fcntl.h, poll.h; fcntl and open variadic, as declared); the file\n// actions, the attributes and the signal set live in words larger than\n// either system's types (SpawnActions, SpawnAttr below).\nextern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    fn pr_c_spawnp(pid: *mut i32, file: *const u8, actions: *const u64, attr: *const u64,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n    fn pr_c_actions_init(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    fn pr_c_actions_destroy(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    fn pr_c_actions_adddup2(a: *mut u64, fd: i32, to: i32) -> i32;\n    #[link_name = \"posix_spawnattr_init\"]\n    fn pr_c_attr_init(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawnattr_destroy\"]\n    fn pr_c_attr_destroy(a: *mut u64) -> i32;\n");
    buf_str(out, c"    #[link_name = \"posix_spawnattr_setflags\"]\n    fn pr_c_attr_setflags(a: *mut u64, flags: i16) -> i32;\n    #[link_name = \"posix_spawnattr_setsigdefault\"]\n    fn pr_c_attr_setsigdefault(a: *mut u64, set: *const u64) -> i32;\n    #[link_name = \"sigemptyset\"]\n    fn pr_c_sigemptyset(set: *mut u64) -> i32;\n    #[link_name = \"sigaddset\"]\n    fn pr_c_sigaddset(set: *mut u64, sig: i32) -> i32;\n    #[link_name = \"signal\"]\n    fn pr_c_signal(sig: i32, handler: usize) -> usize;\n    #[link_name = \"waitpid\"]\n    fn pr_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"kill\"]\n    fn pr_c_kill(pid: i32, sig: i32) -> i32;\n    #[link_name = \"getpid\"]\n    fn pr_c_getpid() -> i32;\n    #[link_name = \"pipe\"]\n    fn pr_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    fn pr_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"open\"]\n    fn pr_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn pr_c_close(fd: i32) -> i32;\n    #[link_name = \"poll\"]\n    fn pr_c_poll(fds: *mut PollFd, n: u32, timeout: i32) -> i32;\n    #[link_name = \"exit\"]\n    fn pr_c_exit(code: i32) -> !;\n    #[link_name = \"abort\"]\n    fn pr_c_abort() -> !;\n}\n\nconst SIGINT: i32 = 2;\nconst SIGQUIT: i32 = 3;\nconst SIGKILL: i32 = 9;\nconst SIG_IGN: usize = 1;\nconst SIG_ERR: usize = usize::MAX;\nconst WNOHANG: i32 = 1;\nconst EINTR: i32 = 4;\nconst F_SETFD: i32 = 2;\nconst FD_CLOEXEC: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst POLLIN: i16 = 1;\n// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SPAWN_SETSIGDEF: i16 = 4;\n\n// struct pollfd, the same on both systems.\n#[repr(C)]\nstruct PollFd {\n    fd: i32,\n    events: i16,\n    revents: i16,\n}\n\n// Closes fd, when it is one (-1: none).\nfn close_fd(fd: i32) {\n    if fd >= 0 {\n        // UNSAFE: C's close. SAFETY: an int; each caller closes its own\n        // descriptor once.\n        let _ = unsafe { pr_c_close(fd) };\n");
    buf_str(out, c"    }\n}\n\n// A pipe, (read end, write end), both close-on-exec.\nfn pipe() -> Result<(i32, i32)> {\n    let mut fds = [0i32; 2];\n    // UNSAFE: C's pipe and fcntl. SAFETY: fds is a local [i32; 2], which\n    // pipe fills; F_SETFD takes an int.\n    unsafe {\n        if pr_c_pipe(&mut fds[0] as *mut i32) != 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        pr_c_fcntl(fds[0], F_SETFD, FD_CLOEXEC);\n        pr_c_fcntl(fds[1], F_SETFD, FD_CLOEXEC);\n    }\n    crate::result::Result::Ok((fds[0], fds[1]))\n}\n\n// ---- Stdio ----\n\n// What a child's stdin, stdout or stderr is: this process's (inherit),\n// /dev/null (null), or a pipe to this process (piped).\npub struct Stdio {\n    kind: u8,\n}\n\nconst INHERIT: u8 = 0;\nconst NULL: u8 = 1;\nconst PIPED: u8 = 2;\n// (not set: spawn and status inherit, output pipes stdout and stderr and\n// gives stdin /dev/null, as Rust's)\nconst DEFAULT: u8 = 3;\n\nimpl Stdio {\n    #[effects()]\n    pub fn inherit() -> Stdio {\n        Stdio { kind: INHERIT }\n    }\n\n    #[effects()]\n    pub fn null() -> Stdio {\n        Stdio { kind: NULL }\n    }\n\n    #[effects()]\n    pub fn piped() -> Stdio {\n        Stdio { kind: PIPED }\n    }\n}\n\n// ---- ExitStatus ----\n\n// How a child ended: its exit code, or the signal that ended it (the\n// status waitpid gives).\n#[derive(Clone, Copy, PartialEq, Eq)]\npub struct ExitStatus {\n    status: i32,\n}\n\nimpl ExitStatus {\n    // Whether it exited with 0.\n    #[effects()]\n    pub fn success(&self) -> bool {\n        self.status & 0xffff == 0\n    }\n\n    // Its exit code; None when a signal ended it.\n    #[effects()]\n    pub fn code(&self) -> Option<i32> {\n        if self.status & 0x7f == 0 { Option::Some((self.status >> 8) & 0xff) } else { Option::None }\n    }\n\n    // The signal that ended it.\n    // std2: changed: ExitStatus' own (Rust's: std::os::unix::process::\n    // ExitStatusExt)\n    #[effects()]\n");
    buf_str(out, c"    pub fn signal(&self) -> Option<i32> {\n        let s = self.status & 0x7f;\n        if s != 0 && s != 0x7f { Option::Some(s) } else { Option::None }\n    }\n}\n\n// `exit status: 3`, `signal: 9 (SIGKILL)`, as Rust's.\nimpl Display for ExitStatus {\n    #[effects(panic, diverge)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.code() {\n            Option::Some(c) => {\n                f.write_str(\"exit status: \")?;\n                Display::fmt(&c, f)\n            }\n            Option::None => match self.signal() {\n                Option::Some(s) => {\n                    f.write_str(\"signal: \")?;\n                    Display::fmt(&s, f)?;\n                    let name = crate::__sys::signal_name(s);\n                    if !name.is_empty() {\n                        f.write_str(\" (\")?;\n                        f.write_str(name)?;\n                        f.write_str(\")\")?;\n                    }\n                    if self.status & 0x80 != 0 {\n                        f.write_str(\" (core dumped)\")?;\n                    }\n                    crate::result::Result::Ok(())\n                }\n                Option::None => {\n                    f.write_str(\"unrecognized wait status: \")?;\n                    Display::fmt(&self.status, f)\n                }\n            },\n        }\n    }\n}\n\n// `ExitStatus(unix_wait_status(256))`, as Rust's.\nimpl Debug for ExitStatus {\n    #[effects(panic, diverge)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"ExitStatus(unix_wait_status(\")?;\n        Display::fmt(&self.status, f)?;\n        f.write_str(\"))\")\n    }\n}\n\n// What output() gives: how the child ended, and what it wrote.\npub struct Output<A: Allocator> {\n    pub status: ExitStatus,\n    pub stdout: Vec<u8, A>,\n    pub stderr: Vec<u8, A>,\n}\n\n// ---- Child ----\n\n// The child's stdin, when it was piped: a writer; dropping it closes it.\n");
    buf_str(out, c"pub struct ChildStdin {\n    fd: i32,\n}\n\n// The child's stdout, when it was piped: a reader.\npub struct ChildStdout {\n    fd: i32,\n}\n\n// The child's stderr, when it was piped: a reader.\npub struct ChildStderr {\n    fd: i32,\n}\n\nimpl Drop for ChildStdin {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Drop for ChildStdout {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Drop for ChildStderr {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Write for ChildStdin {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl Read for ChildStdout {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Read for ChildStderr {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\n// A running child, and its piped streams. Dropping it neither waits for\n// it nor ends it, as Rust's.\npub struct Child {\n    pid: i32,\n    status: Option<ExitStatus>,\n    pub stdin: Option<ChildStdin>,\n    pub stdout: Option<ChildStdout>,\n    pub stderr: Option<ChildStderr>,\n}\n\n// Waits for pid (again when a signal interrupts): its status.\nfn wait_pid(pid: i32) -> Result<i32> {\n    loop {\n        let mut st: i32 = 0;\n        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.\n        let r = unsafe { pr_c_waitpid(pid, &mut st as *mut i32, 0) };\n        if r >= 0 {\n            return crate::result::Result::Ok(st);\n        }\n        let e = Error::last_os_error();\n        if e.raw_os_error() != Option::Some(EINTR) {\n            return crate::result::Result::Err(e);\n        }\n    }\n}\n\nimpl Child {\n    // Its process id.\n    // mvs: Child::id\n    // std2: changed: a u32, as Rust's (MVS: i32)\n    #[effects()]\n");
    buf_str(out, c"    pub fn id(&self) -> u32 {\n        self.pid as u32\n    }\n\n    // Waits for it to end (its stdin closed first, as Rust's).\n    #[effects(alloc(extern), io, static, sync, panic, diverge)]\n    pub fn wait(&mut self) -> Result<ExitStatus> {\n        self.stdin = Option::None;\n        if let Option::Some(s) = self.status {\n            return crate::result::Result::Ok(s);\n        }\n        let st = ExitStatus { status: wait_pid(self.pid)? };\n        self.status = Option::Some(st);\n        crate::result::Result::Ok(st)\n    }\n\n    // How it ended, when it has: None while it runs.\n    #[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\n    pub fn try_wait(&mut self) -> Result<Option<ExitStatus>> {\n        if let Option::Some(s) = self.status {\n            return crate::result::Result::Ok(Option::Some(s));\n        }\n        let mut st: i32 = 0;\n        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.\n        let r = unsafe { pr_c_waitpid(self.pid, &mut st as *mut i32, WNOHANG) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        if r == 0 {\n            return crate::result::Result::Ok(Option::None);\n        }\n        let s = ExitStatus { status: st };\n        self.status = Option::Some(s);\n        crate::result::Result::Ok(Option::Some(s))\n    }\n\n    // Sends it SIGKILL (Ok when it has been waited for already, as Rust's).\n    #[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\n    pub fn kill(&mut self) -> Result<()> {\n        if self.status.is_some() {\n            return crate::result::Result::Ok(());\n        }\n        // UNSAFE: C's kill. SAFETY: integers only.\n        if unsafe { pr_c_kill(self.pid, SIGKILL) } != 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(())\n    }\n}\n\n// ---- Command ----\n\n");
    buf_str(out, c"// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes\n// on macOS, 80 on Linux); dropping it destroys it.\nstruct SpawnActions {\n    words: [u64; 16],\n}\n\nimpl Drop for SpawnActions {\n    fn drop(&mut self) {\n        // UNSAFE: C's destroy. SAFETY: initialized by spawn_actions (the\n        // only maker), destroyed once (here).\n        let _ = unsafe { pr_c_actions_destroy(&mut self.words[0] as *mut u64) };\n    }\n}\n\nfn spawn_actions() -> Result<SpawnActions> {\n    let mut words = [0u64; 16];\n    // UNSAFE: C's init. SAFETY: words is 128 bytes, more than either\n    // system's type, 8-aligned; it holds no pointer into itself, so it\n    // may move.\n    let r = unsafe { pr_c_actions_init(&mut words[0] as *mut u64) };\n    if r != 0 {\n        return crate::result::Result::Err(Error::from_raw_os_error(r));\n    }\n    crate::result::Result::Ok(SpawnActions { words: words })\n}\n\nimpl SpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    fn dup2(&mut self, fd: i32, to: i32) -> Result<()> {\n        // UNSAFE: C adds an action. SAFETY: the actions are initialized.\n        let r = unsafe { pr_c_actions_adddup2(&mut self.words[0] as *mut u64, fd, to) };\n        if r != 0 { crate::result::Result::Err(Error::from_raw_os_error(r)) }\n        else { crate::result::Result::Ok(()) }\n    }\n}\n\n// posix_spawnattr_t, opaque: room for either system's (8 bytes on macOS,\n// 336 on Linux); dropping it destroys it.\nstruct SpawnAttr {\n    words: [u64; 48],\n}\n\nimpl Drop for SpawnAttr {\n    fn drop(&mut self) {\n        // UNSAFE: C's destroy. SAFETY: initialized by sigdefault_attr (the\n        // only maker), destroyed once (here).\n        let _ = unsafe { pr_c_attr_destroy(&mut self.words[0] as *mut u64) };\n    }\n}\n\n// Attributes under which the child starts with SIGINT's and SIGQUIT's\n// default actions, whatever this process's are.\nfn sigdefault_attr() -> Result<SpawnAttr> {\n    let mut words = [0u64; 48];\n");
    buf_str(out, c"    // sigset_t: 4 bytes on macOS, 128 on Linux\n    let mut set = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the set. SAFETY: words\n    // (384 bytes) and set (128) are larger than either system's types,\n    // 8-aligned, and hold no pointer into themselves.\n    unsafe {\n        let r = pr_c_attr_init(&mut words[0] as *mut u64);\n        if r != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r));\n        }\n        pr_c_sigemptyset(&mut set[0] as *mut u64);\n        pr_c_sigaddset(&mut set[0] as *mut u64, SIGINT);\n        pr_c_sigaddset(&mut set[0] as *mut u64, SIGQUIT);\n        let mut a = SpawnAttr { words: words };\n        let r2 = pr_c_attr_setsigdefault(&mut a.words[0] as *mut u64, &set[0] as *const u64);\n        if r2 != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r2));\n        }\n        let r3 = pr_c_attr_setflags(&mut a.words[0] as *mut u64, SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r3));\n        }\n        crate::result::Result::Ok(a)\n    }\n}\n\n// The parent's ends of a spawn's pipes (-1: none), closed on drop.\nstruct Ends {\n    fds: [i32; 7],\n}\n\nimpl Drop for Ends {\n    fn drop(&mut self) {\n        let mut i: usize = 0;\n        while i < 7 {\n            close_fd(self.fds[i]);\n            i += 1;\n        }\n    }\n}\n\nimpl Ends {\n    // fds[i], no longer this one's to close.\n    #[effects(panic, diverge)]\n    fn take(&mut self, i: usize) -> i32 {\n        let fd = self.fds[i];\n        self.fds[i] = -1;\n        fd\n    }\n}\n\n// A program to run: its arguments, the variables it does not get, its\n// streams. Each method changes it in place and returns it, as Rust's\n// (`Command::new_in(\"ls\", a).arg(\"-l\").status()?`).\npub struct Command<A: Allocator> {\n    // the program, then each argument, each NUL-ended\n    text: Vec<u8, A>,\n    argc: usize,\n");
    buf_str(out, c"    // env_remove's names, each NUL-ended\n    removed: Vec<u8, A>,\n    stdin: u8,\n    stdout: u8,\n    stderr: u8,\n    foreground: bool,\n    // an argument that held a NUL: spawn's InvalidInput\n    bad: bool,\n}\n\nimpl<A: Allocator + Clone> Command<A> {\n    // Runs program: a path, or a name looked up in PATH.\n    // mvs: Command::new\n    // std2: changed: allocator named (Rust's Command::new)\n    #[effects(alloc, panic, diverge, A)]\n    pub fn new_in(program: &str, a: A) -> Command<A> {\n        let mut c = Command { text: Vec::new_in(a.clone()), argc: 0, removed: Vec::new_in(a),\n            stdin: DEFAULT, stdout: DEFAULT, stderr: DEFAULT, foreground: false, bad: false };\n        c.push_text(program);\n        c\n    }\n\n    #[effects(alloc, panic, diverge, A)]\n    fn push_text(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            if b[i] == 0 {\n                self.bad = true;\n            }\n            i += 1;\n        }\n        self.text.extend_from_slice(b);\n        self.text.push(0);\n        self.argc += 1;\n    }\n\n    // Adds an argument.\n    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>; MVS: inout)\n    #[effects(alloc, panic, diverge, A)]\n    pub fn arg(&mut self, arg: &str) -> &mut Command<A> {\n        self.push_text(arg);\n        self\n    }\n\n    // Adds each of args.\n    // std2: changed: &mut self, AsRef<str> (Rust's: AsRef<OsStr>; MVS: a\n    // slice)\n    #[effects(alloc, panic, diverge, A, I, S)]\n    pub fn args<I: IntoIterator<Item = S>, S: AsRef<str>>(&mut self, args: I) -> &mut Command<A> {\n        for s in args {\n            // (the path call: AsRef for &T's method call where a &str is\n            // expected is 0.27.5's front gap)\n            self.push_text(AsRef::<str>::as_ref(&s));\n        }\n        self\n    }\n\n    // The child's environment is this process's without key; each call\n    // removes one more.\n");
    buf_str(out, c"    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>)\n    #[effects(alloc, panic, diverge, A)]\n    pub fn env_remove(&mut self, key: &str) -> &mut Command<A> {\n        let b = key.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            if b[i] == 0 {\n                self.bad = true;\n            }\n            i += 1;\n        }\n        self.removed.extend_from_slice(b);\n        self.removed.push(0);\n        self\n    }\n\n    // Runs it as a shell runs a command in the foreground: while status()\n    // or output() waits for it, this process ignores SIGINT and SIGQUIT\n    // (^C and ^\\ at a terminal, which reach both), and the child starts\n    // with their default actions (`volec run`).\n    // std2: changed: vole's own (MVS's), not Rust's\n    #[effects()]\n    pub fn foreground(&mut self, on: bool) -> &mut Command<A> {\n        self.foreground = on;\n        self\n    }\n\n    #[effects()]\n    pub fn stdin(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stdin = cfg.kind;\n        self\n    }\n\n    #[effects()]\n    pub fn stdout(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stdout = cfg.kind;\n        self\n    }\n\n    #[effects()]\n    pub fn stderr(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stderr = cfg.kind;\n        self\n    }\n\n    // Starts it, its streams as set (this process's when not).\n    // std2: changed: &mut self, as Rust's (MVS: self)\n    #[effects(A)]\n    pub fn spawn(&mut self) -> Result<Child> {\n        self.spawn_with(INHERIT, INHERIT, false)\n    }\n\n    // Runs it and waits for it: how it ended.\n    // std2: changed: &mut self, as Rust's (MVS: self)\n    #[effects(alloc(extern), io, static, sync, panic, diverge, A)]\n    pub fn status(&mut self) -> Result<ExitStatus> {\n        let fg = self.foreground;\n        let mut c = self.spawn_with(INHERIT, INHERIT, fg)?;\n        let r = c.wait();\n        if fg {\n            restore_signals(c.pid);\n");
    buf_str(out, c"        }\n        r\n    }\n\n    // Runs it with stdout and stderr piped to this process and stdin\n    // /dev/null (each unless set), and waits: how it ended and what it\n    // wrote, in Vecs on clones of the Command's allocator.\n    // mvs: Command::output_in\n    // std2: changed: on the Command's allocator (Rust's output; MVS: an\n    // allocator given)\n    #[effects(alloc(extern), io, static, sync, panic, diverge, A)]\n    pub fn output(&mut self) -> Result<Output<A>> {\n        let fg = self.foreground;\n        let mut c = self.spawn_with(NULL, PIPED, fg)?;\n        let mut out: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());\n        let mut err: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());\n        c.stdin = Option::None;\n        let a = match c.stdout.take() {\n            Option::Some(s) => s.fd_take(),\n            Option::None => -1,\n        };\n        let b = match c.stderr.take() {\n            Option::Some(s) => s.fd_take(),\n            Option::None => -1,\n        };\n        let got = drain_two(a, b, &mut out, &mut err);\n        close_fd(a);\n        close_fd(b);\n        let st = c.wait();\n        if fg {\n            restore_signals(c.pid);\n        }\n        got?;\n        crate::result::Result::Ok(Output { status: st?, stdout: out, stderr: err })\n    }\n\n    // Starts it: a stream not set is dflt_in (stdin) or dflt_out (stdout\n    // and stderr).\n    fn spawn_with(&mut self, dflt_in: u8, dflt_out: u8, fg: bool) -> Result<Child> {\n        if self.bad {\n            return crate::result::Result::Err(Error::new(crate::io::ErrorKind::InvalidInput,\n                \"nul byte found in provided data\"));\n        }\n        let kinds = [\n            if self.stdin == DEFAULT { dflt_in } else { self.stdin },\n            if self.stdout == DEFAULT { dflt_out } else { self.stdout },\n            if self.stderr == DEFAULT { dflt_out } else { self.stderr },\n        ];\n");
    buf_str(out, c"        // ends.fds: [0..3) the parent's ends, [3..6) the child's, [6] /dev/null\n        let mut ends = Ends { fds: [-1; 7] };\n        let mut acts = spawn_actions()?;\n        let mut k: usize = 0;\n        while k < 3 {\n            if kinds[k] == PIPED {\n                let (r, w) = pipe()?;\n                if k == 0 {\n                    ends.fds[0] = w;\n                    ends.fds[3] = r;\n                } else {\n                    ends.fds[k] = r;\n                    ends.fds[3 + k] = w;\n                }\n                acts.dup2(ends.fds[3 + k], k as i32)?;\n            } else if kinds[k] == NULL {\n                if ends.fds[6] < 0 {\n                    // UNSAFE: C's open. SAFETY: a NUL-ended literal.\n                    let fd = unsafe { pr_c_open(b\"/dev/null\\0\".as_ptr(), O_RDWR) };\n                    if fd < 0 {\n                        return crate::result::Result::Err(Error::last_os_error());\n                    }\n                    // UNSAFE: C's fcntl. SAFETY: an int.\n                    unsafe { pr_c_fcntl(fd, F_SETFD, FD_CLOEXEC) };\n                    ends.fds[6] = fd;\n                }\n                acts.dup2(ends.fds[6], k as i32)?;\n            }\n            k += 1;\n        }\n        let attr = if fg { Option::Some(sigdefault_attr()?) } else { Option::None };\n        let a = self.text.allocator().clone();\n        // argv: a pointer to each NUL-ended string of text, then null\n        let mut argv: Vec<*const u8, A> = Vec::with_capacity_in(self.argc + 1, a.clone());\n        let base = self.text.as_ptr();\n        let mut at: usize = 0;\n        while at < self.text.len() {\n            // UNSAFE: a pointer into text. SAFETY: at < text.len(): in\n            // bounds; text is not changed while argv is used.\n            argv.push(unsafe { base.add(at) });\n            while self.text[at] != 0 {\n                at += 1;\n            }\n            at += 1;\n        }\n        argv.push(crate::ptr::null());\n");
    buf_str(out, c"        let envp = self.envp(a);\n        if fg {\n            ignore_signals();\n        }\n        let mut pid: i32 = 0;\n        let attr_p: *const u64 = match &attr {\n            Option::Some(t) => &t.words[0] as *const u64,\n            Option::None => crate::ptr::null(),\n        };\n        // UNSAFE: C's posix_spawnp.\n        // SAFETY: argv's pointers are text's NUL-ended strings, then null;\n        // envp is null (this process's environ) or environ's strings, then\n        // null; acts is initialized, attr_p null or an initialized attr;\n        // all live past the call.\n        let r = unsafe {\n            pr_c_spawnp(&mut pid as *mut i32, argv[0], &acts.words[0] as *const u64, attr_p,\n                argv.as_ptr(),\n                if envp.is_empty() { crate::__sys::environ() } else { envp.as_ptr() })\n        };\n        if r != 0 {\n            if fg {\n                restore_signals(0);\n            }\n            return crate::result::Result::Err(Error::from_raw_os_error(r));\n        }\n        let stdin = if ends.fds[0] >= 0 { Option::Some(ChildStdin { fd: ends.take(0) }) }\n            else { Option::None };\n        let stdout = if ends.fds[1] >= 0 { Option::Some(ChildStdout { fd: ends.take(1) }) }\n            else { Option::None };\n        let stderr = if ends.fds[2] >= 0 { Option::Some(ChildStderr { fd: ends.take(2) }) }\n            else { Option::None };\n        crate::result::Result::Ok(Child { pid: pid, status: Option::None, stdin: stdin,\n            stdout: stdout, stderr: stderr })\n    }\n\n    // The child's environment when env_remove named a variable: environ's\n    // strings but those, then null; empty (environ itself) when it named\n    // none.\n    fn envp(&self, a: A) -> Vec<*const u8, A> {\n        let mut out: Vec<*const u8, A> = Vec::new_in(a);\n        if self.removed.is_empty() {\n            return out;\n        }\n        let env = crate::__sys::environ();\n        let mut i: usize = 0;\n        loop {\n");
    buf_str(out, c"            // UNSAFE: environ's i-th pointer and its string.\n            // SAFETY: environ is null-ended; i stops at its null; each\n            // string is NUL-ended and is not changed while this runs\n            // (std2's set_var is unsafe for that reason).\n            let e = unsafe { *env.add(i) };\n            if e.is_null() {\n                break;\n            }\n            let mut keep = true;\n            let mut s: usize = 0;\n            while s < self.removed.len() {\n                let mut n: usize = 0;\n                while self.removed[s + n] != 0 {\n                    n += 1;\n                }\n                // UNSAFE: e's bytes, each read before its NUL.\n                // SAFETY: the loop stops at e's NUL or at the name's end.\n                let same = unsafe {\n                    let mut j: usize = 0;\n                    while j < n && *e.add(j) != 0 && *e.add(j) == self.removed[s + j] {\n                        j += 1;\n                    }\n                    j == n && *e.add(n) == 61\n                };\n                if same {\n                    keep = false;\n                }\n                s += n + 1;\n            }\n            if keep {\n                out.push(e);\n            }\n            i += 1;\n        }\n        out.push(crate::ptr::null());\n        out\n    }\n}\n\nimpl ChildStdout {\n    #[effects()]\n    fn fd_take(self) -> i32 {\n        let fd = self.fd;\n        crate::mem::forget(self);\n        fd\n    }\n}\n\nimpl ChildStderr {\n    #[effects()]\n    fn fd_take(self) -> i32 {\n        let fd = self.fd;\n        crate::mem::forget(self);\n        fd\n    }\n}\n\n// SIGINT's and SIGQUIT's dispositions while a foreground child runs.\nstatic mut SIG_WAS: [usize; 2] = [0, 0];\n\nfn ignore_signals() {\n    // UNSAFE: C's signal, and the static the old dispositions go in.\n    // SAFETY: SIG_IGN is a disposition, not code; SIG_WAS is written here\n");
    buf_str(out, c"    // and read by restore_signals, on the thread that runs the Command\n    // (a foreground Command is run by one thread at a time: volec run).\n    unsafe {\n        SIG_WAS[0] = pr_c_signal(SIGINT, SIG_IGN);\n        SIG_WAS[1] = pr_c_signal(SIGQUIT, SIG_IGN);\n    }\n}\n\nfn restore_signals(_pid: i32) {\n    // UNSAFE: C's signal with the dispositions ignore_signals saved.\n    // SAFETY: each is what signal returned (SIG_DFL, SIG_IGN or a handler\n    // of this process, still loaded); SIG_ERR means nothing was changed.\n    unsafe {\n        if SIG_WAS[0] != SIG_ERR {\n            pr_c_signal(SIGINT, SIG_WAS[0]);\n        }\n        if SIG_WAS[1] != SIG_ERR {\n            pr_c_signal(SIGQUIT, SIG_WAS[1]);\n        }\n    }\n}\n\n// Reads the pipes a and b (-1: none) to their ends, into va and vb (poll:\n// neither child stream blocks the other).\nfn drain_two<A: Allocator>(a: i32, b: i32, va: &mut Vec<u8, A>, vb: &mut Vec<u8, A>) -> Result<()> {\n    let mut open_a = a >= 0;\n    let mut open_b = b >= 0;\n    let mut buf = [0u8; 8192];\n    while open_a || open_b {\n        let mut fds = [\n            PollFd { fd: if open_a { a } else { -1 }, events: POLLIN, revents: 0 },\n            PollFd { fd: if open_b { b } else { -1 }, events: POLLIN, revents: 0 },\n        ];\n        // UNSAFE: C's poll. SAFETY: fds is a local array of 2 pollfds.\n        if unsafe { pr_c_poll(&mut fds[0] as *mut PollFd, 2, -1) } < 0 {\n            let e = Error::last_os_error();\n            if e.raw_os_error() == Option::Some(EINTR) {\n                continue;\n            }\n            return crate::result::Result::Err(e);\n        }\n        if open_a && fds[0].revents != 0 {\n            let n = crate::io::sys_read(a, &mut buf)?;\n            va.extend_from_slice(&buf[..n]);\n            open_a = n > 0;\n        }\n        if open_b && fds[1].revents != 0 {\n            let n = crate::io::sys_read(b, &mut buf)?;\n            vb.extend_from_slice(&buf[..n]);\n");
    buf_str(out, c"            open_b = n > 0;\n        }\n    }\n    crate::result::Result::Ok(())\n}\n\n// Ends this process with code (Rust's: no destructors run).\n#[effects(io, diverge, unsafe)]\npub fn exit(code: i32) -> ! {\n    // UNSAFE: C's exit. SAFETY: an int; it does not return.\n    unsafe { pr_c_exit(code) }\n}\n\n// Ends this process abnormally (SIGABRT).\n#[effects(io, diverge, unsafe)]\npub fn abort() -> ! {\n    // UNSAFE: C's abort. SAFETY: no arguments; it does not return.\n    unsafe { pr_c_abort() }\n}\n\n// This process's id.\n// std2: changed: a u32, as Rust's (MVS: i32)\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\npub fn id() -> u32 {\n    // UNSAFE: C's getpid. SAFETY: no arguments.\n    unsafe { pr_c_getpid() as u32 }\n}\n// ---- end mod std::process ----\n}\n// ---- mod std::thread ----\npub mod thread {\n// EDITION: rust\n// std::thread: scoped threads, spawned threads, and the thread's own\n// queries. `thread::scope` is the safe way to share a borrow with\n// threads: every thread spawned in the scope is joined before it returns,\n// so they may borrow what outlives the scope ('env). It takes no\n// allocator: its threads' records come from C's heap, as Rust's from the\n// global one. `spawn_in(f, a)` runs a 'static closure on a thread\n// of its own, its closure and result kept on a (plan §2: MVS's spawn\n// allocated through C, unnamed). A panic in any thread ends the process\n// with 101 (decision 18), so `join` never returns an Err; it returns a\n// Result anyway, so that `.join().unwrap()` reads as in Rust.\n\nuse crate::alloc::{AllocError, Allocator, Layout};\nuse crate::cell::Cell;\nuse crate::fmt::{Debug, Formatter};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::ptr::NonNull;\n\n// UNSAFE: C's heap and POSIX threads, which take raw pointers.\n// SAFETY: the prototypes are stdlib.h's, pthread.h's, sched.h's and\n// unistd.h's (pthread_t as u64, as on macOS and Linux), as MVS's thread.\n");
    buf_str(out, c"extern \"C\" {\n    #[link_name = \"malloc\"]\n    fn thread_c_malloc(n: usize) -> *mut u8;\n    #[link_name = \"free\"]\n    fn thread_c_free(p: *mut u8);\n    #[link_name = \"pthread_create\"]\n    fn thread_c_create(t: *mut u64, attr: *const u8, f: extern \"C\" fn(*mut u8) -> *mut u8,\n        arg: *mut u8) -> i32;\n    #[link_name = \"pthread_join\"]\n    fn thread_c_join(t: u64, ret: *mut u64) -> i32;\n    #[link_name = \"pthread_detach\"]\n    fn thread_c_detach(t: u64) -> i32;\n    #[link_name = \"pthread_attr_init\"]\n    fn thread_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"pthread_attr_setstacksize\"]\n    fn thread_c_attr_setstacksize(a: *mut u8, size: usize) -> i32;\n    #[link_name = \"pthread_attr_destroy\"]\n    fn thread_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"sched_yield\"]\n    fn thread_c_yield() -> i32;\n    #[link_name = \"sysconf\"]\n    fn thread_c_sysconf(name: i32) -> i64;\n}\n\n// Built in: the compiler lowers a std function named atomic_* to the\n// instruction, as MVS's std::sync::atomic (order: 1 Acquire, 2 Release,\n// 3 AcqRel); the bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid, aligned, shared only through\n// atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\nconst ACQUIRE: i64 = 1;\nconst RELEASE: i64 = 2;\nconst ACQ_REL: i64 = 3;\n\n// _SC_NPROCESSORS_ONLN (macOS's number; 84 on Linux).\nconst SC_NPROCESSORS_ONLN: i32 = 58;\n\n// The stack of a new thread: 8 MiB (macOS's default past the first\n// thread is 512 KiB), as MVS's.\nconst THREAD_STACK: usize = 8388608;\n\n");
    buf_str(out, c"// C's heap, for a scope's records: a scope takes no allocator (Rust's\n// takes its records from the global heap the same way).\n#[derive(Clone, Copy)]\nstruct CHeap {\n    sealed: (),\n}\n\n// UNSAFE: an Allocator impl over C's heap.\n// SAFETY: blocks come from malloc (16-aligned: enough for the records of\n// words, an Option and a closure it holds) and go back to free.\nunsafe impl Allocator for CHeap {\n    fn allocate(&self, layout: Layout) -> crate::result::Result<NonNull<u8>, AllocError> {\n        if layout.align() > 16 {\n            return crate::result::Result::Err(AllocError {});\n        }\n        // UNSAFE: C's malloc.\n        // SAFETY: it takes a size and returns a block or null.\n        let p = unsafe { thread_c_malloc(layout.size()) };\n        match NonNull::new(p) {\n            Option::Some(q) => crate::result::Result::Ok(q),\n            Option::None => crate::result::Result::Err(AllocError {}),\n        }\n    }\n\n    // UNSAFE: gives a block back to C's free.\n    // SAFETY: a contract on the caller (Allocator's): p is a block this\n    // allocator gave, so malloc's.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        thread_c_free(p.as_ptr());\n    }\n}\n\n// What a thread shares with its handle: its result once done (done is\n// 1 then), and refs, the thread's and the handle's: the last of the two\n// frees it into alloc.\nstruct Out<T, A: Allocator> {\n    result: Option<T>,\n    done: u32,\n    refs: u32,\n    alloc: A,\n}\n\n// The closure, moved to the thread, and where its result goes.\nstruct Packet<F, T, A: Allocator> {\n    f: F,\n    out: *mut Out<T, A>,\n}\n\n// What the thread starts from (C's heap): run(data, this record).\nstruct Start {\n    run: fn(*mut u8, *mut u8),\n    data: *mut u8,\n}\n\n// The thread's first frame (C's convention, what pthread_create takes).\nextern \"C\" fn thread_start(arg: *mut u8) -> *mut u8 {\n    // UNSAFE: the start record through its raw pointer.\n");
    buf_str(out, c"    // SAFETY: arg is the Start start_thread wrote for this thread only;\n    // it is read here and freed by run.\n    unsafe {\n        let s = arg as *mut Start;\n        let run = (*s).run;\n        let data = (*s).data;\n        run(data, arg);\n    }\n    crate::ptr::null_mut::<u8>()\n}\n\n// A record of T's layout from a; out of memory panics.\nfn new_record<T, A: Allocator>(a: &A, x: T) -> *mut T {\n    let p = match a.allocate(Layout::new::<T>()) {\n        crate::result::Result::Ok(p) => p.as_ptr() as *mut T,\n        crate::result::Result::Err(_) => {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg)\n        }\n    };\n    // UNSAFE: x moved into the fresh block.\n    // SAFETY: p is a block of T's layout from a; the write drops nothing.\n    unsafe { crate::ptr::write(p, x) };\n    p\n}\n\n// Gives a record of T's layout back to a (its value moved out already).\n// UNSAFE: deallocates through the allocator.\n// SAFETY: a contract on the caller: p is new_record's block from a.\nunsafe fn free_record<T, A: Allocator>(a: &A, p: *mut T) {\n    match NonNull::new(p as *mut u8) {\n        Option::Some(q) => a.deallocate(q, Layout::new::<T>()),\n        Option::None => {}\n    }\n}\n\n// Drops the result (if any) and frees out into its own allocator.\n// UNSAFE: moves the record out through its raw pointer.\n// SAFETY: a contract on the caller: out is live and nobody uses it after.\nunsafe fn release_out<T, A: Allocator>(out: *mut Out<T, A>) {\n    let o = crate::ptr::read(out as *const Out<T, A>);\n    free_record(&o.alloc, out);\n    crate::mem::drop(o);\n}\n\n// The thread's work: the packet taken and freed, the closure called, its\n// result published, the thread's ref given up.\nfn thread_run<F: FnOnce() -> T, T, A: Allocator>(data: *mut u8, start: *mut u8) {\n    // UNSAFE: the packet, the start record and the result's place through\n    // raw pointers.\n");
    buf_str(out, c"    // SAFETY: data is the Packet start_thread wrote for this thread only:\n    // moved out and freed once; start is freed once into C's heap; out is\n    // live while refs > 0, and this thread holds one ref until its\n    // atomic_sub (AcqRel: the handle's side is ordered before the free).\n    unsafe {\n        let q = data as *mut Packet<F, T, A>;\n        let p = crate::ptr::read(q as *const Packet<F, T, A>);\n        let out = p.out;\n        free_record(&*(&(*out).alloc), q);\n        thread_c_free(start);\n        let r = (p.f)();\n        (*out).result = Option::Some(r);\n        atomic_store(&mut (*out).done as *mut u32, 1, RELEASE);\n        if atomic_sub(&mut (*out).refs as *mut u32, 1, ACQ_REL) == 1 {\n            release_out(out);\n        }\n    }\n}\n\n// Starts a thread running f, its records on a: its pthread_t and its\n// result's place.\nfn start_thread<F: FnOnce() -> T, T, A: Allocator>(f: F, a: A) -> (u64, *mut Out<T, A>) {\n    let out = new_record(&a, Out::<T, A> { result: Option::<T>::None, done: 0, refs: 2, alloc: a });\n    // UNSAFE: the records reached through raw pointers, and pthread_create.\n    // SAFETY: out is live (refs 2); the Packet and the Start go to the new\n    // thread only; attr is 128 bytes, more than a pthread_attr_t.\n    unsafe {\n        let q = new_record(&*(&(*out).alloc), Packet { f: f, out: out });\n        let s = thread_c_malloc(Layout::new::<Start>().size()) as *mut Start;\n        if s.is_null() {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg);\n        }\n        crate::ptr::write(s, Start { run: thread_run::<F, T, A>, data: q as *mut u8 });\n        let mut attr: [u64; 16] = [0; 16];\n        let ap = &mut attr[0] as *mut u64 as *mut u8;\n        thread_c_attr_init(ap);\n        thread_c_attr_setstacksize(ap, THREAD_STACK);\n        let mut t: u64 = 0;\n        let rc = thread_c_create(&mut t as *mut u64, ap as *const u8, thread_start, s as *mut u8);\n");
    buf_str(out, c"        thread_c_attr_destroy(ap);\n        if rc != 0 {\n            let msg: &str = \"failed to spawn thread\";\n            crate::panic::panic(msg);\n        }\n        (t, out)\n    }\n}\n\n// Waits for thread t and takes its result, freeing its place.\n// UNSAFE: pthread_join and the result's place through its raw pointer.\n// SAFETY: a contract on the caller: t is out's thread, not joined or\n// detached yet, and out is not used after.\nunsafe fn join_thread<T, A: Allocator>(t: u64, out: *mut Out<T, A>) -> T {\n    thread_c_join(t, crate::ptr::null_mut::<u64>());\n    let r = crate::mem::replace(&mut *(&mut (*out).result), Option::None);\n    release_out(out);\n    match r {\n        Option::Some(x) => x,\n        Option::None => crate::panic::unreachable(),\n    }\n}\n\n// Whether out's thread has published its result.\n// UNSAFE: an atomic read through the raw pointer.\n// SAFETY: a contract on the caller: out is live.\nunsafe fn finished<T, A: Allocator>(out: *mut Out<T, A>) -> bool {\n    atomic_load(&(*out).done as *const u32, ACQUIRE) == 1\n}\n\n// A thread of a scope, in its list: joined when the scope ends unless its\n// handle joined it.\nstruct ScopeNode {\n    native: u64,\n    joined: bool,\n    out: *mut u8,\n    join: fn(u64, *mut u8),\n    next: *mut ScopeNode,\n}\n\n// A scope node's join, erased: the thread joined and its result dropped.\n// Private, and called only by scope's end with its own node's pair.\nfn scope_join<T>(t: u64, out: *mut u8) {\n    // UNSAFE: the result's place through an erased pointer.\n    // SAFETY: the pair is one node's: out is the Out<T, CHeap> of thread\n    // t, not joined yet (the node is not marked joined).\n    crate::mem::drop(unsafe { join_thread(t, out as *mut Out<T, CHeap>) });\n}\n\n// join's result: never an Err in vole (a panic exits the process).\npub type Result<T> = crate::result::Result<T, JoinError>;\n\n// A thread's panic, as join would report it: no value is ever made.\npub struct JoinError {\n");
    buf_str(out, c"    never: crate::convert::Infallible,\n}\n\nimpl Debug for JoinError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.never {}\n    }\n}\n\n// Runs f with a Scope, joins every thread spawned in it, and returns f's\n// value. Each region in f's argument is elided, so it is late-bound (no\n// `for<'a>`, cut to 0.29): the scope's region 'scope cannot be named\n// outside f, and Scope is invariant in it, so a thread cannot borrow a\n// local of f's body (plan §4, threads).\n// std2: changed: FnOnce(&Scope<'_, 'env>) (MVS: FnMut(inout Scope))\n#[effects(alloc(CHeap), diverge, unsafe, F)]\npub fn scope<'env, F, T>(f: F) -> T\n    where\n        F: FnOnce(&Scope<'_, 'env>) -> T,\n{\n    let s = Scope {\n        first: Cell::new(crate::ptr::null_mut::<ScopeNode>()),\n        scope: PhantomData {},\n        env: PhantomData {},\n    };\n    let r = f(&s);\n    // UNSAFE: walks the scope's list through raw pointers.\n    // SAFETY: every node is one Scope::spawn made for s and freed here\n    // only, once; a node its handle joined is skipped.\n    unsafe {\n        let mut n = s.first.get();\n        while !n.is_null() {\n            let next = (*n).next;\n            if !(*n).joined {\n                ((*n).join)((*n).native, (*n).out);\n            }\n            free_record(&CHeap { sealed: () }, n);\n            n = next;\n        }\n    }\n    r\n}\n\n// The scope threads are spawned in. 'scope is the scope's own region\n// ('env outlives it); invariant in both, as Rust's.\n// std2: changed: two regions, invariant\npub struct Scope<'scope, 'env: 'scope> {\n    first: Cell<*mut ScopeNode>,\n    scope: PhantomData<&'scope mut &'scope ()>,\n    env: PhantomData<&'env mut &'env ()>,\n}\n\nimpl<'scope, 'env> Scope<'scope, 'env> {\n    // Runs f on a new thread, joined at the latest when the scope ends;\n    // f may borrow anything that outlives 'scope. `&self`, not Rust's\n");
    buf_str(out, c"    // `&'scope self`: scope's argument elides its two regions separately,\n    // so the reference may be shorter than 'scope; the bound F: 'scope,\n    // with Scope invariant in 'scope, is what keeps f's borrows alive.\n    // std2: changed: &self, FnOnce, Send, a 'scope bound (MVS: inout self, FnMut)\n    // later: auto_trait\n    #[effects(alloc(CHeap), panic, diverge, F, T)]\n    pub fn spawn<F, T>(&self, f: F) -> ScopedJoinHandle<'scope, T>\n        where\n            F: FnOnce() -> T + Send + 'scope,\n            T: Send + 'scope,\n    {\n        let (t, out) = start_thread(f, CHeap { sealed: () });\n        let node = new_record(&CHeap { sealed: () }, ScopeNode {\n            native: t,\n            joined: false,\n            out: out as *mut u8,\n            join: scope_join::<T>,\n            next: self.first.get(),\n        });\n        self.first.set(node);\n        ScopedJoinHandle { native: t, out: out, node: node, scope: PhantomData {} }\n    }\n}\n\n// A scoped thread: join waits for its value.\n// std2: changed: a region 'scope\npub struct ScopedJoinHandle<'scope, T> {\n    native: u64,\n    out: *mut Out<T, CHeap>,\n    node: *mut ScopeNode,\n    scope: PhantomData<&'scope ()>,\n}\n\n// UNSAFE: the handle reaches its result and its scope node through raw\n// pointers: stated, as Rust's (Send and Sync for every T).\n// SAFETY: as JoinHandle's; Scope::spawn asks T: Send, and the scope's node\n// is written only by join, which takes the handle.\nunsafe impl<'scope, T> Send for ScopedJoinHandle<'scope, T> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&ScopedJoinHandle` only reads the done flag, atomically.\nunsafe impl<'scope, T> Sync for ScopedJoinHandle<'scope, T> {}\n\nimpl<'scope, T> ScopedJoinHandle<'scope, T> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(unsafe, T)]\n    pub fn join(self) -> Result<T> {\n");
    buf_str(out, c"        // UNSAFE: the scope's node and the thread's result through raw\n        // pointers.\n        // SAFETY: the node lives until the scope ends, which 'scope\n        // outlives; marked joined, the scope's end skips the thread, so it\n        // is joined once.\n        unsafe {\n            (*self.node).joined = true;\n            crate::result::Result::Ok(join_thread(self.native, self.out))\n        }\n    }\n\n    // Whether the thread has finished (join would not wait).\n    #[effects(unsafe, T)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: out lives until the thread is joined, by this handle's\n        // join (which takes it) or the scope's end ('scope outlives self).\n        unsafe { finished(self.out) }\n    }\n}\n\n// Runs f on a new thread of its own; its closure and its result live on\n// a until join (or the handle's drop, which detaches it).\n// mvs: spawn\n// std2: changed: an allocator, FnOnce, Send and 'static (MVS: spawn(f), through C)\n// later: auto_trait\n#[effects(F, T, A)]\npub fn spawn_in<F, T, A>(f: F, a: A) -> JoinHandle<T, A>\n    where\n        F: FnOnce() -> T + Send + 'static,\n        T: Send + 'static,\n        A: Allocator + Send + 'static,\n{\n    let (t, out) = start_thread(f, a);\n    JoinHandle { native: t, out: out }\n}\n\n// A spawned thread.\n// std2: changed: an allocator parameter\npub struct JoinHandle<T, A: Allocator> {\n    native: u64,\n    out: *mut Out<T, A>,\n}\n\n// UNSAFE: the handle reaches the thread's result through a raw pointer:\n// stated, as Rust's (Send and Sync for every T).\n// SAFETY: the result's place is shared with the thread by its refs count,\n// atomically (AcqRel), and read only by join, which takes the handle;\n// spawn_in asks T: Send and A: Send.\nunsafe impl<T, A: Allocator> Send for JoinHandle<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&JoinHandle` only reads the done flag, atomically (is_finished).\n");
    buf_str(out, c"unsafe impl<T, A: Allocator> Sync for JoinHandle<T, A> {}\n\nimpl<T, A: Allocator> JoinHandle<T, A> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(alloc(A, extern), io, static, sync, panic, diverge, unsafe, T, A)]\n    pub fn join(self) -> Result<T> {\n        let t = self.native;\n        let out = self.out;\n        crate::mem::forget(self);\n        // UNSAFE: pthread_join and the result's place.\n        // SAFETY: the handle held a ref, so out is live; it is forgotten, so\n        // its drop does not detach or free; the thread is joined once.\n        crate::result::Result::Ok(unsafe { join_thread(t, out) })\n    }\n\n    #[effects(unsafe, T, A)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: the handle holds a ref, so out is live.\n        unsafe { finished(self.out) }\n    }\n}\n\n// Detaches the thread: it runs on, its result dropped when it ends.\nimpl<T, A: Allocator> crate::ops::Drop for JoinHandle<T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: pthread_detach and the result's place.\n        // SAFETY: out is live (the handle's ref); the last of the thread and\n        // the handle (refs, AcqRel) frees it, once.\n        unsafe {\n            thread_c_detach(self.native);\n            if atomic_sub(&mut (*self.out).refs as *mut u32, 1, ACQ_REL) == 1 {\n                release_out(self.out);\n            }\n        }\n    }\n}\n\n// Lets the OS run another thread.\n#[effects(sync, unsafe)]\npub fn yield_now() {\n    // UNSAFE: C's sched_yield.\n    // SAFETY: it takes nothing.\n    unsafe { thread_c_yield() };\n}\n\n// How many threads can run at once (the CPUs online); 1 when unknown.\n// (Rust's returns io::Result<NonZero<usize>>; vole's, a usize.)\n// std2: changed: usize\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\npub fn available_parallelism() -> usize {\n");
    buf_str(out, c"    // UNSAFE: C's sysconf.\n    // SAFETY: it takes an int.\n    let n = unsafe { thread_c_sysconf(SC_NPROCESSORS_ONLN) };\n    if n < 1 { 1 } else { n as usize }\n}\n\n// UNSAFE: C's nanosleep. SAFETY: time.h's prototype (struct timespec, two\n// 64-bit fields on the 64-bit targets, an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"nanosleep\"]\n    fn thread_c_nanosleep(req: *const i64, rem: *mut i64) -> i32;\n}\n\n// Sleeps for d at least: sleeps again for the rest when a signal wakes it.\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\npub fn sleep(d: crate::time::Duration) {\n    let max_secs = 9223372036854775807u64;\n    let secs = d.as_secs();\n    let mut req = [if secs > max_secs { max_secs as i64 } else { secs as i64 },\n        d.subsec_nanos() as i64];\n    // (each round sleeps or ends, a signal per round at most: counted)\n    for _ in 0..1000000 {\n        let mut rem = [0i64; 2];\n        // UNSAFE: C's nanosleep.\n        // SAFETY: req and rem are timespecs (two i64s), rem writable; req's\n        // nanoseconds are under a second (a Duration's).\n        let r = unsafe { thread_c_nanosleep(&req[0] as *const i64, &mut rem[0] as *mut i64) };\n        if r == 0 || rem[0] == 0 && rem[1] == 0 {\n            return;\n        }\n        req = rem;\n    }\n}\n\n// ---- Thread-locals ----\n\n// `#[thread_local] static mut X: T = INIT;`: each thread has its own X,\n// made from INIT when the thread first reaches it. The compiler makes\n// every access of X `*__tls_addr(&X's initial value, size)`\n// (front/threadlocal.vl), as for MVS's std::thread, which keeps them the\n// same way: C's thread-specific data, a key per thread-local found by\n// the initial value's address in a table read without a lock, the\n// thread's copy allocated from C at its first access and freed when the\n// thread ends. A thread-local's drop does not run.\n\n// UNSAFE: POSIX thread-specific data and memcpy, with raw pointers.\n");
    buf_str(out, c"// SAFETY: the prototypes are pthread.h's and string.h's (pthread_key_t\n// written as a u64 that starts 0: macOS's unsigned long, or Linux's\n// unsigned int in its low half), as MVS's thread.\nextern \"C\" {\n    #[link_name = \"pthread_key_create\"]\n    fn tls_c_key_create(key: *mut u64, destructor: extern \"C\" fn(*mut u8)) -> i32;\n    #[link_name = \"pthread_getspecific\"]\n    fn tls_c_get(key: u64) -> *mut u8;\n    #[link_name = \"pthread_setspecific\"]\n    fn tls_c_set(key: u64, p: *mut u8) -> i32;\n    #[link_name = \"memcpy\"]\n    fn tls_c_memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;\n}\n\n// UNSAFE: as atomic_load (built in: the old value, then `new` stored when\n// it was `expected`).\n// SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The key table, by the initial value's address (open addressing): a\n// slot's address is claimed by a compare-and-swap, then its key + 1 is\n// published (release) by the thread that claimed it.\nconst TLS_SLOTS: usize = 1024;\nstatic mut TLS_ADDRS: [u64; 1024] = [0; 1024];\nstatic mut TLS_KEYS: [u64; 1024] = [0; 1024];\n\nextern \"C\" fn tls_free(p: *mut u8) {\n    // UNSAFE: C's free.\n    // SAFETY: p is a thread's copy tls_first allocated, freed once, by the\n    // key's destructor when the thread ends.\n    unsafe { thread_c_free(p) };\n}\n\n// This thread's copy of the thread-local whose initial value (size bytes)\n// is at template.\n#[effects(alloc(extern), io, static, sync, panic, diverge, unsafe)]\n// UNSAFE: returns a raw pointer to this thread's copy.\n// SAFETY: (the caller's: the compiler's) template is a thread-local's\n// initial value of size bytes, live for the program.\npub unsafe fn __tls_addr(template: *mut u8, size: i64) -> *mut u8 {\n    let key = tls_key(template);\n    let p = tls_c_get(key);\n    if !p.is_null() {\n        return p;\n    }\n    tls_first(key, template, size)\n}\n\n");
    buf_str(out, c"// UNSAFE: C memory and a copy from a raw pointer.\n// SAFETY: (the caller's) template has size bytes; p is checked non-null,\n// with room for them.\n#[inline(never)]\nunsafe fn tls_first(key: u64, template: *mut u8, size: i64) -> *mut u8 {\n    let n = if size > 0 { size as usize } else { 1 };\n    let p = thread_c_malloc(n);\n    if p.is_null() {\n        crate::panic::panic(\"thread-locals: out of memory\");\n    }\n    tls_c_memcpy(p, template as *const u8, n);\n    tls_c_set(key, p);\n    p\n}\n\n// The key of the thread-local at template, made at its first use: the\n// thread whose compare-and-swap claims the slot makes it and publishes\n// it; another one that finds the address waits for the key.\n// UNSAFE: the key table's statics through raw pointers, atomically, and\n// pthread_key_create.\n// SAFETY: i stays in 0..TLS_SLOTS (a hash's top 10 bits, then mod); a\n// slot's address is written only by the compare-and-swap, its key only by\n// the thread whose swap claimed it, before others read it (release,\n// acquire).\nunsafe fn tls_key(template: *mut u8) -> u64 {\n    let a = template as u64;\n    let addrs = &raw mut TLS_ADDRS as *mut u64;\n    let keys = &raw mut TLS_KEYS as *mut u64;\n    let mut i = ((a >> 4).wrapping_mul(0x9e3779b97f4a7c15) >> 54) as usize % TLS_SLOTS;\n    for _ in 0..TLS_SLOTS {\n        let mut seen = atomic_load(addrs.add(i) as *const u64, ACQUIRE);\n        if seen == 0 {\n            seen = atomic_cas(addrs.add(i), 0, a, ACQ_REL);\n            if seen == 0 {\n                let mut key: u64 = 0;\n                if tls_c_key_create(&mut key as *mut u64, tls_free) != 0 {\n                    crate::panic::panic(\"thread-locals: the system has no key left\");\n                }\n                atomic_store(keys.add(i), key + 1, RELEASE);\n                return key;\n            }\n        }\n        if seen == a {\n            loop {\n                let k = atomic_load(keys.add(i) as *const u64, ACQUIRE);\n");
    buf_str(out, c"                if k != 0 {\n                    return k - 1;\n                }\n                thread_c_yield();\n            }\n        }\n        i = (i + 1) % TLS_SLOTS;\n    }\n    crate::panic::panic(\"thread-locals: more than 1024\")\n}\n// ---- end mod std::thread ----\n}\n// ---- mod std::time ----\npub mod time {\n// EDITION: rust\n// std::time: Duration, Instant and SystemTime, Rust's shape (0.27.5). A\n// Duration is whole seconds and the nanoseconds under one second; its\n// arithmetic is checked (`checked_*` give None, `saturating_*` stop at\n// zero and the largest Duration, the operators panic, as Rust's do).\n// Instant reads the monotonic clock, SystemTime the wall clock, both\n// through C's clock_gettime (the clock's id is the target's: std::__sys).\n// mvs: std::time\n\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::ops::{Add, AddAssign, Div, DivAssign, Mul, MulAssign, Sub, SubAssign};\nuse crate::option::Option;\nuse crate::result::Result;\n\nconst NANOS_PER_SEC: u32 = 1000000000;\nconst NANOS_PER_MILLI: u32 = 1000000;\nconst NANOS_PER_MICRO: u32 = 1000;\n\n// A span of time, Rust's std::time::Duration.\n// std2: changed: no ZERO, MAX, SECOND.. constants (a constant of a struct\n// type waits for const evaluation): `Duration::from_secs(0)`, `new(..)`\n// mvs: Duration\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct Duration {\n    secs: u64,\n    nanos: u32,\n}\n\nimpl Duration {\n    // secs seconds and nanos nanoseconds; nanos past a second carry into\n    // the seconds (panics when the seconds overflow).\n    #[effects(panic, diverge)]\n    pub fn new(secs: u64, nanos: u32) -> Duration {\n        if nanos < NANOS_PER_SEC {\n            return Duration { secs: secs, nanos: nanos };\n        }\n        let extra = (nanos / NANOS_PER_SEC) as u64;\n        match secs.checked_add(extra) {\n            Option::Some(s) => Duration { secs: s, nanos: nanos % NANOS_PER_SEC },\n");
    buf_str(out, c"            Option::None => crate::panic::panic(\"overflow in Duration::new\"),\n        }\n    }\n\n    #[effects()]\n    pub fn from_secs(secs: u64) -> Duration {\n        Duration { secs: secs, nanos: 0 }\n    }\n\n    #[effects()]\n    pub fn from_millis(millis: u64) -> Duration {\n        Duration { secs: millis / 1000, nanos: ((millis % 1000) as u32) * NANOS_PER_MILLI }\n    }\n\n    #[effects()]\n    pub fn from_micros(micros: u64) -> Duration {\n        Duration { secs: micros / 1000000, nanos: ((micros % 1000000) as u32) * NANOS_PER_MICRO }\n    }\n\n    #[effects()]\n    pub fn from_nanos(nanos: u64) -> Duration {\n        Duration { secs: nanos / 1000000000, nanos: (nanos % 1000000000) as u32 }\n    }\n\n    // secs seconds, a float: panics when it is negative, not finite or too\n    // large, as Rust's does; rounded to the nearest nanosecond.\n    #[effects(panic, diverge)]\n    pub fn from_secs_f64(secs: f64) -> Duration {\n        match Duration::try_from_secs_f64(secs) {\n            Result::Ok(d) => d,\n            Result::Err(_) => crate::panic::panic(\n                \"cannot convert float seconds to Duration: value is negative, not finite or overflowing\"),\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn from_secs_f32(secs: f32) -> Duration {\n        Duration::from_secs_f64(secs as f64)\n    }\n\n    // from_secs_f64's value, or the error where it panics.\n    #[effects()]\n    pub fn try_from_secs_f64(secs: f64) -> Result<Duration, TryFromFloatSecsError> {\n        if !(secs >= 0.0) || secs >= 18446744073709551616.0 {\n            return Result::Err(TryFromFloatSecsError { negative: secs < 0.0 });\n        }\n        let whole = secs as u64;\n        let frac = secs - whole as f64;\n        let mut nanos = (frac * 1000000000.0 + 0.5) as u64;\n        let mut s = whole;\n        if nanos >= 1000000000 {\n            nanos -= 1000000000;\n            match s.checked_add(1) {\n                Option::Some(t) => s = t,\n");
    buf_str(out, c"                Option::None => return Result::Err(TryFromFloatSecsError { negative: false }),\n            }\n        }\n        Result::Ok(Duration { secs: s, nanos: nanos as u32 })\n    }\n\n    #[effects()]\n    pub fn try_from_secs_f32(secs: f32) -> Result<Duration, TryFromFloatSecsError> {\n        Duration::try_from_secs_f64(secs as f64)\n    }\n\n    #[effects()]\n    pub fn is_zero(&self) -> bool {\n        self.secs == 0 && self.nanos == 0\n    }\n\n    #[effects()]\n    pub fn as_secs(&self) -> u64 {\n        self.secs\n    }\n\n    #[effects()]\n    pub fn subsec_millis(&self) -> u32 {\n        self.nanos / NANOS_PER_MILLI\n    }\n\n    #[effects()]\n    pub fn subsec_micros(&self) -> u32 {\n        self.nanos / NANOS_PER_MICRO\n    }\n\n    #[effects()]\n    pub fn subsec_nanos(&self) -> u32 {\n        self.nanos\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_millis(&self) -> u64 {\n        self.secs.saturating_mul(1000).saturating_add((self.nanos / NANOS_PER_MILLI) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_micros(&self) -> u64 {\n        self.secs.saturating_mul(1000000).saturating_add((self.nanos / NANOS_PER_MICRO) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_nanos(&self) -> u64 {\n        self.secs.saturating_mul(1000000000).saturating_add(self.nanos as u64)\n    }\n\n    #[effects()]\n    pub fn as_secs_f64(&self) -> f64 {\n        self.secs as f64 + self.nanos as f64 / 1000000000.0\n    }\n\n    #[effects()]\n    pub fn as_secs_f32(&self) -> f32 {\n        self.as_secs_f64() as f32\n    }\n\n    #[effects()]\n    pub fn as_millis_f64(&self) -> f64 {\n        self.secs as f64 * 1000.0 + self.nanos as f64 / 1000000.0\n    }\n\n    #[effects()]\n    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_add(rhs.secs) {\n");
    buf_str(out, c"            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let mut nanos = self.nanos + rhs.nanos;\n        if nanos >= NANOS_PER_SEC {\n            nanos -= NANOS_PER_SEC;\n            secs = match secs.checked_add(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n        }\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_sub(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let nanos = if self.nanos >= rhs.nanos {\n            self.nanos - rhs.nanos\n        } else {\n            secs = match secs.checked_sub(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n            self.nanos + NANOS_PER_SEC - rhs.nanos\n        };\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {\n        let total = self.nanos as u64 * rhs as u64;\n        let extra = total / NANOS_PER_SEC as u64;\n        let nanos = (total % NANOS_PER_SEC as u64) as u32;\n        match self.secs.checked_mul(rhs as u64) {\n            Option::Some(s) => match s.checked_add(extra) {\n                Option::Some(secs) => Option::Some(Duration { secs: secs, nanos: nanos }),\n                Option::None => Option::None,\n            },\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn checked_div(self, rhs: u32) -> Option<Duration> {\n        if rhs == 0 {\n            return Option::None;\n        }\n        let secs = self.secs / rhs as u64;\n        let carry = self.secs - secs * rhs as u64;\n        let extra = carry * NANOS_PER_SEC as u64 / rhs as u64;\n");
    buf_str(out, c"        let nanos = self.nanos / rhs + extra as u32;\n        Option::Some(Duration::new(secs, nanos))\n    }\n\n    #[effects()]\n    pub fn saturating_add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: 0, nanos: 0 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn abs_diff(self, other: Duration) -> Duration {\n        if self >= other {\n            self.saturating_sub(other)\n        } else {\n            other.saturating_sub(self)\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn mul_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(rhs * self.as_secs_f64())\n    }\n\n    #[effects(panic, diverge)]\n    pub fn div_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(self.as_secs_f64() / rhs)\n    }\n\n    #[effects()]\n    pub fn div_duration_f64(self, rhs: Duration) -> f64 {\n        self.as_secs_f64() / rhs.as_secs_f64()\n    }\n}\n\nimpl Add for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when adding durations\"),\n        }\n    }\n}\n\nimpl AddAssign for Duration {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, rhs: Duration) {\n        *self = *self + rhs;\n    }\n}\n\n");
    buf_str(out, c"impl Sub for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when subtracting durations\"),\n        }\n    }\n}\n\nimpl SubAssign for Duration {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, rhs: Duration) {\n        *self = *self - rhs;\n    }\n}\n\n// mvs: Duration::mul_u32\nimpl Mul<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when multiplying duration by scalar\"),\n        }\n    }\n}\n\nimpl MulAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn mul_assign(&mut self, rhs: u32) {\n        *self = *self * rhs;\n    }\n}\n\n// mvs: Duration::div_u32\nimpl Div<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn div(self, rhs: u32) -> Duration {\n        match self.checked_div(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\n                \"divide by zero error when dividing duration by scalar\"),\n        }\n    }\n}\n\nimpl DivAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn div_assign(&mut self, rhs: u32) {\n        *self = *self / rhs;\n    }\n}\n\n// Rust's form: `1.5s`, `100ms`, `2.000001ms`, `7µs`, `9ns`, the\n// fraction's trailing zeros dropped (or `{:.N?}` digits, rounded half\n// up), padded to the width.\nimpl Debug for Duration {\n    #[effects(unsafe)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.secs > 0 {\n            fmt_decimal(f, self.secs, self.nanos, NANOS_PER_SEC / 10, \"s\")\n        } else if self.nanos >= NANOS_PER_MILLI {\n");
    buf_str(out, c"            fmt_decimal(f, (self.nanos / NANOS_PER_MILLI) as u64, self.nanos % NANOS_PER_MILLI,\n                NANOS_PER_MILLI / 10, \"ms\")\n        } else if self.nanos >= NANOS_PER_MICRO {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MICRO) as u64, self.nanos % NANOS_PER_MICRO,\n                NANOS_PER_MICRO / 10, \"µs\")\n        } else {\n            fmt_decimal(f, self.nanos as u64, 0, 1, \"ns\")\n        }\n    }\n}\n\n// integer.fraction then suffix: fraction's digits from divisor down, at\n// most the precision's (9 without one, its trailing zeros dropped).\n#[effects(unsafe)]\nfn fmt_decimal(f: &mut Formatter<'_>, integer: u64, fraction: u32, divisor: u32, suffix: &str)\n    -> crate::fmt::Result {\n    let mut digits = [b'0'; 9];\n    let wanted = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => 9,\n    };\n    let mut frac = fraction;\n    let mut div = divisor;\n    let mut pos: usize = 0;\n    while frac > 0 && pos < wanted && div > 0 {\n        digits[pos] = b'0' + (frac / div) as u8;\n        frac = frac % div;\n        div = div / 10;\n        pos += 1;\n    }\n    let mut int_part = integer;\n    // (rounding half up what is left)\n    if frac > 0 && div > 0 && frac >= div * 5 {\n        let mut carry = true;\n        let mut k = pos;\n        while carry && k > 0 {\n            k -= 1;\n            if digits[k] == b'9' {\n                digits[k] = b'0';\n            } else {\n                digits[k] += 1;\n                carry = false;\n            }\n        }\n        if carry {\n            int_part = int_part.saturating_add(1);\n        }\n    }\n    let shown = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => pos,\n    };\n    let mut out = [0u8; 48];\n    let mut n: usize = 0;\n    let mut int_digits = [0u8; 20];\n    let mut m: usize = 0;\n    let mut v = int_part;\n    if v == 0 {\n        int_digits[0] = b'0';\n");
    buf_str(out, c"        m = 1;\n    }\n    while v > 0 {\n        int_digits[m] = b'0' + (v % 10) as u8;\n        v = v / 10;\n        m += 1;\n    }\n    while m > 0 {\n        m -= 1;\n        out[n] = int_digits[m];\n        n += 1;\n    }\n    if shown > 0 {\n        out[n] = b'.';\n        n += 1;\n        for k in 0..shown {\n            out[n] = digits[k];\n            n += 1;\n        }\n    }\n    for b in suffix.as_bytes() {\n        out[n] = *b;\n        n += 1;\n    }\n    // UNSAFE: the bytes written above are ASCII digits, '.', and suffix's\n    // UTF-8 bytes copied whole.\n    // SAFETY: each is a whole UTF-8 sequence, so out[..n] is UTF-8.\n    let text = unsafe { crate::str::from_utf8_unchecked(&out[..n]) };\n    // (the width pads it, left-aligned by default, as Rust's; the\n    // precision was the fraction's, so not Formatter::pad, which would cut\n    // the text to it)\n    let chars = text.chars().count();\n    let w = match f.width() {\n        Option::Some(w) => w,\n        Option::None => 0,\n    };\n    if w <= chars {\n        return f.write_str(text);\n    }\n    let gap = w - chars;\n    let (before, after): (usize, usize) = match f.align() {\n        Option::Some(crate::fmt::Alignment::Right) => (gap, 0),\n        Option::Some(crate::fmt::Alignment::Center) => (gap / 2, gap - gap / 2),\n        _ => (0, gap),\n    };\n    let fill = f.fill();\n    for _ in 0..before {\n        f.write_char(fill)?;\n    }\n    f.write_str(text)?;\n    for _ in 0..after {\n        f.write_char(fill)?;\n    }\n    crate::fmt::Result::Ok(())\n}\n\n// Duration::try_from_secs_f64's error: the float was negative, not finite\n// or too large.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct TryFromFloatSecsError {\n    negative: bool,\n}\n\nimpl Display for TryFromFloatSecsError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.negative {\n");
    buf_str(out, c"            f.write_str(\"cannot convert float seconds to Duration: value is negative\")\n        } else {\n            f.write_str(\"cannot convert float seconds to Duration: value is either too big or NaN\")\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: time.h's prototype (struct timespec, two 64-bit\n// fields on the 64-bit targets, is an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    fn c_clock_gettime(clock: i32, tp: *mut i64) -> i32;\n}\n\n// Clock clock's now, a Duration since its start.\nfn clock_now(clock: i32) -> Duration {\n    let mut ts = [0i64; 2];\n    // UNSAFE: C's clock_gettime.\n    // SAFETY: ts is a writable timespec (two i64s); clock is a valid id\n    // (the target's, std::__sys), so the call cannot fail.\n    unsafe {\n        c_clock_gettime(clock, &mut ts[0] as *mut i64);\n    }\n    Duration { secs: ts[0] as u64, nanos: ts[1] as u32 }\n}\n\n// A reading of the monotonic clock, Rust's std::time::Instant: only its\n// differences mean anything.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct Instant {\n    t: Duration,\n}\n\nimpl Instant {\n    // mvs: monotonic_now\n    #[effects(io)]\n    pub fn now() -> Instant {\n        Instant { t: clock_now(crate::__sys::CLOCK_MONOTONIC) }\n    }\n\n    // The time since earlier (zero when earlier is later, as Rust's).\n    #[effects()]\n    pub fn duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {\n        self.t.checked_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects(io)]\n    pub fn elapsed(&self) -> Duration {\n        Instant::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<Instant> {\n");
    buf_str(out, c"        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> Instant {\n        Instant { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> Instant {\n        Instant { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Sub<Instant> for Instant {\n    type Output = Duration;\n    #[effects()]\n    fn sub(self, earlier: Instant) -> Duration {\n        self.duration_since(earlier)\n    }\n}\n\nimpl Debug for Instant {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Instant\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// A reading of the wall clock, Rust's std::time::SystemTime: the time\n// since UNIX_EPOCH (not before it here).\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct SystemTime {\n    t: Duration,\n}\n\n// 1970-01-01 00:00:00 UTC.\n// std2: changed: a static (Rust's is a constant: a constant of a struct\n// type waits for const evaluation)\npub static UNIX_EPOCH: SystemTime = SystemTime { t: Duration { secs: 0, nanos: 0 } };\n\n");
    buf_str(out, c"impl SystemTime {\n    // mvs: clock_now\n    #[effects(io)]\n    pub fn now() -> SystemTime {\n        SystemTime { t: clock_now(0) }\n    }\n\n    // The time since earlier, or how much later earlier is.\n    #[effects(panic, diverge)]\n    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {\n        match self.t.checked_sub(earlier.t) {\n            Option::Some(d) => Result::Ok(d),\n            Option::None => Result::Err(SystemTimeError(earlier.t - self.t)),\n        }\n    }\n\n    #[effects(io, panic, diverge)]\n    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {\n        SystemTime::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Debug for SystemTime {\n    #[effects()]\n");
    buf_str(out, c"    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"SystemTime\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// SystemTime::duration_since's error: how much later the other time is.\n#[derive(Clone, Copy, Debug)]\npub struct SystemTimeError(Duration);\n\nimpl SystemTimeError {\n    #[effects()]\n    pub fn duration(&self) -> Duration {\n        self.0\n    }\n}\n\nimpl Display for SystemTimeError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"second time provided was later than self\")\n    }\n}\n// ---- end mod std::time ----\n}\n// ---- mod std::sync ----\npub mod sync {\n// EDITION: rust\n// std::sync: what threads share: the atomics, Mutex, RwLock, Condvar, Once,\n// Arc and the channels (std::sync::mpsc), Rust's API. A lock is a 32-bit\n// word the waiters sleep on (futex on Linux, __ulock on macOS:\n// std::__sys's futex_wait and futex_wake).\n//\n// There is no poisoning: a panic ends the program (no unwinding), so a\n// lock is never left held by a thread that panicked. `lock()` still returns\n// Rust's LockResult, always Ok, so `m.lock().unwrap()` reads as in Rust.\n// mvs: std::sync\n\npub mod atomic;\npub mod mpsc;\nmod arc;\nmod rwlock;\n\nuse crate::cell::UnsafeCell;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::ops::{Deref, DerefMut, Drop};\nuse crate::result::Result;\nuse crate::sync::atomic::{AtomicU32, Ordering};\n\npub use arc::Arc;\npub use rwlock::{RwLock, RwLockReadGuard, RwLockWriteGuard};\n\n// The lock under Mutex: a word, 0 unlocked, 1 locked, 2 locked with\n// waiters (U. Drepper, \"Futexes are tricky\", mutex 3). Acquire on lock,\n// release on unlock.\npub(crate) struct RawLock {\n    state: AtomicU32,\n}\n\nimpl RawLock {\n    #[effects()]\n    pub(crate) fn new() -> RawLock {\n        RawLock { state: AtomicU32::new(0) }\n    }\n\n");
    buf_str(out, c"    // Waits until the lock is free, and takes it.\n    #[effects(io, sync, panic, diverge)]\n    pub(crate) fn lock(&self) {\n        if self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_err() {\n            self.lock_contended();\n        }\n    }\n\n    // Takes the lock when it is free; whether it did.\n    #[effects(io, sync, panic, diverge)]\n    pub(crate) fn try_lock(&self) -> bool {\n        self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_ok()\n    }\n\n    fn lock_contended(&self) {\n        // A short spin first: the holder may be about to let go.\n        for _ in 0..100 {\n            if self.state.load(Ordering::Relaxed) == 0\n                && self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Relaxed).is_ok() {\n                return;\n            }\n        }\n        while self.state.swap(2, Ordering::Acquire) != 0 {\n            // UNSAFE: the system sleeps on a raw address.\n            // SAFETY: the address is self.state's, a live AtomicU32 (4\n            // bytes, aligned) for the whole call: self is borrowed.\n            unsafe { crate::__sys::futex_wait(self.state.as_ptr(), 2) };\n        }\n    }\n\n    // Lets the lock go (the caller holds it), waking a waiter.\n    #[effects(sync, unsafe)]\n    pub(crate) fn unlock(&self) {\n        if self.state.swap(0, Ordering::Release) == 2 {\n            // UNSAFE: the system wakes the sleepers on a raw address.\n            // SAFETY: the address is self.state's, live while self is\n            // borrowed; nothing is read through it.\n            unsafe { crate::__sys::futex_wake(self.state.as_ptr(), false) };\n        }\n    }\n}\n\n// Rust's error of a lock whose holder panicked. A panic ends the program\n// here, so no lock ever returns it: it is there for Rust's signatures.\npub struct PoisonError<T> {\n    data: T,\n}\n\nimpl<T> PoisonError<T> {\n    pub fn new(data: T) -> PoisonError<T> {\n        PoisonError { data: data }\n");
    buf_str(out, c"    }\n\n    // The guard (or the data) the error holds.\n    #[effects()]\n    pub fn into_inner(self) -> T {\n        self.data\n    }\n\n    pub fn get_ref(&self) -> &T {\n        &self.data\n    }\n\n    pub fn get_mut(&mut self) -> &mut T {\n        &mut self.data\n    }\n}\n\nimpl<T> Debug for PoisonError<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"PoisonError { .. }\")\n    }\n}\n\nimpl<T> Display for PoisonError<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"poisoned lock: another task failed inside\")\n    }\n}\n\n// try_lock's error: the lock is held (WouldBlock); Poisoned never happens\n// (see PoisonError).\npub enum TryLockError<T> {\n    Poisoned(PoisonError<T>),\n    WouldBlock,\n}\n\nimpl<T> Debug for TryLockError<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self {\n            TryLockError::Poisoned(_) => f.write_str(\"Poisoned(..)\"),\n            TryLockError::WouldBlock => f.write_str(\"WouldBlock\"),\n        }\n    }\n}\n\nimpl<T> Display for TryLockError<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self {\n            TryLockError::Poisoned(_) => f.write_str(\"poisoned lock: another task failed inside\"),\n            TryLockError::WouldBlock => {\n                f.write_str(\"try_lock failed because the operation would block\")\n            }\n        }\n    }\n}\n\n// What lock() returns: always Ok here.\npub type LockResult<T> = Result<T, PoisonError<T>>;\n\n// What try_lock() returns: Err(WouldBlock) when the lock is held.\npub type TryLockResult<T> = Result<T, TryLockError<T>>;\n\n// Data behind a lock: only the thread holding it reaches the data. `lock`\n// waits for the lock and gives a guard, through which the data is read and\n// written (`*g`); dropping the guard unlocks.\n//\n//     let m = Mutex::new(0);\n//     *m.lock().unwrap() += 1;\n");
    buf_str(out, c"// std2: changed: Rust's guard API (MVS: with, try_with, an unsafe lock)\npub struct Mutex<T> {\n    raw: RawLock,\n    data: UnsafeCell<T>,\n}\n\n// UNSAFE: a Mutex holds an UnsafeCell, which is not Sync: stated, as Rust's.\n// SAFETY: the data is reached only through a guard, which exists only\n// while its thread holds the lock, or through `&mut self` and `self`: one\n// thread at a time, so sharing the Mutex shares a T between threads the\n// way moving it would (T: Send).\nunsafe impl<T: Send> Sync for Mutex<T> {}\n// UNSAFE: stated with Sync, as Rust's.\n// SAFETY: moving a Mutex moves its T (T: Send); the lock word is an atomic.\nunsafe impl<T: Send> Send for Mutex<T> {}\n\nimpl<T> Mutex<T> {\n    #[effects(T)]\n    pub fn new(v: T) -> Mutex<T> {\n        Mutex { raw: RawLock::new(), data: UnsafeCell::new(v) }\n    }\n\n    // Waits for the lock; the guard unlocks when it is dropped.\n    #[effects(io, sync, panic, diverge)]\n    pub fn lock(&self) -> LockResult<MutexGuard<'_, T>> {\n        self.raw.lock();\n        Result::Ok(MutexGuard { lock: self })\n    }\n\n    // The guard when the lock is free now, else Err(WouldBlock).\n    #[effects(io, sync, panic, diverge)]\n    pub fn try_lock(&self) -> TryLockResult<MutexGuard<'_, T>> {\n        if self.raw.try_lock() {\n            Result::Ok(MutexGuard { lock: self })\n        } else {\n            Result::Err(TryLockError::WouldBlock)\n        }\n    }\n\n    // Always false: there is no poisoning.\n    #[effects()]\n    pub fn is_poisoned(&self) -> bool {\n        false\n    }\n\n    // The data, when nothing else can reach the mutex.\n    #[effects(T)]\n    pub fn into_inner(self) -> LockResult<T> {\n        Result::Ok(self.data.into_inner())\n    }\n\n    // The data, through the unique borrow (no locking needed).\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> LockResult<&mut T> {\n        Result::Ok(self.data.get_mut())\n    }\n}\n\nimpl<T: Debug> Debug for Mutex<T> {\n");
    buf_str(out, c"    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.try_lock() {\n            Result::Ok(g) => {\n                f.write_str(\"Mutex { data: \")?;\n                Debug::fmt(g.deref(), f)?;\n                f.write_str(\", poisoned: false, .. }\")\n            }\n            Result::Err(_) => f.write_str(\"Mutex { data: <locked>, poisoned: false, .. }\"),\n        }\n    }\n}\n\n// A held lock (Mutex::lock): the data through `*g`; dropping it unlocks.\n// It stays on the thread that locked.\npub struct MutexGuard<'a, T> {\n    lock: &'a Mutex<T>,\n}\n\n// The lock is let go by the thread that took it (stated, as Rust's).\nimpl<'a, T> !Send for MutexGuard<'a, T> {}\n\nimpl<'a, T> Deref for MutexGuard<'a, T> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        // UNSAFE: the data is behind the Mutex's UnsafeCell, a raw pointer.\n        // SAFETY: a guard exists only while its thread holds the lock, so\n        // nothing else reaches the data; the & lives no longer than the\n        // guard's borrow.\n        unsafe { &*self.lock.data.get() }\n    }\n}\n\nimpl<'a, T> DerefMut for MutexGuard<'a, T> {\n    fn deref_mut(&mut self) -> &mut T {\n        // UNSAFE: as deref's.\n        // SAFETY: as deref's, and `&mut self` makes this the guard's one\n        // access.\n        unsafe { &mut *self.lock.data.get() }\n    }\n}\n\nimpl<'a, T> Drop for MutexGuard<'a, T> {\n    fn drop(&mut self) {\n        self.lock.raw.unlock();\n    }\n}\n\nimpl<'a, T: Debug> Debug for MutexGuard<'a, T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.deref(), f)\n    }\n}\n\nimpl<'a, T: Display> Display for MutexGuard<'a, T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.deref(), f)\n    }\n}\n\n// Waiting for a change of a Mutex's data: `wait(guard)` unlocks, sleeps\n// until a notify and locks again; a thread that changes the data notifies\n");
    buf_str(out, c"// (`notify_one`, `notify_all`). A wait may wake with no notify: test the\n// condition in a loop, or use wait_while.\n//\n//     let mut g = m.lock().unwrap();\n//     while !*g {\n//         g = cv.wait(g).unwrap();\n//     }\n// std2: changed: Rust's wait and wait_while (MVS: wait_then)\npub struct Condvar {\n    // Bumped by each notify: a waiter sleeps while it has not changed.\n    seq: AtomicU32,\n}\n\nimpl Condvar {\n    #[effects()]\n    pub fn new() -> Condvar {\n        Condvar { seq: AtomicU32::new(0) }\n    }\n\n    // Unlocks guard's mutex, sleeps until notified, locks again.\n    #[effects(io, sync, panic, diverge, unsafe, T)]\n    pub fn wait<'a, T>(&self, guard: MutexGuard<'a, T>) -> LockResult<MutexGuard<'a, T>> {\n        let m: &'a Mutex<T> = guard.lock;\n        // (read under the lock: a notify after this changes it, and the\n        // sleep below returns at once)\n        let seen = self.seq.load(Ordering::Acquire);\n        crate::mem::drop(guard);\n        // UNSAFE: the system sleeps on a raw address.\n        // SAFETY: the address is self.seq's, a live AtomicU32 while self\n        // is borrowed.\n        unsafe { crate::__sys::futex_wait(self.seq.as_ptr(), seen) };\n        m.raw.lock();\n        Result::Ok(MutexGuard { lock: m })\n    }\n\n    // wait, again while condition(data) holds.\n    #[effects(diverge, T, F)]\n    pub fn wait_while<'a, T, F: FnMut(&mut T) -> bool>(&self, guard: MutexGuard<'a, T>,\n        condition: F) -> LockResult<MutexGuard<'a, T>> {\n        let mut cond = condition;\n        let mut g = guard;\n        while cond(g.deref_mut()) {\n            g = match self.wait(g) {\n                Result::Ok(next) => next,\n                Result::Err(e) => return Result::Err(e),\n            };\n        }\n        Result::Ok(g)\n    }\n\n    // Wakes one waiting thread.\n    #[effects(sync, unsafe)]\n    pub fn notify_one(&self) {\n        self.seq.fetch_add(1, Ordering::Release);\n");
    buf_str(out, c"        // UNSAFE: the system wakes a sleeper on a raw address.\n        // SAFETY: the address is self.seq's, live while self is borrowed.\n        unsafe { crate::__sys::futex_wake(self.seq.as_ptr(), false) };\n    }\n\n    // Wakes every waiting thread.\n    #[effects(sync, unsafe)]\n    pub fn notify_all(&self) {\n        self.seq.fetch_add(1, Ordering::Release);\n        // UNSAFE: as notify_one's.\n        // SAFETY: as notify_one's.\n        unsafe { crate::__sys::futex_wake(self.seq.as_ptr(), true) };\n    }\n}\n\nimpl Debug for Condvar {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"Condvar { .. }\")\n    }\n}\n\n// Runs a function once, whatever the threads calling it (`static INIT:\n// Once = Once::new();`). The first call_once runs f; the others wait until\n// it is done.\npub struct Once {\n    // 0: not run, 1: running, 2: done.\n    state: AtomicU32,\n}\n\nimpl Once {\n    #[effects()]\n    pub fn new() -> Once {\n        Once { state: AtomicU32::new(0) }\n    }\n\n    // Runs f unless a call_once of this Once ran (or is running) already;\n    // returns when it is done.\n    // std2: changed: FnOnce (MVS: FnMut)\n    #[effects(io, sync, panic, diverge, unsafe, F)]\n    pub fn call_once<F: FnOnce()>(&self, f: F) {\n        if self.state.load(Ordering::Acquire) == 2 {\n            return;\n        }\n        if self.state.compare_exchange(0, 1, Ordering::Acquire, Ordering::Acquire).is_ok() {\n            f();\n            self.state.store(2, Ordering::Release);\n            // UNSAFE: the system wakes the sleepers on a raw address.\n            // SAFETY: the address is self.state's, live while self is\n            // borrowed.\n            unsafe { crate::__sys::futex_wake(self.state.as_ptr(), true) };\n            return;\n        }\n        while self.state.load(Ordering::Acquire) != 2 {\n            // UNSAFE: the system sleeps on a raw address.\n");
    buf_str(out, c"            // SAFETY: as above; it sleeps only while the word is 1.\n            unsafe { crate::__sys::futex_wait(self.state.as_ptr(), 1) };\n        }\n    }\n\n    // Whether a call_once has finished.\n    #[effects(io, sync, panic, diverge)]\n    pub fn is_completed(&self) -> bool {\n        self.state.load(Ordering::Acquire) == 2\n    }\n}\n\nimpl Debug for Once {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"Once { .. }\")\n    }\n}\n// ---- mod std::sync::atomic ----\npub mod atomic {\n// EDITION: rust\n// std::sync::atomic: values that threads read and write at once without a\n// data race, and the memory orderings (Rust's; C++20's model). AtomicI64\n// and the others are Atomic<T> for their T, an integer, bool or a raw\n// pointer: one access of 1 to 8 bytes (the compiler implements the sealed\n// AtomicValue, AtomicBitwise and AtomicInteger for exactly those types,\n// front/traits.vl: atomic_bound). Integers wrap.\n//\n//     static HITS: AtomicUsize = AtomicUsize::new(0);\n//     HITS.fetch_add(1, Ordering::Relaxed);\n// mvs: std::sync::atomic\n\nuse crate::cell::UnsafeCell;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::result::Result;\n\n// The ordering of an atomic operation (Rust's, without Consume).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum Ordering {\n    Relaxed,\n    Release,\n    Acquire,\n    AcqRel,\n    SeqCst,\n}\n\n// The intrinsics the compiler lowers by name to its atomic instructions\n// (middle/lower/atomic.vl, as MVS's std::sync::atomic): `order` is 0\n// Relaxed, 1 Acquire, 2 Release, 3 AcqRel, 4 SeqCst, a literal after\n// inlining (else SeqCst); their bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid and aligned for T, T one the\n// AtomicValue bound admits, and *p reached only through atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n");
    buf_str(out, c"    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_swap<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The old value; *p becomes `new` when it was `expected`.\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_add<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_and<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_nand<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_or<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_xor<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (signed or unsigned as T is)\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_max<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_min<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (no pointer, no memory touched)\nfn atomic_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\nfn atomic_compiler_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\n");
    buf_str(out, c"// The one ordering of a compare-exchange, at least as strong as both.\nfn cas_order(success: Ordering, failure: Ordering) -> i64 {\n    if failure == Ordering::Release || failure == Ordering::AcqRel {\n        crate::panic::panic(\"there is no such thing as a release failure ordering\");\n    }\n    let s: i64 = match success {\n        Ordering::Relaxed => 0,\n        Ordering::Acquire => 1,\n        Ordering::Release => 2,\n        Ordering::AcqRel => 3,\n        Ordering::SeqCst => 4,\n    };\n    if s == 4 || failure == Ordering::SeqCst {\n        return 4;\n    }\n    if failure == Ordering::Acquire && (s == 0 || s == 2) {\n        return if s == 0 { 1 } else { 3 };\n    }\n    s\n}\n\n// What an Atomic holds: the integers, bool and the raw pointers (the\n// compiler's, sealed: Sealed is private).\npub trait AtomicValue: Copy + PartialEq {\n    fn sealed_value(self) -> Sealed;\n}\n\n// The integers and bool: fetch_and, fetch_or, fetch_xor, fetch_nand.\npub trait AtomicBitwise {\n    fn sealed_bitwise(self) -> Sealed;\n}\n\n// The integers: fetch_add, fetch_sub, fetch_max, fetch_min.\npub trait AtomicInteger {\n    fn sealed_integer(self) -> Sealed;\n}\n\npub struct Sealed {}\n\n// A T that threads share: read and written only through its methods.\n// std2: new: Rust's AtomicI64, AtomicBool, .. are its aliases\npub struct Atomic<T: AtomicValue> {\n    v: UnsafeCell<T>,\n}\n\npub type AtomicI8 = Atomic<i8>;\npub type AtomicI16 = Atomic<i16>;\npub type AtomicI32 = Atomic<i32>;\npub type AtomicI64 = Atomic<i64>;\npub type AtomicIsize = Atomic<isize>;\npub type AtomicU8 = Atomic<u8>;\npub type AtomicU16 = Atomic<u16>;\npub type AtomicU32 = Atomic<u32>;\npub type AtomicU64 = Atomic<u64>;\npub type AtomicUsize = Atomic<usize>;\npub type AtomicBool = Atomic<bool>;\npub type AtomicPtr<T> = Atomic<*mut T>;\n\n// UNSAFE: an Atomic holds an UnsafeCell, which is not Sync: stated, as\n// Rust's atomics state it.\n");
    buf_str(out, c"// SAFETY: every access of v is atomic (its methods), so sharing an Atomic\n// between threads races on nothing; T is Copy, with no drop.\nunsafe impl<T: AtomicValue> Sync for Atomic<T> {}\n// UNSAFE: stated with Sync, as Rust's.\n// SAFETY: T is an integer, bool or a raw pointer, moved as its bits.\nunsafe impl<T: AtomicValue> Send for Atomic<T> {}\n\n// Each `unsafe` below: an intrinsic on self.v.get(), valid and aligned for\n// T, which is reached only through them (an Atomic is not Copy).\nimpl<T: AtomicValue> Atomic<T> {\n    #[effects(T)]\n    pub fn new(v: T) -> Atomic<T> {\n        Atomic { v: UnsafeCell::new(v) }\n    }\n\n    // The value, when nothing else can reach the atomic.\n    #[effects(unsafe, T)]\n    pub fn into_inner(self) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe { atomic_load(self.v.get() as *const T, 0) }\n    }\n\n    // The value, through the unique borrow (no atomic needed).\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> &mut T {\n        self.v.get_mut()\n    }\n\n    // The value's address (an access through it must not race with the\n    // atomic ones).\n    #[effects()]\n    pub fn as_ptr(&self) -> *mut T {\n        self.v.get()\n    }\n\n    // Panics on Release and AcqRel, as Rust's.\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn load(&self, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_load(self.v.get() as *const T, 0),\n                Ordering::Acquire => atomic_load(self.v.get() as *const T, 1),\n                Ordering::SeqCst => atomic_load(self.v.get() as *const T, 4),\n                Ordering::Release => crate::panic::panic(\n                    \"there is no such thing as a release load\"),\n                Ordering::AcqRel => crate::panic::panic(\n");
    buf_str(out, c"                    \"there is no such thing as an acquire-release load\"),\n            }\n        }\n    }\n\n    // Panics on Acquire and AcqRel, as Rust's.\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn store(&self, v: T, order: Ordering) {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_store(self.v.get(), v, 0),\n                Ordering::Release => atomic_store(self.v.get(), v, 2),\n                Ordering::SeqCst => atomic_store(self.v.get(), v, 4),\n                Ordering::Acquire => crate::panic::panic(\n                    \"there is no such thing as an acquire store\"),\n                Ordering::AcqRel => crate::panic::panic(\n                    \"there is no such thing as an acquire-release store\"),\n            }\n        }\n    }\n\n    // Stores v; the old value.\n    #[effects(unsafe, T)]\n    pub fn swap(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_swap(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_swap(self.v.get(), v, 1),\n                Ordering::Release => atomic_swap(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_swap(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_swap(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Ok(the old value) when it was `current` (and is now `new`), else\n    // Err(the value found).\n    #[effects(panic, diverge, unsafe, T)]\n    pub fn compare_exchange(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        let order = cas_order(success, failure);\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        let old = unsafe {\n            if order == 0 {\n");
    buf_str(out, c"                atomic_cas(self.v.get(), current, new, 0)\n            } else if order == 1 {\n                atomic_cas(self.v.get(), current, new, 1)\n            } else if order == 2 {\n                atomic_cas(self.v.get(), current, new, 2)\n            } else if order == 3 {\n                atomic_cas(self.v.get(), current, new, 3)\n            } else {\n                atomic_cas(self.v.get(), current, new, 4)\n            }\n        };\n        if old == current { Result::Ok(old) } else { Result::Err(old) }\n    }\n\n    // compare_exchange (it never fails spuriously here).\n    #[effects(T)]\n    pub fn compare_exchange_weak(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        self.compare_exchange(current, new, success, failure)\n    }\n}\n\n// The arithmetic: the integers only (it wraps).\nimpl<T: AtomicValue + AtomicInteger> Atomic<T> {\n    // Adds v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_add(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_add(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_add(self.v.get(), v, 1),\n                Ordering::Release => atomic_add(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_add(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_add(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Subtracts v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_sub(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_sub(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_sub(self.v.get(), v, 1),\n                Ordering::Release => atomic_sub(self.v.get(), v, 2),\n");
    buf_str(out, c"                Ordering::AcqRel => atomic_sub(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_sub(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The larger of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_max(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_max(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_max(self.v.get(), v, 1),\n                Ordering::Release => atomic_max(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_max(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_max(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The smaller of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_min(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_min(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_min(self.v.get(), v, 1),\n                Ordering::Release => atomic_min(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_min(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_min(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\n// The bitwise operations: the integers and bool.\nimpl<T: AtomicValue + AtomicBitwise> Atomic<T> {\n    // The value & v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_and(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_and(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_and(self.v.get(), v, 1),\n");
    buf_str(out, c"                Ordering::Release => atomic_and(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_and(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_and(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // !(the value & v); the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_nand(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_nand(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_nand(self.v.get(), v, 1),\n                Ordering::Release => atomic_nand(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_nand(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_nand(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value | v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_or(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_or(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_or(self.v.get(), v, 1),\n                Ordering::Release => atomic_or(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_or(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_or(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value ^ v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_xor(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_xor(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_xor(self.v.get(), v, 1),\n                Ordering::Release => atomic_xor(self.v.get(), v, 2),\n");
    buf_str(out, c"                Ordering::AcqRel => atomic_xor(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_xor(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\nimpl<T: AtomicValue + Default> Default for Atomic<T> {\n    fn default() -> Atomic<T> {\n        Atomic::new(T::default())\n    }\n}\n\n// The value, read Relaxed (as Rust's).\nimpl<T: AtomicValue + Debug> Debug for Atomic<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.load(Ordering::Relaxed), f)\n    }\n}\n\n// A memory fence: Acquire, Release, AcqRel or SeqCst; panics on Relaxed,\n// as Rust's.\n#[effects(sync, panic, diverge)]\npub fn fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_fence(1),\n        Ordering::Release => atomic_fence(2),\n        Ordering::AcqRel => atomic_fence(3),\n        Ordering::SeqCst => atomic_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\"there is no such thing as a relaxed fence\"),\n    }\n}\n\n// A fence for the compiler only (no instruction): memory accesses are not\n// moved across it. Panics on Relaxed, as Rust's.\n#[effects(sync, panic, diverge)]\npub fn compiler_fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_compiler_fence(1),\n        Ordering::Release => atomic_compiler_fence(2),\n        Ordering::AcqRel => atomic_compiler_fence(3),\n        Ordering::SeqCst => atomic_compiler_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\n            \"there is no such thing as a relaxed compiler fence\"),\n    }\n}\n// ---- end mod std::sync::atomic ----\n}\n// ---- mod std::sync::mpsc ----\npub mod mpsc {\n// EDITION: rust\n// std::sync::mpsc: channels between threads. Values sent through any of a\n// channel's Senders come out of its Receiver in the order they were sent.\n// Rust's API, with the allocator the queue grows from:\n//\n//     let (tx, rx) = mpsc::channel_in(gpa);\n//     tx.send(7).unwrap();\n");
    buf_str(out, c"//     let x = rx.recv().unwrap();\n//\n// `send` fails (giving the value back) when the receiver is gone, `recv`\n// when every sender is gone and nothing is left. The shared state is an\n// Arc of a Mutex and a Condvar: no unsafe code here. The queue is two\n// Vecs (an inbox the senders push to, an outbox the receiver pops,\n// refilled from the inbox reversed).\n// mvs: std::sync::mpsc\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::{IntoIterator, Iterator};\nuse crate::ops::{DerefMut, Drop};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::sync::{Arc, Condvar, Mutex};\nuse crate::sync::atomic::{AtomicBool, AtomicUsize, Ordering};\nuse crate::vec::Vec;\n\nstruct Queue<T, A: Allocator> {\n    inbox: Vec<T, A>,\n    outbox: Vec<T, A>,\n}\n\nimpl<T, A: Allocator> Queue<T, A> {\n    fn pop(&mut self) -> Option<T> {\n        if self.outbox.is_empty() {\n            while let Option::Some(x) = self.inbox.pop() {\n                self.outbox.push(x);\n            }\n        }\n        self.outbox.pop()\n    }\n}\n\nstruct Chan<T, A: Allocator> {\n    queue: Mutex<Queue<T, A>>,\n    // Notified by each send and by the last sender's drop.\n    ready: Condvar,\n    senders: AtomicUsize,\n    receiving: AtomicBool,\n}\n\n// The sending end; clone it for more senders.\npub struct Sender<T, A: Allocator> {\n    chan: Arc<Chan<T, A>, A>,\n}\n\n// The receiving end.\npub struct Receiver<T, A: Allocator> {\n    chan: Arc<Chan<T, A>, A>,\n}\n\n// send's error: the receiver is gone; the value comes back (`e.0`).\n#[derive(PartialEq, Eq, Clone, Copy)]\npub struct SendError<T>(pub T);\n\nimpl<T> Debug for SendError<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"SendError { .. }\")\n    }\n}\n\nimpl<T> Display for SendError<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n");
    buf_str(out, c"        f.write_str(\"sending on a closed channel\")\n    }\n}\n\n// recv's error: every sender is gone and the channel is empty.\n#[derive(PartialEq, Eq, Clone, Copy, Debug)]\npub struct RecvError;\n\nimpl Display for RecvError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"receiving on a closed channel\")\n    }\n}\n\n// try_recv's error: nothing is there now (Empty), or ever will be\n// (Disconnected: every sender is gone).\n// std2: changed: Rust's TryRecvError (MVS: try_recv gave an Option)\n#[derive(PartialEq, Eq, Clone, Copy, Debug)]\npub enum TryRecvError {\n    Empty,\n    Disconnected,\n}\n\nimpl Display for TryRecvError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self {\n            TryRecvError::Empty => f.write_str(\"receiving on an empty channel\"),\n            TryRecvError::Disconnected => {\n                f.write_str(\"receiving on an empty and disconnected channel\")\n            }\n        }\n    }\n}\n\n// A channel; its two ends. The queue and the shared state are on a\n// (Rust's `channel()`).\n// std2: changed: any allocator that is Clone (MVS: Gpa)\n#[effects(T, A)]\npub fn channel_in<T, A: Allocator + Clone>(a: A) -> (Sender<T, A>, Receiver<T, A>) {\n    let chan = Arc::new_in(Chan {\n        queue: Mutex::new(Queue { inbox: Vec::new_in(a.clone()), outbox: Vec::new_in(a.clone()) }),\n        ready: Condvar::new(),\n        senders: AtomicUsize::new(1),\n        receiving: AtomicBool::new(true),\n    }, a);\n    (Sender { chan: chan.clone() }, Receiver { chan: chan })\n}\n\nimpl<T, A: Allocator> Sender<T, A> {\n    // Sends x; Err(x back) when the receiver is gone.\n    #[effects(io, sync, panic, diverge, T, A)]\n    pub fn send(&self, x: T) -> Result<(), SendError<T>> {\n        let mut q = match self.chan.queue.lock() {\n            Result::Ok(g) => g,\n            Result::Err(e) => e.into_inner(),\n        };\n");
    buf_str(out, c"        if !self.chan.receiving.load(Ordering::Relaxed) {\n            return Result::Err(SendError(x));\n        }\n        q.deref_mut().inbox.push(x);\n        crate::mem::drop(q);\n        self.chan.ready.notify_one();\n        Result::Ok(())\n    }\n}\n\nimpl<T, A: Allocator + Clone> Clone for Sender<T, A> {\n    fn clone(&self) -> Sender<T, A> {\n        self.chan.senders.fetch_add(1, Ordering::Relaxed);\n        Sender { chan: self.chan.clone() }\n    }\n}\n\nimpl<T, A: Allocator> Drop for Sender<T, A> {\n    fn drop(&mut self) {\n        if self.chan.senders.fetch_sub(1, Ordering::AcqRel) == 1 {\n            // (the last one: a receiver that waits learns it. Under the\n            // lock, so that it is not between its test and its sleep.)\n            let q = match self.chan.queue.lock() {\n                Result::Ok(g) => g,\n                Result::Err(e) => e.into_inner(),\n            };\n            crate::mem::drop(q);\n            self.chan.ready.notify_all();\n        }\n    }\n}\n\nimpl<T, A: Allocator> Debug for Sender<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"Sender { .. }\")\n    }\n}\n\nimpl<T, A: Allocator> Receiver<T, A> {\n    // The next value, waiting for one; Err when every sender is gone and\n    // nothing is left.\n    #[effects(io, sync, panic, diverge, T, A)]\n    pub fn recv(&self) -> Result<T, RecvError> {\n        let mut q = match self.chan.queue.lock() {\n            Result::Ok(g) => g,\n            Result::Err(e) => e.into_inner(),\n        };\n        loop {\n            match q.deref_mut().pop() {\n                Option::Some(x) => return Result::Ok(x),\n                Option::None => {}\n            }\n            if self.chan.senders.load(Ordering::Acquire) == 0 {\n                return Result::Err(RecvError);\n            }\n            q = match self.chan.ready.wait(q) {\n                Result::Ok(g) => g,\n                Result::Err(e) => e.into_inner(),\n");
    buf_str(out, c"            };\n        }\n    }\n\n    // The next value if there is one now.\n    #[effects(io, sync, panic, diverge, T, A)]\n    pub fn try_recv(&self) -> Result<T, TryRecvError> {\n        let mut q = match self.chan.queue.lock() {\n            Result::Ok(g) => g,\n            Result::Err(e) => e.into_inner(),\n        };\n        match q.deref_mut().pop() {\n            Option::Some(x) => Result::Ok(x),\n            Option::None => {\n                if self.chan.senders.load(Ordering::Acquire) == 0 {\n                    Result::Err(TryRecvError::Disconnected)\n                } else {\n                    Result::Err(TryRecvError::Empty)\n                }\n            }\n        }\n    }\n\n    // The values, until every sender is gone: `for x in rx.iter()`.\n    #[effects()]\n    pub fn iter(&self) -> RecvIter<'_, T, A> {\n        RecvIter { rx: self }\n    }\n\n    // The values that are there now, without waiting.\n    #[effects()]\n    pub fn try_iter(&self) -> TryIter<'_, T, A> {\n        TryIter { rx: self }\n    }\n}\n\nimpl<T, A: Allocator> Drop for Receiver<T, A> {\n    fn drop(&mut self) {\n        let q = match self.chan.queue.lock() {\n            Result::Ok(g) => g,\n            Result::Err(e) => e.into_inner(),\n        };\n        self.chan.receiving.store(false, Ordering::Relaxed);\n        crate::mem::drop(q);\n    }\n}\n\nimpl<T, A: Allocator> Debug for Receiver<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"Receiver { .. }\")\n    }\n}\n\n// Receiver::iter's iterator: recv until it fails. (Rust's mpsc::Iter; it\n// keeps the old std's name, and RecvIntoIter its like: the lazy std reads\n// items by name, and an `Iter` or `IntoIter` here would bring the channels\n// into every program that names a slice's.)\n// std2: changed: its name (Rust: mpsc::Iter)\npub struct RecvIter<'a, T, A: Allocator> {\n    rx: &'a Receiver<T, A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for RecvIter<'a, T, A> {\n");
    buf_str(out, c"    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        match self.rx.recv() {\n            Result::Ok(x) => Option::Some(x),\n            Result::Err(_) => Option::None,\n        }\n    }\n}\n\n// Receiver::try_iter's iterator: try_recv until it fails.\npub struct TryIter<'a, T, A: Allocator> {\n    rx: &'a Receiver<T, A>,\n}\n\nimpl<'a, T, A: Allocator> Iterator for TryIter<'a, T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        match self.rx.try_recv() {\n            Result::Ok(x) => Option::Some(x),\n            Result::Err(_) => Option::None,\n        }\n    }\n}\n\n// `for x in rx`: the Receiver's values, the Receiver owned.\npub struct RecvIntoIter<T, A: Allocator> {\n    rx: Receiver<T, A>,\n}\n\nimpl<T, A: Allocator> Iterator for RecvIntoIter<T, A> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        match self.rx.recv() {\n            Result::Ok(x) => Option::Some(x),\n            Result::Err(_) => Option::None,\n        }\n    }\n}\n\nimpl<T, A: Allocator> IntoIterator for Receiver<T, A> {\n    type Item = T;\n    type IntoIter = RecvIntoIter<T, A>;\n\n    fn into_iter(self) -> RecvIntoIter<T, A> {\n        RecvIntoIter { rx: self }\n    }\n}\n\nimpl<'a, T, A: Allocator> IntoIterator for &'a Receiver<T, A> {\n    type Item = T;\n    type IntoIter = RecvIter<'a, T, A>;\n\n    fn into_iter(self) -> RecvIter<'a, T, A> {\n        RecvIter { rx: self }\n    }\n}\n// ---- end mod std::sync::mpsc ----\n}\n// ---- mod std::sync::arc ----\nmod arc {\n// EDITION: rust\n// std::sync::Arc: a value several owners share, across threads: an atomic\n// count of the owners beside the value, in one block of the allocator\n// given (`Arc::new_in(x, a)`; Rust's `Arc::new(x)`); the last owner\n// dropped drops the value and frees the block. `clone` makes another\n// owner. The value is shared, so it is read-only (`*arc`): put a Mutex or\n// an atomic inside to change it. There is no Weak: a cycle of Arcs is\n");
    buf_str(out, c"// never freed.\n\nuse crate::alloc::{Allocator, Layout};\nuse crate::borrow::Borrow;\nuse crate::boxed::Box;\nuse crate::clone::Clone;\nuse crate::cmp::{Eq, Ord, PartialEq, PartialOrd};\nuse crate::cmp::Ordering as CmpOrdering;\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::ops::{Deref, Drop};\nuse crate::option::Option;\nuse crate::ptr::NonNull;\nuse crate::result::Result;\nuse crate::sync::atomic::{AtomicUsize, Ordering, fence};\n\n// What the owners share: how many they are, and the value.\nstruct ArcInner<T> {\n    strong: AtomicUsize,\n    data: T,\n}\n\n// An owner of a shared T on A.\npub struct Arc<T, A: Allocator> {\n    ptr: NonNull<ArcInner<T>>,\n    alloc: A,\n}\n\n// UNSAFE: an Arc's pointer is a NonNull (neither Send nor Sync): stated, as\n// Rust's.\n// SAFETY: an Arc sent to another thread lets it read the T (T: Sync) and,\n// as the last owner, drop it there (T: Send); the count is an atomic; the\n// allocator goes with the Arc (A: Send).\nunsafe impl<T: Send + Sync, A: Allocator + Send> Send for Arc<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&Arc` gives `&T` (T: Sync) and can be cloned into another\n// owner on that thread (T: Send, and the clone reads the allocator: A:\n// Sync).\nunsafe impl<T: Send + Sync, A: Allocator + Sync> Sync for Arc<T, A> {}\n\nimpl<T, A: Allocator> Arc<T, A> {\n    // x moved to a block of a, with one owner; out of memory panics.\n    #[effects(io, panic, diverge, T, A)]\n    pub fn new_in(x: T, a: A) -> Arc<T, A> {\n        let b = Box::new_in(ArcInner { strong: AtomicUsize::new(1), data: x }, a);\n        let (p, a) = Box::into_raw_with_allocator(b);\n        match NonNull::new(p) {\n            Option::Some(ptr) => Arc { ptr: ptr, alloc: a },\n            Option::None => crate::panic::unreachable(),\n        }\n    }\n\n    fn inner(&self) -> &ArcInner<T> {\n        // UNSAFE: the shared block through the Arc's raw pointer.\n");
    buf_str(out, c"        // SAFETY: this owner is counted, so the block is live and holds\n        // an initialized ArcInner until the Arc is dropped; the & lives no\n        // longer than the Arc's borrow, and the block is only read\n        // through & (the count is an atomic).\n        unsafe { self.ptr.as_ref() }\n    }\n\n    // How many owners the value has now.\n    #[effects(io, sync, panic, diverge, T, A)]\n    pub fn strong_count(this: &Arc<T, A>) -> usize {\n        this.inner().strong.load(Ordering::Relaxed)\n    }\n\n    // The value's address.\n    pub fn as_ptr(this: &Arc<T, A>) -> *const T {\n        &this.inner().data as *const T\n    }\n\n    // Whether the two own the same value (the same block).\n    #[effects(T)]\n    pub fn ptr_eq(this: &Arc<T, A>, other: &Arc<T, A>) -> bool {\n        this.ptr.as_ptr() == other.ptr.as_ptr()\n    }\n\n    // The value, to change, when this is its only owner.\n    #[effects(io, sync, panic, diverge, unsafe, T, A)]\n    pub fn get_mut(this: &mut Arc<T, A>) -> Option<&mut T> {\n        if this.inner().strong.load(Ordering::Acquire) != 1 {\n            return Option::None;\n        }\n        // UNSAFE: a &mut into the shared block.\n        // SAFETY: the count is 1 and `this` is borrowed mutably, so no\n        // other owner exists and none can be made (a clone needs a & of\n        // this Arc) while the &mut lives.\n        unsafe {\n            let d: *mut T = &mut (*this.ptr.as_ptr()).data;\n            Option::Some(&mut *d)\n        }\n    }\n\n    // The value, moved out, when this is its only owner; else the Arc\n    // back.\n    #[effects(alloc(A), io, sync, panic, diverge, unsafe, T, A)]\n    pub fn try_unwrap(this: Arc<T, A>) -> Result<T, Arc<T, A>> {\n        if this.inner().strong.compare_exchange(1, 0, Ordering::AcqRel, Ordering::Relaxed)\n            .is_err() {\n            return Result::Err(this);\n        }\n        let p = this.ptr.as_ptr();\n        let this_block = this.ptr.cast::<u8>();\n");
    buf_str(out, c"        // UNSAFE: the value and the allocator are moved out bit for bit and\n        // the block is given back.\n        // SAFETY: the count went from 1 to 0, so this was the only owner\n        // and nothing else reaches the block; the Arc is forgotten, so its\n        // Drop does not run: the value is moved out once, the allocator\n        // once (dropped at the end of this function), and the block, which\n        // Box::new_in took from this allocator with this layout, is freed\n        // once.\n        unsafe {\n            let x = crate::ptr::read(&(*p).data as *const T);\n            let a = crate::ptr::read(&this.alloc as *const A);\n            crate::mem::forget(this);\n            a.deallocate(this_block, Layout::new::<ArcInner<T>>());\n            Result::Ok(x)\n        }\n    }\n\n    // The value when this is its only owner (else the Arc is dropped).\n    #[effects(T, A)]\n    pub fn into_inner(this: Arc<T, A>) -> Option<T> {\n        match Arc::try_unwrap(this) {\n            Result::Ok(x) => Option::Some(x),\n            Result::Err(_) => Option::None,\n        }\n    }\n\n    // The allocator its block is from.\n    pub fn allocator(this: &Arc<T, A>) -> &A {\n        &this.alloc\n    }\n}\n\n// Another owner of the same value.\nimpl<T, A: Allocator + Clone> Clone for Arc<T, A> {\n    fn clone(&self) -> Arc<T, A> {\n        // (Relaxed, as Rust's: the new owner comes from a live one)\n        self.inner().strong.fetch_add(1, Ordering::Relaxed);\n        Arc { ptr: self.ptr, alloc: self.alloc.clone() }\n    }\n}\n\nimpl<T, A: Allocator> Deref for Arc<T, A> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        &self.inner().data\n    }\n}\n\nimpl<T, A: Allocator> Drop for Arc<T, A> {\n    fn drop(&mut self) {\n        if self.inner().strong.fetch_sub(1, Ordering::Release) != 1 {\n            return;\n        }\n        // (the last owner: every other owner's use of the value comes\n        // before its drop)\n");
    buf_str(out, c"        fence(Ordering::Acquire);\n        let p = self.ptr.as_ptr();\n        // UNSAFE: drops the value in place and gives the block back.\n        // SAFETY: the count reached 0, so no other owner exists; the block\n        // holds an initialized ArcInner that Box::new_in took from this\n        // allocator with this layout; it is dropped and freed once (an\n        // Arc is dropped once, and only the last one gets here).\n        unsafe {\n            crate::ptr::drop_in_place(p);\n            self.alloc.deallocate(self.ptr.cast::<u8>(), Layout::new::<ArcInner<T>>());\n        }\n    }\n}\n\nimpl<T, A: Allocator> AsRef<T> for Arc<T, A> {\n    fn as_ref(&self) -> &T {\n        self.deref()\n    }\n}\n\nimpl<T, A: Allocator> Borrow<T> for Arc<T, A> {\n    fn borrow(&self) -> &T {\n        self.deref()\n    }\n}\n\nimpl<T: Debug, A: Allocator> Debug for Arc<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.deref(), f)\n    }\n}\n\nimpl<T: Display, A: Allocator> Display for Arc<T, A> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.deref(), f)\n    }\n}\n\nimpl<T: PartialEq, A: Allocator> PartialEq for Arc<T, A> {\n    fn eq(&self, other: &Arc<T, A>) -> bool {\n        self.deref() == other.deref()\n    }\n}\n\nimpl<T: Eq, A: Allocator> Eq for Arc<T, A> {}\n\nimpl<T: PartialOrd, A: Allocator> PartialOrd for Arc<T, A> {\n    fn partial_cmp(&self, other: &Arc<T, A>) -> Option<CmpOrdering> {\n        self.deref().partial_cmp(other.deref())\n    }\n}\n\nimpl<T: Ord, A: Allocator> Ord for Arc<T, A> {\n    fn cmp(&self, other: &Arc<T, A>) -> CmpOrdering {\n        self.deref().cmp(other.deref())\n    }\n}\n\nimpl<T: Hash, A: Allocator> Hash for Arc<T, A> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        self.deref().hash(state);\n    }\n}\n// ---- end mod std::sync::arc ----\n}\n// ---- mod std::sync::rwlock ----\nmod rwlock {\n// EDITION: rust\n");
    buf_str(out, c"// std::sync::RwLock: data many threads read at once, or one writes. Rust's\n// API; no poisoning (see std::sync). The lock is one word: 0 free, n for n\n// readers, u32::MAX for a writer; waiters sleep on it and are all woken\n// when it becomes free. A writer waits while readers keep arriving: there\n// is no queue.\n\nuse crate::cell::UnsafeCell;\nuse crate::fmt::{Debug, Formatter};\nuse crate::ops::{Deref, DerefMut, Drop};\nuse crate::result::Result;\nuse crate::sync::{LockResult, TryLockError, TryLockResult};\nuse crate::sync::atomic::{AtomicU32, Ordering};\n\nconst WRITER: u32 = 0xffffffff;\n\npub struct RwLock<T> {\n    state: AtomicU32,\n    // The threads asleep on state (or about to be): an unlock wakes only\n    // when there are some.\n    waiters: AtomicU32,\n    data: UnsafeCell<T>,\n}\n\n// UNSAFE: an RwLock holds an UnsafeCell, which is not Sync: stated, as\n// Rust's.\n// SAFETY: the data is read through read guards, which exist only while\n// the word counts them and no writer holds it, and written through the one\n// write guard: readers share a &T (T: Sync), and a writer has the T as if\n// it was moved to its thread (T: Send).\nunsafe impl<T: Send + Sync> Sync for RwLock<T> {}\n// UNSAFE: stated with Sync, as Rust's.\n// SAFETY: moving an RwLock moves its T (T: Send); the words are atomics.\nunsafe impl<T: Send> Send for RwLock<T> {}\n\nimpl<T> RwLock<T> {\n    #[effects(T)]\n    pub fn new(v: T) -> RwLock<T> {\n        RwLock { state: AtomicU32::new(0), waiters: AtomicU32::new(0), data: UnsafeCell::new(v) }\n    }\n\n    fn try_read_once(&self) -> bool {\n        let mut s = self.state.load(Ordering::Relaxed);\n        // (WRITER - 1 readers is the most the word counts)\n        while s < WRITER - 1 {\n            match self.state.compare_exchange(s, s + 1, Ordering::Acquire, Ordering::Relaxed) {\n                Result::Ok(_) => return true,\n                Result::Err(now) => s = now,\n            }\n        }\n        false\n    }\n\n");
    buf_str(out, c"    fn try_write_once(&self) -> bool {\n        self.state.compare_exchange(0, WRITER, Ordering::Acquire, Ordering::Relaxed).is_ok()\n    }\n\n    // Sleeps while the word is `seen`.\n    fn sleep(&self, seen: u32) {\n        self.waiters.fetch_add(1, Ordering::SeqCst);\n        // UNSAFE: the system sleeps on a raw address.\n        // SAFETY: the address is self.state's, a live AtomicU32 while self\n        // is borrowed.\n        unsafe { crate::__sys::futex_wait(self.state.as_ptr(), seen) };\n        self.waiters.fetch_sub(1, Ordering::SeqCst);\n    }\n\n    fn wake(&self) {\n        if self.waiters.load(Ordering::SeqCst) != 0 {\n            // UNSAFE: the system wakes the sleepers on a raw address.\n            // SAFETY: the address is self.state's, live while self is\n            // borrowed.\n            unsafe { crate::__sys::futex_wake(self.state.as_ptr(), true) };\n        }\n    }\n\n    // Waits until no writer holds the lock; the guard reads the data.\n    #[effects(io, sync, panic, diverge, T)]\n    pub fn read(&self) -> LockResult<RwLockReadGuard<'_, T>> {\n        while !self.try_read_once() {\n            let s = self.state.load(Ordering::Relaxed);\n            if s >= WRITER - 1 {\n                self.sleep(s);\n            }\n        }\n        Result::Ok(RwLockReadGuard { lock: self })\n    }\n\n    // Waits until nothing holds the lock; the guard writes the data.\n    #[effects(io, sync, panic, diverge, T)]\n    pub fn write(&self) -> LockResult<RwLockWriteGuard<'_, T>> {\n        while !self.try_write_once() {\n            let s = self.state.load(Ordering::Relaxed);\n            if s != 0 {\n                self.sleep(s);\n            }\n        }\n        Result::Ok(RwLockWriteGuard { lock: self })\n    }\n\n    #[effects(T)]\n    pub fn try_read(&self) -> TryLockResult<RwLockReadGuard<'_, T>> {\n        if self.try_read_once() {\n            Result::Ok(RwLockReadGuard { lock: self })\n        } else {\n");
    buf_str(out, c"            Result::Err(TryLockError::WouldBlock)\n        }\n    }\n\n    #[effects(T)]\n    pub fn try_write(&self) -> TryLockResult<RwLockWriteGuard<'_, T>> {\n        if self.try_write_once() {\n            Result::Ok(RwLockWriteGuard { lock: self })\n        } else {\n            Result::Err(TryLockError::WouldBlock)\n        }\n    }\n\n    // Always false: there is no poisoning.\n    pub fn is_poisoned(&self) -> bool {\n        false\n    }\n\n    // The data, when nothing else can reach the lock.\n    #[effects(T)]\n    pub fn into_inner(self) -> LockResult<T> {\n        Result::Ok(self.data.into_inner())\n    }\n\n    // The data, through the unique borrow (no locking needed).\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> LockResult<&mut T> {\n        Result::Ok(self.data.get_mut())\n    }\n}\n\nimpl<T: Debug> Debug for RwLock<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.try_read() {\n            Result::Ok(g) => {\n                f.write_str(\"RwLock { data: \")?;\n                Debug::fmt(g.deref(), f)?;\n                f.write_str(\", poisoned: false, .. }\")\n            }\n            Result::Err(_) => f.write_str(\"RwLock { data: <locked>, poisoned: false, .. }\"),\n        }\n    }\n}\n\n// A read lock held: the data through `*g`; dropping it lets go.\npub struct RwLockReadGuard<'a, T> {\n    lock: &'a RwLock<T>,\n}\n\nimpl<'a, T> !Send for RwLockReadGuard<'a, T> {}\n\nimpl<'a, T> Deref for RwLockReadGuard<'a, T> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        // UNSAFE: the data is behind the lock's UnsafeCell, a raw pointer.\n        // SAFETY: a read guard exists only while the word counts it, so no\n        // writer holds the lock: the data is only read, by this & and the\n        // other readers'; the & lives no longer than the guard's borrow.\n        unsafe { &*self.lock.data.get() }\n    }\n}\n\nimpl<'a, T> Drop for RwLockReadGuard<'a, T> {\n    fn drop(&mut self) {\n");
    buf_str(out, c"        // (the last reader out wakes the writers waiting)\n        // (SeqCst, as waiters': an unlock and a sleeper's count cannot\n        // both miss each other)\n        if self.lock.state.fetch_sub(1, Ordering::SeqCst) == 1 {\n            self.lock.wake();\n        }\n    }\n}\n\nimpl<'a, T: Debug> Debug for RwLockReadGuard<'a, T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.deref(), f)\n    }\n}\n\n// The write lock held: the data through `*g`; dropping it lets go.\npub struct RwLockWriteGuard<'a, T> {\n    lock: &'a RwLock<T>,\n}\n\nimpl<'a, T> !Send for RwLockWriteGuard<'a, T> {}\n\nimpl<'a, T> Deref for RwLockWriteGuard<'a, T> {\n    type Target = T;\n\n    fn deref(&self) -> &T {\n        // UNSAFE: the data is behind the lock's UnsafeCell, a raw pointer.\n        // SAFETY: the write guard exists only while the word is WRITER:\n        // no other guard does, so nothing else reaches the data; the &\n        // lives no longer than the guard's borrow.\n        unsafe { &*self.lock.data.get() }\n    }\n}\n\nimpl<'a, T> DerefMut for RwLockWriteGuard<'a, T> {\n    fn deref_mut(&mut self) -> &mut T {\n        // UNSAFE: as deref's.\n        // SAFETY: as deref's, and `&mut self` makes this the guard's one\n        // access.\n        unsafe { &mut *self.lock.data.get() }\n    }\n}\n\nimpl<'a, T> Drop for RwLockWriteGuard<'a, T> {\n    fn drop(&mut self) {\n        // (SeqCst: see the read guard's)\n        self.lock.state.store(0, Ordering::SeqCst);\n        self.lock.wake();\n    }\n}\n\nimpl<'a, T: Debug> Debug for RwLockWriteGuard<'a, T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.deref(), f)\n    }\n}\n// ---- end mod std::sync::rwlock ----\n}\n// ---- end mod std::sync ----\n}\n// ---- mod std::gpu ----\npub mod gpu {\n// EDITION: rust\n// std::gpu (0.22, docs/design/gpu.md §2): GPU compute and rendering on\n");
    buf_str(out, c"// wgpu's model. On macOS it runs on Metal (std::gpu::hal::metal); a\n// program that uses it links libobjc: `volec prog.vl -l objc -o\n// prog` (Metal itself is opened at run time).\n//\n// - The objects are wgpu's: Instance, Adapter, Device and Queue, Buffer\n//   (mapping included), Texture and TextureView, Sampler, Shader, the\n//   pipelines, BindGroup, Encoder and Commands, the passes, Surface and\n//   Frame. Each resource is an owned value: dropping it releases it, also\n//   while the GPU still uses it (the work keeps it alive).\n// - Passes are closure-scoped: `enc.compute_pass(|pass| { ... })`.\n// - Misuse is a contract failure (`requires`, exit 101 with the rule's\n//   code: gpu.usage, gpu.align, gpu.range, gpu.layout, gpu.pipeline,\n//   gpu.format, gpu.limits, gpu.state, gpu.unsupported, gpu.unwritten); what can fail\n//   however correct the program is (no adapter, a shader the driver\n//   rejects, a lost device) is a Result.\n// - Backends are behind std::gpu::hal: `Api` (compute, memory, copies)\n//   and `Render` (pipelines, passes, surfaces). Nothing here assumes a\n//   backend's memory model or queue: buffers are reached through\n//   map_read, map_write and unmap; `dev.caps()` says what the device can\n//   do, and a compute-only backend reports `render: false`.\n// - Shaders: `dev.shader(&src)` takes the shader compiler's output for\n//   the device's ShaderKind (MSL on Metal): a ShaderSource, the code and\n//   its reflection.\n\nuse crate::alloc::{Allocator, arena_scope};\nuse crate::fmt::{Debug, Display};\nuse crate::fmt::Formatter as Fmt;\nmod capture;\npub mod hal;\npub mod shader;\nmod timing;\npub mod types;\npub mod wgsl;\n\nuse crate::capture::{capture_next_frame, capture_pending};\npub use crate::capture::capture_cancel;\nuse crate::ops::Range;\n\nuse hal::metal as backend;\npub use hal::{Caps, RawSurface};\npub use shader::{\n    Binding, BindingType, EntryPoint, GroupBinding, Reflection, ShaderKind, ShaderSource,\n");
    buf_str(out, c"    VertexInput,\n};\npub use timing::{MAX_QUERIES, QuerySet};\nuse types::{MAX_BIND_GROUPS, MAX_COLOR_TARGETS, MAX_VERTEX_BUFFERS};\npub use types::{\n    AddressMode, Blend, BlendComponent, BlendFactor, BlendOp, BufferUsage, Color, ColorTarget,\n    Compare, Cull, DepthState, Filter, Format, FrontFace, IndexFormat, Limits, Load, PipelineState,\n    Power, SamplerDesc, ShaderStage, StepMode, TextureDesc, TextureUsage, Topology, VertexAttribute,\n    VertexFormat, VertexLayout,\n};\n\n/// The backend of this build (Metal on macOS).\npub type Native = backend::Metal;\n\ntype N = backend::Metal;\n\n// ---- GPU: errors (0.22) ----\n\n/// What can fail however correct the program is (§2.7); misuse is a\n/// contract failure instead. Messages are the driver's.\npub enum Error<A: Allocator> {\n    NoAdapter,\n    DeviceCreation,\n    Shader(String<A>),\n    Pipeline(String<A>),\n    Submission,\n    SurfaceLost,\n}\n\nimpl Display for Error<Gpa> {\n    fn fmt(&self, f: &mut Fmt<'_>) -> crate::fmt::Result {\n        match self {\n            Error::NoAdapter => f.write_str(\"gpu: no adapter\")?,\n            Error::DeviceCreation => f.write_str(\"gpu: the device could not be opened\")?,\n            Error::Shader(m) => {\n                f.write_str(\"gpu: the shader did not compile: \")?;\n                f.write_str(m.as_str())?;\n            }\n            Error::Pipeline(m) => {\n                f.write_str(\"gpu: the pipeline was rejected: \")?;\n                f.write_str(m.as_str())?;\n            }\n            Error::Submission => f.write_str(\n                \"gpu: a submission failed (device lost or out of memory)\")?,\n            Error::SurfaceLost => f.write_str(\n                \"gpu: the surface has no frame to give (lost, or reconfigure it)\")?,\n        }; Ok(())\n    }\n}\n\nimpl Debug for Error<Gpa> {\n    fn fmt(&self, f: &mut Fmt<'_>) -> crate::fmt::Result {\n        Display::fmt(self, f)\n    }\n}\n\n");
    buf_str(out, c"/// The device ran out of memory where the API returns no Result (buffer,\n/// texture, sampler creation): the process ends, as an allocation failure\n/// of Gpa does.\nfn out_of_memory(what: &str) -> ! {\n    eprintln(\"gpu: out of device memory ({what})\");\n    crate::process::exit(101i32)\n}\n\n// ---- GPU: instance, adapters, devices (0.22) ----\n\n/// The entry point: holds the allocator the devices use for host memory.\n#[derive(Clone, Copy)] pub struct Instance<A: Allocator> {\n    pub gpa: A,\n}\n\nimpl Instance<Gpa> {\n    pub fn new_in(gpa: Gpa) -> Instance<Gpa> {\n        Instance { gpa: gpa }\n    }\n\n    /// Every adapter of the system.\n    pub fn adapters(self) -> Vec<Adapter<Gpa>, Gpa> {\n        let gpa = self.gpa;\n        let mut out: Vec<Adapter<Gpa>, Gpa> = Vec::new_in(gpa);\n        // the backend's list is scratch: an arena, freed at once\n        arena_scope(&gpa, |a| {\n            let mut raw = Vec::new_in(a);\n            N::adapters(&mut raw);\n            for r in raw.iter() {\n                out.push(adapter_new(backend::Adapter { dev: r.dev.clone() }, gpa));\n            }\n        });\n        out\n    }\n\n    /// An adapter: the low-power one when asked and there is one.\n    pub fn adapter(self, power: Power = Power::High) -> Result<Adapter<Gpa>, Error<Gpa>> {\n        if power == Power::Low {\n            let found = arena_scope(&self.gpa, |a| {\n                let mut raw = Vec::new_in(a);\n                N::adapters(&mut raw);\n                let mut f: Option<backend::Adapter> = None;\n                for r in raw.iter() {\n                    if f.is_none() && N::adapter_low_power(r) {\n                        f = Some(backend::Adapter { dev: r.dev.clone() });\n                    }\n                }\n                f\n            });\n            match found {\n                Some(a) => return Ok(adapter_new(a, self.gpa)),\n                None => {}\n            }\n        }\n        match N::default_adapter() {\n");
    buf_str(out, c"            Some(a) => Ok(adapter_new(a, self.gpa)),\n            None => Err(Error::NoAdapter),\n        }\n    }\n\n    /// A surface for a window (or a headless one): its frames are drawn\n    /// into and presented. Needs a device whose caps have `surfaces`.\n    pub fn surface(self, dev: &Device<Gpa>, raw: RawSurface) -> Result<Surface<Gpa>, Error<Gpa>>\n        requires dev.caps.surfaces\n        else \"gpu.unsupported: this device has no surfaces (dev.caps().surfaces)\"\n        {\n        match N::create_surface(&dev.raw, raw) {\n            Some(s) => Ok(Surface {\n                raw: s, configured: false, width: 0, height: 0, format: Format::Bgra8Unorm,\n                dev: dev.raw.clone(), gpa: self.gpa,\n            }),\n            None => Err(Error::SurfaceLost),\n        }\n    }\n}\n\npub struct Adapter<A: Allocator> {\n    pub raw: backend::Adapter,\n    pub gpa: A,\n    // the largest buffer it makes (N::adapter_max_buffer_size), for\n    // device()'s contract\n    max_buffer_size: i64,\n}\n\nfn adapter_new(raw: backend::Adapter, gpa: Gpa) -> Adapter<Gpa> {\n    let max = N::adapter_max_buffer_size(&raw);\n    Adapter { raw: raw, gpa: gpa, max_buffer_size: max }\n}\n\nimpl Adapter<Gpa> {\n    /// The most this adapter takes (wgpu's `adapter.limits()`): Limits::default()\n    /// with the largest buffer it makes (on Apple silicon several GiB, with\n    /// the memory). `adapter.device(adapter.limits())` asks for all of it.\n    pub fn limits(&self) -> Limits {\n        let mut l = Limits::default();\n        l.max_buffer_size = self.max_buffer_size;\n        l\n    }\n\n    /// The adapter's name (\"Apple M5\").\n    pub fn name_in<A: Allocator>(&self, out: &mut String<A>) {\n        N::adapter_name(&self.raw, out);\n    }\n\n    /// The device and its queue, with `limits` (Limits::default(): those\n    /// every adapter takes, a buffer at most 1 GiB; wgpu's model). More, up\n");
    buf_str(out, c"    /// to adapter.limits(): `var lim = Limits::default(); lim.max_buffer_size\n    /// = 4 << 30; adapter.device(lim)`.\n    pub fn device(&self, limits: Limits = Limits::default()) -> Result<(Device<Gpa>, Queue),\n        Error<Gpa>>\n        requires limits.max_buffer_size <= self.max_buffer_size\n        else \"gpu.limits: device(lim) asks for buffers of up to {} bytes (lim.max_buffer_size) and this adapter makes them up to {} (adapter.limits().max_buffer_size)\", limits.max_buffer_size, self.max_buffer_size\n        {\n        match N::open(&self.raw) {\n            Some((d, q)) => {\n                let caps = N::caps(&d);\n                Ok((Device { raw: d, gpa: self.gpa, limits: limits, caps: caps },\n                    Queue { raw: q, written: [0; 256], nwritten: 0, lost: false }))\n            }\n            None => Err(Error::DeviceCreation),\n        }\n    }\n}\n\npub struct Device<A: Allocator> {\n    pub raw: backend::Device,\n    pub gpa: A,\n    pub limits: Limits,\n    pub caps: Caps,\n}\n\npub struct Queue {\n    pub raw: backend::Queue,\n    // the ids (buffer_id) of the uniform buffers written so far, by\n    // write_buffer or by submitted commands (Unwritten's fills), for\n    // submit's gpu.unwritten: the first `nwritten`, no allocation (the\n    // queue's path allocates nothing)\n    written: [u64; 256],\n    nwritten: i64,\n    // more were written than these hold: gpu.unwritten checks no more (it\n    // would report a written one)\n    lost: bool,\n}\n\n/// A layout key: the bindings' kinds and slots, so that a bind group made\n/// for one pipeline is accepted by another only when their layouts agree.\n// h with x mixed in (the old std's hash_mix over a 64-bit finalizer; a\n// layout's key is only compared with other keys made here).\nfn hash_mix(h: u64, x: u64) -> u64 {\n    let mut z = h ^ x.wrapping_add(0x9e3779b97f4a7c15u64).wrapping_add(h << 6).wrapping_add(h >> 2);\n    z = (z ^ (z >> 30)).wrapping_mul(0xbf58476d1ce4e5b9u64);\n");
    buf_str(out, c"    z = (z ^ (z >> 27)).wrapping_mul(0x94d049bb133111ebu64);\n    z ^ (z >> 31)\n}\n\nfn layout_key(entries: &[Binding]) -> u64 {\n    let mut h: u64 = 0x9e3779b97f4a7c15;\n    for &b in entries {\n        h = hash_mix(h, b.binding as u64);\n        h = hash_mix(h, b.ty as u64);\n        h = hash_mix(h, b.slot_vertex as u64);\n        h = hash_mix(h, b.slot_fragment as u64);\n        h = hash_mix(h, b.slot_compute as u64);\n    }\n    if h == 0 { 1 } else { h }\n}\n\n// (0.25.2.1) bind_group's checks. A contract's message holds only integers, so bind_group's name the\n// layout's bindings by number: the i-th (-1: none).\nfn layout_at(l: BindLayout, i: i64) -> i64 {\n    if i >= 0 && i < l.count { l.entries[i as usize].binding } else { -1 }\n}\n\n// The first binding at which entries and the layout differ: an entry for\n// a binding the layout lacks, a binding of the layout with no entry or\n// with two; -1 when they fit.\nfn layout_fit(l: BindLayout, entries: &[BindEntry<'_>]) -> i64 {\n    for &e in entries {\n        let mut n: i64 = 0;\n        for k in 0..l.count {\n            if l.entries[k as usize].binding == e.binding { n += 1; }\n        }\n        if n == 0 { return e.binding; }\n    }\n    for k in 0..l.count {\n        let mut n: i64 = 0;\n        for &e in entries {\n            if e.binding == l.entries[k as usize].binding { n += 1; }\n        }\n        if n != 1 { return l.entries[k as usize].binding; }\n    }\n    -1\n}\n\n// bind_group's rules for each entry (bind_fault's `rule`).\nconst BF_KIND: i64 = 0;\nconst BF_UNIFORM: i64 = 1;\nconst BF_STORAGE: i64 = 2;\nconst BF_MAPPED: i64 = 3;\nconst BF_ALIGN: i64 = 4;\nconst BF_RANGE: i64 = 5;\nconst BF_TEXTURE: i64 = 6;\nconst BF_SAMPLER: i64 = 7;\n\n// The first binding whose entry breaks `rule` against the layout's\n// binding (the entries fit the layout: layout_fit); -1: none.\nfn bind_fault(l: BindLayout, entries: &[BindEntry<'_>], lim: Limits, rule: i64) -> i64 {\n    for k in 0..l.count {\n");
    buf_str(out, c"        let b = l.entries[k as usize];\n        for &e in entries {\n            if e.binding != b.binding { continue; }\n            let bad = match e.res {\n                Resource::Buffer(buf, offset, size) => {\n                    let uniform = b.ty == BindingType::Uniform;\n                    let align = if uniform { lim.min_uniform_buffer_offset_alignment }\n                        else { lim.min_storage_buffer_offset_alignment };\n                    let n = if size < 0 { buf.size - offset } else { size };\n                    if rule == BF_KIND { !b.ty.is_buffer() }\n                    else if rule == BF_UNIFORM { uniform && buf.usage & BufferUsage::UNIFORM == 0 }\n                    else if rule == BF_STORAGE {\n                        b.ty.is_buffer() && !uniform && buf.usage & BufferUsage::STORAGE == 0\n                    }\n                    else if rule == BF_MAPPED { buf.mapped }\n                    else if rule == BF_ALIGN { align > 0 && offset % align != 0 }\n                    else if rule == BF_RANGE {\n                        offset < 0 || n < b.min_size || offset + n > buf.size\n                    }\n                    else { false }\n                }\n                Resource::Texture(v) => {\n                    let need = if b.ty\n                        == BindingType::StorageTexture { TextureUsage::STORAGE_BINDING }\n                        else { TextureUsage::TEXTURE_BINDING };\n                    if rule == BF_KIND { !b.ty.is_texture() }\n                    else if rule == BF_TEXTURE { v.usage & need == 0 }\n                    else { false }\n                }\n                Resource::Sampler(s) => {\n                    if rule == BF_KIND { !b.ty.is_sampler() }\n                    else if rule == BF_SAMPLER {\n                        s.comparison != (b.ty == BindingType::ComparisonSampler)\n                    }\n                    else { false }\n                }\n            };\n");
    buf_str(out, c"            if bad { return b.binding; }\n        }\n    }\n    -1\n}\n\n// (0.25.3) WebGPU's rule for mappable buffers: MAP_READ goes with COPY_DST\n// alone, MAP_WRITE with COPY_SRC alone, so the GPU reaches a mappable\n// buffer only by copies (which the encoder records for submit's\n// gpu.state). 1: MAP_READ with more, 2: MAP_WRITE with more, 0: fine.\nfn map_usage_fault(usage: u32) -> i64 {\n    let read = BufferUsage::MAP_READ | BufferUsage::COPY_DST;\n    let write = BufferUsage::MAP_WRITE | BufferUsage::COPY_SRC;\n    if usage & BufferUsage::MAP_READ != 0 && usage | read != read { 1 }\n    else if usage & BufferUsage::MAP_WRITE != 0 && usage | write != write { 2 }\n    else { 0 }\n}\n\nimpl Device<Gpa> {\n    pub fn limits(&self) -> Limits {\n        self.limits\n    }\n\n    /// What the device can do: compute, render, surfaces, its ShaderKind.\n    pub fn caps(&self) -> Caps {\n        self.caps\n    }\n\n    /// n rounded up to the uniform buffer offset alignment.\n    pub fn align_uniform(&self, n: i64) -> i64 {\n        let a = self.limits.min_uniform_buffer_offset_alignment;\n        (n + a - 1) / a * a\n    }\n\n    /// A buffer of size bytes, zeroed.\n    pub fn buffer(&self, size: i64, usage: u32) -> Buffer\n        requires size >= 0 && size <= self.limits.max_buffer_size\n        else \"gpu.limits: a buffer of {size} bytes; this device makes them up to {} (dev.limits().max_buffer_size; Limits::default() has 1 GiB): ask for more when opening it, up to the adapter's largest (adapter.limits().max_buffer_size): `var lim = Limits::default(); lim.max_buffer_size = {size}; adapter.device(lim)`\", self.limits.max_buffer_size\n        requires usage != 0 else \"gpu.usage: a buffer needs a usage\"\n        requires map_usage_fault(usage) != 1\n");
    buf_str(out, c"        else \"gpu.usage: a buffer made with BufferUsage::MAP_READ has COPY_DST besides and nothing more (WebGPU's rule: what the GPU writes otherwise could change a mapped view); this one's usage is {usage}: make the buffer the GPU writes with COPY_SRC (not MAP_READ), copy it into one of MAP_READ | COPY_DST (enc.copy_buffer) and map that\"\n        requires map_usage_fault(usage) != 2\n        else \"gpu.usage: a buffer made with BufferUsage::MAP_WRITE has COPY_SRC besides and nothing more (WebGPU's rule: the GPU could read it while the CPU writes); this one's usage is {usage}: write the buffer the GPU uses with queue.write_buffer, or write one of MAP_WRITE | COPY_SRC and copy it (enc.copy_buffer)\"\n        {\n        match N::create_buffer(&self.raw, size, b\"\") {\n            Some(b) => Buffer {\n                raw: b, size: size, usage: usage, mapped: false,\n                written: false,\n            },\n            None => out_of_memory(\"buffer\"),\n        }\n    }\n\n    /// A buffer holding a copy of bytes.\n    pub fn buffer_init(&self, bytes: &[u8], usage: u32) -> Buffer\n        requires bytes.len() as i64 <= self.limits.max_buffer_size\n        else \"gpu.limits: a buffer of {} bytes; this device makes them up to {} (dev.limits().max_buffer_size; Limits::default() has 1 GiB): ask for more when opening it, up to the adapter's largest (adapter.limits().max_buffer_size): `var lim = Limits::default(); lim.max_buffer_size = {}; adapter.device(lim)`\", bytes.len(), self.limits.max_buffer_size, bytes.len()\n        requires usage != 0 else \"gpu.usage: a buffer needs a usage\"\n        requires map_usage_fault(usage) != 1\n");
    buf_str(out, c"        else \"gpu.usage: a buffer made with BufferUsage::MAP_READ has COPY_DST besides and nothing more (WebGPU's rule: what the GPU writes otherwise could change a mapped view); this one's usage is {usage}: make the buffer the GPU writes with COPY_SRC (not MAP_READ), copy it into one of MAP_READ | COPY_DST (enc.copy_buffer) and map that\"\n        requires map_usage_fault(usage) != 2\n        else \"gpu.usage: a buffer made with BufferUsage::MAP_WRITE has COPY_SRC besides and nothing more (WebGPU's rule: the GPU could read it while the CPU writes); this one's usage is {usage}: write the buffer the GPU uses with queue.write_buffer, or write one of MAP_WRITE | COPY_SRC and copy it (enc.copy_buffer)\"\n        {\n        match N::create_buffer(&self.raw, bytes.len() as i64, bytes) {\n            Some(b) => Buffer {\n                raw: b, size: bytes.len() as i64, usage: usage, mapped: false,\n                written: true,\n            },\n            None => out_of_memory(\"buffer\"),\n        }\n    }\n\n    /// A 2D texture (a 2D array when layers > 1).\n    pub fn texture(&self, width: i64, height: i64, format: Format,\n        usage: u32 = TextureUsage::TEXTURE_BINDING | TextureUsage::COPY_DST, layers: i64 = 1,\n        mips: i64 = 1) -> Texture\n        requires self.caps.textures\n        else \"gpu.unsupported: this device has no textures (dev.caps().textures)\"\n        requires width >= 1 && height >= 1 && width <= self.limits.max_texture_dimension_2d\n        && height <= self.limits.max_texture_dimension_2d\n        else \"gpu.limits: a texture of {width} x {height}; its sides are 1 to {} (dev.limits().max_texture_dimension_2d)\", self.limits.max_texture_dimension_2d\n        requires layers >= 1 && layers <= self.limits.max_texture_array_layers && mips >= 1\n        else \"gpu.limits: layers and mips\"\n        requires usage != 0 else \"gpu.usage: a texture needs a usage\"\n");
    buf_str(out, c"        requires usage & TextureUsage::STORAGE_BINDING == 0 || format.is_storable()\n        else \"gpu.format: STORAGE_BINDING needs a storable format\"\n        requires usage & TextureUsage::RENDER_ATTACHMENT == 0 || self.caps.render\n        else \"gpu.unsupported: RENDER_ATTACHMENT on a device without render\"\n        {\n        let desc = TextureDesc {\n            width: width, height: height, layers: layers, mips: mips, format: format, usage: usage,\n        };\n        match N::create_texture(&self.raw, desc) {\n            Some(t) => Texture { raw: t, desc: desc },\n            None => out_of_memory(\"texture\"),\n        }\n    }\n\n    pub fn sampler(&self, desc: SamplerDesc) -> Sampler\n        requires self.caps.textures\n        else \"gpu.unsupported: this device has no samplers (dev.caps().textures)\"\n        requires desc.anisotropy >= 1 && desc.anisotropy <= 16\n        else \"gpu.limits: anisotropy is 1..16\"\n        {\n        match N::create_sampler(&self.raw, desc) {\n            Some(s) => Sampler { raw: s, comparison: desc.compare.is_some() },\n            None => out_of_memory(\"sampler\"),\n        }\n    }\n\n    /// A shader module from the shader compiler's output for this device\n    /// (`caps().shader_kind`: MSL on Metal). What it keeps of the source\n    /// is copied.\n    pub fn shader(&self, src: &ShaderSource<'_, Gpa>) -> Result<Shader<Gpa>, Error<Gpa>>\n        requires src.kind == self.caps.shader_kind\n        else \"gpu.format: the shader is not of this device's ShaderKind (dev.caps().shader_kind)\"\n        {\n        // (what the shader asks of the device is the shader's error, not\n        // a contract: it may come from WGSL text the program reads)\n        if src.reflection.sizes.len() as i64 > MAX_SIZES {\n            return Err(Error::Shader(format_in(\"gpu.limits: {} runtime-sized storage bindings; at most {MAX_SIZES} (the sizes buffer)\", src.reflection.sizes.len() as i64, self.gpa)));\n        }\n");
    buf_str(out, c"        let mut err: String<Gpa> = String::new_in(self.gpa);\n        match N::create_shader(&self.raw, src, &mut err) {\n            Some(s) => {\n                let mut entries: Vec<ShaderEntry<Gpa>, Gpa> = Vec::new_in(self.gpa);\n                for e in src.reflection.entries.iter().copied() {\n                    entries.push(ShaderEntry {\n                        name: String::from_in(e.name, self.gpa),\n                        native: String::from_in(e.native, self.gpa), stage: e.stage,\n                        workgroup: e.workgroup, sizes_slot: e.sizes_slot,\n                    });\n                }\n                let mut sizes: Vec<GroupBinding, Gpa> = Vec::new_in(self.gpa);\n                sizes.extend_from_slice(src.reflection.sizes.as_slice());\n                let mut bindings: Vec<Binding, Gpa> = Vec::new_in(self.gpa);\n                bindings.extend_from_slice(src.reflection.bindings.as_slice());\n                let mut inputs: Vec<VertexInput, Gpa> = Vec::new_in(self.gpa);\n                inputs.extend_from_slice(src.reflection.inputs.as_slice());\n                let mut uses: Vec<[i64; 2], Gpa> = Vec::new_in(self.gpa);\n                uses.extend_from_slice(src.reflection.uses.as_slice());\n                Ok(Shader {\n                    raw: s, entries: entries, bindings: bindings, inputs: inputs, sizes: sizes,\n                    uses: uses,\n                })\n            }\n            None => Err(Error::Shader(err)),\n        }\n    }\n\n    /// A shader module from WGSL source: std::gpu::wgsl translates it for\n    /// this device (MSL on Metal), and its reflection (entry points,\n    /// bindings and their slots, vertex inputs, the sizes buffer) feeds\n    /// pipeline creation as dev.shader's does. A rejected shader is\n    /// Error::Shader with the compiler's `LINE:COL: error wgsl.CODE: ...`;\n    /// one Metal rejects, `LINE:COL: error wgsl.target: ...` at the WGSL\n");
    buf_str(out, c"    /// function, then Metal's log. Nothing about the shader panics.\n    pub fn shader_wgsl(&self, src: &str) -> Result<Shader<Gpa>, Error<Gpa>> {\n        if self.caps.shader_kind != ShaderKind::Msl {\n            return Err(\n                Error::Shader(\n                    String::from_in(\n                        \"std::gpu::wgsl writes no code for this device's ShaderKind yet\",\n                        self.gpa)));\n        }\n        let mut code = Vec::<u8, _>::new_in(self.gpa);\n        let mut refl = wgsl::new_reflection(self.gpa);\n        let mut err = wgsl::new_error(self.gpa);\n        if !wgsl::translate_buf(src.as_bytes(), wgsl::options(wgsl::TARGET_MSL), &mut code,\n            &mut refl, &mut err, self.gpa) {\n            // (a message can quote the source's bytes: lossy, never a panic)\n            let mut m = format_in(\"{}:{}: error {}: {}\", err.line, err.col,\n                String::from_utf8_lossy_in(err.code, self.gpa),\n                String::from_utf8_lossy_in(err.msg.as_slice(), self.gpa), self.gpa);\n            if err.help.len() as i64 > 0 {\n                m.push_str(\" (help: \");\n                m.push_str(String::from_utf8_lossy_in(err.help.as_slice(), self.gpa).as_str());\n                m.push_str(\")\");\n            }\n            return Err(Error::Shader(m));\n        }\n        match shader::from_wgsl(&refl, self.gpa) {\n            Ok(r) => {\n                // (the translator writes ASCII and the source's own names)\n                let code = match String::from_utf8(code) {\n                    Ok(c) => c,\n                    Err(_) => return Err(\n                        Error::Shader(\n                            String::from_in(\"std::gpu::wgsl wrote code that is not UTF-8\",\n                                self.gpa))),\n                };\n                let s = ShaderSource::msl(code.as_str(), r);\n                match self.shader(&s) {\n                    Ok(sh) => Ok(sh),\n");
    buf_str(out, c"                    Err(Error::Shader(log)) => {\n                        // Metal rejected WGSL the translator took: the\n                        // message at the WGSL function, then Metal's\n                        let mut m: String<Gpa> = String::new_in(self.gpa);\n                        if wgsl::target_error(src.as_bytes(), &refl, log.as_bytes(), &mut m) {\n                            m.push_str(\"\\n\");\n                        }\n                        m.push_str(log.as_str());\n                        Err(Error::Shader(m))\n                    }\n                    Err(e) => Err(e),\n                }\n            }\n            Err(m) => Err(Error::Shader(m)),\n        }\n    }\n\n    /// A compute pipeline for the entry point `entry` of the shader; its\n    /// bind layouts come from the shader's reflection.\n    pub fn compute_pipeline(&self, shader: &Shader<Gpa>, entry: &str) -> Result<ComputePipeline,\n        Error<Gpa>>\n        requires self.caps.compute\n        else \"gpu.unsupported: this device has no compute (dev.caps().compute)\"\n        {\n        let e = match shader.entry(entry, ShaderStage::COMPUTE) {\n            Some(e) => e,\n            None => return Err(\n                Error::Pipeline({\n                    let entry = entry;\n                    format_in(\"no compute entry point '{entry}' in the shader\", self.gpa)\n                })),\n        };\n        let wg = e.workgroup;\n        let l = self.limits;\n        // (the shader's sizes against the device's: the shader's error)\n        if wg[0] < 1 || wg[1] < 1 || wg[2] < 1 || wg[0] > l.max_compute_workgroup_size_x\n            || wg[1] > l.max_compute_workgroup_size_y || wg[2] > l.max_compute_workgroup_size_z\n            || wg[0] * wg[1] * wg[2] > l.max_compute_invocations_per_workgroup {\n");
    buf_str(out, c"            return Err(Error::Pipeline({ let entry = entry; format_in(\"gpu.limits: '{entry}' has @workgroup_size({}, {}, {}); the device takes at most ({}, {}, {}), {} in all (dev.limits())\", wg[0], wg[1], wg[2], l.max_compute_workgroup_size_x, l.max_compute_workgroup_size_y, l.max_compute_workgroup_size_z, l.max_compute_invocations_per_workgroup, self.gpa) }));\n        }\n        if e.sizes_slot >= 31 {\n            return Err(Error::Pipeline({\n                let entry = entry;\n                format_in(\"gpu.limits: '{entry}' binds {} buffers; at most 30\", e.sizes_slot,\n                    self.gpa)\n            }));\n        }\n        let mut err: String<Gpa> = String::new_in(self.gpa);\n        match N::create_compute_pipeline(&self.raw, &shader.raw, e, &mut err) {\n            Some(p) => {\n                let mut out = ComputePipeline {\n                    raw: p, layouts: Layouts::new(), workgroup: wg,\n                    sizes: StageSizes::of(shader, e.sizes_slot),\n                };\n                out.layouts.merge_stage(shader, shader.entry_index(entry, ShaderStage::COMPUTE),\n                    ShaderStage::COMPUTE);\n                Ok(out)\n            }\n            None => Err(Error::Pipeline(err)),\n        }\n    }\n\n    /// A render pipeline.\n    pub fn render_pipeline(&self, desc: RenderDesc<'_, Gpa>) -> Result<RenderPipeline, Error<Gpa>>\n        requires self.caps.render\n        else \"gpu.unsupported: this device does not render (dev.caps().render)\"\n        requires desc.state.buffer_count <= self.limits.max_vertex_buffers\n        else \"gpu.limits: {} vertex buffers; the device takes at most {} (dev.limits().max_vertex_buffers)\", desc.state.buffer_count, self.limits.max_vertex_buffers\n        requires desc.state.target_count >= 0\n        && desc.state.target_count <= self.limits.max_color_attachments\n");
    buf_str(out, c"        else \"gpu.limits: {} color targets; the device takes 0 to {} (dev.limits().max_color_attachments)\", desc.state.target_count, self.limits.max_color_attachments\n        requires desc.state.target_count > 0 || desc.state.depth.is_some()\n        else \"gpu.format: a pipeline with no color target draws only depth: give it a depth state (desc.depth(), or RenderDesc::depth_only)\"\n        {\n        let vs = match desc.vertex.entry(desc.vs, ShaderStage::VERTEX) {\n            Some(e) => e,\n            None => return Err(\n                Error::Pipeline(format_in(\"no vertex entry point '{}' in the shader\", desc.vs,\n                    self.gpa))),\n        };\n        let mut fs = vs;\n        if desc.has_fs {\n            fs = match desc.fragment.entry(desc.fs, ShaderStage::FRAGMENT) {\n                Some(e) => e,\n                None => return Err(\n                    Error::Pipeline(format_in(\"no fragment entry point '{}' in the shader\", desc.fs,\n                        self.gpa))),\n            };\n        }\n        let st = desc.state;\n        for i in 0..st.buffer_count {\n            let l = st.buffers[i as usize];\n            assert(l.stride >= 0 && l.stride % 4 == 0,\n                \"gpu.align: a vertex buffer's stride is a multiple of 4\");\n            for k in 0..l.count {\n                let a = l.attributes[k as usize];\n                assert(a.offset % 4 == 0,\n                    \"gpu.align: a vertex attribute's offset is a multiple of 4\");\n                assert(a.offset + a.format.size() <= l.stride\n                    || (l.stride == 0 && l.step == StepMode::Instance),\n                    \"gpu.range: a vertex attribute reaches past its stride\");\n            }\n        }\n        // every vertex input of the shader is fed by an attribute\n        for inp in desc.vertex.inputs.iter().copied() {\n            let mut fed = false;\n            for i in 0..st.buffer_count {\n                let l = st.buffers[i as usize];\n");
    buf_str(out, c"                for k in 0..l.count {\n                    if l.attributes[k as usize].location == inp.location {\n                        fed = true;\n                        assert(l.attributes[k as usize].format.shader_type()\n                            == inp.format.shader_type(),\n                            \"gpu.format: a vertex attribute's format differs from the shader's input\");\n                    }\n                }\n            }\n            assert(fed,\n                \"gpu.layout: a vertex input of the shader has no attribute (desc.vertex_buffer)\");\n        }\n        for i in 0..st.target_count {\n            assert(!st.targets[i as usize].format.is_depth(),\n                \"gpu.format: a color target of a depth format\");\n        }\n        match st.depth {\n            Some(d) => assert(d.format.is_depth(),\n                \"gpu.format: the depth state needs a depth format\"),\n            None => {}\n        }\n        // (the sizes buffer's slot stays below the vertex buffers: 30 - i)\n        if vs.sizes_slot >= 31 - st.buffer_count || fs.sizes_slot >= 31 {\n            return Err(Error::Pipeline(format_in(\"gpu.limits: the shader's buffers ({} in '{}', {} in '{}') and {} vertex buffers take more than Metal's 31 slots\", vs.sizes_slot, desc.vs, fs.sizes_slot, desc.fs, st.buffer_count, self.gpa)));\n        }\n        let mut err: String<Gpa> = String::new_in(self.gpa);\n        match N::create_render_pipeline(&self.raw, &desc.vertex.raw, vs, &desc.fragment.raw, fs,\n            desc.has_fs, st, &mut err) {\n            Some(p) => {\n                let mut out = RenderPipeline {\n                    raw: p, layouts: Layouts::new(), state: st,\n                    vs_sizes: StageSizes::of(&desc.vertex, vs.sizes_slot),\n                    fs_sizes: if desc.has_fs { StageSizes::of(&desc.fragment, fs.sizes_slot) }\n                        else { StageSizes::none() }\n                };\n");
    buf_str(out, c"                out.layouts.merge_stage(&desc.vertex,\n                    desc.vertex.entry_index(desc.vs, ShaderStage::VERTEX), ShaderStage::VERTEX);\n                if desc.has_fs {\n                    out.layouts.merge_stage(&desc.fragment,\n                        desc.fragment.entry_index(desc.fs, ShaderStage::FRAGMENT),\n                        ShaderStage::FRAGMENT);\n                }\n                Ok(out)\n            }\n            None => Err(Error::Pipeline(err)),\n        }\n    }\n\n    /// A bind group for `layout` (from `pipe.bind_layout(i)`): one entry per\n    /// binding of the layout, in any order. A layout holds the bindings of\n    /// group i that the pipeline's own entry points use, through their\n    /// calls (WebGPU's `layout: \"auto\"`): one only another entry point of\n    /// the module uses is not in it, nor one declared and never used.\n    pub fn bind_group(&self, layout: BindLayout, entries: &[BindEntry<'_>]) -> BindGroup\n        requires layout_fit(layout, entries) < 0 || layout.count != 0\n        else \"gpu.layout: the layout of group {} has no bindings: the pipeline's own entry points use no binding of group {}, and the bind group has {} entries: bind nothing for this group, or use the bindings in the shader\", layout.group, layout.group, entries.len()\n        requires layout_fit(layout, entries) < 0 || layout.count != 1\n        else \"gpu.layout: the layout has 1 binding, {}, and binding {} of the bind group does not fit it: a layout is the bindings the pipeline's own entry points use, through their calls (one only another entry point of the module uses is not in it, nor one declared and never used): give one entry for each\", layout_at(layout, 0), layout_fit(layout, entries)\n        requires layout_fit(layout, entries) < 0 || layout.count != 2\n");
    buf_str(out, c"        else \"gpu.layout: the layout has 2 bindings, {} and {}, and binding {} of the bind group does not fit them: a layout is the bindings the pipeline's own entry points use, through their calls (one only another entry point of the module uses is not in it, nor one declared and never used): give one entry for each\", layout_at(layout, 0), layout_at(layout, 1), layout_fit(layout, entries)\n        requires layout_fit(layout, entries) < 0 || layout.count != 3\n        else \"gpu.layout: the layout has 3 bindings, {}, {} and {}, and the bind group does not fit them: a layout is the bindings the pipeline's own entry points use, through their calls (one only another entry point of the module uses is not in it, nor one declared and never used): give one entry for each\", layout_at(layout, 0), layout_at(layout, 1), layout_at(layout, 2)\n        requires layout_fit(layout, entries) < 0\n        else \"gpu.layout: the layout has {} bindings, the first {} (all: pipe.bind_layout(g).entries[i].binding), and binding {} of the bind group does not fit them: a layout is the bindings the pipeline's own entry points use, through their calls (one only another entry point of the module uses is not in it, nor one declared and never used): give one entry for each\", layout.count, layout_at(layout, 0), layout_fit(layout, entries)\n        requires bind_fault(layout, entries, self.limits, BF_KIND) < 0\n        else \"gpu.layout: the resource at binding {} is not of the shader's kind there: gpu::bind (a buffer) for var<uniform> and var<storage>, gpu::bind_texture for a texture, gpu::bind_sampler for a sampler\", bind_fault(layout, entries, self.limits, BF_KIND)\n        requires bind_fault(layout, entries, self.limits, BF_UNIFORM) < 0\n        else \"gpu.usage: the buffer at binding {} is a var<uniform> in the shader and was made without BufferUsage::UNIFORM\", bind_fault(layout, entries, self.limits, BF_UNIFORM)\n        requires bind_fault(layout, entries, self.limits, BF_STORAGE) < 0\n");
    buf_str(out, c"        else \"gpu.usage: the buffer at binding {} is a var<storage> in the shader and was made without BufferUsage::STORAGE\", bind_fault(layout, entries, self.limits, BF_STORAGE)\n        requires bind_fault(layout, entries, self.limits, BF_MAPPED) < 0\n        else \"gpu.state: the buffer at binding {} is mapped: unmap it first\",\n\n    bind_fault(layout, entries, self.limits, BF_MAPPED)\n        requires bind_fault(layout, entries, self.limits, BF_ALIGN) < 0\n        else \"gpu.align: the offset at binding {} is not a multiple of the device's alignment (dev.align_uniform(n))\", bind_fault(layout, entries, self.limits, BF_ALIGN)\n        requires bind_fault(layout, entries, self.limits, BF_RANGE) < 0\n        else \"gpu.range: the range at binding {} reaches past its buffer, or is smaller than the shader's type there\", bind_fault(layout, entries, self.limits, BF_RANGE)\n        requires bind_fault(layout, entries, self.limits, BF_TEXTURE) < 0\n        else \"gpu.usage: the texture at binding {} was made without TextureUsage::TEXTURE_BINDING (sampled) or STORAGE_BINDING (a storage texture), as the shader uses it\", bind_fault(layout, entries, self.limits, BF_TEXTURE)\n        requires bind_fault(layout, entries, self.limits, BF_SAMPLER) < 0\n        else \"gpu.layout: the sampler at binding {} is a comparison sampler where the shader has a plain one, or the reverse (SamplerDesc's compare)\", bind_fault(layout, entries, self.limits, BF_SAMPLER)\n        {\n        let mut g = N::bind_group_new(&self.raw);\n        let mut bytes = GroupBytes::new();\n        let mut unwritten = Unwritten::new();\n        for k in 0..layout.count {\n            let b = layout.entries[k as usize];\n            for &e in entries {\n                if e.binding != b.binding { continue; }\n                match e.res {\n                    Resource::Buffer(buf, offset, size) => {\n                        let n = if size < 0 { buf.size - offset } else { size };\n");
    buf_str(out, c"                        N::bind_group_buffer(&mut g, b, &buf.raw, offset, n);\n                        if buf.usage & BufferUsage::UNIFORM != 0 {\n                            if b.ty == BindingType::Uniform && !buf.written\n                                && buf.usage & BufferUsage::MAP_WRITE == 0 {\n                                // (one mapped for writing may be written after this)\n                                unwritten.read(buffer_id(buf), layout.group, b.binding, buf.size);\n                            } else if b.ty == BindingType::Storage {\n                                unwritten.wrote(buffer_id(buf));\n                            }\n                        }\n                        // (at most 16 bindings in a layout, each given once)\n                        bytes.binding[bytes.count as usize] = b.binding;\n                        bytes.bytes[bytes.count as usize] = n;\n                        bytes.count += 1;\n                    }\n                    Resource::Texture(v) => N::bind_group_texture(&mut g, b, &v.raw),\n                    Resource::Sampler(s) => N::bind_group_sampler(&mut g, b, &s.raw),\n                }\n            }\n        }\n        BindGroup { raw: g, key: layout.key, bytes: bytes, unwritten: unwritten }\n    }\n\n    /// A command encoder.\n    pub fn encoder(&self) -> Encoder<Gpa> {\n        Encoder {\n            raw: N::begin(&self.raw), limits: self.limits, caps: self.caps,\n            unwritten: Unwritten::new(), maps: Vec::new_in(self.gpa),\n            dev: self.raw.clone(), segs: Vec::new_in(self.gpa), stamps: Vec::new_in(self.gpa),\n            resolve_next: false,\n        }\n    }\n\n    /// Waits until the GPU has finished everything submitted.\n    pub fn wait_idle(&self) {\n        N::device_wait_idle(&self.raw);\n    }\n}\n\nimpl Queue {\n    /// Submits recorded commands; they run after everything submitted\n    /// before. A uniform buffer they read must have been written first\n");
    buf_str(out, c"    /// (gpu.unwritten): by write_buffer, by commands submitted before or\n    /// these, or made with its bytes (buffer_init). A buffer they copy\n    /// into or from is not mapped (gpu.state): one mapped after the copy\n    /// was recorded is unmapped first.\n    pub fn submit(&mut self, cmds: Commands<Gpa>)\n        requires self.lost\n        || unwritten_fault(&self.written[0..self.nwritten as usize], cmds.unwritten, 0) < 0\n        else \"gpu.unwritten: binding {} of group {} (a uniform buffer of {} bytes) was never written: write it (queue.write_buffer) before submitting the first dispatch or draw that reads it (dev.buffer's zeros are not a value; dev.buffer_init makes a buffer with its bytes)\", unwritten_fault(&self.written[0..self.nwritten as usize], cmds.unwritten, 2), unwritten_fault(&self.written[0..self.nwritten as usize], cmds.unwritten, 1), unwritten_fault(&self.written[0..self.nwritten as usize], cmds.unwritten, 3)\n        requires map_fault(cmds.maps.as_slice(), hal::MAPPED_READ, 0) < 0\n        else \"gpu.state: these commands copy into a buffer of {} bytes that was mapped (map_read) after the copy was recorded: the copy would change its view. Unmap it (buf.unmap(dev)) when its view is done, or read a copy (map_read_copy_in)\", map_fault(cmds.maps.as_slice(), hal::MAPPED_READ, 1)\n        requires map_fault(cmds.maps.as_slice(), hal::MAPPED_WRITE, 0) < 0\n        else \"gpu.state: these commands copy from a buffer of {} bytes that was mapped for writing (map_write) after the copy was recorded: unmap it (buf.unmap(dev)) before submitting, which sends what was written\", map_fault(cmds.maps.as_slice(), hal::MAPPED_WRITE, 1)\n        {\n        let mut c = cmds;\n        if c.unwritten.lost {\n            self.lost = true;\n        }\n        for i in 0..c.unwritten.fills {\n            self.wrote(c.unwritten.fill[i as usize]);\n        }\n        if c.segs.len() as i64 > 0 || c.resolve_next {\n");
    buf_str(out, c"            // (0.25.4) timed passes or resolves (timing.vl)\n            timing::submit_segments(&mut self.raw, &mut c);\n        } else {\n            N::submit(&mut self.raw, &mut c.raw);\n        }\n    }\n\n    // A uniform buffer has been written (its id, once).\n    fn wrote(&mut self, id: u64) {\n        for i in 0..self.nwritten {\n            if self.written[i as usize] == id { return; }\n        }\n        if self.nwritten < 256 {\n            self.written[self.nwritten as usize] = id;\n            self.nwritten += 1;\n        } else {\n            self.lost = true;\n        }\n    }\n\n    /// Writes bytes into buf at offset, before the commands submitted next\n    /// run (and after the ones submitted before).\n    pub fn write_buffer(&mut self, buf: &Buffer, offset: i64, bytes: &[u8])\n        requires buf.usage & BufferUsage::COPY_DST != 0\n        else \"gpu.usage: write_buffer's buffer ({} bytes) was made without BufferUsage::COPY_DST: add it where that buffer is made\", buf.size\n        requires offset % 4 == 0 && bytes.len() % 4 == 0\n        else \"gpu.align: write_buffer's offset and size are multiples of 4\"\n        requires offset >= 0 && offset + bytes.len() as i64 <= buf.size\n        else \"gpu.range: write_buffer reaches past the buffer\"\n        requires !buf.mapped\n        else \"gpu.state: write_buffer's buffer ({} bytes) is mapped (map_read): the write would change its view. Unmap it (buf.unmap(dev)) when its view is done, or read a copy (map_read_copy_in)\", buf.size\n        {\n        if buf.usage & BufferUsage::UNIFORM != 0 && !buf.written {\n            self.wrote(buffer_id(buf));\n        }\n        N::write_buffer(&mut self.raw, &buf.raw, offset, bytes);\n    }\n\n    /// Writes rows of texels into layer `layer` of tex at (x, y): h rows of\n    /// bytes_per_row bytes each, w texels used of each row.\n    pub fn write_texture(&mut self, tex: &Texture, bytes: &[u8], bytes_per_row: i64,\n");
    buf_str(out, c"        x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1, layer: i64 = 0)\n        requires tex.desc.usage & TextureUsage::COPY_DST != 0\n        else \"gpu.usage: write_texture needs COPY_DST\"\n        requires layer >= 0 && layer < tex.desc.layers else \"gpu.range: no such layer\"\n    {\n        let ww = if w < 0 { tex.desc.width - x } else { w };\n        let hh = if h < 0 { tex.desc.height - y } else { h };\n        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width\n            && y + hh <= tex.desc.height, \"gpu.range: the region is outside the texture\");\n        assert(bytes_per_row >= ww * tex.desc.format.size(),\n            \"gpu.range: bytes_per_row is shorter than a row\");\n        assert(bytes.len() as i64 >= bytes_per_row * (hh - 1) + ww * tex.desc.format.size(),\n            \"gpu.range: fewer bytes than the region\");\n        N::write_texture(&mut self.raw, &tex.raw, layer, x, y, ww, hh, bytes, bytes_per_row);\n    }\n\n    /// Waits until everything submitted has finished.\n    pub fn wait_idle(&mut self) -> Result<(), Error<Gpa>> {\n        if N::queue_wait_idle(&mut self.raw) { Ok(()) } else { Err(Error::Submission) }\n    }\n}\n\n// ---- GPU: buffers, textures, samplers, shaders (0.22) ----\n\npub struct Buffer {\n    pub raw: backend::Buffer,\n    pub size: i64,\n    pub usage: u32,\n    /// Mapped by map_read or map_write, until unmap (the native buffer\n    /// holds the same, for the commands recorded before: Queue::submit).\n    pub mapped: bool,\n    /// Made with its bytes (buffer_init) or mapped for writing: gpu.unwritten\n    /// never reports it.\n    pub written: bool,\n}\n\nimpl Buffer {\n    pub fn size(&self) -> i64 {\n        self.size\n    }\n\n    pub fn usage(&self) -> u32 {\n        self.usage\n    }\n\n    /// The buffer's bytes once the GPU has finished every submitted\n    /// command (it waits): a view of the buffer, which cannot be used\n");
    buf_str(out, c"    /// while the view is. The buffer stays mapped until `unmap(dev)`:\n    /// until then nothing writes it (a copy into it is gpu.state, when it\n    /// is recorded or, recorded before map_read, when it is submitted), so\n    /// the view never changes; unmap takes the buffer as `inout`, so not\n    /// while a view of it lives. The view lives no longer than the\n    /// buffer: a function may return it when the buffer is its caller's\n    /// (an inout or let parameter), not when the buffer is its own local;\n    /// then return a copy, `map_read_copy_in(dev, gpa)`.\n    pub fn map_read(&mut self, dev: &Device<Gpa>) -> &[u8]\n        requires self.usage & BufferUsage::MAP_READ != 0\n        else \"gpu.usage: map_read's buffer ({} bytes) was made without BufferUsage::MAP_READ: add it where the buffer is made\", self.size\n        {\n        N::device_wait_idle(&dev.raw);\n        self.mapped = true;\n        N::map_read(&dev.raw, &mut self.raw)\n    }\n\n    /// The buffer's bytes, as map_read, copied into a new Vec on\n    /// allocator a: they outlive the buffer (return them from the function\n    /// that made it). It maps, copies and unmaps: the buffer is not mapped\n    /// afterwards. `gpu::f32s(v.as_slice())` views them as f32s.\n    pub fn map_read_copy_in<A: Allocator>(&mut self, dev: &Device<Gpa>, a: A) -> Vec<u8, A>\n        requires self.usage & BufferUsage::MAP_READ != 0\n        else \"gpu.usage: map_read_copy_in's buffer ({} bytes) was made without BufferUsage::MAP_READ: add it where the buffer is made\", self.size\n        {\n        N::device_wait_idle(&dev.raw);\n        let mut out: Vec<u8, A> = Vec::with_capacity_in(self.size as usize, a);\n        out.extend_from_slice(N::map_read(&dev.raw, &mut self.raw));\n        N::unmap(&dev.raw, &mut self.raw);\n        self.mapped = false;\n        out\n    }\n\n    /// The buffer's bytes to write, once the GPU has finished with it; the\n");
    buf_str(out, c"    /// writes reach the GPU at `unmap`, which must come before the buffer\n    /// is used again.\n    pub fn map_write(&mut self, dev: &Device<Gpa>) -> &mut [u8]\n        requires self.usage & BufferUsage::MAP_WRITE != 0\n        else \"gpu.usage: map_write needs MAP_WRITE\"\n        {\n        N::device_wait_idle(&dev.raw);\n        self.mapped = true;\n        self.written = true;\n        N::map_write(&dev.raw, &mut self.raw)\n    }\n\n    /// Ends a mapping: after a map_write what was written reaches the GPU;\n    /// after a map_read the buffer can be written again (copies into it,\n    /// write_buffer). Its `inout` self is refused while a view of the\n    /// buffer lives (own.*): the view is done first. Unmapping a buffer\n    /// that is not mapped does nothing.\n    pub fn unmap(&mut self, dev: &Device<Gpa>) {\n        N::unmap(&dev.raw, &mut self.raw);\n        self.mapped = false;\n    }\n}\n\npub struct Texture {\n    pub raw: backend::Texture,\n    pub desc: TextureDesc,\n}\n\nimpl Texture {\n    pub fn width(&self) -> i64 {\n        self.desc.width\n    }\n\n    pub fn height(&self) -> i64 {\n        self.desc.height\n    }\n\n    pub fn format(&self) -> Format {\n        self.desc.format\n    }\n\n    pub fn usage(&self) -> u32 {\n        self.desc.usage\n    }\n\n    /// A view of the whole texture (it keeps the texture alive).\n    pub fn view(&self) -> TextureView {\n        self.view_as(self.desc.format)\n    }\n\n    /// A view reading the texels as another format of the same size\n    /// (Rgba8Unorm as Rgba8UnormSrgb).\n    pub fn view_as(&self, format: Format) -> TextureView\n        requires format.size() == self.desc.format.size()\n        && format.is_depth() == self.desc.format.is_depth()\n        else \"gpu.format: a view's format has its texture's texel size\"\n        {\n        match N::create_view(&self.raw, format, format == self.desc.format) {\n            Some(v) => TextureView {\n");
    buf_str(out, c"                raw: v, format: format, width: self.desc.width, height: self.desc.height,\n                usage: self.desc.usage,\n            },\n            None => out_of_memory(\"texture view\"),\n        }\n    }\n}\n\npub struct TextureView {\n    pub raw: backend::TextureView,\n    pub format: Format,\n    pub width: i64,\n    pub height: i64,\n    pub usage: u32,\n}\n\npub struct Sampler {\n    pub raw: backend::Sampler,\n    pub comparison: bool,\n}\n\n/// An entry point of a Shader, its names copied.\npub struct ShaderEntry<A: Allocator> {\n    pub name: String<A>,\n    pub native: String<A>,\n    pub stage: u32,\n    pub workgroup: [i64; 3],\n    pub sizes_slot: i64,\n}\n\npub struct Shader<A: Allocator> {\n    pub raw: backend::Shader,\n    pub entries: Vec<ShaderEntry<A>, A>,\n    pub bindings: Vec<Binding, A>,\n    pub inputs: Vec<VertexInput, A>,\n    pub sizes: Vec<GroupBinding, A>,\n    /// (entry, binding) index pairs: the bindings each entry point uses\n    /// (Reflection::uses; empty: each uses all its stage's).\n    pub uses: Vec<[i64; 2], A>,\n}\n\nimpl Shader<Gpa> {\n    /// The entry point of that name and stage (its names view the\n    /// shader's copies).\n    pub fn entry(&self, name: &str, stage: u32) -> Option<EntryPoint<'_>> {\n        for i in 0..self.entries.len() as i64 {\n            if self.entries[i as usize].name.as_str() == name\n                && self.entries[i as usize].stage == stage {\n                return Some(EntryPoint {\n                    name: self.entries[i as usize].name.as_str(),\n                    native: self.entries[i as usize].native.as_str(),\n                    stage: self.entries[i as usize].stage,\n                    workgroup: self.entries[i as usize].workgroup,\n                    sizes_slot: self.entries[i as usize].sizes_slot,\n                });\n            }\n        }\n        None\n    }\n\n    /// The index of the entry point of that name and stage in `entries`;\n    /// -1: none.\n");
    buf_str(out, c"    pub fn entry_index(&self, name: &str, stage: u32) -> i64 {\n        for i in 0..self.entries.len() as i64 {\n            if self.entries[i as usize].name.as_str() == name\n                && self.entries[i as usize].stage == stage {\n                return i;\n            }\n        }\n        -1\n    }\n\n    /// Whether entry point `entry` uses binding `binding` (indices into\n    /// `entries` and `bindings`); with no `uses` (a reflection written by\n    /// hand), every binding its stage has a slot for.\n    pub fn entry_uses(&self, entry: i64, binding: i64) -> bool {\n        if self.uses.len() as i64 == 0 {\n            return true;\n        }\n        for u in self.uses.iter().copied() {\n            if u[0] == entry && u[1] == binding { return true; }\n        }\n        false\n    }\n}\n\n// ---- GPU: bind layouts and groups (0.22) ----\n\n/// The bindings of one group as a pipeline sees them: plain data, kept in\n/// the pipeline (no allocation).\n#[derive(Clone, Copy)] pub struct BindLayout {\n    pub group: i64,\n    pub entries: [Binding; 16],\n    pub count: i64,\n    pub key: u64,\n}\n\n/// A pipeline's layouts, groups 0..MAX_BIND_GROUPS.\n#[derive(Clone, Copy)] pub struct Layouts {\n    pub groups: [BindLayout; 4],\n    pub used: i64,\n}\n\nimpl Layouts {\n    fn new() -> Layouts {\n        let none = Binding {\n            group: 0, binding: 0, ty: BindingType::Uniform, slot_vertex: -1, slot_fragment: -1,\n            slot_compute: -1, min_size: 0,\n        };\n        let l = BindLayout { group: 0, entries: [none; 16], count: 0, key: 0 };\n        let mut out = Layouts { groups: [l; 4], used: 0 };\n        for i in 0..MAX_BIND_GROUPS {\n            out.groups[i as usize].group = i;\n        }\n        out\n    }\n\n    /// Adds the bindings the entry point `entry` of `shader` (of stage\n    /// `stage`) uses: a pipeline's layout is its own entry points'\n    /// bindings, not those of the module's other entry points. A binding\n");
    buf_str(out, c"    /// seen from two stages is one entry with both slots.\n    fn merge_stage(&mut self, shader: &Shader<Gpa>, entry: i64, stage: u32) {\n        for bi in 0..shader.bindings.len() as i64 {\n            let b = shader.bindings[bi as usize];\n            if b.visibility() & stage == 0 || !shader.entry_uses(entry, bi) { continue; }\n            assert(b.group >= 0 && b.group < MAX_BIND_GROUPS, \"gpu.limits: bind groups 0..3\");\n            let gi = b.group;\n            let mut merged = false;\n            for k in 0..self.groups[gi as usize].count {\n                let mut e = self.groups[gi as usize].entries[k as usize];\n                if e.binding == b.binding {\n                    assert(e.ty == b.ty,\n                        \"gpu.layout: two stages see one binding as different kinds\");\n                    if stage == ShaderStage::VERTEX { e.slot_vertex = b.slot_vertex; }\n                    if stage == ShaderStage::FRAGMENT { e.slot_fragment = b.slot_fragment; }\n                    if stage == ShaderStage::COMPUTE { e.slot_compute = b.slot_compute; }\n                    self.groups[gi as usize].entries[k as usize] = e;\n                    merged = true;\n                }\n            }\n            if !merged {\n                let n = self.groups[gi as usize].count;\n                assert(n < 16, \"gpu.limits: 16 bindings a group\");\n                let mut e = b;\n                if stage != ShaderStage::VERTEX { e.slot_vertex = -1; }\n                if stage != ShaderStage::FRAGMENT { e.slot_fragment = -1; }\n                if stage != ShaderStage::COMPUTE { e.slot_compute = -1; }\n                self.groups[gi as usize].entries[n as usize] = e;\n                self.groups[gi as usize].count = n + 1;\n            }\n            if gi + 1 > self.used { self.used = gi + 1; }\n        }\n        for i in 0..MAX_BIND_GROUPS {\n            let n = self.groups[i as usize].count;\n            self.groups[i as usize].key = if n == 0 { 0 }\n");
    buf_str(out, c"                else { layout_key(&self.groups[i as usize].entries[0..n as usize]) };\n        }\n    }\n}\n\n/// A resource bound at a binding: a buffer range (size -1: to the end), a\n/// texture view or a sampler.\n#[derive(Clone, Copy)] pub enum Resource<'a> {\n    Buffer(&'a Buffer, i64, i64),\n    Texture(&'a TextureView),\n    Sampler(&'a Sampler),\n}\n\n#[derive(Clone, Copy)] pub struct BindEntry<'a> {\n    pub binding: i64,\n    pub res: Resource<'a>,\n}\n\n/// The whole of a buffer at `binding`.\npub fn bind(binding: i64, buf: &Buffer) -> BindEntry<'_> {\n    BindEntry { binding: binding, res: Resource::Buffer(buf, 0i64, -1i64) }\n}\n\n/// size bytes of a buffer from offset at `binding`.\npub fn bind_range(binding: i64, buf: &Buffer, offset: i64, size: i64) -> BindEntry<'_> {\n    BindEntry { binding: binding, res: Resource::Buffer(buf, offset, size) }\n}\n\npub fn bind_texture(binding: i64, view: &TextureView) -> BindEntry<'_> {\n    BindEntry { binding: binding, res: Resource::Texture(view) }\n}\n\npub fn bind_sampler(binding: i64, s: &Sampler) -> BindEntry<'_> {\n    BindEntry { binding: binding, res: Resource::Sampler(s) }\n}\n\n/// Resources bound together (the group keeps them alive).\npub struct BindGroup {\n    pub raw: backend::BindGroup,\n    pub key: u64,\n    bytes: GroupBytes,\n    unwritten: Unwritten,\n}\n\n// Uniform buffers read before written (0.25.2.2; in the bind groups' section):\n\n// A buffer's id in gpu.unwritten's records: its Metal object's address\n// (a freed buffer's may come back: a write to the old one then counts for\n// the new, a miss, never a false error).\nfn buffer_id(b: &Buffer) -> u64 {\n    b.raw.raw.ptr as u64\n}\n\n// What a bind group, a pass, an encoder and its commands record for\n// queue.submit's gpu.unwritten: the uniform buffers they read that may\n// be unwritten (made by dev.buffer: its id, the group and binding it is\n// read at, its size), and the uniform buffers they write (`fill`: a copy\n");
    buf_str(out, c"// into one, one bound as read_write storage). Kept small and plain: 16\n// reads, the rest not checked (a miss, never a false error); 16 writes,\n// the rest `lost` (then the queue checks no more).\n#[derive(Clone, Copy)]\nstruct Unwritten {\n    count: i64,\n    id: [u64; 16],\n    group: [i64; 16],\n    binding: [i64; 16],\n    size: [i64; 16],\n    fills: i64,\n    fill: [u64; 16],\n    lost: bool,\n}\n\nimpl Unwritten {\n    fn new() -> Unwritten {\n        Unwritten {\n            count: 0, id: [0; 16], group: [0i64; 16], binding: [0i64; 16], size: [0i64; 16],\n            fills: 0,\n            fill: [0; 16], lost: false,\n        }\n    }\n\n    fn read(&mut self, id: u64, group: i64, binding: i64, size: i64) {\n        for i in 0..self.count {\n            if self.id[i as usize] == id { return; }\n        }\n        if self.count < 16 {\n            let n = self.count;\n            self.id[n as usize] = id;\n            self.group[n as usize] = group;\n            self.binding[n as usize] = binding;\n            self.size[n as usize] = size;\n            self.count = n + 1;\n        }\n    }\n\n    fn wrote(&mut self, id: u64) {\n        for i in 0..self.fills {\n            if self.fill[i as usize] == id { return; }\n        }\n        if self.fills < 16 {\n            self.fill[self.fills as usize] = id;\n            self.fills += 1;\n        } else {\n            self.lost = true;\n        }\n    }\n\n    // Adds what `o` records (a bind group set at `group`, or a pass's).\n    fn add(&mut self, o: Unwritten, group: i64) {\n        for i in 0..o.count {\n            self.read(o.id[i as usize], if group >= 0 { group } else { o.group[i as usize] },\n                o.binding[i as usize], o.size[i as usize]);\n        }\n        for i in 0..o.fills {\n            self.wrote(o.fill[i as usize]);\n        }\n        if o.lost { self.lost = true; }\n    }\n}\n\n// The first uniform buffer `u` reads that neither `written` nor u's own\n");
    buf_str(out, c"// writes hold: what = 0 its index, 1 its group, 2 its binding, 3 its size;\n// -1 when there is none.\nfn unwritten_fault(written: &[u64], u: Unwritten, what: i64) -> i64 {\n    for i in 0..u.count {\n        let mut seen = false;\n        for &w in written {\n            if w == u.id[i as usize] { seen = true; }\n        }\n        for k in 0..u.fills {\n            if u.fill[k as usize] == u.id[i as usize] { seen = true; }\n        }\n        if !seen {\n            return if what == 0 { i } else if what == 1 { u.group[i as usize] }\n                else if what == 2 { u.binding[i as usize] } else { u.size[i as usize] };\n        }\n    }\n    -1\n}\n\n// ---- GPU: the sizes buffer (0.22) ----\n\n// The most runtime-sized bindings a stage reads (the sizes buffer's\n// words), and the most buffers a bind group records the bytes of.\nconst MAX_SIZES: i64 = 16;\n\n/// A bind group's buffers: each one's binding and the bytes it exposes\n/// (its size minus the offset, or the binding's size).\n#[derive(Clone, Copy)]\nstruct GroupBytes {\n    count: i64,\n    binding: [i64; 16],\n    bytes: [i64; 16],\n}\n\nimpl GroupBytes {\n    fn new() -> GroupBytes { GroupBytes { count: 0, binding: [0i64; 16], bytes: [0i64; 16] } }\n}\n\n/// What one stage of a pipeline reads in its sizes buffer: the slot (-1:\n/// none) and the (group, binding) of each word (shader::Reflection's sizes).\n#[derive(Clone, Copy)]\nstruct StageSizes {\n    slot: i64,\n    count: i64,\n    at: [[i64; 2]; 16],\n}\n\nimpl StageSizes {\n    fn none() -> StageSizes { StageSizes { slot: -1, count: 0, at: [[0i64, 0]; 16] } }\n\n    fn of(shader: &Shader<Gpa>, slot: i64) -> StageSizes {\n        let mut out = StageSizes::none();\n        if slot < 0 { return out; }\n        out.slot = slot;\n        out.count = shader.sizes.len() as i64;\n        for i in 0..out.count {\n            out.at[i as usize] = shader.sizes[i as usize];\n        }\n        out\n    }\n\n");
    buf_str(out, c"    /// The words (wgsl::sizes_words's rule): the bytes bound at each\n    /// (group, binding), 0 when nothing is bound there, at most u32's\n    /// largest; how many.\n    fn words(self, groups: [GroupBytes; 4], out: &mut [u32; 16]) -> i64 {\n        for i in 0..self.count {\n            let g = self.at[i as usize][0];\n            let b = self.at[i as usize][1];\n            let mut n: i64 = 0;\n            if g >= 0 && g < MAX_BIND_GROUPS {\n                for k in 0..groups[g as usize].count {\n                    if groups[g as usize].binding[k as usize]\n                        == b { n = groups[g as usize].bytes[k as usize]; }\n                }\n            }\n            out[i as usize] = if n < 0 { 0 } else if n > 4294967295 { 4294967295u32 }\n                else { n as u32 };\n        }\n        self.count\n    }\n}\n\n// ---- GPU: pipelines (0.22) ----\n\npub struct ComputePipeline {\n    pub raw: backend::ComputePipeline,\n    pub layouts: Layouts,\n    pub workgroup: [i64; 3],\n    sizes: StageSizes,\n}\n\nimpl ComputePipeline {\n    /// The layout of group i, for `dev.bind_group`.\n    pub fn bind_layout(&self, i: i64) -> BindLayout\n        requires i >= 0 && i < MAX_BIND_GROUPS else \"gpu.limits: bind groups 0..3\"\n    {\n        self.layouts.groups[i as usize]\n    }\n}\n\npub struct RenderPipeline {\n    pub raw: backend::RenderPipeline,\n    pub layouts: Layouts,\n    pub state: PipelineState,\n    vs_sizes: StageSizes,\n    fs_sizes: StageSizes,\n}\n\nimpl RenderPipeline {\n    pub fn bind_layout(&self, i: i64) -> BindLayout\n        requires i >= 0 && i < MAX_BIND_GROUPS else \"gpu.limits: bind groups 0..3\"\n    {\n        self.layouts.groups[i as usize]\n    }\n}\n\n/// A render pipeline's description: shaders and entry points, then the\n/// fixed-function state (PipelineState) with its builder methods.\n#[derive(Clone, Copy)] pub struct RenderDesc<'a, A: Allocator> {\n    pub vertex: &'a Shader<A>,\n    pub vs: &'a str,\n");
    buf_str(out, c"    pub fragment: &'a Shader<A>,\n    pub fs: &'a str,\n    pub has_fs: bool,\n    pub state: PipelineState,\n}\n\nimpl<'a> RenderDesc<'a, Gpa> {\n    /// Vertex entry `vs` and fragment entry `fs` of one shader, drawing\n    /// into one target of `format`.\n    pub fn new(shader: &'a Shader<Gpa>, vs: &'a str, fs: &'a str, format: Format) -> RenderDesc<'a,\n        Gpa> {\n        RenderDesc {\n            vertex: shader, vs: vs, fragment: shader, fs: fs, has_fs: true,\n            state: PipelineState::new(format),\n        }\n    }\n\n    /// A depth-only pipeline (a shadow map): the vertex entry `vs`, no\n    /// fragment stage, no color target, a depth test of `format` that\n    /// writes. It draws in a `PassDesc::depth_only` pass.\n    pub fn depth_only(shader: &'a Shader<Gpa>, vs: &'a str, format: Format = Format::Depth32Float,\n        compare: Compare = Compare::Less) -> RenderDesc<'a, Gpa> {\n        let mut d = RenderDesc {\n            vertex: shader, vs: vs, fragment: shader, fs: \"\", has_fs: false,\n            state: PipelineState::new(Format::Rgba8Unorm),\n        };\n        d.state.target_count = 0;\n        d.state.depth = Some(DepthState { format: format, write: true, compare: compare });\n        d\n    }\n\n    /// No fragment stage and no color target (depth only; with\n    /// `.depth(..)`, or use `RenderDesc::depth_only`).\n    pub fn no_fragment(&mut self) {\n        self.has_fs = false;\n        self.state.target_count = 0;\n    }\n\n    /// A vertex buffer's layout, at the next slot.\n    pub fn vertex_buffer(&mut self, layout: VertexLayout)\n        requires self.state.buffer_count < MAX_VERTEX_BUFFERS\n        else \"gpu.limits: at most 8 vertex buffers\"\n        {\n        self.state.buffers[self.state.buffer_count as usize] = layout;\n        self.state.buffer_count += 1;\n    }\n\n    /// Blending for target i (0: the first).\n    pub fn blend(&mut self, blend: Blend, target: i64 = 0)\n");
    buf_str(out, c"        requires target >= 0 && target < self.state.target_count\n        else \"gpu.range: no such color target\"\n        {\n        self.state.targets[target as usize].blend = Some(blend);\n    }\n\n    /// Another color target.\n    pub fn target(&mut self, format: Format)\n        requires self.state.target_count < MAX_COLOR_TARGETS\n        else \"gpu.limits: at most 8 color targets\"\n        {\n        self.state.targets[self.state.target_count as usize] = ColorTarget {\n            format: format, blend: None, write_mask: 15,\n        };\n        self.state.target_count += 1;\n    }\n\n    pub fn depth(&mut self, format: Format = Format::Depth32Float,\n        compare: Compare = Compare::Less, write: bool = true) {\n        self.state.depth = Some(DepthState { format: format, write: write, compare: compare });\n    }\n\n    pub fn topology(&mut self, t: Topology) {\n        self.state.topology = t;\n    }\n\n    pub fn cull(&mut self, c: Cull, front: FrontFace = FrontFace::Ccw) {\n        self.state.cull = c;\n        self.state.front_face = front;\n    }\n}\n\n// ---- GPU: encoders and passes (0.22) ----\n\npub struct Encoder<A: Allocator> {\n    pub raw: backend::CommandBuffer,\n    pub limits: Limits,\n    pub caps: Caps,\n    unwritten: Unwritten,\n    // (0.25.3) the mappable buffers the commands use (copies: the only\n    // way the GPU reaches one, map_usage_fault), a handle of each, for\n    // submit's gpu.state; on the device's allocator, from the first\n    maps: Vec<backend::Buffer, A>,\n    // (0.25.4) timing (timing.vl): the device, for a new command buffer;\n    // the command buffers ended before a timed pass, by it and before a\n    // resolve; the timestamps written; the current one resolves\n    dev: backend::Device,\n    segs: Vec<timing::Seg, A>,\n    stamps: Vec<timing::Stamp, A>,\n    resolve_next: bool,\n}\n\n/// Recorded commands, for `queue.submit` (dropped unsubmitted: discarded).\npub struct Commands<A: Allocator> {\n");
    buf_str(out, c"    pub raw: backend::CommandBuffer,\n    unwritten: Unwritten,\n    maps: Vec<backend::Buffer, A>,\n    // (0.25.4) the encoder's split command buffers and timestamps\n    segs: Vec<timing::Seg, A>,\n    stamps: Vec<timing::Stamp, A>,\n    resolve_next: bool,\n}\n\n// (0.25.3) The first buffer of `maps` (the mappable buffers recorded\n// commands use) whose map state is `state` (hal::MAPPED_READ,\n// MAPPED_WRITE) now: what = 0 its index, 1 its size; -1 when none is.\nfn map_fault(maps: &[backend::Buffer], state: i64, what: i64) -> i64 {\n    for i in 0..maps.len() {\n        if N::map_state(&maps[i]) == state {\n            return if what == 0 { i as i64 } else { maps[i].size };\n        }\n    }\n    -1\n}\n\n/// The bind group keys a pass has bound, against a pipeline's layouts.\n#[derive(Clone, Copy)] struct Bindings {\n    bound: [u64; 4],\n    want: [u64; 4],\n    used: i64,\n    has_pipeline: bool,\n}\n\nimpl Bindings {\n    fn new() -> Bindings {\n        Bindings { bound: [0, 0, 0, 0], want: [0, 0, 0, 0], used: 0, has_pipeline: false }\n    }\n\n    fn set_pipeline(&mut self, l: Layouts) {\n        self.has_pipeline = true;\n        self.used = l.used;\n        for i in 0..MAX_BIND_GROUPS {\n            self.want[i as usize] = l.groups[i as usize].key;\n        }\n    }\n\n    fn set_group(&mut self, i: i64, key: u64)\n        requires i >= 0 && i < MAX_BIND_GROUPS else \"gpu.limits: bind groups 0..3\"\n    {\n        assert(!self.has_pipeline || self.want[i as usize] == 0 || self.want[i as usize] == key, \"gpu.layout: the bind group was made for another layout (make it from pipe.bind_layout(i))\");\n        self.bound[i as usize] = key;\n    }\n\n    /// Before a draw or dispatch: a pipeline, and a matching group for each\n    /// group it uses.\n    fn ready(self) {\n        assert(self.has_pipeline, \"gpu.pipeline: set a pipeline before drawing or dispatching\");\n        for i in 0..self.used {\n");
    buf_str(out, c"            assert(self.want[i as usize] == 0 || self.bound[i as usize] == self.want[i as usize],\n                \"gpu.pipeline: a bind group the pipeline uses is not set (pass.set_bind_group)\");\n        }\n    }\n}\n\npub struct ComputePass {\n    raw: backend::ComputeEncoder,\n    binds: Bindings,\n    max_groups: i64,\n    // the sizes buffer: the pipeline's, and the bound groups' bytes\n    sizes: StageSizes,\n    groups: [GroupBytes; 4],\n    unwritten: Unwritten,\n}\n\nimpl ComputePass {\n    pub fn set_pipeline(&mut self, p: &ComputePipeline) {\n        self.binds.set_pipeline(p.layouts);\n        self.sizes = p.sizes;\n        N::compute_set_pipeline(&mut self.raw, &p.raw);\n    }\n\n    pub fn set_bind_group(&mut self, i: i64, g: &BindGroup) {\n        self.binds.set_group(i, g.key);\n        self.groups[i as usize] = g.bytes;\n        if g.unwritten.count > 0 || g.unwritten.fills > 0 {\n            self.unwritten.add(g.unwritten, i);\n        }\n        N::compute_set_bind_group(&mut self.raw, &g.raw);\n    }\n\n    /// x * y * z workgroups of the pipeline's workgroup size.\n    pub fn dispatch(&mut self, x: i64, y: i64 = 1, z: i64 = 1)\n        requires x >= 0 && y >= 0 && z >= 0\n        else \"gpu.range: dispatch({x}, {y}, {z}): a count of workgroups is 0 or more\"\n        requires x <= self.max_groups && y <= self.max_groups && z <= self.max_groups\n        else \"gpu.limits: a dispatch of {} workgroups in one dimension; at most {} (dev.limits().max_compute_workgroups_per_dimension, the device's own, which device(lim) cannot raise): give the kernel a larger @workgroup_size, or spread the work over y and z (dispatch(x, y, z), the index from global_invocation_id.y and .z)\", largest(x, y, z), self.max_groups\n        {\n        self.binds.ready();\n        if x == 0 || y == 0 || z == 0 { return; }\n        if self.sizes.slot >= 0 {\n            let mut words: [u32; 16] = [0; 16];\n            let n = self.sizes.words(self.groups, &mut words);\n");
    buf_str(out, c"            N::compute_set_bytes(&mut self.raw, bytes_of_u32(&words[0..n as usize]),\n                self.sizes.slot);\n        }\n        N::dispatch(&mut self.raw, x, y, z);\n    }\n}\n\n// The largest of a dispatch's counts (gpu.limits' message: a contract's\n// message holds three values at most).\nfn largest(x: i64, y: i64, z: i64) -> i64 {\n    if x >= y && x >= z { x } else if y >= z { y } else { z }\n}\n\n/// A color attachment of a render pass.\n#[derive(Clone, Copy)] pub struct ColorAttachment<'a> {\n    pub view: &'a TextureView,\n    pub load: Load,\n    pub clear: Color,\n    pub store: bool,\n}\n\n#[derive(Clone, Copy)] pub struct DepthAttachment<'a> {\n    pub view: &'a TextureView,\n    pub load: Load,\n    pub clear: f64,\n    pub store: bool,\n}\n\n/// A render pass's attachments: color attachments 0..color_count (at\n/// most 8, `@location(i)` of the fragment shader writes the i-th), and\n/// maybe a depth one. A pass has at least one of them: a depth-only pass\n/// (a shadow map) has no color attachment (0.25.2.1).\n#[derive(Clone, Copy)] pub struct PassDesc<'a> {\n    pub colors: [Option<ColorAttachment<'a>>; 8],\n    pub color_count: i64,\n    pub depth: Option<DepthAttachment<'a>>,\n}\n\nimpl<'a> PassDesc<'a> {\n    /// One color attachment, cleared to `clear` (or kept: load =\n    /// Load::Keep) and stored; `.with_color` adds more.\n    pub fn color(view: &'a TextureView, clear: Color = Color::black(), load: Load = Load::Clear) -> PassDesc<'a> {\n        let mut colors: [Option<ColorAttachment<'_>>; 8] = [None; 8];\n        colors[0] = Some(ColorAttachment { view: view, load: load, clear: clear, store: true });\n        PassDesc { colors: colors, color_count: 1, depth: None }\n    }\n\n    /// No color attachment, only depth: a shadow map's pass, drawn with a\n    /// `RenderDesc::depth_only` pipeline. Stored by default, to be read\n    /// afterwards.\n");
    buf_str(out, c"    pub fn depth_only(view: &'a TextureView, clear: f64 = 1.0, store: bool = true) -> PassDesc<'a> {\n        PassDesc {\n            colors: [None; 8], color_count: 0,\n            depth: Some(DepthAttachment {\n                view: view, load: Load::Clear, clear: clear, store: store,\n            }),\n        }\n    }\n\n    /// Another color attachment, after the ones there: multiple render\n    /// targets (a G-buffer), `PassDesc::color(albedo).with_color(normal)`;\n    /// the fragment shader's `@location(i)` writes the i-th, and the\n    /// pipeline has a target of the same format for each\n    /// (`RenderDesc::target`).\n    pub fn with_color(self, view: &'a TextureView, clear: Color = Color::black(),\n        load: Load = Load::Clear) -> PassDesc<'a>\n        requires self.color_count < MAX_COLOR_TARGETS\n        else \"gpu.limits: a pass has at most 8 color attachments; this one has {}\", self.color_count\n        {\n        let mut d = self;\n        d.colors[d.color_count as usize] = Some(ColorAttachment {\n            view: view, load: load, clear: clear, store: true,\n        });\n        d.color_count += 1;\n        d\n    }\n\n    pub fn with_depth(self, view: &'a TextureView, clear: f64 = 1.0, store: bool = false) -> PassDesc<'a> {\n        let mut d = self;\n        d.depth = Some(DepthAttachment {\n            view: view, load: Load::Clear, clear: clear, store: store,\n        });\n        d\n    }\n}\n\n// What render_pass checks of a PassDesc's color attachments (the index of\n// the first one that breaks the rule, -1: none): 0, without\n// RENDER_ATTACHMENT; 1, not a renderable color format; 2, of another size\n// than the first attachment (color, else depth).\nfn color_fault(desc: PassDesc<'_>, rule: i64) -> i64 {\n    let mut w: i64 = -1;\n    let mut h: i64 = -1;\n    for i in 0..desc.color_count {\n        match desc.colors[i as usize] {\n            Some(c) => {\n                let v = c.view;\n");
    buf_str(out, c"                if rule == 0 && v.usage & TextureUsage::RENDER_ATTACHMENT == 0 { return i; }\n                if rule == 1 && (!v.format.is_renderable() || v.format.is_depth()) { return i; }\n                if w < 0 {\n                    w = v.width;\n                    h = v.height;\n                }\n                if rule == 2 && (v.width != w || v.height != h) { return i; }\n            }\n            None => {}\n        }\n    }\n    -1\n}\n\n// What render_pass checks of the depth attachment: 1, no\n// RENDER_ATTACHMENT; 2, not a depth format; 3, not the color\n// attachments' size; 0, none (or no depth attachment).\nfn depth_attachment_fault(desc: PassDesc<'_>) -> i64 {\n    match desc.depth {\n        Some(d) => {\n            if d.view.usage & TextureUsage::RENDER_ATTACHMENT == 0 { return 1; }\n            if !d.view.format.is_depth() { return 2; }\n            if d.view.width != pass_side(desc, false) || d.view.height != pass_side(desc, true) {\n                return 3;\n            }\n            0\n        }\n        None => 0,\n    }\n}\n\n// The width (or height, `height`) of a pass's attachments: the first\n// color one's, else the depth one's.\nfn pass_side(desc: PassDesc<'_>, height: bool) -> i64 {\n    if desc.color_count > 0 {\n        match desc.colors[0] {\n            Some(c) => return if height { c.view.height } else { c.view.width },\n            None => {}\n        }\n    }\n    match desc.depth {\n        Some(d) => if height { d.view.height } else { d.view.width },\n        None => 0,\n    }\n}\n\npub struct RenderPass {\n    raw: backend::RenderEncoder,\n    binds: Bindings,\n    // the color attachments' formats, 0..color_count\n    formats: [Format; 8],\n    color_count: i64,\n    depth: Option<Format>,\n    width: i64,\n    height: i64,\n    // per vertex buffer slot: the bytes after its offset (-1: none)\n    vertex_bytes: [i64; 8],\n    index_bytes: i64,\n    index_size: i64,\n    strides: [i64; 8],\n    steps: [StepMode; 8],\n");
    buf_str(out, c"    buffer_count: i64,\n    // the sizes buffers: the pipeline's per stage, the bound groups' bytes\n    vs_sizes: StageSizes,\n    fs_sizes: StageSizes,\n    groups: [GroupBytes; 4],\n    unwritten: Unwritten,\n}\n\n// The first color target of a pipeline whose format differs from the\n// pass's attachment at that index (-1: none; the counts are checked\n// first).\nfn target_fault(formats: [Format; 8], count: i64, st: PipelineState) -> i64 {\n    for i in 0..count {\n        if i < st.target_count && st.targets[i as usize].format != formats[i as usize] { return i; }\n    }\n    -1\n}\n\n// 1 when the pipeline has a depth state the pass has no attachment for,\n// 2 when the formats differ, 0 when they fit.\nfn depth_fault(pass_depth: Option<Format>, st: PipelineState) -> i64 {\n    match st.depth {\n        Some(d) => match pass_depth {\n            Some(f) => if f == d.format { 0 } else { 2 },\n            None => 1,\n        },\n        None => 0,\n    }\n}\n\nimpl RenderPass {\n    /// The pipeline must fit the pass: a color target for each color\n    /// attachment, of its format and in its order, and a depth state of\n    /// the depth attachment's format when it tests depth.\n    pub fn set_pipeline(&mut self, p: &RenderPipeline)\n        requires p.state.target_count == self.color_count\n        else \"gpu.format: the pipeline has {} color targets and the pass {} color attachments: give the pipeline one target per attachment, in order (RenderDesc::new's format, then desc.target(format); none: RenderDesc::depth_only), or the pass one attachment per target (PassDesc::color(view).with_color(view2))\", p.state.target_count, self.color_count\n        requires target_fault(self.formats, self.color_count, p.state) < 0\n");
    buf_str(out, c"        else \"gpu.format: the pipeline's color target {} has another format than the pass's color attachment {}: the target's format (RenderDesc::new, desc.target) is the texture's (dev.texture)\", target_fault(self.formats, self.color_count, p.state), target_fault(self.formats, self.color_count, p.state)\n        requires depth_fault(self.depth, p.state) != 1\n        else \"gpu.format: the pipeline tests depth (desc.depth) and the pass has no depth attachment: add one (.with_depth(view)), or drop the pipeline's depth state\"\n        requires depth_fault(self.depth, p.state) != 2\n        else \"gpu.format: the pipeline's depth format differs from the pass's depth attachment\"\n        {\n        let st = p.state;\n        self.binds.set_pipeline(p.layouts);\n        self.vs_sizes = p.vs_sizes;\n        self.fs_sizes = p.fs_sizes;\n        self.buffer_count = st.buffer_count;\n        for i in 0..st.buffer_count {\n            self.strides[i as usize] = st.buffers[i as usize].stride;\n            self.steps[i as usize] = st.buffers[i as usize].step;\n        }\n        N::render_set_pipeline(&mut self.raw, &p.raw);\n    }\n\n    pub fn set_bind_group(&mut self, i: i64, g: &BindGroup) {\n        self.binds.set_group(i, g.key);\n        self.groups[i as usize] = g.bytes;\n        if g.unwritten.count > 0 || g.unwritten.fills > 0 {\n            self.unwritten.add(g.unwritten, i);\n        }\n        N::render_set_bind_group(&mut self.raw, &g.raw);\n    }\n\n    // Before a draw: each stage's sizes buffer, when it reads one.\n    fn set_sizes(&mut self) {\n        let mut words: [u32; 16] = [0; 16];\n        if self.vs_sizes.slot >= 0 {\n            let n = self.vs_sizes.words(self.groups, &mut words);\n            N::render_set_bytes(&mut self.raw, ShaderStage::VERTEX,\n                bytes_of_u32(&words[0..n as usize]), self.vs_sizes.slot);\n        }\n        if self.fs_sizes.slot >= 0 {\n            let n = self.fs_sizes.words(self.groups, &mut words);\n");
    buf_str(out, c"            N::render_set_bytes(&mut self.raw, ShaderStage::FRAGMENT,\n                bytes_of_u32(&words[0..n as usize]), self.fs_sizes.slot);\n        }\n    }\n\n    pub fn set_vertex_buffer(&mut self, slot: i64, buf: &Buffer, offset: i64 = 0)\n        requires slot >= 0 && slot < MAX_VERTEX_BUFFERS else \"gpu.limits: vertex buffer slots 0..7\"\n        requires buf.usage & BufferUsage::VERTEX != 0\n        else \"gpu.usage: set_vertex_buffer needs VERTEX\"\n        requires offset % 4 == 0 else \"gpu.align: a vertex buffer's offset is a multiple of 4\"\n        requires offset >= 0 && offset <= buf.size else \"gpu.range: the offset is past the buffer\"\n        requires !buf.mapped else \"gpu.state: the buffer is mapped: unmap it first\"\n    {\n        self.vertex_bytes[slot as usize] = buf.size - offset;\n        N::render_set_vertex_buffer(&mut self.raw, slot, &buf.raw, offset);\n    }\n\n    pub fn set_index_buffer(&mut self, buf: &Buffer, format: IndexFormat,\n        offset: i64 = 0)\n        requires buf.usage & BufferUsage::INDEX != 0 else \"gpu.usage: set_index_buffer needs INDEX\"\n        requires offset % format.size() == 0\n        else \"gpu.align: an index buffer's offset is a multiple of the index size\"\n        requires offset >= 0 && offset <= buf.size else \"gpu.range: the offset is past the buffer\"\n    {\n        self.index_bytes = buf.size - offset;\n        self.index_size = format.size();\n        N::render_set_index_buffer(&mut self.raw, &buf.raw, format, offset);\n    }\n\n    pub fn set_viewport(&mut self, x: f32, y: f32, w: f32, h: f32, min_depth: f32 = 0.0,\n        max_depth: f32 = 1.0)\n        requires w > 0.0 && h > 0.0 && min_depth >= 0.0 && max_depth <= 1.0\n        && min_depth <= max_depth else \"gpu.range: the viewport\"\n        {\n        N::render_set_viewport(&mut self.raw, x, y, w, h, min_depth, max_depth);\n    }\n\n    pub fn set_scissor(&mut self, x: i64, y: i64, w: i64, h: i64)\n");
    buf_str(out, c"        requires x >= 0 && y >= 0 && w >= 0 && h >= 0 && x + w <= self.width && y + h <= self.height\n        else \"gpu.range: the scissor rectangle is outside the target\"\n        {\n        N::render_set_scissor(&mut self.raw, x, y, w, h);\n    }\n\n    pub fn set_blend_constant(&mut self, c: Color) {\n        N::render_set_blend_constant(&mut self.raw, c);\n    }\n\n    // The vertex buffers cover `vertices` and `instances` (wgpu's check).\n    fn check_buffers(&self, vertices_end: i64, instances_end: i64) {\n        for i in 0..self.buffer_count {\n            let n = if self.steps[i as usize] == StepMode::Instance { instances_end }\n                else { vertices_end };\n            if self.strides[i as usize] == 0 || n == 0 { continue; }\n            assert(self.vertex_bytes[i as usize] >= 0,\n                \"gpu.pipeline: a vertex buffer the pipeline reads is not set\");\n            assert(n * self.strides[i as usize] <= self.vertex_bytes[i as usize],\n                \"gpu.range: the draw reads past a vertex buffer\");\n        }\n    }\n\n    /// Draws vertices `vertices` of instances `instances` (`0..3, 0..1`).\n    pub fn draw(&mut self, vertices: Range<i64>, instances: Range<i64>)\n        requires vertices.start >= 0 && vertices.start <= vertices.end && instances.start >= 0\n        && instances.start <= instances.end else \"gpu.range: a draw's ranges\"\n        {\n        self.binds.ready();\n        self.check_buffers(vertices.end, instances.end);\n        if vertices.end == vertices.start || instances.end == instances.start { return; }\n        self.set_sizes();\n        N::draw(&mut self.raw, vertices.start, vertices.end - vertices.start, instances.start,\n            instances.end - instances.start);\n    }\n\n    /// Draws indices `indices` of the index buffer, each plus base_vertex.\n    pub fn draw_indexed(&mut self, indices: Range<i64>, base_vertex: i64,\n        instances: Range<i64>)\n");
    buf_str(out, c"        requires indices.start >= 0 && indices.start <= indices.end && instances.start >= 0\n        && instances.start <= instances.end else \"gpu.range: a draw's ranges\"\n        {\n        self.binds.ready();\n        assert(self.index_size > 0,\n            \"gpu.pipeline: draw_indexed without an index buffer (pass.set_index_buffer)\");\n        assert(indices.end * self.index_size <= self.index_bytes,\n            \"gpu.range: the draw reads past the index buffer\");\n        // the vertices the indices reach are not known on the CPU: the\n        // shaders' accesses are checked instead (design §2.6)\n        self.check_buffers(0, instances.end);\n        if indices.end == indices.start || instances.end == instances.start { return; }\n        self.set_sizes();\n        N::draw_indexed(&mut self.raw, indices.start, indices.end - indices.start, base_vertex,\n            instances.start, instances.end - instances.start);\n    }\n}\n\nimpl Encoder<Gpa> {\n    /// Runs f with a compute pass; the pass ends when f returns.\n    pub fn compute_pass<F: FnMut(&mut ComputePass)>(&mut self, mut f: F)\n        requires self.caps.compute\n        else \"gpu.unsupported: this device has no compute (dev.caps().compute)\"\n        {\n        let mut pass = ComputePass {\n            raw: N::begin_compute(&mut self.raw), binds: Bindings::new(),\n            max_groups: self.limits.max_compute_workgroups_per_dimension,\n            sizes: StageSizes::none(), groups: [GroupBytes::new(); 4],\n            unwritten: Unwritten::new(),\n        };\n        f(&mut pass);\n        N::end_compute(&mut pass.raw);\n        self.unwritten.add(pass.unwritten, -1);\n    }\n\n    /// Runs f with a render pass into desc's attachments; the pass ends\n    /// when f returns. Its pipelines fit its attachments (set_pipeline).\n    pub fn render_pass<F: FnMut(&mut RenderPass)>(&mut self, desc: PassDesc<'_>, mut f: F)\n        requires self.caps.render\n");
    buf_str(out, c"        else \"gpu.unsupported: this device does not render (dev.caps().render)\"\n        requires desc.color_count > 0 || desc.depth.is_some()\n        else \"gpu.state: a render pass needs a color or a depth attachment (PassDesc::color, PassDesc::depth_only)\"\n        requires desc.color_count >= 0 && desc.color_count <= self.limits.max_color_attachments\n        else \"gpu.limits: {} color attachments; the device takes at most {}\", desc.color_count,\n\n    self.limits.max_color_attachments\n        requires color_fault(desc, 0) < 0\n        else \"gpu.usage: color attachment {} needs a texture made with TextureUsage::RENDER_ATTACHMENT\", color_fault(desc, 0)\n        requires color_fault(desc, 1) < 0\n        else \"gpu.format: color attachment {} has a format a pass cannot draw into (a depth format goes in .with_depth)\", color_fault(desc, 1)\n        requires color_fault(desc, 2) < 0\n        else \"gpu.range: color attachment {} has another size than attachment 0: a pass's attachments have one size\", color_fault(desc, 2)\n        requires depth_attachment_fault(desc) != 1\n        else \"gpu.usage: the depth attachment needs a texture made with TextureUsage::RENDER_ATTACHMENT\"\n        requires depth_attachment_fault(desc) != 2\n        else \"gpu.format: the depth attachment's texture has no depth format (Format::Depth32Float)\"\n        requires depth_attachment_fault(desc) != 3\n        else \"gpu.range: the depth attachment's size differs from the color attachments'\"\n        {\n        let mut p = N::pass_new();\n        let mut formats: [Format; 8] = [Format::Rgba8Unorm; 8];\n        for i in 0..desc.color_count {\n            match desc.colors[i as usize] {\n                Some(c) => {\n                    N::pass_color(&mut p, i, &c.view.raw, c.load, c.clear, c.store);\n                    formats[i as usize] = c.view.format;\n                }\n                None => {}\n            }\n        }\n        let width = pass_side(desc, false);\n");
    buf_str(out, c"        let height = pass_side(desc, true);\n        let mut depth: Option<Format> = None;\n        match desc.depth {\n            Some(d) => {\n                N::pass_depth(&mut p, &d.view.raw, d.load, d.clear, d.store);\n                depth = Some(d.view.format);\n            }\n            None => {}\n        }\n        let mut pass = RenderPass {\n            raw: N::begin_render(&mut self.raw, &p),\n            binds: Bindings::new(),\n            formats: formats,\n            color_count: desc.color_count,\n            depth: depth,\n            width: width,\n            height: height,\n            vertex_bytes: [-1; 8],\n            index_bytes: 0,\n            index_size: 0,\n            strides: [0i64; 8],\n            steps: [StepMode::Vertex; 8],\n            buffer_count: 0,\n            vs_sizes: StageSizes::none(),\n            fs_sizes: StageSizes::none(),\n            groups: [GroupBytes::new(); 4],\n            unwritten: Unwritten::new(),\n        };\n        f(&mut pass);\n        N::end_render(&mut pass.raw);\n        self.unwritten.add(pass.unwritten, -1);\n    }\n\n    /// Copies size bytes between buffers.\n    pub fn copy_buffer(&mut self, src: &Buffer, src_offset: i64, dst: &Buffer,\n        dst_offset: i64, size: i64)\n        requires src.usage & BufferUsage::COPY_SRC != 0\n        else \"gpu.usage: copy_buffer's source, its first argument (a buffer of {} bytes), was made without BufferUsage::COPY_SRC: add it where that buffer is made (dev.buffer(size, usage | BufferUsage::COPY_SRC))\", src.size\n        requires dst.usage & BufferUsage::COPY_DST != 0\n        else \"gpu.usage: copy_buffer's destination, its third argument (a buffer of {} bytes), was made without BufferUsage::COPY_DST: add it where that buffer is made (dev.buffer(size, usage | BufferUsage::COPY_DST))\", dst.size\n        requires src_offset % 4 == 0 && dst_offset % 4 == 0 && size % 4 == 0\n        else \"gpu.align: copy offsets and sizes are multiples of 4\"\n");
    buf_str(out, c"        requires src_offset >= 0 && dst_offset >= 0 && size >= 0 && src_offset + size <= src.size\n        && dst_offset + size <= dst.size else \"gpu.range: the copy reaches past a buffer\"\n        requires !dst.mapped\n        else \"gpu.state: copy_buffer's destination, its third argument (a buffer of {} bytes), is mapped (map_read): the copy would change its view. Unmap it (buf.unmap(dev)) when its view is done, or read a copy (map_read_copy_in)\", dst.size\n        requires !src.mapped\n        else \"gpu.state: copy_buffer's source, its first argument (a buffer of {} bytes), is mapped for writing (map_write): unmap it first (buf.unmap(dev)), which sends what was written\", src.size\n        {\n        if size == 0 { return; }\n        self.uses(src);\n        self.uses(dst);\n        if dst.usage & BufferUsage::UNIFORM != 0 { self.unwritten.wrote(buffer_id(dst)); }\n        N::copy_buffer(&mut self.raw, &src.raw, src_offset, &dst.raw, dst_offset, size);\n    }\n\n    /// Copies a region of layer `layer` of tex (the whole of it by default)\n    /// into buf at offset, rows bytes_per_row apart (a multiple of 256).\n    pub fn copy_texture_to_buffer(&mut self, tex: &Texture, buf: &Buffer,\n        bytes_per_row: i64, offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1,\n        layer: i64 = 0)\n        requires tex.desc.usage & TextureUsage::COPY_SRC != 0\n        else \"gpu.usage: copy_texture_to_buffer's texture was made without TextureUsage::COPY_SRC: add it in dev.texture(.., usage: ..)\"\n        requires buf.usage & BufferUsage::COPY_DST != 0\n        else \"gpu.usage: copy_texture_to_buffer's buffer ({} bytes) was made without BufferUsage::COPY_DST: add it where that buffer is made\", buf.size\n        requires bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0\n        else \"gpu.align: bytes_per_row is a multiple of 256\"\n        requires layer >= 0 && layer < tex.desc.layers else \"gpu.range: no such layer\"\n");
    buf_str(out, c"        requires !buf.mapped\n        else \"gpu.state: copy_texture_to_buffer's buffer ({} bytes) is mapped (map_read): the copy would change its view. Unmap it (buf.unmap(dev)) when its view is done, or read a copy (map_read_copy_in)\", buf.size\n        {\n        let ww = if w < 0 { tex.desc.width - x } else { w };\n        let hh = if h < 0 { tex.desc.height - y } else { h };\n        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width\n            && y + hh <= tex.desc.height, \"gpu.range: the region is outside the texture\");\n        assert(bytes_per_row >= ww * tex.desc.format.size(),\n            \"gpu.range: bytes_per_row is shorter than a row\");\n        assert(offset >= 0\n            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,\n            \"gpu.range: the copy reaches past the buffer\");\n        self.uses(buf);\n        if buf.usage & BufferUsage::UNIFORM != 0 { self.unwritten.wrote(buffer_id(buf)); }\n        N::copy_texture_to_buffer(&mut self.raw, &tex.raw, layer, x, y, ww, hh, &buf.raw, offset,\n            bytes_per_row);\n    }\n\n    /// Copies rows of buf (bytes_per_row apart, a multiple of 256) into a\n    /// region of layer `layer` of tex.\n    pub fn copy_buffer_to_texture(&mut self, buf: &Buffer, tex: &Texture,\n        bytes_per_row: i64, offset: i64 = 0, x: i64 = 0, y: i64 = 0, w: i64 = -1, h: i64 = -1,\n        layer: i64 = 0)\n        requires buf.usage & BufferUsage::COPY_SRC != 0\n        else \"gpu.usage: copy_buffer_to_texture's buffer ({} bytes) was made without BufferUsage::COPY_SRC: add it where that buffer is made\", buf.size\n        requires tex.desc.usage & TextureUsage::COPY_DST != 0\n        else \"gpu.usage: copy_buffer_to_texture's texture was made without TextureUsage::COPY_DST: add it in dev.texture(.., usage: ..)\"\n        requires bytes_per_row % 256 == 0 && offset % tex.desc.format.size() == 0\n");
    buf_str(out, c"        else \"gpu.align: bytes_per_row is a multiple of 256\"\n        requires layer >= 0 && layer < tex.desc.layers else \"gpu.range: no such layer\"\n        requires !buf.mapped\n        else \"gpu.state: copy_buffer_to_texture's buffer ({} bytes) is mapped for writing (map_write): unmap it first (buf.unmap(dev)), which sends what was written\", buf.size\n        {\n        let ww = if w < 0 { tex.desc.width - x } else { w };\n        let hh = if h < 0 { tex.desc.height - y } else { h };\n        assert(x >= 0 && y >= 0 && ww >= 1 && hh >= 1 && x + ww <= tex.desc.width\n            && y + hh <= tex.desc.height, \"gpu.range: the region is outside the texture\");\n        assert(bytes_per_row >= ww * tex.desc.format.size(),\n            \"gpu.range: bytes_per_row is shorter than a row\");\n        assert(offset >= 0\n            && offset + bytes_per_row * (hh - 1) + ww * tex.desc.format.size() <= buf.size,\n            \"gpu.range: the copy reaches past the buffer\");\n        self.uses(buf);\n        N::copy_buffer_to_texture(&mut self.raw, &buf.raw, offset, bytes_per_row, &tex.raw, layer,\n            x, y, ww, hh);\n    }\n\n    /// The recorded commands, for `queue.submit`.\n    pub fn finish(self) -> Commands<Gpa> {\n        Commands {\n            raw: self.raw, unwritten: self.unwritten, maps: self.maps, segs: self.segs,\n            stamps: self.stamps, resolve_next: self.resolve_next,\n        }\n    }\n\n    // (0.25.3) A buffer a copy uses: when it is mappable, a handle of it\n    // for submit's gpu.state (once a buffer).\n    fn uses(&mut self, buf: &Buffer) {\n        if buf.usage & (BufferUsage::MAP_READ | BufferUsage::MAP_WRITE) == 0 { return; }\n        let id = buffer_id(buf);\n        for m in self.maps.iter() {\n            if m.raw.ptr as u64 == id { return; }\n        }\n        self.maps.push(N::buffer_handle(&buf.raw));\n    }\n}\n\n// ---- GPU: surfaces and frames (0.22) ----\n\n/// What a window shows: frames drawn into and presented.\n");
    buf_str(out, c"pub struct Surface<A: Allocator> {\n    pub raw: backend::Surface,\n    pub configured: bool,\n    pub width: i64,\n    pub height: i64,\n    pub format: Format,\n    // (0.25.4) the device it was made for, for capture_next_frame\n    dev: backend::Device,\n    gpa: A,\n}\n\n/// A frame of a surface: its texture is the render target; `present`\n/// shows it after the work submitted before.\npub struct Frame<A: Allocator> {\n    pub raw: backend::Frame,\n    pub texture: Texture,\n    // (0.25.4) a capture asked for (capture_next_frame) when it was taken\n    cap: Option<capture::Capture<A>>,\n}\n\nimpl Surface<Gpa> {\n    /// Sizes the surface's frames; vsync: presented at the display's rate.\n    pub fn configure(&mut self, dev: &Device<Gpa>, width: i64, height: i64,\n        format: Format = Format::Bgra8Unorm, vsync: bool = true)\n        requires width >= 1 && height >= 1 && width <= dev.limits.max_texture_dimension_2d\n        && height <= dev.limits.max_texture_dimension_2d else \"gpu.limits: a surface's size\"\n        requires format == Format::Bgra8Unorm || format == Format::Bgra8UnormSrgb\n        || format == Format::Rgba16Float\n        else \"gpu.format: a surface is Bgra8Unorm, Bgra8UnormSrgb or Rgba16Float\"\n        {\n        N::configure(&mut self.raw, &dev.raw, width, height, format, vsync);\n        self.configured = true;\n        self.width = width;\n        self.height = height;\n        self.format = format;\n    }\n\n    /// The next frame to draw (waits for one to be free).\n    pub fn frame(&mut self) -> Result<Frame<Gpa>, Error<Gpa>>\n        requires self.configured else \"gpu.state: configure the surface before taking a frame\"\n    {\n        match N::next_frame(&mut self.raw) {\n            Some((f, t)) => {\n                let desc = TextureDesc {\n                    width: self.width, height: self.height, layers: 1, mips: 1, format: self.format,\n                    usage: TextureUsage::RENDER_ATTACHMENT | TextureUsage::COPY_SRC,\n");
    buf_str(out, c"                };\n                let cap = if crate::capture::capture_pending() {\n                    Some(capture::Capture { dev: self.dev.clone(), gpa: self.gpa })\n                } else {\n                    None\n                };\n                Ok(Frame { raw: f, texture: Texture { raw: t, desc: desc }, cap: cap })\n            }\n            None => Err(Error::SurfaceLost),\n        }\n    }\n}\n\nimpl Frame<Gpa> {\n    /// Shows the frame after the work submitted to queue so far. (0.25.4)\n    /// After capture_next_frame, the frame is also written to its file.\n    pub fn present(self, queue: &mut Queue) {\n        let f = self;\n        match f.cap {\n            Some(cap) => {\n                if crate::capture::capture_pending() {\n                    capture::write_frame(&cap, queue, &f.texture);\n                }\n            }\n            None => {}\n        }\n        N::present(&mut queue.raw, &f.raw);\n    }\n}\n\n// ---- GPU: bytes (0.22) ----\n\n/// The bytes of a slice of f32s (a view of the same memory).\npub fn bytes_of_f32(s: &[f32]) -> &[u8] {\n    // UNSAFE: a view of one element type as another is a raw-pointer slice; std has no safe cast.\n    // SAFETY: s.len() f32s are s.len() * 4 readable bytes at s.ptr, u8 needs no alignment and any\n    // byte is a u8; the result's lifetime is s's.\n    unsafe {\n        crate::slice::from_raw_parts(s.as_ptr() as *const u8, s.len() * 4)\n    }\n}\n\n/// The bytes of a slice of u32s (a view of the same memory).\npub fn bytes_of_u32(s: &[u32]) -> &[u8] {\n    // UNSAFE: a view of one element type as another is a raw-pointer slice; std has no safe cast.\n    // SAFETY: s.len() u32s are s.len() * 4 readable bytes at s.ptr, u8 needs no alignment and any\n    // byte is a u8; the result's lifetime is s's.\n    unsafe {\n        crate::slice::from_raw_parts(s.as_ptr() as *const u8, s.len() * 4)\n    }\n}\n\n/// The bytes of a slice of i32s (a view of the same memory).\n");
    buf_str(out, c"pub fn bytes_of_i32(s: &[i32]) -> &[u8] {\n    // UNSAFE: a view of one element type as another is a raw-pointer slice; std has no safe cast.\n    // SAFETY: s.len() i32s are s.len() * 4 readable bytes at s.ptr, u8 needs no alignment and any\n    // byte is a u8; the result's lifetime is s's.\n    unsafe {\n        crate::slice::from_raw_parts(s.as_ptr() as *const u8, s.len() * 4)\n    }\n}\n\n/// Bytes as f32s (a view): the length a multiple of 4 and the memory\n/// 4-aligned, as mapped buffers are.\npub fn f32s(b: &[u8]) -> &[f32]\n    requires b.len() % 4 == 0 && (b.as_ptr() as u64) % 4 == 0\n    else \"gpu.align: f32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // UNSAFE: a view of bytes as f32s is a raw-pointer slice; std has no safe cast.\n    // SAFETY: the contract checked that b.ptr is 4-aligned and b.len() a multiple of 4, so the\n    // b.len() / 4 f32s lie within b; every bit pattern is an f32; the result's lifetime is b's.\n    unsafe {\n        crate::slice::from_raw_parts(b.as_ptr() as *const f32, b.len() / 4)\n    }\n}\n\n/// Bytes as u32s (a view), as f32s.\npub fn u32s(b: &[u8]) -> &[u32]\n    requires b.len() % 4 == 0 && (b.as_ptr() as u64) % 4 == 0\n    else \"gpu.align: u32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // UNSAFE: a view of bytes as u32s is a raw-pointer slice; std has no safe cast.\n    // SAFETY: the contract checked that b.ptr is 4-aligned and b.len() a multiple of 4, so the\n    // b.len() / 4 u32s lie within b; every bit pattern is a u32; the result's lifetime is b's.\n    unsafe {\n        crate::slice::from_raw_parts(b.as_ptr() as *const u32, b.len() / 4)\n    }\n}\n\n/// Bytes as i32s (a view), as f32s.\npub fn i32s(b: &[u8]) -> &[i32]\n    requires b.len() % 4 == 0 && (b.as_ptr() as u64) % 4 == 0\n    else \"gpu.align: i32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // UNSAFE: a view of bytes as i32s is a raw-pointer slice; std has no safe cast.\n");
    buf_str(out, c"    // SAFETY: the contract checked that b.ptr is 4-aligned and b.len() a multiple of 4, so the\n    // b.len() / 4 i32s lie within b; every bit pattern is an i32; the result's lifetime is b's.\n    unsafe {\n        crate::slice::from_raw_parts(b.as_ptr() as *const i32, b.len() / 4)\n    }\n}\n\n/// The same bytes, writable, as u32s (a view of mapped memory).\npub fn u32s_mut(b: &mut [u8]) -> &mut [u32]\n    requires b.len() % 4 == 0 && (b.as_ptr() as u64) % 4 == 0\n    else \"gpu.align: u32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // UNSAFE: a writable view of bytes as u32s is a raw-pointer slice; std has no safe cast.\n    // SAFETY: the contract checked that b.ptr is 4-aligned and b.len() a multiple of 4, so the\n    // u32s lie within b; every bit pattern is a u32; b is &mut, so this view is the only\n    // access to those bytes while it lives.\n    unsafe {\n        crate::slice::from_raw_parts_mut(b.as_mut_ptr() as *mut u32, b.len() / 4)\n    }\n}\n\n/// The same bytes, writable, as f32s.\npub fn f32s_mut(b: &mut [u8]) -> &mut [f32]\n    requires b.len() % 4 == 0 && (b.as_ptr() as u64) % 4 == 0\n    else \"gpu.align: f32s needs 4-aligned bytes, a multiple of 4\"\n    {\n    // UNSAFE: a writable view of bytes as f32s is a raw-pointer slice; std has no safe cast.\n    // SAFETY: the contract checked that b.ptr is 4-aligned and b.len() a multiple of 4, so the\n    // f32s lie within b; every bit pattern is an f32; b is &mut, so this view is the only\n    // access to those bytes while it lives.\n    unsafe {\n        crate::slice::from_raw_parts_mut(b.as_mut_ptr() as *mut f32, b.len() / 4)\n    }\n}\n// ---- mod std::gpu::capture ----\nmod capture {\n// EDITION: rust\n// std::gpu::capture (0.25.4): the next frame presented, to a file (below).\n\nuse crate::fs;\nuse crate::alloc::Allocator;\nuse crate::gpu::{Format, Queue, Texture};\nuse crate::gpu::hal::metal as backend;\n\ntype N = backend::Metal;\n\n// ---- GPU: capturing a frame (0.25.4) ----\n\n");
    buf_str(out, c"// std::gpu::capture (0.25.4): the next frame presented, written to a\n// file. A test of a windowed program asks for it (std::window's scripted\n// event loop, its `shot FILE` command), and so can a program that wants a\n// screenshot of itself: `gpu::capture_next_frame(\"shot.ppm\")`, then the\n// next `frame.present(&queue)` of any surface also writes that frame, with\n// everything submitted before it, as a binary PPM (P6, RGB). The request\n// itself is std::capture's (std::window makes it).\n\n/// What a frame needs to be captured: its surface's device.\npub struct Capture<A: Allocator> {\n    pub dev: backend::Device,\n    pub gpa: A,\n}\n\n// Writes tex (a frame's texture, after the work submitted to queue) to\n// the file asked for, and forgets the request. Stderr says why when it\n// cannot.\npub fn write_frame(cap: &Capture<Gpa>, queue: &mut Queue, tex: &Texture) {\n    let mut path: String<Gpa> = String::new_in(cap.gpa);\n    if !crate::capture::take_capture(&mut path) {\n        return;\n    }\n    let w = tex.desc.width;\n    let h = tex.desc.height;\n    let format = tex.desc.format;\n    let half = format == Format::Rgba16Float;\n    if !half && format != Format::Bgra8Unorm && format != Format::Bgra8UnormSrgb {\n        eprintln(\n            \"gpu.capture: a frame of this format is not captured; {} is not written | help: configure the surface with Format::Bgra8Unorm\", path.as_str());\n        return;\n    }\n    let texel = format.size();\n    let stride = (w * texel + 255) / 256 * 256;\n    let mut buf = match N::create_buffer(&cap.dev, stride * h, &[]) {\n        Some(b) => b,\n        None => {\n            eprintln(\n                \"gpu.capture: no memory for a {w} x {h} frame; {} is not written\",\n                path.as_str());\n            return;\n        }\n    };\n    let mut cb = N::begin(&cap.dev);\n    N::copy_texture_to_buffer(&mut cb, &tex.raw, 0, 0, 0, w, h, &buf, 0, stride);\n    N::submit(&mut queue.raw, &mut cb);\n");
    buf_str(out, c"    if !N::queue_wait_idle(&mut queue.raw) {\n        eprintln(\n            \"gpu.capture: the frame's work failed on the GPU; {} is not written\",\n            path.as_str());\n        return;\n    }\n    let px = N::map_read(&cap.dev, &mut buf);\n    let mut ppm: Vec<u8, Gpa> = format_in(\"P6\\n{w} {h}\\n255\\n\", cap.gpa).into_bytes();\n    ppm.reserve((w * h * 3) as usize);\n    for y in 0..h {\n        for x in 0..w {\n            let p = y * stride + x * texel;\n            if half {\n                ppm.push(unorm8(half_bits(px[p as usize], px[(p + 1) as usize])));\n                ppm.push(unorm8(half_bits(px[(p + 2) as usize], px[(p + 3) as usize])));\n                ppm.push(unorm8(half_bits(px[(p + 4) as usize], px[(p + 5) as usize])));\n            } else {\n                ppm.push(px[(p + 2) as usize]);\n                ppm.push(px[(p + 1) as usize]);\n                ppm.push(px[p as usize]);\n            }\n        }\n    }\n    N::unmap(&cap.dev, &mut buf);\n    match fs::write(path.as_str(), ppm.as_slice()) {\n        Ok(_) => {}\n        Err(e) => eprintln(\"gpu.capture: {} could not be written: {e}\",\n            path.as_str()),\n    }\n}\n\n// A little-endian binary16, as an f64.\nfn half_bits(lo: u8, hi: u8) -> f64 {\n    let bits = (hi as u32) << 8 | lo as u32;\n    let sign = if (bits & 0x8000) != 0 { -1.0 } else { 1.0 };\n    let e = ((bits >> 10) & 0x1F) as i64;\n    let m = (bits & 0x3FF) as f64;\n    if e == 0 {\n        return sign * m / 1024.0 / 16384.0;\n    }\n    if e == 31 {\n        return sign * 65504.0;\n    }\n    let mut v = 1.0 + m / 1024.0;\n    let mut k = e - 15;\n    while k > 0 {\n        v = v * 2.0;\n        k -= 1;\n    }\n    while k < 0 {\n        v = v / 2.0;\n        k += 1;\n    }\n    sign * v\n}\n\n// 0..1 to 0..255, clamped and rounded.\nfn unorm8(v: f64) -> u8 {\n    if v <= 0.0 { return 0; }\n    if v >= 1.0 { return 255; }\n    (v * 255.0 + 0.5) as u8\n}\n// ---- end mod std::gpu::capture ----\n}\n");
    buf_str(out, c"// ---- mod std::gpu::hal ----\npub mod hal {\n// EDITION: rust\n// std::gpu::hal (0.22, docs/design/gpu.md §2.1, §2.8): the backend\n// interface. A backend implements `Api` (devices, memory, compute,\n// copies, submission) and, when it can draw, `Render<Self>` (render\n// pipelines, passes, surfaces). A compute-only backend (CUDA, a CPU\n// fallback) implements `Api` alone and reports `render: false` in its\n// Caps; the public API checks the caps before any render call, so no\n// backend writes stubs. Metal (hal::metal) implements both; Vulkan (G3)\n// will. The design's \"CUDA readiness\" section lists what a new backend\n// needs.\n//\n// The rules of the hal:\n// - Everything is static: no `dyn`; the public API names the backend of\n//   the build (`std::gpu::Native`).\n// - The hal validates nothing: std::gpu checks its contracts first.\n// - Every hal type is an owned value: dropping it releases what it holds\n//   (a resource dropped while the GPU still uses it stays alive until the\n//   work that uses it is done: the backend's business).\n// - Memory is not assumed shared: buffers are reached by map_read,\n//   map_write and unmap, which a discrete-memory backend implements with\n//   staging copies; `Caps::unified_memory` is information only.\n// - A function returning Option fails with None when the driver refuses\n//   (out of memory, a shader or pipeline it rejects); its `err` Buf, when\n//   it takes one, gets the driver's message.\n\nuse crate::alloc::Allocator;\nuse crate::fmt::Debug;\npub mod metal;\n\nuse crate::gpu::shader::{Binding, EntryPoint, ShaderKind, ShaderSource};\nuse crate::gpu::types::{Color, Format, IndexFormat, Load, PipelineState, SamplerDesc, TextureDesc};\n\n// ---- The GPU backend interface (0.22) ----\n\n/// What a backend (and its device) can do.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct Caps {\n    /// Compute pipelines and dispatches.\n    pub compute: bool,\n");
    buf_str(out, c"    /// Render pipelines and passes (the backend implements Render).\n    pub render: bool,\n    /// Surfaces: presenting to windows.\n    pub surfaces: bool,\n    /// Textures and samplers bound to shaders (sampled and storage).\n    pub textures: bool,\n    /// Host and device share memory (mapping copies nothing). Information\n    /// only: the API behaves the same either way.\n    pub unified_memory: bool,\n    /// The form of shaders the backend takes (the shader compiler's\n    /// target).\n    pub shader_kind: ShaderKind,\n    /// (0.25.4) GPU timestamps: query sets, timed passes (gpu_times).\n    pub timestamps: bool,\n}\n\n/// A window system's handle for a surface (what std::window gives).\n#[derive(PartialEq, Eq, Clone, Copy)]\npub enum RawSurface {\n    /// A CAMetalLayer (macOS): the layer's pointer.\n    MetalLayer(*mut u8),\n    /// No window: a surface whose frames are offscreen textures.\n    Headless,\n}\n\n// (0.20: by hand: a derived Clone of a raw pointer field calls clone_of::<*u8>,\n// which does not compile yet)\n\n/// (0.25.3) A buffer's map state (Api::map_state): mapped by map_read, by\n/// map_write; 0, not mapped.\npub const MAPPED_READ: i64 = 1;\npub const MAPPED_WRITE: i64 = 2;\n\npub trait Api {\n    type Adapter;\n    type Device;\n    type Queue;\n    type Buffer;\n    type Texture;\n    type TextureView;\n    type Sampler;\n    type Shader;\n    type ComputePipeline;\n    type BindGroup;\n    type CommandBuffer;\n    type ComputeEncoder;\n\n    // ---- adapters and devices ----\n    fn adapters<A: Allocator>(out: &mut Vec<Self::Adapter, A>);\n    fn default_adapter() -> Option<Self::Adapter>;\n    fn adapter_name<A: Allocator>(a: &Self::Adapter, out: &mut String<A>);\n    fn adapter_low_power(a: &Self::Adapter) -> bool;\n    /// The largest buffer the adapter makes, in bytes (Metal's\n    /// maxBufferLength).\n    fn adapter_max_buffer_size(a: &Self::Adapter) -> i64;\n");
    buf_str(out, c"    fn open(a: &Self::Adapter) -> Option<(Self::Device, Self::Queue)>;\n    fn caps(d: &Self::Device) -> Caps;\n    /// Waits for everything submitted to the device.\n    fn device_wait_idle(d: &Self::Device);\n\n    // ---- memory and resources ----\n    /// A buffer of size bytes holding init (zeros past it), not mapped.\n    fn create_buffer(d: &Self::Device, size: i64, init: &[u8]) -> Option<Self::Buffer>;\n    /// (0.25.3) Another handle to b's native buffer: it keeps the buffer\n    /// alive and sees its map state (recorded commands keep one, for\n    /// submit's check).\n    fn buffer_handle(b: &Self::Buffer) -> Self::Buffer;\n    /// (0.25.3) The map state of b's native buffer, the same through every\n    /// handle of it: 0, MAPPED_READ or MAPPED_WRITE.\n    fn map_state(b: &Self::Buffer) -> i64;\n    /// The buffer's bytes as the GPU left them (the caller waited); its\n    /// map state is MAPPED_READ until unmap.\n    fn map_read<'a>(d: &Self::Device, b: &'a mut Self::Buffer) -> &'a [u8];\n    /// The buffer's bytes to write; they reach the GPU at unmap. Its map\n    /// state is MAPPED_WRITE until then.\n    fn map_write<'a>(d: &Self::Device, b: &'a mut Self::Buffer) -> &'a mut [u8];\n    /// Ends a mapping: the map state is 0 again.\n    fn unmap(d: &Self::Device, b: &mut Self::Buffer);\n    fn create_texture(d: &Self::Device, desc: TextureDesc) -> Option<Self::Texture>;\n    /// A view of t, of t's own format or another of the same size.\n    fn create_view(t: &Self::Texture, format: Format, same_format: bool) -> Option<Self::TextureView>;\n    fn create_sampler(d: &Self::Device, desc: SamplerDesc) -> Option<Self::Sampler>;\n    fn create_shader<A: Allocator>(d: &Self::Device, src: &ShaderSource<'_>, err: &mut String<A>) -> Option<Self::Shader>;\n\n    fn create_compute_pipeline<A: Allocator>(d: &Self::Device, s: &Self::Shader,\n        entry: &EntryPoint<'_>, err: &mut String<A>) -> Option<Self::ComputePipeline>;\n\n");
    buf_str(out, c"    // ---- bind groups: resources at the slots their bindings name ----\n    fn bind_group_new(d: &Self::Device) -> Self::BindGroup;\n\n    fn bind_group_buffer(g: &mut Self::BindGroup, b: Binding, buf: &Self::Buffer, offset: i64,\n        size: i64);\n\n    fn bind_group_texture(g: &mut Self::BindGroup, b: Binding, v: &Self::TextureView);\n    fn bind_group_sampler(g: &mut Self::BindGroup, b: Binding, s: &Self::Sampler);\n\n    // ---- recording ----\n    fn begin(d: &Self::Device) -> Self::CommandBuffer;\n\n    fn copy_buffer(cb: &mut Self::CommandBuffer, src: &Self::Buffer, src_offset: i64,\n        dst: &Self::Buffer, dst_offset: i64, size: i64);\n\n    fn copy_texture_to_buffer(cb: &mut Self::CommandBuffer, src: &Self::Texture, layer: i64, x: i64,\n        y: i64, w: i64, h: i64, dst: &Self::Buffer, offset: i64, bytes_per_row: i64);\n\n    fn copy_buffer_to_texture(cb: &mut Self::CommandBuffer, src: &Self::Buffer, offset: i64,\n        bytes_per_row: i64, dst: &Self::Texture, layer: i64, x: i64, y: i64, w: i64, h: i64);\n\n    fn begin_compute(cb: &mut Self::CommandBuffer) -> Self::ComputeEncoder;\n    fn compute_set_pipeline(e: &mut Self::ComputeEncoder, p: &Self::ComputePipeline);\n    fn compute_set_bind_group(e: &mut Self::ComputeEncoder, g: &Self::BindGroup);\n    fn dispatch(e: &mut Self::ComputeEncoder, x: i64, y: i64, z: i64);\n    /// (0.22) Small data at a native slot of the compute stage, copied now\n    /// (Metal's setBytes): the sizes buffer.\n    fn compute_set_bytes(e: &mut Self::ComputeEncoder, bytes: &[u8], slot: i64);\n    fn end_compute(e: &mut Self::ComputeEncoder);\n\n    // ---- submission ----\n    /// Submits cb (it is empty afterwards).\n    fn submit(q: &mut Self::Queue, cb: &mut Self::CommandBuffer);\n    /// Writes data at offset, ordered after the work submitted before and\n    /// before the work submitted next.\n    fn write_buffer(q: &mut Self::Queue, b: &Self::Buffer, offset: i64, data: &[u8]);\n\n");
    buf_str(out, c"    fn write_texture(q: &mut Self::Queue, t: &Self::Texture, layer: i64, x: i64, y: i64, w: i64,\n        h: i64, data: &[u8], bytes_per_row: i64);\n\n    /// Waits for everything submitted to q; false if a submission failed.\n    fn queue_wait_idle(q: &mut Self::Queue) -> bool;\n\n    // ---- GPU times (0.25.4) ----\n    /// Submits cb as `submit` does, and cb keeps a handle to the work for\n    /// gpu_times.\n    fn submit_timed(q: &mut Self::Queue, cb: &mut Self::CommandBuffer);\n    /// Waits for the work cb submitted (submit_timed), then gives when it\n    /// began and ended on the GPU, in ns of one clock; None when it failed\n    /// or the backend has no GPU clock (Caps::timestamps).\n    fn gpu_times(cb: &mut Self::CommandBuffer) -> Option<(u64, u64)>;\n}\n\n/// What a backend that draws adds (its Caps say `render: true`).\npub trait Render<B: Api> {\n    type RenderPipeline;\n    type RenderEncoder;\n    type PassDesc;\n    type Surface;\n    type Frame;\n\n    fn create_render_pipeline(d: &B::Device, vs: &B::Shader, vs_entry: EntryPoint<'_>,\n        fs: &B::Shader, fs_entry: EntryPoint<'_>, has_fs: bool, state: PipelineState,\n        err: &mut String<Gpa>) -> Option<Self::RenderPipeline>;\n\n    fn pass_new() -> Self::PassDesc;\n\n    fn pass_color(p: &mut Self::PassDesc, i: i64, v: &B::TextureView, load: Load, clear: Color,\n        store: bool);\n\n    fn pass_depth(p: &mut Self::PassDesc, v: &B::TextureView, load: Load, clear: f64, store: bool);\n    fn begin_render(cb: &mut B::CommandBuffer, p: &Self::PassDesc) -> Self::RenderEncoder;\n    fn render_set_pipeline(e: &mut Self::RenderEncoder, p: &Self::RenderPipeline);\n    fn render_set_bind_group(e: &mut Self::RenderEncoder, g: &B::BindGroup);\n    fn render_set_vertex_buffer(e: &mut Self::RenderEncoder, slot: i64, b: &B::Buffer, offset: i64);\n\n    fn render_set_index_buffer(e: &mut Self::RenderEncoder, b: &B::Buffer, format: IndexFormat,\n        offset: i64);\n\n");
    buf_str(out, c"    fn render_set_viewport(e: &mut Self::RenderEncoder, x: f32, y: f32, w: f32, h: f32,\n        min_depth: f32, max_depth: f32);\n\n    fn render_set_scissor(e: &mut Self::RenderEncoder, x: i64, y: i64, w: i64, h: i64);\n    fn render_set_blend_constant(e: &mut Self::RenderEncoder, c: Color);\n\n    fn draw(e: &mut Self::RenderEncoder, first_vertex: i64, vertices: i64, first_instance: i64,\n        instances: i64);\n\n    fn draw_indexed(e: &mut Self::RenderEncoder, first_index: i64, indices: i64, base_vertex: i64,\n        first_instance: i64, instances: i64);\n\n    /// (0.22) Small data at a native slot of the vertex or fragment stage\n    /// (ShaderStage::VERTEX, FRAGMENT), copied now: the sizes buffer.\n    fn render_set_bytes(e: &mut Self::RenderEncoder, stage: u32, bytes: &[u8], slot: i64);\n    fn end_render(e: &mut Self::RenderEncoder);\n\n    // ---- surfaces ----\n    fn create_surface(d: &B::Device, raw: RawSurface) -> Option<Self::Surface>;\n\n    fn configure(s: &mut Self::Surface, d: &B::Device, width: i64, height: i64, format: Format,\n        vsync: bool);\n\n    /// The next frame and its texture; None when the surface has none to\n    /// give (outdated, or no drawable within the timeout).\n    fn next_frame(s: &mut Self::Surface) -> Option<(Self::Frame, B::Texture)>;\n    /// Shows the frame after the work submitted to q so far.\n    fn present(q: &mut B::Queue, f: &Self::Frame);\n}\n// ---- mod std::gpu::hal::metal ----\npub mod metal {\n// EDITION: rust\n// std::gpu::hal::metal (0.22, docs/design/gpu.md §2.8): hal::Api and\n// hal::Render for Metal, through std::objc and the generated bindings\n// (bindings.vl, from compiler/std/objc/tables/metal.objc: every method\n// checked against the runtime, every constant and struct against the\n// SDK's headers).\n//\n// - Metal is opened at run time (objc::framework): a program links only\n//   libobjc (`-l objc`).\n// - Buffers are MTLResourceStorageModeShared (Apple silicon: unified\n");
    buf_str(out, c"//   memory, mapping copies nothing); textures are Private and reached by\n//   blits.\n// - Commands are encoded straight into Metal's encoders. Command buffers\n//   retain what they use (Metal's default), so dropping a resource while\n//   the GPU uses it is safe; unretained command buffers with submission\n//   tracking are a later optimization (design §2.3).\n// - Nothing runs off the main thread (§2.11): the CPU waits with\n//   waitUntilCompleted, never a completion handler.\n// - Objects Metal returns autoreleased (command buffers, encoders,\n//   drawables, errors) are retained inside an autorelease pool scoped to\n//   the call.\n\nuse crate::mem;\nuse crate::alloc::Allocator;\nuse crate::sync::atomic::{Atomic, Ordering};\npub mod bindings;\n\nuse crate::gpu::hal::{Api, Caps, MAPPED_READ, MAPPED_WRITE, RawSurface, Render};\nuse crate::gpu::shader::{Binding, EntryPoint, ShaderKind, ShaderSource};\nuse crate::gpu::types::{\n    AddressMode, BlendFactor, BlendOp, Color, Compare, Cull, Filter, Format, FrontFace, IndexFormat,\n    Load, PipelineState,\n};\nuse crate::gpu::types::SamplerDesc; use crate::gpu::types::ShaderStage;\nuse crate::gpu::types::StepMode; use crate::gpu::types::TextureDesc;\nuse crate::gpu::types::TextureUsage; use crate::gpu::types::Topology;\nuse crate::gpu::types::VertexFormat;\nuse crate::objc::{Id, Ref};\nuse crate::objc::foundation::{NSArray, NSError};\n\nuse bindings::{\n    CAMetalDrawable, CAMetalLayer, CGSize, MTLBlitCommandEncoder, MTLBuffer, MTLClearColor,\n    MTLCommandBuffer, MTLCommandQueue, MTLCompileOptions, MTLComputeCommandEncoder,\n    MTLComputePipelineState, MTLDepthStencilDescriptor, MTLDepthStencilState, MTLDevice,\n    MTLFunction, MTLLibrary, MTLOrigin, MTLRenderCommandEncoder,\n    MTLRenderPassAttachmentDescriptorMethods, MTLRenderPassDepthAttachmentDescriptorMethods,\n    MTLRenderPassDescriptor, MTLRenderPipelineDescriptor, MTLRenderPipelineState,\n");
    buf_str(out, c"    MTLSamplerDescriptor, MTLSamplerState, MTLScissorRect, MTLSize, MTLTexture,\n    MTLTextureDescriptor, MTLTextureMethods, MTLVertexAttributeDescriptorMethods,\n    MTLVertexBufferLayoutDescriptorMethods, MTLVertexDescriptor, MTLViewport,\n};\n\n// (0.25) The Objective-C runtime (#[link]); Metal and QuartzCore are\n// opened at run time (std::objc::framework).\n// UNSAFE: C functions of the Objective-C runtime; C calls cannot be checked.\n// SAFETY: the prototypes are objc/runtime.h's: id objc_retain(id), void objc_release(id).\n#[link(lib = \"objc\")]\nextern \"C\" {\n    fn objc_retain(o: *mut u8) -> *mut u8;\n    fn objc_release(o: *mut u8);\n}\n\n// UNSAFE: the C library's memcpy, for copies into a buffer's shared memory, which only a raw\n// pointer reaches.\n// SAFETY: the prototype is string.h's; each call states its bounds.\nextern \"C\" {\n    fn memcpy(dst: *mut u8, src: *mut u8, n: u64) -> *mut u8;\n}\n\n// ---- GPU on Metal: devices, memory, resources (0.22) ----\n\n/// The Metal implementation of hal::Api and hal::Render.\n#[derive(Clone, Copy)] pub struct Metal {}\n\npub struct Adapter {\n    pub dev: Id<MTLDevice>,\n}\n\npub struct Device {\n    pub dev: Id<MTLDevice>,\n    pub queue: Id<MTLCommandQueue>,\n}\n\n// (0.25.4) Another handle to the same device and queue (a retain each).\nimpl Clone for Device {\n    fn clone(&self) -> Device {\n        Device { dev: self.dev.clone(), queue: self.queue.clone() }\n    }\n}\n\npub struct Queue {\n    pub q: Id<MTLCommandQueue>,\n    pub last: Id<MTLCommandBuffer>,\n}\n\n/// A buffer: its MTLBuffer, the contents pointer and the size asked for.\n/// The MTLBuffer holds STATE_BYTES more, past the buffer's own bytes: its\n/// map state (0.25.3, `map_state`), which every handle of it sees.\npub struct Buffer {\n    pub raw: Id<MTLBuffer>,\n    pub ptr: *mut u8,\n    pub size: i64,\n}\n\n// (0.25.3) The bytes create_buffer adds past a buffer's own for its map\n");
    buf_str(out, c"// state (one byte used): the state is the native buffer's, so a handle\n// kept by recorded commands (buffer_handle) sees a map_read made after\n// the commands were recorded.\nconst STATE_BYTES: i64 = 4;\n\n// Where a buffer of `size` bytes keeps its map state: past its bytes (a\n// buffer is at least 4 bytes, create_buffer's n).\nfn state_offset(size: i64) -> i64 {\n    if size < 4 { 4 } else { size }\n}\n\nfn set_map_state(b: &mut Buffer, state: i64) {\n    let at = state_offset(b.size);\n    // UNSAFE: the state is in the MTLBuffer's own shared memory, which only its contents pointer reaches (Metal has no field to keep it in, and a table beside the buffers would outlive the ones dropped while mapped)\n    // SAFETY: create_buffer made the MTLBuffer state_offset(size) + STATE_BYTES bytes long, b.ptr is its contents and b.raw keeps it alive, so b.ptr[at] is in it; one byte, no alignment; the GPU never writes there (std::gpu's contracts keep copies and bindings below size)\n    unsafe { (*b.ptr.add(at as usize)) = state as u8; }\n}\n\npub struct Texture {\n    pub raw: Id<MTLTexture>,\n}\n\npub struct TextureView {\n    pub raw: Id<MTLTexture>,\n}\n\npub struct Sampler {\n    pub raw: Id<MTLSamplerState>,\n}\n\npub struct Shader {\n    pub lib: Id<MTLLibrary>,\n}\n\npub struct ComputePipeline {\n    pub raw: Id<MTLComputePipelineState>,\n    pub workgroup: MTLSize,\n}\n\npub struct RenderPipeline {\n    pub raw: Id<MTLRenderPipelineState>,\n    pub depth: Id<MTLDepthStencilState>,\n    pub primitive: u64,\n    pub cull: u64,\n    pub winding: u64,\n}\n\n/// One resource of a bind group, with its slot in each stage (-1: none).\n/// `obj` is retained by the group.\n#[derive(Clone, Copy)] pub struct Bound {\n    pub kind: i64,\n    pub vs: i64,\n    pub fs: i64,\n    pub cs: i64,\n    pub obj: *mut u8,\n    pub offset: u64,\n}\n\nconst BIND_BUFFER: i64 = 0;\nconst BIND_TEXTURE: i64 = 1;\nconst BIND_SAMPLER: i64 = 2;\npub const MAX_BOUND: i64 = 16;\n\n");
    buf_str(out, c"/// A bind group: its resources (retained: the group keeps them alive) and\n/// where they go, in a fixed array (no allocation).\npub struct BindGroup {\n    pub items: [Bound; 16],\n    pub count: i64,\n}\n\nimpl Drop for BindGroup {\n    fn drop(&mut self) {\n        for i in 0..self.count {\n            // UNSAFE: objc_release is a C call; the group's objects are raw pointers (Bound.obj).\n            // SAFETY: items[0..count] were made by `bound`, which retained each obj once; this\n            // drop releases each once and then sets count to 0, so none is released twice.\n            unsafe { objc_release(self.items[i as usize].obj); }\n        }\n        self.count = 0;\n    }\n}\n\npub struct CommandBuffer {\n    pub cb: Id<MTLCommandBuffer>,\n    pub blit: Id<MTLBlitCommandEncoder>,\n}\n\nimpl Drop for CommandBuffer {\n    fn drop(&mut self) {\n        end_blit(self);\n    }\n}\n\npub struct ComputeEncoder {\n    pub enc: Id<MTLComputeCommandEncoder>,\n    pub workgroup: MTLSize,\n}\n\nimpl Drop for ComputeEncoder {\n    fn drop(&mut self) {\n        if !self.enc.is_nil() { self.enc.r().end_encoding(); }\n    }\n}\n\npub struct RenderEncoder {\n    pub enc: Id<MTLRenderCommandEncoder>,\n    pub primitive: u64,\n    pub index: Id<MTLBuffer>,\n    pub index_type: u64,\n    pub index_size: i64,\n    pub index_offset: i64,\n}\n\nimpl Drop for RenderEncoder {\n    fn drop(&mut self) {\n        if !self.enc.is_nil() { self.enc.r().end_encoding(); }\n    }\n}\n\npub struct PassDesc {\n    pub raw: Id<MTLRenderPassDescriptor>,\n}\n\npub struct Surface {\n    pub layer: Id<CAMetalLayer>,\n}\n\npub struct Frame {\n    pub drawable: Id<CAMetalDrawable>,\n}\n\n// ---- GPU on Metal: conversions (0.22) ----\n\n#[pure]\npub fn pixel_format(f: Format) -> u64 {\n    match f {\n        Format::R8Unorm => bindings::MTLPixelFormatR8Unorm,\n        Format::R8Uint => bindings::MTLPixelFormatR8Uint,\n        Format::Rg8Unorm => bindings::MTLPixelFormatRG8Unorm,\n");
    buf_str(out, c"        Format::R16Float => bindings::MTLPixelFormatR16Float,\n        Format::R32Uint => bindings::MTLPixelFormatR32Uint,\n        Format::R32Sint => bindings::MTLPixelFormatR32Sint,\n        Format::R32Float => bindings::MTLPixelFormatR32Float,\n        Format::Rg16Float => bindings::MTLPixelFormatRG16Float,\n        Format::Rgba8Unorm => bindings::MTLPixelFormatRGBA8Unorm,\n        Format::Rgba8UnormSrgb => bindings::MTLPixelFormatRGBA8Unorm_sRGB,\n        Format::Rgba8Uint => bindings::MTLPixelFormatRGBA8Uint,\n        Format::Bgra8Unorm => bindings::MTLPixelFormatBGRA8Unorm,\n        Format::Bgra8UnormSrgb => bindings::MTLPixelFormatBGRA8Unorm_sRGB,\n        Format::Rg32Float => bindings::MTLPixelFormatRG32Float,\n        Format::Rgba16Float => bindings::MTLPixelFormatRGBA16Float,\n        Format::Rgba32Uint => bindings::MTLPixelFormatRGBA32Uint,\n        Format::Rgba32Float => bindings::MTLPixelFormatRGBA32Float,\n        Format::Depth32Float => bindings::MTLPixelFormatDepth32Float,\n    }\n}\n\n#[pure]\nfn vertex_format(f: VertexFormat) -> u64 {\n    match f {\n        VertexFormat::Float32 => bindings::MTLVertexFormatFloat,\n        VertexFormat::Float32x2 => bindings::MTLVertexFormatFloat2,\n        VertexFormat::Float32x3 => bindings::MTLVertexFormatFloat3,\n        VertexFormat::Float32x4 => bindings::MTLVertexFormatFloat4,\n        VertexFormat::Uint32 => bindings::MTLVertexFormatUInt,\n        VertexFormat::Uint32x2 => bindings::MTLVertexFormatUInt2,\n        VertexFormat::Uint32x4 => bindings::MTLVertexFormatUInt4,\n        VertexFormat::Sint32 => bindings::MTLVertexFormatInt,\n        VertexFormat::Unorm8x4 => bindings::MTLVertexFormatUChar4Normalized,\n    }\n}\n\n#[pure]\nfn compare_function(c: Compare) -> u64 {\n    match c {\n        Compare::Never => bindings::MTLCompareFunctionNever,\n        Compare::Less => bindings::MTLCompareFunctionLess,\n        Compare::Equal => bindings::MTLCompareFunctionEqual,\n");
    buf_str(out, c"        Compare::LessEqual => bindings::MTLCompareFunctionLessEqual,\n        Compare::Greater => bindings::MTLCompareFunctionGreater,\n        Compare::NotEqual => bindings::MTLCompareFunctionNotEqual,\n        Compare::GreaterEqual => bindings::MTLCompareFunctionGreaterEqual,\n        Compare::Always => bindings::MTLCompareFunctionAlways,\n    }\n}\n\n#[pure]\nfn blend_factor(f: BlendFactor) -> u64 {\n    match f {\n        BlendFactor::Zero => bindings::MTLBlendFactorZero,\n        BlendFactor::One => bindings::MTLBlendFactorOne,\n        BlendFactor::Src => bindings::MTLBlendFactorSourceColor,\n        BlendFactor::OneMinusSrc => bindings::MTLBlendFactorOneMinusSourceColor,\n        BlendFactor::SrcAlpha => bindings::MTLBlendFactorSourceAlpha,\n        BlendFactor::OneMinusSrcAlpha => bindings::MTLBlendFactorOneMinusSourceAlpha,\n        BlendFactor::Dst => bindings::MTLBlendFactorDestinationColor,\n        BlendFactor::OneMinusDst => bindings::MTLBlendFactorOneMinusDestinationColor,\n        BlendFactor::DstAlpha => bindings::MTLBlendFactorDestinationAlpha,\n        BlendFactor::OneMinusDstAlpha => bindings::MTLBlendFactorOneMinusDestinationAlpha,\n    }\n}\n\n#[pure]\nfn blend_op(o: BlendOp) -> u64 {\n    match o {\n        BlendOp::Add => bindings::MTLBlendOperationAdd,\n        BlendOp::Subtract => bindings::MTLBlendOperationSubtract,\n        BlendOp::ReverseSubtract => bindings::MTLBlendOperationReverseSubtract,\n        BlendOp::Min => bindings::MTLBlendOperationMin,\n        BlendOp::Max => bindings::MTLBlendOperationMax,\n    }\n}\n\n#[pure]\nfn filter(f: Filter) -> u64 {\n    match f {\n        Filter::Nearest => bindings::MTLSamplerMinMagFilterNearest,\n        Filter::Linear => bindings::MTLSamplerMinMagFilterLinear,\n    }\n}\n\n#[pure]\nfn address_mode(a: AddressMode) -> u64 {\n    match a {\n        AddressMode::ClampToEdge => bindings::MTLSamplerAddressModeClampToEdge,\n        AddressMode::Repeat => bindings::MTLSamplerAddressModeRepeat,\n");
    buf_str(out, c"        AddressMode::MirrorRepeat => bindings::MTLSamplerAddressModeMirrorRepeat,\n    }\n}\n\n#[pure]\nfn load_action(l: Load) -> u64 {\n    match l {\n        Load::Clear => bindings::MTLLoadActionClear,\n        Load::Keep => bindings::MTLLoadActionLoad,\n        Load::DontCare => bindings::MTLLoadActionDontCare,\n    }\n}\n\n/// The Metal buffer index of vertex buffer `slot` (30 downward, design\n/// §2.8, so that they never meet the shader's own buffers).\n#[pure]\npub fn vertex_buffer_index(slot: i64) -> u64 {\n    (30 - slot) as u64\n}\n\nfn size3(x: i64, y: i64, z: i64) -> MTLSize {\n    MTLSize { width: x as u64, height: y as u64, depth: z as u64 }\n}\n\nfn origin3(x: i64, y: i64, z: i64) -> MTLOrigin {\n    MTLOrigin { x: x as u64, y: y as u64, z: z as u64 }\n}\n\n/// Appends an NSError's description (or `what` when there is none).\nfn push_error<A: Allocator>(err: &mut String<A>, e: Option<Ref<NSError>>, what: &str) {\n    match e {\n        Some(r) => crate::objc::push_ns_string(err, r.localized_description()),\n        None => err.push_str(what),\n    }\n}\n\nfn function<A: Allocator>(s: &Shader, e: EntryPoint<'_>, err: &mut String<A>) -> Option<Id<MTLFunction>> {\n    let name = crate::objc::ns_string(e.native);\n    let f = s.lib.r().new_function_with_name(name.r());\n    if f.is_none() {\n        err.push_str(\"no function '\");\n        err.push_str(e.native);\n        err.push_str(\"' in the MSL (entry point '\");\n        err.push_str(e.name);\n        err.push_str(\"')\");\n    }\n    f\n}\n\n#[repr(C)]\nunion CFn0 {\n    p: *mut u8,\n    f: extern \"C\" fn() -> *mut u8,\n}\n\n/// Calls a C function `*u8 f(void)` of an opened framework (Metal's device\n/// functions; nil when it is not there).\nfn call_c0(name: *mut u8) -> *mut u8 {\n    // UNSAFE: a C symbol's address made a function pointer (a union field) and called: neither\n    // the lookup nor the call can be checked.\n");
    buf_str(out, c"    // SAFETY: the callers pass NUL-terminated c\"\" literals that name Metal functions declared\n    // `id f(void)` (MTLCopyAllDevices, MTLCreateSystemDefaultDevice), so the union reads a\n    // function pointer of exactly that type; a missing symbol (null) is never called.\n    unsafe {\n        let p = crate::objc::symbol(name);\n        if p.is_null() { return 0 as *mut u8; }\n        let f = CFn0 { p: p }.f;\n        f()\n    }\n}\n\n// Whether Metal was opened (1), an atomic and not a `static mut`: two\n// threads that both find 0 open the frameworks twice, which dlopen allows.\nstatic OPENED: Atomic<usize> = Atomic::new(0);\n\nfn open_frameworks() -> bool {\n    if OPENED.load(Ordering::Relaxed) == 0 {\n        crate::objc::init();\n        if crate::objc::framework(\"Metal\") {\n            OPENED.store(1, Ordering::Relaxed);\n        }\n        crate::objc::framework(\"QuartzCore\");\n    }\n    OPENED.load(Ordering::Relaxed) != 0\n}\n\n// ---- GPU on Metal: recording helpers (0.22) ----\n\nfn begin_on(q: Ref<MTLCommandQueue>) -> CommandBuffer {\n    let cb = crate::objc::pool(|| match q.command_buffer() {\n        Some(c) => c.retain(),\n        None => Id::<MTLCommandBuffer>::nil(),\n    });\n    CommandBuffer { cb: cb, blit: Id::<MTLBlitCommandEncoder>::nil() }\n}\n\nfn end_blit(cb: &mut CommandBuffer) {\n    if !cb.blit.is_nil() {\n        cb.blit.r().end_encoding();\n        cb.blit = Id::<MTLBlitCommandEncoder>::nil();\n    }\n}\n\nfn blit(cb: &mut CommandBuffer) -> Ref<MTLBlitCommandEncoder> {\n    if cb.blit.is_nil() {\n        let raw = cb.cb.r();\n        cb.blit = crate::objc::pool(|| match raw.blit_command_encoder() {\n            Some(e) => e.retain(),\n            None => Id::<MTLBlitCommandEncoder>::nil(),\n        });\n    }\n    cb.blit.r()\n}\n\nfn bound(kind: i64, b: Binding, obj: *mut u8, offset: u64) -> Bound {\n    // UNSAFE: objc_retain is a C call on a raw object pointer.\n");
    buf_str(out, c"    // SAFETY: the callers pass the pointer of a live buffer, texture or sampler (an Id they\n    // hold), or nil, which retain ignores; BindGroup's drop releases this retain once.\n    unsafe { objc_retain(obj); }\n    Bound {\n        kind: kind, vs: b.slot_vertex, fs: b.slot_fragment, cs: b.slot_compute, obj: obj,\n        offset: offset,\n    }\n}\n\nfn apply_compute(e: Ref<MTLComputeCommandEncoder>, b: Bound) {\n    if b.cs < 0 { return; }\n    let slot = b.cs as u64;\n    // UNSAFE: Ref::from_global over the raw pointer the bind group holds (Bound.obj).\n    // SAFETY: `bound` stored obj with the kind of the Id it came from (BIND_BUFFER an MTLBuffer,\n    // BIND_TEXTURE an MTLTexture, else an MTLSamplerState) and retained it; the group, which\n    // outlives this call, releases it only when dropped, so the Ref is live for the call.\n    unsafe {\n        if b.kind == BIND_BUFFER {\n            e.set_buffer_offset_at_index(Some(Ref::<MTLBuffer>::from_global(b.obj)), b.offset,\n                slot);\n        } else if b.kind == BIND_TEXTURE {\n            e.set_texture_at_index(Some(Ref::<MTLTexture>::from_global(b.obj)), slot);\n        } else {\n            e.set_sampler_state_at_index(Some(Ref::<MTLSamplerState>::from_global(b.obj)), slot);\n        }\n    }\n}\n\nfn apply_render(e: Ref<MTLRenderCommandEncoder>, b: Bound) {\n    // UNSAFE: Ref::from_global over the raw pointer the bind group holds (Bound.obj).\n    // SAFETY: as apply_compute: obj is a retained object of the class `kind` names, alive\n    // while the group that holds it is, which outlives the call.\n    unsafe {\n        if b.kind == BIND_BUFFER {\n            let r = Some(Ref::<MTLBuffer>::from_global(b.obj));\n            if b.vs >= 0 { e.set_vertex_buffer_offset_at_index(r, b.offset, b.vs as u64); }\n            if b.fs >= 0 { e.set_fragment_buffer_offset_at_index(r, b.offset, b.fs as u64); }\n        } else if b.kind == BIND_TEXTURE {\n");
    buf_str(out, c"            let r = Some(Ref::<MTLTexture>::from_global(b.obj));\n            if b.vs >= 0 { e.set_vertex_texture_at_index(r, b.vs as u64); }\n            if b.fs >= 0 { e.set_fragment_texture_at_index(r, b.fs as u64); }\n        } else {\n            let r = Some(Ref::<MTLSamplerState>::from_global(b.obj));\n            if b.vs >= 0 { e.set_vertex_sampler_state_at_index(r, b.vs as u64); }\n            if b.fs >= 0 { e.set_fragment_sampler_state_at_index(r, b.fs as u64); }\n        }\n    }\n}\n\n// ---- GPU on Metal: hal::Api (0.22) ----\n\nimpl Api for Metal {\n    type Adapter = Adapter;\n    type Device = Device;\n    type Queue = Queue;\n    type Buffer = Buffer;\n    type Texture = Texture;\n    type TextureView = TextureView;\n    type Sampler = Sampler;\n    type Shader = Shader;\n    type ComputePipeline = ComputePipeline;\n    type BindGroup = BindGroup;\n    type CommandBuffer = CommandBuffer;\n    type ComputeEncoder = ComputeEncoder;\n\n    fn adapters<A: Allocator>(out: &mut Vec<Adapter, A>) {\n        if !open_frameworks() { return; }\n        // UNSAFE: the result of a C function taken over as an owned Id.\n        // SAFETY: MTLCopyAllDevices returns a +1 NSArray of id<MTLDevice> (the Copy rule), or\n        // nil, which from_owned_or_nil keeps as a nil Id.\n        let all = unsafe { Id::<NSArray>::from_owned_or_nil(call_c0(c\"MTLCopyAllDevices\")) };\n        let n = all.r().count();\n        for i in 0..n {\n            // UNSAFE: a cast of an `id` to MTLDevice, which no type checks.\n            // SAFETY: MTLCopyAllDevices's array holds only id<MTLDevice>s; the element is kept\n            // by `all` while it is retained below.\n            let d = unsafe { all.r().object_at_index(i).cast::<MTLDevice>() };\n            out.push(Adapter { dev: d.retain() });\n        }\n    }\n\n    fn default_adapter() -> Option<Adapter> {\n        if !open_frameworks() { return None; }\n        // UNSAFE: the result of a C function taken over as an owned Id.\n");
    buf_str(out, c"        // SAFETY: MTLCreateSystemDefaultDevice returns a +1 id<MTLDevice> (the Create rule) or\n        // nil, which from_owned turns into None.\n        match unsafe { Id::<MTLDevice>::from_owned(call_c0(c\"MTLCreateSystemDefaultDevice\")) } {\n            Some(d) => Some(Adapter { dev: d }),\n            None => None,\n        }\n    }\n\n    fn adapter_name<A: Allocator>(a: &Adapter, out: &mut String<A>) {\n        let _pool = crate::objc::Pool::push();\n        crate::objc::push_ns_string(out, a.dev.r().name());\n    }\n\n    fn adapter_low_power(a: &Adapter) -> bool {\n        a.dev.r().is_low_power()\n    }\n\n    fn adapter_max_buffer_size(a: &Adapter) -> i64 {\n        // (less the bytes of the map state, create_buffer's STATE_BYTES)\n        let n = a.dev.r().max_buffer_length() - STATE_BYTES as u64;\n        if n > 9223372036854775807u64 { 9223372036854775807 } else { n as i64 }\n    }\n\n    fn open(a: &Adapter) -> Option<(Device, Queue)> {\n        let q = match a.dev.r().new_command_queue() {\n            Some(q) => q,\n            None => return None,\n        };\n        let dev = Device { dev: a.dev.clone(), queue: q.clone() };\n        Some((dev, Queue { q: q, last: Id::<MTLCommandBuffer>::nil() }))\n    }\n\n    fn caps(d: &Device) -> Caps {\n        Caps {\n            compute: true,\n            render: true,\n            surfaces: true,\n            textures: true,\n            unified_memory: d.dev.r().has_unified_memory(),\n            shader_kind: ShaderKind::Msl,\n            timestamps: true,\n        }\n    }\n\n    fn device_wait_idle(d: &Device) {\n        // an empty command buffer completes after everything committed\n        // before it on the same queue\n        let q = d.queue.r();\n        crate::objc::pool(|| match q.command_buffer() {\n            Some(cb) => {\n                cb.commit();\n                cb.wait_until_completed();\n            }\n            None => {}\n        });\n    }\n\n");
    buf_str(out, c"    fn create_buffer(d: &Device, size: i64, init: &[u8]) -> Option<Buffer> {\n        // the buffer's bytes, then its map state (STATE_BYTES)\n        let n = state_offset(size) + STATE_BYTES;\n        match d.dev\n            .r()\n            .new_buffer_with_length_options(n as u64, bindings::MTLResourceStorageModeShared) {\n            Some(b) => {\n                let p = b.r().contents();\n                if init.len() > 0 {\n                    // UNSAFE: a copy into the MTLBuffer's shared memory, reached by its raw\n                    // contents pointer.\n                    // SAFETY: contents is n >= size bytes of shared memory, kept by b; init.len()\n                    // <= size (Device::buffer_init passes size = init.len(), buffer passes \"\");\n                    // a new buffer and a slice do not overlap.\n                    unsafe { memcpy(p, init.ptr, init.len() as u64); }\n                }\n                let mut out = Buffer { raw: b, ptr: p, size: size };\n                set_map_state(&mut out, 0);\n                Some(out)\n            }\n            None => None,\n        }\n    }\n\n    fn buffer_handle(b: &Buffer) -> Buffer {\n        Buffer { raw: b.raw.clone(), ptr: b.ptr, size: b.size }\n    }\n\n    fn map_state(b: &Buffer) -> i64 {\n        // UNSAFE: the state is in the MTLBuffer's own memory (set_map_state's reason)\n        // SAFETY: as set_map_state: b.ptr[state_offset(size)] is inside the MTLBuffer that b.raw keeps alive, a byte the GPU never writes\n        unsafe { (*b.ptr.add(state_offset(b.size) as usize)) as i64 }\n    }\n\n    fn map_read<'a>(d: &Device, b: &'a mut Buffer) -> &'a [u8] {\n        set_map_state(b, MAPPED_READ);\n        // UNSAFE: a view of the MTLBuffer's shared memory, reached by its raw contents pointer.\n        // SAFETY: b.ptr is the contents of an MTLBuffer of at least size bytes that b.raw keeps\n        // alive; the view's lifetime is b's borrow; the map state set above makes std::gpu's\n");
    buf_str(out, c"        // contracts refuse GPU writes to it while it is mapped.\n        unsafe { crate::slice::from_raw_parts(b.ptr, b.size as usize) }\n    }\n\n    fn map_write<'a>(d: &Device, b: &'a mut Buffer) -> &'a mut [u8] {\n        set_map_state(b, MAPPED_WRITE);\n        // UNSAFE: a writable view of the MTLBuffer's shared memory (its raw contents pointer).\n        // SAFETY: as map_read: size bytes inside the MTLBuffer that b.raw keeps, the view tied to\n        // b's `&mut` borrow (no other access while it lives).\n        unsafe { crate::slice::from_raw_parts_mut(b.ptr, b.size as usize) }\n    }\n\n    fn unmap(d: &Device, b: &mut Buffer) {\n        set_map_state(b, 0);\n    }\n\n    fn create_texture(d: &Device, desc: TextureDesc) -> Option<Texture> {\n        let td = MTLTextureDescriptor::new();\n        let t = td.r();\n        t.set_texture_type(if desc.layers > 1 { bindings::MTLTextureType2DArray }\n            else { bindings::MTLTextureType2D });\n        t.set_pixel_format(pixel_format(desc.format));\n        t.set_width(desc.width as u64);\n        t.set_height(desc.height as u64);\n        t.set_array_length(desc.layers as u64);\n        t.set_mipmap_level_count(desc.mips as u64);\n        let mut usage: u64 = bindings::MTLTextureUsagePixelFormatView;\n        if desc.usage & TextureUsage::TEXTURE_BINDING\n            != 0 { usage = usage | bindings::MTLTextureUsageShaderRead; }\n        if desc.usage & TextureUsage::STORAGE_BINDING != 0 {\n            usage = usage | bindings::MTLTextureUsageShaderRead\n                | bindings::MTLTextureUsageShaderWrite;\n        }\n        if desc.usage & TextureUsage::RENDER_ATTACHMENT\n            != 0 { usage = usage | bindings::MTLTextureUsageRenderTarget; }\n        t.set_usage(usage);\n        t.set_storage_mode(bindings::MTLStorageModePrivate);\n        match d.dev.r().new_texture_with_descriptor(t) {\n            Some(x) => Some(Texture { raw: x }),\n            None => None,\n        }\n    }\n\n");
    buf_str(out, c"    fn create_view(t: &Texture, format: Format, same_format: bool) -> Option<TextureView> {\n        if same_format {\n            return Some(TextureView { raw: t.raw.clone() });\n        }\n        match t.raw.r().new_texture_view_with_pixel_format(pixel_format(format)) {\n            Some(v) => Some(TextureView { raw: v }),\n            None => None,\n        }\n    }\n\n    fn create_sampler(d: &Device, desc: SamplerDesc) -> Option<Sampler> {\n        let sd = MTLSamplerDescriptor::new();\n        let s = sd.r();\n        s.set_min_filter(filter(desc.min));\n        s.set_mag_filter(filter(desc.mag));\n        s.set_mip_filter(if desc.mip == Filter::Linear { bindings::MTLSamplerMipFilterLinear }\n            else { bindings::MTLSamplerMipFilterNearest });\n        s.set_s_address_mode(address_mode(desc.address_u));\n        s.set_t_address_mode(address_mode(desc.address_v));\n        s.set_r_address_mode(address_mode(desc.address_w));\n        s.set_lod_min_clamp(desc.lod_min);\n        s.set_lod_max_clamp(desc.lod_max);\n        s.set_max_anisotropy(desc.anisotropy as u64);\n        match desc.compare {\n            Some(c) => s.set_compare_function(compare_function(c)),\n            None => {}\n        }\n        match d.dev.r().new_sampler_state_with_descriptor(s) {\n            Some(x) => Some(Sampler { raw: x }),\n            None => None,\n        }\n    }\n\n    fn create_shader<A: Allocator>(d: &Device, src: &ShaderSource<'_, Gpa>, err: &mut String<A>) -> Option<Shader> {\n        if src.kind != ShaderKind::Msl {\n            err.push_str(\"Metal takes MSL (ShaderKind::Msl)\");\n            return None;\n        }\n        let _pool = crate::objc::Pool::push();\n        let opts = MTLCompileOptions::new();\n        opts.r().set_language_version(bindings::MTLLanguageVersion3_0);\n        let source = crate::objc::ns_string(src.code);\n        let mut e: *mut u8 = 0 as *mut u8;\n");
    buf_str(out, c"        // UNSAFE: the generated wrapper takes an NSError ** out-parameter as a raw pointer.\n        // SAFETY: &e is a writable *u8 slot, a local that outlives the call; Metal stores an\n        // autoreleased NSError (or nothing) there, alive until _pool drops.\n        let lib = unsafe {\n            d.dev\n                .r()\n                .new_library_with_source_options_error(source.r(), Some(opts.r()),\n                    &raw mut e as *mut u8)\n        };\n        match lib {\n            Some(l) => Some(Shader { lib: l }),\n            None => {\n                // UNSAFE: the raw NSError ** out-value made a Ref, which no type checks.\n                // SAFETY: e is nil or the autoreleased NSError Metal stored, alive until _pool\n                // (a local of this function) drops, after push_error has read it.\n                push_error(err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"the MSL did not compile\");\n                None\n            }\n        }\n    }\n\n    fn create_compute_pipeline<A: Allocator>(d: &Device, s: &Shader, entry: EntryPoint<'_>,\n        err: &mut String<A>) -> Option<ComputePipeline> {\n        let f = match function(s, entry, err) {\n            Some(f) => f,\n            None => return None,\n        };\n        let wg = size3(entry.workgroup[0], entry.workgroup[1], entry.workgroup[2]);\n        let _pool = crate::objc::Pool::push();\n        let mut e: *mut u8 = 0 as *mut u8;\n        // UNSAFE: the generated wrapper takes an NSError ** out-parameter as a raw pointer.\n        // SAFETY: &e is a writable *u8 slot, a local that outlives the call (as create_shader).\n        match unsafe {\n            d.dev.r().new_compute_pipeline_state_with_function_error(f.r(), &raw mut e as *mut u8)\n        } {\n            Some(p) => Some(ComputePipeline { raw: p, workgroup: wg }),\n            None => {\n                // UNSAFE: the raw NSError ** out-value made a Ref, which no type checks.\n");
    buf_str(out, c"                // SAFETY: e is nil or the autoreleased NSError Metal stored, alive until _pool\n                // (a local of this function) drops, after push_error has read it.\n                push_error(err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"Metal rejected the compute pipeline\");\n                None\n            }\n        }\n    }\n\n    fn bind_group_new(d: &Device) -> BindGroup {\n        let empty = Bound {\n            kind: BIND_BUFFER, vs: -1, fs: -1, cs: -1, obj: 0 as *mut u8, offset: 0,\n        };\n        BindGroup { items: [empty; 16], count: 0 }\n    }\n\n    fn bind_group_buffer(g: &mut BindGroup, b: Binding, buf: &Buffer, offset: i64, size: i64) {\n        g.items[g.count as usize] = bound(BIND_BUFFER, b, buf.raw.ptr, offset as u64);\n        g.count += 1;\n    }\n\n    fn bind_group_texture(g: &mut BindGroup, b: Binding, v: &TextureView) {\n        g.items[g.count as usize] = bound(BIND_TEXTURE, b, v.raw.ptr, 0);\n        g.count += 1;\n    }\n\n    fn bind_group_sampler(g: &mut BindGroup, b: Binding, s: &Sampler) {\n        g.items[g.count as usize] = bound(BIND_SAMPLER, b, s.raw.ptr, 0);\n        g.count += 1;\n    }\n\n    fn begin(d: &Device) -> CommandBuffer {\n        begin_on(d.queue.r())\n    }\n\n    fn copy_buffer(cb: &mut CommandBuffer, src: &Buffer, src_offset: i64, dst: &Buffer,\n        dst_offset: i64, size: i64) {\n        blit(cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(src.raw.r(),\n            src_offset as u64, dst.raw.r(), dst_offset as u64, size as u64);\n    }\n\n    fn copy_texture_to_buffer(cb: &mut CommandBuffer, src: &Texture, layer: i64, x: i64, y: i64,\n        w: i64, h: i64, dst: &Buffer, offset: i64, bytes_per_row: i64) {\n        blit(cb).copy_texture_to_buffer(src.raw.r(), layer as u64, 0, origin3(x, y, 0),\n            size3(w, h, 1), dst.raw.r(), offset as u64, bytes_per_row as u64,\n            (bytes_per_row * h) as u64);\n    }\n\n");
    buf_str(out, c"    fn copy_buffer_to_texture(cb: &mut CommandBuffer, src: &Buffer, offset: i64, bytes_per_row: i64,\n        dst: &Texture, layer: i64, x: i64, y: i64, w: i64, h: i64) {\n        blit(cb).copy_buffer_to_texture(src.raw.r(), offset as u64, bytes_per_row as u64,\n            (bytes_per_row * h) as u64, size3(w, h, 1), dst.raw.r(), layer as u64, 0,\n            origin3(x, y, 0));\n    }\n\n    fn begin_compute(cb: &mut CommandBuffer) -> ComputeEncoder {\n        end_blit(cb);\n        let raw = cb.cb.r();\n        let e = crate::objc::pool(|| match raw.compute_command_encoder() {\n            Some(e) => e.retain(),\n            None => Id::<MTLComputeCommandEncoder>::nil(),\n        });\n        ComputeEncoder { enc: e, workgroup: size3(1, 1, 1) }\n    }\n\n    fn compute_set_pipeline(e: &mut ComputeEncoder, p: &ComputePipeline) {\n        e.enc.r().set_compute_pipeline_state(p.raw.r());\n        e.workgroup = p.workgroup;\n    }\n\n    fn compute_set_bind_group(e: &mut ComputeEncoder, g: &BindGroup) {\n        let enc = e.enc.r();\n        for i in 0..g.count {\n            apply_compute(enc, g.items[i as usize]);\n        }\n    }\n\n    fn dispatch(e: &mut ComputeEncoder, x: i64, y: i64, z: i64) {\n        e.enc.r().dispatch_threadgroups_threads_per_threadgroup(size3(x, y, z), e.workgroup);\n    }\n\n    fn compute_set_bytes(e: &mut ComputeEncoder, bytes: &[u8], slot: i64) {\n        // UNSAFE: setBytes:length:atIndex: takes the bytes as a raw pointer.\n        // SAFETY: bytes.ptr is valid for bytes.len() bytes, the length passed, for the call;\n        // Metal copies them before it returns.\n        unsafe {\n            e.enc.r().set_bytes_length_at_index(bytes.ptr, bytes.len() as u64, slot as u64);\n        }\n    }\n\n    fn end_compute(e: &mut ComputeEncoder) {\n        e.enc.r().end_encoding();\n        e.enc = Id::<MTLComputeCommandEncoder>::nil();\n    }\n\n    fn submit(q: &mut Queue, cb: &mut CommandBuffer) {\n        end_blit(cb);\n");
    buf_str(out, c"        cb.cb.r().commit();\n        q.last = mem::replace(&mut cb.cb, Id::<MTLCommandBuffer>::nil());\n    }\n\n    fn write_buffer(q: &mut Queue, b: &Buffer, offset: i64, data: &[u8]) {\n        if data.len() == 0 { return; }\n        let idle = q.last.is_nil()\n            || q.last.r().status() >= bindings::MTLCommandBufferStatusCompleted;\n        if idle {\n            // UNSAFE: a copy into the MTLBuffer's shared memory, reached by its raw pointer.\n            // SAFETY: Queue::write_buffer requires offset >= 0 and offset + data.len() <= size,\n            // so the range is inside the buffer b.raw keeps; no submitted work is reading it\n            // (idle); data is another allocation, so they do not overlap.\n            unsafe {\n                memcpy(b.ptr.add(offset as usize), data.ptr, data.len() as u64);\n            }\n            return;\n        }\n        // in flight: a staging copy, ordered on the queue\n        let dev = q.q.r().device();\n        // UNSAFE: newBufferWithBytes:length:options: takes the bytes as a raw pointer.\n        // SAFETY: data.ptr is valid for data.len() bytes, the length passed; Metal copies them\n        // into the new buffer before it returns.\n        let staging = match unsafe {\n            dev.new_buffer_with_bytes_length_options(data.ptr, data.len() as u64,\n                bindings::MTLResourceStorageModeShared)\n        } {\n            Some(s) => s,\n            None => return,\n        };\n        let mut cb = begin_on(q.q.r());\n        blit(&mut cb).copy_from_buffer_source_offset_to_buffer_destination_offset_size(staging.r(),\n            0, b.raw.r(), offset as u64, data.len() as u64);\n        Metal::submit(q, &mut cb);\n    }\n\n    fn write_texture(q: &mut Queue, t: &Texture, layer: i64, x: i64, y: i64, w: i64, h: i64,\n        data: &[u8], bytes_per_row: i64) {\n        let dev = q.q.r().device();\n        // UNSAFE: newBufferWithBytes:length:options: takes the bytes as a raw pointer.\n");
    buf_str(out, c"        // SAFETY: data.ptr is valid for data.len() bytes, the length passed; Metal copies them;\n        // Queue::write_texture asserted that data covers the region the blit below reads.\n        let staging = match unsafe {\n            dev.new_buffer_with_bytes_length_options(data.ptr, data.len() as u64,\n                bindings::MTLResourceStorageModeShared)\n        } {\n            Some(s) => s,\n            None => return,\n        };\n        let mut cb = begin_on(q.q.r());\n        blit(&mut cb).copy_buffer_to_texture(staging.r(), 0, bytes_per_row as u64,\n            (bytes_per_row * h) as u64, size3(w, h, 1), t.raw.r(), layer as u64, 0,\n            origin3(x, y, 0));\n        Metal::submit(q, &mut cb);\n    }\n\n    fn queue_wait_idle(q: &mut Queue) -> bool {\n        if q.last.is_nil() { return true; }\n        let last = q.last.r();\n        last.wait_until_completed();\n        last.status() == bindings::MTLCommandBufferStatusCompleted\n    }\n\n    // (0.25.4) The command buffer keeps its MTLCommandBuffer (a retain),\n    // whose GPUStartTime and GPUEndTime are the host clock's seconds once\n    // it has completed.\n    fn submit_timed(q: &mut Queue, cb: &mut CommandBuffer) {\n        end_blit(cb);\n        cb.cb.r().commit();\n        q.last = cb.cb.clone();\n    }\n\n    fn gpu_times(cb: &mut CommandBuffer) -> Option<(u64, u64)> {\n        if cb.cb.is_nil() { return None; }\n        let c = cb.cb.r();\n        c.wait_until_completed();\n        if c.status() != bindings::MTLCommandBufferStatusCompleted { return None; }\n        let start = c.gpu_start_time();\n        let end = c.gpu_end_time();\n        if start <= 0.0 || end < start { return None; }\n        Some(((start * 1.0e9) as u64, (end * 1.0e9) as u64))\n    }\n}\n\n// ---- GPU on Metal: hal::Render (0.22) ----\n\nimpl Render<Metal> for Metal {\n    type RenderPipeline = RenderPipeline;\n    type RenderEncoder = RenderEncoder;\n    type PassDesc = PassDesc<'_>;\n");
    buf_str(out, c"    type Surface = Surface;\n    type Frame = Frame;\n\n    fn create_render_pipeline(d: &Device, vs: &Shader, vs_entry: EntryPoint<'_>, fs: &Shader,\n        fs_entry: EntryPoint<'_>, has_fs: bool, state: PipelineState,\n        err: &mut String<Gpa>) -> Option<RenderPipeline> {\n        let vf = match function(vs, vs_entry, err) {\n            Some(f) => f,\n            None => return None,\n        };\n        let mut ff = Id::<MTLFunction>::nil();\n        if has_fs {\n            ff = match function(fs, fs_entry, err) {\n                Some(f) => f,\n                None => return None,\n            };\n        }\n        let pd = MTLRenderPipelineDescriptor::new();\n        let p = pd.r();\n        p.set_vertex_function(Some(vf.r()));\n        if has_fs { p.set_fragment_function(Some(ff.r())); }\n        let colors = p.color_attachments();\n        for i in 0..state.target_count {\n            let t = state.targets[i as usize];\n            let c = colors.object_at_indexed_subscript(i as u64);\n            c.set_pixel_format(pixel_format(t.format));\n            c.set_write_mask(t.write_mask as u64);\n            match t.blend {\n                Some(b) => {\n                    c.set_blending_enabled(true);\n                    c.set_source_rgb_blend_factor(blend_factor(b.color.src));\n                    c.set_destination_rgb_blend_factor(blend_factor(b.color.dst));\n                    c.set_rgb_blend_operation(blend_op(b.color.op));\n                    c.set_source_alpha_blend_factor(blend_factor(b.alpha.src));\n                    c.set_destination_alpha_blend_factor(blend_factor(b.alpha.dst));\n                    c.set_alpha_blend_operation(blend_op(b.alpha.op));\n                }\n                None => c.set_blending_enabled(false),\n            }\n        }\n        let vd = MTLVertexDescriptor::new();\n        if state.buffer_count > 0 {\n            let attrs = vd.r().attributes();\n            let layouts = vd.r().layouts();\n");
    buf_str(out, c"            for i in 0..state.buffer_count {\n                let l = state.buffers[i as usize];\n                let index = vertex_buffer_index(i);\n                let lay = layouts.object_at_indexed_subscript(index);\n                lay.set_stride(l.stride as u64);\n                lay.set_step_function(if l.step\n                    == StepMode::Instance { bindings::MTLVertexStepFunctionPerInstance }\n                    else { bindings::MTLVertexStepFunctionPerVertex });\n                lay.set_step_rate(1);\n                for k in 0..l.count {\n                    let a = l.attributes[k as usize];\n                    let ad = attrs.object_at_indexed_subscript(a.location as u64);\n                    ad.set_format(vertex_format(a.format));\n                    ad.set_offset(a.offset as u64);\n                    ad.set_buffer_index(index);\n                }\n            }\n            p.set_vertex_descriptor(Some(vd.r()));\n        }\n        let mut depth = Id::<MTLDepthStencilState>::nil();\n        match state.depth {\n            Some(ds) => {\n                p.set_depth_attachment_pixel_format(pixel_format(ds.format));\n                let dd = MTLDepthStencilDescriptor::new();\n                dd.r().set_depth_compare_function(compare_function(ds.compare));\n                dd.r().set_depth_write_enabled(ds.write);\n                match d.dev.r().new_depth_stencil_state_with_descriptor(dd.r()) {\n                    Some(s) => { depth = s; }\n                    None => {}\n                }\n            }\n            None => {}\n        }\n        let _pool = crate::objc::Pool::push();\n        let mut e: *mut u8 = 0 as *mut u8;\n        // UNSAFE: the generated wrapper takes an NSError ** out-parameter as a raw pointer.\n        // SAFETY: &e is a writable *u8 slot, a local that outlives the call (as create_shader).\n        match unsafe {\n            d.dev.r().new_render_pipeline_state_with_descriptor_error(p, &raw mut e as *mut u8)\n");
    buf_str(out, c"        } {\n            Some(raw) => {\n                let primitive = match state.topology {\n                    Topology::PointList => bindings::MTLPrimitiveTypePoint,\n                    Topology::LineList => bindings::MTLPrimitiveTypeLine,\n                    Topology::LineStrip => bindings::MTLPrimitiveTypeLineStrip,\n                    Topology::TriangleList => bindings::MTLPrimitiveTypeTriangle,\n                    Topology::TriangleStrip => bindings::MTLPrimitiveTypeTriangleStrip,\n                };\n                let cull = match state.cull {\n                    Cull::None => bindings::MTLCullModeNone,\n                    Cull::Front => bindings::MTLCullModeFront,\n                    Cull::Back => bindings::MTLCullModeBack,\n                };\n                // WebGPU's clip space has y up, as Metal's: counter-clockwise\n                // is the same winding in both\n                let winding = if state.front_face\n                    == FrontFace::Ccw { bindings::MTLWindingCounterClockwise }\n                    else { bindings::MTLWindingClockwise };\n                Some(RenderPipeline {\n                    raw: raw, depth: depth, primitive: primitive, cull: cull, winding: winding,\n                })\n            }\n            None => {\n                // UNSAFE: the raw NSError ** out-value made a Ref, which no type checks.\n                // SAFETY: e is nil or the autoreleased NSError Metal stored, alive until _pool\n                // (a local of this function) drops, after push_error has read it.\n                push_error(err, unsafe { Ref::<NSError>::from_global_opt(e) },\n                    \"Metal rejected the render pipeline\");\n                None\n            }\n        }\n    }\n\n    fn pass_new() -> PassDesc<'static> {\n        PassDesc { raw: MTLRenderPassDescriptor::new() }\n    }\n\n    fn pass_color(p: &mut PassDesc<'_>, i: i64, v: &TextureView, load: Load, clear: Color,\n        store: bool) {\n");
    buf_str(out, c"        let a = p.raw.r().color_attachments().object_at_indexed_subscript(i as u64);\n        a.set_texture(Some(v.raw.r()));\n        a.set_load_action(load_action(load));\n        a.set_clear_color(MTLClearColor {\n            red: clear.r, green: clear.g, blue: clear.b, alpha: clear.a,\n        });\n        a.set_store_action(if store { bindings::MTLStoreActionStore }\n            else { bindings::MTLStoreActionDontCare });\n    }\n\n    fn pass_depth(p: &mut PassDesc<'_>, v: &TextureView, load: Load, clear: f64, store: bool) {\n        let a = p.raw.r().depth_attachment();\n        a.set_texture(Some(v.raw.r()));\n        a.set_load_action(load_action(load));\n        a.set_clear_depth(clear);\n        a.set_store_action(if store { bindings::MTLStoreActionStore }\n            else { bindings::MTLStoreActionDontCare });\n    }\n\n    fn begin_render(cb: &mut CommandBuffer, p: &PassDesc<'_>) -> RenderEncoder {\n        end_blit(cb);\n        let raw = cb.cb.r();\n        let desc = p.raw.r();\n        let e = crate::objc::pool(|| match raw.render_command_encoder_with_descriptor(desc) {\n            Some(e) => e.retain(),\n            None => Id::<MTLRenderCommandEncoder>::nil(),\n        });\n        RenderEncoder {\n            enc: e, primitive: bindings::MTLPrimitiveTypeTriangle, index: Id::<MTLBuffer>::nil(),\n            index_type: 0, index_size: 2, index_offset: 0,\n        }\n    }\n\n    fn render_set_pipeline(e: &mut RenderEncoder, p: &RenderPipeline) {\n        let enc = e.enc.r();\n        enc.set_render_pipeline_state(p.raw.r());\n        enc.set_cull_mode(p.cull);\n        enc.set_front_facing_winding(p.winding);\n        if !p.depth.is_nil() {\n            enc.set_depth_stencil_state(Some(p.depth.r()));\n        }\n        e.primitive = p.primitive;\n    }\n\n    fn render_set_bind_group(e: &mut RenderEncoder, g: &BindGroup) {\n        let enc = e.enc.r();\n        for i in 0..g.count {\n            apply_render(enc, g.items[i as usize]);\n        }\n");
