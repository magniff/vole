    buf_str(out, c"        // UNSAFE: -present is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_v is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live MTLDrawable (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_v(self.ptr, sel_152()); }\n    }\n}\n\nimpl<'a> MTLDrawableMethods<'a> for Ref<'a, CAMetalDrawable> {\n    fn present(self) {\n        // UNSAFE: -present is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_v is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalDrawable (Ref's invariant), which\n        // has MTLDrawable's methods, and a message to nil returns zero.\n        unsafe { msg_v(self.ptr, sel_152()); }\n    }\n}\n\n/// The Objective-C protocol CAMetalDrawable.\npub struct CAMetalDrawable {}\n\npub trait CAMetalDrawableMethods<'a> {\n    // texture\n    fn texture(self) -> Ref<'a, MTLTexture>;\n}\n\nimpl<'a> CAMetalDrawableMethods<'a> for Ref<'a, CAMetalDrawable> {\n    fn texture(self) -> Ref<'a, MTLTexture> {\n        // UNSAFE: -texture is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalDrawable (Ref's invariant), and a\n        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<MTLTexture>::from_raw(msg_p(self.ptr, sel_153()), self) }\n    }\n}\n\n/// The Objective-C class CAMetalLayer.\npub struct CAMetalLayer {}\n\npub trait CAMetalLayerMethods<'a> {\n    // setDevice:\n    fn set_device(self, device: Option<Ref<'_, MTLDevice>>);\n    // setPixelFormat:\n");
    buf_str(out, c"    fn set_pixel_format(self, format: u64);\n    // setDrawableSize:\n    fn set_drawable_size(self, size: CGSize);\n    // drawableSize\n    fn drawable_size(self) -> CGSize;\n    // setFramebufferOnly:\n    fn set_framebuffer_only(self, only: bool);\n    // setMaximumDrawableCount:\n    fn set_maximum_drawable_count(self, count: u64);\n    // setDisplaySyncEnabled:\n    fn set_display_sync_enabled(self, enabled: bool);\n    // nextDrawable\n    fn next_drawable(self) -> Option<Ref<'a, CAMetalDrawable>>;\n}\n\nimpl<'a> CAMetalLayerMethods<'a> for Ref<'a, CAMetalLayer> {\n    fn set_device(self, device: Option<Ref<'_, MTLDevice>>) {\n        // UNSAFE: -setDevice: is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_v_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n        // message to nil returns zero; the object arguments are live objects (or nil) of their\n        // declared types, borrowed for the call.\n        unsafe { msg_v_p(self.ptr, sel_154(), opt_ptr(device)); }\n    }\n\n    fn set_pixel_format(self, format: u64) {\n        // UNSAFE: -setPixelFormat: is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_v_u64 is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_v_u64(self.ptr, sel_98(), format); }\n    }\n\n    fn set_drawable_size(self, size: CGSize) {\n        // UNSAFE: -setDrawableSize: is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_v_CGSize is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n");
    buf_str(out, c"        // message to nil returns zero.\n        unsafe { msg_v_CGSize(self.ptr, sel_155(), size); }\n    }\n\n    fn drawable_size(self) -> CGSize {\n        if self.ptr.is_null() {\n            return CGSize { width: 0.0, height: 0.0 };\n        }\n        // UNSAFE: -drawableSize is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_CGSize is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant); a nil\n        // receiver is answered with zeroes first, as a message to nil does not write a struct\n        // result returned in memory.\n        unsafe { msg_CGSize(self.ptr, sel_156()) }\n    }\n\n    fn set_framebuffer_only(self, only: bool) {\n        // UNSAFE: -setFramebufferOnly: is sent by objc_msgSend, a C call whose types the\n        // compiler cannot see.\n        // SAFETY: msg_v_bool is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_v_bool(self.ptr, sel_157(), only); }\n    }\n\n    fn set_maximum_drawable_count(self, count: u64) {\n        // UNSAFE: -setMaximumDrawableCount: is sent by objc_msgSend, a C call whose types the\n        // compiler cannot see.\n        // SAFETY: msg_v_u64 is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_v_u64(self.ptr, sel_158(), count); }\n    }\n\n    fn set_display_sync_enabled(self, enabled: bool) {\n        // UNSAFE: -setDisplaySyncEnabled: is sent by objc_msgSend, a C call whose types the\n        // compiler cannot see.\n        // SAFETY: msg_v_bool is its C prototype, checked against the runtime's type encoding\n");
    buf_str(out, c"        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_v_bool(self.ptr, sel_159(), enabled); }\n    }\n\n    fn next_drawable(self) -> Option<Ref<'a, CAMetalDrawable>> {\n        // UNSAFE: -nextDrawable is sent by objc_msgSend, a C call whose types the compiler\n        // cannot see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live CAMetalLayer (Ref's invariant), and a\n        // message to nil returns zero; the +0 result is a Ref of self's lifetime, so it cannot\n        // outlive the receiver that holds it.\n        unsafe { Ref::<CAMetalDrawable>::from_raw_opt(msg_p(self.ptr, sel_160()), self) }\n    }\n}\n\nimpl CAMetalLayer {\n    // +layer\n    pub fn layer() -> Ref<'static, CAMetalLayer> {\n        // UNSAFE: +layer is sent by objc_msgSend, a C call whose types the compiler cannot see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); class_7() is the class CAMetalLayer, or nil before its framework\n        // is opened, and a message to nil returns zero; the +0 result is kept by the process (a\n        // class) or the current autorelease pool (from_global's rule).\n        unsafe { Ref::<CAMetalLayer>::from_global(msg_p(class_7(), sel_161())) }\n    }\n}\n// ---- end mod std::gpu::hal::metal::bindings ----\n}\n// ---- end mod std::gpu::hal::metal ----\n}\n// ---- end mod std::gpu::hal ----\n}\n// ---- mod std::gpu::shader ----\npub mod shader {\n// EDITION: rust\n// std::gpu::shader (0.22): what pipeline creation takes from the shader\n// compiler (docs/design/gpu.md §2.10): a module translated for one\n// backend, its code and its reflection. The WGSL compiler\n// (std::gpu::wgsl) produces a ShaderSource for the backend's ShaderKind\n");
    buf_str(out, c"// (`dev.caps().shader_kind`); programs that bring their own shaders write\n// both by hand.\n//\n// The reflection carries the native slots the writer chose, per stage\n// (Metal's [[buffer(n)]], [[texture(n)]], [[sampler(n)]]; a CUDA kernel's\n// parameter index): the hal binds what it is told and assumes no\n// numbering rule. The rule the MSL writer follows, so that compatible\n// layouts get the same slots: per stage, buffers, textures and samplers\n// each numbered from 0 in (group, binding) order over the bindings visible\n// in that stage; vertex buffers at Metal's 30 downward (vertex buffer i\n// at 30 - i).\n\nuse crate::alloc::Allocator;\nuse crate::fmt::Debug;\nuse crate::gpu::wgsl;\nuse crate::gpu::types::{ShaderStage, VertexFormat};\n\n/// A (group, binding) pair.\npub type GroupBinding = [i64; 2];\n\n// ---- GPU shaders: sources and reflection (0.22) ----\n\n/// The form of a translated shader.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum ShaderKind {\n    /// Metal Shading Language text (3.0), compiled by the driver.\n    Msl,\n    /// SPIR-V words (Vulkan).\n    Spirv,\n    /// PTX text (CUDA).\n    Ptx,\n}\n\n/// What a binding holds.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum BindingType {\n    Uniform,\n    Storage,\n    ReadOnlyStorage,\n    Texture,\n    StorageTexture,\n    Sampler,\n    ComparisonSampler,\n}\n\nimpl BindingType {\n    #[pure]\n    pub fn is_buffer(self) -> bool {\n        match self {\n            BindingType::Uniform | BindingType::Storage | BindingType::ReadOnlyStorage => true,\n            _ => false,\n        }\n    }\n\n    #[pure]\n    pub fn is_texture(self) -> bool {\n        self == BindingType::Texture || self == BindingType::StorageTexture\n    }\n\n    #[pure]\n    pub fn is_sampler(self) -> bool {\n        self == BindingType::Sampler || self == BindingType::ComparisonSampler\n    }\n}\n\n/// One `@group(g) @binding(b)` of a shader, with its native slot in each\n");
    buf_str(out, c"/// stage (-1: not used there).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct Binding {\n    pub group: i64,\n    pub binding: i64,\n    pub ty: BindingType,\n    pub slot_vertex: i64,\n    pub slot_fragment: i64,\n    pub slot_compute: i64,\n    pub min_size: i64,\n}\n\nimpl Binding {\n    #[pure]\n    pub fn visibility(self) -> u32 {\n        let mut v: u32 = 0;\n        if self.slot_vertex >= 0 { v = v | ShaderStage::VERTEX; }\n        if self.slot_fragment >= 0 { v = v | ShaderStage::FRAGMENT; }\n        if self.slot_compute >= 0 { v = v | ShaderStage::COMPUTE; }\n        v\n    }\n}\n\n/// An entry point: its WGSL name, its name in the translated code (MSL\n/// reserves some, `main` among them), its stage, a compute entry's\n/// workgroup size, and the native slot where it reads the sizes buffer\n/// (-1: it reads none; Reflection::sizes).\n#[derive(PartialEq, Eq, Clone, Copy)]\npub struct EntryPoint<'a> {\n    pub name: &'a str,\n    pub native: &'a str,\n    pub stage: u32,\n    pub workgroup: [i64; 3],\n    pub sizes_slot: i64,\n}\n\n/// A vertex entry point's input at `@location(n)`.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct VertexInput {\n    pub location: i64,\n    pub format: VertexFormat,\n}\n\n/// A translated module's interface. Its names view the compiler's output\n/// (or the program's text); Device::shader copies what it keeps.\n///\n/// `sizes` is the sizes buffer's layout (Metal; the bounds checks of\n/// runtime-sized arrays, docs/design/gpu.md \"The sizes buffer\"): the\n/// (group, binding) of each runtime-sized storage binding, one u32 each in\n/// this order, the bytes the buffer bound there exposes. Before each\n/// dispatch or draw, std::gpu gives it (setBytes) at the `sizes_slot` of\n/// each stage's entry point that has one; the rule is wgsl::sizes_words's.\n///\n/// `uses` lists which bindings each entry point uses: (entry, binding)\n/// pairs of indices into `entries` and `bindings` (`use_binding(e, b)`). A\n");
    buf_str(out, c"/// pipeline's layout is the bindings its own entry points use. Empty (a\n/// reflection written by hand that adds none): every entry point uses\n/// every binding its stage has a slot for.\npub struct Reflection<'a, A: Allocator> {\n    pub entries: Vec<EntryPoint<'a>, A>,\n    pub bindings: Vec<Binding, A>,\n    pub inputs: Vec<VertexInput, A>,\n    pub sizes: Vec<GroupBinding, A>,\n    pub uses: Vec<[i64; 2], A>,\n}\n\nimpl<'a> Reflection<'a, Gpa> {\n    pub fn new_in(gpa: Gpa) -> Reflection<'a, Gpa> {\n        Reflection {\n            entries: Vec::new_in(gpa), bindings: Vec::new_in(gpa), inputs: Vec::new_in(gpa),\n            sizes: Vec::new_in(gpa), uses: Vec::new_in(gpa),\n        }\n    }\n\n    /// Entry point `entry` uses binding `binding` (indices into `entries`\n    /// and `bindings`).\n    pub fn use_binding(&mut self, entry: i64, binding: i64) {\n        self.uses.push([entry, binding]);\n    }\n\n    /// A compute entry point with its workgroup size.\n    pub fn compute(&mut self, name: &str, native: &str, x: i64, y: i64 = 1, z: i64 = 1) {\n        self.entries.push(EntryPoint {\n            name: name, native: native, stage: ShaderStage::COMPUTE, workgroup: [x, y, z],\n            sizes_slot: -1,\n        });\n    }\n\n    pub fn vertex(&mut self, name: &str, native: &str) {\n        self.entries.push(EntryPoint {\n            name: name, native: native, stage: ShaderStage::VERTEX, workgroup: [0i64, 0, 0],\n            sizes_slot: -1,\n        });\n    }\n\n    pub fn fragment(&mut self, name: &str, native: &str) {\n        self.entries.push(EntryPoint {\n            name: name, native: native, stage: ShaderStage::FRAGMENT, workgroup: [0i64, 0, 0],\n            sizes_slot: -1,\n        });\n    }\n\n    /// A binding and its slots (-1 where a stage does not use it).\n    pub fn bind(&mut self, group: i64, binding: i64, ty: BindingType, vertex: i64 = -1,\n        fragment: i64 = -1, compute: i64 = -1, min_size: i64 = 0) {\n");
    buf_str(out, c"        self.bindings.push(Binding {\n            group: group, binding: binding, ty: ty, slot_vertex: vertex, slot_fragment: fragment,\n            slot_compute: compute, min_size: min_size,\n        });\n    }\n\n    pub fn input(&mut self, location: i64, format: VertexFormat) {\n        self.inputs.push(VertexInput { location: location, format: format });\n    }\n\n    /// The next word of the sizes buffer: the bytes bound at (group,\n    /// binding), a runtime-sized storage binding.\n    pub fn size_binding(&mut self, group: i64, binding: i64) {\n        self.sizes.push([group, binding]);\n    }\n\n    /// The native slot where entry point `name` of `stage` reads the sizes\n    /// buffer (MSL: a `constant uint*` at [[buffer(slot)]]).\n    pub fn sizes_slot(&mut self, name: &str, stage: u32, slot: i64) {\n        for i in 0..self.entries.len() as i64 {\n            if self.entries[i as usize].name == name && self.entries[i as usize].stage == stage {\n                self.entries[i as usize].sizes_slot = slot;\n            }\n        }\n    }\n}\n\n/// A module translated for one backend: its code (text or words, as\n/// bytes) and its reflection; the shader compiler's output.\npub struct ShaderSource<'a, A: Allocator> {\n    pub kind: ShaderKind,\n    pub code: &'a str,\n    pub reflection: Reflection<'a, A>,\n}\n\nimpl<'a> ShaderSource<'a, Gpa> {\n    /// MSL text and its reflection.\n    pub fn msl(code: &'a str, reflection: Reflection<'a, Gpa>) -> ShaderSource<'a, Gpa> {\n        ShaderSource { kind: ShaderKind::Msl, code: code, reflection: reflection }\n    }\n}\n\n// ---- GPU shaders: from std::gpu::wgsl (0.22) ----\n\n/// The VertexFormat of a WGSL vertex input of scalar `scalar`\n/// (wgsl::ir::SK_*) and `components` components; None where VertexFormat\n/// has no variant (vec3<u32>, vec2..4<i32>, bool). An input of f32s is\n/// also fed by Unorm8x4 (VertexFormat::shader_type).\n");
    buf_str(out, c"pub fn wgsl_vertex_format(scalar: u8, components: i64) -> Option<VertexFormat> {\n    if scalar == wgsl::ir::SK_F32 {\n        if components == 1 { return Some(VertexFormat::Float32); }\n        if components == 2 { return Some(VertexFormat::Float32x2); }\n        if components == 3 { return Some(VertexFormat::Float32x3); }\n        if components == 4 { return Some(VertexFormat::Float32x4); }\n    } else if scalar == wgsl::ir::SK_U32 {\n        if components == 1 { return Some(VertexFormat::Uint32); }\n        if components == 2 { return Some(VertexFormat::Uint32x2); }\n        if components == 4 { return Some(VertexFormat::Uint32x4); }\n    } else if scalar == wgsl::ir::SK_I32 {\n        if components == 1 { return Some(VertexFormat::Sint32); }\n    }\n    None\n}\n\n/// The ShaderStage bit of a wgsl::ir::STAGE_*.\nfn wgsl_stage(stage: u8) -> u32 {\n    if stage == wgsl::ir::STAGE_VERTEX {\n        ShaderStage::VERTEX\n    } else if stage == wgsl::ir::STAGE_FRAGMENT {\n        ShaderStage::FRAGMENT\n    } else {\n        ShaderStage::COMPUTE\n    }\n}\n\n/// The BindingType of a wgsl::BK_* (the same order).\nfn wgsl_binding_type(kind: u8) -> BindingType {\n    match kind {\n        0 => BindingType::Uniform,\n        1 => BindingType::Storage,\n        2 => BindingType::ReadOnlyStorage,\n        3 => BindingType::Texture,\n        4 => BindingType::StorageTexture,\n        5 => BindingType::Sampler,\n        _ => BindingType::ComparisonSampler,\n    }\n}\n\n/// The reflection pipeline creation takes, from the WGSL compiler's\n/// (docs/design/gpu.md, \"Merging with std::gpu\"): the entry points (WGSL\n/// name, name in the translated code, stage, workgroup size, sizes buffer\n/// slot), the bindings (kind, slot per stage, minimum size), the vertex\n/// inputs, and the sizes buffer's layout. Its names view `refl`'s, which\n/// must outlive it. Err: the message for a vertex input no VertexFormat\n/// holds.\n");
    buf_str(out, c"pub fn from_wgsl<'a>(refl: &'a wgsl::Reflection<Gpa>, gpa: Gpa) -> Result<Reflection<'a, Gpa>,\n    String<Gpa>> {\n    let mut out = Reflection::new_in(gpa);\n    for i in 0..refl.entries.len() as i64 {\n        // (the names view refl.entries[i] itself, not a copy of it)\n        let name = match str::from_utf8(refl.entries[i as usize].name.as_slice()) {\n            Ok(n) => n,\n            Err(_) => return Err(String::from_in(\"an entry point's name is not UTF-8\", gpa)),\n        };\n        let native = match str::from_utf8(refl.entries[i as usize].target_name.as_slice()) {\n            Ok(n) => n,\n            Err(_) => return Err(String::from_in(\"an entry point's name is not UTF-8\", gpa)),\n        };\n        out.entries.push(EntryPoint {\n            name: name,\n            native: native,\n            stage: wgsl_stage(refl.entries[i as usize].stage),\n            workgroup: refl.entries[i as usize].workgroup,\n            sizes_slot: refl.entries[i as usize].sizes_slot,\n        });\n    }\n    for i in 0..refl.bindings.len() as i64 {\n        let b = refl.bindings[i as usize];\n        out.bindings.push(Binding {\n            group: b.group, binding: b.binding, ty: wgsl_binding_type(b.kind),\n            slot_vertex: b.slots[0], slot_fragment: b.slots[1], slot_compute: b.slots[2],\n            min_size: b.min_size,\n        });\n    }\n    for i in 0..refl.inputs.len() as i64 {\n        let v = refl.inputs[i as usize];\n        match wgsl_vertex_format(v.scalar, v.components) {\n            Some(f) => out.input(v.location, f),\n            None => return Err(format_in(\"gpu: the vertex input at @location({}) has no VertexFormat (f32 x1..4, u32 x1, x2, x4, i32 x1)\", v.location, gpa)),\n        }\n    }\n    for i in 0..refl.sizes.len() as i64 {\n        let b = refl.bindings[refl.sizes[i as usize] as usize];\n        out.size_binding(b.group, b.binding);\n    }\n    for i in 0..refl.uses.len() as i64 {\n");
    buf_str(out, c"        out.use_binding(refl.uses[i as usize][0], refl.uses[i as usize][1]);\n    }\n    Ok(out)\n}\n// ---- end mod std::gpu::shader ----\n}\n// ---- mod std::gpu::timing ----\nmod timing {\n// EDITION: rust\n// std::gpu::timing (0.25.4): GPU timestamps (below).\n\nuse crate::gpu::{\n    Buffer, BufferUsage, Commands, ComputePass, Device, Encoder, PassDesc, Queue, RenderPass,\n    out_of_memory,\n};\nuse crate::gpu::hal::metal as backend;\n\ntype N = backend::Metal;\n\n// ---- GPU: timestamps (0.25.4) ----\n\n// std::gpu::timing (0.25.4): GPU timestamps, on WebGPU's timestamp-query.\n// A QuerySet holds timestamps (`dev.query_set(n)`); a timed pass writes\n// two of them, when its work begins and ends on the GPU\n// (`enc.compute_pass_timed(set, 0, 1, |pass| ...)`, `render_pass_timed`);\n// `enc.resolve_query_set` copies them, u64 each, into a buffer made with\n// BufferUsage::QUERY_RESOLVE; `queue.timestamp_period()` is a tick in ns.\n//\n// On Metal a timed pass is a command buffer of its own, and its\n// timestamps are that command buffer's GPUStartTime and GPUEndTime (the\n// host clock, in ns: the period is 1). Metal gives them once the work has\n// completed, so a submission with timed passes returns when their work\n// has finished, and a resolve in it waits for the passes before it.\n\n/// The most timestamps a query set holds (WebGPU's limit).\npub const MAX_QUERIES: i64 = 4096;\n\n/// Timestamps (`Device::query_set`): `count` of them, written by timed\n/// passes and copied out by `Encoder::resolve_query_set`.\npub struct QuerySet {\n    pub raw: backend::Buffer,\n    pub count: i64,\n}\n\nimpl QuerySet {\n    pub fn count(&self) -> i64 {\n        self.count\n    }\n}\n\n/// A command buffer an encoder ended early: the one before a timed pass,\n/// the timed pass, or the one before a resolve. `resolve`: the\n/// timestamps before it are written before it is submitted.\npub struct Seg {\n    pub cb: backend::CommandBuffer,\n    pub resolve: bool,\n}\n\n");
    buf_str(out, c"/// A timestamp a timed pass writes: its set (a handle), its index, the\n/// segment of the pass, and which end of it.\npub struct Stamp {\n    pub set: backend::Buffer,\n    pub index: i64,\n    pub seg: i64,\n    pub end: bool,\n}\n\nimpl Device<Gpa> {\n    /// A set of count timestamps (1 to 4096), zero until a timed pass\n    /// writes them.\n    pub fn query_set(&self, count: i64) -> QuerySet\n        requires self.caps.timestamps\n        else \"gpu.unsupported: this device has no GPU timestamps (dev.caps().timestamps)\"\n        requires count >= 1 && count <= MAX_QUERIES\n        else \"gpu.limits: a query set of {count} timestamps; a set holds 1 to 4096\"\n        {\n        match N::create_buffer(&self.raw, count * 8, &[]) {\n            Some(b) => QuerySet { raw: b, count: count },\n            None => out_of_memory(\"query set\"),\n        }\n    }\n}\n\nimpl Queue {\n    /// The ns of a timestamp's tick (WebGPU's getTimestampPeriod): 1 on\n    /// Metal, whose timestamps are ns already.\n    pub fn timestamp_period(&self) -> f64 {\n        1.0\n    }\n}\n\nimpl Encoder<Gpa> {\n    /// A compute pass that writes timestamp `begin` of set when its work\n    /// begins on the GPU and `end` when it ends (-1: not that one).\n    pub fn compute_pass_timed<F: FnMut(&mut ComputePass)>(&mut self, set: &QuerySet, begin: i64,\n        end: i64, f: F)\n        requires self.caps.timestamps\n        else \"gpu.unsupported: this device has no GPU timestamps (dev.caps().timestamps)\"\n        requires begin >= -1 && begin < set.count && end >= -1 && end < set.count\n        else \"gpu.range: a timed pass's indices are -1 (none) or 0 to {}, the set's; these are {begin} and {end}\", set.count - 1\n        {\n        self.split(false);\n        self.compute_pass(f);\n        self.timed(set, begin, end);\n    }\n\n    /// A render pass that writes timestamp `begin` of set when its work\n    /// begins on the GPU and `end` when it ends (-1: not that one).\n");
    buf_str(out, c"    pub fn render_pass_timed<F: FnMut(&mut RenderPass)>(&mut self, desc: PassDesc<'_>,\n        set: &QuerySet, begin: i64, end: i64, f: F)\n        requires self.caps.timestamps\n        else \"gpu.unsupported: this device has no GPU timestamps (dev.caps().timestamps)\"\n        requires begin >= -1 && begin < set.count && end >= -1 && end < set.count\n        else \"gpu.range: a timed pass's indices are -1 (none) or 0 to {}, the set's; these are {begin} and {end}\", set.count - 1\n        {\n        self.split(false);\n        self.render_pass(desc, f);\n        self.timed(set, begin, end);\n    }\n\n    /// Copies timestamps first..first + count of set into dst at offset,\n    /// a u64 each (ticks: `queue.timestamp_period()` ns). Those of timed\n    /// passes submitted before or recorded before it have their values;\n    /// one never written is 0.\n    pub fn resolve_query_set(&mut self, set: &QuerySet, first: i64, count: i64, dst: &Buffer,\n        offset: i64)\n        requires first >= 0 && count >= 0 && first + count <= set.count\n        else \"gpu.range: timestamps {first}..{} of a set of {}\", first + count, set.count\n        requires dst.usage & BufferUsage::QUERY_RESOLVE != 0\n        else \"gpu.usage: resolve_query_set's buffer ({} bytes) was made without BufferUsage::QUERY_RESOLVE: add it where that buffer is made (QUERY_RESOLVE | COPY_SRC, then copy it into a MAP_READ one to read)\", dst.size\n        requires offset % 256 == 0\n        else \"gpu.align: resolve_query_set's offset {offset} is not a multiple of 256\"\n        requires offset >= 0 && offset + count * 8 <= dst.size\n        else \"gpu.range: {count} timestamps at {offset} reach past the buffer's {} bytes\", dst.size\n        requires !dst.mapped\n        else \"gpu.state: resolve_query_set's buffer ({} bytes) is mapped: unmap it first\", dst.size\n        {\n        if count == 0 { return; }\n        self.split(true);\n        self.uses(dst);\n");
    buf_str(out, c"        N::copy_buffer(&mut self.raw, &set.raw, first * 8, &dst.raw, offset, count * 8);\n    }\n\n    // Ends the command buffer recorded so far (a segment) and starts\n    // another; `resolve`: the new one resolves timestamps.\n    fn split(&mut self, resolve: bool) {\n        let cb = crate::mem::replace(&mut self.raw, N::begin(&self.dev));\n        self.segs.push(Seg { cb: cb, resolve: self.resolve_next });\n        self.resolve_next = resolve;\n    }\n\n    // The pass just recorded writes set's begin and end.\n    fn timed(&mut self, set: &QuerySet, begin: i64, end: i64) {\n        self.split(false);\n        let seg = self.segs.len() as i64 - 1;\n        if begin >= 0 {\n            self.stamps.push(Stamp {\n                set: N::buffer_handle(&set.raw), index: begin, seg: seg, end: false,\n            });\n        }\n        if end >= 0 {\n            self.stamps.push(Stamp {\n                set: N::buffer_handle(&set.raw), index: end, seg: seg, end: true,\n            });\n        }\n    }\n}\n\n/// Submits commands an encoder split (timed passes, resolves): the\n/// segments in order, the timestamps written into their sets before a\n/// resolve after them is submitted, and all of them before it returns.\npub fn submit_segments(q: &mut backend::Queue, c: &mut Commands<Gpa>) {\n    let mut written: i64 = 0;\n    for k in 0..c.segs.len() as i64 {\n        if c.segs[k as usize].resolve {\n            written = write_stamps(q, c, k, written);\n        }\n        N::submit_timed(q, &mut c.segs[k as usize].cb);\n    }\n    if c.resolve_next {\n        written = write_stamps(q, c, c.segs.len() as i64, written);\n    }\n    N::submit(q, &mut c.raw);\n    write_stamps(q, c, c.segs.len() as i64, written);\n}\n\n// Writes the timestamps from the `from`-th on of the segments before\n// `upto` into their sets, once their work has finished; how many are\n// written in all.\nfn write_stamps(q: &mut backend::Queue, c: &mut Commands<Gpa>, upto: i64, from: i64) -> i64 {\n");
    buf_str(out, c"    let mut i = from;\n    while i < c.stamps.len() as i64 && c.stamps[i as usize].seg < upto {\n        let seg = c.stamps[i as usize].seg;\n        let t = match N::gpu_times(&mut c.segs[seg as usize].cb) {\n            Some((begin, end)) => if c.stamps[i as usize].end { end } else { begin },\n            None => 0u64,\n        };\n        let mut b = [0u8; 8];\n        for j in 0..8 {\n            b[j as usize] = (t >> (8 * j) as u64) as u8;\n        }\n        N::write_buffer(q, &c.stamps[i as usize].set, c.stamps[i as usize].index * 8, &b[..]);\n        i += 1;\n    }\n    i\n}\n// ---- end mod std::gpu::timing ----\n}\n// ---- mod std::gpu::types ----\npub mod types {\n// EDITION: rust\n// std::gpu::types (0.22): flags, formats, descriptors (docs/design/gpu.md,\n// §2.2), re-exported by std::gpu. Flags are u32 constants in modules named\n// like the types the design makes them (`type BufferUsage = distinct\n// u32`): a distinct type cannot have named constants yet, so a BufferUsage\n// passed as a TextureUsage is not a type error until it can. Descriptors\n// are small plain structs with constructors for the common cases; their\n// fields are public, to change what differs.\n\n// ---- GPU types: flags, formats, descriptors (0.22) ----\n\n/// What a buffer may be used for (wgpu's values).\nuse crate::fmt::Debug;\n\npub mod BufferUsage {\n    pub const MAP_READ: u32 = 1;\n    pub const MAP_WRITE: u32 = 2;\n    pub const COPY_SRC: u32 = 4;\n    pub const COPY_DST: u32 = 8;\n    pub const INDEX: u32 = 16;\n    pub const VERTEX: u32 = 32;\n    pub const UNIFORM: u32 = 64;\n    pub const STORAGE: u32 = 128;\n    pub const INDIRECT: u32 = 256;\n    /// (0.25.4) The destination of `Encoder::resolve_query_set`.\n    pub const QUERY_RESOLVE: u32 = 512;\n}\n\n/// What a texture may be used for (wgpu's values).\npub mod TextureUsage {\n    pub const COPY_SRC: u32 = 1;\n    pub const COPY_DST: u32 = 2;\n    pub const TEXTURE_BINDING: u32 = 4;\n");
    buf_str(out, c"    pub const STORAGE_BINDING: u32 = 8;\n    pub const RENDER_ATTACHMENT: u32 = 16;\n}\n\n/// The shader stages a binding is visible in.\npub mod ShaderStage {\n    pub const VERTEX: u32 = 1;\n    pub const FRAGMENT: u32 = 2;\n    pub const COMPUTE: u32 = 4;\n}\n\n/// Which adapter `Instance::adapter` prefers.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Power {\n    Low,\n    High,\n}\n\n/// Texture formats: the ones the backends and tests use.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Format {\n    R8Unorm,\n    R8Uint,\n    Rg8Unorm,\n    R16Float,\n    R32Uint,\n    R32Sint,\n    R32Float,\n    Rg16Float,\n    Rgba8Unorm,\n    Rgba8UnormSrgb,\n    Rgba8Uint,\n    Bgra8Unorm,\n    Bgra8UnormSrgb,\n    Rg32Float,\n    Rgba16Float,\n    Rgba32Uint,\n    Rgba32Float,\n    Depth32Float,\n}\n\nimpl Format {\n    /// Bytes per texel.\n    #[pure]\n    pub fn size(self) -> i64 {\n        match self {\n            Format::R8Unorm | Format::R8Uint => 1,\n            Format::Rg8Unorm | Format::R16Float => 2,\n            Format::R32Uint | Format::R32Sint | Format::R32Float | Format::Rg16Float => 4,\n            Format::Rgba8Unorm | Format::Rgba8UnormSrgb | Format::Rgba8Uint => 4,\n            Format::Bgra8Unorm | Format::Bgra8UnormSrgb | Format::Depth32Float => 4,\n            Format::Rg32Float | Format::Rgba16Float => 8,\n            Format::Rgba32Uint | Format::Rgba32Float => 16,\n        }\n    }\n\n    #[pure]\n    pub fn is_depth(self) -> bool {\n        self == Format::Depth32Float\n    }\n\n    /// Whether a render pass may draw into it.\n    #[pure]\n    pub fn is_renderable(self) -> bool {\n        true\n    }\n\n    /// Whether a compute or fragment shader may write it as a storage\n    /// texture (WebGPU's storage formats among these).\n    #[pure]\n    pub fn is_storable(self) -> bool {\n        match self {\n            Format::R32Uint | Format::R32Sint | Format::R32Float | Format::Rgba8Unorm\n");
    buf_str(out, c"                | Format::Rgba8Uint => true,\n            Format::Rg32Float | Format::Rgba16Float | Format::Rgba32Uint\n                | Format::Rgba32Float => true,\n            _ => false,\n        }\n    }\n}\n\n/// Formats of vertex attributes.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum VertexFormat {\n    Float32,\n    Float32x2,\n    Float32x3,\n    Float32x4,\n    Uint32,\n    Uint32x2,\n    Uint32x4,\n    Sint32,\n    Unorm8x4,\n}\n\nimpl VertexFormat {\n    /// What the shader reads: the scalar (0 f32, 1 u32, 2 i32) times 8\n    /// plus the component count. Formats with one shader type feed the same\n    /// inputs (WebGPU's rule: Unorm8x4 feeds a vec4<f32>, as Float32x4 does).\n    #[pure]\n    pub fn shader_type(self) -> i64 {\n        match self {\n            VertexFormat::Float32 => 1,\n            VertexFormat::Float32x2 => 2,\n            VertexFormat::Float32x3 => 3,\n            VertexFormat::Float32x4 | VertexFormat::Unorm8x4 => 4,\n            VertexFormat::Uint32 => 9,\n            VertexFormat::Uint32x2 => 10,\n            VertexFormat::Uint32x4 => 12,\n            VertexFormat::Sint32 => 17,\n        }\n    }\n\n    #[pure]\n    pub fn size(self) -> i64 {\n        match self {\n            VertexFormat::Float32 | VertexFormat::Uint32 | VertexFormat::Sint32\n                | VertexFormat::Unorm8x4 => 4,\n            VertexFormat::Float32x2 | VertexFormat::Uint32x2 => 8,\n            VertexFormat::Float32x3 => 12,\n            VertexFormat::Float32x4 | VertexFormat::Uint32x4 => 16,\n        }\n    }\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum StepMode {\n    Vertex,\n    Instance,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum IndexFormat {\n    Uint16,\n    Uint32,\n}\n\nimpl IndexFormat {\n    #[pure]\n    pub fn size(self) -> i64 {\n        match self {\n            IndexFormat::Uint16 => 2,\n            IndexFormat::Uint32 => 4,\n        }\n    }\n}\n\n");
    buf_str(out, c"#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Topology {\n    PointList,\n    LineList,\n    LineStrip,\n    TriangleList,\n    TriangleStrip,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Cull {\n    None,\n    Front,\n    Back,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum FrontFace {\n    Ccw,\n    Cw,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Compare {\n    Never,\n    Less,\n    Equal,\n    LessEqual,\n    Greater,\n    NotEqual,\n    GreaterEqual,\n    Always,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Filter {\n    Nearest,\n    Linear,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum AddressMode {\n    ClampToEdge,\n    Repeat,\n    MirrorRepeat,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum BlendFactor {\n    Zero,\n    One,\n    Src,\n    OneMinusSrc,\n    SrcAlpha,\n    OneMinusSrcAlpha,\n    Dst,\n    OneMinusDst,\n    DstAlpha,\n    OneMinusDstAlpha,\n}\n\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum BlendOp {\n    Add,\n    Subtract,\n    ReverseSubtract,\n    Min,\n    Max,\n}\n\n/// One blend equation: src * src_factor OP dst * dst_factor.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct BlendComponent {\n    pub src: BlendFactor,\n    pub dst: BlendFactor,\n    pub op: BlendOp,\n}\n\n/// A color target's blending; `None` in ColorTarget writes the source.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct Blend {\n    pub color: BlendComponent,\n    pub alpha: BlendComponent,\n}\n\nimpl Blend {\n    /// Source over destination, straight alpha (wgpu's ALPHA_BLENDING).\n    pub fn alpha() -> Blend {\n        Blend {\n            color: BlendComponent {\n                src: BlendFactor::SrcAlpha, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add,\n            },\n            alpha: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add,\n            },\n        }\n");
    buf_str(out, c"    }\n\n    /// Premultiplied alpha.\n    pub fn premultiplied() -> Blend {\n        Blend {\n            color: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add,\n            },\n            alpha: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::OneMinusSrcAlpha, op: BlendOp::Add,\n            },\n        }\n    }\n\n    /// src + dst.\n    pub fn additive() -> Blend {\n        Blend {\n            color: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::One, op: BlendOp::Add,\n            },\n            alpha: BlendComponent {\n                src: BlendFactor::One, dst: BlendFactor::One, op: BlendOp::Add,\n            },\n        }\n    }\n}\n\n/// A clear color, components in 0..1 for normalized formats.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct Color {\n    pub r: f64,\n    pub g: f64,\n    pub b: f64,\n    pub a: f64,\n}\n\nimpl Color {\n    pub fn rgba(r: f64, g: f64, b: f64, a: f64) -> Color {\n        Color { r: r, g: g, b: b, a: a }\n    }\n\n    pub fn black() -> Color {\n        Color { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }\n    }\n\n    pub fn transparent() -> Color {\n        Color { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }\n    }\n}\n\n/// A sampler's description; `SamplerDesc::nearest()` and `::linear()`\n/// are the common ones.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct SamplerDesc {\n    pub mag: Filter,\n    pub min: Filter,\n    pub mip: Filter,\n    pub address_u: AddressMode,\n    pub address_v: AddressMode,\n    pub address_w: AddressMode,\n    pub lod_min: f32,\n    pub lod_max: f32,\n    pub compare: Option<Compare>,\n    pub anisotropy: i64,\n}\n\nimpl SamplerDesc {\n    pub fn nearest() -> SamplerDesc {\n        SamplerDesc {\n            mag: Filter::Nearest,\n            min: Filter::Nearest,\n            mip: Filter::Nearest,\n            address_u: AddressMode::ClampToEdge,\n");
    buf_str(out, c"            address_v: AddressMode::ClampToEdge,\n            address_w: AddressMode::ClampToEdge,\n            lod_min: 0.0,\n            lod_max: 32.0,\n            compare: None,\n            anisotropy: 1,\n        }\n    }\n\n    pub fn linear() -> SamplerDesc {\n        let mut d = SamplerDesc::nearest();\n        d.mag = Filter::Linear;\n        d.min = Filter::Linear;\n        d.mip = Filter::Linear;\n        d\n    }\n}\n\n/// A texture's description (2D, or a 2D array with layers > 1).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct TextureDesc {\n    pub width: i64,\n    pub height: i64,\n    pub layers: i64,\n    pub mips: i64,\n    pub format: Format,\n    pub usage: u32,\n}\n\n/// The device's limits (wgpu's names; the defaults hold on Metal and on\n/// lavapipe).\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct Limits {\n    pub max_texture_dimension_2d: i64,\n    pub max_texture_array_layers: i64,\n    pub max_bind_groups: i64,\n    pub max_bindings_per_group: i64,\n    pub max_buffer_size: i64,\n    pub max_vertex_buffers: i64,\n    pub max_vertex_attributes: i64,\n    pub max_color_attachments: i64,\n    pub min_uniform_buffer_offset_alignment: i64,\n    pub min_storage_buffer_offset_alignment: i64,\n    pub max_compute_workgroup_size_x: i64,\n    pub max_compute_workgroup_size_y: i64,\n    pub max_compute_workgroup_size_z: i64,\n    pub max_compute_invocations_per_workgroup: i64,\n    pub max_compute_workgroups_per_dimension: i64,\n}\n\nimpl Limits {\n    pub fn default() -> Limits {\n        Limits {\n            max_texture_dimension_2d: 16384,\n            max_texture_array_layers: 2048,\n            max_bind_groups: 4,\n            max_bindings_per_group: 16,\n            max_buffer_size: 1 << 30,\n            max_vertex_buffers: 8,\n            max_vertex_attributes: 16,\n            max_color_attachments: 8,\n            min_uniform_buffer_offset_alignment: 256,\n            min_storage_buffer_offset_alignment: 256,\n");
    buf_str(out, c"            max_compute_workgroup_size_x: 1024,\n            max_compute_workgroup_size_y: 1024,\n            max_compute_workgroup_size_z: 64,\n            max_compute_invocations_per_workgroup: 1024,\n            max_compute_workgroups_per_dimension: 65535,\n        }\n    }\n}\n\n/// One attribute of a vertex buffer: `@location(location)` reads `format`\n/// at `offset` in each element.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct VertexAttribute {\n    pub format: VertexFormat,\n    pub offset: i64,\n    pub location: i64,\n}\n\npub const MAX_VERTEX_ATTRIBUTES: i64 = 8;\npub const MAX_VERTEX_BUFFERS: i64 = 8;\npub const MAX_COLOR_TARGETS: i64 = 8;\npub const MAX_BIND_GROUPS: i64 = 4;\n\n/// A vertex buffer's layout: its stride, step mode and attributes (at most\n/// MAX_VERTEX_ATTRIBUTES, kept in a fixed array: no allocation).\n#[derive(PartialEq, Eq, Clone, Copy)]\npub struct VertexLayout {\n    pub stride: i64,\n    pub step: StepMode,\n    pub attributes: [VertexAttribute; 8],\n    pub count: i64,\n}\n\nimpl VertexLayout {\n    pub fn new(stride: i64, step: StepMode = StepMode::Vertex) -> VertexLayout {\n        VertexLayout {\n            stride: stride, step: step,\n            attributes: [VertexAttribute { format: VertexFormat::Float32, offset: 0, location: 0 };\n                8], count: 0,\n        }\n    }\n\n    pub fn attribute(&mut self, location: i64, format: VertexFormat, offset: i64)\n        requires self.count < MAX_VERTEX_ATTRIBUTES\n        else \"gpu.limits: at most 8 attributes in a vertex buffer\"\n        {\n        self.attributes[self.count as usize] = VertexAttribute {\n            format: format, offset: offset, location: location,\n        };\n        self.count += 1;\n    }\n}\n\n/// A color target of a render pipeline.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct ColorTarget {\n    pub format: Format,\n    pub blend: Option<Blend>,\n    pub write_mask: u32,\n}\n\n/// The depth test of a render pipeline.\n");
    buf_str(out, c"#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub struct DepthState {\n    pub format: Format,\n    pub write: bool,\n    pub compare: Compare,\n}\n\n/// Everything about a render pipeline but its shaders: plain data, so\n/// that the hal takes it as it is.\n#[derive(PartialEq, Eq, Clone, Copy)]\npub struct PipelineState {\n    pub topology: Topology,\n    pub cull: Cull,\n    pub front_face: FrontFace,\n    pub buffers: [VertexLayout; 8],\n    pub buffer_count: i64,\n    pub targets: [ColorTarget; 8],\n    pub target_count: i64,\n    pub depth: Option<DepthState>,\n}\n\nimpl PipelineState {\n    pub fn new(format: Format) -> PipelineState {\n        let t = ColorTarget { format: format, blend: None, write_mask: 15 };\n        PipelineState {\n            topology: Topology::TriangleList,\n            cull: Cull::None,\n            front_face: FrontFace::Ccw,\n            buffers: [VertexLayout::new(0); 8],\n            buffer_count: 0,\n            targets: [t; 8],\n            target_count: 1,\n            depth: None,\n        }\n    }\n}\n\n/// How a render pass starts with an attachment.\n#[derive(PartialEq, Eq, Debug, Clone, Copy)]\npub enum Load {\n    Clear,\n    Keep,\n    DontCare,\n}\n// ---- end mod std::gpu::types ----\n}\n// ---- mod std::gpu::wgsl ----\npub mod wgsl {\n// EDITION: rust\n// std::gpu::wgsl (0.27.6): the shader compiler's front end, MVS's\n// (docs/design/gpu.md §2.10), translated: WGSL (the subset of §2.10)\n// parsed, resolved and type-checked into the target-neutral IR, and the\n// uniformity analysis. What the compiler checks an `embed wgsl` block\n// with:\n//\n//   let mut fr = front::new_front(text, a);\n//   fr.module();\n//   if !fr.failed {\n//       uniformity::check(&fr);\n//   }\n//   // fr.failed: fr.err_code (wgsl.*), fr.err_pos, fr.emsg, fr.ehelp\n//\n// `a` is an allocator the front's tables live in (an arena's scope, `&s`).\n// The back ends (0.28.0): `bounds` (the bounds checks), `msl` (Metal\n");
    buf_str(out, c"// Shading Language), `spirv` (a stub), `interp` (the CPU interpreter of\n// compute jobs), `dump` (the IR as text), `job` (a compute job's text\n// form) and `api`: `translate`, the reflection and the errors.\n// mvs: std::gpu::wgsl\n\npub mod ir;\nmod names;\nmod lex;\npub mod front;\nmod expr;\nmod builtins;\npub mod entry;\npub mod bounds;\npub mod uniformity;\npub mod msl;\npub mod spirv;\npub mod interp;\npub mod dump;\npub mod job;\npub mod api;\n\npub use api::{\n    BK_COMPARISON_SAMPLER, BK_READ_ONLY_STORAGE, BK_SAMPLER, BK_STORAGE, BK_STORAGE_TEXTURE,\n    BK_TEXTURE, BK_UNIFORM, BindingInfo, EntryInfo, InputInfo, Options, Reflection, ShaderError,\n    SourceLine, TARGET_CHECK, TARGET_IR, TARGET_MSL, TARGET_SPIRV, line_col, new_error,\n    new_reflection, options, sizes_words, target_error, translate,\n};\npub(crate) use api::translate_buf;\n// ---- mod std::gpu::wgsl::ir ----\npub mod ir {\n// EDITION: rust\n// ---- Shader compiler implementation, ir (0.22) ----\n// The shader IR (docs/design/gpu.md §2.10): what the front end makes\n// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is\n// plain data: i64 handles into Vecs, one arena per translation.\n//\n// - Types are module-wide and interned: a handle is equal for equal types.\n//   The scalar, vector and matrix types have fixed handles (`vec_ty`,\n//   `mat_ty`); the rest are found through `types_map`.\n// - A function has an expression arena, a statement arena and blocks\n//   (runs of statement handles in `items`). Expressions are evaluated\n//   where an `S_EMIT` statement covers them, in order, except the results\n//   of calls and atomics (made by their statement) and the leaves\n//   (literals, arguments, variables), which have no cost.\n// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's\n//   kind, set by bounds.vl; a back end never sees `CK_PENDING`.\n//\n// Moves to compiler/std/gpu/wgsl/ir.vl with C2 (std submodules).\n\nuse crate::alloc::Allocator;\n");
    buf_str(out, c"use crate::cmp::PartialEq as Eq;\nuse crate::collections::HashMap;\nuse crate::hash::Hash;\n\n// ---- Shader compiler implementation, ir: Scalars (0.22) ----\n\npub(crate) const SK_BOOL: u8 = 0;\npub(crate) const SK_I32: u8 = 1;\npub(crate) const SK_U32: u8 = 2;\npub(crate) const SK_F32: u8 = 3;\n// Abstract numbers exist only in the front end (const evaluation).\npub(crate) const SK_AINT: u8 = 4;\npub(crate) const SK_AFLOAT: u8 = 5;\n\n// ---- Shader compiler implementation, ir: Types (0.22) ----\n\npub(crate) const TK_SCALAR: u8 = 0;\npub(crate) const TK_VECTOR: u8 = 1;\n// n columns of m rows of f32\npub(crate) const TK_MATRIX: u8 = 2;\n// base: the element; n: the length, 0 when runtime-sized\npub(crate) const TK_ARRAY: u8 = 3;\npub(crate) const TK_STRUCT: u8 = 4;\npub(crate) const TK_ATOMIC: u8 = 5;\n// base: the pointee; space, access\npub(crate) const TK_POINTER: u8 = 6;\n// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format\npub(crate) const TK_TEXTURE: u8 = 7;\n// n: 1 for sampler_comparison\npub(crate) const TK_SAMPLER: u8 = 8;\n\npub(crate) const TEX_2D: i64 = 0;\npub(crate) const TEX_2D_ARRAY: i64 = 1;\npub(crate) const TEX_DEPTH_2D: i64 = 2;\npub(crate) const TEX_STORAGE_2D: i64 = 3;\n\n// Texel formats of storage textures (TK_TEXTURE.m).\npub(crate) const FMT_RGBA8UNORM: i64 = 0;\npub(crate) const FMT_RGBA32FLOAT: i64 = 1;\npub(crate) const FMT_R32FLOAT: i64 = 2;\npub(crate) const FMT_R32UINT: i64 = 3;\npub(crate) const FMT_R32SINT: i64 = 4;\npub(crate) const FMT_RGBA32UINT: i64 = 5;\npub(crate) const FMT_RGBA16FLOAT: i64 = 6;\npub(crate) const FMT_RGBA8UINT: i64 = 7;\npub(crate) const FMT_RG32FLOAT: i64 = 8;\n\n// Address spaces.\npub(crate) const SP_FUNCTION: u8 = 0;\npub(crate) const SP_PRIVATE: u8 = 1;\npub(crate) const SP_WORKGROUP: u8 = 2;\npub(crate) const SP_UNIFORM: u8 = 3;\npub(crate) const SP_STORAGE: u8 = 4;\n// textures and samplers: no address space, the global is the value\n");
    buf_str(out, c"pub(crate) const SP_HANDLE: u8 = 5;\n\n// Access modes (bits).\npub(crate) const ACC_READ: u8 = 1;\npub(crate) const ACC_WRITE: u8 = 2;\npub(crate) const ACC_RW: u8 = 3;\n\n#[derive(Clone, Copy)] pub struct Type<'a> {\n    pub(crate) kind: u8,\n    pub(crate) scalar: u8,\n    pub(crate) space: u8,\n    pub(crate) access: u8,\n    pub(crate) n: i64,\n    pub(crate) m: i64,\n    pub(crate) base: i64,\n    // struct members: members[mstart .. mstart + mcount]\n    pub(crate) mstart: i64,\n    pub(crate) mcount: i64,\n    pub(crate) name: &'a [u8],\n    // the WGSL memory layout, in bytes (every type, every address space)\n    pub(crate) size: i64,\n    pub(crate) align: i64,\n    // arrays: the element stride; matrices: the column stride\n    pub(crate) stride: i64,\n}\n\n// What an entry point's parameter, result or IO struct member is bound to.\npub(crate) const BIND_NONE: u8 = 0;\npub(crate) const BIND_BUILTIN: u8 = 1;\npub(crate) const BIND_LOCATION: u8 = 2;\n\npub(crate) const INTERP_PERSPECTIVE: u8 = 0;\npub(crate) const INTERP_LINEAR: u8 = 1;\npub(crate) const INTERP_FLAT: u8 = 2;\n\n#[derive(Clone, Copy)] pub struct Binding { pub kind: u8, pub interp: u8, pub value: i64 }\n\n#[effects()]\npub(crate) fn no_binding() -> Binding {\n    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }\n}\n\npub(crate) const BI_POSITION: i64 = 0;\npub(crate) const BI_VERTEX_INDEX: i64 = 1;\npub(crate) const BI_INSTANCE_INDEX: i64 = 2;\npub(crate) const BI_FRONT_FACING: i64 = 3;\npub(crate) const BI_FRAG_DEPTH: i64 = 4;\npub(crate) const BI_SAMPLE_INDEX: i64 = 5;\npub(crate) const BI_SAMPLE_MASK: i64 = 6;\npub(crate) const BI_LOCAL_INVOCATION_ID: i64 = 7;\npub(crate) const BI_LOCAL_INVOCATION_INDEX: i64 = 8;\npub(crate) const BI_GLOBAL_INVOCATION_ID: i64 = 9;\npub(crate) const BI_WORKGROUP_ID: i64 = 10;\npub(crate) const BI_NUM_WORKGROUPS: i64 = 11;\n\n#[derive(Clone, Copy)] pub struct StructMember<'a> {\n");
    buf_str(out, c"    pub name: &'a [u8], pub ty: i64, pub offset: i64, pub binding: Binding,\n}\n\n// ---- Shader compiler implementation, ir: Expressions (0.22) ----\n\n// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)\npub(crate) const E_LITERAL: u8 = 0;\npub(crate) const E_ZERO: u8 = 1;\n// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a\n// matrix, elements, members\npub(crate) const E_COMPOSE: u8 = 2;\n// a: a scalar\npub(crate) const E_SPLAT: u8 = 3;\n// a: the vector; b: the components, 2 bits each from bit 0; c: how many\npub(crate) const E_SWIZZLE: u8 = 4;\n// a: base (a pointer or a value); b: the index expression; c: CK_*;\n// d: the length when the check is a clamp\npub(crate) const E_ACCESS: u8 = 5;\n// a: base (a pointer or a value); b: the constant index (a member, or a\n// component of a vector, matrix or fixed-size array, checked statically)\npub(crate) const E_ACCESS_INDEX: u8 = 6;\n// a: the parameter's index\npub(crate) const E_ARG: u8 = 7;\n// a: the global; its type is a pointer (a texture or sampler: the handle)\npub(crate) const E_GLOBAL: u8 = 8;\n// a: the local; a pointer<function>\npub(crate) const E_LOCAL: u8 = 9;\n// a: the pointer\npub(crate) const E_LOAD: u8 = 10;\n// a: UN_*; b: the operand\npub(crate) const E_UNARY: u8 = 11;\n// a: OP_*; b, c: the operands\npub(crate) const E_BINARY: u8 = 12;\n// a: the condition (bool, or a vector of bool); b: if true; c: if false\npub(crate) const E_SELECT: u8 = 13;\n// a: MF_*; b, c: args[b .. b + c]\npub(crate) const E_MATH: u8 = 14;\n// a: the operand; the type is the target (value conversion)\npub(crate) const E_CONVERT: u8 = 15;\n// a: the operand; the type is the target (bits)\npub(crate) const E_BITCAST: u8 = 16;\n// made by S_CALL\npub(crate) const E_CALL_RESULT: u8 = 17;\n// made by S_ATOMIC\npub(crate) const E_ATOMIC_RESULT: u8 = 18;\n// a: a pointer to a runtime-sized array (or a struct ending in one: b is\n// then the member index, else -1)\n");
    buf_str(out, c"pub(crate) const E_ARRAY_LENGTH: u8 = 19;\n// a: DV_*; b: the operand\npub(crate) const E_DERIVATIVE: u8 = 20;\n// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then\n// array index, bias/level/depth ref as `aux`): see IMG_*\npub(crate) const E_IMAGE_SAMPLE: u8 = 21;\n// a: the texture; c: args (coords, array index, level)\npub(crate) const E_IMAGE_LOAD: u8 = 22;\n// a: the texture; b: IQ_*; c: the level expression or -1\npub(crate) const E_IMAGE_QUERY: u8 = 23;\n// a: the pointer; made by S_WG_UNIFORM_LOAD\npub(crate) const E_WG_UNIFORM_RESULT: u8 = 24;\n\n// Bounds checks of E_ACCESS.\npub(crate) const CK_PENDING: i64 = 0;\n// proven in range: no check\npub(crate) const CK_NONE: i64 = 1;\n// fixed length d: index = min(index, d - 1)\npub(crate) const CK_CLAMP: i64 = 2;\n// runtime-sized: out of range, a load reads zero and a store is skipped\npub(crate) const CK_RZSW: i64 = 3;\n\npub(crate) const UN_NEG: i64 = 0;\npub(crate) const UN_NOT: i64 = 1;\npub(crate) const UN_BITNOT: i64 = 2;\n\npub(crate) const OP_ADD: i64 = 0;\npub(crate) const OP_SUB: i64 = 1;\npub(crate) const OP_MUL: i64 = 2;\npub(crate) const OP_DIV: i64 = 3;\npub(crate) const OP_MOD: i64 = 4;\npub(crate) const OP_EQ: i64 = 5;\npub(crate) const OP_NE: i64 = 6;\npub(crate) const OP_LT: i64 = 7;\npub(crate) const OP_LE: i64 = 8;\npub(crate) const OP_GT: i64 = 9;\npub(crate) const OP_GE: i64 = 10;\n// bitwise on integers; logical (both operands evaluated) on bool\npub(crate) const OP_AND: i64 = 11;\npub(crate) const OP_OR: i64 = 12;\npub(crate) const OP_XOR: i64 = 13;\npub(crate) const OP_SHL: i64 = 14;\npub(crate) const OP_SHR: i64 = 15;\n// short-circuit forms are lowered to control flow when the right side\n// has effects; else they are these, on bool\npub(crate) const OP_LAND: i64 = 16;\npub(crate) const OP_LOR: i64 = 17;\n\n// Math functions (E_MATH). Component-wise unless noted.\npub(crate) const MF_ABS: i64 = 0;\npub(crate) const MF_MIN: i64 = 1;\npub(crate) const MF_MAX: i64 = 2;\n");
    buf_str(out, c"pub(crate) const MF_CLAMP: i64 = 3;\npub(crate) const MF_SIGN: i64 = 4;\npub(crate) const MF_FLOOR: i64 = 5;\npub(crate) const MF_CEIL: i64 = 6;\npub(crate) const MF_ROUND: i64 = 7;\npub(crate) const MF_FRACT: i64 = 8;\npub(crate) const MF_TRUNC: i64 = 9;\npub(crate) const MF_SQRT: i64 = 10;\npub(crate) const MF_INVERSE_SQRT: i64 = 11;\npub(crate) const MF_EXP: i64 = 12;\npub(crate) const MF_EXP2: i64 = 13;\npub(crate) const MF_LOG: i64 = 14;\npub(crate) const MF_LOG2: i64 = 15;\npub(crate) const MF_POW: i64 = 16;\npub(crate) const MF_SIN: i64 = 17;\npub(crate) const MF_COS: i64 = 18;\npub(crate) const MF_TAN: i64 = 19;\npub(crate) const MF_ASIN: i64 = 20;\npub(crate) const MF_ACOS: i64 = 21;\npub(crate) const MF_ATAN: i64 = 22;\npub(crate) const MF_ATAN2: i64 = 23;\npub(crate) const MF_SINH: i64 = 24;\npub(crate) const MF_COSH: i64 = 25;\npub(crate) const MF_TANH: i64 = 26;\npub(crate) const MF_MIX: i64 = 27;\npub(crate) const MF_STEP: i64 = 28;\npub(crate) const MF_SMOOTHSTEP: i64 = 29;\npub(crate) const MF_FMA: i64 = 30;\n// the rest reduce or are not component-wise\npub(crate) const MF_LENGTH: i64 = 31;\npub(crate) const MF_DISTANCE: i64 = 32;\npub(crate) const MF_DOT: i64 = 33;\npub(crate) const MF_CROSS: i64 = 34;\npub(crate) const MF_NORMALIZE: i64 = 35;\npub(crate) const MF_REFLECT: i64 = 36;\npub(crate) const MF_DETERMINANT: i64 = 37;\npub(crate) const MF_TRANSPOSE: i64 = 38;\npub(crate) const MF_COUNT_ONE_BITS: i64 = 39;\npub(crate) const MF_COUNT_LEADING_ZEROS: i64 = 40;\npub(crate) const MF_COUNT_TRAILING_ZEROS: i64 = 41;\npub(crate) const MF_FIRST_LEADING_BIT: i64 = 42;\npub(crate) const MF_FIRST_TRAILING_BIT: i64 = 43;\npub(crate) const MF_REVERSE_BITS: i64 = 44;\npub(crate) const MF_EXTRACT_BITS: i64 = 45;\npub(crate) const MF_INSERT_BITS: i64 = 46;\npub(crate) const MF_ALL: i64 = 47;\npub(crate) const MF_ANY: i64 = 48;\npub(crate) const MF_DEGREES: i64 = 49;\npub(crate) const MF_RADIANS: i64 = 50;\npub(crate) const MF_SATURATE: i64 = 51;\n");
    buf_str(out, c"pub(crate) const MF_PACK4X8UNORM: i64 = 52;\npub(crate) const MF_UNPACK4X8UNORM: i64 = 53;\npub(crate) const MF_PACK2X16FLOAT: i64 = 54;\npub(crate) const MF_UNPACK2X16FLOAT: i64 = 55;\npub(crate) const MF_ASINH: i64 = 56;\npub(crate) const MF_ACOSH: i64 = 57;\npub(crate) const MF_ATANH: i64 = 58;\npub(crate) const MF_FACE_FORWARD: i64 = 59;\npub(crate) const MF_LDEXP: i64 = 60;\npub(crate) const MF_PACK4X8SNORM: i64 = 61;\npub(crate) const MF_UNPACK4X8SNORM: i64 = 62;\npub(crate) const MF_PACK2X16UNORM: i64 = 63;\npub(crate) const MF_UNPACK2X16UNORM: i64 = 64;\npub(crate) const MF_PACK2X16SNORM: i64 = 65;\npub(crate) const MF_UNPACK2X16SNORM: i64 = 66;\npub(crate) const MF_COUNT: i64 = 67;\n\npub(crate) const DV_DPDX: i64 = 0;\npub(crate) const DV_DPDY: i64 = 1;\npub(crate) const DV_FWIDTH: i64 = 2;\n\n// E_IMAGE_SAMPLE kinds (Expr.d's low byte) and its args: the coordinates,\n// then the array index when the texture is an array, then the kind's\n// operand (bias, level, depth reference).\npub(crate) const IMG_SAMPLE: i64 = 0;\npub(crate) const IMG_SAMPLE_BIAS: i64 = 1;\npub(crate) const IMG_SAMPLE_LEVEL: i64 = 2;\npub(crate) const IMG_SAMPLE_COMPARE: i64 = 3;\npub(crate) const IMG_SAMPLE_COMPARE_LEVEL: i64 = 4;\n\npub(crate) const IQ_SIZE: i64 = 0;\npub(crate) const IQ_LEVELS: i64 = 1;\npub(crate) const IQ_LAYERS: i64 = 2;\n\n#[derive(Clone, Copy)] pub struct Expr {\n    pub op: u8, pub ty: i64, pub a: i64, pub b: i64, pub c: i64, pub d: i64,\n}\n\n// ---- Shader compiler implementation, ir: Statements (0.22) ----\n\n// a .. b: the expressions evaluated here, in order\npub(crate) const S_EMIT: u8 = 0;\n// a: the block\npub(crate) const S_BLOCK: u8 = 1;\n// a: the condition; b: then; c: else (a block, possibly empty)\npub(crate) const S_IF: u8 = 2;\n// a: the selector (i32 or u32); b, c: cases[b .. b + c]\npub(crate) const S_SWITCH: u8 = 3;\n// a: body; b: continuing; c: the break-if expression, or -1 (evaluated\n// at the end of continuing, after its emits)\n");
    buf_str(out, c"pub(crate) const S_LOOP: u8 = 4;\npub(crate) const S_BREAK: u8 = 5;\npub(crate) const S_CONTINUE: u8 = 6;\n// a: the value, or -1\npub(crate) const S_RETURN: u8 = 7;\n// discard\npub(crate) const S_KILL: u8 = 8;\n// a: BARRIER_* bits\npub(crate) const S_BARRIER: u8 = 9;\n// a: the pointer; b: the value\npub(crate) const S_STORE: u8 = 10;\n// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1\npub(crate) const S_CALL: u8 = 11;\n// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;\n// e: the comparand (AT_CMPXCHG) or -1\npub(crate) const S_ATOMIC: u8 = 12;\n// a: the texture; b: the coordinates; c: the value; d: the array index or -1\npub(crate) const S_IMAGE_STORE: u8 = 13;\n// a: the pointer; b: the E_WG_UNIFORM_RESULT\npub(crate) const S_WG_UNIFORM_LOAD: u8 = 14;\n\npub(crate) const BARRIER_WORKGROUP: i64 = 1;\npub(crate) const BARRIER_STORAGE: i64 = 2;\n\npub(crate) const AT_ADD: i64 = 0;\npub(crate) const AT_SUB: i64 = 1;\npub(crate) const AT_AND: i64 = 2;\npub(crate) const AT_OR: i64 = 3;\npub(crate) const AT_XOR: i64 = 4;\npub(crate) const AT_MIN: i64 = 5;\npub(crate) const AT_MAX: i64 = 6;\npub(crate) const AT_EXCHANGE: i64 = 7;\npub(crate) const AT_LOAD: i64 = 8;\npub(crate) const AT_STORE: i64 = 9;\n// the result is __atomic_compare_exchange_result: { old_value, exchanged }\npub(crate) const AT_CMPXCHG: i64 = 10;\n\n#[derive(Clone, Copy)] pub struct Stmt {\n    pub op: u8, pub a: i64, pub b: i64, pub c: i64, pub d: i64, pub e: i64,\n}\n\n// A switch clause: its selector values (vals[vstart .. vstart + vcount]),\n// whether it is the default, its body.\n#[derive(Clone, Copy)] pub struct Case {\n    pub vstart: i64, pub vcount: i64, pub is_default: bool, pub body: i64,\n}\n\n// A run of statement handles: items[start .. start + count].\n#[derive(Clone, Copy)] pub struct Block { pub start: i64, pub count: i64 }\n\n#[derive(Clone, Copy)] pub struct Param<'a> {\n    pub name: &'a [u8], pub ty: i64, pub binding: Binding,\n}\n\n");
    buf_str(out, c"#[derive(Clone, Copy)] pub struct Local<'a> { pub name: &'a [u8], pub ty: i64 }\n\npub(crate) struct Function<'a, A: Allocator> {\n    pub(crate) name: &'a [u8],\n    pub params: Vec<Param<'a>, A>,\n    // -1: no result\n    pub result: i64,\n    pub(crate) result_binding: Binding,\n    pub(crate) locals: Vec<Local<'a>, A>,\n    pub(crate) exprs: Vec<Expr, A>,\n    // the names of `let` declarations: names[e] for expression e, or \"\"\n    pub(crate) names: Vec<&'a [u8], A>,\n    pub(crate) stmts: Vec<Stmt, A>,\n    pub(crate) blocks: Vec<Block, A>,\n    pub(crate) items: Vec<i64, A>,\n    pub(crate) args: Vec<i64, A>,\n    pub(crate) cases: Vec<Case, A>,\n    pub(crate) vals: Vec<i64, A>,\n    pub(crate) body: i64,\n    // the source position of the declaration (a byte offset)\n    pub(crate) pos: i64,\n}\n\n#[derive(Clone, Copy)] pub struct Global<'a> {\n    pub(crate) name: &'a [u8],\n    pub(crate) space: u8,\n    pub(crate) access: u8,\n    // the value's type (a texture, a sampler, or what the pointer points to)\n    pub(crate) ty: i64,\n    pub(crate) group: i64,\n    pub(crate) binding: i64,\n    // private globals: an expression of the module's init function, or -1\n    pub(crate) init: i64,\n    pub(crate) pos: i64,\n}\n\npub(crate) const STAGE_VERTEX: u8 = 0;\npub(crate) const STAGE_FRAGMENT: u8 = 1;\npub const STAGE_COMPUTE: u8 = 2;\n\n#[derive(Clone, Copy)] pub struct Entry<'a> {\n    pub(crate) stage: u8, pub name: &'a [u8], pub func: i64, pub wg: [i64; 3],\n    pub early_depth: bool,\n}\n\n#[derive(PartialEq, Eq, Hash, Clone, Copy)]\npub(crate) struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }\n\npub(crate) struct Module<'a, A: Allocator> {\n    pub(crate) types: Vec<Type<'a>, A>,\n    types_map: HashMap<TypeKey, i64, A>,\n    pub(crate) members: Vec<StructMember<'a>, A>,\n    pub(crate) globals: Vec<Global<'a>, A>,\n    pub functions: Vec<Function<'a, A>, A>,\n    pub entries: Vec<Entry<'a>, A>,\n");
    buf_str(out, c"    // private globals' initializers live in this function's expressions\n    // (literals, zero, compose only)\n    pub(crate) consts: Function<'a, A>,\n    pub(crate) a: A,\n}\n\n// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----\n\npub(crate) const T_BOOL: i64 = 0;\npub(crate) const T_I32: i64 = 1;\npub(crate) const T_U32: i64 = 2;\npub(crate) const T_F32: i64 = 3;\n\n// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four\n// concrete scalars\n#[effects()]\npub(crate) fn vec_ty(sk: u8, n: i64) -> i64 {\n    if n == 1 {\n        return sk as i64;\n    }\n    4 + (n - 2) * 4 + sk as i64\n}\n\n// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)\n#[effects()]\npub(crate) fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }\n\npub(crate) const T_FIXED_COUNT: i64 = 25;\n\n#[effects(A)]\npub(crate) fn new_function<'a, A: Allocator + Copy>(name: &'a [u8], a: A) -> Function<'a, A> {\n    Function {\n        name: name,\n        params: Vec::new_in(a),\n        result: -1,\n        result_binding: no_binding(),\n        locals: Vec::new_in(a),\n        exprs: Vec::new_in(a),\n        names: Vec::new_in(a),\n        stmts: Vec::new_in(a),\n        blocks: Vec::new_in(a),\n        items: Vec::new_in(a),\n        args: Vec::new_in(a),\n        cases: Vec::new_in(a),\n        vals: Vec::new_in(a),\n        body: -1,\n        pos: 0,\n    }\n}\n\nfn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }\n\nimpl<'a, A: Allocator + Copy> Module<'a, A> {\n    #[effects(A)]\n    pub(crate) fn new(a: A) -> Module<'a, A> {\n        let mut m = Module {\n            types: Vec::new_in(a),\n            types_map: HashMap::new_in(a),\n            members: Vec::new_in(a),\n            globals: Vec::new_in(a),\n            functions: Vec::new_in(a),\n            entries: Vec::new_in(a),\n            consts: new_function(b\"\", a),\n            a: a,\n        };\n        for sk in 0..4 {\n            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);\n");
    buf_str(out, c"        }\n        for n in 2..5 {\n            for sk in 0..4 {\n                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);\n            }\n        }\n        for c in 2..5 {\n            for r in 2..5 {\n                m.push_type(TK_MATRIX, SK_F32, c, r, -1);\n            }\n        }\n        m\n    }\n\n    fn push_type(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {\n        let mut t = Type {\n            kind: kind,\n            scalar: sk,\n            space: 0,\n            access: 0,\n            n: n,\n            m: mm,\n            base: base,\n            mstart: 0,\n            mcount: 0,\n            name: b\"\",\n            size: 4,\n            align: 4,\n            stride: 0,\n        };\n        if kind == TK_VECTOR {\n            t.size = 4 * n;\n            t.align = if n == 2 { 8 } else { 16 };\n        } else if kind == TK_MATRIX {\n            let col_align: i64 = if mm == 2 { 8 } else { 16 };\n            t.align = col_align;\n            t.stride = round_up(4 * mm, col_align);\n            t.size = n * t.stride;\n        }\n        self.types.push(t);\n        self.types.len() as i64 - 1\n    }\n\n    // The handle of a type made of these parts, made once.\n    #[effects(panic, A)]\n    pub(crate) fn intern(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,\n        access: u8) -> i64 {\n        if kind == TK_SCALAR {\n            return sk as i64;\n        }\n        if kind == TK_VECTOR {\n            return vec_ty(sk, n);\n        }\n        if kind == TK_MATRIX {\n            return mat_ty(n, mm);\n        }\n        let key = TypeKey {\n            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base,\n        };\n        if let Some(h) = self.types_map.get(&key).copied() {\n            return h;\n        }\n        let h = self.push_type(kind, sk, n, mm, base);\n        self.types[h as usize].space = space;\n        self.types[h as usize].access = access;\n");
    buf_str(out, c"        if kind == TK_ARRAY {\n            let el = self.types[base as usize];\n            let stride = round_up(el.size, el.align);\n            self.types[h as usize].align = el.align;\n            self.types[h as usize].stride = stride;\n            self.types[h as usize].size = if n == 0 { stride } else { stride * n };\n        } else if kind == TK_POINTER {\n            self.types[h as usize].size = 8;\n            self.types[h as usize].align = 8;\n        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {\n            self.types[h as usize].size = 8;\n            self.types[h as usize].align = 8;\n        }\n        self.types_map.insert(key, h);\n        h\n    }\n\n    #[effects(A)]\n    pub(crate) fn array_ty(&mut self, elem: i64, n: i64) -> i64 {\n        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)\n    }\n\n    #[effects(A)]\n    pub(crate) fn ptr_ty(&mut self, pointee: i64, space: u8, access: u8) -> i64 {\n        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)\n    }\n\n    #[effects(A)]\n    pub(crate) fn atomic_ty(&mut self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }\n\n    // A struct type: a new handle for each declaration (structs are\n    // nominal); members[mstart ..] must already be pushed, offsets unset.\n    #[effects(panic, A)]\n    pub(crate) fn struct_ty(&mut self, name: &'a [u8], mstart: i64, mcount: i64) -> i64 {\n        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);\n        let mut off: i64 = 0;\n        let mut al: i64 = 4;\n        for i in mstart..mstart + mcount {\n            let t = self.types[self.members[i as usize].ty as usize];\n            off = round_up(off, t.align);\n            self.members[i as usize].offset = off;\n            off += t.size;\n            if t.align > al {\n                al = t.align;\n            }\n        }\n        self.types[h as usize].name = name;\n        self.types[h as usize].mstart = mstart;\n        self.types[h as usize].mcount = mcount;\n");
    buf_str(out, c"        self.types[h as usize].align = al;\n        self.types[h as usize].size = round_up(off, al);\n        h\n    }\n\n    // The scalar kind of a scalar, vector, matrix or atomic type.\n    #[effects(panic, A)]\n    pub(crate) fn scalar_of(&self, t: i64) -> u8 { self.types[t as usize].scalar }\n\n    // The component count of a scalar (1) or vector type, else 0.\n    #[effects(panic, A)]\n    pub(crate) fn width_of(&self, t: i64) -> i64 {\n        let k = self.types[t as usize].kind;\n        if k == TK_SCALAR {\n            1\n        } else if k == TK_VECTOR {\n            self.types[t as usize].n\n        } else {\n            0\n        }\n    }\n\n    // The pointee of a pointer type, else -1.\n    #[effects(panic, A)]\n    pub(crate) fn pointee(&self, t: i64) -> i64 {\n        if self.types[t as usize].kind == TK_POINTER {\n            self.types[t as usize].base\n        } else {\n            -1\n        }\n    }\n\n    // The type of a component of t when indexed: a vector's scalar, a\n    // matrix's column, an array's element; -1 for the others.\n    #[effects(panic, A)]\n    pub(crate) fn elem_of(&self, t: i64) -> i64 {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_VECTOR {\n            ty.scalar as i64\n        } else if ty.kind == TK_MATRIX {\n            vec_ty(SK_F32, ty.m)\n        } else if ty.kind == TK_ARRAY {\n            ty.base\n        } else {\n            -1\n        }\n    }\n\n    // How many components indexing t can reach: 0 for a runtime-sized array.\n    #[effects(panic, A)]\n    pub(crate) fn index_len(&self, t: i64) -> i64 {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {\n            ty.n\n        } else if ty.kind == TK_MATRIX {\n            ty.n\n        } else {\n            -1\n        }\n    }\n\n    // Whether t is or holds a runtime-sized array.\n    #[effects(panic, A)]\n    pub(crate) fn is_runtime_sized(&self, t: i64) -> bool {\n");
    buf_str(out, c"        let ty = self.types[t as usize];\n        if ty.kind == TK_ARRAY {\n            return ty.n == 0;\n        }\n        if ty.kind == TK_STRUCT && ty.mcount > 0 {\n            return self.is_runtime_sized(self.members[(ty.mstart + ty.mcount - 1) as usize].ty);\n        }\n        false\n    }\n\n    // Whether t contains an atomic (such types cannot be loaded whole).\n    #[effects(panic, A)]\n    pub(crate) fn has_atomic(&self, t: i64) -> bool {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.has_atomic(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if self.has_atomic(self.members[i as usize].ty) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The type written as WGSL, for messages and the IR dump.\n    #[effects(alloc(extern), io, static, sync, panic, diverge, A, B)]\n    pub(crate) fn type_name<B: Allocator>(&self, t: i64, b: &mut Vec<u8, B>) {\n        if t < 0 {\n            b.extend_from_slice(b\"void\");\n            return;\n        }\n        let ty = self.types[t as usize];\n        if ty.kind == TK_SCALAR {\n            b.extend_from_slice(scalar_name(ty.scalar));\n        } else if ty.kind == TK_VECTOR {\n            write(b, \"vec{}<{}>\", ty.n, str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n        } else if ty.kind == TK_MATRIX {\n            write(b, \"mat{}x{}<f32>\", ty.n, ty.m).unwrap();\n        } else if ty.kind == TK_ARRAY {\n            b.extend_from_slice(b\"array<\");\n            self.type_name(ty.base, b);\n            if ty.n > 0 {\n                write(b, \", {}\", ty.n).unwrap();\n            }\n            b.push(b'>');\n        } else if ty.kind == TK_STRUCT {\n            b.extend_from_slice(ty.name);\n        } else if ty.kind == TK_ATOMIC {\n");
    buf_str(out, c"            write(b, \"atomic<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n        } else if ty.kind == TK_POINTER {\n            write(b, \"ptr<{}, \", str::from_utf8(space_name(ty.space)).unwrap()).unwrap();\n            self.type_name(ty.base, b);\n            if ty.space == SP_STORAGE {\n                b.extend_from_slice((if ty.access == ACC_RW { b\", read_write\" }\n                    else { b\", read\" }));\n            }\n            b.push(b'>');\n        } else if ty.kind == TK_TEXTURE {\n            if ty.n == TEX_2D {\n                write(b, \"texture_2d<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n            } else if ty.n == TEX_2D_ARRAY {\n                write(b, \"texture_2d_array<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n            } else if ty.n == TEX_DEPTH_2D {\n                b.extend_from_slice(b\"texture_depth_2d\");\n            } else {\n                write(b, \"texture_storage_2d<{}, write>\",\n                    str::from_utf8(format_name(ty.m)).unwrap()).unwrap();\n            }\n        } else if ty.n == 1 {\n            b.extend_from_slice(b\"sampler_comparison\");\n        } else {\n            b.extend_from_slice(b\"sampler\");\n        }\n    }\n}\n\n#[effects()]\npub fn scalar_name(sk: u8) -> &'static [u8] {\n    if sk == SK_BOOL {\n        b\"bool\"\n    } else if sk == SK_I32 {\n        b\"i32\"\n    } else if sk == SK_U32 {\n        b\"u32\"\n    } else if sk == SK_F32 {\n        b\"f32\"\n    } else if sk == SK_AINT {\n        b\"abstract-int\"\n    } else {\n        b\"abstract-float\"\n    }\n}\n\n#[effects()]\npub(crate) fn space_name(sp: u8) -> &'static [u8] {\n    if sp == SP_FUNCTION {\n        b\"function\"\n    } else if sp == SP_PRIVATE {\n        b\"private\"\n    } else if sp == SP_WORKGROUP {\n        b\"workgroup\"\n    } else if sp == SP_UNIFORM {\n        b\"uniform\"\n    } else if sp == SP_STORAGE {\n        b\"storage\"\n");
    buf_str(out, c"    } else {\n        b\"handle\"\n    }\n}\n\n#[effects()]\npub(crate) fn format_name(f: i64) -> &'static [u8] {\n    if f == FMT_RGBA8UNORM {\n        b\"rgba8unorm\"\n    } else if f == FMT_RGBA32FLOAT {\n        b\"rgba32float\"\n    } else if f == FMT_R32FLOAT {\n        b\"r32float\"\n    } else if f == FMT_R32UINT {\n        b\"r32uint\"\n    } else if f == FMT_R32SINT {\n        b\"r32sint\"\n    } else if f == FMT_RGBA16FLOAT {\n        b\"rgba16float\"\n    } else if f == FMT_RGBA8UINT {\n        b\"rgba8uint\"\n    } else if f == FMT_RG32FLOAT {\n        b\"rg32float\"\n    } else {\n        b\"rgba32uint\"\n    }\n}\n\n// ---- Shader compiler implementation, ir: Building functions (0.22) ----\n\nimpl<'a, A: Allocator + Copy> Function<'a, A> {\n    #[effects(A)]\n    pub(crate) fn expr(&mut self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {\n        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });\n        self.names.push(b\"\");\n        self.exprs.len() as i64 - 1\n    }\n\n    #[effects(A)]\n    pub(crate) fn stmt(&mut self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });\n        self.stmts.len() as i64 - 1\n    }\n\n    // A block of the statements pending[from ..], which are removed from\n    // pending.\n    #[effects(panic, A)]\n    pub(crate) fn block_of(&mut self, pending: &mut Vec<i64, A>, from: i64) -> i64 {\n        let start = self.items.len() as i64;\n        for i in from..pending.len() as i64 {\n            self.items.push(pending[i as usize]);\n        }\n        let count = pending.len() as i64 - from;\n        pending.truncate(from as usize);\n        self.blocks.push(Block { start: start, count: count });\n        self.blocks.len() as i64 - 1\n    }\n\n    #[effects(A)]\n    pub(crate) fn empty_block(&mut self) -> i64 {\n        self.blocks.push(Block { start: self.items.len() as i64, count: 0 });\n        self.blocks.len() as i64 - 1\n");
    buf_str(out, c"    }\n\n    #[effects(panic, A)]\n    pub(crate) fn arg(&self, i: i64) -> i64 { self.args[i as usize] }\n\n    #[effects(panic, A)]\n    pub(crate) fn item(&self, blk: i64, i: i64) -> i64 { self.items[\n        (self.blocks[blk as usize].start + i) as usize] }\n}\n\n// The byte offsets of function h's parameters in a record holding them\n// all, each at its alignment (WGSL's layout); the record's size, rounded\n// to 16, is the last element.\n#[effects(panic, A)]\npub fn record_offsets<A: Allocator + Copy>(m: &Module<'_, A>, h: i64, a: A) -> Vec<i64, A> {\n    let mut offs: Vec<i64, A> = Vec::new_in(a);\n    let mut off: i64 = 0;\n    let f = &m.functions[h as usize];\n    for k in 0..f.params.len() as i64 {\n        let t = m.types[f.params[k as usize].ty as usize];\n        off = round_up(off, t.align);\n        offs.push(off);\n        off += t.size;\n    }\n    offs.push(round_up(off, 16));\n    offs\n}\n\n// The bytes a value of type t takes in an array of them (its stride).\n#[effects(panic, A)]\npub fn stride_of<A: Allocator + Copy>(m: &Module<'_, A>, t: i64) -> i64 {\n    let ty = m.types[t as usize];\n    round_up(ty.size, ty.align)\n}\n\n// Statements and expressions that end a block's flow.\n#[effects()]\npub(crate) fn is_terminator(op: u8) -> bool {\n    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL\n}\n\n// The bits of an f32, and back.\n#[effects()]\npub(crate) fn f32_bits(f: f32) -> u32 { f.to_bits() }\n\n#[effects()]\npub(crate) fn bits_f32(u: u32) -> f32 { f32::from_bits(u) }\n\n#[effects()]\npub(crate) fn f64_bits(f: f64) -> u64 { f.to_bits() }\n// ---- end mod std::gpu::wgsl::ir ----\n}\n// ---- mod std::gpu::wgsl::names ----\nmod names {\n// EDITION: rust\n// ---- Shader compiler implementation, names (0.22) ----\n// The predeclared names of WGSL: keywords, types, attributes and builtins.\n// The lexer interns them first, so each has the fixed symbol below. The\n");
    buf_str(out, c"// math functions are in MF_* order (ir.vl): K_ABS + MF_x is MF_x's name.\n\npub(crate) const PREDECLARED: [&[u8]; 237] = [\n    b\"fn\",\n    b\"let\",\n    b\"var\",\n    b\"const\",\n    b\"struct\",\n    b\"return\",\n    b\"if\",\n    b\"else\",\n    b\"for\",\n    b\"while\",\n    b\"loop\",\n    b\"break\",\n    b\"continue\",\n    b\"continuing\",\n    b\"switch\",\n    b\"case\",\n    b\"default\",\n    b\"discard\",\n    b\"true\",\n    b\"false\",\n    b\"alias\",\n    b\"override\",\n    b\"enable\",\n    b\"requires\",\n    b\"diagnostic\",\n    b\"const_assert\",\n    b\"fallthrough\",\n    b\"bool\",\n    b\"i32\",\n    b\"u32\",\n    b\"f32\",\n    b\"f16\",\n    b\"vec2\",\n    b\"vec3\",\n    b\"vec4\",\n    b\"vec2i\",\n    b\"vec3i\",\n    b\"vec4i\",\n    b\"vec2u\",\n    b\"vec3u\",\n    b\"vec4u\",\n    b\"vec2f\",\n    b\"vec3f\",\n    b\"vec4f\",\n    b\"vec2h\",\n    b\"vec3h\",\n    b\"vec4h\",\n    b\"mat2x2\",\n    b\"mat2x3\",\n    b\"mat2x4\",\n    b\"mat3x2\",\n    b\"mat3x3\",\n    b\"mat3x4\",\n    b\"mat4x2\",\n    b\"mat4x3\",\n    b\"mat4x4\",\n    b\"mat2x2f\",\n    b\"mat2x3f\",\n    b\"mat2x4f\",\n    b\"mat3x2f\",\n    b\"mat3x3f\",\n    b\"mat3x4f\",\n    b\"mat4x2f\",\n    b\"mat4x3f\",\n    b\"mat4x4f\",\n    b\"array\",\n    b\"atomic\",\n    b\"ptr\",\n    b\"sampler\",\n    b\"sampler_comparison\",\n    b\"texture_2d\",\n    b\"texture_2d_array\",\n    b\"texture_depth_2d\",\n    b\"texture_storage_2d\",\n    b\"texture_1d\",\n    b\"texture_3d\",\n    b\"texture_cube\",\n    b\"texture_cube_array\",\n    b\"texture_multisampled_2d\",\n    b\"texture_depth_2d_array\",\n    b\"texture_depth_cube\",\n    b\"texture_external\",\n    b\"texture_storage_1d\",\n    b\"texture_storage_3d\",\n    b\"texture_storage_2d_array\",\n    b\"function\",\n    b\"private\",\n    b\"workgroup\",\n    b\"uniform\",\n    b\"storage\",\n    b\"read\",\n    b\"write\",\n    b\"read_write\",\n    b\"rgba8unorm\",\n    b\"rg