    buf_str(out, c"#[effects(io, static, panic, diverge, P)]\npub fn remove_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let m = symlink_metadata(path)?;\n    if m.is_symlink() {\n        return remove_file(path);\n    }\n    if !m.is_dir() {\n        return crate::result::Result::Err(Error::from_raw_os_error(20));\n    }\n    remove_tree(path)\n}\n\n// Removes the directory at path and everything under it.\nfn remove_tree(path: &str) -> Result<()> {\n    let mut dir = read_dir(path)?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        if e.file_type()?.is_dir() {\n            remove_tree(e.path())?;\n        } else {\n            remove_file(e.path())?;\n        }\n    }\n    remove_dir(path)\n}\n\n// ---- Directories ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn read_dir<P: AsRef<str>>(path: P) -> Result<ReadDir> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.\n    let d = unsafe { fs_c_opendir(p.ptr()) };\n    if d.is_null() {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    let mut root = [0u8; crate::__sys::PATH_MAX];\n    let b = path.as_bytes();\n    let mut i: usize = 0;\n    while i < b.len() {\n        root[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir {\n    dir: *mut u8,\n    root: [u8; crate::__sys::PATH_MAX],\n    root_len: usize,\n}\n\nimpl Drop for ReadDir {\n    fn drop(&mut self) {\n        // UNSAFE: C's closedir. SAFETY: dir is the DIR * opendir returned,\n");
    buf_str(out, c"        // non-null (read_dir checks), closed once (here).\n        let _ = unsafe { fs_c_closedir(self.dir) };\n    }\n}\n\nimpl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(&mut self) -> Option<Result<DirEntry>> {\n        loop {\n            let mut e = DirEntry {\n                path: [0u8; crate::__sys::PATH_MAX], len: 0, name_at: 0, kind: 0,\n            };\n            // UNSAFE: errno cleared, then C's readdir on the DIR *, and its\n            // struct dirent read through the pointer readdir returns.\n            // SAFETY: errno_location is this thread's errno; dir is open\n            // (Drop closes it, after the last next); a non-null entry is a\n            // struct dirent of this system (its d_type and d_name at the\n            // offsets std::__sys gives), valid until the next readdir of\n            // dir, and d_name is NUL-ended within it: its bytes are copied\n            // out before this returns.\n            let ok = unsafe {\n                *crate::__sys::errno_location() = 0;\n                let d = fs_c_readdir(self.dir);\n                if d.is_null() {\n                    let err = *crate::__sys::errno_location();\n                    if err == 0 {\n                        return Option::None;\n                    }\n                    return Option::Some(crate::result::Result::Err(Error::from_raw_os_error(err)));\n                }\n                e.kind = *d.add(crate::__sys::DIRENT_TYPE);\n                let name = d.add(crate::__sys::DIRENT_NAME);\n                let mut n: usize = 0;\n                while *name.add(n) != 0 {\n                    n += 1;\n                }\n                let nm = crate::slice::from_raw_parts(name, n);\n                if nm == b\".\" || nm == b\"..\" {\n                    continue;\n                }\n                e.fill(&self.root[..self.root_len], nm)\n            };\n            if !ok {\n");
    buf_str(out, c"                return Option::Some(crate::result::Result::Err(Error::new(\n                    ErrorKind::InvalidData,\n                    \"a directory entry's name is not UTF-8 or the path is too long\")));\n            }\n            return Option::Some(crate::result::Result::Ok(e));\n        }\n    }\n}\n\n// A directory's entry: its path (the directory's, then its name), kept\n// inline, and its kind as the directory says it.\npub struct DirEntry {\n    path: [u8; crate::__sys::PATH_MAX],\n    len: usize,\n    name_at: usize,\n    kind: u8,\n}\n\nimpl DirEntry {\n    // root, a \"/\" unless root ends with one, and name: false when it does\n    // not fit or is not UTF-8.\n    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {\n        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std2: changed: a &str, a view of the entry (Rust's: a PathBuf; MVS:\n    // a PathBuf on an allocator; path_in could make one on an allocator)\n    #[effects(panic, diverge)]\n    pub fn path(&self) -> &str {\n 