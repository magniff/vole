    buf_str(out, c"                let r = unsafe { Ref::<CAMetalLayer>::from_global(p) };\n                r.retain()\n            }\n            // an unattached layer: its drawables are offscreen\n            RawSurface::Headless => crate::objc::pool(|| CAMetalLayer::layer().retain()),\n        };\n        if layer.is_nil() { return None; }\n        layer.r().set_device(Some(d.dev.r()));\n        Some(Surface { layer: layer })\n    }\n\n    fn configure(s: &mut Surface, d: &Device, width: i64, height: i64, format: Format, vsync: bool) {\n        let l = s.layer.r();\n        l.set_device(Some(d.dev.r()));\n        l.set_pixel_format(pixel_format(format));\n        l.set_drawable_size(CGSize { width: width as f64, height: height as f64 });\n        l.set_framebuffer_only(false);\n        l.set_maximum_drawable_count(3);\n        l.set_display_sync_enabled(vsync);\n    }\n\n    fn next_frame(s: &mut Surface) -> Option<(Frame, Texture)> {\n        let l = s.layer.r();\n        let _pool = crate::objc::Pool::push();\n        match l.next_drawable() {\n            Some(dr) => {\n                let tex = dr.texture().retain();\n                Some((Frame { drawable: dr.retain() }, Texture { raw: tex }))\n            }\n            None => None,\n        }\n    }\n\n    fn present(q: &mut Queue, f: &Frame) {\n        let mut cb = begin_on(q.q.r());\n        // UNSAFE: a cast between protocols, which the table does not relate.\n        // SAFETY: CAMetalDrawable is declared `@protocol CAMetalDrawable <MTLDrawable>`, so\n        // every CAMetalDrawable is an MTLDrawable; f.drawable keeps it alive.\n        let d = unsafe { f.drawable.r().cast::<bindings::MTLDrawable>() };\n        cb.cb.r().present_drawable(d);\n        Metal::submit(q, &mut cb);\n    }\n}\n// ---- mod std::gpu::hal::metal::bindings ----\npub mod bindings {\n// EDITION: rust\n// Generated by tools/objcgen from compiler/std2/objc/tables/metal.objc: do not edit.\n");
