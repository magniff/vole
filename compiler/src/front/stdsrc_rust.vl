    buf_str(out, c"                            return Result::Err(StripPrefixError {});\n                        }\n                    }\n                    Option::None => return Result::Err(StripPrefixError {}),\n                },\n            }\n        }\n    }\n\n    // The path with p after it, on allocator a (p absolute: p).\n    // std2: changed: an allocator (Rust: join)\n    #[effects(P, A)]\n    pub fn join_in<P: AsRef<str>, A: Allocator>(&self, p: P, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.push(p);\n        out\n    }\n\n    // An owned copy, on allocator a.\n    // std2: changed: an allocator (Rust: to_path_buf)\n    #[effects(A)]\n    pub fn to_path_buf_in<A: Allocator>(&self, a: A) -> PathBuf<A> {\n        PathBuf::from_in(self.s, a)\n    }\n\n    // The path with its file name replaced by name, on allocator a.\n    // std2: changed: an allocator (Rust: with_file_name)\n    #[effects(S, A)]\n    pub fn with_file_name_in<S: AsRef<str>, A: Allocator>(&self, name: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_file_name(name);\n        out\n    }\n\n    // The path with its extension replaced by ext, on allocator a.\n    // std2: changed: an allocator (Rust: with_extension)\n    #[effects(S, A)]\n    pub fn with_extension_in<S: AsRef<str>, A: Allocator>(&self, ext: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_extension(ext);\n        out\n    }\n\n    // What stat says of the file at the path.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::metadata(self.s)\n    }\n\n    // What lstat says of it.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn symlink_metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::symlink_metadata(self.s)\n    }\n\n");
