    buf_str(out, c"pub(crate) const K_WORKGROUP: i64 = 87;\npub(crate) const K_UNIFORM: i64 = 88;\npub(crate) const K_STORAGE: i64 = 89;\npub(crate) const K_READ: i64 = 90;\npub(crate) const K_WRITE: i64 = 91;\npub(crate) const K_READ_WRITE: i64 = 92;\n// formats\npub(crate) const K_RGBA8UNORM: i64 = 93;\npub(crate) const K_RGBA32FLOAT: i64 = 94;\npub(crate) const K_R32FLOAT: i64 = 95;\npub(crate) const K_R32UINT: i64 = 96;\npub(crate) const K_R32SINT: i64 = 97;\npub(crate) const K_RGBA32UINT: i64 = 98;\n// attributes\npub(crate) const K_VERTEX: i64 = 99;\npub(crate) const K_FRAGMENT: i64 = 100;\npub(crate) const K_COMPUTE: i64 = 101;\npub(crate) const K_WORKGROUP_SIZE: i64 = 102;\npub(crate) const K_BUILTIN: i64 = 103;\npub(crate) const K_LOCATION: i64 = 104;\npub(crate) const K_GROUP: i64 = 105;\npub(crate) const K_BINDING: i64 = 106;\npub(crate) const K_INTERPOLATE: i64 = 107;\npub(crate) const K_FLAT: i64 = 108;\npub(crate) const K_LINEAR: i64 = 109;\npub(crate) const K_PERSPECTIVE: i64 = 110;\npub(crate) const K_CENTER: i64 = 111;\npub(crate) const K_CENTROID: i64 = 112;\npub(crate) const K_SAMPLE: i64 = 113;\npub(crate) const K_ALIGN: i64 = 114;\npub(crate) const K_SIZE: i64 = 115;\npub(crate) const K_ID: i64 = 116;\npub(crate) const K_INVARIANT: i64 = 117;\npub(crate) const K_MUST_USE: i64 = 118;\n// builtin values\npub(crate) const K_POSITION: i64 = 119;\npub(crate) const K_VERTEX_INDEX: i64 = 120;\npub(crate) const K_INSTANCE_INDEX: i64 = 121;\npub(crate) const K_FRONT_FACING: i64 = 122;\npub(crate) const K_FRAG_DEPTH: i64 = 123;\npub(crate) const K_SAMPLE_INDEX: i64 = 124;\npub(crate) const K_SAMPLE_MASK: i64 = 125;\npub(crate) const K_LOCAL_INVOCATION_ID: i64 = 126;\npub(crate) const K_LOCAL_INVOCATION_INDEX: i64 = 127;\npub(crate) const K_GLOBAL_INVOCATION_ID: i64 = 128;\npub(crate) const K_WORKGROUP_ID: i64 = 129;\npub(crate) const K_NUM_WORKGROUPS: i64 = 130;\n// math\npub(crate) const K_ABS: i64 = 131;\npub(crate) const K_MIN: i64 = 132;\n");
