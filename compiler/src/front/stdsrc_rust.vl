n");
    buf_str(out, c"    Range { loc: NOT_FOUND, len: 0 }\n}\n\nfn utf16_len(s: &[u8]) -> u64 {\n    let mut n: u64 = 0;\n    for &b in s {\n        if (b & 0xC0) != 0x80 {\n            n += if b >= 0xF0 { 2 } else { 1 };\n        }\n    }\n    n\n}\n\n// The text of an NSString or NSAttributedString argument.\n// UNSAFE: Objective-C messages on a raw object pointer, and the bytes of an\n// NSString whose lifetime the runtime decides.\n// SAFETY: the caller passes the NSString or NSAttributedString an input\n// method gives; the bytes (nsstring_bytes) stay valid until the autorelease\n// pool around the event pops, and every caller copies them before then.\nunsafe fn arg_text(s: *mut u8) -> &'static [u8] {\n    if msg_b_p(s, sel(c\"isKindOfClass:\"), class(c\"NSAttributedString\")) {\n        return nsstring_bytes(msg_p(s, sel(c\"string\")));\n    }\n    nsstring_bytes(s)\n}\n\nextern \"C\" fn imp_set_marked(this: *mut u8, cmd: *mut u8, text: *mut u8, selected: Range,\n    replaced: Range) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw text argument, and the State\n    // through st().\n    // SAFETY: see st_live; `text` is the NSString or NSAttributedString\n    // the input method passes.\n    unsafe {\n        let s = arg_text(text);\n        st().preedit.clear();\n        st().preedit.extend_from_slice(s);\n        st().marked = s.len() as i64 > 0;\n        let cursor = if selected.loc == NOT_FOUND { s.len() as i64 }\n            else { utf16_to_byte(s, selected.loc as i64) };\n        push(Event::Preedit(Preedit { win: view_id(this), len: s.len() as i64, cursor: cursor }));\n    }\n}\n\nextern \"C\" fn imp_unmark(this: *mut u8, cmd: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the State through ST, and Objective-C messages on the raw view\n    // and its input context.\n    // SAFETY: see st_live; discardMarkedText on the view's input context.\n    unsafe {\n        if st().marked {\n");
