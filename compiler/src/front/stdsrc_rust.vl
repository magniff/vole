     return None;\n");
    buf_str(out, c"        }\n        if !self.trailing {\n            // split_terminator: an empty last piece is not one\n            self.trailing = true;\n            match self.next_back() {\n                Some(piece) if !piece.is_empty() => return Some(piece),\n                _ => {\n                    if self.done {\n                        return None;\n                    }\n                }\n            }\n        }\n        let m = match self.back {\n            Some(at) => self.pat.next_match_back(self.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if a >= self.start => {\n                let piece = &self.hay[b..self.end];\n                self.end = a;\n                self.back = before_match(self.hay, a, b);\n                Some(piece)\n            }\n            _ => {\n                self.done = true;\n                Some(&self.hay[self.start..self.end])\n            }\n        }\n    }\n}\n\n// str::rsplit's iterator.\npub struct RSplit<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplit<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next_back()\n    }\n}\n\n// str::splitn's iterator.\npub struct SplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next()\n            }\n        }\n    }\n}\n\n// str::rsplitn's iterator.\npub struct RSplitN<'a, P> {\n    inner: Split<'a, P>,\n    count: usize,\n}\n\nimpl<'a, P: Pattern> Iterator for RSplitN<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        match self.count {\n");
    buf_str(out, c"            0 => None,\n            1 => {\n                self.count = 0;\n                self.inner.get_end()\n            }\n            _ => {\n                self.count -= 1;\n                self.inner.next_back()\n            }\n        }\n    }\n}\n\n// str::split_terminator's iterator.\npub struct SplitTerminator<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitTerminator<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        self.inner.next()\n    }\n}\n\n// str::split_inclusive's iterator.\npub struct SplitInclusive<'a, P> {\n    inner: Split<'a, P>,\n}\n\nimpl<'a, P: Pattern> Iterator for SplitInclusive<'a, P> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        if self.inner.done {\n            return None;\n        }\n        let m = match self.inner.front {\n            Some(at) => self.inner.pat.next_match(self.inner.hay, at),\n            None => None,\n        };\n        match m {\n            Some((a, b)) if b <= self.inner.end => {\n                let piece = &self.inner.hay[self.inner.start..b];\n                self.inner.start = b;\n                self.inner.front = after_match(self.inner.hay, a, b);\n                Some(piece)\n            }\n            _ => self.inner.get_end(),\n        }\n    }\n}\n\n// str::split_whitespace's iterator.\n#[derive(Clone)]\npub struct SplitWhitespace<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Iterator for SplitWhitespace<'a> {\n    type Item = &'a str;\n\n    fn next(&mut self) -> Option<&'a str> {\n        let s = self.rest.trim_start();\n        if s.is_empty() {\n            self.rest = s;\n            return None;\n        }\n        let mut it = s.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    if c.is_whitespace() {\n                        self.rest = &s[i..];\n                        return Some(&s[..i]);\n                    }\n");
