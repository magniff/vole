    buf_str(out, c"                    continue;\n                }\n                e.fill(&self.root[..self.root_len], nm)\n            };\n            if !ok {\n                return Option::Some(crate::result::Result::Err(Error::new(\n                    ErrorKind::InvalidData,\n                    \"a directory entry's name is not UTF-8 or the path is too long\")));\n            }\n            return Option::Some(crate::result::Result::Ok(e));\n        }\n    }\n}\n\n// A directory's entry: its path (the directory's, then its name), kept\n// inline, and its kind as the directory says it.\npub struct DirEntry {\n    path: [u8; crate::__sys::PATH_MAX],\n    len: usize,\n    name_at: usize,\n    kind: u8,\n}\n\nimpl DirEntry {\n    // root, a \"/\" unless root ends with one, and name: false when it does\n    // not fit or is not UTF-8.\n    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {\n        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std2: changed: a &str, a view of the entry (Rust's: a PathBuf; MVS