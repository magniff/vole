    buf_str(out, c"// Empty file actions; sys_spawn_actions_free frees them.\n#[effects(io, unsafe)]\npub fn sys_spawn_actions() -> Result<SysSpawnActions, i32> {\n    let mut a = SysSpawnActions { words: [0u64; 16], live: false };\n    // UNSAFE: C initializes the file actions through a raw pointer.\n    // SAFETY: a.words is 128 bytes, more than either system's\n    // posix_spawn_file_actions_t (8 on macOS, 80 on Linux), 8-aligned; the\n    // actions hold no pointer into themselves, so moving them is fine.\n    let r = unsafe { sys_c_actions_init(a.words.as_mut_ptr() as *mut u8) };\n    if r != 0 {\n        return Err(r);\n    }\n    a.live = true;\n    Ok(a)\n}\n\nimpl SysSpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    #[effects(io, unsafe)]\n    pub fn dup2(&mut self, fd: i32, to: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: C adds to the file actions through a raw pointer.\n        // SAFETY: live: initialized by sys_spawn_actions and not destroyed\n        // (a SysSpawnActions is never copied, see its Drop).\n        let r = unsafe { sys_c_actions_adddup2(self.words.as_mut_ptr() as *mut u8, fd, to) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    // In the child: fd is closed.\n    #[effects(io, unsafe)]\n    pub fn close(&mut self, fd: i32) -> Result<(), i32> {\n        if !self.live {\n            return Err(SYS_EINVAL);\n        }\n        // UNSAFE: as dup2.\n        // SAFETY: as dup2.\n        let r = unsafe { sys_c_actions_addclose(self.words.as_mut_ptr() as *mut u8, fd) };\n        if r != 0 { Err(r) } else { Ok(()) }\n    }\n\n    #[effects(io, unsafe)]\n    pub fn free(&mut self) {\n        if self.live {\n            // UNSAFE: C destroys the file actions through a raw pointer.\n            // SAFETY: live (checked): destroyed once, live cleared right\n            // after.\n            unsafe { sys_c_actions_destroy(self.words.as_mut_ptr(