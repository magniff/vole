    buf_str(out, c"        crate::result::Result::Ok(())\n    }\n}\n\n// mvs: File::seek\nimpl Seek for File {\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64> {\n        let (off, whence) = match pos {\n            SeekFrom::Start(o) => {\n                if o > i64::MAX as u64 {\n                    return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n                }\n                (o as i64, 0)\n            }\n            SeekFrom::Current(o) => (o, 1),\n            SeekFrom::End(o) => (o, 2),\n        };\n        // UNSAFE: C's lseek. SAFETY: integers only.\n        let r = unsafe { fs_c_lseek(self.fd, off, whence) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(r as u64)\n    }\n}\n\n// How File::open opens a file, Rust's builder:\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n#[derive(Clone, Debug)]\npub struct OpenOptions {\n    read: bool,\n    write: bool,\n    append: bool,\n    truncate: bool,\n    create: bool,\n    create_new: bool,\n    mode: u32,\n}\n\nimpl OpenOptions {\n    // Every option off (open fails until read, write or append is on).\n    #[effects()]\n    pub fn new() -> OpenOptions {\n        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn read(&mut self, read: bool) -> &mut OpenOptions {\n        self.read = read;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn write(&mut self, write: bool) -> &mut OpenOptions {\n        self.write = write;\n        self\n    }\n\n    // Writes go to the end (write is implied).\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn append(&mut self, append: bool) -> &mut OpenOptions {\n");
