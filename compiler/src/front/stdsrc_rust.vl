    buf_str(out, c"    !\\x22$!\\xc2$!4$!!!!\\xc6$!\\x63$!!!!\\xc6$!)$!\\x63$!\\xca\\\n    $!\\x63$!!!!)@!\\xba$!!!!*@!\\xba$!!!!+@!\\xba$!\\\n    !!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\xba$!!!!/@\\\n    !\\xba$!!!!0@!\\xba$!!!!)@!\\xba$!!!!*@!\\xba$!!\\\n    !!+@!\\xba$!!!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\\n    \\xba$!!!!/@!\\xba$!!!!0@!\\xba$!!!!\\x49@!\\xba$!!!\\\n    !\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$!!!!\\x4d@!\\xba\\\n    $!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50@!\\xba$!!!!\\\n    \\x49@!\\xba$!!!!\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$\\\n    !!!!\\x4d@!\\xba$!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50\\\n    @!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!!!\\x8b@!\\xba$!\\\n    !!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\xba$!!!!\\x8f@\\\n    !\\xba$!!!!\\x90@!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!\\\n    !!\\x8b@!\\xba$!!!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\\n    \\xba$!!!!\\x8f@!\\xba$!!!!\\x90@!\\xba$!!!!\\xb2$!\\xba$!!!\\\n    !\\xb2$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xca$!\\xba\\\n    $!!!!\\xca$!\\xba$!!!!\\xdb@!\\xba$!!!!\\xa7$!\\xba$!!!!\\\n    \\xeb@!\\xba$!!!!\\xaa$!\\xba$!!!!\\x1b@!\\xba$!!!!\\xb0$!\\xba$\\\n    !!!!\\xb2$!\\x63$!\\xba$!\\xb8$!\\x63$!\\xba$!\\xca$!\\x63$!\\xba$!\";\nconst LOWER_COUNT: usize = 1508;\nconst UPPER_COUNT: usize = 1601;\n\n// ---- Properties (0.20; std2 0.28.0) ----\n//\n// What a terminal or an editor asks of a code point, vole's own (Rust's\n// std has none of it; the crates unicode-segmentation and unicode-width\n// do): `props(cp)` is a u16 of the grapheme class (GCB_*, the low four\n// bits), the width in columns, the Indic conjunct class and the emoji\n// flags, from one trie. Text comes as bytes, `&[u8]`: UTF-8 that may be\n// broken, each broken part read as U+FFFD (`s.as_bytes()` of a str).\n\n// Its bits:\n//\n//   0-3    the grapheme class: Grapheme_Cluster_Break, with\n//          Extended_Pictographic (whose code points are all Other) as a\n");
    buf_str(out, c"//          class of its own: GCB_OTHER .. GCB_EXT_PICT\n//   4-6    the width class: PROP_WIDTH_ZERO .. PROP_WIDTH_CONTROL\n//   7-8    Indic_Conjunct_Break: PROP_INCB_LINKER, _CONSONANT, _EXTEND\n//   9      Emoji_Presentation\n//   10     Emoji\n//   11     Emoji_Modifier\n//   12     White_Space\n\npub const GCB_MASK: u16 = 0xf;\npub const GCB_OTHER: u16 = 0;\npub const GCB_CR: u16 = 1;\npub const GCB_LF: u16 = 2;\npub const GCB_CONTROL: u16 = 3;\npub const GCB_EXTEND: u16 = 4;\npub const GCB_ZWJ: u16 = 5;\npub const GCB_REGIONAL_INDICATOR: u16 = 6;\npub const GCB_PREPEND: u16 = 7;\npub const GCB_SPACING_MARK: u16 = 8;\npub const GCB_L: u16 = 9;\npub const GCB_V: u16 = 10;\npub const GCB_T: u16 = 11;\npub const GCB_LV: u16 = 12;\npub const GCB_LVT: u16 = 13;\npub const GCB_EXT_PICT: u16 = 14;\n\n// The width class, (p & PROP_WIDTH_MASK) >> PROP_WIDTH_SHIFT: columns 0\n// to 3, ambiguous (1, or 2 in a CJK context), or a control (no width).\npub const PROP_WIDTH_SHIFT: u16 = 4;\npub const PROP_WIDTH_MASK: u16 = 0x70;\npub const PROP_WIDTH_ZERO: u16 = 0;\npub const PROP_WIDTH_AMBIGUOUS: u16 = 4;\npub const PROP_WIDTH_CONTROL: u16 = 5;\n\npub const PROP_INCB_MASK: u16 = 0x180;\npub const PROP_INCB_LINKER: u16 = 0x80;\npub const PROP_INCB_CONSONANT: u16 = 0x100;\npub const PROP_INCB_EXTEND: u16 = 0x180;\npub const PROP_EMOJI_PRESENTATION: u16 = 0x200;\npub const PROP_EMOJI: u16 = 0x400;\npub const PROP_EMOJI_MODIFIER: u16 = 0x800;\npub const PROP_WHITE_SPACE: u16 = 0x1000;\n\n// The properties of code point cp (one above 0x10FFFF has U+10FFFF's:\n// an unassigned code point's).\n#[inline]\n#[effects(panic)]\npub fn props(cp: u32) -> u16 {\n    let c: usize = if cp > 0x10ffff { 0x10ffff } else { cp as usize };\n    let i1 = c >> PROPS_SHIFT1;\n    let mid = if PROPS_WIDE1 {\n        table_byte(PROPS_S1, 2 * i1) | (table_byte(PROPS_S1, 2 * i1 + 1) << 8)\n    } else {\n        table_byte(PROPS_S1, i1)\n    };\n");
    buf_str(out, c"    let i2 = (mid << (PROPS_SHIFT1 - PROPS_SHIFT2)) | ((c >> PROPS_SHIFT2) & PROPS_MASK2);\n    let leaf = if PROPS_WIDE2 {\n        table_byte(PROPS_S2, 2 * i2) | (table_byte(PROPS_S2, 2 * i2 + 1) << 8)\n    } else {\n        table_byte(PROPS_S2, i2)\n    };\n    PROPS_VALUES[table_byte(PROPS_LEAVES, (leaf << PROPS_SHIFT2) | (c & PROPS_MASK3))]\n}\n\n// The grapheme class of code point cp (GCB_OTHER .. GCB_EXT_PICT).\n#[inline]\n#[effects(panic)]\npub fn grapheme_class(cp: u32) -> u16 {\n    props(cp) & GCB_MASK\n}\n\n// ---- Bytes to code points ----\n\nfn utf8_is_cont(b: u8) -> bool {\n    (b & 0xc0) == 0x80\n}\n\n// Whether s can follow the lead byte `first` (no overlong form, no\n// surrogate, nothing above U+10FFFF).\nfn utf8_second_ok(first: u8, s: u8) -> bool {\n    if first == 0xe0 {\n        s >= 0xa0 && s <= 0xbf\n    } else if first == 0xed {\n        s >= 0x80 && s <= 0x9f\n    } else if first == 0xf0 {\n        s >= 0x90 && s <= 0xbf\n    } else if first == 0xf4 {\n        s >= 0x80 && s <= 0x8f\n    } else {\n        utf8_is_cont(s)\n    }\n}\n\n// The bytes of the broken sequence at v[i] that one U+FFFD stands for\n// (the maximal subpart, as Rust's from_utf8_lossy).\nfn utf8_broken_len(v: &[u8], i: usize) -> usize {\n    let first = v[i];\n    let w = if first >= 0xc2 && first < 0xe0 {\n        2\n    } else if first >= 0xe0 && first < 0xf0 {\n        3\n    } else if first >= 0xf0 && first < 0xf5 {\n        4\n    } else {\n        1\n    };\n    if w < 2 || i + 1 >= v.len() || !utf8_second_ok(first, v[i + 1]) {\n        return 1;\n    }\n    let mut k = 2;\n    while k < w {\n        if i + k >= v.len() || !utf8_is_cont(v[i + k]) {\n            return k;\n        }\n        k += 1;\n    }\n    w\n}\n\n// The code point at v[*pos] (pos is less than v's length), and pos moved\n// past it; a broken sequence reads as U+FFFD and is skipped whole.\n#[inline]\n#[effects(panic)]\npub fn lossy_next(v: &[u8], pos: &mut usize) -> u32 {\n    let i = *pos;\n");
    buf_str(out, c"    let first = v[i];\n    if first < 0x80 {\n        *pos = i + 1;\n        return first as u32;\n    }\n    let len = v.len();\n    if first < 0xe0 {\n        if first >= 0xc2 && i + 1 < len {\n            let b1 = v[i + 1];\n            if (b1 & 0xc0) == 0x80 {\n                *pos = i + 2;\n                return (((first & 0x1f) as u32) << 6) | (b1 & 0x3f) as u32;\n            }\n        }\n    } else if first < 0xf0 {\n        if i + 2 < len {\n            let b1 = v[i + 1];\n            let b2 = v[i + 2];\n            if utf8_second_ok(first, b1) && (b2 & 0xc0) == 0x80 {\n                *pos = i + 3;\n                return (((first & 0x0f) as u32) << 12) | (((b1 & 0x3f) as u32) << 6)\n                    | (b2 & 0x3f) as u32;\n            }\n        }\n    } else if first < 0xf5 && i + 3 < len {\n        let b1 = v[i + 1];\n        let b2 = v[i + 2];\n        let b3 = v[i + 3];\n        if utf8_second_ok(first, b1) && (b2 & 0xc0) == 0x80 && (b3 & 0xc0) == 0x80 {\n            *pos = i + 4;\n            return (((first & 0x07) as u32) << 18) | (((b1 & 0x3f) as u32) << 12)\n                | (((b2 & 0x3f) as u32) << 6) | (b3 & 0x3f) as u32;\n        }\n    }\n    *pos = i + utf8_broken_len(v, i);\n    0xfffd\n}\n\n// The length of v's longest prefix of printable ASCII, 0x20 to 0x7E: the\n// bytes a terminal puts on the screen one cell each without a lookup.\n#[effects(panic)]\npub fn ascii_printable_prefix_len(v: &[u8]) -> usize {\n    let mut i = 0;\n    while i < v.len() {\n        let b = v[i];\n        if b < 0x20 || b > 0x7e {\n            return i;\n        }\n        i += 1;\n    }\n    i\n}\n\n// ---- Grapheme clusters (0.20) ----\n//\n// Extended grapheme clusters, UAX #29's rules GB1 to GB999 at the tables'\n// Unicode version (18.0: GB9c is `InCB=Linker InCB=Extend* x\n// InCB=Consonant`), as unicode-segmentation's `graphemes(true)`.\n// GraphemeState takes code points one at a time and says where a cluster\n");
    buf_str(out, c"// starts, which is what a terminal does; Graphemes and next_grapheme_end\n// segment UTF-8 text.\n\n// GB3 to GB9b as a table: bit b of row a is set when no boundary falls\n// between grapheme classes a and b (GCB_*); the rest is GB999's boundary,\n// unless GB9c, GB11 or GB12/13 (the state's) say otherwise.\nconst GRAPHEME_JOIN: [u16; 16] = [\n    0x0130, // Other: × Extend, ZWJ, SpacingMark (GB9, GB9a)\n    0x0004, // CR: × LF (GB3), else ÷ (GB4)\n    0x0000, // LF (GB4)\n    0x0000, // Control (GB4)\n    0x0130, // Extend\n    0x0130, // ZWJ (and GB11, by the state)\n    0x0130, // Regional_Indicator (and GB12/13, by the state)\n    0xfff1, // Prepend: × all but CR, LF, Control (GB9b, GB5)\n    0x0130, // SpacingMark\n    0x3730, // L: × L, V, LV, LVT (GB6)\n    0x0d30, // V: × V, T (GB7)\n    0x0930, // T: × T (GB8)\n    0x0d30, // LV: × V, T (GB7)\n    0x0930, // LVT: × T (GB8)\n    0x0130, // Extended_Pictographic\n    0x0130,\n];\n\n// The boundary rules' memory between code points: the class before, and\n// what GB9c, GB11 and GB12/13 look back for.\npub struct GraphemeState {\n    // the class of the code point before (16: none yet)\n    prev: u16,\n    // an odd number of Regional_Indicators ends here (GB12/13)\n    ri_odd: bool,\n    // 1: ExtPict Extend* ends here; 2: that and a ZWJ (GB11)\n    emoji: u8,\n    // Consonant .. Linker Extend* ends here (GB9c)\n    linker: bool,\n}\n\nimpl GraphemeState {\n    #[inline]\n    #[effects()]\n    pub fn new() -> GraphemeState {\n        GraphemeState { prev: 16, ri_odd: false, emoji: 0, linker: false }\n    }\n\n    // Takes the next code point; true when a cluster starts at it.\n    #[inline]\n    #[effects(panic)]\n    pub fn push(&mut self, cp: u32) -> bool {\n        self.push_props(props(cp))\n    }\n\n    // push, of a code point whose props the caller has.\n    #[inline]\n    #[effects(panic)]\n    pub fn push_props(&mut self, p: u16) -> bool {\n        let b = p & GCB_MASK;\n");
    buf_str(out, c"        let a = self.prev;\n        let mut brk = a >= 16 || ((GRAPHEME_JOIN[(a & 15) as usize] >> b) & 1) == 0;\n        if brk && a < 16 {\n            if b == GCB_REGIONAL_INDICATOR {\n                brk = !(a == GCB_REGIONAL_INDICATOR && self.ri_odd);\n            } else if b == GCB_EXT_PICT {\n                brk = !(a == GCB_ZWJ && self.emoji == 2);\n            } else if (p & PROP_INCB_MASK) == PROP_INCB_CONSONANT && self.linker {\n                brk = false;\n            }\n        }\n        self.ri_odd = b == GCB_REGIONAL_INDICATOR && !(a == GCB_REGIONAL_INDICATOR && self.ri_odd);\n        self.emoji = if b == GCB_EXT_PICT {\n            1\n        } else if self.emoji == 1 && b == GCB_EXTEND {\n            1\n        } else if self.emoji == 1 && b == GCB_ZWJ {\n            2\n        } else {\n            0\n        };\n        let incb = p & PROP_INCB_MASK;\n        self.linker = incb == PROP_INCB_LINKER || (self.linker && incb == PROP_INCB_EXTEND);\n        self.prev = b;\n        brk\n    }\n}\n\n// The end of the cluster that starts at s[start]: the next boundary, or\n// s's length.\n#[effects(panic, diverge)]\npub fn next_grapheme_end(s: &[u8], start: usize) -> usize {\n    let len = s.len();\n    if start >= len {\n        return len;\n    }\n    let b0 = s[start];\n    if b0 < 0x80 {\n        // two ASCII bytes break between them, but CR LF\n        if start + 1 >= len {\n            return len;\n        }\n        let b1 = s[start + 1];\n        if b1 < 0x80 && !(b0 == b'\\r' && b1 == b'\\n') {\n            return start + 1;\n        }\n    }\n    let mut st = GraphemeState::new();\n    let mut i = start;\n    st.push_props(props(lossy_next(s, &mut i)));\n    while i < len {\n        let at = i;\n        if st.push_props(props(lossy_next(s, &mut i))) {\n            return at;\n        }\n    }\n    len\n}\n\n// The number of grapheme clusters of s.\n#[effects(panic, diverge)]\npub fn count_graphemes(s: &[u8]) -> usize {\n    let mut n = 0;\n");
    buf_str(out, c"    let mut i = 0;\n    while i < s.len() {\n        i = next_grapheme_end(s, i);\n        n += 1;\n    }\n    n\n}\n\n// The grapheme clusters of s, each a part of it.\npub struct Graphemes<'a> {\n    s: &'a [u8],\n    pos: usize,\n}\n\n#[inline]\n#[effects()]\npub fn graphemes(s: &[u8]) -> Graphemes<'_> {\n    Graphemes { s: s, pos: 0 }\n}\n\nimpl<'a> Iterator for Graphemes<'a> {\n    type Item = &'a [u8];\n\n    #[inline]\n    fn next(&mut self) -> Option<&'a [u8]> {\n        let i = self.pos;\n        let s: &'a [u8] = self.s;\n        if i >= s.len() {\n            return None;\n        }\n        let e = next_grapheme_end(s, i);\n        self.pos = e;\n        Some(&s[i..e])\n    }\n}\n\nimpl<'a> Graphemes<'a> {\n    // The byte offset of the next cluster.\n    #[effects()]\n    pub fn offset(&self) -> usize {\n        self.pos\n    }\n}\n\n// ---- Display width (0.20) ----\n//\n// The columns a terminal gives text, as the crate unicode-width counts\n// them: a code point's (0, 1 or 2; -1 for a control), and a grapheme\n// cluster's, where an emoji sequence is 2 and VS15 and VS16 choose.\n// `cjk`: East Asian Ambiguous code points are 2 wide, not 1.\n\n// The width that props p say: 0, 1 or 2, or -1 for a control.\n#[inline]\n#[effects()]\npub fn props_width(p: u16, cjk: bool) -> i64 {\n    let w = ((p & PROP_WIDTH_MASK) >> PROP_WIDTH_SHIFT) as i64;\n    if w < 4 {\n        w\n    } else if w == 4 {\n        if cjk { 2 } else { 1 }\n    } else {\n        -1\n    }\n}\n\n// The width of code point cp, or -1 for a control.\n#[inline]\n#[effects(panic)]\npub fn char_width(cp: u32) -> i64 {\n    if cp < 0x7f {\n        return if cp >= 0x20 { 1 } else { -1 };\n    }\n    props_width(props(cp), false)\n}\n\n#[inline]\n#[effects(panic)]\npub fn char_width_cjk(cp: u32) -> i64 {\n    if cp < 0x7f {\n        return if cp >= 0x20 { 1 } else { -1 };\n    }\n    props_width(props(cp), true)\n}\n\n// The width of one grapheme cluster, fed its code points: `start` with\n");
    buf_str(out, c"// the first, `push` with each of the rest.\npub struct ClusterWidth {\n    width: usize,\n    // the first code point is an emoji, an enclosed ideograph, a\n    // Regional_Indicator\n    emoji: bool,\n    enclosed: bool,\n    ri: bool,\n    cjk: bool,\n}\n\nimpl ClusterWidth {\n    // A cluster that starts with code point cp, whose props are p.\n    #[inline]\n    #[effects()]\n    pub fn start(cp: u32, p: u16, cjk: bool) -> ClusterWidth {\n        let w = props_width(p, cjk);\n        let ri = (p & GCB_MASK) == GCB_REGIONAL_INDICATOR;\n        let presentation = (p & PROP_EMOJI_PRESENTATION) != 0 && !ri;\n        ClusterWidth {\n            width: if presentation { 2 } else if w < 0 { 0 } else { w as usize },\n            emoji: (p & PROP_EMOJI) != 0,\n            enclosed: cp >= 0x1f200 && cp <= 0x1f2ff,\n            ri: ri,\n            cjk: cjk,\n        }\n    }\n\n    // The cluster's next code point cp, whose props are p.\n    #[inline]\n    #[effects()]\n    pub fn push(&mut self, cp: u32, p: u16) {\n        if cp == 0xfe0f {\n            if self.emoji {\n                self.width = 2;\n            }\n        } else if cp == 0xfe0e {\n            if self.emoji && !self.enclosed {\n                self.width = 1;\n            }\n        } else if (p & PROP_EMOJI_MODIFIER) != 0 && self.emoji {\n            self.width = 2;\n        } else if self.ri && (p & GCB_MASK) == GCB_REGIONAL_INDICATOR {\n            self.width = 2;\n        } else if self.width == 0 {\n            let w = props_width(p, self.cjk);\n            if w > 0 {\n                self.width = w as usize;\n            }\n        }\n        self.ri = false;\n    }\n\n    #[inline]\n    #[effects()]\n    pub fn width(&self) -> usize {\n        self.width\n    }\n}\n\n// The width of s, one grapheme cluster.\n#[effects(panic, diverge)]\npub fn cluster_width(s: &[u8], cjk: bool = false) -> usize {\n    if s.len() == 0 {\n        return 0;\n    }\n    let mut i = 0;\n");
    buf_str(out, c"    let cp = lossy_next(s, &mut i);\n    let mut w = ClusterWidth::start(cp, props(cp), cjk);\n    while i < s.len() {\n        let c = lossy_next(s, &mut i);\n        w.push(c, props(c));\n    }\n    w.width()\n}\n\n// The width of s: the sum of its grapheme clusters' widths.\n#[effects(panic, diverge)]\npub fn str_width(s: &[u8], cjk: bool = false) -> usize {\n    let len = s.len();\n    let mut total = 0;\n    let mut i = 0;\n    while i < len {\n        let b = s[i];\n        if b >= 0x20 && b < 0x7f {\n            // a run of printable ASCII: all but its last byte are a cell\n            // each (the last may start a cluster with what follows)\n            let run = ascii_printable_prefix_len(&s[i..len]);\n            if run > 1 {\n                total += run - 1;\n                i += run - 1;\n            }\n        }\n        let e = next_grapheme_end(s, i);\n        total += cluster_width(&s[i..e], cjk);\n        i = e;\n    }\n    total\n}\n\n// The width of s code point by code point (no clusters: the sum of the\n// widths that are not negative), as unicode-width's per-char sum.\n#[effects(panic, diverge)]\npub fn str_width_chars(s: &[u8], cjk: bool = false) -> usize {\n    let len = s.len();\n    let mut total = 0;\n    let mut i = 0;\n    while i < len {\n        let b = s[i];\n        if b >= 0x20 && b < 0x7f {\n            let run = ascii_printable_prefix_len(&s[i..len]);\n            total += run;\n            i += run;\n            continue;\n        }\n        let w = props_width(props(lossy_next(s, &mut i)), cjk);\n        if w > 0 {\n            total += w as usize;\n        }\n    }\n    total\n}\n\n// The version of Unicode these tables are of (Rust's char::UNICODE_VERSION).\npub const UNICODE_VERSION: (u8, u8, u8) = (18, 0, 0);\n\n// ---- The props tables (generated, as the tables above) ----\n\n// props(cp): 14928 bytes of trie, 39 distinct values.\nconst PROPS_VALUES: [u16; 39] = [\n");
    buf_str(out, c"    83, 4179, 4178, 4177, 4112, 16, 1040, 64, 1054, 3, 1102, 388,\n    23, 7, 24, 272, 132, 41, 10, 11, 288, 48, 144, 4,\n    389, 4115, 1582, 32, 404, 4128, 1070, 0, 44, 45, 19, 26,\n    30, 1558, 4004,\n];\nconst PROPS_SHIFT2: usize = 4;\nconst PROPS_SHIFT1: usize = 9;\nconst PROPS_MASK2: usize = 31;\nconst PROPS_MASK3: usize = 15;\nconst PROPS_WIDE1: bool = false;\nconst PROPS_WIDE2: bool = true;\nconst PROPS_S1: &str = \"!\\x22#$%&'()*+,-./+0123456789::::::\\\n    ::::::::::::::::::::::::::::::::\\\n    ::::::::::::::::::;<=>?@\\x41\\x42\\x43\\x44\\x45?@\\x41\\\n    \\x42\\x43\\x44\\x45?@\\x41\\x42\\x43\\x44\\x45\\x46++++\\x47\\x47\\x47\\x47\\x47\\x47\\x47\\x47\\x47\\x47\\x47\\x47\\x48\\x49+\\x4a\\\n    \\x4b\\x4c+++\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x53\\x54\\x55\\x56\\x57++++++++++\\x58+++++\\\n    ++++++++++++++++\\x59++++\\x5a\\x5b\\x5c::::::::\\\n    ::::::\\x5d:\\x5e++++++++++++++\\x5f\\x60\\x61++++\\x62+\\\n    +++++++\\x63\\x64\\x65+++\\x66++\\x67\\x68\\x69\\x6a\\x6b+++\\x6c\\x6d\\x6e\\x6f\\x70\\x71\\x72\\x73\\\n    ::::::::::::::::::::::::::::::::\\\n    ::::::::::::::::::::::::::::::::\\\n    ::::::::::::::::::::::::::::::::\\\n    :::::::::::::::::::::::::::::::\\x74\\\n    ::::::::::::::::::::::::::::::::\\\n    ::::::::::::::::::::::::::::::::\\\n    ::::::::::::::::::::::::::::::::\\\n    :::::::::::::::::::::::::::::::\\x74\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n    ++++++++++++++++++++++++++++++++\\\n");
