    buf_str(out, c"pub fn rename<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<()> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = cpath(from)?;\n    let b = cpath(to)?;\n    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.\n    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn create_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })\n}\n\n// Whether path is a directory (through a symbolic link).\nfn is_dir_at(path: &str) -> bool {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(m) => m.is_dir(),\n        crate::result::Result::Err(_) => false,\n    }\n}\n\n// path's parent as Rust's Path::parent has it: \"\" for a relative name,\n// None for the root (or \"\").\n#[effects(panic, diverge)]\nfn parent_of(path: &str) -> Option<&str> {\n    let b = path.as_bytes();\n    let mut end = b.len();\n    while end > 0 && b[end - 1] == 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::None;\n    }\n    while end > 0 && b[end - 1] != 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::Some(&path[..0]);\n    }\n    let mut k = end;\n    while k > 0 && b[k - 1] == 47 {\n        k -= 1;\n    }\n    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }\n}\n\n// Makes the directory at path and those above it that are missing: Ok\n// when it is there (Rust's, step for step).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn create_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    if path.is_empty() {\n        return crate::result::Result::Ok(());\n    }\n    match cr