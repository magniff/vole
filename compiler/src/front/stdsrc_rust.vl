    buf_str(out, c"    fn next(&mut self) -> Option<Path<'a>> {\n        let cur = self.next;\n        match cur {\n            Option::Some(p) => self.next = p.parent(),\n            Option::None => {}\n        }\n        cur\n    }\n}\n\n// ---- Path ----\n\n// A path: a view of its text.\n// std2: changed: a sized view `Path<'a>`, Rust's `&'a Path` (no unsized\n// newtypes yet); MVS: a distinct [u8]\n#[derive(Clone, Copy)]\npub struct Path<'a> {\n    s: &'a str,\n}\n\n// What `strip_prefix` fails with: the base is not a prefix.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub struct StripPrefixError {}\n\nimpl Display for StripPrefixError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"prefix not found\")\n    }\n}\n\n// The byte range of the file name in s (its last Normal component): it\n// ends where the trailing '/'s and \".\" components start.\nfn file_name_range(s: &str) -> Option<(usize, usize)> {\n    let n = match Path::new(s).file_name() {\n        Option::Some(n) => n.len(),\n        Option::None => return Option::None,\n    };\n    let b = s.as_bytes();\n    let mut hi = b.len();\n    loop {\n        if hi > 0 && b[hi - 1] == b'/' {\n            hi -= 1;\n        } else if hi > 0 && b[hi - 1] == b'.' && (hi == 1 || b[hi - 2] == b'/') {\n            hi -= 1;\n        } else {\n            break;\n        }\n    }\n    Option::Some((hi - n, hi))\n}\n\n// A file name split at its last '.': (stem, extension); \"..\" and a name\n// whose only '.' leads (\".bashrc\") have no extension.\nfn split_dot(name: &str) -> (&str, Option<&str>) {\n    if name == \"..\" {\n        return (name, Option::None);\n    }\n    match name.rfind('.') {\n        Option::Some(0) => (name, Option::None),\n        Option::Some(k) => (&name[0..k], Option::Some(&name[k + 1..])),\n        Option::None => (name, Option::None),\n    }\n}\n\nimpl<'a> Path<'a> {\n    // The path of the text s: `Path::new(\"a/b.txt\")`.\n");
    buf_str(out, c"    // std2: changed: a Path<'a> of a &'a str (Rust: &Path of an AsRef<OsStr>)\n    #[effects()]\n    pub fn new(s: &'a str) -> Path<'a> {\n        Path { s: s }\n    }\n\n    // Its text.\n    // std2: changed: Rust's as_os_str, a &str\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.s\n    }\n\n    // Its text: always Some, a path being UTF-8 here.\n    #[effects()]\n    pub fn to_str(&self) -> Option<&'a str> {\n        Option::Some(self.s)\n    }\n\n    // Its bytes.\n    #[effects()]\n    pub fn as_bytes(&self) -> &'a [u8] {\n        self.s.as_bytes()\n    }\n\n    // What prints it: the path itself, which is Display.\n    // std2: changed: a Path (Rust: a path::Display)\n    #[effects()]\n    pub fn display(&self) -> Path<'a> {\n        *self\n    }\n\n    #[effects(panic)]\n    pub fn is_absolute(&self) -> bool {\n        self.has_root()\n    }\n\n    #[effects(panic)]\n    pub fn is_relative(&self) -> bool {\n        !self.has_root()\n    }\n\n    // Whether it starts with '/'.\n    #[effects(panic)]\n    pub fn has_root(&self) -> bool {\n        self.s.len() > 0 && self.s.as_bytes()[0] == b'/'\n    }\n\n    // Its components.\n    #[effects(panic)]\n    pub fn components(&self) -> Components<'a> {\n        Components::of(self.s)\n    }\n\n    // Its components' texts.\n    #[effects(panic)]\n    pub fn iter(&self) -> PathIter<'a> {\n        PathIter { inner: Components::of(self.s) }\n    }\n\n    // It and its parents, up to the root (or \"\").\n    #[effects()]\n    pub fn ancestors(&self) -> Ancestors<'a> {\n        Ancestors { next: Option::Some(*self) }\n    }\n\n    // The path without its last component: None for \"/\" and \"\", \"\" for a\n    // single relative component.\n    #[effects(panic, diverge)]\n    pub fn parent(&self) -> Option<Path<'a>> {\n        let mut c = Components::of(self.s);\n        match c.next_back() {\n            Option::Some(Component::RootDir) => Option::None,\n");
