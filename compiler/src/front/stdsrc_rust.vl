    buf_str(out, c"// path as C takes it: InvalidInput when it holds a NUL, ENAMETOOLONG when\n// it does not fit.\nfn cpath(path: &str) -> Result<CPath> {\n    let b = path.as_bytes();\n    let mut p = CPath { buf: [0u8; crate::__sys::PATH_MAX] };\n    if b.len() >= p.buf.len() {\n        return crate::result::Result::Err(Error::from_raw_os_error(crate::__sys::ENAMETOOLONG));\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 {\n            return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n                \"file name contained an unexpected NUL byte\"));\n        }\n        p.buf[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(p)\n}\n\n// A C call's -1 as the io::Error errno says.\nfn cvt(r: i32) -> Result<()> {\n    if r < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(())\n    }\n}\n\nfn open_c(path: &str, flags: i32, mode: u32) -> Result<File> {\n    let p = cpath(path)?;\n    // UNSAFE: C's open. SAFETY: p is NUL-ended and lives past the call;\n    // the mode is the variadic int open reads when it creates the file.\n    let fd = unsafe { fs_c_open(p.ptr(), flags | crate::__sys::O_CLOEXEC, mode as i32) };\n    if fd < 0 {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    crate::result::Result::Ok(File { fd: fd })\n}\n\n// Room for either system's struct stat (144 bytes on macOS, 128 on Linux).\nstruct StatBuf {\n    words: [u64; 20],\n}\n\nfn metadata_of(b: &StatBuf) -> Metadata {\n    let (mode, size, mtime, mtime_nsec) = crate::__sys::stat_fields(&b.words);\n    Metadata { mode: mode, size: size, mtime: mtime, mtime_nsec: mtime_nsec }\n}\n\n// stat, or lstat (follow false), of the file at path.\nfn stat_at(path: &str, follow: bool) -> Result<Metadata> {\n    let p = cpath(path)?;\n    let mut b = StatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat and lstat. SAFETY: p is NUL-ended; b.words is 