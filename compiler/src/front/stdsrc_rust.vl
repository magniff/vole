    buf_str(out, c"    #[effects(panic, diverge)]\n    pub fn to_uppercase(self) -> ToUppercase {\n        let c = self as u32;\n        if c < 0x80 {\n            return ToUppercase { chars: [self.to_ascii_uppercase(), '\\0', '\\0'], at: 0, len: 1 };\n        }\n        let (chars, len) = case_chars(crate::unicode::to_upper(c));\n        ToUppercase { chars: chars, at: 0, len: len }\n    }\n\n    // Its lower case: one char or more ('İ' gives \"i\\u{307}\").\n    #[effects(panic, diverge)]\n    pub fn to_lowercase(self) -> ToLowercase {\n        let c = self as u32;\n        if c < 0x80 {\n            return ToLowercase { chars: [self.to_ascii_lowercase(), '\\0', '\\0'], at: 0, len: 1 };\n        }\n        let (chars, len) = case_chars(crate::unicode::to_lower(c));\n        ToLowercase { chars: chars, at: 0, len: len }\n    }\n\n    // The bytes of its UTF-8, 1 to 4.\n    #[effects()]\n    pub fn len_utf8(self) -> usize {\n        let c = self as u32;\n        if c < 0x80 {\n            1\n        } else if c < 0x800 {\n            2\n        } else if c < 0x10000 {\n            3\n        } else {\n            4\n        }\n    }\n\n    // Its UTF-8 written into buf (which must hold len_utf8 bytes), as a str.\n    #[effects(panic)]\n    pub fn encode_utf8(self, buf: &mut [u8]) -> &mut str {\n        let c = self as u32;\n        let n = self.len_utf8();\n        if buf.len() < n {\n            crate::panic::panic(\"encode_utf8: the buffer is too small\");\n        }\n        if n == 1 {\n            buf[0] = c as u8;\n        } else if n == 2 {\n            buf[0] = (0xC0 | (c >> 6)) as u8;\n            buf[1] = (0x80 | (c & 0x3F)) as u8;\n        } else if n == 3 {\n            buf[0] = (0xE0 | (c >> 12)) as u8;\n            buf[1] = (0x80 | ((c >> 6) & 0x3F)) as u8;\n            buf[2] = (0x80 | (c & 0x3F)) as u8;\n        } else {\n            buf[0] = (0xF0 | (c >> 18)) as u8;\n            buf[1] = (0x80 | ((c >> 12) & 0x3F)) as u8;\n");
