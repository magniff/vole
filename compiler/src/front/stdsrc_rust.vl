    buf_str(out, c"    // An owned copy, on allocator a.\n    // std2: changed: an allocator (Rust: to_path_buf)\n    #[effects(A)]\n    pub fn to_path_buf_in<A: Allocator>(&self, a: A) -> PathBuf<A> {\n        PathBuf::from_in(self.s, a)\n    }\n\n    // The path with its file name replaced by name, on allocator a.\n    // std2: changed: an allocator (Rust: with_file_name)\n    #[effects(S, A)]\n    pub fn with_file_name_in<S: AsRef<str>, A: Allocator>(&self, name: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_file_name(name);\n        out\n    }\n\n    // The path with its extension replaced by ext, on allocator a.\n    // std2: changed: an allocator (Rust: with_extension)\n    #[effects(S, A)]\n    pub fn with_extension_in<S: AsRef<str>, A: Allocator>(&self, ext: S, a: A) -> PathBuf<A> {\n        let mut out = PathBuf::from_in(self.s, a);\n        out.set_extension(ext);\n        out\n    }\n\n    // What stat says of the file at the path.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::metadata(self.s)\n    }\n\n    // What lstat says of it.\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn symlink_metadata(&self) -> crate::io::Result<crate::fs::Metadata> {\n        crate::fs::symlink_metadata(self.s)\n    }\n\n    // Whether something is there (stat succeeds).\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn exists(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(_) => true,\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_dir(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(m) => m.is_dir(),\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n");
    buf_str(out, c"    pub fn is_file(&self) -> bool {\n        match crate::fs::metadata(self.s) {\n            Result::Ok(m) => m.is_file(),\n            Result::Err(_) => false,\n        }\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge)]\n    pub fn is_symlink(&self) -> bool {\n        match crate::fs::symlink_metadata(self.s) {\n            Result::Ok(m) => m.is_symlink(),\n            Result::Err(_) => false,\n        }\n    }\n}\n\nimpl<'a> AsRef<str> for Path<'a> {\n    fn as_ref(&self) -> &str {\n        self.s\n    }\n}\n\n// Two paths are equal when their components are (\"a//b/\" is \"a/b\").\nimpl<'a> PartialEq for Path<'a> {\n    fn eq(&self, other: &Path<'a>) -> bool {\n        let mut x = Components::of(self.s);\n        let mut y = Components::of(other.s);\n        loop {\n            match x.next() {\n                Option::Some(c) => match y.next() {\n                    Option::Some(d) => {\n                        if c != d {\n                            return false;\n                        }\n                    }\n                    Option::None => return false,\n                },\n                Option::None => return y.next().is_none(),\n            }\n        }\n    }\n}\n\nimpl<'a> Eq for Path<'a> {}\n\n// Its text (Rust's `p.display()`).\nimpl<'a> Display for Path<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Display::fmt(self.s, f)\n    }\n}\n\n// Its text, quoted, as a str's Debug.\nimpl<'a> Debug for Path<'a> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(self.s, f)\n    }\n}\n\n// ---- PathBuf ----\n\n// An owned path, its text in a String on allocator A.\n// std2: changed: its text a String<A> (MVS: a pub Vec<u8, A>)\npub struct PathBuf<A: Allocator> {\n    s: String<A>,\n}\n\nimpl<A: Allocator> PathBuf<A> {\n    // An empty path.\n    // std2: changed: an allocator (Rust: new)\n    pub fn new_in(a: A) -> PathBuf<A> {\n");
