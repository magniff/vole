    buf_str(out, c"        BufReader { inner: inner, buf: [0; 8192], pos: 0, filled: 0 }\n    }\n}\n\nimpl<R> BufReader<R> {\n    pub fn get_ref(&self) -> &R {\n        &self.inner\n    }\n\n    pub fn get_mut(&mut self) -> &mut R {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not read yet.\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[self.pos..self.filled]\n    }\n\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The reader, the buffered bytes dropped.\n    pub fn into_inner(self) -> R {\n        self.inner\n    }\n}\n\nimpl<R: Read> Read for BufReader<R> {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::panic::todo()\n    }\n}\n\nimpl<R: Read> BufRead for BufReader<R> {\n    fn fill_buf(&mut self) -> Result<&[u8]> {\n        crate::panic::todo()\n    }\n\n    fn consume(&mut self, n: usize) {\n        self.pos = crate::cmp::min(self.pos + n, self.filled);\n    }\n}\n\n// A Write with a buffer of its own (8 KiB, inline), flushed when full,\n// on flush and when dropped.\npub struct BufWriter<W: Write> {\n    inner: W,\n    buf: [u8; 8192],\n    len: usize,\n}\n\nimpl<W: Write> BufWriter<W> {\n    pub fn new(inner: W) -> BufWriter<W> {\n        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n    }\n\n    pub fn get_ref(&self) -> &W {\n        &self.inner\n    }\n\n    pub fn get_mut(&mut self) -> &mut W {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not written yet.\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The writer, after a flush; the error and the BufWriter if it failed.\n    // std2: changed: a Result (Rust's)\n    pub fn into_inner(self) -> crate::result::Result<W, IntoInnerError<BufWriter<W>>> {\n        crate::panic::todo()\n    }\n}\n\nimpl<W: Write> Write for BufWriter<W> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::panic::