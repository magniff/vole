    buf_str(out, c"    \\x0a\\x22\\x5f\\x0a\\x22=\\x0a\\x22\\x60\\x0a\\x22>\\x0a\\x22\\x61\\x0a\\x22?\\x0a\\x22\\x62\\x0a\\x22@\\x0a\\x22\\x63\\x0a\\x22\\x41\\x0a\\x22\\\n    \\x64\\x0a\\x22\\x42\\x0a\\x22\";\nconst UPPER_MULTI: &str = \"\\x74!!\\x74!!!!!\\x67!!\\x67!!!!!\\x67!!\\x6a!!!!!\\x67!!\\x6d!\\\n    !!!!\\x67!!\\x67!!\\x6a!!\\x67!!\\x67!!\\x6d!!\\x74!!\\x75!!!!!\\x74\\\n    !!\\x75!!!!!\\x74!!\\x74!!!!!\\x56&!\\x73&!!!!\\x65&!\\x67&!\\\n    !!!\\x65&!\\x56&!!!!\\x65&!\\x5c&!!!!\\x6f&!\\x67&!!!!\\x65&\\\n    !\\x5e&!!!!\\xdd#!\\x6f!!!!!\\xba$!)$!\\x22$!\\xc6$!)$!\\x22\\\n    $!\\x6b!!-$!!!!\\x69!!\\x52$!!!!\\x75!!)$!!!!\\x78!!\\\n    +$!!!!\\x7a!!+$!!!!\\x62!!\\xdf#!!!!\\xc6$!4$!!!\\\n    !\\xc6$!4$!!$!\\xc6$!4$!\\x22$!\\xc6$!4$!\\x63$!\\xb2$!\\x63\\\n    $!!!!\\xb8$!\\x63$!!!!\\xba$!)$!!$!\\xba$!)$!\\x22$!\\\n    \\xba$!\\x63$!!!!\\xba$!)$!\\x63$!\\xc6$!)$!!$!\\xc6$!)$\\\n    !\\x22$!\\xc2$!4$!!!!\\xc6$!\\x63$!!!!\\xc6$!)$!\\x63$!\\xca\\\n    $!\\x63$!!!!)@!\\xba$!!!!*@!\\xba$!!!!+@!\\xba$!\\\n    !!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\xba$!!!!/@\\\n    !\\xba$!!!!0@!\\xba$!!!!)@!\\xba$!!!!*@!\\xba$!!\\\n    !!+@!\\xba$!!!!,@!\\xba$!!!!-@!\\xba$!!!!.@!\\\n    \\xba$!!!!/@!\\xba$!!!!0@!\\xba$!!!!\\x49@!\\xba$!!!\\\n    !\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$!!!!\\x4d@!\\xba\\\n    $!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50@!\\xba$!!!!\\\n    \\x49@!\\xba$!!!!\\x4a@!\\xba$!!!!\\x4b@!\\xba$!!!!\\x4c@!\\xba$\\\n    !!!!\\x4d@!\\xba$!!!!\\x4e@!\\xba$!!!!\\x4f@!\\xba$!!!!\\x50\\\n    @!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!!!\\x8b@!\\xba$!\\\n    !!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\xba$!!!!\\x8f@\\\n    !\\xba$!!!!\\x90@!\\xba$!!!!\\x89@!\\xba$!!!!\\x8a@!\\xba$!!\\\n    !!\\x8b@!\\xba$!!!!\\x8c@!\\xba$!!!!\\x8d@!\\xba$!!!!\\x8e@!\\\n    \\xba$!!!!\\x8f@!\\xba$!!!!\\x90@!\\xba$!!!!\\xb2$!\\xba$!!!\\\n    !\\xb2$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xb8$!\\xba$!!!!\\xca$!\\xba\\\n    $!!!!\\xca$!\\xba$!!!!\\xdb@!\\xba$!!!!\\xa7$!\\xba$!!!!\\\n");
    buf_str(out, c"    \\xeb@!\\xba$!!!!\\xaa$!\\xba$!!!!\\x1b@!\\xba$!!!!\\xb0$!\\xba$\\\n    !!!!\\xb2$!\\x63$!\\xba$!\\xb8$!\\x63$!\\xba$!\\xca$!\\x63$!\\xba$!\";\nconst LOWER_COUNT: usize = 1508;\nconst UPPER_COUNT: usize = 1601;\n// ---- end mod std::unicode ----\n}\n// ---- mod std::io ----\npub mod io {\n// EDITION: rust\n// std::io: Read, Write and BufRead, the buffered types, the standard\n// streams, Error. Rust's shape: counts are usize, `read_line` is\n// Stdin's (and BufRead's) and returns the bytes read (0 at the end), and\n// what reads into a growing buffer takes the buffer (`read_to_end(&mut\n// v)`, which grows from v's allocator) or an allocator (`lines_in(a)`,\n// `read_to_string_in(r, a)`). The buffered types hold a fixed buffer\n// inline, so making one allocates nothing. Seek and SeekFrom are here, as\n// Rust's; the file types are std::fs's.\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::From;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// io's Result: an io::Error on failure.\n// mvs: Result\npub type Result<T> = crate::result::Result<T, Error>;\n\n// What failed: a kind, and the OS's error number when it came from one.\n// mvs: Error, IoError\n// std2: changed: Rust's io::Error (MVS's root IoError is gone into it)\npub struct Error {\n    kind: ErrorKind,\n    code: i32,\n    msg: &'static str,\n}\n\nimpl Error {\n    // An error of kind k, with a message (Rust's takes any error; vole's a\n    // static text: no allocation, no dyn).\n    // std2: changed: a message, &'static str\n    #[effects()]\n    pub fn new(k: ErrorKind, msg: &'static str) -> Error {\n        Error { kind: k, code: 0, msg: msg }\n    }\n\n    // An error of kind Other, with a message.\n    #[effects()]\n    pub fn other(msg: &'static str) -> Error {\n        Error::new(ErrorKind::Other, msg)\n    }\n\n    // The error errno says.\n    #[effects()]\n");
    buf_str(out, c"    pub fn from_raw_os_error(code: i32) -> Error {\n        Error { kind: kind_of_errno(code), code: code, msg: \"\" }\n    }\n\n    // The error of the last failed OS call (errno).\n    #[effects(static, unsafe)]\n    pub fn last_os_error() -> Error {\n        // UNSAFE: errno, read through libc's pointer to this thread's copy.\n        // SAFETY: __error returns a valid pointer to the calling thread's\n        // errno, an i32.\n        let code = unsafe { *__error() };\n        Error::from_raw_os_error(code)\n    }\n\n    #[effects()]\n    pub fn kind(&self) -> ErrorKind {\n        self.kind\n    }\n\n    #[effects()]\n    pub fn raw_os_error(&self) -> Option<i32> {\n        if self.code == 0 { Option::None } else { Option::Some(self.code) }\n    }\n}\n\n// mvs: Error::impl Display, IoError::impl Display\nimpl Display for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.write_str(os_message(self.code))?;\n            f.write_str(\" (os error \")?;\n            f.write_fmt(self.code)?;\n            f.write_str(\")\")\n        } else if !self.msg.is_empty() {\n            f.write_str(self.msg)\n        } else {\n            crate::fmt::Display::fmt(&self.kind, f)\n        }\n    }\n}\n\n// mvs: Error::impl Debug, IoError::impl Debug\nimpl Debug for Error {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.code != 0 {\n            f.debug_struct(\"Os\")\n                .field(\"code\", &self.code)\n                .field(\"kind\", &self.kind)\n                .field(\"message\", &os_message(self.code))\n                .finish()\n        } else if !self.msg.is_empty() {\n            f.debug_struct(\"Custom\").field(\"kind\", &self.kind).field(\"error\", &self.msg).finish()\n        } else {\n            f.debug_tuple(\"Kind\").field(&self.kind).finish()\n        }\n    }\n}\n\nimpl From<ErrorKind> for Error {\n    fn from(k: ErrorKind) -> Error {\n");
    buf_str(out, c"        Error::new(k, \"\")\n    }\n}\n\n// The ErrorKind of an errno (macOS's numbers; Linux's differ above 34 and\n// come with the sys tail).\nfn kind_of_errno(code: i32) -> ErrorKind {\n    match code {\n        1 | 13 => ErrorKind::PermissionDenied,\n        2 => ErrorKind::NotFound,\n        4 => ErrorKind::Interrupted,\n        12 => ErrorKind::OutOfMemory,\n        17 => ErrorKind::AlreadyExists,\n        20 => ErrorKind::NotADirectory,\n        21 => ErrorKind::IsADirectory,\n        22 => ErrorKind::InvalidInput,\n        32 => ErrorKind::BrokenPipe,\n        35 => ErrorKind::WouldBlock,\n        45 | 78 => ErrorKind::Unsupported,\n        60 => ErrorKind::TimedOut,\n        63 => ErrorKind::InvalidFilename,\n        66 => ErrorKind::DirectoryNotEmpty,\n        _ => ErrorKind::Other,\n    }\n}\n\n// The OS's text for an errno (C's strerror), or \"\" when it is not UTF-8.\nfn os_message(code: i32) -> &'static str {\n    // UNSAFE: strerror's C string, read through its raw pointer.\n    // SAFETY: strerror returns a NUL-terminated string that lives as long\n    // as the process (macOS's table; the bytes up to the NUL are read, no\n    // further).\n    unsafe {\n        let p = strerror(code);\n        let mut n: usize = 0;\n        while *p.add(n) != 0 {\n            n += 1;\n        }\n        match crate::str::from_utf8(crate::slice::from_raw_parts(p, n)) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n}\n\n// What a read appended to v from start: kept when it is UTF-8, cut off\n// with InvalidData when not (read_to_string's and read_line's check).\nfn append_utf8<A: Allocator>(v: &mut Vec<u8, A>, start: usize, r: Result<usize>) -> Result<usize> {\n    if crate::str::from_utf8(&v.as_slice()[start..]).is_err() {\n        v.truncate(start);\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidData,\n            \"stream did not contain valid UTF-8\"));\n    }\n    r\n");
    buf_str(out, c"}\n\n// Write::write_fmt's sink: a fmt::Write over an io::Write that keeps the\n// io::Error a write gave (fmt::Error carries nothing).\nstruct Adapter<'a, W: ?Sized> {\n    inner: &'a mut W,\n    error: Result<()>,\n}\n\nimpl<'a, W: Write + ?Sized> crate::fmt::Write for Adapter<'a, W> {\n    fn write_str(&mut self, s: &str) -> crate::fmt::Result {\n        match self.inner.write_all(s.as_bytes()) {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(e) => {\n                self.error = crate::result::Result::Err(e);\n                crate::result::Result::Err(crate::fmt::Error {})\n            }\n        }\n    }\n}\n\n// UNSAFE: the OS's calls under the standard streams and io::Error.\n// SAFETY: read and write take a buffer of n bytes they may read or fill;\n// __error returns this thread's errno; strerror a static C string. The\n// callers below pass slices' pointers and lengths.\nextern \"C\" {\n    #[link_name = \"read\"]\n    fn c_read(fd: i32, buf: *mut u8, n: usize) -> isize;\n    #[link_name = \"write\"]\n    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;\n    fn __error() -> *mut i32;\n    fn strerror(code: i32) -> *const u8;\n}\n\n// Up to buf.len() bytes from fd.\n#[effects(io, static, unsafe)]\npub(crate) fn sys_read(fd: i32, buf: &mut [u8]) -> Result<usize> {\n    // UNSAFE: the OS's read.\n    // SAFETY: buf's pointer and length are a writable region of buf.len()\n    // bytes, borrowed for the call.\n    let n = unsafe { c_read(fd, buf.as_mut_ptr(), buf.len()) };\n    if n < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(n as usize)\n    }\n}\n\n// Some of buf to fd.\n#[effects(io, static, unsafe)]\npub(crate) fn sys_write(fd: i32, buf: &[u8]) -> Result<usize> {\n    // UNSAFE: the OS's write.\n    // SAFETY: buf's pointer and length are a readable region of buf.len()\n    // bytes, borrowed for the call.\n");
    buf_str(out, c"    let n = unsafe { c_write(fd, buf.as_ptr(), buf.len()) };\n    if n < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(n as usize)\n    }\n}\n\n// What kind of failure, as Rust's (the ones vole's OS calls give).\n#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum ErrorKind {\n    NotFound,\n    PermissionDenied,\n    AlreadyExists,\n    WouldBlock,\n    InvalidInput,\n    InvalidData,\n    TimedOut,\n    WriteZero,\n    Interrupted,\n    UnexpectedEof,\n    BrokenPipe,\n    NotADirectory,\n    IsADirectory,\n    DirectoryNotEmpty,\n    InvalidFilename,\n    Unsupported,\n    OutOfMemory,\n    Other,\n}\n\nimpl Display for ErrorKind {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(match *self {\n            ErrorKind::NotFound => \"entity not found\",\n            ErrorKind::PermissionDenied => \"permission denied\",\n            ErrorKind::AlreadyExists => \"entity already exists\",\n            ErrorKind::WouldBlock => \"operation would block\",\n            ErrorKind::InvalidInput => \"invalid input parameter\",\n            ErrorKind::InvalidData => \"invalid data\",\n            ErrorKind::TimedOut => \"timed out\",\n            ErrorKind::WriteZero => \"write zero\",\n            ErrorKind::Interrupted => \"operation interrupted\",\n            ErrorKind::UnexpectedEof => \"unexpected end of file\",\n            ErrorKind::BrokenPipe => \"broken pipe\",\n            ErrorKind::NotADirectory => \"not a directory\",\n            ErrorKind::IsADirectory => \"is a directory\",\n            ErrorKind::DirectoryNotEmpty => \"directory not empty\",\n            ErrorKind::InvalidFilename => \"invalid filename\",\n            ErrorKind::Unsupported => \"unsupported\",\n            ErrorKind::OutOfMemory => \"out of memory\",\n            ErrorKind::Other => \"other error\",\n        })\n    }\n}\n\n");
    buf_str(out, c"// Where Seek::seek moves to: an offset from the start, the end or the\n// position now.\n// std2: changed: std::io's, as Rust's (MVS: std::fs's); Start is a u64\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum SeekFrom {\n    Start(u64),\n    End(i64),\n    Current(i64),\n}\n\n// A stream with a position that can move (a File).\npub trait Seek {\n    // Moves the position; the new one, from the start.\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64>;\n\n    // Back to the start.\n    fn rewind(&mut self) -> Result<()> {\n        self.seek(SeekFrom::Start(0))?;\n        crate::result::Result::Ok(())\n    }\n\n    // The position, from the start.\n    fn stream_position(&mut self) -> Result<u64> {\n        self.seek(SeekFrom::Current(0))\n    }\n}\n\n// A source of bytes.\npub trait Read {\n    // Up to buf.len() bytes into buf; how many (0 at the end).\n    // std2: changed: &mut [u8], a usize\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize>;\n\n    // Exactly buf.len() bytes, or UnexpectedEof.\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        let mut buf = buf;\n        while !buf.is_empty() {\n            match self.read(buf) {\n                crate::result::Result::Ok(0) => {\n                    return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                        \"failed to fill whole buffer\"));\n                }\n                crate::result::Result::Ok(n) => {\n                    let rest = buf;\n                    buf = &mut rest[n..];\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(())\n    }\n\n    // Everything left, appended to buf (grown from buf's allocator).\n    // std2: changed: a usize\n");
    buf_str(out, c"    fn read_to_end<A: Allocator>(&mut self, buf: &mut Vec<u8, A>) -> Result<usize> {\n        let start = buf.len();\n        let mut chunk = [0u8; 4096];\n        loop {\n            match self.read(&mut chunk) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(n) => buf.extend_from_slice(&chunk[..n]),\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(buf.len() - start)\n    }\n\n    // Everything left, appended to buf; InvalidData when it is not UTF-8.\n    // std2: changed: a usize\n    fn read_to_string<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8, so the String is UTF-8 whenever it is used.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let r = self.read_to_end(v);\n        append_utf8(v, start, r)\n    }\n\n    // The reader borrowed: adapters on it leave it usable after.\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A sink of bytes.\npub trait Write {\n    // Some of buf; how much was written.\n    // std2: changed: &[u8], a usize\n    fn write(&mut self, buf: &[u8]) -> Result<usize>;\n\n    // Whatever is buffered, out to its destination.\n    fn flush(&mut self) -> Result<()>;\n\n    // All of buf (write until it is written, or an error).\n    fn write_all(&mut self, buf: &[u8]) -> Result<()> {\n        let mut buf = buf;\n        while !buf.is_empty() {\n            match self.write(buf) {\n                crate::result::Result::Ok(0) => {\n");
    buf_str(out, c"                    return crate::result::Result::Err(Error::new(ErrorKind::WriteZero,\n                        \"failed to write whole buffer\"));\n                }\n                crate::result::Result::Ok(n) => buf = &buf[n..],\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        return crate::result::Result::Err(e);\n                    }\n                }\n            }\n        }\n        crate::result::Result::Ok(())\n    }\n\n    // x as its Display shows it (the compiler's `write(w, \"..\")`).\n    fn write_fmt<T: Display>(&mut self, x: T) -> Result<()> {\n        let mut out = Adapter { inner: self, error: crate::result::Result::Ok(()) };\n        let r = {\n            let mut f = Formatter::new(&mut out);\n            crate::fmt::Display::fmt(&x, &mut f)\n        };\n        match r {\n            crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n            crate::result::Result::Err(_) => match out.error {\n                crate::result::Result::Err(e) => crate::result::Result::Err(e),\n                crate::result::Result::Ok(()) => {\n                    crate::result::Result::Err(Error::new(ErrorKind::Other, \"formatter error\"))\n                }\n            },\n        }\n    }\n\n    fn by_ref(&mut self) -> &mut Self\n        where\n            Self: Sized,\n    {\n        self\n    }\n}\n\n// A reader with a buffer: lines and delimited reads.\npub trait BufRead: Read {\n    // The buffered bytes, refilled when empty (empty at the end).\n    // std2: changed: returns &[u8]\n    fn fill_buf(&mut self) -> Result<&[u8]>;\n\n    // Marks n buffered bytes as read.\n    // std2: changed: n is usize\n    fn consume(&mut self, n: usize);\n\n    // The bytes up to and including delim (or the end), appended to buf.\n    // mvs: BufReader::read_until\n    fn read_until<A: Allocator>(&mut self, delim: u8, buf: &mut Vec<u8, A>) -> Result<usize> {\n");
    buf_str(out, c"        let mut read: usize = 0;\n        loop {\n            let (done, used) = {\n                let available = match self.fill_buf() {\n                    crate::result::Result::Ok(b) => b,\n                    crate::result::Result::Err(e) => {\n                        if e.kind() == ErrorKind::Interrupted {\n                            continue;\n                        }\n                        return crate::result::Result::Err(e);\n                    }\n                };\n                let mut i: usize = 0;\n                while i < available.len() && available[i] != delim {\n                    i += 1;\n                }\n                if i < available.len() {\n                    buf.extend_from_slice(&available[..i + 1]);\n                    (true, i + 1)\n                } else {\n                    buf.extend_from_slice(available);\n                    (false, available.len())\n                }\n            };\n            self.consume(used);\n            read += used;\n            if done || used == 0 {\n                return crate::result::Result::Ok(read);\n            }\n        }\n    }\n\n    // A line, its \"\\n\" included, appended to buf; 0 at the end.\n    // mvs: BufReader::read_line, read_line\n    // std2: changed: BufRead's, a usize (MVS: a free function's bool, BufReader's i64)\n    fn read_line<A: Allocator>(&mut self, buf: &mut String<A>) -> Result<usize> {\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let r = self.read_until(10, v);\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a, without its \"\\n\".\n    // mvs: BufReader::lines_in\n    fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<Self, A>\n        where\n            Self: Sized,\n    {\n");
    buf_str(out, c"        Lines { buf: self, alloc: a }\n    }\n}\n\n// BufRead::lines_in's iterator: each line a String<A>, or an error.\n// mvs: Lines\npub struct Lines<B, A: Allocator> {\n    buf: B,\n    alloc: A,\n}\n\n// mvs: Lines::impl Iterator\nimpl<B: BufRead, A: Allocator + Clone> Iterator for Lines<B, A> {\n    type Item = Result<String<A>>;\n\n    fn next(&mut self) -> Option<Result<String<A>>> {\n        let mut s = String::new_in(self.alloc.clone());\n        match self.buf.read_line(&mut s) {\n            crate::result::Result::Ok(0) => Option::None,\n            crate::result::Result::Ok(_) => {\n                let nl: &str = \"\\n\";\n                let cr: &str = \"\\r\";\n                if s.ends_with(nl) {\n                    s.pop();\n                    if s.ends_with(cr) {\n                        s.pop();\n                    }\n                }\n                Option::Some(crate::result::Result::Ok(s))\n            }\n            crate::result::Result::Err(e) => Option::Some(crate::result::Result::Err(e)),\n        }\n    }\n}\n\n// A Read with a buffer of its own (8 KiB, inline: no allocation).\npub struct BufReader<R> {\n    inner: R,\n    buf: [u8; 8192],\n    pos: usize,\n    filled: usize,\n}\n\nimpl<R: Read> BufReader<R> {\n    #[effects()]\n    pub fn new(inner: R) -> BufReader<R> {\n        BufReader { inner: inner, buf: [0; 8192], pos: 0, filled: 0 }\n    }\n}\n\nimpl<R> BufReader<R> {\n    #[effects()]\n    pub fn get_ref(&self) -> &R {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut R {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not read yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[self.pos..self.filled]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The reader, the buffered bytes dropped.\n    #[effects()]\n    pub fn into_inner(self) -> R {\n        self.inner\n    }\n}\n\n");
    buf_str(out, c"impl<R: Read> Read for BufReader<R> {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        // A read as large as the buffer, with nothing buffered, skips it.\n        if self.pos == self.filled && buf.len() >= 8192 {\n            return self.inner.read(buf);\n        }\n        let n = {\n            let rem = self.fill_buf()?;\n            let n = crate::cmp::min(rem.len(), buf.len());\n            buf[..n].copy_from_slice(&rem[..n]);\n            n\n        };\n        self.consume(n);\n        crate::result::Result::Ok(n)\n    }\n}\n\nimpl<R: Read> BufRead for BufReader<R> {\n    fn fill_buf(&mut self) -> Result<&[u8]> {\n        if self.pos >= self.filled {\n            let n = self.inner.read(&mut self.buf)?;\n            self.filled = n;\n            self.pos = 0;\n        }\n        crate::result::Result::Ok(&self.buf[self.pos..self.filled])\n    }\n\n    fn consume(&mut self, n: usize) {\n        self.pos = crate::cmp::min(self.pos + n, self.filled);\n    }\n}\n\n// A Write with a buffer of its own (8 KiB, inline), flushed when full,\n// on flush and when dropped.\npub struct BufWriter<W: Write> {\n    inner: W,\n    buf: [u8; 8192],\n    len: usize,\n}\n\nimpl<W: Write> BufWriter<W> {\n    #[effects()]\n    pub fn new(inner: W) -> BufWriter<W> {\n        BufWriter { inner: inner, buf: [0; 8192], len: 0 }\n    }\n\n    #[effects()]\n    pub fn get_ref(&self) -> &W {\n        &self.inner\n    }\n\n    #[effects()]\n    pub fn get_mut(&mut self) -> &mut W {\n        &mut self.inner\n    }\n\n    // The bytes buffered and not written yet.\n    #[effects(panic)]\n    pub fn buffer(&self) -> &[u8] {\n        &self.buf[..self.len]\n    }\n\n    #[effects()]\n    pub fn capacity(&self) -> usize {\n        8192\n    }\n\n    // The writer, after a flush; the error and the BufWriter if it failed.\n    // std2: changed: a Result (Rust's)\n    #[effects(unsafe, W)]\n    pub fn into_inner(self) -> crate::result::Result<W, IntoInnerError<BufWriter<W>>> {\n");
    buf_str(out, c"        let mut me = self;\n        match me.flush_buf() {\n            crate::result::Result::Err(e) => {\n                crate::result::Result::Err(IntoInnerError { writer: me, error: e })\n            }\n            crate::result::Result::Ok(()) => {\n                // UNSAFE: the writer is moved out of a type with a Drop,\n                // which is then forgotten (Rust's into_inner does the same).\n                // SAFETY: me is forgotten right after, so its inner is not\n                // dropped twice, and its buffer is empty (flushed): its drop\n                // would only flush nothing.\n                let inner = unsafe { crate::ptr::read(&me.inner) };\n                crate::mem::forget(me);\n                crate::result::Result::Ok(inner)\n            }\n        }\n    }\n}\n\nimpl<W: Write> BufWriter<W> {\n    // The buffer written out to the inner writer, then emptied.\n    fn flush_buf(&mut self) -> Result<()> {\n        let n = self.len;\n        self.inner.write_all(&self.buf[..n])?;\n        self.len = 0;\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl<W: Write> Write for BufWriter<W> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        if self.len + buf.len() > 8192 {\n            self.flush_buf()?;\n        }\n        if buf.len() >= 8192 {\n            return self.inner.write(buf);\n        }\n        let n = buf.len();\n        self.buf[self.len..self.len + n].copy_from_slice(buf);\n        self.len += n;\n        crate::result::Result::Ok(n)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        self.flush_buf()?;\n        self.inner.flush()\n    }\n}\n\nimpl<W: Write> crate::ops::Drop for BufWriter<W> {\n    fn drop(&mut self) {\n        let _ = self.flush();\n    }\n}\n\n// `BufWriter { writer: .., buffer: 3/8192 }`, as Rust's.\nimpl<W: Write + Debug> Debug for BufWriter<W> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"BufWriter\")\n");
    buf_str(out, c"            .field(\"writer\", &self.inner)\n            .field(\"buffer\", &Filled { len: self.len, cap: 8192 })\n            .finish()\n    }\n}\n\n// A buffer's fill as `len/cap`.\nstruct Filled {\n    len: usize,\n    cap: usize,\n}\n\nimpl Debug for Filled {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.len, f)?;\n        f.write_str(\"/\")?;\n        Debug::fmt(&self.cap, f)\n    }\n}\n\n// BufWriter::into_inner's error: the flush's error and the writer.\n#[derive(Debug)]\npub struct IntoInnerError<W> {\n    writer: W,\n    error: Error,\n}\n\nimpl<W> IntoInnerError<W> {\n    #[effects()]\n    pub fn error(&self) -> &Error {\n        &self.error\n    }\n\n    #[effects()]\n    pub fn into_inner(self) -> W {\n        self.writer\n    }\n}\n\n// The process's standard input (fd 0), buffered.\npub struct Stdin {\n    fd: i32,\n}\n\n// The process's stdin.\n#[effects()]\npub fn stdin() -> Stdin {\n    Stdin { fd: 0 }\n}\n\nimpl Stdin {\n    // A line, its \"\\n\" included, appended to buf; 0 at the end of input.\n    // mvs: read_line\n    // std2: changed: Stdin's, returns the bytes read (MVS: a free function, a bool)\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    pub fn read_line<A: Allocator>(&self, buf: &mut String<A>) -> Result<usize> {\n        // A byte at a time up to \"\\n\": Stdin keeps no buffer, so nothing\n        // after the line is taken from fd 0.\n        // UNSAFE: the bytes are appended to the String's Vec unchecked.\n        // SAFETY: they are checked right after, and cut off again when they\n        // are not UTF-8.\n        let v = unsafe { buf.as_mut_vec() };\n        let start = v.len();\n        let mut b = [0u8; 1];\n        let mut r: Result<usize> = crate::result::Result::Ok(0);\n        loop {\n            match sys_read(self.fd, &mut b) {\n                crate::result::Result::Ok(0) => break,\n                crate::result::Result::Ok(_) => {\n");
    buf_str(out, c"                    v.push(b[0]);\n                    if b[0] == 10 {\n                        break;\n                    }\n                }\n                crate::result::Result::Err(e) => {\n                    if e.kind() != ErrorKind::Interrupted {\n                        r = crate::result::Result::Err(e);\n                        break;\n                    }\n                }\n            }\n        }\n        // (annotated: an arm's Ok gives no E, FL1)\n        let r: Result<usize> = match r {\n            crate::result::Result::Ok(_) => crate::result::Result::Ok(v.len() - start),\n            crate::result::Result::Err(e) => crate::result::Result::Err(e),\n        };\n        append_utf8(v, start, r)\n    }\n\n    // Its lines, each a String on a clone of a.\n    #[effects(A)]\n    pub fn lines_in<A: Allocator + Clone>(self, a: A) -> Lines<BufReader<Stdin>, A> {\n        BufReader::new(self).lines_in(a)\n    }\n}\n\nimpl Read for Stdin {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        sys_read(self.fd, buf)\n    }\n}\n\n// The process's standard output (fd 1): line-buffered on a terminal,\n// block-buffered otherwise, flushed at exit.\npub struct Stdout {\n    fd: i32,\n}\n\n#[effects()]\npub fn stdout() -> Stdout {\n    Stdout { fd: 1 }\n}\n\nimpl Write for Stdout {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        // Written through (no buffer yet: the sys tail's line buffering\n        // comes with the embedded std, 0.27.2's M3).\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// The process's standard error (fd 2), unbuffered.\npub struct Stderr {\n    fd: i32,\n}\n\n#[effects()]\npub fn stderr() -> Stderr {\n    Stderr { fd: 2 }\n}\n\nimpl Write for Stderr {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n");
    buf_str(out, c"        crate::result::Result::Ok(())\n    }\n}\n\n// Everything r has left, as a String on a (Rust's io::read_to_string).\n// mvs: read_stdin_in\n// std2: changed: any reader, a String (MVS: stdin's bytes as a Vec)\n#[effects(R, A)]\npub fn read_to_string_in<R: Read, A: Allocator>(r: R, a: A) -> Result<String<A>> {\n    let mut r = r;\n    let mut s = String::new_in(a);\n    r.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// Everything from r, written to w; how many bytes.\n#[effects(alloc, io, static, panic, diverge, unsafe, R, W)]\npub fn copy<R: Read + ?Sized, W: Write + ?Sized>(r: &mut R, w: &mut W) -> Result<u64> {\n    let mut buf = [0u8; 8192];\n    let mut total: u64 = 0;\n    loop {\n        let n = match r.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        w.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// A reader with nothing in it.\n#[effects()]\npub fn empty() -> Empty {\n    Empty {}\n}\n\npub struct Empty {}\n\nimpl Read for Empty {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::result::Result::Ok(0)\n    }\n}\n\n// A writer that drops what it is given.\n#[effects()]\npub fn sink() -> Sink {\n    Sink {}\n}\n\npub struct Sink {}\n\nimpl Write for Sink {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A &mut of a reader or writer is one.\nimpl<R: Read + ?Sized> Read for &mut R {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        (**self).read(buf)\n    }\n}\n\n");
    buf_str(out, c"impl<W: Write + ?Sized> Write for &mut W {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        (**self).write(buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        (**self).flush()\n    }\n}\n\n// Bytes in memory as a reader (`Read for &[u8]`).\nimpl Read for &[u8] {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        let n = crate::cmp::min(buf.len(), self.len());\n        let (a, b) = self.split_at(n);\n        buf[..n].copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(n)\n    }\n\n    // All of buf, or UnexpectedEof with buf untouched and the slice used up\n    // (Rust's).\n    fn read_exact(&mut self, buf: &mut [u8]) -> Result<()> {\n        if buf.len() > self.len() {\n            *self = &self[self.len()..];\n            return crate::result::Result::Err(Error::new(ErrorKind::UnexpectedEof,\n                \"failed to fill whole buffer\"));\n        }\n        let (a, b) = self.split_at(buf.len());\n        buf.copy_from_slice(a);\n        *self = b;\n        crate::result::Result::Ok(())\n    }\n}\n\n// A Vec<u8, A> as a writer: write grows it from A.\nimpl<A: Allocator> Write for Vec<u8, A> {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        self.extend_from_slice(buf);\n        crate::result::Result::Ok(buf.len())\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n// ---- end mod std::io ----\n}\n// ---- mod std::fs ----\npub mod fs {\n// EDITION: rust\n// std::fs: files and directories, Rust's. A path is a &str until std2\n// has std::path (`fs::metadata(&s)` takes a &String through its deref);\n// it reaches C as a NUL-ended copy on the stack, so nothing here allocates\n// but what returns a Vec or a String, on the allocator given. A path that\n// holds a NUL is InvalidInput, one longer than the system's PATH_MAX the\n// OS's ENAMETOOLONG (Rust passes it to the OS, which says the same).\n// mvs: std::fs\n\n");
    buf_str(out, c"use crate::alloc::Allocator;\nuse crate::convert::AsRef;\nuse crate::io::{Error, ErrorKind, Read, Result, Seek, SeekFrom, Write};\nuse crate::iter::Iterator;\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::string::String;\nuse crate::time::SystemTime;\nuse crate::vec::Vec;\n\n// UNSAFE: the OS's file and directory calls, which take NUL-ended paths\n// and buffers as raw pointers.\n// SAFETY: POSIX's prototypes (fcntl.h, unistd.h, sys/stat.h, dirent.h,\n// stdio.h); open's mode is variadic, as declared. The callers pass a\n// CPath's buffer (NUL-ended), a StatBuf's words (larger than either\n// system's struct stat) and a DIR * that opendir returned.\nextern \"C\" {\n    #[link_name = \"open\"]\n    fn fs_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn fs_c_close(fd: i32) -> i32;\n    #[link_name = \"lseek\"]\n    fn fs_c_lseek(fd: i32, off: i64, whence: i32) -> i64;\n    #[link_name = \"ftruncate\"]\n    fn fs_c_ftruncate(fd: i32, len: i64) -> i32;\n    #[link_name = \"fsync\"]\n    fn fs_c_fsync(fd: i32) -> i32;\n    #[link_name = \"fchmod\"]\n    fn fs_c_fchmod(fd: i32, mode: u32) -> i32;\n    #[link_name = \"fstat\"]\n    fn fs_c_fstat(fd: i32, buf: *mut u64) -> i32;\n    #[link_name = \"stat\"]\n    fn fs_c_stat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"lstat\"]\n    fn fs_c_lstat(path: *const u8, buf: *mut u64) -> i32;\n    #[link_name = \"mkdir\"]\n    fn fs_c_mkdir(path: *const u8, mode: u32) -> i32;\n    #[link_name = \"rmdir\"]\n    fn fs_c_rmdir(path: *const u8) -> i32;\n    #[link_name = \"unlink\"]\n    fn fs_c_unlink(path: *const u8) -> i32;\n    #[link_name = \"rename\"]\n    fn fs_c_rename(from: *const u8, to: *const u8) -> i32;\n    #[link_name = \"opendir\"]\n    fn fs_c_opendir(path: *const u8) -> *mut u8;\n    #[link_name = \"readdir\"]\n    fn fs_c_readdir(dir: *mut u8) -> *const u8;\n    #[link_name = \"closedir\"]\n    fn fs_c_closedir(dir: *mut u8) -> i32;\n}\n\n");
    buf_str(out, c"const O_RDONLY: i32 = 0;\nconst O_WRONLY: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst S_IFMT: u32 = 0xf000;\nconst S_IFDIR: u32 = 0x4000;\nconst S_IFREG: u32 = 0x8000;\nconst S_IFLNK: u32 = 0xa000;\nconst DT_DIR: u8 = 4;\nconst DT_REG: u8 = 8;\nconst DT_LNK: u8 = 10;\nconst EINVAL: i32 = 22;\n\n// A path and its NUL, as C takes it.\nstruct CPath {\n    buf: [u8; crate::__sys::PATH_MAX],\n}\n\nimpl CPath {\n    #[effects()]\n    fn ptr(&self) -> *const u8 {\n        &self.buf[0] as *const u8\n    }\n}\n\n// path as C takes it: InvalidInput when it holds a NUL, ENAMETOOLONG when\n// it does not fit.\n#[effects(panic, diverge)]\nfn cpath(path: &str) -> Result<CPath> {\n    let b = path.as_bytes();\n    let mut p = CPath { buf: [0u8; crate::__sys::PATH_MAX] };\n    if b.len() >= p.buf.len() {\n        return crate::result::Result::Err(Error::from_raw_os_error(crate::__sys::ENAMETOOLONG));\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 {\n            return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n                \"file name contained an unexpected NUL byte\"));\n        }\n        p.buf[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(p)\n}\n\n// A C call's -1 as the io::Error errno says.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn cvt(r: i32) -> Result<()> {\n    if r < 0 {\n        crate::result::Result::Err(Error::last_os_error())\n    } else {\n        crate::result::Result::Ok(())\n    }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn open_c(path: &str, flags: i32, mode: u32) -> Result<File> {\n    let p = cpath(path)?;\n    // UNSAFE: C's open. SAFETY: p is NUL-ended and lives past the call;\n    // the mode is the variadic int open reads when it creates the file.\n    let fd = unsafe { fs_c_open(p.ptr(), flags | crate::__sys::O_CLOEXEC, mode as i32) };\n    if fd < 0 {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n");
    buf_str(out, c"    crate::result::Result::Ok(File { fd: fd })\n}\n\n// Room for either system's struct stat (144 bytes on macOS, 128 on Linux).\nstruct StatBuf {\n    words: [u64; 20],\n}\n\n#[effects()]\nfn metadata_of(b: &StatBuf) -> Metadata {\n    let (mode, size, mtime, mtime_nsec) = crate::__sys::stat_fields(&b.words);\n    Metadata { mode: mode, size: size, mtime: mtime, mtime_nsec: mtime_nsec }\n}\n\n// stat, or lstat (follow false), of the file at path.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn stat_at(path: &str, follow: bool) -> Result<Metadata> {\n    let p = cpath(path)?;\n    let mut b = StatBuf { words: [0u64; 20] };\n    // UNSAFE: C's stat and lstat. SAFETY: p is NUL-ended; b.words is 160\n    // bytes, 8-aligned, more than either system's struct stat.\n    let r = unsafe {\n        if follow {\n            fs_c_stat(p.ptr(), &mut b.words[0] as *mut u64)\n        } else {\n            fs_c_lstat(p.ptr(), &mut b.words[0] as *mut u64)\n        }\n    };\n    cvt(r)?;\n    crate::result::Result::Ok(metadata_of(&b))\n}\n\n// ---- Files ----\n\n// An open file; dropping it closes it.\npub struct File {\n    fd: i32,\n}\n\nimpl Drop for File {\n    fn drop(&mut self) {\n        // UNSAFE: C's close. SAFETY: fd is this File's own descriptor,\n        // closed once (here).\n        let _ = unsafe { fs_c_close(self.fd) };\n    }\n}\n\nimpl File {\n    // Opens path for reading.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn open(path: &str) -> Result<File> {\n        open_c(path, O_RDONLY, 0x1b6)\n    }\n\n    // Opens path for writing: made when it is not there, emptied when it is.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn create(path: &str) -> Result<File> {\n        open_c(path, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC, 0x1b6)\n    }\n\n    // Makes path and opens it for reading and writing: AlreadyExists when\n    // it is there.\n");
    buf_str(out, c"    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn create_new(path: &str) -> Result<File> {\n        open_c(path, O_RDWR | crate::__sys::O_CREAT | crate::__sys::O_EXCL, 0x1b6)\n    }\n\n    // The options to open a file with: `File::options().append(true)`.\n    #[effects()]\n    pub fn options() -> OpenOptions {\n        OpenOptions::new()\n    }\n\n    // Its file descriptor.\n    // std2: changed: File's own (Rust's: std::os::fd::AsRawFd)\n    #[effects()]\n    pub fn as_raw_fd(&self) -> i32 {\n        self.fd\n    }\n\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        let mut b = StatBuf { words: [0u64; 20] };\n        // UNSAFE: C's fstat. SAFETY: b.words as in stat_at.\n        cvt(unsafe { fs_c_fstat(self.fd, &mut b.words[0] as *mut u64) })?;\n        crate::result::Result::Ok(metadata_of(&b))\n    }\n\n    // Its length becomes size (cut, or zeros after).\n    // std2: changed: u64 (MVS: i64)\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn set_len(&self, size: u64) -> Result<()> {\n        if size > i64::MAX as u64 {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        // UNSAFE: C's ftruncate. SAFETY: integers only.\n        cvt(unsafe { fs_c_ftruncate(self.fd, size as i64) })\n    }\n\n    // What the system holds of it, written to the disk.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn sync_all(&self) -> Result<()> {\n        // UNSAFE: C's fsync. SAFETY: an int only.\n        cvt(unsafe { fs_c_fsync(self.fd) })\n    }\n}\n\n// `File { fd: 3 }`.\n// std2: changed: the descriptor only (Rust's adds the path and the mode)\nimpl crate::fmt::Debug for File {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"File\").field(\"fd\", &self.fd).finish()\n    }\n}\n\nimpl Read for File {\n");
    buf_str(out, c"    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Write for File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// A shared File reads and writes too (the OS keeps its position).\nimpl Read for &File {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read((*self).fd, buf)\n    }\n}\n\nimpl Write for &File {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write((*self).fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\n// mvs: File::seek\nimpl Seek for File {\n    fn seek(&mut self, pos: SeekFrom) -> Result<u64> {\n        let (off, whence) = match pos {\n            SeekFrom::Start(o) => {\n                if o > i64::MAX as u64 {\n                    return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n                }\n                (o as i64, 0)\n            }\n            SeekFrom::Current(o) => (o, 1),\n            SeekFrom::End(o) => (o, 2),\n        };\n        // UNSAFE: C's lseek. SAFETY: integers only.\n        let r = unsafe { fs_c_lseek(self.fd, off, whence) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(r as u64)\n    }\n}\n\n// How File::open opens a file, Rust's builder:\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n#[derive(Clone, Debug)]\npub struct OpenOptions {\n    read: bool,\n    write: bool,\n    append: bool,\n    truncate: bool,\n    create: bool,\n    create_new: bool,\n    mode: u32,\n}\n\nimpl OpenOptions {\n    // Every option off (open fails until read, write or append is on).\n    #[effects()]\n    pub fn new() -> OpenOptions {\n");
    buf_str(out, c"        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn read(&mut self, read: bool) -> &mut OpenOptions {\n        self.read = read;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn write(&mut self, write: bool) -> &mut OpenOptions {\n        self.write = write;\n        self\n    }\n\n    // Writes go to the end (write is implied).\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn append(&mut self, append: bool) -> &mut OpenOptions {\n        self.append = append;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {\n        self.truncate = truncate;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create(&mut self, create: bool) -> &mut OpenOptions {\n        self.create = create;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {\n        self.create_new = create_new;\n        self\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    // std2: changed: OpenOptions' own, a u32 (Rust's:\n    // std::os::unix::fs::OpenOptionsExt)\n    #[effects()]\n    pub fn mode(&mut self, mode: u32) -> &mut OpenOptions {\n        self.mode = mode;\n        self\n    }\n\n    // Opens path with these options: InvalidInput (EINVAL) for none of\n    // read, write and append, or a create or truncate without a write, as\n    // Rust's.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn open(&self, path: &str) -> Result<File> {\n");
    buf_str(out, c"        let access = if self.append {\n            (if self.read { O_RDWR } else { O_WRONLY }) | crate::__sys::O_APPEND\n        } else if self.read && self.write {\n            O_RDWR\n        } else if self.write {\n            O_WRONLY\n        } else if self.read {\n            O_RDONLY\n        } else {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        };\n        if !self.write && !self.append && (self.truncate || self.create || self.create_new) {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        if self.append && self.truncate && !self.create_new {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        let creation = if self.create_new {\n            crate::__sys::O_CREAT | crate::__sys::O_EXCL\n        } else {\n            (if self.create { crate::__sys::O_CREAT } else { 0 })\n                | (if self.truncate { crate::__sys::O_TRUNC } else { 0 })\n        };\n        open_c(path, access | creation, self.mode)\n    }\n}\n\n// What stat says of a file.\n#[derive(Clone)]\npub struct Metadata {\n    mode: u32,\n    size: u64,\n    mtime: i64,\n    mtime_nsec: i64,\n}\n\nimpl Metadata {\n    // The size in bytes.\n    #[effects()]\n    pub fn len(&self) -> u64 {\n        self.size\n    }\n\n    #[effects()]\n    pub fn file_type(&self) -> FileType {\n        FileType { fmt: self.mode & S_IFMT }\n    }\n\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.mode & S_IFMT == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.mode & S_IFMT == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.mode & S_IFMT == S_IFLNK\n    }\n\n    #[effects()]\n    pub fn permissions(&self) -> Permissions {\n        Permissions { mode: self.mode }\n    }\n\n    // When it was last written (UNIX_EPOCH for a time before it).\n    // mvs: Metadata::modified\n");
    buf_str(out, c"    // std2: changed: an io::Result<SystemTime>, as Rust's (MVS: a\n    // Duration since the epoch)\n    #[effects(panic, diverge)]\n    pub fn modified(&self) -> Result<SystemTime> {\n        let epoch = crate::time::UNIX_EPOCH;\n        if self.mtime < 0 {\n            return crate::result::Result::Ok(epoch);\n        }\n        let d = crate::time::Duration::new(self.mtime as u64, self.mtime_nsec as u32);\n        match epoch.checked_add(d) {\n            Option::Some(t) => crate::result::Result::Ok(t),\n            Option::None => crate::result::Result::Ok(epoch),\n        }\n    }\n}\n\n// `Metadata { file_type: .., len: 6, .. }`.\n// std2: changed: the kind and the length (Rust's adds the permissions and\n// the times)\nimpl crate::fmt::Debug for Metadata {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Metadata\").field(\"file_type\", &self.file_type()).field(\"len\", &self.size)\n            .finish_non_exhaustive()\n    }\n}\n\n// A file's kind: a directory, a file, a symbolic link (or another).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct FileType {\n    fmt: u32,\n}\n\nimpl FileType {\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.fmt == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.fmt == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.fmt == S_IFLNK\n    }\n}\n\n// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as\n// Rust's.\nimpl crate::fmt::Debug for FileType {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"FileType\").field(\"is_file\", &self.is_file()).field(\"is_dir\", &self.is_dir())\n            .field(\"is_symlink\", &self.is_symlink()).finish_non_exhaustive()\n    }\n}\n\n// A file's permission bits.\n#[derive(Clone, PartialEq, Eq)]\npub struct Permissions {\n    mode: u32,\n}\n\nimpl Permissions {\n");
    buf_str(out, c"    // Whether no one may write it.\n    #[effects()]\n    pub fn readonly(&self) -> bool {\n        self.mode & 0x92 == 0\n    }\n\n    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).\n    // mvs: Metadata::mode\n    // std2: changed: Permissions' own, st_mode as Rust's (Rust's:\n    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)\n    #[effects()]\n    pub fn mode(&self) -> u32 {\n        self.mode\n    }\n}\n\n// ---- Whole files ----\n\n// The bytes of the file at path, in a new Vec on a.\n// std2: changed: an allocator; the path a &str until std::path (Rust's\n// fs::read)\n#[effects(alloc, io, static, panic, diverge, unsafe, A)]\npub fn read_in<A: Allocator>(path: &str, a: A) -> Result<Vec<u8, A>> {\n    let mut f = File::open(path)?;\n    let size = match f.metadata() {\n        crate::result::Result::Ok(m) => m.len() as usize,\n        crate::result::Result::Err(_) => 0,\n    };\n    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);\n    f.read_to_end(&mut v)?;\n    crate::result::Result::Ok(v)\n}\n\n// The text of the file at path, in a new String on a (InvalidData when it\n// is not UTF-8).\n// std2: changed: an allocator; the path a &str until std::path (Rust's\n// fs::read_to_string)\n#[effects(alloc, io, static, panic, diverge, unsafe, A)]\npub fn read_to_string_in<A: Allocator>(path: &str, a: A) -> Result<String<A>> {\n    let mut f = File::open(path)?;\n    let mut s = String::new_in(a);\n    f.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// The file at path holds contents: made, or emptied first.\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, C)]\npub fn write<C: AsRef<[u8]>>(path: &str, contents: C) -> Result<()> {\n    let mut f = File::create(path)?;\n    // (the path call: `contents.as_ref()` where a &[u8] is expected picks\n    // a wrong instance of AsRef for &T, 0.27.5's front gap)\n");
    buf_str(out, c"    f.write_all(AsRef::<[u8]>::as_ref(&contents))\n}\n\n// Copies the file at from to to (made, or emptied), its permission bits\n// too: the bytes copied.\n// std2: changed: the paths &str until std::path; a u64 (MVS: i64)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn copy(from: &str, to: &str) -> Result<u64> {\n    let mut src = File::open(from)?;\n    let m = src.metadata()?;\n    if !m.is_file() {\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n            \"the source path is neither a regular file nor a symlink to a regular file\"));\n    }\n    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,\n        m.mode & 0xfff)?;\n    // UNSAFE: C's fchmod. SAFETY: integers only.\n    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;\n    let mut buf = [0u8; 65536];\n    let mut total: u64 = 0;\n    loop {\n        let n = match src.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        dst.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// What stat says of the file at path (through a symbolic link).\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn metadata(path: &str) -> Result<Metadata> {\n    stat_at(path, true)\n}\n\n// As metadata, of a symbolic link itself.\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn symlink_metadata(path: &str) -> Result<Metadata> {\n    stat_at(path, false)\n}\n\n// Whether something is at path (through a symbolic link): Ok(false) when\n");
    buf_str(out, c"// nothing is, an error when the OS cannot say (Rust's fs::exists).\n// std2: changed: an io::Result<bool>, as Rust's (MVS: a bool); the path a\n// &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn exists(path: &str) -> Result<bool> {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(_) => crate::result::Result::Ok(true),\n        crate::result::Result::Err(e) => {\n            if e.kind() == ErrorKind::NotFound {\n                crate::result::Result::Ok(false)\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn remove_file(path: &str) -> Result<()> {\n    let p = cpath(path)?;\n    // UNSAFE: C's unlink. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_unlink(p.ptr()) })\n}\n\n// Removes the empty directory at path.\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn remove_dir(path: &str) -> Result<()> {\n    let p = cpath(path)?;\n    // UNSAFE: C's rmdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_rmdir(p.ptr()) })\n}\n\n// std2: changed: the paths &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn rename(from: &str, to: &str) -> Result<()> {\n    let a = cpath(from)?;\n    let b = cpath(to)?;\n    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.\n    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })\n}\n\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn create_dir(path: &str) -> Result<()> {\n    let p = cpath(path)?;\n    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })\n}\n\n// Whether path is a directory (through a symbolic link).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n");
    buf_str(out, c"fn is_dir_at(path: &str) -> bool {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(m) => m.is_dir(),\n        crate::result::Result::Err(_) => false,\n    }\n}\n\n// path's parent as Rust's Path::parent has it: \"\" for a relative name,\n// None for the root (or \"\").\n#[effects(panic, diverge)]\nfn parent_of(path: &str) -> Option<&str> {\n    let b = path.as_bytes();\n    let mut end = b.len();\n    while end > 0 && b[end - 1] == 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::None;\n    }\n    while end > 0 && b[end - 1] != 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::Some(&path[..0]);\n    }\n    let mut k = end;\n    while k > 0 && b[k - 1] == 47 {\n        k -= 1;\n    }\n    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }\n}\n\n// Makes the directory at path and those above it that are missing: Ok\n// when it is there (Rust's, step for step).\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn create_dir_all(path: &str) -> Result<()> {\n    if path.is_empty() {\n        return crate::result::Result::Ok(());\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => return crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if e.kind() != ErrorKind::NotFound {\n                return if is_dir_at(path) {\n                    crate::result::Result::Ok(())\n                } else {\n                    crate::result::Result::Err(e)\n                };\n            }\n        }\n    }\n    match parent_of(path) {\n        Option::Some(p) => create_dir_all(p)?,\n        Option::None => {\n            return crate::result::Result::Err(Error::other(\"failed to create whole tree\"));\n        }\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n");
    buf_str(out, c"            if is_dir_at(path) {\n                crate::result::Result::Ok(())\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// Removes the directory at path and all it holds; a symbolic link is\n// removed, not followed.\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn remove_dir_all(path: &str) -> Result<()> {\n    let m = symlink_metadata(path)?;\n    if m.is_symlink() {\n        return remove_file(path);\n    }\n    if !m.is_dir() {\n        return crate::result::Result::Err(Error::from_raw_os_error(20));\n    }\n    remove_tree(path)\n}\n\n// Removes the directory at path and everything under it.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn remove_tree(path: &str) -> Result<()> {\n    let mut dir = read_dir(path)?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        if e.file_type()?.is_dir() {\n            remove_tree(e.path())?;\n        } else {\n            remove_file(e.path())?;\n        }\n    }\n    remove_dir(path)\n}\n\n// ---- Directories ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\n// std2: changed: the path a &str until std::path\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn read_dir(path: &str) -> Result<ReadDir> {\n    let p = cpath(path)?;\n    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.\n    let d = unsafe { fs_c_opendir(p.ptr()) };\n    if d.is_null() {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    let mut root = [0u8; crate::__sys::PATH_MAX];\n    let b = path.as_bytes();\n    let mut i: usize = 0;\n    while i < b.len() {\n        root[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })\n}\n\n");
    buf_str(out, c"// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir {\n    dir: *mut u8,\n    root: [u8; crate::__sys::PATH_MAX],\n    root_len: usize,\n}\n\nimpl Drop for ReadDir {\n    fn drop(&mut self) {\n        // UNSAFE: C's closedir. SAFETY: dir is the DIR * opendir returned,\n        // non-null (read_dir checks), closed once (here).\n        let _ = unsafe { fs_c_closedir(self.dir) };\n    }\n}\n\nimpl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(&mut self) -> Option<Result<DirEntry>> {\n        loop {\n            let mut e = DirEntry {\n                path: [0u8; crate::__sys::PATH_MAX], len: 0, name_at: 0, kind: 0,\n            };\n            // UNSAFE: errno cleared, then C's readdir on the DIR *, and its\n            // struct dirent read through the pointer readdir returns.\n            // SAFETY: errno_location is this thread's errno; dir is open\n            // (Drop closes it, after the last next); a non-null entry is a\n            // struct dirent of this system (its d_type and d_name at the\n            // offsets std::__sys gives), valid until the next readdir of\n            // dir, and d_name is NUL-ended within it: its bytes are copied\n            // out before this returns.\n            let ok = unsafe {\n                *crate::__sys::errno_location() = 0;\n                let d = fs_c_readdir(self.dir);\n                if d.is_null() {\n                    let err = *crate::__sys::errno_location();\n                    if err == 0 {\n                        return Option::None;\n                    }\n                    return Option::Some(crate::result::Result::Err(Error::from_raw_os_error(err)));\n                }\n                e.kind = *d.add(crate::__sys::DIRENT_TYPE);\n                let name = d.add(crate::__sys::DIRENT_NAME);\n                let mut n: usize = 0;\n                while *name.add(n) != 0 {\n                    n += 1;\n");
    buf_str(out, c"                }\n                let nm = crate::slice::from_raw_parts(name, n);\n                if nm == b\".\" || nm == b\"..\" {\n                    continue;\n                }\n                e.fill(&self.root[..self.root_len], nm)\n            };\n            if !ok {\n                return Option::Some(crate::result::Result::Err(Error::new(\n                    ErrorKind::InvalidData,\n                    \"a directory entry's name is not UTF-8 or the path is too long\")));\n            }\n            return Option::Some(crate::result::Result::Ok(e));\n        }\n    }\n}\n\n// A directory's entry: its path (the directory's, then its name), kept\n// inline, and its kind as the directory says it.\npub struct DirEntry {\n    path: [u8; crate::__sys::PATH_MAX],\n    len: usize,\n    name_at: usize,\n    kind: u8,\n}\n\nimpl DirEntry {\n    // root, a \"/\" unless root ends with one, and name: false when it does\n    // not fit or is not UTF-8.\n    #[effects(panic, diverge)]\n    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {\n        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    #[effects(panic, diverge)]\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n");
    buf_str(out, c"        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std2: changed: a &str, a view of the entry, until std::path (Rust's:\n    // a PathBuf; MVS: a PathBuf on an allocator)\n    #[effects(panic, diverge)]\n    pub fn path(&self) -> &str {\n        self.text(0)\n    }\n\n    // Its name.\n    // std2: changed: a &str, a view of the entry, until std::ffi (Rust's:\n    // an OsString; a name that is not UTF-8 is read_dir's InvalidData)\n    #[effects(panic, diverge)]\n    pub fn file_name(&self) -> &str {\n        self.text(self.name_at)\n    }\n\n    // What lstat says of it.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        stat_at(self.path(), false)\n    }\n\n    // Its kind as the directory says it (lstat's when the file system does\n    // not say).\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn file_type(&self) -> Result<FileType> {\n        if self.kind == DT_DIR {\n            crate::result::Result::Ok(FileType { fmt: S_IFDIR })\n        } else if self.kind == DT_REG {\n            crate::result::Result::Ok(FileType { fmt: S_IFREG })\n        } else if self.kind == DT_LNK {\n            crate::result::Result::Ok(FileType { fmt: S_IFLNK })\n        } else {\n            crate::result::Result::Ok(self.metadata()?.file_type())\n        }\n    }\n}\n// ---- end mod std::fs ----\n}\n// ---- mod std::env ----\npub mod env {\n// EDITION: rust\n// std::env: the program's arguments and environment, Rust's names. The\n// arguments are views of argv, valid for the whole program (no\n// allocation); a variable's value is copied onto an allocator (`var_in`),\n// since the environment can change under a view. argv comes from the\n// target's system, std::__sys (std2/rt/sys_macos.vl, sys_linux.vl).\n// mvs: std::env\n\nuse crate::alloc::Allocator;\nuse crate::fmt::{Debug, Display, Formatter};\n");
    buf_str(out, c"use crate::iter::{DoubleEndedIterator, ExactSizeIterator, Iterator};\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// The i-th of n C strings at argv, its bytes (without the NUL).\nfn arg_bytes(argv: *const *const u8, n: usize, i: usize) -> &'static [u8] {\n    if i >= n {\n        crate::panic::panic(\"env: argument index out of bounds\");\n    }\n    // UNSAFE: reads argv[i] and the NUL-ended C string it points to.\n    // SAFETY: i < n = argc (checked); argv[0..argc] are crt's (or the\n    // /proc copy's) NUL-ended strings, kept for the whole program and\n    // never written after main starts.\n    unsafe {\n        let p = *argv.add(i);\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        crate::ptr::slice_parts(p, len)\n    }\n}\n\n// The arguments, the program's name first: `for a in env::args()`,\n// `env::args().skip(1)`. One that is not UTF-8 stops the program (as\n// Rust's); `args_os()` yields bytes.\n// std2: changed: yields &'static str views, not Strings (no allocator)\n#[effects(alloc(extern), io, static, panic, diverge)]\npub fn args() -> Args {\n    let (n, argv) = crate::__sys::args();\n    Args { front: 0, back: n, n: n, argv: argv }\n}\n\n// The arguments as bytes.\n// std2: changed: yields &'static [u8] (Rust: OsString)\n#[effects(alloc(extern), io, static, panic, diverge)]\npub fn args_os() -> ArgsOs {\n    let (n, argv) = crate::__sys::args();\n    ArgsOs { front: 0, back: n, n: n, argv: argv }\n}\n\n// env::args's iterator.\npub struct Args {\n    front: usize,\n    back: usize,\n    n: usize,\n    argv: *const *const u8,\n}\n\nfn arg_str(b: &'static [u8]) -> &'static str {\n    match crate::str::from_utf8(b) {\n        Result::Ok(s) => s,\n        Result::Err(_) => crate::panic::panic(\n            \"env::args: an argument is not UTF-8 (env::args_os yields bytes)\"),\n    }\n}\n\nimpl Iterator for Args {\n");
    buf_str(out, c"    type Item = &'static str;\n\n    fn next(&mut self) -> Option<&'static str> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.front);\n        self.front += 1;\n        Option::Some(arg_str(b))\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let k = self.back - self.front;\n        (k, Option::Some(k))\n    }\n}\n\nimpl DoubleEndedIterator for Args {\n    fn next_back(&mut self) -> Option<&'static str> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        self.back -= 1;\n        Option::Some(arg_str(arg_bytes(self.argv, self.n, self.back)))\n    }\n}\n\nimpl ExactSizeIterator for Args {}\n\nimpl Debug for Args {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let mut l = f.debug_list();\n        let mut i = self.front;\n        while i < self.back {\n            l.entry(&arg_str(arg_bytes(self.argv, self.n, i)));\n            i += 1;\n        }\n        l.finish()\n    }\n}\n\n// env::args_os's iterator.\npub struct ArgsOs {\n    front: usize,\n    back: usize,\n    n: usize,\n    argv: *const *const u8,\n}\n\nimpl Iterator for ArgsOs {\n    type Item = &'static [u8];\n\n    fn next(&mut self) -> Option<&'static [u8]> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        let b = arg_bytes(self.argv, self.n, self.front);\n        self.front += 1;\n        Option::Some(b)\n    }\n\n    fn size_hint(&self) -> (usize, Option<usize>) {\n        let k = self.back - self.front;\n        (k, Option::Some(k))\n    }\n}\n\nimpl DoubleEndedIterator for ArgsOs {\n    fn next_back(&mut self) -> Option<&'static [u8]> {\n        if self.front >= self.back {\n            return Option::None;\n        }\n        self.back -= 1;\n        Option::Some(arg_bytes(self.argv, self.n, self.back))\n    }\n}\n\nimpl ExactSizeIterator for ArgsOs {}\n\n");
    buf_str(out, c"// Why env::var_in failed: the variable is not set, or its value is not\n// UTF-8.\n// std2: changed: NotUnicode has no payload (Rust: the OsString)\n#[derive(Clone, PartialEq, Eq, Debug)]\npub enum VarError {\n    NotPresent,\n    NotUnicode,\n}\n\nimpl Display for VarError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self {\n            VarError::NotPresent => f.write_str(\"environment variable not found\"),\n            VarError::NotUnicode => f.write_str(\"environment variable was not valid unicode\"),\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: POSIX's prototypes (stdlib.h).\nextern \"C\" {\n    #[link_name = \"getenv\"]\n    fn env_c_getenv(name: *const u8) -> *const u8;\n    #[link_name = \"setenv\"]\n    fn env_c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;\n    #[link_name = \"unsetenv\"]\n    fn env_c_unsetenv(name: *const u8) -> i32;\n    #[link_name = \"getcwd\"]\n    fn env_c_getcwd(buf: *mut u8, size: usize) -> *mut u8;\n    #[link_name = \"chdir\"]\n    fn env_c_chdir(path: *const u8) -> i32;\n}\n\n// s and a NUL in buf; false when it does not fit or holds a NUL (or, for\n// a name, is empty or holds `=`: no variable has such a name).\nfn c_string(s: &str, buf: &mut [u8], name: bool) -> bool {\n    let b = s.as_bytes();\n    if b.len() >= buf.len() || (name && b.len() == 0) {\n        return false;\n    }\n    let mut i: usize = 0;\n    while i < b.len() {\n        if b[i] == 0 || (name && b[i] == 61) {\n            return false;\n        }\n        buf[i] = b[i];\n        i += 1;\n    }\n    buf[b.len()] = 0;\n    true\n}\n\n// The value of variable key, as the bytes C's environment holds now.\nfn get_bytes(key: &str) -> Option<&'static [u8]> {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        return Option::None;\n    }\n    // UNSAFE: C's getenv, then a view of the C string it returns.\n");
    buf_str(out, c"    // SAFETY: nb holds a NUL-ended name; getenv's result is null or a\n    // NUL-ended string of the environment, read here before the caller\n    // copies it (set_var and remove_var, which may free it, are unsafe\n    // and their callers promise no reader meanwhile).\n    unsafe {\n        let p = env_c_getenv(&nb[0] as *const u8);\n        if p.is_null() {\n            return Option::None;\n        }\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The value of variable key, copied into a new String on allocator a\n// (Rust's env::var).\n// mvs: get_in\n// std2: changed: the key is a &str\n#[effects(static, panic, diverge, A)]\npub fn var_in<A: Allocator>(key: &str, a: A) -> Result<String<A>, VarError> {\n    match get_bytes(key) {\n        Option::Some(v) => match crate::str::from_utf8(v) {\n            Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n            Result::Err(_) => Result::Err(VarError::NotUnicode),\n        },\n        Option::None => Result::Err(VarError::NotPresent),\n    }\n}\n\n// The value of variable key, its bytes copied into a new Vec on a.\n// std2: changed: the key is a &str, the value a Vec<u8, A> (Rust: OsString)\n#[effects(static, panic, diverge, A)]\npub fn var_os_in<A: Allocator>(key: &str, a: A) -> Option<Vec<u8, A>> {\n    match get_bytes(key) {\n        Option::Some(v) => {\n            let mut out: Vec<u8, A> = Vec::with_capacity_in(v.len(), a);\n            out.extend_from_slice(v);\n            Option::Some(out)\n        }\n        Option::None => Option::None,\n    }\n}\n\n// Sets variable key to value (Rust 2024's `unsafe fn`). Panics on a key\n// that is empty or holds `=` or a NUL, or a value with a NUL (as Rust's),\n// and on a key over 1 KB or a value over 64 KB.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n");
    buf_str(out, c"// UNSAFE: changes the environment (C's setenv), which another thread's\n// getenv may be reading.\n// SAFETY: (the caller's) no other thread reads or writes the environment\n// meanwhile, and no value read from it before (a getenv view) is used\n// after.\n// std2: changed: key and value are &str\npub unsafe fn set_var(key: &str, value: &str) {\n    let mut nb = [0u8; 1024];\n    let mut vb = [0u8; 65536];\n    if !c_string(key, &mut nb[..], true) || !c_string(value, &mut vb[..], false) {\n        crate::panic::panic(\"env::set_var: a key or value that C's environment cannot hold\");\n    }\n    // UNSAFE: C's setenv. SAFETY: two NUL-ended strings; the caller's\n    // promise above.\n    let _ = unsafe { env_c_setenv(&nb[0] as *const u8, &vb[0] as *const u8, 1) };\n}\n\n// Removes variable key (Rust 2024's `unsafe fn`).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n// UNSAFE: as set_var: C's unsetenv.\n// SAFETY: (the caller's) as set_var.\n// std2: changed: the key is a &str\npub unsafe fn remove_var(key: &str) {\n    let mut nb = [0u8; 1024];\n    if !c_string(key, &mut nb[..], true) {\n        crate::panic::panic(\"env::remove_var: a key that C's environment cannot hold\");\n    }\n    // UNSAFE: C's unsetenv. SAFETY: a NUL-ended string; the caller's\n    // promise above.\n    let _ = unsafe { env_c_unsetenv(&nb[0] as *const u8) };\n}\n\n// Every variable, (name, value), each copied into a String on allocator a\n// as the iterator reaches it (Rust's env::vars). A name or value that is\n// not UTF-8 stops the program, as Rust's; an entry without `=` is left\n// out.\n// std2: changed: takes an allocator\n#[effects()]\npub fn vars_in<A: Allocator + Clone>(a: A) -> Vars<A> {\n    Vars { at: 0, a: a }\n}\n\n// env::vars_in's iterator: environ's entries from index at. set_var and\n// remove_var, which change environ, are unsafe: their callers promise no\n// iterator meanwhile.\npub struct Vars<A: Allocator> {\n    at: usize,\n    a: A,\n}\n\n");
    buf_str(out, c"impl<A: Allocator + Clone> Iterator for Vars<A> {\n    type Item = (String<A>, String<A>);\n\n    fn next(&mut self) -> Option<(String<A>, String<A>)> {\n        loop {\n            let kv = match env_entry(self.at) {\n                Option::Some(kv) => kv,\n                Option::None => return Option::None,\n            };\n            self.at += 1;\n            // (from index 1: a name may start with `=`, as Rust's parse)\n            let mut eq: usize = 1;\n            while eq < kv.len() && kv[eq] != 61 {\n                eq += 1;\n            }\n            if eq >= kv.len() {\n                continue;\n            }\n            let (k, v) = match (crate::str::from_utf8(&kv[..eq]),\n                crate::str::from_utf8(&kv[eq + 1..])) {\n                (Result::Ok(k), Result::Ok(v)) => (k, v),\n                _ => crate::panic::panic(\"env::vars_in: a variable is not valid unicode\"),\n            };\n            return Option::Some((String::from_in(k, self.a.clone()),\n                String::from_in(v, self.a.clone())));\n        }\n    }\n}\n\n// The i-th entry of C's environment, `NAME=value`, as its bytes; None\n// past the last.\nfn env_entry(i: usize) -> Option<&'static [u8]> {\n    let env = crate::__sys::environ();\n    // UNSAFE: reads environ[0..=i] and the NUL-ended C string at i.\n    // SAFETY: environ is a null-ended array of NUL-ended strings; the\n    // entries before i were read non-null (the loop stops at the null),\n    // and nothing changes it meanwhile (set_var and remove_var are unsafe:\n    // their callers' promise).\n    unsafe {\n        let mut k: usize = 0;\n        while k < i {\n            if (*env.add(k)).is_null() {\n                return Option::None;\n            }\n            k += 1;\n        }\n        let p = *env.add(i);\n        if p.is_null() {\n            return Option::None;\n        }\n        let mut len: usize = 0;\n        while *p.add(len) != 0 {\n            len += 1;\n        }\n");
    buf_str(out, c"        Option::Some(crate::ptr::slice_parts(p, len))\n    }\n}\n\n// The current working directory, copied into a new String on allocator a\n// (Rust's env::current_dir). Up to 4 KB.\n// std2: changed: a String<A> on an allocator (Rust: a PathBuf)\n// mvs: current_dir_in\n#[effects(alloc(extern), io, static, panic, diverge, unsafe, A)]\npub fn current_dir_in<A: Allocator>(a: A) -> crate::io::Result<String<A>> {\n    let mut buf = [0u8; 4096];\n    // UNSAFE: C's getcwd into buf. SAFETY: buf holds 4096 bytes, the size\n    // given; getcwd writes a NUL-ended path within them or fails (null).\n    let p = unsafe { env_c_getcwd(&mut buf[0] as *mut u8, 4096) };\n    if p.is_null() {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    let mut n: usize = 0;\n    while n < buf.len() && buf[n] != 0 {\n        n += 1;\n    }\n    match crate::str::from_utf8(&buf[..n]) {\n        Result::Ok(s) => Result::Ok(String::from_in(s, a)),\n        Result::Err(_) => Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidData,\n            \"the current directory is not UTF-8\")),\n    }\n}\n\n// Makes path the working directory (Rust's env::set_current_dir).\n// std2: changed: the path is a &str (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn set_current_dir(path: &str) -> crate::io::Result<()> {\n    let mut pb = [0u8; 4096];\n    if !c_string(path, &mut pb[..], false) {\n        return Result::Err(crate::io::Error::new(crate::io::ErrorKind::InvalidInput,\n            \"a path that C cannot hold\"));\n    }\n    // UNSAFE: C's chdir. SAFETY: pb holds a NUL-ended path.\n    if unsafe { env_c_chdir(&pb[0] as *const u8) } != 0 {\n        return Result::Err(crate::io::Error::last_os_error());\n    }\n    Result::Ok(())\n}\n// ---- end mod std::env ----\n}\n// ---- mod std::cli ----\npub mod cli {\n// EDITION: rust\n// std::cli (0.24, docs/design/cli.md, guide cli): a command-line parser,\n");
    buf_str(out, c"// clap's builder without derive (the overview: below the first banner).\n// The rust edition's (0.27.5): names, help and the words parsed are\n// `&'a str` views, so Arg, Command, Matches and CliError carry the\n// lifetime of the text they were given; counts and widths are usize and\n// a short form is a char, as clap's (indices_of's are i64s, as MVS's).\n// mvs: std::cli\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::str::FromStr;\nuse crate::string::String;\nuse crate::vec::Vec;\n\n// ---- Arguments and commands (0.24) ----\n\n// A Command lists its arguments (flags, options with a value,\n// positionals) and subcommands; `cmd.parse(args)`\n// gives the Matches, or a CliError that `cmd.exit(e)` prints with the\n// usage line (exit code 2; 0 for --help and --version).\n//\n//     let cmd = Command::new_in(\"grep\", gpa).version(\"1.0\")\n//         .arg(Arg::flag(\"count\").short('c').help(\"count the matches\"))\n//         .arg(Arg::option(\"max\").short('m').value_name(\"N\").default(\"0\"))\n//         .arg(Arg::positional(\"pattern\").required())\n//         .arg(Arg::positional(\"file\").multiple());\n//     let m = cmd.parse_or_exit(env::args());\n//     let n = m.get_as::<i64>(\"max\").unwrap_or(0);\n//\n// Accepted: `-v`, `-vvv` (m.count), `-abc` (a cluster of short flags;\n// an option in it takes the rest, `-ofile`), `-o FILE`, `--out FILE`,\n// `--out=FILE`, `--` (everything after it is positional), `-` (a\n// positional). An option takes the next argument as its value even when\n// it starts with '-' (`--n -5`). An option given twice keeps both values\n// (m.values; m.get: the last). A positional takes one value, or every one\n// left with `.multiple()`. A subcommand's name ends its parent's\n// arguments; its own follow.\n//\n// (0.25.2) Clap's too: `.global()` (an argument the subcommands accept),\n");
    buf_str(out, c"// `.alias(s)` and `.hide()` (of an Arg and of a Command), `.num_values(n)`\n// (`--overlay PATH COPY`), `.default_missing(s)` (`--stats`,\n// `--stats=x`), `.allow_hyphen_values()` (a positional `-> bool`),\n// `.last()` (the words after `--`), `.conflicts_with(name)` and\n// `Command::subcommand_required()`.\n//\n// Parsing is pure but for its allocation: the definition is on the Gpa\n// given to Command::new_in, the Matches on the Gpa or on the allocator\n// given to parse_in (an arena: `arena_scope(gpa, |a| { let m =\n// cmd.parse_in(args, a)?; .. })`). Help and error text are built in a\n// scoped arena when cmd.exit prints them. Only exit and parse_or_exit do\n// io.\n\nconst FLAG: i64 = 0;\nconst OPTION: i64 = 1;\nconst POSITIONAL: i64 = 2;\n\n// One argument of a command: a flag (`-v`, `--verbose`), an option with a\n// value (`-o FILE`, `--out FILE`, `--out=FILE`) or a positional, made by\n// Arg::flag, Arg::option or Arg::positional; each method returns the\n// changed Arg. Its name is what Matches asks for (`m.flag(\"verbose\")`);\n// a flag's or option's long form is its name unless `.long(..)`.\n#[derive(Clone, Copy)]\npub struct Arg<'a> {\n    name: &'a str,\n    kind: i64,\n    short: char,\n    long: &'a str,\n    help: &'a str,\n    value_name: &'a str,\n    default: &'a str,\n    has_default: bool,\n    required: bool,\n    multiple: bool,\n    // (0.25) the values it takes, `fast|slow` (\"\": any)\n    choices: &'a str,\n    cmd: i64,\n    // (0.25.2) accepted by the subcommands too; its other long names; not\n    // in the help; how many values an option takes; the value of an\n    // option given without one; values starting with '-'; a positional\n    // after `--`; the arguments it cannot be given with\n    global: bool,\n    aliases: Names<'a>,\n    hidden: bool,\n    num_values: i64,\n    missing: &'a str,\n    has_missing: bool,\n    hyphen: bool,\n    last: bool,\n    conflicts: Names<'a>,\n}\n\n");
    buf_str(out, c"// (0.25.2) Up to 4 names (aliases, conflicts), each one or several\n// separated by '|': a plain value of views, no allocation.\n#[derive(Clone, Copy)]\nstruct Names<'a> {\n    a: &'a str,\n    b: &'a str,\n    c: &'a str,\n    d: &'a str,\n    n: i64,\n}\n\nimpl<'a> Names<'a> {\n    fn none() -> Names<'a> {\n        Names { a: \"\", b: \"\", c: \"\", d: \"\", n: 0 }\n    }\n\n    fn put(&mut self, s: &'a str) {\n        if self.n == 0 {\n            self.a = s;\n        } else if self.n == 1 {\n            self.b = s;\n        } else if self.n == 2 {\n            self.c = s;\n        } else if self.n == 3 {\n            self.d = s;\n        } else {\n            crate::panic::panic(\"std::cli: at most 4 alias or conflicts_with calls per Arg or Command (one may list several: \\\"a|b\\\")\");\n        }\n        self.n += 1;\n    }\n\n    fn name_at(self, i: i64) -> &'a str {\n        if i == 0 { self.a } else if i == 1 { self.b } else if i == 2 { self.c } else { self.d }\n    }\n\n    // Whether word is one of them.\n    fn has(self, word: &str) -> bool {\n        for i in 0..self.n {\n            for w in self.name_at(i).split('|') {\n                if w == word {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The distance from word to the nearest of them (64: none).\n    fn nearest(self, word: &str) -> i64 {\n        let mut bd: i64 = 64;\n        for i in 0..self.n {\n            for w in self.name_at(i).split('|') {\n                let d = distance(word, w);\n                if d < bd {\n                    bd = d;\n                }\n            }\n        }\n        bd\n    }\n}\n\nimpl<'a> Arg<'a> {\n    fn make(name: &'a str, kind: i64) -> Arg<'a> {\n        let mut long: &'a str = name;\n        if kind == POSITIONAL {\n            long = \"\";\n        }\n        Arg {\n            name: name, kind: kind, short: '\\0', long: long, help: \"\", value_name: \"\",\n");
    buf_str(out, c"            default: \"\", has_default: false, required: false, multiple: false, choices: \"\",\n            cmd: 0, global: false, aliases: Names::none(), hidden: false, num_values: 1,\n            missing: \"\", has_missing: false, hyphen: false, last: false,\n            conflicts: Names::none(),\n        }\n    }\n\n    // A flag, `--NAME` (and `.short('x')`): m.flag(name), m.count(name).\n    #[effects()]\n    pub fn flag(name: &'a str) -> Arg<'a> {\n        Arg::make(name, FLAG)\n    }\n\n    // An option with a value, `--NAME VALUE` or `--NAME=VALUE`: m.get(name).\n    #[effects()]\n    pub fn option(name: &'a str) -> Arg<'a> {\n        Arg::make(name, OPTION)\n    }\n\n    // A positional argument, in the order of the command's `.arg` calls.\n    #[effects()]\n    pub fn positional(name: &'a str) -> Arg<'a> {\n        Arg::make(name, POSITIONAL)\n    }\n\n    // Its one-letter form, `-c`.\n    // std2: changed: a char, as clap's (MVS: a byte)\n    #[effects()]\n    pub fn short(mut self, c: char) -> Arg<'a> {\n        self.short = c;\n        self\n    }\n\n    // Its long form, `--s`, instead of its name (`\"\"`: none).\n    #[effects()]\n    pub fn long(mut self, s: &'a str) -> Arg<'a> {\n        self.long = s;\n        self\n    }\n\n    // Its line in the help.\n    #[effects()]\n    pub fn help(mut self, s: &'a str) -> Arg<'a> {\n        self.help = s;\n        self\n    }\n\n    // The name of an option's value in the help, `--out <FILE>` (the name\n    // in capitals by default).\n    #[effects()]\n    pub fn value_name(mut self, s: &'a str) -> Arg<'a> {\n        self.value_name = s;\n        self\n    }\n\n    // The value when it is not given (m.get gives it; m.flag stays false).\n    #[effects()]\n    pub fn default(mut self, s: &'a str) -> Arg<'a> {\n        self.default = s;\n        self.has_default = true;\n        self\n    }\n\n    // An error when it is not given.\n    #[effects()]\n    pub fn required(mut self) -> Arg<'a> {\n");
    buf_str(out, c"        self.required = true;\n        self\n    }\n\n    // A positional that takes every value left (m.values).\n    #[effects()]\n    pub fn multiple(mut self) -> Arg<'a> {\n        self.multiple = true;\n        self\n    }\n\n    // (0.25) The values it takes, `\"fast|slow\"`: another is an InvalidValue\n    // error (`try: --mode <fast|slow>`); the help shows them.\n    #[effects()]\n    pub fn choices(mut self, s: &'a str) -> Arg<'a> {\n        self.choices = s;\n        self\n    }\n\n    // (0.25.2) A flag or option of a command that its subcommands accept\n    // too, at any depth, before or after their names (`prog --root D sub`,\n    // `prog sub --root D`); every level's Matches reads it.\n    #[effects()]\n    pub fn global(mut self) -> Arg<'a> {\n        self.global = true;\n        self\n    }\n\n    // (0.25.2) Another long name, `--s` (called again: more; `\"a|b\"`: two);\n    // not in the help; the did-you-mean suggests the Arg's own.\n    #[effects(io, panic, diverge)]\n    pub fn alias(mut self, s: &'a str) -> Arg<'a> {\n        self.aliases.put(s);\n        self\n    }\n\n    // (0.25.2) Accepted, but not in the help (a deprecated spelling).\n    #[effects()]\n    pub fn hide(mut self) -> Arg<'a> {\n        self.hidden = true;\n        self\n    }\n\n    // (0.25.2) An option taking n values, `--overlay PATH COPY`: m.values\n    // gives them in order, n more each time it is given; fewer is a\n    // MissingValue error. Their names in the help: `.value_name(\"PATH\n    // COPY\")`.\n    // std2: changed: a usize (MVS: i64)\n    #[effects()]\n    pub fn num_values(mut self, n: usize) -> Arg<'a> {\n        self.num_values = if n < 1 { 1 } else { n as i64 };\n        self\n    }\n\n    // (0.25.2) An option whose value is optional: `--stats` alone gives s,\n    // `--stats=x` (or `-s=x`) gives x; only the `=` form gives it one.\n    #[effects()]\n    pub fn default_missing(mut self, s: &'a str) -> Arg<'a> {\n        self.missing = s;\n");
    buf_str(out, c"        self.has_missing = true;\n        self\n    }\n\n    // (0.25.2) Its values may start with '-': a positional so marked takes\n    // a word starting with '-' that is no option of the command (`grep\n    // '-> bool'`). (An option takes its next argument as its value\n    // anyway.)\n    #[effects()]\n    pub fn allow_hyphen_values(mut self) -> Arg<'a> {\n        self.hyphen = true;\n        self\n    }\n\n    // (0.25.2) A positional that takes only the words after `--`: `probe\n    // FILE:LINE EXPR... -- ARGS...` (EXPR multiple, ARGS multiple and\n    // last).\n    #[effects()]\n    pub fn last(mut self) -> Arg<'a> {\n        self.last = true;\n        self\n    }\n\n    // (0.25.2) Given together with the argument named name (either way\n    // round) is an ArgumentConflict error. Called again: more names.\n    #[effects(io, panic, diverge)]\n    pub fn conflicts_with(mut self, name: &'a str) -> Arg<'a> {\n        self.conflicts.put(name);\n        self\n    }\n\n    // Whether it is called word on the command line (`--word`).\n    fn long_is(self, word: &str) -> bool {\n        self.kind != POSITIONAL && (self.long.len() as i64 > 0 && self.long == word\n            || self.aliases.has(word))\n    }\n}\n\n// Whether v is one of choices (`fast|slow`; \"\": any).\nfn chosen(v: &str, choices: &str) -> bool {\n    if choices.len() as i64 == 0 {\n        return true;\n    }\n    for c in choices.split('|') {\n        if c == v {\n            return true;\n        }\n    }\n    false\n}\n\n// A command of the tree: its subcommands are those whose parent it is.\n#[derive(Clone, Copy)]\nstruct Cmd<'a> {\n    name: &'a str,\n    about: &'a str,\n    version: &'a str,\n    parent: i64,\n    // (0.25.2) its other names; not in the help; no subcommand an error\n    aliases: Names<'a>,\n    hidden: bool,\n    sub_required: bool,\n}\n\n// A program's command line: its name, arguments and subcommands. The\n");
    buf_str(out, c"// tree is kept flat, every command in `cmds` (the first is this one) and\n// every argument in `args` with its command's index.\npub struct Command<'a, CA: Allocator> {\n    cmds: Vec<Cmd<'a>, CA>,\n    args: Vec<Arg<'a>, CA>,\n    width: i64,\n    // (0.25: any allocator, an arena too; before, the Gpa)\n    alloc: CA,\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // A command named name, its definition on allocator a (the Gpa, or an\n    // arena: 0.25).\n    #[effects(io, panic, diverge, CA)]\n    pub fn new_in(name: &'a str, a: CA) -> Command<'a, CA> {\n        let mut cmds: Vec<Cmd<'a>, CA> = Vec::new_in(a.clone());\n        cmds.push(Cmd {\n            name: name, about: \"\", version: \"\", parent: -1, aliases: Names::none(),\n            hidden: false, sub_required: false,\n        });\n        Command { cmds: cmds, args: Vec::new_in(a.clone()), width: 80, alloc: a }\n    }\n\n    // The help's line under the name.\n    #[effects(panic, CA)]\n    pub fn about(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].about = s;\n        self\n    }\n\n    // Its version: `--version` (and `-V`) print `NAME VERSION`.\n    #[effects(panic, CA)]\n    pub fn version(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].version = s;\n        self\n    }\n\n    // The help's width in columns (80).\n    // std2: changed: a usize (MVS: i64)\n    #[effects()]\n    pub fn width(mut self, n: usize) -> Command<'a, CA> {\n        self.width = n as i64;\n        self\n    }\n\n    // (0.25.2) Another name of this subcommand (called again: more;\n    // `\"a|b\"`: two); m.subcommand() gives its own name.\n    #[effects(io, panic, diverge)]\n    pub fn alias(mut self, s: &'a str) -> Command<'a, CA> {\n        self.cmds[0].aliases.put(s);\n        self\n    }\n\n    // (0.25.2) A subcommand accepted, but not in its parent's help.\n    #[effects(panic, CA)]\n    pub fn hide(mut self) -> Command<'a, CA> {\n        self.cmds[0].hidden = true;\n");
    buf_str(out, c"        self\n    }\n\n    // (0.25.2) No subcommand given is a MissingSubcommand error (its try:\n    // line names them).\n    #[effects(panic, CA)]\n    pub fn subcommand_required(mut self) -> Command<'a, CA> {\n        self.cmds[0].sub_required = true;\n        self\n    }\n\n    // Adds an argument.\n    #[effects(io, panic, diverge, CA)]\n    pub fn arg(mut self, a: Arg<'a>) -> Command<'a, CA> {\n        let mut x = a;\n        x.cmd = 0;\n        self.args.push(x);\n        self\n    }\n\n    // Adds a subcommand: `prog NAME ...`, m.subcommand().\n    #[effects(io, panic, diverge, CA)]\n    pub fn subcommand(mut self, sub: Command<'a, CA>) -> Command<'a, CA> {\n        let base = self.cmds.len() as i64;\n        for i in 0..sub.cmds.len() as i64 {\n            let mut c = sub.cmds[i as usize];\n            c.parent = if c.parent < 0 { 0 } else { c.parent + base };\n            self.cmds.push(c);\n        }\n        for i in 0..sub.args.len() as i64 {\n            let mut a = sub.args[i as usize];\n            a.cmd = a.cmd + base;\n            self.args.push(a);\n        }\n        self\n    }\n\n    // The subcommand of c named name, or -1.\n    fn sub_named(&self, c: i64, name: &str) -> i64 {\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c\n                && (self.cmds[i as usize].name == name || self.cmds[i as usize].aliases.has(name)) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Whether argument a is one of command c's: its own, or a\n    // global one of c's parent, grandparent...\n    fn of_cmd(&self, a: Arg<'a>, c: i64) -> bool {\n        if a.cmd == c {\n            return true;\n        }\n        if !a.global || a.kind == POSITIONAL {\n            return false;\n        }\n        let mut p = self.cmds[c as usize].parent;\n        while p >= 0 {\n            if p == a.cmd {\n                return true;\n            }\n");
    buf_str(out, c"            p = self.cmds[p as usize].parent;\n        }\n        false\n    }\n\n    // The command of Matches level `level`.\n    fn cmds_of<A: Allocator + Clone>(&self, level: i64, m: &Matches<'a, A>) -> i64 {\n        m.cmds[level as usize]\n    }\n\n    fn has_subs(&self, c: i64) -> bool {\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c {\n                return true;\n            }\n        }\n        false\n    }\n}\n\n// ---- Parsing (0.24) ----\n\n// What went wrong, or what was asked instead of a run: --help and\n// --version are CliErrors too, whose exit code is 0.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum CliErrorKind {\n    Help,\n    Version,\n    UnknownOption,\n    UnknownCommand,\n    UnexpectedArgument,\n    MissingValue,\n    FlagValue,\n    MissingRequired,\n    InvalidValue,\n    // (0.25) a program's own: CliError::custom\n    Custom,\n    // (0.25.2) no subcommand given to a Command::subcommand_required\n    MissingSubcommand,\n    // (0.25.2) two arguments given that Arg::conflicts_with keeps apart\n    ArgumentConflict,\n}\n\n// An error of parse (or Matches::get_as): Display gives its two lines,\n// `error: ...` and `try: ...`; cmd.exit(e) prints them with the usage line\n// (or the help, the version) and exits with e.exit_code().\n#[derive(Clone, Copy)]\npub struct CliError<'a> {\n    pub kind: CliErrorKind,\n    // the argument as given ('--outt', '-vx', the bad value)\n    pub text: &'a str,\n    // the command it is about (cmd.render_in prints its usage)\n    cmd: i64,\n    // an unknown short option inside a cluster (`-x` of `-vx`)\n    short: char,\n    // the argument it is about\n    arg: Arg<'a>,\n    // did you mean: a long option (`--` before it) or a command\n    hint: &'a str,\n    hint_long: bool,\n    // (0.25.2) ArgumentConflict: the other argument as given (`other_short`:\n    // a letter of a cluster)\n    other: &'a str,\n    other_short: char,\n}\n\n");
    buf_str(out, c"impl<'a> CliError<'a> {\n    fn new(kind: CliErrorKind, cmd: i64, text: &'a str) -> CliError<'a> {\n        CliError {\n            kind: kind, text: text, cmd: cmd, short: '\\0', arg: Arg::make(\"\", FLAG), hint: \"\",\n            hint_long: false, other: \"\", other_short: '\\0',\n        }\n    }\n\n    fn of(kind: CliErrorKind, cmd: i64, text: &'a str, a: Arg<'a>) -> CliError<'a> {\n        let mut e = CliError::new(kind, cmd, text);\n        e.arg = a;\n        e\n    }\n\n    // (0.25) A program's own error, in std::cli's form: `error: MESSAGE`,\n    // `try: TRY` (none when \"\"), then the usage line (cmd.exit(e), exit\n    // code 2): `CliError::custom(\"-b and -t together\", \"-b FILE\")`.\n    #[effects()]\n    pub fn custom(message: &'a str, try_line: &'a str) -> CliError<'a> {\n        let mut e = CliError::new(CliErrorKind::Custom, 0, message);\n        e.hint = try_line;\n        e\n    }\n\n    // (0.25) The unknown letter of a cluster (`x` of `-vx`), else 0.\n    // std2: changed: a char ('\\0': none; MVS: a byte, 0)\n    #[effects()]\n    pub fn letter(self) -> char {\n        self.short\n    }\n\n    // 0 for --help and --version, else 2 (a usage error, as clap's).\n    #[effects()]\n    pub fn exit_code(self) -> i32 {\n        match self.kind {\n            CliErrorKind::Help => 0,\n            CliErrorKind::Version => 0,\n            _ => 2,\n        }\n    }\n}\n\n// How an argument is written: `--out <FILE>`, `-o <FILE>`, `--verbose`,\n// `<input>`, `<file>...`.\n#[derive(Clone, Copy)]\nstruct Spell<'a> {\n    a: Arg<'a>,\n}\n\nimpl Display for Spell<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let a = self.a;\n        if a.kind == POSITIONAL {\n            f.write_char('<')?;\n            // (0.25: its value_name, when it has one)\n            f.write_str((if a.value_name.len() as i64 > 0 { a.value_name } else { a.name }))?;\n            f.write_char('>')?;\n            if a.multiple {\n");
    buf_str(out, c"                f.write_str(\"...\")?;\n            }\n            return Ok(());\n        }\n        if a.long.len() as i64 > 0 {\n            f.write_str(\"--\")?;\n            f.write_str(a.long)?;\n        } else {\n            f.write_char('-')?;\n            f.write_char(a.short as char)?;\n        }\n        if a.kind == OPTION {\n            // (0.25.2) an optional value: `--stats[=<STATS>]`\n            f.write_str((if a.has_missing { \"[=\" } else { \" \" }))?;\n            write(f, \"{}\", (ValueName { a: a }))?;\n            if a.has_missing {\n                f.write_char(']')?;\n            }\n        }\n        Ok(())\n    }\n}\n\n// `<FILE>`: an option's value name, or its name in capitals.\n#[derive(Clone, Copy)]\nstruct ValueName<'a> {\n    a: Arg<'a>,\n}\n\nimpl Display for ValueName<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.a.num_values > 1 {\n            // (0.25.2) `<PATH> <COPY>`: value_name's words (the last\n            // repeated), else the name n times\n            let mut k: i64 = 0;\n            let mut last: &str = \"\";\n            for w in self.a.value_name.split(' ') {\n                if w.len() as i64 > 0 && k < self.a.num_values {\n                    if k > 0 {\n                        f.write_char(' ')?;\n                    }\n                    f.write_char('<')?;\n                    f.write_str(w)?;\n                    f.write_char('>')?;\n                    last = w;\n                    k += 1;\n                }\n            }\n            while k < self.a.num_values {\n                if k > 0 {\n                    f.write_char(' ')?;\n                }\n                if last.len() as i64 > 0 {\n                    f.write_char('<')?;\n                    f.write_str(last)?;\n                    f.write_char('>')?;\n                } else {\n                    let mut one = self.a;\n                    one.num_values = 1;\n");
    buf_str(out, c"                    write(f, \"{}\", (ValueName { a: one }))?;\n                }\n                k += 1;\n            }\n            return Ok(());\n        }\n        f.write_char('<')?;\n        if self.a.value_name.len() as i64 > 0 {\n            f.write_str(self.a.value_name)?;\n        } else if self.a.choices.len() as i64 > 0 {\n            f.write_str(self.a.choices)?;\n        } else {\n            for c in self.a.name.bytes() {\n                f.write_char((if c >= b'a' && c <= b'z' { c - 32 } else if c == b'-' { b'_' }\n                    else { c }) as char)?;\n            }\n        }\n        f.write_char('>')?;\n        Ok(())\n    }\n}\n\n// std2: changed: Debug, which `unwrap` needs (MVS's Result had no bound):\n// the kind and the argument as given, `CliError { kind: UnknownOption,\n// text: \"--outt\" }`.\nimpl Debug for CliError<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"CliError { kind: \")?;\n        Debug::fmt(&self.kind, f)?;\n        f.write_str(\", text: \")?;\n        Debug::fmt(self.text, f)?;\n        f.write_str(\" }\")\n    }\n}\n\nimpl Display for CliError<'_> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        let sp = Spell { a: self.arg };\n        match self.kind {\n            CliErrorKind::Help => f.write_str(\"help requested: cmd.exit(e) prints it\")?,\n            CliErrorKind::Version => f.write_str(\"version requested: cmd.exit(e) prints it\")?,\n            CliErrorKind::UnknownOption => {\n                f.write_str(\"error: unknown option '\")?;\n                if self.short != '\\0' {\n                    f.write_char('-')?;\n                    f.write_char(self.short)?;\n                    if self.text.len() as i64 > 2 {\n                        f.write_str(\"' in '\")?;\n                        f.write_str(self.text)?;\n                    }\n                } else {\n                    f.write_str(self.text)?;\n                }\n");
    buf_str(out, c"                f.write_str(\"'\\ntry: \")?;\n                if self.hint.len() as i64 > 0 {\n                    if self.hint_long {\n                        f.write_str(\"--\")?;\n                    }\n                    f.write_str(self.hint)?;\n                } else {\n                    f.write_str(\"--help\")?;\n                }\n            }\n            CliErrorKind::UnknownCommand => {\n                f.write_str(\"error: unknown command '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: \")?;\n                f.write_str((if self.hint.len() as i64 > 0 { self.hint } else { \"--help\" }))?;\n            }\n            CliErrorKind::UnexpectedArgument => {\n                f.write_str(\"error: unexpected argument '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: --help\")?;\n            }\n            CliErrorKind::MissingValue => {\n                f.write_str(\"error: option '\")?;\n                if self.short != '\\0' {\n                    f.write_char('-')?;\n                    f.write_char(self.short)?;\n                } else {\n                    f.write_str(self.text)?;\n                }\n                f.write_str(\"' needs a value\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::FlagValue => {\n                f.write_str(\"error: flag '\")?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"' takes no value\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::MissingRequired => {\n                f.write_str((if self.arg.kind == POSITIONAL { \"error: missing argument '\" }\n                    else { \"error: missing option '\" }))?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"'\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n            CliErrorKind::MissingSubcommand => {\n");
    buf_str(out, c"                // (cmd.render_in names the subcommands)\n                f.write_str(\"error: missing command for '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"'\\ntry: --help\")?;\n            }\n            CliErrorKind::ArgumentConflict => {\n                f.write_str(\"error: '\")?;\n                written(f, self.text, self.short)?;\n                f.write_str(\"' cannot be used with '\")?;\n                written(f, self.other, self.other_short)?;\n                f.write_str(\"'\\ntry: drop '\")?;\n                written(f, self.text, self.short)?;\n                f.write_str(\"' (or '\")?;\n                written(f, self.other, self.other_short)?;\n                f.write_str(\"')\")?;\n            }\n            CliErrorKind::Custom => {\n                f.write_str(\"error: \")?;\n                f.write_str(self.text)?;\n                if self.hint.len() as i64 > 0 {\n                    f.write_str(\"\\ntry: \")?;\n                    f.write_str(self.hint)?;\n                }\n            }\n            CliErrorKind::InvalidValue => {\n                f.write_str(\"error: invalid value '\")?;\n                f.write_str(self.text)?;\n                f.write_str(\"' for '\")?;\n                write(f, \"{}\", sp)?;\n                f.write_str(\"'\\ntry: \")?;\n                write(f, \"{}\", sp)?;\n            }\n        }\n        Ok(())\n    }\n}\n\n// An argument as given: `-c` (short, a letter of a cluster), else text.\nfn written(f: &mut Formatter<'_>, text: &str, short: char) -> crate::fmt::Result {\n    if short != '\\0' {\n        f.write_char('-')?;\n        f.write_char(short)\n    } else {\n        f.write_str(text)\n    }\n}\n\n// The edit distance of a and b: insertions, deletions, substitutions and\n// swaps of two neighbours (`--nmae` is 1 from `--name`); 64 beyond 63\n// bytes.\nfn distance(a: &str, b: &str) -> i64 {\n    let a = a.as_bytes();\n    let b = b.as_bytes();\n");
    buf_str(out, c"    if a.len() as i64 > 63 || b.len() as i64 > 63 {\n        return 64;\n    }\n    let mut prev2: [i64; 64] = [0i64; 64];\n    let mut prev: [i64; 64] = [0i64; 64];\n    let mut cur: [i64; 64] = [0i64; 64];\n    for j in 0..b.len() as i64 + 1 {\n        prev[j as usize] = j;\n    }\n    for i in 1..a.len() as i64 + 1 {\n        cur[0] = i;\n        for j in 1..b.len() as i64 + 1 {\n            let mut best = prev[(j - 1) as usize] + if a[(i - 1) as usize]\n                == b[(j - 1) as usize] { 0 } else { 1 };\n            if prev[j as usize] + 1 < best {\n                best = prev[j as usize] + 1;\n            }\n            if cur[(j - 1) as usize] + 1 < best {\n                best = cur[(j - 1) as usize] + 1;\n            }\n            if i > 1 && j > 1 && a[(i - 1) as usize] == b[(j - 2) as usize]\n                && a[(i - 2) as usize] == b[(j - 1) as usize]\n                && prev2[(j - 2) as usize] + 1 < best {\n                best = prev2[(j - 2) as usize] + 1;\n            }\n            cur[j as usize] = best;\n        }\n        for j in 0..b.len() as i64 + 1 {\n            prev2[j as usize] = prev[j as usize];\n            prev[j as usize] = cur[j as usize];\n        }\n    }\n    prev[b.len() as i64 as usize]\n}\n\n// Whether a candidate at distance d from word is worth suggesting.\nfn near(d: i64, word: &str) -> bool {\n    let most: i64 = if word.len() as i64 / 3 > 1 { word.len() as i64 / 3 } else { 1 };\n    d <= most\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // The long option of c nearest to word (its own name, when an alias\n    // is the nearest), or \"\".\n    fn near_long(&self, c: i64, word: &str) -> &'a str {\n        let mut best: &'a str = \"\";\n        let mut bd: i64 = 64;\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if self.of_cmd(a, c) && a.kind != POSITIONAL && !a.hidden && a.long.len() as i64 > 0 {\n");
    buf_str(out, c"                let mut d = distance(word, a.long);\n                let da = a.aliases.nearest(word);\n                if da < d {\n                    d = da;\n                }\n                if d < bd {\n                    bd = d;\n                    best = a.long;\n                }\n            }\n        }\n        let builtin: [&str; 2] = [\"help\", \"version\"];\n        for k in 0..2 {\n            if k == 1 && self.cmds[c as usize].version.len() as i64 == 0 {\n                continue;\n            }\n            let d = distance(word, builtin[k as usize]);\n            if d < bd {\n                bd = d;\n                best = builtin[k as usize];\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The subcommand of c nearest to word (by its name or an alias): its\n    // name, or \"\".\n    fn near_sub(&self, c: i64, word: &str) -> &'a str {\n        let mut best: &'a str = \"\";\n        let mut bd: i64 = 64;\n        for i in 1..self.cmds.len() as i64 {\n            if self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden {\n                let mut d = distance(word, self.cmds[i as usize].name);\n                let da = self.cmds[i as usize].aliases.nearest(word);\n                if da < d {\n                    d = da;\n                }\n                if d < bd {\n                    bd = d;\n                    best = self.cmds[i as usize].name;\n                }\n            }\n        }\n        if near(bd, word) { best } else { \"\" }\n    }\n\n    // The argument of c with long form (or alias) name, or -1: c's own\n    // first, then the global ones of the commands above it.\n    fn find_long(&self, c: i64, name: &str) -> i64 {\n        for i in 0..self.args.len() as i64 {\n            if self.args[i as usize].cmd == c && self.args[i as usize].long_is(name) {\n                return i;\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n");
    buf_str(out, c"            let a = self.args[i as usize];\n            if a.cmd != c && a.long_is(name) && self.of_cmd(a, c) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // The argument of c with short form ch, or -1 (as find_long).\n    fn find_short(&self, c: i64, ch: char) -> i64 {\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd == c && a.kind != POSITIONAL && a.short != '\\0' && a.short == ch {\n                return i;\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd != c && a.kind != POSITIONAL && a.short != '\\0' && a.short == ch\n                && self.of_cmd(a, c) {\n                return i;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Whether tok, starting with '-', is an option of c: `--name`\n    // (`--name=v`) or `-x...` whose first letter is one (`-h`, `--help`,\n    // `-V`, `--version` too).\n    fn known(&self, c: i64, tok: &str) -> bool {\n        let b = tok.as_bytes();\n        let versioned = self.cmds[c as usize].version.len() as i64 > 0;\n        if b[1] == b'-' {\n            let body = tok.strip_prefix(\"--\").unwrap();\n            let name = match body.split_once('=') {\n                Option::Some((n, _)) => n,\n                Option::None => body,\n            };\n            return self.find_long(c, name) >= 0 || name == \"help\"\n                || (name == \"version\" && versioned);\n        }\n        self.find_short(c, b[1] as char) >= 0 || tok == \"-h\" || (tok == \"-V\" && versioned)\n    }\n\n    // Parses args (the program's name first, as env::args() gives them),\n    // the Matches on the command's allocator.\n    #[effects(io, panic, diverge, I, CA)]\n    pub fn parse<I: Iterator<Item = &'a str>>(&self, args: I) -> Result<Matches<'a, CA>,\n        CliError<'a>> {\n        self.parse_in(args, self.alloc.clone())\n    }\n\n");
    buf_str(out, c"    // Parses args, the Matches on allocator a.\n    #[effects(io, panic, diverge, I, CA, A)]\n    pub fn parse_in<I: Iterator<Item = &'a str>, A: Allocator + Clone>(&self, args: I, a: A)\n        -> Result<Matches<'a, A>, CliError<'a>> {\n        let mut it = args;\n        let _ = it.next();\n        let mut m: Matches<'a, A> = Matches {\n            slots: Vec::new_in(a.clone()), marks: Vec::new_in(a.clone()),\n            texts: Vec::new_in(a.clone()), names: Vec::new_in(a.clone()),\n            cmds: Vec::new_in(a.clone()), indices: Vec::new_in(a), level: 0,\n        };\n        // the index of tok among the arguments (the program's name: 0)\n        let mut at: i64 = 0;\n        let mut cur: i64 = 0;\n        m.enter(self, 0i64);\n        let mut npos: i64 = 0;\n        let mut dashdash = false;\n        // the slot an option waits for values in, how many more (0.25.2:\n        // num_values), and how it was written\n        let mut pending: i64 = -1;\n        let mut pending_left: i64 = 0;\n        let mut pending_text: &'a str = \"\";\n        let mut pending_short: char = '\\0';\n        // a required argument missing: reported at the end, so that a\n        // later --help still prints the help\n        let mut late = CliError::new(CliErrorKind::Help, 0, \"\");\n        let mut has_late = false;\n        loop {\n            let tok = match it.next() {\n                Option::Some(t) => t,\n                Option::None => break,\n            };\n            at += 1;\n            if pending >= 0 {\n                m.push(pending, tok, at);\n                pending_left -= 1;\n                if pending_left == 0 {\n                    pending = -1;\n                }\n                continue;\n            }\n            let b = tok.as_bytes();\n            let mut word = dashdash || b.len() as i64 < 2 || b[0] != b'-';\n            if !word && tok != \"--\" {\n                // (0.25.2) a positional that takes values starting with '-'\n");
    buf_str(out, c"                let s = m.positional(npos);\n                word = s >= 0 && m.slots[s as usize].arg.hyphen && !self.known(cur, tok);\n            }\n            if word {\n                // a positional, or a subcommand's name\n                if !dashdash {\n                    let sub = self.sub_named(cur, tok);\n                    if sub >= 0 {\n                        match m.finish(cur) {\n                            Err(e) => if !has_late {\n                                late = e;\n                                has_late = true;\n                            },\n                            Ok(_) => {}\n                        }\n                        cur = sub;\n                        m.enter(self, sub);\n                        npos = 0;\n                        continue;\n                    }\n                }\n                let mut s = m.positional(npos);\n                if dashdash {\n                    // (0.25.2) the words after `--` go to a `last` positional\n                    let l = m.last_positional();\n                    if l >= 0 {\n                        s = if m.slots[l as usize].arg.multiple\n                            || m.slots[l as usize].count == 0 { l } else { -1 };\n                    }\n                }\n                if s >= 0 {\n                    m.given(s, tok, '\\0', at);\n                    m.push(s, tok, at);\n                    if !m.slots[s as usize].arg.multiple {\n                        npos += 1;\n                    }\n                    continue;\n                }\n                if self.has_subs(cur) {\n                    let mut e = CliError::new(CliErrorKind::UnknownCommand, cur, tok);\n                    e.hint = self.near_sub(cur, tok);\n                    return Err(e);\n                }\n                return Err(CliError::new(CliErrorKind::UnexpectedArgument, cur, tok));\n            }\n            if tok == \"--\" {\n                dashdash = true;\n                continue;\n");
    buf_str(out, c"            }\n            if b[1] == b'-' {\n                // --name, --name=value\n                let body = tok.strip_prefix(\"--\").unwrap();\n                let mut name = body;\n                let mut value: &str = \"\";\n                let mut has_value = false;\n                match body.split_once('=') {\n                    Option::Some((n, v)) => {\n                        name = n;\n                        value = v;\n                        has_value = true;\n                    }\n                    Option::None => {}\n                }\n                let shown = if has_value { tok.split_once('=').unwrap().0 } else { tok };\n                let i = self.find_long(cur, name);\n                if i < 0 {\n                    if name == \"help\" {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if name == \"version\" && self.cmds[cur as usize].version.len() as i64 > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, shown);\n                    e.hint = self.near_long(cur, name);\n                    e.hint_long = true;\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                let x = self.args[i as usize];\n                m.given(s, shown, '\\0', at);\n                if x.kind == FLAG {\n                    if has_value {\n                        return Err(CliError::of(CliErrorKind::FlagValue, cur, tok, x));\n                    }\n                    m.flag_at(s, at);\n                } else if has_value {\n                    m.push(s, value, at);\n                    if x.num_values > 1 {\n                        pending = s;\n                        pending_left = x.num_values - 1;\n                        pending_text = shown;\n");
    buf_str(out, c"                        pending_short = '\\0';\n                    }\n                } else if x.has_missing {\n                    m.push(s, x.missing, at);\n                } else {\n                    pending = s;\n                    pending_left = x.num_values;\n                    pending_text = tok;\n                    pending_short = '\\0';\n                }\n                continue;\n            }\n            // -abc: short flags, the last may be an option (-ofile, -o file)\n            let mut j: i64 = 1;\n            while j < b.len() as i64 {\n                let ch = b[j as usize] as char;\n                let i = self.find_short(cur, ch);\n                if i < 0 {\n                    if ch == 'h' {\n                        return Err(CliError::new(CliErrorKind::Help, cur, tok));\n                    }\n                    if ch == 'V' && self.cmds[cur as usize].version.len() as i64 > 0 {\n                        return Err(CliError::new(CliErrorKind::Version, cur, tok));\n                    }\n                    let mut e = CliError::new(CliErrorKind::UnknownOption, cur, tok);\n                    e.short = ch;\n                    // `-verbose` for `--verbose`\n                    if b.len() as i64 > 2 {\n                        let word = tok.strip_prefix(\"-\").unwrap();\n                        if self.find_long(cur, word) >= 0 {\n                            e.hint = self.args[self.find_long(cur, word) as usize].long;\n                        } else {\n                            e.hint = self.near_long(cur, word);\n                        }\n                        e.hint_long = e.hint.len() as i64 > 0;\n                    }\n                    return Err(e);\n                }\n                let s = m.slot_of(i);\n                let x = self.args[i as usize];\n                m.given(s, tok, ch, at);\n                if x.kind == FLAG {\n                    m.flag_at(s, at);\n                    j += 1;\n");
    buf_str(out, c"                    continue;\n                }\n                // (after an ASCII byte: UTF-8)\n                let mut rest = crate::str::from_utf8(&b[(j + 1) as usize..]).unwrap_or(\"\");\n                let mut eq = false;\n                match rest.strip_prefix(\"=\") {\n                    Option::Some(r) => {\n                        rest = r;\n                        eq = true;\n                    }\n                    Option::None => {}\n                }\n                if x.has_missing && !eq {\n                    // (0.25.2) an optional value: only `-s=x` gives one\n                    m.push(s, x.missing, at);\n                    j += 1;\n                    continue;\n                }\n                if rest.len() as i64 > 0 || eq {\n                    m.push(s, rest, at);\n                    if x.num_values > 1 {\n                        pending = s;\n                        pending_left = x.num_values - 1;\n                        pending_text = tok;\n                        pending_short = ch;\n                    }\n                } else {\n                    pending = s;\n                    pending_left = x.num_values;\n                    pending_text = tok;\n                    pending_short = ch;\n                }\n                break;\n            }\n        }\n        if pending >= 0 {\n            let mut e = CliError::of(CliErrorKind::MissingValue, cur, pending_text,\n                m.slots[pending as usize].arg);\n            e.short = pending_short;\n            return Err(e);\n        }\n        if has_late {\n            return Err(late);\n        }\n        if self.cmds[cur as usize].sub_required {\n            return Err(CliError::new(CliErrorKind::MissingSubcommand, cur,\n                self.cmds[cur as usize].name));\n        }\n        m.finish(cur)?;\n        m.finish_globals(cur)?;\n        m.conflicts()?;\n        m.group();\n        // (0.25) the values of arguments with choices\n");
    buf_str(out, c"        for s in 0..m.slots.len() as i64 {\n            let sl = m.slots[s as usize];\n            for k in sl.start..sl.start + sl.len {\n                if !chosen(m.texts[k as usize], sl.arg.choices) {\n                    return Err(CliError::of(CliErrorKind::InvalidValue, self.cmds_of(sl.level, &m),\n                        m.texts[k as usize], sl.arg));\n                }\n            }\n        }\n        Ok(m)\n    }\n}\n\n// ---- Matches (0.24) ----\n\n// An argument of a matched command: how many times it was given, and\n// (after parse) where its values are in Matches.texts.\n#[derive(Clone, Copy)]\nstruct Slot<'a> {\n    level: i64,\n    index: i64,\n    arg: Arg<'a>,\n    count: i64,\n    start: i64,\n    len: i64,\n    // (0.25) where its occurrences are in Matches.marks, after parse\n    pstart: i64,\n    plen: i64,\n    // (0.25.2) how it was last given (`--text`, or the letter of `-bt`) and\n    // where: for an ArgumentConflict\n    wtext: &'a str,\n    wshort: char,\n    wat: i64,\n}\n\n// A global argument, of its command and the subcommands below.\nfn is_global(a: Arg<'_>) -> bool {\n    a.global && a.kind != POSITIONAL\n}\n\n// What parse found: for the command and each subcommand on the line (a\n// level each), every argument's count and values. `m.subcommand()` gives\n// the next level's Matches.\npub struct Matches<'a, A: Allocator> {\n    slots: Vec<Slot<'a>, A>,\n    // (0.25) while parsing, a pair for each value or flag given: its slot\n    // (-1 - slot: a flag, no value) and its index among the arguments (-1:\n    // a default); after, those indices by slot (Slot.pstart)\n    marks: Vec<i64, A>,\n    // the values (after parse: by slot, Slot.start)\n    texts: Vec<&'a str, A>,\n    // each level's command: its name and index\n    names: Vec<&'a str, A>,\n    cmds: Vec<i64, A>,\n    // (after parse) each slot's indices among the arguments (Slot.pstart)\n    indices: Vec<i64, A>,\n    level: i64,\n}\n\n");
    buf_str(out, c"impl<'a, A: Allocator + Clone> Matches<'a, A> {\n    // A new level for command c: a slot for each of its arguments.\n    fn enter<CA: Allocator + Clone>(&mut self, cmd: &Command<'a, CA>, c: i64) {\n        self.level = self.names.len() as i64;\n        self.names.push(cmd.cmds[c as usize].name);\n        self.cmds.push(c);\n        for i in 0..cmd.args.len() as i64 {\n            if cmd.args[i as usize].cmd == c {\n                self.slots.push(Slot {\n                    level: self.level, index: i, arg: cmd.args[i as usize], count: 0, start: 0,\n                    len: 0,\n                    pstart: 0, plen: 0, wtext: \"\", wshort: '\\0', wat: 0,\n                });\n            }\n        }\n    }\n\n    // The slot of argument i (on its command's level: a global argument's\n    // is above the last).\n    fn slot_of(&self, i: i64) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            if self.slots[s as usize].index == i {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // The slot of the k-th positional of the last level (not counting a\n    // `last` one), or -1.\n    fn positional(&self, k: i64) -> i64 {\n        let mut n: i64 = 0;\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level == self.level && sl.arg.kind == POSITIONAL && !sl.arg.last {\n                if n == k {\n                    return s;\n                }\n                n += 1;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) The slot of the last level's `last` positional, or -1.\n    fn last_positional(&self) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level == self.level && sl.arg.kind == POSITIONAL && sl.arg.last {\n                return s;\n            }\n        }\n        -1\n    }\n\n    // (0.25.2) Slot s given as text (short: the letter of a cluster) at\n");
    buf_str(out, c"    // argument index at.\n    fn given(&mut self, s: i64, text: &'a str, short: char, at: i64) {\n        self.slots[s as usize].wtext = text;\n        self.slots[s as usize].wshort = short;\n        self.slots[s as usize].wat = at;\n    }\n\n    // A value of slot s, at argument index at.\n    fn push(&mut self, s: i64, text: &'a str, at: i64) {\n        self.slots[s as usize].count += 1;\n        self.marks.push(s);\n        self.marks.push(at);\n        self.texts.push(text);\n    }\n\n    // A flag of slot s given, at argument index at.\n    fn flag_at(&mut self, s: i64, at: i64) {\n        self.slots[s as usize].count += 1;\n        self.marks.push(-1 - s);\n        self.marks.push(at);\n    }\n\n    // Slot s not given: its default, or an error when it is required.\n    fn absent(&mut self, s: i64, c: i64) -> Result<(), CliError<'a>> {\n        let sl = self.slots[s as usize];\n        if sl.arg.has_default {\n            self.marks.push(s);\n            self.marks.push(-1);\n            self.texts.push(sl.arg.default);\n        } else if sl.arg.required {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        Ok(())\n    }\n\n    // The end of command c's arguments: the defaults, the required ones\n    // (a global argument's at the end, finish_globals).\n    fn finish(&mut self, c: i64) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.level != self.level || sl.count > 0 || is_global(sl.arg) {\n                continue;\n            }\n            self.absent(s, c)?;\n        }\n        Ok(())\n    }\n\n    // (0.25.2) The global arguments not given, on any level (an error is\n    // about c, the last command).\n    fn finish_globals(&mut self, c: i64) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n");
    buf_str(out, c"            if sl.count == 0 && is_global(sl.arg) {\n                self.absent(s, c)?;\n            }\n        }\n        Ok(())\n    }\n\n    // (0.25.2) Two arguments given that conflicts_with keeps apart: an\n    // error naming both as given, the later first.\n    fn conflicts(&self) -> Result<(), CliError<'a>> {\n        for s in 0..self.slots.len() as i64 {\n            let sl = self.slots[s as usize];\n            if sl.count == 0 {\n                continue;\n            }\n            for k in 0..sl.arg.conflicts.n {\n                for name in sl.arg.conflicts.name_at(k).split('|') {\n                    let o = self.find_at(sl.level, name);\n                    if o < 0 {\n                        crate::panic::panic(\n                            \"std::cli: conflicts_with: no argument by that name in this command\");\n                    }\n                    if self.slots[o as usize].count == 0 || o == s {\n                        continue;\n                    }\n                    let mut p = s;\n                    let mut q = o;\n                    if self.slots[o as usize].wat > sl.wat {\n                        p = o;\n                        q = s;\n                    }\n                    let mut e = CliError::of(CliErrorKind::ArgumentConflict,\n                        self.cmds[sl.level as usize], self.slots[p as usize].wtext,\n                        self.slots[p as usize].arg);\n                    e.short = self.slots[p as usize].wshort;\n                    e.other = self.slots[q as usize].wtext;\n                    e.other_short = self.slots[q as usize].wshort;\n                    return Err(e);\n                }\n            }\n        }\n        Ok(())\n    }\n\n    // Each slot's values together, in the order given, and their indices\n    // among the arguments; the first level current.\n    fn group(&mut self) {\n        let n = self.marks.len() as i64 / 2;\n");
    buf_str(out, c"        let mut out: Vec<&'a str, A> = Vec::with_capacity_in(self.texts.len(),\n            self.texts.allocator().clone());\n        for s in 0..self.slots.len() as i64 {\n            self.slots[s as usize].start = out.len() as i64;\n            let mut t: i64 = 0;\n            for k in 0..n {\n                let o = self.marks[(2 * k) as usize];\n                if o >= 0 {\n                    if o == s {\n                        out.push(self.texts[t as usize]);\n                    }\n                    t += 1;\n                }\n            }\n            self.slots[s as usize].len = out.len() as i64 - self.slots[s as usize].start;\n        }\n        self.texts = out;\n        // the indices by slot\n        for s in 0..self.slots.len() as i64 {\n            self.slots[s as usize].pstart = self.indices.len() as i64;\n            for k in 0..n {\n                let o = self.marks[(2 * k) as usize];\n                let at = self.marks[(2 * k + 1) as usize];\n                if at >= 0 && (o == s || o == -1 - s) {\n                    self.indices.push(at);\n                }\n            }\n            self.slots[s as usize].plen = self.indices.len() as i64 - self.slots[s as usize].pstart;\n        }\n        self.level = 0;\n    }\n\n    // The slot of the argument named name on level level (or a global one\n    // of a level above), or -1.\n    fn find_at(&self, level: i64, name: &str) -> i64 {\n        for s in 0..self.slots.len() as i64 {\n            if self.slots[s as usize].level == level && self.slots[s as usize].arg.name == name {\n                return s;\n            }\n        }\n        let mut l = level - 1;\n        while l >= 0 {\n            for s in 0..self.slots.len() as i64 {\n                let sl = self.slots[s as usize];\n                if sl.level == l && is_global(sl.arg) && sl.arg.name == name {\n                    return s;\n                }\n            }\n            l -= 1;\n        }\n        -1\n    }\n\n");
    buf_str(out, c"    // The slot of the argument named name on this level (or a global one\n    // of a command above, 0.25.2).\n    fn find(&self, name: &str) -> i64 {\n        let s = self.find_at(self.level, name);\n        if s >= 0 {\n            return s;\n        }\n        crate::panic::panic(\"std::cli: Matches: no argument by that name in this command (an Arg's name, not its long or short form)\");\n    }\n\n    // (0.25.3) Whether the argument named name is a flag (no value: get,\n    // get_as and values refuse it, cli.kind); an unknown name is not\n    // (find reports it).\n    fn is_flag(&self, name: &str) -> bool {\n        let s = self.find_at(self.level, name);\n        s >= 0 && self.slots[s as usize].arg.kind == FLAG\n    }\n\n    // Whether the argument was given (a default does not count).\n    #[effects(io, panic, diverge)]\n    pub fn flag(&self, name: &str) -> bool {\n        self.slots[self.find(name) as usize].count > 0\n    }\n\n    // How many times it was given: `-vvv` is 3.\n    // std2: changed: a usize (MVS: i64)\n    #[effects(io, panic, diverge)]\n    pub fn count(&self, name: &str) -> usize {\n        self.slots[self.find(name) as usize].count as usize\n    }\n\n    // Its value (the last one given), else its default.\n    #[effects(io, panic, diverge)]\n    pub fn get(&self, name: &str) -> Option<&'a str>\n        requires !self.is_flag(name)\n        else \"cli.kind: m.get(NAME) of a flag, which has no value (it would always be None): read a flag with m.flag(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        if sl.len == 0 {\n            return Option::None;\n        }\n        Option::Some(self.texts[(sl.start + sl.len - 1) as usize])\n    }\n\n    // Every value given, in order (or its default).\n    #[effects(io, panic, diverge)]\n    pub fn values(&self, name: &str) -> &[&'a str]\n        requires !self.is_flag(name)\n");
    buf_str(out, c"        else \"cli.kind: m.values(NAME) of a flag, which has no value (it would always be empty): read a flag with m.flag(NAME), m.count(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        &self.texts.as_slice()[sl.start as usize..(sl.start + sl.len) as usize]\n    }\n\n    // (0.25) Where it was given: the index among the arguments (the\n    // program's name is 0) of each value, in order, or of each time a flag\n    // was given; a default has none. Clap's `indices_of`: the order of\n    // different arguments' values (`-l m x.o -l z`), which `values` does\n    // not keep. (0.27.5) i64s, as MVS's: a program compares them with\n    // its own word indices, and a translation row cannot convert a\n    // slice's elements.\n    #[effects(io, panic, diverge)]\n    pub fn indices_of(&self, name: &str) -> &[i64] {\n        let sl = self.slots[self.find(name) as usize];\n        &self.indices.as_slice()[sl.pstart as usize..(sl.pstart + sl.plen) as usize]\n    }\n\n    // Its value parsed as a T (`m.get_as::<i64>(\"n\")`): an InvalidValue\n    // error naming the argument when it does not parse, MissingRequired\n    // when it has no value (give it a default, or make it required).\n    #[effects(io, panic, diverge, T)]\n    pub fn get_as<T: FromStr>(&self, name: &str) -> Result<T, CliError<'a>>\n        requires !self.is_flag(name)\n        else \"cli.kind: m.get_as(NAME) of a flag, which has no value: read a flag with m.flag(NAME)\"\n        {\n        let sl = self.slots[self.find(name) as usize];\n        let c = self.cmds[self.level as usize];\n        if sl.len == 0 {\n            return Err(CliError::of(CliErrorKind::MissingRequired, c, \"\", sl.arg));\n        }\n        let text = self.texts[(sl.start + sl.len - 1) as usize];\n        match T::from_str(text) {\n            Ok(v) => Ok(v),\n            Err(_) => Err(CliError::of(CliErrorKind::InvalidValue, c, text, sl.arg)),\n        }\n    }\n\n");
    buf_str(out, c"    // The subcommand given, its name, or None.\n    #[effects(panic, A)]\n    pub fn subcommand_name(&self) -> Option<&'a str> {\n        if self.level + 1 < self.names.len() as i64 {\n            return Option::Some(self.names[(self.level + 1) as usize]);\n        }\n        Option::None\n    }\n\n    // The subcommand given: its name and its Matches (a copy), or None.\n    #[effects(io, panic, diverge, A)]\n    pub fn subcommand(&self) -> Option<(&'a str, Matches<'a, A>)> {\n        if self.level + 1 >= self.names.len() as i64 {\n            return Option::None;\n        }\n        let sub = Matches {\n            slots: self.slots.clone(), marks: self.marks.clone(), texts: self.texts.clone(),\n            names: self.names.clone(), cmds: self.cmds.clone(), indices: self.indices.clone(),\n            level: self.level + 1,\n        };\n        Option::Some((self.names[(self.level + 1) as usize], sub))\n    }\n}\n\n// ---- Help and errors (0.24) ----\n\n// Writes text from column col (already there) to width, breaking at\n// spaces; later lines start at column indent.\nfn wrap<A: Allocator>(out: &mut String<A>, text: &str, col: i64, indent: i64, width: i64) {\n    let mut at = col;\n    let mut first = true;\n    for w in text.split(' ') {\n        if w.len() as i64 == 0 {\n            continue;\n        }\n        if !first {\n            if at + 1 + w.len() as i64 > width && at > indent {\n                out.push('\\n');\n                for _ in 0..indent {\n                    out.push(' ');\n                }\n                at = indent;\n            } else {\n                out.push(' ');\n                at += 1;\n            }\n        }\n        out.push_str(w);\n        at += w.len() as i64;\n        first = false;\n    }\n}\n\nimpl<'a, CA: Allocator + Clone> Command<'a, CA> {\n    // `git remote add`: the names from the root to c.\n    fn path_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        let p = self.cmds[c as usize].parent;\n");
    buf_str(out, c"        if p >= 0 {\n            self.path_into(p, out);\n            out.push(' ');\n        }\n        out.push_str(self.cmds[c as usize].name);\n    }\n\n    // `usage: prog [options] --out <FILE> <input> [file]... [command]`\n    fn usage_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        out.push_str(\"usage: \");\n        self.path_into(c, out);\n        out.push_str(\" [options]\");\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if self.of_cmd(a, c) && a.kind == OPTION && a.required && !a.hidden {\n                out.push(' ');\n                write(out, \"{}\", Spell { a: a }).unwrap();\n            }\n        }\n        for i in 0..self.args.len() as i64 {\n            let a = self.args[i as usize];\n            if a.cmd == c && a.kind == POSITIONAL && !a.hidden {\n                out.push(' ');\n                if a.last {\n                    // (0.25.2) `[-- args]...`, `-- <args>...`\n                    if !a.required {\n                        out.push('[');\n                    }\n                    out.push_str(\"-- \");\n                    if a.required {\n                        write(out, \"{}\", Spell { a: a }).unwrap();\n                    } else {\n                        out.push_str(if a.value_name.len() as i64 > 0 { a.value_name }\n                            else { a.name });\n                        out.push(']');\n                        if a.multiple {\n                            out.push_str(\"...\");\n                        }\n                    }\n                } else if a.required {\n                    write(out, \"{}\", Spell { a: a }).unwrap();\n                } else {\n                    out.push('[');\n                    out.push_str(if a.value_name.len() as i64 > 0 { a.value_name } else { a.name });\n                    out.push(']');\n                    if a.multiple {\n                        out.push_str(\"...\");\n                    }\n");
    buf_str(out, c"                }\n            }\n        }\n        if self.has_subs(c) {\n            out.push_str(if self.cmds[c as usize].sub_required { \" <command>\" }\n                else { \" [command]\" });\n        }\n    }\n\n    // (0.25.2) A visible subcommand of c.\n    fn shown_sub(&self, i: i64, c: i64) -> bool {\n        self.cmds[i as usize].parent == c && !self.cmds[i as usize].hidden\n    }\n\n    fn has_shown_subs(&self, c: i64) -> bool {\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                return true;\n            }\n        }\n        false\n    }\n\n    // (0.25.2) A MissingSubcommand's try: line, `prog remote <add|rm>`\n    // (one: `prog remote add`; many: `prog remote --help`).\n    fn try_sub_into<A: Allocator>(&self, c: i64, out: &mut String<A>) {\n        self.path_into(c, out);\n        out.push(' ');\n        let mut n: i64 = 0;\n        let mut len: i64 = 0;\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                n += 1;\n                len += self.cmds[i as usize].name.len() as i64 + 1;\n            }\n        }\n        if n == 0 || len > 48 {\n            out.push_str(\"--help\");\n            return;\n        }\n        if n > 1 {\n            out.push('<');\n        }\n        let mut first = true;\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) {\n                if !first {\n                    out.push('|');\n                }\n                out.push_str(self.cmds[i as usize].name);\n                first = false;\n            }\n        }\n        if n > 1 {\n            out.push('>');\n        }\n    }\n\n    // An argument's left column: `-o, --out <FILE>`, `    --tag`, `<input>`.\n    fn left_into<A: Allocator>(&self, a: Arg<'a>, out: &mut String<A>) {\n        if a.kind == POSITIONAL {\n            write(out, \"{}\", Spell { a: a }).unwrap();\n            return;\n        }\n        if a.short != '\\0' {\n");
    buf_str(out, c"            out.push('-');\n            out.push(a.short);\n            if a.long.len() as i64 > 0 {\n                out.push_str(\", \");\n            }\n        } else {\n            out.push_str(\"    \");\n        }\n        if a.long.len() as i64 > 0 {\n            out.push_str(\"--\");\n            out.push_str(a.long);\n        }\n        if a.kind == OPTION {\n            out.push_str(if a.has_missing { \"[=\" } else { \" \" });\n            write(out, \"{}\", ValueName { a: a }).unwrap();\n            if a.has_missing {\n                out.push(']');\n            }\n        }\n    }\n\n    // The rest of a table's line begun at out[start..] (its left column\n    // written): its help at column col.\n    fn row_end<A: Allocator>(&self, out: &mut String<A>, start: i64, help: &str, default: &str,\n        has_default: bool, col: i64) {\n        let mut at = out.len() as i64 - start;\n        if help.len() as i64 > 0 || has_default {\n            if at + 2 > col {\n                out.push('\\n');\n                at = 0;\n            }\n            while at < col {\n                out.push(' ');\n                at += 1;\n            }\n            wrap(out, help, col, col, self.width);\n            if has_default {\n                if help.len() as i64 > 0 {\n                    out.push(' ');\n                }\n                out.push_str(\"[default: \");\n                out.push_str(default);\n                out.push(']');\n            }\n        }\n        out.push('\\n');\n    }\n\n    // A table's line: name, then its help at column col.\n    fn row<A: Allocator>(&self, out: &mut String<A>, name: &str, help: &str, col: i64) {\n        let start = out.len() as i64;\n        out.push_str(\"  \");\n        out.push_str(name);\n        self.row_end(out, start, help, \"\", false, col);\n    }\n\n    // An argument's line of a table.\n    fn arg_row<A: Allocator>(&self, out: &mut String<A>, x: Arg<'a>, col: i64) {\n        let start = out.len() as i64;\n");
    buf_str(out, c"        out.push_str(\"  \");\n        self.left_into(x, out);\n        self.row_end(out, start, x.help, x.default, x.has_default, col);\n    }\n\n    // The help of command c.\n    fn help_into<A: Allocator + Clone>(&self, c: i64, out: &mut String<A>, a: A) {\n        let cmd = self.cmds[c as usize];\n        self.path_into(c, out);\n        if cmd.version.len() as i64 > 0 {\n            out.push(' ');\n            out.push_str(cmd.version);\n        }\n        out.push('\\n');\n        if cmd.about.len() as i64 > 0 {\n            wrap(out, cmd.about, 0i64, 0i64, self.width);\n            out.push('\\n');\n        }\n        out.push('\\n');\n        self.usage_into(c, out);\n        out.push('\\n');\n        // the left column's width: the widest entry, at most 24\n        let mut left = String::new_in(a);\n        let mut widest: i64 = 13;\n        for i in 0..self.args.len() as i64 {\n            if self.of_cmd(self.args[i as usize], c) && !self.args[i as usize].hidden {\n                left.clear();\n                self.left_into(self.args[i as usize], &mut left);\n                if left.len() as i64 > widest && left.len() as i64 <= 24 {\n                    widest = left.len() as i64;\n                }\n            }\n        }\n        for i in 1..self.cmds.len() as i64 {\n            if self.shown_sub(i, c) && self.cmds[i as usize].name.len() as i64 > widest\n                && self.cmds[i as usize].name.len() as i64 <= 24 {\n                widest = self.cmds[i as usize].name.len() as i64;\n            }\n        }\n        let col = 2 + widest + 2;\n        let mut any = false;\n        for i in 0..self.args.len() as i64 {\n            let x = self.args[i as usize];\n            if x.cmd == c && x.kind == POSITIONAL && !x.hidden {\n                if !any {\n                    out.push_str(\"\\narguments:\\n\");\n                    any = true;\n                }\n                self.arg_row(out, x, col);\n            }\n        }\n");
    buf_str(out, c"        out.push_str(\"\\noptions:\\n\");\n        let mut own_help = false;\n        let mut own_version = false;\n        for i in 0..self.args.len() as i64 {\n            let x = self.args[i as usize];\n            if self.of_cmd(x, c) && x.kind != POSITIONAL && !x.hidden {\n                self.arg_row(out, x, col);\n                if x.long == \"help\" || x.short == 'h' {\n                    own_help = true;\n                }\n                if x.long == \"version\" || x.short == 'V' {\n                    own_version = true;\n                }\n            }\n        }\n        if !own_help {\n            self.row(out, \"-h, --help\", \"print this help\", col);\n        }\n        if !own_version && cmd.version.len() as i64 > 0 {\n            self.row(out, \"-V, --version\", \"print the version\", col);\n        }\n        if self.has_shown_subs(c) {\n            out.push_str(\"\\ncommands:\\n\");\n            for i in 1..self.cmds.len() as i64 {\n                if self.shown_sub(i, c) {\n                    self.row(out, self.cmds[i as usize].name, self.cmds[i as usize].about, col);\n                }\n            }\n        }\n    }\n\n    // The help, on allocator a.\n    #[effects(io, panic, diverge, A)]\n    pub fn help_in<A: Allocator + Clone>(&self, a: A) -> String<A> {\n        let mut out = String::new_in(a.clone());\n        self.help_into(0i64, &mut out, a);\n        out\n    }\n\n    // What cmd.exit(e) prints, on allocator a: the help or the version\n    // line, or e's two lines and the usage line.\n    #[effects(io, panic, diverge, A)]\n    pub fn render_in<A: Allocator + Clone>(&self, e: CliError<'a>, a: A) -> String<A> {\n        let mut out = String::new_in(a.clone());\n        match e.kind {\n            CliErrorKind::Help => self.help_into(e.cmd, &mut out, a),\n            CliErrorKind::Version => {\n                self.path_into(e.cmd, &mut out);\n                out.push(' ');\n");
    buf_str(out, c"                out.push_str(self.cmds[e.cmd as usize].version);\n                out.push('\\n');\n            }\n            CliErrorKind::MissingSubcommand => {\n                out.push_str(\"error: missing command for '\");\n                self.path_into(e.cmd, &mut out);\n                out.push_str(\"'\\ntry: \");\n                self.try_sub_into(e.cmd, &mut out);\n                out.push('\\n');\n                self.usage_into(e.cmd, &mut out);\n                out.push('\\n');\n            }\n            _ => {\n                write(&mut out, \"{}\", e).unwrap();\n                out.push('\\n');\n                self.usage_into(e.cmd, &mut out);\n                out.push('\\n');\n            }\n        }\n        out\n    }\n\n    // Prints what e asks (the help and the version to stdout, an error\n    // to stderr) and ends the program with e.exit_code().\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe, CA)]\n    pub fn exit(&self, e: CliError<'a>) -> ! {\n        let code = e.exit_code();\n        let text = self.render_in(e, self.alloc.clone());\n        if code == 0 {\n            crate::fmt::print(text.as_str());\n        } else {\n            crate::fmt::eprint(text.as_str());\n        }\n        crate::process::exit(code)\n    }\n\n    // parse, and on an error (or --help, --version) cmd.exit(e).\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe, I, CA)]\n    pub fn parse_or_exit<I: Iterator<Item = &'a str>>(&self, args: I) -> Matches<'a, CA> {\n        match self.parse(args) {\n            Ok(m) => m,\n            Err(e) => self.exit(e),\n        }\n    }\n}\n// ---- end mod std::cli ----\n}\n// ---- mod std::process ----\npub mod process {\n// EDITION: rust\n// std::process: running programs, Rust's, through posix_spawnp. A\n// Command keeps its program, its arguments and the variables env_remove\n// names as NUL-ended copies in Vecs on the allocator it was made with\n");
    buf_str(out, c"// (`Command::new_in(p, a)`, Rust's Command::new); argv and envp are built\n// on a clone of it when it runs. `output()`'s bytes go in Vecs on clones\n// of it too.\n// mvs: std::process\n\nuse crate::alloc::Allocator;\nuse crate::clone::Clone;\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::io::{Error, Read, Result, Write};\nuse crate::iter::{IntoIterator, Iterator};\nuse crate::ops::Drop;\nuse crate::option::Option;\nuse crate::vec::Vec;\n\n// UNSAFE: posix_spawn and the C library's process, pipe and signal calls,\n// which take raw pointers.\n// SAFETY: POSIX's prototypes (spawn.h, sys/wait.h, signal.h, unistd.h,\n// fcntl.h, poll.h; fcntl and open variadic, as declared); the file\n// actions, the attributes and the signal set live in words larger than\n// either system's types (SpawnActions, SpawnAttr below).\nextern \"C\" {\n    #[link_name = \"posix_spawnp\"]\n    fn pr_c_spawnp(pid: *mut i32, file: *const u8, actions: *const u64, attr: *const u64,\n        argv: *const *const u8, envp: *const *const u8) -> i32;\n    #[link_name = \"posix_spawn_file_actions_init\"]\n    fn pr_c_actions_init(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawn_file_actions_destroy\"]\n    fn pr_c_actions_destroy(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawn_file_actions_adddup2\"]\n    fn pr_c_actions_adddup2(a: *mut u64, fd: i32, to: i32) -> i32;\n    #[link_name = \"posix_spawnattr_init\"]\n    fn pr_c_attr_init(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawnattr_destroy\"]\n    fn pr_c_attr_destroy(a: *mut u64) -> i32;\n    #[link_name = \"posix_spawnattr_setflags\"]\n    fn pr_c_attr_setflags(a: *mut u64, flags: i16) -> i32;\n    #[link_name = \"posix_spawnattr_setsigdefault\"]\n    fn pr_c_attr_setsigdefault(a: *mut u64, set: *const u64) -> i32;\n    #[link_name = \"sigemptyset\"]\n    fn pr_c_sigemptyset(set: *mut u64) -> i32;\n    #[link_name = \"sigaddset\"]\n    fn pr_c_sigaddset(set: *mut u64, sig: i32) -> i32;\n");
    buf_str(out, c"    #[link_name = \"signal\"]\n    fn pr_c_signal(sig: i32, handler: usize) -> usize;\n    #[link_name = \"waitpid\"]\n    fn pr_c_waitpid(pid: i32, status: *mut i32, options: i32) -> i32;\n    #[link_name = \"kill\"]\n    fn pr_c_kill(pid: i32, sig: i32) -> i32;\n    #[link_name = \"getpid\"]\n    fn pr_c_getpid() -> i32;\n    #[link_name = \"pipe\"]\n    fn pr_c_pipe(fds: *mut i32) -> i32;\n    #[link_name = \"fcntl\"]\n    fn pr_c_fcntl(fd: i32, cmd: i32, ...) -> i32;\n    #[link_name = \"open\"]\n    fn pr_c_open(path: *const u8, flags: i32, ...) -> i32;\n    #[link_name = \"close\"]\n    fn pr_c_close(fd: i32) -> i32;\n    #[link_name = \"poll\"]\n    fn pr_c_poll(fds: *mut PollFd, n: u32, timeout: i32) -> i32;\n    #[link_name = \"exit\"]\n    fn pr_c_exit(code: i32) -> !;\n    #[link_name = \"abort\"]\n    fn pr_c_abort() -> !;\n}\n\nconst SIGINT: i32 = 2;\nconst SIGQUIT: i32 = 3;\nconst SIGKILL: i32 = 9;\nconst SIG_IGN: usize = 1;\nconst SIG_ERR: usize = usize::MAX;\nconst WNOHANG: i32 = 1;\nconst EINTR: i32 = 4;\nconst F_SETFD: i32 = 2;\nconst FD_CLOEXEC: i32 = 1;\nconst O_RDWR: i32 = 2;\nconst POLLIN: i16 = 1;\n// POSIX_SPAWN_SETSIGDEF, the same on macOS and Linux.\nconst SPAWN_SETSIGDEF: i16 = 4;\n\n// struct pollfd, the same on both systems.\n#[repr(C)]\nstruct PollFd {\n    fd: i32,\n    events: i16,\n    revents: i16,\n}\n\n// Closes fd, when it is one (-1: none).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn close_fd(fd: i32) {\n    if fd >= 0 {\n        // UNSAFE: C's close. SAFETY: an int; each caller closes its own\n        // descriptor once.\n        let _ = unsafe { pr_c_close(fd) };\n    }\n}\n\n// A pipe, (read end, write end), both close-on-exec.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn pipe() -> Result<(i32, i32)> {\n    let mut fds = [0i32; 2];\n    // UNSAFE: C's pipe and fcntl. SAFETY: fds is a local [i32; 2], which\n    // pipe fills; F_SETFD takes an int.\n    unsafe {\n");
    buf_str(out, c"        if pr_c_pipe(&mut fds[0] as *mut i32) != 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        pr_c_fcntl(fds[0], F_SETFD, FD_CLOEXEC);\n        pr_c_fcntl(fds[1], F_SETFD, FD_CLOEXEC);\n    }\n    crate::result::Result::Ok((fds[0], fds[1]))\n}\n\n// ---- Stdio ----\n\n// What a child's stdin, stdout or stderr is: this process's (inherit),\n// /dev/null (null), or a pipe to this process (piped).\npub struct Stdio {\n    kind: u8,\n}\n\nconst INHERIT: u8 = 0;\nconst NULL: u8 = 1;\nconst PIPED: u8 = 2;\n// (not set: spawn and status inherit, output pipes stdout and stderr and\n// gives stdin /dev/null, as Rust's)\nconst DEFAULT: u8 = 3;\n\nimpl Stdio {\n    #[effects()]\n    pub fn inherit() -> Stdio {\n        Stdio { kind: INHERIT }\n    }\n\n    #[effects()]\n    pub fn null() -> Stdio {\n        Stdio { kind: NULL }\n    }\n\n    #[effects()]\n    pub fn piped() -> Stdio {\n        Stdio { kind: PIPED }\n    }\n}\n\n// ---- ExitStatus ----\n\n// How a child ended: its exit code, or the signal that ended it (the\n// status waitpid gives).\n#[derive(Clone, Copy, PartialEq, Eq)]\npub struct ExitStatus {\n    status: i32,\n}\n\nimpl ExitStatus {\n    // Whether it exited with 0.\n    #[effects()]\n    pub fn success(&self) -> bool {\n        self.status & 0xffff == 0\n    }\n\n    // Its exit code; None when a signal ended it.\n    #[effects()]\n    pub fn code(&self) -> Option<i32> {\n        if self.status & 0x7f == 0 { Option::Some((self.status >> 8) & 0xff) } else { Option::None }\n    }\n\n    // The signal that ended it.\n    // std2: changed: ExitStatus' own (Rust's: std::os::unix::process::\n    // ExitStatusExt)\n    #[effects()]\n    pub fn signal(&self) -> Option<i32> {\n        let s = self.status & 0x7f;\n        if s != 0 && s != 0x7f { Option::Some(s) } else { Option::None }\n    }\n}\n\n// `exit status: 3`, `signal: 9 (SIGKILL)`, as Rust's.\nimpl Display for ExitStatus {\n    #[effects(panic, diverge)]\n");
    buf_str(out, c"    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.code() {\n            Option::Some(c) => {\n                f.write_str(\"exit status: \")?;\n                Display::fmt(&c, f)\n            }\n            Option::None => match self.signal() {\n                Option::Some(s) => {\n                    f.write_str(\"signal: \")?;\n                    Display::fmt(&s, f)?;\n                    let name = crate::__sys::signal_name(s);\n                    if !name.is_empty() {\n                        f.write_str(\" (\")?;\n                        f.write_str(name)?;\n                        f.write_str(\")\")?;\n                    }\n                    if self.status & 0x80 != 0 {\n                        f.write_str(\" (core dumped)\")?;\n                    }\n                    crate::result::Result::Ok(())\n                }\n                Option::None => {\n                    f.write_str(\"unrecognized wait status: \")?;\n                    Display::fmt(&self.status, f)\n                }\n            },\n        }\n    }\n}\n\n// `ExitStatus(unix_wait_status(256))`, as Rust's.\nimpl Debug for ExitStatus {\n    #[effects(panic, diverge)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"ExitStatus(unix_wait_status(\")?;\n        Display::fmt(&self.status, f)?;\n        f.write_str(\"))\")\n    }\n}\n\n// What output() gives: how the child ended, and what it wrote.\npub struct Output<A: Allocator> {\n    pub status: ExitStatus,\n    pub stdout: Vec<u8, A>,\n    pub stderr: Vec<u8, A>,\n}\n\n// ---- Child ----\n\n// The child's stdin, when it was piped: a writer; dropping it closes it.\npub struct ChildStdin {\n    fd: i32,\n}\n\n// The child's stdout, when it was piped: a reader.\npub struct ChildStdout {\n    fd: i32,\n}\n\n// The child's stderr, when it was piped: a reader.\npub struct ChildStderr {\n    fd: i32,\n}\n\nimpl Drop for ChildStdin {\n    fn drop(&mut self) {\n");
    buf_str(out, c"        close_fd(self.fd);\n    }\n}\n\nimpl Drop for ChildStdout {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Drop for ChildStderr {\n    fn drop(&mut self) {\n        close_fd(self.fd);\n    }\n}\n\nimpl Write for ChildStdin {\n    fn write(&mut self, buf: &[u8]) -> Result<usize> {\n        crate::io::sys_write(self.fd, buf)\n    }\n\n    fn flush(&mut self) -> Result<()> {\n        crate::result::Result::Ok(())\n    }\n}\n\nimpl Read for ChildStdout {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\nimpl Read for ChildStderr {\n    fn read(&mut self, buf: &mut [u8]) -> Result<usize> {\n        crate::io::sys_read(self.fd, buf)\n    }\n}\n\n// A running child, and its piped streams. Dropping it neither waits for\n// it nor ends it, as Rust's.\npub struct Child {\n    pid: i32,\n    status: Option<ExitStatus>,\n    pub stdin: Option<ChildStdin>,\n    pub stdout: Option<ChildStdout>,\n    pub stderr: Option<ChildStderr>,\n}\n\n// Waits for pid (again when a signal interrupts): its status.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn wait_pid(pid: i32) -> Result<i32> {\n    loop {\n        let mut st: i32 = 0;\n        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.\n        let r = unsafe { pr_c_waitpid(pid, &mut st as *mut i32, 0) };\n        if r >= 0 {\n            return crate::result::Result::Ok(st);\n        }\n        let e = Error::last_os_error();\n        if e.raw_os_error() != Option::Some(EINTR) {\n            return crate::result::Result::Err(e);\n        }\n    }\n}\n\nimpl Child {\n    // Its process id.\n    // mvs: Child::id\n    // std2: changed: a u32, as Rust's (MVS: i32)\n    #[effects()]\n    pub fn id(&self) -> u32 {\n        self.pid as u32\n    }\n\n    // Waits for it to end (its stdin closed first, as Rust's).\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n");
    buf_str(out, c"    pub fn wait(&mut self) -> Result<ExitStatus> {\n        self.stdin = Option::None;\n        if let Option::Some(s) = self.status {\n            return crate::result::Result::Ok(s);\n        }\n        let st = ExitStatus { status: wait_pid(self.pid)? };\n        self.status = Option::Some(st);\n        crate::result::Result::Ok(st)\n    }\n\n    // How it ended, when it has: None while it runs.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn try_wait(&mut self) -> Result<Option<ExitStatus>> {\n        if let Option::Some(s) = self.status {\n            return crate::result::Result::Ok(Option::Some(s));\n        }\n        let mut st: i32 = 0;\n        // UNSAFE: C's waitpid. SAFETY: st is a local i32 it writes.\n        let r = unsafe { pr_c_waitpid(self.pid, &mut st as *mut i32, WNOHANG) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        if r == 0 {\n            return crate::result::Result::Ok(Option::None);\n        }\n        let s = ExitStatus { status: st };\n        self.status = Option::Some(s);\n        crate::result::Result::Ok(Option::Some(s))\n    }\n\n    // Sends it SIGKILL (Ok when it has been waited for already, as Rust's).\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    pub fn kill(&mut self) -> Result<()> {\n        if self.status.is_some() {\n            return crate::result::Result::Ok(());\n        }\n        // UNSAFE: C's kill. SAFETY: integers only.\n        if unsafe { pr_c_kill(self.pid, SIGKILL) } != 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(())\n    }\n}\n\n// ---- Command ----\n\n// posix_spawn_file_actions_t, opaque: room for either system's (8 bytes\n// on macOS, 80 on Linux); dropping it destroys it.\nstruct SpawnActions {\n    words: [u64; 16],\n}\n\nimpl Drop for SpawnActions {\n    fn drop(&mut self) {\n");
    buf_str(out, c"        // UNSAFE: C's destroy. SAFETY: initialized by spawn_actions (the\n        // only maker), destroyed once (here).\n        let _ = unsafe { pr_c_actions_destroy(&mut self.words[0] as *mut u64) };\n    }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn spawn_actions() -> Result<SpawnActions> {\n    let mut words = [0u64; 16];\n    // UNSAFE: C's init. SAFETY: words is 128 bytes, more than either\n    // system's type, 8-aligned; it holds no pointer into itself, so it\n    // may move.\n    let r = unsafe { pr_c_actions_init(&mut words[0] as *mut u64) };\n    if r != 0 {\n        return crate::result::Result::Err(Error::from_raw_os_error(r));\n    }\n    crate::result::Result::Ok(SpawnActions { words: words })\n}\n\nimpl SpawnActions {\n    // In the child: `to` becomes a copy of fd.\n    #[effects(alloc(extern), io, static, panic, diverge, unsafe)]\n    fn dup2(&mut self, fd: i32, to: i32) -> Result<()> {\n        // UNSAFE: C adds an action. SAFETY: the actions are initialized.\n        let r = unsafe { pr_c_actions_adddup2(&mut self.words[0] as *mut u64, fd, to) };\n        if r != 0 { crate::result::Result::Err(Error::from_raw_os_error(r)) }\n        else { crate::result::Result::Ok(()) }\n    }\n}\n\n// posix_spawnattr_t, opaque: room for either system's (8 bytes on macOS,\n// 336 on Linux); dropping it destroys it.\nstruct SpawnAttr {\n    words: [u64; 48],\n}\n\nimpl Drop for SpawnAttr {\n    fn drop(&mut self) {\n        // UNSAFE: C's destroy. SAFETY: initialized by sigdefault_attr (the\n        // only maker), destroyed once (here).\n        let _ = unsafe { pr_c_attr_destroy(&mut self.words[0] as *mut u64) };\n    }\n}\n\n// Attributes under which the child starts with SIGINT's and SIGQUIT's\n// default actions, whatever this process's are.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn sigdefault_attr() -> Result<SpawnAttr> {\n    let mut words = [0u64; 48];\n    // sigset_t: 4 bytes on macOS, 128 on Linux\n");
    buf_str(out, c"    let mut set = [0u64; 16];\n    // UNSAFE: C initializes the attributes and the set. SAFETY: words\n    // (384 bytes) and set (128) are larger than either system's types,\n    // 8-aligned, and hold no pointer into themselves.\n    unsafe {\n        let r = pr_c_attr_init(&mut words[0] as *mut u64);\n        if r != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r));\n        }\n        pr_c_sigemptyset(&mut set[0] as *mut u64);\n        pr_c_sigaddset(&mut set[0] as *mut u64, SIGINT);\n        pr_c_sigaddset(&mut set[0] as *mut u64, SIGQUIT);\n        let mut a = SpawnAttr { words: words };\n        let r2 = pr_c_attr_setsigdefault(&mut a.words[0] as *mut u64, &set[0] as *const u64);\n        if r2 != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r2));\n        }\n        let r3 = pr_c_attr_setflags(&mut a.words[0] as *mut u64, SPAWN_SETSIGDEF);\n        if r3 != 0 {\n            return crate::result::Result::Err(Error::from_raw_os_error(r3));\n        }\n        crate::result::Result::Ok(a)\n    }\n}\n\n// The parent's ends of a spawn's pipes (-1: none), closed on drop.\nstruct Ends {\n    fds: [i32; 7],\n}\n\nimpl Drop for Ends {\n    fn drop(&mut self) {\n        let mut i: usize = 0;\n        while i < 7 {\n            close_fd(self.fds[i]);\n            i += 1;\n        }\n    }\n}\n\nimpl Ends {\n    // fds[i], no longer this one's to close.\n    #[effects(panic, diverge)]\n    fn take(&mut self, i: usize) -> i32 {\n        let fd = self.fds[i];\n        self.fds[i] = -1;\n        fd\n    }\n}\n\n// A program to run: its arguments, the variables it does not get, its\n// streams. Each method changes it in place and returns it, as Rust's\n// (`Command::new_in(\"ls\", a).arg(\"-l\").status()?`).\npub struct Command<A: Allocator> {\n    // the program, then each argument, each NUL-ended\n    text: Vec<u8, A>,\n    argc: usize,\n    // env_remove's names, each NUL-ended\n    removed: Vec<u8, A>,\n");
    buf_str(out, c"    stdin: u8,\n    stdout: u8,\n    stderr: u8,\n    foreground: bool,\n    // an argument that held a NUL: spawn's InvalidInput\n    bad: bool,\n}\n\nimpl<A: Allocator + Clone> Command<A> {\n    // Runs program: a path, or a name looked up in PATH.\n    // mvs: Command::new\n    // std2: changed: allocator named (Rust's Command::new)\n    #[effects(alloc, panic, diverge, A)]\n    pub fn new_in(program: &str, a: A) -> Command<A> {\n        let mut c = Command { text: Vec::new_in(a.clone()), argc: 0, removed: Vec::new_in(a),\n            stdin: DEFAULT, stdout: DEFAULT, stderr: DEFAULT, foreground: false, bad: false };\n        c.push_text(program);\n        c\n    }\n\n    #[effects(alloc, panic, diverge, A)]\n    fn push_text(&mut self, s: &str) {\n        let b = s.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            if b[i] == 0 {\n                self.bad = true;\n            }\n            i += 1;\n        }\n        self.text.extend_from_slice(b);\n        self.text.push(0);\n        self.argc += 1;\n    }\n\n    // Adds an argument.\n    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>; MVS: inout)\n    #[effects(alloc, panic, diverge, A)]\n    pub fn arg(&mut self, arg: &str) -> &mut Command<A> {\n        self.push_text(arg);\n        self\n    }\n\n    // Adds each of args.\n    // std2: changed: &mut self, AsRef<str> (Rust's: AsRef<OsStr>; MVS: a\n    // slice)\n    #[effects(alloc, panic, diverge, A, I, S)]\n    pub fn args<I: IntoIterator<Item = S>, S: AsRef<str>>(&mut self, args: I) -> &mut Command<A> {\n        for s in args {\n            // (the path call: AsRef for &T's method call where a &str is\n            // expected is 0.27.5's front gap)\n            self.push_text(AsRef::<str>::as_ref(&s));\n        }\n        self\n    }\n\n    // The child's environment is this process's without key; each call\n    // removes one more.\n    // std2: changed: &mut self, a &str (Rust's: AsRef<OsStr>)\n");
    buf_str(out, c"    #[effects(alloc, panic, diverge, A)]\n    pub fn env_remove(&mut self, key: &str) -> &mut Command<A> {\n        let b = key.as_bytes();\n        let mut i: usize = 0;\n        while i < b.len() {\n            if b[i] == 0 {\n                self.bad = true;\n            }\n            i += 1;\n        }\n        self.removed.extend_from_slice(b);\n        self.removed.push(0);\n        self\n    }\n\n    // Runs it as a shell runs a command in the foreground: while status()\n    // or output() waits for it, this process ignores SIGINT and SIGQUIT\n    // (^C and ^\\ at a terminal, which reach both), and the child starts\n    // with their default actions (`volec run`).\n    // std2: changed: vole's own (MVS's), not Rust's\n    #[effects()]\n    pub fn foreground(&mut self, on: bool) -> &mut Command<A> {\n        self.foreground = on;\n        self\n    }\n\n    #[effects()]\n    pub fn stdin(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stdin = cfg.kind;\n        self\n    }\n\n    #[effects()]\n    pub fn stdout(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stdout = cfg.kind;\n        self\n    }\n\n    #[effects()]\n    pub fn stderr(&mut self, cfg: Stdio) -> &mut Command<A> {\n        self.stderr = cfg.kind;\n        self\n    }\n\n    // Starts it, its streams as set (this process's when not).\n    // std2: changed: &mut self, as Rust's (MVS: self)\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    pub fn spawn(&mut self) -> Result<Child> {\n        self.spawn_with(INHERIT, INHERIT, false)\n    }\n\n    // Runs it and waits for it: how it ended.\n    // std2: changed: &mut self, as Rust's (MVS: self)\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    pub fn status(&mut self) -> Result<ExitStatus> {\n        let fg = self.foreground;\n        let mut c = self.spawn_with(INHERIT, INHERIT, fg)?;\n        let r = c.wait();\n        if fg {\n            restore_signals(c.pid);\n        }\n        r\n    }\n\n");
    buf_str(out, c"    // Runs it with stdout and stderr piped to this process and stdin\n    // /dev/null (each unless set), and waits: how it ended and what it\n    // wrote, in Vecs on clones of the Command's allocator.\n    // mvs: Command::output_in\n    // std2: changed: on the Command's allocator (Rust's output; MVS: an\n    // allocator given)\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    pub fn output(&mut self) -> Result<Output<A>> {\n        let fg = self.foreground;\n        let mut c = self.spawn_with(NULL, PIPED, fg)?;\n        let mut out: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());\n        let mut err: Vec<u8, A> = Vec::new_in(self.text.allocator().clone());\n        c.stdin = Option::None;\n        let a = match c.stdout.take() {\n            Option::Some(s) => s.fd_take(),\n            Option::None => -1,\n        };\n        let b = match c.stderr.take() {\n            Option::Some(s) => s.fd_take(),\n            Option::None => -1,\n        };\n        let got = drain_two(a, b, &mut out, &mut err);\n        close_fd(a);\n        close_fd(b);\n        let st = c.wait();\n        if fg {\n            restore_signals(c.pid);\n        }\n        got?;\n        crate::result::Result::Ok(Output { status: st?, stdout: out, stderr: err })\n    }\n\n    // Starts it: a stream not set is dflt_in (stdin) or dflt_out (stdout\n    // and stderr).\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    fn spawn_with(&mut self, dflt_in: u8, dflt_out: u8, fg: bool) -> Result<Child> {\n        if self.bad {\n            return crate::result::Result::Err(Error::new(crate::io::ErrorKind::InvalidInput,\n                \"nul byte found in provided data\"));\n        }\n        let kinds = [\n            if self.stdin == DEFAULT { dflt_in } else { self.stdin },\n            if self.stdout == DEFAULT { dflt_out } else { self.stdout },\n            if self.stderr == DEFAULT { dflt_out } else { self.stderr },\n        ];\n");
    buf_str(out, c"        // ends.fds: [0..3) the parent's ends, [3..6) the child's, [6] /dev/null\n        let mut ends = Ends { fds: [-1; 7] };\n        let mut acts = spawn_actions()?;\n        let mut k: usize = 0;\n        while k < 3 {\n            if kinds[k] == PIPED {\n                let (r, w) = pipe()?;\n                if k == 0 {\n                    ends.fds[0] = w;\n                    ends.fds[3] = r;\n                } else {\n                    ends.fds[k] = r;\n                    ends.fds[3 + k] = w;\n                }\n                acts.dup2(ends.fds[3 + k], k as i32)?;\n            } else if kinds[k] == NULL {\n                if ends.fds[6] < 0 {\n                    // UNSAFE: C's open. SAFETY: a NUL-ended literal.\n                    let fd = unsafe { pr_c_open(b\"/dev/null\\0\".as_ptr(), O_RDWR) };\n                    if fd < 0 {\n                        return crate::result::Result::Err(Error::last_os_error());\n                    }\n                    // UNSAFE: C's fcntl. SAFETY: an int.\n                    unsafe { pr_c_fcntl(fd, F_SETFD, FD_CLOEXEC) };\n                    ends.fds[6] = fd;\n                }\n                acts.dup2(ends.fds[6], k as i32)?;\n            }\n            k += 1;\n        }\n        let attr = if fg { Option::Some(sigdefault_attr()?) } else { Option::None };\n        let a = self.text.allocator().clone();\n        // argv: a pointer to each NUL-ended string of text, then null\n        let mut argv: Vec<*const u8, A> = Vec::with_capacity_in(self.argc + 1, a.clone());\n        let base = self.text.as_ptr();\n        let mut at: usize = 0;\n        while at < self.text.len() {\n            // UNSAFE: a pointer into text. SAFETY: at < text.len(): in\n            // bounds; text is not changed while argv is used.\n            argv.push(unsafe { base.add(at) });\n            while self.text[at] != 0 {\n                at += 1;\n            }\n            at += 1;\n        }\n        argv.push(crate::ptr::null());\n");
    buf_str(out, c"        let envp = self.envp(a);\n        if fg {\n            ignore_signals();\n        }\n        let mut pid: i32 = 0;\n        let attr_p: *const u64 = match &attr {\n            Option::Some(t) => &t.words[0] as *const u64,\n            Option::None => crate::ptr::null(),\n        };\n        // UNSAFE: C's posix_spawnp.\n        // SAFETY: argv's pointers are text's NUL-ended strings, then null;\n        // envp is null (this process's environ) or environ's strings, then\n        // null; acts is initialized, attr_p null or an initialized attr;\n        // all live past the call.\n        let r = unsafe {\n            pr_c_spawnp(&mut pid as *mut i32, argv[0], &acts.words[0] as *const u64, attr_p,\n                argv.as_ptr(),\n                if envp.is_empty() { crate::__sys::environ() } else { envp.as_ptr() })\n        };\n        if r != 0 {\n            if fg {\n                restore_signals(0);\n            }\n            return crate::result::Result::Err(Error::from_raw_os_error(r));\n        }\n        let stdin = if ends.fds[0] >= 0 { Option::Some(ChildStdin { fd: ends.take(0) }) }\n            else { Option::None };\n        let stdout = if ends.fds[1] >= 0 { Option::Some(ChildStdout { fd: ends.take(1) }) }\n            else { Option::None };\n        let stderr = if ends.fds[2] >= 0 { Option::Some(ChildStderr { fd: ends.take(2) }) }\n            else { Option::None };\n        crate::result::Result::Ok(Child { pid: pid, status: Option::None, stdin: stdin,\n            stdout: stdout, stderr: stderr })\n    }\n\n    // The child's environment when env_remove named a variable: environ's\n    // strings but those, then null; empty (environ itself) when it named\n    // none.\n    #[effects(alloc, io, static, panic, diverge, unsafe, A)]\n    fn envp(&self, a: A) -> Vec<*const u8, A> {\n        let mut out: Vec<*const u8, A> = Vec::new_in(a);\n        if self.removed.is_empty() {\n            return out;\n        }\n");
    buf_str(out, c"        let env = crate::__sys::environ();\n        let mut i: usize = 0;\n        loop {\n            // UNSAFE: environ's i-th pointer and its string.\n            // SAFETY: environ is null-ended; i stops at its null; each\n            // string is NUL-ended and is not changed while this runs\n            // (std2's set_var is unsafe for that reason).\n            let e = unsafe { *env.add(i) };\n            if e.is_null() {\n                break;\n            }\n            let mut keep = true;\n            let mut s: usize = 0;\n            while s < self.removed.len() {\n                let mut n: usize = 0;\n                while self.removed[s + n] != 0 {\n                    n += 1;\n                }\n                // UNSAFE: e's bytes, each read before its NUL.\n                // SAFETY: the loop stops at e's NUL or at the name's end.\n                let same = unsafe {\n                    let mut j: usize = 0;\n                    while j < n && *e.add(j) != 0 && *e.add(j) == self.removed[s + j] {\n                        j += 1;\n                    }\n                    j == n && *e.add(n) == 61\n                };\n                if same {\n                    keep = false;\n                }\n                s += n + 1;\n            }\n            if keep {\n                out.push(e);\n            }\n            i += 1;\n        }\n        out.push(crate::ptr::null());\n        out\n    }\n}\n\nimpl ChildStdout {\n    #[effects()]\n    fn fd_take(self) -> i32 {\n        let fd = self.fd;\n        crate::mem::forget(self);\n        fd\n    }\n}\n\nimpl ChildStderr {\n    #[effects()]\n    fn fd_take(self) -> i32 {\n        let fd = self.fd;\n        crate::mem::forget(self);\n        fd\n    }\n}\n\n// SIGINT's and SIGQUIT's dispositions while a foreground child runs.\nstatic mut SIG_WAS: [usize; 2] = [0, 0];\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn ignore_signals() {\n");
    buf_str(out, c"    // UNSAFE: C's signal, and the static the old dispositions go in.\n    // SAFETY: SIG_IGN is a disposition, not code; SIG_WAS is written here\n    // and read by restore_signals, on the thread that runs the Command\n    // (a foreground Command is run by one thread at a time: volec run).\n    unsafe {\n        SIG_WAS[0] = pr_c_signal(SIGINT, SIG_IGN);\n        SIG_WAS[1] = pr_c_signal(SIGQUIT, SIG_IGN);\n    }\n}\n\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\nfn restore_signals(_pid: i32) {\n    // UNSAFE: C's signal with the dispositions ignore_signals saved.\n    // SAFETY: each is what signal returned (SIG_DFL, SIG_IGN or a handler\n    // of this process, still loaded); SIG_ERR means nothing was changed.\n    unsafe {\n        if SIG_WAS[0] != SIG_ERR {\n            pr_c_signal(SIGINT, SIG_WAS[0]);\n        }\n        if SIG_WAS[1] != SIG_ERR {\n            pr_c_signal(SIGQUIT, SIG_WAS[1]);\n        }\n    }\n}\n\n// Reads the pipes a and b (-1: none) to their ends, into va and vb (poll:\n// neither child stream blocks the other).\n#[effects(alloc, io, static, panic, diverge, unsafe, A)]\nfn drain_two<A: Allocator>(a: i32, b: i32, va: &mut Vec<u8, A>, vb: &mut Vec<u8, A>) -> Result<()> {\n    let mut open_a = a >= 0;\n    let mut open_b = b >= 0;\n    let mut buf = [0u8; 8192];\n    while open_a || open_b {\n        let mut fds = [\n            PollFd { fd: if open_a { a } else { -1 }, events: POLLIN, revents: 0 },\n            PollFd { fd: if open_b { b } else { -1 }, events: POLLIN, revents: 0 },\n        ];\n        // UNSAFE: C's poll. SAFETY: fds is a local array of 2 pollfds.\n        if unsafe { pr_c_poll(&mut fds[0] as *mut PollFd, 2, -1) } < 0 {\n            let e = Error::last_os_error();\n            if e.raw_os_error() == Option::Some(EINTR) {\n                continue;\n            }\n            return crate::result::Result::Err(e);\n        }\n        if open_a && fds[0].revents != 0 {\n");
    buf_str(out, c"            let n = crate::io::sys_read(a, &mut buf)?;\n            va.extend_from_slice(&buf[..n]);\n            open_a = n > 0;\n        }\n        if open_b && fds[1].revents != 0 {\n            let n = crate::io::sys_read(b, &mut buf)?;\n            vb.extend_from_slice(&buf[..n]);\n            open_b = n > 0;\n        }\n    }\n    crate::result::Result::Ok(())\n}\n\n// Ends this process with code (Rust's: no destructors run).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn exit(code: i32) -> ! {\n    // UNSAFE: C's exit. SAFETY: an int; it does not return.\n    unsafe { pr_c_exit(code) }\n}\n\n// Ends this process abnormally (SIGABRT).\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn abort() -> ! {\n    // UNSAFE: C's abort. SAFETY: no arguments; it does not return.\n    unsafe { pr_c_abort() }\n}\n\n// This process's id.\n// std2: changed: a u32, as Rust's (MVS: i32)\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn id() -> u32 {\n    // UNSAFE: C's getpid. SAFETY: no arguments.\n    unsafe { pr_c_getpid() as u32 }\n}\n// ---- end mod std::process ----\n}\n// ---- mod std::thread ----\npub mod thread {\n// EDITION: rust\n// std::thread: scoped threads, spawned threads, and the thread's own\n// queries. `thread::scope` is the safe way to share a borrow with\n// threads: every thread spawned in the scope is joined before it returns,\n// so they may borrow what outlives the scope ('env). It takes no\n// allocator: its threads' records come from C's heap, as Rust's from the\n// global one. `spawn_in(f, a)` runs a 'static closure on a thread\n// of its own, its closure and result kept on a (plan §2: MVS's spawn\n// allocated through C, unnamed). A panic in any thread ends the process\n// with 101 (decision 18), so `join` never returns an Err; it returns a\n// Result anyway, so that `.join().unwrap()` reads as in Rust.\n\nuse crate::alloc::{AllocError, Allocator, Layout};\nuse crate::cell::Cell;\n");
    buf_str(out, c"use crate::fmt::{Debug, Formatter};\nuse crate::marker::PhantomData;\nuse crate::option::Option;\nuse crate::ptr::NonNull;\n\n// UNSAFE: C's heap and POSIX threads, which take raw pointers.\n// SAFETY: the prototypes are stdlib.h's, pthread.h's, sched.h's and\n// unistd.h's (pthread_t as u64, as on macOS and Linux), as MVS's thread.\nextern \"C\" {\n    #[link_name = \"malloc\"]\n    fn thread_c_malloc(n: usize) -> *mut u8;\n    #[link_name = \"free\"]\n    fn thread_c_free(p: *mut u8);\n    #[link_name = \"pthread_create\"]\n    fn thread_c_create(t: *mut u64, attr: *const u8, f: extern \"C\" fn(*mut u8) -> *mut u8,\n        arg: *mut u8) -> i32;\n    #[link_name = \"pthread_join\"]\n    fn thread_c_join(t: u64, ret: *mut u64) -> i32;\n    #[link_name = \"pthread_detach\"]\n    fn thread_c_detach(t: u64) -> i32;\n    #[link_name = \"pthread_attr_init\"]\n    fn thread_c_attr_init(a: *mut u8) -> i32;\n    #[link_name = \"pthread_attr_setstacksize\"]\n    fn thread_c_attr_setstacksize(a: *mut u8, size: usize) -> i32;\n    #[link_name = \"pthread_attr_destroy\"]\n    fn thread_c_attr_destroy(a: *mut u8) -> i32;\n    #[link_name = \"sched_yield\"]\n    fn thread_c_yield() -> i32;\n    #[link_name = \"sysconf\"]\n    fn thread_c_sysconf(name: i32) -> i64;\n}\n\n// Built in: the compiler lowers a std function named atomic_* to the\n// instruction, as MVS's std::sync::atomic (order: 1 Acquire, 2 Release,\n// 3 AcqRel); the bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid, aligned, shared only through\n// atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load.\n// SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n");
    buf_str(out, c"    crate::panic::unreachable()\n}\n\nconst ACQUIRE: i64 = 1;\nconst RELEASE: i64 = 2;\nconst ACQ_REL: i64 = 3;\n\n// _SC_NPROCESSORS_ONLN (macOS's number; 84 on Linux).\nconst SC_NPROCESSORS_ONLN: i32 = 58;\n\n// The stack of a new thread: 8 MiB (macOS's default past the first\n// thread is 512 KiB), as MVS's.\nconst THREAD_STACK: usize = 8388608;\n\n// C's heap, for a scope's records: a scope takes no allocator (Rust's\n// takes its records from the global heap the same way).\n#[derive(Clone, Copy)]\nstruct CHeap {\n    sealed: (),\n}\n\n// UNSAFE: an Allocator impl over C's heap.\n// SAFETY: blocks come from malloc (16-aligned: enough for the records of\n// words, an Option and a closure it holds) and go back to free.\nunsafe impl Allocator for CHeap {\n    fn allocate(&self, layout: Layout) -> crate::result::Result<NonNull<u8>, AllocError> {\n        if layout.align() > 16 {\n            return crate::result::Result::Err(AllocError {});\n        }\n        // UNSAFE: C's malloc.\n        // SAFETY: it takes a size and returns a block or null.\n        let p = unsafe { thread_c_malloc(layout.size()) };\n        match NonNull::new(p) {\n            Option::Some(q) => crate::result::Result::Ok(q),\n            Option::None => crate::result::Result::Err(AllocError {}),\n        }\n    }\n\n    // UNSAFE: gives a block back to C's free.\n    // SAFETY: a contract on the caller (Allocator's): p is a block this\n    // allocator gave, so malloc's.\n    unsafe fn deallocate(&self, p: NonNull<u8>, layout: Layout) {\n        thread_c_free(p.as_ptr());\n    }\n}\n\n// What a thread shares with its handle: its result once done (done is\n// 1 then), and refs, the thread's and the handle's: the last of the two\n// frees it into alloc.\nstruct Out<T, A: Allocator> {\n    result: Option<T>,\n    done: u32,\n    refs: u32,\n    alloc: A,\n}\n\n// The closure, moved to the thread, and where its result goes.\nstruct Packet<F, T, A: Allocator> {\n    f: F,\n    out: *mut Out<T, A>,\n");
    buf_str(out, c"}\n\n// What the thread starts from (C's heap): run(data, this record).\nstruct Start {\n    run: fn(*mut u8, *mut u8),\n    data: *mut u8,\n}\n\n// The thread's first frame (C's convention, what pthread_create takes).\nextern \"C\" fn thread_start(arg: *mut u8) -> *mut u8 {\n    // UNSAFE: the start record through its raw pointer.\n    // SAFETY: arg is the Start start_thread wrote for this thread only;\n    // it is read here and freed by run.\n    unsafe {\n        let s = arg as *mut Start;\n        let run = (*s).run;\n        let data = (*s).data;\n        run(data, arg);\n    }\n    crate::ptr::null_mut::<u8>()\n}\n\n// A record of T's layout from a; out of memory panics.\nfn new_record<T, A: Allocator>(a: &A, x: T) -> *mut T {\n    let p = match a.allocate(Layout::new::<T>()) {\n        crate::result::Result::Ok(p) => p.as_ptr() as *mut T,\n        crate::result::Result::Err(_) => {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg)\n        }\n    };\n    // UNSAFE: x moved into the fresh block.\n    // SAFETY: p is a block of T's layout from a; the write drops nothing.\n    unsafe { crate::ptr::write(p, x) };\n    p\n}\n\n// Gives a record of T's layout back to a (its value moved out already).\n// UNSAFE: deallocates through the allocator.\n// SAFETY: a contract on the caller: p is new_record's block from a.\nunsafe fn free_record<T, A: Allocator>(a: &A, p: *mut T) {\n    match NonNull::new(p as *mut u8) {\n        Option::Some(q) => a.deallocate(q, Layout::new::<T>()),\n        Option::None => {}\n    }\n}\n\n// Drops the result (if any) and frees out into its own allocator.\n// UNSAFE: moves the record out through its raw pointer.\n// SAFETY: a contract on the caller: out is live and nobody uses it after.\nunsafe fn release_out<T, A: Allocator>(out: *mut Out<T, A>) {\n    let o = crate::ptr::read(out as *const Out<T, A>);\n    free_record(&o.alloc, out);\n    crate::mem::drop(o);\n}\n\n");
    buf_str(out, c"// The thread's work: the packet taken and freed, the closure called, its\n// result published, the thread's ref given up.\nfn thread_run<F: FnOnce() -> T, T, A: Allocator>(data: *mut u8, start: *mut u8) {\n    // UNSAFE: the packet, the start record and the result's place through\n    // raw pointers.\n    // SAFETY: data is the Packet start_thread wrote for this thread only:\n    // moved out and freed once; start is freed once into C's heap; out is\n    // live while refs > 0, and this thread holds one ref until its\n    // atomic_sub (AcqRel: the handle's side is ordered before the free).\n    unsafe {\n        let q = data as *mut Packet<F, T, A>;\n        let p = crate::ptr::read(q as *const Packet<F, T, A>);\n        let out = p.out;\n        free_record(&*(&(*out).alloc), q);\n        thread_c_free(start);\n        let r = (p.f)();\n        (*out).result = Option::Some(r);\n        atomic_store(&mut (*out).done as *mut u32, 1, RELEASE);\n        if atomic_sub(&mut (*out).refs as *mut u32, 1, ACQ_REL) == 1 {\n            release_out(out);\n        }\n    }\n}\n\n// Starts a thread running f, its records on a: its pthread_t and its\n// result's place.\nfn start_thread<F: FnOnce() -> T, T, A: Allocator>(f: F, a: A) -> (u64, *mut Out<T, A>) {\n    let out = new_record(&a, Out::<T, A> { result: Option::<T>::None, done: 0, refs: 2, alloc: a });\n    // UNSAFE: the records reached through raw pointers, and pthread_create.\n    // SAFETY: out is live (refs 2); the Packet and the Start go to the new\n    // thread only; attr is 128 bytes, more than a pthread_attr_t.\n    unsafe {\n        let q = new_record(&*(&(*out).alloc), Packet { f: f, out: out });\n        let s = thread_c_malloc(Layout::new::<Start>().size()) as *mut Start;\n        if s.is_null() {\n            let msg: &str = \"memory allocation failed\";\n            crate::panic::panic(msg);\n        }\n        crate::ptr::write(s, Start { run: thread_run::<F, T, A>, data: q as *mut u8 });\n");
    buf_str(out, c"        let mut attr: [u64; 16] = [0; 16];\n        let ap = &mut attr[0] as *mut u64 as *mut u8;\n        thread_c_attr_init(ap);\n        thread_c_attr_setstacksize(ap, THREAD_STACK);\n        let mut t: u64 = 0;\n        let rc = thread_c_create(&mut t as *mut u64, ap as *const u8, thread_start, s as *mut u8);\n        thread_c_attr_destroy(ap);\n        if rc != 0 {\n            let msg: &str = \"failed to spawn thread\";\n            crate::panic::panic(msg);\n        }\n        (t, out)\n    }\n}\n\n// Waits for thread t and takes its result, freeing its place.\n// UNSAFE: pthread_join and the result's place through its raw pointer.\n// SAFETY: a contract on the caller: t is out's thread, not joined or\n// detached yet, and out is not used after.\nunsafe fn join_thread<T, A: Allocator>(t: u64, out: *mut Out<T, A>) -> T {\n    thread_c_join(t, crate::ptr::null_mut::<u64>());\n    let r = crate::mem::replace(&mut *(&mut (*out).result), Option::None);\n    release_out(out);\n    match r {\n        Option::Some(x) => x,\n        Option::None => crate::panic::unreachable(),\n    }\n}\n\n// Whether out's thread has published its result.\n// UNSAFE: an atomic read through the raw pointer.\n// SAFETY: a contract on the caller: out is live.\nunsafe fn finished<T, A: Allocator>(out: *mut Out<T, A>) -> bool {\n    atomic_load(&(*out).done as *const u32, ACQUIRE) == 1\n}\n\n// A thread of a scope, in its list: joined when the scope ends unless its\n// handle joined it.\nstruct ScopeNode {\n    native: u64,\n    joined: bool,\n    out: *mut u8,\n    join: fn(u64, *mut u8),\n    next: *mut ScopeNode,\n}\n\n// A scope node's join, erased: the thread joined and its result dropped.\n// Private, and called only by scope's end with its own node's pair.\nfn scope_join<T>(t: u64, out: *mut u8) {\n    // UNSAFE: the result's place through an erased pointer.\n    // SAFETY: the pair is one node's: out is the Out<T, CHeap> of thread\n");
    buf_str(out, c"    // t, not joined yet (the node is not marked joined).\n    crate::mem::drop(unsafe { join_thread(t, out as *mut Out<T, CHeap>) });\n}\n\n// join's result: never an Err in vole (a panic exits the process).\npub type Result<T> = crate::result::Result<T, JoinError>;\n\n// A thread's panic, as join would report it: no value is ever made.\npub struct JoinError {\n    never: crate::convert::Infallible,\n}\n\nimpl Debug for JoinError {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        match self.never {}\n    }\n}\n\n// Runs f with a Scope, joins every thread spawned in it, and returns f's\n// value. Each region in f's argument is elided, so it is late-bound (no\n// `for<'a>`, cut to 0.29): the scope's region 'scope cannot be named\n// outside f, and Scope is invariant in it, so a thread cannot borrow a\n// local of f's body (plan §4, threads).\n// std2: changed: FnOnce(&Scope<'_, 'env>) (MVS: FnMut(inout Scope))\n#[effects(alloc(CHeap), diverge, unsafe, F)]\npub fn scope<'env, F, T>(f: F) -> T\n    where\n        F: FnOnce(&Scope<'_, 'env>) -> T,\n{\n    let s = Scope {\n        first: Cell::new(crate::ptr::null_mut::<ScopeNode>()),\n        scope: PhantomData {},\n        env: PhantomData {},\n    };\n    let r = f(&s);\n    // UNSAFE: walks the scope's list through raw pointers.\n    // SAFETY: every node is one Scope::spawn made for s and freed here\n    // only, once; a node its handle joined is skipped.\n    unsafe {\n        let mut n = s.first.get();\n        while !n.is_null() {\n            let next = (*n).next;\n            if !(*n).joined {\n                ((*n).join)((*n).native, (*n).out);\n            }\n            free_record(&CHeap { sealed: () }, n);\n            n = next;\n        }\n    }\n    r\n}\n\n// The scope threads are spawned in. 'scope is the scope's own region\n// ('env outlives it); invariant in both, as Rust's.\n// std2: changed: two regions, invariant\npub struct Scope<'scope, 'env: 'scope> {\n");
    buf_str(out, c"    first: Cell<*mut ScopeNode>,\n    scope: PhantomData<&'scope mut &'scope ()>,\n    env: PhantomData<&'env mut &'env ()>,\n}\n\nimpl<'scope, 'env> Scope<'scope, 'env> {\n    // Runs f on a new thread, joined at the latest when the scope ends;\n    // f may borrow anything that outlives 'scope. `&self`, not Rust's\n    // `&'scope self`: scope's argument elides its two regions separately,\n    // so the reference may be shorter than 'scope; the bound F: 'scope,\n    // with Scope invariant in 'scope, is what keeps f's borrows alive.\n    // std2: changed: &self, FnOnce, Send, a 'scope bound (MVS: inout self, FnMut)\n    // later: auto_trait\n    #[effects(alloc(CHeap), io, panic, diverge, F, T)]\n    pub fn spawn<F, T>(&self, f: F) -> ScopedJoinHandle<'scope, T>\n        where\n            F: FnOnce() -> T + Send + 'scope,\n            T: Send + 'scope,\n    {\n        let (t, out) = start_thread(f, CHeap { sealed: () });\n        let node = new_record(&CHeap { sealed: () }, ScopeNode {\n            native: t,\n            joined: false,\n            out: out as *mut u8,\n            join: scope_join::<T>,\n            next: self.first.get(),\n        });\n        self.first.set(node);\n        ScopedJoinHandle { native: t, out: out, node: node, scope: PhantomData {} }\n    }\n}\n\n// A scoped thread: join waits for its value.\n// std2: changed: a region 'scope\npub struct ScopedJoinHandle<'scope, T> {\n    native: u64,\n    out: *mut Out<T, CHeap>,\n    node: *mut ScopeNode,\n    scope: PhantomData<&'scope ()>,\n}\n\n// UNSAFE: the handle reaches its result and its scope node through raw\n// pointers: stated, as Rust's (Send and Sync for every T).\n// SAFETY: as JoinHandle's; Scope::spawn asks T: Send, and the scope's node\n// is written only by join, which takes the handle.\nunsafe impl<'scope, T> Send for ScopedJoinHandle<'scope, T> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&ScopedJoinHandle` only reads the done flag, atomically.\n");
    buf_str(out, c"unsafe impl<'scope, T> Sync for ScopedJoinHandle<'scope, T> {}\n\nimpl<'scope, T> ScopedJoinHandle<'scope, T> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(unsafe, T)]\n    pub fn join(self) -> Result<T> {\n        // UNSAFE: the scope's node and the thread's result through raw\n        // pointers.\n        // SAFETY: the node lives until the scope ends, which 'scope\n        // outlives; marked joined, the scope's end skips the thread, so it\n        // is joined once.\n        unsafe {\n            (*self.node).joined = true;\n            crate::result::Result::Ok(join_thread(self.native, self.out))\n        }\n    }\n\n    // Whether the thread has finished (join would not wait).\n    #[effects(unsafe, T)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: out lives until the thread is joined, by this handle's\n        // join (which takes it) or the scope's end ('scope outlives self).\n        unsafe { finished(self.out) }\n    }\n}\n\n// Runs f on a new thread of its own; its closure and its result live on\n// a until join (or the handle's drop, which detaches it).\n// mvs: spawn\n// std2: changed: an allocator, FnOnce, Send and 'static (MVS: spawn(f), through C)\n// later: auto_trait\n#[effects(F, T, A)]\npub fn spawn_in<F, T, A>(f: F, a: A) -> JoinHandle<T, A>\n    where\n        F: FnOnce() -> T + Send + 'static,\n        T: Send + 'static,\n        A: Allocator + Send + 'static,\n{\n    let (t, out) = start_thread(f, a);\n    JoinHandle { native: t, out: out }\n}\n\n// A spawned thread.\n// std2: changed: an allocator parameter\npub struct JoinHandle<T, A: Allocator> {\n    native: u64,\n    out: *mut Out<T, A>,\n}\n\n// UNSAFE: the handle reaches the thread's result through a raw pointer:\n// stated, as Rust's (Send and Sync for every T).\n// SAFETY: the result's place is shared with the thread by its refs count,\n");
    buf_str(out, c"// atomically (AcqRel), and read only by join, which takes the handle;\n// spawn_in asks T: Send and A: Send.\nunsafe impl<T, A: Allocator> Send for JoinHandle<T, A> {}\n// UNSAFE: as Send's, above.\n// SAFETY: `&JoinHandle` only reads the done flag, atomically (is_finished).\nunsafe impl<T, A: Allocator> Sync for JoinHandle<T, A> {}\n\nimpl<T, A: Allocator> JoinHandle<T, A> {\n    // Waits for the thread and returns its value (always Ok).\n    // std2: changed: a thread::Result\n    #[effects(alloc(A, extern), unsafe, T, A)]\n    pub fn join(self) -> Result<T> {\n        let t = self.native;\n        let out = self.out;\n        crate::mem::forget(self);\n        // UNSAFE: pthread_join and the result's place.\n        // SAFETY: the handle held a ref, so out is live; it is forgotten, so\n        // its drop does not detach or free; the thread is joined once.\n        crate::result::Result::Ok(unsafe { join_thread(t, out) })\n    }\n\n    #[effects(unsafe, T, A)]\n    pub fn is_finished(&self) -> bool {\n        // UNSAFE: an atomic read of the result's place.\n        // SAFETY: the handle holds a ref, so out is live.\n        unsafe { finished(self.out) }\n    }\n}\n\n// Detaches the thread: it runs on, its result dropped when it ends.\nimpl<T, A: Allocator> crate::ops::Drop for JoinHandle<T, A> {\n    fn drop(&mut self) {\n        // UNSAFE: pthread_detach and the result's place.\n        // SAFETY: out is live (the handle's ref); the last of the thread and\n        // the handle (refs, AcqRel) frees it, once.\n        unsafe {\n            thread_c_detach(self.native);\n            if atomic_sub(&mut (*self.out).refs as *mut u32, 1, ACQ_REL) == 1 {\n                release_out(self.out);\n            }\n        }\n    }\n}\n\n// Lets the OS run another thread.\n#[effects(sync, unsafe)]\npub fn yield_now() {\n    // UNSAFE: C's sched_yield.\n    // SAFETY: it takes nothing.\n    unsafe { thread_c_yield() };\n}\n\n");
    buf_str(out, c"// How many threads can run at once (the CPUs online); 1 when unknown.\n// (Rust's returns io::Result<NonZero<usize>>; vole's, a usize.)\n// std2: changed: usize\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn available_parallelism() -> usize {\n    // UNSAFE: C's sysconf.\n    // SAFETY: it takes an int.\n    let n = unsafe { thread_c_sysconf(SC_NPROCESSORS_ONLN) };\n    if n < 1 { 1 } else { n as usize }\n}\n\n// UNSAFE: C's nanosleep. SAFETY: time.h's prototype (struct timespec, two\n// 64-bit fields on the 64-bit targets, an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"nanosleep\"]\n    fn thread_c_nanosleep(req: *const i64, rem: *mut i64) -> i32;\n}\n\n// Sleeps for d at least: sleeps again for the rest when a signal wakes it.\n#[effects(alloc(extern), io, static, panic, diverge, unsafe)]\npub fn sleep(d: crate::time::Duration) {\n    let max_secs = 9223372036854775807u64;\n    let secs = d.as_secs();\n    let mut req = [if secs > max_secs { max_secs as i64 } else { secs as i64 },\n        d.subsec_nanos() as i64];\n    // (each round sleeps or ends, a signal per round at most: counted)\n    for _ in 0..1000000 {\n        let mut rem = [0i64; 2];\n        // UNSAFE: C's nanosleep.\n        // SAFETY: req and rem are timespecs (two i64s), rem writable; req's\n        // nanoseconds are under a second (a Duration's).\n        let r = unsafe { thread_c_nanosleep(&req[0] as *const i64, &mut rem[0] as *mut i64) };\n        if r == 0 || rem[0] == 0 && rem[1] == 0 {\n            return;\n        }\n        req = rem;\n    }\n}\n\n// ---- Thread-locals ----\n\n// `#[thread_local] static mut X: T = INIT;`: each thread has its own X,\n// made from INIT when the thread first reaches it. The compiler makes\n// every access of X `*__tls_addr(&X's initial value, size)`\n// (front/threadlocal.vl), as for MVS's std::thread, which keeps them the\n// same way: C's thread-specific data, a key per thread-local found by\n");
    buf_str(out, c"// the initial value's address in a table read without a lock, the\n// thread's copy allocated from C at its first access and freed when the\n// thread ends. A thread-local's drop does not run.\n\n// UNSAFE: POSIX thread-specific data and memcpy, with raw pointers.\n// SAFETY: the prototypes are pthread.h's and string.h's (pthread_key_t\n// written as a u64 that starts 0: macOS's unsigned long, or Linux's\n// unsigned int in its low half), as MVS's thread.\nextern \"C\" {\n    #[link_name = \"pthread_key_create\"]\n    fn tls_c_key_create(key: *mut u64, destructor: extern \"C\" fn(*mut u8)) -> i32;\n    #[link_name = \"pthread_getspecific\"]\n    fn tls_c_get(key: u64) -> *mut u8;\n    #[link_name = \"pthread_setspecific\"]\n    fn tls_c_set(key: u64, p: *mut u8) -> i32;\n    #[link_name = \"memcpy\"]\n    fn tls_c_memcpy(d: *mut u8, s: *const u8, n: usize) -> *mut u8;\n}\n\n// UNSAFE: as atomic_load (built in: the old value, then `new` stored when\n// it was `expected`).\n// SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The key table, by the initial value's address (open addressing): a\n// slot's address is claimed by a compare-and-swap, then its key + 1 is\n// published (release) by the thread that claimed it.\nconst TLS_SLOTS: usize = 1024;\nstatic mut TLS_ADDRS: [u64; 1024] = [0; 1024];\nstatic mut TLS_KEYS: [u64; 1024] = [0; 1024];\n\nextern \"C\" fn tls_free(p: *mut u8) {\n    // UNSAFE: C's free.\n    // SAFETY: p is a thread's copy tls_first allocated, freed once, by the\n    // key's destructor when the thread ends.\n    unsafe { thread_c_free(p) };\n}\n\n// This thread's copy of the thread-local whose initial value (size bytes)\n// is at template.\n// UNSAFE: returns a raw pointer to this thread's copy.\n// SAFETY: (the caller's: the compiler's) template is a thread-local's\n// initial value of size bytes, live for the program.\n");
    buf_str(out, c"pub unsafe fn __tls_addr(template: *mut u8, size: i64) -> *mut u8 {\n    let key = tls_key(template);\n    let p = tls_c_get(key);\n    if !p.is_null() {\n        return p;\n    }\n    tls_first(key, template, size)\n}\n\n// UNSAFE: C memory and a copy from a raw pointer.\n// SAFETY: (the caller's) template has size bytes; p is checked non-null,\n// with room for them.\n#[inline(never)]\nunsafe fn tls_first(key: u64, template: *mut u8, size: i64) -> *mut u8 {\n    let n = if size > 0 { size as usize } else { 1 };\n    let p = thread_c_malloc(n);\n    if p.is_null() {\n        crate::panic::panic(\"thread-locals: out of memory\");\n    }\n    tls_c_memcpy(p, template as *const u8, n);\n    tls_c_set(key, p);\n    p\n}\n\n// The key of the thread-local at template, made at its first use: the\n// thread whose compare-and-swap claims the slot makes it and publishes\n// it; another one that finds the address waits for the key.\n// UNSAFE: the key table's statics through raw pointers, atomically, and\n// pthread_key_create.\n// SAFETY: i stays in 0..TLS_SLOTS (a hash's top 10 bits, then mod); a\n// slot's address is written only by the compare-and-swap, its key only by\n// the thread whose swap claimed it, before others read it (release,\n// acquire).\nunsafe fn tls_key(template: *mut u8) -> u64 {\n    let a = template as u64;\n    let addrs = &raw mut TLS_ADDRS as *mut u64;\n    let keys = &raw mut TLS_KEYS as *mut u64;\n    let mut i = ((a >> 4).wrapping_mul(0x9e3779b97f4a7c15) >> 54) as usize % TLS_SLOTS;\n    for _ in 0..TLS_SLOTS {\n        let mut seen = atomic_load(addrs.add(i) as *const u64, ACQUIRE);\n        if seen == 0 {\n            seen = atomic_cas(addrs.add(i), 0, a, ACQ_REL);\n            if seen == 0 {\n                let mut key: u64 = 0;\n                if tls_c_key_create(&mut key as *mut u64, tls_free) != 0 {\n                    crate::panic::panic(\"thread-locals: the system has no key left\");\n                }\n");
    buf_str(out, c"                atomic_store(keys.add(i), key + 1, RELEASE);\n                return key;\n            }\n        }\n        if seen == a {\n            loop {\n                let k = atomic_load(keys.add(i) as *const u64, ACQUIRE);\n                if k != 0 {\n                    return k - 1;\n                }\n                thread_c_yield();\n            }\n        }\n        i = (i + 1) % TLS_SLOTS;\n    }\n    crate::panic::panic(\"thread-locals: more than 1024\")\n}\n// ---- end mod std::thread ----\n}\n// ---- mod std::time ----\npub mod time {\n// EDITION: rust\n// std::time: Duration, Instant and SystemTime, Rust's shape (0.27.5). A\n// Duration is whole seconds and the nanoseconds under one second; its\n// arithmetic is checked (`checked_*` give None, `saturating_*` stop at\n// zero and the largest Duration, the operators panic, as Rust's do).\n// Instant reads the monotonic clock, SystemTime the wall clock, both\n// through C's clock_gettime (the clock's id is the target's: std::__sys).\n// mvs: std::time\n\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::ops::{Add, AddAssign, Div, DivAssign, Mul, MulAssign, Sub, SubAssign};\nuse crate::option::Option;\nuse crate::result::Result;\n\nconst NANOS_PER_SEC: u32 = 1000000000;\nconst NANOS_PER_MILLI: u32 = 1000000;\nconst NANOS_PER_MICRO: u32 = 1000;\n\n// A span of time, Rust's std::time::Duration.\n// std2: changed: no ZERO, MAX, SECOND.. constants (a constant of a struct\n// type waits for const evaluation): `Duration::from_secs(0)`, `new(..)`\n// mvs: Duration\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct Duration {\n    secs: u64,\n    nanos: u32,\n}\n\nimpl Duration {\n    // secs seconds and nanos nanoseconds; nanos past a second carry into\n    // the seconds (panics when the seconds overflow).\n    #[effects(panic, diverge)]\n    pub fn new(secs: u64, nanos: u32) -> Duration {\n        if nanos < NANOS_PER_SEC {\n");
    buf_str(out, c"            return Duration { secs: secs, nanos: nanos };\n        }\n        let extra = (nanos / NANOS_PER_SEC) as u64;\n        match secs.checked_add(extra) {\n            Option::Some(s) => Duration { secs: s, nanos: nanos % NANOS_PER_SEC },\n            Option::None => crate::panic::panic(\"overflow in Duration::new\"),\n        }\n    }\n\n    #[effects()]\n    pub fn from_secs(secs: u64) -> Duration {\n        Duration { secs: secs, nanos: 0 }\n    }\n\n    #[effects()]\n    pub fn from_millis(millis: u64) -> Duration {\n        Duration { secs: millis / 1000, nanos: ((millis % 1000) as u32) * NANOS_PER_MILLI }\n    }\n\n    #[effects()]\n    pub fn from_micros(micros: u64) -> Duration {\n        Duration { secs: micros / 1000000, nanos: ((micros % 1000000) as u32) * NANOS_PER_MICRO }\n    }\n\n    #[effects()]\n    pub fn from_nanos(nanos: u64) -> Duration {\n        Duration { secs: nanos / 1000000000, nanos: (nanos % 1000000000) as u32 }\n    }\n\n    // secs seconds, a float: panics when it is negative, not finite or too\n    // large, as Rust's does; rounded to the nearest nanosecond.\n    #[effects(panic, diverge)]\n    pub fn from_secs_f64(secs: f64) -> Duration {\n        match Duration::try_from_secs_f64(secs) {\n            Result::Ok(d) => d,\n            Result::Err(_) => crate::panic::panic(\n                \"cannot convert float seconds to Duration: value is negative, not finite or overflowing\"),\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn from_secs_f32(secs: f32) -> Duration {\n        Duration::from_secs_f64(secs as f64)\n    }\n\n    // from_secs_f64's value, or the error where it panics.\n    #[effects()]\n    pub fn try_from_secs_f64(secs: f64) -> Result<Duration, TryFromFloatSecsError> {\n        if !(secs >= 0.0) || secs >= 18446744073709551616.0 {\n            return Result::Err(TryFromFloatSecsError { negative: secs < 0.0 });\n        }\n        let whole = secs as u64;\n        let frac = secs - whole as f64;\n");
    buf_str(out, c"        let mut nanos = (frac * 1000000000.0 + 0.5) as u64;\n        let mut s = whole;\n        if nanos >= 1000000000 {\n            nanos -= 1000000000;\n            match s.checked_add(1) {\n                Option::Some(t) => s = t,\n                Option::None => return Result::Err(TryFromFloatSecsError { negative: false }),\n            }\n        }\n        Result::Ok(Duration { secs: s, nanos: nanos as u32 })\n    }\n\n    #[effects()]\n    pub fn try_from_secs_f32(secs: f32) -> Result<Duration, TryFromFloatSecsError> {\n        Duration::try_from_secs_f64(secs as f64)\n    }\n\n    #[effects()]\n    pub fn is_zero(&self) -> bool {\n        self.secs == 0 && self.nanos == 0\n    }\n\n    #[effects()]\n    pub fn as_secs(&self) -> u64 {\n        self.secs\n    }\n\n    #[effects()]\n    pub fn subsec_millis(&self) -> u32 {\n        self.nanos / NANOS_PER_MILLI\n    }\n\n    #[effects()]\n    pub fn subsec_micros(&self) -> u32 {\n        self.nanos / NANOS_PER_MICRO\n    }\n\n    #[effects()]\n    pub fn subsec_nanos(&self) -> u32 {\n        self.nanos\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_millis(&self) -> u64 {\n        self.secs.saturating_mul(1000).saturating_add((self.nanos / NANOS_PER_MILLI) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_micros(&self) -> u64 {\n        self.secs.saturating_mul(1000000).saturating_add((self.nanos / NANOS_PER_MICRO) as u64)\n    }\n\n    // std2: changed: u64, saturating (Rust's is u128)\n    #[effects()]\n    pub fn as_nanos(&self) -> u64 {\n        self.secs.saturating_mul(1000000000).saturating_add(self.nanos as u64)\n    }\n\n    #[effects()]\n    pub fn as_secs_f64(&self) -> f64 {\n        self.secs as f64 + self.nanos as f64 / 1000000000.0\n    }\n\n    #[effects()]\n    pub fn as_secs_f32(&self) -> f32 {\n        self.as_secs_f64() as f32\n    }\n\n    #[effects()]\n");
    buf_str(out, c"    pub fn as_millis_f64(&self) -> f64 {\n        self.secs as f64 * 1000.0 + self.nanos as f64 / 1000000.0\n    }\n\n    #[effects()]\n    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_add(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let mut nanos = self.nanos + rhs.nanos;\n        if nanos >= NANOS_PER_SEC {\n            nanos -= NANOS_PER_SEC;\n            secs = match secs.checked_add(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n        }\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {\n        let mut secs = match self.secs.checked_sub(rhs.secs) {\n            Option::Some(s) => s,\n            Option::None => return Option::None,\n        };\n        let nanos = if self.nanos >= rhs.nanos {\n            self.nanos - rhs.nanos\n        } else {\n            secs = match secs.checked_sub(1) {\n                Option::Some(s) => s,\n                Option::None => return Option::None,\n            };\n            self.nanos + NANOS_PER_SEC - rhs.nanos\n        };\n        Option::Some(Duration { secs: secs, nanos: nanos })\n    }\n\n    #[effects()]\n    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {\n        let total = self.nanos as u64 * rhs as u64;\n        let extra = total / NANOS_PER_SEC as u64;\n        let nanos = (total % NANOS_PER_SEC as u64) as u32;\n        match self.secs.checked_mul(rhs as u64) {\n            Option::Some(s) => match s.checked_add(extra) {\n                Option::Some(secs) => Option::Some(Duration { secs: secs, nanos: nanos }),\n                Option::None => Option::None,\n            },\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n");
    buf_str(out, c"    pub fn checked_div(self, rhs: u32) -> Option<Duration> {\n        if rhs == 0 {\n            return Option::None;\n        }\n        let secs = self.secs / rhs as u64;\n        let carry = self.secs - secs * rhs as u64;\n        let extra = carry * NANOS_PER_SEC as u64 / rhs as u64;\n        let nanos = self.nanos / rhs + extra as u32;\n        Option::Some(Duration::new(secs, nanos))\n    }\n\n    #[effects()]\n    pub fn saturating_add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: 0, nanos: 0 },\n        }\n    }\n\n    #[effects()]\n    pub fn saturating_mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => Duration { secs: u64::MAX, nanos: NANOS_PER_SEC - 1 },\n        }\n    }\n\n    #[effects()]\n    pub fn abs_diff(self, other: Duration) -> Duration {\n        if self >= other {\n            self.saturating_sub(other)\n        } else {\n            other.saturating_sub(self)\n        }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn mul_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(rhs * self.as_secs_f64())\n    }\n\n    #[effects(panic, diverge)]\n    pub fn div_f64(self, rhs: f64) -> Duration {\n        Duration::from_secs_f64(self.as_secs_f64() / rhs)\n    }\n\n    #[effects()]\n    pub fn div_duration_f64(self, rhs: Duration) -> f64 {\n        self.as_secs_f64() / rhs.as_secs_f64()\n    }\n}\n\nimpl Add for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn add(self, rhs: Duration) -> Duration {\n        match self.checked_add(rhs) {\n");
    buf_str(out, c"            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when adding durations\"),\n        }\n    }\n}\n\nimpl AddAssign for Duration {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, rhs: Duration) {\n        *self = *self + rhs;\n    }\n}\n\nimpl Sub for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn sub(self, rhs: Duration) -> Duration {\n        match self.checked_sub(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when subtracting durations\"),\n        }\n    }\n}\n\nimpl SubAssign for Duration {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, rhs: Duration) {\n        *self = *self - rhs;\n    }\n}\n\n// mvs: Duration::mul_u32\nimpl Mul<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn mul(self, rhs: u32) -> Duration {\n        match self.checked_mul(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\"overflow when multiplying duration by scalar\"),\n        }\n    }\n}\n\nimpl MulAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn mul_assign(&mut self, rhs: u32) {\n        *self = *self * rhs;\n    }\n}\n\n// mvs: Duration::div_u32\nimpl Div<u32> for Duration {\n    type Output = Duration;\n    #[effects(panic, diverge)]\n    fn div(self, rhs: u32) -> Duration {\n        match self.checked_div(rhs) {\n            Option::Some(d) => d,\n            Option::None => crate::panic::panic(\n                \"divide by zero error when dividing duration by scalar\"),\n        }\n    }\n}\n\nimpl DivAssign<u32> for Duration {\n    #[effects(panic, diverge)]\n    fn div_assign(&mut self, rhs: u32) {\n        *self = *self / rhs;\n    }\n}\n\n// Rust's form: `1.5s`, `100ms`, `2.000001ms`, `7µs`, `9ns`, the\n// fraction's trailing zeros dropped (or `{:.N?}` digits, rounded half\n// up), padded to the width.\n");
    buf_str(out, c"impl Debug for Duration {\n    #[effects(unsafe)]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.secs > 0 {\n            fmt_decimal(f, self.secs, self.nanos, NANOS_PER_SEC / 10, \"s\")\n        } else if self.nanos >= NANOS_PER_MILLI {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MILLI) as u64, self.nanos % NANOS_PER_MILLI,\n                NANOS_PER_MILLI / 10, \"ms\")\n        } else if self.nanos >= NANOS_PER_MICRO {\n            fmt_decimal(f, (self.nanos / NANOS_PER_MICRO) as u64, self.nanos % NANOS_PER_MICRO,\n                NANOS_PER_MICRO / 10, \"µs\")\n        } else {\n            fmt_decimal(f, self.nanos as u64, 0, 1, \"ns\")\n        }\n    }\n}\n\n// integer.fraction then suffix: fraction's digits from divisor down, at\n// most the precision's (9 without one, its trailing zeros dropped).\n#[effects(unsafe)]\nfn fmt_decimal(f: &mut Formatter<'_>, integer: u64, fraction: u32, divisor: u32, suffix: &str)\n    -> crate::fmt::Result {\n    let mut digits = [b'0'; 9];\n    let wanted = match f.precision() {\n        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => 9,\n    };\n    let mut frac = fraction;\n    let mut div = divisor;\n    let mut pos: usize = 0;\n    while frac > 0 && pos < wanted && div > 0 {\n        digits[pos] = b'0' + (frac / div) as u8;\n        frac = frac % div;\n        div = div / 10;\n        pos += 1;\n    }\n    let mut int_part = integer;\n    // (rounding half up what is left)\n    if frac > 0 && div > 0 && frac >= div * 5 {\n        let mut carry = true;\n        let mut k = pos;\n        while carry && k > 0 {\n            k -= 1;\n            if digits[k] == b'9' {\n                digits[k] = b'0';\n            } else {\n                digits[k] += 1;\n                carry = false;\n            }\n        }\n        if carry {\n            int_part = int_part.saturating_add(1);\n        }\n    }\n    let shown = match f.precision() {\n");
    buf_str(out, c"        Option::Some(p) => if p < 9 { p } else { 9 },\n        Option::None => pos,\n    };\n    let mut out = [0u8; 48];\n    let mut n: usize = 0;\n    let mut int_digits = [0u8; 20];\n    let mut m: usize = 0;\n    let mut v = int_part;\n    if v == 0 {\n        int_digits[0] = b'0';\n        m = 1;\n    }\n    while v > 0 {\n        int_digits[m] = b'0' + (v % 10) as u8;\n        v = v / 10;\n        m += 1;\n    }\n    while m > 0 {\n        m -= 1;\n        out[n] = int_digits[m];\n        n += 1;\n    }\n    if shown > 0 {\n        out[n] = b'.';\n        n += 1;\n        for k in 0..shown {\n            out[n] = digits[k];\n            n += 1;\n        }\n    }\n    for b in suffix.as_bytes() {\n        out[n] = *b;\n        n += 1;\n    }\n    // UNSAFE: the bytes written above are ASCII digits, '.', and suffix's\n    // UTF-8 bytes copied whole.\n    // SAFETY: each is a whole UTF-8 sequence, so out[..n] is UTF-8.\n    let text = unsafe { crate::str::from_utf8_unchecked(&out[..n]) };\n    // (the width pads it, left-aligned by default, as Rust's; the\n    // precision was the fraction's, so not Formatter::pad, which would cut\n    // the text to it)\n    let chars = text.chars().count();\n    let w = match f.width() {\n        Option::Some(w) => w,\n        Option::None => 0,\n    };\n    if w <= chars {\n        return f.write_str(text);\n    }\n    let gap = w - chars;\n    let (before, after): (usize, usize) = match f.align() {\n        Option::Some(crate::fmt::Alignment::Right) => (gap, 0),\n        Option::Some(crate::fmt::Alignment::Center) => (gap / 2, gap - gap / 2),\n        _ => (0, gap),\n    };\n    let fill = f.fill();\n    for _ in 0..before {\n        f.write_char(fill)?;\n    }\n    f.write_str(text)?;\n    for _ in 0..after {\n        f.write_char(fill)?;\n    }\n    crate::fmt::Result::Ok(())\n}\n\n// Duration::try_from_secs_f64's error: the float was negative, not finite\n// or too large.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n");
    buf_str(out, c"pub struct TryFromFloatSecsError {\n    negative: bool,\n}\n\nimpl Display for TryFromFloatSecsError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        if self.negative {\n            f.write_str(\"cannot convert float seconds to Duration: value is negative\")\n        } else {\n            f.write_str(\"cannot convert float seconds to Duration: value is either too big or NaN\")\n        }\n    }\n}\n\n// UNSAFE: C. SAFETY: time.h's prototype (struct timespec, two 64-bit\n// fields on the 64-bit targets, is an [i64; 2]).\nextern \"C\" {\n    #[link_name = \"clock_gettime\"]\n    fn c_clock_gettime(clock: i32, tp: *mut i64) -> i32;\n}\n\n// Clock clock's now, a Duration since its start.\n#[effects(io, static, unsafe)]\nfn clock_now(clock: i32) -> Duration {\n    let mut ts = [0i64; 2];\n    // UNSAFE: C's clock_gettime.\n    // SAFETY: ts is a writable timespec (two i64s); clock is a valid id\n    // (the target's, std::__sys), so the call cannot fail.\n    unsafe {\n        c_clock_gettime(clock, &mut ts[0] as *mut i64);\n    }\n    Duration { secs: ts[0] as u64, nanos: ts[1] as u32 }\n}\n\n// A reading of the monotonic clock, Rust's std::time::Instant: only its\n// differences mean anything.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct Instant {\n    t: Duration,\n}\n\nimpl Instant {\n    // mvs: monotonic_now\n    #[effects(io, static, unsafe)]\n    pub fn now() -> Instant {\n        Instant { t: clock_now(crate::__sys::CLOCK_MONOTONIC) }\n    }\n\n    // The time since earlier (zero when earlier is later, as Rust's).\n    #[effects()]\n    pub fn duration_since(&self, earlier: Instant) -> Duration {\n        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {\n        self.t.checked_sub(earlier.t)\n    }\n\n    #[effects()]\n    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {\n");
    buf_str(out, c"        self.t.saturating_sub(earlier.t)\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn elapsed(&self) -> Duration {\n        Instant::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(Instant { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> Instant {\n        Instant { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for Instant {\n    type Output = Instant;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> Instant {\n        Instant { t: self.t - d }\n    }\n}\n\nimpl SubAssign<Duration> for Instant {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Sub<Instant> for Instant {\n    type Output = Duration;\n    #[effects()]\n    fn sub(self, earlier: Instant) -> Duration {\n        self.duration_since(earlier)\n    }\n}\n\nimpl Debug for Instant {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Instant\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// A reading of the wall clock, Rust's std::time::SystemTime: the time\n// since UNIX_EPOCH (not before it here).\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash)]\npub struct SystemTime {\n");
    buf_str(out, c"    t: Duration,\n}\n\n// 1970-01-01 00:00:00 UTC.\n// std2: changed: a static (Rust's is a constant: a constant of a struct\n// type waits for const evaluation)\npub static UNIX_EPOCH: SystemTime = SystemTime { t: Duration { secs: 0, nanos: 0 } };\n\nimpl SystemTime {\n    // mvs: clock_now\n    #[effects(io, static, unsafe)]\n    pub fn now() -> SystemTime {\n        SystemTime { t: clock_now(0) }\n    }\n\n    // The time since earlier, or how much later earlier is.\n    #[effects()]\n    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {\n        match self.t.checked_sub(earlier.t) {\n            Option::Some(d) => Result::Ok(d),\n            Option::None => Result::Err(SystemTimeError(earlier.t - self.t)),\n        }\n    }\n\n    #[effects(io, static, unsafe)]\n    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {\n        SystemTime::now().duration_since(*self)\n    }\n\n    #[effects()]\n    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_add(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n\n    #[effects()]\n    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {\n        match self.t.checked_sub(d) {\n            Option::Some(t) => Option::Some(SystemTime { t: t }),\n            Option::None => Option::None,\n        }\n    }\n}\n\nimpl Add<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn add(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t + d }\n    }\n}\n\nimpl AddAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn add_assign(&mut self, d: Duration) {\n        self.t = self.t + d;\n    }\n}\n\nimpl Sub<Duration> for SystemTime {\n    type Output = SystemTime;\n    #[effects(panic, diverge)]\n    fn sub(self, d: Duration) -> SystemTime {\n        SystemTime { t: self.t - d }\n");
    buf_str(out, c"    }\n}\n\nimpl SubAssign<Duration> for SystemTime {\n    #[effects(panic, diverge)]\n    fn sub_assign(&mut self, d: Duration) {\n        self.t = self.t - d;\n    }\n}\n\nimpl Debug for SystemTime {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"SystemTime\").field(\"tv_sec\", &self.t.secs).field(\"tv_nsec\", &self.t.nanos)\n            .finish()\n    }\n}\n\n// SystemTime::duration_since's error: how much later the other time is.\n#[derive(Clone, Copy, Debug)]\npub struct SystemTimeError(Duration);\n\nimpl SystemTimeError {\n    #[effects()]\n    pub fn duration(&self) -> Duration {\n        self.0\n    }\n}\n\nimpl Display for SystemTimeError {\n    #[effects()]\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"second time provided was later than self\")\n    }\n}\n// ---- end mod std::time ----\n}\n// ---- mod std::sync ----\npub mod sync {\n// EDITION: rust\n// std::sync: what threads share. Its first part (0.27.3): the atomics.\n// Mutex, RwLock, Arc and the channels come later.\n// mvs: std::sync\n\npub mod atomic;\n// ---- mod std::sync::atomic ----\npub mod atomic {\n// EDITION: rust\n// std::sync::atomic: values that threads read and write at once without a\n// data race, and the memory orderings (Rust's; C++20's model). AtomicI64\n// and the others are Atomic<T> for their T, an integer, bool or a raw\n// pointer: one access of 1 to 8 bytes (the compiler implements the sealed\n// AtomicValue, AtomicBitwise and AtomicInteger for exactly those types,\n// front/traits.vl: atomic_bound). Integers wrap.\n//\n//     static HITS: AtomicUsize = AtomicUsize::new(0);\n//     HITS.fetch_add(1, Ordering::Relaxed);\n// mvs: std::sync::atomic\n\nuse crate::cell::UnsafeCell;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Formatter};\nuse crate::result::Result;\n\n// The ordering of an atomic operation (Rust's, without Consume).\n");
    buf_str(out, c"#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]\npub enum Ordering {\n    Relaxed,\n    Release,\n    Acquire,\n    AcqRel,\n    SeqCst,\n}\n\n// The intrinsics the compiler lowers by name to its atomic instructions\n// (middle/lower/atomic.vl, as MVS's std::sync::atomic): `order` is 0\n// Relaxed, 1 Acquire, 2 Release, 3 AcqRel, 4 SeqCst, a literal after\n// inlining (else SeqCst); their bodies never run.\n// UNSAFE: p is read or written atomically through a raw pointer.\n// SAFETY: a contract on the caller: p valid and aligned for T, T one the\n// AtomicValue bound admits, and *p reached only through atomics.\nunsafe fn atomic_load<T>(p: *const T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_store<T>(p: *mut T, v: T, order: i64) {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_swap<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// The old value; *p becomes `new` when it was `expected`.\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_cas<T>(p: *mut T, expected: T, new: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_add<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_sub<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_and<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_nand<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_or<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n");
    buf_str(out, c"// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_xor<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (signed or unsigned as T is)\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_max<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// UNSAFE: as atomic_load. SAFETY: as atomic_load.\nunsafe fn atomic_min<T>(p: *mut T, v: T, order: i64) -> T {\n    crate::panic::unreachable()\n}\n\n// (no pointer, no memory touched)\nfn atomic_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\nfn atomic_compiler_fence(order: i64) {\n    crate::panic::unreachable()\n}\n\n// The one ordering of a compare-exchange, at least as strong as both.\nfn cas_order(success: Ordering, failure: Ordering) -> i64 {\n    if failure == Ordering::Release || failure == Ordering::AcqRel {\n        crate::panic::panic(\"there is no such thing as a release failure ordering\");\n    }\n    let s: i64 = match success {\n        Ordering::Relaxed => 0,\n        Ordering::Acquire => 1,\n        Ordering::Release => 2,\n        Ordering::AcqRel => 3,\n        Ordering::SeqCst => 4,\n    };\n    if s == 4 || failure == Ordering::SeqCst {\n        return 4;\n    }\n    if failure == Ordering::Acquire && (s == 0 || s == 2) {\n        return if s == 0 { 1 } else { 3 };\n    }\n    s\n}\n\n// What an Atomic holds: the integers, bool and the raw pointers (the\n// compiler's, sealed: Sealed is private).\npub trait AtomicValue: Copy + PartialEq {\n    fn sealed_value(self) -> Sealed;\n}\n\n// The integers and bool: fetch_and, fetch_or, fetch_xor, fetch_nand.\npub trait AtomicBitwise {\n    fn sealed_bitwise(self) -> Sealed;\n}\n\n// The integers: fetch_add, fetch_sub, fetch_max, fetch_min.\npub trait AtomicInteger {\n    fn sealed_integer(self) -> Sealed;\n}\n\npub struct Sealed {}\n\n// A T that threads share: read and written only through its methods.\n");
    buf_str(out, c"// std2: new: Rust's AtomicI64, AtomicBool, .. are its aliases\npub struct Atomic<T: AtomicValue> {\n    v: UnsafeCell<T>,\n}\n\npub type AtomicI8 = Atomic<i8>;\npub type AtomicI16 = Atomic<i16>;\npub type AtomicI32 = Atomic<i32>;\npub type AtomicI64 = Atomic<i64>;\npub type AtomicIsize = Atomic<isize>;\npub type AtomicU8 = Atomic<u8>;\npub type AtomicU16 = Atomic<u16>;\npub type AtomicU32 = Atomic<u32>;\npub type AtomicU64 = Atomic<u64>;\npub type AtomicUsize = Atomic<usize>;\npub type AtomicBool = Atomic<bool>;\npub type AtomicPtr<T> = Atomic<*mut T>;\n\n// UNSAFE: an Atomic holds an UnsafeCell, which is not Sync: stated, as\n// Rust's atomics state it.\n// SAFETY: every access of v is atomic (its methods), so sharing an Atomic\n// between threads races on nothing; T is Copy, with no drop.\nunsafe impl<T: AtomicValue> Sync for Atomic<T> {}\n// UNSAFE: stated with Sync, as Rust's.\n// SAFETY: T is an integer, bool or a raw pointer, moved as its bits.\nunsafe impl<T: AtomicValue> Send for Atomic<T> {}\n\n// Each `unsafe` below: an intrinsic on self.v.get(), valid and aligned for\n// T, which is reached only through them (an Atomic is not Copy).\nimpl<T: AtomicValue> Atomic<T> {\n    #[effects(T)]\n    pub fn new(v: T) -> Atomic<T> {\n        Atomic { v: UnsafeCell::new(v) }\n    }\n\n    // The value, when nothing else can reach the atomic.\n    #[effects(unsafe, T)]\n    pub fn into_inner(self) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe { atomic_load(self.v.get() as *const T, 0) }\n    }\n\n    // The value, through the unique borrow (no atomic needed).\n    #[effects(T)]\n    pub fn get_mut(&mut self) -> &mut T {\n        self.v.get_mut()\n    }\n\n    // The value's address (an access through it must not race with the\n    // atomic ones).\n    #[effects()]\n    pub fn as_ptr(&self) -> *mut T {\n        self.v.get()\n    }\n\n    // Panics on Release and AcqRel, as Rust's.\n");
    buf_str(out, c"    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn load(&self, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_load(self.v.get() as *const T, 0),\n                Ordering::Acquire => atomic_load(self.v.get() as *const T, 1),\n                Ordering::SeqCst => atomic_load(self.v.get() as *const T, 4),\n                Ordering::Release => crate::panic::panic(\n                    \"there is no such thing as a release load\"),\n                Ordering::AcqRel => crate::panic::panic(\n                    \"there is no such thing as an acquire-release load\"),\n            }\n        }\n    }\n\n    // Panics on Acquire and AcqRel, as Rust's.\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn store(&self, v: T, order: Ordering) {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_store(self.v.get(), v, 0),\n                Ordering::Release => atomic_store(self.v.get(), v, 2),\n                Ordering::SeqCst => atomic_store(self.v.get(), v, 4),\n                Ordering::Acquire => crate::panic::panic(\n                    \"there is no such thing as an acquire store\"),\n                Ordering::AcqRel => crate::panic::panic(\n                    \"there is no such thing as an acquire-release store\"),\n            }\n        }\n    }\n\n    // Stores v; the old value.\n    #[effects(unsafe, T)]\n    pub fn swap(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_swap(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_swap(self.v.get(), v, 1),\n                Ordering::Release => atomic_swap(self.v.get(), v, 2),\n");
    buf_str(out, c"                Ordering::AcqRel => atomic_swap(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_swap(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Ok(the old value) when it was `current` (and is now `new`), else\n    // Err(the value found).\n    #[effects(io, panic, diverge, unsafe, T)]\n    pub fn compare_exchange(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        let order = cas_order(success, failure);\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        let old = unsafe {\n            if order == 0 {\n                atomic_cas(self.v.get(), current, new, 0)\n            } else if order == 1 {\n                atomic_cas(self.v.get(), current, new, 1)\n            } else if order == 2 {\n                atomic_cas(self.v.get(), current, new, 2)\n            } else if order == 3 {\n                atomic_cas(self.v.get(), current, new, 3)\n            } else {\n                atomic_cas(self.v.get(), current, new, 4)\n            }\n        };\n        if old == current { Result::Ok(old) } else { Result::Err(old) }\n    }\n\n    // compare_exchange (it never fails spuriously here).\n    #[effects(T)]\n    pub fn compare_exchange_weak(&self, current: T, new: T, success: Ordering, failure: Ordering)\n        -> Result<T, T> {\n        self.compare_exchange(current, new, success, failure)\n    }\n}\n\n// The arithmetic: the integers only (it wraps).\nimpl<T: AtomicValue + AtomicInteger> Atomic<T> {\n    // Adds v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_add(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_add(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_add(self.v.get(), v, 1),\n                Ordering::Release => atomic_add(self.v.get(), v, 2),\n");
    buf_str(out, c"                Ordering::AcqRel => atomic_add(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_add(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // Subtracts v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_sub(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_sub(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_sub(self.v.get(), v, 1),\n                Ordering::Release => atomic_sub(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_sub(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_sub(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The larger of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_max(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_max(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_max(self.v.get(), v, 1),\n                Ordering::Release => atomic_max(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_max(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_max(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The smaller of the value and v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_min(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_min(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_min(self.v.get(), v, 1),\n                Ordering::Release => atomic_min(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_min(self.v.get(), v, 3),\n");
    buf_str(out, c"                Ordering::SeqCst => atomic_min(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\n// The bitwise operations: the integers and bool.\nimpl<T: AtomicValue + AtomicBitwise> Atomic<T> {\n    // The value & v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_and(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_and(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_and(self.v.get(), v, 1),\n                Ordering::Release => atomic_and(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_and(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_and(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // !(the value & v); the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_nand(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_nand(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_nand(self.v.get(), v, 1),\n                Ordering::Release => atomic_nand(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_nand(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_nand(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value | v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_or(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_or(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_or(self.v.get(), v, 1),\n                Ordering::Release => atomic_or(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_or(self.v.get(), v, 3),\n");
    buf_str(out, c"                Ordering::SeqCst => atomic_or(self.v.get(), v, 4),\n            }\n        }\n    }\n\n    // The value ^ v; the old value.\n    #[effects(unsafe, T)]\n    pub fn fetch_xor(&self, v: T, order: Ordering) -> T {\n        // UNSAFE: an intrinsic on the cell's value. SAFETY: see the impl.\n        unsafe {\n            match order {\n                Ordering::Relaxed => atomic_xor(self.v.get(), v, 0),\n                Ordering::Acquire => atomic_xor(self.v.get(), v, 1),\n                Ordering::Release => atomic_xor(self.v.get(), v, 2),\n                Ordering::AcqRel => atomic_xor(self.v.get(), v, 3),\n                Ordering::SeqCst => atomic_xor(self.v.get(), v, 4),\n            }\n        }\n    }\n}\n\nimpl<T: AtomicValue + Default> Default for Atomic<T> {\n    fn default() -> Atomic<T> {\n        Atomic::new(T::default())\n    }\n}\n\n// The value, read Relaxed (as Rust's).\nimpl<T: AtomicValue + Debug> Debug for Atomic<T> {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        Debug::fmt(&self.load(Ordering::Relaxed), f)\n    }\n}\n\n// A memory fence: Acquire, Release, AcqRel or SeqCst; panics on Relaxed,\n// as Rust's.\n#[effects(io, sync, panic, diverge)]\npub fn fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_fence(1),\n        Ordering::Release => atomic_fence(2),\n        Ordering::AcqRel => atomic_fence(3),\n        Ordering::SeqCst => atomic_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\"there is no such thing as a relaxed fence\"),\n    }\n}\n\n// A fence for the compiler only (no instruction): memory accesses are not\n// moved across it. Panics on Relaxed, as Rust's.\n#[effects(io, sync, panic, diverge)]\npub fn compiler_fence(order: Ordering) {\n    match order {\n        Ordering::Acquire => atomic_compiler_fence(1),\n        Ordering::Release => atomic_compiler_fence(2),\n        Ordering::AcqRel => atomic_compiler_fence(3),\n");
    buf_str(out, c"        Ordering::SeqCst => atomic_compiler_fence(4),\n        Ordering::Relaxed => crate::panic::panic(\n            \"there is no such thing as a relaxed compiler fence\"),\n    }\n}\n// ---- end mod std::sync::atomic ----\n}\n// ---- end mod std::sync ----\n}\n// ---- mod std::gpu ----\npub mod gpu {\n// EDITION: rust\n// std::gpu (0.27.6): what of MVS's std::gpu (docs/design/gpu.md) std2 has\n// so far, the WGSL front end, `wgsl`. The device API (Instance, Device,\n// buffers, pipelines) and the writers (MSL, SPIR-V) come later.\n// mvs: std::gpu\n\npub mod wgsl;\n// ---- mod std::gpu::wgsl ----\npub mod wgsl {\n// EDITION: rust\n// std::gpu::wgsl (0.27.6): the shader compiler's front end, MVS's\n// (docs/design/gpu.md §2.10), translated: WGSL (the subset of §2.10)\n// parsed, resolved and type-checked into the target-neutral IR, and the\n// uniformity analysis. What the compiler checks an `embed wgsl` block\n// with:\n//\n//   let mut fr = front::new_front(text, a);\n//   fr.module();\n//   if !fr.failed {\n//       uniformity::check(&fr);\n//   }\n//   // fr.failed: fr.err_code (wgsl.*), fr.err_pos, fr.emsg, fr.ehelp\n//\n// `a` is an allocator the front's tables live in (an arena's scope, `&s`).\n// The writers (MSL, SPIR-V), the interpreter and `translate` (MVS's\n// api.vl) come with the device API.\n// mvs: std::gpu::wgsl\n\nmod ir;\nmod names;\nmod lex;\npub mod front;\nmod expr;\nmod builtins;\nmod entry;\npub mod uniformity;\n// ---- mod std::gpu::wgsl::ir ----\nmod ir {\n// EDITION: rust\n// ---- Shader compiler implementation, ir (0.22) ----\n// The shader IR (docs/design/gpu.md §2.10): what the front end makes\n// from WGSL and the back ends (MSL, SPIR-V, the interpreter) read. It is\n// plain data: i64 handles into Vecs, one arena per translation.\n//\n// - Types are module-wide and interned: a handle is equal for equal types.\n//   The scalar, vector and matrix types have fixed handles (`vec_ty`,\n");
    buf_str(out, c"//   `mat_ty`); the rest are found through `types_map`.\n// - A function has an expression arena, a statement arena and blocks\n//   (runs of statement handles in `items`). Expressions are evaluated\n//   where an `S_EMIT` statement covers them, in order, except the results\n//   of calls and atomics (made by their statement) and the leaves\n//   (literals, arguments, variables), which have no cost.\n// - Every index has a bounds check (D15): `E_ACCESS.c` is the check's\n//   kind, set by bounds.vl; a back end never sees `CK_PENDING`.\n//\n// Moves to compiler/std/gpu/wgsl/ir.vl with C2 (std submodules).\n\nuse crate::alloc::Allocator;\nuse crate::cmp::PartialEq as Eq;\nuse crate::collections::HashMap;\nuse crate::hash::Hash;\n\n// ---- Shader compiler implementation, ir: Scalars (0.22) ----\n\npub(crate) const SK_BOOL: u8 = 0;\npub(crate) const SK_I32: u8 = 1;\npub(crate) const SK_U32: u8 = 2;\npub(crate) const SK_F32: u8 = 3;\n// Abstract numbers exist only in the front end (const evaluation).\npub(crate) const SK_AINT: u8 = 4;\npub(crate) const SK_AFLOAT: u8 = 5;\n\n// ---- Shader compiler implementation, ir: Types (0.22) ----\n\npub(crate) const TK_SCALAR: u8 = 0;\npub(crate) const TK_VECTOR: u8 = 1;\n// n columns of m rows of f32\npub(crate) const TK_MATRIX: u8 = 2;\n// base: the element; n: the length, 0 when runtime-sized\npub(crate) const TK_ARRAY: u8 = 3;\npub(crate) const TK_STRUCT: u8 = 4;\npub(crate) const TK_ATOMIC: u8 = 5;\n// base: the pointee; space, access\npub(crate) const TK_POINTER: u8 = 6;\n// scalar: the sampled kind; n: TEX_*; access for storage textures; m: the texel format\npub(crate) const TK_TEXTURE: u8 = 7;\n// n: 1 for sampler_comparison\npub(crate) const TK_SAMPLER: u8 = 8;\n\npub(crate) const TEX_2D: i64 = 0;\npub(crate) const TEX_2D_ARRAY: i64 = 1;\npub(crate) const TEX_DEPTH_2D: i64 = 2;\npub(crate) const TEX_STORAGE_2D: i64 = 3;\n\n// Texel formats of storage textures (TK_TEXTURE.m).\npub(crate) const FMT_RGBA8UNORM: i64 = 0;\n");
    buf_str(out, c"pub(crate) const FMT_RGBA32FLOAT: i64 = 1;\npub(crate) const FMT_R32FLOAT: i64 = 2;\npub(crate) const FMT_R32UINT: i64 = 3;\npub(crate) const FMT_R32SINT: i64 = 4;\npub(crate) const FMT_RGBA32UINT: i64 = 5;\npub(crate) const FMT_RGBA16FLOAT: i64 = 6;\npub(crate) const FMT_RGBA8UINT: i64 = 7;\npub(crate) const FMT_RG32FLOAT: i64 = 8;\n\n// Address spaces.\npub(crate) const SP_FUNCTION: u8 = 0;\npub(crate) const SP_PRIVATE: u8 = 1;\npub(crate) const SP_WORKGROUP: u8 = 2;\npub(crate) const SP_UNIFORM: u8 = 3;\npub(crate) const SP_STORAGE: u8 = 4;\n// textures and samplers: no address space, the global is the value\npub(crate) const SP_HANDLE: u8 = 5;\n\n// Access modes (bits).\npub(crate) const ACC_READ: u8 = 1;\npub(crate) const ACC_WRITE: u8 = 2;\npub(crate) const ACC_RW: u8 = 3;\n\n#[derive(Clone, Copy)] pub struct Type<'a> {\n    pub(crate) kind: u8,\n    pub(crate) scalar: u8,\n    pub(crate) space: u8,\n    pub(crate) access: u8,\n    pub(crate) n: i64,\n    pub(crate) m: i64,\n    pub(crate) base: i64,\n    // struct members: members[mstart .. mstart + mcount]\n    pub(crate) mstart: i64,\n    pub(crate) mcount: i64,\n    pub(crate) name: &'a [u8],\n    // the WGSL memory layout, in bytes (every type, every address space)\n    pub(crate) size: i64,\n    pub(crate) align: i64,\n    // arrays: the element stride; matrices: the column stride\n    pub(crate) stride: i64,\n}\n\n// What an entry point's parameter, result or IO struct member is bound to.\npub(crate) const BIND_NONE: u8 = 0;\npub(crate) const BIND_BUILTIN: u8 = 1;\npub(crate) const BIND_LOCATION: u8 = 2;\n\npub(crate) const INTERP_PERSPECTIVE: u8 = 0;\npub(crate) const INTERP_LINEAR: u8 = 1;\npub(crate) const INTERP_FLAT: u8 = 2;\n\n#[derive(Clone, Copy)] pub struct Binding { pub kind: u8, pub interp: u8, pub value: i64 }\n\n#[effects()]\npub(crate) fn no_binding() -> Binding {\n    Binding { kind: BIND_NONE, interp: INTERP_PERSPECTIVE, value: 0 }\n}\n\npub(crate) const BI_POSITION: i64 = 0;\n");
    buf_str(out, c"pub(crate) const BI_VERTEX_INDEX: i64 = 1;\npub(crate) const BI_INSTANCE_INDEX: i64 = 2;\npub(crate) const BI_FRONT_FACING: i64 = 3;\npub(crate) const BI_FRAG_DEPTH: i64 = 4;\npub(crate) const BI_SAMPLE_INDEX: i64 = 5;\npub(crate) const BI_SAMPLE_MASK: i64 = 6;\npub(crate) const BI_LOCAL_INVOCATION_ID: i64 = 7;\npub(crate) const BI_LOCAL_INVOCATION_INDEX: i64 = 8;\npub(crate) const BI_GLOBAL_INVOCATION_ID: i64 = 9;\npub(crate) const BI_WORKGROUP_ID: i64 = 10;\npub(crate) const BI_NUM_WORKGROUPS: i64 = 11;\n\n#[derive(Clone, Copy)] pub struct StructMember<'a> {\n    pub name: &'a [u8], pub ty: i64, pub offset: i64, pub binding: Binding,\n}\n\n// ---- Shader compiler implementation, ir: Expressions (0.22) ----\n\n// a: the bits (a u32 for i32, u32, f32; 0 or 1 for bool)\npub(crate) const E_LITERAL: u8 = 0;\npub(crate) const E_ZERO: u8 = 1;\n// a, b: args[a .. a + b]: scalars and vectors for a vector, columns for a\n// matrix, elements, members\npub(crate) const E_COMPOSE: u8 = 2;\n// a: a scalar\npub(crate) const E_SPLAT: u8 = 3;\n// a: the vector; b: the components, 2 bits each from bit 0; c: how many\npub(crate) const E_SWIZZLE: u8 = 4;\n// a: base (a pointer or a value); b: the index expression; c: CK_*;\n// d: the length when the check is a clamp\npub(crate) const E_ACCESS: u8 = 5;\n// a: base (a pointer or a value); b: the constant index (a member, or a\n// component of a vector, matrix or fixed-size array, checked statically)\npub(crate) const E_ACCESS_INDEX: u8 = 6;\n// a: the parameter's index\npub(crate) const E_ARG: u8 = 7;\n// a: the global; its type is a pointer (a texture or sampler: the handle)\npub(crate) const E_GLOBAL: u8 = 8;\n// a: the local; a pointer<function>\npub(crate) const E_LOCAL: u8 = 9;\n// a: the pointer\npub(crate) const E_LOAD: u8 = 10;\n// a: UN_*; b: the operand\npub(crate) const E_UNARY: u8 = 11;\n// a: OP_*; b, c: the operands\npub(crate) const E_BINARY: u8 = 12;\n");
    buf_str(out, c"// a: the condition (bool, or a vector of bool); b: if true; c: if false\npub(crate) const E_SELECT: u8 = 13;\n// a: MF_*; b, c: args[b .. b + c]\npub(crate) const E_MATH: u8 = 14;\n// a: the operand; the type is the target (value conversion)\npub(crate) const E_CONVERT: u8 = 15;\n// a: the operand; the type is the target (bits)\npub(crate) const E_BITCAST: u8 = 16;\n// made by S_CALL\npub(crate) const E_CALL_RESULT: u8 = 17;\n// made by S_ATOMIC\npub(crate) const E_ATOMIC_RESULT: u8 = 18;\n// a: a pointer to a runtime-sized array (or a struct ending in one: b is\n// then the member index, else -1)\npub(crate) const E_ARRAY_LENGTH: u8 = 19;\n// a: DV_*; b: the operand\npub(crate) const E_DERIVATIVE: u8 = 20;\n// a: the texture; b: the sampler; c: args[c .. c + d] (coords, then\n// array index, bias/level/depth ref as `aux`): see IMG_*\npub(crate) const E_IMAGE_SAMPLE: u8 = 21;\n// a: the texture; c: args (coords, array index, level)\npub(crate) const E_IMAGE_LOAD: u8 = 22;\n// a: the texture; b: IQ_*; c: the level expression or -1\npub(crate) const E_IMAGE_QUERY: u8 = 23;\n// a: the pointer; made by S_WG_UNIFORM_LOAD\npub(crate) const E_WG_UNIFORM_RESULT: u8 = 24;\n\n// Bounds checks of E_ACCESS.\npub(crate) const CK_PENDING: i64 = 0;\n// proven in range: no check\npub(crate) const CK_NONE: i64 = 1;\n// fixed length d: index = min(index, d - 1)\npub(crate) const CK_CLAMP: i64 = 2;\n// runtime-sized: out of range, a load reads zero and a store is skipped\npub(crate) const CK_RZSW: i64 = 3;\n\npub(crate) const UN_NEG: i64 = 0;\npub(crate) const UN_NOT: i64 = 1;\npub(crate) const UN_BITNOT: i64 = 2;\n\npub(crate) const OP_ADD: i64 = 0;\npub(crate) const OP_SUB: i64 = 1;\npub(crate) const OP_MUL: i64 = 2;\npub(crate) const OP_DIV: i64 = 3;\npub(crate) const OP_MOD: i64 = 4;\npub(crate) const OP_EQ: i64 = 5;\npub(crate) const OP_NE: i64 = 6;\npub(crate) const OP_LT: i64 = 7;\npub(crate) const OP_LE: i64 = 8;\npub(crate) const OP_GT: i64 = 9;\n");
    buf_str(out, c"pub(crate) const OP_GE: i64 = 10;\n// bitwise on integers; logical (both operands evaluated) on bool\npub(crate) const OP_AND: i64 = 11;\npub(crate) const OP_OR: i64 = 12;\npub(crate) const OP_XOR: i64 = 13;\npub(crate) const OP_SHL: i64 = 14;\npub(crate) const OP_SHR: i64 = 15;\n// short-circuit forms are lowered to control flow when the right side\n// has effects; else they are these, on bool\npub(crate) const OP_LAND: i64 = 16;\npub(crate) const OP_LOR: i64 = 17;\n\n// Math functions (E_MATH). Component-wise unless noted.\npub(crate) const MF_ABS: i64 = 0;\npub(crate) const MF_MIN: i64 = 1;\npub(crate) const MF_MAX: i64 = 2;\npub(crate) const MF_CLAMP: i64 = 3;\npub(crate) const MF_SIGN: i64 = 4;\npub(crate) const MF_FLOOR: i64 = 5;\npub(crate) const MF_CEIL: i64 = 6;\npub(crate) const MF_ROUND: i64 = 7;\npub(crate) const MF_FRACT: i64 = 8;\npub(crate) const MF_TRUNC: i64 = 9;\npub(crate) const MF_SQRT: i64 = 10;\npub(crate) const MF_INVERSE_SQRT: i64 = 11;\npub(crate) const MF_EXP: i64 = 12;\npub(crate) const MF_EXP2: i64 = 13;\npub(crate) const MF_LOG: i64 = 14;\npub(crate) const MF_LOG2: i64 = 15;\npub(crate) const MF_POW: i64 = 16;\npub(crate) const MF_SIN: i64 = 17;\npub(crate) const MF_COS: i64 = 18;\npub(crate) const MF_TAN: i64 = 19;\npub(crate) const MF_ASIN: i64 = 20;\npub(crate) const MF_ACOS: i64 = 21;\npub(crate) const MF_ATAN: i64 = 22;\npub(crate) const MF_ATAN2: i64 = 23;\npub(crate) const MF_SINH: i64 = 24;\npub(crate) const MF_COSH: i64 = 25;\npub(crate) const MF_TANH: i64 = 26;\npub(crate) const MF_MIX: i64 = 27;\npub(crate) const MF_STEP: i64 = 28;\npub(crate) const MF_SMOOTHSTEP: i64 = 29;\npub(crate) const MF_FMA: i64 = 30;\n// the rest reduce or are not component-wise\npub(crate) const MF_LENGTH: i64 = 31;\npub(crate) const MF_DISTANCE: i64 = 32;\npub(crate) const MF_DOT: i64 = 33;\npub(crate) const MF_CROSS: i64 = 34;\npub(crate) const MF_NORMALIZE: i64 = 35;\npub(crate) const MF_REFLECT: i64 = 36;\n");
    buf_str(out, c"pub(crate) const MF_DETERMINANT: i64 = 37;\npub(crate) const MF_TRANSPOSE: i64 = 38;\npub(crate) const MF_COUNT_ONE_BITS: i64 = 39;\npub(crate) const MF_COUNT_LEADING_ZEROS: i64 = 40;\npub(crate) const MF_COUNT_TRAILING_ZEROS: i64 = 41;\npub(crate) const MF_FIRST_LEADING_BIT: i64 = 42;\npub(crate) const MF_FIRST_TRAILING_BIT: i64 = 43;\npub(crate) const MF_REVERSE_BITS: i64 = 44;\npub(crate) const MF_EXTRACT_BITS: i64 = 45;\npub(crate) const MF_INSERT_BITS: i64 = 46;\npub(crate) const MF_ALL: i64 = 47;\npub(crate) const MF_ANY: i64 = 48;\npub(crate) const MF_DEGREES: i64 = 49;\npub(crate) const MF_RADIANS: i64 = 50;\npub(crate) const MF_SATURATE: i64 = 51;\npub(crate) const MF_PACK4X8UNORM: i64 = 52;\npub(crate) const MF_UNPACK4X8UNORM: i64 = 53;\npub(crate) const MF_PACK2X16FLOAT: i64 = 54;\npub(crate) const MF_UNPACK2X16FLOAT: i64 = 55;\npub(crate) const MF_ASINH: i64 = 56;\npub(crate) const MF_ACOSH: i64 = 57;\npub(crate) const MF_ATANH: i64 = 58;\npub(crate) const MF_FACE_FORWARD: i64 = 59;\npub(crate) const MF_LDEXP: i64 = 60;\npub(crate) const MF_PACK4X8SNORM: i64 = 61;\npub(crate) const MF_UNPACK4X8SNORM: i64 = 62;\npub(crate) const MF_PACK2X16UNORM: i64 = 63;\npub(crate) const MF_UNPACK2X16UNORM: i64 = 64;\npub(crate) const MF_PACK2X16SNORM: i64 = 65;\npub(crate) const MF_UNPACK2X16SNORM: i64 = 66;\npub(crate) const MF_COUNT: i64 = 67;\n\npub(crate) const DV_DPDX: i64 = 0;\npub(crate) const DV_DPDY: i64 = 1;\npub(crate) const DV_FWIDTH: i64 = 2;\n\n// E_IMAGE_SAMPLE kinds (Expr.d's low byte) and its args: the coordinates,\n// then the array index when the texture is an array, then the kind's\n// operand (bias, level, depth reference).\npub(crate) const IMG_SAMPLE: i64 = 0;\npub(crate) const IMG_SAMPLE_BIAS: i64 = 1;\npub(crate) const IMG_SAMPLE_LEVEL: i64 = 2;\npub(crate) const IMG_SAMPLE_COMPARE: i64 = 3;\npub(crate) const IMG_SAMPLE_COMPARE_LEVEL: i64 = 4;\n\npub(crate) const IQ_SIZE: i64 = 0;\npub(crate) const IQ_LEVELS: i64 = 1;\n");
    buf_str(out, c"pub(crate) const IQ_LAYERS: i64 = 2;\n\n#[derive(Clone, Copy)] pub struct Expr {\n    pub op: u8, pub ty: i64, pub a: i64, pub b: i64, pub c: i64, pub d: i64,\n}\n\n// ---- Shader compiler implementation, ir: Statements (0.22) ----\n\n// a .. b: the expressions evaluated here, in order\npub(crate) const S_EMIT: u8 = 0;\n// a: the block\npub(crate) const S_BLOCK: u8 = 1;\n// a: the condition; b: then; c: else (a block, possibly empty)\npub(crate) const S_IF: u8 = 2;\n// a: the selector (i32 or u32); b, c: cases[b .. b + c]\npub(crate) const S_SWITCH: u8 = 3;\n// a: body; b: continuing; c: the break-if expression, or -1 (evaluated\n// at the end of continuing, after its emits)\npub(crate) const S_LOOP: u8 = 4;\npub(crate) const S_BREAK: u8 = 5;\npub(crate) const S_CONTINUE: u8 = 6;\n// a: the value, or -1\npub(crate) const S_RETURN: u8 = 7;\n// discard\npub(crate) const S_KILL: u8 = 8;\n// a: BARRIER_* bits\npub(crate) const S_BARRIER: u8 = 9;\n// a: the pointer; b: the value\npub(crate) const S_STORE: u8 = 10;\n// a: the function; b, c: args[b .. b + c]; d: the E_CALL_RESULT or -1\npub(crate) const S_CALL: u8 = 11;\n// a: the pointer; b: AT_*; c: the value; d: the E_ATOMIC_RESULT or -1;\n// e: the comparand (AT_CMPXCHG) or -1\npub(crate) const S_ATOMIC: u8 = 12;\n// a: the texture; b: the coordinates; c: the value; d: the array index or -1\npub(crate) const S_IMAGE_STORE: u8 = 13;\n// a: the pointer; b: the E_WG_UNIFORM_RESULT\npub(crate) const S_WG_UNIFORM_LOAD: u8 = 14;\n\npub(crate) const BARRIER_WORKGROUP: i64 = 1;\npub(crate) const BARRIER_STORAGE: i64 = 2;\n\npub(crate) const AT_ADD: i64 = 0;\npub(crate) const AT_SUB: i64 = 1;\npub(crate) const AT_AND: i64 = 2;\npub(crate) const AT_OR: i64 = 3;\npub(crate) const AT_XOR: i64 = 4;\npub(crate) const AT_MIN: i64 = 5;\npub(crate) const AT_MAX: i64 = 6;\npub(crate) const AT_EXCHANGE: i64 = 7;\npub(crate) const AT_LOAD: i64 = 8;\npub(crate) const AT_STORE: i64 = 9;\n");
    buf_str(out, c"// the result is __atomic_compare_exchange_result: { old_value, exchanged }\npub(crate) const AT_CMPXCHG: i64 = 10;\n\n#[derive(Clone, Copy)] pub struct Stmt {\n    pub op: u8, pub a: i64, pub b: i64, pub c: i64, pub d: i64, pub e: i64,\n}\n\n// A switch clause: its selector values (vals[vstart .. vstart + vcount]),\n// whether it is the default, its body.\n#[derive(Clone, Copy)] pub struct Case {\n    pub vstart: i64, pub vcount: i64, pub is_default: bool, pub body: i64,\n}\n\n// A run of statement handles: items[start .. start + count].\n#[derive(Clone, Copy)] pub struct Block { pub start: i64, pub count: i64 }\n\n#[derive(Clone, Copy)] pub struct Param<'a> {\n    pub name: &'a [u8], pub ty: i64, pub binding: Binding,\n}\n\n#[derive(Clone, Copy)] pub struct Local<'a> { pub name: &'a [u8], pub ty: i64 }\n\npub(crate) struct Function<'a, A: Allocator> {\n    pub(crate) name: &'a [u8],\n    pub(crate) params: Vec<Param<'a>, A>,\n    // -1: no result\n    pub(crate) result: i64,\n    pub(crate) result_binding: Binding,\n    pub(crate) locals: Vec<Local<'a>, A>,\n    pub(crate) exprs: Vec<Expr, A>,\n    // the names of `let` declarations: names[e] for expression e, or \"\"\n    pub(crate) names: Vec<&'a [u8], A>,\n    pub(crate) stmts: Vec<Stmt, A>,\n    pub(crate) blocks: Vec<Block, A>,\n    pub(crate) items: Vec<i64, A>,\n    pub(crate) args: Vec<i64, A>,\n    pub(crate) cases: Vec<Case, A>,\n    pub(crate) vals: Vec<i64, A>,\n    pub(crate) body: i64,\n    // the source position of the declaration (a byte offset)\n    pub(crate) pos: i64,\n}\n\n#[derive(Clone, Copy)] pub struct Global<'a> {\n    pub(crate) name: &'a [u8],\n    pub(crate) space: u8,\n    pub(crate) access: u8,\n    // the value's type (a texture, a sampler, or what the pointer points to)\n    pub(crate) ty: i64,\n    pub(crate) group: i64,\n    pub(crate) binding: i64,\n    // private globals: an expression of the module's init function, or -1\n    pub(crate) init: i64,\n    pub(crate) pos: i64,\n}\n\n");
    buf_str(out, c"pub(crate) const STAGE_VERTEX: u8 = 0;\npub(crate) const STAGE_FRAGMENT: u8 = 1;\npub(crate) const STAGE_COMPUTE: u8 = 2;\n\n#[derive(Clone, Copy)] pub struct Entry<'a> {\n    pub(crate) stage: u8, pub name: &'a [u8], pub func: i64, pub wg: [i64; 3],\n    pub early_depth: bool,\n}\n\n#[derive(PartialEq, Eq, Hash, Clone, Copy)]\npub(crate) struct TypeKey { kind: u8, scalar: u8, space: u8, access: u8, n: i64, m: i64, base: i64 }\n\npub(crate) struct Module<'a, A: Allocator> {\n    pub(crate) types: Vec<Type<'a>, A>,\n    types_map: HashMap<TypeKey, i64, A>,\n    pub(crate) members: Vec<StructMember<'a>, A>,\n    pub(crate) globals: Vec<Global<'a>, A>,\n    pub(crate) functions: Vec<Function<'a, A>, A>,\n    pub(crate) entries: Vec<Entry<'a>, A>,\n    // private globals' initializers live in this function's expressions\n    // (literals, zero, compose only)\n    pub(crate) consts: Function<'a, A>,\n    pub(crate) a: A,\n}\n\n// ---- Shader compiler implementation, ir: Fixed type handles (0.22) ----\n\npub(crate) const T_BOOL: i64 = 0;\npub(crate) const T_I32: i64 = 1;\npub(crate) const T_U32: i64 = 2;\npub(crate) const T_F32: i64 = 3;\n\n// vecN<scalar>: 4 + (n - 2) * 4 + scalar, for n in 2..4 and the four\n// concrete scalars\n#[effects()]\npub(crate) fn vec_ty(sk: u8, n: i64) -> i64 {\n    if n == 1 {\n        return sk as i64;\n    }\n    4 + (n - 2) * 4 + sk as i64\n}\n\n// matCxR<f32>: 16 + (c - 2) * 3 + (r - 2)\n#[effects()]\npub(crate) fn mat_ty(c: i64, r: i64) -> i64 { 16 + (c - 2) * 3 + (r - 2) }\n\npub(crate) const T_FIXED_COUNT: i64 = 25;\n\n#[effects(A)]\npub(crate) fn new_function<'a, A: Allocator + Copy>(name: &'a [u8], a: A) -> Function<'a, A> {\n    Function {\n        name: name,\n        params: Vec::new_in(a),\n        result: -1,\n        result_binding: no_binding(),\n        locals: Vec::new_in(a),\n        exprs: Vec::new_in(a),\n        names: Vec::new_in(a),\n        stmts: Vec::new_in(a),\n        blocks: Vec::new_in(a),\n");
    buf_str(out, c"        items: Vec::new_in(a),\n        args: Vec::new_in(a),\n        cases: Vec::new_in(a),\n        vals: Vec::new_in(a),\n        body: -1,\n        pos: 0,\n    }\n}\n\nfn round_up(x: i64, a: i64) -> i64 { (x + a - 1) / a * a }\n\nimpl<'a, A: Allocator + Copy> Module<'a, A> {\n    #[effects(A)]\n    pub(crate) fn new(a: A) -> Module<'a, A> {\n        let mut m = Module {\n            types: Vec::new_in(a),\n            types_map: HashMap::new_in(a),\n            members: Vec::new_in(a),\n            globals: Vec::new_in(a),\n            functions: Vec::new_in(a),\n            entries: Vec::new_in(a),\n            consts: new_function(b\"\", a),\n            a: a,\n        };\n        for sk in 0..4 {\n            m.push_type(TK_SCALAR, sk as u8, 1, 1, -1);\n        }\n        for n in 2..5 {\n            for sk in 0..4 {\n                m.push_type(TK_VECTOR, sk as u8, n, 1, -1);\n            }\n        }\n        for c in 2..5 {\n            for r in 2..5 {\n                m.push_type(TK_MATRIX, SK_F32, c, r, -1);\n            }\n        }\n        m\n    }\n\n    fn push_type(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64) -> i64 {\n        let mut t = Type {\n            kind: kind,\n            scalar: sk,\n            space: 0,\n            access: 0,\n            n: n,\n            m: mm,\n            base: base,\n            mstart: 0,\n            mcount: 0,\n            name: b\"\",\n            size: 4,\n            align: 4,\n            stride: 0,\n        };\n        if kind == TK_VECTOR {\n            t.size = 4 * n;\n            t.align = if n == 2 { 8 } else { 16 };\n        } else if kind == TK_MATRIX {\n            let col_align: i64 = if mm == 2 { 8 } else { 16 };\n            t.align = col_align;\n            t.stride = round_up(4 * mm, col_align);\n            t.size = n * t.stride;\n        }\n        self.types.push(t);\n        self.types.len() as i64 - 1\n    }\n\n    // The handle of a type made of these parts, made once.\n");
    buf_str(out, c"    #[effects(panic, A)]\n    pub(crate) fn intern(&mut self, kind: u8, sk: u8, n: i64, mm: i64, base: i64, space: u8,\n        access: u8) -> i64 {\n        if kind == TK_SCALAR {\n            return sk as i64;\n        }\n        if kind == TK_VECTOR {\n            return vec_ty(sk, n);\n        }\n        if kind == TK_MATRIX {\n            return mat_ty(n, mm);\n        }\n        let key = TypeKey {\n            kind: kind, scalar: sk, space: space, access: access, n: n, m: mm, base: base,\n        };\n        if let Some(h) = self.types_map.get(&key).copied() {\n            return h;\n        }\n        let h = self.push_type(kind, sk, n, mm, base);\n        self.types[h as usize].space = space;\n        self.types[h as usize].access = access;\n        if kind == TK_ARRAY {\n            let el = self.types[base as usize];\n            let stride = round_up(el.size, el.align);\n            self.types[h as usize].align = el.align;\n            self.types[h as usize].stride = stride;\n            self.types[h as usize].size = if n == 0 { stride } else { stride * n };\n        } else if kind == TK_POINTER {\n            self.types[h as usize].size = 8;\n            self.types[h as usize].align = 8;\n        } else if kind == TK_TEXTURE || kind == TK_SAMPLER {\n            self.types[h as usize].size = 8;\n            self.types[h as usize].align = 8;\n        }\n        self.types_map.insert(key, h);\n        h\n    }\n\n    #[effects(A)]\n    pub(crate) fn array_ty(&mut self, elem: i64, n: i64) -> i64 {\n        self.intern(TK_ARRAY, 0, n, 0, elem, 0, 0)\n    }\n\n    #[effects(A)]\n    pub(crate) fn ptr_ty(&mut self, pointee: i64, space: u8, access: u8) -> i64 {\n        self.intern(TK_POINTER, 0, 0, 0, pointee, space, access)\n    }\n\n    #[effects(A)]\n    pub(crate) fn atomic_ty(&mut self, sk: u8) -> i64 { self.intern(TK_ATOMIC, sk, 0, 0, -1, 0, 0) }\n\n    // A struct type: a new handle for each declaration (structs are\n");
    buf_str(out, c"    // nominal); members[mstart ..] must already be pushed, offsets unset.\n    #[effects(panic, A)]\n    pub(crate) fn struct_ty(&mut self, name: &'a [u8], mstart: i64, mcount: i64) -> i64 {\n        let h = self.push_type(TK_STRUCT, 0, 0, 0, -1);\n        let mut off: i64 = 0;\n        let mut al: i64 = 4;\n        for i in mstart..mstart + mcount {\n            let t = self.types[self.members[i as usize].ty as usize];\n            off = round_up(off, t.align);\n            self.members[i as usize].offset = off;\n            off += t.size;\n            if t.align > al {\n                al = t.align;\n            }\n        }\n        self.types[h as usize].name = name;\n        self.types[h as usize].mstart = mstart;\n        self.types[h as usize].mcount = mcount;\n        self.types[h as usize].align = al;\n        self.types[h as usize].size = round_up(off, al);\n        h\n    }\n\n    // The scalar kind of a scalar, vector, matrix or atomic type.\n    pub(crate) fn scalar_of(&self, t: i64) -> u8 { self.types[t as usize].scalar }\n\n    // The component count of a scalar (1) or vector type, else 0.\n    #[effects(panic, A)]\n    pub(crate) fn width_of(&self, t: i64) -> i64 {\n        let k = self.types[t as usize].kind;\n        if k == TK_SCALAR {\n            1\n        } else if k == TK_VECTOR {\n            self.types[t as usize].n\n        } else {\n            0\n        }\n    }\n\n    // The pointee of a pointer type, else -1.\n    #[effects(panic, A)]\n    pub(crate) fn pointee(&self, t: i64) -> i64 {\n        if self.types[t as usize].kind == TK_POINTER {\n            self.types[t as usize].base\n        } else {\n            -1\n        }\n    }\n\n    // The type of a component of t when indexed: a vector's scalar, a\n    // matrix's column, an array's element; -1 for the others.\n    #[effects(panic, A)]\n    pub(crate) fn elem_of(&self, t: i64) -> i64 {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_VECTOR {\n");
    buf_str(out, c"            ty.scalar as i64\n        } else if ty.kind == TK_MATRIX {\n            vec_ty(SK_F32, ty.m)\n        } else if ty.kind == TK_ARRAY {\n            ty.base\n        } else {\n            -1\n        }\n    }\n\n    // How many components indexing t can reach: 0 for a runtime-sized array.\n    #[effects(panic, A)]\n    pub(crate) fn index_len(&self, t: i64) -> i64 {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_VECTOR || ty.kind == TK_ARRAY {\n            ty.n\n        } else if ty.kind == TK_MATRIX {\n            ty.n\n        } else {\n            -1\n        }\n    }\n\n    // Whether t is or holds a runtime-sized array.\n    #[effects(panic, A)]\n    pub(crate) fn is_runtime_sized(&self, t: i64) -> bool {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_ARRAY {\n            return ty.n == 0;\n        }\n        if ty.kind == TK_STRUCT && ty.mcount > 0 {\n            return self.is_runtime_sized(self.members[(ty.mstart + ty.mcount - 1) as usize].ty);\n        }\n        false\n    }\n\n    // Whether t contains an atomic (such types cannot be loaded whole).\n    #[effects(panic, A)]\n    pub(crate) fn has_atomic(&self, t: i64) -> bool {\n        let ty = self.types[t as usize];\n        if ty.kind == TK_ATOMIC {\n            return true;\n        }\n        if ty.kind == TK_ARRAY {\n            return self.has_atomic(ty.base);\n        }\n        if ty.kind == TK_STRUCT {\n            for i in ty.mstart..ty.mstart + ty.mcount {\n                if self.has_atomic(self.members[i as usize].ty) {\n                    return true;\n                }\n            }\n        }\n        false\n    }\n\n    // The type written as WGSL, for messages and the IR dump.\n    #[effects(alloc(extern), io, static, panic, diverge, A, B)]\n    pub(crate) fn type_name<B: Allocator>(&self, t: i64, b: &mut Vec<u8, B>) {\n        if t < 0 {\n            b.extend_from_slice(b\"void\");\n            return;\n        }\n");
    buf_str(out, c"        let ty = self.types[t as usize];\n        if ty.kind == TK_SCALAR {\n            b.extend_from_slice(scalar_name(ty.scalar));\n        } else if ty.kind == TK_VECTOR {\n            write(b, \"vec{}<{}>\", ty.n, str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n        } else if ty.kind == TK_MATRIX {\n            write(b, \"mat{}x{}<f32>\", ty.n, ty.m).unwrap();\n        } else if ty.kind == TK_ARRAY {\n            b.extend_from_slice(b\"array<\");\n            self.type_name(ty.base, b);\n            if ty.n > 0 {\n                write(b, \", {}\", ty.n).unwrap();\n            }\n            b.push(b'>');\n        } else if ty.kind == TK_STRUCT {\n            b.extend_from_slice(ty.name);\n        } else if ty.kind == TK_ATOMIC {\n            write(b, \"atomic<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n        } else if ty.kind == TK_POINTER {\n            write(b, \"ptr<{}, \", str::from_utf8(space_name(ty.space)).unwrap()).unwrap();\n            self.type_name(ty.base, b);\n            if ty.space == SP_STORAGE {\n                b.extend_from_slice((if ty.access == ACC_RW { b\", read_write\" }\n                    else { b\", read\" }));\n            }\n            b.push(b'>');\n        } else if ty.kind == TK_TEXTURE {\n            if ty.n == TEX_2D {\n                write(b, \"texture_2d<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n            } else if ty.n == TEX_2D_ARRAY {\n                write(b, \"texture_2d_array<{}>\", str::from_utf8(scalar_name(ty.scalar)).unwrap()).unwrap();\n            } else if ty.n == TEX_DEPTH_2D {\n                b.extend_from_slice(b\"texture_depth_2d\");\n            } else {\n                write(b, \"texture_storage_2d<{}, write>\",\n                    str::from_utf8(format_name(ty.m)).unwrap()).unwrap();\n            }\n        } else if ty.n == 1 {\n            b.extend_from_slice(b\"sampler_comparison\");\n        } else {\n");
    buf_str(out, c"            b.extend_from_slice(b\"sampler\");\n        }\n    }\n}\n\n#[effects()]\npub(crate) fn scalar_name(sk: u8) -> &'static [u8] {\n    if sk == SK_BOOL {\n        b\"bool\"\n    } else if sk == SK_I32 {\n        b\"i32\"\n    } else if sk == SK_U32 {\n        b\"u32\"\n    } else if sk == SK_F32 {\n        b\"f32\"\n    } else if sk == SK_AINT {\n        b\"abstract-int\"\n    } else {\n        b\"abstract-float\"\n    }\n}\n\n#[effects()]\npub(crate) fn space_name(sp: u8) -> &'static [u8] {\n    if sp == SP_FUNCTION {\n        b\"function\"\n    } else if sp == SP_PRIVATE {\n        b\"private\"\n    } else if sp == SP_WORKGROUP {\n        b\"workgroup\"\n    } else if sp == SP_UNIFORM {\n        b\"uniform\"\n    } else if sp == SP_STORAGE {\n        b\"storage\"\n    } else {\n        b\"handle\"\n    }\n}\n\n#[effects()]\npub(crate) fn format_name(f: i64) -> &'static [u8] {\n    if f == FMT_RGBA8UNORM {\n        b\"rgba8unorm\"\n    } else if f == FMT_RGBA32FLOAT {\n        b\"rgba32float\"\n    } else if f == FMT_R32FLOAT {\n        b\"r32float\"\n    } else if f == FMT_R32UINT {\n        b\"r32uint\"\n    } else if f == FMT_R32SINT {\n        b\"r32sint\"\n    } else if f == FMT_RGBA16FLOAT {\n        b\"rgba16float\"\n    } else if f == FMT_RGBA8UINT {\n        b\"rgba8uint\"\n    } else if f == FMT_RG32FLOAT {\n        b\"rg32float\"\n    } else {\n        b\"rgba32uint\"\n    }\n}\n\n// ---- Shader compiler implementation, ir: Building functions (0.22) ----\n\nimpl<'a, A: Allocator + Copy> Function<'a, A> {\n    #[effects(A)]\n    pub(crate) fn expr(&mut self, op: u8, ty: i64, a: i64, b: i64, c: i64) -> i64 {\n        self.exprs.push(Expr { op: op, ty: ty, a: a, b: b, c: c, d: 0 });\n        self.names.push(b\"\");\n        self.exprs.len() as i64 - 1\n    }\n\n    #[effects(A)]\n    pub(crate) fn stmt(&mut self, op: u8, a: i64, b: i64, c: i64, d: i64) -> i64 {\n        self.stmts.push(Stmt { op: op, a: a, b: b, c: c, d: d, e: -1 });\n");
    buf_str(out, c"        self.stmts.len() as i64 - 1\n    }\n\n    // A block of the statements pending[from ..], which are removed from\n    // pending.\n    #[effects(panic, A)]\n    pub(crate) fn block_of(&mut self, pending: &mut Vec<i64, A>, from: i64) -> i64 {\n        let start = self.items.len() as i64;\n        for i in from..pending.len() as i64 {\n            self.items.push(pending[i as usize]);\n        }\n        let count = pending.len() as i64 - from;\n        pending.truncate(from as usize);\n        self.blocks.push(Block { start: start, count: count });\n        self.blocks.len() as i64 - 1\n    }\n\n    #[effects(A)]\n    pub(crate) fn empty_block(&mut self) -> i64 {\n        self.blocks.push(Block { start: self.items.len() as i64, count: 0 });\n        self.blocks.len() as i64 - 1\n    }\n\n    pub(crate) fn arg(&self, i: i64) -> i64 { self.args[i as usize] }\n\n    pub(crate) fn item(&self, blk: i64, i: i64) -> i64 { self.items[\n        (self.blocks[blk as usize].start + i) as usize] }\n}\n\n// The byte offsets of function h's parameters in a record holding them\n// all, each at its alignment (WGSL's layout); the record's size, rounded\n// to 16, is the last element.\npub(crate) fn record_offsets<A: Allocator + Copy>(m: &Module<'_, A>, h: i64, a: A) -> Vec<i64, A> {\n    let mut offs: Vec<i64, A> = Vec::new_in(a);\n    let mut off: i64 = 0;\n    let f = &m.functions[h as usize];\n    for k in 0..f.params.len() as i64 {\n        let t = m.types[f.params[k as usize].ty as usize];\n        off = round_up(off, t.align);\n        offs.push(off);\n        off += t.size;\n    }\n    offs.push(round_up(off, 16));\n    offs\n}\n\n// The bytes a value of type t takes in an array of them (its stride).\npub(crate) fn stride_of<A: Allocator + Copy>(m: &Module<'_, A>, t: i64) -> i64 {\n    let ty = m.types[t as usize];\n    round_up(ty.size, ty.align)\n}\n\n// Statements and expressions that end a block's flow.\n#[effects()]\npub(crate) fn is_terminator(op: u8) -> bool {\n");
    buf_str(out, c"    op == S_BREAK || op == S_CONTINUE || op == S_RETURN || op == S_KILL\n}\n\n// The bits of an f32, and back.\n#[effects()]\npub(crate) fn f32_bits(f: f32) -> u32 { f.to_bits() }\n\n#[effects()]\npub(crate) fn bits_f32(u: u32) -> f32 { f32::from_bits(u) }\n\n#[effects()]\npub(crate) fn f64_bits(f: f64) -> u64 { f.to_bits() }\n// ---- end mod std::gpu::wgsl::ir ----\n}\n// ---- mod std::gpu::wgsl::names ----\nmod names {\n// EDITION: rust\n// ---- Shader compiler implementation, names (0.22) ----\n// The predeclared names of WGSL: keywords, types, attributes and builtins.\n// The lexer interns them first, so each has the fixed symbol below. The\n// math functions are in MF_* order (ir.vl): K_ABS + MF_x is MF_x's name.\n\npub(crate) const PREDECLARED: [&[u8]; 237] = [\n    b\"fn\",\n    b\"let\",\n    b\"var\",\n    b\"const\",\n    b\"struct\",\n    b\"return\",\n    b\"if\",\n    b\"else\",\n    b\"for\",\n    b\"while\",\n    b\"loop\",\n    b\"break\",\n    b\"continue\",\n    b\"continuing\",\n    b\"switch\",\n    b\"case\",\n    b\"default\",\n    b\"discard\",\n    b\"true\",\n    b\"false\",\n    b\"alias\",\n    b\"override\",\n    b\"enable\",\n    b\"requires\",\n    b\"diagnostic\",\n    b\"const_assert\",\n    b\"fallthrough\",\n    b\"bool\",\n    b\"i32\",\n    b\"u32\",\n    b\"f32\",\n    b\"f16\",\n    b\"vec2\",\n    b\"vec3\",\n    b\"vec4\",\n    b\"vec2i\",\n    b\"vec3i\",\n    b\"vec4i\",\n    b\"vec2u\",\n    b\"vec3u\",\n    b\"vec4u\",\n    b\"vec2f\",\n    b\"vec3f\",\n    b\"vec4f\",\n    b\"vec2h\",\n    b\"vec3h\",\n    b\"vec4h\",\n    b\"mat2x2\",\n    b\"mat2x3\",\n    b\"mat2x4\",\n    b\"mat3x2\",\n    b\"mat3x3\",\n    b\"mat3x4\",\n    b\"mat4x2\",\n    b\"mat4x3\",\n    b\"mat4x4\",\n    b\"mat2x2f\",\n    b\"mat2x3f\",\n    b\"mat2x4f\",\n    b\"mat3x2f\",\n    b\"mat3x3f\",\n    b\"mat3x4f\",\n    b\"mat4x2f\",\n    b\"mat4x3f\",\n    b\"mat4x4f\",\n    b\"array\",\n    b\"atomic\",\n    b\"ptr\",\n    b\"sampler\",\n");
    buf_str(out, c"    b\"sampler_comparison\",\n    b\"texture_2d\",\n    b\"texture_2d_array\",\n    b\"texture_depth_2d\",\n    b\"texture_storage_2d\",\n    b\"texture_1d\",\n    b\"texture_3d\",\n    b\"texture_cube\",\n    b\"texture_cube_array\",\n    b\"texture_multisampled_2d\",\n    b\"texture_depth_2d_array\",\n    b\"texture_depth_cube\",\n    b\"texture_external\",\n    b\"texture_storage_1d\",\n    b\"texture_storage_3d\",\n    b\"texture_storage_2d_array\",\n    b\"function\",\n    b\"private\",\n    b\"workgroup\",\n    b\"uniform\",\n    b\"storage\",\n    b\"read\",\n    b\"write\",\n    b\"read_write\",\n    b\"rgba8unorm\",\n    b\"rgba32float\",\n    b\"r32float\",\n    b\"r32uint\",\n    b\"r32sint\",\n    b\"rgba32uint\",\n    b\"vertex\",\n    b\"fragment\",\n    b\"compute\",\n    b\"workgroup_size\",\n    b\"builtin\",\n    b\"location\",\n    b\"group\",\n    b\"binding\",\n    b\"interpolate\",\n    b\"flat\",\n    b\"linear\",\n    b\"perspective\",\n    b\"center\",\n    b\"centroid\",\n    b\"sample\",\n    b\"align\",\n    b\"size\",\n    b\"id\",\n    b\"invariant\",\n    b\"must_use\",\n    b\"position\",\n    b\"vertex_index\",\n    b\"instance_index\",\n    b\"front_facing\",\n    b\"frag_depth\",\n    b\"sample_index\",\n    b\"sample_mask\",\n    b\"local_invocation_id\",\n    b\"local_invocation_index\",\n    b\"global_invocation_id\",\n    b\"workgroup_id\",\n    b\"num_workgroups\",\n    b\"abs\",\n    b\"min\",\n    b\"max\",\n    b\"clamp\",\n    b\"sign\",\n    b\"floor\",\n    b\"ceil\",\n    b\"round\",\n    b\"fract\",\n    b\"trunc\",\n    b\"sqrt\",\n    b\"inverseSqrt\",\n    b\"exp\",\n    b\"exp2\",\n    b\"log\",\n    b\"log2\",\n    b\"pow\",\n    b\"sin\",\n    b\"cos\",\n    b\"tan\",\n    b\"asin\",\n    b\"acos\",\n    b\"atan\",\n    b\"atan2\",\n    b\"sinh\",\n    b\"cosh\",\n    b\"tanh\",\n    b\"mix\",\n    b\"step\",\n    b\"smoothstep\",\n    b\"fma\",\n    b\"length\",\n    b\"distance\",\n    b\"dot