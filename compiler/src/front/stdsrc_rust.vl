    buf_str(out, c"            return [m, 0, 0];\n        }\n    }\n    [cp, 0, 0]\n}\n\n// The lowercase of cp, not ASCII: one to three code points, the rest 0\n// (unconditional: `İ` is `i` and U+0307).\n#[effects(panic, diverge)]\npub(crate) fn to_lower(cp: u32) -> [u32; 3] {\n    case_map(LOWER_TABLE, LOWER_MULTI, LOWER_COUNT, cp)\n}\n\n// The uppercase of cp, not ASCII: one to three code points, the rest 0\n// (`ß` is `SS`).\n#[effects(panic, diverge)]\npub(crate) fn to_upper(cp: u32) -> [u32; 3] {\n    case_map(UPPER_TABLE, UPPER_MULTI, UPPER_COUNT, cp)\n}\n\n// ---- The tables ----\n\nconst CLASSES_SHIFT2: usize = 4;\nconst CLASSES_SHIFT1: usize = 9;\nconst CLASSES_MASK2: usize = 31;\nconst CLASSES_MASK3: usize = 15;\nconst CLASSES_WIDE1: bool = false;\nconst CLASSES_WIDE2: bool = true;\nconst CLASSES_S1: &str = \"!\\x22#$%&'()*+,-./01234225678999999\\\n    999999:9999999999999999999999999\\\n    999999999999999999;<=>9999999999\\\n    99999999999?2222222222222222@\\x41\\x42\\x43\\\n    \\x44\\x45\\x46\\x47\\x48\\x49\\x4a\\x4b\\x4c\\x4d\\x4e\\x4f\\x50\\x51\\x52\\x539\\x54\\x55\\x56222\\x5799\\x5899999\\\n    9\\x599\\x5a222222222222\\x5b2229\\x5c\\x5d\\x5e99999999\\\n    999999\\x5f9\\x6022222222222222\\x61\\x62\\x632222\\x642\\\n    222222\\x6522\\x66\\x67\\x68222\\x69\\x6a\\x6b\\x6c\\x6d\\x6e2\\x6f\\x70\\x712222\\x7222\\\n    99999999999999999999999999999999\\\n    99999999999999999999999999999999\\\n    9999999999999999999\\x7399999999\\x74999\\\n    9999999\\x759999999999999\\x769\\x7722229\\x7822\\\n    999999999\\x799999999999999999\\x7a22222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    222222229999999999999999999999\\x7b2\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n    22222222222222222222222222222222\\\n");
