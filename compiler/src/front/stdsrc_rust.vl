    buf_str(out, c"    // UNSAFE: Core Graphics and Core Foundation C calls.\n    // SAFETY: CGSessionCopyCurrentDictionary returns a +1 dictionary or\n    // null; it is released.\n    unsafe {\n        let d = CGSessionCopyCurrentDictionary();\n        if d == 0 as *mut u8 {\n            return false;\n        }\n        CFRelease(d);\n        true\n    }\n}\n\n// (0.25.2.1) The monotonic clock in nanoseconds (0.28.0: std::time's\n// Instant, the same clock; no extern of this module's own).\nfn now_ns() -> i64 {\n    crate::time::Instant::now().as_nanos() as i64\n}\n\n// (0.25.2.1) Whether the window is not shown (occlusionState lacks\n// NSWindowOcclusionStateVisible, 1 << 1).\n// UNSAFE: an Objective-C message on a raw NSWindow pointer.\n// SAFETY: the caller passes a live NSWindow; occlusionState takes nothing\n// and returns an NSUInteger.\nunsafe fn occluded(win: *mut u8) -> bool {\n    (msg_u(win, sel(c\"occlusionState\")) & 2) == 0\n}\n\n// (0.25.2.1) Why a window's display link gives no frames, for the\n// diagnostic: the display asleep, the screen locked, or the window\n// occluded (`hidden`).\n// UNSAFE: CoreGraphics' C functions and Objective-C messages on the raw\n// CFDictionary and CFBoolean they return.\n// SAFETY: CGSessionCopyCurrentDictionary's result is a +1 dictionary or\n// null, released once after its last use; objectForKey: takes the NSString\n// (autoreleased in the pool popped before the release) and returns a\n// value the dictionary holds, or null, checked before boolValue;\n// CGDisplayIsAsleep takes any display id.\nunsafe fn quiet_reason(hidden: bool) -> &'static [u8] {\n    // Asleep first: a locked screen still shows windows while it is awake.\n    if CGDisplayIsAsleep(CGMainDisplayID()) != 0 {\n        return b\"the display is asleep\";\n    }\n    let d = CGSessionCopyCurrentDictionary();\n    if d != 0 as *mut u8 {\n        let pool = pool_push();\n        // The session dictionary (toll-free bridged to NSDictionary):\n");
