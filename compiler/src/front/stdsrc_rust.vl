    buf_str(out, c"    fn __int_from(v: u64) -> i8 { v as i8 }\n}\n\nimpl __IntBits for i16 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i16 { v as i16 }\n}\n\nimpl __IntBits for i32 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i32 { v as i32 }\n}\n\nimpl __IntBits for i64 {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> i64 { v as i64 }\n}\n\nimpl __IntBits for isize {\n    fn __int_bits(self) -> (u64, bool) { (self as i64 as u64, true) }\n    fn __int_from(v: u64) -> isize { v as isize }\n}\n\nimpl __IntBits for u8 {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> u8 { v as u8 }\n}\n\nimpl __IntBits for u16 {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> u16 { v as u16 }\n}\n\nimpl __IntBits for u32 {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> u32 { v as u32 }\n}\n\nimpl __IntBits for u64 {\n    fn __int_bits(self) -> (u64, bool) { (self, false) }\n    fn __int_from(v: u64) -> u64 { v }\n}\n\nimpl __IntBits for usize {\n    fn __int_bits(self) -> (u64, bool) { (self as u64, false) }\n    fn __int_from(v: u64) -> usize { v as usize }\n}\n\n// Every pair of integer types (one impl, not a hundred: the lazy std keeps\n// an impl of a trait for a primitive type in every program).\nimpl<S: __IntBits, T: __IntBits> TryFrom<S> for T {\n    type Error = TryFromIntError;\n\n    fn try_from(x: S) -> Result<T, TryFromIntError> {\n        let (v, negative_kind) = x.__int_bits();\n        // (T's range: is it signed? its -1 has the top bit of 64 set)\n        let (_, signed) = T::__int_from(0).__int_bits();\n        let width = 8 * crate::mem::size_of::<T>() as u64;\n        // (its largest value: width - 1 ones when signed, width ones when not)\n");
    buf_str(out, c"        let max: u64 = if signed { (1u64 << (width - 1)) - 1 }\n            else if width == 64 { 0xffffffffffffffff }\n            else { (1u64 << width) - 1 };\n        if negative_kind && (v as i64) < 0 {\n            // (its smallest: -(max + 1) when signed, 0 when not)\n            if !signed || (v as i64) < -(max as i64) - 1 {\n                return Result::Err(crate::convert::int_range_error(true));\n            }\n        } else if v > max {\n            return Result::Err(crate::convert::int_range_error(false));\n        }\n        Result::Ok(T::__int_from(v))\n    }\n}\n\n// std::num::Wrapping<T> (0.28.0), as Rust's: an integer T whose `+`, `-`,\n// `*`, `/`, `%`, unary `-` and shifts wrap at T's width instead of\n// panicking (a shift's count is taken modulo the width; `/` and `%` by zero\n// still panic); `!`, `&`, `|`, `^`; each with its assignment (`+=` takes a\n// Wrapping<T> or a T); Display, Debug and the radix formats are T's; Sum\n// and Product. The arithmetic is done on the value's 64 bits (__IntBits) and\n// cut to T's width: one generic impl an operator, kept only by a program\n// that names Wrapping. Not there: the impls for references (`&a + &b`), the\n// constants MIN, MAX and BITS, to_be, to_le, from_be, from_le. abs, signum,\n// is_positive and is_negative (Rust: signed T only) and is_power_of_two\n// (Rust: unsigned T only) are there for every T.\n#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]\npub struct Wrapping<T>(pub T);\n\n// T's width in bits, and the mask of its bits in 64.\n#[effects()]\nfn wrap_width<T: __IntBits>() -> (u64, u64) {\n    let width = 8 * crate::mem::size_of::<T>() as u64;\n    (width, if width == 64 { 0xffffffffffffffff } else { (1u64 << width) - 1 })\n}\n\n// T's value as its width's bits, zero-extended.\n#[effects()]\nfn wrap_bits<T: __IntBits>(x: T) -> u64 {\n    let (_, mask) = wrap_width::<T>();\n    x.__int_bits().0 & mask\n}\n\n");
    buf_str(out, c"impl<T: __IntBits + Copy> crate::ops::Add for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn add(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a.wrapping_add(b)))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Sub for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn sub(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a.wrapping_sub(b)))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::Mul for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn mul(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a.wrapping_mul(b)))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitAnd for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn bitand(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a & b))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitOr for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn bitor(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a | b))\n    }\n}\n\nimpl<T: __IntBits + Copy> crate::ops::BitXor for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn bitxor(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let a = self.0.__int_bits().0;\n        let b = rhs.0.__int_bits().0;\n        Wrapping(T::__int_from(a ^ b))\n    }\n}\n\n// (by zero: a panic, as T's)\nimpl<T: __IntBits + Copy> crate::ops::Div for Wrapping<T> {\n    type Output = Wrapping<T>;\n\n    fn div(self, rhs: Wrapping<T>) -> Wrapping<T> {\n        let (a, signed) = self.0.__int_bits();\n        let b = rhs.0.__int_