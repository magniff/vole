    buf_str(out, c"    fn create_surface(d: &Device, raw: RawSurface) -> Option<Surface> {\n        if !open_frameworks() { return None; }\n        let layer = match raw {\n            // (0.25.4) null: a scripted window's (std::window, VOLE_WINDOW_SCRIPT),\n            // offscreen like Headless\n            RawSurface::MetalLayer(p) if p == 0 as *mut u8 => {\n                crate::objc::pool(|| CAMetalLayer::layer().retain())\n            }\n            RawSurface::MetalLayer(p) => {\n                // UNSAFE: the window library's layer arrives as a raw pointer.\n                // SAFETY: RawSurface::MetalLayer holds the CAMetalLayer std::window made for a\n                // live window (its documented meaning); the retain keeps it from here on.\n                let r = unsafe { Ref::<CAMetalLayer>::from_global(p) };\n                r.retain()\n            }\n            // an unattached layer: its drawables are offscreen\n            RawSurface::Headless => crate::objc::pool(|| CAMetalLayer::layer().retain()),\n        };\n        if layer.is_nil() { return None; }\n        layer.r().set_device(Some(d.dev.r()));\n        Some(Surface { layer: layer })\n    }\n\n    fn configure(s: &mut Surface, d: &Device, width: i64, height: i64, format: Format, vsync: bool) {\n        let l = s.layer.r();\n        l.set_device(Some(d.dev.r()));\n        l.set_pixel_format(pixel_format(format));\n        l.set_drawable_size(CGSize { width: width as f64, height: height as f64 });\n        l.set_framebuffer_only(false);\n        l.set_maximum_drawable_count(3);\n        l.set_display_sync_enabled(vsync);\n    }\n\n    fn next_frame(s: &mut Surface) -> Option<(Frame, Texture)> {\n        let l = s.layer.r();\n        let _pool = crate::objc::Pool::push();\n        match l.next_drawable() {\n            Some(dr) => {\n                let tex = dr.texture().retain();\n                Some((Frame { drawable: dr.retain() }, Texture { raw: tex }))\n            }\n            None => None,\n        }\n");
    buf_str(out, c"    }\n\n    fn present(q: &mut Queue, f: &Frame) {\n        let mut cb = begin_on(q.q.r());\n        // UNSAFE: a cast between protocols, which the table does not relate.\n        // SAFETY: CAMetalDrawable is declared `@protocol CAMetalDrawable <MTLDrawable>`, so\n        // every CAMetalDrawable is an MTLDrawable; f.drawable keeps it alive.\n        let d = unsafe { f.drawable.r().cast::<bindings::MTLDrawable>() };\n        cb.cb.r().present_drawable(d);\n        Metal::submit(q, &mut cb);\n    }\n}\n// ---- mod std::gpu::hal::metal::bindings ----\npub mod bindings {\n// EDITION: rust\n// Generated by tools/objcgen from compiler/std2/objc/tables/metal.objc: do not edit.\n// Every prototype below is checked against the Objective-C runtime's\n// type encoding by `objcgen --check`, and every constant and struct\n// against the SDK's headers by `objcgen --c-check` (tests/gpu/run.sh).\n\nuse crate::objc::{Id, Object, Ref, cached_class, cached_selector, opt_ptr};\nuse crate::objc::foundation::{NSArray, NSError, NSString};\nuse crate::sync::atomic::Atomic;\n\n// UNSAFE: objc_msgSend, declared per ABI shape. SAFETY: each shape checked\n// against the runtime (objcgen --check), the structs against the SDK (--c-check).\nextern \"C\" {\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_p(o: *mut u8, s: *mut u8) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_u64(o: *mut u8, s: *mut u8) -> u64;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_bool(o: *mut u8, s: *mut u8) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_MTLSize(o: *mut u8, s: *mut u8) -> MTLSize;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_bool_i64(o: *mut u8, s: *mut u8, a0: i64) -> bool;\n    #[link_name = \"objc_msgSend\"]\n    #[effects(io)]\n    fn msg_p_u64_u64(o: *mut u8, s: *mut u8, a0: u64, a1: u64) -> *mut u8;\n    #[link_name = \"objc_msgSend\"]\n    #[effe