    buf_str(out, c"            SeekFrom::End(o) => (o, 2),\n        };\n        // UNSAFE: C's lseek. SAFETY: integers only.\n        let r = unsafe { fs_c_lseek(self.fd, off, whence) };\n        if r < 0 {\n            return crate::result::Result::Err(Error::last_os_error());\n        }\n        crate::result::Result::Ok(r as u64)\n    }\n}\n\n// How File::open opens a file, Rust's builder:\n// `OpenOptions::new().append(true).create(true).open(p)?`.\n#[derive(Clone, Debug)]\npub struct OpenOptions {\n    read: bool,\n    write: bool,\n    append: bool,\n    truncate: bool,\n    create: bool,\n    create_new: bool,\n    mode: u32,\n}\n\nimpl OpenOptions {\n    // Every option off (open fails until read, write or append is on).\n    #[effects()]\n    pub fn new() -> OpenOptions {\n        OpenOptions { read: false, write: false, append: false, truncate: false, create: false,\n            create_new: false, mode: 0x1b6 }\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn read(&mut self, read: bool) -> &mut OpenOptions {\n        self.read = read;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn write(&mut self, write: bool) -> &mut OpenOptions {\n        self.write = write;\n        self\n    }\n\n    // Writes go to the end (write is implied).\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn append(&mut self, append: bool) -> &mut OpenOptions {\n        self.append = append;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn truncate(&mut self, truncate: bool) -> &mut OpenOptions {\n        self.truncate = truncate;\n        self\n    }\n\n    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create(&mut self, create: bool) -> &mut OpenOptions {\n        self.create = create;\n        self\n    }\n\n");
    buf_str(out, c"    // std2: changed: &mut self, as Rust's (MVS: by value)\n    #[effects()]\n    pub fn create_new(&mut self, create_new: bool) -> &mut OpenOptions {\n        self.create_new = create_new;\n        self\n    }\n\n    // The permission bits a file it makes gets (0x1b6 before the umask).\n    // std2: changed: OpenOptions' own, a u32 (Rust's:\n    // std::os::unix::fs::OpenOptionsExt)\n    #[effects()]\n    pub fn mode(&mut self, mode: u32) -> &mut OpenOptions {\n        self.mode = mode;\n        self\n    }\n\n    // Opens path with these options: InvalidInput (EINVAL) for none of\n    // read, write and append, or a create or truncate without a write, as\n    // Rust's.\n    #[effects(io, static, panic, diverge)]\n    pub fn open<P: AsRef<str>>(&self, path: P) -> Result<File> {\n        let path = path.as_ref();\n        let access = if self.append {\n            (if self.read { O_RDWR } else { O_WRONLY }) | crate::__sys::O_APPEND\n        } else if self.read && self.write {\n            O_RDWR\n        } else if self.write {\n            O_WRONLY\n        } else if self.read {\n            O_RDONLY\n        } else {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        };\n        if !self.write && !self.append && (self.truncate || self.create || self.create_new) {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        if self.append && self.truncate && !self.create_new {\n            return crate::result::Result::Err(Error::from_raw_os_error(EINVAL));\n        }\n        let creation = if self.create_new {\n            crate::__sys::O_CREAT | crate::__sys::O_EXCL\n        } else {\n            (if self.create { crate::__sys::O_CREAT } else { 0 })\n                | (if self.truncate { crate::__sys::O_TRUNC } else { 0 })\n        };\n        open_c(path, access | creation, self.mode)\n    }\n}\n\n// What stat says of a file.\n#[derive(Clone)]\npub struct Metadata {\n    mode: u32,\n");
    buf_str(out, c"    size: u64,\n    mtime: i64,\n    mtime_nsec: i64,\n}\n\nimpl Metadata {\n    // The size in bytes.\n    #[effects()]\n    pub fn len(&self) -> u64 {\n        self.size\n    }\n\n    #[effects()]\n    pub fn file_type(&self) -> FileType {\n        FileType { fmt: self.mode & S_IFMT }\n    }\n\n    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.mode & S_IFMT == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.mode & S_IFMT == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.mode & S_IFMT == S_IFLNK\n    }\n\n    #[effects()]\n    pub fn permissions(&self) -> Permissions {\n        Permissions { mode: self.mode }\n    }\n\n    // When it was last written (UNIX_EPOCH for a time before it).\n    // mvs: Metadata::modified\n    // std2: changed: an io::Result<SystemTime>, as Rust's (MVS: a\n    // Duration since the epoch)\n    #[effects(panic)]\n    pub fn modified(&self) -> Result<SystemTime> {\n        let epoch = crate::time::UNIX_EPOCH;\n        if self.mtime < 0 {\n            return crate::result::Result::Ok(epoch);\n        }\n        let d = crate::time::Duration::new(self.mtime as u64, self.mtime_nsec as u32);\n        match epoch.checked_add(d) {\n            Option::Some(t) => crate::result::Result::Ok(t),\n            Option::None => crate::result::Result::Ok(epoch),\n        }\n    }\n}\n\n// `Metadata { file_type: .., len: 6, .. }`.\n// std2: changed: the kind and the length (Rust's adds the permissions and\n// the times)\nimpl crate::fmt::Debug for Metadata {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"Metadata\").field(\"file_type\", &self.file_type()).field(\"len\", &self.size)\n            .finish_non_exhaustive()\n    }\n}\n\n// A file's kind: a directory, a file, a symbolic link (or another).\n#[derive(Clone, Copy, PartialEq, Eq, Hash)]\npub struct FileType {\n    fmt: u32,\n}\n\nimpl FileType {\n");
    buf_str(out, c"    #[effects()]\n    pub fn is_dir(&self) -> bool {\n        self.fmt == S_IFDIR\n    }\n\n    #[effects()]\n    pub fn is_file(&self) -> bool {\n        self.fmt == S_IFREG\n    }\n\n    #[effects()]\n    pub fn is_symlink(&self) -> bool {\n        self.fmt == S_IFLNK\n    }\n}\n\n// `FileType { is_file: true, is_dir: false, is_symlink: false, .. }`, as\n// Rust's.\nimpl crate::fmt::Debug for FileType {\n    fn fmt(&self, f: &mut crate::fmt::Formatter<'_>) -> crate::fmt::Result {\n        f.debug_struct(\"FileType\").field(\"is_file\", &self.is_file()).field(\"is_dir\", &self.is_dir())\n            .field(\"is_symlink\", &self.is_symlink()).finish_non_exhaustive()\n    }\n}\n\n// A file's permission bits.\n#[derive(Clone, PartialEq, Eq)]\npub struct Permissions {\n    mode: u32,\n}\n\nimpl Permissions {\n    // Whether no one may write it.\n    #[effects()]\n    pub fn readonly(&self) -> bool {\n        self.mode & 0x92 == 0\n    }\n\n    // st_mode: the kind's bits and the permission bits (0x81a4, 0o100644).\n    // mvs: Metadata::mode\n    // std2: changed: Permissions' own, st_mode as Rust's (Rust's:\n    // std::os::unix::fs::PermissionsExt; MVS: Metadata's, the low 12 bits)\n    #[effects()]\n    pub fn mode(&self) -> u32 {\n        self.mode\n    }\n}\n\n// ---- Whole files ----\n\n// The bytes of the file at path, in a new Vec on a.\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<Vec<u8, A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let size = match f.metadata() {\n        crate::result::Result::Ok(m) => m.len() as usize,\n        crate::result::Result::Err(_) => 0,\n    };\n    let mut v: Vec<u8, A> = Vec::with_capacity_in(size, a);\n    f.read_to_end(&mut v)?;\n    crate::result::Result::Ok(v)\n}\n\n// The text of the file at path, in a new String on a (InvalidData when it\n");
    buf_str(out, c"// is not UTF-8).\n// std2: changed: an allocator; the path an AsRef<str> (Rust's\n// fs::read_to_string)\n#[effects(io, static, panic, diverge, P, A)]\npub fn read_to_string_in<P: AsRef<str>, A: Allocator>(path: P, a: A) -> Result<String<A>> {\n    let path = path.as_ref();\n    let mut f = File::open(path)?;\n    let mut s = String::new_in(a);\n    f.read_to_string(&mut s)?;\n    crate::result::Result::Ok(s)\n}\n\n// The file at path holds contents: made, or emptied first.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P, C)]\npub fn write<P: AsRef<str>, C: AsRef<[u8]>>(path: P, contents: C) -> Result<()> {\n    let path = path.as_ref();\n    let mut f = File::create(path)?;\n    // (the path call: `contents.as_ref()` where a &[u8] is expected picks\n    // a wrong instance of AsRef for &T, 0.27.5's front gap)\n    f.write_all(AsRef::<[u8]>::as_ref(&contents))\n}\n\n// Copies the file at from to to (made, or emptied), its permission bits\n// too: the bytes copied.\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>); a u64 (MVS: i64)\n#[effects(io, static, panic, diverge, unsafe, P, Q)]\npub fn copy<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<u64> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let mut src = File::open(from)?;\n    let m = src.metadata()?;\n    if !m.is_file() {\n        return crate::result::Result::Err(Error::new(ErrorKind::InvalidInput,\n            \"the source path is neither a regular file nor a symlink to a regular file\"));\n    }\n    let mut dst = open_c(to, O_WRONLY | crate::__sys::O_CREAT | crate::__sys::O_TRUNC,\n        m.mode & 0xfff)?;\n    // UNSAFE: C's fchmod. SAFETY: integers only.\n    cvt(unsafe { fs_c_fchmod(dst.fd, m.mode & 0xfff) })?;\n    let mut buf = [0u8; 65536];\n    let mut total: u64 = 0;\n    loop {\n        let n = match src.read(&mut buf) {\n            crate::result::Result::Ok(0) => return crate::result::Result::Ok(total),\n");
    buf_str(out, c"            crate::result::Result::Ok(n) => n,\n            crate::result::Result::Err(e) => {\n                if e.kind() == ErrorKind::Interrupted {\n                    continue;\n                }\n                return crate::result::Result::Err(e);\n            }\n        };\n        dst.write_all(&buf[..n])?;\n        total += n as u64;\n    }\n}\n\n// What stat says of the file at path (through a symbolic link).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, true)\n}\n\n// As metadata, of a symbolic link itself.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn symlink_metadata<P: AsRef<str>>(path: P) -> Result<Metadata> {\n    let path = path.as_ref();\n    stat_at(path, false)\n}\n\n// Whether something is at path (through a symbolic link): Ok(false) when\n// nothing is, an error when the OS cannot say (Rust's fs::exists).\n// std2: changed: an io::Result<bool>, as Rust's (MVS: a bool); the path an\n// AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge)]\npub fn exists<P: AsRef<str>>(path: P) -> Result<bool> {\n    let path = path.as_ref();\n    match stat_at(path, true) {\n        crate::result::Result::Ok(_) => crate::result::Result::Ok(true),\n        crate::result::Result::Err(e) => {\n            if e.kind() == ErrorKind::NotFound {\n                crate::result::Result::Ok(false)\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_file<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's unlink. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_unlink(p.ptr()) })\n}\n\n");
    buf_str(out, c"// Removes the empty directory at path.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn remove_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's rmdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_rmdir(p.ptr()) })\n}\n\n// std2: changed: the paths AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn rename<P: AsRef<str>, Q: AsRef<str>>(from: P, to: Q) -> Result<()> {\n    let from = from.as_ref();\n    let to = to.as_ref();\n    let a = cpath(from)?;\n    let b = cpath(to)?;\n    // UNSAFE: C's rename. SAFETY: a and b are NUL-ended.\n    cvt(unsafe { fs_c_rename(a.ptr(), b.ptr()) })\n}\n\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn create_dir<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's mkdir. SAFETY: p is NUL-ended.\n    cvt(unsafe { fs_c_mkdir(p.ptr(), 0x1ff) })\n}\n\n// Whether path is a directory (through a symbolic link).\nfn is_dir_at(path: &str) -> bool {\n    match stat_at(path, true) {\n        crate::result::Result::Ok(m) => m.is_dir(),\n        crate::result::Result::Err(_) => false,\n    }\n}\n\n// path's parent as Rust's Path::parent has it: \"\" for a relative name,\n// None for the root (or \"\").\nfn parent_of(path: &str) -> Option<&str> {\n    let b = path.as_bytes();\n    let mut end = b.len();\n    while end > 0 && b[end - 1] == 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::None;\n    }\n    while end > 0 && b[end - 1] != 47 {\n        end -= 1;\n    }\n    if end == 0 {\n        return Option::Some(&path[..0]);\n    }\n    let mut k = end;\n    while k > 0 && b[k - 1] == 47 {\n        k -= 1;\n    }\n    if k == 0 { Option::Some(&path[..1]) } else { Option::Some(&path[..k]) }\n}\n\n");
    buf_str(out, c"// Makes the directory at path and those above it that are missing: Ok\n// when it is there (Rust's, step for step).\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(alloc(extern), io, static, panic, diverge, P)]\npub fn create_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    if path.is_empty() {\n        return crate::result::Result::Ok(());\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => return crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if e.kind() != ErrorKind::NotFound {\n                return if is_dir_at(path) {\n                    crate::result::Result::Ok(())\n                } else {\n                    crate::result::Result::Err(e)\n                };\n            }\n        }\n    }\n    match parent_of(path) {\n        Option::Some(p) => create_dir_all(p)?,\n        Option::None => {\n            return crate::result::Result::Err(Error::other(\"failed to create whole tree\"));\n        }\n    }\n    match create_dir(path) {\n        crate::result::Result::Ok(()) => crate::result::Result::Ok(()),\n        crate::result::Result::Err(e) => {\n            if is_dir_at(path) {\n                crate::result::Result::Ok(())\n            } else {\n                crate::result::Result::Err(e)\n            }\n        }\n    }\n}\n\n// Removes the directory at path and all it holds; a symbolic link is\n// removed, not followed.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, P)]\npub fn remove_dir_all<P: AsRef<str>>(path: P) -> Result<()> {\n    let path = path.as_ref();\n    let m = symlink_metadata(path)?;\n    if m.is_symlink() {\n        return remove_file(path);\n    }\n    if !m.is_dir() {\n        return crate::result::Result::Err(Error::from_raw_os_error(20));\n    }\n    remove_tree(path)\n}\n\n// Removes the directory at path and everything under it.\n");
    buf_str(out, c"fn remove_tree(path: &str) -> Result<()> {\n    let mut dir = read_dir(path)?;\n    loop {\n        let e = match dir.next() {\n            Option::Some(r) => r?,\n            Option::None => break,\n        };\n        if e.file_type()?.is_dir() {\n            remove_tree(e.path())?;\n        } else {\n            remove_file(e.path())?;\n        }\n    }\n    remove_dir(path)\n}\n\n// ---- Directories ----\n\n// The entries of the directory at path (\".\" and \"..\" left out), in the\n// order the file system gives them.\n// std2: changed: the path an AsRef<str> (Rust: AsRef<Path>)\n#[effects(io, static, panic, diverge, unsafe)]\npub fn read_dir<P: AsRef<str>>(path: P) -> Result<ReadDir> {\n    let path = path.as_ref();\n    let p = cpath(path)?;\n    // UNSAFE: C's opendir. SAFETY: p is NUL-ended.\n    let d = unsafe { fs_c_opendir(p.ptr()) };\n    if d.is_null() {\n        return crate::result::Result::Err(Error::last_os_error());\n    }\n    let mut root = [0u8; crate::__sys::PATH_MAX];\n    let b = path.as_bytes();\n    let mut i: usize = 0;\n    while i < b.len() {\n        root[i] = b[i];\n        i += 1;\n    }\n    crate::result::Result::Ok(ReadDir { dir: d, root: root, root_len: b.len() })\n}\n\n// `fs::read_dir(p)?`: each item an io::Result<DirEntry>. Dropping it\n// closes the directory.\npub struct ReadDir {\n    dir: *mut u8,\n    root: [u8; crate::__sys::PATH_MAX],\n    root_len: usize,\n}\n\nimpl Drop for ReadDir {\n    fn drop(&mut self) {\n        // UNSAFE: C's closedir. SAFETY: dir is the DIR * opendir returned,\n        // non-null (read_dir checks), closed once (here).\n        let _ = unsafe { fs_c_closedir(self.dir) };\n    }\n}\n\nimpl Iterator for ReadDir {\n    type Item = Result<DirEntry>;\n\n    fn next(&mut self) -> Option<Result<DirEntry>> {\n        loop {\n            let mut e = DirEntry {\n                path: [0u8; crate::__sys::PATH_MAX], len: 0, name_at: 0, kind: 0,\n            };\n");
    buf_str(out, c"            // UNSAFE: errno cleared, then C's readdir on the DIR *, and its\n            // struct dirent read through the pointer readdir returns.\n            // SAFETY: errno_location is this thread's errno; dir is open\n            // (Drop closes it, after the last next); a non-null entry is a\n            // struct dirent of this system (its d_type and d_name at the\n            // offsets std::__sys gives), valid until the next readdir of\n            // dir, and d_name is NUL-ended within it: its bytes are copied\n            // out before this returns.\n            let ok = unsafe {\n                *crate::__sys::errno_location() = 0;\n                let d = fs_c_readdir(self.dir);\n                if d.is_null() {\n                    let err = *crate::__sys::errno_location();\n                    if err == 0 {\n                        return Option::None;\n                    }\n                    return Option::Some(crate::result::Result::Err(Error::from_raw_os_error(err)));\n                }\n                e.kind = *d.add(crate::__sys::DIRENT_TYPE);\n                let name = d.add(crate::__sys::DIRENT_NAME);\n                let mut n: usize = 0;\n                while *name.add(n) != 0 {\n                    n += 1;\n                }\n                let nm = crate::slice::from_raw_parts(name, n);\n                if nm == b\".\" || nm == b\"..\" {\n                    continue;\n                }\n                e.fill(&self.root[..self.root_len], nm)\n            };\n            if !ok {\n                return Option::Some(crate::result::Result::Err(Error::new(\n                    ErrorKind::InvalidData,\n                    \"a directory entry's name is not UTF-8 or the path is too long\")));\n            }\n            return Option::Some(crate::result::Result::Ok(e));\n        }\n    }\n}\n\n// A directory's entry: its path (the directory's, then its name), kept\n// inline, and its kind as the directory says it.\npub struct DirEntry {\n");
    buf_str(out, c"    path: [u8; crate::__sys::PATH_MAX],\n    len: usize,\n    name_at: usize,\n    kind: u8,\n}\n\nimpl DirEntry {\n    // root, a \"/\" unless root ends with one, and name: false when it does\n    // not fit or is not UTF-8.\n    fn fill(&mut self, root: &[u8], name: &[u8]) -> bool {\n        let slash: usize = if root.is_empty() || root[root.len() - 1] == 47 { 0 } else { 1 };\n        if root.len() + slash + name.len() > self.path.len()\n            || crate::str::from_utf8(name).is_err()\n            {\n            return false;\n        }\n        self.path[..root.len()].copy_from_slice(root);\n        if slash == 1 {\n            self.path[root.len()] = 47;\n        }\n        self.name_at = root.len() + slash;\n        self.len = self.name_at + name.len();\n        self.path[self.name_at..self.len].copy_from_slice(name);\n        true\n    }\n\n    fn text(&self, from: usize) -> &str {\n        let b = match self.path.get(from..self.len) {\n            Option::Some(b) => b,\n            Option::None => return \"\",\n        };\n        match crate::str::from_utf8(b) {\n            crate::result::Result::Ok(s) => s,\n            crate::result::Result::Err(_) => \"\",\n        }\n    }\n\n    // The directory's path joined with the entry's name.\n    // mvs: DirEntry::path_in\n    // std2: changed: a &str, a view of the entry (Rust's: a PathBuf; MVS:\n    // a PathBuf on an allocator; path_in could make one on an allocator)\n    #[effects(panic, diverge)]\n    pub fn path(&self) -> &str {\n        self.text(0)\n    }\n\n    // Its name.\n    // std2: changed: a &str, a view of the entry, until std::ffi (Rust's:\n    // an OsString; a name that is not UTF-8 is read_dir's InvalidData)\n    #[effects(panic, diverge)]\n    pub fn file_name(&self) -> &str {\n        self.text(self.name_at)\n    }\n\n    // What lstat says of it.\n    #[effects(io, static, panic, diverge)]\n    pub fn metadata(&self) -> Result<Metadata> {\n        stat_at(self.path(), false)\n    }\n\n");
    buf_str(out, c"    // Its kind as the directory says it (lstat's when the file system does\n    // not say).\n    #[effects(io, static, panic, diverge)]\n    pub fn file_type(&self) -> Result<FileType> {\n        if self.kind == DT_DIR {\n            crate::result::Result::Ok(FileType { fmt: S_IFDIR })\n        } else if self.kind == DT_REG {\n            crate::result::Result::Ok(FileType { fmt: S_IFREG })\n        } else if self.kind == DT_LNK {\n            crate::result::Result::Ok(FileType { fmt: S_IFLNK })\n        } else {\n            crate::result::Result::Ok(self.metadata()?.file_type())\n        }\n    }\n}\n// ---- end mod std::fs ----\n}\n// ---- mod std::path ----\npub mod path {\n// std::path (0.28.0): Path and PathBuf, Rust's names and meanings over\n// UTF-8 text ('/' between the components, as on Unix).\n//\n// A named divergence from Rust: Rust's `Path` is an unsized newtype over\n// OsStr, reached as `&Path`; the rust edition has no unsized newtypes\n// yet (rust-surface-plan.md, later: \"an unsized newtype\"), so `Path<'a>`\n// is a sized, copyable view of a `&'a str`, written `Path<'_>` (or `Path`\n// with its lifetime elided) where Rust writes `&Path`, and a component is\n// a `&str` where Rust's is an `&OsStr`. `PathBuf<A>` owns its text in a\n// String<A>; it derefs to str, so `fs::metadata(&p)` takes it, and it has\n// Path's methods itself. A path taken as an argument is `P: AsRef<str>`\n// (Rust's `AsRef<Path>`): a &str, a String, a Path or a PathBuf. When the\n// front has unsized newtypes, `Path<'a>` becomes `&'a Path`.\n// mvs: std::path\n\nuse crate::alloc::Allocator;\nuse crate::cmp::{Eq, PartialEq};\nuse crate::convert::AsRef;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::iter::{DoubleEndedIterator, Iterator};\nuse crate::ops::Deref;\nuse crate::option::Option;\nuse crate::result::Result;\nuse crate::string::String;\n\n// ---- Components ----\n\n// One component of a path: the root, a leading \".\", \"..\", or a name.\n");
    buf_str(out, c"#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Component<'a> {\n    RootDir,\n    CurDir,\n    ParentDir,\n    Normal(&'a str),\n}\n\nimpl<'a> Component<'a> {\n    // Its text: \"/\", \".\", \"..\" or the name.\n    // std2: changed: a &str (Rust: as_os_str, an &OsStr)\n    #[effects()]\n    pub fn as_str(self) -> &'a str {\n        match self {\n            Component::RootDir => \"/\",\n            Component::CurDir => \".\",\n            Component::ParentDir => \"..\",\n            Component::Normal(s) => s,\n        }\n    }\n}\n\nimpl<'a> AsRef<str> for Component<'a> {\n    fn as_ref(&self) -> &str {\n        self.as_str()\n    }\n}\n\n// The length of s's prefix component: 1 for the root ('/') or for a\n// leading \".\" (\".\", \"./...\"), else 0.\nfn prefix_len(s: &str) -> usize {\n    let b = s.as_bytes();\n    if b.len() > 0 && b[0] == b'/' {\n        return 1;\n    }\n    if b.len() > 0 && b[0] == b'.' && (b.len() == 1 || b[1] == b'/') {\n        return 1;\n    }\n    0\n}\n\n// `p.components()`: the root or a leading \".\" first, then the names and\n// \"..\"s; empty components and \".\" past the first are left out, as Rust's.\n// Both ends: `next_back` gives the last component.\n#[derive(Clone, Copy)]\npub struct Components<'a> {\n    s: &'a str,\n    // the prefix component (RootDir or CurDir) not yet given\n    pre: bool,\n    // the body not yet given: s[front..back]\n    front: usize,\n    back: usize,\n}\n\nimpl<'a> Components<'a> {\n    fn of(s: &'a str) -> Components<'a> {\n        let n = prefix_len(s);\n        Components { s: s, pre: n > 0, front: n, back: s.len() }\n    }\n\n    fn prefix(&self) -> Component<'a> {\n        if self.s.as_bytes()[0] == b'/' { Component::RootDir } else { Component::CurDir }\n    }\n\n    fn body(c: &'a str) -> Option<Component<'a>> {\n        if c.len() == 0 || c == \".\" {\n            Option::None\n        } else if c == \"..\" {\n            Option::Some(Component::ParentDir)\n        } else {\n");
    buf_str(out, c"            Option::Some(Component::Normal(c))\n        }\n    }\n\n    // What is left, as a path: \"\" when nothing is.\n    #[effects(panic, diverge)]\n    pub fn as_path(&self) -> Path<'a> {\n        let b = self.s.as_bytes();\n        let mut lo = self.front;\n        let mut hi = self.back;\n        // trailing '/'s and \".\" components\n        loop {\n            if hi > lo && b[hi - 1] == b'/' {\n                hi -= 1;\n            } else if hi > lo && b[hi - 1] == b'.' && (hi - 1 == lo || b[hi - 2] == b'/') {\n                hi -= 1;\n            } else {\n                break;\n            }\n        }\n        if self.pre {\n            let n = prefix_len(self.s);\n            return Path { s: &self.s[0..if hi > n { hi } else { n }] };\n        }\n        // leading '/'s and \".\" components\n        loop {\n            if lo < hi && b[lo] == b'/' {\n                lo += 1;\n            } else if lo < hi && b[lo] == b'.' && (lo + 1 == hi || b[lo + 1] == b'/') {\n                lo += 1;\n            } else {\n                break;\n            }\n        }\n        Path { s: &self.s[lo..hi] }\n    }\n}\n\nimpl<'a> Iterator for Components<'a> {\n    type Item = Component<'a>;\n\n    fn next(&mut self) -> Option<Component<'a>> {\n        if self.pre {\n            self.pre = false;\n            return Option::Some(self.prefix());\n        }\n        let b = self.s.as_bytes();\n        while self.front < self.back {\n            let start = self.front;\n            let mut end = start;\n            while end < self.back && b[end] != b'/' {\n                end += 1;\n            }\n            self.front = if end < self.back { end + 1 } else { end };\n            match Components::body(&self.s[start..end]) {\n                Option::Some(c) => return Option::Some(c),\n                Option::None => {}\n            }\n        }\n        Option::None\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Components<'a> {\n");
