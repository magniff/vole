    buf_str(out, c"        let l = c | 0x20;\n        let d = if c >= 0x30 && c <= 0x39 {\n            c - 0x30\n        } else if l >= 0x61 && l <= 0x7A {\n            l - 0x61 + 10\n        } else {\n            return Option::None;\n        };\n        if d < radix { Option::Some(d) } else { Option::None }\n    }\n\n    #[effects(panic)]\n    pub fn is_digit(self, radix: u32) -> bool {\n        self.to_digit(radix).is_some()\n    }\n\n    #[effects(panic)]\n    pub fn is_alphabetic(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_alphabetic();\n        }\n        crate::unicode::is_alphabetic(c)\n    }\n\n    #[effects(panic)]\n    pub fn is_numeric(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_digit();\n        }\n        crate::unicode::is_numeric(c)\n    }\n\n    #[effects(panic)]\n    pub fn is_alphanumeric(self) -> bool {\n        self.is_alphabetic() || self.is_numeric()\n    }\n\n    #[effects(panic)]\n    pub fn is_whitespace(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return c == 0x20 || (c >= 0x9 && c <= 0xD);\n        }\n        // (Unicode's White_Space outside ASCII, all of it: nineteen code\n        // points, the same since Unicode 6.3; std::unicode's tables are\n        // read only by a program that names them, and `{:?}` of a str\n        // asks this of every char)\n        c == 0x85 || c == 0xA0 || c == 0x1680 || (c >= 0x2000 && c <= 0x200A) || c == 0x2028\n            || c == 0x2029 || c == 0x202F || c == 0x205F || c == 0x3000\n    }\n\n    #[effects(panic)]\n    pub fn is_uppercase(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_uppercase();\n        }\n        crate::unicode::is_uppercase(c)\n    }\n\n    #[effects(panic)]\n    pub fn is_lowercase(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n");
