    buf_str(out, c"fn is_cased(c: char) -> bool {\n    c.is_lowercase() || c.is_uppercase()\n}\n\n// Unicode's Case_Ignorable, approximately: the apostrophes, the word\n// punctuation Unicode lists (`.`, `:`, `^`, `` ` ``, U+00AD, U+00B7) and\n// the combining diacritical marks.\nfn is_case_ignorable(c: char) -> bool {\n    let u = c as u32;\n    c == '\\'' || c == '.' || c == ':' || c == '^' || c == '`' || u == 0xAD || u == 0xB7\n        || u == 0x2019 || (u >= 0x300 && u <= 0x36F)\n}\n\n// Whether the last char of s that is not case-ignorable is cased (Final_Sigma's\n// \"before\").\nfn cased_before(s: &str) -> bool {\n    let mut it = s.chars();\n    while let Some(c) = it.next_back() {\n        if !is_case_ignorable(c) {\n            return is_cased(c);\n        }\n    }\n    false\n}\n\n// Whether the first char of s that is not case-ignorable is cased.\nfn cased_after(s: &str) -> bool {\n    let mut it = s.chars();\n    while let Some(c) = it.next() {\n        if !is_case_ignorable(c) {\n            return is_cased(c);\n        }\n    }\n    false\n}\n// ---- end mod std::str ----\n}\n// ---- mod std::char ----\npub mod char {\n// EDITION: rust\n// std::char: the methods of char, a Unicode scalar value (0..=0x10FFFF\n// less the surrogates), and the functions that make one. The rust front's\n// char type comes in 0.27.2 (`edition.later: char`); MVS had none (a code\n// point was a u32, `'x'` a u8), and in the rust edition `'x'` is a char\n// and `b'x'` a u8.\n\nuse crate::cmp::{Eq, Ord, Ordering, PartialEq, PartialOrd};\nuse crate::convert::TryFrom;\nuse crate::default::Default;\nuse crate::fmt::{Debug, Display, Formatter};\nuse crate::hash::{Hash, Hasher};\nuse crate::iter::Iterator;\nuse crate::option::Option;\nuse crate::result::Result;\n\nimpl char {\n    // The largest char, '\\u{10FFFF}'.\n    pub const MAX: char = '\\u{10FFFF}';\n\n    // U+FFFD, what bad UTF-8 decodes to.\n    pub const REPLACEMENT_CHARACTER: char = '\\u{FFFD}';\n\n");
    buf_str(out, c"    // i as a char, when it is a scalar value.\n    #[effects()]\n    pub fn from_u32(i: u32) -> Option<char> {\n        // the surrogates (U+D800..=U+DFFF) and past U+10FFFF are no chars\n        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) {\n            Option::None\n        } else {\n            Option::Some(from_u32_unchecked(i))\n        }\n    }\n\n    // The digit d in radix (2..=36), as a char: from_digit(7, 10) is '7'.\n    #[effects(panic, diverge)]\n    pub fn from_digit(d: u32, radix: u32) -> Option<char>\n        requires radix <= 36\n    {\n        if radix > 36 {\n            crate::panic::panic(\"from_digit: radix is too high (maximum 36)\");\n        }\n        if d >= radix {\n            Option::None\n        } else if d < 10 {\n            Option::Some(('0' as u8 + d as u8) as char)\n        } else {\n            Option::Some(('a' as u8 + (d - 10) as u8) as char)\n        }\n    }\n\n    // Its value as a digit in radix: '7'.to_digit(10) is Some(7).\n    #[effects(panic, diverge)]\n    pub fn to_digit(self, radix: u32) -> Option<u32> {\n        if radix < 2 || radix > 36 {\n            crate::panic::panic(\n                \"to_digit: invalid radix -- radix must be in the range 2 to 36 inclusive\");\n        }\n        let c = self as u32;\n        // `| 0x20` folds ASCII upper case onto lower case\n        let l = c | 0x20;\n        let d = if c >= 0x30 && c <= 0x39 {\n            c - 0x30\n        } else if l >= 0x61 && l <= 0x7A {\n            l - 0x61 + 10\n        } else {\n            return Option::None;\n        };\n        if d < radix { Option::Some(d) } else { Option::None }\n    }\n\n    #[effects(panic, diverge)]\n    pub fn is_digit(self, radix: u32) -> bool {\n        self.to_digit(radix).is_some()\n    }\n\n    #[effects(panic)]\n    pub fn is_alphabetic(self) -> bool {\n        let c = self as u32;\n        if c < 0x80 {\n            return self.is_ascii_alphabetic();\n        }\n        crate::unicode::is_