    buf_str(out, c"// refresh (from a timer when the display cannot show the window, 0.25.2.1),\n// and an idle application wakes up never. A watched file\n// descriptor (D3) delivers `Event::Readable` from inside `wait`, which\n// is how the terminal serves its pty before 0.21's threads.\n//\n// `App` and `Window` release their Cocoa objects when dropped; drop the\n// windows before the App. The live-resize hook is a plain `fn(*u8)` with\n// a context pointer (a closure once callbacks can borrow).\n\n// ---- Windows and input (0.23) ----\n\npub mod cocoa;\npub mod keys;\nmod objc;\nmod script;\n\nuse crate::alloc::Allocator;\nuse crate::string::String;\n\nuse keys::{KeyCode, Logical, Mods};\n\n#[derive(Clone, Copy)]\npub struct WindowId {\n    pub n: i64,\n}\n\nimpl WindowId {\n    pub fn eq(self, o: WindowId) -> bool {\n        self.n == o.n\n    }\n}\n\n// A size in physical pixels, and the scale from logical points (2.0 on\n// a Retina display).\n#[derive(Clone, Copy)]\npub struct Size {\n    pub w: i64,\n    pub h: i64,\n    pub scale: f64,\n}\n\n// A key press, repeat or release. `ime` is true when an input method\n// took the key (composition in progress before or after it): a terminal\n// does not encode it. `text_follows` is true when the key produced text,\n// delivered by the `Event::Text` right after this event (a terminal\n// sends the text, not an encoding of the key, unless it treats Option as\n// Meta).\n#[derive(Clone, Copy)]\npub struct Key {\n    pub win: WindowId,\n    pub code: KeyCode,\n    pub key: Logical,\n    pub mods: Mods,\n    pub pressed: bool,\n    pub repeat: bool,\n    pub ime: bool,\n    pub text_follows: bool,\n}\n\n// Text typed or committed by an input method, its UTF-8 bytes inline\n// (D4): a longer commit arrives as several events, never split inside a\n// character. Its text is `t.bytes[0..t.len as i64]` (0.20: a Text is\n// plain, so a method takes a copy of it and cannot return a view of its\n// bytes).\n#[derive(Clone, Copy)]\n");
    buf_str(out, c"pub struct Text {\n    pub win: WindowId,\n    pub len: u8,\n    pub bytes: [u8; 30],\n}\n\n// The input method's composition changed: `app.preedit()` is its text\n// (empty: composition ended), `cursor` a byte offset in it.\n#[derive(Clone, Copy)]\npub struct Preedit {\n    pub win: WindowId,\n    pub len: i64,\n    pub cursor: i64,\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Button {\n    Left,\n    Right,\n    Middle,\n    Other(i64),\n    None,\n}\n\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum MouseAction {\n    Press,\n    Release,\n    Move,\n}\n\n// A mouse button or motion; the position is in physical pixels from the\n// window's content top-left. `clicks` counts a double (2) or triple (3)\n// click on presses.\n#[derive(Clone, Copy)]\npub struct Mouse {\n    pub win: WindowId,\n    pub action: MouseAction,\n    pub button: Button,\n    pub x: f64,\n    pub y: f64,\n    pub mods: Mods,\n    pub clicks: i64,\n}\n\n// Scrolling: `precise` deltas are in physical pixels (a trackpad);\n// otherwise in lines (a wheel). Positive dy scrolls up (content moves\n// down), as AppKit and winit report it.\n#[derive(Clone, Copy)]\npub struct Scroll {\n    pub win: WindowId,\n    pub dx: f64,\n    pub dy: f64,\n    pub precise: bool,\n    pub mods: Mods,\n}\n\n#[derive(Clone, Copy)]\npub enum Event {\n    // A frame asked for by `request_frame`: draw now.\n    Frame(WindowId),\n    Key(Key),\n    Text(Text),\n    Preedit(Preedit),\n    // The content's new size (also its first size, after `window`).\n    Resize(WindowId, Size),\n    Mouse(Mouse),\n    Scroll(Scroll),\n    // The pointer entered (true) or left the window.\n    Cursor(WindowId, bool),\n    Focus(WindowId, bool),\n    // A watched file descriptor is readable.\n    Readable(i32),\n    // The user asked to close the window (it stays open until `close`).\n    Close(WindowId),\n    // The user chose Quit (Command-Q).\n    Quit,\n}\n\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\n");
    buf_str(out, c"pub enum Error {\n    // No window server (a headless session, ssh).\n    NoDisplay,\n    Failed(&'static str),\n}\n\n#[derive(Clone, Copy, PartialEq, Eq)]\npub enum CursorIcon {\n    Arrow,\n    Text,\n    Pointer,\n}\n\n#[derive(Clone, Copy)]\npub struct WindowDesc<'a> {\n    pub title: &'a str,\n    // Logical points.\n    pub w: i64,\n    pub h: i64,\n    pub min_w: i64,\n    pub min_h: i64,\n    pub resizable: bool,\n}\n\nimpl<'a> WindowDesc<'a> {\n    pub fn new(title: &'a str, w: i64, h: i64) -> WindowDesc<'a> {\n        WindowDesc { title: title, w: w, h: h, min_w: 100, min_h: 60, resizable: true }\n    }\n}\n\n// What each backend provides (D6). App and Window call the one the\n// target's OS has, statically.\npub trait Backend {\n    fn open_window(&mut self, desc: WindowDesc<'_>, id: WindowId) -> Result<Window, Error>;\n    fn next_event(&mut self, ms: i64) -> Option<Event>;\n    fn watch(&mut self, fd: i32) -> bool;\n    fn unwatch(&mut self, fd: i32);\n    fn clipboard_get_in<A: Allocator>(&self, a: A) -> Option<String<A>>;\n    fn clipboard_set(&self, text: &str);\n    fn preedit(&self) -> &[u8];\n    fn set_live_resize(&mut self, f: fn(*mut u8), ctx: *mut u8);\n    fn close(&mut self);\n}\n\n// The backend of an App: the window server's, or (0.25.4) a script's\n// (VOLE_WINDOW_SCRIPT, script.vl: testing without a display).\nenum Native<A: Allocator> {\n    Cocoa(cocoa::Cocoa<A>),\n    Script(script::Script<A>),\n}\n\npub struct App<A: Allocator> {\n    b: Native<A>,\n    next_id: i64,\n}\n\nimpl App<Gpa> {\n    // The application: on macOS, NSApplication without a bundle (a\n    // regular app with a Dock icon and a menu with Quit). Err(NoDisplay)\n    // when there is no window server. (0.25.4) With VOLE_WINDOW_SCRIPT\n    // set, no window server is opened and the events come from the\n    // script (script.vl; `guide window#testing-input-without-a-display`).\n    pub fn new_in(gpa: Gpa) -> Result<App<Gpa>, Error> {\n");
    buf_str(out, c"        match script::Script::from_env(gpa) {\n            Some(s) => return Ok(App { b: Native::Script(s), next_id: 1 }),\n            None => {}\n        }\n        match cocoa::Cocoa::new_in(gpa) {\n            Ok(b) => Ok(App { b: Native::Cocoa(b), next_id: 1 }),\n            Err(e) => Err(e),\n        }\n    }\n\n    pub fn window(&mut self, desc: WindowDesc<'_>) -> Result<Window, Error> {\n        let id = WindowId { n: self.next_id };\n        self.next_id += 1;\n        match &mut self.b {\n            Native::Cocoa(b) => b.open_window(desc, id),\n            Native::Script(s) => {\n                s.open(desc.w, desc.h, id);\n                Ok(Window { id: id, ns: cocoa::NsWindow::none() })\n            }\n        }\n    }\n\n    fn next_event(&mut self, ms: i64) -> Option<Event> {\n        match &mut self.b {\n            Native::Cocoa(b) => b.next_event(ms),\n            Native::Script(s) => s.next_event(ms),\n        }\n    }\n\n    // The next event, waiting as long as it takes.\n    pub fn wait(&mut self) -> Result<Event, Error> {\n        loop {\n            match self.next_event(-1) {\n                Some(e) => return Ok(e),\n                None => {}\n            }\n        }\n    }\n\n    // The next event if one is ready.\n    pub fn poll(&mut self) -> Option<Event> {\n        self.next_event(0)\n    }\n\n    // The next event within `ms` milliseconds.\n    pub fn wait_timeout(&mut self, ms: i64) -> Option<Event> {\n        self.next_event(if ms < 0 { 0 } else { ms })\n    }\n\n    // Delivers `Event::Readable(fd)` whenever `fd` has data, from inside\n    // wait/poll (until `unwatch`). False if the fd cannot be watched (a\n    // scripted App watches none).\n    pub fn watch(&mut self, fd: i32) -> bool {\n        match &mut self.b {\n            Native::Cocoa(b) => b.watch(fd),\n            Native::Script(_) => false,\n        }\n    }\n\n    pub fn unwatch(&mut self, fd: i32) {\n        match &mut self.b {\n");
    buf_str(out, c"            Native::Cocoa(b) => b.unwatch(fd),\n            Native::Script(_) => {}\n        }\n    }\n\n    // The clipboard's text, in a String of `a` (a frame's ScopedArena for a\n    // paste that is sent and forgotten).\n    pub fn clipboard_get_in<A: Allocator>(&self, a: A) -> Option<String<A>> {\n        match &self.b {\n            Native::Cocoa(b) => b.clipboard_get_in(a),\n            Native::Script(_) => None,\n        }\n    }\n\n    pub fn clipboard_set(&self, text: &str) {\n        match &self.b {\n            Native::Cocoa(b) => b.clipboard_set(text),\n            Native::Script(_) => {}\n        }\n    }\n\n    // The input method's current composition (see Event::Preedit), a view\n    // valid until the next event.\n    pub fn preedit(&self) -> &[u8] {\n        match &self.b {\n            Native::Cocoa(b) => b.preedit(),\n            Native::Script(_) => b\"\",\n        }\n    }\n\n    // macOS runs a loop of its own while the user drags a window's edge,\n    // so `wait` does not return until the drag ends. `f(ctx)` is called\n    // for each size change during the drag: it can `poll` (only the\n    // queued events are returned there) and draw. The one callback of the\n    // API (terminal.md §2.1).\n    pub fn on_live_resize(&mut self, f: fn(*mut u8), ctx: *mut u8) {\n        match &mut self.b {\n            Native::Cocoa(b) => b.set_live_resize(f, ctx),\n            Native::Script(_) => {}\n        }\n    }\n}\n\n// The application's state is released with it (its windows should be\n// dropped first: they do not outlive the App).\nimpl Drop for App<Gpa> {\n    fn drop(&mut self) {\n        match &mut self.b {\n            Native::Cocoa(b) => b.close(),\n            Native::Script(_) => {}\n        }\n    }\n}\n\n// A window: its Cocoa objects, retained until it is dropped (or closed).\npub struct Window {\n    pub id: WindowId,\n    pub ns: cocoa::NsWindow,\n}\n\nimpl Window {\n");
    buf_str(out, c"    // One Event::Frame at the next refresh of the window's display.\n    // (0.25.2.1) While the display cannot show the window (the display\n    // asleep, the window covered, hidden or on another Space)\n    // the Frame comes from a timer, 10 a second, and after 3 s stderr\n    // says why once: a loop waiting for frames always gets them.\n    // (0.25.4) In a scripted App (VOLE_WINDOW_SCRIPT) the next `frames`\n    // command answers it at once.\n    pub fn request_frame(&self) {\n        if script::active() {\n            script::request_frame(self.id);\n            return;\n        }\n        self.ns.request_frame();\n    }\n\n    pub fn size(&self) -> Size {\n        if script::active() {\n            return script::size();\n        }\n        self.ns.size()\n    }\n\n    // The CAMetalLayer (on macOS) a GPU surface is made on. Null in a\n    // scripted App: std::gpu makes `RawSurface::MetalLayer` of null a\n    // headless surface.\n    pub fn raw_surface(&self) -> *mut u8 {\n        self.ns.layer\n    }\n\n    pub fn set_title(&self, t: &str) {\n        if script::active() {\n            return;\n        }\n        self.ns.set_title(t);\n    }\n\n    pub fn set_cursor(&self, c: CursorIcon) {\n        if script::active() {\n            return;\n        }\n        self.ns.set_cursor(c);\n    }\n\n    // Hides the pointer until the mouse moves (while typing).\n    pub fn hide_cursor_while_typing(&self) {\n        if script::active() {\n            return;\n        }\n        cocoa::hide_cursor_until_moved();\n    }\n\n    // Where the input method's candidate window goes: the text cursor's\n    // rectangle in physical pixels from the content's top-left.\n    pub fn set_ime_area(&self, x: f64, y: f64, w: f64, h: f64) {\n        if script::active() {\n            return;\n        }\n        self.ns.set_ime_area(x, y, w, h);\n    }\n\n    pub fn set_fullscreen(&self, on: bool) {\n        if script::active() {\n            script::set_fullscreen(on);\n");
    buf_str(out, c"            return;\n        }\n        self.ns.set_fullscreen(on);\n    }\n\n    pub fn is_fullscreen(&self) -> bool {\n        if script::active() {\n            return script::is_fullscreen();\n        }\n        self.ns.is_fullscreen()\n    }\n\n    pub fn focused(&self) -> bool {\n        if script::active() {\n            return script::focused();\n        }\n        self.ns.focused()\n    }\n\n    // Closes the window now (dropping it does the same).\n    pub fn close(&mut self) {\n        if script::active() {\n            script::closed(self.id);\n            return;\n        }\n        self.ns.close();\n    }\n}\n\nimpl Drop for Window {\n    fn drop(&mut self) {\n        self.close();\n    }\n}\n// ---- mod std::window::cocoa ----\npub mod cocoa {\n// EDITION: rust\n// The Cocoa backend (terminal.md §2.3, task W1): NSApplication without a\n// bundle or a nib, a runtime NSView subclass with a CAMetalLayer, events\n// drained with nextEventMatchingMask and sendEvent, NSTextInputClient for\n// input methods, CADisplayLink frames, CFFileDescriptor watches.\n//\n// Its message calls go through objc.vl's hand-typed shapes, each with\n// the selector's documented C types, and every one is listed in\n// tables/appkit.objc and tables/quartzcore.objc, which objcgen --check\n// verifies against the runtime; when std::objc lands they are generated\n// from those tables instead.\n//\n// Pitfalls of running AppKit from a plain executable, and what is done\n// about each:\n// - No bundle: the process starts as a background app with no Dock icon\n//   and no menu bar. `setActivationPolicy: Regular` makes it a regular\n//   app; `finishLaunching` must be called since `[NSApp run]` is not;\n//   then `activateIgnoringOtherApps:` (again after the first window is\n//   shown, or a terminal that launched it keeps the focus).\n// - No nib: the menu bar is built by hand (an app menu with Quit, which\n//   targets our own object, so Command-Q is an Event::Quit, not exit()).\n");
    buf_str(out, c"// - No [NSApp run]: events are pulled with\n//   nextEventMatchingMask:untilDate:inMode:dequeue: and dispatched with\n//   sendEvent:, each batch inside an autorelease pool. Run-loop sources\n//   (the display link, watched fds) fire inside nextEventMatchingMask\n//   without an NSEvent, so it would not return: they post an\n//   application-defined NSEvent to wake it, which is dropped.\n// - Key input goes through interpretKeyEvents:, which needs the view to\n//   be the first responder and to implement NSTextInputClient, including\n//   doCommandBySelector: (without it, every Return or arrow beeps).\n// - Command-key releases: NSApplication does not send keyUp: for a key\n//   pressed with Command (a known AppKit quirk); such releases are not\n//   reported.\n// - Live resize runs AppKit's own loop: windowDidResize: calls the one\n//   hook (App::on_live_resize) so the application can draw during the\n//   drag.\n// - Mouse moves need setAcceptsMouseMovedEvents: and a tracking area\n//   (enter and leave too).\n// - The display link (NSView.displayLinkWithTarget:selector:, macOS 14)\n//   runs on the main run loop in common modes: no thread, so no callback\n//   arrives off the main thread before 0.21 (gpu.md §2.11).\n// - A headless session (ssh, no window server) makes NSApplication abort\n//   the process: CGSessionCopyCurrentDictionary is asked first, and\n//   App::new_in returns Err(NoDisplay).\n// - (0.25.2.1) The display link fires only for a window the display\n//   shows: none while the display is asleep (the screen locked, the\n//   person away), nor for a window that is covered, hidden, minimized or\n//   on another Space (occlusionState without Visible). A loop waiting for Frame would\n//   wait forever, so each request is also answered by a timer: at once\n//   10 a second when the window is occluded (FALLBACK_NS), after 3 s of\n//   silence otherwise (QUIET_NS), 60 a second with no display link; and\n");
    buf_str(out, c"//   after 3 s without a display frame one line on stderr says why.\n// - (0.25.2.1) A process started from a background shell is not made\n//   active (macOS 14's cooperative activation ignores\n//   activateIgnoringOtherApps: then): its window opens behind the\n//   active app's. It is ordered front regardless, as winit does (not\n//   made key: the focus stays where it is).\n\n// ---- The Cocoa backend (0.23) ----\n\nuse crate::alloc::Allocator;\n\nuse keys::{\n    first_char, mac_keycode, mac_logical, mac_modifier_down, mac_mods, utf16_to_byte, utf8_cut,\n};\nuse super::{\n    Button, CursorIcon, Error, Event, Key, Mouse, MouseAction, Preedit, Scroll, Size, Text, Window,\n    WindowDesc, WindowId,\n};\nuse super::objc::{\n    NOT_FOUND, Point, Range, Rect, class, class_addIvar, class_addProtocol,\n    class_getInstanceVariable, ivar_getOffset, method_types, msg_b, msg_b_i, msg_b_p, msg_b_pp,\n    msg_d, msg_h, msg_i, msg_p, msg_p_d, msg_p_p, msg_p_pp, msg_p_ppp, msg_p_r, msg_p_rupp,\n    msg_p_ruub, msg_p_uppb, msg_p_utudipsii, msg_r, msg_r_r, msg_r_rp, msg_t, msg_t_tp, msg_u,\n    msg_v, msg_v_b, msg_v_d, msg_v_p, msg_v_pb, msg_v_pp, msg_v_rp, msg_v_u, msg_v_z, nsstring,\n    nsstring_bytes, objc_allocateClassPair, objc_getProtocol, objc_registerClassPair, pool_pop,\n    pool_push, release, retain, sel,\n};\nuse super::objc::Size as NsSize;\n\n// (0.25) What the Cocoa backend links: AppKit and the frameworks under it.\n// UNSAFE: AppKit, Core Graphics and Core Foundation are C (and\n// Objective-C) libraries: their functions and constants have no safe binding.\n// SAFETY: each declaration matches its C prototype in the macOS SDK\n// (CGSession.h, CGDisplayConfiguration.h, CFRunLoop.h, CFFileDescriptor.h,\n// objc/runtime.h's class_addMethod, one IMP type per declaration); the\n// statics are the SDK's constant NSString/CFString globals, only read.\n#[link(framework = \"AppKit\", framework = \"QuartzCore\", framework = \"CoreGraphics\")]\n");
    buf_str(out, c"#[link(framework = \"CoreFoundation\", framework = \"Foundation\")]\nextern \"C\" {\n    static NSDefaultRunLoopMode: *mut u8;\n    static NSRunLoopCommonModes: *mut u8;\n    static NSPasteboardTypeString: *mut u8;\n    static kCFRunLoopDefaultMode: *mut u8;\n    #[effects(io)]\n    fn CGSessionCopyCurrentDictionary() -> *mut u8;\n    #[effects(io)]\n    fn CGMainDisplayID() -> u32;\n    #[effects(io)]\n    fn CGDisplayIsAsleep(display: u32) -> i32;\n    #[effects(io)]\n    fn CFRelease(o: *mut u8);\n    #[effects(io)]\n    fn CFRunLoopGetMain() -> *mut u8;\n    #[effects(io)]\n    fn CFRunLoopAddSource(rl: *mut u8, src: *mut u8, mode: *mut u8);\n    #[effects(io)]\n    fn CFRunLoopRemoveSource(rl: *mut u8, src: *mut u8, mode: *mut u8);\n\n    #[effects(io)]\n    fn CFFileDescriptorCreate(alloc: *mut u8, fd: i32, close_on_invalidate: bool,\n        callout: extern \"C\" fn(*mut u8, u64, *mut u8), ctx: *mut FdContext) -> *mut u8;\n\n    #[effects(io)]\n    fn CFFileDescriptorEnableCallBacks(f: *mut u8, types: u64);\n    #[effects(io)]\n    fn CFFileDescriptorCreateRunLoopSource(alloc: *mut u8, f: *mut u8, order: i64) -> *mut u8;\n    #[effects(io)]\n    fn CFFileDescriptorGetNativeDescriptor(f: *mut u8) -> i32;\n    #[effects(io)]\n    fn CFFileDescriptorInvalidate(f: *mut u8);\n\n    // class_addMethod, once per IMP shape (an `extern \"C\" fn` type does\n    // not cast to another, so each shape has its own declaration).\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8), t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v_p(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8), t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_b(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8) -> bool, t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n");
    buf_str(out, c"    fn add_b_p(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8) -> bool,\n        t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_g(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8) -> Range, t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_p(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8) -> *mut u8, t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v_pg(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8, Range),\n        t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_v_pgg(c: *mut u8, s: *mut u8,\n        imp: extern \"C\" fn(*mut u8, *mut u8, *mut u8, Range, Range), t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_p_gP(c: *mut u8, s: *mut u8,\n        imp: extern \"C\" fn(*mut u8, *mut u8, Range, *mut Range) -> *mut u8, t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_r_gP(c: *mut u8, s: *mut u8,\n        imp: extern \"C\" fn(*mut u8, *mut u8, Range, *mut Range) -> Rect, t: *mut u8) -> bool;\n    #[link_name = \"class_addMethod\"]\n    #[effects(io)]\n    fn add_u_t(c: *mut u8, s: *mut u8, imp: extern \"C\" fn(*mut u8, *mut u8, Point) -> u64,\n        t: *mut u8) -> bool;\n}\n\n// CFFileDescriptorContext; the callbacks we do not use are null.\n#[derive(Clone, Copy)] #[repr(C)]\nstruct FdContext {\n    version: i64,\n    info: *mut u8,\n    retain: *mut u8,\n    release: *mut u8,\n    describe: *mut u8,\n}\n\n// NSEventType values.\nconst EV_LEFT_DOWN: u64 = 1;\nconst EV_LEFT_UP: u64 = 2;\nconst EV_RIGHT_DOWN: u64 = 3;\nconst EV_RIGHT_UP: u64 = 4;\nconst EV_MOVED: u64 = 5;\nconst EV_LEFT_DRAGGED: u64 = 6;\nconst EV_RIGHT_DRAGGED: u64 = 7;\nconst EV_APP_DEFINED: u64 = 15;\nconst EV_OTHER_DOWN: u64 = 25;\nconst EV_OTHER_UP: u64 = 26;\n");
    buf_str(out, c"const EV_OTHER_DRAGGED: u64 = 27;\n\n// data1 of our wake-up NSEvent.\nconst WAKE: i64 = 0x74616368;\n\n// (0.25.2.1) The frame timer (see the pitfalls above): an occluded\n// window's frames come 10 a second, a window without a display link's\n// 60, and a visible window's display link silent for 3 s is answered by\n// the timer too (and the diagnostic printed).\nconst FALLBACK_NS: i64 = 100000000;\nconst NO_LINK_NS: i64 = 16000000;\nconst QUIET_NS: i64 = 3000000000;\n\n// (0.25.2.1) A window's frame request: whether one is pending and since\n// when, since when its display link has been silent while frames were\n// wanted, and whether the last frame came from the timer.\n#[derive(Clone, Copy)] struct Req {\n    id: i64,\n    win: *mut u8,\n    link: *mut u8,\n    pending: bool,\n    since: i64,\n    quiet: i64,\n    slow: bool,\n}\n\n// The view's instance variable \"vole\": the window id, the cursor\n// shape, the input method area (physical pixels).\n#[derive(Clone, Copy)] struct ViewData {\n    id: i64,\n    cursor: i64,\n    ime_x: f64,\n    ime_y: f64,\n    ime_w: f64,\n    ime_h: f64,\n}\n\n#[derive(Clone, Copy)] struct Watch {\n    fd: i32,\n    cf: *mut u8,\n    src: *mut u8,\n    armed: bool,\n}\n\n// What the IMPs and run-loop callbacks reach: one per process (AppKit\n// has one NSApp), on the heap, pointed to by ST while the App lives.\nstruct State<A: Allocator> {\n    q: Vec<Event, A>,\n    head: i64,\n    // The current composition, and whether there is one.\n    preedit: Vec<u8, A>,\n    marked: bool,\n    // Text produced while a keyDown: is interpreted, sent after its Key.\n    in_key: bool,\n    key_text: Vec<u8, A>,\n    // Inside nextEventMatchingMask (a callback must wake it), and\n    // whether a wake-up is already posted.\n    waiting: bool,\n    wake_posted: bool,\n    // The live-resize hook, and whether it is running.\n    hook: Option<fn(*mut u8)>,\n    hook_ctx: *mut u8,\n    in_hook: bool,\n    watches: Vec<Watch, A>,\n");
    buf_str(out, c"    // (0.25.2.1) The windows' frame requests, and whether the no-frame\n    // diagnostic was printed (once per process).\n    reqs: Vec<Req, A>,\n    warned: bool,\n    app: *mut u8,\n    delegate: *mut u8,\n    target: *mut u8,\n    view_class: *mut u8,\n    ivar_off: i64,\n}\n\n// The State of the App (null when there is none). Statics are safe to\n// use on one thread; the pointer is dereferenced in unsafe blocks only.\n// (0.26.3) A static's type holds no allocator (rule 1), so it is the\n// State's address as bytes, cast back by st(): the Objective-C IMPs and C\n// callbacks are given no context of their own to reach it through.\nstatic mut ST_RAW: *mut u8 = 0 as *mut u8;\n\n// The App's State (see ST_RAW, st_live).\nfn st() -> *mut State<Gpa> {\n    get_st_raw() as *mut State<Gpa>\n}\n\npub struct Cocoa<A: Allocator> {\n    // The State's storage (one element: its address is stable).\n    st: Vec<State<A>, A>,\n}\n\n// SAFETY (for every `unsafe { st()... }` below): ST points to the element\n// of the App's `st` Vec from new_in until close, which nulls it; IMPs and\n// callbacks run on the main thread only, inside App calls (sendEvent:,\n// nextEventMatchingMask:, window creation and closing), so the State is\n// live whenever they run and nothing else holds a reference to it then.\nfn st_live() -> bool {\n    get_st_raw() != 0 as *mut u8\n}\n\nfn push(e: Event) {\n    // UNSAFE: the App's State through the raw ST pointer (a static, so the\n    // IMPs, C callbacks, reach it), and post_wake's Objective-C messages.\n    // SAFETY: see st_live.\n    unsafe {\n        if get_st_raw() == 0 as *mut u8 {\n            return;\n        }\n        st().q.push(e);\n        if st().waiting && !st().wake_posted {\n            st().wake_posted = true;\n            post_wake(st().app);\n        }\n    }\n}\n\n// Posts an application-defined event, so nextEventMatchingMask returns.\n// UNSAFE: Objective-C messages through objc_msgSend on a raw pointer.\n");
    buf_str(out, c"// SAFETY: the caller passes the live NSApplication (st().app); the event\n// constructor takes the documented argument types in this order and\n// returns an autoreleased NSEvent, which postEvent:atStart: retains.\nunsafe fn post_wake(app: *mut u8) {\n    let ev = msg_p_utudipsii(class(c\"NSEvent\"),\n        sel(c\"otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2:\"),\n        EV_APP_DEFINED, Point { x: 0.0, y: 0.0 }, 0, 0.0, 0, 0 as *mut u8, 0, WAKE, 0);\n    msg_v_pb(app, sel(c\"postEvent:atStart:\"), ev, false);\n}\n\n// Text events for `s`, cut into pieces of at most 30 bytes at character\n// boundaries.\nfn push_text(win: WindowId, s: &[u8]) {\n    let mut rest = s;\n    while rest.len() as i64 > 0 {\n        let n = utf8_cut(rest, 30);\n        if n == 0 {\n            break;\n        }\n        let mut t = Text { win: win, len: n as u8, bytes: [0; 30] };\n        for i in 0..n {\n            t.bytes[i as usize] = rest[i as usize];\n        }\n        push(Event::Text(t));\n        rest = &rest[n as usize..rest.len() as i64 as usize];\n    }\n}\n\n// The view's data (an instance variable at a known offset).\n// UNSAFE: a pointer into the view object's instance variable, at an offset\n// only the Objective-C runtime knows.\n// SAFETY: the caller passes a live VoleView (make_view_class: the 48-byte,\n// 8-aligned ivar \"vole\" at st().ivar_off) while ST is live; alloc zeroes the\n// object, so the ivar holds a valid ViewData from then on.\nunsafe fn vdata(view: *mut u8) -> *mut ViewData {\n    view.add(st().ivar_off as usize) as *mut ViewData\n}\n\n// UNSAFE: reads through vdata's raw pointer.\n// SAFETY: the caller's obligation is vdata's: a live VoleView, ST live.\nunsafe fn view_id(view: *mut u8) -> WindowId {\n    WindowId { n: vdata(view).id }\n}\n\n// The window's backing scale (2.0 on Retina).\n// UNSAFE: Objective-C messages on a raw NSView pointer.\n");
    buf_str(out, c"// SAFETY: the caller passes a live NSView; window returns its NSWindow (+0)\n// or nil, checked; backingScaleFactor returns a CGFloat (f64).\nunsafe fn scale_of(view: *mut u8) -> f64 {\n    let w = msg_p(view, sel(c\"window\"));\n    if w == 0 as *mut u8 {\n        return 1.0;\n    }\n    msg_d(w, sel(c\"backingScaleFactor\"))\n}\n\n// UNSAFE: Objective-C messages on a raw NSView pointer.\n// SAFETY: the caller passes a live NSView; bounds returns an NSRect by value.\nunsafe fn view_size(view: *mut u8) -> Size {\n    let b = msg_r(view, sel(c\"bounds\"));\n    let s = scale_of(view);\n    Size { w: (b.w * s + 0.5) as i64, h: (b.h * s + 0.5) as i64, scale: s }\n}\n\n// Sets the layer's scale and drawable size to the view's.\n// UNSAFE: Objective-C messages on a raw NSView and its layer.\n// SAFETY: the caller passes a live VoleView; layer returns its layer (+0)\n// or nil, checked; it is the CAMetalLayer open_window set, which takes\n// setContentsScale: (CGFloat) and setDrawableSize: (CGSize).\nunsafe fn sync_layer(view: *mut u8) -> Size {\n    let sz = view_size(view);\n    let layer = msg_p(view, sel(c\"layer\"));\n    if layer != 0 as *mut u8 {\n        msg_v_d(layer, sel(c\"setContentsScale:\"), sz.scale);\n        msg_v_z(layer, sel(c\"setDrawableSize:\"), NsSize { w: sz.w as f64, h: sz.h as f64 });\n    }\n    sz\n}\n\n// ---- the view's methods (IMPs) (0.23) ----\n\nextern \"C\" fn imp_yes(this: *mut u8, cmd: *mut u8) -> bool {\n    true\n}\n\nextern \"C\" fn imp_yes_p(this: *mut u8, cmd: *mut u8, a: *mut u8) -> bool {\n    true\n}\n\nextern \"C\" fn imp_key_down(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view, and the State\n    // through st().\n    // SAFETY: see st_live; `ev` is the NSEvent AppKit passes; the array\n    // is autoreleased in the pool around sendEvent:.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n");
    buf_str(out, c"        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        let repeat = msg_b(ev, sel(c\"isARepeat\"));\n        let c = first_char(nsstring_bytes(msg_p(ev, sel(c\"charactersIgnoringModifiers\"))));\n        let id = view_id(this);\n        let had_marked = st().marked;\n        st().in_key = true;\n        st().key_text.clear();\n        let arr = msg_p_p(class(c\"NSArray\"), sel(c\"arrayWithObject:\"), ev);\n        msg_v_p(this, sel(c\"interpretKeyEvents:\"), arr);\n        st().in_key = false;\n        let text_len = st().key_text.len() as i64;\n        push(Event::Key(Key {\n            win: id,\n            code: code,\n            key: mac_logical(c, code),\n            mods: mac_mods(flags),\n            pressed: true,\n            repeat: repeat,\n            ime: had_marked || st().marked,\n            text_follows: text_len > 0,\n        }));\n        if text_len > 0 {\n            push_text(id, st().key_text.as_slice());\n        }\n    }\n}\n\nextern \"C\" fn imp_key_up(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view, and the State\n    // through st().\n    // SAFETY: see st_live and imp_key_down.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        let c = first_char(nsstring_bytes(msg_p(ev, sel(c\"charactersIgnoringModifiers\"))));\n        push(Event::Key(Key {\n            win: view_id(this),\n            code: code,\n            key: mac_logical(c, code),\n            mods: mac_mods(flags),\n            pressed: false,\n            repeat: false,\n            ime: st().marked,\n            text_follows: false,\n        }));\n    }\n}\n\nextern \"C\" fn imp_flags_changed(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view.\n");
    buf_str(out, c"    // SAFETY: see imp_key_down.\n    unsafe {\n        let code = mac_keycode(msg_h(ev, sel(c\"keyCode\")));\n        let flags = msg_u(ev, sel(c\"modifierFlags\"));\n        push(Event::Key(Key {\n            win: view_id(this),\n            code: code,\n            key: mac_logical(0, code),\n            mods: mac_mods(flags),\n            pressed: mac_modifier_down(code, flags),\n            repeat: false,\n            ime: false,\n            text_follows: false,\n        }));\n    }\n}\n\nextern \"C\" fn imp_mouse(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view.\n    // SAFETY: see imp_key_down; convertPoint:fromView: with nil converts\n    // from the window's coordinates.\n    unsafe {\n        let ty = msg_u(ev, sel(c\"type\"));\n        let at = msg_t(ev, sel(c\"locationInWindow\"));\n        let p = msg_t_tp(this, sel(c\"convertPoint:fromView:\"), at, 0 as *mut u8);\n        let s = scale_of(this);\n        let n = msg_i(ev, sel(c\"buttonNumber\"));\n        let action = if ty == EV_LEFT_DOWN || ty == EV_RIGHT_DOWN || ty == EV_OTHER_DOWN {\n            MouseAction::Press\n        } else if ty == EV_LEFT_UP || ty == EV_RIGHT_UP || ty == EV_OTHER_UP {\n            MouseAction::Release\n        } else {\n            MouseAction::Move\n        };\n        let button = if ty == EV_MOVED {\n            Button::None\n        } else if n == 0 {\n            Button::Left\n        } else if n == 1 {\n            Button::Right\n        } else if n == 2 {\n            Button::Middle\n        } else {\n            Button::Other(n)\n        };\n        let clicks: i64 = if ty == EV_MOVED || ty == EV_LEFT_DRAGGED || ty == EV_RIGHT_DRAGGED\n            || ty == EV_OTHER_DRAGGED {\n            0\n        } else {\n            msg_i(ev, sel(c\"clickCount\"))\n        };\n        push(Event::Mouse(Mouse {\n            win: view_id(this),\n            action: action,\n");
    buf_str(out, c"            button: button,\n            x: p.x * s,\n            y: p.y * s,\n            mods: mac_mods(msg_u(ev, sel(c\"modifierFlags\"))),\n            clicks: clicks,\n        }));\n    }\n}\n\nextern \"C\" fn imp_entered(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the view's instance variable through a raw pointer (view_id).\n    // SAFETY: see st_live.\n    unsafe { push(Event::Cursor(view_id(this), true)); }\n}\n\nextern \"C\" fn imp_exited(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the view's instance variable through a raw pointer (view_id).\n    // SAFETY: see st_live.\n    unsafe { push(Event::Cursor(view_id(this), false)); }\n}\n\nextern \"C\" fn imp_scroll(this: *mut u8, cmd: *mut u8, ev: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw NSEvent and view.\n    // SAFETY: see imp_key_down.\n    unsafe {\n        let precise = msg_b(ev, sel(c\"hasPreciseScrollingDeltas\"));\n        let s = if precise { scale_of(this) } else { 1.0 };\n        push(Event::Scroll(Scroll {\n            win: view_id(this),\n            dx: msg_d(ev, sel(c\"scrollingDeltaX\")) * s,\n            dy: msg_d(ev, sel(c\"scrollingDeltaY\")) * s,\n            precise: precise,\n            mods: mac_mods(msg_u(ev, sel(c\"modifierFlags\"))),\n        }));\n    }\n}\n\nextern \"C\" fn imp_frame(this: *mut u8, cmd: *mut u8, link: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: an Objective-C message on the raw display link, and the State\n    // through st().\n    // SAFETY: see st_live; `link` is the CADisplayLink that called us.\n    unsafe {\n        msg_v_b(link, sel(c\"setPaused:\"), true);\n        // A request the timer answered already is not answered twice.\n        if st().answered(link) {\n            push(Event::Frame(view_id(this)));\n        }\n    }\n}\n\n");
    buf_str(out, c"extern \"C\" fn imp_reset_cursor_rects(this: *mut u8, cmd: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the view's instance variable through a raw pointer, and AppKit\n    // messages on raw object pointers.\n    // SAFETY: see st_live; the NSCursor class methods return shared\n    // cursors (+0).\n    unsafe {\n        let k = vdata(this).cursor;\n        let c = if k == 1 {\n            msg_p(class(c\"NSCursor\"), sel(c\"IBeamCursor\"))\n        } else if k == 2 {\n            msg_p(class(c\"NSCursor\"), sel(c\"pointingHandCursor\"))\n        } else {\n            msg_p(class(c\"NSCursor\"), sel(c\"arrowCursor\"))\n        };\n        msg_v_rp(this, sel(c\"addCursorRect:cursor:\"), msg_r(this, sel(c\"bounds\")), c);\n    }\n}\n\n// ---- NSTextInputClient (0.23) ----\n\nextern \"C\" fn imp_has_marked(this: *mut u8, cmd: *mut u8) -> bool {\n    // UNSAFE: the App's State through the raw ST pointer.\n    // SAFETY: see st_live.\n    st_live() && unsafe { st().marked }\n}\n\nextern \"C\" fn imp_marked_range(this: *mut u8, cmd: *mut u8) -> Range {\n    // UNSAFE: the App's State through the raw ST pointer.\n    // SAFETY: see st_live.\n    unsafe {\n        if st_live() && st().marked {\n            return Range { loc: 0, len: utf16_len(st().preedit.as_slice()) };\n        }\n    }\n    Range { loc: NOT_FOUND, len: 0 }\n}\n\nextern \"C\" fn imp_selected_range(this: *mut u8, cmd: *mut u8) -> Range {\n    Range { loc: NOT_FOUND, len: 0 }\n}\n\nfn utf16_len(s: &[u8]) -> u64 {\n    let mut n: u64 = 0;\n    for &b in s {\n        if (b & 0xC0) != 0x80 {\n            n += if b >= 0xF0 { 2 } else { 1 };\n        }\n    }\n    n\n}\n\n// The text of an NSString or NSAttributedString argument.\n// UNSAFE: Objective-C messages on a raw object pointer, and the bytes of an\n// NSString whose lifetime the runtime decides.\n// SAFETY: the caller passes the NSString or NSAttributedString an input\n");
    buf_str(out, c"// method gives; the bytes (nsstring_bytes) stay valid until the autorelease\n// pool around the event pops, and every caller copies them before then.\nunsafe fn arg_text(s: *mut u8) -> &'static [u8] {\n    if msg_b_p(s, sel(c\"isKindOfClass:\"), class(c\"NSAttributedString\")) {\n        return nsstring_bytes(msg_p(s, sel(c\"string\")));\n    }\n    nsstring_bytes(s)\n}\n\nextern \"C\" fn imp_set_marked(this: *mut u8, cmd: *mut u8, text: *mut u8, selected: Range,\n    replaced: Range) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on the raw text argument, and the State\n    // through st().\n    // SAFETY: see st_live; `text` is the NSString or NSAttributedString\n    // the input method passes.\n    unsafe {\n        let s = arg_text(text);\n        st().preedit.clear();\n        st().preedit.extend_from_slice(s);\n        st().marked = s.len() as i64 > 0;\n        let cursor = if selected.loc == NOT_FOUND { s.len() as i64 }\n            else { utf16_to_byte(s, selected.loc as i64) };\n        push(Event::Preedit(Preedit { win: view_id(this), len: s.len() as i64, cursor: cursor }));\n    }\n}\n\nextern \"C\" fn imp_unmark(this: *mut u8, cmd: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: the State through ST, and Objective-C messages on the raw view\n    // and its input context.\n    // SAFETY: see st_live; discardMarkedText on the view's input context.\n    unsafe {\n        if st().marked {\n            st().marked = false;\n            st().preedit.clear();\n            push(Event::Preedit(Preedit { win: view_id(this), len: 0, cursor: 0 }));\n        }\n        let ic = msg_p(this, sel(c\"inputContext\"));\n        if ic != 0 as *mut u8 {\n            msg_v(ic, sel(c\"discardMarkedText\"));\n        }\n    }\n}\n\nextern \"C\" fn imp_insert_text(this: *mut u8, cmd: *mut u8, text: *mut u8, replaced: Range) {\n    if !st_live() {\n        return;\n    }\n");
    buf_str(out, c"    // UNSAFE: Objective-C messages on the raw text argument, and the State\n    // through st().\n    // SAFETY: see imp_set_marked.\n    unsafe {\n        let s = arg_text(text);\n        let id = view_id(this);\n        if st().marked {\n            st().marked = false;\n            st().preedit.clear();\n            push(Event::Preedit(Preedit { win: id, len: 0, cursor: 0 }));\n        }\n        if st().in_key {\n            st().key_text.extend_from_slice(s);\n        } else {\n            push_text(id, s);\n        }\n    }\n}\n\nextern \"C\" fn imp_valid_attributes(this: *mut u8, cmd: *mut u8) -> *mut u8 {\n    // UNSAFE: an Objective-C message (objc_msgSend, a C function).\n    // SAFETY: +[NSArray array] returns an empty, autoreleased array.\n    unsafe { msg_p(class(c\"NSArray\"), sel(c\"array\")) }\n}\n\nextern \"C\" fn imp_attributed_substring(this: *mut u8, cmd: *mut u8, r: Range, actual: *mut Range) -> *mut u8 {\n    0 as *mut u8\n}\n\nextern \"C\" fn imp_char_index(this: *mut u8, cmd: *mut u8, p: Point) -> u64 {\n    NOT_FOUND\n}\n\nextern \"C\" fn imp_first_rect(this: *mut u8, cmd: *mut u8, r: Range, actual: *mut Range) -> Rect {\n    if !st_live() {\n        return Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 };\n    }\n    // UNSAFE: the view's instance variable through a raw pointer, and AppKit's\n    // rect conversions on raw object pointers.\n    // SAFETY: see st_live; the conversions take and return rects by value.\n    unsafe {\n        let d = vdata(this);\n        let s = scale_of(this);\n        let local = Rect { x: d.ime_x / s, y: d.ime_y / s, w: d.ime_w / s, h: d.ime_h / s };\n        let inwin = msg_r_rp(this, sel(c\"convertRect:toView:\"), local, 0 as *mut u8);\n        let w = msg_p(this, sel(c\"window\"));\n        if w == 0 as *mut u8 {\n            return inwin;\n        }\n        msg_r_r(w, sel(c\"convertRectToScreen:\"), inwin)\n    }\n}\n\nextern \"C\" fn imp_do_command(this: *mut u8, cmd: *mut u8, selector: *mut u8) {\n");
    buf_str(out, c"    // Nothing: the application reads keys from Event::Key (and the\n    // default would beep).\n}\n\n// ---- the window delegate (0.23) ----\n\n// UNSAFE: Objective-C messages on a raw NSNotification pointer.\n// SAFETY: the caller passes a window notification sent to our delegate: its\n// object is one of our NSWindows, whose contentView is our VoleView (+0,\n// held by the window).\nunsafe fn note_view(note: *mut u8) -> *mut u8 {\n    let w = msg_p(note, sel(c\"object\"));\n    msg_p(w, sel(c\"contentView\"))\n}\n\nextern \"C\" fn imp_should_close(this: *mut u8, cmd: *mut u8, win: *mut u8) -> bool {\n    if !st_live() {\n        return true;\n    }\n    // UNSAFE: an Objective-C message on the raw NSWindow, and the view's\n    // instance variable through a raw pointer.\n    // SAFETY: see st_live; `win` is one of our windows (its content view\n    // is our view).\n    unsafe { push(Event::Close(view_id(msg_p(win, sel(c\"contentView\"))))); }\n    false\n}\n\nextern \"C\" fn imp_did_resize(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n    if !st_live() {\n        return;\n    }\n    // UNSAFE: Objective-C messages on raw object pointers, the State through\n    // ST, and the application's hook called with its raw context.\n    // SAFETY: see st_live; the hook is called with the context it was\n    // registered with (the application's promise: it is valid while the\n    // hook is set).\n    unsafe {\n        let view = note_view(note);\n        let sz = sync_layer(view);\n        push(Event::Resize(view_id(view), sz));\n        let live = msg_b(view, sel(c\"inLiveResize\"));\n        if live && !st().in_hook {\n            match st().hook {\n                Some(f) => {\n                    st().in_hook = true;\n                    f(st().hook_ctx);\n                    st().in_hook = false;\n                }\n                None => {}\n            }\n        }\n    }\n}\n\nextern \"C\" fn imp_did_backing(this: *mut u8, cmd: *mut u8, note: *mut u8) {\n");
