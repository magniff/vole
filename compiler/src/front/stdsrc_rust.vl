    buf_str(out, c"\n// Its bytes and a 0xff, as Rust's (so (\"ab\", \"c\") and (\"a\", \"bc\") differ).\nimpl Hash for str {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write(self.as_bytes());\n        state.write_u8(0xff);\n    }\n}\n\nimpl Display for str {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.pad(self)\n    }\n}\n\n// Quoted, with escapes: \"a\\\"b\".\nimpl Debug for str {\n    fn fmt(&self, f: &mut Formatter<'_>) -> crate::fmt::Result {\n        f.write_str(\"\\\"\")?;\n        let mut from: usize = 0;\n        let mut it = self.char_indices();\n        loop {\n            match it.next() {\n                Some((i, c)) => {\n                    let esc = match c {\n                        '\"' => \"\\\\\\\"\",\n                        '\\\\' => \"\\\\\\\\\",\n                        '\\n' => \"\\\\n\",\n                        '\\r' => \"\\\\r\",\n                        '\\t' => \"\\\\t\",\n                        '\\0' => \"\\\\0\",\n                        _ => \"\",\n                    };\n                    // controls, white space but ' ' and (as Rust's) grapheme extenders\n                    // are escaped\n                    let control = c.is_control() || is_extend(c)\n                        || (c.is_whitespace() && c != ' ');\n                    if esc.len() > 0 || control {\n                        f.write_str(&self[from..i])?;\n                        if esc.len() > 0 {\n                            f.write_str(esc)?;\n                        } else {\n                            write_unicode_escape(f, c as u32)?;\n                        }\n                        from = i + c.len_utf8();\n                    }\n                }\n                None => break,\n            }\n        }\n        f.write_str(&self[from..])?;\n        f.write_str(\"\\\"\")\n    }\n}\n\n// `s.to_owned_in(a)`: a String<A>.\nimpl<A: Allocator> ToOwnedIn<A> for str {\n    type Owned = String<A>;\n\n");
    buf_str(out, c"    fn to_owned_in(&self, a: A) -> String<A> {\n        String::from_in(self, a)\n    }\n}\n\nimpl AsRef<str> for str {\n    fn as_ref(&self) -> &str {\n        self\n    }\n}\n\nimpl AsRef<[u8]> for str {\n    fn as_ref(&self) -> &[u8] {\n        self.as_bytes()\n    }\n}\n\n// later: impl_for_ref\nimpl<'a> Default for &'a str {\n    fn default() -> &'a str {\n        \"\"\n    }\n}\n\n// ---- The iterators ----\n\n// str::chars's iterator; `.rev()` from the end.\n// mvs: Chars, RevChars, CodePoints\n#[derive(Clone)]\npub struct Chars<'a> {\n    rest: &'a str,\n}\n\nimpl<'a> Chars<'a> {\n    // What is left.\n    #[effects()]\n    pub fn as_str(&self) -> &'a str {\n        self.rest\n    }\n}\n\nimpl<'a> Iterator for Chars<'a> {\n    type Item = char;\n\n    fn next(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_first(self.rest.as_bytes());\n        self.rest = &self.rest[n..];\n        Some(c)\n    }\n}\n\nimpl<'a> DoubleEndedIterator for Chars<'a> {\n    fn next_back(&mut self) -> Option<char> {\n        if self.rest.is_empty() {\n            return None;\n        }\n        let (c, n) = decode_last(self.rest.as_bytes());\n        self.rest = &self.rest[..self.rest.len() - n];\n        Some(c)\n    }\n}\n\n// str::char_indices's iterator.\n#[derive(Clone)]\npub struct CharIndices<'a> {\n    front: usize,\n    chars: Chars<'a>,\n}\n\nimpl<'a> CharIndices<'a> {\n    // The byte offset of the next char (the length at the end).\n    #[effects()]\n    pub fn offset(&self) -> usize {\n        self.front\n    }\n}\n\nimpl<'a> Iterator for CharIndices<'a> {\n    type Item = (usize, char);\n\n    fn next(&mut self) -> Option<(usize, char)> {\n        let before = self.chars.rest.len();\n        match self.chars.next() {\n            Some(c) => {\n                let i = self.front;\n                self.front += before - self.chars.rest.len();\n                Some((i, c)