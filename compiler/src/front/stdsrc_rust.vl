    buf_str(out, c"        unsafe { Ref::<NSString>::from_raw(msg_p(self.ptr, sel_1()), self) }\n    }\n}\n\n/// The Objective-C class NSString.\npub struct NSString {}\n\npub trait NSStringMethods<'a> {\n    // UTF8String\n    fn utf8_string(self) -> *mut u8;\n    // length\n    fn length(self) -> u64;\n}\n\nimpl<'a> NSStringMethods<'a> for Ref<'a, NSString> {\n    fn utf8_string(self) -> *mut u8 {\n        // UNSAFE: -UTF8String is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSString (Ref's invariant), and a\n        // message to nil returns zero; the pointer result is returned raw: reading through it\n        // is the caller's unsafe.\n        unsafe { msg_p(self.ptr, sel_2()) }\n    }\n\n    fn length(self) -> u64 {\n        // UNSAFE: -length is sent by objc_msgSend, a C call whose types the compiler cannot\n        // see.\n        // SAFETY: msg_u64 is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); self.ptr is nil or a live NSString (Ref's invariant), and a\n        // message to nil returns zero.\n        unsafe { msg_u64(self.ptr, sel_3()) }\n    }\n}\n\nimpl NSString {\n    // +alloc\n    pub fn alloc() -> Id<NSString> {\n        // UNSAFE: +alloc is sent by objc_msgSend, a C call whose types the compiler cannot see.\n        // SAFETY: msg_p is its C prototype, checked against the runtime's type encoding\n        // (objcgen --check); class_0() is the class NSString, or nil before its framework is\n        // opened, and a message to nil returns zero; the result is +1, and the Id returned owns\n        // and releases it.\n        unsafe { Id::<NSString>::from_owned_or_nil(msg_p(class_0(), sel_4())) }\n    }\n\n    // -initWithBytes:length:encoding:: consumes `this` (the init family), returns +1\n");
